   "zh": "",
   "loot_table": "",
   "projectile": false
  },
  {
   "key": "entity.the_deep_void.undertaker.gaol3",
   "id": "gaol3",
   "en": "Those who are foolish enough to defy god are sent here. So many were sent here, especially durin' the peak of the disease. Everyone was goin' mad. Who can blame 'em? Death was comin' for all of us. Me death though as been... postponed ye could say.",
   "zh": "",
   "loot_table": "",
   "projectile": false
  },
