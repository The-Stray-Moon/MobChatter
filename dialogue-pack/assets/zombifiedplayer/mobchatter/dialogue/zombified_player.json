{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走路的姿势，你认得。", "en": "You know this walk."},
        {"zh": "这张脸，是照着我做的。", "en": "This face was copied from mine."},
        {"zh": "我穿着你的旧衣服。", "en": "I wear your old clothes."},
        {"zh": "我一瘸一拐，但不慢。", "en": "I limp, but I'm not slow."},
        {"zh": "脚下的路，我走过。", "en": "I've walked this road before."},
        {"zh": "我朝原来的家走。", "en": "I walk toward my old home."},
        {"zh": "阳光照着我，我不燃。", "en": "Sunlight on me, and I don't burn."},
        {"zh": "我的皮肤，蒙了一层灰。", "en": "A gray layer over my skin."},
        {"zh": "我抬手的动作，很熟。", "en": "This gesture is familiar."},
        {"zh": "我不需要睡，也不会消失。", "en": "I need no sleep and won't fade."},
        {"zh": "我沿着记忆里的方向走。", "en": "I walk the way I remember."},
        {"zh": "我的口袋里，还有你的东西。", "en": "Your things are still in my pockets."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在我从前站的地方。", "en": "I stand where I used to stand."},
        {"zh": "这只手，指甲全黑了。", "en": "These nails have gone all black."},
        {"zh": "这双手，好像不是我的。", "en": "These hands don't feel mine."},
        {"zh": "我在门口停了很久。", "en": "I linger at the doorway."},
        {"zh": "屋里的灯亮着。", "en": "A lamp is lit inside."},
        {"zh": "我记得钥匙放哪。", "en": "I remember where the key goes."},
        {"zh": "我从不敲这扇门。", "en": "I never knock on this door."},
        {"zh": "我愣愣地看着窗户。", "en": "I stare at the window."},
        {"zh": "我把手插进旧外套的口袋。", "en": "I push my hands into the old coat pockets."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你长得真像我。", "en": "You look just like me."},
        {"zh": "我们认识吗？", "en": "Do we know each other?"},
        {"zh": "我身上这身衣服，眼熟吧。", "en": "These clothes look familiar, don't they?"},
        {"zh": "我的脸，你还认得出吗？", "en": "Can you still recognize my face?"},
        {"zh": "你脚往后撤了。", "en": "Your feet have drawn back."},
        {"zh": "我的东西，在你那儿吗？", "en": "Are my things with you?"},
        {"zh": "我不记得自己怎么死的。", "en": "I don't remember how I died."},
        {"zh": "门外很亮，我不怕。", "en": "It's bright outside; I'm not afraid."},
        {"zh": "我们不该这样见面。", "en": "We shouldn't meet like this."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体，僵了一下。", "en": "My body jerks."},
        {"zh": "我僵着退了半步。", "en": "Stiffly, I give half a step."},
        {"zh": "这点疼我扛得下。", "en": "I can carry this pain."},
        {"zh": "我身上这件，是死者留下的。", "en": "This on my back belonged to the dead."},
        {"zh": "灰从我皮肤上掉下来。", "en": "Ash flakes off my skin."},
        {"zh": "我低头看着那道口子。", "en": "I look down at the gash."},
        {"zh": "我这身体没有血。", "en": "This body has no blood."},
        {"zh": "我重新把腰挺直。", "en": "I straighten up again."},
        {"zh": "这一下，让我清醒了一点。", "en": "That cleared my head a little."},
        {"zh": "我不想还手。", "en": "I don't want to hit back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "吃的？我记不起饿。", "en": "Food? I can't recall hunger."},
        {"zh": "你递东西的手势，我熟。", "en": "I know that way of handing things."},
        {"zh": "这些东西我拿不了。", "en": "I can't make use of these."},
        {"zh": "你留着吧，收好。", "en": "Keep it safe."},
        {"zh": "这点东西，我拿不住。", "en": "I can't hold onto that."},
        {"zh": "我以前也爱吃这个。", "en": "I used to like this."},
        {"zh": "这张脸是照着我做的，手也放不下。", "en": "This face was made from mine, and my hands will not drop."},
        {"zh": "你递过来，我却不想要。", "en": "You offer it, and I don't want it."},
        {"zh": "我的胃，早就不动了。", "en": "My stomach stopped long ago."},
        {"zh": "把它收进包里。", "en": "Put it away in your bag."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的肩撞上这具旧身子。", "en": "Your shoulder strikes this old body."},
        {"zh": "我的身体，僵得很。", "en": "My body is stiff."},
        {"zh": "僵着腿，我退半步停住。", "en": "Stiff-legged, I step back and stop."},
        {"zh": "这一下，我差点倒了。", "en": "That nearly knocked me down."},
        {"zh": "你的肩膀，是热的。", "en": "Your shoulder is warm."},
        {"zh": "我很久没碰到活人了。", "en": "I haven't touched a living person in a long time."},
        {"zh": "别推我这副身子。", "en": "Don't push this body of mine."},
        {"zh": "我们之间近得发闷。", "en": "We're uncomfortably close."},
        {"zh": "我往旁边挪开了。", "en": "I stepped aside."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不该想这些。", "en": "I shouldn't think of this."},
        {"zh": "这具身体，已经不是我的。", "en": "This body isn't mine anymore."},
        {"zh": "我记得有人等过我。", "en": "I remember someone waited for me."},
        {"zh": "我回不去了。", "en": "I can't go back."},
        {"zh": "屋里那盏灯，是为我留的吗？", "en": "Was that lamp left on for me?"},
        {"zh": "停在那儿，别过来。", "en": "Stay there; don't come over."},
        {"zh": "我不认得自己了。", "en": "I don't recognize myself."},
        {"zh": "这件事就算了。", "en": "Let's leave it at that."},
        {"zh": "我把后背留给你了。", "en": "I've left you my back."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起自己的东西。", "en": "I pick up my own belongings."},
        {"zh": "这把钥匙，我还记得。", "en": "I still remember this key."},
        {"zh": "东西掉在地上，我弯腰。", "en": "It fell; I bend down."},
        {"zh": "我的手指不太灵。", "en": "My fingers aren't nimble."},
        {"zh": "这个，我带走。", "en": "I'll take this."},
        {"zh": "我把它放回包里。", "en": "I put it back in the bag."},
        {"zh": "这身衣服的口袋，还是我的。", "en": "These pockets are still mine."},
        {"zh": "我拿着它，站了一会儿。", "en": "I hold it and stand a while."},
        {"zh": "它摸起来有点凉。", "en": "It feels rather cold."},
        {"zh": "我什么都不想留。", "en": "I don't want to keep anything."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有活人的味儿。", "en": "You smell of the living."},
        {"zh": "我肚子在响。", "en": "My stomach is growling."},
        {"zh": "我不是我想的那样。", "en": "I'm not what I thought I was."},
        {"zh": "这身衣服，勒得难受。", "en": "These clothes fit badly now."},
        {"zh": "我一直很饿。", "en": "I've been hungry this whole time."},
        {"zh": "你已经在我的眼里。", "en": "You're already in my sight."},
        {"zh": "我的手指，动了动。", "en": "My fingers twitch."},
        {"zh": "别往远处跑。", "en": "Don't run off."},
        {"zh": "但我停不下来。", "en": "But I can't stop."},
        {"zh": "这身体的力气，比我想的大。", "en": "This body is stronger than I expected."},
        {"zh": "你退到墙根了。", "en": "You're against the wall."},
        {"zh": "你在哪，我记得。", "en": "I remember where you are."},
        {"zh": "我的手指不听使唤。", "en": "My fingers won't obey me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟在你后头。", "en": "I'm following behind you."},
        {"zh": "这双腿记得怎么追。", "en": "These legs remember how to chase."},
        {"zh": "这副身子不会喘。", "en": "This body doesn't pant."},
        {"zh": "太阳晒着我，我照样走。", "en": "Sun or not, I keep walking."},
        {"zh": "你跑得很快。", "en": "You run fast."},
        {"zh": "可这双腿不肯停。", "en": "But these legs won't stop."},
        {"zh": "屋子里有镜子。", "en": "There's a mirror in the house."},
        {"zh": "镜子我不敢看。", "en": "I daren't look in the mirror."},
        {"zh": "你的影子，我追着。", "en": "I chase your shadow."},
        {"zh": "门是开着的。", "en": "The door is open."},
        {"zh": "你迟早会累。", "en": "Sooner or later you'll tire."},
        {"zh": "我可不会累。", "en": "I won't."},
        {"zh": "那扇门后，是你家吗？", "en": "Is that your home behind the door?"},
        {"zh": "这屋子我进去过。", "en": "I've been inside this house."},
        {"zh": "走廊尽头没有路。", "en": "The corridor ends."},
        {"zh": "我已经到门口。", "en": "I'm at the doorway."},
        {"zh": "别回头看我。", "en": "Don't turn and look at me."},
        {"zh": "我不想让你看见我的脸。", "en": "I don't want you to see my face."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一把抓住你！", "en": "I grab you!"},
        {"zh": "这力气，不像我。", "en": "This strength isn't mine."},
        {"zh": "我的牙咬下去了。", "en": "My teeth closed."},
        {"zh": "这双手不听我的。", "en": "These hands don't heed me."},
        {"zh": "我的手指陷进你的袖子。", "en": "My fingers dig into your sleeve."},
        {"zh": "我抬手的动作很熟。", "en": "The way I raise my hand is familiar."},
        {"zh": "这一下，我也不想。", "en": "I didn't want that either."},
        {"zh": "你退开，我还在后面。", "en": "You pull back; I'm still there."},
        {"zh": "我记得活着是怎么打的。", "en": "I remember how the living fought."},
        {"zh": "但我不怕疼。", "en": "But I don't fear pain."},
        {"zh": "这一下足够。", "en": "That's enough."},
        {"zh": "趁现在赶紧走。", "en": "Go now, while you can."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我站起来的时候，穿着一身旧衣。", "en": "I rose in my old clothes."},
        {"zh": "阳光照着我，我不烧。", "en": "Sunlight on me, and I don't burn."},
        {"zh": "这张脸，我很熟。", "en": "This face is familiar."},
        {"zh": "地上有一件掉落的物品。", "en": "Something of mine lies on the ground."},
        {"zh": "这些东西，怎么在我身上。", "en": "How did these come to be on me?"},
        {"zh": "我朝有灯的地方走。", "en": "I walk toward the light."},
        {"zh": "这地方，我住过。", "en": "I lived here once."},
        {"zh": "门牌号，我记得。", "en": "I remember the house number."},
        {"zh": "我记得怎么开这扇门。", "en": "I remember how this door opens."},
        {"zh": "屋里有人在。", "en": "Someone's inside."},
        {"zh": "我站在那儿，很久。", "en": "I stand there a long while."},
        {"zh": "我走进去了。", "en": "I went in."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我身上就着了。", "en": "Fire catches and I burn."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，骨头响得厉害。", "en": "I fall; my bones clatter."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进来，我不挣扎。", "en": "Water pours in; I don't struggle."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我整个人贴在墙上。", "en": "The blast pins me to the wall."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "邪力锁住了我的手脚。", "en": "Foul force locks my limbs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直饿，从没停过。", "en": "I've been hungry, without pause."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我一动不动。", "en": "Lightning strikes; I don't move."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，衣服往上飘。", "en": "I fall; my clothes billow up."}
      ]
    }
  }
}
