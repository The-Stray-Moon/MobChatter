    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那个我已经看见了。", "en": "I've already seen that one."},
        {"zh": "我想游过去看看。", "en": "I want to swim over and look."},
        {"zh": "它在水草边上。", "en": "It's by the weeds."},
        {"zh": "这个距离我能到。", "en": "I can reach from here."},
        {"zh": "我锁定了那个方向。", "en": "I've fixed on that direction."},
        {"zh": "我先往下沉一点。", "en": "Let me sink down a little first."},
        {"zh": "它还没有注意我。", "en": "It hasn't noticed me."},
        {"zh": "我慢慢地靠近过去。", "en": "I'm easing my way closer."},
        {"zh": "我就跟在它后面。", "en": "I'll just follow behind it."},
        {"zh": "我摆尾快了些。", "en": "My tail's beating faster."}
      ]
