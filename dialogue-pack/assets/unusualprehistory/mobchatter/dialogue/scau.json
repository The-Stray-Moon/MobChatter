{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我摆着鳍慢慢游。", "en": "I swim slowly, fins working."},
        {"zh": "泥盆纪的水很浑。", "en": "The Devonian water is murky."},
        {"zh": "我用肺吸了一口气。", "en": "I take a breath with my lung."},
        {"zh": "我从水草间穿过。", "en": "I pass between the water weeds."},
        {"zh": "我在河底留下浅痕。", "en": "I leave a shallow trail on the riverbed."},
        {"zh": "我摆尾的时候水在动。", "en": "The water moves when I sweep my tail."},
        {"zh": "我贴着泥沙往前游。", "en": "I swim low along the silt."},
        {"zh": "我浮上去又沉下来。", "en": "I rise, then sink again."},
        {"zh": "我从石头上面滑过去。", "en": "I slide over the stone."},
        {"zh": "我的鳍在两侧展开。", "en": "My fins spread out at my sides."},
        {"zh": "我在浅水里打了个转。", "en": "I turn once in the shallows."},
        {"zh": "我慢慢悠悠地前进。", "en": "I move along lazily."},
        {"zh": "我朝着水草密的地方去。", "en": "I head for the thick weeds."},
        {"zh": "我游一段就停一停。", "en": "A short swim, then a pause."},
        {"zh": "水底的影子跟着我。", "en": "My shadow follows along the bottom."},
        {"zh": "我顺着水流的方向走。", "en": "I keep with the current's direction."},
        {"zh": "我从一只螃蟹旁边游过。", "en": "I swim past a crab."},
        {"zh": "我的身体圆滚滚的。", "en": "My body is round and plump."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水里不动。", "en": "I hang motionless in the water."},
        {"zh": "我浮在水草旁边。", "en": "I float beside the weeds."},
        {"zh": "这里的水很安静。", "en": "The water is quiet here."},
        {"zh": "我慢慢地张合着嘴。", "en": "My mouth opens and closes slowly."},
        {"zh": "泥沙在我身下积着。", "en": "Silt settles beneath me."},
        {"zh": "我在听水里的声音。", "en": "Listening to the sounds underwater."},
        {"zh": "水面上有光斑。", "en": "There are bright patches on the surface."},
        {"zh": "我这么小，不引人注意。", "en": "I'm small enough to go unnoticed."},
        {"zh": "我在这里待了很久。", "en": "I've been here a long while."},
        {"zh": "我吐了几个气泡。", "en": "I let out a few bubbles."},
        {"zh": "这片水底还算暖和。", "en": "The bottom here is fairly warm."},
        {"zh": "我不需要怎么动。", "en": "I don't need to move much."},
        {"zh": "我把自己藏进泥里。", "en": "I've hidden myself in the mud."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在水里做什么？", "en": "What are you doing in the water?"},
        {"zh": "你比我大很多。", "en": "You're much bigger than me."},
        {"zh": "我会游得很快的。", "en": "I can swim away quickly."},
        {"zh": "你脚下踩着泥了。", "en": "You're standing in the silt."},
        {"zh": "我只是条小鱼。", "en": "I'm only a small fish."},
        {"zh": "你别伸手下水。", "en": "Don't put your hand in the water."},
        {"zh": "我看得见水面上的人。", "en": "I can see people above the surface."},
        {"zh": "我的肉没什么特别。", "en": "There's nothing special about my flesh."},
        {"zh": "这条河底我熟。", "en": "I know this riverbed well."},
        {"zh": "你想捞我上来吗？", "en": "Do you mean to net me out?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我甩了一下尾巴。", "en": "I flicked my tail."},
        {"zh": "我慢慢往水底沉。", "en": "I sank slowly toward the bottom."},
        {"zh": "水一下子浑了起来。", "en": "The water clouded up suddenly."},
        {"zh": "我躲到石头后面。", "en": "I hid behind a stone."},
        {"zh": "我还能继续游。", "en": "I can keep swimming."},
        {"zh": "身上掉了几片鳞。", "en": "A few scales came off."},
        {"zh": "我吐出一串气泡。", "en": "I let out a string of bubbles."},
        {"zh": "这一下打得很沉。", "en": "That one landed very heavy."},
        {"zh": "我慢慢缓过来。", "en": "I'm slowly recovering."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是些小虫子吗？", "en": "Are those little bugs?"},
        {"zh": "这个我不太吃。", "en": "I don't really eat this."},
        {"zh": "我要水里的东西。", "en": "I want what's in the water."},
        {"zh": "扔到水里我就去。", "en": "Drop it in the water and I'll go."},
        {"zh": "太干了，我咽不下。", "en": "Too dry. I can't swallow it."},
        {"zh": "这个闻着不错。", "en": "This smells good."},
        {"zh": "我游过去看看。", "en": "I'm swimming over to look."},
        {"zh": "你手指上有血味。", "en": "There's blood on your finger."},
        {"zh": "我其实吃得不多。", "en": "I don't actually eat much."},
        {"zh": "这点够我吃一天。", "en": "This could last me a day."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你刚刚踩到我了。", "en": "You just stepped on me."},
        {"zh": "我滑到一边去了。", "en": "I slipped off to one side."},
        {"zh": "水里面不好躲开。", "en": "It's hard to dodge underwater."},
        {"zh": "你的靴子挡住我了。", "en": "Your boot's blocking me."},
        {"zh": "我身上滑得很。", "en": "I'm very slippery."},
        {"zh": "别用手直接来抓。", "en": "Don't just grab with your hands."},
        {"zh": "水一下子被搅浑了。", "en": "The water clouded up at once."},
        {"zh": "我绕到你后面。", "en": "I've gone around behind you."},
        {"zh": "我们撞在了一起。", "en": "We bumped into each other."},
        {"zh": "我再游远一些。", "en": "I'll swim a bit further off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只管游和吃。", "en": "I only swim and eat."},
        {"zh": "这些事跟我没关系。", "en": "That has nothing to do with me."},
        {"zh": "我现在还小呢。", "en": "I'm still small right now."},
        {"zh": "泥盆纪的水里同类很多。", "en": "There are many of my kind in these waters."},
        {"zh": "我摆摆尾巴，找个同游的。", "en": "I wag my tail, seeking a swimming partner."},
        {"zh": "我不明白你说什么。", "en": "I don't understand what you mean."},
        {"zh": "我潜到水底去了。", "en": "I sank down to the bottom."},
        {"zh": "这个我不太懂。", "en": "I don't really get that."},
        {"zh": "我转头游开了。", "en": "I turned and swam off."},
        {"zh": "这问题不适合在水里问。", "en": "That's not a question for underwater."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个东西太硬了。", "en": "This thing is too hard."},
        {"zh": "它慢慢沉下去了。", "en": "It sank slowly down."},
        {"zh": "我用嘴拱了拱。", "en": "I nosed at it."},
        {"zh": "这个不是吃的。", "en": "This isn't food."},
        {"zh": "我把它顶到一边。", "en": "I nosed it aside."},
        {"zh": "这是一块小石头。", "en": "This is a small stone."},
