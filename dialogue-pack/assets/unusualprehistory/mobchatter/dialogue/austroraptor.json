    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "看鱼儿游，心动了吧？", "en": "See those fish? Feeling it?"},
        {"zh": "靠近些，让我看看你。", "en": "Come closer, let me see you."},
        {"zh": "用温柔捕获，别暴力。", "en": "Tame with gentleness, not force."},
        {"zh": "小心，我可能生气。", "en": "Watch out, I might get angry."},
        {"zh": "羽毛轻抚，你更诱人。", "en": "Stroke my feathers, you look better."},
        {"zh": "别惊扰我捕食的鱼。", "en": "Don’t scare off my fish."},
        {"zh": "共享美食，你来尝尝？", "en": "Share the catch? Try it."},
        {"zh": "我温顺，不需武器。", "en": "I’m tame, no need for weapons."},
        {"zh": "靠近了，我可以舔你的羽毛。", "en": "Come closer, I can lick your feathers."},
        {"zh": "一起游泳，享受平静。", "en": "Swim with me, enjoy calmness."}
      ]
    },
