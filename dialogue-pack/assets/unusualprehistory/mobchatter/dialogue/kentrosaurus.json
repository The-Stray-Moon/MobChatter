    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "草丛中传来一声哀鸣。", "en": "A mournful cry in the thickets."},
        {"zh": "我的脊背受了伤。", "en": "My spine is injured."},
        {"zh": "灌木丛里有危险。", "en": "Danger in the bushes."},
        {"zh": "我的剑刺受创了。", "en": "My spines are hurt."},
        {"zh": "我被荆棘刮伤了。", "en": "I got scratched by thorns."},
        {"zh": "喂我木贼吧。", "en": "Feed me horsetail."},
        {"zh": "我要蜷缩起来保护自己。", "en": "I will curl up to defend myself."},
        {"zh": "不能动弹了。", "en": "I cannot move."},
        {"zh": "我蜷起四腿，把尖刺朝外。", "en": "I tuck my four legs and point the spikes outward."},
        {"zh": "这里不安全。", "en": "This is unsafe."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "嗷呜，给我叶子！", "en": "Aww, give me the leaves!"},
        {"zh": "木贼的味道，让我放下尖刺。", "en": "The smell of horsetail makes my spikes lower."},
        {"zh": "你来得正好，给我吃的。", "en": "Just in time, give me food."},
        {"zh": "别动，这是我的地盘。", "en": "Don't move, this is my territory."},
        {"zh": "吃木贼，我会保护你。", "en": "Eat horsetail, I'll protect you."},
        {"zh": "看我的尖刺！", "en": "Look at my spikes!"},
        {"zh": "你得小心了，我的刺很疼。", "en": "Watch out, my spikes hurt."},
        {"zh": "别碰我，我不能移动。", "en": "Don't touch me, I can't move."},
        {"zh": "吃草才是我的天职。", "en": "Eating grass is my duty."},
        {"zh": "给我靠近，喂我木贼。", "en": "Come closer, give me horsetail."}
      ]
    },
