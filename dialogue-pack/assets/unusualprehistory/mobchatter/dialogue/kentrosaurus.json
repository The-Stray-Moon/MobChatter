  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "缓慢前行，尖刺警惕.", "en": "Slowly moves, spines alert."},
        {"zh": "草地上漫步，身躯摆动.", "en": "Mooing while walking on grass."},
        {"zh": "剑龙步履轻盈.", "en": "Kentrosaurus steps lightly."},
        {"zh": "咀嚼着绿草前行.", "en": "Chews grass as it walks."},
        {"zh": "身后的尖刺随步摆动.", "en": "Spines sway behind."},
        {"zh": "低头觅食，小心周遭.", "en": "Bends head, wary of surroundings."},
        {"zh": "缓慢转身，警惕四周.", "en": "Turns slowly, vigilant around."},
        {"zh": "低吼，提醒掠食者远离.", "en": "Low growl, warning predators away."},
        {"zh": "咀嚼叶片，享受平静.", "en": "Chews leaves, enjoying calm."},
        {"zh": "缓慢移动，保护自己.", "en": "Moves slowly, protecting itself."},
        {"zh": "尾刺随着步子轻摆。", "en": "My tail spikes sway with each step."},
        {"zh": "粗壮后腿蹬着地面。", "en": "My thick hind legs push off the ground."},
        {"zh": "肩上的长刺擦过枝条。", "en": "The long spike on my shoulder rakes the branches."},
        {"zh": "踩倒一片矮灌木。", "en": "I trample a patch of low shrubs."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静站立，等待食物.", "en": "Stands still, waiting for food."},
        {"zh": "悠闲地咀嚼，享受生活.", "en": "Chews leisurely, enjoying life."},
        {"zh": "安静站立，警惕四周.", "en": "Stands quietly, vigilant."},
        {"zh": "咀嚼着草，慢慢打量.", "en": "Chews grass, slowly observing."},
        {"zh": "静止不动，等待时机.", "en": "Stands still, waiting for an opportunity."},
        {"zh": "静静吃草，享受宁静.", "en": "Eats grass, enjoying peace."},
        {"zh": "低头吃草，享受时光.", "en": "Bends head, enjoying time."},
        {"zh": "悠然自得，享受片刻.", "en": "Relaxing, enjoying a moment."},
        {"zh": "悠闲吃草，等待机会.", "en": "Chews grass, waiting for opportunities."},
        {"zh": "平静站立，享受自然.", "en": "Stands calmly, enjoying nature."},
        {"zh": "鼻孔喷出一口气。", "en": "A puff of breath leaves my nostrils."},
        {"zh": "背刺在阳光下泛光。", "en": "The sun glints along my back spikes."},
        {"zh": "半闭着眼，慢慢反刍。", "en": "Half-shut eyes, I chew my cud."},
        {"zh": "风把灌木吹得沙沙响。", "en": "The wind rustles the shrubs around me."}
      ]
    },
