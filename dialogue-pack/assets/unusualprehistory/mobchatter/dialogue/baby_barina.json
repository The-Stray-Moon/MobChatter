{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我四条腿贴着地走。", "en": "I go low on four legs."},
        {"zh": "我还没长出大人的牙。", "en": "My adult teeth have not come in."},
        {"zh": "我的尾巴比身子还长。", "en": "My tail is longer than my body."},
        {"zh": "我爬过湿泥，留下小坑。", "en": "Small pits follow me through wet mud."},
        {"zh": "我走两步就歪一下。", "en": "Every couple of steps I wobble."},
        {"zh": "我跟着暖的地方走。", "en": "I head for whatever is warm."},
        {"zh": "我在草里钻来钻去。", "en": "I slip through the grass."},
        {"zh": "鼻子贴着地面嗅。", "en": "My snout stays to the ground."},
        {"zh": "我沿着水边走。", "en": "I follow the water's edge."},
        {"zh": "我试着跑，跑得很快。", "en": "I try running, and it works."},
        {"zh": "我撞到石头就停下。", "en": "A stone stops me cold."},
        {"zh": "我回头看有没有跟着的。", "en": "I look back for followers."},
        {"zh": "我的爪子太小，抓不住东西。", "en": "My claws are too small to grip."},
        {"zh": "我打了个滑。", "en": "My feet slip."},
        {"zh": "我一边走一边张着嘴。", "en": "I walk with my mouth open."},
        {"zh": "我还不懂什么叫危险。", "en": "I do not yet know danger."},
        {"zh": "我朝影子扑了一下。", "en": "I snap at a shadow."},
        {"zh": "我慢慢地走回窝里。", "en": "I wander back toward the nest."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着，尾巴慢慢摆。", "en": "I lie still, tail swinging slowly."},
        {"zh": "我在啃一根草。", "en": "I am chewing a blade of grass."},
        {"zh": "我的小牙咬不动这个。", "en": "My small teeth will not cut it."},
        {"zh": "阳光很舒服。", "en": "The sun is pleasant."},
        {"zh": "我抬起头，等谁来。", "en": "I lift my head and wait."},
        {"zh": "水边有虫子在飞。", "en": "Insects skim the water."},
        {"zh": "我打了个哈欠，很大。", "en": "I yawn, hugely."},
        {"zh": "我把自己晒暖。", "en": "I warm myself through."},
        {"zh": "我在泥里滚了一下。", "en": "I roll in the mud."},
        {"zh": "我的皮还是软的。", "en": "My hide is still soft."},
        {"zh": "我听见远处有大的声音。", "en": "I hear something big, far off."},
        {"zh": "我把头埋在草里。", "en": "I bury my head in the grass."},
        {"zh": "我等妈妈回来。", "en": "I wait for my mother."},
        {"zh": "我眨了眨眼。", "en": "I blink."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪头看你。", "en": "I tilt my head at you."},
        {"zh": "你的靴子比我还高。", "en": "Your boot is taller than I am."},
        {"zh": "我不认识你。", "en": "I do not know you."},
        {"zh": "我退了半步，又叫了一声。", "en": "I step back and squeak."},
        {"zh": "你有吃的吗？", "en": "Do you have food?"},
        {"zh": "我张着嘴，其实不咬。", "en": "My mouth is open. I am not biting."},
        {"zh": "你蹲下来我才看得清。", "en": "Crouch down so I can see you."},
        {"zh": "我身后的水里还有别人。", "en": "There is someone else in the water behind me."},
        {"zh": "我叫得很大声。", "en": "I am squealing loudly."},
        {"zh": "我往水边的泥里缩。", "en": "I shrink into the mud by the water."},
        {"zh": "你别动，我先走。", "en": "Do not move. I will go first."},
        {"zh": "我慢慢靠近你。", "en": "I come toward you slowly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫得很惨。", "en": "My squeal is pitiful."},
        {"zh": "我翻了身又翻回来。", "en": "I roll over and back."},
        {"zh": "我躲进泥里。", "en": "I burrow into the mud."},
        {"zh": "这点伤很疼。", "en": "This hurts a lot."},
        {"zh": "我的皮破了。", "en": "My hide is torn."},
        {"zh": "我爬向妈妈。", "en": "I crawl toward my mother."},
        {"zh": "我还在喘。", "en": "I am still breathing."},
        {"zh": "我还活着。", "en": "I am still alive."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是肉吗？", "en": "Is that meat?"},
        {"zh": "你放地上。", "en": "Put it on the ground."},
        {"zh": "我咬不动太大的。", "en": "I cannot bite anything too big."},
        {"zh": "我闻了闻，是新鲜的。", "en": "I sniff it. Fresh."},
        {"zh": "我一口一口慢慢来。", "en": "I take it in small bites."},
        {"zh": "我能咬断这个吗？", "en": "Can I bite through this?"},
        {"zh": "我把整块拖走了。", "en": "I drag the whole piece off."},
        {"zh": "你别抢。", "en": "Do not take it."},
        {"zh": "我还要。", "en": "I want more."},
        {"zh": "我吃饱就睡。", "en": "I sleep once I am full."},
        {"zh": "这味道很熟悉。", "en": "That taste is familiar."},
        {"zh": "你再给一点。", "en": "One more piece."},
        {"zh": "我把它压在前爪下。", "en": "I pin it under a forefoot."},
        {"zh": "我嚼得很慢。", "en": "I chew slowly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得翻了过去。", "en": "The knock rolls me over."},
        {"zh": "我肚皮朝天，爬不起来。", "en": "On my back, I cannot right myself."},
        {"zh": "你的脚好大。", "en": "Your foot is enormous."},
        {"zh": "我贴着地让开。", "en": "I flatten and give way."},
        {"zh": "我鼻子撞疼了。", "en": "My snout hurts."},
        {"zh": "我缩到石头底下。", "en": "I squeeze under a stone."},
        {"zh": "我们都不该在这儿挤。", "en": "Neither of us should crowd here."},
        {"zh": "我没事。", "en": "I am fine."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还太小了。", "en": "I am still too small."},
        {"zh": "我连牙齿都没长齐。", "en": "My teeth are not all in."},
        {"zh": "我躲到妈妈后面。", "en": "I hide behind my mother."},
        {"zh": "我不懂这是什么。", "en": "I do not understand this."},
        {"zh": "我歪着头。", "en": "I cock my head."},
        {"zh": "我继续啃草。", "en": "I go back to chewing grass."},
        {"zh": "我再长大些吧。", "en": "When I am bigger."},
        {"zh": "我摇了摇脑袋。", "en": "I shake my head."},
        {"zh": "这事跟我无关。", "en": "That has nothing to do with me."},
        {"zh": "我走开了。", "en": "I walk off."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住，拖不动。", "en": "I bite it. It will not move."},
        {"zh": "我用前爪拨了拨。", "en": "I nudge it with a forefoot."},
        {"zh": "这不是肉。", "en": "Not meat."},
        {"zh": "我把它翻过来看。", "en": "I roll it over to look."},
        {"zh": "我含着它走了一段。", "en": "I carry it a while."},
        {"zh": "它掉在泥里了。", "en": "It fell in the mud."},
        {"zh": "我闻了闻，放下。", "en": "I sniff, then let go."},
        {"zh": "我喜欢这个。", "en": "I like this one."},
        {"zh": "我藏在草下面。", "en": "I hide it under the grass."},
        {"zh": "我拿回去给妈妈。", "en": "I take it back to my mother."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫得很凶。", "en": "I am squealing fiercely."},
        {"zh": "我挡在水边。", "en": "I stand at the water's edge."},
        {"zh": "我还没咬过东西。", "en": "I have never bitten anything."},
        {"zh": "我试着往前冲。", "en": "I try a charge."},
        {"zh": "我身上的皮竖了起来。", "en": "My hide prickles."},
        {"zh": "我不退。", "en": "I do not retreat."},
        {"zh": "别靠过来。", "en": "Do not come closer."},
        {"zh": "我的尾巴拍在水上。", "en": "My tail slaps the water."},
        {"zh": "我要试试我的牙。", "en": "I will test my teeth."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你和我妈妈之间。", "en": "I am between you and my mother."},
        {"zh": "我一步一歪地靠近。", "en": "I close in, wobbling."},
        {"zh": "我叫，是为了壮胆。", "en": "I squeal to steady my nerve."},
        {"zh": "水会帮我。", "en": "The water will help me."},
        {"zh": "你再走一步。", "en": "One more step."},
        {"zh": "我要咬了。", "en": "I am going to bite."},
        {"zh": "我不怕你。", "en": "I am not afraid of you."},
        {"zh": "我还没长大，但已经盯上你了。", "en": "I'm not grown yet, but I've already marked you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住你的靴子。", "en": "I bite your boot."},
        {"zh": "小牙扎不进护甲。", "en": "Small teeth do not pierce armor."},
        {"zh": "我撞你的脚趾。", "en": "I butt your toes."},
        {"zh": "这一下很轻。", "en": "That was very light."},
        {"zh": "爪子划了一道白痕。", "en": "One claw leaves a white scratch."},
        {"zh": "我甩头，想撕开。", "en": "I shake my head to tear."},
        {"zh": "你一动我就松了。", "en": "When you move, I let go."},
        {"zh": "我又扑了一下。", "en": "I lunge again."},
        {"zh": "这是我全部的力气。", "en": "That was all my strength."},
        {"zh": "我退回去了。", "en": "I retreat."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从蛋里爬出来。", "en": "I crawl out of the egg."},
        {"zh": "身上还湿着。", "en": "Still wet from the shell."},
        {"zh": "这是哪儿？", "en": "Where is this?"},
        {"zh": "我的腿还不稳。", "en": "My legs are unsteady."},
        {"zh": "我第一眼看到的是泥。", "en": "The first thing I see is mud."},
        {"zh": "妈妈在不远处。", "en": "My mother is not far."},
        {"zh": "这地方很暖。", "en": "It is warm here."},
        {"zh": "我慢慢走向水边。", "en": "I toddle toward the water."},
        {"zh": "有大的东西在动。", "en": "Something big is moving."},
        {"zh": "我躲到草里。", "en": "I duck into the grass."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热得我直往水里钻。", "en": "The heat drives me into the water."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔得翻了两个身。", "en": "I land and roll twice."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过头顶了。", "en": "The water is over my head."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀进泥里。", "en": "The blast throws me into the mud."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭擦过我的腿。", "en": "An arrow grazes my leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我直发抖。", "en": "That light sets me shivering."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声太大，我钻进草里。", "en": "The thunder is huge; I dive into grass."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有泥，也没有水。", "en": "No mud here, and no water."}
      ]
    }
  }
