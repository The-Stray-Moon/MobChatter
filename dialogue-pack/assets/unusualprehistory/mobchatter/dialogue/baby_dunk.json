      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "我的小嘴，还张不开。", "en": "My small jaw cannot open wide yet."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光刺得我鳞片发紧。", "en": "That light makes my scales tighten."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "小邓氏鱼张开口，什么也吸不到。", "en": "A baby Dunk opens wide and catches nothing."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电顺着水钻进我的鳃。", "en": "The current runs into my gills through the water."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "被吸进了虚空中。", "en": "Drained by the void."}
