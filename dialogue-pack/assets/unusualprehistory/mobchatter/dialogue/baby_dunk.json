{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜噜，我要游遍大海！", "en": "Rumble, I'll swim all the ocean!"},
        {"zh": "这么大的嘴巴，连鱼也吃！", "en": "Such a big mouth, eats even fish!"},
        {"zh": "深海才是我的家！", "en": "Deep sea is my home!"},
        {"zh": "咕噜噜，饥饿难耐！", "en": "Rumble, starved to death!"},
        {"zh": "游得快，才能活久点！", "en": "Swim fast, to live longer!"},
        {"zh": "我的牙齿如锋利刀片！", "en": "My teeth as sharp as blades!"},
        {"zh": "看看，这里有没有食物？", "en": "Check, if there's any food here?"},
        {"zh": "这里的食物真难找！", "en": "Food here is really hard to find!"},
        {"zh": "咕噜噜，要找更多猎物！", "en": "Rumble, need more prey!"},
        {"zh": "猎物的味道真鲜美！", "en": "Prey so delicious!"},
        {"zh": "我还小，牙齿先长齐了。", "en": "I am small, but my teeth came in first."},
        {"zh": "我追着小鱼绕石头。", "en": "I chase small fish around the rocks."},
        {"zh": "我尾鳍太短，游得歪。", "en": "My tail fin is short, so I swim crooked."},
        {"zh": "我试着咬住一块贝壳。", "en": "I try to bite down on a shell."},
        {"zh": "我贴着水底找东西吃。", "en": "I hug the bottom, hunting for food."},
        {"zh": "我一摆头，砂就扬起来。", "en": "One shake of my head stirs the sand."},
        {"zh": "我想把那块石头吞下去。", "en": "I want to swallow that stone."},
        {"zh": "我绕着气泡往上冲。", "en": "I charge up along the bubbles."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "在这里，我最安全！", "en": "I'm safest here!"},
        {"zh": "耐心等，食物自会来。", "en": "Be patient, food will come."},
        {"zh": "我还小，可我这口牙已经长齐。", "en": "Young, yet all my teeth are in."},
        {"zh": "享受这一刻的宁静。", "en": "Enjoy this quiet moment."},
        {"zh": "安静中孕育力量。", "en": "Power in silence."},
        {"zh": "深海的孤独，也是一种美。", "en": "Solitude of the deep is beautiful."},
        {"zh": "这里的一切都是我的。", "en": "Everything here is mine."},
        {"zh": "等待，是捕食者的艺术。", "en": "Waiting, art of predators."},
        {"zh": "缸里太小，我转不开身。", "en": "This tank is too small to turn around in."},
        {"zh": "在这里，我就是主宰。", "en": "Here, I'm the ruler."},
        {"zh": "我躲在石块后面探出头。", "en": "I peek out from behind a stone."},
        {"zh": "我咬着水草磨牙。", "en": "I chew waterweed to wear in my teeth."},
        {"zh": "我张一下嘴，再合上。", "en": "I open my jaw and close it."},
        {"zh": "水流推我，我不动。", "en": "The current pushes me. I don't move."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物？好！", "en": "Prey? Good!"},
        {"zh": "那个人类，是新食物？", "en": "That human, new food?"},
        {"zh": "你的气息，很有趣。", "en": "Your scent, very interesting."},
        {"zh": "我这么小，嘴已经张开了。", "en": "Small as I am, my jaw already opens."},
        {"zh": "看我的攻击方式！", "en": "Watch my attack!"},
        {"zh": "你的声音，很美味。", "en": "Your voice, very tasty."},
        {"zh": "你手上有鱼腥味，拿来。", "en": "Your hands smell of fish — hand it over."},
        {"zh": "别动，我数到三。", "en": "Don't move, count to three."},
        {"zh": "准备好了吗？我来了！", "en": "Ready? Here I come!"},
        {"zh": "我的牙板还没长硬，但够咬。", "en": "My jaw plates aren't hard yet, but they'll bite."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "呜呜，我的鳍受伤了。", "en": "Ahh, my fins are hurt."},
        {"zh": "好疼，我受惊了。", "en": "Ouch, I got scared."},
        {"zh": "这疼的……太厉害了。", "en": "That hurts... a lot."},
        {"zh": "我的身体怎么了……", "en": "What's wrong with my body..."},
        {"zh": "为什么我这么疼……", "en": "Why am I in so much pain..."},
        {"zh": "求求你，救救我吧。", "en": "Please, help me."},
        {"zh": "我好害怕，救救我。", "en": "I'm scared, please help."},
        {"zh": "这是怎么回事……", "en": "What's happening..."},
        {"zh": "我不明白……", "en": "I don't understand..."},
        {"zh": "我的牙板还咬不碎壳。", "en": "My jaw plates still can't crack shells."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "巨大的颚闪烁着蓝光，引诱你靠近。", "en": "Luminous jaws beckon you closer."},
        {"zh": "我的牙齿锋利如刀，你无法抗拒。", "en": "Sharp teeth draw you in."},
        {"zh": "我幼年的力量已不容小觑。", "en": "My youth is no mere toy."},
        {"zh": "靠近我，体验巨口的力量。", "en": "Draw near, feel the might."},
        {"zh": "沉入这片水域，寻找我的猎物。", "en": "Dive, seek my prey."},
        {"zh": "猎物的恐惧让我兴奋。", "en": "Fear stirs my appetite."},
        {"zh": "不要尝试靠近，你会后悔。", "en": "Stay back, you'll rue it."},
        {"zh": "用食物训练我，我会服从。", "en": "Feed me, and I'll obey."},
        {"zh": "我的体型庞大，足以吞噬一切。", "en": "My size dictates your fate."},
        {"zh": "小心，我的口中有死亡的诱惑。", "en": "Beware, death in my jaws."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的船撞上了我的领地。", "en": "Your vessel intruded my domain."},
        {"zh": "碰撞激起了水花，你倒退。", "en": "Splash! You retreat."},
        {"zh": "我不喜欢陌生人闯入我的水域。", "en": "Stranger, leave now."},
        {"zh": "碰撞触发了我的警觉。", "en": "Collision alerts me."},
        {"zh": "躲开，否则我会反击。", "en": "Move, or I'll strike."},
        {"zh": "我用速度避开碰撞。", "en": "Speed evades collision."},
        {"zh": "这次只是警告，下次就不是了。", "en": "This time, a warning; next, pain."},
        {"zh": "你与我相撞，但我没理会。", "en": "You collide, I ignore."},
        {"zh": "碰撞后，我更加警惕。", "en": "Collision, then caution."},
        {"zh": "轻轻的碰撞不会伤害我。", "en": "Gentle touches harm not."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找我的同伴，一起生存。", "en": "Seek my mate, survive."},
        {"zh": "我的同类与我共享水域。", "en": "My kind shares my space."},
        {"zh": "与我并肩，繁衍后代。", "en": "Mate, procreate with me."},
        {"zh": "泥盆纪的鱼，也要挑对象。", "en": "Even Devonian fish are picky about partners."},
        {"zh": "用声音吸引我的配偶。", "en": "Sound attracts my mate."},
        {"zh": "谁敢碰她，我咬穿甲壳。", "en": "Touch her and I bite through shell."},
        {"zh": "我的配偶必须强大。", "en": "My mate must be strong."},
        {"zh": "与我结合，共创未来。", "en": "Combine with me, future ours."},
        {"zh": "我的伴侣是同类的象征。", "en": "Mate signifies kinship."},
        {"zh": "等我长大再想这些事。", "en": "I will think about that when I grow."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你太接近了！", "en": "You're too close!"},
        {"zh": "这块肉是我的，牙板先咬住。", "en": "That meat is mine — jaw plates clamp first."},
        {"zh": "这块肉是我的，别抢。", "en": "This meat is mine, don't grab it."},
        {"zh": "别过来，否则吃你！", "en": "Don't come closer, or you'll be eaten!"},
        {"zh": "小邓氏鱼，也会咬手指。", "en": "Even a baby Dunk bites fingers."},
        {"zh": "快走开，否则后果自负！", "en": "Move away, or you'll regret it!"},
        {"zh": "滚远点，我饿了！", "en": "Get farther away, I'm hungry!"},
        {"zh": "别靠近，这张嘴比我还大。", "en": "Do not come near, this mouth is bigger than me."},
        {"zh": "我的巨口能把你吞了！", "en": "My mouth can swallow you whole!"},
        {"zh": "这块肉是我的，别碰！", "en": "That meat is mine. Don't touch it!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物来了，我要吃！", "en": "Prey, I'm going to eat you!"},
        {"zh": "看我的巨口！", "en": "Look at my mouth!"},
        {"zh": "我要把你吞下去！", "en": "I'm going to swallow you!"},
        {"zh": "嘴一张，水就往里灌。", "en": "My mouth opens and the water rushes in."},
        {"zh": "我还小，牙已经够硬。", "en": "I'm small, but my jaws are hard already."},
        {"zh": "猎物，准备送命吧！", "en": "Prey, you're going to die!"},
        {"zh": "我的牙齿锋利无比！", "en": "My teeth are razor-sharp!"},
        {"zh": "猎物，准备好挨揍了！", "en": "Prey, get ready for a beating!"},
        {"zh": "享受被吞噬吧！", "en": "Enjoy being devoured!"},
        {"zh": "吸力一起，你就往我嘴里滑。", "en": "The suction starts and you slide into my mouth."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我这张小嘴，已经会吸了。", "en": "My little mouth can already suck prey in."},
        {"zh": "注意我的压力波！", "en": "Watch out for my pressure wave!"},
        {"zh": "猎物，我要把你看穿！", "en": "Prey, I'm going to see right through you!"},
        {"zh": "注意，危险来了！", "en": "Beware, danger is coming!"},
        {"zh": "我还小，可嘴已经能张开了。", "en": "I'm small, but my jaw already opens wide."},
        {"zh": "巨口一张，水就把你送过来。", "en": "My jaws open, and the water brings you in."},
        {"zh": "猎物，你逃不掉的！", "en": "You can't escape, prey!"},
        {"zh": "盯着你的脚蹼，等它停下。", "en": "I watch your flipper and wait for it to stop."},
        {"zh": "猎物，你在我控制中！", "en": "Prey, you're in my control!"},
        {"zh": "我要享受这顿美餐！", "en": "I'm going to enjoy this delicious meal!"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶！”，巨颚一开，吸你入腹！", "en": "Hisss! Jaw opens, sucks you in!"},
        {"zh": "我就是这里的霸主！", "en": "I'm the boss here!"},
        {"zh": "幼鱼也咬得断手指。", "en": "Even a fry can bite a finger off."},
        {"zh": "我的巨颚能瞬间分尸！", "en": "My jaw can disembowel instantly!"},
        {"zh": "我一口咬住你的脚蹼。", "en": "I clamp my jaws onto your flipper."},
        {"zh": "你来吧，尝尝我的巨口！", "en": "Come on, feel my jaws!"},
        {"zh": "水下是我的战场！", "en": "Water's my battlefield!"},
        {"zh": "我的牙齿能咬碎一切！", "en": "My teeth can crush anything!"},
        {"zh": "快逃，不然就被吞了！", "en": "Run or you'll be swallowed!"},
        {"zh": "我摆尾追你，水花炸开。", "en": "I beat my tail after you and the water bursts."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "水下洞穴深处，我来了！", "en": "Deep underwater caves, here I come!"},
        {"zh": "咕噜咕噜，找食物！", "en": "Rrr, hunting food!"},
        {"zh": "泥盆纪的水底，我先找石头缝。", "en": "On the Devonian riverbed I look for a crevice first."},
        {"zh": "我从深海中孵化！", "en": "I hatch from the deep!"},
        {"zh": "水下通道，我的领地！", "en": "Underwater passage, my territory!"},
        {"zh": "一张嘴，水就往里灌。", "en": "One open mouth and the water rushes in."},
        {"zh": "我在这里等你上钩！", "en": "I wait here for you!"},
        {"zh": "水下洞穴，我的庇护所！", "en": "Underwater caves, my sanctuary!"},
        {"zh": "咕噜咕噜，捕猎时刻！", "en": "Rrr, hunting time!"},
        {"zh": "水下黑暗，我的舞台！", "en": "Dark underwater, my stage!"},
        {"zh": "我破壳时先咬了一口。", "en": "I bit something the moment I hatched."},
        {"zh": "培养器的黏液把我推出来。", "en": "The cultivator's slime pushed me out."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "好烫，别烧我。", "en": "Too hot, don't burn me."}
      ]
    },
    "hurt.fall": {
