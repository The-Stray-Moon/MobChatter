{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "踩着冰块前行", "en": "Walk on ice blocks"},
        {"zh": "呼噜呼噜叫着", "en": "Snort and snuffle"},
        {"zh": "鼻子一卷，草根带着土。", "en": "My trunk curls up grass roots with the soil."},
        {"zh": "摇晃着大耳朵", "en": "Shake big ears"},
        {"zh": "咀嚼着草叶", "en": "Chew grass leaves"},
        {"zh": "用牙齿啃食冰块", "en": "Chomp on ice blocks"},
        {"zh": "甩动着长尾巴", "en": "Swing long tail"},
        {"zh": "雪地打滚，绒毛沾满冰。", "en": "Rolling in snow packs ice into my fur."},
        {"zh": "用后脚站立", "en": "Stand on hind legs"},
        {"zh": "警惕地移动", "en": "Move cautiously"},
        {"zh": "小短腿追着妈妈跑", "en": "Short legs trot after mother."},
        {"zh": "踩在雪面上咯吱响", "en": "Snow crunches under my feet."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "低头找草，找到一根冻的。", "en": "I lower my head for grass and find only frozen stalks."},
        {"zh": "雪堆软，正适合打滚。", "en": "The snowbank is soft, perfect for rolling."},
        {"zh": "打个响鼻", "en": "Snort loudly"},
        {"zh": "舔舔自己的长牙", "en": "Lick long tusks"},
        {"zh": "用鼻子轻轻碰触", "en": "Touch trunk gently"},
        {"zh": "我伸着短鼻子找妈妈", "en": "I stretch my short trunk out, looking for mother"},
        {"zh": "打个哈欠", "en": "Yawn widely"},
        {"zh": "用牙齿梳理毛发", "en": "Tend to fur with teeth"},
        {"zh": "看着天空", "en": "Stare at sky"},
        {"zh": "低低一声，幼崽就靠过来。", "en": "One low call and the calf comes close."},
        {"zh": "躲在妈妈腿后面", "en": "I hide behind mother's legs."},
        {"zh": "用鼻子卷起一根草", "en": "I curl my trunk around a blade of grass."},
        {"zh": "绒毛上结了小冰晶", "en": "Ice crystals cling to my fuzz."},
        {"zh": "蜷着身子打盹", "en": "I doze with my body curled up."},
        {"zh": "竖起耳朵听脚步声", "en": "I prick my ears at footsteps."},
        {"zh": "学着首领的样子站好", "en": "I stand tall like the gray leader."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上没有象牙的味道。", "en": "You don't smell of ivory at all."},
        {"zh": "警觉地转头", "en": "Turn head cautiously"},
        {"zh": "用鼻子靠近你", "en": "Move trunk close to you"},
        {"zh": "好奇地嗅探", "en": "Sniff curiously"},
        {"zh": "我躲在长辈的毛后面。", "en": "I hide behind the elders' fur."},
        {"zh": "你的衣服，没有毛暖和。", "en": "Your clothes are not as warm as fur."},
        {"zh": "用牙齿轻轻碰触", "en": "Tenderly touch with tusks"},
        {"zh": "警惕地靠近你", "en": "Approach you cautiously"},
        {"zh": "我用鼻子碰了碰你的手。", "en": "I touched your hand with my trunk."},
        {"zh": "试图接近你", "en": "Try to approach you"},
        {"zh": "从妈妈腿后探出头", "en": "I peek out from behind mother."},
        {"zh": "这个人是敌是友", "en": "Is this one friend or foe?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "幼象惨叫", "en": "Baby mammoth in pain"},
        {"zh": "小象呜咽", "en": "Baby mammoth whimpering"},
        {"zh": "小象哀鸣", "en": "Baby mammoth moaning"},
        {"zh": "幼象哭泣", "en": "Baby mammoth crying"},
        {"zh": "小象呻吟", "en": "Baby mammoth groaning"},
        {"zh": "幼象尖叫", "en": "Baby mammoth shrieking"},
        {"zh": "小象悲鸣", "en": "Baby mammoth wailing"},
        {"zh": "幼象呼救", "en": "Baby mammoth calling for help"},
        {"zh": "小象嘶鸣", "en": "Baby mammoth snorting"},
        {"zh": "幼象嚎叫", "en": "Baby mammoth howling"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿时会接近你，毛茸茸的身体吸引着你去触摸。", "en": "You can't resist the soft fur when hungry."},
        {"zh": "寻找食物时，会用长牙挖掘地面。", "en": "Uses tusks to dig for food."},
        {"zh": "幼年猛犸象很少单独行动。", "en": "Rarely ventures out alone."},
        {"zh": "会用鼻子卷起你，看看是否适合。", "en": "Will pick you up with its trunk."},
        {"zh": "毛线可以从它的长毛中剪出。", "en": "Can get thread from its fur."},
        {"zh": "棕色羊毛也能从它身上剪得。", "en": "Can also get brown wool."},
        {"zh": "有时会停下来，好奇地观察你。", "en": "Sometimes stops to investigate."},
        {"zh": "幼年猛犸象比成年更易驯服。", "en": "Easier to tame than adults."},
        {"zh": "靠近它时要小心，可能会用长牙触碰你。", "en": "Be careful, it might use its tusks."},
        {"zh": "长牙是它的重要武器，但目前还较小。", "en": "Tusks are a threat, but not fully grown."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "成年猛犸象会用身体阻挡你。", "en": "Adults block your path."},
        {"zh": "会用大而厚重的身体撞击敌人。", "en": "Heavy body crashes into enemies."},
        {"zh": "幼年猛犸象体型较小，但力量也不可小觑。", "en": "Small but strong enough."},
        {"zh": "被你撞击时，会用长牙反击。", "en": "Reacts with tusks."},
        {"zh": "互相碰撞时，会用鼻子缠斗。", "en": "Wrangle with trunks."},
        {"zh": "头部撞击是最有效的防御方式。", "en": "Headbutts are its defense."},
        {"zh": "幼年猛犸象的碰撞还不太有技巧。", "en": "Collisions are still clumsy."},
        {"zh": "猛烈的碰撞能打乱敌人的阵型。", "en": "Collisions disrupt enemies."},
        {"zh": "用身体挡在同伴前，保护幼崽。", "en": "Protects young with its body."},
        {"zh": "互相碰撞时会发出低沉的吼声。", "en": "Rumble when colliding."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找伴侣时会发出长鸣。", "en": "Long call to attract mates."},
        {"zh": "会用鼻子亲密接触以示爱意。", "en": "Uses trunk to show affection."},
        {"zh": "成年猛犸象会守护自己的伴侣。", "en": "Adults guard their mates."},
        {"zh": "幼年猛犸象会陪伴在父母身边。", "en": "Stay near parents."},
        {"zh": "伴侣之间会用鼻子互相梳理。", "en": "Mutually clean with trunks."},
        {"zh": "成年猛犸象会用身体围住对方。", "en": "Surround the mate with bodies."},
        {"zh": "伴侣间的亲密行为会持续一段时间。", "en": "Long embrace between mates."},
        {"zh": "成年猛犸象会用长牙轻触对方。", "en": "Tender tusks for mate."},
        {"zh": "幼年猛犸象会用鼻子轻轻触碰。", "en": "Tender trunks for young."},
        {"zh": "伴侣间有特殊的气味交流。", "en": "Special scent exchange."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "用铲子挖掘我，我会出现！", "en": "Dig with a shovel, and I'll appear!"},
        {"zh": "毛里有线，快来剪吧！", "en": "There's thread in my fur, come clip me!"},
        {"zh": "啃啃我的骨头，很有嚼头！", "en": "Chew on my bones, they're delicious!"},
        {"zh": "灰色是我的颜色，跟着我！", "en": "Follow me, I'm the gray one."},
        {"zh": "穿上我的毛线衣，温暖你！", "en": "Wrap yourself in my fur, stay warm."},
        {"zh": "棕色羊毛，快来收割！", "en": "Harvest my brown wool, it's soft."},
        {"zh": "用暴君之冠，我能听你指挥！", "en": "With the Tyrant Crown, I'll obey you."},
        {"zh": "我的体型庞大，小心踩空！", "en": "I'm big, watch your step!"},
        {"zh": "跟随我，保护幼崽！", "en": "Follow me, protect the young."},
        {"zh": "啃我，但我不是敌人！", "en": "Eat me, I'm not the enemy."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "注意！危险的生物出现了！", "en": "Warning! Dangerous creature approaching!"},
        {"zh": "寻找食物，快靠近我！", "en": "Find food, come closer!"},
        {"zh": "我就是你的猎物，慢慢享受！", "en": "You're my prey, enjoy the hunt!"},
        {"zh": "我抬起鼻子，叫来整群。", "en": "I raise my trunk and call the whole herd."},
        {"zh": "我闻到你手上的草屑了。", "en": "I smell the grass scraps on your hands."},
        {"zh": "我是你的目标，准备战斗！", "en": "I'm your target, prepare to fight!"},
        {"zh": "小心，我是成年猛犸象的幼崽！", "en": "Beware, I'm a baby mammoth!"},
        {"zh": "用暴君之冠，我会听你指挥！", "en": "Tyrant Crown, I'll obey you."},
        {"zh": "我是群体的一员，团结起来！", "en": "I'm part of a group, join us!"},
        {"zh": "跟随我，探索未知！", "en": "Follow me, explore the unknown!"},
        {"zh": "妈妈，那边有人", "en": "Mother, someone is over there."},
        {"zh": "族人围成一个圈", "en": "The herd closes into a circle."},
        {"zh": "灰色首领先动了", "en": "The gray leader moves first."},
        {"zh": "我学着吼了一声", "en": "I try a trumpet of my own."},
        {"zh": "把幼崽护在中间", "en": "The calves are kept in the middle."},
        {"zh": "谁靠近就撞谁", "en": "Whoever comes close gets shoved."},
        {"zh": "长牙排成一堵墙", "en": "Tusks line up into a wall."},
        {"zh": "跟着妈妈撞过去", "en": "I charge along with mother."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "象群就在后面，你确定？", "en": "The herd is right behind me. Sure?"},
        {"zh": "毛茸茸的敌人，小心！", "en": "Fuzzy foe, beware!"},
        {"zh": "你逃不掉的，我是猛犸象！", "en": "You can't escape, I'm a mammoth!"},
        {"zh": "用剪刀剪下我的线，小心！", "en": "Snip my thread, be careful!"},
        {"zh": "我的体型庞大，你打不过我！", "en": "I'm too big for you to defeat!"},
        {"zh": "离小象远点，鼻子警告你。", "en": "Stay away from the calf — my trunk warns you."},
        {"zh": "我的体型庞大，小心碰撞！", "en": "Be careful, I'm big!"},
        {"zh": "用暴君之冠，我能听你指挥", "en": "Tyrant Crown, I'll obey you"},
        {"zh": "靠近我，感受我的力量", "en": "Approach me, feel my strength!"},
        {"zh": "我有骨骼，你来试试？", "en": "I have bones, do you dare?"},
        {"zh": "先撞它的膝盖", "en": "Aim for its knees first."},
        {"zh": "围住它，不给退路", "en": "Surround it, leave no way out."},
        {"zh": "鼻子卷紧，准备冲", "en": "Trunk coiled, ready to charge."},
        {"zh": "一步步缩小圈子", "en": "Step by step the circle tightens."},
        {"zh": "我负责吓它一跳", "en": "I will give it a fright."},
        {"zh": "妈妈点头，我就上", "en": "When mother nods, I go."},
        {"zh": "用额头顶它膝盖", "en": "I headbutt its knee."},
        {"zh": "牙尖对准它的腿", "en": "Tusk tips aim at its legs."},
        {"zh": "等它先动，再撞", "en": "Let it move first, then ram."},
        {"zh": "全族都在等信号", "en": "The whole herd waits for a signal."}
      ]
    },
    "melee_attack": {
