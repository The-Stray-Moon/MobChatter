{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里慢慢转着螺壳。", "en": "I turn my spiral shell in the water."},
        {"zh": "我靠喷水往前挪。", "en": "I jet forward in little bursts."},
        {"zh": "我的触手在水中散开。", "en": "My tentacles spread in the water."},
        {"zh": "我沿着海床滑过一段。", "en": "I drift above the seabed."},
        {"zh": "我朝亮一点的水层游。", "en": "I head for brighter water."},
        {"zh": "我绕着珊瑚转了一圈。", "en": "I circle a coral."},
        {"zh": "我的壳上有层层纹路。", "en": "Ridges layer my shell."},
        {"zh": "我从水草上方漂过去。", "en": "I pass over the weeds."},
        {"zh": "我收起触手，贴着礁石滑。", "en": "I draw in my tentacles and glide along the rock."},
        {"zh": "我用触手拨开水流。", "en": "My tentacles part the current."},
        {"zh": "我朝深处游去，慢慢地。", "en": "I sink deeper, slowly."},
        {"zh": "水压把我压得更紧。", "en": "Pressure hugs my shell."},
        {"zh": "我在两块礁石之间穿过。", "en": "I slip between two rocks."},
        {"zh": "我一收一放，往前漂。", "en": "Contract, release, drift."},
        {"zh": "暖的水层让我游得快些。", "en": "Warm water speeds me up."},
        {"zh": "我贴着水面往上浮。", "en": "I rise toward the surface."},
        {"zh": "我绕着一根海草打转。", "en": "I turn around a stalk."},
        {"zh": "我又沉回原来的水层。", "en": "I sink back to my depth."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水里，壳朝下。", "en": "I hang shell-down in the water."},
        {"zh": "海床很安静，只有水流。", "en": "Quiet here, only current."},
        {"zh": "我的触手收成一小团。", "en": "My tentacles draw in."},
        {"zh": "我在听远处的船声。", "en": "I listen for boats."},
        {"zh": "我的壳里灌满了水。", "en": "Water fills my shell."},
        {"zh": "我在慢慢调浮力。", "en": "I adjust my buoyancy."},
        {"zh": "沙粒落在我壳上。", "en": "Sand settles on my shell."},
        {"zh": "我微微转动壳口。", "en": "I turn my aperture slightly."},
        {"zh": "这处礁石，我常来。", "en": "I know this reef."},
        {"zh": "我在数上方游过的鱼。", "en": "I count the fish above."},
        {"zh": "我在等水暖一点。", "en": "I wait for the water to warm."},
        {"zh": "我的触手轻轻摆着。", "en": "My tentacles wave gently."},
        {"zh": "这里没有谁追谁。", "en": "Nothing chases anything here."},
        {"zh": "我缩进壳里歇了一下。", "en": "I draw in and rest."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你下水了，很好。", "en": "You came down. Good."},
        {"zh": "我的壳是从前的样子。", "en": "My shell is an old design."},
        {"zh": "我不是鱼，我比鱼老。", "en": "I am not a fish. I am older."},
        {"zh": "别用手抓我的壳。", "en": "Do not grab the shell."},
        {"zh": "你身上的气泡很好玩。", "en": "Your bubbles are interesting."},
        {"zh": "我在这场水里活得很久。", "en": "I have been in this water long."},
        {"zh": "桶口太小，我钻不进去。", "en": "That bucket's too small for me."},
        {"zh": "我在你上面一点。", "en": "I am a little above you."},
        {"zh": "你能憋多久？", "en": "How long can you hold your breath?"},
        {"zh": "我认识这片海床。", "en": "I know this seabed."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳口缺了一角，螺层还在。", "en": "A corner of my aperture is gone; the whorls remain."},
        {"zh": "我缩进壳里，水被挤出去。", "en": "I draw in; water squeezes out."},
        {"zh": "我沉了一点，又稳住。", "en": "I sink a little and steady."},
        {"zh": "我的壳碎了一片，还能补。", "en": "A piece of my shell broke. It can be mended."},
        {"zh": "我少了一根触手。", "en": "One tentacle fewer."},
        {"zh": "我不叫，水里传得不远。", "en": "I make no sound. Water hides it."},
        {"zh": "沙落进我的壳口。", "en": "Sand gets in my aperture."},
        {"zh": "我的壳比刚才重了。", "en": "My shell is heavier now."},
        {"zh": "我慢慢转开，壳朝向你。", "en": "I turn my shell to you."},
        {"zh": "这点伤，壳会补。", "en": "The shell will mend."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "小鱼？我自己找。", "en": "Small fish? I find my own."},
        {"zh": "沉到海床，我再考虑。", "en": "Sink it to the seabed and I'll consider."},
        {"zh": "我不吃大的，咬不动。", "en": "Not big things. I cannot bite them."},
        {"zh": "这块东西在水里发白。", "en": "That goes pale underwater."},
        {"zh": "气味不对，我不靠近。", "en": "Wrong smell. I stay off."},
        {"zh": "你抓的东西还在动。", "en": "What you hold is moving."},
        {"zh": "我更喜欢自己捕的。", "en": "I prefer my own catch."},
        {"zh": "我的壳比这点食物值钱。", "en": "My shell is worth more than that."},
        {"zh": "你放下的东西会沉。", "en": "It will sink."},
        {"zh": "我慢慢转过来看看。", "en": "I turn to look."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我的壳，很硬。", "en": "You touch my shell. Hard."},
        {"zh": "我在水里很轻，但壳很沉。", "en": "Light in water, heavy of shell."},
        {"zh": "水流把我推开了一点。", "en": "The current pushes me off."},
        {"zh": "我绕着你的手转了一圈。", "en": "I circle your hand."},
        {"zh": "碰撞让沙扬了起来。", "en": "Sand lifts with the bump."},
        {"zh": "我退了，壳朝向你。", "en": "I retreat, shell facing you."},
        {"zh": "我的触手碰到你的指节。", "en": "My tentacle touches a knuckle."},
        {"zh": "你差点把我按在礁石上。", "en": "You nearly pinned me to the rock."},
        {"zh": "这一下，沙子进了壳里。", "en": "Sand gets in my shell."},
        {"zh": "我不推人，只漂开。", "en": "I do not push. I drift."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "菊石早就繁衍过很多代。", "en": "Ammonites have bred for ages."},
        {"zh": "我的壳会留在海床里。", "en": "My shell will stay on the seabed."},
        {"zh": "你问得太近了，水会传。", "en": "Too close. Water carries it."},
        {"zh": "这一带只有我这一只。", "en": "Only one of me here."},
        {"zh": "我们产卵在水里，很多。", "en": "We release eggs into the water."},
        {"zh": "别问了，我要沉下去了。", "en": "Stop. I am going down."},
        {"zh": "那些岩层里全是我的同类。", "en": "The rock layers hold my kin."},
        {"zh": "白垩纪结束了，我们也结束了。", "en": "The Cretaceous ended, and so did we."},
        {"zh": "我的壳比我的话更长久。", "en": "My shell outlasts my words."},
        {"zh": "我缩进壳里，不答。", "en": "I draw in. No answer."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块碎壳，我抱着。", "en": "I hold this shell shard."},
        {"zh": "你掉的东西，沉到沙上了。", "en": "Yours sank to the sand."},
        {"zh": "我的触手把它按进沙里。", "en": "My tentacle presses it into the sand."},
        {"zh": "触手试了试，拉不动。", "en": "My tentacle tries; it won't budge."},
        {"zh": "我把它拖进礁石缝。", "en": "I drag it into a crack."},
        {"zh": "这块东西不是我的。", "en": "That is not mine."},
        {"zh": "我慢慢拱开沙，找到它。", "en": "I nudge the sand aside."},
        {"zh": "东西卡在我壳口了。", "en": "It is stuck in my aperture."},
        {"zh": "这壳片，我推回沙里。", "en": "I nudge this shell shard back into the sand."},
        {"zh": "这块留在沙里，让水冲走。", "en": "Leave it for the current."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有小东西游过来了。", "en": "Something small swims in."},
        {"zh": "我的触手全部张开。", "en": "My tentacles all open."},
        {"zh": "我朝那个方向转。", "en": "I turn that way."},
        {"zh": "我锁定了水流里的影子。", "en": "I mark the shadow in the current."},
        {"zh": "这一下，我只用触手。", "en": "I use only tentacles."},
        {"zh": "你在我上面，我知道。", "en": "You are above me. I know."},
        {"zh": "我慢慢往上浮。", "en": "I rise slowly."},
        {"zh": "水越来越紧，我要动了。", "en": "The water tightens. I move."},
        {"zh": "我在数你的气泡。", "en": "I count your bubbles."},
        {"zh": "现在，我靠近你。", "en": "Now I come near."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你的方向漂。", "en": "I drift around your bearing."},
        {"zh": "我的触手在水中摊开。", "en": "My tentacles spread."},
        {"zh": "你每退一点，我就近一点。", "en": "Each shade back, I gain."},
        {"zh": "我在水层里换了个深度。", "en": "I change depth."},
        {"zh": "壳的纹路正对着你。", "en": "My shell's ridges face you."},
        {"zh": "你听得见水流被分开吗？", "en": "Hear the water part?"},
        {"zh": "我在等你的气泡变慢。", "en": "I wait for your bubbles to slow."},
        {"zh": "我的螺壳能装进桶里。", "en": "My coiled shell fits in a bucket."},
        {"zh": "最后一点距离，我加速。", "en": "The last gap. I speed up."},
        {"zh": "现在，我碰到你了。", "en": "Now I touch you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的触手卷住你的手腕。", "en": "My tentacle wraps your wrist."},
        {"zh": "壳口撞在你身上，很钝。", "en": "My shell's rim bumps you."},
        {"zh": "这一下在水里软软的。", "en": "Soft underwater."},
        {"zh": "我喷了一股水，把你推开。", "en": "I jet water and push you off."},
        {"zh": "你的护甲在水里更重了。", "en": "Your armor weighs more in water."},
        {"zh": "我的壳碎了，还能拼回战镐。", "en": "My shell breaks, then becomes a pickaxe."},
        {"zh": "这一下，只有一点点力。", "en": "Only a little force."},
        {"zh": "你退了，我沉下去一点。", "en": "You pull back; I sink."},
        {"zh": "沙被搅起来，你看不清。", "en": "Sand clouds the water."},
        {"zh": "我转了个方向，继续漂。", "en": "I turn and drift on."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "海里多了一只小螺。", "en": "A small shell in the sea."},
        {"zh": "我从沙里浮起来。", "en": "I lift off the sand."},
        {"zh": "水草旁边有东西在转。", "en": "Something turns by the weeds."},
        {"zh": "阳光透过水层照到壳上。", "en": "Sunlight reaches my shell."},
        {"zh": "你听见很轻的水声。", "en": "A faint water sound."},
        {"zh": "菊石壳从礁缝里露出来。", "en": "My ammonite shell slides out of the reef crack."},
        {"zh": "海床上多了一道浅痕。", "en": "A shallow line on the seabed."},
        {"zh": "我的壳在慢慢转。", "en": "My shell turns slowly."},
        {"zh": "这一片水域，够我。", "en": "Enough water here for me."},
        {"zh": "我浮到中间水层。", "en": "I rise to mid-water."},
        {"zh": "触手先伸出来，然后是我。", "en": "Tentacles first, then me."},
        {"zh": "现在，这里有一只菊石。", "en": "Now there is an ammonite here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在水面上，我沉下去了。", "en": "Fire above. I sink."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落到海底，壳磕了。", "en": "I land on the seabed; the shell chips."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌满壳腔，我照样呼吸。", "en": "Water fills my chamber and I breathe all the same."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀得翻了半圈。", "en": "The blast rolls me half over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "鱼叉从我壳边擦过。", "en": "A harpoon grazes my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让我的触手僵住。", "en": "Arts stiffen my tentacles."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有小东西可吃，我变轻了。", "en": "Nothing small to eat. I lighten."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在水面，光透下来。", "en": "Lightning on the surface, light below."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "海床裂开了，下面是空。", "en": "The seabed splits to void."}
      ]
    }
  }
