        {"zh": "你触怒我了，头撞你！", "en": "You've angered me, headbutt you!"},
        {"zh": "我要用我的头，撞碎你！", "en": "I'll use my head to smash you!"},
        {"zh": "我用头撞你，你能躲得开吗？", "en": "I'll headbutt you, can you dodge?"},
        {"zh": "我对你不客气，来吧，头撞！", "en": "I'll charge, headbutt me back!"},
        {"zh": "你惹我了，准备好头撞吧！", "en": "You've annoyed me, headbutt!"},
