{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "低吼前行，石块震颤。", "en": "Rumble as you walk, shaking stones."},
        {"zh": "缓慢前行，头骨闪烁。", "en": "Move slowly, skull glowing faintly."},
        {"zh": "碎石间缓缓踱步。", "en": "Pace through the rubble."},
        {"zh": "头骨轻敲地面。", "en": "Skull taps the ground."},
        {"zh": "咀嚼生银杏种子。", "en": "Chewing raw ginkgo seeds."},
        {"zh": "目光转向玩家。", "en": "Eyes on the player."},
        {"zh": "石头下匍匐前行。", "en": "Creeping under the stones."},
        {"zh": "轻声嘶鸣，步履沉重。", "en": "Low growl, heavy steps."},
        {"zh": "避开尖锐的岩石。", "en": "Steer clear of sharp rocks."},
        {"zh": "碎石中缓慢穿梭。", "en": "Creeping through rubble."},
        {"zh": "头骨低垂，绕开石堆。", "en": "Skull low, I skirt the pile of stones."},
        {"zh": "在蕨丛间小跑。", "en": "I trot between the ferns."},
        {"zh": "尾巴一摆，扬起尘土。", "en": "A flick of my tail raises dust."},
        {"zh": "踏过倒木，脚步沉闷。", "en": "I tramp over a fallen log, heavy-footed."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静等待，头骨低垂。", "en": "Patient, head low."},
        {"zh": "静静站立，凝视远方。", "en": "Standing still, gaze distant."},
        {"zh": "慢慢移动，观察四周。", "en": "Slowly moving, scanning."},
        {"zh": "轻声鸣叫，眼神警惕。", "en": "Soft call, alert gaze."},
        {"zh": "我拿头壳拱开落叶，找种子。", "en": "I push aside the leaf litter with my skull, hunting seeds."},
        {"zh": "静止不动，耐心等待。", "en": "Still, waiting."},
        {"zh": "头骨轻触地面。", "en": "Skull touches the ground."},
        {"zh": "轻声嘶鸣，目光平静。", "en": "Low growl, calm gaze."},
        {"zh": "慢慢转动头骨。", "en": "Skull turns slowly."},
        {"zh": "静静站立，头骨轻晃。", "en": "Standing still, head swaying."},
        {"zh": "蹲在阳光下晒头壳。", "en": "I squat in the sun to warm my skull."},
        {"zh": "磨着喙部，发出沙沙声。", "en": "I grind my beak with a rasping sound."},
        {"zh": "打了个响鼻，泥土飞起。", "en": "I snort, and dirt flies up."},
        {"zh": "半闭着眼，尾巴轻摆。", "en": "Half-shut eyes, tail swaying."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪头，把你从头到脚看一遍。", "en": "I tilt my head and size you up from boots to scalp."},
        {"zh": "转向玩家，低吼。", "en": "Turn to you, low growl."},
        {"zh": "头骨转向玩家。", "en": "Skull turns to you."},
        {"zh": "锁定目标，轻声嘶鸣。", "en": "Target locked, low growl."},
        {"zh": "注意玩家，眼神锐利。", "en": "Player noted, sharp gaze."},
        {"zh": "头骨转向玩家，低吼。", "en": "Skull turns to you, low growl."},
        {"zh": "观察玩家，眼神警觉。", "en": "Observing you, alert gaze."},
        {"zh": "目光坚定，低吼警告。", "en": "Steady gaze, warning growl."},
        {"zh": "头骨轻触地面，观察。", "en": "Skull touches ground, observing."},
        {"zh": "转向玩家，低吼警告。", "en": "Turn to you, low warning growl."},
        {"zh": "抬起喙，打量你的高度。", "en": "I raise my beak and size up your height."},
        {"zh": "眼珠转了转，脾气上来了。", "en": "My eye rolls, and my temper rises."}
      ]
    },
    "hurt": {
