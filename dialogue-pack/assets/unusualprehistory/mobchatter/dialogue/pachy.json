    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手上的银杏，能否平息我的怒气？", "en": "Can your银杏 seed calm my rage?"},
        {"zh": "这片树叶，可让我不再暴躁？", "en": "Will this leaf soothe my temper?"},
        {"zh": "尝尝这果实，可让你安心？", "en": "Try this fruit, maybe I'll be gentle."},
        {"zh": "这银杏，能让我不再攻击？", "en": "This银杏 seed, will it make me stop?"},
        {"zh": "别怕，吃下它，会变乖的。", "en": "No fear, eat this, and you'll be fine."},
        {"zh": "这银杏，能让我不再怒吼？", "en": "This银杏 seed, will it make me silent?"},
        {"zh": "吃下去，我不会乱撞了。", "en": "Eat this, I won't charge."},
        {"zh": "吃下这银杏，我能安心。", "en": "Eat this银杏, I'll be calm."},
        {"zh": "这银杏，让我不攻击你。", "en": "This银杏, no more attacks."},
        {"zh": "吃下这银杏，我会变得温和。", "en": "Eat this银杏, I'll be docile."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡住了我的路，我要撞你！", "en": "You're in my way, I'll headbutt you!"},
