{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用两条腿小跑，尾巴平着。", "en": "I trot on two legs, tail level."},
        {"zh": "我脚趾抓着地，跑得很稳。", "en": "Toes grip; I run steady."},
        {"zh": "我一边跑一边左右看。", "en": "I look around as I run."},
        {"zh": "我穿过一片矮灌木。", "en": "I slip through low brush."},
        {"zh": "我的爪子在土上留下痕。", "en": "My claws score the soil."},
        {"zh": "我绕着一块石头转过去。", "en": "I swing around a stone."},
        {"zh": "我跑几步，停一下。", "en": "I run a few steps, then stop."},
        {"zh": "我的头一直往前探。", "en": "My head keeps pushing forward."},
        {"zh": "羽毛被我抖落了两根。", "en": "Two of my feathers shake loose."},
        {"zh": "我贴着草丛走。", "en": "I keep close to the grass."},
        {"zh": "我慢慢走到高处。", "en": "I climb to higher ground."},
        {"zh": "我朝声音那边跑。", "en": "I run toward the sound."},
        {"zh": "我的步子很轻。", "en": "My steps are very light."},
        {"zh": "我从一丛蕨里钻出来。", "en": "I come out of the ferns."},
        {"zh": "我停在土坡上，看四周。", "en": "I stop on the rise and look around."},
        {"zh": "我又跑起来了。", "en": "I am running again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，羽毛蓬着。", "en": "Standing, my feathers fluffed."},
        {"zh": "我歪头看一个洞。", "en": "I tilt my head at a hole."},
        {"zh": "一根羽毛落在脚边。", "en": "A feather falls by my feet."},
        {"zh": "我在听草丛里的响动。", "en": "I listen to the grass."},
        {"zh": "我把脚在土里刨了刨。", "en": "I scratch the soil."},
        {"zh": "我的眼睛很黑。", "en": "My eyes are very dark."},
        {"zh": "这里没有大掠食者。", "en": "There are no big predators here."},
        {"zh": "我眨了一下眼，很快。", "en": "I blink, quickly."},
        {"zh": "我伏低身子，又弹起来。", "en": "I crouch low, then spring upright."},
        {"zh": "我在啃一根细骨。", "en": "I am gnawing a thin bone."},
        {"zh": "风把羽毛吹得竖起来。", "en": "The wind lifts my feathers."},
        {"zh": "我用爪子扒了扒地面。", "en": "I rake the ground with a claw."},
        {"zh": "我仰头看了看树梢。", "en": "I look up at the treetops."},
        {"zh": "我身边还有几只。", "en": "A few of my kind are nearby."},
        {"zh": "我在等天黑，也可能不等。", "en": "I might wait for dark. Or not."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我眼里像棵树。", "en": "To me you look like a tree."},
        {"zh": "我一直盯着你。", "en": "I keep my eyes on you."},
        {"zh": "你的鞋子在响。", "en": "Your boots are noisy."},
        {"zh": "我这身羽毛很好看吧。", "en": "These feathers are fine, are they not?"},
        {"zh": "我根本不用怕你。", "en": "I need not fear you at all."},
        {"zh": "你伸手我就窜。", "en": "Reach for me and I bolt."},
        {"zh": "这附近全是我的路。", "en": "All the paths here are mine."},
        {"zh": "你站着，我绕一圈。", "en": "Stand there. I will circle once."},
        {"zh": "你手上有点亮。", "en": "Something glints on your hand."},
        {"zh": "我们离得够远了。", "en": "We are far enough apart."},
        {"zh": "你听见我的爪子吗。", "en": "Do you hear my claws?"},
        {"zh": "你别突然动起来。", "en": "Do not move suddenly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我发出一声短哨。", "en": "I let out a short whistle."},
        {"zh": "我一口气退出老远。", "en": "I put a lot of ground between us."},
        {"zh": "我一条腿在抖。", "en": "One leg is trembling."},
        {"zh": "血滴落在泥土上。", "en": "Blood drips on the soil."},
        {"zh": "我呼哧呼哧地喘。", "en": "I am wheezing hard."},
        {"zh": "我伏低到尘土里。", "en": "I flattened into the dust."},
        {"zh": "这点伤，我还跑得动。", "en": "I can still run with this."},
        {"zh": "同伴全都散了。", "en": "The others have all scattered."},
        {"zh": "你别再追上来了。", "en": "Do not chase me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那是生肉吗。", "en": "Is that raw meat in your hand?"},
        {"zh": "搁下就别再动。", "en": "Set it down and leave it."},
        {"zh": "我不吃素食的。", "en": "I do not eat plants."},
        {"zh": "你手里那块归我。", "en": "That piece is mine."},
        {"zh": "你往后退开一步。", "en": "Step back one pace."},
        {"zh": "让我凑近瞧瞧。", "en": "Let me take a closer look."},
        {"zh": "这股气味挺冲。", "en": "That smell is strong."},
        {"zh": "别举到我头顶上。", "en": "Do not hold it over my head."},
        {"zh": "我踮起脚就够到。", "en": "On tiptoe I can reach."},
        {"zh": "搁得再近一些。", "en": "Set it a little closer."},
        {"zh": "我自己过去拿。", "en": "I will take it myself."},
        {"zh": "就只这么点吗。", "en": "Only that much?"},
        {"zh": "别晃来晃去的。", "en": "Do not wave it about."},
        {"zh": "这东西还热着。", "en": "This is still warm."},
        {"zh": "给我一点就行。", "en": "A little is enough."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你顶到我腰上了。", "en": "Your knee caught me in the flank."},
        {"zh": "我后腿一撑才没倒。", "en": "My hind leg caught my fall."},
        {"zh": "我这么轻，被你撞偏了。", "en": "So light that you knocked me aside."},
        {"zh": "别挤，我要跳了。", "en": "Do not crowd me. I need to spring."},
        {"zh": "羽毛被蹭乱了几根。", "en": "A few feathers got ruffled."},
        {"zh": "别抓我的羽毛。", "en": "Do not grab my feathers."},
        {"zh": "我窜到一边去了。", "en": "I darted to one side."},
        {"zh": "你的膝盖碰到我的头了。", "en": "Your knee met my head."},
        {"zh": "四趾抓稳了地面。", "en": "All four toes found their grip."},
        {"zh": "咱们各走一边吧。", "en": "Let us each take a side."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的羽毛还不够亮。", "en": "My feathers are not bright enough yet."},
        {"zh": "这一群里有几只。", "en": "A few in this group."},
        {"zh": "先找安全的地方。", "en": "First find somewhere safe."},
        {"zh": "先让我填肚子。", "en": "Let me fill my belly first."},
        {"zh": "这个季节风很大。", "en": "The wind is strong this season."},
        {"zh": "把这段距离留着。", "en": "Keep this distance."},
        {"zh": "过了这一阵子。", "en": "Once this stretch passes."},
        {"zh": "我还要看着这片地。", "en": "I still have to watch this ground."},
        {"zh": "我得跟上同伴了。", "en": "I must catch up with the group."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有一块肉。", "en": "A piece of meat on the ground."},
        {"zh": "我用嘴叼了起来。", "en": "I pick it up in my jaws."},
        {"zh": "这一枚太小了。", "en": "This one is too small."},
        {"zh": "我把它藏进草里。", "en": "I hide it in the grass."},
        {"zh": "不是吃的，我扔掉。", "en": "Not food. I drop it."},
        {"zh": "我抓着它跑了两步。", "en": "I carry it two steps."},
        {"zh": "我用脚扒开土。", "en": "I rake the soil open."},
        {"zh": "这里还埋着东西。", "en": "Something else is buried here."},
        {"zh": "我一点一点地吃。", "en": "I eat it bit by bit."},
        {"zh": "别抢，这块是我的。", "en": "Do not snatch. This is mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "前面有点响动。", "en": "A sound ahead."},
        {"zh": "我把脖子伸出去。", "en": "I stretch my neck out."},
        {"zh": "我瞧见那影子了。", "en": "I caught that shadow."},
        {"zh": "腿已经准备跑了。", "en": "My legs are ready to run."},
        {"zh": "这里没有大石头。", "en": "There are no big rocks here."},
        {"zh": "你近得过分了。", "en": "You are far too near."},
        {"zh": "我往草丛那边退。", "en": "I back toward the grass."},
        {"zh": "我数着你还剩几步。", "en": "I count the steps you have left."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你退到土坡边。", "en": "You backed to the slope."},
        {"zh": "这地面实在太硬。", "en": "The ground is very hard."},
        {"zh": "我用不着怕你。", "en": "I have no need to fear you."},
        {"zh": "我在找个空档。", "en": "I look for an opening."},
        {"zh": "你手里的东西垂下来了。", "en": "Your hand has lowered."},
        {"zh": "我再靠近一点。", "en": "I come a little closer."},
        {"zh": "你喘得很急促。", "en": "You are breathing hard."},
        {"zh": "风向已经转了。", "en": "The wind has turned."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳起来抓你。", "en": "I leap and claw at you."},
        {"zh": "脚爪蹬在你腿上。", "en": "My foot claws kick your leg."},
        {"zh": "我跳起来咬了一口。", "en": "I sprang and snapped once."},
        {"zh": "这一咬只擦到皮。", "en": "That bite only grazed."},
        {"zh": "我咬完就撤回去。", "en": "Bite, then pull back."},
        {"zh": "你把我甩开了。", "en": "You threw me off."},
        {"zh": "我又绕到侧面。", "en": "I circle to your flank again."},
        {"zh": "你朝后躲了半尺。", "en": "You flinched back half a foot."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从蕨丛后走出来。", "en": "I step out from behind the ferns."},
        {"zh": "羽毛上还有露水。", "en": "Dew still on my feathers."},
        {"zh": "附近的蕨丛里有好几只。", "en": "Several of us live in the ferns."},
        {"zh": "我先环顾一圈。", "en": "First I look around."},
        {"zh": "地上的土很软。", "en": "The soil is soft here."},
        {"zh": "我抖了抖全身。", "en": "I shake myself all over."},
        {"zh": "我抬头看那些树。", "en": "I look up at the trees."},
        {"zh": "有东西在远处挪。", "en": "Something shifts in the distance."},
        {"zh": "我把身体缩起来。", "en": "I draw my body in."},
        {"zh": "我一步一步试探。", "en": "I test each step."},
        {"zh": "草丛动了一下。", "en": "The grass stirred."},
        {"zh": "我快步穿过去。", "en": "I dart across."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的羽毛，卷了边。", "en": "Fire curls the tips of my feathers."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去。", "en": "I tumble down the slope."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到脖子，我蹬空了。", "en": "Water at my neck and my feet kick nothing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把草全压平。", "en": "The blast flattens the grass."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭卡进我的羽根。", "en": "An arrow lodged at the root of my feather."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光把我羽毛照得透亮。", "en": "The light shines right through my feathers."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这一带没什么可吃的。", "en": "There is not much to eat here."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "闪电打在地上，草都黑了。", "en": "Lightning blackens the grass."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面什么也没有。", "en": "There is nothing below."}
      ]
    }
  }
}
