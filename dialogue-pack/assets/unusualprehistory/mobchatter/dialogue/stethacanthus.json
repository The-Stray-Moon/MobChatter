{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咔嚓咔嚓，我的铁砧在敲击着水波。", "en": "Clack clack, my anvil taps the waves."},
        {"zh": "游啊游，别打扰我的铁砧梦。", "en": "Swim, swim, don't disturb my anvil dreams."},
        {"zh": "注意了，我的铁砧是利器。", "en": "Watch out, my anvil is sharp."},
        {"zh": "在铁砧的陪伴下，我更有力。", "en": "With my anvil by my side, I'm stronger."},
        {"zh": "这水草不错，可以做我的午餐。", "en": "Nice seaweed, good for lunch."},
        {"zh": "我用我的铁砧来敲打水面。", "en": "I tap the surface with my anvil."},
        {"zh": "我的铁砧可以帮我对抗敌人。", "en": "My anvil helps me fight enemies."},
        {"zh": "铁砧声是我存在的证明。", "en": "The anvil is my presence."},
        {"zh": "我的铁砧和鲨鱼尾共同作用。", "en": "My anvil works with my shark tail."},
        {"zh": "小心，我的铁砧比你想象的厉害。", "en": "Beware, my anvil is stronger than it looks."},
        {"zh": "贴着水草边缘游", "en": "I cruise along the edge of the weeds."},
        {"zh": "铁砧头划开一道水纹", "en": "My anvil head cuts a wake."},
        {"zh": "绕缸一圈，慢慢巡", "en": "One lap of the tank, slow and steady."},
        {"zh": "在石缝间钻来钻去", "en": "I weave in and out of the rock gaps."},
        {"zh": "尾巴一摆就转过弯", "en": "One tail flick and I round the bend."},
        {"zh": "浮到水面换口气", "en": "I rise to the surface for a breath."},
        {"zh": "低头啄食水底的碎屑", "en": "I dip down to peck at scraps on the bottom."},
        {"zh": "顺着水流滑一段", "en": "I glide a stretch with the current."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静地，我的铁砧敲击着。", "en": "Silently, my anvil taps."},
        {"zh": "我的铁砧，我的骄傲。", "en": "My anvil, my pride."},
        {"zh": "看着我，但我没在攻击。", "en": "Look at me, but I'm not attacking."},
        {"zh": "我的铁砧让我更加凶猛。", "en": "My anvil makes me fiercer."},
        {"zh": "我的铁砧是守护者的象征。", "en": "My anvil is a guardian symbol."},
        {"zh": "我的铁砧在等待机会。", "en": "My anvil waits for an opportunity."},
        {"zh": "我的铁砧永远不会生锈。", "en": "My anvil will never rust."},
        {"zh": "铁砧和我的身躯紧密相连。", "en": "The anvil is my body."},
        {"zh": "我的铁砧是我战斗的武器。", "en": "My anvil is my weapon."},
        {"zh": "我的铁砧赋予我力量。", "en": "My anvil gives me strength."},
        {"zh": "悬在水草中间不动", "en": "I hang still among the water weeds."},
        {"zh": "铁砧头上落了点泥", "en": "A fleck of mud sits on my anvil head."},
        {"zh": "鳃一张一合，慢慢来", "en": "My gills open and close, slow and easy."},
        {"zh": "半眯着眼看水波", "en": "I half close my eyes at the ripples."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你动了，我的警惕性提高。", "en": "You move, my alertness rises."},
        {"zh": "玩家在注视我，我警惕。", "en": "The player looks at me, I'm alert."},
        {"zh": "我的铁砧准备好了战斗。", "en": "My anvil is ready for battle."},
        {"zh": "注意我，但我没攻击你。", "en": "Notice me, but I'm not attacking you."},
        {"zh": "观察我，但我没威胁。", "en": "Observe me, I'm not threatening."},
        {"zh": "我的铁砧时刻准备着。", "en": "My anvil is always ready."},
        {"zh": "我的铁砧注视着你。", "en": "My anvil watches you."},
        {"zh": "不要靠近，我的铁砧危险。", "en": "Don't approach, my anvil is dangerous."},
        {"zh": "我的铁砧准备战斗。", "en": "My anvil prepares for battle."},
        {"zh": "我的铁砧在寻找机会。", "en": "My anvil looks for opportunities."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶～我的铁砧坏了……", "en": "Sigh, my anvil is broken..."},
        {"zh": "啊！我的鳍受伤了！", "en": "Ow! My fins are hurt!"},
        {"zh": "我的盔甲裂开了……", "en": "My armor is cracked..."},
        {"zh": "咕噜～我的桶不够了……", "en": "Rumble, I need more buckets..."},
        {"zh": "嘶～这条伤口很难愈合……", "en": "Sigh, this wound is hard to heal..."},
        {"zh": "咕噜～我的水草不够吃……", "en": "Rumble, I need more seaweed..."},
        {"zh": "嘶～我需要休息一下……", "en": "Sigh, I need a rest..."},
        {"zh": "咕噜～我的身体很虚弱……", "en": "Rumble, I'm very weak..."},
        {"zh": "嘶～我需要更丰富的食物……", "en": "Sigh, I need better food..."},
        {"zh": "嘶～我太累了……", "en": "Sigh, I'm too tired..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "看这美味的桶，尝一口吧！", "en": "Taste this delicious bucket!"},
        {"zh": "水草丰富的地方，才会有我！", "en": "I thrive where water plants are plentiful."},
        {"zh": "我的铁砧头，可以砸碎你的梦想！", "en": "My hammerhead smashes your dreams!"},
        {"zh": "想要饱腹感？来尝尝我吧！", "en": "Want fullness? Try me!"},
        {"zh": "跟我走，会有更多美食！", "en": "Follow me, more food ahead!"},
        {"zh": "我头上这块铁砧，是我的招牌。", "en": "This anvil on my head is my trademark."},
        {"zh": "别用桶装我，我要游！", "en": "Don't bucket me, I wanna swim!"},
        {"zh": "我的肉，比鱼缸里任何东西都好！", "en": "My meat is better than anything in the tank!"},
        {"zh": "不要碰我，我会咬你！", "en": "Stay away, or I'll bite you!"},
        {"zh": "和我一起游，享受美食吧！", "en": "Swim with me, enjoy the feast!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "铁砧似的头，撞着也疼。", "en": "Even an anvil head feels that."},
        {"zh": "我的锤头，不是用来玩耍的！", "en": "My hammerhead isn't for play!"},
        {"zh": "小心我的攻击，很疼！", "en": "Watch out for my attack, it hurts!"},
        {"zh": "碰撞只会让我的铁砧更锋利！", "en": "Collisions make my hammer sharper!"},
        {"zh": "我们不会一起游泳的！", "en": "We don't swim together!"},
        {"zh": "我的身体，不适合被撞！", "en": "My body isn't for collisions!"},
        {"zh": "你的膝盖磕上我的背鳍。", "en": "Your knee knocks against my dorsal fin."},
        {"zh": "别来碰我，我会反击！", "en": "Don't touch me, I'll retaliate!"},
        {"zh": "我的速度，不是开玩笑的！", "en": "My speed isn't for fun!"},
        {"zh": "碰撞只会让我的战斗更激烈！", "en": "Collisions make my battles fiercer!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找我当伴侣，你找对了！", "en": "Find me a mate, you got it!"},
        {"zh": "我们是水中的伴侣！", "en": "We are aquatic partners!"},
        {"zh": "我的伴侣，要足够聪明！", "en": "My mate must be smart!"},
        {"zh": "找个聪明的鱼来作伴！", "en": "Find a smart fish for a mate!"},
        {"zh": "我的伴侣，要能理解我！", "en": "My mate must understand me!"},
        {"zh": "我需要一个懂得分享的伴侣！", "en": "I need a mate who shares!"},
        {"zh": "一起生活，共享美食！", "en": "Live together, share the feast!"},
        {"zh": "我的伴侣，要和我一样聪明！", "en": "My mate must be as smart as me!"},
        {"zh": "找个会说话的鱼，作为伴侣！", "en": "Find a talking fish for a mate!"},
        {"zh": "和我一起，享受水中生活！", "en": "Enjoy life in water with me!"}
      ]
    },
    "pickup": {
