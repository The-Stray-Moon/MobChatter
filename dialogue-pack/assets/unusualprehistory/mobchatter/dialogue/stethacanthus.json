        {"zh": "桶里见，我的家！", "en": "Bucket's home, see you there!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "找到你了，桶中囚徒！", "en": "Found you, bucket prisoner!"},
        {"zh": "别跑，我来了。", "en": "Don't run, I'm coming."},
        {"zh": "铁砧头在追踪你。", "en": "Anvil head is tracking you."},
        {"zh": "水里追不上我吗？", "en": "Can't catch me in water?"},
