{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我摇摇晃晃地往前挪", "en": "I wobble forward on unsteady legs."},
        {"zh": "我贴着地面慢慢爬", "en": "I crawl low along the ground."},
        {"zh": "我的爪子抓着土走", "en": "My claws dig in as I go."},
        {"zh": "我一步一步跟着你", "en": "I keep step with you, step by step."},
        {"zh": "我从你的腿边蹭过去", "en": "I brush past your leg."},
        {"zh": "我拖着圆肚子走", "en": "I waddle with my round belly."},
        {"zh": "我绕着树根转半圈", "en": "I circle half around the roots."},
        {"zh": "我从草丛里挤出个头", "en": "I push my head out of the grass."},
        {"zh": "我慢慢挪到有光处", "en": "I shuffle into the light."},
        {"zh": "我走过一片松土", "en": "I cross a patch of soft soil."},
        {"zh": "我又回头看你一眼", "en": "I look back at you once."},
        {"zh": "我爬过一根倒木", "en": "I clamber over a fallen log."},
        {"zh": "我的脚掌踩出小坑", "en": "My paws leave small prints."},
        {"zh": "我沿着你的影子走", "en": "I walk along your shadow."},
        {"zh": "我挪到你脚边停下", "en": "I move to your feet and stop."},
        {"zh": "我慢慢地转到另一边", "en": "I work my way around to the other side."},
        {"zh": "我又往前挪了一小段", "en": "I shuffle on a little further."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在你脚边", "en": "I crouch at your feet."},
        {"zh": "我把鼻子贴在地上", "en": "I press my nose to the ground."},
        {"zh": "我抬头望着你", "en": "I look up at you."},
        {"zh": "我一动不动地趴着", "en": "I lie without moving."},
        {"zh": "我嗅着空气里的味道", "en": "I sniff at the air."},
        {"zh": "我慢慢眨了眨眼", "en": "I blink slowly."},
        {"zh": "我的小爪子动了动", "en": "My little claws flex."},
        {"zh": "我贴着地面睡了一会儿", "en": "I doze against the ground."},
        {"zh": "我又把头抬起来", "en": "I lift my head again."},
        {"zh": "我在等你伸手", "en": "I wait for your hand."},
        {"zh": "我把身体团成一团", "en": "I tuck myself into a ball."},
        {"zh": "我慢慢晃了晃脑袋", "en": "I sway my head slowly."},
        {"zh": "我把身上的土抖下来", "en": "I shake the dirt off me."},
        {"zh": "我靠着你的腿歇着", "en": "I rest against your leg."},
        {"zh": "我没有要走的意思", "en": "I have no wish to leave."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头看你", "en": "I raise my head to you."},
        {"zh": "我歪着头打量你", "en": "I tilt my head and study you."},
        {"zh": "你比我想的高很多", "en": "You are much taller than I."},
        {"zh": "我慢慢往前挪半步", "en": "I shift forward half a pace."},
        {"zh": "我伸鼻子闻你的手", "en": "I stretch my nose to your hand."},
        {"zh": "你的手上有土味", "en": "Your hands smell of earth."},
        {"zh": "我把爪子搭在你鞋上", "en": "I rest a paw on your boot."},
        {"zh": "我又抬头看你", "en": "I look up at you again."},
        {"zh": "我不太害怕你", "en": "I am not very afraid of you."},
        {"zh": "我想爬到你身上", "en": "I want to climb onto you."},
        {"zh": "我小声叫了一下", "en": "I make a small sound."},
        {"zh": "我盯着你的口袋", "en": "I stare at your pocket."},
        {"zh": "你蹲下来我就往前凑", "en": "When you crouch, I come closer."},
        {"zh": "我把下巴搁在你膝上", "en": "I rest my chin on your knee."},
        {"zh": "我蹭了蹭你的手臂", "en": "I rub against your arm."},
        {"zh": "我等你把手放低", "en": "I wait for you to lower your hand."},
        {"zh": "我慢慢绕着你走了半圈", "en": "I circle half around you, slowly."},
        {"zh": "我又回到你面前", "en": "I come back in front of you."},
        {"zh": "我想跟着你走", "en": "I want to come along with you."},
        {"zh": "我一直看着你", "en": "I keep watching you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我疼得缩成一团", "en": "Pain curls me up."},
        {"zh": "我往你脚边躲", "en": "I hide at your feet."},
        {"zh": "我疼得叫了一声", "en": "I make a cry."},
        {"zh": "我慢慢翻过身", "en": "I slowly roll upright."},
        {"zh": "我抖着腿站着", "en": "My legs tremble as I stand."},
        {"zh": "我低着头舔伤口", "en": "I lick the wound, head low."},
        {"zh": "我还没有走开", "en": "I have not gone away."},
        {"zh": "我蹭着你的腿", "en": "I press against your leg."},
        {"zh": "我又抬起头看你", "en": "I look up at you again."},
        {"zh": "我慢慢缓过来", "en": "I slowly recover."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那个是吃的吗", "en": "Is that something to eat?"},
        {"zh": "我朝那味道爬过去", "en": "I crawl toward that smell."},
        {"zh": "我伸长脖子去闻", "en": "I stretch my neck to sniff."},
        {"zh": "我张开嘴试了一口", "en": "I open my mouth and try a bite."},
        {"zh": "这个很软很好吃", "en": "This is soft and tastes good."},
        {"zh": "我又要了一口", "en": "I ask for another bite."},
        {"zh": "我抱着它不放", "en": "I hug it and will not let go."},
        {"zh": "我把它塞进嘴里", "en": "I stuff it into my mouth."},
        {"zh": "我还想再吃一点", "en": "I want more."},
        {"zh": "我舔了舔鼻子", "en": "I lick my nose."},
        {"zh": "我抬头看着你的手", "en": "I look up at your hand."},
        {"zh": "我跟着你走了两步", "en": "I follow you two steps."},
        {"zh": "这个味道我喜欢", "en": "I like this smell."},
        {"zh": "我一口一口地嚼", "en": "I chew it bite by bite."},
        {"zh": "我吃饱了还想吃", "en": "Even full, I want more."},
        {"zh": "我蹭你的手讨要", "en": "I nudge your hand for more."},
        {"zh": "我把它按在爪下", "en": "I pin it under a paw."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我，我滚了半圈", "en": "You bump me and I roll half over."},
        {"zh": "我慢慢翻回来", "en": "I slowly roll back up."},
        {"zh": "我被撞得晃了晃", "en": "The bump makes me sway."},
        {"zh": "我缩起身体护住头", "en": "I curl up and guard my head."},
        {"zh": "我往你的腿边靠", "en": "I press against your leg."},
        {"zh": "我抓了抓地面稳住", "en": "I grip the ground to steady."},
        {"zh": "我又慢慢站起来", "en": "I get up again slowly."},
        {"zh": "我又抖了抖身子", "en": "I shake myself again."},
        {"zh": "我低声叫了一下", "en": "I make a low sound."},
        {"zh": "我跟着你继续走", "en": "I keep walking with you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只小崽爬过来了", "en": "Another pup crawls over."},
        {"zh": "我们鼻子碰鼻子", "en": "Our noses touch."},
        {"zh": "它比我小一点", "en": "It is a little smaller than I."},
        {"zh": "我们一起在土里翻找", "en": "We root through the soil together."},
        {"zh": "它靠着我的身侧", "en": "It leans against my flank."},
        {"zh": "我们一起蹭着你的腿", "en": "We both rub against your leg."},
        {"zh": "它先往前爬了", "en": "It crawls ahead first."},
        {"zh": "我慢慢跟在后面", "en": "I follow slowly."},
        {"zh": "我们一起趴下歇着", "en": "We lie down to rest together."},
        {"zh": "它叫了一声我应了", "en": "It calls and I answer."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抓起一小块东西", "en": "I pick up a small thing."},
        {"zh": "我塞进嘴里嚼", "en": "I put it in my mouth to chew."},
        {"zh": "我抱在怀里不放", "en": "I hold it to my chest."},
        {"zh": "我又把它放下了", "en": "I set it back down."},
        {"zh": "我抬头看了看你", "en": "I glance up at you."},
        {"zh": "我又低头去捡", "en": "I look down for more."},
        {"zh": "我把它按在地上", "en": "I press it to the ground."},
        {"zh": "我舔了舔爪子", "en": "I lick my paw."},
        {"zh": "我蹭了蹭嘴角", "en": "I rub my mouth."},
        {"zh": "我慢慢挪开了", "en": "I move slowly away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头停住", "en": "I raise my head and stop."},
        {"zh": "我把身体往你身后挪", "en": "I shift behind you."},
        {"zh": "我鼻子抽了抽", "en": "My nose twitches."},
        {"zh": "我盯着那个方向", "en": "I stare that way."},
        {"zh": "我忍不住低叫了声", "en": "I cannot help a low cry."},
        {"zh": "我往你脚边挤", "en": "I press close to your feet."},
        {"zh": "我缩到妈妈的长爪后面。", "en": "I shrink behind my mother's long claws."},
        {"zh": "我不太敢动弹", "en": "I hardly dare move."},
        {"zh": "我又往你这边看了", "en": "I look your way again."},
        {"zh": "我在等你带我走", "en": "I am waiting for you to take me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直贴着你的腿", "en": "I stay pressed to your leg."},
        {"zh": "我盯着那边不出声", "en": "I watch that way in silence."},
        {"zh": "它还没有走近", "en": "It has not come near."},
        {"zh": "我把身体压低", "en": "I flatten myself low."},
        {"zh": "我又往你身后躲了躲", "en": "I hide a little further behind you."},
        {"zh": "我在等它走开", "en": "I wait for it to leave."},
        {"zh": "我慢慢往后挪", "en": "I shift backward slowly."},
        {"zh": "我抓着地面不动", "en": "I grip the ground and hold."},
        {"zh": "它把头转过来了", "en": "It has turned its head."},
        {"zh": "我还在你脚边", "en": "I am still at your feet."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸爪子拍了一下", "en": "I swat with a paw."},
        {"zh": "我张嘴咬了一下", "en": "I snap once."},
        {"zh": "我被吓得扑过去", "en": "Fright makes me lunge."},
        {"zh": "我咬住了不松口", "en": "I clamp on and hold."},
        {"zh": "我又用头顶了一下", "en": "I butt with my head."},
        {"zh": "我抓完就躲到你后面", "en": "I strike, then hide behind you."},
        {"zh": "我这一下没什么力气", "en": "That had little force."},
        {"zh": "我挥了一下小爪子。", "en": "I swing one small claw."},
        {"zh": "我还想再扑一下", "en": "I want to lunge again."},
        {"zh": "我慢慢缩回你的脚边", "en": "I shrink back to your feet."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土里钻出来", "en": "I push up out of the soil."},
        {"zh": "我身上还带着湿土", "en": "Wet soil still clings to me."},
        {"zh": "我先看了一圈", "en": "First I look around."},
        {"zh": "我摇摇晃晃地站住", "en": "I stagger and plant myself."},
        {"zh": "我朝你那边看", "en": "I look your way."},
        {"zh": "我又低头嗅了嗅", "en": "I sniff the ground."},
        {"zh": "我慢慢抬起头", "en": "I raise my head slowly."},
        {"zh": "我一步一晃地走近", "en": "I wobble nearer."},
        {"zh": "我找到你的脚边", "en": "I find my way to your feet."},
        {"zh": "我发出一点小声音", "en": "I make a small sound."},
        {"zh": "我蹭了蹭你的腿", "en": "I rub against your leg."},
        {"zh": "我就在这儿待着", "en": "I will stay here."},
        {"zh": "我又往你的影子挪", "en": "I shift into your shadow."},
        {"zh": "我开始一步一步跟着你", "en": "I start following you step by step."}
      ]
    },
