{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我晃着身子往前走。", "en": "I waddle forward."},
        {"zh": "我一路拱着泥土。", "en": "I root through the dirt as I go."},
        {"zh": "四只蹄子陷进泥里。", "en": "Four hooves sink into mud."},
        {"zh": "我走得很散漫，学得像。", "en": "I wander aimlessly, convincingly."},
        {"zh": "我的尾巴卷成了圈。", "en": "My tail curls into a loop."},
        {"zh": "我绕过一堆干草。", "en": "I skirt a pile of hay."},
        {"zh": "我一边走一边拱土。", "en": "I root through the dirt as I go."},
        {"zh": "我每一步都踩在旧蹄印里。", "en": "I step inside old hoofprints."},
        {"zh": "泥水溅到我的肚皮。", "en": "Mud splashes my belly."},
        {"zh": "我朝猪圈的方向挪。", "en": "I shuffle toward the pen."},
        {"zh": "我停在食槽旁边。", "en": "I stop by the trough."},
        {"zh": "我踩过的地方都是坑。", "en": "I leave pits where I step."},
        {"zh": "我甩了甩耳朵上的泥。", "en": "I shake mud off my ears."},
        {"zh": "猪群没发现少了谁。", "en": "The pigs haven't missed anyone."},
        {"zh": "我慢慢跟着一头母猪。", "en": "I trail a sow slowly."},
        {"zh": "我假装笨拙地走过去。", "en": "I pass by feigning clumsiness."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把鼻子贴在地上。", "en": "I press my snout to the ground."},
        {"zh": "我站得有点太直了。", "en": "I'm standing a little too upright."},
        {"zh": "我在泥里打了个滚。", "en": "I roll once in the mud."},
        {"zh": "我的皮上全是泥。", "en": "My hide is caked in mud."},
        {"zh": "真正的猪在我旁边哼哼。", "en": "A real pig grunts beside me."},
        {"zh": "我学着哼了两声。", "en": "I grunt twice, imitating."},
        {"zh": "我在数围栏的木桩。", "en": "I count the fence posts."},
        {"zh": "食槽里还有半槽。", "en": "The trough is half full."},
        {"zh": "我抬起鼻子嗅风。", "en": "I lift my snout to the wind."},
        {"zh": "泥水很凉。", "en": "The mud water is cool."},
        {"zh": "我在等喂食的时间。", "en": "I wait for feeding time."},
        {"zh": "我的眼睛藏在皮褶里。", "en": "My eyes hide in the folds of hide."},
        {"zh": "我学着猪哼，学得挺像。", "en": "I oink like a pig; convincing, no?"},
        {"zh": "粪味盖住了我自己的味。", "en": "The stench covers my own smell."},
        {"zh": "我嚼了嚼干草。", "en": "I chew on hay."},
        {"zh": "这身皮不透气。", "en": "This hide doesn't breathe."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是来喂猪的？", "en": "Have you come to feed the pigs?"},
        {"zh": "食槽在那边。", "en": "The trough is over there."},
        {"zh": "你手里的桶很香。", "en": "That bucket smells good."},
        {"zh": "我只是一头猪。", "en": "I'm only a pig."},
        {"zh": "你瞅我干啥？", "en": "What are you eyeing me for?"},
        {"zh": "我背上的泥是新的。", "en": "The mud on my back is fresh."},
        {"zh": "你踩到猪粪了。", "en": "You stepped in pig muck."},
        {"zh": "我哼哼给你听。", "en": "I'll grunt for you."},
        {"zh": "我的蹄子下，藏着别的。", "en": "Something else hides beneath these hooves."},
        {"zh": "围栏那边会更热闹。", "en": "It's livelier by the fence."},
        {"zh": "我认得出你的鞋。", "en": "I recognize your boots."},
        {"zh": "你今天来晚了。", "en": "You're late today."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "皮上破了个口。", "en": "There's a tear in the hide."},
        {"zh": "我哼哼着躲开。", "en": "I grunt and shy away."},
        {"zh": "别扯我的皮。", "en": "Don't pull my hide."},
        {"zh": "我退到泥里去了。", "en": "I retreat into the mud."},
        {"zh": "底下的东西在动。", "en": "Something moves underneath."},
        {"zh": "这点伤，猪也不在乎。", "en": "Not even a pig would mind this."},
        {"zh": "我低着头护住肚子。", "en": "I lower my head to shield my belly."},
        {"zh": "猪群惊了一下。", "en": "The herd startles."},
        {"zh": "我得走开。", "en": "I need to get away."},
        {"zh": "你手劲真大。", "en": "You hit hard."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "胡萝卜？给我。", "en": "Carrots? Give them here."},
        {"zh": "我闻到土豆了。", "en": "I smell potatoes."},
        {"zh": "倒进食槽里。", "en": "Pour it in the trough."},
        {"zh": "猪鼻子已经拱到你掌心。", "en": "My pig snout is already nuzzling your palm."},
        {"zh": "我连你的手指都想尝。", "en": "I'd taste your fingers too."},
        {"zh": "这味道太香了。", "en": "This smells far too good."},
        {"zh": "我刚才还在装。", "en": "I was still pretending a moment ago."},
        {"zh": "你手一低，我就拱上去。", "en": "Lower your hand and I shove right in."},
        {"zh": "我拱得动那个桶。", "en": "I could tip that bucket over."},
        {"zh": "土豆的泥味我认得。", "en": "I know the earthy smell of potatoes."},
        {"zh": "这比泥里的根好吃。", "en": "Better than roots in the mud."},
        {"zh": "你真是个好心人。", "en": "Aren't you generous."},
        {"zh": "我吃相不好看吧？", "en": "My manners are ugly, aren't they?"},
        {"zh": "我想把整个桶叼走。", "en": "I want to carry off the whole bucket."},
        {"zh": "这味道让我忘了伪装。", "en": "This scent makes me forget to act."},
        {"zh": "你身上也有这味道。", "en": "You smell of it too."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的皮。", "en": "You bumped my hide."},
        {"zh": "我哼哼着退开。", "en": "I grunt and back away."},
        {"zh": "别踩我的尾。", "en": "Don't tread on my tail."},
        {"zh": "你鞋上沾了泥。", "en": "Mud's on your boot now."},
        {"zh": "我身子一歪，又站直。", "en": "I sway and straighten up."},
        {"zh": "这点碰撞猪不在乎。", "en": "A pig wouldn't care about that."},
        {"zh": "你差点把我撞翻。", "en": "You nearly knocked me over."},
        {"zh": "皮下滑了一下。", "en": "The hide slipped a little."},
        {"zh": "让开，我要去食槽。", "en": "Move, I'm headed to the trough."},
        {"zh": "你退开一步就好。", "en": "Just one step back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是头猪。", "en": "I'm just a pig."},
        {"zh": "那群里的更适合。", "en": "The one in the pen is better suited."},
        {"zh": "我还没吃饱。", "en": "I'm not full yet."},
        {"zh": "这种事在泥里做。", "en": "Such things happen in the mud."},
        {"zh": "我的皮会掉下来。", "en": "My hide would fall off."},
        {"zh": "你手别摸我耳朵。", "en": "Don't touch my ear."},
        {"zh": "我等喂食。", "en": "I'm waiting to be fed."},
        {"zh": "别打扰我拱地。", "en": "Don't interrupt my rooting."},
        {"zh": "我拱着鼻子，其实在看你。", "en": "I root with my snout — but I'm watching."},
        {"zh": "我去那边躺着。", "en": "I'll go lie down over there."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一颗土豆，掉了。", "en": "A potato, dropped."},
        {"zh": "我一口就叼走了。", "en": "I snap it up in one bite."},
        {"zh": "地上的都能吃。", "en": "Anything on the ground is food."},
        {"zh": "我拱开土看下面。", "en": "I root the soil to see underneath."},
        {"zh": "这颗土豆，我留着当晚饭。", "en": "I keep this potato for supper."},
        {"zh": "我用鼻子把土豆埋了。", "en": "I bury the potato with my snout."},
        {"zh": "有别人看见吗？", "en": "Did anyone see?"},
        {"zh": "我叼着它躲到栏边。", "en": "I carry it to the fence."},
        {"zh": "这味道像烂菜。", "en": "Smells of rotten greens."},
        {"zh": "慢慢嚼，不着急。", "en": "Chew slowly, no rush."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我的食槽前。", "en": "You're standing at my trough."},
        {"zh": "食槽边的影子多了一个。", "en": "One more shadow at the trough."},
        {"zh": "我抬起头，不太像猪。", "en": "I raise my head, not quite pig-like."},
        {"zh": "我朝你的腿冲过来。", "en": "I charge at your legs."},
        {"zh": "你横在我的路上。", "en": "You're across my path."},
        {"zh": "猪群不会管这个。", "en": "The herd won't interfere."},
        {"zh": "你身上有食物的味。", "en": "You smell of food."},
        {"zh": "我跳一下就到了。", "en": "One leap and I'm there."},
        {"zh": "别以为我只会哼哼。", "en": "Don't think I only grunt."},
        {"zh": "退后了，鼻子倒是灵。", "en": "You backed off — good nose on you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我低着头，鼻子朝下。", "en": "Head low, snout down."},
        {"zh": "我等你转过去。", "en": "I wait for you to turn."},
        {"zh": "前蹄刨了两下土。", "en": "My forehooves scrape twice."},
        {"zh": "泥地上没有声音。", "en": "Mud makes no sound."},
        {"zh": "我和围栏的影子叠在一起。", "en": "I merge with the fence's shadow."},
        {"zh": "围栏边的泥被蹄踩实。", "en": "Hooves pack the mud by the fence."},
        {"zh": "这身皮还有点用。", "en": "This hide still serves."},
        {"zh": "我默默数你的步。", "en": "I silently count your steps."},
        {"zh": "你的桶放在地上了。", "en": "You set the bucket down."},
        {"zh": "就是如今。", "en": "Right now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用脑袋撞你。", "en": "I butt you with my head."},
        {"zh": "我扑得比猪快。", "en": "I lunge faster than a pig."},
        {"zh": "牙齿咬住了你的裤脚。", "en": "My teeth catch your trouser leg."},
        {"zh": "你被撞进了泥里。", "en": "You're knocked into the mud."},
        {"zh": "这一下不像猪的力气。", "en": "That was no pig's strength."},
        {"zh": "皮从我肩上滑开。", "en": "The hide slips off my shoulder."},
        {"zh": "我的前蹄刨开了你脚边土。", "en": "My forehoof paws open the soil at your feet."},
        {"zh": "猪嘴咬穿了你的护腿。", "en": "My pig jaws bite through your leggings."},
        {"zh": "我退到食槽边。", "en": "I retreat to the trough."},
        {"zh": "别再靠过来。", "en": "Don't come closer."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "猪圈里多了一头。", "en": "One more in the pen."},
        {"zh": "我从草堆后走出来。", "en": "I come out from behind the hay."},
        {"zh": "我先在泥里滚了一圈。", "en": "I roll once in the mud first."},
        {"zh": "没人清点过数目。", "en": "No one has counted us."},
        {"zh": "我和猪一起哼哼。", "en": "I grunt along with the pigs."},
        {"zh": "围栏的木桩有点松。", "en": "The fence posts are loose."},
        {"zh": "我选了最里面的位置。", "en": "I take the innermost spot."},
        {"zh": "干草盖住了我的背。", "en": "Hay covers my back."},
        {"zh": "这里的气味很浓。", "en": "The smell here is thick."},
        {"zh": "我慢慢趴下来。", "en": "I slowly settle down."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "皮一烧就卷起来了。", "en": "The hide curls as it burns."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从栏上摔下，四蹄朝天。", "en": "I fall from the fence, hooves up."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "泥水灌进鼻子，很呛。", "en": "Muddy water fills my snout, choking."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把干草全掀了。", "en": "The blast scatters the hay."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西扎进皮里。", "en": "That buried itself in the hide."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力一过，皮下发烫。", "en": "Magic passes, and my hide burns beneath."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得连猪都不像了。", "en": "Too hungry to pass for a pig."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击下来，我腿一软。", "en": "Lightning hits, my legs give."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有泥可滚。", "en": "No mud to roll in, in the void."}
      ]
    }
  }
}
