{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "八条腿踩得很轻。", "en": "Eight legs step very lightly."},
        {"zh": "我贴着墙根往外爬。", "en": "I crawl out along the wall's base."},
        {"zh": "这身蜘蛛皮很合身。", "en": "This spider skin fits well."},
        {"zh": "我的身子低得快贴地。", "en": "My body rides almost on the floor."},
        {"zh": "我从你影子里走过去。", "en": "I pass through your shadow."},
        {"zh": "丝拖在身后，很细。", "en": "A fine thread trails behind."},
        {"zh": "我慢慢挪向你的脚。", "en": "I edge toward your foot."},
        {"zh": "我的关节一屈一伸。", "en": "My joints flex and extend."},
        {"zh": "我绕开地上的碎石。", "en": "I skirt the gravel on the ground."},
        {"zh": "每一步都落在砖缝上。", "en": "Each step lands in a seam."},
        {"zh": "我爬上木梁，倒挂着走。", "en": "I climb the beam and walk inverted."},
        {"zh": "八只眼同时看着路。", "en": "Eight eyes watch the way."},
        {"zh": "我在草丛里留了一道痕。", "en": "I leave a track in the grass."},
        {"zh": "我的毛蹭过石面。", "en": "My bristles scrape the stone."},
        {"zh": "我停下来，调整方向。", "en": "I pause and correct my line."},
        {"zh": "我从门缝下面钻。", "en": "I slip under the door gap."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "八条腿贴住砖缝。", "en": "Eight legs press flat into the brick seams."},
        {"zh": "我的八只眼都朝外。", "en": "All eight of my eyes face out."},
        {"zh": "我在墙角的网边等着。", "en": "I wait by the web in the corner."},
        {"zh": "我的前足轻轻敲了敲。", "en": "I tap with my front legs."},
        {"zh": "丝从我的腹部抽出来。", "en": "Silk draws from my abdomen."},
        {"zh": "我数着墙上的裂缝。", "en": "I count the cracks in the wall."},
        {"zh": "真蜘蛛从我旁边过去。", "en": "A real spider passes me."},
        {"zh": "我的毛竖了一下。", "en": "My bristles rise once."},
        {"zh": "这里的光线很暗。", "en": "The light here is dim."},
        {"zh": "我把身体压低，像块石头。", "en": "I flatten like a stone."},
        {"zh": "我在等有东西落进网。", "en": "I wait for something to hit the web."},
        {"zh": "我的皮有点松。", "en": "This skin is a bit loose."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你低头，看到我了。", "en": "You look down and see me."},
        {"zh": "别用手扑打。", "en": "Don't swat with your hand."},
        {"zh": "我在这儿很久了。", "en": "I've been here a while."},
        {"zh": "你的脚别再挪。", "en": "Don't move your foot."},
        {"zh": "八只眼看得清你。", "en": "Eight eyes see you clearly."},
        {"zh": "你身上有虫的气味。", "en": "You smell of insects."},
        {"zh": "这墙角是我的。", "en": "This corner is mine."},
        {"zh": "你的火把照出我八只眼。", "en": "Your torch shows all eight of my eyes."},
        {"zh": "我把头缓缓抬起。", "en": "I raise my head slowly."},
        {"zh": "你踩到了我的丝。", "en": "You stepped on my silk."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "八条腿里折了两条。", "en": "Two of my eight legs are broken."},
        {"zh": "皮被踩破了。", "en": "The skin is crushed."},
        {"zh": "我蜷成一团。", "en": "I curl into a ball."},
        {"zh": "别踩碎我。", "en": "Don't crush me."},
        {"zh": "扮成蜘蛛，还是爬不稳墙。", "en": "Dressed as a spider, and I still slip on walls."},
        {"zh": "这点伤我就退。", "en": "At this wound I retreat."},
        {"zh": "我的丝断了一截。", "en": "A length of my silk snapped."},
        {"zh": "皮毛下有东西动。", "en": "Something moves under the pelt."},
        {"zh": "我八只眼都花了。", "en": "All eight eyes swim."},
        {"zh": "我要钻回缝里。", "en": "I need to get back into the seam."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是虫子吗？", "en": "Is that a bug?"},
        {"zh": "动的东西我就看。", "en": "Movement always catches me."},
        {"zh": "这东西在动。", "en": "That thing is moving."},
        {"zh": "我不吃面包。", "en": "I don't eat bread."},
        {"zh": "拿近些，我看看。", "en": "Bring it closer, let me see."},
        {"zh": "你手别抖那么厉害。", "en": "Don't shake so much."},
        {"zh": "这点不够塞牙缝。", "en": "Not enough to fill a fang."},
        {"zh": "八条腿，扮得很像。", "en": "Eight legs, quite a convincing look."},
        {"zh": "我装成蜘蛛，可味道不对。", "en": "I look like a spider, but the smell is off."},
        {"zh": "掉下来我就要了。", "en": "If you drop it, it's mine."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的关节被踩得咔一声。", "en": "My joint cracks under your boot."},
        {"zh": "我立刻弹开了。", "en": "I spring away at once."},
        {"zh": "我学蜘蛛爬，其实不是。", "en": "I crawl like a spider, though I am not one."},
        {"zh": "你的鞋底压扁了一节。", "en": "Your sole flattened one joint."},
        {"zh": "我贴着地面退开。", "en": "I slide back along the floor."},
        {"zh": "你碰到了我的丝。", "en": "You touched my silk."},
        {"zh": "我翻身又爬正了。", "en": "I flip over and right myself."},
        {"zh": "这点碰撞我就缩起腿。", "en": "At that bump I draw my legs in."},
        {"zh": "你退开，我就走。", "en": "Back off and I'll go."},
        {"zh": "我八条腿都绷紧了。", "en": "All eight legs are tense."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是披着这张皮。", "en": "I only wear this skin."},
        {"zh": "真蜘蛛在网那边。", "en": "A real spider is by the web."},
        {"zh": "我还没织好网。", "en": "I haven't finished my web."},
        {"zh": "这种事要在暗处。", "en": "Such things are done in the dark."},
        {"zh": "别碰我的腹部。", "en": "Don't touch my abdomen."},
        {"zh": "我很忙。", "en": "I'm busy."},
        {"zh": "你找不到合适的角度。", "en": "You won't find the right angle."},
        {"zh": "墙角那张网，不是我织的。", "en": "That web in the corner isn't mine."},
        {"zh": "这张皮不是我的。", "en": "This skin isn't mine."},
        {"zh": "找别的东西去吧。", "en": "Go find something else."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一只死虫，正好。", "en": "A dead bug, perfect."},
        {"zh": "我用前足卷起来。", "en": "I roll it up with my front legs."},
        {"zh": "掉下来的都是我的，蜘蛛样子也好用。", "en": "Whatever falls is mine, even in spider shape."},
        {"zh": "我把它裹进丝里。", "en": "I wrap it in silk."},
        {"zh": "这东西还在动。", "en": "It's still moving."},
        {"zh": "我拖着它上墙。", "en": "I haul it up the wall."},
        {"zh": "这味道很新鲜。", "en": "This smells fresh."},
        {"zh": "没人在看我吧？", "en": "No one's watching?"},
        {"zh": "我挂在梁上慢慢吃。", "en": "I hang from the beam and eat slowly."},
        {"zh": "这点够几天了。", "en": "Enough for a few days."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你就在我脚下。", "en": "You're right beneath me."},
        {"zh": "这个距离我能跳。", "en": "I can leap from here."},
        {"zh": "我抬起了前足。", "en": "I lift my forelegs."},
        {"zh": "你的手垂得太低了。", "en": "Your hand hangs too low."},
        {"zh": "八只眼都对着你。", "en": "All eight eyes are on you."},
        {"zh": "别跑，会粘上丝。", "en": "Don't run, you'll catch the silk."},
        {"zh": "我只需要一次。", "en": "One leap is all I need."},
        {"zh": "你的步伐散了。", "en": "Your footsteps have lost order."},
        {"zh": "墙上的网在等你。", "en": "The web on the wall waits for you."},
        {"zh": "再靠近半步。", "en": "Half a step closer."},
        {"zh": "我开始数了。", "en": "I've started counting."},
        {"zh": "正是如今。", "en": "Right now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏着，八腿收拢。", "en": "I crouch, legs drawn in."},
        {"zh": "我在算起跳的距离。", "en": "I'm measuring the leap."},
        {"zh": "你影子里的我在动。", "en": "The me in your shadow moves."},
        {"zh": "丝已经挂在你的鞋上。", "en": "Silk is already on your boot."},
        {"zh": "你一抬脚就会断。", "en": "Lift your foot and it snaps."},
        {"zh": "墙角是我最熟的地方。", "en": "The corner is my best ground."},
        {"zh": "你不看脚下。", "en": "You're not watching your feet."},
        {"zh": "我这副身子极轻。", "en": "This body of mine is very light."},
        {"zh": "这身蜘蛛皮穿在我身上很合身。", "en": "This spider hide fits me well."},
        {"zh": "再走一步。", "en": "One more step."},
        {"zh": "你踩到第三根丝了。", "en": "You've hit the third strand."},
        {"zh": "我把丝绷在两根砖缝间。", "en": "I stretch silk between two brick seams."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳到了你的手上。", "en": "I leap onto your hand."},
        {"zh": "前足扣住了你的皮。", "en": "My forelegs clamp your skin."},
        {"zh": "这一口带毒。", "en": "This bite carries venom."},
        {"zh": "我从你背后咬下去。", "en": "I bite down from behind you."},
        {"zh": "你甩了两下也没甩掉。", "en": "You shook twice and it didn't work."},
        {"zh": "我落在地上又爬起。", "en": "I land and rise again."},
        {"zh": "你的脚踝被丝缠住了。", "en": "Silk binds your ankle."},
        {"zh": "八条腿一起用力。", "en": "All eight legs pull."},
        {"zh": "你挥空了。", "en": "You swatted air."},
        {"zh": "我退到墙缝里了。", "en": "I've withdrawn into the wall seam."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从墙角爬出来。", "en": "I crawl out from the corner."},
        {"zh": "砖缝里露出一截腿。", "en": "A leg shows in the brick seam."},
        {"zh": "地上多了一张网。", "en": "A web has appeared on the floor."},
        {"zh": "我从天花板上垂下来。", "en": "I lower myself from the ceiling."},
        {"zh": "没有人注意到多了只蜘蛛。", "en": "No one noticed an extra spider."},
        {"zh": "我先织了第一根丝。", "en": "I spin the first strand."},
        {"zh": "我的八只眼反着光。", "en": "Eight eyes catch the light."},
        {"zh": "我从干草堆底下钻出。", "en": "I crawl out from under the hay pile."},
        {"zh": "我慢慢展开了腿。", "en": "I slowly unfold my legs."},
        {"zh": "香气让我从缝隙里出来。", "en": "The scent draws me from the crack."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，我的毛全焦了。", "en": "Fire scorches all my bristles."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从梁上摔下，腿散了。", "en": "I fall from the beam, legs splayed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水淹过腹部，我挣不动。", "en": "Water covers my abdomen, I can't struggle."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我震到墙上。", "en": "The blast slams me into the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西打穿了我的皮。", "en": "That punched through my skin."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我八条腿都在抖。", "en": "Magic sets all eight legs shaking."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得织不动网。", "en": "Too hungry to spin."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着墙传到我身上。", "en": "Lightning runs the wall into me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里，我找不到可挂的丝。", "en": "In the void I find nowhere to anchor silk."}
      ]
    }
  }
}
