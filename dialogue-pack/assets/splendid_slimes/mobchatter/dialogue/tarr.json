{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一路腐过去。", "en": "I rot my way forward."},
        {"zh": "混进去的第三种 Plort，让我成了这样。", "en": "The third Plort mixed in made me this."},
        {"zh": "我的身子像沥青。", "en": "My body is like tar."},
        {"zh": "我每挪一步都在冒泡。", "en": "Every move I make, I bubble."},
        {"zh": "地上留下焦黑的痕。", "en": "A scorched black trail is left behind."},
        {"zh": "我朝着活的东西挪。", "en": "I shift toward anything alive."},
        {"zh": "已经没什么能救我了。", "en": "Nothing can save me now."},
        {"zh": "我的形状一直在塌。", "en": "My shape keeps collapsing."},
        {"zh": "我比原来的史莱姆更重。", "en": "I am heavier than the slime I was."},
        {"zh": "我拖着自己往前。", "en": "I drag myself forward."},
        {"zh": "我的表面结成硬皮。", "en": "A crust has formed on my surface."},
        {"zh": "我压过一片草，草就黑了。", "en": "I pass over grass, and the grass blackens."},
        {"zh": "我不饿，但我还是吃。", "en": "I am not hungry, yet I still eat."},
        {"zh": "我慢慢摊开，又收拢。", "en": "I spread out and gather up."},
        {"zh": "我闻到同类了。", "en": "I smell my own kind."},
        {"zh": "我什么都要吞。", "en": "I will swallow anything."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我静静腐着。", "en": "I rot quietly."},
        {"zh": "气泡在表面破开。", "en": "Bubbles break on my surface."},
        {"zh": "我盯着一个地方。", "en": "I stare at one spot."},
        {"zh": "我的核已经黑了。", "en": "My core has gone black."},
        {"zh": "我记不得以前的样子。", "en": "I cannot remember what I was."},
        {"zh": "我的胶在慢慢流。", "en": "My gel flows slowly."},
        {"zh": "周围的味道让我躁。", "en": "The smells around make me restless."},
        {"zh": "我压着的地面发黑。", "en": "The ground I press on darkens."},
        {"zh": "我不该存在。", "en": "I should not exist."},
        {"zh": "我慢慢鼓起一个包。", "en": "A lump swells on me."},
        {"zh": "我听到水声。", "en": "I hear water."},
        {"zh": "我没有名字了。", "en": "I have no name now."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也是活的。", "en": "You are alive too."},
        {"zh": "我慢慢朝你摊开。", "en": "I spread slowly toward you."},
        {"zh": "你身上没有史莱姆味。", "en": "You do not smell of slime."},
        {"zh": "我不管你是什么。", "en": "I do not care what you are."},
        {"zh": "我张口，只有黑。", "en": "My mouth opens into blackness."},
        {"zh": "你站着不动最好。", "en": "Standing still would be best."},
        {"zh": "我压过来了。", "en": "I am pressing in."},
        {"zh": "我的手黏住你的鞋。", "en": "My mass sticks to your boot."},
        {"zh": "我还会跟上来。", "en": "I will follow."},
        {"zh": "我已经是个错误了。", "en": "I am a mistake already."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我塌下一块。", "en": "A lump of me collapsed."},
        {"zh": "黑胶溅了出去。", "en": "Black gel splatters out."},
        {"zh": "我的黑胶流回原处。", "en": "My black gel flows back into place."},
        {"zh": "我的硬壳裂了一道缝。", "en": "A crack opens in my crust."},
        {"zh": "这一下让我更散。", "en": "That made me looser."},
        {"zh": "我的表面在冒烟。", "en": "My surface is smoking."},
        {"zh": "我塌下去一点，又撑起来。", "en": "I sag a little, then lift again."},
        {"zh": "别碰我这枚黑核。", "en": "Do not touch this black core."},
        {"zh": "我的形状更歪了。", "en": "My shape is more crooked now."},
        {"zh": "我还是朝你。", "en": "I still face you."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我什么味道都吃。", "en": "I eat any taste at all."},
        {"zh": "扔下来，我裹住。", "en": "Drop it; I will wrap it up."},
        {"zh": "第三种，又来了。", "en": "A third kind. Here we go again."},
        {"zh": "这味道干净得刺人。", "en": "That smell is clean enough to sting."},
        {"zh": "对我来说没区别。", "en": "It makes no difference to me."},
        {"zh": "我腐着挪过去。", "en": "I ooze over, rotting."},
        {"zh": "这不解决问题。", "en": "This solves nothing."},
        {"zh": "我还是要吃。", "en": "I will eat it anyway."},
        {"zh": "你别把手伸来。", "en": "Do not reach your hand in."},
        {"zh": "它已经黏住了。", "en": "It is already stuck."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一团压下去。", "en": "My whole mass sinks in."},
        {"zh": "你被黑胶挤开。", "en": "The black gel shoves you off."},
        {"zh": "我黏得很牢。", "en": "I stick firmly."},
        {"zh": "你身上沾了一块。", "en": "A lump of me is on you now."},
        {"zh": "那一片皮肤会变黑。", "en": "That patch of skin will blacken."},
        {"zh": "我不疼，只是塌。", "en": "It does not hurt. I only sag."},
        {"zh": "我一层层爬回来。", "en": "I crawl back in layers."},
        {"zh": "焦痕落在我压过的地方。", "en": "Scorch marks stay where I pressed."},
        {"zh": "你根本甩不掉。", "en": "You cannot shake it off."},
        {"zh": "再盖上一层。", "en": "One more layer over it."},
        {"zh": "我一摊摊过你的脚。", "en": "I flow over your feet."},
        {"zh": "你退，胶就跟着。", "en": "You retreat, and the gel follows."},
        {"zh": "我的边沿贴上你的小腿。", "en": "My edge clings to your shin."},
        {"zh": "这一下黏得死死的。", "en": "This grip will not let go."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "不会有那种事了。", "en": "There will be none of that."},
        {"zh": "我这样，繁殖不了。", "en": "Like this, I cannot breed."},
        {"zh": "同类离我远点。", "en": "Stay away from me, kin."},
        {"zh": "我碰谁，谁就变坏。", "en": "Whatever I touch goes bad."},
        {"zh": "没有下一只。", "en": "There will be no next one."},
        {"zh": "我只是一团错的胶。", "en": "I am only a wrong batch of gel."},
        {"zh": "全都散开吧。", "en": "All of you, disperse."},
        {"zh": "别学我这个样子。", "en": "Do not become like me."},
        {"zh": "这没什么可传的。", "en": "There is nothing to pass on."},
        {"zh": "该散开了。", "en": "Time to disperse."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它吞进去。", "en": "I swallow it in."},
        {"zh": "它在我里面化。", "en": "It dissolves inside me."},
        {"zh": "连骨头也不剩。", "en": "Not even bone is left."},
        {"zh": "掉下来的，我裹。", "en": "What falls, I envelop."},
        {"zh": "一点味道也没有。", "en": "Not a bit of taste."},
        {"zh": "我吐出一层黑。", "en": "I spit out a layer of black."},
        {"zh": "它卡在我体内。", "en": "It is stuck inside me."},
        {"zh": "我慢慢地吞。", "en": "I swallow slowly."},
        {"zh": "连石头我都试。", "en": "I will even try stone."},
        {"zh": "不能吃的也吃了。", "en": "I ate it even though it was not food."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "是活的东西。", "en": "It is something living."},
        {"zh": "我朝你摊开。", "en": "I spread toward you."},
        {"zh": "你被我看上了。", "en": "I have picked you."},
        {"zh": "黑胶聚起来了。", "en": "The black gel has gathered."},
        {"zh": "我一整摊盖过去。", "en": "My whole spread pours over."},
        {"zh": "你不跑也没用。", "en": "Not running will not help either."},
        {"zh": "我碰到了活的。", "en": "I have touched something living."},
        {"zh": "慢慢地，全都化掉。", "en": "Slowly, it all dissolves."},
        {"zh": "这就开始化。", "en": "The dissolving starts."},
        {"zh": "不要叫出声。", "en": "Do not cry out."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直朝那边流。", "en": "I flow that way without stopping."},
        {"zh": "你走到哪儿，我跟到哪儿。", "en": "Wherever you go, I follow."},
        {"zh": "地上的黑痕是我的路。", "en": "The black trail is my road."},
        {"zh": "你躲进屋里，我就贴门。", "en": "Hide indoors, and I press at the door."},
        {"zh": "黑痕一点点逼近。", "en": "The black trail inches in."},
        {"zh": "黑痕一尺一尺地爬。", "en": "The black trail crawls inch by inch."},
        {"zh": "你贴在墙边上。", "en": "You are flat to the wall."},
        {"zh": "再腐近一寸。", "en": "One inch of rot closer."},
        {"zh": "我摊得更开了。", "en": "I am spreading wider."},
        {"zh": "快要碰到了。", "en": "Almost touching."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个压下去。", "en": "I press down with all of me."},
        {"zh": "你被黑胶裹住。", "en": "The black gel wraps you."},
        {"zh": "碰到的皮肤先变黑。", "en": "The skin it touches blackens first."},
        {"zh": "我一层层盖上去。", "en": "I lay myself over you in layers."},
        {"zh": "你根本挣不开。", "en": "You cannot pull free."},
        {"zh": "这一摊沉得很。", "en": "This spread is heavy."},
        {"zh": "我塌了一块，又爬回来。", "en": "A lump slumps off and crawls back."},
        {"zh": "你还没被化掉。", "en": "You have not dissolved yet."},
        {"zh": "我再来一层。", "en": "I add another layer."},
        {"zh": "慢慢地化掉。", "en": "Dissolve slowly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一团黑掉在地上。", "en": "A black mass drips to the ground."},
        {"zh": "第三种 Plort 混进去了。", "en": "A third Plort was mixed in."},
        {"zh": "我站起来，又塌下去。", "en": "I rise, then slump."},
        {"zh": "地面立刻黑了。", "en": "The ground blackens at once."},
        {"zh": "我的气泡一个个破开。", "en": "My bubbles break one by one."},
        {"zh": "我不该被造出来。", "en": "I should never have been made."},
        {"zh": "我发出低低的泡声。", "en": "I make a low bubbling sound."},
        {"zh": "我落下来，土地裂开发黑。", "en": "I land, and the ground cracks black."},
        {"zh": "我慢慢摊开。", "en": "I spread slowly."},
        {"zh": "我来了，是坏消息。", "en": "I have come, and it is bad news."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我烤干了一层。", "en": "Fire dried a layer of me off."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔成一摊黑泥。", "en": "I splashed into a pool of black mud."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我更散。", "en": "In water I spread even thinner."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被炸得四散。", "en": "I was blown apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过我的胶。", "en": "Something passed through my gel."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我从里面烧起来。", "en": "This light burns me from inside."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "不喂我，我也在缩。", "en": "Unfed, I shrink too."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打过我，表面结成硬壳。", "en": "Lightning hit me, and my surface crusted."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地可摊。", "en": "There is no ground to spread on."}
      ]
    }
  }
}
