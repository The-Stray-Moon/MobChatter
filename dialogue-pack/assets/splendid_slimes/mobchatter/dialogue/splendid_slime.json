{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一弹一弹地往前。", "en": "I bounce forward, hop by hop."},
        {"zh": "胶质在地上拖出一线。", "en": "My gel drags a line on the ground."},
        {"zh": "我朝着食物的味道去。", "en": "I head for the smell of food."},
        {"zh": "我这只爱吃这一种。", "en": "This body of mine only likes one thing."},
        {"zh": "我跳过小水沟。", "en": "I hop over the little ditch."},
        {"zh": "身体一收一放。", "en": "My body squeezes and releases."},
        {"zh": "我一跳一跳挪过去。", "en": "I hop over, jump by jump."},
        {"zh": "我这一型会发光。", "en": "My type gives off light."},
        {"zh": "有的同类会炸，我不会。", "en": "Some of my kin explode. I do not."},
        {"zh": "我沿着栅栏找路。", "en": "I work along the fence for a way."},
        {"zh": "我压低了身体再弹。", "en": "I flatten and spring."},
        {"zh": "我身上有点粘。", "en": "I am a little sticky."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我静静待着，鼓一下。", "en": "I rest and pulse once."},
        {"zh": "我在等一口吃的。", "en": "I am waiting for a bite."},
        {"zh": "我的核在体内转。", "en": "My core turns inside me."},
        {"zh": "我没长成之前，很小。", "en": "Before I grow, I am small."},
        {"zh": "这附近的味道很杂。", "en": "The smells around here are mixed."},
        {"zh": "我摊在地上歇着。", "en": "I spread on the ground to rest."},
        {"zh": "我这一型不太动。", "en": "My type does not move much."},
        {"zh": "我想要的东西还没来。", "en": "What I want has not come yet."},
        {"zh": "我的表面在反光。", "en": "My surface catches the light."},
        {"zh": "我慢慢成形。", "en": "I take shape slowly."},
        {"zh": "我在想产什么 Plort。", "en": "I wonder what Plort I will make."},
        {"zh": "周围安静得很。", "en": "It is very quiet around."},
        {"zh": "我鼓了一点，又平了。", "en": "I swell a little, then settle."},
        {"zh": "我这一型怕热。", "en": "My type does not like heat."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的胶面动了动，把你的脸映进去。", "en": "My gel ripples and takes in your face."},
        {"zh": "我不认识你这种食物。", "en": "I do not recognise you as food."},
        {"zh": "你手里是不是有东西？", "en": "Is there something in your hand?"},
        {"zh": "我转身朝你。", "en": "I turn to face you."},
        {"zh": "我抬头也只能看到你的鞋。", "en": "Looking up, I can only see your boots."},
        {"zh": "我这一型不咬人。", "en": "My type does not bite people."},
        {"zh": "可别的型会。", "en": "But other types do."},
        {"zh": "你踩到我的胶了。", "en": "You stepped in my gel."},
        {"zh": "你别伸手进来。", "en": "Do not put your hand in."},
        {"zh": "你腰上挂着亮的东西。", "en": "Something bright hangs at your waist."},
        {"zh": "你先动，我再动。", "en": "You move first. Then I will."},
        {"zh": "我弹了一下，靠近些。", "en": "I hop once, a little closer."},
        {"zh": "我们隔得不远。", "en": "We are not far apart."},
        {"zh": "你手一动，我就缩了一下。", "en": "Your hand moves and I shrink back."},
        {"zh": "我不是怪物，只是史莱姆。", "en": "I am no monster, only a slime."},
        {"zh": "我这一型喜欢吃甜的。", "en": "My type likes sweet things."},
        {"zh": "你再站一会儿。", "en": "Stand there a bit longer."},
        {"zh": "我想试试你。", "en": "I want to try you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我缺了一块，正在长回。", "en": "A piece is missing and growing back."},
        {"zh": "我一点点收拢。", "en": "I gather myself bit by bit."},
        {"zh": "胶质溅了满地。", "en": "Gel splatters everywhere."},
        {"zh": "这一下让我变小了。", "en": "That made me smaller."},
        {"zh": "我的核在跳。", "en": "My core is jumping."},
        {"zh": "我不太疼，只是晃。", "en": "It does not hurt much; I only wobble."},
        {"zh": "我的胶溅到石头上。", "en": "My gel splashes onto the stone."},
        {"zh": "我缩回一小坨。", "en": "I draw back one small lump."},
        {"zh": "别碰我的核心。", "en": "Do not touch my core."},
        {"zh": "我还能再弹。", "en": "I can still bounce."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这味道是我这一型要的。", "en": "That smell is what my type needs."},
        {"zh": "只有这一种我才吃。", "en": "That one food is all I eat."},
        {"zh": "快把它放下来。", "en": "Put it down quickly."},
        {"zh": "这味道我尝到了。", "en": "I have caught that taste."},
        {"zh": "我不吃别的。", "en": "I will not eat anything else."},
        {"zh": "你放心，我不咬你。", "en": "Do not worry; I will not bite you."},
        {"zh": "这一口下去，我就长。", "en": "One bite and I will grow."},
        {"zh": "我把它包起来。", "en": "I will wrap myself around it."},
        {"zh": "你要喂就快点。", "en": "Feed me quickly if you are going to."},
        {"zh": "我肚子空得很。", "en": "My belly is very empty."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一弹撞在你腿上。", "en": "I bounce into your leg."},
        {"zh": "你被我推得偏了半步。", "en": "I nudge you half a step off."},
        {"zh": "我的胶黏在你鞋上。", "en": "My gel sticks to your boot."},
        {"zh": "我弹回来，又弹出去。", "en": "I rebound, then bounce off."},
        {"zh": "这一下对我来说很重。", "en": "That is heavy for me."},
        {"zh": "我慢慢恢复形状。", "en": "I slowly return to shape."},
        {"zh": "你踩扁了我一半。", "en": "You flattened half of me."},
        {"zh": "我抖了两下。", "en": "I wobbled twice."},
        {"zh": "这不叫受伤。", "en": "This does not count as injury."},
        {"zh": "往旁边让开点。", "en": "Move aside a little."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "两只同类，凑到一块。", "en": "Two of my kind, drawn together."},
        {"zh": "我们会合出一个新的。", "en": "We will merge into a new one."},
        {"zh": "别混第三种食物。", "en": "Do not mix in a third food."},
        {"zh": "我一层层贴过去。", "en": "I press over in layers."},
        {"zh": "核在互相认。", "en": "Our cores recognise each other."},
        {"zh": "我们分开后各产各的。", "en": "After we part, each produces its own."},
        {"zh": "那块地够我们摊开。", "en": "That patch is wide enough for us."},
        {"zh": "现在先别动。", "en": "Do not move just now."},
        {"zh": "这样就成了。", "en": "That did it."},
        {"zh": "又一个小家伙要出来了。", "en": "Another little one is about to come."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它包住。", "en": "I have wrapped it up."},
        {"zh": "它陷进我的胶体。", "en": "It sank into my gel."},
        {"zh": "不是我的食物。", "en": "Not my food."},
        {"zh": "我从嘴里顶出。", "en": "I push it out of my mouth."},
        {"zh": "这块硬得很。", "en": "This piece is very hard."},
        {"zh": "我一点点分解它。", "en": "I break it down bit by bit."},
        {"zh": "它在我体内滑。", "en": "It slides around inside me."},
        {"zh": "我胀了一下。", "en": "I swelled once."},
        {"zh": "地上的，我用胶裹住。", "en": "The stuff on the ground, I wrap in gel."},
        {"zh": "我推到旁边去。", "en": "I push it to one side."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人踩进来了。", "en": "Someone stepped in."},
        {"zh": "我朝你弹过去。", "en": "I bounce toward you."},
        {"zh": "我的胶收紧了。", "en": "My gel has tightened."},
        {"zh": "你脚下的地归我管。", "en": "The ground under you is mine."},
        {"zh": "这一型，不太客气。", "en": "This type is not very polite."},
        {"zh": "我准备冲撞了。", "en": "I am about to charge."},
        {"zh": "你被盯上了。", "en": "You are marked."},
        {"zh": "我慢慢聚起来。", "en": "I gather myself."},
        {"zh": "我把自己压扁，准备弹。", "en": "I flatten myself to spring."},
        {"zh": "可以动手了。", "en": "You may strike now."},
        {"zh": "我朝你的方向蹦过去。", "en": "I spring off toward you."},
        {"zh": "我这一下很黏。", "en": "This one sticks."},
        {"zh": "你已经跑不了。", "en": "You can no longer run."},
        {"zh": "我压得更扁。", "en": "I flatten myself more."},
        {"zh": "我追上来了。", "en": "I have caught up."},
        {"zh": "把它接住了。", "en": "Catch it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你弹。", "en": "I bounce after you."},
        {"zh": "你走一步，我弹一下。", "en": "You take a step, I take a hop."},
        {"zh": "我在慢慢靠近。", "en": "I am slowly closing in."},
        {"zh": "我的胶能顺着树根爬。", "en": "My gel can crawl along the roots."},
        {"zh": "我的胶能爬过去。", "en": "My gel can crawl over."},
        {"zh": "我们之间在变窄。", "en": "The gap between us narrows."},
        {"zh": "你踩过的地方有痕迹。", "en": "Where you stepped, there are marks."},
        {"zh": "我这一型速度快些。", "en": "This type is a little quicker."},
        {"zh": "再收紧两格。", "en": "Two blocks tighter."},
        {"zh": "我等着你停下。", "en": "I am waiting for you to stop."},
        {"zh": "你被胶包住了。", "en": "The gel has closed around you."},
        {"zh": "省省力气吧。", "en": "Save your strength."},
        {"zh": "我贴到你的鞋边了。", "en": "I'm right against your boot."},
        {"zh": "我鼓起来了。", "en": "I am swelling up."},
        {"zh": "这一下必中。", "en": "This one is sure."},
        {"zh": "你听见咕噜声了吗。", "en": "Do you hear the gurgling."},
        {"zh": "这一团归我。", "en": "This lump is mine."},
        {"zh": "接下来会疼。", "en": "The next part will hurt."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一团砸过去。", "en": "I slam my whole mass in."},
        {"zh": "你被胶裹住。", "en": "The gel wraps around you."},
        {"zh": "我压在你手上。", "en": "I press down on your hand."},
        {"zh": "这一下很黏。", "en": "That one sticks."},
        {"zh": "我弹起来撞你。", "en": "I bounce up into you."},
        {"zh": "你被胶顶开了。", "en": "The gel shoves you open."},
        {"zh": "我弹起来，撞在你脸上。", "en": "I bounce up into your face."},
        {"zh": "这一型咬得动。", "en": "This type can bite."},
        {"zh": "我的胶沾上你了。", "en": "My gel is on you now."},
        {"zh": "我慢慢再聚一次。", "en": "I gather for another."},
        {"zh": "再来一整团。", "en": "One more whole lump."},
        {"zh": "我黏住你的脚踝。", "en": "I stick to your ankle."},
        {"zh": "我一跳砸在你肩上。", "en": "I leap and land on your shoulder."},
        {"zh": "这一团够分量。", "en": "This lump has weight."},
        {"zh": "我往回缩了点。", "en": "I pulled back a little."},
        {"zh": "别踩到我身上。", "en": "Do not step on me."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一团胶落在地上。", "en": "A blob of gel lands on the ground."},
        {"zh": "我在空气里成形。", "en": "I take shape in the air."},
        {"zh": "我从草里冒出来，还湿着。", "en": "I rise out of the grass, still wet."},
        {"zh": "地上多了一小摊湿。", "en": "A small wet patch appears."},
        {"zh": "我鼓起来，又落下。", "en": "I swell, then fall."},
        {"zh": "我这一型，颜色很浅。", "en": "My type is pale."},
        {"zh": "我从食物堆里出来。", "en": "I came out of the food pile."},
        {"zh": "空气里飘着甜味。", "en": "A sweet smell drifts in the air."},
        {"zh": "我的边沿还在往下淌。", "en": "My edges are still running down."},
        {"zh": "我一点点成形。", "en": "I take shape bit by bit."},
        {"zh": "这里有吃的吗。", "en": "Is there food here."},
        {"zh": "附近同类不少。", "en": "There are quite a few of my kind nearby."},
        {"zh": "我弹了一下，落地。", "en": "I hop once and land."},
        {"zh": "十九种之一，就是我。", "en": "One of nineteen types. That is me."},
        {"zh": "我感觉到你的脚步。", "en": "I feel your footsteps."},
        {"zh": "我的胶体从食物残渣里鼓起来。", "en": "My gel swells up out of the food scraps."},
        {"zh": "得先找吃的。", "en": "I need to find food first."},
        {"zh": "我这一型会传送东西。", "en": "My type can teleport things."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，我的胶在缩。", "en": "Fire makes my gel shrink."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔成一个扁片。", "en": "I land as a flat sheet."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我散得开。", "en": "In water I spread out."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被炸成好几团。", "en": "I was blasted into several lumps."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿进了我的身体。", "en": "Something pierced through my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我的核发抖。", "en": "This light makes my core shake."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "一直没喂我，我快没了。", "en": "Unfed this long, I am almost gone."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打我，胶在冒烟。", "en": "Lightning hit me, and my gel steamed."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地面可落。", "en": "There is no ground to land on here."}
      ]
    }
  }
}
