        {"zh": "警告！有危险，请小心！", "en": "Warning! Danger ahead, be cautious!"},
        {"zh": "注意观察，危险临近！", "en": "Be alert, danger is near!"},
        {"zh": "你在我视线范围内，小心！", "en": "In my line of sight, be careful!"},
        {"zh": "发现你了，准备战斗！", "en": "Found you, prepare to fight!"},
        {"zh": "警告！有敌靠近！", "en": "Warning! Enemy approaching!"},
