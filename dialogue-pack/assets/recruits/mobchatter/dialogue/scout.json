{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轻盈跃动，草丛间穿梭！", "en": "Leaping gracefully, darting through the grass!"},
        {"zh": "脚步轻快，掠过绿野！", "en": "Light steps, gliding over the green field!"},
        {"zh": "跳跃间，草浪起伏！", "en": "Each jump causes the grass to sway!"},
        {"zh": "快速穿梭，寻找猎物！", "en": "Quickly scurrying, searching for prey!"},
        {"zh": "轻盈跃起，草尖触手可及！", "en": "Lifting high, touching the tips of the grass!"},
        {"zh": "轻巧跳跃，不留痕迹！", "en": "A nimble leap, leaving no trace!"},
        {"zh": "轻步踏过柔软的草地！", "en": "Soft steps on the lush grass!"},
        {"zh": "敏捷掠过，如风一般！", "en": "Swiftly gliding, like a breeze!"},
        {"zh": "轻盈穿梭，寻找新鲜食物！", "en": "Leaping about, searching for fresh food!"},
        {"zh": "敏捷地穿梭于草丛间！", "en": "Swiftly darting through the grass!"},
        {"zh": "弓背在肩上，脚步放轻", "en": "Bow on my back, I step light."},
        {"zh": "沿着边界巡查一遍", "en": "I walk the border once more."},
        {"zh": "蹲低身子穿过灌木", "en": "I crouch low through the brush."},
        {"zh": "踩着草尖去找高点", "en": "I head for high ground on quiet feet."},
        {"zh": "一边走一边数敌人", "en": "I count enemies as I walk."},
        {"zh": "箭囊在腰间轻响", "en": "My quiver clicks softly at my hip."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静等待，准备出击！", "en": "Waiting quietly, ready to strike!"},
        {"zh": "悠然自得，静静观察！", "en": "Calm and leisurely, observing quietly!"},
        {"zh": "警觉地巡视周围环境！", "en": "Cautiously patrolling the surroundings!"},
        {"zh": "静静站立，倾听风声！", "en": "Standing still, listening to the wind!"},
        {"zh": "静待时机，悄然行动！", "en": "Waiting for the right moment, moving silently!"},
        {"zh": "我在树后记下你的人数和武器。", "en": "Behind this tree I note your numbers and weapons."},
        {"zh": "悠闲地享受宁静时刻！", "en": "Relaxing in peaceful moments!"},
        {"zh": "静静等待，猎物现身！", "en": "Waiting quietly, for the prey to appear!"},
        {"zh": "静静地守护这片土地！", "en": "Quietly guarding this land!"},
        {"zh": "静静驻足，观察一切！", "en": "Standing still, watching everything!"},
        {"zh": "数着远处的火把", "en": "I count the distant torches."},
        {"zh": "把弓弦拉了拉又松开", "en": "I draw the bowstring and let it slack."},
        {"zh": "听着林子里的动静", "en": "I listen to the sounds in the wood."},
        {"zh": "在树皮上刻下标记", "en": "I carve a mark into the bark."},
        {"zh": "盘算撤回的路线", "en": "I plot the route back."},
        {"zh": "把弓横在膝上歇脚", "en": "I rest with the bow across my knees."}
      ]
    },
    "look_player": {
