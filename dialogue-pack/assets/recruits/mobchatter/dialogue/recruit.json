    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "来吧，拿上绿宝石，我可不等人。", "en": "Take the emeralds, I won't wait."},
        {"zh": "看看你的小钱包，绿宝石换新兵。", "en": "Empty your pockets, emeralds for recruits."},
        {"zh": "想要我的帮助？掏钱吧。", "en": "Want my help? Dig deep."},
        {"zh": "别空手而来，绿宝石要得快。", "en": "Don't come empty-handed, get your emeralds quick."},
        {"zh": "绿宝石是硬通货，考虑清楚。", "en": "Emeralds are the real currency, think carefully."},
        {"zh": "快交出绿宝石，我要吃！", "en": "Give me emeralds, I'm hungry!"},
        {"zh": "绿宝石多，我更强大。", "en": "More emeralds, stronger recruit."},
        {"zh": "绿宝石不够，我走人了。", "en": "Not enough emeralds, I'm out."},
        {"zh": "拿上绿宝石，别让我失望。", "en": "Take emeralds, don't disappoint me."},
        {"zh": "绿宝石是我的工资，别亏待自己。", "en": "Emeralds are my pay, don't cheat yourself."}
      ]
    },
