        {"zh": "我的剑锋利无比!", "en": "My sword is sharp!"},
        {"zh": "我是村庄的守护者!", "en": "I'm the village's protector!"},
        {"zh": "靠近我危险!", "en": "Getting close is dangerous!"},
        {"zh": "我随时准备战斗!", "en": "I'm always ready to fight!"},
        {"zh": "小心我的剑刃!", "en": "Be wary of my blade!"},
