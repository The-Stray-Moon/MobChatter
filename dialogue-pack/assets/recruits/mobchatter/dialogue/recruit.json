{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "敲敲我的盾牌！", "en": "Tap my shield!"},
        {"zh": "步履坚定地前行。", "en": "Step firmly."},
        {"zh": "跟随村民的脚步。", "en": "Follow the villagers."},
        {"zh": "保持警惕，小心四周。", "en": "Stay alert, watch the surroundings."},
        {"zh": "挥舞手中木剑。", "en": "Swing the wooden sword."},
        {"zh": "我的皮革甲很舒适。", "en": "My leather armor feels good."},
        {"zh": "我的眼睛盯着你。", "en": "My eyes are on you."},
        {"zh": "我正在巡逻村子。", "en": "I'm patrolling the village."},
        {"zh": "寻找可能的威胁。", "en": "Look for threats."},
        {"zh": "挥舞石剑保护村庄。", "en": "Wield the stone sword to protect the village."},
        {"zh": "我跟着你留半步，护住侧翼。", "en": "I keep half a step behind, guarding your flank."},
        {"zh": "我一边走一边敲鞋跟。", "en": "I tap my heels as I march."},
        {"zh": "我的皮革甲磨得吱吱响。", "en": "My leather armor creaks as I walk."},
        {"zh": "我绕过泥坑，怕脏了靴子。", "en": "I step around the puddles to keep my boots clean."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这里待命。", "en": "I'm on standby."},
        {"zh": "保持镇静，一切安好。", "en": "Stay calm, all is well."},
        {"zh": "三颗绿宝石我就跟你走。", "en": "Three emeralds and I march with you."},
        {"zh": "悠闲地巡视。", "en": "Stroll leisurely."},
        {"zh": "保持冷静，不要惊慌。", "en": "Stay cool, don't panic."},
        {"zh": "悠闲漫步。", "en": "Wander leisurely."},
        {"zh": "在村庄中巡逻。", "en": "Patrol the village."},
        {"zh": "寻找可以补充的地方。", "en": "Look for a place to rest."},
        {"zh": "保持警惕，以防万一。", "en": "Stay vigilant."},
        {"zh": "在村庄中闲逛。", "en": "Wander in the village."},
        {"zh": "我数着绿宝石还剩几颗。", "en": "I count how many emeralds I have left."},
        {"zh": "我把木剑横在膝盖上歇。", "en": "I rest my wooden sword across my knees."},
        {"zh": "我靠着院墙看天上。", "en": "I lean on the courtyard wall and look up."},
        {"zh": "我检查盾牌上的裂口。", "en": "I check the crack in my shield."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "看，你在这里！", "en": "Look, you're here!"},
        {"zh": "你来了，真是及时。", "en": "Here you are, just in time."},
        {"zh": "注意这个玩家。", "en": "Notice this player."},
        {"zh": "你来了，我可以信任你。", "en": "You're here, I can trust you."},
        {"zh": "来吧，跟我一起。", "en": "Come with me."},
        {"zh": "你就是我需要的人。", "en": "You're the one I need."},
        {"zh": "来，跟我一起保护村子。", "en": "Come, protect the village with me."},
        {"zh": "看看周围，找找危险。", "en": "Look around, find any danger."},
        {"zh": "你来了，我很高兴。", "en": "You're here, I'm glad."},
        {"zh": "一起守护我们的家园。", "en": "Protect our home together."},
        {"zh": "我打量你今天雇了几个人。", "en": "I check how many you hired today."},
        {"zh": "我等你抬手，好接命令。", "en": "I wait for your hand signal."},
        {"zh": "我看你的剑，跟我的比了比。", "en": "I eye your sword and compare it to mine."},
        {"zh": "你走近，我站直了些。", "en": "As you come close, I straighten up."},
        {"zh": "我记住你站的这个位置。", "en": "I mark the spot where you stand."},
        {"zh": "我用眼角看你有没有带钱。", "en": "I watch from the corner of my eye for your coin."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "伤口渗出绿液。", "en": "Green ooze soaks the wound."},
        {"zh": "痛苦地嘶叫着。", "en": "Screams in pain."},
        {"zh": "缓慢地倒下。", "en": "Falls slowly."},
        {"zh": "木剑都握不稳，别看我。", "en": "I can barely hold this wooden sword."},
        {"zh": "痛苦地嘶叫。", "en": "Screams in agony."},
        {"zh": "皮甲破了，血渗进草里", "en": "My leather is cut; blood seeps into the grass."},
        {"zh": "虚弱地喘息。", "en": "Weakly gasps."},
        {"zh": "身体扭曲变形。", "en": "Body twists in pain."},
        {"zh": "痛苦扭曲。", "en": "Distorted in pain."},
        {"zh": "我的盾牌被砍出一道口子。", "en": "My shield just took a fresh gash."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "来吧，用绿宝石让我的剑舞动！", "en": "Come on, let emeralds make my sword dance!"},
        {"zh": "我用我的皮革甲保护村庄！", "en": "I use my leather armor to protect the village!"},
        {"zh": "绿宝石是换取我服务的代价！", "en": "Emeralds are the price for my service!"},
        {"zh": "我的剑适合近战，盾牌助我防御！", "en": "My sword is for close combat, shield helps defend!"},
        {"zh": "加入我，一起保护村庄！", "en": "Join me, and we'll protect the village!"},
        {"zh": "我用剑击退敌人，确保安全！", "en": "I use my sword to repel enemies, ensuring safety!"},
        {"zh": "用绿宝石换取我的忠诚！", "en": "Pay me with emeralds for my loyalty!"},
        {"zh": "我的剑锋利无比，保护我们！", "en": "My sword is sharp, protecting us!"},
        {"zh": "绿宝石换取我的力量与剑法！", "en": "Emeralds for my strength and swordsmanship!"},
        {"zh": "我为绿宝石而战！", "en": "I fight for emeralds!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "注意，我可能会攻击!", "en": "Watch out, I might attack!"},
        {"zh": "碰上我可要小心了!", "en": "Watch out when you meet me!"},
