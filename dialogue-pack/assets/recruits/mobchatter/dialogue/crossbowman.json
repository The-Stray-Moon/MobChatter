  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "弓箭在手，箭无虚发。", "en": "Bow in hand, never miss."},
        {"zh": "绿宝石闪烁，力量加持。", "en": "Green gems shine, power granted."},
        {"zh": "箭矢如雨，敌人颤抖。", "en": "Arrows rain, foes tremble."},
        {"zh": "森林深处，我的地盘。", "en": "Deep in the forest, my territory."},
        {"zh": "箭无虚发，精准无比。", "en": "Never miss, perfect aim."},
        {"zh": "护甲无用，箭矢无情。", "en": "Armor useless, arrows deadly."},
        {"zh": "远处猎物，箭在弦上。", "en": "Remote prey, arrow on string."},
        {"zh": "绿宝石光，护我安宁。", "en": "Green gem light, protects me."},
        {"zh": "森林守护，箭矢为证。", "en": "Forest guardian, arrows prove."},
        {"zh": "箭如连珠，敌不敢近。", "en": "Arrows like beads, foes dare not approach."},
        {"zh": "扛着弩，跟在队伍后面。", "en": "Crossbow on his shoulder, he trails the column."},
        {"zh": "他快步换位，找了个射角。", "en": "He hurries to a new spot for a clean shot."},
        {"zh": "靴子踩碎枯枝，一路小跑。", "en": "He trots, boots snapping dry twigs."},
        {"zh": "他侧身走，弩口朝外。", "en": "He walks sideways, crossbow pointed out."},
        {"zh": "他一边走一边给弩上弦。", "en": "He winds the crossbow as he walks."},
        {"zh": "他退着走，眼睛盯着敌人。", "en": "He backs away without taking his eyes off the foe."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准目标，一箭双穿。", "en": "Aim at target, two through one arrow."},
        {"zh": "绿宝石闪烁，静待猎物。", "en": "Green gems shine, waiting for prey."},
        {"zh": "森林之中，我是主宰。", "en": "Forest master, I rule here."},
        {"zh": "护甲无效，箭矢无畏。", "en": "Armor ineffective, arrows fearless."},
        {"zh": "箭矢蓄力，一击必杀。", "en": "Arrow charged, one hit kills."},
        {"zh": "绿宝石护佑，我来守卫。", "en": "Green gems protect, I defend."},
        {"zh": "敌人来临，箭雨已备。", "en": "Enemies come, arrows ready."},
        {"zh": "绿宝石在手，我不怕。", "en": "Green gems, I’m not afraid."},
        {"zh": "森林深处，我是猎手。", "en": "Deep forest, I’m the hunter."},
        {"zh": "箭无虚发，猎物难逃。", "en": "Never miss, prey escapes not."},
        {"zh": "他蹲下检查弩机。", "en": "He crouches to check the crossbow's mechanism."},
        {"zh": "他数了数箭袋里的弩矢。", "en": "He counts the bolts in his quiver."},
        {"zh": "他把绿宝石塞回腰带里。", "en": "He tucks the emerald back into his belt."},
        {"zh": "他靠着树，盯着林间。", "en": "He leans on a tree, watching the treeline."},
        {"zh": "他在等你的下一道命令。", "en": "He waits for your next order."},
        {"zh": "他活动了下拉弦的手指。", "en": "He flexes the fingers that draw the string."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物就在，准备射击。", "en": "Prey here, ready to shoot."},
        {"zh": "玩家来了，箭已瞄准。", "en": "Player comes, arrow aimed."},
        {"zh": "瞄准玩家，一箭毙命。", "en": "Aim at player, one shot kills."},
        {"zh": "猎物眼中，箭雨即至。", "en": "Player in sight, arrows coming."},
        {"zh": "玩家近了，箭在弦上。", "en": "Player near, arrow on string."},
        {"zh": "猎物来临，箭矢已备。", "en": "Player here, arrows ready."},
        {"zh": "八颗绿宝石的工钱，值这一箭。", "en": "Eight emeralds' wages; this bolt is worth them."},
        {"zh": "玩家在望，箭无虚发。", "en": "Player in view, never miss."},
