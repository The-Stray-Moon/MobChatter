    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "见到食物总是流口水。", "en": "Salivating at the sight of food."},
        {"zh": "看到食物就忘我了。", "en": "Focused solely on the food."},
        {"zh": "贪婪地盯着食物。", "en": "Staring greedily at the food."},
        {"zh": "美食诱惑不断。", "en": "Perpetual temptation."},
        {"zh": "食物是我的最爱。", "en": "Food is my favorite."},
        {"zh": "吃个饱再战。", "en": "Eat up before the fight."},
        {"zh": "食物是最好的慰藉。", "en": "Food is the best comfort."},
        {"zh": "为食物可以等。", "en": "Can wait for the food."},
        {"zh": "为了食物我可以冒险。", "en": "Risks for the food."},
        {"zh": "美食不可辜负。", "en": "Delicious food must be enjoyed."},
        {"zh": "他嚼着面包，眼睛还盯着前方。", "en": "He chews bread with his eyes still forward."},
        {"zh": "他伸手去够第二个苹果。", "en": "He reaches for a second apple."},
        {"zh": "他舔了舔手指上的油。", "en": "He licks the grease off his fingers."},
        {"zh": "吃两口，他又去摸弩。", "en": "Two bites in, he's reaching for the crossbow."},
        {"zh": "他把最后一块饼塞进嘴里。", "en": "He stuffs the last of the flatbread in."},
        {"zh": "他吃饭时也不放下弩。", "en": "He eats without setting the crossbow down."}
      ]
    },
