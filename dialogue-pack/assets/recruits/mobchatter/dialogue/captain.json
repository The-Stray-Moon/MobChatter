    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "在水面滑行！", "en": "Slide on water!"},
        {"zh": "前进，舰长！", "en": "Forward, captain!"},
        {"zh": "水下航行！", "en": "Submerge and swim!"},
        {"zh": "保持警惕，舰长。", "en": "Stay alert, captain."},
        {"zh": "火炮装好了，等我口令。", "en": "The cannon is loaded; await my word."},
        {"zh": "调整船舵。", "en": "Adjust the rudder."},
        {"zh": "发射炮弹！", "en": "Fire the cannon!"},
        {"zh": "小心，敌船！", "en": "Beware, enemy ship!"},
        {"zh": "调整航向。", "en": "Adjust the course."},
        {"zh": "稳住，舵手！", "en": "Hold steady, helmsman!"},
        {"zh": "顺着河道走，别靠岸。", "en": "Follow the channel. Stay off the bank."},
        {"zh": "把帆收一点，风太急。", "en": "Reef the sail a little. The wind is sharp."},
        {"zh": "船底擦过浅滩了。", "en": "The hull scraped the shallows."},
        {"zh": "炮口朝左，我看那边。", "en": "Guns to port. I am watching that side."},
        {"zh": "船员跟上，别掉队。", "en": "Crew, keep up. Do not fall behind."},
        {"zh": "绕过这块礁石。", "en": "Steer around this reef."}
      ]
    },
    "idle": {
