    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "船上火炮已就位，等我口令。", "en": "Deck cannon ready — await my order."},
        {"zh": "船还系在水里，炮口对着岸。", "en": "My boat stays moored, cannon on the shore."},
        {"zh": "跟随我！", "en": "Follow me!"},
        {"zh": "上船，火炮已经装好。", "en": "Get aboard. The cannon is loaded."},
        {"zh": "船的炮口，转向你了。", "en": "The boat's cannon swings toward you."},
        {"zh": "到我这边来，炮位空着。", "en": "Come to my side; the gun port is free."},
        {"zh": "跳板还没放下，别急着上船。", "en": "The gangplank is still up; do not board yet."},
        {"zh": "上船，炮位在右侧。", "en": "Board the ship; the cannon's to starboard."},
        {"zh": "水面上有桨声，不太对。", "en": "Oars on the water — something is off."},
        {"zh": "靠近我会危险！", "en": "Getting too close is dangerous!"},
        {"zh": "你是来应聘的还是来抢的？", "en": "Are you here to enlist, or to rob me?"},
        {"zh": "上船先报个名。", "en": "Board the ship and give your name first."}
