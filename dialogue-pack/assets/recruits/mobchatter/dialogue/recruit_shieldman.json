    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "步伐坚定，盾牌随步移动。", "en": "Steps with a steady gait, shield swings along."},
        {"zh": "斧头轻挥，盾牌护体。", "en": "Wields axe, shield protects."},
        {"zh": "盾牌在身，步伐缓慢。", "en": "Shield at hand, moves slowly."},
        {"zh": "持盾前行，斧头在侧。", "en": "Shield forward, axe at side."},
        {"zh": "缓慢前行，护盾护己。", "en": "Moves slowly, shield protects."},
        {"zh": "左手持盾，右手挥斧。", "en": "Holds shield, wields axe."},
        {"zh": "盾牌在手，步伐稳重。", "en": "Shield in hand, steps firmly."},
        {"zh": "缓慢移动，持盾保护。", "en": "Moves slowly, shield defends."},
        {"zh": "持斧持盾，稳步前行。", "en": "Holds axe, shield, walks steadily."},
        {"zh": "盾牌遮挡，斧头挥舞。", "en": "Shield blocks, axe swings."},
        {"zh": "石斧压在肩上走着。", "en": "I walk with the stone axe on my shoulder."},
        {"zh": "盾沿磕着膝盖前行。", "en": "My shield rim taps my knee as I go."},
        {"zh": "慢是慢，队形不乱。", "en": "Slow, but the formation holds."},
        {"zh": "跟在队长后面走。", "en": "I follow behind the captain."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "驻足观察，盾在身侧。", "en": "Pauses, shield at side."},
