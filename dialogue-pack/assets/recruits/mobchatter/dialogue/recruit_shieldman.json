        {"zh": "站着，眼睛不闲着。", "en": "I stand still, but my eyes don't."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉玩家，持盾戒备。", "en": "Notices player, shield ready."},
        {"zh": "眼神锐利，盾牌戒备。", "en": "Sharp eyes, shield ready."},
