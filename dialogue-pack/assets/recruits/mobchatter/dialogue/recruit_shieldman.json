        {"zh": "盾牌在手，默默守望。", "en": "Holds shield, stands watch."},
        {"zh": "驻足环视，盾护身旁。", "en": "Pauses, shield protects."},
        {"zh": "持盾静立，斧头在手。", "en": "Holds shield, axe at hand."},
        {"zh": "驻足思索，盾牌不离身。", "en": "Pauses, shield stays with."},
        {"zh": "持盾守护，斧头在侧。", "en": "Holds shield, axe at side."},
        {"zh": "驻足片刻，盾牌在手。", "en": "Pauses, shield in hand."},
        {"zh": "持斧持盾，静默不语。", "en": "Holds axe, shield, silent."},
        {"zh": "驻足凝视，护盾在身。", "en": "Pauses, shield protects."},
        {"zh": "把盾挪到身前挡着。", "en": "I shift my shield to the front."},
