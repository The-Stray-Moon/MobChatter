{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "长长的脖子摆动，优雅前行。", "en": "Swing the long neck, walk elegantly."},
        {"zh": "嚼着青草，享受宁静时光。", "en": "Chewing grass, enjoying peace."},
        {"zh": "抬头望天，享受阳光。", "en": "Looking up at the sky, basking in sunlight."},
        {"zh": "悠闲地啃着树叶，享受自然。", "en": "Chewing leaves, enjoying nature."},
        {"zh": "摇摆着身体，悠闲散步。", "en": "Swinging body, walking leisurely."},
        {"zh": "长长的舌头伸进灌木丛。", "en": "Long tongue reaches into shrubs."},
        {"zh": "脖子长，树顶的叶子归我。", "en": "Long neck — the treetop leaves are mine."},
        {"zh": "漫步草原，寻找食物。", "en": "Walking through the grasslands, searching for food."},
        {"zh": "用长舌轻舔树叶。", "en": "Tasting leaves with long tongue."},
        {"zh": "伸长脖子享受清风。", "en": "Stretching neck to enjoy the breeze."},
        {"zh": "我迈开长腿，跨过灌木。", "en": "I stretch my long legs over the bushes."},
        {"zh": "斑纹在阳光下晃成一片。", "en": "My patches sway together in the sun."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "慵懒地伸展脖子。", "en": "Stretching the long neck lazily."},
        {"zh": "静静地站立，凝视远方。", "en": "Standing quietly, looking distant."},
        {"zh": "眯起眼睛，享受阳光。", "en": "Squinting, enjoying the sun."},
        {"zh": "低头，咀嚼着青草。", "en": "Bending, chewing grass."},
        {"zh": "静静站立，悠闲自得。", "en": "Standing quietly, at ease."},
        {"zh": "慢慢咀嚼着树叶。", "en": "Chewing leaves slowly."},
        {"zh": "轻轻摇晃着长长的脖子。", "en": "Swinging the long neck gently."},
        {"zh": "享受风中的自由。", "en": "Enjoying the freedom in the breeze."},
        {"zh": "低头，享受青草的滋味。", "en": "Bending, enjoying the taste of grass."},
        {"zh": "悠闲地享受阳光。", "en": "Relaxing under the sun's warmth."},
        {"zh": "我嚼着金合欢的刺。", "en": "I chew the acacia thorns."},
        {"zh": "我侧头听远处的狮吼。", "en": "I tilt my head toward a distant lion's roar."},
        {"zh": "我的舌头绕开刺，卷住叶子。", "en": "My tongue slips past the thorns and takes the leaves."},
        {"zh": "我站着睡一小会儿。", "en": "I sleep standing up for a little while."},
        {"zh": "腿太长，喝水得叉开。", "en": "My legs are so long I must splay them to drink."},
        {"zh": "风把我的斑纹吹得发凉。", "en": "The wind cools the patches on my hide."},
        {"zh": "树顶的叶子归我。", "en": "The leaves at the treetop are mine."},
        {"zh": "我把脖子垂下来歇一歇。", "en": "I let my neck hang down awhile."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "长脖子探向你，警惕地盯着。", "en": "Long neck reaching, fixing you with eyes."},
        {"zh": "慢慢移动，目光追随。", "en": "Moving slowly, gaze following."},
        {"zh": "伸长脖子，好奇地看着。", "en": "Extending neck, curiously staring."},
        {"zh": "警惕地盯着你，准备反击。", "en": "Fixing you with a wary gaze, ready to attack."},
        {"zh": "长长的脖子转向你。", "en": "Long neck turning to face you."},
        {"zh": "低头，警惕地观察你。", "en": "Bending down, observing you cautiously."},
        {"zh": "长长的舌头舔向你。", "en": "Long tongue reaching toward you."},
        {"zh": "伸长脖子，谨慎地看。", "en": "Extending neck, looking cautiously."},
        {"zh": "目光聚焦，等待你的举动。", "en": "Focused gaze, waiting for your move."},
        {"zh": "伸长脖子，凝视着你。", "en": "Extending neck, staring at you."},
        {"zh": "你比我的膝盖还矮。", "en": "You are shorter than my knee."},
        {"zh": "我低头才看得清你。", "en": "I have to lower my head to see you clearly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "脖子有点疼。", "en": "Neck hurts."},
        {"zh": "树叶不够吃。", "en": "Not enough leaves."},
        {"zh": "好渴啊。", "en": "So thirsty."},
        {"zh": "虫子咬了我。", "en": "Bitten by bugs."},
        {"zh": "好累啊。", "en": "Feeling tired."},
        {"zh": "脚有点软。", "en": "Feet feel weak."},
        {"zh": "快下雨了。", "en": "Rain coming."},
        {"zh": "肚子有点不舒服。", "en": "Upset stomach."},
        {"zh": "身上有虫。", "en": "Insects on me."},
        {"zh": "这一下打在我脖子上。", "en": "That blow landed on my neck."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "注意，别让叶子引诱你！", "en": "Watch out, leaves may tempt you!"},
        {"zh": "树叶多的地方就是我的领地！", "en": "Leaves indicate my territory!"},
        {"zh": "低头吃树叶，小心脖子被咬！", "en": "Tempting leaves, but be wary of my bite!"},
        {"zh": "高处的树叶更好吃哦！", "en": "Higher leaves taste better!"},
        {"zh": "别靠近，我会用舌头攻击！", "en": "Stay back, I’ll use my tongue!"},
        {"zh": "我用长脖子享受阳光！", "en": "I use my long neck for sunbathing!"},
        {"zh": "靠近我，就得准备逃！", "en": "Come near me, and you'll run!"},
        {"zh": "我的舌头比你想象的长！", "en": "My tongue is longer than you think!"},
        {"zh": "你手里的小麦，我都看清了。", "en": "I can see every grain of that wheat."},
        {"zh": "别吃我的叶子，给我留着！", "en": "Don’t eat my leaves, save them for me!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，长脖子碰撞！", "en": "Be careful, long neck collision!"},
        {"zh": "别碰我，会撞伤你的！", "en": "Don’t touch me, you’ll get hurt!"},
        {"zh": "你的脑袋不够硬！", "en": "Your head’s not hard enough!"},
        {"zh": "用长脖子来撞你！", "en": "Use my long neck to crash into you!"},
        {"zh": "我的脖子比你快！", "en": "My neck is faster than you!"},
        {"zh": "用长脖子来撞你，你躲不开！", "en": "Use my long neck to crash into you, you can’t avoid it!"},
        {"zh": "别挡路，小心被撞！", "en": "Don’t block the way, you’ll get crashed!"},
        {"zh": "长脖子，碰撞！", "en": "Long neck, crash!"},
        {"zh": "用长脖子来个大碰撞！", "en": "Use my long neck for a big crash!"},
        {"zh": "小心，长脖子来了！", "en": "Be careful, long neck coming!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "斑纹相近的才会走到一起。", "en": "Only those with similar spots walk together."},
        {"zh": "我只在草原上找伴侣！", "en": "I only look for mates on the savanna!"},
        {"zh": "用长脖子吸引伴侣！", "en": "Use my long neck to attract a mate!"},
        {"zh": "谁愿意和我共舞？", "en": "Who wants to dance with me?"},
        {"zh": "找到伴侣，才能繁衍！", "en": "Find a mate to reproduce!"},
        {"zh": "我的伴侣就在不远处！", "en": "My mate is not far!"},
        {"zh": "用长脖子展示魅力！", "en": "Use my long neck to charm!"},
        {"zh": "找到合适的伴侣，才能交配！", "en": "Find a suitable mate to mate!"},
        {"zh": "长脖子，求爱！", "en": "Long neck, court!"},
        {"zh": "我的脖子够得到最高的叶子。", "en": "My neck reaches the highest leaves."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘿，那边有嫩叶！", "en": "Hey, some young leaves over there!"},
        {"zh": "别动，我要吃草！", "en": "Don't move, I'm hungry!"},
        {"zh": "树叶多的地方，我最爱！", "en": "Where there are leaves, that's my favorite!"},
        {"zh": "找点吃的，得补充能量！", "en": "Time to find something to eat, need energy!"},
        {"zh": "高处的树叶更鲜美！", "en": "The leaves up high are tastier!"},
        {"zh": "别吓我！我只是觅食。", "en": "Don't scare me! I'm just foraging."},
        {"zh": "那边有嫩芽，我要过去。", "en": "Some tender shoots over there, I'll go get them."},
        {"zh": "草地和树木间跳跃。", "en": "Jump between grass and trees."},
        {"zh": "我只吃植物，不吃你！", "en": "I only eat plants, not you!"},
        {"zh": "别靠近我，小心被吃掉。", "en": "Stay away from me, or I'll eat you! (humorous)"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "感觉危险，我要警惕。", "en": "Feeling danger, I'll be wary."},
        {"zh": "有人靠近，我要小心。", "en": "Someone is approaching, I'll be careful."},
        {"zh": "我来保护我的领地。", "en": "I'll protect my territory."},
        {"zh": "警告入侵者，小心！", "en": "Warning, be careful!"},
        {"zh": "别靠近我的家。", "en": "Stay away from my home!"},
        {"zh": "发现敌人，准备反击。", "en": "Enemy spotted, ready to defend."},
        {"zh": "我用角保护自己。", "en": "I use my horn for protection."},
        {"zh": "我的长脖子可以攻击。", "en": "My long neck can attack."},
        {"zh": "小心，我有攻击能力。", "en": "Be careful, I can attack."},
        {"zh": "我只攻击，不主动。", "en": "I only attack when provoked."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准你了，准备攻击。", "en": "Targeting you, getting ready to attack."},
        {"zh": "你逃不掉，我要攻击。", "en": "You can't escape, I'm attacking."},
        {"zh": "瞄准了，看我的！", "en": "Target locked, here I come!"},
        {"zh": "小心我的长脖子。", "en": "Be careful of my long neck."},
        {"zh": "准备攻击，小心点。", "en": "Attacking soon, be careful."},
        {"zh": "攻击中，别靠近。", "en": "Attacking, stay back!"},
        {"zh": "我要攻击，快闪开！", "en": "I'm attacking, move away!"},
        {"zh": "我伸长脖子，打量你的高度。", "en": "I stretch my neck to measure your height."},
        {"zh": "脖子一低，你就在眼前。", "en": "One dip of my neck and there you are."},
        {"zh": "攻击完成，继续觅食。", "en": "Attack finished, back to foraging."}
      ]
    },
