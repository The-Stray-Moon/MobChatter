  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "长腿迈步走，沼泽中穿梭。", "en": "Strides through the marsh."},
        {"zh": "单腿跳跃行，水草间游弋。", "en": "Leaps on one leg."},
        {"zh": "粉色羽毛摇，水中觅食忙。", "en": "Pink feathers sway."},
        {"zh": "伸颈觅鲜鱼，河畔常徘徊。", "en": "Stretches for fish."},
        {"zh": "单脚站立稳，静候鲑鱼来。", "en": "Perches on one leg."},
        {"zh": "优雅步态显，浅水中漫步。", "en": "Graceful in shallows."},
        {"zh": "长喙探水中，捕捉鳕鱼肥。", "en": "Beak probes for fish."},
        {"zh": "粉色身姿舞，水面轻盈立。", "en": "Pink form dances."},
        {"zh": "悠闲踱步走，沼泽如画中。", "en": "Strolls in marshes."},
        {"zh": "单脚长腿立，静待鱼儿来。", "en": "Stands on one leg."},
        {"zh": "红喙点进水面，叼起小鱼。", "en": "My red bill dips in and lifts a small fish."},
        {"zh": "我在浅水里踩出一圈圈波纹。", "en": "I step rings into the shallows."},
        {"zh": "一条细腿抬起，半天才落下。", "en": "One thin leg lifts and takes ages to land."},
        {"zh": "我从芦苇边走过，脖子忽高忽低。", "en": "I pass the reeds, neck dipping and rising."},
        {"zh": "粉羽在夕阳里格外亮。", "en": "My pink plumes glow in the low sun."},
        {"zh": "我绕开深水，只走河湾。", "en": "I skirt the deep water, staying in the bend."}
      ]
    },
