    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "受伤了，飞不起来。", "en": "Injured, can't fly."},
        {"zh": "翅膀受伤，走不动。", "en": "Winged injury, can't walk."},
        {"zh": "我换了一条腿站着。", "en": "I shift onto my other leg."},
        {"zh": "翅膀受了伤，慢点追。", "en": "Winged injury, slow down."},
        {"zh": "翅膀断了，快逃吧。", "en": "Wings broken, run!"},
        {"zh": "单腿站着，也站不稳了。", "en": "Single leg or not, I can't stay upright."},
        {"zh": "粉色的羽毛掉了好几根。", "en": "Several pink feathers come loose."},
        {"zh": "单腿站着也躲不开。", "en": "Even on one leg, I couldn't dodge."},
        {"zh": "翅膀受伤，走不动了。", "en": "Winged injury, can't walk."},
        {"zh": "我一条腿站酸了，另一条也疼。", "en": "One leg's stiff; now the other hurts."}
      ]
    },
