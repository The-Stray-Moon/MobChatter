    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嗖~嗖~", "en": "Swoosh~ Swoosh~"},
        {"zh": "盯着你看呢。", "en": "Staring at you."},
        {"zh": "这片森林是我的领地。", "en": "This forest is my territory."},
        {"zh": "别动，我闻到了你。", "en": "Don't move, I can smell you."},
        {"zh": "你身上有食物的味道。", "en": "You smell like food."},
        {"zh": "别过来，小心点儿。", "en": "Don't come closer, be careful."},
        {"zh": "我的眼睛很尖。", "en": "Sharp eyes."},
        {"zh": "这里的食物不够吃。", "en": "Not enough food here."},
        {"zh": "找到鸵鸟蛋了。", "en": "Found an ostrich egg."},
        {"zh": "我要吃掉它们。", "en": "I'm going to eat them."},
        {"zh": "小爪子扒拉着落叶堆。", "en": "Little paws scratch through the leaf litter."},
        {"zh": "沿着倒木一溜小跑。", "en": "I trot along a fallen log."},
        {"zh": "尾巴一翘，钻过栅栏缝。", "en": "Tail up, I slip through a fence gap."},
        {"zh": "在溪边洗了洗爪子。", "en": "I wash my paws at the stream."},
        {"zh": "叼着半个苹果往回跑。", "en": "I run back with half an apple in my mouth."},
        {"zh": "爬上树干，探头看鸟窝。", "en": "I climb the trunk and peek into a nest."}
      ]
    },
