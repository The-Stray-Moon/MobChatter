{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轻轻摆动尾鳍。", "en": "Swish the tail gently."},
        {"zh": "在珊瑚间穿梭。", "en": "Navigate through corals."},
        {"zh": "缓缓向前游去。", "en": "Move slowly ahead."},
        {"zh": "好奇地观察周围。", "en": "Curiously glance around."},
        {"zh": "躲进海藻丛中。", "en": "Hide in seaweed."},
        {"zh": "游向温暖的水流。", "en": "Head to warm currents."},
        {"zh": "避开掠食者的威胁。", "en": "Avoid predators."},
        {"zh": "悠闲地游弋水中。", "en": "Swim leisurely."},
        {"zh": "快速逃离危险。", "en": "Quickly escape danger."},
        {"zh": "享受海洋的温柔。", "en": "Relish the sea's embrace."},
        {"zh": "直立着身子，随水流漂。", "en": "Upright, it drifts with the current."},
        {"zh": "卷尾缠住一截海草。", "en": "Its curled tail grips a strand of seagrass."},
        {"zh": "用长吻吸起小虾。", "en": "Its long snout slurps up a tiny shrimp."},
        {"zh": "背鳍飞快地扇动。", "en": "Its dorsal fin flutters fast."},
        {"zh": "和同伴排成一列游过。", "en": "It swims past in a line with its kin."},
        {"zh": "贴着沙地缓慢挪动。", "en": "It inches along close to the sand."},
        {"zh": "转个身，躲到珊瑚背面。", "en": "It turns and slips behind the coral."},
        {"zh": "被水流推得晃了晃。", "en": "The current rocks it sideways."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静地停在珊瑚上。", "en": "Rest on coral."},
        {"zh": "慵懒地摆动着尾巴。", "en": "Lazily swing the tail."},
        {"zh": "漂浮在水面上。", "en": "Float on the surface."},
        {"zh": "注视着周围的景象。", "en": "Stare at surroundings."},
        {"zh": "在暖流里慢慢摆尾巴。", "en": "I sway my tail slowly in the warm current."},
        {"zh": "平静地呼吸着水。", "en": "Breathe calmly."},
        {"zh": "偶尔吐出气泡。", "en": "Occasionally bubble."},
        {"zh": "悠闲地摇摆身体。", "en": "Sway leisurely."},
        {"zh": "我卷着海草，一动不动。", "en": "Curled around a weed, perfectly still."},
        {"zh": "悠闲地晃动着身体。", "en": "Shake lazily."},
        {"zh": "用尾巴挂住海草打盹。", "en": "It dozes, tail hooked on seagrass."},
        {"zh": "鼓着鳃，慢慢吐气。", "en": "Its gills puff as it breathes slowly."},
        {"zh": "眼珠各自转着看两边。", "en": "Its eyes swivel independently."},
        {"zh": "在原地一上一下地浮。", "en": "It bobs up and down in place."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "立在水草边，盯着你的桶。", "en": "I hover by the seagrass, watching your bucket."},
        {"zh": "好奇地接近玩家。", "en": "Approach the player curiously."},
        {"zh": "小眼睛盯着你的水桶。", "en": "My small eyes fix on your water bucket."},
        {"zh": "游向玩家的方向。", "en": "Move towards the player."},
        {"zh": "游近玩家身边。", "en": "Approach the player."},
        {"zh": "小心翼翼地观察玩家。", "en": "Carefully observe the player."},
        {"zh": "用尾巴轻轻触碰玩家。", "en": "Touch the player gently with the tail."},
        {"zh": "好奇地围着玩家转。", "en": "Circle the player curiously."},
        {"zh": "紧张地游离玩家。", "en": "Move away from the player."},
        {"zh": "游近玩家，试探一下。", "en": "Approach the player tentatively."}
      ]
    },
