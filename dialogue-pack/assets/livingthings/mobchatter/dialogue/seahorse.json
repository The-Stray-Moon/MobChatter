    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你抛下的鱼饵诱惑着我。", "en": "The bait tempts me."},
        {"zh": "这片水域里食物很丰富。", "en": "Food is plentiful here."},
        {"zh": "温暖的海水让我更加活跃。", "en": "Warm water makes me active."},
        {"zh": "我游向新的领地寻找食物。", "en": "I search for food in new territories."},
        {"zh": "这里的食物足以让我成长。", "en": "Food here fuels my growth."},
        {"zh": "海藻丛中隐藏着更多食物。", "en": "More food hides in the kelp."},
        {"zh": "我必须避开这片区域的危险。", "en": "I must avoid the dangers here."},
        {"zh": "我需要更多食物来强壮自己。", "en": "I need more food to strengthen myself."},
        {"zh": "我找到了一片肥沃的海域。", "en": "I found a fertile sea area."},
        {"zh": "这里的食物比预期的还要多。", "en": "There's even more food here."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "突然与你撞了个满怀。", "en": "I collide with you."},
        {"zh": "我游得太快撞上了礁石。", "en": "I collide with a reef."},
        {"zh": "小心，我不会伤害你。", "en": "Be careful, I won't harm you."},
        {"zh": "我在水中游得飞快。", "en": "I swim very fast in water."},
        {"zh": "我与你擦肩而过。", "en": "I pass you by."},
        {"zh": "碰撞让我失去平衡。", "en": "The collision throws me off balance."},
        {"zh": "我不小心撞上了你的鱼桶。", "en": "I accidentally collide with your bucket."},
        {"zh": "我用尾巴轻轻扫过。", "en": "I sweep with my tail gently."},
        {"zh": "突然的碰撞让我吓了一跳。", "en": "The sudden collision startles me."},
        {"zh": "与你擦肩而过的短暂接触。", "en": "A brief touch as we pass each other."},
        {"zh": "被水流挤到你的腿上。", "en": "The current pushes it against your leg."},
        {"zh": "卷尾扫过你的手臂。", "en": "Its curled tail brushes your arm."}
      ]
    },
    "mate": {
