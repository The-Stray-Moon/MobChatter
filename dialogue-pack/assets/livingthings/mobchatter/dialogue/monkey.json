{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "蹦蹦跳跳的，捡起地上的香蕉。", "en": "Jumping around, picking up a banana."},
        {"zh": "在树林里穿梭，寻找美味的果实。", "en": "Moving through the forest, searching for tasty fruit."},
        {"zh": "欢快地在树枝间跳跃。", "en": "Leaping joyfully between branches."},
        {"zh": "听到音乐声就跟着摇摆。", "en": "Dancing to the music."},
        {"zh": "啃着苹果，享受阳光。", "en": "Chomping an apple, enjoying the sun."},
        {"zh": "吃香蕉，满足又愉快。", "en": "Eating a banana, feeling content."},
        {"zh": "悠闲地在草地上漫步。", "en": "Strolling leisurely on the grass."},
        {"zh": "寻找可以栖息的高枝。", "en": "Searching for a high branch to rest."},
        {"zh": "在雨后吃湿透的苹果。", "en": "Eating a waterlogged apple after the rain."},
        {"zh": "从树洞里探出头来观察。", "en": "Peeking out of a tree洞 to observe."},
        {"zh": "抱着香蕉在枝头荡。", "en": "Swinging branch to branch with a banana."},
        {"zh": "尾巴勾住藤蔓往前挪。", "en": "Tail hooked on a vine, sliding forward."},
        {"zh": "爬到最高的树顶张望。", "en": "Climbing to the highest crown to look around."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "安静地坐在香蕉树下。", "en": "Sitting quietly under a banana tree."},
        {"zh": "懒洋洋地躺在柔软的草地上。", "en": "Lying lazily on the soft grass."},
        {"zh": "在阳光下晒晒太阳。", "en": "Sunbathing in the sun."},
        {"zh": "盯着玩家，等待被驯服。", "en": "Staring at the player, waiting to be tamed."},
        {"zh": "咀嚼着苹果，享受片刻宁静。", "en": "Chewing on an apple, enjoying a moment of peace."},
        {"zh": "闭着眼睛享受微风。", "en": "Closing eyes, enjoying the breeze."},
        {"zh": "在树荫下乘凉。", "en": "Cooling off under the trees."},
        {"zh": "好奇地看着玩家的背包。", "en": "Curiously watching the player’s backpack."},
        {"zh": "看着唱片机，跃跃欲试。", "en": "Looking at the record player, ready to dance."},
        {"zh": "安静地舔舐香蕉皮。", "en": "Quietly licking a banana peel."},
        {"zh": "给自己理毛捉虱子。", "en": "Grooming myself for ticks."},
        {"zh": "把手伸进树洞摸索。", "en": "Digging my hand into a tree hollow."},
        {"zh": "倒挂在枝上打瞌睡。", "en": "Dozing upside down on a branch."},
        {"zh": "听见唱片机就晃起来。", "en": "The jukebox starts and I sway."},
        {"zh": "抱着自己的膝盖坐着。", "en": "Sitting with my knees hugged tight."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "发现玩家，迅速逃跑。", "en": "Spotting the player, quickly running away."},
        {"zh": "盯着玩家，准备反击。", "en": "Staring at the player, ready to attack."},
        {"zh": "跃起试图抓住玩家。", "en": "Jumping to try and grab the player."},
        {"zh": "好奇地研究玩家的装备。", "en": "Curiously studying the player’s equipment."},
        {"zh": "跳起来试图攀爬玩家。", "en": "Jumping to try and climb the player."},
        {"zh": "用香蕉威胁玩家。", "en": "Threatening the player with a banana."},
        {"zh": "警惕地靠近玩家。", "en": "Approaching the player cautiously."},
        {"zh": "在玩家周围跳舞。", "en": "Dancing around the player."},
        {"zh": "试图用苹果吸引玩家。", "en": "Trying to attract the player with an apple."},
        {"zh": "你的帽子能借我戴吗？", "en": "Can I borrow your hat?"},
        {"zh": "你背包里有香蕉吧。", "en": "You've got bananas in that pack, right?"},
        {"zh": "路过的那位，抬头看看。", "en": "Hey you passing by, look up."},
        {"zh": "别走那么快嘛。", "en": "Don't walk so fast."},
        {"zh": "你的脚步声我认得。", "en": "I know your footsteps now."},
        {"zh": "我抢到你的果子了！", "en": "I snatched your fruit!"},
        {"zh": "你要不要摸我一下？", "en": "Want to pet me?"},
        {"zh": "我躲在叶子里看你。", "en": "I'm watching you from the leaves."},
        {"zh": "你手上的皮好光亮。", "en": "Your skin looks so smooth."},
        {"zh": "喂，苹果给我一个。", "en": "Hey, hand over an apple."},
        {"zh": "你笑什么，我也想笑。", "en": "What are you laughing at? Me too."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哀鸣一声", "en": "Sighs sadly"},
        {"zh": "我从树上掉下来，尾巴先着地。", "en": "I fell from the tree, tail first."},
        {"zh": "哭泣求救", "en": "Cries for help"},
        {"zh": "哀叫连连", "en": "Screams pitifully"},
        {"zh": "香蕉从手里掉了，尾巴还挂着。", "en": "My banana slipped, though my tail still holds on."},
        {"zh": "叫声微弱", "en": "Whimpers weakly"},
        {"zh": "哀嚎不止", "en": "Howls endlessly"},
        {"zh": "发出哀鸣", "en": "Sobs softly"},
        {"zh": "哀鸣连连", "en": "Sighs repeatedly"},
        {"zh": "发出痛苦叫声", "en": "Cries painfully"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手中的苹果太诱人了！", "en": "That apple looks so good!"},
        {"zh": "嘿，这是我的香蕉地盘！", "en": "This is my banana territory!"},
        {"zh": "看看这些树叶多美味！", "en": "Look at these leaves! They taste good!"},
        {"zh": "你愿意分享你的苹果吗？", "en": "Want to share your apple?"},
        {"zh": "我闻到了苹果的味道！", "en": "Smell that apple!"},
        {"zh": "香蕉是最好的！", "en": "Bananas are best!"},
        {"zh": "这些树叶很脆！", "en": "These leaves are crunchy!"},
        {"zh": "你有苹果吗？", "en": "Have some apples?"},
        {"zh": "我不喜欢和陌生人接近！", "en": "Don't get too close, stranger!"},
        {"zh": "别吓我！我怕高！", "en": "Don't scare me! I'm scared of heights!"},
        {"zh": "香蕉皮也能嚼半天。", "en": "I can chew a banana peel for ages."},
        {"zh": "苹果比树叶香多了。", "en": "Apples smell much better than leaves."},
        {"zh": "让我看看你的口袋。", "en": "Let me see your pockets."},
        {"zh": "我帮你摘，分我一半。", "en": "I'll pick them — give me half."},
        {"zh": "别藏，我都看见了。", "en": "Don't hide it. I saw everything."},
        {"zh": "给我一块，我跟你走。", "en": "One piece and I'll follow you."},
        {"zh": "唱片机一响我就跳舞。", "en": "Music plays and I dance."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "不要撞我！我会反击！", "en": "Don't bump me! I'll retaliate!"},
        {"zh": "哎呀，你撞到我了！", "en": "Ouch, you bumped me!"},
        {"zh": "小心！我反应很快！", "en": "Careful! I'm quick to react!"},
        {"zh": "别撞了，会疼的！", "en": "Stop bumping, it hurts!"},
        {"zh": "我警告你别再碰我！", "en": "Warning, don't touch me!"},
        {"zh": "我的香蕉很珍贵！", "en": "My bananas are precious!"},
        {"zh": "我从树枝上朝你龇了龇牙。", "en": "I bare my teeth at you from the branch."},
        {"zh": "我从树上给你一爪。", "en": "You get a claw swipe from the tree."},
        {"zh": "给我留点空间！", "en": "Give me some space!"},
        {"zh": "别靠近我，我会反击！", "en": "Don't get close, I'll retaliate!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到我的配偶了吗？", "en": "Found my mate?"},
