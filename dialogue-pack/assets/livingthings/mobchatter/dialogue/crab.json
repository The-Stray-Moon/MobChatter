{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "沙地里挪动着小蟹步。", "en": "Scuttles along the sand."},
        {"zh": "河水里轻松滑行。", "en": "Slides through the river."},
        {"zh": "蟹爪轻轻拍打水面。", "en": "Crabs tap the water with claws."},
        {"zh": "海浪中摇曳前行。", "en": "Wanders in the waves."},
        {"zh": "沼泽中缓慢爬行。", "en": "Creeps through the swamp."},
        {"zh": "螃蟹低语：沙沙。", "en": "Crab whispers: Sss."},
        {"zh": "蟹壳摩擦沙地，沙沙响。", "en": "Shell rubs the sand, sss."},
        {"zh": "水中挪动，发出轻微声响。", "en": "Sssly moves in water."},
        {"zh": "沙漠湖泊里缓慢游动。", "en": "Drifts in the desert lake."},
        {"zh": "蟹壳沙沙，碎裂声。", "en": "Shell cracks, sss."},
        {"zh": "横着身子跑过去", "en": "I scuttle sideways past you."},
        {"zh": "八条腿敲着石滩", "en": "Eight legs tap across the shingle."},
        {"zh": "钻进礁石的缝里", "en": "I squeeze into a crack in the rock."},
        {"zh": "退潮后出来找食", "en": "With the tide out, I come to feed."},
        {"zh": "小钳子刨开湿沙", "en": "My small claw scoops wet sand."},
        {"zh": "从沙洞边一闪而过", "en": "I dart past the mouth of my burrow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "螃蟹懒懒地躺在沙地上。", "en": "Crab lounges on the sand."},
        {"zh": "蟹壳在阳光下反射光芒。", "en": "Shell glitters in the sun."},
        {"zh": "螃蟹悠闲地翻滚。", "en": "Crab rolls leisurely."},
        {"zh": "沙地里的小小螃蟹。", "en": "Tiny crab on sand."},
        {"zh": "螃蟹静静地等待。", "en": "Crab waits quietly."},
        {"zh": "蟹壳微风吹动。", "en": "Shell sways in the breeze."},
        {"zh": "螃蟹享受着微风。", "en": "Crab enjoys the breeze."},
        {"zh": "沙滩上缓缓爬行。", "en": "Creeps on the beach."},
        {"zh": "蟹壳在风中轻轻摇摆。", "en": "Shell sways gently."},
        {"zh": "河岸边缓慢移动。", "en": "Moves slowly by the river."},
        {"zh": "吐出一串小气泡", "en": "I blow a string of little bubbles."},
        {"zh": "趴在水边打盹", "en": "I doze at the water's edge."},
        {"zh": "举着钳子晒太阳", "en": "I hold my claws up to the sun."},
        {"zh": "缩在壳里歇一会儿", "en": "I tuck in and rest a while."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "看见你，蟹眼闪烁。", "en": "Crab eyes gleam at you."},
        {"zh": "河滩的小个子，举起了双钳。", "en": "I am small on the riverbank, but both claws rise."},
        {"zh": "蟹壳下的小眼睛。", "en": "Little eyes under shell."},
        {"zh": "蟹爪准备迎接你。", "en": "Claws ready for you."},
        {"zh": "我把钳子收在胸前，盯着你。", "en": "I keep my claws close to my chest and watch you."},
        {"zh": "蟹壳反射月光。", "en": "Shell reflects moonlight."},
        {"zh": "蟹眼注视你。", "en": "Crab eyes on you."},
        {"zh": "蟹爪伸向你。", "en": "Claws reach for you."},
        {"zh": "警惕的蟹眼。", "en": "Alert crab eyes."},
        {"zh": "螃蟹瞪大眼睛。", "en": "Crab widens eyes."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "蟹壳裂了，别踩我。", "en": "My shell cracked — don't step on me."},
        {"zh": "壳角磕掉了一块，疼得缩腿。", "en": "A corner of my shell is chipped; my legs curl in pain."},
        {"zh": "被打中了，我生气！", "en": "Hit hard, I'm mad!"},
        {"zh": "我的肉疼！", "en": "My flesh hurts!"},
        {"zh": "脚受伤了，走不动了！", "en": "Foot hurt, can't walk!"},
        {"zh": "壳碎了，好痛！", "en": "Shell cracked, it hurts!"},
        {"zh": "我的螯被砸弯了，钳不紧了！", "en": "My claw is bent; I cannot pinch!"},
        {"zh": "壳裂了，我要修理！", "en": "Shell cracked, need repair!"},
        {"zh": "被踢了，疼！", "en": "Kicked, it hurts!"},
        {"zh": "被扎了，痛！", "en": "Poked, it hurts!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "看你馋样，我可是螃蟹！", "en": "You want? I'm a crab!"},
        {"zh": "不吃我，不吃我，我还有很多兄弟！", "en": "Not me, not me, I have brothers!"},
        {"zh": "来吧，来吃我，肉质鲜美！", "en": "Come on, eat me, delicious!"},
        {"zh": "我不怕你，你吃我啊！", "en": "Don't be afraid, eat me!"},
        {"zh": "看你饿成这样，就放你一马！", "en": "You're so hungry, I'll spare you!"},
        {"zh": "我这么小，不吃也行！", "en": "I'm small, you can skip me!"},
        {"zh": "你的鱼饵换我，尝尝蟹肉！", "en": "Your bait, try my crab meat!"},
        {"zh": "别走，给我留下点鱼！", "en": "Don't go, leave me some fish!"},
        {"zh": "我肉多汁，快来尝尝！", "en": "Juicy, come and taste!"},
        {"zh": "你要是不吃我，就吃这些壳！", "en": "If not me, eat these shells!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "嘿！你撞到我了！", "en": "Hey, you hit me!"},
        {"zh": "撞我干什么？我也没招！", "en": "Why hit me? I didn't do anything!"},
        {"zh": "你这个大块头，轻点！", "en": "Be careful, you big guy!"},
        {"zh": "小心点，我个子小！", "en": "Watch out, I'm small!"},
        {"zh": "你怎么不长眼睛啊？", "en": "Why can't you see?"},
        {"zh": "别动，我正睡着呢！", "en": "Don't move, I'm sleeping!"},
        {"zh": "你这撞击可真够狠的！", "en": "That was a strong hit!"},
        {"zh": "撞疼我了，你赔我壳！", "en": "Hit me hard, give me a shell!"},
        {"zh": "你这动作太粗鲁了！", "en": "That's too rough!"},
        {"zh": "别碰我，我警告你！", "en": "Don't touch me, I warn you!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找我干嘛？要交配？", "en": "What do you want? For mating?"},
        {"zh": "交配找我，我可是螃蟹！", "en": "Mating, I'm a crab!"},
        {"zh": "交配时别闹，我正忙呢！", "en": "No distractions, I'm busy!"},
        {"zh": "你真行，能和我交配？", "en": "You're good, want to mate?"},
        {"zh": "别急，等我完成交配！", "en": "Wait, I'm mating!"},
        {"zh": "交配时不要打扰我！", "en": "No interruptions, mating!"},
        {"zh": "和我交配，我能保护你！", "en": "Mate with me, I'll protect you!"},
        {"zh": "交配成功，你快走吧！", "en": "Mating done, go now!"},
        {"zh": "和我交配，你会变得强壮！", "en": "Mate with me, you'll be strong!"},
        {"zh": "快点，别耽误我的交配！", "en": "Hurry, don't delay! Mating!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "哦嘞嘞～", "en": "Crab: Oi oi oi!"},
        {"zh": "蟹壳来了！", "en": "Crab: Here comes the shell!"},
        {"zh": "抓到你啦！", "en": "Crab: Gotcha!"},
        {"zh": "鳕鱼，我的食粮！", "en": "Cod, my meal!"},
        {"zh": "栖息在这水里！", "en": "Residing in the water!"},
        {"zh": "反击时刻到了！", "en": "Time to strike back!"},
        {"zh": "这只钳子捡到的东西归我。", "en": "Whatever this claw picks up is mine."},
        {"zh": "沙滩是我的家！", "en": "Beach is my home!"},
        {"zh": "沼泽也是我的地盘！", "en": "Swamp is also my domain!"},
        {"zh": "沙漠湖泊也有我！", "en": "Desert lakes have me too!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有鳕鱼的腥味飘过来。", "en": "The smell of cod drifts over."},
        {"zh": "鳕鱼，我的猎物！", "en": "Cod, my prey!"},
        {"zh": "从河滩爬上来，鳕鱼味儿最灵。", "en": "Up from the riverbank. Cod is easy to smell."},
        {"zh": "准备捕食！", "en": "Ready to feed!"},
        {"zh": "鳕鱼，给我滚！", "en": "Cod, get out of here!"},
        {"zh": "我是猎手！", "en": "I’m the hunter!"},
        {"zh": "鳕鱼，你逃不掉！", "en": "Cod, you can’t escape!"},
        {"zh": "锁定锁定，锁定鳕鱼！", "en": "Target locked, cod!"},
        {"zh": "我是螃蟹，吃你！", "en": "I’m a crab, eating you!"},
        {"zh": "鳕鱼快跑，不然死定了！", "en": "Cod, run or die!"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
