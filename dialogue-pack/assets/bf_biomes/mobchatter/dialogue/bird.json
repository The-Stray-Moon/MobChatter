{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从枝头跳到下一根。", "en": "I hop from one branch to the next."},
        {"zh": "地上有种子，我下去。", "en": "Seeds on the ground. I'll go down."},
        {"zh": "我蹦两下，停一下。", "en": "Two hops, then a pause."},
        {"zh": "草地太软，跳着快。", "en": "The grass is soft. Hopping is faster."},
        {"zh": "我贴着树根走。", "en": "I go along the tree roots."},
        {"zh": "我的爪子抓住树皮。", "en": "My claws grip the bark."},
        {"zh": "我一边走一边低头啄。", "en": "I peck as I go."},
        {"zh": "这片林子，我熟。", "en": "I know this wood."},
        {"zh": "树叶后头有虫子。", "en": "There's a bug behind the leaf."},
        {"zh": "我跳过去，很快。", "en": "I hop over, quick."},
        {"zh": "地面上有影子掠过。", "en": "A shadow sweeps over the ground."},
        {"zh": "我走着走着就飞起来。", "en": "I walk, then take off."},
        {"zh": "我在地面啄了两下。", "en": "I peck twice at the ground."},
        {"zh": "我在低枝间穿过去。", "en": "I flit between the low branches."},
        {"zh": "那边有棵更矮的树。", "en": "There's a shorter tree over there."},
        {"zh": "我在地上跳两下，啄一口。", "en": "I hop twice on the ground and peck."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在枝上，理羽毛。", "en": "I perch and preen my feathers."},
        {"zh": "风把树叶吹得沙沙。", "en": "The wind rustles the leaves."},
        {"zh": "我歪头听了一下。", "en": "I tilt my head and listen."},
        {"zh": "这里没人打扰。", "en": "No one disturbs me here."},
        {"zh": "我缩起一只脚。", "en": "I tuck one foot up."},
        {"zh": "这阳光晒得正舒服。", "en": "The sunlight feels just right."},
        {"zh": "我把羽毛抖松了。", "en": "I ruffle my feathers loose."},
        {"zh": "林子安静得很。", "en": "The wood is very quiet."},
        {"zh": "我在等虫子自己出来。", "en": "I'm waiting for a bug to show itself."},
        {"zh": "枝头轻轻晃。", "en": "The branch sways gently."},
        {"zh": "这样待着就很舒服。", "en": "It's comfortable just staying like this."},
        {"zh": "我叫了一声，没人答。", "en": "I chirped, and no one answered."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在这儿做什么？", "en": "What are you doing standing here?"},
        {"zh": "我就在你头顶的枝上。", "en": "I'm on the branch above you."},
        {"zh": "你别爬这棵树。", "en": "Don't climb this tree."},
        {"zh": "你一靠近，我就飞。", "en": "Come closer and I'll fly off."},
        {"zh": "你手上有面包屑吗？", "en": "Are there crumbs on your hands?"},
        {"zh": "我从枝上跳到地上啄食。", "en": "I hop from branch to ground to peck."},
        {"zh": "你太大了，我不怕。", "en": "You're big, but I'm not scared."},
        {"zh": "我退到枝条末端。", "en": "I retreat to the branch tip."},
        {"zh": "你一伸手，我就走了。", "en": "One reach and I'm gone."},
        {"zh": "你抬头看我的时候，很安静。", "en": "You're quiet when you look up at me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了几根羽毛。", "en": "A few feathers fell."},
        {"zh": "别抓我的翅膀。", "en": "Don't grab my wings."},
        {"zh": "我从枝上滑了一下。", "en": "I slipped off the branch."},
        {"zh": "我缩着翅膀，叫得很急。", "en": "Wings tucked, I chirp anxiously."},
        {"zh": "我扑腾着躲开。", "en": "I fluttered away."},
        {"zh": "这点伤，飞得动。", "en": "This wound won't stop me flying."},
        {"zh": "我的羽毛乱了。", "en": "My feathers are mussed."},
        {"zh": "我从树枝上跌下来，扑腾着。", "en": "I tumble from the branch, flapping."},
        {"zh": "我缩在枝上。", "en": "I huddle on the branch."},
        {"zh": "我的羽毛乱了，站不稳。", "en": "My feathers are ruffled; I can't steady."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪头盯着你掌心的碎粒。", "en": "I tilt my head at the crumbs in your palm."},
        {"zh": "撒一点在地上。", "en": "Scatter a few on the ground."},
        {"zh": "我等你退开。", "en": "I'll wait for you to step back."},
        {"zh": "太近了，我不下去。", "en": "Too close. I won't come down."},
        {"zh": "我的手在枝上抓紧了。", "en": "My grip tightens on the branch."},
        {"zh": "这是从树上掉下来的。", "en": "This fell from the trees."},
        {"zh": "你把种子撒地上，我才下来。", "en": "Scatter the seeds on the ground and I'll come down."},
        {"zh": "你不动，我才敢过去。", "en": "Stay still, and I'll dare approach."},
        {"zh": "面包比虫子好找。", "en": "Bread is easier to find than bugs."},
        {"zh": "我跳下一格再跳一格。", "en": "I hop down one level, then another."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的指头蹭到我的尾羽。", "en": "Your finger brushed my tail feathers."},
        {"zh": "我的羽毛都乱了。", "en": "My feathers are all ruffled."},
        {"zh": "我扑腾着飞开。", "en": "I flutter away."},
        {"zh": "别用帽子扣我。", "en": "Don't drop a hat over me."},
        {"zh": "你的手指差点抓住我。", "en": "Your fingers almost caught me."},
        {"zh": "我从你肩边掠过。", "en": "I skim past your shoulder."},
        {"zh": "我落在高一点的枝上。", "en": "I land on a higher branch."},
        {"zh": "翅膀撞到树叶。", "en": "My wings hit the leaves."},
        {"zh": "我抖了抖，站稳。", "en": "I shake and steady myself."},
        {"zh": "你撞得树都晃了。", "en": "You shook the whole tree."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "树上还有一只。", "en": "There's another one in the tree."},
        {"zh": "我们对着叫了几声。", "en": "We chirped back and forth."},
        {"zh": "你别抬头看。", "en": "Don't look up."},
        {"zh": "我们一起跳到枝梢。", "en": "We hop to the branch tip together."},
        {"zh": "她在枝间穿得比我顺。", "en": "She threads the branches better than I do."},
        {"zh": "这片林子够我们住。", "en": "This wood is enough for us."},
        {"zh": "春天的时候会有小的。", "en": "In spring there'll be little ones."},
        {"zh": "你不懂我们的歌。", "en": "You don't understand our song."},
        {"zh": "我们不用你管。", "en": "We don't need your help."},
        {"zh": "就这样，林子还在。", "en": "That's fine. The wood is still here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我在地上啄了三下。", "en": "I peck the ground three times."},
        {"zh": "我用喙叼起一粒浆果。", "en": "I pick up a berry in my beak."},
        {"zh": "我拖着它跳。", "en": "I hop along dragging it."},
        {"zh": "这粒种子归我了。", "en": "This seed is mine."},
        {"zh": "亮亮的，我不喜欢。", "en": "Shiny. I don't like it."},
        {"zh": "我藏在树洞里。", "en": "I hide it in the tree hollow."},
        {"zh": "这个东西能吃吗？", "en": "Can this be eaten?"},
        {"zh": "我啄了两下。", "en": "I pecked it twice."},
        {"zh": "它滚下坡了。", "en": "It rolled down the slope."},
        {"zh": "我追着它跑。", "en": "I chase after it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "树叶下有东西在动。", "en": "Something's moving under the leaf."},
        {"zh": "那是一只虫子。", "en": "It's a bug."},
        {"zh": "我低下身子。", "en": "I lower my body."},
        {"zh": "看准了再跳。", "en": "Aim before jumping."},
        {"zh": "那边又有一只。", "en": "Another one over there."},
        {"zh": "我转了下头。", "en": "I turn my head."},
        {"zh": "泥土上有个影子。", "en": "A shadow on the dirt."},
        {"zh": "我要下去了。", "en": "I'm going down."},
        {"zh": "这次不会扑空。", "en": "I won't miss this time."},
        {"zh": "枝头一落，我先看看四周。", "en": "On a branch, I scan around first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着它在叶间跳。", "en": "I hop after it through the leaves."},
        {"zh": "它钻进叶背了。", "en": "It went to the leaf's underside."},
        {"zh": "我侧着头看。", "en": "I look sideways."},
        {"zh": "它停了一下。", "en": "It paused."},
        {"zh": "我在枝上挪了半步。", "en": "I shift half a step along the branch."},
        {"zh": "翅膀半张着，随时能走。", "en": "Wings half open, ready to go."},
        {"zh": "一下子就好了。", "en": "This will be quick."},
        {"zh": "我看得清它每条腿。", "en": "I can see every one of its legs."},
        {"zh": "风一吹，叶子翻了。", "en": "The wind flips the leaf."},
        {"zh": "我趁机跳过去。", "en": "I jump in that moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我啄了一下。", "en": "I pecked once."},
        {"zh": "虫子被我叼住了。", "en": "I caught the bug."},
        {"zh": "我的喙很小，但准。", "en": "My beak is small but precise."},
        {"zh": "它还在扭呢。", "en": "It's still wriggling."},
        {"zh": "我把虫子甩晕了。", "en": "I shook the bug senseless."},
        {"zh": "这一口，够了。", "en": "One bite is enough."},
        {"zh": "我踩了一脚。", "en": "I stepped once."},
        {"zh": "你也想抢走它？", "en": "Want to take it from me too?"},
        {"zh": "我退到枝上吃。", "en": "I retreat to the branch to eat."},
        {"zh": "你别靠太近了。", "en": "Don't come too close."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我落在你前面的枝上。", "en": "I land on the branch before you."},
        {"zh": "我从树冠跳到低处的枝。", "en": "I hop from the canopy to a lower branch."},
        {"zh": "林子里都是我的声音。", "en": "My voice fills the wood."},
        {"zh": "我从别处飞来的。", "en": "I flew here from elsewhere."},
        {"zh": "这片树叶上有露水。", "en": "There's dew on these leaves."},
        {"zh": "今天虫子多。", "en": "Plenty of bugs today."},
        {"zh": "我理了理翅膀。", "en": "I smooth my wings."},
        {"zh": "我在林子里挑了根新枝。", "en": "I pick a new branch in the woods."},
        {"zh": "你来得刚好。", "en": "You came at the right moment."},
        {"zh": "这里晒太阳正好。", "en": "Just enough sun here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，羽毛就卷了。", "en": "Fire curls my feathers."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从枝上掉下去，我半路就飞起来。", "en": "I fell off the branch and caught myself midair."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水打湿了翅膀，我飞不起来。", "en": "Wet wings. I can't fly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的窝都吹散了。", "en": "The blast scatters even my nest."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭擦过我的尾羽。", "en": "An arrow grazed my tail feathers."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光打过来，我眼睛花了。", "en": "The light hit and my eyes went blurry."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "找不到虫子，我饿了。", "en": "Can't find bugs. I'm hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声近得吓人，我缩起来。", "en": "The thunder was terrifyingly close. I shrank down."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有树枝可以站。", "en": "There's no branch to perch on here."}
      ]
    }
  }
}
