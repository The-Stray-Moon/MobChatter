{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢吞吞地划着水。", "en": "I paddle along, slow and easy."},
        {"zh": "背上的海草，摇摇摆摆。", "en": "The weed on my back sways."},
        {"zh": "藤壶蹭得我有点痒。", "en": "The barnacles itch a little."},
        {"zh": "我游过沉船的影。", "en": "I swim past a wreck's shadow."},
        {"zh": "庞大的身子，转得很慢。", "en": "Huge body, slow turns."},
        {"zh": "珊瑚在我背上开着。", "en": "Coral blooms on my back."},
        {"zh": "我的尾巴一摆，水就动。", "en": "One flick of my tail moves the water."},
        {"zh": "深海的光，从我身上过。", "en": "Deep light passes over me."},
        {"zh": "我贴着海底走。", "en": "I keep low over the seabed."},
        {"zh": "水草缠着我的鳍。", "en": "Kelp tangles my flippers."},
        {"zh": "我慢慢浮上去换气。", "en": "I rise slowly to breathe."},
        {"zh": "我的重量，水托着。", "en": "The water carries my weight."},
        {"zh": "一条鱼从我身边过。", "en": "A fish slips past me."},
        {"zh": "我在找能清理我的人。", "en": "I'm looking for someone to clean me."},
        {"zh": "背上的东西太多了。", "en": "Too much has grown on me."},
        {"zh": "游得慢，但走得很远。", "en": "Slow, but I go far."},
        {"zh": "海底的沙，软软的。", "en": "The seabed sand is soft."},
        {"zh": "我顺着洋流漂。", "en": "I drift with the current."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水里，静静地。", "en": "I hang in the water, still."},
        {"zh": "覆地苔藓盖住了我的背。", "en": "Moss covers my back."},
        {"zh": "藤壶一开一合。", "en": "The barnacles open and close."},
        {"zh": "水流过我的鳍。", "en": "Water flows past my flippers."},
        {"zh": "我在等谁来帮我。", "en": "I wait for someone to help."},
        {"zh": "海带垂在我身边。", "en": "Kelp hangs beside me."},
        {"zh": "我的呼吸，像远处的雷。", "en": "My breathing is distant thunder."},
        {"zh": "这一片海，很安静。", "en": "This part of the sea is quiet."},
        {"zh": "背上有点重。", "en": "My back feels heavy."},
        {"zh": "水面上有光。", "en": "Light on the surface above."},
        {"zh": "我没有敌意。", "en": "I mean no harm."},
        {"zh": "我慢慢合上又张开眼。", "en": "I slowly close and open my eye."},
        {"zh": "小鱼在我周围转。", "en": "Small fish circle me."},
        {"zh": "我不需要喂食。", "en": "I need no feeding."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是来清理我的吗？", "en": "Have you come to clean me?"},
        {"zh": "你手里的斧头，别乱挥。", "en": "Easy with that axe."},
        {"zh": "我这么大，你却不跑。", "en": "Big as I am, you don't flee."},
        {"zh": "我转过来，水面起浪。", "en": "I turn; the surface ripples."},
        {"zh": "你站的地方，水很浅。", "en": "The water's shallow where you stand."},
        {"zh": "我背上这些，你能弄掉吗？", "en": "Can you clear what's on my back?"},
        {"zh": "你摸摸，别怕。", "en": "Touch me; don't be afraid."},
        {"zh": "你帮我，我就记着。", "en": "Help me, and I'll remember."},
        {"zh": "我低下头，凑近些。", "en": "I lower my head to come closer."},
        {"zh": "我往前一点，你别退。", "en": "I move forward; don't back off."},
        {"zh": "这一片，都是我的路。", "en": "This whole stretch is my road."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我摆了下尾巴，退了。", "en": "One tail sweep and I pull back."},
        {"zh": "背上的东西掉了几块。", "en": "Some of my encrustation falls off."},
        {"zh": "这点伤我还扛得动。", "en": "I can still carry this wound."},
        {"zh": "我低声哼了一下。", "en": "A low sound from me."},
        {"zh": "水里都是我的血。", "en": "My blood clouds the water."},
        {"zh": "我慢慢把身子转到一边。", "en": "I slowly turn my body aside."},
        {"zh": "伤口被水冲得发凉。", "en": "Water cools the wound."},
        {"zh": "一侧的鳍不太听使唤。", "en": "One flipper won't quite obey."},
        {"zh": "别碰我的鳍。", "en": "Not my flipper."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些进不了我的嘴。", "en": "None of this goes in my mouth."},
        {"zh": "你把木板举着？我懂。", "en": "Holding planks up? I understand."},
        {"zh": "六十四块，我记住了。", "en": "Sixty-four planks — I remember."},
        {"zh": "那不是食物，是船甲。", "en": "That's not food; that's decking."},
        {"zh": "我只想要人帮忙。", "en": "I only want a helping hand."},
        {"zh": "你晃它，我没什么反应。", "en": "Wave it; I hardly react."},
        {"zh": "这点东西，我搬得动。", "en": "That much, I can carry."},
        {"zh": "我闻到的是木头的味。", "en": "I smell wood."},
        {"zh": "你放下来，我看看。", "en": "Set it down; let me see."},
        {"zh": "不吃，谢谢。", "en": "No thanks."},
        {"zh": "我喜欢船，不喜欢饭。", "en": "I like ships, not meals."},
        {"zh": "你把板子铺上，我就快了。", "en": "Lay the planks and I'll be quicker."},
        {"zh": "这一身甲，比吃的要紧。", "en": "This armor matters more than food."},
        {"zh": "你要造船，找我。", "en": "Building a ship? Come to me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我，像撞礁石。", "en": "Hitting me is hitting a reef."},
        {"zh": "我太大，避不开。", "en": "Too big to dodge."},
        {"zh": "慢慢来，我退一点。", "en": "Easy; I'll give a little room."},
        {"zh": "藤壶蹭到你了。", "en": "The barnacles scraped you."},
        {"zh": "我的鳍碰到你的船。", "en": "My flipper brushed your boat."},
        {"zh": "这点碰，我不在意。", "en": "Such a touch doesn't bother me."},
        {"zh": "水底没有多余的地方。", "en": "No spare room on the seabed."},
        {"zh": "我挪了挪，让船过。", "en": "I shift to let the boat pass."},
        {"zh": "小心，别靠太近。", "en": "Careful; not too close."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "深海里，同类很少。", "en": "Few of my kind in the deep."},
        {"zh": "我游了很久，才见到一只。", "en": "I swam far before meeting one."},
        {"zh": "我们一起浮上去换气。", "en": "We rise together to breathe."},
        {"zh": "两条大影子并排。", "en": "Two great shadows side by side."},
        {"zh": "我们互相蹭了蹭鳍。", "en": "We brush flippers."},
        {"zh": "海里没别的事可做。", "en": "There's little else to do at sea."},
        {"zh": "一起漂着，也很好。", "en": "Drifting together is enough."},
        {"zh": "这声音，是低低的歌。", "en": "This sound is a low song."},
        {"zh": "有你在，深海不空。", "en": "With you, the deep feels less empty."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用鳍夹起来。", "en": "I pinch it with a flipper."},
        {"zh": "这件东西小得可怜。", "en": "This thing is pitifully small."},
        {"zh": "掉进沙里，不好找。", "en": "Dropped in sand; hard to find."},
        {"zh": "我叼着，送到背上。", "en": "I carry it up onto my back."},
        {"zh": "帆的碎布，我用得上。", "en": "Sailcloth scraps are useful."},
        {"zh": "沉船里还有东西。", "en": "More in the wreck."},
        {"zh": "这些零件，都归你了。", "en": "These parts are yours."},
        {"zh": "我搬得动一箱。", "en": "I can shift a crate."},
        {"zh": "它卡在我壳的缝里。", "en": "It wedged in my shell's seam."},
        {"zh": "留着，以后能用。", "en": "Keep it; might serve later."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有什么靠过来了。", "en": "Something's coming near."},
        {"zh": "我抬起头，慢慢看。", "en": "I raise my head and look."},
        {"zh": "不是鱼群在动。", "en": "That's not a school moving."},
        {"zh": "我这身量，不怕。", "en": "With my bulk, I'm not afraid."},
        {"zh": "我把独眼转了过去。", "en": "I turn my single eye that way."},
        {"zh": "你想抢我的东西吗？", "en": "After my cargo?"},
        {"zh": "水里，我比你想的快。", "en": "In water I'm faster than you think."},
        {"zh": "我记住了你的船。", "en": "I've noted your boat."},
        {"zh": "别靠我背上的挂点。", "en": "Not the mounts on my back."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一点点靠过去。", "en": "I edge closer, bit by bit."},
        {"zh": "你别动，我看看。", "en": "Hold still; I'm looking."},
        {"zh": "我绕你的船一圈。", "en": "I circle your boat once."},
        {"zh": "尾巴一摆，浪就起。", "en": "One tail flick raises a wave."},
        {"zh": "我把身子沉得更低。", "en": "I sink lower still."},
        {"zh": "再近，我就撞。", "en": "Closer and I ram."},
        {"zh": "这一带，我最熟。", "en": "I know these waters best."},
        {"zh": "你退开，我当没看见。", "en": "Back off and I'll forget it."},
        {"zh": "我还给你留了余地。", "en": "I'm still giving you room."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用身体撞过去！", "en": "I slam my body into it!"},
        {"zh": "尾巴一扫，浪就翻。", "en": "One tail sweep churns the water."},
        {"zh": "鳍拍下去，水炸开。", "en": "My flipper falls; the water bursts."},
        {"zh": "我这重量，不是闹着玩的。", "en": "This weight isn't a joke."},
        {"zh": "别贴在我的身侧。", "en": "Don't cling to my flank."},
        {"zh": "藤壶比石头还糙。", "en": "Barnacles are rougher than stone."},
        {"zh": "这一下，够你退开。", "en": "That'll put you off."},
        {"zh": "再来一次也可以。", "en": "I could do it again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "海底的沙扬起来。", "en": "The seabed sand billows up."},
        {"zh": "我从深处浮上来。", "en": "I rise from the deep."},
        {"zh": "背上还挂着沉船的布。", "en": "Wreckcloth still on my back."},
        {"zh": "水面上有光，我靠近些。", "en": "Light above; I come closer."},
        {"zh": "我背上长满了东西。", "en": "My back is overgrown."},
        {"zh": "船的味道，我闻到了。", "en": "I smell a ship."},
        {"zh": "四周的鱼都散开。", "en": "The fish scatter."},
        {"zh": "我落地一样沉下去。", "en": "I settle like a stone."},
        {"zh": "别怕，我很温顺。", "en": "Don't fear; I'm gentle."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在水面上烧，烤着我的背。", "en": "Fire on the surface bakes my back."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "这么重落下去，沙都塌了。", "en": "Falling this hard caves the sand."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我本该能潜，可这水不对。", "en": "I should dive, but this water is wrong."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "水里一震，我翻了身。", "en": "The blast rolls me over."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我游不动。", "en": "That force stops my swimming."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，我的速度更慢了。", "en": "Hungry, I move even slower."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有海了，我一直往下。", "en": "No sea left; I fall."}
      ]
    }
  }
}
