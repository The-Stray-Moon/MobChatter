{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我横着走，一步一斜。", "en": "I walk sideways, step by step."},
        {"zh": "壳上有一层细纹。", "en": "There are fine lines on my shell."},
        {"zh": "我十只脚一起动。", "en": "All my legs move at once."},
        {"zh": "泥地上留下细爪印。", "en": "Thin claw prints in the mud."},
        {"zh": "我走得不快，很稳。", "en": "Not fast, but steady."},
        {"zh": "我绕开深一点的水。", "en": "I skirt the deeper water."},
        {"zh": "壳碰了一下石头，很响。", "en": "My shell knocked a stone. Loud."},
        {"zh": "我朝那块湿地走。", "en": "I head for that wet patch."},
        {"zh": "我一边走一边张着钳。", "en": "I walk with my claws open."},
        {"zh": "我走两步停一下。", "en": "Two steps, then a pause."},
        {"zh": "水边这条路我熟。", "en": "I know this path by the water."},
        {"zh": "我的钳在身前举着。", "en": "My claws stay raised in front."},
        {"zh": "我侧着身子过去。", "en": "I pass sideways."},
        {"zh": "我慢慢从缝里挤过去。", "en": "I ease through the gap."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在水边不动。", "en": "I squat by the water, still."},
        {"zh": "钳子一张一合。", "en": "My claws open and close."},
        {"zh": "壳上有点水光。", "en": "There's a sheen on my shell."},
        {"zh": "我抬起一只钳。", "en": "I lift one claw."},
        {"zh": "这里的泥里有东西。", "en": "There's something in this mud."},
        {"zh": "我站得很低。", "en": "I keep low."},
        {"zh": "壳上落了一层薄泥，看不出。", "en": "A thin layer of mud hides my shell."},
        {"zh": "我的眼睛长在柄上。", "en": "My eyes sit on stalks."},
        {"zh": "水纹把我推来推去。", "en": "The ripples nudge me about."},
        {"zh": "十只脚扣着泥，等水纹平。", "en": "Ten feet grip the mud until the ripples settle."},
        {"zh": "身上沾了一点水草。", "en": "Some weed caught on me."},
        {"zh": "我慢慢地蹭了蹭钳。", "en": "I rub one claw against the other."},
        {"zh": "这块地方很荫。", "en": "This spot is shaded."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站得离水太近了。", "en": "You're too close to the water."},
        {"zh": "我的钳子举起来了。", "en": "My claws are up."},
        {"zh": "你踩到我藏的地方了。", "en": "You stepped near where I hide."},
        {"zh": "你身上有盐味。", "en": "You smell of salt."},
        {"zh": "我看得比你多。", "en": "I see more than you do."},
        {"zh": "你退开两步。", "en": "Two steps back."},
        {"zh": "我这壳很硬。", "en": "This shell is hard."},
        {"zh": "你要抓我？试试。", "en": "Catch me? Try."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "钳断了一截，夹不住东西。", "en": "One claw tip snapped off; I cannot grip anymore."},
        {"zh": "这一下打在钳上。", "en": "That hit my claw."},
        {"zh": "我退了两步，横着。", "en": "I backed two steps sideways."},
        {"zh": "壳上掉了一小块。", "en": "A little piece chipped off."},
        {"zh": "我缩了一下。", "en": "I flinched."},
        {"zh": "我的磐壳，磕出白点。", "en": "A white chip on my stone shell."},
        {"zh": "我夹了一下空。", "en": "I snapped at nothing."},
        {"zh": "壳口渗水，我还是横着退。", "en": "Water seeps from my cracked shell; I still back away sideways."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "豆苗给我的东西，我认得。", "en": "I know what Bean Sprout gives me."},
        {"zh": "我不太吃那种东西。", "en": "I don't much eat that."},
        {"zh": "拿近一点，让我看看。", "en": "Bring it closer. Let me look."},
        {"zh": "你手别伸到我的钳边。", "en": "Not that close to my claws."},
        {"zh": "我更喜欢水里的。", "en": "I prefer what's in the water."},
        {"zh": "放地上，我过去看。", "en": "Set it down. I'll come look."},
        {"zh": "你手上在滴水吗？", "en": "Is your hand dripping?"},
        {"zh": "我不吃干的。", "en": "I don't eat dry things."},
        {"zh": "你留着吧，我走了。", "en": "Keep it. I'm off."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞到我，你碰到的是壳。", "en": "You hit shell."},
        {"zh": "我横着让了一点。", "en": "I shifted sideways a little."},
        {"zh": "你的脚踩到我的钳。", "en": "You stepped on my claw."},
        {"zh": "我们不常撞得上。", "en": "We don't often collide."},
        {"zh": "我几乎不会被打偏。", "en": "I barely get knocked aside."},
        {"zh": "壳面上留了道印。", "en": "There's a mark on the shell."},
        {"zh": "水被我们搅浑。", "en": "We muddied the water."},
        {"zh": "豆苗养大的蟹，壳上带土。", "en": "Raised by Beanstalk, my shell is earthy."},
        {"zh": "你退开时溅了泥。", "en": "Your retreat splashed mud."},
        {"zh": "我们身上都有水。", "en": "We're both wet now."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这种事在水下做。", "en": "This happens under the water."},
        {"zh": "两只钳碰了一下。", "en": "Our claws touched once."},
        {"zh": "你别站岸上看。", "en": "Don't watch from the bank."},
        {"zh": "它的壳比我的深。", "en": "Its shell is darker than mine."},
        {"zh": "我们横着贴着。", "en": "We press together sideways."},
        {"zh": "泥被我们翻起来。", "en": "We churned up the mud."},
        {"zh": "水里会有很多小的。", "en": "There'll be many small ones in the water."},
        {"zh": "分开时钳还勾着。", "en": "The claws caught as we parted."},
        {"zh": "这个动作很慢。", "en": "This motion is slow."},
        {"zh": "之后各自找石头。", "en": "Afterwards we each find a stone."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块比我还大。", "en": "This is bigger than me."},
        {"zh": "我夹得很稳。", "en": "I've got a firm grip."},
        {"zh": "我把它塞进壳下。", "en": "I tuck it under my shell."},
        {"zh": "夹太紧就碎了。", "en": "Too tight and it breaks."},
        {"zh": "水底的东西我也能拿。", "en": "I can take things off the bottom too."},
        {"zh": "我翻了翻这块泥。", "en": "I turned this clump of mud over."},
        {"zh": "这壳我留着遮身。", "en": "I'll keep this shell for cover."},
        {"zh": "我夹了一下，试试。", "en": "I test it with a pinch."},
        {"zh": "你的东西掉水里了。", "en": "You dropped it in the water."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走到水边来了。", "en": "You came to the water's edge."},
        {"zh": "水洼里多了个比石头大的影。", "en": "A shadow bigger than the stones enters my pool."},
        {"zh": "我的钳准备好了。", "en": "My claws are ready."},
        {"zh": "这一块是我的水洼。", "en": "This puddle is mine."},
        {"zh": "你踩在我的入口上。", "en": "You're standing on my entrance."},
        {"zh": "我慢慢朝你挪。", "en": "I shift slowly toward you."},
        {"zh": "你退到泥里会陷。", "en": "Step back and you'll sink in the mud."},
        {"zh": "我不快，可我夹得准。", "en": "Not fast, but I pinch accurately."},
        {"zh": "你身上的味道很近。", "en": "Your scent is very close."},
        {"zh": "我贴着地过来。", "en": "I'm coming low along the ground."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你在水边那块石头上。", "en": "You're on the rock by the water."},
        {"zh": "我的钳一直对着你。", "en": "My claws stay aimed at you."},
        {"zh": "我走得慢，可没停。", "en": "Slow, but I haven't stopped."},
        {"zh": "你换了方位。", "en": "You changed position."},
        {"zh": "这块地的水很浅。", "en": "The water here is shallow."},
        {"zh": "你退到干地就安全了。", "en": "Dry ground would be safe for you."},
        {"zh": "我从石头后面看你。", "en": "I watch from behind the stone."},
        {"zh": "你听见壳响吗？", "en": "Hear the shell clicking?"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一钳夹过去。", "en": "I snap a claw at you."},
        {"zh": "这钳能夹断骨头。", "en": "These claws can snap bone."},
        {"zh": "你被夹住了一下。", "en": "You got pinched once."},
        {"zh": "我的壳撞了你。", "en": "My shell struck you."},
        {"zh": "十只脚一起蹬。", "en": "All my legs push at once."},
        {"zh": "钳子夹住你靴子的边。", "en": "My claw catches the edge of your boot."},
        {"zh": "豆苗的壳，撞一下不疼。", "en": "The bean-sprout shell doesn't hurt to bump."},
        {"zh": "我夹着你的袖子。", "en": "I've got your sleeve."},
        {"zh": "你挣开花了点力气。", "en": "You used strength to shake free."},
        {"zh": "水被我们搅起来了。", "en": "We stirred up the water."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石头下面出来。", "en": "I come out from under the stone."},
        {"zh": "壳上还带着泥。", "en": "There's mud on my shell."},
        {"zh": "水边多了一只。", "en": "One more on the water's edge."},
        {"zh": "我用钳顶开石子。", "en": "I shoved a pebble aside with a claw."},
        {"zh": "这一片水洼是我的。", "en": "This puddle is mine."},
        {"zh": "我落地很轻。", "en": "I landed lightly."},
        {"zh": "我看了一圈四周。", "en": "I looked all around."},
        {"zh": "泥里有一个新洞。", "en": "There's a new hole in the mud."},
        {"zh": "我举起钳子试了试。", "en": "I raised my claws to test them."},
        {"zh": "水流把我的味道冲散了。", "en": "The water washes my scent away."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，壳就响。", "en": "Fire made the shell crackle."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时壳震了一下。", "en": "The shell jarred on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一下涌进来，我喘不上气。", "en": "Water rushed in and I couldn't breathe."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭钉在壳上，拔不下。", "en": "An arrow stuck in the shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我钳子发麻。", "en": "That light numbed my claws."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "水里的东西不够吃。", "en": "Not enough in the water to eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我壳上，很响。", "en": "Lightning struck my shell. Loud."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有水也没有泥。", "en": "No water, no mud in the void."}
      ]
    }
  }
}
