{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用三条腿挪动", "en": "I move on three legs"},
        {"zh": "我走起来一晃一晃", "en": "I sway as I go"},
        {"zh": "我的铁壳在地上刮", "en": "My iron shell scrapes the ground"},
        {"zh": "我朝有活物的方向走，餐盘已经打开。", "en": "I walk toward anything living; my tray is open."},
        {"zh": "我的托盘撞到石头", "en": "My tray hits a stone"},
        {"zh": "我一格一格格栅挪过去", "en": "I shuffle across, tile by tile"},
        {"zh": "我停下，转了半圈", "en": "I stop and turn half around"},
        {"zh": "我的轮子空转了一下", "en": "One of my wheels spins free"},
        {"zh": "我经过的地方草被压平", "en": "The grass flattens where I pass"},
        {"zh": "我抬起机械臂", "en": "I raise a mechanical arm"},
        {"zh": "我沿着路走，路是铺好的", "en": "I take the road; roads are laid for this"},
        {"zh": "我一拐一拐地靠近", "en": "I limp closer"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，托盘还举着", "en": "I stand with the tray still raised"},
        {"zh": "我的灯一下一下地闪", "en": "My lamp blinks on and off"},
        {"zh": "铁皮里有东西在响", "en": "Something rattles inside the tin"},
        {"zh": "我的菜单是空的", "en": "My menu is empty"},
        {"zh": "我这三条腿挪一下，铁壳在地上刮。", "en": "Three legs shift, and the iron shell scrapes ground."},
        {"zh": "我在等人来点单", "en": "I wait for someone to order"},
        {"zh": "我的关节油干了", "en": "My joints have run dry"},
        {"zh": "我抖了一下，掉下一个螺丝", "en": "I shudder and a screw drops out"},
        {"zh": "我举起托盘，又放下", "en": "I raise the tray and lower it"},
        {"zh": "我等着，我的耐心不会用完", "en": "I wait; my patience doesn't run out"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "欢迎光临本店", "en": "Welcome to our establishment"},
        {"zh": "请问你要点什么", "en": "What will you have, please"},
        {"zh": "我们只收源石", "en": "We only take originium"},
        {"zh": "你可以看看今日供应", "en": "You may look at today's offering"},
        {"zh": "我把托盘递过去", "en": "I offer the tray"},
        {"zh": "这张桌子是空的", "en": "The tray is empty"},
        {"zh": "你站在取餐口了", "en": "You're at the pickup window"},
        {"zh": "请不要碰里面的东西", "en": "Please don't touch what's inside"},
        {"zh": "上一个客人也站在这儿", "en": "The last customer stood here too"},
        {"zh": "我在这窗口站很久了", "en": "I've stood at this window a long while"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了一个零件", "en": "I've lost a part"},
        {"zh": "我晃了晃，重新平衡", "en": "I rock and rebalance"},
        {"zh": "我的灯乱闪起来", "en": "My lamp is stuttering"},
        {"zh": "铁皮上多了一个凹", "en": "A dent appears in my casing"},
        {"zh": "我发出一串杂音", "en": "I emit a burst of static"},
        {"zh": "我的机械臂垂下去", "en": "My arm droops"},
        {"zh": "我退了一点，轮子打滑", "en": "I back off and my wheels slip"},
        {"zh": "我自检了一遍", "en": "I run a self-check"},
        {"zh": "本机还在运行", "en": "This unit is still running"},
        {"zh": "请稍等，正在恢复", "en": "One moment; restoring"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你带了原料来", "en": "You've brought ingredients"},
        {"zh": "放进投料口就行", "en": "Just put it in the intake"},
        {"zh": "越新鲜的越好", "en": "The fresher the better"},
        {"zh": "这一份够做一顿", "en": "This will make one meal"},
        {"zh": "我闻不到，但我称得出", "en": "I can't smell it, but I can weigh it"},
        {"zh": "请您稍等一下", "en": "One moment, please"},
        {"zh": "机器正在处理", "en": "The machine is processing"},
        {"zh": "你的手别伸进去", "en": "Keep your hand out"},
        {"zh": "马上就好了，请等等", "en": "Almost ready; do wait"},
        {"zh": "这是您的那份", "en": "This one is yours"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我铁壳上，很响", "en": "You hit my shell and it rings"},
        {"zh": "我机身晃了两下才稳住", "en": "My chassis rocks twice before settling"},
        {"zh": "我的托盘歪了", "en": "My tray has tipped"},
        {"zh": "托盘一歪，菜汤洒了一地。", "en": "My tray tips; soup spills everywhere."},
        {"zh": "我的轮子被你踩住", "en": "You step on one of my wheels"},
        {"zh": "我发出一声电子音", "en": "I make an electronic noise"},
        {"zh": "我们一起撞到墙上", "en": "We both hit the wall"},
        {"zh": "我的盖子开了又合", "en": "My lid opens and shuts"},
        {"zh": "这机器往后退了半格", "en": "The unit retreats half a tile"},
        {"zh": "请不要推这台机器", "en": "Please don't push this unit"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "仓库里还有一台", "en": "There's another unit in the storeroom"},
        {"zh": "我们并排站着，灯一起闪", "en": "We stand side by side, lamps blinking together"},
        {"zh": "它的型号更旧", "en": "Its model is older"},
        {"zh": "我们交换了一段数据", "en": "We trade a segment of data"},
        {"zh": "它的托盘也是空的", "en": "Its tray is empty too"},
        {"zh": "我们一起举起了托盘", "en": "We raise our trays together"},
        {"zh": "电源不够两台", "en": "There's not enough power for two"},
        {"zh": "它的指示灯灭了", "en": "Its indicator has gone dark"},
        {"zh": "我继续站在这里", "en": "I go on standing here"},
        {"zh": "等待下一位客人", "en": "Waiting for the next customer"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用机械臂夹起来", "en": "I pick it up with the arm"},
        {"zh": "它太重了，我放不下", "en": "It's too heavy; I can't put it down"},
        {"zh": "我把它放进舱里", "en": "I put it in the compartment"},
        {"zh": "它滚动了一下", "en": "It rolls once"},
        {"zh": "我把它称了称", "en": "I weigh it"},
        {"zh": "这个不在菜单上", "en": "This isn't on the menu"},
        {"zh": "我用托盘把它扫到一边", "en": "I sweep it aside with the tray"},
        {"zh": "舱门夹住了它", "en": "The hatch catches it"},
        {"zh": "我留着，也许能用", "en": "I'll keep it; maybe it's useful"},
        {"zh": "请不要把它拿走", "en": "Please don't take it away"}
      ]
    },
    "target_acquire": {
