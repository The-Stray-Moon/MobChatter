{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "晶壳在地上拖出细响", "en": "My crystal shell rasps on the ground."},
        {"zh": "我一段一段往前挪", "en": "I creep forward, segment by segment."},
        {"zh": "沙地上留一道浅沟", "en": "A shallow groove marks the sand."},
        {"zh": "我在碎石间穿行", "en": "I work between the loose stones."},
        {"zh": "我爬几步就停一停", "en": "A few paces, then a pause."},
        {"zh": "外壳上落满尘土", "en": "Dust settles on my shell."},
        {"zh": "我绕着源石矿走", "en": "I circle the originium deposits."},
        {"zh": "我身上的晶体在响", "en": "The crystals on me chime."},
        {"zh": "我钻进沙里，又出来", "en": "I burrow down, then surface."},
        {"zh": "这片荒原够我爬一天", "en": "This waste gives me a day's crawling."},
        {"zh": "我挪得慢，但不迷路", "en": "Slow, but I don't lose my way."},
        {"zh": "我一路蹭着石头过去", "en": "I scrape past the rocks the whole way."},
        {"zh": "头顶的日头很烤", "en": "The sun overhead is scorching."},
        {"zh": "我翻过一道矮石坎", "en": "I clamber over a low stone lip."},
        {"zh": "尾巴最后才跟上", "en": "My tail is the last to follow."},
        {"zh": "壳底磨得发热", "en": "My shell's underside grows warm."},
        {"zh": "我爬过一片碎晶地", "en": "I crawl over a field of crystal shards."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在沙上面", "en": "I lie low on the sand."},
        {"zh": "晶壳亮了一下", "en": "My crystal shell glints."},
        {"zh": "我在等什么过来", "en": "I wait for something to come."},
        {"zh": "风把沙吹过我背上", "en": "Wind blows sand over my back."},
        {"zh": "我不太喜欢动", "en": "I don't move much."},
        {"zh": "我的节片轻轻张合", "en": "My segments flex gently."},
        {"zh": "原石的味道很近", "en": "The originium scent is close."},
        {"zh": "我抬起身，晶棱响了一下。", "en": "I raise myself up and my crystal ridges click."},
        {"zh": "地上的影子很短", "en": "My shadow is short."},
        {"zh": "这里没什么可吃的", "en": "There's little to eat here."},
        {"zh": "我把自己埋了半截", "en": "I've buried half of myself."},
        {"zh": "有脚步声传来", "en": "Footsteps approach."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的沙了", "en": "You're stepping on my sand."},
        {"zh": "你带着铁块吗", "en": "Are you carrying iron?"},
        {"zh": "我认得人的味道", "en": "I know the smell of people."},
        {"zh": "你的脚离开我远点", "en": "Keep your feet off me."},
        {"zh": "我的晶壳会划人", "en": "My crystal shell cuts."},
        {"zh": "你打算怎么处置我", "en": "What do you plan to do with me?"},
        {"zh": "我不会主动惹人", "en": "I don't start trouble."},
        {"zh": "这片荒原只有我一个", "en": "I'm alone on this waste."},
        {"zh": "你走你的，我爬我的", "en": "You walk yours; I crawl mine."},
        {"zh": "你看我的壳做什么", "en": "Why look at my shell?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳裂开了", "en": "My shell cracked."},
        {"zh": "这一下打断了我的节片", "en": "That cracked my segments."},
        {"zh": "我把身体卷紧了", "en": "I coil up tight."},
        {"zh": "我已经退不动了", "en": "I can't retreat."},
        {"zh": "晶棱掉了一块", "en": "A crystal edge broke off."},
        {"zh": "疼得我直发抖", "en": "The pain makes me quiver."},
        {"zh": "我慢，躲不开", "en": "I'm slow; I can't dodge."},
        {"zh": "别用鞋底碾我", "en": "Don't grind with your boot."},
        {"zh": "沙都钻进伤口了", "en": "Sand gets into the wound."},
        {"zh": "沙里我还能爬", "en": "I can still crawl in sand."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "铁，快给我铁", "en": "Iron. Give me iron."},
        {"zh": "你手里亮亮的", "en": "That glints in your hand."},
        {"zh": "喂我铁，我会更强", "en": "Feed me iron and I'll grow strong."},
        {"zh": "我不吃那些沙子", "en": "I don't eat sand."},
        {"zh": "那并不是铁块", "en": "That isn't iron."},
        {"zh": "你举得太远了", "en": "You're holding it too far."},
        {"zh": "我闻到金属味", "en": "I smell metal."},
        {"zh": "这个我正想要", "en": "I want this one."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你顶到我的壳了", "en": "You nudged my shell."},
        {"zh": "我退不了那么快", "en": "I can't retreat that fast."},
        {"zh": "我的节片被挤了", "en": "My segments got squeezed."},
        {"zh": "这一下撞疼了壳", "en": "That jolted my shell."},
        {"zh": "我们都慢，撞得很实", "en": "We're both slow; the bump landed hard."},
        {"zh": "让一让，我要转个方向", "en": "Let me through; I need to turn."},
        {"zh": "沙子都陷下去了", "en": "The sand gave way."},
        {"zh": "我的壳上多了道白痕", "en": "A white scratch on my shell."},
        {"zh": "别推着我走路", "en": "Don't push me."},
        {"zh": "这地方太窄了", "en": "This spot is too narrow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只认铁，不认这个", "en": "I know iron, not that."},
        {"zh": "源石虫也能繁殖，但我没兴趣", "en": "Oriworms breed, but I'm not interested."},
        {"zh": "你另找一条虫", "en": "Find another worm."},
        {"zh": "我连翻身都费劲", "en": "I can barely turn over."},
        {"zh": "这事跟荒原无关", "en": "That has nothing to do with the waste."},
        {"zh": "我更喜欢沙子", "en": "I prefer sand."},
        {"zh": "荒原上不谈这些", "en": "Not on this waste."},
        {"zh": "我懒得挪这身子", "en": "I won't shift this body."},
        {"zh": "这不在我的日程里", "en": "It's not on my schedule."},
        {"zh": "离开我的沙地", "en": "Leave my sand."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "别抓我的甲壳", "en": "Don't grab my shell."},
        {"zh": "沉得吓你一跳", "en": "I'm heavier than you'd guess."},
        {"zh": "晶棱会割伤你", "en": "The crystal edges will cut you."},
        {"zh": "把我搁回沙上", "en": "Set me back on the sand."},
        {"zh": "这样我蜷不起来", "en": "I can't curl up like this."},
        {"zh": "你手指别伸进节缝", "en": "Keep your fingers out of my joints."},
        {"zh": "我身下全是沙", "en": "Sand covers my underside."},
        {"zh": "你的手指在打颤", "en": "Your fingers are trembling."},
        {"zh": "我就这样被拎着？", "en": "I'm being carried like this?"},
        {"zh": "放回沙里就行", "en": "Just put me back in the sand."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经踩到我", "en": "You stepped on me."},
        {"zh": "我身上的尘，是坏的。", "en": "The dust on me is foul."},
        {"zh": "壳比你想的硬", "en": "My shell is harder than you think."},
        {"zh": "你是想抓住我", "en": "You want to catch me."},
        {"zh": "我会狠狠咬你", "en": "I'll bite you."},
        {"zh": "这片沙是我的", "en": "This sand is mine."},
        {"zh": "退到沙丘那边", "en": "Get beyond the dune."},
        {"zh": "壳里存着这一句", "en": "My shell holds one warning."},
        {"zh": "你再靠近一步", "en": "One more step."},
        {"zh": "你的影子落在我身上了", "en": "Your shadow fell on me."},
        {"zh": "这片地上我说了算", "en": "On this ground, I decide."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的节片绷紧了", "en": "My segments have tightened."},
        {"zh": "沙下也藏得住我", "en": "I can hide under the sand too."},
        {"zh": "你踩下去就知道了", "en": "Step down and you'll see."},
        {"zh": "我离你不到一步", "en": "I'm less than a step away."},
        {"zh": "手别往我这边伸", "en": "Keep that hand away."},
        {"zh": "就这样子别动", "en": "Just like this."},
        {"zh": "我该动一动了", "en": "Time to move."},
        {"zh": "我在绕到你的脚后", "en": "I'm circling behind your feet."},
        {"zh": "沙里有我的同族", "en": "My kind are in the sand."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "咬住你的脚跟", "en": "I bite your heel."},
        {"zh": "我用甲壳撞你", "en": "Shell strike."},
        {"zh": "晶棱一起划过来", "en": "The crystal edges come with it."},
        {"zh": "快给我滚开去", "en": "Roll away from me."},
        {"zh": "我只会这一下", "en": "This is all I have."},
        {"zh": "你手上有血了", "en": "There's blood on your hand."},
        {"zh": "别踩第二下脚", "en": "Don't step twice."},
        {"zh": "我还没使劲呢", "en": "I haven't tried yet."},
        {"zh": "这样子够了吗", "en": "Enough?"},
        {"zh": "再碰我试试看", "en": "Touch me again and see."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "晶壳还带着土", "en": "My crystal shell is still earthy."},
        {"zh": "荒原上又多了一条", "en": "One more on the waste."},
        {"zh": "日头照在我的节片上", "en": "Sun on my segments."},
        {"zh": "我闻到源石的味道", "en": "I smell originium."},
        {"zh": "这附近没什么可吃的", "en": "Nothing much to eat around here."},
        {"zh": "我先蜷成一团", "en": "I'll curl up first."},
        {"zh": "风把沙吹成一片", "en": "Wind flattens the sand."},
        {"zh": "我把节片一节节撑开", "en": "I spread my segments out."},
        {"zh": "有人来过这里", "en": "Someone's been here."},
        {"zh": "我还得再爬一段", "en": "I've more crawling to do."},
        {"zh": "沙底下比上面凉", "en": "It's cooler under the sand."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我的晶壳发烫", "en": "The fire heats my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从石头上摔下来，壳响了", "en": "I fell off the rock and my shell rang."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进节片缝里", "en": "Water gets between my segments."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我翻了个面", "en": "The blast flipped me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进我的壳缝", "en": "That stuck in my shell's seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术把我的节片定住了", "en": "The spell locked my segments."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这荒原上找不到铁", "en": "There's no iron on this waste."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在沙上，热得烫人", "en": "The bolt struck sand and left it hot."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空把我整条往下吸", "en": "The void pulls me down whole."}
      ]
    }
  }
