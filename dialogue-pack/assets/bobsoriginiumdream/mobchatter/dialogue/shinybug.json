{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "晶甲一片片翻动", "en": "My crystal plates shift, one by one."},
        {"zh": "我压过碎石，石头都碎了", "en": "Stones crack under me."},
        {"zh": "我走得慢，因为太重", "en": "Slow, because I'm heavy."},
        {"zh": "我身上泛着斑斓的光", "en": "I glisten with mottled light."},
        {"zh": "节足敲在地上，一下一下", "en": "My legs tap the ground, tick by tick."},
        {"zh": "我让甲壳碾过地面，朝你移动。", "en": "I grind my shell over the ground toward you."},
        {"zh": "我的壳比铁还硬", "en": "My shell is harder than iron."},
        {"zh": "每走一段就停住听", "en": "Every short stretch, I stop and listen."},
        {"zh": "光在我的甲片上流动", "en": "Light runs across my plates."},
        {"zh": "我横着碾过去", "en": "I grind straight through."},
        {"zh": "地面被我压出浅坑", "en": "My passage leaves shallow pits."},
        {"zh": "我从来都不绕路", "en": "I never go around."},
        {"zh": "身后拖着一条碎石的痕", "en": "A trail of rubble follows me."},
        {"zh": "我的节片像磨盘", "en": "My segments turn like millstones."},
        {"zh": "我在源石丛边停了一下", "en": "I pause by the originium growths."},
        {"zh": "我一步一步拖过碎石。", "en": "I drag myself over the gravel, step by step."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立在原处，一动不动", "en": "I stand still, unmoving."},
        {"zh": "晶甲上落了一层灰", "en": "Dust settles on my plates."},
        {"zh": "我的节缝里有光", "en": "Light glows in my seams."},
        {"zh": "我伏在石上，动也不动。", "en": "I lie on the stone without moving."},
        {"zh": "这附近没什么能伤我", "en": "Little here can hurt me."},
        {"zh": "我的触须扫过空气，找你的热。", "en": "My antennae sweep the air for your heat."},
        {"zh": "地面在我脚下微颤", "en": "The ground trembles under me."},
        {"zh": "我听见远处的脚步", "en": "I hear footsteps far off."},
        {"zh": "我的甲片互相摩擦", "en": "My plates grind against each other."},
        {"zh": "源石的味道越来越浓", "en": "The originium scent thickens."},
        {"zh": "我用不着着急", "en": "I needn't hurry."},
        {"zh": "这具身体能撑很久", "en": "This body lasts a long time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡在我前面", "en": "You're in front of me."},
        {"zh": "我看不出你有多大威胁", "en": "I can't see you as much of a threat."},
        {"zh": "你手里的东西太细了", "en": "That in your hand is too thin."},
        {"zh": "我这么高，你抬头看", "en": "I'm this tall; look up."},
        {"zh": "我的地盘，你连闻都不配。", "en": "My ground; you are not even fit to smell it."},
        {"zh": "你的心跳太吵", "en": "Your heartbeat is loud."},
        {"zh": "我从你身上闻到铁", "en": "I smell iron on you."},
        {"zh": "你打算怎么对付我", "en": "How do you intend to handle me?"},
        {"zh": "我的甲片能挡下你的武器", "en": "My plates will stop your weapon."},
        {"zh": "我看得出，你连呼吸都不敢放大。", "en": "I can tell you do not even dare breathe loudly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲片上裂了一道", "en": "A crack in my plate."},
        {"zh": "甲片震得发麻", "en": "My plates are ringing numb."},
        {"zh": "我退了一整步", "en": "I gave a whole step."},
        {"zh": "你找到了甲缝", "en": "You found a seam."},
        {"zh": "疼，但不算什么", "en": "It hurts, but it's nothing."},
        {"zh": "我的节片响了一声", "en": "My segments clacked."},
        {"zh": "这一击值得记", "en": "That blow is worth noting."},
        {"zh": "壳裂了一线，我更快了。", "en": "A crack splits my shell, and I get faster."},
        {"zh": "来，接着继续", "en": "Come, continue."},
        {"zh": "你比我想的能打", "en": "You fight better than I thought."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "铁，我闻到铁", "en": "Iron. I smell iron."},
        {"zh": "那东西太小了", "en": "That's too small."},
        {"zh": "喂我，我会更强", "en": "Feed me and I grow stronger."},
        {"zh": "你把它举高点", "en": "Hold it higher."},
        {"zh": "那点分量不够", "en": "That's not enough."},
        {"zh": "拿东西喂我？想得美。", "en": "Feed me? Not a chance."},
        {"zh": "我不吃活的东西", "en": "I don't eat living things."},
        {"zh": "给我，我就走", "en": "Give it and I'll leave."},
        {"zh": "你举多久，我就看多久。", "en": "Hold it as long as you like; I will watch."},
        {"zh": "先扔过来看看", "en": "Throw it over first."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳把剑弹到一边。", "en": "My shell knocks the blade aside."},
        {"zh": "我一步都没有动", "en": "I didn't shift an inch."},
        {"zh": "我的甲壳把你弹开了。", "en": "My shell bounces you off."},
        {"zh": "我的壳不是墙，比墙硬", "en": "Not a wall, harder than one."},
        {"zh": "这下你的手该麻了", "en": "Your arm should be numb."},
        {"zh": "碎石都被震起来", "en": "Rubble jumped up."},
        {"zh": "这地方归我，你让路。", "en": "This ground is mine, so step aside."},
        {"zh": "你没受伤算运气好", "en": "Lucky you weren't hurt."},
        {"zh": "我懒得搭理你", "en": "I can't be bothered with you."},
        {"zh": "这一撞，我记住了", "en": "I'll remember that bump."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是被造出来的东西", "en": "I was made, not born."},
        {"zh": "这种问题没有意义", "en": "That question means nothing."},
        {"zh": "你去找别的人吧", "en": "Find someone else."},
        {"zh": "我的任务不是这个", "en": "That isn't my purpose."},
        {"zh": "我只在意源石", "en": "I care only for originium."},
        {"zh": "别浪费我时间", "en": "Don't waste my time."},
        {"zh": "我这身壳，容不下第二个。", "en": "This shell of mine has room for no second one."},
        {"zh": "这句我不回答", "en": "I won't answer that."},
        {"zh": "你快点走开去", "en": "Go away."},
        {"zh": "晶壳不谈这个", "en": "A crystal shell doesn't talk of that."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬得动我？", "en": "You think you can lift me?"},
        {"zh": "我的甲片会割你", "en": "My plates will cut you."},
        {"zh": "我一动你就拿不住", "en": "One shift from me and you'll drop me."},
        {"zh": "把我从背上卸下", "en": "Get me off your back."},
        {"zh": "我比石头还重", "en": "I'm heavier than stone."},
        {"zh": "你的腰会断掉", "en": "Your back will give out."},
        {"zh": "这不是你该做的事", "en": "This isn't yours to do."},
        {"zh": "把手指松开吧", "en": "Let go."},
        {"zh": "我不喜欢被搬动", "en": "I dislike being moved."},
        {"zh": "你撑不了三步", "en": "You won't make three steps."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经靠得够近", "en": "You've come close enough."},
        {"zh": "我斑斓的壳上，眼睛都朝你。", "en": "Every eye on my bright shell turns to you."},
        {"zh": "你身上有铁味", "en": "You smell of iron."},
        {"zh": "你要挡我的路", "en": "You mean to block me."},
        {"zh": "那我就碾过去", "en": "Then I roll over you."},
        {"zh": "我的甲片已经展开", "en": "My plates have opened."},
        {"zh": "你退了也没有用", "en": "Retreating won't help."},
        {"zh": "我很少主动出手", "en": "I rarely strike first."},
        {"zh": "但今天是个例外", "en": "But today is an exception."},
        {"zh": "站到那儿别动", "en": "Stand where you are."},
        {"zh": "跑吧，我数到三。", "en": "Run. I will count to three."},
        {"zh": "数到三我就压过去", "en": "At three I grind forward."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我离你不到三步", "en": "I'm less than three steps away."},
        {"zh": "你的武器伤不到甲缝", "en": "Your weapon won't find my seams."},
        {"zh": "你每迈一步，我记一次。", "en": "Each step you take, I mark it."},
        {"zh": "石头挡不住我的触须。", "en": "Stone will not stop my antennae."},
        {"zh": "我压过的地方都是平的", "en": "Everything I pass is flattened."},
        {"zh": "我的甲片朝着你", "en": "My plates face you."},
        {"zh": "你越快，我越稳", "en": "The faster you move, the steadier I am."},
        {"zh": "地面在我脚下响", "en": "The ground sounds under me."},
        {"zh": "你身上的铁在引我", "en": "The iron on you draws me."},
        {"zh": "就这一下而已", "en": "This one."},
        {"zh": "我的甲片在光里发亮", "en": "My plates shine in the light."},
        {"zh": "你身后是矿脉，没有退路", "en": "The vein's behind you; no way back."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我就直接碾过去", "en": "Crushed."},
        {"zh": "甲片翻开，砸下去", "en": "Plates open and slam down."},
        {"zh": "这一下比石头重", "en": "That was heavier than stone."},
        {"zh": "你的护甲挡不住", "en": "Your armor won't hold."},
        {"zh": "你退得还算快", "en": "You retreated fast enough."},
        {"zh": "我都没用上力", "en": "I wasn't even trying."},
        {"zh": "再压你第二遍", "en": "I grind you a second time."},
        {"zh": "你脚下的地不平了", "en": "The ground under you is uneven now."},
        {"zh": "这一下带晶棱", "en": "That one carried crystal edges."},
        {"zh": "这样子就够了", "en": "Enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从矿脉里爬出来", "en": "I climb out of the vein."},
        {"zh": "晶甲还带着源石的色", "en": "My plates still bear originium's hue."},
        {"zh": "这片地被我压平了", "en": "I flattened this ground."},
        {"zh": "我抬起头，看见天", "en": "I raise my head and see sky."},
        {"zh": "谁在附近转悠", "en": "Who's nearby?"},
        {"zh": "我的节片咔嚓作响", "en": "My segments click."},
        {"zh": "源石在我体内流动", "en": "Originium moves in me."},
        {"zh": "我很重，落地有声", "en": "I'm heavy; my landing makes noise."},
        {"zh": "这地方归我巡", "en": "This place is mine to patrol."},
        {"zh": "我从源石缝里挤出来。", "en": "I squeeze out of the originium fissure."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我的甲片变色", "en": "The heat discolored my plates."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时甲片散了一下", "en": "My plates loosened on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进甲缝里", "en": "Water gets into my seams."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击掀翻了两片甲", "en": "The blast tore two plates loose."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西撞在甲上就弯了", "en": "That bent against my plates."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术在里面乱窜", "en": "The spell runs wild inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "源石不够，我慢下来了", "en": "Not enough originium; I'm slowing."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着晶甲走遍了全身", "en": "The bolt ran through every plate."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空连我的重量都吞了", "en": "The void swallows even my weight."}
      ]
    }
  }
}
