    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你竟敢来碰我", "en": "You dare touch me."},
        {"zh": "我的手会抓住你", "en": "My legs will seize you."},
        {"zh": "从我甲上松手", "en": "Let go of my plates."},
        {"zh": "你抬得动才怪", "en": "As if you could lift me."},
        {"zh": "我的甲片会夹住你", "en": "My plates will clamp you."},
        {"zh": "这东西硌得我甲疼。", "en": "This thing digs into my shell."},
        {"zh": "我现在就想动手", "en": "I want to strike right now."},
        {"zh": "你抓错了东西", "en": "You've grabbed the wrong thing."},
        {"zh": "指头会被夹断", "en": "Your fingers will be crushed."},
        {"zh": "再使点劲试试", "en": "Pull harder; try it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "总算逮到你了", "en": "I've caught you at last."},
        {"zh": "我一直在等着", "en": "I've been waiting."},
        {"zh": "你根本跑不了", "en": "You can't run."},
        {"zh": "我要把你碾平", "en": "I'll flatten you."},
        {"zh": "这一下不会轻", "en": "This won't be light."},
        {"zh": "我的甲全开了", "en": "Every plate is open."},
        {"zh": "地上不会有你的痕迹", "en": "Nothing of you will remain on the ground."},
        {"zh": "别大声地喊叫", "en": "Don't shout."},
        {"zh": "我不会听你的", "en": "I won't listen."},
        {"zh": "你退到哪儿都是这片地", "en": "Withdraw where you like; it's all my ground."},
        {"zh": "这一战现在开", "en": "This fight starts now."},
        {"zh": "三下之内结束", "en": "Done within three blows."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在压缩距离", "en": "I'm closing the distance."},
        {"zh": "你的武器挡不住全部", "en": "Your weapon can't cover everything."},
        {"zh": "我看住你的膝盖", "en": "I've got your knees marked."},
        {"zh": "你每退一步，我就快一分", "en": "Each step you retreat, I speed up."},
        {"zh": "甲片擦出的声音在逼近", "en": "The scraping plates draw nearer."},
        {"zh": "你身后已经没地方了", "en": "There's nowhere left behind you."},
        {"zh": "这一片地都是我的", "en": "All this ground is mine."},
        {"zh": "你再抬一次手我看看", "en": "Raise that hand once more."},
        {"zh": "我的节缝越来越烫", "en": "My seams grow hot."},
        {"zh": "就这一击而已", "en": "This one."},
        {"zh": "眼珠子给我睁着", "en": "Keep those eyes open."}
