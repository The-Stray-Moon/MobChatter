{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的晶甲张开了", "en": "My crystal plates are spread wide."},
        {"zh": "我每一步都在震地", "en": "Every step rattles the ground."},
        {"zh": "节足乱踏，停不下来", "en": "My legs stamp and won't stop."},
        {"zh": "我冲着动静去", "en": "I lunge at every sound."},
        {"zh": "甲片撞在一起，响得刺耳", "en": "My plates clash, sharp and loud."},
        {"zh": "我身上的光变得刺眼", "en": "My sheen has turned harsh."},
        {"zh": "我不绕路，直接撞开", "en": "I don't go around; I smash through."},
        {"zh": "我碾过碎石，石头全碎", "en": "I roll over rubble and powder it."},
        {"zh": "我走得太急，撞上石头", "en": "Too fast; I struck a rock."},
        {"zh": "我朝你的方向压过来", "en": "I bear down toward you."},
        {"zh": "节缝里透出红的光", "en": "Red light leaks from my seams."},
        {"zh": "我身后留下一地碎渣", "en": "Debris litters my path."},
        {"zh": "我抖了抖甲片上的灰", "en": "I shake the dust from my plates."},
        {"zh": "我的速度比平时快", "en": "I'm quicker than before."},
        {"zh": "我压得地面下陷", "en": "The ground sinks under me."},
        {"zh": "我一停，石头都还在滚", "en": "When I stop, the stones still roll."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在原地打转", "en": "I turn in place."},
        {"zh": "我的节片不停开合", "en": "My segments keep snapping open."},
        {"zh": "我的喘息很重", "en": "My breathing is heavy."},
        {"zh": "谁都别靠过来", "en": "No one come near."},
        {"zh": "我在找刚才的声音", "en": "I'm hunting that noise."},
        {"zh": "甲上有一道新裂", "en": "There's a fresh crack in my plate."},
        {"zh": "我的光一闪一闪", "en": "My glow pulses."},
        {"zh": "地上都是我的足印", "en": "My prints cover the ground."},
        {"zh": "我正在气头上", "en": "I'm in a fury."},
        {"zh": "别拿眼睛看我", "en": "Don't look at me."},
        {"zh": "我没有停下来的意思", "en": "I've no intention of settling."},
        {"zh": "再近一点试试", "en": "Try coming closer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "就是你了没错", "en": "You're the one."},
        {"zh": "你站那儿别动", "en": "Stand there and don't move."},
        {"zh": "你身上全是铁味", "en": "You reek of iron."},
        {"zh": "你站的地方，我盯死了。", "en": "I have your spot locked in my sight."},
        {"zh": "你觉得自己跑得掉", "en": "Think you can run?"},
        {"zh": "我不想听你说话", "en": "I don't want to hear you."},
        {"zh": "我的手已经在抖", "en": "My legs are already twitching."},
        {"zh": "你手里那点东西不够看", "en": "That toy in your hand is nothing."},
        {"zh": "让我看看你能挨几下", "en": "Let's see how many blows you take."},
        {"zh": "你这张脸我记住了", "en": "I'll remember that face."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你竟敢对我动手", "en": "You dare strike me."},
        {"zh": "甲裂了，我不在乎", "en": "A cracked plate; I don't care."},
        {"zh": "这一下只让我更气", "en": "That only made me angrier."},
        {"zh": "你摸准了甲缝", "en": "You found a plate seam."},
        {"zh": "疼得我眼发花", "en": "The pain blurs my sight."},
        {"zh": "我还站着没倒", "en": "I'm still standing."},
        {"zh": "这一拳我记下了", "en": "I've noted that blow."},
        {"zh": "我的节片在响", "en": "My segments are rattling."},
        {"zh": "你今天玩完了", "en": "You're finished today."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "铁？现在不是时候", "en": "Iron? Not now."},
        {"zh": "我现在只想砸东西", "en": "I only want to smash things."},
        {"zh": "别拿那玩意来", "en": "Don't bring that here."},
        {"zh": "扔掉了也没用", "en": "Throwing it won't help."},
        {"zh": "我什么都不要", "en": "I want nothing."},
        {"zh": "你举得再高我也不看", "en": "Lift it higher; I still won't look."},
        {"zh": "我已经不需要喂食", "en": "I no longer need feeding."},
        {"zh": "拿走，别挡我眼", "en": "Take it away from my sight."},
        {"zh": "我现在只想找个人", "en": "All I want now is someone."},
        {"zh": "食物换不来我的平静", "en": "Food won't calm me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我了，正好", "en": "You bumped me. Perfect."},
        {"zh": "我一点都没退", "en": "I didn't give an inch."},
        {"zh": "这下轮到你了", "en": "Now it's your turn."},
        {"zh": "我的甲硬得离谱", "en": "My plates are absurdly hard."},
        {"zh": "你的骨头响了吧", "en": "Did your bones crack?"},
        {"zh": "这可不是意外", "en": "This was no accident."},
        {"zh": "我正愁没处发火", "en": "I was looking for somewhere to put this anger."},
        {"zh": "你退开也晚了", "en": "Too late to step back."},
        {"zh": "这一撞只是开头", "en": "That was only the beginning."},
        {"zh": "那就再撞一次", "en": "Then collide once more."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我现在没那个心思", "en": "I'm in no mood for that."},
        {"zh": "别在这时候说", "en": "Not now."},
        {"zh": "我只想打碎点什么", "en": "I only want to break something."},
        {"zh": "你给我走远点", "en": "Stay away from me."},
        {"zh": "这种事我不懂", "en": "I don't understand such things."},
        {"zh": "我一点没耐心", "en": "I have no patience."},
        {"zh": "再说我就动手", "en": "Say more and I'll strike."},
        {"zh": "把你的嘴闭上", "en": "Be quiet."},
