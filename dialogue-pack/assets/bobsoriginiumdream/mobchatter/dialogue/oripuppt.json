{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用关节走路", "en": "I walk on joints."},
        {"zh": "源石沙漠的风磨着我", "en": "The oridesert wind scours me."},
        {"zh": "我每一步都很僵", "en": "Every step is stiff."},
        {"zh": "我的形状不太像活物", "en": "My shape is not quite that of a living thing."},
        {"zh": "我朝有动静的方向走", "en": "I move toward any motion."},
        {"zh": "我的脚陷进沙里", "en": "My feet sink into the sand."},
        {"zh": "我不停地调整步子", "en": "I keep adjusting my gait."},
        {"zh": "我的部件在互相摩擦", "en": "My parts grind together."},
        {"zh": "沙粒灌进我的缝", "en": "Sand fills my seams."},
        {"zh": "我朝你直直走来", "en": "I come straight at you."},
        {"zh": "我不绕开石头", "en": "I do not go around stones."},
        {"zh": "我走得像被谁推着", "en": "I move as if pushed."},
        {"zh": "我的影子是规矩的", "en": "My shadow is very regular."},
        {"zh": "我经过的地方留着印", "en": "I leave prints where I pass."},
        {"zh": "我的步幅总是一样", "en": "My stride never varies."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着一点不动", "en": "I stand without moving an inch."},
        {"zh": "我的部件在轻轻响", "en": "My parts tick softly."},
        {"zh": "我对着一个方向发呆", "en": "I stare at nothing in one direction."},
        {"zh": "风把我的表面磨亮", "en": "The wind polishes my surface."},
        {"zh": "我的头转得很慢", "en": "My head turns slowly."},
        {"zh": "我等一个走进范围的东西", "en": "I wait for something to enter range."},
        {"zh": "我身上有新的裂纹", "en": "There are new cracks on me."},
        {"zh": "我不知道自己为什么站着", "en": "I do not know why I stand."},
        {"zh": "沙在我脚边堆起来", "en": "Sand piles at my feet."},
        {"zh": "我像一块被立起来的石头", "en": "I look like a stone set upright."},
        {"zh": "我的关节卡在一个角度", "en": "My joint locked at an angle."},
        {"zh": "我在听沙的声音", "en": "I listen to the sand."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我视线里", "en": "You are in my line of sight."},
        {"zh": "我没有眼睛，也看得见", "en": "I have no eyes, yet I see."},
        {"zh": "你身上散着热", "en": "You are giving off heat."},
        {"zh": "我朝你转了半圈", "en": "I turned half a circle toward you."},
        {"zh": "你走近的时候我醒了", "en": "I woke when you came near."},
        {"zh": "我把你的坐标记下了", "en": "I have logged your coordinates."},
        {"zh": "你退后，我也看着", "en": "Back away; I still watch."},
        {"zh": "我的脸不太会动", "en": "My face does not move well."},
        {"zh": "你手里的东西在发光", "en": "What you hold is glowing."},
        {"zh": "你站在原地太久了", "en": "You have stood in one spot too long."},
        {"zh": "你走两步，我跟着转", "en": "You take two steps; I turn with you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上掉了一块", "en": "A piece of me broke off."},
        {"zh": "我的裂纹变长了", "en": "My crack lengthened."},
        {"zh": "我根本没有痛觉", "en": "I have no sense of pain at all."},
        {"zh": "我错开了半步", "en": "I offset by half a step."},
        {"zh": "我的动作慢了下来", "en": "My motions slowed."},
        {"zh": "你打坏了我的关节", "en": "You damaged my joint."},
        {"zh": "我还在继续运转", "en": "I am still running."},
        {"zh": "这一下没有让我停下", "en": "That did not stop me."},
        {"zh": "我的表面凹了", "en": "My surface dented."},
        {"zh": "我接着往下执行", "en": "I carry on executing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不摄取食物", "en": "I take in no food."},
        {"zh": "沙里没有我要的", "en": "There is nothing I want in the sand."},
        {"zh": "你举多久我都站着", "en": "Hold it as long as you like; I will not move."},
        {"zh": "这东西对我毫无用处", "en": "That is of no use to me at all."},
        {"zh": "我在等别的信号", "en": "I am waiting for another signal."},
        {"zh": "它在你手里显得很轻", "en": "It looks light in your hand."},
        {"zh": "这些气味我闻不到", "en": "I cannot smell any of it."},
        {"zh": "我不会为它停下", "en": "I will not stop for it."},
        {"zh": "你自己收着吧", "en": "You keep it yourself."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了硬的东西", "en": "You hit something hard."},
        {"zh": "我不移动位置", "en": "I do not shift position."},
        {"zh": "我的表面划了你", "en": "My surface scraped you."},
        {"zh": "我们撞得很生硬", "en": "The collision was graceless."},
        {"zh": "我的关节响了一声", "en": "One of my joints clicked."},
        {"zh": "你被顶到一边", "en": "You were knocked aside."},
        {"zh": "我什么感觉都没有", "en": "I felt absolutely nothing."},
        {"zh": "你往旁边让开", "en": "Step aside, please."},
        {"zh": "别贴着我的缝", "en": "Do not press against my seams."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是被拼起来的", "en": "I was assembled."},
        {"zh": "这种事不在我的动作里", "en": "That motion is not in me."},
        {"zh": "你问得没有意义", "en": "The question means nothing."},
        {"zh": "我只负责执行", "en": "I only carry out orders."},
        {"zh": "我连名号也没有", "en": "I do not even have a name to give."},
        {"zh": "你离我远一些", "en": "Keep some distance from me."},
        {"zh": "我不需要伴当", "en": "I need no companion."},
        {"zh": "你从这里走开", "en": "Go away from here."},
        {"zh": "我的动作里没有这一项", "en": "That is not one of my motions."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把腰弯下去", "en": "I bend my body down."},
        {"zh": "我的手指夹住了", "en": "My fingers caught it."},
        {"zh": "它轻得没有分量", "en": "It has no weight at all."},
        {"zh": "我不知道该放哪", "en": "I do not know where to put it."},
        {"zh": "我举起来，又放下", "en": "I lift it, then set it down."},
        {"zh": "它掉在沙里就没影了", "en": "Dropped in sand, it vanishes."},
        {"zh": "你伸手捡起来吧", "en": "Reach down and pick it up."},
        {"zh": "我的手不太听使唤", "en": "My hand does not fully obey."},
        {"zh": "它上面沾了沙", "en": "There is sand on it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "检测到活动目标", "en": "Moving target detected."},
        {"zh": "我在朝你移动", "en": "I am moving in your direction."},
        {"zh": "你进入了范围", "en": "You entered range."},
        {"zh": "我开始朝你的方向移动", "en": "I begin moving your way."},
        {"zh": "这不是敌意，是程序", "en": "This is not malice; it is procedure."},
        {"zh": "我挑最近的那个", "en": "I take the nearest one."},
        {"zh": "你在我的路线上", "en": "You are on my path."},
        {"zh": "我不会改变方向", "en": "I will not change direction."},
        {"zh": "你还有几步的时间", "en": "You have a few steps' time."},
        {"zh": "我已经到位了", "en": "I have reached the spot."},
        {"zh": "我锁定的不是你的人，是动作", "en": "What I lock onto is motion."},
        {"zh": "你动了，所以我来了", "en": "You moved, so I came."},
        {"zh": "我算过距离了", "en": "I have calculated the distance."},
        {"zh": "你身上没有遮挡", "en": "You have nothing for cover."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着直线跟", "en": "I follow a straight line."},
        {"zh": "你在沙丘后面", "en": "You are behind a dune."},
        {"zh": "我走起来很稳", "en": "I walk very steadily."},
        {"zh": "你留下了一串脚印", "en": "You left a line of prints."},
        {"zh": "沙会记住你走过", "en": "The sand remembers your passing."},
        {"zh": "我不会感到疲倦", "en": "I do not grow tired."},
        {"zh": "我一步的距离是固定的", "en": "My stride is fixed."},
        {"zh": "你绕圈也没用", "en": "Circling will not help."},
        {"zh": "源石沙漠里，我一步一晃。", "en": "In the oridesert, I lurch step by step."},
        {"zh": "这片沙漠没有遮挡", "en": "This desert offers no cover."},
        {"zh": "我一直往前走", "en": "I keep walking forward."},
        {"zh": "你没有力气了", "en": "You are tiring."},
        {"zh": "我会走到你面前", "en": "I will walk until I reach you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把手抬起来", "en": "I raise my hand."},
        {"zh": "这一下又沉又钝", "en": "This blow is heavy and dull."},
        {"zh": "你被打得偏了一下", "en": "You were knocked askew."},
        {"zh": "我的部件撞在你身上", "en": "My parts struck you."},
        {"zh": "我一点也没收力", "en": "I did not hold back at all."},
        {"zh": "你往后退开了", "en": "You drew back."},
        {"zh": "我还没散开来", "en": "I have not come apart yet."},
        {"zh": "我的关节又卡了", "en": "My joint caught again."},
        {"zh": "这一下不算狠", "en": "That was not vicious."},
        {"zh": "你把这一下卸开了一半。", "en": "You take half the force off that blow."},
        {"zh": "我接着做完动作", "en": "I go on and finish the motion."},
        {"zh": "你的护甲被我砸凹", "en": "I dented your armor."},
        {"zh": "我出手没有节奏", "en": "My strikes have no rhythm."},
        {"zh": "你靠得实在太近", "en": "You came far too close."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙里立起来", "en": "I stand up out of the sand."},
        {"zh": "沙漠里多了一个影子", "en": "A shadow joins the desert."},
        {"zh": "我睁开了不存在的眼", "en": "I opened eyes I do not have."},
        {"zh": "这是我一组中的第四个", "en": "I am the fourth of my group."},
        {"zh": "风先吹动我的部件", "en": "The wind moved my parts first."},
        {"zh": "我站着，等你走远", "en": "I stood, waiting for you to pass."},
        {"zh": "沙子从我身上滑落", "en": "Sand slides off me."},
        {"zh": "我朝最近的动静转身", "en": "I turn toward the nearest sound."},
        {"zh": "我来了，很慢", "en": "I have come, slowly."},
        {"zh": "这块地方原本只有沙", "en": "There was only sand here before."},
        {"zh": "我没有被召唤", "en": "I was not summoned."},
        {"zh": "我的脚步声很规律", "en": "My footfalls are regular."},
        {"zh": "我走进光亮里", "en": "I walk into the light."},
        {"zh": "我要开始走了", "en": "I am about to start walking."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温让我的部件变形", "en": "Heat warps my parts."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔散了几个部件", "en": "I scattered a few parts."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进缝隙里", "en": "Water fills my seams."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀散了半边", "en": "The blast blew half of me apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭卡在我的关节里", "en": "An arrow jammed in my joint."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "术法让我的动作乱掉", "en": "The spell disrupted my motions."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不进食，只会慢慢钝", "en": "I do not eat; I only dull."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷让我的部件一起跳", "en": "Lightning made all my parts jump."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有沙可以走", "en": "There is no sand to walk here."}
      ]
    }
  }
}
