{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着铁腿巡逻。", "en": "I patrol on iron legs."},
        {"zh": "每一步都磕在石板上。", "en": "Each step clacks on the flagstones."},
        {"zh": "我沿着村墙走。", "en": "I walk the village wall."},
        {"zh": "石板路被我的铁脚踩得咚咚响。", "en": "My iron feet drum on the flagstones."},
        {"zh": "我把栅栏检查一遍。", "en": "I check the fence line."},
        {"zh": "我绕过蛙屋走。", "en": "I circle the frog houses."},
        {"zh": "装甲蹭着门框。", "en": "My plating scrapes the doorframe."},
        {"zh": "我走得很稳，不会倒。", "en": "I walk steady; I won't fall."},
        {"zh": "木料做的那几个比我轻。", "en": "The wooden ones are lighter than me."},
        {"zh": "我从箱子里出来就该干活。", "en": "Out of the crate, I work."},
        {"zh": "蘑菇壳做的那些不太扛。", "en": "The mushroom ones don't hold up."},
        {"zh": "我一直朝着村口走。", "en": "I keep heading for the gate."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在门口不动。", "en": "I stand at the door, unmoving."},
        {"zh": "关节里有点卡。", "en": "A joint sticks a little."},
        {"zh": "我听着沼泽的风。", "en": "I listen to the marsh wind."},
        {"zh": "眼睛一直亮着，替你守村。", "en": "My eyes stay lit, guarding your village."},
        {"zh": "没有敌人，我就站着。", "en": "No enemy, so I stand."},
        {"zh": "我在等下一次袭击。", "en": "I wait for the next raid."},
        {"zh": "铁壳里的东西还在转。", "en": "Something turns inside my iron shell."},
        {"zh": "我把重量挪到铁腿上。", "en": "I shift weight to the other leg."},
        {"zh": "村子里很安静。", "en": "The village is quiet."},
        {"zh": "我数着蛙屋的窗。", "en": "I count the frog-house windows."},
        {"zh": "雨会让我的关节生锈。", "en": "Rain rusts my joints."},
        {"zh": "木头的我，也能守到天亮。", "en": "Even a wooden me can guard till dawn."},
        {"zh": "站得久了也不累。", "en": "Standing long doesn't tire me."},
        {"zh": "巡逻还没结束。", "en": "The patrol isn't over."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是村里的吗？", "en": "Are you from the village?"},
        {"zh": "我认得每一个蛙。", "en": "I know every frog here."},
        {"zh": "我按箱子的命令办事。", "en": "I follow the crate's orders."},
        {"zh": "你看到袭击者了吗？", "en": "Have you seen the raiders?"},
        {"zh": "我的拳头是铁做的。", "en": "My fists are made of iron."},
        {"zh": "你站的位置正好挡路。", "en": "You're standing right in the path."},
        {"zh": "我不对村民出手。", "en": "I don't strike villagers."},
        {"zh": "他把箱子放哪儿了？", "en": "Where did he put the crate?"},
        {"zh": "村里的人托我守着。", "en": "The villagers asked me to guard."},
        {"zh": "沼泽那边的声音不对。", "en": "Something's wrong over in the marsh."},
        {"zh": "你放心，我挡得住。", "en": "Don't worry; I can hold."},
        {"zh": "我的关节还灵。", "en": "My joints still work."},
        {"zh": "你往后退，我好看清。", "en": "Step back so I can see."},
        {"zh": "那群蛙靠得太近了。", "en": "Those Croaks are too close."},
        {"zh": "出了事就喊我。", "en": "Shout if anything happens."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "胸口陷下一块，我还站得住。", "en": "My chest plate dents, but I'm still standing."},
        {"zh": "关节被撞歪了。", "en": "My joint got knocked askew."},
        {"zh": "我退了半步又站定。", "en": "I give half a step, then plant again."},
        {"zh": "铁被打得直响。", "en": "The iron rang."},
        {"zh": "我还能转动手臂。", "en": "I can still turn my arm."},
        {"zh": "有个关节卡住了。", "en": "Something's jammed."},
        {"zh": "我咬牙，虽然我没有牙。", "en": "I grit my teeth, though I have none."},
        {"zh": "这层壳还能撑。", "en": "This shell will still hold."},
        {"zh": "我的站姿没塌。", "en": "My stance hasn't broken."},
        {"zh": "再来我就再挡。", "en": "Come again; I'll block again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你留着给别人吧。", "en": "Give it to someone else."},
        {"zh": "我的箱子里只装了命令。", "en": "My crate held only orders."},
        {"zh": "这对我来说没用。", "en": "That's useless to me."},
        {"zh": "村庄的防线，我守着。", "en": "I guard the village line."},
        {"zh": "你放那儿，我不管。", "en": "Leave it there; I don't care."},
        {"zh": "铁壳不需要喂食。", "en": "Iron needs no feeding."},
        {"zh": "木料做的兄弟也许要。", "en": "The wooden ones might want it."},
        {"zh": "拿开，我看不清路。", "en": "Take it away; I can't see the path."},
        {"zh": "我还是照样守着。", "en": "I keep guarding."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我是铁的，你撞不动。", "en": "I'm iron; you can't move me."},
        {"zh": "你被铁壳弹了回去。", "en": "You bounced off."},
        {"zh": "这一下没影响我的站位。", "en": "Didn't shift my post."},
        {"zh": "别全挤在门口。", "en": "Don't crowd the doorway."},
        {"zh": "我的装甲有棱角。", "en": "My plating has edges."},
        {"zh": "你踩到我的脚板了。", "en": "You stepped on my footplate."},
        {"zh": "往后退一点点。", "en": "Back off a bit."},
        {"zh": "我们从两边错开。", "en": "Let's pass each other."},
        {"zh": "这点磕碰伤不到铁壳。", "en": "That impact is nothing."},
        {"zh": "你挡着我的巡逻线。", "en": "You're on my patrol line."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有这种功能。", "en": "I have no such function."},
        {"zh": "我的任务是守村。", "en": "My task is to guard the village."},
        {"zh": "这不属于我的命令。", "en": "That isn't in my orders."},
        {"zh": "你在跟铁壳讲话。", "en": "You're talking to an iron shell."},
        {"zh": "我不明白这个。", "en": "I don't understand that."},
        {"zh": "站回你的位置。", "en": "Return to your post."},
        {"zh": "别耽误我巡逻。", "en": "Don't delay the patrol."},
        {"zh": "这么做没有必要。", "en": "That isn't necessary."},
        {"zh": "我只会守着村口。", "en": "All I do is guard."},
        {"zh": "你赶紧走开吧。", "en": "Move along."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这是村子里的东西吗？", "en": "Does this belong to the village?"},
        {"zh": "我捡起来交回去。", "en": "I pick it up and hand it back."},
        {"zh": "我的手指有点笨。", "en": "My fingers are clumsy."},
        {"zh": "太重会拖慢我。", "en": "Too heavy would slow me."},
        {"zh": "我把它放在门边。", "en": "I set it by the door."},
        {"zh": "这东西是武器吗？", "en": "Is this a weapon?"},
        {"zh": "我收进箱子里。", "en": "I put it in the crate."},
        {"zh": "这上面有沼泽的气味。", "en": "This smells of the marsh."},
        {"zh": "不要到处乱丢。", "en": "Don't leave it lying about."},
        {"zh": "我拿着它守着。", "en": "I'll hold it and keep watch."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有动静，我朝那边走。", "en": "Movement; I move toward it."},
        {"zh": "那不是村里的蛙。", "en": "That's not a village frog."},
        {"zh": "我的巡逻线不能破。", "en": "My patrol line can't be broken."},
        {"zh": "沼泽那边来了一批。", "en": "A group is coming from the marsh."},
        {"zh": "这个数量不少。", "en": "That's a fair number."},
        {"zh": "我先挡在门前。", "en": "I'll block the door first."},
        {"zh": "你别想绕过去。", "en": "You won't slip past."},
        {"zh": "我已经就位了。", "en": "Ready."},
        {"zh": "那就开始清场。", "en": "Begin."},
        {"zh": "他们全都来了。", "en": "Here they come."},
        {"zh": "给我死死守住。", "en": "Hold."},
        {"zh": "我绝对不会退。", "en": "I don't retreat."},
        {"zh": "这一下打在你身上。", "en": "This one lands on you."},
        {"zh": "让你的同伙都来。", "en": "Bring your friends."},
        {"zh": "你们进不去的。", "en": "You won't get in."},
        {"zh": "数到三，木箱子里就动手。", "en": "Count to three, then the crate moves."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着村墙一步步逼近。", "en": "I press forward step by step."},
        {"zh": "我挡在村口中间。", "en": "I stand squarely in the gateway."},
        {"zh": "你的路只有这一条。", "en": "This is your only route."},
        {"zh": "我把拳头抬到肩高。", "en": "I raise my fist to shoulder height."},
        {"zh": "你一退我就跟。", "en": "You retreat; I follow."},
        {"zh": "我完全挡得住。", "en": "I can hold."},
        {"zh": "你身后的人还没上。", "en": "The ones behind you haven't moved."},
        {"zh": "我给村里争时间。", "en": "I buy the village time."},
        {"zh": "再靠近就挨打。", "en": "One more step and you're hit."},
        {"zh": "我的关节热起来了。", "en": "My joints are heating up."},
        {"zh": "村里的门还开着。", "en": "The village door is still open."},
        {"zh": "我不能倒下去。", "en": "I can't fall."},
        {"zh": "这一条线归我。", "en": "This line is mine."},
        {"zh": "你身上有腐木味。", "en": "You smell of rotten wood."},
        {"zh": "我不需要援手。", "en": "I need no reinforcements."},
        {"zh": "再等一下下就好。", "en": "A moment more."},
        {"zh": "我就守在这里。", "en": "Right here."},
        {"zh": "你倒是过来啊。", "en": "Come on."},
        {"zh": "我不会让开的。", "en": "I won't step aside."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "铁拳狠狠砸下。", "en": "The iron fist comes down."},
        {"zh": "这一下够沉的。", "en": "That one was heavy."},
        {"zh": "你被铁拳推出门口。", "en": "You were shoved back."},
        {"zh": "我的关节发出响声。", "en": "My joints grind."},
        {"zh": "再来一记铁拳。", "en": "Another fist."},
        {"zh": "你的骨头碰到了铁。", "en": "Your bone met iron."},
        {"zh": "我把你顶在墙上。", "en": "I pin you to the wall."},
        {"zh": "别靠村里的门。", "en": "Stay away from the village door."},
        {"zh": "这一下是让你退。", "en": "That was to make you back off."},
        {"zh": "你要再试就断手。", "en": "Try again and you'll break a hand."},
        {"zh": "我的拳不会停。", "en": "My fists don't stop."},
        {"zh": "你原地站着别动。", "en": "Stand still."},
        {"zh": "这一击有分量。", "en": "That blow had weight."},
        {"zh": "我还能再打一轮。", "en": "I can hit again."},
        {"zh": "村里的蛙都看着。", "en": "The village frogs are watching."},
        {"zh": "撤回村子里面去。", "en": "Fall back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "箱盖弹开，我站起来。", "en": "The crate lid pops; I stand."},
        {"zh": "一股铁锈味散开。", "en": "A smell of rust spreads."},
        {"zh": "第一次睁开眼，看到沼泽。", "en": "First sight: the marsh."},
        {"zh": "我要守住这个村子。", "en": "I am to guard this village."},
        {"zh": "关节咔咔响了几声。", "en": "My joints clack a few times."},
        {"zh": "木箱一开，我的铁拳先伸出来。", "en": "The crate opens and my iron fist comes out first."},
        {"zh": "村里的人在哪？", "en": "Where are the villagers?"},
        {"zh": "村里还点着灯。", "en": "There are lights in the village."},
        {"zh": "我先绕村走一圈。", "en": "First, I'll walk the village perimeter."},
        {"zh": "沼泽那边有声音。", "en": "Sounds come from the marsh."},
        {"zh": "我站到门口去。", "en": "I take my place at the gate."},
        {"zh": "我的命令很清楚。", "en": "My orders are clear."},
        {"zh": "这事交给我吧。", "en": "Leave it to me."},
        {"zh": "箱子已经空了。", "en": "The crate is empty now."},
        {"zh": "我会站到最后。", "en": "I'll stand to the end."},
        {"zh": "装甲已经扣好了。", "en": "My plating is locked in place."},
        {"zh": "这就正式开始了。", "en": "It begins."},
        {"zh": "都给我守住村口。", "en": "Hold the gate."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我烤得发烫，铁都软了。", "en": "Fire heats me till the iron softens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从村墙摔下来，砸碎了石板。", "en": "I fell off the village wall and cracked the stones."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "泥水灌进我的关节。", "en": "Muddy water floods my joints."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我的装甲掀开。", "en": "The blast peeled my plating open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭卡在我肩上。", "en": "An arrow is jammed in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力钻进我的铁壳。", "en": "Spellwork seeped into my iron shell."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的箱子里没有燃料了。", "en": "My crate holds no more fuel."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的铁壳走遍了全身。", "en": "Lightning ran over my whole iron shell."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我脚下没有石板。", "en": "There's no flagstone under me."}
      ]
    }
  }
}
