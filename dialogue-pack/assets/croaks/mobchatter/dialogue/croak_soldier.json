{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟在队长后头。", "en": "I follow behind the captain."},
        {"zh": "每一步都跳得很齐。", "en": "Each hop lands in step."},
        {"zh": "湿土粘住了我的脚。", "en": "Wet soil sticks to my feet."},
        {"zh": "我们排成一条线。", "en": "We move in a line."},
        {"zh": "我扛着随手捡的骨。", "en": "I carry a bone I found."},
        {"zh": "沼泽的水只到腰。", "en": "The marsh water only reaches my waist."},
        {"zh": "我朝村子摸过去。", "en": "I creep toward the village."},
        {"zh": "喉咙里压着声音。", "en": "I keep my throat quiet."},
        {"zh": "腐木的碎片被我踢开。", "en": "Rotting wood scatters under me."},
        {"zh": "我在队长的侧后。", "en": "I'm at the captain's rear flank."},
        {"zh": "前面有人，我压低身子。", "en": "Someone ahead; I duck low."},
        {"zh": "我一步一步靠过去。", "en": "I edge forward step by step."},
        {"zh": "我不出声地跳。", "en": "I hop without a sound."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在芦苇里。", "en": "I squat among the reeds."},
        {"zh": "我得听队长的令。", "en": "I wait for the captain's order."},
        {"zh": "我忍着喉咙里的鸣声。", "en": "My throat pulses."},
        {"zh": "手里的骨头磨得发亮。", "en": "The bone in my hand is worn smooth."},
        {"zh": "水面有虫在爬。", "en": "Bugs crawl on the water."},
        {"zh": "我不敢先动一步。", "en": "I don't dare move first."},
        {"zh": "风把腐木味吹散了。", "en": "Wind scatters the smell of rot."},
        {"zh": "我的皮还湿着。", "en": "My hide is still wet."},
        {"zh": "村子里亮着火光。", "en": "There's firelight in the village."},
        {"zh": "我又数了一遍蛙。", "en": "I count the frogs again."},
        {"zh": "队长还没说话。", "en": "The captain hasn't spoken."},
        {"zh": "我把身子往下压。", "en": "I press myself lower."},
        {"zh": "我们在等天黑。", "en": "We're waiting for nightfall."},
        {"zh": "再忍一小会儿。", "en": "Endure a little longer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡在队伍前面。", "en": "You're standing in front of the warband."},
        {"zh": "我不是一个人来的。", "en": "I didn't come alone."},
        {"zh": "我手里的骨不轻。", "en": "This bone in my hand is heavy."},
        {"zh": "你别看队长，看我。", "en": "Don't look at the captain; look at me."},
        {"zh": "你到底想要什么？", "en": "What do you want?"},
        {"zh": "我是来打村子的。", "en": "I'm here to raid the village."},
        {"zh": "你退开，我不为难你。", "en": "Step aside and I won't trouble you."},
        {"zh": "队长会先动手。", "en": "The captain strikes first."},
        {"zh": "我数过你们的人。", "en": "I've counted your people."},
        {"zh": "你在给自己找麻烦。", "en": "You're making trouble for yourself."},
        {"zh": "我们人数占优。", "en": "We have the numbers."},
        {"zh": "你要是拦路，我就叫。", "en": "Block us and I'll call out."},
        {"zh": "这片芦苇是我们的路。", "en": "These reeds are our road."},
        {"zh": "你听见后面的声音了吗？", "en": "Hear that behind you?"},
        {"zh": "你握紧草叉，我的喉咙鼓起来。", "en": "You grip the pitchfork; my throat swells."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了一步，皮上开了口。", "en": "I step back; my hide is split."},
        {"zh": "这还真有点疼。", "en": "That hurt."},
        {"zh": "我忍不住叫了一声。", "en": "I let out a cry."},
        {"zh": "手里的骨还在。", "en": "My bone is still in hand."},
        {"zh": "我按住被撕开的皮。", "en": "I clamp the wound."},
        {"zh": "这点伤还能打。", "en": "I can still fight."},
        {"zh": "你别太得意了。", "en": "Don't get cocky."},
        {"zh": "队长会替我报仇。", "en": "The captain will avenge me."},
        {"zh": "再来试试看吧。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "队长说过别碰。", "en": "The captain said not to touch it."},
        {"zh": "这味道不像沼泽的东西。", "en": "That smell isn't from the marsh."},
        {"zh": "你放下，我看看。", "en": "Put it down; I'll look."},
        {"zh": "我饿了，但不能拿。", "en": "I'm hungry, but I can't take it."},
        {"zh": "这东西太干净了。", "en": "It's too clean."},
        {"zh": "拿开，我在站岗。", "en": "Take it away; I'm on watch."},
        {"zh": "我一口也不吃。", "en": "I won't eat."},
        {"zh": "你是不是想引开我？", "en": "Are you trying to lure me off?"},
        {"zh": "我回去再想想。", "en": "I'll think about it later."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我退了一步。", "en": "You bumped me; I took a step back."},
        {"zh": "我们挤在芦苇里。", "en": "We're crowded in the reeds."},
        {"zh": "我手里还有骨头。", "en": "I still have my bone."},
        {"zh": "你别踩我的脚。", "en": "Don't step on my feet."},
        {"zh": "我们从芦苇两边让开。", "en": "Let's move past each other."},
        {"zh": "你的肩撞得我偏了。", "en": "Your shoulder knocked me off line."},
        {"zh": "水被我踩响了。", "en": "I made the water splash."},
        {"zh": "你撞过来，我爪子在湿泥里滑了。", "en": "You ram me; my claws slip in the wet mud."},
        {"zh": "退后，队形要乱。", "en": "Back up; you're breaking formation."},
        {"zh": "别挨着我走路。", "en": "Don't walk against me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我正在这边站岗。", "en": "I'm on watch."},
        {"zh": "这可不合规矩。", "en": "That isn't proper."},
        {"zh": "队长会看见的。", "en": "The captain would see."},
        {"zh": "等这一仗打完。", "en": "After this raid."},
        {"zh": "我不谈这些事。", "en": "I don't discuss such things."},
        {"zh": "沼泽里不分这个。", "en": "The marsh doesn't work that way."},
        {"zh": "我要看着前面。", "en": "I need to watch ahead."},
        {"zh": "别耽误我站岗。", "en": "Don't delay me."},
        {"zh": "你快点给我走开。", "en": "Go away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这根骨头能用。", "en": "This bone will do."},
        {"zh": "我捡起来握着。", "en": "I pick it up and grip it."},
        {"zh": "这块石头够重。", "en": "This stone is heavy enough."},
        {"zh": "不值钱，但能砸。", "en": "Worthless, but it can smash."},
        {"zh": "我拿着当武器。", "en": "I'll use it as a weapon."},
        {"zh": "太轻了，换一块。", "en": "Too light; find another."},
        {"zh": "队长不会要这个的。", "en": "The captain won't want this."},
        {"zh": "先留着以后再说。", "en": "Keep it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "前面有人挡路。", "en": "Someone's blocking the path."},
        {"zh": "我要先盯住他。", "en": "I'll keep my eyes on him."},
        {"zh": "队长还没下令。", "en": "The captain hasn't ordered it."},
        {"zh": "我握紧了骨头。", "en": "I tighten my grip on the bone."},
        {"zh": "这距离我两跳就到。", "en": "Two hops to reach him."},
        {"zh": "他只有一个人。", "en": "He's alone."},
        {"zh": "我把喉咙压低。", "en": "I lower my throat."},
        {"zh": "别让他喊人来。", "en": "Don't let him call for help."},
        {"zh": "就是这个地方。", "en": "Right here."},
        {"zh": "我先冲上去吧。", "en": "I go first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我挡在他的侧路。", "en": "I block his side route."},
        {"zh": "他要往村里跑。", "en": "He's heading for the village."},
        {"zh": "我不给他空隙。", "en": "I give him no gap."},
        {"zh": "骨头举起来了。", "en": "The bone is raised."},
        {"zh": "芦苇会掩护我。", "en": "The reeds will cover me."},
        {"zh": "他还没发现我。", "en": "He hasn't noticed."},
        {"zh": "再往前挪一步。", "en": "One step closer."},
        {"zh": "这一下打得中。", "en": "This one lands."},
        {"zh": "现在该动手了。", "en": "Strike."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把骨头砸下去。", "en": "Down comes the bone."},
        {"zh": "我一跳撞在他膝上。", "en": "I hop into his knee."},
        {"zh": "我再来一下子。", "en": "One more."},
        {"zh": "我叫人来帮忙！", "en": "I'll call the others!"},
        {"zh": "这一下不重，但够乱。", "en": "Light, but enough to break his rhythm."},
        {"zh": "我撕他的袖口。", "en": "I tear his sleeve."},
        {"zh": "别挡，我还没完。", "en": "Don't block; I'm not done."},
        {"zh": "他的手松开了。", "en": "His grip loosened."},
        {"zh": "往后面退一点。", "en": "Fall back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从芦苇里出来。", "en": "I come out of the reeds."},
        {"zh": "队长就在那边。", "en": "The captain is over there."},
        {"zh": "我握着手里的骨。", "en": "I grip the bone in my hand."},
        {"zh": "这里水位不高。", "en": "The water isn't high."},
        {"zh": "村里的火还亮着。", "en": "The village fires still burn."},
        {"zh": "我把队伍排好。", "en": "I form up with the others."},
        {"zh": "喉咙里憋着声。", "en": "I hold my call in."},
        {"zh": "这雾来得正好。", "en": "The fog is right."},
        {"zh": "这里能藏住人。", "en": "Good cover here."},
        {"zh": "继续往前挪一点。", "en": "Move forward."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的皮，冒着白气。", "en": "Fire sears my hide; steam rises."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石头上滑进烂泥。", "en": "I fell off a stone into the mud."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "泥水灌进喉咙。", "en": "Muddy water fills my throat."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我抛进芦苇。", "en": "The blast threw me into the reeds."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的腿。", "en": "Something stuck in my leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我浑身发僵。", "en": "The spell left me stiff."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我拿不稳骨头。", "en": "Too hungry to hold my bone steady."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在芦苇上，我弹起来。", "en": "Lightning struck the reeds; I leapt."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面的泥没了。", "en": "The mud beneath me is gone."}
      ]
    }
  }
}
