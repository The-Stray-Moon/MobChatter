{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在冰面上滑了一小段。", "en": "I slide a little way over the ice."},
        {"zh": "肚子贴着冰，靠鳍挪。", "en": "Belly to the ice, I shuffle on flippers."},
        {"zh": "我扭着身子往前。", "en": "I wriggle forward."},
        {"zh": "冰海的边，我常来。", "en": "I often come to the frozen sea's edge."},
        {"zh": "我背上有一道黑纹。", "en": "A dark band across my back."},
        {"zh": "幼崽时候，我是全白的。", "en": "As a pup I was pure white."},
        {"zh": "我慢慢挪到冰窟边。", "en": "I shuffle to the ice hole."},
        {"zh": "鳍拍了两下，滑出去。", "en": "Two flipper strokes and I slide."},
        {"zh": "我走得不快，滑得快。", "en": "Not much of a walker; a good slider."},
        {"zh": "我回头看了看后面。", "en": "I glance back."},
        {"zh": "风把我的胡须吹得抖。", "en": "The wind shakes my whiskers."},
        {"zh": "我往水边挪。", "en": "I shift toward the water."},
        {"zh": "身后留着肚皮的痕。", "en": "A belly trail behind me."},
        {"zh": "我离冰窟只有几格远。", "en": "I keep within a few blocks of the ice hole."},
        {"zh": "四周都是白。", "en": "White all around."},
        {"zh": "我钻进水里，又爬上来。", "en": "I slip into the water, then climb out."},
        {"zh": "我的鼻子在冒白气。", "en": "My breath makes white puffs."},
        {"zh": "我一步一步，很小心。", "en": "Careful, one move at a time."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴在冰上，缩成一团。", "en": "I lie on the ice, curled up."},
        {"zh": "鳍贴着身体，很暖。", "en": "Flippers tucked, warm."},
        {"zh": "我把眼慢慢合了又开。", "en": "I slowly close and open my eyes."},
        {"zh": "有雪落在我鼻子上。", "en": "Snow lands on my nose."},
        {"zh": "冰面下面有声音。", "en": "Sounds beneath the ice."},
        {"zh": "我抬起头，听了听。", "en": "I lift my head and listen."},
        {"zh": "我不敢动太久。", "en": "I daren't stay still too long."},
        {"zh": "我拱了拱冰面。", "en": "I nudge the ice."},
        {"zh": "白毛贴着冰，有点湿。", "en": "My pale fur is damp against the ice."},
        {"zh": "我在休息，也在回血。", "en": "I'm resting, and healing."},
        {"zh": "远处有北极熊的味道。", "en": "A polar bear's scent, far off."},
        {"zh": "我把鳍收得更近了。", "en": "I pull my flippers in closer."},
        {"zh": "我把鼻子塞进鳍下面。", "en": "I tuck my nose under a flipper."},
        {"zh": "冰层很厚，很稳。", "en": "The ice is thick and firm."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠得实在太近。", "en": "You're really far too close."},
        {"zh": "我往后挪了一点。", "en": "I shuffle back a little."},
        {"zh": "你不像北极熊。", "en": "You're not a polar bear."},
        {"zh": "我眼睛盯着你的手。", "en": "My eyes are on your hands."},
        {"zh": "你要给我鱼吗？", "en": "Are you offering fish?"},
        {"zh": "我天生胆小。", "en": "I'm timid by nature."},
        {"zh": "你一伸手，我就滑走。", "en": "Reach out and I'll slide away."},
        {"zh": "我侧过脸，避开你。", "en": "I turn my face away."},
        {"zh": "这冰面，是我的地方。", "en": "This ice is my spot."},
        {"zh": "我露出牙齿了。", "en": "I've bared my teeth."},
        {"zh": "我其实不想咬。", "en": "I don't really want to bite."},
        {"zh": "你慢慢退，我就放松。", "en": "Back away slowly and I'll relax."},
        {"zh": "我身上还有你的味道。", "en": "Your scent is still on me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我把鳍和鼻子都收起来。", "en": "I tuck in flippers and nose."},
        {"zh": "我往水里滑。", "en": "I slide toward the water."},
        {"zh": "嗓子里挤出一声细叫。", "en": "A thin cry squeezes from my throat."},
        {"zh": "我抖得像筛子上的鱼。", "en": "I shake like a fish on a sieve."},
        {"zh": "伤口在冰上蹭。", "en": "The wound scrapes the ice."},
        {"zh": "我一点点往旁边挪。", "en": "I edge over little by little."},
        {"zh": "我趴在冰上不动。", "en": "I lie still on the ice."},
        {"zh": "水里我还游得动。", "en": "I can still swim."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "是鱼！我闻到了。", "en": "Fish! I smell it."},
        {"zh": "我不敢直接拿。", "en": "I daren't take it directly."},
        {"zh": "你先搁下，我再看。", "en": "Set it down first, then I'll look."},
        {"zh": "我不敢直接拿，你先搁下。", "en": "I dare not take it from your hand; set it down."},
        {"zh": "鱼在手里，别晃。", "en": "Don't wave the fish."},
        {"zh": "我肚皮贴着冰挪近半尺。", "en": "Belly to ice, I inch half a foot nearer."},
        {"zh": "我吃饱了就不怕你。", "en": "Once fed, I won't fear you."},
        {"zh": "我叼住就退回水里。", "en": "I'll take it and retreat to the water."},
        {"zh": "这么点哪里够。", "en": "That little isn't nearly enough."},
        {"zh": "再给我一条鱼。", "en": "Give me one more fish."},
        {"zh": "我三口两口就吃完了。", "en": "I gulp it down in three bites."},
        {"zh": "你退后，我才敢吃。", "en": "Step back and I'll dare eat."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我滑出去了半米。", "en": "I slid half a meter."},
        {"zh": "你撞到的是软软的。", "en": "What you hit was soft."},
        {"zh": "我心里并不气。", "en": "I'm not cross about it."},
        {"zh": "冰面上我们都没站稳。", "en": "Neither of us kept footing."},
        {"zh": "我一缩，鳍贴紧身子。", "en": "I flinch and clamp my flippers in."},
        {"zh": "我一身软肉，撞上来不疼。", "en": "I'm all soft flesh; bumping me doesn't hurt."},
        {"zh": "我往水那边挪。", "en": "I edge toward the water."},
        {"zh": "我们离远点吧。", "en": "Let's keep apart."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "冰上那只，花纹不错。", "en": "That one on the ice has a nice pattern."},
        {"zh": "我游过去，绕了一圈。", "en": "I swim over and circle once."},
        {"zh": "水里才是正经地方。", "en": "The water is the proper place."},
        {"zh": "繁殖得在水里。", "en": "Breeding must happen in water."},
        {"zh": "她的白毛，很干净。", "en": "Her pale fur is clean."},
        {"zh": "水面下，我们转圈。", "en": "Underwater, we circle each other."},
        {"zh": "这事不能急。", "en": "This can't be rushed."},
        {"zh": "我贴着她的鳍。", "en": "I press against her flipper."},
        {"zh": "一起浮上来换气。", "en": "We surface together to breathe."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼住，甩了两下。", "en": "I take it and shake it twice."},
        {"zh": "这东西咬得动吗？", "en": "Can I bite through this?"},
        {"zh": "我用前鳍把那东西翻过来。", "en": "I flip the thing over with a foreflipper."},
        {"zh": "掉进水里，沉了。", "en": "It fell in the water and sank."},
        {"zh": "我的鳍不灵活。", "en": "My flippers aren't nimble."},
        {"zh": "我把它拖到冰上。", "en": "I drag it onto the ice."},
        {"zh": "一口就没了。", "en": "One bite and it's gone."},
        {"zh": "我留给同伴。", "en": "I save it for my mate."},
        {"zh": "那点东西早下肚了。", "en": "That morsel is long since swallowed."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起鼻尖。", "en": "I lift my snout."},
        {"zh": "这不是条鱼。", "en": "That isn't a fish."},
        {"zh": "我往水边退。", "en": "I back toward the water."},
        {"zh": "我把眼转向那边。", "en": "I turn my eyes that way."},
        {"zh": "你想干什么？", "en": "What do you want?"},
        {"zh": "你在哪儿，我记住了。", "en": "I remember where you are."},
        {"zh": "水里我快得多。", "en": "In water I'm much faster."},
        {"zh": "我开始紧张了。", "en": "I'm getting nervous."},
        {"zh": "别再往这边来。", "en": "Don't come any nearer."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一路退到冰窟边。", "en": "I retreat to the ice hole."},
        {"zh": "你一动，我就下去。", "en": "One move and I dive."},
        {"zh": "我牙齿也不小。", "en": "My teeth aren't small either."},
        {"zh": "我身子缩起来了。", "en": "I've drawn myself in."},
        {"zh": "你还在拿不定主意。", "en": "You're still undecided."},
        {"zh": "我也有点怕。", "en": "I'm a little afraid too."},
        {"zh": "水就在后面。", "en": "The water is right behind me."},
        {"zh": "咱们各退一些吧。", "en": "Let's each give ground."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬你一口！", "en": "I bite you!"},
        {"zh": "这一下，是自卫。", "en": "That was self-defense."},
        {"zh": "我边咬边往水里退。", "en": "I bite while retreating to the water."},
        {"zh": "鳍拍了一下。", "en": "One flipper slap."},
        {"zh": "你往后抽身了。", "en": "You pulled back."},
        {"zh": "我不想再咬。", "en": "I don't want to bite again."},
        {"zh": "我身上没多少肉。", "en": "There isn't much meat on me."},
        {"zh": "赶紧离开这儿。", "en": "Leave, quickly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从冰窟里冒出头。", "en": "I pop my head out of the ice hole."},
        {"zh": "冰海的风，很冷。", "en": "The frozen sea wind is cold."},
        {"zh": "冰水从我的毛上甩开。", "en": "Icy water flies off my fur."},
        {"zh": "四周白茫茫的。", "en": "White everywhere."},
        {"zh": "我慢慢爬上冰面。", "en": "I haul myself onto the ice."},
        {"zh": "这地方，很安静。", "en": "Very quiet here."},
        {"zh": "风里有鱼的气味。", "en": "Fish on the wind."},
        {"zh": "远处有同伴。", "en": "Kin in the distance."},
        {"zh": "我先趴下来。", "en": "First, I lie down."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，我的毛就焦了。", "en": "Fire singes my fur."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔在冰上，肚子一疼。", "en": "I hit the ice; my belly hurts."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我滚了出去。", "en": "The blast rolls me away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉进我背脊。", "en": "Something pins into my back."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得连挪都挪不动。", "en": "Too hungry to move."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我趴得更低。", "en": "Lightning; I flatten lower."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有冰了，我直往下。", "en": "No ice beneath; I fall."}
      ]
    }
  }
}
