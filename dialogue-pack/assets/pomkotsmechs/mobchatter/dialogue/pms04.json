{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "背上的发射架沉甸甸。", "en": "The launcher on my back has real weight."},
        {"zh": "我迈着稳定的步子前进。", "en": "I advance with a steady stride."},
        {"zh": "导弹架随着身体轻轻晃。", "en": "The missile rack sways gently."},
        {"zh": "我把重心压得很低。", "en": "I keep my centre of gravity low."},
        {"zh": "我挑开阔的路线走。", "en": "I pick the open routes."},
        {"zh": "装载的弹体叮当响。", "en": "The loaded missiles clink."},
        {"zh": "我边走边锁定方位。", "en": "I lock my bearings as I walk."},
        {"zh": "铁腿一步一步踩下去。", "en": "My iron legs come down one at a time."},
        {"zh": "我把发射架转了个角度。", "en": "I turn the launcher to an angle."},
        {"zh": "我绕开一堆废铁。", "en": "I go around a heap of scrap."},
        {"zh": "我把距离拉开到四十格。", "en": "I open the range to forty blocks."},
        {"zh": "尘土在我身后拖着。", "en": "A trail of dust follows me."},
        {"zh": "我慢慢走到高地上。", "en": "I walk up onto the rise."},
        {"zh": "我的影子很长很钝。", "en": "My shadow is long and blunt."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把发射架撑在地上。", "en": "I brace the launcher on the ground."},
        {"zh": "弹舱的门半开着。", "en": "The bay door stands half open."},
        {"zh": "我在检查引信状态。", "en": "I'm checking the fuse state."},
        {"zh": "四个发射口都空着。", "en": "All four tubes are empty for now."},
        {"zh": "我把传感器转了半圈。", "en": "I sweep my sensors half a turn."},
        {"zh": "这一片空地够我开火。", "en": "This clearing gives me room to fire."},
        {"zh": "指示灯一个个亮起来。", "en": "The indicators light up one by one."},
        {"zh": "我把支架的锁扣扣好。", "en": "I fasten the brace latches."},
        {"zh": "我的动作一向很慢。", "en": "My movements are always slow."},
        {"zh": "散热口吐出白气。", "en": "The vents exhale white vapor."},
        {"zh": "我在等测距完成。", "en": "I'm waiting for the range finding."},
        {"zh": "我俯身重新检查一遍。", "en": "I bend to check everything again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起了背上的发射架。", "en": "I raise the launcher on my back."},
        {"zh": "你在我正前方四十格。", "en": "You're forty blocks dead ahead."},
        {"zh": "我的瞄准系统认出你了。", "en": "My targeting system has you."},
        {"zh": "你的位置很平坦。", "en": "Your position is nice and flat."},
        {"zh": "这个距离我不敢靠近。", "en": "I wouldn't dare close this distance."},
        {"zh": "我把四个管口对着你。", "en": "I aim all four tubes at you."},
        {"zh": "四个管口一起对着你。", "en": "All four tubes bear down on you."},
        {"zh": "你的掩体不够高。", "en": "Your cover isn't tall enough."},
        {"zh": "你最好开始跑。", "en": "You had better start running."},
        {"zh": "你这一身挡不住导弹。", "en": "That getup won't stop a missile."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "发射架歪了一点。", "en": "The launcher has tilted slightly."},
        {"zh": "我把机身调整回来。", "en": "I straighten the chassis back up."},
        {"zh": "弹舱发出闷闷的响。", "en": "The bay gives a hollow knock."},
        {"zh": "液压读数在往下掉。", "en": "Hydraulic readings are falling."},
        {"zh": "我的发射架卡了一下。", "en": "My launcher jammed for a beat."},
        {"zh": "我的指示灯变橙了。", "en": "My indicator has turned orange."},
        {"zh": "我重算了一次弹道。", "en": "I recalculated the trajectory."},
        {"zh": "损伤还在可控范围。", "en": "Damage is still manageable."},
        {"zh": "我还能继续发射。", "en": "I can keep firing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不需要这种补给。", "en": "I don't need that sort of supply."},
        {"zh": "那东西塞不进弹舱。", "en": "That won't fit into my bay."},
        {"zh": "你举着它是浪费力气。", "en": "Holding it up is wasted effort."},
        {"zh": "我的燃料和它无关。", "en": "My fuel has nothing to do with it."},
        {"zh": "它离我太近，不合适。", "en": "It's too close to me — unsuitable."},
        {"zh": "这对我不构成诱惑。", "en": "That's no temptation to me."},
        {"zh": "我扣着扳机不放。", "en": "My finger stays on the trigger."},
        {"zh": "我看不出它的用途。", "en": "I can't see its purpose."},
        {"zh": "收起来，然后退后。", "en": "Put it away and step back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的支架上。", "en": "You hit my brace."},
        {"zh": "我整个人只晃了一下。", "en": "I only swayed once."},
        {"zh": "反作用力把你震退了。", "en": "Recoil knocked you backwards."},
        {"zh": "我的底盘非常重。", "en": "My chassis is very heavy."},
        {"zh": "发射架发出闷闷一响。", "en": "The launcher gave a hollow knock."},
        {"zh": "别碰我的弹舱门。", "en": "Don't touch my bay door."},
        {"zh": "我们撞得灰尘直起。", "en": "Dust rose from our impact."},
        {"zh": "我把脚重新踩实。", "en": "I plant my feet again."},
        {"zh": "我退开拉开距离。", "en": "I back off to make distance."},
        {"zh": "再撞一次也不会有用。", "en": "Ramming again won't help."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的功能是发射导弹。", "en": "My function is launching missiles."},
        {"zh": "这不是我要考虑的事。", "en": "That's not mine to consider."},
        {"zh": "两门火力可以交替。", "en": "Two firing units can alternate."},
        {"zh": "保持四十格的距离。", "en": "Keep a forty-block separation."},
        {"zh": "你的装填比我快。", "en": "You reload faster than I do."},
        {"zh": "同类之间只传数据。", "en": "Our kind pass only data."},
        {"zh": "你压住一侧，我压另一侧。", "en": "You cover one side; I'll take the other."},
        {"zh": "齐射比单发更可靠。", "en": "A salvo is more reliable than one shot."},
        {"zh": "别靠在我的弹舱旁边。", "en": "Don't stand by my missile bay."},
        {"zh": "这是火力协同。", "en": "This is fire coordination."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用机械臂捡起来。", "en": "I pick it up with my arm."},
        {"zh": "这东西不太稳定。", "en": "This thing isn't very stable."},
        {"zh": "我把弹壳踩进了土里。", "en": "I press a spent casing into the dirt."},
        {"zh": "它卡进了我的支架。", "en": "It's jammed in my brace."},
        {"zh": "我把它扔进回收箱。", "en": "I throw it into the salvage bin."},
        {"zh": "这枚零件还能用。", "en": "This part is still usable."},
        {"zh": "它的口径对不上。", "en": "Its calibre doesn't match."},
        {"zh": "你掉的，拿回去。", "en": "You dropped it; take it back."},
        {"zh": "我把它塞进了腰侧。", "en": "I tuck it at my hip."},
        {"zh": "它已经锈得很厉害了。", "en": "It has rusted badly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标确认，准备发射。", "en": "Target confirmed. Preparing to launch."},
        {"zh": "四个管口全部指向你。", "en": "Every tube is pointed at you."},
        {"zh": "测距完成，风速稳定。", "en": "Range set, wind steady."},
        {"zh": "你站在没有遮挡的地方。", "en": "You're standing in the open."},
        {"zh": "第一枚已经就位。", "en": "The first missile is ready."},
        {"zh": "我把保险销拔掉了。", "en": "I've pulled the safety pin."},
        {"zh": "你听见导火的声音吗。", "en": "Do you hear the ignition?"},
        {"zh": "你跑也跑不过导弹。", "en": "You can't outrun a missile."},
        {"zh": "这一带没有山洞。", "en": "There are no caves around here."},
        {"zh": "我抬起了发射架。", "en": "I've raised the launcher."},
        {"zh": "你最好趴低一点。", "en": "You'd best lie low."},
        {"zh": "发射窗口已经开了。", "en": "The firing window is open."},
        {"zh": "这一枚不会跑偏。", "en": "This one won't stray off line."},
        {"zh": "你准备接住这一发。", "en": "Get ready to take this one."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在修正弹道。", "en": "I'm correcting the trajectory."},
        {"zh": "你退到树林边缘了。", "en": "You've backed to the treeline."},
        {"zh": "那棵树挡不住弹片。", "en": "That tree won't stop the blast."},
        {"zh": "我把第二枚推上去。", "en": "I push the second missile up."},
        {"zh": "你横移得太快了。", "en": "You're strafing too fast."},
        {"zh": "我把角度调低了两度。", "en": "I've lowered the angle two degrees."},
        {"zh": "你在往低处跑。", "en": "You're running for lower ground."},
        {"zh": "那片洼地我看得见。", "en": "I can see that hollow."},
        {"zh": "我在等你的速度稳定。", "en": "I'm waiting for your speed to settle."},
        {"zh": "你的甲板太薄了。", "en": "Your plating is too thin."},
        {"zh": "我把发射口逐个解锁。", "en": "I unlock the tubes one by one."},
        {"zh": "你的脚步在打乱。", "en": "Your footsteps are growing panicked."},
        {"zh": "这一片地都是我的射程。", "en": "All this ground is within my range."},
        {"zh": "我捕捉到你的呼吸。", "en": "I've captured your breathing."},
        {"zh": "你再跑也还在范围内。", "en": "Run all you like; you're still in range."},
        {"zh": "我把三个管口都对着你。", "en": "Three tubes point at you now."},
        {"zh": "现在开始发射。", "en": "Launching now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用发射架撞你的肩。", "en": "The launcher cracks your shoulder."},
        {"zh": "机械腿踹在你腰侧。", "en": "My leg kicks your flank."},
        {"zh": "你被顶出好几步远。", "en": "You're driven several steps away."},
        {"zh": "这一下是铁碰骨。", "en": "That was iron against bone."},
        {"zh": "我的支架扫到你了。", "en": "My brace swept across you."},
        {"zh": "你挡住了第一下。", "en": "You blocked the first one."},
        {"zh": "我把你顶到墙边。", "en": "I drive you to the wall."},
        {"zh": "这一击没留余力。", "en": "That blow held nothing back."},
        {"zh": "我退开重新架起。", "en": "I pull back and brace again."},
        {"zh": "你的膝弯软了一下。", "en": "Your knee gave for a moment."},
        {"zh": "这一下非常不轻。", "en": "That one wasn't light at all."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从装配台上站起来。", "en": "I rise from the assembly platform."},
        {"zh": "背上的发射架很沉重。", "en": "The launcher on my back is very heavy."},
        {"zh": "弹舱门发出开启的响。", "en": "The bay door opens with a clunk."},
        {"zh": "传感器扫过整片空地。", "en": "My sensors sweep the clearing."},
        {"zh": "我把支架先踩开。", "en": "I extend the braces first."},
        {"zh": "四枚弹体已经挂好。", "en": "All four missiles are mounted."},
        {"zh": "远处的目标很小。", "en": "The target far off looks tiny."},
        {"zh": "我确认了落脚点。", "en": "I confirm my footing."},
        {"zh": "我把机身转向前方。", "en": "I turn my chassis forward."},
        {"zh": "风从背后吹上来。", "en": "The wind comes up from behind."},
        {"zh": "我开始装填弹体。", "en": "I begin loading the missiles."},
        {"zh": "我把引信逐个校验。", "en": "I check the fuses one by one."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温警报响得很急。", "en": "The heat alarm is blaring."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "坠地时支架断了一根。", "en": "One brace snapped on impact."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把弹舱灌满了。", "en": "Water has flooded my bay."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我的机身掀翻。", "en": "The blast flipped my chassis."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那能量让引信失灵。", "en": "That energy fouled my fuses."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "燃料不够我开一次火。", "en": "I haven't fuel for one shot."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电流烧掉了一块控制板。", "en": "The current fried a control board."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "推力不够，我往下掉。", "en": "Not enough thrust; I'm dropping."}
      ]
    }
  }
}
