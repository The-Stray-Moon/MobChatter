{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步压过来，很稳。", "en": "I press forward step by step, steady."},
        {"zh": "枪管随着身体轻摆。", "en": "The barrel sways gently with my body."},
        {"zh": "脚下的石块被踩碎。", "en": "Stones break under my feet."},
        {"zh": "弹链在身上哗啦作响。", "en": "The ammo belt clinks against me."},
        {"zh": "我沿着开阔地往前走。", "en": "I walk across open ground."},
        {"zh": "每一步都踩在同一个节奏。", "en": "Every step keeps the same rhythm."},
        {"zh": "我微微俯身观察。", "en": "I lean forward slightly to observe."},
        {"zh": "我用的是两只机械腿。", "en": "I move on two mechanical legs."},
        {"zh": "我把射界拓宽了。", "en": "I've widened my field of fire."},
        {"zh": "铁的关节一路作响。", "en": "Iron joints clank the whole way."},
        {"zh": "我避开一堆铁丝网。", "en": "I step around a coil of wire."},
        {"zh": "前方空地适合开火。", "en": "The clearing ahead is good for firing."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我架好了枪，等着。", "en": "I've set my gun and I wait."},
        {"zh": "子弹在膛里安安静静。", "en": "The round sits quietly in the chamber."},
        {"zh": "我的光学镜在聚焦。", "en": "My optics are focusing."},
        {"zh": "散热片一片片张开。", "en": "The heat sinks open one by one."},
        {"zh": "这片战场还没有声音。", "en": "This battlefield has no sound yet."},
        {"zh": "我慢慢转动上身。", "en": "I rotate my torso slowly."},
        {"zh": "我把弹药清点了一遍。", "en": "I've counted the ammunition."},
        {"zh": "风把我的枪管吹凉。", "en": "The wind cools my barrel."},
        {"zh": "我在校风偏和距离。", "en": "I'm adjusting for wind and range."},
        {"zh": "我没有必要着急。", "en": "There's no reason for me to hurry."},
        {"zh": "我把脚钉在地面上。", "en": "I plant my feet on the ground."},
        {"zh": "指示灯一直亮着绿。", "en": "The indicator stays green."},
        {"zh": "我在等一个挥手的动作。", "en": "I'm waiting for a waving motion."},
        {"zh": "远处的草在动。", "en": "The grass moves far off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把枪口对准你的胸口。", "en": "I bring the muzzle to your chest."},
        {"zh": "你站在我的射界中央。", "en": "You're in the centre of my field."},
        {"zh": "这个距离我已经算好了。", "en": "I've already solved this range."},
        {"zh": "你一动我就能打中。", "en": "If you move, I can hit you."},
        {"zh": "我的枪管没有晃。", "en": "My barrel isn't wavering."},
        {"zh": "你身上没有东西能挡。", "en": "You have nothing that can block."},
        {"zh": "我慢慢调整了角度。", "en": "I've adjusted the angle slowly."},
        {"zh": "你在我的准星上。", "en": "You're on my crosshair."},
        {"zh": "我们的距离是二十三格。", "en": "We stand twenty-three blocks apart."},
        {"zh": "你可以选择不动。", "en": "You may choose not to move."},
        {"zh": "我读出了你的呼吸。", "en": "I've read your breathing."},
        {"zh": "这一发会很快。", "en": "This shot will be quick."},
        {"zh": "你不必抬头看我。", "en": "You needn't look up at me."},
        {"zh": "我把肩膀压低了。", "en": "I've lowered my shoulders."},
        {"zh": "你的脚步让我看清了。", "en": "Your steps gave you away."},
        {"zh": "你的手应该离开武器。", "en": "Your hand should leave that weapon."},
        {"zh": "风偏在两格左右。", "en": "Wind drift is about two blocks."},
        {"zh": "我已经准备好。", "en": "I'm already prepared."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的瞄准镜偏了。", "en": "My scope got knocked off."},
        {"zh": "弹链卡了一下。", "en": "The belt jammed for a moment."},
        {"zh": "我重新稳住底盘。", "en": "I steady my chassis again."},
        {"zh": "液压压力掉了一些。", "en": "Hydraulic pressure has dropped."},
        {"zh": "我把姿态调回来。", "en": "I reset my stance."},
        {"zh": "还要接着打吗。", "en": "Shall we keep going?"},
        {"zh": "我站得非常稳。", "en": "I'm standing very steady."},
        {"zh": "我的枪还能用。", "en": "My gun still works."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃任何东西。", "en": "I don't eat anything at all."},
        {"zh": "那东西不会进入我的膛。", "en": "That won't enter my chamber."},
        {"zh": "你举着它在耗时间。", "en": "Holding it up is just burning time."},
        {"zh": "我的弹链不需要它。", "en": "My belt doesn't need it."},
        {"zh": "你不能用它换命。", "en": "You can't trade that for your life."},
        {"zh": "我看见你手里的动作。", "en": "I saw the movement in your hands."},
        {"zh": "它在我的镜头里很小。", "en": "It looks tiny through my optics."},
        {"zh": "我的目标是你，不是它。", "en": "My target is you, not it."},
        {"zh": "放下它，手举起来。", "en": "Put it down and raise your hands."},
        {"zh": "别把它往前送。", "en": "Don't push it toward me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞在你身上，我退了半步。", "en": "I hit you and took half a step back."},
        {"zh": "枪管被撞偏了一点。", "en": "The barrel got knocked slightly off."},
        {"zh": "我立刻重新校准。", "en": "I recalibrate immediately."},
        {"zh": "你的肩撞在我的支架上。", "en": "Your shoulder hit my strut."},
        {"zh": "地面被踩出两个坑。", "en": "Two craters were left in the ground."},
        {"zh": "别碰到我的弹药带。", "en": "Don't touch my ammo belt."},
        {"zh": "我稳住了底盘。", "en": "I've stabilized my chassis."},
        {"zh": "这一下没有打乱我。", "en": "That didn't break my rhythm."},
        {"zh": "我们撞出一声空响。", "en": "We met with an empty clang."},
        {"zh": "我抬手把你挡开。", "en": "I raise an arm and block you off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的用途是射击。", "en": "My purpose is shooting."},
        {"zh": "这一项不在程序里。", "en": "That isn't in my programming."},
        {"zh": "我们可以互相掩护。", "en": "We can cover each other."},
        {"zh": "保持射界不要重叠。", "en": "Keep our fields of fire separate."},
        {"zh": "你的弹道和我不同。", "en": "Your ballistics differ from mine."},
        {"zh": "同类之间交换坐标。", "en": "Our kind exchange coordinates."},
        {"zh": "东边交给你，西边归我。", "en": "East is yours; the west is mine."},
        {"zh": "背靠背更安全。", "en": "Back to back is safer."},
        {"zh": "我的枪管还热着。", "en": "My barrel is still hot."},
        {"zh": "这是合作，不是亲近。", "en": "This is cooperation, not closeness."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起一枚弹壳。", "en": "I pick up a spent casing."},
        {"zh": "这个型号对不上。", "en": "This model doesn't match."},
        {"zh": "我用机械手夹起来。", "en": "I pick it up with my mechanical hand."},
        {"zh": "这枚已经空了。", "en": "This one is already spent."},
        {"zh": "我把它收进了箱里。", "en": "I put it into the crate."},
        {"zh": "这东西打不响。", "en": "This one won't fire."},
        {"zh": "我把它放在脚边。", "en": "I set it by my feet."},
        {"zh": "零件已经锈了。", "en": "The part has rusted."},
        {"zh": "它还是有点分量的。", "en": "It does carry a little weight."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "射界确认，开始射击。", "en": "Field of fire confirmed. Opening up."},
        {"zh": "第一发是警告。", "en": "The first round is a warning."},
        {"zh": "你的位置已经在我算内。", "en": "Your position is already in my solution."},
        {"zh": "距离二十三格，风速不大。", "en": "Twenty-three blocks, light wind."},
        {"zh": "我把枪口放平了。", "en": "I've levelled the muzzle."},
        {"zh": "你最好趴下去。", "en": "You'd best get down low."},
        {"zh": "我的弹链开始送弹。", "en": "My belt has started feeding."},
        {"zh": "我读到了你的心跳。", "en": "I've picked up your heartbeat."},
        {"zh": "你想换位置吗。", "en": "Do you want to change position?"},
        {"zh": "我从这里能打到任何角落。", "en": "From here I can reach any corner."},
        {"zh": "枪口已经对准了。", "en": "The muzzle is already aimed."},
        {"zh": "你的护甲不够厚。", "en": "Your armour isn't thick enough."},
        {"zh": "这一片空地没有遮挡。", "en": "This open ground offers no cover."},
        {"zh": "准备承受火力。", "en": "Prepare to take fire."},
        {"zh": "你动的那一下很危险。", "en": "That movement of yours was risky."},
        {"zh": "我开始扣动扳机。", "en": "I begin to squeeze the trigger."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在调整你的距离。", "en": "I'm adjusting for your range."},
        {"zh": "你退到石头后面也没用。", "en": "Hiding behind a rock won't help."},
        {"zh": "子弹能绕开那块木板。", "en": "The round can get past that plank."},
        {"zh": "我在跟着你的移动。", "en": "I'm tracking your movement."},
        {"zh": "你的横移太慢了。", "en": "Your lateral movement is too slow."},
        {"zh": "我把枪口抬高了半寸。", "en": "I've raised the muzzle half an inch."},
        {"zh": "弹道穿过了这片草丛。", "en": "The trajectory cuts through this grass."},
        {"zh": "你的手在抖，准头会差。", "en": "Your shaking hands will spoil your aim."},
        {"zh": "我把弹药又压上膛。", "en": "I've chambered another round."},
        {"zh": "你跑到墙边就是死路。", "en": "Running to the wall is a dead end."},
        {"zh": "这一段距离我闭着眼都能打。", "en": "I could make this shot blind."},
        {"zh": "你消失在我的视线外。", "en": "You've gone out of my sight."},
        {"zh": "我又找到了你。", "en": "I've found you again."},
        {"zh": "你的影子暴露了你。", "en": "Your shadow gave you away."},
        {"zh": "最后一点风偏修正。", "en": "One last wind correction."},
        {"zh": "倒计时已经结束。", "en": "The countdown is over."},
        {"zh": "现在开始射击。", "en": "Opening fire now."},
        {"zh": "火力全开射击。", "en": "Full fire, all weapons."},
        {"zh": "枪口停在你胸前。", "en": "The muzzle rests on your chest."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "枪托砸在你的肩上。", "en": "The stock cracks your shoulder."},
        {"zh": "我用枪管顶开你。", "en": "I shove you away with the barrel."},
        {"zh": "这一下是近距离的。", "en": "That one was at close range."},
        {"zh": "我的支架撞在你胸口。", "en": "My strut hits your chest."},
        {"zh": "你退了，我又举枪。", "en": "You retreat; I raise the gun again."},
        {"zh": "机械腿踹在你膝上。", "en": "My leg kicks your knee."},
        {"zh": "你被砸得蹲下去了。", "en": "You're knocked down into a crouch."},
        {"zh": "这一下比子弹还沉。", "en": "That hit heavier than a bullet."},
        {"zh": "我把你推开三十格？不可能。", "en": "Thirty blocks away? Not quite."},
        {"zh": "你还能站起来。", "en": "You can still get up."},
        {"zh": "我退后重新装弹。", "en": "I back off and reload."},
        {"zh": "我的枪口又抬起来。", "en": "My muzzle rises again."},
        {"zh": "别再走近一步。", "en": "Don't take another step closer."},
        {"zh": "你会后悔站那么近。", "en": "You'll regret standing so close."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从运输架上落下来。", "en": "I drop off the transport rack."},
        {"zh": "落地时腿部缓冲动作。", "en": "My legs absorb the landing."},
        {"zh": "枪口随即抬起。", "en": "The muzzle rises at once."},
        {"zh": "传感器开始扫描。", "en": "The sensors begin their sweep."},
        {"zh": "弹链已经穿好。", "en": "The belt is already threaded."},
        {"zh": "我的漆面还很新。", "en": "My paint is still fresh."},
        {"zh": "这片地很适合射击。", "en": "This ground is good for shooting."},
        {"zh": "我把支脚打开。", "en": "I deploy my stabilizer legs."},
        {"zh": "远处有一个活动目标。", "en": "There's a moving target far off."},
        {"zh": "系统逐项自检完成。", "en": "Systems check complete."},
        {"zh": "我开始等待目标。", "en": "I begin waiting for a target."},
        {"zh": "风从左边吹过来。", "en": "The wind comes from the left."},
        {"zh": "我开始装填第一发。", "en": "I load the first round."},
        {"zh": "这里视野开阔。", "en": "The sightlines are wide open."},
        {"zh": "我看清了整片空地。", "en": "I can see the whole clearing."},
        {"zh": "我选择了这个位置。", "en": "I've chosen this position."},
        {"zh": "我开始等待起来。", "en": "I settle in to wait."},
        {"zh": "有人正在靠近。", "en": "Someone is approaching."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "枪管被火烤得发烫。", "en": "Fire has the barrel glowing hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时支脚弯了。", "en": "My stabilizer bent on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进了弹匣里。", "en": "Water got into the magazine."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一枚弹头嵌进我的肩。", "en": "A round embedded in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那能量让瞄准系统失准。", "en": "That energy threw off my targeting."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "弹药见底，只剩下几发。", "en": "Almost out of ammo — a few rounds left."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电流烧坏了我的触发器。", "en": "The current fried my trigger."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "底下没有落点。", "en": "There's no landing point below."}
      ]
    }
  }
}
