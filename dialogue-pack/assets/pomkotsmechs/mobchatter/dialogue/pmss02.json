{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用两足快走", "en": "I stride on two small legs."},
        {"zh": "机体重心很低", "en": "My chassis sits low."},
        {"zh": "脚步短而密", "en": "Short, quick steps."},
        {"zh": "我在桌椅间穿行", "en": "I weave between furniture."},
        {"zh": "我踩着地砖缝走", "en": "I walk along the tile seams."},
        {"zh": "我一边走一边转镜头", "en": "My lens turns as I move."},
        {"zh": "转向时有点笨", "en": "My turns are clumsy."},
        {"zh": "我绕开落下的东西", "en": "I step around fallen objects."},
        {"zh": "地上有个坑", "en": "There is a pit ahead."},
        {"zh": "我跑起来有风声", "en": "My run makes a small wind."},
        {"zh": "我停了一步又走", "en": "I pause a step, then continue."},
        {"zh": "我在找低矮的路", "en": "I look for a low route."},
        {"zh": "我的影子小小的", "en": "My shadow is tiny."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "小型机在待机", "en": "Tiny unit on standby."},
        {"zh": "我在数地上的灰", "en": "I count specks of dust."},
        {"zh": "这里够安静", "en": "Quiet enough here."},
        {"zh": "我抬头看了看", "en": "I glance upward."},
        {"zh": "我的关节轻轻响", "en": "My joints tick softly."},
        {"zh": "这地方灰尘多", "en": "Dusty place."},
        {"zh": "我站得笔直", "en": "I stand quite straight."},
        {"zh": "我的镜头在自动对焦", "en": "My lens is autofocusing."},
        {"zh": "我不占地方", "en": "I take up little space."},
        {"zh": "我又转了半圈", "en": "I rotate half a turn."},
        {"zh": "没发现什么", "en": "Nothing detected."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你腰间的高度", "en": "I am at your waist height."},
        {"zh": "你要弯腰吗", "en": "Are you going to bend down?"},
        {"zh": "我能看清你的手指", "en": "I can see your fingers clearly."},
        {"zh": "你的靴子像堵墙", "en": "Your boots are like walls."},
        {"zh": "别踢我", "en": "Do not kick me."},
        {"zh": "我们离得很近", "en": "We are very close."},
        {"zh": "你低头了", "en": "You looked down."},
        {"zh": "我就在这儿", "en": "I am right here."},
        {"zh": "你的膝盖挡着我的路", "en": "Your knee is in my way."},
        {"zh": "我等你让开", "en": "I wait for you to move."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "外壳被打凹", "en": "My shell is dented."},
        {"zh": "我转了个圈", "en": "I spun around."},
        {"zh": "腿有点歪", "en": "My leg is bent."},
        {"zh": "电机发出怪声", "en": "The motor makes a bad noise."},
        {"zh": "我滑开了一小段", "en": "I slid back a short way."},
        {"zh": "我的镜头在抖", "en": "My lens is shaking."},
        {"zh": "电机声开始发哑", "en": "My motor is starting to rasp."},
        {"zh": "我还开着", "en": "I am still running."},
        {"zh": "稳住了", "en": "Stabilized."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块金属料不错", "en": "Good metal stock there."},
        {"zh": "我够得到吗", "en": "Can I reach it?"},
        {"zh": "你放在地上就行", "en": "Just set it on the ground."},
        {"zh": "我慢慢过去", "en": "I will come over slowly."},
        {"zh": "这条螺丝我想要", "en": "I want that screw."},
        {"zh": "别举高", "en": "Do not raise it."},
        {"zh": "我先看看尺寸", "en": "Let me check the size."},
        {"zh": "能塞进我的舱里", "en": "It will fit in my bay."},
        {"zh": "太好了", "en": "Perfect."},
        {"zh": "我这就来拿", "en": "I am coming to get it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞得我一个趔趄", "en": "Your bump made me stumble."},
        {"zh": "我侧过身让开", "en": "I turn sideways to let you pass."},
        {"zh": "我的肩上有块钢板", "en": "There is a plate on my shoulder."},
        {"zh": "你腿上的东西硌到我", "en": "Something on your leg scraped me."},
        {"zh": "我们卡在一起了", "en": "We are stuck together."},
        {"zh": "我一退就撞到墙", "en": "I back up into the wall."},
        {"zh": "别把我踩进土里", "en": "Do not press me into the dirt."},
        {"zh": "我甩了甩机身", "en": "I shake my frame."},
        {"zh": "再挤就散架了", "en": "Squeeze more and I come apart."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是一台单机", "en": "I am a single unit."},
        {"zh": "没有同一型号的", "en": "No matching model nearby."},
        {"zh": "我也不需要", "en": "Nor do I need one."},
        {"zh": "你在等什么", "en": "What are you waiting for?"},
        {"zh": "这个设计里没有", "en": "Not in this design."},
        {"zh": "我只想待机", "en": "I only want to idle."},
        {"zh": "别碰我机壳", "en": "Do not touch my shell."},
        {"zh": "指令不适用", "en": "Command not applicable."},
        {"zh": "请你退开", "en": "Step back, please."},
        {"zh": "系统忽略", "en": "System ignores."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱着它走不动", "en": "Holding it, I cannot walk."},
        {"zh": "我拖着走", "en": "I drag it."},
        {"zh": "这点重量还行", "en": "This weight is fine."},
        {"zh": "小舱门能塞下", "en": "It fits in the small hatch."},
        {"zh": "我先试了试齿", "en": "I test my grippers first."},
        {"zh": "我拖着它藏起来", "en": "I drag it off and hide it."},
        {"zh": "一地的零件", "en": "Parts everywhere."},
        {"zh": "多捡几块", "en": "A few more pieces."},
        {"zh": "够用了", "en": "That is enough."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "发现活动目标", "en": "Movement detected."},
        {"zh": "你的脚踝高度正合适", "en": "Your ankle height suits me."},
        {"zh": "我先占你的侧面", "en": "I take your flank first."},
        {"zh": "炮口抬起来了", "en": "My barrel is raised."},
        {"zh": "小机器也会咬人", "en": "Even small machines bite."},
        {"zh": "你转身前我就在了", "en": "I was there before you turned."},
        {"zh": "别再往前走", "en": "Stop walking forward."},
        {"zh": "我数完你的步子了", "en": "I have counted your steps."},
        {"zh": "这回我不会失手", "en": "I will not miss this time."},
        {"zh": "你的护膝挡住了膝盖", "en": "Your knee guard covers the knee."},
        {"zh": "那么就打小腿", "en": "Then I take your shin."},
        {"zh": "目标是我自己选的", "en": "The target is my own choice."},
        {"zh": "你先动手的", "en": "You moved first."},
        {"zh": "我立刻开始", "en": "I begin at once."},
        {"zh": "这条线别越过", "en": "Do not cross this line."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着你绕", "en": "I circle close to you."},
        {"zh": "你每一步我都在算", "en": "I calculate every step."},
        {"zh": "我躲在桌角后面", "en": "I hide behind the table corner."},
        {"zh": "你的靴底就在我眼前", "en": "Your boot sole is right before me."},
        {"zh": "我等你抬脚那种空档", "en": "I wait for the moment you lift a foot."},
        {"zh": "你想不到我在脚下", "en": "You would not think to look at your feet."},
        {"zh": "我又换了个位置", "en": "I changed position again."},
        {"zh": "我在你侧后方", "en": "I am at your rear flank."},
        {"zh": "我全程没有停", "en": "I have not stopped."},
        {"zh": "你听见细小的电机声了吗", "en": "Do you hear the tiny motor whine?"},
        {"zh": "我的镜头一直对着你的膝", "en": "My lens stays on your knee."},
        {"zh": "再近两步", "en": "Two steps closer."},
        {"zh": "你护不住所有角度", "en": "You cannot cover every angle."},
        {"zh": "如果我不动，你就找不到我", "en": "If I keep still, you cannot find me."},
        {"zh": "我动了，你就知道了", "en": "And when I move, you will know."},
        {"zh": "你已经离墙很近了", "en": "You are close to the wall."},
        {"zh": "墙边是我的位置", "en": "The wall is my ground."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我开枪打你的小腿", "en": "I shoot at your shin."},
        {"zh": "金属臂抽在你脚背上", "en": "My arm slaps your instep."},
        {"zh": "你跳了一下", "en": "You hopped."},
        {"zh": "这一击打在护甲缝里", "en": "That found the gap in your guard."},
        {"zh": "我从墙上弹起来撞你", "en": "I spring off the wall into you."},
        {"zh": "我贴着地扫射", "en": "I fire low along the ground."},
        {"zh": "你就快站不稳了", "en": "You are losing your footing."},
        {"zh": "我的小爪子抓住你", "en": "My little claw hooks you."},
        {"zh": "我撞你的膝盖窝", "en": "I hit the back of your knee."},
        {"zh": "你低头时我换了角度", "en": "While you looked down I moved."},
        {"zh": "我还没打完", "en": "I am not finished."},
        {"zh": "小口径也够你受", "en": "Small caliber still hurts."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "小型机落地", "en": "Tiny unit grounded."},
        {"zh": "我从阴影里启动", "en": "I start up out of the shadow."},
        {"zh": "地面被我踩出两个小坑", "en": "Two little pits under my feet."},
        {"zh": "没有刷怪蛋可用在我身上", "en": "No spawn egg applies to me."},
        {"zh": "我在找大件的东西", "en": "I am looking for something big."},
        {"zh": "我还带着出厂的灰", "en": "I still have factory dust on me."},
        {"zh": "我转了转镜头", "en": "I swivel my lens."},
        {"zh": "这里有点拥挤", "en": "It is a little crowded here."},
        {"zh": "我站进了地砖中间", "en": "I stand between the tiles."},
        {"zh": "我先扫描一遍", "en": "I do a quick scan first."},
        {"zh": "我抬起了手", "en": "I raise my hand."},
        {"zh": "好了，开始", "en": "All right, begin."}
      ]
    },
