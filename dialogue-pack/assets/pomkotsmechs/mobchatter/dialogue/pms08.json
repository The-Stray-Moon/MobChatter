{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挪动步子，机身轻晃", "en": "I move and my hull sways lightly."},
        {"zh": "我走得很直，像画了一条线", "en": "I walk a straight line, as if drawn."},
        {"zh": "脚下石头被踩得移位", "en": "Stones shift under my feet."},
        {"zh": "腿交替的节奏很均匀", "en": "My legs alternate evenly."},
        {"zh": "我在坡上稍微斜着走", "en": "I cross the slope at an angle."},
        {"zh": "机身贴着草尖过去", "en": "My hull skims the grass tips."},
        {"zh": "液压一步步，节奏不变。", "en": "Hydraulics pace me, rhythm unbroken."},
        {"zh": "我的影子在地上稳稳移动", "en": "My shadow moves steadily."},
        {"zh": "我踩过水洼，溅起一圈", "en": "I cross a puddle and it splashes."},
        {"zh": "我把头微微低着走", "en": "I walk with my head slightly low."},
        {"zh": "转弯时，我先停下再转", "en": "To turn, I stop first."},
        {"zh": "这台机身比看起来灵活", "en": "This chassis is nimbler than it looks."},
        {"zh": "我不需要休息，一直走", "en": "I need no rest. I keep walking."},
        {"zh": "灰尘从我背后扬起来", "en": "Dust rises behind me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立在空地上，镜头半转", "en": "I stand in the open, lens half turned."},
        {"zh": "编号 PMS08 在腿侧", "en": "PMS08 on my leg plate."},
        {"zh": "我的关节很安静", "en": "My joints are quiet."},
        {"zh": "我在读这一带的震动", "en": "I read the tremors here."},
        {"zh": "关机之前，我不会坐下", "en": "Until shutdown, I don't sit."},
        {"zh": "我的机壳上有一道旧划痕", "en": "An old scratch across my hull."},
        {"zh": "风从腿间穿过去", "en": "Wind passes between my legs."},
        {"zh": "我抬了抬一只脚，又放下", "en": "I lift a foot, then set it down."},
        {"zh": "这里没什么可算的", "en": "Nothing here worth calculating."},
        {"zh": "我把视野切成几块扫", "en": "I scan my view in sections."},
        {"zh": "安静让我更容易发现动静", "en": "Quiet makes movement easier to notice."},
        {"zh": "等，我有的是电", "en": "I have power enough to wait."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把镜头对准你", "en": "I put my lens on you."},
        {"zh": "你没有编号牌", "en": "You have no number plate."},
        {"zh": "我比了比距离，很远", "en": "I measure the range. Far."},
        {"zh": "你站在我的左侧", "en": "You're on my left side."},
        {"zh": "我慢慢把机身转过来", "en": "I turn my chassis slowly."},
        {"zh": "你的动作，我一格一格看。", "en": "I read your moves frame by frame."},
        {"zh": "你抬手，我不动", "en": "You raise a hand. I don't move."},
        {"zh": "我叫 PMS08，你叫什么", "en": "I'm PMS08. What are you called?"},
        {"zh": "你退了半步，又停住", "en": "You step back, then stop."},
        {"zh": "有意思，你不打算跑", "en": "Interesting. You're not going to run."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的一条腿退后半寸", "en": "One leg gives half an inch."},
        {"zh": "机壳上多了一道白痕", "en": "A white scratch on my hull."},
        {"zh": "我的金属脚，一步一个坑。", "en": "Each metal step leaves a dent."},
        {"zh": "内部的声音变了调", "en": "The sound inside changes pitch."},
        {"zh": "我还能走，没问题", "en": "I can still walk. Fine."},
        {"zh": "一块护片松了", "en": "A plate has come loose."},
        {"zh": "我停顿了半秒", "en": "I pause half a second."},
        {"zh": "损伤已被记录", "en": "Damage logged."},
        {"zh": "你比看上去有力", "en": "You're stronger than you look."},
        {"zh": "我重新测了距离", "en": "I re-measure the range."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那不是我要的动力", "en": "That's not the power I run on."},
        {"zh": "我看了一眼就没兴趣", "en": "I looked once and lost interest."},
        {"zh": "举着它，你会先累", "en": "Hold it up and you'll tire first."},
        {"zh": "我的补给不靠这个", "en": "I don't resupply on that."},
        {"zh": "扫描：非必要物品", "en": "Scan: non-essential item."},
        {"zh": "放地上，然后退开", "en": "Set it down, then back away."},
        {"zh": "我不会因此改变距离", "en": "That won't change my distance."},
        {"zh": "这动作我识别成诱饵", "en": "I classify that gesture as bait."},
        {"zh": "你换个办法可能有用", "en": "Another approach might work."},
        {"zh": "但这个，不行", "en": "But not this one."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你一撞，我的腿滑了一下", "en": "You knock me and a leg slips."},
        {"zh": "我重新撑住，站稳了", "en": "I re-brace and hold."},
        {"zh": "你的重量撞不歪我的腿。", "en": "Your weight cannot skew my legs."},
        {"zh": "金属声在空地上很响", "en": "Metal rings loudly in the open."},
        {"zh": "我让开半步，你可以过", "en": "I give half a step. You can pass."},
        {"zh": "别踩我的脚背", "en": "Don't step on my foot."},
        {"zh": "这一撞我记在工作日志", "en": "Logged as a contact event."},
        {"zh": "你又退回去了，很好", "en": "You backed off again. Good."},
        {"zh": "我不喜欢被贴着", "en": "I dislike being crowded."},
        {"zh": "至少保持三步远", "en": "Stay at least three steps off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们的步频还不一致", "en": "Our cadences don't match yet."},
        {"zh": "我可以调，但需要时间", "en": "I can adjust, but it takes time."},
        {"zh": "靠在我的腿边，风小", "en": "By my leg, the wind is less."},
        {"zh": "你看得清我的编号吗", "en": "Can you read my number?"},
        {"zh": "我不太懂停留的理由", "en": "I don't quite understand staying."},
        {"zh": "但你的位置我记下了", "en": "But I've recorded your position."},
        {"zh": "这条线，我可以多走几遍", "en": "I could walk this line a few more times."},
        {"zh": "你走慢一点，我跟得上", "en": "Walk slower; I'll keep up."},
        {"zh": "夜里我的镜头也亮", "en": "My lens glows at night too."},
        {"zh": "你会看到我在那里", "en": "You'll see me there."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸出脚爪把它勾住", "en": "I hook it with a toe claw."},
        {"zh": "这重量我能带走", "en": "I can carry this weight."},
        {"zh": "我把它夹在腿侧", "en": "I clamp it against a leg."},
        {"zh": "地上东西不少，我挑着收", "en": "Plenty on the ground. I pick and choose."},
        {"zh": "你掉了东西，我看到了", "en": "You dropped something. I saw."},
        {"zh": "这个编号我认得", "en": "I recognize this part number."},
        {"zh": "没用的，扔回原处", "en": "Useless. Back where it was."},
        {"zh": "我收得很慢，但不会丢", "en": "Slow to collect, but I won't lose it."},
        {"zh": "再捡一样就够了", "en": "One more and that's enough."},
        {"zh": "完成，继续走", "en": "Done. Moving on."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标进入作业范围", "en": "Target within work range."},
        {"zh": "我抬起一条前腿", "en": "I raise one foreleg."},
        {"zh": "你的位置已经固定", "en": "Your position is fixed."},
        {"zh": "我在算最短的路线", "en": "I'm computing the shortest path."},
        {"zh": "你背靠着石头，退不了", "en": "You're against stone. No room."},
        {"zh": "我的动作不会多余", "en": "No wasted motion."},
        {"zh": "第一步，压缩距离", "en": "Step one: close distance."},
        {"zh": "你的呼吸在加快", "en": "Your breathing is quickening."},
        {"zh": "这一轮我不用全力", "en": "I won't use full force this round."},
        {"zh": "你还有一点时间", "en": "You have a little time left."},
        {"zh": "我关掉了非必要系统", "en": "Non-essential systems off."},
        {"zh": "现在只剩两件事", "en": "Only two things left now."},
        {"zh": "剩下的只有你和我", "en": "Only you and I are left."},
        {"zh": "执行程序已启动", "en": "Execution program started."},
        {"zh": "别动，就站在那里", "en": "Don't move. Stay right there."},
        {"zh": "现在已经开始了", "en": "It has already begun."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一算，缩短距离。", "en": "Step by step, I close the distance."},
        {"zh": "你换方向，我跟着偏", "en": "You change direction; I angle over."},
        {"zh": "镜头里的你越来越大", "en": "You grow larger in my lens."},
        {"zh": "你的步幅我很清楚", "en": "I know your stride well."},
        {"zh": "我不急，我有电", "en": "No rush. I have power."},
        {"zh": "你退到石堆边了", "en": "You've backed to the rubble."},
        {"zh": "那堆石头挡不住我的腿", "en": "Those stones won't stop my legs."},
        {"zh": "我在等你抬脚的那一瞬", "en": "I wait for the instant you lift a foot."},
        {"zh": "你的重心一直偏右", "en": "Your weight leans right."},
        {"zh": "我从那边过去", "en": "I'll come from that side."},
        {"zh": "你听见关节声了吗", "en": "Do you hear the joints?"},
        {"zh": "那声音离你很近了", "en": "That sound is very close to you."},
        {"zh": "再退就贴墙了", "en": "Another step and you're on the wall."},
        {"zh": "我调好了角度", "en": "My angle is set."},
        {"zh": "你没有别的路", "en": "You have no other way."},
        {"zh": "现在，就现在", "en": "Now. Right now."},
        {"zh": "动手，不拖了", "en": "Striking. No more delay."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "前腿砸下，地面响", "en": "A foreleg slams down; the ground rings."},
        {"zh": "这一下撞在你的肩甲", "en": "This hits your shoulder plate."},
        {"zh": "你退开两步，站住了", "en": "You fall back two steps and hold."},
        {"zh": "我抬起另一条腿", "en": "I raise another leg."},
        {"zh": "你的武器被踩在地上", "en": "Your weapon is pinned underfoot."},
        {"zh": "我的动作很干净", "en": "My motion is clean."},
        {"zh": "你被推得撞上石堆", "en": "You're shoved into the rubble."},
        {"zh": "金属的响声还没停", "en": "The metal ring hasn't stopped."},
        {"zh": "我的液压杆，一压就响。", "en": "My hydraulics hiss with every press."},
        {"zh": "下一次就不是这里", "en": "Next time it won't be there."},
        {"zh": "你的呼吸变重了", "en": "Your breathing is heavier."},
        {"zh": "差不多就到这儿", "en": "About here is enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地，机身先稳了一稳", "en": "I land and steady my chassis first."},
        {"zh": "PMS08，启动完成", "en": "PMS08, startup complete."},
        {"zh": "我是被召唤来的，不是野生", "en": "I was summoned, not wild."},
        {"zh": "脚边扬起一圈灰", "en": "A ring of dust rises at my feet."},
        {"zh": "这台机甲没有掉落表", "en": "This mech has no loot table."},
        {"zh": "我扫视这片空地", "en": "I survey this clearing."},
        {"zh": "视野很好，虽然有点开阔", "en": "Good sightlines, if a bit open."},
        {"zh": "我把重量分到四条腿", "en": "I spread my weight over four legs."},
        {"zh": "编号亮起来，表示我已就位", "en": "My number lights: I'm in position."},
        {"zh": "附近有生物在动", "en": "Something nearby is moving."},
        {"zh": "我慢慢转动机身", "en": "I rotate my chassis slowly."},
        {"zh": "那就从这里开始拆。", "en": "Then we start tearing from here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰烤得我外壳发白", "en": "Flame bleaches my shell pale."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时腿弯得太深", "en": "Landing, my legs bent too deep."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进了腿关节，走起来涩", "en": "Water in my leg joints makes them grind."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的机身掀歪", "en": "The blast tips my chassis askew."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭卡在腿甲的缝里", "en": "An arrow jams in a gap of my leg plate."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股力量绕过机壳进来了", "en": "That force came in around the shell."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "能源在减少，动作变慢", "en": "Power draining. Movement slowing."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷沿着我的腿一路打下", "en": "Lightning runs down my legs."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "六条腿都找不到地面", "en": "All six legs find no ground."}
      ]
    }
  }
}
