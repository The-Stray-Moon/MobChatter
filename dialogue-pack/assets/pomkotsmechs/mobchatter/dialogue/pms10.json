    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我压着地面行进", "en": "I grind along the ground."},
        {"zh": "履带式的脚步很稳", "en": "My tracked gait is steady."},
        {"zh": "机体重心前倾", "en": "My chassis leans forward."},
        {"zh": "炮口随着我转", "en": "My muzzle turns with me."},
        {"zh": "散热口一路冒白气", "en": "Vents trail white steam."},
        {"zh": "我踩裂了石砖", "en": "I crack the flagstones."},
        {"zh": "我在碎石上打滑", "en": "I skid on the gravel."},
        {"zh": "我一步一响", "en": "Every step rings out."},
        {"zh": "我贴着树线走", "en": "I move along the treeline."},
        {"zh": "我减慢速度观察", "en": "I slow down to observe."},
        {"zh": "装甲缝里漏出光", "en": "Light leaks from my seams."},
        {"zh": "我转向你那一侧", "en": "I pivot toward your side."},
        {"zh": "我调整了步幅", "en": "I adjust my stride."},
        {"zh": "我的影子像座塔", "en": "My shadow is like a tower."}
      ]
    },
