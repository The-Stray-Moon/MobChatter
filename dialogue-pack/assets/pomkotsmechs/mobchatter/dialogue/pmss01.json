{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小步快跑", "en": "I scurry on short legs."},
        {"zh": "我贴着地跑", "en": "I race along low to the ground."},
        {"zh": "金属脚嗒嗒响", "en": "My metal feet patter."},
        {"zh": "我从缝里钻过去", "en": "I squeeze through a gap."},
        {"zh": "我绕到你脚边", "en": "I loop around your feet."},
        {"zh": "我的机身在抖", "en": "My frame rattles."},
        {"zh": "我爬上一块石头", "en": "I clamber onto a stone."},
        {"zh": "转身很快", "en": "I turn very quickly."},
        {"zh": "我在土里留下小坑", "en": "I leave little pits in the dirt."},
        {"zh": "我小，但很快", "en": "Small, but fast."},
        {"zh": "我一路小跑", "en": "I trot the whole way."},
        {"zh": "我数着地上的石子", "en": "I clatter over the pebbles."},
        {"zh": "我压低机身冲刺", "en": "I duck low and sprint."},
        {"zh": "我蹦一下再跑", "en": "A hop, then a run."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "待机，但没关", "en": "Standby, not off."},
        {"zh": "我在扫四周", "en": "I sweep the surroundings."},
        {"zh": "地方不大，我够用", "en": "Small space, plenty for me."},
        {"zh": "我在磨小车轮", "en": "I am wearing in my treads."},
        {"zh": "我个头小，藏得住", "en": "I am small enough to hide."},
        {"zh": "我等一声响", "en": "Waiting for a sound."},
        {"zh": "我摆了摆机枪口", "en": "I wiggle my barrel."},
        {"zh": "风比我还高", "en": "The wind is taller than me."},
        {"zh": "我停在一块砖上", "en": "I stop on a brick."},
        {"zh": "这高度视野正好", "en": "This height gives a good view."},
        {"zh": "我还挺有精神", "en": "I still have some power."},
        {"zh": "没人注意小机甲", "en": "Nobody notices a tiny mech."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你低头才看得见", "en": "You have to look down to see me."},
        {"zh": "你踩得到我", "en": "You could step on me."},
        {"zh": "别抬脚", "en": "Do not lift that foot."},
        {"zh": "我仰头看你", "en": "I look up at you."},
        {"zh": "太高了，看得我脖子疼", "en": "So tall my neck aches."},
        {"zh": "你身上有我够不到的地方", "en": "There are parts of you I cannot reach."},
        {"zh": "我数你的鞋带", "en": "I am counting your laces."},
        {"zh": "你一脚的影子就够遮我。", "en": "The shadow of one of your feet hides me."},
        {"zh": "挪一步好吗", "en": "Would you step aside?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打歪了", "en": "I was knocked askew."},
        {"zh": "我的外壳裂了道缝", "en": "A crack in my shell."},
        {"zh": "我翻了个身", "en": "I flipped over."},
        {"zh": "轮子空转了", "en": "My wheels are spinning free."},
        {"zh": "我站不稳", "en": "I cannot steady myself."},
        {"zh": "小型机甲，也是铁的。", "en": "A tiny mech is still iron."},
        {"zh": "还撑得住", "en": "I can still hold."},
        {"zh": "外壳上多了个凹坑", "en": "A new dent in my shell."},
        {"zh": "我会记住", "en": "I will remember."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块金属对我有用", "en": "That metal is useful to me."},
        {"zh": "我够得着吗", "en": "Can I reach it?"},
        {"zh": "小小一块就够了", "en": "One small piece is enough."},
        {"zh": "我伸出一只短臂", "en": "I extend a short arm."},
        {"zh": "别放太高", "en": "Do not put it up high."},
        {"zh": "我踮起来了", "en": "I am on my toes."},
        {"zh": "这螺丝不错", "en": "That screw looks good."},
        {"zh": "够到了", "en": "Got it."},
        {"zh": "我抱着不撒手", "en": "I hug it and do not let go."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被弹开了", "en": "I got knocked aside."},
        {"zh": "我翻身爬起来", "en": "I roll over and right myself."},
        {"zh": "我太小了，别挤", "en": "I am tiny, do not crowd me."},
        {"zh": "我的机身凹了一角", "en": "A corner of my frame dented."},
        {"zh": "车轮空转了两圈", "en": "My wheels spun twice."},
        {"zh": "我贴着你裤腿", "en": "I press against your trouser leg."},
        {"zh": "你动一下我就滚出去", "en": "One move and I roll away."},
        {"zh": "我比看起来硬", "en": "I am harder than I look."},
        {"zh": "我又爬回来了", "en": "I climb right back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这是单人机体", "en": "This is a single-unit chassis."},
        {"zh": "我没有配对接口", "en": "I have no pairing port."},
        {"zh": "这里太小了", "en": "This is too cramped."},
        {"zh": "我忙着警戒", "en": "I am busy on watch."},
        {"zh": "别挡住我的视线", "en": "Do not block my view."},
        {"zh": "我不作回应", "en": "I give no reply."},
        {"zh": "这台机器只有我", "en": "This machine is only me."},
        {"zh": "指令里没有这一条", "en": "That is not in my orders."},
        {"zh": "我待机了", "en": "I am on standby."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "小东西我能拿", "en": "I can carry small things."},
        {"zh": "我用短臂夹住", "en": "I clamp it with a short arm."},
        {"zh": "这点零件不错", "en": "These parts are decent."},
        {"zh": "我拖得动", "en": "I can drag it."},
        {"zh": "塞进机身夹层", "en": "I stuff it into my chassis gap."},
        {"zh": "我一下就拿走了", "en": "I grab it in one go."},
        {"zh": "掉在地上我先看见的", "en": "I saw it fall first."},
        {"zh": "我还拿得动第二件", "en": "I can carry one more."},
        {"zh": "它是我的了", "en": "That one is mine."},
        {"zh": "藏到石缝里", "en": "I hide it in a crack."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "镜头捕捉到你了", "en": "My lens has you."},
        {"zh": "先打腿", "en": "I go for the legs first."},
        {"zh": "你站那么高也躲不开", "en": "Standing tall will not save you."},
        {"zh": "我的炮口已经抬起", "en": "My barrel is up."},
        {"zh": "目标锁定：踝部", "en": "Target locked: ankle height."},
        {"zh": "我跑得比你转身快", "en": "I am faster than your turn."},
        {"zh": "这台机甲不好惹", "en": "This mech is not to be trifled with."},
        {"zh": "我开始靠近", "en": "I start closing in."},
        {"zh": "别人小看我，吃了亏", "en": "Others got hurt by underestimating me."},
        {"zh": "你的脚下是我的战场", "en": "Under your feet is my battlefield."},
        {"zh": "别想踩我", "en": "Do not try to stomp me."},
        {"zh": "我先开一枪", "en": "I fire first."},
        {"zh": "我的马达声就是警告", "en": "My motor whine is your warning."},
        {"zh": "现在开始跑吧", "en": "Start running now."},
        {"zh": "你只有两条腿", "en": "You have only two legs."},
        {"zh": "我瞄准那条缝", "en": "I aim at that gap."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕到你的脚后", "en": "I move behind your heel."},
        {"zh": "你转身我就闪", "en": "Turn and I dart away."},
        {"zh": "我一直在你脚边画圈", "en": "I circle your feet."},
        {"zh": "你跳起来就看不见我", "en": "Jump and you lose sight of me."},
        {"zh": "我躲在你鞋的阴影里", "en": "I hide in your boot's shadow."},
        {"zh": "你的脚一抬起就完了", "en": "Lift that foot and it is over."},
        {"zh": "我跑得比你落脚快", "en": "I am quicker than your step."},
        {"zh": "你的视线太低", "en": "Your eyeline is too high."},
        {"zh": "我要的只是你的踝", "en": "All I need is your ankle."},
        {"zh": "再等半秒", "en": "Half a second more."},
        {"zh": "我在砖缝之间穿梭", "en": "I weave between the brick gaps."},
        {"zh": "你的护甲在膝盖以下很薄", "en": "Your armor is thin below the knee."},
        {"zh": "你的脚步声，我一步不落。", "en": "I count every footfall you make."},
        {"zh": "我从这头跑到那头", "en": "I dash from one side to the other."},
        {"zh": "你踩空了就轮到我了", "en": "Miss a step and it is my turn."},
        {"zh": "别想用脚踢我", "en": "Do not try to kick me."},
        {"zh": "我已经在你身后", "en": "I am already behind you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扫你的脚踝", "en": "I rake your ankle."},
        {"zh": "小口径也够疼", "en": "Small caliber still stings."},
        {"zh": "我撞你的小腿", "en": "I ram your shin."},
        {"zh": "你脚踝一歪，轮子碾过去。", "en": "Your ankle buckles; my wheels roll over it."},
        {"zh": "我的轮子从你鞋上碾过去", "en": "My wheels ran over your boot."},
        {"zh": "这一击用了全部输出", "en": "That used my full output."},
        {"zh": "我一枪擦过你的膝盖", "en": "My shot grazed your knee."},
        {"zh": "你低头的时候我已经退了", "en": "By the time you look down I am gone."},
        {"zh": "别小看这一下", "en": "Do not dismiss that one."},
        {"zh": "你的脚背露着", "en": "Your instep is exposed."},
        {"zh": "打完我就撤", "en": "Hit and withdraw."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "小型机体上线", "en": "Tiny unit online."},
        {"zh": "我小到差点被忽略", "en": "So small I was nearly missed."},
        {"zh": "我从地上弹起来", "en": "I bounce up off the ground."},
        {"zh": "这地方对我太大了", "en": "This place is huge to me."},
        {"zh": "我的灯亮了一下", "en": "My light blinked on."},
        {"zh": "我调整了平衡", "en": "I trim my balance."},
        {"zh": "我站在行李旁边", "en": "I stand beside the luggage."},
        {"zh": "我抬起小炮口", "en": "I raise my little barrel."},
        {"zh": "地上有我的影子", "en": "My shadow falls on the ground."},
        {"zh": "我扫了一圈", "en": "I do a quick sweep."},
        {"zh": "我缩到石头旁边", "en": "I tuck beside a stone."},
        {"zh": "好，开始工作", "en": "Right, starting work."}
      ]
    },
