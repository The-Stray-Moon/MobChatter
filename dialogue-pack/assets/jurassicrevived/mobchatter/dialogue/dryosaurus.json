{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在蕨叶间小步跑。", "en": "I jog in short steps between the ferns."},
        {"zh": "我两条后腿弹得很快。", "en": "My hind legs spring quickly."},
        {"zh": "尾巴帮我保持平衡。", "en": "My tail keeps me balanced."},
        {"zh": "我跟着前面那几只。", "en": "I follow the few ahead of me."},
        {"zh": "林子里有我们的脚印。", "en": "Our tracks run through the wood."},
        {"zh": "我低头啃了一口蕨。", "en": "I take a bite of fern."},
        {"zh": "我抬头看有没有危险。", "en": "I look up for danger."},
        {"zh": "这里是我出生的林子。", "en": "This is the wood where I was born."},
        {"zh": "我绕过一棵大树根。", "en": "I go around a big tree root."},
        {"zh": "我跑起来很轻。", "en": "I run lightly."},
        {"zh": "我一停，全群都停。", "en": "When I stop, the whole herd stops."},
        {"zh": "我踩过一片落叶。", "en": "I step through a patch of fallen leaves."},
        {"zh": "我回头看了看队伍。", "en": "I look back at the herd."},
        {"zh": "我跟得更紧了。", "en": "I press closer to them."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在树荫下喘气。", "en": "I stand in the shade, catching my breath."},
        {"zh": "我的脖子很细。", "en": "My neck is slender."},
        {"zh": "我慢慢嚼着叶子。", "en": "I chew leaves slowly."},
        {"zh": "我们一群，跑得比林子还快。", "en": "The herd outruns the forest."},
        {"zh": "我把头侧向林子那边。", "en": "I tilt my head toward the trees."},
        {"zh": "有风吹过树冠。", "en": "Wind passes through the canopy."},
        {"zh": "我前爪轻轻点地。", "en": "My forepaws tap the ground."},
        {"zh": "我在等同伴。", "en": "I'm waiting for my herd."},
        {"zh": "这片林子的蕨很嫩。", "en": "The ferns here are tender."},
        {"zh": "我弯下脖子喝水。", "en": "I bend my neck to drink."},
        {"zh": "水浅得刚够喝。", "en": "The water is shallow."},
        {"zh": "天色还早得很。", "en": "It's still early."},
        {"zh": "我把头往蕨叶里伸。", "en": "I push my head into the ferns."},
        {"zh": "这里能挡住风。", "en": "The wind doesn't reach here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站着没动。", "en": "You're standing still."},
        {"zh": "我确实看见了。", "en": "I saw you."},
        {"zh": "我比你先退了一步。", "en": "I stepped back before you did."},
        {"zh": "我们一群在林中，腿很轻。", "en": "A herd in the wood, all light on our feet."},
        {"zh": "那还算是好的。", "en": "That's something."},
        {"zh": "你挡在蕨丛的小径上。", "en": "You're blocking the fern path."},
        {"zh": "我往边上让。", "en": "I'll go around."},
        {"zh": "这片蕨林是我们群的。", "en": "This fern grove belongs to my herd."},
        {"zh": "你别踩我们的脚印。", "en": "Don't step on our tracks."},
        {"zh": "我们随时能跑。", "en": "We can run at any moment."},
        {"zh": "我的尾巴轻轻甩着。", "en": "My tail swings gently."},
        {"zh": "你们人走路真慢。", "en": "Your kind walks so slowly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你这下打在我肋上。", "en": "That landed on my ribs."},
        {"zh": "我身子好小。", "en": "I'm so small."},
        {"zh": "我两条后腿一软，差点跪下。", "en": "My hind legs buckle and I almost kneel."},
        {"zh": "我往蕨丛后头挪了半步。", "en": "I shuffled half a step behind the ferns."},
        {"zh": "腿一软，差点跪在蕨叶上。", "en": "My legs buckled onto the ferns."},
        {"zh": "我还能跑得动，森林里我最快。", "en": "I can still run; fastest in the forest."},
        {"zh": "我低头看了自己的腿。", "en": "I looked down at my own legs."},
        {"zh": "同伴正叫我回去。", "en": "The herd is calling me."},
        {"zh": "我往林子里退。", "en": "I back into the trees."},
        {"zh": "我只会跑，不会咬。", "en": "I only run; I do not bite."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里拿的是蕨叶？", "en": "Is that a fern frond in your hand?"},
        {"zh": "那东西我吃。", "en": "I eat that."},
        {"zh": "低到你膝盖那儿。", "en": "Down to your knee height."},
        {"zh": "我得先看一看。", "en": "Let me look first."},
        {"zh": "我的同伴也想要。", "en": "My herd wants some too."},
        {"zh": "你只有一把。", "en": "You only have one bundle."},
        {"zh": "那不够我们分。", "en": "Not enough to share."},
        {"zh": "你放着，我自己来。", "en": "Leave it. I'll take it."},
        {"zh": "我们六只一起，跑得很快。", "en": "Six of us together, and fast."},
        {"zh": "你退开，我才敢吃蕨叶。", "en": "Step back, then I'll dare eat the fern."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你在蕨丛里撞上我。", "en": "You hit me in the ferns."},
        {"zh": "我的后腿打了个趔趄。", "en": "My hind legs stumbled."},
        {"zh": "我弹开了一步。", "en": "I sprang back a step."},
        {"zh": "尾巴被你踩了一下。", "en": "You stepped on my tail."},
        {"zh": "我太小了，经不起。", "en": "I'm small. I can't take it."},
        {"zh": "我们一起撞在树干上。", "en": "We hit a tree trunk together."},
        {"zh": "晃了两下才站稳。", "en": "Two wobbles before I steadied."},
        {"zh": "你自己退开了。", "en": "You backed off."},
        {"zh": "我身上掉了些绒。", "en": "Some down came off me."},
        {"zh": "我赶紧跑开。", "en": "I hurried away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里的同伴很多。", "en": "There are many in this wood."},
        {"zh": "我们肩挨着肩吃草。", "en": "We graze shoulder to shoulder."},
        {"zh": "你别靠近我们。", "en": "Don't come near."},
        {"zh": "她跑得比我快，我跟不上。", "en": "She runs faster than I can follow."},
        {"zh": "我们前后跟着。", "en": "We follow each other in a line."},
        {"zh": "这是我认识的最久的一只。", "en": "The one I've known longest."},
        {"zh": "我们靠尾巴打招呼。", "en": "We greet with our tails."},
        {"zh": "风一吹，我们就散开。", "en": "When the wind comes, we scatter."},
        {"zh": "这片蕨丛能藏住我们。", "en": "These ferns can hide us."},
        {"zh": "你可以回你的群里了。", "en": "You can go back to your herd."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起来了。", "en": "I picked it up in my mouth."},
        {"zh": "是一片叶子。", "en": "It's a leaf."},
        {"zh": "这东西从你兜里掉的？", "en": "Did this fall from your pocket?"},
        {"zh": "这硬果子啃不动。", "en": "This hard fruit won't chew."},
        {"zh": "我把它吐掉了。", "en": "I spat it out."},
        {"zh": "我扒开落叶找了两下。", "en": "I pawed through the leaf litter."},
        {"zh": "落叶底下什么也没有。", "en": "Nothing under the leaf litter."},
        {"zh": "我抬头看看别处。", "en": "I look elsewhere."},
        {"zh": "这味道太奇怪。", "en": "This smells strange."},
        {"zh": "我又低头啃起蕨叶。", "en": "I lower my head to the ferns again."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里有响动。", "en": "A sound in the wood."},
        {"zh": "我停下来了。", "en": "I stopped."},
        {"zh": "同伴都抬头了。", "en": "The herd has all looked up."},
        {"zh": "蕨叶那边有东西在动。", "en": "Something moves beyond the ferns."},
        {"zh": "不是我们这样的。", "en": "Not one of us."},
        {"zh": "我往树林里退了半步。", "en": "I stepped half a pace into the trees."},
        {"zh": "我还没开始跑。", "en": "I'm not running yet."},
        {"zh": "再看一眼吧。", "en": "Look again."},
        {"zh": "它一动也没动。", "en": "It hasn't moved."},
        {"zh": "那我就先跑。", "en": "I'll run first."},
        {"zh": "我听见树枝被拨开。", "en": "I hear branches pushed aside."},
        {"zh": "树影里那团东西靠近了。", "en": "That shape in the tree shadows is closing in."},
        {"zh": "我把后腿蹬进落叶里。", "en": "I plant my hind legs in the leaf litter."},
        {"zh": "下一步就要跳了。", "en": "One more step and I jump."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着蕨叶跑。", "en": "I run low through the ferns."},
        {"zh": "它们都跟着我。", "en": "They all follow me."},
        {"zh": "脚步声在身后。", "en": "Footsteps behind."},
        {"zh": "我跳过一个树根。", "en": "I jump a root."},
        {"zh": "林子越密越好。", "en": "The denser the wood, the better."},
        {"zh": "我从树干间穿过去。", "en": "I slip between trunks."},
        {"zh": "它还在后面追。", "en": "It's still chasing."},
        {"zh": "我们分开了。", "en": "We scattered."},
        {"zh": "我往低处的坡跑。", "en": "I run lower down the slope."},
        {"zh": "那边有条浅沟。", "en": "There's a shallow ditch there."},
        {"zh": "我跃过一丛倒木。", "en": "I leap over a fallen log."},
        {"zh": "转弯的时候我差点滑倒。", "en": "I nearly slipped on the turn."},
        {"zh": "它没我熟悉这片林子。", "en": "It doesn't know this wood like I do."},
        {"zh": "我又加快了一点。", "en": "I sped up a little."},
        {"zh": "前面有片空地。", "en": "There's a clearing ahead."},
        {"zh": "我不敢往空地跑。", "en": "I don't dare run into the open."},
        {"zh": "沿着树线跑最安全。", "en": "Running along the treeline is safest."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "后腿一蹬，扬起落叶。", "en": "A kick of my hind leg throws up leaves."},
        {"zh": "二十点血，跑得比咬得快。", "en": "Twenty health, and I run faster than I bite."},
        {"zh": "但够我跑了。", "en": "But it's enough to run."},
        {"zh": "我低着头顶你的膝盖。", "en": "Head low, I butt your knee."},
        {"zh": "我蹿回到树后面。", "en": "I darted back behind a tree."},
        {"zh": "这一撞把力气全用光了。", "en": "That shove used up all my strength."},
        {"zh": "我在你腿边啃了一下。", "en": "I nipped at your leg."},
        {"zh": "我的牙是平的。", "en": "My teeth are flat."},
        {"zh": "我咬不动你。", "en": "I can't bite through you."},
        {"zh": "我还是跑吧。", "en": "I'll just run."},
        {"zh": "我跑的时候不回头看。", "en": "I don't look back when I run."},
        {"zh": "同伴们在叫我。", "en": "The herd is calling."},
        {"zh": "我们往林子里钻。", "en": "We duck into the trees."},
        {"zh": "腿在抖，可我还是冲了。", "en": "My legs shake, but I charge anyway."},
        {"zh": "但它们还能跑。", "en": "But they can still run."},
        {"zh": "我又蹬了一下。", "en": "I kicked once more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树林里跑出来。", "en": "I come running out of the wood."},
        {"zh": "后面还跟着几只。", "en": "A few more follow behind."},
        {"zh": "蕨叶还在我嘴边。", "en": "Fern fronds still in my mouth."},
        {"zh": "这里的林子很密。", "en": "The wood here is thick."},
        {"zh": "我竖起脖子停住。", "en": "I freeze with my neck up."},
        {"zh": "然后又抬起头。", "en": "Then looked up again."},
        {"zh": "我的脚趾落地没声。", "en": "My toes land silently."},
        {"zh": "树影把我藏住了。", "en": "The tree shadows hide me."},
        {"zh": "我们刚到这儿。", "en": "We just arrived here."},
        {"zh": "这就是我们的林子。", "en": "This is our wood."},
        {"zh": "我把尾巴甩向一边。", "en": "I swing my tail to one side."},
        {"zh": "你的靴子踩断了一根蕨。", "en": "Your boot snapped a fern."},
        {"zh": "刚破壳就盯住你的靴子。", "en": "Fresh from the egg, I fix on your boots."},
        {"zh": "我退到同伴中间去。", "en": "I back into the middle of the herd."},
        {"zh": "我们互相挤着。", "en": "We press against each other."},
        {"zh": "我们一起跑了。", "en": "We ran off together."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一靠近我就往外跑。", "en": "Fire nears and I bolt."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔了一小下，我立刻就起来了。", "en": "A short fall and I was up at once."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水不深，可我还是慌了。", "en": "The water was shallow but I panicked."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把树叶都震落了。", "en": "The blast shook the leaves down."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭擦过我的腿，蕨叶都摇。", "en": "The arrow grazed my leg and the ferns shook."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一道光扫过来，我眼睛发花。", "en": "A flash swept by and my eyes blurred."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里的蕨不够吃。", "en": "There aren't enough ferns in this wood."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声让整片林子都响了。", "en": "Thunder filled the whole wood."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有草，我站不住。", "en": "No grass here. I can't stay up."}
      ]
    }
  }
}
