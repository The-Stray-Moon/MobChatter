{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我穿过丛林，两脚落地。", "en": "I cross the jungle on two legs."},
        {"zh": "藤蔓扫过我的头冠。", "en": "Vines brush my crest."},
        {"zh": "我一步一步压着腐叶。", "en": "I tread rotting leaves."},
        {"zh": "我的尾在树根间摆。", "en": "My tail sways between roots."},
        {"zh": "低一下头，躲过横枝。", "en": "Duck the head, clear the branch."},
        {"zh": "我在湿泥上留下三趾印。", "en": "Three toes print the wet mud."},
        {"zh": "我朝同伴的方向偏。", "en": "I angle toward my pack."},
        {"zh": "每一步先试，腐叶不响", "en": "I test each step; the litter stays silent."},
        {"zh": "树影像水一样从我背上过。", "en": "Tree shadow washes over my back."},
        {"zh": "我停下嗅了嗅空气。", "en": "I stop and sniff the air."},
        {"zh": "我从两棵树之间挤过。", "en": "I squeeze between two trunks."},
        {"zh": "我的爪抓着湿滑的树根。", "en": "My claws grip damp roots."},
        {"zh": "我绕过一片积水。", "en": "I skirt a pool of water."},
        {"zh": "我抬起头，看着树冠。", "en": "I raise my head to the canopy."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我张了张嘴，露出牙。", "en": "I open my jaw and show teeth."},
        {"zh": "我的头冠在暗处发亮。", "en": "My crest catches what light there is."},
        {"zh": "我伏在树根间不动。", "en": "I lie still among the roots."},
        {"zh": "丛林的蝉声忽高忽低。", "en": "The jungle cicadas swell and fade."},
        {"zh": "我扭头舔了舔肩。", "en": "I turn to lick my shoulder."},
        {"zh": "同伴在对面的树后。", "en": "My pack is behind the far tree."},
        {"zh": "我听见水在滴。", "en": "I hear water dripping."},
        {"zh": "我的前爪抬起来又落下。", "en": "I lift a foreclaw and set it down."},
        {"zh": "阳光斑斑点点落在我身上。", "en": "Dappled sun falls across me."},
        {"zh": "我在等树上掉下什么。", "en": "I wait for something to fall."},
        {"zh": "我伏在腐叶上，一动不动。", "en": "I lie still on rotting leaves."},
        {"zh": "我伏在腐叶里，等小兽经过", "en": "I lie in the leaf litter, waiting for small game."},
        {"zh": "我数着林子里的声响。", "en": "I count the sounds of the wood."},
        {"zh": "我抬起头闻树冠。", "en": "I lift my head to scent the canopy."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "这层腐叶归我管", "en": "This leaf litter is under my watch."},
        {"zh": "你站着，太高了。", "en": "You stand too tall."},
        {"zh": "你身上有陌生的味。", "en": "You carry an unfamiliar scent."},
        {"zh": "我的头冠朝你张开。", "en": "My crest flares toward you."},
        {"zh": "你手里的铁晃我的眼", "en": "The iron in your hand dazzles me."},
        {"zh": "我的同伴在你后面。", "en": "My pack is behind you."},
        {"zh": "你要跑，先想清楚。", "en": "If you run, think it through."},
        {"zh": "我讨厌被这样盯着。", "en": "I hate being stared at like that."},
        {"zh": "你的腿是最好咬的。", "en": "Your legs are the easiest bite."},
        {"zh": "三个方向，我们同时来", "en": "Three directions, all at once."},
        {"zh": "丛林让声音传不远。", "en": "The jungle muffles sound."},
        {"zh": "所以你不必喊。", "en": "So no need to shout."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的侧腹被抓开。", "en": "My flank is torn open."},
        {"zh": "我低叫着退开。", "en": "I cry low and pull back."},
        {"zh": "血滴在腐叶上。", "en": "Blood drops on rotting leaves."},
        {"zh": "你打得比看起来重。", "en": "You hit harder than you look."},
        {"zh": "后腿一软，我歪了一下", "en": "My hind leg buckles and I lurch."},
        {"zh": "同伴靠过来。", "en": "My pack draws near."},
        {"zh": "我还能窜进蕨丛。", "en": "I can still bolt into the ferns."},
        {"zh": "头冠垂下来了。", "en": "My crest has drooped."},
        {"zh": "丛林里的两只，都记住你的味道了。", "en": "Both of us in the jungle remember your scent."},
        {"zh": "不退了。", "en": "No more retreating."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "是刚死的？", "en": "Freshly killed?"},
        {"zh": "丢到这边来。", "en": "Drop it over here."},
        {"zh": "我闻到生肉的味道，丛林里。", "en": "I smell raw meat in the jungle."},
        {"zh": "这东西对我们不够分。", "en": "Not enough for the pack."},
        {"zh": "放下，然后退到树那边。", "en": "Set it down, then back off to the trees."},
        {"zh": "丛林的冠，一左一右。", "en": "A crest on each side of my head."},
        {"zh": "太旧了，我不要。", "en": "Too old, I'll pass."},
        {"zh": "你会被围住。", "en": "You'll be surrounded."},
        {"zh": "同伴也在看着。", "en": "The pack is watching too."},
        {"zh": "再拿一点出来。", "en": "Bring out a little more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的肋上。", "en": "You hit my ribs."},
        {"zh": "我侧过身避开。", "en": "I turn my flank away."},
        {"zh": "我的骨头是空的。", "en": "My bones are hollow."},
        {"zh": "丛林里，我的冠是红的。", "en": "In the jungle, my crest is red."},
        {"zh": "你踩到我的尾。", "en": "You stepped on my tail."},
        {"zh": "我退了半步，抬起爪。", "en": "I give half a step and lift a claw."},
        {"zh": "你被我的肩撞开了。", "en": "My shoulder knocks you aside."},
        {"zh": "这点推撞不碍事。", "en": "That shove is nothing."},
        {"zh": "藤蔓被我们扯断了。", "en": "We snapped a vine."},
        {"zh": "撞第三次，牙就到了", "en": "A third bump and my teeth arrive."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的群里自有同类。", "en": "My pack has its own kind."},
        {"zh": "这事要在巢边做。", "en": "That happens by the nest."},
        {"zh": "你和我们不同族。", "en": "You aren't of our bloodline."},
        {"zh": "我先得吃一顿。", "en": "I need to eat first."},
        {"zh": "冠是给同族看的", "en": "The crest is for my own kind."},
        {"zh": "林子里有很多同类。", "en": "There are many of my kind here."},
        {"zh": "我还没巡完这片林子。", "en": "I haven't finished patrolling this wood."},
        {"zh": "有别的味在靠近。", "en": "Another scent is closing in."},
        {"zh": "我要去巡我的地。", "en": "I'm off to patrol my ground."},
        {"zh": "你走吧，我不送。", "en": "Go on, I won't see you off."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一块肉，我叼走。", "en": "A piece of meat, I take it."},
        {"zh": "我低头咬住骨头。", "en": "I lower my head and grip a bone."},
        {"zh": "硬东西，我不吃。", "en": "Hard things are not for me."},
        {"zh": "我把头骨甩了甩。", "en": "I shake the skull about."},
        {"zh": "同伴闻到味了。", "en": "The pack has caught the scent."},
        {"zh": "肉归我，爪先按住", "en": "The meat is mine; my claw pins it."},
        {"zh": "地上有血的味。", "en": "The smell of blood on the ground."},
        {"zh": "咬下一小块，嚼了嚼", "en": "I bite off a piece and chew it."},
        {"zh": "吐掉了。", "en": "I spat it out."},
        {"zh": "埋起来，省得被抢。", "en": "I'll bury it before it's taken."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你背对我做事。", "en": "You turned your back to work."},
        {"zh": "这个位置我扑得到。", "en": "I can reach you from here."},
        {"zh": "我的头冠张开了。", "en": "My crest has flared."},
        {"zh": "同伴从两侧靠近。", "en": "The pack closes from both sides."},
        {"zh": "你退向水边了。", "en": "You're backing toward the water."},
        {"zh": "那对你有害。", "en": "That's bad for you."},
        {"zh": "我压低身子往前压。", "en": "I crouch and press forward."},
        {"zh": "一步一数，我算着。", "en": "Step by step, I'm tallying."},
        {"zh": "双冠一挑，我听见你心跳", "en": "My twin crests flick up; I hear your heart."},
        {"zh": "一次扑击就够。", "en": "One pounce will do it."},
        {"zh": "别喊。", "en": "Don't shout."},
        {"zh": "该开场了。", "en": "Time to open the hunt."},
        {"zh": "我先抬爪。", "en": "My claw lifts first."},
        {"zh": "你抬手了，太晚。", "en": "You raised your hand. Too late."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着树靠近。", "en": "I close in around the trees."},
        {"zh": "丛林的绿把我藏住。", "en": "The jungle's green hides me."},
        {"zh": "你听见叶子响了吗？", "en": "Did you hear the leaves?"},
        {"zh": "那是我换位置的声音。", "en": "That was me shifting."},
        {"zh": "你的脚陷进泥了。", "en": "Your foot sank into mud."},
        {"zh": "你跑不快。", "en": "You won't run fast."},
        {"zh": "同伴在你左侧。", "en": "The pack is on your left."},
        {"zh": "我在右侧。", "en": "I'm on the right."},
        {"zh": "爪子咬住湿泥。", "en": "My claws bite the wet mud."},
        {"zh": "我咬穿过更厚的皮", "en": "I have bitten through thicker hide."},
        {"zh": "还剩两步。", "en": "Two steps left."},
        {"zh": "你还在看树。", "en": "You're still watching the trees."},
        {"zh": "低头。", "en": "Look down."},
        {"zh": "其实在下面。", "en": "Actually it's below."},
        {"zh": "我起来了。", "en": "I'm up."},
        {"zh": "别退。", "en": "Don't retreat."},
        {"zh": "我头上两道冠，很显眼。", "en": "The twin crests on my head stand out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳起来，牙先到。", "en": "I leap, teeth leading."},
        {"zh": "一口咬在你小腿。", "en": "My jaw clamps your calf."},
        {"zh": "爪撕开了你的裤。", "en": "My claws rip your trousers."},
        {"zh": "被踢开，我绕半圈再扑", "en": "Kicked off, I circle and pounce again."},
        {"zh": "我落地翻身又上。", "en": "I land, roll, and come again."},
        {"zh": "同伴咬上另一边。", "en": "The pack bites from the other side."},
        {"zh": "你退到了树根上。", "en": "You're on the roots now."},
        {"zh": "我的头冠全张开了。", "en": "My crest is fully spread."},
        {"zh": "血渗进腐叶。", "en": "Blood seeps into the leaf litter."},
        {"zh": "我挂着不松。", "en": "I hang on and don't let go."},
        {"zh": "你甩了两次。", "en": "You shook twice."},
        {"zh": "第二次我才松口。", "en": "Only on the second did I let go."},
        {"zh": "我退了半步，两片头冠还朝着你。", "en": "I step back half a pace, my twin crests still facing you."},
        {"zh": "我在换角度。", "en": "I'm changing angle."},
        {"zh": "你的膝在打颤。", "en": "Your knees are knocking."},
        {"zh": "下一口更深。", "en": "The next bite goes deeper."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从丛林里迈出来。", "en": "I step out of the jungle."},
        {"zh": "树冠下多了一副影子。", "en": "Another shape beneath the canopy."},
        {"zh": "同伴跟着我出来。", "en": "My pack follows me out."},
        {"zh": "我的头冠上挂着水。", "en": "Water beads on my crest."},
        {"zh": "我先闻了闻这片湿土。", "en": "I sniff the damp soil first."},
        {"zh": "湿泥很适合留足迹。", "en": "Wet mud holds tracks well."},
        {"zh": "我把头抬到枝叶间。", "en": "I lift my head into the branches."},
        {"zh": "蝉声忽然停了。", "en": "The cicadas stop all at once."},
        {"zh": "我抖了抖腿上的泥。", "en": "I shake the mud off my legs."},
        {"zh": "我们散开成一圈。", "en": "We spread into a ring."},
        {"zh": "林子很静。", "en": "The wood is quiet."},
        {"zh": "有活的在这。", "en": "Something living is here."},
        {"zh": "我头顶的两片冠，先露出来。", "en": "My twin crests show first."},
        {"zh": "我们也到了。", "en": "So have we."},
        {"zh": "这片林子能养我们。", "en": "This jungle can feed us."},
        {"zh": "我动身了。", "en": "I set off."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的头冠。", "en": "Fire singes my crest."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上摔下，骨头响。", "en": "I fall down the slope, bones cracking."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从喉咙灌进肺。", "en": "Water floods down into my lungs."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "丛林里的双冠，两只一伙。", "en": "Jungle twin-crests, two to a pair."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西钉进我的颈。", "en": "That pinned into my neck."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的腿一僵。", "en": "Magic stiffens my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿久了，我跑不动。", "en": "Long hunger, and I can't run."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈中枯树，我伏低了身。", "en": "Lightning splits a dead tree; I duck low."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有蕨丛可躲。", "en": "No ferns to hide in, in the void."}
      ]
    }
  }
}
