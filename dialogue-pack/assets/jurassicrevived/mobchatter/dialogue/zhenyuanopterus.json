{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从崖边跳下去。", "en": "I drop off the cliff edge."},
        {"zh": "翅膀张开有一丈。", "en": "My wings spread wide."},
        {"zh": "海岸的风托着我。", "en": "The sea wind holds me up."},
        {"zh": "我低低掠过浪面。", "en": "I skim low over the waves."},
        {"zh": "脚爪收起在腹下。", "en": "My feet tuck under my belly."},
        {"zh": "山脊的气流在推我。", "en": "Ridge lift pushes me along."},
        {"zh": "我在沙丘上盘旋。", "en": "I circle above the dunes."},
        {"zh": "翼膜在风里发响。", "en": "My wing membrane crackles."},
        {"zh": "我顺着海岸线飞。", "en": "I follow the coastline."},
        {"zh": "我慢慢落在一块礁石上。", "en": "I settle onto a rock."},
        {"zh": "翅膀收得很慢。", "en": "My wings fold slowly."},
        {"zh": "砂粒被风卷起来。", "en": "Sand lifts in the wind."},
        {"zh": "我从沙滩上起身。", "en": "I lift off from the beach."},
        {"zh": "我在热气流里升高。", "en": "I climb in the warm updraft."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在礁石顶上。", "en": "I stand on the rock top."},
        {"zh": "海风把我的羽吹乱。", "en": "Sea wind ruffles my feathers."},
        {"zh": "我低头看着水面。", "en": "I look down at the water."},
        {"zh": "喉囊动了一下。", "en": "My throat pouch shifts."},
        {"zh": "我在崖上晒太阳。", "en": "I bask on the cliff."},
        {"zh": "远处的浪很白。", "en": "The far waves are white."},
        {"zh": "我把嘴张开散散热。", "en": "I open my beak to cool off."},
        {"zh": "脚下石头很硬。", "en": "The stone is hard underfoot."},
        {"zh": "这里能看到很远。", "en": "I can see very far from here."},
        {"zh": "我侧了侧头。", "en": "I tilt my head."},
        {"zh": "同伴在另一块崖上。", "en": "My flock is on the other cliff."},
        {"zh": "风停了一会儿。", "en": "The wind died for a moment."},
        {"zh": "羽毛间有盐晶。", "en": "Salt crystals in my feathers."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在下面显得很小。", "en": "You look small from down there."},
        {"zh": "你抬头的姿势我看过很多次。", "en": "I've seen that upward look before."},
        {"zh": "我的翼展开很宽。", "en": "My wingspan is very wide."},
        {"zh": "你的箭够到这么高吗。", "en": "Can your arrows reach this high?"},
        {"zh": "我只有落下来时才慢。", "en": "I'm only slow when landing."},
        {"zh": "你身上有鱼的味。", "en": "You smell of fish."},
        {"zh": "我不下来你就抓不到。", "en": "If I don't come down, you can't catch me."},
        {"zh": "沙子进了你的眼睛吧。", "en": "Sand in your eyes, isn't it."},
        {"zh": "风今天朝你那边吹。", "en": "The wind blows your way today."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一根飞羽断了。", "en": "A flight feather snapped."},
        {"zh": "我在空中歪了一下。", "en": "I wobbled midair."},
        {"zh": "翼膜被划开。", "en": "My wing membrane is torn."},
        {"zh": "我落得不太稳。", "en": "My landing was unsteady."},
        {"zh": "血洒在羽毛上。", "en": "Blood on my feathers."},
        {"zh": "滑翔还撑得住。", "en": "I can still glide."},
        {"zh": "这点伤不影响滑翔。", "en": "This won't spoil my glide."},
        {"zh": "我重新张开翼。", "en": "I spread my wings again."},
        {"zh": "我记得这道人影。", "en": "I know that silhouette."},
        {"zh": "我还是能逃的。", "en": "I can still get away."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里那条是给我？", "en": "That fish is for me?"},
        {"zh": "把鱼举高一点。", "en": "Hold the fish higher."},
        {"zh": "我盘旋一圈就下来。", "en": "One circle and I'll come down."},
        {"zh": "这味道逆风都能闻到。", "en": "I smell it even upwind."},
        {"zh": "放在那块石头上。", "en": "Put it on that stone."},
        {"zh": "我落下来很慢。", "en": "I land slowly."},
        {"zh": "别趁我落时动手。", "en": "Don't strike while I'm landing."},
        {"zh": "这条不算小。", "en": "That's not a small one."},
        {"zh": "我再盘旋一圈。", "en": "One more circle."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得侧了一下。", "en": "I banked from the impact."},
        {"zh": "脚下的石头滑。", "en": "The stone is slick under me."},
        {"zh": "沙子全飞起来了。", "en": "Sand went everywhere."},
        {"zh": "我的翅膀不好收。", "en": "My wings don't fold quickly."},
        {"zh": "退开，我要起飞。", "en": "Back off. I'm taking off."},
        {"zh": "这一下撞得很实。", "en": "That was a solid hit."},
        {"zh": "我跌跌撞撞站稳。", "en": "I steadied myself."},
        {"zh": "你的头撞到我胸口。", "en": "Your head hit my chest."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "只在同一片崖上找。", "en": "Only on the same cliff."},
        {"zh": "先看谁飞得久。", "en": "Let's see who stays up longer."},
        {"zh": "我要一个能落脚的巢。", "en": "I need a nest with a footing."},
        {"zh": "海风太大，说不清。", "en": "The wind is too loud for this."},
        {"zh": "你爬不上来。", "en": "You can't climb up here."},
        {"zh": "等我换完羽。", "en": "After I've moulted."},
        {"zh": "安静时再说。", "en": "When it's quiet."},
        {"zh": "我要去海边了。", "en": "I'm going to the shore."},
        {"zh": "别在崖边站着。", "en": "Don't stand at the cliff edge."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一条鱼，只够我叼着飞一圈。", "en": "One fish is worth one lap in the air."},
        {"zh": "在空中接着。", "en": "I catch it in the air."},
        {"zh": "它掉到水里了。", "en": "It fell into the water."},
        {"zh": "这条还很滑。", "en": "This one is still slippery."},
        {"zh": "地上还有半条。", "en": "Half of one on the ground."},
        {"zh": "我带着飞一段。", "en": "I carry it a short flight."},
        {"zh": "味道有点旧。", "en": "It tastes a little old."},
        {"zh": "扔上来试试。", "en": "Throw it up and see."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "下面的影子在动。", "en": "A shadow moves below."},
        {"zh": "那东西不小。", "en": "That one is not small."},
        {"zh": "我收起一只翼。", "en": "I tuck one wing in."},
        {"zh": "我开始往下压。", "en": "I begin to drop."},
        {"zh": "它在往崖下躲。", "en": "It's hiding under the cliff."},
        {"zh": "这个角度我看得清。", "en": "I see it clear from this angle."},
        {"zh": "风把它味道送来。", "en": "The wind brings its scent."},
        {"zh": "同伴也开始低了。", "en": "My flock is dropping too."},
        {"zh": "崖下的影子，我数着。", "en": "Under the cliff, I count the shadow."},
        {"zh": "它发现我了。", "en": "It spotted me."},
        {"zh": "这次不用盘旋。", "en": "No need to circle this time."},
        {"zh": "再往下降一点。", "en": "A little lower."},
        {"zh": "落下去就咬。", "en": "Bite as I land."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直跟着它的味道。", "en": "I follow its scent."},
        {"zh": "我在它上风处。", "en": "I'm above its windward side."},
        {"zh": "它正在往前跑。", "en": "It's running forward."},
        {"zh": "我落得比它快。", "en": "I come down faster than it runs."},
        {"zh": "沙尘遮住我。", "en": "Dust covers me."},
        {"zh": "它的路线要经过那块岩。", "en": "Its path passes that rock."},
        {"zh": "我等它暴露后背。", "en": "I wait for its back to show."},
        {"zh": "翼声藏不住。", "en": "My wingbeats can't be hidden."},
        {"zh": "再压低十格。", "en": "Ten blocks lower."},
        {"zh": "四只爪子张开，我对准了你。", "en": "All four claws open, aimed at you."},
        {"zh": "这角度正好俯冲。", "en": "This angle is right for a dive."},
        {"zh": "它往开阔地去了。", "en": "It moved into the open."},
        {"zh": "我等它回头看。", "en": "I wait for it to look back."},
        {"zh": "这个角度对了。", "en": "The angle is right."},
        {"zh": "我现在就落下。", "en": "I drop now."},
        {"zh": "抓向它的肩膀。", "en": "Go for its shoulders."},
        {"zh": "一次就能成。", "en": "One pass will do it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从上面俯冲！", "en": "I dive from above!"},
        {"zh": "爪子抓进肩膀。", "en": "My claws sink into a shoulder."},
        {"zh": "喙啄你的头。", "en": "My beak pecks your head."},
        {"zh": "我落地又弹起。", "en": "I land and spring back up."},
        {"zh": "这一下带着海风。", "en": "That one came with sea wind."},
        {"zh": "抓一下就飞。", "en": "Grab once and fly."},
        {"zh": "你的帽子飞了。", "en": "Your hat went flying."},
        {"zh": "我压低翼尖，从你头顶掠过。", "en": "I dip my wingtips and skim over your head."},
        {"zh": "再从后面来。", "en": "Coming from behind this time."},
        {"zh": "我的爪子很硬。", "en": "My claws are hard."},
        {"zh": "沙迷了你的眼。", "en": "Sand fills your eyes."},
        {"zh": "这一爪够深。", "en": "That claw went deep."},
        {"zh": "我退到礁石上。", "en": "I retreat to the rock."},
        {"zh": "再来落一次地。", "en": "Landing once more."},
        {"zh": "我从沙滩上起飞，影子扫过你。", "en": "I lift off the beach and my shadow sweeps you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "崖顶多了个影子。", "en": "A shape appeared on the cliff top."},
        {"zh": "两只跟着我落在石上。", "en": "Two landed on the rock with me."},
        {"zh": "海风吹得正好。", "en": "The sea wind is just right."},
        {"zh": "沙滩上有我的影子。", "en": "My shadow crosses the beach."},
        {"zh": "我低飞过山脊。", "en": "I fly low over the ridge."},
        {"zh": "翅膀还带着海水。", "en": "Seawater still on my wings."},
        {"zh": "这里比崖上暖。", "en": "Warmer here than the cliff."},
        {"zh": "我看了一圈落点。", "en": "I scan for a landing spot."},
        {"zh": "同伴在叫着。", "en": "The flock is calling."},
        {"zh": "我从高空滑下。", "en": "I slide down from high up."},
        {"zh": "我慢慢收了翅膀。", "en": "I folded my wings slowly."},
        {"zh": "风向没有变。", "en": "The wind hasn't shifted."},
        {"zh": "我落在那块凸岩上。", "en": "I land on the outcrop."},
        {"zh": "该找吃的了。", "en": "Time to find food."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛烧得卷起来。", "en": "My feathers curled in the fire."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我砸在沙上，翻了一圈。", "en": "I struck the sand and rolled."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "海水灌进我的羽。", "en": "Seawater soaked my feathers."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我在空中推开。", "en": "The blast pushed me aside midair."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "东西扎穿了我的翼。", "en": "Something pierced my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我掉了高度。", "en": "The light cost me altitude."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我旁边的崖上。", "en": "The bolt hit the cliff beside me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面全是空气。", "en": "Nothing but air below."}
      ]
    }
  }
}
