    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我背着颈盾走", "en": "I walk with my frill on my back."},
        {"zh": "四只脚踩进松针", "en": "Four feet press the pine needles."},
        {"zh": "我走得不快", "en": "I do not walk fast."},
        {"zh": "我沿针叶林边缘走", "en": "I move along the conifer edge."},
        {"zh": "颈盾扫开树枝", "en": "My frill pushes the branches aside."},
        {"zh": "我一边吃一边走", "en": "I eat as I go."},
        {"zh": "松针在脚下软", "en": "The needles are soft underfoot."},
        {"zh": "我的头低着找草", "en": "I keep my head down for grass."},
        {"zh": "我慢慢挪动身子", "en": "I shift my bulk along."},
        {"zh": "我用喙扯下一片叶", "en": "I pull a leaf off with my beak."},
        {"zh": "一步一晃地走", "en": "I sway with each step."},
        {"zh": "我回头看了看小群", "en": "I glance back at the little herd."}
      ]
    },
    "idle": {
