{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我个子小，跑得快", "en": "I'm small, and I run fast."},
        {"zh": "两脚一蹬就窜出去", "en": "Two legs and I'm off."},
        {"zh": "我走路总在回头", "en": "I keep looking back as I walk."},
        {"zh": "林子里的草丛能藏住我", "en": "The grass in the wood hides me."},
        {"zh": "脚趾细，踩得轻", "en": "My toes are thin and land light."},
        {"zh": "一群小的挤在一起走", "en": "A crowd of small ones walks together."},
        {"zh": "我抬头看，又低下头", "en": "I look up, then down."},
        {"zh": "跑一段，忽然停住", "en": "Run a stretch, then stop dead."},
        {"zh": "我往树后面绕", "en": "I circle behind a tree."},
        {"zh": "我比灌木高不了多少", "en": "I'm barely taller than the shrubs."},
        {"zh": "腿细，可弹得高", "en": "Thin legs, but they spring well."},
        {"zh": "草地上有我的小印子", "en": "My small prints are on the grass."},
        {"zh": "我一边走一边听", "en": "I listen as I walk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，脖子伸得长", "en": "I stand with my neck stretched."},
        {"zh": "一只眼睛在看你", "en": "One eye is on you."},
        {"zh": "这群里我最矮", "en": "I'm the shortest in this group."},
        {"zh": "我在听林子的动静", "en": "I'm listening to the wood."},
        {"zh": "风一动，我就想跑", "en": "When the wind moves, I want to run."},
        {"zh": "我的尾巴很细", "en": "My tail is thin."},
        {"zh": "我抖落肩上的碎叶", "en": "I shake the leaf bits off my shoulders."},
        {"zh": "这棵树的树皮被啃过", "en": "This tree's bark has been chewed."},
        {"zh": "我慢慢往草丛里挪", "en": "I edge slowly into the grass."},
        {"zh": "我们几只挤在一起", "en": "A few of us huddle."},
        {"zh": "有影子从头顶过", "en": "A shadow passed overhead."},
        {"zh": "我又抬头看了一眼", "en": "I glanced up again."},
        {"zh": "这片林子我们很熟", "en": "We know this wood well."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你长得太高了", "en": "You're too tall."},
        {"zh": "我在算要跑多远", "en": "I'm working out how far to run."},
        {"zh": "你一动我就跑", "en": "One move from you and I run."},
        {"zh": "我不好吃，我很瘦", "en": "I'm not worth eating; I'm skinny."},
        {"zh": "你脚下有我的一群", "en": "My herd is under your feet."},
        {"zh": "我们躲在树后面", "en": "We're hiding behind the tree."},
        {"zh": "你别过来就行", "en": "Just don't come over."},
        {"zh": "你的影子太长", "en": "Your shadow is too long."},
        {"zh": "我认得这里的每个洞", "en": "I know every burrow here."},
        {"zh": "我们不一定怕你", "en": "We're not necessarily afraid."},
        {"zh": "我们几只一起看着你", "en": "A few of us are watching you together."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被一撞倒下", "en": "I was knocked down."},
        {"zh": "我很小，这一下很重", "en": "I'm small; that was heavy."},
        {"zh": "我拖着一条腿跑", "en": "I run dragging a leg."},
        {"zh": "这一下，我喘不上气", "en": "That knocked the wind out of me."},
        {"zh": "我退进草丛里", "en": "I retreat into the grass."},
        {"zh": "我不叫，叫了会招来大的", "en": "I don't cry out; it draws bigger things."},
        {"zh": "我两条腿发抖", "en": "My legs are shaking."},
        {"zh": "腿还在，我还能窜", "en": "My legs are here; I can still bolt."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子，我喜欢叶子", "en": "Leaves, I like them."},
        {"zh": "你手里那点太小", "en": "That handful is too small."},
        {"zh": "嫩的叶子才好", "en": "Tender ones only."},
        {"zh": "你蹲下来，我够不着", "en": "Crouch down; I can't reach."},
        {"zh": "这叶子闻着刚长出来", "en": "These leaves smell newly grown."},
        {"zh": "我们几只一起吃", "en": "A few of us eat together."},
        {"zh": "你先退开几步", "en": "Step back first."},
        {"zh": "放地上就可以", "en": "On the ground is fine."},
        {"zh": "别的我一口不吃", "en": "I don't want anything else."},
        {"zh": "这一片叶子太老了", "en": "This leaf is a bit old."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得翻了", "en": "I was knocked over."},
        {"zh": "我这么小，一碰就倒", "en": "I'm small; one touch and I fall."},
        {"zh": "你的脚比我整个身子大", "en": "Your foot is bigger than my whole body."},
        {"zh": "我爬起来就跑", "en": "I scramble up and run."},
        {"zh": "这一下，我肩骨疼", "en": "That hurt my shoulder."},
        {"zh": "我藏在草里，你还是撞到", "en": "I hid in the grass and you still hit me."},
        {"zh": "我退后了，别踩我", "en": "I back off; don't step."},
        {"zh": "我们挤在树根边", "en": "We crowd by the roots."},
        {"zh": "我钻到树后面", "en": "I slip behind the tree."},
        {"zh": "别用脚推，我自己走", "en": "Don't push with your foot; I'll go myself."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这一群里有两只是一对", "en": "Two in this group are a pair."},
        {"zh": "我们凑在一起就热闹", "en": "We're lively when we gather."},
        {"zh": "小的已经有几窝了", "en": "There are already a few broods."},
        {"zh": "这种事不必细说", "en": "No need to go into detail."},
        {"zh": "我听见它们的叫声", "en": "I hear their calls."},
        {"zh": "我们挤在一块睡", "en": "We sleep crowded together."},
        {"zh": "你再退开一点", "en": "Step back a bit."},
        {"zh": "天色就快黑了", "en": "It's nearly dark."},
        {"zh": "谁在那边叫我", "en": "Who's calling over there?"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起一片叶子", "en": "I pick up a leaf."},
        {"zh": "这个东西太重", "en": "This is too heavy."},
        {"zh": "地上有种子粒", "en": "Seeds on the ground."},
        {"zh": "我用嘴夹着跑", "en": "I run with it in my beak."},
        {"zh": "掉了东西，先看有没有危险", "en": "Something fell; let me check for danger first."},
        {"zh": "这个不怎么好吃", "en": "This isn't good."},
        {"zh": "我叼着叼着掉了", "en": "I dropped it while carrying."},
        {"zh": "地上这些，我们分", "en": "We'll share what's on the ground."},
        {"zh": "棱齿龙只吃嫩叶。", "en": "A hypsilophodon only eats tender leaves."},
        {"zh": "这颗留给同群的", "en": "This one I leave for the herd."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有个影子", "en": "A shadow over there."},
        {"zh": "我先停下来看", "en": "I stop first."},
        {"zh": "不是我们群的", "en": "Not from our group."},
        {"zh": "距离还远得很", "en": "Still far."},
        {"zh": "我先看它走哪边", "en": "Let me see which way it goes."},
        {"zh": "我们共有几只", "en": "There are a few of us."},
        {"zh": "就冲着那个方向", "en": "That direction."},
        {"zh": "前面的草丛在动", "en": "The grass is moving."},
        {"zh": "它在找什么东西", "en": "What's it looking for?"},
        {"zh": "那我再等一等", "en": "Wait a little."},
        {"zh": "它没看这一边", "en": "It's not looking this way."},
        {"zh": "我先躲进草里", "en": "I hide first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一点一点挪开", "en": "I shift away bit by bit."},
        {"zh": "它在往这边走", "en": "It's coming this way."},
        {"zh": "我退到树底下", "en": "I retreat under the tree."},
        {"zh": "声东击西，我们懂", "en": "We know about feints."},
        {"zh": "它又一次转过头", "en": "It turned again."},
        {"zh": "再退开两步远", "en": "Two steps back."},
        {"zh": "这片草丛够高了", "en": "The grass is tall enough."},
        {"zh": "我的尾巴碰到草叶", "en": "My tail brushed a leaf."},
        {"zh": "它挡住了去路", "en": "It's blocking the way."},
        {"zh": "我慢慢蹲下身", "en": "I crouch slowly."},
        {"zh": "等它走远了吧", "en": "Wait for it to go."},
        {"zh": "它还在那里站着", "en": "It's still there."},
        {"zh": "我往草丛后头爬", "en": "I crawl backward."},
        {"zh": "就差这一点了", "en": "Almost."},
        {"zh": "它终于转过身去", "en": "It turned away."},
        {"zh": "现在就赶紧跑", "en": "Now run."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我踢了它一脚", "en": "I kicked once."},
        {"zh": "我用脑袋去撞", "en": "I butt with my head."},
        {"zh": "这一下没什么力", "en": "That had little force."},
        {"zh": "我咬它的手指", "en": "I bite at its hand."},
        {"zh": "我被它甩开了", "en": "I got thrown off."},
        {"zh": "我弹起来又扑", "en": "I spring up and lunge."},
        {"zh": "爪子划了一下", "en": "A small claw rake."},
        {"zh": "这一下是为了跑", "en": "That one was to get away."},
        {"zh": "我边打边往后退", "en": "I fight while retreating."},
        {"zh": "我转身就跑了", "en": "I ran."},
        {"zh": "腿一蹬，沙子飞起来", "en": "I kick and sand sprays."},
        {"zh": "我咬住它的袖子", "en": "I bite into its sleeve."},
        {"zh": "这一下我用了全身的力", "en": "I put my whole body into that."},
        {"zh": "我挨了一下，还是冲上去", "en": "I took a hit and still charged."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我先是抬头，再低头", "en": "I look up first, then down."},
        {"zh": "一群里多了一只小的", "en": "One more small one in the group."},
        {"zh": "这里的草丛很密", "en": "The grass is dense here."},
        {"zh": "我落脚落得很轻", "en": "My landing is light."},
        {"zh": "我抖了抖后腿", "en": "I shook my legs."},
        {"zh": "有风，我赶紧低头", "en": "Wind came; I ducked fast."},
        {"zh": "我看着周围，准备跑", "en": "I scan around, ready to run."},
        {"zh": "我不是自然生的", "en": "I wasn't born naturally."},
        {"zh": "我躲到树根旁边", "en": "I hide by the roots."},
        {"zh": "我抬头看见树很高", "en": "I look up; the trees are very tall."},
        {"zh": "我先吃了一口", "en": "I took one bite first."},
        {"zh": "我跟着群里走", "en": "I follow the group."},
        {"zh": "地上有我小小的脚印", "en": "My small prints are on the ground."},
        {"zh": "我先听一听，再看", "en": "I listen first, then look."},
        {"zh": "我站得很直，很紧张", "en": "I stand very straight, very tense."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的尾巴", "en": "Fire singed my tail."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水太深，我蹬不到底", "en": "Too deep; my feet can't reach."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我滚进草丛", "en": "The blast rolled me into the grass."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西擦过我的背", "en": "Something grazed my back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，我整只僵住", "en": "The spell hit and I froze."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "一饿着，腿就发软", "en": "Hungry and my legs go weak."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我吓坏了", "en": "Lightning struck and I bolted."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有草丛可以躲", "en": "No grass in the void to hide in."}
      ]
    }
  }
}
