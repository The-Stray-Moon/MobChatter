{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我张开巨翼滑翔", "en": "I glide on huge wings."},
        {"zh": "我从山脊上掠过", "en": "I sweep over the ridge."},
        {"zh": "我的影子扫过山坡", "en": "My shadow rakes the slope."},
        {"zh": "我落到岩石上站住", "en": "I land on a rock and stand."},
        {"zh": "我用四条腿走动", "en": "I move on four limbs."},
        {"zh": "我沿着山道低飞", "en": "I fly low along the trail."},
        {"zh": "我拍了两下巨翼", "en": "I beat my great wings twice."},
        {"zh": "我从云下滑出去", "en": "I slide out from under the clouds."},
        {"zh": "我慢慢收翅下降", "en": "I fold my wings and descend."},
        {"zh": "我横着飞过山谷", "en": "I cross the valley."},
        {"zh": "我在崖边停了一下", "en": "I pause at the cliff edge."},
        {"zh": "我又浮起来一段", "en": "I lift off again for a stretch."},
        {"zh": "我顺着上升气流爬高", "en": "I climb on the updraft."},
        {"zh": "我绕着山峰转半圈", "en": "I circle half around the peak."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在悬崖顶上", "en": "I stand on the cliff top."},
        {"zh": "我把长喙垂着", "en": "My long beak hangs down."},
        {"zh": "我的翼收在身侧", "en": "My wings are folded at my sides."},
        {"zh": "山风吹过我的羽毛", "en": "The mountain wind moves my feathers."},
        {"zh": "我慢慢转头看山谷", "en": "I turn my head to the valley."},
        {"zh": "我立在风里不动翅", "en": "I stand in the wind, wings still."},
        {"zh": "我的身体比看起来轻", "en": "I am lighter than I look."},
        {"zh": "我在等风变强", "en": "I am waiting for the wind to rise."},
        {"zh": "山风够稳，可以起飞。", "en": "The mountain wind is steady enough to launch."},
        {"zh": "我抖了抖翼尖", "en": "I shake my wingtips."},
        {"zh": "我蹲下去又站起来", "en": "I crouch and rise again."},
        {"zh": "岩石被我的脚抓得很稳", "en": "My feet grip the rock."},
        {"zh": "我慢慢合上眼睛", "en": "I close my eyes slowly."},
        {"zh": "我站在岩柱上，像块石头。", "en": "I perch on the spire like a stone."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从崖上低头看你", "en": "I look down at you from the cliff."},
        {"zh": "风神翼龙的翼展压着你。", "en": "A quetzalcoatlus wingspan bears down on you."},
        {"zh": "我慢慢把脖子压低", "en": "I lower my long neck."},
        {"zh": "我的影子盖着你", "en": "My shadow covers you."},
        {"zh": "我歪着头打量", "en": "I tilt my head and consider."},
        {"zh": "我是不是该飞走", "en": "Perhaps I should fly off."},
        {"zh": "你抬头时，我已经很高。", "en": "By the time you look up, I'm already high."},
        {"zh": "我不太在意你", "en": "I am not much concerned with you."},
        {"zh": "我张开了一点翼", "en": "I open my wings a little."},
        {"zh": "风把我往崖边推", "en": "The wind nudges me to the edge."},
        {"zh": "我一点也没有恶意", "en": "I mean no harm."},
        {"zh": "我又把身体转正", "en": "I square my body again."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我晃了一下才稳住", "en": "I sway before steadying."},
        {"zh": "翼膜被划开一道口子。", "en": "A gash opened in my wing membrane."},
        {"zh": "我叫了一声退开", "en": "I cry out and back away."},
        {"zh": "我的翼歪在一边", "en": "One wing hangs crooked."},
        {"zh": "我压低身子，护住翼骨。", "en": "I hunch down to guard my wing bones."},
        {"zh": "我慢慢把翼展开", "en": "I slowly spread my wings."},
        {"zh": "我的脚在岩石上打滑", "en": "My feet slip on the rock."},
        {"zh": "我喘声里带着沙", "en": "My breath comes out gritty."},
        {"zh": "我一时飞不利索", "en": "I cannot fly well just now."},
        {"zh": "我又慢慢站直了", "en": "I straighten up again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举着什么样东西", "en": "What have you got up there?"},
        {"zh": "我从崖上看了看", "en": "I look down at it."},
        {"zh": "太小，塞不满我的喙。", "en": "Too small to fill my beak."},
        {"zh": "我伸脖子够了够", "en": "I stretch my neck toward it."},
        {"zh": "这不是我吃的", "en": "That is not my food."},
        {"zh": "我把头收回来", "en": "I draw my head back."},
        {"zh": "我又看向山谷", "en": "I look back at the valley."},
        {"zh": "我对那点东西没胃口", "en": "That thing does not tempt me."},
        {"zh": "我慢慢展开了翼", "en": "I spread my wings."},
        {"zh": "我这就准备走了", "en": "I am about to leave."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，我退了一步", "en": "You bump me and I step back."},
        {"zh": "我张开翼稳住", "en": "I spread my wings to steady."},
        {"zh": "风差点把我吹倒", "en": "The wind nearly tips me over."},
        {"zh": "我把脚抓得更紧", "en": "I grip harder with my feet."},
        {"zh": "我往崖边退了退", "en": "I ease toward the cliff edge."},
        {"zh": "我从你旁边挪开", "en": "I shift away from you."},
        {"zh": "低头看你一眼，你就站住了。", "en": "One glance down, and you stopped."},
        {"zh": "碰这么一下不碍事", "en": "A knock like that is nothing."},
        {"zh": "我又站回岩石上", "en": "I settle back on the rock."},
        {"zh": "我的翼尖扫到了岩壁。", "en": "My wingtip clipped the cliff."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只从云里下来", "en": "Another descends from the clouds."},
        {"zh": "我们并排站在崖上", "en": "We stand side by side on the cliff."},
        {"zh": "它的翼比我宽一些", "en": "Its wings are a little wider than mine."},
        {"zh": "我们一起张开了翼", "en": "We spread our wings together."},
        {"zh": "它先离开了岩石", "en": "It leaves the rock first."},
        {"zh": "我跟着滑出去", "en": "I glide out after it."},
        {"zh": "我们一起绕着山峰", "en": "We circle the peak together."},
        {"zh": "我们都没有叫出声", "en": "Neither of us calls."},
        {"zh": "它往更高处飞", "en": "It climbs higher."},
        {"zh": "我紧紧跟在后面", "en": "I follow behind."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用长喙夹起来。", "en": "I pick it up in my long beak."},
        {"zh": "我用喙甩了两下", "en": "I shake it in my beak."},
        {"zh": "我一仰头咽下去", "en": "I tip my head and swallow."},
        {"zh": "这一口太不够了", "en": "That is not nearly enough."},
        {"zh": "我把它丢下崖", "en": "I drop it off the cliff."},
        {"zh": "我又夹了一块", "en": "I pick up another."},
        {"zh": "我在岩石上蹭了蹭", "en": "I wipe it on the rock."},
        {"zh": "我用爪子把它钉在岩上。", "en": "I pin it to the rock with my talon."},
        {"zh": "我把骨头叼到岩缝里。", "en": "I carry the bone to a crevice."},
        {"zh": "我也就不再管它", "en": "I leave it alone."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见山谷里有东西", "en": "I see something in the valley."},
        {"zh": "我看清了，那能入口。", "en": "I see it clearly now—it'll go down."},
        {"zh": "我的翼张开一半", "en": "My wings open halfway."},
        {"zh": "我朝那个方向倾身", "en": "I lean that way."},
        {"zh": "我慢慢松开脚下的岩石", "en": "I ease off the rock."},
        {"zh": "我在算下坠的距离", "en": "I am judging the drop."},
        {"zh": "我这就下去了", "en": "I am going down."},
        {"zh": "它还在动着呢", "en": "It is still moving."},
        {"zh": "我把长脖子压下去", "en": "I press my long neck down."},
        {"zh": "这个角度我能看到", "en": "I can see it from here."},
        {"zh": "我慢慢站了起来", "en": "I stand up."},
        {"zh": "我准备要起飞了", "en": "I am about to launch."},
        {"zh": "风是从这边吹来", "en": "The wind comes from this side."},
        {"zh": "再等一下就冲", "en": "One moment more and I dive."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我借着山风停在空中。", "en": "I hang in the air on the mountain wind."},
        {"zh": "我的影子在它身上扫", "en": "My shadow sweeps across it."},
        {"zh": "我一圈圈往下沉", "en": "I spiral down a little."},
        {"zh": "它躲到了树后面", "en": "It hides behind a tree."},
        {"zh": "我的翅膀展开像一面帆。", "en": "Spread, my wings look like a sail."},
        {"zh": "风把我推偏了", "en": "The wind pushes me off line."},
        {"zh": "我又扇了两下", "en": "I beat my wings twice."},
        {"zh": "它抬头看了上来", "en": "It has looked up."},
        {"zh": "我心里有数了", "en": "I have my measure."},
        {"zh": "山地的上升气流，我认得。", "en": "I know the mountain thermals."},
        {"zh": "它往开阔地跑", "en": "It runs into the open."},
        {"zh": "现在就是时候", "en": "Now is the time."},
        {"zh": "它跑进了开阔地", "en": "It has run into the open."},
        {"zh": "我把翼收窄一点", "en": "I narrow my wings."},
        {"zh": "我的爪子先伸出去", "en": "My claws reach out first."},
        {"zh": "我在它正上方", "en": "I am directly above it."},
        {"zh": "它根本看不见我", "en": "It cannot see me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从空中直扑下去", "en": "I dive straight down."},
        {"zh": "长喙扎在它身上", "en": "My beak stabs into it."},
        {"zh": "我的影子把它罩住", "en": "My shadow covers it."},
        {"zh": "我一口咬住它的背", "en": "I bite into its back."},
        {"zh": "我的爪子先扣住再啄。", "en": "My talons hook first, then my beak."},
        {"zh": "它被撞得翻了半圈", "en": "It is knocked half over."},
        {"zh": "我扇开翼又上去", "en": "I beat my wings and climb."},
        {"zh": "它躲开我的第一下", "en": "It dodges my first strike."},
        {"zh": "我又一次落下来", "en": "I come down again."},
        {"zh": "我落地的声音很响", "en": "My landing lands hard."},
        {"zh": "我把它踩在岩石上", "en": "I pin it to the rock."},
        {"zh": "我叼着它抬起来", "en": "I lift it in my beak."},
        {"zh": "它一下挣脱了", "en": "It breaks free."},
        {"zh": "我站在原地上", "en": "I stand where I am."},
        {"zh": "我又把翼张开", "en": "I spread my wings again."},
        {"zh": "我这一击用尽力气", "en": "I spent everything on that strike."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从云里穿下来", "en": "I come down through the clouds."},
        {"zh": "巨翼的影子先落在坡上", "en": "My great shadow falls on the slope first."},
        {"zh": "我落在了崖顶", "en": "I land on the cliff top."},
        {"zh": "我收起翅膀站稳", "en": "I fold my wings and settle."},
        {"zh": "山谷里多了一道影子", "en": "A new shadow in the valley."},
        {"zh": "山风把我的羽毛吹开", "en": "The wind spreads my feathers."},
        {"zh": "我慢慢转头看四周", "en": "I turn my head to look around."},
        {"zh": "我的叫声明亮", "en": "My call rings out."},
        {"zh": "我从山那边滑过来", "en": "I glide in from beyond the mountain."},
        {"zh": "岩石被我抓出痕", "en": "My claws mark the rock."},
        {"zh": "我找到了这片高地", "en": "I have found this high ground."},
        {"zh": "我开始往下看", "en": "I begin looking below."},
        {"zh": "这个高度我很满意", "en": "This height suits me."},
        {"zh": "我扇了一下翼", "en": "I beat my wings once."},
        {"zh": "我来这里巡视", "en": "I have come to survey this place."},
        {"zh": "空气从我翼下流过", "en": "Air flows under my wings."}
      ]
    },
