{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扇着翼飞", "en": "I flap my wings."},
        {"zh": "我的翼骨很轻", "en": "The bones in my wings are light."},
        {"zh": "我从沙滩上起飞", "en": "I take off from the beach."},
        {"zh": "我沿着海岸线飞", "en": "I follow the coastline."},
        {"zh": "我张开长喙", "en": "I open my long beak."},
        {"zh": "我在山头盘旋", "en": "I circle over the peaks."},
        {"zh": "海风托着我", "en": "The sea wind carries me."},
        {"zh": "我压低翅膀滑行", "en": "I tilt my wings and glide."},
        {"zh": "我在浪上掠过", "en": "I skim over the waves."},
        {"zh": "我落在礁石上", "en": "I land on the rock."},
        {"zh": "我张开翼晒太阳", "en": "I spread my wings to the sun."},
        {"zh": "我一跃又飞起来", "en": "One leap and I am airborne."},
        {"zh": "我的影子扫过沙滩", "en": "My shadow sweeps the sand."},
        {"zh": "我逆着风往上爬", "en": "I climb against the wind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在礁石上", "en": "I rest on the rock."},
        {"zh": "海风一直在吹", "en": "The sea wind never stops."},
        {"zh": "我在梳自己的翼", "en": "I preen my wings."},
        {"zh": "沙滩上没有人", "en": "The beach is empty."},
        {"zh": "我在看水面的鱼", "en": "I watch for fish in the water."},
        {"zh": "我的喙很长，容易挂到东西", "en": "My long beak snags easily."},
        {"zh": "我抬头看崖顶", "en": "I look up at the cliff."},
        {"zh": "我的翼尖有点破", "en": "My wingtip is a little torn."},
        {"zh": "我不敢在地上久留", "en": "I do not linger on the ground."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站得离崖边太近", "en": "You stand too close to the cliff edge."},
        {"zh": "你的头抬得很高", "en": "You are looking up high."},
        {"zh": "我从上面看见你", "en": "I see you from above."},
        {"zh": "你会不会扔石头", "en": "Will you throw stones?"},
        {"zh": "我的翼展比你张开的手臂宽", "en": "My wingspan is wider than your outstretched arms."},
        {"zh": "你在沙滩上很显眼", "en": "You stand out on the beach."},
        {"zh": "我绕你一圈", "en": "I circle you once."},
        {"zh": "你别伸手抓我的喙", "en": "Do not grab at my beak."},
        {"zh": "你的影子在下面", "en": "Your shadow is below."},
        {"zh": "我落地不会太久", "en": "I will not land long."},
        {"zh": "我落在你身边的石头上", "en": "I land on the stone beside you."},
        {"zh": "你的靴子踩碎了贝壳", "en": "Your boot crushed a shell."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翼被划破了", "en": "My wing is torn."},
        {"zh": "我掉到了沙上", "en": "I dropped onto the sand."},
        {"zh": "有一根骨头响了", "en": "One of my bones clicked."},
        {"zh": "我拖着翼退开", "en": "I drag my wing away."},
        {"zh": "我这一下叫不出来", "en": "I cannot even call out."},
        {"zh": "羽毛落了一地", "en": "Feathers all over the ground."},
        {"zh": "我还没落地", "en": "I have not hit the ground."},
        {"zh": "你别再打我的翼", "en": "Do not hit my wing again."},
        {"zh": "翼骨还连着", "en": "My wing bone still holds."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是鱼吗", "en": "Is that a fish?"},
        {"zh": "你手里有东西在动", "en": "Something is moving in your hand."},
        {"zh": "我绕下来了", "en": "I am coming down."},
        {"zh": "你手里那条鱼还在摆尾巴。", "en": "That fish in your hand is still flapping."},
        {"zh": "我闻到了腥味", "en": "I smell something fishy."},
        {"zh": "这一口刚好够", "en": "That is just enough for one bite."},
        {"zh": "我落在附近", "en": "I land nearby."},
        {"zh": "你再晃一下", "en": "Give it another wiggle."},
        {"zh": "我慢慢走近", "en": "I approach slowly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
