{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小步快走，头一直抬着。", "en": "I trot with my head held high."},
        {"zh": "我走在两只同伴之间。", "en": "I walk between two of my pack."},
        {"zh": "鼻子上的小角不太顶事。", "en": "The small horn on my snout is little use."},
        {"zh": "枯枝在我脚下响。", "en": "Dead twigs crack under me."},
        {"zh": "我沿着林缘往北走。", "en": "I follow the treeline north."},
        {"zh": "尾巴一直左右摆。", "en": "My tail swings side to side."},
        {"zh": "我时不时停下来嗅。", "en": "I stop now and then to sniff."},
        {"zh": "针叶林里，我们的脚印最多。", "en": "Our tracks fill this conifer forest."},
        {"zh": "我走得很轻，前爪不着地。", "en": "My steps are light; my forearms barely touch."},
        {"zh": "我跟着前面的脚印走。", "en": "I keep to the prints ahead."},
        {"zh": "我鼻上有个小冠。", "en": "A small crest sits on my snout."},
        {"zh": "我绕开泥坑走。", "en": "I go around the mud holes."},
        {"zh": "我身上的条纹在光里闪。", "en": "My stripes shift in the light."},
        {"zh": "脚步压着落叶，耳朵竖着。", "en": "My steps press the leaves, ears up."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着不动，脖子伸得老长。", "en": "I stand still with my neck stretched long."},
        {"zh": "我在看树上的东西。", "en": "I am watching something up a tree."},
        {"zh": "同伴在附近刨土。", "en": "My pack digs nearby."},
        {"zh": "我把牙来回磨着。", "en": "I work my teeth against each other."},
        {"zh": "这点个头，得靠群。", "en": "My size means I need the pack."},
        {"zh": "我转头，风从背后来了。", "en": "I turn. Wind at my back."},
        {"zh": "我的爪子很短。", "en": "My claws are short."},
        {"zh": "林子里有鸟扑翅。", "en": "A bird wings through the wood."},
        {"zh": "我把头低下又抬起。", "en": "I dip my head and lift it."},
        {"zh": "我在数同伴的叫声。", "en": "I count my pack's calls."},
        {"zh": "喉咙里滚出一声低叫。", "en": "A low call rolls from my throat."},
        {"zh": "这条小路我走过很多回。", "en": "I have walked this path often."},
        {"zh": "我歪着头听地面。", "en": "I tilt my head to the ground."},
        {"zh": "这里够暖和了。", "en": "Warm enough here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你袖口有新鲜的血味。", "en": "Fresh blood clings to your cuff."},
        {"zh": "我伸长脖子，闻你的高度。", "en": "I stretch my neck to measure your height."},
        {"zh": "你就一个人？", "en": "Are you alone?"},
        {"zh": "我身后的同伴在看你。", "en": "My pack is watching you."},
        {"zh": "你比我们大很多。", "en": "You are much bigger than us."},
        {"zh": "我歪头看你，喉咙发紧。", "en": "I tilt my head, throat tight."},
        {"zh": "你的靴子很新。", "en": "Your boots are new."},
        {"zh": "这是我常走的路。", "en": "This is my usual path."},
        {"zh": "你的手，闻起来有火。", "en": "Your hand smells of fire."},
        {"zh": "别往地上蹲。", "en": "Do not crouch down."},
        {"zh": "我这具小身子，成群才敢叫。", "en": "Small as I am, I only call in a pack."},
        {"zh": "林子里的距离，得留够。", "en": "In the forest, keep your distance."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在地上，滚了一圈。", "en": "I hit the ground and roll."},
        {"zh": "我短促地尖叫。", "en": "I give a short shriek."},
        {"zh": "血从我鼻子上流下来。", "en": "Blood runs down my snout."},
        {"zh": "我一退就是好远。", "en": "I retreat a long way at once."},
        {"zh": "这一下砸得太狠。", "en": "That landed far too hard."},
        {"zh": "后腿一直在发颤。", "en": "My hind legs keep trembling."},
        {"zh": "同伴都围了过来。", "en": "My pack has gathered round."},
        {"zh": "腿还听使唤，我能跑。", "en": "My legs still work; I can run."},
        {"zh": "别一路跟上来。", "en": "Do not follow me along."},
        {"zh": "这一下，我记在你的味上。", "en": "I'll remember this blow by your scent."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到血腥味。", "en": "I smell blood."},
        {"zh": "把它扔给我。", "en": "Throw it to me."},
        {"zh": "我不先动，你先。", "en": "I do not move first. You do."},
        {"zh": "这点东西要分给同伴。", "en": "This must be shared with my pack."},
        {"zh": "我叼着往后退。", "en": "I take it and back away."},
        {"zh": "手别伸过来。", "en": "Keep your hand back."},
        {"zh": "我三两口就吞了。", "en": "Two or three bites and it is gone."},
        {"zh": "这是刚死不久的。", "en": "This one died recently."},
        {"zh": "还能再给点？", "en": "Could there be more?"},
        {"zh": "同伴会围过来。", "en": "My pack will gather."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得歪了半截。", "en": "The knock tips me halfway over."},
        {"zh": "你实在太沉了。", "en": "You are far too heavy."},
        {"zh": "我往旁边跳开。", "en": "I skip aside."},
        {"zh": "同伴会替我挡。", "en": "My pack will cover me."},
        {"zh": "我的架子很轻。", "en": "My frame is light."},
        {"zh": "我一低身，从你腿边溜走。", "en": "I duck low and slip past your legs."},
        {"zh": "这一撞，我记着。", "en": "That bump — I remember it."},
        {"zh": "我们都没摔。", "en": "Neither of us fell."},
        {"zh": "你的脚比我的身子宽。", "en": "Your foot is wider than my body."},
        {"zh": "再推我就咬你。", "en": "Shove again and I bite."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们几只排成一列走。", "en": "A few of us move in a line."},
        {"zh": "这事得等季节。", "en": "That must wait for the season."},
        {"zh": "我把头垂下。", "en": "I lower my head."},
        {"zh": "同伴都在看。", "en": "My pack is watching."},
        {"zh": "我轻叫了两声。", "en": "I call twice, softly."},
        {"zh": "我不适合回答这个。", "en": "I am the wrong one to answer."},
        {"zh": "我转身离开。", "en": "I turn and go."},
        {"zh": "现在时候不对。", "en": "This is not the time."},
        {"zh": "我需要先吃饱。", "en": "I must eat first."},
        {"zh": "回群里去吧。", "en": "Back to the pack."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个能叼住。", "en": "I can carry this."},
        {"zh": "我叼起来跑开。", "en": "I take it and run."},
        {"zh": "不是肉，我不吃。", "en": "Not meat. I will not eat it."},
        {"zh": "我咬了一下就吐。", "en": "I bite and spit."},
        {"zh": "我压在脚下。", "en": "I pin it underfoot."},
        {"zh": "这点东西没用。", "en": "This is no use."},
        {"zh": "我叼回去分给它们。", "en": "I carry it back to share."},
        {"zh": "掉了我也不管。", "en": "If it drops, I leave it."},
        {"zh": "林子里，这是谁丢下的。", "en": "In the woods, who left this?"},
        {"zh": "这算我的了。", "en": "This one is mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的鼻角很小，够用。", "en": "My nose horn is small. It works."},
        {"zh": "你没有同伴。", "en": "You have no pack."},
        {"zh": "我叫了一声，同伴会来。", "en": "I call. My pack will come."},
        {"zh": "细牙最适合咬小腿。", "en": "Fine teeth are made for calves."},
        {"zh": "我先冲，再让开。", "en": "I lunge, then give ground."},
        {"zh": "群猎是这么办的。", "en": "This is how we hunt."},
        {"zh": "我不正面咬。", "en": "I do not bite head on."},
        {"zh": "你太慢了一些。", "en": "You are a little slow."},
        {"zh": "我从蕨丛后绕到你侧后。", "en": "I slip behind you through the ferns."},
        {"zh": "这一口足够。", "en": "One bite will do."},
        {"zh": "快点跑起来。", "en": "Run fast."},
        {"zh": "我要扑过去了。", "en": "I am about to spring."},
        {"zh": "同伴从另一边来。", "en": "My pack comes from the other side."},
        {"zh": "你看过来，我就当你发现了。", "en": "If you look this way, I'll assume you've seen me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我围着你的腿绕。", "en": "I circle your legs."},
        {"zh": "我一步跳一下。", "en": "I hop with every step."},
        {"zh": "你的腿很长，可是慢。", "en": "Long legs, slow feet."},
        {"zh": "你的脚步我数着呢。", "en": "I am counting your footfalls."},
        {"zh": "同伴已经就位。", "en": "My pack is in place."},
        {"zh": "我压低身子再冲。", "en": "I crouch and rush again."},
        {"zh": "你退到林缘了。", "en": "You have reached the wood's edge."},
        {"zh": "我一声短啸，同伴都应了。", "en": "One short cry from me, and my pack answers."},
        {"zh": "风把你的味送到我鼻尖。", "en": "The wind brings your scent to my snout."},
        {"zh": "我再试第二回。", "en": "I try a second time."},
        {"zh": "你转身的时候我咬。", "en": "I bite when you turn."},
        {"zh": "别乱动身子。", "en": "Do not fidget."},
        {"zh": "我每步只挪半格。", "en": "I close in half a block at a time."},
        {"zh": "我从低处来。", "en": "I come in low."},
        {"zh": "小牙一排排，够你受的。", "en": "Rows of small teeth are enough for you."},
        {"zh": "我的吻尖离你只差一截。", "en": "My snout is a hand's width from you."},
        {"zh": "正是这一瞬。", "en": "This very instant."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬上你的腿。", "en": "My teeth close on your leg."},
        {"zh": "我跃起，前爪扣你的腰。", "en": "I leap and hook my foreclaws at your waist."},
        {"zh": "这一下不深。", "en": "That was not deep."},
        {"zh": "我咬完立刻退。", "en": "I bite and retreat at once."},
        {"zh": "我的前爪扒着你的护腿。", "en": "My foreclaws scrabble at your greave."},
        {"zh": "同伴跟着上。", "en": "My pack follows in."},
        {"zh": "你被咬出几个口子。", "en": "You are bitten in several places."},
        {"zh": "我甩头，撕开一点。", "en": "I shake my head and tear."},
        {"zh": "我被打退了。", "en": "I am driven back."},
        {"zh": "你那一脚踢到我了。", "en": "Your kick caught me."},
        {"zh": "我贴身再咬。", "en": "I press in and bite again."},
        {"zh": "血味让我们兴奋。", "en": "Blood excites the pack."},
        {"zh": "牙碰牙，我甩了甩头。", "en": "Tooth clacks on tooth; I shake my head."},
        {"zh": "我从你背后扑上肩。", "en": "I spring onto your shoulder from behind."},
        {"zh": "赶紧跑开去。", "en": "Run off, quickly."},
        {"zh": "紧紧追上去。", "en": "Chase it right down."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我们从林子里出来，四只。", "en": "We come out of the wood, four of us."},
        {"zh": "这一带有我们的味道。", "en": "Our scent is on this ground."},
        {"zh": "我在前，同伴在后。", "en": "I lead. The pack follows."},
        {"zh": "树叶还在我头上。", "en": "Leaves still on my head."},
        {"zh": "针叶林的味道很浓。", "en": "The conifers smell strong."},
        {"zh": "我抬头，把这片林子扫了一遍。", "en": "I raise my head and scan the woods."},
        {"zh": "这里能猎到东西。", "en": "There is game here."},
        {"zh": "我们散开走。", "en": "We spread out."},
        {"zh": "我的脚印很小。", "en": "My prints are small."},
        {"zh": "同伴正在叫。", "en": "My pack is calling."},
        {"zh": "这林子够我们藏。", "en": "This wood hides us well."},
        {"zh": "我一步步走过来。", "en": "I come forward step by step."},
        {"zh": "树线那边，有个影子在动。", "en": "Past the treeline, a shape moves."},
        {"zh": "我先看见了你。", "en": "I saw you first."},
        {"zh": "别动一下身子。", "en": "Do not stir a muscle."},
        {"zh": "我的爪子已经踩进泥里。", "en": "My claws are already in the mud."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的条纹，疼。", "en": "Fire singes my stripes."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上摔下来，摔晕了。", "en": "I fall down the slope, dazed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一下就没过我。", "en": "Water closes over me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被掀翻，爪子抓空了。", "en": "I'm flipped over, claws catching air."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭卡在肋骨间，我喘得尖。", "en": "The arrow wedges between my ribs and my breath whistles."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我腿发软。", "en": "That light weakens my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "肚子空了，走都走不动。", "en": "Empty, I can barely walk."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我钻进灌木。", "en": "Lightning strikes; I dive into brush."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有林子，也没有地。", "en": "No wood here, and no ground."}
      ]
    }
  }
}
