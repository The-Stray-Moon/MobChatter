{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟在同伴的后面", "en": "I follow behind my fellows"},
        {"zh": "我的背上有道浅脊", "en": "A low ridge runs down my back"},
        {"zh": "我踩着林间的腐叶", "en": "I walk the forest litter"},
        {"zh": "我一步一步压低身子", "en": "I lower myself as I walk"},
        {"zh": "我从树干间穿过去", "en": "I pass between the trunks"},
        {"zh": "我绕过一片灌木", "en": "I skirt a patch of brush"},
        {"zh": "我的爪子在地上一抓", "en": "My claws catch the ground"},
        {"zh": "我沿着林边的路走", "en": "I walk the forest's edge"},
        {"zh": "我朝前面的动静走", "en": "I head toward a sound ahead"},
        {"zh": "我小步快走不含糊", "en": "I move at a brisk trot"},
        {"zh": "我的头一直朝前探", "en": "My head probes forward"},
        {"zh": "我在树根间找落脚处", "en": "I pick my footing among the roots"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在一棵倒树旁", "en": "I stop by a fallen tree"},
        {"zh": "我的头微微抬起", "en": "My head is half raised"},
        {"zh": "我的鼻孔动了动", "en": "My nostrils flare"},
        {"zh": "我看着同伴的方向", "en": "I look toward my fellows"},
        {"zh": "我低头嗅了嗅树根", "en": "I sniff at the roots"},
        {"zh": "我没有放松下来", "en": "I have not relaxed"},
        {"zh": "我慢慢把下颚合上", "en": "I close my jaw slowly"},
        {"zh": "我的肩胛一起一伏", "en": "My shoulders rise and fall"},
        {"zh": "我在等下一次机会", "en": "I am waiting for the next chance"},
        {"zh": "我和同伴对看了一眼", "en": "I exchange a glance with a fellow"},
        {"zh": "我把前脚在地上按了按", "en": "I press a forefoot to the ground"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的头猛地一偏", "en": "My head jerks toward you"},
        {"zh": "你在这片林子中间", "en": "You are in the middle of this wood"},
        {"zh": "我上半身抬起来", "en": "I raise my forequarters"},
        {"zh": "你也是猎物吗", "en": "Are you prey too"},
        {"zh": "我的牙露出来一点", "en": "My teeth show a little"},
        {"zh": "我不单独行动", "en": "I do not hunt alone"},
        {"zh": "你听见我同伴的叫声了吗", "en": "Do you hear my fellows calling"},
        {"zh": "我短短跨了一步", "en": "I take a quick short stride"},
        {"zh": "你站得很稳，奇怪", "en": "You stand very steadily, odd"},
        {"zh": "我把脖子往前伸", "en": "I stretch my neck forward"},
        {"zh": "你退后我也不会停", "en": "You back off and I still will not stop"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我后脚一蹬退开", "en": "I push off my hind legs"},
        {"zh": "我低吼着甩了甩头", "en": "I growl and shake my head"},
        {"zh": "我的侧腹在疼", "en": "My flank is hurting"},
        {"zh": "这一下拖慢了我的步", "en": "That dragged my pace down"},
        {"zh": "我把吻部伏得更低", "en": "I bring my snout lower still"},
        {"zh": "我挪到同伴那边", "en": "I move toward my fellows"},
        {"zh": "我的牙还咬着", "en": "My teeth are still bared"},
        {"zh": "我还跑得起来", "en": "I can still run"},
        {"zh": "这不影响我追击", "en": "This will not stop the hunt"},
        {"zh": "我半边身子发紧", "en": "One side of me is tight"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你把肉扔下来", "en": "You throw meat down"},
        {"zh": "我的头压低了一点", "en": "My head dips a little"},
        {"zh": "我上前一步又停", "en": "I step in and stop"},
        {"zh": "同伴也在看着", "en": "My fellows are watching too"},
        {"zh": "我先把这块叼走", "en": "I take this piece first"},
        {"zh": "这么一点不够分", "en": "Not enough to share"},
        {"zh": "你把东西丢远些", "en": "Throw it further away"},
        {"zh": "我慢慢靠近那块肉", "en": "I ease toward the meat"},
        {"zh": "我抬头看是谁扔的", "en": "I look up to see who threw it"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的胸口", "en": "You hit my chest"},
        {"zh": "我稳住没有退", "en": "I hold my ground"},
        {"zh": "你被顶得往后滑", "en": "You slide backwards"},
        {"zh": "我的骨头很轻但结实", "en": "My bones are light and strong"},
        {"zh": "这一下碰到我骨头", "en": "That only grazed my bone"},
        {"zh": "我朝你低吼一声", "en": "I growl once at you"},
        {"zh": "同伴在后面叫了一声", "en": "A fellow calls from behind"},
        {"zh": "我的同伴在后面顶我", "en": "My fellow nudges me from behind"},
        {"zh": "我退开但没有走", "en": "I pull back but do not leave"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们是一群一起走的", "en": "We travel as a pack"},
        {"zh": "同类之间不打架", "en": "We do not fight among ourselves"},
        {"zh": "我闻到另一群的味道", "en": "I smell another pack"},
        {"zh": "这些事排在后头", "en": "Such things come later"},
        {"zh": "我先把这片地守住", "en": "I keep this ground first"},
        {"zh": "我跟着头一只走", "en": "I follow the lead one"},
        {"zh": "我们不常分开", "en": "We rarely split up"},
        {"zh": "它叫了一声我跟上去", "en": "It called, I am going"},
        {"zh": "我们靠叫声保持联系", "en": "We keep in touch by calling"},
        {"zh": "这一群都是同一个窝的", "en": "We are all from one nest"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用牙把它从土里拔出来。", "en": "I wrench it from the soil with my teeth."},
        {"zh": "我咬了一下试软硬", "en": "I bite to test it"},
        {"zh": "我踩住它看了会儿", "en": "I pin it and look a while"},
        {"zh": "我叼着它走两步", "en": "I carry it two steps"},
        {"zh": "同伴过来抢了", "en": "A fellow came and took it"},
        {"zh": "我又低头去找别的", "en": "I go back to hunting"},
        {"zh": "我叼着去给同伴看", "en": "I carry it over to show a fellow"},
        {"zh": "松开尾巴，那是用来平衡的。", "en": "Let go of my tail — I need it for balance."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了我们的猎场", "en": "You entered our hunting ground"},
        {"zh": "我伏下前半个身子", "en": "I flatten my forequarters"},
        {"zh": "我先动，它们跟上", "en": "I move first, they follow"},
        {"zh": "我的同伴绕到你侧面", "en": "My fellows circle to your flank"},
        {"zh": "这一片现在归我们", "en": "This ground is ours now"},
        {"zh": "我朝你跑过去", "en": "I run at you"},
        {"zh": "我锁定了你的腿", "en": "I fix on your legs"},
        {"zh": "我的前脚抬起来", "en": "My forefoot comes up"},
        {"zh": "你后面也有人", "en": "There is one behind you too"},
        {"zh": "你退路被截住了", "en": "Your retreat has been cut off"},
        {"zh": "我喉咙里有低鸣", "en": "A growl sits in my throat"},
        {"zh": "这一口是为了喂群", "en": "This bite is to feed the pack"},
        {"zh": "我已经盯住你", "en": "I have you marked"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕过树干追你", "en": "I come around the trunk at you"},
        {"zh": "你刚往左边挪了", "en": "You just shifted left"},
        {"zh": "我同伴在前面等", "en": "My fellow waits ahead"},
        {"zh": "我的步子又碎又快", "en": "My steps are short and quick"},
        {"zh": "你藏不住你的味道", "en": "You cannot hide your scent"},
        {"zh": "我在等你力气下去", "en": "I wait for your strength to drop"},
        {"zh": "你被两块石头夹住路了", "en": "Rocks pinch your path"},
        {"zh": "我的尾巴一直在摆", "en": "My tail keeps working"},
        {"zh": "我再靠近几步", "en": "A few steps closer"},
        {"zh": "你听到我同伴的叫声了", "en": "You heard my fellow call"},
        {"zh": "你转身就慢了一拍", "en": "Turning costs you a beat"},
        {"zh": "这一片林子我们熟", "en": "We know these woods"},
        {"zh": "我压低身子准备冲", "en": "I crouch to charge"},
        {"zh": "我的呼吸越来越近", "en": "My breathing grows near"},
        {"zh": "你已经在中间了", "en": "You are in the middle now"},
        {"zh": "我一点点把距离吃掉", "en": "I eat up the distance"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬在你腿上", "en": "I bite your leg"},
        {"zh": "我的前爪按在你肩上", "en": "My foreclaw pins your shoulder"},
        {"zh": "我用头撞你的腰", "en": "I butt your side"},
        {"zh": "我扑上去压住你", "en": "I leap and bear you down"},
        {"zh": "同伴从侧面咬过来", "en": "A fellow bites from the side"},
        {"zh": "这一口咬得不深", "en": "That bite did not go deep"},
        {"zh": "我把你撞到树干上", "en": "I slam you into a trunk"},
        {"zh": "我的牙撕开你的袖子", "en": "My teeth tear your sleeve"},
        {"zh": "我退开让同伴上", "en": "I pull back and let a fellow in"},
        {"zh": "我又冲向你的后背", "en": "I charge your back again"},
        {"zh": "我用爪子刮你的膝", "en": "My claws rake your knee"},
        {"zh": "牙扣住你的束带", "en": "My teeth catch your strap"},
        {"zh": "我跳起来扑你的背", "en": "I leap for your back"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里传出几声低吼", "en": "Low growls sound in the trees"},
