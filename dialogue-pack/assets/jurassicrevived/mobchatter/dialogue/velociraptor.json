{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我脚尖着地跑。", "en": "I run on the tips of my toes."},
        {"zh": "尾巴压得很平。", "en": "My tail rides level behind me."},
        {"zh": "爪子在红岩上刮。", "en": "My claws scrape the red rock."},
        {"zh": "爪子一伸一收。", "en": "My claws flex in and out."},
        {"zh": "恶地的碎屑烫脚。", "en": "Badlands gravel burns my feet."},
        {"zh": "三只跟我一起走。", "en": "Three run with me."},
        {"zh": "身子前倾，步子快。", "en": "Leaning forward, quick steps."},
        {"zh": "我踩过一片干裂地。", "en": "I cross cracked, dry ground."},
        {"zh": "脖子上有细羽毛。", "en": "There are fine feathers on my neck."},
        {"zh": "我绕着台地转。", "en": "I circle the mesa."},
        {"zh": "影子斜斜地拖在后面。", "en": "My shadow drags behind at an angle."},
        {"zh": "我停下抬头嗅。", "en": "I stop and sniff the air."},
        {"zh": "脚下扬起红土。", "en": "Red dust rises under me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我舔着爪子。", "en": "I lick my claws."},
        {"zh": "风把羽毛吹起来。", "en": "The wind lifts my feathers."},
        {"zh": "恶地的我们，一群三只。", "en": "Three of us at a time in the badlands."},
        {"zh": "头一直转来转去。", "en": "My head keeps turning."},
        {"zh": "这片恶地没什么水。", "en": "There's little water in these badlands."},
        {"zh": "尾尖轻轻扫土。", "en": "My tail tip sweeps the dust."},
        {"zh": "我盯着远处的岩柱。", "en": "I stare at the rock pillars."},
        {"zh": "爪子抓进土里。", "en": "My claws dig into the soil."},
        {"zh": "这里太晒了。", "en": "Too much sun here."},
        {"zh": "恶地的石头，我踩得稳。", "en": "On badland stone, my footing holds."},
        {"zh": "同伴在坡上等着。", "en": "My pack waits on the slope."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我数过你有几步。", "en": "I've counted your strides."},
        {"zh": "你手上没有爪子。", "en": "You have no claws."},
        {"zh": "这身红土配你难看。", "en": "The red dust doesn't suit you."},
        {"zh": "往后退一点，我助跑不够。", "en": "Back up a bit, I have no run-up."},
        {"zh": "同伴就在坡上。", "en": "The pack is on the slope."},
        {"zh": "我看见你握紧了。", "en": "I see you tense your grip."},
        {"zh": "再近一步试试。", "en": "Try one step closer."},
        {"zh": "这里不是你的地。", "en": "This isn't your ground."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一根羽毛掉了。", "en": "A feather came loose."},
        {"zh": "爪子有点麻。", "en": "My claws feel numb."},
        {"zh": "我发出尖叫。", "en": "I let out a shriek."},
        {"zh": "我在红土上滑了半步。", "en": "I slid half a pace."},
        {"zh": "血滴在爪上。", "en": "Blood drips on my claws."},
        {"zh": "别逼我起跳。", "en": "Don't make me leap."},
        {"zh": "痛，但我的族群就在后面。", "en": "It hurts, but my pack is right behind me."},
        {"zh": "这一击，我会记住。", "en": "I'll remember that blow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "手上是生肉？", "en": "Raw meat in your hand?"},
        {"zh": "我的脚尖着地跑，尾巴压得很平。", "en": "I run on my toes, tail flattened."},
        {"zh": "我得先闻闻。", "en": "Let me smell it first."},
        {"zh": "放低到我胸前。", "en": "Lower it to my chest."},
        {"zh": "血还是热的。", "en": "The blood's still warm."},
        {"zh": "丢在沙地上。", "en": "Drop it on the sand."},
        {"zh": "同伴也会来。", "en": "The pack will come too."},
        {"zh": "给我分一块。", "en": "Give me a piece."},
        {"zh": "这口不白吃。", "en": "I won't eat this for nothing."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的爪。", "en": "You hit my claws."},
        {"zh": "我差点失去平衡。", "en": "I nearly lost balance."},
        {"zh": "尾巴甩到你身上。", "en": "My tail flicked you."},
        {"zh": "退两步，我转身快。", "en": "Two steps back. I turn fast."},
        {"zh": "羽毛被蹭掉了。", "en": "A few feathers rubbed off."},
        {"zh": "脚下红土滑。", "en": "The red dust is slick."},
        {"zh": "我一声低吼。", "en": "A low growl from me."},
        {"zh": "你的膝盖撞得发麻吧。", "en": "Your knee must be numb."},
        {"zh": "别拉我的尾巴。", "en": "Don't pull my tail."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "得是一起捕猎过的。", "en": "Only someone I've hunted with."},
        {"zh": "先看你能跑多快。", "en": "Let's see how fast you run."},
        {"zh": "恶地的两只一伙，爪子很利。", "en": "Badland pairs, and the claws are sharp."},
        {"zh": "我宁愿先吃饱。", "en": "I'd rather eat first."},
        {"zh": "白天太晒了。", "en": "The day is too hot."},
        {"zh": "我记住你的味道了，恶地的风里。", "en": "I remember your scent, in the badlands wind."},
        {"zh": "我要回群里去。", "en": "I'm going back to the pack."},
        {"zh": "我该回群了。", "en": "I should get back to the pack."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "前爪按住它。", "en": "My foreclaw pins it."},
        {"zh": "用爪子按住。", "en": "I pin it with a claw."},
        {"zh": "一口就吞了。", "en": "One gulp and it's gone."},
        {"zh": "这根骨头太硬。", "en": "The bone is too hard."},
        {"zh": "撕下一小条。", "en": "I tear off a strip."},
        {"zh": "叼着带回群。", "en": "I'll carry it to the pack."},
        {"zh": "这个有点干。", "en": "This one's dry."},
        {"zh": "地上还有血。", "en": "Blood on the ground here."},
        {"zh": "跟着味道找。", "en": "I follow the smell."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边的草动了。", "en": "The grass moved over there."},
        {"zh": "这里有新味道。", "en": "There's a new smell."},
        {"zh": "同伴已经分开。", "en": "The pack is splitting."},
        {"zh": "这个大小能吃。", "en": "That size is edible."},
        {"zh": "爪子抓紧了土。", "en": "My claws grip the dirt."},
        {"zh": "我在它的下风处。", "en": "I'm downwind of it."},
        {"zh": "别让它先动。", "en": "Don't let it move first."},
        {"zh": "我伏低身子，尾尖绷直。", "en": "I crouch low, my tail tip taut."},
        {"zh": "这一口我要了。", "en": "This one's mine."},
        {"zh": "三只已经围上去。", "en": "Three of us are already moving."},
        {"zh": "追击已经开始了。", "en": "The chase has begun."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它的影子往东。", "en": "Its shadow goes east."},
        {"zh": "我短跑很快。", "en": "I'm fast over short distance."},
        {"zh": "同伴在另一边。", "en": "The pack is on the other side."},
        {"zh": "别让它看到我。", "en": "Don't let it see me."},
        {"zh": "它的腿不够长。", "en": "Its legs aren't long."},
        {"zh": "我等着它转弯。", "en": "I wait for it to turn."},
        {"zh": "风还在我这边。", "en": "Still downwind."},
        {"zh": "它跑得比看着快。", "en": "It's faster than it looks."},
        {"zh": "再跟二十步。", "en": "Twenty more paces."},
        {"zh": "我的腿已经准备好。", "en": "My legs are ready."},
        {"zh": "把头再低下去。", "en": "Head lower still."},
        {"zh": "尾巴一摆就冲。", "en": "One tail flick and I charge."},
        {"zh": "它没路可退了。", "en": "It's out of room."},
        {"zh": "我后腿一蹬地。", "en": "My hind legs push off."},
        {"zh": "我数到两下。", "en": "I counted two."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下子跳上去！", "en": "I leap up at you!"},
        {"zh": "爪子按住它。", "en": "My claws pin it."},
        {"zh": "一口咬向脖子。", "en": "A bite at the neck."},
        {"zh": "后腿使劲蹬地。", "en": "Hind legs drive off the ground."},
        {"zh": "撕开一条口子。", "en": "I tear a gash open."},
        {"zh": "一脚踢它的肋。", "en": "A kick into its ribs."},
        {"zh": "爪子斜着切。", "en": "The claw cuts at an angle."},
        {"zh": "同伴从后面来。", "en": "The pack comes from behind."},
        {"zh": "牙齿咬住不松。", "en": "My teeth stay locked."},
        {"zh": "甩头，把肉撕下来。", "en": "Shake and rip."},
        {"zh": "这一下不用吼。", "en": "That one needed no roar."},
        {"zh": "别让它站起来。", "en": "Don't let it stand."},
        {"zh": "再补上第二口。", "en": "A second bite."},
        {"zh": "这些已经够了。", "en": "That's enough."},
        {"zh": "让开，轮到我了。", "en": "Move. My turn."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "恶地多了一串爪印。", "en": "New claw prints in the badlands."},
        {"zh": "我从岩柱后面出来。", "en": "I step out from behind a pillar."},
        {"zh": "两三个影子跟着我。", "en": "Two or three shadows with me."},
        {"zh": "红土粘在我脚上。", "en": "Red dust sticks to my feet."},
        {"zh": "我的脚站稳了。", "en": "My feet are planted."},
        {"zh": "这里的太阳很低。", "en": "The sun rides low here."},
        {"zh": "羽毛上还有土。", "en": "Soil still on my feathers."},
        {"zh": "我从干河床爬上来。", "en": "I climb out of the dry wash."},
        {"zh": "这片地适合狩猎。", "en": "This ground is good for hunting."},
        {"zh": "风里有点血腥。", "en": "There's blood on the wind."},
        {"zh": "同伴在集合。", "en": "The pack is gathering."},
        {"zh": "我慢慢跑起来。", "en": "I break into a slow run."},
        {"zh": "第一眼就看见你了。", "en": "I saw you on the first look."},
        {"zh": "我伏在红岩后。", "en": "I crouch behind the red rock."},
        {"zh": "都准备好了。", "en": "All ready."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "飞羽烧得卷起来。", "en": "Flight feathers curled and black."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时腿压弯了。", "en": "My leg buckled on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我跑不起来。", "en": "I can't run in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被震到岩壁边。", "en": "The blast threw me to the rock wall."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我羽毛竖立。", "en": "The light raised every feather."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "空着肚子跑不动。", "en": "Empty and I can't run."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打中旁边的岩柱。", "en": "The bolt struck the pillar beside me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "红土塌掉了。", "en": "The red earth fell away."}
      ]
    }
  }
}
