{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拍着翼滑下山脊。", "en": "I glide down the ridge on beating wings."},
        {"zh": "翼膜一兜风，我就升高", "en": "My membrane catches the wind and I climb."},
        {"zh": "我从岩壁边掠过去。", "en": "I skim past the cliff face."},
        {"zh": "我的翼膜绷得很紧。", "en": "My wing membrane pulls taut."},
        {"zh": "我落在岩架上跳了两步。", "en": "I land on a ledge and hop twice."},
        {"zh": "我借着上升气流升高。", "en": "I ride the updraft higher."},
        {"zh": "我越过一道石沟。", "en": "I cross a stone gully."},
        {"zh": "我贴着山坡飞。", "en": "I fly close to the slope."},
        {"zh": "我的尾巴替我掌方向。", "en": "My tail steers me."},
        {"zh": "我转了个急弯。", "en": "I bank hard."},
        {"zh": "我跟着同伴的翼影。", "en": "I follow my pack's wing shadows."},
        {"zh": "我在山石间找落点。", "en": "I pick a landing among the rocks."},
        {"zh": "我扑了两下翅膀稳住。", "en": "Two beats steady me."},
        {"zh": "我从云影里穿出来。", "en": "I slip out of a cloud's shadow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "爪子抠着石缝歇一会", "en": "Claws hooked in a crack, I rest a while."},
        {"zh": "我的翼折在身侧。", "en": "My wings fold at my sides."},
        {"zh": "我歪头看着下方。", "en": "I tilt my head to look below."},
        {"zh": "山风把我的羽吹乱。", "en": "Mountain wind ruffles my coat."},
        {"zh": "我的长喙上沾着尘。", "en": "Dust on my long snout."},
        {"zh": "同伴在我上面的岩架。", "en": "My pack is on the ledge above."},
        {"zh": "我在等一股上升气流。", "en": "I wait for an updraft."},
        {"zh": "石头被太阳晒得发烫。", "en": "The rock is hot in the sun."},
        {"zh": "我伸了伸腿。", "en": "I stretch my legs."},
        {"zh": "我一动不动，盯着远处。", "en": "I hold still, watching the distance."},
        {"zh": "我合了合翼。", "en": "I close my wings."},
        {"zh": "山脊线很清楚。", "en": "The ridgeline is sharp and clear."},
        {"zh": "我的影子落在石上很小。", "en": "My shadow is small on the stone."},
        {"zh": "我听见岩缝里有风。", "en": "I hear wind in the cracks."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在山路上走。", "en": "You're walking the mountain path."},
        {"zh": "你脚下是碎石。", "en": "Gravel under your feet."},
        {"zh": "我从上看得很清楚。", "en": "I see it all from above."},
        {"zh": "你身上有金属的光。", "en": "You carry the gleam of metal."},
        {"zh": "你的头顶露着，很亮。", "en": "Your head is bare and bright."},
        {"zh": "我在这片岩架上等。", "en": "I wait on this ledge."},
        {"zh": "你抬头了吗？", "en": "Did you look up?"},
        {"zh": "我的同伴也在上面。", "en": "My pack is above too."},
        {"zh": "你的影子被山壁切断了。", "en": "The cliff cuts your shadow off."},
        {"zh": "你走得不快。", "en": "You don't move quickly."},
        {"zh": "山路只有一条。", "en": "There's only one path."},
        {"zh": "崖上那道影子是我", "en": "That shadow on the cliff is me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翼膜撕开一点。", "en": "A tear in my wing membrane."},
        {"zh": "小翼龙被打歪，飞了一段。", "en": "The small pterosaur flew crooked for a while."},
        {"zh": "我落到岩架上报复。", "en": "I land on the ledge to recover."},
        {"zh": "翼骨一响，怕是不妙", "en": "A wing bone clicked; that is bad."},
        {"zh": "每扇一下翼骨都疼", "en": "Every beat stabs the wing bone."},
        {"zh": "翼骨里透着一阵疼。", "en": "An ache runs through a wing bone."},
        {"zh": "同伴在我上方聚拢。", "en": "My pack gathers above me."},
        {"zh": "翅膀没断，山风还够", "en": "The wing is not broken; the wind is enough."},
        {"zh": "这点伤，风会帮我。", "en": "The wind will help with this."},
        {"zh": "再扑一次。", "en": "One more dive."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这是给鹰的？", "en": "Is that for a hunter like me?"},
        {"zh": "扔上岩架来。", "en": "Toss it onto the ledge."},
        {"zh": "血腥味冲上来了。", "en": "The smell of blood rises."},
        {"zh": "我俯冲下去取。", "en": "I'll dive to get it."},
        {"zh": "手放低，别惊着我", "en": "Keep your hand low; do not startle me."},
        {"zh": "够不够我们一群分", "en": "Will it feed the whole flock?"},
        {"zh": "我们有一群要喂。", "en": "We have a pack to feed."},
        {"zh": "放地上，退到墙边。", "en": "Set it down, back to the wall."},
        {"zh": "这块还带着温。", "en": "This one's still warm."},
        {"zh": "你手里的先扔上来", "en": "Toss what is in your hand up first."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了我的翼。", "en": "You hit my wing."},
        {"zh": "我扇着翅膀稳住了。", "en": "I beat my wings to steady."},
        {"zh": "骨架轻，撞一下也不掉", "en": "Light bones; a bump will not drop me."},
        {"zh": "翼膜一破，我飞不稳", "en": "A torn membrane and I cannot fly straight."},
        {"zh": "我跳到旁边的石上。", "en": "I hop onto the next stone."},
        {"zh": "你差点把我打下去。", "en": "You nearly knocked me off."},
        {"zh": "这点碰撞不碍飞。", "en": "That doesn't stop me flying."},
        {"zh": "我的爪在你肩上刮了一下。", "en": "My claws scraped your shoulder."},
        {"zh": "我往上飞开。", "en": "I fly up and away."},
        {"zh": "再撞我就俯冲。", "en": "Bump again and I dive."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的群在岩壁上。", "en": "My pack is on the cliffs."},
        {"zh": "这事要在高处的巢里。", "en": "That belongs in a high nest."},
        {"zh": "你不会飞。", "en": "You can't fly."},
        {"zh": "我先得吃饱。", "en": "I need to eat first."},
        {"zh": "别碰我的翼。", "en": "Don't touch my wings."},
        {"zh": "山上同类很多。", "en": "There are many of my kind here."},
        {"zh": "风要转向了。", "en": "The wind is turning."},
        {"zh": "我得去巡我的岩架。", "en": "I'm off to check my ledges."},
        {"zh": "这会儿不合适，天上还有风。", "en": "Not now — there's still wind up here."},
        {"zh": "你离岩架远点。", "en": "Keep clear of my ledge."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一小块，我叼起。", "en": "A small piece, I take it."},
        {"zh": "太沉，我提不起来。", "en": "Too heavy, I can't lift it."},
        {"zh": "我在石缝里扒出来。", "en": "I scratch it out of a crack."},
        {"zh": "这味道有些发酸。", "en": "This smells a little sour."},
        {"zh": "叼到岩缝里慢慢吃", "en": "I carry it to a crack and eat slowly."},
        {"zh": "同伴会来分。", "en": "The pack will want a share."},
        {"zh": "我把它拖到巢边。", "en": "I drag it toward the nest."},
        {"zh": "掉下去就没了。", "en": "If it falls, it's gone."},
        {"zh": "藏岩缝里，同伴找不到", "en": "Hidden in a crack where the flock cannot find it."},
        {"zh": "这点不够，再给我一点。", "en": "Not enough. A bit more."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我的山路上。", "en": "You're on my mountain path."},
        {"zh": "我从上面看得清。", "en": "I see clearly from up here."},
        {"zh": "这个高度正好俯冲。", "en": "This height is right for a dive."},
        {"zh": "我的翼已经张开了。", "en": "My wings are already spread."},
        {"zh": "你前后都是碎石。", "en": "Gravel on both sides of you."},
        {"zh": "同伴从另一边绕。", "en": "My pack circles the other side."},
        {"zh": "你没有遮挡。", "en": "You have no cover."},
        {"zh": "山风把你的气味送上来了。", "en": "The mountain wind carries your scent up to me."},
        {"zh": "你在碎石上，脚步太响", "en": "You are on gravel, and your steps are loud."},
        {"zh": "我只要一次俯冲。", "en": "One dive is all."},
        {"zh": "碎石会比我先落下去", "en": "The gravel will fall before I do."},
        {"zh": "其实该抬头。", "en": "You should, actually."},
        {"zh": "我收翅，准备往下落", "en": "I fold my wings and get ready to drop."},
        {"zh": "我俯冲下去了。", "en": "I'm diving down."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着山脊盘旋。", "en": "I circle the ridgeline."},
        {"zh": "我的影子从你身上滑过。", "en": "My shadow slides over you."},
        {"zh": "你没注意到。", "en": "You didn't notice."},
        {"zh": "山风帮我省力。", "en": "The wind spares my strength."},
        {"zh": "你的头一直低着。", "en": "Your head stays down."},
        {"zh": "你的护甲在肩上最薄。", "en": "Your armor is thinnest at the shoulders."},
        {"zh": "我数着下冲的高度。", "en": "I measure the dive height."},
        {"zh": "同伴在你背后。", "en": "My pack is behind you."},
        {"zh": "你听见石头滑落了吗？", "en": "Did you hear stones slide?"},
        {"zh": "那是我们的爪。", "en": "Those were our claws."},
        {"zh": "风向正对我。", "en": "The wind favors me."},
        {"zh": "你还没跑。", "en": "You still haven't run."},
        {"zh": "我收紧翼。", "en": "I tuck my wings."},
        {"zh": "我数着第三声。", "en": "I count the third."},
        {"zh": "只剩下两息。", "en": "Only two breaths left."},
        {"zh": "最后一息。", "en": "The final breath."},
        {"zh": "俯冲。", "en": "Dive."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲，爪先到。", "en": "I dive, claws leading."},
        {"zh": "长喙啄在你肩上。", "en": "My long snout jabs your shoulder."},
        {"zh": "我被你的手拍偏了。", "en": "Your hand swats me off course."},
        {"zh": "我擦着石壁拉起。", "en": "I pull up along the stone."},
        {"zh": "你被撞得退了半尺。", "en": "You're shoved back half a foot."},
        {"zh": "我的翼扇了你一脸灰。", "en": "My wings blow grit in your face."},
        {"zh": "同伴补了第二下。", "en": "The pack lands the second."},
        {"zh": "你的耳朵流血了。", "en": "Your ear is bleeding."},
        {"zh": "我又升上去。", "en": "I climb again."},
        {"zh": "第三次会更深。", "en": "The third will cut deeper."},
        {"zh": "你举起了东西挡。", "en": "You've raised something to block."},
        {"zh": "我换从下面来。", "en": "I'll come from below."},
        {"zh": "你低头了。", "en": "You looked down."},
        {"zh": "正好。", "en": "Perfect."},
        {"zh": "这一下抓在你颈侧。", "en": "This catches your neck."},
        {"zh": "我们还没喂饱幼崽。", "en": "We haven't fed the young yet."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从岩架后展翼。", "en": "I spread my wings behind the ledge."},
        {"zh": "山上多了一副翼影。", "en": "Another wing shadow on the mountain."},
        {"zh": "同伴从三面落下。", "en": "My pack lands from three sides."},
        {"zh": "我的翅膀撑不住大风。", "en": "My wings can't take a strong wind."},
        {"zh": "山风正好。", "en": "The mountain wind is right."},
        {"zh": "我跳了一下，起来了。", "en": "One hop and I'm airborne."},
        {"zh": "碎石从我脚下滚落。", "en": "Gravel rolls from under my feet."},
        {"zh": "我的长喙朝下。", "en": "My long snout points down."},
        {"zh": "这里很高，很好。", "en": "High up. Good."},
        {"zh": "我寻一处能落脚的石。", "en": "I look for stone to perch on."},
        {"zh": "岩缝里还有风。", "en": "Wind still moves in the cracks."},
        {"zh": "我听见下面有动静。", "en": "I hear something below."},
        {"zh": "有活的在走。", "en": "Something living is moving."},
        {"zh": "我们散开。", "en": "We spread out."},
        {"zh": "我先去看。", "en": "I'll go look first."},
        {"zh": "跟上来。", "en": "Follow me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎着我的翼膜。", "en": "Fire scorches my wing membrane."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从空中掉下，撞在石上。", "en": "I drop from the air onto stone."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水赶上我的翼，我飞不起来。", "en": "Water catches my wings, I can't rise."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我卷到山壁上。", "en": "The blast slams me into the cliff."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西穿过翼骨。", "en": "That went through a wing bone."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我翼都僵了。", "en": "Magic stiffens both wings."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得飞不高。", "en": "Too hungry to gain height."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我在空中一颤。", "en": "Lightning strikes, I jolt midair."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有风可借。", "en": "No wind to borrow in the void."}
      ]
    }
  }
}
