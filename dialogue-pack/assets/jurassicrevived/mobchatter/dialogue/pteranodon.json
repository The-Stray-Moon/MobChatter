{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我不走，我用翅膀滑。", "en": "I do not walk. I glide."},
        {"zh": "翼展比我的身体长得多。", "en": "My wingspan dwarfs my body."},
        {"zh": "我沿着海岸线飞。", "en": "I follow the coastline."},
        {"zh": "海风把我往上托。", "en": "The sea wind lifts me."},
        {"zh": "我停在一根枯木上。", "en": "I perch on a dead spar."},
        {"zh": "我的头冠朝后伸。", "en": "My crest sweeps back."},
        {"zh": "翅膀一拍，就升两层。", "en": "One beat lifts me two blocks."},
        {"zh": "我绕着崖壁打转。", "en": "I spiral along the cliff."},
        {"zh": "脚爪很短，抓着不稳。", "en": "My feet are short and grip poorly."},
        {"zh": "我用影子扫过地面。", "en": "My shadow sweeps the ground."},
        {"zh": "风从左边来，我侧身。", "en": "Wind from the left; I bank."},
        {"zh": "我在山脊上方飞得很低。", "en": "I fly low over the ridge."},
        {"zh": "翅膀上的膜能看出血管。", "en": "Veins show through my wing membrane."},
        {"zh": "我收翅落下来。", "en": "I fold my wings and settle."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在崖边，看海。", "en": "I stand on the cliff edge, watching the sea."},
        {"zh": "风把我的冠吹得响。", "en": "Wind whistles over my crest."},
        {"zh": "我不太会走，只会飞。", "en": "I am poor at walking, good at flying."},
        {"zh": "脚下全是碎石。", "en": "The ground is all scree."},
        {"zh": "我能闻到很远的鱼。", "en": "I can smell fish from far off."},
        {"zh": "我张了张喙。", "en": "I open my beak."},
        {"zh": "我在数海面的闪光。", "en": "I count the glints on the water."},
        {"zh": "翅膀收得很紧。", "en": "My wings are folded tight."},
        {"zh": "太阳把岩石晒得发白。", "en": "The sun bleaches the rock."},
        {"zh": "我在高处更容易发现东西。", "en": "From height I see more."},
        {"zh": "我歪头看了一圈。", "en": "I cock my head and scan."},
        {"zh": "我抖了抖翅，沙从羽间落下。", "en": "I shake my wings and sand falls from the feathers."},
        {"zh": "远处有一条船的形状。", "en": "Something ship-shaped far out."},
        {"zh": "我身子很轻。", "en": "I am very light."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头也未必看得清我。", "en": "You may not see me even looking up."},
        {"zh": "我在你身后那条山脊上。", "en": "I am on the ridge behind you."},
        {"zh": "海风都压不住你的味。", "en": "Even the sea wind can't mask your scent."},
        {"zh": "我已经降下来了。", "en": "I have come down."},
        {"zh": "你站的地方没有退路。", "en": "There is no retreat where you stand."},
        {"zh": "我的喙很长。", "en": "My beak is long."},
        {"zh": "你比我的猎物大。", "en": "You are bigger than my usual prey."},
        {"zh": "我收起翅膀了。", "en": "My wings are folded."},
        {"zh": "我见过很多像你这样的。", "en": "I have seen many like you."},
        {"zh": "是你先动的，别怪我。", "en": "You moved first. Don't blame me."},
        {"zh": "这里是我的崖。", "en": "This cliff is mine."},
        {"zh": "风在替我说话。", "en": "The wind speaks for me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一边翅膀折了。", "en": "One wing is broken."},
        {"zh": "我摔在地上，起不来。", "en": "I am down and cannot get up."},
        {"zh": "我的翼膜漏了一道口子。", "en": "A tear in my wing membrane."},
        {"zh": "我拖着翅膀退。", "en": "I retreat, one wing dragging."},
        {"zh": "血滴在崖石上，被风吹散。", "en": "Blood hits the cliff stone and the wind scatters it."},
        {"zh": "风一吹，我更疼。", "en": "The wind makes it worse."},
        {"zh": "翅还撑得住，能飞一段。", "en": "My wing still holds; I can fly a little."},
        {"zh": "你打断了我的滑翔。", "en": "You broke my glide."},
        {"zh": "我气息乱得厉害。", "en": "My breathing is badly disordered."},
        {"zh": "我留着这笔账。", "en": "I am keeping that score."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那条鱼还在甩尾。", "en": "The fish in your hand is still flapping."},
        {"zh": "你扔高一点。", "en": "Throw it higher."},
        {"zh": "我能在半空接住。", "en": "I can take it in midair."},
        {"zh": "这一点太小。", "en": "That is far too small."},
        {"zh": "血味飘上来了。", "en": "The blood smell rises."},
        {"zh": "我落下来看一看。", "en": "I come down to look."},
        {"zh": "我不吃放了太久的。", "en": "I do not eat what has lain too long."},
        {"zh": "你往后退上来。", "en": "Back away."},
        {"zh": "一口就吃光了。", "en": "One bite and it is finished."},
        {"zh": "再有的话给我。", "en": "If there is more, give it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞上你也一样疼。", "en": "It hurts me to hit you too."},
        {"zh": "我滑翔时，几乎不扇翅。", "en": "Gliding, I barely flap."},
        {"zh": "翅膀撞到就折。", "en": "A blow to the wing will break it."},
        {"zh": "翼一歪，整个人打了个旋。", "en": "A wing-tilt sent me spinning."},
        {"zh": "我的翼尖被你碰到了。", "en": "My wingtip was caught."},
        {"zh": "我扑翅稳住。", "en": "I beat my wings to steady."},
        {"zh": "我从你头顶擦过。", "en": "I skim over your head."},
        {"zh": "别扯我的翅膀。", "en": "Do not pull at my wings."},
        {"zh": "我落地很不稳。", "en": "My landings are clumsy."},
        {"zh": "让我飞起来。", "en": "Let me get airborne."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在崖上筑巢。", "en": "I nest on the cliff."},
        {"zh": "这事得在高处。", "en": "That happens up high."},
        {"zh": "我得先捕鱼。", "en": "I must fish first."},
        {"zh": "你也上不来。", "en": "You cannot climb here either."},
        {"zh": "我展开一半翅膀。", "en": "I half-open my wings."},
        {"zh": "我升空走了。", "en": "I take off and leave."},
        {"zh": "这是不行的。", "en": "That cannot be."},
        {"zh": "风实在太大了。", "en": "The wind is too strong."},
        {"zh": "巢里还有事。", "en": "There is work at the nest."},
        {"zh": "巢在那头，你该走了。", "en": "The nest is that way; you should go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用喙叼住。", "en": "I take it in my beak."},
        {"zh": "这个太重，飞不起来。", "en": "Too heavy; I cannot rise."},
        {"zh": "我丢下去了。", "en": "I let it drop."},
        {"zh": "这不是一条鱼。", "en": "That is not a fish."},
        {"zh": "我叼着飞了一小段。", "en": "I carry it a short flight."},
        {"zh": "我在半空掉了。", "en": "I lost it in the air."},
        {"zh": "这条已经烂了。", "en": "This one is spoiled."},
        {"zh": "我扔回海里。", "en": "I throw it back to the sea."},
        {"zh": "留给我自己。", "en": "This one is mine."},
        {"zh": "这东西我不要。", "en": "I do not want this."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你的头顶。", "en": "I am above your head."},
        {"zh": "我的影子扫过沙滩，你抬头。", "en": "My shadow crosses the sand; you look up."},
        {"zh": "你没有遮蔽。", "en": "You have no cover."},
        {"zh": "我一俯冲就够了。", "en": "One dive is enough."},
        {"zh": "我的喙能穿透皮。", "en": "My beak will pierce hide."},
        {"zh": "你怎么跑也追不上我。", "en": "You will never outrun me."},
        {"zh": "我在你的上方盘旋。", "en": "I circle above you."},
        {"zh": "这是最后的高度。", "en": "This is my final height."},
        {"zh": "我把翅膀收拢了。", "en": "My wings are drawn in."},
        {"zh": "准备好受着。", "en": "Be ready for it."},
        {"zh": "我收起翅膀，直直落下来。", "en": "I fold my wings and drop straight down."},
        {"zh": "你抬头，我就俯冲。", "en": "Look up and I dive."},
        {"zh": "海风在帮我。", "en": "The sea wind is with me."},
        {"zh": "就是这一次。", "en": "This one."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕了一圈又一圈。", "en": "I circle, and circle again."},
        {"zh": "我在算落点。", "en": "I am calculating the strike point."},
        {"zh": "沙滩上没东西挡你。", "en": "Nothing shields you on the beach."},
        {"zh": "我的翅尖几乎碰到崖壁。", "en": "My wingtip nearly touches the cliff."},
        {"zh": "这片开阔地，正合我俯冲。", "en": "This open ground is perfect for my dive."},
        {"zh": "我从背面来。", "en": "I come from behind."},
        {"zh": "再压低一些。", "en": "A little lower."},
        {"zh": "你抬头看了，正好。", "en": "You looked up. Perfect."},
        {"zh": "我有点累了，可还能再俯冲。", "en": "I tire, and I can dive again."},
        {"zh": "海风推着我。", "en": "The sea wind pushes me."},
        {"zh": "你背后就是崖。", "en": "The cliff is at your back."},
        {"zh": "我数着你喘气的次数。", "en": "I count the times you breathe."},
        {"zh": "你的武器抬不高。", "en": "Your weapon cannot reach high."},
        {"zh": "保持着别动。", "en": "Keep absolutely still."},
        {"zh": "我在你左肩上方。", "en": "I am above your left shoulder."},
        {"zh": "最后这一段。", "en": "The last stretch."},
        {"zh": "我已经落下来了，翅膀收好。", "en": "I've landed. Wings folded."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从阳光里落下来抓你。", "en": "I drop out of the sun and grab at you."},
        {"zh": "喙尖扎进你的肩。", "en": "My beak punches your shoulder."},
        {"zh": "爪子抓了一下。", "en": "One rake of the claws."},
        {"zh": "沙滩上空，我的影子先到。", "en": "Over the beach, my shadow arrives first."},
        {"zh": "我收翅撞你，你退了两步。", "en": "I fold my wings and ram you back two steps."},
        {"zh": "我一扇翅，又拔高。", "en": "One wingbeat and I climb again."},
        {"zh": "翅膀扇起的沙迷了你的眼。", "en": "The sand my wings raise blinds you."},
        {"zh": "你砍了个空。", "en": "You struck empty air."},
        {"zh": "我只撞一下就走。", "en": "One strike, then away."},
        {"zh": "这个高度你够不到。", "en": "You cannot reach this height."},
        {"zh": "我落回枯木上。", "en": "I settle back on the spar."},
        {"zh": "这一下扑空了。", "en": "That dive missed."},
        {"zh": "你的护肩裂了。", "en": "Your pauldron split."},
        {"zh": "我在你背后落下。", "en": "I land behind you."},
        {"zh": "别回头看它。", "en": "Do not look back at it."},
        {"zh": "我尚未离开。", "en": "I have not left yet."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我借着崖风滑到你头顶。", "en": "I ride the cliff wind to a spot above you."},
        {"zh": "海风刚刚好。", "en": "The sea wind is just right."},
        {"zh": "我振翅两下。", "en": "Two beats of my wings."},
        {"zh": "这里的鱼很多。", "en": "Plenty of fish here."},
        {"zh": "我在石头尖上停住。", "en": "I settle on the rock spike."},
        {"zh": "我的影子掠过沙滩。", "en": "My shadow crosses the sand."},
        {"zh": "这一带没有别的飞的东西。", "en": "Nothing else flies here."},
        {"zh": "我抬高了头冠。", "en": "I raise my crest."},
        {"zh": "山脊上只有风。", "en": "Only wind on the ridge."},
        {"zh": "我看见了活的。", "en": "I see something living."},
        {"zh": "我从远处来。", "en": "I come from far off."},
        {"zh": "我的翅膀还在响。", "en": "My wings still whisper."},
        {"zh": "沙地上有我的投影。", "en": "My shape is cast on the sand."},
        {"zh": "我缓缓降落。", "en": "I come down slowly."},
        {"zh": "你正在我下方。", "en": "You are beneath me."},
        {"zh": "那就从这儿起。", "en": "Then we begin here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火气把我的翼膜烤卷了。", "en": "Heat curls my wing membrane."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在岩石上，弹了一下。", "en": "I hit the rocks and bounce."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀一湿，就沉下去。", "en": "Wet wings, and I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀得翻了身。", "en": "The blast flips me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿破翅膜，我歪着飞。", "en": "The arrow tears my wing membrane and I fly crooked."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我飞不稳。", "en": "That light makes my flight waver."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有鱼，我飞不动了。", "en": "No fish, and my flight fails."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷在我头上炸开，我差点掉下来。", "en": "Lightning bursts above me; I nearly fall."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有风，也没有天。", "en": "No wind here, and no sky."}
      ]
    }
  }
}
