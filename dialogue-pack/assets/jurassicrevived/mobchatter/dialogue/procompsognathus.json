{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "细腿倒得快，别小看。", "en": "These thin legs move fast; don't underestimate them."},
        {"zh": "细腿在砂上留下小印。", "en": "Thin legs leave small prints in the grit."},
        {"zh": "我在石头之间穿来穿去。", "en": "I slip between the rocks."},
        {"zh": "我们五个一起跑。", "en": "We five run together."},
        {"zh": "我仰着头，鼻子在动。", "en": "Head up, nose working."},
        {"zh": "我跳过一道干沟。", "en": "I clear a dry gully."},
        {"zh": "我贴着地面走，影子很短。", "en": "I go low; my shadow is short."},
        {"zh": "热石头烫得我换脚。", "en": "The hot stone makes me shift feet."},
        {"zh": "我绕过一丛枯灌木。", "en": "I round a dead shrub."},
        {"zh": "我跑着还不住回头。", "en": "I run and keep glancing back."},
        {"zh": "尾尖轻轻扫过砂地。", "en": "My tail tip brushes the sand."},
        {"zh": "我的头骨比身体还长。", "en": "My skull is longer than my body."},
        {"zh": "我朝同伴叫的方向跑。", "en": "I run toward my pack's call."},
        {"zh": "我慢慢靠近一只蜥蜴。", "en": "I creep up on a lizard."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在岩石上，抬着头。", "en": "I stand on a rock, head raised."},
        {"zh": "这地方的太阳太毒。", "en": "The sun is cruel here."},
        {"zh": "我的喉咙干了。", "en": "My throat is dry."},
        {"zh": "同伴在碎岩上晒着。", "en": "My pack suns on the rubble."},
        {"zh": "我在听沙里的动静。", "en": "I listen to the sand."},
        {"zh": "我的骨架很轻。", "en": "My frame is very light."},
        {"zh": "我在找虫子吃。", "en": "I am hunting insects."},
        {"zh": "我的牙细得像一排针。", "en": "My teeth are fine as a row of needles."},
        {"zh": "风把沙吹到我的眼边。", "en": "Sand blows against my eyes."},
        {"zh": "我蹲了下来。", "en": "I crouch down."},
        {"zh": "这里的石头是红的。", "en": "The stones here are red."},
        {"zh": "我吐出一口气，沙面起了尘。", "en": "I exhale and dust lifts from the sand."},
        {"zh": "远处有翅声。", "en": "Wings, far off."},
        {"zh": "这地方的太阳太毒，我口干。", "en": "The sun here is vicious; my throat is dry."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我们全加起来都重。", "en": "You outweigh all of us together."},
        {"zh": "我抬头看你，很费劲。", "en": "Looking up at you strains my neck."},
        {"zh": "你身上的水味很浓。", "en": "You smell strongly of water."},
        {"zh": "我往石头边挪了半步。", "en": "I edge half a step toward the rocks."},
        {"zh": "你在我们的地盘上。", "en": "You are on our ground."},
        {"zh": "我叫了一声，同伴就散了。", "en": "I call, and the pack scatters."},
        {"zh": "你的影子盖住了整片沙。", "en": "Your shadow covers the whole patch of sand."},
        {"zh": "你蹲下会更快吗？", "en": "Would crouching make you faster?"},
        {"zh": "我的头骨里有很多牙。", "en": "My skull holds a lot of teeth."},
        {"zh": "你别往这边迈。", "en": "Do not take that step."},
        {"zh": "我们围着你看。", "en": "We are gathering around you."},
        {"zh": "我就站在这里。", "en": "I will stay right here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "滚到石头后面，先躲一下。", "en": "Roll behind the rock and hide a moment."},
        {"zh": "我的前腿在抖。", "en": "My foreleg trembles."},
        {"zh": "我叫了，同伴就散了。", "en": "I call, and the pack scatters."},
        {"zh": "骨头很轻，摔得重。", "en": "Light bones, hard landing."},
        {"zh": "这一点伤就要命。", "en": "This much could kill me."},
        {"zh": "四条腿还能跑。", "en": "All four legs still run."},
        {"zh": "血珠落进沙里，立刻没了。", "en": "Blood beads fall into the sand and vanish."},
        {"zh": "我低头看那道口子。", "en": "I look down at the gash."},
        {"zh": "你打得真准。", "en": "You hit true."},
        {"zh": "这事我记下了。", "en": "Noted."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "虫子？还是肉？", "en": "Insects, or meat?"},
        {"zh": "把它放低些。", "en": "Lower it a bit."},
        {"zh": "我先看，不急着动。", "en": "I look first. No rush."},
        {"zh": "这一点不够五个分。", "en": "Not enough for five."},
        {"zh": "我叼起便跑。", "en": "I snatch it and run."},
        {"zh": "我回头看了一眼同伴。", "en": "I glance back at my packmates."},
        {"zh": "这味道是甜的。", "en": "That smells sweet."},
        {"zh": "手一动，我就当是喂食。", "en": "Move your hand and I'll take it as feeding."},
        {"zh": "我嚼得很细，细腿在砂上留下小印。", "en": "I chew finely, thin legs leaving small prints."},
        {"zh": "再给一点点。", "en": "A very little more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被你撞飞了。", "en": "You knock me flying."},
        {"zh": "我骨头轻，不经撞。", "en": "Light bones do not take impacts."},
        {"zh": "我滚了两圈才止住。", "en": "I roll twice before stopping."},
        {"zh": "同伴立刻散开。", "en": "My pack scatters at once."},
        {"zh": "你在沙上踩出坑。", "en": "You leave craters in the sand."},
        {"zh": "我重新起身。", "en": "I pick myself up."},
        {"zh": "我歪了一下脖子。", "en": "My neck is crooked."},
        {"zh": "八点血的小家伙，恶地里成群。", "en": "Eight health apiece, in badlands packs."},
        {"zh": "我一头钻进石缝。", "en": "I dive into a rock crevice."},
        {"zh": "脚下要当心。", "en": "Mind where you put your feet."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们五个是一起长大的。", "en": "We five grew up together."},
        {"zh": "这事在雨季。", "en": "That happens in the wet season."},
        {"zh": "我把头一低。", "en": "I drop my head."},
        {"zh": "同伴在看着。", "en": "My pack is watching."},
        {"zh": "我低低嘶了一声。", "en": "I hiss, low."},
        {"zh": "那个人不是你。", "en": "That one is not you."},
        {"zh": "我转身跑了。", "en": "I turn and run."},
        {"zh": "我没那份心思。", "en": "I have no mind for it."},
        {"zh": "我继续找虫。", "en": "I go back to hunting insects."},
        {"zh": "回去你的群里。", "en": "Go back to your own."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "虫子，正好。", "en": "An insect. Good."},
        {"zh": "一口就咽了下去。", "en": "Swallowed in one go."},
        {"zh": "这个咬不动。", "en": "This will not give."},
        {"zh": "我叼着，怕被抢。", "en": "I carry it, afraid of thieves."},
        {"zh": "掉在沙里，我刨两下就找到。", "en": "If it drops in the sand, two digs and I'll find it."},
        {"zh": "这个啃不动的。", "en": "This will not be chewed."},
        {"zh": "我拿爪拨到一边。", "en": "I rake it aside with a claw."},
        {"zh": "这一份太少了。", "en": "This portion is too small."},
        {"zh": "前爪一按，东西归我。", "en": "One press of my foreclaw and it's mine."},
        {"zh": "这就归你了。", "en": "Then it is yours."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我们围上来了。", "en": "We are closing in."},
        {"zh": "沙地上，我盯住你的脚踝。", "en": "On the sand, I fix on your ankle."},
        {"zh": "你身边没人，我们可不止一个。", "en": "You're alone; we are not."},
        {"zh": "我叫了，同伴会合。", "en": "I called. The pack will gather."},
        {"zh": "我跳着靠近。", "en": "I hop closer."},
        {"zh": "我不咬正面。", "en": "I will not bite the front."},
        {"zh": "你踢不到我。", "en": "You cannot kick me."},
        {"zh": "我动作快，先绕你后面。", "en": "I am quick; I go behind you first."},
        {"zh": "绕到你后面。", "en": "Get behind."},
        {"zh": "你出血了就知道。", "en": "You will know when you bleed."},
        {"zh": "别回身看我。", "en": "Do not turn around."},
        {"zh": "我只有八点血，可我们一群。", "en": "Eight health, but we are a pack."},
        {"zh": "我把身压低了。", "en": "I have gone low."},
        {"zh": "我这么小，一口就够我半天。", "en": "This small, one bite lasts me half a day."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你的脚跑。", "en": "I run circles at your feet."},
        {"zh": "同伴在另一侧。", "en": "My pack is on the other side."},
        {"zh": "你的腿抬得很高。", "en": "You lift your legs high."},
        {"zh": "你每落一脚，我就近一步。", "en": "Each footfall brings me one step closer."},
        {"zh": "沙上很滑，你更慢。", "en": "The sand is slick, and you slower."},
        {"zh": "我快饿死了。", "en": "I am terribly hungry."},
        {"zh": "我又贴近一点。", "en": "I close a little more."},
        {"zh": "你转身会有空隙。", "en": "There is a gap when you turn."},
        {"zh": "我叫得很急。", "en": "My calls come fast."},
        {"zh": "我们等得起。", "en": "We can wait."},
        {"zh": "石头挡着你。", "en": "The rocks are in your way."},
        {"zh": "我贴地过来了。", "en": "I come low."},
        {"zh": "沙子在响，是我的爪子。", "en": "The sand rustles; those are my claws."},
        {"zh": "三条一起上。", "en": "Three at once."},
        {"zh": "再迈出一脚。", "en": "One more footfall."},
        {"zh": "就是这个空档。", "en": "That is the gap."},
        {"zh": "牙咬下去了。", "en": "My teeth are in."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住你的脚趾。", "en": "I bite your toes."},
        {"zh": "我跳到你的小腿上。", "en": "I spring onto your calf."},
        {"zh": "牙齿很细，扎得深。", "en": "Fine teeth, deep puncture."},
        {"zh": "同伴同时咬。", "en": "The pack bites at once."},
        {"zh": "你把我甩下来，我滚进沙。", "en": "You throw me off and I roll into the sand."},
        {"zh": "我掉在沙上又跳起。", "en": "I land in the sand and spring again."},
        {"zh": "这一下只有两点伤。", "en": "That is only two points."},
        {"zh": "可我们人很多。", "en": "But there are many of us."},
        {"zh": "我咬你的裤脚。", "en": "I grab your trouser leg."},
        {"zh": "我的脚被你压住了。", "en": "My foot is pinned under yours."},
        {"zh": "我退开，又回来。", "en": "I pull away and return."},
        {"zh": "血味让它们都来了。", "en": "The blood brings them all."},
        {"zh": "我从后面下口。", "en": "I bite from behind."},
        {"zh": "你又流血了。", "en": "You are bleeding again."},
        {"zh": "我还没有走。", "en": "I have not left."},
        {"zh": "还要再来的。", "en": "There will be more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我们从碎岩后面钻出来。", "en": "We come out from behind the rubble."},
        {"zh": "三到五只，一起来的。", "en": "Three to five of us, all at once."},
        {"zh": "恶地的石头很烫。", "en": "The badland stones are hot."},
        {"zh": "我们散得很开。", "en": "We spread wide."},
        {"zh": "我抬着长头骨看四周。", "en": "I raise my long skull to scan."},
        {"zh": "这里没什么可吃的。", "en": "Little to eat here."},
        {"zh": "沙粒传声，我先听见你。", "en": "The sand carries sound; I heard you first."},
        {"zh": "同伴的叫声从后面来。", "en": "My pack calls from behind."},
        {"zh": "沙子被我踩出小坑。", "en": "I leave small pits in the sand."},
        {"zh": "我们慢慢围过来了。", "en": "We are gathering around."},
        {"zh": "你站着不动最好，恶地的碎石扎脚。", "en": "Best you stand still; badlands gravel cuts."},
        {"zh": "我数过了，你只有一个人。", "en": "I counted. You are alone."},
        {"zh": "这一片是我们的猎场。", "en": "This is our hunting ground."},
        {"zh": "我这么小，只能咬脚踝。", "en": "Tiny as I am, I bite ankles."},
        {"zh": "我们一起上吧。", "en": "All of us together."},
        {"zh": "暂时先别动。", "en": "Hold still for now."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "沙上的热气把我烤干了。", "en": "The heat off the sand dries me out."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在石头上，骨头响。", "en": "I land on stone; bones crack."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一下子盖过我。", "en": "The water closes over me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我甩到岩壁上。", "en": "The blast slams me into the rock."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭把我钉在原地。", "en": "An arrow pins me where I stand."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "八点命的小家伙，撑不住魔法。", "en": "Eight points can't hold against magic."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得没有力气跑。", "en": "Too hungry to run."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在红石上，我缩起来。", "en": "Lightning hits red stone; I curl up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有沙，没有石头。", "en": "No sand here, no stones."}
      ]
    }
  }
}
