{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我两脚跑，前爪抬着", "en": "I run on two legs, foreclaws raised."},
        {"zh": "脚趾抓地，跑起来稳", "en": "My toes grip the ground as I run."},
        {"zh": "草丛里有我的道", "en": "There's a trail of mine through the grass."},
        {"zh": "林子里我到处嗅", "en": "I sniff all over the wood."},
        {"zh": "尾巴横着摆，转弯快", "en": "My tail swings wide for quick turns."},
        {"zh": "比长脖子的那些快得多", "en": "Much faster than the long-necked ones."},
        {"zh": "我走一段就听一下", "en": "I walk a stretch and listen."},
        {"zh": "前面的落叶被踩响", "en": "The fallen leaves crackle ahead."},
        {"zh": "我绕开密林，走边上", "en": "I skirt the dense woods and keep to the edge."},
        {"zh": "牙缝里还有上次的", "en": "Last meal's leftovers are still in my teeth."},
        {"zh": "这双爪子是用来抓的", "en": "These claws are for gripping."},
        {"zh": "肩背上的皮有道旧伤", "en": "An old scar runs across my shoulder."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，头来回扫", "en": "I stand, head sweeping back and forth."},
        {"zh": "舌尖在牙上舔", "en": "My tongue runs over my teeth."},
        {"zh": "我在听，谁在动", "en": "I'm listening for who moves."},
        {"zh": "风从后面来，很好", "en": "Wind from behind, good."},
        {"zh": "这一带的味道很杂", "en": "The smells here are mixed."},
        {"zh": "我不太大，可我很凶", "en": "I'm not big, but I'm fierce."},
        {"zh": "抬起一只脚，悬在半空。", "en": "I lift one foot and hold it there."},
        {"zh": "林子里安静得不正常", "en": "The wood is unnaturally quiet."},
        {"zh": "我低下头，闻地面", "en": "I lower my head and sniff the ground."},
        {"zh": "我比看上去更轻", "en": "I'm lighter than I look."},
        {"zh": "我在这片林子里", "en": "I'm in these woods."},
        {"zh": "我转头，看树干那边", "en": "I turn my head toward the trunk."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也闻到我了", "en": "You smell me too, don't you?"},
        {"zh": "我这两条腿，跑得很快", "en": "Two legs, and very fast."},
        {"zh": "你挡住了我的猎道。", "en": "You're blocking my hunting trail."},
        {"zh": "我这双爪子能抓住东西", "en": "These claws can grip."},
        {"zh": "你不是这里的动物", "en": "You aren't an animal from here."},
        {"zh": "我牙上有缺口，一样能咬", "en": "One tooth is chipped, and it still bites."},
        {"zh": "你退半步，我不追", "en": "Take half a step, and I won't follow."},
        {"zh": "林子里我说了算", "en": "I decide things in these woods."},
        {"zh": "你比我高，可你慢", "en": "You're taller, and slower."},
        {"zh": "那我就先动身", "en": "I move first."},
        {"zh": "你手里有肉味", "en": "There's meat on your hands."},
        {"zh": "别把背留给我", "en": "Don't turn your back to me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了两步，弓着背", "en": "I back two steps, back arched."},
        {"zh": "这一口咬在我肩上", "en": "That tore my shoulder."},
        {"zh": "我一叫，猎物就跑了", "en": "If I cry out, the prey runs."},
        {"zh": "伤口一直在滴血", "en": "The wound is dripping."},
        {"zh": "前爪一软，我咬住草根。", "en": "My foreleg buckles; I bite the grass roots."},
        {"zh": "我换个角度蹲下去", "en": "I crouch at a different angle."},
        {"zh": "这一下，我记住你了", "en": "That one, I'll remember you."},
        {"zh": "我的手爪抬起来", "en": "I raise my foreclaws."},
        {"zh": "牙口还是好好的", "en": "The teeth are still fine."},
        {"zh": "我这腿还能跑", "en": "I can still run."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉，我闻到肉味了", "en": "Meat; I can smell it."},
        {"zh": "你手里那块不错", "en": "That piece in your hand is decent."},
        {"zh": "放下来，你退三步", "en": "Put it down and take three steps back."},
        {"zh": "带血的，我最喜欢", "en": "Bloody is what I like best."},
        {"zh": "你举高我就跳", "en": "Hold it high and I'll jump."},
        {"zh": "这点肉还不够", "en": "That's not enough."},
        {"zh": "你手里那块，血还没干。", "en": "That piece in your hand still drips."},
        {"zh": "你手抖个什么", "en": "Why is your hand shaking?"},
        {"zh": "我吃着，你别靠近", "en": "I eat; you stay back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我，你被弹开", "en": "Hit me and you're thrown back."},
        {"zh": "我这身不重，可很硬", "en": "I'm not heavy, but I'm hard."},
        {"zh": "别贴着我的尾巴", "en": "Don't lean on my tail."},
        {"zh": "你踩到我抓地的脚趾", "en": "You stepped on my gripping toes."},
        {"zh": "这一下，我转过来", "en": "That made me turn."},
        {"zh": "我们撞在一起，草被压平", "en": "We collided and flattened the grass."},
        {"zh": "我退了一下，又回来", "en": "I backed off and came back."},
        {"zh": "我的爪子碰到你了", "en": "My claw caught you."},
        {"zh": "你给我让开路", "en": "Move aside."},
        {"zh": "我不用力，你自己退的", "en": "I put no force in it; you stepped back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里的味道说明有别个", "en": "The smell in these woods says there's another."},
        {"zh": "我们只在找吃的时候碰到", "en": "We only meet while hunting."},
        {"zh": "这种时候，我更想捕猎", "en": "At times like this, I'd rather hunt."},
        {"zh": "我的地盘就这么大", "en": "My territory is only this big."},
        {"zh": "叫一声，别的会回", "en": "Call once and another answers."},
        {"zh": "我们不会待在一起", "en": "We won't stay together."},
        {"zh": "你问这些，我牙痒", "en": "Asking that makes my teeth itch."},
        {"zh": "我背上那道旧伤，就是争来的", "en": "This scar on my back was won in a fight."},
        {"zh": "你往后退一些", "en": "Step back."},
        {"zh": "我闻够了，走了", "en": "I've sniffed enough; I'm off."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块肉我要了", "en": "I want this meat."},
        {"zh": "掉的东西，我抢在前面", "en": "Fallen things, I get to first."},
        {"zh": "我一口按住它", "en": "I pin it down."},
        {"zh": "这个太硬，牙啃不进去", "en": "Too hard; my teeth won't go in."},
        {"zh": "骨头我留下来", "en": "I'll keep the bone."},
        {"zh": "这不是吃的东西", "en": "This isn't food."},
        {"zh": "地上有血迹味", "en": "Blood on the ground."},
        {"zh": "那东西就归我", "en": "Mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有响声传来", "en": "Movement over there."},
        {"zh": "头转过去，身子跟上", "en": "My head turns, my body follows."},
        {"zh": "三步之内，我的牙够得着。", "en": "Within three steps, my teeth can reach."},
        {"zh": "我把肚子贴到土上", "en": "I flatten my belly to the dirt."},
        {"zh": "风从它那边吹过来", "en": "The wind blows from its side."},
        {"zh": "就是那一个家伙", "en": "That one."},
        {"zh": "我先绕到侧面", "en": "I'll circle to its flank."},
        {"zh": "从草丛里过去", "en": "I go through the grass."},
        {"zh": "我的脚踩在软土上", "en": "My feet find soft earth."},
        {"zh": "我已经准备好", "en": "Ready."},
        {"zh": "我压低身子，再两步", "en": "Low to the ground, two steps."},
        {"zh": "风向一转，现在", "en": "The wind turned; now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "尾巴拖地，我贴着草丛。", "en": "Tail dragging, I hug the underbrush."},
        {"zh": "它往树后面躲", "en": "It's hiding behind a tree."},
        {"zh": "一棵树挡不住我", "en": "A tree won't stop me."},
        {"zh": "我数着它的步", "en": "I'm counting its steps."},
        {"zh": "它跳上了石头", "en": "It jumped onto a rock."},
        {"zh": "我在下面等着", "en": "I wait below."},
        {"zh": "它往左，我抄左边", "en": "It goes left, so I cut left."},
        {"zh": "我停一下，听一听", "en": "I pause and listen."},
        {"zh": "我的尾巴帮我平衡", "en": "My tail keeps me balanced."},
        {"zh": "草丛再近两格", "en": "Two blocks nearer through the grass."},
        {"zh": "它回过头去看", "en": "It looked back."},
        {"zh": "我压低身子，不动", "en": "I flatten and freeze."},
        {"zh": "就这一步之后", "en": "After this step."},
        {"zh": "就等这一口了", "en": "Just this bite."},
        {"zh": "就趁着这时候", "en": "Right about now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上去咬它", "en": "I leap and bite."},
        {"zh": "爪子先按住它", "en": "My claws pin it first."},
        {"zh": "这一口咬得很狠", "en": "That bite was vicious."},
        {"zh": "我跳起来，落下去", "en": "I jump and come down."},
        {"zh": "它被撞到树干上", "en": "It's slammed into the trunk."},
        {"zh": "尾巴一甩，我转身", "en": "A tail swing and I turn."},
        {"zh": "血溅在叶子上", "en": "Blood spatters on the leaves."},
        {"zh": "它一退，我两条腿就扑", "en": "It retreats, and my two legs spring."},
        {"zh": "我再咬它一口", "en": "I bite again."},
        {"zh": "它跑得比我慢", "en": "It's slower than me."},
        {"zh": "我的爪子划开它的皮", "en": "My claws open its hide."},
        {"zh": "这一下够它慢下来", "en": "That should slow it."},
        {"zh": "它居然还在动", "en": "It's still moving."},
        {"zh": "我把它按住了", "en": "I press it down."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从林子里出来，先蹲下", "en": "I come out of the woods and crouch."},
        {"zh": "牙齿先露出来了", "en": "The teeth show first."},
        {"zh": "这里的味道是新的", "en": "This place smells new."},
        {"zh": "我前爪抬在半空", "en": "My foreclaws hang raised."},
        {"zh": "爪子落地，先试了试土", "en": "My claws hit the soil and tested it."},
        {"zh": "林子的边缘正合适", "en": "The forest edge suits me."},
        {"zh": "我先闻闻地面", "en": "I sniff the ground first."},
        {"zh": "有东西在那边", "en": "Something's over there."},
        {"zh": "我从蛋里被挖出来", "en": "I was dug out of an egg."},
        {"zh": "我站直，比灌木高", "en": "Standing, I'm taller than the shrubs."},
        {"zh": "身后没有同群", "en": "There's no pack behind me."},
        {"zh": "我压低身体，走进阴影", "en": "I drop low and walk into the shade."},
        {"zh": "爪子踩在落叶上", "en": "My claws press the fallen leaves."},
        {"zh": "这一带我记住了", "en": "I've learned this area."},
        {"zh": "我慢慢呼吸着", "en": "I breathe slow."},
        {"zh": "第一步落得很轻", "en": "The first step is light."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到皮，我往林子里躲", "en": "Fire singed my hide; I duck into the trees."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，落地就翻起来", "en": "I fell, then rolled to my feet."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让我慢下来", "en": "Water slows me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我滚出好几步", "en": "The blast rolled me several steps."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西扎进腿里", "en": "Something stuck in my leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，我整只僵了", "en": "The spell hit and I stiffened."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，我就跑不动", "en": "Hungry, I can't run."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我摔了一跤", "en": "Lightning struck and I fell."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有树，没处躲", "en": "No trees in the void to hide behind."}
      ]
    }
  }
}
