{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低身子小跑", "en": "I run with my body low."},
        {"zh": "两条腿踩进红土", "en": "Two legs dig into the red dirt."},
        {"zh": "我短小的前肢垂着", "en": "My stubby arms hang down."},
        {"zh": "我跑过恶地的石柱", "en": "I run past the badland pillars."},
        {"zh": "我一步能跨很远", "en": "My stride covers a lot."},
        {"zh": "我甩着长尾平衡", "en": "My long tail swings for balance."},
        {"zh": "我不追就难受", "en": "I itch when I am not chasing."},
        {"zh": "我绕过沙坑", "en": "I skirt a sand pit."},
        {"zh": "红土在我脚下散开", "en": "The red dirt scatters underfoot."},
        {"zh": "我一边跑一边嗅", "en": "I sniff as I run."},
        {"zh": "我慢下来看路", "en": "I slow to check the way."},
        {"zh": "我的脚趾抓地", "en": "My toes grip the ground."},
        {"zh": "我小跑着靠近", "en": "I trot closer."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，尾巴在动", "en": "I stand, tail moving."},
        {"zh": "恶地太干了", "en": "The badlands are so dry."},
        {"zh": "我把下颚左右磨了几圈。", "en": "I grind my lower jaw side to side."},
        {"zh": "风把红沙吹过来", "en": "Wind blows red sand over me."},
        {"zh": "我在等猎物靠近", "en": "I wait for prey to come near."},
        {"zh": "我闻到了血", "en": "I smell blood."},
        {"zh": "我的前爪很短，用不上", "en": "My little arms are useless."},
        {"zh": "我抬头看石柱", "en": "I look up at the pillars."},
        {"zh": "我身上的纹路很深", "en": "My hide has deep ridges."},
        {"zh": "我没有耐心", "en": "I have no patience."},
        {"zh": "我喘得很重", "en": "I breathe heavily."},
        {"zh": "我把脖子甩了甩", "en": "I roll my neck."},
        {"zh": "这片红土是我的", "en": "This red earth is mine."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站得直，我正好撞你的胸。", "en": "You stand upright, perfect for my chest charge."},
        {"zh": "我盯的是你的腿", "en": "I am watching your legs."},
        {"zh": "你比羊大一点", "en": "You are bigger than a goat."},
        {"zh": "你退我就进", "en": "You step back, I step in."},
        {"zh": "你的汗在干风里散得很慢。", "en": "Your sweat spreads slowly in the dry wind."},
        {"zh": "你的武器够长吗", "en": "Is that weapon long enough?"},
        {"zh": "我张开嘴你看得见", "en": "You can see my mouth open."},
        {"zh": "我在估你的重量", "en": "I am weighing you."},
        {"zh": "恶地的红土上，你的影子很短。", "en": "On red badland soil, your shadow is short."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你砍进我的皮里", "en": "You cut into my hide."},
        {"zh": "我低吼着退开", "en": "I growl and pull back."},
        {"zh": "这一下很疼", "en": "That hurt badly."},
        {"zh": "恶地里，我两三只一起走。", "en": "In the badlands, two or three of us walk."},
        {"zh": "血滴在红土上", "en": "Blood drips on the red dirt."},
        {"zh": "我咬紧了牙", "en": "I clench my teeth."},
        {"zh": "我还没倒下", "en": "I have not fallen."},
        {"zh": "再来我就撕碎你", "en": "Try again and I will tear you apart."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是肉", "en": "That is meat."},
        {"zh": "血味最实在", "en": "Blood is the real thing."},
        {"zh": "这小手臂够不到，我只能用嘴。", "en": "My little arms cannot reach it, so I use my mouth."},
        {"zh": "这东西够我一口", "en": "That is one bite for me."},
        {"zh": "我的前爪小得没用。", "en": "My little forearms are useless."},
        {"zh": "你再抖一下手", "en": "Twitch that hand again."},
        {"zh": "温的更好", "en": "Warm is better."},
        {"zh": "别以为我会等", "en": "Do not think I will wait."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步没退", "en": "I did not give a step."},
        {"zh": "你被顶得退开", "en": "You are shoved back."},
        {"zh": "我的腿比你的腰粗", "en": "My leg is thicker than your waist."},
        {"zh": "我侧过身让你过去", "en": "I turn aside to let you pass."},
        {"zh": "尾巴扫到你腿上", "en": "My tail sweeps your legs."},
        {"zh": "再来撞一次", "en": "Bump me again."},
        {"zh": "让开，不然我撞断你的骨头。", "en": "Move, or I'll break your bones."},
        {"zh": "这点份量，撞上来像挠痒。", "en": "That little bump feels like a scratch."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "恶地上只有我们", "en": "Only us in the badlands."},
        {"zh": "我绕着走一圈", "en": "I circle once."},
        {"zh": "别站得太近", "en": "Do not stand too close."},
        {"zh": "我的头会被撞歪", "en": "My head could get knocked crooked."},
        {"zh": "红土上会留下印子", "en": "There will be prints in the red dirt."},
        {"zh": "我蹭着它的头侧，角碰出闷响。", "en": "I nudge its head and our horns knock dully."},
        {"zh": "我之后还要去猎", "en": "I still have hunting after this."},
        {"zh": "你安静一点", "en": "Be quiet."},
        {"zh": "够了", "en": "Enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头我也咬得碎", "en": "I can crush the bones too."},
        {"zh": "我叼着不放", "en": "I clamp it in my jaws."},
        {"zh": "掉在红土上的都算我的", "en": "What falls on the red dirt is mine."},
        {"zh": "这点肉填不满我", "en": "This meat will not fill me."},
        {"zh": "我把它踩住", "en": "I pin it under a foot."},
        {"zh": "别靠近", "en": "Do not come near."},
        {"zh": "我先咬一口", "en": "One bite first."},
        {"zh": "它还很温", "en": "It is still warm."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了我的地盘", "en": "You are on my ground."},
        {"zh": "我朝你的方向低头", "en": "I lower my head toward you."},
        {"zh": "我尾巴一摆，红土上划出一道沟。", "en": "My tail swings and cuts a groove in the red earth."},
        {"zh": "你退到石柱间了", "en": "You are between the pillars."},
        {"zh": "这里没有地方躲", "en": "There is nowhere to hide."},
        {"zh": "我开始跑", "en": "I start to run."},
        {"zh": "我的头撞得动石头", "en": "My head can crack stone."},
        {"zh": "你的腿太短", "en": "Your legs are too short."},
        {"zh": "我低着头冲过来", "en": "I charge head down."},
        {"zh": "这一片红土我熟", "en": "I know this red earth."},
        {"zh": "别指望跑得过我", "en": "Do not count on outrunning me."},
        {"zh": "我的嘴已经张开", "en": "My jaws are open."},
        {"zh": "石柱之间的空隙，只够我一个身位。", "en": "The gap between the pillars fits only my width."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着红土追", "en": "I chase low over the red dirt."},
        {"zh": "你绕石柱也没用", "en": "Circling the pillar will not help."},
        {"zh": "我一步跨两米", "en": "I cover two meters a stride."},
        {"zh": "你的喘息越来越粗", "en": "Your panting is getting rough."},
        {"zh": "我压低身子加速", "en": "I drop low and speed up."},
        {"zh": "沙地会陷你的脚", "en": "The sand will catch your feet."},
        {"zh": "我就在你侧后", "en": "I am at your rear flank."},
        {"zh": "你只剩一条干河床", "en": "You have only a dry riverbed left."},
        {"zh": "我还能再跑很久", "en": "I can keep running a long while."},
        {"zh": "你的武器举得太高了", "en": "You have that weapon raised too high."},
        {"zh": "这一片开阔地很好跑", "en": "This open ground is good for running."},
        {"zh": "我数着你的步子了", "en": "I have counted your steps."},
        {"zh": "影子在缩短", "en": "The shadows are shortening."},
        {"zh": "你再快一点也不够", "en": "A little faster is still not enough."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用头撞过去", "en": "I slam with my head."},
        {"zh": "你胸口一闷", "en": "Your chest hitched."},
        {"zh": "我咬住你的肩膀", "en": "I bite your shoulder."},
        {"zh": "我的前爪按不住你", "en": "My little arms cannot hold you."},
        {"zh": "你被顶得倒在地上", "en": "You are knocked to the ground."},
        {"zh": "这一下带着全身冲力", "en": "That carried my full charge."},
        {"zh": "我的牙撕开你的护甲", "en": "My teeth tear your armor."},
        {"zh": "你退到沙坑边了", "en": "You are at the sand pit."},
        {"zh": "这次我用肩撞，把你顶离地面。", "en": "This time I hit with my shoulder and lift you off the ground."},
        {"zh": "你听见骨头的响声了吗", "en": "Did you hear that bone sound?"},
        {"zh": "这一下准", "en": "That one landed true."},
        {"zh": "我还没停", "en": "I have not stopped."},
        {"zh": "我低头冲撞，红沙被踢起来。", "en": "I lower my head and charge, kicking up red sand."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从红土后站起来", "en": "I rise from behind the red earth."},
        {"zh": "恶地上多了一个影子", "en": "One more shadow on the badlands."},
        {"zh": "我们来了两只", "en": "Two of us have come."},
        {"zh": "沙尘还没落", "en": "The dust has not settled."},
        {"zh": "我抖掉身上的红土", "en": "I shake off the red dirt."},
        {"zh": "我嗅了嗅风", "en": "I sniff the wind."},
        {"zh": "这里很干", "en": "It is very dry here."},
        {"zh": "我踩塌了一块土", "en": "A clod of earth caved under my foot."},
        {"zh": "我抬起头找声音", "en": "I raise my head toward the sound."},
        {"zh": "石柱挡着太阳", "en": "The pillars block the sun."},
        {"zh": "我从干裂的河床后站起来。", "en": "I rise from behind a cracked riverbed."},
        {"zh": "地上的小石子硌着我", "en": "Pebbles press under my feet."},
        {"zh": "我张开嘴，试了试咬合", "en": "I open my jaws and test the bite."},
        {"zh": "这一带没有猎物", "en": "No prey in this stretch."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火！别烧我的皮", "en": "Fire! Not my hide."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石柱上摔下来", "en": "I fell from the pillar."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我不习惯水", "en": "I am not used to water."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我发昏", "en": "That light dazes me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "恶地上找不到吃的", "en": "Nothing to eat in the badlands."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈得我跳起来", "en": "Lightning made me leap."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "连红土都没了", "en": "Even the red earth is gone."}
      ]
    }
  }
}
