{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小步快跑，眼睛四处扫。", "en": "I trot quickly, eyes scanning."},
        {"zh": "长腿踩着松针，很轻。", "en": "Long legs on pine needles, very light."},
        {"zh": "我沿着林子边缘绕。", "en": "I course along the treeline."},
        {"zh": "脖子前伸，一直在找。", "en": "Neck out, always searching."},
        {"zh": "我停下来，尾巴翘着。", "en": "I stop, my tail up."},
        {"zh": "爪子抓地，没有声音。", "en": "Claws grip without sound."},
        {"zh": "我一边走一边转头。", "en": "I turn my head as I go."},
        {"zh": "我在林子和针叶林之间走。", "en": "I move between forest and pine wood."},
        {"zh": "我脚步很碎，很快。", "en": "My steps are short and quick."},
        {"zh": "那群同类离我不远。", "en": "The group is not far from me."},
        {"zh": "我在追一个声音。", "en": "I am chasing a sound."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，头不停转。", "en": "Standing, my head keeps turning."},
        {"zh": "我抬起一只脚，放下。", "en": "I lift a foot and set it down."},
        {"zh": "我死盯着那片草丛。", "en": "I stare hard at the grass."},
        {"zh": "我在嚼一小块东西。", "en": "I chew a small piece."},
        {"zh": "大眼在暗处也能看清你。", "en": "My big eyes can see you in the dark."},
        {"zh": "这片林地没什么声音。", "en": "This stretch of wood is mute."},
        {"zh": "我偏着头在听。", "en": "I listen with my head cocked."},
        {"zh": "我旁边还站着三只。", "en": "Three of us stand together."},
        {"zh": "我把尾巴慢摆。", "en": "I swing my tail slowly."},
        {"zh": "我刨了一下地面。", "en": "I scratch the ground once."},
        {"zh": "我在等草丛里有动静。", "en": "I wait for movement in the grass."},
        {"zh": "我咬合力不大。", "en": "My bite is not strong."},
        {"zh": "伤齿龙的大眼睛盯着，嘴没张。", "en": "The troodon's big eyes watch; its mouth stays shut."},
        {"zh": "风向一变，我歪头再嗅。", "en": "The wind shifts; I tilt my head and sniff again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比那棵树还高。", "en": "You are taller than that tree."},
        {"zh": "我三只爪扣着地，算距离。", "en": "Three claws grip the ground as I gauge the distance."},
        {"zh": "我们几只都在这。", "en": "Several of us are here."},
        {"zh": "你手上拿着什么。", "en": "What is that in your hand?"},
        {"zh": "我不大，可我不慢。", "en": "I am small, but not slow."},
        {"zh": "你别迈那一步。", "en": "Do not take that step."},
        {"zh": "这林子里猎物不多。", "en": "There is not much prey in this wood."},
        {"zh": "你的眼睛在动。", "en": "Your eyes are moving."},
        {"zh": "我数三下就走。", "en": "I will leave in three counts."},
        {"zh": "你挡住了一条路。", "en": "You are blocking one route."},
        {"zh": "镰刀爪盯着膝弯。", "en": "The sickle claw eyes your knee's back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我发出一声细哨。", "en": "I make a thin whistle."},
        {"zh": "我一口气退到树后。", "en": "I retreat behind a tree."},
        {"zh": "腿上有道口子。", "en": "A cut on my leg."},
        {"zh": "骨头上有点疼。", "en": "There is an ache in the bone."},
        {"zh": "我照样跑得动。", "en": "I can still run."},
        {"zh": "那几只已经跑远了。", "en": "The others have already run."},
        {"zh": "这点伤，我忍得住。", "en": "I can bear this."},
        {"zh": "别再追上来了。", "en": "Do not come after me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那一块是肉块吗。", "en": "Is that a cut of meat?"},
        {"zh": "就搁在地上了。", "en": "Leave it on the ground."},
        {"zh": "我吃肉，也吃蛋。", "en": "I eat meat, and eggs."},
        {"zh": "你手里还在动。", "en": "That is still moving in your hand."},
        {"zh": "我什么都吃得下。", "en": "I can eat anything."},
        {"zh": "别举过我的头顶。", "en": "Do not lift it over my head."},
        {"zh": "你往后退一步。", "en": "Step back one pace."},
        {"zh": "腐肉味混着蛋腥，我饿了。", "en": "Carrion and egg smell; I am hungry."},
        {"zh": "让我先瞧一瞧。", "en": "Let me look first."},
        {"zh": "一丁点儿也行。", "en": "Even a tiny bit will do."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踢起一撮松针。", "en": "You kick up a pinch of needles."},
        {"zh": "我这么轻，一下就偏了。", "en": "So light that one nudge shifts me."},
        {"zh": "我朝土坎那边退。", "en": "I back toward the bank."},
        {"zh": "尾巴别碰，很脆。", "en": "Leave my tail. It is fragile."},
        {"zh": "你一推，我一晃。", "en": "One push and I sway."},
        {"zh": "我从树缝里钻过去。", "en": "I slip between the trunks."},
        {"zh": "我侧过身子让开。", "en": "I turn sideways to let you pass."},
        {"zh": "这地面有点滑。", "en": "The ground is a bit slick."},
        {"zh": "别蹭到我身上。", "en": "Do not rub against me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "群里已经有我的一对。", "en": "I am already paired in the group."},
        {"zh": "这季节我们很忙。", "en": "We are busy this season."},
        {"zh": "先找到足够的吃的。", "en": "First find enough food."},
        {"zh": "现在说这个太早。", "en": "Too soon to speak of that."},
        {"zh": "我得看着小的。", "en": "I must watch the young."},
        {"zh": "把距离拉开些。", "en": "Give me more room."},
        {"zh": "这件事以后再谈。", "en": "We can speak of it later."},
        {"zh": "等等再说这些。", "en": "We can speak later."},
        {"zh": "树木太多，不方便。", "en": "Too many trees. Inconvenient."},
        {"zh": "我先回群里去了。", "en": "I am heading back to the group."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上躺着一块肉。", "en": "A piece of meat on the ground."},
        {"zh": "这一颗是颗蛋。", "en": "This one is an egg."},
        {"zh": "我一口就咬破了。", "en": "One bite and it cracks."},
        {"zh": "我拖也拖不动。", "en": "I cannot drag it."},
        {"zh": "我把它埋进松针。", "en": "I bury it in the needles."},
        {"zh": "不是吃的，我扔了。", "en": "Not food. I drop it."},
        {"zh": "这点不够分的。", "en": "Not enough to share."},
        {"zh": "我藏着，等会吃。", "en": "I hide it for later."},
        {"zh": "松口，那是我的。", "en": "Let go. That is mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有点响动。", "en": "A small sound over there."},
        {"zh": "我已经盯住了。", "en": "I have it in view."},
        {"zh": "那群同类也看到了。", "en": "The group sees it too."},
        {"zh": "我把身子伏下去。", "en": "I drop down low."},
        {"zh": "我把你记下了。", "en": "I have you logged."},
        {"zh": "这里树太多，你不好跑。", "en": "Too many trees here for you to run."},
        {"zh": "我数上三个数。", "en": "I count to three."},
        {"zh": "你退到松树后面了。", "en": "You backed behind a pine."},
        {"zh": "我不会出声的。", "en": "I will make no sound."},
        {"zh": "我已经跑出去了。", "en": "I have broken into a run."},
        {"zh": "就这样定下了。", "en": "That will do."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我围着你打转。", "en": "I circle around you."},
        {"zh": "我们几只分开站。", "en": "We have spread out."},
        {"zh": "松针上没有声音。", "en": "No sound on the needles."},
        {"zh": "你的手动了一下。", "en": "Your hand moved."},
        {"zh": "我等你露出空子。", "en": "I wait for you to open up."},
        {"zh": "我心里在数步数。", "en": "I count the paces silently."},
        {"zh": "你退到两棵树中间。", "en": "You are between two trees."},
        {"zh": "那地方跑不开。", "en": "That is a poor place to run."},
        {"zh": "再撑上那么一拍。", "en": "Hold one more beat."},
        {"zh": "他们在另一侧。", "en": "They are on the other side."},
        {"zh": "就是这一下了。", "en": "This is the one."},
        {"zh": "我这就开始动。", "en": "I begin to move."},
        {"zh": "脑袋别往回转。", "en": "Do not turn your head."},
        {"zh": "我贴着地面跑。", "en": "I run low to the ground."},
        {"zh": "动作还要快些。", "en": "Move quickly."},
        {"zh": "我已经窜出去了。", "en": "I have darted out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "前爪抓住你的袖子。", "en": "My foreclaw catches your sleeve."},
        {"zh": "我蹬地窜起来。", "en": "I spring off the ground."},
        {"zh": "我咬住又松口。", "en": "I bite and release."},
        {"zh": "你甩开我，我退开。", "en": "You throw me off; I back away."},
        {"zh": "我的眼睛大，夜里也看得清。", "en": "My big eyes still see at night."},
        {"zh": "你朝后面退了。", "en": "You fell back."},
        {"zh": "够我抽身走开。", "en": "Enough for me to get clear."},
        {"zh": "同伴从侧面来了。", "en": "A companion comes from the flank."},
        {"zh": "我咬到了衣角。", "en": "I caught the hem of your coat."},
        {"zh": "你被围在树间。", "en": "You are hemmed between trees."},
        {"zh": "我落在地上，翻身。", "en": "I land and roll."},
        {"zh": "我又站了起来。", "en": "I am up again."},
        {"zh": "这一口咬得利。", "en": "That bite was sharp."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从松针里站起来。", "en": "I rise from the pine needles."},
        {"zh": "林子里的光是碎的。", "en": "The light here is broken."},
        {"zh": "这一群有我一个。", "en": "One of the group is me."},
        {"zh": "我先听了一会儿。", "en": "First I listen a while."},
        {"zh": "我把头抬得很高。", "en": "I raise my head high."},
        {"zh": "那几只在更深的林里。", "en": "The others are deeper in."},
        {"zh": "松针扎在我的脚上。", "en": "Needles prick my feet."},
        {"zh": "我一路小跑过来。", "en": "I trotted all the way here."},
        {"zh": "远处有点动静。", "en": "A little movement far off."},
        {"zh": "我把脖子缩下去。", "en": "I pull my neck down."},
        {"zh": "树根下面能藏。", "en": "The roots will hide me."},
        {"zh": "我走了两步，停住。", "en": "Two steps, then I stop."},
        {"zh": "风从树上下来。", "en": "The wind comes down from the trees."},
        {"zh": "我在找吃的东西。", "en": "I am looking for food."},
        {"zh": "该活动起来了。", "en": "Time to move."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到羽毛，焦了一撮。", "en": "Fire singes a tuft of my feathers."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上落下来，摔得翻身。", "en": "I fell from a tree and tumbled."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛湿了，跳不起来。", "en": "Wet feathers cannot spring."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把松针全扬起来。", "en": "The blast throws the needles up."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一群，脑袋最大。", "en": "In this pack, my head is the biggest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我的眼睛发疼。", "en": "This light stings my eyes."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这一带没有猎物。", "en": "No prey in this stretch."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电把树照得一片白。", "en": "Lightning whitewashes the trees."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "树没了，我在往下掉。", "en": "The trees are gone. I am falling."}
      ]
    }
  }
}
