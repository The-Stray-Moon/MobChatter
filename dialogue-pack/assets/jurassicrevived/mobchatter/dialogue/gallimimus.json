{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着长腿往前跑。", "en": "I run forward on long legs."},
        {"zh": "每一步跨得很远。", "en": "Each stride covers a lot of ground."},
        {"zh": "我贴着地面跑得很快。", "en": "I run fast, low to the ground."},
        {"zh": "我跟着队伍，挤在一起。", "en": "I stay in the herd, packed close."},
        {"zh": "风从我的脖子边过去。", "en": "Wind passes my neck."},
        {"zh": "我一边跑一边抬头。", "en": "I look up as I run."},
        {"zh": "我的尾巴伸得笔直。", "en": "My tail is straight out behind me."},
        {"zh": "我的脚趾踩出深印。", "en": "My toes press deep prints."},
        {"zh": "我慢慢减速，绕了一圈。", "en": "I slow down and circle."},
        {"zh": "我在草坡上拐弯。", "en": "I turn on a grassy slope."},
        {"zh": "有几只跟在我后面。", "en": "A few follow behind me."},
        {"zh": "我从来没走过这么快。", "en": "I've never walked this fast."},
        {"zh": "我的脚趾抓得很稳。", "en": "My toes grip firmly."},
        {"zh": "我们再绕一圈。", "en": "We circle once more."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停下来，还喘着。", "en": "I stop, still breathing hard."},
        {"zh": "我的腿还在轻轻抖。", "en": "My legs are still trembling a little."},
        {"zh": "我把脖子抬得很高。", "en": "I hold my neck up high."},
        {"zh": "主世界的风很轻。", "en": "The wind in the Overworld is light."},
        {"zh": "我低头看了一眼草。", "en": "I glance at the grass."},
        {"zh": "我伸出前爪刨了刨。", "en": "I scratch at the ground with a foreleg."},
        {"zh": "林线在很远的地方。", "en": "The treeline is far off."},
        {"zh": "我慢慢嚼了两口。", "en": "I chew twice, slowly."},
        {"zh": "我在听同伴的声音。", "en": "I listen for the herd."},
        {"zh": "它们没走远。", "en": "They haven't gone far."},
        {"zh": "抬起头，看看前面。", "en": "Head up to see ahead."},
        {"zh": "再跑上一段路。", "en": "A little more running."},
        {"zh": "我把腿收了一下。", "en": "I drew my legs in."},
        {"zh": "风从另一边来了。", "en": "The wind came from the other side."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我们矮多了。", "en": "You're much shorter than us."},
        {"zh": "我得低下头看你。", "en": "I have to lower my head to see you."},
        {"zh": "你站着不动，我先迈一步。", "en": "You stand still, so I take the first step."},
        {"zh": "那我也就停一下。", "en": "Then I'll pause too."},
        {"zh": "你的靴子跑不快。", "en": "Your boots won't run fast."},
        {"zh": "我见过追我们的人。", "en": "I've seen people chase us."},
        {"zh": "他们都没追上。", "en": "None of them caught up."},
        {"zh": "你手里的东西是武器吗？", "en": "Is that a weapon in your hand?"},
        {"zh": "我往旁边挪了两步。", "en": "I shifted two steps aside."},
        {"zh": "我们一直在准备跑。", "en": "We're always ready to run."},
        {"zh": "你的手别伸高。", "en": "Don't raise your hand."},
        {"zh": "我们已经准备走了。", "en": "We're ready to leave."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你这下打在我腿上。", "en": "That hit my leg."},
        {"zh": "我在草里踉跄一下。", "en": "I stumbled in the grass."},
        {"zh": "膝盖一软，我趔趄了一下。", "en": "My knee gives and I stumble."},
        {"zh": "这点伤还跑得动。", "en": "I can still run with this."},
        {"zh": "同伴在叫我，声音很尖。", "en": "My flock is calling — high and sharp."},
        {"zh": "我往旁边退。", "en": "I back aside."},
        {"zh": "你这一下打得我偏了方向。", "en": "That blow knocked me off course."},
        {"zh": "我低头看草上的血。", "en": "I look down at blood on the grass."},
        {"zh": "三条腿撑着，我还稳。", "en": "Three toes down, I'm still steady."},
        {"zh": "这一下我记住。", "en": "I'll remember that."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里有草吗？", "en": "Do you have grass?"},
        {"zh": "那一点不够。", "en": "That little isn't enough."},
        {"zh": "先放下，我再靠近。", "en": "Set it down first, then I'll come close."},
        {"zh": "我不停下吃东西。", "en": "I don't stop to eat."},
        {"zh": "我们边跑边找。", "en": "We look for food while running."},
        {"zh": "那味道还行。", "en": "The smell is acceptable."},
        {"zh": "我会绕一圈回来。", "en": "I'll circle back for it."},
        {"zh": "你别跟在我后头，我紧张。", "en": "Don't trail behind me, I get nervous."},
        {"zh": "我们自己找得到。", "en": "We can find our own."},
        {"zh": "主世界这么大，我跑着。", "en": "The overworld is wide. I run it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你在草坡上撞我的腿。", "en": "You hit my leg on the grassy slope."},
        {"zh": "我没有再停下。", "en": "I didn't stop."},
        {"zh": "群居的腿，跑得比你想的快。", "en": "Herd legs run faster than you think."},
        {"zh": "你从我旁边滑过去。", "en": "You slid past me."},
        {"zh": "我的腿太长了。", "en": "My legs are too long."},
        {"zh": "你撞不到我的身子。", "en": "You can't reach my body."},
        {"zh": "白桦被我们撞得摇。", "en": "The birch shook from our impact."},
        {"zh": "树晃了两下。", "en": "The tree swayed."},
        {"zh": "你退到一边。", "en": "You moved off."},
        {"zh": "我继续跟着队伍。", "en": "I keep up with the herd."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们都是一群一群的。", "en": "We travel in herds."},
        {"zh": "这种事，我们不太讲究。", "en": "We're not fussy about that."},
        {"zh": "队里有好几十个。", "en": "There are dozens in the herd."},
        {"zh": "你别挑挑拣拣。", "en": "Don't pick."},
        {"zh": "我们跑起来都一样。", "en": "We all run the same."},
        {"zh": "风里全是别的族群的味道。", "en": "The wind is full of other flock scents."},
        {"zh": "你走你的路吧。", "en": "Be on your way."},
        {"zh": "我要跟上队伍。", "en": "I need to keep up with the herd."},
        {"zh": "它们已经跑远了。", "en": "They've already gone far."},
        {"zh": "我这就去追。", "en": "I'm going after them."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用长嘴啄了啄。", "en": "I pecked at it with my long bill."},
        {"zh": "这东西是硬的。", "en": "It's hard."},
        {"zh": "我把那东西踢远了。", "en": "I kicked it far off."},
        {"zh": "这东西从你身上掉下。", "en": "This fell off you."},
        {"zh": "我跑的时候看见了。", "en": "I saw it while running."},
        {"zh": "我根本没停下来。", "en": "I didn't stop."},
        {"zh": "那玩意儿闻起来不能吃。", "en": "That thing smells inedible."},
        {"zh": "我绕着那堆东西跑过去。", "en": "I ran around that pile."},
        {"zh": "别丢在我们路上。", "en": "Don't drop it in our path."},
        {"zh": "我们踩上去会滑。", "en": "It'll be slippery underfoot."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你一跑，我的腿就痒。", "en": "When you run, my legs itch to follow."},
        {"zh": "我全看见了。", "en": "I saw it."},
        {"zh": "我们比你先跑。", "en": "We started running before you."},
        {"zh": "那边有几个人影。", "en": "There are figures over there."},
        {"zh": "不是我们这一队的。", "en": "Not from our herd."},
        {"zh": "我的头已经转过去了。", "en": "My head has turned that way."},
        {"zh": "同伴都在跑。", "en": "The herd is running."},
        {"zh": "我也该跟上。", "en": "I should keep up."},
        {"zh": "你的方向反了。", "en": "You're going the wrong way."},
        {"zh": "我们的路在那边。", "en": "Our route is that way."},
        {"zh": "它们已经跑起来了。", "en": "They've started running."},
        {"zh": "我的脚尖朝着那边。", "en": "My toes point that way."},
        {"zh": "我不等你了。", "en": "I won't wait for you."},
        {"zh": "你追不上的。", "en": "You can't catch us."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着草坡跑。", "en": "I run along the grassy slope."},
        {"zh": "整群都跟着我转向。", "en": "The herd turns with me."},
        {"zh": "你落在后面了。", "en": "You've fallen behind."},
        {"zh": "跑起来我就不打算停。", "en": "Once I run, I don't plan to stop."},
        {"zh": "我跳过一个坑。", "en": "I leap a ditch."},
        {"zh": "我转弯的时候歪了一下。", "en": "I leaned into the turn."},
        {"zh": "地上的草被踩倒一整条。", "en": "A whole line of grass is trampled."},
        {"zh": "你竟然还在追。", "en": "You're still chasing."},
        {"zh": "我的长腿一步顶你两步。", "en": "My long stride eats two of yours."},
        {"zh": "再跑一会你就看不见我们。", "en": "A little more and you'll lose us."},
        {"zh": "前面是一片开阔地。", "en": "Open ground ahead."},
        {"zh": "那里跑得更快。", "en": "We'll be faster there."},
        {"zh": "我把身体放低。", "en": "I lower my body."},
        {"zh": "风从耳边过去。", "en": "Wind passes my ears."},
        {"zh": "我一直在它们中间。", "en": "I stay among them."},
        {"zh": "你不用追了。", "en": "You can stop chasing."},
        {"zh": "前面有片矮草。", "en": "There's a stretch of short grass ahead."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹬了一脚。", "en": "I kicked once."},
        {"zh": "主世界里的我，跑起来像一阵灰。", "en": "In the overworld, I run like a puff of dust."},
        {"zh": "你被蹬得退了半步。", "en": "The kick knocked you back half a step."},
        {"zh": "我踢起一片土。", "en": "I kicked up a spray of soil."},
        {"zh": "土落在你身上。", "en": "Soil fell on you."},
        {"zh": "我又跑开了。", "en": "I ran off again."},
        {"zh": "这一脚不算重。", "en": "That kick wasn't heavy."},
        {"zh": "但够我脱身。", "en": "But it was enough to break away."},
        {"zh": "我不会停下来打。", "en": "I won't stop to fight."},
        {"zh": "我们只会跑。", "en": "We only run."},
        {"zh": "我跳起来用腿蹬。", "en": "I spring and kick."},
        {"zh": "你被踢得偏了一点。", "en": "You were knocked off line."},
        {"zh": "我落地就跑。", "en": "I land and run."},
        {"zh": "我用长腿扫了一下。", "en": "I sweep a long leg."},
        {"zh": "你被绊了半步。", "en": "You tripped half a step."},
        {"zh": "我趁机跑开。", "en": "I take the chance to run."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我们从坡上跑下来。", "en": "We come running down the slope."},
        {"zh": "好几个一起。", "en": "Several of us at once."},
        {"zh": "草被我们踩出一条路。", "en": "We wear a path through the grass."},
        {"zh": "风里有我们的味道。", "en": "Our scent is in the wind."},
        {"zh": "我放慢了一点。", "en": "I slowed a little."},
        {"zh": "平原前头有东西在动。", "en": "Something stirs at the plain's edge."},
        {"zh": "我把脖子伸高。", "en": "I stretch my neck up."},
        {"zh": "这是主世界。", "en": "This is the Overworld."},
        {"zh": "比我记得的空旷。", "en": "Emptier than I remember."},
        {"zh": "我们停一下。", "en": "We'll pause."},
        {"zh": "我朝队伍那边叫。", "en": "I call toward the herd."},
        {"zh": "好几只回头了。", "en": "Several turned their heads."},
        {"zh": "地上很快会有一片脚印。", "en": "Soon there'll be a spread of prints."},
        {"zh": "你站的位置正在路中间。", "en": "You're standing in the middle of our path."},
        {"zh": "我们绕开你。", "en": "We'll go around you."},
        {"zh": "我们的影子排成一线。", "en": "Our shadows line up."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我的羽毛都焦了。", "en": "Fire scorched my feathers."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去的时候，我撑住了。", "en": "I braced as I fell."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水到我的胸口，我犹豫了。", "en": "Water reached my chest. I hesitated."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "震荡把草都掀平了。", "en": "The shock flattened the grass."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭擦过我的长腿。", "en": "An arrow grazed my long leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光打在我身上，我停了一拍。", "en": "The light hit and I missed a beat."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "草被别的吃光了，我饿。", "en": "Others ate the grass. I'm hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在草坡上，我伏低了。", "en": "Lightning struck the slope. I flattened."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有落脚的草。", "en": "No grass to stand on here."}
      ]
    }
  }
}
