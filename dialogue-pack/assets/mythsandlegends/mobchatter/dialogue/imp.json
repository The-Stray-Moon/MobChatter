    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的影子在墙上，太清楚。", "en": "Your shadow on the wall is far too clear."},
        {"zh": "火星飘向你，就是记号。", "en": "A spark drifts to you as my mark."},
        {"zh": "火焰中的影子", "en": "Shadow in flames"},
        {"zh": "我先咬一口，再分成两个追你。", "en": "I take one bite, then split in two to chase you."},
        {"zh": "你的气息泄露", "en": "Your scent betrays you"},
        {"zh": "我落到你肩上，你已经晚了。", "en": "I have landed on your shoulder — too late for you."},
        {"zh": "火焰中的眼睛", "en": "Eye in flames"},
        {"zh": "燃烧的视野", "en": "Blazing vision"},
        {"zh": "我飘在火里，你打不中。", "en": "I drift in the flame; you cannot hit me."},
        {"zh": "火光照到你，跑不掉了。", "en": "The firelight found you. No escape."},
        {"zh": "你的影子在墙上，太大了。", "en": "Your shadow on the wall is too big."},
        {"zh": "下界的热气把你送来了。", "en": "The Nether's heat carried you here."},
        {"zh": "我死后会变成两个，等着。", "en": "When I die I become two. Wait and see."},
        {"zh": "火焰之心在跳，为了你。", "en": "My fire heart beats, for you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "燃烧我的愤怒", "en": "Burn my anger"},
        {"zh": "燃烧的箭矢", "en": "Blazing arrow"},
        {"zh": "火焰中的咆哮", "en": "Roar in flames"},
        {"zh": "我将吞噬你", "en": "I will consume you"},
        {"zh": "火焰中的怒吼", "en": "Roar of flame"},
        {"zh": "燃烧的愤怒", "en": "Blazing fury"},
        {"zh": "我的火焰将烧尽你", "en": "My flame will consume you"},
        {"zh": "燃烧吧, 你这微不足道的存在", "en": "Burn, you insignificant"},
        {"zh": "我飘到你左边，又右边。", "en": "I drift left of you, then right."},
        {"zh": "打不着我，别浪费箭。", "en": "You cannot hit me. Save your arrows."},
        {"zh": "你举盾的方向反了。", "en": "Your shield faces the wrong way."},
        {"zh": "火焰贴着你的脚踝转。", "en": "Flame circles your ankles."},
        {"zh": "再近一点，我就炸开。", "en": "Closer, and I burst apart."},
        {"zh": "水桶举高一点，我盯着。", "en": "Raise that bucket higher; I'm watching it."},
        {"zh": "别看我的尾巴，看我的手。", "en": "Do not watch my tail. Watch my hands."},
        {"zh": "三点伤害，一下一下来。", "en": "Three damage at a time, again and again."}
      ]
    },
