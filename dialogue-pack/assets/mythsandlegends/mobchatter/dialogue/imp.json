{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，火焰在我体内燃烧！", "en": "Hisss, fire burns within me!"},
        {"zh": "我飘忽不定，难缠的敌人！", "en": "I'm elusive, a tricky foe!"},
        {"zh": "火焰之心，是我的灵魂所在！", "en": "The Heart of Fire, my soul's core!"},
        {"zh": "追随我，感受火焰之舞！", "en": "Follow me, feel the dance of flame!"},
        {"zh": "你根本捉不到我，飘渺如影！", "en": "You can't catch me, elusive like a shadow!"},
        {"zh": "我的影分身，是致命的拷贝！", "en": "My shadow copies, deadly duplicates!"},
        {"zh": "下界之火，吞噬一切！", "en": "Nether flame, consumes all!"},
        {"zh": "别靠近我，你的灵魂会燃烧！", "en": "Stay back, your soul will burn!"},
        {"zh": "火焰之魂，燃烧我每一寸！", "en": "Flame spirit, burns through me!"},
        {"zh": "飘忽不定，你捉不到我！", "en": "I'm elusive, you can't catch me!"},
        {"zh": "五点血，也够我绕你三圈。", "en": "Five health, and still I circle you thrice."},
        {"zh": "小蹄子踩在岩浆石上，不烫。", "en": "Little hooves on lava rock, unburnt."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "在这熔岩中，我是不灭之魂！", "en": "In the lava, I'm an unending spirit!"},
        {"zh": "火焰中我沉睡，待时机重生！", "en": "I slumber in flames, for a rebirth!"},
        {"zh": "火焰是我的庇护所，我在这里！", "en": "Flames are my sanctuary, I am here!"},
        {"zh": "等待你的，是无尽的灼烧！", "en": "What you face, is endless burning!"},
        {"zh": "火焰之心，赐我永恒！", "en": "Heart of Fire, grants me eternity!"},
        {"zh": "在这熔岩之中，我是不死！", "en": "In this lava, I am undying!"},
        {"zh": "火焰之息，是我存在的证明！", "en": "Flame's breath,证明我的存在!"},
        {"zh": "等待吧，你的末日临近！", "en": "Wait, your end is near!"},
        {"zh": "火焰之魂，永生不死！", "en": "Flame spirit, eternal and unbreakable!"},
        {"zh": "在这烈焰之中，我是永恒！", "en": "In this inferno, I am eternal!"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物出现了，猎杀开始！", "en": "Prey appears, hunt begins!"},
        {"zh": "你身上有下界的焦味。", "en": "You carry the scorched smell of the Nether."},
        {"zh": "我飘忽不定，你打不中。", "en": "I flicker and drift — you won't land a hit."},
        {"zh": "我飘到左边，又飘回右边。", "en": "I drift left, then back to the right."},
        {"zh": "你颤抖着，猎物颤抖！", "en": "You tremble, prey trembling!"},
        {"zh": "猎物的恐惧，很美味！", "en": "Fear of prey, is delightful!"},
        {"zh": "你的末日，即将来临！", "en": "Your end is coming soon!"},
        {"zh": "猎物就在眼前，不要错过！", "en": "Prey in sight, don't miss it!"},
        {"zh": "你的恐惧，是火焰的馈赠！", "en": "Your fear, flame's gift!"},
        {"zh": "猎杀，即将结束！", "en": "Hunt, almost over!"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "惨了，又受伤了！", "en": "Oh no, hurt again!"},
        {"zh": "这下可糟了……", "en": "That's bad..."},
        {"zh": "打散我，你会看到两个。", "en": "Break me and you'll see two."},
        {"zh": "疼得我直打滚！", "en": "Pain rolling me!"},
        {"zh": "疼，可我一死就分成两个。", "en": "It hurts, but dying just splits me in two."},
        {"zh": "哎呀，又受伤了！", "en": "Ouch, hurt again!"},
        {"zh": "伤痕累累的我！", "en": "Wounded me!"},
        {"zh": "这下惨了，又伤了！", "en": "Double hurt now!"},
        {"zh": "伤势严重，快治治！", "en": "Serious wound, heal me!"},
        {"zh": "受伤好痛苦！", "en": "Hurt, so painful!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰在我的心中燃烧！", "en": "Flame burns in my heart!"},
        {"zh": "靠近我，你将后悔！", "en": "Come closer, and you'll regret it!"},
        {"zh": "火光照亮了我的道路！", "en": "Firelight guides my path!"},
        {"zh": "这块炭比你的面包香。", "en": "This coal smells better than your bread."},
        {"zh": "吞下火焰，你会死去！", "en": "Swallow flame, and you'll die!"},
        {"zh": "燃烧吧，我的灵魂！", "en": "Burn, my soul!"},
        {"zh": "火苗从我嘴里卷出来。", "en": "Flames curl out of my mouth."},
        {"zh": "火焰之心是我的力量！", "en": "Heart of flame is my power!"},
        {"zh": "火焰驱散黑暗！", "en": "Flame drives away darkness!"},
        {"zh": "火光照亮了我的双眼！", "en": "Firelight brightens my eyes!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的尾巴了！", "en": "You stepped on my tail!"},
        {"zh": "你撞散了我一点火星。", "en": "You scatter a few of my sparks."},
        {"zh": "我不能错过你！", "en": "I can't miss you!"},
        {"zh": "我死了会裂成两个。", "en": "Kill me and I split in two."},
        {"zh": "我的分身在等待！", "en": "My split is waiting!"},
        {"zh": "躲开我的爪子！", "en": "Avoid my claws!"},
        {"zh": "火焰包围你！", "en": "Flame surrounds you!"},
        {"zh": "燃烧的碎片！", "en": "Burning fragments!"},
        {"zh": "火焰中的恶灵！", "en": "Evil spirit in flame!"},
        {"zh": "我的分身在行动！", "en": "My split acts!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "两个我，才凑得成一对。", "en": "It takes two of me to make a pair."},
        {"zh": "一起燃烧吧！", "en": "Burn together!"},
        {"zh": "我一死，就分成两个。", "en": "When I die, I split into two."},
        {"zh": "让我们融合！", "en": "Let's fuse!"},
        {"zh": "火焰中的爱情！", "en": "Love in flame!"},
        {"zh": "我的爱燃烧！", "en": "My love burns!"},
        {"zh": "火焰中的结合！", "en": "Union in flame!"},
        {"zh": "我的同类，我的爱！", "en": "My mate, my love!"},
        {"zh": "火焰中的生命！", "en": "Life in flame!"},
        {"zh": "我的同类，我的火焰！", "en": "My mate, my flame!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰之心闪耀着微光", "en": "Flame Heart glows faintly"},
        {"zh": "从你的手中裂开", "en": "Cracks in your hand"},
        {"zh": "我永远属于下界", "en": "I belong to the Nether"},
        {"zh": "燃烧吧，我的遗产", "en": "Burn, my legacy"},
        {"zh": "火焰之魂在跳动", "en": "Flame spirit pulsing"},
        {"zh": "你触摸了不该触碰的", "en": "You touched the forbidden"},
        {"zh": "火焰中的灵魂", "en": "Souls in flames"},
        {"zh": "带着我，去下界", "en": "Take me to the Nether"},
        {"zh": "火焰的心跳", "en": "Heartbeat of flame"},
        {"zh": "燃烧吧，我的存在", "en": "Burn, my essence"}
