{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我端着一盏蜡烛走。", "en": "I walk carrying a candle."},
        {"zh": "火苗随着我的步子晃。", "en": "The flame sways with my steps."},
        {"zh": "我的袍子擦过地面。", "en": "My robe brushes the floor."},
        {"zh": "我走得很慢，怕火灭了。", "en": "I walk slowly so the flame does not die."},
        {"zh": "我穿过长廊，影子跟着。", "en": "I cross the corridor, shadow trailing."},
        {"zh": "我停在柱子旁边。", "en": "I stop by a pillar."},
        {"zh": "我又继续往前走。", "en": "I walk on."},
        {"zh": "我用一只手护着火。", "en": "I shield the flame with one hand."},
        {"zh": "蜡油滴在地上。", "en": "Wax drips to the floor."},
        {"zh": "我绕开一片水渍。", "en": "I step around a wet patch."},
        {"zh": "我朝有风的方向背过身。", "en": "I turn my back to the wind."},
        {"zh": "我又往前挪了半步。", "en": "I shift forward half a step."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，蜡烛在手。", "en": "I stand with the candle in hand."},
        {"zh": "火苗安静地烧。", "en": "The flame burns quietly."},
        {"zh": "我的脸在火光里。", "en": "My face is in the firelight."},
        {"zh": "我不说话。", "en": "I say nothing."},
        {"zh": "我在看烛芯。", "en": "I am watching the wick."},
        {"zh": "蜡又短了一截。", "en": "The candle has shortened again."},
        {"zh": "我把它举高一点。", "en": "I raise it a little."},
        {"zh": "长夜里我得看着它。", "en": "In the long night I must watch it."},
        {"zh": "我又低下头。", "en": "I lower my head."},
        {"zh": "火光在我脚下晃。", "en": "The light wavers at my feet."},
        {"zh": "我的袍角有烧过的痕。", "en": "There are scorch marks on my hem."},
        {"zh": "我转过身，火苗没晃。", "en": "I turn, and the flame does not waver."},
        {"zh": "我在听有没有风。", "en": "I listen for a draft."},
        {"zh": "这里很暗，只有我的火。", "en": "It is dark here but for my fire."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起眼看你。", "en": "I lift my eyes to you."},
        {"zh": "火照亮了你的脸。", "en": "The fire lights your face."},
        {"zh": "你走得很轻。", "en": "Your steps are light."},
        {"zh": "这里不该有人来。", "en": "No one should come here."},
        {"zh": "你冷吗？", "en": "Are you cold?"},
        {"zh": "我把蜡烛举高些。", "en": "I raise the candle higher."},
        {"zh": "火光在你身后拉出影子。", "en": "The flame draws your shadow behind you."},
        {"zh": "我的火不能给你。", "en": "My fire is not for giving."},
        {"zh": "你看着它做什么？", "en": "Why do you look at it?"},
        {"zh": "我们在这站一会儿吧。", "en": "Let us stand here a while."},
        {"zh": "你别靠太近。", "en": "Do not come too close."},
        {"zh": "蜡油会烫。", "en": "The wax will burn."},
        {"zh": "火光里我眨了一次眼。", "en": "I blink once in the firelight."},
        {"zh": "你的影子跟着我的火动。", "en": "Your shadow moves with my fire."},
        {"zh": "我什么都没说。", "en": "I said nothing."},
        {"zh": "你来晚了。", "en": "You came too late."},
        {"zh": "灯油快没了。", "en": "The oil is nearly gone."},
        {"zh": "我继续守着。", "en": "I keep my watch."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "火晃了一下。", "en": "The flame wavers."},
        {"zh": "我往后错了一步。", "en": "I shift back a step."},
        {"zh": "我把蜡烛护得更紧。", "en": "I shield the candle tighter."},
        {"zh": "蜡油洒了些。", "en": "Some wax spills."},
        {"zh": "我没有出声。", "en": "I make no sound."},
        {"zh": "我抬手按着伤处。", "en": "I press a hand to the wound."},
        {"zh": "火又直了。", "en": "The flame straightens."},
        {"zh": "我还能站着。", "en": "I can still stand."},
        {"zh": "你差点把火弄灭。", "en": "You nearly put the fire out."},
        {"zh": "我不会让你再近。", "en": "I will not let you closer."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西。", "en": "I do not eat."},
        {"zh": "你把它拿开。", "en": "Take it away."},
        {"zh": "火光不能被挡。", "en": "The light must not be blocked."},
        {"zh": "别拿那东西换我的火。", "en": "Do not offer that for my fire."},
        {"zh": "我看了看，退开了。", "en": "I look, then step back."},
        {"zh": "这不是我等的。", "en": "That is not what I wait for."},
        {"zh": "你留着吧。", "en": "Keep it."},
        {"zh": "我更在意这根蜡烛。", "en": "I care more about this candle."},
        {"zh": "别靠近火。", "en": "Do not come near the flame."},
        {"zh": "你挡着光了。", "en": "You are blocking the light."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，火晃了一下。", "en": "You bump me and the flame wavers."},
        {"zh": "我赶紧护住。", "en": "I cup my hand around it."},
        {"zh": "还好没灭。", "en": "It did not go out."},
        {"zh": "我退了半步。", "en": "I give half a step."},
        {"zh": "我们擦过，袖子碰到。", "en": "We brush and our sleeves touch."},
        {"zh": "蜡油溅了出来。", "en": "Wax splashes out."},
        {"zh": "我低头看了看。", "en": "I look down at it."},
        {"zh": "我又站回原位。", "en": "I return to my place."},
        {"zh": "火又稳了。", "en": "The flame steadies."},
        {"zh": "你走路小心些。", "en": "Watch your step."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这里只有我守着。", "en": "Only I keep watch here."},
        {"zh": "我的位置没换过。", "en": "My place has never changed."},
        {"zh": "有人会来换我。", "en": "Someone will come to relieve me."},
        {"zh": "他们还没来。", "en": "They have not come."},
        {"zh": "蜡烛我等了很久。", "en": "I have waited long with this candle."},
        {"zh": "火光一直没灭。", "en": "The flame has never gone out."},
        {"zh": "我抬头看了看楼梯。", "en": "I glance up the stairs."},
        {"zh": "那里也很暗。", "en": "It is dark up there too."},
        {"zh": "我继续站着。", "en": "I keep standing."},
        {"zh": "夜还长。", "en": "The night is still long."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰，护着火。", "en": "I bend, guarding the flame."},
        {"zh": "我把它捡起来。", "en": "I pick it up."},
        {"zh": "另一根蜡烛。", "en": "Another candle."},
        {"zh": "还能点。", "en": "It can still be lit."},
        {"zh": "我把它收进袖囊。", "en": "I tuck it into my sleeve."},
        {"zh": "这个有点湿。", "en": "This is a little damp."},
        {"zh": "我把它插回烛台边上。", "en": "I set it back beside the candlestick."},
        {"zh": "这间屋子需要火。", "en": "This room needs fire."},
        {"zh": "我留着以后用。", "en": "I will keep it for later."},
        {"zh": "你也用得上。", "en": "You could use it too."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头。", "en": "I raise my head."},
        {"zh": "火忽然直了。", "en": "The flame stands straight."},
        {"zh": "我把蜡烛换到另一只手。", "en": "I shift the candle to the other hand."},
        {"zh": "我的袍角被风掀动。", "en": "The wind lifts my hem."},
        {"zh": "我朝你的方向看。", "en": "I look your way."},
        {"zh": "你的影子变长了。", "en": "Your shadow has lengthened."},
        {"zh": "我慢慢往前一步。", "en": "I take one slow step."},
        {"zh": "火照得更远。", "en": "The fire reaches farther."},
        {"zh": "你没有退。", "en": "You did not back away."},
        {"zh": "那就难怪了。", "en": "Then that explains it."},
        {"zh": "我抬手。", "en": "I raise a hand."},
        {"zh": "这一下我会留着火。", "en": "I will keep the flame through this."},
        {"zh": "你听得见蜡在响吗？", "en": "Do you hear the wax crackle?"},
        {"zh": "我开始了。", "en": "I begin."},
        {"zh": "别碰我手里的光。", "en": "Do not touch the light in my hand."},
        {"zh": "它比看上去烫。", "en": "It is hotter than it looks."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你走。", "en": "I follow you."},
        {"zh": "火把影子推到你前面。", "en": "The flame throws your shadow ahead."},
        {"zh": "你在走廊里转。", "en": "You turn through the corridor."},
        {"zh": "我提着烛火跟在你后头。", "en": "I carry my candle along behind you."},
        {"zh": "我的脚步很轻。", "en": "My steps are very light."},
        {"zh": "火光忽然暗了。", "en": "The flame dims suddenly."},
        {"zh": "我又护住了它。", "en": "I cup it again."},
        {"zh": "你回头看。", "en": "You look back."},
        {"zh": "我在很远的地方。", "en": "I am far off."},
        {"zh": "你在找出口。", "en": "You are looking for the exit."},
        {"zh": "这栋房子的门都锁着。", "en": "Every door in this house is locked."},
        {"zh": "我不能让你把火带出去。", "en": "I cannot let you carry the fire out."},
        {"zh": "我又近了一些。", "en": "I am closer now."},
        {"zh": "火苗矮了一点点。", "en": "The flame sinks a little."},
        {"zh": "时间不多了。", "en": "There is little time."},
        {"zh": "我把手抬到胸口。", "en": "I bring my hand to my chest."},
        {"zh": "火光挡住你的眼睛。", "en": "The firelight gets in your eyes."},
        {"zh": "你停下。", "en": "You stop."},
        {"zh": "烛火灭了，就是现在。", "en": "The candle is out — now."},
        {"zh": "我看着你。", "en": "I am looking at you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把蜡油泼在你手上。", "en": "I splash hot wax on your hand."},
        {"zh": "我用烛台敲你。", "en": "I strike with the candlestick."},
        {"zh": "我的袖子扫过你的脸。", "en": "My sleeve sweeps your face."},
        {"zh": "你退了，火还在我手里。", "en": "You back off; the flame is still mine."},
        {"zh": "我抬袖挡住你这一下。", "en": "I raise my sleeve to block your blow."},
        {"zh": "火苗斜向一边。", "en": "The flame leans to one side."},
        {"zh": "我又站稳。", "en": "I steady."},
        {"zh": "这一下没伤到你多少。", "en": "That did little damage."},
        {"zh": "我把蜡烛举高。", "en": "I lift the candle high."},
        {"zh": "我靠近一步。", "en": "I step in."},
        {"zh": "蜡滴在你肩上。", "en": "Wax drips onto your shoulder."},
        {"zh": "我慢慢收手。", "en": "I draw my hand back slowly."},
        {"zh": "火光又稳了。", "en": "The flame steadies again."},
        {"zh": "你还能站着。", "en": "You are still standing."},
        {"zh": "那就再来。", "en": "Then again."},
        {"zh": "我数着蜡的剩量。", "en": "I count what is left of the wax."},
        {"zh": "只剩一点了。", "en": "Only a little remains."},
        {"zh": "最后一次。", "en": "One last time."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "走廊尽头的蜡烛亮了。", "en": "The candle at the end of the corridor lights."},
        {"zh": "我站在那盏灯下面。", "en": "I stand beneath that lamp."},
        {"zh": "火先出现，然后是我。", "en": "The fire comes first, then me."},
        {"zh": "这里一直很暗。", "en": "It has always been dark here."},
        {"zh": "我把蜡烛举到胸前。", "en": "I raise the candle to my chest."},
        {"zh": "火光照出墙上的画。", "en": "The light picks out the paintings."},
        {"zh": "画里的人都低着头。", "en": "The figures in them keep their heads down."},
        {"zh": "我抬起头，火就亮了。", "en": "I lift my head, and the fire kindles."},
        {"zh": "袍子上的蜡还没干。", "en": "The wax on my robe is still wet."},
        {"zh": "我开始往前走。", "en": "I start to walk."},
        {"zh": "每一步火都很稳。", "en": "The flame stays steady with each step."},
        {"zh": "我在这栋房子里很久了。", "en": "I have been in this house a long time."},
        {"zh": "楼梯上没有人。", "en": "There is no one on the stairs."},
        {"zh": "我把蜡烛放在架上。", "en": "I set the candle on the stand."},
        {"zh": "它还得烧很久。", "en": "It has to burn a long while yet."},
        {"zh": "我又把它拿起来。", "en": "I take it up again."},
        {"zh": "风从门缝里进来。", "en": "Wind comes through the door gap."},
        {"zh": "我侧身挡住。", "en": "I turn to block it."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火遇到火，我的烛苗一下蹿高。", "en": "Fire meets fire and my flame leaps up."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从楼梯上滚下来，蜡烛还举着。", "en": "I tumble down the stairs, still holding the candle."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浇下来，我死死护住火苗。", "en": "Water pours down and I shield the flame with both hands."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸掀翻了走廊，我扑在地上护火。", "en": "The blast wrecks the corridor and I throw myself over the flame."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿了我的袖子，火还在。", "en": "An arrow pierces my sleeve; the fire still burns."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光压过来，我的烛苗缩成一粒。", "en": "Spell-light presses in and my flame shrinks to a bead."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直没吃东西，火还得烧。", "en": "I have not eaten, and the fire must still burn."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光比我的亮，我一瞬间看不见。", "en": "The lightning is brighter than mine and I am blind for a moment."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里点不着火。", "en": "No fire will catch in the void."}
      ]
    }
  }
}
