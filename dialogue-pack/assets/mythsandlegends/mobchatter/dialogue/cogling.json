{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咔嚓咔嚓，齿轮转动不停！", "en": "Click click, gears never stop!"},
        {"zh": "吱吱嘎嘎，我就是命运！", "en": "Creak creak, I'm fate itself!"},
        {"zh": "咔嗒咔嗒，追随齿轮之路。", "en": "Clack clack, follow the gear path."},
        {"zh": "吱呀吱呀，时间不等人。", "en": "Creak creak, time waits for no one."},
        {"zh": "咔哒咔哒，齿轮的低语。", "en": "Clack clack, gear’s whisper."},
        {"zh": "嘎吱嘎吱，我来自机械之梦。", "en": "Creak creak, from the mechanical dream."},
        {"zh": "咔嚓咔嚓，命运的齿轮转动。", "en": "Click click, fate’s gear turns."},
        {"zh": "吱吱嘎嘎，我的命运如此。", "en": "Creak creak, such is my fate."},
        {"zh": "咔哒咔哒，齿轮间的秘密。", "en": "Clack clack, secrets between gears."},
        {"zh": "嘎吱嘎吱，机械的低吟。", "en": "Creak creak, machine’s sigh."},
        {"zh": "一步一格，齿距量过。", "en": "One step per notch, measured by teeth."},
        {"zh": "铜轴转动，带着我走。", "en": "The brass axle turns and carries me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "齿轮间沉睡，梦无止境。", "en": "Gears sleep, dreams endless."},
        {"zh": "嘎吱嘎吱，机械的沉思。", "en": "Creak creak, mechanical thought."},
        {"zh": "咔哒咔哒，时光静止。", "en": "Clack clack, time stands still."},
        {"zh": "吱吱嘎嘎，命运的等待。", "en": "Creak creak, fate’s wait."},
        {"zh": "咔嚓咔嚓，静谧的齿轮。", "en": "Click click, silent gears."},
        {"zh": "吱呀吱呀，机械的叹息。", "en": "Creak creak, machine’s sighs."},
        {"zh": "咔哒咔哒，齿轮间的梦境。", "en": "Clack clack, gear’s dreams."},
        {"zh": "嘎吱嘎吱，沉睡的齿轮。", "en": "Creak creak, sleeping gears."},
        {"zh": "咔嚓咔嚓，机械的沉思录。", "en": "Click click, mechanical musings."},
        {"zh": "吱吱嘎嘎，齿轮间的低语。", "en": "Creak creak, gears whisper."},
        {"zh": "发条松了，我歇一会儿。", "en": "My spring wound down. I'll rest."},
        {"zh": "数着自己的齿，一颗不少。", "en": "Counting my teeth, not one missing."},
        {"zh": "锈斑爬上关节，痒。", "en": "Rust crawls up my joints and itches."},
        {"zh": "上弦的声，比心跳准。", "en": "The winding sound is steadier than a heartbeat."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "咔嚓咔嚓，你是我的猎物。", "en": "Click click, you’re my prey."},
        {"zh": "吱吱嘎嘎，注意那闪烁之光。", "en": "Creak creak, notice the flicker."},
        {"zh": "咔哒咔哒，准备被吞噬。", "en": "Clack clack, ready to be devoured."},
        {"zh": "嘎吱嘎吱，你无法逃脱。", "en": "Creak creak, you can’t escape."},
        {"zh": "咔嚓咔嚓，我的猎物来了。", "en": "Click click, my prey arrives."},
        {"zh": "吱呀吱呀，你即将成为齿轮。", "en": "Creak creak, you’ll be a gear."},
        {"zh": "咔哒咔哒，你逃不掉的。", "en": "Clack clack, you can’t escape."},
        {"zh": "嘎吱嘎吱，猎物的味道。", "en": "Creak creak, prey’s scent."},
        {"zh": "咔嚓咔嚓，猎物在颤抖。", "en": "Click click, prey trembles."},
        {"zh": "吱吱嘎嘎，你的末日到了。", "en": "Creak creak, your doom comes."},
        {"zh": "你的骨头，有几颗齿？", "en": "How many teeth are in your bones?"},
        {"zh": "我在量你的步幅。", "en": "I am measuring your stride."},
        {"zh": "眼睛是铜的，不会眨。", "en": "My eyes are brass. They never blink."},
        {"zh": "你身上有上油的味儿。", "en": "You smell of fresh oil."},
        {"zh": "别碰我的发条轴。", "en": "Don't touch my mainspring axle."},
        {"zh": "你的影子卡进齿轮了。", "en": "Your shadow is caught in my gears."},
        {"zh": "我把你记进齿轮的账本。", "en": "I've entered you in the gear ledger."},
        {"zh": "你一停下，我就开始转。", "en": "When you stop, my wheels start."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "呜呜，我的齿轮！", "en": "Rattle, my gears!"},
        {"zh": "这声音好可怕！", "en": "That noise is terrifying!"},
        {"zh": "嘎吱嘎吱，好疼！", "en": "Creak, creak, it hurts!"},
        {"zh": "零件坏了，好疼！", "en": "Part broken, hurts!"},
        {"zh": "齿轮断了，疼！", "en": "Gear broken, pain!"},
        {"zh": "金属碎片扎进来了！", "en": "Metal splinters in!"},
        {"zh": "零件生锈了，好疼！", "en": "Rusty part, hurts!"},
        {"zh": "金属碎裂，疼！", "en": "Metal shatters, pain!"},
        {"zh": "零件松动了，好疼！", "en": "Loose parts, hurts!"},
        {"zh": "金属扭曲了，好疼！", "en": "Distorted metal, pain!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶，这里的食物很香。", "en": "Sssss, the food here smells good."},
        {"zh": "请给我点吃的吧。", "en": "Please give me some food."},
        {"zh": "我不喜欢吃活的东西。", "en": "I don't like eating live things."},
        {"zh": "请帮我，我好饿。", "en": "Help me, I'm starving."},
        {"zh": "那边的肉看起来不错。", "en": "The meat over there looks good."},
        {"zh": "求你了，给我点吃的。", "en": "Please, give me some food."},
        {"zh": "我的发条在响，不是肚子。", "en": "It's my spring that clicks, not my belly."},
        {"zh": "铜屑和机油，我能吃。", "en": "Copper filings and oil, I can eat."},
        {"zh": "请不要伤害我。", "en": "Don't hurt me."},
        {"zh": "这里有吃的吗？", "en": "Is there anything to eat here?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "咔一声，我的齿轮咬住了。", "en": "A click, and my gears catch."},
        {"zh": "躲开我。", "en": "Stay away from me."},
        {"zh": "让我撞上你。", "en": "Let me撞上you."},
        {"zh": "齿轮卡进你的衣角了。", "en": "A gear has caught in your hem."},
        {"zh": "我不想伤害你。", "en": "I don't want to hurt you."},
        {"zh": "让开，我的齿轮要转。", "en": "Move; my gears need to turn."},
        {"zh": "我的齿轮咬住了，停不下来。", "en": "My gears have caught and will not stop."},
        {"zh": "齿轮咬合，我一寸寸靠近。", "en": "Gears mesh — I close in inch by inch."},
        {"zh": "我的齿轮转得太快，会绞人。", "en": "My gears spin too fast — they'll catch you."},
        {"zh": "我找不到出路。", "en": "I can't find a way out."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "齿轮咬合声是我的心跳。", "en": "Gear clicks are my heartbeat."},
        {"zh": "两只齿轮，正好咬合。", "en": "Two gears that mesh just right."},
        {"zh": "同频的滴答声在那边。", "en": "A matching tick sounds over there."},
        {"zh": "我照着你的样子打磨自己。", "en": "I grind myself to match your shape."},
        {"zh": "齿轮咬合，我在等一个同伴。", "en": "My gears mesh; I'm waiting for a partner."},
        {"zh": "谁在替我上另一根弦？", "en": "Who winds my other spring?"},
        {"zh": "我想要一个朋友。", "en": "I want a friend."},
        {"zh": "让我们一起生活。", "en": "Let's live together."},
        {"zh": "我拧紧最后一枚发条。", "en": "I wind my last spring tight."},
        {"zh": "找到我吧，亲爱的。", "en": "Find me, dear."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "咔哒作响的齿轮声响起。", "en": "The gears click."},
        {"zh": "齿轮吱吱旋转。", "en": "The gears rotate."},
        {"zh": "齿轮灵接近你。", "en": "Cogling approaches."},
        {"zh": "它啃咬着齿轮。", "en": "It gnaws on a gear."},
        {"zh": "它的触手收紧。", "en": "Its tentacles tighten."},
        {"zh": "齿轮发出尖锐的咔嚓声。", "en": "The gears screech."},
        {"zh": "你感受到它的逼近。", "en": "You feel its approach."},
        {"zh": "齿轮灵吞噬了你的食物。", "en": "Cogling devours your food."},
        {"zh": "它的触手缠绕住了你。", "en": "Its tentacles ensnare you."},
        {"zh": "齿轮发出诡异的声响。", "en": "The gears make a strange sound."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你被它锁定。", "en": "You are targeted."},
        {"zh": "它开始追踪你。", "en": "It tracks you."},
        {"zh": "我的镜片锁住你了。", "en": "My lens has locked onto you."},
        {"zh": "齿轮灵在你周围搜寻。", "en": "Cogling searches you."},
        {"zh": "它准备攻击。", "en": "It prepares to attack."},
        {"zh": "它的触手在空气中移动。", "en": "Its tentacles move in the air."},
        {"zh": "齿轮开始计算路径。", "en": "The gears compute a path."},
        {"zh": "它发现了你的弱点。", "en": "It finds your weakness."},
        {"zh": "它的触手伸向你。", "en": "Its tentacles reach for you."},
        {"zh": "它开始计算战术。", "en": "It calculates tactics."},
        {"zh": "咬合了，你跑不掉。", "en": "We've meshed. You can't run."},
        {"zh": "齿距对上你的脚步。", "en": "These teeth match your steps."},
        {"zh": "发条已上满，开始追。", "en": "Fully wound. The chase begins."},
        {"zh": "你是我今天的第一个零件。", "en": "You're my first part today."},
        {"zh": "我把你算进传动链了。", "en": "I've counted you in the drive chain."},
        {"zh": "咔一声，锁定你了。", "en": "One click, and you are locked."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它将你纳入视线。", "en": "It takes you into its sight."},
        {"zh": "它的齿轮瞄准了你。", "en": "Its gears aim at you."},
        {"zh": "它开始围绕你移动。", "en": "It begins to move around you."},
        {"zh": "齿轮咬住你了。", "en": "My gears have clamped onto you."},
        {"zh": "它试图靠近你。", "en": "It tries to get closer."},
        {"zh": "它的齿轮咔哒作响。", "en": "Its gears click."},
        {"zh": "齿轮咬合，开始转动。", "en": "Gears mesh. I start turning."},
        {"zh": "它对准了你的位置。", "en": "It aligns with your position."},
        {"zh": "它的触手缠绕得更紧。", "en": "Its tentacles grip tighter."},
        {"zh": "它的齿轮准备旋转。", "en": "Its gears prepare to rotate."},
        {"zh": "牙盘转到你的方向。", "en": "The cogwheel turns your way."},
        {"zh": "再近一步，就咬住。", "en": "One step closer and I bite."},
        {"zh": "我的转速在升。", "en": "My spin is speeding up."},
        {"zh": "你不用退，退也没用。", "en": "No need to back off. It won't help."},
        {"zh": "轴心对准了你。", "en": "My axle points at you."},
        {"zh": "齿轮咬合前，最安静。", "en": "Gears are quietest before they mesh."},
        {"zh": "你在我的刻度之间。", "en": "You are between my markings."},
        {"zh": "铜屑落了一地，我还在转。", "en": "Brass dust falls, yet I keep turning."},
        {"zh": "这一格，正好是你。", "en": "This notch fits you exactly."},
        {"zh": "上弦到底了，别怪我。", "en": "Wound to the end. Don't blame me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "齿轮转，恐惧现！", "en": "Gears spin, fear emerge."},
        {"zh": "你的肉，我的燃料！", "en": "Your flesh, my fuel."},
        {"zh": "咔嗒咔嗒，吞噬灵魂！", "en": "Click-click, devour souls."},
        {"zh": "咬紧牙，啃你骨！", "en": "Clamp down, gnaw on your bone."},
        {"zh": "齿轮中找到你的位置！", "en": "Gear up for your position."},
        {"zh": "咔嚓咔嚓，活人到！", "en": "Click-click, live one here."},
        {"zh": "你就是我的下一个齿轮！", "en": "You're my next gear."},
        {"zh": "咔嚓咔嚓，你没地方躲！", "en": "Click-click, nowhere to hide."},
        {"zh": "我的齿轮，你的终结！", "en": "My gears, your end."},
        {"zh": "齿牙啃进你的护甲！", "en": "My teeth grind into your armor!"},
        {"zh": "这一下，是拧紧的！", "en": "This blow came torqued tight!"},
        {"zh": "铜边刮过，听见了吗？", "en": "That brass edge scraped you. Hear it?"},
        {"zh": "碎屑落进你的伤口。", "en": "Filing dust falls into your wound."},
        {"zh": "我的撞击有节拍。", "en": "My strikes keep a beat."},
        {"zh": "你被卷进传动里了！", "en": "You're caught in the transmission!"},
        {"zh": "咔，你的骨头在响！", "en": "Click. That's your bone cracking!"},
        {"zh": "一根轴换你一条命。", "en": "One axle for one life."},
        {"zh": "咬合完毕，收割开始。", "en": "Meshing complete. Harvest begins."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "来了，齿轮灵！", "en": "Here comes the Cogling."},
        {"zh": "我从零件堆里自己站了起来。", "en": "I stand up on my own from the pile of parts."},
        {"zh": "齿轮下，你是我的！", "en": "Under gears, yours truly."},
        {"zh": "墙角的零件自己拼了起来。", "en": "The parts in the corner assemble themselves."},
        {"zh": "齿轮转起来，我就醒了。", "en": "The gears start turning and I wake."},
        {"zh": "齿轮间的低语！", "en": "Whisper of gears."},
        {"zh": "寂静中，我降临！", "en": "Silence, and I come."},
        {"zh": "等待你的时刻！", "en": "Waiting for you."},
        {"zh": "黑暗中，我的领域！", "en": "Darkness, my domain."},
        {"zh": "夜幕下，我苏醒！", "en": "I awake under the night."},
        {"zh": "上满弦，我就来了。", "en": "Fully wound, and here I am."},
        {"zh": "从废铁堆里，我站起。", "en": "I rise from the scrap heap."},
        {"zh": "谁拧动了我的发条？", "en": "Who turned my mainspring?"},
        {"zh": "齿轮开始咬合了。", "en": "The gears begin to mesh."},
        {"zh": "锈迹里睁开了眼睛。", "en": "An eye opens in the rust."},
        {"zh": "我数着秒，现身了。", "en": "I counted the seconds, then appeared."},
        {"zh": "钟摆一停，我就在。", "en": "The pendulum stops, and I am here."},
        {"zh": "这地方的铁，认得我。", "en": "The iron here knows me."}
      ]
    },
