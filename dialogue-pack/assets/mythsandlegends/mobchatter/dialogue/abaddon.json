    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰熔铸，渴望灵魂。", "en": "Forged in flames, craving souls."},
        {"zh": "岩浆中行走，诱惑无处不在。", "en": "Walks on lava, temptation abounds."},
        {"zh": "炙热之躯，令人难以抗拒。", "en": "Burning form, impossible to resist."},
        {"zh": "炽热目光，窥视灵魂深处。", "en": "Burning gaze, peering into souls."},
        {"zh": "岩浆为床，火焰为伴。", "en": "Lava for bed, flames for company."},
        {"zh": "熔炉之心，吞噬一切。", "en": "Forge heart, consuming all."},
        {"zh": "岩浆中舞蹈，火焰中歌唱。", "en": "Dances in lava, sings in flames."},
        {"zh": "火焰铸就，灵魂吞噬。", "en": "Forged in flames, soul devourer."},
        {"zh": "燃烧之灵，徘徊于世。", "en": "Burning spirit, roams the world."},
        {"zh": "岩浆之上，我为王。", "en": "On lava, I reign."}
      ]
    },
    "collide": {
