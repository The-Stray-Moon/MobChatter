    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "炽热之心在召唤你。", "en": "Heated heart calls to you."},
        {"zh": "感受我燃烧的意志。", "en": "Feel my burning will."},
        {"zh": "吞下这熔化的灵魂。", "en": "Swallow this molten soul."},
