        {"zh": "熔铸身躯，静静等待。", "en": "Forged form, quietly waiting."},
        {"zh": "熔化的铁块，静静地。", "en": "Molten iron, quietly."},
        {"zh": "岩浆中驻足，静默中等待。", "en": "Pauses in lava, waiting in silence."},
        {"zh": "在岩浆上静止，等待猎物。", "en": "Pauses on lava, waiting for prey."},
        {"zh": "静默中，熔铸之躯等待。", "en": "In silence, forged form waits."},
        {"zh": "熔炉旁，静静等候。", "en": "By the furnace, quietly waits."},
        {"zh": "岩浆中驻足，静默无言。", "en": "Pauses in lava, silent."}
      ]
