  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "炽热脚步声，踏破岩浆平原。", "en": "Footsteps crackle, burning through lava fields."},
        {"zh": "灼热身躯移动，仿佛熔化的铁。", "en": "Body glows, moving like molten iron."},
        {"zh": "岩浆中行走如履平地。", "en": "Walks on lava as if it were solid ground."},
        {"zh": "熔铸身躯迈步前行。", "en": "Forged form strides forward."},
        {"zh": "从岩浆中走出，留下痕迹。", "en": "Steps out of lava, leaving marks."},
        {"zh": "熔岩中行走，火焰无声。", "en": "Walks in lava, flames silent."},
        {"zh": "燃烧的躯壳在行走。", "en": "Burning shell walks."},
        {"zh": "熔化的金属在跳跃。", "en": "Molten metal leaps."},
        {"zh": "炽热步伐划破岩浆。", "en": "Hot footsteps cut through lava."},
        {"zh": "从岩浆中走过，留下痕迹。", "en": "Walks through lava, leaving marks."},
        {"zh": "火焰踩着火焰，我在下界行走。", "en": "Flame steps on flame as I walk the Nether."},
        {"zh": "岩浆顺着我的肩流下去。", "en": "Lava runs down my shoulder."}
      ]
    },
