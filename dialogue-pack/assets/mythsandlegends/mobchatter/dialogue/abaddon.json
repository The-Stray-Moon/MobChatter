    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "燃烧暴君现身。", "en": "Abaddon appears."},
        {"zh": "绯红森林的火，全都归我。", "en": "All crimson forest fire is mine."},
        {"zh": "火焰铸就的意志。", "en": "Flame-forged will."},
        {"zh": "岩浆之上的舞者。", "en": "Dancer on lava."},
        {"zh": "燃烧的灵魂，燃烧的心。", "en": "Burning soul, burning heart."},
