    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "灯笼暗了，我受伤了。", "en": "My lantern dims. I'm hurt."},
        {"zh": "森林的影子笼罩我。", "en": "The forest's shadow falls on me."},
        {"zh": "我被荆棘缠住了。", "en": "I'm entangled by thorns."},
        {"zh": "树叶遮住了阳光。", "en": "Leaves block the sunlight."},
        {"zh": "我被树枝绊倒了。", "en": "I tripped over a branch."},
        {"zh": "一只飞虫撞进灯罩，烧焦了。", "en": "A moth flew into my lantern and burned."},
        {"zh": "露水沾湿了我。", "en": "Dew wets me."},
        {"zh": "我的灯笼熄灭了。", "en": "My lantern goes out."},
        {"zh": "树叶遮住了我的路。", "en": "Leaves block my way."},
        {"zh": "风摇晃了我的灯笼。", "en": "The wind shakes my lantern."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "被你这么一照，我更饿了！", "en": "You shine so bright, I get hungrier!"},
        {"zh": "森林的美食，等你来品尝！", "en": "Forest delicacies, waiting for you."},
        {"zh": "跟着我，你会找到更多食物！", "en": "Follow me, you'll find more food."},
        {"zh": "这里的食物很美味哦！", "en": "The food here is delicious!"},
        {"zh": "这光亮可以引路，也能引食！", "en": "The light guides and attracts."},
        {"zh": "你带我找食物，我帮你发光！", "en": "I’ll light your way for food."},
        {"zh": "黑暗中，唯有我们共享美食！", "en": "In the dark, only we share food."},
        {"zh": "跟我来，森林深处有更多食物！", "en": "Follow me, deeper in the forest."},
        {"zh": "这里的食物比你想象的更多！", "en": "There’s more food than you can imagine."},
        {"zh": "你这么一照，我更想吃东西！", "en": "You make me hungrier."},
        {"zh": "跟我来，我的灯不会灭。", "en": "Come with me. My lantern will not go out."},
        {"zh": "以太之焰能暖你一整夜。", "en": "Aether flame can warm you all night."},
        {"zh": "你敢踩岩浆吗？我敢。", "en": "Dare you walk on lava? I do."},
        {"zh": "这盏灯照到的地方，都是我的。", "en": "Wherever this lantern shines is mine."},
        {"zh": "别离灯太远，林子里有东西。", "en": "Do not stray from the light. Something is in these woods."},
        {"zh": "你身上没有灯油的气味。", "en": "You do not smell of lantern oil."}
      ]
    },
