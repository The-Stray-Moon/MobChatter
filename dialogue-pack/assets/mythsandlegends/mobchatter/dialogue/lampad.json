{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "提灯前行，森林之灵。", "en": "Wandering with lamp, forest spirit."},
        {"zh": "林间跳跃，光之使者。", "en": "Jumping in forest, light bearer."},
        {"zh": "脚步轻盈，灯笼微明。", "en": "Soft steps, lamp flickers."},
        {"zh": "月光下行走，幽影流窜。", "en": "Walking under moon, shadows flow."},
        {"zh": "提灯觅食，森林精灵。", "en": "Holding lamp, forest sprite."},
        {"zh": "行于林间，光舞轻盈。", "en": "Walking through forest, light dances."},
        {"zh": "森林深处，提灯前行。", "en": "Deep in forest, lamp forward."},
        {"zh": "夜幕下，森林的光。", "en": "Night, forest’s light."},
        {"zh": "提灯行走，森林精怪。", "en": "Walking with lamp, forest wraith."},
        {"zh": "月光下的森林幽灵。", "en": "Forest ghost in moonlight."},
        {"zh": "我踩着岩浆走，鞋不烫。", "en": "I walk on lava and my shoes stay cool."},
        {"zh": "灯笼一晃，影子跟着跳。", "en": "My lantern sways, and my shadow hops along."},
        {"zh": "火光照出诡异森林的路。", "en": "My firelight shows the way through the dark forest."},
        {"zh": "我从树根上轻轻跳过去。", "en": "I hop lightly over the roots."},
        {"zh": "我绕过一片烧焦的草。", "en": "I skirt a patch of scorched grass."},
        {"zh": "灯芯噼啪，我哼着调子。", "en": "My wick crackles, and I hum a tune."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静立林间，灯笼微明。", "en": "Standing still, lamp flickers."},
        {"zh": "提灯而立，守护森林。", "en": "Standing with lamp, guarding forest."},
        {"zh": "林间休息，提灯静候。", "en": "Resting in forest, waiting with lamp."},
        {"zh": "夜色中，静静守望。", "en": "Night, quietly watching."},
        {"zh": "提灯而息，静待黎明。", "en": "Lamp lit, waiting for dawn."},
        {"zh": "林中静息，提灯相伴。", "en": "Resting in forest, lamp by side."},
        {"zh": "森林深处，灯影微动。", "en": "Deep in forest, light flickers."},
        {"zh": "静立林间，提灯守候。", "en": "Standing still, lamp waiting."},
        {"zh": "提灯而立，静待夜深。", "en": "Standing with lamp, waiting for night."},
        {"zh": "林间独息，提灯相伴。", "en": "Alone in forest, lamp by side."},
        {"zh": "我把灯笼挂在树枝上。", "en": "I hang my lantern on a branch."},
        {"zh": "我在岩浆边烤手。", "en": "I warm my hands by the lava."},
        {"zh": "火光在诡异森林里不算亮。", "en": "In this dark forest my light is not much."},
        {"zh": "我数着灯芯烧了几寸。", "en": "I count how far my wick has burned."},
        {"zh": "林子里只有我的灯还亮着。", "en": "Mine is the only light left in the wood."},
        {"zh": "我把灯笼放在膝上打盹。", "en": "I doze with my lantern on my knees."}
      ]
    },
