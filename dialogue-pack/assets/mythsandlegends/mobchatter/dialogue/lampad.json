      "operation": "replace",
      "lines": [
        {"zh": "灯笼晃了，火苗差点灭。", "en": "My lantern swings and the flame nearly dies."},
        {"zh": "灯油洒出一点，别踩。", "en": "A little lamp oil spilled. Watch your step."},
        {"zh": "哎呀，你撞到我了，真疼！", "en": "Ouch, you bumped into me."},
        {"zh": "别乱撞，小心我的灯笼！", "en": "Watch out, don’t bump into my lantern."},
        {"zh": "你撞到我了，我的灯笼会灭！", "en": "You bumped into me, my lantern will go out."},
        {"zh": "快停下，你撞到我了！", "en": "Stop, you bumped into me!"},
        {"zh": "别撞到我，我的灯笼很重要！", "en": "Don’t bump into me, my lantern is important."},
        {"zh": "你撞到我了，我的灯笼快灭了！", "en": "You bumped into me, my lantern is almost out."},
        {"zh": "小心点，别撞到我的灯笼！", "en": "Be careful, don’t bump into my lantern."},
        {"zh": "你把我的灯芯撞歪了。", "en": "You knocked my wick crooked."}
      ]
