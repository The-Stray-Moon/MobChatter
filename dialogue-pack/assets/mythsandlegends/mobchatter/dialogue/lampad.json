    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "灯笼光在诡异森林里晃。", "en": "My lantern sways through the warped forest."},
        {"zh": "灯笼里的火，分你一半。", "en": "Half the fire in my lantern is yours."},
