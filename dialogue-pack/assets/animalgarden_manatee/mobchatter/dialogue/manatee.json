{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢摆尾游着。", "en": "I swim with slow sweeps of my tail."},
        {"zh": "水草从我背上滑过。", "en": "Water weeds slide over my back."},
        {"zh": "我贴着河底往前。", "en": "I drift along the riverbed."},
        {"zh": "河道很浅，我走中间。", "en": "The river is shallow; I keep to the middle."},
        {"zh": "我的鳍划得很慢。", "en": "My flippers move slowly."},
        {"zh": "岸边有草，我过去看看。", "en": "Grass on the bank; let me look."},
        {"zh": "我转个身要费点劲。", "en": "Turning costs me some effort."},
        {"zh": "水面上的光跟着我。", "en": "The light on the surface follows me."},
        {"zh": "我绕开河里的石头。", "en": "I round the stones in the river."},
        {"zh": "我沿着沙岸前进。", "en": "I travel along the sandy bank."},
        {"zh": "水流带着我慢慢走。", "en": "The current carries me gently."},
        {"zh": "我身子一沉，靠近河底。", "en": "I sink closer to the bottom."},
        {"zh": "这片水域我熟。", "en": "I know these waters."},
        {"zh": "我慢慢靠近浅滩。", "en": "I ease toward the shallows."},
        {"zh": "身后有一圈水纹。", "en": "A ring of ripples trails behind me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在河心不动。", "en": "I hang in the water."},
        {"zh": "背上长了点绿藻。", "en": "Some green algae grew on my back."},
        {"zh": "我慢慢嚼着水草。", "en": "I chew the water weeds slowly."},
        {"zh": "我低着头啃河底的草。", "en": "I'm doing nothing."},
        {"zh": "有鱼从我旁边游过。", "en": "A fish swims past me."},
        {"zh": "我的鼻子露出水面。", "en": "My nose breaks the surface."},
        {"zh": "水面上很平静。", "en": "The surface is calm."},
        {"zh": "我背上好像挂着什么。", "en": "Something seems caught on my back."},
        {"zh": "阳光照到河底。", "en": "Sun reaches the riverbed."},
        {"zh": "我把身子靠稳。", "en": "I settle myself."},
        {"zh": "泥里有一串泡。", "en": "A string of bubbles in the mud."},
        {"zh": "我打了一个大哈欠。", "en": "I give a big yawn."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在岸上看着我。", "en": "You're watching me from the bank."},
        {"zh": "你手里的东西绿绿的。", "en": "That green thing in your hand."},
        {"zh": "我慢慢游近一点。", "en": "I drift a little closer."},
        {"zh": "你身后的河岸很陡。", "en": "The bank behind you is steep."},
        {"zh": "我一点也不怕人。", "en": "I'm not afraid of people."},
        {"zh": "你手上是海绵吗？", "en": "Is that a sponge in your hand?"},
        {"zh": "我背上有些东西。", "en": "There's something on my back."},
        {"zh": "你站那么高做什么？", "en": "Why stand up so high?"},
        {"zh": "我抬起头顶看你。", "en": "I lift my head to look at you."},
        {"zh": "河水里很少有客人。", "en": "Rarely guests in this river."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我疼得缩了一下。", "en": "I flinch and draw in."},
        {"zh": "水里散开了血。", "en": "Blood is in the water."},
        {"zh": "我往水底坠了一点。", "en": "I drop a little toward the bottom."},
        {"zh": "这一下打得很重。", "en": "That was a heavy blow."},
        {"zh": "我这身皮实在太软。", "en": "My hide is too soft."},
        {"zh": "我游不太动了。", "en": "I can't swim properly."},
        {"zh": "别再补第二下了。", "en": "Not another one."},
        {"zh": "让我缓一缓气。", "en": "Let me recover a moment."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是一束海草吗？", "en": "Is that seagrass?"},
        {"zh": "我闻到海带的味。", "en": "I smell kelp."},
        {"zh": "你举着的是给我吃的？", "en": "Is that for me?"},
        {"zh": "我慢慢游过来。", "en": "I'll swim over slowly."},
        {"zh": "这个东西我吃。", "en": "I eat this."},
        {"zh": "你拿稳，别抖手。", "en": "Hold it steady."},
        {"zh": "这点海草不够一顿。", "en": "Not enough for me to chew."},
        {"zh": "放下我就能吃到。", "en": "Set it down and I can reach it."},
        {"zh": "你在哪儿找的？", "en": "Where did you find that?"},
        {"zh": "我挺喜欢这个。", "en": "I like this."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我的鼻子了。", "en": "You touched my nose."},
        {"zh": "你把我撞得打了个旋，水花四散。", "en": "You spin me around and the water splashes wide."},
        {"zh": "我身上太重，躲不开。", "en": "I'm too heavy to dodge."},
        {"zh": "我笨拙地挪开了身子。", "en": "I slowly give way."},
        {"zh": "你的船碰到我的背了。", "en": "Your boat touched my back."},
        {"zh": "我抬起头看你。", "en": "I lift my head to look."},
        {"zh": "别贴着我的身子游。", "en": "Don't swim against me."},
        {"zh": "我一沉，你就撞不上。", "en": "If I sink, you can't hit me."},
        {"zh": "好了，一点事没有。", "en": "Alright, no harm done."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "河里的季节还早。", "en": "The season's early in this river."},
        {"zh": "我游得非常慢。", "en": "I swim very slowly."},
        {"zh": "我在找东西吃。", "en": "I'm looking for food."},
        {"zh": "这片水域够安静。", "en": "These waters are quiet enough."},
        {"zh": "你游得比我快。", "en": "You swim faster than I do."},
        {"zh": "我背上还有藻。", "en": "I still have algae on my back."},
        {"zh": "等水再暖一点。", "en": "When the water's warmer."},
        {"zh": "我转个身都费劲。", "en": "Even turning is hard for me."},
        {"zh": "慢慢来就很好。", "en": "Slow is fine."},
        {"zh": "你千万别着急。", "en": "Don't rush."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "河底怎么有这东西？", "en": "What's this?"},
        {"zh": "我用鳍拨了拨。", "en": "I nudge it with my flipper."},
        {"zh": "它卡在我的背上了。", "en": "It's caught on my back."},
        {"zh": "这个我可不吃。", "en": "I don't eat this."},
        {"zh": "我把它顶到岸边。", "en": "I push it toward the bank."},
        {"zh": "水底的亮东西。", "en": "Something shiny on the bottom."},
        {"zh": "我推着它往前。", "en": "I push it along."},
        {"zh": "摸上去有点硌人。", "en": "It's a bit scratchy."},
        {"zh": "谁把它丢进河里的？", "en": "Who dropped this in?"},
        {"zh": "我懒得管它了。", "en": "I'll leave it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头来看。", "en": "I raise my head."},
        {"zh": "我缓缓沉向河底。", "en": "I sink slowly."},
        {"zh": "这东西不太对。", "en": "This doesn't feel right."},
        {"zh": "我挡在河中间。", "en": "I sit in the middle of the river."},
        {"zh": "我这一身也够大。", "en": "This body is sizeable."},
        {"zh": "它还没有动过。", "en": "It hasn't moved."},
        {"zh": "我先浮着看它一会。", "en": "I'll watch first."},
        {"zh": "它就在你那边。", "en": "Over there."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢靠近它。", "en": "I approach slowly."},
        {"zh": "我不想撞上去。", "en": "I'd rather not collide."},
        {"zh": "我沉到它下面。", "en": "I drop beneath it."},
        {"zh": "水草会挡住我。", "en": "The weeds will screen me."},
        {"zh": "它比我还慢呢。", "en": "It's slower than I am."},
        {"zh": "我就这么看着。", "en": "I'll just watch."},
        {"zh": "河底下很安静。", "en": "The riverbed is quiet."},
        {"zh": "你手里的海草，再递过来一点。", "en": "That seagrass in your hand, hold it a little closer."},
        {"zh": "我摆好鳍等着了。", "en": "I'm ready."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用身子撞过去。", "en": "I push with my bulk."},
        {"zh": "我的尾巴扫了一下。", "en": "My tail swept once."},
        {"zh": "我这一撞软绵绵的。", "en": "That was gentle."},
        {"zh": "我其实不会打。", "en": "I don't really fight."},
        {"zh": "它被我推开了。", "en": "It got pushed aside."},
        {"zh": "我撞得自己转圈。", "en": "I spun myself around."},
        {"zh": "我退开到一边。", "en": "I back away."},
        {"zh": "我能挡一会儿。", "en": "I can block a while."},
        {"zh": "你还是快点走。", "en": "Just go."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从河里浮上来。", "en": "I rise from the river."},
        {"zh": "河水暖得正合适。", "en": "The water is warm."},
        {"zh": "岸边长着些草。", "en": "There's grass on the bank."},
        {"zh": "我先换一口气。", "en": "Let me take a breath first."},
        {"zh": "背上的藻还湿着。", "en": "The algae on my back is wet."},
        {"zh": "我慢慢沉回去。", "en": "I sink back down."},
        {"zh": "这里的水流不急。", "en": "The current isn't fast here."},
        {"zh": "旁边有几条鱼。", "en": "Fish nearby."},
        {"zh": "我摆了一下鳍。", "en": "I fan a flipper."},
        {"zh": "找点海草来吃。", "en": "Time to find seagrass."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面烫得像开了锅。", "en": "The water burns like a boiling pot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我被扔出水面，摔回河里。", "en": "I was thrown out and crashed back in."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "河水浑得我透不过气。", "en": "The water is foul; I can't breathe."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭插进背上的海藻里，很疼。", "en": "An arrow lodges in the kelp on my back; it stings."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我浑身一紧。", "en": "That force made me clench all over."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我没力气浮起来。", "en": "Too hungry to stay afloat."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "河底忽然没有了。", "en": "The riverbed is suddenly gone."}
      ]
    }
  }
}
