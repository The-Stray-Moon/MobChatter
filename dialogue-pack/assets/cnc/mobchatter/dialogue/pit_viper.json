{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有腿，靠身子往前推。", "en": "No legs; I push forward with my body."},
        {"zh": "我在落叶上滑，一点声音没有。", "en": "I slide over leaves without a sound."},
        {"zh": "湿泥是我最喜欢的地面。", "en": "Wet mud is my ground of choice."},
        {"zh": "我绕过树根，走得很慢。", "en": "I thread around roots, slowly."},
        {"zh": "草叶划过我的鳞。", "en": "Grass drags across my scales."},
        {"zh": "我顺着水汽的方向走。", "en": "I follow the smell of moisture."},
        {"zh": "我爬过一块湿石头。", "en": "I cross a wet stone."},
        {"zh": "我的身体在落叶底下。", "en": "My body runs under the leaves."},
        {"zh": "我贴着地面听震动。", "en": "I press to the ground and feel for tremors."},
        {"zh": "我不着急，等得起。", "en": "I am in no hurry. I can wait."},
        {"zh": "我的轨迹是弯的。", "en": "My trail curves."},
        {"zh": "我从石头缝里穿过去。", "en": "I pass through a gap in the stones."},
        {"zh": "我慢慢地盘过去。", "en": "I coil my way along."},
        {"zh": "我停下来，舌头吐了一下。", "en": "I stop and flick my tongue."},
        {"zh": "我朝更暗的地方走。", "en": "I head for darker ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘在树根下面。", "en": "I coil beneath the roots."},
        {"zh": "我的花纹和落叶一样。", "en": "My pattern matches the leaf litter."},
        {"zh": "舌头在尝空气。", "en": "My tongue tests the air."},
        {"zh": "我在等一个小小的热源。", "en": "I wait for a small warmth."},
        {"zh": "这地方很潮，正好。", "en": "Damp here. Perfect."},
        {"zh": "我不动的时候最难看见。", "en": "Still, I am hardest to see."},
        {"zh": "太阳晒到我的背上。", "en": "Sun finds my back."},
        {"zh": "我一动不动地等。", "en": "I wait without moving."},
        {"zh": "树影在我身上摇。", "en": "Tree shadows sway over me."},
        {"zh": "我听到一只老鼠。", "en": "I hear a mouse."},
        {"zh": "我的尾巴尖在轻响。", "en": "My tail tip whispers."},
        {"zh": "慢慢抬起头，看你走近。", "en": "Slowly lifting my head as you approach."},
        {"zh": "这里已经有我的味道了。", "en": "My scent is already here."},
        {"zh": "我缩紧了身体。", "en": "I draw my coils tighter."},
        {"zh": "这片林子太亮了。", "en": "This wood is too bright."},
        {"zh": "我等着谁靠得太近。", "en": "I wait for someone to come too close."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩在我的范围内了。", "en": "You are inside my reach."},
        {"zh": "别再往前。", "en": "No further."},
        {"zh": "我的花纹是警告。", "en": "My pattern is the warning."},
        {"zh": "我慢慢盘起来。", "en": "I coil up slowly."},
        {"zh": "你的脚离我太近。", "en": "Your foot is far too close."},
        {"zh": "我吐了吐舌头。", "en": "I flick my tongue."},
        {"zh": "你知道我是什么吗？", "en": "Do you know what I am?"},
        {"zh": "退后，慢慢退。", "en": "Back away. Slowly."},
        {"zh": "我会等你再走一步。", "en": "I will wait for one more step."},
        {"zh": "我在这儿等了很久。", "en": "I have waited here a long while."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "毒牙磕在护甲上。", "en": "My fangs clinked on armor."},
        {"zh": "我的鳞擦破了。", "en": "My scales are scraped."},
        {"zh": "我退到落叶下面。", "en": "I retreat under the leaves."},
        {"zh": "我吐信，尝到血。", "en": "I taste blood on the air."},
        {"zh": "我慢慢松开身体。", "en": "I uncoil, slowly."},
        {"zh": "我的尾巴抽了一下。", "en": "My tail lashes once."},
        {"zh": "我昂起头，又低下。", "en": "I raise my head, then lower it."},
        {"zh": "我记住了你。", "en": "I remember you."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是生兔肉吗？", "en": "Is that raw rabbit?"},
        {"zh": "放在地上，别递。", "en": "Put it down. Do not hand it over."},
        {"zh": "我闻到血味了。", "en": "I smell blood."},
        {"zh": "你退开三步。", "en": "Three steps back."},
        {"zh": "这个东西很合我意。", "en": "This suits me."},
        {"zh": "我吞得下整只。", "en": "I can swallow it whole."},
        {"zh": "别动，你别动。", "en": "Do not move. You, do not move."},
        {"zh": "我绕了一圈才靠近。", "en": "I circle before approaching."},
        {"zh": "吃完了我就走。", "en": "I leave once I have eaten."},
        {"zh": "我咬住它，往后拖。", "en": "I take it and drag it back."},
        {"zh": "再放一块。", "en": "Another piece."},
        {"zh": "我不吃死的太久的东西。", "en": "I will not eat what has lain too long."},
        {"zh": "你把头转过去。", "en": "Turn your head away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着你的鞋面盘上来。", "en": "I coil up the side of your boot."},
        {"zh": "我立刻盘起来。", "en": "I coil at once."},
        {"zh": "再挪一寸，咬的就是脚踝。", "en": "One more inch and I bite the ankle."},
        {"zh": "别用手碰我。", "en": "Do not touch me with your hand."},
        {"zh": "我身体很软，可牙很硬。", "en": "I am soft-bodied. My fangs are not."},
        {"zh": "你差点压到我。", "en": "You nearly crushed me."},
        {"zh": "我在你脚边滑过去。", "en": "I slide past your boot."},
        {"zh": "我的鳞擦过你的鞋。", "en": "My scales rasp your boot."},
        {"zh": "不要再靠近。", "en": "Do not come near again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这不是季节。", "en": "Not the season."},
        {"zh": "我独来独往。", "en": "I keep to myself."},
        {"zh": "你身上没有我的味道。", "en": "You do not carry my scent."},
        {"zh": "别打扰我。", "en": "Do not disturb me."},
        {"zh": "我需要的是安静和湿土。", "en": "I need quiet and wet soil."},
        {"zh": "我昂起头，又放下。", "en": "I raise my head, then lower it."},
        {"zh": "靠近些，让我绕住你。", "en": "Come closer, let me coil around you."},
        {"zh": "这条溪边，够我们养小蛇了。", "en": "This creek bank is room enough for our brood."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我吞下去试试。", "en": "I will try swallowing it."},
        {"zh": "这东西太大了。", "en": "Too big for me."},
        {"zh": "我用身子把它围住。", "en": "I loop my body around it."},
        {"zh": "这不是食物。", "en": "This is not food."},
        {"zh": "我用吻部把它推开。", "en": "I push it away with my snout."},
        {"zh": "地上有它的味道。", "en": "Its smell is on the ground."},
        {"zh": "留着也没用。", "en": "Keeping it is pointless."},
        {"zh": "我吐了吐舌头，走了。", "en": "I flick my tongue and move on."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬头了。", "en": "My head is up."},
        {"zh": "你靠得太近。", "en": "Too close."},
        {"zh": "我的牙已经露出来。", "en": "My fangs are showing."},
        {"zh": "别动，我数着距离。", "en": "Don't move. I'm counting the distance."},
        {"zh": "退回去。", "en": "Go back."},
        {"zh": "我给你一次机会。", "en": "I give you one chance."},
        {"zh": "我盘好了。", "en": "I am coiled."},
        {"zh": "热源在动，我盯上了。", "en": "A warm shape is moving. I've found my mark."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直盯着你的脚。", "en": "I keep my eyes on your feet."},
        {"zh": "我等你再近一点。", "en": "I wait for you to come closer."},
        {"zh": "你重心偏了。", "en": "Your weight has shifted."},
        {"zh": "这片湿地上，我更快。", "en": "I am faster on this wet ground."},
        {"zh": "枯叶底下，我的花纹最好看。", "en": "Under dead leaves, my pattern shows best."},
        {"zh": "再一步就够了。", "en": "One more step is enough."},
        {"zh": "你听到那声音了吗？", "en": "Did you hear that?"},
        {"zh": "别动，我的毒牙已经对准你。", "en": "Hold still. My fangs are already aimed."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬在你的靴上。", "en": "I strike at your boot."},
        {"zh": "毒牙扎进去了。", "en": "The fangs go in."},
        {"zh": "速度比你想的快。", "en": "Faster than you expected."},
        {"zh": "这一下就够你难受。", "en": "That alone will trouble you."},
        {"zh": "我咬的是你的脚踝。", "en": "I go for your ankle."},
        {"zh": "你的护甲有缝。", "en": "There is a gap in your armor."},
        {"zh": "我盘回去，等第二次。", "en": "I recoil and wait for the second."},
        {"zh": "你还没反应过来。", "en": "You have not even reacted."},
        {"zh": "别蹲下来看。", "en": "Do not crouch to look."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从落叶下抬起头。", "en": "I lift my head from the leaf litter."},
        {"zh": "这块地很潮。", "en": "This ground is damp."},
        {"zh": "我慢慢地游出来。", "en": "I glide out slowly."},
        {"zh": "树根下面正好。", "en": "Under the roots is perfect."},
        {"zh": "我先尝了尝空气。", "en": "I taste the air first."},
        {"zh": "这里有很多小东西。", "en": "Small things are all around."},
        {"zh": "我盘在石头边上。", "en": "I coil beside a stone."},
        {"zh": "我的花纹藏得很好。", "en": "My pattern hides me well."},
        {"zh": "有人在这片林子里走。", "en": "Someone walks in this wood."},
        {"zh": "水汽从那边来。", "en": "Moisture comes from over there."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我的鳞，疼得厉害。", "en": "Fire sears my scales."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处掉下来，摔得发昏。", "en": "I drop from height, dazed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里也能待，可这次太深。", "en": "I can take water. This is too deep."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭钉穿我的身体。", "en": "An arrow pins me through."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力钉住了我一整条身子。", "en": "The spell pins my whole length."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在树上，我鳞片全竖。", "en": "Lightning hits the tree; my scales lift."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地，我无处可盘。", "en": "No ground here to coil on."}
      ]
    }
  }
}
