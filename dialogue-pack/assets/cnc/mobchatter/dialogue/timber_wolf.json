{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面小跑。", "en": "I trot low along the ground."},
        {"zh": "同伴在两侧，队形不乱。", "en": "Packmates on both flanks. The line holds."},
        {"zh": "我先嗅一嗅前方。", "en": "I sniff the trail ahead."},
        {"zh": "爪垫踩在落叶上没声。", "en": "Pads on leaves make no sound."},
        {"zh": "我压着身子穿过灌木。", "en": "Belly low, I slip through the brush."},
        {"zh": "队伍往林子深处去。", "en": "The pack heads deeper into the woods."},
        {"zh": "我的尾巴垂着，保持平衡。", "en": "Tail low for balance."},
        {"zh": "我一步一顿，跟着头狼。", "en": "I keep pace behind the lead wolf."},
        {"zh": "风吹过来，我停了一下。", "en": "The wind shifts. I pause."},
        {"zh": "我走的是林子最暗的那条路。", "en": "I take the darkest path in the woods."},
        {"zh": "毛发里有冷杉的味道。", "en": "My fur smells of fir."},
        {"zh": "我们绕过鹿群走过的地方。", "en": "We circle where the deer passed."},
        {"zh": "我的耳朵一直在转。", "en": "My ears keep turning."},
        {"zh": "走过溪边，我踩得很轻。", "en": "At the creek I step light."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，鼻子在动。", "en": "Standing, my nose works."},
        {"zh": "我绷着腿，随时能冲。", "en": "Legs taut, ready to break."},
        {"zh": "林子里有鹿群的味道。", "en": "Deer in these woods."},
        {"zh": "我低吼一声，同伴回应。", "en": "I growl low and a packmate answers."},
        {"zh": "我把头压低了一点。", "en": "I lower my head a little."},
        {"zh": "我在听远处的蹄声。", "en": "Listening for hooves far off."},
        {"zh": "苔藓很凉，我不在意。", "en": "The moss is cold. I don't mind."},
        {"zh": "我们轮流警戒。", "en": "We take turns on watch."},
        {"zh": "我们在这里守了一夜。", "en": "We've watched here all night."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你不该一个人进林子。", "en": "You shouldn't be in these woods alone."},
        {"zh": "我的手边还有同伴。", "en": "I have packmates beside me."},
        {"zh": "我盯了你很久。", "en": "I've been watching you a while."},
        {"zh": "你手上的东西是武器吧。", "en": "That thing in your hand is a weapon."},
        {"zh": "跑的话，我会追。", "en": "If you run, I'll chase."},
        {"zh": "你跑得有多快？", "en": "How fast do you actually run?"},
        {"zh": "我们不是来玩的。", "en": "We're not here to play."},
        {"zh": "你在看我，我也在掂量你。", "en": "You're sizing me up. I'm sizing you up too."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我侧身躲了一下。", "en": "I twisted away."},
        {"zh": "肩被撞得发麻。", "en": "My shoulder's gone numb."},
        {"zh": "我低吼着往后退。", "en": "I growl and pull back."},
        {"zh": "血从嘴边滴下来。", "en": "Blood drips from my muzzle."},
        {"zh": "这条腿使不上劲。", "en": "This leg won't push."},
        {"zh": "我现在喘得很急。", "en": "I'm panting hard right now."},
        {"zh": "这一下不对劲。", "en": "That one went in wrong."},
        {"zh": "我压住身子，等你靠近。", "en": "I crouch and wait for you."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉的腥味我闻得到。", "en": "I can smell the rawness."},
        {"zh": "扔过来，别用手递。", "en": "Throw it. Don't hand it over."},
        {"zh": "这点东西不够分。", "en": "That's not enough to share."},
        {"zh": "我会先让头狼吃。", "en": "The lead eats first."},
        {"zh": "你把肉举高是没用的。", "en": "Holding it up won't help you."},
        {"zh": "我们不从手上取食。", "en": "We don't take from hands."},
        {"zh": "放下，退开，别看着。", "en": "Put it down, back off, look away."},
        {"zh": "这股味道让我烦躁。", "en": "That smell is making me restless."},
        {"zh": "吃完了再说别的。", "en": "After we eat, we'll see."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞进了队伍里。", "en": "You've blundered into the pack."},
        {"zh": "退后，压低身子。", "en": "Back off and stay low."},
        {"zh": "我一侧身就是咬。", "en": "I turn sideways and it's a bite."},
        {"zh": "别用肩膀来顶我。", "en": "Don't shoulder into me."},
        {"zh": "我们围住了这个位置。", "en": "We've closed around this spot."},
        {"zh": "尾巴被踩，我龇了牙。", "en": "Tail stepped on—my teeth show."},
        {"zh": "别贴得离我这么近。", "en": "Don't press up so close to me."},
        {"zh": "林子里的空间不够我们分。", "en": "There's not room enough in these woods."},
        {"zh": "我从那边包过来了。", "en": "I've circled in from that side."},
        {"zh": "我压着肩膀，把你顶回去。", "en": "Shoulder low, I shove you back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "头狼才有这个资格。", "en": "Only the lead earns that."},
        {"zh": "我们只在冬天成对。", "en": "We pair in winter only."},
        {"zh": "这是队伍的事。", "en": "That's the pack's business."},
        {"zh": "我不和外来者谈这些。", "en": "I don't discuss that with outsiders."},
        {"zh": "我还得守着这片林子。", "en": "I still have this wood to guard."},
        {"zh": "耳朵竖起来的人有野心。", "en": "Ambition is written in your ears."},
        {"zh": "这种事，得先让头狼闻。", "en": "The alpha sniffs first."},
        {"zh": "先看你能不能打。", "en": "First let's see if you can fight."},
        {"zh": "这件事要听头狼的。", "en": "The lead decides such things."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把骨头叼走了。", "en": "I carry the bone off."},
        {"zh": "这块皮能垫窝。", "en": "This hide will line the den."},
        {"zh": "我把它叼给头狼。", "en": "I'm carrying it to the lead."},
        {"zh": "这个东西我不吃。", "en": "I don't eat this thing."},
        {"zh": "这块肉归队伍。", "en": "This meat belongs to the pack."},
        {"zh": "爪子按着，等头狼来嗅。", "en": "Pinned under paw till the alpha sniffs."},
        {"zh": "你掉的东西，给。", "en": "You dropped this. Here."},
        {"zh": "这一块太硬了。", "en": "This piece is too tough."},
        {"zh": "叼起来就走，不回头。", "en": "Take it and go. No looking back."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "现在已经锁定你了。", "en": "You're marked now."},
        {"zh": "队伍散开，包围。", "en": "Pack, spread and surround."},
        {"zh": "你退路是那条溪。", "en": "Your way out is the creek."},
        {"zh": "我嗅到了你的方向。", "en": "I've got your direction."},
        {"zh": "这个距离正好起跳。", "en": "Perfect distance to leap."},
        {"zh": "我先冲，你们跟上。", "en": "I charge. Follow me."},
        {"zh": "它已经跑不快了。", "en": "It can't run fast anymore."},
        {"zh": "鹿角对着我们。", "en": "Antlers facing us."},
        {"zh": "我绕到侧翼，等你露腿。", "en": "I flank and wait for your leg."},
        {"zh": "别让它靠近林子。", "en": "Keep it out of the trees."},
        {"zh": "你转身就晚了。", "en": "Turning now is too late."},
        {"zh": "我们一直跟到它累。", "en": "We follow until it tires."},
        {"zh": "都准备好，一起上。", "en": "All ready. Together now."},
        {"zh": "风把这味道送过来了。", "en": "The wind brought the scent."},
        {"zh": "那不是鹿，是个人。", "en": "That isn't a deer. It's a person."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它往坡上跑了。", "en": "It's running uphill."},
        {"zh": "我们分开把它堵住。", "en": "We'll split up and block it."},
        {"zh": "它喘得很重了。", "en": "It's breathing hard."},
        {"zh": "再追一段就能扑。", "en": "A little further and we can pounce."},
        {"zh": "我贴着灌木走。", "en": "I move along the brush."},
        {"zh": "它回头看这边了。", "en": "It glanced back this way."},
        {"zh": "别叫，等它停下来。", "en": "Quiet. Wait for it to stop."},
        {"zh": "它跳到石头上了。", "en": "It's up on the rocks."},
        {"zh": "我压低身体不露头。", "en": "I keep my head below cover."},
        {"zh": "它往溪边走，正合我意。", "en": "It's heading to the creek. Good."},
        {"zh": "我的爪子抓地很稳。", "en": "My claws hold the ground well."},
        {"zh": "它现在正在犹豫。", "en": "It's hesitating right now."},
        {"zh": "再绕半圈就合围了。", "en": "Half a circle more and we close."},
        {"zh": "我们三个，一个方向。", "en": "Three of us, one direction."},
        {"zh": "它的四条腿在抖。", "en": "Its legs are trembling."},
        {"zh": "风向对我不利。", "en": "The wind's against me."},
        {"zh": "它退到岩石后面。", "en": "It's gone behind the rocks."},
        {"zh": "我听见它喘气。", "en": "I hear it panting."},
        {"zh": "它转身了，快上。", "en": "It turned. Now."},
        {"zh": "这最后一扑要准。", "en": "This last pounce must land."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑向你的腿。", "en": "I go for your legs."},
        {"zh": "一口咬住，不松口。", "en": "I bite and don't let go."},
        {"zh": "这一下撕开皮。", "en": "That tears the hide."},
        {"zh": "把它压住，压住它。", "en": "Pin it down. Pin it."},
        {"zh": "爪子抓你的护膝。", "en": "Claws raking your guard."},
        {"zh": "它躲开了，再上。", "en": "It dodged. Again."},
        {"zh": "我咬住脚踝往后拖。", "en": "I bite the ankle and drag back."},
        {"zh": "同伴从另一边上了。", "en": "A packmate comes from the other side."},
        {"zh": "别松开，千万别松。", "en": "Don't release. Whatever you do."},
        {"zh": "牙齿碰到了骨头。", "en": "Teeth met bone."},
        {"zh": "它摔倒了，正好。", "en": "It's down. Perfect."},
        {"zh": "我的肩还在疼。", "en": "My shoulder still hurts."},
        {"zh": "它已经撑不住了。", "en": "It can't hold out anymore."},
        {"zh": "退开，放它跑吧。", "en": "Back off. Let it run."},
        {"zh": "我跟着它流血的味道。", "en": "I follow the smell of its blood."},
        {"zh": "再来一次就够了。", "en": "One more will do it."},
        {"zh": "它往林子去了。", "en": "It's breaking for the trees."},
        {"zh": "我们赢了这一回。", "en": "We've won this one."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树线里走出来。", "en": "I step out from the treeline."},
        {"zh": "这片林子是我们的猎场。", "en": "This forest is our hunting ground."},
        {"zh": "雪还没化，正好追踪。", "en": "Snow hasn't melted. Good for tracking."},
        {"zh": "我压低身体，先看风向。", "en": "Low body, checking the wind."},
        {"zh": "头狼叫了一声。", "en": "The lead called."},
        {"zh": "我踩进松针里，没声。", "en": "Pines underfoot. Silent."},
        {"zh": "鹿群的味道很新。", "en": "The deer scent is fresh."},
        {"zh": "我们在这里等。", "en": "We'll wait here."},
        {"zh": "我的毛上挂着霜。", "en": "Frost clings to my fur."},
        {"zh": "我绕着这块地转了一圈。", "en": "I make one circuit of this ground."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里我们围住一头鹿。", "en": "In the woods we circle a deer."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下来，摔懵了。", "en": "Rolled down the slope and dazed myself."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到脖子，我游不快。", "en": "Water at my neck. I can't swim well."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀到树根边。", "en": "The blast threw me against the roots."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的肋侧。", "en": "An arrow sank into my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那咒光让我眼睛发花。", "en": "That light blurred my eyes."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我们追得太久，没吃到东西。", "en": "We've chased too long without food."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着一身湿毛走遍我。", "en": "Lightning ran through my wet fur."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在坠落，爪子什么都抓不住。", "en": "Falling, and my claws find nothing."}
      ]
    }
  }
}
