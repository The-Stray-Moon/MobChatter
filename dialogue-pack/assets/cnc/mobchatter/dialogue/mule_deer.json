{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩在干裂的地上，很轻。", "en": "I step lightly over the cracked earth."},
        {"zh": "鹿角扫过低矮的枝。", "en": "My antlers brush the low branches."},
        {"zh": "开阔的坡地适合我。", "en": "Open slopes suit me."},
        {"zh": "我走得很稳，蹄子不滑。", "en": "I keep a steady pace; my hooves do not slip."},
        {"zh": "草干得很脆，走路有声。", "en": "The dry grass cracks underfoot."},
        {"zh": "风从左边来，我侧过头。", "en": "Wind from the left; I turn my head."},
        {"zh": "这地方太干，但草很甜。", "en": "Dry here, but the grass is sweet."},
        {"zh": "我沿着树线走。", "en": "I walk the treeline."},
        {"zh": "蹄印留在干土上。", "en": "Hoofprints stay in the dry soil."},
        {"zh": "我不喜欢被围住。", "en": "I dislike being hemmed in."},
        {"zh": "我跳过一道矮沟。", "en": "I clear a shallow ditch."},
        {"zh": "鹿角有点沉。", "en": "The antlers are heavy."},
        {"zh": "我听到远处的动静，慢下来。", "en": "I slow at a sound far off."},
        {"zh": "这一带没有狼吧。", "en": "There are no wolves here, I hope."},
        {"zh": "我一边嚼一边走。", "en": "I chew as I walk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，耳朵在转向。", "en": "I stand, ears swiveling."},
        {"zh": "风向变了，我知道。", "en": "The wind shifted. I know."},
        {"zh": "我把脖子低下去啃草。", "en": "I lower my neck to graze."},
        {"zh": "阳光晒着我的背。", "en": "Sun on my back."},
        {"zh": "那片树影是安全的。", "en": "That shade is safe."},
        {"zh": "我在听有没有脚步。", "en": "I listen for footsteps."},
        {"zh": "鹿角上挂着草屑。", "en": "Grass catches in my antlers."},
        {"zh": "我抖了一下耳朵。", "en": "I flick an ear."},
        {"zh": "这片地的草不够高。", "en": "The grass here is too short."},
        {"zh": "我抬头，盯住同一个点。", "en": "I lift my head and fix on one point."},
        {"zh": "我没有叫，叫了会引来东西。", "en": "I do not call. Calling draws things."},
        {"zh": "远处的尘土不是我扬的。", "en": "That dust is not mine."},
        {"zh": "我把重心换到前腿。", "en": "I shift weight to my forelegs."},
        {"zh": "我闻到了铁的味道。", "en": "I smell iron."},
        {"zh": "我慢慢往树那边退。", "en": "I drift back toward the trees."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上没有铁味吧。", "en": "You do not carry iron, do you?"},
        {"zh": "我盯着你，看了很久。", "en": "I stare at you a long while."},
        {"zh": "你站的位置挡住了风。", "en": "You are blocking the wind."},
        {"zh": "我退到树影的边缘。", "en": "I back to the edge of the tree shadow."},
        {"zh": "我不是给人看的。", "en": "I am not here to be looked at."},
        {"zh": "你的姿势不像猎人。", "en": "Your stance is not a hunter's."},
        {"zh": "我侧过身，露出角。", "en": "I turn sideways, showing my antlers."},
        {"zh": "我们要保持这个距离。", "en": "This distance must hold."},
        {"zh": "我从鼻孔里哼了一声。", "en": "I snort once through my nose."},
        {"zh": "我的角比白尾鹿的更大。", "en": "My antlers are bigger than a whitetail's."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳开了，很疼。", "en": "I spring away, hurt."},
        {"zh": "血从肩上流下来。", "en": "Blood runs down my shoulder."},
        {"zh": "疼归疼，蹄子还听使唤。", "en": "It hurts, but my hooves still answer."},
        {"zh": "我短促地叫了一声。", "en": "I give a short cry."},
        {"zh": "我这对角，比白尾鹿的大。", "en": "These antlers are bigger than a whitetail's."},
        {"zh": "我不该停下来的。", "en": "I should not have stopped."},
        {"zh": "这伤不深。", "en": "The wound is shallow."},
        {"zh": "后腿在抖，我撑住。", "en": "My hind legs shake. I hold."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那草很嫩吧。", "en": "That grass looks tender."},
        {"zh": "你撒在地上，我再过来。", "en": "Scatter it and I will come."},
        {"zh": "这味道真好。", "en": "That smells good."},
        {"zh": "我慢慢靠近两步。", "en": "I take two slow steps closer."},
        {"zh": "再远一点我就走。", "en": "One more step and I bolt."},
        {"zh": "这个季节草都干了。", "en": "Everything is dry this season."},
        {"zh": "你别站着看。", "en": "Do not stand there watching."},
        {"zh": "我低头吃一口。", "en": "I lower my head for one bite."},
        {"zh": "我走了，谢谢。", "en": "I am off. Thank you."},
        {"zh": "换一堆更好的来。", "en": "Bring a better pile."},
        {"zh": "我还要一点。", "en": "A little more."},
        {"zh": "后面的树影我不放心。", "en": "That shade behind worries me."},
        {"zh": "我抬起头，又低下。", "en": "Up, then down again."},
        {"zh": "这堆草，我只吃一半。", "en": "I'll eat only half this pile."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的角了。", "en": "You hit my antlers."},
        {"zh": "我比看起来重。", "en": "I am heavier than I look."},
        {"zh": "我侧身避开。", "en": "I turn aside."},
        {"zh": "你踩的是干泥。", "en": "You stepped on dry mud."},
        {"zh": "干土上撞得我歪了。", "en": "On dry soil, that knocked me crooked."},
        {"zh": "我们彼此让开。", "en": "Let us each give way."},
        {"zh": "我的腿很细，可很硬。", "en": "My legs are thin, and hard."},
        {"zh": "对不起！我这就跳开！", "en": "Sorry! I'll spring away right now!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "现在是旱季。", "en": "This is the dry season."},
        {"zh": "我不跟不认识的一起。", "en": "Not with someone I do not know."},
        {"zh": "我的角还不够大。", "en": "My antlers are not big enough."},
        {"zh": "这种事要有草地和安静。", "en": "That needs grass and quiet."},
        {"zh": "你别靠这么近。", "en": "Not so close."},
        {"zh": "我得先看清一整群。", "en": "I must see the whole herd first."},
        {"zh": "再说吧。", "en": "Another time."},
        {"zh": "我摇了摇角。", "en": "I shake my antlers."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个我咬不动。", "en": "I cannot chew this."},
        {"zh": "我用蹄子拨了拨。", "en": "I nudge it with a hoof."},
        {"zh": "骡鹿的鼻尖，碰了碰它。", "en": "The mule deer's nose touched it."},
        {"zh": "地上有盐？", "en": "Is that salt?"},
        {"zh": "我踩进泥里拿不到。", "en": "It is in the mud out of reach."},
        {"zh": "这片地掉了很多东西。", "en": "Many things fall on this ground."},
        {"zh": "不是草，我闻一下就走了。", "en": "Not grass. I sniff once and move on."},
        {"zh": "我绕过走了。", "en": "I walk around it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我炸开了，一跃就跑。", "en": "I bolt in a single leap."},
        {"zh": "我不跟你打。", "en": "I will not fight you."},
        {"zh": "角只用来顶开枝子。", "en": "My antlers are for branches."},
        {"zh": "我会一直跑到没影。", "en": "I will run until I vanish."},
        {"zh": "我的蹄子打滑，但我还能跑。", "en": "My hooves slip, but I keep running."},
        {"zh": "我冲过那道沟。", "en": "I clear that ditch."},
        {"zh": "你追不上我的。", "en": "You will not catch me."},
        {"zh": "我发出一声短促的鸣叫。", "en": "I give one short call."},
        {"zh": "我把头一低就要冲。", "en": "Head down, I am about to bolt."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一动，你就追。", "en": "I move, and you chase."},
        {"zh": "我在找最开阔的路。", "en": "I am looking for open ground."},
        {"zh": "我的耳朵全朝前。", "en": "Both ears point forward."},
        {"zh": "我踢了一下地。", "en": "I stamp once."},
        {"zh": "我不想用角。", "en": "I would rather not use my antlers."},
        {"zh": "你把我逼到了树线。", "en": "You have pushed me to the treeline."},
        {"zh": "再近我就撞。", "en": "One step more and I charge."},
        {"zh": "我的腿在颤。", "en": "My legs tremble."},
        {"zh": "让我走。", "en": "Let me go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用角顶开你。", "en": "I shove you with my antlers."},
        {"zh": "我踢了一脚。", "en": "I kick out."},
        {"zh": "这一下只是为了跑。", "en": "That was only to escape."},
        {"zh": "我的蹄子擦过你的护腿。", "en": "My hoof grazes your greave."},
        {"zh": "我撞得你退了。", "en": "The charge drives you back."},
        {"zh": "我甩头，角扫过去。", "en": "I toss my head; the antlers sweep."},
        {"zh": "我不是捕食者。", "en": "I am no predator."},
        {"zh": "这一下我用了全部力气。", "en": "That took all my strength."},
        {"zh": "我转身就跑。", "en": "I turn and run."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树线那边走出来。", "en": "I step out from the treeline."},
        {"zh": "这里很干，我喜欢。", "en": "Dry air. I like it."},
        {"zh": "我的角先露出草丛。", "en": "My antlers show above the grass."},
        {"zh": "脚下一片碎石。", "en": "Gravel underfoot."},
        {"zh": "我停下听了一会儿。", "en": "I stop to listen."},
        {"zh": "这群地方够开阔。", "en": "This ground is open enough."},
        {"zh": "我慢慢走到坡上。", "en": "I walk up to the slope."},
        {"zh": "我抖了抖脖子。", "en": "I shake my neck."},
        {"zh": "远处有草的味道。", "en": "Grass scent in the distance."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在草上跑，我拔腿就逃。", "en": "Fire races the grass; I flee."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腿落地时弯了。", "en": "My legs buckle on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过我的膝，我拼命往岸上挣。", "en": "Water to my knees; I fight for shore."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被炸得翻倒，又爬起来。", "en": "The blast knocks me over; I rise."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力气让我四腿发软。", "en": "That force saps all four legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "草太干，我越来越瘦。", "en": "Dry grass. I grow thinner."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在树上，我惊得狂奔。", "en": "Lightning hits a tree; I bolt."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有草，也没有地。", "en": "No grass, no ground."}
      ]
    }
  }
}
