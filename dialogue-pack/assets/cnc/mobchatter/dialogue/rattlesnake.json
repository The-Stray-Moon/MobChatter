{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着沙纹滑向前", "en": "I slide forward along the sand ripples"},
        {"zh": "我的身体一折一折地推", "en": "My body folds and pushes me on."},
        {"zh": "我绕开石块滑行", "en": "I snake around the stones."},
        {"zh": "我从草丛里穿过", "en": "I slip through the dry grass."},
        {"zh": "我贴着沙地往前爬", "en": "I crawl along the sand."},
        {"zh": "我的尾巴在身后响", "en": "My tail rattles behind me."},
        {"zh": "我爬到枯木旁边", "en": "I slide up beside a dead log."},
        {"zh": "我一点点挪进阴影", "en": "I inch into the shade."},
        {"zh": "我从石头缝里钻出来", "en": "I come out of a rock gap."},
        {"zh": "我换了个方向继续滑", "en": "I turn and keep sliding."},
        {"zh": "我停在路中间", "en": "I stop in the middle of the path."},
        {"zh": "我的鳞片擦过砂砾", "en": "My scales rasp over grit."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把自己盘成一圈", "en": "I coil into a ring."},
        {"zh": "我的头抬着不动", "en": "My head stays raised and still."},
        {"zh": "尾巴轻轻响着", "en": "My tail whispers."},
        {"zh": "我懒懒地晒着太阳", "en": "I bask in the sun."},
        {"zh": "舌信分叉，尝到了你的味。", "en": "My forked tongue tastes you on the air."},
        {"zh": "我伏在沙上像根枯枝", "en": "I lie like a dead twig in the sand."},
        {"zh": "我在等热的东西经过", "en": "I wait for something warm to pass."},
        {"zh": "我全身的鳞都绷紧", "en": "Every scale of me is tight."},
        {"zh": "砂子粘在我的鳞上", "en": "Sand clings to my scales."},
        {"zh": "我慢慢抬起前半身", "en": "I lift my front half slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头看着你", "en": "I raise my head and watch you."},
        {"zh": "我的尾巴开始响了", "en": "My tail has started to rattle."},
        {"zh": "你踩进我的圈子了", "en": "You have stepped into my circle."},
        {"zh": "我一眨也不眨", "en": "I do not blink."},
        {"zh": "我的头跟着你的靴子转", "en": "My head turns with your boots"},
        {"zh": "我往后缩了半格", "en": "I draw back half a block."},
        {"zh": "我的头随着你转动", "en": "My head turns with you."},
        {"zh": "你走你的路就好", "en": "Just go your own way."},
        {"zh": "我的心跳你能看见", "en": "You can see my heart beat."},
        {"zh": "我在衡量你的距离", "en": "I am measuring your distance."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我疼得扭成一团", "en": "I twist into a knot."},
        {"zh": "我的尾巴响得更急", "en": "My rattle quickens."},
        {"zh": "我的鳞片被掀起来了", "en": "My scales are lifted."},
        {"zh": "我往石头底下钻", "en": "I dive under the stone."},
        {"zh": "血沾在我的头上", "en": "Blood is on my head."},
        {"zh": "我慢慢缓过劲来", "en": "I slowly come back to myself."},
        {"zh": "我的身体抽了一下", "en": "My body jerks."},
        {"zh": "我盘得比刚才更紧", "en": "I coil tighter than before."},
        {"zh": "这一下疼得我发颤", "en": "The pain makes me tremble."},
        {"zh": "我还没松开毒牙", "en": "My fangs are still ready."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我嗅到了生肉的味道", "en": "I smell raw meat."},
        {"zh": "生的兔肉才对我胃口", "en": "Raw rabbit is what suits me."},
        {"zh": "我的舌头在空中探", "en": "My tongue tests the air."},
        {"zh": "我朝那块肉滑过去", "en": "I slide toward that meat."},
        {"zh": "我停在它前面", "en": "I stop in front of it."},
        {"zh": "这味道让我改了主意", "en": "That smell changes my mind."},
        {"zh": "我绕着它转了半圈", "en": "I coil half around it."},
        {"zh": "我把嘴张得能吞下整块", "en": "I open wide enough to swallow it whole."},
        {"zh": "我一口把它吞下去", "en": "I swallow it down."},
        {"zh": "这份量有点少", "en": "That is a small portion."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到了我的身体", "en": "You stepped on my body."},
        {"zh": "我立刻扭过头来", "en": "I whip my head around at once."},
        {"zh": "我的尾巴响成一片", "en": "My tail rattles loud."},
        {"zh": "我从你脚边弹开", "en": "I spring away from your foot."},
        {"zh": "我贴在石头后面", "en": "I press behind a stone."},
        {"zh": "撞得我盘了起来", "en": "The knock makes me coil."},
        {"zh": "我的鳞被蹭起了毛", "en": "My scales are roughed up."},
        {"zh": "我又慢慢放松下来", "en": "I slowly relax again."},
        {"zh": "你差点压住我", "en": "You nearly pinned me."},
        {"zh": "我盘起来，尾尖在响", "en": "I coil up, tail tip rattling"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一条从草里滑过来", "en": "Another slides out of the grass."},
        {"zh": "我们互相绕着转", "en": "We coil around each other."},
        {"zh": "我们的头并在一起", "en": "Our heads come together."},
        {"zh": "它的尾巴比我小", "en": "Its rattle is smaller than mine."},
        {"zh": "我们一起盘在石头上", "en": "We coil on the stone together."},
        {"zh": "它贴着我的身体滑", "en": "It slides along my flank."},
        {"zh": "我们并排晒着沙地", "en": "We bask side by side on the sand."},
        {"zh": "我们不出一点声音", "en": "Neither of us makes a sound."},
        {"zh": "它比我早一步动", "en": "It moves first."},
        {"zh": "我们就这样盘着", "en": "We stay coiled like this."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用嘴把它顶起来", "en": "I nudge it up with my mouth."},
        {"zh": "我张嘴一口含住", "en": "I take it in my mouth."},
        {"zh": "我把它整个吞下", "en": "I swallow it whole."},
        {"zh": "我抬起头把它送下去", "en": "I lift my head to work it down."},
        {"zh": "我舔了舔嘴边的砂", "en": "I lick the sand off my jaw."},
        {"zh": "我放弃了这个东西", "en": "I give up on it."},
        {"zh": "我用头顶把它推开", "en": "I shove it aside."},
        {"zh": "我的身体把它圈住", "en": "I coil around it."},
        {"zh": "我一点点松开身", "en": "I slowly let go."},
        {"zh": "我压根没有动它", "en": "I did not touch it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的头一下抬高了", "en": "My head snaps up."},
        {"zh": "尾巴开始急响", "en": "My tail rattles fast."},
        {"zh": "我把身体盘成一团", "en": "I coil my body into a spring."},
        {"zh": "沙地上的一动，我听得见。", "en": "I hear a single movement on the sand."},
        {"zh": "你踏进了我的地盘", "en": "You stepped into my ground."},
        {"zh": "我的前半身立了起来", "en": "My front half rears up."},
        {"zh": "我这次不再躲了", "en": "I stop hiding."},
        {"zh": "我的舌头最后探了一下", "en": "My tongue flickers one last time."},
        {"zh": "我把头贴到了沙面", "en": "I press my head to the sand."},
        {"zh": "这一下我准备好了", "en": "I am ready now."},
        {"zh": "我计算着出手的距离", "en": "I measure the strike distance."},
        {"zh": "你只要再动一下", "en": "Just move once more."},
        {"zh": "我从石头边挪开", "en": "I slide off the stone's edge."},
        {"zh": "你的脚一落地我就知道", "en": "One footfall and I know where you are"},
        {"zh": "毒牙已经立起来了", "en": "My fangs are ready."},
        {"zh": "我等着你踏错一步", "en": "I wait for one wrong step."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的头跟着你转", "en": "My head tracks you."},
        {"zh": "尾巴响得没停过", "en": "My rattle has not stopped."},
        {"zh": "我把身体收得更紧", "en": "I draw my coils tighter."},
        {"zh": "你的每一步我都算着", "en": "I count your every step."},
        {"zh": "我藏在草里等", "en": "I wait hidden in the grass."},
        {"zh": "你停下来我也停下来", "en": "You stop; I stop."},
        {"zh": "我在等你的脚落地", "en": "I wait for your foot to land."},
        {"zh": "我的头一直在你脚边", "en": "My head stays by your feet."},
        {"zh": "你退一步我就松一分", "en": "One step back, and I loosen."},
        {"zh": "我慢慢往前挪半寸", "en": "I creep half an inch forward."},
        {"zh": "草叶动了一下", "en": "A blade of grass stirs."},
        {"zh": "我离你的脚只有一格", "en": "I am one block from your foot."},
        {"zh": "我的毒性留着不用", "en": "I keep my venom in reserve."},
        {"zh": "你不惹我，我也不动", "en": "If you leave me be, I stay."},
        {"zh": "我装作一块枯枝", "en": "I pretend to be a dead branch."},
        {"zh": "我的心跳越来越快", "en": "My heart beats faster."},
        {"zh": "我把头缩了又伸", "en": "I draw my head in and out."},
        {"zh": "你再靠近就晚了", "en": "Come closer and it will be too late."},
        {"zh": "我在等一个最好的角度", "en": "I wait for the best angle."},
        {"zh": "这一次我不再退了", "en": "I will not back off again."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬在你的小腿", "en": "I strike your calf."},
        {"zh": "毒牙扎进了肉里", "en": "My fangs sink in."},
        {"zh": "我咬完立刻松开", "en": "I let go the moment I bite."},
        {"zh": "我全身弹出去", "en": "My whole body springs out."},
        {"zh": "这一下又快又准", "en": "That strike was fast and true."},
        {"zh": "我抽身盘回原处", "en": "I pull back into my coil."},
        {"zh": "毒牙刚碰到你就拔出来", "en": "The fang touches and pulls straight out"},
        {"zh": "我的牙还挂着毒", "en": "Venom still hangs from my fangs."},
        {"zh": "我又扎了第二下", "en": "I strike a second time."},
        {"zh": "我甩尾扫过你的脚踝", "en": "My tail slaps your ankle."},
        {"zh": "我的身体缠了一下你的腿", "en": "My body loops your leg."},
        {"zh": "他跳开了，我扑空", "en": "He jumps clear; I miss."},
        {"zh": "我从侧面弹起来", "en": "I spring up from his flank."},
        {"zh": "我咬上就不松牙", "en": "Once I bite, I do not let go."},
        {"zh": "你把我踢开了", "en": "You kick me away."},
        {"zh": "我落回草里再盘起来", "en": "I land in the grass and coil again."},
        {"zh": "我的尾巴还在响", "en": "My rattle keeps going."},
        {"zh": "这一口我用尽了力气", "en": "That bite took all my strength."},
        {"zh": "我慢慢退回石头后", "en": "I withdraw behind the stone."},
        {"zh": "我盯着你退走的背影", "en": "I watch your back as you retreat."}
      ]
    },
    "spawn": {
