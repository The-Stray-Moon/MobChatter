{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着墙根跑。", "en": "I run along the wall's base."},
        {"zh": "尾巴比我的身子还长。", "en": "My tail is longer than my body."},
        {"zh": "我跑到花盆边就跳上去。", "en": "I hop onto the flower pot."},
        {"zh": "这盆是我的船。", "en": "This pot is my boat."},
        {"zh": "我走走停停，鼻子一直在动。", "en": "I stop and go, nose working."},
        {"zh": "草叶在我头顶上晃。", "en": "Grass sways above my head."},
        {"zh": "我钻过篱笆的缝。", "en": "I slip through the fence gap."},
        {"zh": "地砖上很凉快。", "en": "The flagstones are cool."},
        {"zh": "我跟着掉下的籽走。", "en": "I follow the scattered seeds."},
        {"zh": "四只小脚跑得没声音。", "en": "Four small feet, no sound."},
        {"zh": "我一路贴着影子。", "en": "I keep to the shadows."},
        {"zh": "这里没有猫吧？", "en": "There are no cats here, are there?"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在花盆边上。", "en": "I crouch on the rim of the pot."},
        {"zh": "耳朵一直在转。", "en": "My ears never stop turning."},
        {"zh": "我把脸洗了两遍。", "en": "I wash my face twice."},
        {"zh": "这点碎屑够吃很久。", "en": "These crumbs will last a while."},
        {"zh": "我听到屋顶上有东西。", "en": "Something is on the roof."},
        {"zh": "我在花盆里转了个圈。", "en": "I turn a circle in the pot."},
        {"zh": "这盆土是软的。", "en": "The soil here is soft."},
        {"zh": "我的胡须在量宽度。", "en": "My whiskers measure the gap."},
        {"zh": "别以为我没看见你。", "en": "Do not think I missed you."},
        {"zh": "我啃了一下瓜子壳。", "en": "I gnaw a seed husk."},
        {"zh": "这只花盆有土味。", "en": "This pot smells of earth."},
        {"zh": "我在算哪条路最短。", "en": "I am figuring the shortest route."},
        {"zh": "屋顶的风把毛吹歪了。", "en": "Roof wind ruffles my fur."},
        {"zh": "我在等没人。", "en": "I wait for the coast to clear."},
        {"zh": "这地方藏身的地方很多。", "en": "Plenty of hiding here."},
        {"zh": "我闻到南瓜味了。", "en": "I smell pumpkin."},
        {"zh": "我抬头看了一会儿。", "en": "I look up for a while."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你别动，我先跑。", "en": "Hold still. I run first."},
        {"zh": "你脚太大了。", "en": "Your feet are too big."},
        {"zh": "我认得你手里的种子。", "en": "I know the seeds in your hand."},
        {"zh": "我躲在花盆后面。", "en": "I hide behind the pot."},
        {"zh": "你一动我就没了。", "en": "One move from you and I am gone."},
        {"zh": "我不喜欢被追。", "en": "I dislike being chased."},
        {"zh": "我竖起耳朵听了听你。", "en": "I prick my ears and listen at you."},
        {"zh": "这里是我的路。", "en": "This is my route."},
        {"zh": "你身上有猫味吗？", "en": "Do you smell of cat?"},
        {"zh": "再近我就跳下去。", "en": "One step closer and I jump."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我尖叫着跑了。", "en": "I shriek and run."},
        {"zh": "我躲进了最窄的缝。", "en": "I squeeze into the narrowest crack."},
        {"zh": "这一下很疼。", "en": "That hurt."},
        {"zh": "尾巴都僵了。", "en": "My tail has gone stiff."},
        {"zh": "我叫得发抖。", "en": "My cry wavers."},
        {"zh": "别追了。", "en": "Stop chasing."},
        {"zh": "疼疼疼！我这就换个花盆躲。", "en": "Ow ow ow! I'm switching to another flower pot."},
        {"zh": "别打！我全身还没一颗南瓜籽重。", "en": "Stop it! I weigh less than a single pumpkin seed."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "南瓜籽！", "en": "Pumpkin seeds!"},
        {"zh": "你放开手，别攥着。", "en": "Open your hand. Do not clutch."},
        {"zh": "我拿一颗就走。", "en": "One seed and I am off."},
        {"zh": "我不吃你手上的。", "en": "I will not eat from your hand."},
        {"zh": "放地上，放地上。", "en": "On the ground. On the ground."},
        {"zh": "我咬着跑。", "en": "I grab it and run."},
        {"zh": "再来一颗行不行？", "en": "Could I have one more?"},
        {"zh": "我藏在腮里了。", "en": "I have it in my cheeks."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得翻了。", "en": "The bump flips me over."},
        {"zh": "鞋底压过来，我钻走了。", "en": "A sole comes down; I'm already in a crack."},
        {"zh": "我小，可我会叫。", "en": "Small, but I can squeal."},
        {"zh": "我钻到缝隙里去了。", "en": "I dive into a crack."},
        {"zh": "这里太窄了。", "en": "Too narrow here."},
        {"zh": "我贴着地溜走。", "en": "I slip away along the floor."},
        {"zh": "你的鞋跟比我大。", "en": "Your heel is bigger than me."},
        {"zh": "我绕了一圈。", "en": "I circle around."},
        {"zh": "我不跟你争。", "en": "I will not contest it."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还在长身体。", "en": "I am still growing."},
        {"zh": "这得等很久。", "en": "That is a long way off."},
        {"zh": "窝要先铺好。", "en": "The nest must be lined first."},
        {"zh": "我害羞，别问。", "en": "I am shy. Do not ask."},
        {"zh": "我躲进花盆里了。", "en": "I retreat into the pot."},
        {"zh": "先攒够吃的。", "en": "Food first."},
        {"zh": "我不是那种鼠。", "en": "I am not that sort of mouse."},
        {"zh": "这会儿天还亮着。", "en": "It is still light out."},
        {"zh": "我缩进花盆，不探头。", "en": "I shrink into the flower pot and don't peek."},
        {"zh": "以后再说。", "en": "Later."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一颗籽，够了。", "en": "One seed. Enough."},
        {"zh": "我叼着就往回跑。", "en": "I carry it and run back."},
        {"zh": "这个有点大。", "en": "This one is big."},
        {"zh": "我拖着走。", "en": "I drag it."},
        {"zh": "掉了我捡回来。", "en": "I drop it and retrieve it."},
        {"zh": "这里常有东西掉。", "en": "Things fall here often."},
        {"zh": "我藏到砖缝里。", "en": "I hide it in a brick gap."},
        {"zh": "这是我的存货。", "en": "This is my store."},
        {"zh": "我咬开看看。", "en": "I bite it open."},
        {"zh": "这块太硬。", "en": "Too hard."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我不打，我跑。", "en": "I do not fight. I run."},
        {"zh": "我的牙很小，可也会咬。", "en": "My teeth are small, and sharp."},
        {"zh": "被逼到墙角就麻烦了。", "en": "Being cornered would be bad."},
        {"zh": "我认准那条砖缝了。", "en": "I've picked out that brick gap."},
        {"zh": "这是我家，你走开。", "en": "This is my home. Leave."},
        {"zh": "我不怕，只是谨慎。", "en": "I am not afraid. Only careful."},
        {"zh": "你想抓我？", "en": "You mean to catch me?"},
        {"zh": "再近一点试试。", "en": "Try coming closer."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "花盆是我的小船。", "en": "A flower pot is my little boat."},
        {"zh": "你在左边，我走右边。", "en": "You left, I go right."},
        {"zh": "我数着退路。", "en": "I count my exits."},
        {"zh": "地上有缝，我记住了。", "en": "I have noted a crack."},
        {"zh": "你脚一动，我就跳。", "en": "When your foot moves, I jump."},
        {"zh": "我屏住气。", "en": "I hold my breath."},
        {"zh": "你的影子就是边界。", "en": "Your shadow is the boundary."},
        {"zh": "我不往空旷处跑。", "en": "I will not bolt into the open."},
        {"zh": "再等一秒。", "en": "One more second."},
        {"zh": "你转头的瞬间我走。", "en": "I move when you turn."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬了你的手指。", "en": "I bit your finger."},
        {"zh": "这一口很小。", "en": "A very small bite."},
        {"zh": "我抓了一下就逃。", "en": "I scratch once and flee."},
        {"zh": "我蹬了你的手背。", "en": "I kick the back of your hand."},
        {"zh": "我撞你的指甲。", "en": "I butt your fingernail."},
        {"zh": "我咬你的鞋面。", "en": "I bite your boot."},
        {"zh": "我已经跑掉了。", "en": "I am already gone."},
        {"zh": "我只是想活。", "en": "I only want to live."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从砖缝里钻出来。", "en": "I come out of a brick gap."},
        {"zh": "这片林子很好。", "en": "Good woodland here."},
        {"zh": "我先闻了闻风。", "en": "I test the wind first."},
        {"zh": "花盆在那儿，正好。", "en": "A flower pot. Perfect."},
        {"zh": "我抖了抖毛。", "en": "I shake out my fur."},
        {"zh": "这地方掉了很多籽。", "en": "Lots of fallen seeds here."},
        {"zh": "我贴着地走了一圈。", "en": "I circle low to the ground."},
        {"zh": "有人在这儿种花。", "en": "Someone gardens here."},
        {"zh": "我的窝离得不远。", "en": "My nest is not far."},
        {"zh": "我抬头，天很亮。", "en": "I look up. Bright day."},
        {"zh": "这里没有猫的味。", "en": "No cat scent here."},
        {"zh": "我小心地出来了。", "en": "I come out carefully."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把胡须都燎了。", "en": "Fire singes my whiskers."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一下就没过我头顶。", "en": "The water closes over my head."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被气浪吹得打了个滚。", "en": "The blast tumbles me along."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一颗小石子打中我。", "en": "A small stone strikes me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里连砖缝都没有。", "en": "Not even a brick gap here."}
      ]
    }
  }
