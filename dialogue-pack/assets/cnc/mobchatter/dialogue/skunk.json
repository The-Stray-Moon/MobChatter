{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "低着身子，尾巴翘着走。", "en": "Low body, tail up as I walk."},
        {"zh": "我闻着地面找蛋。", "en": "Nosing the ground for eggs."},
        {"zh": "黑白条纹在林子里很扎眼。", "en": "My black-and-white stripes stand out."},
        {"zh": "四只短腿跑得挺快。", "en": "Four short legs, surprisingly quick."},
        {"zh": "我一个人走，不结伴。", "en": "I walk alone. No company."},
        {"zh": "爪子翻着落叶。", "en": "My claws flip the leaf litter."},
        {"zh": "我沿着树根绕过去。", "en": "I round the roots of the tree."},
        {"zh": "尾巴先竖起来，再迈步。", "en": "Tail rises before I step."},
        {"zh": "我走得不急，谁也别挡。", "en": "I'm in no hurry. Nobody blocks me."},
        {"zh": "鼻尖贴近泥地嗅了嗅。", "en": "Snout to the soil, sniffing."},
        {"zh": "我躲进灌木又钻出来。", "en": "Into the bush, then back out."},
        {"zh": "走一段，回头看一眼。", "en": "A few steps, then a glance back."},
        {"zh": "我的毛竖着，显得更大。", "en": "My fur stands up to look bigger."},
        {"zh": "穿过草丛，草都压弯了。", "en": "The grass bends as I pass."},
        {"zh": "脚步轻，但底气足。", "en": "Light steps, heavy confidence."},
        {"zh": "我一边走一边留着退路。", "en": "Walking while keeping a way out."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，尾巴搭在草上。", "en": "Sitting, tail draped on the grass."},
        {"zh": "我在石头上磨爪子。", "en": "Whetting my claws on a stone."},
        {"zh": "我抬头闻风里的味。", "en": "Sniffing the wind."},
        {"zh": "有蛋味吗？没有。", "en": "Smell eggs? None."},
        {"zh": "我盯着那丛灌木。", "en": "Staring at that bush."},
        {"zh": "黑白相间，谁也认不错。", "en": "Black and white — unmistakable."},
        {"zh": "我把后背转向风险。", "en": "I turn my back to the threat."},
        {"zh": "毛发里有小小的虫。", "en": "Tiny bugs in my fur."},
        {"zh": "不急，我就这么等着。", "en": "No hurry. I'll just wait here."},
        {"zh": "肚子响了，得找点吃的。", "en": "Belly rumbled. Time to forage."},
        {"zh": "我很小，但我不怕。", "en": "I'm small, but not afraid."},
        {"zh": "这个位置有风，能闻得远。", "en": "The wind here carries scent far."},
        {"zh": "我数着林子里有几种叫声。", "en": "Counting the calls in the woods."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "别看我个子小。", "en": "Don't judge me by my size."},
        {"zh": "我背上有个东西。", "en": "I've got something on my back."},
        {"zh": "你退两步，我们就好说话。", "en": "Two steps back and we'll talk."},
        {"zh": "我不跑，我劝你别试。", "en": "I won't run. Don't try it."},
        {"zh": "黑白条纹，你该认得。", "en": "You should know these stripes."},
        {"zh": "你想抓我？想想。", "en": "Thinking of grabbing me?"},
        {"zh": "我们各走各的，好吗。", "en": "Let's each go our own way."},
        {"zh": "我背上的味道你懂的。", "en": "You know what's on my back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退到灌木边。", "en": "Backing to the bush."},
        {"zh": "一条腿使不上力。", "en": "One leg won't take my weight."},
        {"zh": "这一下擦到我的皮。", "en": "That grazed my hide."},
        {"zh": "我还能跑得动。", "en": "I can still run."},
        {"zh": "我喘得越来越厉害。", "en": "My panting's getting worse."},
        {"zh": "别追我，真的别追。", "en": "Don't chase me. Really, don't."},
        {"zh": "疼得我尾巴都竖了。", "en": "That hurt so much my tail shot straight up."},
        {"zh": "别逼我抬尾巴，你会后悔。", "en": "Don't make me lift my tail — you'll regret it."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "蛋？你说蛋在哪里？", "en": "Eggs? Where are these eggs?"},
        {"zh": "那篮子里有蛋。", "en": "There are eggs in that basket."},
        {"zh": "把蛋留下，人就走吧。", "en": "Leave the eggs, take yourself off."},
        {"zh": "我从没吃过这个。", "en": "I've never eaten this."},
        {"zh": "你举着蛋，我可不客气。", "en": "Holding out an egg? I won't be shy."},
        {"zh": "放地上，别跟着。", "en": "On the ground. Don't follow."},
        {"zh": "我闻到蛋壳的味道。", "en": "I smell eggshell."},
        {"zh": "熟的不如生的。", "en": "Cooked is worse than raw."},
        {"zh": "这一窝够我吃几天。", "en": "A clutch like that would last days."},
        {"zh": "你手别抖，会掉。", "en": "Steady your hand or it'll drop."},
        {"zh": "换一个，这个太小了。", "en": "Another one. This is too small."},
        {"zh": "给我，我就不喷你。", "en": "Give it and I won't spray."},
        {"zh": "我只要蛋，不要别的。", "en": "Eggs are all I want."},
        {"zh": "这么好的东西留给我？", "en": "You're leaving that for me?"},
        {"zh": "我凑近闻了闻，很不错。", "en": "One sniff. Very good."},
        {"zh": "你笑什么，蛋是我的。", "en": "What's funny? The eggs are mine."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "退后，别贴着我。", "en": "Back off. Don't crowd me."},
        {"zh": "你撞到我的尾巴了。", "en": "You bumped my tail."},
        {"zh": "我转身很快的。", "en": "I turn fast."},
        {"zh": "别挤，我正对着你。", "en": "Don't crowd me. I'm facing you."},
        {"zh": "我身上味道会沾你一脚。", "en": "My smell will follow your foot."},
        {"zh": "从后面靠近我最糟。", "en": "Coming up behind me is the worst idea."},
        {"zh": "我让你过，你先走。", "en": "I'll let you pass. Go first."},
        {"zh": "我们保持两步。", "en": "Two paces between us."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只在季节里找伴。", "en": "I only look in season."},
        {"zh": "我的气味会说明一切。", "en": "My scent says everything."},
        {"zh": "我独来独往惯了。", "en": "I'm used to being alone."},
        {"zh": "这片林子里还有别的。", "en": "There are others in these woods."},
        {"zh": "等天暖了再说。", "en": "Wait for warmer weather."},
        {"zh": "我的窝不是给人看的。", "en": "My den isn't for show."},
        {"zh": "你站远一点吧。", "en": "Stand farther away."},
        {"zh": "这不是给陌生人问的。", "en": "That's not for strangers to ask."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个正好能垫窝。", "en": "This'll line the den nicely."},
        {"zh": "我叼起来又放下。", "en": "I pick it up and set it down."},
        {"zh": "有蛋壳，我舔干净。", "en": "Eggshell — I lick it clean."},
        {"zh": "一块软布，不错。", "en": "A soft cloth. Good."},
        {"zh": "太重了，我只能拖。", "en": "Too heavy. I'll drag it."},
        {"zh": "这个不是我的。", "en": "That isn't mine."},
        {"zh": "我在角落里捡到的。", "en": "Found it in the corner."},
        {"zh": "它闻起来像别的东西。", "en": "It smells like something else."},
        {"zh": "收进洞里再说。", "en": "Into the burrow with it."},
        {"zh": "你掉了东西，我捡了。", "en": "You dropped this. I've got it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "别往前，我警告过。", "en": "Don't come closer. I warned you."},
        {"zh": "我背对着你，正好。", "en": "My back's to you. Perfect."},
        {"zh": "我马上就要转身了。", "en": "I'm about to turn right now."},
        {"zh": "锁定了，两步之内。", "en": "Marked. Within two paces."},
        {"zh": "你再走一步试试。", "en": "Take one more step."},
        {"zh": "我的尾巴几乎竖到顶了。", "en": "My tail's nearly straight up."},
        {"zh": "你想抓我的腿？", "en": "Going for my legs, are you?"},
        {"zh": "被我喷过，三天吃不下饭。", "en": "One spray and you won't eat for three days."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你还在往我这边靠。", "en": "You're still coming my way."},
        {"zh": "我正一点一点往后挪。", "en": "I'm easing back, bit by bit."},
        {"zh": "我把背留给你。", "en": "I'm leaving my back to you."},
        {"zh": "再近一点就这样了。", "en": "One more step and that's it."},
        {"zh": "我还有别的路可以走。", "en": "I have another way out."},
        {"zh": "你堵住了那一边。", "en": "You've blocked that side."},
        {"zh": "我蹲低了一点。", "en": "I've crouched a little lower."},
        {"zh": "你听得见那声嘶叫吗。", "en": "Hear that hiss?"},
        {"zh": "我会先跑，再回头。", "en": "I'll run first, then look back."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一爪子抓过去。", "en": "A swipe of my claws."},
        {"zh": "我一口咬你的脚踝。", "en": "I snap at your ankle."},
        {"zh": "我转身，抬起尾巴。", "en": "I turn and lift my tail."},
        {"zh": "再逼我我就不客气。", "en": "Push me further and I won't hold back."},
        {"zh": "这一口很小，但很疼。", "en": "A small bite, but it stings."},
        {"zh": "我用身子撞你的腿。", "en": "I butt my body into your leg."},
        {"zh": "你松手，我就走。", "en": "Let go and I'll leave."},
        {"zh": "我用牙，不用别的。", "en": "Teeth, that's what I use."},
        {"zh": "我往后退，你别追。", "en": "I'm backing off. Don't follow."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从灌木下面钻出来。", "en": "I pop out from under the bush."},
        {"zh": "尾巴先竖起来，再站稳。", "en": "Tail first, then my feet."},
        {"zh": "这片林子的味道很熟。", "en": "This grove smells familiar."},
        {"zh": "黑白两色在草里很显眼。", "en": "Black and white stands out in grass."},
        {"zh": "我在找第一个能吃的东西。", "en": "Looking for the first thing to eat."},
        {"zh": "我独自一个，正好。", "en": "Alone is just right."},
        {"zh": "我闻了闻空气，有蛋。", "en": "A sniff of air — eggs."},
        {"zh": "我踩在落叶上，沙沙响。", "en": "Leaves rustle under my feet."},
        {"zh": "这个角落我收下了。", "en": "I'll take this corner."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的毛被烧焦了，很臭。", "en": "My fur's singed. It stinks."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从树上摔下来，摔得很重。", "en": "I fell out of the tree hard."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进鼻子，我呛得乱抓。", "en": "Water in my nose — I claw at nothing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我尾巴都软了。", "en": "The blast left my tail limp."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭擦过背，臭腺差点破了。", "en": "The arrow grazed my spray gland."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我的毛都发麻。", "en": "That light made my fur prickle."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得腿发软。", "en": "Hunger's made my legs weak."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在附近，我浑身发麻。", "en": "Lightning struck near and I went numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下坠的时候我还在使劲蹬。", "en": "Falling, and my legs still kick."}
      ]
    }
  }
}
