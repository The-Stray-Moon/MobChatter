  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "炽焰围绕，震颤前行。", "en": "Flames surround, tremble forward."},
        {"zh": "石裂地裂，步步生辉。", "en": "Crack the earth, step by step."},
        {"zh": "炙热之躯，迈步向前。", "en": "Fiery form, step forward."},
        {"zh": "灼热之风，穿过岩层。", "en": "Hot wind, pierce the rock."},
        {"zh": "岩浆涌动，步伐坚定。", "en": "Lava flows, steps firm."},
        {"zh": "岩屑飞舞，勇者前行。", "en": "Rock dust flies, brave ahead."},
        {"zh": "火焰吞噬，无畏迈进。", "en": "Flame devours, fearless forward."},
        {"zh": "炽热之心，无尽燃烧。", "en": "Fiery heart, endless burn."},
        {"zh": "灼热之焰，熊熊燃烧。", "en": "Blazing flames, burn bright."},
        {"zh": "地裂轰鸣，烈焰前行。", "en": "Earth cracks, fiery advance."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "熔岩中驻足，静待猎物。", "en": "Stand in lava, await prey."},
        {"zh": "岩浆湖畔，耐心等待。", "en": "Lava lake, patient wait."},
        {"zh": "岩洞深处，沉思前行。", "en": "Deep cave, ponder forward."},
        {"zh": "熔岩之眼，凝视猎物。", "en": "Lava eye, stare prey."},
        {"zh": "炽焰围绕，静待时机。", "en": "Surrounded by flame, wait."},
        {"zh": "岩浆湖边，静静等候。", "en": "By lava lake, wait."},
        {"zh": "熔岩之源，静思未来。", "en": "Lava source, think ahead."},
        {"zh": "火焰环绕，静静守候。", "en": "Flames around, wait."},
        {"zh": "岩洞深处，静静等待。", "en": "Deep cave, wait."},
        {"zh": "熔岩之火，静待猎物。", "en": "Lava fire, await prey."},
        {"zh": "拳头上还挂着岩浆。", "en": "Lava still clings to my fists."},
        {"zh": "我在灰烬里碾了碾脚。", "en": "I grind my feet in the ash."},
        {"zh": "石碑上刻着三将军的名。", "en": "The stone bears the three generals' names."},
        {"zh": "余烬落在我肩上，很快又亮。", "en": "Embers land on my shoulder and flare again."},
        {"zh": "我在等下界领主的下令。", "en": "I await my Nether lord's command."},
        {"zh": "这一层岩壁薄得像纸。", "en": "This layer of rock is thin as paper."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "火眼金睛，锁定猎物。", "en": "Fiery eyes, target sighted."},
        {"zh": "岩浆之中，锁定玩家。", "en": "In lava, target player."},
        {"zh": "炽热目光，紧锁猎物。", "en": "Fiery gaze, target locked."},
        {"zh": "熔岩之中，锁定目标。", "en": "Lava midst, target in sight."},
        {"zh": "岩浆湖畔，锁定猎物。", "en": "Lava lake, target sighted."},
        {"zh": "炽焰环绕，锁定猎物。", "en": "Flames around, target sighted."},
        {"zh": "熔岩之火，锁定玩家。", "en": "Lava flames, target player."},
        {"zh": "炽热目光，盯紧猎物。", "en": "Fiery gaze, fix on prey."},
        {"zh": "熔岩之中，玩家入眼。", "en": "Player in lava sight."},
        {"zh": "岩浆环绕，玩家入眼。", "en": "Lava surrounds, player sighted."},
        {"zh": "你身上的铁味太淡了。", "en": "The iron in your blood smells faint."},
        {"zh": "我低头，是你在那儿。", "en": "I look down: there you are."}
