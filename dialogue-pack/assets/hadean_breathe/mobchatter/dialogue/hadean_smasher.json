    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "炽焰噬骨，我忍不了！", "en": "Burning bones, this is too much!"},
        {"zh": "碎石之怒，将我击溃！", "en": "Anger of the rocks, crush me!"},
        {"zh": "碎裂之光，噬我吧！", "en": "Shattering light, consume me!"},
        {"zh": "岩浆之焰，烙我心！", "en": "Lava’s flame, burn my soul!"},
        {"zh": "岩屑风暴，困我魂！", "en": "Rock dust storm, trap my spirit!"},
        {"zh": "地裂之击，裂我心！", "en": "Earthquake, rend my heart!"},
        {"zh": "岩核之怒，灼我肉！", "en": "Core’s rage, burn my flesh!"},
        {"zh": "岩浆洪流，灌我心！", "en": "Lava flood, drown my soul!"},
        {"zh": "岩屑尘暴，埋我骨！", "en": "Rock dust hurricane, bury my bones!"},
        {"zh": "碎石之锤，砸我肉！", "en": "Rock hammer, crush my flesh!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰在我的骨髓燃烧！", "en": "Fire burns in my marrow!"},
        {"zh": "你退后的脚步，震得黑石响。", "en": "Your retreating steps ring on the blackstone."},
        {"zh": "你手里的食物，烤得真香。", "en": "The food in your hand smells well roasted."},
        {"zh": "我的爪子能碾碎一切！", "en": "My claws crush all!"},
        {"zh": "我这块头，卡不住这扇门。", "en": "A body my size can't fit through this door."},
        {"zh": "黑暗之力，我的伙伴！", "en": "Darkness, my ally!"},
        {"zh": "用我的力量，吞噬灵魂！", "en": "Use my power, devour souls!"},
        {"zh": "你注定要为我服务！", "en": "You're destined to serve me!"},
        {"zh": "我的力量，无人能挡！", "en": "My strength, unmatched!"},
        {"zh": "残部未灭，我仍在这儿！", "en": "The remnant is not gone, I am still here!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们之间只能有一个活下来！", "en": "Only one of us survives!"},
        {"zh": "我这副身躯是下界铸的。", "en": "This body was forged in the Nether."},
        {"zh": "我们即将碰撞，你准备好了吗？", "en": "Collision imminent, are you ready?"},
        {"zh": "我的冲击，粉碎一切！", "en": "My impact, shatters all!"},
        {"zh": "迎接我的力量吧！", "en": "Face my power!"},
        {"zh": "我抬脚，脚下的黑石裂了。", "en": "I lift my foot; the blackstone cracks."},
        {"zh": "我们来一场生死对决！", "en": "A fight to the death!"},
        {"zh": "我的冲击波将你摧毁！", "en": "My shockwave destroys you!"},
        {"zh": "我是不可阻挡的！", "en": "I am unstoppable!"},
        {"zh": "我的力量超越了物理！", "en": "My strength defies physics!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的雌雄双生，来吧！", "en": "My gendered mate, come!"},
        {"zh": "让我们的力量结合！", "en": "Our powers unite!"},
        {"zh": "我这块头，只有你敢靠近。", "en": "Only you dare come near my size."},
        {"zh": "我们的结合，无敌！", "en": "Our union, invincible!"},
        {"zh": "与我共生，成为一体！", "en": "Be one with me!"},
        {"zh": "我们是不死之灵！", "en": "We are the undying!"},
        {"zh": "我们的结合，超越一切！", "en": "Our union, surpasses all!"},
        {"zh": "与我交配，成为传奇！", "en": "Mate with me, become legendary!"},
        {"zh": "我们的力量将统治世界！", "en": "Our power will rule the world!"},
        {"zh": "我的另一半，也在下界等我。", "en": "My other half waits for me in the Nether too."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "炽焰环绕，噬魂而来。", "en": "Radiant flames, soul-snatching."},
        {"zh": "炙热之躯，无惧寒冷。", "en": "Burns through cold, fiery form."},
        {"zh": "深渊怒吼，炽魂悍将。", "en": "Doom's roar, Hadean Smasher."},
        {"zh": "黑暗之中，我为光明。", "en": "Darkness crumbles, I am light."},
        {"zh": "火焰之魂，永不熄灭。", "en": "Flame soul, never fades."},
        {"zh": "炽热之焰，吞噬一切。", "en": "Scorching flames, consume all."},
        {"zh": "炽魂悍将，怒火中烧。", "en": "Fury burns, Hadean Smasher."},
        {"zh": "深渊之下，我为烈焰。", "en": "From the depths, I am flame."},
        {"zh": "炽热之心，无惧挑战。", "en": "Burn with challenge, fearless."},
        {"zh": "烈焰风暴，席卷天地。", "en": "Storm of flames, earth and sky."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "炽焰将你包围。", "en": "Fiery flames encircle you."},
        {"zh": "我来收割你的灵魂。", "en": "Harvest your soul now."},
        {"zh": "炽魂悍将，目标锁定。", "en": "Target locked, Hadean Smasher."},
        {"zh": "深渊之怒，炽焰怒火。", "en": "Doom's wrath, fiery rage."},
        {"zh": "你是我的猎物，灵魂。", "en": "Your soul, my prey now."},
        {"zh": "炽热之焰，撕裂你的灵魂。", "en": "Scorching flames, rip your soul."},
        {"zh": "深渊怒吼，目标已锁定。", "en": "Target locked, doom's roar."},
        {"zh": "炽魂悍将，目标就位。", "en": "Target ready, Hadean Smasher."},
        {"zh": "黑暗中，我看见你的灵魂。", "en": "In darkness, your soul glows."},
        {"zh": "炽焰将你包围，灵魂。", "en": "Fiery flames encircle you, soul."},
        {"zh": "将军的余威，先给你一点。", "en": "A token of a general's remnant wrath."},
        {"zh": "你踩到的地，归我捶。", "en": "The ground you tread is mine to crush."},
        {"zh": "我在下界就闻到你。", "en": "I smelled you back in the Nether."},
        {"zh": "封印松了，正好拿你试手。", "en": "The seal is loose. You will do as a test."},
        {"zh": "别跑，我腿不长但拳快。", "en": "Do not run. My legs are short, my fists are not."},
        {"zh": "灰里冒出个活物。", "en": "Something living came out of the ash."},
        {"zh": "你把我的祭坛吵醒了。", "en": "You woke my altar."},
        {"zh": "这具躯体还没散架。", "en": "This body has not yet fallen apart."}
      ]
    },
