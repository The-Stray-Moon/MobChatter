        {"zh": "我的存在就是火焰！", "en": "My being is flame!"},
        {"zh": "火焰环绕我的四周！", "en": "Flames surround me!"},
        {"zh": "我守护着这里的秘密！", "en": "I guard this secret!"},
        {"zh": "火焰之光指引我！", "en": "Flame's light guides me!"},
        {"zh": "我等待着你的到来！", "en": "I wait for you to come!"},
        {"zh": "火焰是我不灭的象征！", "en": "Flame is my eternal symbol!"},
        {"zh": "火焰之魂在燃烧！", "en": "Flame's soul burns!"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你触动了我的警觉！", "en": "You've triggered my alert!"},
        {"zh": "你出现在我的视野里！", "en": "You appear in my sight!"},
        {"zh": "你的存在威胁到我！", "en": "Your presence threatens me!"},
        {"zh": "你不能打扰我的警戒！", "en": "You cannot disturb my vigil!"},
        {"zh": "我注视着你！", "en": "I watch you!"},
        {"zh": "激光已经充能一半了。", "en": "The laser is half charged."},
        {"zh": "你的动作引起我的注意！", "en": "Your movements catch my attention!"},
        {"zh": "我要守护我的领地！", "en": "I must protect my domain!"},
        {"zh": "你已经进入我的领地！", "en": "You've entered my domain!"},
        {"zh": "你的动作威胁到我！", "en": "Your actions threaten me!"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "盔甲的缝里又窜出火。", "en": "Flame licks out through the seams of my armor."},
        {"zh": "身体被火焰吞噬了。", "en": "My body is consumed by flames."},
