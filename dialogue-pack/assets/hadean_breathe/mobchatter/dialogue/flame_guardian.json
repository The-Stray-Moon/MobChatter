{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "熔岩沟边，我的脚步留下焦痕。", "en": "Along the lava trench, my steps leave scorch marks."},
        {"zh": "我的战靴碾过还冒着火星。", "en": "My boots grind over glowing embers."},
        {"zh": "我在守护我的领域！", "en": "I guard my domain!"},
        {"zh": "火光是我的武器！", "en": "Firelight is my weapon!"},
        {"zh": "火焰之息，毁灭之歌！", "en": "Flame breath, song of destruction!"},
        {"zh": "我用火焰标记你！", "en": "I mark you with flame!"},
        {"zh": "炙热是我的守护！", "en": "Heat is my protection!"},
        {"zh": "火焰的意志在指引我！", "en": "Flame's will guides me!"},
        {"zh": "熔炉中的熔渣！", "en": "Scum of the furnace!"},
        {"zh": "烈焰守护者的火焰！", "en": "Flame Guardian's flames!"},
        {"zh": "熔渣从我脚边滚落！", "en": "Slag crumbles from my feet!"},
        {"zh": "我沿着熔岩沟巡视！", "en": "I patrol along the lava trench!"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰在我的脚下燃烧！", "en": "Flames burn beneath me!"},
