    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰缭绕的身躯向前行进。", "en": "Flames swirl around its body as it moves."},
        {"zh": "灼热的呼吸在身后留下痕迹。", "en": "Hot breath leaves a trail behind."},
        {"zh": "炽热的双翼扇动着前行。", "en": "Searing wings flap forward."},
        {"zh": "幽灵般的脚步在熔岩上无声。", "en": "Phantom steps echo on the lava."},
        {"zh": "熔岩中燃烧的火焰吞噬着空气。", "en": "Lava flames consume the air with their heat."},
        {"zh": "飘忽不定的火球在地面上滚动。", "en": "Fireballs roll across the ground."},
        {"zh": "炽热的眼神扫视着四周。", "en": "Searing eyes scan the surroundings."},
        {"zh": "熔岩中游荡的幽魂缓缓前行。", "en": "Ghast ghostly glides in the lava."},
        {"zh": "火焰在它的身体上跳跃。", "en": "Flames leap on its body."},
        {"zh": "熔岩的热度让它不断前行。", "en": "Heat from lava propels it forward."},
        {"zh": "它飘过熔岩，带起一阵火。", "en": "It drifts over the lava trailing fire."},
        {"zh": "触须垂着，末端滴着火。", "en": "Its tentacles hang, dripping flame."}
      ]
    },
