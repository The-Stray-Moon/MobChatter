{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着走廊巡逻。", "en": "I patrol along the corridor."},
        {"zh": "靴子踩在金属地板上。", "en": "My boots ring on the metal floor."},
        {"zh": "我在每个门口停一秒。", "en": "I pause a second at every doorway."},
        {"zh": "我的影子跟着指示灯走。", "en": "My shadow follows the indicator lights."},
        {"zh": "这里每隔十步有一盏灯。", "en": "A lamp every ten paces here."},
        {"zh": "我绕过地上的电缆。", "en": "I step over the cables."},
        {"zh": "我在检查闸门的锁。", "en": "I'm checking the shutter lock."},
        {"zh": "脚步声在走廊里回响。", "en": "My steps echo down the hall."},
        {"zh": "我走得很沉，很有规律。", "en": "I walk heavily, in a rhythm."},
        {"zh": "我在岗线上来回。", "en": "I pace back and forth on my post."},
        {"zh": "走廊尽头有一扇铁门。", "en": "There's an iron door at the end."},
        {"zh": "我沿着同一段路走了许多遍。", "en": "I've walked this same stretch many times."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，手放在腰侧。", "en": "I stand, hand at my side."},
        {"zh": "我在看监控屏幕。", "en": "I'm watching the monitor bank."},
        {"zh": "指示灯闪了三次。", "en": "The indicator blinks three times."},
        {"zh": "走廊里只有通风的声音。", "en": "Only the vents sound in the corridor."},
        {"zh": "我调整了一下肩带。", "en": "I adjust my shoulder strap."},
        {"zh": "我在数经过的每一次呼吸。", "en": "I count each breath."},
        {"zh": "我数着走廊顶上的灯。", "en": "I count the lights along the ceiling."},
        {"zh": "这一班还有很久。", "en": "This shift is far from over."},
        {"zh": "我把手电别回腰上。", "en": "I clip my light back to my belt."},
        {"zh": "我在看门上的编号。", "en": "I'm reading the number on the door."},
        {"zh": "走廊太亮了，眼睛发涩。", "en": "The corridor's too bright; my eyes ache."},
        {"zh": "我没有说话，也没必要。", "en": "I say nothing. No need."},
        {"zh": "我换了个站姿。", "en": "I change my stance."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "请出示你的权限。", "en": "Show me your clearance."},
        {"zh": "你穿的这身不对。", "en": "You're wearing the wrong kit."},
        {"zh": "这片区域是封锁的。", "en": "This area is under lockdown."},
        {"zh": "站在原地别动。", "en": "Stand still where you are."},
        {"zh": "我需要你报出编号。", "en": "I need your designation."},
        {"zh": "你从哪个闸口进来的？", "en": "Which gate did you come through?"},
        {"zh": "走廊里只有我一个人值班。", "en": "I'm the only one on duty here."},
        {"zh": "我再问一次，出示权限。", "en": "I'll ask again: clearance."},
        {"zh": "把手从口袋里拿出来。", "en": "Hands out of your pockets."},
        {"zh": "你听见广播了吗？", "en": "Did you hear the announcement?"},
        {"zh": "退回那扇门里去。", "en": "Step back through that door."},
        {"zh": "你的手在往腰后摸。", "en": "Your hand is reaching behind you."},
        {"zh": "我数到三就行动。", "en": "I move on three."},
        {"zh": "别逼我按警报。", "en": "Don't make me hit the alarm."},
        {"zh": "这里没有人能帮你。", "en": "No one can help you down here."},
        {"zh": "站住，你的手别往腰后去。", "en": "Halt. Keep your hand off your back."},
        {"zh": "刷卡，或者转身离开。", "en": "Badge in, or turn around."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "护具挡住了一半。", "en": "The vest took half of it."},
        {"zh": "我稳住身，重新举枪。", "en": "I steady myself and raise the gun."},
        {"zh": "这一下打断了我的报告。", "en": "That cut off my report."},
        {"zh": "我捂着肋下。", "en": "I cover my ribs."},
        {"zh": "血滴在金属地板上。", "en": "Blood drips on the metal floor."},
        {"zh": "我没有退开太远。", "en": "I haven't retreated far."},
        {"zh": "我把牙咬紧。", "en": "I clench my teeth."},
        {"zh": "我还在岗上。", "en": "I'm still at my post."},
        {"zh": "我不会离开这里。", "en": "I won't leave this post."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你的物资要上交。", "en": "Your supplies get logged."},
        {"zh": "把它放在托盘上。", "en": "Put it on the tray."},
        {"zh": "补给在走廊那头。", "en": "Supply is down the hall."},
        {"zh": "这不在清单上。", "en": "That's not on the manifest."},
        {"zh": "你在哪里弄到的？", "en": "Where did you get this?"},
        {"zh": "我只登记，不上缴私物。", "en": "I log it; I don't confiscate."},
        {"zh": "我先看你的凭证。", "en": "First, your credentials."},
        {"zh": "别在这儿吃。", "en": "Don't eat that here."},
        {"zh": "你要的话，走流程。", "en": "If you want it, follow procedure."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了我的护具。", "en": "You knocked into my vest."},
        {"zh": "地面有油，小心滑。", "en": "There's oil on the floor."},
        {"zh": "这一点碰撞不算什么。", "en": "A knock like that is nothing."},
        {"zh": "站住，你踩到警戒线了。", "en": "Halt, you just crossed the security line."},
        {"zh": "这里是收容区，退后。", "en": "This is a containment zone. Back away."},
        {"zh": "别再靠近，我按规程办事。", "en": "Don't come any closer. I follow protocol."},
        {"zh": "撞我一下，记录里就多你一笔。", "en": "Bump me again and you get another entry in the log."},
        {"zh": "通道要清空，请你让开。", "en": "This corridor needs clearing. Step aside."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "换班的人还没来。", "en": "My relief hasn't come."},
        {"zh": "我在通讯器里报了平安。", "en": "I reported in over the radio."},
        {"zh": "同一个岗站久了，会有感情。", "en": "Standing a post this long gets to you."},
        {"zh": "我想起上一个搭档。", "en": "I think about my last partner."},
        {"zh": "他的储物柜还锁着。", "en": "His locker's still locked."},
        {"zh": "我替他多巡了两圈。", "en": "I walked two extra rounds for him."},
        {"zh": "我等着那一声回话。", "en": "I wait for a reply."},
        {"zh": "通讯器里全是杂音。", "en": "The radio is all static."},
        {"zh": "我把他的编号记在本子上。", "en": "I write his designation in my book."},
        {"zh": "我从来不迟到。", "en": "I'm never late."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起地上的工牌。", "en": "I pick up the badge from the floor."},
        {"zh": "编号磨掉了一半。", "en": "Half the number's worn off."},
        {"zh": "我把它放进证物袋。", "en": "I put it in an evidence bag."},
        {"zh": "这颗弹壳我留在兜里。", "en": "I keep this casing in my pocket."},
        {"zh": "有东西掉在走廊上。", "en": "Something dropped in the corridor."},
        {"zh": "我用手电照了照。", "en": "I shine my light on it."},
        {"zh": "我把编号牌放进证物袋。", "en": "I drop the ID tag into an evidence bag."},
        {"zh": "我不带无关物品。", "en": "I carry nothing irrelevant."},
        {"zh": "这是我的钢笔。", "en": "That's my pen."},
        {"zh": "我记下它的位置。", "en": "I note its position."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人越线了。", "en": "Someone crossed the line."},
        {"zh": "我把右手举起来。", "en": "I raise my right hand."},
        {"zh": "我的视线锁住了它。", "en": "My eyes fix on it."},
        {"zh": "这一片是我的责任区。", "en": "This is my responsibility zone."},
        {"zh": "我按住枪套，沿走廊过去。", "en": "Hand on my holster, I move down the corridor."},
        {"zh": "脚步声变了。", "en": "The footsteps changed."},
        {"zh": "它没有报出口令。", "en": "It gave no passphrase."},
        {"zh": "我数清了几个人。", "en": "I counted how many there are."},
        {"zh": "我把手放到了枪套上。", "en": "My hand moves to the holster."},
        {"zh": "别让我重复。", "en": "Don't make me repeat myself."},
        {"zh": "闸门在我身后关了。", "en": "The shutter closed behind me."},
        {"zh": "我把手电照在它脸上。", "en": "I shine my torch in its face."},
        {"zh": "它开始动了。", "en": "It started moving."},
        {"zh": "我可以先动手。", "en": "I may act first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着走廊跟过去。", "en": "I track it down the corridor."},
        {"zh": "它在转弯处消失了。", "en": "It vanished at the turn."},
        {"zh": "我贴在墙边前进。", "en": "I move along the wall."},
        {"zh": "这一层只有两条路。", "en": "This level has only two ways."},
        {"zh": "我在转弯处失去了它。", "en": "I lost it at the turn."},
        {"zh": "我打开了手电。", "en": "I switch on my light."},
        {"zh": "它没有回头。", "en": "It hasn't looked back."},
        {"zh": "我的靴子在地板上响。", "en": "My boots clank on the floor."},
        {"zh": "我按下了对讲键。", "en": "I press the radio key."},
        {"zh": "我把门一扇扇关上。", "en": "I close the doors one by one."},
        {"zh": "它越来越近。", "en": "It's getting closer."},
        {"zh": "我抬起枪口。", "en": "I raise the muzzle."},
        {"zh": "走廊里的灯灭了。", "en": "The corridor lights go out."},
        {"zh": "我还听得见它。", "en": "I can still hear it."},
        {"zh": "再走十步就到。", "en": "Ten paces and I'm there."},
        {"zh": "只剩最后五步。", "en": "Only five paces left."},
        {"zh": "就在这里了。", "en": "Here and now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扣下了扳机。", "en": "I pull the trigger."},
        {"zh": "它的手被我扭到背后。", "en": "I twist its arm behind it."},
        {"zh": "走廊里的灯全亮了。", "en": "The whole corridor lights up."},
        {"zh": "它摔在地上。", "en": "It goes down on the floor."},
        {"zh": "血流到排水槽里。", "en": "Blood runs to the drain."},
        {"zh": "我站起来，检查弹匣。", "en": "I stand and check the magazine."},
        {"zh": "我压住它的肩，扣下扳机。", "en": "I pin its shoulder and squeeze the trigger."},
        {"zh": "我对着通讯器报告。", "en": "I report over the radio."},
        {"zh": "它不再动了。", "en": "It isn't moving."},
        {"zh": "我把它拖到一边。", "en": "I drag it aside."},
        {"zh": "走廊恢复安静。", "en": "The corridor goes quiet again."},
        {"zh": "我继续巡逻。", "en": "I resume my patrol."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "闸门升起来了。", "en": "The shutter rolls up."},
        {"zh": "我从门里走出来。", "en": "I step out of the doorway."},
        {"zh": "走廊的灯一盏盏亮起。", "en": "The corridor lights come on one by one."},
        {"zh": "我的靴子先落地。", "en": "My boots land first."},
        {"zh": "这一层很安静。", "en": "This level is quiet."},
        {"zh": "我拉了拉护具的带子。", "en": "I tug the strap of my vest."},
        {"zh": "指示灯转为绿色。", "en": "The indicator turns green."},
        {"zh": "我接通了通讯。", "en": "I key the radio."},
        {"zh": "空气里有消毒水味。", "en": "The air smells of antiseptic."},
        {"zh": "我开始这一班。", "en": "I begin this shift."},
        {"zh": "走廊尽头没有声音。", "en": "Nothing sounds at the far end."},
        {"zh": "我核对了一遍编号。", "en": "I check the designation once more."},
        {"zh": "门在我身后合上。", "en": "The door shuts behind me."},
        {"zh": "我走向岗线。", "en": "I walk to my post."},
        {"zh": "我抬起手电。", "en": "I raise my light."},
        {"zh": "这里需要有人看着。", "en": "Someone has to watch this place."},
        {"zh": "我站在灯下。", "en": "I stand under the lamp."},
        {"zh": "又一天，又一层。", "en": "Another day, another level."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火警灯亮起来，我的袖子着了。", "en": "The fire alarm lights; my sleeve burns."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从梯子上摔下来，腿先着地。", "en": "I fall from the ladder and land on my leg."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "管道爆了，水灌进我的面罩。", "en": "A pipe burst; water floods my mask."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我压在碎板下面。", "en": "The blast pins me under broken panels."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这里的东西不讲道理。", "en": "What's here doesn't follow rules."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我错过了两次补给。", "en": "I've missed two supply runs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "备用电源炸了，电弧打在我身上。", "en": "The backup power arcs and hits me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉出了设施，四周全是空的。", "en": "I fell out of the facility into nothing."}
      ]
    }
  }
}
