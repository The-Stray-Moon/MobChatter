{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我比老鼠更大，步子更长。", "en": "I'm bigger than a mouse, longer in stride."},
        {"zh": "我从废料堆里钻出来。", "en": "I come out of the scrap heap."},
        {"zh": "我的尾巴在地上拖出湿痕。", "en": "My tail drags a wet line."},
        {"zh": "我沿着管线的阴影走。", "en": "I walk along the shadow of the pipes."},
        {"zh": "我的鼻子贴着地面。", "en": "My nose keeps to the ground."},
        {"zh": "我走得稳，不慌。", "en": "I walk steadily, unafraid."},
        {"zh": "我挤过一道铁栅栏。", "en": "I squeeze through an iron grate."},
        {"zh": "我在垃圾箱边上转。", "en": "I circle the waste bin."},
        {"zh": "我的爪子咔嗒作响。", "en": "My claws click as I go."},
        {"zh": "我绕过一处漏液。", "en": "I skirt a chemical spill."},
        {"zh": "我在找能咬开的东西。", "en": "I'm looking for something to gnaw."},
        {"zh": "我从闸门下面钻过去。", "en": "I slip under the shutter."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，胡须在抖。", "en": "I sit, whiskers twitching."},
        {"zh": "我在咬一段电线。", "en": "I'm chewing a cable."},
        {"zh": "走廊里只有滴水。", "en": "Only dripping in the corridor."},
        {"zh": "我把身子贴在地上。", "en": "I flatten myself to the floor."},
        {"zh": "我在听管道里的动静。", "en": "I listen to the pipes."},
        {"zh": "我朝暗的地方看。", "en": "I look toward the dark."},
        {"zh": "我的背拱起来。", "en": "My back arches."},
        {"zh": "我在磨我的牙。", "en": "I'm grinding my teeth."},
        {"zh": "有一滴液体落在我旁边。", "en": "A drop falls beside me."},
        {"zh": "我在管子底下，慢慢转脸。", "en": "Under the pipes, I turn my face slowly."},
        {"zh": "这个角落是我的。", "en": "This corner is mine."},
        {"zh": "人我不放在眼里。", "en": "People don't scare me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的靴子横在我和洞口之间。", "en": "Your boot lies between me and my burrow."},
        {"zh": "你的靴子上有味道。", "en": "There's a smell on your boot."},
        {"zh": "我们这一窝在这里很久了。", "en": "My brood has been here a long while."},
        {"zh": "你抬脚的时候我看见了。", "en": "I saw when you lifted your foot."},
        {"zh": "我的牙能咬穿电线。", "en": "My teeth go through cable."},
        {"zh": "你最好别蹲下来。", "en": "Best you don't crouch."},
        {"zh": "我闻到你的口袋里。", "en": "I can smell inside your pockets."},
        {"zh": "这里的地盘是我们的。", "en": "This territory is ours."},
        {"zh": "我不怕你的手。", "en": "Your hands don't frighten me."},
        {"zh": "你退开，我们就算了。", "en": "Step back and we'll leave it."},
        {"zh": "我数了数你有几只脚。", "en": "I counted how many feet you have."},
        {"zh": "这道栅栏挡不住我。", "en": "That grate won't keep me out."},
        {"zh": "你的灯照不到角落。", "en": "Your lamp doesn't reach the corners."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我龇着牙退开。", "en": "I bare my teeth and back off."},
        {"zh": "我的腿在抖，但没跪。", "en": "My legs shake but don't buckle."},
        {"zh": "我贴着墙缓了一下。", "en": "I rest against the wall."},
        {"zh": "我的耳朵被压平了。", "en": "My ears lie flat."},
        {"zh": "血从我鼻尖滴下来。", "en": "Blood drips from my nose."},
        {"zh": "我龇着牙看你。", "en": "I bare my teeth at you."},
        {"zh": "我不会跑远。", "en": "I won't go far."},
        {"zh": "这一口我记着。", "en": "I'll remember this."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块东西归我。", "en": "That belongs to me."},
        {"zh": "你放手，我咬一口。", "en": "Let go and I'll take a bite."},
        {"zh": "干粮的味道。", "en": "That's dried food."},
        {"zh": "我一点都不挑。", "en": "I'm not picky at all."},
        {"zh": "我出来了，别动。", "en": "I'm coming out; don't move."},
        {"zh": "你把它扔过来。", "en": "Throw it over to me."},
        {"zh": "这比电线好。", "en": "Better than cable."},
        {"zh": "我全叼走了。", "en": "I'll take the lot."},
        {"zh": "你手指之间有缝。", "en": "There's a gap in your fingers."},
        {"zh": "血腥味从你指缝里渗出来。", "en": "Blood smell leaks from between your fingers."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的靴底压到我的尾。", "en": "Your sole pressed my tail."},
        {"zh": "我一下转身咬过去。", "en": "I spin and snap."},
        {"zh": "我被撞得侧了身子。", "en": "The knock turns me sideways."},
        {"zh": "地面上的液体让我们都滑。", "en": "The spill slides us both."},
        {"zh": "我很快就站稳了。", "en": "I'm steady again quickly."},
        {"zh": "你撞到的是铁皮。", "en": "That was sheet metal you hit."},
        {"zh": "我从你两脚之间穿过。", "en": "I pass between your feet."},
        {"zh": "这事不算完。", "en": "This isn't over."},
        {"zh": "我的尾巴被你靴底压扁了。", "en": "Your boot sole flattened my tail."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只从管子里出来。", "en": "Another comes out of the pipe."},
        {"zh": "她比我瘦，牙更长。", "en": "She's thinner, with longer teeth."},
        {"zh": "我们碰了碰鼻子。", "en": "We touch noses."},
        {"zh": "我把咬开的东西分给她。", "en": "I share what I've gnawed open."},
        {"zh": "我们一起在墙角挤着。", "en": "We crowd into the wall corner."},
        {"zh": "她的尾巴缠住我的。", "en": "Her tail twines with mine."},
        {"zh": "窝里有几只小的。", "en": "There are small ones in the nest."},
        {"zh": "她先吃，我看着。", "en": "She eats first; I watch."},
        {"zh": "她低低吱了一下。", "en": "She squeaks, low."},
        {"zh": "我们一起钻进管子。", "en": "We go into the pipe together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住一块干粮。", "en": "I take a piece of dried food."},
        {"zh": "我用门牙啃下一角铁皮。", "en": "I gnaw a corner off the tin with my incisors."},
        {"zh": "我用牙磨开了它。", "en": "I work it open with my teeth."},
        {"zh": "它在我嘴里响。", "en": "It rattles in my mouth."},
        {"zh": "我把线拖走了。", "en": "I drag the wire away."},
        {"zh": "这个能垫窝。", "en": "This will line the nest."},
        {"zh": "它带着药味。", "en": "It smells of chemicals."},
        {"zh": "太苦，我吐了。", "en": "Too bitter; I spat it."},
        {"zh": "我把它藏在铁皮后面。", "en": "I hide it behind sheet metal."},
        {"zh": "我叼着跑了几步。", "en": "I run a few steps with it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我在墙后面停住。", "en": "I stop behind the wall."},
        {"zh": "我的牙露了出来。", "en": "My teeth show."},
        {"zh": "这家伙落单了。", "en": "This one's alone."},
        {"zh": "我贴着地面过去。", "en": "I go along the floor."},
        {"zh": "我压得很低。", "en": "I keep very low."},
        {"zh": "我们这一窝都在。", "en": "My brood is all here."},
        {"zh": "我先动的身。", "en": "I made the first move."},
        {"zh": "它转过身来了。", "en": "It turned around."},
        {"zh": "来得正是时候。", "en": "Just in time."},
        {"zh": "我现在就上。", "en": "I go now."},
        {"zh": "它退到死角。", "en": "It's backed into a corner."},
        {"zh": "墙角没有洞，你进不去。", "en": "There is no hole in the corner; you cannot fit."},
        {"zh": "我跑得更急了。", "en": "I break into a run."},
        {"zh": "它耳朵动了。", "en": "Its ear moved."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着铁皮缝跟。", "en": "I follow along the metal seams."},
        {"zh": "我的爪子在地上响。", "en": "My claws sound on the floor."},
        {"zh": "它在往管道那边去。", "en": "It's heading for the pipes."},
        {"zh": "我先绕过去。", "en": "I'll get there first."},
        {"zh": "我闻着它的味道。", "en": "I follow its smell."},
        {"zh": "它在门后面停住。", "en": "It stopped behind the door."},
        {"zh": "我在门缝下面。", "en": "I'm under the door gap."},
        {"zh": "它还没注意到。", "en": "It hasn't noticed."},
        {"zh": "我的同伴在另一头。", "en": "My brood is at the other end."},
        {"zh": "两边都堵住了。", "en": "Both ends are blocked."},
        {"zh": "我也快起来。", "en": "I speed up too."},
        {"zh": "铁皮被我撞得响。", "en": "I rattle the sheet metal."},
        {"zh": "只隔着一根管子。", "en": "Only one pipe between us."},
        {"zh": "它跳到箱子上了。", "en": "It jumped onto a crate."},
        {"zh": "我也能上去。", "en": "I can get up there too."},
        {"zh": "它贴着铁皮跑，气越来越急。", "en": "It runs along the tin, breathing harder."},
        {"zh": "我咬住了它。", "en": "I've bitten it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我这么小，尾巴倒是很长。", "en": "Small as I am, my tail runs long."},
        {"zh": "它蹬了一下，我咬得更紧。", "en": "It kicks; I bite harder."},
        {"zh": "我的牙刮过它的皮。", "en": "My teeth rake its skin."},
        {"zh": "它撞在铁皮上。", "en": "It hits the sheet metal."},
        {"zh": "我退开，喘着。", "en": "I pull back, panting."},
        {"zh": "我又冲了上去。", "en": "I charge in again."},
        {"zh": "这一下咬到了骨头。", "en": "That one hit bone."},
        {"zh": "它把我甩开。", "en": "It throws me off."},
        {"zh": "我在地上翻了一圈。", "en": "I roll once on the floor."},
        {"zh": "我很快又站起来。", "en": "I'm up again quickly."},
        {"zh": "血在地上拖出一条线。", "en": "Blood trails across the floor."},
        {"zh": "同伴从另一边来了。", "en": "The brood comes from the other side."},
        {"zh": "它没地方跑了。", "en": "It's run out of room."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "排水口里探出一个头。", "en": "A head appears in the drain."},
        {"zh": "我从铁栅栏后面出来。", "en": "I come from behind the grate."},
        {"zh": "这一层有很多味道。", "en": "This level is full of smells."},
        {"zh": "我的尾巴扫了一下地。", "en": "My tail sweeps the floor."},
        {"zh": "空气里全是药味。", "en": "The air is all chemicals."},
        {"zh": "我沿着墙根开始走。", "en": "I start along the wall's base."},
        {"zh": "这里有别人的味道。", "en": "Others have been here."},
        {"zh": "我找到了一个角落。", "en": "I've found a corner."},
        {"zh": "我开始磨牙。", "en": "I start grinding my teeth."},
        {"zh": "我慢慢来就好。", "en": "I'll take my time."},
        {"zh": "我先闻了闻地板。", "en": "I sniff the floor first."},
        {"zh": "同伴还在管道里。", "en": "My brood is still in the pipe."},
        {"zh": "我在这里等它们。", "en": "I wait for them here."},
        {"zh": "灯亮了，很刺眼。", "en": "The lights come on, stinging."},
        {"zh": "然后我又出来了。", "en": "Then I come out again."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我的毛全焦了。", "en": "Fire singes all my fur."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从管道上摔下来，摔得发懵。", "en": "I fall from the pipe, dazed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌满了我的鼻子。", "en": "Water fills my nose."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我甩到管子上。", "en": "The blast throws me against a pipe."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物扎穿了我的耳朵。", "en": "Something sharp goes through my ear."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我的牙发麻。", "en": "That light numbs my teeth."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得咬不动了。", "en": "Too hungry to bite."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电光一炸，全世界都白了。", "en": "Lightning bursts; the world goes white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有铁皮，没有墙。", "en": "No metal, no walls."}
      ]
    }
  }
}
