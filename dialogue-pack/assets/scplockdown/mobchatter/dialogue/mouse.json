{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的肚皮几乎贴地。", "en": "My belly almost touches the floor."},
        {"zh": "我从排水口钻出来。", "en": "I slip out of a drain outlet."},
        {"zh": "耳朵在空气里转来转去。", "en": "My ears swivel in the air."},
        {"zh": "我跑三步，停一下。", "en": "Three steps, then a pause."},
        {"zh": "爪子在地面上出声很小。", "en": "My claws barely sound on the floor."},
        {"zh": "我绕过一只倒下的靴子。", "en": "I go round a fallen boot."},
        {"zh": "我的尾巴拖着一条细线。", "en": "My tail drags a thin line."},
        {"zh": "我在电缆之间穿梭。", "en": "I thread between the cables."},
        {"zh": "走廊的灯光很刺眼。", "en": "The corridor light stings."},
        {"zh": "我朝有食物的味道去。", "en": "I head for the smell of food."},
        {"zh": "我从一个影子跑到另一个影子。", "en": "I run from one shadow to the next."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲着，前爪收在胸口。", "en": "I crouch with my forepaws at my chest."},
        {"zh": "我在通风管口闻来闻去。", "en": "I sniff around the vent opening."},
        {"zh": "通风口有风。", "en": "There's air from the vent."},
        {"zh": "我抬起身子听了听。", "en": "I rise up and listen."},
        {"zh": "一粒碎屑卡在我的牙缝。", "en": "A crumb is stuck in my teeth."},
        {"zh": "我在啃一小块东西。", "en": "I'm nibbling something small."},
        {"zh": "我的胡须碰到地板。", "en": "My whiskers touch the floor."},
        {"zh": "我缩成一团，很圆。", "en": "I curl into a small round ball."},
        {"zh": "远处有水管在响。", "en": "A pipe sounds far off."},
        {"zh": "我在听通风管道。", "en": "I listen to the duct."},
        {"zh": "我忽然停住不动。", "en": "I suddenly freeze."},
        {"zh": "鼠尾会掉，我也不在乎。", "en": "My tail may drop. I do not mind."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你大得没边了。", "en": "You're impossibly big."},
        {"zh": "我贴着墙看你。", "en": "I watch you from against the wall."},
        {"zh": "你一动，我就要跑。", "en": "One move from you and I run."},
        {"zh": "你的靴子离我很近。", "en": "Your boot is very close."},
        {"zh": "我闻到你的口袋里有点吃的。", "en": "I smell food in your pocket."},
        {"zh": "我在你脚边绕了一下。", "en": "I dart around your foot."},
        {"zh": "你蹲下来的时候我退了。", "en": "When you crouched, I retreated."},
        {"zh": "我从排水口露出半个头。", "en": "Half my head shows from the drain."},
        {"zh": "我能从缝里过去。", "en": "I can get through the gap."},
        {"zh": "我从排水口钻出来，肚皮贴地。", "en": "I slip from the drain, belly to the floor."},
        {"zh": "你脚下的地板很凉。", "en": "The floor under you is cold."},
        {"zh": "我听见你的呼吸变慢。", "en": "Your breathing slows."},
        {"zh": "我给不了你什么。", "en": "I have nothing to give you."},
        {"zh": "只留这条尾巴。", "en": "Only this tail is left."},
        {"zh": "你还没抓到过我们。", "en": "You haven't caught one of us yet."},
        {"zh": "我贴着墙根，听你的靴声。", "en": "Flat to the wall, I listen to your boots."},
        {"zh": "你再靠近我就不见了。", "en": "Come closer and I'm gone."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的尾巴细得像一根线。", "en": "My tail is thin as a thread."},
        {"zh": "疼得我腿在抖。", "en": "The pain shakes my legs."},
        {"zh": "我拖着后腿跑了两步。", "en": "I drag a hind leg for two steps."},
        {"zh": "我缩进墙角。", "en": "I shrink into the corner."},
        {"zh": "我喘得停不下来。", "en": "I can't stop panting."},
        {"zh": "我的尾巴动了动。", "en": "My tail twitches."},
        {"zh": "这点伤我扛不住第二下。", "en": "I can't take another."},
        {"zh": "我拖着后腿，躲进墙缝。", "en": "Dragging a hind leg, I slip into the wall."},
        {"zh": "我得赶紧溜了。", "en": "I'd better slip away."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有饼干的味道。", "en": "That smells like a cracker."},
        {"zh": "你把碎屑放低。", "en": "Lower the crumbs."},
        {"zh": "我出来了，但没靠近。", "en": "I've come out, but not close."},
        {"zh": "我闻到糖了。", "en": "I smell sugar."},
        {"zh": "这不够一餐。", "en": "That's not a meal."},
        {"zh": "我把头探出来。", "en": "I poke my head out."},
        {"zh": "你手指张得太开。", "en": "Your fingers are spread too wide."},
        {"zh": "我叼了一块就跑。", "en": "I grab a piece and run."},
        {"zh": "再多给一小块。", "en": "One more small piece."},
        {"zh": "我在地上找了找。", "en": "I searched the floor."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我旁边的地板。", "en": "You step on the floor beside me."},
        {"zh": "你的靴尖擦到我的尾巴。", "en": "Your boot grazes my tail."},
        {"zh": "我在墙缝前停住。", "en": "I stop at the wall seam."},
        {"zh": "我被撞得翻了一下。", "en": "The knock rolls me over."},
        {"zh": "我很快又站起来了。", "en": "I'm up again quickly."},
        {"zh": "这点重量能压死我。", "en": "That much weight would crush me."},
        {"zh": "地板震了一下。", "en": "The floor shook once."},
        {"zh": "你回头的时候我已经不在了。", "en": "By the time you look, I'm gone."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只在管道那边。", "en": "Another one's by the pipe."},
        {"zh": "她比我小一圈。", "en": "She's slightly smaller."},
        {"zh": "我把碎屑推给她。", "en": "I push a crumb to her."},
        {"zh": "我们一起贴着墙走。", "en": "We move along the wall together."},
        {"zh": "她的胡须擦过我的。", "en": "Her whiskers brush mine."},
        {"zh": "我们在同一个缝里。", "en": "We're in the same gap."},
        {"zh": "她先跑，我跟上。", "en": "She runs first; I follow."},
        {"zh": "她回头等我。", "en": "She looks back and waits."},
        {"zh": "我们钻进同一个洞。", "en": "We vanish into the same hole."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起一块碎屑。", "en": "I take a crumb."},
        {"zh": "这比我的头还大。", "en": "This is bigger than my head."},
        {"zh": "我把它藏在管子后面。", "en": "I hide it behind a pipe."},
        {"zh": "这块是张纸片。", "en": "This piece is a scrap of paper."},
        {"zh": "我啃了两下。", "en": "I gnaw it twice."},
        {"zh": "它没有味道。", "en": "It has no taste."},
        {"zh": "我把它推走了。", "en": "I pushed it away."},
        {"zh": "一小块面包屑，够过冬了。", "en": "A little breadcrumb — enough to last the winter."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "通风管里有响动。", "en": "Something sounds in the duct."},
        {"zh": "我把肚皮贴住墙。", "en": "I press my belly to the wall."},
        {"zh": "我的耳朵全竖起来。", "en": "My ears stand straight."},
        {"zh": "我看着那个影子。", "en": "I watch that shadow."},
        {"zh": "它在往这边走。", "en": "It's walking this way."},
        {"zh": "我在找退路。", "en": "I'm looking for a way back."},
        {"zh": "通风口就在旁边。", "en": "A vent is right beside me."},
        {"zh": "我先一点不动。", "en": "I won't stir at all."},
        {"zh": "它把头压低了。", "en": "It lowered its head."},
        {"zh": "我准备跑了。", "en": "I'm ready to run."},
        {"zh": "它的脚步很重。", "en": "Its steps are heavy."},
        {"zh": "现在不动就晚了。", "en": "If I wait, it's too late."},
        {"zh": "我朝毒气管道那边去。", "en": "I head for the pipe."},
        {"zh": "它追上来了。", "en": "It's coming after me."},
        {"zh": "缝隙够我过去。", "en": "The gap is wide enough for me."},
        {"zh": "我窜了出去。", "en": "I dart away."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跑到另一个房间。", "en": "I've run to another room."},
        {"zh": "它在门口等着。", "en": "It's waiting in the doorway."},
        {"zh": "我的呼吸很急。", "en": "My breathing is fast."},
        {"zh": "它把那边的门关了。", "en": "It closed that door."},
        {"zh": "我正在找别的出口。", "en": "I'm looking for another way out."},
        {"zh": "管道里有风，能走。", "en": "The duct has airflow; it's passable."},
        {"zh": "我钻进桌子下面。", "en": "I duck under a table."},
        {"zh": "它没有蹲下来看。", "en": "It didn't crouch to look."},
        {"zh": "它没有离开。", "en": "It hasn't left."},
        {"zh": "我打算走管道。", "en": "I'll take the duct."},
        {"zh": "我顺着管壁往上爬。", "en": "I climb up the duct wall."},
        {"zh": "它抓不到这里。", "en": "It can't reach in here."},
        {"zh": "我再往前一点。", "en": "A little further."},
        {"zh": "出口就在上面。", "en": "The exit is above."},
        {"zh": "我从管口出来了。", "en": "I'm out of the vent."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住它的手指就窜开。", "en": "I bite its finger and bolt."},
        {"zh": "牙很小，但很尖。", "en": "Small teeth, but sharp."},
        {"zh": "我从它手上窜过去。", "en": "I dash over its hand."},
        {"zh": "它挥手，我躲开了。", "en": "It swipes; I dodge."},
        {"zh": "我的尾巴差点被踩到。", "en": "My tail nearly got stepped on."},
        {"zh": "我撞了一下它的手指。", "en": "I knock its fingers once."},
        {"zh": "我抓破了一点皮。", "en": "I've scratched a little skin."},
        {"zh": "我跑进墙缝。", "en": "I dive into the wall gap."},
        {"zh": "它的手伸不进来。", "en": "Its hand can't reach in."},
        {"zh": "我在里面看它。", "en": "I watch it from inside."},
        {"zh": "脚步声远了。", "en": "The footsteps recede."},
        {"zh": "我从缝里钻回来。", "en": "I squeeze back out of the gap."},
        {"zh": "我身上有点血，不是我的。", "en": "There's blood on me; not mine."},
        {"zh": "我抖了抖身子，尾巴尖也抖。", "en": "I shake myself, tail tip twitching."},
        {"zh": "然后我继续找吃的。", "en": "Then I go back to looking for food."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "墙缝里探出一个小头。", "en": "A small head pokes from the wall gap."},
        {"zh": "我从管道里掉下来。", "en": "I drop out of the duct."},
        {"zh": "这里的地板很凉。", "en": "The floor here is cold."},
        {"zh": "我的胡须先碰到空气。", "en": "My whiskers touch the air first."},
        {"zh": "我闻到了很多味道。", "en": "I smell a great deal."},
        {"zh": "我的尾巴，能掉下来一根。", "en": "One tail might come off."},
        {"zh": "走廊太亮了。", "en": "The corridor's too bright."},
        {"zh": "我找到一条缝。", "en": "I found a gap."},
        {"zh": "这地方有吃的味道。", "en": "There's food here somewhere."},
        {"zh": "我先在原地停了一会儿。", "en": "I wait in place a moment."},
        {"zh": "然后我开始跑。", "en": "Then I run."},
        {"zh": "我第一次来这一层。", "en": "This is my first time on this level."},
        {"zh": "我贴紧墙根站着。", "en": "I keep tight to the wall base."},
        {"zh": "我的影子只有一点点。", "en": "My shadow is a mere speck."},
        {"zh": "我决定往左边去。", "en": "I decide to go left."},
        {"zh": "右边有风，是出口。", "en": "There's air on the right; an exit."},
        {"zh": "我又不见了。", "en": "And I'm gone again."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "一点火星就把我的毛烧卷了。", "en": "A single spark curls my fur."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落地，摔得发懵。", "en": "I hit the ground from a height, dazed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我整个淹了。", "en": "Water covers me completely."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖东西把我的耳朵划开了。", "en": "Something sharp splits my ear."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "周围的空气忽然变冷了。", "en": "The air around me suddenly turns cold."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电光一亮，我的毛全竖起来。", "en": "Lightning flashes and my fur stands up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有地板，没有墙，只有黑。", "en": "No floor, no wall, only black."}
      ]
    }
  }
}
