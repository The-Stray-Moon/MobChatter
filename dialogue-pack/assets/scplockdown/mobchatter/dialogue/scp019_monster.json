{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从瓶口爬出来，一只接一只。", "en": "We climb out of the jar, one after another."},
        {"zh": "我只有半个头高，跑得很快。", "en": "I'm half a head tall and very fast."},
        {"zh": "我沿着墙缝，成群地爬。", "en": "I crawl in a swarm along the wall seams."},
        {"zh": "兽之瓶的黏液还挂在我身上。", "en": "The jar's slime still clings to me."},
        {"zh": "我从你的靴子边窜过去。", "en": "I dart past your boot."},
        {"zh": "地上的水痕，是我留的。", "en": "The wet trail on the floor is mine."},
        {"zh": "我从桌腿之间穿过去。", "en": "I weave between the table legs."},
        {"zh": "很多只一起跑，声音很细。", "en": "Many of us running together. A thin sound."},
        {"zh": "我们散开，从四面走。", "en": "We scatter and come from all sides."},
        {"zh": "我一边跑一边抖。", "en": "I run and twitch at the same time."},
        {"zh": "我绕过一盏灯。", "en": "I go around a lamp."},
        {"zh": "我朝走廊深处去了。", "en": "I head deeper into the corridor."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在墙缝里，只露头。", "en": "I stop in a wall crack, head showing."},
        {"zh": "我在吐水，一小口一小口。", "en": "I spit water, a little at a time."},
        {"zh": "我的身体在动，停不下来。", "en": "My body moves and won't stop."},
        {"zh": "我在听有没有人走过来。", "en": "I'm listening for footsteps."},
        {"zh": "那盏灯下，我看得清。", "en": "Under that lamp I can see."},
        {"zh": "我挪到另一条缝里。", "en": "I shift to another crack."},
        {"zh": "我们互相挤着，很暖。", "en": "We crowd together. It's warm."},
        {"zh": "有个东西在地上爬，被我们吃了。", "en": "Something crawled on the floor. We ate it."},
        {"zh": "我在墙缝里磨着牙。", "en": "I grind my teeth in the wall crack."},
        {"zh": "水面上有我的影子，很小。", "en": "My reflection on the water is small."},
        {"zh": "我从瓶子里爬出来了。", "en": "I've crawled out of the jar."},
        {"zh": "我在瓶口边挤成一堆。", "en": "We bunch up at the jar's mouth."},
        {"zh": "这里实在太安静了。", "en": "It's far too quiet here."},
        {"zh": "瓶口的玻璃上，有我们爬过的印子。", "en": "The glass mouth is streaked where we climbed out."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你低头，就看见我了。", "en": "You look down, and there I am."},
        {"zh": "我不大，可我们很多。", "en": "I'm small, and there are many of us."},
        {"zh": "你踩不到我。", "en": "You can't step on me."},
        {"zh": "你踩到一只，还有十只。", "en": "Step on one, there are ten more."},
        {"zh": "我从你脚边跑过去。", "en": "I run right past your foot."},
        {"zh": "你抬脚的时候，我已经到了。", "en": "By the time you lift your foot, I'm there."},
        {"zh": "我抬头看你，眼睛很多。", "en": "I look up at you, many eyes."},
        {"zh": "你的靴子很高，可我有牙。", "en": "Your boots are tall. I have teeth."},
        {"zh": "我们往上爬，很快。", "en": "We climb upward, quickly."},
        {"zh": "你越站越近了。", "en": "You're standing closer and closer."},
        {"zh": "瓶子是满的。", "en": "The jar is full."},
        {"zh": "你听见那些细声了吗？", "en": "Do you hear that thin noise?"},
        {"zh": "那都是从瓶子里出来的。", "en": "That's all coming out of the jar."},
        {"zh": "你拿什么堵，都堵不住。", "en": "Whatever you block it with won't hold."},
        {"zh": "我们在你脚下了。", "en": "We're at your feet now."},
        {"zh": "现在，跑吧。", "en": "Now. Run."},
        {"zh": "跑也没用，我们快。", "en": "Running won't help. We're fast."},
        {"zh": "我们比你快得多。", "en": "Much faster than you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，翻身再爬。", "en": "I fall, right myself, climb again."},
        {"zh": "掉了几条腿，还能跑。", "en": "A few legs gone. I can still run."},
        {"zh": "我的身体被压扁了。", "en": "My body has been squashed flat."},
        {"zh": "还有别的我在。", "en": "There are other mes."},
        {"zh": "我流的水，不是血。", "en": "What I leak isn't quite blood."},
        {"zh": "我缩回瓶子底下的阴影。", "en": "I shrink into the shadow under the jar."},
        {"zh": "我抖了一下，又跑。", "en": "I twitch once and run again."},
        {"zh": "这一下，少了一只。", "en": "Now there's one fewer."},
        {"zh": "掉一只，没关系。", "en": "One fewer. It doesn't matter."},
        {"zh": "这里还有很多只。", "en": "There are plenty more here."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你在往下丢东西。", "en": "You're dropping something."},
        {"zh": "我们全冲过去了。", "en": "We all rush for it."},
        {"zh": "我先尝了尝你的靴子。", "en": "I taste your boot first."},
        {"zh": "这点东西不够我们分。", "en": "That's not enough for all of us."},
        {"zh": "那就把你也分了。", "en": "Then we'll divide you too."},
        {"zh": "你的手指还在外面。", "en": "Your fingers are still out."},
        {"zh": "你的手指我够得到。", "en": "I can reach your fingers."},
        {"zh": "我们一层层往上爬。", "en": "We climb up in layers."},
        {"zh": "你甩手也没用。", "en": "Shaking your hand won't help."},
        {"zh": "我们抓得很紧。", "en": "We hold on tight."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞在你的鞋上，翻了过去。", "en": "I hit your boot and tumble over."},
        {"zh": "我被踩扁，又爬了起来。", "en": "I'm crushed flat and crawl up again."},
        {"zh": "这一下，我掉了几条腿。", "en": "That cost me a few legs."},
        {"zh": "小身子跑起来，钻缝最快。", "en": "This small body slips through gaps fastest."},
        {"zh": "你踩住我了。", "en": "You've pinned me underfoot."},
        {"zh": "我咬你的鞋底。", "en": "I bite your sole."},
        {"zh": "我的同伴爬上来了。", "en": "My kin are climbing up."},
        {"zh": "你抬起脚，我就跑了。", "en": "You lift your foot and I'm gone."},
        {"zh": "我们撞在一起，又散开。", "en": "We collide and scatter."},
        {"zh": "这一片地上，全是我们。", "en": "The whole floor is us."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们不用成对。", "en": "We don't pair off."},
        {"zh": "瓶子里本来就有很多。", "en": "There were many of us in the jar already."},
        {"zh": "我们只会越来越多。", "en": "We only get more numerous."},
        {"zh": "那瓶子，是我们的家。", "en": "That jar is our home."},
        {"zh": "它一开，我们就出来。", "en": "When it opens, we come out."},
        {"zh": "我们不知道外面有什么。", "en": "We don't know what's outside."},
        {"zh": "也不需要知道。", "en": "And we don't need to."},
        {"zh": "有东西吃，就够了。", "en": "Something to eat is enough."},
        {"zh": "活着的东西，都是吃的。", "en": "Living things are all food."},
        {"zh": "活的东西，包括你。", "en": "Living things. You included."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住鞋带，往回拖。", "en": "I seize a bootlace and haul."},
        {"zh": "这块肉，比我的头大。", "en": "This piece is bigger than my head."},
        {"zh": "我们一起抬。", "en": "We carry it together."},
        {"zh": "拖到墙缝里去。", "en": "Drag it into the crack."},
        {"zh": "地上留下一条水痕。", "en": "A wet trail is left on the floor."},
        {"zh": "我们分着吃。", "en": "We share it out."},
        {"zh": "我只吃到一点。", "en": "I only got a little."},
        {"zh": "还有更多吗？", "en": "Is there more?"},
        {"zh": "我闻着味找。", "en": "I follow the smell."},
        {"zh": "那边地上还有一点。", "en": "There's some on the floor over there."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有脚步声在走廊里。", "en": "Footsteps in the corridor."},
        {"zh": "我们一起停下来。", "en": "We all stop at once."},
        {"zh": "然后一起冲。", "en": "Then we all rush."},
        {"zh": "他还没看见我们。", "en": "He hasn't seen us yet."},
        {"zh": "我们贴着墙根走。", "en": "We keep to the skirting."},
        {"zh": "我们先到灯下面。", "en": "We get under the lamp first."},
        {"zh": "现在他看见了。", "en": "Now he sees us."},
        {"zh": "他开始退了。", "en": "He's backing away."},
        {"zh": "退到门边了。", "en": "Backed to the doorway."},
        {"zh": "我们把门堵住了。", "en": "We've blocked the door."},
        {"zh": "我们围上去。", "en": "We close in."},
        {"zh": "我们围成第一圈。", "en": "We close the first ring."},
        {"zh": "第二圈也合上了。", "en": "The second ring closes too."},
        {"zh": "他没地方站了。", "en": "He has nowhere to stand."},
        {"zh": "他开始跑了。", "en": "He's running."},
        {"zh": "我们不止一只，你看清楚。", "en": "There's more than one of us — look closely."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在他脚边绕。", "en": "We circle his feet."},
        {"zh": "他踢开一只，还有别的。", "en": "He kicks one away. There are others."},
        {"zh": "我们从他裤腿往上爬。", "en": "We climb up his trouser leg."},
        {"zh": "他跳起来，抖腿。", "en": "He jumps and shakes his leg."},
        {"zh": "他抖腿，我们不掉。", "en": "He shakes his leg. We don't drop."},
        {"zh": "我们咬住布，往上。", "en": "We bite the cloth and climb."},
        {"zh": "他拍打自己。", "en": "He's slapping at himself."},
        {"zh": "我们从他手上跑开。", "en": "We run off his hands."},
        {"zh": "我们又跑回他手上。", "en": "We run back onto his hands."},
        {"zh": "他开始大声喊人。", "en": "He's started shouting for help."},
        {"zh": "喊得再响也没用。", "en": "Shouting louder won't help."},
        {"zh": "我们在他鞋里了。", "en": "We're inside his boots."},
        {"zh": "他撑不住，坐下了。", "en": "He can't stand and sits down."},
        {"zh": "他在角落，我们围得住。", "en": "He's in the corner. We can surround him."},
        {"zh": "我们都上去了。", "en": "We're all over him."},
        {"zh": "这一场，结束了。", "en": "This is finished."},
        {"zh": "他踩我们的时候，我们往鞋缝里钻。", "en": "When he stamps, we squeeze into the seams."},
        {"zh": "他的裤脚扎住了，我们钻进去。", "en": "His cuff is tucked in. We go down inside."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬了一口，很浅。", "en": "I bite. Shallow."},
        {"zh": "我们十只一起咬。", "en": "Ten of us bite at once."},
        {"zh": "他抽了一下腿。", "en": "His leg jerks."},
        {"zh": "我们又咬了一口。", "en": "We bite again."},
        {"zh": "他打我，我掉下去。", "en": "He swats me and I fall."},
        {"zh": "我翻过来，接着爬。", "en": "I roll over and climb again."},
        {"zh": "血的味道让所有都兴奋了。", "en": "The taste of blood excites all of us."},
        {"zh": "我们咬得更深。", "en": "We bite deeper."},
        {"zh": "他倒在地上。", "en": "He's down on the floor."},
        {"zh": "我们全上去了。", "en": "All of us are on him."},
        {"zh": "他的声音停下来了。", "en": "His voice has stopped."},
        {"zh": "我们开始吃。", "en": "We begin to eat."},
        {"zh": "吃完了，我们散开。", "en": "When we're done we scatter."},
        {"zh": "我们散开找下一个。", "en": "We scatter to find the next."},
        {"zh": "他抓住我，捏碎了。", "en": "He grabs me and crushes me."},
        {"zh": "我又往上爬，从他的指缝。", "en": "I climb again, between his fingers."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "瓶口的封蜡裂开了。", "en": "The wax seal on the jar has split."},
        {"zh": "我先爬出来。", "en": "I climb out first."},
        {"zh": "下面的还在挤。", "en": "The ones below are still pushing."},
        {"zh": "地上很快就是一层。", "en": "Soon the floor is a layer of us."},
        {"zh": "地板缝里，我们钻了出来。", "en": "We squeeze out of the floor cracks."},
        {"zh": "我们不太喜欢。", "en": "We don't much like it."},
        {"zh": "可这里有吃的。", "en": "But there's food here."},
        {"zh": "瓶子倒了，我们涌出来。", "en": "The jar tips, and we pour out."},
        {"zh": "我们朝一个方向跑。", "en": "We run one way."},
        {"zh": "地上全是细碎的声音。", "en": "The floor is full of tiny sounds."},
        {"zh": "有人要过来了。", "en": "Someone's coming this way."},
        {"zh": "他把门推开一条缝。", "en": "He pushes the door open a crack."},
        {"zh": "他看见我们了。", "en": "He sees us."},
        {"zh": "他站在那儿不动了。", "en": "He stands there, frozen."},
        {"zh": "他站在门口，动不了。", "en": "He's in the doorway and can't move."},
        {"zh": "我们冲过去。", "en": "We rush."},
        {"zh": "我们一层压一层。", "en": "Layer on layer of us."},
        {"zh": "像水一样涌过去。", "en": "We pour like water."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我们四散跑开。", "en": "Fire sends us scattering."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从桌上掉下来，摔得翻过去。", "en": "I fall off the table and tumble."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我们冲散了。", "en": "Water scatters us."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸开的气浪把我们都掀飞了。", "en": "The blast throws us all."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭钉住我，把我钉在地上。", "en": "An arrow pins me to the floor."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一道光罩住我们，跑不出去。", "en": "A light cages us. We can't get out."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "什么都没得吃，我们开始互相咬。", "en": "Nothing to eat, so we start biting each other."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我们一片都焦了。", "en": "Lightning falls and a whole patch of us is charred."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "瓶子底下是空的。", "en": "There's nothing under the jar."}
      ]
    }
  }
}
