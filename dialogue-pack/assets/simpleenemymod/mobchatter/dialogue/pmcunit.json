{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着土路走，步子很匀。", "en": "I walk the dirt road at an even pace."},
        {"zh": "枪背在肩上，保险关着。", "en": "My rifle rides my shoulder, safety on."},
        {"zh": "我走在队伍中间。", "en": "I walk in the middle of the file."},
        {"zh": "前面的人抬手，我就停。", "en": "The man ahead raises a hand; I stop."},
        {"zh": "再走的时候，我才跟。", "en": "When he moves, I follow."},
        {"zh": "我的靴底踩过碎石。", "en": "My soles crunch the gravel."},
        {"zh": "我在看两边的树线。", "en": "I watch the treeline on both sides."},
        {"zh": "每隔几步就回头。", "en": "Every few steps I glance back."},
        {"zh": "这已经是习惯。", "en": "It is already habit."},
        {"zh": "土路上有车辙。", "en": "Wagon ruts mark the road."},
        {"zh": "我们绕过水坑。", "en": "We go around a puddle."},
        {"zh": "我把枪带往上提了提。", "en": "I hitch the sling higher."},
        {"zh": "路过一辆烧毁的车。", "en": "We pass a burned-out truck."},
        {"zh": "前面的人回头看了一眼。", "en": "The man ahead glances back."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "后背靠着一块石头。", "en": "My back rests on a stone."},
        {"zh": "我把面罩往上推了推。", "en": "I push my visor up."},
        {"zh": "喝了一口水。", "en": "Take a mouthful of water."},
        {"zh": "又拧上盖子。", "en": "And screw the cap back on."},
        {"zh": "我沿着土路走，保险还关着。", "en": "I walk the dirt road, safety still on."},
        {"zh": "手放在枪上。", "en": "My hand rests on the rifle."},
        {"zh": "那边没动静。", "en": "Nothing moves over there."},
        {"zh": "把手放下来，别紧张。", "en": "Lower your hands, do not tense up."},
        {"zh": "鸟又落回去了。", "en": "The birds settle again."},
        {"zh": "我仍旧站着。", "en": "I keep standing."},
        {"zh": "我把手套的带子系紧。", "en": "I tighten my glove strap."},
        {"zh": "检查了一下弹匣。", "en": "I check the magazine."},
        {"zh": "里面是满的。", "en": "It is full."},
        {"zh": "我又把它按回去。", "en": "I seat it again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把枪口挪开。", "en": "I move the muzzle aside."},
        {"zh": "你没有武器。", "en": "You have no weapon."},
        {"zh": "我抬手比了个手势。", "en": "I make a hand signal."},
        {"zh": "你可以过来。", "en": "You may come closer."},
        {"zh": "你停在我面前。", "en": "You stop in front of me."},
        {"zh": "你的装备不怎么样。", "en": "Your kit is not much."},
        {"zh": "但也不算差。", "en": "But not bad either."},
        {"zh": "跟在我们后面。", "en": "Fall in behind us."},
        {"zh": "你别到处乱走。", "en": "Do not wander about."},
        {"zh": "招募台一点，我就听你指挥。", "en": "One tap on the recruitment table and I obey."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我缩到石头后面，喘了口气。", "en": "I duck behind the rock and catch my breath."},
        {"zh": "肩膀上有一道口子。", "en": "A gash on my shoulder."},
        {"zh": "我用力按住伤口。", "en": "I press hard on the wound."},
        {"zh": "血从指缝间渗出来。", "en": "Blood seeps between my fingers."},
        {"zh": "我死死咬着牙。", "en": "I clench my teeth hard."},
        {"zh": "我一声没出。", "en": "I make no sound."},
        {"zh": "我抬眼看过去。", "en": "I look up that way."},
        {"zh": "我点了下头。", "en": "I nod once."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我吃自己的口粮。", "en": "I eat my own rations."},
        {"zh": "你留着自己用，我的弹匣还满。", "en": "Keep it; my magazine is still full."},
        {"zh": "我喝了一口水。", "en": "I take a mouthful of water."},
        {"zh": "水壶还满，我不换东西。", "en": "My canteen is full; I'm not trading."},
        {"zh": "不过，谢谢。", "en": "But thank you."},
        {"zh": "也许以后用得着。", "en": "Perhaps later I will need it."},
        {"zh": "我拉了拉肩带。", "en": "I tug my strap."},
        {"zh": "队伍开始动了。", "en": "The column starts moving."},
        {"zh": "我把水壶举起来。", "en": "I raise the canteen."},
        {"zh": "我先喝一小口。", "en": "I take a small mouthful."},
        {"zh": "我把壶递给你。", "en": "I pass you the canteen."},
        {"zh": "你先喝一口。", "en": "You take a drink first."},
        {"zh": "我这里还有。", "en": "I have more."},
        {"zh": "我拧上盖子。", "en": "I screw the cap on."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的枪口，听指挥才抬。", "en": "My muzzle rises only on orders."},
        {"zh": "我往后让半步。", "en": "I give half a step back."},
        {"zh": "我抬手示意你别紧张。", "en": "I raise a hand to show there is no trouble."},
        {"zh": "我的装备磕到你的。", "en": "My kit clinks against yours."},
        {"zh": "那声音很响。", "en": "The clatter is loud."},
        {"zh": "我按住那块金属。", "en": "I steady the metal."},
        {"zh": "我们蹲下听了会。", "en": "We crouch and listen a while."},
        {"zh": "我才站起来。", "en": "Only then do I stand."},
        {"zh": "那我们就走。", "en": "Then we go."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没时间想这些。", "en": "I have no time for that."},
        {"zh": "任务还没完。", "en": "The job is not done."},
        {"zh": "我看了看队的后面。", "en": "I glance at the back of the column."},
        {"zh": "后面还有人。", "en": "There are still men behind."},
        {"zh": "那就还要走。", "en": "So we keep moving."},
        {"zh": "我把这些放下。", "en": "I set it aside."},
        {"zh": "枪还挎在肩上。", "en": "The rifle rides my shoulder."},
        {"zh": "路就在前面。", "en": "The road lies ahead."},
        {"zh": "天黑之前要过去。", "en": "We must be past before dark."},
        {"zh": "我走在队尾。", "en": "I walk at the tail of the column."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲下捡起来。", "en": "I crouch and pick it up."},
        {"zh": "不是我们的。", "en": "Not ours."},
        {"zh": "我把它放进包里。", "en": "I put it in my pack."},
        {"zh": "这个能修东西。", "en": "This can fix kit."},
        {"zh": "我把它放好。", "en": "I put it away."},
        {"zh": "我回头交给后面的人。", "en": "I pass it back."},
        {"zh": "他朝我点点头。", "en": "He nods at me."},
        {"zh": "队伍继续前进。", "en": "The column moves on."},
        {"zh": "我摸了摸包的扣。", "en": "I check the pack's clasp."},
        {"zh": "它还在里面。", "en": "It is still inside."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "左边树线有人影。", "en": "A shape at the treeline on the left."},
        {"zh": "我立刻蹲下。", "en": "I drop into a crouch."},
        {"zh": "我抬手指过去。", "en": "I point."},
        {"zh": "队伍向两侧散开。", "en": "The column spreads out."},
        {"zh": "我靠在树后。", "en": "I take cover behind a tree."},
        {"zh": "我把枪架稳。", "en": "I settle the rifle."},
        {"zh": "呼吸慢下来。", "en": "My breathing slows."},
        {"zh": "我屏住气瞄准。", "en": "I hold my breath and aim."},
        {"zh": "那个人影在动。", "en": "The shape is moving."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "那个人影停住了。", "en": "The shape stops."},
        {"zh": "它在找我们。", "en": "It is looking for us."},
        {"zh": "我数到三，我们一起开火。", "en": "On three, we fire together."},
        {"zh": "枪口的准星压住它。", "en": "My sight rests on it."},
        {"zh": "它往右走了一步。", "en": "It steps right."},
        {"zh": "我跟着挪了一点。", "en": "I shift slightly with it."},
        {"zh": "我的膝盖压在石头上。", "en": "My knee presses stone."},
        {"zh": "石头硌得生疼。", "en": "The stone digs in painfully."},
        {"zh": "我压着枪不动。", "en": "I hold the rifle still."},
        {"zh": "那个人影转身。", "en": "The shape turns."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "打在它的肩上。", "en": "It lands on its shoulder."},
        {"zh": "它往后倒去。", "en": "It falls backward."},
        {"zh": "我用膝盖顶它。", "en": "I drive a knee into it."},
        {"zh": "它弯下身子。", "en": "It doubles over."},
        {"zh": "我把枪横过来挡。", "en": "I bring the rifle across to block."},
        {"zh": "它的手打在枪身上。", "en": "Its hand strikes the receiver."},
        {"zh": "我的手被震了一下。", "en": "The shock runs up my arm."},
        {"zh": "招募台上的我，听你指挥。", "en": "Recruited, I follow your orders."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土路上过来。", "en": "I come up the dirt road."},
        {"zh": "身上是灰色的装备。", "en": "I wear grey kit."},
        {"zh": "我们身上没有旗子。", "en": "We carry no flag."},
        {"zh": "我们是被雇来的。", "en": "We are hired."},
        {"zh": "谁付钱，就替谁打。", "en": "Whoever pays, we fight for."},
        {"zh": "我站在路边。", "en": "I stand at the roadside."},
        {"zh": "看着队伍清点人数。", "en": "Watching the squad count off."},
        {"zh": "一个也不少。", "en": "Not one is missing."},
        {"zh": "我扬了扬下巴。", "en": "I jerk my chin up."},
        {"zh": "那就出发吧。", "en": "Then we move out."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到我的袖子，我扑了两下。", "en": "Fire catches my sleeve; I beat it out."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，撞在石头上。", "en": "I roll off a slope and hit a stone."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进肺里，我拼命往上游。", "en": "Water fills my lungs; I claw upward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "泥土砸在我身上。", "en": "Dirt slams down over me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西打穿了我的护具。", "en": "It punches through my kit."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股力把我的手压在地上。", "en": "A force pins my hand to the ground."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "口粮已经吃完了。", "en": "My rations are gone."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把树削掉一半，我伏低。", "en": "Lightning splits a tree; I flatten."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有路。", "en": "No road under my feet."}
      ]
    }
  }
}
