{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我低着身子穿过灌木。", "en": "I move low through the brush."},
        {"zh": "枪贴在胸前。", "en": "The rifle sits against my chest."},
        {"zh": "我一寸一寸地往前挪。", "en": "I inch forward."},
        {"zh": "每走三步就停一下。", "en": "Every three steps I pause."},
        {"zh": "我蹲下看前面的路。", "en": "I crouch and study the path ahead."},
        {"zh": "风把我的衣袖吹得响。", "en": "Wind snaps my sleeve."},
        {"zh": "我用手按住。", "en": "I press it down."},
        {"zh": "队伍在两边散开。", "en": "The squad spreads to both sides."},
        {"zh": "我在最左侧。", "en": "I am on the far left."},
        {"zh": "脚下的雪印很浅。", "en": "My prints in the snow are shallow."},
        {"zh": "我到下一个掩体。", "en": "I reach the next cover."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠在墙后，枪口朝上。", "en": "I lean behind the wall, muzzle up."},
        {"zh": "慢慢地呼吸。", "en": "I breathe slowly."},
        {"zh": "我把手套拉紧。", "en": "I pull my gloves tight."},
        {"zh": "雪落在肩上。", "en": "Snow settles on my shoulder."},
        {"zh": "我没有拍掉。", "en": "I do not brush it off."},
        {"zh": "都保持安静。", "en": "Everyone stay quiet."},
        {"zh": "前面的人在打手势。", "en": "Someone ahead signals."},
        {"zh": "我看懂了手势。", "en": "I read the signal."},
        {"zh": "两个人从左边绕。", "en": "Two men go round the left."},
        {"zh": "我朝他点了下头。", "en": "I nod to him."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把枪口压低。", "en": "I lower the muzzle."},
        {"zh": "我没有立刻开枪。", "en": "I do not fire at once."},
        {"zh": "我抬手让你别动。", "en": "I raise a hand for you to hold."},
        {"zh": "你停在原地。", "en": "You stop where you are."},
        {"zh": "我端着枪，绕到你侧面。", "en": "I keep my rifle up and circle to your flank."},
        {"zh": "打量你的手。", "en": "I watch your hands."},
        {"zh": "这样也成了。", "en": "This will do too."},
        {"zh": "我朝后面摆了摆头。", "en": "I jerk my head toward the rear."},
        {"zh": "现在该动身了。", "en": "Time to move now."},
        {"zh": "你千万不要回头。", "en": "Do not look back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我闷哼一声，靠在墙上。", "en": "I grunt and lean on the wall."},
        {"zh": "肩上湿了一片。", "en": "My shoulder is wet through."},
        {"zh": "牙咬得很紧。", "en": "My teeth are clenched."},
        {"zh": "我一声也没喊。", "en": "I made no sound."},
        {"zh": "枪还在手里。", "en": "The rifle is still in my hand."},
        {"zh": "我还能行动。", "en": "I can still move."},
        {"zh": "我看了一眼后面。", "en": "I glance back."},
        {"zh": "队伍在等我。", "en": "The squad is waiting."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西我不拿。", "en": "I will not take this."},
        {"zh": "补给线会来。", "en": "Supply will come."},
        {"zh": "你自己收起来。", "en": "Put it away yourself."},
        {"zh": "补给里没有这一样。", "en": "This isn't on our supply list."},
        {"zh": "又看了看你。", "en": "Then at you."},
        {"zh": "我把它接过来。", "en": "I take it from you."},
        {"zh": "我点了一下头。", "en": "I give one nod."},
        {"zh": "就只有这些。", "en": "That is all of it."},
        {"zh": "我继续警戒。", "en": "I go back to watching."},
        {"zh": "我继续盯着前面。", "en": "I keep watching ahead."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我和队友分两路包抄你。", "en": "My squad flanks you in two lines."},
        {"zh": "我贴到墙根。", "en": "I press to the wall's base."},
        {"zh": "连呼吸都压住。", "en": "Even my breathing is held."},
        {"zh": "周围没有别人。", "en": "There is no one else."},
        {"zh": "我从墙根站起来。", "en": "I rise from the wall's base."},
        {"zh": "各自找掩体。", "en": "Each to our own cover."},
        {"zh": "继续保持安静。", "en": "We stay quiet."},
        {"zh": "别靠太近，我的枪可不长眼。", "en": "Don't get too close. My rifle doesn't discriminate."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "前面还有人。", "en": "There are still men ahead."},
        {"zh": "我把注意力放回枪上。", "en": "I put my attention back on the rifle."},
        {"zh": "雪一直没停。", "en": "The snow has not stopped."},
        {"zh": "脚印会露出来。", "en": "Prints will show."},
        {"zh": "我们得走了。", "en": "We have to go."},
        {"zh": "我打了个手势。", "en": "I give a hand signal."},
        {"zh": "小组开始移动。", "en": "The team starts moving."},
        {"zh": "我还在最左侧。", "en": "I am still on the far left."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它拾起来。", "en": "I pick it up."},
        {"zh": "这些是弹药。", "en": "These are ammunition."},
        {"zh": "我检查了一下。", "en": "I check it."},
        {"zh": "这些还能用。", "en": "These are still good."},
        {"zh": "我装进弹袋。", "en": "I load it into my pouch."},
        {"zh": "我拍了拍弹袋。", "en": "I pat my pouch."},
        {"zh": "我又蹲回墙后。", "en": "I crouch back behind the wall."},
        {"zh": "前面没有动静。", "en": "Nothing stirs ahead."},
        {"zh": "我把零件收起来，蹲回墙后。", "en": "I gather the parts and crouch back behind the wall."},
        {"zh": "等队里的信号。", "en": "For the squad signal."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "前面的窗户里有影子。", "en": "A shape in the window ahead."},
        {"zh": "我举起手来。", "en": "I raise my hand."},
        {"zh": "整队都停下。", "en": "The whole squad halts."},
        {"zh": "我指了指窗户。", "en": "I point at the window."},
        {"zh": "两个人点头。", "en": "Two men nod."},
        {"zh": "沿着墙根移动。", "en": "I move along the base of the wall."},
        {"zh": "枪口一直对着。", "en": "My muzzle stays on it."},
        {"zh": "雪在我脚下响。", "en": "Snow sounds under me."},
        {"zh": "我停步细听。", "en": "I halt and strain to listen."},
        {"zh": "不是我们的语言。", "en": "Not our language."},
        {"zh": "我握紧了枪。", "en": "I grip the rifle."},
        {"zh": "各就各位准备。", "en": "Everybody ready."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕到侧门。", "en": "I work around to the side door."},
        {"zh": "门是虚掩的。", "en": "The door is ajar."},
        {"zh": "我用枪管推开。", "en": "I push it with the muzzle."},
        {"zh": "里面亮着灯。", "en": "A light is on inside."},
        {"zh": "里面两个人。", "en": "Two inside."},
        {"zh": "一个在看窗。", "en": "One at the window."},
        {"zh": "一个在说话。", "en": "One talking."},
        {"zh": "我心里数到三。", "en": "I count to three in my head."},
        {"zh": "这是第一下。", "en": "This is one."},
        {"zh": "这是第二下。", "en": "This is two."},
        {"zh": "这是第三下。", "en": "This is three."},
        {"zh": "我越过门槛。", "en": "I cross the threshold."},
        {"zh": "先打窗边的。", "en": "The one at the window first."},
        {"zh": "第二个转身。", "en": "The second turns."},
        {"zh": "他已经晚了。", "en": "He is already too late."},
        {"zh": "房间里安静下来。", "en": "The room falls quiet."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "枪托砸在它的太阳穴。", "en": "The stock cracks its temple."},
        {"zh": "我抓住另一个的领子。", "en": "I seize the other's collar."},
        {"zh": "我把他往下拽。", "en": "I drag him down."},
        {"zh": "膝盖压住它的胸。", "en": "My knee pins its chest."},
        {"zh": "他想喊出声。", "en": "He tries to shout."},
        {"zh": "我捂住它的嘴。", "en": "I cover its mouth."},
        {"zh": "我撑墙站起来。", "en": "I push up off the wall."},
        {"zh": "我换好弹匣。", "en": "I seat a fresh magazine."},
        {"zh": "外面还在下雪。", "en": "It is still snowing outside."},
        {"zh": "队伍跟了进来。", "en": "The squad comes in."},
        {"zh": "这里已经清了。", "en": "This place is clear."},
        {"zh": "我们继续前进。", "en": "We push on."},
        {"zh": "我把枪背回肩上。", "en": "I sling the rifle back on my shoulder."},
        {"zh": "我把弹匣换好。", "en": "I seat the magazine."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从林子边缘出来。", "en": "I come out at the forest edge."},
        {"zh": "身上是灰绿。", "en": "I wear grey-green."},
        {"zh": "肩上是一条厚围巾。", "en": "A thick scarf on my shoulders."},
        {"zh": "我蹲下看了看地面。", "en": "I crouch and study the ground."},
        {"zh": "有人刚过去。", "en": "Someone passed recently."},
        {"zh": "我抬手向后。", "en": "I signal back."},
        {"zh": "后面的人停下。", "en": "The men behind halt."},
        {"zh": "我指了指脚印。", "en": "I point at the prints."},
        {"zh": "我们跟着走。", "en": "We follow."},
        {"zh": "雪盖住了一半。", "en": "Snow has covered half."},
        {"zh": "但还看得清。", "en": "But it is still readable."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到我的围巾，我扯掉了。", "en": "Fire catches my scarf; I tear it off."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从二楼摔下去，砸在雪里。", "en": "I fall from the second floor into the snow."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "冰水灌进衣领，我往上划。", "en": "Ice water fills my collar; I claw upward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "墙塌了一半，土压在我身上。", "en": "The wall collapses; rubble covers me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西打穿了我的肩。", "en": "It punches through my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股力把我的枪压在地上。", "en": "A force pins my rifle to the ground."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "雪里没有吃的。", "en": "There is nothing to eat in the snow."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把树劈开，我伏在雪里。", "en": "Lightning splits a tree; I press into the snow."}
      ]
    }
  }
}
