{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着墙走，枪托抵着肩。", "en": "I move along the wall, stock at my shoulder."},
        {"zh": "地上有沙，脚步声很闷。", "en": "Sand muffles my steps."},
        {"zh": "我每走一段就换个姿势。", "en": "Every so often I change my stance."},
        {"zh": "低姿，快跑，再停。", "en": "Low, sprint, stop."},
        {"zh": "队伍在前面成一条线。", "en": "The squad forms a line ahead."},
        {"zh": "我在中间偏右。", "en": "I am center-right."},
        {"zh": "头盔压得很低。", "en": "My helmet sits low."},
        {"zh": "太阳把地面晒得发白。", "en": "The sun bleaches the ground."},
        {"zh": "我抬臂挡了挡光。", "en": "I raise an arm against the light."},
        {"zh": "我继续跟在他后头走。", "en": "I keep walking behind him."},
        {"zh": "前面的人蹲下，我也蹲。", "en": "The man ahead crouches; so do I."},
        {"zh": "他指了一个方向。", "en": "He points."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在墙角，枪口朝外。", "en": "I crouch at the corner, muzzle out."},
        {"zh": "我的呼吸压得很匀。", "en": "My breathing stays even."},
        {"zh": "天上没有一片云。", "en": "There is not a cloud."},
        {"zh": "风干得喉咙发紧。", "en": "The dry wind tightens my throat."},
        {"zh": "我检查了一遍弹匣的卡扣。", "en": "I check the magazine catch once more."},
        {"zh": "从胸袋里取出地图。", "en": "I take the map from my chest pocket."},
        {"zh": "我对着地图看了看。", "en": "I look over the map."},
        {"zh": "我又把地图折回去。", "en": "I fold the map away again."},
        {"zh": "前面还是那条街。", "en": "The street ahead is the same."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把枪口往旁边挪。", "en": "I move the muzzle aside."},
        {"zh": "你从那边过来。", "en": "You came from over there."},
        {"zh": "我看你的手。", "en": "I watch your hands."},
        {"zh": "你的手很干净。", "en": "Your hands are clean."},
        {"zh": "我把手抬起来，掌心朝你。", "en": "I raise my hand, palm to you."},
        {"zh": "这不是敌意。", "en": "This is not hostility."},
        {"zh": "你在我跟前停住。", "en": "You stop before me."},
        {"zh": "我朝前面点了点头。", "en": "I nod ahead."},
        {"zh": "前面街口有人。", "en": "There are people at the street corner."},
        {"zh": "你跟我后头。", "en": "Stay behind me."},
        {"zh": "我指了指自己的眼睛。", "en": "I point at my own eyes."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒在墙后喘。", "en": "I fall behind the wall, panting."},
        {"zh": "护具上有一道裂。", "en": "A crack in my kit."},
        {"zh": "小队在后头，我先按住伤口。", "en": "The squad is behind me. Let me hold the wound."},
        {"zh": "血从指缝里淌。", "en": "Blood runs between my fingers."},
        {"zh": "我把它压稳。", "en": "I steady them."},
        {"zh": "我还能战斗。", "en": "I can still fight."},
        {"zh": "我抬眼看前面。", "en": "I look up ahead."},
        {"zh": "火力压制，退到掩体。", "en": "Suppressing fire—fall back to cover."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我把那东西递回去。", "en": "I hand the thing back."},
        {"zh": "我有自己的。", "en": "I have my own."},
        {"zh": "你自己拿好。", "en": "Keep it yourself."},
        {"zh": "我把水壶拿起来。", "en": "I lift my canteen."},
        {"zh": "我喝了一口。", "en": "I take a mouthful."},
        {"zh": "我又把水递给你。", "en": "I hand the water to you again."},
        {"zh": "我这儿还多着。", "en": "I have plenty more."},
        {"zh": "我塞回袋里。", "en": "I put it back in the pouch."},
        {"zh": "我们接着往前走。", "en": "We keep moving forward."},
        {"zh": "前面的街还没清。", "en": "The street ahead is not clear."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的背。", "en": "You hit my back."},
        {"zh": "我往前倾了一下。", "en": "I tip forward."},
        {"zh": "我回头扫你一眼。", "en": "I glance back at you."},
        {"zh": "你保持距离。", "en": "Keep your distance."},
        {"zh": "你让开半步。", "en": "You give half a step."},
        {"zh": "我接着沿墙走。", "en": "I keep along the wall."},
        {"zh": "枪带压在肩上。", "en": "The sling presses my shoulder."},
        {"zh": "枪带压得很重。", "en": "The sling weighs heavy."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "等换岗以后再说。", "en": "Talk to me after the watch changes."},
        {"zh": "街对面还有火力点。", "en": "There is still a firing point across the street."},
        {"zh": "我把这些放开。", "en": "I let it go."},
        {"zh": "我打了手势。", "en": "I give the signal."},
        {"zh": "两个人往侧巷。", "en": "Two men to the side alley."},
        {"zh": "我压着枪口。", "en": "I keep the muzzle down."},
        {"zh": "等他们到位。", "en": "Waiting for them to get in place."},
        {"zh": "然后我才动。", "en": "Only then do I move."},
        {"zh": "这是现在唯一重要的事。", "en": "That is the only thing that matters now."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "弹匣口对上了，我收好。", "en": "The magazine fits; I put it away."},
        {"zh": "这口径不对。", "en": "The calibre is wrong."},
        {"zh": "我扔回原处。", "en": "I toss it back."},
        {"zh": "这个还能合用。", "en": "This one will still serve."},
        {"zh": "我塞进弹袋。", "en": "I put it in my pouch."},
        {"zh": "我把带子拉紧。", "en": "I cinch the strap tight."},
        {"zh": "我又蹲了下去。", "en": "I crouch back down."},
        {"zh": "枪口对着街上。", "en": "The muzzle faces the street."},
        {"zh": "街面上空空的。", "en": "The street is empty."},
        {"zh": "街道还空着。", "en": "The street is still empty."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "二楼窗户有反光。", "en": "A glint in the second-floor window."},
        {"zh": "我把手举高。", "en": "I lift my hand high."},
        {"zh": "全队立刻停住。", "en": "The squad halts at once."},
        {"zh": "我指着窗户。", "en": "I point at the window."},
        {"zh": "两个人分开。", "en": "Two men split off."},
        {"zh": "我靠在车后。", "en": "I take cover behind a vehicle."},
        {"zh": "把枪架在引擎盖上。", "en": "I rest the rifle on the hood."},
        {"zh": "准星压住窗框。", "en": "The sight rests on the frame."},
        {"zh": "镜片又亮了一下。", "en": "The lens glints again."},
        {"zh": "那是个观察手。", "en": "That is a spotter."},
        {"zh": "还有一个人在旁边。", "en": "There is another beside him."},
        {"zh": "我调整了一点。", "en": "I adjust slightly."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "风彻底停了。", "en": "The wind has fully dropped."},
        {"zh": "窗框上溅起一片灰。", "en": "Dust bursts off the frame."},
        {"zh": "镜片不见了。", "en": "The lens is gone."},
        {"zh": "另一个人缩回去了。", "en": "The other pulls back."},
        {"zh": "我退到车后。", "en": "I duck behind the vehicle."},
        {"zh": "子弹打在车身上。", "en": "Rounds strike the body."},
        {"zh": "枪声太响了。", "en": "The shots are too loud."},
        {"zh": "我挪了个射击位。", "en": "I shift firing position."},
        {"zh": "从轮胎下面看。", "en": "I look under the tires."},
        {"zh": "我看不见他。", "en": "I cannot see him."},
        {"zh": "我比了个手势。", "en": "I make a hand signal."},
        {"zh": "两个人绕过去。", "en": "Two men circle."},
        {"zh": "我继续压制。", "en": "I keep up the fire."},
        {"zh": "打三发，停一下。", "en": "Three rounds, then a pause."},
        {"zh": "让它们不敢抬头。", "en": "Keep their heads down."},
        {"zh": "等绕过去的人到位。", "en": "Until the flankers are set."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我冲进去，用枪托。", "en": "I rush in with the stock."},
        {"zh": "打在他的护具上。", "en": "It hits his gear."},
        {"zh": "我用肩膀撞他。", "en": "I ram him with my shoulder."},
        {"zh": "他撞在墙上。", "en": "He hits the wall."},
        {"zh": "我压住他的手臂。", "en": "I pin his arm."},
        {"zh": "他就动不了了。", "en": "He cannot move."},
        {"zh": "我一脚踢开你手里的枪。", "en": "I kick the gun out of your hands."},
        {"zh": "枪口对着门口。", "en": "The muzzle covers the doorway."},
        {"zh": "里面还有别人。", "en": "There are more inside."},
        {"zh": "我数着脚步。", "en": "I count the footsteps."},
        {"zh": "他数到第三下。", "en": "He counts the third."},
        {"zh": "还剩两个人。", "en": "Two men left."},
        {"zh": "只剩一个了。", "en": "Only one remains."},
        {"zh": "我不再等了。", "en": "I stop waiting."},
        {"zh": "我用枪托顶他的下巴。", "en": "I drive the stock into his jaw."},
        {"zh": "他仰面倒下。", "en": "He goes over on his back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "街道尽头有灰尘扬起来。", "en": "Dust rises at the end of the street."},
        {"zh": "我从墙角出来。", "en": "I come out from the corner."},
        {"zh": "头盔上有沙。", "en": "Sand on my helmet."},
        {"zh": "护具是沙色的。", "en": "My kit is sand-coloured."},
        {"zh": "我靠在门框上。", "en": "I lean against the doorframe."},
        {"zh": "看了看街两边。", "en": "I check both sides of the street."},
        {"zh": "没有旗，也没有标语。", "en": "No flag, no banner."},
        {"zh": "我只听命令。", "en": "I only take orders."},
        {"zh": "我给后面打了个手势。", "en": "I signal back."},
        {"zh": "全队向两边展开。", "en": "The squad fans out."},
        {"zh": "我走到掩体后。", "en": "I move behind cover."},
        {"zh": "枪口对着前方。", "en": "The muzzle faces ahead."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到我的袖子。", "en": "Fire catches my sleeve."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从楼上落下去，摔在沙里。", "en": "I fall from the upper floor into the sand."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进肺里，我往上挣。", "en": "Water fills my lungs; I strain upward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "墙塌下来，压住我的腿。", "en": "The wall comes down on my legs."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西打穿了我的护甲。", "en": "It punches through my armor."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股力把枪从我手里扯走。", "en": "A force tears the rifle from my hands."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "水壶空了，口粮也空了。", "en": "My canteen is dry and my rations gone."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在街面上，我贴住墙。", "en": "Lightning strikes the street; I hug the wall."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有街。", "en": "No street beneath."}
      ]
    }
  }
}
