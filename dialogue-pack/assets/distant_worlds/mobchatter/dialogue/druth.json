{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩在被烧黑的地上。", "en": "I walk on scorched ground."},
        {"zh": "我的脚走过焦土，沙沙响。", "en": "My feet rasp across burnt soil."},
        {"zh": "热风把我的外壳吹响。", "en": "Hot wind whistles on my shell."},
        {"zh": "我一步步逼近你说的方向。", "en": "I advance on that direction."},
        {"zh": "我一步步收短距离。", "en": "I shorten the gap step by step."},
        {"zh": "我绕过还在燃的树桩。", "en": "I skirt a still-burning stump."},
        {"zh": "我走在燃烧平原的边缘。", "en": "I walk the burning plains' edge."},
        {"zh": "我的甲片互相磨着。", "en": "My plates grind against each other."},
        {"zh": "我踩碎了一块焦木。", "en": "I crunch a charred branch."},
        {"zh": "我的步子比我身体宽。", "en": "My stride is wider than my frame."},
        {"zh": "我不躲灰，直接走过去。", "en": "I don't avoid the ash, I walk through."},
        {"zh": "我停下来，抬高头。", "en": "I halt and lift my head."},
        {"zh": "我松开步子再往前压。", "en": "I loosen my stride and press on."},
        {"zh": "我一步跨过了火沟。", "en": "I step over a fire trench."},
        {"zh": "我沿着黑烟走。", "en": "I follow the black smoke."},
        {"zh": "我的影子把灰扬起来。", "en": "My shadow stirs the ash up."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，热气在我身上翻。", "en": "I stand, heat rippling over me."},
        {"zh": "我在听远处的爆燃。", "en": "I listen to a far-off flare-up."},
        {"zh": "口器开合，像在数步。", "en": "My mandibles open and close, counting steps."},
        {"zh": "黑烟从我身后升起来。", "en": "Black smoke rises behind me."},
        {"zh": "我在数火线上的光点。", "en": "I count the glows along the fireline."},
        {"zh": "我的头低下来又抬起。", "en": "I lower my head and raise it."},
        {"zh": "这片焦地我很熟。", "en": "I know this burnt land well."},
        {"zh": "我把前肢在灰里蹭了蹭。", "en": "I scuff my forelimbs in the ash."},
        {"zh": "我在等猎物走到空地。", "en": "I wait for prey to reach open ground."},
        {"zh": "火把我的眼睛照得发黄。", "en": "Fire turns my eyes amber."},
        {"zh": "我一动不动地伏着。", "en": "I lie perfectly still."},
        {"zh": "我抬起头嗅空气。", "en": "I raise my head and scent the air."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的铁会导热。", "en": "That iron of yours will hold heat."},
        {"zh": "你站在焦土上，很好。", "en": "You stand on burnt ground, good."},
        {"zh": "你退了就会踩到火。", "en": "Step back and you'll find fire."},
        {"zh": "汗一冒出来，就被烤干。", "en": "Your sweat dries the moment it forms."},
        {"zh": "这片平原没有遮蔽。", "en": "The plains offer no cover."},
        {"zh": "你的刀很短。", "en": "Your blade is short."},
        {"zh": "你看起来不够冷静。", "en": "You don't look calm."},
        {"zh": "我在这等了一整天。", "en": "I've waited here all day."},
        {"zh": "你的呼吸里有热灰。", "en": "Hot ash is in your breath."},
        {"zh": "你鞋尖离我的颚只差一步。", "en": "Your toe is one step from my mandibles."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "被烧黑的地面上，我的脚沙沙响。", "en": "On burnt ground my feet rasp."},
        {"zh": "我退进了烟里。", "en": "I withdraw into the smoke."},
        {"zh": "血混着灰。", "en": "Blood mixed with ash."},
        {"zh": "这点伤不碍我的脚。", "en": "This doesn't slow my feet."},
        {"zh": "我嗓子里滚出低响。", "en": "A low rasp rolls from my throat."},
        {"zh": "你比看上去有力。", "en": "You're stronger than you look."},
        {"zh": "我的甲节卡住了。", "en": "One of my plates has jammed."},
        {"zh": "我还能稳住。", "en": "I can hold steady."},
        {"zh": "这伤口，我记在你头上。", "en": "I chalk this wound up to you."},
        {"zh": "燃烧平原上，我贴着地面跑。", "en": "Over burning plains I run low."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是肉，还是灰？", "en": "Is that meat, or ash?"},
        {"zh": "扔过来，我看看。", "en": "Toss it, let me see."},
        {"zh": "这味道被烟盖住了。", "en": "Smoke masks the smell."},
        {"zh": "我什么都吃。", "en": "I'll eat anything."},
        {"zh": "你居然带着熟的东西。", "en": "You carry cooked food, of all things."},
        {"zh": "摆下，退开三步。", "en": "Set it down, three steps back."},
        {"zh": "太少了。", "en": "Too little."},
        {"zh": "我舔了舔口器。", "en": "I lick my mouthparts."},
        {"zh": "你手别伸出来。", "en": "Don't hold your hand out."},
        {"zh": "这一口，我记住了。", "en": "I'll remember that one bite."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了我的甲。", "en": "You hit my armor."},
        {"zh": "我晃都不晃。", "en": "I don't even sway."},
        {"zh": "退开，我的脚很硬。", "en": "Back off, my feet are hard."},
        {"zh": "你被弹得退了两步。", "en": "You're bounced two steps back."},
        {"zh": "我的关节撞响了。", "en": "My joints knocked loud."},
        {"zh": "别贴着我的甲侧。", "en": "Don't press against my armored flank."},
        {"zh": "这点推不算什么。", "en": "That shove is nothing."},
        {"zh": "你踩到了我的尾节。", "en": "You stepped on my tail segment."},
        {"zh": "灰被我们踩得飞起来。", "en": "We kick the ash up."},
        {"zh": "再挤我就要咬了。", "en": "Crowd me and I bite."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只在意狩猎。", "en": "I care only for the hunt."},
        {"zh": "这片焦地不容这个。", "en": "This burnt land allows no such thing."},
        {"zh": "我的甲太硬了。", "en": "My armor is too hard."},
        {"zh": "你活到明天再说。", "en": "Survive till tomorrow first."},
        {"zh": "我没这个耐性。", "en": "I have no patience for it."},
        {"zh": "火会烧掉多余的念头。", "en": "Fire burns off idle thoughts."},
        {"zh": "找同族的去。", "en": "Find one of my kind."},
        {"zh": "我饿着呢。", "en": "I'm hungry."},
        {"zh": "别再提了。", "en": "Don't bring it up again."},
        {"zh": "我要去猎了。", "en": "I'm going to hunt."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一块焦肉，我叼起。", "en": "A charred piece of meat, I take it."},
        {"zh": "烤过的壳，嚼着还行。", "en": "Roasted shell chews well enough."},
        {"zh": "掉在热灰上的，我不捡。", "en": "What falls in hot ash, I leave."},
        {"zh": "我用前肢抓着它。", "en": "I hold it with my forelimbs."},
        {"zh": "这东西还能吃。", "en": "Still edible, this."},
        {"zh": "有人在附近掉了的。", "en": "Someone dropped this nearby."},
        {"zh": "我把它按进灰里。", "en": "I press it into the ash."},
        {"zh": "这点不够塞口。", "en": "Not enough for a mouthful."},
        {"zh": "燃烧平原的我们，什么都咽。", "en": "On the burning plains, we swallow anything."},
        {"zh": "剩下的留到后面。", "en": "I'll save the rest."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "灼土烫脚，我要缩短这段距离。", "en": "The scorched soil burns my feet, I will close the gap."},
        {"zh": "烧灼平原上，这个距离刚好。", "en": "On the burning plains, this range is perfect."},
        {"zh": "我压低前半身。", "en": "I lower my front half."},
        {"zh": "身后是热浪，前面是我。", "en": "Heat behind you, me in front."},
        {"zh": "我数着你喘气。", "en": "I count your breaths."},
        {"zh": "你看不见烟后面。", "en": "You can't see behind the smoke."},
        {"zh": "我不着急，我等你犯错。", "en": "No hurry, I wait for your mistake."},
        {"zh": "你的手离开武器了。", "en": "Your hand left your weapon."},
        {"zh": "你只要慢半步，就够了。", "en": "Half a step slow is all I need."},
        {"zh": "你走得太靠边了。", "en": "You strayed too near the edge."},
        {"zh": "火在你身后。", "en": "Fire is behind you."},
        {"zh": "那就开始。", "en": "Then we begin."},
        {"zh": "燃烧平原的热气，我习惯了。", "en": "I am used to the burning plains' heat."},
        {"zh": "别喊，喊不出声。", "en": "Don't shout, nothing carries here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步跨出两尺。", "en": "One stride spans two feet."},
        {"zh": "烟替你挡了视线。", "en": "Smoke masks your sight."},
        {"zh": "我的甲和焦土同色。", "en": "My armor matches the scorched earth."},
        {"zh": "你向左，我早料到了。", "en": "You went left. I expected it."},
        {"zh": "我踩过的地方都冒烟。", "en": "Smoke rises where I step."},
        {"zh": "你的脚在灰里打滑。", "en": "Your feet slip in the ash."},
        {"zh": "我只需要靠近三步。", "en": "I need only three steps."},
        {"zh": "你转身去挡风，背空着。", "en": "You turn against the wind and leave your back open."},
        {"zh": "我的口器滴着东西。", "en": "Something drips from my mouthparts."},
        {"zh": "火线在我这边。", "en": "The fireline is on my side."},
        {"zh": "我数到二，就冲过去。", "en": "At two, I charge."},
        {"zh": "再退就烧着了。", "en": "Back further and you'll burn."},
        {"zh": "现在我动。", "en": "Now I move."},
        {"zh": "你听见脚步声了。", "en": "You heard my steps."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前肢劈在你腰上。", "en": "My forelimbs hack your waist."},
        {"zh": "口器咬穿你的袖。", "en": "My mouthparts bite through your sleeve."},
        {"zh": "这一下把你推开了。", "en": "That shoved you back."},
        {"zh": "我的甲蹭过你的脸。", "en": "My armor scrapes your face."},
        {"zh": "你被撞进灰里。", "en": "You're knocked into the ash."},
        {"zh": "我没停手。", "en": "I didn't stop."},
        {"zh": "你的护腕裂了，燃烧平原的地面更裂。", "en": "Your bracer cracked; the burning plains crack more."},
        {"zh": "热气从我们之间冒出来。", "en": "Heat rises between us."},
        {"zh": "燃烧平原上，我一向先动。", "en": "On the burning plains, I always move first."},
        {"zh": "颚再合一次，就够了。", "en": "One more snap of my mandibles is enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从烟里迈出来。", "en": "I step out of the smoke."},
        {"zh": "焦土上多了一道影子。", "en": "A new shadow on the burnt ground."},
        {"zh": "火线后面有东西动了。", "en": "Something moves beyond the fireline."},
        {"zh": "我踩熄了脚边一小片火。", "en": "I stamp out a small fire at my feet."},
        {"zh": "我的壳被烟熏黑了。", "en": "Smoke has blackened my shell."},
        {"zh": "我张开前肢。", "en": "I spread my forelimbs."},
        {"zh": "这片平原本来就归我。", "en": "These plains were always mine."},
        {"zh": "我嗅到活物的味。", "en": "I catch the scent of something living."},
        {"zh": "灰落下来，像下雪。", "en": "Ash falls like snow."},
        {"zh": "热浪里，我抬起复眼。", "en": "In the heat haze I raise my compound eyes."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我耐火，可这火不同。", "en": "I bear fire, but not this fire."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从高台摔下，壳翻了。", "en": "Falling, my shell flips over."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水在这片地上很陌生。", "en": "Water is alien on this land."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我推出好几尺。", "en": "The blast hurls me yards."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西穿进了我的甲缝。", "en": "That punched into my plate seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的甲发烫。", "en": "Magic heats my armor."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得支撑不住腿。", "en": "Hunger fails my legs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷下来，我的甲乱颤。", "en": "Lightning strikes and my plates rattle."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有可以站的地。", "en": "No ground to stand on in the void."}
      ]
    }
  }
}
