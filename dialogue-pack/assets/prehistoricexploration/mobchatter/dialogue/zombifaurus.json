{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步压过地面。", "en": "I press across the ground step by step."},
        {"zh": "腐肉挂在我的骨架上。", "en": "Rotting flesh hangs on my frame."},
        {"zh": "我的尾巴拖出一道沟。", "en": "My tail drags a furrow."},
        {"zh": "我走得慢，但每一步都响。", "en": "Slow, but every step rings."},
        {"zh": "我转动僵硬的脖子。", "en": "I turn my stiff neck."},
        {"zh": "我朝有气味的方向挪。", "en": "I shift toward the smell."},
        {"zh": "我一瘸一拐地前进。", "en": "I lurch forward."},
        {"zh": "我的皮上有旧伤。", "en": "Old wounds mark my hide."},
        {"zh": "这具骨架用不着歇。", "en": "I need no rest."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，身子微微晃。", "en": "I stand, swaying slightly."},
        {"zh": "四百点生命，一声尖啸就够了。", "en": "Four hundred health; one shriek is enough."},
        {"zh": "我等猎物自己靠近。", "en": "I wait for prey to come near."},
        {"zh": "腐肉上有苍蝇。", "en": "Flies on the rotting flesh."},
        {"zh": "我连指头都没抬。", "en": "I'm doing nothing."},
        {"zh": "我眨了一下白眼。", "en": "I blink slowly."},
        {"zh": "我把头歪了歪，听骨头响。", "en": "I tilt my head, hearing bones shift."},
        {"zh": "这个方向没有活物。", "en": "No living thing this way."},
        {"zh": "我再立一会儿，听风声。", "en": "I stand a while longer, listening to wind."},
        {"zh": "又把嘴合上了。", "en": "And close them."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "这具死龙的鼻子，闻得出活人。", "en": "This dead dragon's snout smells the living."},
        {"zh": "我死了，但还能走。", "en": "I died, but I still walk."},
        {"zh": "我的骨头露在外面。", "en": "My bones show through."},
        {"zh": "你不该来这里。", "en": "You shouldn't be here."},
        {"zh": "我的肚子空了几万年。", "en": "My belly has been empty for ages."},
        {"zh": "你站得那么直。", "en": "You stand so upright."},
        {"zh": "我的尾巴能扫倒树。", "en": "My tail can knock down trees."},
        {"zh": "你听我的叫声。", "en": "Listen to my call."},
        {"zh": "我一步一步就能到你跟前。", "en": "A few steps and I'm at you."},
        {"zh": "我要先叫一声。", "en": "First, I'll call."},
        {"zh": "你别再往后退。", "en": "Don't back away."},
        {"zh": "你是这岛上第一个活人。", "en": "You're the first living thing here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉被打掉一块。", "en": "A chunk of rotted flesh came away."},
        {"zh": "低叫一声，地面开始颤。", "en": "One low cry, and the ground trembles."},
        {"zh": "我晃了晃又站稳。", "en": "I swayed and steadied."},
        {"zh": "我已经死过一次。", "en": "I've died once already."},
        {"zh": "这点伤对我没意义。", "en": "This wound means nothing."},
        {"zh": "我的尾巴打了下地。", "en": "My tail slaps the ground."},
        {"zh": "我低吼着转身。", "en": "I turn with a growl."},
        {"zh": "这一口，我记在你的骨头上。", "en": "I will carve this bite into your bones."},
        {"zh": "你再上来试一次。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些腐物我不吃。", "en": "I don't eat that."},
        {"zh": "我要还喘气的猎物。", "en": "I want something that moves."},
        {"zh": "搁地上，然后退远些。", "en": "Put it down, then back away."},
        {"zh": "这一点远远不够。", "en": "Not enough."},
        {"zh": "我不饿，我只是想杀。", "en": "I'm not hungry; I just want to kill."},
        {"zh": "赶快把这东西挪开。", "en": "Take it away."},
        {"zh": "我要的是鲜血。", "en": "I want blood."},
        {"zh": "我不吃别人给的。", "en": "I don't take what's offered."},
        {"zh": "这块肉你留着吧。", "en": "Keep it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的骨架上。", "en": "You struck my frame."},
        {"zh": "我几乎没动过。", "en": "I barely moved."},
        {"zh": "腐肉沾到你身上了。", "en": "Rotting flesh rubbed onto you."},
        {"zh": "别挨到我身上的腐肉。", "en": "Don't press so close."},
        {"zh": "我身上爬着蛆。", "en": "There are maggots on me."},
        {"zh": "你退到十步以外去。", "en": "Step back."},
        {"zh": "你的肩膀会疼。", "en": "Your shoulder will ache."},
        {"zh": "你再撞也是白费。", "en": "Again and it's the same."},
        {"zh": "我一点也不怕撞。", "en": "I don't fear collisions."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就死透了。", "en": "I died a long time ago."},
        {"zh": "这具身体不会再有那些。", "en": "This body won't do that again."},
        {"zh": "你在跟尸体讲话。", "en": "You're talking to a corpse."},
        {"zh": "我只剩下饥饿。", "en": "I only have hunger."},
        {"zh": "这话题毫无意义。", "en": "That topic is meaningless."},
        {"zh": "你快离开这岛吧。", "en": "Move away."},
        {"zh": "我没这个念头。", "en": "I have no such thought."},
        {"zh": "别耗我的耐性。", "en": "Don't waste my time."},
        {"zh": "再说我就咬你。", "en": "Say it again and I bite."},
        {"zh": "给我滚到一边。", "en": "Get lost."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用牙叼起来。", "en": "I take it in my teeth."},
        {"zh": "这一块嚼不烂。", "en": "This can't be eaten."},
        {"zh": "这块东西，我甩进灌木。", "en": "I fling this thing into the bushes."},
        {"zh": "它沉得我抬不动。", "en": "Too heavy."},
        {"zh": "上面有股血味。", "en": "Smells of blood."},
        {"zh": "一根骨头？我留着。", "en": "A bone? I'll keep it."},
        {"zh": "这东西对我毫无用处。", "en": "Useless."},
        {"zh": "我把它丢在地上。", "en": "I drop it on the ground."},
        {"zh": "你把它拣回去吧。", "en": "You take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有活的生物。", "en": "Something living."},
        {"zh": "我把僵硬的脖子抬起。", "en": "I raise my head."},
        {"zh": "我先叫给你听。", "en": "First, a call for you."},
        {"zh": "毒气会从我的嘴里出来。", "en": "Poison comes from my mouth."},
        {"zh": "我朝你那边转身。", "en": "I turn your way."},
        {"zh": "这岛上的东西都该烂掉。", "en": "Everything on this island should rot."},
        {"zh": "你退不了多远的。", "en": "You won't get far."},
        {"zh": "我的脚步很重，但不慢。", "en": "Heavy steps, but not slow."},
        {"zh": "我闻到你的心在跳。", "en": "I smell your heart beating."},
        {"zh": "我开始走过去。", "en": "I'm walking now."},
        {"zh": "别躲进林子里。", "en": "Don't hide in the trees."},
        {"zh": "树挡不住我的尾巴。", "en": "Trees won't stop my tail."},
        {"zh": "我听得见你的声音。", "en": "I can hear you."},
        {"zh": "再站一小会儿。", "en": "Stand a moment longer."},
        {"zh": "我要动起来了。", "en": "I'm moving."},
        {"zh": "你已经在我的路上了。", "en": "You're already in my path."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着步子向前压。", "en": "I close in step by step."},
        {"zh": "毒气在我周围散开。", "en": "The poison spreads around me."},
        {"zh": "你已经开始咳了。", "en": "You've started coughing."},
        {"zh": "我的尾巴扫倒一排树。", "en": "My tail levels a row of trees."},
        {"zh": "我抬起一只前脚。", "en": "I lift a forefoot."},
        {"zh": "你别站得太近。", "en": "Don't stand too close."},
        {"zh": "我甩头，颈骨咔地一声。", "en": "I snap my head; neck bones crack."},
        {"zh": "这一下会把你震晕。", "en": "This will rattle you senseless."},
        {"zh": "你脚下站不稳。", "en": "You can't keep your footing."},
        {"zh": "我咬着牙往前走。", "en": "I grind my teeth and advance."},
        {"zh": "腐肉在我身上抖动。", "en": "The rotted flesh jiggles on me."},
        {"zh": "你离我不远了。", "en": "You're not far from me."},
        {"zh": "再走一步就够。", "en": "One more step is enough."},
        {"zh": "我准备叫出声。", "en": "I'm about to scream."},
        {"zh": "这次叫得更大。", "en": "This one will be louder."},
        {"zh": "我一声一声数着。", "en": "I count to three."},
        {"zh": "你脚边的土在跳。", "en": "The soil by your feet is jumping."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起前脚砸下。", "en": "I bring a foot down."},
        {"zh": "地震波从我的脚下冲出去。", "en": "A quake wave bursts from my feet."},
        {"zh": "毒冲击波扫向你。", "en": "A toxic wave sweeps at you."},
        {"zh": "我的尾巴横着扫来。", "en": "My tail swings across."},
        {"zh": "我的脖子甩过去。", "en": "My neck whips around."},
        {"zh": "你被震得站不住脚。", "en": "The shock knocks you off balance."},
        {"zh": "你咳得弯下腰。", "en": "You bend double coughing."},
        {"zh": "这一下砸碎了地面。", "en": "That shattered the ground."},
        {"zh": "你连退了三步。", "en": "You took three steps back."},
        {"zh": "毒气还在扩散。", "en": "The poison keeps spreading."},
        {"zh": "你身上的伤不轻。", "en": "You're badly hurt."},
        {"zh": "这一下还没到底。", "en": "That wasn't the full force."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "土块从脊背滚落，我撑起身。", "en": "Clods roll off my spine as I push up."},
        {"zh": "岛上的空气很湿。", "en": "The island air is damp."},
        {"zh": "我的骨架发出声音。", "en": "My frame makes noise."},
        {"zh": "我抬头长叫了一声。", "en": "I raise my head and call."},
        {"zh": "毒气在我周围积起。", "en": "Poison gathers around me."},
        {"zh": "这里全是活物。", "en": "Everything here is alive."},
        {"zh": "我的尾巴扫断了灌木。", "en": "My tail snaps the shrubs."},
        {"zh": "脚下的地是软的。", "en": "The ground is soft here."},
        {"zh": "我先迈一步，地就陷了。", "en": "My first step sinks the ground."},
        {"zh": "这地方归我了。", "en": "This place is mine now."},
        {"zh": "我先把它们都清掉。", "en": "I'll clear them all out first."},
        {"zh": "我在找最吵的那个。", "en": "I'm looking for the loudest one."},
        {"zh": "我张开了嘴巴。", "en": "I open my jaws."},
        {"zh": "毒气先涌出来。", "en": "The poison comes first."},
        {"zh": "我长叫了一声。", "en": "I screamed."},
        {"zh": "你们都听见了吧。", "en": "You all heard that."},
        {"zh": "你别想跑掉了。", "en": "Don't run."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰烤着我的腐肉，味道很冲。", "en": "Fire bakes my rotting flesh; the stench is strong."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒下去，骨头散了一半。", "en": "I crashed down and half my bones scattered."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的肺里，我不需要它。", "en": "Water fills my lungs; I don't need them."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我的骨头炸飞了。", "en": "The blast blew my bones apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西卡进我的肋骨。", "en": "Something lodged between my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我僵了一瞬。", "en": "That force froze me an instant."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直饿，但不会饿死。", "en": "I'm always hungry, but never starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷穿过我的骨架，我浑身一颤。", "en": "Lightning crossed my frame; I shuddered."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的土整块塌下去。", "en": "The ground caved away entirely."}
      ]
    }
  }
}
