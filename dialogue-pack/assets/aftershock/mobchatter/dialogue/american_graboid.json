{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在泥土下面潜行。", "en": "I move under the soil."},
        {"zh": "我推着沙土往前挤。", "en": "I shove through the sand."},
        {"zh": "地面上鼓起一条土脊。", "en": "A ridge of earth rises above me."},
        {"zh": "我的身体一节一节蠕动。", "en": "My body ripples segment by segment."},
        {"zh": "我从这块地穿到那块。", "en": "I pass from one patch to the next."},
        {"zh": "我靠振动找方向。", "en": "I steer by vibration."},
        {"zh": "泥土从我身上滑落。", "en": "Soil slides off my hide."},
        {"zh": "我在地下绕开石头。", "en": "I go around stones underground."},
        {"zh": "我慢慢升到表土下面。", "en": "I rise just under the topsoil."},
        {"zh": "触须扫过前面那块石头", "en": "My tendrils sweep the stone ahead."},
        {"zh": "我沿着震动走。", "en": "I follow the tremors."},
        {"zh": "我往有脚步声的地方去。", "en": "I head toward the footfalls."},
        {"zh": "我在沙层里慢慢地挪。", "en": "I shift slowly through the sand layer."},
        {"zh": "泥土在我身上压紧。", "en": "The earth packs tight around me."},
        {"zh": "我把头抬到表土边上。", "en": "I raise my head to the topsoil."},
        {"zh": "我贴着石根往旁边走。", "en": "I pass beside the roots of stone."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我埋在地下不动。", "en": "I lie buried and still."},
        {"zh": "我等地面传来震动。", "en": "I wait for vibrations."},
        {"zh": "我的身体盘成一圈。", "en": "My body coils in a ring."},
        {"zh": "上面有东西走过。", "en": "Something walks above."},
        {"zh": "我把头埋得更深。", "en": "I sink my head deeper."},
        {"zh": "泥土里面有虫。", "en": "Worms in the soil."},
        {"zh": "我盘在土里静静等着。", "en": "I'm doing nothing."},
        {"zh": "我等着上面再来一声", "en": "I wait for one more sound above."},
        {"zh": "我的皮很干燥。", "en": "My hide is dry."},
        {"zh": "土层里再屏住一阵。", "en": "A little longer."},
        {"zh": "我盘着的这层土很软", "en": "The soil around my coil is soft."},
        {"zh": "我慢慢动了动。", "en": "I stir a little."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你脚下就是我。", "en": "You're standing on me."},
        {"zh": "我一直在听你的脚步。", "en": "I've been listening to your steps."},
        {"zh": "你每挪一步，我都听得见", "en": "Every step you shift, I hear it."},
        {"zh": "我闻不到你，但我听得到。", "en": "I can't smell you, but I hear you."},
        {"zh": "你脚下的土在响。", "en": "The soil under you is creaking."},
        {"zh": "我从下面看你的脚。", "en": "I see your feet from below."},
        {"zh": "你别跑那么快。", "en": "Don't run."},
        {"zh": "跑反而更容易被我找到。", "en": "Running only makes you easier to find."},
        {"zh": "这条地底下都是我的路。", "en": "All these tunnels are mine."},
        {"zh": "我从土里抬起头看你。", "en": "I slowly raise my head."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "土从破口里漏进我的身子", "en": "Soil spills into the tear in me."},
        {"zh": "我往深处缩去。", "en": "I retreat deeper."},
        {"zh": "这一下打到我的背。", "en": "That hit my back."},
        {"zh": "泥土被我搅乱了。", "en": "I churned up the soil."},
        {"zh": "我疼得缩成一圈。", "en": "Pain coils me up."},
        {"zh": "血渗进了泥土里。", "en": "Blood seeps into the earth."},
        {"zh": "我还在下面埋着。", "en": "I'm still below."},
        {"zh": "这点伤我还钻得动。", "en": "I can bear it."},
        {"zh": "这个坑我记住了", "en": "I mark this crater."},
        {"zh": "这一脚没踩穿我的皮", "en": "That stomp didn't break my hide."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "震动就是食物。", "en": "Vibration is food."},
        {"zh": "泥土里的东西我不吃。", "en": "I don't eat that."},
        {"zh": "你把东西放下就有声音。", "en": "Set it down and it makes a sound."},
        {"zh": "这点重量压不出响动。", "en": "That's no use to me."},
        {"zh": "活的东西更有意思。", "en": "Living things are more interesting."},
        {"zh": "你不要去动它。", "en": "Don't move it."},
        {"zh": "我只要一点点动静。", "en": "I only need a little noise."},
        {"zh": "把它放稳一点。", "en": "Set it down steady."},
        {"zh": "我正慢慢靠近。", "en": "I'm coming near."},
        {"zh": "这点动静远远不够。", "en": "Not enough."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩在我背上。", "en": "You stepped on my back."},
        {"zh": "你的重量压得我缩了缩", "en": "Your weight presses me down."},
        {"zh": "地面塌了一小块。", "en": "A patch of ground caved in."},
        {"zh": "你差点掉进来。", "en": "You almost fell in."},
        {"zh": "我在下面，你在上面。", "en": "I'm below; you're above."},
        {"zh": "这点重量我受得住。", "en": "I can bear that weight."},
        {"zh": "别在松土上跳。", "en": "Don't jump on loose soil."},
        {"zh": "我被压得往旁边挪。", "en": "I shift sideways under the pressure."},
        {"zh": "泥土翻开来了。", "en": "The soil turned over."},
        {"zh": "你把脚跟钉住别滑。", "en": "Steady yourself."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们靠震动找彼此。", "en": "We find each other by vibration."},
        {"zh": "地下很深的地方更合适。", "en": "Deeper underground is better."},
        {"zh": "你身上没有那样的震动。", "en": "You don't make that kind of tremor."},
        {"zh": "这条土层够宽。", "en": "This stratum is wide enough."},
        {"zh": "我们等下过雨。", "en": "We'll wait for the rain."},
        {"zh": "别在地面上闹。", "en": "Don't make noise above ground."},
        {"zh": "等土温上来再说。", "en": "Slowly."},
        {"zh": "土层还不够暖。", "en": "Not yet."},
        {"zh": "我只想安静地等。", "en": "I only want to wait quietly."},
        {"zh": "你顺着土坡离开吧。", "en": "Go on."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它拖到地下去。", "en": "I drag it underground."},
        {"zh": "这东西会发出响声。", "en": "This thing is making noise."},
        {"zh": "泥土把它盖住了。", "en": "Soil covers it."},
        {"zh": "这东西咽进肚里发涩。", "en": "Not food."},
        {"zh": "它沉得我推不动。", "en": "Too heavy."},
        {"zh": "它会引来别的东西。", "en": "It will draw others."},
        {"zh": "这东西掉下来就没声了", "en": "It fell silent when it dropped."},
        {"zh": "它一点震动也没有。", "en": "It gives no vibration."},
        {"zh": "没有震动的东西，不要", "en": "No vibration? Then no."},
        {"zh": "就留在地上吧。", "en": "Leave it above."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有脚步进来了。", "en": "Footsteps came in."},
        {"zh": "我跟着那个节奏。", "en": "I keep to that rhythm."},
        {"zh": "我顶起一小片草皮", "en": "I lift a patch of turf."},
        {"zh": "我朝那个方向去。", "en": "I go that way."},
        {"zh": "它在这块土上面。", "en": "It's on this patch of ground."},
        {"zh": "我从你脚跟后面翻上来", "en": "I come up behind your heels."},
        {"zh": "整条身子绷成一根弦", "en": "My whole body pulls taut."},
        {"zh": "震动就在这块土上面", "en": "The vibration is right above this patch."},
        {"zh": "我要升上去了。", "en": "I'm coming up."},
        {"zh": "那就把这层土翻起来。", "en": "Begin."},
        {"zh": "你不要再乱动。", "en": "Don't move."},
        {"zh": "我已经钻到脚下了。", "en": "Here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一路跟着震动。", "en": "I follow the tremors."},
        {"zh": "它往左边去了。", "en": "It went left."},
        {"zh": "我爬得快了些。", "en": "I sped up a little."},
        {"zh": "泥土正在往下陷。", "en": "The soil is sinking."},
        {"zh": "这层土我闭眼都熟。", "en": "I know this route."},
        {"zh": "我从它脚下穿过。", "en": "I pass beneath its feet."},
        {"zh": "它的脚步停住了。", "en": "It stopped."},
        {"zh": "我等着它再动。", "en": "I wait for it to move again."},
        {"zh": "这个落点刚刚好。", "en": "This distance is right."},
        {"zh": "我在下面绕圈。", "en": "I circle below."},
        {"zh": "它开始跑起来。", "en": "It started running."},
        {"zh": "趁它还没挪开脚。", "en": "Now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土里冲出来。", "en": "I burst up through the soil."},
        {"zh": "我已经咬住它了！", "en": "Got a hold!"},
        {"zh": "这一口能拖倒它。", "en": "This bite can drag it down."},
        {"zh": "我把它往地下拽。", "en": "I haul it toward the earth."},
        {"zh": "泥土全翻开了。", "en": "The soil explodes upward."},
        {"zh": "我的触须缠住它。", "en": "My tendrils wrap it."},
        {"zh": "它被拉进坑里。", "en": "It's pulled into the pit."},
        {"zh": "你不要乱挣扎。", "en": "Don't struggle."},
        {"zh": "我松开一点点。", "en": "I loosen a little."},
        {"zh": "再往更深处拖。", "en": "Drag it deeper."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从深土里升上来。", "en": "I rise from deep soil."},
        {"zh": "这一带的土很松软。", "en": "The ground is soft here."},
        {"zh": "让我先听一听。", "en": "Let me listen first."},
        {"zh": "上面没有声音。", "en": "Nothing above."},
        {"zh": "泥土的味道很干。", "en": "The soil smells dry."},
        {"zh": "我在这层土里伸开身子", "en": "I stretch out in this layer of soil."},
        {"zh": "我在找一条路。", "en": "I'm looking for a route."},
        {"zh": "上面传来脚步的震动。", "en": "Footsteps far off."},
        {"zh": "夜里更方便行动。", "en": "Night is better."},
        {"zh": "我再等一小会儿。", "en": "I'll wait."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到土里，我的皮都焦了。", "en": "Fire reached into the soil; my hide burned."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土里被掀出来，重重摔在地上。", "en": "I was torn out of the earth and dropped hard."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我钻出的洞。", "en": "Water pours into my tunnel."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把整片土翻起来。", "en": "The blast turned the whole patch over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我露出的身体。", "en": "Something pierced my exposed body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股震感很怪，不是脚步。", "en": "That tremor is wrong; not a footfall."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我找不到震动，饿得发慌。", "en": "No vibrations; hunger gnaws at me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打进土里，我全身一抽。", "en": "Lightning struck the ground; my body convulsed."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面的土忽然没有了。", "en": "The soil beneath vanished."}
      ]
    }
  }
}
