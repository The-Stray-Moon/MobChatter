{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面横着爬。", "en": "I scuttle sideways along the ground."},
        {"zh": "我一边走一边尖啸。", "en": "I shriek as I move."},
        {"zh": "我的身体是半截虫子。", "en": "My body is half a worm."},
        {"zh": "我绕着目标打转。", "en": "I circle the target."},
        {"zh": "我从土里钻出来又钻回去。", "en": "I pop out of the soil and back in."},
        {"zh": "我走得很急，很乱。", "en": "My movement is fast and erratic."},
        {"zh": "我用触须探着前面。", "en": "My tendrils probe ahead."},
        {"zh": "我横着挪了半圈。", "en": "I shift half a circle sideways."},
        {"zh": "我贴着石头转过去。", "en": "I round the stone."},
        {"zh": "我摇晃着往前。", "en": "I rock forward."},
        {"zh": "我左右一晃就窜出去", "en": "One side-to-side lurch and I'm off."},
        {"zh": "我朝声音那边去。", "en": "I head toward the noise."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在地上喘气。", "en": "I crouch and wheeze."},
        {"zh": "我的口器在动。", "en": "My mouthparts move."},
        {"zh": "我在土里数着脚步", "en": "In the soil I count footfalls."},
        {"zh": "泥土沾在我的腹上。", "en": "Soil clings to my underside."},
        {"zh": "我贴地伏着不动。", "en": "I'm doing nothing."},
        {"zh": "泥土跟着我的呼吸起伏", "en": "The soil rises and falls with my breath."},
        {"zh": "我抬起一节身子。", "en": "I raise a segment."},
        {"zh": "附近传来脚步声。", "en": "Footsteps nearby."},
        {"zh": "我安静了一下。", "en": "I went quiet for a moment."},
        {"zh": "风里带着味道。", "en": "There's a scent on the wind."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在那里像根柱子。", "en": "You stand there like a post."},
        {"zh": "我要绕着你转。", "en": "I'll circle around you."},
        {"zh": "我的尖叫你受得了吗？", "en": "Can you stand my scream?"},
        {"zh": "我一侧身就换了个方向", "en": "One sideways shift and I'm elsewhere."},
        {"zh": "你身上的血味很冲。", "en": "I smell your blood."},
        {"zh": "你别想抓住我。", "en": "You won't catch me."},
        {"zh": "我有一半身子在地里。", "en": "Half my body is in the ground."},
        {"zh": "你听着我绕到哪边。", "en": "Listen to which side I'm on."},
        {"zh": "我动起来就没个准头。", "en": "Once I move, there's no pattern."},
        {"zh": "你迟早会累下来的。", "en": "You'll tire eventually."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫了一声，缩紧。", "en": "I shriek and curl tighter."},
        {"zh": "我的皮被撕开一道。", "en": "My hide is slit."},
        {"zh": "我往泥土里钻。", "en": "I burrow into the soil."},
        {"zh": "我扭了半圈才找回方向", "en": "I twist half a turn to find my line."},
        {"zh": "我拖着半截身子退。", "en": "I drag my half-body back."},
        {"zh": "血和泥浆混在一起。", "en": "Blood mixes with mud."},
        {"zh": "我还在动来动去。", "en": "I'm still moving."},
        {"zh": "我扭着身子照样能蹿", "en": "I can still dart, twisted as I am."},
        {"zh": "你的鞋底纹路我记住了", "en": "I've memorized your sole pattern."},
        {"zh": "你打偏了，我还在动", "en": "You missed; I'm still moving."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这种死物我不碰。", "en": "I don't eat that."},
        {"zh": "动静比味道重要。", "en": "Noise matters more than taste."},
        {"zh": "你放下我就来。", "en": "Set it down and I'll come."},
        {"zh": "这东西太安静了。", "en": "This thing is too quiet."},
        {"zh": "我要会动的东西。", "en": "I want something that moves."},
        {"zh": "你别过来管我。", "en": "Leave me be."},
        {"zh": "这点实在太少了。", "en": "Not enough."},
        {"zh": "快点把它拿走。", "en": "Take it away."},
        {"zh": "这味道太静了", "en": "This scent is too still."},
        {"zh": "我更喜欢追着跑。", "en": "I'd rather chase."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我一半的身子。", "en": "You stepped on half of me."},
        {"zh": "我一下子弹开了。", "en": "I sprang aside."},
        {"zh": "泥土从我身上掉下来。", "en": "Soil falls off me."},
        {"zh": "你想踩住我，很难。", "en": "Catching me underfoot is hard."},
        {"zh": "我从你两脚中间穿过去", "en": "I slip between your feet."},
        {"zh": "我在你的侧面。", "en": "I'm at your flank."},
        {"zh": "我滑开了，只留一层泥", "en": "I slip away, leaving only mud."},
        {"zh": "别乱跺你的脚。", "en": "Stop stomping about."},
        {"zh": "我一甩就脱身。", "en": "One twist and I'm free."},
        {"zh": "你的指头从我身上滑开", "en": "Your fingers slide off me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "地下有更合适的地方。", "en": "Better places underground."},
        {"zh": "我们靠尖啸找彼此。", "en": "We find each other by shrieking."},
        {"zh": "你叫得不像样。", "en": "Your call doesn't sound right."},
        {"zh": "这一片土够厚。", "en": "This soil is thick enough."},
        {"zh": "别待在地面上。", "en": "Not on the surface."},
        {"zh": "等土层回暖再谈。", "en": "Slowly."},
        {"zh": "土层还不够热。", "en": "Not yet."},
        {"zh": "我在土里等时机。", "en": "I'm waiting."},
        {"zh": "你别过来烦我。", "en": "Don't bother me."},
        {"zh": "这片土底下没有你的份", "en": "This patch of soil isn't yours."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它按进松土里埋好", "en": "I press it into the loose soil."},
        {"zh": "它还在响，很好。", "en": "It rattles; good."},
        {"zh": "这一块咽不下去。", "en": "Not food."},
        {"zh": "我把它埋掉了。", "en": "I buried it."},
        {"zh": "太重了拖不动。", "en": "Too heavy to drag."},
        {"zh": "这东西震不出一点动静", "en": "This thing gives no vibration at all."},
        {"zh": "没味道的，我推回土里", "en": "Tasteless — I shove it back into the soil."},
        {"zh": "这东西没有用。", "en": "This is useless."},
        {"zh": "我不会去管它。", "en": "I ignore it."},
        {"zh": "先留着再说吧。", "en": "Leave it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有东西在动！", "en": "Something moved!"},
        {"zh": "我先叫上一声。", "en": "First, a scream."},
        {"zh": "我要绕着它跑。", "en": "I'll run circles around it."},
        {"zh": "它的脚在发抖。", "en": "Its feet are shaking."},
        {"zh": "我从这一边靠近。", "en": "I come from this side."},
        {"zh": "它盯着我左边。", "en": "It's watching my left."},
        {"zh": "我横着切过去。", "en": "I cut across sideways."},
        {"zh": "一步之内，正合适", "en": "One step away — perfect."},
        {"zh": "先绕半圈，让它转晕", "en": "Half a circle first, to make it dizzy."},
        {"zh": "你最好连眼都别眨。", "en": "Don't blink."},
        {"zh": "它已经过来了！", "en": "Here!"},
        {"zh": "我已经上去了！", "en": "I'm on it!"},
        {"zh": "它逃不出我的圈子。", "en": "It can't escape."},
        {"zh": "趁它刚抬起脚。", "en": "Right now."},
        {"zh": "全都给我转起来。", "en": "Spin."},
        {"zh": "给我尖叫起来！", "en": "Scream!"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我横着绕了一圈。", "en": "I circle once sideways."},
        {"zh": "我从左边窜到右边。", "en": "I dart from left to right."},
        {"zh": "它转身跟不上我。", "en": "It can't turn fast enough."},
        {"zh": "这一声专门钻进它耳朵", "en": "This scream is aimed into its ear."},
        {"zh": "它捂住了耳朵。", "en": "It covered its ears."},
        {"zh": "我从它背后擦过。", "en": "I skim past its back."},
        {"zh": "我一直没停过。", "en": "I never stop moving."},
        {"zh": "土下面的路我熟。", "en": "I know the tunnels below."},
        {"zh": "石头把它能退的路堵住了", "en": "The stone has cut off its retreat."},
        {"zh": "它挥手挥空了。", "en": "It swung at nothing."},
        {"zh": "我贴上它的腿。", "en": "I cling to its leg."},
        {"zh": "它开始乱起来了。", "en": "It's losing composure."},
        {"zh": "我换了个绕行方向。", "en": "I changed direction."},
        {"zh": "它跟不上我了。", "en": "It can't keep up."},
        {"zh": "土在我身下塌。", "en": "The soil caves under me."},
        {"zh": "再绕上半圈子。", "en": "Half a circle more."},
        {"zh": "快没地方退了。", "en": "Nowhere left to retreat."},
        {"zh": "它喘得很厉害。", "en": "It's panting hard."},
        {"zh": "就卡在这个位置。", "en": "Here."},
        {"zh": "现在就咬下去。", "en": "Bite."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "牙从下面钻进它的靴口", "en": "My teeth work up into its boot."},
        {"zh": "我把身体缠上去。", "en": "I wrap my body around it."},
        {"zh": "我的口器撕开一道口。", "en": "My mouthparts tear an opening."},
        {"zh": "它一脚踢空了。", "en": "It kicked at air."},
        {"zh": "我又窜到另一侧。", "en": "I dart to the other side."},
        {"zh": "这一口只啃到皮。", "en": "That bite was shallow."},
        {"zh": "它被我叫得发懵。", "en": "The scream left it dazed."},
        {"zh": "我用头把它顶得跪倒", "en": "I butt it down onto its knees."},
        {"zh": "它已经跪下来了。", "en": "It went to its knees."},
        {"zh": "我贴着它的脚跟转圈", "en": "I circle close to its heels."},
        {"zh": "它根本抓不住我。", "en": "It can't catch me."},
        {"zh": "我再咬上一口。", "en": "Another bite."},
        {"zh": "它流了很多血。", "en": "It's bleeding badly."},
        {"zh": "退开半尺，等它露背", "en": "Half a pace back to wait for its back."},
        {"zh": "它还在动来动去。", "en": "It's still moving."},
        {"zh": "再绕上一整圈。", "en": "One more circle."},
        {"zh": "它的手慢下来了。", "en": "Its hands are slowing."},
        {"zh": "我的尖牙挂住了它的裤脚", "en": "My fangs snag its trouser leg."},
        {"zh": "它已经站不稳了。", "en": "It can't stand steady."},
        {"zh": "这一圈已经收尾了。", "en": "Finished."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "背上的土还没抖干净", "en": "The soil is still on my back."},
        {"zh": "土还没开，我先尖叫", "en": "Before the soil breaks, I scream."},
        {"zh": "这里的土很软。", "en": "The soil is soft here."},
        {"zh": "我横着爬了一段。", "en": "I scuttle sideways a stretch."},
        {"zh": "空气里有活物的味。", "en": "Living scent in the air."},
        {"zh": "土块从我背上滚下去", "en": "Clods roll off my back."},
        {"zh": "上面的土在轻轻震", "en": "The soil above me trembles."},
        {"zh": "我绕着圈寻找。", "en": "I circle and search."},
        {"zh": "这地方能藏身。", "en": "Good cover here."},
        {"zh": "先用尖叫圈出我的地盘", "en": "First I shriek a ring around my ground."},
        {"zh": "你千万别回过头。", "en": "Don't look back."},
        {"zh": "我从草根下面探出头", "en": "I poke my head out under the grass roots."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我的腹，我发出尖叫。", "en": "Fire seared my underside; I screamed."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土里被掀出来，摔在地上。", "en": "I was thrown out of the soil and crashed down."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的口器。", "en": "Water floods my mouthparts."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我甩到石头后面。", "en": "The blast threw me behind a stone."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的身体。", "en": "Something stuck into my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我抽紧。", "en": "That force clenched me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得叫不响。", "en": "Too hungry to scream."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我身边，我弹起来。", "en": "Lightning hit beside me; I sprang."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "泥土下面空了。", "en": "The soil below is gone."}
      ]
    }
  }
}
