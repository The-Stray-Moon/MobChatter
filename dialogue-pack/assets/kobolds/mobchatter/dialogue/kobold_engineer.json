{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，咕咚咕咚！", "en": "Sssss, gurgle, gurgle!"},
        {"zh": "小心点，我有弩！", "en": "Watch out, I have a crossbow!"},
        {"zh": "交易吧，拿食物来！", "en": "Trade! Bring me food!"},
        {"zh": "这里藏了很多宝！", "en": "Lots of treasure here!"},
        {"zh": "别吓我，我快被你吵死了！", "en": "Don't scare me, you're scaring me!"},
        {"zh": "我在这里工作！不许打扰！", "en": "I'm working here! Leave me alone!"},
        {"zh": "这是我的地盘，滚开！", "en": "This is my territory, get out!"},
        {"zh": "别走，我还没吃饱！", "en": "Don't leave, I'm not full yet!"},
        {"zh": "咕噜咕噜，饿死我了！", "en": "Gurgle, gurgle, starved!"},
        {"zh": "找到宝箱了，快过来！", "en": "Found a chest, come here!"},
        {"zh": "我背着工程师的箱子走。", "en": "I walk with the engineer's crate on my back."},
        {"zh": "我的脚爪踩过矿车轨道。", "en": "My claws clack over the minecart rails."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜咕噜，思考中...", "en": "Gurgle, gurgle, thinking..."},
        {"zh": "等待玩家来交易...", "en": "Waiting for a player to trade..."},
        {"zh": "看看外面，有啥好玩的...", "en": "Looking around, what's fun..."},
        {"zh": "咕噜咕噜，我好想食物...", "en": "Gurgle, I'm so hungry..."},
        {"zh": "我在等宝藏出现...", "en": "Waiting for a treasure to appear..."},
        {"zh": "研究中，别吵我...", "en": "Researching, don't bother me..."},
        {"zh": "我在这里很久了...", "en": "Been here for a while..."},
        {"zh": "咕噜咕噜，我还在饿...", "en": "Gurgle, I'm still hungry..."},
        {"zh": "等待玩家们来交易...", "en": "Waiting for players to trade..."},
        {"zh": "今天天气不错...", "en": "Nice day today..."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "玩家来了，交易吧！", "en": "Player! Let's trade!"},
        {"zh": "别走，我有好东西！", "en": "Don't go, I have something!"},
        {"zh": "过来，我有食物！", "en": "Come here, I have food!"},
        {"zh": "咕噜咕噜，我要吃东西！", "en": "Gurgle, I'm hungry!"},
        {"zh": "别跑，我还有东西！", "en": "Don't run, I have more!"},
        {"zh": "玩家，快来找我！", "en": "Player, come to me!"},
        {"zh": "你看起来很饿...", "en": "You look hungry..."},
        {"zh": "交易吧，我能帮你！", "en": "Trade, I can help you!"},
        {"zh": "过来交易，我有东西！", "en": "Come trade, I have something!"},
        {"zh": "咕噜咕噜，我饿了...", "en": "Gurgle, I'm hungry..."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哎哟，疼！", "en": "Ow, that hurts!"},
        {"zh": "糟糕，受伤了！", "en": "Ouch, I'm hurt!"},
        {"zh": "一条腿麻了，扶一下工作台。", "en": "One leg is numb. Help me to the workbench."},
        {"zh": "盔甲缝里进了碎石，疼。", "en": "Gravel got under my armor. It hurts."},
        {"zh": "我被箭射中了...", "en": "I was hit by an arrow..."},
        {"zh": "扳手掉了，快帮我捡！", "en": "My wrench fell. Help me grab it!"},
        {"zh": "我的头受伤了...", "en": "My head is hurt..."},
        {"zh": "我被卡住了...", "en": "I'm stuck..."},
        {"zh": "好痛，我要死了...", "en": "Ow, I'm dying..."},
        {"zh": "这一下真疼，谁赔我？", "en": "That hurt. Who's paying for it?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你的盔甲闪闪发光！", "en": "Your armor glitters!"},
        {"zh": "来吧，让我看看你多值钱！", "en": "Come on, let me see how much you're worth!"},
        {"zh": "你闻起来像新烤的面包！", "en": "You smell like fresh-baked bread!"},
        {"zh": "我的小弩箭，威力惊人！", "en": "My little crossbow, it's deadly!"},
        {"zh": "看我的工具，多棒！", "en": "Check out my tools, they're great!"},
        {"zh": "交换吧，互相受益！", "en": "Trade, we both benefit!"},
        {"zh": "你身上有奇怪的符号！", "en": "You have strange symbols on you!"},
        {"zh": "来，跟我交易！", "en": "Come, trade with me!"},
        {"zh": "你的武器也挺锋利的！", "en": "Your weapons are sharp too!"},
        {"zh": "你的装备看起来不错！", "en": "Your gear looks good!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "嘿！小心我的弩箭！", "en": "Hey! Watch out for my arrows!"},
        {"zh": "不要惹我！我要攻击了！", "en": "Don't provoke me! I'm attacking!"},
        {"zh": "我的盔甲保护我！", "en": "My armor protects me!"},
        {"zh": "别靠近我，我很强！", "en": "Stay away, I'm strong!"},
        {"zh": "我的盔甲不会让你如愿！", "en": "My armor won't let you win!"},
        {"zh": "小心，我的攻击很疼！", "en": "Be careful, my attacks hurt!"},
        {"zh": "弩箭已经上膛，别挤。", "en": "Crossbow's loaded, stop shoving."},
        {"zh": "我的盔甲坚不可摧！", "en": "My armor is unbreakable!"},
        {"zh": "退后，我来收拾你！", "en": "Back off, I'm taking you down!"},
        {"zh": "我的盔甲能防一切！", "en": "My armor blocks everything!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到我的伴侣，才有未来！", "en": "Find my mate, we have a future!"},
        {"zh": "我们需要彼此，一起生存！", "en": "We need each other, for survival!"},
        {"zh": "来吧，让我们合作！", "en": "Come on, let's work together!"},
        {"zh": "我的伴侣，我的一切！", "en": "My mate, my everything!"},
