        {"zh": "一起繁衍后代，才有明天！", "en": "Procreate for the future!"},
        {"zh": "我们需要更多同伴！", "en": "We need more companions!"},
        {"zh": "找到我的伴侣，才能延续！", "en": "Find my mate, for continuity!"},
        {"zh": "我的伴侣，共享我的财富！", "en": "My mate, share my wealth!"},
        {"zh": "找到我的伴侣，才有希望！", "en": "Find my mate, for hope!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，猎物来了！", "en": "Sssss, prey!"},
        {"zh": "给我滚开，不想要的就留下！", "en": "Move, or I'll keep what you don't want!"},
