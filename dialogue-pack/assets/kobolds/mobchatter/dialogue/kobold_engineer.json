        {"zh": "给我滚，否则我射你！", "en": "Away or I shoot!"},
        {"zh": "我的工程师交易表价值连城！", "en": "My engineer chart is priceless!"},
        {"zh": "小心，我的弩箭要射了！", "en": "Be careful, my arrow is coming!"},
        {"zh": "交易吧，否则你吃弩箭！", "en": "Trade or you get an arrow!"},
        {"zh": "别逼我用弩射你！", "en": "Don't逼me use the bow!"},
        {"zh": "用我的交易表换点吃的吧！", "en": "Use my chart for food!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "找到了，快吃掉！", "en": "Found you, eat!"},
        {"zh": "猎物落入我的弩中！", "en": "Prey in my bow!"},
        {"zh": "弩上弦了，别站在准星里。", "en": "Crossbow is cocked. Do not stand in the sights."},
        {"zh": "你逃不掉的，我会射死你！", "en": "You can't escape, I'll shoot you!"},
        {"zh": "现在尝尝我的弩箭吧！", "en": "Try my arrow now!"},
        {"zh": "你的命就在这根箭上！", "en": "Your life on this arrow!"},
        {"zh": "别动，我已经瞄准你了！", "en": "Don't move, I'm aiming!"},
        {"zh": "我的弩箭已锁定你！", "en": "My arrow locked on you!"},
        {"zh": "你逃不掉的，看我的！", "en": "You can't escape, watch me!"},
        {"zh": "瞄准了，一箭毙命！", "en": "Aim, one shot kills!"},
        {"zh": "你的紫水晶我收下了。", "en": "I'll take those amethyst shards."},
        {"zh": "别碰我的工程台。", "en": "Don't touch my workbench."},
        {"zh": "你踩坏了我的线路。", "en": "You trampled my wiring."},
        {"zh": "站住，先让我看看货。", "en": "Halt, let me see your goods first."},
        {"zh": "我数着你的脚步声呢。", "en": "I'm counting your footsteps."},
        {"zh": "我的弩已经上弦了。", "en": "My crossbow is already drawn."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
