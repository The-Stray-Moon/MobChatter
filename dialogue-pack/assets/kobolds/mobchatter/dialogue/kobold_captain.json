{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，跟我战斗吧！", "en": "Hisss, fight me!"},
        {"zh": "宝藏就在附近！", "en": "Treasure nearby!"},
        {"zh": "我的船员呢？！", "en": "Where are my crew?"},
        {"zh": "紫水晶是我的，巢也归我管。", "en": "The amethyst is mine, and so is this burrow."},
        {"zh": "快拿东西出来交易！", "en": "Come with what you have!"},
        {"zh": "我的三本账还没结清。", "en": "Three ledgers are still unsettled."},
        {"zh": "我的剑锋利无比！", "en": "My sword is sharp!"},
        {"zh": "我有最古老的魔法！", "en": "I have ancient magic!"},
        {"zh": "你是我的新船员吗？", "en": "A new crew member?"},
        {"zh": "宝藏就在我的船舱里！", "en": "Treasure is in my ship!"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这守护着宝藏！", "en": "Guarding the treasure!"},
        {"zh": "我的剑从未空闲！", "en": "My sword is always busy!"},
        {"zh": "宝藏属于我，只有我！", "en": "Treasure is mine, only mine!"},
        {"zh": "没人能夺走我的宝藏！", "en": "No one takes my treasure!"},
        {"zh": "我是这里的霸主！", "en": "I'm the ruler here!"},
        {"zh": "宝藏是永恒的！", "en": "Treasure is eternal!"},
        {"zh": "我的宝藏无价！", "en": "My treasure is priceless!"},
        {"zh": "我是狗头人之王！", "en": "I'm the Kobold King!"},
        {"zh": "紫水晶碎片，先摆到桌上。", "en": "Amethyst shards on the table first."},
        {"zh": "宝藏是永恒的财富！", "en": "Treasure is eternal wealth!"},
        {"zh": "紫晶碎片在箱子里闪光。", "en": "Amethyst shards glint in the chest."},
        {"zh": "数着巢穴里的存货。", "en": "I count the stock in the lair."},
        {"zh": "这条矿道通向我的金库。", "en": "This tunnel leads to my vault."},
        {"zh": "船员们都下去挖矿了。", "en": "My crew are all down in the mines."},
        {"zh": "擦一擦剑上的煤灰。", "en": "I wipe the coal dust off my blade."},
        {"zh": "地底的寂静让我安心。", "en": "The silence underground puts me at ease."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰过我的紫水晶，我闻得出。", "en": "I can smell that you touched my amethyst."},
        {"zh": "你发现了我的宝藏？", "en": "Found my treasure?"},
        {"zh": "你不想试试吗？", "en": "You want to try?"},
        {"zh": "你来了找死吗？", "en": "You're here to die?"},
        {"zh": "我不会让你活着离开！", "en": "You won't leave alive!"},
        {"zh": "生面孔，先报上你的来意。", "en": "New face, state your business first."},
        {"zh": "先谈价，谈不拢就拔剑。", "en": "Let's talk price first. Then swords."},
        {"zh": "想交易就掏紫水晶，别空手。", "en": "Want to trade? Bring amethyst, not empty hands."},
        {"zh": "你让我很感兴趣！", "en": "You intrigue me!"},
        {"zh": "你注定要死在这里！", "en": "You're doomed here!"},
        {"zh": "你身上的紫晶很眼熟。", "en": "The amethyst on you looks familiar."},
        {"zh": "生面孔，报上名来。", "en": "A new face. State your name."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "呜呜，我不能再航行了。", "en": "Aaaah, I can't captain anymore."},
        {"zh": "我的船舱被摧毁了。", "en": "My ship's destroyed."},
        {"zh": "我失去了方向，呜。", "en": "I'm lost, ugh."},
        {"zh": "我的宝藏被偷走了。", "en": "My treasure's gone."},
        {"zh": "我要回到巢穴，养好伤。", "en": "Back to the nest to heal."},
        {"zh": "我的剑被夺走了。", "en": "My sword's taken."},
        {"zh": "我需要找到我的船。", "en": "I need my ship."},
        {"zh": "我的船舱破损了。", "en": "My ship's damaged."},
        {"zh": "我需要更多船木。", "en": "More shipwood needed."},
        {"zh": "船舱需要修理。", "en": "Ship needs repairs."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我有宝藏！", "en": "I have treasures!"},
        {"zh": "交出你的剑！", "en": "Give me your sword!"},
        {"zh": "别怕，做我船员。", "en": "Don't be afraid, join my crew."},
        {"zh": "看看我的船！", "en": "Look at my ship!"},
        {"zh": "给我滚开", "en": "Get away from me!"},
        {"zh": "紫水晶碎片，换不换？", "en": "Amethyst shards — trade or not?"},
        {"zh": "加入我，升职加薪。", "en": "Join me, get promoted."},
        {"zh": "你闻到宝藏的味道了吗？", "en": "Can you smell the treasure?"},
        {"zh": "我的船长命令你。", "en": "The captain orders you."},
        {"zh": "拿紫晶来，我给你好价。", "en": "Bring amethyst and I will give you a fair price."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞上船长，算你倒霉", "en": "Bumping into the captain is your bad luck."},
        {"zh": "我来教训你！", "en": "I'll teach you a lesson!"},
        {"zh": "挡路者死！", "en": "Die, obstacle!"},
        {"zh": "紫水晶碎片，拿来再说话。", "en": "Amethyst shards first, then we talk."},
        {"zh": "我的剑锋锐！", "en": "My sword is sharp!"},
        {"zh": "你太弱了！", "en": "You're too weak!"},
        {"zh": "战斗吧，勇士！", "en": "Fight, warrior!"},
        {"zh": "退到船尾去，那里窄。", "en": "Back to the stern; it's narrow there."},
        {"zh": "你活该！", "en": "You deserved it!"},
        {"zh": "我把剑横在货箱前面。", "en": "I lay my sword across the cargo crates."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的配偶在哪？", "en": "Where's my mate?"},
        {"zh": "我们要繁衍后代。", "en": "We need to reproduce."},
        {"zh": "找到配偶很重要。", "en": "Finding a mate is important."},
        {"zh": "我需要个伴。", "en": "I need a partner."},
        {"zh": "和我一起吧。", "en": "Be with me."},
        {"zh": "我的配偶呢？", "en": "Where's my mate?"},
        {"zh": "我们需要繁殖。", "en": "We need to breed."},
        {"zh": "配偶很重要。", "en": "Mate is important."},
        {"zh": "找我的配偶。", "en": "Find my mate."},
        {"zh": "一起生活。", "en": "Live together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "别翻我的箱子，鱼会掉。", "en": "Stop digging in my chest; the fish will spill."},
        {"zh": "找死吗？", "en": "Want to die?"},
        {"zh": "这是我的船舱！", "en": "This is my cabin!"},
        {"zh": "你闻闻这些鱼！", "en": "Smell these fish!"},
        {"zh": "我的宝藏在这里！", "en": "My treasure here!"},
        {"zh": "这条鱼干，是船长我的。", "en": "This dried fish belongs to me, the captain."},
        {"zh": "我可是船长！", "en": "I'm the captain!"},
        {"zh": "这些是船上的食物！", "en": "Food from the ship!"},
        {"zh": "别惹我，狗东西！", "en": "Don't anger me, dog!"},
        {"zh": "这矿石归巢穴所有。", "en": "This ore belongs to the lair."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "找到了！", "en": "Found you!"},
        {"zh": "给我跪下！", "en": "Kneel to me!"},
        {"zh": "准备被打败吧！", "en": "Prepare to be defeated!"},
        {"zh": "我要你屈服！", "en": "Make you submit!"},
        {"zh": "这船板下面全是我的货。", "en": "Under these planks lies all my cargo."},
        {"zh": "来吧，战斗！", "en": "Come, fight me!"},
        {"zh": "你的命不值钱！", "en": "Your life is cheap!"},
        {"zh": "矿道口被我的手下堵住了。", "en": "My crew has blocked the tunnel mouth."},
        {"zh": "我的剑比你的镐子长一截。", "en": "My sword is a hand longer than your pick."},
        {"zh": "我要你死！", "en": "I want you dead!"},
        {"zh": "剑出鞘，你完了。", "en": "My blade is out. You are finished."},
        {"zh": "谁准你碰我的货？", "en": "Who said you could touch my goods?"},
        {"zh": "巢穴的规矩由我定。", "en": "I make the rules in this lair."},
        {"zh": "你这号人我见多了。", "en": "I have seen plenty of your kind."},
        {"zh": "偷懒的船员要挨剑。", "en": "Lazy crewmen get the blade."},
        {"zh": "这事得用剑解决。", "en": "This gets settled with a sword."},
        {"zh": "外面的家伙闯进矿道了。", "en": "An outsider has broken into my tunnel."},
        {"zh": "我的剑比你的腿快。", "en": "My sword is quicker than your legs."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的剑可比矿镐重。", "en": "My blade is heavier than any pick."},
        {"zh": "你逃不了！", "en": "You can't escape!"},
        {"zh": "这是我的宝藏！", "en": "This is my treasure!"},
        {"zh": "给我趴下！", "en": "Stay down!"},
        {"zh": "我的剑要杀人！", "en": "My sword will kill!"},
        {"zh": "你躲不开！", "en": "You can't avoid it!"},
        {"zh": "我不会饶恕！", "en": "I won't forgive!"},
        {"zh": "你逃不掉", "en": "You can't escape!"},
        {"zh": "砍你的脚踝就够了。", "en": "Cutting your ankle will be enough."},
        {"zh": "矮个子才钻得进这条缝。", "en": "Only a short one fits through this crack."},
        {"zh": "别抬头，我的剑在下面。", "en": "Do not look up, my blade is down low."},
        {"zh": "你的膝盖露出来了。", "en": "Your knee is showing."},
        {"zh": "我在数你的破绽。", "en": "I am counting your openings."},
        {"zh": "洞里没有地方给你躲。", "en": "There is nowhere to hide in this cave."},
        {"zh": "剑尖已经对准你。", "en": "The tip of my blade points at you."},
        {"zh": "火光下你的影子很长。", "en": "Your shadow is long in the torchlight."},
        {"zh": "先削你的盾，再削你。", "en": "First your shield, then you."},
        {"zh": "我的耐心比矿道还短。", "en": "My patience is shorter than these tunnels."},
        {"zh": "站住，让我量一量距离。", "en": "Stand still and let me measure the distance."},
        {"zh": "你一转身我就出手。", "en": "The moment you turn, I strike."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "吼！来吧，小鼠！", "en": "Roar! Come on, little mouse!"},
        {"zh": "尝尝我的剑！", "en": "Feel my sword!"},
        {"zh": "剑锋一挑，你的膝盖就软", "en": "One flick of the blade and your knees fold."},
        {"zh": "喝我的血，吃我的肉！", "en": "Drink my blood, eat my flesh!"},
        {"zh": "我的爪子要撕碎你！", "en": "My claws will tear you!"},
        {"zh": "别怕，尝尝我的利剑！", "en": "Don't be afraid, feel my sharp sword!"},
        {"zh": "你死定了！", "en": "You're doomed!"},
        {"zh": "狗头人之怒！", "en": "Kobold wrath!"},
        {"zh": "剑是我今天刚磨的。", "en": "I sharpened this sword today."},
        {"zh": "矮剑也有狠招！", "en": "A short blade still bites hard!"},
        {"zh": "尝尝狗头人的剑法！", "en": "Taste kobold swordsmanship!"},
        {"zh": "这一剑冲你的腿筋！", "en": "This cut is for your hamstring!"},
        {"zh": "矿道里的剑更快！", "en": "Blades swing faster in the tunnels!"},
        {"zh": "把你砍回地面上去！", "en": "I will cut you back up to the surface!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "嘿，小家伙，准备战斗吧！", "en": "Hey, little one, get ready for battle!"},
        {"zh": "巢穴的主人来了！", "en": "The lord of the cave is here!"},
        {"zh": "我的爪子将带给你恐惧！", "en": "My claws will bring you fear!"},
        {"zh": "欢迎来到我的巢穴！", "en": "Welcome to my lair!"},
        {"zh": "看看我的剑有多么锋利！", "en": "See how sharp my sword is!"},
        {"zh": "我是狗头人之王", "en": "I am the Kobold King!"},
        {"zh": "你将为我的剑而死！", "en": "You will die for my sword!"},
        {"zh": "巢穴的守护者！", "en": "The guardian of the cave!"},
        {"zh": "谁敢挑战我？！", "en": "Who dares challenge me?!"},
        {"zh": "我的巢穴，我的规则！", "en": "My lair, my rules!"},
        {"zh": "巢穴需要一位船长。", "en": "The lair needs a captain."},
        {"zh": "从矿道深处走上来。", "en": "I climb up from deep in the mine."},
        {"zh": "我的船员点起了火把。", "en": "My crew have lit the torches."},
        {"zh": "紫晶的光把我唤醒。", "en": "The glow of amethyst woke me."},
        {"zh": "森林地下的巢穴开张了。", "en": "The lair under the forest opens for business."},
        {"zh": "谁在我的地盘挖洞？", "en": "Who is digging in my territory?"},
        {"zh": "剑挂在腰间，我上任了。", "en": "Sword at my hip, I take command."},
        {"zh": "地底的王国缺个管事的。", "en": "The underground kingdom needs a manager."},
        {"zh": "新船长来清点货物了。", "en": "The new captain comes to count the goods."},
        {"zh": "我把旗帜插在矿道口。", "en": "I plant my banner at the tunnel mouth."}
      ]
    },
