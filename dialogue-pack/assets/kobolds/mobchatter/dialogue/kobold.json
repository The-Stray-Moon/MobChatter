        {"zh": "喵呜，快跑！", "en": "Meow, run away!"},
        {"zh": "爪子里攥着一块紫水晶", "en": "A chunk of amethyst clenched in my claw"},
        {"zh": "点着提灯巡视矿道", "en": "Lantern in claw, I walk the tunnels"}
      ]
    },
