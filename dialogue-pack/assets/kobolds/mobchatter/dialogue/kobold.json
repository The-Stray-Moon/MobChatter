    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的巢在地下，紫水晶最甜。", "en": "My den is underground, and amethyst is sweetest."},
        {"zh": "我要找我的伴侣！", "en": "I'm looking for my mate!"},
