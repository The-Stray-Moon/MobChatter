        {"zh": "咕噜咕噜，你别跑！", "en": "Rattle, rattle, don’t run!"},
        {"zh": "吱吱吱，你别怕！", "en": "Click, click, don’t be afraid!"},
        {"zh": "喵呜，跟我玩！", "en": "Meow, play with me!"}
