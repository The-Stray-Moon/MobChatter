      "lines": [
        {"zh": "咕噜咕噜，吱吱吱！", "en": "Rattle, rattle!"},
        {"zh": "咔嚓咔嚓，我爱紫水晶！", "en": "Click, click, I love purple quartz!"},
        {"zh": "喵呜，喵呜！我在地下家！", "en": "Meow, meow! I live underground!"},
        {"zh": "吱吱吱，来人啊！", "en": "Click, click, someone there!"},
        {"zh": "咕噜咕噜，看这里！", "en": "Rattle, rattle, look here!"},
        {"zh": "喵呜，危险！", "en": "Meow, danger!"},
