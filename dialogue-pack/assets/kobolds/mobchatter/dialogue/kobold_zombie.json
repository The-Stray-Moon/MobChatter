      "lines": [
        {"zh": "爪子挠你！", "en": "Scratch you!"},
        {"zh": "呜呜咽咽。", "en": "Gulp, gulp."},
        {"zh": "饿狼扑食！", "en": "Wolf attack!"},
        {"zh": "啃骨头！", "en": "Eat bones!"},
        {"zh": "嗷！你肉好！", "en": "Ahhh! You taste good!"},
        {"zh": "狂吠攻击！", "en": "Bark attack!"},
