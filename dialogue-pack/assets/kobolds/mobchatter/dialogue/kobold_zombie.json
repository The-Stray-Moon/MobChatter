    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我要来了。", "en": "Here I come."},
        {"zh": "我从土里爬出来找吃的。", "en": "I claw out of the dirt looking for food."},
        {"zh": "闻到了肉味。", "en": "Smell meat."},
        {"zh": "来了，来了。", "en": "Coming, coming."},
        {"zh": "寂静之夜。", "en": "Quiet night."},
        {"zh": "黑夜是我的家。", "en": "Night is my home."},
        {"zh": "饿了，我要吃。", "en": "Hungry, I need to eat."},
        {"zh": "我要杀了你！", "en": "I'll kill you!"},
        {"zh": "被僵尸咬过的狗头人站起。", "en": "A kobold bitten by a zombie rises."},
        {"zh": "我睁眼时眼睛已浑浊。", "en": "My eyes are clouded when they open."},
        {"zh": "矿道深处传来一声哀嚎。", "en": "A wail echoes deep in the mine."},
        {"zh": "金苹果的光也照不醒我。", "en": "Even golden apple light won't wake me."},
        {"zh": "我从尸体堆里爬出来。", "en": "I crawl out of the pile of bodies."},
        {"zh": "巢穴里少了一个同伴。", "en": "The burrow is one companion short."}
      ]
    },
