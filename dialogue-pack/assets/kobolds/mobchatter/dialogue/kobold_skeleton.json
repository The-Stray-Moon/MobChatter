{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "发出咔嚓声，步履蹒跚地前行。", "en": "Clicks and shuffles forward."},
        {"zh": "发出呻吟声，拖着链锁行走。", "en": "Groans and walks with chains."},
        {"zh": "盯着远处，慢慢移动身躯。", "en": "Stares distantly, slowly shifting."},
        {"zh": "啃咬着骨头，慢慢走向目标。", "en": "Chews bones, slowly approaching."},
        {"zh": "摇晃着头，发出恐怖的叫声。", "en": "Shakes its head, giving a frightful noise."},
        {"zh": "盯着玩家，缓缓接近。", "en": "Stares at player, creeping closer."},
        {"zh": "发出嘶嘶声，四处巡视。", "en": "Hisses, scanning the area."},
        {"zh": "咀嚼着骨头，发出沙沙声。", "en": "Chews bones, making rustling sounds."},
        {"zh": "舔舐着伤口，慢慢移动。", "en": "Licks its wounds, shuffling."},
        {"zh": "张开嘴巴，发出嘶嘶声。", "en": "Opens mouth, hissing."},
        {"zh": "骨节咔咔，弩背在背上。", "en": "Joints click; the crossbow rides my back."},
        {"zh": "慢慢挪步，骷髅不着急。", "en": "Slow shuffling—skeletons aren't in a hurry."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "倚靠在墙上，发出咕哝声。", "en": "Leans against a wall, grunting."},
        {"zh": "坐在地上，用空洞的眼洞盯着前方。", "en": "Sits on the ground, staring ahead."},
        {"zh": "低头吃着骨头，发出咀嚼声。", "en": "Eats bones, making chewing sounds."},
        {"zh": "倚在尸体上，发出轻响。", "en": "leans on a corpse, making soft sounds."},
