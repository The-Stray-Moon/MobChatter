    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "弩箭上弦，骨头当支架。", "en": "Crossbow cocked, my bones are the brace."},
        {"zh": "张开嘴，獠牙闪烁！", "en": "Opens mouth, fangs gleaming!"},
        {"zh": "挥舞大斧，砍向对手！", "en": "Swings great axe!"},
        {"zh": "用爪子抓向你的脸！", "en": "Claws for your face!"},
        {"zh": "嘶嘶声中咬向你！", "en": "Snarls and bites!"},
        {"zh": "嘶鸣，冲你扑来！", "en": "Growls and charges!"},
        {"zh": "用爪子撕裂你的胸膛！", "en": "Tears at your chest!"},
        {"zh": "怒吼中挥动战斧！", "en": "Raging axe swing!"},
        {"zh": "嘶嘶声中紧盯着你！", "en": "Snarling, eyes on you!"},
        {"zh": "用獠牙撕咬你的手臂！", "en": "Bites your arm!"},
        {"zh": "骨手抓住你的领子。", "en": "Bony fingers grab your collar."},
        {"zh": "我用弩托砸你的下巴。", "en": "I slam the crossbow's stock into your jaw."},
        {"zh": "指骨刮过你的脸。", "en": "Finger bones scrape your cheek."},
        {"zh": "牙关咬住你的手腕。", "en": "My jaw clamps your wrist."},
        {"zh": "骨头尖戳进你的肩。", "en": "A bone tip jabs your shoulder."},
        {"zh": "我扑上去，肋骨散了半边。", "en": "I lunge—half my ribs fall apart."}
      ]
