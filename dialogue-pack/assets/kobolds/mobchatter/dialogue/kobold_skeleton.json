    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "盯着你就像猎物一样!", "en": "Eyeing you like prey."},
        {"zh": "你的味道真不错！", "en": "Tasting good, don’t you think?"},
        {"zh": "尝尝我的毒箭吧！", "en": "Feel my poison dart."},
        {"zh": "你不知道我有多饿！", "en": "You have no idea how hungry I am."},
        {"zh": "你快点，快点来！", "en": "Come on, come on!"},
        {"zh": "你属于我的！", "en": "Yours, mine now."},
        {"zh": "你的肉肯定很好吃！", "en": "Your flesh must be delicious."},
        {"zh": "我等这一刻很久了！", "en": "I’ve waited for this for a long time."},
        {"zh": "紫水晶的味道勾住我了。", "en": "The smell of amethyst pulls me in."},
        {"zh": "享受你的最后一刻吧！", "en": "Enjoy your last moment."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "弩已经上弦了，让路。", "en": "Crossbow's cocked — clear the way."},
        {"zh": "该死的，撞到我了！", "en": "Damn, hit me!"},
        {"zh": "我不会就这样认输！", "en": "I won’t just give up!"},
        {"zh": "你敢撞我？", "en": "You dare hit me?"},
        {"zh": "我们来决斗！", "en": "Let’s fight!"},
        {"zh": "你这是找死！", "en": "You’re asking for it!"},
        {"zh": "小心我的弩！", "en": "Watch out for my bow!"},
        {"zh": "别挡我路！", "en": "Get out of my way!"},
        {"zh": "骨头撞散了，弩还上着弦。", "en": "My bones rattled loose, but my crossbow is still cocked."},
        {"zh": "骨头撞骨头，我可不疼。", "en": "Bone on bone—I feel no pain."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "和我一起战斗！", "en": "Fight with me!"},
        {"zh": "我要找个伴！", "en": "I need a partner!"},
        {"zh": "骷髅也能有伴，弩先放下。", "en": "Even a skeleton wants company. Crossbow down."},
        {"zh": "和我一起行动！", "en": "Move with me!"},
        {"zh": "我们共同战斗！", "en": "Let’s fight together!"},
        {"zh": "我们需要更多的同伴！", "en": "We need more of our kind!"},
        {"zh": "我的朋友，跟我来！", "en": "My friend, follow me!"},
        {"zh": "和我并肩作战！", "en": "Fight by my side!"},
        {"zh": "找我的同类吧！", "en": "Find my kind!"},
        {"zh": "巢穴里该多一副骨头了。", "en": "The burrow could use one more skeleton."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "啃食你的尸体！", "en": "Feed on your corpse!"},
        {"zh": "你属于这里！", "en": "You belong here!"},
        {"zh": "寻找你的骨肉！", "en": "Seek your flesh!"},
        {"zh": "尝尝我的箭！", "en": "Feel my arrow!"},
        {"zh": "死神来了！", "en": "Death is coming!"},
        {"zh": "腐烂你的灵魂！", "en": "腐烂你的灵魂！ decay your soul!"},
        {"zh": "哀嚎吧，凡人！", "en": "Wail, mortal!"},
        {"zh": "吞噬你的生命！", "en": "Suck the life out of you!"},
        {"zh": "这东西归巢穴了。", "en": "This belongs to the burrow now."},
        {"zh": "享受死亡吧！", "en": "Enjoy your death!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准了！", "en": "Target acquired!"},
        {"zh": "猎物来了！", "en": "Prey has come!"},
        {"zh": "我的箭在等待！", "en": "My arrow waits!"},
        {"zh": "等待你的命运！", "en": "Await your fate!"},
        {"zh": "弩箭搭上弦，别动。", "en": "The bolt is nocked; don't move."},
        {"zh": "骷髅手指扣上扳机。", "en": "Bony fingers squeeze the trigger."},
        {"zh": "准备射击！", "en": "Aim and shoot!"},
        {"zh": "享受我的箭雨！", "en": "Feel my arrow rain!"},
        {"zh": "猎杀开始！", "en": "Hunt begins!"},
        {"zh": "猎物已锁定！", "en": "Target locked!"},
        {"zh": "弩上弦了，你听见没。", "en": "Crossbow's cocked—did you hear it?"},
        {"zh": "活人进了狗头人的地道。", "en": "A living one entered the kobold tunnels."},
        {"zh": "你的呼吸声在洞里太响。", "en": "Your breathing is too loud in here."},
        {"zh": "你先射腿，你跑不掉。", "en": "I'll shoot your legs so you can't run."},
        {"zh": "地道顶太低，站不直。", "en": "The tunnel roof is too low to stand straight."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "弩机抬平，压住你的咽喉。", "en": "I level the crossbow at your throat."},
        {"zh": "死亡无处不在！", "en": "Death is everywhere!"},
        {"zh": "你的子弹将空！", "en": "Your arrow will be void!"},
        {"zh": "弩已经上弦，别动。", "en": "Crossbow loaded. Don't move."},
