        {"zh": "射穿你的喉咙！", "en": "Pierce your throat!"},
        {"zh": "死亡的呼啸！", "en": "The howl of death!"},
        {"zh": "射击，消灭它！", "en": "Shoot, destroy it!"},
        {"zh": "享受我的射击！", "en": "Feel my shot!"},
