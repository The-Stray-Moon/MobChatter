{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "甲板再晃，也晃不倒我。", "en": "The deck may sway, but I won't fall."},
        {"zh": "巢穴深处，也有宝藏。", "en": "Treasure lies deep in the den too."},
        {"zh": "眼罩一戴，路照样认。", "en": "With my eyepatch on, I still know the way."},
        {"zh": "丛林地下，正合我意。", "en": "Underground jungle suits me fine."},
        {"zh": "脚步轻些，别惊动巢穴。", "en": "Soft steps—don't wake the den."},
        {"zh": "紫水晶的光，在那边闪。", "en": "Amethyst light glints over there."},
        {"zh": "巡逻一圈，看看谁在偷懒。", "en": "One patrol round—who's slacking?"},
        {"zh": "海盗的靴子，走地下也稳。", "en": "Pirate boots hold steady underground."},
        {"zh": "这边土腥味重，有情况。", "en": "Strong earthy smell here—something's up."},
        {"zh": "别挡道，我在巡巢。", "en": "Out of my way, I'm patrolling the den."},
        {"zh": "帽檐压低，暗处好藏身。", "en": "Brim low, easy to hide in the dark."},
        {"zh": "交易可以，先让我走完这圈。", "en": "We can trade—after this round."},
        {"zh": "洞穴再绕，也绕不过我。", "en": "These caves can't outwind me."},
        {"zh": "听见水滴声，方向没错。", "en": "Dripping water—right direction."},
        {"zh": "海盗巢穴的路，我闭眼都熟。", "en": "I know the pirate den blindfolded."},
        {"zh": "走稳点，别踩塌了通道。", "en": "Step carefully—don't collapse the tunnel."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "靠墙歇会儿，眼罩也不摘。", "en": "Resting by the wall, eyepatch stays on."},
        {"zh": "这巢穴不错，就是潮了点。", "en": "Nice den—just a bit damp."},
        {"zh": "紫水晶碎片，得收好了。", "en": "Better keep the amethyst shards safe."},
        {"zh": "海盗也得喘口气。", "en": "Even pirates need a breather."},
        {"zh": "地下安静，适合盘算交易。", "en": "Quiet down here—good for planning trades."},
        {"zh": "别盯着我，我又不咬人。", "en": "Stop staring—I don't bite."},
        {"zh": "这帽子戴久了有点闷。", "en": "This hat gets stuffy after a while."},
        {"zh": "丛林底下，藏得够深。", "en": "Deep under the jungle—well hidden."},
        {"zh": "附魔师那边，最近生意如何？", "en": "How's business with the enchanter?"},
        {"zh": "僵尸那帮家伙，迟早找上门。", "en": "Those zombies will come knocking eventually."},
        {"zh": "歇够了，就该去巡一圈。", "en": "Once rested, it's patrol time."},
        {"zh": "眼罩歪了，扶一下。", "en": "Eyepatch slipped—let me fix it."},
        {"zh": "巢穴平安，我就踏实。", "en": "Den's safe—that settles me."},
        {"zh": "海盗的悠闲，也是本事。", "en": "A pirate's leisure is a skill too."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你带着紫水晶？让我看看。", "en": "Got amethyst? Let me see."},
        {"zh": "生面孔，来交易的？", "en": "New face—here to trade?"},
        {"zh": "别乱碰巢穴的东西。", "en": "Don't go touching den property."},
        {"zh": "你这眼神，像在打什么主意。", "en": "That look—you're plotting something."},
        {"zh": "海盗巢穴，闲人免进。", "en": "Pirate den—no loitering."},
        {"zh": "想换东西，就好好谈。", "en": "Want to trade? Then talk straight."},
        {"zh": "你身上没敌意，我姑且信。", "en": "No hostility on you—I'll trust that."},
        {"zh": "眼罩这边看不见，别站那边。", "en": "Can't see on this side—don't stand there."},
        {"zh": "丛林地下不好找吧？", "en": "Hard to find, this deep under the jungle?"},
        {"zh": "说吧，你想要什么。", "en": "Speak up—what do you want?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "疼！谁动的手？", "en": "Ow! Who hit me?"},
        {"zh": "海盗也会流血，记下了。", "en": "Pirates bleed too—noted."},
        {"zh": "眼罩挡不住这一下。", "en": "The eyepatch didn't block that one."},
        {"zh": "巢穴遇袭，全员戒备！", "en": "Den under attack—everyone on guard!"},
        {"zh": "这笔账，我迟早讨回。", "en": "I'll settle this score sooner or later."},
        {"zh": "帽子都打歪了！", "en": "You knocked my hat crooked!"},
        {"zh": "再来一下试试看。", "en": "Try that one more time."},
        {"zh": "丛林地下的拳头可不轻。", "en": "Fists run heavy under the jungle."},
        {"zh": "伤了海盗，你要付代价。", "en": "Hurt a pirate—you'll pay for it."},
        {"zh": "站稳，我还没倒下。", "en": "Steady—I'm not down yet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "紫水晶碎片？拿来我瞧瞧。", "en": "Amethyst shards? Let me have a look."},
        {"zh": "这闪光，交易的好开头。", "en": "That glint—a fine start to a trade."},
        {"zh": "你手里那点紫晶，我出价。", "en": "Those shards in your hand—I'll bid."},
        {"zh": "别晃了，眼睛都看直了。", "en": "Stop waving them—I'm staring."},
        {"zh": "紫晶换我的货，成不成？", "en": "Amethyst for my goods—deal?"},
        {"zh": "这颜色，地道的好货。", "en": "That color—genuine quality."},
        {"zh": "我眼罩后的眼也亮了。", "en": "Even my hidden eye lit up."},
        {"zh": "碎片给我，价钱好说。", "en": "Hand over the shards—price is flexible."},
        {"zh": "眼罩底下这只眼，盯紧了。", "en": "The eye under this patch is fixed on it."},
        {"zh": "海盗也抵挡不住紫晶。", "en": "Even a pirate can't resist amethyst."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "哎哟，看着点路！", "en": "Oi—watch where you're going!"},
        {"zh": "撞上海盗，要赔的。", "en": "Bumping a pirate costs you."},
        {"zh": "眼罩挡视线，不是我的错。", "en": "Eyepatch blocks my view—not my fault."},
        {"zh": "通道窄，别挤。", "en": "Tunnel's narrow—don't shove."},
        {"zh": "再撞，我可要动手了。", "en": "Bump me again and I'll fight."},
        {"zh": "站稳了，别摔进水里。", "en": "Steady—don't fall in the water."},
        {"zh": "你撞得我帽子都歪了。", "en": "You knocked my hat crooked."},
        {"zh": "巢穴里乱跑，没规矩。", "en": "Running wild in the den—no manners."},
        {"zh": "我这靴子可不认人。", "en": "These boots don't care who you are."},
        {"zh": "退半步，各走各的。", "en": "Back off a step—let's each go our way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这事我不谈，忙交易去。", "en": "Not discussing that—I've trades to handle."},
        {"zh": "海盗只认紫晶和巢穴。", "en": "A pirate cares only for amethyst and the den."},
        {"zh": "别拿这个烦我。", "en": "Don't bother me with that."},
        {"zh": "我的心思在巡逻上。", "en": "My mind's on patrol."},
        {"zh": "找别人去，我没空。", "en": "Ask someone else—I'm busy."},
        {"zh": "巢穴的安危比这要紧。", "en": "The den's safety matters more."},
        {"zh": "海盗不谈这个。", "en": "Pirates don't talk about that."},
        {"zh": "眼罩一戴，只谈正事。", "en": "Eyepatch on—business only."},
        {"zh": "我认的是船，不是你。", "en": "I belong to the ship, not to you."},
        {"zh": "我还有货要清点。", "en": "I still have goods to count."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块紫晶归我账上。", "en": "This shard goes on my ledger."},
        {"zh": "捡到手里，才算稳当。", "en": "In my hand—now that's safe."},
        {"zh": "眼罩那边看不见，摸一摸。", "en": "Can't see on that side—let me feel it."},
        {"zh": "好东西，收进兜里。", "en": "Good find—into the pocket."},
        {"zh": "巢穴里的，也不许浪费。", "en": "Even den scraps shouldn't go to waste."},
        {"zh": "这货色，能换点东西。", "en": "This quality—worth a trade."},
        {"zh": "眼罩歪了，先捡这个。", "en": "My eyepatch slipped. Loot first."},
        {"zh": "地上掉的，海盗照收。", "en": "Dropped on the ground—a pirate still takes it."},
        {"zh": "手快有，手慢无。", "en": "Quick hands get it, slow hands lose it."},
        {"zh": "收好了，别漏出去。", "en": "Stowed away—don't let it slip out."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西闯进巢穴范围了。", "en": "Something's entered the den's reach."},
        {"zh": "那影子不对劲，盯住。", "en": "That shadow's wrong—watch it."},
        {"zh": "眼罩遮一半，剩下一半够用。", "en": "One eye covered—the other's enough."},
        {"zh": "来者不善，先下手。", "en": "Hostile—strike first."},
        {"zh": "别让它靠近通道。", "en": "Don't let it near the tunnel."},
        {"zh": "海盗的巢穴，不容侵犯。", "en": "A pirate's den is not to be violated."},
        {"zh": "发现目标，脚步放轻。", "en": "Target spotted—steps go quiet."},
        {"zh": "躲在箱子后面，正好动手。", "en": "Behind the crate is the perfect spot."},
        {"zh": "丛林地下，也归我管。", "en": "This underground jungle is mine too."},
        {"zh": "准备动手，别留机会。", "en": "Get ready—give it no opening."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "绕着走，找它破绽。", "en": "Circle around—find its weakness."},
        {"zh": "等它先动，我数到三就上。", "en": "Let it move first, I go on three."},
        {"zh": "帽子压低，别露脸。", "en": "Brim low—don't show my face."},
        {"zh": "它往左了，跟上。", "en": "It went left—follow."},
        {"zh": "通道窄，逼它进来。", "en": "Narrow tunnel—force it in."},
        {"zh": "眼罩这边是死角，转过去。", "en": "Blind spot on this side—turn."},
        {"zh": "再近点，就够得着。", "en": "A bit closer—then I can reach."},
        {"zh": "它喘气了，时机快到了。", "en": "It's panting—my moment's near."},
        {"zh": "稳住，别惊了它。", "en": "Hold steady—don't spook it."},
        {"zh": "巢穴的门，就在我身后。", "en": "The den's entrance is right behind me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "吃我一记，海盗的拳头！", "en": "Take this—pirate's fist!"},
        {"zh": "眼罩歪了，拳头不歪。", "en": "Eyepatch askew—my fist isn't."},
        {"zh": "别想靠近巢穴！", "en": "Don't you dare near the den!"},
        {"zh": "这一下，记住了。", "en": "Remember this one."},
        {"zh": "丛林地下，我说了算。", "en": "Underground jungle—I call the shots."},
        {"zh": "站稳了再接招。", "en": "Steady yourself for the next blow."},
        {"zh": "敢闯海盗巢穴，找打。", "en": "Raiding a pirate den? You're asking for it."},
        {"zh": "海盗的靴子也会踢人。", "en": "Pirate boots kick too."},
        {"zh": "退回去，还能留条路。", "en": "Back off—you'll still have a way out."},
        {"zh": "巢穴的地盘，不容你踏。", "en": "The den's ground—you don't tread it."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "海盗巢穴，又添一员。", "en": "One more joins the pirate den."},
        {"zh": "眼罩戴好，帽子压低。", "en": "Eyepatch on, brim pulled low."},
        {"zh": "丛林地下，我来了。", "en": "Underground jungle—I've arrived."},
        {"zh": "这巢穴的味道，够地道。", "en": "This den smells authentic enough."},
        {"zh": "从哪儿冒出来的？管他呢。", "en": "Where'd I pop up from? Doesn't matter."},
        {"zh": "紫水晶呢，先看看货。", "en": "Where's the amethyst? Let me check stock."},
        {"zh": "海盗的规矩，入巢先巡。", "en": "Pirate rule—patrol first upon arrival."},
        {"zh": "地下深处，正合适落脚。", "en": "Deep underground—a fine place to settle."},
        {"zh": "敌人在哪？巢穴要守好。", "en": "Where are the foes? The den needs guarding."},
        {"zh": "新来的，也是海盗。", "en": "Newcomer—still a pirate."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到帽子了，快拍灭！", "en": "My hat's on fire—pat it out!"}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔得我眼罩都歪了。", "en": "That fall knocked my eyepatch askew."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水下可不是海盗的地盘！", "en": "Underwater is no pirate's territory!"}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "眼罩歪了，耳朵还在响。", "en": "My eyepatch is crooked; my ears still ring."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "冷箭！眼罩这边看不见。", "en": "A sneaky shot! Can't see on this side."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这是什么邪门法术？", "en": "What cursed magic is this?"}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "肚子空了，得找点吃的。", "en": "Belly's empty—need to find food."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈下来，帽子都焦了！", "en": "Lightning struck—my hat's scorched!"}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这虚空，连海盗也抓不住东西。", "en": "In this void, even a pirate can't grab hold."}
      ]
    }
  }
}
