    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "呱呱呱，小心地底的危险！", "en": "Quack quack, beware the dangers below!"},
        {"zh": "我的药水能治疗伤痛！", "en": "My potions can heal wounds!"},
        {"zh": "别怕，我们只是交易！", "en": "Don't fear, we just trade!"},
        {"zh": "探矿者的附魔很值钱哦！", "en": "The Miner enchantment is quite valuable!"},
        {"zh": "快来看看我新做的药水！", "en": "Check out my new potions!"},
        {"zh": "我们不会攻击，只交易！", "en": "We don't attack, just trade!"},
        {"zh": "你看到绿宝石了吗？", "en": "Did you see the emerald?"},
        {"zh": "别紧张，我会保护你！", "en": "Don't be scared, I'll protect you!"},
        {"zh": "附魔师的咒语很神秘！", "en": "The enchanter's spells are mysterious!"},
        {"zh": "我的附魔能让怪物掉落宝石！", "en": "My enchantment drops emeralds!"},
        {"zh": "小短腿跑得快，药水不洒。", "en": "Short legs, quick steps, potions unspilled."},
        {"zh": "我抱着附魔书，溜过走廊。", "en": "Hugging my enchanted book, I slip down the hall."},
        {"zh": "紫水晶在口袋里叮当响。", "en": "Amethyst shards clink in my pocket."},
        {"zh": "巢穴的路我闭眼也走得。", "en": "I could walk the lair blindfolded."},
        {"zh": "别挡道，我要去换绿宝石。", "en": "Out of my way; I am off to trade for emeralds."},
        {"zh": "尾巴一甩，我拐进侧洞。", "en": "A flick of my tail, and I turn into the side tunnel."}
      ]
    },
