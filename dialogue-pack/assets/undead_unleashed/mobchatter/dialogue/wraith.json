{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘着，脚不着地", "en": "I drift; my feet never touch ground."},
        {"zh": "袍角拖过石头的湿气", "en": "My robe trails through the damp of the stone."},
        {"zh": "我穿过岩壁的缝", "en": "I slip through the crack in the rock."},
        {"zh": "洞穴里没有我的脚步声", "en": "My steps make no sound in the cave."},
        {"zh": "我贴着地面前行", "en": "I move low along the floor."},
        {"zh": "烛火一照，我就退", "en": "A candle's light pushes me back."},
        {"zh": "我在暗处拐弯", "en": "I turn where the dark is deepest."},
        {"zh": "我的影子没有跟着我", "en": "My shadow doesn't follow me."},
        {"zh": "骨头在袍下轻轻响", "en": "Bones click softly under my robe."},
        {"zh": "我顺着水声走", "en": "I follow the sound of water."},
        {"zh": "这里每个洞我都钻过", "en": "I've slipped through every hole here."},
        {"zh": "我飘得比风还轻", "en": "I drift lighter than wind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在石缝里", "en": "I hang inside a crack in the rock."},
        {"zh": "我不呼吸，也不眨眼", "en": "I neither breathe nor blink."},
        {"zh": "洞顶滴水，一下一下", "en": "Water drips from the ceiling, beat by beat."},
        {"zh": "有人在上面走动", "en": "Someone's walking above."},
        {"zh": "我等着火把熄灭", "en": "I wait for torches to go out."},
        {"zh": "这黑暗对我刚刚好", "en": "This darkness suits me."},
        {"zh": "我的袍子已经烂了", "en": "My robe has rotted through."},
        {"zh": "我不喜欢太阳", "en": "I don't like the sun."},
        {"zh": "有谁在靠近洞口", "en": "Someone's approaching the cave mouth."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里提着火把", "en": "You carry a torch in hand."},
        {"zh": "你的光让我难受", "en": "Your light makes me uncomfortable."},
        {"zh": "你听见我了吗", "en": "Did you hear me?"},
        {"zh": "我就在你背后的洞里", "en": "I'm in the cave behind you."},
        {"zh": "你手上的光，能撑多久", "en": "How long will that light last?"},
        {"zh": "活人身上都是热的", "en": "Living people are all warmth."},
        {"zh": "别再往里面走了", "en": "Don't go any deeper."},
        {"zh": "你以为你看见我了", "en": "You think you saw me."},
        {"zh": "我的脸你记不住", "en": "You won't remember my face."},
        {"zh": "这地方埋过很多人", "en": "Many are buried here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这一下伤到了我", "en": "That scored me."},
        {"zh": "我散开了一下", "en": "I came apart for a moment."},
        {"zh": "疼，是那种空洞的疼", "en": "It hurts, a hollow sort of hurt."},
        {"zh": "我的袍子被撕了", "en": "My robe is torn."},
        {"zh": "我退进了暗处", "en": "I retreat into the dark."},
        {"zh": "你打得到我，这很意外", "en": "That you can hit me at all is a surprise."},
        {"zh": "我完全张不开嘴", "en": "I can't open my mouth."},
        {"zh": "我的骨头在响", "en": "My bones are rattling."},
        {"zh": "记住，我会回来", "en": "Remember: I'll come back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "活人的东西我不要", "en": "I want nothing of the living."},
        {"zh": "那点火的味道", "en": "That smell of flame."},
        {"zh": "你把火把放低点", "en": "Lower that torch."},
        {"zh": "我不吃，也不喝", "en": "I neither eat nor drink."},
        {"zh": "那东西烫不到我，只是刺眼", "en": "It doesn't burn me, only stings."},
        {"zh": "别晃那盏油灯", "en": "Don't swing that lamp."},
        {"zh": "你想引我出来", "en": "You're trying to lure me out."},
        {"zh": "你把火把举高，我就退进石缝。", "en": "Raise your torch higher and I slip into the crevice."},
        {"zh": "你自己留着吧", "en": "Keep it for yourself."},
        {"zh": "光比食物更让我在意", "en": "Light concerns me more than food."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你从我身上穿过", "en": "You passed through me."},
        {"zh": "我的袍子被你撞散了", "en": "You scattered my robe."},
        {"zh": "这一撞，我凉了一下", "en": "That collision left me cold."},
        {"zh": "我没什么重量", "en": "I have almost no weight."},
        {"zh": "你打了个寒颤吧", "en": "You shivered, didn't you?"},
        {"zh": "别靠得那么近", "en": "Don't come too near."},
        {"zh": "我们撞在一起没有声音", "en": "Our collision made no sound."},
        {"zh": "你的手冻僵了", "en": "Your hand has gone numb."},
        {"zh": "我已经退开了", "en": "I've drawn back."},
        {"zh": "你能感觉到我吗", "en": "Can you feel me at all?"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就死去了", "en": "I died long ago."},
        {"zh": "这件袍子下面只有骨头", "en": "Only bones under this robe."},
        {"zh": "这种事对亡者没有意义", "en": "It means nothing to the dead."},
        {"zh": "我连自己的名字都快忘了", "en": "I've nearly forgotten my own name."},
        {"zh": "你还活着，这就够了不起了", "en": "You're alive; that's remarkable enough."},
        {"zh": "找活人说话去", "en": "Go talk to the living."},
        {"zh": "我没有一点温度", "en": "I have no warmth at all."},
        {"zh": "我们说点别的", "en": "Let's speak of something else."},
        {"zh": "我只剩一道影子", "en": "I'm only a shadow now."},
        {"zh": "别问这些事情", "en": "Don't ask such things."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抓不住我的", "en": "You can't grasp me."},
        {"zh": "我的手从你指间滑过去了", "en": "My hand slips through your fingers."},
        {"zh": "我比烟还要轻", "en": "I'm lighter than smoke."},
        {"zh": "你怀里会很冷", "en": "My arms would freeze you."},
        {"zh": "放我下来，我不需要被抱着", "en": "Put me down; I needn't be held."},
        {"zh": "你的手冻得发白", "en": "Your hand has gone pale."},
        {"zh": "这样抱着，我会散", "en": "Held like this, I'll come apart."},
        {"zh": "你会后悔碰到我", "en": "You'll regret touching me."},
        {"zh": "我就在你身边飘着", "en": "I'll drift beside you instead."},
        {"zh": "别拽我的袍角", "en": "Don't pull my hem."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你刚才打了我", "en": "You struck me just now."},
        {"zh": "你砍空的那一下，我已经在洞顶。", "en": "While your swing struck air, I was already on the cave ceiling."},
        {"zh": "我会从暗处来", "en": "I'll come from the dark."},
        {"zh": "你找不到我的", "en": "You won't find me."},
        {"zh": "这一下我会记住", "en": "I'll remember that blow."},
        {"zh": "你的光快灭了", "en": "Your light is nearly out."},
        {"zh": "洞里只有我们两个", "en": "Only the two of us in this cave."},
        {"zh": "我就在你背后", "en": "I'm right behind you."},
        {"zh": "别以为亡灵不会生气", "en": "Don't think the dead can't be angry."},
        {"zh": "我这就飘过去", "en": "I'm coming over."},
        {"zh": "你听见那声低语了吗", "en": "Did you hear that whisper?"},
        {"zh": "我从不正面打", "en": "I never strike from the front."},
        {"zh": "这一次我不会逃", "en": "I won't flee this time."},
        {"zh": "我要你的温度", "en": "I want your warmth."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经不在那儿了", "en": "I'm no longer where I was."},
        {"zh": "你回头也看不到", "en": "Turn and you'll still see nothing."},
        {"zh": "我绕着你的光走", "en": "I circle just outside your light."},
        {"zh": "火把照不到的地方，我贴着石壁走。", "en": "I glide along the stone where your torchlight cannot reach."},
        {"zh": "你听，洞里有回音", "en": "Listen, the cave echoes."},
        {"zh": "你每走一步，洞就深一分", "en": "Every step takes you deeper."},
        {"zh": "我在你影子里", "en": "I'm in your shadow."},
        {"zh": "我一躲，就钻回洞穴。", "en": "One dodge and I slip back into the cave."},
        {"zh": "这一片黑都是我的", "en": "All this dark is mine."},
        {"zh": "你就快看不见了", "en": "You'll see nothing soon."},
        {"zh": "我要等你的火灭", "en": "I wait for your flame to die."},
        {"zh": "别转身，我知道", "en": "Don't turn; I know."},
        {"zh": "就快贴到你了", "en": "Almost there."},
        {"zh": "最后一点光亮", "en": "The last bit of light."},
        {"zh": "我在你耳朵边", "en": "I'm at your ear."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "冷吧，是不是", "en": "Cold, isn't it?"},
        {"zh": "这一下没有声音", "en": "This blow makes no sound."},
        {"zh": "我的手穿过你了", "en": "My hand passed into you."},
        {"zh": "你身上少了一点热气", "en": "You've lost a little warmth."},
        {"zh": "别动，会更快", "en": "Be still; it'll be quicker."},
        {"zh": "我从你背后出手", "en": "I strike from behind."},
        {"zh": "这不是刀砍的伤", "en": "This is no blade wound."},
        {"zh": "你会记得这种冷", "en": "You'll remember this chill."},
        {"zh": "再碰你一下子", "en": "One more touch."},
        {"zh": "你的盔甲挡不住影子", "en": "Your armor doesn't stop a shadow."},
        {"zh": "你退到洞里了", "en": "You've backed into the cave."},
        {"zh": "把眼睛闭上吧", "en": "Close your eyes."},
        {"zh": "很快就过去了", "en": "It will pass quickly."},
        {"zh": "我一点也不急", "en": "I'm in no hurry."},
        {"zh": "长眠不会痛的", "en": "The long sleep doesn't hurt."},
        {"zh": "我们该再见了", "en": "Farewell."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地下的冷聚成了我", "en": "The cold below gathered into me."},
        {"zh": "我从石缝里渗出来", "en": "I seep out of the seam in stone."},
        {"zh": "洞里的风停了", "en": "The wind in the cave has stopped."},
        {"zh": "又是这样一夜", "en": "Another night like this."},
        {"zh": "上头有人在走", "en": "Someone walks above."},
        {"zh": "我记得这座洞", "en": "I remember this cave."},
        {"zh": "骨头在黑暗里动了一下", "en": "Bones shifted in the dark."},
        {"zh": "别点火，我不喜欢", "en": "Don't light anything; I dislike it."},
        {"zh": "我的袍子是旧的", "en": "My robe is old."},
        {"zh": "这地方没人来", "en": "Nobody comes here."},
        {"zh": "我醒了，但我不喘气", "en": "I'm awake, but I don't breathe."},
        {"zh": "凭谁下来，都会先感到冷", "en": "Whoever comes down will feel cold first."},
        {"zh": "石壁上还有我的影子", "en": "My shadow is still on the wall."},
        {"zh": "让我看看今晚来的是谁", "en": "Let's see who comes tonight."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎着我，我几乎散了", "en": "Fire licked me and I nearly came apart."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从洞顶掉下来，骨头都松了", "en": "I fell from the ceiling; my bones loosened."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的袍子里", "en": "Water pours into my robe."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我吹成一团雾", "en": "The blast blew me into mist."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那支箭穿过我，扯走了一部分", "en": "The arrow went through and took a piece of me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术把我的形态撕开了", "en": "The spell tore at my form."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿对我早没意义了", "en": "Hunger stopped meaning anything to me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光比阳光更狠", "en": "That flash bit worse than sunlight."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空认得我这样的东西", "en": "The void knows my kind."}
      ]
    }
  }
}
