{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "盔甲里没有脚步声", "en": "There's no footstep in the armor."},
        {"zh": "我踏过泥土，铁片相碰", "en": "I cross the dirt, plates clashing."},
        {"zh": "盾牌抬在身前", "en": "Shield raised before me."},
        {"zh": "我一步一步压过去", "en": "I press forward, step by step."},
        {"zh": "厚重的靴子碾碎枯枝", "en": "Heavy boots crush dry branches."},
        {"zh": "铁锈的气息跟着我走", "en": "The smell of rust walks with me."},
        {"zh": "我绕过倒塌的墙", "en": "I skirt the fallen wall."},
        {"zh": "头盔里只有风", "en": "Only wind inside the helm."},
        {"zh": "我把剑拖在地上", "en": "I drag the sword along the ground."},
        {"zh": "甲片磨着甲片", "en": "Plate grinds on plate."},
        {"zh": "我朝有人的方向走", "en": "I walk toward where people are."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，像一尊铁像", "en": "I stand like an iron statue."},
        {"zh": "盾牌一直没放下", "en": "The shield never lowers."},
        {"zh": "盔甲里什么也没有", "en": "There's nothing inside the armor."},
        {"zh": "风吹过我的眼眶", "en": "Wind passes through my eye slits."},
        {"zh": "我在听这片树林", "en": "I listen to this patch of woods."},
        {"zh": "锈迹又深了一层", "en": "The rust deepens a shade."},
        {"zh": "我不呼吸，也不必歇", "en": "I don't breathe, so I don't rest."},
        {"zh": "握剑的手没有松", "en": "My grip on the sword hasn't loosened."},
        {"zh": "夜里我不用点火", "en": "I need no fire at night."},
        {"zh": "铁很冷，我不在乎", "en": "The iron is cold; I don't mind."},
        {"zh": "有几个影子在远处", "en": "Some shadows in the distance."},
        {"zh": "我在等一个值得举盾的对手", "en": "I wait for a foe worth my shield."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你穿着活人的盔甲", "en": "You wear a living man's armor."},
        {"zh": "我看你的姿势", "en": "I read your stance."},
        {"zh": "你手里的铁太薄", "en": "That iron of yours is thin."},
        {"zh": "别挡在这条路上", "en": "Don't stand in this road."},
        {"zh": "你是想试一试我", "en": "You want to test me."},
        {"zh": "我的盾挡过很多刀", "en": "My shield has stopped many blades."},
        {"zh": "你把武器举低了", "en": "You hold your weapon too low."},
        {"zh": "你身上还热着", "en": "You're still warm."},
        {"zh": "盾举起来，这一剑就挡得住。", "en": "Shield up, and this blade stops here."},
        {"zh": "你说话的时候，我在算距离", "en": "While you talk, I'm measuring distance."},
        {"zh": "站好，别弓着背", "en": "Stand straight; don't hunch."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "有一块甲裂了", "en": "One plate cracked."},
        {"zh": "我的盾被压下去", "en": "My shield was forced down."},
        {"zh": "我只退了半步", "en": "I give half a step."},
        {"zh": "你砍到了缝隙", "en": "You found the gap."},
        {"zh": "这具甲还能撑", "en": "This armor still holds."},
        {"zh": "铁锈替我疼着", "en": "The rust aches for me."},
        {"zh": "我的头盔凹了", "en": "My helm is dented."},
        {"zh": "别以为这样就赢了", "en": "Don't think that wins."},
        {"zh": "我还能举起剑", "en": "I can still raise the sword."},
        {"zh": "这一剑我记住了", "en": "I'll remember that cut."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃活人的东西", "en": "I eat nothing of the living."},
        {"zh": "铁不生锈，就没什么可给", "en": "Unless it's rusting iron, there's nothing for me."},
        {"zh": "你手里那块骨头有意思", "en": "That bone in your hand is interesting."},
        {"zh": "我只想要盔甲", "en": "I want only armor."},
        {"zh": "食物对我毫无意义", "en": "Food means nothing to me."},
        {"zh": "把它拿得远些", "en": "Take it far away."},
        {"zh": "你要收买一具空甲？", "en": "Bribing an empty suit of armor?"},
        {"zh": "我不饿，也不会累", "en": "I'm not hungry, and I don't tire."},
        {"zh": "这味道让我想起铁匠铺", "en": "That smell recalls a smithy."},
        {"zh": "把它收起来吧", "en": "Put it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的盾撞到你", "en": "My shield caught you."},
        {"zh": "铁碰铁，声音真响", "en": "Iron on iron rings loud."},
        {"zh": "你根本撞不动", "en": "You can't shift me at all."},
        {"zh": "我站得非常稳", "en": "I stand very firm."},
        {"zh": "马上给我让路", "en": "Make way for me."},
        {"zh": "我的甲片又掉了一块", "en": "Another plate fell off me."},
        {"zh": "你被弹回去了", "en": "You were bounced back."},
        {"zh": "空甲也有分量", "en": "Even empty armor has weight."},
        {"zh": "这一撞，我的头盔歪了", "en": "That knock set my helm askew."},
        {"zh": "再撞我就举盾", "en": "Bump again and I raise the shield."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "盔甲里没有人", "en": "There is no man in this armor."},
        {"zh": "这种事与我无缘", "en": "Such things are not for me."},
        {"zh": "你去找活人吧", "en": "Go find the living."},
        {"zh": "我的誓言比这重要", "en": "My oath matters more."},
        {"zh": "我没有那种温度", "en": "I have no such warmth."},
        {"zh": "铁是不会心动的", "en": "Iron does not stir."},
        {"zh": "我只剩下职责", "en": "Only duty remains to me."},
        {"zh": "这些不必再问", "en": "Ask no more."},
        {"zh": "这句话我不答", "en": "I won't answer that."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬不动一整套甲", "en": "You can't lift a full suit."},
        {"zh": "别拽我的头盔", "en": "Don't pull my helm."},
        {"zh": "盾会砸到你身上", "en": "The shield will fall on you."},
        {"zh": "放我下来，我自己会站", "en": "Put me down; I stand on my own."},
        {"zh": "剑还在我手里", "en": "The sword is still in my hand."},
        {"zh": "这样我的甲片全散了", "en": "This way my plates scatter."},
        {"zh": "你手里的剑在打颤", "en": "The blade in your hands is trembling."},
        {"zh": "我比铁轻，也比铁冷", "en": "I'm lighter than iron, and colder."},
        {"zh": "把我就此松开", "en": "Release me."},
        {"zh": "放下，我还要赶路", "en": "Put me down; I have a road to walk."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "把盾举起来吧", "en": "Raise the shield."},
        {"zh": "我已经到这里", "en": "I'm already here."},
        {"zh": "一步不许后退", "en": "Don't fall back."},
        {"zh": "你的武器挡不住这一下", "en": "Your weapon won't stop this."},
        {"zh": "我很久没动了", "en": "I haven't moved in a long while."},
        {"zh": "盔甲开始发热", "en": "The armor begins to warm."},
        {"zh": "我要劈开你的架势", "en": "I'll split that guard of yours."},
        {"zh": "你选了这条路", "en": "You chose this road."},
        {"zh": "钉在原地别动", "en": "Stand your ground."},
        {"zh": "我数过了，你退三步就死", "en": "I've counted: three steps back and you're done."},
        {"zh": "没有谈判余地", "en": "No room for parley."},
        {"zh": "我举盾，是为了压过去", "en": "I raise the shield to press through."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的盾一直对着你", "en": "My shield stays on you."},
        {"zh": "你砍我的盾试试", "en": "Try cutting the shield."},
        {"zh": "我在等你先出刀", "en": "I wait for your first cut."},
        {"zh": "你的呼吸越来越快", "en": "Your breathing quickens."},
        {"zh": "我不累，你会累", "en": "I won't tire; you will."},
        {"zh": "铁片挡得住你的视线", "en": "The plates block your line."},
        {"zh": "你的下盘在晃", "en": "Your stance is swaying."},
        {"zh": "剑举起来太重了", "en": "That sword is heavy raised high."},
        {"zh": "再靠近我一步", "en": "One more step."},
        {"zh": "我要压过去了", "en": "I'm pressing forward."},
        {"zh": "你身后是堵墙", "en": "There's a wall behind you."},
        {"zh": "我不会喊话的", "en": "I won't shout a warning."},
        {"zh": "铁锈的味道越来越浓", "en": "The rust smell thickens."},
        {"zh": "这是最后一口气", "en": "The last breath."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "吃我一记重劈", "en": "Take my cleave."},
        {"zh": "我的盾顶过来", "en": "The shield comes forward."},
        {"zh": "这一剑带着风", "en": "This blade carries wind."},
        {"zh": "你挡住了，但手麻了吧", "en": "You blocked it; your arm must be numb."},
        {"zh": "再劈你一剑吧", "en": "Another cut for you."},
        {"zh": "把盾牌抬起来", "en": "Raise the shield."},
        {"zh": "你的架势破了", "en": "Your guard is broken."},
        {"zh": "铁对铁，看谁先断", "en": "Iron against iron; see who breaks first."},
        {"zh": "不许跪下求饶", "en": "Don't kneel."},
        {"zh": "我还能再砍十下", "en": "Ten more cuts in me."},
        {"zh": "这一下是重劈", "en": "That was a heavy cleave."},
        {"zh": "别指望我留情", "en": "Don't expect mercy."},
        {"zh": "你的脚退得太慢了", "en": "Your feet retreat too slowly."},
        {"zh": "整副盔甲都在响", "en": "The whole armor is ringing."},
        {"zh": "一切都结束了", "en": "It's all finished."},
        {"zh": "哼，不过如此", "en": "Hmph. Nothing more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "甲片一块块拼起来", "en": "Plate by plate, I assemble."},
        {"zh": "头盔里的风停了", "en": "The wind in my helm dies."},
        {"zh": "剑落在我手里", "en": "The sword lands in my grip."},
        {"zh": "这片地归我巡", "en": "This ground is mine to patrol."},
        {"zh": "锈迹是新长的", "en": "The rust is newly grown."},
        {"zh": "谁在附近走动", "en": "Who moves nearby?"},
        {"zh": "我醒得非常慢", "en": "I wake very slowly."},
        {"zh": "盾上还挂着泥", "en": "Mud still clings to my shield."},
        {"zh": "没有号角，也没有人喊", "en": "No horn, no shout."},
        {"zh": "这条路我踏过百回", "en": "I've trodden this road a hundred times."},
        {"zh": "我站起来就没打算坐下", "en": "Once upright, I don't intend to sit."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得甲片发烫", "en": "The fire heats my plates red."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从高处摔下来，甲片散了", "en": "The fall scattered my plates."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进盔甲里，我沉下去", "en": "Water fills the armor and I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击掀翻了我的盾", "en": "The blast tore my shield away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那支箭卡在甲缝里", "en": "An arrow wedged in my plates."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这法术想把我赶出盔甲", "en": "The spell tries to drive me from the armor."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空比死亡更空", "en": "The void is emptier than death."}
      ]
    }
  }
}
