    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿过了我的翅膀", "en": "That thing went through my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术把我的火压回去了", "en": "The spell pushed my fire back down."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得火都弱了", "en": "Hunger dims my fire."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我的鳞都亮了", "en": "The bolt lit up every scale."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里连火都烧不起来", "en": "Even fire won't burn in the void."}
      ]
    }
  }
}
