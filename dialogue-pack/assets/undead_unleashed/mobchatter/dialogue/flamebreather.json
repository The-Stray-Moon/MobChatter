{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我半飞半跑地碾过去", "en": "I half-fly, half-run, and trample through."},
        {"zh": "翅膀扇起一阵热风", "en": "My wings beat up a hot wind."},
        {"zh": "脚下的玄武岩被我踩裂", "en": "Basalt cracks beneath me."},
        {"zh": "我低低地滑过岩浆湖", "en": "I skim low over the lava lake."},
        {"zh": "每走一步就喷出一口烟", "en": "Each step puffs out smoke."},
        {"zh": "我在绯红森林里横穿", "en": "I cut across the crimson forest."},
        {"zh": "翅膀太大，转身费劲", "en": "My wings are too wide to turn easily."},
        {"zh": "我拖着影子穿过灰烬", "en": "I drag my shadow through the ash."},
        {"zh": "热浪先我一步到", "en": "The heat wave arrives before I do."},
        {"zh": "我沿着崖边走", "en": "I walk along the cliff's edge."},
        {"zh": "我落下来，又弹起", "en": "I land, then push off again."},
        {"zh": "身后留下焦黑的印子", "en": "A scorched print stays behind me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，一口一口地喘火", "en": "I hover, breathing fire in slow puffs."},
        {"zh": "喉咙里一直有火", "en": "There's always fire in my throat."},
        {"zh": "我蹲在岩台上", "en": "I crouch on a basalt ledge."},
        {"zh": "灰落在我背上", "en": "Ash settles on my back."},
        {"zh": "我闻得到猪肉味", "en": "I smell pork."},
        {"zh": "这里是下界，我不怕热", "en": "This is the Nether; heat doesn't bother me."},
        {"zh": "岩浆的光照着我的鳞", "en": "Lava light plays on my scales."},
        {"zh": "我在等谁靠近崖边", "en": "I wait for someone to come near the cliff."},
        {"zh": "火在我的牙缝里亮", "en": "Fire glows between my teeth."},
        {"zh": "我打个嗝，喷出一小团火", "en": "I burp a little ball of flame."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有肉的味道", "en": "You smell of meat."},
        {"zh": "你身后是悬崖", "en": "There's a cliff behind you."},
        {"zh": "别再往前一步", "en": "Don't take another step."},
        {"zh": "我的火够到这里", "en": "My fire reaches this far."},
        {"zh": "你手里拿的什么", "en": "What are you holding?"},
        {"zh": "我认得猪灵的味道，你不是", "en": "I know piglin scent; you're not it."},
        {"zh": "你的盔甲会化掉", "en": "Your armor will melt."},
        {"zh": "我闻到你身上的水汽", "en": "I smell damp on you."},
        {"zh": "你从主世界来的", "en": "You come from the Overworld."},
        {"zh": "你的影子被岩浆拉长了", "en": "The lava stretches your shadow."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的鳞片裂了", "en": "My scales have cracked."},
        {"zh": "这一下我从空中掉了半截", "en": "I dropped half a wing's height."},
        {"zh": "喉咙里的火乱了", "en": "The fire in my throat scattered."},
        {"zh": "我退到岩台后面", "en": "I back behind the ledge."},
        {"zh": "你比我想的难缠", "en": "You're tougher than I thought."},
        {"zh": "疼得我直喷烟", "en": "The pain makes me snort smoke."},
        {"zh": "我的翅膀被撕开", "en": "My wing has been torn."},
        {"zh": "我还能继续烧", "en": "I can still burn."},
        {"zh": "别以为下界生物不会痛", "en": "Don't think Nether beasts feel no pain."},
        {"zh": "这一口我记住了", "en": "I'll remember that blow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西不能吃", "en": "That isn't food."},
        {"zh": "我只要肉和火", "en": "I want only meat and fire."},
        {"zh": "你给我的东西太小了", "en": "What you offer is too small."},
        {"zh": "我一口能吞下你", "en": "I could swallow you in one bite."},
        {"zh": "收起来，我不感兴趣", "en": "Put it away; I'm not interested."},
        {"zh": "你手里的肉不错", "en": "The meat in your hand is decent."},
        {"zh": "扔过来，别走近", "en": "Throw it; don't come close."},
        {"zh": "那点火不够暖", "en": "That little flame isn't warm enough."},
        {"zh": "再给我一块肉", "en": "Give me another piece."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我像撞石头", "en": "You hit me like a rock."},
        {"zh": "我这么重，你弹开了", "en": "I'm heavy; you bounced off."},
        {"zh": "翅膀被撞得歪了", "en": "The hit skewed my wing."},
        {"zh": "滚烫的身体别乱碰", "en": "Don't touch a body this hot."},
        {"zh": "让开，我落不下来", "en": "Move; I can't land here."},
        {"zh": "这一下撞得我喷了火", "en": "That knock made me spit fire."},
        {"zh": "岩浆边实在太挤", "en": "It's far too crowded by the lava."},
        {"zh": "你身上有焦糊味", "en": "You smell of scorch."},
        {"zh": "我这身鳞片不会让路", "en": "These scales don't give way."},
        {"zh": "再挤我就踩过去", "en": "Crowd me and I'll walk over you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这种野兽不讲这个", "en": "Beasts like me don't bother with that."},
        {"zh": "我守的是领地和火", "en": "I keep territory and flame."},
        {"zh": "你问错对象了", "en": "Wrong creature to ask."},
        {"zh": "火里出生的东西不结伴", "en": "Things born in fire don't pair."},
        {"zh": "我只在饿的时候靠近", "en": "I only come close when hungry."},
        {"zh": "别站在我翅膀下", "en": "Don't stand under my wings."},
        {"zh": "火里不谈这个", "en": "Not in fire, not this."},
        {"zh": "我的火比这个重要", "en": "My fire matters more."},
        {"zh": "没有这种打算", "en": "No such intention."},
        {"zh": "你走开就是了", "en": "Walk away from me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你根本抓不住我", "en": "You can't grip me at all."},
        {"zh": "我的鳞片会割你手", "en": "My scales will cut your hands."},
        {"zh": "我实在太重了", "en": "I'm far too heavy."},
        {"zh": "放我下来，我翅膀展不开", "en": "Put me down; my wings can't open."},
        {"zh": "你在碰一只野兽", "en": "You're touching a beast."},
        {"zh": "我身上还在冒热气", "en": "Steam still rises off me."},
        {"zh": "你这样会烧到自己", "en": "You'll burn yourself doing this."},
        {"zh": "快把爪子松开", "en": "Let go of me."},
        {"zh": "我可不是宠物", "en": "I'm no pet."},
        {"zh": "你早晚会后悔的", "en": "You'll regret it sooner or later."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你站得太靠边了", "en": "You're standing too near the edge."},
        {"zh": "我已经闻到你", "en": "I've caught your scent."},
        {"zh": "一张嘴就是火", "en": "My mouth is already fire."},
        {"zh": "别跑，崖就在后面", "en": "Don't run; the cliff's behind you."},
        {"zh": "猪灵见我就跑", "en": "Piglins run when they see me."},
        {"zh": "我已经饿起来", "en": "I'm hungry now."},
        {"zh": "这一口能烧穿甲", "en": "This breath burns through plate."},
        {"zh": "你身上那股水汽让我烦", "en": "That damp smell of yours annoys me."},
        {"zh": "我已经咬定你", "en": "I've fixed on you."},
        {"zh": "退到崖边也没用", "en": "The cliff edge won't save you."},
        {"zh": "我这就扑过来", "en": "I'm coming over."},
        {"zh": "再一步就晚了", "en": "One more step is too late."},
        {"zh": "让我看看你能烧多久", "en": "Let's see how long you burn."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我吸一口气，火就来了", "en": "One breath and the fire comes."},
        {"zh": "这崖边窄得很", "en": "The ledge is very narrow."},
        {"zh": "你背后什么都没有", "en": "Nothing behind you but air."},
        {"zh": "我正在压低身子", "en": "I'm lowering my body."},
        {"zh": "我的翅膀挡着退路", "en": "My wings block your retreat."},
        {"zh": "你听见咕噜声了吗", "en": "Hear that rumbling?"},
        {"zh": "火在我喉咙里滚", "en": "Fire rolls in my throat."},
        {"zh": "你别想从下面绕", "en": "Don't try to slip below."},
        {"zh": "我不急，火不灭", "en": "No hurry; the fire won't die."},
        {"zh": "你越退越靠边", "en": "The more you back up, the closer the edge."},
        {"zh": "你就这样别动", "en": "Just like this, don't move."},
        {"zh": "再吸最后一口气", "en": "The last breath."},
        {"zh": "我的影子盖住你了", "en": "My shadow covers you."},
        {"zh": "你已经在发抖", "en": "You're trembling now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "已经烧起来了", "en": "Burning now."},
        {"zh": "这一口够你受", "en": "That breath was enough."},
        {"zh": "先咬住再说话", "en": "Bite first, talk later."},
        {"zh": "被烫到了没有", "en": "That heat got you, didn't it?"},
        {"zh": "翅膀扇你一下", "en": "A wingbeat for you."},
        {"zh": "你退到崖边了", "en": "You're at the cliff's edge."},
        {"zh": "我的爪子也不轻", "en": "My claws aren't light either."},
        {"zh": "再来一口烈火", "en": "One more breath of fire."},
        {"zh": "这把火不会停", "en": "This fire won't stop."},
        {"zh": "你身上全是烟味", "en": "You're covered in smoke."},
        {"zh": "你可以跳下去，也可以烧着", "en": "Jump, or burn."},
        {"zh": "翅膀扇起的火星先扑到你脸上。", "en": "Sparks from my wingbeat reach your face before my claws do."},
        {"zh": "别想挡住这火", "en": "Don't try to block fire."},
        {"zh": "结束得很快的", "en": "It ends quickly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从岩浆里爬出来", "en": "I crawl up out of the lava."},
        {"zh": "热风跟着我到了", "en": "The hot wind came with me."},
        {"zh": "玄武岩上多了个影子", "en": "A shadow joins the basalt."},
        {"zh": "我张开翅膀，灰全飞了", "en": "I spread my wings; the ash scatters."},
        {"zh": "这地方够热的", "en": "This place is hot enough."},
        {"zh": "我第一口烟喷在空气里", "en": "My first smoke goes into the air."},
        {"zh": "谁在这儿点火", "en": "Who lit a fire here?"},
        {"zh": "我落在一块岩台上", "en": "I land on a basalt shelf."},
        {"zh": "下界又多了张嘴", "en": "The Nether has one more mouth."},
        {"zh": "我先去找吃的", "en": "I'll find food first."},
        {"zh": "绯红森林的树在晃", "en": "The crimson trees are swaying."},
        {"zh": "崖边我站得稳", "en": "I stand firm at the cliff edge."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我没什么，但太烫了", "en": "Fire is nothing to me, yet it's too hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从崖上掉下来，翅膀没抓住", "en": "I fell from the cliff; my wings missed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
