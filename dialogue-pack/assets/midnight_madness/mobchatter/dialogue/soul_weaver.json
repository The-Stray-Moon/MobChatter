{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我八条腿在沙上轻敲。", "en": "My eight legs tap the sand."},
        {"zh": "我拖着一缕灵魂丝。", "en": "I drag a thread of soul silk."},
        {"zh": "我从峡谷的裂缝往上爬。", "en": "I climb up the canyon fissure."},
        {"zh": "我的丝挂在骨头上。", "en": "My silk hangs on bones."},
        {"zh": "沙粒在我脚下塌。", "en": "Sand collapses under my feet."},
        {"zh": "我沿着灵魂沙走。", "en": "I walk along the soul sand."},
        {"zh": "我侧身穿过石缝。", "en": "I turn sideways through the gap."},
        {"zh": "我的腹部很沉。", "en": "My abdomen is heavy."},
        {"zh": "我在地面上画出一条线。", "en": "I draw a line across the ground."},
        {"zh": "慢慢地，一寸一寸。", "en": "Slowly, inch by inch."},
        {"zh": "我在找能挂丝的地方。", "en": "I look for somewhere to hang silk."},
        {"zh": "我用前足试丝牢不牢。", "en": "My front legs test the silk's strength."},
        {"zh": "我爬到高处再垂下。", "en": "I climb high, then drop a line."},
        {"zh": "骨堆之间我走得慢。", "en": "I move slowly between bone piles."},
        {"zh": "我把丝绕在一根肋骨上。", "en": "I loop silk around a rib."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在灵魂沙上。", "en": "I crouch on the soul sand."},
        {"zh": "我在梳理我的丝。", "en": "I'm grooming my silk."},
        {"zh": "峡谷里的风带着哭声。", "en": "The canyon wind carries a wailing."},
        {"zh": "我的腿细微地动。", "en": "My legs shift minutely."},
        {"zh": "我在等猎物缠上来。", "en": "I wait for prey to tangle."},
        {"zh": "丝上粘着灰尘。", "en": "Dust clings to my silk."},
        {"zh": "我慢慢转过身子。", "en": "I turn my body slowly."},
        {"zh": "这里的声音很怪。", "en": "The sounds here are strange."},
        {"zh": "我什么都没有做。", "en": "I'm doing nothing."},
        {"zh": "我的眼睛很多，看得清。", "en": "Many eyes see clearly."},
        {"zh": "我把丝拉得笔直。", "en": "I pull my silk taut."},
        {"zh": "沙子正在缓缓塌下。", "en": "The sand slowly gives way."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在看着你。", "en": "I've been watching you."},
        {"zh": "灵魂沙会记住你。", "en": "Soul sand will remember you."},
        {"zh": "你的影子比你还长。", "en": "Your shadow is longer than you."},
        {"zh": "别动，我数数你的骨头。", "en": "Hold still; let me count your bones."},
        {"zh": "这里不是活人的地方。", "en": "This isn't a place for the living."},
        {"zh": "你站在我的网中间。", "en": "You're standing in the middle of my web."},
        {"zh": "我在这里织了很久。", "en": "I've been weaving a long time."},
        {"zh": "你要挣扎也没用。", "en": "Struggling won't help."},
        {"zh": "你的气息引来了别的。", "en": "Your scent draws others."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的丝乱成一团。", "en": "My silk is tangled."},
        {"zh": "有两条腿不灵了。", "en": "Two of my legs won't work."},
        {"zh": "我从丝上掉下来。", "en": "I dropped off my line."},
        {"zh": "腹部被划开了。", "en": "My abdomen is slit."},
        {"zh": "我往沙子里缩。", "en": "I retreat into the sand."},
        {"zh": "这一下打得很疼。", "en": "That hurt."},
        {"zh": "我朝它吐了一缕丝。", "en": "I spit out a strand."},
        {"zh": "我不会丢下网。", "en": "I won't abandon the web."},
        {"zh": "你再来试一次。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "一碟腐肉，引不动我。", "en": "A dish of rotten flesh will not draw me."},
        {"zh": "灵魂不是那么抓的。", "en": "That isn't how you catch a soul."},
        {"zh": "你举着也没用。", "en": "Holding it up won't help."},
        {"zh": "我更想要你身后的东西。", "en": "I'd rather have what's behind you."},
        {"zh": "放下来，慢慢退。", "en": "Set it down and back away slowly."},
        {"zh": "这个对丝没用。", "en": "That's no use to my silk."},
        {"zh": "饥饿对我不算什么。", "en": "I'm not hungry."},
        {"zh": "我织的是魂，不是饭。", "en": "It is souls I weave, not meals."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你缠进我的丝里了。", "en": "You've tangled in my silk."},
        {"zh": "我的丝很黏手。", "en": "My silk is sticky."},
        {"zh": "你踩断了一根。", "en": "You broke a strand."},
        {"zh": "这挣扎只会更紧。", "en": "Struggling only tightens it."},
        {"zh": "我往外退了一点。", "en": "I drew back a little."},
        {"zh": "别碰我那几条腿。", "en": "Don't touch my legs."},
        {"zh": "沙下面还有丝。", "en": "There's silk under the sand too."},
        {"zh": "你被我绊住了。", "en": "You've caught your foot."},
        {"zh": "但这丝不会松开。", "en": "But the silk won't loosen."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只会织网而已。", "en": "I only weave."},
        {"zh": "这片峡谷适合产卵。", "en": "This canyon suits a clutch."},
        {"zh": "你身上没有丝。", "en": "You have no silk."},
        {"zh": "等下过一场雨。", "en": "After the rain passes."},
        {"zh": "我们要占住这条裂缝。", "en": "We should hold this fissure."},
        {"zh": "别把这张网弄破。", "en": "Don't break the web."},
        {"zh": "这网得慢慢织才好。", "en": "Slowly."},
        {"zh": "我对这些毫无兴致。", "en": "I'm not interested."},
        {"zh": "你去别地方吧。", "en": "Go elsewhere."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用丝拖过来。", "en": "I drag it over with silk."},
        {"zh": "这个可以挂在骨上。", "en": "This can hang on a bone."},
        {"zh": "这玩意儿咽不下去。", "en": "Not food."},
        {"zh": "这东西沉得拖不动。", "en": "Too heavy."},
        {"zh": "它缠在我身上。", "en": "It's tangled on me."},
        {"zh": "这上面沾着血。", "en": "There's blood on it."},
        {"zh": "我拿过来看了看。", "en": "I take a look."},
        {"zh": "这东西算不上有用。", "en": "Not useful."},
        {"zh": "先把它放到一边。", "en": "Set it aside."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西碰了我的丝。", "en": "Something touched my silk."},
        {"zh": "我感觉得到震动。", "en": "I feel the vibration."},
        {"zh": "我先一动不动。", "en": "I keep still first."},
        {"zh": "它越挣扎陷得越深。", "en": "The more it pulls, the deeper it sinks."},
        {"zh": "丝在它脚下绷紧了。", "en": "The silk pulls taut beneath its feet."},
        {"zh": "这里是我的网。", "en": "This is my web."},
        {"zh": "我闻到了气息。", "en": "I smell its breath."},
        {"zh": "它已经被缠住了。", "en": "It's caught."},
        {"zh": "等它自己累下来。", "en": "Let it tire."},
        {"zh": "趁丝还没被挣断。", "en": "Now."},
        {"zh": "我已经咬下去了。", "en": "I bite down."},
        {"zh": "马上就会好了。", "en": "Almost done."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着丝一寸寸靠近。", "en": "I creep closer step by step."},
        {"zh": "丝从上面垂下来。", "en": "Silk hangs down from above."},
        {"zh": "它根本看不见我。", "en": "It can't see me."},
        {"zh": "我在等丝拉紧。", "en": "I wait for the silk to tighten."},
        {"zh": "峡谷里没有出口。", "en": "No exit from this canyon."},
        {"zh": "我把后面封了。", "en": "I've sealed the way behind."},
        {"zh": "往哪走都是丝。", "en": "More silk everywhere it turns."},
        {"zh": "它喘气喘得很重。", "en": "Its breathing is heavy."},
        {"zh": "沙让我动作很轻。", "en": "The sand keeps my steps light."},
        {"zh": "我要慢慢地咬。", "en": "I'll bite slowly."},
        {"zh": "它一直在发抖。", "en": "It's trembling."},
        {"zh": "差不多可以了。", "en": "Almost there."},
        {"zh": "最后一条路也断了。", "en": "The last route is cut."},
        {"zh": "我已经爬上去了。", "en": "I'm going up."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "毒液已经进去了。", "en": "The venom went in."},
        {"zh": "我的丝收了收。", "en": "My silk draws tight."},
        {"zh": "它被丝裹住了。", "en": "It's wrapped up."},
        {"zh": "这一口咬得很浅。", "en": "That was light."},
        {"zh": "丝把它扯向沙里。", "en": "The silk pulls it into the sand."},
        {"zh": "你千万别挣扎。", "en": "Don't struggle."},
        {"zh": "我在等它不动。", "en": "I wait for it to stop moving."},
        {"zh": "这就已经好了。", "en": "Done."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从灵魂沙下面爬出来。", "en": "I crawl up from under the soul sand."},
        {"zh": "这里到处是骨。", "en": "Bones everywhere here."},
        {"zh": "我开始织第一根丝。", "en": "I spin my first strand."},
        {"zh": "这条峡谷很深。", "en": "The canyon is deep."},
        {"zh": "风在石头间哭。", "en": "The wind weeps between the stones."},
        {"zh": "我的腿一根根张开。", "en": "My legs unfold one by one."},
        {"zh": "这里很合适织网。", "en": "This will do."},
        {"zh": "我挂起一条线。", "en": "I hang a line."},
        {"zh": "谁也过不去这里。", "en": "Nothing gets past."},
        {"zh": "网开始成形了。", "en": "The web is taking shape."},
        {"zh": "我挂在丝上等猎物。", "en": "I wait."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的丝，白白地卷起来。", "en": "Fire caught my silk; it curled up white."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从丝上坠下来，摔进沙里。", "en": "I fell off my line into the sand."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浸透了我的丝。", "en": "Water soaked through my silk."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把网全掀散了。", "en": "The blast tore the whole web apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过我的腹部。", "en": "Something pierced my abdomen."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量想把我从丝上扯下来。", "en": "That force tries to rip me off my line."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经织不动了。", "en": "I can't spin any more."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我脚边，我僵住。", "en": "Lightning hit by my feet; I froze."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "丝下面什么都没有。", "en": "The silk hangs over nothing."}
      ]
    }
  }
}
