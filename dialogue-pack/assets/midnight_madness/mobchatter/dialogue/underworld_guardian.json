{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着冥界的界线走。", "en": "I walk the boundary of the underworld."},
        {"zh": "我的甲片一层压一层。", "en": "My plates overlap layer on layer."},
        {"zh": "我绕着一圈黑色的岩石。", "en": "I circle a ring of black rock."},
        {"zh": "我把长戟扛在肩上。", "en": "I shoulder my halberd."},
        {"zh": "我从关口的阴影里走出。", "en": "I come out of the gate's shadow."},
        {"zh": "我不需要看路。", "en": "I don't need to watch my path."},
        {"zh": "我走过的地方风都停了。", "en": "The wind dies where I pass."},
        {"zh": "我慢慢地转身巡视。", "en": "I turn slowly on patrol."},
        {"zh": "我朝有人声的方向走。", "en": "I head toward the voices."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我拄着长戟站着。", "en": "I stand leaning on my halberd."},
        {"zh": "我的甲缝里冒着冷气。", "en": "Cold air leaks from my seams."},
        {"zh": "我一直盯着关口。", "en": "I stare at the gate."},
        {"zh": "我从来不坐下。", "en": "I don't sit."},
        {"zh": "这里没有任何东西经过。", "en": "Nothing passes here."},
        {"zh": "我的头盔遮住了眼睛。", "en": "My helm hides my eyes."},
        {"zh": "我慢慢握紧又松开。", "en": "I grip, then release."},
        {"zh": "风绕着我的甲走。", "en": "The wind goes around my armor."},
        {"zh": "我在听远处的哭声。", "en": "I listen to distant weeping."},
        {"zh": "我的影子比身体更黑。", "en": "My shadow is blacker than my body."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你不该走到这道门。", "en": "You shouldn't reach this gate."},
        {"zh": "活人不能过去。", "en": "The living may not pass."},
        {"zh": "我的长戟比你还高。", "en": "My halberd is taller than you."},
        {"zh": "你正在往下走。", "en": "You're heading downward."},
        {"zh": "我守这道门很久了。", "en": "I've held this gate a long time."},
        {"zh": "你的心跳在这里很响。", "en": "Your heartbeat is loud here."},
        {"zh": "我对你没有恶意。", "en": "I bear no ill will."},
        {"zh": "你身上的温度让我不适。", "en": "Your warmth unsettles me."},
        {"zh": "你还是往回走吧。", "en": "Turn back."},
        {"zh": "你脚下的路不属于你。", "en": "The road under you isn't yours."},
        {"zh": "你的名字还没被记下。", "en": "Your name hasn't been written yet."},
        {"zh": "我看见过很多人。", "en": "I've seen many like you."},
        {"zh": "你是第一个问路的。", "en": "You're the first to ask the way."},
        {"zh": "这里不需要向导。", "en": "No guide is needed here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的甲上多了一道凹痕。", "en": "A dent appeared in my armor."},
        {"zh": "这一戟打得甲片发闷。", "en": "That had some weight."},
        {"zh": "我又把双脚钉回原位。", "en": "I give half a step."},
        {"zh": "我没有痛感，但我知道。", "en": "I feel no pain, but I note it."},
        {"zh": "甲片松了一角。", "en": "A plate came loose at the corner."},
        {"zh": "我重新站稳了。", "en": "I plant myself again."},
        {"zh": "这不影响我守着。", "en": "It doesn't stop me guarding."},
        {"zh": "你还敢再来一次？", "en": "You dare again?"},
        {"zh": "再来我也挡得住。", "en": "Come again; I'll still block."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我早已不用进食。", "en": "I don't eat."},
        {"zh": "这东西，我一点也不感兴趣。", "en": "I have no interest in that at all."},
        {"zh": "别把供品摆到关口。", "en": "I need no offerings."},
        {"zh": "你拿它换不来什么。", "en": "You can't trade it for anything."},
        {"zh": "放下，我说过了。", "en": "Put it down, as I said."},
        {"zh": "我的头盔里没有嘴。", "en": "There's no mouth under my helm."},
        {"zh": "这不属于冥界。", "en": "This doesn't belong to the underworld."},
        {"zh": "你不要带它过来。", "en": "Don't bring it here."},
        {"zh": "我不会去碰它。", "en": "I won't touch it."},
        {"zh": "这供品你自己带回去。", "en": "Keep it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上的是我的胸甲。", "en": "You struck my armor."},
        {"zh": "别贴着这道门站。", "en": "Don't stand against the gate."},
        {"zh": "这道门并不宽。", "en": "This gate isn't wide."},
        {"zh": "我让开半边门。", "en": "I give you half the passage."},
        {"zh": "你踩到了我的戟尖。", "en": "You stepped on my halberd tip."},
        {"zh": "别把我往门框上挤。", "en": "I dislike being crowded."},
        {"zh": "过去，然后就走。", "en": "Pass, then leave."},
        {"zh": "冥界的门前，活人别贴这么近。", "en": "At the underworld gate, the living shouldn't press so close."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是个守门的。", "en": "I'm only a gatekeeper."},
        {"zh": "你问错了地方。", "en": "You're asking in the wrong place."},
        {"zh": "我身上只有甲。", "en": "There's only armor on me."},
        {"zh": "我连生成配置都没有。", "en": "I don't even have a spawn configuration."},
        {"zh": "这不在我的职守里。", "en": "That isn't in my duty."},
        {"zh": "你还是回去吧。", "en": "Go back."},
        {"zh": "这个话题到此为止。", "en": "This topic ends here."},
        {"zh": "别让我再说一次。", "en": "Don't make me say it twice."},
        {"zh": "你给我走开去。", "en": "Go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "冥界守卫不会捡这个。", "en": "An underworld guardian wouldn't pick that up."},
        {"zh": "我用手甲夹起来。", "en": "I pinch it between my gauntlet plates."},
        {"zh": "它在地上很显眼。", "en": "It stands out on the ground."},
        {"zh": "我把它放下来。", "en": "I set it down."},
        {"zh": "这可不是贡品。", "en": "This is no offering."},
        {"zh": "是谁带进来的？", "en": "Who brought this?"},
        {"zh": "这分量轻得像灰尘。", "en": "Too light."},
        {"zh": "它没什么用处。", "en": "It's of no use."},
        {"zh": "守卫不捡地上的东西。", "en": "A guardian does not pick things off the floor."},
        {"zh": "你把它收好了。", "en": "Put it away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人走到门前。", "en": "Someone has come to the gate."},
        {"zh": "我把长戟举起来。", "en": "I lift my halberd."},
        {"zh": "这一下过不去。", "en": "You won't pass this way."},
        {"zh": "我挡在门中央。", "en": "I stand in the center of the gate."},
        {"zh": "我盯着你迈出的脚。", "en": "I watch your feet."},
        {"zh": "这里的规矩是死的。", "en": "The rules here are dead fixed."},
        {"zh": "你是想硬闯吗？", "en": "Would you force it?"},
        {"zh": "我很久没动过手。", "en": "I haven't moved to strike in a long while."},
        {"zh": "我把戟转过来。", "en": "I turn the halberd."},
        {"zh": "站住了，别乱动。", "en": "Halt."},
        {"zh": "我开始数三下。", "en": "I count to three."},
        {"zh": "不会有第二次。", "en": "There's no second warning."},
        {"zh": "门不会为你开。", "en": "The gate won't open for you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着戟一步步向前。", "en": "I press forward step by step."},
        {"zh": "我的戟尖一直对着你。", "en": "My halberd point stays on you."},
        {"zh": "你在靠近那道门。", "en": "You're nearing the gate."},
        {"zh": "我不加快脚步。", "en": "I don't speed up."},
        {"zh": "我的甲太重，转身慢。", "en": "My armor is heavy; I turn slowly."},
        {"zh": "你绕到侧面也没用。", "en": "Circling won't help."},
        {"zh": "门的两边都有守卫。", "en": "There are guards on both sides."},
        {"zh": "你在喘粗气了。", "en": "You're panting."},
        {"zh": "这一片没有遮挡。", "en": "No cover here."},
        {"zh": "你再进一步我就出手。", "en": "One step more and I strike."},
        {"zh": "我已经举起戟了。", "en": "I raise the halberd."},
        {"zh": "你想硬闯，我看得出来。", "en": "You mean to force your way through; I can tell."},
        {"zh": "你是想明白了。", "en": "You've decided."},
        {"zh": "我在等你的最后一步。", "en": "I wait for your last step."},
        {"zh": "谁也不许过去。", "en": "You may not pass."},
        {"zh": "这道门不会为你开。", "en": "It's over."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "长戟横扫过去。", "en": "The halberd sweeps wide."},
        {"zh": "这一下分量很沉。", "en": "That was heavy."},
        {"zh": "你被推出两格。", "en": "You were shoved back two blocks."},
        {"zh": "甲片撞在你身上。", "en": "My plates struck you."},
        {"zh": "我用戟杆压你。", "en": "I press you down with the shaft."},
        {"zh": "你把武器举太高了。", "en": "You raised your weapon too high."},
        {"zh": "这一戟走的是侧颈。", "en": "Your armor can't stop this angle."},
        {"zh": "我抬手又是一下。", "en": "Another swing follows."},
        {"zh": "血在石板上流。", "en": "Blood runs on the stone."},
        {"zh": "你给我退回去。", "en": "Fall back."},
        {"zh": "这一下只是拦你。", "en": "That was a warning."},
        {"zh": "下一戟就不收力了。", "en": "The next one won't be held back."},
        {"zh": "我站得很稳当。", "en": "I'm planted."},
        {"zh": "戟杆压着你的护肩。", "en": "My halberd shaft presses on your pauldron."},
        {"zh": "门就在你身后。", "en": "The gate is behind you."},
        {"zh": "一切到此为止。", "en": "No further."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从门后的黑暗里走出来。", "en": "I step out of the dark behind the gate."},
        {"zh": "我的甲上还带着霜。", "en": "Frost still clings to my armor."},
        {"zh": "关口需要有人守。", "en": "The gate needs a keeper."},
        {"zh": "这里一点风都没有。", "en": "There's no wind here."},
        {"zh": "我抬手扶了扶头盔。", "en": "I raise a hand to my helm."},
        {"zh": "我看了看脚下的石板。", "en": "I glance at the flagstones."},
        {"zh": "远处有声音传来。", "en": "There's a sound far off."},
        {"zh": "我握紧了长戟。", "en": "I grip the halberd."},
        {"zh": "站到自己的位置上。", "en": "I take my place."},
        {"zh": "这里有活人的气味。", "en": "There's living scent here."},
        {"zh": "我从黑雾里抬起头。", "en": "I slowly lift my head."},
        {"zh": "这道门不能空着。", "en": "This gate can't stand empty."},
        {"zh": "由我来守着这里。", "en": "I'll keep it."},
        {"zh": "谁踏上了门槛？", "en": "Who stepped onto the threshold?"}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我的甲，铁都发红。", "en": "Fire scorched my armor; the iron glows."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从关口摔下去，砸碎了石板。", "en": "I fell from the gate and shattered the stones."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的甲里。", "en": "Water floods inside my armor."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的甲片掀开了。", "en": "The blast pried my plates apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西卡在我的胸口甲缝。", "en": "Something is lodged in my chest seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量敲在我的甲上。", "en": "That force struck my armor."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这副甲里没有血肉可耗。", "en": "No flesh in this armor to consume."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的长戟走遍全身。", "en": "Lightning ran down my halberd through me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的石板忽然不见。", "en": "The flagstones vanished."}
      ]
    }
  }
}
