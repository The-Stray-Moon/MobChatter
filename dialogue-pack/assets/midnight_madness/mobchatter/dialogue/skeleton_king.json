{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的骨腿敲着地面。", "en": "My bone legs click on the ground."},
        {"zh": "王冠压着我的头骨。", "en": "The crown weighs on my skull."},
        {"zh": "我一步一步走向王座前。", "en": "I step before the throne."},
        {"zh": "甲片碰撞发出闷响。", "en": "My plates knock with a dull sound."},
        {"zh": "我走过的地方没有声音留下。", "en": "Nothing lingers where I pass."},
        {"zh": "披风扫过石板上的灰。", "en": "My cloak sweeps the dust off the flagstones."},
        {"zh": "我的披风拖在骨头上。", "en": "My cloak trails over bone."},
        {"zh": "每走一步王冠就晃一下。", "en": "The crown sways with each step."},
        {"zh": "我从阴影里往前走。", "en": "I step out of the shadow."},
        {"zh": "我走向那盏没熄的火。", "en": "I walk toward the fire still burning."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在王座上不动。", "en": "I sit the throne, unmoving."},
        {"zh": "我的指骨敲着扶手。", "en": "My finger bones tap the armrest."},
        {"zh": "眼睛里的光很稳。", "en": "The light in my eyes is steady."},
        {"zh": "我数着殿堂的柱子。", "en": "I count the pillars of the hall."},
        {"zh": "尘埃落在我肩上。", "en": "Dust settles on my shoulders."},
        {"zh": "我在听骨头的声音。", "en": "I listen to the bones."},
        {"zh": "我的王冠有点歪。", "en": "My crown sits askew."},
        {"zh": "这里安静得像墓里。", "en": "As quiet as a tomb here."},
        {"zh": "这具骨架用不着吸气。", "en": "I need no breath."},
        {"zh": "我抬起手又放下。", "en": "I raise a hand, then lower it."},
        {"zh": "我想起一个名字。", "en": "A name comes to mind."},
        {"zh": "外面有风在吹。", "en": "Wind outside."},
        {"zh": "我的披风不动。", "en": "My cloak doesn't stir."},
        {"zh": "这个位置我坐了很久。", "en": "I've held this seat a long time."},
        {"zh": "时间对我没意义。", "en": "Time means nothing to me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走到我的殿堂里了。", "en": "You've come into my hall."},
        {"zh": "你不过是血肉之躯。", "en": "Flesh and blood."},
        {"zh": "你身上还有温度。", "en": "You're still warm."},
        {"zh": "我的王冠认得你这种眼神。", "en": "My crown knows that look."},
        {"zh": "你看着我的骨头做什么？", "en": "Why stare at my bones?"},
        {"zh": "这里的一切都属于我。", "en": "Everything here is mine."},
        {"zh": "你会留下来的。", "en": "You'll stay."},
        {"zh": "我不需要呼吸，但需要侍从。", "en": "I need no breath, but I need subjects."},
        {"zh": "你不该点那盏火。", "en": "You shouldn't have lit that fire."},
        {"zh": "我的剑很久没动了。", "en": "My blade hasn't moved in ages."},
        {"zh": "你的胆子不小。", "en": "You have some nerve."},
        {"zh": "我看得见你的骨头。", "en": "I can see the bones in you."},
        {"zh": "你站得那么远。", "en": "You stand so far away."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的骨头上裂了一道。", "en": "A crack runs along my bone."},
        {"zh": "王冠歪了，我扶一扶。", "en": "My crown slipped. Let me set it."},
        {"zh": "王冠掉了半寸，我扶回原位。", "en": "My crown slips half an inch; I set it back."},
        {"zh": "我的甲片松了。", "en": "A plate came loose."},
        {"zh": "我根本不会流血。", "en": "I don't bleed."},
        {"zh": "王冠歪了一点。", "en": "My crown shifted."},
        {"zh": "肋骨断了两根，我照样站着。", "en": "Two ribs are broken and I still stand."},
        {"zh": "你的武器不错。", "en": "Your weapon is decent."},
        {"zh": "我的王冠，黑得发亮。", "en": "My crown is black and gleaming."},
        {"zh": "你再挥一下试试。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些留给活人吧。", "en": "Leave that for the living."},
        {"zh": "我的盛宴早就散了。", "en": "My feast ended long ago."},
        {"zh": "你把食物拿远些。", "en": "Take the food away."},
        {"zh": "供桌上的果子，你自己吃。", "en": "Eat the fruit on the altar yourself."},
        {"zh": "这对我毫无意义。", "en": "It means nothing to me."},
        {"zh": "你饿就自己吃。", "en": "If you're hungry, eat."},
        {"zh": "我不需要供奉。", "en": "I need no offerings."},
        {"zh": "这桌上该摆别的。", "en": "Other things belong on this table."},
        {"zh": "把这供品收进箱里。", "en": "Put it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的甲上。", "en": "You struck my armor."},
        {"zh": "我站得比石碑还稳。", "en": "I stand steadier than a stele."},
        {"zh": "你的体温蹭到我了。", "en": "Your warmth brushed me."},
        {"zh": "别用你的热度碰我。", "en": "I dislike being touched."},
        {"zh": "这一下我连退都没退。", "en": "I didn't even give ground."},
        {"zh": "你的手已经冰了。", "en": "Your hands are cold now."},
        {"zh": "闪开，我要走上台阶。", "en": "Move; I'm passing."},
        {"zh": "骨头碰铁的声音不好听。", "en": "Bone against iron sounds wrong."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不过是个空壳。", "en": "I'm only an empty shell."},
        {"zh": "这些事和骨头无关。", "en": "Such things have nothing to do with bones."},
        {"zh": "你在跟一个死人讲话。", "en": "You're speaking to a dead thing."},
        {"zh": "王座比这个重要。", "en": "The throne matters more."},
        {"zh": "这件事你不该问。", "en": "You shouldn't ask."},
        {"zh": "我的殿堂不需要这些。", "en": "My hall doesn't need such things."},
        {"zh": "回到殿堂的石柱后面。", "en": "Return to your place."},
        {"zh": "别让我再重复一遍。", "en": "Don't make me repeat it."},
        {"zh": "你先退下去吧。", "en": "Withdraw."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的指骨拿不稳。", "en": "My finger bones can't grip well."},
        {"zh": "这骨头似的东西是什么？", "en": "What is this?"},
        {"zh": "不值一提的东西。", "en": "A trifle."},
        {"zh": "这属于我的殿堂。", "en": "This belongs to the hall."},
        {"zh": "我很久没碰过实物了。", "en": "I haven't touched anything real in ages."},
        {"zh": "我用指骨捏了捏。", "en": "I squeeze it."},
        {"zh": "它到底碎了没有？", "en": "Did it break?"},
        {"zh": "把它放回原处。", "en": "Put it back."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "殿堂的门关上了。", "en": "The hall's doors close."},
        {"zh": "你身上的热气我闻得到。", "en": "I can smell the heat on you."},
        {"zh": "我的剑出鞘了。", "en": "My blade leaves its sheath."},
        {"zh": "这里没有第二个王。", "en": "There is no second king here."},
        {"zh": "你的骨头会留在这里。", "en": "Your bones will stay here."},
        {"zh": "我看着你已经很久。", "en": "I've watched you a long while."},
        {"zh": "我不是活人，不会累。", "en": "I'm not alive; I don't tire."},
        {"zh": "你已经退到石柱尽头。", "en": "You're at the wall."},
        {"zh": "我的王冠在响。", "en": "The crown is ringing."},
        {"zh": "我慢慢数到三下。", "en": "I count to three."},
        {"zh": "别想着跑出这道门。", "en": "Don't think of the door."},
        {"zh": "你的心跳更快了。", "en": "Your heart beats faster."},
        {"zh": "这一下我会慢慢来。", "en": "I'll take this slowly."},
        {"zh": "你走到我面前。", "en": "Come."},
        {"zh": "你给我跪下来。", "en": "Kneel."},
        {"zh": "这是我的命令。", "en": "That is an order."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的剑拖在地上。", "en": "My blade drags on the floor."},
        {"zh": "你正在往后退。", "en": "You're retreating."},
        {"zh": "每一根柱子后面都有人。", "en": "There are figures behind every pillar."},
        {"zh": "我等你跑到尽头。", "en": "I wait for you to reach the end."},
        {"zh": "我的殿堂没有窗。", "en": "My hall has no windows."},
        {"zh": "我的骨头不会流血。", "en": "My bones don't bleed."},
        {"zh": "你的剑在发抖。", "en": "Your blade is shaking."},
        {"zh": "这条路只有一扇门。", "en": "This path has one door."},
        {"zh": "我把门守住了。", "en": "I hold the door."},
        {"zh": "你再退就撞墙。", "en": "One more step and you hit the wall."},
        {"zh": "我用不着着急。", "en": "I needn't hurry."},
        {"zh": "我的耐心比你的命长。", "en": "My patience outlasts your life."},
        {"zh": "你的靴底在石板上打滑。", "en": "Your boot soles slip on the flagstones."},
        {"zh": "走到这里就到头了。", "en": "This far."},
        {"zh": "我这就动手了。", "en": "I'm striking."},
        {"zh": "看清楚我的剑。", "en": "Watch my blade."},
        {"zh": "不要回头去看。", "en": "Don't look back."},
        {"zh": "一切都结束了。", "en": "It's over."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的剑落下来了。", "en": "The blade comes down."},
        {"zh": "这一击很慢，但你躲不开。", "en": "Slow, but you can't dodge it."},
        {"zh": "骨手抓住了你的肩。", "en": "A bone hand seizes your shoulder."},
        {"zh": "你的甲凹了一块。", "en": "Your armor dented."},
        {"zh": "我抬起手一挥。", "en": "I sweep my arm."},
        {"zh": "王冠的光照在你脸上。", "en": "The crown's light falls on your face."},
        {"zh": "你被推到柱子边。", "en": "You're shoved against a pillar."},
        {"zh": "血在石板上流开。", "en": "Blood spreads on the flagstones."},
        {"zh": "我的剑没有温度。", "en": "My blade has no warmth."},
        {"zh": "这一下是给你的礼。", "en": "That blow is my gift."},
        {"zh": "我再来一剑试试。", "en": "Another swing."},
        {"zh": "剑背拍在你肩上，闷响。", "en": "The flat of my blade slaps your shoulder."},
        {"zh": "你就此倒下吧。", "en": "Fall."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "王座上的灰尘落下来。", "en": "Dust falls from the throne."},
        {"zh": "我的王冠先亮起来。", "en": "My crown lights first."},
        {"zh": "殿堂的门自己开了。", "en": "The hall's doors open on their own."},
        {"zh": "我站起来，骨头作响。", "en": "I rise; my bones creak."},
        {"zh": "这里本该是空的。", "en": "This place should be empty."},
        {"zh": "我数了数殿里的柱子。", "en": "I count the pillars."},
        {"zh": "殿里的火盆都灭了。", "en": "The braziers are all out."},
        {"zh": "我的剑还在这里。", "en": "My blade is still here."},
        {"zh": "谁把这地方弄脏了。", "en": "Who dirtied this place?"},
        {"zh": "空气里有活人的味。", "en": "There's living scent in the air."},
        {"zh": "我坐回王座上。", "en": "I sit back on the throne."},
        {"zh": "殿堂安静下来。", "en": "The hall falls silent."},
        {"zh": "我缓缓抬起手。", "en": "I lift a hand."},
        {"zh": "让他们都醒来。", "en": "Let them all wake."},
        {"zh": "这一晚不会安静。", "en": "This night won't be quiet."},
        {"zh": "殿堂里再没有别的声音。", "en": "No other sound in the hall."},
        {"zh": "你们全都来吧。", "en": "Come."},
        {"zh": "这座殿堂是我的。", "en": "The hall is mine."},
        {"zh": "骨手按在剑柄上。", "en": "My bone hand rests on the hilt."},
        {"zh": "王座已经扶正了。", "en": "I am ready."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的骨头，我听见响声。", "en": "Fire bakes my bones; I hear them crack."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从王座台阶上摔下去，骨头散了一地。", "en": "I fell from the dais; bones scattered."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我的甲片掀飞了。", "en": "The blast tore my plates away."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量想拆散我。", "en": "That force tries to unmake me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷穿过我的骨头，我僵在原地。", "en": "Lightning passed through my bones; I froze."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的石板没有了。", "en": "The flagstones beneath me are gone."}
      ]
    }
  }
}
