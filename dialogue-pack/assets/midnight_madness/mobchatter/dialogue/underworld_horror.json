{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从红色岩壁后面走出来。", "en": "I come out from behind the red rock."},
        {"zh": "我的脚踩在碎陶片上。", "en": "My feet crack the broken terracotta."},
        {"zh": "竹林里，我推倒一排竹子。", "en": "I push a row of bamboo down."},
        {"zh": "玄武岩上我的影子很黑。", "en": "My shadow is very black on basalt."},
        {"zh": "我走得很慢，很有目的。", "en": "I walk slowly, with purpose."},
        {"zh": "我经过的地方声音都小了。", "en": "Sound quiets where I pass."},
        {"zh": "我拖着一段影子走。", "en": "I drag a strip of shadow with me."},
        {"zh": "我的呼吸像从很深的地方来。", "en": "My breathing comes from somewhere deep."},
        {"zh": "我从不绕路。", "en": "I never go around."},
        {"zh": "脚下岩面发冷。", "en": "The stone underfoot goes cold."},
        {"zh": "我在找活的东西。", "en": "I'm looking for something alive."},
        {"zh": "我一步步压近。", "en": "I close in, step by step."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，几乎没有起伏。", "en": "I stand, barely moving."},
        {"zh": "我身后的空气发黑。", "en": "The air behind me darkens."},
        {"zh": "我在听，很远也听。", "en": "I listen, and I listen far."},
        {"zh": "我的头低着。", "en": "My head hangs low."},
        {"zh": "岩缝里冒出一点烟。", "en": "A little smoke rises from a crack."},
        {"zh": "灯下没有我的影子。", "en": "There's no shadow of mine under this lamp."},
        {"zh": "岩缝里有烟，我抬手拨开。", "en": "Smoke seeps from a crack; I brush it aside."},
        {"zh": "四周的虫不叫了。", "en": "The insects have gone silent."},
        {"zh": "竹林里的影子，比竹子多。", "en": "More shadows in the bamboo than stalks."},
        {"zh": "有什么在我身下爬。", "en": "Something crawls beneath me."},
        {"zh": "我对着石头低声说了句什么。", "en": "I mutter something to the stone."},
        {"zh": "又一片瓦碎在我脚边。", "en": "Another tile breaks at my feet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起了眼。", "en": "I raise my eyes."},
        {"zh": "你身上的光很刺眼。", "en": "The light on you stings."},
        {"zh": "我的脸不太对。", "en": "My face isn't right."},
        {"zh": "你数得出我几只手吗？", "en": "Can you count my arms?"},
        {"zh": "你退一步，地就冷一分。", "en": "Each step back, the ground cools."},
        {"zh": "我的声音从你脚下传来。", "en": "My voice comes from under your feet."},
        {"zh": "你不该在这里点火。", "en": "You shouldn't light a fire here."},
        {"zh": "我的眼睛没离开你。", "en": "My eyes haven't left you."},
        {"zh": "你的影子短了一截。", "en": "Your shadow just got shorter."},
        {"zh": "你的灯照不到我站的地方。", "en": "Your torch doesn't reach where I stand."},
        {"zh": "再近一点，我看得清。", "en": "A little closer and I'll see you clearly."},
        {"zh": "别跑，我不喜欢追。", "en": "Don't run; I dislike chasing."},
        {"zh": "你听见那个声音了吗？", "en": "Do you hear that sound?"},
        {"zh": "它在你后面。", "en": "It's behind you."},
        {"zh": "现在，看着我。", "en": "Now. Look at me."},
        {"zh": "凝块从我身上滴下来。", "en": "Clots drip off me."},
        {"zh": "你已经在这里太久了。", "en": "You've been here too long."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我向后退了一寸。", "en": "I recede an inch."},
        {"zh": "我身上掉下一点黑的。", "en": "Something black falls off me."},
        {"zh": "你没有打散我。", "en": "You haven't scattered me."},
        {"zh": "我的形状散了一下又合上。", "en": "My shape scatters, then knits back."},
        {"zh": "我直起腰，红土从我身上掉。", "en": "I straighten and red clay sifts off me."},
        {"zh": "我的呼吸从地底传上来。", "en": "My breathing rises from under the ground."},
        {"zh": "你这一下，我记在凝块里。", "en": "I keep this blow in my clotted flesh."},
        {"zh": "你把这里弄得更暗了。", "en": "You've made it darker here."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那不是食物，但接近。", "en": "That isn't food, but it's close."},
        {"zh": "我靠近一点闻。", "en": "I come closer to smell it."},
        {"zh": "你把手里的搁下。", "en": "Set down what you hold."},
        {"zh": "我看着就行。", "en": "Watching is enough."},
        {"zh": "空气里有血腥。", "en": "There's blood in the air."},
        {"zh": "你退得比我快。", "en": "You back away faster than I move."},
        {"zh": "你手里那点吃食，也想勾引我？", "en": "You think a handful of food could lure me?"},
        {"zh": "别拿食物在我面前晃，我不吃这套。", "en": "Stop waving that food at me — I don't fall for it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了我，像撞进冷里。", "en": "You bump into me like into cold."},
        {"zh": "我一点没动。", "en": "I don't shift at all."},
        {"zh": "你的手穿过我的肋骨。", "en": "Your hand goes through my ribs."},
        {"zh": "空气变沉了。", "en": "The air grows heavy."},
        {"zh": "碰过来，没有回响。", "en": "It came in without an echo."},
        {"zh": "我身上掉下一点灰。", "en": "A little ash falls off me."},
        {"zh": "撞我一下，你猜会发生什么？", "en": "Bump into me and guess what happens next."},
        {"zh": "离我远点，别贴着我走。", "en": "Keep your distance — don't walk so close."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一个从我背后出来。", "en": "Another steps out from behind me."},
        {"zh": "她比我还高。", "en": "She's taller than me."},
        {"zh": "我们不说话，只看着。", "en": "We don't speak; we only look."},
        {"zh": "她的影子也不见了。", "en": "Her shadow is gone too."},
        {"zh": "我们同时看向一个方向。", "en": "We look the same way at once."},
        {"zh": "她的手搭在我肩上。", "en": "Her hand rests on my shoulder."},
        {"zh": "四周的声音全没了。", "en": "All sound around us stops."},
        {"zh": "我们消失在同一处。", "en": "We vanish in the same place."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯下腰去够它。", "en": "I stoop for it."},
        {"zh": "这东西在我手里发烫。", "en": "It's hot in my hand."},
        {"zh": "它上面有血。", "en": "There's blood on it."},
        {"zh": "它一直在我耳边响。", "en": "It keeps ringing by my ear."},
        {"zh": "我扔在地上。", "en": "I throw it down."},
        {"zh": "它滚进岩缝。", "en": "It rolls into a crack."},
        {"zh": "想把我捡走？先掂量掂量。", "en": "Want to carry me off? Weigh your odds first."},
        {"zh": "凑近我身上那团凝块，你真有胆。", "en": "Coming close to the clump on me — you have nerve."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的呼吸加快。", "en": "My breathing picks up."},
        {"zh": "周围的温度掉了。", "en": "The temperature drops."},
        {"zh": "我朝你转身。", "en": "I turn toward you."},
        {"zh": "我的手指伸开了。", "en": "My fingers spread."},
        {"zh": "你退到了岩壁边。", "en": "You've backed to the rock wall."},
        {"zh": "我这就开始走。", "en": "I start walking."},
        {"zh": "你听见了，对吗？", "en": "You heard that, didn't you?"},
        {"zh": "你的手抖得很明显。", "en": "Your hands are clearly shaking."},
        {"zh": "这回该我了。", "en": "This time it's my turn."},
        {"zh": "你居然没跑。", "en": "You actually didn't run."},
        {"zh": "这样正合我意。", "en": "That suits me well."},
        {"zh": "我朝你过来了。", "en": "I'm coming for you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你，一直。", "en": "I follow you, always."},
        {"zh": "你绕过一个石柱。", "en": "You go round a pillar."},
        {"zh": "你回头看，我停在原处。", "en": "You look back; I've stopped."},
        {"zh": "距离一点没变。", "en": "The distance hasn't changed."},
        {"zh": "我知道你往哪跑。", "en": "I know where you'll run."},
        {"zh": "你脚下的地面发凉。", "en": "The ground under you cools."},
        {"zh": "火把在我经过时熄了。", "en": "A torch went out as I passed."},
        {"zh": "你的步子我数到七。", "en": "I've counted seven of your steps."},
        {"zh": "你还剩三步。", "en": "Three steps left for you."},
        {"zh": "竹林太密，我穿过去。", "en": "Bamboo's thick. I'll pass through."},
        {"zh": "你的影子只剩下一点。", "en": "Your shadow is nearly gone."},
        {"zh": "我贴着你左侧走。", "en": "I keep to your left side."},
        {"zh": "现在在你后面。", "en": "Now behind you."},
        {"zh": "你听见我的声音很近。", "en": "My voice sounds close."},
        {"zh": "我从没离开过。", "en": "I never left."},
        {"zh": "到这一步够了。", "en": "Far enough now."},
        {"zh": "你给我停下来。", "en": "Stop where you are."},
        {"zh": "把眼睛转过来。", "en": "Turn your eyes here."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手按住了你。", "en": "My hand closes on you."},
        {"zh": "四周一下黑了。", "en": "Everything goes black."},
        {"zh": "你听见自己的血在响。", "en": "You can hear your own blood."},
        {"zh": "我的声音从你身体里出来。", "en": "My voice comes from inside you."},
        {"zh": "你被推得很远。", "en": "You're thrown far."},
        {"zh": "我站在你上面。", "en": "I stand over you."},
        {"zh": "你想抬手，抬不动。", "en": "You try to raise a hand; it won't move."},
        {"zh": "你的火把只剩灰。", "en": "Your torch is only ash."},
        {"zh": "我低下头靠近你。", "en": "I lower my head to you."},
        {"zh": "你的眼睛闭上了。", "en": "Your eyes close."},
        {"zh": "我把你往碎陶片里按。", "en": "I press you down into the broken pottery."},
        {"zh": "这里安静了。", "en": "It's quiet here now."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "恶地的红岩上多了一团黑。", "en": "A patch of black on the red badlands rock."},
        {"zh": "竹林忽然很安静。", "en": "The bamboo grove goes silent."},
        {"zh": "我从岩缝里升起来。", "en": "I rise out of the crack in the rock."},
        {"zh": "玄武岩上冒起白烟。", "en": "White vapour rises from the basalt."},
        {"zh": "落地时连石屑都没动。", "en": "Not even grit stirred as I landed."},
        {"zh": "周围的火把暗了一格。", "en": "Nearby torches dim."},
        {"zh": "我开始呼吸。", "en": "I begin to breathe."},
        {"zh": "这里的气味很干。", "en": "The air here is dry."},
        {"zh": "我踩碎了脚下的陶片。", "en": "I crush terracotta underfoot."},
        {"zh": "我从恶地的红岩缝里立起。", "en": "I rise out of a crack in the badlands rock."},
        {"zh": "我的影子在地上摊开。", "en": "My shadow spreads on the ground."},
        {"zh": "我找到了这个位置。", "en": "I've found this spot."},
        {"zh": "我开始等着。", "en": "I begin to wait."},
        {"zh": "今晚会很长。", "en": "This will be a long night."},
        {"zh": "轮到你们了。", "en": "Your turn now."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光照到我，我的边角烧卷了。", "en": "Firelight catches me; my edges curl."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，落得很久。", "en": "I fall, and fall a long while."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进来，我还在呼吸。", "en": "Water floods in, and I keep breathing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我撕成两半，又连上。", "en": "The blast splits me and I rejoin."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过去，没有留下孔。", "en": "The arrow passes through and leaves no hole."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我的形状变了。", "en": "That light changes my shape."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照亮我，我反而更长。", "en": "Lightning shows me, and I grow longer."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里比我来处更黑。", "en": "This place is darker than where I came from."}
      ]
    }
  }
}
