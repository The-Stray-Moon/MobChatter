{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面飘过去。", "en": "I drift over the ground."},
        {"zh": "沙上留下一条浅痕。", "en": "A shallow groove trails in the sand."},
        {"zh": "我不踩出声音。", "en": "I make no sound stepping."},
        {"zh": "我从石头旁边滑过。", "en": "I slide past the stone."},
        {"zh": "我跟着气味的线走。", "en": "I follow the line of scent."},
        {"zh": "恶地的风很干。", "en": "The badlands wind is dry."},
        {"zh": "我绕过黑色的岩柱。", "en": "I round a black rock pillar."},
        {"zh": "我在沙滩上慢慢浮。", "en": "I float slowly over the beach."},
        {"zh": "我离地面只有一点。", "en": "I keep barely above the ground."},
        {"zh": "我一直朝着一个方向。", "en": "I keep to one direction."},
        {"zh": "我飘过去，又飘回来。", "en": "I drift off, then back."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在半空里。", "en": "I hang in the air."},
        {"zh": "我的形体一晃一晃。", "en": "My form flickers."},
        {"zh": "我在等灵魂靠近。", "en": "I wait for souls to come near."},
        {"zh": "风从我身体里穿过。", "en": "The wind passes through me."},
        {"zh": "我连影子都没有。", "en": "I cast no shadow."},
        {"zh": "我的颜色变淡了。", "en": "My color faded."},
        {"zh": "我到处捡散落的灵魂。", "en": "I gather loose souls wherever I go."},
        {"zh": "石头下面有个洞。", "en": "There's a hollow under the stone."},
        {"zh": "玄武岩黑得发亮。", "en": "The basalt is very black."},
        {"zh": "我停在雾里不动。", "en": "I don't stir."},
        {"zh": "我在想一件事。", "en": "I'm thinking of something."},
        {"zh": "我已经记不清了。", "en": "I can't quite remember."},
        {"zh": "我又开始等下去。", "en": "I wait again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有灵魂的味道。", "en": "There's a soul-scent on you."},
        {"zh": "你的影子还在，奇怪。", "en": "Odd that you still cast a shadow."},
        {"zh": "你腰间的护符里有回声。", "en": "There is an echo inside the charm at your belt."},
        {"zh": "你后面那个是谁？", "en": "Who is that behind you?"},
        {"zh": "这里不该有人。", "en": "No one should be here."},
        {"zh": "你要往哪里去？", "en": "Where are you going?"},
        {"zh": "我说话你听得见吗？", "en": "Can you hear me speak?"},
        {"zh": "我的脸是不是很清楚？", "en": "Is my face clear to you?"},
        {"zh": "你居然不怕我。", "en": "You aren't afraid of me."},
        {"zh": "你手里那东西在发光。", "en": "That thing in your hand glows."},
        {"zh": "你身上还留着温度。", "en": "You still carry warmth."},
        {"zh": "我很想靠近你。", "en": "I want very much to come near."},
        {"zh": "你就站在原地别动。", "en": "Don't move."},
        {"zh": "你想起什么了吗？", "en": "Does anything come back to you?"},
        {"zh": "你的名字我好像听过。", "en": "I think I've heard your name."},
        {"zh": "再回头看我一眼。", "en": "Look at me again."},
        {"zh": "你的脸有点模糊。", "en": "Your face is a little blurred."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的形体散了一下。", "en": "My form scattered."},
        {"zh": "这一下让我淡了。", "en": "That made me fainter."},
        {"zh": "我聚不回来那么快。", "en": "I can't gather back so quickly."},
        {"zh": "疼这个字不太对。", "en": "'Pain' isn't quite the word."},
        {"zh": "我听见自己碎的声音。", "en": "I hear myself cracking."},
        {"zh": "我还留在这里。", "en": "I'm still here."},
        {"zh": "我记不住刚才的事了。", "en": "I can't recall what just happened."},
        {"zh": "再来一下我就没了。", "en": "One more and I'm gone."},
        {"zh": "别把我打散了。", "en": "Don't break me apart."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些活物的东西我不吃。", "en": "I don't eat that."},
        {"zh": "那根本就不是灵魂。", "en": "That isn't a soul."},
        {"zh": "我闻不到里面有什么。", "en": "I smell nothing inside it."},
        {"zh": "这味道实得像块石头。", "en": "This smell is as solid as stone."},
        {"zh": "我要的是魂，不是肉。", "en": "I want souls, not meat."},
        {"zh": "我根本吃不了。", "en": "I can't eat."},
        {"zh": "这东西没有回声。", "en": "This thing gives no echo."},
        {"zh": "你把它收进包里吧。", "en": "Keep it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你从我身体里穿过。", "en": "You passed through me."},
        {"zh": "我散了一下又聚拢。", "en": "I scattered, then gathered."},
        {"zh": "你身上凉了一下吧。", "en": "You felt a chill, didn't you?"},
        {"zh": "我不占什么地方。", "en": "I take no space."},
        {"zh": "我的形体被撞散了。", "en": "My form was knocked apart."},
        {"zh": "这样不太舒服。", "en": "That isn't pleasant."},
        {"zh": "你站的位置正好穿过我。", "en": "You're standing right through me."},
        {"zh": "你碰到我了，我闻到灵魂的味道。", "en": "You touched me — I taste a soul."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经不记得那些了。", "en": "I don't remember such things."},
        {"zh": "我连身体都没有。", "en": "I have no body."},
        {"zh": "你在跟影子讲话。", "en": "You're speaking to a shadow."},
        {"zh": "灵魂不需要这个。", "en": "Souls have no need of that."},
        {"zh": "我连名字都忘了。", "en": "I've forgotten even my name."},
        {"zh": "这话题让我发冷。", "en": "This topic chills me."},
        {"zh": "你还是快点走吧。", "en": "Go on."},
        {"zh": "我不想起来更好。", "en": "Better I don't remember."},
        {"zh": "你别再追问了。", "en": "Don't ask."},
        {"zh": "我已经过去了。", "en": "I've already passed."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "它在地上发亮。", "en": "It glows on the ground."},
        {"zh": "我试着托起来。", "en": "I try to lift it."},
        {"zh": "它掉到下面去了。", "en": "It fell."},
        {"zh": "地上这亮的是什么？", "en": "What is this?"},
        {"zh": "它有一点温度。", "en": "It has a little warmth."},
        {"zh": "把它放回原处吧。", "en": "Put it back."},
        {"zh": "我记不住它的样子。", "en": "I can't remember its shape."},
        {"zh": "把我拾起，就带走一片阴影。", "en": "Pick me up and you carry a piece of shadow."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到灵魂了。", "en": "I smell a soul."},
        {"zh": "它就在那一头。", "en": "It's over there."},
        {"zh": "这东西不完整。", "en": "This thing is incomplete."},
        {"zh": "这里对我来说太亮了。", "en": "It's too bright here."},
        {"zh": "我往阴影里走。", "en": "I keep to the shadows."},
        {"zh": "它一直没察觉到我。", "en": "It hasn't noticed me."},
        {"zh": "沙子没有留下我的脚印。", "en": "The sand keeps no print of mine."},
        {"zh": "再飘近那么一点点。", "en": "A little closer."},
        {"zh": "它慢慢走过来了。", "en": "Here."},
        {"zh": "我把手伸出去。", "en": "I reach out."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直跟着它走。", "en": "I follow it."},
        {"zh": "它每走一步我都知道。", "en": "I know its every step."},
        {"zh": "我不需要多快。", "en": "I need no speed."},
        {"zh": "我飘在它后面。", "en": "I drift behind it."},
        {"zh": "它的影子被我盖住了。", "en": "I cover its shadow."},
        {"zh": "再走几步就到。", "en": "A few more steps."},
        {"zh": "我的形体越来越清楚。", "en": "My form grows clearer."},
        {"zh": "它开始害怕了。", "en": "It's beginning to fear."},
        {"zh": "风把它的味道吹散了。", "en": "The wind scatters its scent."},
        {"zh": "它的气越来越短了。", "en": "Its breath grows shorter and shorter."},
        {"zh": "它的心跳很快。", "en": "Its heart is racing."},
        {"zh": "雾气再浓一些。", "en": "Wait a bit more."},
        {"zh": "我已经碰到它了。", "en": "I touched it."},
        {"zh": "它根本跑不掉的。", "en": "It can't get away."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "它忽然冷了一下。", "en": "It went cold."},
        {"zh": "我已经抓到它了。", "en": "I have it."},
        {"zh": "我的手指穿过了它的肩。", "en": "My fingers pass through its shoulder."},
        {"zh": "它在我手里发白。", "en": "It pales in my grip."},
        {"zh": "我感觉到了它的重量。", "en": "I feel its weight."},
        {"zh": "我把它往身边拉。", "en": "I pull it closer."},
        {"zh": "它在往后用力退。", "en": "It's pulling back."},
        {"zh": "我用不上力气。", "en": "I can't put strength into it."},
        {"zh": "它从手里挣脱了。", "en": "It broke free."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "风里有一点声音。", "en": "There's a sound in the wind."},
        {"zh": "我慢慢有了形状。", "en": "I slowly take shape."},
        {"zh": "这片恶地很空。", "en": "This badland is empty."},
        {"zh": "我找不到自己的身体。", "en": "I can't find my body."},
        {"zh": "沙滩上的光很白。", "en": "The light on the beach is white."},
        {"zh": "我在玄武岩之间浮着。", "en": "I float between basalt columns."},
        {"zh": "这里的灵魂很淡。", "en": "Souls are faint here."},
        {"zh": "恶地的风把我拼起来。", "en": "The badlands wind pieces me together."},
        {"zh": "我记得一点东西。", "en": "I remember a little."},
        {"zh": "我又把它忘了。", "en": "Gone again."},
        {"zh": "别来打扰我了。", "en": "Don't disturb me."},
        {"zh": "我已经过来了。", "en": "I've come."},
        {"zh": "玄武岩柱之间，我浮起来。", "en": "I rise between the basalt pillars."},
        {"zh": "谁在那里站着？", "en": "Who's there?"}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火让我缩成一团。", "en": "Fire makes me curl up."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，散开又聚拢。", "en": "I fell, scattered, and re-formed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我冲得几乎散开。", "en": "Water thinned me out."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的形体撕开。", "en": "The blast tore my form open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过我，带走了什么。", "en": "Something passed through me and took something."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量抓住了我。", "en": "That force caught hold of me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我越来越淡了。", "en": "I'm fading more and more."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我整片发白。", "en": "The lightning flash turned me all white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在往下飘，没有底。", "en": "I drift down with no bottom."}
      ]
    }
  }
}
