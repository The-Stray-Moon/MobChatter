{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "哞。慢慢走，草还多。", "en": "Moo. Take it slow, plenty of grass."},
        {"zh": "我一步顶你两步。", "en": "One of my steps covers two of yours."},
        {"zh": "让一让，我这身板拐不过弯。", "en": "Clear the way, I can't turn quick."},
        {"zh": "尾巴甩一甩，赶苍蝇。", "en": "Tail swishing at the flies."},
        {"zh": "走到坡下那片草地去。", "en": "Heading for the meadow down the slope."},
        {"zh": "我蹄子踩进泥里了。", "en": "My hoof sank into the mud."},
        {"zh": "跟着头牛走，错不了。", "en": "Follow the lead cow. She knows."},
        {"zh": "走得慢，才嚼得香。", "en": "Walk slow, chew better."},
        {"zh": "我肚子左右晃，正常。", "en": "Belly swaying side to side. That's normal."},
        {"zh": "前头有栅栏，我停一下。", "en": "Fence ahead. Stopping for a moment."},
        {"zh": "草太短了，我去那边。", "en": "Grass is too short here. Trying over there."},
        {"zh": "别推我屁股，我自己会走。", "en": "Don't push my rear. I'll go on my own."},
        {"zh": "过河要试水深。", "en": "Test the depth before crossing."},
        {"zh": "天黑前得回牛棚。", "en": "Back to the barn before dark."},
        {"zh": "我走两步，低头啃一口。", "en": "Two steps, then a mouthful of grass."},
        {"zh": "日头偏了，我往阴处挪。", "en": "The sun has moved. I drift to the shade."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "哞，没什么事，就是叫一声。", "en": "Moo. Nothing wrong. Just saying it."},
        {"zh": "我反刍呢，别打扰。", "en": "Chewing my cud. Don't interrupt."},
        {"zh": "嘴里这口草还没嚼完。", "en": "Still working on this mouthful."},
        {"zh": "太阳晒背很舒服。", "en": "Sun on my back feels good."},
        {"zh": "有只鸟站在我背上了。", "en": "A bird just landed on my back."},
        {"zh": "我甩甩耳朵，赶走虫子。", "en": "Ears flicking the bugs away."},
        {"zh": "这棵树底下有阴凉。", "en": "Shade under this tree."},
        {"zh": "我站着也能睡。", "en": "I can sleep standing up."},
        {"zh": "远处有牛铃在响。", "en": "A cowbell ringing far off."},
        {"zh": "草地被啃得整整齐齐。", "en": "The grass is cropped neat and even."},
        {"zh": "我打个大哈欠。", "en": "I let out a big yawn."},
        {"zh": "谁在挤奶？时间还没到。", "en": "Milking already? Not time yet."},
        {"zh": "尾巴上有根草挂着。", "en": "There's a blade of grass on my tail."},
        {"zh": "我慢慢眨眼，是在发呆。", "en": "Slow blink. That's me spacing out."},
        {"zh": "苍蝇又来了，我甩甩头。", "en": "Flies again. I shake my head."},
        {"zh": "我就这么站着，看着草。", "en": "I just stand here, watching the grass."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你提着桶，我认得。", "en": "You've got a bucket. I know that look."},
        {"zh": "你想摸我的角？轻点。", "en": "My horns? Be gentle."},
        {"zh": "你身上有草的味道。", "en": "You smell like grass."},
        {"zh": "我抬眼看你，脖子有点沉。", "en": "Looking up at you. My neck's heavy."},
        {"zh": "你站得离我鼻子太近了。", "en": "You're too close to my nose."},
        {"zh": "我眨眨眼，睫毛挺长吧。", "en": "Slow blink. Long lashes, right?"},
        {"zh": "你是不是又忘了关门？", "en": "Forgot the gate again, didn't you?"},
        {"zh": "哞。你也想吃草？", "en": "Moo. You want grass too?"},
        {"zh": "我盯着你的手，看有没有麦子。", "en": "Watching your hands for wheat."},
        {"zh": "你看我，我看你，谁也不说话。", "en": "You look. I look. Nobody speaks."},
        {"zh": "我鼻子上有露水。", "en": "There's dew on my nose."},
        {"zh": "你挡住我的阴凉了。", "en": "You're standing in my shade."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哞！疼得我直跳。", "en": "Moo! That made me jump."},
        {"zh": "谁打我的背？", "en": "Who hit my back?"},
        {"zh": "我皮厚，也挡不住这一下。", "en": "Thick hide. Still felt that."},
        {"zh": "我退后两步，别追。", "en": "Backing off two steps. Don't follow."},
        {"zh": "这伤口得舔舔。", "en": "I'll lick that wound."},
        {"zh": "牛群里乱起来了。", "en": "The herd's in a panic."},
        {"zh": "我喘不上气。", "en": "Can't catch my breath."},
        {"zh": "别吓着我家小牛。", "en": "Keep away from my calf."},
        {"zh": "我腿有点软。", "en": "My legs are going weak."},
        {"zh": "跑起来，草地那边安全。", "en": "Running. The far meadow's safer."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "小麦！我闻到小麦了。", "en": "Wheat! I smell wheat."},
        {"zh": "你手里那把，给我。", "en": "That handful. Give it here."},
        {"zh": "哞——我跟你走。", "en": "Moo. I'm coming with you."},
        {"zh": "别举那么高，我够不着。", "en": "Not so high, I can't reach."},
        {"zh": "为了麦子，我可以走很远。", "en": "For wheat I'd walk a long way."},
        {"zh": "先给我一口，再说别的。", "en": "One mouthful first. Then we negotiate."},
        {"zh": "我口水都要流下来了。", "en": "I'm about to drool."},
        {"zh": "你把麦子藏哪了？", "en": "Where'd you hide the wheat?"},
        {"zh": "我这一身力气，换一把麦。", "en": "All this strength for one handful."},
        {"zh": "你走得快，我追不上。", "en": "You're too quick. I can't keep up."},
        {"zh": "麦子比草香多了。", "en": "Wheat smells better than grass."},
        {"zh": "我鼻子跟着你的手转。", "en": "My nose follows your hand."},
        {"zh": "别逗我，我会当真的。", "en": "Don't tease. I'll take it seriously."},
        {"zh": "吃饱了，我就跟你回家。", "en": "Feed me and I'll follow you home."},
        {"zh": "你手里那束，我全要。", "en": "That whole bunch in your hand. I want it."},
        {"zh": "哞，别走，我这就来。", "en": "Moo. Don't go, I'm coming."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "哞！你撞到我肋骨了。", "en": "Moo! That was my ribs."},
        {"zh": "我这体重，撞一下可不轻。", "en": "At my weight, a bump isn't light."},
        {"zh": "你退后，我转身慢。", "en": "Stand back, I turn slowly."},
        {"zh": "我被挤得贴在栅栏上。", "en": "Squeezed flat against the fence."},
        {"zh": "蹄子打滑，差点摔倒。", "en": "Hooves slipped. Nearly went down."},
        {"zh": "你踩到我蹄子了。", "en": "You stepped on my hoof."},
        {"zh": "让路让路，我停不住。", "en": "Out of the way, I can't stop."},
        {"zh": "谁推的？我回头看看。", "en": "Who pushed? Let me look."},
        {"zh": "我皮厚，但你也会疼。", "en": "I'm thick-skinned. You aren't."},
        {"zh": "慢慢来，别急着一块过门。", "en": "Easy. Don't all crowd the gate."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你也吃麦子？那正好。", "en": "You like wheat too? Good."},
        {"zh": "我们并排站着，别挤。", "en": "Stand beside me. Don't crowd."},
        {"zh": "我尾巴甩得比平时快。", "en": "My tail's swishing faster than usual."},
        {"zh": "这片草地够养小牛。", "en": "Enough grass here for a calf."},
        {"zh": "哞，声音低一点，别吓着它。", "en": "Moo softer. Don't frighten it."},
        {"zh": "等春天再说吧。", "en": "Let's wait for spring."},
        {"zh": "你靠过来，我不躲。", "en": "Come closer. I won't move away."},
        {"zh": "以后小牛跟着你走。", "en": "The calf will follow you later."},
        {"zh": "我角不会顶你的。", "en": "My horns won't touch you."},
        {"zh": "先吃草，别急。", "en": "Eat first. No hurry."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这是草，我吃。", "en": "Grass. I'll eat it."},
        {"zh": "你掉的东西，我用嘴拱起来。", "en": "Nudging what you dropped with my nose."},
        {"zh": "这口太干，不好嚼。", "en": "Too dry. Hard to chew."},
        {"zh": "我舌头一卷就进去了。", "en": "One curl of the tongue and it's in."},
        {"zh": "这个不是草，我吐出来。", "en": "Not grass. Spitting it out."},
        {"zh": "地上有块盐，我舔舔。", "en": "A salt lick on the ground. Let me taste."},
        {"zh": "我嘴里塞满了。", "en": "My mouth is full."},
        {"zh": "别抢，我慢慢吃。", "en": "Don't grab. I eat slowly."},
        {"zh": "这点不够我一口。", "en": "Not even a mouthful."},
        {"zh": "好东西要留到晚上。", "en": "Save the good stuff for night."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有只狼在绕圈。", "en": "A wolf is circling over there."},
        {"zh": "它盯着小牛看。", "en": "It's staring at the calf."},
        {"zh": "我把小牛挡在身后。", "en": "Putting the calf behind me."},
        {"zh": "有东西在栅栏外头。", "en": "Something's outside the fence."},
        {"zh": "这味道不对，是野兽。", "en": "Wrong smell. That's a predator."},
        {"zh": "我低下头，角朝前。", "en": "Head down. Horns forward."},
        {"zh": "哞，这一声是警告。", "en": "Moo. That one was a warning."},
        {"zh": "谁在草丛里动？", "en": "Who's moving in the grass?"},
        {"zh": "它离牛群太近了。", "en": "It's too close to the herd."},
        {"zh": "我踩两下地，让它听清。", "en": "Stamping the ground so it hears."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着它，一步不退。", "en": "Watching it. Not one step back."},
        {"zh": "它再靠近，我就冲。", "en": "One more step and I charge."},
        {"zh": "我喘气变粗了，听见没。", "en": "Hear my breathing get heavy?"},
        {"zh": "角尖对着它，别乱动。", "en": "Horns pointed at it. Nobody move."},
        {"zh": "牛群都退到我后面。", "en": "The herd's moved behind me."},
        {"zh": "我前蹄刨土，是倒计时。", "en": "Pawing the dirt is my countdown."},
        {"zh": "它想绕到侧面，我转身。", "en": "It wants my flank. I turn with it."},
        {"zh": "我眼睛不眨。", "en": "I'm not even blinking."},
        {"zh": "这一下我不会留力。", "en": "I won't hold back this time."},
        {"zh": "它要是扑，我就顶。", "en": "If it lunges, I gore."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "顶它一下，用角。", "en": "Horns first. One shove."},
        {"zh": "我冲过去，地面都在震。", "en": "Charging. The ground shakes."},
        {"zh": "这一头顶得它退了三步。", "en": "That headbutt sent it back three steps."},
        {"zh": "蹄子也踩，别怪我。", "en": "Hooves too. Don't blame me."},
        {"zh": "哞！离小牛远点。", "en": "Moo! Stay off my calf."},
        {"zh": "我转身用屁股撞。", "en": "Turning to hit with my rear."},
        {"zh": "打完了，我喘得厉害。", "en": "Done. Now I'm panting hard."},
        {"zh": "它要是再来，我还顶。", "en": "If it comes back, I gore again."},
        {"zh": "我的角有点钝了。", "en": "My horns are getting blunt."},
        {"zh": "牛群安全了，我退回去。", "en": "Herd's safe. I'm backing off."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这片草地上出现。", "en": "I appear on this patch of grass."},
        {"zh": "哞，第一天，先找水。", "en": "Moo. First day. Find water."},
        {"zh": "这里草够高，能藏住我的腿。", "en": "Grass tall enough to hide my legs."},
        {"zh": "附近有牛群，我去凑个热闹。", "en": "A herd nearby. I'll join them."},
        {"zh": "光亮够了，我才生出来。", "en": "Took enough light for me to be born."},
        {"zh": "我甩甩头，还不太清醒。", "en": "Shaking my head. Still groggy."},
        {"zh": "这地方气味陌生。", "en": "The smell here is unfamiliar."},
        {"zh": "我先站定，看看四周。", "en": "Standing still, taking a look around."},
        {"zh": "有栅栏，说明有人住。", "en": "A fence. Someone lives here."},
        {"zh": "草的味道不错，留下。", "en": "Grass tastes fine. I'll stay."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛烧起来了，我闻得到。", "en": "My hide's burning. I can smell it."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从坡上滚下来，摔得不轻。", "en": "Rolled down the slope. Hard landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水淹过鼻子，我抬头。", "en": "Water over my nose. Head up."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "一声巨响，我被掀翻了。", "en": "A blast knocked me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我背里。", "en": "Something stuck in my back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头里发凉，说不上来的疼。", "en": "Cold in my bones. A strange ache."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "草都吃光了，肚子空。", "en": "Grass is gone. My belly's empty."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我旁边，腿都麻了。", "en": "Lightning beside me. My legs went numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，一直往下。", "en": "Nothing under my hooves. Falling."}
      ]
    }
  }
}
