{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢摆尾前行。", "en": "I sweep my tail and glide on."},
        {"zh": "额头上那块隆起很沉。", "en": "The hump on my forehead is heavy."},
        {"zh": "暖海的水从我鳃边过。", "en": "Warm sea water passes my gills."},
        {"zh": "我绕过珊瑚的枝。", "en": "I round the coral branches."},
        {"zh": "这身蓝在光里很深。", "en": "This blue goes deep in the light."},
        {"zh": "我贴着珊瑚礁游。", "en": "I cruise along the reef."},
        {"zh": "大鱼不赶时间。", "en": "Big fish don't hurry."},
        {"zh": "我掉头要绕一大圈。", "en": "Turning takes me a wide arc."},
        {"zh": "死珊瑚的碎屑飘下来。", "en": "Dead coral crumbles drift down."},
        {"zh": "雌鱼比我小得多。", "en": "The females are much smaller."},
        {"zh": "我在礁石间慢慢穿。", "en": "I thread slowly between the rocks."},
        {"zh": "水面上的光晃来晃去。", "en": "The light on the surface wavers."},
        {"zh": "我向前推了半格。", "en": "I push forward half a block."},
        {"zh": "周围的鱼给我让路。", "en": "The smaller fish make way."},
        {"zh": "这片暖海我很熟。", "en": "I know this warm sea well."},
        {"zh": "我朝礁边游过去。", "en": "I swim toward the reef's edge."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在暖流里不动。", "en": "I hang in the water."},
        {"zh": "珊瑚的影子落在身上。", "en": "Coral shadows fall on me."},
        {"zh": "我慢慢摆了一下鳍。", "en": "I give a slow fin beat."},
        {"zh": "这里的水很暖。", "en": "The water here is warm."},
        {"zh": "有小鱼在我旁边绕。", "en": "Little fish circle beside me."},
        {"zh": "我盯着一株死珊瑚。", "en": "I stare at a dead coral."},
        {"zh": "水流推得我轻轻晃。", "en": "The current rocks me gently."},
        {"zh": "我啃死珊瑚，慢慢长。", "en": "I nibble dead coral and grow slowly."},
        {"zh": "额头的隆起蹭到礁石。", "en": "My forehead hump scrapes the reef."},
        {"zh": "远处的水变暗了。", "en": "The water darkens in the distance."},
        {"zh": "我就贴着珊瑚待着。", "en": "I'll just stay like this."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我上面游。", "en": "You're swimming above me."},
        {"zh": "你比礁石还显眼。", "en": "You stand out more than the reef."},
        {"zh": "我这条鱼很大。", "en": "I'm a big fish."},
        {"zh": "你挡着我的珊瑚了。", "en": "You're blocking my coral."},
        {"zh": "你在水里待不久。", "en": "You can't stay in the water long."},
        {"zh": "我慢慢转过来看你。", "en": "I turn slowly to look at you."},
        {"zh": "我一点也不怕你。", "en": "I'm not afraid of you."},
        {"zh": "暖海里少见你这样的。", "en": "You're rare in warm seas."},
        {"zh": "别碰我的额头。", "en": "Don't touch my forehead."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我猛地摆尾退开。", "en": "I beat my tail and pull away."},
        {"zh": "我的大嘴唇撞在礁石上，疼。", "en": "My big lips slammed into the reef, and it hurts."},
        {"zh": "我这么大的鱼也会疼。", "en": "Even a fish this big feels pain."},
        {"zh": "水里全是我的血。", "en": "My blood clouds the water."},
        {"zh": "我侧过身护住鳃。", "en": "I turn to shield my gills."},
        {"zh": "我贴着礁石沉下去。", "en": "I sink slowly."},
        {"zh": "这不像是意外。", "en": "That didn't feel accidental."},
        {"zh": "我还能游得动。", "en": "I can still swim."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是死珊瑚吗？", "en": "Is that dead coral?"},
        {"zh": "我闻到海藻味。", "en": "I smell algae."},
        {"zh": "你手里那块不大。", "en": "That piece in your hand is small."},
        {"zh": "我慢慢游过去。", "en": "I'll swim over slowly."},
        {"zh": "别动，我自己来。", "en": "Don't move; I'll come myself."},
        {"zh": "放下就可以了。", "en": "Just put it down."},
        {"zh": "我一次吃不了多少。", "en": "I can't eat much at once."},
        {"zh": "水里的东西更好。", "en": "Things in the water are better."},
        {"zh": "让我凑近些看看。", "en": "Let me get close and look."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我侧腹上。", "en": "You bumped my flank."},
        {"zh": "我的身体很结实。", "en": "My body is solid."},
        {"zh": "这一撞把我推离礁线。", "en": "That pushed me off course."},
        {"zh": "我摆尾稳住自己。", "en": "I steady myself with a tail beat."},
        {"zh": "水里撞一下不算什么。", "en": "A bump underwater is nothing."},
        {"zh": "你的腿碰到我的鳍。", "en": "Your leg touched my fin."},
        {"zh": "礁石比你还硬。", "en": "The reef is harder than you."},
        {"zh": "我慢慢让开了。", "en": "I slowly give way."},
        {"zh": "别再碰我的头。", "en": "Don't touch my head again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "暖海里的季节到了。", "en": "The season has come in the warm sea."},
        {"zh": "雄鱼的颜色更深。", "en": "The males run darker."},
        {"zh": "我额头上的隆起很有用。", "en": "This hump on my forehead is useful."},
        {"zh": "我绕着你游一圈。", "en": "I circle you once."},
        {"zh": "水里的光正好。", "en": "The light in the water is right."},
        {"zh": "别挡着那些珊瑚。", "en": "Don't block the coral."},
        {"zh": "我摆着尾慢慢挨近。", "en": "I drift closer."},
        {"zh": "这片珊瑚礁够大。", "en": "This reef is big enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块珊瑚碎屑我吞了。", "en": "I swallow this coral fragment."},
        {"zh": "有点硬，我含着。", "en": "Hard; I'll hold it in my mouth."},
        {"zh": "死珊瑚碎屑不能吃。", "en": "This isn't food."},
        {"zh": "我推到礁缝里。", "en": "I push it into a reef gap."},
        {"zh": "我绕过去看一眼。", "en": "I swim around to look."},
        {"zh": "水里的东西总在动。", "en": "Things in water always drift."},
        {"zh": "我把它顶起来。", "en": "I nudge it up."},
        {"zh": "就留在这儿吧。", "en": "Leave it here."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有点不对。", "en": "Something's off in the water."},
        {"zh": "我朝那边转头。", "en": "I turn that way."},
        {"zh": "这身块头不好躲。", "en": "This size doesn't hide well."},
        {"zh": "我先看着它再说。", "en": "I'll watch it first."},
        {"zh": "我在等它靠近。", "en": "I'm waiting for it to come near."},
        {"zh": "它比死珊瑚有意思。", "en": "More interesting than dead coral."},
        {"zh": "我压低了一点。", "en": "I sink a little."},
        {"zh": "这条鱼想试探我。", "en": "That fish wants to test me."},
        {"zh": "我摆尾准备着。", "en": "I ready a tail beat."},
        {"zh": "它已经过来了。", "en": "Here it comes."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着它绕圈子。", "en": "I follow it around."},
        {"zh": "我比它大得多。", "en": "I'm bigger than it."},
        {"zh": "它躲进珊瑚了。", "en": "It hid in the coral."},
        {"zh": "我撞开这些枝。", "en": "I shoulder through the branches."},
        {"zh": "水里没有死角。", "en": "There are no blind corners underwater."},
        {"zh": "我一点一点逼近。", "en": "I close in slowly."},
        {"zh": "它就在我下面。", "en": "It's beneath me."},
        {"zh": "我换了个方向。", "en": "I change direction."},
        {"zh": "这圈绕得很稳。", "en": "This circle is steady."},
        {"zh": "趁暖流还没转。", "en": "Now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "这一下很有分量。", "en": "That landed with weight."},
        {"zh": "我一甩尾扫开它。", "en": "I sweep my tail across."},
        {"zh": "水被搅成一片。", "en": "The water churns."},
        {"zh": "你被我推开了。", "en": "You were shoved aside."},
        {"zh": "我这身块头就是武器。", "en": "My bulk is the weapon."},
        {"zh": "再撞它一下子。", "en": "One more charge."},
        {"zh": "我不擅长追东西。", "en": "I'm not built for chasing."},
        {"zh": "这一下已经够了。", "en": "That's enough."},
        {"zh": "你快点退开吧。", "en": "Back away."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从暖流里游出来。", "en": "I swim out of the warm current."},
        {"zh": "礁石就在下面。", "en": "The reef lies below."},
        {"zh": "这里的水很清。", "en": "The water is clear here."},
        {"zh": "我的额头撞到珊瑚了。", "en": "My forehead hit the coral."},
        {"zh": "周围都是小鱼。", "en": "Small fish all around."},
        {"zh": "这是暖海的味道。", "en": "The smell of a warm sea."},
        {"zh": "这地方适合待着。", "en": "Good place to linger."},
        {"zh": "我摆了摆鱼鳍。", "en": "I fan my fins."},
        {"zh": "先去找点吃的。", "en": "Time to find food."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水都被烧热了，我的皮发紧。", "en": "The water burned hot; my skin tightens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我被抬出水面又摔回去。", "en": "I was lifted out and dropped back."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水忽然没气了，我张口没用。", "en": "The water has no air; gaping doesn't help."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我推着撞上礁石。", "en": "The blast drove me into the reef."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量在水里追着我。", "en": "That force chases me through the water."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得摆不动尾。", "en": "Too hungry to sweep my tail."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打进海里，我浑身一僵。", "en": "Lightning entered the sea; I went rigid."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "水里忽然没有底了。", "en": "The water suddenly has no bottom."}
      ]
    }
  }
}
