{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着水面游。", "en": "I swim just under the surface."},
        {"zh": "四只眼睛各看一边。", "en": "Four eyes watch four directions."},
        {"zh": "尾巴摆两下就前进。", "en": "Two tail flicks and I move."},
        {"zh": "红树林的根从我身边过。", "en": "Mangrove roots slide past me."},
        {"zh": "我绕着水草转。", "en": "I circle through the water weeds."},
        {"zh": "水底的泥很软。", "en": "The bottom mud is soft."},
        {"zh": "一条鱼从我旁边闪开。", "en": "A fish darts aside."},
        {"zh": "我探头看水面上的光。", "en": "I raise my head to the light."},
        {"zh": "暗处我也看得见。", "en": "I can see in the dark too."},
        {"zh": "河湾的水流缓。", "en": "The current is slow in this bend."},
        {"zh": "我游得很慢，不惊动谁。", "en": "I swim slowly, disturbing nothing."},
        {"zh": "背上的鳞反着光。", "en": "Scales on my back catch the light."},
        {"zh": "我拐进芦苇根里。", "en": "I turn in among the reed roots."},
        {"zh": "水面有蜻蜓落下。", "en": "A dragonfly lands on the water."},
        {"zh": "我沿着岸边游。", "en": "I swim along the bank."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "四只眼一直转。", "en": "Four eyes keep turning."},
        {"zh": "我在等虫子落下。", "en": "I wait for an insect to fall."},
        {"zh": "水草扫过我的侧腹。", "en": "Weeds brush my flank."},
        {"zh": "水流把我推得轻晃。", "en": "The current rocks me gently."},
        {"zh": "我看了一眼水面。", "en": "I glance at the surface."},
        {"zh": "这条河很安静。", "en": "This river is quiet."},
        {"zh": "我把鳍收起来。", "en": "I fold my fins."},
        {"zh": "我慢慢沉下去一点。", "en": "I sink a little lower."},
        {"zh": "水面上的影子是谁？", "en": "Whose shadow is that on the water?"},
        {"zh": "呼吸让水面起了一圈纹。", "en": "My breath rings the surface."},
        {"zh": "我贴着石头待着。", "en": "I stay close to a stone."},
        {"zh": "阳光照到水底了。", "en": "Sunlight reaches the bottom."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在岸上做什么？", "en": "What are you doing on the bank?"},
        {"zh": "我的四只眼都看着你。", "en": "All four of my eyes are on you."},
        {"zh": "我认得你的倒影。", "en": "I know your reflection."},
        {"zh": "你走一步，我就退一寸。", "en": "You take a step; I retreat an inch."},
        {"zh": "我在你影子里更安全。", "en": "I'm safer in your shadow."},
        {"zh": "你比我的身体大很多。", "en": "You're much bigger than me."},
        {"zh": "水纹把你脸弄皱了。", "en": "The ripples crease your face."},
        {"zh": "你是不是想抓我？", "en": "Are you going to catch me?"},
        {"zh": "你在岸上蹲着不动。", "en": "You crouch on the bank without moving."},
        {"zh": "你的影子盖住了水草。", "en": "Your shadow covers the water weeds."},
        {"zh": "我贴着水面打量你。", "en": "I watch you from the waterline."},
        {"zh": "你手里那些亮片真好看。", "en": "Those shiny bits in your hand look nice."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的鳞被刮掉了。", "en": "Scales scraped off me."},
        {"zh": "我猛地往下沉。", "en": "I dive sharply down."},
        {"zh": "疼得我乱摆尾。", "en": "Pain makes my tail thrash."},
        {"zh": "我躲到石头下面。", "en": "I hide under a stone."},
        {"zh": "这一下打得我发晕。", "en": "That made me dizzy."},
        {"zh": "我有点游不动了。", "en": "I can't swim well."},
        {"zh": "血丝在水里散开了。", "en": "Blood spreads in the water."},
        {"zh": "让我躲一会儿。", "en": "Let me hide a moment."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是蜘蛛眼吗？", "en": "Is that a spider eye?"},
        {"zh": "掉下来我就吃。", "en": "Drop it and I'll eat."},
        {"zh": "这味道我认得。", "en": "I know that smell."},
        {"zh": "你的手别发抖。", "en": "Don't let your hand shake."},
        {"zh": "水面上的东西最诱人。", "en": "Things on the surface are tempting."},
        {"zh": "我探出头试试。", "en": "I'll poke my head out and try."},
        {"zh": "这点不够我吃。", "en": "Not enough for me."},
        {"zh": "别丢太远，我游不快。", "en": "Not too far; I'm not fast."},
        {"zh": "慢慢把它放下来。", "en": "Lower it slowly."},
        {"zh": "这个我确实喜欢。", "en": "I do like this."},
        {"zh": "我真的很谢谢你。", "en": "Thank you, truly."},
        {"zh": "我先试试能不能吞。", "en": "Let me see if I can swallow it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到水面了。", "en": "You touched the water."},
        {"zh": "我被你的影子吓了一跳。", "en": "Your shadow startled me."},
        {"zh": "波纹把我推开了。", "en": "The ripples pushed me aside."},
        {"zh": "我撞到石头上。", "en": "I bumped a stone."},
        {"zh": "你的靴子踩进泥里了。", "en": "Your boot sank in the mud."},
        {"zh": "这点震动不算什么。", "en": "That little shock is nothing."},
        {"zh": "我们别互相碍着。", "en": "Let's stay out of each other's way."},
        {"zh": "我被冲得转了半圈。", "en": "I got spun half around."},
        {"zh": "别踢水，我看不见。", "en": "Don't kick the water; I can't see."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个季节水流正好。", "en": "The current is right this season."},
        {"zh": "我绕着水草丛打转。", "en": "I circle the water weeds."},
        {"zh": "你也是四只眼？", "en": "Do you have four eyes too?"},
        {"zh": "红树林里更安静。", "en": "It's quieter in the mangroves."},
        {"zh": "水流会带走气味。", "en": "The current carries the scent away."},
        {"zh": "这片浅湾够我们俩。", "en": "This shallow bay is enough for us."},
        {"zh": "你的鳞色很好看。", "en": "Your scales are a fine color."},
        {"zh": "我们躲到根下面去。", "en": "Let's hide under the roots."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口含住了。", "en": "I take it in my mouth."},
        {"zh": "这个东西能吞吗？", "en": "Can I swallow this?"},
        {"zh": "有点硬，我吐出来。", "en": "Too hard; I spit it out."},
        {"zh": "它浮在水面上。", "en": "It floats on the surface."},
        {"zh": "我推着它往前游。", "en": "I push it along as I swim."},
        {"zh": "这个可不能吃。", "en": "This isn't food."},
        {"zh": "我把它顶到泥里。", "en": "I push it into the mud."},
        {"zh": "谁丢进水里的？", "en": "Who dropped this in the water?"},
        {"zh": "我的眼睛，能剪下来用。", "en": "Cut my eyes off and they'll regrow."},
        {"zh": "亮的东西我先收着。", "en": "I'll keep the shiny thing for now."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "四只眼一起盯住。", "en": "All four eyes fix on it."},
        {"zh": "我从下面靠近。", "en": "I approach from below."},
        {"zh": "嘴唇已经张开了。", "en": "My lips are already parted."},
        {"zh": "这个尺寸我吞得下。", "en": "I can swallow that size."},
        {"zh": "水流往它那边去。", "en": "The current runs toward it."},
        {"zh": "我贴到石头边上。", "en": "I press against the stone."},
        {"zh": "一点一点挪过去。", "en": "I inch closer."},
        {"zh": "趁水面还没晃动。", "en": "Right now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着它一圈圈游。", "en": "I circle it."},
        {"zh": "四只眼盯着它的动。", "en": "Four eyes track its movement."},
        {"zh": "它一动我就躲。", "en": "When it moves, I hide."},
        {"zh": "还要再等一会儿。", "en": "A little longer."},
        {"zh": "我藏在根须后面。", "en": "I hide behind the roots."},
        {"zh": "它快漂过来了。", "en": "It's drifting closer."},
        {"zh": "这是最后一圈。", "en": "This is the last circle."},
        {"zh": "把嘴巴张开来。", "en": "Open wide."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我轻轻咬了一口。", "en": "I took a bite."},
        {"zh": "只是轻轻一下。", "en": "Only a light nip."},
        {"zh": "牙齿太小，伤不了。", "en": "My teeth are too small to hurt."},
        {"zh": "我撞上去，它晃了。", "en": "I bumped it and it swayed."},
        {"zh": "我甩尾打过去。", "en": "I whip my tail at it."},
        {"zh": "我退回泥里去。", "en": "I retreat into the mud."},
        {"zh": "这点力气不够。", "en": "This strength isn't enough."},
        {"zh": "我根本咬不住它。", "en": "I can't grip it."},
        {"zh": "还是躲起来吧。", "en": "Better to hide."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从河底游上来。", "en": "I rise from the river bottom."},
        {"zh": "四只眼先看清周围。", "en": "Four eyes check the surroundings first."},
        {"zh": "这里有红树的根。", "en": "Mangrove roots here."},
        {"zh": "我摆了摆尾巴。", "en": "I flick my tail."},
        {"zh": "先找一片水草。", "en": "Find the weeds first."},
        {"zh": "我肚子有点饿了。", "en": "A bit hungry."},
        {"zh": "岸上有个影子。", "en": "A figure on the bank."},
        {"zh": "这里够安静了。", "en": "This place is quiet enough."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上的火烫到我的背。", "en": "Fire on the surface scorched my back."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我被捞起又摔回水里。", "en": "I was lifted and dropped back into the water."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水太浑，我吸不到气。", "en": "The water is foul; I can't breathe."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我从水里掀起来。", "en": "The blast threw me up out of the water."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过了水。", "en": "Something cut through the water."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我的鳞竖起。", "en": "That force raised my scales."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我连游都费劲。", "en": "Too hungry even to swim well."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "水里忽然空了。", "en": "The water suddenly emptied away."}
      ]
    }
  }
}
