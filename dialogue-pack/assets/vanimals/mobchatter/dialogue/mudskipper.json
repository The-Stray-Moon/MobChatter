{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用胸鳍撑起身子。", "en": "I prop myself up on my pectoral fins."},
        {"zh": "泥地上我一跳一跳。", "en": "I hop along the mud."},
        {"zh": "红树林的根是我的路。", "en": "Mangrove roots are my roads."},
        {"zh": "我爬上这块石头。", "en": "I climb onto this stone."},
        {"zh": "尾巴一弹，就跳半格。", "en": "One tail snap hops me half a block."},
        {"zh": "我在泥里留下小坑。", "en": "I leave small pits in the mud."},
        {"zh": "水位在退，我跟着走。", "en": "The water's dropping; I follow it."},
        {"zh": "我贴着地面拖动。", "en": "I drag along the ground."},
        {"zh": "跳到树根上歇一下。", "en": "Hop to a root for a rest."},
        {"zh": "这里太干，我得挪。", "en": "Too dry here; I must move."},
        {"zh": "我侧着身子爬。", "en": "I crawl with my body tilted."},
        {"zh": "红树的泥糊了我一身。", "en": "Mud coats me all over."},
        {"zh": "我从一个水洼跳到另一个。", "en": "I hop from puddle to puddle."},
        {"zh": "湿泥上我走得更快。", "en": "I move faster on wet mud."},
        {"zh": "我先看看前面的路。", "en": "Let me check the way ahead."},
        {"zh": "这点高度难不住我。", "en": "That height won't stop me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴在泥上晒太阳。", "en": "I lie on the mud in the sun."},
        {"zh": "胸鳍撑着地面。", "en": "My fins hold me up."},
        {"zh": "眼睛一左一右地转。", "en": "My eyes swivel left and right."},
        {"zh": "泥面上有气泡。", "en": "Bubbles rise from the mud."},
        {"zh": "我在数水洼里的气泡。", "en": "I'm listening to the water."},
        {"zh": "红树的根挡住了风。", "en": "The mangrove roots block the wind."},
        {"zh": "我鼓了鼓腮帮子。", "en": "I puff my cheeks."},
        {"zh": "水洼里有点动静。", "en": "Something moves in the puddle."},
        {"zh": "我一个劲儿眨眼。", "en": "I keep blinking."},
        {"zh": "这里倒是很凉快。", "en": "It's cool here."},
        {"zh": "我把身子往泥里压。", "en": "I press down into the mud."},
        {"zh": "还没到要挪的时候。", "en": "Not time to move yet."},
        {"zh": "远处有一只鸟。", "en": "There's a bird far off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你要踩到我了。", "en": "You're about to step on me."},
        {"zh": "我这么小，你也能看中？", "en": "I'm this small, and you still noticed?"},
        {"zh": "你手里有蜘蛛眼吗？", "en": "Do you have a spider eye?"},
        {"zh": "我不太会躲藏。", "en": "I'm not good at hiding."},
        {"zh": "别把我踢进水里。", "en": "Don't kick me into the water."},
        {"zh": "你是来驯我的吗？", "en": "Have you come to tame me?"},
        {"zh": "我背上背着东西呢。", "en": "I'm carrying things on my back."},
        {"zh": "你走近一点我也不跑。", "en": "Come closer; I won't run."},
        {"zh": "这片泥地归我。", "en": "This mudflat is mine."},
        {"zh": "我认得你踩泥的声响。", "en": "I know the sound of your steps."},
        {"zh": "你会不会跳舞？", "en": "Can you dance?"},
        {"zh": "那边有唱片机的声音。", "en": "I hear a jukebox over there."},
        {"zh": "你蹲下来更好说话。", "en": "Crouch down; easier to talk."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "疼得我在地上直蹦。", "en": "Pain makes me hop about."},
        {"zh": "我翻了个身过去。", "en": "I rolled onto my side."},
        {"zh": "我的鳍撑不住了。", "en": "My fins can't hold me."},
        {"zh": "我钻进泥里去。", "en": "I burrow into the mud."},
        {"zh": "这点伤对小身体很重。", "en": "That's a lot for a small body."},
        {"zh": "我身子一抖一抖的。", "en": "My body keeps twitching."},
        {"zh": "血沾在泥地上。", "en": "Blood stains the mud."},
        {"zh": "我只是只小鱼。", "en": "I'm only a little fish."},
        {"zh": "让我先缓口气。", "en": "Let me catch my breath."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有蜘蛛眼吗？", "en": "Any spider eyes?"},
        {"zh": "那个味道我认得。", "en": "I know that smell."},
        {"zh": "我跳过去看看。", "en": "I'll hop over and check."},
        {"zh": "这是什么？能吃吗？", "en": "What's this? Can I eat it?"},
        {"zh": "放下，我慢慢过来。", "en": "Set it down; I'll come slowly."},
        {"zh": "我嘴里还空着。", "en": "My mouth is still empty."},
        {"zh": "这点我能吞下。", "en": "I can swallow that."},
        {"zh": "别抢，我自己拿。", "en": "Don't grab; I'll get it myself."},
        {"zh": "我一跳就到你脚边。", "en": "One hop and I'm at your feet."},
        {"zh": "这味道让我坐不住。", "en": "That smell won't let me sit still."},
        {"zh": "我闻到蜘蛛眼了。", "en": "I smell a spider eye."},
        {"zh": "再给一点行不行？", "en": "Could I have a bit more?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你差点踩到我，泥太厚了。", "en": "You nearly stepped on me, the mud is thick."},
        {"zh": "我被你碰得翻了个身。", "en": "You knocked me onto my side."},
        {"zh": "我太小了，看不见我。", "en": "I'm too small to notice."},
        {"zh": "这一下把我推了两格。", "en": "That pushed me two blocks."},
        {"zh": "我抓不住这片泥。", "en": "I can't grip the mud."},
        {"zh": "你的鞋比我还大。", "en": "Your boot is bigger than me."},
        {"zh": "我从你脚边跳开。", "en": "I hop away from your feet."},
        {"zh": "别在泥里跺脚。", "en": "Don't stomp in the mud."},
        {"zh": "我没什么好撞的。", "en": "There's not much of me to hit."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "红树林里很安静。", "en": "It's quiet in the mangroves."},
        {"zh": "我跳到你旁边。", "en": "I hop over beside you."},
        {"zh": "你也会这样跳吗？", "en": "Can you hop too?"},
        {"zh": "这片泥地够我们俩。", "en": "This flat is enough for both of us."},
        {"zh": "我们找个水洼。", "en": "Let's find a puddle."},
        {"zh": "我唱不了歌，只会跳。", "en": "I can't sing; I only hop."},
        {"zh": "水退了正好合适。", "en": "Low tide is perfect."},
        {"zh": "你别把我踩扁了。", "en": "Don't squash me."},
        {"zh": "我尾鳍碰了碰你。", "en": "My tail fin brushed you."},
        {"zh": "慢慢来，我腿短。", "en": "Slow down; my legs are short."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它塞进颊囊。", "en": "I stuff it into my cheek pouch."},
        {"zh": "我的背能装东西。", "en": "My back can carry things."},
        {"zh": "我背上放得下。", "en": "This fits."},
        {"zh": "有点重，我拖着。", "en": "A bit heavy; I'll drag it."},
        {"zh": "这是什么东西？", "en": "What is it?"},
        {"zh": "我藏在泥下面。", "en": "I hide it under the mud."},
        {"zh": "这不是吃的吧。", "en": "This isn't food, is it?"},
        {"zh": "我背着它往前跳。", "en": "I hop with it on my back."},
        {"zh": "我把它搁回那根树根。", "en": "I put it back."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边泥里有什么在动。", "en": "Something's moving."},
        {"zh": "我爬近些瞧瞧。", "en": "I crawl a bit nearer to see."},
        {"zh": "泥里我跑不快。", "en": "I'm not fast on mud."},
        {"zh": "那不是能吃的东西。", "en": "That's not food."},
        {"zh": "我先躲一下再说。", "en": "Let me hide first."},
        {"zh": "我身子贴住地面。", "en": "I flatten against the ground."},
        {"zh": "你别靠过来啊。", "en": "Don't come closer."},
        {"zh": "我有四格里装的东西。", "en": "I have four slots of cargo."},
        {"zh": "趁水洼还没干，就现在。", "en": "Right now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跳一跳地跟。", "en": "I follow in little hops."},
        {"zh": "它比我快太多。", "en": "It's far faster than me."},
        {"zh": "我只能抄近路。", "en": "I can only take shortcuts."},
        {"zh": "泥地会拖慢它。", "en": "The mud will slow it down."},
        {"zh": "我从根须间穿过去。", "en": "I slip between the roots."},
        {"zh": "再跳两下就到。", "en": "Two more hops and I'm there."},
        {"zh": "我尾鳍绷得发紧。", "en": "My tail is taut."},
        {"zh": "这一跳要跳得准。", "en": "This hop has to be true."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞了它一下。", "en": "I bumped into it."},
        {"zh": "我用头去撞它。", "en": "I butt with my head."},
        {"zh": "它几乎没感觉。", "en": "It barely noticed."},
        {"zh": "我咬不住它的皮。", "en": "I can't bite down."},
        {"zh": "我被它弹开了。", "en": "I bounced off."},
        {"zh": "这点力量不够看。", "en": "That strength is nothing."},
        {"zh": "我跳上去又落下。", "en": "I leap up and fall back."},
        {"zh": "我尾巴甩了一下。", "en": "I flicked my tail."},
        {"zh": "还是赶紧跑吧。", "en": "Better to run."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水洼里探出头。", "en": "I poke my head out of the puddle."},
        {"zh": "红树根正好藏身。", "en": "Mangrove roots make good cover."},
        {"zh": "这里的泥很软。", "en": "The mud is soft."},
        {"zh": "我先晒晒太阳。", "en": "Let me bask a little."},
        {"zh": "这里有蜘蛛眼吗？", "en": "Any spider eyes here?"},
        {"zh": "我甩掉鳍上的水珠。", "en": "I shake off the water."},
        {"zh": "远处有唱片机的声音。", "en": "I hear a jukebox far off."},
        {"zh": "我吐出一个小泡。", "en": "I blow a small bubble."},
        {"zh": "这地方还不错。", "en": "This place is fine."},
        {"zh": "先找块石头跳上去。", "en": "Let me hop onto a stone."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我跳起来。", "en": "The heat makes me jump."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石头上摔进泥里。", "en": "I fell off the stone into the mud."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水太深，我浮不上去。", "en": "Too deep; I can't reach the surface."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀出老远。", "en": "The blast threw me far."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得跳不动了。", "en": "Too hungry to hop."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在泥上，我弹起来。", "en": "Lightning hit the mud and I leapt."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "泥下面什么都没有。", "en": "There's nothing under the mud."}
      ]
    }
  }
}
