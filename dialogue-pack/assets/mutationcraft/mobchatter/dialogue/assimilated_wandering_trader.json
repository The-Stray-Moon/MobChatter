{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "两头驮兽只剩下骨架", "en": "My two pack beasts are down to bone."},
        {"zh": "绳子还攥在我手里", "en": "The lead ropes are still in my hand."},
        {"zh": "我沿着沙漠边的路走", "en": "I walk the road along the desert edge."},
        {"zh": "身后的骨架跟着我", "en": "The skeletons follow behind me."},
        {"zh": "它们的步子比我还僵", "en": "Their gait is stiffer than mine."},
        {"zh": "我不回头看它们", "en": "I don't look back at them."},
        {"zh": "看了会想以前的事", "en": "Looking makes me think of before."},
        {"zh": "那两匹本来是很活的", "en": "They used to be so lively."},
        {"zh": "现在只剩走过时的一点响", "en": "Now only a rattle as they pass."},
        {"zh": "我把绳子换了只手", "en": "I shift the ropes to my other hand."},
        {"zh": "我牵着绳子往前走", "en": "I walk on with the ropes."},
        {"zh": "前面应该有村子", "en": "There should be a village ahead."},
        {"zh": "我记得这条路", "en": "I remember this road."},
        {"zh": "上次走的时候，两匹都在", "en": "Last time both of them were alive."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在路边，绳子垂着", "en": "I stand at the roadside, ropes slack."},
        {"zh": "风把绳子吹得晃", "en": "Wind sways the ropes."},
        {"zh": "有个箱子还挂在骨架上", "en": "A crate still hangs on the frame."},
        {"zh": "里面曾经装着货物", "en": "It used to hold goods."},
        {"zh": "我现在不知道里面是什么", "en": "Now I don't know what's inside."},
        {"zh": "我伸手摸了摸", "en": "I reach out and touch it."},
        {"zh": "木头已经软了", "en": "The wood has gone soft."},
        {"zh": "箱子里的货早就烂了", "en": "The goods in the crate rotted long ago."},
        {"zh": "骨架站得很稳", "en": "The skeletons stand very still."},
        {"zh": "它们以前也这么站", "en": "They used to stand like this too."},
        {"zh": "我从口袋里摸出半块饼", "en": "I take half a loaf from my pocket."},
        {"zh": "可是我不记得怎么吃了", "en": "But I've forgotten how to eat it."},
        {"zh": "我把它收好了", "en": "I put it away."},
        {"zh": "那就一直留着", "en": "I'll keep it, then."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我摸到腰间的空箱子", "en": "My hand finds the empty crate at my belt."},
        {"zh": "你竟然是个活人", "en": "You're actually alive."},
        {"zh": "这可真是太少见了", "en": "That's truly rare."},
        {"zh": "我把绳子往身边收了收", "en": "I gather the ropes closer."},
        {"zh": "并不是为了防你", "en": "Not to guard against you."},
        {"zh": "是怕它们走散", "en": "So they don't wander off."},
        {"zh": "你要买什么吗", "en": "Is there something you want to buy?"},
        {"zh": "我这样问，已经很多次了", "en": "I've asked that many times."},
        {"zh": "笼子早就空了", "en": "The cages have long been empty."},
        {"zh": "可这是我会说的话", "en": "But it's what I know to say."},
        {"zh": "我自己也听得见", "en": "I can hear it too."},
        {"zh": "听起来很难听", "en": "It sounds awful."},
        {"zh": "你现在站着的地方", "en": "Where you're standing now."},
        {"zh": "以前我摆过摊", "en": "I used to set up a stall there."},
        {"zh": "卖过一种很甜的果子", "en": "I sold a very sweet fruit once."},
        {"zh": "想不起名字了", "en": "I can't recall the name."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫了一声，绳子松了", "en": "I cry out and the ropes go slack."},
        {"zh": "骨架往前扑了一下", "en": "The skeletons lurch forward."},
        {"zh": "我赶紧拉回来", "en": "I yank them back."},
        {"zh": "手心的皮磨破了", "en": "The skin of my palm splits."},
        {"zh": "我看了看，没有血", "en": "I look. There's no blood."},
        {"zh": "也就不算什么了", "en": "So it doesn't matter."},
        {"zh": "我慢慢站稳了", "en": "I steady myself."},
        {"zh": "箱子还在身后", "en": "The crate's still behind me."},
        {"zh": "我把它扶正了", "en": "I set it straight."},
        {"zh": "我还能走下去", "en": "I can still walk."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你要给我东西？", "en": "You're giving me something?"},
        {"zh": "我把手递了出去", "en": "I hold my hand out."},
        {"zh": "手指弯不起来", "en": "My fingers won't curl."},
        {"zh": "东西掉在地上", "en": "It falls to the ground."},
        {"zh": "我弯腰去捡它", "en": "I bend to pick it up."},
        {"zh": "骨架撞了我一下", "en": "A skeleton bumps me."},
        {"zh": "然后又直起来", "en": "I straighten again."},
        {"zh": "一开始就想要", "en": "I wanted it."},
        {"zh": "现在也还是想要", "en": "I still want it."},
        {"zh": "只是不知道怎么拿", "en": "I just don't know how to hold it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我退开了一步", "en": "I step back."},
        {"zh": "绳子一下绷紧了", "en": "The ropes pull taut."},
        {"zh": "骨架被拉得歪了一下", "en": "The skeletons list sideways."},
        {"zh": "我伸手扶住一个", "en": "I reach and steady one."},
        {"zh": "骨头硌得手疼", "en": "The bone cuts my palm."},
        {"zh": "我并没有松开", "en": "I don't let go."},
        {"zh": "它们以前会让我骑", "en": "They used to let me ride."},
        {"zh": "现在已经不行了", "en": "Not anymore."},
        {"zh": "我把绳子重新整理", "en": "I arrange the ropes again."},
        {"zh": "那就继续走吧", "en": "Then we walk on."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我现在没有家了", "en": "I have no home now."},
        {"zh": "以前其实也没有", "en": "Never had one before either."},
        {"zh": "只有这两匹和我", "en": "Only these two and me."},
        {"zh": "我们走了很多年", "en": "We walked for many years."},
        {"zh": "走到哪里就卖到哪里", "en": "We sold wherever we stopped."},
        {"zh": "有一次被抢了", "en": "Once we were robbed."},
        {"zh": "丢了一半的货", "en": "Lost half the goods."},
        {"zh": "骨架就是那时候留下的", "en": "The skeletons date from then."},
        {"zh": "我实在舍不得扔", "en": "I couldn't bear to leave them."},
        {"zh": "所以就一直带着", "en": "So I've carried them since."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰，手指伸出", "en": "I bend and extend my fingers."},
        {"zh": "夹住了，提起来", "en": "I pinch it and lift."},
        {"zh": "提到眼前来看", "en": "I bring it to my eyes."},
        {"zh": "可我看不清了", "en": "I can't focus anymore."},
        {"zh": "我把它放近一点", "en": "I bring it closer."},
        {"zh": "还是看不清楚", "en": "Still can't."},
        {"zh": "我塞进箱子里", "en": "I put it in the crate."},
        {"zh": "和别的东西放一起", "en": "With the others."},
        {"zh": "箱子越来越沉", "en": "The crate gets heavier."},
        {"zh": "反正不关我的事", "en": "It doesn't concern me anyway."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "前面有人在动", "en": "Something alive moves ahead."},
        {"zh": "我把绳子换了个握法", "en": "I change my grip on the ropes."},
        {"zh": "骨架停下来了", "en": "The skeletons halt."},
        {"zh": "它们比我更早察觉", "en": "They noticed before I did."},
        {"zh": "那就不该是好东西", "en": "That can't be anything good."},
        {"zh": "我把箱子往身后拉", "en": "I drag the crate behind me."},
        {"zh": "里面没什么值钱的", "en": "It holds nothing valuable."},
        {"zh": "可是那是我的", "en": "But it's mine."},
        {"zh": "我又把手张开", "en": "I spread my hands."},
        {"zh": "指头都是僵的", "en": "Every finger is stiff."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我都跟在你后头", "en": "I trail behind you."},
        {"zh": "并不是我想跟", "en": "Not because I want to."},
        {"zh": "是那两匹先动的", "en": "The two started first."},
        {"zh": "它们闻到了活人", "en": "They smelled the living."},
        {"zh": "我一个人拉不住", "en": "I can't hold them back."},
        {"zh": "绳子在手心滑", "en": "The ropes slip in my palm."},
        {"zh": "我说了好几遍停", "en": "I've said stop several times."},
        {"zh": "它们根本不听", "en": "They don't listen."},
        {"zh": "以前它们很听我的", "en": "They used to obey me."},
        {"zh": "我把脚扎进沙里", "en": "I dig my feet into the sand."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬手想抓，抓偏了", "en": "I reach to grab and miss."},
        {"zh": "手指从你肩上滑过去", "en": "My fingers slide past your shoulder."},
        {"zh": "骨架顶了我一下", "en": "A skeleton jabs into me."},
        {"zh": "绳子把我拽向你", "en": "The leash drags me into you."},
        {"zh": "那不是我打你", "en": "That wasn't me striking you."},
        {"zh": "是它们带着我撞的", "en": "They dragged me into it."},
        {"zh": "我使劲拽绳子", "en": "I haul on the ropes hard."},
        {"zh": "它们退了半步", "en": "They give half a step."},
        {"zh": "我喘不上气来", "en": "I can't catch my breath."},
        {"zh": "你趁现在快走", "en": "Leave while you can."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "路那头来了个商人", "en": "A trader comes up the road."},
        {"zh": "后面跟着两头骨兽", "en": "Two bony beasts at his back."},
        {"zh": "我把绳子在手上绕了两圈", "en": "I wind the ropes twice around my hand."},
        {"zh": "这样才握得住", "en": "That holds better."},
        {"zh": "沙地上有我的影子", "en": "My shadow stretches on the sand."},
        {"zh": "还有它们的影子", "en": "Theirs too."},
        {"zh": "三个影子一样长", "en": "All three shadows the same length."},
        {"zh": "我抬头看了太阳", "en": "I look up at the sun."},
        {"zh": "又是这个时辰", "en": "That hour again."},
        {"zh": "我该往东边走", "en": "I should head east."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "箱子烧起来了，我拍不灭", "en": "The crate burns and I can't put it out."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，绳子脱了手", "en": "I fall and the ropes slip free."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进了嘴，我咳不出来", "en": "Water fills my mouth and I can't cough."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把骨架吹散了", "en": "The blast scatters my skeletons."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿了我的袍子", "en": "Something punches through my robe."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "身体里有什么在翻", "en": "Something turns over inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不记得饿是什么", "en": "I can't remember what hunger was."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把我的影子打没了", "en": "Lightning wipes out my shadow."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "路下面什么都没有", "en": "Nothing beneath the road."}
      ]
    }
  }
}
