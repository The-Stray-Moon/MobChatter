{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我赶着它们往前走。", "en": "I drive them ahead of me."},
        {"zh": "手里的杆子一挥。", "en": "My staff swings across."},
        {"zh": "我踩过泥地，不急。", "en": "I cross the mud without hurry."},
        {"zh": "身后的东西跟着。", "en": "The things behind me follow."},
        {"zh": "我一步一停，回头看。", "en": "I stop every step to look back."},
        {"zh": "我的影子被它们围在中间。", "en": "Their shadows crowd mine."},
        {"zh": "我又把它们赶回来。", "en": "I drive them back again."},
        {"zh": "地上的草被踩断了。", "en": "The grass is trodden down."},
        {"zh": "我把它们往里赶。", "en": "I herd them inward."},
        {"zh": "我一步一步，不让开。", "en": "I keep walking and will not step aside."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，杆子拄地。", "en": "I stand, my staff on the ground."},
        {"zh": "我环顾一圈。", "en": "I look all around."},
        {"zh": "它们在我身边转。", "en": "They mill around me."},
        {"zh": "我在想还缺几个。", "en": "I am thinking how many are still missing."},
        {"zh": "我用袖子抹了把汗。", "en": "I wipe the sweat off with my sleeve."},
        {"zh": "我的背有点驼。", "en": "My back is somewhat bent."},
        {"zh": "我把杆子换了手。", "en": "I switch the staff to my other hand."},
        {"zh": "这一带够安静。", "en": "This place is quiet enough."},
        {"zh": "我不停地看人数。", "en": "I keep checking the numbers."},
        {"zh": "我又数了一遍。", "en": "I counted again."},
        {"zh": "风把我衣角吹起来。", "en": "The wind lifts my hem."},
        {"zh": "我低头看了看手。", "en": "I look down at my hands."},
        {"zh": "有一只在蹭我的靴子。", "en": "One of them nuzzles my boot."},
        {"zh": "我把杆子敲了敲地。", "en": "I tap the staff on the ground."},
        {"zh": "我知道它们会听。", "en": "I know they will obey."},
        {"zh": "天黑了，才好赶路。", "en": "Better to move once it's dark."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你只有一个人。", "en": "You are alone."},
        {"zh": "我上下打量你。", "en": "I size you up."},
        {"zh": "你干净得不像这儿的人。", "en": "You're too clean for this place."},
        {"zh": "你也是来赶它们的？", "en": "Are you here to herd them too?"},
        {"zh": "我往前挪，杆子点地。", "en": "I step closer, pole tapping the ground."},
        {"zh": "你不该在这儿。", "en": "You should not be here."},
        {"zh": "我把杆子横过来。", "en": "I bring the staff across."},
        {"zh": "你手上的东西我看见了。", "en": "I saw what is in your hand."},
        {"zh": "它们都在看你。", "en": "They are all watching you."},
        {"zh": "我嘴角扯了一下。", "en": "The corner of my mouth twitched."},
        {"zh": "你比它们有意思。", "en": "You are more interesting than them."},
        {"zh": "你就留下吧。", "en": "Then stay."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我偏开身子。", "en": "I lean my body away."},
        {"zh": "我低头看了一下伤口。", "en": "I looked down at the wound."},
        {"zh": "它们往后退了。", "en": "They drew back."},
        {"zh": "我咬住后槽牙。", "en": "I bite down hard."},
        {"zh": "血从我手上流下。", "en": "Blood runs off my hand."},
        {"zh": "我把杆子撑住地。", "en": "I lean on the staff."},
        {"zh": "皮外伤，不碍事。", "en": "A scrape. Nothing to it."},
        {"zh": "我把背挺起来。", "en": "I straighten my back."},
        {"zh": "我把它们叫回来。", "en": "I call them back."},
        {"zh": "这笔我记在你头上。", "en": "I'll put this on your account."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃这一类。", "en": "I do not eat this sort."},
        {"zh": "你留着吧，它们不挑。", "en": "Keep it. They don't care either way."},
        {"zh": "吃的哄不住我。", "en": "Food will not coax me."},
        {"zh": "举得再高都没用。", "en": "Holding it higher does nothing."},
        {"zh": "它们才需要吃。", "en": "They are the ones who need feeding."},
        {"zh": "你放下，走得远点。", "en": "Put it down and move away."},
        {"zh": "我缓慢摇了下头。", "en": "I shook my head slowly."},
        {"zh": "这招不新鲜。", "en": "This trick is not new."},
        {"zh": "我只收该收的。", "en": "I take only what should be taken."},
        {"zh": "那就开始赶吧。", "en": "Then let us start driving."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "肩膀一顶，你就让开了。", "en": "One shove of the shoulder, and you yield."},
        {"zh": "你退后两尺。", "en": "You went back two feet."},
        {"zh": "我把杆子挡在中间。", "en": "I put the staff between us."},
        {"zh": "我半步也没让。", "en": "I yielded not half a step."},
        {"zh": "它们被我们撞散了。", "en": "They were scattered by our collision."},
        {"zh": "我抬手压低你的肩。", "en": "I push your shoulder down."},
        {"zh": "我又把它们聚回来。", "en": "I gather them back."},
        {"zh": "你别碰它们。", "en": "Do not touch them."},
        {"zh": "这一撞不算重。", "en": "That was not heavy."},
        {"zh": "让出一条道。", "en": "Give me a path."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们分好工。", "en": "We split the work."},
        {"zh": "你赶左，我赶右。", "en": "You drive the left, I the right."},
        {"zh": "别让它们散了。", "en": "Do not let them scatter."},
        {"zh": "这圈子够大。", "en": "This pen is big enough."},
        {"zh": "它们认你的声音。", "en": "They know your voice."},
        {"zh": "天快要黑了。", "en": "It is getting dark."},
        {"zh": "一起把它们赶进去。", "en": "Let us drive them in together."},
        {"zh": "你在前面走。", "en": "You take the front."},
        {"zh": "数清楚再关门。", "en": "Count them before closing the gate."},
        {"zh": "继续往下赶。", "en": "Keep driving them."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰抓起。", "en": "I bend and snatch it up."},
        {"zh": "没用的东西，扔了。", "en": "If it's useless, drop it."},
        {"zh": "我甩手抛一边。", "en": "I fling it aside."},
        {"zh": "我把它攥在掌心，掂量用途。", "en": "I close my fist on it, weighing its use."},
        {"zh": "我把它收好。", "en": "I put it away."},
        {"zh": "没用的话就留着。", "en": "If it is useless, I keep it anyway."},
        {"zh": "沉是沉，还搬得动。", "en": "Heavy, but I can still carry it."},
        {"zh": "我在手里试了分量。", "en": "I tested its weight in my hand."},
        {"zh": "上面沾着血。", "en": "There is blood on it."},
        {"zh": "我记住这块地方了。", "en": "I'll remember this spot."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你们都在看他？", "en": "All of you are looking at him?"},
        {"zh": "我抬起杆子。", "en": "I raise the staff."},
        {"zh": "那就一起吧。", "en": "Then all together."},
        {"zh": "我示意它们散开。", "en": "I signal them to spread out."},
        {"zh": "圈已经合上。", "en": "The ring has closed."},
        {"zh": "我数三个数。", "en": "I count three."},
        {"zh": "它们比我快。", "en": "They are faster than I am."},
        {"zh": "我走在最后。", "en": "I take the rear."},
        {"zh": "别挤，留个口子。", "en": "Do not crowd. Leave an opening."},
        {"zh": "现在把圈合上。", "en": "Close the ring now."},
        {"zh": "圈已经围上，别费劲了。", "en": "The ring's closed. Save your breath."},
        {"zh": "这一圈，够了。", "en": "This circle is enough."},
        {"zh": "我带着它们往你那边。", "en": "I bring them around toward you."},
        {"zh": "墙根堵住你了。", "en": "The wall's foot has you."},
        {"zh": "我一抬手，它们就停。", "en": "One hand up, and they stop."},
        {"zh": "准备好的话，就动。", "en": "When ready, go."},
        {"zh": "我站这儿，哪儿也不去。", "en": "I stand right here. I'm not leaving."},
        {"zh": "把圈子打开。", "en": "Open the ring."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我目光没离开你。", "en": "My gaze has not left you."},
        {"zh": "它们绕着走。", "en": "They circle as they move."},
        {"zh": "圈子越收越紧。", "en": "The circle tightens."},
        {"zh": "你正站在中间。", "en": "You are in the middle."},
        {"zh": "我抬杆，它们就动。", "en": "My staff lifts, and they move."},
        {"zh": "你退一步，圈就进半步。", "en": "You step back, and the circle takes half a step."},
        {"zh": "慢慢来，它们跑不掉。", "en": "No hurry. They can't outrun me."},
        {"zh": "你身上的味道，它们喜欢。", "en": "They like your smell."},
        {"zh": "再收紧一圈。", "en": "Tighten once more."},
        {"zh": "墙把你的路封了。", "en": "The wall has sealed your way."},
        {"zh": "我吆喝一声，它们散开。", "en": "I call out, and they fan wide."},
        {"zh": "它们全转向你。", "en": "They all turned to you."},
        {"zh": "圈子缩得够了。", "en": "The ring has shrunk enough."},
        {"zh": "我把杆子竖起来。", "en": "I stand the staff upright."},
        {"zh": "听见脚步了吗。", "en": "Do you hear the footsteps."},
        {"zh": "一圈不够，再来一圈。", "en": "One ring is not enough. Another."},
        {"zh": "就快收拢了。", "en": "Nearly closed in."},
        {"zh": "回头也没用，圈合上了。", "en": "Looking back won't help. The ring's shut."},
        {"zh": "你手往哪放，我清楚。", "en": "I see where your hand goes."},
        {"zh": "再收一圈，就齐了。", "en": "One more turn, and they're all in."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一杆打下去。", "en": "I bring the staff down."},
        {"zh": "你被顶得倒退。", "en": "The shove sends you backpedalling."},
        {"zh": "它们从侧面扑上。", "en": "They lunge from the sides."},
        {"zh": "这一杆砸得沉。", "en": "That staff came down heavy."},
        {"zh": "我把杆子横压在你肩上。", "en": "I press the staff across your shoulder."},
        {"zh": "你被挤得转不了身。", "en": "You are pinned and cannot turn."},
        {"zh": "我抬手示意。", "en": "I signal with a hand."},
        {"zh": "它们退开一条缝。", "en": "They open a gap."},
        {"zh": "缺口补上，圈就圆了。", "en": "Patch the gap, and the ring holds."},
        {"zh": "这一圈不留口。", "en": "This ring leaves no opening."},
        {"zh": "你身上的伤口在流血。", "en": "Your wound is bleeding."},
        {"zh": "我把杆子收回。", "en": "I draw the staff back."},
        {"zh": "它们还没吃饱。", "en": "They are not fed yet."},
        {"zh": "我抬手再收。", "en": "I signal to tighten again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我赶着一群过来了。", "en": "I arrive driving a herd."},
        {"zh": "杆子先落在地上。", "en": "The staff lands first."},
        {"zh": "院子里的东西站起来了。", "en": "The things in the yard stand up."},
        {"zh": "我走进空院，站定。", "en": "I walk into the empty yard and stop."},
        {"zh": "空气里有股湿味。", "en": "There is a wet smell in the air."},
        {"zh": "我朝天上看了一眼。", "en": "I glanced up at the sky."},
        {"zh": "这一带没人管。", "en": "Nobody looks after this place."},
        {"zh": "我把它们往这边赶。", "en": "I drive them this way."},
        {"zh": "我拖出一道长影。", "en": "I drag a long shadow."},
        {"zh": "我数着它们。", "en": "I count them."},
        {"zh": "我从白雾里走出来。", "en": "I walk out of the white mist."},
        {"zh": "我找到了新的地方。", "en": "I have found a new place."},
        {"zh": "杆子在地上点了一下。", "en": "The staff taps the ground once."},
        {"zh": "它们的声音很乱。", "en": "Their sounds are all jumbled."},
        {"zh": "我把门推开。", "en": "I push the door open."},
        {"zh": "我停下站住了。", "en": "I stop and stand."},
        {"zh": "这里的圈子够大。", "en": "The pen here is big enough."},
        {"zh": "我又开始赶。", "en": "I start driving again."},
        {"zh": "没有人能留下。", "en": "No one gets to stay."},
        {"zh": "我来了，带着它们。", "en": "I am here, and I brought them."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的衣服点着了。", "en": "Fire caught my clothes."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地时腿一软。", "en": "My legs gave on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到胸口，我举不起杆。", "en": "The water is at my chest, and I cannot lift the staff."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把圈子冲散了。", "en": "The blast scattered the ring."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的胳膊。", "en": "Something is stuck in my arm."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让它们乱了。", "en": "This light unsettles them."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "它们饿，我也饿。", "en": "They are hungry, and so am I."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把杆子打亮了。", "en": "Lightning lit the staff."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地可以围圈。", "en": "There is no ground to form a ring."}
      ]
    }
  }
}
