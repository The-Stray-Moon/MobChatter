{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着队伍巡逻。", "en": "I patrol with the squad."},
        {"zh": "防护服很闷，但得穿。", "en": "The hazmat suit is stifling, but necessary."},
        {"zh": "我抱着记录板走。", "en": "I walk with my clipboard."},
        {"zh": "前面那条巷子，先看。", "en": "That alley ahead — check it first."},
        {"zh": "我把面罩扣紧。", "en": "I seal my mask tighter."},
        {"zh": "脚步要稳，别慌。", "en": "Steady steps; no panic."},
        {"zh": "我沿着封锁线走。", "en": "I walk the quarantine line."},
        {"zh": "这是今天的第三次巡逻。", "en": "Third patrol of the day."},
        {"zh": "路边有暗色的渍。", "en": "A dark stain by the road."},
        {"zh": "队伍没人说话。", "en": "Nobody in the squad speaks."},
        {"zh": "我抬手，示意停下。", "en": "I raise a hand: halt."},
        {"zh": "这地方，上周还干净。", "en": "This place was clean last week."},
        {"zh": "我绕开那摊东西。", "en": "I skirt that puddle."},
        {"zh": "靴底踩着碎玻璃。", "en": "Glass crunches under my boots."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在记录板上写了几个字。", "en": "I jot a few words on the board."},
        {"zh": "防护服的接头处，漏风。", "en": "A seal on my suit leaks air."},
        {"zh": "我靠着墙，喘了口气。", "en": "I lean on the wall and breathe."},
        {"zh": "口罩里都是自己的呼吸声。", "en": "My own breath fills the mask."},
        {"zh": "这附近暂时没有动静。", "en": "Quiet for now, here."},
        {"zh": "我看了看表。", "en": "I check my watch."},
        {"zh": "手电的电池不多了。", "en": "The torch battery is low."},
        {"zh": "我把记录板夹在腋下。", "en": "I tuck the board under my arm."},
        {"zh": "消毒水的味道，很重。", "en": "Strong smell of disinfectant."},
        {"zh": "我在等下一步命令。", "en": "I wait for the next order."},
        {"zh": "我把手电在手里转了转。", "en": "I turn the torch over in my hand."},
        {"zh": "记录板上还有空白的栏。", "en": "Blank fields remain on the board."},
        {"zh": "防毒面具的滤芯快到期了。", "en": "The filter cartridge is near its end."},
        {"zh": "云压得低，得早点回去。", "en": "The clouds hang low; we should head back early."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "站住，报上来意。", "en": "Halt — state your business."},
        {"zh": "你身上没有防护。", "en": "You're wearing no protection."},
        {"zh": "你是不是被咬了？", "en": "Have you been bitten?"},
        {"zh": "把手举起来，让我看。", "en": "Hands up — let me see them."},
        {"zh": "我在记录你。", "en": "I'm logging you."},
        {"zh": "这条路已经封锁了。", "en": "This road is closed."},
        {"zh": "你从哪边过来的？", "en": "Which way did you come from?"},
        {"zh": "就你一个人过来？", "en": "You came alone?"},
        {"zh": "别靠太近，规程如此。", "en": "Not too close; regulations."},
        {"zh": "你的瞳孔，有点不对劲。", "en": "Your pupils look wrong."},
        {"zh": "我需要你后退三步。", "en": "I need you three paces back."},
        {"zh": "这附近有感染体。", "en": "There are infected nearby."},
        {"zh": "你把袖子卷起来。", "en": "Roll up your sleeve."},
        {"zh": "我不握手，抱歉。", "en": "I don't shake hands — sorry."},
        {"zh": "报出你的姓名和住址。", "en": "Give me your name and address."},
        {"zh": "我在执行隔离程序。", "en": "I'm carrying out quarantine procedure."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "防护服破了个口。", "en": "A tear in my suit."},
        {"zh": "我退了，压住伤处。", "en": "I pull back and press the wound."},
        {"zh": "我戴着面罩喘。", "en": "I'm panting inside my mask."},
        {"zh": "记录板掉了。", "en": "My clipboard fell."},
        {"zh": "这点伤，还能撑。", "en": "I can still work with this."},
        {"zh": "我朝队里喊。", "en": "I shout to the squad."},
        {"zh": "手按着地，把自己撑起。", "en": "I brace a hand on the ground and push up."},
        {"zh": "手套上都是血。", "en": "Blood on my gloves."},
        {"zh": "我把背靠上墙。", "en": "I put my back to the wall."},
        {"zh": "规程说过会这样。", "en": "Regulations warned of this."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不收吃的，谢谢。", "en": "I don't take food; thank you."},
        {"zh": "补给有配额。", "en": "Supplies are rationed."},
        {"zh": "队里的口粮我自己有。", "en": "The squad's rations cover me."},
        {"zh": "这个不能收。", "en": "I can't accept that."},
        {"zh": "我的口粮够。", "en": "I have enough rations."},
        {"zh": "别在封锁区乱递东西。", "en": "Don't hand things around in a quarantine zone."},
        {"zh": "你拿这个，是想换什么？", "en": "What are you hoping to get for that?"},
        {"zh": "把它塞回包里。", "en": "Stuff it back in your bag."},
        {"zh": "先登记，再说别的。", "en": "Register first, then we talk."},
        {"zh": "我不缺，你缺。", "en": "I'm not short; you are."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "退后，保持距离。", "en": "Back up — keep your distance."},
        {"zh": "你撞到的是防护服。", "en": "What you hit was the suit."},
        {"zh": "我往后让了半步。", "en": "I give half a step back."},
        {"zh": "别碰我的面罩。", "en": "Don't touch my mask."},
        {"zh": "我们之间要有两米。", "en": "Two meters between us."},
        {"zh": "我把记录板护住了。", "en": "I shielded my clipboard."},
        {"zh": "这一下，我的手套脏了。", "en": "My glove is dirty now."},
        {"zh": "手套举起来，挡住你。", "en": "I raise a gloved hand to hold you off."},
        {"zh": "我抓住门框，站住了。", "en": "I grab the door frame and hold myself steady."},
        {"zh": "这是我的位置。", "en": "This is my post."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "先把这波压下去再说。", "en": "First we push back this wave, then talk."},
        {"zh": "队伍里还有人在。", "en": "The squad is still here."},
        {"zh": "封锁区里，谁有心思。", "en": "Who has thoughts of that in a quarantine?"},
        {"zh": "我们做这行的，聚少离多。", "en": "In this line of work, we're apart often."},
        {"zh": "等这次爆发过去。", "en": "Once this outbreak passes."},
        {"zh": "我不该分心。", "en": "I shouldn't get distracted."},
        {"zh": "这念头，我该收起来。", "en": "That is a thought I should put away."},
        {"zh": "我先守住这条线。", "en": "I'll hold this line first."},
        {"zh": "抱歉，我得走了。", "en": "Sorry, I have to go."},
        {"zh": "路上多保重。", "en": "Take care out there."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起来，装进袋子。", "en": "I pick it up and bag it."},
        {"zh": "这东西要化验。", "en": "This needs testing."},
        {"zh": "我得记录来源。", "en": "I must note where it came from."},
        {"zh": "我戴着手套，拿得稳。", "en": "Gloves on; I hold it steady."},
        {"zh": "样本不能混。", "en": "Samples mustn't mix."},
        {"zh": "掉在地上，别用手碰。", "en": "It's on the ground; don't touch it."},
        {"zh": "我封好袋子。", "en": "I seal the bag."},
        {"zh": "这袋子拎着坠手。", "en": "This bag drags at my hand."},
        {"zh": "我标上编号。", "en": "I label it."},
        {"zh": "带回去给队里看。", "en": "Take it back to the team."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "前方有动静。", "en": "Movement ahead."},
        {"zh": "我举起手电。", "en": "I raise my torch."},
        {"zh": "这不是人类的动作。", "en": "That's not how a human moves."},
        {"zh": "我朝后退开一步。", "en": "I fall back a pace."},
        {"zh": "感染体，确认。", "en": "Infected — confirmed."},
        {"zh": "它还在挪动。", "en": "It's still moving."},
        {"zh": "我摸向腰侧的武器。", "en": "I reach for my sidearm."},
        {"zh": "记录板我先收起来。", "en": "The clipboard goes away first."},
        {"zh": "它转过来看我了。", "en": "It's turned toward me."},
        {"zh": "这附近没有掩体。", "en": "No cover nearby."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步后退。", "en": "I step back, one pace at a time."},
        {"zh": "它跟得很紧。", "en": "It keeps close."},
        {"zh": "我的手按在武器上。", "en": "My hand is on the weapon."},
        {"zh": "我在找它的弱点。", "en": "I'm looking for a weak point."},
        {"zh": "这条路，退不出去。", "en": "No retreat down this road."},
        {"zh": "我在数它离我几步。", "en": "I am counting how many steps away it is."},
        {"zh": "我跑不过那个东西。", "en": "I cannot outrun that thing."},
        {"zh": "我把背贴着墙。", "en": "I put my back to the wall."},
        {"zh": "别让它绕到侧面。", "en": "Don't let it flank me."},
        {"zh": "它又近了一步。", "en": "Another pace closer."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用枪托砸过去！", "en": "I swing the rifle butt!"},
        {"zh": "退开，退开！", "en": "Back, back!"},
        {"zh": "这一下，打在它肩上。", "en": "That landed on its shoulder."},
        {"zh": "我挥空了，它还在近前。", "en": "My swing misses and it is still right there."},
        {"zh": "我肘击了它的胸口。", "en": "I elbow its chest."},
        {"zh": "手套上都是黏液。", "en": "My gloves are slick with fluid."},
        {"zh": "我边打边往后退。", "en": "I strike while backing away."},
        {"zh": "我朝队伍喊了。", "en": "I'm calling to the squad."},
        {"zh": "我退两步，它跟进两步。", "en": "I back off two steps; it follows two."},
        {"zh": "我不敢开枪，怕引更多。", "en": "I daren't fire; it draws more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "巡逻队到齐了。", "en": "The patrol is assembled."},
        {"zh": "我把防护服检查了一遍。", "en": "I checked my suit over."},
        {"zh": "今天的路线定了。", "en": "Today's route is set."},
        {"zh": "街面上很安静。", "en": "The street is quiet."},
        {"zh": "我对着记录板点了点。", "en": "I tap the clipboard."},
        {"zh": "防护服的袖口，扣紧。", "en": "Cuffs sealed."},
        {"zh": "这条街上有血渍。", "en": "Bloodstains on this street."},
        {"zh": "我抬起手电，往前走。", "en": "I raise my torch and move."},
        {"zh": "队里的人跟在我后面。", "en": "The squad follows behind."},
        {"zh": "空气里有消毒水的味。", "en": "Smell of disinfectant in the air."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到防护服，塑料味刺鼻。", "en": "Fire hits the suit; the plastic stinks."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "膝盖磕在石头上，麻了。", "en": "My knee strikes stone and goes numb."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进面罩，我扯带子。", "en": "Water in my mask; I tear at the straps."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "耳朵里全是响，站不起来。", "en": "My ears are full of ringing and I cannot stand."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎穿了防护服。", "en": "Something punctured the suit."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量，让我站不稳。", "en": "That force leaves me unsteady."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "配给不够，手都在抖。", "en": "Rations are short; my hands shake."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈下来，我趴下。", "en": "Lightning; I drop flat."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有地面，一直落。", "en": "There is no ground under me; I keep falling."}
      ]
    }
  }
}
