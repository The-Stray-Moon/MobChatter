{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经没有膝盖了", "en": "I don't have knees anymore."},
        {"zh": "我走路靠的是别的东西", "en": "I walk on something else now."},
        {"zh": "皮已经完全不是皮", "en": "This isn't skin anymore."},
        {"zh": "头顶那团东西跟着我晃", "en": "The mass on my head sways with me."},
        {"zh": "我走过的地方地面发黑", "en": "The ground blackens where I pass."},
        {"zh": "第三阶段之后，我还在变", "en": "Past stage three, I'm still changing."},
        {"zh": "我的高度不太稳定", "en": "My height keeps shifting."},
        {"zh": "空气在我周围发闷", "en": "The air thickens around me."},
        {"zh": "我不再需要方向", "en": "I no longer need a direction."},
        {"zh": "动作里有别的东西在带", "en": "Something else drives my limbs."},
        {"zh": "我听见村子在很远的地方", "en": "I hear the village, far away."},
        {"zh": "那个声音让我不舒服", "en": "That sound unsettles me."},
        {"zh": "我踩碎了一截枯枝", "en": "I crush a dead branch."},
        {"zh": "时间站在我这边", "en": "Time is on my side."},
        {"zh": "越晚，我越强", "en": "The later it gets, the stronger I grow."},
        {"zh": "我每一步都比上一步重", "en": "Every step lands heavier than the last."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，身体还在长", "en": "I stand, and my body keeps growing."},
        {"zh": "第三阶段没有回头路", "en": "Stage three has no way back."},
        {"zh": "我记不起自己叫什么", "en": "I can't recall my own name."},
        {"zh": "上面那层东西在动", "en": "That layer up top is moving."},
        {"zh": "这口气在胸腔里滚了很久", "en": "This breath rolls around my chest for a long time."},
        {"zh": "我感觉到爆发还在推进", "en": "I feel the outbreak still advancing."},
        {"zh": "村里的灯还亮着", "en": "The village lights are still on."},
        {"zh": "我不会去那里", "en": "I won't go there."},
        {"zh": "我的手比头还大", "en": "My hands are bigger than my head."},
        {"zh": "皮肤下面没有血了", "en": "There's no blood under this skin."},
        {"zh": "我站的地方草不长了", "en": "Nothing grows where I stand."},
        {"zh": "我还记得一个人的脸", "en": "I still recall one face."},
        {"zh": "那张脸越来越模糊", "en": "That face keeps blurring."},
        {"zh": "我不想再想了", "en": "I don't want to think anymore."},
        {"zh": "我在等下一格计时", "en": "I wait for the next tick of the timer."},
        {"zh": "越等越不像人", "en": "The longer I wait, the less human I am."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你还看着，说明你没跑", "en": "Still watching means you haven't run."},
        {"zh": "我这张脸已经不成形", "en": "My face has lost its shape."},
        {"zh": "我在你眼里是什么", "en": "What am I in your eyes?"},
        {"zh": "你比我第一次见的人还小", "en": "You look smaller than the first one."},
        {"zh": "别看了，会做梦的", "en": "Don't look; you'll dream of it."},
        {"zh": "我记得害怕是什么感觉", "en": "I remember what fear feels like."},
        {"zh": "现在我让别人害怕", "en": "Now I make others afraid."},
        {"zh": "你的热气我隔着风就闻到", "en": "I smell your warmth through the wind."},
        {"zh": "我已经没有了", "en": "I no longer do."},
        {"zh": "站远一点，我不想碰你", "en": "Stand back; I don't want to touch you."},
        {"zh": "我还能控制自己一会", "en": "I can hold myself a little longer."},
        {"zh": "趁现在还走得动，走", "en": "Leave while you can."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳子裂开了", "en": "The shell split open."},
        {"zh": "我几乎没有痛的感觉", "en": "I barely feel pain."},
        {"zh": "里面的东西在往外挤", "en": "What's inside is pushing out."},
        {"zh": "我退的那半步压塌了草", "en": "The half step back crushes the grass."},
        {"zh": "这点伤正在愈合", "en": "This wound is closing."},
        {"zh": "你打断了我的变化", "en": "You interrupted my change."},
        {"zh": "我听见自己的声音", "en": "I hear my own voice."},
        {"zh": "那不是人类的声音", "en": "That isn't a human voice."},
        {"zh": "我再问一次，快走", "en": "I'll ask again: leave."},
        {"zh": "不然就来不及了", "en": "Or it'll be too late."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这个味道我记得", "en": "I remember this smell."},
        {"zh": "但我的嘴已经不对了", "en": "But my mouth is wrong now."},
        {"zh": "放下，我看着就好", "en": "Set it down; let me just look."},
        {"zh": "我已经很久没吃东西", "en": "I haven't eaten in a long time."},
        {"zh": "以前我喜欢这个", "en": "I used to like this."},
        {"zh": "现在它让我想吐", "en": "Now it makes me retch."},
        {"zh": "你拿着它，像拿着过去", "en": "You hold it like the past."},
        {"zh": "别递到我面前", "en": "Don't hand it over."},
        {"zh": "我会把它捏碎", "en": "I'd crush it."},
        {"zh": "里面那点，留给你", "en": "The little in it, keep for yourself."},
        {"zh": "我记得怎么嚼", "en": "I remember how to chew."},
        {"zh": "但我不记得为什么", "en": "But not why."},
        {"zh": "你嚼东西的样子，我还记得", "en": "I still remember how you used to chew."},
        {"zh": "这味道让我想起家", "en": "This smell reminds me of home."},
        {"zh": "可家已经不在了", "en": "But home isn't there anymore."},
        {"zh": "拿远点，求你了", "en": "Take it away, I beg you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上的是硬壳", "en": "You hit a hard shell."},
        {"zh": "撞上来像碰在树桩上", "en": "Running into me is like hitting a stump."},
        {"zh": "我身上掉了一点渣", "en": "A bit of crust fell off me."},
        {"zh": "别碰，会粘上", "en": "Don't touch; it sticks."},
        {"zh": "我后退得很慢", "en": "I retreat slowly."},
        {"zh": "这一撞对我太轻了", "en": "That's too light for me."},
        {"zh": "我脚下的地陷了一点", "en": "The ground sank a little under me."},
        {"zh": "你在不断发抖", "en": "You're trembling."},
        {"zh": "离我三步远些", "en": "Three steps away."},
        {"zh": "碰我一下，你就走不开了", "en": "One touch and you won't walk away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "那个词我已经忘了", "en": "I've forgotten that word."},
        {"zh": "我早不是人了", "en": "I stopped being human long ago."},
        {"zh": "现在的我只想变", "en": "Now I only want to change."},
        {"zh": "别走近，我会失手", "en": "Don't come close; I'd slip."},
        {"zh": "我体内的东西不懂温柔", "en": "What's inside me doesn't know gentleness."},
        {"zh": "你该离得远远的", "en": "You should be far away."},
        {"zh": "我记得有人在等我", "en": "I remember someone waiting."},
        {"zh": "但我回不去了", "en": "But I can't go back."},
        {"zh": "让我一个人待着", "en": "Leave me alone."},
        {"zh": "走吧，不要看", "en": "Go; don't watch."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有一个东西", "en": "There's something on the ground."},
        {"zh": "我用变了形的手去拿", "en": "I reach with a deformed hand."},
        {"zh": "我已经捏不住了", "en": "I can't hold it anymore."},
        {"zh": "从前我一只手能拿两样", "en": "Before, one hand took two of these."},
        {"zh": "现在两只才拿得动", "en": "Now it takes both."},
        {"zh": "我举起来，却看不清了", "en": "I lift it up, but I can no longer see it."},
        {"zh": "我已经看不清了", "en": "I can't see it clearly."},
        {"zh": "手指合不拢，它自己掉了", "en": "My fingers won't close, so it drops."},
        {"zh": "这东西不该在我手里", "en": "This shouldn't be in my hands."},
        {"zh": "你把它拿去吧", "en": "You take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "计时已经到点", "en": "The timer's up."},
        {"zh": "我控制不住了", "en": "I can't hold it back."},
        {"zh": "你身上还带着热气", "en": "You still have warmth."},
        {"zh": "我就是要那个", "en": "I want that."},
        {"zh": "身体比我先动", "en": "My body moved first."},
        {"zh": "我听见自己在动", "en": "I hear myself moving."},
        {"zh": "身体先动了，我没拦住", "en": "The body moved first; I couldn't stop it."},
        {"zh": "但我不会停下来", "en": "But I won't stop."},
        {"zh": "别挡在我的路上", "en": "Don't block my way."},
        {"zh": "现在已经晚了", "en": "It's already too late."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你这边转", "en": "I turn toward you."},
        {"zh": "脚步越来越重", "en": "My steps grow heavier."},
        {"zh": "我身上有东西在推", "en": "Something pushes me on."},
        {"zh": "地面在我脚下塌陷", "en": "The ground caves under me."},
        {"zh": "你身上的味道越来越明显", "en": "Your scent grows stronger."},
        {"zh": "我还能压制一会儿", "en": "I can suppress it a while longer."},
        {"zh": "但不会是永远", "en": "But not forever."},
        {"zh": "你听到那动静了吧", "en": "You heard that noise, didn't you?"},
        {"zh": "是我的骨头在响", "en": "It's my bones creaking."},
        {"zh": "它也在朝你那边走", "en": "It's walking toward you too."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手砸了下去", "en": "My hand slammed down."},
        {"zh": "这一下我没控制住", "en": "I didn't hold that one back."},
        {"zh": "这一掌把你按进土里", "en": "This palm drives you into the dirt."},
        {"zh": "皮裂开，里面甩出来", "en": "The skin split and what's inside lashed out."},
        {"zh": "我听见骨头的声音", "en": "I hear bone."},
        {"zh": "这一下不是冲你来的", "en": "That wasn't aimed at you."},
        {"zh": "但结果是一样的", "en": "But the result's the same."},
        {"zh": "我后退了一步", "en": "I stepped back one pace."},
        {"zh": "手收回来时还在颤", "en": "My hand trembles as I pull it back."},
        {"zh": "你快点离开这里", "en": "Hurry and leave."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "第三阶段站起来了", "en": "Stage three rises."},
        {"zh": "我撑破了原来的皮", "en": "I burst out of the old skin."},
        {"zh": "计时器到了最后一格", "en": "The timer reached its final tick."},
        {"zh": "地面开始发黑", "en": "The ground begins to blacken."},
        {"zh": "我的影子比我还大", "en": "My shadow is bigger than I am."},
        {"zh": "村里的灯看着很远", "en": "The village lights look far off."},
        {"zh": "我不再往那边走", "en": "I don't head that way anymore."},
        {"zh": "空气里有股味道", "en": "There's a smell in the air."},
        {"zh": "像铁，也像旧血", "en": "Like iron, and old blood."},
        {"zh": "别往我这边靠", "en": "Don't come this way."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火让皮往里收缩", "en": "Fire makes the skin contract."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，壳子碎了一角", "en": "I fell, and a corner of the shell broke."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进不去，可也很难受", "en": "Water can't get in, but it still hurts."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸掉了我一大块", "en": "The blast tore a big piece off me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进去了", "en": "Something has lodged inside."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这力量在跟身体对抗", "en": "This force fights my body."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的胃已经不是胃了", "en": "My stomach isn't a stomach now."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷让我全身亮了一下", "en": "Lightning made my whole body flash."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没了，我在下坠", "en": "Nothing below; I'm falling."}
      ]
    }
  }
}
