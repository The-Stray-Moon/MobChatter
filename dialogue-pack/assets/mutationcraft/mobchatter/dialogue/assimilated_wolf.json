      "operation": "replace",
      "lines": [
        {"zh": "我总是饿着肚子", "en": "I'm always empty-bellied."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打得我四肢一僵", "en": "Lightning stiffens all four legs."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我脚底空空荡荡", "en": "There's nothing under my feet."}
