{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "四条腿走起来不太对", "en": "Four legs don't move quite right."},
        {"zh": "背上多了几处硬块", "en": "Hard growths have risen on my back."},
        {"zh": "我的尾巴短了一截", "en": "My tail is shorter than it was."},
        {"zh": "我沿着原来的兽径走", "en": "I follow the old game trail."},
        {"zh": "爪子在泥里留下怪印", "en": "My claws leave strange prints in the mud."},
        {"zh": "路过那户人家时我停了一下", "en": "I pause at that old house."},
        {"zh": "门口那只碗还在", "en": "The bowl at the door is still there."},
        {"zh": "我俯身嗅了嗅", "en": "I lower my nose and sniff."},
        {"zh": "是我的名字的味道", "en": "It smells of my own name."},
        {"zh": "走开时腿更沉了", "en": "My legs feel heavier as I leave."},
        {"zh": "我绕着屋子转了一圈", "en": "I circle the house once."},
        {"zh": "爪子刮过木墙", "en": "My claws scrape the wooden wall."},
        {"zh": "走过一片高草", "en": "I cross a patch of tall grass."},
        {"zh": "草叶划过背上的硬块", "en": "The blades scrape the growths on my back."},
        {"zh": "我一点感觉都没有", "en": "I can't feel it."},
        {"zh": "又好像有点感觉", "en": "Or perhaps I can, a little."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲坐在树下", "en": "I sit under the tree."},
        {"zh": "一条后腿伸不直", "en": "One hind leg won't straighten."},
        {"zh": "我用嘴舔了舔前爪", "en": "I lick my forepaw."},
        {"zh": "舌头尝到的是苦的", "en": "My tongue finds only bitterness."},
        {"zh": "我狠狠甩了一下头", "en": "I give my head a hard shake."},
        {"zh": "背上的硬块在动", "en": "The growths on my back shift."},
        {"zh": "我回头看了看", "en": "I look back at them."},
        {"zh": "可我怎么也咬不到", "en": "I can't reach to bite them."},
        {"zh": "风里有人在味道", "en": "There's human scent in the wind."},
        {"zh": "我原来的嚎叫，现在变了调。", "en": "My old howl has changed key."},
        {"zh": "然后是我自己", "en": "Then the rest of me."},
        {"zh": "我又站了起来", "en": "I stand up."},
        {"zh": "只是站得不太稳", "en": "Not very steadily."},
        {"zh": "但我站了起来", "en": "But I stand."},
        {"zh": "以前有人叫过我的名字", "en": "Someone used to call my name."},
        {"zh": "现在记不住那个音了", "en": "I can't recall the sound now."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我仰起头看你", "en": "I raise my eyes to you."},
        {"zh": "你的味道很熟", "en": "Your scent is familiar."},
        {"zh": "我靠近了一点", "en": "I come a little closer."},
        {"zh": "并不是要咬你", "en": "Not to bite."},
        {"zh": "我只是想闻清楚", "en": "I just want to be sure."},
        {"zh": "你果真向后退了", "en": "You really did step back."},
        {"zh": "我就在原地停下", "en": "I stop right there."},
        {"zh": "低头，然后抬头", "en": "Head down, then up."},
        {"zh": "我的耳朵贴向后脑", "en": "My ears flatten against my skull."},
        {"zh": "听起来不像叫", "en": "It isn't quite a bark."},
        {"zh": "你想不起我了吗", "en": "Don't you remember me?"},
        {"zh": "我也快忘光了", "en": "I'm forgetting too."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我从喉咙里低吼", "en": "A growl rises in my throat."},
        {"zh": "声音有点沙哑", "en": "The sound is cracked."},
        {"zh": "我踉跄退开几步", "en": "I stagger back several steps."},
        {"zh": "我咬紧牙，一声不吭", "en": "I clench my teeth and make no sound."},
        {"zh": "我缓缓地坐下", "en": "I sit down slowly."},
        {"zh": "舔了舔那道伤", "en": "And lick the wound."},
        {"zh": "味道苦得厉害", "en": "It tastes bitter."},
        {"zh": "比血还要苦涩", "en": "More bitter than blood."},
        {"zh": "我再一次抬头", "en": "I raise my head once more."},
        {"zh": "眼睛里有点湿", "en": "My eyes feel wet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是块骨头吗", "en": "Is that bone?"},
        {"zh": "我的鼻子抽动", "en": "My nostrils twitch."},
        {"zh": "我的毛结成了一片硬壳", "en": "My fur has matted into a hard shell"},
        {"zh": "两条腿有点拖", "en": "My legs drag a little."},
        {"zh": "我低头把它咬走", "en": "I dip and take it."},
        {"zh": "咬在嘴里，味道不对", "en": "In my mouth, the taste is wrong."},
        {"zh": "但我还是嚼了", "en": "I chew anyway."},
        {"zh": "咽下去时喉咙发涩", "en": "It scrapes going down."},
        {"zh": "以前的肉不是这样的", "en": "Meat never used to taste like this."},
        {"zh": "我又闻了闻你的手", "en": "I sniff your hand again."},
        {"zh": "这股味道更近", "en": "That scent is closer."},
        {"zh": "像我以前吃过的东西", "en": "Like something I used to eat."},
        {"zh": "但又不太一样", "en": "But not quite."},
        {"zh": "我缩了半步回来", "en": "I shrink back half a step."},
        {"zh": "你先放着别动", "en": "Leave it for now."},
        {"zh": "我待一会儿再吃", "en": "I'll eat later."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得偏了身", "en": "The impact knocks me askew."},
        {"zh": "一条腿没撑住", "en": "One leg fails to catch me."},
        {"zh": "我侧倒在地上", "en": "I go down on my side."},
        {"zh": "爬起来花了很久", "en": "It takes a long time to rise."},
        {"zh": "背上的硬块磕在地上", "en": "The growths knock against the ground."},
        {"zh": "我把脑袋左右晃了晃", "en": "I swing my head side to side."},
        {"zh": "站稳之后才看你", "en": "Only then do I look at you."},
        {"zh": "你竟然没有走", "en": "You didn't actually leave."},
        {"zh": "那倒也够好了", "en": "That's good enough."},
        {"zh": "我朝一边挪去", "en": "I shift to one side."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "以前有个伙伴", "en": "I had a companion once."},
        {"zh": "我们一起守过院子", "en": "We guarded a yard together."},
        {"zh": "他后来不见了", "en": "Then he vanished."},
        {"zh": "我找过很多天", "en": "I searched for many days."},
        {"zh": "最后在林子边上找到一些东西", "en": "Finally found some things at the wood's edge."},
        {"zh": "我没有告诉任何人", "en": "I told no one."},
        {"zh": "现在我也这样了", "en": "Now I'm like this too."},
        {"zh": "也许他当时也这样", "en": "Maybe he was like this then."},
        {"zh": "所以我很明白", "en": "So I understand."},
        {"zh": "我一点都不怪他", "en": "I don't blame him."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用鼻尖把土拨开", "en": "I push the dirt aside with my nose."},
        {"zh": "牙关咬不太紧", "en": "My jaws won't close tightly."},
        {"zh": "我的牙关合不拢", "en": "My jaws will not close."},
        {"zh": "我找了个地方放下", "en": "I find somewhere to set it."},
        {"zh": "在地上刨了刨", "en": "I scratch at the ground."},
        {"zh": "土太硬，挖不动", "en": "The soil's too hard to dig."},
        {"zh": "我改放到树根边", "en": "I move it by the tree roots."},
        {"zh": "盖了几片叶子", "en": "Cover it with a few leaves."},
        {"zh": "以后再回来拿", "en": "I'll come back for it."},
        {"zh": "如果我还没忘", "en": "If I remember."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人从这经过", "en": "Someone's passing."},
        {"zh": "我撑起四条腿", "en": "I push up onto four legs."},
        {"zh": "背上的硬块绷紧了", "en": "The growths on my back pull tight."},
        {"zh": "喉头的声响沉了", "en": "The sound in my throat drops."},
        {"zh": "我朝那个方向走", "en": "I head that way."},
        {"zh": "那人走得不快", "en": "Not fast."},
        {"zh": "但我不会绕开", "en": "But I won't go around."},
        {"zh": "那条路我很熟", "en": "I know that path."},
        {"zh": "以前天天都走", "en": "I walked it every day."},
        {"zh": "现在也还在走", "en": "I walk it still."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着那个味道", "en": "I follow that scent."},
        {"zh": "鼻子贴着地面", "en": "Nose to the ground."},
        {"zh": "地上有旧的脚印", "en": "Old footprints in the dirt."},
        {"zh": "那不是你的印", "en": "Not yours."},
        {"zh": "是以前的我的", "en": "The ones from who I used to be."},
        {"zh": "我闻了两遍才确认", "en": "I have to smell twice to be sure."},
        {"zh": "随后继续向前走", "en": "Then walk on."},
        {"zh": "你在前面不远", "en": "You're not far ahead."},
        {"zh": "你的脚印是新的", "en": "Your footprints are fresh."},
        {"zh": "脚步一重一轻", "en": "One heavy, one light."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我只扑了一下", "en": "I lunge only once."},
        {"zh": "没扑准，撞在树上", "en": "Missed. Hit a tree."},
        {"zh": "我转身，再扑", "en": "I turn and lunge again."},
        {"zh": "牙咬在你的护腿上", "en": "My teeth find your leg guard."},
        {"zh": "可怎么也咬不穿", "en": "I can't bite through."},
        {"zh": "我甩头，把自己带倒了", "en": "I twist and pull myself over."},
        {"zh": "爬起来的时候很慢", "en": "Rising is slow."},
        {"zh": "前爪抓了你一下", "en": "A forepaw rakes you."},
        {"zh": "那纯粹是本能", "en": "That was instinct."},
        {"zh": "那不是我干的", "en": "That wasn't me."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "林子边上有个影子", "en": "A shape at the wood's edge."},
        {"zh": "它站起来的时候像条狗", "en": "It stands like a dog."},
        {"zh": "可是站得很不对", "en": "But stands wrong."},
        {"zh": "我抖了抖背上", "en": "I shake my back."},
        {"zh": "背上的硬块互相碰", "en": "The growths knock together."},
        {"zh": "我朝院子那边看", "en": "I look toward the yard."},
        {"zh": "那边有一盏灯", "en": "There's a light there."},
        {"zh": "以前我睡在灯下面", "en": "I used to sleep under that light."},
        {"zh": "现在已经不行", "en": "Not anymore."},
        {"zh": "我转身往林子里去", "en": "I turn back into the trees."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛烧焦了，味道很难闻", "en": "My fur burns and the smell is foul."}
      ]
    },
