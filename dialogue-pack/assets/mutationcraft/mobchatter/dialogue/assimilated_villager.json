{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的长袍被撑破了", "en": "My robe has been split open."},
        {"zh": "一条手臂长得不成样子", "en": "One arm has grown misshapen."},
        {"zh": "我拖着脚走，肩膀歪着", "en": "I drag my feet, shoulders crooked."},
        {"zh": "走过的地上有黏液", "en": "Slime trails where I walk."},
        {"zh": "我沿着村子外围转", "en": "I circle the edge of the village."},
        {"zh": "门口还挂着我家的帘子", "en": "My old curtain still hangs at a door."},
        {"zh": "我记不清那是谁的", "en": "I can't remember whose it was."},
        {"zh": "我还是往里走", "en": "I still go in."},
        {"zh": "脚在门槛上绊了一下", "en": "My foot catches on the threshold."},
        {"zh": "我撞开半掩的门板", "en": "I shove the half-open door aside."},
        {"zh": "墙上的手印是新的", "en": "The handprint on the wall is new."},
        {"zh": "我只好继续往前", "en": "I just keep moving."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在屋子中间", "en": "I stand in the middle of a room."},
        {"zh": "脖子歪向一边", "en": "My neck leans to one side."},
        {"zh": "喉咙里发出断断续续的声音", "en": "Broken sounds come from my throat."},
        {"zh": "像是要说什么", "en": "As if trying to say something."},
        {"zh": "可是怎么也说不出来", "en": "That never comes out."},
        {"zh": "我看着地上的碗", "en": "I look at a bowl on the floor."},
        {"zh": "我记得它装过汤", "en": "I remember it held soup."},
        {"zh": "我伸手，手指太长了", "en": "I reach, and my fingers are too long."},
        {"zh": "抓了几次才捡起来", "en": "It takes several tries to pick it up."},
        {"zh": "然后我不知道该做什么", "en": "Then I don't know what to do next."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛先动了动", "en": "My eyes move first."},
        {"zh": "你还认得我吗", "en": "Do you still recognize me?"},
        {"zh": "我迟缓地张了张嘴", "en": "I slowly open my mouth."},
        {"zh": "牙已经不像人的了", "en": "My teeth aren't human anymore."},
        {"zh": "你往后挪了一下", "en": "You edged backward."},
        {"zh": "这一点我理解", "en": "I understand."},
        {"zh": "我也退了一步", "en": "I step back too."},
        {"zh": "但你身上是活人的味道", "en": "But you smell of the living."},
        {"zh": "我的绿袍已经烂透。", "en": "My green robe has rotted through."},
        {"zh": "我的手指朝你伸了伸", "en": "My fingers reach a little way toward you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我只叫了一声", "en": "I cry out once."},
        {"zh": "声音一半像人", "en": "Half the sound is human."},
        {"zh": "一半一点都不像", "en": "Half isn't."},
        {"zh": "我一下子蹲下去", "en": "I crouch down."},
        {"zh": "死死捂着胸口", "en": "Clutching my chest."},
        {"zh": "那里还是热的", "en": "It's still warm there."},
        {"zh": "我撑着慢慢站起", "en": "I push myself upright."},
        {"zh": "谢谢你打中这里", "en": "Thanks for hitting there."},
        {"zh": "至少疼是清楚的", "en": "At least pain is clear."},
        {"zh": "别的我都分不清", "en": "Everything else, I can't tell apart."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那味道是热的", "en": "That smell is warm."},
        {"zh": "我很久没吃过热的", "en": "I haven't had anything warm in ages."},
        {"zh": "我的肚子一阵抽", "en": "My gut twists."},
        {"zh": "可那不是给我的", "en": "But that isn't meant for me."},
        {"zh": "我盯着看了很久", "en": "I stare at it for a long while."},
        {"zh": "跟着又转了回来", "en": "Then swings back again."},
        {"zh": "我的两只手都在抖", "en": "My hands are trembling."},
        {"zh": "我的手缩回袍子里", "en": "My hands pull back into my robe."},
        {"zh": "你可能不该看着这个", "en": "You probably shouldn't watch this."},
        {"zh": "但我还是饿了", "en": "But I'm still hungry."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰着了我的肩", "en": "You bumped my shoulder."},
        {"zh": "那条手臂很不舒服", "en": "That arm is very uncomfortable."},
        {"zh": "我歪着身子让开", "en": "I lean aside to make room."},
        {"zh": "脚在地上蹭了一下", "en": "My foot scuffs the floor."},
        {"zh": "那声音实在很怪", "en": "The sound is wrong."},
        {"zh": "你也听见了吧", "en": "You heard it too."},
        {"zh": "我们又各自退开", "en": "We both step away."},
        {"zh": "我靠在门框上", "en": "I lean on the doorframe."},
        {"zh": "我喘得非常厉害", "en": "I breathe very heavily."},
        {"zh": "这身东西不太听使唤", "en": "This body doesn't obey me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我记得有个屋子和一张床", "en": "I remember a house and a bed."},
        {"zh": "还有人在床边等我", "en": "And someone waiting by it."},
        {"zh": "现在那屋子空着", "en": "Now it's empty."},
        {"zh": "我也不确定那是记忆", "en": "I'm not sure that's a memory."},
        {"zh": "我在里面站了很久", "en": "I stood in there a long while."},
        {"zh": "什么都没等到", "en": "Nothing came."},
        {"zh": "我出门去找吃的", "en": "I went looking for food."},
        {"zh": "然后就这样了", "en": "And then this happened."},
        {"zh": "现在我只会走", "en": "Now all I do is walk."},
        {"zh": "走到哪儿算哪儿", "en": "Wherever that leads."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用长手指去夹", "en": "My long fingers pinch at it."},
        {"zh": "夹了三次才起来", "en": "Third time it lifts."},
        {"zh": "我看不清是什么", "en": "I can't tell what it is."},
        {"zh": "拿近了才认出来", "en": "Only close up do I know it."},
        {"zh": "我把它摆回墙根底下", "en": "I set it back down by the wall."},
        {"zh": "这应该是别人的", "en": "This probably belongs to someone."},
        {"zh": "我又拿了起来", "en": "Then I pick it up again."},
        {"zh": "不知道该不该拿", "en": "Not sure I should."},
        {"zh": "最后放进了口袋", "en": "Finally into my pocket."},
        {"zh": "口袋里已经有很多了", "en": "There's plenty in there already."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "前面有活的东西", "en": "Something alive."},
        {"zh": "我的脖子自己扭过去", "en": "My neck twists around on its own."},
        {"zh": "喉咙里的声音变了", "en": "The sound in my throat changes."},
        {"zh": "不是我自己想叫", "en": "I'm not the one making it."},
        {"zh": "那其实是病在叫", "en": "That's the disease calling."},
        {"zh": "我拖着一只脚往前", "en": "I drag one foot forward."},
        {"zh": "我根本挡不住", "en": "I can't stop it."},
        {"zh": "我的脚不听我的", "en": "My feet won't obey me."},
        {"zh": "我心里想的是别去", "en": "My mind says don't go."},
        {"zh": "但身体已经去了", "en": "But the body is already going."},
        {"zh": "我实在是对不起", "en": "I'm truly sorry."},
        {"zh": "我不知道该跟谁道歉", "en": "I don't know who I'm apologizing to."},
        {"zh": "也许是跟你说", "en": "Maybe to you."},
        {"zh": "也许跟里面那个人说", "en": "Maybe to whoever's still in me."},
        {"zh": "反正都一样了", "en": "It's all the same now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖在后面跟着", "en": "I trail after you."},
        {"zh": "我走得并不算快", "en": "I don't walk fast."},
        {"zh": "可是我停不下来", "en": "But I don't stop."},
        {"zh": "脚在地上拖出声音", "en": "My feet drag audibly."},
        {"zh": "你回头看了一眼", "en": "You glanced back."},
        {"zh": "我就此停下了", "en": "I stop right here."},
        {"zh": "你走，我又跟", "en": "You walk, and I follow."},
        {"zh": "就像以前那样", "en": "Like before."},
        {"zh": "以前我也这样等过你", "en": "I used to wait for you like this."},
        {"zh": "现在换我跟着", "en": "Now it's my turn to follow."},
        {"zh": "你千万别害怕", "en": "Please don't be afraid."},
        {"zh": "其实我自己也怕", "en": "I'm afraid too."},
        {"zh": "但我停不下来", "en": "But I can't stop."},
        {"zh": "这个身子饿了", "en": "This body is hungry."},
        {"zh": "我自己也饿了", "en": "So am I."},
        {"zh": "分不清哪个是我", "en": "I can't tell which hunger is mine."},
        {"zh": "所以只能往前走", "en": "So I can only keep walking."},
        {"zh": "一直这样往前走", "en": "On and on."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "手伸出去，抓在你肩上", "en": "My hand shoots out and grips your shoulder."},
        {"zh": "那不是我想抓的", "en": "That wasn't me wanting to grab."},
        {"zh": "我的牙咬下去了", "en": "My teeth come down."},
        {"zh": "我听见自己发出一声", "en": "I hear myself make a sound."},
        {"zh": "不是人的声音", "en": "Not a human sound."},
        {"zh": "你落下一记重击", "en": "You land a heavy blow."},
        {"zh": "我一点儿没还手", "en": "I don't strike back."},
        {"zh": "你打，我也不退", "en": "Hit me, and I still won't back off."},
        {"zh": "这只手我自己按住了", "en": "I hold this arm down myself."},
        {"zh": "另一只手不行", "en": "The other one won't listen."},
        {"zh": "你赶紧走开吧", "en": "Go away quickly."},
        {"zh": "趁我还能按住", "en": "While I can still hold it."},
        {"zh": "我的手已经不听使唤", "en": "My hand no longer obeys me."},
        {"zh": "我这是在求你", "en": "I'm begging you."},
        {"zh": "另一只手抓住你的手臂", "en": "The other hand seizes your arm."},
        {"zh": "我用牙撕下一块布", "en": "My teeth tear away a strip of cloth."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从前门走出来", "en": "I come out the front door."},
        {"zh": "门矮了，我撞了一下", "en": "The door is too low. I hit it."},
        {"zh": "我记得这道门", "en": "I remember this door."},
        {"zh": "我扶着门框站了一会", "en": "I brace on the frame a while."},
        {"zh": "屋里有股旧味", "en": "An old smell in the house."},
        {"zh": "那是我家的味道", "en": "That's the smell of my home."},
        {"zh": "可我已经不是那个人", "en": "But I'm not that person anymore."},
        {"zh": "我走到院子里", "en": "I walk into the yard."},
        {"zh": "井边的桶还倒着", "en": "A bucket lies tipped by the well."},
        {"zh": "我小时候也这么倒过", "en": "I tipped it like that as a boy."},
        {"zh": "我把它立起来", "en": "I set it upright."},
        {"zh": "然后又倒下来了", "en": "Then it falls again."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "袖子烧起来，烫得我甩手", "en": "My sleeve burns and I shake my hand."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，膝盖磕在地上", "en": "I fall and crack my knee on the ground."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进变了形的嘴", "en": "Water pours into this changed mouth."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀到墙边", "en": "The blast throws me into the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "什么东西扎进了肩", "en": "Something plunged into my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "病在身体里翻了一下", "en": "The disease turns over inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我这肚子一直空", "en": "My belly never fills."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打得我倒在地上", "en": "Lightning knocks me flat."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "院子下面空了", "en": "The yard is gone beneath me."}
      ]
    }
  }
}
