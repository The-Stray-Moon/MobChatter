{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一走，空气就变色。", "en": "The air changes color as I walk."},
        {"zh": "身上的毒气，一路飘。", "en": "My fumes trail behind me."},
        {"zh": "我不快，但很沉。", "en": "Not fast, but heavy."},
        {"zh": "每一步都像在挤什么。", "en": "Each step squeezes something out."},
        {"zh": "我的皮肤，坑坑洼洼。", "en": "My skin is pitted and uneven."},
        {"zh": "一条腿拖着，在地上划。", "en": "One leg drags and scrapes along the ground."},
        {"zh": "草丛碰到我，就枯了。", "en": "Grass withers where I brush it."},
        {"zh": "我朝活物走。", "en": "I walk toward living things."},
        {"zh": "紫色的气，从缝里出。", "en": "Purple gas leaks from my seams."},
        {"zh": "我一路走，一路留渍。", "en": "I leave stains as I go."},
        {"zh": "地上的虫，翻了过来。", "en": "Bugs on the ground flip over."},
        {"zh": "挡路的东西我不绕。", "en": "I don't go around obstacles."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，气还在冒。", "en": "I stand; the gas still rises."},
        {"zh": "身下的土，变了颜色。", "en": "The soil beneath changes color."},
        {"zh": "我在慢慢腐烂。", "en": "I'm rotting slowly."},
        {"zh": "气味很冲，我自己都闻得到。", "en": "The stench is strong, even to me."},
        {"zh": "我的手指，一节节发黑。", "en": "My fingers blacken joint by joint."},
        {"zh": "我这具身体不喘。", "en": "This body of mine doesn't breathe."},
        {"zh": "我在等什么靠过来。", "en": "I wait for something to come near."},
        {"zh": "周围没有活的东西。", "en": "Nothing living around."},
        {"zh": "毒囊鼓了一下。", "en": "My sac swells once."},
        {"zh": "我活动了一下脖子，骨节响。", "en": "I roll my neck; the joints crack."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站得够久了。", "en": "You've stood there long enough."},
        {"zh": "我身上的气，你闻到了吗？", "en": "Do you smell my fumes?"},
        {"zh": "你正在屏着气。", "en": "You're holding your breath."},
        {"zh": "我挪半步，脚下草就枯。", "en": "I shift half a step; the grass beneath me withers."},
        {"zh": "毒已经散到你脚边。", "en": "The poison reaches your feet."},
        {"zh": "这么近，你会中毒。", "en": "This close, you'll be poisoned."},
        {"zh": "我的眼睛是浑浊的。", "en": "My eyes are clouded."},
        {"zh": "你屏住了气，脸发白。", "en": "You hold your breath and your face goes pale."},
        {"zh": "手伸到一半，指尖开始滴。", "en": "Hand halfway out, my fingertips begin to drip."},
        {"zh": "千万别吸气。", "en": "Whatever you do, don't inhale."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮又裂开一块。", "en": "Another patch of my hide splits."},
        {"zh": "毒泄出来一点。", "en": "Some poison leaks out."},
        {"zh": "我不出声，只让毒更浓。", "en": "I make no sound; I only thicken the poison."},
        {"zh": "我整具身体退了半步。", "en": "My whole body gives half a step."},
        {"zh": "伤口边上，正在发绿。", "en": "The edge of the wound is turning green."},
        {"zh": "我的身体在渗。", "en": "My body is seeping."},
        {"zh": "空气更浑浊了。", "en": "The air grows murkier."},
        {"zh": "我不慌不忙地压上。", "en": "I press on without hurry."},
        {"zh": "我的动作慢了一点。", "en": "My movement slows a little."},
        {"zh": "毒囊瘪了一些。", "en": "My sac deflates a bit."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些我一样不吃。", "en": "I eat none of this."},
        {"zh": "这东西会被我污染。", "en": "That would be tainted by me."},
        {"zh": "你举着它，我靠近也没用。", "en": "Hold it out; coming closer won't help."},
        {"zh": "我只想要会喘气的。", "en": "I want only what still breathes."},
        {"zh": "我的胃口，早就坏了。", "en": "My appetite spoiled long ago."},
        {"zh": "你放下的，我不碰。", "en": "I won't touch what you set down."},
        {"zh": "这么小一块，不费我弯腰。", "en": "Too small a scrap to make me stoop."},
        {"zh": "把这些拿远。", "en": "Take these away."},
        {"zh": "我闻到的是你的呼吸。", "en": "What I smell is your breath."},
        {"zh": "这口粮你自己收好。", "en": "Keep that ration for yourself."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "碰我一下，就有味道了。", "en": "Touch me and you'll carry the smell."},
        {"zh": "你退了，但气跟过去。", "en": "You backed off; the gas followed."},
        {"zh": "我一步也没被推动。", "en": "I wasn't shifted an inch."},
        {"zh": "我的身体，软得怪。", "en": "My body is strangely soft."},
        {"zh": "你甩了两下手。", "en": "You shook your hand twice."},
        {"zh": "地上留了一片灰。", "en": "A gray patch on the ground."},
        {"zh": "这不算撞，是传染。", "en": "That wasn't a bump; it was contagion."},
        {"zh": "你的衣服上，沾了一点。", "en": "A spot of it on your clothes."},
        {"zh": "别用掌心去抹。", "en": "Don't wipe it with your palm."},
        {"zh": "我仍旧一步步往前。", "en": "I keep moving forward, step by step."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这副样子，谁要。", "en": "Who'd want me like this?"},
        {"zh": "同类之间，也不靠近。", "en": "Even kin keep apart."},
        {"zh": "毒会把我们自己也腐蚀。", "en": "The poison corrodes us too."},
        {"zh": "这种东西我不需要。", "en": "I have no need for such a thing."},
        {"zh": "这具身体，只剩腐烂。", "en": "This body is only rot now."},
        {"zh": "这件事不必提。", "en": "This needn't be mentioned."},
        {"zh": "我一个人走着。", "en": "I walk alone."},
        {"zh": "靠近我，你也会烂。", "en": "Come near me and you will rot too."},
        {"zh": "再离远一点。", "en": "Further away still."},
        {"zh": "我背过去，不再看。", "en": "I turn my back and look away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "两指捏着，手伸得很远。", "en": "Pinched between two fingers, held well away."},
        {"zh": "它在我手里开始变色。", "en": "It starts changing color in my hand."},
        {"zh": "这东西，很快就不成样子。", "en": "It won't last long."},
        {"zh": "掉地上，被我的气熏黑。", "en": "It falls and blackens."},
        {"zh": "我攥不牢这东西。", "en": "I can't hold this steady."},
        {"zh": "它一沾手，就发黑了。", "en": "It blackens the moment it touches my hand."},
        {"zh": "我把它丢到远处。", "en": "I throw it far off."},
        {"zh": "手上留了一层灰。", "en": "A film of ash on my hand."},
        {"zh": "这玩意儿有点烫。", "en": "This thing is warm."},
        {"zh": "我弯着腰蹲下去。", "en": "I bend and squat down."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有会喘气的东西。", "en": "Something that breathes."},
        {"zh": "转过来的时候，关节在响。", "en": "My joints creak as I turn around."},
        {"zh": "气先过去了。", "en": "The gas gets there first."},
        {"zh": "你已经被我看住了。", "en": "I've fixed my eye on you."},
        {"zh": "我开始走近。", "en": "I start closing in."},
        {"zh": "你吸气的时候，我听见了。", "en": "I heard you draw breath."},
        {"zh": "这地方没有风。", "en": "No wind here."},
        {"zh": "毒会留在空气里。", "en": "The poison will linger in the air."},
        {"zh": "你退得越急，吸得越多。", "en": "The faster you retreat, the more you breathe in."},
        {"zh": "我的眼白全是黄的。", "en": "The whites of my eyes are all yellow."},
        {"zh": "你脸色发青了。", "en": "Your face is turning pale."},
        {"zh": "再走近两步。", "en": "Two more steps closer."},
        {"zh": "手举高，毒从袖口滴下。", "en": "Hand raised high, poison drips from my cuff."},
        {"zh": "毒气的浓度刚好够。", "en": "The gas is just thick enough."},
        {"zh": "别屏气了，没用的。", "en": "Holding your breath won't help."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步接一步逼近。", "en": "I close in, step after step."},
        {"zh": "气在我周围绕。", "en": "The gas coils around me."},
        {"zh": "你跑的方向，我猜得到。", "en": "I can guess which way you'll run."},
        {"zh": "这走廊很窄。", "en": "This corridor is narrow."},
        {"zh": "毒在低处积着。", "en": "The poison pools low."},
        {"zh": "你开始咳了。", "en": "You've started coughing."},
        {"zh": "毒雾又往前漫了一寸。", "en": "The poison mist creeps an inch closer."},
        {"zh": "我的手指擦过墙。", "en": "My fingers brush the wall."},
        {"zh": "墙皮也变色了。", "en": "The paint discolors too."},
        {"zh": "你扶着墙走。", "en": "You're walking with a hand on the wall."},
        {"zh": "快撑不住了吧。", "en": "You can't hold on much longer."},
        {"zh": "我有的是耐心等。", "en": "I have patience enough to wait."},
        {"zh": "还差几步路。", "en": "A few steps still."},
        {"zh": "你膝盖软了。", "en": "Your knees have given."},
        {"zh": "我已经到跟前了。", "en": "I'm right here."},
        {"zh": "别再挪动半步。", "en": "Don't shift another half step."},
        {"zh": "这样反而更好。", "en": "This is better."},
        {"zh": "慢慢闭上眼。", "en": "Close your eyes slowly."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一把掐过去！", "en": "I lunge and grab!"},
        {"zh": "接触就够了。", "en": "Contact is enough."},
        {"zh": "你的皮肤开始泛紫。", "en": "Your skin turns purple."},
        {"zh": "抓痕边缘，慢慢发黑。", "en": "The edges of the scratch darken slowly."},
        {"zh": "我抓你的手腕。", "en": "I seize your wrist."},
        {"zh": "你还在拼命挣。", "en": "You're still struggling."},
        {"zh": "毒渗进去了。", "en": "The poison has seeped in."},
        {"zh": "五指划过，留下黑印。", "en": "Five fingers rake across and leave black marks."},
        {"zh": "你会站不稳。", "en": "You'll lose your footing."},
        {"zh": "这次抓向你的脖子。", "en": "This time I reach for your neck."},
        {"zh": "你的呼吸越来越细。", "en": "Your breathing thins."},
        {"zh": "这一抓够你跪地。", "en": "That grab puts you on the ground."},
        {"zh": "我压住你的手腕不放。", "en": "I pin your wrist and don't let go."},
        {"zh": "喊声该停了。", "en": "The shouting should stop."},
        {"zh": "慢慢安静下来。", "en": "Grow quiet, slowly."},
        {"zh": "就差最后一口气。", "en": "Just the last breath left."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "空气里多了一股味。", "en": "A new smell in the air."},
        {"zh": "我从雾气里走出来。", "en": "I step out of the haze."},
        {"zh": "脚下的土，先黑了。", "en": "The soil blackens first."},
        {"zh": "我从地上直起腰。", "en": "I straighten up from the ground."},
        {"zh": "这具身体，还在腐。", "en": "This body is still rotting."},
        {"zh": "周围没有活物。", "en": "Nothing living around."},
        {"zh": "毒气慢慢散开。", "en": "The gas spreads slowly."},
        {"zh": "声音那边，也有活气。", "en": "There is breath coming from the sound as well."},
        {"zh": "我咳了一声。", "en": "I cough once."},
        {"zh": "地上有我的痕迹。", "en": "My marks are on the ground."},
        {"zh": "我从雾里出来了。", "en": "I've come out of the fog."},
        {"zh": "别往这边来。", "en": "Don't come this way."},
        {"zh": "这地方，够我待一会。", "en": "This will hold me a while."},
        {"zh": "我落地时，土冒了烟。", "en": "When I set foot down, the soil smokes."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，毒气更冲。", "en": "Fire makes the fumes worse."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，身体散了一地。", "en": "I fall; my body splays out."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水冲淡了我身上的毒。", "en": "Water dilutes my poison."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我裂成几块。", "en": "The blast splits me apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿进我的身体。", "en": "Something pierces into me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量烧着我。", "en": "That force burns through me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，只是越来越烂。", "en": "I don't eat; I only rot more."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我全身发抖。", "en": "Lightning; my whole body spasms."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，毒一路散。", "en": "I fall, poison trailing."}
      ]
    }
  }
}
