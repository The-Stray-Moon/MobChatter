{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我吊着身子，一格一格挪", "en": "I hang and shift myself forward."},
        {"zh": "钩尖朝下，轻轻摆动", "en": "The hook tip points down, swaying."},
        {"zh": "我还很轻，风一吹就动", "en": "I'm still light; a breeze moves me."},
        {"zh": "我的身体像一根弯骨", "en": "My body is like a bent bone."},
        {"zh": "我攀着东西往前挪", "en": "I climb along whatever's there."},
        {"zh": "还没长成的钩子软一些", "en": "An unfinished hook is softer."},
        {"zh": "我换个抓点再往上", "en": "I change grip and climb higher."},
        {"zh": "我不落地，我吊着", "en": "I don't land; I hang."},
        {"zh": "关节会自己找到角度", "en": "My joints find their own angles."},
        {"zh": "我一路都是这么过来的", "en": "This is how I've come all along."},
        {"zh": "我拖着一点皮", "en": "A bit of skin drags with me."},
        {"zh": "钩子顶端是新的", "en": "The hook's tip is newly grown."},
        {"zh": "我试着摆得更远", "en": "I try swinging farther."},
        {"zh": "我还不够硬，得慢慢来", "en": "I'm not hard enough yet; slowly."},
        {"zh": "我贴着砖缝一点点蹭", "en": "I inch along the brick seams."},
        {"zh": "这条路我熟，别挡", "en": "I know this path; don't block it."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我吊在那里很久了", "en": "I've hung there a long time."},
        {"zh": "钩子会越长越大", "en": "The hook grows bigger over time."},
        {"zh": "我现在还只是轻型", "en": "I'm the light kind now."},
        {"zh": "精英层级从我开始", "en": "The elite tiers start with me."},
        {"zh": "我的皮肤是半透明的", "en": "My skin is translucent."},
        {"zh": "里面有什么在流动", "en": "Something flows inside."},
        {"zh": "我不需要站，我靠着", "en": "I needn't stand; I lean."},
        {"zh": "风吹得我的钩在响", "en": "Wind makes my hook ring."},
        {"zh": "我在等自己变硬", "en": "I'm waiting to harden."},
        {"zh": "下一阶段就是中型", "en": "Next stage is medium."},
        {"zh": "这具身体还太嫩", "en": "This body is still too tender."},
        {"zh": "我能感觉到骨头在生长", "en": "I feel bone growing."},
        {"zh": "顶端的弯曲越来越明显", "en": "The bend at the tip sharpens."},
        {"zh": "我没什么能给你", "en": "I have nothing to give you."},
        {"zh": "我在这里慢慢等着", "en": "I'm here, waiting slowly."},
        {"zh": "时间会把钩拉长", "en": "Time will stretch the hook."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我的钩还高", "en": "You're taller than my hook."},
        {"zh": "我看看你有没有能挂的地方", "en": "I'm seeing if you have anywhere to hook."},
        {"zh": "我这么轻，伤不了你", "en": "I'm too light to hurt you."},
        {"zh": "你身上挂着东西", "en": "You're carrying something."},
        {"zh": "那个能借我吊一下吗", "en": "May I hang from that?"},
        {"zh": "我还没长成，别急", "en": "I'm not grown yet; don't rush."},
        {"zh": "我的钩尖还是软的", "en": "My hook tip is still soft."},
        {"zh": "你退开点，我好摆动", "en": "Step back so I can swing."},
        {"zh": "你肩膀上有个地方能钩", "en": "There's a spot on your shoulder to hook."},
        {"zh": "你看着能挂住我", "en": "You look like you could hold me."},
        {"zh": "别伸手抓，会黏上", "en": "Don't grab; it's sticky."},
        {"zh": "再长一段时间就不同了", "en": "After more time, it'll be different."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的钩尖歪掉了", "en": "The hook tip bent."},
        {"zh": "我掉了半格高度", "en": "I dropped half a block."},
        {"zh": "我还太软，经不起这个", "en": "Too soft; I can't take that."},
        {"zh": "黏的东西流出来了", "en": "Sticky stuff is leaking."},
        {"zh": "我在半空摆了好久", "en": "I swayed a long time in the air."},
        {"zh": "这一下打断了我的生长", "en": "That interrupted my growth."},
        {"zh": "钩子还在，还能挂", "en": "The hook's intact; I can still hang."},
        {"zh": "我的皮裂开了", "en": "My skin split."},
        {"zh": "我慢慢收紧身子", "en": "I slowly draw myself in."},
        {"zh": "再一下，我就挂不住了", "en": "One more and I lose my grip."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "钩子不吃东西", "en": "A hook doesn't eat."},
        {"zh": "钩子是不吃东西的", "en": "Hooks don't eat."},
        {"zh": "你举着它，我够不到", "en": "You hold it; I can't reach."},
        {"zh": "我没有嘴，只有钩", "en": "I have no mouth, only a hook."},
        {"zh": "我这层皮吸不了它", "en": "This skin of mine can't absorb it."},
        {"zh": "你放低一点试试", "en": "Lower it and try."},
        {"zh": "我更想要个能挂的地方", "en": "I'd rather have somewhere to hang."},
        {"zh": "拿开，挡住我的角度", "en": "Move it; it blocks my angle."},
        {"zh": "这层皮吸不了东西", "en": "This skin can't absorb anything."},
        {"zh": "拿开，你挡着我的角度了", "en": "Move it; you're blocking my angle."},
        {"zh": "味道不错，可惜我不吃", "en": "Smells fine, but I don't eat."},
        {"zh": "我只有长大这一件事", "en": "Growing is the only thing I do."},
        {"zh": "等我长成再说", "en": "Ask again when I've grown."},
        {"zh": "这东西对我更像负担", "en": "That's more a burden to me."},
        {"zh": "你把它拿远一些", "en": "Take it further away."},
        {"zh": "别在我钩下摆来摆去", "en": "Stop waving it under my hook."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰我一下我就晃", "en": "Touch me and I sway."},
        {"zh": "我很轻，没什么分量", "en": "I'm light; I weigh little."},
        {"zh": "钩尖蹭到你的衣服", "en": "My hook tip grazed your clothes."},
        {"zh": "我吊得不太稳", "en": "My grip isn't steady."},
        {"zh": "别把我从挂点上推下来", "en": "Don't push me off my hold."},
        {"zh": "我甩了半圈才稳住", "en": "I swung half a turn and steadied."},
        {"zh": "这点碰撞我撑得住", "en": "I can take that much."},
        {"zh": "你在下面，小心钩尖", "en": "You're below; mind the hook tip."},
        {"zh": "我身上掉了点黏东西", "en": "Something sticky fell off me."},
        {"zh": "再撞我就掉下来了", "en": "Bump again and I'll drop."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "钩子不长这种东西", "en": "Hooks don't grow that."},
        {"zh": "我们只会往上长", "en": "We only grow upward."},
        {"zh": "我还实在太轻了", "en": "I'm still too light."},
        {"zh": "这种事写不进我身体里", "en": "That isn't in my body's plan."},
        {"zh": "钩子还没长直，谈不了", "en": "My hook isn't even straight yet."},
        {"zh": "等我长成中型再说", "en": "Wait until I'm medium."},
        {"zh": "你找的不是我这种", "en": "You're not looking for my kind."},
        {"zh": "我只会越挂越高", "en": "I only hang higher."},
        {"zh": "我没什么能留住谁", "en": "I have nothing to keep anyone."},
        {"zh": "你还是放开吧", "en": "Let go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有个能挂的东西", "en": "Something hangable on the ground."},
        {"zh": "我伸出钩去够", "en": "I reach down with the hook."},
        {"zh": "够不到，太远了", "en": "I can't reach; too far."},
        {"zh": "我用钩尖把它挑起", "en": "I flick it up with my hook tip."},
        {"zh": "黏在钩上就行", "en": "It sticks to the hook."},
        {"zh": "这东西太重，我吊不住", "en": "Too heavy; I can't hold it."},
        {"zh": "我把它挂在旁边", "en": "I hang it nearby."},
        {"zh": "这点分量还行", "en": "This weight is fine."},
        {"zh": "我换个挂点再拿", "en": "I shift holds, then take it."},
        {"zh": "掉下去就没了", "en": "If I drop it, it's gone."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你摆过去", "en": "I swing toward you."},
        {"zh": "钩尖对着你的方向", "en": "The hook tip points your way."},
        {"zh": "我还不够硬，但够快", "en": "Not hard enough, but quick."},
        {"zh": "借你的高度用一下", "en": "Let me use your height."},
        {"zh": "你身上有能挂的东西", "en": "There's hangable gear on you."},
        {"zh": "我只是想过去", "en": "I only want to get past."},
        {"zh": "我的钩会先碰到你", "en": "My hook touches you first."},
        {"zh": "别挥手，会缠上的", "en": "Don't wave; it tangles."},
        {"zh": "我摆得越来越远了", "en": "My swing reaches farther."},
        {"zh": "我只够得着这一次", "en": "I only get one reach like this."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一荡一荡地靠近", "en": "I swing closer, arc by arc."},
        {"zh": "钩尖就在你上方", "en": "The hook tip is above you."},
        {"zh": "我在计算落点", "en": "I'm calculating where to land."},
        {"zh": "你的肩膀正好", "en": "Your shoulder works."},
        {"zh": "我抓住就不放", "en": "Once I grip, I don't let go."},
        {"zh": "我还没长成，力气不大", "en": "I'm not grown; not strong yet."},
        {"zh": "但我身上很黏", "en": "But I'm sticky."},
        {"zh": "你抖也抖不掉", "en": "Shaking won't free you."},
        {"zh": "再荡一次就到了", "en": "One more swing and I'm there."},
        {"zh": "等我贴近你之后", "en": "Wait until I'm close."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "钩尖划了过去", "en": "The hook tip rakes past."},
        {"zh": "我整个人荡了过来", "en": "I swing in bodily."},
        {"zh": "我钩住你的衣领", "en": "I hook your collar."},
        {"zh": "黏东西沾在你身上", "en": "Sticky stuff clings to you."},
        {"zh": "钩尖只在你袖上留了道印", "en": "My hook tip just left a mark on your sleeve."},
        {"zh": "我钩住了就吊着", "en": "I'm hooked; I hang on."},
        {"zh": "你甩，我贴得更紧", "en": "You shake; I cling tighter."},
        {"zh": "我的钩还软，划不深", "en": "My hook is still soft; it won't cut deep."},
        {"zh": "但钩子会收紧", "en": "But the hook tightens."},
        {"zh": "我就自己松开", "en": "And I let go."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "钩尖先垂了下来", "en": "The hook tip lowers first."},
        {"zh": "我还很小，只有一截", "en": "I'm small, just a segment."},
        {"zh": "我是从墙缝里长出来的", "en": "I grew out of a wall seam."},
        {"zh": "精英层级的第一种", "en": "The first of the elite tiers."},
        {"zh": "我吊在这里慢慢长", "en": "I hang here and grow slowly."},
        {"zh": "空气里有股湿味", "en": "There's a damp smell."},
        {"zh": "我的皮还在渗东西", "en": "My skin is still seeping."},
        {"zh": "别碰，还没定形", "en": "Don't touch; not formed yet."},
        {"zh": "这一带够我挂", "en": "Enough here to hang from."},
        {"zh": "我先把自己挂稳", "en": "First I'll hang myself steady."}
      ]
    },
