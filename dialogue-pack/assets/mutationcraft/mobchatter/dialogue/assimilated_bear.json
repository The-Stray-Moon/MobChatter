{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着变形的四肢走。", "en": "I drag my warped limbs forward."},
        {"zh": "皮上有东西在动。", "en": "Something moves under my hide."},
        {"zh": "我一步一步靠近活物。", "en": "I close on the living step by step."},
        {"zh": "我的骨架歪向一边。", "en": "My frame leans to one side."},
        {"zh": "我不再是熊了。", "en": "I'm not a bear anymore."},
        {"zh": "我沿着墙根往里走。", "en": "I move along the wall inward."},
        {"zh": "爪子在石上刮出声。", "en": "My claws scrape the stone."},
        {"zh": "我的头低得很。", "en": "My head hangs low."},
        {"zh": "我朝村子的方向去。", "en": "I head for the village."},
        {"zh": "我走路时会停一下。", "en": "I stop for a moment as I walk."},
        {"zh": "我的呼吸很响。", "en": "My breathing is loud."},
        {"zh": "我绕开同化的同类。", "en": "I avoid others of my kind."},
        {"zh": "泥土被我踩出深坑。", "en": "My steps leave deep pits."},
        {"zh": "我一瘸一拐地赶路。", "en": "I limp along the road."},
        {"zh": "我闻到很多气味。", "en": "I smell many scents."},
        {"zh": "我朝最近的那个走。", "en": "I go toward the nearest one."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "皮底下的东西慢慢挪", "en": "Things under my hide shift slowly."},
        {"zh": "我的皮下一鼓一鼓。", "en": "Something pulses under my hide."},
        {"zh": "我等爆发的时候。", "en": "I wait for the outbreak."},
        {"zh": "我的眼睛混浊。", "en": "My eyes are clouded."},
        {"zh": "我低低地叫着。", "en": "I give a low call."},
        {"zh": "身上有东西在长。", "en": "Something is growing on me."},
        {"zh": "夜里我睁着眼数心跳", "en": "At night I stare and count my heartbeats."},
        {"zh": "我歪着头在听。", "en": "I tilt my head and listen."},
        {"zh": "村子里还有灯光。", "en": "Lights in the village."},
        {"zh": "我僵着身子不做声。", "en": "I'm doing nothing."},
        {"zh": "我慢慢咧开了嘴。", "en": "I slowly open my jaws."},
        {"zh": "我等它堆起来再动", "en": "I wait for more of it to grow."},
        {"zh": "这里还不到时候。", "en": "It's not time here."},
        {"zh": "我等这一夜过去。", "en": "I wait for this night to pass."},
        {"zh": "我闻到了同类的味。", "en": "I smell my own kind."},
        {"zh": "又有一个被同化了。", "en": "Another one gone."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也是被同化的？", "en": "Are you assimilated too?"},
        {"zh": "你身上还是暖的。", "en": "You're still warm."},
        {"zh": "我要把你变成我们。", "en": "I'll make you one of us."},
        {"zh": "你是跑不掉的。", "en": "You can't get away."},
        {"zh": "这具身体不再属于熊。", "en": "This body isn't a bear's anymore."},
        {"zh": "我闻得到你的病。", "en": "I can smell the sickness in you."},
        {"zh": "你迟早会变成这样。", "en": "You'll end up like this."},
        {"zh": "我的皮已经不完全是我的了。", "en": "My hide isn't fully mine."},
        {"zh": "你看看我的爪子。", "en": "Look at my claws."},
        {"zh": "别害怕，会很快。", "en": "Don't be afraid; it's quick."},
        {"zh": "你也听见那些声音了吗？", "en": "Do you hear those sounds too?"},
        {"zh": "你跟我一样走一趟吧。", "en": "Come with us."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮被撕开了。", "en": "My hide is torn."},
        {"zh": "一块旧皮落在地上", "en": "A strip of old hide drops away."},
        {"zh": "我喉咙里挤出一点声音", "en": "A little sound squeezes out of my throat."},
        {"zh": "我歪着身子退半步。", "en": "I gave half a step."},
        {"zh": "血是黑的，流得也慢", "en": "The blood's black and slow."},
        {"zh": "伤口马上又鼓了起来", "en": "The wound swells shut again at once."},
        {"zh": "流出来的血是黑的。", "en": "The blood is black."},
        {"zh": "我歪了歪，又站直。", "en": "I lurched, then straightened."},
        {"zh": "我会把你的味道记住。", "en": "I'll remember your scent."},
        {"zh": "你再来一次吧。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些烂掉的东西我不吃。", "en": "I don't eat that."},
        {"zh": "会喘气的才值得咬一口", "en": "Only something breathing is worth a bite."},
        {"zh": "你把手放下来。", "en": "Put your hands down."},
        {"zh": "这东西已经烂了。", "en": "This is already rotten."},
        {"zh": "你的手再往下递一点", "en": "Bring your hand a little lower."},
        {"zh": "你还留着这些做什么？", "en": "Why keep such things?"},
        {"zh": "把这玩意儿拿远点。", "en": "Take it away."},
        {"zh": "这味道不够新鲜", "en": "This scent is not fresh enough."},
        {"zh": "这点东西只够塞牙缝", "en": "That much won't fill a tooth gap."},
        {"zh": "我更喜欢会跑的。", "en": "I prefer things that run."},
        {"zh": "赶快把它放下。", "en": "Put it down."},
        {"zh": "你吃吧，吃完就是我们的。", "en": "Eat it; then you're ours."},
        {"zh": "饥饿对我没什么感觉。", "en": "I'm not hungry."},
        {"zh": "这血腥味太淡了。", "en": "The smell is too faint."},
        {"zh": "我不会碰这个。", "en": "I won't touch it."},
        {"zh": "这坨东西你留着喂自己", "en": "Keep that to feed yourself."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我变形的肩上。", "en": "You struck my warped shoulder."},
        {"zh": "我站在原地，只有皮在动", "en": "I stay put; only my hide moves."},
        {"zh": "我身上有东西蹭到你。", "en": "Something on me rubbed against you."},
        {"zh": "别挨上我这层皮。", "en": "Don't press so close."},
        {"zh": "我这张皮很硬。", "en": "My hide is hard."},
        {"zh": "这一下没妨碍我。", "en": "That didn't hinder me."},
        {"zh": "你的手碰到我，缩得很快", "en": "You touch me and snatch your hand back."},
        {"zh": "我歪了一下又站稳。", "en": "I lurched and steadied."},
        {"zh": "你再撞也推不动我。", "en": "Come again; I'll hold."},
        {"zh": "你在我的必经之路上。", "en": "You're in my path."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这里一粒孢子就够", "en": "One spore is enough here."},
        {"zh": "我们靠感染延续。", "en": "We spread by infection."},
        {"zh": "这具身体已经没用了。", "en": "This body is of no use for that."},
        {"zh": "你很快也会变。", "en": "You'll change soon too."},
        {"zh": "用不着这些东西。", "en": "That isn't needed."},
        {"zh": "等爆发过去再说。", "en": "After the outbreak passes."},
        {"zh": "熊的事，我记不清了", "en": "Being a bear — I barely recall it."},
        {"zh": "你给我让开到一边。", "en": "Move away."},
        {"zh": "我只想多一个同类。", "en": "I only want one more of us."},
        {"zh": "你也会一样的。", "en": "You'll be the same."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用爪子挑起来。", "en": "I hook it up with a claw."},
        {"zh": "这块肉是什么来头？", "en": "What is this?"},
        {"zh": "这绝不是新鲜的肉。", "en": "Not meat."},
        {"zh": "我闻了闻就放下。", "en": "I sniff and set it down."},
        {"zh": "它沉得我拖不动。", "en": "Too heavy."},
        {"zh": "它沾上了我的东西。", "en": "It's stained by what's on me."},
        {"zh": "这玩意儿填不饱我。", "en": "Useless."},
        {"zh": "我用爪子把它扫开", "en": "I sweep it aside with a paw."},
        {"zh": "你把它拣回去收着。", "en": "You take it."},
        {"zh": "我不需要这东西。", "en": "I don't need it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有暖的东西在往这边来", "en": "Something warm is coming this way."},
        {"zh": "我把歪掉的脑袋抬起。", "en": "I raise my head."},
        {"zh": "我皮下的东西在动。", "en": "My hide is moving."},
        {"zh": "它身上的热气我闻得到。", "en": "I smell the heat on it."},
        {"zh": "我要先把它的腿咬住。", "en": "First I'll take its legs."},
        {"zh": "再近就该它闻见我了", "en": "Any closer and it will smell me."},
        {"zh": "歪掉的脑袋先转了过去", "en": "My crooked head turns first."},
        {"zh": "它还没察觉到。", "en": "It hasn't noticed."},
        {"zh": "我先迈那只变形的腿", "en": "I lead with the warped leg."},
        {"zh": "你别回头去看。", "en": "Don't look back."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它跑不快的，我闻得到", "en": "It can't outrun me; I can smell it."},
        {"zh": "它走得比我快。", "en": "It's faster than me."},
        {"zh": "可我的腿不会停。", "en": "But I won't stop."},
        {"zh": "我的叫声让它回头。", "en": "My cry makes it turn."},
        {"zh": "它的腿在打颤，我闻到了", "en": "Its legs tremble; I can smell it."},
        {"zh": "爪子抠着地面，往前刮", "en": "My claws rake the ground as I advance."},
        {"zh": "它靠着墙边走。", "en": "It's walking along the wall."},
        {"zh": "再靠近我一步。", "en": "One more step."},
        {"zh": "我闻到了恐惧。", "en": "I smell fear."},
        {"zh": "它在寻找退路。", "en": "It's looking for a way out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "爪子把它按进泥里", "en": "My paw drives it into the mud."},
        {"zh": "我的牙咬进它的肩。", "en": "My teeth sink into its shoulder."},
        {"zh": "它被我撞到墙上。", "en": "I slam it into the wall."},
        {"zh": "我死死压住它。", "en": "I pin it down."},
        {"zh": "骨节错开，又自己接上", "en": "My joints slip and click back."},
        {"zh": "它挣脱了一只手臂。", "en": "It freed one arm."},
        {"zh": "我压上去，牙往深处搅", "en": "I press down and grind my teeth deeper."},
        {"zh": "血沾在我的皮上。", "en": "Blood smears my hide."},
        {"zh": "这东西要变了。", "en": "This one is about to turn."},
        {"zh": "再坚持一小会儿。", "en": "Just a little longer."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从墙后走出来。", "en": "I come out from behind the wall."},
        {"zh": "这具身体刚刚变形。", "en": "This body has only just changed."},
        {"zh": "我的四肢还不太听话。", "en": "My limbs don't quite obey."},
        {"zh": "空气里全是活人的味。", "en": "Living scent in the air."},
        {"zh": "我听见村子里有人。", "en": "I hear people in the village."},
        {"zh": "我的关节一节一节响起来", "en": "My joints crack as I rise."},
        {"zh": "皮上有东西在爬。", "en": "Things crawl on my hide."},
        {"zh": "我扭头看了看自己。", "en": "I twist to look at myself."},
        {"zh": "我已经不是熊了。", "en": "I'm no longer a bear."},
        {"zh": "村子里那点灯光还亮着", "en": "The village lights are still on."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的皮烤得卷起来。", "en": "Fire curled my hide."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处摔下来，骨头错位。", "en": "I fell from height and my bones shifted."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我变形的肺。", "en": "Water fills my warped lungs."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我半边身子掀开。", "en": "The blast tore half my body open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "肩上一根东西，我拔了半截", "en": "Something's in my shoulder; I pull it halfway out."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我皮下的东西乱动。", "en": "That force set everything under my hide writhing."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿，但饿不死了。", "en": "I'm hungry, but can no longer starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的皮爬过去。", "en": "Lightning passed through me; I locked up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的地全空了。", "en": "All the ground fell away."}
      ]
    }
  }
}
