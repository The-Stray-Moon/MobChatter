      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这招和我的像", "en": "That's like one of mine."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就不知道该吃什么", "en": "I stopped knowing what to eat long ago."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，瓶子全亮了", "en": "Lightning strikes and all my bottles light up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "锅下面的地空了", "en": "The ground under the cauldron is gone."}
      ]
    }
  }
