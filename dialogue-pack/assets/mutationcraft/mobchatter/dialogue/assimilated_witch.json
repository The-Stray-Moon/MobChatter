{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "药瓶在腰间叮当响", "en": "My bottles clink at my waist."},
        {"zh": "长袍下摆烧焦了一块", "en": "A patch of my robe hem is burnt."},
        {"zh": "我绕着林子里的小屋走", "en": "I circle the hut in the woods."},
        {"zh": "烟囱里早就不冒烟了", "en": "The chimney hasn't smoked in a while."},
        {"zh": "我踩着自己的影子", "en": "I walk over my own shadow."},
        {"zh": "手里的瓶子拿歪了", "en": "My bottle tilts in my grip."},
        {"zh": "里面的东西已经不流了", "en": "What's inside no longer flows."},
        {"zh": "我晃了晃，没用", "en": "I shake it. Nothing."},
        {"zh": "我把它扔进灌木", "en": "I toss it into the bushes."},
        {"zh": "然后又捡回来", "en": "Then pick it up again."},
        {"zh": "我数着步子走到井边", "en": "I count my steps to the well."},
        {"zh": "脚下踩过一片蘑菇", "en": "I step through a patch of mushrooms."},
        {"zh": "它们立刻黑了", "en": "They blacken at once."},
        {"zh": "我数着走多少步到井边", "en": "I count the steps to the well."},
        {"zh": "数到一半就忘了", "en": "Lose count halfway."},
        {"zh": "只好重新开始数", "en": "Start over."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在锅前面", "en": "I crouch before the cauldron."},
        {"zh": "锅底已经没有火了", "en": "There's no fire under it anymore."},
        {"zh": "我还在往里扔东西", "en": "I still throw things in."},
        {"zh": "我扔下一片叶", "en": "A leaf."},
        {"zh": "再扔一块骨头", "en": "A bone."},
        {"zh": "锅底还是冷冰冰的", "en": "The bottom of the cauldron stays cold."},
        {"zh": "我又等了一会", "en": "I wait a while longer."},
        {"zh": "锅里还是没有", "en": "Still nothing."},
        {"zh": "我把手伸进锅里", "en": "I put my hand in the pot."},
        {"zh": "下面的水是凉的", "en": "The water at the bottom is cold."},
        {"zh": "我慢慢抽回来", "en": "I pull it out slowly."},
        {"zh": "我的手指变黑了", "en": "My fingers have gone black."},
        {"zh": "我盯着它们看", "en": "I look at them."},
        {"zh": "没有别的反应", "en": "Nothing else happens."},
        {"zh": "我把帽子往上推了推", "en": "I push my hat up."},
        {"zh": "帽檐下面还是一样暗", "en": "It's just as dark under the brim."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬头，帽檐下面很暗", "en": "I look up. It's dark under my brim."},
        {"zh": "帽子下面我看得很清", "en": "Under my hat I see quite clearly."},
        {"zh": "我闻得到你身上的东西", "en": "I can smell everything on you."},
        {"zh": "有一些还能用", "en": "Some of it is useful."},
        {"zh": "有一些就不行", "en": "Some isn't."},
        {"zh": "我把手伸出来", "en": "I hold out my hand."},
        {"zh": "手心全是黑的", "en": "My palm is black."},
        {"zh": "你一下退开了", "en": "You pull back."},
        {"zh": "这么做也很对", "en": "That's sensible too."},
        {"zh": "同化的手，又垂回身侧。", "en": "The assimilated hand drops back to my side."},
        {"zh": "我们隔远点说话", "en": "Let's talk from a distance."},
        {"zh": "我听得非常清", "en": "I can hear very well."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退开一小步", "en": "I step back a short pace."},
        {"zh": "瓶子又碎了一个", "en": "Another bottle breaks."},
        {"zh": "我摸了摸伤口", "en": "I touch the wound."},
        {"zh": "手指立刻变黑了", "en": "My fingers blacken at once."},
        {"zh": "我抬起手端详", "en": "I raise my hand to examine it."},
        {"zh": "然后就不看了", "en": "Then stop looking."},
        {"zh": "这点疼不算什么", "en": "This much pain is nothing."},
        {"zh": "我熬过更糟的", "en": "I've brewed worse."},
        {"zh": "我慢慢抬起头，锅在冒泡。", "en": "I lift my head slowly; the cauldron bubbles."},
        {"zh": "帽子已经歪了", "en": "My hat has gone crooked."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西能用上", "en": "This can be used."},
        {"zh": "我举起来对着光", "en": "I hold it to the light."},
        {"zh": "光一点也透不过", "en": "Light won't pass."},
        {"zh": "那就更好了呀", "en": "Even better than that."},
        {"zh": "我往锅里扔了一半", "en": "I drop half in the pot."},
        {"zh": "另一半收起来", "en": "The other half I keep."},
        {"zh": "你会不会想要回去", "en": "Will you want it back?"},
        {"zh": "已经在我手里了", "en": "It's already in my hand."},
        {"zh": "我咧嘴笑了一下", "en": "I bare a grin."},
        {"zh": "只是笑得不太像", "en": "It doesn't look like one."},
        {"zh": "我又凑近闻了闻", "en": "I sniff it closer."},
        {"zh": "这味道该扔进锅里", "en": "This belongs in my cauldron."},
        {"zh": "锅里该放这个", "en": "This belongs in the cauldron."},
        {"zh": "你也别想拿回去", "en": "And don't think you're getting it back."},
        {"zh": "我给它留个记号", "en": "I mark it with a scratch."},
        {"zh": "免得混在一起", "en": "So it doesn't get mixed up."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的瓶子撞响了", "en": "My bottles knock together."},
        {"zh": "有一瓶摔碎了", "en": "One breaks."},
        {"zh": "里面的东西冒了烟", "en": "What's inside smokes."},
        {"zh": "我向后退开些", "en": "I draw back a little."},
        {"zh": "烟散得非常快", "en": "The smoke clears fast."},
        {"zh": "地上的草枯了一圈", "en": "A ring of grass withers."},
        {"zh": "我低头打量了一下", "en": "I look it over."},
        {"zh": "瓶子里冒出的烟有毒", "en": "The smoke from the bottle is poisonous."},
        {"zh": "往前走一步，突变在催。", "en": "One step forward. The mutation pushes."},
        {"zh": "可不是冲你去的", "en": "But not toward you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "以前有过一个", "en": "There was one."},
        {"zh": "我们一起熬过东西", "en": "We brewed things together."},
        {"zh": "她比我厉害得多", "en": "She was far better than me."},
        {"zh": "后来她被自己的药害了", "en": "Then her own draught took her."},
        {"zh": "我把那锅埋了", "en": "I buried that cauldron."},
        {"zh": "现在这口是新挖出来的", "en": "This one is newly dug up."},
        {"zh": "我照着她的方子做", "en": "I follow her recipes."},
        {"zh": "没有一次成功", "en": "Not one has worked."},
        {"zh": "也许我记错了", "en": "Maybe I remember them wrong."},
        {"zh": "也许我故意记错", "en": "Maybe I got them wrong on purpose."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的药水瓶里，现在是突变液。", "en": "My bottles hold mutation fluid now."},
        {"zh": "手指绕了两下才抓住", "en": "It takes two tries to grip."},
        {"zh": "我放进围裙口袋", "en": "I tuck it in my apron."},
        {"zh": "里面已经有很多了", "en": "There's plenty in there."},
        {"zh": "里面有东西在动", "en": "Something moves in there."},
        {"zh": "我一把按住口袋", "en": "I press the pocket flat."},
        {"zh": "它这才安静下来", "en": "It quiets down."},
        {"zh": "那就很不错了", "en": "Good enough."},
        {"zh": "我接着往深处找", "en": "I keep searching deeper."},
        {"zh": "那就还差一样", "en": "Still one thing short."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠近我的锅了", "en": "You've come near my cauldron."},
        {"zh": "我转身，很快", "en": "I turn fast."},
        {"zh": "帽子掉了也没管", "en": "My hat falls and I don't care."},
        {"zh": "手已经抬起来", "en": "My hand is already up."},
        {"zh": "掌心里翻着黑色的东西", "en": "Black stuff churns in my palm."},
        {"zh": "那并不是药水", "en": "Not a potion."},
        {"zh": "是些别的东西", "en": "Something else entirely."},
        {"zh": "我很久没这样了", "en": "It's been a while since I did this."},
        {"zh": "我一步步走向你", "en": "I walk toward you step by step."},
        {"zh": "我的帽子歪了，管不了", "en": "My hat is askew, and I don't care."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我围着你转圈", "en": "I circle you."},
        {"zh": "手里一直在动", "en": "My hand keeps working."},
        {"zh": "有东西从指缝漏下去", "en": "Something drips between my fingers."},
        {"zh": "落在地上就冒烟", "en": "It smokes where it lands."},
        {"zh": "地上多了一串黑点", "en": "A trail of black spots."},
        {"zh": "我的锅里已经没有药了。", "en": "Nothing left in my cauldron."},
        {"zh": "听不清楚的词", "en": "Words you can't make out."},
        {"zh": "你踩到黑点上了", "en": "You stepped on one."},
        {"zh": "你的鞋底会烂", "en": "Your sole will rot."},
        {"zh": "不过并不致命", "en": "Not fatal, though."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把手一挥动", "en": "I sweep my hand."},
        {"zh": "黑色的东西泼出去", "en": "Black stuff flies out."},
        {"zh": "有几滴溅到你身上", "en": "A few drops land on you."},
        {"zh": "布料立刻烂了", "en": "The cloth rots immediately."},
        {"zh": "我另一只手也抬起来", "en": "My other hand comes up too."},
        {"zh": "你朝我挥了一下", "en": "You swung at me."},
        {"zh": "瓶子碎了一地", "en": "Bottles shatter everywhere."},
        {"zh": "烟把我们都罩住了", "en": "Smoke covers us both."},
        {"zh": "我低低咳了两下", "en": "I cough twice."},
        {"zh": "这烟对我也不好", "en": "The smoke isn't good for me either."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "小屋的门被推开了", "en": "The hut's door swings open."},
        {"zh": "我就站在门里", "en": "I stand inside."},
        {"zh": "屋里全是旧药味", "en": "The room reeks of old potions."},
        {"zh": "锅还是那口锅", "en": "The cauldron is still there."},
        {"zh": "我走过去摸了摸锅沿", "en": "I go and touch its rim."},
        {"zh": "锅底已经完全凉", "en": "The pot is cold."},
        {"zh": "我往底下塞了几根柴", "en": "I stuff kindling underneath."},
        {"zh": "怎么也点不着", "en": "It won't light."},
        {"zh": "我把柴往里推了推", "en": "I push the firewood in a little further."},
        {"zh": "试了几次还是不行", "en": "Still no luck."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "袖子着火，我拍灭了", "en": "My sleeve catches fire and I beat it out."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时膝盖响了一下", "en": "My knee clicks as I land."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进口，味道很怪", "en": "Water floods my mouth. Wrong taste."}
      ]
