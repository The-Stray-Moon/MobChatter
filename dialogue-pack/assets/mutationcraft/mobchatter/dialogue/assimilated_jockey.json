{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我和坐骑一起挪动", "en": "I move with my mount beneath me."},
        {"zh": "我的腿垂在两侧", "en": "My legs hang down both sides."},
        {"zh": "我们朝你那边去", "en": "We head your way."},
        {"zh": "皮肉已经长在一起了", "en": "Our flesh has grown together."},
        {"zh": "两条腿是它的,不是我的", "en": "Those legs are its, not mine."},
        {"zh": "我抓着它的背", "en": "I grip its back."},
        {"zh": "我的头歪着,像断了", "en": "My head tilts as if broken."},
        {"zh": "我们一起拐过一个弯", "en": "We round a corner together."},
        {"zh": "骨节在皮下拉扯", "en": "Joints tug under the skin."},
        {"zh": "我没有自己的方向", "en": "I have no direction of my own."},
        {"zh": "我们挤过一道门", "en": "We squeeze through a doorway."},
        {"zh": "被同化的东西不会累", "en": "Assimilated things do not tire."},
        {"zh": "我的手在它背上留下印子", "en": "My hands leave marks on its back."},
        {"zh": "每一步都是两个人的重量", "en": "Every step carries two bodies' weight."},
        {"zh": "我叫不出声音", "en": "I cannot make a voice."},
        {"zh": "我们一起朝那里去", "en": "We go there together."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在它背上,不动", "en": "I lie still on its back."},
        {"zh": "我们像一件东西", "en": "We look like one thing."},
        {"zh": "我的呼吸和它的对不上", "en": "My breathing does not match its."},
        {"zh": "皮下的东西在缓缓动", "en": "Something moves slowly beneath the skin."},
        {"zh": "我们都静止着", "en": "Both of us are still."},
        {"zh": "我的手指扣着它的肋", "en": "My fingers dig into its ribs."},
        {"zh": "它在等我,我也在等它", "en": "It waits for me; I wait for it."},
        {"zh": "我们分不开了", "en": "We cannot be separated."},
        {"zh": "我的眼睛闭不上", "en": "My eyes will not close."},
        {"zh": "我的身体在发热", "en": "My body is running hot."},
        {"zh": "这具身体已经不属于我了", "en": "This body is no longer mine."},
        {"zh": "我们一起喘着", "en": "We breathe together."},
        {"zh": "有东西在我们之间流动", "en": "Something flows between us."},
        {"zh": "我数着它的心跳", "en": "I count its heartbeat."},
        {"zh": "我试着动一条腿", "en": "I try to move one leg."},
        {"zh": "它跟着我一起动", "en": "It moves along with me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "骑手和我，四只眼一起转。", "en": "Rider and I — four eyes turn at once."},
        {"zh": "我骑在它身上,看着你", "en": "I watch you from its back."},
        {"zh": "你有两个影子,我们只有一个", "en": "You cast two shadows; we cast one."},
        {"zh": "我的头低下来", "en": "My head drops."},
        {"zh": "爆发计时器一跳，我就变强。", "en": "Every outbreak tick makes me stronger."},
        {"zh": "我们跟着退了一步", "en": "We took one step too."},
        {"zh": "我不知道我原来是谁", "en": "I do not know who I used to be."},
        {"zh": "我身上有它的味道", "en": "I carry its smell."},
        {"zh": "我的手抬起来,不是我的意思", "en": "My hand rose, not by my will."},
        {"zh": "你站得还算稳", "en": "You stand fairly steady."},
        {"zh": "我们不会站着看太久", "en": "We will not watch for long."},
        {"zh": "我们俩都没说话", "en": "Neither of us speaks."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我们两个都疼", "en": "Both of us feel that."},
        {"zh": "连接的地方撕了一下", "en": "The joined flesh has torn."},
        {"zh": "我的手抖了一下", "en": "My hand shook once."},
        {"zh": "它退了半步,我也跟着", "en": "It stepped back, and I with it."},
        {"zh": "血在我们之间流", "en": "Blood runs between us."},
        {"zh": "我的骑手在我背上抽了一下。", "en": "My rider lashes once across my back."},
        {"zh": "我们调整了一下位置", "en": "We shift our position."},
        {"zh": "这点伤还能动", "en": "We can still move."},
        {"zh": "别碰我们连着的地方", "en": "Do not touch where we are joined."},
        {"zh": "我们会一起倒", "en": "We will fall together."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那个味道很重", "en": "That smell is strong."},
        {"zh": "我们同时偏了头", "en": "We both turned our heads."},
        {"zh": "我朝下面伸出手", "en": "I reach down."},
        {"zh": "它有它的想法", "en": "It has its own intentions."},
        {"zh": "我们两个都没吃东西", "en": "Neither of us has eaten."},
        {"zh": "这点不够两个人分", "en": "Not enough for two."},
        {"zh": "我的手指动得很快", "en": "My fingers move quickly."},
        {"zh": "我们都靠近了些", "en": "We both came closer."},
        {"zh": "手举高些，我够得着。", "en": "Hand up a bit. I can reach."},
        {"zh": "它先闻到,我才闻到", "en": "It smelled it first; then I did."},
        {"zh": "我们的手同时伸出来", "en": "Our hands reach out at once."},
        {"zh": "它的嘴张开了", "en": "Its mouth has opened."},
        {"zh": "我真饿,它也饿", "en": "I am hungry; so is it."},
        {"zh": "你扔下来,我们自己接", "en": "Drop it; we will catch it."},
        {"zh": "这点东西撑不住两个身体", "en": "This cannot hold two bodies."},
        {"zh": "我们靠得更近了", "en": "We have come nearer."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们撞在一起,都退开了", "en": "We collide and both recoil."},
        {"zh": "我的腿被夹了一下", "en": "My leg is pinched between us."},
        {"zh": "它比我结实得多", "en": "It is far sturdier than I am."},
        {"zh": "我们俩一起晃", "en": "We sway together."},
        {"zh": "我的手撑在地上", "en": "My hand braces on the ground."},
        {"zh": "你撞在它身上", "en": "You hit it."},
        {"zh": "我差点掉下来", "en": "I nearly fell off."},
        {"zh": "我们重新贴紧了", "en": "We pressed close again."},
        {"zh": "这一下让我疼", "en": "That hurt me."},
        {"zh": "别碰我们连接的地方", "en": "Do not touch where we join."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们连这种关系都分不清", "en": "We cannot even tell what this is."},
        {"zh": "我只知道我们分不开", "en": "I only know we cannot part."},
        {"zh": "它在我下面,我在它上面", "en": "It is beneath me; I am above."},
        {"zh": "我们共用一副心跳", "en": "We share one heartbeat."},
        {"zh": "这不算亲近,也不算远", "en": "This is neither close nor far."},
        {"zh": "你别靠得太近", "en": "Do not come too near."},
        {"zh": "我们再安静一会儿", "en": "Let us be quiet a while."},
        {"zh": "我记不得从前了", "en": "I cannot recall before."},
        {"zh": "但现在这样也活着", "en": "But this is a kind of living."},
        {"zh": "我们就这么待着", "en": "We stay like this."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯下身去拿", "en": "I bend down to take it."},
        {"zh": "它把重心偏了一下", "en": "It shifted its weight."},
        {"zh": "我的手抓了两次", "en": "I grab twice."},
        {"zh": "我已经拿到了", "en": "I have got it."},
        {"zh": "我含在嘴里带回去", "en": "I carry it in my mouth."},
        {"zh": "它也想伸爪拿", "en": "It wants to take it too."},
        {"zh": "我们为这个扭动了一下", "en": "We twist over it."},
        {"zh": "这东西有血味", "en": "This smells of blood."},
        {"zh": "我把它塞进缝里", "en": "I stuff it into a seam."},
        {"zh": "留着,总会用到", "en": "Keep it; it will be needed."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我们同时看见你了", "en": "We saw you at the same instant."},
        {"zh": "两双眼睛都对着你", "en": "Two pairs of eyes are on you."},
        {"zh": "我抓着它的背,它开始动", "en": "I grip its back, and it starts to move."},
        {"zh": "我们是一个目标,也是一个猎手", "en": "We are one target and one hunter."},
        {"zh": "你跑不过我们的四条腿", "en": "You cannot outrun our four legs."},
        {"zh": "我的手已经伸到你前面", "en": "My hand is already before you."},
        {"zh": "我们没有犹豫", "en": "We do not hesitate."},
        {"zh": "这一下是两个人一起的", "en": "This is both of us together."},
        {"zh": "你站在我们的正前方", "en": "You stand directly ahead of us."},
        {"zh": "我们锁定你了", "en": "We have you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们跟着你的方向转", "en": "We turn with your direction."},
        {"zh": "你绕到侧面,我们也侧过去", "en": "You go to the flank; so do we."},
        {"zh": "我们的影子只有一个", "en": "Our shadow is a single one."},
        {"zh": "它快,我也跟得上", "en": "It is quick, and I keep up."},
        {"zh": "你回头看,会看到两个头", "en": "Look back and you will see two heads."},
        {"zh": "我压低身体贴着它的背", "en": "I flatten against its back."},
        {"zh": "脚步乱了，骑手要下来。", "en": "Your steps faltered — the rider's coming off."},
        {"zh": "我们两个都不喘", "en": "Neither of us pants."},
        {"zh": "只剩最后几步路", "en": "Only the last few steps remain."},
        {"zh": "这次不会让你空手走", "en": "This time you will not leave empty-handed."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手先抓到你", "en": "My hand catches you first."},
        {"zh": "它跟着撞上来", "en": "It slams into you after."},
        {"zh": "两下几乎同时", "en": "Both blows land almost together."},
        {"zh": "你被压在地上", "en": "You are pressed to the ground."},
        {"zh": "我的指甲陷进去", "en": "My nails dig in."},
        {"zh": "它咬着你的腿", "en": "It bites your leg."},
        {"zh": "我甩头,把皮撕开", "en": "I twist my head and tear skin."},
        {"zh": "我们退开,重整姿势", "en": "We pull back and reset."},
        {"zh": "我没有停手的打算", "en": "I do not intend to stop."},
        {"zh": "这一下我们意见一致", "en": "On this, we agree."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我们两个一起站起来", "en": "We both rise together."},
        {"zh": "它们本来就长在一起", "en": "They grew together already."},
        {"zh": "我伏在它背上", "en": "I settle on its back."},
        {"zh": "两双眼同时睁开", "en": "Two pairs of eyes open at once."},
        {"zh": "它先站直,我才稳住", "en": "It straightened, and then I steadied."},
        {"zh": "我们的影子合在一处", "en": "Our shadows have merged."},
        {"zh": "它发出一点声音", "en": "It makes a small sound."},
        {"zh": "没有谁是主人", "en": "Neither of us is the master."},
        {"zh": "我们一起过去", "en": "We go together."},
        {"zh": "你最好先走开", "en": "You had better step aside first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "皮烧起来,味道很冲", "en": "Our flesh burns with a sharp smell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一起摔下去", "en": "We fall together."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我们之间的缝进去", "en": "Water enters the seam between us."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我们掀散了一点", "en": "The blast loosens our joining."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我们之间", "en": "An arrow lodges between us."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让连接处发麻", "en": "That force numbs where we join."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "两个身体一起饿", "en": "Two bodies starving at once."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷穿过我们两个", "en": "Lightning passes through us both."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面没有地面能撑住我们", "en": "There is no ground to hold us."}
      ]
    }
  }
}
