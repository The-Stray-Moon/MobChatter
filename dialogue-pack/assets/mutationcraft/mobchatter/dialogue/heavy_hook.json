{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "钩子垂着，一路刮地。", "en": "My hooks hang low and scrape as I go."},
        {"zh": "肉长到骨头外面了。", "en": "The flesh has grown over the bone."},
        {"zh": "我一落脚，泥就陷下去。", "en": "The mud sinks under each of my steps."},
        {"zh": "我走过的地方，土都翻起来。", "en": "The soil turns over wherever I pass."},
        {"zh": "我抬脚，整片草都压平。", "en": "I lift a foot, and the grass lies flat."},
        {"zh": "每抬一次脚，都得拽出泥。", "en": "Every foot I lift pulls free of the mud."},
        {"zh": "哪边响，我就往哪边去。", "en": "Wherever it rattles, I head there."},
        {"zh": "我撞开了一段矮墙。", "en": "I break through a low wall."},
        {"zh": "我吐气，草叶都打卷。", "en": "My breath steams, and the grass curls."},
        {"zh": "我停下，把钩子提起。", "en": "I stop and raise my hooks."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的影子就够把你盖住。", "en": "My shadow alone would cover you."},
        {"zh": "钩尖滴着东西。", "en": "Something drips from my hooks."},
        {"zh": "我的背一直在起伏。", "en": "My back never stops heaving."},
        {"zh": "我还没长到头。", "en": "I have not finished growing."},
        {"zh": "我的骨节一节节响过去。", "en": "My joints crack one after another."},
        {"zh": "身上有旧伤口。", "en": "There are old wounds on me."},
        {"zh": "我等着，看谁先挪脚。", "en": "I wait to see who shifts first."},
        {"zh": "我低低地喘。", "en": "I breathe low."},
        {"zh": "我抬起一只钩子看了看。", "en": "I raise a hook and look at it."},
        {"zh": "这院子太小了。", "en": "This yard is too small."},
        {"zh": "我记得自己小的时候。", "en": "I remember when I was smaller."},
        {"zh": "我脚下的地塌了一点。", "en": "The ground sags under me."},
        {"zh": "我把头扭过去。", "en": "I wrench my head aside."},
        {"zh": "我朝一个方向死盯。", "en": "I stare dead at one direction."},
        {"zh": "我能听见很远的脚步。", "en": "I can hear footsteps far off."},
        {"zh": "我知道有人在。", "en": "I know someone is there."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我小一圈。", "en": "You are a size smaller than me."},
        {"zh": "你还没我一截钩子高。", "en": "You don't even reach my hook."},
        {"zh": "我把钩子举起来。", "en": "I raise the hooks."},
        {"zh": "你身上没什么能挡的。", "en": "You have nothing to block with."},
        {"zh": "我认出你怕了。", "en": "I can tell you are afraid."},
        {"zh": "我不忙，一步一步来。", "en": "I am not rushed. Step by step."},
        {"zh": "你的呼吸太急。", "en": "Your breathing is too fast."},
        {"zh": "墙根把你堵住了。", "en": "The wall's foot has you penned."},
        {"zh": "我把半个身子朝你倾过去。", "en": "I tip half my weight toward you."},
        {"zh": "我这一下会砸穿地面。", "en": "This will break through the ground."},
        {"zh": "你站得很稳，不错。", "en": "You stand steady. Good."},
        {"zh": "这里只有你和我。", "en": "There is only you and me here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我喉咙里挤出一声。", "en": "A sound squeezes from my throat."},
        {"zh": "皮上开了个口。", "en": "A gash opened in my hide."},
        {"zh": "我把身子侧过。", "en": "I turn my flank."},
        {"zh": "我没什么反应。", "en": "I barely reacted."},
        {"zh": "血从钩子上滴下来。", "en": "Blood drips from my hooks."},
        {"zh": "我稳住身子。", "en": "I steady myself."},
        {"zh": "这点伤，不算。", "en": "This wound does not count."},
        {"zh": "我重新挺直。", "en": "I straighten again."},
        {"zh": "你把我打痛了。", "en": "You hurt me."},
        {"zh": "这笔我记下。", "en": "I am writing this down."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "血肉，我喜欢。", "en": "Flesh. I like flesh."},
        {"zh": "扔进来给我。", "en": "Throw it in to me."},
        {"zh": "塞牙缝都不够，再来。", "en": "Not even a mouthful. Bring more."},
        {"zh": "我低下头，凑近了闻。", "en": "I lower my head and lean in to sniff."},
        {"zh": "沾血的最好。", "en": "Bloody is best."},
        {"zh": "手别收，我还没闻够。", "en": "Don't pull your hand back. I'm not done smelling it."},
        {"zh": "钩子上已经挂过很多。", "en": "My hooks have carried much."},
        {"zh": "再多添一些。", "en": "Add some more."},
        {"zh": "我闻着就来。", "en": "The smell brings me."},
        {"zh": "血腥味一冲，我就来劲。", "en": "One whiff of blood and I wake up."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一撞，你整个人都退。", "en": "One shove and you go back whole."},
        {"zh": "我的肩膀像块石头。", "en": "My shoulder is like stone."},
        {"zh": "你撞在我身上弹开。", "en": "You hit me and bounce."},
        {"zh": "这点力道，像挠痒。", "en": "That much force is a scratch to me."},
        {"zh": "地上的土被我们挤出来。", "en": "Dirt squeezes out under us."},
        {"zh": "我歪了一下，又站住。", "en": "I tilted, then held."},
        {"zh": "你力气算大的。", "en": "You are strong, as these go."},
        {"zh": "我换了个重心。", "en": "I shifted my weight."},
        {"zh": "再碾过去一回。", "en": "Grind in once more."},
        {"zh": "给我让路吧。", "en": "Make way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这样，没什么同伴。", "en": "In this state I have few like me."},
        {"zh": "小钩会长成大钩。", "en": "A small hook grows into a heavy one."},
        {"zh": "两只钩子对着，谁也不让。", "en": "Two hooks face off, neither giving way."},
        {"zh": "谁也别靠太近。", "en": "Neither comes too close."},
        {"zh": "这片地够两个站。", "en": "This ground fits two of us."},
        {"zh": "我慢慢蹲下。", "en": "I squat down slowly."},
        {"zh": "伤口会自己合。", "en": "The wounds close on their own."},
        {"zh": "一起守着这片地。", "en": "Let us hold this ground."},
        {"zh": "我还会再长的。", "en": "I will grow more yet."},
        {"zh": "走起来了吧。", "en": "Let us set off."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我两指夹起来。", "en": "I pinch it up between two fingers."},
        {"zh": "这点不够看。", "en": "Too small to matter."},
        {"zh": "它在我钩子上挂着。", "en": "It hangs on my hook."},
        {"zh": "两指一合，它就碎了。", "en": "Two fingers close, and it's dust."},
        {"zh": "塞进我的嘴里。", "en": "Into my mouth."},
        {"zh": "压得我牙根发酸。", "en": "It sets my teeth on edge."},
        {"zh": "我甩手抛开。", "en": "I fling it away."},
        {"zh": "派不上用场。", "en": "Of no use."},
        {"zh": "我舔了舔钩子。", "en": "I lick my hook."},
        {"zh": "先收起来吧。", "en": "I will keep it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你挪动过了。", "en": "You shifted."},
        {"zh": "我整个身子转过来。", "en": "My whole body turns."},
        {"zh": "钩子已经抬起。", "en": "My hooks are up."},
        {"zh": "你跑不出多远。", "en": "You will not get far."},
        {"zh": "我整个压向你。", "en": "My whole bulk bears on you."},
        {"zh": "地面的土在跳。", "en": "The dirt jumps under my steps."},
        {"zh": "两只钩都朝你张开了。", "en": "Both hooks open toward you."},
        {"zh": "你正在我正前方。", "en": "You are dead in front of me."},
        {"zh": "你身上那股汗味，我熟。", "en": "I know that sweat on you."},
        {"zh": "我大步过来。", "en": "I stride over."},
        {"zh": "脚不许挪动。", "en": "Do not move your feet."},
        {"zh": "这是最后几格。", "en": "The last few blocks."},
        {"zh": "我抬起两只钩。", "en": "I raise both hooks."},
        {"zh": "都能动手了。", "en": "I am ready to strike."},
        {"zh": "这一只就是你。", "en": "You are the one."},
        {"zh": "我看得清你。", "en": "I see you clearly."},
        {"zh": "再逼近一截。", "en": "One more length in."},
        {"zh": "开始打吧，来。", "en": "Let us fight, come."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步碾近。", "en": "I grind closer step by step."},
        {"zh": "你退一步，我就一步。", "en": "You step back, and so do I."},
        {"zh": "钩子拖在地上响。", "en": "My hooks drag and ring."},
        {"zh": "我不快，但地动。", "en": "I am slow, but the ground moves."},
        {"zh": "你绕到墙后了。", "en": "You are behind the wall."},
        {"zh": "我把墙撞开。", "en": "I break the wall open."},
        {"zh": "地上的距离在少。", "en": "The ground between us lessens."},
        {"zh": "你的脚印我认得。", "en": "I know your footprints."},
        {"zh": "钩尖抬到你胸口那么高。", "en": "The hook rises level with your chest."},
        {"zh": "你还在跑着。", "en": "You are still running."},
        {"zh": "你那颗心我听得清。", "en": "I hear your heart clearly."},
        {"zh": "再逼近两步。", "en": "Two steps nearer."},
        {"zh": "你被挤进死角。", "en": "You are squeezed into a dead corner."},
        {"zh": "我压着地面。", "en": "I press along the ground."},
        {"zh": "地面裂开了。", "en": "The ground has split."},
        {"zh": "我等你回身。", "en": "I wait for you to turn."},
        {"zh": "几乎踩到你了。", "en": "Almost treading on you."},
        {"zh": "这一下会中。", "en": "This one will land."},
        {"zh": "脑袋别往上抬。", "en": "Do not raise your head."},
        {"zh": "我紧贴着你背。", "en": "I am tight at your back."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一钩砸下去。", "en": "I bring a hook down."},
        {"zh": "钩子砸进地里，拔出来带土。", "en": "The hook bites the dirt and comes up full."},
        {"zh": "你被扫得飞开。", "en": "You are swept away."},
        {"zh": "钩子勾住了你的甲。", "en": "My hook caught your armour."},
        {"zh": "我把你拉过来。", "en": "I pull you in."},
        {"zh": "这一钩砸得结实。", "en": "That hook came down solid."},
        {"zh": "我甩了一下钩。", "en": "I wrench the hook."},
        {"zh": "你被甩进墙里。", "en": "You are swung into the wall."},
        {"zh": "血顺着钩槽往下淌。", "en": "Blood runs down the groove of the hook."},
        {"zh": "这只刚落下，那只又起。", "en": "This one lands, and the other comes up."},
        {"zh": "你挡得住一下。", "en": "You can block one."},
        {"zh": "第二下你接呢。", "en": "What about the second one."},
        {"zh": "你被我按住了。", "en": "I have you pinned."},
        {"zh": "别胡乱挣扎。", "en": "Do not squirm."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地面先响了一声。", "en": "The ground sounded first."},
        {"zh": "土坡裂开，我撑起腰。", "en": "The slope splits, and I push myself upright."},
        {"zh": "一大片黑影罩下来。", "en": "A broad shadow comes down."},
        {"zh": "钩子从雾里伸出来。", "en": "Hooks come out of the mist."},
        {"zh": "我比原来大得多。", "en": "I am far bigger than before."},
        {"zh": "土块顺着我的肩膀滚落。", "en": "Clods of earth roll off my shoulders."},
        {"zh": "骨头在皮里咔响。", "en": "Bones crack inside my hide."},
        {"zh": "我呼出一团热气。", "en": "I breathe out a cloud of heat."},
        {"zh": "周围安静下来。", "en": "Everything around goes quiet."},
        {"zh": "我扬起脑袋。", "en": "I raise my head."},
        {"zh": "我这一级，很重。", "en": "My level is a heavy one."},
        {"zh": "我从墙后挤出来。", "en": "I squeeze out from behind the wall."},
        {"zh": "地面被我踩塌。", "en": "I collapse the ground under me."},
        {"zh": "我落地，四周一下静了。", "en": "I land, and everything goes quiet."},
        {"zh": "这次的个头，够大。", "en": "This size is enough."},
        {"zh": "我把钩子举起。", "en": "I lift my hooks."},
        {"zh": "你的脚步，我在土里听见。", "en": "I hear your steps through the soil."},
        {"zh": "我从雾里迈出第一步。", "en": "I take my first step out of the fog."},
        {"zh": "谁也别想跑。", "en": "Nobody runs."},
        {"zh": "我走到你面前。", "en": "I walk up before you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的皮，发臭。", "en": "Fire scorches my hide, and it stinks."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处砸下来，腿一沉。", "en": "I crashed down from a height and my legs sank."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我沉得快。", "en": "I sink fast in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我推得后退。", "en": "The blast pushes me back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉在我的皮里。", "en": "Something is stuck in my hide."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光钻进了我的旧伤。", "en": "This light got into my old wounds."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我越饿越长。", "en": "The hungrier I get, the more I grow."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着钩子跑。", "en": "Lightning ran down my hooks."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地给我踩。", "en": "There is no ground to plant my feet."}
      ]
    }
  }
}
