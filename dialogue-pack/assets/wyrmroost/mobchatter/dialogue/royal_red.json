{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "山脊上，我慢慢走。", "en": "I walk the ridge slowly."},
        {"zh": "赤红的鳞，在雪光里。", "en": "Red scales against snowlight."},
        {"zh": "翅膀收着，山风太硬。", "en": "Wings folded; the mountain wind is harsh."},
        {"zh": "我的影子盖住半片坡。", "en": "My shadow covers half the slope."},
        {"zh": "爪子抓进岩缝。", "en": "Claws bite into rock seams."},
        {"zh": "高处才是我的地方。", "en": "The heights are mine."},
        {"zh": "我一走，碎石往下滚。", "en": "Stones roll down where I step."},
        {"zh": "我是这片山的主人。", "en": "This mountain belongs to me."},
        {"zh": "尾巴扫过积雪。", "en": "My tail sweeps the snow."},
        {"zh": "我走得慢，因为我够大。", "en": "I'm slow because I'm big enough."},
        {"zh": "空气稀薄，我不在乎。", "en": "Thin air doesn't bother me."},
        {"zh": "往上的路，我最熟。", "en": "I know the way up best."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在岩上，看云。", "en": "I lie on the rock and watch clouds."},
        {"zh": "鳞上落了一层雪。", "en": "Snow settles on my scales."},
        {"zh": "我的呼吸化出白雾。", "en": "My breath makes white mist."},
        {"zh": "山风把我的翼吹开。", "en": "The wind lifts my wings."},
        {"zh": "我在等活物上来。", "en": "I wait for something to climb."},
        {"zh": "这山太安静了。", "en": "The mountain is too quiet."},
        {"zh": "我磨了磨牙。", "en": "I grind my teeth."},
        {"zh": "爪子压在石上，留下印。", "en": "My claws leave marks on stone."},
        {"zh": "高处不胜寒，我不怕。", "en": "Cold heights don't bother me."},
        {"zh": "我眯眼看着太阳。", "en": "I squint at the sun."},
        {"zh": "远处有龙在飞。", "en": "A dragon flies far off."},
        {"zh": "我吼了一声，回音很响。", "en": "I roar; the echo is loud."},
        {"zh": "背上凉，我抖了抖。", "en": "My back is cold; I shake."},
        {"zh": "我在数山下的岩块。", "en": "I count boulders below."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你爬上来，膝盖都磨破了。", "en": "You climbed all this way with your knees scraped raw."},
        {"zh": "我看你，像看一只虫子。", "en": "You look like an insect from here."},
        {"zh": "这条山脊，归我。", "en": "This ridge is mine."},
        {"zh": "你身上没有龙的气。", "en": "You carry no dragon's aura."},
        {"zh": "我张开翼，你就该退了。", "en": "I spread my wings — you should back off."},
        {"zh": "蓝火在喉咙里聚。", "en": "Blue fire gathers in my throat."},
        {"zh": "我对谁都不客气。", "en": "I'm not gentle with anyone."},
        {"zh": "你还挺着没倒。", "en": "You're still on your feet."},
        {"zh": "我低头，把影子压在你身上。", "en": "I lower my head and put my shadow on you."},
        {"zh": "这里不是你的地盘。", "en": "This isn't your land."},
        {"zh": "你的武器，太小了。", "en": "Your weapon is too small."},
        {"zh": "我笑了，喉咙里咕咕响。", "en": "I laugh; it rumbles in my throat."},
        {"zh": "别碰我的鳞。", "en": "Don't touch my scales."},
        {"zh": "你退后十步，我还能忍。", "en": "Ten paces back and I might tolerate you."},
        {"zh": "我数着你迈了几步。", "en": "I've counted every step you took."},
        {"zh": "山上风大，你的箭会偏。", "en": "Wind's strong here; your arrows will drift."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "鳞裂了一块。", "en": "A scale cracked."},
        {"zh": "我咬牙，喉间嗡嗡作响。", "en": "I clench my teeth; a hum rumbles in my throat."},
        {"zh": "鳞缝里进了东西，有点疼。", "en": "Something's wedged between my scales, and it stings."},
        {"zh": "我甩头，血珠甩在雪上。", "en": "I shake my head; blood spatters the snow."},
        {"zh": "山石都被我踩碎。", "en": "I crush stone underfoot."},
        {"zh": "我瞪着你，没退。", "en": "I glare and hold my ground."},
        {"zh": "皮厚，也还是疼。", "en": "Thick hide still feels pain."},
        {"zh": "我的翼收紧了。", "en": "My wings tuck tight."},
        {"zh": "这件事还没了。", "en": "This isn't finished."},
        {"zh": "趁我还有耐性，快跑。", "en": "Run while I'm still patient."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "龙肉？我倒喜欢吃。", "en": "Dragon meat? That I do like."},
        {"zh": "你拿食物来讨好我？", "en": "Bribing me with food?"},
        {"zh": "这一点，不够我一口。", "en": "Not a mouthful for me."},
        {"zh": "这血腥味，让我喉咙发烫。", "en": "That smell of blood sets my throat burning."},
        {"zh": "放下，再往后退十步。", "en": "Set it down, then back away ten paces."},
        {"zh": "扔过来，别举着等我低头。", "en": "Throw it over; don't hold it up waiting for me to bow."},
        {"zh": "那东西我看不上。", "en": "I'm not impressed by that."},
        {"zh": "你指节发白，我瞧见了。", "en": "Your knuckles are white; I noticed."},
        {"zh": "也许我该连你一起。", "en": "Perhaps I'll take you as well."},
        {"zh": "这点东西，你收回去。", "en": "Take this bit of food back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我，你的骨头会响。", "en": "Hit me and your bones will ring."},
        {"zh": "我连爪子都没挪。", "en": "I didn't even shift a claw."},
        {"zh": "鳞片硬得像铁。", "en": "My scales are hard as iron."},
        {"zh": "你被我的鳞弹回去了。", "en": "My scales threw you back."},
        {"zh": "我的翼一展，你就退。", "en": "One spread of my wings and you retreat."},
        {"zh": "这点撞击，算什么。", "en": "That impact is nothing."},
        {"zh": "我侧身，山石都落。", "en": "I turn; stones fall."},
        {"zh": "别贴在我的爪边。", "en": "Don't hug my claws."},
        {"zh": "退，我不想踩你。", "en": "Back off; I'd rather not step on you."},
        {"zh": "这一下，算你命大。", "en": "Consider yourself lucky."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同类？这山上一只都没有。", "en": "Kin? None on this mountain."},
        {"zh": "我的吼声，本来是叫伴的。", "en": "My roar was meant to call a mate."},
        {"zh": "山太高，没人上来。", "en": "Too high; nobody climbs."},
        {"zh": "我这身红，够显眼。", "en": "This red hide is conspicuous enough."},
        {"zh": "领地比伴侣重要。", "en": "Territory matters more than company."},
        {"zh": "我不需要谁陪。", "en": "I need no one beside me."},
        {"zh": "孤高的位置，只坐得下我。", "en": "Only I fit this lonely perch."},
        {"zh": "风是唯一的回应。", "en": "Only wind answers."},
        {"zh": "把你那种眼神收起来。", "en": "Put that look away."},
        {"zh": "我转开了头。", "en": "I turn my head away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我张嘴把它整块咬住。", "en": "I take the whole piece in my jaws."},
        {"zh": "爪子太粗，捏不住。", "en": "My claws are too thick to pinch."},
        {"zh": "这东西会碎在我嘴里。", "en": "It'll shatter in my mouth."},
        {"zh": "掉下去，滚到山脚了。", "en": "It fell and rolled to the base."},
        {"zh": "我一只爪子就把它压住了。", "en": "One claw is enough to pin it."},
        {"zh": "我叼着，牙印很深。", "en": "I carry it; the tooth marks are deep."},
        {"zh": "没用，扔下山。", "en": "Useless; I throw it off the mountain."},
        {"zh": "这点重量，忽略不计。", "en": "That weight is negligible."},
        {"zh": "我低头把它拨过来。", "en": "I lower my head and nudge it over."},
        {"zh": "留一块给我。", "en": "Leave one for me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西爬上来了。", "en": "Something's climbing up."},
        {"zh": "我从岩上直起身。", "en": "I rise up off the rock."},
        {"zh": "蓝火在喉咙里滚。", "en": "Blue fire churns in my throat."},
        {"zh": "这是我的山。", "en": "This is my mountain."},
        {"zh": "猎物已经确认。", "en": "Prey confirmed."},
        {"zh": "你要为这一步付代价。", "en": "You'll pay for that step."},
        {"zh": "我张开双翼。", "en": "I spread both wings."},
        {"zh": "地都在我脚下。", "en": "The ground is under my feet."},
        {"zh": "我不追，你过来。", "en": "I don't chase; you come to me."},
        {"zh": "再上来一点。", "en": "A little higher."},
        {"zh": "你脚下这块岩石，是我的。", "en": "The rock under your feet is mine."},
        {"zh": "我看着你，一动不动。", "en": "I watch you, unmoving."},
        {"zh": "火已经聚满了。", "en": "The fire is fully gathered."},
        {"zh": "你从现在起就是猎物。", "en": "From now on, you're prey."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我仰头，吸气。", "en": "I tilt my head back and inhale."},
        {"zh": "蓝光在我嘴里亮。", "en": "Blue light fills my mouth."},
        {"zh": "这一口，能烧穿石头。", "en": "This breath could burn through stone."},
        {"zh": "你站的地方，是死路。", "en": "Where you stand is a dead end."},
        {"zh": "山风帮你？不，帮我。", "en": "The wind helps me, not you."},
        {"zh": "我在量你到崖边的距离。", "en": "I'm measuring you to the cliff edge."},
        {"zh": "我一步都没动。", "en": "I haven't moved a step."},
        {"zh": "火越来越烫。", "en": "The fire grows hotter."},
        {"zh": "你的箭，打不穿鳞。", "en": "Your arrows won't pierce scales."},
        {"zh": "再给我半口气的时间。", "en": "Give me half a breath more."},
        {"zh": "这声吼，把云都震散了。", "en": "This roar scatters the clouds."},
        {"zh": "你逃不远的。", "en": "You won't get far."},
        {"zh": "这里没有掩体。", "en": "No cover here."},
        {"zh": "蓝火已经烧到喉咙口。", "en": "Blue fire is at my throat."},
        {"zh": "我压低龙头，喉咙发亮。", "en": "I lower my head, throat glowing."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一口蓝火喷出去！", "en": "A blast of blue fire!"},
        {"zh": "爪子拍下去，石头都碎。", "en": "My claw comes down; stone shatters."},
        {"zh": "尾巴一扫，你飞出去。", "en": "One tail sweep throws you."},
        {"zh": "牙齿能咬穿甲。", "en": "My teeth pierce armor."},
        {"zh": "我撕开一道就收爪。", "en": "I tear once and pull the claw back."},
        {"zh": "这一下，你该知道疼。", "en": "That should teach you pain."},
        {"zh": "我的翼也是武器。", "en": "My wings are weapons too."},
        {"zh": "别在我脚下站着。", "en": "Don't stand under my feet."},
        {"zh": "火烧到你身上了。", "en": "The fire's caught you."},
        {"zh": "这一击，山都听见了。", "en": "The mountain heard that blow."},
        {"zh": "你退开，我就停。", "en": "Pull back and I stop."},
        {"zh": "我连一半力气都没使。", "en": "I haven't used half my strength."},
        {"zh": "爪子刮在你的盾上。", "en": "My claws rake your shield."},
        {"zh": "还想再来一回？", "en": "Want another round?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从山巅落下来。", "en": "I descend from the peak."},
        {"zh": "雪地被我的重量压实。", "en": "Snow packs under my weight."},
        {"zh": "红鳞上挂着霜。", "en": "Frost on my red scales."},
        {"zh": "这一带，气味很新。", "en": "These scents are new."},
        {"zh": "我张开翼，扫出一片空。", "en": "I spread my wings and clear a space."},
        {"zh": "山风把我托起来。", "en": "The wind lifts me."},
        {"zh": "谁在我的山上？", "en": "Who's on my mountain?"},
        {"zh": "我先吼一声，打个招呼。", "en": "I roar once as a greeting."},
        {"zh": "岩石还在往下滚。", "en": "Rocks are still tumbling."},
        {"zh": "我落地，震了一下。", "en": "My landing shakes the ground."},
        {"zh": "高处太冷清了。", "en": "The heights are too lonely."},
        {"zh": "有活物，正好。", "en": "Living things — good."},
        {"zh": "翼上的雪，被我抖成一片雾。", "en": "The snow on my wings shakes loose into a haze."},
        {"zh": "这里的空气，我认得。", "en": "The air here is familiar."},
        {"zh": "我巡查自己的地界。", "en": "I patrol my own land."},
        {"zh": "别抬头，会怕。", "en": "Don't look up; it might frighten you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "蓝火伤不了我，这火却烫。", "en": "Blue flame is mine; this fire still burns."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从高处坠下，骨头发闷。", "en": "A high fall leaves my bones aching."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进来，我的火灭了。", "en": "Water floods in; my fire goes out."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我侧翻，鳞都飞了。", "en": "The blast rolls me; scales fly."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭卡进鳞缝。", "en": "An arrow lodges in a scale seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量按住了我的翼。", "en": "That force pins my wings."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，火就弱。", "en": "Hungry, and my fire weakens."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我角上，全身一颤。", "en": "Lightning hits my horn; I convulse."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "底下什么都没有，我往下坠。", "en": "Nothing below; I plummet."}
      ]
    }
  }
}
