{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "八条腿踩着落叶。", "en": "Eight legs tread the fallen leaves."},
        {"zh": "我沿着树干往上。", "en": "I climb up the trunk."},
        {"zh": "我换到另一根藤上。", "en": "I move onto another vine."},
        {"zh": "叶子被我压得下垂。", "en": "The leaf sags under me."},
        {"zh": "我从树冠落下来。", "en": "I drop from the canopy."},
        {"zh": "我绕着树根走。", "en": "I go around the roots."},
        {"zh": "我钻进竹丛的缝。", "en": "I slip into a gap in the bamboo."},
        {"zh": "我贴着藤蔓横过去。", "en": "I cross along the vine."},
        {"zh": "我停在一片宽叶下。", "en": "I stop under a broad leaf."},
        {"zh": "我慢慢挪到背面。", "en": "I move to the underside."},
        {"zh": "八只脚踩过落叶，没有声音。", "en": "Eight feet cross the leaves without a sound."},
        {"zh": "我的影子留在树干上。", "en": "My shadow stays on the trunk."},
        {"zh": "我从上面垂下来。", "en": "I lower myself from above."},
        {"zh": "我缩起腿，跳过去。", "en": "I tuck my legs and jump."},
        {"zh": "我钻进一堆腐叶。", "en": "I burrow into the leaf litter."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在网的一角。", "en": "I hang at a corner of the web."},
        {"zh": "八只眼都不眨。", "en": "All eight eyes stay open."},
        {"zh": "我慢慢晃着。", "en": "I sway gently."},
        {"zh": "林子里湿气很重。", "en": "The jungle is heavy with moisture."},
        {"zh": "我等着猎物自己来。", "en": "I wait for prey to come."},
        {"zh": "我的腿上有细毛。", "en": "There is fine hair on my legs."},
        {"zh": "我听见很远的响动。", "en": "I hear something far off."},
        {"zh": "我把网补了一补。", "en": "I patched the web."},
        {"zh": "我不动，很久。", "en": "I stay still a long while."},
        {"zh": "竹叶沙沙响着。", "en": "The bamboo leaves rustle."},
        {"zh": "我在树的阴影里。", "en": "I am in the tree's shade."},
        {"zh": "这片枝叶归我。", "en": "These branches are mine."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我的网旁边。", "en": "You are beside my web."},
        {"zh": "我挂在藤上，正对你的头顶。", "en": "I hang from a vine above your head."},
        {"zh": "你不该走进这片林子。", "en": "You should not have walked into this wood."},
        {"zh": "你的脚步惊起了虫。", "en": "Your steps startled the insects up."},
        {"zh": "数着你的动作，八条腿。", "en": "Counting your moves. Eight legs."},
        {"zh": "这附近只有我。", "en": "I am the only one around here."},
        {"zh": "你别碰那根丝。", "en": "Do not touch that thread."},
        {"zh": "树上八只眼，都在看你。", "en": "Eight eyes in the canopy, all on you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我翻了个身又正。", "en": "I rolled over and righted."},
        {"zh": "一条腿歪了。", "en": "One leg went crooked."},
        {"zh": "一根丝断了。", "en": "A strand of silk broke."},
        {"zh": "我从网上掉下来。", "en": "I fell off the web."},
        {"zh": "我八条腿晃了晃。", "en": "My eight legs wobbled."},
        {"zh": "腿上的毛掉了些。", "en": "Some hair came off my legs."},
        {"zh": "我还能挂在丝上。", "en": "I can still hang by a thread."},
        {"zh": "你扯坏了我的网。", "en": "You spoiled my web."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里有虫。", "en": "There are insects in the wood."},
        {"zh": "虫才合我的口。", "en": "Only insects suit my mouth."},
        {"zh": "你举到天上也没用。", "en": "Hold it to the sky, it is useless."},
        {"zh": "搁在叶子上吧。", "en": "Set it on a leaf."},
        {"zh": "丛林神庙的墙角，我们四只一组。", "en": "Four of us to a temple corner."},
        {"zh": "我慢慢地退。", "en": "I retreat slowly."},
        {"zh": "那点吃的，挂在蛛丝上。", "en": "Hang that bit of food on my web."},
        {"zh": "你手里的东西，让丝线发痒。", "en": "What you hold makes my silk itch."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞在你肩膀上。", "en": "I hit your shoulder."},
        {"zh": "你被推得偏了。", "en": "You were shoved off balance."},
        {"zh": "我翻了个身，又站住。", "en": "I rolled over and righted myself."},
        {"zh": "我的腿缠了一下。", "en": "My legs tangled for a moment."},
        {"zh": "丝粘在你衣服上。", "en": "Silk sticks to your clothes."},
        {"zh": "我不算太重。", "en": "I am not too heavy."},
        {"zh": "你撞掉了我的网。", "en": "You knocked my web loose."},
        {"zh": "我再爬上去。", "en": "I climb back up."},
        {"zh": "别挥你的手臂。", "en": "Do not swing your arms."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这棵树上还有别的网。", "en": "There are other webs in this tree."},
        {"zh": "不必凑过来。", "en": "No need to come over."},
        {"zh": "一起守着这片枝叶。", "en": "Let us keep this branch together."},
        {"zh": "我往你那边爬。", "en": "I crawl toward you."},
        {"zh": "丝上有我的味道。", "en": "The silk carries my scent."},
        {"zh": "林子里够大。", "en": "The wood is big enough."},
        {"zh": "你们全都不用慌。", "en": "None of you need panic."},
        {"zh": "别弄断我的丝。", "en": "Do not snap my thread."},
        {"zh": "这里有吃不完的虫。", "en": "There are more insects than we can eat."},
        {"zh": "继续等着吧。", "en": "Keep waiting."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前腿捧起来。", "en": "I lift it with my front legs."},
        {"zh": "这个会动吗。", "en": "Does this move?"},
        {"zh": "它被丝缠住了。", "en": "It got caught in silk."},
        {"zh": "我把它翻过来。", "en": "I turn it over."},
        {"zh": "丛林里我的丝无处不在。", "en": "My silk is everywhere in the jungle."},
        {"zh": "我慢慢包起来。", "en": "I wrap it slowly."},
        {"zh": "我用丝把它缠了两圈。", "en": "I wrap it twice in silk."},
        {"zh": "掉在下头了。", "en": "It fell below."},
        {"zh": "我挂着看了一会儿。", "en": "I hung and looked a while."},
        {"zh": "对蜘蛛没有用。", "en": "Of no use to a spider."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你脚下一动。", "en": "Your foot moved."},
        {"zh": "我顺着丝，一点点降到你的高度。", "en": "I descend the silk to your height."},
        {"zh": "那只脚已经踩偏了。", "en": "You already stepped off line."},
        {"zh": "蛛丝一松，我就往下坠。", "en": "My silk slackens; I drop."},
        {"zh": "你在网里了。", "en": "You are in the web."},
        {"zh": "别挣那根丝。", "en": "Do not tug that thread."},
        {"zh": "这一下会黏住。", "en": "This one will stick."},
        {"zh": "该落下去了。", "en": "Time to drop."},
        {"zh": "我顺着丝滑下来。", "en": "I slide down the thread."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一停缀着你。", "en": "I tag you, step by step."},
        {"zh": "你在网边绕。", "en": "You are circling the web."},
        {"zh": "我把丝拉紧。", "en": "I pull the thread tight."},
        {"zh": "你的脚步我看得清。", "en": "I can follow your steps."},
        {"zh": "八条腿量着距离。", "en": "Eight legs measure the gap."},
        {"zh": "我从树上换位置。", "en": "I change position in the tree."},
        {"zh": "再欺近一格。", "en": "One block nearer."},
        {"zh": "你换气的间隔我数着。", "en": "I count the gaps in your breathing."},
        {"zh": "竹子在响吧。", "en": "The bamboo is rustling."},
        {"zh": "你被藤挡住了。", "en": "The vines have blocked you."},
        {"zh": "我等一个空当。", "en": "I wait for a gap."},
        {"zh": "几乎垂到你头上。", "en": "Nearly hanging over your head."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一扑压下去。", "en": "I pounce and pin."},
        {"zh": "丝缠上了你的手。", "en": "Silk wraps your hand."},
        {"zh": "我咬进去一口。", "en": "I bit in once."},
        {"zh": "你被黏住动不了。", "en": "You are stuck and cannot move."},
        {"zh": "我收回两腿。", "en": "I draw back two legs."},
        {"zh": "这一口只破了皮。", "en": "That bite only broke the skin."},
        {"zh": "我从侧面又上来。", "en": "I come in from the side again."},
        {"zh": "毒牙落了空。", "en": "My fangs missed."},
        {"zh": "你扯断了几根丝。", "en": "You snapped a few threads."},
        {"zh": "我又缠一层。", "en": "I wrap another layer."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一张新网在枝叶间。", "en": "A new web spans the branches."},
        {"zh": "我从树冠下来。", "en": "I come down from the canopy."},
        {"zh": "叶子轻轻一沉。", "en": "A leaf dips slightly."},
        {"zh": "我停在网中央。", "en": "I settle in the middle of the web."},
        {"zh": "丛林里安静了一下。", "en": "The jungle went quiet a moment."},
        {"zh": "我从腐叶里钻出。", "en": "I crawl out of the leaf litter."},
        {"zh": "竹节上有我的影子。", "en": "My shadow is on the bamboo."},
        {"zh": "我把腿摊开。", "en": "I spread my legs."},
        {"zh": "这里有虫的味道。", "en": "There is the smell of insects here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，丝就化了。", "en": "Fire melts silk."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我爬不动。", "en": "I cannot crawl in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把网撕开了。", "en": "The blast tore the web apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉进了我的腹。", "en": "Something is in my abdomen."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我的腿发麻。", "en": "This light numbs my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "树上没虫了。", "en": "There are no insects left in the tree."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在树顶。", "en": "Lightning struck the treetop."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有枝叶可挂。", "en": "There is nothing to hang from."}
      ]
    }
  }
}
