{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子里有我，慢慢移。", "en": "I move slowly inside the leaves."},
        {"zh": "我贴着树干挪。", "en": "I edge along the trunk."},
        {"zh": "我的形状像一团藤。", "en": "I look like a knot of vines."},
        {"zh": "我落下一片叶子。", "en": "A leaf falls from me."},
        {"zh": "我绕到竹丛后。", "en": "I slip behind the bamboo."},
        {"zh": "我从神庙的石缝里过。", "en": "I pass through a crack in the temple stone."},
        {"zh": "我的枝条碰到墙。", "en": "My branches brush the wall."},
        {"zh": "我往有光的地方移。", "en": "I move toward the light."},
        {"zh": "我又退回阴影。", "en": "I retreat into the shade."},
        {"zh": "我的声音在叶间散开。", "en": "My voice spreads among the leaves."},
        {"zh": "我一截截移近。", "en": "I move in, length by length."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立在枝叶间。", "en": "I stand among the branches."},
        {"zh": "叶子的声音是我。", "en": "The sound of leaves is me."},
        {"zh": "我把根扎进石缝。", "en": "I root myself in the stone crack."},
        {"zh": "这片林子很静。", "en": "This wood is very still."},
        {"zh": "我正在听你。", "en": "I am listening to you."},
        {"zh": "我身上长着青苔。", "en": "Moss grows on me."},
        {"zh": "光和水就够了。", "en": "Light and water are enough."},
        {"zh": "我慢慢张开头上的叶。", "en": "I slowly open the leaves at my head."},
        {"zh": "有虫爬过我。", "en": "An insect crawls over me."},
        {"zh": "我在神庙边上等。", "en": "I wait at the temple's edge."},
        {"zh": "这里的墙很旧。", "en": "These walls are old."},
        {"zh": "我连叶子都不晃。", "en": "I do not stir even a leaf."},
        {"zh": "风一过，叶子全响。", "en": "The wind passes and every leaf sounds."},
        {"zh": "我的影子是绿的。", "en": "My shadow is green."},
        {"zh": "我伸出一条藤。", "en": "I extend one vine."},
        {"zh": "我把叶子收拢。", "en": "I fold my leaves in."},
        {"zh": "我把一片叶子抬高。", "en": "I raise one leaf higher."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子在响，那是我在说话。", "en": "The leaves are rustling; that's me speaking."},
        {"zh": "声音从叶子里来。", "en": "The voice comes from the leaves."},
        {"zh": "神庙的藤，都是我长出来的。", "en": "Every vine in this temple grew from me."},
        {"zh": "你看不清我的样子。", "en": "You cannot see my shape clearly."},
        {"zh": "林子会告诉你。", "en": "The wood will tell you."},
        {"zh": "我说话很轻。", "en": "I speak very softly."},
        {"zh": "神庙在前面。", "en": "The temple is ahead."},
        {"zh": "我不会拦你。", "en": "I will not stop you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子掉了一地。", "en": "Leaves fall everywhere."},
        {"zh": "我断了一根枝。", "en": "A branch of mine broke."},
        {"zh": "我慢慢蜷起枝条。", "en": "I slowly curl my branches."},
        {"zh": "我枝干晃了晃。", "en": "My branches swayed."},
        {"zh": "汁液滴在土里。", "en": "Sap drips into the soil."},
        {"zh": "我低低地响。", "en": "I make a low sound."},
        {"zh": "我枝干还立着。", "en": "My trunk still stands."},
        {"zh": "你砍不深的。", "en": "You will not cut deep."},
        {"zh": "这事我记下。", "en": "I will remember this."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这不合我的意。", "en": "That is not for me."},
        {"zh": "我只要光和水。", "en": "I need only light and water."},
        {"zh": "叶子里没有这个。", "en": "This does not belong among leaves."},
        {"zh": "丛林里这东西，我用不上。", "en": "In the jungle, I've no use for this."},
        {"zh": "雨林里没有这种甜味。", "en": "This rainforest has no such sweetness."},
        {"zh": "我只要看着。", "en": "I only want to watch."},
        {"zh": "你手里那点甜味，是给我的？", "en": "That sweetness in your hand—is it for me?"},
        {"zh": "别把东西举那么高，我够不着。", "en": "Don't hold it up so high, I can't reach."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "枝条撞在你身上。", "en": "My branches knock against you."},
        {"zh": "枝条把你推开。", "en": "My branches push you back."},
        {"zh": "叶子抖了一地。", "en": "Leaves shake down everywhere."},
        {"zh": "我歪了一下，又立住。", "en": "I tilt, then hold."},
        {"zh": "我的藤断了一根。", "en": "One of my vines snapped."},
        {"zh": "叶片合拢，把你夹在中间。", "en": "My leaves close around you."},
        {"zh": "我们撞得树都在抖。", "en": "The tree shook with us."},
        {"zh": "你别挤过来。", "en": "Do not press in."},
        {"zh": "这一下不算轻。", "en": "That was not light."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里还有别的我。", "en": "There are others like me in the wood."},
        {"zh": "我们不用靠近。", "en": "We need not come close."},
        {"zh": "叶子会传话。", "en": "The leaves carry words."},
        {"zh": "一起守着这座神庙。", "en": "Let us keep this temple together."},
        {"zh": "根在地下缠着。", "en": "Our roots intertwine below."},
        {"zh": "声音会合在一起。", "en": "Our voices will join."},
        {"zh": "慢慢长大吧。", "en": "Grow slowly."},
        {"zh": "不用这么急。", "en": "No need to hurry."},
        {"zh": "我们一直都在。", "en": "We have always been here."},
        {"zh": "你就好好听着。", "en": "Just listen carefully."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用藤卷起来。", "en": "I coil it up with a vine."},
        {"zh": "这个不属于林子。", "en": "This does not belong in the wood."},
        {"zh": "我把它埋进土。", "en": "I bury it in the soil."},
        {"zh": "藤蔓卷不牢。", "en": "My vine cannot hold it."},
        {"zh": "它实在太重。", "en": "It is far too heavy."},
        {"zh": "我推回原处。", "en": "I push it back where it was."},
        {"zh": "上面有铁的味道。", "en": "There is the smell of iron on it."},
        {"zh": "我轻轻推了推。", "en": "I gave it a nudge."},
        {"zh": "这并不重要。", "en": "This does not matter."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的脚步惊动林子。", "en": "Your steps disturbed the wood."},
        {"zh": "叶子开始响。", "en": "The leaves begin to sound."},
        {"zh": "我朝你伸过去。", "en": "I reach toward you."},
        {"zh": "叶子后面有眼睛，一直在看。", "en": "Eyes behind the leaves have been watching."},
        {"zh": "林子知道你在哪。", "en": "The wood knows where you are."},
        {"zh": "根在土里动。", "en": "My roots stir in the soil."},
        {"zh": "根已经围上来了。", "en": "The roots have closed in."},
        {"zh": "别白费力气了。", "en": "Do not waste your strength."},
        {"zh": "该收拢过来了。", "en": "Time to close in."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子把你的位置告诉我。", "en": "The leaves tell me where you are."},
        {"zh": "你绕不开这片林。", "en": "You cannot get around this wood."},
        {"zh": "我在你前后。", "en": "I am ahead of you and behind."},
        {"zh": "声音越来越近。", "en": "The voice grows nearer."},
        {"zh": "我的根在地下铺开。", "en": "My roots spread below."},
        {"zh": "再收拢一圈。", "en": "Close in one more ring."},
        {"zh": "你踩的每一块石头我都知道。", "en": "I know every stone you tread."},
        {"zh": "我就在树后面。", "en": "I am behind the tree."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一根藤抽下去。", "en": "A vine lashes down."},
        {"zh": "你被缠住了脚。", "en": "Your feet are bound."},
        {"zh": "枝条打在你肩上。", "en": "A branch strikes your shoulder."},
        {"zh": "我被砍下一段。", "en": "A length of me is cut away."},
        {"zh": "这一抽有分量。", "en": "That lash had weight."},
        {"zh": "我绕着树移过去。", "en": "I move around the tree."},
        {"zh": "你扯断了一根。", "en": "You tore one off."},
        {"zh": "我又伸出两根。", "en": "I extend two more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子里有了一个新影子。", "en": "A new shadow appears among the leaves."},
        {"zh": "我从树根里站起来。", "en": "I rise from the roots."},
        {"zh": "叶子一直响。", "en": "The leaves keep sounding."},
        {"zh": "神庙的石缝里有响动。", "en": "Something stirs in the temple's cracks."},
        {"zh": "我一点点直起身。", "en": "I straighten up bit by bit."},
        {"zh": "我的枝条舒展开。", "en": "My branches unfurl."},
        {"zh": "丛林安静了一瞬。", "en": "The jungle goes quiet for a moment."},
        {"zh": "我找到了这片林。", "en": "I have found this wood."},
        {"zh": "风里带着土味。", "en": "The wind carries the smell of soil."},
        {"zh": "我在墙边站定。", "en": "I take my place by the wall."},
        {"zh": "有人闯进来了。", "en": "Someone has come in."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一碰，我的叶子就卷了。", "en": "Fire touches me and my leaves curl."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在石上一动不动。", "en": "I lie still on the stone."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我泡得发软。", "en": "The water softens me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我的枝条被吹散了。", "en": "My branches were scattered."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉进我的枝里。", "en": "Something is lodged in my branch."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光在我的叶间转。", "en": "This light turns among my leaves."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "土里的养料不够了。", "en": "The soil gives me too little."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在我身上，我整个发亮。", "en": "Lightning struck me and I lit up whole."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有土，也没有叶。", "en": "No soil here, and no leaves."}
      ]
    }
  }
}
