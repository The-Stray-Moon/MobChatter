{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "小爪子在岸边赶路。", "en": "Small claws hurry along the bank."},
        {"zh": "尾巴拖着走。", "en": "My tail drags behind me."},
        {"zh": "一路嗅着泥。", "en": "Sniffing the mud the whole way."},
        {"zh": "往水边的石头去。", "en": "Heading for the stones by the water."},
        {"zh": "身子贴着地走。", "en": "I keep low to the ground."},
        {"zh": "红杉林下很暗。", "en": "Dark under the redwoods."},
        {"zh": "我钻过一段树根。", "en": "I slip between roots."},
        {"zh": "步子碎得很急。", "en": "My steps come quick and small."},
        {"zh": "湿泥沾住了脚。", "en": "Wet mud grabs my feet."},
        {"zh": "我绕开一摊水。", "en": "I skirt a puddle."},
        {"zh": "河岸的崖壁很陡。", "en": "The river bluff is steep."},
        {"zh": "我一路走一路找。", "en": "Walking and searching at once."},
        {"zh": "很快穿过空地。", "en": "I cross the clearing quickly."},
        {"zh": "我竖起胡须听。", "en": "I raise my whiskers to listen."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在听水声。", "en": "I'm listening to the water."},
        {"zh": "爪子扒着泥。", "en": "I paw at the mud."},
        {"zh": "我把尾巴绕到身上。", "en": "I wrap my tail around me."},
        {"zh": "这壳吗？不是壳。", "en": "A shell? No shell on me."},
        {"zh": "我闻到了贝壳味。", "en": "I smell shellfish."},
        {"zh": "岸边石头很亮。", "en": "The river stones are bright."},
        {"zh": "树林里有点动静。", "en": "Something moves in the trees."},
        {"zh": "嘴里还含着泥。", "en": "There's still mud in my mouth."},
        {"zh": "等天黑再下水。", "en": "I'll wait for dusk to dive."},
        {"zh": "肚子贴着湿石。", "en": "My belly on wet stone."},
        {"zh": "没事，先待着。", "en": "Nothing yet. I'll stay."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "慢一点，别吓我。", "en": "Slow down. Don't startle me."},
        {"zh": "我很小，不好吃。", "en": "I'm small. Not worth eating."},
        {"zh": "你要下河吗？", "en": "Are you going to the river?"},
        {"zh": "我有一口好牙。", "en": "I've got good teeth."},
        {"zh": "你的靴子很响。", "en": "Your boots are loud."},
        {"zh": "贝壳我能敲开。", "en": "I can crack shells open."},
        {"zh": "我在这找吃的。", "en": "I'm foraging here."},
        {"zh": "蹲下来再说。", "en": "Crouch down first."},
        {"zh": "你一靠近我就跑。", "en": "If you come close, I run."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我吱了一声，钻进石缝。", "en": "I squeak once and slip into a crack."},
        {"zh": "我把自己卷紧了。", "en": "I rolled myself up tight."},
        {"zh": "毛被血粘住了。", "en": "Blood matted my fur."},
        {"zh": "我四条腿在抖。", "en": "My four legs are trembling."},
        {"zh": "我滚到石头后面。", "en": "I tumbled behind a stone."},
        {"zh": "我还能好好地站。", "en": "I can still stand."},
        {"zh": "这一点伤很重。", "en": "That's a bad wound on a small body."},
        {"zh": "我吸不上气。", "en": "I can't catch my breath."},
        {"zh": "我要下水了。", "en": "I'm going into the water."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是贝壳吗？", "en": "Is that a shell?"},
        {"zh": "给我来一个吧。", "en": "Give me one, please."},
        {"zh": "活的还是死的？", "en": "Alive or dead?"},
        {"zh": "我能咬开它。", "en": "I can bite it open."},
        {"zh": "闻起来很鲜。", "en": "Smells fresh."},
        {"zh": "放地上就好。", "en": "Just put it down."},
        {"zh": "别把它捏碎了。", "en": "Don't crush it."},
        {"zh": "这块肉很软。", "en": "This meat is soft."},
        {"zh": "让我先看看。", "en": "Let me have a look first."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "哎，撞到我了！", "en": "Hey, you hit me!"},
        {"zh": "我的小身板被你撞翻了。", "en": "You knocked my small frame over."},
        {"zh": "你的脚比我大得多。", "en": "Your foot is far bigger than me."},
        {"zh": "我缩起来了一点。", "en": "I curled up a little."},
        {"zh": "别踩我尾巴。", "en": "Don't step on my tail."},
        {"zh": "泥地太滑了。", "en": "The mud is too slick."},
        {"zh": "鼻子撞上河边的石头。", "en": "My nose hits a riverside stone."},
        {"zh": "让我钻回石缝。", "en": "Let me back into the crack."},
        {"zh": "你把我推歪了。", "en": "You nudged me askew."},
        {"zh": "别抓我的后颈。", "en": "Don't grab my scruff."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这附近没有别的。", "en": "There are no others around."},
        {"zh": "我很怕这种事。", "en": "This frightens me."},
        {"zh": "先让我确定安全。", "en": "Let me make sure it's safe."},
        {"zh": "等我吃完这些贝壳。", "en": "After I finish these shells."},
        {"zh": "在水边说吧。", "en": "Talk to me by the water."},
        {"zh": "我的骨头很细。", "en": "My bones are slender."},
        {"zh": "天快黑的时候。", "en": "Around dusk."},
        {"zh": "别弄出声音。", "en": "Don't make noise."},
        {"zh": "那我得走了。", "en": "Then I must go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这里有个牡蛎！", "en": "An oyster here!"},
        {"zh": "用牙咬开它。", "en": "I bite it open."},
        {"zh": "我抱在胸前面。", "en": "I hold it against my chest."},
        {"zh": "壳里还有肉。", "en": "There's still meat inside."},
        {"zh": "掉在水边了。", "en": "It fell by the water."},
        {"zh": "我藏进腮帮里。", "en": "I stuff it in my cheek."},
        {"zh": "这里还有一个。", "en": "Here's another one."},
        {"zh": "壳里的肉很甜。", "en": "The meat in the shell is sweet."},
        {"zh": "我先叼着走。", "en": "I'll carry it in my mouth."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有影子从上面来。", "en": "A shadow came from above."},
        {"zh": "那脚步声太重。", "en": "Those steps are too heavy."},
        {"zh": "我立刻缩起来。", "en": "I curl up at once."},
        {"zh": "它不是来吃贝壳的。", "en": "It's not here for shells."},
        {"zh": "我听见爪子的声音。", "en": "I hear claws."},
        {"zh": "水就在三步外。", "en": "Water is three steps away."},
        {"zh": "我得往草丛钻。", "en": "I need the grass."},
        {"zh": "石缝里黑得刚好。", "en": "The crack is just dark enough."},
        {"zh": "别让它看见。", "en": "Don't let it see me."},
        {"zh": "先躲，再看看。", "en": "Hide first, then look."},
        {"zh": "快往水边跑！", "en": "Get to the water!"},
        {"zh": "它已经转向我了。", "en": "It's turned toward me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它的影子压在河面上。", "en": "Its shadow lies on the river."},
        {"zh": "草叶替我挡着。", "en": "The grass covers me."},
        {"zh": "我贴着河底，屏住气。", "en": "I press to the riverbed and hold my breath."},
        {"zh": "它的喘气越来越近。", "en": "Its breathing draws nearer."},
        {"zh": "水声能遮住我。", "en": "The water covers my noise."},
        {"zh": "它往岸边去了。", "en": "It's heading to the bank."},
        {"zh": "等它走到下游。", "en": "Wait till it moves downstream."},
        {"zh": "我把嘴闭紧。", "en": "I keep my mouth shut."},
        {"zh": "我慢慢往下挪。", "en": "I creep lower."},
        {"zh": "它的脚步远了。", "en": "Its steps are fading."},
        {"zh": "我才敢喘气。", "en": "Only now do I breathe."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬它一口。", "en": "I bite it once."},
        {"zh": "牙齿还算利。", "en": "My teeth are decent."},
        {"zh": "咬完这一口就跑。", "en": "Bite once and run."},
        {"zh": "我扑不上去。", "en": "I can't leap up there."},
        {"zh": "这一口很轻。", "en": "That bite was light."},
        {"zh": "我只够到脚踝。", "en": "I can only reach an ankle."},
        {"zh": "牙咬得发酸。", "en": "My jaw aches from it."},
        {"zh": "牙咬得发酸也不松。", "en": "My jaw aches but holds."},
        {"zh": "我退回草里。", "en": "I back into the grass."},
        {"zh": "我这不是打架。", "en": "This isn't much of a fight."},
        {"zh": "你快点放开我。", "en": "Let go of me now."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "岸边钻出个小东西。", "en": "A small thing pops out on the bank."},
        {"zh": "我从崖缝里下来。", "en": "I come down the bluff crack."},
        {"zh": "我身上的毛还湿。", "en": "My fur is still wet."},
        {"zh": "红杉林的地上有我。", "en": "I'm on the redwood floor."},
        {"zh": "我闻到河水的味道。", "en": "I smell the river."},
        {"zh": "这附近贝壳很多。", "en": "Plenty of shells around here."},
        {"zh": "河岸的泥很凉。", "en": "The bank mud is cool."},
        {"zh": "我小心地探出头。", "en": "I poke my head out carefully."},
        {"zh": "又一个清晨。", "en": "Another dawn."},
        {"zh": "地上的落叶动了。", "en": "The litter shifted."},
        {"zh": "从河里钻出来，皮毛滴水。", "en": "Out of the river, my fur dripping."},
        {"zh": "我找到了石缝。", "en": "I found a gap in the stones."},
        {"zh": "这里能躲能跑。", "en": "Safe to hide, easy to flee."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛被燎得发卷。", "en": "My fur singed and curled."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在湿泥上。", "en": "I landed in the wet mud."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我憋气太久。", "en": "I held my breath too long."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被震得滚了圈。", "en": "The blast rolled me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根细东西扎进来。", "en": "Something thin went in."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这道光让我浑身麻。", "en": "The light left me numb."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得腿都没力。", "en": "Too hungry to stand."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把河岸照白。", "en": "The flash whitened the bank."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有地面能抓。", "en": "Nothing to hold on to."}
      ]
    }
  }
}
