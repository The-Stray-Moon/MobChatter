{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "六条腿在腐叶里赶路。", "en": "Six legs hurry through the leaf mould."},
        {"zh": "甲壳碰着枯枝响。", "en": "My shell knocks dry twigs."},
        {"zh": "沙地上留下一串细点。", "en": "A line of tiny prints in the sand."},
        {"zh": "往那块骨头爬。", "en": "Crawling toward that bone."},
        {"zh": "我钻过腐殖土。", "en": "I burrow through the humus."},
        {"zh": "背上的鞘翅一张一合。", "en": "My wing cases crack open and shut."},
        {"zh": "干河床的沙很细。", "en": "The dry riverbed sand is fine."},
        {"zh": "我绕开一块碎石。", "en": "I go around a pebble."},
        {"zh": "小爪子刮着地面。", "en": "Tiny claws scrape the ground."},
        {"zh": "我爬得比看着快。", "en": "I'm faster than I look."},
        {"zh": "朽木下面凉快。", "en": "Cool under the rotting wood."},
        {"zh": "一步步往骨头去。", "en": "Step by step toward the carcass."},
        {"zh": "触角先探进去。", "en": "My antennae probe ahead."},
        {"zh": "我在枯叶堆里穿行。", "en": "I work through the dead leaves."},
        {"zh": "一路都是碎屑。", "en": "Nothing but debris the whole way."},
        {"zh": "甲背沾满了土。", "en": "My back is coated in soil."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我搓着前足。", "en": "I rub my front legs together."},
        {"zh": "触角一直在动。", "en": "My antennae never stop."},
        {"zh": "啃一小块干皮。", "en": "Nibbling a scrap of dry skin."},
        {"zh": "翅盖下有点闷。", "en": "It's stuffy under my wing cases."},
        {"zh": "我藏在骨头缝里。", "en": "I hide in a crack of bone."},
        {"zh": "沙丘上的风很大。", "en": "The wind is strong on the dune."},
        {"zh": "我在数刚爬过的步。", "en": "I count the steps I just took."},
        {"zh": "这块骨头很干净。", "en": "This bone is very clean."},
        {"zh": "阳光晒热了我的甲。", "en": "The sun warms my shell."},
        {"zh": "地面有震动。", "en": "The ground is trembling."},
        {"zh": "腐肉的味道很重。", "en": "The smell of carrion is strong."},
        {"zh": "我在等下一个动静。", "en": "I wait for the next stir."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "一双大脚，快走开。", "en": "Big feet. Go away."},
        {"zh": "你挡了太阳。", "en": "You're blocking the sun."},
        {"zh": "我只有巴掌大。", "en": "I'm no bigger than a palm."},
        {"zh": "别看这么仔细。", "en": "Don't look so closely."},
        {"zh": "我不是来咬你的。", "en": "I'm not here to bite you."},
        {"zh": "你的影子太近。", "en": "Your shadow is too close."},
        {"zh": "这具骨架归我。", "en": "This skeleton is mine."},
        {"zh": "我要钻进去了。", "en": "I'm going to crawl in."},
        {"zh": "你踩到我的路。", "en": "You're on my path."},
        {"zh": "我六条腿已转向。", "en": "All six legs have turned."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲壳凹了一块。", "en": "A dent in my shell."},
        {"zh": "我在腐殖质里爬，专挑骨头。", "en": "I crawl in the humus, picking out bones."},
        {"zh": "一条腿动不了了。", "en": "One leg won't move."},
        {"zh": "我被压在碎屑下。", "en": "I'm pinned under debris."},
        {"zh": "汁液从壳缝里出。", "en": "Fluid leaks at my shell seam."},
        {"zh": "我的壳还在动。", "en": "My shell still moves."},
        {"zh": "我慢慢翻回来。", "en": "I right myself slowly."},
        {"zh": "这点伤撑得住。", "en": "I can bear this."},
        {"zh": "快躲到土里去。", "en": "Hide in the soil, quickly."},
        {"zh": "我记住那味道了。", "en": "I know that smell now."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是干肉吗？", "en": "Is that dried meat?"},
        {"zh": "这块皮不错。", "en": "This hide is good."},
        {"zh": "我闻到腐味了。", "en": "I smell something rotting."},
        {"zh": "把东西放低一点。", "en": "Lower it a bit."},
        {"zh": "我够到一点点。", "en": "I can just reach it."},
        {"zh": "别拿走那根骨头。", "en": "Don't take that bone."},
        {"zh": "这点碎屑也好。", "en": "Even these crumbs will do."},
        {"zh": "我等它更软些。", "en": "I'll wait for it to soften."},
        {"zh": "有味道就够了。", "en": "The smell is enough."},
        {"zh": "我马上爬过去。", "en": "I'm crawling over now."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被翻过来了。", "en": "I got flipped over."},
        {"zh": "甲壳磕了一下。", "en": "My shell took a knock."},
        {"zh": "我滚进沙里。", "en": "I rolled into the sand."},
        {"zh": "让我翻回来。", "en": "Let me right myself."},
        {"zh": "碎石压住我了。", "en": "A pebble pinned me."},
        {"zh": "我在土里打滑。", "en": "I'm slipping in the dirt."},
        {"zh": "再推我就扁了。", "en": "One more push and I'm flat."},
        {"zh": "我撞上你的靴子，赶紧倒退。", "en": "I bump your boot and hastily back away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只想找骨头。", "en": "I only want bones."},
        {"zh": "这种事在腐木下面。", "en": "That happens under a log."},
        {"zh": "你先往后退一退。", "en": "Step back first."},
        {"zh": "我这身量太小了。", "en": "I'm far too small."},
        {"zh": "翅盖都张不开。", "en": "I can't even spread my wing cases."},
        {"zh": "地上有更合适的。", "en": "There are better ones on the ground."},
        {"zh": "等这具骨架吃完。", "en": "After I finish this carcass."},
        {"zh": "别在这里守着。", "en": "Don't stand guard here."},
        {"zh": "我很怕被看见。", "en": "I hate being seen."},
        {"zh": "别出声，我就走。", "en": "Stay quiet and I'll go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这根骨头是我的。", "en": "This bone is mine."},
        {"zh": "一小片干皮。", "en": "A sliver of dry hide."},
        {"zh": "用前足抱着。", "en": "I clutch it with my forelegs."},
        {"zh": "太重了，拖不动。", "en": "Too heavy to drag."},
        {"zh": "我咬一小口。", "en": "I take a small bite."},
        {"zh": "这里有一粒沙。", "en": "There's a grain of sand."},
        {"zh": "这个可以吃下去。", "en": "This one can be eaten."},
        {"zh": "我就地吃掉。", "en": "I'll eat it right here."},
        {"zh": "藏到甲下面。", "en": "I tuck it under my shell."},
        {"zh": "再吃上一点点。", "en": "Just a little more."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "整片地面在震动。", "en": "The whole ground is shaking."},
        {"zh": "有影子盖过来。", "en": "A shadow covers me."},
        {"zh": "那双眼睛太大了。", "en": "Those eyes are too big."},
        {"zh": "我得先躲起来。", "en": "I have to hide first."},
        {"zh": "触角缩回去了。", "en": "My antennae pulled back."},
        {"zh": "腿开始乱动。", "en": "My legs are scrambling."},
        {"zh": "附近有声音。", "en": "There's a sound nearby."},
        {"zh": "骨头缝能藏。", "en": "A crack in the bone will hide me."},
        {"zh": "快些，再快些。", "en": "Faster. Faster still."},
        {"zh": "别让它看见我。", "en": "Don't let it see me."},
        {"zh": "我一下愣住了。", "en": "I froze on the spot."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我把腿收起来。", "en": "I pull my legs in."},
        {"zh": "甲壳和沙一个色。", "en": "My shell matches the sand."},
        {"zh": "它还蹲在那石头边。", "en": "It's still crouched by that stone."},
        {"zh": "我一动就会被发现。", "en": "One move and I'm seen."},
        {"zh": "我躲到骨头后面。", "en": "I hide behind the bone."},
        {"zh": "它的呼吸很重。", "en": "Its breathing is heavy."},
        {"zh": "沙粒在我背上。", "en": "Sand sits on my back."},
        {"zh": "等它的影子移开。", "en": "Wait for its shadow to move."},
        {"zh": "它转过身子了。", "en": "It turned around."},
        {"zh": "我慢慢挪一点。", "en": "I shift a tiny bit."},
        {"zh": "翅膀不敢动。", "en": "My wings stay still."},
        {"zh": "它的脚步声远了。", "en": "Its steps have faded."},
        {"zh": "我现在才敢动。", "en": "Only now do I dare move."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬它的皮。", "en": "I bite its hide."},
        {"zh": "用头撞一下。", "en": "A bump with my head."},
        {"zh": "力气太小了。", "en": "My strength is tiny."},
        {"zh": "钳子只夹得住皮屑。", "en": "My jaws hold only skin flakes."},
        {"zh": "我爬上它的脚。", "en": "I climb onto its foot."},
        {"zh": "被压到就完了。", "en": "Getting crushed is the end."},
        {"zh": "我往缝里钻。", "en": "I dive into a crack."},
        {"zh": "这点痛不算什么。", "en": "That's no real pain."},
        {"zh": "我胡乱咬着。", "en": "I bite at anything."},
        {"zh": "我飞天也飞不远。", "en": "Even flying gets me nowhere."},
        {"zh": "别把我捏在手心。", "en": "Don't close me in your palm."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从腐土里钻出来。", "en": "I come up through the humus."},
        {"zh": "沙丘上出现一个小黑点。", "en": "A small dark speck on the dune."},
        {"zh": "甲壳还湿着。", "en": "My shell is still damp."},
        {"zh": "冲积平原上很多同伴。", "en": "Many kin on the floodplain."},
        {"zh": "我朝着骨头的气味走。", "en": "I walk toward the smell of bone."},
        {"zh": "干河床很干燥。", "en": "The dry riverbed is parched."},
        {"zh": "翅膀在甲下叠好。", "en": "My wings fold beneath the cases."},
        {"zh": "我一寸一寸地爬。", "en": "I crawl an inch at a time."},
        {"zh": "这具尸体还新鲜。", "en": "This carcass is still fresh."},
        {"zh": "我找到了入口。", "en": "I found the way in."},
        {"zh": "土里有很多吃的。", "en": "There's plenty to eat in the soil."},
        {"zh": "别挡在骨头前面。", "en": "Don't block the carcass."},
        {"zh": "我又爬出来了。", "en": "I'm out again."},
        {"zh": "这里是白垩纪的地面。", "en": "This is Cretaceous ground."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "甲壳被烤得发脆。", "en": "My shell is singed brittle."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时腿折了一根。", "en": "A leg snapped on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水漫过我的甲。", "en": "Water rose over my shell."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "整片沙都被掀了。", "en": "The whole patch of sand flipped."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "我会被钉在地上。", "en": "I could be pinned to the ground."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股热钻进了壳。", "en": "Heat crawled into my shell."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把沙照白了。", "en": "The flash bleached the sand."}
      ]
    }
  }
}
