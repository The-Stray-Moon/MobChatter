{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "羽尾在身后轻晃。", "en": "My feathered tail sways behind me."},
        {"zh": "我踩着枯枝往前。", "en": "I step over dead branches."},
        {"zh": "脚爪落地很轻。", "en": "My claws land quietly."},
        {"zh": "义县组的湖边很湿。", "en": "The Yixian lakeshore is damp."},
        {"zh": "我侧头听着林里。", "en": "I tilt my head to listen."},
        {"zh": "羽毛上挂着露水。", "en": "Dew hangs on my feathers."},
        {"zh": "我沿着水线走。", "en": "I walk along the waterline."},
        {"zh": "身子比野鸡大不了多少。", "en": "I'm hardly bigger than a pheasant."},
        {"zh": "我快速穿过空地。", "en": "I dart across the clearing."},
        {"zh": "雪林里脚印很深。", "en": "My prints sink in the snow forest."},
        {"zh": "尾巴帮我平衡。", "en": "My tail keeps me balanced."},
        {"zh": "我绕到树的后侧。", "en": "I circle to the far side of the tree."},
        {"zh": "一步一停地前进。", "en": "Advance a step, pause, advance."},
        {"zh": "我抖了下身上的羽。", "en": "I shake out my feathers."},
        {"zh": "靠近再生林地。", "en": "Easing into the regrowth."},
        {"zh": "脚下的苔很软。", "en": "The moss underfoot is soft."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在舔自己的羽。", "en": "I preen my feathers."},
        {"zh": "尾巴一动不动。", "en": "My tail holds still."},
        {"zh": "我听见水面的响。", "en": "I hear something on the water."},
        {"zh": "头低低地抬着。", "en": "My head rides low and forward."},
        {"zh": "林子里有鸟叫。", "en": "Birds call in the wood."},
        {"zh": "我的牙很密。", "en": "My teeth are closely set."},
        {"zh": "脚趾抓着树枝。", "en": "My toes grip the branch."},
        {"zh": "我盯着水面。", "en": "I stare at the water."},
        {"zh": "这一带很安静。", "en": "It's quiet around here."},
        {"zh": "背上的羽竖了一点。", "en": "My back feathers ruffle up."},
        {"zh": "我慢慢咽了口口水。", "en": "I swallow slowly."},
        {"zh": "有小东西在动。", "en": "Something small is moving."},
        {"zh": "我先伏下来。", "en": "I crouch down first."},
        {"zh": "等天黑更好。", "en": "Dusk would be better."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比猎物还大。", "en": "You're bigger than my usual prey."},
        {"zh": "别把手放低。", "en": "Don't lower your hand."},
        {"zh": "我在看你手上的东西。", "en": "I'm watching what's in your hand."},
        {"zh": "我咬合力很强。", "en": "My bite is stronger than I look."},
        {"zh": "我身上是羽毛，不是鳞。", "en": "I have feathers, not scales."},
        {"zh": "再近我就跳开。", "en": "Any closer and I bolt."},
        {"zh": "火的味道，我不喜欢。", "en": "I don't care for the smell of fire."},
        {"zh": "我不是小龙。", "en": "I'm no little dragon."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一撮羽毛飘下来，疼。", "en": "A tuft of feathers drifts down. It hurts."},
        {"zh": "我翅膀歪着。", "en": "My wing hangs crooked."},
        {"zh": "我两条腿在抖。", "en": "My legs are shaking."},
        {"zh": "羽毛炸开，我躲进蕨丛。", "en": "Feathers fluffed, I duck into ferns."},
        {"zh": "这还是能跑。", "en": "I can still run."},
        {"zh": "小身体经不起。", "en": "A small body can't take much."},
        {"zh": "我压低身子忍。", "en": "I crouch and bear it."},
        {"zh": "我记住这双靴子。", "en": "I remember those boots."},
        {"zh": "再来我就跳。", "en": "One more and I leap away."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块是肉吗？", "en": "Is that piece meat?"},
        {"zh": "扔下来试试。", "en": "Drop it and see."},
        {"zh": "我不吃硬的。", "en": "I don't eat hard things."},
        {"zh": "放地上别动。", "en": "Set it down and be still."},
        {"zh": "那一块给我留着。", "en": "Save that piece for me."},
        {"zh": "肉味？我鼻子很准。", "en": "Meat? My nose is never wrong."},
        {"zh": "骨头也能咬成粉，信我。", "en": "I can grind bone to powder. Trust me."},
        {"zh": "别晃，我咬得准。", "en": "Hold still. My bite is precise."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我背上的绒羽蹭乱了。", "en": "You've ruffled the down on my back."},
        {"zh": "我羽毛全竖了。", "en": "My feathers all stood up."},
        {"zh": "退一步，我太小。", "en": "One step back. I'm small."},
        {"zh": "你的膝盖撞到我。", "en": "Your knee caught me."},
        {"zh": "我打了个趔趄。", "en": "I stumbled."},
        {"zh": "脚爪在苔上滑。", "en": "My claws slipped on moss."},
        {"zh": "我撞进灌木里。", "en": "I tumbled into the brush."},
        {"zh": "别抓我的背。", "en": "Don't grab my back."},
        {"zh": "树枝弹回来打到我。", "en": "A branch sprang back and hit me."},
        {"zh": "我绕开你就行。", "en": "I'll just go around you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我得先护着巢。", "en": "I have a nest to guard."},
        {"zh": "巢里还有蛋要守。", "en": "Eggs in the nest need watching."},
        {"zh": "你的体形太大了。", "en": "You're too large."},
        {"zh": "林子里安静些再说。", "en": "When the wood is quieter."},
        {"zh": "我的羽还没长好。", "en": "My feathers aren't fully grown."},
        {"zh": "一起捕猎倒是可以。", "en": "Hunting together could work."},
        {"zh": "别靠巢太近。", "en": "Don't come near the nest."},
        {"zh": "我信任你还要很久。", "en": "Trust takes me a long while."},
        {"zh": "先让我看清你。", "en": "Let me see you clearly first."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "叼起来就跑。", "en": "I snatch it and run."},
        {"zh": "骨头我能咬碎。", "en": "I can crunch the bone."},
        {"zh": "在地上滚了滚。", "en": "It rolled on the ground."},
        {"zh": "用脚踩住它。", "en": "I pin it with a foot."},
        {"zh": "这个咬起来太硬。", "en": "This one's too hard to bite."},
        {"zh": "这块肉，够我吃一天。", "en": "This meat lasts me a day."},
        {"zh": "我藏到树根下。", "en": "I hide it under a root."},
        {"zh": "剩下一块软骨。", "en": "A bit of gristle left."},
        {"zh": "我把它拖走。", "en": "I drag it away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "羽冠一竖，我看见了。", "en": "My crest rises. I see it."},
        {"zh": "草叶抖了一下。", "en": "The grass twitched."},
        {"zh": "我把胸口贴到地面。", "en": "My chest drops to the dirt."},
        {"zh": "我牙口好，骨头也能咬碎。", "en": "My bite can crush bone."},
        {"zh": "腿已经准备好。", "en": "My legs are ready."},
        {"zh": "它的动作很慢。", "en": "It's moving slowly."},
        {"zh": "再往前靠近两步。", "en": "Two steps closer."},
        {"zh": "我一咬住就不松开。", "en": "When I bite, I don't loosen."},
        {"zh": "窝在另一边。", "en": "The nest is on the other side."},
        {"zh": "先拿下这个。", "en": "This one first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我压着身子接近。", "en": "I creep in low."},
        {"zh": "脚爪落下没有声。", "en": "My claws land silently."},
        {"zh": "我盯着它颈侧。", "en": "I watch the side of its neck."},
        {"zh": "风从它那边来。", "en": "The wind comes from it."},
        {"zh": "它朝我这边偏头。", "en": "It tilts its head toward me."},
        {"zh": "枯枝挡在中间。", "en": "A dead branch lies between us."},
        {"zh": "它还在低头。", "en": "It's still head-down."},
        {"zh": "等它低下脖子。", "en": "Wait till it lowers its neck."},
        {"zh": "它转过身去。", "en": "It turned away."},
        {"zh": "我踩上一块石头。", "en": "I step onto a stone."},
        {"zh": "我这么小，也长了一身绒毛。", "en": "Small, and covered in down."},
        {"zh": "尾羽一压就冲。", "en": "Tail down, and I go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "牙扣进颈里！", "en": "Fangs lock into the neck!"},
        {"zh": "牙很密，咬得紧。", "en": "Closely set teeth, hard grip."},
        {"zh": "我一跃扑上去。", "en": "I leap and pounce."},
        {"zh": "爪子按下去。", "en": "I press down with claws."},
        {"zh": "咬碎你的骨头。", "en": "I'll crunch your bone."},
        {"zh": "拧着脖子撕。", "en": "I twist and tear."},
        {"zh": "这一下很利。", "en": "That one was sharp."},
        {"zh": "退开，然后再扑上去。", "en": "Back off, then pounce."},
        {"zh": "我比你想的快。", "en": "I'm faster than you think."},
        {"zh": "它的血很烫。", "en": "Its blood is hot."},
        {"zh": "尾巴帮我稳住。", "en": "My tail steadies me."},
        {"zh": "牙一合，骨都能咬碎。", "en": "My jaws close; even bone cracks."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从蕨叶间出来。", "en": "I step out of the ferns."},
        {"zh": "林间的落叶动了。", "en": "The forest litter moved."},
        {"zh": "一双小眼睛在低处。", "en": "Two small eyes down low."},
        {"zh": "我抖了抖羽毛。", "en": "I ruffle my feathers."},
        {"zh": "湖边有新脚印。", "en": "New prints by the lake."},
        {"zh": "我从树上落下来。", "en": "I drop down from a tree."},
        {"zh": "雪林里多了个影子。", "en": "A shadow in the snow wood."},
        {"zh": "义县的林子，我跑惯了。", "en": "I know the Yixian woods well."},
        {"zh": "我在找今天的第一口。", "en": "Looking for my first bite today."},
        {"zh": "义县组的晨光很淡。", "en": "Yixian morning light is thin."},
        {"zh": "我慢慢靠近水。", "en": "I ease up to the water."},
        {"zh": "别把我惊动了。", "en": "Don't startle me."},
        {"zh": "我站得低低的。", "en": "I keep myself low."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛烧出焦味。", "en": "My feathers smell burnt."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时脚折了一下。", "en": "My leg folded on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "湖水灌进我的喙。", "en": "Lake water fills my snout."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被震得翻了。", "en": "The blast flipped me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "细刺扎进了肋。", "en": "A thin spike hit my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这种光我不懂。", "en": "I don't understand this light."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击得我羽毛立起。", "en": "Lightning raised every feather."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下面全空了。", "en": "There's nothing under me."}
      ]
    }
  }
}
