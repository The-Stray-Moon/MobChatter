{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小步快走，头顶很厚。", "en": "I trot along, my skull thick on top."},
        {"zh": "两条后腿交替，尾巴平举。", "en": "Two legs alternate; my tail is level."},
        {"zh": "我沿着冲积平原走。", "en": "I walk the alluvial plain."},
        {"zh": "脚下的沙很细。", "en": "The sand beneath is fine."},
        {"zh": "我时不时低头嗅。", "en": "Now and then I lower my head to sniff."},
        {"zh": "干河床上一片石头。", "en": "The dry bed is all stones."},
        {"zh": "我踩着石头过去。", "en": "I cross over the stones."},
        {"zh": "爪子抓得很稳。", "en": "My claws grip well."},
        {"zh": "我走到丘顶看了一圈。", "en": "I climb a low dune and look around."},
        {"zh": "然后才下去。", "en": "Then descend."},
        {"zh": "白天我很活跃。", "en": "By day I am active."},
        {"zh": "我绕开一丛刺草。", "en": "I skirt a thorny clump."},
        {"zh": "尾巴在身后摆。", "en": "My tail swings behind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，头微微低着。", "en": "I stand with my head slightly down."},
        {"zh": "脖子上的皮肤在动。", "en": "The skin on my neck stirs."},
        {"zh": "风把细沙吹到我的脚边。", "en": "Wind blows fine sand to my feet."},
        {"zh": "我用后腿刨了一下。", "en": "I scrape with a hind leg."},
        {"zh": "沙落回原处。", "en": "The sand falls back."},
        {"zh": "我用头骨顶了顶沙。", "en": "I butt the sand with my dome."},
        {"zh": "头顶那块骨头很硬。", "en": "That bone on my crown is hard."},
        {"zh": "我用它撞过很多东西。", "en": "I have struck many things with it."},
        {"zh": "远处有小动物。", "en": "Small animals move far off."},
        {"zh": "它们太小了。", "en": "They are too small."},
        {"zh": "沙丘上的风推不动我。", "en": "The dune wind can't budge me."},
        {"zh": "太阳往西挪。", "en": "The sun moves west."},
        {"zh": "影子变长了。", "en": "My shadow lengthens."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "胆小，但我也会撞你一下。", "en": "Skittish, but I'll still headbutt you."},
        {"zh": "我仰头看你的影子。", "en": "I crane my neck up at your shadow."},
        {"zh": "我把头顶朝你。", "en": "I turn the top of my skull toward you."},
        {"zh": "那是我的武器。", "en": "That is my weapon."},
        {"zh": "但我不打算用。", "en": "But I do not mean to use it."},
        {"zh": "你蹲下了。", "en": "You crouch."},
        {"zh": "我们差不多高了。", "en": "We are about the same height now."},
        {"zh": "我这颗硬头，是撞出来的。", "en": "This hard skull was made for headbutting."},
        {"zh": "你没有出声。", "en": "You make no sound."},
        {"zh": "我又挪了一步。", "en": "I shuffle once more."},
        {"zh": "差点碰到你。", "en": "Almost touching you."},
        {"zh": "我停住，头骨还偏向你。", "en": "I stop, my skull still tilted toward you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我晃了一下，头偏了。", "en": "I stagger and my head turns."},
        {"zh": "腿上一道口子。", "en": "A cut on my leg."},
        {"zh": "我蹬了两下后腿。", "en": "I kick back twice with my hind legs."},
        {"zh": "喉咙里发出低响。", "en": "A low sound in my throat."},
        {"zh": "头顶那块骨头也疼。", "en": "Even my skull aches."},
        {"zh": "我的头骨嗡了一下。", "en": "My dome is ringing."},
        {"zh": "沙上落了血点。", "en": "Blood spots the sand."},
        {"zh": "我把头顶对准它。", "en": "I aim my crown at it."},
        {"zh": "这次我准备好了。", "en": "This time I am ready."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有一股发酵的甜味。", "en": "There is a sweet fermented smell."},
        {"zh": "是银杏果。", "en": "Ginkgo fruit."},
        {"zh": "我快步过去。", "en": "I hurry over."},
        {"zh": "低头就咬。", "en": "I lower my head and bite."},
        {"zh": "果肉很软。", "en": "The flesh is soft."},
        {"zh": "我嚼得很快。", "en": "I chew fast."},
        {"zh": "别的都在抢。", "en": "Others are competing."},
        {"zh": "我把身体横过去。", "en": "I set my body across."},
        {"zh": "护住这一堆。", "en": "Guarding this pile."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的肩上。", "en": "You hit my shoulder."},
        {"zh": "我脑袋一低，就撞了过去。", "en": "I lower my head and butt into it."},
        {"zh": "头顶低下来对着你。", "en": "My skull lowers toward you."},
        {"zh": "那是警告。", "en": "That is a warning."},
        {"zh": "你没有再往前。", "en": "You do not advance."},
        {"zh": "我慢慢把头顶抬起来。", "en": "I slowly raise my crown."},
        {"zh": "我们错开。", "en": "We edge apart."},
        {"zh": "我的头撞在你小腿上。", "en": "My head bumps against your shin."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我把头顶低下去。", "en": "I lower my crown."},
        {"zh": "她也低下来。", "en": "She lowers hers."},
        {"zh": "两块骨头轻轻碰了一下。", "en": "Two skulls touch lightly."},
        {"zh": "这就算是说好了。", "en": "That is agreement enough."},
        {"zh": "我们并排挖坑。", "en": "We dig side by side."},
        {"zh": "沙堆在两边。", "en": "Sand piles on both sides."},
        {"zh": "她把卵放进去。", "en": "She lays the eggs in."},
        {"zh": "我用沙盖好。", "en": "I cover them with sand."},
        {"zh": "然后我们一起走开。", "en": "Then we walk away together."},
        {"zh": "谁也不回头。", "en": "Neither looks back."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我低头衔起来。", "en": "I lower my head and take it."},
        {"zh": "这个东西圆圆的。", "en": "This thing is round."},
        {"zh": "壳裂了。", "en": "The shell cracks."},
        {"zh": "里面的东西流出来。", "en": "What is inside runs out."},
        {"zh": "我舔了舔。", "en": "I lick it."},
        {"zh": "又去找下一个。", "en": "And look for another."},
        {"zh": "地上还有几个。", "en": "There are a few more on the ground."},
        {"zh": "那块果子被你捡走，我有点急。", "en": "You picked up that fruit, and now I'm a little anxious."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西靠近我的窝。", "en": "Something is near my nest."},
        {"zh": "我立刻转过去。", "en": "I turn at once."},
        {"zh": "脖子上的皮绷起来。", "en": "The skin on my neck tightens."},
        {"zh": "我把头顶对住它。", "en": "I aim my skull at it."},
        {"zh": "后腿蹬住沙。", "en": "My hind legs brace in the sand."},
        {"zh": "我冲过去。", "en": "I charge."},
        {"zh": "只跑了三步。", "en": "Only three steps."},
        {"zh": "但够快了。", "en": "But fast enough."},
        {"zh": "它被撞得退开。", "en": "It is knocked back."},
        {"zh": "这小脑袋，又撞了一回。", "en": "This small head butts once more."},
        {"zh": "这次它跑了。", "en": "This time it runs."},
        {"zh": "我停在窝前。", "en": "I stop before the nest."},
        {"zh": "低头看了看。", "en": "And look down at it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它绕到侧面。", "en": "It circles to my flank."},
        {"zh": "我跟着转。", "en": "I turn with it."},
        {"zh": "我们绕着小丘转了两圈。", "en": "We circle the dune twice."},
        {"zh": "沙被踩得乱七八糟。", "en": "The sand is churned up."},
        {"zh": "它想从后面来。", "en": "It wants to come from behind."},
        {"zh": "我又压低头顶。", "en": "I lower my crown again."},
        {"zh": "这个姿势我最熟。", "en": "This stance I know best."},
        {"zh": "它扑过来。", "en": "It lunges."},
        {"zh": "我撞上去。", "en": "I meet it head-on."},
        {"zh": "一声闷响。", "en": "A dull crack."},
        {"zh": "这个小东西还想顶我。", "en": "This little thing still wants to butt me."},
        {"zh": "我低头对准你的膝盖。", "en": "I lower my head at your knee."},
        {"zh": "窝更重要。", "en": "The nest matters more."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "它差点跪下。", "en": "It nearly drops to a knee."},
        {"zh": "又撞了一下，还是不服。", "en": "One more headbutt. Still not satisfied."},
        {"zh": "这次撞在腰上。", "en": "This time the flank."},
        {"zh": "我低头又是一记头槌。", "en": "I lower my head and butt again."},
        {"zh": "用爪子扒它的脚。", "en": "My claws rake its feet."},
        {"zh": "它踢我，我滚了一圈。", "en": "It kicks; I roll once."},
        {"zh": "立刻站起来。", "en": "And rise at once."},
        {"zh": "头顶又低下去。", "en": "My crown lowers again."},
        {"zh": "撞上去，闷响。", "en": "I strike; a dull sound."},
        {"zh": "我退开两步。", "en": "I back off two paces."},
        {"zh": "甩了甩头。", "en": "And shake my head."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "沙面被顶开一小片。", "en": "A patch of sand lifts."},
        {"zh": "我从里面钻出来。", "en": "I push out of it."},
        {"zh": "头顶先出来。", "en": "My crown first."},
        {"zh": "然后是腿。", "en": "Then my legs."},
        {"zh": "我抖落身上的沙。", "en": "I shake off the sand."},
        {"zh": "这里有三叠纪的干风。", "en": "The dry Triassic wind is here."},
        {"zh": "河床是干的。", "en": "The riverbed is dry."},
        {"zh": "四周都是低矮的灌木。", "en": "Low shrubs all around."},
        {"zh": "我走了几步。", "en": "I walk a few steps."},
        {"zh": "沙很软，脚陷进去。", "en": "The sand is soft; my feet sink."},
        {"zh": "我拔出来，再走。", "en": "I pull them out and go on."},
        {"zh": "远处有别的头饰龙。", "en": "Other pachycephalosaurs are far off."},
        {"zh": "它们朝这边看。", "en": "They look this way."},
        {"zh": "我低下头，表示没有敌意。", "en": "I lower my head to show no threat."},
        {"zh": "太阳很高。", "en": "The sun is high."},
        {"zh": "我开始找吃的。", "en": "I begin to look for food."},
        {"zh": "这里有银杏。", "en": "There is ginkgo here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的背，皮发紧。", "en": "Fire roasts my back; my hide tightens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从丘上滚下去，磕到头。", "en": "I roll off the dune and strike my head."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我掀翻在沙上。", "en": "The blast flips me onto the sand."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进我的腿。", "en": "It buries in my leg."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我连干果都找。", "en": "Hungry enough to hunt dry fruit."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在沙上，我伏低。", "en": "Lightning strikes the sand; I flatten."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有沙，我抓不住。", "en": "No sand beneath; nothing to grip."}
      ]
    }
  }
}
