{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体一节一节地推着往前走。", "en": "I push forward one segment at a time."},
        {"zh": "几十条细腿依次落地。", "en": "Dozens of thin legs land in sequence."},
        {"zh": "我爬过一片腐烂的落叶。", "en": "I crawl over rotting leaves."},
        {"zh": "湿泥贴在我的腹部。", "en": "Wet mud clings to my belly."},
        {"zh": "我沿着一根倒木往上爬。", "en": "I climb a fallen log."},
        {"zh": "又顺着另一头下来。", "en": "And come down the other end."},
        {"zh": "我的壳是深褐色的。", "en": "My shell is dark brown."},
        {"zh": "沙地上留下一条浅浅的痕。", "en": "A shallow trail remains on the sand."},
        {"zh": "干涸的河床很硬。", "en": "The dry riverbed is hard."},
        {"zh": "我从裂缝里钻过去。", "en": "I squeeze through a crack."},
        {"zh": "我走得很慢，从不跑。", "en": "I move slowly and never run."},
        {"zh": "前面有水。", "en": "There is water ahead."},
        {"zh": "我停下来，绕开。", "en": "I stop and go around."},
        {"zh": "湿的地方容易陷。", "en": "Wet ground swallows you."},
        {"zh": "我更喜欢落叶层。", "en": "I prefer the leaf litter."},
        {"zh": "那里又潮又软。", "en": "It is damp and soft there."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘在一段枯枝上。", "en": "I curl on a dry twig."},
        {"zh": "身体弯成一个不完全的圈。", "en": "My body bends an incomplete circle."},
        {"zh": "腿还在轻轻拨动。", "en": "My legs still stir faintly."},
        {"zh": "像在数什么。", "en": "As if counting something."},
        {"zh": "一只蚂蚁从我旁边过。", "en": "An ant passes me."},
        {"zh": "我没有理它。", "en": "I ignore it."},
        {"zh": "它也没有理我。", "en": "It ignores me too."},
        {"zh": "阳光透过叶隙。", "en": "Sun comes through the leaf gaps."},
        {"zh": "落在我背上。", "en": "It lands on my back."},
        {"zh": "我慢慢伸直。", "en": "I slowly straighten."},
        {"zh": "又盘起来。", "en": "And curl again."},
        {"zh": "水汽在土上凝着。", "en": "Moisture beads on the soil."},
        {"zh": "我闻得到。", "en": "I can smell it."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从落叶下面探出前半身。", "en": "I push my front half out from the leaves."},
        {"zh": "你在上面，很高。", "en": "You are above me, very high."},
        {"zh": "我抬不起头看你。", "en": "I cannot lift my head to see you."},
        {"zh": "只能看到你的影子。", "en": "I see only your shadow."},
        {"zh": "影子动了。", "en": "The shadow moves."},
        {"zh": "我的腿全部不动。", "en": "All my legs go still."},
        {"zh": "影子走开了。", "en": "The shadow moves away."},
        {"zh": "我又开始爬。", "en": "I start crawling again."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我卷成一团。", "en": "I curl into a ball."},
        {"zh": "腿有几条不动了。", "en": "Some legs stop moving."},
        {"zh": "我疼得蜷得更紧。", "en": "I curl tighter with the pain."},
        {"zh": "血是淡黄色的。", "en": "My blood is pale yellow."},
        {"zh": "我慢慢松开一点。", "en": "I loosen a little."},
        {"zh": "又卷回去。", "en": "And curl back."},
        {"zh": "很久之后才爬。", "en": "Only much later do I crawl."},
        {"zh": "爬得很慢。", "en": "Very slowly."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的味道飘过来。", "en": "The smell of rot drifts over."},
        {"zh": "叶子被压成一团。", "en": "The leaves are pressed into a mass."},
        {"zh": "我爬上去。", "en": "I climb onto it."},
        {"zh": "只能啃边缘。", "en": "I can only nibble the edges."},
        {"zh": "很慢。", "en": "Very slowly."},
        {"zh": "但我有耐心。", "en": "But I am patient."},
        {"zh": "我一节一节地啃。", "en": "I nibble, segment by segment."},
        {"zh": "啃到天黑。", "en": "Until dark."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的尾节。", "en": "You step on my tail segment."},
        {"zh": "我往前一缩。", "en": "I pull forward."},
        {"zh": "腿乱了两下。", "en": "My legs scramble twice."},
        {"zh": "你没有再踩。", "en": "You do not step again."},
        {"zh": "我的节肢一节节撑开。", "en": "My segments uncurl one by one."},
        {"zh": "从你的靴子旁边绕过去。", "en": "I go around your boot."},
        {"zh": "地上留了一条痕。", "en": "A trail remains."},
        {"zh": "像被笔画过。", "en": "As if drawn with a stroke."},
        {"zh": "我继续爬。", "en": "I keep crawling."},
        {"zh": "好像什么都没发生。", "en": "As if nothing happened."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们还是在一段腐木上相遇的。", "en": "We met on a piece of rotting wood."},
        {"zh": "两只盘在一起。", "en": "Two bodies curled together."},
        {"zh": "很久没有动。", "en": "We did not move for a long while."},
        {"zh": "然后各自爬开。", "en": "Then crawled apart."},
        {"zh": "卵产在土里面。", "en": "The eggs go into the soil."},
        {"zh": "藏在烂叶下面。", "en": "Hidden beneath rotting leaves."},
        {"zh": "没有人会来管。", "en": "No one will tend them."},
        {"zh": "潮气会管。", "en": "The damp will."},
        {"zh": "我从不回头。", "en": "I never look back."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前半身压住它。", "en": "I press it with my front half."},
        {"zh": "它比我的壳硬。", "en": "It is harder than my shell."},
        {"zh": "我用触角推着它走。", "en": "I push it along with my antennae."},
        {"zh": "我慢慢啃。", "en": "I gnaw slowly."},
        {"zh": "啃出一个小口。", "en": "I open a small notch."},
        {"zh": "汁水流出来。", "en": "Juice seeps out."},
        {"zh": "我把头伸进去。", "en": "I push my head in."},
        {"zh": "吃了很久。", "en": "I eat for a long while."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有眼睛能看清。", "en": "I have no eyes that see it clearly."},
        {"zh": "但我感觉得到震动。", "en": "But I feel the tremor."},
        {"zh": "腿收在下面。", "en": "My legs tuck beneath."},
        {"zh": "像一块石头。", "en": "Like a stone."},
        {"zh": "它拨开落叶。", "en": "It pushes the leaves aside."},
        {"zh": "光落进来。", "en": "Light comes in."},
        {"zh": "我朝那片腐叶爬过去。", "en": "I crawl toward that patch of rotten leaves."},
        {"zh": "它看了一会。", "en": "It looks a while."},
        {"zh": "把叶子放了回去。", "en": "And puts the leaves back."},
        {"zh": "我接着往前挪。", "en": "I shuffle onward."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我往落叶下面钻。", "en": "I burrow under the leaves."},
        {"zh": "一层，两层。", "en": "One layer, two."},
        {"zh": "越深越安全。", "en": "The deeper, the safer."},
        {"zh": "土里有水。", "en": "There is water in the soil."},
        {"zh": "我的腿沾满了泥。", "en": "My legs are coated in mud."},
        {"zh": "我把腿全收住。", "en": "I draw all my legs in."},
        {"zh": "上面的声音远了。", "en": "The sound above recedes."},
        {"zh": "我慢慢往回爬。", "en": "I crawl slowly back."},
        {"zh": "只到能看见光的地方。", "en": "Only to where I can see light."},
        {"zh": "然后就等着。", "en": "Then I wait."},
        {"zh": "这是我一贯的办法。", "en": "It is my usual method."},
        {"zh": "我不喜欢打。", "en": "I do not like to fight."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我卷上去，环住它的脚。", "en": "I curl up and loop its foot."},
        {"zh": "几十条腿一起抓。", "en": "Dozens of legs grip at once."},
        {"zh": "我飞出去，落在叶堆上。", "en": "I fly off and land in the leaf pile."},
        {"zh": "壳上裂了一线。", "en": "A line splits in my shell."},
        {"zh": "我爬起来。", "en": "I right myself."},
        {"zh": "腿动了动，都还在。", "en": "My legs move; all are there."},
        {"zh": "我又卷成一团。", "en": "I curl into a ball again."},
        {"zh": "它的手伸下来。", "en": "Its hand comes down."},
        {"zh": "我的腿勾住它的鞋带。", "en": "My legs hook its laces."},
        {"zh": "它弯腰来解。", "en": "It bends to untie them."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "落叶层下面多了一节。", "en": "A segment appears under the leaf litter."},
        {"zh": "我从土里推出来。", "en": "I push up out of the soil."},
        {"zh": "身体很长，很慢。", "en": "Long, and very slow."},
        {"zh": "这里的落叶够厚。", "en": "The litter here is deep enough."},
        {"zh": "潮气正好。", "en": "The damp is just right."},
        {"zh": "干涸的河床就在旁边。", "en": "The dry riverbed is close by."},
        {"zh": "我不去那边。", "en": "I will not go there."},
        {"zh": "我爬向更深的叶堆。", "en": "I crawl toward deeper litter."},
        {"zh": "一节一节地进去。", "en": "Segment by segment."},
        {"zh": "最后只剩尾节露在外面。", "en": "Only my last segment stays out."},
        {"zh": "我把它也收了进去。", "en": "I draw that in too."},
        {"zh": "白天我从不这样。", "en": "By day I never do this."},
        {"zh": "只有在暗处我才出来。", "en": "I come out only in the dark."},
        {"zh": "叶面上有水珠。", "en": "Drops of water sit on the leaves."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的节，壳向里缩。", "en": "Fire roasts my segments; the shell contracts."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从木头上掉下去，摔散了半圈。", "en": "I fall off the log and half uncoil."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我甩进落叶堆。", "en": "The blast throws me into the leaves."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西把我钉在地上。", "en": "It pins me to the ground."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我的腿全停了。", "en": "A cold stops all my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我啃了太久的干叶。", "en": "I have chewed dry leaves too long."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声震得我的壳在响。", "en": "Thunder makes my shell ring."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有土，也没有叶子可以钻。", "en": "No soil, no leaves to burrow into."}
      ]
    }
  }
}
