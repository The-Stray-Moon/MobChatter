{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面小跑，肚子几乎擦土。", "en": "I scurry low; my belly nearly brushes the dirt."},
        {"zh": "四条短腿挪得很快。", "en": "Four short legs move quickly."},
        {"zh": "我钻过一丛蕨的根。", "en": "I slip between the roots of a fern."},
        {"zh": "夜里我才敢出来走。", "en": "I dare come out only at night."},
        {"zh": "石头下面有影子，我就换方向。", "en": "A shadow under a stone and I change course."},
        {"zh": "我走一步停一下。", "en": "One step, then a pause."},
        {"zh": "侏罗纪的泥土很松。", "en": "The Jurassic soil is loose."},
        {"zh": "我在丘陵的坡上爬。", "en": "I climb the slope of a hill."},
        {"zh": "尾巴拖着一道细痕。", "en": "My tail leaves a thin line."},
        {"zh": "草丛比我高。", "en": "The grass stands taller than I do."},
        {"zh": "我在草根之间找路。", "en": "I find my way between the roots."},
        {"zh": "有声音，我就钻进土里。", "en": "A sound, and I burrow under."},
        {"zh": "等很久才敢出来。", "en": "I wait a long while before coming out."},
        {"zh": "月亮被云挡住，我更放心。", "en": "Clouds cover the moon; I relax."},
        {"zh": "我又往前走了一段。", "en": "I go on a little farther."},
        {"zh": "前面是空地，我绕开。", "en": "Open ground ahead; I go around."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着，几乎和土一个颜色。", "en": "I lie still, almost the colour of soil."},
        {"zh": "只有肋侧在轻轻起伏。", "en": "Only my ribs stir faintly."},
        {"zh": "我竖起耳朵听。", "en": "I prick my ears to listen."},
        {"zh": "远处有沉重的脚步。", "en": "Heavy steps far off."},
        {"zh": "脚步声过去了。", "en": "The steps pass."},
        {"zh": "我才敢呼吸。", "en": "Only then do I breathe."},
        {"zh": "上面沾了泥。", "en": "It is muddy."},
        {"zh": "我用后腿挠了挠耳后。", "en": "I scratch behind my ear with a hind leg."},
        {"zh": "风从坡上下来。", "en": "Wind comes down the slope."},
        {"zh": "我缩在石缝里。", "en": "I tuck into a rock crack."},
        {"zh": "这是我最好的藏身处。", "en": "This is my best hiding place."},
        {"zh": "明天还来。", "en": "I will come again tomorrow."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你很大。", "en": "You are very large."},
        {"zh": "莫里森组的夜里，我只敢挖洞。", "en": "In Morrison nights I only dare to burrow."},
        {"zh": "我又探出来。", "en": "I peek out again."},
        {"zh": "我的鼻子在抖。", "en": "My nose twitches."},
        {"zh": "侏罗纪的夜里没有你。", "en": "There is no you in a Jurassic night."},
        {"zh": "我不喜欢。", "en": "I do not like it."},
        {"zh": "你没那么可怕。", "en": "You are not so frightening."},
        {"zh": "你这么高，我只敢抬头看一眼。", "en": "You're so tall—I dare only one glance up."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我疼得叫了一声很细的。", "en": "I squeak, very thin."},
        {"zh": "我窜出去两尺。", "en": "I bolt two feet away."},
        {"zh": "身上破了一小块皮。", "en": "A small patch of skin is torn."},
        {"zh": "抖得厉害，牙也在打颤。", "en": "Shaking badly, even my teeth chatter."},
        {"zh": "血的味道让我更怕。", "en": "The smell of my blood frightens me more."},
        {"zh": "我躲进石头缝。", "en": "I hide in the crack."},
        {"zh": "半天不敢出来。", "en": "I dare not come out for a long while."},
        {"zh": "外面没动静。", "en": "Nothing stirs outside."},
        {"zh": "我才探出头。", "en": "Only then do I look out."},
        {"zh": "我的后腿被踩了一下。", "en": "Something stepped on my hind leg."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子的味道飘过来。", "en": "The smell of leaves drifts over."},
        {"zh": "我从土里钻出来。", "en": "I come up out of the soil."},
        {"zh": "我小步跑过去。", "en": "I trot over."},
        {"zh": "咬一口，又抬头看。", "en": "I bite, then look up."},
        {"zh": "很嫩，比我平时吃的好。", "en": "Tender, better than my usual."},
        {"zh": "我又咬了两口。", "en": "I take two more bites."},
        {"zh": "一边吃一边听。", "en": "I eat and listen at once."},
        {"zh": "有声音就停。", "en": "Any sound and I stop."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的尾尖。", "en": "You step on my tail tip."},
        {"zh": "我叫了一声，窜开。", "en": "I squeak and dart away."},
        {"zh": "我又回头看你。", "en": "Then I look back at you."},
        {"zh": "我钻进丘陵的蕨丛。", "en": "I dart into the ferns on the hill."},
        {"zh": "我才敢停。", "en": "Only then do I stop."},
        {"zh": "我的尾巴还在抽。", "en": "My tail still twitches."},
        {"zh": "你蹲下来。", "en": "You crouch down."},
        {"zh": "莫里森组的小家伙，贴住了地面。", "en": "This little Morrison creature hugs the ground."},
        {"zh": "我们都没动。", "en": "Neither of us moves."},
        {"zh": "然后我钻进草里。", "en": "Then I slip into the grass."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "夜里我们才碰面。", "en": "We meet only at night."},
        {"zh": "两只小的在草根间绕圈。", "en": "Two small bodies circle among roots."},
        {"zh": "我们的鼻子碰了一下。", "en": "Our noses touch once."},
        {"zh": "然后各自散开。", "en": "Then we part."},
        {"zh": "窝就在石头下面。", "en": "The nest is under the stone."},
        {"zh": "里面铺了干草。", "en": "It is lined with dry grass."},
        {"zh": "我叼着草回去。", "en": "I carry grass back."},
        {"zh": "她已经在了。", "en": "She is already there."},
        {"zh": "我把草放下。", "en": "I set it down."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起来。", "en": "I pick it up."},
        {"zh": "它比我还长。", "en": "It is longer than I am."},
        {"zh": "卡在石头缝里。", "en": "It jams in a crack."},
        {"zh": "我用力拉。", "en": "I pull hard."},
        {"zh": "我衔着剩下的一半。", "en": "I carry the other half."},
        {"zh": "回窝里。", "en": "Back to the nest."},
        {"zh": "垫在身下。", "en": "I line it under myself."},
        {"zh": "很舒服。", "en": "Very comfortable."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西翻动了我上面的土。", "en": "Something turned the soil above me."},
        {"zh": "这片蕨叶在动。", "en": "This fern leaf is moving."},
        {"zh": "我往后退。", "en": "I back away."},
        {"zh": "后面是石头。", "en": "Stone behind me."},
        {"zh": "我把身体缩到最小。", "en": "I shrink as small as I can."},
        {"zh": "我的小牙其实不吓人。", "en": "My little teeth aren't really scary."},
        {"zh": "很小，但是尖的。", "en": "Small, but sharp."},
        {"zh": "它伸手过来。", "en": "It reaches in."},
        {"zh": "我咬了。", "en": "I bite."},
        {"zh": "我只能咬它一下，然后跑。", "en": "I can bite once, then run."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它比我快。", "en": "It is faster than I am."},
        {"zh": "我拐进石缝。", "en": "I dodge into a crack."},
        {"zh": "它进不来。", "en": "It cannot follow."},
        {"zh": "我在里面喘。", "en": "I pant inside."},
        {"zh": "它的手在外面摸。", "en": "Its hand gropes outside."},
        {"zh": "我往更深处挤。", "en": "I squeeze deeper."},
        {"zh": "土掉在我身上。", "en": "Soil falls on me."},
        {"zh": "我下了蛋，藏在沙里。", "en": "I laid my eggs and hid them in sand."},
        {"zh": "我从另一边出来。", "en": "I come out the other side."},
        {"zh": "往反方向跑。", "en": "And run the other way."},
        {"zh": "这是我的办法。", "en": "That is my method."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上去咬住它的手指。", "en": "I lunge and bite its finger."},
        {"zh": "它甩了一下。", "en": "It shakes its hand."},
        {"zh": "我死不放。", "en": "I do not let go."},
        {"zh": "它把我甩到地上。", "en": "It throws me to the ground."},
        {"zh": "我翻身就跑。", "en": "I roll over and run."},
        {"zh": "跑了两步又停。", "en": "Two steps, then I stop."},
        {"zh": "回头呲牙。", "en": "I look back and bare my teeth."},
        {"zh": "喉咙里发出细响。", "en": "A thin sound rises in my throat."},
        {"zh": "这不是我怕。", "en": "This is not fear."},
        {"zh": "这是我不退。", "en": "This is me not backing down."},
        {"zh": "我趁着它后退，钻出土面。", "en": "While it recoils, I slip out of the soil."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "土被顶开一个小口。", "en": "A small hole opens in the soil."},
        {"zh": "我先伸出鼻子。", "en": "My nose comes out first."},
        {"zh": "夜风很凉。", "en": "The night wind is cool."},
        {"zh": "远处有巨大的呼吸声。", "en": "Something enormous breathes far off."},
        {"zh": "我缩在洞口听。", "en": "I crouch at the opening and listen."},
        {"zh": "风里有蕨叶的味道。", "en": "The wind carries fern."},
        {"zh": "身体只有巴掌大。", "en": "My body is only a palm's width."},
        {"zh": "在这片林子里太小了。", "en": "So small in this forest."},
        {"zh": "所以我只在夜里出来。", "en": "So I come out only at night."},
        {"zh": "月亮在我背后。", "en": "The moon is at my back."},
        {"zh": "我停下来吃了一口草。", "en": "I stop for a bite of grass."},
        {"zh": "很快又走了。", "en": "And move on quickly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的背，毛都卷了。", "en": "Fire singes my back; my fur curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，摔得发昏。", "en": "I roll down the slope, dazed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进鼻子，我拼命蹬。", "en": "Water fills my nose; I kick hard."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "轰的一声，我被震到半空。", "en": "A boom throws me into the air."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西钉在我旁边的土里。", "en": "It pins into the soil beside me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷把我定住。", "en": "A cold locks me in place."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我开始啃树皮。", "en": "Hungry enough to gnaw bark."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把整个坡照亮。", "en": "Lightning lights the whole slope."}
      ]
    }
  }
}
