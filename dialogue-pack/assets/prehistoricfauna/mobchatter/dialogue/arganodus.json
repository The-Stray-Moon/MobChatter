{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我摆着尾巴游过浅滩", "en": "I swish through the shallows."},
        {"zh": "我沿着河底的碎石游", "en": "I swim along the gravel bed."},
        {"zh": "我一会儿上一会儿下", "en": "I rise and dip as I go."},
        {"zh": "我从水草间穿过去", "en": "I thread between the water weeds."},
        {"zh": "我贴着泥底滑行", "en": "I slide over the mud."},
        {"zh": "我拐进水湾里", "en": "I turn into the inlet."},
        {"zh": "我顺流荡了一段", "en": "I drift with the current."},
        {"zh": "我的鳍一开一合", "en": "My fins open and close."},
        {"zh": "我摆尾掉了个头", "en": "My tail swings me around."},
        {"zh": "我从石头上面越过去", "en": "I cross over the stone."},
        {"zh": "我绕着水潭转圈", "en": "I circle the pool."},
        {"zh": "我蹭着水底的沙", "en": "I brush the sandy bottom."},
        {"zh": "我慢慢升到水面", "en": "I rise slowly to the surface."},
        {"zh": "我钻到浮叶下面", "en": "I tuck under a floating leaf."},
        {"zh": "我顺着水流往下", "en": "I drift down with the flow."},
        {"zh": "我又回到刚才那块洼地", "en": "I return to that hollow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我轻轻悬在水里", "en": "I hang in the water."},
        {"zh": "我的鳍轻轻摆着", "en": "My fins sway gently."},
        {"zh": "我悬在一丛水草边上", "en": "I hover beside a clump of weeds."},
        {"zh": "我张着嘴不动", "en": "I hold my mouth open."},
        {"zh": "我在石头阴影里", "en": "I am in the stone's shadow."},
        {"zh": "我的鳃在水中开合", "en": "My gills work in the water."},
        {"zh": "我在原地慢慢调了方向", "en": "I slowly turn myself around in place."},
        {"zh": "水从我身侧流过", "en": "Water passes my sides."},
        {"zh": "我在等什么漂过来", "en": "I wait for something to drift by."},
        {"zh": "我停在水里不动鳍", "en": "I hold still, fins unmoving."},
        {"zh": "我稍稍抬了抬头", "en": "I lift my head a little."},
        {"zh": "我吐了一串小泡", "en": "I let out a small string of bubbles."},
        {"zh": "我伏在石影里慢慢鼓鳃", "en": "I lie in the stone's shade, gills working."},
        {"zh": "我在水底歇着", "en": "I rest on the bottom."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我游到你脚边", "en": "I swim to your feet."},
        {"zh": "我抬头望了望你", "en": "I look up at you."},
        {"zh": "我比你巴掌还小", "en": "I am smaller than your palm."},
        {"zh": "你踩进水里来了", "en": "You have stepped into the water."},
        {"zh": "我围着你踩出的水纹游", "en": "I circle the ripples your steps make."},
        {"zh": "我不躲，也不靠近", "en": "I neither hide nor come closer."},
        {"zh": "我贴着水面看你", "en": "I watch you from just under the surface."},
        {"zh": "你一动手我就沉下去", "en": "Move, and I sink away."},
        {"zh": "我停在那里不动", "en": "I stop and hold."},
        {"zh": "这里的水很浅", "en": "The water here is shallow."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "三叠纪的水，还是这股味。", "en": "Triassic water still tastes like this."},
        {"zh": "我被冲得翻了身", "en": "I am knocked over."},
        {"zh": "我又躲进石缝", "en": "I duck into the crevice."},
        {"zh": "血味在水里散开", "en": "The taste of blood spreads."},
        {"zh": "我游得歪歪斜斜", "en": "I swim crooked."},
        {"zh": "我的鳍垂下来了", "en": "My fins droop."},
        {"zh": "我贴在河底不动", "en": "I press to the bottom."},
        {"zh": "我摆尾缓过劲来", "en": "I beat my tail and recover."},
        {"zh": "我又摆尾游起来", "en": "I swim again."},
        {"zh": "我就一直躲在那里", "en": "I keep hiding."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有东西落下来", "en": "Something fell into the water."},
        {"zh": "我摆尾朝那边去", "en": "I flick my tail that way."},
        {"zh": "我碰了一下又躲开", "en": "I touch it and pull away."},
        {"zh": "这个不太合口", "en": "That is not quite right."},
        {"zh": "我围着它游了两圈", "en": "I circle it twice."},
        {"zh": "我抬头又沉下去", "en": "I rise and sink again."},
        {"zh": "我一摆尾游走了", "en": "One flick and I am off."},
        {"zh": "我又游回来看看", "en": "I come back to look."},
        {"zh": "这比我平常吃的硬", "en": "This is harder than my usual food."},
        {"zh": "我把它顶了一下", "en": "I butt it once."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我弹开了", "en": "You hit me and I dart away."},
        {"zh": "我被水推得翻了身", "en": "The water rolls me over."},
        {"zh": "我贴到你腿上", "en": "I brush your leg."},
        {"zh": "我吓得赶紧游开", "en": "I hurry away."},
        {"zh": "水面溅起一圈水花", "en": "A ring of spray goes up."},
        {"zh": "我从你靴子旁边窜开", "en": "I dart away past your boot."},
        {"zh": "我甩尾顶住水流站直", "en": "I beat my tail against the current and steady."},
        {"zh": "撞一下我就跑了", "en": "One bump and I flee."},
        {"zh": "我一头钻进石缝", "en": "I duck into a rock crevice."},
        {"zh": "我又慢慢游出来", "en": "Then I slowly come out."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一条游过来了", "en": "Another swims over."},
        {"zh": "我们贴着同一道水游", "en": "We swim the same current."},
        {"zh": "它比我稍大一点", "en": "It is a little larger than I."},
        {"zh": "我们绕着水草转", "en": "We circle the weeds."},
        {"zh": "我们尾巴碰了一下", "en": "Our tails touch once."},
        {"zh": "它游到我前面", "en": "It swims ahead of me."},
        {"zh": "我们一同浮起换气", "en": "We rise together to breathe."},
        {"zh": "我们都没什么声音", "en": "Neither of us makes a sound."},
        {"zh": "它转了个方向", "en": "It changes direction."},
        {"zh": "我摆尾跟了上去", "en": "I follow it."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口叼住它", "en": "I take it in my mouth."},
        {"zh": "我含着它不咽", "en": "I hold it without swallowing."},
        {"zh": "我吞了吞试试", "en": "I try to get it down."},
        {"zh": "那东西实在太大了", "en": "It is too big."},
        {"zh": "我一摆头吐了出来", "en": "I spit it out."},
        {"zh": "我又啃了一下", "en": "I nibble at it again."},
        {"zh": "我把它顶到石缝里", "en": "I push it into a crevice."},
        {"zh": "我绕着它游了两圈", "en": "I swim around it."},
        {"zh": "我干脆放弃了", "en": "I give up on it."},
        {"zh": "我摆尾游开了", "en": "I flick my tail and leave."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有什么在动", "en": "Something moves in the water."},
        {"zh": "我转向那个方向", "en": "I turn that way."},
        {"zh": "我摆尾准备冲", "en": "I cock my tail to dart."},
        {"zh": "我压低了贴近水底", "en": "I drop close to the bottom."},
        {"zh": "河里那点影子，比我还小。", "en": "The shadow in the river is smaller than me."},
        {"zh": "我在等它靠近", "en": "I wait for it to come near."},
        {"zh": "我把小嘴张开来", "en": "I open my small mouth."},
        {"zh": "我把鳍贴近河底的沙", "en": "I bring my fin close to the river sand."},
        {"zh": "这距离我量准了", "en": "I have measured the distance."},
        {"zh": "我把鳍都绷紧了", "en": "My fins go taut."},
        {"zh": "这一回我先摆尾", "en": "This time my tail moves first."},
        {"zh": "我要咬一口试试", "en": "I will try one bite."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着它游一圈", "en": "I circle it."},
        {"zh": "我贴着水底跟着", "en": "I track it along the bottom."},
        {"zh": "我贴着泥从旁边去", "en": "I come along the mud from the side."},
        {"zh": "我等它停下来", "en": "I wait for it to stop."},
        {"zh": "水声帮我藏着", "en": "The water hides me."},
        {"zh": "我慢慢缩小距离", "en": "I slowly close the gap."},
        {"zh": "我又绕半圈，换了角度", "en": "I circle half again for a better angle."},
        {"zh": "它还没留意到我", "en": "It has not paid me any mind."},
        {"zh": "我把身子沉得更低", "en": "I sink myself lower."},
        {"zh": "我离它只有一掌", "en": "I am a hand's width away."},
        {"zh": "我又等了一口气", "en": "I wait one more breath."},
        {"zh": "我摆正了方向", "en": "I straighten my course."},
        {"zh": "我不急着下嘴去咬", "en": "I am in no hurry to bite."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬住它的尾", "en": "I bite its tail."},
        {"zh": "我甩头扯了一下", "en": "I shake my head and pull."},
        {"zh": "它一甩身挣开了", "en": "It breaks free."},
        {"zh": "我又摆尾追上去", "en": "I chase after it."},
        {"zh": "我从底下撞它", "en": "I knock it from underneath."},
        {"zh": "水被我们搅浑了", "en": "We cloud the water."},
        {"zh": "我咬住了就不放", "en": "I clamp down."},
        {"zh": "它被我撞得偏了", "en": "I knock it off course."},
        {"zh": "我摆尾拍了一下", "en": "My tail slaps once."},
        {"zh": "我松口退开了", "en": "I let go and back off."},
        {"zh": "它一下逃进石缝", "en": "It escapes into the crevice."},
        {"zh": "我没有再追过去", "en": "I do not follow."}
      ]
    },
