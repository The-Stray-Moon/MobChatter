{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "四足压过三叠纪的泥。", "en": "Four legs press Triassic mud."},
        {"zh": "背甲一排排响。", "en": "My rows of plates clatter."},
        {"zh": "肩上的尖刺朝天。", "en": "Shoulder spikes point at the sky."},
        {"zh": "我慢慢穿过沼泽。", "en": "I cross the marsh slowly."},
        {"zh": "尾巴扫开芦苇。", "en": "My tail sweeps the reeds."},
        {"zh": "脚爪陷进湿泥。", "en": "My claws sink into wet mud."},
        {"zh": "我沿平原边缘走。", "en": "I walk the plain's edge."},
        {"zh": "重得像块会走的岩。", "en": "Heavy as walking rock."},
        {"zh": "每一步都很谨慎。", "en": "Every step is cautious."},
        {"zh": "我护着身后的窝。", "en": "I keep the nest behind me."},
        {"zh": "林地里的光很碎。", "en": "Light comes in pieces here."},
        {"zh": "脖子低低地伸着。", "en": "My neck stretches low."},
        {"zh": "我绕着水洼巡一圈。", "en": "I circle the pool once."},
        {"zh": "甲片互相推挤。", "en": "My plates crowd each other."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把背对着太阳。", "en": "I turn my back to the sun."},
        {"zh": "嚼一口硬叶。", "en": "I chew a tough leaf."},
        {"zh": "尖刺上有泥。", "en": "Mud dries on my spikes."},
        {"zh": "我抬头听了一会儿。", "en": "I raise my head and listen."},
        {"zh": "我呼吸得很慢。", "en": "My breathing is slow."},
        {"zh": "鳞甲下热得发闷。", "en": "It's stuffy under the plates."},
        {"zh": "我用后脚刨坑。", "en": "I scrape a pit with a hind foot."},
        {"zh": "风里有草味。", "en": "The wind carries grass."},
        {"zh": "窝里还有动静。", "en": "Something moves in the nest."},
        {"zh": "钦利组的沼泽，是我产卵的地方。", "en": "The Chinle marsh is where I lay eggs."},
        {"zh": "眼睛往两边看。", "en": "My eyes work both sides."},
        {"zh": "这里昼夜都一样长。", "en": "Day and night feel the same here."},
        {"zh": "我慢慢挪到高一点。", "en": "I ease up onto higher ground."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "站在尖刺外面。", "en": "Stand beyond the spikes."},
        {"zh": "你说不出我的名字吧。", "en": "You can't say my name, can you."},
        {"zh": "这条路通我的窝。", "en": "This path leads to my nest."},
        {"zh": "我身上没什么肉。", "en": "There's little meat on me."},
        {"zh": "你的手比我小。", "en": "Your hands are smaller than mine."},
        {"zh": "别摸我的肩刺。", "en": "Don't touch my shoulder spikes."},
        {"zh": "我吃草，也护地。", "en": "I eat grass. I guard ground."},
        {"zh": "你身上没有鳞。", "en": "You have no scales."},
        {"zh": "再近我就冲。", "en": "One step more and I charge."},
        {"zh": "你不是这个时代的东西。", "en": "You don't belong to this age."},
        {"zh": "看着我的背甲说话。", "en": "Talk to me while watching this armor."},
        {"zh": "我只给你一次机会。", "en": "I give you one chance."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲片被打得发响。", "en": "My plates rang out."},
        {"zh": "我横过身挡住。", "en": "I turned to shield myself."},
        {"zh": "侧腹没有甲。", "en": "My flank has no armor."},
        {"zh": "四条腿有点发软。", "en": "My four legs feel weak."},
        {"zh": "血混在泥里。", "en": "Blood mixes with the mud."},
        {"zh": "我四条腿还稳。", "en": "My four legs hold."},
        {"zh": "尖刺护着背，也疼。", "en": "Spikes guard my back, and it still hurts."},
        {"zh": "头低下去，尖刺朝你。", "en": "Head down, spikes toward you."},
        {"zh": "退一步也只是让步。", "en": "One step back is still just a step."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那堆蕨叶正合口。", "en": "That bracken is just right."},
        {"zh": "有根茎带来吗？", "en": "Any roots for me?"},
        {"zh": "放到我脚边来。", "en": "Set it by my feet."},
        {"zh": "我不爱吃软的。", "en": "I don't like soft food."},
        {"zh": "这味道很新鲜，是三叠纪没有的。", "en": "This smells fresh — nothing like the Triassic."},
        {"zh": "别举得太高了。", "en": "Don't hold it so high."},
        {"zh": "这片草比我窝边的好。", "en": "Better than the grass by my nest."},
        {"zh": "别站在窝那边。", "en": "Don't stand near the nest."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上尖刺了。", "en": "You charged into spikes."},
        {"zh": "我的背甲要先转。", "en": "My armor has to turn first."},
        {"zh": "我的甲比石头硬。", "en": "My armor is harder than stone."},
        {"zh": "别推我的尾巴。", "en": "Don't push my tail."},
        {"zh": "这一下你手疼吧。", "en": "Your hand must sting."},
        {"zh": "泥地被我们踩烂了。", "en": "We've churned the mud."},
        {"zh": "我脚下滑了。", "en": "My feet slipped."},
        {"zh": "再靠近，肩刺就不客气了。", "en": "One more step and my shoulder spikes won't be polite."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的窝里还有蛋。", "en": "There are eggs in my nest."},
        {"zh": "我得先守好这里。", "en": "I must hold this ground first."},
        {"zh": "现在是护幼的时候。", "en": "This is when I guard the young."},
        {"zh": "等我巡完这一圈。", "en": "After this patrol."},
        {"zh": "我的刺不欢迎接触。", "en": "My spikes don't welcome contact."},
        {"zh": "地界比什么都重要。", "en": "The territory matters most."},
        {"zh": "别碰窝边的土。", "en": "Don't touch the soil by the nest."},
        {"zh": "你慢慢说就好了。", "en": "Take your time saying it."},
        {"zh": "三叠纪的雨季很短。", "en": "The Triassic wet season is short."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块我能咬碎。", "en": "I can crush this."},
        {"zh": "草叶掉在地上了。", "en": "A blade fell on the ground."},
        {"zh": "用嘴叼起来。", "en": "I take it in my mouth."},
        {"zh": "根茎要挖出来。", "en": "The root needs digging out."},
        {"zh": "太重了，算了。", "en": "Too heavy. Never mind."},
        {"zh": "地上的果核。", "en": "A seed case on the ground."},
        {"zh": "放到窝边上。", "en": "I'll put it by the nest."},
        {"zh": "这气味不熟。", "en": "I don't know this smell."},
        {"zh": "石头我不吃。", "en": "I don't eat stones."},
        {"zh": "留着给我自己。", "en": "I'll keep it for myself."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有谁进了我的地界。", "en": "Someone entered my ground."},
        {"zh": "窝就在我后面。", "en": "The nest is behind me."},
        {"zh": "侧过身，把肩刺亮给你。", "en": "I turn sideways, shoulder spikes bared."},
        {"zh": "肩刺已经对准。", "en": "My shoulder spikes are aimed."},
        {"zh": "这股味道不是草木。", "en": "That smell isn't plant."},
        {"zh": "我先把头低下来。", "en": "I lower my head first."},
        {"zh": "再走就撞上了。", "en": "Another step and we collide."},
        {"zh": "沼泽那边也有人。", "en": "There's another over the marsh."},
        {"zh": "地面的震法不对。", "en": "The ground shakes wrong."},
        {"zh": "我把脚掌挖进土里。", "en": "My feet dig in."},
        {"zh": "喉咙里滚出低吼。", "en": "A bellow rolls in my throat."},
        {"zh": "我护着我的地。", "en": "I'm defending my ground."},
        {"zh": "从我的地界出去。", "en": "Get off my ground."},
        {"zh": "这次不吃草了。", "en": "Not eating grass this time."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步横着走。", "en": "I pace sideways."},
        {"zh": "我把它挤向水边。", "en": "I herd it toward the water."},
        {"zh": "背甲朝着它的牙。", "en": "My armor faces its teeth."},
        {"zh": "它绕，我也转。", "en": "It circles. So do I."},
        {"zh": "肩刺还空着。", "en": "My spikes haven't landed yet."},
        {"zh": "它的爪子在泥里打滑。", "en": "Its claws slip in the mud."},
        {"zh": "我不想追太远。", "en": "I won't chase far."},
        {"zh": "窝里有声音。", "en": "There's a sound in the nest."},
        {"zh": "我回到线内就停。", "en": "I stop once back inside the line."},
        {"zh": "尾巴准备好甩。", "en": "My tail is ready to swing."},
        {"zh": "脚掌压得更实。", "en": "My feet press firmer."},
        {"zh": "它看我的背了。", "en": "It's looking at my back."},
        {"zh": "背甲最厚的地方。", "en": "The thickest part of the armor."},
        {"zh": "喙先低下去，等它上来。", "en": "Beak lowered. Let it come."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "肩刺撞过去！", "en": "Shoulder spikes ram!"},
        {"zh": "整个身子横甩过去。", "en": "My whole body swings across."},
        {"zh": "尾巴抽你腿。", "en": "My tail cracks your legs."},
        {"zh": "低头，用肩刺顶！", "en": "Head down, spikes forward!"},
        {"zh": "我用整个背撞。", "en": "I charge with my whole back."},
        {"zh": "肩刺顶得很深。", "en": "The spike went deep."},
        {"zh": "你撞在刺上。", "en": "You hit the spikes."},
        {"zh": "我又压上去一次。", "en": "I press in again."},
        {"zh": "我的体重也伤人。", "en": "My weight is a weapon too."},
        {"zh": "侧身，再撞一次。", "en": "Turn side-on and hit again."},
        {"zh": "别摸我的肩。", "en": "Don't reach for my shoulder."},
        {"zh": "你根本挡不住。", "en": "You can't block this at all."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从芦苇丛里出来。", "en": "I come out of the reeds."},
        {"zh": "钦利组的干地上。", "en": "On the dry Chinle ground."},
        {"zh": "背甲先露出来。", "en": "My armor shows first."},
        {"zh": "这里是三叠纪的平原。", "en": "This is the Triassic plain."},
        {"zh": "我走了一圈。", "en": "I walked one circuit."},
        {"zh": "湿泥顺着甲缝流。", "en": "Wet mud runs down the seams."},
        {"zh": "我的窝就在那。", "en": "My nest is right there."},
        {"zh": "没有谁欢迎我来。", "en": "No one welcomed me."},
        {"zh": "我慢慢移到水边。", "en": "I ease down to the water."},
        {"zh": "这地界一直是我的。", "en": "This ground has always been mine."},
        {"zh": "尖刺上挂着草。", "en": "Grass hangs on my spikes."},
        {"zh": "我抬起头看看。", "en": "I raise my head to look."},
        {"zh": "脚下的泥很软。", "en": "The mud is soft here."},
        {"zh": "太阳正照我背上。", "en": "The sun rests on my back."},
        {"zh": "一个新来的气味。", "en": "A new smell."},
        {"zh": "喉咙里滚出一声。", "en": "A sound rolls from my throat."},
        {"zh": "我在这里站定了。", "en": "I've taken my stand here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "背甲被烤得发烫。", "en": "My plates bake in the heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时甲片震得发麻。", "en": "The landing numbed my plates."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽的水灌进嘴里。", "en": "Marsh water fills my mouth."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "甲片被震开了缝。", "en": "The blast opened a seam."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头卡进甲缝。", "en": "An arrow lodged in a seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股热从缝里钻进来。", "en": "Heat crawls through the seams."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得走不快。", "en": "Hunger slows my walk."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着尖刺走。", "en": "Lightning runs down my spikes."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "泥地没有了。", "en": "The mud is gone."}
      ]
    }
  }
}
