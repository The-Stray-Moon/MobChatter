{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着沙丘快走。", "en": "I move quickly along the dune."},
        {"zh": "我绕开干涸的河床。", "en": "I skirt the dry riverbed."},
        {"zh": "我回到蛋旁边看一眼。", "en": "I go back to check the eggs."},
        {"zh": "沙地上留下三趾印。", "en": "Three-toed prints in the sand."},
        {"zh": "我伸长脖子探路。", "en": "I stretch my neck to scout."},
        {"zh": "这片冲积平原很空。", "en": "This alluvial plain is empty."},
        {"zh": "我边跑边看两边。", "en": "I run while watching both sides."},
        {"zh": "我怕惊动别的东西。", "en": "I'm wary of startling anything."},
        {"zh": "我贴着灌木过去。", "en": "I slip past the shrubs."},
        {"zh": "我低着头往前走。", "en": "I walk with my head low."},
        {"zh": "风一吹我就停。", "en": "A gust stops me."},
        {"zh": "我把脚下的石子踢开。", "en": "I kick the pebbles aside."},
        {"zh": "我跳上低矮的土包。", "en": "I hop onto a low mound."},
        {"zh": "我小跑着回巢。", "en": "I trot back to the nest."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在蛋上面。", "en": "I crouch over the eggs."},
        {"zh": "我的羽毛张着。", "en": "My feathers are fluffed."},
        {"zh": "我慢慢转了转脖子。", "en": "I turn my neck slowly."},
        {"zh": "我听见沙里有动静。", "en": "I hear something in the sand."},
        {"zh": "我轻轻碰了一下蛋。", "en": "I touch an egg gently."},
        {"zh": "风向现在正好。", "en": "The wind direction is good."},
        {"zh": "我抬起头看天。", "en": "I look up at the sky."},
        {"zh": "我挪了挪两只脚。", "en": "I shift my feet."},
        {"zh": "我很小，但很警觉。", "en": "I'm small but alert."},
        {"zh": "我咽了一口口水。", "en": "I swallow."},
        {"zh": "我盯着沙丘顶上。", "en": "I stare at the dune top."},
        {"zh": "窝边还得再守一阵。", "en": "A little longer."},
        {"zh": "我把头贴近蛋。", "en": "I put my head near the eggs."},
        {"zh": "安静一点就好。", "en": "Quiet is good."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我张开手臂挡着。", "en": "I spread my arms to block."},
        {"zh": "蛋就放在我身后。", "en": "The eggs are behind me."},
        {"zh": "你到底要做什么？", "en": "What do you intend?"},
        {"zh": "我害怕，但我不会走。", "en": "I'm afraid, but I won't leave."},
        {"zh": "你先退后两步。", "en": "Two steps back, please."},
        {"zh": "这气味我认得，蛋在哪？", "en": "I know this scent. Where are the eggs?"},
        {"zh": "我脖子伸得很长了。", "en": "My neck is fully stretched."},
        {"zh": "你动作慢一点。", "en": "Move more slowly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫了一声，缩起来。", "en": "I cry out and shrink down."},
        {"zh": "我把身子压在窝边上。", "en": "I press myself against the nest's rim."},
        {"zh": "我很疼，但我不走。", "en": "It hurts, but I won't leave."},
        {"zh": "我把蛋往身下拢紧", "en": "I gather the eggs tighter beneath me."},
        {"zh": "这点伤还撑得住。", "en": "I can still hold on."},
        {"zh": "我护着这些蛋。", "en": "I'm shielding them."},
        {"zh": "我守着蛋，你别过来。", "en": "I'm guarding the eggs — stay back."},
        {"zh": "嘶……我不是凶，只是怕。", "en": "Hiss… I'm not fierce, just frightened."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会离开这些蛋。", "en": "I won't leave the eggs."},
        {"zh": "你放在那边就好。", "en": "Just set it over there."},
        {"zh": "我伸脖子够一下。", "en": "I'll stretch my neck for it."},
        {"zh": "这东西，能吃吗？", "en": "Can I eat this?"},
        {"zh": "不够我吃一口。", "en": "Not even a mouthful."},
        {"zh": "你退开我才吃。", "en": "I'll eat once you back off."},
        {"zh": "这味道不像沙子。", "en": "This doesn't smell like sand."},
        {"zh": "我得守着这一窝蛋。", "en": "I must guard the eggs."},
        {"zh": "你先放在地上。", "en": "Put it on the ground first."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我身上了。", "en": "You bumped into me."},
        {"zh": "我退到蛋前面。", "en": "I back up in front of the eggs."},
        {"zh": "我身子很轻，被撞开了。", "en": "I'm light, so I got pushed aside."},
        {"zh": "别踩这边的沙。", "en": "Don't step on this sand."},
        {"zh": "我撞在灌木上。", "en": "I hit the shrub."},
        {"zh": "你把我吓了一跳。", "en": "That startled me."},
        {"zh": "你的脚太近了。", "en": "Your foot is too close."},
        {"zh": "我绕回蛋的旁边。", "en": "I get back to the eggs."},
        {"zh": "别碰这一片沙地。", "en": "Don't touch this patch."},
        {"zh": "我没事，你别过来。", "en": "I'm fine; don't come closer."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我正在守这个窝。", "en": "I'm minding the nest."},
        {"zh": "你先等这一窝。", "en": "Wait till this clutch is done."},
        {"zh": "沙丘上很安静。", "en": "The dunes are quiet."},
        {"zh": "我们轮流坐着。", "en": "We take turns sitting."},
        {"zh": "你把头低一点。", "en": "Lower your head a little."},
        {"zh": "风会吹动沙子的。", "en": "The wind stirs the sand."},
        {"zh": "你走到这边来。", "en": "Come over this side."},
        {"zh": "我们别惊动蛋。", "en": "Let's not disturb the eggs."},
        {"zh": "你别大声嚷嚷。", "en": "Don't make noise."},
        {"zh": "就这样守着吧。", "en": "Just stay like this."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这该不会是个蛋吧？", "en": "This isn't an egg, is it?"},
        {"zh": "我用嘴拨了拨。", "en": "I nudge it with my beak."},
        {"zh": "这东西太硬了。", "en": "Too hard."},
        {"zh": "这东西我咽不下去。", "en": "I don't eat this."},
        {"zh": "它卡在沙子里。", "en": "It's stuck in the sand."},
        {"zh": "我用嘴把它拱进沙里", "en": "I nudge it into the sand with my snout."},
        {"zh": "这蛋不是我的，但我守着。", "en": "This egg isn't mine, but I guard it."},
        {"zh": "我闻了闻就走。", "en": "I sniff and leave."},
        {"zh": "别放在窝边上。", "en": "Don't put it by the nest."},
        {"zh": "我把它踢到沙里。", "en": "I'll leave it alone."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "沙丘上有影子。", "en": "A shadow on the dune."},
        {"zh": "我挡在蛋前面。", "en": "I stand in front of the eggs."},
        {"zh": "我把羽毛炸开。", "en": "I puff up my feathers."},
        {"zh": "我先发出低叫。", "en": "First, a low call."},
        {"zh": "这条线不能过。", "en": "This line can't be crossed."},
        {"zh": "它们还在孵蛋。", "en": "They're still incubating."},
        {"zh": "我把脖子伸长。", "en": "I stretch my neck out."},
        {"zh": "我已经准备咬了。", "en": "I'm ready to bite."},
        {"zh": "你再近我就动手。", "en": "One step more and I act."},
        {"zh": "你看着我的嘴。", "en": "Watch my beak."},
        {"zh": "我是不会退的。", "en": "I don't retreat."},
        {"zh": "就守在这道沙脊上。", "en": "Here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕到蛋的侧面。", "en": "I move to the side of the eggs."},
        {"zh": "蛋是我的，别伸手。", "en": "The eggs are mine — don't reach."},
        {"zh": "我把蛋护在肚子下面", "en": "I tuck the eggs beneath my belly."},
        {"zh": "我不叫，但我盯着。", "en": "I don't call, but I stare."},
        {"zh": "沙上你的脚印很清楚。", "en": "Your prints show clearly in the sand."},
        {"zh": "我脖子一直朝你。", "en": "My neck stays pointed at you."},
        {"zh": "我再警告一次。", "en": "One more warning."},
        {"zh": "你别想骗我走开。", "en": "Don't think you can lure me away."},
        {"zh": "我再等上片刻。", "en": "Endure a moment more."},
        {"zh": "这一口要咬得准。", "en": "This bite must be true."},
        {"zh": "羽毛已经炸开了。", "en": "I'm ready."},
        {"zh": "趁它还没退开。", "en": "Now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我张嘴就是一啄。", "en": "I bite."},
        {"zh": "我用头撞上去。", "en": "I butt forward."},
        {"zh": "爪子抓在你手上。", "en": "My claws rake your hand."},
        {"zh": "我伸长脖子去啄你的手", "en": "I stretch my neck to peck your hand."},
        {"zh": "这一下是为了蛋。", "en": "That one was for the eggs."},
        {"zh": "我跳起来啄它。", "en": "I leap and peck."},
        {"zh": "你被吓了一跳。", "en": "You flinched."},
        {"zh": "我不敢追得太远。", "en": "I won't chase far."},
        {"zh": "你现在回窝里去。", "en": "Back to the nest."},
        {"zh": "我张嘴又是一下。", "en": "My beak snaps again."},
        {"zh": "我原地跳起扑过去。", "en": "I spring at you in place."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在沙丘的斜面。", "en": "I stand on the dune's slope."},
        {"zh": "脚下是细软的沙。", "en": "Fine sand underfoot."},
        {"zh": "我先找窝的位置。", "en": "First, find a nest site."},
        {"zh": "这里的风很小。", "en": "The wind is mild here."},
        {"zh": "地上有别的脚印。", "en": "Other tracks are here."},
        {"zh": "我把沙子扒开。", "en": "I scrape the sand aside."},
        {"zh": "我要坐下来了。", "en": "I'm going to settle."},
        {"zh": "远处是一片河床。", "en": "A riverbed in the distance."},
        {"zh": "我绕着沙丘走了一圈。", "en": "I turn once."},
        {"zh": "这地方够隐蔽。", "en": "Good cover here."},
        {"zh": "那就先守窝吧。", "en": "Begin."},
        {"zh": "这里安静一点。", "en": "Quiet."},
        {"zh": "我已经坐下了。", "en": "I'm sitting."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的羽毛，我往沙里钻。", "en": "Fire caught my feathers; I burrow into the sand."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙丘上滚下来，满身是沙。", "en": "I rolled down the dune, covered in sand."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我往下拖。", "en": "Water drags me under."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀到沙丘另一面。", "en": "The blast threw me to the far side of the dune."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量扯得我站不稳。", "en": "That force left me unsteady."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得没力气守窝。", "en": "Too hungry to guard the nest."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在沙丘上，我跳起来。", "en": "Lightning hit the dune; I leapt."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "沙下面忽然空了。", "en": "The sand beneath me gave way."}
      ]
    }
  }
}
