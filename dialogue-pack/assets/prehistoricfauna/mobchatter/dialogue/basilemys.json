    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我脖子一直朝那边", "en": "My neck stays pointed that way."},
        {"zh": "我的头伸得很低", "en": "My head stays low."},
        {"zh": "我一寸寸往草里退", "en": "I inch back into the grass."},
        {"zh": "它还没走到跟前", "en": "It has not come up close."},
        {"zh": "我在等它过去", "en": "I wait for it to pass."},
        {"zh": "我一动壳就响", "en": "My shell rattles when I move."},
        {"zh": "草叶一动，我就缩进壳。", "en": "One grass stir and I pull into my shell."},
        {"zh": "我离水边很近", "en": "I am close to the water's edge."},
        {"zh": "它绕到了另一边", "en": "It has gone around."},
        {"zh": "我再趴着等一阵", "en": "I lie low and wait some more."},
        {"zh": "我把脚收在身下", "en": "I draw my feet under me."},
        {"zh": "我壳里壳外都没声", "en": "There is no sound from me at all."},
        {"zh": "它抬头看了看", "en": "It has raised its head."}
      ]
    },
    "melee_attack": {
