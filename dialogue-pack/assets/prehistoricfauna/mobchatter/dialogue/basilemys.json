{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着龟壳慢慢走", "en": "I drag my shell along."},
        {"zh": "我的四只短腿挪着", "en": "My four short legs shuffle."},
        {"zh": "我从河岸爬向草地", "en": "I crawl from the bank to the grass."},
        {"zh": "我一步只挪一点", "en": "Each step gains very little."},
        {"zh": "我背着壳挤过草丛", "en": "I push through the grass shell-first."},
        {"zh": "我绕开一块大石头", "en": "I go around a big stone."},
        {"zh": "我从林间空地走过", "en": "I cross the clearing."},
        {"zh": "我挪到有光的地方", "en": "I move into the sunlight."},
        {"zh": "我沿着崖边小心地走", "en": "I pick along the cliff edge."},
        {"zh": "我的壳碰到树干", "en": "My shell knocks a trunk."},
        {"zh": "我慢慢转到另一条路", "en": "I turn onto another path."},
        {"zh": "我停下来又继续", "en": "I stop, then go on."},
        {"zh": "我踩着落叶往前", "en": "I walk over the fallen leaves."},
        {"zh": "我沿着水边挪", "en": "I shuffle along the water's edge."},
        {"zh": "我把身体挪了个方向", "en": "I shift my body's direction."},
        {"zh": "我一步一顿地爬", "en": "I crawl a step at a time."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把头伸出来", "en": "I poke my head out."},
        {"zh": "我趴在草里不动", "en": "I lie still in the grass."},
        {"zh": "我的壳晒得发暖", "en": "My shell is warm from the sun."},
        {"zh": "我慢慢环顾四周", "en": "I look around slowly."},
        {"zh": "我的头缩回去一半", "en": "I pull my head halfway in."},
        {"zh": "我缩在壳里不动", "en": "I stay drawn into my shell."},
        {"zh": "我在叶子上歇脚", "en": "I rest on the leaves."},
        {"zh": "我的脚收在壳下", "en": "My feet are tucked under my shell."},
        {"zh": "我在太阳下晒着", "en": "I bask in the sun."},
        {"zh": "我眨了眨湿润的眼", "en": "I blink my moist eye."},
        {"zh": "我吞了一口空气", "en": "I gulp a mouthful of air."},
        {"zh": "我等林子静下来", "en": "I wait for the woods to quiet."},
        {"zh": "我把脖子伸了伸", "en": "I stretch my neck."},
        {"zh": "我慢慢挪了两寸", "en": "I shift two inches slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从壳里探出头", "en": "I poke my head from my shell."},
        {"zh": "我抬眼看了你一下", "en": "I glance up at you."},
        {"zh": "我这壳这么小，藏得下整只。", "en": "This shell is small, and it hides all of me."},
        {"zh": "你站得有点近", "en": "You are standing rather close."},
        {"zh": "我不动，也不走。", "en": "I won't move, and I won't leave."},
        {"zh": "我的头伸得长长的", "en": "My neck is stretched out."},
        {"zh": "我看你一眼又低头", "en": "I glance at you and look down."},
        {"zh": "你在我的影子里", "en": "You are in my shadow."},
        {"zh": "我挪了挪四只短腿", "en": "I shift my four short legs."},
        {"zh": "我又把头伸出来", "en": "I poke my head out again."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我立刻缩进壳里", "en": "I retract at once."},
        {"zh": "我的壳被磕了一下", "en": "My shell takes a knock."},
        {"zh": "我听见壳里有响声", "en": "Something rattles inside my shell."},
        {"zh": "我半天没敢动", "en": "I dare not move for a while."},
        {"zh": "我的头缩得很深", "en": "My head is pulled in deep."},
        {"zh": "我慢慢又伸出来", "en": "I slowly come back out."},
        {"zh": "这一下打在壳上", "en": "That one hit my shell."},
        {"zh": "我往前挪了两寸", "en": "I shift two inches."},
        {"zh": "我仍然一动不动", "en": "I still do not move."},
        {"zh": "我等了很久才敢动", "en": "I waited long before moving."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是嫩叶的味道", "en": "That smells like tender leaves."},
        {"zh": "我朝那边挪过去", "en": "I shuffle that way."},
        {"zh": "我低下头啃了一口", "en": "I lower my head and bite."},
        {"zh": "这片叶太老，我换一片", "en": "This leaf is too old; I pick another."},
        {"zh": "我又换了一片叶", "en": "I move to another leaf."},
        {"zh": "我慢条斯理地嚼叶", "en": "I chew the leaf in no hurry."},
        {"zh": "这根本不是草", "en": "This is not grass."},
        {"zh": "我抬了下头又低下", "en": "I lift my head and lower it."},
        {"zh": "我低头接着啃这片叶", "en": "I lower my head and keep chewing this leaf."},
        {"zh": "我挪开了一点", "en": "I shuffle away a little."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我缩进壳里", "en": "You bump me and I retract."},
        {"zh": "我的壳被碰了一下", "en": "My shell is knocked."},
        {"zh": "我原地转了个方向", "en": "I turn in place."},
        {"zh": "我的短腿被你踩住", "en": "Your foot pins my stubby leg."},
        {"zh": "我慢慢地爬开", "en": "I crawl slowly away."},
        {"zh": "我缩着直到你走开", "en": "I stay in until you leave."},
        {"zh": "壳碰着石头响了一声", "en": "My shell knocks a stone."},
        {"zh": "我迟疑着把头探出", "en": "I hesitantly poke my head out."},
        {"zh": "我挪动了两寸", "en": "I shift two inches."},
        {"zh": "我慢吞吞不赶时间", "en": "I am not rushing at all."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只慢慢爬过来", "en": "Another crawls over slowly."},
        {"zh": "我们的壳碰在一起", "en": "Our shells touch."},
        {"zh": "我们一起晒太阳", "en": "We bask in the sun together."},
        {"zh": "它壳比我小一号", "en": "Its shell is a size smaller."},
        {"zh": "我们并排啃叶子", "en": "We chew leaves side by side."},
        {"zh": "它的头伸得比我长", "en": "Its neck stretches longer than mine."},
        {"zh": "我们一起缩进壳里", "en": "We retract into our shells together."},
        {"zh": "我们两个一声不吭", "en": "Neither of us makes a peep."},
        {"zh": "它自己挪了半步", "en": "It shuffles half a step."},
        {"zh": "我不紧不慢跟着", "en": "I follow at my own pace."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬下一片叶子", "en": "I bite off a leaf."},
        {"zh": "我一口口把叶咽下", "en": "I get the leaf down bite by bite."},
        {"zh": "我又啃下一小片", "en": "I bite off another flake."},
