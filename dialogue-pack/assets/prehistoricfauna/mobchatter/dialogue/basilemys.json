    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我把头缩了一半", "en": "I pull my head halfway in."},
        {"zh": "我听见了动静", "en": "I heard something."},
        {"zh": "我一下停住不动", "en": "I stop moving."},
        {"zh": "我往草丛里挪", "en": "I shift toward the grass."},
        {"zh": "我在找最近的地方躲", "en": "I look for the nearest cover."},
        {"zh": "我的脚收紧了", "en": "My feet draw in."},
        {"zh": "我把壳贴到地上", "en": "I lower my shell to the ground."},
        {"zh": "我先看它是谁", "en": "First I see who it is."},
        {"zh": "我还没打算跑", "en": "I do not mean to run yet."},
        {"zh": "我又把头伸出去", "en": "I poke my head out again."},
        {"zh": "那个影子越来越近", "en": "That shadow is coming closer."},
        {"zh": "我把壳掉了个向", "en": "I swing my shell around."}
