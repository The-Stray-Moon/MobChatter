{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我轻快地窜过去。", "en": "I dart lightly across."},
        {"zh": "爪子扣在干沙上。", "en": "My claws dig into the dry sand."},
        {"zh": "我身体低，贴着地面跑。", "en": "I keep low and skim the ground."},
        {"zh": "尾巴直着，稳住方向。", "en": "My tail holds straight to keep my line."},
        {"zh": "我三步就跨过沟。", "en": "Three strides clear the ditch."},
        {"zh": "我停在沙丘顶上。", "en": "I stop on the crest of the dune."},
        {"zh": "晨昏的风，凉。", "en": "The dawn wind is cool."},
        {"zh": "我侧头听了一下。", "en": "I tilt my head to listen."},
        {"zh": "我绕一块石头过去。", "en": "I go around a boulder."},
        {"zh": "我一边走一边嗅地。", "en": "I walk and sniff the ground."},
        {"zh": "脚步很轻，几乎没声。", "en": "My steps are very light, almost silent."},
        {"zh": "我冲着那个方向去。", "en": "I head that way."},
        {"zh": "我踩碎了一片干叶。", "en": "I crackle a dry leaf."},
        {"zh": "我贴着草丛穿过去。", "en": "I slip through the grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，头转来转去。", "en": "I stand, head turning."},
        {"zh": "我在看有没有能扑的东西。", "en": "I am looking for something to pounce on."},
        {"zh": "我顺了顺腿上的羽。", "en": "I smooth the feathers on my leg."},
        {"zh": "这片沙丘很空。", "en": "These dunes are empty."},
        {"zh": "我压低身子歇着。", "en": "I crouch low to rest."},
        {"zh": "我数着远处的动静。", "en": "I count the far-off noises."},
        {"zh": "我提起一条后腿。", "en": "I lift one hind leg."},
        {"zh": "我没有成年同类大。", "en": "I am not as big as the grown ones."},
        {"zh": "我盯着一个洞。", "en": "I stare at a hole."},
        {"zh": "我又转了个方向。", "en": "I turn another way."},
        {"zh": "风带着一点血味。", "en": "The wind carries a hint of blood."},
        {"zh": "我不动，等着。", "en": "I hold still and wait."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯上你了，这身羽毛不为好看。", "en": "I have you marked; these feathers are not decoration."},
        {"zh": "你比我还高。", "en": "You are taller than I am."},
        {"zh": "我先绕一圈。", "en": "I will circle once first."},
        {"zh": "我跳上猎物背上，就咬。", "en": "I leap onto prey and bite from there."},
        {"zh": "扑上去骑住猎物，边骑边咬。", "en": "I leap onto prey and bite while riding it."},
        {"zh": "你的腿很粗。", "en": "Your legs are thick."},
        {"zh": "我从这边看，你处处是破绽。", "en": "From here you are all openings."},
        {"zh": "我跳了一下，试试距离。", "en": "I hop once to test the distance."},
        {"zh": "你退了，我跟着。", "en": "You retreat, and I follow."},
        {"zh": "我看到你的喉咙了。", "en": "I see your throat."},
        {"zh": "你别转过来。", "en": "Do not turn around."},
        {"zh": "我个子小，但很快。", "en": "I am small, but fast."},
        {"zh": "你有些犹豫。", "en": "You are hesitating."},
        {"zh": "那是我的机会。", "en": "That is my chance."},
        {"zh": "我压低身子，喉咙里滚出一声。", "en": "I crouch low and a growl rolls from my throat."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打得滚了一圈。", "en": "The blow rolled me over."},
        {"zh": "我滚进沙丘的阴影里，喘着气。", "en": "I roll into the dune's shadow, gasping."},
        {"zh": "这一下，驰龙爪都蹭钝了。", "en": "That blow dulled my sickle claw."},
        {"zh": "我气都喘不匀。", "en": "I cannot get my breath even."},
        {"zh": "我腿上有一道口。", "en": "There is a gash on my leg."},
        {"zh": "我腿还能动。", "en": "My legs still work."},
        {"zh": "你打得很准，这一下疼。", "en": "Your aim was true, and it hurts."},
        {"zh": "这还不算完。", "en": "This is not finished."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "小块肉？给我。", "en": "A small piece of meat? Give it here."},
        {"zh": "生肉的血味顺着风钻进我鼻孔。", "en": "The scent of raw meat curls into my nostrils on the wind."},
        {"zh": "扔过来，我跳着接。", "en": "Toss it; I will leap for it."},
        {"zh": "这点塞不满牙。", "en": "This will not fill my teeth."},
        {"zh": "我一截截挪近。", "en": "I creep in, bit by bit."},
        {"zh": "我会驯服你的。", "en": "I will tame you."},
        {"zh": "我一口就叼走。", "en": "I will snatch it in one bite."},
        {"zh": "这个味道好。", "en": "This smells good."},
        {"zh": "再扔一块过来。", "en": "Throw another piece."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你几乎没被推动。", "en": "You barely moved."},
        {"zh": "我被撞得打了个滚。", "en": "I rolled from that knock."},
        {"zh": "我立刻翻身站起。", "en": "I right myself at once."},
        {"zh": "你的腿太硬。", "en": "Your leg is too hard."},
        {"zh": "我换个方位。", "en": "I change my approach."},
        {"zh": "这一撞不划算。", "en": "That collision was a bad trade."},
        {"zh": "我退开重整。", "en": "I back off and reset."},
        {"zh": "重来上一次。", "en": "Let us try again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们得一起围。", "en": "We have to surround it together."},
        {"zh": "你从那边，我这边。", "en": "You take that side; I take this."},
        {"zh": "叫一声，让别的来。", "en": "Call, and bring the others."},
        {"zh": "我先上，你接。", "en": "I go first; you follow."},
        {"zh": "小块的肉留给我。", "en": "Leave me the small piece."},
        {"zh": "我们不长住一处。", "en": "We do not stay in one place."},
        {"zh": "风从那边来。", "en": "The wind comes from that side."},
        {"zh": "慢慢把圈合上。", "en": "Close the circle slowly."},
        {"zh": "别抢在我前面。", "en": "Do not get ahead of me."},
        {"zh": "就趁此刻。", "en": "Now, then."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住就溜。", "en": "I bite it and slip away."},
        {"zh": "这口小，但够。", "en": "A small bite, but enough."},
        {"zh": "我藏在石头下。", "en": "I hide it under a stone."},
        {"zh": "这根本没有肉。", "en": "There is no meat in this."},
        {"zh": "我试了一口。", "en": "I tried a bite."},
        {"zh": "我先埋起来。", "en": "I will bury it first."},
        {"zh": "勉强还能吃。", "en": "Barely edible."},
        {"zh": "硬得磕牙。", "en": "Hard enough to chip a tooth."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你脚下动了。", "en": "Your feet moved."},
        {"zh": "我伏得更低。", "en": "I go lower still."},
        {"zh": "你的小腿筋在跳，我看见了。", "en": "The tendon in your calf twitches — I see it."},
        {"zh": "距离算好了。", "en": "The distance is worked out."},
        {"zh": "后腿绷紧了。", "en": "My hind legs are taut."},
        {"zh": "我一扑就到了。", "en": "One pounce and I am there."},
        {"zh": "你插翅难飞。", "en": "You cannot fly away."},
        {"zh": "我记住了你的动作。", "en": "I have your movements."},
        {"zh": "我准备起跳。", "en": "I am ready to spring."},
        {"zh": "这一只归我。", "en": "This one is mine."},
        {"zh": "风帮我藏住了气味。", "en": "The wind hides my scent."},
        {"zh": "后腿绷紧，我就要扑上去了。", "en": "My hind legs coil; I am about to leap."},
        {"zh": "别把身子转过来。", "en": "Do not turn around."},
        {"zh": "我扑上来了。", "en": "I am on you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你每走一步，我就近一点。", "en": "Each step of yours brings me closer."},
        {"zh": "我蹲下又站起。", "en": "I crouch and rise."},
        {"zh": "我绕着猎物转。", "en": "I circle my prey."},
        {"zh": "我从你背后的沙丘过来。", "en": "I come over the dune behind you."},
        {"zh": "风还在帮我。", "en": "The wind is still helping."},
        {"zh": "再凑近两步。", "en": "Two steps nearer."},
        {"zh": "我把爪子收了一下。", "en": "I flex my claws."},
        {"zh": "你把侧背露了。", "en": "You showed me your flank."},
        {"zh": "我停住，等你放松。", "en": "I freeze and wait for you to relax."},
        {"zh": "几乎够到后腿。", "en": "Nearly at its hind leg."},
        {"zh": "我一动，你就知道了。", "en": "The moment I move, you will know."},
        {"zh": "我等你分心。", "en": "I wait for you to lose focus."},
        {"zh": "现在距离刚好。", "en": "This distance is right."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一扑，抓住你的背。", "en": "I pounce and catch your back."},
        {"zh": "我骑在猎物身上咬。", "en": "I ride my prey and bite."},
        {"zh": "我的爪子先扣进去。", "en": "My claws dig in first."},
        {"zh": "你被撕开一块。", "en": "A piece of you is torn."},
        {"zh": "我跳到另一个位置。", "en": "I leap to another spot."},
        {"zh": "这一抓很深。", "en": "That rake went deep."},
        {"zh": "我差点被甩下来。", "en": "I nearly got thrown off."},
        {"zh": "你没抓住我。", "en": "You did not catch me."},
        {"zh": "我压低身子再咬。", "en": "I drop low and bite again."},
        {"zh": "血溅到我身上。", "en": "Blood splashes on me."},
        {"zh": "我踏后了半步。", "en": "I stepped half a pace back."},
        {"zh": "再骑上去咬。", "en": "I ride in and bite again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙丘后钻出来。", "en": "I come out from behind the dune."},
        {"zh": "一个小小的影子跑过。", "en": "A small shadow runs past."},
        {"zh": "我的爪子先落地。", "en": "My claws land first."},
        {"zh": "干沙上多了一串爪印。", "en": "A line of claw prints appears in the dry sand."},
        {"zh": "我抬起头，眼睛很亮。", "en": "I raise my head, eyes bright."},
        {"zh": "风把我带来的。", "en": "The wind carried me here."},
        {"zh": "我抖了抖羽毛，尘土飞起。", "en": "I shake my feathers; dust flies."},
        {"zh": "我立在一块石头上。", "en": "I stand on a stone."},
        {"zh": "这里有肉味。", "en": "There is meat smell here."},
        {"zh": "太阳刚要落下。", "en": "The sun is about to set."},
        {"zh": "我的个头不大。", "en": "I am not large."},
        {"zh": "我从冲沟里跃上来。", "en": "I leap up out of the wash."},
        {"zh": "我环顾四周。", "en": "I look all around."},
        {"zh": "骑上猎物，我就咬。", "en": "I ride my prey and bite."},
        {"zh": "先试探一步。", "en": "I test one step first."},
        {"zh": "我已经闻到肉味了。", "en": "I can already smell meat."},
        {"zh": "我开始跑起来。", "en": "I start running."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我的羽毛焦了。", "en": "Flames scorched my feathers."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处跳下，落地不稳。", "en": "I jumped from a height and landed badly."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到脖子，我拼命蹬。", "en": "Water is at my neck and I kick hard."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我吹出很远。", "en": "The blast threw me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上猎物背上，边骑边咬。", "en": "I leap onto prey and bite while riding it."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我毛发直竖。", "en": "This light makes my feathers stand."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有猎物，我快撑不住。", "en": "No prey, and I can barely last."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声吓得我一缩。", "en": "The thunder made me flinch."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有沙可以扒。", "en": "There is no sand to dig here."}
      ]
    }
  }
}
