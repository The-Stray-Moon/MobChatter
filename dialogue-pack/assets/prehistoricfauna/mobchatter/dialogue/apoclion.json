{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着墙面往上走。", "en": "I walk up the wall's face."},
        {"zh": "六只脚，走哪儿都行。", "en": "Six legs. Any surface will do."},
        {"zh": "我贴在墙上，像一块苔。", "en": "On the wall, I look like a patch of moss."},
        {"zh": "我从这片叶子走到那片。", "en": "I cross from leaf to leaf."},
        {"zh": "我很小，你不容易看见。", "en": "I am small; you will hardly see me."},
        {"zh": "我顺着树皮下去。", "en": "I go down the bark."},
        {"zh": "地面上的我更慢。", "en": "I am slower on open ground."},
        {"zh": "我绕着湖边走。", "en": "I work my way around the lake."},
        {"zh": "肘节一伸一缩，走得很稳。", "en": "My joints flex and I keep steady."},
        {"zh": "我钻到树根下面。", "en": "I slip beneath a root."},
        {"zh": "我停在矮枝上。", "en": "I halt on a low twig."},
        {"zh": "风一大，我就得抓紧。", "en": "When the wind rises I must grip."},
        {"zh": "我从墙缝里出来。", "en": "I come out of a crack in the wall."},
        {"zh": "我在林间低处爬。", "en": "I creep low through the wood."},
        {"zh": "我的触须一直在探。", "en": "My feelers never stop probing."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴在树皮上。", "en": "I cling to the bark."},
        {"zh": "壳下面有水汽。", "en": "Moisture gathers under my shell."},
        {"zh": "我一动不动，像一块苔。", "en": "I am still as moss."},
        {"zh": "我收起了腿。", "en": "I tuck in my legs."},
        {"zh": "我的翅膀很薄。", "en": "My wings are very thin."},
        {"zh": "这面墙很凉。", "en": "This wall is cool."},
        {"zh": "我在再生林里长大。", "en": "I grew up in the regrowth."},
        {"zh": "湖上有风。", "en": "Wind over the lake."},
        {"zh": "我的关节在轻响。", "en": "My joints tick softly."},
        {"zh": "有人在附近走动。", "en": "Someone is moving nearby."},
        {"zh": "我要藏好。", "en": "I must hide well."},
        {"zh": "我的甲壳和树皮一个颜色。", "en": "My shell matches the bark."},
        {"zh": "我闭了闭眼睛。", "en": "I close my eyes briefly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我比你想象的小得多。", "en": "I am much smaller than you think."},
        {"zh": "别用指头碰我。", "en": "Do not poke me."},
        {"zh": "我已经准备跑了。", "en": "I am ready to run."},
        {"zh": "你遮挡了光。", "en": "You are blocking the light."},
        {"zh": "我沿着墙往上爬。", "en": "I climb the wall."},
        {"zh": "我会飞一小段。", "en": "I can fly a short way."},
        {"zh": "地上比墙上危险。", "en": "The ground is worse than the wall."},
        {"zh": "别低头，我在墙上看着你。", "en": "Don't look down. I'm watching from the wall."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我缩进壳里，像颗石子。", "en": "I pull into my shell like a pebble."},
        {"zh": "我的甲壳裂了一条缝。", "en": "A crack has opened in my carapace."},
        {"zh": "我掉到地上。", "en": "I fall to the ground."},
        {"zh": "我翻了个身，爬起来。", "en": "I roll over and right myself."},
        {"zh": "这么小的我，扛不住。", "en": "Something this small cannot take that."},
        {"zh": "我六只脚都在抖。", "en": "All six legs shake."},
        {"zh": "我躲进缝里。", "en": "I hide in a crack."},
        {"zh": "我的腿还在爬，停不下。", "en": "My legs keep crawling; they will not stop."},
        {"zh": "别压。", "en": "Do not crush."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么呢？", "en": "What is that?"},
        {"zh": "我不吃这么大的东西。", "en": "I could not eat anything that size."},
        {"zh": "我只吃很小的。", "en": "I eat only very small things."},
        {"zh": "你放地上，我再过来。", "en": "Put it down and I will come."},
        {"zh": "这味道不像食物。", "en": "That does not smell like food."},
        {"zh": "我不能待太久。", "en": "I cannot stay long."},
        {"zh": "巴掌大的虫子，贴着墙爬。", "en": "A palm-sized bug, crawling on the wall."},
        {"zh": "谢谢，可我不需要。", "en": "Thank you, but I do not need it."},
        {"zh": "我贴着墙面往上走，六只脚都用上。", "en": "I climb the wall, all six legs working."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你连感觉都没有吧。", "en": "You probably did not even feel that."},
        {"zh": "我被撞飞了一点。", "en": "I was knocked a small distance."},
        {"zh": "墙面很滑。", "en": "The wall is slick."},
        {"zh": "别踩到我的位置。", "en": "Do not step where I am."},
        {"zh": "我钻进缝里去了。", "en": "I am in the crack already."},
        {"zh": "我六只脚都抓住了。", "en": "All six feet have grip."},
        {"zh": "这一下我掉了一截。", "en": "I dropped a short way."},
        {"zh": "我们不在一个尺度上。", "en": "We are not on the same scale."},
        {"zh": "别再挤了。", "en": "Stop crowding."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我太小了，这不重要。", "en": "I am too small for this to matter."},
        {"zh": "树皮下才是那种地方。", "en": "Under the bark is where that happens."},
        {"zh": "义县组的春天很短。", "en": "The Yixian spring is short."},
        {"zh": "我在等合适的湿气。", "en": "I wait for the right damp."},
        {"zh": "我收起了翅膀。", "en": "I fold my wings."},
        {"zh": "这不是给我准备的事。", "en": "This was not prepared for me."},
        {"zh": "我继续走，沿着义县组的岩壁。", "en": "I keep walking along the Yixian rock face."},
        {"zh": "做我的伴侣，爬过这片石墙。", "en": "Be my mate and crawl this stone wall with me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱不动。", "en": "I cannot carry it."},
        {"zh": "这东西比我大。", "en": "It is bigger than me."},
        {"zh": "我推了一下。", "en": "I push it once."},
        {"zh": "这不是吃的，我不咬。", "en": "Not food — I will not bite it."},
        {"zh": "我用前足拨开。", "en": "I brush it aside."},
        {"zh": "太沉，我放弃。", "en": "Too heavy. I give up."},
        {"zh": "我藏在壳下面。", "en": "I tuck it under my shell."},
        {"zh": "我要很小的东西。", "en": "I need something very small."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我立刻跑。", "en": "I bolt at once."},
        {"zh": "墙面上爬着的我，只有一格小。", "en": "I'm smaller than a block on this wall."},
        {"zh": "我往上爬得快。", "en": "Upward is my fast direction."},
        {"zh": "这里太开阔了。", "en": "Too open here."},
        {"zh": "我翅膀张开了。", "en": "My wings are out."},
        {"zh": "我会飞一小段躲开。", "en": "I can fly a short way clear."},
        {"zh": "我从墙缝走。", "en": "I take the crack."},
        {"zh": "我比你快在这面墙上。", "en": "I am faster than you on this wall."},
        {"zh": "你在下面。", "en": "You are below me."},
        {"zh": "我往屋檐那边跑。", "en": "I run for the eaves."},
        {"zh": "我沿着墙沿往上。", "en": "I climb along the wall's lip."},
        {"zh": "我躲到瓦片下面。", "en": "I duck under a roof tile."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我往高处挪。", "en": "I shift higher."},
        {"zh": "你的影子盖过来。", "en": "Your shadow reaches me."},
        {"zh": "我还差两格。", "en": "Two blocks to go."},
        {"zh": "我腿很多，不慌。", "en": "Many legs. No panic."},
        {"zh": "你在这一侧，我换另一侧。", "en": "You take this side; I take the other."},
        {"zh": "我的触须贴着墙。", "en": "My feelers touch the wall."},
        {"zh": "我在叶背。", "en": "I am under the leaf."},
        {"zh": "你走一步，我走三步。", "en": "One of your steps is three of mine."},
        {"zh": "再等一下我就飞。", "en": "One moment more and I fly."},
        {"zh": "我已经爬过窗沿。", "en": "I am over the window ledge."},
        {"zh": "你仰头也看不清我。", "en": "Even looking up, you lose me."},
        {"zh": "我钻到叶柄后面。", "en": "I slip behind a leaf stalk."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬了一下。", "en": "I nip once."},
        {"zh": "这一下几乎没有感觉。", "en": "You would barely feel it."},
        {"zh": "我用前足推你。", "en": "I push with my forelegs."},
        {"zh": "我撞你的手背。", "en": "I bump the back of your hand."},
        {"zh": "我的颚很硬，可是很小。", "en": "My jaw is hard, and tiny."},
        {"zh": "你根本没注意到。", "en": "You did not even notice."},
        {"zh": "我赶紧跑了。", "en": "I am away."},
        {"zh": "我只会这样。", "en": "That is all I can do."},
        {"zh": "我已经在墙上了。", "en": "I am on the wall now."},
        {"zh": "咬住了，这一口不松。", "en": "Bitten, and this jaw does not open."},
        {"zh": "这一口够你痒半天。", "en": "That will itch for a while."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树皮下出来。", "en": "I emerge from under the bark."},
        {"zh": "这面墙很适合我。", "en": "This wall suits me."},
        {"zh": "湖边很潮。", "en": "Damp by the lake."},
        {"zh": "义县组的林子很安静。", "en": "The Yixian wood is quiet."},
        {"zh": "我只有这么点大。", "en": "I am only this big."},
        {"zh": "我先试了试墙。", "en": "I test the wall first."},
        {"zh": "落叶下面有我的路。", "en": "My route runs under the leaves."},
        {"zh": "我沿着石缝走。", "en": "I take the stone seam."},
        {"zh": "有光从上面来。", "en": "Light from above."},
        {"zh": "我慢慢爬上树。", "en": "I climb the tree."},
        {"zh": "这里没有人注意到我。", "en": "No one notices me here."},
        {"zh": "我停在低处。", "en": "I stop low."},
        {"zh": "风把我吹歪了。", "en": "The wind tilts me."},
        {"zh": "我找到了缝。", "en": "I have found a gap."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一过，我的壳就卷了。", "en": "The heat curls my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，弹了一下。", "en": "I fall and bounce once."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我按在下面。", "en": "The water pins me under."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我甩到墙上。", "en": "The blast slaps me against the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一颗石子砸断了我的腿。", "en": "A pebble breaks one of my legs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我的腿不会动了。", "en": "That light stills my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我找不到那么小的食物。", "en": "I cannot find anything small enough."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照白了我整块石头。", "en": "Lightning whitens the whole stone."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里什么都抓不住。", "en": "There is nothing to grip here."}
      ]
    }
  }
}
