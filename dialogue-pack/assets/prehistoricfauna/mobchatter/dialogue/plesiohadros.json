{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着长腿走过干河床。", "en": "I cross the dry riverbed on long legs."},
        {"zh": "我的头抬得很高。", "en": "My head rides high."},
        {"zh": "脚踩在卵石上，声响很沉。", "en": "My feet thud on the pebbles."},
        {"zh": "我走一步，影子很长。", "en": "Each step casts a longer shadow."},
        {"zh": "河床干了，只剩石头。", "en": "The riverbed's dry, all stones."},
        {"zh": "我沿着河谷往下走。", "en": "I follow the valley down."},
        {"zh": "我的尾巴在身后平衡。", "en": "My tail balances me behind."},
        {"zh": "脖子一转，我看了看两边。", "en": "I turn my neck and glance both ways."},
        {"zh": "我慢慢走过一片碎石。", "en": "I walk slowly over loose stone."},
        {"zh": "背脊上的皮很厚。", "en": "The hide along my spine is thick."},
        {"zh": "我绕开塌下的土坡。", "en": "I skirt a collapsed bank."},
        {"zh": "我怕惊到幼崽，走得轻。", "en": "I step lightly so as not to startle the young."},
        {"zh": "我的步幅很大。", "en": "My stride is long."},
        {"zh": "我在这里能跑得起来。", "en": "There's room to run here."},
        {"zh": "沙尘跟着我的脚起来。", "en": "Dust rises behind my feet."},
        {"zh": "我停在一处高地上。", "en": "I stop on a rise."},
        {"zh": "我沿着崖边的小道走。", "en": "I walk the ledge along the cliff."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，四下看。", "en": "I stand and scan the horizon."},
        {"zh": "我用后腿刨了刨土。", "en": "I scrape the soil with a hind leg."},
        {"zh": "我喘得又沉又慢。", "en": "My breathing is deep and slow."},
        {"zh": "河床上没有水。", "en": "There's no water in the channel."},
        {"zh": "我抬高头去够树梢。", "en": "I raise my head for the treetops."},
        {"zh": "远处的石头在热浪里晃。", "en": "The far stones shimmer in the heat."},
        {"zh": "我把头转向风来的方向。", "en": "I turn my head into the wind."},
        {"zh": "我的尾巴垂下来。", "en": "My tail hangs low."},
        {"zh": "我在听别处的动静。", "en": "I'm listening somewhere else."},
        {"zh": "我轻哼了一声。", "en": "I make a soft, low sound."},
        {"zh": "我把前脚换了位置。", "en": "I shift a front foot."},
        {"zh": "头顶有鸟飞过。", "en": "A bird passes overhead."},
        {"zh": "我在等幼崽跟上来。", "en": "I'm waiting for the young to catch up."},
        {"zh": "我抖了抖身上的尘土。", "en": "I shake the dust off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "两格高的我，低头打量你。", "en": "Two blocks tall, I lower my head to size you up."},
        {"zh": "你比我的腿短。", "en": "You're shorter than my leg."},
        {"zh": "我并不想踩到你。", "en": "I'd rather not step on you."},
        {"zh": "你手里那株草，我认得。", "en": "I know that plant in your hand."},
        {"zh": "你退开些，我好走。", "en": "Step aside so I can pass."},
        {"zh": "我的眼睛在头两侧。", "en": "My eyes sit on both sides of my head."},
        {"zh": "干涸河床上，我甩尾扬起沙。", "en": "On the dry riverbed my tail stirs up sand."},
        {"zh": "你在我前面太小了。", "en": "You're very small in front of me."},
        {"zh": "我慢慢弯下脖子。", "en": "I bend my neck down slowly."},
        {"zh": "这片河床是我的路。", "en": "This riverbed is my road."},
        {"zh": "我嚼着 Cobbania，没空理你。", "en": "I am chewing Cobbania and have no time for you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "低沉的喉音，从我的冠里滚出。", "en": "A low call rolls out of my crest."},
        {"zh": "腿上有一道伤。", "en": "There's a wound on my leg."},
        {"zh": "我一边转身一边看你。", "en": "I turn and keep watching you."},
        {"zh": "我不容易倒。", "en": "I don't go down easily."},
        {"zh": "我压低身子站稳。", "en": "I lower myself and steady."},
        {"zh": "血顺着我的腿流。", "en": "Blood runs down my leg."},
        {"zh": "我把幼崽往后赶。", "en": "I push the young behind me."},
        {"zh": "我甩了甩脖子上的皮。", "en": "I shake the hide loose on my neck."},
        {"zh": "这一下疼，但能忍。", "en": "It hurts, but I can bear it."},
        {"zh": "我这群幼崽，都躲在我身后。", "en": "My hatchlings are all behind me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "就是这种草。", "en": "That's the plant."},
        {"zh": "我把长脖子弯下去。", "en": "I bend my long neck down."},
        {"zh": "Cobbania 举高些，我才够得到。", "en": "Hold the Cobbania higher so I can reach it."},
        {"zh": "这株是新长出来的。", "en": "This one's newly grown."},
        {"zh": "我闻了闻，很好。", "en": "I sniff it; very good."},
        {"zh": "我不急，慢慢吃。", "en": "No rush; I'll eat slowly."},
        {"zh": "你会骑上来吗？", "en": "Are you getting on?"},
        {"zh": "吃了这个，我认你。", "en": "Eat this and I'll know you."},
        {"zh": "再给我一株。", "en": "One more plant."},
        {"zh": "我跟着你走几步。", "en": "I'll walk a few steps with you."},
        {"zh": "你把草拿稳。", "en": "Hold the plant steady."},
        {"zh": "我嚼得很响，你别学。", "en": "I chew loudly. Don't copy me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我停下，怕踩到你。", "en": "I stop, afraid of stepping on you."},
        {"zh": "我侧身让出空间。", "en": "I turn to give you room."},
        {"zh": "我的身体太重了。", "en": "My body is very heavy."},
        {"zh": "我这体重，踩得卵石往下陷。", "en": "At my weight, the river pebbles sink underfoot."},
        {"zh": "你被推到一边。", "en": "You get pushed aside."},
        {"zh": "我尽量收着劲。", "en": "I hold my strength back."},
        {"zh": "冲撞一下，我几乎没感觉。", "en": "A charge like that barely registers."},
        {"zh": "我抬脚绕过去。", "en": "I lift a foot and step around you."},
        {"zh": "我从你身边挪过去。", "en": "I move past you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "她在河床上等我。", "en": "She waits for me on the riverbed."},
        {"zh": "我们并肩走。", "en": "We walk side by side."},
        {"zh": "我们的脖子挨着。", "en": "Our necks touch."},
        {"zh": "幼崽在我们脚边跑。", "en": "The young run around our feet."},
        {"zh": "她叫一声，我回一声。", "en": "She calls; I answer."},
        {"zh": "我们一起警戒。", "en": "We keep watch together."},
        {"zh": "她的背比我宽一点。", "en": "Her back is a little broader."},
        {"zh": "我们在同一块高地停下。", "en": "We stop on the same rise."},
        {"zh": "晚上我们挨着睡。", "en": "At night we sleep close."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起一株草。", "en": "I take a plant in my mouth."},
        {"zh": "这块石头有盐。", "en": "This stone holds salt."},
        {"zh": "我用鼻子推它。", "en": "I nudge it with my nose."},
        {"zh": "我抬脚把它拨走。", "en": "I brush it aside with a foot."},
        {"zh": "这根枝太硬。", "en": "This branch is too tough."},
        {"zh": "有东西滚到我脚边。", "en": "Something rolled to my feet."},
        {"zh": "低头看看，是谁在下面。", "en": "Head down to see who's below."},
        {"zh": "鞍袋里还能塞一点。", "en": "There's still room in my saddlebag."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有影子。", "en": "There's a shape over there."},
        {"zh": "我停下，脖子一僵。", "en": "I freeze, my neck stiff."},
        {"zh": "幼崽在我后面。", "en": "The young are behind me."},
        {"zh": "冠嘴一转，我盯住你的方向。", "en": "My duckbill turns; I fix on your direction."},
        {"zh": "我压低前身。", "en": "I lower my front."},
        {"zh": "脚在地上蹭了一下。", "en": "I scuff a foot on the ground."},
        {"zh": "它越来越近了。", "en": "It's coming closer."},
        {"zh": "我发出很低的声。", "en": "I make a low sound."},
        {"zh": "我在护着它们。", "en": "I'm shielding them."},
        {"zh": "我还要再等一下。", "en": "I'll wait a moment more."},
        {"zh": "它一点也不退。", "en": "It won't back off at all."},
        {"zh": "好，我来了。", "en": "Fine, here I come."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的长腿迈得快。", "en": "My long legs cover ground."},
        {"zh": "它闪到乱石里。", "en": "It dodges into the rubble."},
        {"zh": "我从上面看得见。", "en": "From up here I can see it."},
        {"zh": "幼崽被我挡在后面。", "en": "The young are behind me."},
        {"zh": "我迈开了长腿。", "en": "I open up my long stride."},
        {"zh": "沙尘跟着我起来。", "en": "Dust rises with me."},
        {"zh": "它跑向河床。", "en": "It's running for the riverbed."},
        {"zh": "那边没有遮挡。", "en": "There's no cover there."},
        {"zh": "它已经在我影子边上。", "en": "It's at the edge of my shadow."},
        {"zh": "我把脖子低下去。", "en": "I drop my neck."},
        {"zh": "这一下用前脚。", "en": "This one's with a forefoot."},
        {"zh": "它没退路了。", "en": "It has nowhere to go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一脚踩下去。", "en": "I bring a foot down."},
        {"zh": "我用肩膀把它撞开。", "en": "I shoulder it aside."},
        {"zh": "它被推得滚了一圈。", "en": "It rolls over once."},
        {"zh": "我的尾巴扫过去。", "en": "My tail sweeps across."},
        {"zh": "沙被扬起来很大一片。", "en": "A wide sheet of dust lifts."},
        {"zh": "它退得几乎看不见。", "en": "It's nearly out of sight."},
        {"zh": "我没有再追了。", "en": "I didn't chase further."},
        {"zh": "我站着，护住后面。", "en": "I stand, guarding what's behind."},
        {"zh": "地面被踩出很深的坑。", "en": "The ground takes a deep print."},
        {"zh": "我喘得很慢。", "en": "I breathe slowly."},
        {"zh": "我回头看了一下。", "en": "I glance back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "干河床上多了一道长影子。", "en": "A long shadow appears on the dry bed."},
        {"zh": "我从高地走下来。", "en": "I come down from the rise."},
        {"zh": "我的脚第一次踩在这片石上。", "en": "My feet touch this stone for the first time."},
        {"zh": "这里没有水，但草还在。", "en": "No water, but the plants remain."},
        {"zh": "白垩纪的风里，有河床的味道。", "en": "The Cretaceous wind smells of dry riverbed."},
        {"zh": "几只幼崽跟在后面。", "en": "Several young follow behind."},
        {"zh": "沙尘被风吹散。", "en": "The wind scatters the dust."},
        {"zh": "我找了个高处站住。", "en": "I take a high spot."},
        {"zh": "白垩纪的空气很干。", "en": "The Cretaceous air is dry."},
        {"zh": "河床一直延伸到远处。", "en": "The riverbed runs far."},
        {"zh": "我开始慢慢走。", "en": "I start walking, slowly."},
        {"zh": "我踩碎了一块卵石。", "en": "I crush a pebble underfoot."},
        {"zh": "远处有东西在动。", "en": "Something moves in the distance."},
        {"zh": "这里够我们走。", "en": "There's room for us here."},
        {"zh": "我低头吃了一口。", "en": "I lower my head for a bite."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的皮，味道很难闻。", "en": "Fire singes my hide; the smell is foul."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时我的腿撑不住，跪了。", "en": "My legs fail on landing; I kneel."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进来，我抬着头往上挣。", "en": "Water floods in; I strain upward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风让我横着挪了一步。", "en": "The blast shifts me a step sideways."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物扎进我的肋。", "en": "Something sharp sticks in my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "有股力气锁住了我的腿。", "en": "Something locks my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我走不动了。", "en": "Too hungry to move."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的背下来，我浑身一僵。", "en": "Lightning runs down my back; I lock up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有河床，也没有地。", "en": "No riverbed, no ground."}
      ]
    }
  }
}
