{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "细长的腿在月光下走。", "en": "My slender legs carry me under the moon."},
        {"zh": "我沿着沼泽边一步步探。", "en": "I probe along the marsh edge."},
        {"zh": "脖子转来转去，找动静。", "en": "My neck swings, hunting for movement."},
        {"zh": "我走得很轻，草地上没声音。", "en": "I walk light; the grass makes no sound."},
        {"zh": "夜色把我的影子压平了。", "en": "Night flattens my shadow."},
        {"zh": "我绕过一洼积水。", "en": "I skirt a pool of standing water."},
        {"zh": "前爪贴着胸口，走路带着。", "en": "My forelimbs tuck at my chest."},
        {"zh": "水边的虫子在响。", "en": "Insects sound by the water."},
        {"zh": "我踩着芦苇根部走。", "en": "I walk along the reed roots."},
        {"zh": "我的尾巴一直摆着平衡。", "en": "My tail keeps my balance."},
        {"zh": "草丛一有动静，我就转向。", "en": "Any movement in the grass and I turn."},
        {"zh": "我加快了几步，又慢下来。", "en": "I quicken for a few steps, then slow."},
        {"zh": "月亮很亮，我看得很清。", "en": "The moon is bright. I see clearly."},
        {"zh": "我贴着水边，避开开阔地。", "en": "I keep to the water, avoiding open ground."},
        {"zh": "我从一棵枯树旁经过。", "en": "I pass a dead tree."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在泥里，一动不动。", "en": "Standing in the mud, perfectly still."},
        {"zh": "我抬着头，听远处。", "en": "Head raised, listening far off."},
        {"zh": "虫子落在我的尾巴上。", "en": "An insect lands on my tail."},
        {"zh": "我摆了下尾巴。", "en": "I sweep my tail once."},
        {"zh": "水面有一圈纹。", "en": "A ring spreads on the water."},
        {"zh": "夜风吹得有点凉。", "en": "The night wind is a little cool."},
        {"zh": "我嚼了嚼，嘴里什么也没有。", "en": "I chew on nothing."},
        {"zh": "我盯着水边一个洞。", "en": "I stare at a hole at the water's edge."},
        {"zh": "芦苇在晃，我不动。", "en": "The reeds sway. I do not."},
        {"zh": "我的骨节很轻，站着没什么声。", "en": "My bones are light. Standing makes no sound."},
        {"zh": "我在等猎物自己出来。", "en": "I wait for prey to show itself."},
        {"zh": "我抬起头，眼睛反着光。", "en": "I lift my head, eyes catching light."},
        {"zh": "我张开嘴，舌头动了一下。", "en": "I open my mouth; my tongue moves once."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "夜里的钦利平原归我跑。", "en": "The Chinle flats are mine to run at night."},
        {"zh": "我朝后挪了两步。", "en": "I shuffled back two steps."},
        {"zh": "别动，我在看你。", "en": "Hold still. I am looking at you."},
        {"zh": "夜里你的眼睛也在亮。", "en": "Your eyes shine in the night too."},
        {"zh": "这片沼泽是我的猎场。", "en": "This marsh is my hunting ground."},
        {"zh": "你踩到水了，声音很大。", "en": "You stepped in water. Very loud."},
        {"zh": "我一受惊就会跑。", "en": "I bolt when startled."},
        {"zh": "你也吃虫子吗。", "en": "Do you eat insects too?"},
        {"zh": "我不想跟你打。", "en": "I do not want to fight you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我惊得窜出两步，又回头。", "en": "Startled, I dart two paces and look back."},
        {"zh": "我退到芦苇里。", "en": "I retreat into the reeds."},
        {"zh": "羽毛掉了一些。", "en": "Some feathers came off."},
        {"zh": "我一条腿发抖。", "en": "One leg is trembling."},
        {"zh": "血滴在泥地上。", "en": "Blood drips on the mud."},
        {"zh": "我气都喘不匀了。", "en": "I cannot catch my breath."},
        {"zh": "不重，可我心里慌。", "en": "Not heavy, but it frightens me."},
        {"zh": "我把身子伏低了。", "en": "I flatten myself down."},
        {"zh": "血滴在泥里，我照样能跑。", "en": "Blood drips in the mud; I can still run."},
        {"zh": "我得悄悄溜走。", "en": "I need to slip away."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有虫子的味道。", "en": "I smell insects."},
        {"zh": "那点肉，扔过来。", "en": "That bit of meat. Throw it."},
        {"zh": "我不敢再靠近。", "en": "I dare not come closer."},
        {"zh": "放在泥地上就行。", "en": "On the mud will do."},
        {"zh": "那东西还活着吗。", "en": "Is that thing still alive?"},
        {"zh": "我闻了闻，可以吃。", "en": "I sniff. Edible."},
        {"zh": "这味道很少见。", "en": "That smell is rare."},
        {"zh": "我绕了一圈才过来。", "en": "I circle once before coming."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你身子可真重。", "en": "You are really heavy."},
        {"zh": "我让开了，别追我。", "en": "I have moved aside. Do not chase me."},
        {"zh": "这里的泥地很滑。", "en": "The mud here is slick."},
        {"zh": "我的骨头很轻。", "en": "My bones are light."},
        {"zh": "你走那一边吧。", "en": "You take that side."},
        {"zh": "我踩进沼泽，泥水溅了一身。", "en": "I step into the swamp and splash mud over myself."},
        {"zh": "我的脚抓稳了。", "en": "My feet have their grip."},
        {"zh": "别往我身上挤。", "en": "Do not crowd against me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "夜里的时间不多。", "en": "There is little time at night."},
        {"zh": "先找个能藏的地方。", "en": "First find somewhere to hide."},
        {"zh": "我这一群里已经配好了。", "en": "My group has already paired."},
        {"zh": "沼泽边太危险。", "en": "The marsh edge is too dangerous."},
        {"zh": "有光的地方，我不去。", "en": "I do not go where there is light."},
        {"zh": "等过了这段时间。", "en": "After this stretch passes."},
        {"zh": "我得先吃点东西。", "en": "I must eat first."},
        {"zh": "你说话小点声。", "en": "Keep your voice down."},
        {"zh": "天就快要亮了。", "en": "Dawn is almost here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "泥里有块东西。", "en": "Something in the mud."},
        {"zh": "我用嘴挑起来。", "en": "I lift it with my mouth."},
        {"zh": "太小了，一咬就没。", "en": "Too small. One bite and gone."},
        {"zh": "这个吃不下去。", "en": "This cannot be eaten."},
        {"zh": "我把它拖到草丛。", "en": "I drag it into the grass."},
        {"zh": "我踩到了，软的。", "en": "I stepped on it. Soft."},
        {"zh": "水边的东西都湿。", "en": "Everything by the water is wet."},
        {"zh": "我收着，等会吃。", "en": "I keep it for later."},
        {"zh": "那块肉是我拖到岸上的。", "en": "I dragged that meat onto the bank."},
        {"zh": "我把它推回泥里。", "en": "I push it back into the mud."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "三叠纪的夜，眼睛先动。", "en": "In Triassic night, eyes move first."},
        {"zh": "我把脖子转过去。", "en": "I swing my neck around."},
        {"zh": "那可能是猎物。", "en": "That could be prey."},
        {"zh": "夜里那点动静，我听得清。", "en": "That small sound at night; I hear it clearly."},
        {"zh": "风把味道送过来。", "en": "The wind brings the scent."},
        {"zh": "水边实在太亮了。", "en": "The water's edge is too bright."},
        {"zh": "我先绕到侧面。", "en": "I circle to the flank first."},
        {"zh": "猎物一动，我就冲。", "en": "When prey moves, I charge."},
        {"zh": "这就是开头了。", "en": "This is the beginning."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步也不出声。", "en": "Not a sound from my steps."},
        {"zh": "我盯着那团影子。", "en": "I fix on that shadow."},
        {"zh": "距离一点点缩短。", "en": "The distance is closing."},
        {"zh": "我把脖子伸得很长。", "en": "I stretch my neck far."},
        {"zh": "芦苇挡着我一半。", "en": "The reeds hide half of me."},
        {"zh": "我等它低下头去。", "en": "I wait for it to lower its head."},
        {"zh": "水面平静得很。", "en": "The water lies still."},
        {"zh": "它把头转过来了。", "en": "It turned its head."},
        {"zh": "我数着自己的步子。", "en": "I count my own steps."},
        {"zh": "月亮照不到这里。", "en": "The moon does not reach here."},
        {"zh": "再凑近一点点。", "en": "A little closer."},
        {"zh": "那就往上冲吧。", "en": "Then charge in."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我细长的牙，咬向你的脚踝。", "en": "My slender teeth snap at your ankle."},
        {"zh": "前爪按住猎物。", "en": "My foreclaws pin the prey."},
        {"zh": "我跳起来扑过去。", "en": "I leap to pounce."},
        {"zh": "这一口咬得很快。", "en": "That bite was quick."},
        {"zh": "它挣开跑掉了。", "en": "It tore free and ran."},
        {"zh": "咬到的是空气。", "en": "My teeth closed on air."},
        {"zh": "我翻了半个身。", "en": "I half-tumble."},
        {"zh": "这点力气刚刚好。", "en": "That was just enough force."},
        {"zh": "我落地轻得很。", "en": "I land very lightly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "夜里，我从草丛里站起来。", "en": "At night I rise from the grass."},
        {"zh": "水面反着月光。", "en": "The water mirrors the moon."},
        {"zh": "夜里的钦利平原，我竖起颈。", "en": "On the Chinle plain at night, I raise my neck."},
        {"zh": "沼泽边有虫叫。", "en": "Insects call along the marsh."},
        {"zh": "这一带没有大掠食者。", "en": "No large predators here."},
        {"zh": "我伏低到泥里。", "en": "I sink low into the mud."},
        {"zh": "我踩着湿泥，没出声。", "en": "I cross wet mud without sound."},
        {"zh": "远处亮起一点火光。", "en": "A little firelight shows far off."},
        {"zh": "我的同类在附近。", "en": "My kin are nearby."},
        {"zh": "芦苇在轻轻摇。", "en": "The reeds are swaying."},
        {"zh": "我找到了水边这条路。", "en": "I found this path by the water."},
        {"zh": "我慢慢开始走。", "en": "I begin to walk."},
        {"zh": "这个夜晚还长。", "en": "The night is still long."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光刺得我睁不开眼。", "en": "The firelight blinds me."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过我的脖子。", "en": "Water covers my neck."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把泥巴全甩到我身上。", "en": "The blast throws mud over me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭擦着我的背。", "en": "An arrow grazes my back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我的眼睛疼。", "en": "This light hurts my eyes."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "今晚什么都没抓到。", "en": "I caught nothing tonight."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电照着水面，一片白。", "en": "Lightning lights the water white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "泥地不见了，我在下坠。", "en": "The mud is gone. I fall."}
      ]
    }
  }
}
