{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "鱼群散开又聚拢", "en": "The school scatters and closes again."},
        {"zh": "我摆尾跟上前面那条", "en": "I beat my tail to follow the one ahead."},
        {"zh": "身子只有半格长", "en": "Half a block long, no more."},
        {"zh": "水草从我身侧扫过", "en": "Weeds brush my sides."},
        {"zh": "我贴着湖底游", "en": "I swim low along the lake bed."},
        {"zh": "转弯时整群一起转", "en": "The whole school turns at once."},
        {"zh": "光从上面落下来", "en": "Light falls from above."},
        {"zh": "鱼群散开又聚拢，我跟着前面那条。", "en": "The school scatters and re-forms; I follow the one ahead."},
        {"zh": "鳍一动，方向就变了", "en": "One flick of a fin and I turn."},
        {"zh": "我们排得很紧", "en": "We swim very close."},
        {"zh": "有影子在岸上走", "en": "A shadow moves on the bank."},
        {"zh": "我们全都不理会", "en": "We pay it no mind."},
        {"zh": "湖面有风，起了小波纹", "en": "Wind ripples the lake surface."},
        {"zh": "我跟着波纹的方向", "en": "I follow the ripple's direction."},
        {"zh": "水很浅，也很清", "en": "The water is shallow and clear."},
        {"zh": "我游过一段沉木", "en": "I pass a sunken log."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "悬在水里，鳍轻摆", "en": "Hanging in the water, fins fanning."},
        {"zh": "腮盖一开一合", "en": "My gills open and close."},
        {"zh": "群里的同伴都在", "en": "My schoolmates are all here."},
        {"zh": "我们一致地晃着", "en": "We sway in unison."},
        {"zh": "水底有石头和落叶", "en": "Stones and fallen leaves on the bottom."},
        {"zh": "我几乎一动不动", "en": "I barely move."},
        {"zh": "有虫子落在水面", "en": "A bug lands on the surface."},
        {"zh": "我并没有上去", "en": "I don't rise for it."},
        {"zh": "它离我实在太远", "en": "Too far."},
        {"zh": "我转头看别的方向", "en": "I turn to look elsewhere."},
        {"zh": "水草在轻轻摇", "en": "The weeds sway gently."},
        {"zh": "阳光照到水底的石上", "en": "Sun reaches the stones below."},
        {"zh": "我停在那片光里", "en": "I stop in that patch of light."},
        {"zh": "一片落叶沉下来", "en": "A fallen leaf sinks past."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "岸上有人蹲下了", "en": "Someone crouches on the bank."},
        {"zh": "我在水下看你", "en": "I watch you from under the water."},
        {"zh": "脸被水波拉歪了", "en": "The water warps your face."},
        {"zh": "我往水草里躲", "en": "I slip into the weeds."},
        {"zh": "只露出半个头", "en": "Only half my head shows."},
        {"zh": "你还在盯着看", "en": "You're still looking."},
        {"zh": "我又游出来一点", "en": "I drift out a little."},
        {"zh": "群里的也跟着", "en": "The school follows me."},
        {"zh": "我们一起看你", "en": "We all watch you."},
        {"zh": "然后一起游开", "en": "Then we all swim off."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "鱼群一下炸开", "en": "The school explodes apart."},
        {"zh": "我乱转了几圈", "en": "I dart in circles."},
        {"zh": "我脱了一片鳞", "en": "A scale comes free."},
        {"zh": "水里浮着血丝", "en": "Blood threads the water."},
        {"zh": "我往水底钻去", "en": "I dive for the bottom."},
        {"zh": "鱼群散了，我找不到同伴。", "en": "The school scattered; I can't find my kin."},
        {"zh": "我一下子停住", "en": "I halt all at once."},
        {"zh": "四下里只有水声", "en": "Only water sounds around me."},
        {"zh": "我等它们回来", "en": "I wait for them to return."},
        {"zh": "一会就回来了", "en": "They come back soon enough."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水面动了一下", "en": "The surface twitches."},
        {"zh": "我抬头，鳍都立起来", "en": "I look up, fins rising."},
        {"zh": "有东西沉下来了", "en": "Something is sinking."},
        {"zh": "水草边有东西落下来，我游近。", "en": "Something drops by the weeds; I swim closer."},
        {"zh": "闻了闻，不太对", "en": "I test it. Something's off."},
        {"zh": "我又往后退开", "en": "I back away again."},
        {"zh": "群里的也没吃", "en": "None of the school eats it."},
        {"zh": "还是水里的东西好", "en": "What lives in the water is better."},
        {"zh": "我转身游回去", "en": "I turn back."},
        {"zh": "那片水草底下有虫子", "en": "There are bugs under those weeds."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "水被搅得乱转", "en": "The water swirls into chaos."},
        {"zh": "鱼群一下子散了", "en": "The school bursts apart."},
        {"zh": "我绕了半圈才回来", "en": "I circle half around before returning."},
        {"zh": "同伴也在找位置", "en": "The others are finding their places too."},
        {"zh": "我们很快又排好了", "en": "Soon we're in formation again."},
        {"zh": "你的手碰到水", "en": "Your hand touched the water."},
        {"zh": "我往下沉了一点，湖泊的水草在晃。", "en": "I sink a little; lake weeds sway."},
        {"zh": "你在水上，我在水下", "en": "You're above. I'm below."},
        {"zh": "这已经挺好了", "en": "That's good enough."},
        {"zh": "我们接着往前游", "en": "We keep moving forward."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们俩并排游", "en": "We swim side by side."},
        {"zh": "尾鳍一起摆动", "en": "Our tails beat together."},
        {"zh": "她转一下，我也转", "en": "She turns. I turn."},
        {"zh": "水草里有我们的卵", "en": "Our eggs are in the weeds."},
        {"zh": "很多，很小，透明", "en": "Many, tiny, transparent."},
        {"zh": "我们守在旁边", "en": "We keep close by."},
        {"zh": "有东西靠近就散开", "en": "When something nears, we scatter."},
        {"zh": "然后再聚回来", "en": "Then gather again."},
        {"zh": "这就是群的生活", "en": "That's school life."},
        {"zh": "一直都是这样", "en": "It's always been this way."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我张口就吞掉", "en": "I gulp it down."},
        {"zh": "太小，什么味道都没有", "en": "So small I can't taste it."},
        {"zh": "嘴里含着，又吐出来", "en": "I hold it, then spit it out."},
        {"zh": "这哪里是吃的", "en": "This is no food."},
        {"zh": "我游回鱼群里", "en": "I swim back to the school."},
        {"zh": "同伴都围上来", "en": "Schoolmates crowd in."},
        {"zh": "然后才又散开", "en": "And disperse."},
        {"zh": "水草底下还有", "en": "There's more under the weeds."},
        {"zh": "我去底下找找", "en": "I'll look."},
        {"zh": "我不慌也不忙", "en": "I'm unhurried."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上有影子", "en": "A shadow on the surface."},
        {"zh": "鱼群一起往下沉", "en": "The school sinks lower."},
        {"zh": "我们靠在一起", "en": "We press together."},
        {"zh": "这样看起来更大", "en": "It makes us look bigger."},
        {"zh": "我带着群转弯", "en": "I bank away."},
        {"zh": "整群跟着我转", "en": "The school turns with me."},
        {"zh": "水草就在那边", "en": "The weeds are that way."},
        {"zh": "我们一起钻进去", "en": "We slide into them."},
        {"zh": "只露出一点点", "en": "Only a little of us shows."},
        {"zh": "你是找不到的", "en": "You won't find us."},
        {"zh": "再等上一会儿", "en": "Wait a while."},
        {"zh": "你自己就走了", "en": "You'll leave on your own."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你还在岸上站着", "en": "You're still on the bank."},
        {"zh": "我游到水草边缘", "en": "I swim to the weed edge."},
        {"zh": "看一眼，再退回去", "en": "One look, then back in."},
        {"zh": "你在水面上找我", "en": "You're searching for me."},
        {"zh": "水面上看不出什么", "en": "The surface shows nothing."},
        {"zh": "我紧紧贴着水底", "en": "I hug the bottom."},
        {"zh": "影子在你脚边", "en": "A shadow by your feet."},
        {"zh": "那影子不是我的", "en": "Not mine."},
        {"zh": "那是一丛水草", "en": "It's the weeds."},
        {"zh": "你又看错了一次", "en": "Wrong again."},
        {"zh": "我有的是时间等", "en": "I have all the time to wait."},
        {"zh": "水里的时候，总是我赢", "en": "In water, I always win."},
        {"zh": "水波把你的影子弄碎了", "en": "The ripples break your shadow apart."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞了一下你的手", "en": "I bump your hand."},
        {"zh": "这点力气很小", "en": "It's very little force."},
        {"zh": "你几乎感觉不到", "en": "You'd barely feel it."},
        {"zh": "我又咬了一下", "en": "I nip again."},
        {"zh": "我的牙实在太小", "en": "My teeth are tiny."},
        {"zh": "你把手收回去了", "en": "You pull your hand back."},
        {"zh": "我立刻沉下去", "en": "I drop at once."},
        {"zh": "群在水底等我", "en": "The school waits below."},
        {"zh": "我们聚成一团", "en": "We gather into a knot."},
        {"zh": "我们就等你走", "en": "Waiting for you to go."},
        {"zh": "尾巴扫过你的指尖", "en": "My tail brushes your fingertips."},
        {"zh": "我游开一点，再回来", "en": "I swim off a little, then return."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "浅水里多了一小群鱼", "en": "A small school appears in the shallows."},
        {"zh": "我们从水草里游出来", "en": "We drift out from the weeds."},
        {"zh": "身上有细细的鳞", "en": "Fine scales cover us."},
        {"zh": "湖底全是软泥", "en": "The lake bed is soft mud."},
        {"zh": "这里有光，很好", "en": "There's light. Good."},
        {"zh": "义县组的湖里，我们排成队。", "en": "In the Yixian lake we line up in rows."},
        {"zh": "然后我们散开", "en": "Then spread out."},
        {"zh": "岸上有树，有水", "en": "Trees and water on the bank."},
        {"zh": "这是我们的地方", "en": "This is our place."},
        {"zh": "我们慢慢向深处去", "en": "We ease toward deeper water."},
        {"zh": "一步一步地游", "en": "Swimming, stroke by stroke."},
        {"zh": "我一点也不忙乱", "en": "I'm in no flurry."},
        {"zh": "水会一直在这里", "en": "The water will stay."},
        {"zh": "我们也是一样", "en": "So will we."}
      ]
    },
