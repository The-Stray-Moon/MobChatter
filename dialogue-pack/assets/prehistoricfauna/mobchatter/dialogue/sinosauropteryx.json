{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "尾巴上一圈圈的羽毛", "en": "Banded feathers run down my tail."},
        {"zh": "我在落叶里快步走", "en": "I trot through fallen leaves."},
        {"zh": "两条后腿交替着蹬", "en": "Two hind legs push in turn."},
        {"zh": "身体很小，脖子很细", "en": "Small body, slender neck."},
        {"zh": "我贴着地面找吃的", "en": "I work low, hunting for food."},
        {"zh": "脚爪踩碎一片枯叶", "en": "My claws crunch a dry leaf."},
        {"zh": "我停一下，嗅了嗅", "en": "I stop and sniff."},
        {"zh": "然后偏了个方向", "en": "Then angle off."},
        {"zh": "尾巴保持水平", "en": "My tail levels out."},
        {"zh": "林子里光很碎", "en": "Light comes through the trees in pieces."},
        {"zh": "我绕过一丛蕨", "en": "I go around a fern clump."},
        {"zh": "小跑起来，羽毛抖", "en": "I break into a run and my feathers shake."},
        {"zh": "雪林里也走过", "en": "I've walked snow woods as well."},
        {"zh": "胡泊边上虫子多", "en": "Lots of insects by the lake."},
        {"zh": "我朝那个方向去", "en": "I head that way."},
        {"zh": "我身上的绒毛，带条纹。", "en": "The fuzz on my body is striped."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站住，头歪着", "en": "Stopped, head cocked."},
        {"zh": "羽毛蓬松开来", "en": "My feathers fluff up."},
        {"zh": "尾巴翘了一点", "en": "My tail lifts a little."},
        {"zh": "我在听土里的动静", "en": "I'm listening into the soil."},
        {"zh": "前爪在地上扒了扒", "en": "My foreclaws scratch the dirt."},
        {"zh": "有只虫跳出去", "en": "A bug springs away."},
        {"zh": "我又追了两步", "en": "I chase two steps."},
        {"zh": "可惜没有追到", "en": "Didn't catch it."},
        {"zh": "我又停下了脚步", "en": "I stop again."},
        {"zh": "晨光刚起，最合适", "en": "First light. Best time."},
        {"zh": "羽毛上有一层凉", "en": "A chill lies on my feathers."},
        {"zh": "我这身绒毛，清晨最蓬松。", "en": "My down is fluffiest at dawn."},
        {"zh": "然后继续低头找", "en": "Then lower my head again."},
        {"zh": "我的肚子有点空", "en": "My belly is a little empty."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬头看你一眼", "en": "I glance up at you."},
        {"zh": "你实在太高了", "en": "You're very tall."},
        {"zh": "我连忙退了半步", "en": "I hastily step back."},
        {"zh": "可是我并没有跑", "en": "But I don't run."},
        {"zh": "你身上有种味道", "en": "You have a certain smell."},
        {"zh": "我踮脚闻你的手指。", "en": "I stretch up to sniff your fingers."},
        {"zh": "你手里这个，闻着不能吃。", "en": "Whatever you hold doesn't smell edible."},
        {"zh": "也不像是危险", "en": "Nor danger."},
        {"zh": "我歪头想了想", "en": "I tilt my head, thinking."},
        {"zh": "然后走近了一步", "en": "Then come one step closer."},
        {"zh": "羽毛在光下发红", "en": "My feathers go red in the light."},
        {"zh": "我的尾巴轻轻摇", "en": "My tail sways gently."},
        {"zh": "这是我在示好", "en": "That's my way of being friendly."},
        {"zh": "你也许看出来了", "en": "Maybe you noticed."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我尖着嗓子叫，往蕨丛钻。", "en": "I shriek and dive into the ferns."},
        {"zh": "身上掉了些毛", "en": "Some fluff drops off me."},
        {"zh": "我一下跳开很远", "en": "I spring far away."},
        {"zh": "落地时还在发抖", "en": "Still trembling as I land."},
        {"zh": "腿上有一道口子", "en": "A cut on my leg."},
        {"zh": "我低头舔了舔", "en": "I lick it."},
        {"zh": "这一下疼得要命", "en": "That hurt terribly."},
        {"zh": "可是腿还能用", "en": "But the leg still works."},
        {"zh": "我往蕨丛里钻", "en": "I duck into the ferns."},
        {"zh": "这下子藏好了", "en": "Now I'm hidden."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这是一只虫子吗", "en": "Is that a bug?"},
        {"zh": "我一下凑上去", "en": "I dart in at once."},
        {"zh": "闻了闻，不是", "en": "Sniff. It isn't."},
        {"zh": "我还是咬了一口", "en": "I take a bite anyway."},
        {"zh": "味道有点古怪", "en": "Strange taste."},
        {"zh": "麻黄果太涩，我吐出来了。", "en": "Ephedra berries are bitter. I spat it out."},
        {"zh": "可是我并没有走", "en": "But I don't leave."},
        {"zh": "你还把举着手伸着", "en": "Your hand's still out."},
        {"zh": "那我就再等等", "en": "I'll wait a bit."},
        {"zh": "说不定后面还有", "en": "Maybe there's more coming."},
        {"zh": "我仰头望着你", "en": "I look up at you."},
        {"zh": "尾巴一直没停", "en": "My tail never stops."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我差一点摔倒", "en": "I almost fall over."},
        {"zh": "麻黄果一喂，我就跟你。", "en": "Feed me ephedra berries and I follow."},
        {"zh": "我赶紧跳到一边", "en": "I hop aside."},
        {"zh": "落地才勉强站住", "en": "And only steady on landing."},
        {"zh": "我撞在你的靴边，翻了个滚。", "en": "I hit your boot and roll over."},
        {"zh": "我抖松羽毛，又贴回身上。", "en": "I ruffle my feathers and smooth them back."},
        {"zh": "羽毛又服帖了", "en": "Feathers lie smooth again."},
        {"zh": "我抬眼看了你", "en": "I glance up at you."},
        {"zh": "然后继续找虫子", "en": "Then go back to hunting bugs."},
        {"zh": "你挡住那块地了", "en": "You're standing on the good patch."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我把尾巴翘高点", "en": "I raise my tail higher."},
        {"zh": "羽毛上的圈最显眼", "en": "The bands on my tail show best."},
        {"zh": "她朝我这边看", "en": "She looks over."},
        {"zh": "我绕着她走半圈", "en": "I circle her half way."},
        {"zh": "然后一起低头找食", "en": "Then we both hunt, heads down."},
        {"zh": "我抓到一只，给她", "en": "I catch one and offer it."},
        {"zh": "她一口接过去", "en": "She takes it."},
        {"zh": "这算是个好兆头", "en": "A good sign."},
        {"zh": "我们会在林里筑巢", "en": "We'll nest in the woods."},
        {"zh": "窝不大，藏在蕨下", "en": "Small, hidden under ferns."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一口咬住虫子", "en": "I snap up the bug."},
        {"zh": "甩了两下，吞了", "en": "Two shakes, then swallow."},
        {"zh": "太小，没感觉", "en": "Too small to notice."},
        {"zh": "我又扒了扒土", "en": "I scratch the soil again."},
        {"zh": "下面还有一只", "en": "Another one under there."},
        {"zh": "那一只也吃了", "en": "Eaten too."},
        {"zh": "嘴里还有一点", "en": "Still something in my mouth."},
        {"zh": "嚼了嚼，没了", "en": "I chew. Gone."},
        {"zh": "这点远远不够吃", "en": "Not nearly enough to eat."},
        {"zh": "我接着找下去", "en": "Keep looking."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "土里面有东西在动", "en": "Something moves in the soil."},
        {"zh": "我脖子伸长了", "en": "My neck stretches out."},
        {"zh": "我的头一动不动", "en": "My head goes still."},
        {"zh": "只有尾巴在摆", "en": "Only my tail moves."},
        {"zh": "我只需要一下就够", "en": "One strike is all I need."},
        {"zh": "我一下扑了过去", "en": "I pounce."},
        {"zh": "爪子把它按住了", "en": "My claws pin it."},
        {"zh": "狠狠一口咬住", "en": "Bite down hard."},
        {"zh": "抬起来看看清楚", "en": "Lift it to check."},
        {"zh": "这个倒还算行", "en": "This one's decent enough."},
        {"zh": "然后一口咽下去", "en": "Then swallow."},
        {"zh": "继续找下一只", "en": "On to the next."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我把身子伏低", "en": "I crouch low."},
        {"zh": "一步一挪，别吓跑它。", "en": "One step at a time, do not scare it off."},
        {"zh": "羽毛贴着身体", "en": "My feathers lie flat."},
        {"zh": "尾巴保持不动", "en": "My tail holds steady."},
        {"zh": "现在已经很近了", "en": "Very close now."},
        {"zh": "它还没有发现", "en": "It hasn't noticed."},
        {"zh": "我伏在蕨叶后面，再挪半步。", "en": "Behind the fern, I shift half a step closer."},
        {"zh": "然后突然扑出去", "en": "Then I spring."},
        {"zh": "爪子先抓上去", "en": "Claws first."},
        {"zh": "牙齿紧跟着上去", "en": "Teeth after."},
        {"zh": "这一扑抓个正着", "en": "That pounce landed true."},
        {"zh": "这一次很干净", "en": "A clean catch this time."},
        {"zh": "我仰头扫了一圈", "en": "I lift my head and scan."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住你的鞋尖", "en": "I bite the tip of your shoe."},
        {"zh": "牙很小，咬不深", "en": "Small teeth. They don't bite deep."},
        {"zh": "我扑跳了一下", "en": "I hop up at you."},
        {"zh": "爪子挂在裤脚上", "en": "My claws catch your trouser leg."},
        {"zh": "你抬脚，我松开了", "en": "You lift your foot and I let go."},
        {"zh": "落在地上翻了个身", "en": "I land and roll over."},
        {"zh": "随即又站立起来", "en": "And back on my feet."},
        {"zh": "羽毛全都炸开来", "en": "All my feathers are puffed out."},
        {"zh": "这是在装自己很大", "en": "It's meant to look bigger."},
        {"zh": "其实我特别小", "en": "In truth I'm very small."},
        {"zh": "我又咬了一小口", "en": "I gnaw another small bite."},
        {"zh": "然后就跑开了", "en": "Then run."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "落叶里钻出个小东西", "en": "Something small emerges from the leaves."},
        {"zh": "尾羽先露出来", "en": "My banded tail shows first."},
        {"zh": "然后才露出头", "en": "Then my head."},
        {"zh": "落叶底下，我抖掉背上的土。", "en": "Under the leaf litter, I shake the dirt off my back."},
        {"zh": "这里是义县组的林子", "en": "These are the Yixian woods."},
        {"zh": "树很高，光很散", "en": "Tall trees, scattered light."},
        {"zh": "湖边就在不远处", "en": "The lake is close."},
        {"zh": "虫子应该不少", "en": "There should be plenty of insects."},
        {"zh": "我先朝那边走", "en": "I start that way."},
        {"zh": "我走得很小心", "en": "Walking carefully."},
        {"zh": "身上的毛紧贴皮肉", "en": "My feathers sit tight to the skin."},
        {"zh": "随时都准备跑", "en": "Ready to run."},
        {"zh": "这里看着很合适", "en": "This place will do."},
        {"zh": "还是先找吃的", "en": "Food first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛一燎就卷起来", "en": "Fire curls my feathers up."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时腿一软，趴下了。", "en": "My legs gave on landing; I flopped down."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里扑腾", "en": "I thrash in the water."}
      ]
    },
