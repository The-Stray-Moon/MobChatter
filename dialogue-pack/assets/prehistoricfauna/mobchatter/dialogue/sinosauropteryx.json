      "lines": [
        {"zh": "气浪把我掀个跟头", "en": "The blast tumbles me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西擦过我的尾巴", "en": "Something grazes my tail."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我浑身都不对劲", "en": "Everything in me feels wrong."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得翅膀都垂了", "en": "Hunger lets my feathers droop."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打得我一跳", "en": "Lightning makes me leap."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有落叶，全是虚空。", "en": "No leaf litter underfoot, only void."}
      ]
    }
  }
}
