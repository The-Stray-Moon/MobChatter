{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈开长腿走开。", "en": "I stride away on long legs."},
        {"zh": "这片林间空地是我的。", "en": "This glade is mine."},
        {"zh": "我小跑着绕开树根。", "en": "I trot around the roots."},
        {"zh": "群里的都在我后面。", "en": "The flock is behind me."},
        {"zh": "沙子被我的爪子翻开。", "en": "My claws turn up the sand."},
        {"zh": "我伸长脖子看远处。", "en": "I crane my neck to look ahead."},
        {"zh": "我一步能跨很远。", "en": "My stride covers ground."},
        {"zh": "红杉林下光线很暗。", "en": "It's dim under the redwoods."},
        {"zh": "我沿着河床走。", "en": "I walk along the dry riverbed."},
        {"zh": "风里的声音让我停下。", "en": "A sound on the wind stops me."},
        {"zh": "我带头往林子里走。", "en": "I lead the way into the trees."},
        {"zh": "我走得很轻，怕惊动谁。", "en": "I step softly, wary of startling."},
        {"zh": "我侧着身穿过灌木。", "en": "I slip sideways through the brush."},
        {"zh": "这群跟着我绕。", "en": "The flock follows my turn."},
        {"zh": "我放慢脚步等它们。", "en": "I slow down for the others."},
        {"zh": "我走过的地方有脚印。", "en": "Prints mark where I've been."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在这里警戒。", "en": "I stand watch."},
        {"zh": "我抬头听树上的动静。", "en": "I listen to the canopy."},
        {"zh": "地上有虫，我没动。", "en": "A bug on the ground; I don't move."},
        {"zh": "风把叶子吹到我脚边。", "en": "Wind brings leaves to my feet."},
        {"zh": "我换了个方向看。", "en": "I turn to watch another way."},
        {"zh": "群在我旁边吃。", "en": "The flock feeds beside me."},
        {"zh": "我抬脚又放下。", "en": "I lift a foot and set it down."},
        {"zh": "我数着头顶的树。", "en": "I count the trees overhead."},
        {"zh": "天上有点雨意。", "en": "It feels like rain."},
        {"zh": "我伸长脖子听风", "en": "I stretch my neck and listen to the wind."},
        {"zh": "我抬脚，又轻轻放下", "en": "I lift a foot and set it down softly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了我们的地盘。", "en": "You've entered our ground."},
        {"zh": "我伸长脖子看你。", "en": "I stretch my neck to look at you."},
        {"zh": "你站得离群太近了。", "en": "You're too close to the flock."},
        {"zh": "我不是凶的，别怕。", "en": "I'm not fierce; don't fear me."},
        {"zh": "你的动作太突然。", "en": "Your movement was too sudden."},
        {"zh": "你后面还有别人吗？", "en": "Are there others behind you?"},
        {"zh": "别靠幼崽那边。", "en": "Stay away from the young."},
        {"zh": "这群由我看着。", "en": "I watch over this flock."},
        {"zh": "你一退我就好了。", "en": "Step back and I'll settle."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫了一声，退开。", "en": "I call out and pull back."},
        {"zh": "绒羽在风里炸开来", "en": "My down ruffles open in the wind."},
        {"zh": "我趔趄着撞进灌木", "en": "I stagger into the brush."},
        {"zh": "我想跑，但群里还在。", "en": "I want to run, but the flock remains."},
        {"zh": "我压住了伤处。", "en": "I press the wound."},
        {"zh": "血沾在羽毛上。", "en": "Blood stains my feathers."},
        {"zh": "我跳得没刚才快了。", "en": "I can't spring as fast."},
        {"zh": "再打我就要逃。", "en": "One more and I flee."},
        {"zh": "你别再追我了。", "en": "Don't chase me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么东西？", "en": "What is that?"},
        {"zh": "我很好奇，但怕。", "en": "Curious, but afraid."},
        {"zh": "你把东西放手心。", "en": "Put it in your open palm."},
        {"zh": "群里先看我的反应。", "en": "The flock waits on my reaction."},
        {"zh": "这是肉还是果？", "en": "Is it meat or fruit?"},
        {"zh": "鸟群里，我排在最后。", "en": "In the flock, I run last."},
        {"zh": "我闻到了，是能吃的东西。", "en": "I smell it; it's edible."},
        {"zh": "你手里那点吃的，分我一口？", "en": "Whatever you're holding, spare me a bite?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳开一大步。", "en": "I spring a long step away."},
        {"zh": "我吓得跳开了。", "en": "You startled me."},
        {"zh": "别从后面靠近。", "en": "Don't come from behind."},
        {"zh": "我撞在树干上。", "en": "I bumped a trunk."},
        {"zh": "我往旁边退了退。", "en": "I back away."},
        {"zh": "这点碰撞我不习惯。", "en": "I'm not used to being bumped."},
        {"zh": "群里一下就乱了。", "en": "The flock is unsettled."},
        {"zh": "你先走开一点。", "en": "Move off first."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们跳同一段舞。", "en": "We dance the same steps."},
        {"zh": "我把羽毛张开。", "en": "I spread my feathers."},
        {"zh": "你没长着我的腿。", "en": "You don't have legs like mine."},
        {"zh": "我们不是同一种。", "en": "We're not the same kind."},
        {"zh": "只有群里才合适。", "en": "The flock is the right place."},
        {"zh": "我这时候只想守群。", "en": "Right now I only guard the flock."},
        {"zh": "你退开一点点。", "en": "Step back a little."},
        {"zh": "换个时间再说吧。", "en": "Another time."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这不是能吃的。", "en": "This isn't edible."},
        {"zh": "我用爪子拨开。", "en": "I push it aside with a claw."},
        {"zh": "这东西太沉了。", "en": "It's too heavy."},
        {"zh": "我怕它会咬我。", "en": "I fear it might bite."},
        {"zh": "我把它放下了。", "en": "I put it down."},
        {"zh": "这是谁掉下的？", "en": "Who dropped this?"},
        {"zh": "我叼着不合适。", "en": "This doesn't suit my beak."},
        {"zh": "群里不碰这个。", "en": "The flock doesn't touch this."},
        {"zh": "就留在原地吧。", "en": "Leave it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有些响动。", "en": "There's a noise over there."},
        {"zh": "我先伸长脖子。", "en": "I stretch my neck first."},
        {"zh": "群里开始往后退。", "en": "The flock falls back."},
        {"zh": "我抬起一只脚。", "en": "I lift one foot."},
        {"zh": "我要踢它一脚。", "en": "I'll kick it."},
        {"zh": "别往群里走过去。", "en": "Don't head for the flock."},
        {"zh": "它居然还在动。", "en": "It's still moving."},
        {"zh": "我先踢开这条路。", "en": "I go first."},
        {"zh": "这距离够我跑。", "en": "I can run from here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着群体转圈。", "en": "I circle the flock."},
        {"zh": "你走到哪我跟到哪。", "en": "I follow wherever you go."},
        {"zh": "我把腿绷紧了。", "en": "My legs are tensed."},
        {"zh": "它的眼睛一直看我。", "en": "Its eyes keep on me."},
        {"zh": "群退到树后面了。", "en": "The flock is behind the trees."},
        {"zh": "这一脚要踢准。", "en": "This kick must land true."},
        {"zh": "它一步也没退。", "en": "It hasn't backed off."},
        {"zh": "这个角度不好防。", "en": "This angle is hard to guard."},
        {"zh": "我们再等一会儿。", "en": "Wait more."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一脚踢出去。", "en": "A kick lashes out."},
        {"zh": "爪子从它身上划过去。", "en": "My claws rake past."},
        {"zh": "我低头用喙去啄。", "en": "I butt with my head."},
        {"zh": "整群鸟龙，只出一脚警告。", "en": "The whole flock gives one warning kick."},
        {"zh": "它连着退了好几步。", "en": "It fell back a few steps."},
        {"zh": "我这一脚踢空了。", "en": "I missed the kick."},
        {"zh": "我的腿够得着。", "en": "My legs can reach."},
        {"zh": "别靠群体太近。", "en": "Stay away from the flock."},
        {"zh": "我再补上一脚。", "en": "Another stamp."},
        {"zh": "你快点跑开去。", "en": "Run."},
        {"zh": "我用脚趾抓了一下。", "en": "My toe claws rake across."},
        {"zh": "这套动作我练过很多次。", "en": "I've practiced this many times."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从林子里走出来。", "en": "I step out of the trees."},
        {"zh": "这里的树很高。", "en": "The trees are very tall."},
        {"zh": "我数了数身边的同伴", "en": "I count the flockmates around me."},
        {"zh": "群里的还没到齐。", "en": "The flock isn't all here."},
        {"zh": "脚下是松软的落叶。", "en": "Soft leaf litter underfoot."},
        {"zh": "远处有一片河床。", "en": "There's a riverbed in the distance."},
        {"zh": "我抖了抖两条腿。", "en": "I shake out my legs."},
        {"zh": "我朝天空叫了一声。", "en": "I call once."},
        {"zh": "风向还算不错。", "en": "The wind is good."},
        {"zh": "那就一起动身吧。", "en": "Let's go."},
        {"zh": "大家都小心点。", "en": "Careful now."},
        {"zh": "我跟上队伍了。", "en": "I'm with you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的羽毛，焦了一片。", "en": "Fire singed my feathers black."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滑下来，腿折了一下。", "en": "I slid down the slope and my leg twisted."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到我的脖子。", "en": "Water up to my neck."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的翅羽。", "en": "Something pierced my wing feathers."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我站不住。", "en": "That force left me unable to stand straight."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得腿发抖。", "en": "Hunger makes my legs tremble."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在林子里，我浑身一抖。", "en": "Lightning hit the woods; I jolted."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我在下坠。", "en": "The ground vanished; I'm falling."}
      ]
    }
  }
}
