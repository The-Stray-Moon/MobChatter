{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "背上是一排小骨板", "en": "Rows of small bony plates run down my back."},
        {"zh": "我背上那排小甲，磕得响。", "en": "The small plates on my back clatter."},
        {"zh": "四足落地很轻", "en": "Four feet land lightly."},
        {"zh": "沙地上留一串小印", "en": "A string of little prints trails me."},
        {"zh": "我沿着孤峰的坡脚走", "en": "I follow the foot of a butte."},
        {"zh": "尾巴拖着，扫起细沙", "en": "My tail drags, sweeping fine sand."},
        {"zh": "干草划过我的腿", "en": "Dry grass scrapes my legs."},
        {"zh": "我一边走一边抬头看", "en": "I walk with my head up, watchful."},
        {"zh": "有影子就绕开", "en": "Shadows are worth going around."},
        {"zh": "我从石缝里钻过去", "en": "I slip through a gap in the rocks."},
        {"zh": "身体低得几乎贴地", "en": "I'm so low I almost touch earth."},
        {"zh": "跑几步，停一下", "en": "A few steps, then a pause."},
        {"zh": "这片干林子里没什么好吃的", "en": "Not much to eat in this dry wood."},
        {"zh": "我朝低处去找", "en": "I head downslope to look."},
        {"zh": "骨板在阳光下发白", "en": "My plates show white in the sun."},
        {"zh": "我走向一片稀疏的草", "en": "I head for a sparse patch of grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站住，头抬得高高的", "en": "Stopped, head held high."},
        {"zh": "耳朵听着四周", "en": "My ears test every direction."},
        {"zh": "前爪轻轻刨土", "en": "My foreclaws scratch the dirt."},
        {"zh": "背上的骨板一排排的", "en": "Plates in rows down my back."},
        {"zh": "风把沙吹到我脚边", "en": "Wind pushes sand to my feet."},
        {"zh": "我背上那排甲片，很轻。", "en": "The scutes on my back are light."},
        {"zh": "树叶在头顶沙沙响", "en": "Leaves rustle overhead."},
        {"zh": "我背上那排骨板，撑起来了", "en": "The row of scutes on my back stands up"},
        {"zh": "然后再伸出去", "en": "Then extends again."},
        {"zh": "日头晒得很厉害", "en": "The sun is fierce."},
        {"zh": "我找了一小块阴影", "en": "I find a patch of shade."},
        {"zh": "就那样站在那儿", "en": "And stand right there."},
        {"zh": "身体很小，容易被忽略", "en": "I'm small. Easy to overlook."},
        {"zh": "这一点对我正好", "en": "That suits me fine."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬头，离你很远", "en": "I look up. You're far off."},
        {"zh": "你看起来非常巨大", "en": "You look enormous."},
        {"zh": "我慌忙退了半步", "en": "I scramble back a step."},
        {"zh": "骨板都竖起来了", "en": "My plates stand up."},
        {"zh": "不是要打，是怕", "en": "Not aggression. Fear."},
        {"zh": "你站在那里也没有动", "en": "You stand there without moving."},
        {"zh": "我从侧面看你", "en": "I watch you side-on."},
        {"zh": "一只眼睛就够了", "en": "One eye is enough."},
        {"zh": "你的脚步太重", "en": "Your steps are too heavy."},
        {"zh": "我随时都能跑", "en": "I can run at any moment."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我疼得一蹦，骨板撞出响声。", "en": "I leap in pain, my plates clattering."},
        {"zh": "我转身就拼命逃", "en": "I turn and bolt."},
        {"zh": "骨板撞得叮叮响", "en": "My plates rattle as I go."},
        {"zh": "有一条腿有点跛", "en": "I limp a little."},
        {"zh": "我钻进石缝，骨板还在抖。", "en": "I squeeze into a rock crack, my plates still shaking."},
        {"zh": "我全身都在发抖", "en": "My whole body trembles."},
        {"zh": "这一下差点把我打翻", "en": "That nearly knocked me over."},
        {"zh": "我喘得厉害，骨板一起一伏。", "en": "I pant hard, my plates rising and falling."},
        {"zh": "还想再跑远些", "en": "I want to get farther away."},
        {"zh": "可腿不太听话", "en": "But my legs won't quite obey."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那几片叶子很嫩", "en": "Those few leaves are tender."},
        {"zh": "我探着脑袋张望", "en": "I poke my head about."},
        {"zh": "往前挪了一小步", "en": "I edge forward a little."},
        {"zh": "然后再挪一小步", "en": "And a little more."},
        {"zh": "我够到了一片叶", "en": "I reach one leaf."},
        {"zh": "咬了一口，还行", "en": "I bite. Not bad."},
        {"zh": "剩下的我慢慢吃", "en": "I'll eat the rest slowly."},
        {"zh": "眼睛还看着你", "en": "My eyes stay on you."},
        {"zh": "你一动我就停", "en": "If you move, I stop."},
        {"zh": "吃东西也得提防", "en": "Even eating means watching."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我缩起身子，滚出半圈。", "en": "I tuck in and roll half a turn."},
        {"zh": "爬起来就往外跑", "en": "I scramble up and run."},
        {"zh": "骨板磕在地上", "en": "My plates knock the ground."},
        {"zh": "跑了几步才停", "en": "I stop a few strides on."},
        {"zh": "我还回头看了看", "en": "I look back."},
        {"zh": "没什么追上来", "en": "Nothing's following."},
        {"zh": "我抖了抖身上的沙", "en": "I shake the sand off."},
        {"zh": "刚才那一下不轻", "en": "That was a solid knock."},
        {"zh": "还好我个头够小", "en": "Good thing I'm small."},
        {"zh": "钻进石缝就没事了", "en": "A rock gap and I'm safe."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们凑在一起", "en": "We come together."},
        {"zh": "两条尾巴并排", "en": "Two tails side by side."},
        {"zh": "她用鼻子碰我的骨板", "en": "She noses my plates."},
        {"zh": "我带她去有草的地方", "en": "I lead her to where the grass is."},
        {"zh": "那边比较隐蔽", "en": "That spot's well hidden."},
        {"zh": "蛋要埋在沙里", "en": "The eggs go into the sand."},
        {"zh": "蛋埋在沙里，我们换着守。", "en": "The eggs are buried in sand; we take turns."},
        {"zh": "有动静就先跑", "en": "If something moves, we run."},
        {"zh": "跑散了再回来找", "en": "Scattered, we come back after."},
        {"zh": "这是我们的法子", "en": "That's our way."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "低头咬起一片叶", "en": "I dip down and take a leaf."},
        {"zh": "嚼两下就吞下去", "en": "Two chews and it's down."},
        {"zh": "太硬，我吐了", "en": "Too tough. I spit it out."},
        {"zh": "这一片还过得去", "en": "This one's fine."},
        {"zh": "我拖到石头后面", "en": "I drag it behind a stone."},
        {"zh": "边吃边看四周", "en": "Eating while scanning around."},
        {"zh": "剩下的藏在沙里", "en": "The rest I hide in the sand."},
        {"zh": "回头再来找一找", "en": "I'll find it again."},
        {"zh": "或者干脆找不到", "en": "Or I won't."},
        {"zh": "反正本来也不多", "en": "Not much anyway."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "好像有东西在动", "en": "Something moved."},
        {"zh": "我立刻抬起了头", "en": "My head snaps up."},
        {"zh": "骨板全都绷紧", "en": "My plates go rigid."},
        {"zh": "四足分开站稳", "en": "Four feet spread for balance."},
        {"zh": "我的心跳得飞快", "en": "My heart pounds."},
        {"zh": "这地方没什么遮挡", "en": "Not much cover here."},
        {"zh": "我在找最近的石缝", "en": "I'm looking for the nearest gap."},
        {"zh": "就是那一条缝", "en": "That gap right there."},
        {"zh": "只要再跑三步", "en": "Only three strides."},
        {"zh": "我等一个机会", "en": "I wait for a chance."},
        {"zh": "你转头的瞬间", "en": "The moment you turn."},
        {"zh": "机会就在那一下", "en": "The chance is that instant."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直退，不迎上去", "en": "I keep backing off. Never forward."},
        {"zh": "我很小，很不好抓", "en": "I'm small, and hard to catch."},
        {"zh": "我绕着石头转", "en": "I circle behind the stones."},
        {"zh": "你一靠近，我就换个方向", "en": "Approach, and I change direction."},
        {"zh": "骨板挡不了什么", "en": "My plates won't block much."},
        {"zh": "我只能靠跑得快", "en": "Speed is all I have."},
        {"zh": "沙地有点陷脚", "en": "The sand grabs at my feet."},
        {"zh": "我专挑硬地走", "en": "I pick the harder ground."},
        {"zh": "你比我高大太多", "en": "You're so much bigger than me."},
        {"zh": "低头看我就慢一步", "en": "Looking down costs you a step."},
        {"zh": "这一停就够了", "en": "That pause is enough."},
        {"zh": "我一下钻进石缝", "en": "Into the gap I go."},
        {"zh": "你根本进不来", "en": "You can't follow."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住你的靴口，往后拽。", "en": "I clamp onto your boot cuff and pull."},
        {"zh": "三点的伤，不疼", "en": "Three points. Barely anything."},
        {"zh": "我用身体撞你脚踝", "en": "I bump your ankle with my body."},
        {"zh": "骨板划了一下", "en": "My plates scrape you."},
        {"zh": "撞完我马上退", "en": "Then I retreat at once."},
        {"zh": "这一下没咬实", "en": "That didn't land clean."},
        {"zh": "你抬脚，我就跑了", "en": "You lift a foot and I bolt."},
        {"zh": "石头上那些骨板，磨得响。", "en": "The bony plates on my back scrape on the stone."},
        {"zh": "我咬你鞋带，咬完就跑。", "en": "I bite your shoelace, then run."},
        {"zh": "我这身量太小", "en": "My frame is tiny."},
        {"zh": "我咬住鞋带往后拽", "en": "I clamp your lace and tug backward."},
        {"zh": "这一口只是警告", "en": "That bite was only a warning."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "干沙上有一个小影子", "en": "A small shadow on the dry sand."},
        {"zh": "干沙里，我顶着骨板爬出来。", "en": "I push out of the dry sand, plates first."},
        {"zh": "先抬头看了看", "en": "First I look up."},
        {"zh": "天已经大亮了", "en": "The sky is bright."},
        {"zh": "四周是孤峰和干树", "en": "Buttes and dry trees all around."},
        {"zh": "我把背抖了一下", "en": "I give my back a shake."},
        {"zh": "骨板发出一声轻响", "en": "My plates rattle softly."},
        {"zh": "脚下全是松沙", "en": "Loose sand underfoot."},
        {"zh": "我先找了个遮挡", "en": "First, I find cover."},
        {"zh": "然后慢慢往外挪", "en": "Then creep out."},
        {"zh": "这地方挺适合我", "en": "This place suits me."},
        {"zh": "小，就活得下来", "en": "Being small keeps you alive."},
        {"zh": "我朝草那边去", "en": "I head for the grass."},
        {"zh": "我一步一步地走", "en": "One step at a time."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "骨板被烤得发烫", "en": "Fire heats my plates until they sting."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时四脚一软", "en": "All four legs buckle on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里乱蹬", "en": "I kick wildly in the water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我掀过孤峰的石脊。", "en": "The blast throws me over the mesa ridge."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎在背上", "en": "Something sticks in my back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "全身一阵发麻", "en": "My whole body tingles."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得连路都走不动", "en": "Too hungry to walk."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打得我四脚离地", "en": "Lightning lifts all four feet off the ground."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的地突然空了", "en": "The ground under me vanished."}
      ]
    }
  }
}
