{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面走，很重。", "en": "I keep low and heavy to the ground."},
        {"zh": "尾巴拖着，扫出浅沟。", "en": "My tail drags, cutting a shallow trench."},
        {"zh": "两格宽的背走起来稳。", "en": "Two blocks wide and steady."},
        {"zh": "我压过栏木，一下就断。", "en": "Saplings snap under me."},
        {"zh": "我沿着河岸的硬土走。", "en": "I walk the hard earth of the riverbank."},
        {"zh": "背后那排刺谁都不想碰。", "en": "Nobody wants to touch the spikes on my back."},
        {"zh": "我一边走一边嗅块茎。", "en": "I sniff for tubers as I walk."},
        {"zh": "蹄子踏在石头上很响。", "en": "Hooves clatter on stone."},
        {"zh": "我走得不快，没必要快。", "en": "Slow. There is no need to hurry."},
        {"zh": "红杉林里的地面很软。", "en": "The ground in the redwood grove is soft."},
        {"zh": "我一步步挪过空地。", "en": "I shift across the clearing."},
        {"zh": "我的背甲刮过树枝。", "en": "My armour scrapes through branches."},
        {"zh": "我绕开深的水坑。", "en": "I go around the deep pool."},
        {"zh": "我用喙拱了拱土。", "en": "I root at the soil with my beak."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着，像一块石头。", "en": "I hunker down like a rock."},
        {"zh": "尾锤放在地上，很沉。", "en": "My tail club rests on the ground, heavy."},
        {"zh": "草在我背甲缝里长。", "en": "Grass grows in my armour's seams."},
        {"zh": "我闻到了块茎的味道。", "en": "I smell tubers."},
        {"zh": "我不用怕大部分东西。", "en": "Most things hold no fear for me."},
        {"zh": "我挪了挪脚，换了个姿势。", "en": "I shift my feet."},
        {"zh": "幼崽在我身侧。", "en": "My young stands at my flank."},
        {"zh": "这地方有一片好土。", "en": "Good soil here."},
        {"zh": "我把尾巴摆了摆。", "en": "I swing my tail once."},
        {"zh": "甲片上有一道旧裂。", "en": "An old crack in my plating."},
        {"zh": "有只虫在背甲上走。", "en": "An insect walks my back."},
        {"zh": "我很困，但我不睡。", "en": "I am drowsy, but I do not sleep."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我背上的刺不是装饰。", "en": "The spikes are not decoration."},
        {"zh": "你想吃我的草？", "en": "After my grass?"},
        {"zh": "背甲上的土，往下掉。", "en": "Dirt slides off my armour plates."},
        {"zh": "你退一步，大家都好。", "en": "One step back suits us both."},
        {"zh": "幼崽在我这边。", "en": "My young is on this side."},
        {"zh": "这一带我天天走。", "en": "I walk this ground daily."},
        {"zh": "我闻到你身上的金属。", "en": "I smell metal on you."},
        {"zh": "再靠近我就转身。", "en": "One step more and I turn."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲挡了大半，还是疼。", "en": "The plates took most of it. Still hurts."},
        {"zh": "我慢慢挪开半步。", "en": "I shift half a step."},
        {"zh": "我喘了一口重气。", "en": "I let out a heavy breath."},
        {"zh": "尾锤差点脱了力。", "en": "The club nearly lost its momentum."},
        {"zh": "我不叫，我只会瞪。", "en": "I do not cry out. I stare."},
        {"zh": "背上有一片甲裂了。", "en": "One plate has split."},
        {"zh": "我护住幼崽。", "en": "I shield my young."},
        {"zh": "十点护甲，挡了大半。", "en": "Ten points of armour stop most of it."},
        {"zh": "还能再来。", "en": "I can take more."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块茎归我。", "en": "That tuber is mine."},
        {"zh": "这股味道我认得。", "en": "I know this smell."},
        {"zh": "这块茎太干，换块带泥的。", "en": "This tuber is too dry; bring one still muddy."},
        {"zh": "这一带草不够了。", "en": "The grass here is running out."},
        {"zh": "我闻了闻，吃了。", "en": "I sniff, then eat."},
        {"zh": "那块根茎的味道，我闻到了。", "en": "I smell that tuber from here."},
        {"zh": "别拿吃的在我眼前晃。", "en": "Don't wave food in front of my face."},
        {"zh": "你要是懂规矩，就把嫩叶放下。", "en": "If you know your manners, set those tender leaves down."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上的是十点护甲。", "en": "That is ten points of armor you hit."},
        {"zh": "我的背甲蹭到你了。", "en": "My plating brushed you."},
        {"zh": "你撞到了尾锤。", "en": "You met the tail club."},
        {"zh": "两个人的路，太挤。", "en": "Two of us. Too narrow."},
        {"zh": "这一下我那头都晃。", "en": "That shook even me."},
        {"zh": "地面被我压出坑。", "en": "I left a dent in the ground."},
        {"zh": "我的背甲擦过你的肩。", "en": "My armour plate scrapes past your shoulder."},
        {"zh": "撞我一下，尾锤可不会客气。", "en": "One shove from you and my tail club won't be gentle."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这一片只留一个。", "en": "Only one holds this range."},
        {"zh": "这不是好时候。", "en": "Not a good time."},
        {"zh": "幼崽要先长大。", "en": "The young must grow first."},
        {"zh": "我把尾巴放下。", "en": "I lower my tail."},
        {"zh": "幼崽在旁边，别靠近。", "en": "The young are nearby; keep back."},
        {"zh": "我不喜欢吵。", "en": "I dislike noise."},
        {"zh": "我在河边有固定的地方。", "en": "I have a usual spot by the river."},
        {"zh": "再等一季。", "en": "Another season."},
        {"zh": "我慢慢转开身。", "en": "I turn away slowly."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用喙拱出来。", "en": "I root it out with my beak."},
        {"zh": "这土里有块茎。", "en": "There are tubers in this soil."},
        {"zh": "不是食物，我不管。", "en": "Not food. I ignore it."},
        {"zh": "我啃了两口。", "en": "I gnaw twice."},
        {"zh": "我推了推。", "en": "I shove it."},
        {"zh": "不够填肚子。", "en": "Not enough to fill me."},
        {"zh": "我接着挖。", "en": "I keep digging."},
        {"zh": "地上那株，我早标记好了。", "en": "That plant on the ground was already marked by me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我转过身，尾巴对着你。", "en": "I turn my tail to face you."},
        {"zh": "你该退后。", "en": "You should back away."},
        {"zh": "我的尾锤已经抬起来。", "en": "My club is up."},
        {"zh": "这一片是我的。", "en": "This ground is mine."},
        {"zh": "我不追你，我等你来。", "en": "I will not chase. I wait."},
        {"zh": "幼崽退到我后面。", "en": "My young steps behind me."},
        {"zh": "我的喉咙里滚出一声闷响。", "en": "A muffled rumble rolls out of my throat."},
        {"zh": "你打不穿这身甲。", "en": "You will not get through this armour."},
        {"zh": "我把四只脚踩实。", "en": "I plant all four feet."},
        {"zh": "河岸崖边，我刨块茎吃。", "en": "On the river cliff, I dig tubers."},
        {"zh": "尾锤抬起来，就等你靠近。", "en": "My tail club is raised, waiting for you to come close."},
        {"zh": "这身骨头很沉。", "en": "This frame is heavy."},
        {"zh": "尾巴已经挥起来了。", "en": "The tail is already swinging."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的尾巴先转过来。", "en": "My tail swings around first."},
        {"zh": "你的位置我记得。", "en": "I know where you are."},
        {"zh": "腿上中一下就很疼。", "en": "One hit on the legs would hurt."},
        {"zh": "我的背甲对着你。", "en": "My armour faces you."},
        {"zh": "尾锤在地上拖着。", "en": "The club drags on the ground."},
        {"zh": "你退到栏木那边了。", "en": "You have reached the saplings."},
        {"zh": "我在等你贴上来。", "en": "I wait for you to close in."},
        {"zh": "我脚下压碎了一块石头。", "en": "A stone crumbles under me."},
        {"zh": "白垩纪的闷响，你听见了吗？", "en": "That Cretaceous thud — did you hear it?"},
        {"zh": "再近就轮到我。", "en": "One step more and it is my turn."},
        {"zh": "我的脖子很硬。", "en": "My neck is armoured."},
        {"zh": "你砍的地方没护甲吗？", "en": "Any gap in my plating?"},
        {"zh": "我不慌。", "en": "I am not hurried."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "尾锤扫过去，风都变了。", "en": "The club sweeps and the air changes."},
        {"zh": "我用喙咬你的腿。", "en": "I snap at your legs with my beak."},
        {"zh": "这一下十四点。", "en": "That one is fourteen points."},
        {"zh": "你被砸得坐地上了。", "en": "That knocks you down."},
        {"zh": "我的尾巴比你的武器长。", "en": "My tail outranges your weapon."},
        {"zh": "我撞过去，像一堵墙。", "en": "I charge like a wall."},
        {"zh": "你的护甲被压出个坑。", "en": "Your armor dents."},
        {"zh": "这一扫把你推开三尺。", "en": "The sweep throws you three blocks."},
        {"zh": "我退回来，护住幼崽。", "en": "I pull back to cover my young."},
        {"zh": "我的背甲撞你的膝盖。", "en": "My plating hits your knee."},
        {"zh": "我的尾锤，专打近身的。", "en": "My tail club is for anything up close."},
        {"zh": "我这一尾巴，能敲碎腿骨。", "en": "One swing of my tail can break a leg bone."},
        {"zh": "现在你该走了。", "en": "Now you should leave."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从河岸的硬土上走来。", "en": "I come up the hard riverbank."},
        {"zh": "背甲上的土还没掉。", "en": "Soil still clings to my armour."},
        {"zh": "红杉林里我走得很稳。", "en": "I walk the redwoods steadily."},
        {"zh": "我把尾锤往地上一放。", "en": "I set my club down on the ground."},
        {"zh": "这一片有块茎。", "en": "Tubers here."},
        {"zh": "两格高，两格宽。", "en": "Two blocks tall, two wide."},
        {"zh": "我的影子很宽。", "en": "My shadow is wide."},
        {"zh": "草被我踩平了。", "en": "The grass is flattened under me."},
        {"zh": "幼崽跟着我。", "en": "My young follows me."},
        {"zh": "我停在空地边上。", "en": "I stop at the edge of the clearing."},
        {"zh": "这里土很松。", "en": "Loose soil here."},
        {"zh": "我嗅到了水。", "en": "I smell water."},
        {"zh": "我从河岸的硬土上爬上来。", "en": "I haul myself up the hard riverbank soil."},
        {"zh": "我一步一步挪进场。", "en": "I shift into the field, step by step."},
        {"zh": "我的甲片咯吱响。", "en": "My plates creak."},
        {"zh": "谁在这儿？", "en": "Who is here?"}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着背甲，缝隙发烫。", "en": "Fire heats my plating; the seams burn."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我太重，一进水就往下沉。", "en": "Too heavy — in water I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀得翻了一半。", "en": "The blast tips me half over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭撞在甲上，弹开了。", "en": "An arrow rings off my plating."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力从甲缝钻进去。", "en": "Magic finds a seam."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，我连土都拱不动。", "en": "Hungry, I cannot even root."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在背甲上，我抖了一下。", "en": "Lightning hits my plating; I shudder."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有地，我的重量也没用了。", "en": "No ground, and my weight means nothing."}
      ]
    }
  }
}
