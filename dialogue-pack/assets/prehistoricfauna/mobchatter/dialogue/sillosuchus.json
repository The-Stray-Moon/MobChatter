{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我三步一顿地走过林间", "en": "I cross the clearing in heavy strides."},
        {"zh": "身体宽，肩膀很厚", "en": "Broad body, thick shoulders."},
        {"zh": "四足踩得地面发闷", "en": "Four feet make the ground thud."},
        {"zh": "我沿着林缘巡自己的地", "en": "I patrol my range along the tree line."},
        {"zh": "脖子低低地伸在前头", "en": "My neck rides low out front."},
        {"zh": "尾巴扫过灌木，叶子乱掉", "en": "My tail sweeps the shrubs, scattering leaves."},
        {"zh": "我跳过一道浅沟", "en": "I step over a shallow ditch."},
        {"zh": "地面被踩出大印", "en": "Big prints sink behind me."},
        {"zh": "林子里有响动，我停下听。", "en": "Something stirs in the trees; I stop to listen."},
        {"zh": "只好再往前走", "en": "Then move on."},
        {"zh": "三叠纪的林子，很闷热", "en": "Triassic woods. Hot and close."},
        {"zh": "我走得很慢，像在称地", "en": "I walk slowly, as if weighing the earth."},
        {"zh": "每棵树我都认得", "en": "I know every tree here."},
        {"zh": "有新的气味，很淡", "en": "A new smell, faint."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站着，四足撑得很开", "en": "Standing with my four feet planted wide."},
        {"zh": "我低头啃了一口蕨", "en": "I dip my head for a fern."},
        {"zh": "喉咙里低低地响", "en": "A low rumble in my throat."},
        {"zh": "颈侧的皮抖了一下", "en": "The hide on my neck twitches."},
        {"zh": "风从背脊上吹过", "en": "Wind moves along my spine."},
        {"zh": "我正在盯着边界", "en": "I'm watching the boundary."},
        {"zh": "那片林间空地是我的", "en": "That clearing is mine."},
        {"zh": "有别的动物在那边吃草", "en": "Other animals graze over there."},
        {"zh": "我也懒得赶它们", "en": "I don't bother chasing them off."},
        {"zh": "只要不靠近就行", "en": "So long as they keep their distance."},
        {"zh": "我把重心往后放了放", "en": "I settle my weight back."},
        {"zh": "日光很晒，我不在乎", "en": "The sun is harsh. I don't mind."},
        {"zh": "有虫在腿边飞", "en": "Insects fly about my legs."},
        {"zh": "我甩尾，赶开腿边的飞虫。", "en": "I flick my tail to shoo the flies."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头，正对你", "en": "I raise my head square at you."},
        {"zh": "你不该站在那儿", "en": "You shouldn't be standing there."},
        {"zh": "这是我的边界", "en": "This is my boundary."},
        {"zh": "我往前压了半步", "en": "I lean half a step in."},
        {"zh": "你倒是先退了", "en": "You stepped back first."},
        {"zh": "这样便很好了", "en": "That's just fine."},
        {"zh": "我又把脖子低下去", "en": "I lower my neck again."},
        {"zh": "但眼睛还看着你", "en": "But my eyes stay on you."},
        {"zh": "我在算你有多重", "en": "I'm guessing how heavy you are."},
        {"zh": "分量一点也不重", "en": "Not heavy at all."},
        {"zh": "也就一只小兽的样子", "en": "About the size of small game."},
        {"zh": "我决定再看看", "en": "I decide to watch a little longer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低声音吼了一声", "en": "I give a low rumble."},
        {"zh": "我没退，只是转了转肩", "en": "I don't retreat. I roll my shoulder."},
        {"zh": "这一下打在厚皮上", "en": "That landed on thick hide."},
        {"zh": "血从颈侧渗出来", "en": "Blood seeps at my neck."},
        {"zh": "我现在更生气了", "en": "Now I'm angrier."},
        {"zh": "四足又分开了一些", "en": "My stance widens."},
        {"zh": "喉咙里的声音没停", "en": "The growl doesn't stop."},
        {"zh": "你这一记不轻", "en": "That was a heavy blow."},
        {"zh": "可是我还站得住", "en": "I'm still standing."},
        {"zh": "这一步我不退", "en": "I won't give this step."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "蕨叶被递到跟前", "en": "Fern fronds held out to me."},
        {"zh": "我垂头闻了闻", "en": "I dip my head to sniff."},
        {"zh": "这个确实是能吃的", "en": "It's edible."},
        {"zh": "我咬了一大口", "en": "I take a big bite."},
        {"zh": "叶子被扯得乱七八糟", "en": "The fronds come away ragged."},
        {"zh": "这点不够我塞牙", "en": "Not enough to fill a tooth gap."},
        {"zh": "我侧眼看了你一下", "en": "I cut my eyes at you."},
        {"zh": "你还把举着手举着", "en": "Your hand is still out."},
        {"zh": "那就再给一点", "en": "Then give a little more."},
        {"zh": "我不会为此低头", "en": "I won't bow my head for it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，像撞墙", "en": "You hit me like a wall."},
        {"zh": "你撞上来，我的脚没动。", "en": "You hit me; my feet don't shift."},
        {"zh": "你连着退了好几步", "en": "You stumble back several steps."},
        {"zh": "我垂下脖子，打量你这个小东西。", "en": "I lower my neck to study you, so small."},
        {"zh": "我没打算追你", "en": "I'm not going to chase."},
        {"zh": "我的身体很宽", "en": "My body is broad."},
        {"zh": "两个人并排都绕不过去", "en": "Two men couldn't walk past abreast."},
        {"zh": "我把身子侧了侧", "en": "I turn slightly."},
        {"zh": "给你让出一条缝", "en": "Leaving a gap."},
        {"zh": "你就走那一边", "en": "Go that way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在这个空地上相遇", "en": "We meet in this clearing."},
        {"zh": "她的身子比我还宽", "en": "She's broader than I am."},
        {"zh": "我们用颈侧互相蹭", "en": "We rub neck against neck."},
        {"zh": "然后一同低头吃蕨", "en": "Then we lower our heads to the ferns."},
        {"zh": "边界上我们一起走", "en": "We walk the boundary together."},
        {"zh": "有外人来，就一起挡", "en": "When strangers come, we block together."},
        {"zh": "蛋埋在向阳的土里", "en": "The eggs go into sun-facing soil."},
        {"zh": "她守着，我去巡", "en": "She guards. I patrol."},
        {"zh": "我们轮流来看", "en": "We take turns."},
        {"zh": "这片地，我们一起看", "en": "We both watch this ground."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "低头咬住一丛", "en": "I dip and take a clump."},
        {"zh": "扯下来，慢慢嚼", "en": "I tear it loose and chew slowly."},
        {"zh": "蕨的茎实在太韧", "en": "Fern stems are tough."},
        {"zh": "我得嚼上很久", "en": "It takes a long time."},
        {"zh": "嘴边的汁往下滴", "en": "Juice drips from my mouth."},
        {"zh": "我又咬了一大口", "en": "I take another big bite."},
        {"zh": "蕨的茎实在太韧。", "en": "Fern stems are far too tough."},
        {"zh": "我去那一边找找", "en": "I'll look over there."},
        {"zh": "那边蕨叶很多", "en": "More ferns there."},
        {"zh": "我慢慢走过去", "en": "I walk over slowly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西进了我的地界", "en": "Something entered my range."},
        {"zh": "我把脖子抬起来", "en": "I lift my neck."},
        {"zh": "喉咙里的响动更低", "en": "The rumble in my throat deepens."},
        {"zh": "四足分开，站得很稳", "en": "Four feet brace."},
        {"zh": "我朝那个方向走了两步", "en": "I take two steps that way."},
        {"zh": "这两步踩得很响", "en": "Those two steps are loud."},
        {"zh": "是专门给你听的", "en": "That was for your ears."},
        {"zh": "你终于停下了", "en": "You stopped."},
        {"zh": "这样也算很好", "en": "This will do fine."},
        {"zh": "再往前走就不是这个结果", "en": "Forward again, and it ends differently."},
        {"zh": "我等你做选择", "en": "I wait for your choice."},
        {"zh": "我这身高三格半，站得稳。", "en": "Three and a half blocks tall, I stand firm."},
        {"zh": "我把幼崽护到身后", "en": "I nudge my young one behind me."},
        {"zh": "眼睛始终钉着你", "en": "My eyes never leave you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我不冲，我压过去", "en": "I don't charge. I press."},
        {"zh": "一步一米，很稳", "en": "A yard a step, steady."},
        {"zh": "你退我就跟着", "en": "Step back and I follow."},
        {"zh": "林间空地是我的", "en": "The clearing is mine."},
        {"zh": "我挡在你和出路之间", "en": "I put myself between you and the way out."},
        {"zh": "两边全都是树", "en": "Trees on both sides."},
        {"zh": "你只能往后退", "en": "You can only go back."},
        {"zh": "我一直不加速", "en": "I never speed up."},
        {"zh": "我根本不需要", "en": "No need."},
        {"zh": "我的体重会替你决定", "en": "My weight will decide for you."},
        {"zh": "七点伤害，够你退", "en": "Seven points of pain should be enough."},
        {"zh": "再来就不止这些", "en": "Come again and it's more."},
        {"zh": "一直到最后一步", "en": "To the last step."},
        {"zh": "我在这里停下", "en": "I stop here."},
        {"zh": "你还有一次机会", "en": "You have one chance left."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用头撞你的胸", "en": "I ram my head into your chest."},
        {"zh": "前足抬起来，又落下", "en": "My forefoot lifts and comes down."},
        {"zh": "尾巴横着扫过去", "en": "My tail sweeps across."},
        {"zh": "肩膀一顶，你退了三步", "en": "A shoulder shove, and you're back three steps."},
        {"zh": "这一下并不算狠", "en": "That wasn't a fierce blow."},
        {"zh": "我是护着地方，不是要杀你", "en": "I'm guarding ground, not trying to kill."},
        {"zh": "你挡住了，脚陷进土", "en": "You block it and your feet sink."},
        {"zh": "我这身重量不好接", "en": "This much weight is hard to take."},
        {"zh": "撞完我就退开", "en": "After the shove I step back."},
        {"zh": "回我的空地去", "en": "Back to my clearing."},
        {"zh": "你走你的路去", "en": "You go your way."},
        {"zh": "别再回到这里", "en": "Don't come back."},
        {"zh": "下次我不会先停", "en": "Next time I won't stop first."},
        {"zh": "把这句话记住", "en": "Remember that."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "林间空地上多了个影子", "en": "A shape appears in the clearing."},
        {"zh": "我站起来，比树还宽", "en": "I stand, wider than the trees."},
        {"zh": "四足踩实了土", "en": "Four feet settle into soil."},
        {"zh": "脖子慢慢抬起来", "en": "My neck rises slowly."},
        {"zh": "三叠纪的热气扑在背上", "en": "Triassic heat lies on my back."},
        {"zh": "我先嗅了一圈", "en": "I sniff a full circle."},
        {"zh": "这里没有我的气味", "en": "My scent isn't here."},
        {"zh": "那我得留下气味", "en": "Then I'll leave my scent."},
        {"zh": "我用爪子刮了刮地", "en": "My claws rake the ground."},
        {"zh": "然后走进林子里", "en": "Then I walk into the trees."},
        {"zh": "我的地界从现在开始", "en": "My range begins now."},
        {"zh": "谁过来都得知道", "en": "Anyone who comes will learn."},
        {"zh": "这一点我不让步", "en": "That much I won't concede."},
        {"zh": "我朝空地走去", "en": "I head for the clearing."},
        {"zh": "我一步一步走", "en": "Step by step."},
        {"zh": "所以我走得很慢", "en": "So I walk very slowly."},
        {"zh": "但每一步都算数", "en": "But every step counts."},
        {"zh": "这就是我的方式", "en": "That's how I do things."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "厚皮被烤得发紧", "en": "Heat tightens my thick hide."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时四足一沉", "en": "Four feet drive deep on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我转不开身", "en": "In water I can't turn around."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风推得我晃了一下", "en": "The blast rocks me sideways."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根箭插在我肩上，很浅。", "en": "An arrow sticks shallowly in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股劲穿过了厚皮", "en": "This force passes through thick hide."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着就没力气守地", "en": "Hungry, I can't hold ground."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打得我全身一颤", "en": "Lightning jolts my whole body."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的土裂开了", "en": "The soil under me splits."}
      ]
    }
  }
}
