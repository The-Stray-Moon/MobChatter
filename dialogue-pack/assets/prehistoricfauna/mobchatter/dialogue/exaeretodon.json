{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步走，身体左右摆。", "en": "I walk step by step, my body rolling side to side."},
        {"zh": "四条腿分得很开，像蜥蜴。", "en": "Four legs splay out, lizard-like."},
        {"zh": "嘴巴很大，走在前面。", "en": "My big head leads the way."},
        {"zh": "我沿着河湾的泥地走。", "en": "I walk the mud along the river bend."},
        {"zh": "三叠纪的风比现在的干。", "en": "The Triassic wind is drier than now."},
        {"zh": "我走走停停，嗅地上的根。", "en": "I stop and start, sniffing roots."},
        {"zh": "关节在响。", "en": "My joints creak."},
        {"zh": "我朝林子边缘去。", "en": "I head for the forest edge."},
        {"zh": "地上的落叶被我压得沙沙响。", "en": "Leaves rasp under me."},
        {"zh": "我绕开一截倒下的树干。", "en": "I go around a fallen trunk."},
        {"zh": "又回头看了一眼。", "en": "And glance back once."},
        {"zh": "后面没有东西跟着。", "en": "Nothing follows."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在地上休息。", "en": "I lie on the ground to rest."},
        {"zh": "肚子贴住暖土。", "en": "My belly rests on warm soil."},
        {"zh": "我张开嘴，慢慢呼气。", "en": "I open my mouth and breathe out slowly."},
        {"zh": "牙齿不尖，磨得很平。", "en": "My teeth are not sharp; they are worn flat."},
        {"zh": "有虫子落在我的眼角。", "en": "A bug lands at the corner of my eye."},
        {"zh": "我眨了一下。", "en": "I blink once."},
        {"zh": "风带来草的味道。", "en": "Wind brings the smell of grass."},
        {"zh": "我抬起头闻。", "en": "I lift my head to sniff."},
        {"zh": "远处有别的脚步声。", "en": "Other steps sound far off."},
        {"zh": "我没有起来。", "en": "I do not get up."},
        {"zh": "还没有必要。", "en": "Not yet necessary."},
        {"zh": "我换了个姿势，继续晒。", "en": "I shift and keep sunning."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头，嘴还半张着。", "en": "I raise my head, mouth still half open."},
        {"zh": "你不像这儿的动物。", "en": "You are unlike the animals here."},
        {"zh": "我慢慢转过身体。", "en": "I turn my body slowly."},
        {"zh": "我的腿分得很开。", "en": "My legs are set wide."},
        {"zh": "你不退，我也不退。", "en": "You do not step back; neither do I."},
        {"zh": "我们隔着一条沟。", "en": "A ditch lies between us."},
        {"zh": "不是威胁，是热。", "en": "Not a threat: heat."},
        {"zh": "我合上了。", "en": "I close it."},
        {"zh": "你往前走了一步。", "en": "You take one step forward."},
        {"zh": "我也往前了一步。", "en": "I take one too."},
        {"zh": "我们对视了很久。", "en": "We hold each other's gaze a long time."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身体歪向一边。", "en": "My body tips to one side."},
        {"zh": "皮上多了一道口子。", "en": "A cut opens in my hide."},
        {"zh": "我转了半个身。", "en": "I turn half around."},
        {"zh": "我张嘴喘着。", "en": "I pant with my mouth open."},
        {"zh": "腿有点软。", "en": "My legs feel weak."},
        {"zh": "我慢慢撑住。", "en": "I brace slowly."},
        {"zh": "血滴在红土上。", "en": "Blood drops on red soil."},
        {"zh": "我抬头看它。", "en": "I raise my eyes to it."},
        {"zh": "我没有跑。", "en": "I do not run."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "是嫩根的味道。", "en": "The smell of tender roots."},
        {"zh": "那块腐肉味道不坏。", "en": "That carrion doesn't smell half bad."},
        {"zh": "我咬住，往上一扯。", "en": "I bite and pull."},
        {"zh": "土翻起来一块。", "en": "A clod of soil turns up."},
        {"zh": "这颗种子有点硬。", "en": "This seed is a bit tough."},
        {"zh": "这个够我嚼很久。", "en": "This will take a long while to chew."},
        {"zh": "我又咬了一口土。", "en": "I bite the soil as well."},
        {"zh": "没有关系。", "en": "It does not matter."},
        {"zh": "我把根拖到树荫下。", "en": "I drag the root into the shade."},
        {"zh": "慢慢吃。", "en": "And eat slowly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的侧腹。", "en": "You hit my flank."},
        {"zh": "我把前肢撑得更稳。", "en": "I plant my forelimbs more firmly."},
        {"zh": "我反而往你那边挪了挪。", "en": "I actually shift toward you."},
        {"zh": "你退开，我才低下头。", "en": "Only when you back off do I lower my head."},
        {"zh": "我的爪子踩在你的影子上。", "en": "My claws press your shadow."},
        {"zh": "你绕过去。", "en": "You go around."},
        {"zh": "我的尾巴扫过碎石。", "en": "My tail sweeps across the gravel."},
        {"zh": "尾巴扫了一下。", "en": "A sweep of my tail."},
        {"zh": "地上留了一道痕。", "en": "A mark remains on the ground."},
        {"zh": "我继续晒太阳。", "en": "I go back to sunning."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在河湾碰头。", "en": "We meet at the river bend."},
        {"zh": "绕了几圈，鼻子贴着鼻子。", "en": "We circle, nose to nose."},
        {"zh": "她的背上有旧伤。", "en": "She has an old scar on her back."},
        {"zh": "我们把窝挖在软土里。", "en": "We dig the nest in soft soil."},
        {"zh": "坑不深，够放下身体。", "en": "Not deep, just enough for a body."},
        {"zh": "她先趴进去。", "en": "She lies in it first."},
        {"zh": "我在外面守着。", "en": "I keep watch outside."},
        {"zh": "太阳落下去了。", "en": "The sun goes down."},
        {"zh": "风变凉了。", "en": "The wind turns cool."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个不像吃的。", "en": "This does not look like food."},
        {"zh": "我咬了咬。", "en": "I test it with my teeth."},
        {"zh": "硬的。", "en": "Hard."},
        {"zh": "我吐出来。", "en": "I spit it out."},
        {"zh": "这个可以吃。", "en": "This one I can eat."},
        {"zh": "我慢慢嚼。", "en": "I chew slowly."},
        {"zh": "味道有点怪。", "en": "The taste is odd."},
        {"zh": "我继续嚼。", "en": "I keep chewing."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西踩在我的地盘上。", "en": "Something has stepped on my ground."},
        {"zh": "我闻到河岸那边的气味。", "en": "I catch a scent from the riverbank."},
        {"zh": "三叠纪的土，压着我不轻。", "en": "Triassic soil lies heavy on me."},
        {"zh": "四条腿撑住身体。", "en": "Four legs take my weight."},
        {"zh": "我把嘴张开。", "en": "I open my mouth."},
        {"zh": "这会让它显得大一些。", "en": "This makes it look bigger."},
        {"zh": "它没有退。", "en": "It does not retreat."},
        {"zh": "那我就走过去。", "en": "Then I will walk over."},
        {"zh": "很快，但只有几步。", "en": "Quickly, but only a few steps."},
        {"zh": "我的身体左右摆。", "en": "My body rolls side to side."},
        {"zh": "我八点血，也敢龇牙。", "en": "Eight health, and I still bare my teeth."},
        {"zh": "我停了下来。", "en": "I stop."},
        {"zh": "够我咬一口就行。", "en": "One bite's worth is all I need."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它比我想的快。", "en": "It is faster than I thought."},
        {"zh": "我跑起来。", "en": "I run."},
        {"zh": "身体摆得更厉害。", "en": "My body rolls more."},
        {"zh": "我也过去。", "en": "I go too."},
        {"zh": "石头挡了我一下。", "en": "The rock checks me."},
        {"zh": "我从旁边绕。", "en": "I go round."},
        {"zh": "它又跑了。", "en": "It runs again."},
        {"zh": "这次我咬住它的尾巴。", "en": "This time I bite its tail."},
        {"zh": "它拖着我走了几步。", "en": "It drags me a few steps."},
        {"zh": "我没松口。", "en": "I do not let go."},
        {"zh": "它的皮很厚。", "en": "Its hide is thick."},
        {"zh": "我的牙磨平了。", "en": "My teeth are worn flat."},
        {"zh": "这不是咬，是拖。", "en": "This is not biting: it is dragging."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞过去，用肩。", "en": "I ram with my shoulder."},
        {"zh": "它没倒。", "en": "It does not fall."},
        {"zh": "用我厚实的肩，撞开你。", "en": "My heavy shoulder shoves you aside."},
        {"zh": "这次它歪了。", "en": "This time it lists."},
        {"zh": "我用牙咬住它的腿。", "en": "I clamp my teeth on its leg."},
        {"zh": "牙不尖，但很有力。", "en": "My teeth are blunt, but strong."},
        {"zh": "我甩头。", "en": "I shake my head."},
        {"zh": "它被带倒了。", "en": "It is pulled down."},
        {"zh": "我压上去。", "en": "I press down on it."},
        {"zh": "它在我下面喘。", "en": "It pants beneath me."},
        {"zh": "我的牙咬进你的衣角。", "en": "My teeth sink into the hem of your coat."},
        {"zh": "这次松开了。", "en": "Then let go."},
        {"zh": "它滚下坡。", "en": "It rolls down the slope."},
        {"zh": "我站在坡上看着。", "en": "I stand at the top and watch."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "身上还带着泥。", "en": "Mud still clings to me."},
        {"zh": "我先打了个哈欠。", "en": "First I yawn."},
        {"zh": "嘴巴张得很大。", "en": "My mouth opens wide."},
        {"zh": "这片河湾是三叠纪的。", "en": "This bend belongs to the Triassic."},
        {"zh": "土是红的。", "en": "The soil is red."},
        {"zh": "草很硬。", "en": "The grass is coarse."},
        {"zh": "正合我的胃口。", "en": "Just to my taste."},
        {"zh": "我慢慢走了几步。", "en": "I walk a few steps."},
        {"zh": "身体左右摆。", "en": "My body rolls."},
        {"zh": "我停在一丛矮树边。", "en": "I stop by a low shrub."},
        {"zh": "开始吃。", "en": "And begin to eat."},
        {"zh": "很远的地方有吼声。", "en": "A roar sounds far away."},
        {"zh": "我抬头听。", "en": "I lift my head to listen."},
        {"zh": "那不是我的事。", "en": "That is not my concern."},
        {"zh": "我嘴里嚼的是蕨叶。", "en": "I'm chewing fern leaves."},
        {"zh": "吃完再走。", "en": "Walk when I am done."},
        {"zh": "我低头又咬了一口嫩叶。", "en": "I lower my head for another bite of soft leaves."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的背，皮都紧了。", "en": "Fire roasts my back; my hide tightens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坎上滚下去，摔得很重。", "en": "I roll off a ledge and land hard."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "泥水灌进大嘴，我蹬腿。", "en": "Muddy water fills my mouth; I kick."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股麻顺着脊背爬。", "en": "A numbness climbs my spine."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我连硬草都嚼。", "en": "Hungry enough to chew the coarse grass."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在红土上，我伏下去。", "en": "Lightning strikes red soil; I flatten."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我张着嘴往下掉。", "en": "The ground goes and I fall, mouth open."}
      ]
    }
  }
}
