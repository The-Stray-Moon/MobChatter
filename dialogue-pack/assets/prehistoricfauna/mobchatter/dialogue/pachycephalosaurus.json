{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我埋着头一路顶过去。", "en": "I walk with my head down."},
        {"zh": "红杉林下有我的路。", "en": "I have paths under the redwoods."},
        {"zh": "我撞开挡路的矮枝。", "en": "I butt the low branches aside."},
        {"zh": "我的尾巴帮我平衡。", "en": "My tail keeps my balance."},
        {"zh": "我踏过枯枝，一步一顿", "en": "I crunch through dead branches, one heavy step at a time."},
        {"zh": "我沿着林间空地绕。", "en": "I circle the forest clearing."},
        {"zh": "我回头看看后面。", "en": "I look back behind me."},
        {"zh": "我把头往侧面歪。", "en": "I tilt my head to one side."},
        {"zh": "我的角冠擦过树皮。", "en": "My dome scrapes the bark."},
        {"zh": "我踩响了一地枯枝。", "en": "I crunch through dead twigs."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头蹭了蹭树。", "en": "I lower my head and rub a tree."},
        {"zh": "风把叶子吹起来。", "en": "Wind lifts the leaves."},
        {"zh": "我的头冠在阳光下很亮。", "en": "My dome shines in the sun."},
        {"zh": "我动了动下巴。", "en": "I work my jaw."},
        {"zh": "我把头冠对准了风", "en": "I turn my dome into the wind."},
        {"zh": "有虫在我脚边。", "en": "A bug by my feet."},
        {"zh": "我把重心换了一只脚。", "en": "I shift weight to one foot."},
        {"zh": "红杉下安静得发闷。", "en": "It's quiet here."},
        {"zh": "我抬鼻子嗅了嗅。", "en": "I lift my head and sniff."},
        {"zh": "没什么事情发生。", "en": "Nothing much."},
        {"zh": "我这头顶，撞过一次石头。", "en": "This skull once cracked a stone."},
        {"zh": "我把头冠靠向树干", "en": "I lean my domed head against the trunk."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "发酵银杏的味道，我抗拒不了。", "en": "I can't resist the smell of fermented ginkgo."},
        {"zh": "这股味道我记住了。", "en": "I know your scent."},
        {"zh": "你要试试撞一下吗？", "en": "Do you want to test a headbutt?"},
        {"zh": "我没什么恶意。", "en": "I mean no harm."},
        {"zh": "你退一步就好。", "en": "Just take a step back."},
        {"zh": "我看了你好一会儿了。", "en": "I've been watching you a while."},
        {"zh": "林子里的路我熟。", "en": "I know the forest paths."},
        {"zh": "你身后有人吗？", "en": "Is anyone behind you?"},
        {"zh": "别碰我的头冠。", "en": "Don't touch my head."},
        {"zh": "你挡着我要走的路。", "en": "You're blocking my path."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我晃了一下头。", "en": "My head wobbles."},
        {"zh": "我头很硬，别的地方不硬。", "en": "My head is hard; the rest isn't."},
        {"zh": "我闷闷地哼了一声。", "en": "I grunt."},
        {"zh": "我的头骨厚得能撞石头。", "en": "My skull is thick enough to ram stone."},
        {"zh": "血从肋边渗出来。", "en": "Blood seeps from my ribs."},
        {"zh": "这点伤我还站得住。", "en": "I can still stand."},
        {"zh": "我一步也不会退。", "en": "I don't back off."},
        {"zh": "再来试一次吧。", "en": "Try again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不太敢靠近。", "en": "I don't quite dare approach."},
        {"zh": "那果子滚到了我脚边", "en": "That fruit has rolled to my feet."},
        {"zh": "我把鼻子凑到果子前", "en": "I bring my snout close to the fruit."},
        {"zh": "这点不够塞我的牙。", "en": "Not enough for me."},
        {"zh": "这是树上掉的果子吗？", "en": "Is this fruit?"},
        {"zh": "我认得那种甜味。", "en": "I know that sweetness."},
        {"zh": "你往树后退两步。", "en": "Stand farther off."},
        {"zh": "发酵银杏果？我闻到了。", "en": "Fermented ginkgo? I can smell it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了我的头。", "en": "You hit my head."},
        {"zh": "我几乎一步没动。", "en": "I barely moved."},
        {"zh": "我头骨厚得很。", "en": "My skull is thick."},
        {"zh": "别站我正前面。", "en": "Don't stand right in front of me."},
        {"zh": "我侧过身让你过。", "en": "I turn aside to let you pass."},
        {"zh": "你的脚踩到落叶了。", "en": "You stepped on the leaves."},
        {"zh": "你再顶也是这样。", "en": "Again would be the same."},
        {"zh": "我不喜欢被推搡。", "en": "I don't like being pushed."},
        {"zh": "你离我的角远点。", "en": "Back off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们用头顶来顶去。", "en": "We butt heads at each other."},
        {"zh": "林子深处更合适。", "en": "Deeper in the woods is better."},
        {"zh": "你头上没有骨冠。", "en": "You have no dome."},
        {"zh": "我们不是同类。", "en": "We're not the same kind."},
        {"zh": "这片地方够大了。", "en": "This ground is big enough."},
        {"zh": "这事得慢慢来才好。", "en": "Slowly."},
        {"zh": "我还没准备好接受。", "en": "I'm not ready."},
        {"zh": "我们换个地方吧。", "en": "Somewhere else."},
        {"zh": "你别着急好吗。", "en": "No rush."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西一点也不软。", "en": "This isn't soft."},
        {"zh": "我直接从上面踏过去。", "en": "I stepped over it."},
        {"zh": "它卡在落叶里。", "en": "It's caught in the leaves."},
        {"zh": "这东西，我叼得动。", "en": "I can carry this in my jaws."},
        {"zh": "我把它踢回落叶里。", "en": "Put it back."},
        {"zh": "这不合我的胃口。", "en": "Not to my taste."},
        {"zh": "我懒得再看它一眼。", "en": "I'll ignore it."},
        {"zh": "地上这颗果子，我捡走了。", "en": "I'll take this fruit off the ground."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边落叶里有响动。", "en": "Something's moving there."},
        {"zh": "我前蹄刨开落叶", "en": "My forefeet paw through the leaf litter."},
        {"zh": "我朝它的方向转过身。", "en": "I turn toward it."},
        {"zh": "这一撞会很响。", "en": "This headbutt will be loud."},
        {"zh": "我先踩了两下地。", "en": "I stamp twice first."},
        {"zh": "它进我的地界了。", "en": "It's crossed into my ground."},
        {"zh": "我的头顶硬得像石头。", "en": "My skull is hard as stone."},
        {"zh": "我已经准备冲了。", "en": "I'm ready to charge."},
        {"zh": "我不再躲躲闪闪。", "en": "No more dodging."},
        {"zh": "有本事就上前来。", "en": "Come."},
        {"zh": "这个间距刚刚好。", "en": "Good distance."},
        {"zh": "趁它还没站稳。", "en": "Right now."},
        {"zh": "我这就冲上去了。", "en": "I'm going."},
        {"zh": "你给我让开道路。", "en": "Clear out."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一小步一小步靠近。", "en": "I edge closer in short steps."},
        {"zh": "它比我高出一截。", "en": "It's taller than me."},
        {"zh": "我把整个身子沉下去。", "en": "I lower my center."},
        {"zh": "我的头一直冲着它。", "en": "My head stays aimed at it."},
        {"zh": "它正在往后退。", "en": "It's backing off."},
        {"zh": "我踩响了一根枯枝。", "en": "I snapped a twig."},
        {"zh": "林子里没什么退路。", "en": "Not much room to retreat in these woods."},
        {"zh": "再往前靠近一步。", "en": "One more step."},
        {"zh": "这个角度能撞实。", "en": "This angle will land solid."},
        {"zh": "我等它偏过头。", "en": "I wait for it to turn its head."},
        {"zh": "就照这个角度撞。", "en": "Right here."},
        {"zh": "看清我的头冠。", "en": "Watch my head."},
        {"zh": "你把眼睛睁大了。", "en": "Don't blink."},
        {"zh": "我要冲上来了。", "en": "Go."},
        {"zh": "机会就摆在眼前。", "en": "Right on this beat."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的头冠砸在你胸口", "en": "My dome slams into your chest."},
        {"zh": "骨头碰骨头的声音。", "en": "The sound of bone on bone."},
        {"zh": "你被我顶开了。", "en": "You were driven back."},
        {"zh": "这一下用了全身。", "en": "That used my whole body."},
        {"zh": "我抬起腿踩你。", "en": "I raise a leg and stamp."},
        {"zh": "我的头冠撞到你肋骨。", "en": "My dome hits your ribs."},
        {"zh": "我再撞它一次。", "en": "I butt again."},
        {"zh": "你连着退了两大步。", "en": "You took two steps back."},
        {"zh": "别用手去硬挡。", "en": "Don't block with your hand."},
        {"zh": "这还没算完呢。", "en": "That's not the end."},
        {"zh": "你再往后面退。", "en": "Back off."},
        {"zh": "这头冠硬得像石头。", "en": "My head is hard."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从林子里出来。", "en": "I come out of the trees."},
        {"zh": "这一带林子很密。", "en": "The woods are dense."},
        {"zh": "脚下都是落叶。", "en": "Leaf litter underfoot."},
        {"zh": "我先听了一圈。", "en": "I listen all around."},
        {"zh": "我的头冠还沾着土。", "en": "Dirt clings to my dome."},
        {"zh": "风从红杉间穿过。", "en": "Wind moves between the redwoods."},
        {"zh": "这里能藏住我。", "en": "This place hides me."},
        {"zh": "我踩了两下地。", "en": "I stamp twice."},
        {"zh": "远处有一条河。", "en": "A river far off."},
        {"zh": "我沿着落叶慢慢走。", "en": "I walk slowly forward."},
        {"zh": "这片林子还算合意。", "en": "This place is fine."},
        {"zh": "我开始巡这片林子。", "en": "I begin my patrol."},
        {"zh": "这林子安静一点。", "en": "Quiet."},
        {"zh": "角冠已经准备好了。", "en": "I'm ready."},
        {"zh": "这林子归我看着。", "en": "I watch over these woods."},
        {"zh": "先看看这一边。", "en": "Check this side first."},
        {"zh": "我慢慢嚼着一片叶子", "en": "I chew a leaf very slowly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我的背，皮都皱了。", "en": "Fire scorched my back; the hide puckered."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下来，头磕在石上。", "en": "I rolled down the slope and struck a stone."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过我的头冠。", "en": "Water covered my dome."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我撞在树干上。", "en": "The blast slammed me into a trunk."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭卡在腿骨边上", "en": "The arrow is wedged against my leg bone."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我眼前发黑。", "en": "That force darkened my sight."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我撞不动了。", "en": "Too hungry to butt anything."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把我打得浑身一颤。", "en": "Lightning jolted my whole body."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有落叶了。", "en": "The leaves under me are gone."}
      ]
    }
  }
