{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀一开一合，飘着走", "en": "Wings open and close. I drift along."},
        {"zh": "翼缘泛着淡淡的绿光", "en": "Pale green light rims my wings."},
        {"zh": "我贴着叶尖飞过", "en": "I skim past the leaf tips."},
        {"zh": "夜里的空气凉得很舒服", "en": "Night air feels cool and fine."},
        {"zh": "翅膀拍得很快，声音很轻", "en": "Fast wingbeats, almost silent."},
        {"zh": "我在树影里拐了个弯", "en": "I bank through a patch of shadow."},
        {"zh": "光从我的翼膜里透出来", "en": "Light shows through my wing membranes."},
        {"zh": "我往上飘了一段", "en": "I rise a little."},
        {"zh": "落在叶上又立刻飞起", "en": "I touch a leaf, then lift off at once."},
        {"zh": "绕着一丛草转了两圈", "en": "I circle a clump of grass twice."},
        {"zh": "身上的光一闪一闪", "en": "My glow pulses on and off."},
        {"zh": "跟着夜里的风走", "en": "I travel with the night wind."},
        {"zh": "我在低处徘徊了一会", "en": "I hover low for a while."},
        {"zh": "又升高，越过灌木", "en": "Then rise, clearing the shrubs."},
        {"zh": "翅膀擦过露水", "en": "My wings brush the dew."},
        {"zh": "夜越深，我越亮", "en": "The deeper the night, the brighter I get."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "停在叶上，翅膀合着", "en": "Resting on a leaf, wings closed."},
        {"zh": "光在叶面上散开", "en": "My light spreads over the leaf."},
        {"zh": "触角轻轻动了一下", "en": "My antennae flick."},
        {"zh": "四周一个人也没有", "en": "No one around at all."},
        {"zh": "我慢慢张开又合上", "en": "I open, then close, slowly."},
        {"zh": "空气里有花的气味", "en": "There's a flower smell in the air."},
        {"zh": "我一动不动地亮着", "en": "I hold still and glow."},
        {"zh": "有飞蛾从我旁边过", "en": "A moth passes by me."},
        {"zh": "我们互相照了一下", "en": "We light each other briefly."},
        {"zh": "然后各自分开", "en": "Then we part."},
        {"zh": "露水从叶尖掉下去", "en": "Dew drops from the leaf tip."},
        {"zh": "我微微张了张翼", "en": "I open my wings a fraction."},
        {"zh": "我停在暗处发着光。", "en": "I rest in the dark, still glowing."},
        {"zh": "夜色把我裹住了", "en": "Night wraps around me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在暗处，我在亮处", "en": "You're in the dark. I'm the light."},
        {"zh": "我飞到你面前停住", "en": "I fly to your face and stop."},
        {"zh": "光落在你的眼睛里", "en": "My glow lands in your eyes."},
        {"zh": "你一直没有动", "en": "You still haven't moved."},
        {"zh": "我不老，也不会熄。", "en": "I don't age, and I don't go out."},
        {"zh": "你还在看着我", "en": "You're still watching."},
        {"zh": "我又转了一圈", "en": "I circle again."},
        {"zh": "你的影子在脚下晃", "en": "Your shadow shifts under you."},
        {"zh": "我往上飘了一点", "en": "I rise a little higher."},
        {"zh": "你的视线跟了上来", "en": "Your gaze follows."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "光闪了几下才稳", "en": "My light flickers before it steadies."},
        {"zh": "我的光缺了一角。", "en": "A corner of my glow is gone."},
        {"zh": "我往下落了半尺", "en": "I drop half a foot."},
        {"zh": "我努力又飞起来", "en": "I struggle back into the air."},
        {"zh": "我夜里的绿光只剩一点。", "en": "Only a trace of my green night light is left."},
        {"zh": "翅膀拍得歪歪扭扭", "en": "My wingbeats go crooked."},
        {"zh": "我停在叶上喘，光还没灭。", "en": "I rest on the leaf, panting; my light is not out."},
        {"zh": "这一点伤不致命", "en": "This much won't kill me."},
        {"zh": "我还会再亮起来", "en": "I'll shine again."},
        {"zh": "等我缓过劲来", "en": "Once I recover."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那股花香浓得很", "en": "That flower scent is strong."},
        {"zh": "我慢慢飘过去了", "en": "I drift over slowly."},
        {"zh": "然后停在花瓣上", "en": "Then settle on the petal."},
        {"zh": "光把花瓣照亮", "en": "My glow lights the petals."},
        {"zh": "我伸出头去吸", "en": "I reach in for nectar."},
        {"zh": "这一朵开得不错", "en": "This one's opened nicely."},
        {"zh": "旁边那朵更好", "en": "The next one's better."},
        {"zh": "我一次只喝一朵", "en": "One flower at a time."},
        {"zh": "这一夜还很长", "en": "The night is still long."},
        {"zh": "夜还长，我不急。", "en": "The night is long; I am in no hurry."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得翻了一圈", "en": "The bump rolls me over once."},
        {"zh": "翅膀很快找回来了", "en": "My wings recover quickly."},
        {"zh": "我的光亮闪了闪", "en": "My light blinks."},
        {"zh": "我飘到旁边去了", "en": "I drift aside."},
        {"zh": "你太高了，看不见我", "en": "You're too tall to notice me."},
        {"zh": "露水把我打湿了一点", "en": "Dew has dampened me a little."},
        {"zh": "我的光亮闪了闪。", "en": "My glow flickers."},
        {"zh": "光又稳了下来", "en": "The glow steadies."},
        {"zh": "这点不算一回事", "en": "That hardly counts."},
        {"zh": "我继续往前飞", "en": "I fly on."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "一点光靠近另一点光", "en": "One point of light nears another."},
        {"zh": "我们在空中绕成圈", "en": "We spiral around each other."},
        {"zh": "两片翼膜碰在一起", "en": "Our wing membranes touch."},
        {"zh": "然后分开，又靠近", "en": "We part, then come together."},
        {"zh": "我把光调到最亮", "en": "I set my glow to its brightest."},
        {"zh": "她也跟着亮起来", "en": "And she brightens too."},
        {"zh": "我们落在同一片叶上", "en": "We land on the same leaf."},
        {"zh": "叶上会留下卵", "en": "Eggs will be left on the leaf."},
        {"zh": "卵在叶背，很安全", "en": "On the underside. Safe there."},
        {"zh": "等它们自己长", "en": "They'll grow on their own."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘下来看了看", "en": "I flutter down to look."},
        {"zh": "太重了，我抬不动", "en": "Too heavy. I can't lift it."},
        {"zh": "我用前足碰了碰", "en": "I touch it with a foreleg."},
        {"zh": "这根本不是花蜜", "en": "This isn't nectar at all."},
        {"zh": "我又飞回花上", "en": "I fly back to the flowers."},
        {"zh": "花在那边更香", "en": "The flowers are sweeter over there."},
        {"zh": "这个留给别人吧", "en": "Leave this for someone else."},
        {"zh": "我没什么可带的", "en": "I have nothing to carry."},
        {"zh": "翅膀比手有用", "en": "Wings are more use than hands."},
        {"zh": "我从旁边绕过去", "en": "I go around it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有什么在靠近", "en": "Something is coming near."},
        {"zh": "我飞到更高的枝上", "en": "I fly to a higher branch."},
        {"zh": "光收暗了一些", "en": "I dim my glow."},
        {"zh": "你在下面找着我", "en": "You're searching below."},
        {"zh": "我就停在这上面", "en": "I'm right up here."},
        {"zh": "我慢慢往暗处挪", "en": "I shift slowly into the dark."},
        {"zh": "翅膀几乎不出声", "en": "My wings are nearly silent."},
        {"zh": "你最后抬起头", "en": "You raised your head at last."},
        {"zh": "我停住一动不动", "en": "I hold completely still."},
        {"zh": "我把光收了起来", "en": "I pull my glow in."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在树上看着你", "en": "I watch you from the tree."},
        {"zh": "你原地转了一圈", "en": "You turn a full circle."},
        {"zh": "我就跟着你转", "en": "I turn with you."},
        {"zh": "你在原地停下", "en": "You stop."},
        {"zh": "我也跟着停下", "en": "So do I."},
        {"zh": "风把我的气味吹散了", "en": "Wind scatters my scent."},
        {"zh": "你根本找不到我", "en": "You can't find me."},
        {"zh": "我又亮了一下", "en": "I flash once."},
        {"zh": "你朝后面回头", "en": "You look back."},
        {"zh": "那边什么都没有", "en": "Nothing's there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我只能撞一下", "en": "All I can do is bump into you."},
        {"zh": "翅膀扫过你的脸", "en": "My wings brush your face."},
        {"zh": "你挥手，我躲开了", "en": "You swipe and I dodge."},
        {"zh": "我可真是太小", "en": "I'm really so small."},
        {"zh": "这一下没有分量", "en": "There's no weight behind it."},
        {"zh": "我的光晃到你眼睛。", "en": "My light flashed in your eyes."},
        {"zh": "这就是我唯一的招", "en": "That's my only trick."},
        {"zh": "就趁现在走开", "en": "Leaving right now."},
        {"zh": "我飞到树后面", "en": "I fly behind the tree."},
        {"zh": "你是找不到我了", "en": "You won't find me."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "夜里亮起一点光", "en": "A point of light appears in the night."},
        {"zh": "翅膀在暗里展开", "en": "My wings open in the dark."},
        {"zh": "我慢慢飞起来", "en": "I lift off slowly."},
        {"zh": "周围都是黑的", "en": "Everything around is black."},
        {"zh": "我成了唯一的光", "en": "I'm the only light."},
        {"zh": "有飞蛾朝我飞来", "en": "A moth comes toward me."},
        {"zh": "这地方比我大得多。", "en": "This place is far bigger than I am."},
        {"zh": "我从一边绕开", "en": "I veer away."},
        {"zh": "这片林子里有花", "en": "There are flowers in this wood."},
        {"zh": "我要先去找花", "en": "I'll look for flowers first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热气把我的翼膜烤卷了", "en": "Heat curls my wing membrane."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落在草上，没摔坏", "en": "I land in the grass, unbroken."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "湿的翅膀飞不动", "en": "Wet wings won't lift me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我甩出去很远", "en": "The blast flings me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西擦破了我的翼缘", "en": "Something tore the edge of my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光被压得只剩一点", "en": "My light is pressed down to a spark."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "很久没喝到花蜜", "en": "No nectar in a long while."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光比我亮得多", "en": "Lightning is so much brighter than me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "四周突然什么都没有", "en": "Everything around me is suddenly nothing."}
      ]
    }
  }
}
