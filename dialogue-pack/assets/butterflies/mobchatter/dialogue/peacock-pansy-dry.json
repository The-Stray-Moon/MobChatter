{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在干草上飞。", "en": "I fly over the dry grass."},
        {"zh": "这片平原，太阳很足。", "en": "This plain gets plenty of sun."},
        {"zh": "我掠过稀树草原。", "en": "I skim the savanna."},
        {"zh": "风把草压向一边。", "en": "The wind presses the grass to one side."},
        {"zh": "我飞得不快不慢。", "en": "I fly at a middling pace."},
        {"zh": "我的翅膀在光下发亮。", "en": "My wings shine in the light."},
        {"zh": "我在花间穿过。", "en": "I pass between the flowers."},
        {"zh": "我落一下，又起来。", "en": "I dip down, then rise."},
        {"zh": "这里的土是黄的。", "en": "The soil here is yellow."},
        {"zh": "我顺着气流滑了一段。", "en": "I glide on the air a stretch."},
        {"zh": "草很高，我飞在上头。", "en": "The grass is tall; I fly above it."},
        {"zh": "我在找水源。", "en": "I am looking for water."},
        {"zh": "我绕过一棵孤树。", "en": "I circle a lone tree."},
        {"zh": "我飞得比影子还轻。", "en": "I fly lighter than my shadow."},
        {"zh": "这一片花不多。", "en": "There are not many flowers here."},
        {"zh": "我沿着花带飞。", "en": "I follow the line of blooms."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在一根草茎上。", "en": "I rest on a grass stem."},
        {"zh": "太阳晒着我的翅。", "en": "The sun warms my wings."},
        {"zh": "我开合了两次。", "en": "I open and close them twice."},
        {"zh": "这里的花要授粉。", "en": "The flowers here need pollinating."},
        {"zh": "风把我的翅吹歪。", "en": "The wind tilts my wings."},
        {"zh": "我晒着背上的眼斑。", "en": "I bask the eyespots on my back."},
        {"zh": "远处有尘土扬起。", "en": "Dust is rising in the distance."},
        {"zh": "我的触角碰到了草籽。", "en": "My antennae touch the grass seed."},
        {"zh": "这一朵快干了。", "en": "This bloom is nearly dry."},
        {"zh": "我不喜欢雨天。", "en": "I do not like rainy days."},
        {"zh": "光一动，我就醒。", "en": "When the light shifts, I wake."},
        {"zh": "我等着下一阵风。", "en": "I wait for the next gust."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在草里站着。", "en": "You are standing in the grass."},
        {"zh": "我飞到你手边。", "en": "I fly to your hand."},
        {"zh": "你别动。", "en": "Do not move."},
        {"zh": "让一让，太阳被你挡了。", "en": "Move aside, you are blocking the sun."},
        {"zh": "我在你头顶绕出个圆。", "en": "I circle a ring above your head."},
        {"zh": "你身上有土味。", "en": "You smell of earth."},
        {"zh": "这里怎么会有你。", "en": "What brings you here?"},
        {"zh": "你站着别动，我看清花纹。", "en": "Stand still so I can read your markings."},
        {"zh": "你的影子盖住了我的太阳。", "en": "Your shadow covers my sun."},
        {"zh": "我要飞了。", "en": "I am about to fly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉进草里。", "en": "I fall into the grass."},
        {"zh": "翅上破了一点。", "en": "A small tear in my wing."},
        {"zh": "左边翅膀比右边慢了半拍。", "en": "My left wing lags half a beat."},
        {"zh": "翅膀缺一块，还能扇。", "en": "A chipped wing can still beat."},
        {"zh": "我抖掉翅粉。", "en": "I shake off the dust."},
        {"zh": "谁碰到我的翅尖了？", "en": "Who touched my wingtip?"},
        {"zh": "干季的翅膀，颜色都淡了。", "en": "In the dry season my wings have faded."},
        {"zh": "还能起来。", "en": "Still able to rise."},
        {"zh": "我离地只有一指高。", "en": "I fly one finger above the ground."},
        {"zh": "翅膀歪了，我调一调。", "en": "My wing is crooked; let me trim it."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那朵花，是兰花吗。", "en": "Is that flower an orchid?"},
        {"zh": "干草上的风，把甜味推给我。", "en": "The wind off the dry grass carries sweetness."},
        {"zh": "你举高点。", "en": "Lift it higher."},
        {"zh": "我落上去了。", "en": "I have landed on it."},
        {"zh": "这一朵太小。", "en": "This bloom is too small."},
        {"zh": "我在授粉，你看。", "en": "I am pollinating, see?"},
        {"zh": "我腿上已经裹满花粉。", "en": "My legs are already caked in pollen."},
        {"zh": "下一朵在哪。", "en": "Where is the next one?"},
        {"zh": "你手上的蜜味引着我。", "en": "The nectar smell on your hand pulls me."},
        {"zh": "别摘它。", "en": "Do not pick it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的帽檐蹭掉我一点鳞粉。", "en": "Your hat brim scraped off some of my wing dust."},
        {"zh": "我歪了半圈。", "en": "I veered half a turn."},
        {"zh": "翅粉掉了一点。", "en": "A little wing dust fell."},
        {"zh": "我从草里抖抖翅膀再飞。", "en": "I shake my wings and rise from the grass."},
        {"zh": "草杆弹了一下。", "en": "The grass stem springs back."},
        {"zh": "差一点我就落地。", "en": "I nearly went down."},
        {"zh": "别在花前面站。", "en": "Do not stand in front of the flowers."},
        {"zh": "这点风，我受得住。", "en": "I can take that much wind."},
        {"zh": "借过，风从你背后吹来。", "en": "Let me pass, the wind comes from behind you."},
        {"zh": "我绕着走了。", "en": "I will go around."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们绕着同一丛花。", "en": "We circle the same clump of flowers."},
        {"zh": "它的翅色更深。", "en": "Its wings are darker."},
        {"zh": "我们一上一下。", "en": "One above, one below."},
        {"zh": "翅粉在阳光里飞。", "en": "Our dust drifts in the sunlight."},
        {"zh": "这一片够我们。", "en": "This patch is enough for us."},
        {"zh": "我们一同落在花瓣上。", "en": "We land on the petal together."},
        {"zh": "花被压得低了一点。", "en": "The flower bends a little."},
        {"zh": "太阳偏西了。", "en": "The sun has gone west."},
        {"zh": "旱季的翅，颜色淡了一层。", "en": "Dry season pales my wings a shade."},
        {"zh": "花期不长。", "en": "The blooming does not last."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "那是花瓣吗。", "en": "Is that a petal?"},
        {"zh": "我用脚抓着。", "en": "I hold it with my feet."},
        {"zh": "太重了，带不动。", "en": "Too heavy to carry."},
        {"zh": "我放下它。", "en": "I set it down."},
        {"zh": "兰花才是我的，别递别的。", "en": "Orchids are mine; offer nothing else."},
        {"zh": "它黏在我的脚上。", "en": "It sticks to my feet."},
        {"zh": "我把它扔进花里。", "en": "I drop it into the flowers."},
        {"zh": "干季的颜色，淡得像旧纸。", "en": "Dry-season colours, faint as old paper."},
        {"zh": "我带到下一朵去。", "en": "I will carry it to the next bloom."},
        {"zh": "那颗种子不是花蜜。", "en": "That seed is no nectar."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那朵花开了。", "en": "That flower has opened."},
        {"zh": "我看见了，那朵兰花在平原边。", "en": "I see it, that orchid at the plain's edge."},
        {"zh": "风把香气送过来。", "en": "The wind brings the scent."},
        {"zh": "就那边。", "en": "Over there."},
        {"zh": "那朵兰花在风里点头。", "en": "That orchid nods in the wind."},
        {"zh": "这点距离。", "en": "No distance at all."},
        {"zh": "我贴着枯草梢滑过去。", "en": "I skim along the dry grass tips."},
        {"zh": "它正好在阳光里。", "en": "It is right in the sun."},
        {"zh": "好地方。", "en": "Good spot."},
        {"zh": "去了。", "en": "Going."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠近了。", "en": "I am closing in."},
        {"zh": "花瓣在动。", "en": "The petals are moving."},
        {"zh": "旱季的我，颜色淡了一层。", "en": "In the dry season my colors fade a shade."},
        {"zh": "我调整角度。", "en": "I adjust my angle."},
        {"zh": "再低一点。", "en": "A little lower."},
        {"zh": "脚要碰到了。", "en": "My feet are nearly touching."},
        {"zh": "那片旱草就在前面。", "en": "That patch of dry grass is just ahead."},
        {"zh": "干季的我，翅色淡了。", "en": "In the dry season my wings fade."},
        {"zh": "落下了，翅还没合拢。", "en": "Down I land, wings still open."},
        {"zh": "停稳了。", "en": "Steady."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用翅缘拍它的头。", "en": "I slap its head with my wing edge."},
        {"zh": "它没动。", "en": "It did not move."},
        {"zh": "我的翅拍在草上。", "en": "My wing beats against the grass."},
        {"zh": "我被弹开了。", "en": "I am bounced away."},
        {"zh": "这点力气，只够飞。", "en": "My strength is only enough for flying."},
        {"zh": "我绕开它。", "en": "I go around it."},
        {"zh": "我打不过。", "en": "I cannot win this."},
        {"zh": "那就算了。", "en": "Then let it go."},
        {"zh": "我回去了。", "en": "I am going back."},
        {"zh": "花还在。", "en": "The flower remains."}
      ]
    },
