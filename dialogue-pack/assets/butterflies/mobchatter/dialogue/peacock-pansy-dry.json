        {"zh": "草很高，花不多。", "en": "Tall grass, few flowers."},
        {"zh": "旱季的兰花，我先去闻闻。", "en": "Dry-season orchids, I go sniff them first."},
        {"zh": "风推着我走。", "en": "The wind pushes me along."},
        {"zh": "这片地干得厉害。", "en": "This ground is very dry."},
        {"zh": "我闻到了兰花的味。", "en": "I smell orchids."},
        {"zh": "我落在一根草上。", "en": "I land on a grass stem."},
        {"zh": "远处有树。", "en": "There are trees far off."},
        {"zh": "我从干草叶上起飞。", "en": "I lift off from a dry blade of grass."}
      ]
    },
