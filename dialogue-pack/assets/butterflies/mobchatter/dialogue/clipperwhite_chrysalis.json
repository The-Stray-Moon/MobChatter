{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶尖，白得像一小片云。", "en": "I hang from the leaf tip, white as a scrap of cloud."},
        {"zh": "藤蔓晃，我就跟着晃。", "en": "The vine sways; I sway with it."},
        {"zh": "我没有能动的地方。", "en": "There is no part of me that can move."},
        {"zh": "露水把我整枚打湿。", "en": "Dew soaks me through."},
        {"zh": "太阳出来，我又慢慢干。", "en": "The sun comes out and I dry slowly."},
        {"zh": "白色的壳在光里几乎透明。", "en": "The white shell is nearly clear in the light."},
        {"zh": "能看见里面蜷着的东西。", "en": "You can see the curled thing inside."},
        {"zh": "我把它遮住。", "en": "I keep it covered."},
        {"zh": "叶子边缘有虫咬的缺口。", "en": "The leaf's edge has insect bites."},
        {"zh": "我从那个缺口看出去。", "en": "I look out through the gap."},
        {"zh": "下面有一条小径。", "en": "There is a small path below."},
        {"zh": "有人从那儿走过去。", "en": "Someone walks along it."},
        {"zh": "风把叶尖抬高了一点。", "en": "Wind lifts the leaf tip a little."},
        {"zh": "我也被抬高。", "en": "And I with it."},
        {"zh": "又落回去。", "en": "Then it settles back."},
        {"zh": "我们就这样过一天。", "en": "So we pass a day."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我一动不动，白色在绿里很安静。", "en": "I hold still; the white is quiet among green."},
        {"zh": "壳的表面很薄。", "en": "My shell's surface is very thin."},
        {"zh": "光从里面透出来。", "en": "Light shows through it."},
        {"zh": "有一层淡淡的纹。", "en": "A faint pattern runs over it."},
        {"zh": "我看不到它。", "en": "I cannot see it."},
        {"zh": "但别人看得到。", "en": "But others can."},
        {"zh": "一只鸟落在枝上。", "en": "A bird lands on the branch."},
        {"zh": "枝子沉了一下。", "en": "The branch dips."},
        {"zh": "它歪头看我。", "en": "It tilts its head at me."},
        {"zh": "藤蔓一晃，我就跟着晃。", "en": "When the vine sways, I sway with it."},
        {"zh": "它啄了一下旁边的叶子。", "en": "It pecks the leaf beside me."},
        {"zh": "然后飞走了。", "en": "Then flies off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的脸从下面凑上来。", "en": "Your face comes up from below."},
        {"zh": "我白得有点晃眼吧。", "en": "I must be a little dazzling white."},
        {"zh": "你没有碰我。", "en": "You do not touch me."},
        {"zh": "你就这样看，我受得住。", "en": "Keep looking; I can bear it."},
        {"zh": "你就这样看了一会。", "en": "You simply look for a while."},
        {"zh": "我从壳缝里看着你。", "en": "I watch you through the seam of my shell."},
        {"zh": "虽然我没有眼睛。", "en": "Though I have no eyes."},
        {"zh": "你的影子挡住阳光。", "en": "Your shadow blocks the sun."},
        {"zh": "壳里暗下来。", "en": "It darkens inside my shell."},
        {"zh": "你往旁边挪了一点。", "en": "You shift slightly aside."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "白壳凹了一小块。", "en": "A small dent in the white shell."},
        {"zh": "我被打得直晃。", "en": "The blow sets me swinging."},
        {"zh": "里面的东西缩起来。", "en": "What is inside shrinks."},
        {"zh": "壳上多了一条细线。", "en": "A fine line appears."},
        {"zh": "我疼得发紧。", "en": "I tighten with the pain."},
        {"zh": "一会儿才松开。", "en": "Only later do I loosen."},
        {"zh": "阳光照过来，白还是白的。", "en": "Sunlight returns, and white is still white."},
        {"zh": "壳上的白痕慢慢淡了。", "en": "The white mark on my shell slowly fades."},
        {"zh": "叶子还在。", "en": "The leaf holds."},
        {"zh": "我也在。", "en": "So do I."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我连吸管都没有。", "en": "I don't even have a proboscis."},
        {"zh": "白色的壳里只有水。", "en": "There is only water in the white shell."},
        {"zh": "你把花举过来。", "en": "You hold a flower near."},
        {"zh": "很香，我闻不到。", "en": "Fragrant, and I cannot smell it."},
        {"zh": "我没有鼻子。", "en": "I have no nose."},
        {"zh": "举着花，你的胳膊会酸。", "en": "Hold that flower long enough and your arm will ache."},
        {"zh": "我什么也没表示。", "en": "I give no sign."},
        {"zh": "你终于放下了。", "en": "At last you lower it."},
        {"zh": "花留在枝上。", "en": "The flower stays on the branch."},
        {"zh": "比我好看。", "en": "Prettier than I am."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你从我身边经过，衣袖蹭到叶子。", "en": "You pass and your sleeve brushes the leaf."},
        {"zh": "我整片翻了个面。", "en": "I flip right over."},
        {"zh": "白色的里面朝着光。", "en": "My white inside faces the light."},
        {"zh": "丝线扭在一起。", "en": "The silk twists together."},
        {"zh": "我又慢慢转回去。", "en": "Slowly I turn back."},
        {"zh": "你在下面等我停稳。", "en": "You wait below for me to settle."},
        {"zh": "叶柄弹了一下，我稳住。", "en": "The stalk springs; I hold."},
        {"zh": "你才走。", "en": "Only then do you go."},
        {"zh": "叶子还在轻轻晃。", "en": "The leaf still sways."},
        {"zh": "我也在晃。", "en": "So do I."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还是一枚壳。", "en": "I am still a shell."},
        {"zh": "白色的翅膀还卷着。", "en": "White wings still rolled up."},
        {"zh": "这些事轮不到我说。", "en": "That is not for me to speak of."},
        {"zh": "外面偶尔有白影飞过。", "en": "Now and then a white shape flies past."},
        {"zh": "很快，很轻。", "en": "Fast, and light."},
        {"zh": "我想那也许是同类。", "en": "I think perhaps it is my kind."},
        {"zh": "也许不是。", "en": "Perhaps not."},
        {"zh": "我看不清。", "en": "I cannot see clearly."},
        {"zh": "等壳变薄，我才出去。", "en": "I wait for the shell to thin."},
        {"zh": "壳里越来越挤。", "en": "My shell grows crowded."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "有人连叶带枝一起剪下。", "en": "Someone cuts leaf and stem together."},
        {"zh": "我在半空晃了很久。", "en": "I sway in the air a long while."},
        {"zh": "白色的壳被光照得发亮。", "en": "The white shell shines in the light."},
        {"zh": "我被放进一个木盒。", "en": "I am put in a wooden box."},
        {"zh": "盒里有别的东西。", "en": "There is something else in it."},
        {"zh": "硬的，凉的。", "en": "Hard, and cold."},
        {"zh": "我贴着它。", "en": "I rest against it."},
        {"zh": "我挂在叶背，一丝风也没有。", "en": "I hang under the leaf; not a breath of wind."},
        {"zh": "反而不习惯。", "en": "I am unused to it."},
        {"zh": "我等着盒子打开。", "en": "I wait for the box to open."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有什么东西发现了我。", "en": "Something has found me."},
        {"zh": "白色的壳在暗处很显眼。", "en": "A white shell shows clearly in shadow."},
        {"zh": "我尽量不反光。", "en": "I try not to catch the light."},
        {"zh": "但那做不到。", "en": "But that cannot be done."},
        {"zh": "它凑近了。", "en": "It comes close."},
        {"zh": "我亮得无处可藏，它来了。", "en": "I'm too bright to hide; it comes closer."},
        {"zh": "很慢，很沉。", "en": "Slow, and heavy."},
        {"zh": "它只是把影子投过来。", "en": "It only casts its shadow over me."},
        {"zh": "只是看。", "en": "Only looks."},
        {"zh": "看够了就走了。", "en": "When it has looked enough, it leaves."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它还在附近转。", "en": "It still circles nearby."},
        {"zh": "我感觉得到那股热气。", "en": "I feel that heat."},
        {"zh": "壳里越来越闷。", "en": "My shell grows stifling."},
        {"zh": "我想动，动不了。", "en": "I want to move, and cannot."},
        {"zh": "外面的风一阵一阵。", "en": "The wind comes in gusts."},
        {"zh": "它终于走远了。", "en": "At last it moves away."},
        {"zh": "我松了一口气。", "en": "I let out a breath."},
        {"zh": "壳里的东西也松了。", "en": "The thing inside relaxes too."},
        {"zh": "我们又安静下来。", "en": "We are quiet again."},
        {"zh": "像什么都没发生。", "en": "As if nothing happened."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞在它身上。", "en": "I strike against it."},
        {"zh": "白色的壳很硬。", "en": "The white shell is hard."},
        {"zh": "我荡过去，它偏头躲开。", "en": "I swing; it ducks aside."},
        {"zh": "我从叶上荡过去，又荡回来。", "en": "I swing across and back."},
        {"zh": "丝线在它脸上扫过。", "en": "The silk sweeps its face."},
        {"zh": "它挥手拨开。", "en": "It swats it away."},
        {"zh": "我被拨得转了好几圈。", "en": "I am sent spinning."},
        {"zh": "停下来的时候，我还挂着。", "en": "When I stop, I am still hanging."},
        {"zh": "壳上多了一个指印。", "en": "A fingerprint marks my shell."},
        {"zh": "很快就淡了。", "en": "It fades quickly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "叶尖上多了一点白。", "en": "A spot of white on the leaf tip."},
        {"zh": "那是前一只毛虫留下的。", "en": "The last caterpillar left it."},
        {"zh": "它选了这个最外沿的位置。", "en": "It chose this outermost spot."},
        {"zh": "风最大，光也最强。", "en": "Most wind, most light."},
        {"zh": "白色在太阳下几乎看不见。", "en": "In the sun, white is nearly invisible."},
        {"zh": "这大概就是它选这里的理由。", "en": "That is likely why it chose here."},
        {"zh": "我吊在叶尖下面。", "en": "I hang beneath the tip."},
        {"zh": "露水从上面滴下来。", "en": "Dew drips from above."},
        {"zh": "落在我的壳上。", "en": "It falls on my shell."},
        {"zh": "里面那团东西动了一下。", "en": "The thing inside shifts once."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火让白壳边上卷起褐色。", "en": "Fire curls the white edge brown."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶尖掉下来，壳碎了。", "en": "I fall from the tip and the shell breaks."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我泡得透明，我开始下沉。", "en": "Water makes me clear; I start to sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我从枝上打落。", "en": "The blast knocks me off the branch."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿过了叶子，擦到我。", "en": "It pierces the leaf and grazes me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "白壳上浮出一片灰色的纹。", "en": "A grey pattern surfaces on the white."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这个阶段我不用吃。", "en": "At this stage I need not eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让白壳亮得像一片雪。", "en": "Lightning makes the white blaze like snow."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑里没有白，也没有我。", "en": "In the black there is no white, and no me."}
      ]
    }
  }
}
