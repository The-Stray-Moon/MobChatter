{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶背，晃着走不了", "en": "I hang beneath a leaf. I can't walk."},
        {"zh": "风一吹，我就摆一下", "en": "A gust comes and I sway."},
        {"zh": "丝线吊着我，绷得很紧", "en": "One silk thread holds me taut."},
        {"zh": "我只会转，不会迈步", "en": "I can turn in place. I can't step."},
        {"zh": "叶脉在我头顶分叉", "en": "A leaf vein forks above me."},
        {"zh": "我随着枝子轻轻荡", "en": "I swing gently with the twig."},
        {"zh": "壳里的身体在慢慢动", "en": "Inside my shell, something slowly shifts."},
        {"zh": "我试着蹬了一下，没动", "en": "I push once. Nothing happens."},
        {"zh": "这片叶子就是我的路", "en": "This leaf is the whole of my road."},
        {"zh": "雨水从叶尖滑下去", "en": "Rainwater slides off the leaf tip."},
        {"zh": "我把丝线又拉紧些", "en": "I pull my silk a little tighter."},
        {"zh": "我在叶背上吊着，谁也别碰。", "en": "Hung under the leaf — no one touch me."},
        {"zh": "阳光把壳晒得发亮", "en": "Sun makes my shell shine."},
        {"zh": "我贴着叶面转了半圈", "en": "I rotate half a turn against the leaf."},
        {"zh": "枝子在晃，我跟着", "en": "The branch sways. I go with it."},
        {"zh": "要走，也得等长出来", "en": "To walk, I must first grow the legs."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "一动不动，像颗小果子", "en": "Perfectly still, like a little fruit."},
        {"zh": "壳上有一层细纹", "en": "Fine ridges run across my shell."},
        {"zh": "里面的东西在翻身", "en": "Something inside turns over."},
        {"zh": "我的壳有点硬了", "en": "My shell has hardened a little."},
        {"zh": "叶背的阴凉正好。", "en": "The shade under the leaf is just right."},
        {"zh": "有只蚂蚁爬过旁边", "en": "An ant crawls past beside me."},
        {"zh": "它根本没有认出我", "en": "It doesn't recognize me."},
        {"zh": "我把身体压得更贴", "en": "I press myself flatter."},
        {"zh": "等的时候很长", "en": "The waiting is long."},
        {"zh": "壳里的翅膀还没展开", "en": "My wings aren't unfolded yet."},
        {"zh": "我能感觉到光在变", "en": "I can feel the light changing."},
        {"zh": "天色快要暗下来了", "en": "It's getting dark."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "有人凑近看这片叶子", "en": "Someone leans in to look at this leaf."},
        {"zh": "我看得见你，你未必看见我", "en": "I see you. You may not see me."},
        {"zh": "我只轻轻动了一下", "en": "I twitch just once."},
        {"zh": "你退后了半步", "en": "You pull back half a step."},
        {"zh": "我只是一只蛹", "en": "I'm only a chrysalis."},
        {"zh": "别捏我，很脆", "en": "Don't pinch me. I'm fragile."},
        {"zh": "我靠这根丝挂着", "en": "I hang by this one thread."},
        {"zh": "你挡了我的风", "en": "You're blocking my breeze."},
        {"zh": "我慢慢转了转身", "en": "I rotate slowly in place."},
        {"zh": "你居然还是没走", "en": "You're still here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳上多了一道细纹", "en": "A hairline appears on my shell."},
        {"zh": "叶柄被我晃得直响。", "en": "The leaf stem rattles as I sway."},
        {"zh": "丝线绷得吱吱响", "en": "The silk creaks with tension."},
        {"zh": "里面的身体缩紧了", "en": "My body clenches inside."},
        {"zh": "还好并没有破", "en": "It didn't break."},
        {"zh": "这一下差点把我打下去", "en": "That nearly knocked me loose."},
        {"zh": "我挂在叶边，勉强稳住", "en": "I hang from the leaf edge, barely steady."},
        {"zh": "壳变薄了一点", "en": "My shell feels thinner."},
        {"zh": "我还得撑到羽化", "en": "I must last until I emerge."},
        {"zh": "千万别再来一次", "en": "Not again, please."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里是叶子吗", "en": "Is that a leaf in your hand?"},
        {"zh": "我这个阶段不吃东西", "en": "I don't eat at this stage."},
        {"zh": "这个阶段我什么也不吃", "en": "At this stage I eat nothing at all."},
        {"zh": "叶子只是挂的地方", "en": "A leaf is only somewhere to hang."},
        {"zh": "你把叶子凑近也没用", "en": "Holding a leaf close won't help."},
        {"zh": "我在等壳裂开", "en": "I'm waiting for the shell to split."},
        {"zh": "那之后我才有嘴", "en": "Only then will I have a mouth."},
        {"zh": "现在只有等待", "en": "Right now, only waiting."},
        {"zh": "你把叶子放回去吧", "en": "Put the leaf back."},
        {"zh": "我不会跟着走的", "en": "I won't follow you anywhere."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子被碰得弹了一下", "en": "The leaf bounces from the touch."},
        {"zh": "我跟着晃了半天", "en": "I sway for a long while after."},
        {"zh": "丝线差点断了", "en": "That nearly broke my thread."},
        {"zh": "我把身体缩紧了一寸。", "en": "I pull myself in an inch."},
        {"zh": "别碰这片叶子", "en": "Don't touch this leaf."},
        {"zh": "我掉下去就完了", "en": "If I fall, it's over."},
        {"zh": "你把叶柄扶稳了", "en": "You steady the stem."},
        {"zh": "谢谢，这样好多了", "en": "Thank you. That's better."},
        {"zh": "我又重新挂正了", "en": "I'm hanging straight again."},
        {"zh": "壳还是完好的", "en": "The shell is still whole."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这一阶段没有那种事", "en": "Not at this stage."},
        {"zh": "我只等着羽化", "en": "I only wait to emerge."},
        {"zh": "等到翅膀干了", "en": "When my wings have dried."},
        {"zh": "那时才会去找同类", "en": "Then I'll go looking for my kind."},
        {"zh": "森林、平原、湿地", "en": "Forest, plain, wetland."},
        {"zh": "那些地方有我的同伴", "en": "My kin are in those places."},
        {"zh": "现在我只是个壳", "en": "For now I'm only a shell."},
        {"zh": "壳里什么都在长", "en": "Everything inside is still growing."},
        {"zh": "翅膀也包括在内", "en": "Wings included."},
        {"zh": "只要等着就好", "en": "Waiting is enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抓不住任何东西", "en": "I can't hold anything."},
        {"zh": "我连爪都没有，捡不了。", "en": "I have no claws to pick it up."},
        {"zh": "东西落在叶上，我够不到", "en": "It lands on the leaf, out of reach."},
        {"zh": "我连转个身都费劲", "en": "Even turning around is an effort."},
        {"zh": "只能等它自己滑下去", "en": "I can only wait for it to slide off."},
        {"zh": "或者等着下雨", "en": "Or for rain."},
        {"zh": "叶面实在有点滑", "en": "The leaf surface is slick."},
        {"zh": "它走了，我还在", "en": "It's gone. I'm still here."},
        {"zh": "这不关我的事", "en": "None of my concern."},
        {"zh": "我继续这样挂着", "en": "I keep hanging."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有什么靠近了叶子", "en": "Something has come near the leaf."},
        {"zh": "我绷紧了丝线", "en": "I draw my thread tight."},
        {"zh": "壳里的身体缩起来", "en": "My body pulls in."},
        {"zh": "我根本没法逃", "en": "I can't flee."},
        {"zh": "只能一动不动", "en": "Only stay still."},
        {"zh": "装成一颗小果子", "en": "Like a little fruit."},
        {"zh": "你也许就看不出来", "en": "Maybe then you won't notice me."},
        {"zh": "我把颜色收暗", "en": "I darken my color."},
        {"zh": "风停了，很不利", "en": "The wind dies. That's bad."},
        {"zh": "没有风，我就不会晃", "en": "Without wind I don't sway."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你还没有走远", "en": "You haven't gone far."},
        {"zh": "我感觉得到影子", "en": "I can feel the shadow."},
        {"zh": "我慢慢侧转过去", "en": "I rotate slowly away."},
        {"zh": "壳紧紧贴着叶面", "en": "My shell hugs the leaf."},
        {"zh": "雨点打在我旁边", "en": "Raindrops strike beside me."},
        {"zh": "我借那点动静遮掩", "en": "I use that noise as cover."},
        {"zh": "你没再看这边", "en": "You've stopped looking this way."},
        {"zh": "我再等上一会", "en": "A little longer."},
        {"zh": "一直等到你走开", "en": "Until you leave."},
        {"zh": "那我才算安全", "en": "Then I'm safe."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我根本无能为力", "en": "I'm utterly helpless."},
        {"zh": "我没有牙，没有爪", "en": "No teeth. No claws."},
        {"zh": "我只能贴着叶子挨着。", "en": "I can only cling and take it."},
        {"zh": "壳被压得响了一声", "en": "My shell creaks under the pressure."},
        {"zh": "还好并没有裂", "en": "It held."},
        {"zh": "我缩到了最小", "en": "I shrink as small as I can."},
        {"zh": "丝线还在撑着", "en": "The thread still holds."},
        {"zh": "这就是我的全部抵抗", "en": "This is the whole of my defense."},
        {"zh": "千万别再来一下", "en": "Don't do that again."},
        {"zh": "我还得等着羽化", "en": "I still have to emerge."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子背面多了一个小东西", "en": "Something small appears under a leaf."},
        {"zh": "丝线先挂好，壳才成形", "en": "The silk goes up first, then the shell."},
        {"zh": "我慢慢定住了", "en": "I settle into place."},
        {"zh": "风把我吹得转了一圈", "en": "Wind turns me a full circle."},
        {"zh": "森林的叶子最合我意", "en": "Forest leaves suit me best."},
        {"zh": "平原的叶子也行", "en": "Plains leaves will do too."},
        {"zh": "湿地我也待过", "en": "I've hung in wetlands as well."},
        {"zh": "这个位置不错", "en": "This spot is good."},
        {"zh": "背风，又有光", "en": "Sheltered, and still lit."},
        {"zh": "我挂得稳稳的", "en": "I'm secure."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热气让壳发皱", "en": "The heat puckers my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了下来，幸好落在草上", "en": "I fall, and luckily land in grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浸透了壳，很重", "en": "Water soaks my shell. It's heavy."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把叶子整个掀翻", "en": "The blast flips the whole leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西擦着壳过去了", "en": "Something grazes past my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "壳里的东西乱撞", "en": "Something thrashes inside my shell."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这个阶段不会饿死", "en": "At this stage I can't starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光透过叶子照进来", "en": "Lightning light bleeds through the leaf."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面的叶子没有了", "en": "The leaf below is gone."}
      ]
    }
  }
}
