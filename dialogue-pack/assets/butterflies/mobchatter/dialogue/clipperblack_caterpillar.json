        {"zh": "我不打算挪动", "en": "I do not intend to move."},
        {"zh": "这片叶子是我的", "en": "This leaf is mine."},
        {"zh": "叶边太近了，退一点。", "en": "That leaf edge is too near — back off a little."},
        {"zh": "我往叶背退了一点", "en": "I retreat under the leaf."},
        {"zh": "我抬着黑脑袋看你", "en": "I raise my black head and watch you."},
        {"zh": "你走开我继续吃", "en": "Leave and I will eat on."},
        {"zh": "我在叶子上很稳", "en": "I am steady on this leaf."},
        {"zh": "你把光挡住了", "en": "You are blocking my light."}
