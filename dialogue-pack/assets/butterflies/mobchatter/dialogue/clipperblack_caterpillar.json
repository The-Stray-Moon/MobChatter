      "lines": [
        {"zh": "我又爬高了一截", "en": "I climb a little higher again."},
        {"zh": "我在叶背慢慢爬", "en": "I crawl slowly under the leaf."},
        {"zh": "我的黑条纹跟着动", "en": "My black bands shift as I move."},
        {"zh": "我沿着叶缘挪", "en": "I work along the leaf's edge."},
        {"zh": "我拱起身体再伸开", "en": "I arch and stretch."},
        {"zh": "我贴住叶脉爬行", "en": "I crawl along the vein."},
        {"zh": "我从叶尖爬向叶柄", "en": "I crawl from tip toward stem."},
        {"zh": "我探出头试试前面", "en": "I poke my head out to test ahead."},
