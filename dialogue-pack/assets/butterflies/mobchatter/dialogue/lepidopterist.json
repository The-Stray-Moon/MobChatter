{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我举着网，沿林边走。", "en": "Net raised, I walk the forest edge."},
        {"zh": "眼睛盯着叶背。", "en": "Eyes on the undersides of leaves."},
        {"zh": "这一带有新种的迹象。", "en": "Signs of a new species here."},
        {"zh": "我走得很轻，怕惊飞。", "en": "Soft steps so nothing flies off."},
        {"zh": "笔记夹在腋下。", "en": "My notebook under my arm."},
        {"zh": "我蹲下看看草茎。", "en": "I crouch to check a stem."},
        {"zh": "毛毛虫啃过的叶子，我看得出。", "en": "I can spot a caterpillar's chewing."},
        {"zh": "我绕过花丛，换个角度。", "en": "I go around the flowers for a better angle."},
        {"zh": "网柄在手里转了转。", "en": "I spin the net handle."},
        {"zh": "风向不对，得从另一边。", "en": "Wrong wind; I need the other side."},
        {"zh": "我赶在今天傍晚前。", "en": "I want this done by dusk."},
        {"zh": "翅膀的闪光，我看见了。", "en": "A wingflash caught my eye."},
        {"zh": "我一步一停，怕踩到什么。", "en": "I stop at each step."},
        {"zh": "标本箱沉得很。", "en": "The specimen case is heavy."},
        {"zh": "我沿着河岸搜过去。", "en": "I search along the riverbank."},
        {"zh": "又一片叶子被啃过。", "en": "Another leaf, chewed."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我用针固定翅脉。", "en": "I pin the wing veins."},
        {"zh": "这一只，纹路很罕见。", "en": "A rare pattern on this one."},
        {"zh": "我在本子上画了一张图。", "en": "I sketch it in the book."},
        {"zh": "标签写好了，晾干。", "en": "Labels written; let it dry."},
        {"zh": "今天的收获不算多。", "en": "Not much of a catch today."},
        {"zh": "我吹了吹网上的灰。", "en": "I blow the dust off my net."},
        {"zh": "这翅粉，不能碰。", "en": "Don't touch the wing dust."},
        {"zh": "我把瓶子摆正。", "en": "I straighten the jars."},
        {"zh": "黄昏时蝶最多。", "en": "Most butterflies come at dusk."},
        {"zh": "我数了数，十二只。", "en": "Twelve, by my count."},
        {"zh": "这色泽，晒久了会淡。", "en": "Sunlight fades the color."},
        {"zh": "我在等一只不常见的。", "en": "I'm waiting for a rare one."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到草了。", "en": "You're standing on the grass."},
        {"zh": "你见过蓝翅的那种吗？", "en": "Have you seen the blue-winged kind?"},
        {"zh": "别动，你肩上有只蝶。", "en": "Hold still — one's on your shoulder."},
        {"zh": "你愿意帮我采一只吗？", "en": "Would you catch one for me?"},
        {"zh": "你的靴子，太响了。", "en": "Those boots are too loud."},
        {"zh": "这网，不是随便挥的。", "en": "You don't just swing a net."},
        {"zh": "你要看我的收藏吗？", "en": "Care to see my collection?"},
        {"zh": "翅膀不能捏，会碎。", "en": "Don't pinch the wings; they tear."},
        {"zh": "你是来买还是来学？", "en": "Buying, or learning?"},
        {"zh": "我这儿收各种蝶。", "en": "I take all kinds here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的标本箱摔了。", "en": "My case fell."},
        {"zh": "哎，手被针扎了。", "en": "Ow, a pin pricked me."},
        {"zh": "我护住胸前的瓶子。", "en": "I shield the jars at my chest."},
        {"zh": "我护着箱子的手在抖。", "en": "The hand on my case is shaking."},
        {"zh": "网柄脱手掉在地上。", "en": "The net handle slipped to the ground."},
        {"zh": "我心疼那些标本。", "en": "I grieve for the specimens."},
        {"zh": "血滴在笔记上。", "en": "Blood on my notebook."},
        {"zh": "别踩我的箱子。", "en": "Don't step on my case."},
        {"zh": "我蹲下来，抱紧箱子。", "en": "I crouch and hug the case."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这只蝶，你从哪弄的？", "en": "Where did you get that one?"},
        {"zh": "品相不错，我出价。", "en": "Good condition — I'll bid."},
        {"zh": "别用手抓，翅会破。", "en": "Don't grab; the wings tear."},
        {"zh": "装在瓶里的，我要。", "en": "In a bottle? I want it."},
        {"zh": "这颜色，少见。", "en": "Rare coloring."},
        {"zh": "蝴蝶我收，价钱好说。", "en": "I buy butterflies — the price is fair."},
        {"zh": "这个价钱，我赚了。", "en": "At that price I come out ahead."},
        {"zh": "我掂了掂，是干货。", "en": "I weigh it; properly dried."},
        {"zh": "太破了，不值这个。", "en": "Too battered for that price."},
        {"zh": "成交，我给你绿宝石。", "en": "Deal — emeralds for you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，我的标本箱！", "en": "Careful with my specimen case!"},
        {"zh": "你撞散了标本吗？", "en": "Did you scatter the specimens?"},
        {"zh": "我差点踩坏一株花。", "en": "I nearly crushed a flower."},
        {"zh": "路太窄，我侧身。", "en": "Narrow path; I turn sideways."},
        {"zh": "这一下，网柄脱手了。", "en": "The net handle slipped."},
        {"zh": "帽檐撞得翻了起来。", "en": "The brim knocked up."},
        {"zh": "别挤过来，这里全是标本。", "en": "Don't crowd; specimens all around."},
        {"zh": "草都踩平了。", "en": "The grass is trampled flat."},
        {"zh": "我们慢一点走。", "en": "Let's both walk slower."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "她也是研究蝶的。", "en": "She studies butterflies too."},
        {"zh": "我们交换标本。", "en": "We trade specimens."},
        {"zh": "同一片林子，遇见的。", "en": "We met in the same wood."},
        {"zh": "她画得比我好。", "en": "She draws better than I do."},
        {"zh": "两个网，一起挥。", "en": "Two nets swinging together."},
        {"zh": "这只，是一起捕的。", "en": "We caught this one together."},
        {"zh": "我们的笔记能合起来。", "en": "Our notes could be combined."},
        {"zh": "她笑我太较真。", "en": "She says I'm too particular."},
        {"zh": "日子慢慢过。", "en": "The days pass gently."},
        {"zh": "黄昏一起收网。", "en": "At dusk we fold the nets."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一只死蝶，还能做标本。", "en": "A dead one — still fit for a specimen."},
        {"zh": "我捏着翅根，轻轻的。", "en": "I hold it by the wing base, gently."},
        {"zh": "掉在地上，翅粉沾了土。", "en": "It fell; dust on its wings."},
        {"zh": "这片叶子，我夹进本子。", "en": "This leaf goes in my book."},
        {"zh": "空瓶我收着。", "en": "I keep the empty jar."},
        {"zh": "这枚卵，得放好。", "en": "An egg — must keep it safe."},
        {"zh": "我弯腰，标本箱硌着肋骨。", "en": "I bend; the case digs into my ribs."},
        {"zh": "太小了，看不清。", "en": "Too small to see."},
        {"zh": "我把它放进纸袋。", "en": "I slip it into a paper bag."},
        {"zh": "捡起来，用镊子夹着。", "en": "I pick it up with tweezers."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那只，翅形不对。", "en": "That one's wing shape is wrong."},
        {"zh": "不是本地的种。", "en": "Not a local species."},
        {"zh": "我慢慢举起网。", "en": "I raise the net slowly."},
        {"zh": "别弄出一点声响。", "en": "Not the slightest sound."},
        {"zh": "这片林子的风向对。", "en": "The wind in this wood is right."},
        {"zh": "就这只，我要了。", "en": "That one — I want it."},
        {"zh": "它停在叶尖上。", "en": "It's resting on a leaf tip."},
        {"zh": "我算好距离了。", "en": "I've judged the distance."},
        {"zh": "网口已经端平。", "en": "The net's mouth is level."},
        {"zh": "我数着一、二、三。", "en": "I count one, two, three."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着它走。", "en": "I follow it."},
        {"zh": "它飞得不高。", "en": "It's flying low."},
        {"zh": "这一网，角度要斜。", "en": "The swing needs an angle."},
        {"zh": "草太高，网会挂住。", "en": "Grass too tall; the net catches."},
        {"zh": "我等着它落下来。", "en": "I wait for it to settle."},
        {"zh": "翅膀的声音，我听得见。", "en": "I can hear its wings."},
        {"zh": "只差半寸的距离。", "en": "Half an inch of distance left."},
        {"zh": "它绕回来了。", "en": "It's circling back."},
        {"zh": "这次从下面抄。", "en": "This time I come from below."},
        {"zh": "屏住气，别出声。", "en": "Hold your breath; make no sound."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用网柄打过去！", "en": "I swing the net handle!"},
        {"zh": "别碰我的标本！", "en": "Don't touch my specimens!"},
        {"zh": "这一下，是护着蝶箱。", "en": "That was to guard the case."},
        {"zh": "我打得很笨。", "en": "I strike clumsily."},
        {"zh": "我退到树后。", "en": "I retreat behind a tree."},
        {"zh": "网也能缠人。", "en": "Even a net can entangle."},
        {"zh": "我扯着嗓子喊人。", "en": "I shout for help at the top of my voice."},
        {"zh": "这点力气，伤不了谁。", "en": "That much force hurts no one."},
        {"zh": "瓶子碎了一个。", "en": "A jar broke."},
        {"zh": "我护着头，往后躲。", "en": "I shield my head and duck back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在林边支起网。", "en": "I set my net at the wood's edge."},
        {"zh": "今天风向不错。", "en": "Good wind today."},
        {"zh": "先看看有没有新痕迹。", "en": "First, check for fresh traces."},
        {"zh": "我的标本箱放在树下。", "en": "My case sits under the tree."},
        {"zh": "这片林，蝶种很多。", "en": "Many species in this wood."},
        {"zh": "我咳嗽了一声，惊飞一只。", "en": "I cough and startle one away."},
        {"zh": "笔记翻到今天这页。", "en": "The notebook is open at today."},
        {"zh": "有一只停在网边。", "en": "One is resting by the net."},
        {"zh": "天还没黑，正好。", "en": "Not dark yet — good."},
        {"zh": "我活动了下手腕。", "en": "I flex my wrist."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，标本全成灰。", "en": "Fire turns my specimens to ash."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，箱子开了。", "en": "I roll downhill; the case spills."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浸了笔记，字都花了。", "en": "Water ruins my notes."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把瓶子都震碎了。", "en": "The blast shatters my jars."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的网柄。", "en": "An arrow splits my net handle."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我手抖得厉害。", "en": "That force leaves my hands shaking."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，眼睛都花了。", "en": "Hungry, my eyes blur."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈下来，我趴进草里。", "en": "Lightning; I flatten into the grass."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没了地，箱子先掉下去。", "en": "No ground; the case falls first."}
      ]
    }
  }
}
