{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑着翅膀，火星四散。", "en": "I beat my wings; sparks scatter."},
        {"zh": "下界的光，照在翅上。", "en": "Nether light on my wings."},
        {"zh": "我不怕岩浆，只怕冷。", "en": "Lava doesn't scare me; cold does."},
        {"zh": "翅膀一扇，热风就起。", "en": "One flap raises a hot wind."},
        {"zh": "我一寸寸挪过岩面。", "en": "I inch across the rock."},
        {"zh": "翅上的纹路，像熔流。", "en": "My wing veins look like lava flows."},
        {"zh": "我飞过熔岩池。", "en": "I fly over the lava pools."},
        {"zh": "夜里我也醒着。", "en": "I'm awake at night too."},
        {"zh": "我的飞行路线，绕着火。", "en": "I fly in circles around fire."},
        {"zh": "这点热度，很舒服。", "en": "This heat is pleasant."},
        {"zh": "我翅膀下压着火星。", "en": "Embers trail under my wings."},
        {"zh": "我落在赤热的石头上。", "en": "I land on glowing stone."},
        {"zh": "一对翅膀，大得出奇。", "en": "A huge pair of wings."},
        {"zh": "我飞得不快，但很稳。", "en": "Not fast, but steady."},
        {"zh": "灰烬里也有我要的东西。", "en": "There's something for me in the ash."},
        {"zh": "我靠近火光。", "en": "I drift toward the flame."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在岩壁上，发着光。", "en": "I rest on the rock, glowing."},
        {"zh": "我伏在热石上，翅半张。", "en": "On the hot stone, my wings lie half open."},
        {"zh": "我的寿命，没有尽头。", "en": "My life has no end."},
        {"zh": "火星在我身边落。", "en": "Embers settle around me."},
        {"zh": "这地方，比树林好。", "en": "This beats a forest."},
        {"zh": "我把翅膀摊平。", "en": "I spread my wings flat."},
        {"zh": "硫的味道，很熟悉。", "en": "The smell of sulfur is familiar."},
        {"zh": "我在等一只同伴。", "en": "I wait for a companion."},
        {"zh": "翅膀上的灰，我抖不掉。", "en": "I can't shake the ash off."},
        {"zh": "这里太亮了点。", "en": "A little too bright here."},
        {"zh": "我的触须在探热。", "en": "My antennae test the heat."},
        {"zh": "一动不动，像块炭。", "en": "Still as a coal."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上连一点火星都没有。", "en": "You don't carry a single spark."},
        {"zh": "我停在你面前，翅在烧。", "en": "I hover before you, wings burning."},
        {"zh": "你不怕烫吗？", "en": "Aren't you afraid of the heat?"},
        {"zh": "那张网，我在别的蛾身上见过。", "en": "That net — I've seen it over other wings."},
        {"zh": "我的光，照出你的影子。", "en": "My glow throws your shadow."},
        {"zh": "别碰我的翅膀。", "en": "Don't touch my wings."},
        {"zh": "这里的空气，你受得了？", "en": "Can you bear this air?"},
        {"zh": "我翅尖擦着你的头顶过去。", "en": "My wingtip skims over your head."},
        {"zh": "你不属于这里。", "en": "You don't belong here."},
        {"zh": "我看你，像看一块湿木头。", "en": "You look like damp wood to me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅上破了个洞。", "en": "A hole in my wing."},
        {"zh": "翅骨一响，我直往下坠。", "en": "My wing joint cracks and I drop."},
        {"zh": "我把翅膀收起来。", "en": "I fold my wings in."},
        {"zh": "这点伤，我会长回来。", "en": "This will grow back."},
        {"zh": "焦灰从我翅上簌簌落下。", "en": "Burnt ash sifts off my wings."},
        {"zh": "我落到岩面上。", "en": "I drop onto the rock."},
        {"zh": "翅上的火光暗了一瞬。", "en": "The fire on my wings dims a beat."},
        {"zh": "别撕我的翅膀。", "en": "Don't tear my wings."},
        {"zh": "疼，但我不会掉下去。", "en": "It hurts, but I won't fall."},
        {"zh": "我扇着翅挪到岩缝后。", "en": "I beat my wings back behind the rock."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃花蜜了。", "en": "I don't drink nectar anymore."},
        {"zh": "那东西会被烤干。", "en": "That would dry up here."},
        {"zh": "你举着它，我不靠近。", "en": "Hold it out; I won't come."},
        {"zh": "我只对火感兴趣。", "en": "Only fire interests me."},
        {"zh": "这点诱惑，太凉了。", "en": "That bait is too cold."},
        {"zh": "别晃，我看不见甜味。", "en": "Stop waving; I can't see sweetness."},
        {"zh": "你把东西放下也没用。", "en": "Setting it down won't help."},
        {"zh": "我的口器，早变了。", "en": "My mouthparts have changed."},
        {"zh": "我闻到的是烟。", "en": "What I smell is smoke."},
        {"zh": "把这点凉东西收好。", "en": "Put that cold morsel away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞上我，翅粉扑你一脸。", "en": "Hit me and wing-dust clouds your face."},
        {"zh": "我的翅膀很脆。", "en": "My wings are fragile."},
        {"zh": "翅被带偏，火星撒下去。", "en": "My wing is knocked askew and sparks spill."},
        {"zh": "火星从翅上迸出来。", "en": "Sparks burst off my wings."},
        {"zh": "你撞到的是热。", "en": "What you hit was heat."},
        {"zh": "我重新稳住身子。", "en": "I steady myself again."},
        {"zh": "这么大的翅，容易碰。", "en": "These big wings bump easily."},
        {"zh": "别从下面撞。", "en": "Don't hit me from below."},
        {"zh": "我退到岩壁旁。", "en": "I pull back to the rock wall."},
        {"zh": "这点擦碰，连翅粉都没掉。", "en": "That graze didn't even shake off dust."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这火里，也会有同类。", "en": "There are kin even in this fire."},
        {"zh": "我们绕着火飞。", "en": "We fly circles around the flame."},
        {"zh": "我的光，和它的光。", "en": "My glow and theirs."},
        {"zh": "翅尖碰了一下。", "en": "Our wingtips touch."},
        {"zh": "两只大蛾，绕着熔池。", "en": "Two great moths over the lava."},
        {"zh": "寿命长，也不急。", "en": "Long-lived; no need to hurry."},
        {"zh": "我们两只都不肯落下。", "en": "Neither of us is willing to settle."},
        {"zh": "这份热度，够两个人。", "en": "There's heat enough for two."},
        {"zh": "一起飞，火就更大。", "en": "Flying together, the fire grows."},
        {"zh": "安静地并肩。", "en": "Quietly side by side."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这点灰，我夹起来。", "en": "A bit of ash — I gather it."},
        {"zh": "翅上的粉，落了一点。", "en": "A little wing dust falls."},
        {"zh": "我用前足捧着。", "en": "I cup it in my forelegs."},
        {"zh": "掉进岩浆，就没了。", "en": "Dropped in lava, it's gone."},
        {"zh": "这东西烤得很脆。", "en": "This has baked crisp."},
        {"zh": "我把它带回去。", "en": "I carry it back."},
        {"zh": "太烫，拿不住。", "en": "Too hot to hold."},
        {"zh": "我捡到一块红石。", "en": "I found a piece of redstone."},
        {"zh": "留着，总有用途。", "en": "Keep it; it'll serve."},
        {"zh": "我扇着翅挪到它上方。", "en": "I beat my wings over to it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有什么进了我的光。", "en": "Something entered my light."},
        {"zh": "我把翅转向那一边。", "en": "I bank my wings that way."},
        {"zh": "那不是火在动。", "en": "That isn't fire moving."},
        {"zh": "翅膀停了一拍。", "en": "My wings miss a beat."},
        {"zh": "远处的热影动了一下。", "en": "A warm shape shifts in the distance."},
        {"zh": "你不该来这儿。", "en": "You shouldn't be here."},
        {"zh": "你的位置，我标在热里。", "en": "I mark your position in the heat."},
        {"zh": "我的翅，张到了最大。", "en": "My wings are at full span."},
        {"zh": "热浪先过去了。", "en": "The heat reaches you first."},
        {"zh": "别动，我在看。", "en": "Hold still; I'm watching."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你的头顶飞。", "en": "I circle above your head."},
        {"zh": "翅上的火星在落。", "en": "Embers fall from my wings."},
        {"zh": "你身后就是熔岩。", "en": "Lava is behind you."},
        {"zh": "我不急，火不会灭。", "en": "No hurry; the fire won't die."},
        {"zh": "再退一步就烫了。", "en": "One step back and it burns."},
        {"zh": "我的影子罩着你。", "en": "My shadow covers you."},
        {"zh": "你额头的汗，我看得见。", "en": "I can see the sweat on your brow."},
        {"zh": "这一带的路，我熟。", "en": "I know these paths."},
        {"zh": "我在数你剩下几步。", "en": "I'm counting the steps you have left."},
        {"zh": "就差最后一圈。", "en": "One last circuit to go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "翅一扇，火星扑你。", "en": "A wingbeat throws sparks at you."},
        {"zh": "我撞过去，带着热。", "en": "I ram you, wreathed in heat."},
        {"zh": "翅粉落在你皮肤上。", "en": "Wing dust settles on your skin."},
        {"zh": "这一下，很烫。", "en": "That one burns."},
        {"zh": "别伸手抓翅。", "en": "Don't grab at my wings."},
        {"zh": "我退开，绕一圈。", "en": "I pull back and circle."},
        {"zh": "你身上的布，着了。", "en": "Your cloth has caught."},
        {"zh": "我碰一下就够。", "en": "One touch is enough."},
        {"zh": "火焰替我出手。", "en": "The flame strikes for me."},
        {"zh": "再靠近，就再来一次。", "en": "Closer, and it happens again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从岩浆上方升起。", "en": "I rise above the lava."},
        {"zh": "翅膀一展，火光四射。", "en": "Wings spread, firelight scatters."},
        {"zh": "这地方，正适合我。", "en": "This place suits me."},
        {"zh": "灰烬落在我身上。", "en": "Ash settles on me."},
        {"zh": "我的翅上还有余烬。", "en": "Embers still on my wings."},
        {"zh": "我飞了一圈，看了看。", "en": "I fly a circuit and look around."},
        {"zh": "热风把我托起来。", "en": "The hot wind lifts me."},
        {"zh": "这么久才回来。", "en": "It's been long since I returned."},
        {"zh": "空气里有活物的热。", "en": "Something warm is in the air."},
        {"zh": "我不急着走。", "en": "I'm in no hurry to leave."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我也是火里的，烧不坏。", "en": "I'm of the fire; it can't burn me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀托不住，我摔了。", "en": "My wings fail; I fall."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浇在翅上，直冒白烟。", "en": "Water on my wings makes white steam."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀到岩上。", "en": "The blast slams me into rock."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿了我的翅。", "en": "Something pierces my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量冷得刺骨。", "en": "That force is cold to the bone."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，只是倦。", "en": "I don't eat; I only tire."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一闪，我的翅全亮了。", "en": "A flash lights every vein."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "火没了，我也往下掉。", "en": "The fire's gone, and I fall."}
      ]
    }
  }
}
