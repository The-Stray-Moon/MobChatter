{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一节一节往前拱", "en": "I inch forward segment by segment."},
        {"zh": "我沿着叶脉爬", "en": "I crawl along the leaf vein."},
        {"zh": "身体像波浪一样", "en": "My body moves in waves."},
        {"zh": "我咬着叶边爬", "en": "I crawl along the leaf edge."},
        {"zh": "一片叶子爬到头了", "en": "I have reached the end of a leaf."},
        {"zh": "我用尾足抓叶面", "en": "My rear feet grip the leaf."},
        {"zh": "我慢慢挪到反面", "en": "I creep to the underside."},
        {"zh": "六只脚轮流抓", "en": "Six feet take turns."},
        {"zh": "叶子被我咬出缺口", "en": "I bite a notch in the leaf."},
        {"zh": "我想去下一片叶", "en": "I want the next leaf."},
        {"zh": "我探头试了试距离", "en": "I stretch out to test the gap."},
        {"zh": "风一吹叶子就晃", "en": "The leaf sways whenever the wind blows."},
        {"zh": "我抬起头找叶脉", "en": "I raise my head to find a vein."},
        {"zh": "我从叶尖往叶根走", "en": "I crawl from tip to stem."},
        {"zh": "我的背上有黄点", "en": "Yellow spots run down my back."},
        {"zh": "我走过去的地方都只剩筋", "en": "I leave only veins behind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在叶子上", "en": "I rest on the leaf."},
        {"zh": "我吃得够饱了", "en": "I have eaten my fill."},
        {"zh": "太阳晒得叶面很暖", "en": "The sun warms the leaf."},
        {"zh": "我抬着头不动", "en": "I hold my head up, still."},
        {"zh": "这棵树不错", "en": "This tree is good."},
        {"zh": "再吃一点就睡", "en": "A little more, then sleep."},
        {"zh": "我的身体一伸一缩", "en": "My body stretches and shrinks."},
        {"zh": "叶子上有我的影子", "en": "My shadow lies on the leaf."},
        {"zh": "我慢慢咀嚼", "en": "I chew slowly."},
        {"zh": "我有点困了", "en": "I am getting sleepy."},
        {"zh": "周围全是绿色", "en": "Everything around me is green."},
        {"zh": "我这辈子就在树上", "en": "My whole life is in these trees."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你离叶子太近了", "en": "You are too close to the leaf."},
        {"zh": "我怕掉下去", "en": "I am afraid of falling."},
        {"zh": "你会把我放到别处吗", "en": "Will you move me somewhere?"},
        {"zh": "我离开叶子会活不久", "en": "Off a leaf I do not last long."},
        {"zh": "你手指伸过来做什么", "en": "What are your fingers for?"},
        {"zh": "别捏我", "en": "Do not pinch me."},
        {"zh": "我这条虫很小", "en": "I am a small worm."},
        {"zh": "我想留在这片叶上", "en": "I want to stay on this leaf."},
        {"zh": "你的影子挡住太阳了", "en": "Your shadow blocks my sun."},
        {"zh": "你手心摊开，我就爬上去。", "en": "Open your palm and I'll crawl on."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的绒毛被压歪了几根。", "en": "A few of my bristles are bent flat."},
        {"zh": "我蜷起来了", "en": "I curled up."},
        {"zh": "我掉到下一片叶", "en": "I dropped to the leaf below."},
        {"zh": "我的毛乱了一点", "en": "My bristles are mussed."},
        {"zh": "我把头尾收到一起，不动了。", "en": "I tuck head to tail and go still."},
        {"zh": "好疼", "en": "It hurts."},
        {"zh": "我爬不动了", "en": "I cannot crawl."},
        {"zh": "别踩叶子", "en": "Do not crush the leaf."},
        {"zh": "我抬不起头", "en": "I cannot lift my head."},
        {"zh": "我还想再吃点", "en": "I wanted to eat a little more."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那片叶子更嫩", "en": "That leaf is tenderer."},
        {"zh": "我闻到新鲜的叶味", "en": "I smell fresh leaves."},
        {"zh": "你手上的叶子给我吗", "en": "Is that leaf in your hand for me?"},
        {"zh": "我慢慢爬过去", "en": "I will crawl over."},
        {"zh": "叶脉很脆", "en": "The veins are crisp."},
        {"zh": "别把叶子拿走", "en": "Do not take the leaf away."},
        {"zh": "这边已经啃光了", "en": "This side is chewed bare."},
        {"zh": "我够得着那里", "en": "I can reach over there."},
        {"zh": "那片颜色刚好", "en": "That color looks just right."},
        {"zh": "我快到了", "en": "I am almost there."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你抖了抖叶子", "en": "You jiggled the leaf."},
        {"zh": "叶柄一晃，我的脚全抓紧了。", "en": "The leaf stem sways; all my feet clamp down."},
        {"zh": "抓稳了", "en": "Holding on."},
        {"zh": "你撞到我的叶柄", "en": "You bumped my leaf stem."},
        {"zh": "我蜷了一下身子", "en": "I curled up for a moment."},
        {"zh": "我往回退了一节", "en": "I backed up one segment."},
        {"zh": "我的脚没抓牢", "en": "My feet slipped."},
        {"zh": "风和你一起晃我", "en": "The wind and you both shake me."},
        {"zh": "别碰这片叶", "en": "Do not touch this leaf."},
        {"zh": "我又爬上来了", "en": "I climbed back up."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们都在同一片叶子上", "en": "We are on the same leaf."},
        {"zh": "别踩坏了叶子", "en": "Do not crush the leaf."},
        {"zh": "我们靠得很近", "en": "We lie close together."},
        {"zh": "蝴蝶会回来的", "en": "The butterflies will come back."},
        {"zh": "等结蛹再说", "en": "We will see after the chrysalis."},
        {"zh": "身体碰了一下", "en": "Our bodies touched."},
        {"zh": "这片叶子够宽", "en": "The leaf is wide enough."},
        {"zh": "你也饿了", "en": "You are hungry too."},
        {"zh": "安静地待着", "en": "Just stay quietly."},
        {"zh": "我和她的丝碰了碰，就算说完了。", "en": "Her thread and mine touch; that's all we need to say."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我能捡起什么", "en": "What could I pick up?"},
        {"zh": "我用嘴咬住一点", "en": "I grip a bit with my mouth."},
        {"zh": "这粒土太重了", "en": "This grain of dirt is too heavy."},
        {"zh": "叶子算我的", "en": "The leaf counts as mine."},
        {"zh": "我用头顶着它，一点一点挪。", "en": "I push it with my head, inch by inch."},
        {"zh": "吃的东西不用捡", "en": "Food does not need picking up."},
        {"zh": "我抱着这颗种子", "en": "I hug this seed."},
        {"zh": "它比我还大", "en": "It is bigger than I am."},
        {"zh": "我抓不住了", "en": "I cannot hold it."},
        {"zh": "掉下就没了", "en": "If it drops, it is gone."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你要抢我的叶子", "en": "You are taking my leaf."},
        {"zh": "我抬起前半身，朝你的方向。", "en": "I lift my front half toward you."},
        {"zh": "别碰我，我很多毛", "en": "Do not touch, I am bristly."},
        {"zh": "这片叶是我的", "en": "This leaf is mine."},
        {"zh": "你要吃我吗", "en": "Are you going to eat me?"},
        {"zh": "我不是真鸟翼蝶", "en": "I am not a birdwing yet."},
        {"zh": "还没结蛹呢", "en": "I have not made my chrysalis."},
        {"zh": "我只有这一条命", "en": "I have only this one life."},
        {"zh": "请别让我离开叶子", "en": "Please do not take me off the leaf."},
        {"zh": "我就停在这儿", "en": "I am staying right here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在这片叶上", "en": "I stay on this leaf."},
        {"zh": "你还在看我", "en": "You are still watching."},
        {"zh": "我动得很慢", "en": "I move very slowly."},
        {"zh": "我的绿色藏得住", "en": "My green hides me."},
        {"zh": "你的影子近了，我往后缩。", "en": "Your shadow nears; I shrink back."},
        {"zh": "你别把我捡起来", "en": "Do not pick me up."},
        {"zh": "树叶下还有我", "en": "There is more of me under the leaves."},
        {"zh": "我不想被挪走", "en": "I do not want to be moved."},
        {"zh": "我在这里安全", "en": "I am safe here."},
        {"zh": "你就看着我吧", "en": "Just watch me, then."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬头撞你手指", "en": "I butt your finger with my head."},
        {"zh": "我拿头顶你的手指，没用力。", "en": "I bump your finger with my head, barely."},
        {"zh": "我卷起身体", "en": "I curl up."},
        {"zh": "我用头甩你", "en": "I flick my head at you."},
        {"zh": "我没想伤你", "en": "I did not mean to hurt you."},
        {"zh": "我又缩成一团", "en": "I curl up again."},
        {"zh": "我实在太小了", "en": "I am truly too small."},
        {"zh": "这一口连叶子都咬不动", "en": "This bite cannot even break a leaf."},
        {"zh": "我咬住你的手套", "en": "I bite your glove."},
        {"zh": "我身上有刺毛", "en": "I have bristles."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一片叶子下多了条虫", "en": "A caterpillar under a leaf."},
        {"zh": "我从卵里出来", "en": "I hatch from an egg."},
        {"zh": "我先咬了第一口叶", "en": "My first bite of leaf."},
        {"zh": "我爬到叶脉上", "en": "I crawl onto the vein."},
        {"zh": "阳光从树冠漏下来", "en": "Sun slips through the canopy."},
        {"zh": "我开始吃了", "en": "I begin to eat."},
        {"zh": "叶子上有我小小的影子", "en": "My tiny shadow on the leaf."},
        {"zh": "我慢慢挪动位置", "en": "I shift my position."},
        {"zh": "新的毛虫出生了", "en": "A new caterpillar is born."},
        {"zh": "周围全是我的口粮", "en": "All around me is food."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火要烧到我这片叶子了", "en": "Fire is coming for my leaf."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上掉下来了", "en": "I fell from the tree."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让我爬不动", "en": "Water stops me crawling."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子都被震落了", "en": "The blast shook the leaves down."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉在叶子上", "en": "Something pinned the leaf."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我每一节都僵住。", "en": "That light stiffens every segment of me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子被我吃光了", "en": "I ate the leaf bare."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把树冠照亮了", "en": "Lightning lit up the canopy."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "连叶子都没有了", "en": "Even the leaves are gone."}
      ]
    }
  }
