{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶背，风吹我就晃。", "en": "I hang under a leaf and sway with the wind."},
        {"zh": "我动不了，只能晃。", "en": "I cannot walk; I can only sway."},
        {"zh": "我随着枝条摆。", "en": "I swing with the branch."},
        {"zh": "我的壳一点点变硬。", "en": "My casing hardens bit by bit."},
        {"zh": "有人碰我，我就摇得更厉害。", "en": "Touch me and I swing harder."},
        {"zh": "叶脉就在我旁边。", "en": "The leaf vein runs beside me."},
        {"zh": "我在森林深处挂着。", "en": "I hang deep in the forest."},
        {"zh": "我不敢乱动，会掉下去。", "en": "I must not thrash, or I will fall."},
        {"zh": "枝叶把我遮得很严。", "en": "The leaves hide me well."},
        {"zh": "我微微转了个方向。", "en": "I turn slightly."},
        {"zh": "雨打下来，我就抖。", "en": "Rain strikes and I shudder."},
        {"zh": "风大的时候，我抓紧丝。", "en": "When the wind picks up, I grip the silk."},
        {"zh": "我挂在够不着的高度。", "en": "I hang out of reach."},
        {"zh": "我等着暖一点。", "en": "I wait for it to get warmer."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂着，什么都没做。", "en": "I hang, doing nothing."},
        {"zh": "我里面在变。", "en": "Something inside me is changing."},
        {"zh": "我没有眼睛，可我知道光在哪。", "en": "I have no eyes, yet I know where the light is."},
        {"zh": "我的壳透出一点颜色。", "en": "A little color shows through my casing."},
        {"zh": "我安安静静地待着。", "en": "I stay very still."},
        {"zh": "树的味道一直在我身边。", "en": "The smell of the tree stays with me."},
        {"zh": "树液在叶脉里流。", "en": "Sap flows in the leaf vein."},
        {"zh": "我听见鸟叫。", "en": "I hear birds."},
        {"zh": "我挂在叶下，一动不动。", "en": "I hang beneath the leaf, still."},
        {"zh": "我在攒力气。", "en": "I am gathering strength."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头看我，我也只能挂着。", "en": "You look up at me; hanging is all I can do."},
        {"zh": "别碰我，我会掉。", "en": "Do not touch me, or I will fall."},
        {"zh": "你离得很近。", "en": "You are very close."},
        {"zh": "你在打量我这层壳。", "en": "You are studying my casing."},
        {"zh": "你看了很久，我还在。", "en": "You look a long time; I am still here."},
        {"zh": "我不是果实。", "en": "I am not a fruit."},
        {"zh": "你手上有点暖。", "en": "Your hands are a little warm."},
        {"zh": "你走了，叶子还在晃。", "en": "You leave, and the leaf keeps swaying."},
        {"zh": "我等着变成别的样子。", "en": "I am waiting to become something else."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我差点脱落。", "en": "I nearly come loose."},
        {"zh": "里面的我在缩。", "en": "What is inside me shrinks."},
        {"zh": "丝被扯紧了。", "en": "My silk pulls taut."},
        {"zh": "叶子也晃。", "en": "The leaf sways too."},
        {"zh": "我被扯得歪了。", "en": "I am pulled crooked."},
        {"zh": "这不好。", "en": "This is not good."},
        {"zh": "壳裂了一点，里面还疼。", "en": "My shell has cracked a little, and it still stings inside."},
        {"zh": "我挂在叶上，经不起摇晃。", "en": "I'm hanging from this leaf; I can't take any shaking."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不能吃。", "en": "I cannot eat."},
        {"zh": "你举着东西有什么用？", "en": "What use is holding that up?"},
        {"zh": "你把虫子放我旁边吧。", "en": "Put the bug beside me instead."},
        {"zh": "我封在自己的壳里。", "en": "I am sealed inside my casing."},
        {"zh": "我看不见你手里的东西。", "en": "I cannot see what you hold."},
        {"zh": "蛹壳里的我，不吃也不喝。", "en": "Inside this shell I neither eat nor drink."},
        {"zh": "你收起来。", "en": "Put it away."},
        {"zh": "我等的是别的东西。", "en": "I am waiting for something else."},
        {"zh": "你自己留着吃。", "en": "Eat it yourself."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我，我就摇起来。", "en": "You touch me and I swing."},
        {"zh": "我的丝在颤。", "en": "My silk trembles."},
        {"zh": "森林的枝叶被我压得弯了。", "en": "The forest branch bends under my weight."},
        {"zh": "你把我碰歪了。", "en": "You knocked me askew."},
        {"zh": "这根枝被我压弯了。", "en": "This twig bends under me."},
        {"zh": "我撞回叶子上。", "en": "I bump back against the leaf."},
        {"zh": "我的丝还牢。", "en": "My silk still holds."},
        {"zh": "别推这根枝。", "en": "Do not push this twig."},
        {"zh": "我又正回来了。", "en": "I settle back into place."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还没有变成样子。", "en": "I have not taken my shape yet."},
        {"zh": "先等我出来。", "en": "Wait until I come out."},
        {"zh": "我会飞走的。", "en": "I will fly away."},
        {"zh": "到那时候再说。", "en": "We can talk then."},
        {"zh": "我静静挂着。", "en": "I hang quietly."},
        {"zh": "风从叶子间过。", "en": "The wind passes between the leaves."},
        {"zh": "我的壳又紧了一点。", "en": "My casing tightens a little more."},
        {"zh": "别碰我，我在等翅膀长成。", "en": "Don't touch me; I'm waiting for my wings to form."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我连脚都没有。", "en": "I do not even have feet."},
        {"zh": "东西掉在我下面的地上。", "en": "It lies on the ground below me."},
        {"zh": "它离我一尺远。", "en": "It is a block away."},
        {"zh": "有虫子爬过去了。", "en": "A bug crawls past it."},
        {"zh": "我记着那个位置。", "en": "I remember where it fell."},
        {"zh": "有人把它捡走了。", "en": "Someone picked it up."},
        {"zh": "叶子上还留着印子。", "en": "The leaf still shows the mark."},
        {"zh": "我挂在叶下，够不到地面。", "en": "I hang under the leaf, far from the ground."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我不能攻击。", "en": "I cannot attack."},
        {"zh": "你为什么要对付一个蛹？", "en": "Why would you fight a chrysalis?"},
        {"zh": "我只能挂着。", "en": "I can only hang here."},
        {"zh": "你打中我，我就掉。", "en": "Hit me and I fall."},
        {"zh": "我的壳很薄。", "en": "My casing is thin."},
        {"zh": "我没什么能还手。", "en": "I have nothing to strike back with."},
        {"zh": "蛹壳很薄，别伸手碰我。", "en": "My chrysalis is thin. Don't reach for me."},
        {"zh": "我在等羽化。", "en": "I am waiting to emerge."},
        {"zh": "结束得太早了。", "en": "This ends too soon."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "森林的蛹，等一阵风。", "en": "A forest chrysalis, waiting for wind."},
        {"zh": "你的影子在我头顶。", "en": "Your shadow falls over me."},
        {"zh": "我抓紧丝。", "en": "I grip the silk."},
        {"zh": "这根枝快撑不住了。", "en": "This twig is giving way."},
        {"zh": "我只能等。", "en": "I can only wait."},
        {"zh": "我的壳上有了裂口。", "en": "A crack opens in my casing."},
        {"zh": "还差一点。", "en": "Almost there."},
        {"zh": "你别再摇了。", "en": "Stop shaking me."},
        {"zh": "我想飞。", "en": "I want to fly."},
        {"zh": "风又起了。", "en": "The wind rises again."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有办法还手。", "en": "I have no way to strike back."},
        {"zh": "我只晃了一下。", "en": "I only swing once."},
        {"zh": "我的壳裂了。", "en": "My casing cracks."},
        {"zh": "你碰到里面的东西了。", "en": "You touched what is inside."},
        {"zh": "我掉了一片叶子。", "en": "A leaf falls."},
        {"zh": "我的丝还在。", "en": "My silk still holds."},
        {"zh": "这很疼。", "en": "That hurts."},
        {"zh": "别这样。", "en": "Do not do that."},
        {"zh": "我还没到时候。", "en": "It is not my time yet."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "毛虫爬到这里，把我结了下来。", "en": "A caterpillar came here and spun me."},
        {"zh": "我挂在叶背下。", "en": "I hang under a leaf."},
        {"zh": "这是我新结的壳。", "en": "This casing is newly made."},
        {"zh": "我从毛虫变成了这个。", "en": "I went from larva to this."},
        {"zh": "树给我遮着。", "en": "The tree shelters me."},
        {"zh": "我慢慢定住。", "en": "I settle slowly."},
        {"zh": "叶子被我压弯了一点。", "en": "The leaf bends slightly under me."},
        {"zh": "森林里多了一个绿点。", "en": "The forest gains one more green spot."},
        {"zh": "我第一次被风吹到晃。", "en": "The wind sways me for the first time."},
        {"zh": "我安静地挂着。", "en": "I hang quietly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热从外面透进来，我在壳里缩紧。", "en": "Heat seeps in and I tighten inside my casing."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去了，还没落地就慌了。", "en": "I fall, and panic before I land."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浸透了我的壳。", "en": "Water soaks through my casing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我从叶子上撕下来。", "en": "The blast tears me off the leaf."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一阵光，我的壳亮了。", "en": "A flash of light makes my casing glow."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我在耗自己的储备。", "en": "I am burning my own reserves."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声透过树，我在壳里发抖。", "en": "Thunder reaches through the trees and I shake in my casing."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有风，也没有叶。", "en": "No wind and no leaves in the void."}
      ]
    }
  }
}
