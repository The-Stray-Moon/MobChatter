{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我吊在叶下，只能转", "en": "I hang under a leaf. I can only rotate."},
        {"zh": "丝垫粘在叶面上", "en": "My silk pad clings to the leaf."},
        {"zh": "壳里透出一点微光", "en": "A faint light shows through my shell."},
        {"zh": "风一过，我轻轻摆", "en": "A gust, and I sway gently."},
        {"zh": "身体在壳里翻了个向", "en": "Inside, I turn over."},
        {"zh": "我试着撑一下", "en": "I try to push."},
        {"zh": "怎么撑都撑不动", "en": "It won't budge."},
        {"zh": "壳还没有要裂的意思", "en": "The shell shows no sign of splitting."},
        {"zh": "羽化的时间还没到", "en": "The time hasn't come."},
        {"zh": "光在我里面慢慢聚", "en": "Light gathers slowly inside me."},
        {"zh": "叶脉的影子扫过我", "en": "Leaf-vein shadows sweep over me."},
        {"zh": "一整天，我只晃了一次", "en": "All day, I sway once."},
        {"zh": "夜来了，光更明显", "en": "Night comes and the glow shows more."},
        {"zh": "我在等那两个东西", "en": "I'm waiting for those two things."},
        {"zh": "会折的，会张开的", "en": "The ones that fold. The ones that open."},
        {"zh": "那是翅膀的形状", "en": "The shape of wings."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静得像一滴水", "en": "Still as a droplet."},
        {"zh": "壳的表面很光滑", "en": "My shell is very smooth."},
        {"zh": "透着淡绿的光", "en": "A pale green light seeps out."},
        {"zh": "壳里正在重排翅纹。", "en": "Wing veins are rearranging inside."},
        {"zh": "我能感觉到腿的形状", "en": "I can feel the shape of legs."},
        {"zh": "还有触角的地方", "en": "And where antennae go."},
        {"zh": "我一动都没有动", "en": "I haven't moved at all."},
        {"zh": "有露水挂在壳上", "en": "Dew hangs on my shell."},
        {"zh": "我把它晃掉了", "en": "I shake it loose."},
        {"zh": "叶影慢慢移过", "en": "Leaf shadow slides past."},
        {"zh": "我还是这样挂着", "en": "I keep hanging."},
        {"zh": "就这样挂着就好", "en": "Just like this."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "有人靠近这片叶子", "en": "Someone is near this leaf."},
        {"zh": "我从叶下看你", "en": "I watch you from beneath the leaf."},
        {"zh": "在我眼里你是倒的", "en": "You're upside down to me."},
        {"zh": "光在你脸上晃", "en": "My light moves on your face."},
        {"zh": "你把手伸过来了", "en": "You reach out."},
        {"zh": "你千万别捏我", "en": "Don't pinch me."},
        {"zh": "我还没有长好", "en": "I'm not finished growing."},
        {"zh": "你又把手收回去", "en": "You pull your hand back."},
        {"zh": "我在叶下转了半圈", "en": "I rotate half a turn under the leaf."},
        {"zh": "这样比较安全", "en": "Safer this way."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳上出现一道纹", "en": "A line appears on my shell."},
        {"zh": "我摆得很厉害", "en": "I swing violently."},
        {"zh": "里面的东西被晃乱了", "en": "Everything inside is jolted loose."},
        {"zh": "我的微光在闪动", "en": "My faint glow flickers."},
        {"zh": "丝线绷得很紧", "en": "The silk pulls taut."},
        {"zh": "丝线还连着我", "en": "The silk still holds me."},
        {"zh": "我慢慢稳下来", "en": "I slowly come to rest."},
        {"zh": "这道纹不算裂", "en": "That line isn't a crack."},
        {"zh": "我还得再撑一段", "en": "I'll last a while longer."},
        {"zh": "一直撑到那一天", "en": "Until that day."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子的气味很近", "en": "The leaf's smell is very close."},
        {"zh": "但我现在不吃", "en": "But I don't eat now."},
        {"zh": "这一层壳里没有嘴", "en": "There's no mouth in this shell."},
        {"zh": "你把叶子递过来也没用", "en": "Offering a leaf won't help."},
        {"zh": "我在变成别的东西", "en": "I'm becoming something else."},
        {"zh": "吃这件事要等以后", "en": "Eating will come later."},
        {"zh": "你留着叶子吧", "en": "Keep your leaf."},
        {"zh": "我有人家给不了的养分", "en": "I have nourishment you can't give."},
        {"zh": "养分就是我自己", "en": "The nourishment is myself."},
        {"zh": "慢慢化开的那部分", "en": "The part slowly dissolving."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子晃得很厉害", "en": "The leaf shakes hard."},
        {"zh": "丝线还连在一起", "en": "The silk still holds."},
        {"zh": "我摆了很长时间", "en": "I sway for a long while."},
        {"zh": "壳上有一道白痕", "en": "A white mark on my shell."},
        {"zh": "这还算不上破", "en": "Not a break."},
        {"zh": "我转回原来的角度", "en": "I turn back to my old angle."},
        {"zh": "风忽然就停了", "en": "The wind suddenly stops."},
        {"zh": "我也跟着不动", "en": "And I stop too."},
        {"zh": "那便继续等着", "en": "Then I keep waiting."},
        {"zh": "摇第二下我就掉了。", "en": "Shake again and I fall."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "壳里不谈这些", "en": "Not inside a shell."},
        {"zh": "等我破壳出来", "en": "When I come out."},
        {"zh": "翅膀干了以后", "en": "After my wings dry."},
        {"zh": "那时才是那个阶段", "en": "That's when that stage begins."},
        {"zh": "现在里面全是浆", "en": "Right now, everything inside is fluid."},
        {"zh": "里面正在变化", "en": "Changing inside."},
        {"zh": "还得再等上一等", "en": "Wait a little more."},
        {"zh": "叶下的时间很长", "en": "Time under a leaf runs long."},
        {"zh": "我一点都不慌", "en": "I'm not flustered."},
        {"zh": "那一天总会到", "en": "It'll come."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有可以抓的", "en": "I have nothing to grip with."},
        {"zh": "壳是完整的一块", "en": "My shell is one solid piece."},
        {"zh": "东西落在叶上", "en": "It lands on the leaf above me."},
        {"zh": "我看得见，够不到", "en": "I can see it. I can't reach it."},
        {"zh": "只能等它掉下来", "en": "I can only wait for it to fall."},
        {"zh": "掉下来也跟我无关", "en": "And it still wouldn't matter."},
        {"zh": "这个阶段不吃东西", "en": "I don't eat now."},
        {"zh": "壳只吸收叶上的水", "en": "The shell just takes water from the leaf."},
        {"zh": "别的东西都多余", "en": "Anything else is spare."},
        {"zh": "所以就这样挂着", "en": "So I hang here."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在叶上停了一下", "en": "Something settled on the leaf."},
        {"zh": "我停下了摆动", "en": "I stop swaying."},
        {"zh": "光被我收起来", "en": "I pull my glow in."},
        {"zh": "壳和叶影一样", "en": "My shell matches the leaf shadow."},
        {"zh": "你看不出区别", "en": "You can't tell the difference."},
        {"zh": "我屏住了里面的一切", "en": "I hold everything inside still."},
        {"zh": "你千万千万不要动", "en": "Don't you dare move."},
        {"zh": "只要熬过这几秒", "en": "Just these few seconds."},
        {"zh": "它已经过去了", "en": "It passed."},
        {"zh": "我才慢慢放开", "en": "I slowly release."},
        {"zh": "我的光又回来了", "en": "The glow returns."},
        {"zh": "只是很淡的一点", "en": "Only very faint."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你还在那片叶旁", "en": "You're still by that leaf."},
        {"zh": "我保持这个角度", "en": "I hold this angle."},
        {"zh": "我是倒挂着的", "en": "Hanging upside down."},
        {"zh": "你抬头也难看见", "en": "Even looking up, you'd barely see me."},
        {"zh": "我的壳实在很小", "en": "My shell is small."},
        {"zh": "叶脉比我还显眼", "en": "The leaf veins draw more attention."},
        {"zh": "我把光压到最低", "en": "I dim to the lowest glow."},
        {"zh": "亮光只剩一点", "en": "Only a spark left."},
        {"zh": "还得再来一会儿", "en": "A little longer."},
        {"zh": "之后你就会走", "en": "Then you'll leave."},
        {"zh": "那我就安全了", "en": "And I'll be safe."},
        {"zh": "壳还得挂几天", "en": "The shell needs more days up here."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我什么也办不到", "en": "There's nothing I can do."},
        {"zh": "壳又硬了一点", "en": "My shell has hardened."},
        {"zh": "挡住了这一下", "en": "It absorbed the blow."},
        {"zh": "但里面被震得发麻", "en": "But everything inside is ringing."},
        {"zh": "我晃了几十下", "en": "I swing dozens of times."},
        {"zh": "后来才停下来", "en": "Before I settle."},
        {"zh": "丝线承受了力气", "en": "The silk has taken strain."},
        {"zh": "只但愿它别断掉", "en": "Just let it hold."},
        {"zh": "壳里还有力气撑。", "en": "There is still strength inside this shell."},
        {"zh": "还差一点时间", "en": "Just a little more time."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "叶下多了一个小挂件", "en": "A small pendant appears beneath a leaf."},
        {"zh": "我说不清里面是什么", "en": "Even I can't say what's inside."},
        {"zh": "只有一点绿光", "en": "Only a little green light."},
        {"zh": "丝垫已经粘稳", "en": "The silk pad sets."},
        {"zh": "四周全是黑的", "en": "Around me is black."},
        {"zh": "这片叶子很凉", "en": "The leaf is cool."},
        {"zh": "我挂在叶缘里面一点", "en": "I hang just inside the leaf edge."},
        {"zh": "这样风吹得少", "en": "Less wind that way."},
        {"zh": "露水会自己流走", "en": "Dew will run off."},
        {"zh": "剩下的就是等", "en": "The rest is waiting."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热气让壳发软", "en": "The heat softens my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉到草上，壳还在", "en": "I fall into grass, shell intact."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "壳里面进了水", "en": "Water has gotten inside."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把叶子连我一起掀", "en": "The blast throws the leaf and me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西擦着我的壳过去了", "en": "It sheared past my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "里面的变化全乱了", "en": "The change inside me is thrown off."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "壳里不需要这些", "en": "The shell doesn't need that."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照透了我的壳", "en": "Lightning light shines right through me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子没有了，只剩空", "en": "The leaf is gone. Only emptiness."}
      ]
    }
  }
}
