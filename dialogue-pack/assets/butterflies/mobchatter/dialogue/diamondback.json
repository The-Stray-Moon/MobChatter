{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拍着翅膀，飞得很低。", "en": "I fly low, wings beating."},
        {"zh": "翅膀上有灰白的菱形纹。", "en": "Grey-white diamonds pattern my wings."},
        {"zh": "我在草丛间穿来穿去。", "en": "I weave between the grass blades."},
        {"zh": "我夜里才活跃。", "en": "I come alive at night."},
        {"zh": "我绕着一根草秆转了半圈。", "en": "I circle a grass stalk half a turn."},
        {"zh": "风推我一下，我漂了一格。", "en": "The wind nudges me a block sideways."},
        {"zh": "我在叶尖上歇了歇", "en": "I rest a moment on the leaf tip."},
        {"zh": "我又飞起来，很轻。", "en": "I lift off again, weightless."},
        {"zh": "我的翅膀扇得很快。", "en": "My wings beat fast."},
        {"zh": "我看不见很远，但够用。", "en": "I can't see far, but it's enough."},
        {"zh": "我朝着窗里的灯火飞", "en": "I make for the lamp in the window."},
        {"zh": "我贴着一排麦子飞。", "en": "I skim a row of wheat."},
        {"zh": "我的影子在地上很小。", "en": "My shadow on the ground is tiny."},
        {"zh": "我忽高忽低，没有规律。", "en": "I rise and dip without a pattern."},
        {"zh": "我绕回来，又走了。", "en": "I come back round, then go."},
        {"zh": "我贴着麦芒一路掠过去", "en": "I skim along the wheat awns."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在叶子上歇。", "en": "I rest on a leaf."},
        {"zh": "我把翅膀合起来。", "en": "I fold my wings."},
        {"zh": "我的触角动了一下。", "en": "My antennae twitch."},
        {"zh": "夜里很凉，正合适。", "en": "The night is cool; just right."},
        {"zh": "我在等一阵对的风。", "en": "I'm waiting for the right breeze."},
        {"zh": "有灯在那边亮着。", "en": "A light is burning over there."},
        {"zh": "我把腿理了理。", "en": "I groom my legs."},
        {"zh": "我一动不动，像一片叶。", "en": "I'm still as a leaf."},
        {"zh": "远处有同类在飞。", "en": "Others of my kind are flying."},
        {"zh": "我的翅膀有点潮。", "en": "My wings are a little damp."},
        {"zh": "我在听草里的声音。", "en": "I listen to the grass."},
        {"zh": "我等一会儿再飞。", "en": "I'll fly again in a moment."},
        {"zh": "月光让我看不清路。", "en": "The moonlight makes the path unclear."},
        {"zh": "我慢慢展开翅膀。", "en": "I slowly open my wings."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在那里发光。", "en": "You're standing there, lit up."},
        {"zh": "我飞到你眼前。", "en": "I fly in front of your eyes."},
        {"zh": "你的火光让我晕。", "en": "Your flamelight dizzies me."},
        {"zh": "我绕你的头转了一圈。", "en": "I circle your head once."},
        {"zh": "别挥手，我会被扇走。", "en": "Don't wave; I'll be swept away."},
        {"zh": "你呼出的热气把我推歪", "en": "Your warm breath knocks me off course."},
        {"zh": "我看不清你多大。", "en": "I can't tell how big you are."},
        {"zh": "我停在你领口的褶上", "en": "I settle in the fold of your collar."},
        {"zh": "你的衣服是浅色。", "en": "Your clothes are pale."},
        {"zh": "我拍了两下就离你远了", "en": "Two wingbeats and I'm away from you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀折了一角。", "en": "A corner of my wing bent."},
        {"zh": "我在空中晃了一下。", "en": "I wobbled in the air."},
        {"zh": "我的鳞粉撒出来。", "en": "Wing dust scatters."},
        {"zh": "我半边翅膀贴着泥", "en": "Half a wing is stuck in the mud."},
        {"zh": "我扇了两下才起来。", "en": "Two beats to get up again."},
        {"zh": "半边翅膀皱在叶子上。", "en": "One wing is crumpled on the leaf."},
        {"zh": "这点伤对我很大。", "en": "A small wound is big for me."},
        {"zh": "我又飞了一小段。", "en": "I fly a short way."},
        {"zh": "我停在叶上喘。", "en": "I stop on a leaf to recover."},
        {"zh": "我记住了那一下。", "en": "I remember that blow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那边的光很亮。", "en": "That light is very bright."},
        {"zh": "我朝灯飞过去。", "en": "I fly toward the lamp."},
        {"zh": "有一点甜的味道。", "en": "Something smells sweet."},
        {"zh": "我把翅膀收了一半。", "en": "I half close my wings."},
        {"zh": "火边太亮，我再近一尺", "en": "The fire's too bright; one more foot closer."},
        {"zh": "这味道不对，我不碰", "en": "That smells wrong, I won't touch it."},
        {"zh": "我只想贴着火。", "en": "I only want to be near the flame."},
        {"zh": "热得有点烫。", "en": "It's beginning to burn."},
        {"zh": "我退开了一寸。", "en": "I backed off an inch."},
        {"zh": "你的手里很暖。", "en": "Your hand is warm."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被你的手扫了一下。", "en": "Your hand swept over me."},
        {"zh": "翅膀一歪，我打了个旋", "en": "A wing slips and I spin sideways."},
        {"zh": "翅膀有点歪。", "en": "One wing's a bit bent."},
        {"zh": "我又稳住了。", "en": "I've steadied again."},
        {"zh": "你的肩撞到了我。", "en": "Your shoulder caught me."},
        {"zh": "我贴在你衣服上。", "en": "I cling to your clothes."},
        {"zh": "我落下去，又飞起来。", "en": "I fall, then rise."},
        {"zh": "这么小的身子，撞不起。", "en": "This body is too small for impacts."},
        {"zh": "我的鳞粉掉了一点。", "en": "A little wing dust came off."},
        {"zh": "我从你指缝间穿过去", "en": "I slip between your fingers."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只蛾在灯下等我。", "en": "Another moth waits by the lamp."},
        {"zh": "她的菱形纹在我眼前转", "en": "Her diamonds blur as she circles me."},
        {"zh": "她的菱形纹比我的清。", "en": "Her diamonds are sharper than mine."},
        {"zh": "我们并排落在叶上。", "en": "We land side by side on the leaf."},
        {"zh": "触角碰了一下。", "en": "Our antennae touch."},
        {"zh": "我们一起飞起来。", "en": "We lift off together."},
        {"zh": "她落在了后面。", "en": "She fell behind."},
        {"zh": "我又转回去。", "en": "I circled back."},
        {"zh": "她的翅膀上有我的影。", "en": "My shadow is on her wings."},
        {"zh": "我们朝田边飞去。", "en": "We head for the field's edge."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "叶上有一点东西。", "en": "There's a tiny bit of something on the leaf."},
        {"zh": "我落下去看了看。", "en": "I landed to look."},
        {"zh": "它不是吃的。", "en": "It isn't food."},
        {"zh": "我踩了一下。", "en": "I stepped on it once."},
        {"zh": "我的脚沾了粉。", "en": "Powder stuck to my feet."},
        {"zh": "我把它带起来一点。", "en": "I lifted a little of it."},
        {"zh": "这点东西拽得我往下沉", "en": "It drags me down, even this small."},
        {"zh": "我拍翅飞走了。", "en": "I beat my wings and left."},
        {"zh": "它粘在我的腿上。", "en": "It clings to my leg."},
        {"zh": "我抖了抖脚。", "en": "I shook my feet."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边的光在动。", "en": "The light over there moved."},
        {"zh": "我转了个弯。", "en": "I banked."},
        {"zh": "我朝着亮点飞。", "en": "I fly at the bright thing."},
        {"zh": "我的同伴也在。", "en": "Others of my kind are there too."},
        {"zh": "我加快扇翅。", "en": "I beat my wings faster."},
        {"zh": "我离它很近了。", "en": "I'm nearly there."},
        {"zh": "我看见那点光在晃", "en": "I see the little light swaying."},
        {"zh": "我找到一个落点。", "en": "I found a place to land."},
        {"zh": "风把它吹得晃。", "en": "The wind rocks it."},
        {"zh": "我要落下去了。", "en": "I'm coming down."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着它飞。", "en": "I fly after it."},
        {"zh": "它比我快一点。", "en": "It's a little faster."},
        {"zh": "我换个角度。", "en": "I take a different angle."},
        {"zh": "我的影子一直在追。", "en": "My shadow chases it too."},
        {"zh": "我扇得有点累。", "en": "My wings are tiring."},
        {"zh": "我又回到灯附近。", "en": "I'm back near the lamp."},
        {"zh": "它还在那片亮处。", "en": "It's still in that bright place."},
        {"zh": "我顺着光的边缘蹭过去", "en": "I edge along the rim of the light."},
        {"zh": "我停了一下。", "en": "I paused."},
        {"zh": "我又飞起来。", "en": "I'm off again."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一头撞了上去。", "en": "I butted into it head-first."},
        {"zh": "我被弹了回来。", "en": "I bounced off."},
        {"zh": "一团火差点烧到我。", "en": "A flame nearly caught me."},
        {"zh": "我的翅膀焦了一角。", "en": "A corner of my wing singed."},
        {"zh": "我在空中打转。", "en": "I spin in the air."},
        {"zh": "我落到地上，很狼狈。", "en": "I land on the ground, undignified."},
        {"zh": "我又爬了起来。", "en": "I right myself."},
        {"zh": "我用翅缘去刮你的手背。", "en": "I scrape the back of your hand with my wing edge."},
        {"zh": "它比我大太多。", "en": "It's far too big for me."},
        {"zh": "我退到枝上。", "en": "I retreat to a branch."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草丛里多了一点灰白。", "en": "A fleck of grey-white in the grass."},
        {"zh": "我从夜里飞出来。", "en": "I fly out of the night."},
        {"zh": "我的翅膀先亮了一下。", "en": "My wings catch the light first."},
        {"zh": "这地方有麦子。", "en": "There's wheat here."},
        {"zh": "我先是落在草尖上。", "en": "I land on a grass tip first."},
        {"zh": "另外几只也在附近。", "en": "A few others are nearby."},
        {"zh": "我扇了几下，试试风。", "en": "I flap a few times to test the air."},
        {"zh": "夜露有点重。", "en": "The night dew is heavy."},
        {"zh": "我开始绕着飞。", "en": "I start circling."},
        {"zh": "月光照在我的花纹上。", "en": "Moonlight falls on my pattern."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗一下就把我的翅膀卷了。", "en": "Flame curls my wings at once."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
