      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "露水沾住翅，我挣不开", "en": "Dew glues my wings down and I can't pull free."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀到田埂那头", "en": "The blast throws me clear to the field edge."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根细东西穿过了我的翅。", "en": "Something thin passes through my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "周围的光忽然全变了。", "en": "All the light around me changed."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我飞得越来越没力气。", "en": "My flying grows weaker."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "我的鳞粉被雷照得发亮", "en": "The lightning lights up every scale on me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有风，也没有草，只有黑。", "en": "No wind, no grass, only dark."}
      ]
    }
  }
}
