{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "青色的壳在风里荡。", "en": "My cyan casing swings in the breeze."},
        {"zh": "我不走路，只摆动。", "en": "No walking. Only swinging."},
        {"zh": "叶尖挑着我晃。", "en": "The leaf tip bounces me."},
        {"zh": "风一停我就静了。", "en": "When the wind stops, I go still."},
        {"zh": "丝把我吊得刚好。", "en": "The silk holds me at the right height."},
        {"zh": "丛林里一阵阵热气。", "en": "Heat pulses through the jungle."},
        {"zh": "我慢慢转过一点。", "en": "I rotated a fraction."},
        {"zh": "雨从叶隙落下来。", "en": "Rain falls through gaps in the leaves."},
        {"zh": "青色的斑在发亮。", "en": "My cyan patches catch the light."},
        {"zh": "一根丝撑着全部重量。", "en": "One thread bears all my weight."},
        {"zh": "我晃到叶子的另一侧。", "en": "I sway to the other side of the leaf."},
        {"zh": "空气厚得像水。", "en": "The air is thick as water."},
        {"zh": "我顺着叶脉滑了半寸。", "en": "I slid half an inch along the vein."},
        {"zh": "每次风过我都在转。", "en": "Every gust turns me."},
        {"zh": "青壳吊在一根丝上，风吹我转。", "en": "The cyan shell hangs from one thread; the wind turns me."},
        {"zh": "就挂在这里够了。", "en": "Hanging right here is enough."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "青色的我挂在那。", "en": "The cyan me hangs there."},
        {"zh": "壳上有细小的棱。", "en": "Fine ridges run over my casing."},
        {"zh": "里面正在重组。", "en": "Inside, I'm being rebuilt."},
        {"zh": "我听见叶子上有虫。", "en": "I hear insects on the leaf."},
        {"zh": "时间在壳外流过。", "en": "Time passes outside my shell."},
        {"zh": "翅膀在里面折好，我等着。", "en": "Wings folded inside; I wait."},
        {"zh": "青色的部分在变深。", "en": "The cyan is deepening."},
        {"zh": "丛林里全是湿声。", "en": "The jungle is all wet sounds."},
        {"zh": "壳里面很闷，可我不出声。", "en": "It is stuffy inside my shell, but I make no sound."},
        {"zh": "我数过三次日落。", "en": "I've counted three sunsets."},
        {"zh": "翅膀还在里面。", "en": "The wings are still inside."},
        {"zh": "再等等，快好了。", "en": "A little longer. Almost."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "青色在阴影里很扎眼。", "en": "Cyan stands out in shadow."},
        {"zh": "你为什么抬头看我？", "en": "Why are you looking up at me?"},
        {"zh": "我不像叶子吧。", "en": "I don't look like a leaf, do I."},
        {"zh": "这块壳很脆。", "en": "This casing is brittle."},
        {"zh": "你一动，我就晃。", "en": "When you move, I sway."},
        {"zh": "别抓这根丝。", "en": "Don't grab this thread."},
        {"zh": "我还没有翅膀。", "en": "I don't have wings yet."},
        {"zh": "再等几天吧。", "en": "Give me a few more days."},
        {"zh": "青色在叶影里，你偏要找我。", "en": "I am cyan in the leaf shade, and still you look for me."},
        {"zh": "青色的我不说话，只挂着。", "en": "I, the cyan one, say nothing; I only hang here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "青色的壳裂了一道。", "en": "A crack in my cyan casing."},
        {"zh": "我被撞得打转。", "en": "I spun from the blow."},
        {"zh": "里面的东西在挤。", "en": "Something's pressing inside."},
        {"zh": "丝线抖得厉害。", "en": "The silk is shaking hard."},
        {"zh": "一个角凹下去了。", "en": "One corner dented."},
        {"zh": "我快吊不住了。", "en": "I can barely hang on."},
        {"zh": "青壳上又添一道细纹。", "en": "Another hairline crack on the cyan shell."},
        {"zh": "别碰那道裂口。", "en": "Don't touch that crack."},
        {"zh": "只有壳在痛。", "en": "Only the shell hurts."},
        {"zh": "我会变完的。", "en": "I'll finish changing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不需要食物。", "en": "I don't need food."},
        {"zh": "这个阶段不吃。", "en": "Not in this stage."},
        {"zh": "这个你留着自己吃。", "en": "Keep it for yourself."},
        {"zh": "青色这层隔着所有气味。", "en": "This cyan layer shuts out every smell."},
        {"zh": "我的养分在里面。", "en": "My reserves are inside."},
        {"zh": "别把叶子扯下来。", "en": "Don't pull the leaf off."},
        {"zh": "青色一天天加深，别的做不了。", "en": "The cyan deepens day by day; nothing else I can do."},
        {"zh": "青色壳里没有嘴，你举多高都一样。", "en": "There is no mouth in this cyan shell; hold it as high as you like."},
        {"zh": "别摇这根枝，青壳会响。", "en": "Don't shake this branch; the cyan shell rattles."},
        {"zh": "那不是我该吃的。", "en": "That isn't mine to eat."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你一碰，我就转了半圈。", "en": "One touch spun me half around."},
        {"zh": "青色的壳撞到叶柄。", "en": "My cyan casing struck the stem."},
        {"zh": "丝线被拉得很直。", "en": "The silk pulled taut."},
        {"zh": "我荡回来又荡出去。", "en": "I swung back and out again."},
        {"zh": "别撞这片叶。", "en": "Don't hit this leaf."},
        {"zh": "我在半空中没法躲。", "en": "I can't dodge in midair."},
        {"zh": "这一下碰得挺实。", "en": "That was a solid bump."},
        {"zh": "我还好好地吊着。", "en": "Still hanging, just fine."},
        {"zh": "棱边磕了一下。", "en": "My ridge got a knock."},
        {"zh": "动静太大了。", "en": "That was too much noise."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "青色还没化开，谈不了这些。", "en": "This cyan hasn't melted open yet; not this."},
        {"zh": "青色还没散开。", "en": "The cyan hasn't unfolded yet."},
        {"zh": "等翅膀干了再说。", "en": "When my wings have dried."},
        {"zh": "这层壳隔开了我们。", "en": "This shell is between us."},
        {"zh": "你要等很久。", "en": "You'll wait a long while."},
        {"zh": "现在我什么都不是。", "en": "Right now I'm nothing at all."},
        {"zh": "等风季过去。", "en": "When the wet season passes."},
        {"zh": "别在我旁边等。", "en": "Don't wait beside me."},
        {"zh": "安安静静就好。", "en": "Quiet is quite enough."},
        {"zh": "以后会有答案。", "en": "There'll be an answer later."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "丝线之外，我什么都够不到。", "en": "Beyond my silk, I can reach nothing."},
        {"zh": "它在叶子背面上。", "en": "It's on the underside of the leaf."},
        {"zh": "它在叶背那头，我只剩眼睛。", "en": "It lies on the far side of the leaf; all I have are eyes."},
        {"zh": "它碰着我的丝。", "en": "It's touching my silk."},
        {"zh": "你先别去动它。", "en": "Don't move it just yet."},
        {"zh": "我连一条能抓的腿都没有。", "en": "I do not even have one leg to grab with."},
        {"zh": "露水把它粘住了。", "en": "The dew has glued it down."},
        {"zh": "我连嘴也没有。", "en": "I don't even have a mouth."},
        {"zh": "它会自己掉下去。", "en": "It'll fall on its own."},
        {"zh": "我只能试着伸。", "en": "I can only try to stretch."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有影子扫过来。", "en": "A shadow swept over me."},
        {"zh": "这动静比风重。", "en": "That sound is heavier than wind."},
        {"zh": "青色的我在发抖。", "en": "The cyan me is trembling."},
        {"zh": "有眼睛在树叶间。", "en": "There are eyes among the leaves."},
        {"zh": "我一点也逃不掉。", "en": "I can't flee at all."},
        {"zh": "壳收得更紧了。", "en": "My casing drew tighter."},
        {"zh": "叶子外面有翅膀在拍，比风重。", "en": "Wings beat beyond the leaf, heavier than wind."},
        {"zh": "不是蝴蝶的翅。", "en": "Not butterfly wings."},
        {"zh": "我把青壳缩到叶脉的凹陷里。", "en": "I shrink the cyan shell into the hollow of a vein."},
        {"zh": "它离这片叶很近。", "en": "It's close to this leaf."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "青色的壳像一片叶。", "en": "My cyan casing looks like a leaf."},
        {"zh": "我跟着影子转。", "en": "I turn with the shadow."},
        {"zh": "它还在那片叶上。", "en": "It's still on that leaf."},
        {"zh": "我屏住不动。", "en": "I hold perfectly still."},
        {"zh": "风吹得我轻轻晃。", "en": "The wind rocks me softly."},
        {"zh": "壳背朝着一侧。", "en": "I face my casing away."},
        {"zh": "我看不到它的全貌。", "en": "I can't see all of it."},
        {"zh": "它闻不到我。", "en": "It can't smell me."},
        {"zh": "青壳和叶子一块儿轻轻晃。", "en": "The cyan shell sways gently along with the leaf."},
        {"zh": "它往别处去了。", "en": "It moved elsewhere."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "青色的壳顶了一下。", "en": "My cyan casing pushed back once."},
        {"zh": "我一颗牙也没有。", "en": "I haven't a single tooth."},
        {"zh": "只有一层棱。", "en": "Only a ridge."},
        {"zh": "别把我捏碎了。", "en": "Don't crush me."},
        {"zh": "这一下是我全部。", "en": "That was all of me."},
        {"zh": "我撞不到谁。", "en": "I can't strike anyone."},
        {"zh": "壳缘有点利。", "en": "My casing edge is a little sharp."},
        {"zh": "我在半空乱摆。", "en": "I flail in the air."},
        {"zh": "我只能任人摆布。", "en": "All I can do is be handled."},
        {"zh": "我撑不开这层壳。", "en": "I can't break out of this."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一只毛虫选了这片叶。", "en": "A caterpillar chose this leaf."},
        {"zh": "青色就这样结出来。", "en": "The cyan formed like this."},
        {"zh": "叶背挂着一个壳。", "en": "A casing hangs under the leaf."},
        {"zh": "这在丛林里很常见。", "en": "Common enough in the jungle."},
        {"zh": "丝线已经结好了。", "en": "The silk is tied in place."},
        {"zh": "我在半阴处等了很久。", "en": "I waited long in half-shade."},
        {"zh": "青色的表面还软。", "en": "My cyan surface is still soft."},
        {"zh": "这层会慢慢变硬。", "en": "It will harden in time."},
        {"zh": "我又多了一天。", "en": "One more day for me."},
        {"zh": "空气很闷，很好。", "en": "Muggy air. Good."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热气把青色烤暗了。", "en": "Heat dulled my cyan."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚进了落叶里。", "en": "I rolled into the leaf litter."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "雨水灌进裂隙。", "en": "Rain leaked into the crack."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "整片叶都在震。", "en": "The whole leaf shook."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根细刺穿了过来。", "en": "A thin spike came through."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "壳内有什么在发光。", "en": "Something glows inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我体内的养分快完了。", "en": "My reserves are nearly gone."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷让整片叶都亮了。", "en": "The bolt lit the whole leaf."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我从丝上脱开了。", "en": "I came off the silk."}
      ]
    }
  }
}
