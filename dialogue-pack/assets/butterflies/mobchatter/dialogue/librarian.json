{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我夹着书，稳步走。", "en": "Book under my arm, I walk steadily."},
        {"zh": "去书架那边看看。", "en": "Off to check the shelves."},
        {"zh": "我把书按顺序排好。", "en": "I shelve books in order."},
        {"zh": "这页折角了，得理平。", "en": "A folded corner needs smoothing."},
        {"zh": "我走得轻，怕碰倒书堆。", "en": "Careful steps near the stacks."},
        {"zh": "有人借了书没还。", "en": "Someone never returned a book."},
        {"zh": "书脊上的字，我摸得出来。", "en": "I know the spines by touch."},
        {"zh": "我去找那本讲蝶的。", "en": "Off to find the butterfly volume."},
        {"zh": "村里安静，正好读书。", "en": "Quiet village — good for reading."},
        {"zh": "我一手扶书，一手扶门。", "en": "One hand on books, one on the door."},
        {"zh": "书架太挤，我侧身过。", "en": "Shelves too tight; I squeeze past."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我翻了一页，很轻。", "en": "I turn a page gently."},
        {"zh": "这本讲昆虫，插图不错。", "en": "This insect volume has fine plates."},
        {"zh": "墨还没干透。", "en": "The ink isn't dry."},
        {"zh": "我在抄一段。", "en": "I'm copying a passage."},
        {"zh": "书架要重新编号了。", "en": "The shelves need renumbering."},
        {"zh": "我咳嗽了一下，怕吵到人。", "en": "I cough softly, so as not to disturb."},
        {"zh": "午后的字，看着有点晃。", "en": "Afternoon letters waver before my eyes."},
        {"zh": "书页上有霉味。", "en": "A musty smell in the pages."},
        {"zh": "我把书合上，压平。", "en": "I close the book and press it flat."},
        {"zh": "这本，缺了一页。", "en": "This one is missing a page."},
        {"zh": "我在书脊上写字。", "en": "I write on the spine."},
        {"zh": "灯芯短了，光有点暗。", "en": "The wick is short; the light dims."},
        {"zh": "一叠纸，够我写很久。", "en": "A stack of paper lasts me a while."},
        {"zh": "外面有人叫卖。", "en": "Someone's hawking outside."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你要借书吗？", "en": "Borrowing a book?"},
        {"zh": "这些字，你认得几个？", "en": "How many of these words can you read?"},
        {"zh": "这本书，不外借。", "en": "This one doesn't leave the library."},
        {"zh": "你的手，洗了吗？", "en": "Are your hands clean?"},
        {"zh": "翻页的时候手要轻。", "en": "Handle the pages gently."},
        {"zh": "我这儿有讲蝴蝶的册子。", "en": "I have a volume on butterflies."},
        {"zh": "借书要还，按日子。", "en": "Borrowed books come back on time."},
        {"zh": "你身上有草屑。", "en": "There's grass on you."},
        {"zh": "抄本比原本便宜。", "en": "Copies cost less than originals."},
        {"zh": "你想找什么？", "en": "What are you looking for?"},
        {"zh": "这些书，我一本本抄的。", "en": "I copied these one by one."},
        {"zh": "书页不能折。", "en": "Don't fold the pages."},
        {"zh": "你说话小声些。", "en": "Lower your voice."},
        {"zh": "这本没有图，只有字。", "en": "No pictures in this one; only words."},
        {"zh": "我认得每个来借书的人。", "en": "I know everyone who borrows."},
        {"zh": "你要不要买一份图谱？", "en": "Buying an illustrated index?"},
        {"zh": "明天再来，今天要理书。", "en": "Come tomorrow; today I'm sorting."},
        {"zh": "别把书放窗边，会晒坏。", "en": "Not by the window; sun ruins them."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的书掉了。", "en": "My book fell."},
        {"zh": "眼镜摔歪了。", "en": "My glasses are bent."},
        {"zh": "哎，手被纸割了。", "en": "Ow — a paper cut."},
        {"zh": "我护着怀里的册子。", "en": "I shield the volume I hold."},
        {"zh": "这点伤，我先包上。", "en": "Let me bind this wound."},
        {"zh": "我退到书架后。", "en": "I retreat behind the shelves."},
        {"zh": "纸都皱了一角。", "en": "A corner of the paper is crumpled."},
        {"zh": "这一页沾了手印。", "en": "A thumbprint on this page."},
        {"zh": "我抱着书蹲下。", "en": "I crouch, holding the book."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不收那个，只收书。", "en": "I don't take that; only books."},
        {"zh": "纸比食物金贵。", "en": "Paper is dearer than food."},
        {"zh": "你拿吃食来换书？", "en": "Trading food for a book?"},
        {"zh": "这点东西，抵不上一册。", "en": "That won't match one volume."},
        {"zh": "绿宝石，我收。", "en": "Emeralds I take."},
        {"zh": "卷了角的书，我不换。", "en": "I don't trade for dog-eared books."},
        {"zh": "这本，值三颗。", "en": "Three emeralds for this one."},
        {"zh": "你出的太少了。", "en": "Your offer is too low."},
        {"zh": "成交，别折页。", "en": "Done — don't fold the pages."},
        {"zh": "你要是还回来，我再借。", "en": "Return it and I'll lend again."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，书会散。", "en": "Careful — the books will spill."},
        {"zh": "我扶住了书架。", "en": "I caught the shelf."},
        {"zh": "你踩到一页纸了。", "en": "You stepped on a page."},
        {"zh": "书掉了，我捡。", "en": "A book fell; I'll get it."},
        {"zh": "这过道太窄。", "en": "This aisle is too narrow."},
        {"zh": "我退到桌边。", "en": "I step back to the desk."},
        {"zh": "眼镜差点掉。", "en": "My glasses nearly fell."},
        {"zh": "我们慢慢错开。", "en": "Let's edge past slowly."},
        {"zh": "这一下，书签掉了。", "en": "A bookmark slipped out."},
        {"zh": "别推，架上有墨。", "en": "Don't push; there's ink on the shelf."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "她也爱读书。", "en": "She loves books too."},
        {"zh": "我们共用一个书架。", "en": "We share one shelf."},
        {"zh": "她读得比我快。", "en": "She reads faster than I."},
        {"zh": "灯下两个人，很安静。", "en": "Two by the lamp, very quiet."},
        {"zh": "她抄书，我装订。", "en": "She copies; I bind."},
        {"zh": "这本书，是我们一起写的。", "en": "We wrote this one together."},
        {"zh": "她不嫌我话少。", "en": "She doesn't mind my few words."},
        {"zh": "日子像书页，一页页过。", "en": "Days turn like pages."},
        {"zh": "别出声，她在看。", "en": "Quiet; she's reading."},
        {"zh": "有她在，屋里不冷。", "en": "With her, the room isn't cold."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一页掉在地上。", "en": "A page on the floor."},
        {"zh": "我夹进书里当书签。", "en": "I slip it in as a bookmark."},
        {"zh": "这本旧书，还能修。", "en": "This old book can be mended."},
        {"zh": "笔滚到桌下，我找。", "en": "A pen rolled under the desk."},
        {"zh": "纸角卷了，压平。", "en": "A curled corner; I flatten it."},
        {"zh": "这是谁的笔记？", "en": "Whose notes are these?"},
        {"zh": "我把它归到架上。", "en": "I shelve it where it belongs."},
        {"zh": "墨瓶倒了，可惜。", "en": "The ink spilled — a waste."},
        {"zh": "收好，别丢了。", "en": "Keep it safe; don't lose it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在书架前很久了。", "en": "You've stood by the shelf a while."},
        {"zh": "你想要哪一本？", "en": "Which one do you want?"},
        {"zh": "这本书不在架上。", "en": "That book isn't on the shelf."},
        {"zh": "我看看你的手。", "en": "Let me see your hands."},
        {"zh": "别把书塞进包里。", "en": "Don't slip books into your bag."},
        {"zh": "我数过册数。", "en": "I've counted the volumes."},
        {"zh": "你翻得太快。", "en": "You're turning pages too fast."},
        {"zh": "这页有你按的印子。", "en": "Your thumbprint is on this page."},
        {"zh": "我记住了这本的位置。", "en": "I know where this one belongs."},
        {"zh": "这一页你要赔。", "en": "You'll pay for this page."},
        {"zh": "别躲，我看见了。", "en": "Don't hide; I saw."},
        {"zh": "村里的守卫认识我。", "en": "The village guard knows me."},
        {"zh": "我先合上书。", "en": "I close the book first."},
        {"zh": "你最好解释清楚。", "en": "You had better explain."},
        {"zh": "这不是借书的态度。", "en": "That's no way to borrow."},
        {"zh": "我咳嗽一声。", "en": "I clear my throat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "书在桌上，没动。", "en": "The book's on the desk, untouched."},
        {"zh": "离书架退开一步。", "en": "One step back from the shelf."},
        {"zh": "这间屋子只有一个门。", "en": "Only one door in this room."},
        {"zh": "我的手按着书堆。", "en": "My hand is on the stack."},
        {"zh": "你越站越近。", "en": "You keep edging closer."},
        {"zh": "我数到三就不客气了。", "en": "On three I stop being polite."},
        {"zh": "灯火晃得我眼花。", "en": "The lamp makes my eyes swim."},
        {"zh": "你要是不还，我就喊。", "en": "If you don't return it, I'll call."},
        {"zh": "这页很脆，别扯。", "en": "The page is brittle; don't pull."},
        {"zh": "你还在犹豫什么？", "en": "What are you still hesitating over?"},
        {"zh": "我听见你翻包的声音。", "en": "I hear you rummaging in your bag."},
        {"zh": "把那一册放回去。", "en": "Put that volume back."},
        {"zh": "规矩不能破。", "en": "The rules hold."},
        {"zh": "最后说一次。", "en": "One last word."},
        {"zh": "我把书往怀里收。", "en": "I draw the book closer."},
        {"zh": "你要闹，就别怪我不客气。", "en": "Make a scene and I'll respond."},
        {"zh": "这局面不该发生。", "en": "This shouldn't be happening."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用书脊打过去！", "en": "I strike with a book's spine!"},
        {"zh": "别撕，那是孤本！", "en": "Don't tear it — that's the only copy!"},
        {"zh": "这一下，纸都飞了。", "en": "That sent pages flying."},
        {"zh": "我力气不大。", "en": "I'm not strong."},
        {"zh": "我拿笔当武器。", "en": "I use a pen as a weapon."},
        {"zh": "打完我喘个不停。", "en": "I'm gasping after that."},
        {"zh": "门外有脚步声。", "en": "Footsteps outside the door."},
        {"zh": "别碰那本旧的。", "en": "Not the old one."},
        {"zh": "我护住胸前的书。", "en": "I clutch the book to my chest."},
        {"zh": "这点伤，我还能站住。", "en": "I can still stand with this."},
        {"zh": "你走开，我不打第二下。", "en": "Leave; I won't swing twice."},
        {"zh": "书比我的手值钱。", "en": "The book is worth more than my hand."},
        {"zh": "我往角落退。", "en": "I retreat to the corner."},
        {"zh": "喊人了，快走。", "en": "I'm calling out — go."},
        {"zh": "我拿书挡了一下。", "en": "I block with a book."},
        {"zh": "这一下，把你推开了。", "en": "That shoved you back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我把书摊开来。", "en": "I spread the books out."},
        {"zh": "今天要清一批旧册。", "en": "A batch of old volumes to sort."},
        {"zh": "灯点上，屋里亮了。", "en": "Lamp lit, the room brightens."},
        {"zh": "空气里有纸的味道。", "en": "The air smells of paper."},
        {"zh": "我咳了两声，理理嗓子。", "en": "I cough twice and clear my throat."},
        {"zh": "架上落了些灰。", "en": "Dust has settled on the shelves."},
        {"zh": "我戴上眼镜。", "en": "I put on my glasses."},
        {"zh": "这本该放在哪？", "en": "Where does this one belong?"},
        {"zh": "村子今天很静。", "en": "The village is quiet today."},
        {"zh": "我把眼镜擦了擦。", "en": "I wipe my glasses clean."},
        {"zh": "书架第三层还空着。", "en": "The third shelf is still empty."},
        {"zh": "门口的风把纸吹动了。", "en": "The draft stirs the papers."},
        {"zh": "我数了数，少了两本。", "en": "I count them; two are missing."},
        {"zh": "这本的封面该换了。", "en": "This cover needs replacing."},
        {"zh": "我坐下，翻到今天。", "en": "I sit and open to today."},
        {"zh": "外面的光，照在书脊上。", "en": "Light falls across the spines."},
        {"zh": "我把纸裁成一样宽。", "en": "I trim the paper to even widths."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，纸边就卷。", "en": "Fire curls the paper's edge."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，书散了一地。", "en": "I fall; books scatter."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水泡烂了书页。", "en": "Water rots the pages."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把整架书掀翻。", "en": "The blast topples the whole shelf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过书的封面。", "en": "An arrow pierces a cover."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我看不清字。", "en": "That force blurs every letter."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，眼睛读不进字。", "en": "Hungry, the words won't register."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一闪，灯灭了。", "en": "A flash, and the lamp dies."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "书先掉下去，我随后。", "en": "The books fall first, then I."}
      ]
    }
  }
}
