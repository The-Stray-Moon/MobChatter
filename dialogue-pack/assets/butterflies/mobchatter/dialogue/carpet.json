{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着草尖飞。", "en": "I fly just over the grass tips."},
        {"zh": "翅膀扇得很轻。", "en": "My wings beat very lightly."},
        {"zh": "我从一片叶飞向另一片。", "en": "I fly from leaf to leaf."},
        {"zh": "矢车菊在前面，我过去。", "en": "Cornflowers ahead. I'm going."},
        {"zh": "我借着夜风，飞过湿地。", "en": "I ride the night wind across the marsh."},
        {"zh": "我绕了个小圈。", "en": "I loop in a small circle."},
        {"zh": "夜里的草地很安静。", "en": "The night meadow is quiet."},
        {"zh": "我的影子很小。", "en": "My shadow is tiny."},
        {"zh": "我飞得不高。", "en": "I don't fly high."},
        {"zh": "翼展不大，花心刚好够落。", "en": "My wingspan is small; a flower's heart fits."},
        {"zh": "翅膀上的粉沾了露水。", "en": "Dew clings to the scales on my wings."},
        {"zh": "我一跳一跳地换花。", "en": "I flit from bloom to bloom."},
        {"zh": "我在草叶之间穿梭。", "en": "I weave between grass blades."},
        {"zh": "月光下，没人看得见我。", "en": "By moonlight, no one sees me."},
        {"zh": "我沿着篱笆飞。", "en": "I fly along the fence."},
        {"zh": "我停了一下又起来。", "en": "I pause, then lift off again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在一朵花上不动。", "en": "I rest motionless on a flower."},
        {"zh": "翅膀一张一合。", "en": "My wings open and close."},
        {"zh": "夜风轻得刚好。", "en": "The night wind is very light."},
        {"zh": "我慢慢吸着花蜜。", "en": "I sip nectar slowly."},
        {"zh": "这一朵正好。", "en": "This one is just right."},
        {"zh": "我不打算再飞。", "en": "I don't plan to fly again yet."},
        {"zh": "花瓣轻轻摇。", "en": "The petals sway gently."},
        {"zh": "我把脚缩起来。", "en": "I draw my legs in."},
        {"zh": "这里的味道好。", "en": "It smells good here."},
        {"zh": "寿命不长，所以慢一点。", "en": "Life is short, so I take it slow."},
        {"zh": "我伏在花心。", "en": "I settle in the flower's heart."},
        {"zh": "就待一会儿。", "en": "Just a little while."},
        {"zh": "我听见远处的虫鸣。", "en": "I hear crickets far off."},
        {"zh": "花心是暖的。", "en": "The flower's heart is warm."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在矢车菊上，翅膀还开着。", "en": "I rest on a cornflower, wings still spread."},
        {"zh": "我只有这么大。", "en": "I'm only this big."},
        {"zh": "你别用手拍。", "en": "Don't swat at me."},
        {"zh": "一碰，我的翅膀就破。", "en": "One touch and my wing tears."},
        {"zh": "你手里的网是什么？", "en": "What's that net in your hand?"},
        {"zh": "我不会站着不动。", "en": "I won't just stand still."},
        {"zh": "你一伸手，我就起飞。", "en": "One reach from you and I'm airborne."},
        {"zh": "我的寿命很短，所以飞得急。", "en": "My life is short, so I fly in haste."},
        {"zh": "我往花后面躲。", "en": "I hide behind the flower."},
        {"zh": "你呼吸不要那么重。", "en": "Don't breathe so heavily."},
        {"zh": "我只是一只小蛾。", "en": "I'm only a little moth."},
        {"zh": "你的影子盖住矢车菊。", "en": "Your shadow covers the cornflower."},
        {"zh": "我沿着你的帽檐绕。", "en": "I loop around your hat brim."},
        {"zh": "你比花大太多了。", "en": "You're far bigger than a flower."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "夜风一吹，我的翅就撕裂", "en": "The night wind tears my wing."},
        {"zh": "我掉在草上。", "en": "I fell onto the grass."},
        {"zh": "你别一巴掌拍下来。", "en": "Don't swat me down."},
        {"zh": "这点伤，我就飞不动。", "en": "A wound this small and I can't fly."},
        {"zh": "我的粉掉了。", "en": "My scales came off."},
        {"zh": "我抖了抖，抖不起来。", "en": "I shivered my wings, but they won't lift."},
        {"zh": "你的巴掌太大了。", "en": "Your palm is far too large."},
        {"zh": "我还能爬两步。", "en": "I can still crawl a little."},
        {"zh": "我记住这阵风了。", "en": "I'll remember that gust."},
        {"zh": "花上沾了我的血。", "en": "My blood is on the flower."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是不是花？", "en": "Is that a flower?"},
        {"zh": "矢车菊的味道，我最喜欢。", "en": "Cornflower scent is my favorite."},
        {"zh": "你手上没有蜜吧。", "en": "There's no nectar on your hands."},
        {"zh": "别摇，花会掉。", "en": "Don't shake it. The petals will fall."},
        {"zh": "我不吃饼，只喝蜜。", "en": "I don't eat cake. I only drink nectar."},
        {"zh": "你把花放下就好。", "en": "Just put the flower down."},
        {"zh": "这朵看起来不错。", "en": "This one looks good."},
        {"zh": "矢车菊的甜味，引我过去。", "en": "The cornflower's sweetness pulls me in."},
        {"zh": "翅膀快要碰到花瓣了。", "en": "My wings are almost on the petals."},
        {"zh": "你的影子别压着它。", "en": "Don't let your shadow crush it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的手扫掉我的翅粉。", "en": "Your hand swept off my scales."},
        {"zh": "我翻了个身。", "en": "I flipped over once."},
        {"zh": "翅尖折了一小块。", "en": "A tip of my wing folded."},
        {"zh": "别用手指弹。", "en": "Don't flick with your finger."},
        {"zh": "我掉到草叶上。", "en": "I dropped onto a grass blade."},
        {"zh": "我又飞起来了。", "en": "I'm flying again."},
        {"zh": "你撞得花瓣落了。", "en": "Your bump knocked off petals."},
        {"zh": "我在你面前停不稳。", "en": "I can't hold steady in front of you."},
        {"zh": "风帮我飞开了一点。", "en": "The wind carried me a bit away."},
        {"zh": "我翅膀上沾了你的味。", "en": "Your scent is on my wings."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "花上还有另一只。", "en": "There's another on the flower."},
        {"zh": "我们在半空相遇。", "en": "We meet in midair."},
        {"zh": "你别拍手啊。", "en": "Don't clap."},
        {"zh": "我们绕着同一朵花。", "en": "We circle the same flower."},
        {"zh": "翅膀碰了一下。", "en": "Our wings touched."},
        {"zh": "卵会产在叶上。", "en": "The eggs will go on the leaves."},
        {"zh": "毛虫只吃叶子。", "en": "The caterpillars eat only leaves."},
        {"zh": "那之后就没有我了。", "en": "After that, there's no more of me."},
        {"zh": "风会带走这些。", "en": "The wind will carry it all away."},
        {"zh": "夜里，这样就好。", "en": "At night, this is enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我搬不动东西。", "en": "I can't carry things."},
        {"zh": "蜜在花里，不在手里。", "en": "Nectar is in flowers, not in hands."},
        {"zh": "你掉的花瓣，我看看。", "en": "Let me see the petal you dropped."},
        {"zh": "这东西太重了。", "en": "It's too heavy."},
        {"zh": "我用脚勾了一下。", "en": "I hooked it with a foot."},
        {"zh": "这点东西，够我站一会。", "en": "Enough for me to perch a moment."},
        {"zh": "我落在上面。", "en": "I land on it."},
        {"zh": "那滴花蜜，是我先看见的。", "en": "I saw that drop of nectar first."},
        {"zh": "它挡住了花。", "en": "It's blocking the flower."},
        {"zh": "我这就飞走。", "en": "I'm flying off."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那朵花开着。", "en": "That flower is open."},
        {"zh": "蜜的味道在那边。", "en": "The nectar smell is over there."},
        {"zh": "我绕过去看看。", "en": "I'll go around and look."},
        {"zh": "风正好帮我。", "en": "The wind is helping me."},
        {"zh": "我扇快一点。", "en": "I beat my wings faster."},
        {"zh": "花就在前面。", "en": "The flower is just ahead."},
        {"zh": "别的先不管。", "en": "Nothing else matters now."},
        {"zh": "我压低身子飞。", "en": "I fly low."},
        {"zh": "叶子上有东西在动。", "en": "Something's moving on the leaves."},
        {"zh": "我得绕开它。", "en": "I need to go around it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢靠近花心。", "en": "I approach the flower's heart."},
        {"zh": "花瓣离我很近。", "en": "The petals are very near."},
        {"zh": "风又把我吹开。", "en": "The wind pushes me off again."},
        {"zh": "我再试一次。", "en": "I'll try again."},
        {"zh": "这次从上面落。", "en": "This time I come from above."},
        {"zh": "我悬停了一下。", "en": "I hover a moment."},
        {"zh": "花蜜就在那儿。", "en": "The nectar is right there."},
        {"zh": "我把脚伸出去。", "en": "I extend my legs."},
        {"zh": "就快碰到了。", "en": "Almost touching it."},
        {"zh": "这一下成了。", "en": "Got it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会打人。", "en": "I don't fight."},
        {"zh": "我的翅膀打到你脸。", "en": "My wings hit your face."},
        {"zh": "那只是翅风。", "en": "That's only wing-wind."},
        {"zh": "我小得像块毛毡，你差点没看见。", "en": "I'm small as felt — you nearly missed me."},
        {"zh": "我这么轻，什么也挡不住。", "en": "I'm so light I can't stop anything."},
        {"zh": "我退开了一点。", "en": "I retreated a little."},
        {"zh": "我撞向你，翅上的粉撒了一路。", "en": "I ram you, scattering wing dust along the way."},
        {"zh": "我的翅膀疼。", "en": "My wings hurt."},
        {"zh": "你连动都没动。", "en": "You didn't even move."},
        {"zh": "我还是飞走吧。", "en": "I'll just fly away."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "茧壳在我身后裂开。", "en": "The cocoon split behind me."},
        {"zh": "翅膀还是软的。", "en": "My wings are still soft."},
        {"zh": "我慢慢把它们摊开。", "en": "I slowly spread them out."},
        {"zh": "矢车菊就在下面。", "en": "Cornflowers below me."},
        {"zh": "现在是夜里，正好。", "en": "It's night now. Perfect."},
        {"zh": "我第一次飞。", "en": "This is my first flight."},
        {"zh": "我落在最近的花上。", "en": "I land on the nearest flower."},
        {"zh": "夜里的湿地，绒毛全湿。", "en": "Night wetlands — my fuzz is soaked."},
        {"zh": "这里的花很多。", "en": "There are many flowers here."},
        {"zh": "我的命不长，要快些。", "en": "My life is short. I must hurry."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一靠近，翅膀就卷。", "en": "The fire neared and my wings curled."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从花上掉下来，还好有草。", "en": "I fell from the flower into the grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "露水太多了，我动不了。", "en": "Too much dew. I can't move."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀到很远的地方。", "en": "The blast threw me far away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭尖擦过我的鳞翅，掉了粉。", "en": "The arrow grazes my scaled wing and knocks off dust."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光打过来，我的眼睛花了。", "en": "The light hit and my eyes went blurry."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "花都谢了，我没有蜜喝。", "en": "The flowers closed. No nectar for me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "闪电一下照亮整片草地。", "en": "A flash lit the whole meadow."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有风，也没有花。", "en": "No wind here, and no flowers."}
      ]
    }
  }
}
