{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着叶脉爬。", "en": "I crawl along the leaf veins."},
        {"zh": "我一口一口啃过去。", "en": "I chew my way along."},
        {"zh": "我啃出一条路，叶子越来越薄。", "en": "I chew a path, and the leaf grows thinner."},
        {"zh": "叶缘被我咬出缺口。", "en": "I notch the leaf's edge."},
        {"zh": "我换个方向再咬。", "en": "I turn and bite again."},
        {"zh": "我的脚吸住叶面。", "en": "My feet cling to the leaf."},
        {"zh": "我爬到了叶子的背面。", "en": "I crawl to the leaf's underside."},
        {"zh": "我绕过叶脉的硬处。", "en": "I go around the tough veins."},
        {"zh": "叶子的汁水沾了我一脸。", "en": "Leaf sap smears my face."},
        {"zh": "我从一片叶爬到另一片。", "en": "I crawl leaf to leaf."},
        {"zh": "我把自己缩成一团往前。", "en": "I push forward bunched up."},
        {"zh": "我停在叶尖上张望。", "en": "I stop at the leaf tip to look."},
        {"zh": "我拖着一小截残叶。", "en": "I drag a scrap of leaf."},
        {"zh": "我的身子温热，叶子发凉。", "en": "I'm warm, the leaf is cool."},
        {"zh": "我咬穿了一道叶脉。", "en": "I gnaw through a vein."},
        {"zh": "我慢慢挪到有光的一侧。", "en": "I creep to the sunlit side."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在叶脉上不动。", "en": "I lie still on the vein."},
        {"zh": "阳光透过叶子，照在我背上。", "en": "Sunlight through the leaf warms my back."},
        {"zh": "我的身体有一节节纹。", "en": "My body wears rings of stripes."},
        {"zh": "我在嚼上一口叶子。", "en": "I'm chewing the last bite."},
        {"zh": "叶子下面很凉。", "en": "It's cool under the leaf."},
        {"zh": "我一动不动装成叶卷。", "en": "I hold still, disguised as a leaf curl."},
        {"zh": "我听见鸟在附近。", "en": "I hear a bird nearby."},
        {"zh": "我在叶脉上，数自己剩几节。", "en": "On the leaf vein, I count my remaining segments."},
        {"zh": "我在长，一天比一天粗。", "en": "I'm growing thicker by the day."},
        {"zh": "我的脚慢慢挪了挪。", "en": "My feet shift a little."},
        {"zh": "我在等这一片叶吃完。", "en": "I wait to finish this leaf."},
        {"zh": "阳光暖到我的背上。", "en": "Sun warms my back."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你别碰这片叶子。", "en": "Don't touch this leaf."},
        {"zh": "这片叶子，够我吃到蜕皮。", "en": "This leaf will feed me until I molt."},
        {"zh": "你把我托起来了。", "en": "You've lifted me up."},
        {"zh": "离开叶子我会死。", "en": "Off a leaf, I'll die."},
        {"zh": "你手上有叶子的味。", "en": "Your hand smells of leaves."},
        {"zh": "把我放回树上吧。", "en": "Put me back on the tree."},
        {"zh": "我一抬头就够到你。", "en": "I raise my head and reach you."},
        {"zh": "别把我放在石头上。", "en": "Don't set me on stone."},
        {"zh": "我很小，但很饿。", "en": "I'm small, but very hungry."},
        {"zh": "你要带我去哪？", "en": "Where are you taking me?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体被压了一下。", "en": "My body got pressed."},
        {"zh": "我吐出了一点体液。", "en": "Some fluid leaks from me."},
        {"zh": "我蜷起来，叶片都被我压弯。", "en": "I curl up, bending the leaf under me."},
        {"zh": "这片叶子，我啃了一半。", "en": "I have chewed half this leaf."},
        {"zh": "我咬着的叶子掉了。", "en": "The leaf I held slipped away."},
        {"zh": "我只吃叶子，别的不碰。", "en": "I eat only leaves, nothing else."},
        {"zh": "我的脚被压平了。", "en": "My feet are flattened."},
        {"zh": "我往叶脉下面躲。", "en": "I hide under a vein."},
        {"zh": "我饿了，但动不了。", "en": "I'm hungry, but I can't move."},
        {"zh": "快放我回树上。", "en": "Put me back on the tree soon."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是叶子吗？", "en": "Is that a leaf?"},
        {"zh": "拿过来，我要吃。", "en": "Bring it here, I'll eat."},
        {"zh": "这味道好新鲜。", "en": "That smells so fresh."},
        {"zh": "我伸出前半身。", "en": "I stretch my front half out."},
        {"zh": "放我嘴边吧。", "en": "Put it by my mouth."},
        {"zh": "我只需要叶子。", "en": "I need only leaves."},
        {"zh": "这片的边很嫩。", "en": "The edge of this one is tender."},
        {"zh": "我一口就咬下去。", "en": "I'll bite straight in."},
        {"zh": "这片叶子你拿稳，我才敢爬。", "en": "Hold that leaf steady, and I will crawl."},
        {"zh": "再给一片。", "en": "One more leaf."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被碰得滚了一下。", "en": "The bump rolled me over."},
        {"zh": "我的脚离了叶面。", "en": "My feet left the leaf."},
        {"zh": "你碰了我的背脊。", "en": "You touched my back."},
        {"zh": "我赶紧咬住叶缘。", "en": "I clamp onto the leaf's edge."},
        {"zh": "我掉到下面一层叶子。", "en": "I dropped to a leaf below."},
        {"zh": "别按我。", "en": "Don't press me down."},
        {"zh": "我的身体很软。", "en": "My body is soft."},
        {"zh": "你踩到了卷起的叶。", "en": "You stepped on a curled leaf."},
        {"zh": "我用腹足贴紧叶面，滑到背面。", "en": "I cling with my prolegs and slide under the leaf."},
        {"zh": "这点碰撞我就躲起来。", "en": "At that bump I hide."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还是条毛虫。", "en": "I'm still a caterpillar."},
        {"zh": "等我变成蝶。", "en": "Wait until I'm a butterfly."},
        {"zh": "我要先吃饱。", "en": "I need to eat my fill first."},
        {"zh": "叶子比这重要。", "en": "Leaves matter more."},
        {"zh": "毛虫之间，隔着两片叶就好。", "en": "Two leaves apart is close enough for caterpillars."},
        {"zh": "我现在只想吃。", "en": "I only want to eat now."},
        {"zh": "树上还有别的虫。", "en": "There are other grubs on the tree."},
        {"zh": "我还没长出翅膀，谈什么伴侣。", "en": "I have no wings yet; what partner?"},
        {"zh": "我要去结蛹了。", "en": "I'm going to make my chrysalis."},
        {"zh": "让开，我饿了。", "en": "Move, I'm hungry."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一片嫩叶，正好。", "en": "A tender leaf, perfect."},
        {"zh": "我从叶缘咬进去。", "en": "I bite in from the edge."},
        {"zh": "这一口太老了。", "en": "This bite is too tough."},
        {"zh": "我挪到更嫩的地方。", "en": "I move to a tenderer spot."},
        {"zh": "我把叶子卷起来。", "en": "I curl the leaf around me."},
        {"zh": "这点够我吃半天。", "en": "Enough for half a day."},
        {"zh": "我把脸埋进叶里。", "en": "I bury my face in the leaf."},
        {"zh": "有人替我搬了叶子。", "en": "Someone moved a leaf for me."},
        {"zh": "这片被虫咬过。", "en": "This one's already been chewed."},
        {"zh": "我选最新鲜的那片。", "en": "I pick the freshest one."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那片叶子归我。", "en": "That leaf is mine."},
        {"zh": "我慢慢朝它爬。", "en": "I crawl slowly toward it."},
        {"zh": "叶脉挡住了我。", "en": "A vein blocks my way."},
        {"zh": "我要把这一片吃干净。", "en": "I'll strip this one bare."},
        {"zh": "我不喜欢硬叶子。", "en": "I dislike tough leaves."},
        {"zh": "有别的毛虫在那边。", "en": "Another caterpillar is over there."},
        {"zh": "湿地这片叶子，我要吃到结蛹。", "en": "I will eat this wetland leaf until I pupate."},
        {"zh": "这味道正好。", "en": "This tastes just right."},
        {"zh": "我挪了半个身子过去。", "en": "I shift half my body over."},
        {"zh": "别抢我嘴边的。", "en": "Don't take mine."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着叶缘往下爬。", "en": "I creep down the leaf's edge."},
        {"zh": "这一片我吃得完。", "en": "I can finish this one."},
        {"zh": "我数着剩下的叶脉。", "en": "I count the remaining veins."},
        {"zh": "我抬头看了看枝子。", "en": "I lift my head to the twig."},
        {"zh": "下一片在对面。", "en": "The next leaf is opposite."},
        {"zh": "我咬开一条路。", "en": "I chew a path through."},
        {"zh": "风把叶子吹歪了。", "en": "The wind tilts the leaf."},
        {"zh": "我得抓牢叶面。", "en": "I must hold the leaf fast."},
        {"zh": "我再爬两寸。", "en": "Two more inches."},
        {"zh": "够到了。", "en": "Reached it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有牙能咬你。", "en": "My jaws can't hurt you."},
        {"zh": "我咬的是叶子。", "en": "I bite leaves, not you."},
        {"zh": "你手指上有我的口沫。", "en": "My spit is on your finger."},
        {"zh": "我撞了你一下就缩。", "en": "I bump you and shrink back."},
        {"zh": "我昂起头，吐出一缕丝。", "en": "I rear up and spin a thread."},
        {"zh": "这点力气伤不了谁。", "en": "This much can hurt no one."},
        {"zh": "我只好换个地方。", "en": "I'll move elsewhere."},
        {"zh": "我要躲进叶卷里。", "en": "I'll hide in a leaf curl."},
        {"zh": "别把我从叶上拿走。", "en": "Don't take me off this leaf."},
        {"zh": "我一缩就成了团。", "en": "One curl and I'm a ball."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从卵里爬出来。", "en": "I hatch from the egg."},
        {"zh": "第一件事就是吃。", "en": "First thing: eat."},
        {"zh": "我在叶背咬开一个小口。", "en": "I nibble a hole in the leaf's back."},
        {"zh": "风把我吹到别的叶上。", "en": "The wind blows me to another leaf."},
        {"zh": "我抬脚试了试叶面。", "en": "I test the leaf with my feet."},
        {"zh": "平原的叶子很厚。", "en": "Plains leaves are thick."},
        {"zh": "湿地叶子潮得很。", "en": "Marsh leaves are damp."},
        {"zh": "我找了个安静的角落。", "en": "I find a quiet corner."},
        {"zh": "我开始咬第一口。", "en": "I take my first bite."},
        {"zh": "我还不大，但很能吃。", "en": "I'm small, but I can eat."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一靠，我就卷起来了。", "en": "Fire near, and I curl up."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶上掉下去，摔在土上。", "en": "I fall from the leaf into dirt."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水泡软了我。", "en": "Water softens me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀出叶子。", "en": "The blast throws me off the leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西扎穿了我的身体。", "en": "That went through my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光一闪，我整条都僵了。", "en": "A flash and I go rigid."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有叶子，我在变软。", "en": "No leaves, and I grow limp."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打中树，我缩了起来。", "en": "Lightning hits the tree and I clench."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有叶子可吃。", "en": "No leaf to eat in the void."}
      ]
    }
  }
