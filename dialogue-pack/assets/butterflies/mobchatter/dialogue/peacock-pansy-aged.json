{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀已经旧了。", "en": "My wings have grown old."},
        {"zh": "我飞得很慢，但稳。", "en": "I fly slowly, but steadily."},
        {"zh": "翅边的缺口，看得见。", "en": "You can see the notches at my wing edges."},
        {"zh": "我掠过一朵兰花。", "en": "I pass over an orchid."},
        {"zh": "我不想飞太远。", "en": "I do not care to fly far."},
        {"zh": "这一片，我飞了半辈子。", "en": "I have flown this patch half my life."},
        {"zh": "我在叶间穿过。", "en": "I weave between the leaves."},
        {"zh": "风一大，我就落下。", "en": "When the wind picks up, I come down."},
        {"zh": "我的颜色淡了。", "en": "My colors have faded."},
        {"zh": "我停在花上喘口气。", "en": "I stop on a flower to catch my breath."},
        {"zh": "我沿着旧路飞。", "en": "I fly the old route."},
        {"zh": "这一趟比上一趟慢。", "en": "This trip is slower than the last."},
        {"zh": "翅粉掉了不少。", "en": "Much of my wing dust is gone."},
        {"zh": "我落在树皮上歇歇。", "en": "I rest on the bark a while."},
        {"zh": "再飞一段，就差不多了。", "en": "One more stretch and that will be it."},
        {"zh": "日光正合适。", "en": "The daylight is just right."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停着，翅膀慢慢开合。", "en": "I rest, opening and closing my wings."},
        {"zh": "我老了，动作也慢。", "en": "I am old, and slower for it."},
        {"zh": "兰花还在那儿。", "en": "The orchid is still there."},
        {"zh": "老翅膀晒久了才飞得动。", "en": "Old wings need sun before they fly."},
        {"zh": "我数着剩下的日子。", "en": "I am counting what days are left."},
        {"zh": "翅面上有几个斑点。", "en": "There are a few spots on my wings."},
        {"zh": "一天飞一朵花就够了。", "en": "One flower a day is enough."},
        {"zh": "这里的风很轻。", "en": "The wind is light here."},
        {"zh": "我合上翅膀。", "en": "I fold my wings."},
        {"zh": "我在听树叶。", "en": "I am listening to the leaves."},
        {"zh": "这一朵够我待很久。", "en": "This one bloom will hold me a long while."},
        {"zh": "天还亮着。", "en": "It is still light."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我认得你，上次也是你。", "en": "I know you; you came before."},
        {"zh": "我飞得慢了，你追得上。", "en": "I fly slower now. You could catch me."},
        {"zh": "别急着伸手。", "en": "Do not reach out so quickly."},
        {"zh": "你看我的翅膀，旧了。", "en": "Look at my wings. They are worn."},
        {"zh": "我在你旁边停下。", "en": "I stop beside you."},
        {"zh": "我的翅，边缘磨旧了。", "en": "The edges of my wings have worn old."},
        {"zh": "我不躲你。", "en": "I do not hide from you."},
        {"zh": "这一路，我累了。", "en": "I am tired from the road."},
        {"zh": "你要看就看吧。", "en": "Look, if you like."},
        {"zh": "我已经没什么可怕的。", "en": "There is little left that frightens me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了下来。", "en": "I fell."},
        {"zh": "翅上又裂了一道。", "en": "Another tear in my wing."},
        {"zh": "我在地上爬。", "en": "I crawl on the ground."},
        {"zh": "这点伤，我怕撑不住。", "en": "This wound I may not survive."},
        {"zh": "我抖了抖翅。", "en": "I shake my wings."},
        {"zh": "我的翅已经褪了色。", "en": "My wings have faded."},
        {"zh": "让我歇一会儿。", "en": "Let me rest a moment."},
        {"zh": "我慢慢爬回花上。", "en": "I crawl slowly back onto a flower."},
        {"zh": "颜色又淡了一点。", "en": "My color has faded a little more."},
        {"zh": "翅边的颜色已经淡了。", "en": "The color along my wing edge has faded."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "是兰花吗。", "en": "Is that an orchid?"},
        {"zh": "我已经吃不多了。", "en": "I cannot eat much anymore."},
        {"zh": "你举低一点。", "en": "Hold it lower."},
        {"zh": "这味道很熟。", "en": "That smell is familiar."},
        {"zh": "我一寸一寸挪向甜味。", "en": "I inch toward the sweetness."},
        {"zh": "翅膀一收，落下来了。", "en": "Wings folded. Landed."},
        {"zh": "我的翅膀旧了，花纹还清楚。", "en": "My wings are old; the pattern still shows."},
        {"zh": "这一口够我歇半天。", "en": "One sip is enough to rest on."},
        {"zh": "我还能再飞一段。", "en": "I can still fly a while longer."},
        {"zh": "留在那儿吧。", "en": "Leave it there."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我的翅缘，掉粉了。", "en": "You brushed my wing edge; dust fell."},
        {"zh": "我被撞得偏了，才稳住。", "en": "The bump tilted me before I steadied."},
        {"zh": "我的翅膀薄，禁不起。", "en": "My wings are thin and cannot take it."},
        {"zh": "我落在草上。", "en": "I land in the grass."},
        {"zh": "我从草丛里慢慢升空。", "en": "I rise slowly out of the grass."},
        {"zh": "这一下，掉了几片粉。", "en": "A few scales fell from that."},
        {"zh": "别推。", "en": "Do not push."},
        {"zh": "我还稳得住。", "en": "I am still steady."},
        {"zh": "你再慢一点。", "en": "Slow down a little."},
        {"zh": "让我先过去。", "en": "Let me pass first."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经过了那时候。", "en": "My time for that is past."},
        {"zh": "同伴还在花上。", "en": "A companion is still on the flower."},
        {"zh": "老去的翅色，反而更深。", "en": "An aged pattern only deepens."},
        {"zh": "它的翅也旧了。", "en": "Its wings are worn too."},
        {"zh": "我翅上的眼斑已经淡了。", "en": "The eyespots on my wings have faded."},
        {"zh": "太阳落下去之前，还有一会儿。", "en": "There is a little while before the sun sets."},
        {"zh": "我们都飞不高了。", "en": "Neither of us flies high now."},
        {"zh": "这样挺好。", "en": "This is fine."},
        {"zh": "明天也许还见。", "en": "Perhaps we meet tomorrow."},
        {"zh": "也许不见。", "en": "Perhaps not."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "那片红是落叶，不是花。", "en": "That red is a fallen leaf, not a bloom."},
        {"zh": "我停在它上面。", "en": "I land on top of it."},
        {"zh": "太滑，站不住。", "en": "Too smooth to stand on."},
        {"zh": "我用褪色的翅拨开落叶。", "en": "I push the leaf aside with faded wings."},
        {"zh": "它挡住了一朵兰花。", "en": "It is covering an orchid."},
        {"zh": "我飞不起来，被压住了。", "en": "I cannot lift off. It is holding me."},
        {"zh": "你捡吧，我抓不住。", "en": "Take it; my grip is gone."},
        {"zh": "我只要花。", "en": "I want only flowers."},
        {"zh": "东西从我的细腿间滑落。", "en": "It slips between my thin legs."},
        {"zh": "我不管它。", "en": "I pay it no mind."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有一朵。", "en": "There is one over there."},
        {"zh": "翅膀一停，我就看见了。", "en": "My wings stopped — I see it."},
        {"zh": "我转过身，翅尖有点破。", "en": "I turn, wingtips frayed."},
        {"zh": "这距离，我还飞得动。", "en": "I can still manage that distance."},
        {"zh": "风帮了我一下。", "en": "The wind helped me."},
        {"zh": "就是那朵。", "en": "That one."},
        {"zh": "风变了，我调头。", "en": "The wind shifted; I turn."},
        {"zh": "别挡着。", "en": "Do not block it."},
        {"zh": "我慢慢朝那朵花挪。", "en": "I drift slowly toward that flower."},
        {"zh": "不远。", "en": "Not far."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我还在飞。", "en": "I am still flying."},
        {"zh": "我飞得慢，但方向没错。", "en": "Slow wings, but the heading is right."},
        {"zh": "风有点乱。", "en": "The wind is unsteady."},
        {"zh": "我落下又起来。", "en": "I dip and rise again."},
        {"zh": "翅有点酸。", "en": "My wing aches."},
        {"zh": "再坚持一下。", "en": "A little more."},
        {"zh": "那朵花在动。", "en": "That flower is moving."},
        {"zh": "是风。", "en": "It is the wind."},
        {"zh": "我就快到了。", "en": "Nearly there."},
        {"zh": "那朵花就在眼前了。", "en": "The flower is right before me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有力气打。", "en": "I have no strength to fight."},
        {"zh": "我撞了一下，很轻。", "en": "I bumped it. Very lightly."},
        {"zh": "它把我拍开了。", "en": "It swatted me away."},
        {"zh": "我在草里翻了身。", "en": "I rolled over in the grass."},
        {"zh": "翅膀上有个口子。", "en": "There is a tear in my wing."},
        {"zh": "我抬起翅膀，费了半天劲。", "en": "I lift my wings with great effort."},
        {"zh": "这点力气，我留着飞。", "en": "I keep my strength for flying."},
        {"zh": "我没打中。", "en": "I missed."},
        {"zh": "我老了，翅上的粉都掉了。", "en": "I'm old; the dust is gone from my wings."},
        {"zh": "我扇不动了，先歇着。", "en": "I cannot beat my wings; I rest."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我落在这一朵上。", "en": "I settle on this bloom."},
        {"zh": "阳光正好。", "en": "The sun is just right."},
        {"zh": "我飞了很远才到。", "en": "I flew a long way to get here."},
        {"zh": "这里没有我记得的树。", "en": "The trees here are not the ones I remember."},
        {"zh": "我又老了一点。", "en": "I am a little older."},
        {"zh": "翅粉落了一地。", "en": "My scales dust the ground."},
        {"zh": "风把我送过来的。", "en": "The wind carried me here."},
        {"zh": "这儿有兰花。", "en": "There are orchids here."},
        {"zh": "我先歇一下。", "en": "Let me rest first."},
        {"zh": "再往前，就是新地方了。", "en": "Further on is new ground."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一下就把我的翅卷了。", "en": "The flame curls my wing at once."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从半空掉到土上。", "en": "I drop from the air onto the soil."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我的翅粘住了。", "en": "Water glues my wings together."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹得老远。", "en": "The blast blows me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西穿了我的翅。", "en": "Something pierced my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀忽然沉了。", "en": "My wings suddenly grew heavy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我找不到能吃的花。", "en": "I cannot find a flower to feed on."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "白光一闪，我的翅就焦了。", "en": "One white flash and my wing is singed."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有阳光，也没有花。", "en": "No sunlight here, and no flowers."}
      ]
    }
  }
}
