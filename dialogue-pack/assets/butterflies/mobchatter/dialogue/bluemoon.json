{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑扇着往前", "en": "I flap my way forward."},
        {"zh": "翅膀上有一圈蓝", "en": "A ring of blue on my wings."},
        {"zh": "我在树影间穿行", "en": "I weave through tree shadows."},
        {"zh": "我贴着花丛飞", "en": "I skim along the flowerbeds."},
        {"zh": "我飞得不算快", "en": "I do not fly fast."},
        {"zh": "我的翅膀很大", "en": "My wings are large."},
        {"zh": "我绕着树干转", "en": "I circle a tree trunk."},
        {"zh": "我落在绒球葱上", "en": "I land on an allium."},
        {"zh": "我又起飞了", "en": "I take off again."},
        {"zh": "我在光斑里穿行", "en": "I pass through patches of light."},
        {"zh": "翅膀一张一合", "en": "My wings open and close."},
        {"zh": "风把我托起来", "en": "The wind lifts me."},
        {"zh": "我从叶间钻过去", "en": "I slip between leaves."},
        {"zh": "我沿着林间小路飞", "en": "I follow the forest path."},
        {"zh": "我换了方向", "en": "I change direction."},
        {"zh": "我向高处去", "en": "I head higher."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在花上", "en": "I rest on a flower."},
        {"zh": "白天才是我活动的时候", "en": "The day is my time."},
        {"zh": "我轻轻合翅", "en": "I close my wings gently."},
        {"zh": "阳光晒在鳞粉上", "en": "Sun falls on my scales."},
        {"zh": "这片森林很安静", "en": "This forest is quiet."},
        {"zh": "我的翅膀合上像片叶", "en": "Folded, my wings look like a leaf."},
        {"zh": "我又爬上更高一朵花", "en": "I climb onto a higher bloom."},
        {"zh": "风一停我就轻了", "en": "When the wind stops I feel light."},
        {"zh": "我只有几天可活", "en": "I have only days to live."},
        {"zh": "我在找下一朵花", "en": "I am looking for the next flower."},
        {"zh": "树下有一片光", "en": "There is a patch of light below."},
        {"zh": "我慢慢把翅膀摊开", "en": "I slowly spread my wings."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站着像棵树", "en": "You stand like a tree."},
        {"zh": "你挪开一点，这朵花是我的。", "en": "Shift a little; this flower is mine."},
        {"zh": "我不过是来采蜜，不碰你。", "en": "I'm only here for nectar; I won't touch you."},
        {"zh": "手别挥，我落一下就走。", "en": "Don't wave; I'll land for a moment and go."},
        {"zh": "我落一下就走", "en": "I will land a moment and go."},
        {"zh": "你的颜色太艳", "en": "Your colors are too loud."},
        {"zh": "我在你肩上歇一会", "en": "I will rest on your shoulder a while."},
        {"zh": "你手张开试试", "en": "Try holding your hand open."},
        {"zh": "你身上有花的味道", "en": "You smell of flowers."},
        {"zh": "我飞得很近", "en": "I am flying close."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀破了一点", "en": "A bit of my wing tore."},
        {"zh": "我掉到花丛里", "en": "I fell into the flowers."},
        {"zh": "我的翅上蓝粉掉了一小片。", "en": "A patch of blue scales has rubbed off my wing."},
        {"zh": "我飞不稳了", "en": "I cannot fly steadily."},
        {"zh": "我不该停那么久", "en": "I should not have rested so long."},
        {"zh": "翅上很疼", "en": "My wing stings."},
        {"zh": "我抓紧花瓣", "en": "I grip the petal tight."},
        {"zh": "这一下拍得太实", "en": "That one landed too solidly."},
        {"zh": "我还想再飞", "en": "I want to fly again."},
        {"zh": "我躲进叶影", "en": "I hide in the leaf shade."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那朵花在发光", "en": "That flower is glowing."},
        {"zh": "绒球葱的味道", "en": "The smell of allium."},
        {"zh": "我朝那边飞", "en": "I fly that way."},
        {"zh": "别把花摘了", "en": "Do not pick the flower."},
        {"zh": "那是我最爱的花", "en": "That is my favorite flower."},
        {"zh": "蜜就在上面", "en": "The nectar is right there."},
        {"zh": "你手心里的花很新", "en": "That flower in your palm is fresh."},
        {"zh": "我慢慢降下去", "en": "I descend slowly."},
        {"zh": "我要采一点", "en": "I will take a little."},
        {"zh": "再等我一会儿", "en": "Wait for me a moment."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞到你的肩", "en": "I bumped your shoulder."},
        {"zh": "我差点被压到", "en": "I was almost crushed."},
        {"zh": "我翅上的粉掉了点", "en": "Some of my scales rubbed off."},
        {"zh": "你挡在花前，我绕不过去。", "en": "You stand in front of the flower; I can't get around."},
        {"zh": "我绕了半圈才过去", "en": "I circled half a turn to pass."},
        {"zh": "我落在你的袖子上", "en": "I landed on your sleeve."},
        {"zh": "别碰我的翅", "en": "Do not touch my wings."},
        {"zh": "我从你耳边飞过", "en": "I flit past your ear."},
        {"zh": "风把你吹得晃，我躲开了", "en": "The gust moved you, I dodged."},
        {"zh": "我飞开又回来", "en": "I fly off and come right back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在那根高枝上等你。", "en": "I wait for you on that high branch."},
        {"zh": "绕一圈给我看", "en": "Circle once for me."},
        {"zh": "翅膀的颜色对了", "en": "Your wing color is right."},
        {"zh": "我们在叶上靠在一起", "en": "We settle together on a leaf."},
        {"zh": "卵会留在叶背", "en": "The eggs will stay under the leaf."},
        {"zh": "别来打搅", "en": "Do not interrupt."},
        {"zh": "我们飞得很高", "en": "We fly up high together."},
        {"zh": "时间不多", "en": "There is not much time."},
        {"zh": "再来一圈", "en": "One more circle."},
        {"zh": "风正好", "en": "The wind is just right."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱着太沉了", "en": "This is too heavy."},
        {"zh": "我用脚抓着", "en": "I grip it with my feet."},
        {"zh": "这些我用不上", "en": "I have no use for these."},
        {"zh": "这一小粒还行", "en": "This little crumb will do."},
        {"zh": "我把它拖到叶上", "en": "I drag it onto a leaf."},
        {"zh": "掉在地上就可惜", "en": "A shame to leave it on the ground."},
        {"zh": "我抓不住那么大的", "en": "I cannot hold anything that big."},
        {"zh": "我落下去捡", "en": "I drop down to collect it."},
        {"zh": "这是花蜜吗", "en": "Is this nectar?"},
        {"zh": "我先尝一点", "en": "Let me taste a bit."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩了我的花", "en": "You stepped on my flower."},
        {"zh": "我绕着你飞", "en": "I circle around you."},
        {"zh": "你的手慢半拍，我早飞开了。", "en": "Your hand is half a beat late; I'm already away."},
        {"zh": "别用网兜我", "en": "Do not net me."},
        {"zh": "我贴着你的脸过去", "en": "I flit across your face."},
        {"zh": "我只是护着这朵花", "en": "I am only guarding this flower."},
        {"zh": "这片花丛是我的", "en": "This patch of flowers is mine."},
        {"zh": "你抬头也追不上", "en": "Look up and you still cannot catch me."},
        {"zh": "我不是蝴蝶标本", "en": "I am not a butterfly specimen."},
        {"zh": "我飞走了", "en": "I am flying off."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我兜了个圈，又回到花上。", "en": "I loop around and settle back on the flower."},
        {"zh": "你的手举得太高了", "en": "Your hand is raised too high."},
        {"zh": "你转过来我就飞", "en": "Turn and I fly."},
        {"zh": "这片林子花很多", "en": "Many flowers in this wood."},
        {"zh": "哪朵都够我歇", "en": "Any of them will hold me."},
        {"zh": "我压低一点，贴着花瓣飞。", "en": "I drop a little and skim along the petals."},
        {"zh": "你的影子很宽", "en": "Your shadow is wide."},
        {"zh": "光斑在移动", "en": "The light patches are moving."},
        {"zh": "我能看见你手腕在转", "en": "I see your wrist turning."},
        {"zh": "我一直在你视野边缘", "en": "I stay at the edge of your vision."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用翅膀扇你", "en": "I fan you with my wings."},
        {"zh": "我撞一下就跑", "en": "I bump and flee."},
        {"zh": "鳞粉落在你手上", "en": "Scales fall on your hand."},
        {"zh": "我其实伤不了你", "en": "I cannot really hurt you."},
        {"zh": "我一头撞上你的脸", "en": "I fly into your face."},
        {"zh": "你眨眼的功夫我就走了", "en": "I am gone in the blink of your eye."},
        {"zh": "翅膀拍得你脸痒", "en": "My wings tickle your cheek."},
        {"zh": "翅膀拍你一下，我就走。", "en": "One flick of my wings at you, then I'm gone."},
        {"zh": "我落你鼻尖一下", "en": "I land on your nose once."},
        {"zh": "你再挥手我就不来了", "en": "Wave again and I will not come back."}
