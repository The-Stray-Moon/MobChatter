{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的叶脉像小路。", "en": "The leaf veins are my paths."},
        {"zh": "我抱住叶边往上爬。", "en": "I grip the leaf edge and climb."},
        {"zh": "我咬一口，再挪一步。", "en": "A bite, then a step."},
        {"zh": "这片叶子还够吃。", "en": "This leaf still has enough."},
        {"zh": "我绕着叶柄转。", "en": "I circle the leaf stalk."},
        {"zh": "我抱紧叶边往下爬。", "en": "I grip the leaf edge and climb down."},
        {"zh": "我爬到叶背乘凉。", "en": "I crawl under the leaf for shade."},
        {"zh": "叶子在晃，我抓稳。", "en": "The leaf sways; I hold on."},
        {"zh": "我从小枝爬到大枝。", "en": "I crawl from the twig to the branch."},
        {"zh": "我用前足试了试。", "en": "I test with my front feet."},
        {"zh": "叶尖太薄，我不去。", "en": "The tip is too thin; I'll stay back."},
        {"zh": "我沿着叶缘慢慢挪。", "en": "I move slowly along the leaf edge."},
        {"zh": "这里还有一片新叶。", "en": "There's a fresh leaf here."},
        {"zh": "我拱过一道叶脉。", "en": "I crawl over a vein."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在叶子中间。", "en": "I rest in the leaf's center."},
        {"zh": "我在叶子上晒太阳。", "en": "I'm basking in the sun."},
        {"zh": "我的触须动了动。", "en": "My antennae twitch."},
        {"zh": "风把叶子吹得响。", "en": "Wind rattles the leaf."},
        {"zh": "我又长大了一点。", "en": "I've grown a little more."},
        {"zh": "这片叶子上很安全。", "en": "It's safe here."},
        {"zh": "我吐了一点点丝。", "en": "I spun a little silk."},
        {"zh": "我趴在叶脉上一动不动。", "en": "I'm doing nothing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的手别碰我的叶。", "en": "Don't touch my leaf."},
        {"zh": "我身上有绒毛。", "en": "I'm covered in fuzz."},
        {"zh": "我认得你不是鸟。", "en": "I know you're not a bird."},
        {"zh": "你会把我放下吗？", "en": "Will you put me down?"},
        {"zh": "我在叶子上很显眼。", "en": "I stand out on this leaf."},
        {"zh": "地面我不能待。", "en": "I can't stay on the ground."},
        {"zh": "我抬头看你了。", "en": "I'm looking up at you."},
        {"zh": "你伸手过来，我缩成一小团。", "en": "You reach out, and I curl into a tight ball."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被压了一下。", "en": "I got squashed a little."},
        {"zh": "我用脚钩紧了叶缘。", "en": "I grip the leaf."},
        {"zh": "身体抬不起来了。", "en": "I can't lift my body."},
        {"zh": "我把柔软的背拱起来。", "en": "I arch my soft back."},
        {"zh": "别再来第二下了。", "en": "Not another one."},
        {"zh": "让我缩一会儿。", "en": "Let me curl up a while."},
        {"zh": "叶子呢？我需要叶子。", "en": "Where's the leaf? I need a leaf."},
        {"zh": "这一下比饿肚子还难受。", "en": "That hurt worse than going hungry."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我只肯啃叶子。", "en": "I only eat leaves."},
        {"zh": "这个不是树叶。", "en": "This isn't a leaf."},
        {"zh": "我要嫩一点的。", "en": "I want a tender one."},
        {"zh": "放下就行，我爬过去。", "en": "Set it down; I'll crawl over."},
        {"zh": "闻着不像叶子。", "en": "Doesn't smell like a leaf."},
        {"zh": "我咬不动这个。", "en": "I can't chew this."},
        {"zh": "这叶子有点干。", "en": "This leaf is a bit dry."},
        {"zh": "你拿片叶子来就好。", "en": "Just bring a leaf."},
        {"zh": "我不吃甜的东西。", "en": "I don't eat sweet things."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰了这片叶。", "en": "You bumped this leaf."},
        {"zh": "我抓紧了叶边。", "en": "I grabbed the leaf edge."},
        {"zh": "别摇这一根枝条。", "en": "Don't shake the twig."},
        {"zh": "我在你手心里了。", "en": "I'm in your palm now."},
        {"zh": "我身上沾了灰。", "en": "Dust is on me."},
        {"zh": "我慢慢爬回叶上。", "en": "I crawl back onto the leaf."},
        {"zh": "这一下把我弄疼了。", "en": "That hurt me."},
        {"zh": "你再碰我就掉下去。", "en": "Touch me again and I drop."},
        {"zh": "你动作轻一点。", "en": "Gently."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还要长大呢。", "en": "I still have growing to do."},
        {"zh": "我连爬都很慢。", "en": "Even moving is slow for me."},
        {"zh": "等我结蛹以后。", "en": "After I form a chrysalis."},
        {"zh": "我在叶子上忙着吃。", "en": "I'm busy eating on this leaf."},
        {"zh": "这话题太早了。", "en": "Far too early for that."},
        {"zh": "我要留着劲儿。", "en": "I need to save my strength."},
        {"zh": "我只想啃叶子。", "en": "I just want to chew leaves."},
        {"zh": "换个地方待着吧。", "en": "Pick another spot."},
        {"zh": "这件事以后再讲。", "en": "We'll talk later."},
        {"zh": "别来打扰我吃东西。", "en": "Don't disturb me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用脚抱不住它。", "en": "I can't hold it."},
        {"zh": "它压弯了叶边。", "en": "It's bending the leaf edge."},
        {"zh": "我从旁边爬过去了。", "en": "I crawled around it."},
        {"zh": "我凑上去闻了一闻。", "en": "I sniffed it."},
        {"zh": "这不是一片叶子。", "en": "Not a leaf."},
        {"zh": "我换个方向走。", "en": "I'll go another way."},
        {"zh": "就把它放在那儿。", "en": "Leave it."},
        {"zh": "轻点，我会被捏扁的。", "en": "Easy — you'll squash me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有片嫩叶。", "en": "There's a tender leaf over there."},
        {"zh": "我朝那边拱过去。", "en": "I inch toward it."},
        {"zh": "叶子边缘有点硬。", "en": "The leaf edge is a bit tough."},
        {"zh": "这个味道挺不错。", "en": "This tastes good."},
        {"zh": "我模仿叶脉，装得很像。", "en": "I mimic leaf veins too well."},
        {"zh": "这路我爬得动。", "en": "I can manage this path."},
        {"zh": "再往前挪一点。", "en": "A bit further."},
        {"zh": "就是这个地方了。", "en": "Right here."},
        {"zh": "可以开始吃了。", "en": "Time to eat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢拱过去。", "en": "I inch over slowly."},
        {"zh": "我绕过那道叶脉。", "en": "I go around the vein."},
        {"zh": "风一吹叶子就晃。", "en": "Wind sways the leaf."},
        {"zh": "这叶子还有水分。", "en": "This leaf still has moisture."},
        {"zh": "再往前爬两节。", "en": "Two more segments."},
        {"zh": "我就快要到了。", "en": "Almost there."},
        {"zh": "我把头伸出去。", "en": "I stretch out my head."},
        {"zh": "我一口咬住了。", "en": "I've got it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬了它一口。", "en": "I took a bite."},
        {"zh": "我这一口啃得很轻。", "en": "That was light."},
        {"zh": "我的牙太小了。", "en": "My teeth are too small."},
        {"zh": "它被我咬破了皮。", "en": "I broke its skin."},
        {"zh": "我身子软得使不上劲。", "en": "I can't put force behind it."},
        {"zh": "我连忙缩了回去。", "en": "I shrink back."},
        {"zh": "这点擦伤碍不着吃。", "en": "That's nothing."},
        {"zh": "我吐了一口丝。", "en": "I spat some silk."},
        {"zh": "你别过来碰我。", "en": "Don't touch me."},
        {"zh": "我躲到叶背去。", "en": "I hide under the leaf."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从卵里出来。", "en": "I came out of an egg."},
        {"zh": "眼前全是叶子。", "en": "Leaves everywhere."},
        {"zh": "我先咬了一口。", "en": "I took a bite first."},
        {"zh": "叶子上有点湿。", "en": "The leaf is slightly damp."},
        {"zh": "我抬头看四周。", "en": "I look around."},
        {"zh": "这里在丘陵上。", "en": "This is on the hills."},
        {"zh": "我要找个好位置。", "en": "I need a good spot."},
        {"zh": "今天风正好合适。", "en": "The wind is just right."},
        {"zh": "那就开始吃吧。", "en": "Let's eat."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子被烤焦，我滚到另一边。", "en": "The leaf burned; I rolled to the other side."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶子上掉进草里。", "en": "I dropped off the leaf into the grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我困在叶面上。", "en": "Water traps me on the leaf."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把叶子掀翻，我抓着叶脉。", "en": "The blast flipped the leaf; I clung to a vein."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西擦过我的身体。", "en": "Something grazed my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我全身抽紧。", "en": "That force clenched my whole body."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得爬不动。", "en": "Too hungry to crawl."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在旁边的枝上，我僵住了。", "en": "Lightning hit the nearby branch; I froze."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶上掉进空里。", "en": "I fell off the leaf into nothing."}
      ]
    }
  }
}
