{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶柄上晃", "en": "I sway on the leaf's stem."},
        {"zh": "蛹不会走，只会摇", "en": "A chrysalis doesn't walk; it sways."},
        {"zh": "风一吹，我就荡一荡", "en": "A gust sets me swinging."},
        {"zh": "我被丝线吊着，动不了", "en": "I hang by silk, unable to move."},
        {"zh": "壳一天比一天硬", "en": "My shell hardens day by day"},
        {"zh": "里面的翅已经成形了", "en": "The wings inside have taken shape."},
        {"zh": "我顺着风偏了一点", "en": "I tilt a little with the wind."},
        {"zh": "叶脉够粗，我挂得稳", "en": "The vein is thick enough to hold me"},
        {"zh": "树叶一动，我就跟着动", "en": "When the leaf moves, I move."},
        {"zh": "我晃得像一颗果子", "en": "I sway like a piece of fruit."},
        {"zh": "彩色的纹路在壳下流动", "en": "Colors flow beneath my shell."},
        {"zh": "我再挂一会儿", "en": "Let me hang a while longer."},
        {"zh": "丝线很细，却很牢", "en": "The silk is thin but strong."},
        {"zh": "我不想被摘下来", "en": "I don't want to be picked."},
        {"zh": "枝叶间有光透进来", "en": "Light comes through the leaves."},
        {"zh": "我的壳开始发亮", "en": "My shell is starting to shine."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我一动不动，在等", "en": "I stay still, waiting."},
        {"zh": "壳里面很安静", "en": "It's very quiet inside."},
        {"zh": "我正在慢慢地变化", "en": "I'm changing."},
        {"zh": "壳里的身子翻了个面", "en": "Inside the shell my body turns over"},
        {"zh": "时间还没有到", "en": "It isn't time yet."},
        {"zh": "我听得见外面的鸟", "en": "I hear birds outside."},
        {"zh": "你再等上一等", "en": "A little longer."},
        {"zh": "蛹里什么也看不见", "en": "I can see nothing in here."},
        {"zh": "我知道自己会飞", "en": "I know I'll fly."},
        {"zh": "这片树叶就是我的屋子", "en": "This leaf is my house."},
        {"zh": "彩纹又深了一层", "en": "The colors have deepened a shade."},
        {"zh": "外面风大，我不出去", "en": "The wind's strong; I stay in."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看不出我会变成什么", "en": "You can't tell what I'll become"},
        {"zh": "别动我这边的叶子", "en": "Don't move me."},
        {"zh": "我还不是蝴蝶", "en": "I'm not a butterfly yet."},
        {"zh": "你看看这层壳", "en": "Look at this shell."},
        {"zh": "你的手指离我三寸", "en": "Your fingers are three inches from me"},
        {"zh": "我没有脚，只能这么挂着", "en": "I have no legs; I just hang here"},
        {"zh": "等我自己出来", "en": "Wait for me to come out."},
        {"zh": "你认得这颜色吗", "en": "Do you know these colors?"},
        {"zh": "翅膀叠着，还没法张开", "en": "My wings are folded and can't open yet"},
        {"zh": "你能听见里面吗", "en": "Can you hear in there?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳裂了一条缝", "en": "A crack runs through my shell."},
        {"zh": "丝线已经松脱", "en": "The silk has come loose."},
        {"zh": "叶子一颤，壳撞在枝上", "en": "The leaf jolts and my shell knocks the twig"},
        {"zh": "丝线绷紧，我悬在半空", "en": "The silk pulls taut and I hang in midair"},
        {"zh": "别再碰我的壳", "en": "Stop touching me."},
        {"zh": "里面被震到了", "en": "The inside was shaken."},
        {"zh": "我还在长个子", "en": "I'm still growing."},
        {"zh": "这一下让我晚几天", "en": "That set me back days."},
        {"zh": "别让我提前出来", "en": "Don't make me emerge early."},
        {"zh": "我还能撑得住", "en": "I can still hold on."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我连吃东西的器官都没有", "en": "I don't even have the parts for eating"},
        {"zh": "那不是我需要的", "en": "That isn't what I need."},
        {"zh": "你把它放回去吧", "en": "Put it back."},
        {"zh": "我现在只等时间", "en": "For now I only wait."},
        {"zh": "蜜对蛹没有用", "en": "Nectar is no use to a chrysalis."},
        {"zh": "你把它拿远点", "en": "Take it away."},
        {"zh": "我现在一点都不饿", "en": "I'm not hungry now."},
        {"zh": "蜜水对我只是湿的东西", "en": "Nectar is just something wet to me"},
        {"zh": "别拿它来碰我", "en": "Don't touch me with it."},
        {"zh": "把它从我眼前拿开", "en": "Take it from my sight."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "别碰，我会掉", "en": "Touch me and I'll fall."},
        {"zh": "丝线被扯了一下", "en": "The silk got tugged."},
        {"zh": "这一下让我晃了很久", "en": "That kept me swaying a while."},
        {"zh": "我可是很脆弱的", "en": "I'm fragile."},
        {"zh": "壳上多了道细痕", "en": "A fine crack appeared."},
        {"zh": "我还在，没掉", "en": "I'm still here; I didn't fall."},
        {"zh": "枝叶都跟着抖", "en": "The branch shook with it."},
        {"zh": "你再撞一次丝就要断", "en": "Another bump and the silk snaps."},
        {"zh": "请你再轻一些", "en": "More gently."},
        {"zh": "让我先稳住身子", "en": "Let me steady myself first."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还没有长成", "en": "I haven't grown yet."},
        {"zh": "这事得等我出来", "en": "That must wait until I emerge."},
        {"zh": "我现在只是个蛹", "en": "I'm only a chrysalis."},
        {"zh": "你找别处的蝴蝶吧", "en": "Find butterflies elsewhere."},
        {"zh": "我的翅还折着", "en": "My wings are still folded."},
        {"zh": "现在时机还不对", "en": "The timing isn't right."},
        {"zh": "你别来催我了", "en": "Don't hurry me."},
        {"zh": "我连自己是什么颜色都不知道", "en": "I don't even know my own colors."},
        {"zh": "外面的事以后再说", "en": "The outside can wait."},
        {"zh": "我还得再挂几天", "en": "A few more days of hanging."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "摘下来，我就活不成", "en": "Pick me off and I won't survive"},
        {"zh": "丝线会断掉的", "en": "The silk will break."},
        {"zh": "离开树叶我活不了", "en": "I can't survive off the leaf."},
        {"zh": "把我放回叶子上", "en": "Put me back."},
        {"zh": "这片叶子不能离身", "en": "I can't leave this leaf."},
        {"zh": "我现在只握得住丝线", "en": "All I can hold right now is silk"},
        {"zh": "这一动把我吓着了", "en": "That startled me."},
        {"zh": "你手上没有树叶", "en": "You have no leaf in your hand."},
        {"zh": "轻点，壳很薄", "en": "Gently; the shell is thin."},
        {"zh": "我会在你手里羽化", "en": "I'll emerge in your hand."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你是想摘我下来", "en": "You mean to pick me."},
        {"zh": "叶子一晃，我就知道有谁", "en": "When the leaf shakes, I know someone is there"},
        {"zh": "我虽然不会动", "en": "I can't move, but—"},
        {"zh": "你后面有只鸟", "en": "There's a bird behind you."},
        {"zh": "我记住你的手了", "en": "I've noted your hands."},
        {"zh": "我不会逃跑的", "en": "I won't flee."},
        {"zh": "我察觉叶梗在颤", "en": "I feel the leaf stem trembling"},
        {"zh": "你要动我，就得连着叶子", "en": "To move me, take the leaf."},
        {"zh": "我快要出来了", "en": "I'm nearly out."},
        {"zh": "再等一小会儿", "en": "Just a little longer."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我感觉到你在我旁边", "en": "I feel you beside me."},
        {"zh": "你的影子挡住光了", "en": "Your shadow blocks the light."},
        {"zh": "我在壳里数着", "en": "I'm counting inside."},
        {"zh": "你别碰那丝线", "en": "Don't touch the silk."},
        {"zh": "我这就快好了", "en": "I'm almost ready."},
        {"zh": "外面有动静了", "en": "Something moves outside."},
        {"zh": "壳已经开始裂", "en": "The shell is splitting."},
        {"zh": "你看，纹路在变", "en": "Look, the pattern is changing."},
        {"zh": "我还没出来呢", "en": "I'm not out yet."},
        {"zh": "就快准备好了", "en": "Almost ready."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有攻击，只有挣扎", "en": "I have no attack, only struggle."},
        {"zh": "别逼我做这种事", "en": "Don't push me to it."},
        {"zh": "我的壳很硬的", "en": "My shell is hard."},
        {"zh": "你手会被丝缠住", "en": "The silk will snag your hand."},
        {"zh": "我只能晃一晃", "en": "I can only sway."},
        {"zh": "你退开一点点", "en": "Step back a little."},
        {"zh": "我拽不动你的", "en": "I can't pull you."},
        {"zh": "但我会记住你", "en": "But I'll remember you."},
        {"zh": "我能做的只有扭一下壳", "en": "All I can manage is one twist of my shell"},
        {"zh": "我就要出来了", "en": "I'm coming out now."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "有只毛虫结了蛹", "en": "A caterpillar formed a chrysalis."},
        {"zh": "我挂在这片叶下", "en": "I hang beneath this leaf."},
        {"zh": "丝线一圈圈绕好了", "en": "The silk is wound, loop by loop."},
        {"zh": "这一个蛹期，我不挪窝", "en": "Through this whole pupal stage I stay put"},
        {"zh": "彩色的东西在里面长", "en": "Something colorful grows within."},
        {"zh": "叶子还够绿的", "en": "The leaf is still green enough."},
        {"zh": "我挑了个避风的位置", "en": "I picked a sheltered spot."},
        {"zh": "这一片林子不错", "en": "This wood is nice."},
        {"zh": "毛虫用丝把我挂好", "en": "The larva hung me up with silk"},
        {"zh": "再过些日子我就飞", "en": "In some days, I'll fly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热得壳都软了", "en": "The heat softened my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔在落叶上，壳裂了", "en": "I fell among the leaves and cracked."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水渗进壳里面", "en": "Water seeps inside."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我从叶子上掀下来", "en": "The blast tore me off the leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎穿了壳", "en": "That pierced the shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让壳里的颜色乱了", "en": "The spell scrambled my colors."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠这片叶子的养分", "en": "I live on this leaf's sap."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光透进壳里", "en": "The flash shone through my shell."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有叶子可以挂", "en": "There's no leaf to hang from in the void."}
      ]
    }
  }
}
