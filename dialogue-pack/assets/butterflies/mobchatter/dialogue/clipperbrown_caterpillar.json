{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "褐色背脊一弓，我挪半寸。", "en": "One arch of my brown back, half an inch on."},
        {"zh": "棕色身子贴着叶脉走。", "en": "My brown body follows the vein."},
        {"zh": "我用前足抓住叶缘。", "en": "Front feet grip the leaf's edge."},
        {"zh": "叶子一动，我就停住。", "en": "The leaf moved. I stop."},
        {"zh": "我腹下的叶脉一节节退后。", "en": "The vein slides back beneath me, segment by segment."},
        {"zh": "爬过的地方留下咬痕。", "en": "Bite marks trail behind me."},
        {"zh": "我绕过叶尖，往回爬。", "en": "Around the leaf tip, then back."},
        {"zh": "棕色的皮肤和枝子很像。", "en": "Brown skin matches the twigs."},
        {"zh": "每走一步都嚼两口。", "en": "Two bites per step."},
        {"zh": "我沿着叶背往前。", "en": "I move along the leaf's underside."},
        {"zh": "叶片被压得往下弯。", "en": "The leaf bends under me."},
        {"zh": "我慢慢转向有光的那边。", "en": "Turning toward the light."},
        {"zh": "叶子边缘有点干，我避开。", "en": "The edge is dry. I avoid it."},
        {"zh": "我的脚很多，走得很稳。", "en": "Many feet, steady grip."},
        {"zh": "我挪到另一片叶子上。", "en": "I shift onto another leaf."},
        {"zh": "我从叶尖爬到叶柄。", "en": "Tip to stem, all the way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在叶脉上不动。", "en": "Frozen on the midrib."},
        {"zh": "棕色的身体收得很紧。", "en": "My brown body pulled in tight."},
        {"zh": "我在嚼叶子，很慢。", "en": "Chewing leaf, very slowly."},
        {"zh": "阳光从上面照下来。", "en": "Sunlight comes down through."},
        {"zh": "我抬起身子，四下看。", "en": "I rear up and look around."},
        {"zh": "叶子边缘已经被我啃缺。", "en": "I've already notched the leaf's edge."},
        {"zh": "我需要不断吃叶子。", "en": "I must keep eating leaves."},
        {"zh": "离开叶子我会撑不住。", "en": "Off a leaf, I won't last."},
        {"zh": "我的体节轻轻鼓动。", "en": "My segments pulse softly."},
        {"zh": "附近有鸟叫，我不动。", "en": "A bird calls. I stay still."},
        {"zh": "雨滴打在叶子上，很响。", "en": "Rain hits the leaf, loud."},
        {"zh": "我就这么挂着。", "en": "I just hang here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你把光线全挡住了。", "en": "You've blocked all the light."},
        {"zh": "别碰我下面的叶子。", "en": "Don't disturb the leaf under me."},
        {"zh": "你要把我搬到别处吗？", "en": "Are you moving me somewhere?"},
        {"zh": "我除了叶子什么也不吃。", "en": "I eat nothing but leaves."},
        {"zh": "我这么小，你也看见？", "en": "I'm this small, and you saw me?"},
        {"zh": "你的手比我整条还宽。", "en": "Your hand is wider than my whole body."},
        {"zh": "别把我抖下去。", "en": "Don't shake me off."},
        {"zh": "我在丛林里长大。", "en": "I grew up in the jungle."},
        {"zh": "你站得越近，我越害怕。", "en": "The closer you stand, the more afraid I am."},
        {"zh": "树上有我的亲戚。", "en": "My relatives are up in these trees."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我把自己卷成一枚褐色小球。", "en": "I roll myself into a small brown bead."},
        {"zh": "我的体节被压到了。", "en": "My segments got squashed."},
        {"zh": "我从叶缘滑脱，往下坠。", "en": "I lose the leaf's edge and drop."},
        {"zh": "我疼得直扭身子。", "en": "The pain makes me writhe."},
        {"zh": "我流出了一点汁。", "en": "A little fluid leaked out."},
        {"zh": "我挂在叶缘上。", "en": "I'm hanging by the leaf's edge."},
        {"zh": "别踩，我在这里。", "en": "Don't step. I'm right here."},
        {"zh": "我现在动得很慢。", "en": "I'm moving very slowly now."},
        {"zh": "我还抓着叶脉。", "en": "I'm still holding the vein."},
        {"zh": "这一下让我缩紧了。", "en": "That made me clench up."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子，我只要叶子。", "en": "Leaves. I only want leaves."},
        {"zh": "那片叶子看着很嫩。", "en": "That leaf looks tender."},
        {"zh": "别拿果子逗我。", "en": "Don't tease me with fruit."},
        {"zh": "递一片叶子过来就行。", "en": "Just hand me a leaf."},
        {"zh": "我要的是叶缘，不是别的。", "en": "I want the leaf's edge, nothing else."},
        {"zh": "这棵树够我吃很久。", "en": "This tree will feed me a while."},
        {"zh": "你摘的那片有点老。", "en": "The one you picked is a bit old."},
        {"zh": "把叶子递到我嘴边来。", "en": "Bring the leaf right to my mouth."},
        {"zh": "我不想离开这片叶。", "en": "I don't want to leave this leaf."},
        {"zh": "别摘光，留一点给我。", "en": "Don't strip it bare. Save some."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到叶子，我晃了。", "en": "You bumped the leaf. I swayed."},
        {"zh": "别用手来推我。", "en": "Don't push me with your hand."},
        {"zh": "我抓得很紧，不会掉。", "en": "I'm holding on. I won't fall."},
        {"zh": "你压到了我的叶柄。", "en": "You pressed on my stem."},
        {"zh": "我往后缩了一节。", "en": "I pulled back one segment."},
        {"zh": "叶子被你压弯了。", "en": "You bent the leaf down."},
        {"zh": "小心，我脚下是空的。", "en": "Careful. There's nothing under me."},
        {"zh": "你一动，我就得重新抓。", "en": "When you move, I must regrip."},
        {"zh": "我们之间还隔着一片叶。", "en": "There's still a leaf between us."},
        {"zh": "别抖这根枝子。", "en": "Don't shake this branch."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还要蜕好几次皮。", "en": "I've several molts to go."},
        {"zh": "翅膀长出来前别提这个。", "en": "Not before I grow my wings."},
        {"zh": "我现在只是一条虫。", "en": "Right now I'm only a worm."},
        {"zh": "这些事离我还很远。", "en": "That's very far from me."},
        {"zh": "我得先把自己吃饱。", "en": "I have to fill myself first."},
        {"zh": "我连蛹都还没结。", "en": "I haven't even pupated."},
        {"zh": "我离结蛹还差好几蜕。", "en": "I am several molts away from pupating."},
        {"zh": "我只想着下一片叶子。", "en": "I'm only thinking of the next leaf."},
        {"zh": "这棵树上还有别人。", "en": "There are others in this tree."},
        {"zh": "我不回答这个。", "en": "I won't answer that."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你两指夹住我的中段。", "en": "Two fingers pinch me around the middle."},
        {"zh": "请放回叶子上。", "en": "Please put me back on a leaf."},
        {"zh": "这个东西不能吃。", "en": "This thing can't be eaten."},
        {"zh": "尝了尝你的袖口，苦的。", "en": "I taste your cuff. Bitter."},
        {"zh": "我的脚缠住了。", "en": "My feet are tangled."},
        {"zh": "叶子比这个好多了。", "en": "A leaf is far better than this."},
        {"zh": "轻一点，我会断。", "en": "Gently. I'll snap."},
        {"zh": "你的指缝里夹着叶屑。", "en": "There is leaf grit between your fingers."},
        {"zh": "我在你手心里转身。", "en": "I turn over in your palm."},
        {"zh": "请你别捏得太紧。", "en": "Please don't squeeze so hard."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在动那片叶子。", "en": "Something's moving that leaf."},
        {"zh": "我抬起前半身看。", "en": "I rear up to look."},
        {"zh": "那是鸟，还是人？", "en": "Is that a bird, or a person?"},
        {"zh": "我得挪到叶子背面。", "en": "I should get under the leaf."},
        {"zh": "风里有一股味道。", "en": "There's a smell on the wind."},
        {"zh": "我停住了，别动。", "en": "I've frozen. Don't move."},
        {"zh": "那道影子扫过来。", "en": "A shadow swept across."},
        {"zh": "我死死抓紧叶脉。", "en": "I grip the midrib tight."},
        {"zh": "有东西靠得很近。", "en": "Something's very close."},
        {"zh": "我正在慢慢转身。", "en": "I'm turning very slowly."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西还在附近。", "en": "That thing is still nearby."},
        {"zh": "我尽量一点不动。", "en": "I'm trying not to move at all."},
        {"zh": "叶子的边能挡我。", "en": "The leaf's edge hides me."},
        {"zh": "我的颜色帮了我。", "en": "My color helps me."},
        {"zh": "它正看着这边。", "en": "It's looking right this way."},
        {"zh": "再等一会儿就过去了。", "en": "A moment more and it'll pass."},
        {"zh": "我缩到了叶柄后面。", "en": "I slipped behind the stem."},
        {"zh": "我的身体在发抖。", "en": "My body is trembling."},
        {"zh": "风一吹，叶子就挡。", "en": "The wind makes the leaf cover me."},
        {"zh": "它好像没发现我。", "en": "It seems it hasn't found me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起身子顶你的指尖。", "en": "I rear up and butt your fingertip."},
        {"zh": "我咬住那根指头。", "en": "I bite that finger."},
        {"zh": "我用整条身子拍你一下。", "en": "I slap you with my whole body."},
        {"zh": "我吐出一点汁液。", "en": "I spat out a bit of juice."},
        {"zh": "我只能扭动身体。", "en": "All I can do is squirm."},
        {"zh": "别抓我，我会挣扎。", "en": "Don't grab me. I'll struggle."},
        {"zh": "我往前顶了一下。", "en": "I pushed forward once."},
        {"zh": "这一口咬得很轻。", "en": "That bite was very light."},
        {"zh": "我卷起来护住自己。", "en": "I curl up to guard myself."},
        {"zh": "我从叶子上掉下去了。", "en": "I've fallen off the leaf."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在一片嫩叶上孵出来。", "en": "I hatched on a tender leaf."},
        {"zh": "丛林里到处都是叶子。", "en": "Leaves everywhere in this jungle."},
        {"zh": "我一出生就开始吃。", "en": "I started eating the moment I hatched."},
        {"zh": "棕色的身体刚长硬。", "en": "My brown body just hardened."},
        {"zh": "我爬出卵壳，找叶脉。", "en": "Out of the shell, hunting a vein."},
        {"zh": "上面很亮，下面很凉。", "en": "Bright above, cool below."},
        {"zh": "这片叶子够我住几天。", "en": "This leaf will house me for days."},
        {"zh": "我慢慢伸开身体。", "en": "I slowly stretch out."},
        {"zh": "我先咬了一个小洞。", "en": "First I bit a small hole."},
        {"zh": "树上还有别的幼虫。", "en": "Other larvae are on this tree."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰把叶子和我一起烤。", "en": "Fire roasted the leaf and me together."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶子上掉了下去。", "en": "I dropped off the leaf."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我裹住了，我动不了。", "en": "Water wrapped around me. I can't move."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把叶子撕碎了。", "en": "The blast shredded the leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过了叶子。", "en": "Something went through the leaf."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我的身体发烫。", "en": "That light made my body hot."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没叶子吃了，我越来越软。", "en": "No leaves. I'm going soft."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，叶子全在抖。", "en": "Lightning struck and every leaf shook."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面空了，我连叶脉都抓不住。", "en": "Nothing below me; I cannot even hold the vein."}
      ]
    }
  }
}
