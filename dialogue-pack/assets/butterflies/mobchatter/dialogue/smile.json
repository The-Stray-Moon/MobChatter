        {"zh": "这丛花是我的", "en": "This clump is mine."},
        {"zh": "我讨厌被追着飞", "en": "I hate being chased."},
        {"zh": "我翅上的粉会呛你", "en": "My dust will choke you."},
        {"zh": "别碰那朵矢车菊", "en": "Don't touch that cornflower."},
        {"zh": "我这就飞走了", "en": "I'm flying off now."},
        {"zh": "别碰那朵矢车菊。", "en": "Do not touch that cornflower."},
        {"zh": "我也是有脾气的", "en": "I have a temper too."},
        {"zh": "你挡着我授粉了", "en": "You're blocking my pollinating."},
        {"zh": "我会记住你的", "en": "I'll remember you."}
