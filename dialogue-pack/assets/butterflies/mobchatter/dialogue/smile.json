{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑扇着飞过草地", "en": "I flutter over the grass."},
        {"zh": "翅膀上有个笑的样子", "en": "There's a smile on my wings."},
        {"zh": "我在白天的光里飞", "en": "I fly in the daylight."},
        {"zh": "我停一下，再飞一段", "en": "A pause, then another stretch of flight."},
        {"zh": "我绕着矢车菊转", "en": "I circle the cornflowers."},
        {"zh": "翅粉掉在花瓣上", "en": "My scales dust the petals."},
        {"zh": "我飞得不快，也不慢", "en": "I fly neither fast nor slow."},
        {"zh": "一朵花到另一朵花", "en": "From one flower to the next."},
        {"zh": "阳光把我的翅照透了", "en": "Sunlight shines through my wings."},
        {"zh": "我压低高度穿过草叶", "en": "I dip low through the blades."},
        {"zh": "风一来，我就飘一下", "en": "A gust comes and I drift."},
        {"zh": "今天花开了不少", "en": "Plenty of flowers opened today."},
        {"zh": "我绕着同一丛花转圈", "en": "I loop around the same clump."},
        {"zh": "翅影落在地上", "en": "My wing shadow falls on the ground."},
        {"zh": "我又飞回那朵花", "en": "I fly back to that flower again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在花心上", "en": "I rest on a flower's heart."},
        {"zh": "我在晒着太阳", "en": "I'm sunning myself."},
        {"zh": "今天没什么风", "en": "Hardly any wind today."},
        {"zh": "这朵花的蜜不错", "en": "The nectar here is good."},
        {"zh": "有只蜂飞过去了", "en": "A bee just flew past."},
        {"zh": "我翅上的笑还亮着", "en": "The smile on my wings still shows."},
        {"zh": "花梗在轻轻弯", "en": "The stem bends slightly."},
        {"zh": "露水还没有干", "en": "The dew hasn't dried yet."},
        {"zh": "这片林子真安静", "en": "This wood is so quiet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你不躲，我也不躲", "en": "You don't flinch, and neither do I."},
        {"zh": "我一点都不怕人", "en": "I'm not afraid of people."},
        {"zh": "你手上有花粉味", "en": "Your hands smell of pollen."},
        {"zh": "你站在这儿挡了光", "en": "You're standing in my light."},
        {"zh": "要看我的翅吗", "en": "Want to see my wings?"},
        {"zh": "那是一个笑脸", "en": "That's a smiling face."},
        {"zh": "你别动，我落一下", "en": "Hold still; I'll land a moment."},
        {"zh": "你会不会抓我", "en": "Will you catch me?"},
        {"zh": "这片花是我常来的", "en": "These flowers are my usual spot."},
        {"zh": "你比我大好多", "en": "You're so much bigger than me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀被压皱了", "en": "My wings are creased."},
        {"zh": "掉了好多的粉", "en": "So much dust lost."},
        {"zh": "我掉下来一点", "en": "I dropped a little."},
        {"zh": "别按我的翅脉", "en": "Not my wing veins."},
        {"zh": "翅折了一个角", "en": "A corner of my wing is bent."},
        {"zh": "我飞不直身子", "en": "I can't fly straight."},
        {"zh": "这一下真的很疼", "en": "That really hurts."},
        {"zh": "我还飞得起来的", "en": "I can still fly."},
        {"zh": "让我停在花上", "en": "Let me rest on a flower."},
        {"zh": "你踩到我的脚", "en": "You stepped on me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "花蜜，还是花", "en": "Nectar, or a flower?"},
        {"zh": "你手里那朵是什么", "en": "What flower is that in your hand?"},
        {"zh": "矢车菊最合我口味", "en": "Cornflowers suit my taste best."},
        {"zh": "你举得有点高", "en": "You're holding it a bit high."},
        {"zh": "那是花里的蜜吗", "en": "Is that nectar?"},
        {"zh": "我只喝花里的", "en": "I only drink from flowers."},
        {"zh": "你放低一点点", "en": "Lower it just a little."},
        {"zh": "我翅上的花纹，像在笑。", "en": "The pattern on my wings looks like a smile."},
        {"zh": "这个我要试试", "en": "I'll try this one."},
        {"zh": "别把花捏坏了", "en": "Don't crush the flower."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞在你手上了", "en": "I bumped your hand."},
        {"zh": "翅粉沾到你了", "en": "My scales rubbed onto you."},
        {"zh": "我刚才飞得太急", "en": "I was flying too fast."},
        {"zh": "你身上的味道太浓", "en": "Your scent is too strong."},
        {"zh": "我没事，翅也没折", "en": "I'm fine; my wing didn't fold."},
        {"zh": "我撞上你的肩膀，歪了一下。", "en": "I bump your shoulder and veer off."},
        {"zh": "这一下把我撞偏了", "en": "That knocked me off course."},
        {"zh": "草叶都被我拨开了", "en": "The grass parted around me."},
        {"zh": "我们各飞各的", "en": "Let's each go our own way."},
        {"zh": "我再飞高一点", "en": "I'll fly a bit higher."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你翅上的笑很配", "en": "The smile on your wings suits mine."},
        {"zh": "跟我一起去看花吧", "en": "Come see the flowers with me."},
        {"zh": "我们在花上停一会儿", "en": "Let's rest on a flower a while."},
        {"zh": "别飞得那么快", "en": "Don't fly so fast."},
        {"zh": "我的日子不长", "en": "My days aren't long."},
        {"zh": "一起绕这丛花转圈", "en": "Let's circle this clump together."},
        {"zh": "风一来我们就分开", "en": "The wind will part us."},
        {"zh": "你今天飞得真好", "en": "You flew beautifully today."},
        {"zh": "我不想一个人", "en": "I don't want to be alone."},
        {"zh": "就今天，陪我飞", "en": "Just today; fly with me."}
