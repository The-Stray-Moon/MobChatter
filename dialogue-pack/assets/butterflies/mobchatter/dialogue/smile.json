        {"zh": "粉会沾满你手指", "en": "The dust will coat your fingers."},
        {"zh": "别按着我的翅根", "en": "Don't press my wing base."},
        {"zh": "把我放回花上", "en": "Put me back on the flower."},
        {"zh": "你的手真是大", "en": "Your hand is so large."},
        {"zh": "这样我飞不了", "en": "I can't fly like this."},
        {"zh": "我会在你掌心停一下", "en": "I'll rest in your palm a moment."},
        {"zh": "你的手心有汗", "en": "Your palm is sweaty."},
        {"zh": "再放一会儿也行", "en": "A moment longer is fine."},
        {"zh": "我要回去授粉了", "en": "I must get back to pollinating."}
