{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飞得比雌蝶快", "en": "I fly faster than the female."},
        {"zh": "翅膀上只有一小块蓝", "en": "Only a small blue patch on my wings."},
        {"zh": "我沿着林缘飞", "en": "I fly along the forest edge."},
        {"zh": "我在寻找同类的颜色", "en": "I am looking for my kind's color."},
        {"zh": "我停在叶尖上", "en": "I stop on a leaf tip."},
        {"zh": "我从这朵花跳到那朵", "en": "I hop from bloom to bloom."},
        {"zh": "我翅膀扇得很急", "en": "My wings beat quickly."},
        {"zh": "我一会儿高一会儿低", "en": "I rise and dip."},
        {"zh": "我贴着树影飞，蓝斑忽明忽暗。", "en": "I fly along the tree shadows; my blue patch flickers."},
        {"zh": "我绕着一丛花飞", "en": "I circle a clump of flowers."},
        {"zh": "我落在花穗上", "en": "I land on a flower spike."},
        {"zh": "我转身去另一片林子", "en": "I turn toward another grove."},
        {"zh": "风把我抬了起来", "en": "The wind lifts me."},
        {"zh": "我贴着草尖飞过", "en": "I skim over the grass tips."},
        {"zh": "我越飞越快", "en": "I fly faster and faster."},
        {"zh": "我看见了别的翅膀", "en": "I spotted other wings."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀合着，我等太阳偏一点。", "en": "Wings folded, I wait for the sun to tilt."},
        {"zh": "我在听翅声", "en": "I am listening for wings."},
        {"zh": "肚子有点饿", "en": "I am a little hungry."},
        {"zh": "我合起翅膀", "en": "I fold my wings."},
        {"zh": "那片林子里有动静", "en": "Something stirs in that grove."},
        {"zh": "我在挑蜜源", "en": "I am choosing a nectar source."},
        {"zh": "风一停我就想飞", "en": "When the wind dies I want to fly."},
        {"zh": "我活不了太久", "en": "I will not live long."},
        {"zh": "我的翅上有蓝斑", "en": "A blue patch on my wings."},
        {"zh": "我爬到花心", "en": "I crawl into the flower's heart."},
        {"zh": "我停在花穗上，嗅一嗅风。", "en": "I perch on the flower spike and taste the wind."},
        {"zh": "我抬起头看太阳", "en": "I raise my head to the sun."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在花丛里很显眼", "en": "You stand out among the flowers."},
        {"zh": "你的网我认得，不会靠近。", "en": "I know that net; I won't come near."},
        {"zh": "你别把花全摘了", "en": "Do not pick all the flowers."},
        {"zh": "我在找另一只翅膀", "en": "I am looking for another set of wings."},
        {"zh": "你的网我看得见", "en": "I can see your net."},
        {"zh": "我飞得够快", "en": "I am fast enough."},
        {"zh": "你知道哪里有花吗", "en": "Do you know where the flowers are?"},
        {"zh": "我去那边看看", "en": "I will check over there."},
        {"zh": "你身上有股怪味", "en": "You smell odd."},
        {"zh": "我绕你一圈就走", "en": "I circle you once and leave."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅被折了一角", "en": "A corner of my wing folded."},
        {"zh": "我掉到草里", "en": "I dropped into the grass."},
        {"zh": "鳞粉掉了很多", "en": "A lot of scales came off."},
        {"zh": "我飞得歪了", "en": "I fly crooked."},
        {"zh": "我歇一会", "en": "Let me rest a moment."},
        {"zh": "这一下真疼", "en": "That really hurt."},
        {"zh": "我抓在花梗上", "en": "I cling to a flower stem."},
        {"zh": "我的时间更少了", "en": "My time is shorter now."},
        {"zh": "我还想再飞一点", "en": "I want to fly a little more."},
        {"zh": "翅是我全部的家当", "en": "My wings are all I have."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那朵花刚开", "en": "That flower just opened."},
        {"zh": "我闻到绒球葱了", "en": "I smell allium."},
        {"zh": "你手里的花算不算", "en": "Does the flower in your hand count?"},
        {"zh": "放下来我自己去", "en": "Set it down and I will go myself."},
        {"zh": "花蜜香味到处飘", "en": "The nectar smell carries everywhere."},
        {"zh": "我想落在那朵上", "en": "I want to land on that one."},
        {"zh": "别把花摇动", "en": "Do not shake the flower."},
        {"zh": "我慢慢靠过去", "en": "I drift slowly over."},
        {"zh": "就采一小口", "en": "Just one small sip."},
        {"zh": "那几个花头最好", "en": "Those blooms are the best."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞到你的头顶", "en": "I bounced off your head."},
        {"zh": "我被你挡住了", "en": "You blocked me."},
        {"zh": "翅上的粉蹭掉了", "en": "Scales rubbed off my wing."},
        {"zh": "我掉头就飞", "en": "I turn and fly off."},
        {"zh": "我落到了你的帽子上", "en": "I landed on your hat."},
        {"zh": "你挥手把我赶开了", "en": "Your wave shooed me off."},
        {"zh": "我绕花丛半圈，又落回来。", "en": "I circle half the flowerbed and land again."},
        {"zh": "别用袖子扇我", "en": "Do not swat me with your sleeve."},
        {"zh": "我差点被你夹住", "en": "I was nearly trapped."},
        {"zh": "我又试了一次", "en": "I try once more."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是来找雌蝶的", "en": "I came looking for the female."},
        {"zh": "翅上的蓝要正对光", "en": "The blue must catch the light."},
        {"zh": "我绕着她飞八字", "en": "I fly a figure eight around her."},
        {"zh": "她停在花穗上", "en": "She rests on a flower spike."},
