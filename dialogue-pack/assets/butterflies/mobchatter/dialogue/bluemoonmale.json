        {"zh": "别在这个时候靠过来", "en": "Do not come near just now."},
        {"zh": "卵会落在叶背", "en": "The eggs go under the leaf."},
        {"zh": "风把我们的味道带走", "en": "The wind carries our scent."},
        {"zh": "趁光还亮，我得多飞一圈。", "en": "While the light lasts, I must fly one more round."},
        {"zh": "这是我的最后一次飞翔", "en": "This is my last flight."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
