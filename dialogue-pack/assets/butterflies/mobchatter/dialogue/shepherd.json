{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扛着牧杖慢慢走", "en": "I walk slowly with my crook."},
        {"zh": "我沿着栅栏绕一圈", "en": "I do a circuit along the fence."},
        {"zh": "手里的网是新的", "en": "My net is new."},
        {"zh": "我停下来看看花丛", "en": "I stop to check the flowerbed."},
        {"zh": "我走过草地，鞋上沾泥", "en": "My boots collect mud crossing the meadow."},
        {"zh": "我朝村口那边去", "en": "I head toward the village gate."},
        {"zh": "我这活儿得天天走", "en": "This work means walking every day."},
        {"zh": "我绕开踩坏的花", "en": "I step around the crushed flowers."},
        {"zh": "羊在坡上，我得看着", "en": "The sheep are on the slope; I must watch."},
        {"zh": "我把网往肩上一搭", "en": "I sling the net over my shoulder."},
        {"zh": "谁家的羊又跑出来了", "en": "Whose sheep got out again?"},
        {"zh": "我走到树底下避太阳", "en": "I step under the tree for shade."},
        {"zh": "这道篱笆该修了", "en": "This fence needs mending."},
        {"zh": "我沿小路走到头", "en": "I walk the path to its end."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在花圃边上", "en": "I stand at the flowerbed's edge."},
        {"zh": "今天没抓到几只", "en": "Not many caught today."},
        {"zh": "我看看网里还有没有", "en": "Let me check the net again."},
        {"zh": "日头正好，蝶也多", "en": "Good sun; plenty of butterflies."},
        {"zh": "我把牧杖插在土里", "en": "I plant my crook in the soil."},
        {"zh": "等一会儿，它们就来了", "en": "Wait a while and they'll come."},
        {"zh": "我数着花上的翅影", "en": "I count the wings on the flowers."},
        {"zh": "这一带我熟得很", "en": "I know this area well."},
        {"zh": "有人要买标本吗", "en": "Anyone buying specimens?"},
        {"zh": "我把帽子往后推了推", "en": "I push my hat back."},
        {"zh": "风把网吹动了", "en": "The wind stirs my net."},
        {"zh": "不急，慢慢来", "en": "No hurry; take it easy."},
        {"zh": "我把网从栅栏上取下来", "en": "I take the net down from the fence."},
        {"zh": "坡上传来羊铃", "en": "Sheep bells ring up the slope."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你要买东西？", "en": "Are you here to trade?"},
        {"zh": "我收蝶，也卖网", "en": "I buy butterflies and sell nets."},
        {"zh": "你手里那只不错", "en": "The one in your hand is good."},
        {"zh": "你要学怎么捕吗", "en": "Want to learn how to catch them?"},
        {"zh": "别捏蝴蝶的翅膀", "en": "Don't pinch the wings."},
        {"zh": "放纸上压平，四角钉住", "en": "Press it flat on paper, pin the corners."},
        {"zh": "我这儿东西不多", "en": "I haven't much stock."},
        {"zh": "把网举高一点", "en": "Hold the net higher."},
        {"zh": "这片林子蝶种不少", "en": "This wood has many species."},
        {"zh": "别踩到那些花上", "en": "Don't tread on the flowers."},
        {"zh": "你要是抓到了，拿给我看", "en": "Bring me whatever you catch."},
        {"zh": "我们换个价钱谈", "en": "Let's talk price."},
        {"zh": "我这一天还没开张", "en": "I haven't made a sale all day."},
        {"zh": "那只你从哪抓的", "en": "Where did you catch that one?"},
        {"zh": "你的手稳不稳", "en": "Are your hands steady?"},
        {"zh": "别在我们村里乱抓", "en": "Don't net everything in our village."},
        {"zh": "我只做买卖生意", "en": "I only do trade."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打我干什么", "en": "Why did you hit me?"},
        {"zh": "这可不是买卖", "en": "This is no trade."},
        {"zh": "我真的要喊人", "en": "I really will call for help."},
        {"zh": "我的网扯破了", "en": "My net is torn."},
        {"zh": "这一下够我歇半天", "en": "That'll put me down half a day."},
        {"zh": "这一次我认栽", "en": "I'll take the loss this time."},
        {"zh": "请你别再打了", "en": "Stop hitting."},
        {"zh": "我只是个牧蝶人，别动粗。", "en": "I only shepherd butterflies — no rough stuff."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "拿蝶来换，我就看", "en": "Bring butterflies and I'll look."},
        {"zh": "这个东西我不收", "en": "I don't take this."},
        {"zh": "你有几张纸吗", "en": "Do you have paper?"},
        {"zh": "换东西可以，别送", "en": "Trade, not gifts."},
        {"zh": "那只不够成色", "en": "That one isn't good enough."},
        {"zh": "拿近一点给我瞧", "en": "Hold it closer so I can see."},
        {"zh": "我更想要活的", "en": "I'd rather have it alive."},
        {"zh": "你这也算贿赂", "en": "This counts as a bribe."},
        {"zh": "这个价钱可以谈", "en": "The price can be discussed."},
        {"zh": "先让我看看货", "en": "Let me see the goods first."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "哎，你先站稳", "en": "Hey, steady yourself."},
        {"zh": "你撞翻我的网了", "en": "You knocked my net over."},
        {"zh": "我先让到一边", "en": "I'll step aside."},
        {"zh": "小心这片花圃", "en": "Mind this flowerbed."},
        {"zh": "我们都没事吧", "en": "Neither of us hurt?"},
        {"zh": "我的牧杖掉了", "en": "My crook fell."},
        {"zh": "这路上人真多", "en": "Busy on this path."},
        {"zh": "你别急着走开", "en": "Don't rush off."},
        {"zh": "我扶一下篱笆", "en": "Let me steady on the fence."},
        {"zh": "请你走得慢一点", "en": "Walk a little slower."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我就是个牧羊人", "en": "I'm only a shepherd."},
        {"zh": "我忙着做生意", "en": "I'm busy trading."},
        {"zh": "村里的事归村长管", "en": "Village matters go to the headman."},
        {"zh": "这种事你问别人", "en": "Ask someone else."},
        {"zh": "我还得看着羊", "en": "I still have sheep to watch."},
        {"zh": "别耽误我做买卖", "en": "Don't keep me from trade."},
        {"zh": "这些我不太懂", "en": "I don't know much about that."},
        {"zh": "我们换个话题吧", "en": "Let's change the subject."},
        {"zh": "羊还在坡上呢", "en": "The sheep are still on the slope."},
        {"zh": "你去忙你的吧", "en": "Go about your business."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "哎，我自己会走", "en": "Hey, I can walk."},
        {"zh": "我的网还在那儿", "en": "My net is back there."},
        {"zh": "你这样我数不了羊", "en": "I can't count the sheep like this."},
        {"zh": "轻点，我这把老腰", "en": "Easy, my old back."},
        {"zh": "请把我放下来", "en": "Put me down."},
        {"zh": "我的牧杖还插在土里", "en": "My crook is still stuck in the soil."},
        {"zh": "你要带我去哪", "en": "Where are you taking me?"},
        {"zh": "村里会找我的", "en": "The village will look for me."},
        {"zh": "我还有买卖没做完", "en": "I've trade unfinished."},
        {"zh": "到地方我就下来", "en": "I'll step down when we arrive."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你别在我的花圃里乱踩", "en": "Don't trample my flowerbed."},
        {"zh": "站住，先把话说清", "en": "Stop and explain yourself."},
        {"zh": "我不做打架的买卖", "en": "I don't deal in fighting."},
        {"zh": "可我有根牧杖", "en": "But I do have a crook."},
        {"zh": "这是我的地界", "en": "This is my patch."},
        {"zh": "你再动我的网试试", "en": "Touch my net again and see."},
        {"zh": "村里有人会来", "en": "The village will come."},
        {"zh": "我真的要喊人了", "en": "I'm going to call for help."},
        {"zh": "你别逼我动手", "en": "Don't force me to act."},
        {"zh": "我这把年纪也不是好欺负的", "en": "Old as I am, I'm not easy prey."},
        {"zh": "羊都在看着你", "en": "The sheep are watching you."},
        {"zh": "你踩坏的花要赔", "en": "You'll pay for those flowers."},
        {"zh": "过来，我们讲道理", "en": "Come. Let's be reasonable."},
        {"zh": "别以为牧人不会动手", "en": "Don't think a shepherd won't fight."},
        {"zh": "我这就赶你出去", "en": "I'll drive you off."},
        {"zh": "最后一次警告", "en": "Last warning."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我握着牧杖，站住了", "en": "I grip my crook and hold my ground."},
        {"zh": "你手别往网里伸", "en": "Keep your hands out of my net."},
        {"zh": "我认得这些花草", "en": "I know these plants."},
        {"zh": "村里离这儿不远", "en": "The village isn't far."},
        {"zh": "我一喊就有人来", "en": "One shout brings help."},
        {"zh": "你退一步，我们还能谈", "en": "Step back and we can still talk."},
        {"zh": "我把网收起来了", "en": "I've taken in my net."},
        {"zh": "这地界我守了多年", "en": "I've kept this patch for years."},
        {"zh": "你的靴子印还在花上", "en": "Your bootprint is still in the flowers."},
        {"zh": "别踩下第二脚", "en": "Don't take a second step."},
        {"zh": "太阳还没落，人来人往", "en": "Sun's still up; people are about."},
        {"zh": "我年纪大了，眼睛没花", "en": "Old, but my eyes are clear."},
        {"zh": "你后面是篱笆", "en": "There's a fence behind you."},
        {"zh": "牧杖够得到你", "en": "My crook can reach you."},
        {"zh": "我不喜欢惹事", "en": "I dislike trouble."},
        {"zh": "可是我并不害怕", "en": "But I'm not afraid."},
        {"zh": "再走近我就不客气", "en": "Closer and I lose patience."},
        {"zh": "你就站住别动弹", "en": "Just stand still."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "吃我一记牧杖", "en": "Take my crook."},
        {"zh": "这是我唯一会的打法", "en": "It's the only style I know."},
        {"zh": "你踩坏的东西得赔", "en": "You'll pay for the damage."},
        {"zh": "退到篱笆外去", "en": "Get beyond the fence."},
        {"zh": "我这把力气还剩些", "en": "I have some strength left."},
        {"zh": "别再来我的花圃", "en": "Don't come back to my flowerbed."},
        {"zh": "一杖不够就再来", "en": "One crook won't do; here's another."},
        {"zh": "我不是打手，但也不退", "en": "I'm no brawler, but I don't back off."},
        {"zh": "羊全都跑散了", "en": "The sheep have all scattered."},
        {"zh": "这下手重了，抱歉", "en": "That was heavy; my apologies."},
        {"zh": "你就站定别动", "en": "Hold still."},
        {"zh": "够了，你走吧", "en": "Enough. Go."},
        {"zh": "我们在村里再见", "en": "See you in the village."},
        {"zh": "我的网还在那边", "en": "My net is still over there."},
        {"zh": "这一天算白干了", "en": "That's the day wasted."},
        {"zh": "下次别再来了", "en": "Don't come back next time."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我把摊子摆开了", "en": "I've set out my stall."},
        {"zh": "今天的花开得不错", "en": "The flowers are good today."},
        {"zh": "网挂在栅栏上", "en": "My net hangs on the fence."},
        {"zh": "羊在坡上吃草", "en": "The sheep graze the slope."},
        {"zh": "村里该有人来买", "en": "Someone from the village should come."},
        {"zh": "我先看一圈花圃", "en": "Let me check the flowerbed first."},
        {"zh": "风向有点不对", "en": "The wind's a little wrong."},
        {"zh": "这一带的蝶快出来了", "en": "The butterflies here are due soon."},
        {"zh": "我的帽子有点旧了", "en": "My hat is getting old."},
        {"zh": "坡上的草够吃", "en": "There's grass enough on the slope."},
        {"zh": "得把篱笆补一补", "en": "I must patch the fence."},
        {"zh": "一早就来人了", "en": "Someone's come early."},
        {"zh": "东西不多，慢慢卖", "en": "Little stock; I'll sell slowly."},
        {"zh": "今天该能抓几只", "en": "Should catch a few today."},
        {"zh": "我的牧杖还结实", "en": "My crook is still sound."},
        {"zh": "羊叫了，我去看看", "en": "The sheep called; let me look."},
        {"zh": "林子里有翅影", "en": "Wings flicker in the wood."},
        {"zh": "让我先喝口水", "en": "Let me have some water first."}
      ]
    },
