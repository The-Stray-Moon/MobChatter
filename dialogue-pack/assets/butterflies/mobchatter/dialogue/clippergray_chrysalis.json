{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "灰壳几乎看不见。", "en": "My gray casing is nearly invisible."},
        {"zh": "我随着枝子摆。", "en": "I swing with the branch."},
        {"zh": "灰色的棱在暗处。", "en": "Gray ridges in the gloom."},
        {"zh": "一阵风把我推高。", "en": "A gust lifted me."},
        {"zh": "我不走，只是荡。", "en": "I don't walk. I just sway."},
        {"zh": "叶面被我磨出亮。", "en": "I've polished a spot on the leaf."},
        {"zh": "树冠里光线零碎。", "en": "Light falls in bits through the canopy."},
        {"zh": "丛林下面全是根。", "en": "Roots everywhere below the jungle."},
        {"zh": "灰壳和树皮同色。", "en": "My gray matches the bark."},
        {"zh": "雨滴顺着棱流下。", "en": "Rain runs down my ridges."},
        {"zh": "我摆到叶子的边缘。", "en": "I swing to the leaf's edge."},
        {"zh": "一点一点地转。", "en": "Turning little by little."},
        {"zh": "湿气让丝变软。", "en": "The damp has softened the silk."},
        {"zh": "我挂在叶脉左端。", "en": "I hang at the left of the vein."},
        {"zh": "这阵风很慢。", "en": "This gust is slow."},
        {"zh": "灰得几乎被忘了。", "en": "So gray I'm almost forgotten."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "灰色的我停着。", "en": "The gray me holds still."},
        {"zh": "壳上的纹路很细。", "en": "The lines on my casing are fine."},
        {"zh": "里面一直在动。", "en": "It never stops moving inside."},
        {"zh": "我听见树上一层在叫。", "en": "I hear something call above."},
        {"zh": "潮气把我的棱磨平了。", "en": "The damp has worn my ridges."},
        {"zh": "我一动不动最像树皮。", "en": "Holding still makes me look like bark."},
        {"zh": "我又多过了一天。", "en": "Another day has passed."},
        {"zh": "我数着叶子落下。", "en": "I count the falling leaves."},
        {"zh": "壳里面挤得很。", "en": "It's very cramped in here."},
        {"zh": "这里的光很淡。", "en": "The light here is faint."},
        {"zh": "我不需要看见。", "en": "I don't need to see."},
        {"zh": "就快撑开了。", "en": "Nearly splitting open."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "灰色的我在这。", "en": "The gray me is here."},
        {"zh": "你差点没看见我。", "en": "You almost missed me."},
        {"zh": "我的颜色救了我。", "en": "My color has saved me."},
        {"zh": "灰壳一弹就裂，别试。", "en": "A gray shell cracks at a tap; don't try."},
        {"zh": "这层壳一碰就裂。", "en": "This shell cracks at a touch."},
        {"zh": "你要看到什么时候？", "en": "How long will you look?"},
        {"zh": "我在叶子下面。", "en": "I'm under the leaf."},
        {"zh": "我像一块树皮。", "en": "I look like a piece of bark."},
        {"zh": "你的呼吸让我晃。", "en": "Your breath makes me sway."},
        {"zh": "我们互不打扰吧。", "en": "Let's leave each other be."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "灰壳破了一角。", "en": "A corner of gray broke."},
        {"zh": "我被打得乱转。", "en": "The hit spun me."},
        {"zh": "丝线快要断了。", "en": "The silk is nearly cut."},
        {"zh": "里面的东西缩了。", "en": "What's inside recoiled."},
        {"zh": "棱上有白痕。", "en": "A pale line on my ridge."},
        {"zh": "我吊得不稳。", "en": "I'm hanging unsteadily."},
        {"zh": "灰壳裂了，可我还吊着。", "en": "The gray shell is split, but I still hang on."},
        {"zh": "别去碰那个破口。", "en": "Don't touch the break."},
        {"zh": "灰色的我在痛。", "en": "The gray me is hurting."},
        {"zh": "这层壳会撑到时间。", "en": "This shell will last till then."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "灰色壳里没有口器。", "en": "No mouthparts in this gray shell."},
        {"zh": "我不在这个阶段吃。", "en": "I don't eat at this stage."},
        {"zh": "你拿去自己吃。", "en": "You eat it yourself."},
        {"zh": "这味道传不过来。", "en": "The smell doesn't reach me."},
        {"zh": "我里面还满着。", "en": "I'm still full inside."},
        {"zh": "别把叶子摇下来。", "en": "Don't shake the leaf down."},
        {"zh": "我只有等待。", "en": "All I have is waiting."},
        {"zh": "放到树枝上就好。", "en": "Just put it on the branch."},
        {"zh": "我一点也动不了。", "en": "I can't move a bit."},
        {"zh": "灰壳里没有口器，你吃你的。", "en": "No mouthparts in a gray shell; eat yours."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "灰壳被你碰到了。", "en": "You touched my gray casing."},
        {"zh": "我歪到了一边。", "en": "I tilted to one side."},
        {"zh": "棱边磕出白印。", "en": "The ridge left a pale mark."},
        {"zh": "风又把我吹回来。", "en": "The wind pushed me back."},
        {"zh": "别撞这棵树。", "en": "Don't hit this tree."},
        {"zh": "我晃得很乱。", "en": "I'm swinging wildly."},
        {"zh": "丝线有声音。", "en": "The silk made a sound."},
        {"zh": "我以为要掉了。", "en": "I thought I'd fall."},
        {"zh": "你踩着落叶了。", "en": "You're stepping on leaves."},
        {"zh": "灰壳擦着树皮，退不开了。", "en": "My gray shell scrapes the bark; there is no room to give."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "灰色还没散。", "en": "The gray hasn't unfolded."},
        {"zh": "我只是一个壳。", "en": "I'm only a casing."},
        {"zh": "等羽化再说。", "en": "When I've emerged."},
        {"zh": "这层隔着许多事。", "en": "This shell is between many things."},
        {"zh": "你守着也没有用。", "en": "Watching won't help."},
        {"zh": "我连眼睛都没有。", "en": "I don't even have eyes."},
        {"zh": "灰得太不起眼了。", "en": "I'm much too gray to notice."},
        {"zh": "等风季结束。", "en": "When the wet season ends."},
        {"zh": "安静地等吧。", "en": "Wait quietly."},
        {"zh": "会有那一天的。", "en": "That day will come."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我碰也碰不到。", "en": "I can't even touch it."},
        {"zh": "它在落叶里。", "en": "It's in the leaf litter."},
        {"zh": "那东西在落叶里，我看不见。", "en": "It's down in the leaf litter where I can't see."},
        {"zh": "我挂着，不关我的事。", "en": "I just hang here; it's nothing to me."},
        {"zh": "你别去踩到它。", "en": "Don't step on it."},
        {"zh": "它掉下去了。", "en": "It fell."},
        {"zh": "灰色的我看不清。", "en": "The gray me can't see well."},
        {"zh": "我有丝，没有手。", "en": "I have silk, not hands."},
        {"zh": "它会烂掉的。", "en": "It will rot."},
        {"zh": "那东西离我的丝只有一寸。", "en": "That thing lies an inch from my silk."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有影子落在枝上。", "en": "A shadow fell on the branch."},
        {"zh": "这不是风吹的。", "en": "The wind didn't do that."},
        {"zh": "灰壳绷紧了。", "en": "My gray casing tightened."},
        {"zh": "有东西停下来了。", "en": "Something has stopped."},
        {"zh": "我现在很想飞走。", "en": "I badly want to fly now."},
        {"zh": "我现在没有翅膀。", "en": "I have no wings now."},
        {"zh": "我听见了爪声。", "en": "I hear claws."},
        {"zh": "它在往上看。", "en": "It's looking up."},
        {"zh": "我的颜色不显眼。", "en": "My color is dull."},
        {"zh": "就靠这个藏了。", "en": "This is all my cover."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我尽量贴着叶背。", "en": "I press close to the underside."},
        {"zh": "它的爪子刮着树根，还没走。", "en": "Its claws scrape the roots; it hasn't gone."},
        {"zh": "灰壳和树皮一样。", "en": "Gray casing, bark. Same."},
        {"zh": "灰色的我缩在树皮纹里。", "en": "Gray as I am, I shrink into the bark's grooves."},
        {"zh": "它绕了半圈。", "en": "It circled halfway round."},
        {"zh": "叶子挡住了前面。", "en": "The leaf blocks the front."},
        {"zh": "我连棱角都不敢动。", "en": "I don't even twitch a ridge."},
        {"zh": "它慢慢走了。", "en": "It's walking away slowly."},
        {"zh": "我耐心地等着。", "en": "I wait patiently."},
        {"zh": "灰是我的保护色。", "en": "Gray is my camouflage."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "灰色壳轻轻一顶。", "en": "My gray casing nudged back."},
        {"zh": "我没有力气。", "en": "I have no strength."},
        {"zh": "只是撞了一下。", "en": "Only a bump."},
        {"zh": "别把壳压扁。", "en": "Don't squash the casing."},
        {"zh": "这一下也没用。", "en": "That did nothing."},
        {"zh": "我连扭动都难。", "en": "I can barely wriggle."},
        {"zh": "我只有这层壳。", "en": "I have only this shell."},
        {"zh": "棱边是唯一的武器。", "en": "The ridge is my only weapon."},
        {"zh": "我一点也反抗不了。", "en": "I can't resist at all."},
        {"zh": "让我掉下去吧。", "en": "Let me fall."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "灰色的壳突然出现。", "en": "A gray casing is suddenly here."},
        {"zh": "它和树皮分不开。", "en": "It blends into the bark."},
        {"zh": "毛虫选了一个好位置。", "en": "The caterpillar picked a good spot."},
        {"zh": "丝缠在枝条上。", "en": "Silk wound around the twig."},
        {"zh": "丛林给了我灰色。", "en": "The jungle gave me gray."},
        {"zh": "我在叶子底下。", "en": "I'm beneath a leaf."},
        {"zh": "没人注意到我。", "en": "Nobody noticed me."},
        {"zh": "我在等变硬。", "en": "Waiting to harden."},
        {"zh": "暗处最合适。", "en": "The shade suits me best."},
        {"zh": "时间从叶隙漏下来。", "en": "Time leaks through the leaves."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "灰色被烤得发白。", "en": "The gray bleached in the heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我砸在落叶堆里。", "en": "I struck the leaf pile."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "雨水从我裂口渗入。", "en": "Rain seeped into my crack."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "整棵树都晃了一下。", "en": "The whole tree jumped."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "刺尖插进了壳。", "en": "A spike went into the casing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "灰壳里透出怪光。", "en": "Strange light glows in the gray."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "里面积蓄快用尽了。", "en": "My reserves are almost gone."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让灰色变白。", "en": "The flash turned my gray white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶子上滑落。", "en": "I slipped off the leaf."}
      ]
    }
  }
}
