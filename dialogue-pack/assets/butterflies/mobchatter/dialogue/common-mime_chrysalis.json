{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶背，随枝轻晃。", "en": "I hang under a leaf, rocking with the branch."},
        {"zh": "风吹过来，我转了半圈。", "en": "The wind turns me half a circle."},
        {"zh": "我用丝把自己固定住。", "en": "I've fixed myself in place with silk."},
        {"zh": "我这一侧晒到太阳。", "en": "This side of me catches the sun."},
        {"zh": "我在里面慢慢变形。", "en": "Inside, I'm slowly changing."},
        {"zh": "树枝一晃，我也跟着晃。", "en": "The twig sways, and so do I."},
        {"zh": "壳底下有个小小的突起。", "en": "A small bump shows beneath the shell."},
        {"zh": "夜里凉，我缩了一点。", "en": "The night is cool; I shrink a little."},
        {"zh": "雨水顺着叶缘滑开。", "en": "Rain runs off the leaf's edge."},
        {"zh": "我在枝上换了角度。", "en": "I shift angle on the branch."},
        {"zh": "这片叶子快撑不住我了。", "en": "This leaf can barely hold me."},
        {"zh": "我贴着叶脉挂稳了。", "en": "I'm fixed along the leaf vein."},
        {"zh": "风大了一点，我抓紧。", "en": "The wind picks up; I hold tight."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我静静挂在那儿。", "en": "I hang there, still."},
        {"zh": "我在等一个时辰。", "en": "I'm waiting for the right hour."},
        {"zh": "外面有鸟叫。", "en": "Birds call outside."},
        {"zh": "我的颜色变深了一点。", "en": "My colour has deepened a little."},
        {"zh": "一只蚂蚁爬过我的壳。", "en": "An ant walks over my shell."},
        {"zh": "我在里面听风。", "en": "Inside, I listen to the wind."},
        {"zh": "叶子上的露水很重。", "en": "The dew on the leaf is heavy."},
        {"zh": "我还没有要出来的意思。", "en": "I'm not ready to emerge."},
        {"zh": "我的壳有点发亮。", "en": "My shell is faintly glossy."},
        {"zh": "我在里面翻身。", "en": "I turn over inside."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶背，你呼吸太近。", "en": "I hang under the leaf; your breath is too near."},
        {"zh": "我只是个壳。", "en": "I'm only a shell."},
        {"zh": "被你碰到，我就完了。", "en": "If you touch me, that's the end."},
        {"zh": "你的影子盖住了我的叶。", "en": "Your shadow covers my leaf."},
        {"zh": "我在你头顶的叶下。", "en": "I'm under the leaf above you."},
        {"zh": "你看着，我也在等。", "en": "You watch, and I wait."},
        {"zh": "我的壳碰一下就掉。", "en": "One nudge and I'll fall."},
        {"zh": "你退半步就行。", "en": "Just half a step back."},
        {"zh": "我还需要时间。", "en": "I still need time."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "丝线松了一股，我晃了晃。", "en": "A silk thread loosens; I sway."},
        {"zh": "里面的东西缩起来了。", "en": "What's inside pulled in."},
        {"zh": "我没有声音可发。", "en": "I have no sound to make."},
        {"zh": "一点点液体渗出来。", "en": "A little fluid seeps out."},
        {"zh": "我抓紧了丝。", "en": "I grip the silk."},
        {"zh": "叶子帮我挡了一下。", "en": "The leaf took some of it."},
        {"zh": "我还没到出来的时辰。", "en": "It isn't my time yet."},
        {"zh": "这道伤会留下痕迹。", "en": "This will leave a mark."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子上的水珠。", "en": "A bead of water on the leaf."},
        {"zh": "有甜味飘过来。", "en": "Something sweet drifts by."},
        {"zh": "我闻得到，但动不了。", "en": "I can smell it; I can't move."},
        {"zh": "你把水放在叶上。", "en": "Put the water on the leaf."},
        {"zh": "这点湿气够了。", "en": "That much moisture is enough."},
        {"zh": "蛹壳封着，我什么也吃不了。", "en": "My chrysalis is sealed; I can eat nothing."},
        {"zh": "有股淡淡的花香。", "en": "A faint smell of flowers."},
        {"zh": "我在里面缩了一下。", "en": "I twitch inside."},
        {"zh": "你碰了我的叶子。", "en": "You touched my leaf."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞了树枝。", "en": "You knocked the branch."},
        {"zh": "我吊在叶背上，谁也别扯我。", "en": "I hang from a leaf's back; do not tug."},
        {"zh": "叶尖一滑，我差点掉下去。", "en": "The leaf tip slipped; I nearly fell."},
        {"zh": "丝还连着，还好。", "en": "The silk held; good."},
        {"zh": "叶子翻了个面。", "en": "The leaf flipped over."},
        {"zh": "我被压得贴住叶脉。", "en": "I'm pressed against the vein."},
        {"zh": "我的壳磕了一下。", "en": "My shell knocked once."},
        {"zh": "你走开，我才稳住。", "en": "You moved off and I steadied."},
        {"zh": "这下晃了很久。", "en": "That sway lasted a while."},
        {"zh": "裂了一道细纹。", "en": "A hairline crack appeared."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "枝的另一头也有一个壳。", "en": "Another shell hangs on the far branch."},
        {"zh": "我们被风吹向同一边。", "en": "The wind tilts us the same way."},
        {"zh": "她的壳比我小一点。", "en": "Her shell is a little smaller."},
        {"zh": "我们隔着一片叶子。", "en": "One leaf apart."},
        {"zh": "她的颜色和我差不多。", "en": "Her colour is much like mine."},
        {"zh": "我们都在等同一个时辰。", "en": "We're both waiting for the same hour."},
        {"zh": "她的壳先晃了一下。", "en": "Her shell moved first."},
        {"zh": "我们挂在同一根枝上。", "en": "We hang from the same branch."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西落在我旁边。", "en": "Something landed beside me."},
        {"zh": "它掉在叶子的另一头。", "en": "It fell on the far side of the leaf."},
        {"zh": "它滚下叶子了。", "en": "It rolled off the leaf."},
        {"zh": "露水聚在我壳上。", "en": "Dew gathers on my shell."},
        {"zh": "一片碎叶卡在丝里。", "en": "A leaf scrap is caught in my silk."},
        {"zh": "我把它顶开了。", "en": "I pushed it aside."},
        {"zh": "这根丝很结实。", "en": "This thread is strong."},
        {"zh": "树枝上有别的壳。", "en": "Another shell sits on the twig."},
        {"zh": "它的影子落在我身上。", "en": "Its shadow falls on me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有影子在叶外。", "en": "A shadow beyond the leaf."},
        {"zh": "我在壳里能感觉到。", "en": "I can feel it from inside."},
        {"zh": "我的壳有点发紧。", "en": "My shell tightens."},
        {"zh": "它在那里停了很久。", "en": "It stayed there a long while."},
        {"zh": "丘陵的风一吹，我就晃。", "en": "One hill wind and I sway."},
        {"zh": "它还在原处。", "en": "It's still there."},
        {"zh": "哪怕被看见。", "en": "Even if I'm seen."},
        {"zh": "挂在叶上，我暂时只能看着你。", "en": "Stuck to this leaf, I can only watch you for now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它绕到了叶的另一面。", "en": "It moved to the other side of the leaf."},
        {"zh": "我完全不能动。", "en": "I can't move at all."},
        {"zh": "它的影子来回扫。", "en": "Its shadow sweeps back and forth."},
        {"zh": "我的壳是我唯一的墙。", "en": "My shell is my only wall."},
        {"zh": "壳里数着日子，就快羽化了。", "en": "I count the days inside; soon I will emerge."},
        {"zh": "它好像闻到了什么。", "en": "It seems to smell something."},
        {"zh": "我在里面数着。", "en": "I'm counting inside."},
        {"zh": "树枝终于静下来。", "en": "The branch finally went still."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "被压到的壳发出一声脆响。", "en": "The shell cracks, sharp."},
        {"zh": "我里面的东西缩成一团。", "en": "What's inside me curls tight."},
        {"zh": "我的丝断了一边。", "en": "One side of my silk snapped."},
        {"zh": "整片叶子翻了过去。", "en": "The whole leaf flipped."},
        {"zh": "我在半空晃着。", "en": "I swing in the air."},
        {"zh": "裂口越来越长。", "en": "The split grows longer."},
        {"zh": "我挂着一头，没掉。", "en": "I hang by one end."},
        {"zh": "里面开始渗液。", "en": "Fluid begins to seep."},
        {"zh": "这一次很重。", "en": "That one was heavy."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一片叶子上多了一个小挂件。", "en": "A small pendant appears on a leaf."},
        {"zh": "我在枝上结成了壳。", "en": "I've formed a shell on the branch."},
        {"zh": "风把我吹得轻轻摆。", "en": "The wind sways me gently."},
        {"zh": "这里是丘陵的树。", "en": "These are hill trees."},
        {"zh": "我的丝在叶脉上绕紧。", "en": "My silk is wound tight on the vein."},
        {"zh": "周围有别的蝶在飞。", "en": "Other butterflies fly nearby."},
        {"zh": "我落下来时很轻。", "en": "I landed very lightly."},
        {"zh": "阳光从叶缝漏下。", "en": "Sunlight comes through the leaf gaps."},
        {"zh": "我开始等待。", "en": "I begin to wait."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热从一边烤过来，壳变软了。", "en": "Heat comes from one side; my shell softens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶上掉下去，摔在草里。", "en": "I drop from the leaf into the grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "雨水积在壳外，我闷得慌。", "en": "Water pools around me; it's stifling."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把整片叶子掀翻了。", "en": "The blast flips the whole leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物扎穿了壳。", "en": "Something sharp pierces the shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我身边的空气忽然变了。", "en": "The air around me suddenly changes."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我在里面越来越虚。", "en": "I grow weaker inside."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一亮，叶下全白了。", "en": "Lightning whitens everything under the leaf."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有叶，没有枝，只有空。", "en": "No leaf, no branch, only emptiness."}
      ]
    }
  }
}
