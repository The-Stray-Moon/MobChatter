{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拍着翅膀走", "en": "I go on beating wings."},
        {"zh": "我不走，我悬停", "en": "I do not walk; I hover."},
        {"zh": "我停在花前不动", "en": "I hang still before a flower."},
        {"zh": "翅膀快得看不清", "en": "My wings blur with speed."},
        {"zh": "我在花丛中间穿行", "en": "I thread my way among the flowers."},
        {"zh": "我像蜂鸟一样悬着", "en": "I hover like a hummingbird."},
        {"zh": "我一顿一顿地飞", "en": "I fly in fits and pauses."},
        {"zh": "我的花纹在闪", "en": "My markings flicker."},
        {"zh": "我夜里才活跃", "en": "I am lively only at night."},
        {"zh": "我绕一圈再落下", "en": "I circle before settling."},
        {"zh": "我的影子在花上晃", "en": "My shadow wavers on the flowers."},
        {"zh": "我朝着亮处飞过去", "en": "I fly toward the brighter place."},
        {"zh": "我飞得不高，但很稳", "en": "I fly low, but steady."},
        {"zh": "我停在叶上歇一会", "en": "I rest a moment on a leaf."},
        {"zh": "我沿着平原飞", "en": "I cross the plain."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在一朵花前面", "en": "I hover before a blossom."},
        {"zh": "我的翅膀一直没停", "en": "My wings never stop."},
        {"zh": "我正在吸花心的蜜", "en": "I am drinking from the flower's heart."},
        {"zh": "我的长喙伸进花心", "en": "My long tongue goes into the flower."},
        {"zh": "我不用落下也能吃", "en": "I can feed without landing."},
        {"zh": "我的寿命不长", "en": "My life is short."},
        {"zh": "我在花上待了一会儿", "en": "I stayed at the flower a while."},
        {"zh": "我的翅膀发热了", "en": "My wings have warmed."},
        {"zh": "我在夜风里悬着", "en": "I hang in the night wind."},
        {"zh": "我的复眼很大", "en": "My compound eyes are large."},
        {"zh": "我不休息太久", "en": "I do not rest long."},
        {"zh": "我正对着那轮月亮", "en": "I face the moon directly."},
        {"zh": "我的触角在探", "en": "My antennae probe the air."},
        {"zh": "花被我啃掉一点", "en": "I chewed a bit of the flower."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也在这片平原", "en": "You are on this plain too."},
        {"zh": "我的翅膀比你的手快", "en": "My wings are quicker than your hands."},
        {"zh": "你看得见我的花纹吗", "en": "Can you see my markings?"},
        {"zh": "我在你的灯边上", "en": "I am by your light."},
        {"zh": "你抬手是想抓我", "en": "You raised your hand to catch me."},
        {"zh": "你的火把太热", "en": "Your torch is too hot."},
        {"zh": "我在你头顶悬着", "en": "I hang above your head."},
        {"zh": "我一会儿就走", "en": "I will be gone soon."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀裂了", "en": "My wing tore."},
        {"zh": "我掉低了一点", "en": "I dropped a little."},
        {"zh": "我不叫，我只会乱飞", "en": "I cannot cry; I only flutter wildly."},
        {"zh": "鳞粉落了一地", "en": "Scales fell everywhere."},
        {"zh": "我一只翅膀不听使唤", "en": "One wing will not obey."},
        {"zh": "我撞到了花上", "en": "I hit a flower."},
        {"zh": "我必须停下来歇会", "en": "I must stop and rest."},
        {"zh": "这一下伤到我的翅脉", "en": "That hit my veins."},
        {"zh": "我再也飞不快了", "en": "I can no longer fly fast."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是一朵花吗", "en": "Is that a flower?"},
        {"zh": "我只喝花里的蜜", "en": "I only drink nectar from flowers."},
        {"zh": "这味道勾住我了", "en": "That scent has me."},
        {"zh": "我悬在它上方", "en": "I hover above it."},
        {"zh": "我先绕一圈再靠近", "en": "I circle once before closing."},
        {"zh": "我更喜欢蓝花美耳草", "en": "Blue-eyed grass suits me better."},
        {"zh": "这朵我吃一口", "en": "One sip from this."},
        {"zh": "我把花吃掉了", "en": "I ate the flower."},
        {"zh": "蜜不多，但够了", "en": "Little nectar, but enough."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我的翅膀了，悬停都乱了。", "en": "You touched my wings; my hover broke."},
        {"zh": "我偏了一下，又稳住", "en": "I veered, then steadied."},
        {"zh": "我的翅膀很脆", "en": "My wings are fragile."},
        {"zh": "粉沾到你手上了", "en": "Dust came off on your hand."},
        {"zh": "我们撞了一下，很轻", "en": "A light collision."},
        {"zh": "你的呼吸把我吹偏了", "en": "Your breath pushed me off."},
        {"zh": "别撞我翅膀，我正悬停呢。", "en": "Mind my wings, I'm hovering here."},
        {"zh": "碰落的花蜜，你得赔。", "en": "Knock the nectar loose and you owe me for it."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的时间很短", "en": "My time is short."},
        {"zh": "我飞这一圈就是为了这个", "en": "This flight is for that."},
        {"zh": "我在找同类的气味", "en": "I am hunting my own kind's scent."},
        {"zh": "你也看见我了吗", "en": "Did you see me too?"},
        {"zh": "我们追着飞了一段", "en": "We flew in chase for a while."},
        {"zh": "这一夜就足够了", "en": "One night is all it takes."},
        {"zh": "我没时间停留", "en": "I have no time to linger."},
        {"zh": "花粉是我们的信", "en": "Pollen is our letter."},
        {"zh": "你能别打扰吗", "en": "Will you not interfere?"},
        {"zh": "我的翅膀累了", "en": "My wings are tired."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下来也拿不动", "en": "Landing does not help me carry it."},
        {"zh": "爪子太小，抓不住", "en": "My feet are too small to grip."},
        {"zh": "我只想找些蜜喝", "en": "I only want nectar to drink."},
        {"zh": "这东西太重了", "en": "This is too heavy."},
        {"zh": "我试着提了一下", "en": "I tried to lift it."},
        {"zh": "它晃了晃，没动", "en": "It wobbled and stayed."},
        {"zh": "我只好自己飞开", "en": "So I simply fly away."},
        {"zh": "你捡吧，我等你", "en": "Pick it up; I will wait."},
        {"zh": "我落在旁边看", "en": "I land beside it and watch."},
        {"zh": "别用网子罩我", "en": "Do not use a net on me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我锁定的是一朵花", "en": "I have fixed on a flower."},
        {"zh": "不是你不是你", "en": "Not you, not you."},
        {"zh": "我绕着这朵花飞", "en": "I circle around this flower."},
        {"zh": "你别站到花前面", "en": "Do not stand before the flower."},
        {"zh": "这一朵是新的", "en": "This one is new."},
        {"zh": "我要靠得很近", "en": "I must get very close."},
        {"zh": "我的喙够得着", "en": "My tongue can reach."},
        {"zh": "这朵花开得有点高", "en": "This flower grows a little high."},
        {"zh": "我慢一点下去", "en": "I descend slowly."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我换了一朵花", "en": "I moved to another flower."},
        {"zh": "我沿着花丛飞", "en": "I follow the flower patch."},
        {"zh": "我停一下再走", "en": "I pause, then move on."},
        {"zh": "我听见嗡嗡声", "en": "I hear humming."},
        {"zh": "那不是我的同类", "en": "That is not one of my kind."},
        {"zh": "我躲开那片叶", "en": "I avoid that leaf."},
        {"zh": "风把我的方向改了", "en": "The wind changed my course."},
        {"zh": "我快没力气了", "en": "I am running low."},
        {"zh": "我得先飞走了", "en": "I have to fly off now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞在你脸上", "en": "I blunder into your face."},
        {"zh": "我这点力气不够看", "en": "What little strength I have is nothing."},
        {"zh": "翅膀拍到你眼睛", "en": "My wings brushed your eyes."},
        {"zh": "这连碰都算不上", "en": "That barely counts as a touch."},
        {"zh": "你挥手把我打开了", "en": "You swatted me away."},
