{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱着皮革，穿过村子。", "en": "I carry hides across the village."},
        {"zh": "肩上的皮子，还有味。", "en": "The hides on my shoulder still smell."},
        {"zh": "我的围裙上全是染料。", "en": "My apron is stained with dye."},
        {"zh": "我去工作台那边看看。", "en": "I'm off to the workbench."},
        {"zh": "村里今天很热闹。", "en": "Busy in the village today."},
        {"zh": "我一边走，一边算账。", "en": "I walk and count my stock."},
        {"zh": "皮子要晒足太阳。", "en": "Hides need full sun."},
        {"zh": "我走得不快，怕褶了皮。", "en": "Slow steps so the hide won't crease."},
        {"zh": "鞋底的皮，是我自己缝的。", "en": "I stitched my own soles."},
        {"zh": "我绕开泥坑。", "en": "I step around the puddles."},
        {"zh": "有人在收蝴蝶，我也去看看。", "en": "Someone's collecting butterflies; I'll look."},
        {"zh": "我一手抱着卷好的皮。", "en": "I carry a rolled hide in one arm."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我捶着皮子，咚咚响。", "en": "I beat the hide; it thumps."},
        {"zh": "刀子在磨石上走。", "en": "My knife runs over the whetstone."},
        {"zh": "这味道，我早闻惯了。", "en": "I'm used to this smell."},
        {"zh": "一张皮，要揉很久。", "en": "A hide takes long to work soft."},
        {"zh": "我掂了掂成色。", "en": "I weigh the quality in my hand."},
        {"zh": "货架上还缺几卷。", "en": "A few rolls short on the shelf."},
        {"zh": "我擦了擦手上的油。", "en": "I wipe the oil off my hands."},
        {"zh": "今天生意还行。", "en": "Not a bad day's trade."},
        {"zh": "皮边裁得整齐。", "en": "The edges are cut neat."},
        {"zh": "我数了数绿宝石。", "en": "I count my emeralds."},
        {"zh": "有只蝴蝶飞过摊子。", "en": "A butterfly crosses my stall."},
        {"zh": "我把皮子翻了个面。", "en": "I turn the hide over."},
        {"zh": "锤子放下，歇口气。", "en": "Hammer down; a short rest."},
        {"zh": "风把架子吹得轻响。", "en": "The wind rattles my rack."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "要买皮子吗？", "en": "Buying leather?"},
        {"zh": "你这身衣裳，补过几次？", "en": "How often have those clothes been patched?"},
        {"zh": "我看看你的靴子。", "en": "Let me see your boots."},
        {"zh": "你手上有茧，是干活的。", "en": "Calluses — you work for a living."},
        {"zh": "上好皮革，换绿宝石。", "en": "Fine leather for emeralds."},
        {"zh": "你要的是硬皮还是软皮？", "en": "Hard hide or soft?"},
        {"zh": "别摸，那是刚染的。", "en": "Don't touch; it's freshly dyed."},
        {"zh": "我这儿也收蝴蝶翅膀。", "en": "I take butterfly wings too."},
        {"zh": "你身上有股林子味。", "en": "You smell of the woods."},
        {"zh": "想换什么，直说。", "en": "Just tell me what you want."},
        {"zh": "这价，已经很公道了。", "en": "That price is already fair."},
        {"zh": "你的钱袋，看着不轻。", "en": "Your purse looks heavy."},
        {"zh": "我认得村里的每一张脸。", "en": "I know every face here."},
        {"zh": "你是外面来的吧。", "en": "You're from outside, aren't you?"},
        {"zh": "有货就拿出来。", "en": "Show me your goods."},
        {"zh": "我这儿不收欠条。", "en": "I don't take promises here."},
        {"zh": "这活儿，得细心。", "en": "This work needs care."},
        {"zh": "你要是识货，就好谈。", "en": "If you know quality, we'll deal."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮子撒了一地。", "en": "My hides spill everywhere."},
        {"zh": "哎，我的胳膊。", "en": "Ow — my arm."},
        {"zh": "这点伤，我能忍。", "en": "I can bear this."},
        {"zh": "我缩到摊子角落里。", "en": "I shrink into the stall's corner."},
        {"zh": "围裙上多了道口子。", "en": "A slash in my apron."},
        {"zh": "我扯着嗓子喊了一嗓。", "en": "I shout at the top of my lungs."},
        {"zh": "货物比伤口要紧。", "en": "The goods matter more than the wound."},
        {"zh": "我按住伤口。", "en": "I press the wound."},
        {"zh": "今天做不成生意了。", "en": "No trade today."},
        {"zh": "我咬咬牙，站稳。", "en": "I grit my teeth and stand."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这点东西，换不了一张皮。", "en": "That won't buy a hide."},
        {"zh": "你拿食物来做什么？", "en": "Why bring food to a trade?"},
        {"zh": "我柜里存着半年的口粮。", "en": "I've six months of rations in the back."},
        {"zh": "你把东西摊开，我看看。", "en": "Lay it out; let me see."},
        {"zh": "绿宝石才是我要的。", "en": "Emeralds are what I want."},
        {"zh": "这点，够买半张。", "en": "That buys half a hide."},
        {"zh": "你出得太低了。", "en": "Your offer is too low."},
        {"zh": "这张皮我熨过三遍，不能贱卖。", "en": "I've pressed this hide three times; I won't sell it cheap."},
        {"zh": "成交，拿走吧。", "en": "Done — take it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "哎，我的皮子！", "en": "Hey — my hides!"},
        {"zh": "别挤，摊子要倒了。", "en": "Don't crowd; the stall will tip."},
        {"zh": "我扶住了架子。", "en": "I caught the rack."},
        {"zh": "路窄，慢慢过。", "en": "Narrow path; go slowly."},
        {"zh": "撞一下，皮上多了折痕。", "en": "A bump leaves a crease."},
        {"zh": "我退到摊子后面。", "en": "I step behind the stall."},
        {"zh": "这点碰撞，常有的事。", "en": "Bumps like that are common."},
        {"zh": "你没磕着哪儿吧？", "en": "Did you knock anything?"},
        {"zh": "让一让，我搬货。", "en": "Make way; I'm hauling stock."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "村里人成家，都找我做皮衣。", "en": "Villagers come to me for wedding leather."},
        {"zh": "我给她留了块最软的皮。", "en": "I've kept the softest hide for her."},
        {"zh": "日子得慢慢过。", "en": "Life is lived slowly."},
        {"zh": "摊子得有人照看。", "en": "Someone must mind the stall."},
        {"zh": "她嫌我这里味道重。", "en": "She says it smells in here."},
        {"zh": "两个人，饭也香些。", "en": "A meal tastes better shared."},
        {"zh": "这门手艺，得有人接。", "en": "Someone must inherit this craft."},
        {"zh": "她手比我巧。", "en": "Her hands are nimbler than mine."},
        {"zh": "我们不急，来日方长。", "en": "No hurry; there's time."},
        {"zh": "门外风大，进来坐。", "en": "Windy out; come sit inside."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块边角料，还能用。", "en": "This offcut is still usable."},
        {"zh": "我弯腰，膝盖响了。", "en": "I bend; my knees creak."},
        {"zh": "地上的钉子，得捡。", "en": "A nail on the floor — must pick it up."},
        {"zh": "我把它收进抽屉。", "en": "I put it in the drawer."},
        {"zh": "一小卷线，别浪费。", "en": "A small spool — no waste."},
        {"zh": "掉在地上的皮，我拍干净。", "en": "I dust off the dropped hide."},
        {"zh": "这东西，能换几个钱。", "en": "This could fetch a few coins."},
        {"zh": "我数了数，少一块。", "en": "I count them; one is missing."},
        {"zh": "捡起来，放回架上。", "en": "Pick it up and back on the shelf."},
        {"zh": "手上有油，滑了一下。", "en": "Oily hands; it slips."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你盯着我的货做什么？", "en": "Why are you staring at my stock?"},
        {"zh": "这摊子，我守着。", "en": "I mind this stall."},
        {"zh": "别靠得太近。", "en": "Don't come too close."},
        {"zh": "我手上有刀。", "en": "I have a knife in hand."},
        {"zh": "村里的人都认识我。", "en": "Everyone here knows me."},
        {"zh": "你要闹，我就喊守卫。", "en": "Cause trouble and I call the guard."},
        {"zh": "我退到柜台后。", "en": "I step behind the counter."},
        {"zh": "这东西，不卖给你。", "en": "This isn't for sale to you."},
        {"zh": "你这双手，我盯住了。", "en": "I've got my eye on those hands."},
        {"zh": "别以为村里没人管。", "en": "Don't think no one's watching."},
        {"zh": "你这张脸我记下了。", "en": "I've taken note of your face."},
        {"zh": "铁傀儡就在附近。", "en": "An iron golem is close by."},
        {"zh": "你要买，就好好说。", "en": "If you're buying, speak properly."},
        {"zh": "货在，人在。", "en": "The goods are here; so am I."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛没从你手上移开。", "en": "My eyes haven't left your hands."},
        {"zh": "这摊子后面有门。", "en": "There's a door behind this stall."},
        {"zh": "我的刀，不是装饰。", "en": "This knife isn't decoration."},
        {"zh": "我手里的皮革，还没鞣完。", "en": "The hide in my hands isn't tanned yet."},
        {"zh": "村里没人是好惹的。", "en": "No one here is easy to rob."},
        {"zh": "我的手没抖。", "en": "My hands aren't shaking."},
        {"zh": "你再转一圈，我就喊了。", "en": "One more lap and I shout."},
        {"zh": "这块地方，我熟。", "en": "I know this ground."},
        {"zh": "我听着你鞋底的动静。", "en": "I'm listening to your boot soles."},
        {"zh": "别在摊子前磨蹭。", "en": "Don't loiter by the stall."},
        {"zh": "我数到三就要喊人。", "en": "On three I start shouting."},
        {"zh": "你要走，现在就走。", "en": "If you're leaving, leave now."},
        {"zh": "天快擦黑了。", "en": "It's nearly dusk."},
        {"zh": "我把刀换了个手握。", "en": "I switch the knife to my other hand."},
        {"zh": "这局面，不好看。", "en": "This looks bad."},
        {"zh": "最后一句，走开。", "en": "Last word: walk away."},
        {"zh": "我不喜欢动手。", "en": "I don't like using this."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿刀划过去！", "en": "I slash with my knife!"},
        {"zh": "锤子也能当武器。", "en": "A hammer works as a weapon."},
        {"zh": "别碰我的货！", "en": "Hands off my stock!"},
        {"zh": "这一下，是护摊子。", "en": "That one was to guard the stall."},
        {"zh": "我打了就跑。", "en": "I strike and back off."},
        {"zh": "皮围裙挡了一下。", "en": "My leather apron took the blow."},
        {"zh": "村里会有人来。", "en": "The village will come."},
        {"zh": "是你逼我动刀的。", "en": "You made me draw the knife."},
        {"zh": "我出手很笨，但很狠。", "en": "Clumsy, but vicious."},
        {"zh": "刀不快，也够用。", "en": "Not sharp, but enough."},
        {"zh": "我退到门边。", "en": "I retreat to the doorway."},
        {"zh": "这一刀，割破你的袖子。", "en": "That cut your sleeve."},
        {"zh": "我不是战士。", "en": "I'm no fighter."},
        {"zh": "够了，快走。", "en": "Enough — go."},
        {"zh": "我嗓子里全是喘。", "en": "My throat is all panting."},
        {"zh": "别逼我再动手。", "en": "Don't make me swing again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我把摊子支起来了。", "en": "I've set up my stall."},
        {"zh": "皮革的味道先到。", "en": "The smell of hide arrives first."},
        {"zh": "今天该开张了。", "en": "Time to open for the day."},
        {"zh": "我把刀摆在手边。", "en": "I lay the knife within reach."},
        {"zh": "村里的人还没起。", "en": "The village isn't up yet."},
        {"zh": "新的一批皮，刚到。", "en": "A new batch of hides just came."},
        {"zh": "我擦了擦工作台。", "en": "I wipe the bench."},
        {"zh": "这一片，就我一个人做皮。", "en": "I'm the only leatherworker here."},
        {"zh": "架子摆正，货码好。", "en": "Rack straight, stock stacked."},
        {"zh": "袖子一挽，就开工了。", "en": "Sleeves rolled up, I start work."},
        {"zh": "有客人来了吗？", "en": "Any customers?"},
        {"zh": "天不错，适合晒皮。", "en": "Good weather for drying hides."},
        {"zh": "我把围裙系紧。", "en": "I tighten my apron."},
        {"zh": "门板卸下来，就是摊子。", "en": "The shutter comes off; the stall is open."},
        {"zh": "我咳嗽了一声。", "en": "I clear my throat."},
        {"zh": "这味道，得散一散。", "en": "This smell needs airing."},
        {"zh": "铁傀儡从门前走过。", "en": "An iron golem passes the door."},
        {"zh": "我做这行，十几年了。", "en": "I've done this trade for years."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到皮子，味更难闻了。", "en": "Fire hits the hides; the smell worsens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，屁股先着地。", "en": "I land on my backside."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "呛了几口水，我乱扑。", "en": "I choke and thrash."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "架子全倒了，货也毁了。", "en": "The rack topples; my stock is ruined."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎穿我的袖子。", "en": "An arrow pins my sleeve."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我头晕。", "en": "That force makes me dizzy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得手发抖，割歪了。", "en": "Hungry hands cut crooked."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我掉下去。", "en": "The ground's gone; I fall."}
      ]
    }
  }
}
