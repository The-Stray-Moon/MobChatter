{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我被丝钉在叶下，动不了", "en": "Silk pins me under the leaf; I can't move."},
        {"zh": "我不是走，我是在里面变", "en": "I'm not walking; I'm changing inside."},
        {"zh": "叶子晃，我跟着晃", "en": "The leaf sways, and so do I."},
        {"zh": "壳里的我已经不是毛虫了", "en": "What's inside isn't a larva anymore."},
        {"zh": "我挂在叶脉边上", "en": "I hang by a vein."},
        {"zh": "一阵风，我就转半圈", "en": "One gust and I turn halfway around."},
        {"zh": "外壳在慢慢变硬", "en": "The shell is hardening."},
        {"zh": "我动不了，但里面很忙", "en": "I can't move, but it's busy in here."},
        {"zh": "丝线是我自己结的", "en": "I spun this silk myself."},
        {"zh": "别摇这根树枝", "en": "Don't shake this branch."},
        {"zh": "叶下的阴凉刚刚好", "en": "The shade under the leaf is just right."},
        {"zh": "我在等时间过去", "en": "I'm waiting for time to pass."},
        {"zh": "里面的翅膀还没展开", "en": "The wings inside haven't spread yet."},
        {"zh": "我一天比一天轻", "en": "I grow lighter each day."},
        {"zh": "这层壳是褐色的", "en": "This shell is brown."},
        {"zh": "挂在这里，谁也搬不走我", "en": "Hanging here, no one can move me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我静静地挂着", "en": "I hang in silence."},
        {"zh": "里面在重新拼装", "en": "Things are being reassembled inside."},
        {"zh": "我的毛虫身子正在化开", "en": "My larval body is dissolving."},
        {"zh": "翅膀的纹路正在形成", "en": "Wing patterns are forming."},
        {"zh": "我没法跑，也没想跑", "en": "I can't run, and I don't want to."},
        {"zh": "叶子的气孔在呼吸", "en": "The leaf's pores breathe."},
        {"zh": "太阳照不到我", "en": "The sun doesn't reach me."},
        {"zh": "时间会把我推出去", "en": "Time will push me out."},
        {"zh": "我的壳上有细小的纹", "en": "Fine ridges mark my shell."},
        {"zh": "我不吃也不喝", "en": "I neither eat nor drink."},
        {"zh": "外面的世界还在动", "en": "The world outside still moves."},
        {"zh": "再等等就到了", "en": "A little longer now."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你盯着一个茧干什么", "en": "Why stare at a cocoon?"},
        {"zh": "我出不来，也躲不掉", "en": "I can't get out, and can't hide."},
        {"zh": "别用手指戳我", "en": "Don't poke me with a finger."},
        {"zh": "我的外壳很薄", "en": "My shell is thin."},
        {"zh": "你可以看着，别碰", "en": "You may watch; don't touch."},
        {"zh": "里面那个我快成形了", "en": "The me inside is nearly formed."},
        {"zh": "你要等吗，还要些时候", "en": "Waiting? It'll be a while."},
        {"zh": "我被固定在这里", "en": "I'm fixed in place."},
        {"zh": "你动叶子，我就完了", "en": "Move the leaf and I'm finished."},
        {"zh": "我只是暂时的样子", "en": "I'm only a temporary shape."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "里面的我缩了一下", "en": "The me inside flinched."},
        {"zh": "这点伤，会毁掉全部", "en": "This could ruin everything."},
        {"zh": "震动让我难受", "en": "The shaking is unbearable."},
        {"zh": "我挂在丝上晃", "en": "I swing on the silk."},
        {"zh": "我听见壳在响", "en": "I hear the shell creak."},
        {"zh": "别再来第二次", "en": "Don't do that again."},
        {"zh": "我的丝拉得很紧", "en": "My silk is stretched tight."},
        {"zh": "时间被打断了", "en": "The timing's been broken."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "蜜在花里，我在壳里", "en": "Nectar's in flowers; I'm in a shell."},
        {"zh": "举着花也没用", "en": "Holding a flower won't help."},
        {"zh": "这一阶段我什么都不吃", "en": "At this stage I eat nothing."},
        {"zh": "你不如放着它", "en": "Better to leave it."},
        {"zh": "我闻得到，可我不能动", "en": "I smell it, but I can't move."},
        {"zh": "这味道让我想飞", "en": "That smell makes me want to fly."},
        {"zh": "再过一阵子吧", "en": "In a little while."},
        {"zh": "放到花边，我出去就吃", "en": "Put it by the flower; I'll eat once out."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到叶子，我被摇醒了", "en": "You hit the leaf and shook me awake."},
        {"zh": "我没有办法回应", "en": "I can't respond."},
        {"zh": "壳被碰了一下", "en": "The shell was touched."},
        {"zh": "我离地不高，但摔不得", "en": "I'm not high, but I mustn't fall."},
        {"zh": "这点晃动，还能忍", "en": "I can bear this much swaying."},
        {"zh": "你推树枝，我晃了很久", "en": "You pushed the branch; I swayed a long time."},
        {"zh": "我贴得还算牢", "en": "I'm holding on well enough."},
        {"zh": "别用工具来敲", "en": "Don't tap with a tool."},
        {"zh": "这碰触，我记不住是谁", "en": "I can't tell who touched me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还没有出来", "en": "I'm not out yet."},
        {"zh": "这层壳里谈不了这些", "en": "Can't discuss that inside a shell."},
        {"zh": "等我变成蛾子", "en": "Wait until I'm a moth."},
        {"zh": "我连眼睛都还没用上", "en": "I haven't even used my eyes yet."},
        {"zh": "壳里面太挤了", "en": "It's too cramped in here."},
        {"zh": "别把我和别的茧放一起", "en": "Don't put me with other cocoons."},
        {"zh": "我还不知道自己会是什么样", "en": "I don't yet know what I'll look like."},
        {"zh": "等我飞起来再说", "en": "After I fly."},
        {"zh": "现在只有时间", "en": "Right now, only time."},
        {"zh": "安静点，我在变", "en": "Quiet; I'm changing."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我动不了，捡不了", "en": "I can't move, so I can't pick up."},
        {"zh": "我连爬的力气都没了", "en": "I've no strength even to crawl."},
        {"zh": "这东西离我太远", "en": "That's too far from me."},
        {"zh": "你要是想给我，放到叶边", "en": "Put it on the leaf edge if you like."},
        {"zh": "我现在只收时间", "en": "All I collect now is time."},
        {"zh": "我的脚已经贴在壳里", "en": "My feet are fused into the shell."},
        {"zh": "地上的东西，与我无关", "en": "What's on the ground is none of my concern."},
        {"zh": "有点痒，是里面的翅膀", "en": "A tickle; the wings inside."},
        {"zh": "我什么也抓不住", "en": "I can't hold a thing."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我连转向都做不到", "en": "I can't even turn."},
        {"zh": "你把叶子摇得太狠", "en": "You shook the leaf too hard."},
        {"zh": "我只能在这里看着你", "en": "I can only watch from here."},
        {"zh": "我的壳能挡一点", "en": "My shell can block a little."},
        {"zh": "你要是踩下来，我就完了", "en": "If you step on me, I'm done."},
        {"zh": "我不反击，也反击不了", "en": "I won't fight back; I can't."},
        {"zh": "我的丝还结实", "en": "My silk is still strong."},
        {"zh": "再摇，我就掉", "en": "Shake again and I'll drop."},
        {"zh": "你不必怕一个茧", "en": "You needn't fear a cocoon."},
        {"zh": "等我出来就不一样了", "en": "It'll be different once I'm out."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直朝着叶子那边", "en": "I'm fixed facing the leaf."},
        {"zh": "我在茧里听见你的脚步。", "en": "I hear your steps from inside the cocoon."},
        {"zh": "我里面有东西在动", "en": "Something inside me is moving."},
        {"zh": "时间不站在你那边", "en": "Time isn't on your side."},
        {"zh": "你越等，我越接近出来", "en": "The longer you wait, the closer I am."},
        {"zh": "我闻得到你的味道", "en": "I can smell you."},
        {"zh": "你在犹豫要不要碰我", "en": "You're deciding whether to touch me."},
        {"zh": "碰了，就前功尽弃", "en": "Touch me, and it's all undone."},
        {"zh": "再等一会，我就自己来", "en": "Wait a bit; I'll come to you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用壳撞你一下", "en": "I bump you with my shell."},
        {"zh": "这几乎不算攻击", "en": "This hardly counts as an attack."},
        {"zh": "我晃过去，碰了你", "en": "I swung and touched you."},
        {"zh": "里面的翅膀在挣", "en": "The wings inside are struggling."},
        {"zh": "外壳裂开了一点", "en": "The shell cracked a little."},
        {"zh": "我掉下来，砸到你脚上", "en": "I dropped onto your foot."},
        {"zh": "这点分量，你自己掂量", "en": "That's all the weight I have."},
        {"zh": "我连痛都反应不了", "en": "I can't even react to pain."},
        {"zh": "再摇，我就提前出来", "en": "Shake more, and I'll emerge early."},
        {"zh": "这一次，是我自己挣开的", "en": "This time I broke free myself."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "丝线刚刚凝固", "en": "The silk has only just set."},
        {"zh": "我挂在叶子背面", "en": "I hang on the leaf's underside."},
        {"zh": "外面还是绿的，我在变褐", "en": "It's green outside; I'm turning brown."},
        {"zh": "时间从我身上走过", "en": "Time passes over me."},
        {"zh": "我什么都不做，只是等", "en": "I do nothing but wait."},
        {"zh": "这一小团，是一只蛾子", "en": "This little bundle is a moth."},
        {"zh": "壳里偶尔有动静", "en": "Something stirs inside the shell."},
        {"zh": "平原的树上多了一个茧", "en": "One more cocoon on the plains trees."},
        {"zh": "我能感觉到温度", "en": "I can feel the temperature."},
        {"zh": "离羽化还有一段", "en": "Metamorphosis is still some way off."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水渗进了壳里", "en": "Water seeps into the shell."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把叶子都震掉了", "en": "The blast shook the leaves loose."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎穿了我", "en": "Something pierced through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "里面的变化被搅乱了", "en": "The change inside got scrambled."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光透过叶子闪了一下", "en": "Lightning flashed through the leaf."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "丝断了，我在下坠", "en": "The silk snapped; I'm falling."}
      ]
    }
  }
}
