{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "红色一闪，就飞过去了。", "en": "A flash of red, and I am past."},
        {"zh": "我专挑最亮的花飞。", "en": "I pick the brightest flowers."},
        {"zh": "翅上的白带像一道划痕。", "en": "A white band cuts across my wing."},
        {"zh": "我飞得又急又轻。", "en": "I fly quick and light."},
        {"zh": "丛林里的红最醒目。", "en": "Red is the boldest color in the jungle."},
        {"zh": "我绕过藤，贴着叶面飞。", "en": "I round the vines, low over leaves."},
        {"zh": "我一口气飞过整片花。", "en": "I cross the whole flower patch in one go."},
        {"zh": "翅膀几乎不减速。", "en": "My wings barely slow."},
        {"zh": "我停在半空看了下。", "en": "I hover to check my line."},
        {"zh": "我往回飞了一小段。", "en": "I double back a short way."},
        {"zh": "红色的影子成一条线。", "en": "My red shadow draws a line."},
        {"zh": "我比同族更没耐心。", "en": "I have less patience than my kin."},
        {"zh": "我撞进阳光里。", "en": "I break into the sunlight."},
        {"zh": "我滑过树冠的缺口。", "en": "I glide over a gap in the canopy."},
        {"zh": "去哪朵花，我一眼就定。", "en": "One glance decides my flower."},
        {"zh": "我忽上忽下地飞。", "en": "I bob up and down."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "红色在绿叶上很扎眼。", "en": "Red stands out hard against green."},
        {"zh": "我停在一枚红叶上。", "en": "I rest on a red leaf."},
        {"zh": "我的翅缘有点磨损。", "en": "My wing edge is a little worn."},
        {"zh": "这一朵快谢了。", "en": "This flower is nearly done."},
        {"zh": "我急，可风还没来。", "en": "I am restless, but the wind is late."},
        {"zh": "我性子急，站不久。", "en": "I am impatient. I do not perch long."},
        {"zh": "触角扫了一下空气。", "en": "An antenna sweeps the air."},
        {"zh": "蜜够甜，就是太少。", "en": "Sweet, but too little."},
        {"zh": "我把翅上的灰抖干净。", "en": "I shake the dust from my wings."},
        {"zh": "这块地方花不多。", "en": "Few flowers in this spot."},
        {"zh": "树上有只鸟在叫。", "en": "A bird calls in the tree."},
        {"zh": "我想走了。", "en": "I want to move on."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上没有红。", "en": "There is no red on you."},
        {"zh": "我一下就记住你的位置。", "en": "I have your position at once."},
        {"zh": "别动那朵红花。", "en": "Leave the red flower alone."},
        {"zh": "我在你左边的枝上。", "en": "I am on the branch to your left."},
        {"zh": "我比你抬手快。", "en": "I am quicker than your hand."},
        {"zh": "你眨眼的时候我就能换位置。", "en": "I can shift between your blinks."},
        {"zh": "你挡了我的路线。", "en": "You are in my flight line."},
        {"zh": "我不喜欢磨蹭。", "en": "I dislike dawdling."},
        {"zh": "我绕过去，不想碰你。", "en": "I go around. I would rather not touch you."},
        {"zh": "我盯上那朵花了。", "en": "I have my eye on that flower."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅皱了一块。", "en": "A wing is crumpled."},
        {"zh": "红色掉在地上。", "en": "Red dust falls to the ground."},
        {"zh": "我红色的翅打不直了。", "en": "My red wings will not straighten."},
        {"zh": "我落在一片叶上喘。", "en": "I land on a leaf to catch my breath."},
        {"zh": "我翅上的白带扯开一角。", "en": "A corner of my white band is ripped."},
        {"zh": "我不停地抖翅。", "en": "I keep shivering my wings."},
        {"zh": "翅上的白带断了一截。", "en": "The white band is broken."},
        {"zh": "我还能飞，只是慢。", "en": "I can still fly, only slowly."},
        {"zh": "别碰。", "en": "Do not touch."},
        {"zh": "我落在叶子上一动不动。", "en": "I drop onto a leaf and hold still."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那朵红得对。", "en": "That red is the right red."},
        {"zh": "我直接飞过去了。", "en": "I go straight to it."},
        {"zh": "别把花捏坏。", "en": "Do not bruise the flower."},
        {"zh": "我要红的，不要别的。", "en": "Red. Not the others."},
        {"zh": "一小口。", "en": "One small sip."},
        {"zh": "我舔了两次。", "en": "I sip twice."},
        {"zh": "这蜜很浓。", "en": "The nectar is rich."},
        {"zh": "这朵我要记住位置。", "en": "I will remember where this one is."},
        {"zh": "你别动，我就落。", "en": "Hold still and I land."},
        {"zh": "这一朵最合我意。", "en": "This one suits me best."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰掉了我的翅粉。", "en": "You knocked off my dust."},
        {"zh": "红色的粉撒了出去。", "en": "Red dust scatters."},
        {"zh": "我被撞得退了半格。", "en": "The knock sets me back half a block."},
        {"zh": "我稳住，又飞起来。", "en": "I steady, then rise."},
        {"zh": "别拿网挥。", "en": "Do not swing a net."},
        {"zh": "我几乎撞到你的脸。", "en": "I nearly hit your face."},
        {"zh": "我掉头绕回那片花。", "en": "I double back to the flowers."},
        {"zh": "这一下震得我发懵。", "en": "That rattled me."},
        {"zh": "我落在你手背上。", "en": "I land on the back of your hand."},
        {"zh": "你手太快。", "en": "Your hand is too quick."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "红配红才显眼。", "en": "Red with red stands out."},
        {"zh": "我得先吃饱。", "en": "I must eat first."},
        {"zh": "叶子上才产卵。", "en": "Eggs go on leaves."},
        {"zh": "我绕着树冠飞了一圈。", "en": "I circle the canopy once."},
        {"zh": "还没找到合适的。", "en": "I have not found the right one."},
        {"zh": "我急，可这事急不来。", "en": "I am impatient, but this cannot be rushed."},
        {"zh": "我停在半空。", "en": "I hover."},
        {"zh": "你帮不上忙。", "en": "You cannot help."},
        {"zh": "等太阳再高些。", "en": "When the sun climbs a little."},
        {"zh": "我朝红花开的地方去。", "en": "I go where the red flowers are."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿不动。", "en": "I cannot carry it."},
        {"zh": "这个红得可疑。", "en": "A suspicious red."},
        {"zh": "我舔了一下就吐掉。", "en": "I taste it and spit."},
        {"zh": "不是花。", "en": "Not a flower."},
        {"zh": "我用脚推了推。", "en": "I nudge it with my feet."},
        {"zh": "它滚下去了。", "en": "It rolled away."},
        {"zh": "这颜色不对，我踢开它。", "en": "Wrong colour; I kick it away."},
        {"zh": "这颜色太暗。", "en": "Too dull a color."},
        {"zh": "我甩开它，飞到高处。", "en": "I drop it and climb."},
        {"zh": "下次吧。", "en": "Next time."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我立刻飞起来。", "en": "I am up at once."},
        {"zh": "你碰了我的花。", "en": "You touched my flower."},
        {"zh": "我挑最短的线飞出去。", "en": "I take the shortest line out."},
        {"zh": "红色在树影里会消失。", "en": "Red vanishes in shade."},
        {"zh": "你手往哪我往反方向。", "en": "Your hand goes there, I go elsewhere."},
        {"zh": "别以为能抓住我。", "en": "Do not think you can catch me."},
        {"zh": "我飞得比刚才更快。", "en": "I am faster than a moment ago."},
        {"zh": "这片林子是我的。", "en": "This wood is mine."},
        {"zh": "我先走。", "en": "I leave first."},
        {"zh": "你真慢。", "en": "You really are slow."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在换高度。", "en": "I keep changing altitude."},
        {"zh": "你紧张的时候会更慢。", "en": "You are slower when tense."},
        {"zh": "我停在你的视线边上。", "en": "I keep to the edge of your sight."},
        {"zh": "我在花上面。", "en": "I am above the flowers."},
        {"zh": "你的影子够不到。", "en": "Your shadow misses me."},
        {"zh": "我在等风。", "en": "I wait for wind."},
        {"zh": "红色的翅很难跟。", "en": "Red wings are hard to track."},
        {"zh": "我就停这一下。", "en": "I stop only this once."},
        {"zh": "你手抬了。", "en": "Your hand is rising."},
        {"zh": "我往那片亮处去了。", "en": "I head for the bright patch."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一翅扇过去。", "en": "I fan a wing at you."},
        {"zh": "红色的粉进了你的眼。", "en": "Red dust gets in your eye."},
        {"zh": "我一撞就闪开了。", "en": "I hit once and dodge clear."},
        {"zh": "我撞你的耳侧。", "en": "I brush your ear."},
        {"zh": "我只会快。", "en": "Speed is all I have."},
        {"zh": "你挥手挥了个空。", "en": "Your swing hits nothing."},
        {"zh": "我擦过你的耳朵就飞开。", "en": "I clip your ear and veer off."},
        {"zh": "这点力气不算什么。", "en": "That was no real force."},
        {"zh": "你已经找不到我了。", "en": "You cannot find me now."},
        {"zh": "红色的影子留在你眼前。", "en": "A red afterimage stays in your sight."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "红色从树叶间闪出来。", "en": "Red flashes out from the leaves."},
        {"zh": "我直接飞进阳光。", "en": "I fly straight into the sun."},
        {"zh": "这片花正好。", "en": "These flowers will do."},
        {"zh": "我停在最高的枝上。", "en": "I perch on the highest branch."},
        {"zh": "我一下子冲出来。", "en": "I burst out."},
        {"zh": "丛林今天很闷。", "en": "The jungle is close today."},
        {"zh": "我先看清花在哪。", "en": "I find the flowers first."},
        {"zh": "我的翅还是新的。", "en": "My wings are new."},
        {"zh": "我绕着树飞了一圈。", "en": "I circle the tree."},
        {"zh": "这地方有我的路。", "en": "I have a route here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的红色烧成黑。", "en": "Fire turns my red to black."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我轻得像叶子，落地不疼。", "en": "I am light as a leaf, and land softly."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀一湿，红色就沉了。", "en": "Wet wings, and the red sinks."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我甩到树上。", "en": "The blast slaps me against a tree."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支细箭穿了我的翅。", "en": "A thin arrow goes through my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光让我的翅纹烧了一下。", "en": "Magic burns along my wing pattern."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "花太少，我飞不动了。", "en": "Too few flowers. I cannot keep flying."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "一道白光把我的红掩掉了。", "en": "A white flash swallows my red."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有红，没有绿。", "en": "No red here, no green."}
      ]
    }
  }
}
