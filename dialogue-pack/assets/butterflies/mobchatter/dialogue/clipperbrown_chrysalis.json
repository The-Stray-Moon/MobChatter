{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我不走，只随风摇。", "en": "I don't walk. I sway in the wind."},
        {"zh": "丝线拉着我摆。", "en": "The silk thread swings me."},
        {"zh": "叶柄一晃，我也晃。", "en": "The leaf moves and so do I."},
        {"zh": "棕色的壳在荡。", "en": "My brown casing drifts to and fro."},
        {"zh": "我吊在叶背下。", "en": "I hang beneath the leaf."},
        {"zh": "风从东边来。", "en": "The wind comes from the east."},
        {"zh": "我转了个很小的角度。", "en": "I turned a very small angle."},
        {"zh": "丛林里潮得很。", "en": "The jungle is so humid."},
        {"zh": "我努力不晃太猛。", "en": "I try not to swing too hard."},
        {"zh": "露水沿着壳滑下去。", "en": "Dew runs down my casing."},
        {"zh": "我慢慢摆向光。", "en": "I drift slowly toward the light."},
        {"zh": "雨点打了我一下。", "en": "A raindrop struck me."},
        {"zh": "叶子把我压得低了。", "en": "The leaf bows me lower."},
        {"zh": "我在这里等时间。", "en": "Here I wait on time."},
        {"zh": "蝶蛹只有一个动作。", "en": "A chrysalis has one motion."},
        {"zh": "摇啊摇，换了个角度。", "en": "Sway, sway — a new angle."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我静静地挂着。", "en": "I hang without moving."},
        {"zh": "壳里有东西在动。", "en": "Something stirs inside me."},
        {"zh": "我在重新长。", "en": "I am being remade."},
        {"zh": "棕色的纹路很清楚。", "en": "My brown markings are clear."},
        {"zh": "天亮了一次又一次。", "en": "Dawn came again and again."},
        {"zh": "我的外面变硬了。", "en": "My outer shell has hardened."},
        {"zh": "我听不见自己。", "en": "I can't hear myself."},
        {"zh": "身体在慢慢拆开。", "en": "My body is coming apart slowly."},
        {"zh": "丛林里的树叶很厚。", "en": "The jungle leaves are thick."},
        {"zh": "我不饿，也不用吃。", "en": "I'm not hungry. I don't eat."},
        {"zh": "快了，快了吧。", "en": "Soon. Surely soon."},
        {"zh": "我已经不是原来的我。", "en": "I'm no longer what I was."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看不到我的脸。", "en": "You can't see my face."},
        {"zh": "棕色的我贴着叶背，你看就走。", "en": "I'm brown against the leaf's back; look, then go."},
        {"zh": "棕壳一戳就透，别戳。", "en": "One poke would go through this brown shell."},
        {"zh": "你在等它裂开吗。", "en": "Are you waiting for it to split?"},
        {"zh": "我不会动的。", "en": "I'm not going to move."},
        {"zh": "棕壳里的是别的形状。", "en": "Inside the brown shell is another shape."},
        {"zh": "你的影子遮住光了。", "en": "Your shadow blocks my light."},
        {"zh": "站远一点吧。", "en": "Stand farther off."},
        {"zh": "叶子会挡不住你。", "en": "This leaf won't hide me."},
        {"zh": "我看起来只是一团棕色。", "en": "I look like a brown lump."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳上有了裂纹。", "en": "A crack on my casing."},
        {"zh": "我被撞得一晃。", "en": "I was knocked swaying."},
        {"zh": "里面剧烈地动。", "en": "Something churns inside."},
        {"zh": "挂着的丝松了。", "en": "The silk came loose."},
        {"zh": "我快掉下去了。", "en": "I'm about to fall."},
        {"zh": "这层壳保不住我。", "en": "This shell can't save me."},
        {"zh": "可我还得变完。", "en": "But I still have to finish changing."},
        {"zh": "我在这，还没散。", "en": "I'm here. Not broken yet."},
        {"zh": "外面破了，里面还在。", "en": "The outside broke. The inside remains."},
        {"zh": "别补我，让我自己来。", "en": "Don't mend me. Let me do it."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "蛹不吃东西。", "en": "A chrysalis doesn't eat."},
        {"zh": "这个阶段不需要。", "en": "Not at this stage."},
        {"zh": "食物从里面来。", "en": "The food comes from inside."},
        {"zh": "你拿远一点。", "en": "Take it away."},
        {"zh": "那味道我闻不到。", "en": "I can't smell it."},
        {"zh": "我只需要时间。", "en": "All I need is time."},
        {"zh": "别把叶子弄掉。", "en": "Don't knock the leaf off."},
        {"zh": "我连转身都不能。", "en": "I can't even turn."},
        {"zh": "把东西放那儿吧。", "en": "Leave it over there."},
        {"zh": "我很想动，但动不了。", "en": "I want to move. I can't."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被碰得歪了。", "en": "I got knocked crooked."},
        {"zh": "丝线还挂着。", "en": "The silk still holds."},
        {"zh": "别用棍子碰我。", "en": "Don't poke me with a stick."},
        {"zh": "壳和叶子擦了一声。", "en": "My shell rasped the leaf."},
        {"zh": "我转回来了。", "en": "I swung back."},
        {"zh": "这个位置很脆。", "en": "This spot is fragile."},
        {"zh": "你的头撞到叶子了。", "en": "Your head hit the leaf."},
        {"zh": "我摇得很厉害。", "en": "I'm swaying badly."},
        {"zh": "我还挂着，还好。", "en": "Still hanging. Good."},
        {"zh": "别把这片叶扯断。", "en": "Don't tear this leaf off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "棕色的我还没有翅膀。", "en": "Brown as I am, I have no wings yet."},
        {"zh": "等翅膀长出来。", "en": "When the wings have grown."},
        {"zh": "我现在只是一层壳。", "en": "I'm only a shell now."},
        {"zh": "以后再说吧。", "en": "Ask me later."},
        {"zh": "等我破开这层。", "en": "When I break this casing."},
        {"zh": "棕色的我还没有形状。", "en": "The brown me has no shape yet."},
        {"zh": "你该去找会飞的。", "en": "Find something that flies."},
        {"zh": "我什么都给不了。", "en": "I have nothing to give."},
        {"zh": "安静，我在变。", "en": "Quiet. I'm changing."},
        {"zh": "这一天会来的。", "en": "That day will come."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "它在叶尖，我连伸都不行。", "en": "It's at the leaf tip; I can't even stretch."},
        {"zh": "它在叶子下面。", "en": "It's beneath the leaf."},
        {"zh": "我看见了，仅此而已。", "en": "I see it. That's all."},
        {"zh": "你捡走它吧。", "en": "You take it."},
        {"zh": "我根本没有手。", "en": "I don't have hands at all."},
        {"zh": "它被露水粘住了。", "en": "It's stuck to the dew."},
        {"zh": "那是我的叶子。", "en": "That's my leaf."},
        {"zh": "别扯到我的丝。", "en": "Don't pull my thread."},
        {"zh": "它就挂在我丝线旁边。", "en": "It hangs right beside my silk line."},
        {"zh": "蛹没有手脚。", "en": "A chrysalis has no limbs."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶面暗了一块，是它的影。", "en": "A patch of the leaf darkens: its shadow."},
        {"zh": "叶子在动，不是你。", "en": "The leaf moved. Not you."},
        {"zh": "我的壳在发紧。", "en": "My casing has gone tight."},
        {"zh": "叶就这一片，躲也没处躲。", "en": "This is my only leaf, and there is nowhere to hide."},
        {"zh": "这个姿势让我不安。", "en": "This position unsettles me."},
        {"zh": "有东西在树叶间。", "en": "Something is in the leaves."},
        {"zh": "我看见两个亮点。", "en": "I see two bright points."},
        {"zh": "我在等它走开。", "en": "I wait for it to leave."},
        {"zh": "丝线抖了一下。", "en": "My silk thread quivered."},
        {"zh": "这动静不像是风。", "en": "That isn't the wind's doing."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "棕色壳屏着，它还在转。", "en": "The brown shell holds still; it's still circling."},
        {"zh": "壳里翻身也是无声的。", "en": "Even turning inside the shell makes no sound."},
        {"zh": "壳和叶子颜色一样。", "en": "My casing matches the leaf."},
        {"zh": "我像块枯叶疤，黏在叶脉上。", "en": "I cling to the vein like a scar of dead leaf."},
        {"zh": "它绕到另一边了。", "en": "It moved around the other side."},
        {"zh": "我的位置很显眼。", "en": "My position stands out."},
        {"zh": "天暗一点会更好。", "en": "A little less light would help."},
        {"zh": "它在看叶子。", "en": "It's looking at the leaves."},
        {"zh": "再耐心等一等。", "en": "Wait patiently a while."},
        {"zh": "风帮着我摇。", "en": "The wind rocks me in cover."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有任何攻击。", "en": "I have no attack at all."},
        {"zh": "我只能缩紧。", "en": "All I can do is tighten."},
        {"zh": "壳硬了一点点。", "en": "My casing hardened slightly."},
        {"zh": "别把我捏坏了。", "en": "Don't squeeze me."},
        {"zh": "里面还在变。", "en": "The change is still going on."},
        {"zh": "棕壳撞上去，硌一下就算了。", "en": "The brown shell bumps you; a knock and that's all."},
        {"zh": "这一下我承受了。", "en": "I took that one."},
        {"zh": "撞我会坏掉。", "en": "Hitting me breaks me."},
        {"zh": "我不会反抗。", "en": "I won't resist."},
        {"zh": "丝线快断了。", "en": "My thread is close to snapping."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "毛虫选了这片叶子。", "en": "A caterpillar chose this leaf."},
        {"zh": "丛林里多了个棕点。", "en": "A brown dot in the jungle."},
        {"zh": "丝线结在叶脉上。", "en": "The silk is tied to a vein."},
        {"zh": "我刚刚结成。", "en": "I've only just formed."},
        {"zh": "叶子被压弯了一点。", "en": "The leaf bends a little."},
        {"zh": "我挂在半阴的地方。", "en": "I hang in half-shade."},
        {"zh": "这个位置很安全。", "en": "This spot is safe."},
        {"zh": "我就是这样出现的。", "en": "This is how I appear."},
        {"zh": "潮气从叶面升上来。", "en": "Damp rises from the leaf."},
        {"zh": "棕色壳刚硬，羽化的钟走起来。", "en": "The brown shell has just hardened; the clock to my wings starts."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "壳被烤得卷起来。", "en": "My casing curls from the heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉到落叶上。", "en": "I fell onto the leaf litter."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "雨水把我泡透了。", "en": "Rain soaked me through."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "震动把叶子掀翻。", "en": "The blast flipped the leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一个尖东西扎进来。", "en": "Something sharp pierced in."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股热在壳里乱走。", "en": "Heat runs wild inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的养分在减少。", "en": "My reserves are running low."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光透过了叶子。", "en": "Lightning light came through the leaf."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在往下坠。", "en": "I'm falling."}
      ]
    }
  }
}
