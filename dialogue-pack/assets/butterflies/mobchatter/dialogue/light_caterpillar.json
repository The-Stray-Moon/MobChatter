{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "一节一节地往前拱", "en": "Segment by segment, I inch forward."},
        {"zh": "脚下全是叶脉", "en": "Leaf veins are the whole of my road."},
        {"zh": "我沿着叶缘爬", "en": "I crawl along the leaf's edge."},
        {"zh": "离开叶子我就活不了", "en": "Off the leaf, I don't survive."},
        {"zh": "我用前足抓住叶尖", "en": "My forelegs grip the leaf tip."},
        {"zh": "身体弓起来，又伸开", "en": "My body arches, then stretches."},
        {"zh": "我把叶子咬出一个小洞", "en": "I chew a small hole in the leaf."},
        {"zh": "再从洞里钻过去", "en": "Then I crawl through it."},
        {"zh": "叶面上有我的痕迹", "en": "My trail shows on the leaf."},
        {"zh": "我抬头探了探前面", "en": "I raise my head to test ahead."},
        {"zh": "前面的叶子挨得很近", "en": "The next leaf is very close."},
        {"zh": "我够了一下，够到了", "en": "I reach and make it."},
        {"zh": "身体大半还挂在后面", "en": "Most of my body still hangs back."},
        {"zh": "叶脉一路啃过去，很慢。", "en": "I chew along the veins, very slowly."},
        {"zh": "落脚点要选稳", "en": "Every foothold must be sure."},
        {"zh": "这一步过去了", "en": "That step is done."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "趴在叶子中央", "en": "Flat in the middle of a leaf."},
        {"zh": "身体一屈一伸", "en": "My body bends and straightens."},
        {"zh": "我在慢慢嚼叶子", "en": "Slowly chewing through leaf."},
        {"zh": "嘴边都是绿色的汁", "en": "Green juice smears my mouth."},
        {"zh": "叶子已经缺了一角", "en": "A corner of the leaf is gone."},
        {"zh": "我抬头数叶缝的光。", "en": "I look up and count light through the leaves."},
        {"zh": "有鸟在远处叫", "en": "A bird calls far off."},
        {"zh": "我赶紧低下头", "en": "I duck my head quickly."},
        {"zh": "把自己压得扁平", "en": "I flatten myself down."},
        {"zh": "叶面上有个小水珠", "en": "A droplet sits on the leaf."},
        {"zh": "我绕过叶脉往前爬。", "en": "I crawl on past the leaf vein."},
        {"zh": "前面一片叶有点黄", "en": "The next leaf is turning yellow."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬头，你很大", "en": "I look up. You're enormous."},
        {"zh": "我是毛虫，只吃叶子。", "en": "I'm a caterpillar. Leaves only."},
        {"zh": "你没动，我才松开", "en": "You stay still, so I uncurl."},
        {"zh": "我慢慢探出半个身", "en": "I extend half my body."},
        {"zh": "你的手指比叶子还宽", "en": "Your finger is wider than a leaf."},
        {"zh": "我在叶背躲了躲", "en": "I duck under the leaf."},
        {"zh": "然后又探出头来", "en": "Then peek out again."},
        {"zh": "你并没有抓我", "en": "You haven't grabbed me."},
        {"zh": "我还停在原地", "en": "I'm still here."},
        {"zh": "那我就继续吃", "en": "Then back to eating."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个缩起来了", "en": "I curl up completely."},
        {"zh": "身体渗出一股汁", "en": "Juice seeps from my body."},
        {"zh": "我往叶背面钻", "en": "I burrow to the leaf's underside."},
        {"zh": "叶子被我抓得发皱", "en": "My grip wrinkles the leaf."},
        {"zh": "这一下疼得钻心", "en": "The pain is piercing."},
        {"zh": "我还好好地活着", "en": "I'm still alive and well."},
        {"zh": "我把身体一节节展开。", "en": "I uncurl my body segment by segment."},
        {"zh": "身上的纹路淡了", "en": "My markings have faded."},
        {"zh": "得吃点东西补补", "en": "I need to eat to recover."},
        {"zh": "叶子就在我旁边", "en": "The leaf is right here."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这片叶子看着很嫩", "en": "This leaf looks tender."},
        {"zh": "我咬了一小口", "en": "I take a small bite."},
        {"zh": "这一口汁水很多", "en": "Lots of juice in this bite."},
        {"zh": "我整个身子都探过去", "en": "I lean my whole body over."},
        {"zh": "后面的脚还抓着", "en": "My hind legs still grip."},
        {"zh": "这样吃很费劲", "en": "Eating like this is a strain."},
        {"zh": "但我已经够到了", "en": "But I made it."},
        {"zh": "我用两只前足按住", "en": "My forelegs pin it down."},
        {"zh": "从边缘开始啃", "en": "I start from the edge."},
        {"zh": "慢慢往叶子中间", "en": "Working inward."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子弹了一下", "en": "The leaf bounces."},
        {"zh": "我用腹足抓紧叶脉。", "en": "My prolegs grip the leaf vein."},
        {"zh": "差点就掉下去了", "en": "Nearly fell off."},
        {"zh": "我把身子盘紧", "en": "I coil tight."},
        {"zh": "碰我一下我就缩", "en": "A touch and I curl."},
        {"zh": "你这体型太大了", "en": "You're far too big."},
        {"zh": "我不是故意的", "en": "I didn't mean to."},
        {"zh": "我往叶梗那边退", "en": "I back toward the stem."},
        {"zh": "那边要稳得多", "en": "It's steadier there."},
        {"zh": "现在总算安全了", "en": "Safe for now."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还不到那个时候", "en": "Not yet my time for that."},
        {"zh": "得先长够个头", "en": "I have to grow enough first."},
        {"zh": "一直吃，一直长", "en": "Eat, and grow, and eat."},
        {"zh": "皮肤会绷紧几次", "en": "My skin will tighten a few times."},
        {"zh": "每次长都要蜕皮", "en": "Each time I grow, I molt."},
        {"zh": "蜕完就大一圈", "en": "And come out bigger."},
        {"zh": "等到长够了以后", "en": "When I've grown enough."},
        {"zh": "我会在叶上结蛹", "en": "I'll form a chrysalis on a leaf."},
        {"zh": "那一阶段才谈得上别的", "en": "Only then does the rest matter."},
        {"zh": "现在只管吃就好", "en": "For now, only eating."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前足搂住", "en": "I hug it with my forelegs."},
        {"zh": "太重，抱不动", "en": "Too heavy. I can't move it."},
        {"zh": "我用嘴试着咬", "en": "I try a bite."},
        {"zh": "不是叶子，咬不动", "en": "Not a leaf. Can't chew it."},
        {"zh": "我把它往边上推，让出叶脉。", "en": "I push it aside to clear the leaf vein."},
        {"zh": "下面那片叶子更好", "en": "The leaf beneath is better."},
        {"zh": "我往下面爬过去", "en": "I crawl down."},
        {"zh": "我先闻上一闻", "en": "I smell it first."},
        {"zh": "这个倒是可以", "en": "This one will do."},
        {"zh": "那我开始吃了", "en": "I begin to eat."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西靠近叶子", "en": "Something is coming near the leaf."},
        {"zh": "我缩成一小卷，装成芽。", "en": "I curl into a bud and pass for a shoot."},
        {"zh": "颜色和叶子差不多", "en": "My color blends with the leaf."},
        {"zh": "你也许看不见我", "en": "Maybe you won't see me."},
        {"zh": "我一动都不动", "en": "I don't move at all."},
        {"zh": "连呼吸都停了", "en": "Even my breathing stops."},
        {"zh": "你从我旁边走过", "en": "You walked past."},
        {"zh": "我才慢慢松开", "en": "I slowly uncurl."},
        {"zh": "叶子还在原处", "en": "The leaf is still here."},
        {"zh": "我也还在这里", "en": "So am I."},
        {"zh": "那我就接着吃", "en": "Then I'll keep eating."},
        {"zh": "这一口压压惊", "en": "One bite to settle my nerves."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你仍在这周围", "en": "You're still around here."},
        {"zh": "我往叶背面爬", "en": "I crawl to the leaf's underside."},
        {"zh": "那里光线比较暗", "en": "It's darker there."},
        {"zh": "叶子是我的全部口粮，别挪我。", "en": "This leaf is all my food; do not move me."},
        {"zh": "你的影子扫过去", "en": "Your shadow sweeps across."},
        {"zh": "我屏住不敢动", "en": "I freeze."},
        {"zh": "那道影子过去了", "en": "The shadow passes."},
        {"zh": "我打算再等一会", "en": "I wait a little longer."},
        {"zh": "然后我才敢动", "en": "Then I move."},
        {"zh": "一点点，很慢", "en": "Little by little. Slowly."},
        {"zh": "千万别弄出声音", "en": "Make no sound."},
        {"zh": "叶子会遮住我", "en": "The leaf will hide me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬在你的鞋面上", "en": "I bite down on your shoe."},
        {"zh": "这点力气不算什么", "en": "That was almost nothing."},
        {"zh": "我的牙实在很小", "en": "My jaws are tiny."},
        {"zh": "你不该注意我", "en": "You shouldn't have noticed me."},
        {"zh": "我朝叶柄爬过去", "en": "I crawl toward the stem."},
        {"zh": "从那里能下去", "en": "I can get down there."},
        {"zh": "我顾不上别的了", "en": "I can't think of anything else."},
        {"zh": "快点走快点走", "en": "Hurry. Hurry."},
        {"zh": "叶子下面更安全", "en": "Under the leaf is safer."},
        {"zh": "我已经爬到那里", "en": "I've made it there."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "叶背有一粒卵裂开了", "en": "An egg on the leaf's underside splits."},
        {"zh": "我从里面爬出来", "en": "I crawl out of it."},
        {"zh": "身体还是湿的", "en": "My body is still wet."},
        {"zh": "第一件事是找叶子", "en": "First thing: find a leaf."},
        {"zh": "就是这一片叶", "en": "This very leaf."},
        {"zh": "我沿着梗爬上去", "en": "I climb onto it."},
        {"zh": "我咬开一个口", "en": "I take a bite."},
        {"zh": "汁水竟然是温的", "en": "The juice is warm."},
        {"zh": "我又埋头继续啃", "en": "I put my head down and eat."},
        {"zh": "从这里开始长大", "en": "This is where growing starts."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热气让我的皮肤发紧", "en": "The heat tightens my skin."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶片上滚下去了。", "en": "I rolled off the leaf."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水滴把我压住了", "en": "A drop of water pins me down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把叶子撕了", "en": "The blast tears the leaf apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过了叶子", "en": "Something punched through the leaf."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我全身都不听使唤", "en": "My whole body won't obey me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "离开叶子太久了", "en": "I've been off a leaf too long."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光晃得我看不见", "en": "Lightning light blinds me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子底下什么都没有", "en": "Nothing beneath the leaf at all."}
      ]
    }
  }
}
