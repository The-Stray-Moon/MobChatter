{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扇着翅膀找花。", "en": "I flutter between flowers."},
        {"zh": "一片蒲公英在左边。", "en": "A dandelion on my left."},
        {"zh": "翅膀两下，我就越过篱笆。", "en": "Two wingbeats and I am over the fence."},
        {"zh": "翅膀扇得很快，很小声。", "en": "My wings beat fast and faint."},
        {"zh": "我落在一片叶子上歇。", "en": "I rest on a leaf."},
        {"zh": "我越过湿地的芦苇。", "en": "I cross the marsh reeds."},
        {"zh": "翅膀被风一推，偏了半格。", "en": "One gust pushed my wings half a block off."},
        {"zh": "我绕着花丛打转。", "en": "I circle the flowerbed."},
        {"zh": "我在找能落的地方。", "en": "I'm looking for somewhere to land."},
        {"zh": "我顺着光飞。", "en": "I fly toward the light."},
        {"zh": "我停了一下，又起飞。", "en": "I pause, then take off again."},
        {"zh": "我贴着水边转了一圈。", "en": "I loop along the water's edge."},
        {"zh": "我扇着翅，往上一点。", "en": "A few wingbeats lift me."},
        {"zh": "我飞过一片花田。", "en": "I pass over a flower field."},
        {"zh": "蒲公英的香气，引我飞过田埂。", "en": "Dandelion scent leads me over the field ridge."},
        {"zh": "我慢慢落低了。", "en": "I settle lower and lower."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我张开翅膀晒太阳。", "en": "I spread my wings in the sun."},
        {"zh": "我的翅上有白粉。", "en": "White dust coats my wings."},
        {"zh": "我合起翅膀，像片叶子。", "en": "I fold my wings, like a leaf."},
        {"zh": "我在花瓣上歇着。", "en": "I rest on a petal."},
        {"zh": "我的寿命不长。", "en": "My life is short."},
        {"zh": "我抬了抬触角。", "en": "I lift my antennae."},
        {"zh": "风把我晃了一下。", "en": "The wind rocks me a little."},
        {"zh": "我在等太阳再暖些。", "en": "I wait for the sun to warm more."},
        {"zh": "花粉沾在我的腿上。", "en": "Pollen dusts my legs."},
        {"zh": "蒲公英上停一会儿，就授粉了。", "en": "A moment on a dandelion and it is pollinated."},
        {"zh": "我在挑下一朵花。", "en": "I'm choosing the next flower."},
        {"zh": "云遮了太阳，我收翅。", "en": "A cloud hides the sun, I fold up."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的影压到我身上了。", "en": "Your shadow presses on me."},
        {"zh": "你弯腰时，我落在你帽檐上。", "en": "When you bend, I land on your hat brim."},
        {"zh": "别拿手捉我。", "en": "Don't catch me by hand."},
        {"zh": "我只是一只蝶。", "en": "I'm only a butterfly."},
        {"zh": "你身上没有花香。", "en": "You carry no flower scent."},
        {"zh": "你脚下的蒲公英被我占了。", "en": "That dandelion is mine."},
        {"zh": "我绕你飞了一圈整。", "en": "I fly one full circle round you."},
        {"zh": "你要看我飞吗？", "en": "Would you watch me fly?"},
        {"zh": "你一动，我就起来。", "en": "One move from you and I lift off."},
        {"zh": "你的呼吸像风。", "en": "Your breath is like wind."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅皱了一角。", "en": "A corner of my wing is crumpled."},
        {"zh": "翅上的白粉，被你碰掉了。", "en": "The white powder on my wings is knocked loose."},
        {"zh": "我落进草里了。", "en": "I've dropped into the grass."},
        {"zh": "我飞不太起来了。", "en": "I can hardly get airborne."},
        {"zh": "别捏我的翅。", "en": "Don't pinch my wings."},
        {"zh": "这点伤对我太重。", "en": "This is heavy for me."},
        {"zh": "我爬到了一片叶下。", "en": "I crawl under a leaf."},
        {"zh": "我飞得很快，蒲公英在左边。", "en": "I fly fast; the dandelion is to the left."},
        {"zh": "我还能扇两下。", "en": "I can still make two beats."},
        {"zh": "我快飞不动了。", "en": "I'm nearly done flying."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "是花吗？", "en": "Is that a flower?"},
        {"zh": "这味道好甜。", "en": "That smells so sweet."},
        {"zh": "我落在你的手上。", "en": "I land on your hand."},
        {"zh": "别动，我在喝蜜。", "en": "Hold still, I'm drinking."},
        {"zh": "这朵的蜜很多。", "en": "This one is full of nectar."},
        {"zh": "我闻到了蒲公英。", "en": "I smell a dandelion."},
        {"zh": "蒲公英的黄，我从很远就认得出。", "en": "I know dandelion yellow from far off."},
        {"zh": "我喜欢这个颜色。", "en": "I like that colour."},
        {"zh": "再放低一寸。", "en": "An inch lower, please."},
        {"zh": "我翅上沾了蜜。", "en": "Nectar is on my wings."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被你碰歪了。", "en": "You knocked me off balance."},
        {"zh": "我的翅粉沾到你手上。", "en": "Wing dust is on your hand."},
        {"zh": "蒲公英的花，我只吸这一种。", "en": "Only dandelion nectar for me."},
        {"zh": "别压下来。", "en": "Don't press down."},
        {"zh": "我落到草里躲一下。", "en": "I drop into the grass to hide."},
        {"zh": "风帮了我一把。", "en": "The wind carried me clear."},
        {"zh": "我的翅折了一角。", "en": "One wing tip is bent."},
        {"zh": "你险些踩着我。", "en": "You nearly trod on me."},
        {"zh": "我绕开你的手指。", "en": "I slip past your fingers."},
        {"zh": "这点撞，我还能飞。", "en": "I can still fly after that."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我飞不了几天了。", "en": "I have only days to fly."},
        {"zh": "先找朵好花吧。", "en": "First find a good flower."},
        {"zh": "你太小看蝶的寿命。", "en": "You underestimate a butterfly's life."},
        {"zh": "我的翅已经旧了。", "en": "My wings are already worn."},
        {"zh": "这种事在空中做。", "en": "Such things happen in the air."},
        {"zh": "你不是蝶。", "en": "You aren't a butterfly."},
        {"zh": "风会带走这些念头。", "en": "The wind carries such thoughts away."},
        {"zh": "我更喜欢花。", "en": "I prefer flowers."},
        {"zh": "等太阳再暖一些。", "en": "When the sun warms a bit more."},
        {"zh": "别碰我的翅。", "en": "Don't touch my wings."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这点花蜜，正好。", "en": "A drop of nectar, perfect."},
        {"zh": "我用腿扒着花瓣。", "en": "I cling to the petal with my legs."},
        {"zh": "掉在地上的蜜不能喝。", "en": "Nectar on the ground is spoiled."},
        {"zh": "花粉粘住了我的脚。", "en": "Pollen sticks to my feet."},
        {"zh": "我抖了抖翅膀，蒲公英的粉还在。", "en": "I ruffled my wings; dandelion dust still clings."},
        {"zh": "这朵花还有一点。", "en": "This flower has a little left."},
        {"zh": "我绕了两圈才落下。", "en": "I circle twice before landing."},
        {"zh": "有人把花摘走了。", "en": "Someone picked the flower."},
        {"zh": "我在草叶上擦了擦。", "en": "I wipe my legs on a blade of grass."},
        {"zh": "这一口够我飞一会。", "en": "This will keep me flying a while."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那朵花开得正好。", "en": "That flower is in full bloom."},
        {"zh": "我朝那边飞。", "en": "I head that way."},
        {"zh": "有香味飘过来了。", "en": "A scent drifts over."},
        {"zh": "我抬高了高度。", "en": "I gain a little height."},
        {"zh": "我看到黄色的一片。", "en": "I see a patch of yellow."},
        {"zh": "这朵比刚才的甜。", "en": "This one is sweeter than the last."},
        {"zh": "我扇得快一点。", "en": "I beat my wings faster."},
        {"zh": "风向正好。", "en": "The wind is just right."},
        {"zh": "我要落在那里。", "en": "I'll land there."},
        {"zh": "别抢先。", "en": "Don't get there first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕了一圈再落。", "en": "I circle once before landing."},
        {"zh": "这朵的花瓣很软。", "en": "This petal is soft."},
        {"zh": "我数着还剩几口气。", "en": "I count the breaths I have left."},
        {"zh": "太阳在云后面。", "en": "The sun is behind a cloud."},
        {"zh": "我要把蜜喝完。", "en": "I'll finish the nectar."},
        {"zh": "有别的虫过来了。", "en": "Another insect is coming."},
        {"zh": "我先让一让。", "en": "I'll yield for now."},
        {"zh": "风一变，我就换方向。", "en": "When the wind shifts, I change course."},
        {"zh": "这朵花快空了。", "en": "This flower is almost empty."},
        {"zh": "下一朵在那边。", "en": "The next one is over there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有牙。", "en": "I have no teeth."},
        {"zh": "我只会扇翅膀。", "en": "I can only beat my wings."},
        {"zh": "翅粉扑到你脸上。", "en": "Wing dust puffs onto your face."},
        {"zh": "我撞了你一下就飞开。", "en": "I bump you once and fly off."},
        {"zh": "我用翅膀扇你的鼻子。", "en": "I fan your nose with my wings."},
        {"zh": "我飞高避开你的手。", "en": "I climb away from your hand."},
        {"zh": "我绕到你头后面。", "en": "I loop behind your head."},
        {"zh": "你别挥得那么急。", "en": "Don't swat so wildly."},
        {"zh": "我落回花上了。", "en": "I've settled back on the flower."},
        {"zh": "再追我就要飞远了。", "en": "Chase me more and I'll fly off."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶背钻出来。", "en": "I emerge from under a leaf."},
        {"zh": "翅刚干，我就飞了。", "en": "Wings dry, I take flight."},
        {"zh": "我原来是只毛虫。", "en": "I used to be a caterpillar."},
        {"zh": "蒲公英在等我。", "en": "Dandelions are waiting for me."},
        {"zh": "太阳正好。", "en": "The sun is just right."},
        {"zh": "我在平原上打开翅膀。", "en": "I open my wings over the plains."},
        {"zh": "湿地的风带着水气。", "en": "The marsh wind carries moisture."},
        {"zh": "我落在一朵花上。", "en": "I land on a flower."},
        {"zh": "我扇了三下才飞稳。", "en": "Three wingbeats to steady myself."},
        {"zh": "这世界很大。", "en": "This world is very large."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一靠近，翅就卷了。", "en": "Fire near, and my wings curl."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处坠下，翻了几圈。", "en": "I tumble down, spinning."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水黏住我的翅。", "en": "Water clings to my wings."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我抛得很远。", "en": "The shockwave hurls me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西穿过了我的翅。", "en": "That tore through my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光一闪，我的翅都麻了。", "en": "A flash and my wings go numb."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没喝到蜜，我飞不动。", "en": "No nectar, and I can't fly."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一闪，我全身僵住。", "en": "A lightning flash and I lock up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有花和风。", "en": "No flowers or wind in the void."}
      ]
    }
  }
