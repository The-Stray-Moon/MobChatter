{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一节一节地爬", "en": "I crawl, segment by segment."},
        {"zh": "我沿着叶脉慢慢挪", "en": "I inch along the leaf's veins."},
        {"zh": "每爬一步就啃一口", "en": "A bite for every step."},
        {"zh": "我拱起背，再伸开", "en": "I arch my back, then stretch out."},
        {"zh": "我从不离开这片叶子", "en": "I never leave this leaf."},
        {"zh": "叶子边缘被我咬出缺口", "en": "I've nibbled the leaf's edge."},
        {"zh": "脚很多，走得还是慢", "en": "Many feet, still slow."},
        {"zh": "我绕开叶上的水珠", "en": "I go around the water drops."},
        {"zh": "这样挪一天也不累", "en": "I could crawl like this all day."},
        {"zh": "我抬头看下一片叶", "en": "I look up at the next leaf."},
        {"zh": "叶片在我身下弯了", "en": "The leaf bends beneath me."},
        {"zh": "我慢慢往叶尖去", "en": "I head slowly for the leaf's tip."},
        {"zh": "我身上有细小的毛", "en": "Fine hairs cover my body."},
        {"zh": "闻到新叶的味道", "en": "I smell fresh leaves."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴在叶片中央", "en": "I lie in the middle of the leaf."},
        {"zh": "我嘴里还在嚼", "en": "I'm still chewing."},
        {"zh": "我就这么待着", "en": "I just stay here."},
        {"zh": "树叶是我的全部", "en": "This leaf is everything."},
        {"zh": "身边都是咬过的洞", "en": "Torn holes surround me."},
        {"zh": "风把叶子掀起来", "en": "The wind lifts the leaf."},
        {"zh": "我缩了一小下", "en": "I curled up a little."},
        {"zh": "我还没有吃饱", "en": "I'm not full yet."},
        {"zh": "叶子有点老了", "en": "The leaf is getting old."},
        {"zh": "我在挑下一处下口", "en": "I'm picking where to bite next."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你别踩这片叶子", "en": "Don't step on this leaf."},
        {"zh": "我只吃这些树叶", "en": "I only eat leaves."},
        {"zh": "离开叶子我会死", "en": "Off the leaf, I die."},
        {"zh": "你把我放回去就行", "en": "Just put me back."},
        {"zh": "我身上的毛别碰", "en": "Don't touch my hairs."},
        {"zh": "你那儿有别的叶子吗", "en": "Do you have another leaf?"},
        {"zh": "我正忙着吃呢", "en": "I'm busy eating."},
        {"zh": "你会捏碎我的", "en": "You'll crush me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "别压到我身上", "en": "Don't crush me."},
        {"zh": "我缩成一团了", "en": "I've curled into a ball."},
        {"zh": "叶子被撕破了", "en": "The leaf is torn."},
        {"zh": "我差点被震下叶子", "en": "The shock nearly knocked me off."},
        {"zh": "我这么软，你下得去手", "en": "I'm this soft, and you still hit me."},
        {"zh": "我的毛都乱了", "en": "My hairs are all mussed."},
        {"zh": "疼得我蜷起来", "en": "It hurts enough to curl me."},
        {"zh": "我还要吃很久", "en": "I still have much eating to do."},
        {"zh": "让我贴着叶子", "en": "Let me press against the leaf."},
        {"zh": "我还好，没事", "en": "I'm all right."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是一张叶子吗", "en": "Is it a leaf?"},
        {"zh": "那个我咬得动吗", "en": "Can I bite that?"},
        {"zh": "太硬了，我不要", "en": "Too hard; I don't want it."},
        {"zh": "我要薄一点的", "en": "I want a thinner one."},
        {"zh": "那已经不是叶子了", "en": "That's not a leaf anymore."},
        {"zh": "你放我旁边就行", "en": "Just set it beside me."},
        {"zh": "我只要新鲜的", "en": "I want only fresh ones."},
        {"zh": "别晃，我咬不准", "en": "Don't wave it; I can't bite straight."},
        {"zh": "这一片有点老", "en": "This one's a bit old."},
        {"zh": "再给我一片叶", "en": "Give me another leaf."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我压住了", "en": "You're crushing me."},
        {"zh": "差点从叶尖滑落", "en": "I nearly slid off the tip."},
        {"zh": "我没脚滑，是你撞的", "en": "I didn't slip; you bumped me."},
        {"zh": "我这么软，别挤", "en": "I'm soft; don't crowd me."},
        {"zh": "这下我抓不稳了", "en": "Now I can't hold on."},
        {"zh": "我才挪了半片叶", "en": "I'd only moved half a leaf."},
        {"zh": "我们撞得叶子都弯了", "en": "We bent the leaf."},
        {"zh": "让我重新咬住", "en": "Let me get a grip again."},
        {"zh": "你轻一点压我", "en": "Press more gently."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还没有长大", "en": "I haven't grown up yet."},
        {"zh": "这事轮不到毛虫", "en": "That's not for caterpillars."},
        {"zh": "我得先吃饱再说", "en": "I must eat first."},
        {"zh": "等我变成蝶再说", "en": "Ask me once I'm a butterfly."},
        {"zh": "我连动都很慢", "en": "I can barely move."},
        {"zh": "别在这儿说这个", "en": "Not here."},
        {"zh": "我只想啃叶子", "en": "I only want to chew leaves."},
        {"zh": "叶脉比这有趣", "en": "The veins are more interesting."},
        {"zh": "叶子才是要紧的", "en": "The leaf matters more."},
        {"zh": "我还得再吃几天", "en": "A few more days of eating."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我要叶子，不是你的手", "en": "I need a leaf, not your hand."},
        {"zh": "快点放回叶上", "en": "Put me back on a leaf."},
        {"zh": "这样我会饿死", "en": "I'll starve like this."},
        {"zh": "你手心里没有叶子", "en": "There's no leaf in your palm."},
        {"zh": "别捏，我很软", "en": "Don't squeeze; I'm soft."},
        {"zh": "你要带我去哪片叶子", "en": "Which leaf are you taking me to?"},
        {"zh": "我身上会掉毛", "en": "My hairs will shed on you."},
        {"zh": "慢点，我头晕", "en": "Slow down; I'm dizzy."},
        {"zh": "把我放到叶子上", "en": "Set me down."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "别动我的叶子", "en": "Don't touch my leaf."},
        {"zh": "那是我在吃的", "en": "I'm eating that."},
        {"zh": "你踩坏了我的叶子", "en": "You crushed my leaf."},
        {"zh": "我没地方去了", "en": "I've nowhere left to go."},
        {"zh": "我虽然爬得很慢", "en": "Slow as I am—"},
        {"zh": "但我也是会咬的", "en": "I can still bite."},
        {"zh": "你手伸过来试试", "en": "Try reaching in."},
        {"zh": "这片叶子是我全部的食量", "en": "This leaf is all my food."},
        {"zh": "你给我离远一点", "en": "Keep some distance."},
        {"zh": "我要躲到背面去", "en": "I'll hide underneath."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头盯着你", "en": "I raise my head and stare."},
        {"zh": "我在往叶背挪", "en": "I'm moving to the underside."},
        {"zh": "你手指太近了", "en": "Your finger is too close."},
        {"zh": "我会咬住不松", "en": "I'll bite and hold."},
        {"zh": "这片叶子的边我还没吃完", "en": "I haven't finished this edge."},
        {"zh": "你再往这边靠", "en": "Come closer."},
        {"zh": "我身上有毛，你不好抓", "en": "My hairs make me hard to grab."},
        {"zh": "等你把手放低", "en": "Waiting till you lower that hand."},
        {"zh": "别捏我的体节", "en": "Don't pinch my segments."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我要咬你一口", "en": "I bite you."},
        {"zh": "我的牙齿不大", "en": "My teeth aren't big."},
        {"zh": "把嘴给我松开", "en": "Let go."},
        {"zh": "别碰我的叶子", "en": "Leave my leaf."},
        {"zh": "这一下够你缩手", "en": "That should pull your hand back."},
        {"zh": "我就是不肯放", "en": "I won't let go."},
        {"zh": "我浑身都是毛", "en": "I'm covered in hairs."},
        {"zh": "你再给我动一下", "en": "Move once more."},
        {"zh": "我只会这一招", "en": "This is all I know."},
        {"zh": "你快快退开去", "en": "Back off."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我先咬了一小口", "en": "I took a small bite first."},
        {"zh": "树叶就在头顶", "en": "The leaves are right overhead."},
        {"zh": "这棵树叶子够多", "en": "This tree has leaves enough."},
        {"zh": "我开始吃叶子", "en": "I've started eating the leaf."},
        {"zh": "风把叶子吹动了", "en": "The wind moved the leaf."},
        {"zh": "先找个地方躲", "en": "First, somewhere to hide."},
        {"zh": "我在叶背上醒来，先找吃的。", "en": "I woke on a leaf's back, already hungry."},
        {"zh": "树叶就是我的整个世界。", "en": "A single leaf is my whole world."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子一烧，我就没地方了", "en": "The leaf burns and I've nowhere left."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "掉在土上，那不是叶子", "en": "I fell on soil, and soil isn't a leaf."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一泡，我就软了", "en": "Soaked, I go limp."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把叶子和我也掀了", "en": "The blast took the leaf and me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿过了叶子", "en": "That went through the leaf."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让我动不了", "en": "The spell froze me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子吃完了，我快撑不住了", "en": "The leaf is gone; I'm fading."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把整棵树照亮了", "en": "The bolt lit the whole tree."}
      ]
    }
  }
}
