{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶背，只能晃。", "en": "Hanging under a leaf, I can only sway."},
        {"zh": "风一来，我跟着摆。", "en": "Wind comes and I swing with it."},
        {"zh": "叶子托着我转了个向。", "en": "The leaf turns me a little."},
        {"zh": "壳内有什么在挪动。", "en": "Something shifts inside my shell."},
        {"zh": "我被风吹得左右倾。", "en": "The wind tips me side to side."},
        {"zh": "我慢慢摆到叶柄下。", "en": "I swing under the leaf stem."},
        {"zh": "这一片叶子在颤。", "en": "This leaf is trembling."},
        {"zh": "我动不了，但我在长。", "en": "I can't move, but I'm growing."},
        {"zh": "外面正在下雨。", "en": "It's raining outside."},
        {"zh": "我又晃了一下。", "en": "I sway once more."},
        {"zh": "这片叶子撑得住我。", "en": "This leaf holds me."},
        {"zh": "我慢慢往上挪了一点。", "en": "I shift upward a little."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂着一动不动。", "en": "I hang perfectly still."},
        {"zh": "壳的表面很硬。", "en": "The shell surface is hard."},
        {"zh": "壳的里面很暗。", "en": "It's dark in here."},
        {"zh": "我在等一个时刻。", "en": "I'm waiting for a moment."},
        {"zh": "外面有蝴蝶飞过。", "en": "A butterfly passed outside."},
        {"zh": "我什么都不用做。", "en": "There's nothing I need to do."},
        {"zh": "壳上凝了水珠。", "en": "Dew beads on my shell."},
        {"zh": "我在听着风声。", "en": "I'm listening to the wind."},
        {"zh": "平原上的蛹，晒着太阳。", "en": "A chrysalis on the plains, sunning."},
        {"zh": "再等一等就好了。", "en": "Just a bit longer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你盯着这壳看什么？", "en": "What are you looking at?"},
        {"zh": "你又移不动我。", "en": "You can't move me anyway."},
        {"zh": "我只是一只蛹。", "en": "I'm only a chrysalis."},
        {"zh": "别用手碰我的壳。", "en": "Don't touch my shell."},
        {"zh": "我在等着羽化。", "en": "I'm waiting to emerge."},
        {"zh": "你的影子挡住光了。", "en": "Your shadow blocks the light."},
        {"zh": "你能看见壳里的我吗？", "en": "Can you see me inside?"},
        {"zh": "我还不是蝴蝶。", "en": "I'm not a butterfly yet."},
        {"zh": "你快快走开吧。", "en": "Go away, please."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被震得发麻。", "en": "The shock left me numb."},
        {"zh": "里面开始渗水。", "en": "Water seeps in."},
        {"zh": "这一下打断了我的变化。", "en": "That interrupted my change."},
        {"zh": "我听见壳的声音。", "en": "I hear my shell creaking."},
        {"zh": "外面的风变得刺人。", "en": "The wind outside turns sharp."},
        {"zh": "我还挂在这里。", "en": "I'm still here."},
        {"zh": "壳变薄了一层。", "en": "The shell has thinned."},
        {"zh": "我再咬牙撑一会儿。", "en": "Hold on a little longer."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子托着我，转了个方向。", "en": "The leaf holds me and turns me about."},
        {"zh": "这一层壳封着。", "en": "The shell is sealed."},
        {"zh": "等翅膀长好再说。", "en": "Wait till my wings form."},
        {"zh": "我不是毛虫了。", "en": "I'm not a caterpillar anymore."},
        {"zh": "你放错地方了。", "en": "You've put it in the wrong place."},
        {"zh": "我现在只需要时间。", "en": "All I need is time."},
        {"zh": "这味道我闻得到。", "en": "I can smell it."},
        {"zh": "留给别的东西吧。", "en": "Leave it for someone else."},
        {"zh": "我不动，也吃不了。", "en": "I'm still and can't eat."},
        {"zh": "蛹里很挤，你拿走吧。", "en": "It is cramped in here, so take it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到这片叶子了。", "en": "You bumped this leaf."},
        {"zh": "我跟着叶子晃。", "en": "I sway with the leaf."},
        {"zh": "晃得我有点晕。", "en": "The swaying makes me dizzy."},
        {"zh": "别摇这一棵树。", "en": "Don't shake this tree."},
        {"zh": "壳和叶子蹭出声。", "en": "Shell and leaf scrape together."},
        {"zh": "你再碰我就掉了。", "en": "Touch it again and I'll fall."},
        {"zh": "叶柄差点断了。", "en": "The leaf stem nearly snapped."},
        {"zh": "我抓紧了叶子。", "en": "I'm holding on."},
        {"zh": "这点震动受得住。", "en": "I can take this much shaking."},
        {"zh": "你摇得轻一点。", "en": "Gently."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还是一个蛹。", "en": "I'm still a chrysalis."},
        {"zh": "等我的翅膀出来。", "en": "When my wings come out."},
        {"zh": "我根本动不了。", "en": "I can't move."},
        {"zh": "你去找飞的吧。", "en": "Find one that can fly."},
        {"zh": "我还得再等等。", "en": "I still have to wait."},
        {"zh": "这壳里只有我一个。", "en": "There's only me in this shell."},
        {"zh": "我还挂在叶片背面。", "en": "I am still hanging under the leaf."},
        {"zh": "你安静一点点。", "en": "Be quiet."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的脚一丝也动不了。", "en": "Not one of my feet can move."},
        {"zh": "这东西离我太近。", "en": "That's too close to me."},
        {"zh": "我闻着不像叶子。", "en": "Doesn't smell like a leaf."},
        {"zh": "它掉到下面了。", "en": "It fell."},
        {"zh": "我只能干看着。", "en": "All I can do is watch."},
        {"zh": "别放在我壳上。", "en": "Don't set it on my shell."},
        {"zh": "它压住了叶柄。", "en": "It's weighing down the stem."},
        {"zh": "你把它拿走好了。", "en": "Take it away."},
        {"zh": "这不关我的事。", "en": "That's none of my concern."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "外面有东西在动。", "en": "Something's moving outside."},
        {"zh": "我只能看着它靠近。", "en": "I can only watch it come."},
        {"zh": "壳挡得住一阵。", "en": "The shell will hold a while."},
        {"zh": "它停在我这片叶子上。", "en": "It landed on my leaf."},
        {"zh": "我没有地方躲。", "en": "I have nowhere to hide."},
        {"zh": "别来咬我的壳。", "en": "Don't bite my shell."},
        {"zh": "我使劲往里缩。", "en": "I press deeper inside."},
        {"zh": "我快要羽化了。", "en": "I'm nearly ready to emerge."},
        {"zh": "我的壳里开始变硬。", "en": "Inside my casing I am hardening."},
        {"zh": "别来碰我的壳。", "en": "Don't touch me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它还没有走开。", "en": "It's still here."},
        {"zh": "我绷紧壳，装成枯叶。", "en": "I stiffen my casing and play dead leaf."},
        {"zh": "壳上被碰了一下。", "en": "Something touched my shell."},
        {"zh": "它闻了闻就走了。", "en": "It sniffed and moved on."},
        {"zh": "我听见它的脚。", "en": "I hear its feet."},
        {"zh": "壳里再憋一阵。", "en": "Endure a moment more."},
        {"zh": "叶子在往下沉。", "en": "The leaf is sagging."},
        {"zh": "它已经走远了。", "en": "It's moving away."},
        {"zh": "这样就算好了。", "en": "Good."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我什么都做不了，只能等平原的风。", "en": "I can do nothing but wait for the plains wind."},
        {"zh": "壳硬得咬不动。", "en": "The shell is too hard to bite."},
        {"zh": "你咬到的是叶子。", "en": "You bit a leaf."},
        {"zh": "我只能在里面挣。", "en": "I can only struggle inside."},
        {"zh": "平原上的蛹，硬得像颗沙粒。", "en": "A plains chrysalis, hard as a grain of sand."},
        {"zh": "我快要出来了。", "en": "I'm nearly out."},
        {"zh": "你别再摇这棵树。", "en": "Stop shaking."},
        {"zh": "我一点力也使不上。", "en": "I can't put up force."},
        {"zh": "再撑一小会儿。", "en": "Hold on a bit."},
        {"zh": "这壳是我的盔甲。", "en": "This shell is my armor."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在叶背结成了形。", "en": "I took shape under a leaf."},
        {"zh": "叶脉贴着我的壳。", "en": "The leaf veins press my shell."},
        {"zh": "外面的光很亮。", "en": "The light outside is bright."},
        {"zh": "我听见平原上的风。", "en": "I hear the plains wind."},
        {"zh": "壳的里面很暖。", "en": "It's warm inside."},
        {"zh": "我慢慢安静下来。", "en": "I slowly go still."},
        {"zh": "这是我第一次静止。", "en": "This is my first stillness."},
        {"zh": "树上有别的蛹。", "en": "There are other chrysalises on this tree."},
        {"zh": "好，那就开始等。", "en": "Fine, the waiting begins."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子都烤卷了，我的壳发烫。", "en": "The leaf curls; my shell is hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶子上掉下来，摔在土里。", "en": "I fell off the leaf onto the soil."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "雨水灌进了壳缝。", "en": "Rainwater forced into my shell's seam."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我和叶子一起掀了。", "en": "The blast threw me and the leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西擦过我的壳。", "en": "Something grazed my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力气穿过叶脉打到我。", "en": "That force came through the veins to me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我体内存的东西快用完了。", "en": "My stores are nearly gone."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声近得壳都在响。", "en": "The thunder is close enough to ring my shell."}
      ]
    }
  }
}
