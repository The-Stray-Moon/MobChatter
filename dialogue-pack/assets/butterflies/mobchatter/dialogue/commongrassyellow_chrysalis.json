{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我被叶柄吊在半空。", "en": "The leaf stem hangs me in the air."},
        {"zh": "我没有腿，只好随风。", "en": "No legs; I go with the wind."},
        {"zh": "叶片一动，我也动。", "en": "When the leaf moves, so do I."},
        {"zh": "我在叶下轻轻打转。", "en": "I turn gently under the leaf."},
        {"zh": "壳里好像有东西在推。", "en": "Something seems to push inside."},
        {"zh": "我随着枝条起伏。", "en": "I rise and fall with the branch."},
        {"zh": "风吹过来，我偏了偏。", "en": "The wind came and turned me."},
        {"zh": "我荡到叶尖又回来。", "en": "I swing to the tip and back."},
        {"zh": "这片叶子有些老了。", "en": "This leaf is getting old."},
        {"zh": "我一晃，露水就落。", "en": "One sway and the dew falls."},
        {"zh": "壳越来越紧了。", "en": "The shell is getting tighter."},
        {"zh": "我贴住叶背稳住。", "en": "I press to the leaf to steady."},
        {"zh": "枝条被我压弯。", "en": "The twig bends under me."},
        {"zh": "我在慢慢转向太阳。", "en": "I'm turning slowly toward the sun."},
        {"zh": "壳里的身子蜷着。", "en": "My body is curled inside."},
        {"zh": "我又摆回来了。", "en": "I swing back again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "叶柄吊着我，一晃半天。", "en": "The stem holds me; I sway half the day."},
        {"zh": "壳的颜色变深了。", "en": "The shell has darkened."},
        {"zh": "叶间的光一闪一闪。", "en": "Light flickers between the leaves."},
        {"zh": "我吊在叶下不动。", "en": "I don't stir at all."},
        {"zh": "虫壳的表面很光滑。", "en": "The casing is smooth."},
        {"zh": "外面有虫在爬。", "en": "An insect crawls outside."},
        {"zh": "我听见远处的鸟。", "en": "I hear birds far away."},
        {"zh": "壳的里面很闷。", "en": "It's close and stuffy in here."},
        {"zh": "我在积攒力气。", "en": "I'm gathering strength."},
        {"zh": "早上的风最凉。", "en": "The morning wind is coolest."},
        {"zh": "壳外的事，我一件也管不了。", "en": "What goes on outside this shell is beyond me."},
        {"zh": "有点耐心就好。", "en": "Patience is all."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你又跑过来了。", "en": "You're back again."},
        {"zh": "我挂在这儿不会跑。", "en": "I'm hanging here; I won't run."},
        {"zh": "别晃这根枝条。", "en": "Don't shake this branch."},
        {"zh": "你能看见我的形状吗？", "en": "Can you see my shape?"},
        {"zh": "离羽化还差一点。", "en": "A little short of emerging."},
        {"zh": "你的影子让我发凉。", "en": "Your shadow makes me cold."},
        {"zh": "我不过是片叶子上的蛹。", "en": "I'm just a chrysalis."},
        {"zh": "你又帮不上忙。", "en": "You can't help anyway."},
        {"zh": "让光进来就好。", "en": "Just let the light in."},
        {"zh": "你别用手碰我。", "en": "Don't touch."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳裂了一条缝。", "en": "A seam split in my shell."},
        {"zh": "我被震得发紧。", "en": "The shock tightened me."},
        {"zh": "里面渗进了水。", "en": "Water got inside."},
        {"zh": "我用力往里缩。", "en": "I squeeze inward."},
        {"zh": "这变化被打断了。", "en": "The change was interrupted."},
        {"zh": "壳在吱吱地响。", "en": "My shell is creaking."},
        {"zh": "风变得很厉害。", "en": "The wind turned fierce."},
        {"zh": "我还没有放弃。", "en": "I haven't given up."},
        {"zh": "壳又薄了一层。", "en": "The shell is thinner now."},
        {"zh": "再咬牙忍一小会儿。", "en": "Endure it a bit longer."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我封在壳里面。", "en": "I'm sealed in this shell."},
        {"zh": "在我嘴边，我也吃不着。", "en": "Even at my mouth, I couldn't eat it."},
        {"zh": "我闻得到，但吃不了。", "en": "I can smell it, but can't eat."},
        {"zh": "等我长出翅膀，才吃得下。", "en": "Once I have wings, I can eat that."},
        {"zh": "留给会飞的那个。", "en": "Save it for one that flies."},
        {"zh": "我现在只要安静。", "en": "I only want quiet now."},
        {"zh": "太近了，快拿开。", "en": "Too close; take it away."},
        {"zh": "这壳不会打开。", "en": "This shell doesn't open."},
        {"zh": "别在我下面放。", "en": "Don't put it beneath me."},
        {"zh": "隔着壳，你喂不到我。", "en": "Through the shell, you can't feed me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "叶柄被你撞得一颤。", "en": "You knocked the leaf stem."},
        {"zh": "我被摇得头晕。", "en": "The shaking makes me dizzy."},
        {"zh": "壳撞到叶面了。", "en": "My shell hit the leaf."},
        {"zh": "别碰这根枝条。", "en": "Don't touch the twig."},
        {"zh": "再碰我就要掉。", "en": "Touch it again and I'll fall."},
        {"zh": "我稳住了自己。", "en": "I steady myself."},
        {"zh": "这点晃动能受。", "en": "I can bear this swaying."},
        {"zh": "叶子差点翻过来。", "en": "The leaf nearly flipped."},
        {"zh": "轻些，我壳很薄。", "en": "Gently; my shell is thin."},
        {"zh": "别在树下跺脚。", "en": "Don't stomp under the tree."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这棵树就我一个，别等了。", "en": "I'm the only one on this tree; don't wait."},
        {"zh": "现在没法谈这个。", "en": "Can't discuss it now."},
        {"zh": "我壳里挤不下第二个。", "en": "There's no room for a second one in my shell."},
        {"zh": "我连转身都不行。", "en": "I can't even turn."},
        {"zh": "这壳里只有我。", "en": "Only me in this shell."},
        {"zh": "等我裂开，也许能聊聊。", "en": "Once I split open, maybe we can talk."},
        {"zh": "不是这个时候。", "en": "Not this time."},
        {"zh": "让我安静一会儿。", "en": "Leave me in peace."},
        {"zh": "等我破壳再说吧。", "en": "Later."},
        {"zh": "你别来吵我了。", "en": "Don't disturb me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我碰不到东西。", "en": "I can't reach anything."},
        {"zh": "它挂在我旁边的叶上。", "en": "It hangs on the leaf beside me."},
        {"zh": "不是叶子我就不要。", "en": "If it's not a leaf, I don't want it."},
        {"zh": "它把叶子压弯了。", "en": "It's bending the leaf."},
        {"zh": "叶子弯了，我的壳往下滑。", "en": "The leaf bends; my shell slides down."},
        {"zh": "我一点也帮不上忙。", "en": "I can't help."},
        {"zh": "别挂在同一根枝上。", "en": "Don't hang it on the same twig."},
        {"zh": "它实在太重了。", "en": "It's too heavy."},
        {"zh": "你把这东西拿开吧。", "en": "Take it away."},
        {"zh": "捡东西得用腿，我还没有。", "en": "Picking things up takes legs; I haven't got any."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西靠近这片叶。", "en": "Something came near this leaf."},
        {"zh": "我只能等它走。", "en": "I can only wait it out."},
        {"zh": "壳够厚，咬不穿。", "en": "The shell is thick enough."},
        {"zh": "它停在叶柄上。", "en": "It's perched on the stem."},
        {"zh": "我听到了它的爪。", "en": "I hear its claws."},
        {"zh": "我把呼吸屏住。", "en": "I hold still."},
        {"zh": "别咬这片叶子。", "en": "Don't bite this leaf."},
        {"zh": "我就快要成了。", "en": "Almost ready."},
        {"zh": "再憋住一阵别动。", "en": "Endure a moment."},
        {"zh": "别乱动我的壳。", "en": "Don't move me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它还没有离开。", "en": "It hasn't left."},
        {"zh": "它嗅了嗅我的壳。", "en": "It sniffed my shell."},
        {"zh": "我一动不敢动。", "en": "I don't dare stir."},
        {"zh": "它绕到叶的另一面。", "en": "It went around the leaf."},
        {"zh": "叶尖一直在抖。", "en": "The leaf tip trembles."},
        {"zh": "它爪子刮着叶面，我装死。", "en": "Its claws scrape the leaf; I play dead."},
        {"zh": "那个东西又回来了。", "en": "It came back."},
        {"zh": "壳再撑一阵就破了。", "en": "Hold out a little longer."},
        {"zh": "它好像一点都不饿。", "en": "It doesn't seem hungry."},
        {"zh": "它终于走开了。", "en": "It left."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "壳被咬了一下。", "en": "Something bit my shell."},
        {"zh": "我在里面挣扎。", "en": "I struggle inside."},
        {"zh": "我使尽力气也顶不动。", "en": "I can't push back."},
        {"zh": "这壳还能挡一下。", "en": "The shell still holds."},
        {"zh": "它咬的是叶子。", "en": "It's biting the leaf."},
        {"zh": "我扭着身子，躲开那口牙。", "en": "I twist inside, away from those teeth."},
        {"zh": "壳上有一道白痕。", "en": "A white mark on my shell."},
        {"zh": "我快没力气了。", "en": "I'm losing strength."},
        {"zh": "我恨不能飞起来。", "en": "I wish I could fly."},
        {"zh": "再替我挡它一次。", "en": "Block it once more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在叶背上成形。", "en": "I formed on the leaf's underside."},
        {"zh": "叶脉硌着我的壳。", "en": "Leaf veins press against me."},
        {"zh": "风从枝间穿过。", "en": "Wind passes between the twigs."},
        {"zh": "这棵树附近很安静。", "en": "It's quiet here."},
        {"zh": "我开始变硬了。", "en": "I'm hardening."},
        {"zh": "叶子还在长着。", "en": "The leaf is still growing."},
        {"zh": "我慢慢定住了形。", "en": "I slowly go still."},
        {"zh": "外面就是平原。", "en": "Outside is the plains."},
        {"zh": "等到时候我就会开。", "en": "In time I'll open."},
        {"zh": "先这样挂着吧。", "en": "For now, hang like this."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子焦了，我的壳烫手。", "en": "The leaf scorched; my shell is hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从枝上掉进草里。", "en": "I fell from the twig into the grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水顺着缝渗进来。", "en": "Water seeps through the seam."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我连着叶子甩出去。", "en": "The blast flung me with the leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西撞在我的壳上。", "en": "Something struck my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量透过叶子传进来。", "en": "That force reached me through the leaf."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "壳里存的养分少了。", "en": "My stored nutrients are low."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声把整棵树都震响了。", "en": "The thunder made the whole tree ring."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶子上坠下去。", "en": "I fall from the leaf."}
      ]
    }
  }
}
