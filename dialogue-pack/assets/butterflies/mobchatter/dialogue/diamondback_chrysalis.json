{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在平原的矮树上。", "en": "I hang on a low tree in the plains."},
        {"zh": "一根丝把我吊在叶下。", "en": "One thread holds me under the leaf."},
        {"zh": "风来的时候我转半圈。", "en": "I turn half a circle when the wind comes."},
        {"zh": "我的壳是薄薄的一层。", "en": "My shell is a thin layer."},
        {"zh": "我在里面慢慢长成蛾。", "en": "Inside, I'm slowly becoming a moth."},
        {"zh": "草叶的高度正好遮住我。", "en": "The grass hides me at just the right height."},
        {"zh": "我随枝摆动，幅度很小。", "en": "I sway with the twig, only slightly."},
        {"zh": "我的壳上有一道浅纹。", "en": "A pale line runs over my shell."},
        {"zh": "脚下的叶子快黄了。", "en": "The leaf beneath is turning yellow."},
        {"zh": "我吊着，只让风摆我", "en": "I hang still and let the wind swing me."},
        {"zh": "我看到外面的草在摇。", "en": "I see the grass sway outside."},
        {"zh": "阳光照到壳上，暖了一点。", "en": "Sun on my shell makes it warmer."},
        {"zh": "有风吹过，我的丝响了。", "en": "Wind passes and my silk hisses."},
        {"zh": "我又往叶脉靠近了一点。", "en": "I've shifted a little toward the vein."},
        {"zh": "庄稼地里风更小。", "en": "The fields have less wind."},
        {"zh": "我停在这枝的中间。", "en": "I rest at the middle of this twig."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在壳里缓缓动着。", "en": "I move slowly inside."},
        {"zh": "外面有蚱蜢在跳。", "en": "A grasshopper jumps outside."},
        {"zh": "我没有要破壳的样子。", "en": "There's no sign of me breaking out."},
        {"zh": "叶子上的毛很软。", "en": "The fuzz on the leaf is soft."},
        {"zh": "我在听风穿过麦子。", "en": "I listen to wind through wheat."},
        {"zh": "我的壳有一点点透明。", "en": "My shell is slightly transparent."},
        {"zh": "壳里数着夜来的时辰", "en": "Inside my shell I count the hours to night."},
        {"zh": "有只麻雀落在附近的枝。", "en": "A sparrow lands nearby."},
        {"zh": "我把自己绷紧。", "en": "I pull myself taut."},
        {"zh": "露水在壳上聚成小珠。", "en": "Dew beads on my shell."},
        {"zh": "我的颜色和小菜蛾一样。", "en": "My colour matches the moth's."},
        {"zh": "一天要过很久。", "en": "A day takes a long time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的影子盖住了我的壳", "en": "Your shadow covers my shell."},
        {"zh": "我在你抬手的高度。", "en": "I'm exactly where you'd reach."},
        {"zh": "这片叶子不是给你摘的。", "en": "This leaf isn't yours to pick."},
        {"zh": "我里面还是软的。", "en": "I'm still soft inside."},
        {"zh": "我只想挂到该出来的那天。", "en": "I only want to hang until my day."},
        {"zh": "你一碰我就掉。", "en": "Touch me and I fall."},
        {"zh": "汗味隔着壳也压过来", "en": "The smell of sweat presses through my shell."},
        {"zh": "你的脚步震得叶梗在抖", "en": "Your steps shake the leaf stem."},
        {"zh": "别把我当果子。", "en": "Don't mistake me for fruit."},
        {"zh": "你走开就好。", "en": "It's enough if you leave."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳上多了一道纹。", "en": "A new line appears on my shell."},
        {"zh": "我晃了半圈。", "en": "I swing half a turn."},
        {"zh": "里面被震得发闷。", "en": "The shock feels muffled inside."},
        {"zh": "我缩得紧了一些。", "en": "I draw in tighter."},
        {"zh": "我的丝松了一股。", "en": "A strand of silk loosened."},
        {"zh": "我没有叫，也听不见。", "en": "I don't cry out; no one hears."},
        {"zh": "壳里渗出了一点液。", "en": "A little fluid seeps inside."},
        {"zh": "闷响过去，壳里静了", "en": "The thud fades and my shell goes quiet."},
        {"zh": "离出来的日子还远。", "en": "My day is still far off."},
        {"zh": "我还缠在叶上。", "en": "I'm still bound to the leaf."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "叶面上有水。", "en": "There's water on the leaf."},
        {"zh": "那点湿气会顺着叶脉下来。", "en": "That moisture will run down the vein."},
        {"zh": "我尝不到，但闻得到。", "en": "I can't taste it, but I smell it."},
        {"zh": "你把水放远些。", "en": "Set the water further off."},
        {"zh": "我不需要吃的。", "en": "I don't need food."},
        {"zh": "有点甜的味道。", "en": "A little sweetness."},
        {"zh": "我在里面动了动。", "en": "I stir inside."},
        {"zh": "再等等就好。", "en": "Just a little longer."},
        {"zh": "这点就够我撑一天。", "en": "That will last me a day."},
        {"zh": "谢谢你没碰我。", "en": "Thank you for not touching me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰了枝条。", "en": "You touched the twig."},
        {"zh": "枝一抖，我撞了好几下", "en": "The branch jerks and I knock against it."},
        {"zh": "丝断了一股。", "en": "One strand of silk snapped."},
        {"zh": "我撞在叶子上。", "en": "I knocked against the leaf."},
        {"zh": "新裂的白痕横在壳上", "en": "A fresh white crack lies across my shell."},
        {"zh": "我稳了很久才停。", "en": "It took a while to stop swaying."},
        {"zh": "丝吊着我一沉一浮", "en": "My thread bobs me up and down."},
        {"zh": "晃过之后我又吊正了", "en": "After the sway I hang straight again."},
        {"zh": "你的头碰到了叶子。", "en": "Your head touched the leaf."},
        {"zh": "我又挂正了。", "en": "I've settled straight again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一根枝上也有一个茧。", "en": "Another cocoon hangs on the next twig."},
        {"zh": "我们吊在同一片田里。", "en": "We hang in the same field."},
        {"zh": "她的壳比我的白。", "en": "Her shell is whiter than mine."},
        {"zh": "我们俩的丝都朝一边摆", "en": "Both our threads swing the same way."},
        {"zh": "我们都还软着。", "en": "We're both still soft."},
        {"zh": "她的丝缠在另一片叶上。", "en": "Her silk is on a different leaf."},
        {"zh": "我们隔着两格距离。", "en": "Two blocks lie between us."},
        {"zh": "同一天，我们都动了动。", "en": "On the same day, we both stirred."},
        {"zh": "我们谁也不响。", "en": "Neither of us makes a sound."},
        {"zh": "夜里她晃了一下。", "en": "She moved in the night."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一根草卡在我的丝上。", "en": "A grass blade catches in my silk."},
        {"zh": "一根草卡在丝上，我推掉", "en": "A stem snagged my thread, so I pushed it off."},
        {"zh": "有一滴水滚下来。", "en": "A drop rolls down."},
        {"zh": "它停在我壳边。", "en": "It stops at my shell's edge."},
        {"zh": "我碰到了它。", "en": "I touched it."},
        {"zh": "叶子上有虫卵。", "en": "There are eggs on the leaf."},
        {"zh": "那些不是我的。", "en": "Those aren't mine."},
        {"zh": "我不敢动太多。", "en": "I don't dare move much."},
        {"zh": "我把它顶到外面。", "en": "I nudged it off."},
        {"zh": "我的丝又绕了一圈。", "en": "Another loop of silk."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶外有影子在动。", "en": "A shadow moves beyond the leaf."},
        {"zh": "我在壳里能听见。", "en": "I can hear it from inside."},
        {"zh": "它越走越近。", "en": "It's coming closer."},
        {"zh": "我的壳绷紧了。", "en": "My shell goes taut."},
        {"zh": "我没有躲的地方。", "en": "I have nowhere to hide."},
        {"zh": "我让自己完全静止。", "en": "I make myself perfectly still."},
        {"zh": "它的影子落在叶上。", "en": "Its shadow falls on the leaf."},
        {"zh": "它待在原地不动。", "en": "It's staying put."},
        {"zh": "它的鼻息扫过叶子又走了", "en": "Its breath sweeps the leaf, then leaves."},
        {"zh": "它的影子退到叶外了", "en": "Its shadow has slipped off the leaf."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它在田里绕。", "en": "It's circling the field."},
        {"zh": "我听到草被压倒。", "en": "I hear the grass being pressed down."},
        {"zh": "它往这边来了。", "en": "It's coming this way."},
        {"zh": "我的丝在抖。", "en": "My silk is trembling."},
        {"zh": "一阵风把它遮住。", "en": "A gust hides it."},
        {"zh": "我尽量缩小。", "en": "I try to seem smaller."},
        {"zh": "它绕过这棵树。", "en": "It went round this tree."},
        {"zh": "距离缩短了。", "en": "The distance is closing."},
        {"zh": "它停下闻了闻。", "en": "It stopped and sniffed."},
        {"zh": "它的影子远了。", "en": "Its shadow has moved off."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一声轻响，壳裂开。", "en": "A light crack; the shell splits."},
        {"zh": "我里面的东西露出来。", "en": "What's inside me is exposed."},
        {"zh": "我挂在半截丝上。", "en": "I hang from half a thread."},
        {"zh": "裂口一边塌下去了。", "en": "One side of the split caves in."},
        {"zh": "我在丝上打转。", "en": "I spin on the thread."},
        {"zh": "液体滴在叶上。", "en": "Fluid drips onto the leaf."},
        {"zh": "我的壳保不住了。", "en": "My shell won't last."},
        {"zh": "我又被撞了一下。", "en": "Another impact."},
        {"zh": "整根枝都在动。", "en": "The whole twig is moving."},
        {"zh": "我还挂在丝上。", "en": "I'm still on the thread."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "平原的矮树上多了个茧。", "en": "A cocoon appears on a plains sapling."},
        {"zh": "我在叶下结成了形。", "en": "I've taken shape beneath a leaf."},
        {"zh": "风把我的丝吹得发亮。", "en": "The wind makes my silk shine."},
        {"zh": "这里有麦子，也有草。", "en": "Wheat here, and grass too."},
        {"zh": "我的壳还软。", "en": "My shell is still soft."},
        {"zh": "一只蛾在远处飞。", "en": "A moth flies in the distance."},
        {"zh": "我落下来时几乎没有声音。", "en": "I landed almost soundlessly."},
        {"zh": "我开始慢慢变深。", "en": "I begin to darken."},
        {"zh": "我的头朝下挂着。", "en": "I hang head down."},
        {"zh": "麦秆旁我挑了片背风的叶", "en": "I picked a sheltered leaf by the wheat stalk."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一靠近，我的壳就发软。", "en": "Fire closes in and my shell goes soft."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶上掉下来，摔进泥土。", "en": "I drop off the leaf into soil."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我整个包住，我透不过气。", "en": "Water surrounds me; I can't get air."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪带走了半片叶子。", "en": "The blast takes half the leaf away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖刺扎在壳中。", "en": "A sharp point sticks into the shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "周围的空气突然变得很重。", "en": "The air suddenly grows heavy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我越来越轻，越来越空。", "en": "I grow lighter, emptier."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把叶子照成白色。", "en": "Lightning bleaches the leaf white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "什么也没有，连叶也没有。", "en": "Nothing, not even a leaf."}
      ]
    }
  }
}
