{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶背下，只有风吹我。", "en": "I hang beneath the leaf; only wind moves me."},
        {"zh": "我没有脚可以走。", "en": "I have no feet to walk with."},
        {"zh": "叶柄一晃，我跟着摆。", "en": "The stem sways and I swing with it."},
        {"zh": "我挪不动半寸。", "en": "I cannot shift half an inch."},
        {"zh": "丝线把我牢牢系住。", "en": "Silk holds me fast."},
        {"zh": "丛林里的湿气把我泡软。", "en": "The jungle damp softens me."},
        {"zh": "我一天比一天沉。", "en": "I grow heavier by the day."},
        {"zh": "下面的叶子接住了我的影。", "en": "The leaf below catches my shadow."},
        {"zh": "我随着枝条缓慢地转。", "en": "I turn slowly with the branch."},
        {"zh": "太阳从叶缝里漏下来。", "en": "Sun leaks through the leaf gaps."},
        {"zh": "我从粉红变成深一点。", "en": "My pink deepens a shade."},
        {"zh": "我等着自己的时间。", "en": "I am waiting for my hour."},
        {"zh": "风一歇，我就垂着。", "en": "When the wind rests, I hang still."},
        {"zh": "雨点打来，我摇得厉害。", "en": "Rain strikes and I swing hard."},
        {"zh": "但没有掉。", "en": "But I do not fall."},
        {"zh": "枝条摆回原位，我停住。", "en": "The branch swings back; I settle."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我吊在那里，一动不动。", "en": "I hang there, motionless."},
        {"zh": "壳上有一层细细的纹。", "en": "Fine ridges run over my shell."},
        {"zh": "阳光透过来，我里面是暖的。", "en": "Sun passes through; I am warm inside."},
        {"zh": "里面有什么在慢慢动。", "en": "Something inside moves slowly."},
        {"zh": "那是我还没长好的翅。", "en": "It is my unfinished wings."},
        {"zh": "我裹得很紧。", "en": "I am wrapped tight."},
        {"zh": "一只蚂蚁爬过来。", "en": "An ant crawls near."},
        {"zh": "它绕了我一圈。", "en": "It circles me once."},
        {"zh": "然后走了。", "en": "Then leaves."},
        {"zh": "我很庆幸。", "en": "I am glad."},
        {"zh": "丛林很吵，我却很静。", "en": "The jungle is loud; I am still."},
        {"zh": "静到手心发麻。", "en": "Still until it feels numb."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你能看见我，是因为我贴着叶子。", "en": "You see me because I cling to the leaf."},
        {"zh": "我没有眼睛可以看你。", "en": "I have no eyes to look with."},
        {"zh": "但我感觉到影子。", "en": "But I feel your shadow."},
        {"zh": "你把脸凑得很近。", "en": "You bring your face close."},
        {"zh": "手指再近，就要压到我了。", "en": "One more finger's width and you'll crush me."},
        {"zh": "里面还很软。", "en": "It is still very soft inside."},
        {"zh": "你的呼吸扫过来。", "en": "Your breath brushes me."},
        {"zh": "壳微微发烫。", "en": "My shell warms slightly."},
        {"zh": "你后退了一点。", "en": "You move back a little."},
        {"zh": "我还在叶下。", "en": "I am still under the leaf."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳上裂了一小道。", "en": "A small crack opens in my shell."},
        {"zh": "疼从壳外传到我中心。", "en": "Pain travels from the shell to my core."},
        {"zh": "里面那层被震到了。", "en": "The inner layer is jarred."},
        {"zh": "我挂在丝上晃。", "en": "I swing on the silk."},
        {"zh": "这道裂会留很久。", "en": "This crack will stay a long time."},
        {"zh": "我只能撑着。", "en": "I can only endure."},
        {"zh": "我别无所能。", "en": "I have nothing else."},
        {"zh": "风又吹起来了。", "en": "The wind rises again."},
        {"zh": "我没有掉。", "en": "I did not fall."},
        {"zh": "丝线没断，我就不会掉。", "en": "The silk holds, so I won't fall."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你把叶子举得再高也没用。", "en": "Hold the leaf as high as you like; it won't help."},
        {"zh": "这个阶段我什么都不需要。", "en": "At this stage I need nothing."},
        {"zh": "你把叶子递到我旁边。", "en": "You hold a leaf beside me."},
        {"zh": "我不吃叶子。", "en": "I do not eat leaves."},
        {"zh": "那种事要等很久。", "en": "That comes much later."},
        {"zh": "现在我只想挂稳。", "en": "For now I only want to hold."},
        {"zh": "你等下去也没用。", "en": "Waiting will do you no good."},
        {"zh": "我连嘴都还没有。", "en": "I do not even have a mouth yet."},
        {"zh": "湿气重，壳上凝了水。", "en": "Damp gathers; water beads on my shell."},
        {"zh": "叶子往下一坠，我悬住。", "en": "The leaf dips; I catch myself."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到那片叶子。", "en": "You touch the leaf."},
        {"zh": "我一整只都在晃。", "en": "My whole body sways."},
        {"zh": "丝线绷紧了一瞬。", "en": "The silk goes taut for an instant."},
        {"zh": "丝线撑住了我，只差一点。", "en": "The silk holds — barely."},
        {"zh": "你的手指停在壳边。", "en": "Your fingers stop at my shell."},
        {"zh": "你的指节蹭过我的壳。", "en": "Your knuckle grazes my shell."},
        {"zh": "我缩不起来。", "en": "I cannot curl away."},
        {"zh": "你把手收走了。", "en": "You take your hand away."},
        {"zh": "叶子慢慢停住。", "en": "The leaf slowly stills."},
        {"zh": "我也停下。", "en": "So do I."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还没有成形。", "en": "I am not formed yet."},
        {"zh": "这些事在我翅膀展开之后。", "en": "That comes after my wings open."},
        {"zh": "现在说起太早。", "en": "It is far too early."},
        {"zh": "我在壳里等着。", "en": "I wait inside my shell."},
        {"zh": "里面很黑。", "en": "It is dark inside."},
        {"zh": "外面有叶子沙沙响。", "en": "Leaves rustle outside."},
        {"zh": "我听着那些声音。", "en": "I listen to them."},
        {"zh": "等我出去，我会知道该找谁。", "en": "When I am out, I will know who to seek."},
        {"zh": "现在我只是挂着。", "en": "For now I only hang."},
        {"zh": "安安静静地。", "en": "Quietly."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我被整片叶子带起来。", "en": "I am lifted with the whole leaf."},
        {"zh": "丝线没有断。", "en": "The silk does not break."},
        {"zh": "我悬在半空。", "en": "I hang in midair."},
        {"zh": "很轻，几乎没重量。", "en": "So light, almost weightless."},
        {"zh": "有人把我放到别的地方。", "en": "Someone sets me elsewhere."},
        {"zh": "这里的光更暗。", "en": "The light is dimmer here."},
        {"zh": "这不是我原来那片叶。", "en": "This isn't the leaf I grew on."},
        {"zh": "但我会适应的。", "en": "But I will adjust."},
        {"zh": "我又挂好了。", "en": "I am hanging again."},
        {"zh": "这次底下没有叶子。", "en": "This time there is no leaf below."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "影子压过来，我知道是你。", "en": "A shadow presses in; I know it's you."},
        {"zh": "我感觉到它挡住了光。", "en": "I feel it block the light."},
        {"zh": "它停在叶下，抬头看我。", "en": "It stops beneath the leaf and looks up."},
        {"zh": "我只能更紧地贴住叶子。", "en": "I can only press tighter to the leaf."},
        {"zh": "丝线发出一点声音。", "en": "The silk makes a small sound."},
        {"zh": "那是我的全部抵抗。", "en": "That is all the resistance I have."},
        {"zh": "它没有碰我。", "en": "It does not touch me."},
        {"zh": "它只是看着。", "en": "It only watches."},
        {"zh": "看了很久。", "en": "For a long while."},
        {"zh": "我等着它走。", "en": "I wait for it to leave."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它的影子还在。", "en": "Its shadow is still there."},
        {"zh": "我不敢动。", "en": "I dare not move."},
        {"zh": "里面那个我不停地动。", "en": "The thing inside me keeps shifting."},
        {"zh": "那不是害怕。", "en": "That is not fear."},
        {"zh": "那是在长。", "en": "That is growth."},
        {"zh": "壳开始变紧。", "en": "My shell grows tight."},
        {"zh": "我一天一天撑满它。", "en": "Day by day I fill it."},
        {"zh": "外面的东西还站着。", "en": "The thing outside still stands."},
        {"zh": "风把它挡在你身上。", "en": "The wind presses it against you."},
        {"zh": "我听见风穿过叶缝。", "en": "I hear wind through the leaf gap."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我碰不到你。", "en": "I cannot reach you."},
        {"zh": "我只能晃。", "en": "I can only sway."},
        {"zh": "壳擦到你的手背。", "en": "My shell grazes the back of your hand."},
        {"zh": "很轻的一下。", "en": "A very light touch."},
        {"zh": "丝线缠上你的手指。", "en": "Silk winds around your finger."},
        {"zh": "你把它扯断了。", "en": "You break it."},
        {"zh": "我掉进你的掌心。", "en": "I drop into your palm."},
        {"zh": "我还在试着动。", "en": "I still try to move."},
        {"zh": "只有一点点。", "en": "Only a little."},
        {"zh": "然后我停了。", "en": "Then I stop."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "叶背上多了一枚粉红。", "en": "A spot of pink appears under the leaf."},
        {"zh": "是毛虫留下的。", "en": "The caterpillar left it."},
        {"zh": "我没有选这个地方。", "en": "I did not choose this place."},
        {"zh": "它替我选了。", "en": "It chose for me."},
        {"zh": "丛林里湿热，正合适。", "en": "The jungle is warm and wet; it suits."},
        {"zh": "丝线绕了几圈。", "en": "The silk went round several times."},
        {"zh": "我悬在它下面。", "en": "I hang beneath it."},
        {"zh": "风一吹就开始摇。", "en": "Any wind sets me rocking."},
        {"zh": "毛虫把我系在这片叶下。", "en": "The caterpillar tied me under this leaf."},
        {"zh": "只能等。", "en": "Only wait."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一近，壳就噼啪响。", "en": "Flame close by makes my shell crackle."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉在地上，壳磕裂了。", "en": "I fall and my shell cracks."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浸透了丝线，我越来越沉。", "en": "Water soaks the silk; I grow heavy."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我从叶上撕下来。", "en": "The blast tears me off the leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西擦过我的壳。", "en": "It grazes my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷穿过壳，我里面一紧。", "en": "A chill passes through; I tighten inside."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这个阶段我不吃东西。", "en": "At this stage I do not eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光穿过叶缝，我整个发亮。", "en": "Lightning lights the leaf gap and I glow."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗里没有叶子可挂。", "en": "In the dark there is no leaf to hang from."}
      ]
    }
  }
}
