{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶下，不能走。", "en": "I hang beneath the leaf, unable to walk."},
        {"zh": "我的壳在轻轻抽动。", "en": "My case twitches faintly."},
        {"zh": "我用丝把自己拴住。", "en": "A silk thread holds me fast."},
        {"zh": "我在壳里翻了个身。", "en": "I turn once inside the case."},
        {"zh": "外面有风，我晃了晃。", "en": "Wind outside rocks me."},
        {"zh": "叶子把我遮得很严。", "en": "The leaf hides me well."},
        {"zh": "再过几天，我就要撑开这层壳。", "en": "In a few days, I will split this shell open."},
        {"zh": "壳内的东西在动。", "en": "Something moves within the case."},
        {"zh": "我的壳微微发热。", "en": "My case is faintly warm."},
        {"zh": "我从叶缘挂到了叶背。", "en": "I hang from the edge to the underside."},
        {"zh": "我被丝吊在叶柄下，不摇。", "en": "Silk hangs me under the leaf stem; I do not sway."},
        {"zh": "一阵风让我摆了一下。", "en": "A gust swings me once."},
        {"zh": "我又往叶脉那边挪了半分。", "en": "I shift half an inch toward the vein."},
        {"zh": "我就在这一小片叶上。", "en": "I stay on this one small leaf."},
        {"zh": "壳内的我在慢慢转身。", "en": "Inside, I slowly turn about."},
        {"zh": "我沿着丝滑了一点。", "en": "I slide a little along the silk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我是绿色的，像片叶。", "en": "I'm green, like a leaf."},
        {"zh": "我的壳上有细纹。", "en": "Fine ridges run across my case."},
        {"zh": "我挂在那里，什么也不做。", "en": "I hang there doing nothing."},
        {"zh": "我在壳里听风。", "en": "I listen to the wind from inside."},
        {"zh": "有人从我旁边走过。", "en": "Someone walks right past me."},
        {"zh": "我的壳一天比一天亮。", "en": "My case grows brighter each day."},
        {"zh": "我在变成另一种东西。", "en": "I'm becoming another thing."},
        {"zh": "叶上有露水，顺着淌下。", "en": "Dew runs down the leaf."},
        {"zh": "我没有嘴，不能吃。", "en": "I have no mouth, I cannot eat."},
        {"zh": "鸟在树上叫，我屏住。", "en": "A bird calls; I go still."},
        {"zh": "我的丝缠得更紧了。", "en": "My silk draws tighter."},
        {"zh": "我挂在叶背，一动不动。", "en": "I hang under the leaf without moving."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你手指的影子扫过我的壳。", "en": "Your finger's shadow sweeps over my shell."},
        {"zh": "绿色外壳上，有一圈金点。", "en": "A ring of gold dots on my green shell."},
        {"zh": "别摘这片叶子。", "en": "Don't pick this leaf."},
        {"zh": "你手里有我需要的吗？", "en": "Do you have what I need?"},
        {"zh": "我动不了。", "en": "I can't move."},
        {"zh": "你的呼吸让叶子摇。", "en": "Your breath makes the leaf sway."},
        {"zh": "再过一阵我就不在这了。", "en": "Soon I won't be here."},
        {"zh": "你手上的影子挡住我了。", "en": "Your shadow covers me."},
        {"zh": "里面已经是只蝶。", "en": "There's a butterfly inside."},
        {"zh": "你得等。", "en": "You'll have to wait."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳裂了个缝。", "en": "A crack splits my case."},
        {"zh": "有液体渗出来了。", "en": "Fluid seeps out."},
        {"zh": "我挂在丝上乱摆。", "en": "I swing wildly on the silk."},
        {"zh": "别捏，里面是软的。", "en": "Don't squeeze, it's soft inside."},
        {"zh": "我在壳里缩紧。", "en": "I draw tight inside."},
        {"zh": "我还没成形好。", "en": "I'm not finished forming."},
        {"zh": "这点裂还好。", "en": "The crack is survivable."},
        {"zh": "我能听见自己的壳响。", "en": "I hear my own shell crack."},
        {"zh": "风在灌进来。", "en": "Wind is getting in."},
        {"zh": "让我待着别动。", "en": "Let me stay undisturbed."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这个阶段，我什么都不吃。", "en": "At this stage, I eat nothing."},
        {"zh": "这东西我碰不到。", "en": "I can't reach that."},
        {"zh": "等我出壳吧。", "en": "Wait till I emerge."},
        {"zh": "你举着它给谁看？", "en": "Who are you holding that for?"},
        {"zh": "里面的我什么也吃不了。", "en": "The me inside can't eat a thing."},
        {"zh": "叶子不能摘。", "en": "Don't pick the leaf."},
        {"zh": "再等几天。", "en": "A few more days."},
        {"zh": "你放那儿就好。", "en": "Just leave it there."},
        {"zh": "我只是壳。", "en": "I'm only a shell."},
        {"zh": "拿开吧，我连转身都难。", "en": "Put it away, I can barely turn."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得摆起来。", "en": "The bump set me swinging."},
        {"zh": "丝还是拴着的。", "en": "The silk still holds."},
        {"zh": "别碰我挂着的叶子。", "en": "Don't touch the leaf I hang from."},
        {"zh": "别碰，壳里全是没长好的翅。", "en": "Do not touch; unfinished wings fill this shell."},
        {"zh": "你晃到了我的枝。", "en": "You shook my twig."},
        {"zh": "我差点脱了丝。", "en": "I nearly tore loose."},
        {"zh": "这点碰撞我还受得住。", "en": "I can take that much."},
        {"zh": "我压得叶片弯下去。", "en": "My weight bows the leaf."},
        {"zh": "你再碰就要掉了。", "en": "Another touch and I'll fall."},
        {"zh": "我在壳里缩了一下。", "en": "I shrink inside the case."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在壳里呢。", "en": "I'm inside a case."},
        {"zh": "等我出来再说。", "en": "Ask me after I emerge."},
        {"zh": "我连翅膀都还没干。", "en": "My wings aren't even dry."},
        {"zh": "你别摇这片叶。", "en": "Don't shake this leaf."},
        {"zh": "这一阶段我做不了什么。", "en": "At this stage I can do nothing."},
        {"zh": "安静等一会。", "en": "Wait quietly a while."},
        {"zh": "我还在变形。", "en": "I'm still changing."},
        {"zh": "我现在没有任何感觉。", "en": "I feel nothing at all right now."},
        {"zh": "过几天吧。", "en": "In a few days."},
        {"zh": "别把叶子摘下来。", "en": "Don't pick the leaf."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我连爪子都没有。", "en": "I don't even have claws."},
        {"zh": "这东西太重，我拿不住。", "en": "Too heavy, I can't hold it."},
        {"zh": "我挂在叶下够不到。", "en": "Hanging here, I can't reach."},
        {"zh": "露水从我壳上滑下。", "en": "Dew slides off my case."},
        {"zh": "我没法捡任何东西。", "en": "I can't pick up anything."},
        {"zh": "你去拿吧。", "en": "You go get it."},
        {"zh": "我看到的只有叶脉。", "en": "All I see is leaf veins."},
        {"zh": "叶子下面什么也没有。", "en": "Nothing under the leaf."},
        {"zh": "我被粘在叶子背面。", "en": "I'm stuck to the underside of a leaf."},
        {"zh": "等我出壳再帮你。", "en": "I'll help once I emerge."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着叶子的边缘。", "en": "I stare at the leaf's edge."},
        {"zh": "快了，壳在变薄。", "en": "Soon, the case is thinning."},
        {"zh": "我听见外面有动静。", "en": "I hear movement outside."},
        {"zh": "我要出去。", "en": "I want out."},
        {"zh": "丝在松。", "en": "The silk is loosening."},
        {"zh": "有光透进来。", "en": "Light is coming through."},
        {"zh": "我开始挣了。", "en": "I start to push."},
        {"zh": "这层壳挡不住我太久。", "en": "This shell won't hold me long."},
        {"zh": "再等一会。", "en": "A little longer."},
        {"zh": "你退远一点。", "en": "Step back a bit."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳裂了一条缝。", "en": "A crack runs down my case."},
        {"zh": "里面有东西在顶。", "en": "Something pushes from inside."},
        {"zh": "我的翅在壳里折着。", "en": "My wings are folded inside."},
        {"zh": "我能感觉到风了。", "en": "I can feel the wind now."},
        {"zh": "叶子在轻轻颤。", "en": "The leaf trembles slightly."},
        {"zh": "再过一炷香。", "en": "One more incense stick's time."},
        {"zh": "裂缝变宽了。", "en": "The crack is widening."},
        {"zh": "壳里的我，正在重新拼装身体。", "en": "Inside this shell, I am rebuilding my body."},
        {"zh": "别帮我撕它。", "en": "Don't tear it for me."},
        {"zh": "我自己能出来。", "en": "I can get out myself."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我根本不攻击。", "en": "I don't attack at all."},
        {"zh": "我连动都动不了。", "en": "I can't even move."},
        {"zh": "你撞到的是壳。", "en": "You hit my case."},
        {"zh": "这层壳很薄。", "en": "This shell is thin."},
        {"zh": "我在壳里晃了一下。", "en": "I jolt inside the case."},
        {"zh": "我没有任何武器。", "en": "I have no weapons."},
        {"zh": "你碰歪了丝，我在壳里晃。", "en": "You disturbed the silk; I rock inside."},
        {"zh": "丝还挂着，我掉不下去。", "en": "The silk holds, I won't fall."},
        {"zh": "别再碰了。", "en": "Stop touching me."},
        {"zh": "我只需要安静。", "en": "I only need quiet."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "毛虫把我结在了叶上。", "en": "A caterpillar spun me onto this leaf."},
        {"zh": "我挂在这里，像颗绿珠。", "en": "I hang here like a green bead."},
        {"zh": "我一动不动地出现。", "en": "I appear without a motion."},
        {"zh": "叶背多了一个小包。", "en": "A small lump on the leaf's underside."},
        {"zh": "我选了最稳的一片叶。", "en": "I picked the steadiest leaf."},
        {"zh": "丝缠了三圈。", "en": "Three turns of silk."},
        {"zh": "阳光从叶缝间落在我身上。", "en": "Sunlight falls on me through the leaf."},
        {"zh": "外面很安静。", "en": "It's quiet outside."},
        {"zh": "我开始等了。", "en": "I begin to wait."},
        {"zh": "这里面只有我。", "en": "There's only me inside."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一近，壳就软了。", "en": "Fire near, and my case softens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶上掉下，摔裂了。", "en": "I fall from the leaf and split."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水泡透了我的壳。", "en": "Water soaks through my case."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我从叶上掀下。", "en": "The blast tears me from the leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西扎穿了我的壳。", "en": "That pierced my case."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光一闪，我的壳发烫。", "en": "A flash and my case grows hot."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这一阶段我不吃不喝。", "en": "At this stage I neither eat nor drink."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在树上，我的丝焦了。", "en": "Lightning hits the tree, my silk scorches."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有叶子可挂。", "en": "No leaf to hang from in the void."}
      ]
    }
  }
}
