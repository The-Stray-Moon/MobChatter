{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扇着黑白花纹的翅。", "en": "I beat my black-and-white wings."},
        {"zh": "我在丘陵上慢慢飞。", "en": "I fly slowly over the hills."},
        {"zh": "风一来我就滑一段。", "en": "Wind comes and I glide a stretch."},
        {"zh": "我停在郁金香边上。", "en": "I settle by a tulip."},
        {"zh": "翅膀上的纹路让人认错。", "en": "The wing pattern fools the eye."},
        {"zh": "我绕着花丛转一圈。", "en": "I circle the flower patch."},
        {"zh": "我飞得非常低。", "en": "I fly very low."},
        {"zh": "花瓣被我碰得摇。", "en": "My touch rocks the petals."},
        {"zh": "我顺着坡往上飞。", "en": "I fly up along the slope."},
        {"zh": "这条路线我熟。", "en": "I know this route."},
        {"zh": "我停在草叶上歇歇。", "en": "I rest on a grass blade."},
        {"zh": "再飞一段就到花丛。", "en": "One more stretch to the flowers."},
        {"zh": "我在阳光里扇翅。", "en": "I fan my wings in sunlight."},
        {"zh": "我的影子落在花上。", "en": "My shadow falls on the flower."},
        {"zh": "我绕开了高草。", "en": "I veer around the tall grass."},
        {"zh": "两只翅一上一下。", "en": "The two wings rise and fall."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我合起翅膀停着。", "en": "I fold my wings and rest."},
        {"zh": "花纹让鸟看不懂我。", "en": "The pattern confuses the birds."},
        {"zh": "我在花瓣上站住。", "en": "I stand on a petal."},
        {"zh": "我的触须慢慢动。", "en": "My antennae move slowly."},
        {"zh": "阳光晒暖了翅膀。", "en": "Sun warms my wings."},
        {"zh": "这里的花很红。", "en": "The flowers here are very red."},
        {"zh": "我听了听风声。", "en": "I listen to the wind."},
        {"zh": "我只管在花上晒太阳。", "en": "There's nothing I must do."},
        {"zh": "我在这儿歇脚。", "en": "I'm resting."},
        {"zh": "远处有别的蝶。", "en": "Another butterfly far off."},
        {"zh": "这一朵花正好。", "en": "This flower is just right."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看得出我不是那朵花吗？", "en": "Can you tell I'm not that flower?"},
        {"zh": "我的花纹像另一只蝶。", "en": "My markings mimic another butterfly."},
        {"zh": "你别伸手太快。", "en": "Don't reach so fast."},
        {"zh": "你的帽子很像叶子。", "en": "Your hat looks like a leaf."},
        {"zh": "我在这里喝花蜜。", "en": "I'm drinking nectar here."},
        {"zh": "你走近，我就飞。", "en": "Come closer and I fly."},
        {"zh": "我这点大，不值得抓。", "en": "I'm too small to bother catching."},
        {"zh": "你看见的是花纹，不是我。", "en": "You see the pattern, not me."},
        {"zh": "你的呼吸吹到我了。", "en": "Your breath reaches me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅被弄皱了。", "en": "My wings got crumpled."},
        {"zh": "我掉低了半格。", "en": "I dropped half a block."},
        {"zh": "我拼命扇翅膀。", "en": "I beat my wings hard."},
        {"zh": "我停不下来了。", "en": "I can't stop spinning."},
        {"zh": "这点伤对我太重了。", "en": "That's heavy for something my size."},
        {"zh": "我躲进花朵里。", "en": "I hide in the flower."},
        {"zh": "我不敢再飞高。", "en": "I daren't fly high now."},
        {"zh": "我的花纹乱了。", "en": "My markings are disordered."},
        {"zh": "让我先落下来。", "en": "Let me land."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "红花我最喜欢。", "en": "Red flowers are my favorite."},
        {"zh": "这朵的蜜很甜。", "en": "The nectar in this one is sweet."},
        {"zh": "你手上那朵不太新鲜。", "en": "That flower in your hand isn't fresh."},
        {"zh": "我绕着花心打转。", "en": "I circle the heart of the flower."},
        {"zh": "别动，我落在上面。", "en": "Hold still; I'm landing."},
        {"zh": "有花蜜我就来。", "en": "If there's nectar, I'll come."},
        {"zh": "这味道引我过去。", "en": "That scent draws me over."},
        {"zh": "你的手晃得我眼花。", "en": "Your hand wavers and dazzles me."},
        {"zh": "粉色的最合我意。", "en": "Pink ones are best."},
        {"zh": "我就在这儿喝一口。", "en": "I'll take one sip here."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞偏了翅膀。", "en": "The bump knocks one wing askew."},
        {"zh": "鳞粉沾在你手上。", "en": "Scale dust is on your hand."},
        {"zh": "我得重新稳住。", "en": "I must steady myself again."},
        {"zh": "别在花丛里挥手。", "en": "Don't wave your hands in the flowers."},
        {"zh": "叶子被我撞得颤。", "en": "The leaf shook when I hit it."},
        {"zh": "我飞开一点点。", "en": "I fly a little aside."},
        {"zh": "你的帽檐碰到了花。", "en": "Your hat brim hit the flower."},
        {"zh": "让我先过去吧。", "en": "Let me pass."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在丘陵上找同类。", "en": "I'm looking for my own kind on the hills."},
        {"zh": "这花纹就是为了被认出来。", "en": "This pattern exists to be recognized."},
        {"zh": "你绕着我飞一圈。", "en": "Circle around me once."},
        {"zh": "花丛边最合适。", "en": "By the flower patch is best."},
        {"zh": "别急，先对一对翅。", "en": "Easy; let's match wingbeats first."},
        {"zh": "太阳还没落下。", "en": "The sun hasn't set."},
        {"zh": "我们再飞一段。", "en": "Let's fly a little further."},
        {"zh": "那边的花更密。", "en": "The flowers are denser over there."},
        {"zh": "你的翅色和我很像。", "en": "Your wing color is much like mine."},
        {"zh": "就这样慢慢飞。", "en": "Just fly slowly like this."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我脚上抓不住。", "en": "My feet can't grip it."},
        {"zh": "这花瓣可以带走吗？", "en": "Can I take this petal?"},
        {"zh": "我落在它上面。", "en": "I land on top of it."},
        {"zh": "太重了，我抬不动。", "en": "Too heavy for me to lift."},
        {"zh": "我在上面闻了闻。", "en": "I sniff it once."},
        {"zh": "不是花，我不要。", "en": "Not a flower; I don't want it."},
        {"zh": "我抖掉身上的鳞粉。", "en": "I shake the scale dust off."},
        {"zh": "它把花压弯了。", "en": "It's bending the flower."},
        {"zh": "我已经飞走了。", "en": "I fly away."},
        {"zh": "这个留给你吧。", "en": "It's yours."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有朵红花。", "en": "There's a red flower over there."},
        {"zh": "我盯住那点颜色。", "en": "I fix on that color."},
        {"zh": "翅一张就过去。", "en": "One wingbeat and I'm there."},
        {"zh": "花蜜的味道飘过来。", "en": "Nectar scent drifts over."},
        {"zh": "我把飞行压低了。", "en": "I drop lower."},
        {"zh": "这朵应该开了。", "en": "That one should be open."},
        {"zh": "我绕着花枝飞。", "en": "I round the flower stems."},
        {"zh": "我就停在那边。", "en": "I'll land over there."},
        {"zh": "再往花瓣上近一点。", "en": "A little closer."},
        {"zh": "我已经落在花心上了。", "en": "There."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢扇着翅。", "en": "I beat my wings slowly."},
        {"zh": "花就在我下面。", "en": "The flower is right below."},
        {"zh": "我在找落脚的位置。", "en": "I look for a place to land."},
        {"zh": "风把花瓣吹得直摇。", "en": "The wind keeps rocking the petal."},
        {"zh": "我等着风停下来。", "en": "I wait for the wind to stop."},
        {"zh": "花瓣边缘正好。", "en": "The petal edge is just right."},
        {"zh": "我的触须先碰到。", "en": "My antennae touch first."},
        {"zh": "我把脚伸下去。", "en": "I reach out my feet."},
        {"zh": "我就停在这里。", "en": "Right here."},
        {"zh": "我已经停稳了。", "en": "Landed."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扇翅撞上去。", "en": "I beat my wings into it."},
        {"zh": "鳞粉撒了出去。", "en": "Scale dust scatters."},
        {"zh": "我只是想赶走它。", "en": "I only want to drive it off."},
        {"zh": "它被我扰得偏了。", "en": "It veered away from me."},
        {"zh": "我的翅尖碰到它。", "en": "My wingtip touched it."},
        {"zh": "这样完全没用。", "en": "This is useless."},
        {"zh": "我再飞高一点。", "en": "I rise higher."},
        {"zh": "离开这一朵花。", "en": "Leave this flower."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从蛹里出来。", "en": "I came out of the chrysalis."},
        {"zh": "翅膀还没干透。", "en": "My wings are still wet."},
        {"zh": "我慢慢展开翅。", "en": "I slowly spread my wings."},
        {"zh": "第一次扇动很费劲。", "en": "The first beat is hard work."},
        {"zh": "这里有郁金香。", "en": "Tulips here."},
        {"zh": "丘陵上的风不错。", "en": "Good wind on these hills."},
        {"zh": "我停在草尖上。", "en": "I perch on a grass tip."},
        {"zh": "我认得这种花。", "en": "I know this kind of flower."},
        {"zh": "我飞了一整圈。", "en": "I made one circuit."},
        {"zh": "先找点花蜜喝。", "en": "First, some nectar."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗燎过来，我的翅膀卷了边。", "en": "Flame came near; my wing edge curled."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处掉进草丛。", "en": "I fell from height into the grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我的翅黏在一起。", "en": "Water glued my wings together."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我卷出好远。", "en": "The blast spun me far away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西把我的翅膀打穿了一个洞。", "en": "Something punched a hole in my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我的翅发抖。", "en": "That force made my wings tremble."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我没力气扇翅了。", "en": "I'm too weak to beat my wings."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声把我从花上震下来。", "en": "The thunder knocked me off the flower."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我收着翅，一直往下掉。", "en": "I fold my wings and keep falling."}
      ]
    }
  }
