{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "青色的身体在叶上蠕动。", "en": "My cyan body inches across the leaf."},
        {"zh": "我挪一节，停一下。", "en": "I shift one segment, then pause."},
        {"zh": "叶面滑，我抓得很牢。", "en": "The leaf is slick. I hold tight."},
        {"zh": "我从叶缘往里爬。", "en": "From the leaf's edge inward."},
        {"zh": "青色的皮在阳光下很亮。", "en": "My cyan skin shines in the sun."},
        {"zh": "我边走边啃出一道路。", "en": "I chew a path as I go."},
        {"zh": "我压弯了细小的叶尖。", "en": "I bend the slender leaf tip."},
        {"zh": "我绕过虫卵那一块。", "en": "I go around the eggs."},
        {"zh": "身下的叶脉像条路。", "en": "The vein beneath me is a road."},
        {"zh": "我一节一节往前推。", "en": "Pushing forward segment by segment."},
        {"zh": "丛林里湿气很重。", "en": "The jungle air is heavy with damp."},
        {"zh": "我找到了更新的那一枝。", "en": "I've found a fresher branch."},
        {"zh": "青色的身子跟叶子撞色。", "en": "My cyan blends with the leaf."},
        {"zh": "我爬过被咬空的洞。", "en": "I crawl across an eaten hole."},
        {"zh": "我停下来喘一喘。", "en": "I stop to catch my breath."},
        {"zh": "我从上面翻了过去。", "en": "I flipped over the top."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在叶心不动。", "en": "Lying still in the heart of the leaf."},
        {"zh": "青色的皮绷得紧紧的。", "en": "My cyan skin stretched tight."},
        {"zh": "我嘴里还含着叶渣。", "en": "Leaf bits still in my mouth."},
        {"zh": "滴下来的水打在我背上。", "en": "Water drips onto my back."},
        {"zh": "我数着经过的光斑。", "en": "Counting the patches of light."},
        {"zh": "这片叶子我吃了一半。", "en": "I've eaten half this leaf."},
        {"zh": "我需要不停地进食。", "en": "I need to keep feeding."},
        {"zh": "离开叶子我就会干死。", "en": "Off a leaf I'd dry out."},
        {"zh": "我在听树上的动静。", "en": "Listening to the tree above."},
        {"zh": "我的身体轻轻起伏。", "en": "My body rises and falls."},
        {"zh": "我缩在叶背的阴影里。", "en": "Curled in the leaf's shade."},
        {"zh": "很久没人来这片林子。", "en": "No one's come to this grove in a while."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你从哪儿看见我的？", "en": "How did you spot me?"},
        {"zh": "青色的我藏在叶子里。", "en": "My cyan hides me in the leaves."},
        {"zh": "别把这片叶子摘了。", "en": "Don't pick this leaf."},
        {"zh": "我到现在还没长成。", "en": "I still haven't grown up."},
        {"zh": "你的影子把我的光全吃了。", "en": "Your shadow swallows all my light."},
        {"zh": "你想把我搬到温室吗？", "en": "Do you mean to move me to a greenhouse?"},
        {"zh": "我只认叶子，不认人。", "en": "I know leaves, not people."},
        {"zh": "你的手指好粗。", "en": "Your fingers are so thick."},
        {"zh": "我害怕被拎起来。", "en": "I'm afraid of being lifted."},
        {"zh": "这棵树上全是我的同类。", "en": "This tree's full of my kind."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我缩成了一小段。", "en": "I've shrunk into a small segment."},
        {"zh": "我的皮被划破了。", "en": "My skin got cut."},
        {"zh": "我掉在下面那片叶。", "en": "I dropped to the leaf below."},
        {"zh": "我疼得打起卷来。", "en": "Pain curls me up."},
        {"zh": "绿汁从伤口渗出。", "en": "Green juice seeps from the wound."},
        {"zh": "我抓紧剩下的叶脉。", "en": "I grip what's left of the vein."},
        {"zh": "身体变得很僵。", "en": "My body has gone stiff."},
        {"zh": "我还咬着叶子不放。", "en": "I'm still clamped to the leaf."},
        {"zh": "别踩，我在叶下。", "en": "Don't step. I'm under the leaf."},
        {"zh": "我慢慢才缓过来。", "en": "It takes me a while to recover."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子一定要是嫩的。", "en": "The leaf has to be tender."},
        {"zh": "青色叶子更好吃。", "en": "Green leaves taste better."},
        {"zh": "你别拿花瓣骗我。", "en": "Don't tempt me with petals."},
        {"zh": "放近一点，我够不着。", "en": "Bring it closer. I can't reach."},
        {"zh": "我想吃叶背那一面。", "en": "I want the underside."},
        {"zh": "这叶子有没有打过药？", "en": "Was this leaf sprayed?"},
        {"zh": "我一口就能试出来。", "en": "One bite tells me."},
        {"zh": "别把叶柄扯断了。", "en": "Don't snap the stem off."},
        {"zh": "再多一片就好了。", "en": "One more leaf would be nice."},
        {"zh": "我不吃根，只吃叶。", "en": "Not roots. Only leaves."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了我所在的枝。", "en": "You bumped the branch I'm on."},
        {"zh": "我抱紧了叶脉。", "en": "I hugged the midrib."},
        {"zh": "轻一点，我会掉。", "en": "Careful. I'll fall."},
        {"zh": "你踩到了地上的落叶。", "en": "You stepped on the fallen leaves."},
        {"zh": "我往旁边挪了一节。", "en": "I shifted a segment aside."},
        {"zh": "我的脚被压住了。", "en": "My feet got pinned."},
        {"zh": "叶子摇了，我也摇。", "en": "The leaf swayed. So did I."},
        {"zh": "别用叶子扇我。", "en": "Don't fan me with a leaf."},
        {"zh": "你离我太近，反光刺眼。", "en": "Too close. The glare stings."},
        {"zh": "退半步就行，真的。", "en": "Half a step back. Truly."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "青色还没褪，谈这个太早。", "en": "My cyan has not faded. Too early for that."},
        {"zh": "我只是一条幼虫。", "en": "I'm only a larva."},
        {"zh": "先让我吃完这片叶。", "en": "Let me finish this leaf first."},
        {"zh": "等结蛹之后再说。", "en": "After I pupate, maybe."},
        {"zh": "这件事我完全不懂。", "en": "I don't understand it at all."},
        {"zh": "丛林里还有别的毛虫。", "en": "There are other caterpillars here."},
        {"zh": "我的身体还太软。", "en": "My body's still too soft."},
        {"zh": "请不要说这些了。", "en": "Please don't say such things."},
        {"zh": "我只想找下一片叶子。", "en": "I only want the next leaf."},
        {"zh": "我听不懂，也不回答。", "en": "I don't follow, and won't answer."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我捧在手心。", "en": "You've cupped me in your hand."},
        {"zh": "请放我回叶子上。", "en": "Put me back on a leaf, please."},
        {"zh": "我的手够不着那么远。", "en": "I can't reach that far."},
        {"zh": "这个不软，也不嫩。", "en": "This isn't soft or tender."},
        {"zh": "我缠在你的指头上。", "en": "I've curled around your finger."},
        {"zh": "我试着咬了一口。", "en": "I tried one bite."},
        {"zh": "地上没有叶子，我会干死。", "en": "No leaf on the ground. I would dry out."},
        {"zh": "这个的味道不对。", "en": "This one tastes wrong."},
        {"zh": "我挪到了你的袖口。", "en": "I've moved to your cuff."},
        {"zh": "你的手心有点干。", "en": "Your palm is a little dry."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有影子过来了。", "en": "A shadow's coming over."},
        {"zh": "有影子压下来，我抬起前半身。", "en": "A shadow drops; I lift my front half."},
        {"zh": "那片叶子被碰动了。", "en": "That leaf was nudged."},
        {"zh": "有东西在树枝上走。", "en": "Something's walking on the branch."},
        {"zh": "我得往叶背躲。", "en": "I should hide underneath."},
        {"zh": "我听见很重的脚步。", "en": "I hear heavy footsteps."},
        {"zh": "风里有一股陌生的味。", "en": "An unfamiliar smell on the wind."},
        {"zh": "我绷紧了身体。", "en": "I've tensed up."},
        {"zh": "那个方向有动静。", "en": "Movement in that direction."},
        {"zh": "我缩到叶柄后面。", "en": "I duck behind the stem."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它还在树下面。", "en": "It's still under the tree."},
        {"zh": "我一点都不敢动。", "en": "I don't dare move at all."},
        {"zh": "青色的皮正好当掩护。", "en": "My cyan is good cover."},
        {"zh": "它的视线扫过来了。", "en": "Its gaze swept over."},
        {"zh": "再等一下它就走了。", "en": "A moment more and it'll go."},
        {"zh": "我贴着叶脉趴平。", "en": "I flatten along the vein."},
        {"zh": "我的心跳好像听得见。", "en": "I can almost hear my own pulse."},
        {"zh": "叶子挡住了我。", "en": "The leaf is hiding me."},
        {"zh": "我把青色压进叶脉的凹处。", "en": "I press my cyan into the hollow of the vein."},
        {"zh": "它没看到这里。", "en": "It didn't see this spot."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用头去顶你。", "en": "I butt my head at you."},
        {"zh": "我咬住叶子不放。", "en": "I clamp onto the leaf."},
        {"zh": "我吐出一点绿汁。", "en": "I spat out some green juice."},
        {"zh": "别碰我，我会扭动。", "en": "Don't touch me. I'll twist."},
        {"zh": "我挥动前半身。", "en": "I whip my front half."},
        {"zh": "我整条身子甩在你手上。", "en": "I fling my whole body at your hand."},
        {"zh": "我从叶子上滑下去。", "en": "I slid off the leaf."},
        {"zh": "我撞了你的指节。", "en": "I bumped your knuckle."},
        {"zh": "我缠住你的笔杆。", "en": "I coiled around your pen."},
        {"zh": "我挣了一下，没挣开。", "en": "One struggle. It didn't work."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在青色叶子上孵出。", "en": "I hatched on a cyan leaf."},
        {"zh": "太阳把叶面晒得暖暖的。", "en": "The sun has warmed the leaf."},
        {"zh": "我第一条路是叶脉。", "en": "My first path was a vein."},
        {"zh": "我一睁眼就在嚼。", "en": "I was chewing before I could see."},
        {"zh": "青色是我的保护色。", "en": "Cyan is my camouflage."},
        {"zh": "我身边全是嫩芽。", "en": "Tender shoots all around me."},
        {"zh": "我青色的身体从卵壳里松开。", "en": "My cyan body loosens out of the eggshell."},
        {"zh": "这片丛林又湿又热。", "en": "This jungle is hot and wet."},
        {"zh": "我把卵壳吃掉了。", "en": "I ate the shell I came from."},
        {"zh": "有雨滴落在旁边。", "en": "Raindrops land nearby."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗从叶边烧过来了。", "en": "Flames crept in from the leaf's edge."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高高的枝上掉下去。", "en": "I fell from a high branch."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "雨水积在叶上，我被泡着。", "en": "Rain pooled on the leaf and soaked me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把整片叶子掀翻。", "en": "The blast flipped the whole leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根细刺穿过我的叶子。", "en": "Something pierced my leaf."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我全身一紧。", "en": "That light made my whole body clench."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子没了，我越来越软。", "en": "No leaf left. I'm softening up."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把叶面照得雪白。", "en": "The flash turned the leaf white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在往下坠，叶也不在。", "en": "I'm falling, and there's no leaf."}
      ]
    }
  }
}
