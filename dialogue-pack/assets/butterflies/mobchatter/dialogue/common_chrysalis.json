{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在叶下不动", "en": "I hang under the leaf, unmoving."},
        {"zh": "我没有腿可以走", "en": "I have no legs to walk with."},
        {"zh": "风推我，我只会摇", "en": "The wind pushes, and I only sway."},
        {"zh": "我靠一根丝挂着", "en": "A single thread holds me."},
        {"zh": "我的壳硬了", "en": "My case has hardened."},
        {"zh": "里面在慢慢改变", "en": "Things change slowly inside."},
        {"zh": "我偶尔扭一下", "en": "I twitch now and then."},
        {"zh": "我晃出一小段弧", "en": "I swing in a small arc."},
        {"zh": "这根丝很结实", "en": "This thread is strong."},
        {"zh": "叶柄是我的支点", "en": "The stem is my pivot."},
        {"zh": "我动不了多远", "en": "I cannot move far at all."},
        {"zh": "我在等自己变完", "en": "I wait to finish becoming."},
        {"zh": "壳上有了细细的纹", "en": "Fine ridges on my case."},
        {"zh": "我的外壳泛着绿", "en": "My shell has a green sheen."},
        {"zh": "我悬在半空", "en": "I hang in midair."},
        {"zh": "我只有摇晃这一种动作", "en": "Swaying is my only motion."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在丝上一动不动", "en": "I hang on my thread without moving."},
        {"zh": "壳里很安静", "en": "It is quiet inside."},
        {"zh": "我在长翅膀", "en": "I am growing wings."},
        {"zh": "外面的光会变绿", "en": "The light outside turns green."},
        {"zh": "我听见风穿过叶", "en": "I hear wind through the leaves."},
        {"zh": "还没到出来的时候", "en": "Not time to come out yet."},
        {"zh": "我贴着叶子背面", "en": "I press against the leaf underside."},
        {"zh": "一根丝就够我挂着", "en": "One thread is enough to hang by."},
        {"zh": "我在慢慢变硬", "en": "I am slowly hardening."},
        {"zh": "别的虫爬过去了", "en": "Another insect crawled past."},
        {"zh": "我不需要吃", "en": "I do not need to eat."},
        {"zh": "丝还没干，我得再挂一阵。", "en": "The silk isn't dry; I must hang a while longer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看的是蛹", "en": "You are looking at a chrysalis."},
        {"zh": "我不是果实", "en": "I am not a fruit."},
        {"zh": "捏了就会破", "en": "Squeeze me and I break."},
        {"zh": "里面的东西还嫩", "en": "What is inside is still soft."},
        {"zh": "你能看见我的纹吗", "en": "Can you see my ridges?"},
        {"zh": "我挂着不动的", "en": "I hang still."},
        {"zh": "你手一碰我就掉", "en": "One touch and I fall."},
        {"zh": "再给我几天，壳还没硬透。", "en": "Give me a few more days; my shell isn't set."},
        {"zh": "别摘这片叶子", "en": "Do not pick this leaf."},
        {"zh": "等我自己裂开", "en": "Wait until I split open myself."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳裂了一道", "en": "A crack in my case."},
        {"zh": "我晃得很厉害", "en": "I am swinging hard."},
        {"zh": "里面的东西动了", "en": "Something inside shifted."},
        {"zh": "丝松了一点", "en": "The thread loosened."},
        {"zh": "我掉了一截", "en": "I dropped a little."},
        {"zh": "别捏，会坏", "en": "Do not squeeze, it will break."},
        {"zh": "我还没长好", "en": "I am not finished forming."},
        {"zh": "这一下很危险", "en": "That was dangerous."},
        {"zh": "我的壳上多了个浅浅的坑。", "en": "A shallow dent has appeared in my shell."},
        {"zh": "再碰就撑不住", "en": "Another touch and I cannot hold."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "壳里不需要进食", "en": "A case needs no feeding."},
        {"zh": "我已经不饿了", "en": "I am not hungry anymore."},
        {"zh": "你举着叶子也没用", "en": "A leaf will not tempt me."},
        {"zh": "我在壳里", "en": "I am inside my case."},
        {"zh": "这东西留给毛虫", "en": "Leave that for the caterpillars."},
        {"zh": "我没有嘴能张开", "en": "I have no mouth to open."},
        {"zh": "放着吧", "en": "Leave it be."},
        {"zh": "我连嘴都还没长好", "en": "My mouth is not even formed."},
        {"zh": "有别的虫会来吃", "en": "Another insect will come for it."},
        {"zh": "你别管我", "en": "Leave me alone."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你一碰我就晃", "en": "Your touch sets me swinging."},
        {"zh": "丝还撑得住", "en": "The thread still holds."},
        {"zh": "我撞到叶子了", "en": "I bumped against the leaf."},
        {"zh": "我停不下来", "en": "I cannot stop swinging."},
        {"zh": "晃得我头晕", "en": "The swinging makes me dizzy."},
        {"zh": "别推叶子", "en": "Do not push the leaf."},
        {"zh": "我这一下摇得厉害", "en": "That was a hard swing."},
        {"zh": "叶子晃了，我还挂在原处。", "en": "The leaf swayed; I still hang where I was."},
        {"zh": "丝绕了一圈", "en": "The thread twisted once."},
        {"zh": "再晃我就要掉了", "en": "Swing me more and I drop."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我正忙着变形", "en": "I am busy transforming."},
        {"zh": "蛹不会做这种事", "en": "A chrysalis does not do such things."},
        {"zh": "等我羽化", "en": "Wait until I emerge."},
        {"zh": "两只蛹挂在一起", "en": "Two chrysalises hang side by side."},
        {"zh": "它们只会一起摇", "en": "All they do is sway together."},
        {"zh": "别碰这两根丝", "en": "Do not touch these threads."},
        {"zh": "这很安静", "en": "This is very quiet."},
        {"zh": "风会替我们说话", "en": "The wind will speak for us."},
        {"zh": "等蝴蝶回来", "en": "Wait for the butterflies."},
        {"zh": "就这样挂着", "en": "We just hang."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿不了东西", "en": "I cannot pick anything up."},
        {"zh": "我挂着不动", "en": "I hang and do not move."},
        {"zh": "掉在我旁边也捡不到", "en": "Things falling beside me stay there."},
        {"zh": "我连头都没法转过去。", "en": "I can't even turn my head."},
        {"zh": "让毛虫来捡", "en": "Let the caterpillars pick it up."},
        {"zh": "我没手", "en": "I have no hands."},
        {"zh": "它就挂在那儿", "en": "It just hangs there."},
        {"zh": "别放到我身上", "en": "Do not put it on me."},
        {"zh": "我会掉下去", "en": "I would fall."},
        {"zh": "我什么都做不了", "en": "There is nothing I can do."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在丝上，谁也伤不到。", "en": "I hang from my thread; I can't harm anyone."},
        {"zh": "我连动都难", "en": "I can barely move."},
        {"zh": "我只是个蛹", "en": "I am only a chrysalis."},
        {"zh": "你一碰我就掉地上", "en": "Touch me and I fall to the ground."},
        {"zh": "我等的是羽化，不是你", "en": "I am waiting to emerge, not for you."},
        {"zh": "别在下面站着", "en": "Do not stand under me."},
        {"zh": "我挂在这儿很显眼", "en": "I hang here in plain sight."},
        {"zh": "我只是想安静地待着", "en": "I only want quiet."},
        {"zh": "看可以，别碰", "en": "Look if you like, do not touch."},
        {"zh": "再过一阵我就变了", "en": "In a while I will be changed."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我还挂在这里", "en": "I am still hanging here."},
        {"zh": "你站在叶下，我吊得不安稳。", "en": "You stand under the leaf and I hang uneasy."},
        {"zh": "我的壳在变深", "en": "My case is darkening."},
        {"zh": "再挂一会就好", "en": "Just a little longer."},
        {"zh": "叶子替我挡着一半", "en": "The leaf hides half of me."},
        {"zh": "我听见你呼吸", "en": "I hear you breathing."},
        {"zh": "你没动手，很好", "en": "You have not reached out, good."},
        {"zh": "丝还是那个角度", "en": "The thread hangs at the same angle."},
        {"zh": "你呼吸太近，我怕丝会断。", "en": "Your breath is too close; I fear the thread will break."},
        {"zh": "丝还挂在原来的位置", "en": "The thread hangs where it did."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我什么也打不了", "en": "I cannot strike anything."},
        {"zh": "我只会摇", "en": "All I can do is sway."},
        {"zh": "壳很硬，碰着疼", "en": "My case is hard, it stings to touch."},
        {"zh": "你碰到的只是硬壳", "en": "You touched only a hard case."},
        {"zh": "我连嘴都动不了", "en": "I cannot even move my mouth."},
        {"zh": "我掉下去会砸到你", "en": "If I drop, I will hit you."},
        {"zh": "这是意外", "en": "That was an accident."},
        {"zh": "我把丝晃断了半截", "en": "I frayed half the thread."},
        {"zh": "这根丝还吊着我，走开吧。", "en": "This thread still holds me; go away."},
        {"zh": "我的壳撞你一下，是叶子在晃。", "en": "If my shell knocks you, it's only the leaf swaying."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在叶下结成了蛹", "en": "I became a chrysalis under a leaf."},
        {"zh": "毛虫把自己挂起来了", "en": "The caterpillar hung itself up."},
        {"zh": "丝是从我身上拉出来的", "en": "The thread came out of me."},
        {"zh": "我选了这个叶柄", "en": "I chose this leaf stem."},
        {"zh": "森林里适合变形", "en": "Good place in this forest to change."},
        {"zh": "我开始变硬了", "en": "I am starting to harden."},
        {"zh": "我挂在叶背", "en": "I hang on the leaf underside."},
        {"zh": "外面世界离我很远", "en": "The outside world feels far."},
        {"zh": "我又晃了一下", "en": "I swayed once."},
        {"zh": "这是我最后的静止", "en": "This is my last stillness."}
      ]
    },
