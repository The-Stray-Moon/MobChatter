{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "绿壳藏在绿叶间。", "en": "My green casing hides among green leaves."},
        {"zh": "我不走，随风轻摆。", "en": "No walking. A gentle sway."},
        {"zh": "叶柄托着我摇。", "en": "The stem rocks me."},
        {"zh": "风一过我就转。", "en": "Every gust turns me."},
        {"zh": "丝线绷得笔直。", "en": "The silk pulls straight."},
        {"zh": "丛林里绿得发暗。", "en": "The jungle green goes nearly black."},
        {"zh": "我贴着叶脉垂着。", "en": "I hang along the vein."},
        {"zh": "雨把绿洗得更亮。", "en": "Rain sharpens the green."},
        {"zh": "我摆到有光的地方。", "en": "I sway toward the light."},
        {"zh": "叶边擦过我的壳。", "en": "The leaf edge grazes me."},
        {"zh": "一层膜在轻轻动。", "en": "A thin membrane quivers."},
        {"zh": "我慢慢挪了一线。", "en": "I shifted a hair's width."},
        {"zh": "藤蔓的影子扫过。", "en": "A vine's shadow passes over."},
        {"zh": "绿壳离地很高，风也够轻。", "en": "The green shell hangs high, and the wind is gentle."},
        {"zh": "我不需要落下去。", "en": "I don't need to come down."},
        {"zh": "绿在叶子之间消失。", "en": "The green vanishes among leaves."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "绿色是我的伪装。", "en": "Green is my disguise."},
        {"zh": "壳里在重新排队。", "en": "Inside, everything's rearranging."},
        {"zh": "我听见雨在林里。", "en": "I hear rain in the forest."},
        {"zh": "叶面反着湿光。", "en": "The leaf reflects wet light."},
        {"zh": "绿壳上落了又一层湿气。", "en": "Another layer of damp settles on the green shell."},
        {"zh": "一层薄壳护着我。", "en": "A thin casing protects me."},
        {"zh": "里面的翅卷着。", "en": "The wings are folded inside."},
        {"zh": "露珠从尖上滴下。", "en": "Dew drips off the tip."},
        {"zh": "我不用吃也不用喝。", "en": "I need no food or drink."},
        {"zh": "绿壳慢慢变深。", "en": "The green is growing deeper."},
        {"zh": "风停的间隙很静。", "en": "The pause between gusts is quiet."},
        {"zh": "时候快到了。", "en": "The time is nearly here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我绿得和叶子一样，你看见了吗。", "en": "I am green as the leaf; do you see me?"},
        {"zh": "绿色的东西很多。", "en": "There's a lot of green here."},
        {"zh": "绿色堆里，你偏挑中了我。", "en": "In all this green, you picked me out."},
        {"zh": "可别用手来抓。", "en": "Don't grab with your hands."},
        {"zh": "这层壳还软。", "en": "This casing is still soft."},
        {"zh": "你在看叶子还是看我？", "en": "The leaf, or me?"},
        {"zh": "我离地面很远。", "en": "I'm far above the ground."},
        {"zh": "你的影子没有遮到我。", "en": "Your shadow missed me."},
        {"zh": "我什么也不会说。", "en": "I won't say a word."},
        {"zh": "还得再过几天。", "en": "A few more days yet."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "绿壳裂开一点。", "en": "The green cracked a little."},
        {"zh": "我被打得直转。", "en": "The blow spun me round."},
        {"zh": "丝绷得发响。", "en": "The silk sang."},
        {"zh": "壳内一阵乱。", "en": "Chaos inside the casing."},
        {"zh": "一层膜破了。", "en": "A membrane tore."},
        {"zh": "我晃得吊不住。", "en": "I can hardly hang on."},
        {"zh": "绿上有一道白。", "en": "A white line on the green."},
        {"zh": "绿色外壳裂了，里面还在动。", "en": "My green casing is split; something inside still moves."},
        {"zh": "别碰裂的地方。", "en": "Don't touch where it split."},
        {"zh": "我能撑到最后。", "en": "I can last until the end."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "绿壳里在自给自足。", "en": "The green shell feeds itself."},
        {"zh": "羽化前不必进食。", "en": "No meals before emergence."},
        {"zh": "绿色不需要补。", "en": "Green needs no topping up."},
        {"zh": "绿色的我不吃东西，你拿着。", "en": "I, the green one, don't eat; keep it."},
        {"zh": "我连张嘴都不行。", "en": "I can't even open up."},
        {"zh": "那片嫩叶不是我的。", "en": "That tender leaf isn't mine."},
        {"zh": "放着，会有人吃。", "en": "Leave it. Someone will eat it."},
        {"zh": "我闻不到这味道。", "en": "I can't smell that."},
        {"zh": "我只想安静。", "en": "I only want quiet."},
        {"zh": "别摇这根枝子。", "en": "Don't shake this branch."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "绿壳被碰得转了。", "en": "The green casing spun from the touch."},
        {"zh": "叶子撞到我了。", "en": "A leaf bumped me."},
        {"zh": "丝线还牢牢挂着。", "en": "The silk still holds."},
        {"zh": "我摆了好几下。", "en": "I swung several times."},
        {"zh": "别用帽子碰我。", "en": "Don't touch me with your hat."},
        {"zh": "叶子晃得太厉害，别碰。", "en": "The leaf sways too much; do not touch."},
        {"zh": "绿壳上有了划痕。", "en": "A scratch on my green."},
        {"zh": "我晃得有点晕。", "en": "The swaying made me dizzy."},
        {"zh": "你的头顶到我。", "en": "Your head reached me."},
        {"zh": "你退开就好了。", "en": "Just step back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一枚绿壳。", "en": "I'm only a green casing."},
        {"zh": "我的翅膀还没张开。", "en": "My wings aren't open yet."},
        {"zh": "等绿壳裂开。", "en": "When the green splits."},
        {"zh": "那时再说吧。", "en": "Talk then."},
        {"zh": "我是绿色的蛹，还没张开。", "en": "I'm a green pupa, not yet opened."},
        {"zh": "你等不到也没关系。", "en": "It's fine if you can't wait."},
        {"zh": "安静地守着就好。", "en": "Quiet guarding is enough."},
        {"zh": "这层壳隔开一切。", "en": "This shell shuts everything out."},
        {"zh": "时间会给我形状。", "en": "Time will give me shape."},
        {"zh": "走了也没关系。", "en": "It's fine if you go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "它离我有半尺。", "en": "It's half a foot away."},
        {"zh": "它在我下面的叶上。", "en": "It's on the leaf below."},
        {"zh": "丝线是我的全部。", "en": "The silk is all I have."},
        {"zh": "它被雨粘住了。", "en": "The rain stuck it down."},
        {"zh": "别把它推下去。", "en": "Don't push it off."},
        {"zh": "绿色的我分不清。", "en": "The green me can't tell it apart."},
        {"zh": "这是叶子的东西。", "en": "That belongs to the leaf."},
        {"zh": "它会自己掉。", "en": "It'll fall by itself."},
        {"zh": "我眼睛看见了它。", "en": "My eyes found it."},
        {"zh": "让它留在原地。", "en": "Leave it where it lies."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子被拨开了。", "en": "The leaves got parted."},
        {"zh": "有影子在下面。", "en": "A shadow below."},
        {"zh": "绿壳一下绷紧。", "en": "My green casing snapped tight."},
        {"zh": "这不是雨水的声音。", "en": "That's not rain."},
        {"zh": "有东西在爬树。", "en": "Something's climbing the tree."},
        {"zh": "我离地面太高。", "en": "I'm too high up."},
        {"zh": "我应该别乱动。", "en": "I shouldn't move."},
        {"zh": "叶下那双眼睛正对着绿壳。", "en": "Those eyes beneath the leaf are fixed on my green shell."},
        {"zh": "绿色的我很难找。", "en": "The green me is hard to find."},
        {"zh": "我咬着丝不放。", "en": "I cling to the silk."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴在叶子背光面。", "en": "I press to the leaf's dark side."},
        {"zh": "它还在树下。", "en": "It's still under the tree."},
        {"zh": "绿壳和叶子一样。", "en": "Green casing, green leaf."},
        {"zh": "我连风都不敢动。", "en": "I don't even stir in the wind."},
        {"zh": "它慢慢往上爬。", "en": "It's climbing slowly."},
        {"zh": "枝叶挡在前面。", "en": "The brush shields me."},
        {"zh": "绿壳贴着叶背，它擦过去了。", "en": "The green shell flat to the leaf, it passes by."},
        {"zh": "它转去别的枝了。", "en": "It turned to another branch."},
        {"zh": "等它走进叶影。", "en": "Wait till it enters leaf shade."},
        {"zh": "绿色把我藏住了。", "en": "Green has hidden me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "绿壳撞了它一下。", "en": "My green casing bumped it."},
        {"zh": "我没有牙齿。", "en": "I have no teeth."},
        {"zh": "我只能轻轻摆动。", "en": "All I can do is sway."},
        {"zh": "绿壳一碎，里面就全完了。", "en": "Crack the green shell and everything inside ends."},
        {"zh": "绿壳撞过去，像叶子拍了一下。", "en": "The green shell knocks at you like a leaf slapping."},
        {"zh": "我连翅膀都没长出。", "en": "I haven't even grown wings."},
        {"zh": "壳边有点硬。", "en": "My casing edge is a little hard."},
        {"zh": "我乱摆一气。", "en": "I flail about."},
        {"zh": "壳一破我就完了。", "en": "If the shell breaks, I'm done."},
        {"zh": "这已经是全部。", "en": "That's all I have."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "绿叶间多了一个绿壳。", "en": "A green casing among green leaves."},
        {"zh": "毛虫选了一片好叶。", "en": "The caterpillar picked a good leaf."},
        {"zh": "丝缠在叶脉上。", "en": "Silk tied to the vein."},
        {"zh": "我在丛林的高处。", "en": "I'm high in the jungle."},
        {"zh": "这层壳刚刚成形。", "en": "The casing just formed."},
        {"zh": "雨林的味道很浓。", "en": "The rainforest smells strong."},
        {"zh": "几乎看不见我。", "en": "I'm nearly invisible."},
        {"zh": "我挂得稳稳的。", "en": "I hang securely."},
        {"zh": "时间慢慢流。", "en": "Time flows on."},
        {"zh": "又是一个新的我。", "en": "A new me again."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "绿色被烤得卷曲。", "en": "The green curls in the heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落进了湿叶堆。", "en": "I landed in wet leaves."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "雨水灌进我的壳。", "en": "Rain filled my casing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "整根枝条弹了一下。", "en": "The whole branch snapped."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "尖东西扎透了一层。", "en": "Something pierced through."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "绿色的壳发出微光。", "en": "The green casing glows faintly."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "蓄的养分快用尽。", "en": "My stores are nearly used up."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光在叶间乱跳。", "en": "The flash jumped between leaves."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我从枝条上掉下去。", "en": "I dropped from the branch."}
      ]
    }
  }
}
