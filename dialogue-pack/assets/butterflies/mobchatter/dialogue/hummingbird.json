{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀快得像蜂鸟", "en": "My wings beat like a hummingbird's."},
        {"zh": "我悬在花前不动", "en": "I hover motionless before a flower."},
        {"zh": "平原上我飞得最快", "en": "I'm the fastest flier on the plains."},
        {"zh": "铃兰的味道在前头", "en": "Lily of the valley ahead."},
        {"zh": "我一路飞，一路吃花", "en": "I fly and eat flowers as I go."},
        {"zh": "翅膀的嗡嗡声很细", "en": "A thin hum comes from my wings."},
        {"zh": "我不落，我悬着", "en": "I don't land; I hover."},
        {"zh": "白天才看得到我", "en": "You only see me by day."},
        {"zh": "毛茸茸的身子，飞得却快", "en": "Furry body, but quick in the air."},
        {"zh": "我从一朵花到另一朵", "en": "From one flower to the next."},
        {"zh": "花瓣被我啃掉一口", "en": "I've bitten a petal away."},
        {"zh": "我的影子在草上晃", "en": "My shadow flickers on the grass."},
        {"zh": "翅膀扇得看不清", "en": "My wings blur with speed."},
        {"zh": "这一小片花，我包了", "en": "This patch of flowers is mine."},
        {"zh": "空中停一下，再冲出去", "en": "Hover, then dart away."},
        {"zh": "我飞得很低，贴着花", "en": "I fly low, close to the blooms."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "悬在半空，翅膀不停", "en": "Hovering in midair, wings never still."},
        {"zh": "我只活很短一阵", "en": "I live only a short while."},
        {"zh": "花蜜比什么都重要", "en": "Nectar matters more than anything."},
        {"zh": "我的寿命，按天算", "en": "My life is counted in days."},
        {"zh": "悬停很费力，但我习惯", "en": "Hovering is hard work, but I'm used to it."},
        {"zh": "平原的风把我的味道吹散", "en": "The plains wind scatters my scent."},
        {"zh": "我歪着身子停在花前", "en": "I tilt before the flower."},
        {"zh": "翅膀在太阳下透亮", "en": "My wings go translucent in the sun."},
        {"zh": "我看花的眼睛很准", "en": "I spot flowers precisely."},
        {"zh": "这一朵，已经被我吃过了", "en": "This one I've already eaten."},
        {"zh": "我不用停，也能想事", "en": "I can think while hovering."},
        {"zh": "风一小，我就得躲", "en": "A little wind and I must hide."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡住我的花了", "en": "You're blocking my flower."},
        {"zh": "我不会停在你手上", "en": "I won't rest on your hand."},
        {"zh": "你看得清我的翅膀吗", "en": "Can you see my wings?"},
        {"zh": "网子举起来了，我看到了", "en": "A net is up; I see it."},
        {"zh": "我的速度，你追不上", "en": "You can't catch my speed."},
        {"zh": "别拍，我这么小", "en": "Don't swat; I'm tiny."},
        {"zh": "你身上没有花味", "en": "You carry no flower scent."},
        {"zh": "你眨眼我就换位置", "en": "I move when you blink."},
        {"zh": "这一片花，先让我吃", "en": "Let me eat this patch first."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀歪了，我掉了一截", "en": "My wing bent; I dropped a bit."},
        {"zh": "我的鳞粉掉了一把", "en": "I lost a handful of scales."},
        {"zh": "这么小也会疼", "en": "Even something this small feels pain."},
        {"zh": "我悬不稳了身体", "en": "I can't hover steadily."},
        {"zh": "我绕了一圈才稳住", "en": "I circled once to steady myself."},
        {"zh": "寿命又短了一截", "en": "My already short life got shorter."},
        {"zh": "我掉到草上，又飞起来", "en": "I dropped to the grass and rose again."},
        {"zh": "别打我的翅膀", "en": "Not the wings."},
        {"zh": "我的悬停乱了，花蜜洒了。", "en": "My hover wavers and the nectar spills."},
        {"zh": "这点伤，对我很重", "en": "This wound is heavy for me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "铃兰？那是我最爱的", "en": "Lily of the valley? My favorite."},
        {"zh": "举着花，我就过来了", "en": "Hold out a flower and I'll come."},
        {"zh": "这味道我认得", "en": "I know this scent."},
        {"zh": "你的手不要动", "en": "Keep your hand still."},
        {"zh": "我会悬在你手心上", "en": "I'll hover over your palm."},
        {"zh": "一朵不够，我还能吃", "en": "One isn't enough."},
        {"zh": "先让我尝一口", "en": "Let me taste one first."},
        {"zh": "我不想被抓住，只想吃", "en": "I don't want to be caught, only fed."},
        {"zh": "这朵花会被我吃光", "en": "This flower will vanish entirely."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞在你鼻尖上", "en": "I bumped your nose."},
        {"zh": "我太小了，你几乎没感觉", "en": "I'm so small you barely felt it."},
        {"zh": "气流把我推开", "en": "The air pushed me aside."},
        {"zh": "我翅膀被撞乱了", "en": "My wings got knocked out of rhythm."},
        {"zh": "飞低一点就撞到东西", "en": "Flying low means hitting things."},
        {"zh": "你一动，我就偏了", "en": "You moved; I drifted."},
        {"zh": "我撞在你袖子上，掉了几片鳞粉", "en": "I hit your sleeve and lost some scales."},
        {"zh": "这点碰撞，我马上调整", "en": "I correct after any bump."},
        {"zh": "别挥手，会撞到", "en": "Don't wave; you'll hit me."},
        {"zh": "我绕开你飞过去", "en": "I'll fly around you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这一生很短", "en": "My life is very short."},
        {"zh": "花开的时候，就该这样", "en": "When flowers bloom, this happens."},
        {"zh": "我的翅膀颜色够显眼", "en": "My wing colors are bright enough."},
        {"zh": "一起把这片花吃完", "en": "Let's eat this patch together."},
        {"zh": "只剩几天，别浪费", "en": "Only days left; don't waste them."},
        {"zh": "我在花前等你", "en": "I'll wait by the flower."},
        {"zh": "我们会有下一代毛虫", "en": "We'll have caterpillars next."},
        {"zh": "绕着你飞一圈也行", "en": "A circle around you counts."},
        {"zh": "不吵，翅膀会说话", "en": "No need to talk; wings say it."},
        {"zh": "飞吧，天黑就没了", "en": "Fly; we're gone by dark."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "花上有一滴蜜", "en": "A drop of nectar on the flower."},
        {"zh": "我用长喙吸它", "en": "I draw it with my long proboscis."},
        {"zh": "这片花瓣，我带走", "en": "I'll take this petal."},
        {"zh": "太小了，你还看得见吗", "en": "So small—can you still see it?"},
        {"zh": "我捡的是花，不是别的", "en": "I'm picking flowers, nothing else."},
        {"zh": "一碰就掉，我小心着", "en": "It falls at a touch; I'm careful."},
        {"zh": "悬停着捡东西很费劲", "en": "Picking things up while hovering is hard."},
        {"zh": "花蜜就在这朵里", "en": "The nectar is inside this one."},
        {"zh": "这一口，够我飞一会", "en": "This sip lasts a short flight."},
        {"zh": "我不用手，用喙", "en": "I don't use hands; I use my proboscis."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞你一下，很疼的", "en": "My bump hurts, you know."},
        {"zh": "我飞得快，你抓不住", "en": "I'm fast; you can't catch me."},
        {"zh": "蜂鸟一样的冲刺", "en": "A hummingbird's dash."},
        {"zh": "我的喙很细，但很硬", "en": "My proboscis is thin but hard."},
        {"zh": "我绕着你飞，你眼会花", "en": "I'll circle you till your eyes blur."},
        {"zh": "这一片花，归我", "en": "This patch is mine."},
        {"zh": "你不让开，我就撞", "en": "Move, or I'll ram."},
        {"zh": "翅膀的声音变大了", "en": "My wing hum got louder."},
        {"zh": "我盯着你的脸", "en": "I'm aiming at your face."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在你面前", "en": "I hover before you."},
        {"zh": "你一动，我就换方向", "en": "Move and I change direction."},
        {"zh": "我飞得比你的手快", "en": "I'm faster than your hands."},
        {"zh": "翅膀扇出的风很小", "en": "My wing wind is tiny."},
        {"zh": "你的网网不到我", "en": "Your net can't catch me."},
        {"zh": "这一朵花，我不让", "en": "I won't give up this flower."},
        {"zh": "你退开，我就继续吃", "en": "Step back and I'll keep feeding."},
        {"zh": "我一直在你视线边缘", "en": "I stay at the edge of your sight."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀扫在你脸上", "en": "My wings brush your face."},
        {"zh": "用一个很小的冲撞", "en": "A very small charge."},
        {"zh": "我蜇不了，但我撞得准", "en": "I can't sting, but I hit precisely."},
        {"zh": "这一下不重，就是烦", "en": "Not heavy, just annoying."},
        {"zh": "我绕一圈再撞", "en": "A loop, then a hit."},
        {"zh": "鳞粉撒到你眼睛里", "en": "Scale dust in your eyes."},
        {"zh": "你挥手，我躲开", "en": "You wave; I dodge."},
        {"zh": "我已经飞走了", "en": "And I'm gone."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀先响起来", "en": "The wings start humming first."},
        {"zh": "平原的花上多了一只", "en": "One more on the plains flowers."},
        {"zh": "我一出生就开始飞", "en": "I fly from the moment I'm born."},
        {"zh": "这一片铃兰正开", "en": "The lilies of the valley are open."},
        {"zh": "太阳正好，我出来了", "en": "Good sun; I'm out."},
        {"zh": "我的寿命开始倒数", "en": "My life starts counting down."},
        {"zh": "悬在半空，我到了", "en": "Hovering, I've arrived."},
        {"zh": "花的味道引我来的", "en": "The flowers drew me here."},
        {"zh": "翅膀还带着蛹里的湿气", "en": "My wings still damp from the cocoon."},
        {"zh": "快看，蜂鸟一样的东西", "en": "Look, something like a hummingbird."}
      ]
    },
