  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "沙沙作响", "en": "Scratch scratch"},
        {"zh": "根须蠕动", "en": "Roots squirm"},
        {"zh": "紧抓地面", "en": "Claw at soil"},
        {"zh": "我替本体走这一趟。", "en": "I take this walk for the original."},
        {"zh": "藤蔓滑行", "en": "Vines glide"},
        {"zh": "根须触碰", "en": "Root touch"},
        {"zh": "阴影游走", "en": "Shadow wanders"},
        {"zh": "缠绕前行", "en": "Wrap and move"},
        {"zh": "紧贴地面", "en": "Cling to earth"},
        {"zh": "慢慢拉近", "en": "Creep closer"},
        {"zh": "根须拖拽着身体前进", "en": "Roots drag my body forward."},
        {"zh": "从土里拔起一步又插回去", "en": "I lift a step from the soil and plant it again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "安静不动", "en": "Steady still"},
        {"zh": "根须松弛", "en": "Loose roots"},
        {"zh": "我替本体站着，替他挨打。", "en": "I stand for the original and take his blows."},
        {"zh": "根系在土里，慢慢换气。", "en": "Roots in the soil, breathing slowly."},
        {"zh": "根须从土里探出，绕上脚踝。", "en": "Roots rise from the soil and coil around ankles."},
        {"zh": "我替本体站在这儿，根扎深。", "en": "I stand here for the original, roots deep."},
        {"zh": "我没有肺，却学本体呼吸。", "en": "I have no lungs, yet I mimic my original's breath."},
        {"zh": "根须舒展", "en": "Roots relax"},
        {"zh": "我是分身，替本体挨这一下。", "en": "I'm the clone; I take this blow for the body."},
        {"zh": "不动如石", "en": "Stone still"},
        {"zh": "根须在土里悄悄换气", "en": "My roots breathe quietly in the soil."},
        {"zh": "替身静候本体的召唤", "en": "The stand-in waits for its master's call."},
        {"zh": "腐土之下，静听心跳", "en": "Beneath the rot, I listen for a heartbeat."},
        {"zh": "根须盘紧，又慢慢松开", "en": "My roots coil tight, then slowly slacken."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "根须缠紧，我只等你一步。", "en": "My roots tighten; I wait for one step."},
        {"zh": "追踪身影", "en": "Track form"},
        {"zh": "本体的眼睛，透过我看你。", "en": "My original's eyes look at you through me."},
        {"zh": "我替本体看着你，别动。", "en": "I watch you for my original; stay still."},
        {"zh": "视线飘忽", "en": "Gaze shifts"},
        {"zh": "凝视双眼", "en": "Stare deep"},
        {"zh": "我不眨眼，本体也不眨。", "en": "I don't blink, and neither does my original."},
        {"zh": "眼神闪烁", "en": "Gleam glance"},
        {"zh": "盯紧不放", "en": "Stare intently"},
        {"zh": "凝视敌踪", "en": "Enemy sight"},
        {"zh": "根须末端转向了你", "en": "The tips of my roots turn toward you."},
        {"zh": "我在土里看着你的脚", "en": "I watch your feet from under the soil."},
        {"zh": "你踩到了我的根须", "en": "You stepped on one of my roots."},
        {"zh": "我每一根须都在看你", "en": "Every root of mine is watching you."},
        {"zh": "分身之眼只盯着你", "en": "A clone's eye fixes only on you."},
        {"zh": "隔着泥土，我数你的步子", "en": "Through the dirt, I count your steps."},
        {"zh": "你身后土面微微隆起", "en": "The soil behind you swells a little."},
        {"zh": "根须记住了你的气味", "en": "My roots have learned your scent."},
        {"zh": "别回头，我在你脚下", "en": "Don't look back. I'm beneath your feet."},
        {"zh": "我用借来的眼睛锁住你", "en": "I lock onto you with a borrowed eye."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "根藤缠绕着我！", "en": "Roots wrap around me!"},
        {"zh": "我触到了石块！", "en": "I touched stone!"},
        {"zh": "我的根被切断了！", "en": "My roots are cut!"},
        {"zh": "土中有什么在抓我！", "en": "Something is pulling me!"},
        {"zh": "我被泥土吞噬了！", "en": "I'm being devoured by earth!"},
        {"zh": "根从四面八方挤压我！", "en": "Roots squeeze from all sides!"},
        {"zh": "我陷入了泥潭！", "en": "I'm stuck in mud!"},
        {"zh": "我的根被拔起了！", "en": "My roots are uprooted!"},
        {"zh": "土里有什么在动！", "en": "The earth is moving!"},
        {"zh": "我的根被扭曲了！", "en": "My roots are twisted!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "根须紧握，你为何动摇？", "en": "Roots clutch tight, why sway now?"},
        {"zh": "抓我，抓到的只是根。", "en": "Strike me, and you hit only roots."},
        {"zh": "别靠近我，这是我的领地。", "en": "Stay back, this is my ground."},
        {"zh": "吸取你的生命能量。", "en": "Suck on life force."},
        {"zh": "我的触手想要环抱你。", "en": "My tendrils crave you."},
        {"zh": "根须缠绕，无法逃脱。", "en": "Tendrils entangle, no escape."},
        {"zh": "与我共享这片土地。", "en": "Share this earth with me."},
        {"zh": "用你的力量强化我。", "en": "Strengthen me with your might."},
        {"zh": "这是属于扎根之物的礼物。", "en": "This is a rooted clone's gift."},
        {"zh": "被我根系束缚。", "en": "Bound by my roots."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "岩石撞上我的触手。", "en": "Rock meets my tendril."},
        {"zh": "避过这致命的碰撞。", "en": "Avoid fatal collision."},
        {"zh": "我的根茎阻挡了你的路。", "en": "My roots block your path."},
        {"zh": "根茎断裂，你逃过一劫。", "en": "Tendrils break, you survive."},
        {"zh": "触手碰撞，痛苦蔓延。", "en": "Tendrils collide, pain spreads."},
        {"zh": "岩石与我的根系相撞。", "en": "Rock collides with roots."},
        {"zh": "岩石未能击中核心。", "en": "Rock fails to hit core."},
        {"zh": "岩石与我的身体相撞。", "en": "Rock collides with body."},
        {"zh": "根须缠绕，岩石无处藏身。", "en": "Tendrils entangle, rock nowhere to hide."},
        {"zh": "岩石撞得我痛入骨髓。", "en": "Rock hits hard, pain deep."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找我的伴侣，扎根更深。", "en": "Find my mate, root deeper."},
        {"zh": "与我共生，繁衍生息。", "en": "Coexist, reproduce."},
        {"zh": "我的根系需要你的协助。", "en": "My roots need your help."},
        {"zh": "一起扎根，共享生命。", "en": "Root together, share life."},
        {"zh": "根系中寻求交配。", "en": "Mate in roots."},
        {"zh": "与我一起，扎根大地。", "en": "Mate with me, root deep."},
        {"zh": "根系相接，共度一生。", "en": "Roots connect, share forever."},
        {"zh": "扎根之物的繁殖方式。", "en": "Rooted clone's reproduction."},
        {"zh": "根系中寻找新的生命。", "en": "Seek life in roots."},
        {"zh": "根系与根系相互依存。", "en": "Roots depend on roots."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我根须缠绕，触感冰凉。", "en": "My roots缠绕, icy touch."},
        {"zh": "腐烂的气息，来自深处。", "en": "Rotting scent, from the depths."},
        {"zh": "根须之下，黑暗诱惑。", "en": "Dark诱惑 beneath the roots."},
        {"zh": "腐土中汲取生命力。", "en": "Siphon life from decayed earth."},
        {"zh": "腐烂之地，我之家园。", "en": "Home in the rotten land."},
        {"zh": "触碰我，必遭腐蚀。", "en": "Touch me, and be corroded."},
        {"zh": "我的存在，即死亡。", "en": "My being is death."},
        {"zh": "根须延伸，无处不在。", "en": "Roots spread, everywhere."},
        {"zh": "腐朽之灵，紧随其后。", "en": "Rot's spirit, ever behind."},
        {"zh": "腐根之下，真相浮现。", "en": "Truth revealed, under rotting roots."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "腐土中的猎物，靠近了。", "en": "Prey in the decay, approaching."},
        {"zh": "触感金属，猎物近。", "en": "Metal触感, prey near."},
        {"zh": "根尖掠食，感知动静。", "en": "Root tip hunts, senses motion."},
        {"zh": "土壤之下，猎物显露。", "en": "Prey revealed, beneath soil."},
        {"zh": "根须伸展，包围猎物。", "en": "Roots extend, surround prey."},
        {"zh": "腐朽之下的阴影。", "en": "Shadow beneath the decay."},
        {"zh": "我之根须，感知一切。", "en": "My roots sense all."},
        {"zh": "土壤深处，猎物的气息。", "en": "Prey scent, deep in soil."},
        {"zh": "腐朽之地，感知猎物。", "en": "Decay senses prey."},
        {"zh": "根须之下，暗中窥视。", "en": "Roots watch, unseen."},
        {"zh": "猎物踏进了我的根域", "en": "The prey walked into my root domain."},
        {"zh": "本体传令，缠住这个", "en": "My master orders: bind this one."},
        {"zh": "根须绷紧，准备换位", "en": "My roots tighten, ready to swap places."},
        {"zh": "把命交给分身吧", "en": "Leave your life to the stand-in."},
        {"zh": "先缠住脚，再缠住喉咙", "en": "First the ankles, then the throat."},
        {"zh": "你的重量压醒了我", "en": "Your weight woke me from the soil."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准猎物，腐蚀开始。", "en": "Targeted, corrosion begins."},
        {"zh": "根须缠绕，汲取生命。", "en": "Roots缠绕, life drained."},
        {"zh": "腐蚀之触，深入骨髓。", "en": "Corrosion's touch, deep within."},
        {"zh": "根须之下，恐惧蔓延。", "en": "Fear spreads, under roots."},
        {"zh": "我的触感，带来死亡。", "en": "My touch, death comes."},
        {"zh": "根须缠绕，无法逃脱", "en": "Roots bind, no escape"},
        {"zh": "触感之下，死亡等待。", "en": "Death waits, below touch."},
        {"zh": "根须之下，绝望之境。", "en": "Despair under roots."},
        {"zh": "腐朽之灵，紧随其后", "en": "Rot's spirit, ever behind"},
        {"zh": "根须之下，永恒黑暗。", "en": "Eternal darkness, under roots."},
        {"zh": "根须一圈一圈收紧", "en": "My roots draw in, ring by ring."},
        {"zh": "从脚踝开始腐烂", "en": "It rots upward from your ankles."},
        {"zh": "我拽住了你的影子", "en": "I tug at your shadow."},
        {"zh": "藤蔓在你颈后打个结", "en": "A vine knots behind your neck."},
        {"zh": "慢慢勒，不着急", "en": "I tighten slowly. No hurry."},
        {"zh": "根尖找到了你的脉搏", "en": "A root tip finds your pulse."},
        {"zh": "你脚下的土变软了", "en": "The ground under you turns soft."},
        {"zh": "腐根缠住了你的膝盖", "en": "Rotten roots wrap your knees."},
        {"zh": "我在等本体换位过来", "en": "I wait for my master to trade places."},
        {"zh": "根须从四面围成一口井", "en": "Roots close around you like a well."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，我替它受伤！", "en": "Sssss, I take its damage!"},
        {"zh": "等它来攻击，我会保护它！", "en": "I'll take the hit for it."},
        {"zh": "你攻击我，它安全！", "en": "Hit me, not it."},
        {"zh": "我的皮厚，打我别打它！", "en": "I'm tough, hit me!"},
        {"zh": "别伤它，我挡着呢！", "en": "Don't hurt it, I'm here!"},
        {"zh": "嘶，让它平安无事！", "en": "Sss, let it be."},
        {"zh": "你打我吧，它没事！", "en": "Hit me, not it."},
        {"zh": "我是它的盾牌，保护它！", "en": "I'm its shield, protect it!"},
        {"zh": "嘶嘶，保护它的任务！", "en": "Sss, protect it!"},
        {"zh": "你来打我，它安心！", "en": "Hit me, not it."},
        {"zh": "根须抽出，扫在你脸上", "en": "A root whips out across your face."},
        {"zh": "替身也是会咬人的", "en": "Even a stand-in can bite."},
        {"zh": "藤蔓收紧，骨头作响", "en": "Vines tighten till bones creak."},
        {"zh": "这一下算在本体账上", "en": "Put this hit on my master's account."},
        {"zh": "根尖扎进你的伤口", "en": "Root tips dig into your wound."},
        {"zh": "别躲，我缠得很牢", "en": "Don't dodge. My grip is sure."}
      ]
