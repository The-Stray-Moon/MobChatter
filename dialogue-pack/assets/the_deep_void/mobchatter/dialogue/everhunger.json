      "lines": [
        {"zh": "饥饿的蠕动", "en": "Ghastly crawl"},
        {"zh": "低语回响", "en": "Echo whispers"},
        {"zh": "灵魂的哀号", "en": "Soulful moan"},
        {"zh": "古肉的召唤", "en": "Carcass call"},
        {"zh": "永恒的饥饿", "en": "Eternal hunger"},
        {"zh": "灵魂的饥饿", "en": "Soul's hunger"},
        {"zh": "我拖着干瘪的腿挪了一步。", "en": "I drag one withered leg forward."},
        {"zh": "不朽的饥饿", "en": "Unending hunger"},
        {"zh": "永恒的追击", "en": "Eternal chase"},
