    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "古肉的味道，近了。", "en": "The smell of old flesh is close."},
        {"zh": "你一站起来，我就永远锁定你了。", "en": "The moment you stand, I lock onto you forever."},
        {"zh": "它逃不掉。", "en": "It will not escape."},
        {"zh": "永无止境的追逐。", "en": "Endless pursuit."},
        {"zh": "品尝我的耐心。", "en": "Taste my patience."},
        {"zh": "你逃不出去。", "en": "You cannot escape."},
        {"zh": "我的目标，我的猎物。", "en": "My target, my prey."},
        {"zh": "我动起来，地面都在震动。", "en": "When I move, the ground shakes."},
        {"zh": "我的猎物，我的胜利。", "en": "My prey, my victory."},
        {"zh": "视线咬住你了。", "en": "My gaze has bitten into you."},
        {"zh": "古肉的味道，就在前头。", "en": "The smell of ancient meat, just ahead."},
        {"zh": "我一步也不会停。", "en": "I will not stop for a single step."},
        {"zh": "死地的猎人醒了。", "en": "The hunter of the dead lands is awake."},
        {"zh": "你越跑，我越近。", "en": "The more you run, the closer I get."},
        {"zh": "这具空壳只想要肉。", "en": "This hollow body wants only meat."},
        {"zh": "守望者认准一个方向。", "en": "The warden picks one direction."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一醒，就再也不会停下。", "en": "Once awake, I never stop again."},
        {"zh": "永不停步地追你。", "en": "I chase you without pause."},
        {"zh": "盯上了，就不放。", "en": "Once I fix on you, I never let go."},
        {"zh": "我等得够久了。", "en": "I have waited long enough."},
        {"zh": "我的路只有一条，冲你去。", "en": "I have one path, and it leads to you."},
        {"zh": "前头有活物在喘气。", "en": "Something ahead is breathing."},
        {"zh": "别试我的耐心，它没底。", "en": "Do not test my patience. It has no bottom."},
        {"zh": "你是我认下的肉。", "en": "You are the meat I have claimed."},
        {"zh": "我的爪子已经抬到半空。", "en": "My claw is already raised mid-air."},
        {"zh": "我的胜利，我的猎物。", "en": "My victory, my prey."},
        {"zh": "你身上全是古肉的味道。", "en": "You reek of ancient meat."},
        {"zh": "我听见你的心跳在响。", "en": "I hear your heart beating."},
        {"zh": "跑吧，我从不休息。", "en": "Run. I never rest."},
        {"zh": "我的胃在叫。", "en": "My stomach is growling."},
        {"zh": "视线锁死了你的脊背。", "en": "My gaze is fixed on your spine."},
        {"zh": "这具躯体不会累。", "en": "This body does not tire."},
        {"zh": "你的汗味越来越浓。", "en": "Your sweat grows stronger."},
        {"zh": "饥饿从不讲道理。", "en": "Hunger has no reason."},
        {"zh": "我早就闻到你了。", "en": "I smelled you long ago."},
        {"zh": "别回头，我在后头。", "en": "Don't look back. I am behind you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "你不蹲下，我就醒了。", "en": "You did not crouch, so I woke."},
        {"zh": "你蹲下来了，我闻得到。", "en": "You crouched. I can smell you."},
        {"zh": "永远的饥饿，永无止境！", "en": "Endless hunger, never ending!"},
        {"zh": "你是我的，永远不会！", "en": "Yours, forever not!"},
        {"zh": "饥饿之魂，永恒追逐！", "en": "Hunger soul, eternal chase!"},
        {"zh": "古肉的香气从你身上冒出来。", "en": "The scent of ancient meat rises off you."},
        {"zh": "你触碰到我的领域！", "en": "You touched my domain!"},
        {"zh": "死亡之地，我的家园！", "en": "Death land, my home!"},
        {"zh": "吞噬一切，直到最后！", "en": "Devour all, to the end!"},
        {"zh": "你是我的猎物，我看见你了！", "en": "You're my prey, I see you!"},
        {"zh": "一口，就一口！", "en": "One bite, just one bite!"},
        {"zh": "古肉，嚼起来真香！", "en": "Ancient meat chews so sweetly!"},
        {"zh": "你填不满我的肚子！", "en": "You cannot fill this belly!"},
        {"zh": "干瘪的手抓住你了！", "en": "My withered hand has you!"},
        {"zh": "痛吗？我饿得更痛！", "en": "Does it hurt? My hunger hurts more!"},
        {"zh": "这口肉终于到嘴了！", "en": "At last, meat in my mouth!"},
        {"zh": "撕下一块，再一块！", "en": "Tear off one piece, then another!"},
        {"zh": "永饿永远吃不饱！", "en": "Everhunger is never full!"},
        {"zh": "别挣扎，让我嚼！", "en": "Stop struggling and let me chew!"},
        {"zh": "我尝到你血的味道了！", "en": "I taste your blood now!"}
      ]
    },
