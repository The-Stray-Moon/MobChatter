    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "感知到你了", "en": "Felt you"},
        {"zh": "追踪开始", "en": "Track begins"},
        {"zh": "你的存在", "en": "Your presence"},
        {"zh": "你被发现了", "en": "Found you"},
        {"zh": "你的热气，钻进我的空腔。", "en": "Your body heat seeps into my hollow body."},
        {"zh": "你的气息", "en": "Your scent"},
        {"zh": "你在这儿", "en": "You're here"},
        {"zh": "永不放弃", "en": "Never give up"},
        {"zh": "直到最后一刻", "en": "To the end"},
        {"zh": "你一站起来，我就醒了。", "en": "You stood up, so I woke."},
        {"zh": "蹲下也没用，我看见你了。", "en": "Crouching won't help. I saw you."},
        {"zh": "黑暗里的眼睛在看你。", "en": "Eyes in the dark are watching you."},
        {"zh": "只要被发现，就没有尽头。", "en": "Once seen, there is no end to it."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "干瘪的躯体在风中颤抖。", "en": "My withered form shivers."},
        {"zh": "腐朽的肉块发出哀嚎。", "en": "Decaying flesh cries out."},
        {"zh": "饥火中灵魂颤抖。", "en": "Soul trembles in hunger's flame."},
        {"zh": "瘦骨嶙峋的身躯瑟瑟发抖。", "en": "Skin and bones shake."},
        {"zh": "腐肉在痛苦中蜷缩。", "en": "Meat curls in pain."},
        {"zh": "干枯的肌体痛苦挣扎。", "en": "Withered flesh struggles."},
        {"zh": "饥饿的灵魂在痛苦中呻吟。", "en": "Hunger's soul moans in pain."},
        {"zh": "饥饿的皮囊痛苦扭动。", "en": "Skin sack twists in pain."},
        {"zh": "干瘪的身躯蜷缩成一团。", "en": "Marrow-less body curls up."},
        {"zh": "饥饿的皮囊在痛苦中颤抖。", "en": "Skin sack trembles in pain."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身周的黑暗在低语，古肉的味道如此诱人！", "en": "The darkness around you whispers, ancient flesh tastes so enticing!"},
        {"zh": "别靠近，那将是你最后的晚餐！", "en": "Don't get close, that'll be your last meal!"},
        {"zh": "你的腐肉气息暴露了你！", "en": "Your decayed flesh scent revealed you!"},
        {"zh": "古肉的美味是不朽的，永饿！", "en": "The taste of ancient flesh is eternal, Everhunger!"},
        {"zh": "你闻起来就像美味佳肴！", "en": "You smell like a feast!"},
        {"zh": "靠近些，享受这永恒的晚餐吧！", "en": "Come closer, enjoy this eternal feast!"},
        {"zh": "你的味道让永饿苏醒了！", "en": "Your scent awakened Everhunger!"},
        {"zh": "别让古肉成为你的坟墓！", "en": "Don't let ancient flesh be your tomb!"},
        {"zh": "腐肉的诱惑是无尽的！", "en": "The temptation of decayed flesh is endless!"},
        {"zh": "你就是我的下一个猎物，腐肉！", "en": "You're my next prey, flesh of decay!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的到来唤醒了我！", "en": "Your arrival awakened me!"},
        {"zh": "你触碰了我的领地，永饿！", "en": "You touched my territory, Everhunger!"},
        {"zh": "我的视线穿透了你！", "en": "My vision pierced through you!"},
        {"zh": "你碰到了永饿，永无安宁！", "en": "You touched Everhunger, never peace!"},
        {"zh": "你打破了沉默，永饿苏醒！", "en": "You broke the silence, Everhunger awakens!"},
        {"zh": "你触碰了不该触碰的，永饿！", "en": "You touched what shouldn't be touched, Everhunger!"},
        {"zh": "你的存在唤醒了我，永饿！", "en": "Your presence awakened me, Everhunger!"},
        {"zh": "你的入侵唤醒了永饿！", "en": "Your intrusion awakened Everhunger!"},
        {"zh": "你碰触了不该碰触的，永饿！", "en": "You touched what shouldn't be touched, Everhunger!"},
        {"zh": "你打破了我长久的沉睡！", "en": "You broke my long slumber!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找我有什么事？", "en": "What do you want from me?"},
        {"zh": "同类，来，永饿需要伴侣！", "en": "Comrade, come, Everhunger needs a mate!"},
        {"zh": "找我的，别后悔！", "en": "You sought me, beware!"},
        {"zh": "你想要什么，永饿？", "en": "What do you want, Everhunger?"},
        {"zh": "找我，永饿会满足你！", "en": "You found me, Everhunger will satisfy you!"},
        {"zh": "你有什么话要说？", "en": "What do you have to say?"},
        {"zh": "找我，永无止境！", "en": "You sought me, endless!"},
        {"zh": "找我，永饿觉醒！", "en": "You sought me, Everhunger awakens!"},
        {"zh": "找我，永饿不会失望！", "en": "You sought me, Everhunger won't disappoint!"},
        {"zh": "找我，永饿需要你！", "en": "You sought me, Everhunger needs you!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "没有肉，我需要更多。", "en": "No meat, I need more."},
        {"zh": "古肉的味道如何？", "en": "How does the ancient meat taste?"},
        {"zh": "腐烂的古肉，美味！", "en": "Decaying ancient meat, delicious!"},
        {"zh": "找到新的目标。", "en": "New target found."},
        {"zh": "它会很肥美。", "en": "It will be plump."},
        {"zh": "我的耐心，终于要等到了。", "en": "My patience, finally."},
        {"zh": "饥饿的呼唤。", "en": "The call of hunger."},
        {"zh": "我的生存之道。", "en": "My way of survival."},
        {"zh": "腐肉的味道。", "en": "The taste of decayed flesh."},
        {"zh": "这肉够我嚼很久。", "en": "This meat will last me a long while."}
