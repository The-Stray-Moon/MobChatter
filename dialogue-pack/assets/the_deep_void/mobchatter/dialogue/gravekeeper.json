{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我抽着身子往前走", "en": "I jerk forward in twitches."},
        {"zh": "钩状的手垂在身侧", "en": "My hooked hands hang at my sides."},
        {"zh": "我的步子不连贯", "en": "My steps don't connect."},
        {"zh": "我拖着一条腿", "en": "I drag one leg."},
        {"zh": "牙齿一直露在外面", "en": "My teeth are always bared."},
        {"zh": "我绕着骨堆走", "en": "I circle the bone heaps."},
        {"zh": "我走得歪，但很快", "en": "Crooked, but fast."},
        {"zh": "我经过的地方土都翻了", "en": "The soil turns where I pass."},
        {"zh": "我低头嗅地面", "en": "I lower my head to sniff the ground."},
        {"zh": "我朝有尸体的方向走", "en": "I walk toward the corpses."},
        {"zh": "我的影子贴着地", "en": "My shadow clings to the ground."},
        {"zh": "我一步一顿地逼近", "en": "I close in, one halted step at a time."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在那里抽动", "en": "I stand there, twitching."},
        {"zh": "我的牙咬了两下", "en": "My teeth click twice."},
        {"zh": "我在听土下的声音", "en": "I listen beneath the soil."},
        {"zh": "这地方埋了很多人", "en": "Many are buried here."},
        {"zh": "我舔了舔钩子", "en": "I lick my hooks."},
        {"zh": "我看不见远处", "en": "I can't see far."},
        {"zh": "腐骨的味道很熟", "en": "The scent of rotten bone is familiar."},
        {"zh": "我把头慢慢拧过来", "en": "I slowly screw my head round."},
        {"zh": "我在等一具尸体", "en": "I'm waiting for a corpse."},
        {"zh": "我的肩膀抖了一下", "en": "My shoulder jerked."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你还没有死掉", "en": "You're not dead yet."},
        {"zh": "你正站在坟上", "en": "You're standing on a grave."},
        {"zh": "你身上的热气真冲", "en": "Your living warmth is strong."},
        {"zh": "你的骨头很新", "en": "Your bones are new."},
        {"zh": "我一跃就到你面前", "en": "One leap and I'm before you."},
        {"zh": "脖子别转过去", "en": "Don't turn that neck."},
        {"zh": "你在数坟墓吗", "en": "Are you counting graves?"},
        {"zh": "我的钩子很锋利", "en": "My hooks are sharp."},
        {"zh": "你退不出这片墓园", "en": "You can't leave this graveyard."},
        {"zh": "我的钩子已经抬到你脖子边", "en": "My hook is already at your throat."},
        {"zh": "你身上会开始烂", "en": "You'll start to rot soon."},
        {"zh": "别在意我抽动", "en": "Don't mind my twitching."},
        {"zh": "我很久没吃过东西", "en": "I haven't eaten in a long while."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的肩膀抽了一下", "en": "My shoulder jerked."},
        {"zh": "这一下砍在我钩子上", "en": "That hit my hook."},
        {"zh": "我歪了一下子", "en": "I tilted."},
        {"zh": "我的牙掉了一颗", "en": "A tooth came loose."},
        {"zh": "疼得我抽得更厉害", "en": "The pain makes me twitch more."},
        {"zh": "我还立得稳当", "en": "I can still stand."},
        {"zh": "邪门的东西，会疼", "en": "Strange—it hurts."},
        {"zh": "我的肉在往下掉", "en": "My flesh is falling away."},
        {"zh": "这一下记下了", "en": "That's noted."},
        {"zh": "我还会跳的呀", "en": "I can still leap."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那喂不饱我的牙", "en": "That won't feed my teeth."},
        {"zh": "我要的是尸体", "en": "I want corpses."},
        {"zh": "你手里的东西没血", "en": "What you hold has no blood."},
        {"zh": "你身上的肉更好", "en": "The flesh on you is better."},
        {"zh": "搁下就走开去", "en": "Set it down and leave."},
        {"zh": "这一点还不够", "en": "Not enough."},
        {"zh": "我只要烂掉的", "en": "I take only what's rotted."},
        {"zh": "那东西对我没意义", "en": "That means nothing to me."},
        {"zh": "把它塞回兜里", "en": "Tuck it back in your pocket."},
        {"zh": "我不吃哄人的话", "en": "I don't eat coaxing."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我的钩子", "en": "You hit my hooks."},
        {"zh": "我抽了一下，没倒", "en": "I jerked but didn't fall."},
        {"zh": "这一下让我歪了头", "en": "That tilted my head."},
        {"zh": "你身上沾了腐烂", "en": "Rot is on you now."},
        {"zh": "我们贴得很近", "en": "We're very close."},
        {"zh": "我的牙就在你耳边", "en": "My teeth are at your ear."},
        {"zh": "从坟头那边让开", "en": "Move off the graves."},
        {"zh": "这一撞我不计较", "en": "I'll overlook that bump."},
        {"zh": "你别再碰我了", "en": "Don't touch me again."},
        {"zh": "再撞一次我就咬", "en": "Bump again and I bite."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只吃那些尸体", "en": "I only eat corpses."},
        {"zh": "这种事跟墓园无关", "en": "That has nothing to do with a graveyard."},
        {"zh": "我已经不算活着", "en": "I'm not really alive."},
        {"zh": "你另找活人去", "en": "Find a living one."},
        {"zh": "我的钩子只会挖土", "en": "My hooks only dig."},
        {"zh": "从这片坟地走开", "en": "Get out of this graveyard."},
        {"zh": "别提活人的事", "en": "Don't speak of living things."},
        {"zh": "我连名字都忘了", "en": "I've forgotten my name."},
        {"zh": "坟地不谈这些", "en": "Not in a graveyard."},
        {"zh": "我该去巡坟了", "en": "I should walk the graves."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抓的是钩子", "en": "You've grabbed a hook."},
        {"zh": "我的身子会抽", "en": "My body jerks."},
        {"zh": "把我搁回坟上", "en": "Set me back on the grave."},
        {"zh": "这样我跃不起来", "en": "I can't leap like this."},
        {"zh": "你手上会有腐烂", "en": "Your hands will rot."},
        {"zh": "你比我矮，抱不稳", "en": "You're shorter than I am; you can't hold me."},
        {"zh": "钩子会割到你", "en": "My hooks will cut you."},
        {"zh": "你的肉在我手边", "en": "Your flesh is right by my hand."},
        {"zh": "我咬得到你的", "en": "I can bite you from here."},
        {"zh": "你后悔也晚了", "en": "It's too late to regret."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩了我的坟", "en": "You stepped on my grave."},
        {"zh": "我闻到你的血", "en": "I smell your blood."},
        {"zh": "这一跃够得着你", "en": "One leap reaches you."},
        {"zh": "别往墓碑后躲", "en": "Don't hide behind a stone."},
        {"zh": "墓园里没人跑得掉", "en": "No one outruns this graveyard."},
        {"zh": "我要吃一具新鲜的", "en": "I want one fresh corpse."},
        {"zh": "我的牙已经张开了", "en": "My teeth are open."},
        {"zh": "你站的地方不对", "en": "You're standing in the wrong place."},
        {"zh": "我已经勾住你", "en": "I've hooked onto you."},
        {"zh": "腐烂会先到来", "en": "The rot comes first."},
        {"zh": "你退到坟后也没用", "en": "Hiding behind a grave won't help."},
        {"zh": "这一下会很快", "en": "This is quick."},
        {"zh": "你听见土动了吗", "en": "Hear the soil move?"},
        {"zh": "那副身子是我", "en": "That shape is me."},
        {"zh": "该起跳过去了", "en": "Time to leap."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在土里爬着", "en": "I crawl through the soil."},
        {"zh": "我能从坟里出来", "en": "I can come up through a grave."},
        {"zh": "你的脚边都是松土", "en": "Loose earth at your feet."},
        {"zh": "我在计算距离", "en": "I'm measuring the distance."},
        {"zh": "这一跃我练了很多年", "en": "I've practiced this leap for years."},
        {"zh": "你的眼睛在找出口", "en": "Your eyes are hunting an exit."},
        {"zh": "这里只有一个门", "en": "There's only one gate here."},
        {"zh": "你每走一步都踩到坟", "en": "Every step you take is on a grave."},
        {"zh": "我在你脊背后头", "en": "I'm behind your spine."},
        {"zh": "脖子别转过来", "en": "Don't turn that neck."},
        {"zh": "我抽动的时候更近", "en": "Each twitch brings me nearer."},
        {"zh": "我的钩子会挖开你的脚", "en": "My hooks will dig at your feet."},
        {"zh": "腐骨在我嘴里响", "en": "Rotten bone rattles in my mouth."},
        {"zh": "咕噜——噜噜", "en": "Guh—guh."},
        {"zh": "这一跃就到了", "en": "One leap and I'm there."},
        {"zh": "你听见牙齿了吗", "en": "Hear the teeth?"},
        {"zh": "我就在你上面", "en": "I'm above you."},
        {"zh": "就这一下跃起", "en": "This leap."},
        {"zh": "我这就起跳了", "en": "I'm leaping."},
        {"zh": "总算逮住你了", "en": "Caught you at last."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "牙齿咬进肉里", "en": "My teeth sink in."},
        {"zh": "钩子钩住你了", "en": "The hook has you."},
        {"zh": "这一口会腐烂", "en": "This one rots."},
        {"zh": "你的皮开始发黑", "en": "Your skin is darkening."},
        {"zh": "血不流了，肉在烂", "en": "No blood; the flesh rots."},
        {"zh": "我跃到你背上", "en": "I leap onto your back."},
        {"zh": "别挣，挣不掉", "en": "Don't struggle; you can't."},
        {"zh": "你身上有味道了", "en": "Now you carry the smell."},
        {"zh": "再咬你第二下", "en": "A second bite."},
        {"zh": "你脚下打晃了", "en": "Your feet are swaying."},
        {"zh": "腐烂从伤口往外走", "en": "Rot spreads from the wound."},
        {"zh": "我喜欢这种速度", "en": "I like this speed."},
        {"zh": "我还能再跃一次", "en": "I can leap once more."},
        {"zh": "你已经跑不动", "en": "You can't run anymore."},
        {"zh": "我吃定你了呀", "en": "You're mine to eat."},
        {"zh": "别怕，会很快", "en": "Don't fear; it's quick."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坟里爬出来", "en": "I climb out of a grave."},
        {"zh": "土在我脚下松开", "en": "The soil loosens under me."},
        {"zh": "钩子先伸出来", "en": "My hooks come out first."},
        {"zh": "我闻到这片墓园的味", "en": "I smell this graveyard."},
        {"zh": "土里有很多骨头", "en": "Many bones in the soil."},
        {"zh": "我的牙一直在响", "en": "My teeth never stop clicking."},
        {"zh": "坟头都归我看守", "en": "Every grave is mine to keep."},
        {"zh": "我抽了一下，站直了", "en": "I jerked, then straightened."},
        {"zh": "有人踩过这座坟", "en": "Someone walked on a grave."},
        {"zh": "我慢慢从土里起来", "en": "I rise slowly from the earth."},
        {"zh": "腐骨还在嘴里", "en": "Rotten bone still in my mouth."},
        {"zh": "我先挖开一个", "en": "Let me open one first."},
        {"zh": "这里该有人看管", "en": "Someone should watch this place."},
        {"zh": "我听见上面有脚步", "en": "I hear steps above."},
        {"zh": "我从土里出来了", "en": "I've come up from the soil."},
        {"zh": "没有尸体，就先找活的", "en": "No corpses, so the living first."}
      ]
    },
