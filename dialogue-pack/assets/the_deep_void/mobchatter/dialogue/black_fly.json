        {"zh": "腹里塞满了卵。", "en": "My abdomen is packed with eggs."},
        {"zh": "趴在你够不到的墙缝。", "en": "I cling to a crack you cannot reach."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
