  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嗡嗡嗡，好大的苍蝇！", "en": "Buzz, buzz, so big!"},
        {"zh": "飞过那块骨头！", "en": "Fly over the bone."},
        {"zh": "这里食物丰富！", "en": "Food is abundant here."},
        {"zh": "寄生虫卵藏好！", "en": "Hide the parasitic eggs!"},
        {"zh": "躲避攻击，别被打死！", "en": "Avoid attacks, don't get killed!"},
        {"zh": "我掠过骨头，翅膀嗡嗡响。", "en": "I skim over the bones, wings buzzing."},
        {"zh": "嗡，嗡，嗡……", "en": "Buzz, buzz, buzz..."},
        {"zh": "这里有好多骨头！", "en": "So many bones here!"},
        {"zh": "躲远点，别靠近我！", "en": "Stay away from me!"},
        {"zh": "寄生，寄生！", "en": "Parasitize, parasitize!"},
        {"zh": "翅膀擦过骨堆，沙沙响。", "en": "Wings brush the bone pile with a hiss."},
        {"zh": "绕着一具尸骸转两圈。", "en": "I circle a carcass twice."},
        {"zh": "增生的速度比骨头长得快。", "en": "I multiply faster than bone grows."},
        {"zh": "贴着血肉平原低飞。", "en": "I skim low over the flesh plains."},
        {"zh": "落在髓骨虫旁边歇脚。", "en": "I settle beside a marrow worm."},
        {"zh": "翅膜一抖，躲开你的剑。", "en": "A wing twitch dodges your blade."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这儿等你！", "en": "I'll wait for you here!"},
