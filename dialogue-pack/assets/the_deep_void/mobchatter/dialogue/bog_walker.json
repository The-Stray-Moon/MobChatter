    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "触手缠住你！", "en": "Writhing tentacles grab you!"},
        {"zh": "黑暗里我越打越精神。", "en": "In darkness, every blow revives me."},
        {"zh": "触手先卷住你的脚。", "en": "My tentacle grabs your ankle first."},
