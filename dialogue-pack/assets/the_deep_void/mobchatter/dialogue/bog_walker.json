{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "触手蠕动，逼近猎物。", "en": "Tentacles move, closing in."},
        {"zh": "黏液中留下触手痕迹。", "en": "Tentacles leave marks in the slime."},
        {"zh": "黑暗中悄然前行。", "en": "Creeps forward in the dark."},
        {"zh": "触手缠绕，吞噬一切。", "en": "Tentacles wrap, engulfing everything."},
        {"zh": "虚空之光，无法治愈我。", "en": "Light can't heal me."},
        {"zh": "沼泽深处，我的家园。", "en": "My home, deep in the mire."},
        {"zh": "漆黑中，我的猎物。”", "en": "In darkness, my prey."},
        {"zh": "触手感知，目标锁定。", "en": "Tentacles sense, target locked."},
        {"zh": "缓慢移动，静待时机。", "en": "Slowly moves, waiting."},
        {"zh": "黑暗中，我的统治。”", "en": "In darkness, my reign."},
        {"zh": "吸盘贴着烂泥滑行。", "en": "Suckers slide along the rotten mud."},
        {"zh": "触须扫过腐草，留下黏液。", "en": "Tendrils sweep the rotgrass, leaving slime."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "触手闲摆，无所事事。", "en": "Tentacles idle, doing nothing."},
        {"zh": "黑暗中，悄然存在。", "en": "Exists quietly in darkness."},
        {"zh": "等待猎物靠近。”", "en": "Wait for prey."},
        {"zh": "触手微动，静待猎物。", "en": "Tentacles twitch, waiting."},
        {"zh": "虚空之力，赋予我生命。", "en": "Void power gives me life."},
        {"zh": "泥面只冒出一串气泡。", "en": "Only a string of bubbles breaks the mud."},
        {"zh": "触手缓缓摆动。", "en": "Tentacles sway lazily."},
        {"zh": "黑暗中，我的阴影。", "en": "In darkness, my shadow."},
        {"zh": "静待，直到猎物到来。", "en": "Wait until prey comes."},
        {"zh": "在黑暗中，我是唯一。", "en": "I am the only one in darkness."},
        {"zh": "泡在沼水里，只露出触尖。", "en": "Soaked in the bog, only tentacle tips show."},
        {"zh": "闭着无眼的头颅倾听。", "en": "The eyeless head listens in silence."},
        {"zh": "腐沼的气泡在身旁破裂。", "en": "Bog bubbles burst beside me."},
        {"zh": "数着落进水里的枯枝。", "en": "I count dead branches falling into the water."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的触手从水下探出来。", "en": "My tentacles rise out of the water."},
        {"zh": "感知玩家，近了。”", "en": "Sense player, close now."},
        {"zh": "玩家的气息，如此熟悉。", "en": "Player's scent, so familiar."},
        {"zh": "触手缠绕，将你抓住。", "en": "Tentacles wrap, grab you."},
        {"zh": "你站在光里，我待在暗处。", "en": "You stand in light; I keep to the dark."},
        {"zh": "触手伸入，抓住猎物。", "en": "Tentacles reach in, grab prey."},
        {"zh": "玩家，我的下一个猎物。", "en": "Player, my next prey."},
        {"zh": "触手收紧，锁定目标。", "en": "Tentacles tighten, locking target."},
        {"zh": "接近，进入我的领域。", "en": "Approach, enter my domain."},
        {"zh": "触手触碰，感受猎物。", "en": "Tentacles touch, feel prey."},
        {"zh": "你踩碎了我沼泽的静默。", "en": "You shattered my swamp's silence."},
        {"zh": "光在你手上，很刺眼。", "en": "The light in your hand stings."},
        {"zh": "你的心跳传到了泥里。", "en": "Your heartbeat reaches the mud."},
        {"zh": "我在你的影子里嗅到恐惧。", "en": "I smell fear in your shadow."},
        {"zh": "你的靴子已经陷进软泥。", "en": "Your boots have sunk into the soft mud."},
        {"zh": "我记得你上次的味道。", "en": "I remember your taste from last time."},
        {"zh": "你的火把照不进我的泥。", "en": "Your torch cannot reach my mud."},
        {"zh": "沼泽把你推到我面前。", "en": "The swamp pushed you to me."},
        {"zh": "别眨眼，我就在你脚下。", "en": "Don't blink, I am beneath your feet."},
        {"zh": "你看不见我藏在泥下。", "en": "You cannot see me under the muck."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "触手缠住我了！", "en": "Tentacles grab me!"},
        {"zh": "泥沼抓住我了！", "en": "Soggy bog holds me!"},
        {"zh": "光打过来，我缩回泥里。", "en": "Light strikes, and I shrink back into the mire."},
        {"zh": "泥潭包裹了我！", "en": "Mud swallows me!"},
        {"zh": "我动弹不得！", "en": "I can't move!"},
        {"zh": "触手困住我了！", "en": "Tentacles ensnare me!"},
        {"zh": "我被淹没了！", "en": "I'm drowned!"},
        {"zh": "触手束缚了我！", "en": "Tentacles bind me!"},
        {"zh": "泥沼吞噬了我！", "en": "Soggy bog devours me!"},
        {"zh": "泥粘住我的触手根。", "en": "Mud clings to the roots of my tentacles."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "触手伸向你，别躲！", "en": "Tentacles reach for you, no escape!"},
        {"zh": "黑暗中你闻到了我的味道。", "en": "You smell my presence in the dark."},
        {"zh": "我在这片沼泽寻找猎物。", "en": "I hunt in this mire."},
        {"zh": "触手下的你，无处可逃。", "en": "Tentacles hold you, no escape."},
        {"zh": "我的触手比你想象的更长。", "en": "My tentacles are longer than you think."},
        {"zh": "黑暗中，我的力量更强。", "en": "In darkness, my strength surges."},
        {"zh": "你手里的火把，让我发痒。", "en": "That torch in your hand makes me itch."},
        {"zh": "我的触手能抓住任何猎物。", "en": "My tentacles grasp any prey."},
        {"zh": "不要试着反抗我的触手。", "en": "Don't struggle against my tentacles."},
        {"zh": "我的触手能穿透黑暗。", "en": "My tentacles pierce the darkness."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽的泥里，我的触手在动。", "en": "Under the swamp mud, my tentacles are moving."},
        {"zh": "我的触手准备好了战斗。", "en": "My tentacles are ready to fight."},
        {"zh": "别靠近我，否则会后悔。", "en": "Stay back, or you'll regret it."},
        {"zh": "我的触手能束缚你。", "en": "My tentacles bind you."},
        {"zh": "你闯入了我的巢穴！", "en": "You've invaded my nest!"},
        {"zh": "我的触手准备撕裂你。", "en": "My tentacles prepare to tear you."},
        {"zh": "你的脚踩到一条触手。", "en": "Your foot lands on one of my tentacles."},
        {"zh": "我的触手不会轻易放你走。", "en": "My tentacles won't let you go easily."},
        {"zh": "我的触手能抓住你。", "en": "My tentacles will seize you."},
        {"zh": "靠近我，你会付出代价。", "en": "Draw near, and you'll pay the price."}
      ]
    },
