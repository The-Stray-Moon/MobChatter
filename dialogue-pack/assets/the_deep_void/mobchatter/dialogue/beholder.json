    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "盯上你了，无处可逃！", "en": "Locking onto you, no escape."},
        {"zh": "你在我视线之中！", "en": "You're in my sight."},
        {"zh": "你蹲下，就不必看我了。", "en": "Crouch, and you need not meet my gaze."},
        {"zh": "尝尝我的触角！", "en": "Feel my tentacles."},
        {"zh": "闭上眼，感受恐惧！", "en": "Close your eyes, feel fear."},
        {"zh": "从肉地里伸出来的眼，正看着你。", "en": "The eye stretching out of the flesh is watching you."},
        {"zh": "对视三秒，你就完了。", "en": "Three seconds of eye contact and you are done."},
        {"zh": "被我注视，颤抖吧！", "en": "Tremble under my gaze."},
        {"zh": "黑暗是我的武器！", "en": "Darkness is my weapon."},
        {"zh": "你无法逃脱我的触碰！", "en": "You can't escape my touch."},
        {"zh": "目光一刺，你眼前发白", "en": "A stab of its gaze whites out your vision."},
        {"zh": "眼柄抽来，打在你的护腕上", "en": "Its stalk whips across your bracer."},
        {"zh": "它贴上来，瞳孔顶住你的额头", "en": "It presses close, its pupil against your brow."},
        {"zh": "光烧着你的皮肤", "en": "The light burns your skin."},
        {"zh": "它把你的名字从记忆里挖走", "en": "It digs your name out of your memory."},
        {"zh": "对视一瞬，你的膝盖就软了", "en": "One moment of eye contact buckles your knees."},
        {"zh": "它撞进你的视野，再不肯走", "en": "It forces into your sight and refuses to leave."},
        {"zh": "肉地里伸出新的眼睛", "en": "New eyes push out of the flesh."},
        {"zh": "它的视线像刀子刮过骨头", "en": "Its gaze scrapes your bones like a blade."},
        {"zh": "你闭上眼，它还在看", "en": "You shut your eyes, and it still watches."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "视觉神经正在苏醒！", "en": "Beholder awakening."},
        {"zh": "阴郁死地的守护者！", "en": "Guardian of the Darklands."},
