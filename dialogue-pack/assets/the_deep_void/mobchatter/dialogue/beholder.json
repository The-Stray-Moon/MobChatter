    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你一低头，我就靠近。", "en": "When you lower your eyes, I come closer."},
        {"zh": "保持恒定对视", "en": "Maintains constant gaze"},
        {"zh": "对视持续不断", "en": "Gaze never breaks"},
        {"zh": "玩家陷入恐惧", "en": "Player is terrified"},
        {"zh": "对视令你窒息", "en": "Gaze suffocates player"},
