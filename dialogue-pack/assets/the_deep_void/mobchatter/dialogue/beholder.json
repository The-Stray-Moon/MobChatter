{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜咕噜，它在低语。", "en": "Rumble, rumble, it whispers."},
        {"zh": "它的光芒在闪烁。", "en": "Its light flickers."},
        {"zh": "它的眼睛在搜索。", "en": "Its eyes search."},
        {"zh": "这只眼球，慢慢转过来。", "en": "This eyeball turns toward you, slowly."},
        {"zh": "它的触手在移动。", "en": "Its tentacles move."},
        {"zh": "它的眼睛在寻找猎物。", "en": "Its eyes seek prey."},
        {"zh": "它在缓缓移动。", "en": "It moves slowly."},
        {"zh": "它的光芒照亮了黑暗。", "en": "Its light illuminates the darkness."},
        {"zh": "它在黑暗中摸索。", "en": "It fumbles in the dark."},
        {"zh": "它的存在感很强。", "en": "Its presence is strong."},
        {"zh": "眼球转动，顺着肉地滑行", "en": "The eyeball swivels as it slides along the flesh."},
        {"zh": "眼柄伸得更长，探向前方", "en": "Its eyestalk stretches further ahead."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "它静静地等待。", "en": "It waits silently."},
        {"zh": "它的目光呆滞。", "en": "Its gaze is blank."},
        {"zh": "它的触手紧紧蜷缩。", "en": "Its tentacles curl tightly."},
        {"zh": "它似乎在沉思。", "en": "It seems to contemplate."},
        {"zh": "它的光芒时明时暗。", "en": "Its light flickers."},
        {"zh": "它的身体微微颤动。", "en": "Its body trembles slightly."},
        {"zh": "它在原地不动。", "en": "It stands still."},
        {"zh": "它的光芒在闪烁", "en": "Its light flickers"},
        {"zh": "它的触手静静地摇晃。", "en": "Its tentacles gently sway."},
        {"zh": "它保持着警惕。", "en": "It remains vigilant."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛一直没转开。", "en": "My eye hasn't looked away."},
        {"zh": "它的眼睛对上了你的。", "en": "Its eyes meet yours."},
        {"zh": "它在注视你。", "en": "It watches you."},
        {"zh": "它的眼珠转动。", "en": "Its eyes roll."},
        {"zh": "它的眼睛在变亮。", "en": "Its eyes brighten."},
        {"zh": "它的眼睛在追踪你。", "en": "Its eyes track you."},
        {"zh": "它在你身上寻找。", "en": "It searches you."},
        {"zh": "它的眼睛在发光。", "en": "Its eyes glow."},
        {"zh": "它的眼睛在你身上停留。", "en": "Its eyes linger on you."},
        {"zh": "它的眼睛在盯着你看。", "en": "Its eyes stare at you."},
        {"zh": "它把目光钉在你脸上", "en": "It pins its gaze to your face."},
        {"zh": "你一蹲下，它便看不见你", "en": "As you crouch, it loses sight of you."},
        {"zh": "它眨了眨眼，光晃了一下", "en": "It blinks and the light wavers."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你的视线穿透了我的一切。", "en": "Your gaze pierces through me."},
        {"zh": "你的眼神让我的视线模糊。", "en": "Your stare blurs my vision."},
        {"zh": "对视令我痛苦。", "en": "Meeting your gaze hurts."},
        {"zh": "那只对视的眼，被打红了。", "en": "The eye you stared into has been struck red."},
        {"zh": "我挣扎着想要逃脱。", "en": "I struggle to escape."},
        {"zh": "你的眼神让我难以忍受。", "en": "Your stare is unbearable."},
        {"zh": "我的视线开始模糊。", "en": "My vision starts to blur."},
        {"zh": "我对你的视线感到不适。", "en": "I am uncomfortable with your gaze."},
        {"zh": "你的视线让我虚弱。", "en": "Your gaze weakens me."},
        {"zh": "我无法承受你的视线。", "en": "I cannot endure your gaze."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "注视深渊，灵魂出窍！", "en": "Gaze into the depths, soul revealed!"},
        {"zh": "你的眼睛无法避开我。", "en": "Your eyes cannot avoid mine."},
        {"zh": "我能看到你的心。", "en": "I see your heart."},
        {"zh": "你被锁定了，永饿觉醒！", "en": "Locked, Hunger Awakens!"},
        {"zh": "直视我，感受我的力量。", "en": "Look into me, feel my power."},
        {"zh": "你的理智将被吞噬。", "en": "Your sanity will be devoured."},
        {"zh": "闭上你的眼，无法逃脱。", "en": "Close your eyes, you cannot escape."},
        {"zh": "永远的目光，永恒的战斗。", "en": "Eternal gaze, eternal battle."},
        {"zh": "注视我，成为我的一部分。", "en": "Gaze upon me, become a part of me."},
        {"zh": "你的灵魂在呼唤。", "en": "Your soul calls to me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "避不开的碰撞！", "en": "Inevitable collision!"},
        {"zh": "触碰到我的存在。", "en": "Touch my presence."},
        {"zh": "撞我，只会让你陷进来。", "en": "Hitting me only sinks you deeper."},
        {"zh": "无法承受我的怒火。", "en": "Unable to bear my rage."},
        {"zh": "你的力量唤醒我！", "en": "Your strength awakens me!"},
        {"zh": "躲开我的视线！", "en": "Avoid my gaze!"},
        {"zh": "你撞在肉地上，弹回去。", "en": "You hit the flesh floor and rebound."},
        {"zh": "被我的力量吞噬吧！", "en": "Be consumed by my power!"},
        {"zh": "我的视线无处不在。", "en": "My gaze is everywhere."},
        {"zh": "你触碰了我的界限！", "en": "You touched my boundary!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这只眼睛，专找人眼。", "en": "This eye of mine seeks out other eyes."},
        {"zh": "两只眼，看同一个方向。", "en": "Two eyes, looking the same way."},
        {"zh": "彼此注视，永恒不变。", "en": "Mutual gaze, eternal."},
        {"zh": "我的视线中只有你。", "en": "Only you in my gaze."},
        {"zh": "你的存在吸引我。", "en": "Your presence draws me."},
        {"zh": "与我共鸣，永生共存。", "en": "Resonate with me, eternal existence."},
        {"zh": "我的灵魂渴望你。", "en": "My soul craves you."},
        {"zh": "与我融合，成为一体。", "en": "Merge with me, become one."},
        {"zh": "我们的心灵相连。", "en": "Our hearts are linked."},
        {"zh": "共同注视未来。", "en": "Mutual gaze, shared future."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "肉地中伸出", "en": "Emerges from Meatland"},
        {"zh": "阴郁死地游荡", "en": "Wanders in the Desolate Wasteland"},
        {"zh": "凝视丘陵栖息", "en": "Nests in Gaze Hills"},
