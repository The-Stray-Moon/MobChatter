        {"zh": "注视间感到恐惧", "en": "Feel fear in the gaze"},
        {"zh": "永饿被视而苏醒", "en": "Starving awakens from the gaze"},
        {"zh": "视线扫过地面，寻找活物", "en": "Its gaze sweeps the ground, hunting for the living."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的眼睛已经出卖你。", "en": "Your eyes have already betrayed you."},
        {"zh": "发出微弱光芒", "en": "Flickers weakly"},
        {"zh": "伸眼触探四周", "en": "Extends eyes to scout"},
        {"zh": "别躲，我还没看够。", "en": "Do not hide; I am not done looking."},
        {"zh": "别低头，我要你看回来。", "en": "Don't look down. I want you looking back."},
        {"zh": "光芒骤然增强", "en": "Brightness increases"},
        {"zh": "准备追逐玩家", "en": "Prepares to chase"},
        {"zh": "锁定猎物视线", "en": "Locks on to prey"},
        {"zh": "瞄准玩家发起攻击", "en": "Aims at player to attack"},
        {"zh": "视觉锁定目标", "en": "Vision locks on target"},
        {"zh": "光一收，它认准了你", "en": "The glow narrows; it has chosen you."},
        {"zh": "目光黏住你，再也甩不掉", "en": "Its gaze sticks to you and will not come off."},
        {"zh": "它睁大眼，永饿在底下动了", "en": "It widens its eye and the Eternal Hunger stirs below."},
        {"zh": "它转向你，光直射过来", "en": "It turns to you, light shooting straight out."},
        {"zh": "你被它看在眼里，跑也没用", "en": "It has you in its sight; running will not help."},
        {"zh": "瞳孔缩紧，锁住你的身影", "en": "Its pupil contracts, locking onto your shape."}
