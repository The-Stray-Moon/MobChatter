{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "黑影蹒跚，骨裂声起。", "en": "Rattle as you stalk."},
        {"zh": "追随腐烂之魂。", "en": "Follow the rotten soul."},
        {"zh": "黑暗中飘荡，吞噬愚者。", "en": "Wander in darkness, eat fools."},
        {"zh": "眼睛转动，寻找猎物。", "en": "Eyes move, seeking prey."},
        {"zh": "黑暗中的贪婪捕手。", "en": "Greedy hunter in the dark."},
        {"zh": "夜幕下，影子游走。", "en": "Night shadows wander."},
        {"zh": "眼眸闪烁，预谋着。", "en": "Eye glints, plotting."},
        {"zh": "腐朽皮肤，冰冷触感。", "en": "Decaying skin, cold touch."},
        {"zh": "根植于虚无之地。", "en": "Rooted in the void."},
        {"zh": "站起时骨头一节节响。", "en": "My bones crack one by one as I stand."},
        {"zh": "长腿跨过腐骨堆。", "en": "My long legs stride over heaps of rotten bone."},
        {"zh": "眼睛在身上四处转动。", "en": "The eyes all over me turn this way and that."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "沉默中，黑影静立。", "en": "Silent, black figure stands."},
        {"zh": "夜风轻拂，骨骸摇曳。", "en": "Bones rattle in the night breeze."},
        {"zh": "腐朽之魂，凝视虚空。", "en": "Rotten soul stares into void."},
        {"zh": "黑影中，灵魂游荡。", "en": "Soul roams in black shadow."},
        {"zh": "虚无之地，灵魂静坐。", "en": "Void, soul sits still."},
        {"zh": "黑暗中，黑影不动。", "en": "Darkness, black figure still."},
        {"zh": "眼中空洞，内心黑暗。", "en": "Eyes hollow, heart dark."},
        {"zh": "腐骨随时间消逝。", "en": "Bones fade with time."},
        {"zh": "灵魂飘荡，永不停息。", "en": "Soul wanders, never ceasing."},
        {"zh": "夜晚的黑色守望者。", "en": "Night’s black watchman."},
        {"zh": "我装成游魂，一动不动。", "en": "I play at being a wandering soul, perfectly still."},
        {"zh": "身上的眼睛轮流眨。", "en": "The eyes on my body blink in turn."},
        {"zh": "黑苔从肩头垂下来。", "en": "Black moss hangs from my shoulder."},
        {"zh": "我站着，像一截烧焦的树。", "en": "I stand like a charred tree."},
        {"zh": "虚空根在脚边轻轻抽动。", "en": "Void roots twitch at my feet."},
        {"zh": "有东西靠近，我才抬头。", "en": "Only when something nears do I lift my head."},
        {"zh": "腐骨在我怀里慢慢碎。", "en": "Rotten bone crumbles slowly in my arms."},
        {"zh": "我数着荒野上的脚步声。", "en": "I count footsteps on the waste."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "目光锁定，猎物临近。", "en": "Gaze fixed, prey near."},
        {"zh": "眼睛闪烁，注视玩家。", "en": "Eyes glow, fix on you."},
        {"zh": "寻找猎物，玩家来了。", "en": "Seeking prey, you're here."},
        {"zh": "黑暗中，玩家被发现。", "en": "Player found in the dark."},
        {"zh": "视线锁定，追捕开始。", "en": "Lock on, pursuit begins."},
        {"zh": "眼睛转动，追踪玩家。", "en": "Eyes move, tracking you."},
        {"zh": "寻找猎物，玩家现身。", "en": "Find prey, you appear."},
        {"zh": "你踏进腐骨堆，我才抬脚。", "en": "Only when you step into the bone heap do I lift a foot."},
        {"zh": "灵魂游荡，玩家惊现。", "en": "Soul wanders, player appears."},
        {"zh": "黑暗中，玩家被盯上。", "en": "In the dark, you're targeted."},
        {"zh": "你走近了，我才站起来。", "en": "You came close; now I stand."},
        {"zh": "我的眼睛都在看你。", "en": "All my eyes are on you."},
        {"zh": "你以为是游魂在招手？", "en": "Did you think a wandering soul was beckoning?"},
        {"zh": "我身上的眼睛，全转向你。", "en": "Every eye on my body turns to you."},
        {"zh": "别停，你的腿比我短。", "en": "Do not stop; your legs are shorter than mine."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉的味道如何？", "en": "How does rotten flesh taste?"},
        {"zh": "愚蠢的人类！", "en": "Foolish human!"},
        {"zh": "尝尝我的黑苔吧！", "en": "Taste my black moss!"},
        {"zh": "我身上那些眼睛，都是骗你的。", "en": "Every eye on my body is a lie for you."},
        {"zh": "我满身的眼睛，都睁开了。", "en": "Every eye on me has opened."},
        {"zh": "腐烂的皮肤！", "en": "Rotten skin!"},
        {"zh": "黑苔被我撕掉一块。", "en": "A patch of black moss tears off me."},
        {"zh": "你本该死得更惨！", "en": "You should have died worse!"},
        {"zh": "腐骨是我的牙齿！", "en": "My teeth are bones!"},
        {"zh": "眼珠被砍掉了一颗。", "en": "One of my eyes is cut away."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗中的眼睛在闪烁，引诱你前行。", "en": "Eyes glow in the dark, luring you forward."},
        {"zh": "靠近我，我会给你力量。", "en": "Come closer, I’ll give you strength."},
        {"zh": "我的皮肤腐朽，你也是。", "en": "My skin rots, so will you."},
        {"zh": "感受我的黑暗吧，愚者。", "en": "Feel the darkness, fool."},
        {"zh": "你的皮肤和我一样，即将腐烂。", "en": "Your skin will rot like mine."},
        {"zh": "你被我的眼睛吸引了吗？", "en": "Are my eyes drawing you in?"},
        {"zh": "腐朽的力量将你包围。", "en": "Rotted power surrounds you."},
        {"zh": "我的骨头比你想象的更脆。", "en": "My bones are crisper than you think."},
        {"zh": "那些眼睛里，没有一个是活的。", "en": "Not one of those eyes is alive."},
        {"zh": "感受我的存在，愚者。", "en": "Feel my presence, fool."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们的身体碰撞了。", "en": "Our bodies collide."},
        {"zh": "你逃不过我的追击。", "en": "You can’t escape my pursuit."},
        {"zh": "我们的肉体会碰撞。", "en": "Our bodies collide."},
        {"zh": "被我撞到就输了。", "en": "Collide with me and you lose."},
        {"zh": "感受我的力量，愚者。", "en": "Feel my strength, fool."},
        {"zh": "你用肩撞我，骨头响了一声。", "en": "You ram me with your shoulder, and a bone cracks."},
        {"zh": "碰撞吧，愚者。", "en": "Collide, fool."},
        {"zh": "你触碰了我，现在受罚。", "en": "You touched me, now pay the price."},
        {"zh": "我们只能碰撞一次。", "en": "We can only collide once."},
        {"zh": "我身上那些眼睛，都是诱饵。", "en": "The eyes on my body are all bait."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "和我交配吧，愚者。", "en": "Mate with me, fool."},
        {"zh": "交配是你的唯一出路。", "en": "Mating is your only escape."},
        {"zh": "和我交配，你才能存活。", "en": "Mate with me to survive."},
        {"zh": "交配吧，你注定要死。", "en": "Mate, you’re doomed to die."},
        {"zh": "交配是我的唯一目的。", "en": "Mating is my sole purpose."},
        {"zh": "和我交配，你才能不死。", "en": "Mate with me, or you’ll die."},
        {"zh": "交配吧，愚者。", "en": "Mate, fool."},
        {"zh": "这是唯一的出路。", "en": "This is your only way out."},
        {"zh": "交配，愚者，你别无选择。", "en": "Mate, fool, you have no choice."},
        {"zh": "交配吧，否则你将灭亡。", "en": "Mate, or you’ll perish."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "腐骨在腐土中生长", "en": "Corrupted bones grow in the corruption"},
        {"zh": "这皮肤散发着死气", "en": "This skin exudes decay"},
        {"zh": "黑苔覆盖着大地", "en": "Black moss covers the ground"},
        {"zh": "虚空根在黑暗中蔓延", "en": "Void roots spread in the dark"},
        {"zh": "你身上有我的食物", "en": "You carry my feast"},
        {"zh": "腐化的皮肤，我的礼物", "en": "Corrupted skin, my gift"},
        {"zh": "黑苔下的秘密", "en": "Secrets of the black moss"},
        {"zh": "黑暗中我等你", "en": "I wait for you in the dark"},
        {"zh": "腐骨是唯一救赎", "en": "Corrupted bones are the only salvation"},
        {"zh": "虚空根滋养我", "en": "Void roots nourish me"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "看我游魂之眼", "en": "Behold my wraith eyes"},
        {"zh": "你无法逃避我", "en": "You cannot escape me"},
        {"zh": "腐化的灵魂吸引我", "en": "Corrupted souls draw me"},
        {"zh": "黑暗是我的归宿", "en": "Darkness is my home"},
        {"zh": "玩家，靠近了", "en": "Player, you're close"},
        {"zh": "腐化的你，我的猎物", "en": "Corrupted, you are my prey"},
        {"zh": "游魂指引我", "en": "Wraiths guide me"},
        {"zh": "黑暗中我狩猎", "en": "I hunt in the dark"},
        {"zh": "你的气息诱惑我", "en": "Your scent lures me"},
        {"zh": "腐化的存在吸引我", "en": "Corrupted beings attract me"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "骨裂声中我起立", "en": "I rise with bone cracks"},
        {"zh": "追逐你的声音", "en": "Chase your voice"},
        {"zh": "腐化的速度是我的优势", "en": "Corruption is my speed"},
        {"zh": "黑暗中我追踪你", "en": "I track you in the dark"},
        {"zh": "你是我的，别跑", "en": "You are mine, don't run"},
        {"zh": "游魂之眼注视你", "en": "Wraith eyes watch you"},
        {"zh": "黑暗中的敌人", "en": "Enemy in the dark"},
        {"zh": "腐化的气息指引我", "en": "Corrupted scent guides me"},
        {"zh": "追逐你的脚步声", "en": "Chase your footsteps"},
        {"zh": "黑暗中的猎物", "en": "Prey in the darkness"},
        {"zh": "骨裂声越来越近。", "en": "The bone-cracking grows nearer."},
        {"zh": "你跑不过我，只差半步。", "en": "You cannot outrun me; I am half a step behind."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶声中，一只眼眸逼近你！", "en": "Hisss, an eye approaches you!"},
        {"zh": "黑暗中，它的视线拉近了！", "en": "In the dark, its gaze draws near!"},
        {"zh": "眼珠滚动，瞄准猎物！", "en": "Eyes roll, targeting prey!"},
        {"zh": "骨裂声中，它站起来了！", "en": "With a bone-cracking sound, it rises!"},
        {"zh": "黑暗的触手般的眼睛盯着你！", "en": "Dark, hand-like eyes盯着你!"},
        {"zh": "腐烂的眼睛盯着你，逼近！", "en": "Decaying eyes fix on you, closing in."},
        {"zh": "黑暗中，它的眼睛在闪烁！", "en": "In the dark, its eyes flash!"},
        {"zh": "它的视线在黑暗中拉近！", "en": "Its gaze closes in in the dark!"},
        {"zh": "它的眼睛在你周围游荡！", "en": "Its eyes wander around you!"},
        {"zh": "黑暗的触手抓住你！", "en": "Dark, hand-like tentacles grab you!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗中，它苏醒了！", "en": "It awakens in the darkness!"},
        {"zh": "腐根中，它缓缓浮现！", "en": "It rises from the rotten roots!"},
        {"zh": "黑暗中的腐根中，它苏醒！", "en": "It awakens from the dark, rotten roots!"},
        {"zh": "腐根深处，它缓缓苏醒！", "en": "It slowly awakens from the depths of the rotten roots!"},
        {"zh": "腐根中，它渐渐浮现！", "en": "It gradually emerges from the rotten roots!"},
        {"zh": "黑暗中，它开始苏醒！", "en": "It begins to awaken in the darkness!"},
        {"zh": "黑暗的腐根中，它缓缓苏醒！", "en": "It slowly awakens in the dark, rotten roots!"},
        {"zh": "腐根中，它开始浮现！", "en": "It begins to emerge from the rotten roots!"},
        {"zh": "腐根深处，它渐渐苏醒！", "en": "It slowly awakens from the depths of the rotten roots!"},
        {"zh": "黑暗中，它缓缓浮现！", "en": "It gradually emerges in the darkness!"},
        {"zh": "骨荒原上多了一个影子。", "en": "One more shadow on the bone waste."},
        {"zh": "黑苔从地缝里拱起来。", "en": "Black moss pushes up through the cracks."},
        {"zh": "我睁开第一只眼。", "en": "I open my first eye."},
        {"zh": "这里的死气把我叫醒。", "en": "The dead air here woke me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火！我好痛！", "en": "Fire! It burns!"}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从腐骨堆上滑了下来。", "en": "I slid down the heap of rotten bones."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水！我要窒息了...", "en": "Water! I'm drowning..."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉的味道如何，遭爆炸的滋味可不好受。", "en": "How does rotten flesh taste? — and the explosion makes it worse."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭钉进我的黑皮里。", "en": "The arrow sticks in my black hide."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒语打在身上，眼睛全闭上了。", "en": "The spell hits and every eye shuts at once."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没东西吃...", "en": "No food..."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "闪电！好痛...", "en": "Lightning! It hurts..."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空的黑暗...", "en": "Void's darkness..."}
      ]
    }
  }
