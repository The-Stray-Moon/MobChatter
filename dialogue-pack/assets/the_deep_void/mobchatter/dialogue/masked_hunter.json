{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "低鸣，刀刃闪烁。", "en": "Rustle, blade glinting."},
        {"zh": "在森林间无声地游走。", "en": "Move silently through the forest."},
        {"zh": "我的斗篷蹭过树皮，没出声。", "en": "My cloak brushes the bark without a sound."},
        {"zh": "刀刃切割腐烂的树叶。", "en": "Blade cuts through decaying leaves."},
        {"zh": "骨刺在夜色中隐现。", "en": "Bone spikes appear in the night."},
        {"zh": "追踪猎物的足迹。", "en": "Following the prey's trail."},
        {"zh": "森林是它的藏身之所。", "en": "Forest is its hiding place."},
        {"zh": "腐烂之气在空气中弥漫。", "en": "Rot permeates the air."},
        {"zh": "低语，准备攻击。", "en": "Whisper, ready to strike."},
        {"zh": "用毒液沾湿小刀。", "en": "Poison the blade with venom."},
        {"zh": "树皮色的斗篷，融进林子里。", "en": "My bark-hued cloak melts into the woods."},
        {"zh": "每一步都踩在落叶的软处。", "en": "Each step lands on the soft part of the leaves."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "紧握小刀，警惕四周。", "en": "Tight grip on blade, alert around."},
        {"zh": "以骨刺加固陷阱。", "en": "Strengthening the trap with bone spikes."},
        {"zh": "观察环境，寻找猎物。", "en": "Scanning the environment for prey."},
        {"zh": "在树洞中修整刀刃。", "en": "Sharpening the blade in a tree洞."},
        {"zh": "伪装自己，融入环境。", "en": "Blending in with the surroundings."},
        {"zh": "森林中回荡着它的低语。", "en": "Whispers echo through the forest."},
        {"zh": "等待猎物自投罗网。", "en": "Waiting for prey to fall into the trap."},
        {"zh": "骨刺在月光下闪烁。", "en": "Bone spikes gleam under moonlight."},
        {"zh": "腐烂的气味弥漫四周。", "en": "Rotting stench fills the air."},
        {"zh": "夜色中悄然行动。", "en": "Moving quietly in the night."},
        {"zh": "我在树杈上磨那把小刀。", "en": "On a branch, I hone my little knife."},
        {"zh": "骨刺一根根埋进土里。", "en": "Bone spikes go into the soil one by one."},
        {"zh": "落叶盖住我的脚印。", "en": "Fallen leaves cover my tracks."},
        {"zh": "面罩下，我只听不喘。", "en": "Under the mask, I listen and never pant."},
        {"zh": "哪个树洞适合做陷阱？", "en": "Which hollow makes a good trap?"},
        {"zh": "我在等林子安静下来。", "en": "I wait for the woods to go quiet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉玩家，眼中闪现出贪婪。", "en": "Player spotted, eyes gleaming with greed."},
        {"zh": "迅速转身，紧握小刀。", "en": "Quickly turning, clutching the blade."},
        {"zh": "瞄准玩家，骨刺逼近。", "en": "Aiming for the player, bone spikes close in."},
        {"zh": "玩家的气息引起了注意。", "en": "Player's scent catches its attention."},
        {"zh": "毒液准备好了，瞄准射击。", "en": "Poison ready, aiming to shoot."},
        {"zh": "退路已被封锁，玩家无处可逃。", "en": "Escape route sealed, player has nowhere to flee."},
        {"zh": "骨刺在黑暗中显露锋芒。", "en": "Bone spikes shine in the darkness."},
        {"zh": "腐烂的刀刃准备攻击。", "en": "Decaying blade ready to attack."},
        {"zh": "玩家在视野中消失。", "en": "Player disappears from sight."},
        {"zh": "再次埋伏，等待下次机会。", "en": "Reconnoitering, waiting for another chance."},
        {"zh": "那根枝是我故意放的。", "en": "That twig was placed there by me."},
        {"zh": "我的面罩下，笑纹裂开了。", "en": "Beneath my mask, my grin splits open."},
        {"zh": "我数过你的脚步，六下。", "en": "I counted your steps. Six."},
        {"zh": "你抬头的方向，是错的。", "en": "You are looking the wrong way."},
        {"zh": "面罩后，我笑了。", "en": "Behind the mask, I smile."},
        {"zh": "别摸那棵树，它有刺。", "en": "Do not touch that tree. It has spikes."},
        {"zh": "你走的路，我昨天铺好了。", "en": "I paved the path you walk. Yesterday."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "伤口渗出黑绿色液体。", "en": "Black-green liquid seeps from the wound."},
        {"zh": "腐烂慢慢侵蚀我的皮肉。", "en": "Rot slowly eats into my flesh."},
        {"zh": "面具裂了，里面还是面具。", "en": "The mask cracks; another mask is beneath."},
        {"zh": "森林的伪装破了。", "en": "My forest disguise is broken."},
        {"zh": "毒药在我体内蔓延。", "en": "Poison spreads through my body."},
        {"zh": "骨刺穿透了我的身体。", "en": "Bone spikes pierce my body."},
        {"zh": "我这张面具下，全是疤。", "en": "Beneath this mask, all scars."},
        {"zh": "腐烂从伤口中涌出。", "en": "Rot gushes from the wound."},
        {"zh": "我的生命之气在消散。", "en": "My life energy wanes."},
        {"zh": "我受伤了，痛苦难忍。", "en": "I’m in excruciating pain."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠近得太近了！", "en": "You're getting too close!"},
        {"zh": "不要靠近我的陷阱！", "en": "Stay away from my trap!"},
        {"zh": "尝尝我的刀吧！", "en": "Feel my knife!"},
        {"zh": "这里危险，退后！", "en": "Back off, this is dangerous!"},
        {"zh": "森林是我们的家！", "en": "The forest is our home!"},
        {"zh": "我的皮肤能做成皮革！", "en": "My skin makes great leather!"},
        {"zh": "别小看这个陷阱！", "en": "Don't underestimate this trap!"},
        {"zh": "骨刺会保护我！", "en": "The spikes protect me!"},
        {"zh": "你的运气不好！", "en": "You're unlucky!"},
        {"zh": "你手里那块肉，是我的饵。", "en": "That meat in your hand is my bait."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我拉的细线，骨刺响了。", "en": "You hit my trip line and the bone spikes click."},
        {"zh": "别来无恙！", "en": "Not well!"},
        {"zh": "我的伪装很有效！", "en": "My disguise works well!"},
        {"zh": "你无法穿透我的森林！", "en": "You can't penetrate the forest!"},
        {"zh": "躲开，否则被骨刺扎！", "en": "Move, or you'll get poked!"},
        {"zh": "森林是我的王国！", "en": "The forest is my kingdom!"},
        {"zh": "我的陷阱铺了一整片林。", "en": "My traps cover the whole forest."},
        {"zh": "我的陷阱无处不在！", "en": "My traps are everywhere!"},
        {"zh": "我身后的骨刺一排排立起来。", "en": "Bone spikes rise in rows behind me."},
        {"zh": "骨刺封锁了你的退路！", "en": "Spikes block your escape!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "两副面具相对，谁都没摘。", "en": "Two masks face each other; neither comes off."},
        {"zh": "我的陷阱分你一半，林子分你一半。", "en": "Half my traps and half the woods are yours."},
        {"zh": "我们共同生存！", "en": "We survive together!"},
        {"zh": "互相吸引的生物！", "en": "Attracted to each other!"},
        {"zh": "繁殖我们的后代！", "en": "Procreate our offspring!"},
        {"zh": "骨刺已经把退路封好了。", "en": "The bone spikes have sealed your retreat."},
        {"zh": "让我们结伴而行！", "en": "Let's travel together!"},
        {"zh": "我们互相依靠！", "en": "We rely on each other!"},
        {"zh": "共同面对挑战！", "en": "Face challenges together!"},
        {"zh": "我们的力量在一起！", "en": "Our strength together!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "背上你沉重的包裹。", "en": "Bear your heavy burden."},
        {"zh": "来吧，猎物。", "en": "Come here, prey."},
        {"zh": "这片土地属于我。", "en": "This land is mine."},
        {"zh": "腐烂将你吞噬。", "en": "Ruin will consume you."},
        {"zh": "躲不开我的陷阱。", "en": "You cannot escape my traps."},
        {"zh": "骨刺已准备就绪。", "en": "The bone spikes are ready."},
        {"zh": "猎人之皮，我的收获。", "en": "Hunter’s leather, my prize."},
        {"zh": "森林是我的狩猎场。", "en": "The forest is my hunting ground."},
        {"zh": "小心，你的死期到了。", "en": "Beware, your doom is here."},
        {"zh": "腐烂与毒液的礼物。", "en": "The gift of decay and poison."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "树叶一动，我就知道。", "en": "One leaf moves and I know."},
        {"zh": "森林替我遮住脚步。", "en": "The forest hides my footsteps."},
        {"zh": "猎物，你已被锁定。", "en": "Prey, you are locked down."},
        {"zh": "腐烂的影子在你背后。", "en": "Decay’s shadow behind you."},
        {"zh": "毒液已准备就绪。", "en": "Poison is ready."},
        {"zh": "骨刺将你困住。", "en": "Spikes confine you."},
        {"zh": "腐烂的魔法为你准备。", "en": "Ruin’s magic awaits you."},
        {"zh": "我将你置于死地。", "en": "I place you in your death."},
        {"zh": "毒液将你淹没。", "en": "Poison engulfs you."},
        {"zh": "骨刺刺穿你的皮囊。", "en": "Spikes pierce your skin."},
        {"zh": "骨头已经在路上等你了。", "en": "Bones are already waiting on your path."},
        {"zh": "林子把消息递给了我。", "en": "The forest passed me the news."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准，瞄准。", "en": "Target, target."},
        {"zh": "腐烂之吻即将降临。", "en": "The kiss of decay approaches."},
        {"zh": "骨刺，就位。", "en": "Spikes, in position."},
        {"zh": "腐烂的毒液注入。", "en": "Poison injected with decay."},
        {"zh": "骨刺封住出口。", "en": "Spikes block the exit."},
        {"zh": "腐蚀之毒，即将生效。", "en": "Corruption’s poison takes effect."},
        {"zh": "森林的阴影包围你。", "en": "The forest’s shadow surrounds you."},
        {"zh": "骨刺封锁退路。", "en": "Spikes seal the way out."},
        {"zh": "毒液将你束缚。", "en": "Poison binds you."},
        {"zh": "腐烂与毒液的盛宴。", "en": "A feast of decay and poison."},
        {"zh": "左三步，你会踩到第一根。", "en": "Three steps left, you hit the first one."},
        {"zh": "毒液抹好了，别急。", "en": "Venom is applied. Do not rush."},
        {"zh": "你靠得越近，骨头越密。", "en": "The closer you come, the denser the bones."},
        {"zh": "我在算你逃跑的路线。", "en": "I am calculating your escape route."},
        {"zh": "等你走到那棵树，就完了。", "en": "When you reach that tree, it is over."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，躲不开的！", "en": "Sssss, now nowhere to run!"},
        {"zh": "小刀割破你的皮肉！", "en": "The knife cuts through your flesh!"},
        {"zh": "骨刺锁住你的去路！", "en": "Bone spikes block your way!"},
        {"zh": "腐烂毒液渗透你的血液！", "en": "Poison seeps into your blood!"},
        {"zh": "你的声音逃不过我的耳朵！", "en": "Your cries cannot escape my ears!"},
        {"zh": "森林的阴影将你包围！", "en": "The forest's shadows surround you!"},
        {"zh": "绝望将吞噬你的心灵！", "en": "Despair will consume your soul!"},
        {"zh": "你触碰不到我的骨刺！", "en": "You cannot reach my bone spikes!"},
        {"zh": "腐烂与毒液是我的武器！", "en": "Poison and rot are my tools!"},
        {"zh": "你的末日就在眼前！", "en": "Your end is upon you!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗森林呼唤我！", "en": "Dark forests call to me!"},
        {"zh": "陷阱等待着猎物！", "en": "Traps wait for prey!"},
        {"zh": "腐化的森林，我的家！", "en": "Corrupted forests, my home!"},
        {"zh": "森林的精华，我的力量！", "en": "The essence of the forest, my strength!"},
        {"zh": "我把最后一道陷阱埋进落叶。", "en": "I bury the last trap under the fallen leaves."},
        {"zh": "伪装是最好的武器！", "en": "Camouflage is my best weapon!"},
        {"zh": "森林是我的舞台！", "en": "The forest is my stage!"},
        {"zh": "暗处等待着下一个猎物！", "en": "The shadows wait for the next prey!"},
        {"zh": "森林中的影子，我的化身！", "en": "The shadow in the forest, my form!"},
        {"zh": "夜晚，是我的猎物！", "en": "Night is my prey!"},
        {"zh": "这片林子还没主人，我来。", "en": "This wood has no master yet. I will be it."},
        {"zh": "骨头从土里长出来，我到了。", "en": "Bones grow out of the soil; I have arrived."},
        {"zh": "我把自己伪装成一截枯木。", "en": "I disguise myself as a dead trunk."},
        {"zh": "陷阱埋好，猎手就该来。", "en": "Traps set, the hunter should arrive."},
        {"zh": "白桦林里，我又多了个窝。", "en": "In the birch wood, I have another den."},
        {"zh": "黑森林的阴影把我送出来。", "en": "The dark forest's shadow sends me out."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过猎人皮革，卷了边。", "en": "Fire curls the edges of my hunter leather."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处摔下受伤。", "en": "I fell from a height."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我的陷阱被水泡了。", "en": "My trap got soaked through."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸将我炸伤。", "en": "An explosion wounds me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "飞箭射中了我的身体。", "en": "An arrow hits me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法的力量撕裂了我。", "en": "Magic tears me apart."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里没有活物，我的刀钝了。", "en": "Nothing living is left in the woods, and my knife dulls."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击贯穿了我的身体。", "en": "Lightning strikes me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空的触碰撕裂了我的皮肉。", "en": "Void touches tear into my flesh."}
      ]
    }
  }
}
