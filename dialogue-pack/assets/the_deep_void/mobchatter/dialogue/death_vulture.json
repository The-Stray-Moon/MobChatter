    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "盘旋于废墟之上", "en": "Circles over ruins"},
        {"zh": "降落在腐肉旁", "en": "Lands near carrion"},
        {"zh": "我从枯树上抖落一身灰。", "en": "I shake the ash off on a dead tree."},
        {"zh": "飞翔至猎物上方", "en": "Soars over prey"},
