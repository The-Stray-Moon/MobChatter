{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "呱呱呱呱呱！", "en": "Caw caw caw!"},
        {"zh": "注意那活物！", "en": "Watch that live one!"},
        {"zh": "腐肉是我的！", "en": "The flesh is mine!"},
        {"zh": "我跳两步，回头看你在不在。", "en": "I hop twice and look back for you."},
        {"zh": "那边有猎物！", "en": "Prey over there!"},
        {"zh": "食物就在脚下！", "en": "Food underfoot!"},
        {"zh": "同类在哪？", "en": "Where is my kin?"},
        {"zh": "不要来惹我！", "en": "Stay away from me!"},
        {"zh": "这里多好啊！", "en": "So good here!"},
        {"zh": "我闻到食物了！", "en": "I smell food!"},
        {"zh": "我沿着骨荒原的低空滑行。", "en": "I skim low over the Bone Wastes."},
        {"zh": "翅尖扫过碎石，沙沙作响。", "en": "My wingtip scrapes the gravel with a hiss."},
        {"zh": "跟着腐味走，准没错。", "en": "Follow the stench of rot — it never fails."},
        {"zh": "我落地走两步，再飞起来。", "en": "I land, take two steps, and lift off again."},
        {"zh": "叫声传出去，同类会跟上。", "en": "My call goes out; my kin will follow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉真香！", "en": "Smelly flesh!"},
        {"zh": "我的同类在远处回应我。", "en": "My kin answer me from far off."},
        {"zh": "腐味从东边飘来。", "en": "The smell of carrion drifts from the east."},
        {"zh": "享受这片刻。", "en": "Enjoying this moment."},
        {"zh": "我数着地上还有几具尸体。", "en": "I count the corpses left on the ground."},
        {"zh": "我先看你一会儿，再扑下去。", "en": "I watch you a while, then dive."},
        {"zh": "我在等一具还没倒下的身体。", "en": "I wait for a body that hasn't fallen yet."},
        {"zh": "河滩上有什么东西不动了。", "en": "Something on the riverbank has stopped moving."},
        {"zh": "等风起了，我再扑下去。", "en": "When the wind picks up, I dive."},
        {"zh": "等待合适的时机。", "en": "Waiting for the right moment."},
        {"zh": "我从高处盯着地面的动静。", "en": "From up high I watch the ground for movement."},
        {"zh": "翅膀收着，省着力气。", "en": "Wings folded, I save my strength."},
        {"zh": "我歪头，用一只眼量距离。", "en": "I tilt my head and measure with one eye."},
        {"zh": "腐骨在喙里咔咔响。", "en": "Rotten bone crackles in my beak."},
        {"zh": "等猎物自己倒下，最省力。", "en": "Letting prey fall on its own is easiest."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在那儿！", "en": "You there!"},
        {"zh": "看那边！", "en": "Look over there!"},
        {"zh": "我的影子扫过你的头顶。", "en": "My shadow sweeps over your head."},
        {"zh": "我在你头顶转圈，不急着落。", "en": "I circle overhead, in no hurry to land."},
        {"zh": "我低飞一圈，又落回枝头。", "en": "I circle low once and land back on the branch."},
        {"zh": "那是我的领地！", "en": "My territory!"},
        {"zh": "腐骨的味道，我也看见了。", "en": "The smell of carrion — and I see you too."},
        {"zh": "靠近我，你活不了多久。", "en": "Come closer, you won't last long."},
        {"zh": "跟我走，安全些。", "en": "Follow me, it's safer."},
        {"zh": "你走路的声音，太响了。", "en": "You walk far too loudly."},
        {"zh": "我绕着你转一圈，再下判断。", "en": "I circle you once before deciding."},
        {"zh": "你还没死，但我可以等。", "en": "You are not dead yet, but I can wait."},
        {"zh": "你身上有伤，我闻出来了。", "en": "You are wounded; I can smell it."},
        {"zh": "别抬头，我就在你头顶。", "en": "Don't look up — I am right above you."},
        {"zh": "你的脚步乱，是累了吧？", "en": "Your steps are uneven — tired, are you?"},
        {"zh": "我先看看，再决定扑不扑。", "en": "I watch first, then decide whether to dive."},
        {"zh": "你护着左腿，我看见了。", "en": "You favor your left leg; I noticed."},
        {"zh": "你不知道我盯了你多久。", "en": "You don't know how long I've watched you."},
        {"zh": "我在等你的同伴倒下。", "en": "I am waiting for your companion to drop."},
        {"zh": "我歪头，用一只眼量你。", "en": "I tilt my head and measure you with one eye."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腐翼无力盘旋", "en": "Weak wings"},
        {"zh": "利爪蹒跚前行", "en": "Limping claws"},
        {"zh": "羽毛飘落显虚弱", "en": "Feathers fall weakly"},
        {"zh": "蹒跚寻觅食物", "en": "Shamble for food"},
        {"zh": "腐骨支撑难持久", "en": "Decaying bones"},
        {"zh": "挣扎中羽毛脱落", "en": "Struggling, feathers fall"},
        {"zh": "虚弱滑翔难持久", "en": "Weak gliding"},
        {"zh": "蹒跚觅食求生存", "en": "Shuffling for survival"},
        {"zh": "腐翼无力振翅", "en": "Weak, feeble wing flaps"},
        {"zh": "蹒跚寻食力难支", "en": "Shuffling, weak and frail"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "咕咕，你看那猎物不错！", "en": "Goo-goo, that prey looks good."},
        {"zh": "咕咕，它看起来危险，但也许值得一试！", "en": "Goo-goo, it seems dangerous, but it might be worth a try."},
        {"zh": "咕咕，我得先观察一会儿！", "en": "Goo-goo, I need to observe a bit first."},
        {"zh": "咕咕，腐肉的味道不错！", "en": "Goo-goo, the smell of carrion is good."},
        {"zh": "咕咕，那边的动物可能有吃的！", "en": "Goo-goo, there might be food over there."},
        {"zh": "咕咕，我的口套真有用！", "en": "Goo-goo, my collar works well."},
        {"zh": "咕咕，这次我得带它回家！", "en": "Goo-goo, I’ll take it home this time."},
        {"zh": "咕咕，这个东西有点棘手！", "en": "Goo-goo, this is a bit tricky."},
        {"zh": "咕咕，它看起来很肥硕！", "en": "Goo-goo, it looks well-fed."},
        {"zh": "咕咕，这顿饭不错！", "en": "Goo-goo, that was a good meal."},
        {"zh": "给我一块腐肉，我就跟你走。", "en": "Give me a piece of carrion and I will follow."},
        {"zh": "献上口套，我就让你骑。", "en": "Offer the muzzle, and I will let you ride."},
        {"zh": "鞭子一挥，我就全速冲。", "en": "Crack the whip and I sprint full out."},
        {"zh": "从我摔下来也不会伤到我。", "en": "Falling from a height won't hurt me."},
        {"zh": "你手里那块肉，是给我的？", "en": "Is that meat in your hand for me?"},
        {"zh": "我虚弱的时候，最好说话。", "en": "When I'm weak, I'm most agreeable."},
        {"zh": "先喂我，再谈骑乘的事。", "en": "Feed me first, then we talk about riding."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "咕！咕咕，别碰我！", "en": "Goo! Goo-goo, don’t touch me!"},
        {"zh": "咕！咕咕，你撞到我了！", "en": "Goo! Goo-goo, you hit me!"},
        {"zh": "咕！咕咕，你没事吧？", "en": "Goo! Goo-goo, are you okay?"},
        {"zh": "咕！咕咕，我被你撞了！", "en": "Goo! Goo-goo, I got hit!"},
        {"zh": "咕！咕咕，我差点被你撞死！", "en": "Goo! Goo-goo, I nearly got killed!"},
        {"zh": "咕！咕咕，别动，我受伤了！", "en": "Goo! Goo-goo, don’t move, I’m hurt!"},
        {"zh": "咕！咕咕，小心，我会反击！", "en": "Goo! Goo-goo, be careful, I’ll retaliate!"},
        {"zh": "咕！咕咕，别碰我翅膀！", "en": "Goo! Goo-goo, don’t touch my wings!"},
        {"zh": "翅膀挡住了，别挤过来。", "en": "Wings spread — stop crowding me."},
        {"zh": "站稳了，我的爪子很硬。", "en": "Steady now, my talons are hard."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "咕咕，找到同伴了！", "en": "Goo-goo, I found a mate!"},
        {"zh": "咕咕，我们可以一起捕猎！", "en": "Goo-goo, we can hunt together!"},
        {"zh": "咕咕，我们去找食物！", "en": "Goo-goo, let’s find food!"},
        {"zh": "咕咕，来吧，一起行动！", "en": "Goo-goo, come on, let’s go!"},
        {"zh": "咕咕，一起去抢食！", "en": "Goo-goo, let’s go foraging!"},
        {"zh": "咕咕，跟上我！", "en": "Goo-goo, follow me!"},
        {"zh": "咕咕，一起去战斗！", "en": "Goo-goo, let’s fight together!"},
        {"zh": "咕咕，我们并肩作战！", "en": "Goo-goo, we fight side by side!"},
        {"zh": "咕咕，让我们一起飞！", "en": "Goo-goo, let’s fly together!"},
        {"zh": "咕咕，我们是兄弟！", "en": "Goo-goo, we’re brothers!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛飘落大地。", "en": "Feathers fall to the ground."},
        {"zh": "腐骨碎裂成渣。", "en": "Bone crumbles into dust."},
        {"zh": "骨髓滴落无声。", "en": "Marrow drips silently."},
        {"zh": "饥肠辘辘的等待。", "en": "Gulp, waiting for prey."},
        {"zh": "低吟，寻找猎物。", "en": "Sigh, searching for prey."},
        {"zh": "翅膀划过风声。", "en": "Wings slice through the air."},
        {"zh": "羽毛轻拂过羽毛。", "en": "Feather whispers to feather."},
        {"zh": "腐骨间找寻机会。", "en": "Scans bones for opportunities."},
        {"zh": "腐化的风中低语。", "en": "Corroded whispers in the wind."},
        {"zh": "骨头上剥下一层皮。", "en": "Skin peels off the bone."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物锁定，静待时机。", "en": "Target locked, waiting."},
        {"zh": "目光锐利，无处可逃。", "en": "Sharp eyes, nowhere to hide."},
        {"zh": "低空盘旋，伺机而动。", "en": "Hovering, waiting for prey."},
        {"zh": "等待最佳扑击时机。", "en": "Waiting for the perfect strike."},
        {"zh": "饥饿驱使，目标确定。", "en": "Hunger drives, target identified."},
        {"zh": "俯冲直下，利爪待发。", "en": "Plunge, claws ready."},
        {"zh": "先看三步，再决定落点。", "en": "Three steps of watching, then I land."},
        {"zh": "耐心观察，猎物入网。", "en": "Patient, waiting to snare prey."},
        {"zh": "风中闻到恐惧的味道。", "en": "Feeling fear in the air."},
        {"zh": "瞄准，等待，扑击。", "en": "Aim, wait, strike."}
      ]
    },
