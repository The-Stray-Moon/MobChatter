  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "无声滑行，阴影飘动。", "en": "Silent glide, shadow drifts."},
        {"zh": "虚空之翼轻拍。", "en": "Void wings flap lightly."},
        {"zh": "如同幻影般移动。", "en": "Moves like a phantom."},
        {"zh": "漂浮于水面，无声。", "en": "Floats on water, silently."},
        {"zh": "阴影在水中游动。", "en": "Shadow swims in water."},
        {"zh": "轻盈掠过水面。", "en": "Gently glides over water."},
        {"zh": "缓慢飘动，宛如梦。", "en": "Slow drift, like a dream."},
        {"zh": "水面下无声滑行。", "en": "Silently glides underwater."},
        {"zh": "如同影子般移动。", "en": "Moves like a shadow."},
        {"zh": "我贴着河床滑，水纹不动。", "en": "I slide along the riverbed without rippling the water."},
        {"zh": "虚空凝成鳍，我慢慢摆。", "en": "The void forms fins; I beat them slowly."},
        {"zh": "我穿过水草，草不弯。", "en": "I pass through the weeds and they don't bend."},
        {"zh": "沙底的影子，就是我。", "en": "That shadow on the sand is me."},
        {"zh": "我贴着暗处，一寸寸挪。", "en": "Hugging the dark, I shift an inch at a time."},
        {"zh": "没有呼吸，我也在前进。", "en": "I have no breath, yet I keep moving."},
        {"zh": "水底的裂缝，我钻得进。", "en": "I can slip into cracks in the riverbed."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在沙底，连水都不惊。", "en": "I hover above the sand without stirring the water."},
        {"zh": "静静漂浮在水中。", "en": "Floats quietly in water."},
        {"zh": "平静地栖息于海底。", "en": "Rests calmly on the seafloor."},
        {"zh": "无声中等待猎物。", "en": "Silent, waiting for prey."},
        {"zh": "静静游弋在黑暗中。", "en": "Swims quietly in the dark."},
        {"zh": "栖息于暗处。", "en": "Nests in shadows."},
        {"zh": "静静地潜伏着。", "en": "Lurks quietly."},
        {"zh": "在水中无声中游动。", "en": "Gently glides in water."},
        {"zh": "静静躺在沙底。", "en": "Lies quietly on sand."},
        {"zh": "栖息于深海。", "en": "Nests in the deep sea."},
        {"zh": "我不饿，也不累，只是等。", "en": "I am not hungry or tired. I simply wait."},
        {"zh": "我悬在水中，像块黑影。", "en": "I hang in the water like a blot of shadow."},
        {"zh": "没有念头，只有水声。", "en": "No thoughts, only the sound of water."},
        {"zh": "我就这么待着，久到忘了。", "en": "I stay like this, long enough to forget."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有眼睛，却朝你转过来。", "en": "I have no eyes, yet I turn toward you."},
        {"zh": "注意到你的存在。", "en": "Notices you."},
        {"zh": "我没有思想，只有本能。", "en": "I have no mind. Only instinct."},
        {"zh": "目光穿透水面。", "en": "Gaze pierces the water."},
        {"zh": "察觉你的行动。", "en": "Detects your movement."},
        {"zh": "注视你很久。", "en": "Stares for a long time."},
        {"zh": "寻找你的身影。", "en": "Scans for your form."},
        {"zh": "盯着你看得更紧。", "en": "Stares even harder."},
        {"zh": "钓线一垂，我的形状清楚了。", "en": "The line drops, and my shape sharpens."},
        {"zh": "你可以叫我虚无，也可以什么都不叫。", "en": "You may call me void, or nothing at all."},
        {"zh": "你搅动了水，我感到了。", "en": "You stirred the water. I felt it."},
        {"zh": "钓线垂下来，我抬了抬眼。", "en": "A fishing line drops; I lift my eyes."},
        {"zh": "你的影子投进水里，很亮。", "en": "Your shadow falls on the water, bright."}
      ]
    },
