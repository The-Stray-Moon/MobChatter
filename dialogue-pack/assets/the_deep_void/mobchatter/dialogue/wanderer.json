    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空之中诞生！", "en": "Born in the void!"},
        {"zh": "荒地上的阴影！", "en": "Shadow on the wasteland!"},
        {"zh": "阴莓能驯服我！", "en": "Sneezberries tame me!"},
        {"zh": "钻入地面消失！", "en": "Vanish into the ground!"},
