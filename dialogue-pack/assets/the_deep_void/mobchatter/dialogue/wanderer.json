      "lines": [
        {"zh": "嘶嘶作响，啃食黑苔。", "en": "Sssss, munching on black moss."},
        {"zh": "低垂长颈，咀嚼腐草。", "en": "Lower neck, chomping decayed grass."},
        {"zh": "啃咬腐骨，享受美食。", "en": "Biting into rotten bones, savoring the meal."},
        {"zh": "啃食阴莓，变得更强。", "en": "Eating darkberries, feeling stronger."},
        {"zh": "阴沉叫声，警告入侵者。", "en": "Muffled sound, warning intruders."},
        {"zh": "啃咬腐草，慢慢恢复。", "en": "Eating decayed grass, slowly regenerating."},
        {"zh": "用长颈触碰黑苔。", "en": "Using long neck to touch black moss."},
        {"zh": "低头啃食腐骨。", "en": "Lowering head to munch on rotten bones."},
        {"zh": "啃咬阴莓，补充体力。", "en": "Eating darkberries, restoring stamina."},
        {"zh": "发出嘶嘶声，吸引同伴。", "en": "Sssss, drawing in companions."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我脖子上挂着的，是骨头。", "en": "What hangs from my neck is bone."},
        {"zh": "追踪者靠近，警惕性提高。", "en": "Increased alertness as trackers approach."},
