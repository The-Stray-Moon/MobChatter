{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "长颈挥动，声震虚空。", "en": "Long neck sways, echoing in the void."},
        {"zh": "阴莓丛中游走，虚空之息。", "en": "Wanders through blueberries, the void's breath."},
        {"zh": "长颈伸展，阴暗荒地。", "en": "Long neck stretches, in dark wastelands."},
        {"zh": "荒芜之地游荡，无依无靠。", "en": "Wanders in desolation, alone."},
        {"zh": "钻入大地，黑苔印记。", "en": "Dives into the ground, leaving black moss."},
        {"zh": "注视脚下，寻找阴莓。", "en": "Stares at the ground, searching for blueberries."},
        {"zh": "长颈颤动，虚空中行。", "en": "Long neck trembles, moving in the void."},
        {"zh": "阴莓之食，虚空之魂。", "en": "Eats blueberries, carries void's soul."},
        {"zh": "荒芜之地徘徊，长颈孤影。", "en": "Wanders in desolation, long neck alone."},
        {"zh": "黑苔标记，腐草遗落。", "en": "Black moss marks, corrupt grass falls."},
        {"zh": "长颈探进雾里又收回。", "en": "My long neck reaches into the mist and back."},
        {"zh": "骨节随步伐轻轻作响。", "en": "My joints click softly with each step."},
        {"zh": "沿着黑苔找阴莓。", "en": "Following the black moss to find gloomberries."},
        {"zh": "孤身穿过整片荒地。", "en": "Crossing the whole waste alone."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "骨架静立，虚空之息。", "en": "Bones stand still, void's breath."},
        {"zh": "游荡荒野，长颈闲游。", "en": "Wanders in the wasteland, long neck at ease."},
        {"zh": "阴莓为食，虚空之灵。", "en": "Blueberries for food, void's spirit."},
        {"zh": "荒地游荡，长颈静默。", "en": "Wanders in wasteland, long neck silent."},
        {"zh": "黑苔为伴，虚空之居。", "en": "Black moss for company, void's dwelling."},
        {"zh": "游荡荒芜，长颈独立。", "en": "Wanders in desolation, long neck alone."},
        {"zh": "长颈站立，荒地之灵。", "en": "Long neck stands, wasteland spirit."},
        {"zh": "阴莓之食，虚空之梦。", "en": "Eats blueberries, void's dream."},
        {"zh": "荒地独游，长颈闲适。", "en": "Wanders alone in wasteland, long neck at ease."},
        {"zh": "黑苔覆盖，腐草残留。", "en": "Black moss covers, corrupt grass remains."},
        {"zh": "远处有同类，我该走了。", "en": "Another of my kind is near. I should go."},
        {"zh": "阴莓的酸味还在嘴里。", "en": "The sourness of gloomberries lingers."},
        {"zh": "风穿过骨架发出低音。", "en": "Wind hums through my bones."},
        {"zh": "荒地太静，我数骨头。", "en": "The waste is too quiet. I count bones."},
        {"zh": "长颈骨架站定，虚空在骨缝里流。", "en": "My long-necked frame stands still; the void flows between my bones."},
        {"zh": "蹲下来，让长颈歇会。", "en": "Crouching to rest my long neck."},
        {"zh": "我在等雾散开。", "en": "I am waiting for the fog to lift."},
        {"zh": "虚空从不催我。", "en": "The void never hurries me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "长颈转动，盯住你。", "en": "Long neck turns, staring at you."},
        {"zh": "追踪你，荒地之影。", "en": "Tracks you, wasteland shadow."},
        {"zh": "长颈伸缩，注视玩家。", "en": "Long neck extends, staring at the player."},
        {"zh": "你被注视，荒地之灵。", "en": "You are watched, wasteland spirit."},
        {"zh": "长颈警惕，荒野游荡。", "en": "Long neck alert, wandering the wasteland."},
        {"zh": "注视玩家，长颈无言。", "en": "Stares at the player, long neck silent."},
        {"zh": "你被长颈注视，荒地荒凉。", "en": "You are watched by the long neck, wasteland bleak."},
        {"zh": "长颈望向你，荒地之息。", "en": "Long neck looks at you, wasteland's breath."},
        {"zh": "注视玩家，荒地孤影。", "en": "Stares at the player, wasteland's solitary figure."},
        {"zh": "长颈盯住，荒地之魂。", "en": "Long neck focuses, wasteland's soul."},
        {"zh": "你把阴莓举起来了。", "en": "You've raised a gloomberry."},
        {"zh": "你要骑我上路吗？", "en": "Would you ride me onward?"},
        {"zh": "别拉我的长颈。", "en": "Don't tug at my long neck."},
        {"zh": "我记得你喂我的那颗阴莓。", "en": "I remember the gloom berry you fed me."},
        {"zh": "你身上有活物的潮气。", "en": "You carry the damp smell of the living."},
        {"zh": "你追不上我的步子。", "en": "You will not match my stride."},
        {"zh": "坐稳，别掉下去。", "en": "Sit tight. Don't fall off."},
        {"zh": "你想看黑苔吗？", "en": "Do you want to see the black moss?"},
        {"zh": "长颈伸出来，你的脚步太响。", "en": "My long neck stretches, your steps are too loud."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "骨骼吱吱作响", "en": "Joints creak."},
        {"zh": "骨髓在流动", "en": "Marrow flows."},
        {"zh": "骨头咔咔响", "en": "Bones crack."},
        {"zh": "干枯的身体颤抖", "en": "Dry body trembles."},
        {"zh": "长颈摇晃不停", "en": "Long neck shivers."},
        {"zh": "腐草缠绕我", "en": "Corruption wraps me."},
        {"zh": "我的骨架吱吱作响", "en": "My bones creak."},
        {"zh": "风吹过我的长颈", "en": "Wind rattles my neck."},
        {"zh": "我摇摇欲坠", "en": "I sway."},
        {"zh": "我几乎站立不住", "en": "I stagger nearly fall."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠近了，我长颈伸向你。", "en": "You come close, my long neck reaches out."},
        {"zh": "阴莓果是我的食物，尝尝？", "en": "Moss berries are my food, try some?"},
        {"zh": "这片虚空是我的领地。", "en": "This void is my domain."},
        {"zh": "钻入黑苔，消失于地。", "en": "Sink into the black moss, vanish."},
        {"zh": "你触碰了我，我会移动。", "en": "You touch me, I move."},
        {"zh": "阴暗中寻找我的长颈。", "en": "Seek my long neck in the dark."},
        {"zh": "阳光下，我隐身于黑苔。", "en": "I blend into the black moss under the sun."},
        {"zh": "我的骨架在风中摇曳。", "en": "My bones sway in the wind."},
        {"zh": "阴莓能让我暂时飞行。", "en": "Moss berries let me fly briefly."},
        {"zh": "黑暗中我成为你的噩梦。", "en": "I am your nightmare in the dark."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们碰撞，你受阻。", "en": "We collide, you are stopped."},
        {"zh": "我的长颈撞碎你。", "en": "My long neck breaks you."},
        {"zh": "虚空祝福阻止追踪者。", "en": "Void blessing stops the pursuer."},
        {"zh": "你撞上了我的骨墙。", "en": "You hit my bone wall."},
        {"zh": "碰撞中你无法接近。", "en": "Collision keeps you away."},
        {"zh": "我的骨架阻挡你的路。", "en": "My bones block your path."},
        {"zh": "我们相撞，你退后。", "en": "We collide, you retreat."},
        {"zh": "长颈挥动，你受伤害。", "en": "Long neck swings, you are hurt."},
        {"zh": "碰撞阻止你的追踪。", "en": "Collision stops your pursuit."},
        {"zh": "我用长颈撞退你。", "en": "I push you back with my long neck."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同类相遇，我钻入地底。", "en": "When mates meet, I sink into the ground."},
        {"zh": "黑苔覆盖我们。", "en": "Black moss covers us."},
        {"zh": "地下相遇，我们繁衍。", "en": "We mate underground."},
        {"zh": "黑苔见证我们的相遇。", "en": "Black moss witnesses our meeting."},
        {"zh": "钻入黑苔，我们繁衍。", "en": "Sink into the black moss, we mate."},
        {"zh": "同类相见，黑苔生长。", "en": "When mates meet, black moss grows."},
        {"zh": "地下相遇，我留下黑苔。", "en": "We meet underground, I leave black moss."},
        {"zh": "黑苔是我们的见证。", "en": "Black moss is our witness."},
        {"zh": "同类相遇，地下繁衍。", "en": "When mates meet, we mate underground."},
        {"zh": "黑苔覆盖，我们繁衍。", "en": "Black moss covers us, we mate."}
      ]
    },
    "pickup": {
