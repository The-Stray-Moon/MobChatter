    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "尖啸一声！", "en": "A piercing screech!"},
        {"zh": "骨爪挥舞！", "en": "Claws swing!"},
        {"zh": "我从你脚下的土里拱出。", "en": "I burst up from the soil under you."},
