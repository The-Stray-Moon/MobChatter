{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "蠕动前行，发出咕噜声", "en": "Creeps forward, making gurgle sounds"},
        {"zh": "眼中闪烁绿光，缓缓移动", "en": "Green eyes glow, moving slowly"},
        {"zh": "皮肤上脓球滚动，嘶嘶作响", "en": "Pus balls roll, hissing softly"},
        {"zh": "身体扭动，寻找猎物", "en": "Body writhes, seeking prey"},
        {"zh": "触须轻轻触碰，发出嗡嗡声", "en": "Antennae touch, buzzing gently"},
        {"zh": "发出咕噜咕噜的低吼", "en": "Grunts softly, gurgle gurgle"},
        {"zh": "凝视前方，慢慢挪动", "en": "Staring ahead, moving slowly"},
        {"zh": "触角轻挥，寻找目标", "en": "Antennae wave, seeking target"},
        {"zh": "缓慢行进，警惕地观察", "en": "Moving slowly, vigilant"},
        {"zh": "转动身体，搜寻声音来源", "en": "Rotates body, seeking source"},
        {"zh": "眼睛一颗颗转，身体才挪一寸。", "en": "Each eye turns and my body moves one inch."},
        {"zh": "脚步声像湿肉拍在石上。", "en": "My steps sound like wet meat on stone."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静站立，眼睛不停转动", "en": "Standing still, eyes constantly moving"},
        {"zh": "凝视天空，仿佛在思考", "en": "Staring at the sky, seemingly thinking"},
        {"zh": "触须静止不动，等待猎物", "en": "Antennae still, waiting for prey"},
        {"zh": "缓缓呼吸，似乎在沉思", "en": "Breathing slowly, seemingly in thought"},
        {"zh": "凝视远方，眼神空洞", "en": "Staring into the distance, hollow eyes"},
        {"zh": "静静站立，注视着周围", "en": "Standing still, watching around"},
        {"zh": "触须轻轻颤动，等待机会", "en": "Antennae gently quiver, waiting for chance"},
        {"zh": "缓缓扭动身体，显得沉思", "en": "Body slowly writhes, in thought"},
        {"zh": "静静站立，观察四周", "en": "Standing still, observing surroundings"},
        {"zh": "凝视远方，似乎在等待", "en": "Staring into the distance, waiting"},
        {"zh": "我把眼睛分到四面墙上。", "en": "I spread my eyes across four walls."},
        {"zh": "脓球在皮下慢慢滚。", "en": "Pus boils roll slowly under my skin."},
        {"zh": "密室里没有声音，只有我看着。", "en": "The chamber is silent; only I am watching."},
        {"zh": "我的瞳孔一张一合，像呼吸。", "en": "My pupils open and close like breathing."},
        {"zh": "我缓缓转了一圈，没看见尽头。", "en": "I turn slowly and see no end."},
        {"zh": "血肉在墙上又长厚了一层。", "en": "The flesh on the walls thickens another layer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "发现玩家，眼中绿光大亮", "en": "Player spotted, eyes glow bright green"},
        {"zh": "视线锁定玩家，全身紧绷", "en": "Player in sight, body tenses up"},
        {"zh": "我的脓球在掌心转了一圈。", "en": "A pus ball turns once in my palm."},
        {"zh": "发出嘶嘶声，准备攻击", "en": "Hissing, ready to attack"},
        {"zh": "眼神凶狠，缓缓靠近", "en": "Staring menacingly, slowly approaching"},
        {"zh": "眼中绿光闪烁，准备发动攻击", "en": "Green eyes flicker, ready to attack"},
        {"zh": "眼神警惕，观察玩家动作", "en": "Eyes alert, watching player"},
        {"zh": "发出嘶嘶声，紧张地盯着玩家", "en": "Hissing, staring intently at player"},
        {"zh": "眼神凶恶，准备战斗", "en": "Evil eyes, preparing to fight"},
        {"zh": "眼神锐利，锁定目标", "en": "Sharp eyes, locking on target"},
        {"zh": "一百只眼同时落在你身上。", "en": "A hundred eyes settle on you at once."},
        {"zh": "我在你身上看到了裂缝。", "en": "I see the cracks inside you."},
        {"zh": "你看的不是我，是我的眼。", "en": "You are not looking at me, but at my eyes."},
        {"zh": "你的影子在这里也归我管。", "en": "Even your shadow answers to me here."},
        {"zh": "我把最中间那只眼留给你。", "en": "I keep the center eye for you."},
        {"zh": "你被看得太久了，还不走？", "en": "Watched this long and still not leaving?"},
        {"zh": "喉咙深处，我笑了一声。", "en": "Somewhere deep in my throat, I laugh."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "肉身受损，视线模糊。", "en": "Body damaged, vision blurry."},
        {"zh": "血肉撕裂，痛楚难忍。", "en": "Fleshy tears, agony unbearable."},
        {"zh": "触感缺失，痛苦难当。", "en": "Sensory loss, pain excruciating."},
        {"zh": "触碰伤痕，痛入骨髓。", "en": "Touched wounds, pain bone-deep."},
        {"zh": "血肉模糊，痛楚不止。", "en": "Fleshy haze, pain relentless."},
        {"zh": "痛楚袭来，难以忍受。", "en": "Pain waves, unbearable."},
        {"zh": "血肉疼痛，视线模糊。", "en": "Fleshy pain, vision blurry."},
        {"zh": "肉身受伤，疼痛难忍。", "en": "Body injured, pain intense."},
        {"zh": "触感缺失，痛如刀割。", "en": "Sensory loss, pain slicing."},
        {"zh": "一只眼睛爆了，我更恨你。", "en": "One of my eyes bursts; now I hate you more."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "注视你直至灵魂枯竭。", "en": "Watch you until your soul withers."},
        {"zh": "你身上的每一块肉都是我的猎物。", "en": "Every piece of flesh on you is my prey."},
        {"zh": "血肉是我永恒的滋养。", "en": "Blood and flesh are my eternal sustenance."},
        {"zh": "你的恐惧滋养我的力量。", "en": "Your fear feeds my power."},
        {"zh": "品尝你的肉，感受你的痛苦。", "en": "Savor your flesh, feel your pain."},
        {"zh": "我的百只眼一起转向你。", "en": "My hundred eyes turn to you at once."},
        {"zh": "让我的触手缠绕你。", "en": "Let my tendrils ensnare you."},
        {"zh": "无数只眼一起睁开。", "en": "Countless eyes open at once."},
        {"zh": "享受死亡的滋味吧。", "en": "Enjoy the taste of death."},
        {"zh": "注视我，你会变成我。", "en": "Stare at me, and you will become me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我用撞墙的力量唤醒牙齿。", "en": "I awaken my teeth with wall collisions."},
        {"zh": "用撞墙发出冲击。", "en": "Impact with wall collisions."},
        {"zh": "撞击，直到牙齿出现。", "en": "Collide until the teeth appear."},
        {"zh": "墙壁是我的武器。", "en": "Walls are my weapon."},
        {"zh": "撞击，感受痛苦。", "en": "Collide and feel pain."},
        {"zh": "撞墙，召唤我的牙齿。", "en": "Collide to summon my teeth."},
        {"zh": "用撞墙攻击你。", "en": "Attack you with wall collisions."},
        {"zh": "我的牙齿在墙上。", "en": "My teeth are on the walls."},
        {"zh": "撞击，释放我的力量。", "en": "Collide to release my power."},
        {"zh": "墙壁上，我的牙齿等待。", "en": "On the walls, my teeth wait."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "注视我，你将与我同化。", "en": "Stare at me, and you will become one with me."},
        {"zh": "我们共享同一灵魂。", "en": "We share the same soul."},
        {"zh": "让我们结合，成为一体。", "en": "Let us combine, become one."},
        {"zh": "我的眼会一眨不眨看你。", "en": "My eyes will watch you without blinking."},
        {"zh": "与我结合，体验永恒。", "en": "Join me, and experience eternity."},
        {"zh": "我们的力量将更强大。", "en": "Our strength will be greater together."},
        {"zh": "你是唯一配得上我的。", "en": "You are the only one worthy of me."},
        {"zh": "与我结合，享受生命。", "en": "Join me, and enjoy life."},
        {"zh": "让我们共同存在。", "en": "Let us coexist."},
        {"zh": "我们是一体的。", "en": "We are one."}
      ]
    },
