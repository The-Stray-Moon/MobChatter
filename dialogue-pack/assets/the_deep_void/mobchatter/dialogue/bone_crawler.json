{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "骨屑轻扬，我行于白骨间。", "en": "Bone dust rises as I crawl."},
        {"zh": "骨块间跳跃，无声无息。", "en": "I leap between bones, soundless."},
        {"zh": "骨缝中穿梭，无形无状。", "en": "I weave through the bones, formless."},
        {"zh": "骨块下隐匿，安然无恙。", "en": "Safe beneath the bones I hide."},
        {"zh": "灰甲虫群中，我无声行。", "en": "I move in the silence of bone beetles."},
        {"zh": "无声捕猎，骨中潜行。", "en": "I hunt silently in the bones."},
        {"zh": "骨块上跳跃，骨屑纷飞。", "en": "I leap, bone dust rises."},
        {"zh": "白骨间跳跃，无声捕食。", "en": "I leap among bones, silent and hungry."},
        {"zh": "骨块上隐形，等待猎物。", "en": "I vanish on bones, waiting."},
        {"zh": "骨缝中隐匿，静待时机。", "en": "I hide in bone crevices, waiting."},
        {"zh": "六足叩着骨面，细碎作响。", "en": "Six feet tap the bone, clicking softly."},
        {"zh": "我爬过一根肋骨，甲壳发亮。", "en": "I climb over a rib, my shell catching light."},
        {"zh": "骨屑从背上簌簌落下。", "en": "Bone dust sifts off my back."},
        {"zh": "我钻进骨缝，只剩一根触须。", "en": "I slip into a seam, one antenna left outside."},
        {"zh": "我沿着骨堆边缘横着走。", "en": "I walk sideways along the edge of the bone pile."},
        {"zh": "我一停，甲壳就和白骨一个色。", "en": "When I stop, my shell matches the white bone."},
        {"zh": "我爬到骨头顶上，伏低了身子。", "en": "I climb onto the bone's crest and crouch flat."},
        {"zh": "两对足并拢，我一节节往前。", "en": "Two pairs of legs together, I inch forward joint by joint."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "骨缝中静待，伺机而动。", "en": "I wait in bone crevices."},
        {"zh": "骨块下静伏，隐匿无声。", "en": "Safe beneath the bones I lie."},
        {"zh": "骨间静立，静观其变。", "en": "I stand in bones, watching."},
        {"zh": "骨堆中静伏，伺机捕食。", "en": "I lie in bones, waiting."},
        {"zh": "骨缝中静待，静观猎物。", "en": "I wait in bones, watching."},
        {"zh": "骨块下静伏，静待时机。", "en": "I lie beneath bones, waiting."},
        {"zh": "静伏骨缝，悄无声息。", "en": "I lie in bone crevices."},
        {"zh": "静立骨间，静待猎物。", "en": "I stand in bones, waiting."},
        {"zh": "骨缝中静伏，静待捕食。", "en": "I lie in bones, waiting to feed."},
        {"zh": "骨中静伏，悄无声息。", "en": "I lie in bones, silent."},
        {"zh": "甲壳贴着骨头，一动不动。", "en": "My shell pressed to bone, I stay perfectly still."},
        {"zh": "我收起脚，装作一截白骨。", "en": "I tuck my legs in and pose as a piece of bone."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "感应到猎物，双眼闪亮。", "en": "My eyes gleam at the scent."},
        {"zh": "玩家靠近，我蠢蠢欲动。", "en": "I stir as you near."},
        {"zh": "骨块上的白屑，是我在呼吸。", "en": "That white dust on the bone is me breathing."},
        {"zh": "感知到威胁，我准备攻击。", "en": "I sense danger, preparing to strike."},
        {"zh": "你在我视线中，我准备行动。", "en": "I see you, ready to act."},
        {"zh": "玩家出现，我要行动。", "en": "You're here, I move."},
        {"zh": "感应到你的气息，我要攻击。", "en": "I sense you, I attack."},
        {"zh": "你在我视线中，我准备捕食。", "en": "I see you, ready to feed."},
        {"zh": "你靠近了，我准备攻击。", "en": "You're near, I strike."},
        {"zh": "我从骨缝里抬起一根触须。", "en": "I lift one antenna out of the seam."},
        {"zh": "你踩上骨头，我就亮了眼睛。", "en": "You step on bone, and my eyes glint."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶声中，它的甲壳受伤了。", "en": "Sss, its exoskeleton is injured."},
        {"zh": "骨屑飞舞，它的身体受创了。", "en": "Bone fragments fly as it’s injured."},
        {"zh": "骨骼在它的甲壳上裂开。", "en": "Its exoskeleton cracks open."},
        {"zh": "骨块下它受伤了，但仍坚韧。", "en": "Injured on the bones, but tough."},
        {"zh": "腐烂开始侵蚀它的身体。", "en": "Rot starts to eat at it."},
        {"zh": "它从骨中显露出来，受了伤。", "en": "Exposed, it’s injured."},
        {"zh": "骨屑遮蔽了它的伤口。", "en": "Bone dust hides its wounds."},
        {"zh": "它在腐烂中受伤。", "en": "It’s injured by rot."},
        {"zh": "它的隐形被打破，露出伤痕。", "en": "Its invisibility is broken, showing wounds."},
        {"zh": "它从隐形中显现，受了伤。", "en": "It reappears, injured from invisibility."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "骨块上你隐形了？", "en": "You're invisible on the bone!"},
        {"zh": "骨屑从你身边飘起。", "en": "Bone shards float around you."},
        {"zh": "啃食这腐烂的骨块。", "en": "Chomp on this rotten bone."},
        {"zh": "靠近些，享受腐化。", "en": "Get closer, feel the corruption."},
        {"zh": "你的肉质很美味。", "en": "You taste good."},
        {"zh": "腐化你的肉身。", "en": "Corrupt your flesh."},
        {"zh": "骨块中伸出触须。", "en": "触须 extend from the bone."},
        {"zh": "腐烂的骨块里有东西在动。", "en": "The bone moves with corruption."},
        {"zh": "你的气味引来了骨爬虫。", "en": "Your scent attracts Bone Crawlers."},
        {"zh": "靠近这些骨头，尝尝它们。", "en": "Taste these bones up close."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了骨爬虫！", "en": "You hit a Bone Crawler!"},
        {"zh": "你撞碎了它的隐形。", "en": "You broke its invisibility!"},
        {"zh": "你被骨屑击中了。", "en": "Bone shards hit you!"},
        {"zh": "骨块下它没有反应。", "en": "It reacts below the bone."},
        {"zh": "你撞开了它的触须。", "en": "You pushed its触须 aside!"},
        {"zh": "你撞碎了它的壳。", "en": "You broke its shell!"},
        {"zh": "你撞飞了骨爬虫。", "en": "You sent it flying!"},
        {"zh": "你撞碎了它的洞穴。", "en": "You destroyed its lair!"},
        {"zh": "你撞塌了它的巢穴。", "en": "You collapsed its nest!"},
        {"zh": "你撞碎了它的隐身。", "en": "You shattered its invisibility!"},
        {"zh": "你碰散了骨堆，我暴露了。", "en": "You scattered the bone pile and exposed me."},
        {"zh": "你的靴子碾过我半截腿。", "en": "Your boot grinds over half my leg."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我藏在白骨堆里，谁也看不见。", "en": "I hide among white bones, unseen."},
        {"zh": "同类的声音，接近。", "en": "Approach by their sound."},
        {"zh": "骨爬虫交配时发出轻声。", "en": "They hum when mating."},
        {"zh": "互相依偎，骨爬虫交配。", "en": "They snuggle to mate."},
        {"zh": "交配时骨爬虫会发光。", "en": "They glow when mating."},
        {"zh": "骨爬虫通过声音识别伴侣。", "en": "They recognize mates by sound."},
        {"zh": "寻找并交配，维持种群。", "en": "Mate to maintain the population."},
        {"zh": "交配时骨爬虫会振动。", "en": "They vibrate when mating."},
        {"zh": "交配后骨爬虫会隐退。", "en": "They retreat after mating."},
        {"zh": "骨爬虫通过共鸣交配。", "en": "They mate by resonance."}
      ]
    },
