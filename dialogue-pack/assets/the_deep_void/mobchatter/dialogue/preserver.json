{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜咕噜，腐肉之魂在低语。", "en": "Gurgle, the soul of decaying flesh whispers."},
        {"zh": "我的触手正寻找猎物。", "en": "My tentacles seek prey."},
        {"zh": "这腐肉中的生命，是我猎物。", "en": "Life in this flesh, my prey."},
        {"zh": "寄肉块在黑暗中徘徊。", "en": "Preserver roams in darkness."},
        {"zh": "我需要更多养分。", "en": "I need more nourishment."},
        {"zh": "腐肉是我的猎场。", "en": "Flesh is my hunting ground."},
        {"zh": "触手渴望鲜血。", "en": "Tentacles crave blood."},
        {"zh": "寄肉块追踪着气息。", "en": "Preserver tracks the scent."},
        {"zh": "腐肉吞噬一切。", "en": "Flesh devours all."},
        {"zh": "我拖着一身烂肉往前爬。", "en": "I drag this mass of rot forward."},
        {"zh": "腐肉摩擦地面，缓缓滑行。", "en": "Rotting flesh drags itself along the ground."},
        {"zh": "触须拖着我向前匍匐。", "en": "My tendrils haul me forward."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "寄肉块静静地等待。", "en": "Preserver waits quietly."},
        {"zh": "我在此守护死亡之地。", "en": "I guard this place of death."},
        {"zh": "腐肉在这里腐烂。", "en": "Flesh rots here."},
        {"zh": "这里没有生命。", "en": "No life here."},
        {"zh": "寄肉块保持警惕。", "en": "Preserver remains vigilant."},
        {"zh": "腐肉之息覆盖一切。", "en": "Flesh’s stench covers all."},
        {"zh": "寂静中的腐烂。", "en": "Decay in silence."},
        {"zh": "等待着腐肉的召唤。", "en": "Waiting for the flesh’s call."},
        {"zh": "腐肉的沉默守护。", "en": "Flesh’s silent guardianship."},
        {"zh": "寂静之中的腐烂。", "en": "Decay in stillness."},
        {"zh": "腐肉一缩一胀，像在呼吸。", "en": "The flesh swells and shrinks as if breathing."},
        {"zh": "脓液一靠近，我就抹掉它。", "en": "I wipe away the pus whenever it creeps close."},
        {"zh": "我守着这片死寂的腐土。", "en": "I keep watch over this dead, rotting ground."},
        {"zh": "肉块贴在石壁上歇息。", "en": "The lump rests against the stone wall."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在此停留太久了。", "en": "You’ve stayed too long."},
        {"zh": "外来者，我将清除你。", "en": "Outsider, I will cleanse you."},
        {"zh": "寄肉块注视你。", "en": "Preserver watches you."},
        {"zh": "你的存在激起了我的兴趣。", "en": "Your presence intrigues me."},
        {"zh": "腐肉的触手接近你。", "en": "Flesh’s tentacles approach you."},
        {"zh": "我将守护这片腐肉。", "en": "I will guard this flesh."},
        {"zh": "触手将附着你。", "en": "Tentacles will cling to you."},
        {"zh": "寄肉块追踪你的气息。", "en": "Preserver tracks your scent."},
        {"zh": "腐肉将吞噬你。", "en": "Flesh will consume you."},
        {"zh": "你的袖子已经被我咬住。", "en": "I've already got my teeth in your sleeve."},
        {"zh": "你的呼吸惊动了腐肉。", "en": "Your breathing stirs the rotten flesh."},
        {"zh": "外来的血肉，真新鲜。", "en": "Foreign flesh, still so fresh."},
        {"zh": "我嗅到你身上的活气。", "en": "I smell the life still in you."},
        {"zh": "别乱动，让我贴上去。", "en": "Hold still and let me cling to you."},
        {"zh": "你踩进了死亡之地。", "en": "You have stepped into the land of death."},
        {"zh": "腐肉认出了你的心跳。", "en": "The flesh has picked out your heartbeat."},
        {"zh": "你身上有猎物的味道。", "en": "You carry the smell of prey."},
        {"zh": "我正想找块地方附着。", "en": "I was just looking for somewhere to attach."},
        {"zh": "看着我，别移开眼睛。", "en": "Look at me. Do not turn your eyes away."},
        {"zh": "这片腐土不欢迎活人。", "en": "This rotten soil has no welcome for the living."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉呻吟，痛苦难忍。", "en": "Rotted flesh moans in agony."},
        {"zh": "寄肉块哀嚎，伤痛如焚。", "en": "Preserver wails, pain burning."},
        {"zh": "腐肉痛苦地尖叫。", "en": "Rotting flesh screams in pain."},
        {"zh": "伤处腐肉腐烂，剧痛难忍。", "en": "Rotted flesh burns, agony intense."},
        {"zh": "我腐烂的肉身哀号。", "en": "My rotting flesh wails."},
        {"zh": "伤处腐肉崩解，痛苦难当。", "en": "Rotted flesh crumbles, pain unbearable."},
        {"zh": "腐肉在痛苦中哀求。", "en": "Rotting flesh pleads in pain."},
        {"zh": "我腐肉痛苦嘶吼。", "en": "My rotting flesh howls in pain."},
        {"zh": "伤处腐肉腐烂，痛彻心扉。", "en": "Rotted flesh burns, pain searing."},
        {"zh": "腐肉被削掉一块！", "en": "A chunk of my flesh is carved away!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠近了不该触碰的边界。", "en": "You've trespassed too far."},
        {"zh": "我的领地，你懂的。", "en": "My territory, you know."},
        {"zh": "尝尝我寄生的滋味。", "en": "Feel my parasitic touch."},
        {"zh": "别让脓液靠近我。", "en": "Keep the ooze away."},
        {"zh": "你的肉身将成为我的食物。", "en": "Your flesh will be my food."},
        {"zh": "碰我一下，我就贴在你身上。", "en": "Touch me and I latch onto you."},
        {"zh": "我的存在即是对抗。", "en": "My presence is resistance."},
        {"zh": "脓液侵蚀不了我。", "en": "Ooze can't touch me."},
        {"zh": "我会保护这里的腐朽。", "en": "I defend this decay."},
        {"zh": "那摊脓液，我替你清掉。", "en": "I'll clear that pus for you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "外来者，让我看看你的力量。", "en": "Stranger, let's test your strength."},
        {"zh": "我的触手缠上了你的膝。", "en": "My tendrils wrap around your knees."},
        {"zh": "感受我的寄生之痛。", "en": "Feel my parasitic pain."},
        {"zh": "你的身体无法抵御我。", "en": "Your body can't resist me."},
        {"zh": "你闯入了我的世界。", "en": "You've invaded my world."},
        {"zh": "我的附着不会轻易脱落。", "en": "My attachment won't easily be removed."},
        {"zh": "你撞到了死亡的边缘。", "en": "You've touched the edge of death."},
        {"zh": "你无法挣脱我的束缚。", "en": "You can't break my hold."},
        {"zh": "撞开的口子，肉很快补上。", "en": "The gap you tore fills with flesh again."},
        {"zh": "我的黏肉贴在你背后。", "en": "My sticky flesh is on your back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "和我一起维持这个世界。", "en": "Mate with me to keep this world."},
        {"zh": "我们需要彼此生存。", "en": "We need each other to survive."},
        {"zh": "共同守护这片腐土。", "en": "Guard this rot together."},
        {"zh": "我的同类正在呼唤你。", "en": "My kind calls to you."},
        {"zh": "贴上来，我们就是一块肉。", "en": "Cling to me and we're one flesh."},
        {"zh": "加入我，一起繁衍。", "en": "Join me, and procreate."},
        {"zh": "我的伴侣，我的未来。", "en": "My mate, my future."},
        {"zh": "这块肉，只想找个宿主。", "en": "This flesh only wants a host."},
        {"zh": "和我一起，你的命运改变。", "en": "Mate with me, and your fate changes."},
        {"zh": "我的选择，你的归宿。", "en": "My choice, your destiny."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉滋生，触碰即死。", "en": "Touch me, and corruption spreads."},
        {"zh": "寄肉块，腐朽的化身。", "en": "Preserver, essence of decay."},
        {"zh": "你闻到死亡的味道了吗？", "en": "Do you smell death's stench?"},
        {"zh": "腐肉粘连，无法摆脱。", "en": "Corruption clings, relentless."},
        {"zh": "腐烂之主，我来了。", "en": "Lord of decay, I come."},
        {"zh": "触碰即腐，永世不得超生。", "en": "Touch, and corruption ensues."},
        {"zh": "腐肉之魂，吞噬一切。", "en": "Corpse spirit, consumes all."},
        {"zh": "腐化之力，无法抵抗。", "en": "Corruption's might, unyielding."},
        {"zh": "寄肉块，终结者的化身。", "en": "Preserver, harbinger of end."},
        {"zh": "腐肉缠绕，无处可逃。", "en": "Corruption binds, nowhere to flee."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "外来者，你落入圈套。", "en": "Outsider, trapped."},
        {"zh": "猎物进入视线，腐肉准备。", "en": "Prey in sight, corruption ready."},
        {"zh": "寄肉块现身，腐化来袭。", "en": "Preserver appears, corruption comes."},
        {"zh": "你成了腐化的猎物。", "en": "You are prey to corruption."},
        {"zh": "寄肉块，等待吞噬。", "en": "Preserver, ready to devour."},
        {"zh": "腐肉触碰，死亡降临。", "en": "Corruption touches, death comes."},
        {"zh": "寄肉块，吸食生命。", "en": "Preserver, feeds on life."},
        {"zh": "腐肉缠绕，痛苦无尽。", "en": "Corruption binds, endless pain."},
        {"zh": "寄肉块，吞噬灵魂。", "en": "Preserver, soul devourer."},
        {"zh": "你逃不过寄肉块的捕食。", "en": "You cannot escape Preserver."},
        {"zh": "腐肉绷紧，目标确定。", "en": "The flesh tightens. Target confirmed."},
        {"zh": "你跑不赢这团烂肉。", "en": "You cannot outrun this heap of rot."},
        {"zh": "触手已经伸向你。", "en": "My tendrils are already reaching for you."},
        {"zh": "这里的脓液，得由我来清。", "en": "The pus here is mine to clean."},
        {"zh": "死亡之地又多一具。", "en": "One more corpse for the dead lands."},
        {"zh": "我记住你的气息了。", "en": "I have your scent now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "触碰我，腐化你。", "en": "Touch me, be corrupted."},
        {"zh": "寄肉块锁定，腐化开始。", "en": "Preserver targets, corruption starts."},
        {"zh": "寄肉块附身，腐化加剧。", "en": "Preserver附身, corruption worsens."},
        {"zh": "寄肉块，吸食你的生命。", "en": "Preserver, drains your life."},
        {"zh": "寄肉块，腐蚀你的意志。", "en": "Preserver, corrodes your will."},
        {"zh": "寄肉块锁定，痛苦无尽。", "en": "Preserver targets, pain endless."},
        {"zh": "寄肉块，吞噬你的心灵。", "en": "Preserver, devours your soul."},
        {"zh": "寄肉块，腐蚀你的身体。", "en": "Preserver, corrupts your flesh."},
        {"zh": "寄肉块，吞噬你的灵魂。", "en": "Preserver, consumes your soul."},
        {"zh": "寄肉块，无尽的折磨。", "en": "Preserver, endless torment."},
        {"zh": "腐肉蠕动，缠上你的腿。", "en": "The flesh writhes and coils around your leg."},
        {"zh": "你挣不开这层烂肉。", "en": "You will not peel this rot off."},
        {"zh": "我把你裹进腐肉里。", "en": "I am wrapping you in rotten flesh."},
        {"zh": "别动，让我贴紧你。", "en": "Stay still and let me press close."},
        {"zh": "你的血肉在呼唤我。", "en": "Your flesh is calling to me."},
        {"zh": "腐肉收紧，慢慢勒住。", "en": "The flesh draws tight, squeezing slowly."},
        {"zh": "你就是下一块寄肉。", "en": "You are the next host of meat."},
        {"zh": "你每喘一口，我就紧一分。", "en": "Every breath you take, I tighten a notch."},
        {"zh": "脓液也救不了你。", "en": "Even the pus will not save you."},
        {"zh": "这里容不下活物。", "en": "Nothing living belongs here."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "附身，感受死亡！", "en": "Infection! Feel death!"},
        {"zh": "你是新的肉块！", "en": "New chunk of flesh!"},
        {"zh": "享受你的终结吧！", "en": "Enjoy your end!"},
        {"zh": "腐烂将你吞噬！", "en": "Rot consumes you!"},
        {"zh": "死亡是我的养料！", "en": "Death feeds me!"},
        {"zh": "我来收割灵魂！", "en": "Souls to harvest!"},
        {"zh": "你的末日已到！", "en": "Your end is here!"},
        {"zh": "腐烂是你的宿命！", "en": "Rot is your fate!"},
        {"zh": "被遗忘的亡者！", "en": "Forgotten dead!"},
        {"zh": "我把你整个人裹进去。", "en": "I fold you in whole."},
        {"zh": "贴上来了，别挣扎！", "en": "I am on you, stop struggling!"},
        {"zh": "腐肉钻进你的衣缝！", "en": "The rot crawls into your seams!"},
        {"zh": "你归死亡之地了！", "en": "You belong to the dead lands now!"},
        {"zh": "这口烂肉归我了！", "en": "This hunk of flesh is mine!"},
        {"zh": "你的皮肉会烂掉！", "en": "Your skin will rot away!"},
        {"zh": "我抓住你了，活人！", "en": "Got you, living one!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "死地的守卫！", "en": "Guard of the dead!"},
        {"zh": "腐土裂开，我露出触须。", "en": "The rotten soil splits and my tendrils show."},
        {"zh": "死亡之地的使者！", "en": "Beggar of the dead!"},
        {"zh": "腐化的守夜者！", "en": "Nightwatcher of decay!"},
        {"zh": "这块腐肉，需要一个新宿主。", "en": "This rotten flesh needs a new host."},
        {"zh": "腐肉的召唤！", "en": "Call of the carrion!"},
        {"zh": "死亡的使者！", "en": "Death's envoy!"},
        {"zh": "我从脓液里撑着爬起来。", "en": "I push myself up out of the pus."},
        {"zh": "这里的地面，我一块块擦净。", "en": "I wipe this ground clean, patch by patch."},
        {"zh": "黑暗中的守望！", "en": "Watch in the dark!"},
        {"zh": "腐肉从裂口里挤出来。", "en": "Rotten flesh squeezes out of the rift."},
        {"zh": "死亡之地又多一块肉。", "en": "The dead lands gain another lump of meat."},
        {"zh": "我从腐土里爬起来了。", "en": "I rise from the rotting soil."},
        {"zh": "血肉平原醒了，我来了。", "en": "The flesh plains wake. I am here."},
        {"zh": "骨荒原的风把我引来。", "en": "The wind of the bone wastes drew me."},
        {"zh": "腐肉堆里我睁开眼。", "en": "I open my eyes inside the heap of flesh."},
        {"zh": "这具烂肉慢慢成形。", "en": "This rotten body slowly takes shape."},
        {"zh": "我等你很久了，活人。", "en": "I have waited long for you, living one."},
        {"zh": "我的触手先醒了过来。", "en": "My tendrils woke before the rest of me."},
        {"zh": "死地需要一个新的守卫。", "en": "The dead land needs a new warden."}
      ]
    },
