        {"zh": "锁定你，根系欲动。", "en": "Lock on, roots ready."},
        {"zh": "盯上你，根系蠢动。", "en": "Stare, roots stir."},
        {"zh": "盯紧你，根系蠕动。", "en": "Watch, roots move."},
        {"zh": "追踪你，根系欲动。", "en": "Track, roots ready."},
        {"zh": "锁定你，根系蠢动。", "en": "Lock on, roots stir."},
        {"zh": "盯上你，根系欲动。", "en": "Watch, roots ready."},
