  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "根须沙沙响，触地即滋生。", "en": "Roots rustle, ground touches, spread."},
        {"zh": "触根处扎根，无声蔓延。", "en": "Root where touched, silent spread."},
        {"zh": "蜿蜒根须动，生命之息。", "en": "Roots twist, life’s breath."},
        {"zh": "根蔓探四方，暗中生长。", "en": "Roots probe, grow unseen."},
        {"zh": "地表根伸展，生命之网。", "en": "Roots stretch, life’s web."},
        {"zh": "触根即扎根，无处不在。", "en": "Root where touched, everywhere."},
        {"zh": "根蔓缠绕，无声威胁。", "en": "Roots entwine, silent threat."},
        {"zh": "地底根蔓延，暗中窥视。", "en": "Roots spread, hidden watch."},
        {"zh": "触根即生长，无处藏身。", "en": "Root where touched, nowhere to hide."},
        {"zh": "根须蔓延，生命延续。", "en": "Roots spread, life continues."},
        {"zh": "根须拖地，划出一道泥痕。", "en": "Roots drag, leaving a muddy line."},
        {"zh": "一节一节往前挪，很慢。", "en": "I inch forward, joint by joint."},
        {"zh": "我爬过的地方，草都枯了。", "en": "Grass withers where I crawl."},
        {"zh": "泥土被我的根撑开了。", "en": "My roots push the soil apart."},
        {"zh": "三根触须探路，两根收着。", "en": "Three tendrils feel ahead, two held back."},
        {"zh": "我沿着石缝伸展。", "en": "I stretch along the cracks in the stone."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静默根系，生命长存。", "en": "Silent roots, eternal life."},
        {"zh": "根系静卧，大地之灵。", "en": "Roots at rest, earth’s spirit."},
        {"zh": "根系深藏，生机暗流。", "en": "Roots deep, life flows."},
        {"zh": "静默根系，暗中观察。", "en": "Silent roots, hidden watch."},
        {"zh": "根系静止，大地之声。", "en": "Roots still, earth’s voice."},
        {"zh": "根系不动，大地之息。", "en": "Roots still, earth’s breath."},
        {"zh": "根系静止，大地之魂。", "en": "Roots still, earth’s soul."},
        {"zh": "根系静默，暗中观察。", "en": "Silent roots, hidden watch."},
        {"zh": "根尖在土里慢慢转。", "en": "Root tips turn slowly in the soil."},
        {"zh": "我的分身也在等。", "en": "My doubles wait with me."},
        {"zh": "一动不动，像一堆须根。", "en": "Still as a heap of roots."},
        {"zh": "根部吸着地下的水。", "en": "My roots drink the water below."}
      ]
    },
