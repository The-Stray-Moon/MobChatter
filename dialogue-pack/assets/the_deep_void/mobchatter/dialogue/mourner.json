{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "哀悼脚步回响在空旷中。", "en": "Lament echoes in the void."},
        {"zh": "亡者的脚步声在黑暗中回荡。", "en": "Deadly footsteps echo in the dark."},
        {"zh": "每一步都诉说着悲伤。", "en": "Each step tells a tale of sorrow."},
        {"zh": "无声的哀歌，飘荡在黑暗中。", "en": "Silent lamentation drifts in the darkness."},
        {"zh": "走过的路，满是回忆。", "en": "Every path is a memory."},
        {"zh": "虚空中的脚步，带着哀伤。", "en": "Steps in the void, laden with sorrow."},
        {"zh": "每一步都沉重无比。", "en": "Each step is heavy."},
        {"zh": "在寂静中行走，回响着悲鸣。", "en": "Walk in silence, with mournful echoes."},
        {"zh": "在这无尽的黑暗中徘徊。", "en": "Wander in endless darkness."},
        {"zh": "脚步在虚空中轻轻回响。", "en": "Steps echo softly in the void."},
        {"zh": "为每一具尸体停一停。", "en": "I pause at every corpse."},
        {"zh": "骨荒原上，我数着死者。", "en": "On the bone waste I count the dead."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "在这片黑暗中，孤独而哀伤。", "en": "Alone and sorrowful in this darkness."},
        {"zh": "空哀静静地驻足。", "en": "Mourner stands still."},
        {"zh": "在无尽的哀悼中休憩。", "en": "Rest in eternal lamentation."},
        {"zh": "孤独的灵魂在此驻足。", "en": "A lonely soul pauses here."},
        {"zh": "在荒凉之地静静哀悼。", "en": "Mourn in the desolate place."},
        {"zh": "悲伤在心中静静沉淀。", "en": "Sorrow settles within."},
        {"zh": "在这荒凉之地独自哀悼。", "en": "Mourn alone in this desolation."},
        {"zh": "在寂静中默默哀悼。", "en": "Mourn in silence."},
        {"zh": "空哀静静地伫立。", "en": "Mourner stands still."},
        {"zh": "哀悼者在此静默。", "en": "Mourner here is silent."},
        {"zh": "谁替这具尸骨合眼？", "en": "Who will close this corpse's eyes?"},
        {"zh": "血肉平原也需要哀悼。", "en": "The flesh plains need mourning too."},
        {"zh": "虚空里没有墓碑。", "en": "The void has no gravestones."},
        {"zh": "我为无名者守夜。", "en": "I keep vigil for the nameless."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你带来了新的哀伤。", "en": "You bring new sorrow."},
        {"zh": "你的存在让我更悲。", "en": "Your presence saddens me more."},
        {"zh": "靠近我，带来悲伤。", "en": "Come near, bring sorrow."},
        {"zh": "你让我感到更加孤独。", "en": "You make me feel more alone."},
        {"zh": "靠近我，感受悲伤。", "en": "Come close, feel sorrow."},
        {"zh": "你让我更加哀悼。", "en": "You make me mourn more."},
        {"zh": "你的存在加剧了我的悲痛。", "en": "Your presence intensifies my sorrow."},
        {"zh": "靠近我，感受绝望。", "en": "Come close, feel despair."},
        {"zh": "你使我更加哀伤。", "en": "You make me more sorrowful."},
        {"zh": "靠近我，带来哀伤。", "en": "Come near, bring sorrow."},
        {"zh": "八秒，够你体会了。", "en": "Eight seconds is enough to feel it."},
        {"zh": "光会从你眼里退去。", "en": "The light will drain from your eyes."},
        {"zh": "你心里有什么死了。", "en": "Something in you has died."},
        {"zh": "别离我这么近。", "en": "Don't come so close to me."},
        {"zh": "你也失去过谁吧。", "en": "You have lost someone too, haven't you?"},
        {"zh": "让我看看你的伤。", "en": "Let me see your wound."},
        {"zh": "你的影子开始发暗。", "en": "Your shadow is dimming."},
        {"zh": "我不会打你，只会陪你。", "en": "I won't strike you. I'll only grieve with you."},
        {"zh": "你眼里的火要灭了。", "en": "The fire in your eyes is going out."},
        {"zh": "站住，陪我一会儿。", "en": "Stand still. Grieve with me a while."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我……无法承受这悲伤。", "en": "I can't bear the sorrow."},
        {"zh": "死亡的阴影笼罩着我。", "en": "The shadow of death covers me."},
        {"zh": "我的灵魂被绝望吞噬。", "en": "My soul is devoured by despair."},
        {"zh": "我的哀伤无法言喻。", "en": "My sorrow is indescribable."},
        {"zh": "这无尽的痛苦折磨着我。", "en": "This endless pain tortures me."},
        {"zh": "悲伤使我无法前行。", "en": "Sadness stops my steps."},
        {"zh": "我只能等待死亡。", "en": "I can only wait for death."},
        {"zh": "死亡才是我的归宿。", "en": "Death is my only home."},
        {"zh": "痛苦让我无力挣扎。", "en": "Pain leaves me helpless."},
        {"zh": "哀伤使我分崩离析。", "en": "Sadness tears me apart."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠近得太近了，我的灵魂在哀悼！", "en": "You're too close. My soul mourns."},
        {"zh": "我愿意与你共享悲伤。", "en": "I'll share my sorrow with you."},
        {"zh": "别靠近，不然你也会成为我的记忆。", "en": "Don't get closer, or you'll become a memory."},
        {"zh": "我的触碰能传递黑暗与绝望。", "en": "My touch spreads darkness and despair."},
        {"zh": "感受一下我的悲伤吧。", "en": "Feel my sorrow."},
        {"zh": "你身上的痛苦我懂。", "en": "I understand the pain in you."},
        {"zh": "不要试图治愈我，只会延长痛苦。", "en": "Don't try to heal me, it only prolongs the pain."},
        {"zh": "你闻起来像是腐烂的灵魂。", "en": "You smell like a rotten soul."},
        {"zh": "你的存在让我更加悲伤。", "en": "Your existence makes me more sorrowful."},
        {"zh": "你让我想起了死去的同伴。", "en": "You remind me of my fallen comrades."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了我的悲伤。", "en": "You collided with my sorrow."},
        {"zh": "你的力量激起了我的哀伤。", "en": "Your force stirred my grief."},
        {"zh": "你打断了我的哀悼。", "en": "You interrupted my mourning."},
        {"zh": "我的悲伤感染了你。", "en": "My sorrow infected you."},
        {"zh": "你与我的痛苦交织在一起。", "en": "Your pain intertwines with mine."},
        {"zh": "你的碰撞带走了我的宁静。", "en": "Your collision took my peace."},
        {"zh": "我的哀悼被你的力量打断了。", "en": "My mourning was interrupted by your power."},
        {"zh": "你的碰撞让我更悲伤。", "en": "Your collision made me sadder."},
        {"zh": "我的哀悼无法阻止你的侵入。", "en": "My mourning can't stop your intrusion."},
        {"zh": "你的碰撞唤醒了我的悲伤。", "en": "Your collision woke my sorrow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们的痛苦可以连结在一起。", "en": "Our pain can be connected."},
        {"zh": "你让我感受到同病相怜。", "en": "You make me feel like we share the same pain."},
        {"zh": "我的悲伤会更加强烈。", "en": "My sorrow will be stronger."},
        {"zh": "我们可以共同哀悼。", "en": "We can mourn together."},
        {"zh": "你的哀伤让我更加悲伤。", "en": "Your sorrow makes me sadder."},
        {"zh": "我们的哀悼交织在一起。", "en": "Our mourning intertwines."},
        {"zh": "你的存在让我更悲伤。", "en": "Your presence makes me sadder."},
        {"zh": "我们的哀悼可以融合。", "en": "Our mourning can fuse."},
        {"zh": "我愿意与你一起哀悼。", "en": "I'll mourn with you."},
        {"zh": "我们的哀悼可以连成一线。", "en": "Our mourning can be linked."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "腐骨刺入大地，怨念随风飘荡。", "en": "Bones pierce the earth, resentment wafts on the wind."},
        {"zh": "黑暗覆盖我的皮肤，怨灵随之而来。", "en": "Darkness covers my skin, bringing wraiths with it."},
        {"zh": "哀悼者的皮膚已腐朽，怨念是其馈赠。", "en": "The mourner’s skin is rotten, resentment is its gift."},
        {"zh": "我所到之处，黑暗与绝望滋生。", "en": "Where I go, darkness and despair grow."},
        {"zh": "坏死的皮肤，怨灵的馈赠。", "en": "Decaying skin, wraiths' gift."},
        {"zh": "腐骨如同墓碑，哀悼者的足迹。", "en": "腐骨 like tombstones, mourner's footprints."},
        {"zh": "怨念在腐骨中滋生，痛苦弥漫四方。", "en": "Resentment grows in the bones, pain spreads around."},
        {"zh": "我的声音，是哀悼者的呼唤。", "en": "My voice, the mourner’s call."},
        {"zh": "腐化的骨头，痛苦的遗骸。", "en": "Corrupted bones, painful remains."},
        {"zh": "哀悼者之骨，怨念的墓碑。", "en": "Mourner’s bones, resentment's tombstone."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "感知你的存在，绝望随之而来。", "en": "I sense your existence, despair follows."},
        {"zh": "你的灵魂，我将带走。", "en": "Your soul, I take it away."},
        {"zh": "靠近者将承受怨灵之苦。", "en": "Those who approach bear wraiths' torment."},
        {"zh": "哀悼者，降临于你。", "en": "Mourner, upon you."},
        {"zh": "黑暗与绝望，我的赠礼。", "en": "Darkness and despair, my gift."},
        {"zh": "怨灵将带走你的灵魂。", "en": "Wraiths will take your soul."},
        {"zh": "绝望之影，跟随你。", "en": "The shadow of despair, follows you."},
        {"zh": "哀悼者的诅咒，笼罩你。", "en": "The mourner’s curse, surrounds you."},
        {"zh": "绝望与怨念，你的宿命。", "en": "Despair and resentment, your fate."},
        {"zh": "哀悼者的诅咒，将你吞噬。", "en": "Mourner’s curse, devours you."},
        {"zh": "有活物靠近了。", "en": "Something living has come near."},
        {"zh": "我要把悲伤递给你。", "en": "I will hand you my sorrow."},
        {"zh": "你身上有温热的气息。", "en": "You carry warm breath."},
        {"zh": "过来，我教你绝望。", "en": "Come, I will teach you despair."},
        {"zh": "这份痛该分你一半。", "en": "Half of this pain belongs to you."},
        {"zh": "靠近就会染上黑暗。", "en": "Come close and the dark will take you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "哀悼者，将你笼罩于绝望之中。", "en": "The mourner, engulfs you in despair."},
        {"zh": "绝望与怨念，将你包围。", "en": "Despair and resentment, surround you."},
        {"zh": "哀悼者之影，遮蔽你的希望。", "en": "The mourner’s shadow, obscures your hope."},
        {"zh": "绝望之刃，刺穿你的心灵。", "en": "The blade of despair, pierces your soul."},
        {"zh": "哀悼者的诅咒，降临于你。", "en": "The mourner’s curse, upon you."},
        {"zh": "绝望之光，照耀你的灵魂。", "en": "Despair’s light, illuminates your soul."},
        {"zh": "哀悼者，带走你的希望。", "en": "The mourner, takes your hope."},
        {"zh": "绝望之吻，降临于你。", "en": "Despair’s kiss, upon you."},
        {"zh": "哀悼者的诅咒，将你囚禁。", "en": "Mourner’s curse, confines you."},
        {"zh": "绝望与怨念，囚禁你的心灵。", "en": "Despair and resentment, cage your soul."},
        {"zh": "我的悲伤正爬向你。", "en": "My grief is crawling toward you."},
        {"zh": "你在发抖，很好。", "en": "You are shivering. Good."},
        {"zh": "八秒后你会明白。", "en": "In eight seconds you will understand."},
        {"zh": "黑雾从你脚边爬上膝盖了。", "en": "Black mist climbs from your feet to your knees."},
        {"zh": "黑暗从脚下升起。", "en": "Darkness rises from your feet."},
        {"zh": "我把记忆塞给你。", "en": "I push my memories into you."},
        {"zh": "你的心口开始发冷。", "en": "Your chest is turning cold."},
        {"zh": "我在你影子里哭泣。", "en": "I weep inside your shadow."},
        {"zh": "哀悼不分敌我。", "en": "Mourning makes no distinction."},
        {"zh": "你的哀伤我要收下。", "en": "I will take your grief as mine."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "哀嚎一声，骨刃袭来。", "en": "Scream and bone blades come."},
        {"zh": "空中的哀歌，致命一击。", "en": "A mournful cry, deadly strike."},
        {"zh": "哀悼之刃，痛苦降临。", "en": "Blade of mourning, pain arrives."},
        {"zh": "悲伤之力，贯穿心肺。", "en": "Grief's power, pierces the heart."},
        {"zh": "绝望之刃，斩断希望。", "en": "Despair's blade, cuts hope."},
        {"zh": "哀鸣中蕴含死亡。", "en": "Mourning harbors death."},
        {"zh": "悲鸣穿透灵魂。", "en": "Mournful cries pierce souls."},
        {"zh": "痛苦化为利刃。", "en": "Pain turns to blades."},
        {"zh": "哀悼之歌，招来黑暗。", "en": "Mourning song summons darkness."},
        {"zh": "怨念凝聚成刃。", "en": "Wrath forms blades."},
        {"zh": "碰一下，你就空了。", "en": "One touch and you are hollow."},
        {"zh": "这是我的拥抱。", "en": "This is my embrace."},
        {"zh": "心死比流血更重。", "en": "A dead heart weighs more than blood."},
        {"zh": "我把痛按进你胸口。", "en": "I press the pain into your chest."},
        {"zh": "别怕，很快就静了。", "en": "Don't fear. Soon it will be quiet."},
        {"zh": "我把悲伤分给你一点。", "en": "Let me share a little grief with you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "从虚空的哀鸣中诞生。", "en": "Spawn from mournful cries."},
        {"zh": "哀悼之光，造就新魂。", "en": "Mourning light, new soul."},
        {"zh": "虚空的悲痛，化为生命。", "en": "Void's sorrow, becomes life."},
        {"zh": "哀歌中的新生。", "en": "Newborn in a mournful song."},
        {"zh": "悲伤的泪水，化为实体。", "en": "Grief's tears, become实体."},
        {"zh": "哀嚎中诞生的怨灵。", "en": "Phantom born from wails."},
        {"zh": "虚空的绝望之花。", "en": "Flower of despair."},
        {"zh": "哀悼的种子，成长。", "en": "Seeds of mourning grow."},
        {"zh": "从哀伤中诞生。", "en": "Born from sorrow."},
        {"zh": "虚空的挽歌，新生。", "en": "Void's lament, new birth."},
        {"zh": "一具新尸，我来守。", "en": "A new corpse. I'll keep watch."},
        {"zh": "骨荒原上又少一个。", "en": "One less on the bone waste."},
        {"zh": "黑暗里需要有人哭。", "en": "The dark needs someone to weep."},
        {"zh": "我循着死气而来。", "en": "I followed the smell of death here."},
        {"zh": "血肉平原在招我。", "en": "The flesh plains are calling me."},
        {"zh": "这里死过太多人。", "en": "Too many have died here."},
        {"zh": "虚空把我的名字忘了。", "en": "The void has forgotten my name."},
        {"zh": "别怕，我不是来杀你的。", "en": "Don't fear. I did not come to kill."},
        {"zh": "我来替他们合眼。", "en": "I came to close their eyes."},
        {"zh": "又一片腐骨等着我。", "en": "Another patch of rotten bone waits for me."}
      ]
