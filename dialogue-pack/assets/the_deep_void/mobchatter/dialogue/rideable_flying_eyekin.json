{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我让你骑上来，抓稳我的鳞。", "en": "Climb on and grip my scales."},
        {"zh": "挥动翅膀加速前行", "en": "Flaps wings faster"},
        {"zh": "转动头盯着地面", "en": "Swivels head down"},
        {"zh": "张开大口呼出热气", "en": "Breathes out hot air"},
        {"zh": "翅膀拍打出风声", "en": "Wings make wind"},
        {"zh": "低头扫视前方地面", "en": "Nods head forward"},
        {"zh": "仰头望向远处天空", "en": "Tilts head up"},
        {"zh": "喷出蓝光照亮周遭", "en": "Blue light illuminates"},
        {"zh": "翅膀收拢，落在石台上。", "en": "I fold my wings and land on the ledge."},
        {"zh": "张开双翼向前滑翔", "en": "Spreads wings gliding"},
        {"zh": "载着骑手掠过虚空", "en": "I skim the void with a rider aboard."},
        {"zh": "双翼扇动，影子下滑", "en": "My wings beat and my shadow drops."},
        {"zh": "眼珠转着找落脚处", "en": "My eye rolls, hunting for a landing."},
        {"zh": "驮着你飞过骨荒原", "en": "I carry you over the bone waste."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "凝视远方的云朵", "en": "Stares at clouds"},
        {"zh": "闭上眼睛享受片刻宁静", "en": "Closes eyes"},
        {"zh": "轻声哼唱古老的歌谣", "en": "Humming old songs"},
        {"zh": "翅膀轻微摆动保持平衡", "en": "Wings gently move"},
        {"zh": "伸展身体发出轻微声响", "en": "Stretches, makes a sound"},
        {"zh": "环顾四周观察环境", "en": "Scans surroundings"},
        {"zh": "尾巴轻触地面感受风", "en": "Taps tail on ground"},
        {"zh": "发出轻微的咕哝声", "en": "Grunts softly"},
        {"zh": "用翅膀轻拂身上的灰尘", "en": "Brushes off with wings"},
        {"zh": "闭目养神，显得十分放松", "en": "Relaxes, eyes closed"},
        {"zh": "落在岩台上收起翅膀", "en": "I land on a ledge and fold my wings."},
        {"zh": "等你爬上我的背", "en": "I wait for you to climb on."},
        {"zh": "眼里映着血肉平原", "en": "The flesh plains fill my eye."},
        {"zh": "轻轻抖掉翼上的灰", "en": "I shake the ash off my wings."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头，正好对上我的眼。", "en": "You look up right into my eye."},
        {"zh": "眼睛快速转动寻找玩家", "en": "Eyes dart"},
        {"zh": "发出警戒的嘶鸣声", "en": "Hisses warning"},
        {"zh": "低沉的目光盯着玩家", "en": "Stares at player"},
        {"zh": "调整方向朝向玩家", "en": "Turns towards player"},
        {"zh": "张嘴露出锋利的牙齿", "en": "Show sharp teeth"},
        {"zh": "翅膀快速拍动接近玩家", "en": "Wings beat to approach"},
        {"zh": "我的眼一转，你就被盯上了。", "en": "My eye turns and you are marked."},
        {"zh": "尾巴快速摆动警戒", "en": "Tail swishes warning"},
        {"zh": "锁定玩家位置保持警惕", "en": "Locks on player, alert"},
        {"zh": "回头等你骑上来", "en": "I look back, waiting for you to mount."},
        {"zh": "独眼盯住你的手", "en": "My single eye fixes on your hands."},
        {"zh": "低头蹭了蹭你的肩", "en": "I lower my head and nudge your shoulder."},
        {"zh": "看清了，是骑手", "en": "I see it now — a rider."},
        {"zh": "睁大眼睛认路", "en": "I open my eye wide to read the way."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "痛苦的吼叫", "en": "A painful roar"},
        {"zh": "眼中闪烁痛苦", "en": "Pain flares in its eyes"},
        {"zh": "长嚎一声，山谷都在回。", "en": "I let out a long howl; the valley echoes."},
        {"zh": "剧烈的痛苦", "en": "Severe pain"},
        {"zh": "我嘶了一声，翅膀一沉。", "en": "I hiss and my wing dips."},
        {"zh": "凄厉的尖叫", "en": "A piercing scream"},
        {"zh": "背上的骑手，压得我翅膀疼。", "en": "The rider on my back weighs on my wings."},
        {"zh": "悲鸣一声", "en": "A sorrowful wail"},
        {"zh": "痛苦的声音，从背上传下去。", "en": "The sound of pain travels down my back."},
        {"zh": "一声哀鸣从云里落下来。", "en": "A mournful cry falls out of the clouds."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你怕了，那味道很甜。", "en": "You're afraid; that scent is sweet."},
        {"zh": "想要我的宝石吗？", "en": "Want my gem?"},
        {"zh": "骑上来，我带你去看那些眼睛。", "en": "Climb on, I will show you the eyes."},
        {"zh": "加入我吧，一起飞翔。", "en": "Join me, fly together."},
        {"zh": "跟我来，我带你飞。", "en": "Follow me, I'll take you flying."},
        {"zh": "我的眼睛能看见一切。", "en": "My eyes see all."},
        {"zh": "不要害怕，我是温和的。", "en": "Don't fear, I'm gentle."},
        {"zh": "交出你的食物，交换我的宝石。", "en": "Give me your food, I'll give you my gem."},
        {"zh": "我们一起强大起来。", "en": "We'll be strong together."},
        {"zh": "我是天空的霸主。", "en": "I'm the lord of the sky."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀一偏，我把你顶开。", "en": "One wing tilt and I shove you aside."},
        {"zh": "驮着人飞，别撞我的翼。", "en": "I carry a rider — don't hit my wings."},
        {"zh": "给我让出空间！", "en": "Make way for me!"},
        {"zh": "我的胸骨把你顶开。", "en": "My breastbone knocks you aside."},
        {"zh": "骑上来吧，比试一下空中速度。", "en": "Climb on; let us race through the air."},
        {"zh": "你飞得太低了！", "en": "You're flying too low!"},
        {"zh": "你坐稳了，我要俯冲。", "en": "Hold on tight; I am diving."},
        {"zh": "骑上来吧，我背得动。", "en": "Climb on — my back can carry you."},
        {"zh": "你躲不掉的！", "en": "You can't avoid me!"},
        {"zh": "让开，我要展示我的力量。", "en": "Move, I'm showing my power."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "求偶季节到了。", "en": "Mating season."},
        {"zh": "找个伴侣，一起飞翔。", "en": "Find a mate, fly together."},
        {"zh": "陪我飞完这片丘陵。", "en": "Fly this whole hill range with me."},
        {"zh": "两只眼龙并排飞才算。", "en": "Two eyekins flying side by side, that counts."},
        {"zh": "我们来展示飞翔技巧。", "en": "Let's show our flying skills."},
        {"zh": "一起探索天空吧。", "en": "Explore the sky together."},
        {"zh": "一起飞越云层。", "en": "Fly over the clouds together."},
        {"zh": "我的飞行技巧很出色。", "en": "My flying skills are great."},
        {"zh": "和我一起，你能更勇敢。", "en": "With me, you'll be braver."},
        {"zh": "一起飞翔，我们更美。", "en": "Fly together, we're more beautiful."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这片天空中翱翔！", "en": "I soar in the skies!"},
        {"zh": "欢迎乘坐我的背！", "en": "Hop on my back!"},
        {"zh": "我能带你飞得更高！", "en": "I can take you higher!"},
        {"zh": "小心，我有火！", "en": "Watch out, I have fire!"},
        {"zh": "抓住我的颈环，别松手。", "en": "Grab my collar and don't let go."},
        {"zh": "跟我来，天空中找食物！", "en": "Follow me, there's food in the sky!"},
        {"zh": "找到食物了，开餐！", "en": "Food found, let's eat!"},
        {"zh": "我来保护你，不要怕！", "en": "I'll protect you, don't be afraid!"},
        {"zh": "跟我一起，变得更强大！", "en": "Join me, become stronger!"},
        {"zh": "这片空域归我的骑手。", "en": "This airspace belongs to my rider."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我发现了猎物，准备出击！", "en": "I see prey, ready to strike!"},
        {"zh": "飞一圈，让你上背。", "en": "One loop, then climb on."},
        {"zh": "我的视力很强，不会错过！", "en": "My vision is sharp, I won't miss!"},
        {"zh": "猎物就在下面，准备俯冲！", "en": "Prey below, ready to dive!"},
        {"zh": "我已经瞄准，只等机会！", "en": "Aimed and ready, just waiting!"},
        {"zh": "不要动，我已经锁定你！", "en": "Don't move, I've got you!"},
        {"zh": "猎物在动，调整瞄准点！", "en": "The prey is moving, adjust!"},
        {"zh": "锁定目标，保持冷静！", "en": "Target locked, stay calm!"},
        {"zh": "猎物就在前方，准备攻击！", "en": "Prey in front, ready to strike!"},
        {"zh": "锁定目标，等待最佳时机！", "en": "Target locked, wait for the right moment!"},
        {"zh": "下方有东西在动", "en": "Something moves below."},
        {"zh": "我俯冲去看看", "en": "I dive to take a look."},
        {"zh": "抓稳了，要下降", "en": "Hold on, we're dropping."},
        {"zh": "眼里映出猎物的影", "en": "A prey's shadow fills my eye."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我载着人，眼睛照样盯着你。", "en": "Carrying a rider, my eyes stay on you."},
        {"zh": "瞄准，射！", "en": "Aim and fire!"},
        {"zh": "集中精力，精准射击！", "en": "Focus, shoot precisely!"},
        {"zh": "锁定目标，释放火焰！", "en": "Target locked, release the fire!"},
        {"zh": "翅膀一张，眼睛跟着你转。", "en": "Wings spread, and my eye tracks you."},
        {"zh": "我载着人飞，也能瞪你一眼。", "en": "I carry a rider and can still glare at you."},
        {"zh": "我从背后绕，翅膀不出声。", "en": "I circle behind, wings silent."},
        {"zh": "瞄准敌人，开火！", "en": "Target the enemy, fire!"},
        {"zh": "集中精神，瞄准射击！", "en": "Focus, aim and shoot!"},
        {"zh": "瞄准并击中目标，不要错过！", "en": "Target and hit, don't miss!"},
        {"zh": "收起翅膀，准备俯冲", "en": "Wings tucked, ready to dive."},
        {"zh": "眼珠锁住那块地面", "en": "My eye locks on that patch of ground."},
        {"zh": "从云后绕过去", "en": "I swing around behind the clouds."},
        {"zh": "风在耳边变尖了", "en": "The wind sharpens past my ear."},
        {"zh": "高度正好，扑下去", "en": "Good height. Down we go."},
        {"zh": "我的眼比你先看到", "en": "My eye sees it before you do."},
        {"zh": "压低身子贴地飞", "en": "I flatten out and skim the ground."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "怒吼撕裂天际", "en": "Roar撕裂 sky"},
        {"zh": "炽热之息灼烧你", "en": "Breathe searing flame"},
        {"zh": "爪击地面震动", "en": "Claw strike shakes earth"},
        {"zh": "翅膀扑扇狂风起", "en": "Wings flap, winds rise"},
        {"zh": "巨颚咬碎岩石", "en": "Maw bites rock"},
        {"zh": "尾巴扫过刮骨痛", "en": "Tail swipe, bone-chilling"},
        {"zh": "火焰喷射熔岩石", "en": "Flame spews, rocks melt"},
        {"zh": "嘶嘶怒吼震耳响", "en": "Snarl echoes, deafening"},
        {"zh": "獠牙闪烁寒光闪", "en": "Fangs glint, cold light"},
        {"zh": "嘶嘶嘶，咬紧牙关", "en": "Sss, clenched teeth"},
        {"zh": "载着你撞了过去", "en": "I slam into it with you aboard."},
        {"zh": "尾巴抽在它背上", "en": "My tail whips across its back."},
        {"zh": "爪子扣进它的肩", "en": "My claws dig into its shoulder."},
        {"zh": "你抓紧，我要升高了。", "en": "Hold tight, I'm climbing."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "从云层中降临", "en": "Descends from clouds"},
        {"zh": "在天空中翱翔", "en": "Soars in skies"},
        {"zh": "夜幕中忽隐忽现", "en": "Flickers in night"},
        {"zh": "雷电中现身", "en": "Appears in lightning"},
        {"zh": "闪电照亮其身影", "en": "Lightning illuminates"},
        {"zh": "雷暴中悄然现身", "en": "Silently appears in storm"},
        {"zh": "在风暴中降临", "en": "Descends in storm"},
        {"zh": "闪电中若隐若现", "en": "Flickers in lightning"},
        {"zh": "乌云间掠过", "en": "Sweeps through clouds"},
        {"zh": "雷暴间忽现忽隐", "en": "Flickers in storm"},
        {"zh": "从骨荒原的裂口升起", "en": "I rise from a crack in the bone waste."},
        {"zh": "血肉平原上空现出眼睛", "en": "An eye opens above the flesh plains."},
        {"zh": "翅膀在黑暗里展开", "en": "Wings unfold in the dark."},
        {"zh": "我从虚空里滑翔而下", "en": "I glide down out of the void."},
        {"zh": "一双眼在云上睁开", "en": "An eye opens above the clouds."},
        {"zh": "基岩之下的天空多了我", "en": "The sky beneath bedrock gains a flier."},
        {"zh": "骨堆上方传来翼声", "en": "Wingbeats sound over the bone heaps."},
        {"zh": "我从高处降下等你", "en": "I descend from above and wait."},
        {"zh": "阴影掠过腐土", "en": "A shadow sweeps over the rot."},
        {"zh": "眼龙落在你面前", "en": "The eyekin lands before you."}
      ]
    },
