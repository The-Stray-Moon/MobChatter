        {"zh": "四臂缠绕，锯齿相连。", "en": "Arms wrap, saws link."},
        {"zh": "撞击中，骨锯撕裂。", "en": "Impact, saws tear."},
        {"zh": "四臂交错，锯齿磨砺。", "en": "Arms cross, saws grind."},
        {"zh": "骨锯相碰，力量碰撞。", "en": "Saws clash, power clashes."},
        {"zh": "四臂缠绕，锯齿相交。", "en": "Arms entwine, saws intersect."},
        {"zh": "撞击间，骨锯交错。", "en": "Impact, saws cross."},
        {"zh": "四臂交错，锯齿碰撞。", "en": "Arms cross, saws clash."}
      ]
    },
