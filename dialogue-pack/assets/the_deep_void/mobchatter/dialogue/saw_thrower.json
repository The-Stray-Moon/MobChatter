{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "手臂撑地，骨锯拖出划痕。", "en": "My arms push the ground, saws scraping."},
        {"zh": "锯齿摩擦", "en": "Saw Rub"},
        {"zh": "磨锯前行", "en": "Grind Forward"},
        {"zh": "手臂挥动", "en": "Arm Swing"},
        {"zh": "抓取骨锯", "en": "Grab Saw"},
        {"zh": "手臂交错移动", "en": "Arm Cross"},
        {"zh": "缓慢挪动", "en": "Slow Move"},
        {"zh": "抓取并投掷", "en": "Grab and Throw"},
        {"zh": "手臂快速挥动", "en": "Fast Arm Swing"},
        {"zh": "旋转身体前行", "en": "Spin Forward"},
        {"zh": "四只手轮流撑地，我挪过去。", "en": "Four hands take turns on the ground as I shift along."},
        {"zh": "没有腿，我靠手臂爬行。", "en": "Legless, I crawl on my arms."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "转动身体", "en": "Spin Body"},
        {"zh": "我低头，看着自己的断腿。", "en": "I look down at where my legs should be."},
        {"zh": "手臂轻摆", "en": "Arm Wave"},
        {"zh": "缓慢转身", "en": "Slow Turn"},
        {"zh": "挥动骨锯", "en": "Wave Saw"},
        {"zh": "静默观察", "en": "Silent Watch"},
        {"zh": "手臂轻微摆动", "en": "Arm Tweak"},
        {"zh": "低语咒语", "en": "Mutter Spell"},
        {"zh": "旋转等待", "en": "Spin Wait"},
        {"zh": "四只手各握一角，锯子转了。", "en": "Four hands take a corner each and the saw spins."},
        {"zh": "我低头，看锯上的齿。", "en": "I lower my head and study the saw's teeth."},
        {"zh": "两只手磨锯，两只手撑地。", "en": "Two hands hone the saw, two brace the ground."},
        {"zh": "我把骨锯抛起，又接住。", "en": "I toss a bone saw up and catch it."},
        {"zh": "谁在召唤，我就等谁开口。", "en": "Whoever summoned me, I wait to be told."},
        {"zh": "我一动不动，只有锯在转。", "en": "I stay perfectly still; only the saw turns."},
        {"zh": "四只手臂交叠，像一顶笼。", "en": "My four arms fold into a cage."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "四只眼，一起定在你身上。", "en": "Four eyes fix on you together."},
        {"zh": "目光追随", "en": "Follow Eyes"},
        {"zh": "骨锯的齿，对准你的喉咙。", "en": "The saw teeth line up with your throat."},
        {"zh": "我转身时，骨锯先转过去。", "en": "When I turn, my saws turn first."},
        {"zh": "四只手臂，各抓一把骨锯。", "en": "Four arms, one bone saw each."},
        {"zh": "四只手各抓一把骨锯。", "en": "Four hands each grip a bone saw."},
        {"zh": "四只手臂都在转锯。", "en": "All four arms spin a saw."},
        {"zh": "我四只手臂同时抬了起来。", "en": "All four of my arms rise at once."},
        {"zh": "我在你背后，锯声先到。", "en": "I'm behind you; the saw sounds first."},
        {"zh": "瞄准攻击", "en": "Attack Aim"},
        {"zh": "我从肩膀后面看你。", "en": "I look at you from over my shoulder."},
        {"zh": "我停住锯，先看清你。", "en": "I stop the saw to look you over."},
        {"zh": "你在我四个方向里。", "en": "You are in all four of my directions."},
        {"zh": "我把头歪到一侧，打量你。", "en": "I tilt my head and size you up."},
        {"zh": "锯响了一声，算打了招呼。", "en": "The saw clicks once as a greeting."},
        {"zh": "我盯着你的膝盖，那儿好锯。", "en": "I stare at your knees; easy to saw."},
        {"zh": "你退后，我四只手同时抬起。", "en": "You back away and all four hands rise."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "四肢无力地倒下。", "en": "Weakly falls to the ground."},
        {"zh": "骨锯在地面上划过。", "en": "Bone saws drag across the ground."},
        {"zh": "双臂垂落，挣扎着。", "en": "Arms droop, struggling."},
        {"zh": "骨锯转不动了，我喘着。", "en": "The bone saws stopped spinning; I'm gasping."},
        {"zh": "身体颤抖不止。", "en": "Body shivers uncontrollably."},
        {"zh": "缓慢倒下，呼吸微弱。", "en": "Slowly collapses, breathing weakly."},
        {"zh": "四只手臂护住没有腿的身子。", "en": "Four arms guard a body with no legs."},
        {"zh": "骨锯划破空气。", "en": "Bone saws slice through the air."},
        {"zh": "四肢摇晃，站立不稳。", "en": "Arms tremble, wobbly stance."},
        {"zh": "痛苦的嘶吼。", "en": "Pained howl."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "四臂环绕，骨锯飞旋。", "en": "Four arms spin, saws fly."},
        {"zh": "靠近我，死亡近在咫尺。", "en": "Draw near, death draws near."},
        {"zh": "你触碰不到我，我却能触及你。", "en": "You cannot touch me, but I touch you."},
        {"zh": "骨锯割裂虚空，旋转不息。", "en": "Saws slice void, spin endlessly."},
        {"zh": "四臂交错，双锯齐发。", "en": "Four arms cross, two saws fly."},
        {"zh": "阴影中，骨锯如影随形。", "en": "In shadows, saws follow like shadows."},
        {"zh": "骨锯在手里转，别靠太近。", "en": "The bone saw spins; don't come close."},
        {"zh": "旋转，旋转，无尽的杀戮。", "en": "Spin, spin, endless slaughter."},
        {"zh": "四臂合围，骨锯齐飞。", "en": "Four arms converge, saws fly."},
        {"zh": "无声中，骨锯破空而来。", "en": "Silent, saws pierce the air."}
      ]
    },
    "collide": {
