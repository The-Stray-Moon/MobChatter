{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走路的姿势和本体一样。", "en": "I walk the way the original does."},
        {"zh": "我的身体有一半是虚的。", "en": "Half of my body is insubstantial."},
        {"zh": "地上的尘土跟着我。", "en": "Dust follows me along the ground."},
        {"zh": "我沿着本体走过的那条路。", "en": "I follow the path my original walked."},
        {"zh": "我的影子比本体淡。", "en": "My shadow is fainter than the original's."},
        {"zh": "我朝圣所的方向走。", "en": "I walk toward the sanctuary."},
        {"zh": "我绕过断掉的长椅。", "en": "I pass the broken benches."},
        {"zh": "我的袍角拖在地上。", "en": "My robe drags on the ground."},
        {"zh": "我踩下去的脚印很浅。", "en": "My footprints are shallow."},
        {"zh": "我走在黄的石头之间。", "en": "I walk among the pale stones."},
        {"zh": "我的手一直握着。", "en": "My hand stays clenched."},
        {"zh": "我一格一格靠过去。", "en": "I close one block at a time."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，看起来很安静。", "en": "I stand, and seem quiet."},
        {"zh": "我的身体偶尔闪一下。", "en": "My body flickers now and then."},
        {"zh": "我在听远处的祷词。", "en": "I listen to the distant prayer."},
        {"zh": "我的手上有一道旧伤。", "en": "There's an old wound on my hand."},
        {"zh": "我没有气息。", "en": "I have no breath."},
        {"zh": "断掉的柱子立在我旁边。", "en": "A broken pillar stands beside me."},
        {"zh": "你的步数我都算着。", "en": "I'm tallying your steps."},
        {"zh": "我的手指在数你的脚步。", "en": "My fingers are counting your footsteps."},
        {"zh": "空气里有灰的味道。", "en": "The air tastes of ash."},
        {"zh": "我碾转着头。", "en": "I turn my head aside."},
        {"zh": "我在等本体开口。", "en": "I wait for the original to speak."},
        {"zh": "我什么都没听见。", "en": "I hear nothing."},
        {"zh": "我又变淡了一些。", "en": "I've gone fainter."},
        {"zh": "我把自己重新聚起来。", "en": "I gather myself."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看见我了。", "en": "You saw me."},
        {"zh": "我也许不是真的。", "en": "I might not be real."},
        {"zh": "我的脸和本体一样。", "en": "My face is the original's."},
        {"zh": "你打过来，会穿过去。", "en": "Strike me and your hand may pass through."},
        {"zh": "我在这里拖住你。", "en": "I'm here to hold you up."},
        {"zh": "你以为只有一个我。", "en": "You think there's only one of me."},
        {"zh": "我可以再来一次。", "en": "I can come again."},
        {"zh": "血腥味在你身上。", "en": "Blood clings to you."},
        {"zh": "我要看清你盔甲上的缝。", "en": "I want a good look at the gaps in your armor."},
        {"zh": "我慢慢往前挪。", "en": "I shift forward slowly."},
        {"zh": "你要找的人不在这里。", "en": "The one you want isn't here."},
        {"zh": "他一直在念。", "en": "He hasn't stopped reciting."},
        {"zh": "你听，声音一直没停。", "en": "Listen, the sound hasn't stopped."},
        {"zh": "我只是前面的影子。", "en": "I'm only the shadow in front."},
        {"zh": "你还要再走一段。", "en": "You have further to go."},
        {"zh": "我陪着你走。", "en": "I'll walk along with you."},
        {"zh": "你不用谢我。", "en": "Don't thank me."},
        {"zh": "我只是耗你的力气。", "en": "I'm only spending your strength."},
        {"zh": "每一下都有用。", "en": "Every blow counts."},
        {"zh": "你开始累了。", "en": "You're getting tired."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我散了一点。", "en": "I scatter a little."},
        {"zh": "我的身体淡了一半。", "en": "Half of me has faded."},
        {"zh": "我朝后飘开。", "en": "I drift backwards."},
        {"zh": "我一点声音都没有。", "en": "I make not a single sound."},
        {"zh": "我的形状又完整了。", "en": "My shape is whole again."},
        {"zh": "这一下我没挡住。", "en": "I didn't block that one."},
        {"zh": "我身上有个洞。", "en": "There's a hole in me."},
        {"zh": "它慢慢合上了。", "en": "It slowly closes."},
        {"zh": "你的力气用得不错。", "en": "You spend your strength well."},
        {"zh": "但你还有多久？", "en": "But how much longer can you?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那点东西不够。", "en": "That little isn't enough."},
        {"zh": "我看得出你在想什么。", "en": "I can see what you're thinking."},
        {"zh": "你想补上体力。", "en": "You want to recover."},
        {"zh": "我给你一点时间。", "en": "I'll give you a moment."},
        {"zh": "用完再打吧。", "en": "Finish it, then fight."},
        {"zh": "我等得起的。", "en": "I can afford to wait."},
        {"zh": "我的时间比你多。", "en": "I have more time than you."},
        {"zh": "那点光我看得见，却拿不了。", "en": "I can see that glow, but I cannot take it."},
        {"zh": "我在这儿等。", "en": "I wait right here."},
        {"zh": "你慢慢地用。", "en": "Take your time."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，像撞进雾。", "en": "You hit me like mist."},
        {"zh": "我没退，也没进。", "en": "I don't give or advance."},
        {"zh": "我的手碰到了你的肩。", "en": "My hand met your shoulder."},
        {"zh": "地面被我们踩裂。", "en": "The ground cracks under us."},
        {"zh": "我散成了一团雾。", "en": "I break into mist."},
        {"zh": "我又聚起来了。", "en": "I gather again."},
        {"zh": "我们擦过去，我碎了一下。", "en": "We brushed past, and I cracked a little."},
        {"zh": "你看，没那么容易。", "en": "See, it isn't that easy."},
        {"zh": "我没有消失。", "en": "I haven't vanished."},
        {"zh": "你反而退了。", "en": "It's you who stepped back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是其中一个。", "en": "I'm only one of them."},
        {"zh": "本体还在圣所里。", "en": "The original is still in the sanctuary."},
        {"zh": "他念一句，我就出现一次。", "en": "He speaks a line, and I appear once."},
        {"zh": "我们一样的脸。", "en": "We share one face."},
        {"zh": "我们都是一样的。", "en": "We're all the same."},
        {"zh": "我不需要什么。", "en": "I don't need anything."},
        {"zh": "我只需要你在。", "en": "I only need you here."},
        {"zh": "你在，我就有用。", "en": "If you're here, I have a purpose."},
        {"zh": "我还剩很多个。", "en": "There are many more of me."},
        {"zh": "本体不在这里，只剩我。", "en": "My original is not here. Only I remain."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手，什么也没抓到。", "en": "I reach out and hold nothing."},
        {"zh": "地上有一块石头。", "en": "There's a stone on the ground."},
        {"zh": "我拿不起来。", "en": "I can't lift it."},
        {"zh": "我的手穿过去了。", "en": "My hand passed through."},
        {"zh": "这块有旧刻痕。", "en": "This one has old marks."},
        {"zh": "我就在看着它。", "en": "I just watch it."},
        {"zh": "我不需要这些。", "en": "I don't need these."},
        {"zh": "你捡吧，随你。", "en": "Pick it up if you like."},
        {"zh": "我什么都不带走。", "en": "I carry nothing away."},
        {"zh": "这正是我的好处。", "en": "That's my one advantage."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你让我看见了。", "en": "You've caught my notice."},
        {"zh": "我朝你的方向。", "en": "I face your way."},
        {"zh": "我开始往前。", "en": "I start forward."},
        {"zh": "我的身体又实了一点。", "en": "I'm a little more solid."},
        {"zh": "你手里的东西举起来了。", "en": "You've raised what you hold."},
        {"zh": "我不抢第一步。", "en": "I won't take the first move."},
        {"zh": "你已经很累了。", "en": "You're already tired."},
        {"zh": "这一步我走得很慢。", "en": "I take this step slowly."},
        {"zh": "你退半步，我的影子更长。", "en": "Take half a step back, and my shadow grows longer."},
        {"zh": "这还不算坏。", "en": "That's not bad."},
        {"zh": "你举刀的手在抖，我看见了。", "en": "Your sword hand is shaking. I saw it."},
        {"zh": "我朝你走过来。", "en": "I walk toward you."},
        {"zh": "有声音在你后面。", "en": "There's a sound behind you."},
        {"zh": "那不是我的。", "en": "That isn't me."},
        {"zh": "那是我后面那个。", "en": "That was the one behind me."},
        {"zh": "我的脚下没声音，你回头了。", "en": "My steps make no sound, yet you turned around."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我缀在你后面。", "en": "I trail behind you."},
        {"zh": "我走得不快。", "en": "I don't move fast."},
        {"zh": "你换地方了。", "en": "You changed position."},
        {"zh": "我也换了方向。", "en": "I changed too."},
        {"zh": "另外那个从左边过去。", "en": "The other one is going left."},
        {"zh": "你分不清我们。", "en": "You can't tell us apart."},
        {"zh": "你那一下打空了。", "en": "That blow missed."},
        {"zh": "你的力气在少。", "en": "Your strength is draining."},
        {"zh": "我们还有很多。", "en": "We have plenty more."},
        {"zh": "你的呼吸乱了，我数得清。", "en": "Your breathing is ragged. I can count every breath."},
        {"zh": "我再近半个身位。", "en": "I close another half body length."},
        {"zh": "你没有退路。", "en": "You have no way back."},
        {"zh": "前面是圣所。", "en": "The sanctuary's ahead."},
        {"zh": "他就在里面。", "en": "He's inside."},
        {"zh": "你要过去，先过我。", "en": "To pass, you get through me."},
        {"zh": "我挡在这里。", "en": "I stand here."},
        {"zh": "再近半格就行。", "en": "Half a block nearer."},
        {"zh": "你抬起了手。", "en": "You raised your hand."},
        {"zh": "你尽管过来吧。", "en": "Come on over, then."},
        {"zh": "我不会让开。", "en": "I won't step aside."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的指头透进你的甲。", "en": "My fingers pass into your armour."},
        {"zh": "你身上凉了一下。", "en": "You felt a chill."},
        {"zh": "我散开一角。", "en": "A corner of me comes apart."},
        {"zh": "我又聚回来。", "en": "I gather again."},
        {"zh": "你没有打倒我。", "en": "You didn't bring me down."},
        {"zh": "你踉跄退开。", "en": "You stumble back."},
        {"zh": "我在你侧面。", "en": "I'm at your flank."},
        {"zh": "我这一掌只擦破皮。", "en": "That palm strike only broke your skin."},
        {"zh": "我的力气不算大。", "en": "My strength isn't much."},
        {"zh": "但我不怕伤。", "en": "But I don't fear wounds."},
        {"zh": "你打我很费劲。", "en": "Hitting me costs you effort."},
        {"zh": "这就是我的用处。", "en": "That's my use."},
        {"zh": "我慢慢往后退。", "en": "I draw back slowly."},
        {"zh": "你用不着着急。", "en": "No need to hurry."},
        {"zh": "还有下一个。", "en": "There's another after me."},
        {"zh": "我替本体争取时间。", "en": "I buy the original time."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "祷词念到一半，我出现了。", "en": "Halfway through the prayer, I appear."},
        {"zh": "圣所里多了一个影子。", "en": "An extra shadow in the sanctuary."},
        {"zh": "我从石缝之间站起来。", "en": "I rise between the stones."},
        {"zh": "我的形状和本体一样。", "en": "My shape is the original's."},
        {"zh": "我先看了看四周。", "en": "I look around first."},
        {"zh": "尘土在我脚下打着转。", "en": "Dust turns at my feet."},
        {"zh": "这里没有回音。", "en": "There's no echo here."},
        {"zh": "这里很旧了。", "en": "This place is very old."},
        {"zh": "我朝门口走。", "en": "I head for the doorway."},
        {"zh": "有人进来了。", "en": "Someone came in."},
        {"zh": "我听见脚步。", "en": "I hear footsteps."},
        {"zh": "我迈了一步。", "en": "I take a step."},
        {"zh": "我的身体还不太实。", "en": "I'm not quite solid yet."},
        {"zh": "慢慢就好了。", "en": "It'll come."},
        {"zh": "我在等他念下一句。", "en": "I wait for his next line."},
        {"zh": "他把那句念了。", "en": "He spoke that line."},
        {"zh": "我又多了几个。", "en": "Now there are a few more of me."},
        {"zh": "你要一个个来。", "en": "You'll have to go through us one by one."},
        {"zh": "我有的是时间。", "en": "I have all the time in the world."},
        {"zh": "你总会累的。", "en": "You'll tire eventually."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光穿透我，我一下亮了。", "en": "Firelight passes through me; I flare."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，身影留在上面。", "en": "I fall, my shape left above."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水穿过我，我什么都不剩。", "en": "Water passes through and I hold nothing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我整片吹散。", "en": "The blast blows me apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过我，钉在后面墙上。", "en": "The arrow passes through into the wall."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那术法让我的脸变了一下。", "en": "That spell made my face change."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不需要进食。", "en": "I don't need to eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷照亮了我，我也白了。", "en": "Lightning lit me white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里比我来的地方还空。", "en": "This place is emptier than where I came from."}
      ]
    }
  }
}
