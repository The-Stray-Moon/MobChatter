    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "树冠上我专猎秃鹫，也猎你。", "en": "In the canopy I hunt vultures. And you."},
        {"zh": "森林深处现身！", "en": "Spawn in the deep forest!"},
        {"zh": "霰弹枪上膛了，抬头。", "en": "Shotgun's loaded. Look up."},
        {"zh": "阴森树冠中！", "en": "In the dark canopy!"},
        {"zh": "树根下现身！", "en": "Spawn from the roots!"},
        {"zh": "腐烂之地诞生！", "en": "Spawn from corruption!"},
        {"zh": "死秃鹫的巢中！", "en": "In the nest of death!"},
        {"zh": "猎杀者之影！", "en": "Hunter's shadow!"},
        {"zh": "腐朽之树中！", "en": "In the rotting tree!"},
        {"zh": "阴影中的守望者！", "en": "Watcher in the shadows!"},
        {"zh": "枯枝一响，我从树上下来。", "en": "A dead branch snaps; I come down from the tree."},
