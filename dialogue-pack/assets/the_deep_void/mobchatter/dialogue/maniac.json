{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "低语着古老咒语前行", "en": "muttering ancient spells as it walks"},
        {"zh": "挥动镰刀般的利爪", "en": "swinging its scythe-like claws"},
        {"zh": "脚下踏过枯萎的藤蔓", "en": "trampling withered vines underfoot"},
        {"zh": "透过枯叶凝视猎物", "en": "staring at prey through dead leaves"},
        {"zh": "挥舞火把照亮黑暗", "en": "waving a lantern to light the dark"},
        {"zh": "夜风中飘荡着腐烂的气息", "en": "a stench of decay wafts in the night breeze"},
        {"zh": "在死亡秃鹫群中穿行", "en": "moving through flocks of carrion birds"},
        {"zh": "用目光锁定猎物", "en": "locking eyes on its prey"},
        {"zh": "偶尔发出低沉的嘶吼", "en": "occasionally letting out a deep roar"},
        {"zh": "脚下生风，如影随形", "en": "sweeping the ground with its presence"},
        {"zh": "枪管朝下，我踩过树根。", "en": "Muzzle down, I step over the roots."},
        {"zh": "灯笼晃动，我跟着自己的影子。", "en": "The lantern swings; I follow my own shadow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静地站立于枯树之间", "en": "standing motionless among the dead trees"},
        {"zh": "仰望星空，似乎在思考", "en": "staring up at the stars, seemingly in thought"},
        {"zh": "低头咀嚼腐烂的叶子", "en": "chewing on decaying leaves"},
        {"zh": "偶尔转头四顾", "en": "occasionally turning its head"},
        {"zh": "目光空洞地盯着前方", "en": "fixing an empty gaze ahead"},
        {"zh": "双手交握，似在祈祷", "en": "crossing its hands as if in prayer"},
        {"zh": "静静地聆听着夜晚的声音", "en": "silently listening to the night"},
        {"zh": "偶尔发出细微的响动", "en": "occasionally making a small noise"},
        {"zh": "静静等待着时机到来", "en": "patiently waiting for the right moment"},
        {"zh": "目光扫过周围，寻找猎物", "en": "glancing around for prey"},
        {"zh": "我擦着枪管，一颗颗数弹丸。", "en": "I wipe the barrel and count the pellets one by one."},
        {"zh": "秃鹫在头顶绕，我不抬头。", "en": "Vultures circle overhead; I don't look up."},
        {"zh": "暗钢锁甲压着肩，我歇一会儿。", "en": "The dark steel mail weighs on my shoulders; I rest a while."},
        {"zh": "我把暗布一圈圈缠紧手腕。", "en": "I wind the dark cloth tighter around my wrist."},
        {"zh": "灯笼里的火苗，就那么一点。", "en": "The lantern flame is just a sliver."},
        {"zh": "我对着树干背一段旧祷词。", "en": "I recite an old prayer at the trunk."},
        {"zh": "手指扣着扳机，却没开枪。", "en": "My finger rests on the trigger, but I don't fire."},
        {"zh": "树冠太静，我屏住呼吸听。", "en": "The canopy is too quiet; I hold my breath and listen."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "突然将目光转向玩家", "en": "suddenly locking eyes on the player"},
        {"zh": "盯紧玩家，准备发动攻击", "en": "fixing its gaze on the player, ready to attack"},
        {"zh": "霰弹枪上膛，别靠近树冠。", "en": "Shotgun loaded. Stay out of the canopy."},
        {"zh": "我的双管枪近得能打死你。", "en": "My double barrel kills at point blank."},
        {"zh": "用爪子抓住玩家", "en": "snatching the player with its claws"},
        {"zh": "张开嘴巴，发出嘶吼", "en": "opening its mouth in a deep roar"},
        {"zh": "迅速向玩家发射暗箭", "en": "rapidly firing dark arrows at the player"},
        {"zh": "挥舞双手，向玩家攻击", "en": "swinging its hands at the player"},
        {"zh": "用镰刀般的利爪撕裂玩家", "en": "ripping the player with scythe-like claws"},
        {"zh": "我的双管枪口对准树冠下方。", "en": "My twin barrels point below the canopy."},
        {"zh": "你靴底的声音，和秃鹫不同。", "en": "Your boots don't sound like vultures."},
        {"zh": "我抬枪，先看你的护甲。", "en": "I raise the gun and check your armor first."},
        {"zh": "你的灯笼，比我的亮。", "en": "Your lantern burns brighter than mine."},
        {"zh": "你在树冠下层，站错了地方。", "en": "You're in the lower canopy. Wrong place."},
        {"zh": "火药受潮了，我先擦一擦。", "en": "The powder is damp; let me wipe it first."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的树冠之梦被撕破了！", "en": "My crown of trees is torn!"},
        {"zh": "这痛苦如同枯叶般凋零！", "en": "This pain like withered leaves."},
        {"zh": "我的信念被践踏了...", "en": "My faith is trampled..."},
        {"zh": "这伤痛如同无尽黑夜！", "en": "This pain like endless night."},
        {"zh": "我原教派的誓言被撕裂...", "en": "My original vows are ripped..."},
        {"zh": "绝望之叶在我身上撕裂！", "en": "Despair's leaves rip me!"},
        {"zh": "我原教派的荣耀已消逝...", "en": "My original honor fades..."},
        {"zh": "这伤痕是我信仰的代价！", "en": "These scars are my faith's price."},
        {"zh": "我的信念被摧毁了...", "en": "My faith is shattered..."},
        {"zh": "这伤痛如同无光深渊！", "en": "This pain like dark abyss."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂果实诱惑你吗？", "en": "腐烂 fruit tempts you?"},
        {"zh": "加入我们，分享猎物。", "en": "Join us, share the prey."},
        {"zh": "死亡秃鹫的羽毛值钱。", "en": "Death eagle feathers are valuable."},
        {"zh": "森林下层，阴森树冠。", "en": "Under the Dark Forest, in the Deadwood Canopy."},
        {"zh": "霰弹枪，终结者武器。", "en": "Shotgun, terminator weapon."},
        {"zh": "暗钢锁甲，坚不可摧。", "en": "Obsidian steel armor, unbreakable."},
        {"zh": "暗布，遮掩身影。", "en": "Obsidian cloth, conceal your form."},
        {"zh": "火药，爆裂的种子。", "en": "Gunpowder, explosive seed."},
        {"zh": "猎杀者，孤独的旅人。", "en": "Huntsman, lonely wanderer."},
        {"zh": "跟随我，共享狩猎之乐。", "en": "Follow me, share the hunt."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的肩撞到我的枪管，走火了。", "en": "Your shoulder hits my barrel, and it fires."},
        {"zh": "猎物撞到了树上。", "en": "Prey collides with the tree."},
        {"zh": "撞击声惊吓了秃鹫。", "en": "Impact startled the eagle."},
        {"zh": "树冠的碰撞声。", "en": "Collisions in the canopy."},
        {"zh": "霰弹枪发出巨响。", "en": "Shotgun roars loudly."},
        {"zh": "暗钢锁甲无惧碰撞。", "en": "Obsidian steel armor fears no collision."},
        {"zh": "暗布贴合身体，无声无息。", "en": "Obsidian cloth fits snugly, silent."},
        {"zh": "火药爆炸的震动。", "en": "Gunpowder explosion's shockwave."},
        {"zh": "我的暗布下，指头已经扣紧。", "en": "Under my dark cloth, my finger tightens."},
        {"zh": "暗夜下的碰撞。", "en": "Collision in the dark night."}
      ]
    },
