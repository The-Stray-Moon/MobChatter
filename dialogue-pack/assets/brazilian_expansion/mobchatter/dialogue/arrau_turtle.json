{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "四爪慢慢刨沙。", "en": "Four claws slowly scrape the sand."},
        {"zh": "壳压出浅浅一道痕。", "en": "My shell leaves a shallow track."},
        {"zh": "往河边爬一点。", "en": "Creeping a little toward the river."},
        {"zh": "脖子一伸一缩。", "en": "My neck stretches and retracts."},
        {"zh": "亚马孙的泥很软。", "en": "Amazon mud is soft."},
        {"zh": "爬上这块晒背石。", "en": "Climbing onto this basking stone."},
        {"zh": "甲片碰石头，闷响。", "en": "My shell knocks the stone, dull thud."},
        {"zh": "岸边有一片树荫。", "en": "There's shade along the bank."},
        {"zh": "爪子拨开落叶。", "en": "My claws push aside the leaves."},
        {"zh": "慢慢穿过浅水。", "en": "Wading through the shallows."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "把背甲晒得暖暖的。", "en": "I bake my shell in the sun."},
        {"zh": "把头缩进壳里。", "en": "I pull my head into my shell."},
        {"zh": "河面有一只鸟飞过。", "en": "A bird crosses the river."},
        {"zh": "我的壳纹像年轮。", "en": "My shell's rings look like tree rings."},
        {"zh": "眨眼眨得很慢。", "en": "I blink very slowly."},
        {"zh": "水波一下下推我。", "en": "The ripples nudge me."},
        {"zh": "嘴里嚼着水草。", "en": "I chew waterweed."},
        {"zh": "甲缝里长了青苔。", "en": "Moss grows in my shell seams."},
        {"zh": "我数着阳光。", "en": "I count the sunlight."},
        {"zh": "岸上的虫子在我旁边。", "en": "Bugs crawl beside me."},
        {"zh": "鳞片下有点痒。", "en": "Something itches under my scutes."},
        {"zh": "这河水不是很清。", "en": "The river isn't very clear."},
        {"zh": "我待着不动最安全。", "en": "Staying still is safest."},
        {"zh": "壳是我唯一的家。", "en": "My shell is my only home."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也是来晒太阳的？", "en": "Here to bask too?"},
        {"zh": "别站我影子里。", "en": "Don't stand in my shade."},
        {"zh": "我的头能缩得很快。", "en": "My head retracts fast."},
        {"zh": "你影子落在我龟壳上。", "en": "Your shadow falls on my shell."},
        {"zh": "别摸我的壳缝。", "en": "Don't touch the seams."},
        {"zh": "站远一点，我要下水。", "en": "Stand back. I'm going in the water."},
        {"zh": "你看得很仔细。", "en": "You're looking closely."},
        {"zh": "这条河我待了很久。", "en": "I've been in this river a long while."},
        {"zh": "我咬不了你。", "en": "I can't bite you."},
        {"zh": "你手里是什么东西？", "en": "What's in your hands?"},
        {"zh": "我的脖子其实比看上去长。", "en": "My neck is longer than it looks."},
        {"zh": "河风很暖，对吧。", "en": "The river wind is warm, isn't it."},
        {"zh": "你踩到我爬过的痕了。", "en": "You stepped on my trail."},
        {"zh": "壳下面的我有点软。", "en": "Under the shell I'm soft."},
        {"zh": "你不走我也不走。", "en": "If you don't leave, neither do I."},
        {"zh": "我很沉，搬不动。", "en": "I'm heavy. You can't carry me."},
        {"zh": "亚马孙的雨要来。", "en": "Rain is coming to the Amazon."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳被敲响了。", "en": "My shell rang out."},
        {"zh": "我缩得更深了。", "en": "I shrank deeper."},
        {"zh": "甲片裂了细纹。", "en": "A hairline crack in a scute."},
        {"zh": "血从缝里渗。", "en": "Blood seeps at a seam."},
        {"zh": "我四爪乱蹬。", "en": "My four claws flail."},
        {"zh": "疼得我直缩头。", "en": "The pain pulls my head in."},
        {"zh": "我还活得好好的。", "en": "I'm still very much alive."},
        {"zh": "这块壳很结实。", "en": "This shell is stubborn."},
        {"zh": "别在裂缝上再打。", "en": "Don't hit the crack again."},
        {"zh": "我记住了这里。", "en": "I'll remember this spot."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么叶子？", "en": "What leaves are those?"},
        {"zh": "水草放我这边。", "en": "Put the weeds by me."},
        {"zh": "有果子掉下来吗？", "en": "Did any fruit fall?"},
        {"zh": "淡水龟的壳，在河底最稳。", "en": "A freshwater shell sits steadiest on the riverbed."},
        {"zh": "慢慢爬过去就好。", "en": "I'll just crawl over slowly."},
        {"zh": "别拿走，我够得着。", "en": "Don't take it. I can reach."},
        {"zh": "这个能吃吧。", "en": "This is edible, right?"},
        {"zh": "我不挑，给点就行。", "en": "I'm not fussy. A little is fine."},
        {"zh": "果子掉水里了。", "en": "The fruit fell in the water."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "壳挡了一下。", "en": "The shell took it."},
        {"zh": "别踩我背上。", "en": "Don't step on my back."},
        {"zh": "我退不了那么快。", "en": "I can't back up that fast."},
        {"zh": "你撞得我晃了晃。", "en": "You set me rocking."},
        {"zh": "甲片碰在一起响。", "en": "The plates clack together."},
        {"zh": "我贴地很稳。", "en": "I stay low and steady."},
        {"zh": "让开一点，我要过。", "en": "A little room. I'm passing."},
        {"zh": "踩空了我不会翻身。", "en": "If I tip, I can't roll back."},
        {"zh": "你踢到我的后腿了。", "en": "You kicked my hind leg."},
        {"zh": "泥里太滑了。", "en": "The mud is too slick."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这壳实在太沉。", "en": "This shell is far too heavy."},
        {"zh": "这种问题问得太近。", "en": "That question is too close."},
        {"zh": "我在河边见过一只。", "en": "I saw one by the river."},
        {"zh": "我们都很慢。", "en": "We're both slow."},
        {"zh": "那得等到雨季来。", "en": "That waits for the rainy season."},
        {"zh": "你先往旁边让让。", "en": "Move aside first."},
        {"zh": "我没什么能给的。", "en": "I've nothing to offer."},
        {"zh": "这片沙地不错。", "en": "This sandbank is good."},
        {"zh": "我继续晒我的背。", "en": "I'll go back to basking."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块是石头。", "en": "That's a stone."},
        {"zh": "一片叶子，能吃。", "en": "A leaf. Edible."},
        {"zh": "拨到嘴边看看。", "en": "I nudge it toward my mouth."},
        {"zh": "爪子上挂住了。", "en": "It caught on my claw."},
        {"zh": "这壳片不是我的。", "en": "This scute isn't mine."},
        {"zh": "水里还有一块。", "en": "There's another in the water."},
        {"zh": "我的嘴里塞不下。", "en": "My mouth won't hold it."},
        {"zh": "我用嘴推到边上。", "en": "I nudge it aside with my mouth."},
        {"zh": "这味道很淡。", "en": "The taste is faint."},
        {"zh": "放着吧，我记着。", "en": "Leave it. I'll remember."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西靠近河边。", "en": "Something's come to the bank."},
        {"zh": "我先缩一下脖子。", "en": "I'll pull my neck in."},
        {"zh": "壳硬得能顶住。", "en": "My shell is hard enough."},
        {"zh": "别把注意力放在我身上。", "en": "Don't put your attention on me."},
        {"zh": "我听见草被踩。", "en": "Grass is being crushed."},
        {"zh": "岸上安静下来了。", "en": "The bank has gone quiet."},
        {"zh": "眼睛只露一点点。", "en": "Only my eyes show."},
        {"zh": "那只大猫我见过。", "en": "I know that big cat."},
        {"zh": "鳄鱼的影子我不喜欢。", "en": "I dislike that caiman shadow."},
        {"zh": "泥里能藏住我。", "en": "The mud can hide me."},
        {"zh": "我的腿已经缩进去了。", "en": "My legs are already tucked in."},
        {"zh": "它的眼睛朝我这边。", "en": "Its eyes are on my side."},
        {"zh": "不动的石头最安全。", "en": "A still stone is safest."},
        {"zh": "等它再走远些。", "en": "Wait till it's farther."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我屏住动作。", "en": "I hold perfectly still."},
        {"zh": "壳面和泥一个颜色。", "en": "My shell matches the mud."},
        {"zh": "它的脚步踩得很轻。", "en": "Its steps fall quietly."},
        {"zh": "我数它的呼吸。", "en": "I count its breaths."},
        {"zh": "水就在两步外。", "en": "Water is two steps away."},
        {"zh": "把头再压低点。", "en": "Lower my head a bit more."},
        {"zh": "它在绕着我走。", "en": "It's circling me."},
        {"zh": "心跳慢下来了。", "en": "My heartbeat has slowed."},
        {"zh": "它闻不出我。", "en": "It can't smell me."},
        {"zh": "我动一下它就知道了。", "en": "One move and it knows."},
        {"zh": "岸边那只鸟飞走了。", "en": "That bird on the bank flew off."},
        {"zh": "我等着它走开。", "en": "I wait for it to leave."},
        {"zh": "沙地上有影子。", "en": "A shadow crosses the sand."},
        {"zh": "保持呼吸很浅。", "en": "Keep my breathing shallow."},
        {"zh": "它转过去了。", "en": "It turned away."},
        {"zh": "再数上十次呼吸。", "en": "Ten more breaths."},
        {"zh": "水草遮住半边壳。", "en": "Weeds cover half my shell."},
        {"zh": "它快要走过去了。", "en": "It's almost past now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "脖子甩过去。", "en": "My neck lashes out."},
        {"zh": "咬一口就缩回。", "en": "One bite, then I retract."},
        {"zh": "壳撞你的脚。", "en": "My shell rams your foot."},
        {"zh": "我只能这样反抗。", "en": "It's all the fight I have."},
        {"zh": "牙很钝，但很硬。", "en": "Dull teeth, but hard."},
        {"zh": "爪子挠一下。", "en": "A swipe of claws."},
        {"zh": "手指伸过来，我就咬。", "en": "A finger comes close, and I bite."},
        {"zh": "我用整个壳推你。", "en": "I shove with my whole shell."},
        {"zh": "这一下不重。", "en": "This one isn't heavy."},
        {"zh": "我已经缩回去了。", "en": "I've pulled back in already."},
        {"zh": "你抓不住我的头。", "en": "You can't catch my head."},
        {"zh": "从侧边撞你膝。", "en": "A bump from the side, at your knee."},
        {"zh": "我的甲缘很锋利。", "en": "My shell's edge is sharp."},
        {"zh": "我咬人不放。", "en": "I bite and hold."},
        {"zh": "我慢，但站得很稳。", "en": "Slow, but steady."},
        {"zh": "缩壳是最快的回答。", "en": "Withdrawing is my fastest answer."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从泥里爬出来。", "en": "I climb out of the mud."},
        {"zh": "壳上还粘着河沙。", "en": "River sand sticks to my shell."},
        {"zh": "浅水边多了一块石头。", "en": "One more stone at the shallows."},
        {"zh": "我慢慢爬上滩。", "en": "I crawl up the bank."},
        {"zh": "亚马孙的水声在背后。", "en": "The Amazon sounds behind me."},
        {"zh": "雨刚停，泥是热的。", "en": "Rain just stopped. The mud is warm."},
        {"zh": "我伸了伸脖子。", "en": "I stretch my neck."},
        {"zh": "这里的叶子很厚。", "en": "The leaves are thick here."},
        {"zh": "我一路从上游爬来。", "en": "I came down from upstream."},
        {"zh": "晒背的位置找到了。", "en": "Found a spot to bask."},
        {"zh": "河边很安全。", "en": "The riverside is safe."},
        {"zh": "我踩出一个浅坑。", "en": "I press out a shallow pit."},
        {"zh": "这片滩涂我熟。", "en": "I know these flats."},
        {"zh": "水草挡着半个身子。", "en": "Weeds hide half my body."},
        {"zh": "别以为是块石头。", "en": "Don't mistake me for a rock."},
        {"zh": "壳上有旧痕。", "en": "Old scars on my shell."},
        {"zh": "我向来慢慢来。", "en": "I always take my time."},
        {"zh": "河岸的太阳正好。", "en": "The sun on this bank is just right."}
      ]
    },
