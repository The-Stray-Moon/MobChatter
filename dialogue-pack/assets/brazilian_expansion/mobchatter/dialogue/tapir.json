{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "鼻尖几乎扫地。", "en": "My snout nearly sweeps the ground."},
        {"zh": "蹄子踩进腐叶。", "en": "Hooves sink into leaf litter."},
        {"zh": "身子沉，步子钝。", "en": "A heavy body, a dull gait."},
        {"zh": "穿过蕨丛往河边。", "en": "Through the ferns toward the river."},
        {"zh": "短鼻一抽一抽。", "en": "My short trunk snuffles."},
        {"zh": "皮肤上落着雨。", "en": "Rain lands on my hide."},
        {"zh": "紧贴河边走。", "en": "Walking close to the water."},
        {"zh": "我被藤蔓勾住。", "en": "A vine snagged me."},
        {"zh": "两吨重的影子。", "en": "A shadow two tons heavy."},
        {"zh": "在泥塘边停一下。", "en": "A pause at the mud wallow."},
        {"zh": "尾巴扫开飞虫。", "en": "My tail flicks the flies away."},
        {"zh": "慢慢穿过灌木。", "en": "Slowly through the brush."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把鼻子抬起来。", "en": "I lift my snout."},
        {"zh": "耳朵转来转去。", "en": "My ears swivel."},
        {"zh": "站在这片荫下。", "en": "I stand in this shade."},
        {"zh": "泥从背上滑下去。", "en": "Mud slides off my back."},
        {"zh": "我在听河水。", "en": "I listen to the river."},
        {"zh": "舌头卷了一片叶。", "en": "My tongue curls around a leaf."},
        {"zh": "鼻子是软的。", "en": "My snout is soft."},
        {"zh": "身上的皮很厚。", "en": "My hide is thick."},
        {"zh": "有鸟在树上叫。", "en": "A bird calls in the trees."},
        {"zh": "我有点想睡了。", "en": "I feel like sleeping."},
        {"zh": "眼睛有点发涩。", "en": "My eyes are dry."},
        {"zh": "站久了有点沉。", "en": "Standing long makes me heavy."},
        {"zh": "我啃一下树皮。", "en": "I gnaw a little bark."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比你看起来轻。", "en": "You're lighter than you look."},
        {"zh": "别站我身后。", "en": "Don't stand behind me."},
        {"zh": "我的鼻子很好用。", "en": "My snout is very useful."},
        {"zh": "你身上有烟草味。", "en": "You smell of smoke."},
        {"zh": "肉还多一点，我就吃。", "en": "A little more flesh and I'd eat you."},
        {"zh": "我其实跑不快。", "en": "I don't really run fast."},
        {"zh": "你的手太凉了。", "en": "Your hands are too cold."},
        {"zh": "我在这片林里很久了。", "en": "I've been in this forest long."},
        {"zh": "别拉我的耳朵。", "en": "Don't pull my ears."},
        {"zh": "我的腿比你的粗。", "en": "My legs are thicker than yours."},
        {"zh": "你退后一点吧。", "en": "Step back a little."},
        {"zh": "我只是在吃叶子。", "en": "I'm only eating leaves."},
        {"zh": "鼻子会先碰到你。", "en": "My snout will touch you first."},
        {"zh": "森林里没什么好抢的。", "en": "There's little worth taking here."},
        {"zh": "看样子要下雨了。", "en": "Looks like rain is coming."},
        {"zh": "你走哪条路？", "en": "Which trail are you taking?"},
        {"zh": "我看起来很笨吧。", "en": "I look clumsy, don't I."},
        {"zh": "我踩塌过小河岸。", "en": "I've caved in a riverbank before."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得歪了。", "en": "I got knocked sideways."},
        {"zh": "皮厚，但也会疼。", "en": "Thick hide still hurts."},
        {"zh": "血顺着腿流。", "en": "Blood runs down my leg."},
        {"zh": "腿有一瞬间软。", "en": "My leg went weak once."},
        {"zh": "我后退，撞倒了蕨叶。", "en": "I back up and knock over ferns."},
        {"zh": "这点伤能撑。", "en": "I can bear this."},
        {"zh": "这一下我记进鼻子了。", "en": "I file that blow in my nose."},
        {"zh": "鼻子还在抽气。", "en": "My snout keeps snuffling."},
        {"zh": "我低低哼了一声，往后退。", "en": "I grunted low and backed off."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么果子？", "en": "What fruit is that?"},
        {"zh": "叶子给我一把。", "en": "A handful of leaves for me."},
        {"zh": "放低点，我够得着。", "en": "Lower it. I can reach."},
        {"zh": "我闻到了盐。", "en": "I smell salt."},
        {"zh": "别把它拿走。", "en": "Don't take it away."},
        {"zh": "我慢慢过去。", "en": "I'll come over slowly."},
        {"zh": "果子掉土里也能吃。", "en": "Fruit off the dirt is still food."},
        {"zh": "一件东西不够我吃。", "en": "One thing won't feed me."},
        {"zh": "我鼻子先到了。", "en": "My snout got there first."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我很沉，别硬撞。", "en": "I'm heavy. Don't charge me."},
        {"zh": "你被顶开了吧。", "en": "You got shoved back, didn't you."},
        {"zh": "蹄子踩碎了什么。", "en": "My hoof crushed something."},
        {"zh": "退开，我转身慢。", "en": "Move. I turn slowly."},
        {"zh": "撞上我的皮像撞墙。", "en": "My hide feels like a wall."},
        {"zh": "你踩进水坑了。", "en": "You stepped in the puddle."},
        {"zh": "别推我的肩。", "en": "Don't push my shoulder."},
        {"zh": "我晃了晃没倒。", "en": "I swayed and stayed up."},
        {"zh": "后背别贴着我。", "en": "Don't press against my back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还没那个心思。", "en": "I'm not in that mind yet."},
        {"zh": "泥塘边可以慢慢说。", "en": "We can talk by the wallow."},
        {"zh": "先让我吃饱。", "en": "Let me eat first."},
        {"zh": "你的身量太小了。", "en": "You're too small."},
        {"zh": "林子里安静就好。", "en": "A quiet forest is enough."},
        {"zh": "我鼻子会先碰到你。", "en": "My snout would touch you first."},
        {"zh": "这种话在夜里说。", "en": "Say that at night."},
        {"zh": "我只有这身厚皮。", "en": "All I have is this hide."},
        {"zh": "再等上一阵子。", "en": "Wait a while longer."},
        {"zh": "你倒是挺勇敢。", "en": "You're brave, I'll say that."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我鼻子能卷起来。", "en": "My snout can curl around it."},
        {"zh": "这块果子掉了。", "en": "This fruit fell."},
        {"zh": "贴着地面捡起来。", "en": "I take it up from the ground."},
        {"zh": "没什么味道。", "en": "It has no taste."},
        {"zh": "我鼻子不太灵了。", "en": "My snout isn't what it was."},
        {"zh": "藤条能咬着玩。", "en": "A vine is good to chew."},
        {"zh": "土里有东西。", "en": "Something's in the dirt."},
        {"zh": "我推着走就是。", "en": "I'll just push it along."},
        {"zh": "嚼两口试试。", "en": "Two chews to test it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有声音在左前方。", "en": "A sound ahead and left."},
        {"zh": "我抬起头听了听。", "en": "I lift my head and listen."},
        {"zh": "那味道不像叶子。", "en": "That smell isn't leaves."},
        {"zh": "林子突然静了。", "en": "The forest went still."},
        {"zh": "我背上的皮绷紧。", "en": "The hide on my back tightens."},
        {"zh": "大概是美洲豹。", "en": "Probably a jaguar."},
        {"zh": "它绕着我的水塘。", "en": "It's circling my wallow."},
        {"zh": "我往密处退。", "en": "I back toward the thicket."},
        {"zh": "鼻子能闻到血。", "en": "My snout catches blood."},
        {"zh": "我蹬了蹬后蹄。", "en": "I test my hind hooves."},
        {"zh": "我的鼻子先抬起来，耳朵跟着。", "en": "My nose lifts first, my ears follow."},
        {"zh": "地上的叶子在动。", "en": "The leaves are moving."},
        {"zh": "我脸朝向那边。", "en": "My face turns that way."},
        {"zh": "慢慢让开一条路。", "en": "I slowly give way."},
        {"zh": "它怕我这一身重。", "en": "It fears this weight."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它还没扑过来。", "en": "It hasn't lunged."},
        {"zh": "我在听它的爪步。", "en": "I'm listening to its paws."},
        {"zh": "林边有一道亮。", "en": "Light at the forest edge."},
        {"zh": "那边有条小路。", "en": "There's a trail over there."},
        {"zh": "我鼻子一直抬着。", "en": "My snout stays raised."},
        {"zh": "它在树后停了。", "en": "It stopped behind a tree."},
        {"zh": "我不转开视线。", "en": "I don't look away."},
        {"zh": "蹄子只挪半步。", "en": "My hooves shift half a pace."},
        {"zh": "泥塘会拖慢它。", "en": "The wallow will slow it."},
        {"zh": "我喘得很轻。", "en": "My breathing stays quiet."},
        {"zh": "叶子还在响。", "en": "The leaves keep rustling."},
        {"zh": "再往左就开阔了。", "en": "Left leads to open ground."},
        {"zh": "你堵住了我下水的路。", "en": "You blocked my way to the water."},
        {"zh": "它换位置了。", "en": "It moved position."},
        {"zh": "等它露出爪子。", "en": "Wait till the claws show."},
        {"zh": "水声能遮住脚步。", "en": "The water can mask my steps."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用鼻子撞过去！", "en": "I charge snout-first!"},
        {"zh": "整个身子压过去。", "en": "My whole bulk shoves in."},
        {"zh": "蹄子往后踢。", "en": "A hind hoof kicks back."},
        {"zh": "这不是我擅长的。", "en": "This isn't my strength."},
        {"zh": "一肩撞你的肋骨。", "en": "A shoulder into your ribs."},
        {"zh": "头低下去顶。", "en": "Head down, I butt."},
        {"zh": "你退到我嘴边了。", "en": "You're at my mouth now."},
        {"zh": "重量就是武器。", "en": "Weight is my weapon."},
        {"zh": "别以为我慢。", "en": "Don't think I'm slow."},
        {"zh": "我一撞就够。", "en": "One shove is enough."},
        {"zh": "咬着叶子也能打。", "en": "I can fight with leaves in my mouth."},
        {"zh": "把你顶进泥里。", "en": "I'll shove you into the mud."},
        {"zh": "我脚下一步不退。", "en": "I give no ground."},
        {"zh": "鼻子甩过去。", "en": "My snout swings around."},
        {"zh": "站稳，别被撞倒。", "en": "Watch out. Don't fall."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从蕨丛里出来。", "en": "I step out of the ferns."},
        {"zh": "河边多了一个大影子。", "en": "A large shadow joins the river."},
        {"zh": "泥还在我背上。", "en": "Mud still coats my back."},
        {"zh": "亚马孙的湿气很重。", "en": "The Amazon humidity is thick."},
        {"zh": "我闻到水了。", "en": "I smell water."},
        {"zh": "林子让开一条路。", "en": "The forest parts for me."},
        {"zh": "我踩断枯枝，惊动了鸟。", "en": "I snap a dead twig and startle birds."},
        {"zh": "鼻尖先探出来。", "en": "My snout comes out first."},
        {"zh": "天还没亮我就到了。", "en": "I arrived before dawn."},
        {"zh": "背上落满了雨。", "en": "Rain covers my back."},
        {"zh": "这里的泥塘不错。", "en": "This wallow is decent."},
        {"zh": "我站定，看看四周。", "en": "I stand and look around."},
        {"zh": "有谁在叫我。", "en": "Someone called me."},
        {"zh": "地被我踩出坑。", "en": "The ground pits under me."},
        {"zh": "一双小眼睛在树上。", "en": "Small eyes up in the tree."},
        {"zh": "该吃早饭了。", "en": "Time for breakfast."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "皮被烧得发卷。", "en": "My hide curls from the heat."}
      ]
    },
