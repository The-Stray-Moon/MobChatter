      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我推出去。", "en": "The blast shoved me away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭钉在皮上很浅。", "en": "The arrow only sunk shallow."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "邪门的暖意钻进皮里。", "en": "Strange warmth crawls under my hide."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得腿发软。", "en": "Hunger makes my legs weak."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击得我浑身发麻。", "en": "The bolt left me numb all over."}
      ]
    }
  }
