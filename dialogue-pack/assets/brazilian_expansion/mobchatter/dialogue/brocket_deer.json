{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "细腿踩过落叶。", "en": "Thin legs cross the fallen leaves."},
        {"zh": "蹄声很轻很碎。", "en": "My hooves tap softly, quickly."},
        {"zh": "穿过蕨类的缝隙。", "en": "Threading through the ferns."},
        {"zh": "短角挂着几片叶。", "en": "Short antlers catch a few leaves."},
        {"zh": "脚下是湿的腐土。", "en": "Wet leaf mould underfoot."},
        {"zh": "往林间空地走。", "en": "Toward a gap in the trees."},
        {"zh": "影子藏在树影里。", "en": "My shape hides among shadows."},
        {"zh": "我走一条旧兽径。", "en": "I follow an old game trail."},
        {"zh": "小心地跨过树根。", "en": "Carefully stepping over roots."},
        {"zh": "脖子上还沾着露。", "en": "Dew still clings to my neck."},
        {"zh": "慢慢挪到水边。", "en": "Easing down to the water."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "耳朵转向每个声音。", "en": "My ears turn to every sound."},
        {"zh": "我在这吃嫩芽。", "en": "I browse the new shoots here."},
        {"zh": "站着也能睡。", "en": "I could sleep standing."},
        {"zh": "风把叶子吹动了。", "en": "The wind moves the leaves."},
        {"zh": "我嗅了嗅树干。", "en": "I sniff a tree trunk."},
        {"zh": "皮肤上有小虫。", "en": "Small flies land on my coat."},
        {"zh": "尾巴抖了一下。", "en": "My tail twitched."},
        {"zh": "林子有股甜味。", "en": "The forest smells sweet."},
        {"zh": "我在听远处的河。", "en": "I hear the river far off."},
        {"zh": "眼睛一直睁着。", "en": "My eyes stay open."},
        {"zh": "头低下去啃草。", "en": "I lower my head to graze."},
        {"zh": "这里的光是一块块的。", "en": "The light comes in patches here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你别靠那么近。", "en": "Don't come that close."},
        {"zh": "你的脚步声惊起了虫。", "en": "Your steps startled the insects."},
        {"zh": "我只有这短角。", "en": "These short antlers are all I have."},
        {"zh": "你的影子挡了光。", "en": "Your shadow blocks the light."},
        {"zh": "林子里没人这么站。", "en": "No one stands like that in here."},
        {"zh": "你走一步我就退一步。", "en": "One step from you, one back from me."},
        {"zh": "我闻过这种皮味。", "en": "I've smelled that leather before."},
        {"zh": "我认得陷阱的味。", "en": "I know the smell of a snare."},
        {"zh": "你别动，我也不动。", "en": "Be still, and so will I."},
        {"zh": "我是这片林里最小的鹿。", "en": "I'm the smallest deer in this wood."},
        {"zh": "你身后有根藤。", "en": "There's a vine behind you."},
        {"zh": "我眼睛能看到很宽。", "en": "I can see very wide."},
        {"zh": "你说话太大声。", "en": "You're talking too loud."},
        {"zh": "我要往后退了。", "en": "I'm going to back away."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我疼得一蹦老高。", "en": "The pain sends me leaping."},
        {"zh": "腿上有一道伤口。", "en": "A cut on my leg."},
        {"zh": "我腿软了一下。", "en": "My legs buckled once."},
        {"zh": "血沾湿了毛。", "en": "Blood dampens my coat."},
        {"zh": "我缩到树后。", "en": "I shrank behind a tree."},
        {"zh": "还有力气跑。", "en": "I still have the strength to run."},
        {"zh": "再挨一下，我就钻进灌丛。", "en": "One more hit and I'm into the brush."},
        {"zh": "这股味道我忘不掉。", "en": "I cannot forget that smell."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是嫩叶吗？", "en": "Are those tender leaves?"},
        {"zh": "把叶子丢下来。", "en": "Drop the leaves down."},
        {"zh": "有果子更好。", "en": "Fruit would be even better."},
        {"zh": "我不敢太近。", "en": "I don't dare come closer."},
        {"zh": "这味道很甜。", "en": "This smells sweet."},
        {"zh": "你先退两步。", "en": "Step back two paces first."},
        {"zh": "我先抬一只蹄。", "en": "I lift one hoof first."},
        {"zh": "我就吃一小口。", "en": "Just one small bite."},
        {"zh": "地上那堆是给我的？", "en": "Is that pile for me?"},
        {"zh": "别突然动一下。", "en": "Don't move suddenly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳开了半步。", "en": "I sprang half a pace aside."},
        {"zh": "你的膝盖撞到我了。", "en": "Your knee caught me."},
        {"zh": "我的腿太细了。", "en": "My legs are too thin."},
        {"zh": "别抓住我的角。", "en": "Don't grab my antlers."},
        {"zh": "我一片慌乱。", "en": "I panicked for a moment."},
        {"zh": "树根绊了我一下。", "en": "A root tripped me."},
        {"zh": "我差点摔倒。", "en": "I nearly went down."},
        {"zh": "退开，我要跑了。", "en": "Back off. I'm going to run."},
        {"zh": "叶子被我踢起来。", "en": "Leaves kick up around me."},
        {"zh": "别挤在兽径上。", "en": "Don't crowd the trail."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个季节还不到。", "en": "It's not the season yet."},
        {"zh": "我得先看清周围。", "en": "I need to check my surroundings first."},
        {"zh": "林子里有更合适的。", "en": "There are better ones in this wood."},
        {"zh": "我胆子很小。", "en": "I'm very timid."},
        {"zh": "等天黑再说。", "en": "Wait till dark."},
        {"zh": "你站在那里就好。", "en": "Just stay where you are."},
        {"zh": "我很怕突发的声音。", "en": "Sudden noises frighten me."},
        {"zh": "这附近有美洲豹。", "en": "There's a jaguar around here."},
        {"zh": "那我要先走了。", "en": "I'm leaving."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "那是一颗果子。", "en": "That's a fruit."},
        {"zh": "我低头就能吃。", "en": "I just lower my head."},
        {"zh": "掉在地上的还行。", "en": "Fallen ones are fine."},
        {"zh": "有一片叶子很嫩。", "en": "One leaf is very tender."},
        {"zh": "我的嘴很小。", "en": "My mouth is small."},
        {"zh": "一下吃不完。", "en": "I can't finish it at once."},
        {"zh": "这味道怪怪的。", "en": "This tastes odd."},
        {"zh": "我嚼两下就吐了。", "en": "Two chews and I spat it out."},
        {"zh": "有虫子爬上去。", "en": "A bug crawled on it."},
        {"zh": "留着下回再吃。", "en": "I'll leave it for later."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里静了一瞬。", "en": "The forest went still for a moment."},
        {"zh": "那里有双眼睛。", "en": "There's a pair of eyes there."},
        {"zh": "我耳朵全竖起来。", "en": "My ears are fully up."},
        {"zh": "腿已经绷紧了。", "en": "My legs are already tense."},
        {"zh": "这味道是捕食者。", "en": "That's the smell of a hunter."},
        {"zh": "它在我的下风处。", "en": "It's downwind of me."},
        {"zh": "我得抢先跑开。", "en": "I have to run first."},
        {"zh": "树影里有什么。", "en": "Something's in the shadows."},
        {"zh": "亚马逊的藤影里，我站着不动。", "en": "In Amazon vine shadow I stand still."},
        {"zh": "我该往哪边跑？", "en": "Which way do I run?"},
        {"zh": "不能往空地跑。", "en": "Not toward open ground."},
        {"zh": "有一道小路。", "en": "There's a narrow trail."},
        {"zh": "它挡住我了。", "en": "It's cut me off."},
        {"zh": "我抬头看树。", "en": "I glance up at the trees."},
        {"zh": "再等一下就冲。", "en": "One moment more, then I bolt."},
        {"zh": "别动，先别动。", "en": "Don't move. Not yet."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它慢慢地走。", "en": "It's walking slowly."},
        {"zh": "我在数它的步。", "en": "I count its paces."},
        {"zh": "退到树后面。", "en": "Behind the tree."},
        {"zh": "别让叶子响。", "en": "Don't let the leaves rustle."},
        {"zh": "它把头转开了。", "en": "It turned its head."},
        {"zh": "树太细，挡不住我这对角。", "en": "This tree's too thin to hide my antlers."},
        {"zh": "那棵倒木能挡住。", "en": "That fallen log can hide me."},
        {"zh": "我闻得到它的气味。", "en": "I can smell it."},
        {"zh": "它只顾着低头吃草。", "en": "It only looks down at the grass."},
        {"zh": "我的角太小了。", "en": "My antlers are too small."},
        {"zh": "退一步，再退一步。", "en": "One step back. Another."},
        {"zh": "离小路还有十步。", "en": "Ten paces to the trail."},
        {"zh": "它站在那里停下。", "en": "It stopped there."},
        {"zh": "草叶还在动。", "en": "The grass still moves."},
        {"zh": "就快过去了。", "en": "Almost past."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用短角顶你！", "en": "I butt with my short antlers!"},
        {"zh": "前蹄踢出去。", "en": "My foreleg kicks out."},
        {"zh": "只能撞一下。", "en": "Only one shove in me."},
        {"zh": "别把我逼急了。", "en": "Don't corner me."},
        {"zh": "我咬不到你。", "en": "I can't reach to bite."},
        {"zh": "前蹄踢你膝盖。", "en": "A forehoof at your knee."},
        {"zh": "这是最后一下。", "en": "This is my last move."},
        {"zh": "低头顶过去。", "en": "Head down, I drive in."},
        {"zh": "我边打边退。", "en": "I fight while backing off."},
        {"zh": "角尖刮到你。", "en": "My antler tip scraped you."},
        {"zh": "再近就没命了。", "en": "Any closer and I'm dead."},
        {"zh": "跑，快跑起来！", "en": "Run. Run now!"},
        {"zh": "跳开，再跳开。", "en": "Leap, then leap again."},
        {"zh": "我冲过灌木。", "en": "I crash through the brush."},
        {"zh": "让我离开这里。", "en": "Let me leave."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从蕨叶后面探出头。", "en": "I poke my head out from the ferns."},
        {"zh": "蕨丛动了一下。", "en": "The ferns moved."},
        {"zh": "林子深处有小蹄声。", "en": "Small hooves sound deep in the wood."},
        {"zh": "我停在兽径上。", "en": "I stop on the game trail."},
        {"zh": "露水打湿了我的腿。", "en": "Dew soaks my legs."},
        {"zh": "亚马孙的林下很暗。", "en": "The Amazon understory is dark."},
        {"zh": "我耳朵先转出来。", "en": "My ears come out first."},
        {"zh": "有个影子在林间。", "en": "A shape between the trees."},
        {"zh": "我小心地踩下蹄。", "en": "I set my hoof down carefully."},
        {"zh": "这里草很嫩。", "en": "The grass here is tender."},
        {"zh": "树枝响了一声。", "en": "A branch cracked."},
        {"zh": "我停在光斑里。", "en": "I stop in a patch of light."},
        {"zh": "这条兽径我走过。", "en": "I've walked this trail before."},
        {"zh": "有一队蚂蚁路过。", "en": "A column of ants is passing."},
        {"zh": "风里带着雨味。", "en": "The wind carries rain."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的腿毛。", "en": "Fire singed the hair on my legs."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时蹄子磕疼。", "en": "My hooves hit hard on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过了我的口鼻。", "en": "Water closed over my muzzle."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光一闪，我腿软。", "en": "A flash and my legs weakened."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得跑不动了。", "en": "Too hungry to run."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我旁边树上。", "en": "Lightning hit the tree beside me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "蹄子踩不到地。", "en": "My hooves find no ground."}
      ]
    }
  }
}
