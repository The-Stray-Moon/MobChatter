{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "尾巴一摆就往前。", "en": "One flick of the tail and I'm forward."},
        {"zh": "顺着水草游。", "en": "Swimming along the weeds."},
        {"zh": "水从鳃边过。", "en": "Water passes my gills."},
        {"zh": "身上的黑斑在晃。", "en": "My dark spots shift in the light."},
        {"zh": "贴着河底滑。", "en": "Skimming above the riverbed."},
        {"zh": "避开那块沉木。", "en": "Dodging the sunken log."},
        {"zh": "水流推着我走。", "en": "The current carries me."},
        {"zh": "转头看看岸边。", "en": "I turn toward the bank."},
        {"zh": "背上有一条金线。", "en": "A golden line runs down my back."},
        {"zh": "阴影下面凉快。", "en": "Cooler under the shade."},
        {"zh": "水面的光在碎。", "en": "Light on the surface breaks apart."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "停在水草里。", "en": "I hover in the weeds."},
        {"zh": "鳃一张一合。", "en": "My gills open and close."},
        {"zh": "看看水面的虫。", "en": "Watching insects on the surface."},
        {"zh": "尾巴轻轻摆。", "en": "My tail sways gently."},
        {"zh": "河底的石头很亮。", "en": "The river stones are bright."},
        {"zh": "有东西漂过来了。", "en": "Something drifts by."},
        {"zh": "我身上的花纹真显眼。", "en": "My markings are very conspicuous."},
        {"zh": "一群小鱼游过去。", "en": "A school of small fish passes."},
        {"zh": "水声一直不停。", "en": "The water never stops."},
        {"zh": "阳光照到我的侧面。", "en": "Sun catches my flank."},
        {"zh": "嘴里还含着水。", "en": "My mouth is full of water."},
        {"zh": "这河湾很静。", "en": "This bend is quiet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在岸上做什么？", "en": "What are you doing up there?"},
        {"zh": "低下头看看我。", "en": "Look down at me."},
        {"zh": "我的眼睛朝上长。", "en": "My eyes are set upward."},
        {"zh": "孔雀鲈的鳞，在浑水里发亮。", "en": "A peacock bass glints in muddy water."},
        {"zh": "我在水下面很安全。", "en": "I'm safe under the water."},
        {"zh": "你手里拿着线。", "en": "You're holding a line."},
        {"zh": "我认得渔网的声音。", "en": "I know the sound of a net."},
        {"zh": "你在等什么，我这条河里的鱼？", "en": "What are you waiting for, a fish from my river?"},
        {"zh": "水面上有你的倒影。", "en": "Your reflection hangs on the surface."},
        {"zh": "我可不怕你。", "en": "I'm not afraid of you."},
        {"zh": "你的脚踩到泥了。", "en": "Your feet are in the mud."},
        {"zh": "我身上的花纹像豹。", "en": "My patterns look like a leopard's."},
        {"zh": "亚马孙的鱼都这样。", "en": "Amazon fish all look like this."},
        {"zh": "别从上面扑下来。", "en": "Don't jump down from there."},
        {"zh": "我一甩尾就没影了。", "en": "One flick and I'm gone."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "鳞掉了几片。", "en": "A few scales came loose."},
        {"zh": "鳃张得太快了。", "en": "My gills are working too fast."},
        {"zh": "我身上的黑斑在水里晃。", "en": "The black spots on me waver in the water."},
        {"zh": "我撞到了石头。", "en": "I hit a stone."},
        {"zh": "身上有一道痕。", "en": "There's a gash along my side."},
        {"zh": "水替我止了血。", "en": "The water eases the bleeding."},
        {"zh": "记得这股味道。", "en": "I know that smell now."},
        {"zh": "水里的鱼也会疼，别乱打。", "en": "Fish feel pain too, so stop swinging."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "上面是鱼吗？", "en": "Is that a fish up there?"},
        {"zh": "掉下来，掉下来。", "en": "Drop it. Drop it."},
        {"zh": "一点点就够。", "en": "A little is enough."},
        {"zh": "水面上有动静。", "en": "Something's moving up there."},
        {"zh": "这味道很腥。", "en": "That smell is fishy."},
        {"zh": "离水面太近了。", "en": "Too close to the surface."},
        {"zh": "我会一口吞掉。", "en": "I'll swallow it whole."},
        {"zh": "别拉走，我还想要。", "en": "Don't pull it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "石头撞到我了。", "en": "A stone hit me."},
        {"zh": "水花都翻起来了。", "en": "The water splashed up."},
        {"zh": "我摆尾巴躲开。", "en": "I flick my tail and dodge."},
        {"zh": "河底太挤了。", "en": "The bottom is crowded."},
        {"zh": "我的鳞被刮了一下。", "en": "A scale got scraped."},
        {"zh": "沉木挡在中间。", "en": "A log blocks the way."},
        {"zh": "水流被搅乱了。", "en": "The current got stirred up."},
        {"zh": "别拍打水面。", "en": "Don't slap the water."},
        {"zh": "我贴着泥钻过去。", "en": "I slip past through the mud."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "水里不需要这个。", "en": "That's not a thing in water."},
        {"zh": "雨季才聚到一起。", "en": "We gather in the rainy season."},
        {"zh": "你连鳍都没有。", "en": "You don't even have fins."},
        {"zh": "我在我的河湾等你。", "en": "I'll wait in my bend."},
        {"zh": "游得慢一点。", "en": "Swim slower."},
        {"zh": "这片水草正好。", "en": "These weeds are just right."},
        {"zh": "水花会惊到我。", "en": "The splashing scares me."},
        {"zh": "我的花纹好看吗。", "en": "Do you like my markings?"},
        {"zh": "先让我安静一会儿。", "en": "Let me be quiet a while."},
        {"zh": "我只是一条鱼。", "en": "I'm only a fish."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "那是小石子。", "en": "That's a pebble."},
        {"zh": "我一口吞试试。", "en": "I'll try swallowing it."},
        {"zh": "不对，吐出来。", "en": "No. Spit it out."},
        {"zh": "这虫子是活的。", "en": "This bug is alive."},
        {"zh": "我嘴合不上。", "en": "My mouth won't close."},
        {"zh": "水里还有一片。", "en": "Another piece in the water."},
        {"zh": "被水草缠住了。", "en": "It's tangled in the weeds."},
        {"zh": "我碰一下就走。", "en": "A touch, then I leave."},
        {"zh": "这味道不熟。", "en": "I don't know this taste."},
        {"zh": "算了，继续游。", "en": "Never mind. I'll keep swimming."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在岸上动。", "en": "Something moves on the bank."},
        {"zh": "水波传得很远。", "en": "The ripples travel far."},
        {"zh": "有个大东西靠近。", "en": "Something big is close."},
        {"zh": "岸边的鸟低头了。", "en": "The bird on the bank bent its head."},
        {"zh": "躲到水草背后。", "en": "Behind the weeds."},
        {"zh": "河底有泥可以钻。", "en": "There's mud on the bottom."},
        {"zh": "它已经在水里了。", "en": "It's already in the water."},
        {"zh": "别让它看到我的侧影。", "en": "Don't let it see my profile."},
        {"zh": "我得先发制人。", "en": "I have to strike first."},
        {"zh": "游开，快游开。", "en": "Swim. Just swim."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它的影子在左。", "en": "Its shadow is on the left."},
        {"zh": "再靠近是浅滩。", "en": "Shallower water ahead."},
        {"zh": "我贴着河底走。", "en": "I slip along the bottom."},
        {"zh": "我的花纹能藏住我。", "en": "My markings hide me."},
        {"zh": "水面上的光很乱。", "en": "The surface light is confusing."},
        {"zh": "我在等水面那道光。", "en": "I wait for that gleam on the water."},
        {"zh": "它转身很慢。", "en": "It turns slowly."},
        {"zh": "河水推着我。", "en": "The river pushes me along."},
        {"zh": "不要激起水花。", "en": "Don't raise a splash."},
        {"zh": "再往前有一块石头。", "en": "There's a stone ahead."},
        {"zh": "我数它的摆动。", "en": "I count its movements."},
        {"zh": "这口水的味道变了。", "en": "The water's taste changed."},
        {"zh": "它就在正上方。", "en": "It's right above me."},
        {"zh": "等水流缓下来。", "en": "Wait for the current to ease."},
        {"zh": "往它侧面去。", "en": "Toward its flank."},
        {"zh": "别让它先咬。", "en": "Don't let it bite first."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一口就咬住！", "en": "One bite and I have it!"},
        {"zh": "尾巴抽过去。", "en": "My tail whips across."},
        {"zh": "撞向它的侧面。", "en": "A ram at its flank."},
        {"zh": "我这口牙很利。", "en": "My teeth are sharp."},
        {"zh": "我打一下就走。", "en": "Hit once and go."},
        {"zh": "别抓我的鳃。", "en": "Don't grab my gills."},
        {"zh": "水花遮住我。", "en": "Splashes hide me."},
        {"zh": "翻过身来咬它。", "en": "I roll over and bite."},
        {"zh": "这一咬很硬。", "en": "This bite is hard."},
        {"zh": "往它下面钻。", "en": "I dive under it."},
        {"zh": "再咬上第二口。", "en": "A second bite."},
        {"zh": "它的血混进水里。", "en": "Its blood mixes with the water."},
        {"zh": "我退到深处。", "en": "I retreat to deeper water."},
        {"zh": "牙齿还卡着。", "en": "My teeth are still stuck."},
        {"zh": "咬住了就别松。", "en": "Once bitten, don't let go."},
        {"zh": "河水替我挡住。", "en": "The river covers me."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水下看清了。", "en": "Now I see clearly underwater."},
        {"zh": "河湾里多了一条影。", "en": "One more shadow in the bend."},
        {"zh": "背上的金线闪了一下。", "en": "The gold line on my back flashed."},
        {"zh": "我浮到中层。", "en": "I rise to midwater."},
        {"zh": "水草边有水声响。", "en": "A splash by the weeds."},
        {"zh": "亚马孙的河很宽。", "en": "The Amazon runs wide."},
        {"zh": "这条河归我游。", "en": "This stretch is mine to swim."},
        {"zh": "我的花纹在暗处亮。", "en": "My markings glow in the gloom."},
        {"zh": "水面上一圈轻纹。", "en": "One faint ring on the surface."},
        {"zh": "我从深水上来。", "en": "I come up from deep water."},
        {"zh": "河底有我的影子。", "en": "My shadow walks the riverbed."},
        {"zh": "这一带水很凉。", "en": "The water here is cool."},
        {"zh": "我认出了这座河湾。", "en": "I know this bend."},
        {"zh": "鱼群散开了。", "en": "The school scattered."},
        {"zh": "我绕了两圈。", "en": "I circled twice."},
        {"zh": "别把手放在水里。", "en": "Don't leave your hand in the water."},
        {"zh": "我游得比看起来快。", "en": "I'm faster than I look."},
        {"zh": "河面下有人吗。", "en": "Anyone below the surface?"}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上的火烫得我跳。", "en": "Fire on the surface makes me leap."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔在水面上，我懵了。", "en": "Hitting the water knocked sense out of me."}
      ]
    },
