{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扭着长身子在泥水里穿行。", "en": "I twist my long body through the mud water."},
        {"zh": "水面下的草被我一节节压弯。", "en": "The submerged grass bends section by section."},
        {"zh": "我贴着河底滑，没有波纹。", "en": "I glide along the riverbed without a ripple."},
        {"zh": "偶尔我抬起头换一口气。", "en": "Now and then I lift my head to breathe."},
        {"zh": "泥里有东西在动，我转过去。", "en": "Something stirs in the mud; I turn."},
        {"zh": "我的鳍像一条细带在摆。", "en": "My fin waves like a thin ribbon."},
        {"zh": "我从一段沉木下面过去。", "en": "I pass beneath a sunken log."},
        {"zh": "水里有一点热从我身上散开。", "en": "A little warmth spreads off me in the water."},
        {"zh": "我朝水浅的地方游。", "en": "I swim toward shallower water."},
        {"zh": "尾巴先到，头才跟上。", "en": "My tail arrives first; my head follows."},
        {"zh": "我在河湾里绕了一圈。", "en": "I circle once in the bend."},
        {"zh": "又回到原来的位置。", "en": "And return to where I started."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水里，身体一折一折。", "en": "I hang in the water, folding and unfolding."},
        {"zh": "鳃边有一层薄膜在动。", "en": "A thin membrane moves by my gills."},
        {"zh": "水草缠在我的尾上。", "en": "Weeds catch on my tail."},
        {"zh": "我没有挣开。", "en": "I do not pull free."},
        {"zh": "有鱼从我身下过。", "en": "A fish passes below me."},
        {"zh": "它绕了很远。", "en": "It gives me a wide berth."},
        {"zh": "我不动，它也不回来。", "en": "I stay still; it does not return."},
        {"zh": "泥从上面落下来。", "en": "Mud drifts down from above."},
        {"zh": "落在我的背上。", "en": "It settles on my back."},
        {"zh": "水里有细小的响。", "en": "There are small sounds in the water."},
        {"zh": "那是我身上的。", "en": "They come from me."},
        {"zh": "有一条虫在水底爬。", "en": "A worm crawls along the bottom."},
        {"zh": "我看它爬了很久。", "en": "I watch it a long while."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在齐膝的水里。", "en": "You stand knee-deep."},
        {"zh": "我把身体盘起来一点。", "en": "I coil my body a little."},
        {"zh": "水开始有细微的响。", "en": "The water begins to tick."},
        {"zh": "你大概感觉到了。", "en": "You must feel it."},
        {"zh": "我这一放电，水都麻了。", "en": "When I discharge, the whole river tingles."},
        {"zh": "响停了。", "en": "The ticking stops."},
        {"zh": "你还是没有走。", "en": "You still have not left."},
        {"zh": "朝深水去。", "en": "Toward deeper water."},
        {"zh": "那口气很响。", "en": "It was loud."},
        {"zh": "我看着你，眼睛几乎不转。", "en": "I watch you, my eyes barely moving."},
        {"zh": "你在算什么。", "en": "What are you weighing?"},
        {"zh": "我说不了话。", "en": "I cannot speak."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我扭了一下，水都翻起来。", "en": "I twist and the water churns."},
        {"zh": "身上的一层膜破了。", "en": "A film on my body breaks."},
        {"zh": "我的长身缩回泥里。", "en": "My long body draws back into the mud."},
        {"zh": "水里有我的味道。", "en": "My own smell is in the water."},
        {"zh": "我把身体盘紧。", "en": "I coil myself tight."},
        {"zh": "细小的响变大了。", "en": "The ticking grows louder."},
        {"zh": "这是我生气的声音。", "en": "That is the sound of my anger."},
        {"zh": "我又放了一次电。", "en": "I discharge again."},
        {"zh": "水纹跳起来。", "en": "The ripples leap."},
        {"zh": "你后退了。", "en": "You back away."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那条鱼太小了。", "en": "That fish in your hand is too small."},
        {"zh": "我吃水里的。", "en": "I eat what is in the water."},
        {"zh": "你把东西放进水里。", "en": "You put it in the water."},
        {"zh": "它沉下去，我看了一眼。", "en": "It sinks; I glance at it."},
        {"zh": "我不感兴趣。", "en": "I am not interested."},
        {"zh": "那条小鱼在石头后面。", "en": "That small fish is behind the stone."},
        {"zh": "我顺着电流的方向游。", "en": "I swim along the line of current."},
        {"zh": "这跟你没关系。", "en": "This has nothing to do with you."},
        {"zh": "我转身游开。", "en": "I turn and swim off."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你在水里碰到我的身体。", "en": "You touch my body in the water."},
        {"zh": "一阵麻从你的手传上来。", "en": "A numbness climbs from your hand."},
        {"zh": "你甩了两下。", "en": "You shake it twice."},
        {"zh": "我滑开了。", "en": "I slip away."},
        {"zh": "泥水里那道波纹，是你的。", "en": "That ripple in the mud is yours."},
        {"zh": "水花很小。", "en": "The splash is small."},
        {"zh": "但你的手臂还在抖。", "en": "But your arm is still shaking."},
        {"zh": "我慢慢游远了。", "en": "I swim slowly away."},
        {"zh": "这次只是碰到。", "en": "That was only a touch."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "水涨的时候才轮到这些。", "en": "This waits for the flood."},
        {"zh": "我们缠在一起游。", "en": "We swim twined together."},
        {"zh": "很长一段时间分不开。", "en": "For a long while we cannot part."},
        {"zh": "水面下有一阵轻微的震动。", "en": "A faint tremor runs under the surface."},
        {"zh": "不是威胁。", "en": "Not a threat."},
        {"zh": "我们松开。", "en": "We come apart."},
        {"zh": "各自游向不同的方向。", "en": "Each swims a different way."},
        {"zh": "卵会散在水草里。", "en": "The eggs will scatter in the weeds."},
        {"zh": "水退去后就没影了。", "en": "When the water drops, they are gone."},
        {"zh": "我继续往上游。", "en": "I keep heading upstream."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用嘴碰了碰它。", "en": "I touch it with my mouth."},
        {"zh": "它没有反应。", "en": "It does not respond."},
        {"zh": "这个太大了。", "en": "This one is too big."},
        {"zh": "我放弃了。", "en": "I give up."},
        {"zh": "我游到它上面。", "en": "I swim over it."},
        {"zh": "压着它。", "en": "Press down on it."},
        {"zh": "就当是个石头。", "en": "Consider it a stone."},
        {"zh": "抓我？小心被电得手麻。", "en": "Grab me? Mind the shock."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "浑水里我放了一下电。", "en": "I let off a charge in the murk."},
        {"zh": "我停下来。", "en": "I stop."},
        {"zh": "不是鱼。", "en": "Not a fish."},
        {"zh": "比鱼大。", "en": "Bigger than a fish."},
        {"zh": "我慢慢转身。", "en": "I turn slowly."},
        {"zh": "身体里的东西开始响。", "en": "The thing inside me begins to hum."},
        {"zh": "水面起了一层细纹。", "en": "Fine ripples cross the surface."},
        {"zh": "它不会察觉。", "en": "It will not notice."},
        {"zh": "我得再近一点。", "en": "I need to be closer."},
        {"zh": "水草挡住了一半。", "en": "The weeds hide half of me."},
        {"zh": "我贴着河底过去。", "en": "I slip along the bottom."},
        {"zh": "它还在那里。", "en": "It is still there."},
        {"zh": "它低头看我。", "en": "It looks down at me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着它慢慢转。", "en": "I circle it slowly."},
        {"zh": "水面的细纹越来越多。", "en": "The fine ripples multiply."},
        {"zh": "它开始觉得麻。", "en": "It begins to feel numb."},
        {"zh": "它想往岸上走。", "en": "It wants to reach the bank."},
        {"zh": "我挡在浅水那边。", "en": "I block the shallow side."},
        {"zh": "它退了回去。", "en": "It retreats."},
        {"zh": "我又放了一次。", "en": "I release again."},
        {"zh": "手脚都不听话了。", "en": "Its limbs no longer obey."},
        {"zh": "水只到它的腰。", "en": "The water reaches its waist only."},
        {"zh": "但它走不动。", "en": "But it cannot walk."},
        {"zh": "我游到它脚边。", "en": "I swim to its feet."},
        {"zh": "它的影子落在我背上。", "en": "Its shadow falls on my back."},
        {"zh": "我把自己沉到泥底。", "en": "I sink myself into the mud."},
        {"zh": "这一次不用再等了。", "en": "This time there is no more waiting."},
        {"zh": "我贴上去。", "en": "I press against it."},
        {"zh": "水面上炸开一片白。", "en": "The surface bursts white."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞上去，一声闷响。", "en": "I slam into it with a dull report."},
        {"zh": "它整个人僵住。", "en": "Its whole body locks."},
        {"zh": "它的膝盖弯了。", "en": "Its knees buckle."},
        {"zh": "水里全是白纹。", "en": "The water is all white tracery."},
        {"zh": "它倒进浅水里。", "en": "It falls into the shallows."},
        {"zh": "我盘在它周围。", "en": "I coil around it."},
        {"zh": "每碰一次就麻一下。", "en": "Every touch brings numbness."},
        {"zh": "它抬手想抓我。", "en": "It reaches for me."},
        {"zh": "手停在半空。", "en": "Its hand stops in the air."},
        {"zh": "我松开。", "en": "I release."},
        {"zh": "它还在抽动。", "en": "It still twitches."},
        {"zh": "水色暗下来。", "en": "The water darkens."},
        {"zh": "我又回到深处。", "en": "I return to the deep water."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "河面上浮起一串泡。", "en": "A string of bubbles rises."},
        {"zh": "我从泥里钻出来。", "en": "I emerge from the mud."},
        {"zh": "身体一节一节伸展。", "en": "My body unfolds section by section."},
        {"zh": "我停在河湾的凹处。", "en": "I settle in the hollow of the bend."},
        {"zh": "水草把我盖了一半。", "en": "The weeds cover half of me."},
        {"zh": "有鱼群经过。", "en": "A shoal passes."},
        {"zh": "它们绕得很远。", "en": "They give me a wide berth."},
        {"zh": "我盘在河底的泥洞里。", "en": "I coil in a mud hole on the riverbed."},
        {"zh": "我在等更大的。", "en": "I am waiting for something bigger."},
        {"zh": "水面很静。", "en": "The surface is still."},
        {"zh": "静得有点不自然。", "en": "Still enough to feel wrong."},
        {"zh": "我抬起一点头。", "en": "I lift my head a little."},
        {"zh": "岸上有影子。", "en": "There is a shape on the bank."},
        {"zh": "只留眼睛。", "en": "Only my eyes stay."},
        {"zh": "它走过来了。", "en": "It is walking over."},
        {"zh": "水底的电流先醒了。", "en": "The current in the riverbed woke first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水被烧热，我的皮在收紧。", "en": "The water heats and my hide tightens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水里被掀起又摔回来。", "en": "I am lifted from the water and slammed back."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我本来就活在水里。", "en": "I live in water already."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "水柱把我整个掀出水面。", "en": "The blast throws me clear of the water."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进我的侧腹。", "en": "It buries in my flank."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷从鳃钻进身体。", "en": "A cold enters through my gills."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我连泥都吸。", "en": "Hungry enough to suck at the mud."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着水过来，我全身绷直。", "en": "Lightning crosses the water and I go rigid."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "水里没有底了，我往下坠。", "en": "The water has no floor; I fall."}
      ]
    }
  }
}
