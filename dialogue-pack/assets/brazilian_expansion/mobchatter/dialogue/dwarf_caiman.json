{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着泥岸爬，肚皮蹭着地。", "en": "I crawl along the muddy bank, belly to the ground."},
        {"zh": "四条短腿一前一后地挪。", "en": "Four short legs shuffle in turn."},
        {"zh": "尾巴在水里划出一道弧。", "en": "My tail sweeps an arc through the water."},
        {"zh": "我的背甲像一排钝钉子。", "en": "The scutes on my back are like blunt nails."},
        {"zh": "我从一块石头上滑进水里。", "en": "I slide off a stone into the water."},
        {"zh": "游的时候，我只露出眼和鼻。", "en": "Swimming, only my eyes and snout show."},
        {"zh": "我停在水草边上，一动不动。", "en": "I stop at the weeds and do not move."},
        {"zh": "泥从我的鳞上滑下去。", "en": "Mud slides off my scales."},
        {"zh": "我绕过一根倒下的树枝。", "en": "I round a fallen branch."},
        {"zh": "河湾的水很浅，正适合我。", "en": "The bend is shallow; perfect for me."},
        {"zh": "我朝有声音的地方爬。", "en": "I crawl toward the sound."},
        {"zh": "身后留下一道拖痕。", "en": "A drag mark trails behind me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着不动，像一截木头。", "en": "I lie still as a log."},
        {"zh": "眼睛一眨不眨。", "en": "My eyes do not blink."},
        {"zh": "只有喉咙在轻轻起伏。", "en": "Only my throat stirs faintly."},
        {"zh": "有蜻蜓落在我鼻子上。", "en": "A dragonfly lands on my snout."},
        {"zh": "我浮在浅水里像块木头。", "en": "I float in the shallows like a log."},
        {"zh": "它飞走了。", "en": "It flies off."},
        {"zh": "水波把我的影子弄碎。", "en": "The ripples break up my shadow."},
        {"zh": "阳光把我的背晒热。", "en": "Sun warms my back."},
        {"zh": "我在等。", "en": "I am waiting."},
        {"zh": "等很久也没关系。", "en": "Waiting long is no trouble."},
        {"zh": "这是我的本事。", "en": "That is my talent."},
        {"zh": "水退了一寸。", "en": "The water drops an inch."},
        {"zh": "我跟着往下挪了一寸。", "en": "I shuffle down an inch after it."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水面上抬起眼。", "en": "I raise my eyes above the water."},
        {"zh": "你站在河岸上，看不太清。", "en": "You stand on the bank, hard to see."},
        {"zh": "我转过来，尾巴扫起泥。", "en": "I turn and my tail kicks up mud."},
        {"zh": "泥水从我的背上流。", "en": "Muddy water runs off my back."},
        {"zh": "我张了张嘴。", "en": "I open my mouth."},
        {"zh": "又合上了。", "en": "And close it."},
        {"zh": "这样近，我看得清。", "en": "At this distance I see clearly."},
        {"zh": "我的牙很细，但很多。", "en": "My teeth are fine, but many."},
        {"zh": "我贴着河底挪近半尺。", "en": "I creep half a foot closer along the bottom."},
        {"zh": "我只有这么小，别嫌我。", "en": "I'm only this big. Don't hold it against me."},
        {"zh": "我就停下了。", "en": "So I stop."},
        {"zh": "我们隔着半尺水。", "en": "Half a foot of water between us."},
        {"zh": "你先站了起来。", "en": "You rise first."},
        {"zh": "我也沉下去了。", "en": "And I sink away."},
        {"zh": "我的鼻孔在水面上动了一下。", "en": "My nostrils flex above the water."},
        {"zh": "你看见了吗。", "en": "Did you see that?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我翻了个身，溅起水花。", "en": "I roll over, splashing."},
        {"zh": "背甲上多了一道白印。", "en": "A white mark appears on my scutes."},
        {"zh": "我退了半尺。", "en": "I retreat half a foot."},
        {"zh": "尾巴甩了一下。", "en": "My tail lashes once."},
        {"zh": "又浮上来。", "en": "And rise again."},
        {"zh": "我盯着你。", "en": "I stare at you."},
        {"zh": "这次我张开嘴。", "en": "This time I open my mouth."},
        {"zh": "我的硬皮被敲出闷响。", "en": "My hide rings dull under the blow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在水面上扑。", "en": "Something flutters on the surface."},
        {"zh": "我抬头，眼睛跟着它。", "en": "I raise my head and my eyes follow."},
        {"zh": "嘴张得很大。", "en": "My mouth opens wide."},
        {"zh": "一口咬空了。", "en": "I bite only water."},
        {"zh": "它跳开了。", "en": "It has jumped away."},
        {"zh": "我又试了一次。", "en": "I try again."},
        {"zh": "这次咬到了。", "en": "This time I catch it."},
        {"zh": "吞下去。", "en": "And swallow."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你趟水过来，撞到我的背。", "en": "You wade in and hit my back."},
        {"zh": "很硬，我几乎没有感觉。", "en": "It is hard; I barely feel it."},
        {"zh": "你退开，看着脚下。", "en": "You step back and look down."},
        {"zh": "我在你脚边。", "en": "I am at your feet."},
        {"zh": "尾巴扫过你的小腿。", "en": "My tail brushes your calf."},
        {"zh": "水花溅起来。", "en": "Water splashes up."},
        {"zh": "我们都没有出声。", "en": "Neither of us makes a sound."},
        {"zh": "我潜入水里。", "en": "I slide under."},
        {"zh": "只剩鼻子在外面。", "en": "Only my snout remains."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "水暖的时候才轮得到这些。", "en": "This waits for the warm water."},
        {"zh": "泥岸上有别的回应。", "en": "An answer comes from the muddy bank."},
        {"zh": "我们绕着一块石头转。", "en": "We circle a stone."},
        {"zh": "尾巴拍着水。", "en": "Tails slap the water."},
        {"zh": "泥全被搅起来了。", "en": "The mud is churned up."},
        {"zh": "卵会埋在烂叶下面。", "en": "The eggs will lie under rotting leaves."},
        {"zh": "谁也不会来照看。", "en": "No one will come to tend them."},
        {"zh": "太阳替我们看着。", "en": "The sun will watch them for us."},
        {"zh": "我回到水里。", "en": "I return to the water."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住它。", "en": "I bite it."},
        {"zh": "它太硬了。", "en": "It is too hard."},
        {"zh": "我松开，用前爪拨。", "en": "I let go and nudge it with a foreclaw."},
        {"zh": "它翻了个面。", "en": "It turns over."},
        {"zh": "下面有虫。", "en": "There are grubs underneath."},
        {"zh": "我一口吃了。", "en": "I eat them in one bite."},
        {"zh": "我把它拖到水边。", "en": "I drag it to the water."},
        {"zh": "沉下去就藏好了。", "en": "Once it sinks, it is hidden."},
        {"zh": "我趴在它上面。", "en": "I lie on top of it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在岸边喝水。", "en": "Something is drinking at the bank."},
        {"zh": "我只把眼睛露出水面。", "en": "I show only my eyes above the water."},
        {"zh": "水面只动了一点。", "en": "The water moves only slightly."},
        {"zh": "我把身体沉下去。", "en": "I sink my body."},
        {"zh": "只剩眼睛。", "en": "Only my eyes remain."},
        {"zh": "我朝它那边漂。", "en": "I drift toward it."},
        {"zh": "像一段浮木。", "en": "Like a piece of driftwood."},
        {"zh": "它低头又喝了一口。", "en": "It lowers its head for another drink."},
        {"zh": "我已经在它下面。", "en": "I am already beneath it."},
        {"zh": "我这条鳄小得像根木头。", "en": "I'm a caiman the size of a log."},
        {"zh": "水被我撞开。", "en": "The water bursts apart."},
        {"zh": "小凯门鳄跟上去，水花很小。", "en": "The dwarf caiman follows with barely a splash."},
        {"zh": "它抬起头，正对上我的眼。", "en": "It raises its head and meets my eyes."},
        {"zh": "现在我不用藏了。", "en": "Now I need not hide."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着河底跟着。", "en": "I follow along the riverbed."},
        {"zh": "它走一步，我游一步。", "en": "It takes a step; I swim one."},
        {"zh": "水很浑，它看不见我。", "en": "The water is murky; it cannot see me."},
        {"zh": "我的鼻子先到。", "en": "My snout arrives first."},
        {"zh": "然后是我的牙。", "en": "Then my teeth."},
        {"zh": "不是因为它挣脱了。", "en": "Not because it broke free."},
        {"zh": "我还在等。", "en": "I am still waiting."},
        {"zh": "等它把力气用完。", "en": "For it to exhaust itself."},
        {"zh": "它退了三次。", "en": "It retreats three times."},
        {"zh": "我每次都更近。", "en": "Each time I am closer."},
        {"zh": "河湾没有别的出口。", "en": "The bend has no other exit."},
        {"zh": "我堵住了深水那边。", "en": "I block the deep side."},
        {"zh": "它只能往浅处去。", "en": "It can only go shallow."},
        {"zh": "在浅水里它更慢。", "en": "In the shallows it is slower."},
        {"zh": "水只到我的背。", "en": "The water reaches only my back."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "然后整个身体翻过去。", "en": "Then roll my whole body over."},
        {"zh": "它被带倒在水里。", "en": "It is pulled down into the water."},
        {"zh": "我用尾巴抽它的脸。", "en": "My tail whips its face."},
        {"zh": "牙在它皮上滑了一下。", "en": "My teeth slide off its hide."},
        {"zh": "我翻身一滚，把你也带下水。", "en": "I roll over and drag you into the water with me."},
        {"zh": "我往深处拖。", "en": "I drag it deeper."},
        {"zh": "它踢我，水都翻了。", "en": "It kicks and the water churns."},
        {"zh": "我没有松。", "en": "I do not let go."},
        {"zh": "它沉下去一点。", "en": "It sinks a little."},
        {"zh": "我又拖了一下。", "en": "I pull once more."},
        {"zh": "它的手抓到岸边的草。", "en": "Its hand finds the bank grass."},
        {"zh": "我把它拽回来。", "en": "I haul it back."},
        {"zh": "水面上只剩气泡。", "en": "Only bubbles reach the surface."},
        {"zh": "我慢慢浮上来。", "en": "I rise slowly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "河面先起了一圈纹。", "en": "A ring widens on the river."},
        {"zh": "我把鼻子探出来。", "en": "I push my snout out."},
        {"zh": "然后是眼睛。", "en": "Then my eyes."},
        {"zh": "岸上有声音。", "en": "There are sounds on the bank."},
        {"zh": "我没有急着过去。", "en": "I do not hurry over."},
        {"zh": "我先把身体沉好。", "en": "First I settle my body."},
        {"zh": "尾巴在水里摆正。", "en": "My tail straightens in the water."},
        {"zh": "水草挡住了我一半。", "en": "The weeds hide half of me."},
        {"zh": "这样最好。", "en": "That is best."},
        {"zh": "我从泥岸边滑进水里。", "en": "I slide off the muddy bank into the water."},
        {"zh": "泥被我搅起来一点。", "en": "A little mud lifts."},
        {"zh": "很快又沉下去。", "en": "And quickly settles."},
        {"zh": "水面上看不出什么。", "en": "Nothing shows on the surface."},
        {"zh": "我已经在等了。", "en": "I am already waiting."},
        {"zh": "等了很久。", "en": "Have waited a long time."},
        {"zh": "这是我的长处。", "en": "It is my strong point."},
        {"zh": "你最好别下水。", "en": "You had best stay out of the water."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从岸上摔进水里，磕到石头。", "en": "I fall off the bank and strike stone."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "水柱把我掀翻。", "en": "A column of water flips me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西从我背上弹开了。", "en": "It bounces off my back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股麻从尾巴传到头。", "en": "A numbness runs from my tail to my head."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我开始啃水草。", "en": "Hungry enough to chew the weeds."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着水面过来，我僵住了。", "en": "Lightning crosses the water and I lock up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的泥没了，我一直沉。", "en": "The mud is gone and I keep sinking."}
      ]
    }
  }
}
