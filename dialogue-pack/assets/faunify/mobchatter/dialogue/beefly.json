    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀嗡嗡地响", "en": "My wings hum as I fly."},
        {"zh": "我悬在花上面", "en": "I hover over a flower."},
        {"zh": "我飞得歪歪扭扭", "en": "I fly in a crooked line."},
        {"zh": "我抖着腿往前", "en": "I shuffle forward on shaky legs."},
        {"zh": "花丛太密，我挤过去", "en": "The flowers are thick, I squeeze through."},
        {"zh": "我贴着草尖飞", "en": "I skim just over the grass tips."},
        {"zh": "我绕了一圈再回来", "en": "I circle once and come back."},
        {"zh": "我停一下再飞", "en": "I pause, then fly again."},
        {"zh": "花粉沾在我身上", "en": "Pollen sticks to me."},
        {"zh": "我扑扇着往前挪", "en": "I flutter forward."},
        {"zh": "我闻着花找路", "en": "I follow the flowers' scent."},
        {"zh": "草甸上的风推着我", "en": "The meadow breeze pushes me along."},
        {"zh": "我飞得不高", "en": "I do not fly high."},
        {"zh": "我一只翅膀快一点", "en": "One wing beats faster than the other."},
        {"zh": "我从花冠间穿过", "en": "I slip between blossom heads."},
        {"zh": "我落在一片叶子上", "en": "I land on a leaf."}
