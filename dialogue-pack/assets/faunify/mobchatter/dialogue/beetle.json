{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "壳子碰着树皮", "en": "My shell scrapes the bark."},
        {"zh": "我沿树干往上爬", "en": "I climb up the trunk."},
        {"zh": "六条腿一齐动", "en": "All six legs move at once."},
        {"zh": "我飞到下一棵树", "en": "I fly to the next tree."},
        {"zh": "老白桦林很安静", "en": "The old birch forest is quiet."},
        {"zh": "我从树根爬到树杈", "en": "I crawl from root to fork."},
        {"zh": "我压低身子钻进去", "en": "I duck into the gap."},
        {"zh": "硬翅张开又合上", "en": "My wing cases open and clap shut."},
        {"zh": "我踩在松针上滑", "en": "I slip on the pine needles."},
        {"zh": "我背着壳慢慢挪", "en": "I shuffle along under my shell."},
        {"zh": "我绕开树上的洞", "en": "I skirt the hole in the trunk."},
        {"zh": "我停一下再往前", "en": "I pause, then go on."},
        {"zh": "我在树干上找缝", "en": "I search for a crack in the bark."},
        {"zh": "我一只脚落地一只悬空", "en": "One foot down, one in the air."},
        {"zh": "我顺着针叶斜坡走", "en": "I work along the needle slope."},
        {"zh": "我的路都是树", "en": "All my roads are trees."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳色和树皮一样", "en": "My shell is the colour of bark."},
        {"zh": "壳里很安全", "en": "It is safe inside my shell."},
        {"zh": "这片原始林很老", "en": "This old-growth forest is ancient."},
        {"zh": "我慢慢收拢腿", "en": "I slowly tuck my legs in."},
        {"zh": "树汁的味道不错", "en": "The sap smells good."},
        {"zh": "我在等一场雨", "en": "I am waiting for rain."},
        {"zh": "风一吹我就抓紧", "en": "The wind blows and I grip tighter."},
        {"zh": "我听见树里的虫", "en": "I hear insects inside the wood."},
        {"zh": "我几乎不动", "en": "I barely move at all."},
        {"zh": "壳上有细细的纹", "en": "Fine lines run across my shell."},
        {"zh": "这棵树是我的", "en": "This tree is mine."},
        {"zh": "我抖了抖触角", "en": "I twitch my antennae."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠这棵树太近了", "en": "You are too close to this tree."},
        {"zh": "我不是能随便捏的", "en": "I am not something to pinch."},
        {"zh": "我壳很硬", "en": "My shell is hard."},
        {"zh": "你要把我翻过来吗", "en": "Are you going to flip me over?"},
        {"zh": "你手别伸过来", "en": "Do not reach for me."},
        {"zh": "我在看你的靴底", "en": "I am looking at your boot soles."},
        {"zh": "你踩坏了一块树皮", "en": "You broke a piece of bark."},
        {"zh": "我往高处爬一点", "en": "I climb a little higher."},
        {"zh": "你抓不到我", "en": "You cannot catch me."},
        {"zh": "这棵老白桦我爬了三年", "en": "I've climbed this old birch for three years."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳裂了一道", "en": "A crack in my shell."},
        {"zh": "我翻过去了", "en": "I got flipped over."},
        {"zh": "腿有点使不上劲", "en": "My legs will barely move."},
        {"zh": "我被踩到了", "en": "I was stepped on."},
        {"zh": "我把腿收进壳下", "en": "I tuck my legs under my shell."},
        {"zh": "壳上留了个坑", "en": "There is a dent in my shell."},
        {"zh": "我爬得很慢", "en": "I crawl very slowly."},
        {"zh": "你把我撞下树了", "en": "You knocked me off the tree."},
        {"zh": "我还活着", "en": "I am still alive."},
        {"zh": "壳上又多了个坑", "en": "Another dent in my shell."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是树汁吗", "en": "Is that sap?"},
        {"zh": "我闻到朽木味", "en": "I smell rotting wood."},
        {"zh": "你放那儿就行", "en": "Just set it there."},
        {"zh": "我要凑过去看看", "en": "I will come over and look."},
        {"zh": "甜的东西我都要", "en": "I want anything sweet."},
        {"zh": "手别收回去", "en": "Do not pull your hand back."},
        {"zh": "我慢慢地爬过去", "en": "I crawl over slowly."},
        {"zh": "那堆木头不错", "en": "That pile of wood looks good."},
        {"zh": "我往前爬了几步", "en": "I crawled forward a few steps."},
        {"zh": "我壳上沾了渣", "en": "Crumbs on my shell."}
      ]
