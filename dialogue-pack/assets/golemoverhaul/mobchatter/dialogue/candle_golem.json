    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "摇摇晃晃向前移动", "en": "Shambles forward"},
        {"zh": "蜡烛摇曳着前行", "en": "Wax candles sway"},
        {"zh": "步履蹒跚地挪动", "en": "Stumbles forward"},
