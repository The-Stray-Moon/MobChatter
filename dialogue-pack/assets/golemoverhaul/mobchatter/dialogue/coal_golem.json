{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "踏着沉重的步伐挪动着身躯。", "en": "Stomps its heavy body slowly."},
        {"zh": "煤炭的身躯在地上缓慢滑行。", "en": "Coal body slides slowly on the ground."},
        {"zh": "用煤炭的手臂艰难地行走。", "en": "Moves with coal arms struggling."},
        {"zh": "在矿石中缓慢地移动着。", "en": "Moves slowly among the coal."},
        {"zh": "笨拙地挪动着巨大的身躯。", "en": "Moves笨拙ly with its huge body."},
        {"zh": "缓慢地迈着步子前行。", "en": "Stretches its legs slowly."},
        {"zh": "煤炭之躯发出沙沙声。", "en": "Coal body makes沙沙 noises."},
        {"zh": "脚踩在矿石上发出响声。", "en": "Feet make noise on coal."},
        {"zh": "缓缓地在矿渣中穿行。", "en": "Moves slowly through the coal debris."},
        {"zh": "用煤块支撑着前进。", "en": "Forwards with coal blocks."},
        {"zh": "煤块顺着矿脉往前挪。", "en": "Coal chunks shift along the ore vein."},
        {"zh": "一步一晃，碎煤掉在地上。", "en": "I lurch a step and drop bits of coal."},
        {"zh": "沿着煤矿石慢慢走过去。", "en": "I walk slowly along the coal ore."},
        {"zh": "关节里的煤渣簌簌落下。", "en": "Coal dust sifts from my joints."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站立在矿石堆中沉思。", "en": "Stands in coal stack, thinking."},
        {"zh": "煤块堆成我，别点火。", "en": "Coal stacked into me — don't light a match."},
        {"zh": "靠煤块站着，懒得多动。", "en": "Standing on coal chunks, too lazy to move."},
        {"zh": "煤炭躯体微微颤抖。", "en": "Coal body trembles slightly."},
        {"zh": "在矿石堆中缓缓休息。", "en": "Rests slowly in the coal pile."},
        {"zh": "在矿石中沉思片刻。", "en": "Meditates in coal for a moment."},
        {"zh": "默默站在矿石堆旁。", "en": "Stands quietly beside the coal."},
        {"zh": "静静地伫立着。", "en": "Stands quietly."},
        {"zh": "缓缓地呼吸着。", "en": "Breathes slowly."},
        {"zh": "凝视着周围的矿石。", "en": "Stares at the surrounding coal."},
        {"zh": "靠在矿壁上，慢慢冷却。", "en": "I lean on the seam and cool down."},
        {"zh": "裂缝里还有一点火星。", "en": "A little ember still glows in my crack."},
        {"zh": "站着不动，像一堆煤。", "en": "Standing still, I look like a pile of coal."},
        {"zh": "等一块煤炭递到手上。", "en": "I wait for a piece of coal to be handed to me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "注意到玩家后，缓缓转动头颅。", "en": "Turns its head slowly at the player."},
        {"zh": "盯着玩家，充满敌意。", "en": "Stares at the player, hostilely."},
        {"zh": "发现玩家后，眼中闪烁着光芒。", "en": "Eyes glow when spotting the player."},
        {"zh": "转动头部，锁定玩家。", "en": "Turns its head to lock on the player."},
        {"zh": "察觉玩家后，发出嘶嘶声。", "en": "Makes hissing sound upon noticing the player."},
        {"zh": "我背上的煤，一擦就着。", "en": "The coal on my back lights with one spark."},
        {"zh": "注视玩家，眼中满是火焰。", "en": "Glows with fire in its eyes on the player."},
        {"zh": "转向玩家，全身发出热量。", "en": "Turns towards the player, emitting heat."},
        {"zh": "锁定玩家，准备行动。", "en": "Locks on the player, ready to act."},
        {"zh": "煤块还热着，别靠太近。", "en": "My coals are still hot — don't come close."},
        {"zh": "我抬头，认出你的镐。", "en": "I lift my head and recognize your pickaxe."},
        {"zh": "转过身，把矿脉挡在身后。", "en": "I turn to put the ore vein behind me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体开始裂开。", "en": "My body starts to crack."},
        {"zh": "我的骨架变得摇摇欲坠。", "en": "My bones are shaky."},
        {"zh": "煤炭碎片在我的身体中掉落。", "en": "Coal shreds fall from my body."},
        {"zh": "我感到虚弱，无法站稳。", "en": "I feel weak and stagger."},
        {"zh": "我的膝盖松了，站不直了。", "en": "My knees loosen, and I can't stand straight."},
        {"zh": "我的关节开始发出嘎吱声。", "en": "My joints creak."},
        {"zh": "一道裂缝从我的肩裂到腰。", "en": "A crack splits me from shoulder to waist."},
        {"zh": "我开始摇晃。", "en": "I start to shake."},
        {"zh": "我的身体开始腐烂。", "en": "My body starts to rot."},
        {"zh": "我感到非常疲惫。", "en": "I feel extremely tired."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "靠近我你会后悔！", "en": "You'll regret getting close!"},
        {"zh": "煤炭是我的力量！", "en": "Coal is my power!"},
        {"zh": "不要动我的煤炭！", "en": "Don't touch my coal!"},
        {"zh": "你再靠近煤堆，我就点自己。", "en": "One step closer to the coal and I'll light myself."},
        {"zh": "火是我的力量！", "en": "Fire is my strength!"},
        {"zh": "煤炭是永恒的燃料！", "en": "Coal is eternal fuel!"},
        {"zh": "我的煤芯跳了一下。", "en": "My coal core just sparked."},
        {"zh": "火焰是我的守护！", "en": "Flame is my guard!"},
        {"zh": "煤炭，我的生命源泉！", "en": "Coal, my source of life!"},
        {"zh": "燃烧吧，为了自由！", "en": "Burn for freedom!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踢掉了我腿上一块煤。", "en": "You kick a lump of coal off my leg."},
        {"zh": "你撞疼我了！", "en": "You hit me!"},
        {"zh": "我是用煤炭做成的！", "en": "I'm made of coal!"},
        {"zh": "不要动我！", "en": "Don't move me!"},
        {"zh": "我的身体很坚固！", "en": "My body is strong!"},
        {"zh": "我是无生命的！", "en": "I'm lifeless!"},
        {"zh": "别碰我，我没感觉！", "en": "Don't touch me, I don't feel!"},
        {"zh": "我的身体无法移动！", "en": "I can't move!"},
        {"zh": "我是煤炭制成的！", "en": "I'm made of coal!"},
        {"zh": "我不在乎你！", "en": "I don't care about you!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我想要煤炭！", "en": "I want coal!"},
        {"zh": "煤炭是我的另一半！", "en": "Coal is my mate!"},
        {"zh": "我是单身，快来！", "en": "I'm single, come on!"},
        {"zh": "煤炭，我的伴侣！", "en": "Coal, my mate!"},
        {"zh": "你有煤炭吗？", "en": "Do you have coal?"},
        {"zh": "我们共同取暖！", "en": "We warm together!"},
        {"zh": "我是为了煤炭而活！", "en": "I live for coal!"},
        {"zh": "煤炭是我的一切！", "en": "Coal is everything to me!"},
        {"zh": "找到我的煤炭吧！", "en": "Find my coal!"},
        {"zh": "煤炭是我唯一的爱！", "en": "Coal is my only love!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "煤炭融入我的身体！", "en": "Coal melds into me!"},
        {"zh": "煤炭赋予我力量！", "en": "Coal empowers me!"},
        {"zh": "煤炭之魂觉醒！", "en": "Coal spirit awakens!"},
        {"zh": "煤炭燃烧吧！", "en": "Coal burns!"},
        {"zh": "煤炭，我的生命之源！", "en": "Coal, my source of life!"},
        {"zh": "煤炭闪耀光芒！", "en": "Coal glows!"},
        {"zh": "燃烧吧，煤炭！", "en": "Burn, coal!"},
        {"zh": "煤炭让我复活！", "en": "Coal revives me!"},
        {"zh": "煤炭的火焰在燃烧！", "en": "Coal flames burn!"},
        {"zh": "煤炭塞进裂缝，身子又稳了。", "en": "Coal packed into the crack steadies me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见了敌人！", "en": "I see an enemy!"},
        {"zh": "矿石边的影子只有三步远。", "en": "The shadow by the ore is only three steps away."},
        {"zh": "我闻到了恐惧！", "en": "I smell fear!"},
        {"zh": "火苗蹿上我的肩，我朝那边走。", "en": "Flames climb my shoulder, and I head that way."},
        {"zh": "燃烧的怒火在心中！", "en": "Burning rage in my heart!"},
        {"zh": "火焰引导我行动！", "en": "Flames guide me!"},
        {"zh": "敌人来了，我要攻击！", "en": "Enemy comes, I attack!"},
        {"zh": "我要保护我的矿石！", "en": "I protect my coal!"},
        {"zh": "燃烧的复仇之火！", "en": "Burning revenge!"},
        {"zh": "燃烧的怒焰爆发！", "en": "Bursting flames of fury!"},
        {"zh": "打火石一响，我睁开了眼。", "en": "The flint strikes, and I open my eyes."},
        {"zh": "身上着了火，我认出了敌人。", "en": "Aflame, I recognize the enemy."},
        {"zh": "有个影子靠近了矿石。", "en": "A shadow came near the ore."},
        {"zh": "我站起来，朝那边走。", "en": "I stand up and walk that way."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我将你置于死地！", "en": "I'll put you down!"},
        {"zh": "燃烧的火焰将你吞噬！", "en": "Flames consume you!"},
        {"zh": "燃烧之火，吞噬一切！", "en": "Burning flames, consume all!"},
        {"zh": "火焰引导我攻击！", "en": "Flames guide my attack!"},
        {"zh": "火焰中你无法逃脱！", "en": "Escaping in flames is futile!"},
        {"zh": "火焰之吻，即将来临！", "en": "Flame kiss coming!"},
        {"zh": "燃烧之怒，燃烧吧！", "en": "Burning rage, burn!"},
        {"zh": "燃烧之炎，席卷一切！", "en": "Burning flames, sweep all!"},
        {"zh": "火焰中的死亡！", "en": "Death in flames!"},
        {"zh": "燃烧的烈焰，吞噬你！", "en": "Burning flames, consume you!"},
        {"zh": "火从裂缝里冒出来。", "en": "Fire pushes out of my cracks."},
        {"zh": "我直直走向那个敌人。", "en": "I walk straight at that enemy."},
        {"zh": "这一下要烧穿对方。", "en": "This blow must burn through."},
        {"zh": "燃尽了也要撞上去。", "en": "Even if I burn out, I will ram it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "敲击地面，煤炭碎裂声响起。", "en": "Bang! Coal shatters."},
        {"zh": "煤炭之躯挥动，火花四溅。", "en": "Coal body swings, sparks fly."},
        {"zh": "我胸口的煤缝里挤出火星。", "en": "Sparks squeeze from the coal seams in my chest."},
        {"zh": "火焰围绕其身，化为灰烬。", "en": "Flame surrounds it, turning to ash."},
        {"zh": "煤炭碎片在手中握紧。", "en": "Coal fragments clench in its hand."},
        {"zh": "火焰跳跃，照亮黑暗。", "en": "Fire leaps, lighting the dark."},
        {"zh": "打火石一划，我就烧起来。", "en": "One strike of flint and steel, and I burn."},
        {"zh": "火焰燃烧，生命即将耗尽。", "en": "Fire burns, life nearly gone."},
        {"zh": "煤炭傀儡发出怒吼。", "en": "Coal golem roars in anger."},
        {"zh": "燃烧的煤炭在手中摇晃。", "en": "Burning coal wavers in hand."},
        {"zh": "烧红的拳头砸下去！", "en": "A red-hot fist comes down!"},
        {"zh": "煤块带着火飞出去！", "en": "Burning coal flies off me!"},
        {"zh": "抱住敌人一起烧！", "en": "I hold the enemy and burn with it!"},
        {"zh": "一声闷响，火星四溅！", "en": "A dull thud, and sparks scatter!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "煤炭在黑暗中凝聚。", "en": "Coal gathers in the dark."},
        {"zh": "矿石周围出现了影子。", "en": "Shadows appear around coal."},
        {"zh": "地底深处的煤炭蠕动。", "en": "Coal stirs from the depths."},
        {"zh": "黑影从煤矿中升起。", "en": "Shadow rises from coal."},
        {"zh": "矿石中裂开，傀儡出现。", "en": "Cracks appear in coal, golem emerges."},
        {"zh": "煤炭中透出微弱光芒。", "en": "A weak light appears in coal."},
        {"zh": "黑暗中的煤炭开始移动。", "en": "Coal moves in the darkness."},
        {"zh": "矿石缝隙中露出黑影。", "en": "Shadow peeks from coal cracks."},
        {"zh": "从矿石中缓缓走出傀儡。", "en": "Golem slowly walks from coal."},
        {"zh": "煤炭碎片汇聚成傀儡。", "en": "Coal fragments coalesce into golem."},
        {"zh": "煤矿石旁多了一堆人形。", "en": "A man-shaped heap appears by the coal ore."},
        {"zh": "矿洞深处，煤渣聚拢起来。", "en": "Deep in the mine, coal dust gathers."},
        {"zh": "石缝里站起来一个黑影。", "en": "A dark shape stands up from a stone crack."},
        {"zh": "煤块自己叠成了傀儡。", "en": "Coal stacks itself into a golem."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧在我的皮肤上。", "en": "Fire burns my skin."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "煤块掉了一地，还能捡回。", "en": "Coal scattered, but I can gather it."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我被煤炭淹没。", "en": "I drown in coal."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我的煤块炸开，散了一地。", "en": "My coal bursts apart and scatters across the ground."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "煤炭射中了我的身体。", "en": "Coal hits me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔力撕开了我的身体。", "en": "Magic tears my body apart."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿侵蚀了我的身体。", "en": "Starvation eats away at me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "煤层里挨了一记雷。", "en": "Lightning struck me in the coal seam."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗吞噬了我的灵魂。", "en": "Darkness devours my soul."}
      ]
    }
  }
}
