{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "踏着沉重的步伐移动。", "en": "Moving with heavy steps."},
        {"zh": "机械身躯缓缓前行。", "en": "Mechanical body moves slowly."},
        {"zh": "黏土构成的身躯蹒跚前行。", "en": "Clay body shuffles forward."},
        {"zh": "步履沉重，仿佛承载着历史。", "en": "Heavy footsteps, carrying history."},
        {"zh": "向着光源移动。", "en": "Moving towards the light."},
        {"zh": "在恶地中艰难前行。", "en": "Struggling in the Wither Desert."},
        {"zh": "朝向光源慢慢走来。", "en": "Slowly walking towards the light."},
        {"zh": "机械的脚步声回荡。", "en": "Mechanical footsteps echo."},
        {"zh": "沉重的步伐敲击着地面。", "en": "Heavy footsteps on the ground."},
        {"zh": "在荒凉之地缓慢行进。", "en": "Moving slowly in the barren land."},
        {"zh": "陶土的双腿在砂砾上磨响。", "en": "My terracotta legs grind on the gravel."},
        {"zh": "我绕开红色的恶地土柱。", "en": "I steer around the red badland spires."},
        {"zh": "每一步都踩出一条浅印。", "en": "Every step leaves a shallow print."},
        {"zh": "我朝着一处光慢慢挪动。", "en": "I shuffle slowly toward a patch of light."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静止时发出低沉的声音。", "en": "Making low sounds when idle."},
        {"zh": "机械般僵硬地站立。", "en": "Standing stiffly like a machine."},
        {"zh": "偶尔回头观察。", "en": "Occasionally glancing around."},
        {"zh": "烈日把我晒得更硬了。", "en": "The sun bakes me harder."},
        {"zh": "凝视远方，机械的眼。", "en": "Gazing into the distance, mechanical eyes."},
        {"zh": "沉默地站立在原地。", "en": "Standing silently in place."},
        {"zh": "偶有轻微的颤动。", "en": "Occasional slight tremors."},
        {"zh": "机械地站立不动。", "en": "Standing still like a machine."},
        {"zh": "静静等待着命令。", "en": "Quietly waiting for orders."},
        {"zh": "机械身躯显得笨拙。", "en": "Mechanical body seems clumsy."},
        {"zh": "红砂落在我肩上，我不擦。", "en": "Red sand settles on my shoulder; I do not brush it off."},
        {"zh": "我的关节里塞着干泥。", "en": "Dry clay is packed in my joints."},
        {"zh": "恶地一天要刮两次风。", "en": "The badlands blow wind twice a day."},
        {"zh": "我一动不动，假装是块陶。", "en": "I hold still and pass for pottery."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "注意到玩家，眼中闪烁。", "en": "Noticing the player, eyes flicker."},
        {"zh": "盯住玩家，机械眼神。", "en": "Fixing the player with its mechanical gaze."},
        {"zh": "恶地的陶土烧成我，眼睛很亮。", "en": "Badlands clay baked me; my eyes are bright."},
        {"zh": "转向玩家的方向。", "en": "Turning towards the player."},
        {"zh": "机械眼盯着玩家。", "en": "Mechanical eyes盯着the player."},
        {"zh": "我眼里两簇火光，跟着你走。", "en": "Two embers in my eyes follow you."},
        {"zh": "盯紧玩家，准备行动。", "en": "Fixing the player, ready to act."},
        {"zh": "盯着玩家，一动不动。", "en": "Staring at the player, immobile."},
        {"zh": "我这身陶土，裂了能补。", "en": "My terracotta cracks, and clay can patch it."},
        {"zh": "你的靴子上有陶土粉。", "en": "There is clay dust on your boots."},
        {"zh": "你手里是黏土球吗？", "en": "Is that a clay ball in your hand?"},
        {"zh": "我转过头，陶片咔咔响。", "en": "I turn my head and my shards clack."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "脆弱的身躯在颤抖。", "en": "Shaky body."},
        {"zh": "泥土在裂开。", "en": "Cracking clay."},
        {"zh": "裂缝蔓延开来。", "en": "Cracks spreading."},
        {"zh": "沙土开始剥落。", "en": "Sand peeling off."},
        {"zh": "结构开始松动。", "en": "Structure weakening."},
        {"zh": "碎片剥落了。", "en": "Fragments falling."},
        {"zh": "泥土开始剥落。", "en": "Clay peeling off."},
        {"zh": "碎片飞溅。", "en": "Splinters flying."},
        {"zh": "陶片掉了一块，还能走。", "en": "A shard fell off; I can still walk."},
        {"zh": "裂缝从肩头爬到腰。", "en": "A crack crawls from shoulder to waist."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "看到仙人掌了，我能吃点吗？", "en": "Can I eat some cactus?"},
        {"zh": "黏土球是我的食物！", "en": "Clay balls are my food!"},
        {"zh": "别靠近我，我是活的！", "en": "Don't get close, I'm alive!"},
        {"zh": "我在恶地等待我的食物。", "en": "I wait for my food in the Wasteland."},
        {"zh": "附近的食物就是我的目标。", "en": "Food nearby is my target."},
        {"zh": "我是自然的产物，不是玩具。", "en": "I'm a natural creation, not a toy."},
        {"zh": "石头和黏土是我的盟友。", "en": "Stone and clay are my allies."},
        {"zh": "我用黏土球修补自己。", "en": "I repair myself with clay balls."},
        {"zh": "枯萎灌木让我射箭攻击。", "en": "Withered shrubs make me shoot."},
        {"zh": "仙人掌让我变得更强。", "en": "Cacti make me stronger."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，我会撞倒你！", "en": "Watch out, I'll knock you down!"},
        {"zh": "我是固体，别撞我！", "en": "I'm solid, don't bump me!"},
        {"zh": "粘土让我身体坚硬。", "en": "Clay makes my body hard."},
        {"zh": "我可以用身体阻挡。", "en": "I can block with my body."},
        {"zh": "我在恶地巡逻。", "en": "I patrol the Wasteland."},
        {"zh": "我不会轻易移动。", "en": "I don't move easily."},
        {"zh": "我只能撞倒，不能杀死。", "en": "I can only knock down, not kill."},
        {"zh": "我在原地等待敌人。", "en": "I wait in place for enemies."},
        {"zh": "被我撞倒的敌人很危险。", "en": "Enemies knocked down by me are dangerous."},
        {"zh": "我用身体挡住危险。", "en": "I use my body to block danger."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到伴侣才能繁殖！", "en": "Find a mate to reproduce!"},
        {"zh": "我需要黏土来繁殖。", "en": "I need clay to reproduce."},
        {"zh": "自然生成的我，需要自然的伴侣。", "en": "I naturally generate, I need a natural mate."},
        {"zh": "我只能在恶地找到伴侣。", "en": "I can only find a mate in the Wasteland."},
        {"zh": "黏土傀儡需要粘土。", "en": "Terracotta needs clay."},
        {"zh": "黏土把我们两个捏在一起了。", "en": "Clay pressed the two of us together."},
        {"zh": "繁殖是我存在的意义。", "en": "Reproduction is my purpose."},
        {"zh": "我和我的伴侣一起成长。", "en": "I grow with my partner."},
        {"zh": "黏土是我的生命源泉。", "en": "Clay is my source of life."},
        {"zh": "我需要伴侣才能继续。", "en": "I need a partner to continue."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我被黏土修复了！", "en": "I'm repaired by clay!"},
        {"zh": "黏土球救了我一命！", "en": "Clay saved me!"},
        {"zh": "我吸收了新的能量！", "en": "I absorb new energy!"},
        {"zh": "这里有点冷，但没关系。", "en": "A bit cold, but no big deal."},
        {"zh": "我被用来对付敌人！", "en": "Used to fight enemies!"},
        {"zh": "黏土是我的生命来源。", "en": "Clay is my life source."},
        {"zh": "我将保护我的地盘。", "en": "I'll protect my territory."},
        {"zh": "光照不到的地方更适合我。", "en": "I thrive in the dark."},
        {"zh": "这些仙人掌让我更强了！", "en": "These cacti made me stronger!"},
        {"zh": "枯萎灌木赋予我远程攻击。", "en": "Withered shrubs gave me range."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物出现了，我要吃掉它！", "en": "Prey spotted, I'll eat it!"},
        {"zh": "我要去捕捉那个东西。", "en": "Going to catch that thing."},
        {"zh": "我盯上那只生物了。", "en": "Got my target."},
        {"zh": "这是我的，我要吃了。", "en": "Mine, eating time."},
        {"zh": "敌人在我的领地里。", "en": "Enemy in my territory."},
        {"zh": "恶地的每一粒沙，都归我看守。", "en": "Every grain of badlands sand is mine to guard."},
        {"zh": "我不能让敌人靠近。", "en": "Enemies can't get close."},
        {"zh": "我要守护我的家。", "en": "Guarding my home."},
        {"zh": "我的目标就在那里。", "en": "Target there."},
        {"zh": "我要去攻击那个。", "en": "Going to attack that."},
        {"zh": "有东西踩到了我的影子。", "en": "Something stepped on my shadow."},
        {"zh": "我抬头，砂土从缝里漏下。", "en": "I look up and sand leaks from my seams."},
        {"zh": "你身上有仙人掌的气味。", "en": "You carry the smell of cactus."},
        {"zh": "恶地来客，我记下了。", "en": "A badlands visitor — noted."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我要攻击它，消灭它！", "en": "Attacking, destroying it!"},
        {"zh": "我要用尽全力击败它。", "en": "Going all out to beat it."},
        {"zh": "我瞄准了它的弱点。", "en": "Aimed at its weak point."},
        {"zh": "我要击溃它的防御。", "en": "Breaking its defense."},
        {"zh": "我要用仙人掌攻击它。", "en": "Attacking with cacti."},
        {"zh": "我要射出火焰击中它。", "en": "Shooting flames at it."},
        {"zh": "我要用尖刺攻击它。", "en": "Attacking with spines."},
        {"zh": "我要用石头砸向它。", "en": "Throwing rocks at it."},
        {"zh": "我要用棍子击打它。", "en": "Attacking with a stick."},
        {"zh": "我要用斧头劈砍它。", "en": "Attacking with an axe."},
        {"zh": "脚下的恶地沙，被我踩实了。", "en": "The badlands sand packs firm under my feet."},
        {"zh": "手里的仙人掌举起来了。", "en": "The cactus in my grip comes up."},
        {"zh": "枯萎灌木已经装好了。", "en": "The dead bush is already loaded."},
        {"zh": "你退到陶土柱后也没用。", "en": "Hiding behind a terracotta pillar won't help."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "沉重的石锤落下！", "en": "Heavy stone hammer falls!"},
        {"zh": "石爪紧紧抓住你！", "en": "Stone claws grab you!"},
        {"zh": "大地之力，我来了！", "en": "Power of the earth, here I come!"},
        {"zh": "黏土球，给我力量！", "en": "Clay balls, give me strength!"},
        {"zh": "碎石如雨，你难逃！", "en": "Rocks rain down, you can't escape!"},
        {"zh": "沉重的脚步声！", "en": "Heavy footsteps!"},
        {"zh": "石身，坚不可摧！", "en": "Stone body, unbreakable!"},
        {"zh": "恶地的陶土，硬得很。", "en": "Badlands clay bakes hard."},
        {"zh": "大地，将你吞噬！", "en": "Earth will consume you!"},
        {"zh": "石块如子弹！", "en": "Stone chunks, like bullets!"},
        {"zh": "陶土拳头砸在盾上！", "en": "A terracotta fist slams your shield!"},
        {"zh": "仙人掌扎进你的手臂！", "en": "The cactus spikes bury in your arm!"},
        {"zh": "死灌木射出，接住！", "en": "A dead bush fires out — catch!"},
        {"zh": "我整块压过去，别硬扛！", "en": "I press down with my whole bulk — don't brace!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "粘土人偶，觉醒！", "en": "Clay figure awakens!"},
        {"zh": "从尘土中诞生！", "en": "Born from dust!"},
        {"zh": "恶地之心，跳动！", "en": "Heart of the Wither beats!"},
        {"zh": "荒原的守护者！", "en": "Guardian of the wasteland!"},
        {"zh": "粘土之魂，凝聚！", "en": "Clay soul, coalesces!"},
        {"zh": "大地之力，显灵！", "en": "Power of the earth, manifests!"},
        {"zh": "石之巨人，苏醒！", "en": "Stone giant awakens!"},
        {"zh": "粘土的意志，坚不可摧！", "en": "Will of clay, unbreakable!"},
        {"zh": "恶地的召唤，应答！", "en": "Wither's call, answered!"},
        {"zh": "大地的宠儿，降临！", "en": "Child of earth, descends!"},
        {"zh": "恶地的沙堆鼓起一块。", "en": "A mound rises from the badlands sand."},
        {"zh": "陶土人偶沾到光，活了。", "en": "The clay figurine catches light and comes alive."},
        {"zh": "我抖落身上的红砂站起来。", "en": "I shake off the red sand and stand."},
        {"zh": "窑火早就熄了，我还站着。", "en": "The kiln fire died long ago; I still stand."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰烧灼我的身体。", "en": "Flames burn me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "陶土的身，落地碎了几片。", "en": "A clay body; a few pieces broke on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "淤泥掩盖了我。", "en": "Silt covered me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我半边身子都酥了。", "en": "The blast left half of me crumbly."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "被碎石击中。", "en": "Hit by rocks."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔力击中了我。", "en": "Magic hit me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我没胃口，可身子在散。", "en": "I have no appetite, yet I am coming apart."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷火烤过，我反倒更硬了。", "en": "The lightning baked me harder than before."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我这身陶土正在裂。", "en": "My terracotta hide is cracking."}
      ]
    }
  }
}
