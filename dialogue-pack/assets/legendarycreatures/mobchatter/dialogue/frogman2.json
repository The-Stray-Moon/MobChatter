{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我弓着腿一蹦一蹦地走。", "en": "I hop along on bent legs."},
        {"zh": "落脚时，草地湿了一片。", "en": "Where I land, the grass goes wet."},
        {"zh": "我的皮肤是暗绿的，带黄斑。", "en": "My skin is dark green with yellow spots."},
        {"zh": "喉囊鼓起来又瘪下去。", "en": "My throat sac swells and deflates."},
        {"zh": "我朝沼泽边的浅水去。", "en": "I head for the shallows by the marsh."},
        {"zh": "脚趾间有膜，踩泥很稳。", "en": "Webbed toes give me grip in the mud."},
        {"zh": "我跳过一丛芦苇。", "en": "I hop over a clump of reeds."},
        {"zh": "水花溅在我的肚子上。", "en": "Water splashes my belly."},
        {"zh": "我背后留下黏液。", "en": "Slime trails behind me."},
        {"zh": "草叶碰到就发黑。", "en": "Grass blackens where it touches."},
        {"zh": "我停下来舔了舔眼。", "en": "I stop and lick my eye."},
        {"zh": "我停在芦苇边，看清了虫。", "en": "I stop by the reeds and sight a bug."},
        {"zh": "前面有虫子。", "en": "There are insects ahead."},
        {"zh": "我踩着湿泥，一蹦一蹦。", "en": "I hop through the wet mud, one bound at a time."},
        {"zh": "然后我扑了。", "en": "Then I pounce."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在泥里，只露出眼和鼻。", "en": "I squat in the mud; only my eyes and nose show."},
        {"zh": "水面上有一层油光。", "en": "An oily film lies on the water."},
        {"zh": "那是我留下的。", "en": "I left it there."},
        {"zh": "有蜻蜓落在我头上。", "en": "A dragonfly lands on my head."},
        {"zh": "我眨了眨眼，喉囊鼓起来。", "en": "I blink, and my throat sac swells."},
        {"zh": "蜻蜓落在我背上，又飞走。", "en": "A dragonfly lands on my back and leaves."},
        {"zh": "一声很低的呱。", "en": "A very low croak."},
        {"zh": "附近的虫都停了。", "en": "Every insect nearby stops."},
        {"zh": "过了一会才又叫。", "en": "Only later do they start again."},
        {"zh": "我的皮，滴着毒液。", "en": "My skin drips venom."},
        {"zh": "泥水从我背上滑下去。", "en": "Muddy water slides off my back."},
        {"zh": "泥慢慢把我埋起来。", "en": "The mud slowly buries me."},
        {"zh": "我往深处挪了挪。", "en": "I shift a little deeper."},
        {"zh": "水面上有虫在打转。", "en": "Insects circle above the surface."},
        {"zh": "毒蛙人蹲着，不动最好。", "en": "A poison frogman crouches. Stillness is best."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水里抬起头，正对你。", "en": "I raise my head from the water, facing you."},
        {"zh": "你站在岸上，离水很远。", "en": "You stand on the bank, well away from the water."},
        {"zh": "我慢慢爬上来。", "en": "I climb out slowly."},
        {"zh": "水从我的腿间滴下。", "en": "Water drips between my legs."},
        {"zh": "草在我脚下变色。", "en": "The grass changes colour at my feet."},
        {"zh": "你也看见了。", "en": "You see it too."},
        {"zh": "你退开，草已经被我染黑。", "en": "You step back; the grass is already black."},
        {"zh": "就看着你。", "en": "And simply watch you."},
        {"zh": "我把嘴张了张。", "en": "I open my mouth slightly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "皮肤上破了一块。", "en": "A patch of skin breaks."},
        {"zh": "流出来的东西是浊的。", "en": "What seeps out is cloudy."},
        {"zh": "毒液从破口处淌下来。", "en": "Venom trickles from the tear."},
        {"zh": "喉囊瘪下去。", "en": "My throat sac deflates."},
        {"zh": "我转过来。", "en": "I turn around."},
        {"zh": "眼睛一直盯着你。", "en": "My eyes stay on you."},
        {"zh": "草在我脚下枯了一圈。", "en": "The grass withers in a ring around me."},
        {"zh": "我只是慢慢挪近。", "en": "I simply creep closer."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "虫子动了。", "en": "An insect moves."},
        {"zh": "我的舌头比我的手快。", "en": "My tongue is faster than my hands."},
        {"zh": "我舔了舔嘴。", "en": "I lick my lips."},
        {"zh": "这不算一顿。", "en": "That is not a meal."},
        {"zh": "我看向你手里的东西。", "en": "I look at what is in your hand."},
        {"zh": "它不动。", "en": "It does not move."},
        {"zh": "我失去了兴趣。", "en": "I lose interest."},
        {"zh": "我又转回水里。", "en": "I turn back to the water."},
        {"zh": "水里有更多。", "en": "There is more in the water."},
        {"zh": "我从泥里伸出手。", "en": "I reach out of the mud."},
        {"zh": "我又缩回去。", "en": "I pull my hand back."},
        {"zh": "等下一次。", "en": "For the next chance."},
        {"zh": "水边的虫总是很多。", "en": "There are always insects by the water."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，手黏了一下。", "en": "You bump me; your hand comes away sticky."},
        {"zh": "你甩了两下，甩不掉。", "en": "You shake it twice; it stays."},
        {"zh": "你往后跳了一步。", "en": "You jump back a step."},
        {"zh": "那一小块皮肤已经开始发麻。", "en": "That patch of skin is already numb."},
        {"zh": "你撞上来，手上全是黏液。", "en": "You bump me and your hand comes away slick."},
        {"zh": "我只是站在那儿。", "en": "I merely stood there."},
        {"zh": "草在我脚下黑了一片。", "en": "The grass blackens under me."},
        {"zh": "别碰我，我身上可不干净。", "en": "Don't touch me, I'm not exactly clean."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "雨季开始的时候。", "en": "When the rains begin."},
        {"zh": "沼泽里都是叫声。", "en": "The marsh is full of calls."},
        {"zh": "我也叫。", "en": "I call too."},
        {"zh": "喉咙鼓得很大。", "en": "My throat swells hugely."},
        {"zh": "有别的回应。", "en": "Another answers."},
        {"zh": "我们朝彼此游。", "en": "We swim toward each other."},
        {"zh": "水被搅得发浑。", "en": "The water grows murky."},
        {"zh": "卵会粘在水草上。", "en": "The eggs will stick to the weeds."},
        {"zh": "一串一串的。", "en": "In long strings."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用舌头把它卷住。", "en": "I catch it with my tongue."},
        {"zh": "太快了，几乎看不见。", "en": "So fast it is almost unseen."},
        {"zh": "我咽下去。", "en": "I swallow."},
        {"zh": "它滚进水里。", "en": "It rolls into the water."},
        {"zh": "我看着它沉下去。", "en": "I watch it sink."},
        {"zh": "然后没有再看。", "en": "Then look away."},
        {"zh": "我转头找别的。", "en": "I turn to look for something else."},
        {"zh": "水边总是有的。", "en": "There is always something by the water."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西靠近了水边。", "en": "Something has come near the water."},
        {"zh": "我伏着不动。", "en": "I lie without stirring."},
        {"zh": "后腿收起来。", "en": "My hind legs gather."},
        {"zh": "皮肤上的腺体鼓了。", "en": "The glands in my skin swell."},
        {"zh": "一股甜腥的味道散开。", "en": "A sweet, rank smell spreads."},
        {"zh": "它闻到了。", "en": "It smells it."},
        {"zh": "它抬起头。", "en": "It raises its head."},
        {"zh": "太近了。", "en": "Too close."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着它走。", "en": "I circle it."},
        {"zh": "每一步都留下湿痕。", "en": "Every step leaves a wet mark."},
        {"zh": "它想往岸上退。", "en": "It tries to back onto the bank."},
        {"zh": "我先一步挡住。", "en": "I am already in the way."},
        {"zh": "它伸手推我。", "en": "It pushes at me."},
        {"zh": "手上沾了黏液。", "en": "Its hand comes away slick."},
        {"zh": "它甩了甩，甩不掉。", "en": "It shakes it off and cannot."},
        {"zh": "它的呼吸变快了。", "en": "Its breathing quickens."},
        {"zh": "那是毒在走。", "en": "That is the venom moving."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上去，双手按住它。", "en": "I leap and pin it with both hands."},
        {"zh": "手掌贴住它的皮肤。", "en": "My palms press its skin."},
        {"zh": "它立刻抖了一下。", "en": "It convulses at once."},
        {"zh": "我用额头撞它。", "en": "I butt it with my brow."},
        {"zh": "我的舌头弹出去。", "en": "My tongue snaps out."},
        {"zh": "打在它的眼睛上。", "en": "It strikes its eye."},
        {"zh": "它捂着脸退。", "en": "It covers its face and retreats."},
        {"zh": "我又贴上去。", "en": "I press in again."},
        {"zh": "黏液沾满它的袖子。", "en": "Slime soaks its sleeve."},
        {"zh": "它开始干呕。", "en": "It starts to retch."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽的水面上鼓起一圈。", "en": "A ring swells on the marsh water."},
        {"zh": "我从水下浮出来。", "en": "I surface from below."},
        {"zh": "皮肤上的斑纹在水里发亮。", "en": "My spots gleam under the water."},
        {"zh": "喉囊鼓了一下。", "en": "My throat sac swells."},
        {"zh": "一声低呱。", "en": "One low croak."},
        {"zh": "芦苇在两边晃。", "en": "The reeds sway on both sides."},
        {"zh": "附近的虫不叫了。", "en": "The insects stop calling."},
        {"zh": "我慢慢爬上岸。", "en": "I crawl up the bank."},
        {"zh": "草立刻变色。", "en": "The grass changes colour at once."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "身上的黏液被烤干了。", "en": "The slime on me dries and cracks."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从岸上摔进浅水，磕到石头。", "en": "I fall off the bank into shallow water."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进我的背。", "en": "It buries in my back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股热把毒逼回体内。", "en": "A heat drives the venom back into me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我开始啃草根。", "en": "Hungry enough to gnaw roots."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有水，也没有泥。", "en": "No water, and no mud."}
      ]
    }
  }
}
