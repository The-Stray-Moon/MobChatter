{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "黑腿在暗处移动。", "en": "Black legs move through the dark."},
        {"zh": "我几乎融进影子。", "en": "I almost melt into shadow."},
        {"zh": "腹上有一点红。", "en": "One red spot on my abdomen."},
        {"zh": "八条腿落得很稳。", "en": "Eight legs land sure."},
        {"zh": "我沿着枯枝前进。", "en": "I advance along a dead branch."},
        {"zh": "黑壳反着微光。", "en": "My black shell holds a faint gleam."},
        {"zh": "一步半寸，很慢。", "en": "Half an inch a step. Slow."},
        {"zh": "我溜进石缝里去了。", "en": "I slip into a crack in the stone."},
        {"zh": "丝在身后拉长。", "en": "Silk trails behind me."},
        {"zh": "我停在阴影边上。", "en": "I stop at the shadow's edge."},
        {"zh": "黑得太彻底了。", "en": "I'm utterly black."},
        {"zh": "我跳到另一块叶上。", "en": "I hop to another leaf."},
        {"zh": "腿上的毛竖起来。", "en": "The hair on my legs stands."},
        {"zh": "我绕开亮处走。", "en": "I walk around the light."},
        {"zh": "夜里的风很凉。", "en": "The night wind is cold."},
        {"zh": "我压低身子前进。", "en": "I creep forward low."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "红点是我唯一的花纹。", "en": "The red spot is my only mark."},
        {"zh": "我把腿收在身边。", "en": "I draw my legs close."},
        {"zh": "暗处最适合我。", "en": "The dark suits me."},
        {"zh": "我盯着一点不动。", "en": "I stare at a point without moving."},
        {"zh": "夜里的虫很多。", "en": "Plenty of insects at night."},
        {"zh": "黑壳上沾了灰。", "en": "Ash clings to my shell."},
        {"zh": "我的牙短，却很毒。", "en": "My fangs are short but venomous."},
        {"zh": "我不需要跳舞。", "en": "I don't need to dance."},
        {"zh": "我在等更黑的时候。", "en": "I wait for a darker hour."},
        {"zh": "影子动了，是风。", "en": "The shadow moved. Wind."},
        {"zh": "我慢慢磨着前足。", "en": "I slowly rub my forelegs."},
        {"zh": "这里没人看得见我。", "en": "No one can see me here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看见红点了吗。", "en": "Did you see the red spot?"},
        {"zh": "黑壳和夜色一样。", "en": "Black shell, black night."},
        {"zh": "火把照得我睁不开眼。", "en": "Your torch blinds me."},
        {"zh": "八只眼都盯着你。", "en": "All eight eyes are on you."},
        {"zh": "别把手伸进暗处。", "en": "Don't put your hand in the dark."},
        {"zh": "我比绿色那几只更凶。", "en": "I'm meaner than the green ones."},
        {"zh": "这块暗处是我的猎场。", "en": "This dark patch is my hunting ground."},
        {"zh": "你的靴子落在我旁边。", "en": "Your boot lands beside me."},
        {"zh": "我只有一指节长。", "en": "I'm a knuckle long."},
        {"zh": "别以为我看不清。", "en": "Don't think I can't see."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "黑壳裂了一道。", "en": "A crack in my black shell."},
        {"zh": "一根腿歪着。", "en": "One leg is bent wrong."},
        {"zh": "汁液流到石上。", "en": "Fluid runs onto the stone."},
        {"zh": "我被光晃得发晕。", "en": "The light dazed me."},
        {"zh": "我缩得更小了。", "en": "I shrank even smaller."},
        {"zh": "我还能拖着自己爬。", "en": "I can still drag myself along."},
        {"zh": "红点有点发暗。", "en": "My red spot looks dull."},
        {"zh": "这点伤很要命。", "en": "This wound is serious for me."},
        {"zh": "我记住你的鞋。", "en": "I remember your boot."},
        {"zh": "我钻回石缝。", "en": "I slip back into the crack."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这虫子在动。", "en": "That bug is moving."},
        {"zh": "放低，我看得见。", "en": "Lower it. I can see."},
        {"zh": "这气味冲得我发晕。", "en": "The smell makes my head swim."},
        {"zh": "我不需要太多。", "en": "I don't need much."},
        {"zh": "丝已经垂下来。", "en": "The silk hangs ready."},
        {"zh": "你先别动它。", "en": "Don't move it."},
        {"zh": "它翅膀还在响。", "en": "Its wings are still buzzing."},
        {"zh": "我再往前挪半寸。", "en": "I edge half an inch closer."},
        {"zh": "这口能吃饱。", "en": "This bite will fill me."},
        {"zh": "留下来给我。", "en": "Leave it for me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞飞了半寸。", "en": "I got knocked half an inch."},
        {"zh": "黑壳磕在石上。", "en": "My black shell hit stone."},
        {"zh": "红点被灰盖住了。", "en": "Ash covers my red spot."},
        {"zh": "别拿靴尖蹭我。", "en": "Don't rub me with your boot tip."},
        {"zh": "我滚到叶子下面。", "en": "I rolled under a leaf."},
        {"zh": "我没事，别管。", "en": "I'm fine. Leave me."},
        {"zh": "震动太大了。", "en": "The vibration was too big."},
        {"zh": "腿勾住了你的靴带。", "en": "A leg caught your bootlace."},
        {"zh": "我又爬回阴影。", "en": "I crawled back into shadow."},
        {"zh": "你差点踩死我。", "en": "You nearly crushed me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这种不跳舞。", "en": "My kind doesn't dance."},
        {"zh": "黑影里走过去就行。", "en": "I just walk through the dark."},
        {"zh": "红点就是信号。", "en": "The red spot is the signal."},
        {"zh": "别站在亮的地方。", "en": "Don't stand in the light."},
        {"zh": "我这一种很凶。", "en": "My kind is vicious."},
        {"zh": "先让我确认安全。", "en": "Let me check for danger first."},
        {"zh": "夜还长着呢。", "en": "The night is still long."},
        {"zh": "别在旁边盯着我。", "en": "Don't stand there watching me."},
        {"zh": "等月色暗下来。", "en": "Wait for the moon to dim."},
        {"zh": "你身上光太多了。", "en": "You carry too much light."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用丝吊它。", "en": "I hoist it with silk."},
        {"zh": "它在我的丝里挣。", "en": "It struggles in my silk."},
        {"zh": "抱起来有点沉。", "en": "It's a little heavy to hold."},
        {"zh": "这比我还宽。", "en": "It's wider than I am."},
        {"zh": "我咬破它了。", "en": "I bit through it."},
        {"zh": "地上还剩一点。", "en": "There's a bit left on the ground."},
        {"zh": "我慢慢拖走。", "en": "I drag it away."},
        {"zh": "谁也别来抢。", "en": "Nobody take it."},
        {"zh": "黑壳上沾了汁。", "en": "Juice marks my black shell."},
        {"zh": "拖到暗处吃。", "en": "I'll eat it in the dark."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有脚步靠近。", "en": "Footsteps coming close."},
        {"zh": "影子被灯推过来了。", "en": "The lamp pushed its shadow over."},
        {"zh": "我伏到最低。", "en": "I flatten myself down."},
        {"zh": "红点收起来了。", "en": "I tuck the red spot away."},
        {"zh": "它在到处找我。", "en": "It's searching for me."},
        {"zh": "我先看它的脚。", "en": "I watch its feet first."},
        {"zh": "这片暗地是我的。", "en": "This dark ground is mine."},
        {"zh": "我腿已经绷紧。", "en": "My legs are coiled."},
        {"zh": "它的脚跟刚停住。", "en": "Its heel has just stopped."},
        {"zh": "再往前一步。", "en": "One step more."},
        {"zh": "我准备落上去。", "en": "I'm ready to drop on it."},
        {"zh": "它没看到红点。", "en": "It didn't see the red spot."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地跟它。", "en": "I follow along the ground."},
        {"zh": "它绕了半圈又回来。", "en": "It loops halfway round and back."},
        {"zh": "我换到它的后面。", "en": "I move to behind it."},
        {"zh": "黑壳不反光。", "en": "My shell gives no gleam."},
        {"zh": "我把丝放下去。", "en": "I lower a thread."},
        {"zh": "它到现在还没挪窝。", "en": "It still hasn't budged."},
        {"zh": "我等它停稳。", "en": "I wait for it to settle."},
        {"zh": "我的呼吸很小。", "en": "My breathing is tiny."},
        {"zh": "它抬起了脚。", "en": "It lifted a foot."},
        {"zh": "再等上那么一息。", "en": "One more breath, then."},
        {"zh": "这个角度正好。", "en": "This angle is right."},
        {"zh": "从上面落下去。", "en": "I drop from above."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "毒牙咬进去。", "en": "My fangs sink in."},
        {"zh": "八条腿抱住。", "en": "Eight legs clamp on."},
        {"zh": "红点闪了一下。", "en": "The red spot flashed."},
        {"zh": "我比绿的那只毒。", "en": "My venom is stronger than the green one's."},
        {"zh": "咬住了就绝不松。", "en": "Once bitten, never let go."},
        {"zh": "毒牙扎得很实。", "en": "The fang sank deep."},
        {"zh": "它甩了几下，没甩掉。", "en": "It thrashes, and I hold on."},
        {"zh": "我咬了两口。", "en": "I bit twice."},
        {"zh": "血沾了黑壳。", "en": "Blood on black shell."},
        {"zh": "退回去，藏好。", "en": "Back off. Hide."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "阴影里多了个黑点。", "en": "A black dot in the shadow."},
        {"zh": "我先露腿，再露头。", "en": "Legs first, then the head."},
        {"zh": "黑壳几乎看不见。", "en": "My black shell is nearly invisible."},
        {"zh": "红点只闪了一下。", "en": "The red spot flashed once."},
        {"zh": "我从石缝里爬出。", "en": "I crawl from a crack in the stone."},
        {"zh": "夜里我活动得多。", "en": "I'm busy at night."},
        {"zh": "丝已经铺好了。", "en": "The silk is already laid."},
        {"zh": "我落在这块石上。", "en": "I land on this stone."},
        {"zh": "八只眼都睁着。", "en": "All eight eyes are open."},
        {"zh": "别点起灯来。", "en": "Don't light a lamp."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的黑壳烤裂。", "en": "Fire cracked my black shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石上摔进草里。", "en": "I fall from the stone into the grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把丝都冲散了。", "en": "Water tore my silk apart."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "石缝都被炸开了。", "en": "The stone crack blew open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖东西穿过来。", "en": "Something sharp came through."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "红光在我壳上流。", "en": "Red light runs on my shell."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得腿都发虚。", "en": "Hunger makes my legs unsteady."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把暗处照白了。", "en": "The flash whitened the dark."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑色的我，掉进没有底的缝。", "en": "Black as I am, I fall into a bottomless crack."}
      ]
    }
  }
}
