{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一晃，腿又短又软。", "en": "I wobble along on short, soft legs."},
        {"zh": "伞盖在背上，跟着步子颤。", "en": "The cap on my back quivers with each step."},
        {"zh": "我走在黑森林的落叶上。", "en": "I walk the dark forest's leaf litter."},
        {"zh": "叶子被我踩得沙沙响。", "en": "Leaves rustle under my feet."},
        {"zh": "我慢吞吞地挪。", "en": "I shuffle along slowly."},
        {"zh": "有光的地方我才停。", "en": "I stop only where there is light."},
        {"zh": "树影太密了，我绕开。", "en": "The shade is too deep; I go around."},
        {"zh": "孢子从我脚边散开。", "en": "Spores scatter from my feet."},
        {"zh": "它们飘了一小段就落下。", "en": "They drift a little, then settle."},
        {"zh": "正合适。", "en": "Just right."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在那里，伞盖轻轻起伏。", "en": "I stand there, my cap rising and falling."},
        {"zh": "像在呼吸。", "en": "As if breathing."},
        {"zh": "也许我真的在呼吸。", "en": "Perhaps I really am."},
        {"zh": "我脚下有一圈苔。", "en": "A ring of moss lies at my feet."},
        {"zh": "比别处的绿。", "en": "Greener than elsewhere."},
        {"zh": "我低头看脚下那圈青苔。", "en": "I look down at the moss ring around me."},
        {"zh": "有一朵小蘑菇已经长出来了。", "en": "A small mushroom has already come up."},
        {"zh": "它跟着我。", "en": "It follows me."},
        {"zh": "我一直往前走，它就一直在后面。", "en": "I keep walking, and it keeps behind."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪着伞盖看你。", "en": "I tilt my cap at you."},
        {"zh": "你没有恶意吧。", "en": "You mean no harm, do you?"},
        {"zh": "我把伞盖压低，让开路。", "en": "I lower my cap and step aside."},
        {"zh": "让出一条路。", "en": "Opening a way."},
        {"zh": "你走过去了。", "en": "You walk past."},
        {"zh": "我还站在那里。", "en": "I am still standing there."},
        {"zh": "我把伞盖压低。", "en": "I lower my cap."},
        {"zh": "这样就看不见我了。", "en": "Now I cannot be seen."},
        {"zh": "你继续走。", "en": "You walk on."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的伞盖缺了一块。", "en": "A piece of my cap is gone."},
        {"zh": "我晃了一下，孢子撒出来。", "en": "I lurch; spores spill out."},
        {"zh": "缺的地方是白的。", "en": "The missing part is white."},
        {"zh": "我缺了一角的伞盖转过来。", "en": "My chipped cap turns toward you."},
        {"zh": "脚步还是那么慢。", "en": "My steps are still that slow."},
        {"zh": "我一点都不生气。", "en": "I am not angry at all."},
        {"zh": "只是有点疼。", "en": "It simply hurts."},
        {"zh": "我停下晒了一会。", "en": "I stop and sit in the light."},
        {"zh": "白瓤露在外面，我照样挪。", "en": "White flesh shows, yet I keep shuffling."},
        {"zh": "伞盖还在慢慢长。", "en": "My cap is still slowly growing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土和水里长出来。", "en": "I grow from soil and water."},
        {"zh": "你的食物放着吧。", "en": "Leave your food there."},
        {"zh": "它过几天会长东西。", "en": "In a few days something will grow on it."},
        {"zh": "你可以看看。", "en": "You may watch."},
        {"zh": "我往旁边挪。", "en": "I shuffle aside."},
        {"zh": "别挡着光。", "en": "Do not block the light."},
        {"zh": "我要晒一会。", "en": "I want to sit in it a while."},
        {"zh": "等我晒透了。", "en": "When I am warm through."},
        {"zh": "我再走。", "en": "I will move on."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你从旁边挤过来。", "en": "You squeeze past."},
        {"zh": "我的伞盖歪了。", "en": "My cap is knocked crooked."},
        {"zh": "我慢慢扶正。", "en": "I straighten it slowly."},
        {"zh": "孢子落了你一身。", "en": "Spores fall all over you."},
        {"zh": "它们已经沾住了。", "en": "They have already caught."},
        {"zh": "过几天你就知道了。", "en": "In a few days you will know."},
        {"zh": "我头上顶着一朵蘑菇。", "en": "A mushroom grows on my head."},
        {"zh": "脚步还是一晃一晃。", "en": "Still wobbling."},
        {"zh": "好像什么都没做。", "en": "As if I had done nothing."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们不用那些。", "en": "We have no use for that."},
        {"zh": "我脚下已经有一圈了。", "en": "There is already a ring at my feet."},
        {"zh": "等它们都长起来。", "en": "When they have all come up."},
        {"zh": "就是我该做的事。", "en": "That is what I am to do."},
        {"zh": "我坐下不动。", "en": "I sit and do not move."},
        {"zh": "孢子自己会飘。", "en": "The spores drift on their own."},
        {"zh": "风替我送。", "en": "The wind carries them for me."},
        {"zh": "我不需要谁。", "en": "I need no one."},
        {"zh": "只要潮湿。", "en": "Only damp."},
        {"zh": "和一点光。", "en": "And a little light."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手碰了碰。", "en": "I reach out and touch it."},
        {"zh": "它比看上去轻。", "en": "It is lighter than it looks."},
        {"zh": "我把它放在头上。", "en": "I set it on my head."},
        {"zh": "伞盖上多了一点。", "en": "Something new on my cap."},
        {"zh": "过了一会它滑下去。", "en": "After a while it slides off."},
        {"zh": "掉在土里。", "en": "It drops into the soil."},
        {"zh": "我没有捡。", "en": "I do not pick it up."},
        {"zh": "那里会长东西。", "en": "Something will grow there."},
        {"zh": "我挪开，不去管它。", "en": "I shuffle away and leave it."},
        {"zh": "把它留在身后。", "en": "And leave it behind."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西踩坏了我的圈。", "en": "Something has trampled my ring."},
        {"zh": "我停下来，伞盖慢慢抬起。", "en": "I stop; my cap lifts slowly."},
        {"zh": "它还在踩。", "en": "It is still trampling."},
        {"zh": "我把身体转过去。", "en": "I turn my body toward it."},
        {"zh": "它们落在它的衣袖上。", "en": "They settle on its sleeve."},
        {"zh": "我踩着厚苔，又逼近一步。", "en": "Through thick moss, I close one more step."},
        {"zh": "现在我离它很近了。", "en": "Now I am very close."},
        {"zh": "我也抬着伞盖看它。", "en": "I look back with my cap raised."},
        {"zh": "我又撒了一层孢子。", "en": "I release another layer of spores."},
        {"zh": "它开始咳了。", "en": "It starts to cough."},
        {"zh": "咳得很急。", "en": "Hard and fast."},
        {"zh": "我退开。", "en": "I draw back."},
        {"zh": "站在旁边等。", "en": "And stand nearby to wait."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它退了几步，但没有走远。", "en": "It backs off but does not leave."},
        {"zh": "我挪到下风处，孢子先到。", "en": "I shift downwind so the spores arrive first."},
        {"zh": "我走过的地方苔色变深。", "en": "The moss darkens where I pass."},
        {"zh": "它捂着口鼻。", "en": "It covers its mouth and nose."},
        {"zh": "孢子还是进去了。", "en": "The spores get in anyway."},
        {"zh": "我停下。", "en": "I stop."},
        {"zh": "伞盖轻轻起伏。", "en": "My cap rises and falls."},
        {"zh": "它靠着树喘。", "en": "It leans on a tree and pants."},
        {"zh": "我挪到它的下风处。", "en": "I shuffle to its lee side."},
        {"zh": "风把孢子全送过去。", "en": "The wind carries every spore to it."},
        {"zh": "它弯下腰。", "en": "It doubles over."},
        {"zh": "我又撒了一层。", "en": "I release another layer."},
        {"zh": "脚下的苔越来越厚。", "en": "The moss thickens under me."},
        {"zh": "它的脚陷在里面。", "en": "Its feet sink into it."},
        {"zh": "拔不出来。", "en": "It cannot pull free."},
        {"zh": "它的脚陷进苔里，拔不出。", "en": "Its feet sink into the moss and stick."},
        {"zh": "孢子先飘，我慢慢跟。", "en": "The spores drift ahead; I follow slowly."},
        {"zh": "我等它自己倒下。", "en": "I wait for it to fall on its own."},
        {"zh": "伞盖下的白褶一张一合。", "en": "The white gills beneath my cap open and close."},
        {"zh": "林子暗下来，我的孢子更浓。", "en": "The wood darkens and my spores thicken."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用伞盖顶它的膝盖。", "en": "I butt my cap against its knee."},
        {"zh": "不重，但孢子扑了一脸。", "en": "Light, but the spores hit its face."},
        {"zh": "它咳得弯下腰。", "en": "It coughs and doubles over."},
        {"zh": "我的伞盖撞上它的手。", "en": "My cap butts into its hand."},
        {"zh": "这次是它的手。", "en": "Its hand this time."},
        {"zh": "它甩着手往后退。", "en": "It shakes its hand and backs away."},
        {"zh": "我跟着挪。", "en": "I shuffle after."},
        {"zh": "脚下的苔把它绊住。", "en": "The moss trips it."},
        {"zh": "伞盖贴住它的胸口。", "en": "My cap presses its chest."},
        {"zh": "孢子全灌进去。", "en": "The spores pour in."},
        {"zh": "它抓我的伞盖。", "en": "It grabs my cap."},
        {"zh": "撕下一块。", "en": "And tears off a piece."},
        {"zh": "白色的里面露出来。", "en": "The white inside shows."},
        {"zh": "我继续压着。", "en": "I keep pressing."},
        {"zh": "它把我推开了。", "en": "It shoves me off."},
        {"zh": "我在落叶里滚了半圈。", "en": "I rolled half a turn in the leaves."},
        {"zh": "慢慢站起来。", "en": "And rise slowly."},
        {"zh": "伞盖又转过去。", "en": "My cap turns back toward it."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "落叶里鼓起一点。", "en": "A bump rises in the leaf litter."},
        {"zh": "我从中顶出来。", "en": "I push up out of it."},
        {"zh": "伞盖先露出来。", "en": "My cap shows first."},
        {"zh": "然后是两条短腿。", "en": "Then two short legs."},
        {"zh": "我站稳。", "en": "I stand steady."},
        {"zh": "脚下的叶子已经变色。", "en": "The leaves at my feet have changed colour."},
        {"zh": "四周很暗。", "en": "All around is dark."},
        {"zh": "黑森林就喜欢这样。", "en": "The dark forest likes it so."},
        {"zh": "我朝有光的地方挪。", "en": "I shuffle toward the light."},
        {"zh": "一路撒下孢子。", "en": "Sowing spores as I go."},
        {"zh": "它们落在地上。", "en": "They settle on the ground."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一碰，我的伞盖就卷了。", "en": "Fire touches and my cap curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，伞盖压扁了。", "en": "I roll down a slope and crush my cap."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水泡得我发涨。", "en": "Water swells me up."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把孢子吹得到处都是。", "en": "The blast scatters my spores everywhere."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿过我的伞盖。", "en": "It pierces my cap."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股干冷让我缩起来。", "en": "A dry cold makes me shrink."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "根扎得浅，我慢慢瘪下去。", "en": "My roots are shallow; I slowly wither."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我的孢子全亮了。", "en": "Lightning makes my spores glow."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有土，我扎不下根。", "en": "No soil; I cannot root."}
      ]
    }
  }
}
