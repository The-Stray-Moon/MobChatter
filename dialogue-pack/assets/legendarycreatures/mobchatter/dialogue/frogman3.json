{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "湿脚印在泥上一串。", "en": "A trail of wet prints in the mud."},
        {"zh": "我弓着背往前走。", "en": "I walk with my back hunched."},
        {"zh": "脚趾在泥里张开。", "en": "My toes spread in the mud."},
        {"zh": "两腿一蹬就过沟。", "en": "One push of the legs clears the ditch."},
        {"zh": "水从肩头往下淌。", "en": "Water runs off my shoulders."},
        {"zh": "步子有点跳。", "en": "My gait comes out in little hops."},
        {"zh": "沼泽里的雾还没散。", "en": "The swamp fog hasn't lifted."},
        {"zh": "我甩掉手上的水。", "en": "I shake the water off my hands."},
        {"zh": "膝盖弯得很厉害。", "en": "My knees bend deep."},
        {"zh": "我慢慢挪过浅滩。", "en": "I wade through the shallows."},
        {"zh": "背上还粘着浮萍。", "en": "Duckweed sticks to my back."},
        {"zh": "眼睛一直朝上看。", "en": "My eyes keep looking up."},
        {"zh": "脚掌压出一个个坑。", "en": "My feet press out pits."},
        {"zh": "我绕着水塘走半圈。", "en": "I circle half the pond."},
        {"zh": "泥浆顺着腿滑下。", "en": "Mud slides down my legs."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在水里。", "en": "I squat in the water."},
        {"zh": "喉咙鼓了两下。", "en": "My throat pulses twice."},
        {"zh": "这片沼泽很安静。", "en": "This swamp is quiet."},
        {"zh": "苔从肩头长到胸口。", "en": "Moss grows from shoulder to chest."},
        {"zh": "我把手垂下来。", "en": "My hands hang low."},
        {"zh": "水面有虫子。", "en": "Insects on the surface."},
        {"zh": "我在听芦苇那边。", "en": "I listen past the reeds."},
        {"zh": "身上一下子也不动。", "en": "My whole body holds still."},
        {"zh": "这片水是我常来的。", "en": "I come to this water often."},
        {"zh": "苔藓从肩头滴水，我一动不动。", "en": "Moss drips from my shoulder, and I do not move."},
        {"zh": "我按了按自己的腿。", "en": "I press on my own leg."},
        {"zh": "泥里有气泡冒起来。", "en": "Bubbles rise from the mud."},
        {"zh": "我在泥里磨着脚。", "en": "I rub my feet in the mud."},
        {"zh": "这里的水声不会停。", "en": "The water here never goes quiet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站得太干了。", "en": "You look too dry."},
        {"zh": "你听得懂我吗。", "en": "Do you understand me?"},
        {"zh": "这里的泥会留住你。", "en": "This mud will hold you."},
        {"zh": "我站得比你看的高一点。", "en": "I'm a little taller than you think."},
        {"zh": "别把手伸到水里。", "en": "Keep your hands out of the water."},
        {"zh": "我的皮肤是湿的。", "en": "My skin is wet."},
        {"zh": "你走了很远的路。", "en": "You've come a long way."},
        {"zh": "你的鞋已经湿了。", "en": "Your shoes are already wet."},
        {"zh": "我比你熟悉这片雾。", "en": "I know this fog better than you."},
        {"zh": "再往前泥会陷。", "en": "Any farther and the mud gives."},
        {"zh": "我的眼睛是竖着的。", "en": "My pupils are upright slits."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "水里传来一声闷响。", "en": "A muffled sound in the water."},
        {"zh": "湿皮上添了一道。", "en": "A new line on my wet skin."},
        {"zh": "我扶着芦苇站稳。", "en": "I brace on the reeds."},
        {"zh": "腿有点发软。", "en": "My legs feel weak."},
        {"zh": "湿皮还在撑。", "en": "This wet hide still holds."},
        {"zh": "这点伤在水里不算。", "en": "In water this much doesn't count."},
        {"zh": "我滑了一下没倒。", "en": "I slipped but didn't fall."},
        {"zh": "我记住你的脸了，池塘边也记着。", "en": "I remember your face, and so does the pond edge."},
        {"zh": "再来我就拖你下水。", "en": "Next time I drag you under."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么在动？", "en": "What's moving there?"},
        {"zh": "活的，还在扭来扭去。", "en": "Alive, and it wriggles."},
        {"zh": "丢在水面上就好。", "en": "Drop it on the water."},
        {"zh": "那点距离够得着。", "en": "I can reach that far."},
        {"zh": "这味道很鲜。", "en": "That smells fresh."},
        {"zh": "别把它踩碎了。", "en": "Don't crush it."},
        {"zh": "先让我看看。", "en": "Let me look at it first."},
        {"zh": "水里的东西更合口。", "en": "Things in the water suit me better."},
        {"zh": "你留一半就行。", "en": "Half is enough."},
        {"zh": "我慢慢过去拿。", "en": "I'll come and take it."},
        {"zh": "它还在那里跳。", "en": "It's still jumping there."},
        {"zh": "放到浅滩上。", "en": "Set it on the shallows."},
        {"zh": "把虫子放浅滩，我自己去叼。", "en": "Leave the bug on the shallows and I will take it myself."},
        {"zh": "这味道飘到岸上了。", "en": "The smell reached the bank."},
        {"zh": "给我，我记着你。", "en": "Give it and I'll remember."},
        {"zh": "手指别往里收。", "en": "Don't curl your fingers in."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上来会沾一身泥。", "en": "You'll get covered in mud."},
        {"zh": "退开，我脚下不稳。", "en": "Back off. My footing's poor."},
        {"zh": "我们两个都踉跄了。", "en": "We both staggered."},
        {"zh": "湿皮肤贴着很难受。", "en": "Wet skin against you isn't pleasant."},
        {"zh": "我的膝盖撞到你。", "en": "My knee caught you."},
        {"zh": "别拉我的手。", "en": "Don't pull my hand."},
        {"zh": "泥里滑得要命。", "en": "The mud is treacherous."},
        {"zh": "滑溜溜的皮，撞了也白撞。", "en": "Slick skin like this? Bumping into it gets you nowhere."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这片沼泽只有我一个。", "en": "I'm the only one in this swamp."},
        {"zh": "这种事在水下发生。", "en": "That happens underwater."},
        {"zh": "先把手从水里拿出来。", "en": "Take your hand out of the water first."},
        {"zh": "我的样子不太合适。", "en": "I'm not much to look at."},
        {"zh": "别靠太近，我皮肤滑。", "en": "Not too close. My skin slips."},
        {"zh": "雾散一点再说。", "en": "When the fog thins."},
        {"zh": "我在这待了很多年。", "en": "I've been here many years."},
        {"zh": "水里更安全。", "en": "The water is safer."},
        {"zh": "该走就走吧。", "en": "Go, if you're going."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我手指间有蹼。", "en": "There's webbing between my fingers."},
        {"zh": "抓起来有点滑。", "en": "It's slippery to hold."},
        {"zh": "一口就整个吞下。", "en": "One gulp and it's down."},
        {"zh": "这是条虫子。", "en": "This is a bug."},
        {"zh": "水底还有一块。", "en": "Another piece on the bottom."},
        {"zh": "我拖着它上岸。", "en": "I drag it onto the bank."},
        {"zh": "我从水里站起来，比你高。", "en": "I rise from the water, taller than you."},
        {"zh": "别抢我手里的。", "en": "Don't take what's in my hand."},
        {"zh": "留着慢慢吃。", "en": "I'll save it for later."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面晃了一下。", "en": "The surface rippled."},
        {"zh": "那脚步不是沼泽的声音。", "en": "Those steps don't belong here."},
        {"zh": "蛙人的头低下去，就是不祥。", "en": "The frogman's head goes down, and that means ill."},
        {"zh": "苔下的肌肉绷了。", "en": "Muscle tightens under the moss."},
        {"zh": "你走进了我的雾。", "en": "You walked into my fog."},
        {"zh": "我弓着背，湿脚印一路留下。", "en": "I go hunched, leaving wet prints behind."},
        {"zh": "浅水藏不住你的膝盖。", "en": "Shallow water cannot hide your knees."},
        {"zh": "你身后只有芦苇。", "en": "Only reeds behind you."},
        {"zh": "致命变种，掉落也是独一份。", "en": "A lethal variant with its own loot table."},
        {"zh": "这时候该动了。", "en": "Time to move."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩出的水痕很清楚。", "en": "Your wet prints are clear."},
        {"zh": "我在芦苇后面。", "en": "I'm behind the reeds."},
        {"zh": "雾替我挡着。", "en": "The fog covers me."},
        {"zh": "我一步一步地挪。", "en": "I shift a step at a time."},
        {"zh": "你的脚步声很乱。", "en": "Your steps are unsteady."},
        {"zh": "再靠近水线一点。", "en": "Nearer the waterline."},
        {"zh": "你每踩一脚，泥就替我记着。", "en": "Every step you take, the mud remembers it for me."},
        {"zh": "水里岸上，你都跑不掉。", "en": "Water or shore, there's no escape."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "湿手一把抓过去！", "en": "A wet hand lashes out!"},
        {"zh": "湿手按住你的腕。", "en": "A wet hand pins your wrist."},
        {"zh": "我整个人压上来。", "en": "My whole weight comes down."},
        {"zh": "咬一口，湿的。", "en": "One bite. Wet."},
        {"zh": "湿手抓不住刀。", "en": "Wet hands can't hold a blade."},
        {"zh": "我比你熟悉泥地。", "en": "I know this mud better."},
        {"zh": "这一掌拍在肩上。", "en": "That palm hit your shoulder."},
        {"zh": "把你往水里拖。", "en": "I drag you toward the water."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水下站起来。", "en": "I rise out of the water."},
        {"zh": "沼泽里多了一个人形。", "en": "A human shape in the swamp."},
        {"zh": "我浑身滴着水。", "en": "I'm dripping everywhere."},
        {"zh": "芦苇晃了一下。", "en": "The reeds swayed."},
        {"zh": "我慢慢从雾里出来。", "en": "I come out of the fog slowly."},
        {"zh": "泥从肩上滑下来。", "en": "Mud slides off my shoulder."},
        {"zh": "这片水有了主人。", "en": "This water has an owner now."},
        {"zh": "我的影子比身高长。", "en": "My shadow is longer than I am."},
        {"zh": "我站到了浅滩上。", "en": "I take my stand on the shallows."},
        {"zh": "水边的我，跳得比谁都快。", "en": "By the water, none jump faster."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "湿皮被烤得发紧。", "en": "My wet skin tightens in the heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时膝撞到石头。", "en": "My knee hit stone on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的肺。", "en": "Water filled my lungs."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "泥水溅了我满脸。", "en": "Muddy water splashed my face."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭插进我肩上的苔里，拔不出来。", "en": "The arrow is stuck in the moss on my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我皮肤发烫。", "en": "That light burns my skin."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "空着肚子腿发虚。", "en": "Empty, and my legs waver."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在水面，我直发抖。", "en": "Lightning on the water shook me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有泥了。", "en": "No mud under my feet."}
      ]
    }
  }
}
