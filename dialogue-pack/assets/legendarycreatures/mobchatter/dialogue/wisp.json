{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘过去，没有留下影子。", "en": "I drift past and leave no shadow."},
        {"zh": "身下的草只是轻轻一动。", "en": "The grass beneath me stirs faintly."},
        {"zh": "蓝色的光跟着我。", "en": "Blue light travels with me."},
        {"zh": "我在树顶的高度滑行。", "en": "I glide at treetop height."},
        {"zh": "一阵风把我吹离了航线。", "en": "A gust blows me off my line."},
        {"zh": "我又飘回原来那条线。", "en": "I drift back onto my line."},
        {"zh": "下面有村子。", "en": "There is a village below."},
        {"zh": "我从它上面过去。", "en": "I pass above it."},
        {"zh": "没有人抬头。", "en": "No one looks up."},
        {"zh": "我飘得更远了。", "en": "I drift farther."},
        {"zh": "光在夜里很淡。", "en": "The light is faint at night."},
        {"zh": "但很远也看得见。", "en": "Yet it can be seen from far off."},
        {"zh": "我绕过一座塔。", "en": "I round a tower."},
        {"zh": "塔上的灯很亮。", "en": "Its lantern is bright."},
        {"zh": "我的光就暗了些。", "en": "My own light dims."},
        {"zh": "我又飘开。", "en": "I drift away."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在半空，一动不动。", "en": "I stop in midair, perfectly still."},
        {"zh": "光慢慢散开又收拢。", "en": "The light slowly spreads and gathers."},
        {"zh": "一明一暗，假装在喘息。", "en": "Bright, then dim, as if panting."},
        {"zh": "我没有肺，也没有心跳。", "en": "I have no lungs and no heartbeat."},
        {"zh": "但我确实在动。", "en": "But I am moving."},
        {"zh": "有一片叶子从下面飘过。", "en": "A leaf drifts past below."},
        {"zh": "我跟着它看了一会。", "en": "I watch it for a while."},
        {"zh": "然后不再看了。", "en": "Then look away."},
        {"zh": "夜风穿过我，什么也带不走。", "en": "The night wind passes through and takes nothing."},
        {"zh": "我感不到凉。", "en": "I feel no cold."},
        {"zh": "我只是知道。", "en": "I simply know."},
        {"zh": "光又亮了一点。", "en": "The light brightens a little."},
        {"zh": "下面的溪水反着天光。", "en": "The stream below mirrors the sky."},
        {"zh": "我落低一点去照它。", "en": "I sink a little to shine on it."},
        {"zh": "水面就亮了一条。", "en": "A bright line runs on the water."},
        {"zh": "我升回原来的高度。", "en": "I rise back to my height."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我晃到你面前。", "en": "I float in front of you."},
        {"zh": "你没有伸手。", "en": "You do not reach out."},
        {"zh": "你没有伸手，这样最好。", "en": "You keep your hands down; better that way."},
        {"zh": "你只是看着。", "en": "You only look."},
        {"zh": "我的光映在你的眼睛里。", "en": "My light sits in your eyes."},
        {"zh": "你眨了一下。", "en": "You blink once."},
        {"zh": "我往后飘开，让出半步。", "en": "I drift back and give you room."},
        {"zh": "你还在看我。", "en": "You are still looking."},
        {"zh": "我顺着你的肩，转了一整圈。", "en": "I drift a full circle past your shoulder."},
        {"zh": "然后往高处去了。", "en": "Then rise higher."},
        {"zh": "你抬头。", "en": "You look up."},
        {"zh": "我就在你的正上方。", "en": "I am directly above you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "那一击让我的蓝光抖了抖。", "en": "The blow makes my blue glow shiver."},
        {"zh": "边缘散开又聚回来。", "en": "The edges scatter and gather."},
        {"zh": "我飘歪了。", "en": "I drift askew."},
        {"zh": "过了好一会才稳。", "en": "It takes a while to steady."},
        {"zh": "我缩得更小。", "en": "I shrink smaller."},
        {"zh": "但没有灭。", "en": "But I do not go out."},
        {"zh": "我慢慢亮回来。", "en": "I slowly brighten again."},
        {"zh": "夜还是很黑。", "en": "The night is still black."},
        {"zh": "光散了一半，我仍悬着。", "en": "Half my light is scattered; I still hover."},
        {"zh": "我又飘起来了。", "en": "I drift up again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我把光凑近你手里的东西。", "en": "I bring my light near what you hold."},
        {"zh": "它没有变。", "en": "It does not change."},
        {"zh": "我和它一样，什么也没变。", "en": "Like it, I remain unchanged."},
        {"zh": "你手里的东西，我尝不了。", "en": "What you hold is nothing I can taste."},
        {"zh": "我把光移开了。", "en": "I move the light away."},
        {"zh": "你举得手都酸了，我还看着。", "en": "Your arm tires; I only watch."},
        {"zh": "搁在那儿就好，别追我。", "en": "Leave it there; don't follow me."},
        {"zh": "夜里它会被别的带走。", "en": "The night will carry it off to something else."},
        {"zh": "我飘走了。", "en": "I drift away."},
        {"zh": "光在树后闪了一下。", "en": "The light flickers behind a tree."},
        {"zh": "然后不见了。", "en": "Then is gone."},
        {"zh": "你还举着，我早已移开。", "en": "You still hold it out; I've already moved on."},
        {"zh": "我其实没有走远。", "en": "I have not really gone far."},
        {"zh": "我就在树后。", "en": "I am just behind the tree."},
        {"zh": "看着你。", "en": "Watching you."},
        {"zh": "等你自己走。", "en": "Waiting for you to leave."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你穿过我的光。", "en": "You pass through my light."},
        {"zh": "一瞬间，你的手很暖。", "en": "For an instant your hand is warm."},
        {"zh": "然后就没有了。", "en": "And then it is gone."},
        {"zh": "你回过头，我的光在你背后。", "en": "You turn; my light is behind you."},
        {"zh": "我已经在你后面。", "en": "I am already behind you."},
        {"zh": "你没有察觉。", "en": "You have not noticed."},
        {"zh": "我的光落在你的肩上。", "en": "My light settles on your shoulder."},
        {"zh": "像一片霜。", "en": "Like frost."},
        {"zh": "很快就化了。", "en": "It melts quickly."},
        {"zh": "我又飘高了一点。", "en": "I float a little higher."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "两团光挨近，不必开口。", "en": "Two lights draw close; no words needed."},
        {"zh": "两团光靠得近了。", "en": "Two lights draw close."},
        {"zh": "边缘碰到一起。", "en": "Their edges touch."},
        {"zh": "亮了一下。", "en": "There is a flash."},
        {"zh": "又分开。", "en": "Then they part."},
        {"zh": "我们各自飘走。", "en": "We drift away separately."},
        {"zh": "谁也没有回头。", "en": "Neither looks back."},
        {"zh": "夜还是那么黑。", "en": "The night stays as black."},
        {"zh": "光还是那么淡。", "en": "The light stays as faint."},
        {"zh": "好像什么都没有发生。", "en": "As if nothing had happened."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用光包住它。", "en": "I wrap it in light."},
        {"zh": "它浮起来了一点。", "en": "It rises a little."},
        {"zh": "它太重，落回原来的地方。", "en": "Too heavy; it settles back where it was."},
        {"zh": "我托不住实的东西。", "en": "I cannot hold solid things."},
        {"zh": "我试了两次。", "en": "I try twice."},
        {"zh": "第三次它动了。", "en": "On the third it moves."},
        {"zh": "我把它移了半尺。", "en": "I shift it half a foot."},
        {"zh": "就这些了。", "en": "That is all."},
        {"zh": "我的光暗了一圈。", "en": "My light dims a ring."},
        {"zh": "得歇一会。", "en": "I must rest a while."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "草叶一动，有活物进了林子。", "en": "The grass stirs; something living enters the wood."},
        {"zh": "我的光收得很小。", "en": "My light shrinks small."},
        {"zh": "缩成一点。", "en": "Down to a point."},
        {"zh": "它只当是一点夜光。", "en": "It takes me for a fleck of night glow."},
        {"zh": "我从它头顶飘过去。", "en": "I drift over its head."},
        {"zh": "光落在它的背上。", "en": "The light falls on its back."},
        {"zh": "它仰起脸，望向我的光。", "en": "It lifts its face toward my light."},
        {"zh": "我立刻飘开。", "en": "I drift away at once."},
        {"zh": "它追了几步。", "en": "It chases a few steps."},
        {"zh": "我飘到它够不到的地方。", "en": "I rise beyond its reach."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘到它前面。", "en": "I drift ahead of it."},
        {"zh": "它跟着走。", "en": "It follows."},
        {"zh": "我又飘到侧面。", "en": "I drift to the side."},
        {"zh": "它转过头。", "en": "It turns its head."},
        {"zh": "我一会儿亮，一会儿暗。", "en": "I brighten, then dim."},
        {"zh": "它就一会儿看我，一会儿不看。", "en": "It looks, then stops looking."},
        {"zh": "我们走过一片林子。", "en": "We cross a stretch of woods."},
        {"zh": "它开始走不稳。", "en": "Its steps grow unsteady."},
        {"zh": "我停在树梢。", "en": "I stop at the treetop."},
        {"zh": "它抬头。", "en": "It looks up."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光贴上它。", "en": "My light presses against it."},
        {"zh": "很冷，也很亮。", "en": "Very cold, and very bright."},
        {"zh": "它捂住了眼睛。", "en": "It covers its eyes."},
        {"zh": "我从它身后过去。", "en": "I pass behind it."},
        {"zh": "光把它的影子照得老长。", "en": "My light stretches its shadow."},
        {"zh": "它回头看错了方向。", "en": "It looks the wrong way."},
        {"zh": "我在另一边。", "en": "I am on the other side."},
        {"zh": "它转过来。", "en": "It turns."},
        {"zh": "我又走了。", "en": "I have moved again."},
        {"zh": "它抓不住光。", "en": "It cannot catch light."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "夜里，林子里亮了一点。", "en": "At night, the woods brighten a little."},
        {"zh": "那点蓝，是我刚醒。", "en": "That fleck of blue is me, just waking."},
        {"zh": "我从树梢上飘下来。", "en": "I drift down from the treetops."},
        {"zh": "蓝白的光很淡。", "en": "The blue-white light is faint."},
        {"zh": "有虫围着我转。", "en": "Insects circle me."},
        {"zh": "它们飞不进来。", "en": "They cannot enter."},
        {"zh": "我往空地飘。", "en": "I drift toward the clearing."},
        {"zh": "那里的夜更黑。", "en": "The night is darker there."},
        {"zh": "我的光显得更亮。", "en": "My light looks brighter."},
        {"zh": "林外传来踩断枯枝的声音。", "en": "Beyond the trees, a dry twig snaps."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把夜照亮了，我的光发灰。", "en": "Fire lights the night; my glow turns grey."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，光散成一团。", "en": "I fall and my light scatters."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上只剩一点蓝。", "en": "Only a fleck of blue remains on the water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的光吹散。", "en": "The blast blows my light apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭从我的光里穿过去，空了一块。", "en": "The arrow passes through my light and leaves a gap."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力把我钉在原处。", "en": "Magic pins me in place."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有肚子，饿这种事找不到我。", "en": "I have no belly; hunger cannot find me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷和我一样亮了一下。", "en": "Lightning blazed as I do, once."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗把我吞进去了。", "en": "The dark swallows me."}
      ]
    }
  }
}
