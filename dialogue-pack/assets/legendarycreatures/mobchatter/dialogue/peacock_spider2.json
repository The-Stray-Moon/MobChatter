{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "八条腿在苔上点。", "en": "Eight legs tap across the moss."},
        {"zh": "身子只有一粒豆大。", "en": "My body is no bigger than a bean."},
        {"zh": "绿色的腹在晃。", "en": "My green abdomen sways."},
        {"zh": "跳一下，落半尺。", "en": "One hop, half a foot."},
        {"zh": "眼睛盯着前面。", "en": "My eyes stay fixed ahead."},
        {"zh": "我钻过叶片缝。", "en": "I slip between the leaves."},
        {"zh": "爪子勾住叶缘。", "en": "My claws hook the leaf edge."},
        {"zh": "我沿着枝子爬。", "en": "I crawl along the twig."},
        {"zh": "脚步轻得没声。", "en": "My steps make no sound."},
        {"zh": "叶面上有水，滑。", "en": "The leaf is wet and slick."},
        {"zh": "我停住，再跳。", "en": "I pause, then leap."},
        {"zh": "绿色的我很难看见。", "en": "The green me is hard to see."},
        {"zh": "腿毛上有细小刺。", "en": "Fine bristles on my legs."},
        {"zh": "我绕到叶子背面。", "en": "I go to the leaf's underside."},
        {"zh": "一步一步地量。", "en": "I measure each step."},
        {"zh": "我往下垂了一段丝。", "en": "I lower myself on a thread."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起一对前腿。", "en": "I raise a pair of front legs."},
        {"zh": "腹部的花纹展开。", "en": "My abdomen pattern opens."},
        {"zh": "我的眼珠不会转。", "en": "My eyes don't move."},
        {"zh": "叶子上露水很重。", "en": "Dew lies heavy on the leaf."},
        {"zh": "我在等虫子上门。", "en": "I wait for insects to come."},
        {"zh": "这身绿是演的。", "en": "This green is a performance."},
        {"zh": "我擦擦自己的眼。", "en": "I wipe my own eyes."},
        {"zh": "风一吹叶就动。", "en": "The wind shifts the leaf."},
        {"zh": "脚上沾了花粉。", "en": "Pollen clings to my feet."},
        {"zh": "我缩了一下腿。", "en": "I tuck a leg in."},
        {"zh": "丝线还挂在枝上。", "en": "My thread still hangs from the twig."},
        {"zh": "我轻轻跳了一下。", "en": "I gave a little hop."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你像一座山。", "en": "You look like a mountain."},
        {"zh": "别低头看我。", "en": "Don't bend down at me."},
        {"zh": "绿底上的斑是警告。", "en": "The spots on my green are a warning."},
        {"zh": "你一动我就跳。", "en": "Move and I leap."},
        {"zh": "八只眼一起抬起来。", "en": "All eight eyes lift at once."},
        {"zh": "你太大了，不好吃。", "en": "You're too big to eat."},
        {"zh": "我只有一丁点大。", "en": "I'm barely a speck."},
        {"zh": "别用手拍下来。", "en": "Don't swat me down."},
        {"zh": "叶背是我的地盘。", "en": "The underside of this leaf is mine."},
        {"zh": "我跳走了可不好找。", "en": "If I jump, I'm hard to find."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "左边第三条腿断了。", "en": "My third left leg is broken."},
        {"zh": "甲壳被压出痕。", "en": "A mark pressed into my shell."},
        {"zh": "八条腿全收起来。", "en": "All eight legs drawn in."},
        {"zh": "我挂着的丝断了。", "en": "My thread snapped."},
        {"zh": "汁液从我身上渗出。", "en": "Fluid seeps from me."},
        {"zh": "八条腿还够撑住。", "en": "Eight legs are enough to hold me."},
        {"zh": "八条腿都在抖。", "en": "All eight legs are shaking."},
        {"zh": "小身体受不了。", "en": "A tiny body can't take this."},
        {"zh": "我记住了你的影子。", "en": "I remember your shadow."},
        {"zh": "我会跳走的。", "en": "I'll leap away."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么小虫？", "en": "What small bug is that?"},
        {"zh": "活的比死的更好。", "en": "Alive is better than dead."},
        {"zh": "再放得近一些。", "en": "Bring it a bit closer."},
        {"zh": "我看见了，别动。", "en": "I see it. Be still."},
        {"zh": "丝线都挂好了。", "en": "The silk is all set."},
        {"zh": "小小一口就够。", "en": "A tiny bite is enough."},
        {"zh": "别拿去喂别的。", "en": "Don't feed it to anything else."},
        {"zh": "味道飘过来了。", "en": "The smell drifted over."},
        {"zh": "我要往前挪。", "en": "I'm edging forward."},
        {"zh": "这虫子会飞吗。", "en": "Can that bug fly?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的鞋底擦过我。", "en": "Your sole grazes past me."},
        {"zh": "我一头栽进草里。", "en": "I tumble headfirst into the grass."},
        {"zh": "叶子被你撞歪了。", "en": "You knocked the leaf crooked."},
        {"zh": "我的腿卡住了。", "en": "My leg got caught."},
        {"zh": "别用手指按。", "en": "Don't press with a finger."},
        {"zh": "我缩得只有一点。", "en": "I curled up to almost nothing."},
        {"zh": "丝线救了我。", "en": "The thread saved me."},
        {"zh": "震动传得很清楚。", "en": "The vibration was very clear."},
        {"zh": "你又踩到叶子了。", "en": "You stepped on the leaf again."},
        {"zh": "稍等一下，我腿麻。", "en": "Wait. My legs are numb."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "所以我才有这个花纹。", "en": "That's what this pattern is for."},
        {"zh": "先看我的舞。", "en": "Watch my dance first."},
        {"zh": "八条腿一起抬。", "en": "Eight legs rising together."},
        {"zh": "你的腿不够多。", "en": "You don't have enough legs."},
        {"zh": "步法要准，别乱。", "en": "The steps must be precise."},
        {"zh": "不是这个物种。", "en": "Not the same species."},
        {"zh": "这场舞我练了很久。", "en": "I practiced this dance long."},
        {"zh": "看不清就别看。", "en": "If you can't see it, don't."},
        {"zh": "我还会跳得更好。", "en": "I'll dance better still."},
        {"zh": "让我再摆一次。", "en": "Let me pose once more."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这虫子比我大。", "en": "That bug is bigger than me."},
        {"zh": "这个我抱不动。", "en": "I can't carry this."},
        {"zh": "用丝吊起来。", "en": "I hoist it on silk."},
        {"zh": "先咬一口再说。", "en": "A bite first, then questions."},
        {"zh": "掉到地上了。", "en": "It fell to the ground."},
        {"zh": "这点距离够得着。", "en": "I can reach that far."},
        {"zh": "这是我用丝吊的。", "en": "I hauled it up on silk."},
        {"zh": "八条腿抱着它。", "en": "Eight legs around it."},
        {"zh": "拉不上去了。", "en": "I can't haul it higher."},
        {"zh": "我慢慢拖回去。", "en": "I'll drag it back slowly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀声，动了。", "en": "Wingbeats. Movement."},
        {"zh": "这震动很小。", "en": "The vibration is tiny."},
        {"zh": "我前腿举起。", "en": "My front legs rise."},
        {"zh": "距离只有半尺。", "en": "Only half a foot away."},
        {"zh": "花斑已经张开。", "en": "My fan is open."},
        {"zh": "它还没发觉我。", "en": "It hasn't noticed me yet."},
        {"zh": "我绷紧后腿。", "en": "My hind legs coil."},
        {"zh": "一根丝挂在下面。", "en": "A thread hangs below."},
        {"zh": "它落到这片叶上。", "en": "It landed on this leaf."},
        {"zh": "我往它背后挪。", "en": "I shift behind it."},
        {"zh": "这一下能中。", "en": "This one will land."},
        {"zh": "别把它惊跑了。", "en": "Don't spook it away."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着叶子的晃。", "en": "I move with the leaf's sway."},
        {"zh": "它在往左边走。", "en": "It's heading left."},
        {"zh": "我保持半尺距离。", "en": "I keep half a foot away."},
        {"zh": "我不急着扑上去。", "en": "No rush to pounce."},
        {"zh": "绿色的我贴着绿叶。", "en": "The green me hugs green leaf."},
        {"zh": "它翅膀合上了。", "en": "Its wings folded."},
        {"zh": "再到叶子边缘。", "en": "Out to the leaf's rim."},
        {"zh": "我等它背上朝我。", "en": "I wait till its back is turned."},
        {"zh": "眼里全是它。", "en": "My eyes are all on it."},
        {"zh": "再往前挪一寸。", "en": "One more inch forward."},
        {"zh": "它的影在叶上晃。", "en": "Its shadow sways on the leaf."},
        {"zh": "后腿压紧了。", "en": "My hind legs are loaded."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "咬住它的颈。", "en": "I bite its neck."},
        {"zh": "前腿压过去。", "en": "My forelegs pin it."},
        {"zh": "毒液推进去。", "en": "I push venom in."},
        {"zh": "我拼尽全力咬一下。", "en": "I bite with all I have."},
        {"zh": "跳上去抱住。", "en": "I leap and cling."},
        {"zh": "别乱动，我会掉下去。", "en": "Don't thrash. I'll fall."},
        {"zh": "八条腿一起抓。", "en": "Eight legs all gripping."},
        {"zh": "它还在拼命挣动。", "en": "It's still thrashing."},
        {"zh": "这一口够狠。", "en": "That bite was vicious."},
        {"zh": "我比看着重。", "en": "I'm heavier than I look."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶缝里下来。", "en": "I lower myself through the leaves."},
        {"zh": "绿叶上有个绿点。", "en": "A green dot on a green leaf."},
        {"zh": "丝先到，我才到。", "en": "The silk arrives, then me."},
        {"zh": "我落到这片叶上。", "en": "I land on this leaf."},
        {"zh": "八只眼睛先露出来。", "en": "Eight eyes come out first."},
        {"zh": "花纹已经撑开。", "en": "My fan is already spread."},
        {"zh": "丛林里的光很碎。", "en": "The jungle light is broken."},
        {"zh": "我选了这个枝头。", "en": "I chose this branch tip."},
        {"zh": "别看漏了我。", "en": "Don't overlook me."},
        {"zh": "我准备好跳了。", "en": "I'm ready to leap."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "绿壳被烤得发黄。", "en": "My green shell yellows in the heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶背翻了下去。", "en": "I tumble off the underside of the leaf."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把丝都浸透了。", "en": "Water soaked through my silk."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "整片叶被掀起来。", "en": "The whole leaf lifted."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有根刺擦过腹侧。", "en": "A spike grazed my flank."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "绿光在我身上跳。", "en": "Green light dances on me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得抬不起腿。", "en": "Too hungry to raise a leg."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我的花纹发白。", "en": "The flash bleached my pattern."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "丝够不到任何地方。", "en": "My silk reaches nothing."}
      ]
    }
  }
