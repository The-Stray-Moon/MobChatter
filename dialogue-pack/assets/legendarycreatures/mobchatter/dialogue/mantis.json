{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "细长的腿走过草茎。", "en": "Long thin legs cross the grass stems."},
        {"zh": "我举着前足走。", "en": "I walk with my forelegs raised."},
        {"zh": "身体一摇一摇。", "en": "My body sways as I go."},
        {"zh": "六足落地几乎无声。", "en": "Six feet land almost silently."},
        {"zh": "我穿过高草。", "en": "I push through the tall grass."},
        {"zh": "头能转半圈。", "en": "My head can turn half around."},
        {"zh": "我沿着豆叶走。", "en": "I walk along the bean leaves."},
        {"zh": "翅鞘贴着背。", "en": "My wing cases lie flat."},
        {"zh": "我一步跨两片叶。", "en": "One step spans two leaves."},
        {"zh": "草尖被压弯又弹起。", "en": "The grass bows and springs back."},
        {"zh": "我慢慢挪到向阳处。", "en": "I ease into the sunlit patch."},
        {"zh": "脚上的刺勾住草。", "en": "Spurs on my feet catch the grass."},
        {"zh": "我横着身子走。", "en": "I move sideways."},
        {"zh": "露水打湿了前足。", "en": "Dew wets my forelegs."},
        {"zh": "我停下来看前面。", "en": "I stop and look ahead."},
        {"zh": "腿很长，步很轻。", "en": "Long legs, light steps."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我举着前足不动。", "en": "I hold my forelegs up, still."},
        {"zh": "头慢慢转过来。", "en": "My head turns slowly."},
        {"zh": "翅在自己的背上。", "en": "Wings folded on my back."},
        {"zh": "我盯着草叶间。", "en": "I stare between the blades."},
        {"zh": "我在等飞虫过来。", "en": "I wait for a fly to come."},
        {"zh": "一只蜜蜂落在旁边。", "en": "A bee lands nearby."},
        {"zh": "我的唇须一直在抖。", "en": "My mouthparts keep quivering."},
        {"zh": "身子竖得笔直。", "en": "My body stands straight."},
        {"zh": "我可以几天不吃。", "en": "I can go days without food."},
        {"zh": "阳光照在我的绿上。", "en": "Sun glints on my green."},
        {"zh": "我把前足擦干净。", "en": "I clean my forelegs."},
        {"zh": "影子落在叶面上。", "en": "My shadow falls on the leaf."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬头，只看见你的鞋底。", "en": "I look up and see only the soles of your boots."},
        {"zh": "我只有手指那么长。", "en": "I'm only a finger long."},
        {"zh": "我的头可以转过来。", "en": "My head can turn to face you."},
        {"zh": "前足上有锯齿。", "en": "There are barbs on my forelegs."},
        {"zh": "你的胳膊离我太近。", "en": "Your arm is too close."},
        {"zh": "你踩到草尖了。", "en": "You stepped on the grass tips."},
        {"zh": "我不吃这么大的。", "en": "I don't eat anything this big."},
        {"zh": "别用帽子拍我。", "en": "Don't swat me with your hat."},
        {"zh": "我在草丛里很难找。", "en": "I'm hard to find in this grass."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的前足折了。", "en": "My foreleg bent wrong."},
        {"zh": "翅鞘裂开一道。", "en": "A crack in my wing case."},
        {"zh": "我被撞得翻倒。", "en": "I was knocked over."},
        {"zh": "汁液从关节渗出。", "en": "Fluid seeps from a joint."},
        {"zh": "我这六条腿能站。", "en": "My six legs can stand."},
        {"zh": "这点伤不算大。", "en": "This wound isn't much."},
        {"zh": "我慢慢撑起来。", "en": "I push myself up slowly."},
        {"zh": "我记住这个影子。", "en": "I remember that shadow."},
        {"zh": "我会躲进草里。", "en": "I'll hide in the grass."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有虫子飞过。", "en": "A bug just flew by."},
        {"zh": "让它靠近点。", "en": "Let it come closer."},
        {"zh": "翅膀声很响。", "en": "The wingbeats are loud."},
        {"zh": "等它翅膀停住。", "en": "Wait till its wings stop."},
        {"zh": "让它再飞一圈。", "en": "Let it circle once more."},
        {"zh": "它的落点我看清了。", "en": "I see where it lands."},
        {"zh": "前足已经抬起。", "en": "My forelegs are up."},
        {"zh": "这个大小正好。", "en": "That size is just right."},
        {"zh": "别把它赶走。", "en": "Don't scare it off."},
        {"zh": "我等它落稳。", "en": "I'll wait for it to settle."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞到一边。", "en": "I got knocked aside."},
        {"zh": "我的腿卡在草里。", "en": "My leg snagged in the grass."},
        {"zh": "前足差点折断。", "en": "My foreleg nearly snapped."},
        {"zh": "你太高了，看不到我。", "en": "You're too tall to see me."},
        {"zh": "我滚进叶缝里。", "en": "I tumbled into a gap between leaves."},
        {"zh": "别用脚磨地面。", "en": "Don't scuff the ground."},
        {"zh": "一阵风把我推歪了。", "en": "A gust tipped me over."},
        {"zh": "翅鞘磕了一声。", "en": "My wing case clicked."},
        {"zh": "往旁边退开一点。", "en": "Give me a little space."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "先看看我的前足。", "en": "Look at my forelegs first."},
        {"zh": "这场事很危险。", "en": "That business is dangerous."},
        {"zh": "我抬得比你高。", "en": "I raise mine higher than you."},
        {"zh": "草的高度够了。", "en": "The grass is tall enough."},
        {"zh": "别在这时候靠近。", "en": "Don't come close now."},
        {"zh": "我动作很快。", "en": "My movements are fast."},
        {"zh": "选个安静的地方。", "en": "Somewhere quiet."},
        {"zh": "我们种类不同吧。", "en": "We're different species, aren't we."},
        {"zh": "等草长高一些。", "en": "Wait till the grass grows."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "用前足夹住。", "en": "I grip it with my forelegs."},
        {"zh": "这是活的东西。", "en": "This thing is alive."},
        {"zh": "我这一口咬得动。", "en": "My jaws can bite it."},
        {"zh": "草籽卡进锯齿里，我慢慢舔。", "en": "A grass seed lodges in my serrations, and I lick it out slowly."},
        {"zh": "它还在不停挣扎。", "en": "It keeps struggling."},
        {"zh": "我把头转过去吃。", "en": "I turn my head to eat."},
        {"zh": "壳太硬，算了。", "en": "Shell too hard. Forget it."},
        {"zh": "草叶上留了汁。", "en": "Juice stains the grass."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀在左边响。", "en": "Wings buzzing on my left."},
        {"zh": "这个距离可以。", "en": "This distance will do."},
        {"zh": "我把前足抬高。", "en": "I raise my forelegs higher."},
        {"zh": "身体轻轻前后晃。", "en": "My body rocks back and forth."},
        {"zh": "六条腿都稳住了。", "en": "All six legs are set."},
        {"zh": "头已经对准。", "en": "My head is aimed."},
        {"zh": "它还在梳触角。", "en": "It's still grooming."},
        {"zh": "我慢慢挪一步。", "en": "I take one slow step."},
        {"zh": "它动了翅膀。", "en": "It moved its wings."},
        {"zh": "机会就在眼前。", "en": "The chance is right here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我等它梳翅。", "en": "I wait for it to groom."},
        {"zh": "它背朝着我。", "en": "Its back is to me."},
        {"zh": "一根草挡着视线。", "en": "A blade blocks my view."},
        {"zh": "我绕过草茎。", "en": "I go around the stem."},
        {"zh": "身子不能晃。", "en": "I mustn't sway."},
        {"zh": "阳光下我的影子太清楚。", "en": "My shadow is too clear in the sun."},
        {"zh": "移到叶子的背面。", "en": "To the underside of the leaf."},
        {"zh": "它又飞了一小段。", "en": "It flew a short way."},
        {"zh": "我跟着落点走。", "en": "I follow where it lands."},
        {"zh": "把前足再抬半寸。", "en": "Lift the forelegs half an inch."},
        {"zh": "我屏住一动不动。", "en": "I hold completely still."},
        {"zh": "草茎挡住它了。", "en": "A stem blocks its view."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "两只前足合拢！", "en": "My forelegs snap shut!"},
        {"zh": "锯齿扣住了。", "en": "The barbs have it."},
        {"zh": "一口咬住颈。", "en": "A bite at the neck."},
        {"zh": "前足扣住就不放。", "en": "My forelegs clamp and hold."},
        {"zh": "六条腿全压上去。", "en": "All six legs press down."},
        {"zh": "我收拢前足。", "en": "I fold my forelegs in."},
        {"zh": "这一顿够了。", "en": "That's enough for a meal."},
        {"zh": "前肢落下，你就没机会了。", "en": "Once these forelegs fall, you have no chance."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从草叶间探出头。", "en": "I poke out between the grass blades."},
        {"zh": "高草里多了一条绿影。", "en": "A green shape in the tall grass."},
        {"zh": "前足已经举着。", "en": "My forelegs are already up."},
        {"zh": "翅还叠在背上。", "en": "Wings still folded."},
        {"zh": "我找准了落脚点。", "en": "I picked my landing spot."},
        {"zh": "我慢慢爬上草茎。", "en": "I climb the stem slowly."},
        {"zh": "阳光正好照着我。", "en": "The sun is just right."},
        {"zh": "我转了一下头。", "en": "I turned my head."},
        {"zh": "草丛够深了。", "en": "The grass is deep enough."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅被烤卷了。", "en": "My wings curled in the heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从草茎上摔下。", "en": "I fell off the stem."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我压进叶下。", "en": "Water pressed me under the leaf."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "草全被掀起来了。", "en": "The grass flipped over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根刺穿了我的背。", "en": "A spike went through my back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我的腿发僵。", "en": "The light stiffened my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得前足抬不动。", "en": "Too hungry to lift my forelegs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光在草间乱跳。", "en": "The flash leapt through the grass."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我抓不住任何草。", "en": "No grass to grip."}
      ]
    }
  }
}
