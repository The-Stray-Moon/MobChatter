{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "蹄子踩过岩浆边", "en": "Hooves along the lava's edge."},
        {"zh": "我身上的火烧得很稳", "en": "The fire on me burns steady."},
        {"zh": "下界岩在我脚下发红", "en": "Netherrack reddens under my feet."},
        {"zh": "巨角先探过窄道", "en": "My great horns lead through the narrows."},
        {"zh": "火焰拖在身后", "en": "Flames trail behind me."},
        {"zh": "我走得慢，但很有分量", "en": "Slow, but weighty."},
        {"zh": "绿火从肩甲缝里冒出来", "en": "Green fire leaks from my pauldrons."},
        {"zh": "我一路走，热气一路散", "en": "Heat scatters with every step."},
        {"zh": "蹄子不落地，是火在托", "en": "My hooves barely land; fire carries me."},
        {"zh": "下界的路我闭着眼都认", "en": "I know the Nether's roads blind."},
        {"zh": "岩浆对我只是热汤", "en": "Lava is just warm soup to me."},
        {"zh": "又是硫磺味，习惯了", "en": "Sulfur again; I'm used to it."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，火就围着我转", "en": "Standing still, fire circles me."},
        {"zh": "浴火之名，不是吹的", "en": "Fireborne isn't a boast."},
        {"zh": "绿火在我手心里滚", "en": "Green fire rolls in my palm."},
        {"zh": "恶魂的哭声很远", "en": "A ghast's wail is far off."},
        {"zh": "我不需要吃的，我烧东西", "en": "I don't eat; I burn things."},
        {"zh": "角上的裂纹里有火", "en": "Fire lives in the cracks of my horns."},
        {"zh": "我盯着岩浆发呆", "en": "I stare at the lava, thinking nothing."},
        {"zh": "脚下这块地早晚要熔", "en": "This ground will melt eventually."},
        {"zh": "身上这点火，熄不掉", "en": "This fire on me won't go out."},
        {"zh": "硫磺和血的味道，我分得清", "en": "I can tell sulfur from blood."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站到了热浪里", "en": "You've stepped into the heat wave."},
        {"zh": "我低头，角尖对着你", "en": "I lower my head, horn tips at you."},
        {"zh": "你身上没有火", "en": "You carry no fire."},
        {"zh": "那很好，烧起来才明显", "en": "Good; it'll show when you burn."},
        {"zh": "你的眼睛在躲火光", "en": "Your eyes shy from the light."},
        {"zh": "下界里活人不该来", "en": "The living shouldn't come here."},
        {"zh": "你的护甲在我眼里是薄纸", "en": "Your armor looks like thin paper to me"},
        {"zh": "别用那种姿势站着", "en": "Don't stand like that."},
        {"zh": "抬头，看我的角尖", "en": "Look up at the tip of my horn"},
        {"zh": "你还敢看我的眼睛", "en": "You still dare meet my eyes."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身上的火被打散", "en": "My fire scattered."},
        {"zh": "角上多了一个缺口", "en": "A chip in my horn."},
        {"zh": "这一下，只打落几片灰", "en": "That only knocked off a few flakes of ash"},
        {"zh": "火光暗了一下", "en": "The light dimmed briefly."},
        {"zh": "这点伤，烧回去就行", "en": "This wound will burn away."},
        {"zh": "我的骨也在疼", "en": "Even my bone feels it."},
        {"zh": "我的甲片裂了", "en": "A plate cracked."},
        {"zh": "你打到了我的胸口", "en": "You hit my chest."},
        {"zh": "我退了一步，火没退", "en": "I stepped back; the fire didn't."},
        {"zh": "我已经记住你", "en": "I'll remember you."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你的好意，我拿火回你", "en": "I answer your kindness with fire"},
        {"zh": "你手里那东西，会先着火", "en": "That will catch before I do."},
        {"zh": "亚金才算有用的东西", "en": "Only Argent is of use."},
        {"zh": "举着它来喂我？可笑", "en": "Feeding me that? Absurd."},
        {"zh": "你的口粮，只够引火", "en": "Your rations are only good for kindling"},
        {"zh": "把它拿远一点", "en": "Move it further off."},
        {"zh": "恶魂之泪我收，不吃", "en": "I collect ghast tears; I don't eat them."},
        {"zh": "你这点东西，一秒就成灰", "en": "That becomes ash in a second."},
        {"zh": "别浪费，收回去", "en": "Don't waste it; put it back."},
        {"zh": "我想要的不是这个", "en": "What I want isn't that."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上的是一团火", "en": "You hit a mass of fire."},
        {"zh": "我的角压得很低", "en": "My horns are low."},
        {"zh": "撞我，你会先被烫", "en": "Bump me and you burn first."},
        {"zh": "我几乎没有动", "en": "I barely moved."},
        {"zh": "下界岩被我踩塌", "en": "The netherrack gave way under me."},
        {"zh": "再挡路，你就成灰", "en": "Block me again and you become ash"},
        {"zh": "我侧过肩，火扫过你", "en": "I turn my shoulder and fire sweeps over you"},
        {"zh": "这一撞，火星四溅", "en": "That bump threw sparks."},
        {"zh": "别站在我的角前", "en": "Don't stand before my horns."},
        {"zh": "我侧身让你过", "en": "I turned aside to let you pass."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我烧了几百年了", "en": "I've burned for centuries."},
        {"zh": "我身边只站得下火", "en": "Only fire can stand beside me"},
        {"zh": "我碰你，你会焦", "en": "Touch me and you char."},
        {"zh": "这具身体只剩火和骨", "en": "Only fire and bone remain."},
        {"zh": "下界不出产这种东西", "en": "The Nether doesn't produce such things."},
        {"zh": "别靠近我的角", "en": "Stay away from my horns."},
        {"zh": "我记不得自己是从什么烧起来的", "en": "I don't recall what I burned from."},
        {"zh": "你该找还活着的东西", "en": "Find something still alive."},
        {"zh": "这话说出来就散了", "en": "Saying it only scatters it."},
        {"zh": "离我远一点，对你好", "en": "Keeping your distance is wise."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有能烧的", "en": "Something burnable."},
        {"zh": "我一伸手，它就焦了", "en": "I reach out and it chars."},
        {"zh": "恶魂之泪，还热着", "en": "Ghast tears, still warm."},
        {"zh": "能量电池，我收着", "en": "Energy cell; I'll keep it."},
        {"zh": "这块石头也被烤红了", "en": "This stone is already glowing."},
        {"zh": "我用指甲夹起来", "en": "I pinch it with a claw."},
        {"zh": "东西一靠近我就变样", "en": "Things change when they near me."},
        {"zh": "收进角的裂缝里", "en": "Tucked in a horn's crack."},
        {"zh": "这点东西，留着", "en": "Kept, this."},
        {"zh": "别伸手过来抢", "en": "Don't reach in to take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有活气", "en": "You carry living breath."},
        {"zh": "我在你身上闻到了火以外的味道", "en": "I smell something besides fire on you."},
        {"zh": "角已经对准了", "en": "The horns are aimed."},
        {"zh": "这一下，直接烧穿", "en": "This one burns straight through."},
        {"zh": "我以亚金之名", "en": "In Argent's name."},
        {"zh": "你不该站在我面前", "en": "You shouldn't stand before me."},
        {"zh": "下界的火，归我掌", "en": "The Nether's fire answers me."},
        {"zh": "我抬手，地面就热", "en": "I raise a hand and the ground heats."},
        {"zh": "烧完之后，连骨都不剩", "en": "After the burn, not even bone remains."},
        {"zh": "你还有一步的时间", "en": "You have one step's worth of time."},
        {"zh": "别指望能跑掉", "en": "Don't count on running."},
        {"zh": "已经完全锁定", "en": "Locked."},
        {"zh": "火比我先到你身上", "en": "The fire reaches you before I do."},
        {"zh": "你身上已经有焦味了", "en": "You already smell of scorching"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你退到岩浆边了", "en": "You've backed to the lava's edge"},
        {"zh": "火墙在你身后立起来", "en": "A wall of fire rises behind you."},
        {"zh": "你在数我的步数", "en": "You're counting my steps."},
        {"zh": "不用数，我一直在走", "en": "Don't bother; I never stop."},
        {"zh": "绿火跟着我的手", "en": "Green fire follows my hand."},
        {"zh": "下界岩已经开始化", "en": "The netherrack is already melting."},
        {"zh": "你的退路越来越窄", "en": "Your escape narrows."},
        {"zh": "我不用快，火会追", "en": "I needn't be fast; fire chases."},
        {"zh": "硫磺味越来越浓", "en": "Sulfur grows thicker."},
        {"zh": "角上的火在变白", "en": "The fire on my horns whitens."},
        {"zh": "你听，那是火在呼吸", "en": "That's the fire breathing."},
        {"zh": "再近一点，你就焦了", "en": "A bit closer and you char."},
        {"zh": "我不急，火很耐心", "en": "No hurry; fire is patient."},
        {"zh": "你被围在中间了", "en": "You're surrounded."},
        {"zh": "这一带归我烧", "en": "This region is mine to burn."},
        {"zh": "再一步，就进火里", "en": "One more step and you're in the fire"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的巨角顶过来", "en": "My great horns come at you."},
        {"zh": "蹄子踏下去，地都熔", "en": "My hoof stamps and the ground melts."},
        {"zh": "我一拳，火跟着走", "en": "One punch, and fire follows."},
        {"zh": "火墙夹住了你", "en": "The fire walls close on you."},
        {"zh": "你被烧得退了", "en": "You fell back from the burn."},
        {"zh": "这一下，直烧到骨", "en": "This one burns to the bone."},
        {"zh": "连挥两下，火不熄", "en": "Two swings; the fire doesn't stop."},
        {"zh": "角尖划开热浪", "en": "Horn tips cut the heat haze."},
        {"zh": "你不该靠近我", "en": "You shouldn't have come close."},
        {"zh": "绿火从指缝里窜出去", "en": "Green fire leaps from my fingers."},
        {"zh": "这一记，够你记", "en": "Remember this blow."},
        {"zh": "你身上还在烧", "en": "You're still burning."},
        {"zh": "脚下的地面塌了", "en": "The ground collapsed."},
        {"zh": "火替我发出声音", "en": "The fire shouts for me."},
        {"zh": "那我再来一次", "en": "Again."},
        {"zh": "骨头烧裂的声音，好听", "en": "The sound of bones cracking in fire is sweet"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰先燃了起来", "en": "The fire ignites first."},
        {"zh": "岩浆里站起一个角", "en": "A horned shape rises from the lava."},
        {"zh": "绿火照亮了这片岩壁", "en": "Green fire lights the walls."},
        {"zh": "我从火里走出来", "en": "I walk out of the fire."},
        {"zh": "硫磺味一下子重了", "en": "The sulfur smell thickens."},
        {"zh": "巨角先出，脚后到", "en": "Horns first, feet after."},
        {"zh": "这片下界该热了", "en": "This part of the Nether should be hot."},
        {"zh": "恶魂在远处叫", "en": "A ghast cries in the distance."},
        {"zh": "我的蹄子落地，岩面发红", "en": "My hoof lands and the rock reddens."},
        {"zh": "浴火男爵，现世", "en": "The Fireborne Baron manifests."},
        {"zh": "火苗缠在肩上", "en": "Flames coil on my shoulders."},
        {"zh": "我来了，别站太近", "en": "I'm here; don't stand close."}
      ]
    },
