      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我角上，火更旺了", "en": "Lightning struck my horns and the fire blazed."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有地面，火也托不住", "en": "No ground, and fire can't hold me."}
      ]
