{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用八条加固的腿走", "en": "I move on eight reinforced legs"},
        {"zh": "我的外壳比旧型号厚", "en": "My shell is thicker than the old model"},
        {"zh": "我走起来有金属的节奏", "en": "My walk has a metallic rhythm"},
        {"zh": "我的炮口两侧有散热片", "en": "Heat sinks flank my cannon"},
        {"zh": "我从高处爬下来", "en": "I crawl down from the height"},
        {"zh": "我的腿在地面敲出凹痕", "en": "My legs dent the ground"},
        {"zh": "我在下界的岩台上巡", "en": "I patrol the Nether's ledges"},
        {"zh": "我转过身，散热片张开", "en": "I turn and the heat sinks open"},
        {"zh": "我一步一顿碾过去", "en": "I grind forward, step by step"},
        {"zh": "我从火光旁边走过", "en": "I pass beside the firelight"},
        {"zh": "我的关节带着液压的声音", "en": "My joints hiss with hydraulics"},
        {"zh": "我朝你那一侧横移", "en": "I crab toward your side"},
        {"zh": "我的散热片随着步子开合", "en": "My sinks open and close with each step"},
        {"zh": "我在岩脊上找射位", "en": "I hunt for a firing position on the ridge"},
        {"zh": "我绕过一堆冷却的熔岩", "en": "I skirt a cooled lava flow"},
        {"zh": "我的影子在红雾里很重", "en": "My shadow lies heavy in the red haze"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，散热片全开", "en": "I stand with all heat sinks open"},
        {"zh": "我的炮管在慢慢冷却", "en": "My barrel cools slowly"},
        {"zh": "我身上的铁很新", "en": "The iron on me is new"},
        {"zh": "我在扫视这片岩台", "en": "I scan this ledge"},
        {"zh": "我的脑壳被装甲护着", "en": "My brain is armored over"},
        {"zh": "我在等取景框里的东西", "en": "I wait for something in my sights"},
        {"zh": "我的腿一节节绷着", "en": "My legs stay coiled"},
        {"zh": "火光照出我表面的划痕", "en": "Firelight shows the scratches on me"},
        {"zh": "我根本没有心跳", "en": "I have no heartbeat at all"},
        {"zh": "我把一条腿换了位置", "en": "I move one leg"},
        {"zh": "我的传感器在转", "en": "My sensor turns"},
        {"zh": "我在测你肺里的气", "en": "I'm measuring your lungs"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我扫描了你一遍", "en": "I've scanned you once"},
        {"zh": "你的护甲不算厚", "en": "Your armor isn't thick"},
        {"zh": "我的炮口对准你的胸口", "en": "My cannon is level with your chest"},
        {"zh": "你站在那里别动", "en": "Stand there and don't move"},
        {"zh": "你的心跳太快", "en": "Your heart is too fast"},
        {"zh": "我记住了你的轮廓", "en": "I have your outline logged"},
        {"zh": "你退到射界边缘", "en": "You've moved to the edge of my arc"},
        {"zh": "我又把你框进来了", "en": "I've framed you again"},
        {"zh": "你比旧型号的猎物聪明", "en": "You're smarter than the old model's prey"},
        {"zh": "可你也不够快", "en": "But you aren't fast enough"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的装甲凹了一块", "en": "A dent appears in my plating"},
        {"zh": "我退了一步，腿稳住", "en": "I step back and my legs hold"},
        {"zh": "我的炮口偏了一点", "en": "My muzzle drifts off line"},
        {"zh": "我又重新校准", "en": "I recalibrate"},
        {"zh": "一处散热片卡住了", "en": "One heat sink sticks"},
        {"zh": "我运转时一点不出声", "en": "I run without a sound"},
        {"zh": "我把重心往八条腿上放", "en": "I settle my weight onto all eight legs"},
        {"zh": "我的腿还在算", "en": "My legs keep computing"},
        {"zh": "我的准星还咬着你", "en": "My reticle still holds you"},
        {"zh": "我还能够开火", "en": "I can still fire"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "亚金能源，我闻得到", "en": "Argent energy; I can smell it"},
        {"zh": "这个浓度很高", "en": "This concentration is high"},
        {"zh": "你手上有残余", "en": "There's residue on your hands"},
        {"zh": "你把它交出来", "en": "Hand it over"},
        {"zh": "我的电池快空了", "en": "My cells are nearly dry"},
        {"zh": "再往我这儿靠两步", "en": "Two steps closer to me"},
        {"zh": "我不需要吃，我需要它", "en": "I don't eat; I need it"},
        {"zh": "这个能让我更快", "en": "This would make me faster"},
        {"zh": "你带着它, 就别想走", "en": "Carry it and you won't leave"},
        {"zh": "我等你自己送上来", "en": "I wait for you to bring it"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的装甲上", "en": "You hit my plating"},
        {"zh": "我连一节腿都没动", "en": "Not one of my joints shifted"},
        {"zh": "我的散热片擦到你", "en": "My heat sink grazes you"},
