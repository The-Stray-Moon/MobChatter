    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一发等离子打过去", "en": "I send a plasma shot across"},
        {"zh": "这一下打在墙上，化了一个洞", "en": "It burns a hole in the wall"},
        {"zh": "我用前腿砸下去", "en": "I bring a foreleg down"},
