        {"zh": "我把炮管抬起来", "en": "I raise the barrel"},
        {"zh": "你要跑也来不及", "en": "Running won't be fast enough"},
        {"zh": "这一片没有掩体", "en": "There's no cover here"},
        {"zh": "第一下是校准", "en": "The first is calibration"},
        {"zh": "第二下是正题", "en": "The second is the point"},
        {"zh": "你每一步我腿上都有感应", "en": "Every step you take registers in my legs"},
        {"zh": "我现在只做一件事", "en": "I have one task now"},
        {"zh": "现在正式开始", "en": "Now it properly begins"}
      ]
    },
