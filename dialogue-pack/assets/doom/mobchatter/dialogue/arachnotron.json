{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用八条腿横着走", "en": "I move sideways on eight legs"},
        {"zh": "我的机械腿砸在地上", "en": "My mechanical legs pound the ground"},
        {"zh": "我的炮口一直朝前", "en": "My cannon points forward"},
        {"zh": "我从岩浆边上绕过去", "en": "I skirt the lava's edge"},
        {"zh": "我一节一节挪动身体", "en": "I shift my body joint by joint"},
        {"zh": "我的脑壳露在外面，一晃一晃", "en": "My exposed brain lolls as I move"},
        {"zh": "我在下界的碎石上踩出坑", "en": "My legs crater the Nether rubble"},
        {"zh": "我转过身体，炮口跟着转", "en": "I turn and the cannon follows"},
        {"zh": "我的腿关节在响", "en": "My leg joints grind"},
        {"zh": "我一步一顿逼过来", "en": "I clank in, step by step"},
        {"zh": "我从岩壁的阴影里出来", "en": "I come out of the cliff's shadow"},
        {"zh": "我在火光里走，铁皮发亮", "en": "Firelight runs over my iron"},
        {"zh": "我的腿在身后留下八个坑", "en": "My legs leave eight pits behind"},
        {"zh": "我边走边把炮口压低", "en": "I lower the muzzle as I walk"},
        {"zh": "我贴着岩壁横移", "en": "I crab along the cliff"},
        {"zh": "我踩碎了脚下一块浮石", "en": "I crush a loose stone underfoot"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，八条腿撑着", "en": "I stand on eight legs"},
        {"zh": "我的炮口缓缓转", "en": "My cannon turns slowly"},
        {"zh": "我身上的铁在响", "en": "The iron on me ticks"},
        {"zh": "我在数前面的动静", "en": "I'm reading the movement ahead"},
        {"zh": "我的腿微微一起一落", "en": "My legs rise and fall slightly"},
        {"zh": "下界的风吹过我的壳", "en": "Nether wind passes my shell"},
        {"zh": "我的脑子里有东西在动", "en": "Something moves in my brain"},
        {"zh": "我在等目标进入射界", "en": "I wait for a target to enter my arc"},
        {"zh": "我根本不需要呼吸", "en": "I don't need to breathe"},
        {"zh": "火光映在我的炮管上", "en": "Firelight glints on my barrel"},
        {"zh": "我把一条腿挪了挪", "en": "I shift one leg"},
        {"zh": "我的关节自己响了一下", "en": "A joint ticks on its own"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进我的射界了", "en": "You've walked into my arc"},
        {"zh": "我的炮口转向你", "en": "My cannon turns to you"},
        {"zh": "你比我小得多", "en": "You're much smaller than I"},
        {"zh": "我抬起前面两条腿", "en": "I lift the front two legs"},
        {"zh": "你身上有金属", "en": "There's metal on you"},
        {"zh": "你退了两步，履带声近了。", "en": "Two steps back; my treads are closer."},
        {"zh": "我的腿比你高", "en": "My legs stand taller than you"},
        {"zh": "你听听，铁在响", "en": "Listen; the iron ticks"},
        {"zh": "这一带由我架着炮", "en": "I've got my gun on this ground"},
        {"zh": "我等着你靠近", "en": "I wait for you to come near"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腿退了一步", "en": "One of my legs gives a step"},
        {"zh": "铁壳上多了一个坑", "en": "A dent appears in my shell"},
        {"zh": "我的八条腿，是金属的。", "en": "My eight legs are metal."},
        {"zh": "我停了一下，重新校准", "en": "I pause and recalibrate"},
        {"zh": "我的关节在空转", "en": "A joint spins free"},
        {"zh": "我连液压都不出声", "en": "Not even my hydraulics sound"},
        {"zh": "我抬起一条断腿", "en": "I lift a broken leg"},
        {"zh": "我慢慢调整重心", "en": "I shift my weight carefully"},
        {"zh": "我还在射界内", "en": "I'm still in the arc"},
        {"zh": "我继续瞄准你", "en": "I keep my aim on you"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那股亚金能源的味道", "en": "That smell of Argent energy"},
        {"zh": "我闻到能量了", "en": "I smell energy"},
        {"zh": "那团热量，喂我的炮膛。", "en": "That heat will feed my cannon."},
        {"zh": "你把它举到我眼前", "en": "Raise it up to my eyes"},
        {"zh": "我会自己去取", "en": "I'll come and take it"},
        {"zh": "那东西离我太远", "en": "That's too far from me"},
        {"zh": "我等它靠过来", "en": "I wait for it to come near"},
        {"zh": "能量会让我更快", "en": "Energy would make me faster"},
        {"zh": "你也带着一些", "en": "You carry some as well"},
        {"zh": "那就一起拿来", "en": "Then bring it all"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的腿上，像撞铁柱", "en": "You hit my leg like a pillar of iron"},
        {"zh": "我一点也没有动", "en": "I don't move at all"},
        {"zh": "我的腿把你拨开", "en": "A leg sweeps you aside"},
        {"zh": "你从我身下跑过去", "en": "You run beneath me"},
        {"zh": "我的壳撞到岩壁", "en": "My shell hits the cliff"},
        {"zh": "碎石从岩壁上滚下来", "en": "Rubble rolls down the cliff"},
        {"zh": "你退开了，我继续转", "en": "You pull back and I keep turning"},
        {"zh": "我的炮口磕了一下", "en": "My cannon knocks something"},
        {"zh": "这一下连铁皮都没破", "en": "That didn't even crack my plate"},
        {"zh": "我把八条腿重新支稳", "en": "I re-set all eight legs"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一台从岩浆那头过来", "en": "Another unit comes from beyond the lava"},
        {"zh": "它的腿比我的多一节", "en": "Its legs have an extra joint"},
        {"zh": "我们一起转，炮口错开", "en": "We turn together, cannons clearing"},
        {"zh": "它的脑壳比我完整", "en": "Its brain casing is more intact"},
        {"zh": "我们一起守在路口", "en": "We guard the crossing together"},
        {"zh": "铁和铁碰了一下", "en": "Iron meets iron"},
        {"zh": "我们没有语言", "en": "We have no language"},
        {"zh": "我们同时把腿压下去", "en": "We plant our legs at the same moment"},
        {"zh": "这一片够两台守", "en": "This ground holds two"},
        {"zh": "我们都等着同一个目标", "en": "We wait for the same target"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前腿夹起来", "en": "I pinch it with a foreleg"},
        {"zh": "这东西是热的", "en": "This thing is warm"},
        {"zh": "我把它塞进腹部", "en": "I tuck it into my belly"},
        {"zh": "它在我里面响了一下", "en": "It pulses inside me"},
        {"zh": "这东西能供能", "en": "This can fuel me"},
        {"zh": "这一点太少了", "en": "This is not enough"},
        {"zh": "我把它压成了粉", "en": "I crush it to powder"},
        {"zh": "它化成了一点光", "en": "It turns into a speck of light"},
        {"zh": "我把它挂在腿边", "en": "I hang it by my leg"},
        {"zh": "下一次要更多", "en": "Next time I want more"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
