{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "铁蹄踏在下界岩上", "en": "Iron hooves on netherrack."},
        {"zh": "我的腿是钢的，脾气也是", "en": "Steel legs, steel temper."},
        {"zh": "背后那两个引擎一直在响", "en": "The two engines on my back never stop."},
        {"zh": "走一步，岩浆都溅起来", "en": "One step and lava splashes up."},
        {"zh": "下界没有比我更响的东西", "en": "Nothing in the Nether is louder than me."},
        {"zh": "我的肩甲磨着石壁", "en": "My shoulder plates scrape the stone."},
        {"zh": "角是长在头骨上的", "en": "These horns grew from the skull."},
        {"zh": "这条走廊太窄了", "en": "This corridor is too narrow."},
        {"zh": "我走得慢，压迫感很足", "en": "Slow steps, heavy presence."},
        {"zh": "脚一落，地面就裂", "en": "The ground cracks when my foot lands."},
        {"zh": "岩浆池在我脚下像水洼", "en": "Lava pools are puddles underfoot."},
        {"zh": "身后的管子在排气", "en": "The pipes behind me vent smoke."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站着也像在蓄力", "en": "Standing, I still look like I'm charging."},
        {"zh": "机械和血肉，一半一半", "en": "Half machine, half flesh."},
        {"zh": "我的呼吸声像风箱", "en": "My breathing sounds like bellows."},
        {"zh": "下界的硫磺味，很习惯", "en": "Sulfur's smell; I'm used to it."},
        {"zh": "炮口现在还热着", "en": "The cannon's still warm."},
        {"zh": "我不需要休息，只是懒得动", "en": "I need no rest; I simply won't move."},
        {"zh": "我在等一个能打的目标", "en": "Waiting for a target worth fighting."},
        {"zh": "肩上的管线滴着黑油", "en": "Black oil drips from my shoulder pipes."},
        {"zh": "我的心脏在铁壳里跳", "en": "My heart beats inside an iron shell."},
        {"zh": "站久了，脚下的石头会陷", "en": "Stand long enough and the stone sinks."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我的炮管小", "en": "You're smaller than my cannon."},
        {"zh": "两条腿的东西，站那别动", "en": "Two-legged thing, stay put."},
        {"zh": "我认得猎杀者的味道", "en": "I know the smell of a slayer."},
        {"zh": "你的武器不够看", "en": "Your weapon is unimpressive."},
        {"zh": "你还有几秒可以考虑", "en": "You have seconds to reconsider."},
        {"zh": "下界里没有活人能站着看我", "en": "No living thing stands and watches me here."},
        {"zh": "你手在抖，我看得见", "en": "I see your hand shaking."},
        {"zh": "别把枪口抬起来", "en": "Don't raise that barrel."},
        {"zh": "这一眼，是你最后的机会", "en": "This look is your last chance."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "铁壳被打凹了", "en": "The iron's been dented."},
        {"zh": "这点伤，我的壳挡了大半", "en": "Most of it stopped at my shell."},
        {"zh": "引擎漏了一点油", "en": "An engine's leaking oil."},
        {"zh": "我的血肉部分在疼", "en": "The flesh part hurts."},
        {"zh": "你打到了一个缝隙", "en": "You found a seam."},
        {"zh": "我退了一步，很罕见", "en": "I stepped back; that's rare."},
        {"zh": "角上又多一道裂", "en": "Another crack on my horns."},
        {"zh": "这下让我认真了", "en": "Now I'm taking this seriously."},
        {"zh": "再打一次试试", "en": "Try that again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不需要吃东西", "en": "I don't eat."},
        {"zh": "你的燃料？拿来", "en": "Your fuel? Hand it over."},
        {"zh": "能量电池才对我有用", "en": "Only energy cells are of use to me."},
        {"zh": "举着那东西，很蠢", "en": "Holding that up is foolish."},
        {"zh": "下界岩不能吃，你的也不能", "en": "Netherrack isn't food, and neither is yours."},
        {"zh": "我靠亚金活着", "en": "I live on Argent."},
        {"zh": "那不是饵，那是垃圾", "en": "That's not bait; that's garbage."},
        {"zh": "你要喂我，就先靠近", "en": "Feed me, then come closer."},
        {"zh": "我不饿，我想要的是别的东西", "en": "I'm not hungry; I want something else."},
        {"zh": "拿回去，别浪费我的时间", "en": "Take it back; don't waste my time."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上铁，弹回去了", "en": "You hit iron and bounced."},
        {"zh": "我的铁腿不会弯", "en": "My legs don't bend."},
        {"zh": "让开，我这一脚很重", "en": "Move; my foot is heavy."},
        {"zh": "撞我等于撞一堵钢墙", "en": "Bumping me is bumping a steel wall."},
        {"zh": "你被我的引擎吹开了", "en": "My engines blew you aside."},
        {"zh": "这点碰撞，我都没听见", "en": "I didn't even hear that."},
        {"zh": "我侧身都费劲", "en": "Even turning sideways is effort."},
        {"zh": "别站在我的蹄子前面", "en": "Don't stand in front of my hooves."},
        {"zh": "你踩到管线了", "en": "You stepped on a pipe."},
        {"zh": "再撞，我就踩下去", "en": "Bump again and I stomp."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是造出来的怪物", "en": "I'm a made monster."},
        {"zh": "没有同类，也不需要", "en": "No kin, and no need."},
        {"zh": "我的身体一半是零件", "en": "Half of me is parts."},
        {"zh": "下界不产这种东西", "en": "The Nether doesn't produce such things."},
        {"zh": "你在问一块铁", "en": "You're asking a piece of iron."},
        {"zh": "我的用途只有一个", "en": "I have only one purpose."},
        {"zh": "别靠太近，管子会烫", "en": "Not so close; the pipes burn."},
        {"zh": "我连血都很少", "en": "I barely have blood."},
        {"zh": "这问题毫无意义", "en": "A meaningless question."},
        {"zh": "去找活的东西问", "en": "Ask something living."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有亮的东西", "en": "Something glints on the ground."},
        {"zh": "我弯腰，铁甲咔咔响", "en": "I bend; my armor clanks."},
        {"zh": "能量电池，我的东西", "en": "Energy cells: mine."},
        {"zh": "恶魂之泪，也收着", "en": "Ghast tears too; I keep them."},
        {"zh": "我捡起来，塞进胸甲", "en": "I pick it up and tuck it in my chest plate."},
        {"zh": "这点碎屑，不值得弯腰", "en": "This scrap isn't worth bending for."},
        {"zh": "下界岩缝里常有好东西", "en": "Netherrack cracks often hide gifts."},
        {"zh": "别抢，我一脚能踩碎它", "en": "Don't grab; I'd crush it underfoot."},
        {"zh": "收好，下次用得上", "en": "Kept for next time."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踏进了我的范围", "en": "You've entered my range."},
        {"zh": "炮口转过去了", "en": "The cannon has turned."},
        {"zh": "我这一炮不讲道理", "en": "This cannon doesn't reason."},
        {"zh": "下界的规矩，是强者先动手", "en": "In the Nether, the strong strike first."},
        {"zh": "我不追，我轰", "en": "I don't chase; I shell."},
        {"zh": "你是今天的第三个", "en": "You're the third today."},
        {"zh": "引擎开始加压", "en": "Engines spooling up."},
        {"zh": "我很久没活动了", "en": "I haven't moved in a long while."},
        {"zh": "尖角朝你，炮口也对准你", "en": "Horns toward you, cannon too."},
        {"zh": "别退到岩浆边", "en": "Don't back toward the lava."},
        {"zh": "这一场，很快", "en": "This will be quick."},
        {"zh": "我的血管里流的是火", "en": "Fire runs in my veins."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛锁着你", "en": "My eyes are locked on you."},
        {"zh": "炮口的光越来越亮", "en": "The cannon's glow is brightening."},
        {"zh": "你绕过柱子也没用", "en": "Hiding behind pillars won't help."},
        {"zh": "下界的石头挡不住我", "en": "Nether stone doesn't stop me."},
        {"zh": "你在算我的冷却时间", "en": "You're counting my cooldown."},
        {"zh": "冷却时间很短", "en": "The cooldown is short."},
        {"zh": "岩浆在你脚边涨", "en": "Lava is rising at your feet."},
        {"zh": "我的影子盖住整条走廊", "en": "My shadow fills the corridor."},
        {"zh": "你听，引擎在尖叫", "en": "Hear the engines screaming?"},
        {"zh": "我不用快，我够大", "en": "I needn't be fast; I'm big."},
        {"zh": "角上的裂纹是旧伤", "en": "The cracks on my horns are old wounds."},
        {"zh": "再走三步，就到射程", "en": "Three more steps and you're in range."},
        {"zh": "我不会给你时间", "en": "I won't give you time."},
        {"zh": "这一炮，躲不开", "en": "You can't dodge this shot."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一脚下去，地都塌", "en": "My stomp collapses the ground."},
        {"zh": "我的角顶过来", "en": "My horns come at you."},
        {"zh": "铁拳砸在你面前", "en": "My iron fist slams down before you."},
        {"zh": "炮口贴近了才开火", "en": "I fire only when the barrel's close."},
        {"zh": "这一拳带着火焰", "en": "This fist carries fire."},
        {"zh": "你被冲击震退了", "en": "The shock threw you back."},
        {"zh": "我连着挥了三下", "en": "Three swings in a row."},
        {"zh": "血肉和机械一起发力", "en": "Flesh and machine drive it together."},
        {"zh": "下界岩碎成渣", "en": "Netherrack crumbles to grit."},
        {"zh": "你的护甲挡不住的", "en": "Your armor won't hold."},
        {"zh": "这一下，算轻的", "en": "That one was light."},
        {"zh": "我抬脚，你就得让", "en": "When my foot rises, you move."},
        {"zh": "角尖划开空气", "en": "My horn tip cuts the air."},
        {"zh": "连岩浆都被掀起来", "en": "Even the lava gets thrown up."},
        {"zh": "再补上这一拳", "en": "One more fist."},
        {"zh": "这一场这样就结束了", "en": "Finished."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "下界岩裂开，我上来", "en": "The netherrack splits; I rise."},
        {"zh": "铁与肉拼成的身体站直了", "en": "The iron-and-flesh body straightens."},
        {"zh": "双角先探出来", "en": "The horns come out first."},
        {"zh": "我的呼吸把火吹旺", "en": "My breath stokes the fire."},
        {"zh": "这一片下界归我踩", "en": "This stretch of the Nether is mine to tread."},
        {"zh": "炮口还冷着，很快会热", "en": "The barrel's cold; it won't be long."},
        {"zh": "硫磺味变浓了", "en": "The sulfur smell thickens."},
        {"zh": "我来了，猎杀者呢", "en": "I'm here; where's the slayer?"},
        {"zh": "铁链和管线一起响", "en": "Chains and tubes rattle together."},
        {"zh": "下界多了一个大东西", "en": "The Nether has one more big thing."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我没什么用", "en": "Fire does little to me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时，铁腿震了一下", "en": "On landing, my iron legs jolted."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水？在这个地方？", "en": "Water? Here?"}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击掀开了一块装甲", "en": "The blast peeled off a plate."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西卡进我的关节", "en": "Something lodged in my joint."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这不是下界的把戏", "en": "This isn't a Nether trick."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有亚金补充，引擎在喘", "en": "No Argent to draw on; the engines gasp."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在角上，整条腿都麻", "en": "Lightning hit my horn and numbed the leg."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我也在往下掉", "en": "Nothing below, and even I fall."}
      ]
    }
  }
}
