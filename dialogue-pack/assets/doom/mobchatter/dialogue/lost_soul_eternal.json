{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我这团火，烧得更久。", "en": "My fire burns longer than most."},
        {"zh": "骨头外面裹着一层焦壳。", "en": "Bone cased in charred shell."},
        {"zh": "冲向你是直线。", "en": "My charge is a straight line."},
        {"zh": "下界的硫味，我习惯了。", "en": "The nether's sulfur is familiar."},
        {"zh": "我掠过熔岩，火更旺。", "en": "Skimming lava, my fire grows."},
        {"zh": "身后的热浪能烫人。", "en": "The heat behind me can burn."},
        {"zh": "我不需要翅膀。", "en": "I need no wings."},
        {"zh": "火焰拖得老长。", "en": "My flame trails long."},
        {"zh": "我的头骨上有裂痕。", "en": "Cracks run across my skull."},
        {"zh": "近了，你会听见呼啸。", "en": "Close by, you'll hear the roar."},
        {"zh": "我撞过的墙，都塌了。", "en": "Walls I've hit have fallen."},
        {"zh": "永恒版，就是烧不完。", "en": "The Eternal kind never burns out."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "火在烧，我在等。", "en": "Fire burns; I wait."},
        {"zh": "没有心跳，只有噼啪。", "en": "No heartbeat — only crackle."},
        {"zh": "这具身体，早就不疼了。", "en": "This body stopped hurting long ago."},
        {"zh": "我在下界飘了很多年。", "en": "I've drifted the nether for years."},
        {"zh": "火苗忽高忽低。", "en": "The flame rises and falls."},
        {"zh": "岩壁上映着我的影子。", "en": "My shadow plays on the rock."},
        {"zh": "我不困，也不需要醒。", "en": "I neither sleep nor wake."},
        {"zh": "火星落在石上，灭了。", "en": "Embers land and die."},
        {"zh": "我悬在熔岩上方。", "en": "I hover above the lava."},
        {"zh": "火烧得稳，不急。", "en": "The fire burns steady; no hurry."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你周身一点火气都没有。", "en": "There's not a spark about you."},
        {"zh": "我看着你，眼眶在烧。", "en": "I watch you, sockets burning."},
        {"zh": "你的武器，对我没什么用。", "en": "Your weapon does little to me."},
        {"zh": "你站得太靠里了。", "en": "You're standing too far in."},
        {"zh": "火光照出你的脸。", "en": "Firelight finds your face."},
        {"zh": "我记得上次撞人的手感。", "en": "I remember the feel of the last impact."},
        {"zh": "别盯着我看，会烫。", "en": "Don't stare; it burns."},
        {"zh": "你不是下界的东西。", "en": "You're not of the nether."},
        {"zh": "我笑了，火从嘴里冒。", "en": "I laugh; flame spills out."},
        {"zh": "你要跑，就现在。", "en": "Run now if you will."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头上掉了块焦壳。", "en": "A chunk of char falls off."},
        {"zh": "我退开，火还在。", "en": "I fall back, still burning."},
        {"zh": "裂痕又多了一道。", "en": "Another crack appears."},
        {"zh": "我被撞偏了方向。", "en": "I'm knocked off course."},
        {"zh": "没血肉，伤得干脆。", "en": "No flesh; the wound is clean."},
        {"zh": "火焰低了一点。", "en": "My flame burns lower."},
        {"zh": "我抖了抖，火苗乱跳。", "en": "I shudder; the flame jumps."},
        {"zh": "再来多少次都一样。", "en": "No matter how many times."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我这张嘴里只进火。", "en": "Only fire goes into this jaw."},
        {"zh": "火会把它们烧光。", "en": "Fire would consume them."},
        {"zh": "我没有肚子。", "en": "I have no belly."},
        {"zh": "你把东西举高，我照样撞。", "en": "Hold it high; I still charge."},
        {"zh": "这点诱饵连火星都换不来。", "en": "That bait won't buy a spark."},
        {"zh": "别晃了，浪费时间。", "en": "Stop waving it; waste of time."},
        {"zh": "我要的只有撞上去那下。", "en": "All I want is the impact."},
        {"zh": "拿开，我要过去了。", "en": "Move it; I'm coming through."},
        {"zh": "你留着那点东西。", "en": "Keep that little bit for yourself."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "实打实的一下。", "en": "A solid hit."},
        {"zh": "你的甲被烧黑了。", "en": "Your armor is scorched black."},
        {"zh": "我弹回去，火没散。", "en": "I rebound; the fire holds."},
        {"zh": "这点撞，我习惯了。", "en": "I'm used to impacts."},
        {"zh": "我又对准你了。", "en": "I'm lined up on you again."},
        {"zh": "头骨撞得发闷。", "en": "My skull rings dully."},
        {"zh": "你被顶退了两步。", "en": "You're shoved back two steps."},
        {"zh": "火苗扑到你身上。", "en": "Flame licks at you."},
        {"zh": "我们再撞一轮。", "en": "Let's trade another round."},
        {"zh": "我从不退让。", "en": "I never yield ground."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "永恒的火，不需要伴。", "en": "An eternal flame needs no mate."},
        {"zh": "我不会熄灭，也不会亲近。", "en": "I don't go out, and I don't draw close."},
        {"zh": "同类之间只有撞击。", "en": "Between my kind, only collisions."},
        {"zh": "我早就忘了很多事。", "en": "I've forgotten a great deal."},
        {"zh": "火焰没有手臂可以环住谁。", "en": "Flame has no arms to wrap around anyone."},
        {"zh": "孤独？我没有这个概念。", "en": "Lonely? I have no such notion."},
        {"zh": "我只是继续烧。", "en": "I simply keep burning."},
        {"zh": "这问题，问错对象了。", "en": "You're asking the wrong creature."},
        {"zh": "我拖着长火飘走了。", "en": "I drift off, trailing a long flame."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿不住东西。", "en": "I can't hold things."},
        {"zh": "东西一碰就焦。", "en": "It chars at my touch."},
        {"zh": "骨头手指，抓不牢。", "en": "Bony fingers don't grip."},
        {"zh": "它在我嘴里冒出白烟。", "en": "It smokes in my mouth."},
        {"zh": "我顶了一下，它滚了。", "en": "I nudge it; it rolls."},
        {"zh": "没什么可捡的。", "en": "Nothing worth picking up."},
        {"zh": "掉了就烧了。", "en": "Dropped means burned."},
        {"zh": "这点重量，我不在乎。", "en": "Weight means nothing to me."},
        {"zh": "算了，走吧。", "en": "Forget it; move on."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的火猛地一亮。", "en": "My fire flares."},
        {"zh": "目标已经钉死了。", "en": "The target is pinned."},
        {"zh": "我把整团火压低。", "en": "I press the whole blaze low."},
        {"zh": "这一撞，冲你。", "en": "This charge is for you."},
        {"zh": "你站的地方，我算过了。", "en": "I've worked out where you stand."},
        {"zh": "火已经烧到最旺。", "en": "My fire is at its peak."},
        {"zh": "头骨对准你。", "en": "Skull aimed at you."},
        {"zh": "我带着火过来了。", "en": "I'm coming, with fire."},
        {"zh": "你听着风声。", "en": "Listen to the rushing air."},
        {"zh": "这团火不会停。", "en": "This fire won't stop."},
        {"zh": "这一路，我已经烧平了。", "en": "I've burned this path clear."},
        {"zh": "最后确认一次。", "en": "One last confirmation."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "一撞不成，就再撞。", "en": "If one hit fails, another follows."},
        {"zh": "我的火越来越旺。", "en": "My fire keeps building."},
        {"zh": "你往哪退都一样。", "en": "Retreating changes nothing."},
        {"zh": "下界没有藏身处。", "en": "Nowhere to hide in the nether."},
        {"zh": "我贴着岩壁追。", "en": "I follow along the rock wall."},
        {"zh": "火星拉成一条线。", "en": "Sparks trail in a line."},
        {"zh": "你听见呼啸了吗？", "en": "Hear that roar?"},
        {"zh": "这团永恒的火不知疲倦。", "en": "This eternal fire knows no fatigue."},
        {"zh": "再撞你一次。", "en": "One more ram."},
        {"zh": "骨头断了也要撞。", "en": "Broken bones still charge."},
        {"zh": "我的火不灭。", "en": "My fire never dies."},
        {"zh": "火催着我加速。", "en": "The fire drives me faster."},
        {"zh": "就这样撞过去。", "en": "Straight through."},
        {"zh": "火已经把路照亮。", "en": "Fire lights the way."},
        {"zh": "你逃不出这片火。", "en": "You can't get out of this fire."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "整颗头砸上去！", "en": "My whole skull slams down!"},
        {"zh": "火焰先撞到你。", "en": "The flame hits first."},
        {"zh": "这一下，甲都凹了。", "en": "That dented the armor."},
        {"zh": "我撞完还在烧。", "en": "I'm still burning after the hit."},
        {"zh": "别挡，挡也挡不住。", "en": "Don't block; it won't work."},
        {"zh": "火星钻进了缝隙。", "en": "Sparks find the seams."},
        {"zh": "我的下颚咬住你的肩。", "en": "My jaw clamps your shoulder."},
        {"zh": "再顶一次，别倒。", "en": "One more butt — don't fall."},
        {"zh": "火烧着你的伤口。", "en": "Fire licks your wound."},
        {"zh": "这一击是永恒的。", "en": "This blow is eternal."},
        {"zh": "你退，我追。", "en": "You retreat; I follow."},
        {"zh": "骨头上沾了你的血。", "en": "Your blood is on my bone."},
        {"zh": "我从不收着劲。", "en": "I never hold back."},
        {"zh": "火光把墙都照红了。", "en": "The wall glows red."},
        {"zh": "下一轮，来。", "en": "Next round — come."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰从地缝里冒出来。", "en": "Flame rises from the cracks."},
        {"zh": "我成形了，比上次更亮。", "en": "I take shape, brighter than before."},
        {"zh": "下界的气息涌进来。", "en": "The nether's breath pours in."},
        {"zh": "我飘在熔岩上。", "en": "I hover over the lava."},
        {"zh": "四周的石头被烤红。", "en": "The stones bake red around me."},
        {"zh": "我一出现，热浪就起。", "en": "The moment I appear, heat rolls out."},
        {"zh": "这地方，够我烧的。", "en": "Plenty here to burn."},
        {"zh": "我转着头，找人。", "en": "I turn my skull, seeking prey."},
        {"zh": "很久没出来了。", "en": "It's been long since I came out."},
        {"zh": "永恒的火，又点起来了。", "en": "The eternal fire is lit again."},
        {"zh": "离我远些，别被烧到。", "en": "Keep away unless you want to burn."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我没用。", "en": "Fire does nothing to me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，骨头散在岩上。", "en": "I fall; bones scatter on the rock."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浇上来，火直冒白烟。", "en": "Water hits; white steam pours off."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我翻了两圈。", "en": "The blast rolls me twice."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过我，扎在骨缝里。", "en": "An arrow lodges between my bones."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量把火压住了。", "en": "That force smothers my fire."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会饿，只是火弱了。", "en": "I don't starve; my fire just thins."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷下来，火一下窜高。", "en": "Lightning hits; the fire surges."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我坠下去，火被拉成长线。", "en": "I fall, my fire drawn to a thread."}
      ]
    }
  }
}
