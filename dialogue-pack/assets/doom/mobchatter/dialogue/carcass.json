{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "皮下面露着骨。", "en": "Bone shows through my hide."},
        {"zh": "我拖着步子走过来。", "en": "I drag my feet this way."},
        {"zh": "身上的肉一块块晃。", "en": "The flesh on me shifts in lumps."},
        {"zh": "下界的灰沾在我脚上。", "en": "Nether ash clings to my feet."},
        {"zh": "我不急，反正你不跑。", "en": "I am in no hurry. You will not get away."},
        {"zh": "我每一步都像在撕开自己。", "en": "Every step looks like it tears me open."},
        {"zh": "血从缝里渗出来。", "en": "Blood seeps from the seams."},
        {"zh": "我拖着腿贴近。", "en": "I drag my legs closer."},
        {"zh": "脚下的岩浆石发红。", "en": "The magma stone glows under my feet."},
        {"zh": "我伸出一只枯手。", "en": "I stretch out one withered hand."},
        {"zh": "骨头在皮里响。", "en": "Bones creak inside the skin."},
        {"zh": "下界到处都是我的同类。", "en": "My kind are all over the Nether."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "肉在慢慢蠕。", "en": "The flesh crawls slowly."},
        {"zh": "我不需要呼吸，但还是在喘。", "en": "I need no air, yet I still pant."},
        {"zh": "灰落在我的伤口里。", "en": "Ash settles into my wounds."},
        {"zh": "我瞪着通道尽头。", "en": "I glare down the corridor."},
        {"zh": "我的身体自己会好。", "en": "My body mends itself."},
        {"zh": "周围的热气我早习惯了。", "en": "The heat here is nothing new."},
        {"zh": "我转了转僵硬的脖子。", "en": "I twist my stiff neck."},
        {"zh": "我听见远处的惨叫。", "en": "I hear screaming far off."},
        {"zh": "地上有个影子在动。", "en": "A shadow moves on the ground."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是活的东西。", "en": "You are a living thing."},
        {"zh": "你站得很直。", "en": "You stand very upright."},
        {"zh": "我会慢慢来。", "en": "I will take my time."},
        {"zh": "你这身皮，能撕开多久。", "en": "How long will your hide hold?"},
        {"zh": "我低头看你，这具腐尸挂在身上。", "en": "I lower my gaze at you; this carcass hangs on me."},
        {"zh": "你不该来下界。", "en": "You should not have come to the Nether."},
        {"zh": "我伸出枯指指你。", "en": "I extend a withered finger at you."},
        {"zh": "不要跑太远。", "en": "Do not run too far."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我吼了一声，声很闷。", "en": "I roar, and the sound is muffled."},
        {"zh": "肉又掉了一块。", "en": "Another piece of flesh fell off."},
        {"zh": "我拖着脚退开。", "en": "I drag my feet back."},
        {"zh": "这具身体早该烂了。", "en": "This body should have rotted long ago."},
        {"zh": "我抬眼瞪你。", "en": "I glare up at you."},
        {"zh": "血又流了出来。", "en": "Blood starts flowing again."},
        {"zh": "我一点也不在乎。", "en": "I do not care at all."},
        {"zh": "我把它按回去。", "en": "I push it back in."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "血肉？快给我。", "en": "Flesh? Give it here."},
        {"zh": "这股血味我熟。", "en": "I know this smell of blood."},
        {"zh": "扔过来，我接着。", "en": "Toss it; I will catch it."},
        {"zh": "生的，带血的。", "en": "Raw, and still bloody."},
        {"zh": "我的肚子是个洞。", "en": "My belly is a hole."},
        {"zh": "塞不满我的牙。", "en": "It will not fill my teeth."},
        {"zh": "你手抖什么。", "en": "Why is your hand shaking?"},
        {"zh": "我会连手一起吃。", "en": "I would eat the hand too."},
        {"zh": "再给我一块。", "en": "Another piece."},
        {"zh": "很好，这很好。", "en": "Good. Very good."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的骨头顶出去。", "en": "My bones shove out."},
        {"zh": "你撞在我露骨的地方。", "en": "You hit the exposed bone."},
        {"zh": "我歪了一下，又直了。", "en": "I tilt, then straighten."},
        {"zh": "这一撞，我没什么感觉。", "en": "I barely felt that."},
        {"zh": "我们贴得很近。", "en": "We ended up very close."},
        {"zh": "血溅到你身上。", "en": "Blood splashes onto you."},
        {"zh": "我抬手把你推开。", "en": "I shove you off with a hand."},
        {"zh": "我站稳，继续走。", "en": "I steady and keep walking."},
        {"zh": "你力气不大。", "en": "You are not very strong."},
        {"zh": "把身子挪开。", "en": "Shift your body."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "下界里，我们不结伴。", "en": "In the Nether, we do not keep company."},
        {"zh": "同类的味道，我认得。", "en": "I know the smell of my own kind."},
        {"zh": "隔开些就行。", "en": "Keep your distance."},
        {"zh": "我们只往前。", "en": "We only go forward."},
        {"zh": "我的肉会一直长。", "en": "My flesh keeps growing."},
        {"zh": "痛苦是常态。", "en": "Pain is ordinary."},
        {"zh": "谁也不会停下来。", "en": "Neither of us stops."},
        {"zh": "一起穿过这段岩浆带。", "en": "Let us cross this lava stretch together."},
        {"zh": "不必道别了。", "en": "No farewells needed."},
        {"zh": "往前挪动吧。", "en": "Creep forward."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一把抓起来。", "en": "I snatch it up."},
        {"zh": "塞进嘴里，连骨头。", "en": "Into my mouth, bones and all."},
        {"zh": "这块不够塞。", "en": "This piece is not enough."},
        {"zh": "我嚼了两下。", "en": "Two chews."},
        {"zh": "不好吃，但能吃。", "en": "Not good, but edible."},
        {"zh": "我捏碎了它。", "en": "I crushed it."},
        {"zh": "血沾了我的手。", "en": "Blood is on my hand."},
        {"zh": "我甩手丢开。", "en": "I fling it away."},
        {"zh": "留下也没用。", "en": "No use keeping it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你挪动了。", "en": "You shifted."},
        {"zh": "目标在你身上。", "en": "The target is on you."},
        {"zh": "我冲你过来。", "en": "I am coming at you."},
        {"zh": "血味越来越近。", "en": "The bloody smell is getting closer."},
        {"zh": "我张开手臂。", "en": "I spread my arms."},
        {"zh": "该吃点什么了。", "en": "Time to eat something."},
        {"zh": "我的肉块先滚到你脚边。", "en": "A piece of me rolls to your feet first."},
        {"zh": "我已经锁住你。", "en": "You are marked."},
        {"zh": "过来吧。", "en": "Come here."},
        {"zh": "我在流血，但我不在乎。", "en": "I am bleeding, and I do not care."},
        {"zh": "我到了跟前。", "en": "I am upon you."},
        {"zh": "你听见呼吸声了吗。", "en": "Do you hear the breathing."},
        {"zh": "这一份归我。", "en": "This share is mine."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你留下的血。", "en": "I follow the blood you leave."},
        {"zh": "你每一步我都听得见。", "en": "I hear every step you take."},
        {"zh": "路只剩几步。", "en": "Only a few steps left."},
        {"zh": "下界的尸体，走一步掉一块。", "en": "A Nether corpse drops a piece with each step."},
        {"zh": "我绕过岩浆池。", "en": "I go around the lava pool."},
        {"zh": "我的皮下面全是骨。", "en": "Beneath my hide, all bone."},
        {"zh": "你的体温，我感觉得到。", "en": "I can feel your body heat."},
        {"zh": "再挪近两步。", "en": "Two steps nearer."},
        {"zh": "你转身，我就跟上。", "en": "You turn, and I follow."},
        {"zh": "这条走廊没有出口。", "en": "This corridor has no exit."},
        {"zh": "我闻着你的汗。", "en": "I smell your sweat."},
        {"zh": "我已经到了。", "en": "I have arrived."},
        {"zh": "快碰到你的衣角。", "en": "Nearly brushing your hem."},
        {"zh": "下界的灰会盖住你。", "en": "Nether ash will cover you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一爪撕下去。", "en": "I tear down with one claw."},
        {"zh": "你被扯开一道口子。", "en": "You get torn open in one gash."},
        {"zh": "我的手臂挥过去。", "en": "My arm swings across."},
        {"zh": "这一下带着骨。", "en": "Bone comes with that swing."},
        {"zh": "我啃下一块肉。", "en": "I gnaw off a chunk."},
        {"zh": "血溅在我的胸口。", "en": "Blood splatters my chest."},
        {"zh": "我没什么技巧。", "en": "There is no skill in me."},
        {"zh": "你架住这一爪。", "en": "You caught this claw."},
        {"zh": "第二下接着来。", "en": "The second follows."},
        {"zh": "这一步我压上去。", "en": "I press in with this step."},
        {"zh": "我把它撕开。", "en": "I tear it apart."},
        {"zh": "你还活着，有点意外。", "en": "You are still alive. That is a surprise."},
        {"zh": "我要慢慢来。", "en": "I want to take my time."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "空气一下子变热了。", "en": "The air turned hot all at once."},
        {"zh": "我拖着骨头上来了。", "en": "I dragged myself up by the bones."},
        {"zh": "地上多了滩血。", "en": "A pool of blood appears on the ground."},
        {"zh": "我的皮还在长。", "en": "My hide is still growing."},
        {"zh": "灰从上面落下来。", "en": "Ash falls from above."},
        {"zh": "我抬起头，看你。", "en": "I lift my head and look at you."},
        {"zh": "一个不该在这的东西来了。", "en": "Something that should not be here has come."},
        {"zh": "脚下的石头在响。", "en": "The stone rings under my feet."},
        {"zh": "我来了，很饿。", "en": "I am here, and hungry."},
        {"zh": "下界的门开过一次。", "en": "A Nether door opened once."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "下界的火，我本该受得住。", "en": "Nether fire should not bother me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "骨摔得咔咔响。", "en": "My bones clatter on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "这里的水是酸的。", "en": "The water here is sour."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我炸得散了形。", "en": "The blast blows me out of shape."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉进我的肉。", "en": "Something is stuck in my flesh."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得连肉都少了。", "en": "Hunger is eating my own flesh."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在下界，罕见。", "en": "Lightning in the Nether is rare."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有灰，没有火。", "en": "No ash here, and no fire."}
      ]
    }
  }
}
