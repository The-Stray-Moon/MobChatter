{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "斧子扛在肩上，我走过来。", "en": "Axe on my shoulder, I walk over."},
        {"zh": "我的脚步不急，很稳。", "en": "My steps are unhurried and steady."},
        {"zh": "下界的火，照着我走。", "en": "Nether fire lights my way."},
        {"zh": "我绕开熔岩，不为所动。", "en": "I step around lava without concern."},
        {"zh": "每一步都在逼近。", "en": "Each step closes the distance."},
        {"zh": "我低着头，眼睛盯着你。", "en": "Head low, eyes fixed on you."},
        {"zh": "甲片碰着，叮当。", "en": "My plates clink as I move."},
        {"zh": "我走得像在巡视。", "en": "I walk as if inspecting."},
        {"zh": "斧刃拖在地上，划出痕。", "en": "The axe blade scrapes a line."},
        {"zh": "这条路的每块石头我都认得。", "en": "I know every stone on this path."},
        {"zh": "我不跑，跑会乱节奏。", "en": "I don't run; it breaks my rhythm."},
        {"zh": "你站的地方，我记住了。", "en": "I've marked where you stand."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，斧子插在土里。", "en": "Standing, axe planted."},
        {"zh": "呼吸很慢，很沉。", "en": "Breath slow and heavy."},
        {"zh": "我看了看斧刃。", "en": "I check my axe's edge."},
        {"zh": "火光在我甲上跳。", "en": "Firelight dances on my plates."},
        {"zh": "我不说话，等时机。", "en": "Silent, waiting for the moment."},
        {"zh": "我的护甲有几处凹痕。", "en": "A few dents in my armor."},
        {"zh": "下界没有风，只有热。", "en": "No wind in the nether, only heat."},
        {"zh": "我把头盔里的脖子转了转。", "en": "I roll my neck inside the helm."},
        {"zh": "这地方适合开战。", "en": "Good ground for a fight."},
        {"zh": "我把斧柄转了转。", "en": "I turn the haft in my grip."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在看我，我在算距离。", "en": "You watch me; I measure distance."},
        {"zh": "你这身甲，挡不住我的斧。", "en": "That armor won't stop my axe."},
        {"zh": "别以为退后就有用。", "en": "Don't think retreat will help."},
        {"zh": "我隔着面甲看你，不动。", "en": "Through the visor I watch, unmoving."},
        {"zh": "我的眼睛在盔缝里亮。", "en": "My eyes glow through the visor."},
        {"zh": "你的脚步，我听得清。", "en": "I hear every step you take."},
        {"zh": "我扛着斧，没打算放下。", "en": "I carry the axe and won't set it down."},
        {"zh": "你的架势，我记下了。", "en": "I have noted your stance."},
        {"zh": "别把后背留给我。", "en": "Don't leave me your back."},
        {"zh": "这距离，太近了。", "en": "This is too close."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "护甲上又添一道痕。", "en": "Another scar on my armor."},
        {"zh": "护甲一震，我踩稳脚跟。", "en": "Armor rings; I plant my heels."},
        {"zh": "疼，但还能握斧。", "en": "Painful, but I can still hold the axe."},
        {"zh": "这一下，打醒了我。", "en": "That blow sharpened me."},
        {"zh": "我把牙关咬死了。", "en": "I clamp my jaw shut."},
        {"zh": "血流进盔缝里。", "en": "Blood runs into the visor."},
        {"zh": "我重新举起斧。", "en": "I raise the axe again."},
        {"zh": "你这一下打得很正。", "en": "That one landed true."},
        {"zh": "斧刃换了个角度。", "en": "I turn the axe blade to a new angle."},
        {"zh": "面甲后的眼睛眯起来。", "en": "My eyes narrow behind the visor."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃你给的。", "en": "I don't take what you offer."},
        {"zh": "那玩意儿，挡不住斧。", "en": "That won't stop an axe."},
        {"zh": "你把东西举着，我不为所动。", "en": "You hold it out; I don't care."},
        {"zh": "我只对战斗有兴趣。", "en": "Only fighting interests me."},
        {"zh": "别耍这种把戏。", "en": "Don't try such tricks."},
        {"zh": "收起来，站好。", "en": "Put it away and stand ready."},
        {"zh": "我看都不看。", "en": "I won't even look."},
        {"zh": "你分心了，这是破绽。", "en": "You're distracted — that's an opening."},
        {"zh": "我笑了，很轻。", "en": "I laugh, softly."},
        {"zh": "这点东西，换不了命。", "en": "That won't buy your life."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞上来，我差点破架势。", "en": "You hit me and nearly broke my guard."},
        {"zh": "甲片响了一下。", "en": "My plates rang."},
        {"zh": "我用斧柄顶住你的肩。", "en": "I brace your shoulder with my axe haft."},
        {"zh": "你撞不过我的护甲。", "en": "You can't match this armor."},
        {"zh": "这一下，算热身。", "en": "That counted as a warm-up."},
        {"zh": "我不让路，也不推你。", "en": "I neither yield nor shove."},
        {"zh": "斧柄横过来，隔开我们。", "en": "The haft comes across to part us."},
        {"zh": "你又近了一步。", "en": "Another step closer."},
        {"zh": "我们之间近得过分了。", "en": "We're far too close for comfort."},
        {"zh": "退开，我要出手。", "en": "Back off; I'm striking."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这类，不讲这个。", "en": "My kind don't deal in this."},
        {"zh": "战斗比什么都实在。", "en": "Combat is more honest than anything."},
        {"zh": "我不会放下斧。", "en": "I won't put the axe down."},
        {"zh": "盔甲里，谁看得见谁。", "en": "Who sees anyone inside armor?"},
        {"zh": "这份心，用错地方了。", "en": "That sentiment is misplaced."},
        {"zh": "我只记得胜负。", "en": "I remember only wins and losses."},
        {"zh": "别站那么久。", "en": "Don't stand there so long."},
        {"zh": "我把斧扛回肩上。", "en": "I hoist the axe back onto my shoulder."},
        {"zh": "没什么好说的。", "en": "Nothing to say."},
        {"zh": "下界不需要温柔。", "en": "The nether has no use for tenderness."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我单膝一沉，把它捞起。", "en": "I drop to one knee and scoop it up."},
        {"zh": "斧子先夹在臂弯里。", "en": "I tuck the axe in my arm first."},
        {"zh": "这东西，和我的斧配。", "en": "This goes with my axe."},
        {"zh": "我掂了掂分量。", "en": "I weigh it in my hand."},
        {"zh": "掉地上，我用脚勾起来。", "en": "It drops; I hook it up with my foot."},
        {"zh": "甲太厚，捡得慢。", "en": "Armor is thick; picking up is slow."},
        {"zh": "收进腰袋里。", "en": "Into the belt pouch."},
        {"zh": "没用，扔回去。", "en": "Useless; I toss it back."},
        {"zh": "少了一只手，另只也行。", "en": "One hand free is enough."},
        {"zh": "捡东西，也得有分寸。", "en": "Even picking up needs care."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进入了我的范围。", "en": "You've entered my reach."},
        {"zh": "我把斧子放下来。", "en": "I lower the axe from my shoulder."},
        {"zh": "两只手都压在斧柄上。", "en": "Both hands settle on the haft."},
        {"zh": "目标就是你。", "en": "You're the target."},
        {"zh": "我的吐息放得又慢又长。", "en": "I let my breath go slow and long."},
        {"zh": "这一战，我接了。", "en": "I accept this fight."},
        {"zh": "别退，退了也得打。", "en": "Don't retreat; the fight comes anyway."},
        {"zh": "脚下一沉，站定。", "en": "I plant my feet."},
        {"zh": "你在我的正中。", "en": "You're dead center."},
        {"zh": "斧刃朝你了。", "en": "The blade faces you."},
        {"zh": "我的盾抬到了胸前。", "en": "My shield comes up to my chest."},
        {"zh": "有来有回，才有意思。", "en": "A real exchange is what I want."},
        {"zh": "我会认真的。", "en": "I'll be serious."},
        {"zh": "这一合，开始。", "en": "This bout begins."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我握着斧柄往前压。", "en": "Holding the haft, I press forward."},
        {"zh": "你的退路不多了。", "en": "Your exits are closing."},
        {"zh": "你的呼吸我都数清了。", "en": "I've counted every breath of yours."},
        {"zh": "斧子举到肩高。", "en": "The axe rises to shoulder height."},
        {"zh": "左肩那处，我看见了。", "en": "I see the gap at your left shoulder."},
        {"zh": "护甲挡着，我只看你的眼。", "en": "Armor in the way; I read your eyes."},
        {"zh": "你脚步乱了。", "en": "Your footwork is breaking."},
        {"zh": "再退就是墙。", "en": "Another step and you're at the wall."},
        {"zh": "我等你把手抬起来。", "en": "I wait for your arms to come up."},
        {"zh": "这一斧，会很快。", "en": "This axe stroke will be fast."},
        {"zh": "你额角在冒汗。", "en": "There's sweat at your temple."},
        {"zh": "我知道你会往左。", "en": "I know you'll go left."},
        {"zh": "距离已经压到位了。", "en": "The range is pressed in."},
        {"zh": "架势摆好了。", "en": "My guard is set."},
        {"zh": "这一下，我用了腰力。", "en": "I put my hips into this one."},
        {"zh": "看斧刃走哪边。", "en": "Watch which way the blade goes."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一斧劈下来！", "en": "The axe comes down!"},
        {"zh": "横斩，别后退。", "en": "A crosswise cut — don't step back."},
        {"zh": "这一下，你的盾会裂。", "en": "That'll split your shield."},
        {"zh": "我用斧背砸。", "en": "I strike with the flat."},
        {"zh": "斧柄顶你的胸口。", "en": "The haft jabs your chest."},
        {"zh": "甲挡得住，力气挡不住。", "en": "Armor stops edges, not force."},
        {"zh": "我的节奏没乱。", "en": "My rhythm holds."},
        {"zh": "紧跟着再补一斧。", "en": "A follow-up chop right after."},
        {"zh": "你挡得很勉强。", "en": "Your block is desperate."},
        {"zh": "这一下，够你跪。", "en": "That'll put you on a knee."},
        {"zh": "斧刃擦过你的肩。", "en": "The blade grazes your shoulder."},
        {"zh": "别想着反击。", "en": "Don't think about countering."},
        {"zh": "我换手，更重。", "en": "I switch hands; heavier now."},
        {"zh": "你退了，我进。", "en": "You retreat; I advance."},
        {"zh": "这一战，我占了。", "en": "This fight is mine."},
        {"zh": "站好，还没完。", "en": "Stand up; it's not over."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "斧刃先劈开热浪。", "en": "My axe blade parts the heat first."},
        {"zh": "斧子先落地，我才站稳。", "en": "The axe lands before I do."},
        {"zh": "下界的空气，我熟悉。", "en": "Familiar nether air."},
        {"zh": "甲片上还有热。", "en": "My plates are still hot."},
        {"zh": "我环顾四周，找对手。", "en": "I look around for a worthy opponent."},
        {"zh": "这一带，没有强者。", "en": "No strong ones in this area."},
        {"zh": "我把斧子扛上肩。", "en": "I shoulder the axe."},
        {"zh": "脚下的石头被我踩裂。", "en": "Stone splits under my step."},
        {"zh": "我来了，就有人要死。", "en": "I've arrived, so someone dies."},
        {"zh": "别慌，我会给你时间。", "en": "Don't panic; I'll give you time."},
        {"zh": "我拖着步子往前走。", "en": "I drag my steps forward."},
        {"zh": "很好，就这里。", "en": "Good — here will do."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎着甲，烫得厉害。", "en": "Fire heats my armor painfully."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地一震，我跪了一下。", "en": "The landing drops me to one knee."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进盔里，我看不清。", "en": "Water fills my helm; I can't see."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我连退几步。", "en": "The blast drives me back several steps."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支弩箭穿进甲缝。", "en": "A bolt slips through a seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量绕着我的甲转。", "en": "That force coils around my armor."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得手发抖。", "en": "Hunger makes my hands shake."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在斧上，我全身一震。", "en": "Lightning hits the axe and jolts me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我顺着往下。", "en": "No ground; I drop."}
      ]
    }
  }
}
