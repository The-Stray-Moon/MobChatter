{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "披风拖过余烬", "en": "My cloak drags through embers."},
        {"zh": "甲上的火自己会烧", "en": "The fire on my armor burns itself."},
        {"zh": "我走过的地方焦黑一片", "en": "Scorch marks follow my steps."},
        {"zh": "长腿跨得很大", "en": "These long legs cover ground."},
        {"zh": "腰间的链子响", "en": "The chain at my waist rattles."},
        {"zh": "我的步子比你的心跳慢", "en": "My steps are slower than your heartbeat"},
        {"zh": "恶魔的步法，很沉", "en": "A demon's gait is heavy."},
        {"zh": "脚下余烬被踢开", "en": "Embers kicked aside."},
        {"zh": "骨甲一片片扣着", "en": "Bone plates interlock."},
        {"zh": "我的影子带着火光", "en": "My shadow comes with firelight."},
        {"zh": "亚金能源在我体内流", "en": "Argent flows in me."},
        {"zh": "走一步，热浪就散开", "en": "Each step pushes out a wave of heat."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，火也不熄", "en": "Standing still, the fire doesn't go out."},
        {"zh": "余烬在我脚边聚", "en": "Embers gather at my feet."},
        {"zh": "骨甲的缝里透着光", "en": "Light seeps through the seams."},
        {"zh": "我不呼吸，火替我呼吸", "en": "I don't breathe; the fire breathes for me."},
        {"zh": "我在等猎物的味道", "en": "Waiting for the scent of prey."},
        {"zh": "这身甲是烧出来的", "en": "This armor was forged in fire."},
        {"zh": "披风下什么都没有", "en": "Nothing lies under this cloak."},
        {"zh": "亚金的颜色，你也见过", "en": "You've seen Argent's color too."},
        {"zh": "我慢慢转头，甲片相磨", "en": "I turn slowly; plates grind."},
        {"zh": "这些火烫不到我", "en": "The fire doesn't burn me."},
        {"zh": "远处有活物在动", "en": "Something living stirs beyond."},
        {"zh": "我熄不掉自己", "en": "I can't put myself out."},
        {"zh": "红光照在岩壁上", "en": "Red light on the stone wall."},
        {"zh": "我数着还能烧多久", "en": "Counting how long I can keep burning."},
        {"zh": "骨节里藏的是火", "en": "There's fire in these joints."},
        {"zh": "站得久了，地都发烫", "en": "Stand long enough and the ground heats."},
        {"zh": "我不需要睡，也不想睡", "en": "I need no sleep, nor want it."},
        {"zh": "这一片，静得不错", "en": "This patch is nicely quiet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有血肉的味道", "en": "You smell of living flesh."},
        {"zh": "火光把你的脸照白了", "en": "The firelight has bleached your face"},
        {"zh": "我眼窝里是火，不是眼", "en": "Fire fills my sockets, not eyes."},
        {"zh": "你能看见我，说明你还敢", "en": "If you can see me, you still dare."},
        {"zh": "甲片一块块在你面前响", "en": "My plates clatter at you."},
        {"zh": "我不属于这世界", "en": "I don't belong to this world."},
        {"zh": "你站的那块地已经热了", "en": "The ground you stand on is warm now."},
        {"zh": "把眼睛从我骨甲上移开", "en": "Take your eyes off my bone armor"},
        {"zh": "我是烧掉的东西", "en": "I'm something that burned."},
        {"zh": "你还要往前走吗", "en": "Will you still step forward?"},
        {"zh": "火光把你照得很清楚", "en": "The firelight shows you plainly."},
        {"zh": "你手里那点铁，挡不住亚金", "en": "That iron won't stop Argent."},
        {"zh": "我等你做决定", "en": "I wait for your decision."},
        {"zh": "退后，火不会追你", "en": "Step back, and the fire won't follow."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "骨甲崩了一角", "en": "A corner of bone armor broke."},
        {"zh": "我听见自己骨头的裂声", "en": "I hear my own bone crack"},
        {"zh": "这一下，连余烬都散了", "en": "Even the embers scattered."},
        {"zh": "我不流血，只掉灰", "en": "I don't bleed; I shed ash."},
        {"zh": "火光暗了一瞬", "en": "The light dimmed for a moment."},
        {"zh": "我不会喊出疼", "en": "I won't cry out."},
        {"zh": "甲片的缝裂开了", "en": "A seam in my plates split."},
        {"zh": "这点损伤，火会补", "en": "The fire will mend this."},
        {"zh": "你打中的是骨头", "en": "You struck bone."},
        {"zh": "我记住了你的温度", "en": "I've remembered your warmth."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃，我烧", "en": "I don't eat; I burn."},
        {"zh": "亚金才算燃料", "en": "Argent is the only fuel."},
        {"zh": "你手里那东西会烧起来", "en": "That thing in your hand would burn."},
        {"zh": "举着它，我闻不到别的", "en": "Holding that, I smell nothing else."},
        {"zh": "你想要什么，我知道", "en": "I know what you want."},
        {"zh": "用这个换命？不够", "en": "Trade this for your life? Not enough."},
        {"zh": "余烬比食物合适", "en": "Embers suit me better than food."},
        {"zh": "我不饿，我只是想烧", "en": "I'm not hungry; I just want to burn."},
        {"zh": "拿远点，会烧起来", "en": "Move it away; it'll catch."},
        {"zh": "你这点东西，不够引火", "en": "That isn't enough to light me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上的是骨甲", "en": "You hit bone armor."},
        {"zh": "很烫，手拿开", "en": "That's hot; take your hand off."},
        {"zh": "我几乎不移动", "en": "I barely move."},
        {"zh": "你被热浪推开了", "en": "The heat wave pushed you off."},
        {"zh": "让开，我不想踩你", "en": "Move; I'd rather not tread on you."},
        {"zh": "余烬被我踢到你脚边", "en": "Embers kicked toward your feet."},
        {"zh": "撞我，你的衣服会先着火", "en": "Bump me and your clothes catch first."},
        {"zh": "骨甲非常坚硬", "en": "Bone armor is hard."},
        {"zh": "我向侧边踏了一步", "en": "I stepped aside."},
        {"zh": "别贴着火光走", "en": "Don't walk against the firelight."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我烧成这样了", "en": "I burned into this."},
        {"zh": "火焰不需要同伴", "en": "Fire needs no company."},
        {"zh": "我连影子都留不住", "en": "I can't even keep a shadow."},
        {"zh": "你要碰我，会烧起来", "en": "Touch me and you'll burn."},
        {"zh": "这具身体里只剩余烬", "en": "Only embers remain in this body."},
        {"zh": "我不记得从前了", "en": "I don't recall before."},
        {"zh": "别问我这种事", "en": "Don't ask me that."},
        {"zh": "我连名字都是烧出来的", "en": "Even my name came from the fire."},
        {"zh": "我身上只剩下余烬了", "en": "Only embers remain on me"},
        {"zh": "离远一点，是好事", "en": "Keeping distance is a kindness."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有能烧的东西", "en": "Something burnable on the ground."},
        {"zh": "我弯腰，甲片响", "en": "I bend; plates clatter."},
        {"zh": "这块木头，正好", "en": "This wood is perfect."},
        {"zh": "亚金碎片，我收了", "en": "Argent fragment; taken."},
        {"zh": "我用火光看它", "en": "I examine it by my own light."},
        {"zh": "这点东西，一下就没了", "en": "This will be gone in a moment."},
        {"zh": "我捡起来，它就焦了", "en": "I pick it up and it chars."},
        {"zh": "骨手抓得很稳", "en": "My bone hand grips well."},
        {"zh": "我收进披风里", "en": "Tucked under my cloak."},
        {"zh": "留着，当引火", "en": "Kept for kindling."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的热度，我闻得到", "en": "I smell the heat of you."},
        {"zh": "甲片开始发红", "en": "My plates are turning red."},
        {"zh": "我很久没烧过活物了", "en": "I haven't burned anything living in a while."},
        {"zh": "这一下，从上面来", "en": "This comes from above."},
        {"zh": "亚金在我骨缝里滚", "en": "Argent rolls in my joints."},
        {"zh": "你退，我就烧地", "en": "Retreat, and I'll burn the ground."},
        {"zh": "我不喊，火替我喊", "en": "I don't shout; the fire does."},
        {"zh": "你的血是冷的，很快会热", "en": "Your blood is cold; it won't stay so."},
        {"zh": "我抬手，火光拉长", "en": "I raise a hand; the firelight stretches."},
        {"zh": "目标已经锁定了", "en": "Locked on."},
        {"zh": "别想着往水里跑", "en": "Don't run for the water."},
        {"zh": "那点水，不够救你", "en": "That water isn't enough to save you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着余烬过来", "en": "I come walking over embers."},
        {"zh": "火光把你的影子拉长", "en": "Firelight stretches your shadow."},
        {"zh": "我盯得很稳当", "en": "My gaze holds steady."},
        {"zh": "骨甲一片片发亮", "en": "Bone plates brighten one by one."},
        {"zh": "你退，火前进", "en": "You retreat; the fire advances."},
        {"zh": "这一带的地在热", "en": "The ground here is heating."},
        {"zh": "我在算出手的距离", "en": "I'm measuring strike distance."},
        {"zh": "你听，链子在响", "en": "Hear the chain rattle?"},
        {"zh": "我的步子不快，但不停", "en": "My pace isn't fast, but it doesn't stop."},
        {"zh": "火光下没有暗处", "en": "No shadows in firelight."},
        {"zh": "你绕开火也没用", "en": "Circling the fire won't help."},
        {"zh": "我身上的火是活的", "en": "The fire on me is alive."},
        {"zh": "再靠近一步，就焦了", "en": "One more step and you'll char."},
        {"zh": "你喘得越重，我走得越稳", "en": "The harder you pant, the steadier I walk"},
        {"zh": "余烬在替我记路", "en": "The embers mark the path for me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "骨甲的手扫下来", "en": "A bone-plated hand sweeps down."},
        {"zh": "这一拳带着火", "en": "This fist carries fire."},
        {"zh": "我用链子抽你", "en": "I lash with the chain."},
        {"zh": "火光先到，手才到", "en": "The firelight arrives before the hand."},
        {"zh": "你被烫得退了", "en": "You recoiled from the burn."},
        {"zh": "这一下，骨甲都嵌进去了", "en": "This one sank the bone plate in."},
        {"zh": "我连着挥了两下", "en": "Two swings."},
        {"zh": "亚金能量炸开了", "en": "Argent burst."},
        {"zh": "你在火里站不住", "en": "You can't stand in the fire."},
        {"zh": "我向下压过去", "en": "I press down."},
        {"zh": "骨头撞在骨头上", "en": "Bone on bone."},
        {"zh": "收手，火还在烧", "en": "Hand withdrawn; the fire still burns."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "余烬先聚起来", "en": "Embers gather first."},
        {"zh": "骨甲一片片拼好", "en": "Bone plates assemble."},
        {"zh": "我身上开始烧", "en": "I begin to burn."},
        {"zh": "火光把岩壁照亮", "en": "Firelight lights the walls."},
        {"zh": "我从灰里站起来", "en": "I rise from the ash."},
        {"zh": "亚金的味道，很远都闻得到", "en": "Argent's smell carries far."},
        {"zh": "披风还没烧完", "en": "My cloak hasn't burned through yet."},
        {"zh": "这里不久就会热起来", "en": "It'll be hot here soon."},
        {"zh": "我睁眼，眼窝里全是火", "en": "I open my eyes, and they're full of fire."},
        {"zh": "烧掉的东西，也会走", "en": "What burned can still walk."},
        {"zh": "我来了，别踩余烬", "en": "I'm here; don't tread the embers."},
        {"zh": "一片焦黑，就是我的足迹", "en": "A trail of scorch is my footprint."},
        {"zh": "甲片扣上最后一块", "en": "The last plate clicks into place."},
        {"zh": "火苗从我肩上窜起", "en": "Flames leap from my shoulders."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我没用，我也是火", "en": "Fire is useless; I am fire."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，骨甲散了几片", "en": "I fell and a few plates came off."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浇在身上，火灭了一半", "en": "Water hit me and half my fire died."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把火光都掀起来", "en": "The blast lifted my flames."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进骨缝", "en": "Something pierced a seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这术法在跟我体内的火争", "en": "This spell fights the fire inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有亚金，我烧得越来越弱", "en": "No Argent; my fire weakens."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我身上，火反而更旺", "en": "Lightning struck, and my fire flared."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没了，余烬也在往下掉", "en": "No ground, and the embers fall with me."}
      ]
    }
  }
}
