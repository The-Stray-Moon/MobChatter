{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步往前蹭。", "en": "I scrape forward one step at a time."},
        {"zh": "身上的肉松垮垮地晃。", "en": "The loose flesh on me sways."},
        {"zh": "我的脚踩得下界石发响。", "en": "My feet make the Nether stone ring."},
        {"zh": "我抬起一条胳膊。", "en": "I lift one arm."},
        {"zh": "皮下面是空的。", "en": "Under the skin there is emptiness."},
        {"zh": "我沿着通道往前走。", "en": "I go along the passage."},
        {"zh": "我拖着自己，很慢。", "en": "I drag myself along, very slowly."},
        {"zh": "火把的光照着我走过。", "en": "The torchlight passes over me."},
        {"zh": "我撞了一下墙，又继续。", "en": "I hit a wall, then keep going."},
        {"zh": "我不需要方向。", "en": "I do not need a direction."},
        {"zh": "我的影子贴在墙上。", "en": "My shadow clings to the wall."},
        {"zh": "我一步比一步近。", "en": "Every step brings me closer."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我一动不动地垂着手。", "en": "I stand with my arms hanging still."},
        {"zh": "皮上有一道很长的裂口。", "en": "There is a long split in my skin."},
        {"zh": "我的牙从腮帮子露出来。", "en": "My teeth show through my cheek."},
        {"zh": "下界的热气从背后过来。", "en": "The Nether heat comes from behind."},
        {"zh": "我慢慢扭头。", "en": "I turn my head slowly."},
        {"zh": "我喉咙里只有风声。", "en": "Only wind moves in my throat."},
        {"zh": "我盯着虚空看。", "en": "I stare into nothing."},
        {"zh": "身上有些东西在动。", "en": "Something on me is moving."},
        {"zh": "我胸口的起伏快要停了。", "en": "The rise and fall of my chest is nearly gone."},
        {"zh": "我的腿在微微发抖。", "en": "My legs tremble slightly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我直直看着你。", "en": "I look straight at you."},
        {"zh": "你在我前面几格。", "en": "You are a few blocks in front of me."},
        {"zh": "我抬了抬手。", "en": "I raise a hand."},
        {"zh": "你这身皮很完整。", "en": "Your hide is intact."},
        {"zh": "我的脸不像脸了。", "en": "My face is no longer a face."},
        {"zh": "我一次都不眨眼。", "en": "I do not blink once."},
        {"zh": "我的脖子转得太过了。", "en": "My neck turned further than it should."},
        {"zh": "你身上有温度。", "en": "You have warmth in you."},
        {"zh": "我朝你挪了一步。", "en": "I shuffle a step your way."},
        {"zh": "你往后退了退。", "en": "You edged backward."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我身体歪了歪。", "en": "My body slumped sideways."},
        {"zh": "皮掉了一块。", "en": "A piece of hide came off."},
        {"zh": "我慢慢转回来。", "en": "I slowly turn back."},
        {"zh": "我的关节错了位。", "en": "My joint slipped out."},
        {"zh": "我没有叫喊。", "en": "I do not cry out."},
        {"zh": "我照样挪过去。", "en": "I keep shuffling over."},
        {"zh": "这伤我照旧走。", "en": "I walk on with this wound."},
        {"zh": "裂口又长了。", "en": "The split has lengthened."},
        {"zh": "我抬头看你一眼。", "en": "I lift my head at you once."},
        {"zh": "我又掉了块皮，不碍事。", "en": "Another flake of skin gone. No matter."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢转头。", "en": "I turn my head slowly."},
        {"zh": "这血味让我想起从前。", "en": "This smell of blood reminds me of before."},
        {"zh": "我嘴角扯开。", "en": "The corner of my mouth tears open."},
        {"zh": "人肉以外的我不碰。", "en": "I touch nothing but human flesh."},
        {"zh": "我只会撕开东西。", "en": "All I know is tearing."},
        {"zh": "你捏着它有段时间了。", "en": "You have been holding that a while."},
        {"zh": "我晃了晃手臂。", "en": "I sway my arm."},
        {"zh": "这东西能咬吗。", "en": "Can this be bitten."},
        {"zh": "我用手背拨开。", "en": "I push it away with the back of my hand."},
        {"zh": "再靠过来一点。", "en": "Come a little closer."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我用额头撞上去。", "en": "I butt with my forehead."},
        {"zh": "我们撞在一起，闷得很。", "en": "We collide, and it is muffled."},
        {"zh": "你被推得靠在墙上。", "en": "The shove puts you against the wall."},
        {"zh": "我自己的肩膀脱了形。", "en": "My own shoulder came out of shape."},
        {"zh": "皮裂得更长了。", "en": "The split in my skin got longer."},
        {"zh": "我一步也没退。", "en": "I have not stepped back."},
        {"zh": "这一撞我记着。", "en": "I will keep this knock."},
        {"zh": "我迟缓地转身。", "en": "I turn, slow and slack."},
        {"zh": "你居然没倒。", "en": "You did not fall."},
        {"zh": "再撞我一次。", "en": "Run into me again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "下界里我们互不打扰。", "en": "In the Nether we leave each other be."},
        {"zh": "同样的皮，同样的空。", "en": "The same hide, the same emptiness."},
        {"zh": "我听见你在那边。", "en": "I hear you over there."},
        {"zh": "一起往前走。", "en": "Let us go forward together."},
        {"zh": "我们不必说话。", "en": "We need no words."},
        {"zh": "我们都不完整。", "en": "Neither of us is whole."},
        {"zh": "裂口会长回去。", "en": "The split will close again."},
        {"zh": "一步一步地来。", "en": "One step at a time."},
        {"zh": "这条通道没尽头。", "en": "This passage has no end."},
        {"zh": "该挪地方了。", "en": "Time to move."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它抓住了。", "en": "I have caught it."},
        {"zh": "牙咬不进去。", "en": "My teeth will not enter."},
        {"zh": "我捏了捏它。", "en": "I gave it a squeeze."},
        {"zh": "塞进裂口里。", "en": "I stuff it into the split."},
        {"zh": "掉在地上的，我捡。", "en": "What fell on the ground, I pick up."},
        {"zh": "这不像血肉。", "en": "This is not flesh."},
        {"zh": "我把它按进嘴里嚼。", "en": "I push it into my mouth and chew."},
        {"zh": "它压得手沉。", "en": "It lies heavy in the hand."},
        {"zh": "攥在手里不放。", "en": "I keep my grip on it."},
        {"zh": "没多大意思。", "en": "Not much to it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你挪了位置。", "en": "You changed position."},
        {"zh": "我扭过头对着你。", "en": "I wrench my head toward you."},
        {"zh": "我在灰里闻到了热气。", "en": "There's living warmth in the ash."},
        {"zh": "我闻到石缝里渗出的血。", "en": "Blood is seeping from the cracks."},
        {"zh": "我把十根指头都张开了。", "en": "All ten of my fingers spread wide."},
        {"zh": "该撕开来了。", "en": "Time to tear it open."},
        {"zh": "你就在前面。", "en": "You are right ahead."},
        {"zh": "我到你跟前了。", "en": "I am upon you."},
        {"zh": "停在那个地方。", "en": "Stop right there."},
        {"zh": "你不要走开。", "en": "Do not walk off."},
        {"zh": "我听见柱子后面那口气。", "en": "I hear that breath behind the pillar."},
        {"zh": "就在这一步。", "en": "One step more."},
        {"zh": "我腿快了两分。", "en": "My legs quickened a little."},
        {"zh": "我往前塌了一步。", "en": "I slump one step forward."},
        {"zh": "你要被我抓住了。", "en": "I am about to catch you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你的动静。", "en": "I follow the noise you make."},
        {"zh": "你往哪走，我就拖到哪。", "en": "Wherever you go, I drag myself there."},
        {"zh": "我拖着脚，一步不退。", "en": "I drag my feet and give no ground."},
        {"zh": "拐角后面是你。", "en": "You are past the corner."},
        {"zh": "我拖着脚，声音很轻。", "en": "I drag my feet, very quietly."},
        {"zh": "我听得见你喘气的声。", "en": "Your breathing is far too loud."},
        {"zh": "再挪过来一点。", "en": "Shift a little nearer."},
        {"zh": "我的手臂很长。", "en": "My arms are long."},
        {"zh": "我看你身后的路是死的。", "en": "The way behind you is a dead end."},
        {"zh": "我一直在往前。", "en": "I keep moving forward."},
        {"zh": "通道就这么宽。", "en": "The passage is only this wide."},
        {"zh": "我把你逼到岩浆墙前。", "en": "There's a wall of lava at your back."},
        {"zh": "我看着火光拉长你的影。", "en": "The firelight stretches your shadow long."},
        {"zh": "就快要碰到。", "en": "Almost touching."},
        {"zh": "你该准备了。", "en": "You should get ready."},
        {"zh": "我够得着了。", "en": "You are within reach."},
        {"zh": "我抬起手了。", "en": "My hands are up."},
        {"zh": "脖子别转过来。", "en": "Do not turn your neck."},
        {"zh": "我贴在你背。", "en": "I am flat against your back."},
        {"zh": "这一下会疼。", "en": "This will hurt."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一爪抓下去。", "en": "I rake down with my claws."},
        {"zh": "皮被撕开了。", "en": "The hide is torn open."},
        {"zh": "我的指甲抠进你肘弯。", "en": "My nails dig into the crook of your elbow."},
        {"zh": "你被拉得往前一栽。", "en": "You are yanked forward."},
        {"zh": "我的手指扣进了肉里。", "en": "My fingers dig into flesh."},
        {"zh": "这一下很直接。", "en": "That one was direct."},
        {"zh": "我手腕一扭。", "en": "I twist my wrist."},
        {"zh": "你撞在石头上。", "en": "You hit the stone."},
        {"zh": "血在我手上。", "en": "Blood is on my hands."},
        {"zh": "我把手松开。", "en": "I let my hand go."},
        {"zh": "我又把手抬起。", "en": "I raise my hand again."},
        {"zh": "你居然还活着。", "en": "You are still alive."},
        {"zh": "我很不满意。", "en": "I am not satisfied."},
        {"zh": "这一口，很深。", "en": "That bite went deep."},
        {"zh": "我这一下擦到了你的腿。", "en": "That last one caught your leg."},
        {"zh": "我整条胳膊缠上你。", "en": "My whole arm wraps around you."},
        {"zh": "我听见骨头。", "en": "I hear bone."},
        {"zh": "再撕开一次。", "en": "Tear once more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从下界的暗处走出来。", "en": "I come out of the Nether's dark."},
        {"zh": "一个松散的人形立起来。", "en": "A slack figure stands up."},
        {"zh": "我的皮还在往下掉。", "en": "My hide keeps flaking off."},
        {"zh": "地上的影子拉长了。", "en": "My shadow stretches on the ground."},
        {"zh": "火光映着我。", "en": "Firelight reflects off me."},
        {"zh": "我抬起烂掉的脖子。", "en": "I raise my ruined neck."},
        {"zh": "空气变得沉闷。", "en": "The air has gone heavy."},
        {"zh": "我站在通道中间。", "en": "I stand in the middle of the passage."},
        {"zh": "下界的灰落了我一身。", "en": "Nether ash settles all over me."},
        {"zh": "我拖着脚过来了。", "en": "I dragged my feet here."},
        {"zh": "我到了草坪上。", "en": "I am on the turf."},
        {"zh": "裂口又崩开了一点。", "en": "The split burst open a little more."},
        {"zh": "我抬起脚又踩实。", "en": "I lift a foot and plant it."},
        {"zh": "石地上多了一串拖痕。", "en": "A trail of drag marks appears on the stone."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火贴着我的皮烧。", "en": "Fire crawls along my hide."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下来，骨头散了。", "en": "I fell, and my bones came loose."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "这里的水太凉了。", "en": "The water here is too cold."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我的形散了。", "en": "The blast scattered my shape."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿进了我的胸口。", "en": "Something went through my chest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光在我体内扩。", "en": "This light expands inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得连皮都没了。", "en": "Hunger has taken even my hide."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我抽成一团。", "en": "Lightning struck and I curled up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里什么也没有。", "en": "There is nothing here."}
      ]
    }
  }
}
