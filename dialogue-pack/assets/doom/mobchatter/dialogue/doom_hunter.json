{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "下半身是滑轨，不是腿", "en": "My lower half is a sled, not legs."},
        {"zh": "履带碾过下界岩", "en": "My treads grind over netherrack"},
        {"zh": "浮空装置嗡嗡作响", "en": "The hover unit hums."},
        {"zh": "双管炮挂在肩上", "en": "Twin cannons hang at my shoulders."},
        {"zh": "下界岩被我的滑轨磨亮", "en": "My sled polishes the netherrack."},
        {"zh": "我不走路，我推进", "en": "I don't walk; I propel."},
        {"zh": "这具身体是为猎杀造的", "en": "This body was built to hunt."},
        {"zh": "滑过岩浆边缘，眉毛都不皱", "en": "I skim lava's edge without flinching."},
        {"zh": "机械臂比人腿灵活", "en": "My mechanical arms are nimbler than legs."},
        {"zh": "推进器喷出的热气掀尘", "en": "The thruster's hot exhaust lifts dust."},
        {"zh": "我一路滑，声音很尖", "en": "My glide makes a sharp sound."},
        {"zh": "下半身的履带卡过石子", "en": "My tracks caught a pebble."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "悬停着，等你出现", "en": "Hovering, waiting for you to appear."},
        {"zh": "炮管自动校准", "en": "The barrels calibrate themselves."},
        {"zh": "我身上没有多余的部分", "en": "There's nothing spare on me."},
        {"zh": "下界的热气对我不算什么", "en": "The Nether's heat means nothing."},
        {"zh": "浮空器一直在响", "en": "The hover unit never goes quiet."},
        {"zh": "我在扫描这片地形", "en": "I'm scanning this terrain."},
        {"zh": "肩炮转到零位", "en": "Shoulder cannons return to zero."},
        {"zh": "一半是金属，一半是骨", "en": "Half metal, half bone."},
        {"zh": "排气口在代替我呼吸", "en": "My vents breathe for me"},
        {"zh": "排气口冒出一小股白烟", "en": "A small puff of white smoke vents."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "扫描到一个活体", "en": "Living target detected."},
        {"zh": "你的体温，我看得清", "en": "I see your body heat clearly."},
        {"zh": "双管已经对准", "en": "Both barrels are aligned."},
        {"zh": "你不是猎杀者", "en": "You're not the Slayer."},
        {"zh": "那我照规矩处理", "en": "Then I'll follow procedure."},
        {"zh": "你站的位置很空", "en": "You're standing in the open."},
        {"zh": "我的瞄准不会抖", "en": "My aim doesn't waver."},
        {"zh": "你还有一步的余地", "en": "You have one step of leeway."},
        {"zh": "别动，动了我更快", "en": "Don't move; moving makes me faster."},
        {"zh": "炮口里已经有火", "en": "There's already fire in the barrels."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "装甲被击穿了", "en": "Armor penetrated."},
        {"zh": "有一块零件松了", "en": "A component came loose."},
        {"zh": "左臂的液压在漏", "en": "Hydraulics leaking on the left arm."},
        {"zh": "我退滑了一步", "en": "I skidded back a step."},
        {"zh": "损伤已经记录", "en": "Damage logged."},
        {"zh": "炮管歪了半度", "en": "A barrel is off by half a degree."},
        {"zh": "这点损伤拖不住我", "en": "This won't stop me."},
        {"zh": "我的骨肉部分也在疼", "en": "The flesh part hurts too."},
        {"zh": "我正在重新校准", "en": "Recalibrating."},
        {"zh": "下次我会更快", "en": "I'll be faster next time."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你那点东西，入不了储槽", "en": "That stuff won't go in my tank"},
        {"zh": "能量才是我的食粮", "en": "Energy is my sustenance."},
        {"zh": "你举着它，扫描结果是废物", "en": "My scan says that's useless."},
        {"zh": "下界生物不吃这些", "en": "Nether creatures don't eat this."},
        {"zh": "我也是被造出来的", "en": "I was made too."},
        {"zh": "拿开，我要的是击杀", "en": "Move it; I want the kill."},
        {"zh": "这不会让我停下", "en": "This won't make me stop."},
        {"zh": "你不如跑快一点", "en": "You'd do better running faster."},
        {"zh": "燃料？！你带着燃料？", "en": "Fuel?! You carry fuel?"},
        {"zh": "那就先别急着跑", "en": "Then don't run yet."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "滑轨撞上你的腿", "en": "My sled hit your legs."},
        {"zh": "我这具身体没有缓冲", "en": "This body has no cushioning."},
        {"zh": "你被推进器吹开了", "en": "The thruster pushed you off."},
        {"zh": "撞我一下，我的炮管还在", "en": "Bump me; my barrels are still on target."},
        {"zh": "让开，我停不住", "en": "Move; I can't brake."},
        {"zh": "金属碰骨头，声音很脆", "en": "Metal on bone, a sharp sound."},
        {"zh": "我侧滑了一下", "en": "I skidded sideways."},
        {"zh": "别贴在我的滑轨旁", "en": "Don't walk beside my sled."},
        {"zh": "这一下，我的履带卡了", "en": "Now my tracks are jammed."},
        {"zh": "撞我，只是提醒我你在哪", "en": "Bumping me just tells me where you are."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是猎杀单位", "en": "I'm a hunting unit."},
        {"zh": "这具身体没有那种设计", "en": "This body has no such design."},
        {"zh": "肩炮比同伴可靠", "en": "The cannons are more reliable than company."},
        {"zh": "下界不生产我的同类", "en": "The Nether doesn't make my kind."},
        {"zh": "我只对目标感兴趣", "en": "I'm only interested in targets."},
        {"zh": "你在跟一台机器说话", "en": "You're talking to a machine."},
        {"zh": "我的用途写在程序里", "en": "My purpose is written in my code."},
        {"zh": "别靠近，浮空器会烫", "en": "Stay back; the hover unit burns."},
        {"zh": "你该去找活的东西", "en": "You should find something alive."},
        {"zh": "这不属于我的任务", "en": "Not part of my task."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有可回收物", "en": "Reclaimable material on the ground."},
        {"zh": "机械臂伸下去", "en": "A mechanical arm reaches down."},
        {"zh": "能量电池，优先回收", "en": "Energy cell; reclaim first."},
        {"zh": "下界合金碎片，有用", "en": "Netherite scrap is useful."},
        {"zh": "恶魂之泪，收进储槽", "en": "Ghast tear, into the reservoir."},
        {"zh": "这点东西，不值得停", "en": "Not worth stopping for."},
        {"zh": "滑轨压过它，没收了", "en": "My sled rolled over it; confiscated."},
        {"zh": "我把它夹在指节间", "en": "I clamp it between my knuckles."},
        {"zh": "回收作业完成", "en": "Reclamation complete."},
        {"zh": "回收下一件物品", "en": "Next item."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "红点落在你胸口", "en": "A red dot lands on your chest"},
        {"zh": "双管开始预转", "en": "Both barrels spin up."},
        {"zh": "你已经被标记", "en": "You've been marked."},
        {"zh": "我的炮不需要理由", "en": "My cannons need no reason."},
        {"zh": "下界的活物，都归我清理", "en": "Everything living here is mine to clear."},
        {"zh": "推进器已经启了", "en": "Thrusters engaged."},
        {"zh": "先打一炮再看", "en": "One shot, then reassess."},
        {"zh": "你的位置在缓坡上", "en": "You're on a slope; I've noted it."},
        {"zh": "这一发，躲不掉", "en": "You can't dodge this one."},
        {"zh": "我不喊，我开火", "en": "I don't shout; I fire."},
        {"zh": "猎杀程序开始运行", "en": "Hunt routine engaged."},
        {"zh": "你还站在那里", "en": "You're still standing there."},
        {"zh": "错误，你该跑了", "en": "Error: you should be running."},
        {"zh": "目标已经完全锁定", "en": "Target locked."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在侧滑调整角度", "en": "I skid to adjust my angle."},
        {"zh": "炮口一直跟着你", "en": "The barrels track you."},
        {"zh": "你的移动轨迹很简单", "en": "Your movement is simple to read."},
        {"zh": "扫描显示你没有护甲", "en": "Scan shows no armor."},
        {"zh": "下界岩挡不住我的射线", "en": "Netherrack won't stop my line of fire."},
        {"zh": "我在等冷却结束", "en": "Waiting for cooldown."},
        {"zh": "冷却已经完成", "en": "Cooldown complete."},
        {"zh": "你跑到岩浆后面了", "en": "You're behind the lava."},
        {"zh": "那样也挡不住", "en": "That won't block it either."},
        {"zh": "我推进速度不快，但稳", "en": "My propulsion isn't fast, but it's steady."},
        {"zh": "你的脉搏，我听得到", "en": "I can hear your pulse"},
        {"zh": "肩炮换了个角度", "en": "Shoulder cannons shift angle."},
        {"zh": "你绕圈，我也绕", "en": "You circle; so do I."},
        {"zh": "你每跑一步，都在校准里", "en": "Every step you run is already in my calibration"},
        {"zh": "我再给你三秒", "en": "Three seconds more."},
        {"zh": "还有最后两秒", "en": "Two."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "机械臂横着扫过去", "en": "A mechanical arm sweeps."},
        {"zh": "滑轨直接撞过去", "en": "My sled rams forward."},
        {"zh": "肩炮贴脸开火", "en": "Point-blank shoulder cannon fire."},
        {"zh": "铁拳砸穿地面", "en": "My fist breaks through the floor."},
        {"zh": "这一下带着推进力", "en": "This blow carries thrust."},
        {"zh": "你被顶到岩壁上", "en": "You're pinned to the wall."},
        {"zh": "我连着开了两炮", "en": "Two shots in a row."},
        {"zh": "金属边缘很利", "en": "The metal edge is sharp."},
        {"zh": "你挡了，但退了两步", "en": "You blocked, then slid back two steps."},
        {"zh": "推进器把我推到你面前", "en": "The thruster throws me at you."},
        {"zh": "这一击，省了火药", "en": "This one saves gunpowder."},
        {"zh": "脚下滑轨碾过去", "en": "The sled grinds over you."},
        {"zh": "射击角度已经算好", "en": "The angle was calculated."},
        {"zh": "再补上这一记", "en": "One more hit."},
        {"zh": "你还有反应，不错", "en": "You still react; impressive."},
        {"zh": "这是结束动作", "en": "Finishing move."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "浮空器开始启动", "en": "Hover unit online."},
        {"zh": "我从岩浆边滑进来", "en": "I slide in from the lava's edge."},
        {"zh": "双管炮上了膛", "en": "Both barrels loaded."},
        {"zh": "金属在高温里冒烟", "en": "Metal smokes in the heat."},
        {"zh": "地形扫描开始", "en": "Scanning begins."},
        {"zh": "下界多了一个猎手", "en": "The Nether has one more hunter."},
        {"zh": "我的滑轨落在岩地上", "en": "My sled settles on the rock."},
        {"zh": "推进器第一次点火", "en": "Thrusters ignite for the first time."},
        {"zh": "这片区域的活物，由我处理", "en": "I'll handle the living things here."},
        {"zh": "一半骨一半铁，站起来了", "en": "Half bone, half iron, standing up."},
        {"zh": "炮口自动抬起", "en": "The barrels rise on their own."},
        {"zh": "猎杀任务开始", "en": "Task begins."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对金属没什么用", "en": "Fire is useless against metal."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地的冲击震松了滑轨", "en": "The impact loosened my sled."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "液体进入进气口", "en": "Liquid in the intake."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击掀开了肩甲", "en": "The blast tore off a shoulder plate."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弹片卡在关节里", "en": "Shrapnel lodged in a joint."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "扫描识别不了这种能量", "en": "Scan can't identify this energy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "能量见底，推进器迟钝", "en": "Energy low; thrusters sluggish."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击烧了主电路", "en": "Lightning fried the main circuit."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下方没有地面，浮空器失效", "en": "No ground below; hover failing."}
      ]
    }
  }
}
