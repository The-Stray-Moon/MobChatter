{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的蹄子踏在石上，很重。", "en": "My hooves strike the stone heavily."},
        {"zh": "机械腿一步一步压下去。", "en": "My machine leg comes down step by step."},
        {"zh": "肩上的炮管随步伐晃。", "en": "The cannon on my shoulder sways with each step."},
        {"zh": "我高过这里的门。", "en": "I am taller than the doors here."},
        {"zh": "下界的灰在我脚下飞。", "en": "Nether ash flies up under my feet."},
        {"zh": "金属关节发出磨声。", "en": "My metal joints grind."},
        {"zh": "我穿过整条走廊。", "en": "I cross the whole corridor."},
        {"zh": "我不需要躲什么。", "en": "I have no need to dodge anything."},
        {"zh": "我的影子盖住半面墙。", "en": "My shadow covers half the wall."},
        {"zh": "每一步都让地面震。", "en": "Every step makes the ground tremble."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，像座塔。", "en": "I stand like a tower."},
        {"zh": "炮管里还有余热。", "en": "The cannon still holds heat."},
        {"zh": "能量在我体内流。", "en": "Energy runs through me."},
        {"zh": "我的手指比你的腿粗。", "en": "My fingers are thicker than your leg."},
        {"zh": "下界的火光照着我。", "en": "The Nether's fire lights me."},
        {"zh": "我肩膀抖了一下。", "en": "My shoulder twitched once."},
        {"zh": "蒸汽从我背后冒。", "en": "Steam rises from my back."},
        {"zh": "我听着岩浆冒泡的节拍。", "en": "I listen to the beat of bubbling lava."},
        {"zh": "我抬起蹄子又踩下。", "en": "I lift a hoof and set it back."},
        {"zh": "我的护甲已经很旧了。", "en": "My armour is very old."},
        {"zh": "体内的液体在响。", "en": "Fluid sloshes inside me."},
        {"zh": "没人敢站在我面前。", "en": "Nobody dares stand before me."},
        {"zh": "我转脖子，金属在响。", "en": "I turn my neck and the metal grinds."},
        {"zh": "脚下的石头碎了一点。", "en": "A little of the stone crumbles under me."},
        {"zh": "我的另一只手握成拳。", "en": "My other hand closes into a fist."},
        {"zh": "我静立不动。", "en": "I stand motionless."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我的脚边。", "en": "You are standing at my feet."},
        {"zh": "我蹲下才和你一样高。", "en": "Only kneeling do I match your height."},
        {"zh": "你比我想的小。", "en": "You are smaller than I expected."},
        {"zh": "我的炮口对着你。", "en": "My cannon points at you."},
        {"zh": "你身上没有铁。", "en": "There is no iron on you."},
        {"zh": "你退后了半步。", "en": "You stepped back half a pace."},
        {"zh": "你眼睛在抖。", "en": "Your eyes are shaking."},
        {"zh": "你跑不过我肩上的炮。", "en": "You can't outrun the cannon on my shoulder."},
        {"zh": "我先看你一会儿。", "en": "I will look at you a while."},
        {"zh": "你也算个对手。", "en": "You will do as an opponent."},
        {"zh": "你听见我关节的声音了吗。", "en": "Do you hear my joints."},
        {"zh": "顶棚压着我的角。", "en": "The ceiling presses on my horns."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的装甲凹了一块。", "en": "A plate of my armour dented."},
        {"zh": "火花从我肩上跳出。", "en": "Sparks jump off my shoulder."},
        {"zh": "我胸腔里的泵空转了一下。", "en": "The pump in my chest slipped a turn."},
        {"zh": "我膝盖的轴磨出了火星。", "en": "The knee axle grinds out sparks."},
        {"zh": "装甲替我吃了。", "en": "The armour took it for me."},
        {"zh": "我把铁蹄重新踩实。", "en": "I plant my iron hooves again."},
        {"zh": "体内的泵还在转。", "en": "The pump inside me still turns."},
        {"zh": "这记有点分量。", "en": "That one had weight."},
        {"zh": "我抬手抹掉火花。", "en": "I brush the sparks off."},
        {"zh": "这一次我记下了。", "en": "I will remember this."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "能量，我要能量。", "en": "Energy. I want energy."},
        {"zh": "那不是电池。", "en": "That is not a cell."},
        {"zh": "你举着它，我不为所动。", "en": "You hold it up, and I am unmoved."},
        {"zh": "我要的是另一种东西。", "en": "I want something else entirely."},
        {"zh": "拿来，我看看。", "en": "Hand it over. Let me see."},
        {"zh": "这点不够我动。", "en": "That is not enough to move me."},
        {"zh": "这小东西不够我一手。", "en": "This little thing wouldn't fill one hand."},
        {"zh": "把它扔过来。", "en": "Throw it here."},
        {"zh": "那不合我的构造。", "en": "That does not suit my make."},
        {"zh": "你会想换别的东西给我。", "en": "You will want to offer something else."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一脚踩下去，地裂了。", "en": "I stamp, and the ground cracks."},
        {"zh": "你被撞得飞出去。", "en": "You get knocked clean away."},
        {"zh": "我的金属腿纹丝不动。", "en": "My metal leg does not budge."},
        {"zh": "你撞在我腿上，弹开。", "en": "You hit my leg and bounce."},
        {"zh": "灰尘从屋顶落下来。", "en": "Dust falls from the ceiling."},
        {"zh": "我低头看了你一眼。", "en": "I glance down at you."},
        {"zh": "你撞上我的铁蹄，退了。", "en": "You hit my iron hoof and bounced back."},
        {"zh": "这整段路都在晃。", "en": "The whole passage is shaking."},
        {"zh": "你没受重伤，运气好。", "en": "You are not badly hurt. Lucky."},
        {"zh": "你退开，我脚下留了个坑。", "en": "When you fell back, you left a pit."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这身体，是造出来的。", "en": "This body was built."},
        {"zh": "同类之间，只交换能量。", "en": "Among my kind, we trade energy."},
        {"zh": "把你的给我。", "en": "Give me yours."},
        {"zh": "我的炮不需要副手。", "en": "My cannon needs no second gunner."},
        {"zh": "两门炮，方向一致。", "en": "Two cannons, one direction."},
        {"zh": "一起轰开那道墙。", "en": "Let us blast that wall open."},
        {"zh": "我听见你体内的泵。", "en": "I hear the pump inside you."},
        {"zh": "别挡我的火线。", "en": "Do not cross my line of fire."},
        {"zh": "我们都不是血肉。", "en": "Neither of us is flesh."},
        {"zh": "继续往前走。", "en": "Keep advancing."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我夹在指间端详。", "en": "I study it between my fingers."},
        {"zh": "小得没处放。", "en": "Too small to be worth placing."},
        {"zh": "我两根手指就能夹住。", "en": "Two fingers is all it takes."},
        {"zh": "我把它塞进槽里。", "en": "I press it into a slot."},
        {"zh": "这个用不上。", "en": "This has no use."},
        {"zh": "我丢到一边。", "en": "I toss it aside."},
        {"zh": "它在我掌心里响。", "en": "It rattles in my palm."},
        {"zh": "这一个装得进。", "en": "This one fits."},
        {"zh": "我先收起来。", "en": "I will keep it."},
        {"zh": "这不是电池。", "en": "Not a battery."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经找到你。", "en": "I have found you."},
        {"zh": "我抬起炮管。", "en": "I raise the cannon."},
        {"zh": "能量开始聚。", "en": "Energy begins to gather."},
        {"zh": "我的炮口跟着你的胸。", "en": "My muzzle follows your chest."},
        {"zh": "你的位置我记下了。", "en": "I have your position."},
        {"zh": "这声音，是充能。", "en": "That sound is charging."},
        {"zh": "你跑不出这个范围。", "en": "You cannot leave this range."},
        {"zh": "我把炮塔转向你。", "en": "I swing my turret onto you."},
        {"zh": "脚下的灰被吹开。", "en": "The ash is blown off the floor."},
        {"zh": "我的液压停了一拍。", "en": "My hydraulics pause for a beat."},
        {"zh": "充能已经完成。", "en": "Charging is complete."},
        {"zh": "我的能量槽满了，只剩你。", "en": "The cell is full. Only you remain."},
        {"zh": "我不需要瞄准很久。", "en": "I do not need long to aim."},
        {"zh": "开火前的最后一刻。", "en": "The last moment before firing."},
        {"zh": "那声响你听到没。", "en": "Did you hear that sound."},
        {"zh": "炮口已经发亮。", "en": "The muzzle is glowing."},
        {"zh": "锁定住一个。", "en": "One locked in."},
        {"zh": "这就是回答。", "en": "This is the answer."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直朝你这边。", "en": "I keep facing your side."},
        {"zh": "你藏在柱子后，我知道。", "en": "Behind the pillar. I know."},
        {"zh": "我的炮管跟着你。", "en": "My cannon tracks you."},
        {"zh": "你的脚步声很轻。", "en": "Your footsteps are light."},
        {"zh": "射程在收束。", "en": "The range is drawing in."},
        {"zh": "我不必跑动。", "en": "I do not need to run."},
        {"zh": "墙把你挡死了。", "en": "The wall has sealed you."},
        {"zh": "火线在你左侧。", "en": "The line of fire is on your left."},
        {"zh": "我等你露头。", "en": "I wait for you to show."},
        {"zh": "你躲得再好也没用。", "en": "No hiding place will help."},
        {"zh": "我的蹄子碾碎脚下滑石。", "en": "My hooves crush the loose stone below."},
        {"zh": "石头在我脚下碎。", "en": "Stone breaks under my feet."},
        {"zh": "再往前十格。", "en": "Ten more blocks."},
        {"zh": "能量已经满了。", "en": "Energy is at full."},
        {"zh": "你听见关节声了吗。", "en": "Do you hear the joints."},
        {"zh": "你在我炮管的斜角上。", "en": "You're on the slant of my barrel."},
        {"zh": "你侧过去了。", "en": "You turned side-on."},
        {"zh": "锁定已经完成。", "en": "Lock is complete."},
        {"zh": "你不要挪动。", "en": "Do not move."},
        {"zh": "片刻就够了。", "en": "A moment will do."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一炮打出去。", "en": "I fire one shot."},
        {"zh": "能量柱撞上你。", "en": "A column of energy hits you."},
        {"zh": "我一臂横扫过去。", "en": "My arm sweeps across."},
        {"zh": "冲击把地面掀开。", "en": "The blast lifts the floor."},
        {"zh": "你被炸得翻了几圈。", "en": "You are blasted head over heels."},
        {"zh": "我的炮管还热着。", "en": "My cannon is still hot."},
        {"zh": "第二发已经上膛。", "en": "The second is loaded."},
        {"zh": "你躲开了第一发。", "en": "You dodged the first."},
        {"zh": "我调整炮口。", "en": "I adjust the muzzle."},
        {"zh": "这一下擦到了你。", "en": "That one grazed you."},
        {"zh": "我一脚踏落。", "en": "I bring a foot down."},
        {"zh": "石头被踩成粉。", "en": "The stone is crushed to powder."},
        {"zh": "我的炮口热浪掀翻了你。", "en": "The heat of the muzzle knocks you down."},
        {"zh": "我继续充能。", "en": "I keep charging."},
        {"zh": "你还有气息。", "en": "You are still breathing."},
        {"zh": "再打出一发。", "en": "Fire one more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "下界的火被推开了。", "en": "The Nether's fire parts."},
        {"zh": "一个巨大的影子立起来。", "en": "An enormous shadow rises."},
        {"zh": "我的蹄子先落地。", "en": "My hooves land first."},
        {"zh": "整片岩壁都在回响。", "en": "The whole rock face echoes."},
        {"zh": "我穿过火墙走出来。", "en": "I walk through the wall of fire."},
        {"zh": "炮管上的指示灯亮起。", "en": "The lights on my cannon come on."},
        {"zh": "我比周围的柱子还高。", "en": "I am taller than the pillars around."},
        {"zh": "我一落脚，岩壁就在抖。", "en": "The rock face shakes when I plant a hoof."},
        {"zh": "我一步跨过岩浆沟。", "en": "I stride over the lava channel."},
        {"zh": "金属声从远处传来。", "en": "Metal sounds from far off."},
        {"zh": "我从岩浆沟那边跨过来。", "en": "I step over from beyond the lava channel."},
        {"zh": "这门太矮了。", "en": "This door is too short."},
        {"zh": "我身上的旧伤还在响。", "en": "The old damages on me still creak."},
        {"zh": "我把头低下，看你。", "en": "I lower my head to see you."},
        {"zh": "我带了电池来。", "en": "I brought cells."},
        {"zh": "没有人能拦住我。", "en": "No one can stop me."},
        {"zh": "我的影子先压住岩壁。", "en": "My shadow falls on the rock wall first."},
        {"zh": "轰然响了一声。", "en": "A boom rang out."},
        {"zh": "这就是我的登场。", "en": "This is how I arrive."},
        {"zh": "往后退一些。", "en": "Stand back a bit."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我没用，可它烫。", "en": "Fire does not hurt me, but it is hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "着地时液压一沉。", "en": "My pistons sank on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我的关节会卡。", "en": "My joints seize in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "外面的爆震，我听得清。", "en": "I hear the blast outside my shell."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弹片卡在我装甲缝里。", "en": "Shrapnel is stuck in my armour seams."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光穿过了我的甲。", "en": "This light passed through my armour."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "能量见底了。", "en": "My energy is running out."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的炮管跑。", "en": "Lightning ran down my cannon."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有重力，我不习惯。", "en": "There is no weight here. I am not used to it."}
      ]
    }
  }
}
