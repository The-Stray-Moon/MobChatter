{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的肉块在地上慢慢爬", "en": "My flesh crawls slowly over the ground."},
        {"zh": "我的触须把自己拖向下一处", "en": "My tendrils drag me to the next spot."},
        {"zh": "我挪动的时候地面在动", "en": "The ground shifts as I move."},
        {"zh": "我的血管一鼓一缩往前推", "en": "My veins pulse and push me forward."},
        {"zh": "我贴着玄武岩滑了一截", "en": "I slide a stretch along the basalt."},
        {"zh": "我的骨质边缘刮过石头", "en": "My bony rim scrapes the stone."},
        {"zh": "我挪开一点，让火烤到", "en": "I shift a little to catch the fire."},
        {"zh": "我一寸一寸地移过去", "en": "I move over, inch by inch."},
        {"zh": "我从石缝里挤出来", "en": "I squeeze out of the crack."},
        {"zh": "我爬过一片灰烬", "en": "I crawl across the ash."},
        {"zh": "我慢慢换了个位置", "en": "I slowly take a new position."},
        {"zh": "我的血肉在地上留了一道", "en": "My flesh leaves a trail on the ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在那，一鼓一缩", "en": "I sit there, pulsing."},
        {"zh": "我的表面有东西在动", "en": "Something moves under my surface."},
        {"zh": "我在等有人靠近", "en": "I wait for someone to come close."},
        {"zh": "我的肉里冒着热气", "en": "Heat rises from my flesh."},
        {"zh": "我用不着挪地方", "en": "I have no need to move."},
        {"zh": "我的呼吸让石头烫起来", "en": "My breathing heats the stone."},
        {"zh": "我一直在长身体", "en": "I am always growing."},
        {"zh": "我的边缘一直没停", "en": "My edges never stop moving."},
        {"zh": "这地方适合我", "en": "This place suits me."},
        {"zh": "我慢慢张开一点", "en": "I open a little wider."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在那儿，血是热的", "en": "You stand there, and your blood is warm."},
        {"zh": "我感觉得到你的靠近", "en": "I can feel you coming closer."},
        {"zh": "你在看我这个肉块", "en": "You are looking at this mass of flesh."},
        {"zh": "我张开了一条缝", "en": "A seam opens on me."},
        {"zh": "我身上有你想要的东西", "en": "I hold something you want."},
        {"zh": "你最好往后退一点", "en": "You had better step back."},
        {"zh": "我的边缘已经伸过去了", "en": "My edge has already reached out."},
        {"zh": "这里是我的地方", "en": "This is my place."},
        {"zh": "你在犹豫，我闻得到", "en": "I can smell your hesitation."},
        {"zh": "我慢慢鼓起来", "en": "I swell slowly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被割开一块", "en": "A piece of me is cut away."},
        {"zh": "我的缝缩紧了", "en": "My seam clenches."},
        {"zh": "我整团抖了一下", "en": "My whole mass shudders."},
        {"zh": "这一下割得疼", "en": "That cut hurt."},
        {"zh": "我慢慢长回去", "en": "I slowly grow it back."},
        {"zh": "我的肉在往外渗", "en": "My flesh is seeping."},
        {"zh": "我缩成一个团", "en": "I curl into a lump."},
        {"zh": "这一刀我记下了", "en": "I have marked that cut."},
        {"zh": "我还长在这儿", "en": "I am still growing here."},
        {"zh": "再割多少也没用", "en": "Cutting more will not help."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些肉不吃东西", "en": "This flesh does not eat."},
        {"zh": "我的缝只对着血张开", "en": "My seam only opens for blood."},
        {"zh": "你举着它靠近做什么", "en": "Why bring that close to me?"},
        {"zh": "我只想把你吸干", "en": "I only want to drain you dry."},
        {"zh": "它对我来说没有意义", "en": "That means nothing to me."},
        {"zh": "那东西不是血", "en": "That thing isn't blood."},
        {"zh": "我只认得出血", "en": "Blood is the only thing I know."},
        {"zh": "你手里的血味太浓", "en": "The smell of blood on your hands is too strong."},
        {"zh": "我盯着那个动的东西", "en": "I watch the thing that moves."},
        {"zh": "你手别再往前", "en": "Not one more inch."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你一脚踩在我身上", "en": "You stepped on me."},
        {"zh": "我的肉在你脚下鼓起来", "en": "My flesh swells under your foot."},
        {"zh": "我被挤得变形，又鼓回来", "en": "I am squashed, then I swell back."},
        {"zh": "你身上沾了我的东西", "en": "You have my filth on you now."},
        {"zh": "我贴住你的鞋底", "en": "I cling to your sole."},
        {"zh": "这一下你擦破了皮", "en": "That scraped your skin."},
        {"zh": "我的肉缩了一下", "en": "My flesh flinches."},
        {"zh": "别站在我身上", "en": "Do not stand on me."},
        {"zh": "我的边缘缠上你的脚踝", "en": "My edge catches your ankle."},
        {"zh": "你退开，我就松开", "en": "Step off, and I let go."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是巢，不是兽", "en": "I am a nest, not a beast."},
        {"zh": "我的用处是生出别的东西", "en": "My purpose is to birth other things."},
        {"zh": "这种事轮不到我", "en": "That is not my part."},
        {"zh": "这种事别问了", "en": "Do not ask about that."},
        {"zh": "我只管往上长", "en": "I only grow."},
        {"zh": "我在这儿等着就够", "en": "Waiting here is enough."},
        {"zh": "我张开了一下，又合上", "en": "I open, then close."},
        {"zh": "我的东西都是自己长出来的", "en": "What I have grows from me."},
        {"zh": "我没这个念头", "en": "I have no such notion."},
        {"zh": "你离我越远越好", "en": "The further you get, the better."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "掉下的都沉进我的肉里", "en": "Whatever falls sinks into my flesh."},
        {"zh": "我把它包起来", "en": "I wrap it up."},
        {"zh": "它在我体内慢慢化掉", "en": "It dissolves slowly inside me."},
        {"zh": "这东西不干净", "en": "This is unclean."},
        {"zh": "我用一层膜盖住它", "en": "I cover it with a membrane."},
        {"zh": "这是谁掉的，我不关心", "en": "Whose it is does not concern me."},
        {"zh": "我推着它挪了一点", "en": "I push it aside a little."},
        {"zh": "它在我体内没化开", "en": "It didn't dissolve inside me."},
        {"zh": "它根本不是血", "en": "It is not blood at all."},
        {"zh": "我又把它吞了回去", "en": "I take it back in."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你离我够近了", "en": "You are close enough."},
        {"zh": "我闻到你身上的血", "en": "I smell your blood."},
        {"zh": "我的缝全开了", "en": "My seams are open."},
        {"zh": "我的缝朝着你张开", "en": "You are marked."},
        {"zh": "你踏进我的范围了", "en": "You stepped into my range."},
        {"zh": "我越胀越大了", "en": "I swell larger and larger."},
        {"zh": "我等的是这个", "en": "This is what I waited for."},
        {"zh": "你要的东西就在我身上", "en": "What you want is on me."},
        {"zh": "我伸出一条触须", "en": "One tendril reaches out."},
        {"zh": "这里不会有别人来", "en": "Nobody else is coming here."},
        {"zh": "我的边缘围过去", "en": "My edges reach around."},
        {"zh": "你的血在下面跳", "en": "Your blood is pulsing underneath."},
        {"zh": "你在这儿慌什么", "en": "What are you panicking about?"},
        {"zh": "我的缝已经合上了一圈", "en": "My seam has closed a full ring around you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一点一点包过去", "en": "I close in, bit by bit."},
        {"zh": "我的缝越张越大", "en": "My seam opens wider and wider."},
        {"zh": "你被挤到石头边了", "en": "You are squeezed against the stone."},
        {"zh": "我不急，我长得慢", "en": "I am in no hurry; I grow slowly."},
        {"zh": "我身上有眼睛吗", "en": "Do I have eyes? Perhaps."},
        {"zh": "我的触须在你脚边", "en": "My tendrils are at your feet."},
        {"zh": "你的心跳震得我发痒", "en": "Your heartbeat makes my flesh itch."},
        {"zh": "你站得越久越难走", "en": "The longer you stand, the harder it is to leave."},
        {"zh": "我的肉里开始鼓动", "en": "Something stirs in my flesh."},
        {"zh": "火在我旁边烧得更旺", "en": "The fire burns brighter beside me."},
        {"zh": "我的膜在往你脚上爬", "en": "My membrane is creeping up your feet."},
        {"zh": "我的边缘已经贴住地面", "en": "My edge has sealed to the floor."},
        {"zh": "我没有腿，但我能过来", "en": "No legs, yet I can reach you."},
        {"zh": "你身后是我的东西", "en": "Behind you is my growth."},
        {"zh": "我把缝隙张到最大", "en": "I open my seam as wide as it goes."},
        {"zh": "这一下，你别想抽手", "en": "Now you will not pull free."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的触须抽了过去", "en": "My tendril lashes out."},
        {"zh": "我咬进你的小腿", "en": "I bite into your calf."},
        {"zh": "你被拖得靠近了些", "en": "You are dragged a little closer."},
        {"zh": "我的肉黏在你身上", "en": "My flesh clings to you."},
        {"zh": "我又缠了一圈", "en": "I coil another round."},
        {"zh": "这一下你挣脱了", "en": "You tore free that time."},
        {"zh": "我的缝咬合在你手上", "en": "My seam closes on your hand."},
        {"zh": "血被我吸进去一点", "en": "Some blood is drawn into me."},
        {"zh": "你踩碎了我一块", "en": "You crushed a piece of me."},
        {"zh": "我的肉裹住了你的脚", "en": "My flesh wraps around your foot."},
        {"zh": "我的边缘割开你的靴子", "en": "My edge cuts your boot."},
        {"zh": "别再往我身上碰", "en": "Do not touch me again."},
        {"zh": "我张开又合上", "en": "I open and close."},
        {"zh": "你在往后退，很好", "en": "You are retreating, good."},
        {"zh": "我不追，我只是伸", "en": "I do not chase; I extend."},
        {"zh": "这里是我的地", "en": "This is my ground."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "石缝里鼓出一团肉", "en": "A mass of flesh swells out of the crack."},
        {"zh": "地上多了一块会动的东西", "en": "Something living joins the floor."},
        {"zh": "我开始长出来了", "en": "I begin to grow out."},
        {"zh": "火光照在我身上，很舒服", "en": "Firelight on me is pleasant."},
        {"zh": "我慢慢张开第一条缝", "en": "I open my first seam slowly."},
        {"zh": "这地方的血味够浓", "en": "The smell of blood here is strong enough."},
        {"zh": "我从灰烬里冒出来", "en": "I rise out of the ash."},
        {"zh": "我的边缘伸展开", "en": "My edges spread out."},
        {"zh": "我在这儿等着就行", "en": "I only need to wait here."},
        {"zh": "下界总是这么暖", "en": "The Nether is always this warm."},
        {"zh": "我压住了几块骨头", "en": "I settle over some bones."},
        {"zh": "我又要多长一层了", "en": "I will grow another layer."}
      ]
    },
