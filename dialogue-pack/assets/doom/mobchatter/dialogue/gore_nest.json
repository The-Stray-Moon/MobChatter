      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我身上，我焦了一块", "en": "Lightning scorches a patch of me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我被从地上扯了下来", "en": "I am torn off the ground."}
      ]
    }
  }
