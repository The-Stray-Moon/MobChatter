      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法攻击，好疼。", "en": "Magical hit, hurts."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没找到吃的，饿死了。", "en": "Starved to death."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "被雷劈中，好疼。", "en": "Lightning strike, hurts."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "掉入虚空，消失不见了。", "en": "Died in void."}
      ]
    }
  }
}
