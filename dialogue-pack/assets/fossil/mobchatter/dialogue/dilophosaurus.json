{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，这里是我的领地！", "en": "Hisss, this is my territory!"},
        {"zh": "小心，我是双嵴龙！", "en": "Watch out, I'm a Dilophosaurus!"},
        {"zh": "我的眼神，就是死亡预告！", "en": "My gaze is a death sentence."},
        {"zh": "看我的毒液，让你颤抖！", "en": "See my venom, make you quiver!"},
        {"zh": "我是领地之王，不容侵犯！", "en": "I'm the king of this territory, none shall trespass!"},
        {"zh": "尝尝我的呼吸吧！", "en": "Feel my breath!"},
        {"zh": "我的毒囊里有致命毒液！", "en": "My venom sacs contain deadly toxins!"},
        {"zh": "两道冠扫开灌木，我来了。", "en": "Twin crests shove the brush aside."},
        {"zh": "我的尾巴可以分尸！", "en": "My tail can dismember!"},
        {"zh": "我是双嵴龙，领地型恐龙！", "en": "I'm a Dilophosaurus, territorial dinosaur!"},
        {"zh": "双冠一抬，喉囊鼓起", "en": "Both crests lift as the throat pouch swells."},
        {"zh": "三趾踏过蕨叶丛", "en": "Three-toed feet trample the ferns."},
        {"zh": "长尾左右扫动开路", "en": "Its long tail sweeps the way clear."},
        {"zh": "沿河床巡这片领地", "en": "It patrols the riverbed claim."},
        {"zh": "嗅着地面的脚印走", "en": "It follows tracks by scent."},
        {"zh": "脊背前倾，压着草走", "en": "Leaning low, it pushes through the grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀下是自由的天空！", "en": "Under my wings lies the sky of freedom!"},
        {"zh": "在这里，我就是王者！", "en": "Here, I'm the king."},
        {"zh": "我是双嵴龙，不可侵犯！", "en": "I'm a Dilophosaurus, none shall offend!"},
        {"zh": "我的存在就是对你的警告！", "en": "My presence is a warning to you!"},
        {"zh": "我是领地的守护者！", "en": "I'm the guardian of this territory!"},
        {"zh": "我的骨骼坚韧无比！", "en": "My bones are unbreakable!"},
        {"zh": "我的存在就是事实！", "en": "My existence is a fact!"},
        {"zh": "我是双嵴龙，不可小觑！", "en": "I'm a Dilophosaurus, don't underestimate me!"},
        {"zh": "我的领地不容他人侵犯！", "en": "This territory is inviolate!"},
        {"zh": "我的每一次呼吸都是王者的宣告！", "en": "Every breath of mine is a declaration of my kingship!"},
        {"zh": "张嘴散热，牙齿反光", "en": "Mouth agape to cool, teeth catching light."},
        {"zh": "在泥里刨出半个坑", "en": "It scrapes half a nest in the mud."},
        {"zh": "两个头冠微微发红", "en": "Its twin crests flush faintly red."},
        {"zh": "歪头听着远处的响动", "en": "Head tilted toward a distant sound."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "两道头冠一低，我要冲了。", "en": "My twin crests dip. Here I come."},
        {"zh": "两道冠子对着你，不带好意。", "en": "Both crests face you, nothing kind in them."},
        {"zh": "两片冠子一抖，我向前一步。", "en": "Both crests twitch; I step forward."},
        {"zh": "你动弹不得，我来了！", "en": "You can't move, I'm coming!"},
        {"zh": "猎物的味道，真好！", "en": "The scent of prey, so good!"},
        {"zh": "双冠下的眼睛没离开过你。", "en": "The eyes beneath my twin crests never leave you."},
        {"zh": "我的视野，无处不在！", "en": "My vision, everywhere!"},
        {"zh": "双嵴一抖，我盯上你了。", "en": "My twin crests twitch; you're marked."},
        {"zh": "猎物，就在眼前！", "en": "Prey, right in front of you!"},
        {"zh": "准备迎接末日吧！", "en": "Prepare for the end!"},
        {"zh": "冠子发红，是在警告", "en": "The red crests are a warning."},
        {"zh": "喉咙里滚出一声低响", "en": "A low rumble rolls in its throat."},
        {"zh": "绕了半圈，堵住退路", "en": "It circles halfway, cutting your retreat."},
        {"zh": "它在量你有多高", "en": "It is measuring your height."},
        {"zh": "你踩在了它的窝边", "en": "You are standing by its nest."},
        {"zh": "鼻息喷在你脸上", "en": "Its breath snorts into your face."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "双嵴龙受伤了，咳咳。", "en": "Dilophosaurus is hurt, cough cough."},
        {"zh": "我的鳞片受伤了。", "en": "My scales are hurt."},
        {"zh": "我跛着腿，往蕨丛里退。", "en": "Limping, I back into the ferns."},
        {"zh": "我被咬了。", "en": "I was bitten."},
        {"zh": "我的尾巴受伤了。", "en": "My tail is hurt."},
        {"zh": "我的趾爪翻了起来，好疼。", "en": "My toe claw has flipped up; it stings."},
        {"zh": "我头冠上的口子，在滴血。", "en": "The gash in my crest is bleeding."},
        {"zh": "我的骨头受伤了。", "en": "My bones are hurt."},
        {"zh": "我被雷劈了。", "en": "I was struck by lightning."},
        {"zh": "我从坡上滚下，撞了石头。", "en": "I roll down the slope and hit stone."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "闻到猎物香气，双嵴龙抬头。", "en": "Smell prey, Dilophosaurus raises head."},
        {"zh": "低吼示意，你是猎物。", "en": "Low growl, you're prey."},
        {"zh": "双嵴龙瞥见猎物，嘴角勾起。", "en": "Dilophosaurus eye prey, grin."},
        {"zh": "目光锁定，等待最佳时机。", "en": "Lock eyes, wait for chance."},
        {"zh": "捕食者靠近，猎物颤抖。", "en": "Predator near, prey shakes."},
        {"zh": "猎物惊慌，双嵴龙加速。", "en": "Prey frightened, Dilophosaurus speeds."},
        {"zh": "发出嘶嘶声，威胁靠近的猎物。", "en": "Hisses, threaten approaching prey."},
        {"zh": "猎物逃跑，双嵴龙紧追不舍。", "en": "Prey runs, Dilophosaurus chases."},
        {"zh": "爪子抓破猎物，鲜血流出。", "en": "Claws tear prey, blood flows."},
        {"zh": "吞下猎物，双嵴龙满足地打个滚。", "en": "Swallow prey, Dilophosaurus rolls contentedly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "发现入侵者，双嵴龙咆哮。", "en": "Notice intruder, Dilophosaurus roars."},
        {"zh": "冲向敌人，双嵴龙怒吼。", "en": "Charge enemy, Dilophosaurus roars."},
        {"zh": "双嵴龙猛扑，敌人踉跄后退。", "en": "Dilophosaurus lunges, enemy staggers back."},
        {"zh": "撞击敌人的同时，双嵴龙撕咬。", "en": "Butt enemy, Dilophosaurus bites."},
        {"zh": "用头撞开敌人，双嵴龙站稳脚跟。", "en": "Headbutt enemy, Dilophosaurus stands firm."},
        {"zh": "撞飞敌人，双嵴龙得意地笑。", "en": "Butt fly enemy, Dilophosaurus smirks."},
        {"zh": "敌人的攻击被双嵴龙躲开。", "en": "Enemy attack missed."},
        {"zh": "双嵴龙用背部顶开敌人。", "en": "Dilophosaurus pushes with back."},
        {"zh": "双嵴龙一击撞倒敌人，倒地呻吟。", "en": "Dilophosaurus topples enemy, groaning."},
        {"zh": "双嵴龙倒地，挣扎着起身。", "en": "Dilophosaurus falls, struggles up."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到伴侣，双嵴龙低吟。", "en": "Find mate, Dilophosaurus hums."},
        {"zh": "用身体接触，双嵴龙吸引配偶。", "en": "Touch body, attract mate."},
        {"zh": "双嵴龙用尾部轻触对方。", "en": "Dilophosaurus tail touches gently."},
        {"zh": "互相嗅探，确认彼此身份。", "en": "Sniff each other, confirm identity."},
        {"zh": "交配时，双嵴龙轻盈跃起。", "en": "Mate, Dilophosaurus leaps."},
        {"zh": "交配后，双嵴龙梳理羽毛。", "en": "Mate, Dilophosaurus preens."},
        {"zh": "找到伴侣，双嵴龙兴奋跳跃。", "en": "Mate found, Dilophosaurus jumps."},
        {"zh": "双嵴龙互相梳理羽毛，亲密无间。", "en": "Mate preen, intimate."},
        {"zh": "双嵴龙在地面上摩擦身体。", "en": "Mate, rub body on ground."},
        {"zh": "双嵴龙互相凝视，彼此确认。", "en": "Mate, look into each other's eyes."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，这是我的地盘！", "en": "Hisss, this is my territory!"},
        {"zh": "我守着巢，爪子刨着土。", "en": "I guard the nest, claws scraping soil."},
        {"zh": "尝尝我的厉害吧！", "en": "Feel my power!"},
        {"zh": "地上这块肉，归我的领地了。", "en": "That meat on the ground belongs to my territory."},
        {"zh": "驯服我，我愿意为你效劳！", "en": "Tame me, I'll serve you!"},
        {"zh": "滚开，这不是你的领地！", "en": "Get out, this isn't your territory!"},
        {"zh": "别碰我的食物！", "en": "Don't touch my food!"},
        {"zh": "快给我让路！", "en": "Move for me!"},
        {"zh": "这块肉掉在我的地界里。", "en": "This meat fell inside my territory."},
        {"zh": "这是我的领地，你懂的！", "en": "This is my territory, you know!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "双冠一抬，我看到你了。", "en": "My twin crests lift — I see you."},
        {"zh": "领地边上，你站错了地方。", "en": "Wrong spot at the edge of my territory."},
        {"zh": "你踏进了我刨过的土圈。", "en": "You've stepped inside the ring I clawed in the dirt."},
        {"zh": "吃掉我这个领地，你敢。", "en": "Eating my territory, you dare."},
        {"zh": "准备迎接死亡吧", "en": "Prepare to die! — 双嵴龙, target acquire"},
        {"zh": "这片蕨林的气味都归我。", "en": "Every scent in this fern wood is mine."},
        {"zh": "双嵴竖起，你进了领地。", "en": "Both crests up — you're on my ground."},
        {"zh": "你躲到树后，我也看得见。", "en": "Hide behind the tree; I still see you."},
        {"zh": "我已经盯上你很久了！", "en": "I've been watching you for a while!"},
        {"zh": "你的死期到了！", "en": "Your time is up!"},
        {"zh": "你进了我的地界", "en": "You have entered my ground."},
        {"zh": "蹄声太吵，就是你了", "en": "Your steps are loud; you'll do."},
        {"zh": "这一带只许我捕猎", "en": "Only I hunt this stretch."},
        {"zh": "腿先断，肉再分", "en": "Legs first, then the meat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的喉咙开始鼓起来。", "en": "My throat begins to swell."},
        {"zh": "我会把你吃掉！", "en": "I'll eat you!"},
        {"zh": "我侧过身，绕到你的右边。", "en": "I turn side-on and circle to your right."},
        {"zh": "你逃不出我的爪子！", "en": "You can't escape my claws!"},
        {"zh": "这是我的地界，退到树线外。", "en": "This is my ground, back off past the trees."},
        {"zh": "我的头冠，先吓你一跳。", "en": "My crest will startle you first."},
        {"zh": "我会吃了你！", "en": "I'll eat you!"},
        {"zh": "躲开我的毒气！", "en": "Avoid my venom!"},
        {"zh": "我的双冠一立，你的命就归我。", "en": "My twin crests rise, and your fate is mine."},
        {"zh": "我来展示我的实力！", "en": "I'll show you my strength!"},
        {"zh": "先咬腿，再咬脖子", "en": "Legs first, then the neck."},
        {"zh": "侧身绕，找你要害", "en": "It sidles around for a weak point."},
        {"zh": "喉咙鼓动，蓄着力", "en": "Its throat swells, gathering force."},
        {"zh": "尾尖绷紧，要甩了", "en": "Its tail tip tightens to swing."},
        {"zh": "压低身子，准备起跳", "en": "It crouches low, ready to spring."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
