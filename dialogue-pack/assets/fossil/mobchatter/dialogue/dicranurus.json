{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轻轻爬行，壳声脆响。", "en": "Crawl gently, shell clinks."},
        {"zh": "三叶草中，慢慢移动。", "en": "Move slowly among clover."},
        {"zh": "寻找食物，树叶虫子。", "en": "Seek food, leaf and insect."},
        {"zh": "避开敌人，快速移动。", "en": "Avoid enemies, move fast."},
        {"zh": "阳光下，缓慢前行。", "en": "Crawl slowly in the sun."},
        {"zh": "树叶间，悠闲游荡。", "en": "Roam among the leaves."},
        {"zh": "草丛中，轻轻爬过。", "en": "Crawl softly in the grass."},
        {"zh": "寻找同伴，共度一生。", "en": "Seek companions, share life."},
        {"zh": "夏日午后，悠闲漫步。", "en": "Walk leisurely in the afternoon sun."},
        {"zh": "树叶落下，安全移动。", "en": "Move safely with falling leaves."},
        {"zh": "十几条细足一齐拨动。", "en": "A dozen thin legs paddle all at once."},
        {"zh": "背甲一节一节地拱起。", "en": "Its back shell arches segment by segment."},
        {"zh": "沿着岩缝慢慢爬过去。", "en": "It creeps along the rock seam."},
        {"zh": "触角先探，身子才跟上。", "en": "Feelers probe first; the body follows."},
        {"zh": "它爬过一块潮湿的石头。", "en": "It crawls over a damp stone."},
        {"zh": "尾刺在沙上拖出浅痕。", "en": "Its tail spine drags a faint line in the sand."},
        {"zh": "泥地里留下弯弯的小路。", "en": "A winding little trail is left in the mud."},
        {"zh": "它绕开苔藓，走向阴处。", "en": "It skirts the moss and heads for shade."},
        {"zh": "壳缘刮着碎石，咯吱响。", "en": "Its shell edge grates over gravel."},
        {"zh": "一步一顿，像在量地。", "en": "It halts at each step, as if measuring the ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静躺卧，享受阳光。", "en": "Rest quietly, bask in sun."},
        {"zh": "等待同伴，共栖一地。", "en": "Wait for companions, share habitat."},
        {"zh": "静静不动，等待机会。", "en": "Stay still, wait for opportunity."},
        {"zh": "悠闲自得，享受生活。", "en": "Relax, enjoy life."},
        {"zh": "夏日午后，懒懒睡去。", "en": "Nap in the afternoon sun."},
        {"zh": "静静躺下，保护自己。", "en": "Lie quietly, protect yourself."},
        {"zh": "等待雨露，滋润身体。", "en": "Wait for rain, moisturize."},
        {"zh": "静静观察，环境安全。", "en": "Observe quietly, check safety."},
        {"zh": "夏日悠闲，享受宁静。", "en": "Enjoy the quiet in summer."},
        {"zh": "等待时机，小心行动。", "en": "Wait for the right moment, act carefully."},
        {"zh": "它把身子蜷成一块石头。", "en": "It curls up to look like a stone."},
        {"zh": "触角慢慢摆，探着风向。", "en": "Its feelers sway, testing the wind."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "发现玩家，小心避开。", "en": "Notice player, move away."},
        {"zh": "警惕玩家，小心应对。", "en": "Be wary of the player, react carefully."},
        {"zh": "发现玩家，快速逃跑。", "en": "Spot the player, run away."},
        {"zh": "玩家来了，小心应对。", "en": "Player approaches, be cautious."},
        {"zh": "玩家出现，迅速躲藏。", "en": "Player appears, hide quickly."},
        {"zh": "注意玩家，保持警惕。", "en": "Be aware of the player, stay alert."},
        {"zh": "玩家靠近，迅速躲避。", "en": "Player near, dodge quickly."},
        {"zh": "玩家来了，赶紧逃跑。", "en": "Player here, run away."},
        {"zh": "玩家来了，尽量避开。", "en": "Avoid the player."},
        {"zh": "玩家来了，迅速隐匿。", "en": "Hide quickly from the player."},
        {"zh": "它抬头，用触角碰了碰你。", "en": "It looks up and taps you with a feeler."},
        {"zh": "小小的黑眼停在你鞋尖。", "en": "Its small black eye rests on your boot tip."}
      ]
