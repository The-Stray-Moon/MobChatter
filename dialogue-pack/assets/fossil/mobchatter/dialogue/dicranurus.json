    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳破肉绽，好疼！", "en": "Shell cracked, ouch!"},
        {"zh": "翅膀受损，飞不快。", "en": "Wings hurt, can't fly fast."},
        {"zh": "触角断了，找不着路。", "en": "Antennas broken, lost my way."},
        {"zh": "我卷起身子，把软肉藏好。", "en": "I curl up and tuck my soft flesh away."},
        {"zh": "伤口流血，快治治。", "en": "Blood flows, need help."},
        {"zh": "触须断了，看不清东西。", "en": "Feelings gone, can't see."},
        {"zh": "我受伤了，需要帮助！", "en": "Injured, need help!"},
        {"zh": "身体疼，走不动了。", "en": "Aching, can't move."},
        {"zh": "触角受伤，找不见东西。", "en": "Antennae hurt, can't see."},
        {"zh": "我受伤了，需要休息。", "en": "Injured, need rest."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "三叶虫卷成球，别戳我。", "en": "Trilobite curled into a ball — don't poke me."},
        {"zh": "别靠近我，小心被吓到！", "en": "Stay away, or you’ll be scared!"},
        {"zh": "你闻到了吗？食物的味道！", "en": "Can you smell it? The food!"},
        {"zh": "这里的食物很丰富哦！", "en": "The food here is abundant!"},
        {"zh": "我的肉质鲜美，尝尝吧！", "en": "My meat is delicious, try it!"},
        {"zh": "我可不是你的猎物！", "en": "I’m not your prey!"},
        {"zh": "别靠近，小心触角！", "en": "Stay back, watch out for my antennae!"},
        {"zh": "这里是我的领地，小心点！", "en": "This is my territory, be careful!"},
        {"zh": "我用我的触角探索！", "en": "I use my antennae to explore!"},
        {"zh": "我的触角可以感知食物！", "en": "My antennae can sense food!"},
        {"zh": "印记一按，它就不走了。", "en": "One imprint, and it stops wandering."},
        {"zh": "它记住了你的手心的味道。", "en": "It remembers the smell of your palm."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，我触角刺痛你！", "en": "Be careful, my antennae will sting!"},
        {"zh": "别撞我，会疼的！", "en": "Don’t bump into me, it hurts!"},
        {"zh": "三叶虫也会被踩到。", "en": "Even trilobites get stepped on."},
        {"zh": "三叶虫的甲壳硬得很。", "en": "A trilobite's shell is hard."},
        {"zh": "我用触角进行交流！", "en": "I use my antennae to communicate!"},
        {"zh": "我的触角比你想象的坚硬！", "en": "My antennae are harder than you think!"},
        {"zh": "小心我的触角碰撞！", "en": "Be careful of my antennae collision!"},
        {"zh": "我的触角可以感知危险！", "en": "My antennae can sense danger!"},
        {"zh": "用触角碰碰我吧！", "en": "Give my antennae a touch!"},
        {"zh": "我用触角触碰你！", "en": "I’ll use my antennae to touch you!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到伴侣了，好幸福！", "en": "Found a mate, so happy!"},
        {"zh": "我的配偶，快过来！", "en": "My mate, come over!"},
        {"zh": "求偶成功，我要繁殖！", "en": "Mate success, I’ll reproduce!"},
        {"zh": "找一个配偶吧！", "en": "Find a mate!"},
        {"zh": "我把卵埋进沙里，盖好。", "en": "I bury the eggs in sand and cover them."},
        {"zh": "让我们共度一生！", "en": "Let’s spend a lifetime together!"},
        {"zh": "我用尾刺轻碰同类的壳。", "en": "I tap a kindred shell with my tail spine."},
        {"zh": "我的后代将会更强壮！", "en": "My offspring will be stronger!"},
        {"zh": "找一个伴侣，开始新生命！", "en": "Find a partner, start a new life!"},
        {"zh": "我的后代将会更聪明！", "en": "My offspring will be smarter!"}
      ]
    },
