{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "扇动双翼向前飞去。", "en": "Flap wings and fly forward."},
        {"zh": "缓慢地扇动着翅膀。", "en": "Gently flap its wings."},
        {"zh": "翼膜鼓着风，我滑过树梢。", "en": "My wing membrane fills with wind over the treetops."},
        {"zh": "用小爪子轻触地面。", "en": "Tiptoe on the ground."},
        {"zh": "在空中旋转一圈。", "en": "Spin in the air."},
        {"zh": "低空飞行掠过你身边。", "en": "Fly low past you."},
        {"zh": "从一侧滑向另一侧。", "en": "Slip from side to side."},
        {"zh": "用翅膀拍打着风声。", "en": "Create a breeze with its wings."},
        {"zh": "轻轻拍打翅膀起飞。", "en": "Take off by flapping wings."},
        {"zh": "在草地上轻盈飞翔。", "en": "Fly lightly over the grass."},
        {"zh": "借着上升气流盘旋。", "en": "I circle on the rising air."},
        {"zh": "双翼掠过低矮的蕨类。", "en": "My wings skim the low ferns."},
        {"zh": "今天风好，我多飞一圈。", "en": "Good wind today. One more lap."},
        {"zh": "我的影子扫过水面。", "en": "My shadow slides over the water."},
        {"zh": "尾巴在半空稳住方向。", "en": "My tail steadies me midair."},
        {"zh": "一小段一小段地滑翔。", "en": "I glide a short stretch at a time."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静地停在石缝间。", "en": "Perched in a crevice."},
        {"zh": "低垂着脑袋思考。", "en": "Head hung in thought."},
        {"zh": "我把喙埋进翅膀下。", "en": "I tuck my beak under my wing."},
        {"zh": "静静地栖息在树上。", "en": "Rest quietly in a tree."},
        {"zh": "轻轻地扇动着翅膀。", "en": "Gently flapping wings."},
        {"zh": "发出轻微的喉音。", "en": "Make a soft throat sound."},
        {"zh": "张开嘴巴打个哈欠。", "en": "Yawn widely."},
        {"zh": "我收起翼膜，缩成一团。", "en": "I fold my wing membrane and shrink into a ball."},
        {"zh": "我用爪子刮着树皮的缝。", "en": "I scrape the seams of the bark with a claw."},
        {"zh": "静静地享受着阳光。", "en": "Enjoy the sun's warmth."},
        {"zh": "我用喙梳理翼膜。", "en": "I comb my wing membrane with my beak."},
        {"zh": "挂在枝头打个盹。", "en": "I doze hanging from a branch."},
        {"zh": "我歪头听树下的动静。", "en": "I tilt my head at the noise below."},
        {"zh": "爪子抓牢树皮等风。", "en": "I grip the bark and wait for wind."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "用锐利的眼神盯着你。", "en": "Sharp eyes fixed on you."},
        {"zh": "目光炯炯地盯着你。", "en": "Sharp gaze on you."},
        {"zh": "我看你的手指，也看你的脸。", "en": "I look at your fingers, then your face."},
        {"zh": "用翅膀遮住眼睛。", "en": "Cover eyes with wings."},
        {"zh": "用眼睛追踪你的移动。", "en": "Track your movement with eyes."},
        {"zh": "发出轻微的警告声。", "en": "Make a soft warning sound."},
        {"zh": "我的翼指收紧了树枝。", "en": "My wing finger tightens on the branch."},
        {"zh": "用尾巴轻扫地面。", "en": "Tail sweep the ground."},
        {"zh": "发出轻微的嘶嘶声。", "en": "Make a soft hissing sound."},
        {"zh": "用翅膀扇风示警。", "en": "Fan with wings as a warning."},
        {"zh": "我翅膀上的花纹吓退过猎手。", "en": "The pattern on my wings has scared off hunters."},
        {"zh": "我落在你肩上看看。", "en": "I land on your shoulder to look."},
        {"zh": "你不像石头，会动。", "en": "You move. Unlike the stones."},
        {"zh": "我侧头打量你的帽子。", "en": "I tilt my head at your hat."},
        {"zh": "你的气味很陌生。", "en": "Your scent is unfamiliar."},
        {"zh": "我轻轻叫了一声试探。", "en": "I test you with a soft call."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我这小翅膀，经不起第二下。", "en": "These small wings won't take another hit."},
        {"zh": "飞不起来了...", "en": "Can't fly..."},
        {"zh": "翅膀破了...", "en": "Wing broken..."},
        {"zh": "我的骨头被这一下打疼。", "en": "That blow left my bones aching."},
        {"zh": "我受累了...", "en": "Feeling tired..."},
        {"zh": "翅膀太薄，撑不住了。", "en": "My wings are too thin — I can't hold on."},
        {"zh": "我的翼骨很细，别用力。", "en": "My wing bones are thin. Easy."},
        {"zh": "好痛苦...", "en": "So painful..."},
        {"zh": "翼膜破了个口子。", "en": "There is a tear in my wing."},
        {"zh": "骨头好疼，别碰。", "en": "My bones ache. Don't touch."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "软软的翅膀让我飘扬起来。", "en": "Soft wings make me float."},
        {"zh": "你的食物诱惑我靠近你。", "en": "Your food tempts me closer."},
        {"zh": "我用叫声吸引你的注意。", "en": "My call catches your attention."},
        {"zh": "这块肉，我拿翅膀罩住。", "en": "I cover this meat with my wing."},
        {"zh": "我享受着温暖的阳光。", "en": "I bask in the warm sun."},
        {"zh": "我飞向那片草地觅食。", "en": "I fly to the grass for food."},
        {"zh": "我用牙齿轻轻咀嚼。", "en": "I nibble gently with my teeth."},
        {"zh": "我被你的食物吸引过来。", "en": "Your food attracts me."},
        {"zh": "我轻盈地掠过草地。", "en": "I glide over the grass."},
        {"zh": "我以昆虫为食。", "en": "Insects are my food."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀撞上了岩石。", "en": "My wings hit the rock."},
        {"zh": "我撞上了树干。", "en": "I hit the tree trunk."},
        {"zh": "我试图避开障碍。", "en": "I avoid the obstacle."},
        {"zh": "碰撞让我改变方向。", "en": "Collisions change my path."},
        {"zh": "我迅速避开危险。", "en": "I quickly avoid danger."},
        {"zh": "我用尾巴避开撞击。", "en": "I swerve with my tail."},
        {"zh": "我被风吹向岩石。", "en": "I am blown towards the rock."},
        {"zh": "我险些撞上树枝。", "en": "I nearly hit a branch."},
        {"zh": "我轻巧地避开岩石。", "en": "I nimbly avoid the rock."},
        {"zh": "我用翅膀避开撞击。", "en": "I dodge with my wings."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我用叫声呼唤伴侣。", "en": "I call for a mate."},
        {"zh": "我飞向我的伴侣。", "en": "I fly to my mate."},
        {"zh": "我的叫声引来了伴侣。", "en": "My call brings a mate."},
        {"zh": "我用翅膀轻抚伴侣。", "en": "I gently stroke my mate with my wings."},
        {"zh": "我和伴侣一起飞翔。", "en": "I fly with my partner."},
        {"zh": "我们共享温暖的阳光。", "en": "We bask in the sun together."},
        {"zh": "我的叫声充满爱意。", "en": "My call is full of love."},
        {"zh": "两排牙，一小片翅膀，够了。", "en": "Two rows of teeth and one small wing — that's enough."},
        {"zh": "我用声音吸引伴侣。", "en": "I attract my mate with sound."},
        {"zh": "我与伴侣亲密地飞翔。", "en": "I fly intimately with my mate."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "轻盈的翅膀掠过我的手心。", "en": "Light wings flutter over my hand."},
        {"zh": "我感受到它的温暖与柔软。", "en": "I feel its warmth and softness."},
        {"zh": "它好奇地靠近我的手指。", "en": "It approaches my fingers curiously."},
        {"zh": "牙齿轻触我的掌心。", "en": "Its teeth touch my palm gently."},
        {"zh": "它似乎很满意这个位置。", "en": "It seems content with this spot."},
        {"zh": "翅膀下是它的秘密武器。", "en": "Its secret weapon is under its wings."},
        {"zh": "它的叫声如同微风拂过。", "en": "Its call is like a gentle breeze."},
        {"zh": "我抚摸着它的鳞片。", "en": "I stroke its scales."},
        {"zh": "它安静地依偎在我的手边。", "en": "It snuggles close to my hand."},
        {"zh": "我感受到它的体温。", "en": "I feel its warmth."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的小牙对准了你的脚踝。", "en": "My little teeth aim at your ankle."},
        {"zh": "我注视着猎物的动向。", "en": "I watch the prey's movements."},
        {"zh": "饥饿的牙齿等待机会。", "en": "Hungry teeth wait for an opportunity."},
        {"zh": "翅膀展开，准备捕猎。", "en": "Wings spread, ready to hunt."},
        {"zh": "目光锐利，寻找可食之物。", "en": "Sharp eyes searching for prey."},
        {"zh": "它低飞以锁定目标。", "en": "It flies low to lock on."},
        {"zh": "我瞄准了猎物的心脏。", "en": "I target its heart."},
        {"zh": "翅膀下的力量让我飞得更低。", "en": "Wing strength allows a lower flight."},
        {"zh": "它等待时机以扑击猎物。", "en": "It waits for an opportunity to pounce."},
        {"zh": "我锁定了草丛里那点动静。", "en": "I lock onto the small stir in the grass."},
        {"zh": "虫子钻进草里了。", "en": "The bug slipped into the grass."},
        {"zh": "那只蜻蜓飞过来了。", "en": "That dragonfly is coming over."},
        {"zh": "我压低身子准备俯冲。", "en": "I crouch, ready to dive."},
        {"zh": "它停在叶尖，机会来了。", "en": "It rests on a leaf tip. Now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "幼体发出微弱的叫声。", "en": "The young发出微弱的叫声."},
        {"zh": "我用印记标记它。", "en": "I mark it with a symbol."},
        {"zh": "它开始接近我的标记。", "en": "It approaches my mark."},
        {"zh": "幼体似乎认出了我。", "en": "The young recognizes me."},
        {"zh": "我轻声呼唤它。", "en": "I call to it softly."},
        {"zh": "它开始靠近我。", "en": "It approaches me."},
        {"zh": "幼体对印记做出反应。", "en": "The young responds to the mark."},
        {"zh": "我用印记安抚它。", "en": "I soothe it with the mark."},
        {"zh": "幼体对我变得温和。", "en": "The young becomes gentle with me."},
        {"zh": "它开始信任我了。", "en": "It starts to trust me."},
        {"zh": "翅膀收拢，俯冲开始。", "en": "Wings folded. The dive begins."},
        {"zh": "喙尖对准那只虫。", "en": "My beak points at that bug."},
        {"zh": "我这副小翅膀，只够低飞。", "en": "These small wings only carry me low."},
        {"zh": "它一飞，我就追。", "en": "The moment it flies, I follow."},
        {"zh": "这一口不会落空。", "en": "This snap will not miss."}
      ]
    },
