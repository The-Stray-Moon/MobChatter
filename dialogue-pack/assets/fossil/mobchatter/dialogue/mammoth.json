    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "缓慢移动着庞大的身躯", "en": "Moves slowly with massive bulk"},
        {"zh": "长鼻子一卷，树就得倒。", "en": "One curl of my trunk and the tree comes down."},
        {"zh": "鼻中发出低沉的呼噜声", "en": "Releases a low rumble from its nose"},
        {"zh": "踏着古老的步伐前行", "en": "Treads ancient steps forward"},
        {"zh": "粗壮的腿支撑着沉重的身体", "en": "Strong legs support heavy body"},
        {"zh": "咀嚼着地上的青草", "en": "Chews on grass at its feet"},
        {"zh": "用长鼻子轻轻触碰玩家", "en": "Taps player gently with its trunk"},
        {"zh": "鼻孔喷出温热的空气", "en": "Releases warm breath from nostrils"},
        {"zh": "寻找散落的草叶", "en": "Searches for scattered grass"},
        {"zh": "用象牙小心地撬开树木", "en": "Gently prys open a tree with tusks"},
        {"zh": "它把倒下的树干用鼻子推正。", "en": "It nudges a fallen trunk upright with its trunk."},
        {"zh": "它踩过处，草被压成一片平地。", "en": "Where it treads, the grass is pressed flat."},
        {"zh": "它肩上的长毛拖到地面。", "en": "The long hair on its shoulders brushes the ground."},
        {"zh": "它绕开一棵幼苗，慢慢走。", "en": "It steers around a sapling and goes on."},
        {"zh": "它的脚掌落下，地面闷响。", "en": "Its foot lands with a muffled thud."},
        {"zh": "它把鼻子甩到背上，继续走。", "en": "It flings its trunk over its back and walks on."}
      ]
    },
