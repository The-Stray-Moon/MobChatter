{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "低吼压在喉咙里，脚步不停。", "en": "A growl stays low in my throat as I walk."},
        {"zh": "猎物在哪儿", "en": "Where is prey?"},
        {"zh": "爪子扫过地面", "en": "Claws scrape the ground"},
        {"zh": "接近猎物", "en": "Closing in on prey"},
        {"zh": "眼中闪绿光", "en": "Green eyes gleam"},
        {"zh": "低吼驱散敌人", "en": "Low growl to scare off enemies"},
        {"zh": "肌肉跃动前行", "en": "Muscles move as it walks"},
        {"zh": "锋利的牙齿闪耀", "en": "Sharp teeth glint"},
        {"zh": "警惕地迈步", "en": "Careful steps taken"},
        {"zh": "爪子触地声音", "en": "Claws touch the ground sound"},
        {"zh": "肩胛一起一伏地走", "en": "My shoulders rise and fall as I walk."},
        {"zh": "尾巴压低，贴着草尖", "en": "Tail low, brushing the tips of the grass."},
        {"zh": "绕着猎物打转", "en": "I circle the prey."},
        {"zh": "爪子收着，脚步很轻", "en": "Claws sheathed, my steps are light."},
        {"zh": "循着血味往前", "en": "I follow the smell of blood."},
        {"zh": "肚子饿了，走得更快", "en": "Hungry, I walk faster."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把前爪舔净，收起利钩。", "en": "I lick my forepaw clean and sheathe the hooks."},
        {"zh": "躺在阴凉处", "en": "Lying in the shade"},
        {"zh": "打量周围环境", "en": "Scans the surroundings"},
        {"zh": "用爪子梳理毛发", "en": "Tends to its fur"},
        {"zh": "发出轻微叫声", "en": "Makes a soft sound"},
        {"zh": "我伏在岩石上，耳朵转着。", "en": "I lie on the rock, ears turning."},
        {"zh": "伸个懒腰，獠牙先露出来。", "en": "A stretch first — out come the fangs."},
        {"zh": "目光望向远方", "en": "Stares off into the distance"},
        {"zh": "舔着嘴巴周围的毛", "en": "Licks around its mouth"},
        {"zh": "轻舔自己的脸", "en": "Gently licks its face"},
        {"zh": "打个哈欠，獠牙全露", "en": "A yawn shows every fang."},
        {"zh": "耳朵转向细微的声响", "en": "My ears turn to a faint sound."},
        {"zh": "在树皮上磨磨爪子", "en": "I sharpen my claws on the bark."},
        {"zh": "尾巴尖一下一下地摆", "en": "The tip of my tail flicks, once and again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "刃齿露出来了，正好对准你。", "en": "Sabers bared, aimed right at you."},
        {"zh": "我一步步逼近，尾巴低垂。", "en": "I close in step by step, tail hanging low."},
        {"zh": "发出警告叫声", "en": "Releases a warning growl"},
        {"zh": "张嘴露出獠牙", "en": "Shows its fangs"},
        {"zh": "试图吓跑玩家", "en": "Tries to scare off the player"},
        {"zh": "用爪子轻拍地面", "en": "Kicks the ground with a claw"},
        {"zh": "我饿的时候，连同伴都躲我。", "en": "When I'm hungry, even my kin keep away."},
        {"zh": "跃起向玩家", "en": "Leaps towards the player"},
        {"zh": "我从喉咙里挤出低吼。", "en": "I squeeze a low growl from my throat."},
        {"zh": "盯着玩家的手", "en": "Stares at the player's hand"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "锋牙断裂，疼痛难忍！", "en": "Torn fangs, agony!"},
        {"zh": "血从嘴角流出...", "en": "Blood seeps from my mouth..."},
        {"zh": "爪子受伤了...", "en": "My claws are injured..."},
        {"zh": "伤口流血不止...", "en": "The wound won't stop bleeding..."},
        {"zh": "浑身疼痛，难以动弹...", "en": "Pain everywhere, can't move..."},
        {"zh": "腿受伤了，移动困难...", "en": "Leg injured, hard to move..."},
        {"zh": "喉咙受伤，呼吸困难...", "en": "Throat injured, hard to breathe..."},
        {"zh": "翅膀受了伤，飞不起来了...", "en": "Wings injured, can't fly..."},
        {"zh": "尾巴受了伤，难以保持平衡...", "en": "Tail injured, hard to balance..."},
        {"zh": "全身麻木，感觉不到疼痛...", "en": "Entire body numb, no pain..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到了鲜肉的香味！", "en": "Fresh meat, mine!"},
        {"zh": "我不再饥饿了，但还是想吃！", "en": "Not hungry, but still want to eat!"},
        {"zh": "我的牙齿渴望捕猎！", "en": "My teeth crave the hunt!"},
        {"zh": "这片猎物的气味真诱人！", "en": "Such a tempting scent!"},
        {"zh": "我的爪子在寻找猎物！", "en": "My claws seek prey!"},
        {"zh": "这肉真肥美！", "en": "Such juicy flesh!"},
        {"zh": "我必须吃更多！", "en": "I must eat more!"},
        {"zh": "这食物让我力量倍增！", "en": "This food gives me strength!"},
        {"zh": "饿了的剑齿最想要你。", "en": "A hungry saber wants you most."},
        {"zh": "我的利齿准备进食！", "en": "My sharp teeth ready for a meal!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的入侵激怒了我！", "en": "Your intrusion angers me!"},
        {"zh": "我们来比试一番！", "en": "Let's spar!"},
        {"zh": "剑齿擦过你的肩。", "en": "My sabers graze your shoulder."},
        {"zh": "爪子划开你的衣角，我还不退。", "en": "My claws tear your hem; I do not back off."},
        {"zh": "我的肩撞开你，你退了两步。", "en": "My shoulder knocks you back two steps."},
        {"zh": "我要用爪子把你撕碎！", "en": "I'll tear you apart!"},
        {"zh": "我不会被你打败！", "en": "I won't be defeated!"},
        {"zh": "我这副牙，专门咬脖子。", "en": "These fangs are made for throats."},
        {"zh": "我一巴掌拍在你膝弯上。", "en": "One swipe of my paw catches your knee."},
        {"zh": "我们来一场战斗吧！", "en": "Let's fight!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我用脸颊蹭她的颈侧。", "en": "I rub my cheek along her neck."},
        {"zh": "我找到了理想的伴侣！", "en": "I've found my perfect mate!"},
        {"zh": "我的长牙只对威胁露出来。", "en": "My long fangs show only at threats."},
        {"zh": "让我的爪子和牙齿见证！", "en": "Let my claws and teeth witness!"},
        {"zh": "我会为我的伴侣战斗！", "en": "I'll fight for my mate!"},
        {"zh": "我的伴侣是我生命的一部分！", "en": "My mate is a part of my life!"},
        {"zh": "我会保卫我的领土和伴侣！", "en": "I'll defend my territory and mate!"},
        {"zh": "我会确保我的后代生存！", "en": "I'll ensure my offspring's survival!"},
        {"zh": "我会用我的力量来保护她！", "en": "I'll protect her with my strength!"},
        {"zh": "我会为她而战斗！", "en": "I'll fight for her!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "吼！找到你了！", "en": "Roar! Got you!"},
        {"zh": "这两颗长牙，不是摆设。", "en": "These two long fangs aren't decoration."},
        {"zh": "我的牙齿生来就是为了撕裂你的肉！", "en": "My teeth are for tearing your flesh!"},
        {"zh": "你逃不掉的，小家伙！", "en": "You can't escape, little one!"},
        {"zh": "享受你最后一刻吧！", "en": "Enjoy your last moment!"},
        {"zh": "我的爪子会把你抓成碎片！", "en": "My claws will shred you!"},
        {"zh": "你躲不开我的捕食！", "en": "You can't escape my hunt!"},
        {"zh": "这獠牙叼回来一块肉。", "en": "My fangs brought back meat."},
        {"zh": "你无法抵御我的力量！", "en": "You can't resist my strength!"},
        {"zh": "你的肉很美味，小家伙。", "en": "Your meat is delicious, little one."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你跑起来，也追不过我。", "en": "Even running, you cannot outpace me."},
        {"zh": "两把短剑般的牙对准了你。", "en": "My two blade-like fangs swing onto you."},
        {"zh": "终于等到你了！", "en": "Finally, I have you!"},
        {"zh": "这是我的猎物！", "en": "This is my prey!"},
        {"zh": "猎物即将落入我口！", "en": "The prey is mine!"},
        {"zh": "猎杀目标锁定！", "en": "Target locked!"},
        {"zh": "等待我的攻击！", "en": "My attack is coming!"},
        {"zh": "猎物已被锁定！", "en": "Target locked!"},
        {"zh": "现在就是收获的时候！", "en": "Now is the time to hunt!"},
        {"zh": "那股味道，是活的", "en": "That smell, it is alive."},
        {"zh": "长牙露出来，你跑不掉了。", "en": "Sabers out — you're not getting away."},
        {"zh": "先压低身子靠近", "en": "I drop low and move in."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "这两颗长牙不是摆设。", "en": "These two long fangs aren't decoration."},
        {"zh": "再近两步，我就扑上来了。", "en": "Two steps closer, and I spring."},
        {"zh": "我盯住你的颈侧，不动声色。", "en": "I fix on the side of your neck without a sound."},
        {"zh": "我绕到侧面，找你的喉咙。", "en": "I circle to your flank, seeking your throat."},
        {"zh": "草叶一响，你就暴露了。", "en": "One rustle of grass gives you away."},
        {"zh": "我的利爪将终结你！", "en": "My claws will end you!"},
        {"zh": "品尝我的利爪吧！", "en": "Taste my claws!"},
        {"zh": "享受我的捕食吧！", "en": "Enjoy my hunt!"},
        {"zh": "我来享受这盛宴！", "en": "I'm going to enjoy this feast!"},
        {"zh": "我的爪子会留下痕迹！", "en": "My claws will leave a mark!"},
        {"zh": "后腿蓄力，随时扑", "en": "Hind legs loaded, ready to spring."},
        {"zh": "等它低头喝水", "en": "Wait until it lowers its head to drink."},
        {"zh": "距离一近就起跳", "en": "The moment it is close, I leap."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶吼着扑向猎物。", "en": "Roars and lunges at prey."},
        {"zh": "锋利的爪子划破空气。", "en": "Sharp claws slice through the air."},
        {"zh": "咆哮着撕裂猎物的皮毛。", "en": "Roars and rips the prey's fur."},
        {"zh": "一击致命，獠牙闪现。", "en": "Deadly strike, fangs glint."},
        {"zh": "用巨大的力量摔翻对手。", "en": "Fells opponents with immense force."},
        {"zh": "发出怒吼，准备战斗。", "en": "Rumbles in anger, ready to fight."},
        {"zh": "利爪撕裂敌人的肉。", "en": "Claws tear at the enemy's flesh."},
        {"zh": "迅猛扑向猎物。", "en": "Rushes towards prey."},
        {"zh": "用獠牙攻击，尖锐无比。", "en": "Lobs fangs, razor-sharp."},
        {"zh": "迅猛扑击，一击必杀。", "en": "Rushes, lethal strike."},
        {"zh": "前爪扣住，獠牙落下！", "en": "Forepaws hook in, fangs come down!"},
        {"zh": "一口咬住喉咙不松！", "en": "I lock my teeth on the throat!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "在史前洞穴中醒来。", "en": "Awakens in prehistoric caves."},
        {"zh": "追逐猎物，进入夜幕。", "en": "Chases prey into the night."},
        {"zh": "从岩层中缓缓现身。", "en": "Emerges slowly from the rock."},
        {"zh": "在黑暗中潜行寻找猎物。", "en": "Crawls in darkness, seeking prey."},
        {"zh": "在岩壁旁等待机会。", "en": "Lurks by the rock walls."},
        {"zh": "寻找阴暗的洞穴栖身。", "en": "Hunts for dark caves to rest in."},
        {"zh": "在旧兽骨间徘徊。", "en": "Wanders among old bones."},
        {"zh": "在夜间悄悄出没。", "en": "Creeps out at night."},
        {"zh": "在古老森林中穿梭。", "en": "Travels through ancient forests."},
        {"zh": "在密林深处窥伺。", "en": "Snoops in the deep woods."},
        {"zh": "灌木后露出一双绿眼", "en": "A pair of green eyes shows behind the bush."},
        {"zh": "我从石缝里踱出来", "en": "I pace out of a gap in the rocks."},
        {"zh": "草丛伏低，尾巴先动", "en": "Low in the grass, my tail moves first."},
        {"zh": "这片林子有了新主人", "en": "This wood has a new master."}
      ]
    },
