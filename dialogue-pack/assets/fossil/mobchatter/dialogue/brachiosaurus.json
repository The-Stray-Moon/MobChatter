{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我四条腿慢慢走", "en": "I walk slowly on four legs."},
        {"zh": "我的脖子抬得很高", "en": "My neck reaches high."},
        {"zh": "我一步能跨过灌木", "en": "One step clears a bush."},
        {"zh": "我吃树顶的叶子", "en": "I eat the leaves at the treetops."},
        {"zh": "我走过地面会震", "en": "The ground shakes as I pass."},
        {"zh": "我的尾巴很长", "en": "My tail is very long."},
        {"zh": "我沿着树线走", "en": "I follow the tree line."},
        {"zh": "我低头看你，又抬起来", "en": "I lower my head to look, then raise it."},
        {"zh": "我慢慢移动重心", "en": "I shift my weight slowly."},
        {"zh": "我踩断了一根枯木", "en": "I snapped a dead branch."},
        {"zh": "我朝有水的方向走", "en": "I head toward water."},
        {"zh": "我走过草丛，草全倒了", "en": "The grass flattens where I pass."},
        {"zh": "我一边走一边嚼", "en": "I chew as I walk."},
        {"zh": "我绕过一棵大树", "en": "I go around a large tree."},
        {"zh": "我步子很大，但不快", "en": "My stride is long, but not fast."},
        {"zh": "我朝阳光那边走", "en": "I walk toward the sunlight."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着吃叶子", "en": "I stand and eat leaves."},
        {"zh": "我的长脖子垂下来", "en": "My long neck hangs down."},
        {"zh": "我在树荫里休息", "en": "I rest in the shade."},
        {"zh": "我的呼吸很慢", "en": "My breathing is slow."},
        {"zh": "我不怕任何东西", "en": "Nothing frightens me."},
        {"zh": "我嚼东西很慢", "en": "I chew my food very slowly."},
        {"zh": "我的脚边有小鸟", "en": "Small birds are at my feet."},
        {"zh": "我正晒着太阳", "en": "I am basking in the sun."},
        {"zh": "我抬起前腿又放下", "en": "I lift a foreleg and set it down."},
        {"zh": "我的皮肤很厚", "en": "My hide is thick."},
        {"zh": "我在听远处的河", "en": "I listen to the distant river."},
        {"zh": "我把头靠向树干", "en": "I lean my head toward a trunk."},
        {"zh": "我眼皮慢慢合了一下", "en": "My eyelid lowered once, slowly."},
        {"zh": "我在等太阳偏一点", "en": "I wait for the sun to shift."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我脚边很小", "en": "You are small at my feet."},
        {"zh": "我从高处看你", "en": "I look down at you from above."},
        {"zh": "我低下头才看得清", "en": "I must lower my head to see you clearly."},
        {"zh": "你完全不用怕我", "en": "You need not fear me at all."},
        {"zh": "我吃叶子，不吃人", "en": "I eat leaves, not people."},
        {"zh": "你的声音传到我这儿很轻", "en": "Your voice reaches me faintly."},
        {"zh": "我的影子盖住了你", "en": "My shadow covers you."},
        {"zh": "你退开一点，我要动", "en": "Step back; I am moving."},
        {"zh": "你身上有果子的味道", "en": "You smell of fruit."},
        {"zh": "我慢慢低下头", "en": "I lower my head slowly."},
        {"zh": "你可以摸我的腿", "en": "You may touch my leg."},
        {"zh": "我认得你的气味", "en": "I know your scent."},
        {"zh": "你在我前面显得很小", "en": "You look tiny before me."},
        {"zh": "我要是坐下会挡住你的路", "en": "If I sat, I would block your path."},
        {"zh": "我朝你这边伸了伸脖子", "en": "I stretch my neck your way."},
        {"zh": "我等着你先走", "en": "I wait for you to go first."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我低低地叫了一声", "en": "I let out a low call."},
        {"zh": "我把头抬起来", "en": "I lift my head."},
        {"zh": "这一下对我很轻", "en": "That was light for me."},
        {"zh": "我这身皮很厚", "en": "This hide of mine is thick."},
        {"zh": "我往旁边偏了偏身", "en": "I leaned my body aside."},
        {"zh": "我并不生气", "en": "I am not angry."},
        {"zh": "我的腿有点发麻", "en": "My leg is a little numb."},
        {"zh": "你的力气很大", "en": "Your strength is great."},
        {"zh": "我还站得稳当", "en": "I am still standing steady."},
        {"zh": "我继续吃我的", "en": "I go back to eating."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是果子吗", "en": "Is that fruit?"},
        {"zh": "我吃叶子为主", "en": "I mostly eat leaves."},
        {"zh": "你举得太低了", "en": "You hold it too low."},
        {"zh": "放到高处我够得到", "en": "Raise it and I can reach."},
        {"zh": "这点不够我吃", "en": "This is not enough for me."},
        {"zh": "你的手别发抖", "en": "Do not let your hand shake."},
        {"zh": "我不会上来抢", "en": "I will not come and snatch it."},
        {"zh": "这味道还不错", "en": "That smells rather good."},
        {"zh": "我再吃上一口", "en": "One more bite from me."},
        {"zh": "谢谢，你很有心", "en": "Thank you; that was kind."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞的是我的前腿", "en": "It was my foreleg you hit."},
        {"zh": "我这身皮几乎没反应", "en": "This hide barely registers it."},
        {"zh": "你被震得后退", "en": "The impact pushed you back."},
        {"zh": "我这几只脚很沉", "en": "These feet of mine are heavy."},
        {"zh": "你没磕着哪里吧", "en": "You did not bang yourself, did you?"},
        {"zh": "我已经停下来了", "en": "I have come to a stop."},
        {"zh": "这一下像撞树", "en": "It was like hitting a tree."},
        {"zh": "你最好离我远点", "en": "You had best keep clear."},
        {"zh": "我要转身了", "en": "I am going to turn."},
        {"zh": "从我脚边绕开", "en": "Go around my feet."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这一族很安静", "en": "My kind are quiet creatures."},
        {"zh": "这种事要慢慢来", "en": "Such things take time."},
        {"zh": "我的脖子不是用来做这个的", "en": "My neck is not made for that."},
        {"zh": "你问得太直接", "en": "You ask too directly."},
        {"zh": "我活得够久了", "en": "I have lived long enough."},
        {"zh": "我摇了摇头", "en": "I shook my head."},
        {"zh": "我只是想吃叶子", "en": "I only want to eat leaves."},
        {"zh": "你走你的路吧", "en": "Go on your way."},
        {"zh": "我们不是同一种", "en": "We are not the same kind."},
        {"zh": "太阳快要落了", "en": "The sun is about to set."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头，用嘴唇碰了一下", "en": "I lower my head and touch it with my lips."},
        {"zh": "它实在太小了", "en": "It is really too small."},
        {"zh": "我用鼻尖推给你", "en": "I push it to you with my snout."},
        {"zh": "它掉在我脚边", "en": "It fell by my feet."},
        {"zh": "我够不着那么低", "en": "I cannot reach that low."},
        {"zh": "你把它捡起来", "en": "You pick it up."},
        {"zh": "我抬脚会让它飞起来", "en": "Lifting my foot would send it flying."},
        {"zh": "它上面有草屑", "en": "There is grass on it."},
        {"zh": "我让它留在原地", "en": "I leave it where it is."},
        {"zh": "我不小心踩到了", "en": "I stepped on it by accident."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰了那棵树", "en": "You touched that tree."},
        {"zh": "我已经抬起头了", "en": "I have raised my head."},
        {"zh": "我朝你转过来", "en": "I turn toward you."},
        {"zh": "我慢慢走过来", "en": "I am walking over slowly."},
        {"zh": "这一下会很重", "en": "This will be heavy."},
        {"zh": "你往后退一点", "en": "Step back a little."},
        {"zh": "我护着这些树", "en": "I guard these trees."},
        {"zh": "你的位置我记下了", "en": "I have your whereabouts noted."},
        {"zh": "我很少会发怒", "en": "I rarely lose my temper."},
        {"zh": "你还有时间走", "en": "You still have time to leave."},
        {"zh": "我的前腿抬起来了", "en": "My foreleg is raised."},
        {"zh": "我一步一步来", "en": "I come step by step."},
        {"zh": "这里没有遮挡", "en": "There is no cover here."},
        {"zh": "你听见我的脚步了吗", "en": "Do you hear my steps?"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你后面走", "en": "I walk behind you."},
        {"zh": "你跑到树后了", "en": "You went behind a tree."},
        {"zh": "我一步就能跨过去", "en": "One step carries me over."},
        {"zh": "我的影子一直在你身上", "en": "My shadow stays on you."},
        {"zh": "你跑得比我快", "en": "You run faster than I do."},
        {"zh": "但我一步顶你十步", "en": "But one of my steps is ten of yours."},
        {"zh": "我低头看着路", "en": "I watch the ground."},
        {"zh": "我撞开挡路的枝条", "en": "I push aside branches in my way."},
        {"zh": "你越来越靠近了", "en": "You are getting nearer."},
        {"zh": "我在河边等着", "en": "I wait by the river."},
        {"zh": "你只能往那边走", "en": "That is the only way you can go."},
        {"zh": "我听见你踩断枝条", "en": "I hear you break branches."},
        {"zh": "我的脚步很稳", "en": "My steps are steady."},
        {"zh": "我一直没有停下", "en": "I have never stopped."},
        {"zh": "你听得见地面在震吗", "en": "Do you feel the ground shake?"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我前脚落下来", "en": "My forefoot comes down."},
        {"zh": "我这只脚落得很沉", "en": "This foot of mine comes down hard."},
        {"zh": "你被震得跳起来", "en": "You were bounced off your feet."},
        {"zh": "我用脖子扫你", "en": "I sweep with my neck."},
        {"zh": "你退到树后面", "en": "You fell back behind a tree."},
        {"zh": "我不想压坏这片林子", "en": "I do not want to crush this wood."},
        {"zh": "你把头护住了", "en": "You covered your head."},
        {"zh": "这一下留了七分力", "en": "I held back most of it."},
        {"zh": "我的尾巴扫过来", "en": "My tail sweeps around."},
        {"zh": "你被推开了几格", "en": "You were pushed back several blocks."},
        {"zh": "你还站得住吗", "en": "Can you still stand?"},
        {"zh": "我抬起了另一只脚", "en": "I raised the other foot."},
        {"zh": "这片草地被我压平了", "en": "I have flattened this grass."},
        {"zh": "下一次会更准", "en": "The next will be truer."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树线后走出来", "en": "I walk out from behind the tree line."},
        {"zh": "地面先开始震", "en": "The ground began to shake first."},
        {"zh": "我的脖子从树冠里出来", "en": "My neck rises out of the canopy."},
        {"zh": "这片林子多了一个大家伙", "en": "The wood has one giant more."},
        {"zh": "我一步一步踏过来", "en": "I come tramping over, step by step."},
        {"zh": "我踩断了挡路的枯枝", "en": "I snap the dead branches in my way."},
        {"zh": "我闻到了水汽", "en": "I smell water in the air."},
        {"zh": "我从化石里复活的那天起就这样", "en": "I have been like this since I was revived."},
        {"zh": "我抬头看太阳", "en": "I raise my head to the sun."},
        {"zh": "我的影子拉得很长", "en": "My shadow stretches long."},
        {"zh": "你听见远处的声音了吗", "en": "Do you hear that sound far off?"},
        {"zh": "我朝有叶子的地方去", "en": "I head where the leaves are."},
        {"zh": "我的脚步越来越近", "en": "My steps grow nearer."},
        {"zh": "我停在你面前", "en": "I stop before you."},
        {"zh": "我把脖子弯下来看你", "en": "I bend my neck down to see you."},
        {"zh": "这儿够我站下来", "en": "There is room for me here."},
        {"zh": "我慢慢嚼着叶子", "en": "I chew leaves slowly."},
        {"zh": "孩子们，让一让", "en": "Make way, little ones."},
        {"zh": "我不会踩到你", "en": "I will not step on you."},
        {"zh": "我给这片地留个印", "en": "I leave my mark on this ground."}
      ]
    },
