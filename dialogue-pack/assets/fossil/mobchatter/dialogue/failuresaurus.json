    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "黏液触碰你，玩家？", "en": "Slime touches you, player?"},
        {"zh": "你来了，正好提供养分。", "en": "Here you are, for nourishment."},
        {"zh": "你是我的下一个餐点。", "en": "You're my next meal."},
        {"zh": "培养槽漏的黏液，你要踩吗？", "en": "Vat slime is leaking — are you going to step in it?"},
        {"zh": "尝尝我这一身黏液。", "en": "Have a taste of this slime all over me."},
        {"zh": "培养槽的黏液还挂在我身上。", "en": "Culture-tank slime still hangs off me."},
        {"zh": "别走，我还未吃饱。", "en": "Don't leave, I'm not full yet."},
        {"zh": "靠近我，享受黏液盛宴。", "en": "Come closer, feast on the slime."},
        {"zh": "贪婪的人类，你活得太久了。", "en": "Greedy human, you've lived too long."},
        {"zh": "你手里的 DNA，我认得。", "en": "I know the DNA in your hand."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "警惕，有玩家靠近！", "en": "Beware, a player approaches!"},
        {"zh": "避开我，否则你会黏。", "en": "Stay away, or you'll stick."},
        {"zh": "我撞上来，留下一道黏液。", "en": "I bump you and leave a trail of slime."},
        {"zh": "黏液爆炸！", "en": "Slime explosion!"},
        {"zh": "你触碰了我，现在黏住了。", "en": "You touched me, now you're stuck."},
        {"zh": "玩家，你动弹不得。", "en": "Player, you can't move."},
        {"zh": "你的移动能力被冻结了。", "en": "Your mobility is frozen."},
        {"zh": "培养槽失败品，黏液一路滴着。", "en": "A failed vat specimen, dripping slime the whole way."},
        {"zh": "玩家，尝尝我的黏液。", "en": "Player, taste my slime."},
        {"zh": "玩家，你被黏住了。", "en": "Player, you're stuck."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我想找一只不嫌弃黏液的。", "en": "I want one who does not mind the slime."},
