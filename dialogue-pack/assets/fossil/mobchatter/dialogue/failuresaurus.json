        {"zh": "咕嘟咕嘟，享受黏液...", "en": "Bloop, enjoying the goo..."},
        {"zh": "咕噜咕噜，慢慢思考...", "en": "Bloop, thinking..."},
        {"zh": "等待时机，慢慢行动...", "en": "Wait, slowly moving..."},
        {"zh": "咕嘟咕嘟，耐心等待...", "en": "Bloop, patient..."},
        {"zh": "咕噜咕噜，消化中...", "en": "Bloop, digesting..."},
        {"zh": "咕嘟咕嘟，慢慢吸收...", "en": "Bloop, absorbing..."},
        {"zh": "咕噜咕噜，慢慢恢复...", "en": "Bloop, recovering..."}
      ]
    },
    "look_player": {
