  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "黏液拖了一路，别跟。", "en": "Slime trails behind me. Don't follow."},
        {"zh": "黏液团团，抓你！", "en": "Gloop, gotcha!"},
        {"zh": "追逐！追上你！", "en": "Chase! Catch you!"},
        {"zh": "舔舔舔，黏你一身！", "en": "Suck, suck, suck you!"},
        {"zh": "培养槽漏出来的黏液还跟着我。", "en": "Tank slime still trails behind me."},
        {"zh": "黏液粘粘，跑不掉！", "en": "Gloop, can't run!"},
        {"zh": "追你追你，黏液满地！", "en": "Chase, chase, sticky ground!"},
        {"zh": "嘶嘶嘶，小心黏液！", "en": "Sssss, watch out for goo!"},
        {"zh": "舔舔舔，粘你屁股！", "en": "Suck, suck, butt sticky!"},
        {"zh": "黏液团团，粘你脚！", "en": "Gloop, sticky feet!"},
        {"zh": "培养槽的玻璃，被我从里撞裂。", "en": "I cracked the culture tank glass from inside."},
        {"zh": "走过的地方，留一串黏液。", "en": "Where I pass, a trail of slime remains."},
        {"zh": "身体一半是肉，一半是配方。", "en": "Half of me is flesh, half is formula."},
        {"zh": "黏液拖在地上，越拉越长。", "en": "My slime drags along the floor, stretching long."}
      ]
    },
    "idle": {
