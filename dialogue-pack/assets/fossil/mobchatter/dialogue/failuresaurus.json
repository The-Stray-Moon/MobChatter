        {"zh": "连伴侣都嫌我太黏了吧。", "en": "Even a mate would find me too slimy."},
        {"zh": "与我一起，繁衍后代。", "en": "Mate with me, for offspring."},
        {"zh": "黏液里找不到回应的声音。", "en": "No answering sound comes through the slime."},
        {"zh": "同类，准备交配。", "en": "Mate, prepare to breed."},
        {"zh": "我的伴侣，让我们交配。", "en": "Mate, let's breed."},
        {"zh": "找到我的伴侣，繁衍后代。", "en": "Find my mate, for offspring."},
        {"zh": "我的伴侣，交配吧。", "en": "Mate, let's breed."},
        {"zh": "找到我的伴侣，共筑未来。", "en": "Find my mate, for the future."}
      ]
    },
