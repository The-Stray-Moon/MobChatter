{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "缓慢踱步，发出低吼。", "en": "Slow walk, deep rumble."},
        {"zh": "用鼻子轻触地面寻找食物。", "en": "Sniff the ground for food."},
        {"zh": "用蹄子轻轻刨土，寻找嫩草。", "en": "Paw at the soil for fresh grass."},
        {"zh": "甩动尾巴驱赶蚊虫。", "en": "Swish tail to shoo flies."},
        {"zh": "抬头望向远方，警惕四顾。", "en": "Look up, surveying the surroundings."},
        {"zh": "用长鼻卷起树叶。", "en": "Reach out with long nose."},
        {"zh": "漫步在广阔的草原上。", "en": "Wander the vast prairie."},
        {"zh": "低头吃草，享受宁静。", "en": "Eat grass, peaceful."},
        {"zh": "用鼻子吹走身上的灰尘。", "en": "Snort off dust."},
        {"zh": "发出低沉的警告声。", "en": "Low warning growl."},
        {"zh": "沉重的蹄声压过草地", "en": "Heavy hooves press the grass flat"},
        {"zh": "肩膀撞开半人高的灌木", "en": "My shoulder shoves through waist-high brush"},
        {"zh": "低着头，一步一步挪", "en": "Head low, one slow step at a time"},
        {"zh": "独角扫过草尖", "en": "My horn sweeps the tips of the grass"},
        {"zh": "在泥坑里打了个滚", "en": "I roll in the mud wallow"},
        {"zh": "把小犀牛护在身侧", "en": "I keep the calf against my flank"},
        {"zh": "背脊在夕阳下起伏", "en": "My back rises and falls in the sunset"},
        {"zh": "每走一步，地面微颤", "en": "The ground trembles with each step"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站立不动，盯着前方。", "en": "Stand still, eyes forward."},
        {"zh": "舔舐自己的皮毛。", "en": "Lick its own fur."},
        {"zh": "用鼻子触碰树干。", "en": "Sniff tree trunk."},
        {"zh": "磨牙，发出轻微声音。", "en": "Grind teeth, soft noise."},
        {"zh": "摇晃身体放松。", "en": "Shake body to relax."},
        {"zh": "用角轻触地面。", "en": "Tap ground with horn."},
        {"zh": "闭眼小憩片刻。", "en": "Close eyes for a nap."},
        {"zh": "舔舐耳朵。", "en": "Lick ears."},
        {"zh": "梳理自己身上的毛发。", "en": "Groom its fur."},
        {"zh": "用鼻子卷起树叶。", "en": "Pick up a leaf with nose."},
        {"zh": "站着，像一堵旧墙", "en": "Standing like an old wall"},
        {"zh": "鼻孔喷出一串白气", "en": "A string of white breath leaves my nostrils"},
        {"zh": "把独角在树干上磨", "en": "I rub my horn against the trunk"},
        {"zh": "眯着眼，尾巴轻甩", "en": "Eyes half shut, tail flicking"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "盯住玩家，露出凶光。", "en": "Stare at player, menacingly."},
        {"zh": "嗅闻玩家发出的气味。", "en": "Sniff at player's scent."},
        {"zh": "发出警告的低吼声。", "en": "Low warning growl."},
        {"zh": "我鼻息喷在草上，角朝前。", "en": "My breath fogs the grass, horn forward."},
        {"zh": "用角试探玩家。", "en": "Test player with horn."},
        {"zh": "用鼻子碰玩家。", "en": "Nudge player with nose."},
        {"zh": "发出威胁性的咆哮。", "en": "Roar menacingly."},
        {"zh": "用蹄子轻轻拍打地面。", "en": "Tap ground with hoof."},
        {"zh": "向玩家靠近。", "en": "Approach player."},
        {"zh": "发出好奇的叫声。", "en": "Make curious noise."},
        {"zh": "从草里抬起独角", "en": "I lift my horn out of the grass"},
        {"zh": "你进入了我的边界", "en": "You have crossed into my ground"},
        {"zh": "鼻子朝你喷了口气", "en": "I snort a breath at you"},
        {"zh": "我往前踏了一步", "en": "I take one step forward"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "伤口渗出褐色液体。", "en": "Browny liquid seeps from the wound."},
        {"zh": "皮肤开始流血。", "en": "Skin starts bleeding."},
        {"zh": "身上露出伤口。", "en": "Wounds are visible on its body."},
        {"zh": "伤口溢出粘稠血浆。", "en": "Thick blood oozes from the wound."},
        {"zh": "伤口不断流血。", "en": "The wound continues to bleed."},
        {"zh": "伤势越来越严重。", "en": "Wounds are worsening."},
        {"zh": "伤口愈合缓慢。", "en": "Wounds heal slowly."},
        {"zh": "角上挂着血，伤口发烫。", "en": "Blood on my horn, my wound burning."},
        {"zh": "角上多了个缺口，真疼。", "en": "A chip in my horn; that truly hurts."},
        {"zh": "伤口难以愈合。", "en": "Wound is hard to heal."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶，别靠近我的领地！", "en": "Hsss, stay away from my territory!"},
        {"zh": "咕咕咕，这是我的领地！", "en": "Grumble, this is my territory!"},
        {"zh": "咔嚓，我要享受我的食物了。", "en": "Chomp, time for my meal."},
        {"zh": "哞哞，我的头骨很值钱。", "en": "Moo, my skull is valuable."},
        {"zh": "呼噜，我在这里睡觉。", "en": "Snore, I’m sleeping here."},
        {"zh": "哞哞，我饿了。", "en": "Moo, I’m hungry."},
        {"zh": "呼，我的力量来自大地。", "en": "Huff, my power comes from the earth."},
        {"zh": "哞哞，这是我的领地，滚开！", "en": "Moo, this is my territory, get out!"},
        {"zh": "咔嚓，吃草给我力量。", "en": "Chomp, grass gives me strength."},
        {"zh": "哞哞，别碰我的幼崽！", "en": "Moo, don’t touch my calf!"},
        {"zh": "别伸手碰我的角", "en": "Don't reach for my horn"},
        {"zh": "喂我可以，别碰幼崽", "en": "Feed me if you like, but not the calf"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "轰轰，要打架吗？", "en": "Bang, want to fight?"},
        {"zh": "咔嚓，我的角比你重！", "en": "Chomp, my horn is heavier."},
        {"zh": "嘶嘶，来吧，小家伙！", "en": "Hsss, come on, little one!"},
        {"zh": "轰隆，我要教训你！", "en": "Bang, I’ll teach you a lesson!"},
        {"zh": "咔嚓，小心我的角！", "en": "Chomp, watch out for my horn!"},
        {"zh": "嘶嘶，退后，别逼我动手！", "en": "Hsss, back off, don’t逼 me!"},
        {"zh": "轰隆，这是我的领地！", "en": "Bang, this is my territory!"},
        {"zh": "咔嚓，别想伤害我的幼崽！", "en": "Chomp, don’t try to hurt my calf!"},
        {"zh": "嘶嘶，准备好战斗了吗？", "en": "Hsss, ready for battle?"},
        {"zh": "轰隆，我是领地之王！", "en": "Bang, I’m the king of the territory!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "哞哞，找我来交配吧！", "en": "Moo, come for mating."},
        {"zh": "咕咕咕，我是你的雄性伙伴。", "en": "Grumble, I’m your mate."},
        {"zh": "哞哞，跟我交配吧！", "en": "Moo, mate with me!"},
        {"zh": "哞哞，我的交配季节到了。", "en": "Moo, mating season is here."},
        {"zh": "哞哞，我的身体准备好交配了。", "en": "Moo, my body is ready for mating."},
        {"zh": "哞哞，来吧，让我们交配。", "en": "Moo, come, let’s mate."},
        {"zh": "咕咕咕，我的角证明了我的实力。", "en": "Grumble, my horn shows my strength."},
        {"zh": "哞哞，这是我的领地，交配吧！", "en": "Moo, this is my territory, mate!"},
        {"zh": "哞哞，来吧，我的伴侣。", "en": "Moo, come, my mate."},
        {"zh": "哞哞，我的交配季节很短暂。", "en": "Moo, my mating season is short."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "发出震耳低吼，展示獠牙。", "en": "Rumbles loudly, showing sharp teeth."},
        {"zh": "用鼻孔喷出一股白雾。", "en": "Sprays a puff of white mist through nostrils."},
        {"zh": "用犀角轻触地面，确认。", "en": "Taps the ground gently with its horn."},
        {"zh": "低头寻找地上的植物。", "en": "Bends down to search for vegetation."},
        {"zh": "张开巨口，咬下一片叶子。", "en": "Opens its huge mouth to bite a leaf."},
        {"zh": "用蹄子踢起尘土，警戒。", "en": "Stirs up dust with its hooves, on alert."},
        {"zh": "发出低沉的叫声，吸引幼体。", "en": "Lets out a low call to attract its young."},
        {"zh": "用鼻尖触碰地上的印记。", "en": "Touches the ground with its nose to the mark."},
        {"zh": "用舌头舔舐伤口，恢复。", "en": "Licks its wounds to aid healing."},
        {"zh": "嗅着空气中的气味，寻找。", "en": "Sniffs the air to detect something."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "突然抬起头，锁定目标。", "en": "Lifts its head suddenly, locking on to a target."},
        {"zh": "发出低沉咆哮，瞄准猎物。", "en": "Growls lowly, aiming at its prey."},
        {"zh": "眼中闪烁绿光，锁定目标。", "en": "Its eyes glow green, locking on to the target."},
        {"zh": "鼻孔张开，感受猎物气息。", "en": "Nostrils flare, scenting prey."},
        {"zh": "鼻尖指向天空，感知风向。", "en": "Nose points to the sky, sensing the wind."},
        {"zh": "耳朵竖立，集中注意。", "en": "Ears stand up, focusing attention."},
        {"zh": "张开大口，发出警告声。", "en": "Opens its mouth wide, giving a warning growl."},
        {"zh": "用蹄子在地上画出记号。", "en": "Draws marks on the ground with its hooves."},
        {"zh": "用眼神示意幼体靠近。", "en": "Signals to its young with its eyes."},
        {"zh": "发出震响，展示力量。", "en": "Rumbles loudly, showcasing its strength."},
        {"zh": "你站得太靠里了", "en": "You stand too far in"},
        {"zh": "幼崽往我身后躲", "en": "The calf ducks behind me"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "盯着目标，准备攻击。", "en": "Fixes its gaze on the target, ready to attack."},
        {"zh": "鼻尖轻触目标，确认距离。", "en": "Taps the target gently with its nose, checking the distance."},
        {"zh": "用鼻孔喷气，让幼体远离。", "en": "Sprays air through its nostrils, keeping its young away."},
        {"zh": "发出低吼，向目标示威。", "en": "Rumbles lowly, intimidating the target."},
        {"zh": "用蹄子刨地，制造障碍。", "en": "Kicks at the ground, creating obstacles."},
        {"zh": "用角轻轻触碰目标，警告。", "en": "Taps the target lightly with its horn, warning it."},
        {"zh": "发出嘶嘶声，让幼体远离危险。", "en": "Hisses to keep its young away from danger."},
        {"zh": "用牙齿咬住目标的标记。", "en": "Bites the target’s mark with its teeth."},
        {"zh": "幼体跟随其后，保持警戒。", "en": "Its young follow closely, keeping watch."},
        {"zh": "用鼻孔感知周围的动静。", "en": "Uses its nostrils to sense movements around it."},
        {"zh": "前蹄刨出两道沟", "en": "My forehooves plow two furrows"},
        {"zh": "鼻息变粗，肩背压低", "en": "My breath deepens, shoulders drop"},
        {"zh": "蹄子刨土，这就是警告。", "en": "My hoof pawing the dirt is the warning."}
      ]
    },
