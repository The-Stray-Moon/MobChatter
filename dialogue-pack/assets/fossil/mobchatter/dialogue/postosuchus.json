        {"zh": "我的体型碾过你！", "en": "My body will crush you!"},
        {"zh": "你挡不住我的脚步！", "en": "You can't stop my footsteps!"},
        {"zh": "碰撞是我的武器！", "en": "Collision is my weapon!"},
        {"zh": "你的骨头要破碎了！", "en": "Your bones will break!"},
        {"zh": "用我的力量摧毁你！", "en": "Destroy you with my power!"},
        {"zh": "我的重量会让你屈服！", "en": "My weight will make you yield!"},
        {"zh": "你挡不住我的撞击！", "en": "You can't resist my impact!"},
        {"zh": "我的肩胛撞在你腰侧，没减速。", "en": "My shoulder hits your ribs and I do not slow down."},
        {"zh": "碰撞后你将臣服！", "en": "You will submit after the collision!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找个伴侣，繁衍后代！", "en": "Find a mate, reproduce!"},
        {"zh": "吸引我的注意，我会考虑！", "en": "Attract my attention, I'll consider!"},
        {"zh": "三叠纪的脾气，我改不了。", "en": "A Triassic temper; I can't change it."},
        {"zh": "我要寻找我的另一半！", "en": "I'm looking for my mate!"},
        {"zh": "用我的魅力吸引你！", "en": "Use my charm to attract you!"},
        {"zh": "我的声音可以吸引你！", "en": "My voice can attract you!"},
        {"zh": "你的背脊花纹，我看了很久。", "en": "I have studied the pattern along your back a long while."},
        {"zh": "与我共舞，繁衍后代！", "en": "Dance with me, reproduce!"},
        {"zh": "我的声音能打动你！", "en": "My voice can move you!"},
        {"zh": "我在泥岸边留下爪印，等你来。", "en": "I leave claw marks on the mud bank for you to find."}
      ]
    },
