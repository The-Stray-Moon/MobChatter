{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，摇摆身躯前行。", "en": "Sssss, swaying to move."},
        {"zh": "张开利齿，低吼前进。", "en": "Baring teeth, growl to move."},
        {"zh": "瞪大眼睛，缓慢前行。", "en": "Wide eyes, slow move on."},
        {"zh": "肌肉跳动，脚步沉重。", "en": "Muscles twitch, heavy steps."},
        {"zh": "挥动前肢，向前推进。", "en": "Slap front limbs forward."},
        {"zh": "尾巴摇摆，保持平衡。", "en": "Tail sways, for balance."},
        {"zh": "探头观察，缓慢前行。", "en": "Peek ahead, slow move."},
        {"zh": "警惕四周，稳重行走。", "en": "Cautious, steady walk."},
        {"zh": "踏过石块，发出声响。", "en": "Step over stones, make noise."},
        {"zh": "轻拂地面，留下印记。", "en": "Brush the ground, leave mark."},
        {"zh": "前肢短小，靠后腿撑起", "en": "Short forelimbs, propped on its hind legs."},
        {"zh": "三叠纪的步态，一摇一摆", "en": "A Triassic gait, rocking side to side."},
        {"zh": "尾巴拖出一道长痕", "en": "Its tail drags a long line behind."},
        {"zh": "脚印留在了河岸泥里", "en": "Footprints pressed into the riverbank mud."},
        {"zh": "脊背耸起，沿岸巡行", "en": "Back arched, it patrols the bank."},
        {"zh": "下颌微张，边走边嗅", "en": "Jaw slightly open, sniffing as it walks."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "慵懒趴下，晒太阳。", "en": "Laze down, bask in sun."},
        {"zh": "张开双颚，晒太阳。", "en": "Open jaws, bask in sun."},
        {"zh": "闭目养神，四肢伸展。", "en": "Close eyes, stretch limbs."},
        {"zh": "趴在地上，伸展身体。", "en": "Lay down, stretch body."},
        {"zh": "微微喘息，调整呼吸。", "en": "Gasp, regulate breath."},
        {"zh": "舔舐皮肤，放松身体。", "en": "Lick skin, relax body."},
        {"zh": "低垂脑袋，轻声打呼。", "en": "Lower head, snore softly."},
        {"zh": "环视四周，慵懒伸展。", "en": "Scan surroundings, stretch lazily."},
        {"zh": "晒着太阳，慢慢摇尾。", "en": "Bask, slowly wag tail."},
        {"zh": "趴在地上，享受温暖。", "en": "Lie down, enjoy warmth."},
        {"zh": "四肢摊开，贴在暖石上", "en": "Limbs spread flat on a warm stone."},
        {"zh": "尾巴慢慢摆，像在打拍子", "en": "Its tail swings slowly, keeping time."},
        {"zh": "半眯着眼，喉咙咕噜响", "en": "Half-lidded eyes, a rumble in its throat."},
        {"zh": "一动不动，等太阳挪位", "en": "Perfectly still, waiting for the sun to move."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "凝视玩家，瞳孔放大。", "en": "Gaze at player, eyes widen."},
        {"zh": "注视玩家，低吼警告。", "en": "Stare at player, low growl."},
        {"zh": "跟踪玩家，靠近观察。", "en": "Track player, approach to inspect."},
        {"zh": "张开嘴巴，露出獠牙。", "en": "Open mouth, show fangs."},
        {"zh": "我抬起头，露出上颚的旧疤。", "en": "I raise my head and show the old scar on my snout."},
        {"zh": "眼神凶狠，步步紧逼。", "en": "Ruthless eyes, advance."},
        {"zh": "低吼警告，准备出手。", "en": "Growl warning, prepare to strike."},
        {"zh": "锁定目标，缓慢接近。", "en": "Lock target, advance slowly."},
        {"zh": "我伏低身子，等你先动。", "en": "I crouch low and wait for you to move first."},
        {"zh": "怒视玩家，发出警告。", "en": "Glare at player, warn."},
        {"zh": "抬头嗅风，找准你的方向", "en": "It lifts its head, scenting your direction."},
        {"zh": "瞳孔收成一条竖缝", "en": "Its pupils narrow to slits."},
        {"zh": "它记得你身上的味道", "en": "It remembers your smell."},
        {"zh": "低伏前身，前肢抓地", "en": "It lowers its front, claws gripping soil."},
        {"zh": "喉咙深处滚出一声", "en": "A sound rolls up from deep in its throat."},
        {"zh": "你已经走进它的猎场", "en": "You have walked into its hunting ground."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶~ 我的脊椎受损了！", "en": "Ahh, my spine is injured!"},
        {"zh": "我的鳞片裂开了...", "en": "My scales are cracked..."},
        {"zh": "腿骨折了...", "en": "My leg bone is broken..."},
        {"zh": "我被咬了...", "en": "I was bitten..."},
        {"zh": "肋骨断了...", "en": "My ribs are broken..."},
        {"zh": "从石头上滑下来，擦掉一层鳞。", "en": "I slid off the rock and scraped off a layer of scales."},
        {"zh": "我中箭了...", "en": "I was hit by an arrow..."},
        {"zh": "我被闪电击中了...", "en": "I was struck by lightning..."},
        {"zh": "肚子空了两天，腿在发软。", "en": "Two days empty and my legs have gone soft."},
        {"zh": "我被抛入了虚空...", "en": "I was thrown into the void..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶，这猎物看起来不错！", "en": "Hisss, looks like a good meal."},
        {"zh": "我要饱餐一顿了！", "en": "Time to feed."},
        {"zh": "猎物的味道要鲜美一些！", "en": "The taste should be more delicious."},
        {"zh": "三叠纪的鳄口，先咬为敬。", "en": "A Triassic croc jaw bites first, greets later."},
        {"zh": "我的爪子让你尝尝苦头！", "en": "Feel the pain from my claws!"},
        {"zh": "前肢撑地，我把嘴张到最大。", "en": "I brace on my forelimbs and open my jaws as wide as they go."},
        {"zh": "猎物就在眼前，快抓住！", "en": "The prey is in front of you, grab it!"},
        {"zh": "我只需轻轻一咬！", "en": "Just a gentle bite!"},
        {"zh": "这具尸体还热，我先撕开。", "en": "This carcass is still warm; I tear it open first."},
        {"zh": "你的肉很鲜美！", "en": "Your meat is very tasty!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
