      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "术法让我的腿发沉", "en": "The spell weighs down my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这林子里的猎物太少", "en": "There is too little prey in this wood."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在我鼻角上", "en": "Lightning struck my nose horn."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有气味", "en": "There is no scent here."}
      ]
    }
  }
