{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用两条腿走", "en": "I walk on two legs."},
        {"zh": "我的鼻子上有角", "en": "There is a horn on my snout."},
        {"zh": "我每走一步都嗅地面", "en": "Each step, I sniff the ground."},
        {"zh": "我穿过蕨丛", "en": "I push through the ferns."},
        {"zh": "我的尾巴保持平衡", "en": "My tail keeps my balance."},
        {"zh": "我朝有气味的地方去", "en": "I head toward a scent."},
        {"zh": "我走得不快，但很警惕", "en": "Slow, but wary."},
        {"zh": "我的爪子抓着地面", "en": "My claws grip the ground."},
        {"zh": "我拐过一棵倒下的树", "en": "I round a fallen tree."},
        {"zh": "我的头一直低着", "en": "My head stays low."},
        {"zh": "我朝你那边慢慢走", "en": "I walk slowly your way."},
        {"zh": "我一步一停", "en": "I stop between steps."},
        {"zh": "我踩着落叶", "en": "I step on fallen leaves."},
        {"zh": "我绕着一片灌木转", "en": "I circle a patch of brush."},
        {"zh": "我停下来，抬头发声", "en": "I stop and raise my head to call."},
        {"zh": "我一直注意四周", "en": "I keep watching all around."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，头低着", "en": "I stand with my head low."},
        {"zh": "我的鼻孔在动", "en": "My nostrils flare."},
        {"zh": "我在听灌木里的声音", "en": "I listen inside the brush."},
        {"zh": "我的牙露在外面", "en": "My teeth show."},
        {"zh": "我不动，等东西出来", "en": "I stay still and wait."},
        {"zh": "我的脚趾在地上抓", "en": "My toes grip the dirt."},
        {"zh": "我在闻空气", "en": "I taste the air."},
        {"zh": "我慢慢转头", "en": "I turn my head slowly."},
        {"zh": "我的尾巴轻轻摆", "en": "My tail sways."},
        {"zh": "别在我附近弄出响动", "en": "Do not make noise near me."},
        {"zh": "我在磨牙", "en": "I grind my teeth."},
        {"zh": "我的背上有小骨板", "en": "Small plates run down my back."},
        {"zh": "我看向一个方向很久", "en": "I stare one way a long while."},
        {"zh": "我在等一个机会", "en": "I wait for an opening."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有味道", "en": "You have a scent."},
        {"zh": "你的手一动我就知道", "en": "I will know the moment your hand moves."},
        {"zh": "你比我想的大", "en": "You are bigger than I thought."},
        {"zh": "我不怕你", "en": "I am not afraid of you."},
        {"zh": "我的头低着，是准备", "en": "My head is low: I am ready."},
        {"zh": "你退开我就算了", "en": "Step back and I let it go."},
        {"zh": "我闻到你身上的铁", "en": "I smell iron on you."},
        {"zh": "你的眼睛在找我破绽", "en": "Your eyes hunt my weakness."},
        {"zh": "我朝你张了张嘴", "en": "I open my jaws at you."},
        {"zh": "你站着不动，我就再看看", "en": "Stand still and I will keep looking."},
        {"zh": "我认得这种对峙", "en": "I know this kind of standoff."},
        {"zh": "你手上的东西能伤人", "en": "What you hold can hurt."},
        {"zh": "我向前压了半步", "en": "I pressed forward half a step."},
        {"zh": "你别背对我", "en": "Do not turn your back."},
        {"zh": "我们还没开始", "en": "We have not started yet."},
        {"zh": "我数你的呼吸", "en": "I count your breaths."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我吼了一声", "en": "I roared."},
        {"zh": "我往侧后撤了半步", "en": "I drew back half a pace sideways."},
        {"zh": "我的皮被划开", "en": "My hide is cut."},
        {"zh": "我不叫疼", "en": "I do not cry out."},
        {"zh": "我的尾巴甩了一下", "en": "My tail lashed."},
        {"zh": "我还站着", "en": "I am still standing."},
        {"zh": "你打得很实", "en": "You hit solidly."},
        {"zh": "我的爪子抓紧了地", "en": "My claws dug in."},
        {"zh": "我记住这个味道", "en": "I remember that scent."},
        {"zh": "我会还回来", "en": "I will pay it back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉，我闻到了", "en": "Meat. I smell it."},
        {"zh": "这东西不够", "en": "This is not enough."},
        {"zh": "你扔过来", "en": "Throw it over."},
        {"zh": "我先看看", "en": "Let me look first."},
        {"zh": "我不吃死的太久", "en": "I do not eat what has been dead too long."},
        {"zh": "这味道让我兴奋", "en": "That smell excites me."},
        {"zh": "你手别抖", "en": "Do not let your hand shake."},
        {"zh": "你留着当诱饵，我知道", "en": "You mean to use it as bait; I know."},
        {"zh": "我再闻闻", "en": "Let me smell it again."},
        {"zh": "先退开三步，我再动嘴。", "en": "Step back three paces, then I'll eat."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你顶在我胸口上", "en": "You ran into my chest."},
        {"zh": "我没有退", "en": "I did not give ground."},
        {"zh": "我的骨头很硬", "en": "My bones are hard."},
        {"zh": "你退了两步", "en": "You fell back two steps."},
        {"zh": "这一下撞得很实", "en": "That was a solid collision."},
        {"zh": "我甩了甩头", "en": "I shook my head."},
        {"zh": "你踩到我的脚趾", "en": "You stepped on my toes."},
        {"zh": "我的肩很结实", "en": "My shoulder is solid."},
        {"zh": "你没事吧", "en": "Are you all right?"},
        {"zh": "绕开走", "en": "Go around."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不是那种性子", "en": "That is not my temperament."},
        {"zh": "我只想捕猎", "en": "I only want to hunt."},
        {"zh": "这种事要等季节", "en": "That waits for the season."},
        {"zh": "你问得不是时候", "en": "The timing is wrong."},
        {"zh": "我独自过得很好", "en": "I do fine alone."},
        {"zh": "我朝你低吼了一声", "en": "I growled low at you."},
        {"zh": "我的鼻角不是给你靠的。", "en": "My nose horn isn't for you to lean on."},
        {"zh": "我继续走", "en": "I keep walking."},
        {"zh": "我们不是一类", "en": "We are not the same kind."},
        {"zh": "你走吧", "en": "Go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼住就抬头", "en": "I take it and lift my head."},
        {"zh": "这东西不大", "en": "This is not large."},
        {"zh": "我咬了一下", "en": "I bit it."},
        {"zh": "它太硬了", "en": "It is too hard."},
        {"zh": "我一脚踢开了它", "en": "I kicked it away."},
        {"zh": "它掉在地上了", "en": "It fell to the ground."},
        {"zh": "我一爪踩住它", "en": "I plant a claw on it."},
        {"zh": "你捡吧", "en": "You pick it up."},
        {"zh": "我不需要它", "en": "I do not need it."},
        {"zh": "它不值什么", "en": "It is worth little."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你动了", "en": "You moved."},
        {"zh": "我就等你这一下", "en": "That is what I waited for."},
        {"zh": "我朝你冲过去", "en": "I charge at you."},
        {"zh": "我的头压低了", "en": "My head is down."},
        {"zh": "别跑", "en": "Do not run."},
        {"zh": "我咬定你了", "en": "I have fixed my teeth on the idea of you."},
        {"zh": "我闻到你的血在跑", "en": "I smell your blood moving."},
        {"zh": "你退到树后也没用", "en": "Hiding behind a tree will not help."},
        {"zh": "这一带有我的气味", "en": "This ground smells of me."},
        {"zh": "我开始加速", "en": "I am speeding up."},
        {"zh": "你还有几步", "en": "A few steps left."},
        {"zh": "我张嘴了", "en": "I have opened my jaws."},
        {"zh": "三、二、一", "en": "Three, two, one."},
        {"zh": "没地方躲", "en": "Nowhere to hide."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你跑", "en": "I run after you."},
        {"zh": "你拐进灌木", "en": "You cut into the brush."},
        {"zh": "我把灌木撞开", "en": "I crash through the brush."},
        {"zh": "我比你快", "en": "I am faster than you."},
        {"zh": "你爬不上那棵树", "en": "You cannot climb that tree."},
        {"zh": "我压低身子往前", "en": "I sink low and push forward."},
        {"zh": "我听得见你喘", "en": "I hear you panting."},
        {"zh": "你的伤在拖慢你", "en": "That wound is slowing you."},
        {"zh": "我绕到你前面", "en": "I come around ahead of you."},
        {"zh": "你停下来了", "en": "You have stopped."},
        {"zh": "这里的树太密", "en": "The trees here are too thick."},
        {"zh": "我一直没松口", "en": "I have not let up."},
        {"zh": "你转身就会看见我", "en": "Turn and you will see me."},
        {"zh": "我贴着你后面", "en": "I am right behind you."},
        {"zh": "这片蕨丛里没有第二条路", "en": "There is no second way through these ferns."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬下去", "en": "I bite down."},
        {"zh": "我的牙先到", "en": "My teeth arrive first."},
        {"zh": "你被撕开一道", "en": "You took a tear."},
        {"zh": "我把头一甩", "en": "I whip my head aside."},
        {"zh": "我的角顶在你胸口", "en": "My horn jabs your chest."},
        {"zh": "你退了很远", "en": "You fell back a long way."},
        {"zh": "你护住了手臂", "en": "You guarded your arm."},
        {"zh": "这一口没有咬实", "en": "That bite did not land clean."},
        {"zh": "我踩住了你的影", "en": "I stepped on your shadow."},
        {"zh": "你还能站着", "en": "You can still stand."},
        {"zh": "我再来一次", "en": "I come again."},
        {"zh": "这是给你留的余地", "en": "This is the room I leave you."},
        {"zh": "你的护甲凹了", "en": "Your armor dented."},
        {"zh": "我喘着气", "en": "I am panting."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从蕨丛里走出来", "en": "I step out of the ferns."},
        {"zh": "我的鼻子先探出来", "en": "My snout appears first."},
        {"zh": "这片林子多了一股味道", "en": "A new scent joins this wood."},
        {"zh": "我低着头，慢慢走", "en": "I walk slowly, head low."},
        {"zh": "我咬断了一根枝条", "en": "I bit a branch in two."},
        {"zh": "我朝你的方向看", "en": "I look your way."},
        {"zh": "我还站在原地看着", "en": "I just stand here and watch."},
        {"zh": "我踩碎了一块骨头", "en": "I crushed a bone underfoot."},
        {"zh": "我的尾巴扫过草", "en": "My tail brushes the grass."},
        {"zh": "我在这一带找吃的", "en": "I am hunting this area."},
        {"zh": "你听见低吼了吗", "en": "Did you hear a low growl?"},
        {"zh": "我从树后走出来", "en": "I come out from behind a tree."},
        {"zh": "我站在你和我之间", "en": "I stand between you and the path."},
        {"zh": "我闻到了活物", "en": "I smell something living."},
        {"zh": "你最好别动", "en": "You had better not move."},
        {"zh": "我的角在光下发白", "en": "My horn is pale in the light."},
        {"zh": "我压着步子缩短距离", "en": "I shorten the gap, step by step."},
        {"zh": "这片地归我猎", "en": "This is my hunting ground."},
        {"zh": "我停下了，看着你", "en": "I stopped and looked at you."},
        {"zh": "你已经在我的路上", "en": "You are on my path already."}
      ]
    },
