        {"zh": "别挡我，小心撞上你了！", "en": "Get out of my way! Almost撞上you!"},
        {"zh": "我撞上了你，你没事吧？", "en": "Bumped into you. Are you okay?"},
        {"zh": "用力一撞，对方应声倒地！", "en": "Bump, and they fall!"},
