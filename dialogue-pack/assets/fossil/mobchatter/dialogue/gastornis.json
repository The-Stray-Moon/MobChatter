  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "张开巨大翅膀，扑棱棱飞起。", "en": "Spread wide wings and take off."},
        {"zh": "低头觅食，小心地行走。", "en": "Lower head to search for food, walk cautiously."},
        {"zh": "用喙轻啄树叶，享受美食。", "en": "Peck at the leaves, savoring the meal."},
        {"zh": "翅膀轻拍，步履缓慢前行。", "en": "Wings flap gently, moving slowly."},
        {"zh": "观察地面，寻找嫩叶。", "en": "Look at the ground for tender leaves."},
        {"zh": "踱步而行，似乎在思考。", "en": "Stroll, seemingly pondering."},
        {"zh": "缓慢飞行，享受天空。", "en": "Fly slowly, enjoying the sky."},
        {"zh": "低头觅食，警惕四周。", "en": "Lower head to eat, watch around."},
        {"zh": "缓慢踱步，享受午后时光。", "en": "Stroll slowly, enjoying the afternoon."},
        {"zh": "张开翅膀，缓缓降落。", "en": "Spread wings and softly land."},
        {"zh": "粗壮的腿迈过蕨丛", "en": "Thick legs step over the ferns"},
        {"zh": "弯下长脖子撕下叶片", "en": "I bend my long neck and tear a leaf"},
        {"zh": "在树荫下慢慢踱着", "en": "I pace slowly in the tree shade"},
        {"zh": "尾羽扫过地上的果子", "en": "Tail feathers sweep fallen fruit"},
        {"zh": "停下来啄了啄树皮", "en": "I stop and peck at the bark"},
        {"zh": "小心地跨过一截树根", "en": "I step carefully over a root"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "安静地站立，目光平静。", "en": "Stand quietly, calm gaze."},
        {"zh": "低垂头颅，闭目养神。", "en": "Lower head, close eyes to rest."},
        {"zh": "轻轻啄食，享受安宁。", "en": "Peck gently, enjoying peace."},
        {"zh": "踱步来回，寻找食物。", "en": "Pace, searching for food."},
        {"zh": "静静地站立，等待时机。", "en": "Stand quietly, waiting for an opportunity."},
        {"zh": "低头沉思，似乎在计划。", "en": "Lower head in thought, planning."},
        {"zh": "缓缓呼吸，恢复平静。", "en": "Breathe slowly, calming down."},
        {"zh": "悠闲站立，享受自然。", "en": "Stand leisurely, enjoying nature."},
        {"zh": "低头轻啄，享受片刻。", "en": "Peck gently, enjoying a moment."},
        {"zh": "静静站立，等待食物。", "en": "Stand quietly, waiting for food."},
        {"zh": "单脚站立，一动不动", "en": "Standing on one leg, perfectly still"},
        {"zh": "把喙埋进胸前的羽毛", "en": "Beak tucked into my chest feathers"},
        {"zh": "眨眨眼，望着一片叶子", "en": "Blinking at a single leaf"},
        {"zh": "喉咙里滚出低低的咕声", "en": "A low gurgle rolls in my throat"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉玩家，目光锐利。", "en": "Notice the player, sharp gaze."},
        {"zh": "朝玩家方向，展开翅膀。", "en": "Turn to player, spread wings."},
        {"zh": "低头观察，似乎有所察觉。", "en": "Lower head, notice something."},
        {"zh": "转身面对玩家，发出低鸣。", "en": "Turn to face the player, give a low call."},
        {"zh": "注意玩家，准备寻找。", "en": "Notice the player, ready to search."},
        {"zh": "我低头看看叶子，也看看你。", "en": "I glance at the leaves, then at you."},
        {"zh": "翅膀展开，警惕玩家。", "en": "Spread wings, wary of the player."},
        {"zh": "翅膀半张，关注玩家。", "en": "Half spread wings, focus on the player."},
        {"zh": "低头凝视，似乎在思考。", "en": "Lower head, seemingly thinking."},
        {"zh": "翅膀半张，警惕玩家。", "en": "Half spread wings, wary of the player."}
      ]
    },
