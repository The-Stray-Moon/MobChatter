  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "缓慢游动着，身体摆动生辉。", "en": "Swimming slowly, body gliding gracefully."},
        {"zh": "鱼鳍轻轻拍打，向前滑行。", "en": "Fin gently flapping, gliding forward."},
        {"zh": "在水中轻轻摆动，寻找食物。", "en": "Swinging gently in water, searching for food."},
        {"zh": "悠闲地在湖底游弋。", "en": "Drifting leisurely at the lake bottom."},
        {"zh": "水面下缓缓游动。", "en": "Slowly swimming underwater."},
        {"zh": "轻拍水花，慢慢前进。", "en": "Paddling water, slowly moving forward."},
        {"zh": "鱼尾轻轻摆动，前进。", "en": "Tail swaying gently, moving forward."},
        {"zh": "我的骨板划过水草背面。", "en": "My bony plates brush the underside of the weeds."},
        {"zh": "鱼鳍轻拍水面，前进。", "en": "Fin tapping water, moving forward."},
        {"zh": "鱼身在水中轻摆。", "en": "Body swaying gently in water."},
        {"zh": "长吻贴着河床滑过", "en": "Its long snout grazes the riverbed."},
        {"zh": "骨板在背上一节节起伏", "en": "The bony plates ripple along its back."},
        {"zh": "尾鳍一摆，逆流而上", "en": "One tailbeat, and it pushes upstream."},
        {"zh": "身体扭动着钻过石缝", "en": "It twists through a gap between stones."}
      ]
    },
