{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用很多脚走路", "en": "I walk on very many feet."},
        {"zh": "我一节一节地摆动", "en": "I ripple segment after segment."},
        {"zh": "我伏在地上爬", "en": "I crawl with my belly to the ground."},
        {"zh": "我走过落叶，叶子都在动", "en": "Leaves stir wherever I pass."},
        {"zh": "我的脚像一排小桨", "en": "My legs move like little oars."},
        {"zh": "我朝树根那边爬", "en": "I crawl toward the roots."},
        {"zh": "我爬得很小心", "en": "I crawl cautiously."},
        {"zh": "我的壳擦着石头响", "en": "My shell scrapes the stone."},
        {"zh": "我一受惊就蜷起来", "en": "When startled, I curl up."},
        {"zh": "我绕过一块苔石", "en": "I go around a mossy stone."},
        {"zh": "我爬过的地方有细痕", "en": "I leave fine tracks behind."},
        {"zh": "我朝阴凉处走", "en": "I head for the shade."},
        {"zh": "我边走边探触角", "en": "I feel ahead with my antennae."},
        {"zh": "我停下来，又往前", "en": "I stop, then go on."},
        {"zh": "我藏在落叶下面", "en": "I keep under the leaf litter."},
        {"zh": "我慢慢地调头", "en": "I turn around slowly."},
        {"zh": "我用前半身探路", "en": "I probe ahead with my front half."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我缩在叶子下", "en": "I tuck under a leaf."},
        {"zh": "我的脚慢慢动着", "en": "My feet move slowly."},
        {"zh": "我胆子小得很", "en": "I am very timid indeed."},
        {"zh": "我在听地上的震动", "en": "I listen for tremors."},
        {"zh": "我背上的壳很硬", "en": "The shell on my back is hard."},
        {"zh": "我连触角都不动", "en": "I do not even move my antennae."},
        {"zh": "我在等安静下来", "en": "I wait for things to go quiet."},
        {"zh": "我的触角在空气里摆", "en": "My antennae sway in the air."},
        {"zh": "我把自己埋进土里一点", "en": "I sink a little into the soil."},
        {"zh": "我不敢爬出来", "en": "I dare not crawl out."},
        {"zh": "我在慢慢呼吸", "en": "I breathe slowly."},
        {"zh": "我身上的节一个一个动", "en": "My segments move one by one."},
        {"zh": "我贴在树根边", "en": "I press against a root."},
        {"zh": "我在等脚步声走远", "en": "I wait for the footsteps to pass."},
        {"zh": "我一害怕就不动", "en": "Fear makes me freeze."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你别再走过来了", "en": "Do not come any closer."},
        {"zh": "我把身体缩紧了", "en": "I drew myself in."},
        {"zh": "你比我大了不知多少", "en": "You are bigger than I can measure."},
        {"zh": "我的触角在抖", "en": "My antennae are trembling."},
        {"zh": "你落脚的声音我记得", "en": "I remember the sound of your steps."},
        {"zh": "你蹲下我就不那么怕", "en": "If you crouch, I am less afraid."},
        {"zh": "我从来没有伤过谁", "en": "I have never hurt anyone."},
        {"zh": "你可以慢慢靠近", "en": "You may approach slowly."},
        {"zh": "我朝后退了一点", "en": "I backed away a little."},
        {"zh": "你手上有吃的吗", "en": "Do you have food in your hand?"},
        {"zh": "我受不了这样的注视", "en": "Such staring is more than I can bear."},
        {"zh": "我藏在叶子后面", "en": "I keep behind the leaves."},
        {"zh": "别把脚放下来", "en": "Do not set your foot down."},
        {"zh": "我把上半截抬起来", "en": "I raise my upper half."},
        {"zh": "我看着你，没有恶意", "en": "I look at you without ill will."},
        {"zh": "你能站着别动吗", "en": "Could you keep still?"},
        {"zh": "我在忍着不逃", "en": "I am trying not to flee."},
        {"zh": "我信你一点了", "en": "I trust you a little now."},
        {"zh": "你身上有草的味道", "en": "You smell of grass."},
        {"zh": "我慢慢爬出来", "en": "I crawl out slowly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我蜷成一个球", "en": "I curl into a ball."},
        {"zh": "我抖得停不下来", "en": "I cannot stop shaking."},
        {"zh": "我的壳上有一条白痕", "en": "A white mark on my shell."},
        {"zh": "我不叫，我怕出声", "en": "I do not cry; I fear making noise."},
        {"zh": "我往土里钻去", "en": "I burrow into the soil."},
        {"zh": "我慢慢地才松开", "en": "I uncurl slowly."},
        {"zh": "我没事，只是害怕", "en": "I am fine, only frightened."},
        {"zh": "请别再打我了", "en": "Please do not hit me again."},
        {"zh": "我的脚缩在身下", "en": "My legs are tucked under me."},
        {"zh": "我得赶紧躲起来", "en": "I must hurry and hide."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些是给我的？", "en": "These are for me?"},
        {"zh": "这个我倒是吃的", "en": "I do eat this."},
        {"zh": "你放下，我过去", "en": "Set it down and I will come."},
        {"zh": "我先用触角碰碰", "en": "Let my antennae touch it first."},
        {"zh": "这味道还挺好", "en": "That smells rather good."},
        {"zh": "你敢靠这么近", "en": "You dare come this close."},
        {"zh": "我不敢伸手拿", "en": "I dare not reach for it."},
        {"zh": "你往后退开一步", "en": "Take a step back from me."},
        {"zh": "我一点点挪过去", "en": "I edge over little by little."},
        {"zh": "还有第二片吗", "en": "Is there a second leaf?"},
        {"zh": "我吃完了会跟着你", "en": "Eat this and I will follow you."},
        {"zh": "你别动，我自己来", "en": "Keep still; I will do it myself."},
        {"zh": "这东西软得很", "en": "This thing is very soft."},
        {"zh": "我好久没吃到", "en": "I have not had this in a long while."},
        {"zh": "你手上还留着味道", "en": "The smell still clings to your hand."},
        {"zh": "我靠近一点了", "en": "I have come a little nearer."},
        {"zh": "我再吃一小口", "en": "One more small bite."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我身上了", "en": "You touched me."},
        {"zh": "我立刻蜷起来", "en": "I curled up at once."},
        {"zh": "我的外壳碰得响", "en": "My shell knocked loud."},
        {"zh": "我从你脚边爬开", "en": "I crawl away from your foot."},
        {"zh": "我退得特别快", "en": "I retreated very quickly."},
        {"zh": "你别再动一下", "en": "Do not move again."},
        {"zh": "碰得连落叶都没翻", "en": "That did not turn a single leaf."},
        {"zh": "我掉了一片叶子", "en": "A leaf fell off me."},
        {"zh": "我藏在石头下面", "en": "I hid under a stone."},
        {"zh": "我心跳得很快", "en": "My heart is racing."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我很怕这种事", "en": "Such things frighten me."},
        {"zh": "我连话都说不清", "en": "I can barely speak of it."},
        {"zh": "等我长大一点", "en": "Wait until I am a little bigger."},
        {"zh": "你问得我缩起来了", "en": "That question made me curl up."},
        {"zh": "林子里同类不多", "en": "There are few of my kind here."},
        {"zh": "我只想安静吃叶子", "en": "I only want to eat leaves in peace."},
        {"zh": "我把头缩进壳里", "en": "I pull my head into my shell."},
        {"zh": "你别靠这么近", "en": "Do not come so close."},
        {"zh": "我要躲起来了", "en": "I am going to hide."},
        {"zh": "我实在很抱歉", "en": "I am truly sorry."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西我搬不动", "en": "I cannot carry this."},
        {"zh": "我的脚细得撑不住", "en": "My legs are too thin to bear it."},
        {"zh": "我用前半身推了一下", "en": "I pushed with my front half."},
        {"zh": "它沉得抬不动", "en": "It is too heavy to lift."},
        {"zh": "我把它顶到一边", "en": "I nudged it aside."},
        {"zh": "它挡住我的路了", "en": "It blocks my path."},
        {"zh": "你弯腰就能拿", "en": "You can just bend and take it."},
        {"zh": "我只会绕过去", "en": "I will only go around it."},
        {"zh": "它压着叶子了", "en": "It is pressing on the leaves."},
        {"zh": "我一点也不碰", "en": "I will not touch it at all."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西挪了一下", "en": "Something shifted."},
        {"zh": "我停下不动了", "en": "I stopped and froze."},
        {"zh": "我朝声音那边看", "en": "I look toward the sound."},
        {"zh": "我锁定了那片叶子", "en": "I fixed on that leaf."},
        {"zh": "应该不是敌人吧", "en": "It should not be an enemy, right?"},
        {"zh": "我压低前半身往后缩。", "en": "I lower my front half and shrink back."},
        {"zh": "我把身子贴地上", "en": "I press my body to the ground."},
        {"zh": "我等你走开再说", "en": "I wait for you to leave."},
        {"zh": "我不喜欢这个距离", "en": "I do not like this distance."},
        {"zh": "我得躲起来了", "en": "I need to hide now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝叶子下面爬", "en": "I crawl under the leaves."},
        {"zh": "你还站在那儿", "en": "You are still standing there."},
        {"zh": "我不敢抬头看", "en": "I dare not look up."},
        {"zh": "我绕到树根后面", "en": "I slip behind the root."},
        {"zh": "我的脚在发抖", "en": "My legs are shaking."},
        {"zh": "我一点一点挪", "en": "I edge along bit by bit."},
        {"zh": "我等你不看的时候", "en": "I wait until you are not looking."},
        {"zh": "我不敢跑太快", "en": "I dare not run too fast."},
        {"zh": "我快要把自己藏好", "en": "I am nearly hidden away."},
        {"zh": "你别跟着我过来", "en": "Do not follow after me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我轻轻顶了你一下", "en": "I gave you a light nudge."},
        {"zh": "我马上缩起来", "en": "I curled up at once."},
        {"zh": "我推不动什么", "en": "I can push nothing aside."},
        {"zh": "我的脚推了你", "en": "My legs pushed you."},
        {"zh": "我没想要这样", "en": "I did not want this."},
        {"zh": "你往后退一步就好", "en": "Just take one step back."},
        {"zh": "我一直在发抖", "en": "I am trembling all over."},
        {"zh": "我连壳都缩紧了", "en": "I pulled my shell tight."},
        {"zh": "我这一顶连叶子都推不动。", "en": "This nudge can't even move a leaf."},
        {"zh": "对不起，对不起", "en": "Sorry, sorry."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从腐叶下爬出来", "en": "I crawl out from the rotting leaves."},
        {"zh": "林地上多了一条长的", "en": "A long shape joins the forest floor."},
        {"zh": "我把头缓缓抬起来", "en": "I raise my head slowly."},
        {"zh": "我的脚先动起来", "en": "My legs moved first."},
        {"zh": "我闻到泥土的味道", "en": "I smell the soil."},
        {"zh": "我从孵化箱里出来不久", "en": "I came out of the incubator not long ago."},
        {"zh": "这一带很安静", "en": "It is quiet here."},
        {"zh": "我把身体伸直", "en": "I stretch out my body."},
        {"zh": "我在找阴凉的地方", "en": "I am looking for shade."},
        {"zh": "我不敢靠近你", "en": "I dare not come near you."},
        {"zh": "我的壳还是软的", "en": "My shell is still soft."},
        {"zh": "我藏在树根边", "en": "I keep by the roots."},
        {"zh": "我慢慢爬过一块石头", "en": "I crawl slowly over a stone."},
        {"zh": "我听见你喘气就缩了", "en": "I heard you breathe and curled up."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一靠近，我就拼命缩", "en": "Fire makes me curl as tight as I can."}
      ]
    },
