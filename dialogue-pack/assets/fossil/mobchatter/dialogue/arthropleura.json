      "operation": "replace",
      "lines": [
        {"zh": "没有叶子，我越来越弱", "en": "Without leaves I grow weaker."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我缩进土里", "en": "The flash sends me into the soil."}
      ]
    },
