    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我的长脖子，绕得过礁石。", "en": "My long neck coils around the reef."},
        {"zh": "鱼儿，快点游！", "en": "Fish, swim faster!"},
        {"zh": "我的脖子长，你逃不掉！", "en": "My neck is long, you can't escape!"},
        {"zh": "水面之下，我的领地！", "en": "Under the water, my territory!"},
        {"zh": "水里那群鱼，跑不掉了。", "en": "That school of fish has nowhere to run."},
        {"zh": "安静点，不要惊扰我！", "en": "Be quiet, don't disturb me!"},
        {"zh": "别想靠近我的鱼！", "en": "Don't think about my fish!"},
        {"zh": "躲开我，小家伙！", "en": "Stay away from me, little one!"},
        {"zh": "我的家园，我的食物！", "en": "My home, my food!"},
        {"zh": "鱼就在礁石后，我绕着石头转。", "en": "The fish is behind the reef, so I circle the rock."}
      ]
    },
