{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "缓慢爬行，发出低沉声响。", "en": "Slowly crawls, producing a low sound."},
        {"zh": "移动时发出细微沙沙声。", "en": "Makes a soft rustling sound when moving."},
        {"zh": "在泥泞中缓慢行进。", "en": "Moves slowly through the mud."},
        {"zh": "在水中悠闲地游动。", "en": "Swims leisurely in the water."},
        {"zh": "用触手摸索前进。", "en": "Uses its触手摸索前进."},
        {"zh": "寻找食物时轻声蠕动。", "en": "Gently wriggles while searching for food."},
        {"zh": "缓慢地在海底爬行。", "en": "Crawls slowly on the seafloor."},
        {"zh": "用触手感知周围的环境。", "en": "Uses its触手感知周围的环境."},
        {"zh": "三叉戟似的角在沙上划痕。", "en": "My trident-like horn scores the sand."},
        {"zh": "一节一节地推着身体前进。", "en": "Segment by segment, I push forward."},
        {"zh": "贴着水底石面慢慢滑。", "en": "Sliding slowly along the bottom stones."},
        {"zh": "腹下的细足一起摆动。", "en": "The fine legs beneath me row in unison."},
        {"zh": "绕过一丛水草继续爬。", "en": "Around a clump of weed, crawling on."},
        {"zh": "在泥盆纪的沙层上留下沟。", "en": "I leave a groove in Devonian sand."},
        {"zh": "三叉戟状的角推开水流。", "en": "My trident-shaped horn parts the current."},
        {"zh": "壳的边缘轻轻刮着砂砾。", "en": "My shell edge rasps the grit."},
        {"zh": "爬到浅滩又转身回去。", "en": "I reach the shallows and turn back."},
        {"zh": "划开一层薄泥，继续前行。", "en": "I part a thin layer of silt and move on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静地趴伏在海底。", "en": "Lies quietly on the seafloor."},
        {"zh": "用触手轻轻触碰周围的物体。", "en": "Gently touches nearby objects with its触手."},
        {"zh": "在水中缓缓摆动触手。", "en": "Gently waves its触手 in the water."},
        {"zh": "平静地在海底等待。", "en": "Puts itself in a state of quiet wait in the seafloor."},
        {"zh": "幼体在水中游弋。", "en": "Swims lazily in the water."},
        {"zh": "在海底缓缓爬行。", "en": "Crawls slowly on the seafloor."},
        {"zh": "用触手轻轻触碰沙粒。", "en": "Gently touches sand grains with its触手."},
        {"zh": "泥盆纪的水底，我一直很安静。", "en": "Devonian seabed; I stay very quiet."},
        {"zh": "幼体在水中游动。", "en": "Swims lazily in the water."},
        {"zh": "用触手轻轻移动。", "en": "Gently moves with its触手."},
        {"zh": "半截身子埋进沙里歇着。", "en": "Half buried in sand, resting."},
        {"zh": "复眼映着水面晃动的光。", "en": "My compound eyes catch the wavering light."},
        {"zh": "把角插进泥里稳住自己。", "en": "I plant my horn in the mud to steady myself."},
        {"zh": "壳上落了一层细沙。", "en": "A fine layer of sand settles on my shell."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "用触手感知玩家的靠近。", "en": "Perceives the player's approach with its触手."},
        {"zh": "用触手轻轻触碰玩家。", "en": "Gently touches the player with its触手."},
        {"zh": "靠近玩家时发出微弱声响。", "en": "Makes a faint sound when approaching the player."},
        {"zh": "幼体观察玩家的动作。", "en": "Observes the player's actions."},
        {"zh": "用触手轻轻碰触玩家。", "en": "Gently touches the player with its触手."},
        {"zh": "感知玩家的存在。", "en": "Perceives the player's presence."},
        {"zh": "靠近玩家时发出轻微声响。", "en": "Makes a faint sound when approaching the player."},
        {"zh": "幼体观察玩家的移动。", "en": "Observes the player's movement."},
        {"zh": "水底的影子靠近，我缩了缩。", "en": "A shadow nears the bottom; I shrink back."},
        {"zh": "复眼转向你，看不清也没关系。", "en": "My compound eyes turn to you. Seeing clearly is optional."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "受伤了，我感觉到了...", "en": "I'm injured... I can feel it..."},
        {"zh": "我的壳受到了伤害...", "en": "My shell is damaged..."},
        {"zh": "这痛得我受不了...", "en": "This hurts..."},
        {"zh": "我的身体在疼...", "en": "My body is hurting..."},
        {"zh": "我需要休息...这里不安全...", "en": "I need to rest... This place is unsafe..."},
        {"zh": "我受了伤，得找个地方躲躲...", "en": "I'm injured, I need to hide..."},
        {"zh": "甲壳被掀开一角，水里飘出碎屑。", "en": "A corner of my shell is torn, bits drifting in the water."},
        {"zh": "请帮我...我受伤了...", "en": "Help me... I'm injured..."},
        {"zh": "这伤真严重...", "en": "This wound is serious..."},
        {"zh": "我需要安静...休息一下...", "en": "I need to rest..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠近我太近了，我怕了。", "en": "You're getting too close, I'm scared."},
        {"zh": "我不喜欢被触碰。", "en": "I don't like being touched."},
        {"zh": "来吧，享受这美味。", "en": "Come, enjoy this delicious meal."},
        {"zh": "不要靠近我的洞穴。", "en": "Don't get close to my cave."},
        {"zh": "你不会想吃我。", "en": "You wouldn't want to eat me."},
        {"zh": "我的肉很鲜美。", "en": "My meat is delicious."},
        {"zh": "你是我的食物。", "en": "You're my food."},
        {"zh": "小心，我是无害的。", "en": "Be careful, I'm harmless."},
        {"zh": "请远离我。", "en": "Please stay away from me."},
        {"zh": "不要打扰我的生活。", "en": "Don't disturb my life."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "碰上我了，你输了。", "en": "You hit me, you lose."},
        {"zh": "我行动缓慢，你撞上我了。", "en": "I'm slow, you hit me."},
        {"zh": "我躲开了你的攻击。", "en": "I dodged your attack."},
        {"zh": "你撞到了我的壳。", "en": "You hit my shell."},
        {"zh": "三叶虫的甲壳，撞一下试试。", "en": "Try shoving this trilobite shell."},
        {"zh": "我只有六点血，也敢顶你。", "en": "Six health or not, I'll butt you."},
        {"zh": "我没有攻击性。", "en": "I'm not aggressive."},
        {"zh": "我们只是不小心碰到了。", "en": "We just accidentally touched."},
        {"zh": "你没有伤到我。", "en": "You didn't hurt me."},
        {"zh": "别踩我，我只会往泥里缩。", "en": "Do not step on me; I only shrink into the mud."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我找到我的伴侣了。", "en": "I found my mate."},
        {"zh": "我们一起繁衍吧。", "en": "Let's reproduce together."},
        {"zh": "你看起来像我的配偶。", "en": "You look like my mate."},
        {"zh": "我是来交配的。", "en": "I'm here to mate."},
        {"zh": "我举起头甲，在浅水里等着回应。", "en": "I raise my head shield and wait in the shallows."},
        {"zh": "河底的泥沙里，该有个同伴了。", "en": "There should be a companion in the riverbed silt."},
        {"zh": "让我们结为伴侣。", "en": "Let's become partners."},
        {"zh": "我会保护我的配偶。", "en": "I'll protect my mate."},
        {"zh": "我找到了我的另一半。", "en": "I found my other half."},
        {"zh": "我们在一起吧。", "en": "Let's be together."}
      ]
    },
