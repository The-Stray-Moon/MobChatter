  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "挥舞大牙前行", "en": "Swing tusks while walking"},
        {"zh": "用象牙在地上划", "en": "Scrape ground with tusks"},
        {"zh": "缓慢移动身体", "en": "Move body slowly"},
        {"zh": "咀嚼树叶的声音", "en": "Masticate leaves sound"},
        {"zh": "用鼻子感知路径", "en": "Sniff path with trunk"},
        {"zh": "磨牙以示饥饿", "en": "Grind teeth in hunger"},
        {"zh": "嗅探周围的气味", "en": "Sniff surrounding scents"},
        {"zh": "咀嚼时发出声音", "en": "Make chewing sounds"},
        {"zh": "用鼻孔呼吸", "en": "Breath through nostrils"},
        {"zh": "铲齿扫开灌木，慢慢挪步。", "en": "Shovel tusks sweep the brush aside as it plods."},
        {"zh": "幼象跟在母象脚边。", "en": "A calf trails at its mother's feet."},
        {"zh": "长鼻卷起一束青草。", "en": "Its trunk curls up a bundle of grass."},
        {"zh": "沉重的脚掌压平野草。", "en": "Heavy feet flatten the wild grass."},
        {"zh": "三头象排成一队涉水。", "en": "Three of them wade in a line."},
        {"zh": "泥土从铲齿上簌簌落下。", "en": "Soil sifts off its shovel tusks."},
        {"zh": "它边走边用鼻子拨开树枝。", "en": "It noses branches aside as it walks."},
        {"zh": "脚边的水被踩得浑浊。", "en": "The water at its feet turns muddy."},
        {"zh": "象蹄陷进松软的河岸。", "en": "Its feet sink into the soft riverbank."}
      ]
    },
