{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "细腿迈得慢，头却抬着。", "en": "Short legs step slowly, head held high."},
        {"zh": "我低着头，慢慢嚼过这片草。", "en": "Head low, I chew my way across this grass."},
        {"zh": "咀嚼青草", "en": "Chews on green grass"},
        {"zh": "踱步觅食", "en": "Paces while foraging"},
        {"zh": "警惕地走动", "en": "Cautiously ambles"},
        {"zh": "啃食低草", "en": "Browses low grasses"},
        {"zh": "咀嚼嫩叶", "en": "Munches on tender leaves"},
        {"zh": "轻缓行走", "en": "Goes at a gentle pace"},
        {"zh": "寻找新鲜草", "en": "Scouting for fresh grass"},
        {"zh": "悠闲移动", "en": "Moving leisurely"},
        {"zh": "四蹄踩过蕨叶，很轻。", "en": "Four hooves press the ferns, lightly."},
        {"zh": "沿河岸走，找嫩芽。", "en": "I walk the riverbank looking for shoots."},
        {"zh": "短腿迈得快，追着日光。", "en": "Short legs move fast, chasing daylight."},
        {"zh": "尾巴扫过，草叶伏倒。", "en": "My tail sweeps and the grass bends."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "低头休息", "en": "Rests its head"},
        {"zh": "平静站立", "en": "Stands calmly"},
        {"zh": "我的头盾晒得发亮。", "en": "My frill shines in the sun."},
        {"zh": "缓慢咀嚼", "en": "Slowly chews"},
        {"zh": "享受片刻", "en": "Enjoying a moment"},
        {"zh": "头盾的颜色，太阳下最亮。", "en": "My frill shines brightest in the sun."},
        {"zh": "慢慢摇晃", "en": "Gently sways head"},
        {"zh": "低垂尾巴", "en": "Low tail"},
        {"zh": "慢慢打嗝", "en": "Slow belch"},
        {"zh": "白天的太阳，晒暖我的背盾。", "en": "The daytime sun warms the shield on my back."},
        {"zh": "晒着太阳，背脊暖了。", "en": "The sun warms the ridge of my back."},
        {"zh": "嚼到一半，抬头听风。", "en": "Half-chewed, I lift my head to the wind."},
        {"zh": "用后腿挠了挠头盾。", "en": "I scratch my frill with a hind leg."},
        {"zh": "鼻孔喷出一点土。", "en": "A little dust puffs from my nostrils."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头，用头盾对着你。", "en": "I lower my head and point my frill at you."},
        {"zh": "我的鼻孔在动，闻你的手。", "en": "My nostrils work, sniffing your hands."},
        {"zh": "头转向玩家", "en": "Head turns to player"},
        {"zh": "好奇的目光", "en": "Curious gaze"},
        {"zh": "注意玩家动静", "en": "Noticing player's movements"},
        {"zh": "缓缓转头", "en": "Slowly turning head"},
        {"zh": "目光闪烁不定", "en": "Eyes darting"},
        {"zh": "你的脚步一近，我就抬头。", "en": "One step closer and I raise my head."},
        {"zh": "目光交流", "en": "Eye contact"},
        {"zh": "观察玩家动作", "en": "Observing player"},
        {"zh": "歪头看你，草还挂在嘴边。", "en": "I tilt my head, grass still in my mouth."},
        {"zh": "你比蕨树高多了。", "en": "You are much taller than a fern."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "幼体声音弱小：小角角受伤了。", "en": "Young one weakly: Little Protoceratops got hurt."},
        {"zh": "成年声音低沉：唉……", "en": "Adult deep: Aaah..."},
        {"zh": "声音悲鸣：呜……呜……", "en": "Screaming: Wuh...Wuh..."},
        {"zh": "发出哀鸣：啊啊啊啊……", "en": "Screaming: Aaaah..."},
