    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "吃这草，力量会更强！", "en": "Eat this grass, get stronger!"},
        {"zh": "靠近我就得小心了！", "en": "Come near me, and be wary!"},
        {"zh": "我的肉很鲜美哦！", "en": "My meat is tasty!"},
        {"zh": "看我的头盾闪光！", "en": "See my bright head shield!"},
        {"zh": "快过来，分享食物！", "en": "Come here, share food!"},
        {"zh": "我的体型小，但很聪明！", "en": "Small body, big brain!"},
        {"zh": "你闻闻这草香不香？", "en": "Smell this fragrant grass!"},
        {"zh": "别小看我，我很厉害！", "en": "Don’t underestimate me!"},
        {"zh": "和我一起，你会更安全！", "en": "Stay with me, be safe!"},
        {"zh": "分享果实，共同成长！", "en": "Share fruits, grow together!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，我要撞击你！", "en": "Watch out, I’ll ram you!"},
        {"zh": "我的头盾可以挡子弹！", "en": "My head shield can block!"},
        {"zh": "二十五点身子，撞得动你。", "en": "Twenty-five points of body can shove you aside."},
        {"zh": "头碰头，看谁厉害！", "en": "Head butts, who’s stronger!"},
        {"zh": "我的角很坚硬，看！", "en": "My horns are hard, look!"},
        {"zh": "让开，我要展示力量！", "en": "Move, show my strength!"},
        {"zh": "用头盾保护自己！", "en": "Protect with head shield!"},
        {"zh": "我头上的盾，比你的剑硬。", "en": "The shield on my head is harder than your sword."},
        {"zh": "我的体型小，但攻击力强！", "en": "Small, but strong attack!"},
        {"zh": "用头盾，撞倒你的防御！", "en": "Use head shield, break defenses!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的头盾颜色，她一眼就看见。", "en": "She spots my frill's colour at once."},
        {"zh": "我的声音很动听，听！", "en": "My voice is sweet, listen!"},
        {"zh": "用头盾吸引雌性！", "en": "Attract females with head shield!"},
        {"zh": "用叫声展示我的魅力！", "en": "Show charm with calls!"},
        {"zh": "我的头盾颜色很耀眼！", "en": "My head shield is bright!"},
        {"zh": "用头盾吸引雌性注意！", "en": "Catch female attention!"},
        {"zh": "用叫声来吸引伴侣！", "en": "Call to attract a mate!"},
        {"zh": "和我交配，增强后代！", "en": "Mate with me, strengthen offspring!"},
        {"zh": "用头盾来吸引雌性！", "en": "Use head shield, attract females!"},
        {"zh": "我的声音能吸引雌性！", "en": "My voice attracts females!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "轻咬地面，发出低吼。", "en": "Nods, growls softly."},
        {"zh": "晃动头盾，发出嘶嘶声。", "en": "Nods head, hisses slightly."},
        {"zh": "用角轻触地面，咀嚼声。", "en": "Taps horn, chewing sound."},
        {"zh": "低头吃草，发出咔嚓声。", "en": "Eats grass, munching sound."},
        {"zh": "用角挑起小石子。", "en": "Taps small stones with horn."},
        {"zh": "抬头看向玩家，轻声嘶叫。", "en": "Looks at player, soft hiss."},
        {"zh": "舔舔嘴唇，发出满足声。", "en": "Licks lips, satisfied sound."},
        {"zh": "缓缓转动脖子，发出轻微嘶鸣。", "en": "Turns neck, light hiss."},
        {"zh": "闻闻地面，发出好奇声。", "en": "Sniffs ground, curious sound."},
        {"zh": "咀嚼食物，发出消化声。", "en": "Chews, digestive sounds."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "盯紧目标，发出警告声。", "en": "Locks on, warning sound."},
        {"zh": "低吼几声，露出锋利牙齿。", "en": "Growls, shows sharp teeth."},
        {"zh": "张开大口，发出嘶嘶声。", "en": "Opens mouth, hisses."},
        {"zh": "用角抵触地面，发出声音。", "en": "Taps horn, makes sound."},
        {"zh": "眼睛瞪大，发出威胁声。", "en": "Enlarges eyes, threatening sound."},
        {"zh": "身体前倾，发出嘶嘶声。", "en": "Cocks body, hisses."},
        {"zh": "低吼着靠近目标。", "en": "Approaches with growls."},
        {"zh": "我把头盾压低，朝你顶过来。", "en": "I lower my frill and charge at you."},
