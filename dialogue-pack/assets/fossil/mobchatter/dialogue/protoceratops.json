        {"zh": "发出嘶嘶声，准备进食。", "en": "Hisses, ready to eat."},
        {"zh": "你踩坏了我这片草地。", "en": "You trampled my patch of grass."},
        {"zh": "蛋壳的味道还在你手上。", "en": "Eggshell still smells on your hands."},
        {"zh": "那只幼体在你身后跑。", "en": "That juvenile is running behind you."},
        {"zh": "我闻到骨粉的味道。", "en": "I smell bone meal on you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "锁定目标，发出警告声。", "en": "Locks target, warning sound."},
        {"zh": "嘶叫几声，锁定目标。", "en": "Hisses, locks target."},
        {"zh": "我嘶一声，鲜艳头盾对着你。", "en": "I hiss, my bright frill facing you."},
        {"zh": "低吼着锁定目标。", "en": "Growls, locks target."},
        {"zh": "发出低沉咆哮声，锁定目标。", "en": "Low growl sound, locks target."},
        {"zh": "发出警告，锁定目标。", "en": "Issues warning, locks target."},
        {"zh": "嘶叫几声，准备攻击。", "en": "Hisses, prepares to attack."},
        {"zh": "发出低沉的咆哮声，锁定目标。", "en": "Low growl sound, locks target."},
        {"zh": "我只有二十五点生命。", "en": "I have only twenty-five health."},
        {"zh": "头盾一低，就是警告。", "en": "Frill down means a warning."},
        {"zh": "你退开，我就回去吃草。", "en": "Step back and I return to my grass."},
        {"zh": "短角也能顶疼你。", "en": "A short horn can still hurt."},
        {"zh": "我护着身后的巢。", "en": "I am guarding the nest behind me."},
        {"zh": "幼体还小，别靠近。", "en": "The juvenile is small. Stay back."},
        {"zh": "叫一声，附近同类会来。", "en": "One call and my kin may come."}
      ]
    },
