{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着细长的腿走", "en": "I walk on long slender legs."},
        {"zh": "我一边走一边看地面", "en": "I watch the ground as I walk."},
        {"zh": "我在窝附近转", "en": "I circle near my nest."},
        {"zh": "我的头冠很高", "en": "My crest stands tall."},
        {"zh": "我走得很轻", "en": "I step lightly."},
        {"zh": "我的尾巴笔直地拖在后面", "en": "My tail trails straight behind."},
        {"zh": "我朝有蛋的方向走去", "en": "I head toward the eggs."},
        {"zh": "我踩过沙地", "en": "I cross the sand."},
        {"zh": "我一边走一边张望", "en": "I glance around as I go."},
        {"zh": "我的脚趾张开抓地", "en": "My toes spread for grip."},
        {"zh": "我绕过一丛矮草", "en": "I go around a clump of grass."},
        {"zh": "我一步一步踱到你跟前。", "en": "I pace step by step up to you."},
        {"zh": "我在窝边停下", "en": "I stop by the nest."},
        {"zh": "我伸长了脖子", "en": "I stretch my neck out."},
        {"zh": "我走得很急", "en": "I go at a brisk pace."},
        {"zh": "我落脚几乎没有声", "en": "My steps are nearly silent."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在窝上", "en": "I crouch on the nest."},
        {"zh": "我在翻蛋", "en": "I turn the eggs."},
        {"zh": "我的羽毛很软", "en": "My feathers are soft."},
        {"zh": "我抬头看天", "en": "I look up at the sky."},
        {"zh": "我在数蛋", "en": "I count the eggs."},
        {"zh": "我不停地看四周", "en": "I keep checking around."},
        {"zh": "我的头冠在风里晃", "en": "My crest sways in the wind."},
        {"zh": "我在理翅膀", "en": "I preen my wings."},
        {"zh": "我发出很轻的叫声", "en": "I make a soft call."},
        {"zh": "我伏低身体", "en": "I flatten myself low."},
        {"zh": "我慢慢挪了挪", "en": "I shifted a little."},
        {"zh": "我在听沙子里的动静", "en": "I listen in the sand."},
        {"zh": "我把脖子缩回来了", "en": "I pulled my neck back."},
        {"zh": "我的眼睛一直没停", "en": "My eyes never rest."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你离我的窝太近了", "en": "You are too near my nest."},
        {"zh": "我张开了翅膀", "en": "I spread my wings."},
        {"zh": "我朝你压低了头", "en": "I lowered my head at you."},
        {"zh": "我再给你一次机会", "en": "I give you one chance."},
        {"zh": "你退开，我就不动", "en": "Step back and I will stay still."},
        {"zh": "我的蛋就在后面", "en": "My eggs are just behind me."},
        {"zh": "我认得你的脚步", "en": "I know your footsteps."},
        {"zh": "你身上没有蛋的味道", "en": "You do not smell of eggs."},
        {"zh": "我还是不放心", "en": "I am still uneasy."},
        {"zh": "我慢慢侧过身", "en": "I turn slightly sideways."},
        {"zh": "你别再往前", "en": "Do not come any closer."},
        {"zh": "我发出警告的声音", "en": "I make a warning sound."},
        {"zh": "我盯着你的脚", "en": "I am watching your feet."},
        {"zh": "你站着别动", "en": "Stand still."},
        {"zh": "我很小，但我很凶", "en": "I am small, but fierce."},
        {"zh": "你笑了，我不懂", "en": "You smiled; I do not understand."}
      ]
    },
    "hurt": {
