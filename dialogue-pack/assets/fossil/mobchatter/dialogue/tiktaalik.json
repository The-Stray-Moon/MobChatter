    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "尾巴一甩，溅起水花一片。", "en": "Tail lashing, splashing water everywhere."},
        {"zh": "嘴巴一张，水流进嘴里。", "en": "Mouth opens, water rushing in."},
