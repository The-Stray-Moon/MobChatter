        {"zh": "目光闪烁，锁定目标！", "en": "Glances, locks on target."},
        {"zh": "盯住玩家，准备攻击！", "en": "Fixes on player, ready to attack."},
        {"zh": "游到玩家，准备猎食！", "en": "Approaches player, ready to feed."},
        {"zh": "盯着你，心生恶意！", "en": "Stares, malevolent intent."},
        {"zh": "眼神锐利，步步紧逼！", "en": "Sharp eyes, closing in."},
        {"zh": "锁定目标，蓄势待发！", "en": "Targets you, ready to strike."},
        {"zh": "盯着你，准备行动！", "en": "Stares, about to act."},
        {"zh": "盯着你，准备捕食！", "en": "Fixes on you, ready to eat."},
        {"zh": "眼神凝视，威胁玩家！", "en": "Glares, threatens player."}
