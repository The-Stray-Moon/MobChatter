        {"zh": "利齿紧咬，猎物痛苦。", "en": "Sharp teeth bite, prey in pain."},
        {"zh": "挥动四肢，将猎物撕裂。", "en": "Limb swinging, prey torn apart."},
        {"zh": "身体扭动，吞噬猎物。", "en": "Body writhing, engulfing prey."},
        {"zh": "尾巴摆动，水花四溅。", "en": "Tail swaying, water splashing."},
        {"zh": "利爪撕扯，血腥气味。", "en": "Sharp claws tearing, bloody scent."},
        {"zh": "鱼鳍拍打，水面波动。", "en": "Fins flapping, water ripples."},
        {"zh": "一口咬下去，水变红。", "en": "One bite and the water turns red."},
        {"zh": "鳍足按住，牙齿收尾。", "en": "Fins pin it down. Teeth finish it."},
        {"zh": "我扭身把它拖下水。", "en": "I twist and drag it under."},
        {"zh": "下颌一合，骨头作响。", "en": "My jaw snaps shut with a crack."},
        {"zh": "我甩头撕开一道口子。", "en": "A shake of my head tears it open."},
        {"zh": "泥水翻起，猎物挣扎。", "en": "Mud swirls as the prey thrashes."},
        {"zh": "它挣脱了，我再扑一次。", "en": "It breaks free. I lunge again."},
        {"zh": "我用前鳍把它压住。", "en": "I hold it down with my forefin."},
        {"zh": "腥味让我更饿了。", "en": "The smell of blood makes me hungrier."},
        {"zh": "这一口没咬空。", "en": "This bite did not miss."}
      ]
    },
