        {"zh": "陆地上的碰撞，让我生气！", "en": "Land collision, makes me angry!"},
        {"zh": "陆地上的家伙，别挡路！", "en": "Land creature, get out of my way!"},
        {"zh": "别碰我，否则后果自负！", "en": "Don't touch me, consequences!"},
        {"zh": "水里我快，岸上慢。", "en": "Fast in water, slow on shore."},
        {"zh": "陆地上，我要保护自己！", "en": "On land, I must defend!"},
        {"zh": "陆地上的争斗，很不妙！", "en": "Land conflict, not good!"},
        {"zh": "陆地上的碰撞，让我暴怒！", "en": "Land collision, enraged!"}
      ]
    },
