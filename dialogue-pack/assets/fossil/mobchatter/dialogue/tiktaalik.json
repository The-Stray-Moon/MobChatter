    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜咕噜，扑通入水！", "en": "Roo goo, splash in!"},
        {"zh": "尾巴摆动，冲向前方！", "en": "Tail swishes, charges ahead!"},
        {"zh": "游过泥潭，缓慢前行！", "en": "Glides through mud, slow and steady."},
        {"zh": "水面一跃，掠过目标！", "en": "Jumps from water, snatches prey!"},
        {"zh": "脚掌触地，蹒跚前行！", "en": "Feet touch ground, shuffles along."},
        {"zh": "低头探水，寻找猎物！", "en": "Snouts in water, hunts for prey."},
        {"zh": "水面下潜，无声无息！", "en": "Sinks underwater, silent and stealthy."},
        {"zh": "四肢并用，勉强前行！", "en": "Struggles with all fours."},
        {"zh": "尾巴摆动，寻找猎物！", "en": "Tail swings, hunts for prey."},
        {"zh": "水面掠过，快速消失！", "en": "Skims across water, vanishes fast."},
        {"zh": "鳍足撑起身体，往前挪。", "en": "My fins push my body forward."},
        {"zh": "浅滩里，我比水更快。", "en": "In the shallows I am faster than the water."},
        {"zh": "泥浆贴着我的肚皮滑过。", "en": "Mud slides along my belly."},
        {"zh": "我甩尾借力，窜过石缝。", "en": "A tail flick carries me past the stones."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静游弋，享受时光！", "en": "Stops, floats, enjoys itself."},
        {"zh": "仰望天空，心情复杂！", "en": "Looks up, mixed feelings."},
        {"zh": "静静歇息，等待时机！", "en": "Pauses, waits for the right time."},
        {"zh": "张嘴吐泡，放松心情！", "en": "Opens mouth, releases bubbles."},
        {"zh": "低头看水，寻找食物！", "en": "Looks in water, searches for food."},
        {"zh": "摆动身体，舒展筋骨！", "en": "Waves body, stretches."},
        {"zh": "静静游动，适应环境！", "en": "Swims calmly, adjusts to surroundings."},
        {"zh": "慢慢游动，享受自由！", "en": "Goes slow, enjoys freedom."},
        {"zh": "静静地，享受片刻！", "en": "Quietly, enjoys the moment."},
        {"zh": "停歇水面，观察四周！", "en": "Pauses on water, watches around."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
