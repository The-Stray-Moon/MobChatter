{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轻轻划水，寻找食物。", "en": "Gently swims, searching for food."},
        {"zh": "用触角探索周围水域。", "en": "Uses antennae to explore surroundings."},
        {"zh": "缓缓游动，保持平静。", "en": "Slowly moves, staying calm."},
        {"zh": "感受水流，调整方向。", "en": "Feels the current, adjusting course."},
        {"zh": "快速避开敌害。", "en": "Quickly avoids predators."},
        {"zh": "在藻类间穿梭。", "en": "Swims through algae."},
        {"zh": "轻触水面，呼吸空气。", "en": "Gently touches water surface to breathe."},
        {"zh": "在岩缝中寻找庇护。", "en": "Seeks shelter in cracks."},
        {"zh": "夜间更加活跃。", "en": "More active at night."},
        {"zh": "避开阳光直射。", "en": "Avoids direct sunlight."},
        {"zh": "十几条小腿一齐划水。", "en": "A dozen little legs paddle together."},
        {"zh": "我沿着沙底往前爬。", "en": "I creep along the sandy bottom."},
        {"zh": "水藻一晃，我换了个方向。", "en": "The weed sways; I change course."},
        {"zh": "奥陶纪的水，还是这么凉。", "en": "Ordovician water is still this cold."},
        {"zh": "我在石头背面慢慢挪。", "en": "I inch along the underside of a stone."},
        {"zh": "背甲划出一道浅浅的痕。", "en": "My shell leaves a shallow groove."},
        {"zh": "水流一推，我就顺势走。", "en": "A push of current carries me along."},
        {"zh": "我太小了，几乎看不见。", "en": "I am so small I am almost unseen."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把自己埋进沙里。", "en": "I bury myself in the sand."},
        {"zh": "用触须轻触同伴。", "en": "Taps nearby with antennae."},
        {"zh": "悠闲地旋转身体。", "en": "Rotates leisurely."},
        {"zh": "仔细检查自己的外壳。", "en": "Carefully checks exoskeleton."},
        {"zh": "水底的泥沙很软。", "en": "The silt on the riverbed is soft."},
        {"zh": "等待时机觅食。", "en": "Waits for food opportunities."},
        {"zh": "缓慢舒展身体。", "en": "Slowly extends body."},
        {"zh": "静静观察周围环境。", "en": "Quietly observes surroundings."},
        {"zh": "享受清晨的凉爽。", "en": "Enjoys cool morning."},
        {"zh": "在水面轻轻起伏。", "en": "Gently surfs on water surface."},
        {"zh": "我把自己埋进细沙。", "en": "I bury myself in fine sand."},
        {"zh": "复眼里全是细碎的光。", "en": "My compound eyes hold scattered light."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "靠近玩家，观察动静。", "en": "Approaches player, observing movements."},
        {"zh": "用触须轻触玩家。", "en": "Taps player with antennae."},
        {"zh": "警惕地看玩家几眼。", "en": "Looks suspiciously at player."},
        {"zh": "靠近玩家，寻找食物。", "en": "Approaches player, searching for food."},
        {"zh": "触须碰了碰你的靴子边。", "en": "My antennae brush the edge of your boot."},
        {"zh": "试图靠近玩家。", "en": "Tries to approach player."},
        {"zh": "轻触玩家以示友好。", "en": "Taps player as a friendly gesture."},
        {"zh": "靠近玩家，试探一番。", "en": "Approaches player, testing reactions."},
        {"zh": "慢慢靠近玩家。", "en": "Slowly approaches player."},
        {"zh": "用触角轻触玩家。", "en": "Taps player with antennae gently."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身体一震，我摇摇晃晃地游着。", "en": "Shudder, I swim unsteadily."},
        {"zh": "尾巴轻轻摆动，我感到不适。", "en": "Tail sways, I feel unwell."},
        {"zh": "我慢慢游动，感觉虚弱。", "en": "Move slowly, feeling weak."},
        {"zh": "缓慢地游着，我似乎受伤了。", "en": "Move slowly, wounded."},
        {"zh": "受了伤，我小心翼翼地游。", "en": "Wounded, I swim cautiously."},
        {"zh": "我游得更慢，伤口在作痛。", "en": "Move slower, wound aches."},
        {"zh": "伤口在流血，我努力游。", "en": "Bleeding, I struggle to swim."},
        {"zh": "伤口处渗出血来，我游得更慢。", "en": "Wound bleeding, slower swim."},
        {"zh": "伤口令我游动困难，我努力。", "en": "Wound hard, struggle swim."},
        {"zh": "伤口疼痛，我游得很慢。", "en": "Wound pains, slow swim."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你的光太耀眼，我快被烤熟了！", "en": "Your light is too bright, almost cooked me!"},
        {"zh": "快靠近我，我要享受阳光！", "en": "Come closer, I want sunbathing!"},
        {"zh": "别这么快靠近，我怕冷！", "en": "Don't come too close, I'm cold!"},
        {"zh": "你闻起来像是海洋的味道！", "en": "You smell like the sea!"},
        {"zh": "我需要阳光来维持体温！", "en": "I need sun for warmth!"},
        {"zh": "快点！给点光亮吧！", "en": "Quick, give me some light!"},
        {"zh": "不要这样看着我！吓到我了！", "en": "Don't stare at me, it scares me!"},
        {"zh": "快来帮我晒晒背！", "en": "Come and warm my back!"},
        {"zh": "阳光是我在水中的能量来源！", "en": "Sunlight is my energy in water!"},
        {"zh": "我在这里晒晒太阳，你别打扰我！", "en": "I'm sunbathing here, leave me alone!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "快躲开！我会扎你！", "en": "Move away! I'll stab you!"},
        {"zh": "你太重了，我差点被撞飞！", "en": "You're too heavy, almost knocked me away!"},
        {"zh": "小心！我的刺不是玩具！", "en": "Be careful! My spikes are not toys!"},
        {"zh": "我的壳被你的靴子压住。", "en": "Your boot is pinning my shell."},
        {"zh": "你太慢了，我快扎你了！", "en": "You're too slow, almost stabbed!"},
        {"zh": "快闪开，我要扎过去！", "en": "Move out of the way, I'm coming through!"},
        {"zh": "小心我的长刺！", "en": "Watch out for my long spines!"},
        {"zh": "你太笨拙了，我撞到你了！", "en": "You're clumsy, I bumped into you!"},
        {"zh": "别这么靠近，我快扎你了！", "en": "Don't come so close, I'm about to stab!"},
        {"zh": "快退后，别逼我动手！", "en": "Back off, don't逼 me!动手!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "求求你，来陪我吧！", "en": "Please, come be with me!"},
        {"zh": "我要找个伴侣，来吧！", "en": "I want a mate, come on!"},
        {"zh": "海底的泥沙里也有伴。", "en": "There are companions even in the seabed mud."},
        {"zh": "我孤独，找个伴吧！", "en": "I'm lonely, find a partner!"},
        {"zh": "你是最理想的伴侣！", "en": "You're the perfect partner!"},
        {"zh": "和我一起，享受生活！", "en": "Be with me, enjoy life!"},
        {"zh": "快点，别让机会溜走！", "en": "Hurry, don't let the chance pass!"},
        {"zh": "我等你，做我的伴侣！", "en": "I wait for you, be my mate!"},
        {"zh": "和我在一起，你不会寂寞！", "en": "Be with me, you won't be lonely!"},
        {"zh": "找个伴侣，让我们一起生存！", "en": "Find a mate, let's survive together!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "触碰我鳞片，感受古老的力量！", "en": "Feel the ancient power through my scales."},
        {"zh": "你侵犯了我的领地！", "en": "You intrude upon my territory!"},
        {"zh": "我是三叶虫的后裔，静谧的守护者！", "en": "Descendant of trilobites, the guardian of peace!"},
        {"zh": "水面下是我的家，你听到了吗？", "en": "Home is beneath the water's surface, do you hear?"},
        {"zh": "小小的身体，蕴含巨大的勇气！", "en": "Small body, great courage within."},
        {"zh": "我的生肉，鲜美无比！", "en": "My raw meat, extremely delicious."},
        {"zh": "你不能伤害我，我是神圣的！", "en": "You shall not harm me, I am sacred!"},
        {"zh": "幼小的生命，是新的希望！", "en": "Young life, a new hope!"},
        {"zh": "夜晚来临，我更加活跃！", "en": "Nightfall, my activity increases."},
        {"zh": "水是我们的生命之源！", "en": "Water is our source of life!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物靠近，准备出击！", "en": "Prey approaches, prepare to strike!"},
        {"zh": "你逃不掉的，我的猎物！", "en": "You can't escape, my prey!"},
        {"zh": "耐心等待，猎物自投罗网！", "en": "Patience, the prey comes to me."},
        {"zh": "小小的身躯，却是致命的武器！", "en": "Small body, deadly weapon."},
        {"zh": "我的刺能刺穿你的梦！", "en": "My spines pierce your dreams!"},
        {"zh": "你是我的，无法逃脱！", "en": "Mine, no escape!"},
        {"zh": "猎物已锁定，猎杀开始！", "en": "Prey locked, hunt begins!"},
        {"zh": "用你的力量，填满我的肚子！", "en": "Fill my belly with your strength!"},
        {"zh": "等待，然后出击，精准打击！", "en": "Wait, then strike, precise attack."},
        {"zh": "我的目标，就是你的终点！", "en": "My target, your end point!"},
        {"zh": "水一动，我缩进了壳。", "en": "The water moves; I pull into my shell."},
        {"zh": "有东西挡了我的路。", "en": "Something blocks my path."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "锁定目标，一击必杀！", "en": "Target locked, one strike to kill!"},
        {"zh": "我的攻击，无处不在！", "en": "My attacks, everywhere!"},
        {"zh": "用我的刺，给它一点教训！", "en": "Teach it a lesson with my spines."},
        {"zh": "不要轻视，我的攻击！", "en": "Do not underestimate my attack."},
        {"zh": "我的攻击，致命一击！", "en": "My attack, fatal blow."},
        {"zh": "我的刺，它的噩梦！", "en": "My spines, its nightmare."},
        {"zh": "瞄准，射击，结束战斗！", "en": "Target, shoot, end the fight."},
        {"zh": "我的攻击，让你颤抖！", "en": "My attack, makes you tremble."},
        {"zh": "用我的力量，结束战斗！", "en": "Use my power to end the battle."},
        {"zh": "攻击开始，战斗不息！", "en": "Attack begins, battle continues!"},
        {"zh": "我只是想过去而已。", "en": "I only want to get past."},
        {"zh": "我举起尾刺，虚张声势。", "en": "I raise my tail spine, all bluff."}
      ]
    },
