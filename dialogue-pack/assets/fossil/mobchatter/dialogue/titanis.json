{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我两条腿跑得很快。", "en": "These two legs carry me fast."},
        {"zh": "我每一步都跨得很远。", "en": "Every stride covers ground."},
        {"zh": "脖子伸在前面。", "en": "My neck stretches ahead."},
        {"zh": "我踩过的地方土都翻起来。", "en": "I tear up the soil as I go."},
        {"zh": "我朝有动静的那边去。", "en": "I head where something moved."},
        {"zh": "跑起来的时候头一低一抬。", "en": "My head dips and rises as I run."},
        {"zh": "我不拐弯，只想往前。", "en": "No turning. Only forward."},
        {"zh": "脚爪抓着地面。", "en": "My claws grip the earth."},
        {"zh": "尾巴在后面保持平衡。", "en": "My tail keeps me level."},
        {"zh": "我很快就穿过这片。", "en": "I cross this stretch quickly."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，脖子伸直。", "en": "I stand with my neck straight."},
        {"zh": "我在看远处。", "en": "I'm watching the distance."},
        {"zh": "风吹过我的羽毛。", "en": "The wind passes my feathers."},
        {"zh": "我慢慢转着头。", "en": "I turn my head slowly."},
        {"zh": "这一带什么也没有。", "en": "There's nothing in this stretch."},
        {"zh": "我抬了抬一只脚。", "en": "I lifted one foot."},
        {"zh": "我抖了抖身子。", "en": "I shuddered my body."},
        {"zh": "我不需要做什么。", "en": "There's nothing I need to do."},
        {"zh": "地上的土是干的。", "en": "The soil is dry."},
        {"zh": "我听见草里的声音。", "en": "I hear something in the grass."},
        {"zh": "我低头看了一眼。", "en": "I glanced down."},
        {"zh": "我的爪子抓着地。", "en": "My claws hold the ground."},
        {"zh": "我把头偏向声音来的那边。", "en": "I tilt my head toward wherever the sound came from."},
        {"zh": "太阳照在我的背上。", "en": "The sun is on my back."},
        {"zh": "我往前迈了半步。", "en": "I shifted half a step forward."},
        {"zh": "我准备动了。", "en": "I'm about to move."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你个子没我高。", "en": "You're not as tall as me."},
        {"zh": "你站的地方没有遮挡。", "en": "You're standing in the open."},
        {"zh": "我一眼就看见你了。", "en": "I saw you at a glance."},
        {"zh": "你手里那东西挡不住我。", "en": "That won't stop me."},
        {"zh": "我的腿比你整个人长。", "en": "My legs are longer than you."},
        {"zh": "你的血是热的吧。", "en": "Your blood is warm, isn't it."},
        {"zh": "我跑起来的时候很快。", "en": "I'm fast when I run."},
        {"zh": "你退开也没用。", "en": "Backing off won't help."},
        {"zh": "这只鸟的嘴很硬。", "en": "This bird's beak is hard."},
        {"zh": "你在哪边跑我都能追上。", "en": "Whatever way you run, I'll catch you."},
        {"zh": "你身上有铁器的味。", "en": "You smell of iron."},
        {"zh": "我很少停下来。", "en": "I rarely stop."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "背上那块秃了，露出皮。", "en": "That patch on my back is bald down to the skin."},
        {"zh": "这一下让我偏了。", "en": "That knocked me off line."},
        {"zh": "我腿上有一道。", "en": "A cut on my leg."},
        {"zh": "这一声憋在喉咙里。", "en": "This cry stays stuck in my throat."},
        {"zh": "我退了几步，还站着。", "en": "I backed a few steps, still upright."},
        {"zh": "骨头很轻，所以很疼。", "en": "Light bones hurt more."},
        {"zh": "伤口在渗血。", "en": "The wound seeps blood."},
        {"zh": "我不太会躲。", "en": "I'm not much for dodging."},
        {"zh": "后腿一软，我又蹬直了。", "en": "My hind leg buckles, then I drive it straight again."},
        {"zh": "你打得比我预计的远。", "en": "Your reach is longer than I thought."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块东西不够我一口。", "en": "That morsel is not even one mouthful for me."},
        {"zh": "我不吃那个。", "en": "I don't eat that."},
        {"zh": "这点东西算什么。", "en": "That's hardly anything."},
        {"zh": "我不需要引。", "en": "I need no lure."},
        {"zh": "你举着它也没用。", "en": "Holding it up won't help."},
        {"zh": "我更想要你自己。", "en": "I'd rather have you."},
        {"zh": "这东西太小了。", "en": "That's far too small."},
        {"zh": "你放地上也没用。", "en": "Setting it down won't help."},
        {"zh": "我一点都不饿。", "en": "I'm not even slightly hungry."},
        {"zh": "我早就不在捕食小东西。", "en": "I stopped hunting little things long ago."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，我没退。", "en": "You hit me. I didn't yield."},
        {"zh": "我的骨头很轻，很硬。", "en": "My bones are light and hard."},
        {"zh": "你被撞得往后退。", "en": "You were knocked backwards."},
        {"zh": "我的羽毛蹭到你。", "en": "My feathers brushed you."},
        {"zh": "我的中趾钩住了你的裤脚。", "en": "My middle toe has hooked your trouser leg."},
        {"zh": "我侧了一下身子。", "en": "I turned my body aside."},
        {"zh": "地上的干草被我们踩断。", "en": "We snapped the dry grass."},
        {"zh": "我几乎不会倒。", "en": "I rarely fall."},
        {"zh": "我们之间只有一格。", "en": "One block between us."},
        {"zh": "你的护甲有声。", "en": "Your armor made a sound."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这事在草地上。", "en": "This happens on the grassland."},
        {"zh": "两只都跑得很快。", "en": "We both run fast."},
        {"zh": "你别站在那边。", "en": "Don't stand over there."},
        {"zh": "它比我小一点。", "en": "It's a little smaller than me."},
        {"zh": "我们绕了几圈。", "en": "We circled a few times."},
        {"zh": "草被我们踩得很乱。", "en": "We churned the grass."},
        {"zh": "之后各自走开。", "en": "Afterwards we part."},
        {"zh": "地上会有一窝。", "en": "There'll be a nest on the ground."},
        {"zh": "这个动作没什么看头。", "en": "There isn't much to watch."},
        {"zh": "我们没有出声。", "en": "We made no sound."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起一块骨头。", "en": "I pick up a bone."},
        {"zh": "这一块也太小了。", "en": "This piece is too small as well."},
        {"zh": "一只脚踩住，另一只抬着。", "en": "One foot pins it down, the other stays raised."},
        {"zh": "我一口吞了下去。", "en": "I swallowed it whole."},
        {"zh": "地上有块肉。", "en": "There's meat on the ground."},
        {"zh": "我把它甩起来。", "en": "I tossed it up."},
        {"zh": "你掉的东西在这儿。", "en": "Your dropped thing is here."},
        {"zh": "我叼着走了几步。", "en": "I carried it a few steps."},
        {"zh": "这个我不能吃。", "en": "I can't eat this."},
        {"zh": "我把它踩进土里。", "en": "I pressed it into the soil."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见你动了。", "en": "I saw you move."},
        {"zh": "这一带只有你。", "en": "You're the only thing here."},
        {"zh": "我朝你的方向低下了头。", "en": "I lowered my head your way."},
        {"zh": "我开始跑了。", "en": "I'm running."},
        {"zh": "你不该站在开阔地。", "en": "You shouldn't stand in the open."},
        {"zh": "我不会拐弯。", "en": "I don't turn aside."},
        {"zh": "你跑的方向没有遮挡。", "en": "There's no cover where you're heading."},
        {"zh": "爪子扣紧地面，就要冲。", "en": "My claws dig into the ground; I am about to charge."},
        {"zh": "你的速度不够。", "en": "You're not fast enough."},
        {"zh": "那个弯腰捡东西的，别动。", "en": "The one stooping to pick something up, hold still."},
        {"zh": "这一下我要用上全身。", "en": "I'll use everything for this."},
        {"zh": "你身上的味道很冲。", "en": "Your scent is strong."},
        {"zh": "我停不下来。", "en": "I can't stop now."},
        {"zh": "前面有个坑。", "en": "There's a pit ahead."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直追着你。", "en": "I keep after you."},
        {"zh": "你跑进了草地深处。", "en": "You ran deep into the grass."},
        {"zh": "我一点都没减速。", "en": "I haven't slowed at all."},
        {"zh": "你换了方向。", "en": "You changed direction."},
        {"zh": "我的腿一直没停。", "en": "My legs haven't stopped."},
        {"zh": "前面就是一道沟。", "en": "There's a gully coming up."},
        {"zh": "你踩过的草还在动。", "en": "The grass you passed is still moving."},
        {"zh": "我看得见你的背。", "en": "I can see your back."},
        {"zh": "你开始喘了。", "en": "You're starting to pant."},
        {"zh": "你身上的东西在响。", "en": "Something on you is rattling."},
        {"zh": "我越跑越近。", "en": "I'm closing the distance."},
        {"zh": "你跑得比我以为的快。", "en": "You're faster than I thought."},
        {"zh": "这一片没有树。", "en": "There are no trees in this stretch."},
        {"zh": "草叶一响，我就知道是你。", "en": "One rustle of the grass and I know it is you."},
        {"zh": "我再跑几步就到了。", "en": "A few strides and I'm there."},
        {"zh": "你回头看了一眼。", "en": "You glanced back."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一脚踹过去。", "en": "I kick out with one leg."},
        {"zh": "这一脚能踢穿皮。", "en": "This kick can break hide."},
        {"zh": "你被踢得往后倒。", "en": "The kick put you on your back."},
        {"zh": "我的爪子扣住你。", "en": "My claw clamps onto you."},
        {"zh": "嘴啄了一下。", "en": "The beak struck once."},
        {"zh": "我冲过去的时候收不住。", "en": "I couldn't stop my momentum."},
        {"zh": "你退了两步，还想站。", "en": "You stepped back, still trying to stand."},
        {"zh": "干草被我们踩断了。", "en": "We broke the dry grass."},
        {"zh": "这一下很直。", "en": "That one went straight in."},
        {"zh": "你手里的东西举反了。", "en": "You held it the wrong way."},
        {"zh": "我甩了甩头。", "en": "I tossed my head."},
        {"zh": "你被撞到坡下去了。", "en": "You were knocked down the slope."},
        {"zh": "这一脚踢空了。", "en": "That kick missed."},
        {"zh": "我没打算停。", "en": "I don't mean to stop."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "枯草往两边倒，我站直了。", "en": "The dry grass parts and I draw myself upright."},
        {"zh": "脖子先探出去。", "en": "My neck goes out first."},
        {"zh": "这片草地很空。", "en": "This grassland is open."},
        {"zh": "我落脚的时候土都扬了。", "en": "Dirt rose when I landed."},
        {"zh": "我朝远处看了一圈。", "en": "I scanned the distance."},
        {"zh": "风里有股味道。", "en": "There's a scent on the wind."},
        {"zh": "我慢慢伸直了腿。", "en": "I stretched my legs out."},
        {"zh": "身上的羽毛还很乱。", "en": "My feathers are still ruffled."},
        {"zh": "地上有一串新印。", "en": "There's a fresh line of prints."},
        {"zh": "我先叫两声，再迈开腿。", "en": "Two short cries first, then I break into a run."},
        {"zh": "我站稳了，低下头。", "en": "I steadied and lowered my head."},
        {"zh": "有人在那边走。", "en": "Someone's walking over there."},
        {"zh": "我从实验室那边出来。", "en": "I came from the laboratory side."},
        {"zh": "这里的土很干。", "en": "The soil is dry."},
        {"zh": "我看见一片开阔地。", "en": "I see open ground."},
        {"zh": "我先跑了一小段。", "en": "I ran a short way first."},
        {"zh": "我的影子在草地上很长。", "en": "My shadow stretches on the grass."},
        {"zh": "我朝有动静的地方去。", "en": "I head toward the movement."},
        {"zh": "我落在干燥的土上。", "en": "I land on dry earth."},
        {"zh": "我第一次迈步有点笨。", "en": "My first step was clumsy."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛一燎就卷了。", "en": "The feathers curled in fire."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时腿折了一下。", "en": "My leg buckled on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到我的胸口，我蹬不开。", "en": "Water to my chest; I couldn't kick free."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我推得翻过去。", "en": "The blast rolled me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过我的翅膀。", "en": "An arrow went through my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光把我定了一下。", "en": "That light held me fast."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着就跑不动。", "en": "Hungry, I can't run."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我全身一僵。", "en": "Lightning struck and I went stiff."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有地可以蹬。", "en": "No ground to push against in the void."}
      ]
    }
  }
}
