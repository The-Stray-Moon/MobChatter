  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我摇着藤蔓", "en": "I sway my vines."},
        {"zh": "根扎得很深", "en": "My roots go deep."},
        {"zh": "我向前抽出一条须", "en": "I lash out one tendril."},
        {"zh": "我把卷须一条条伸出去。", "en": "I send out tendril after tendril."},
        {"zh": "我在土里挪一挪", "en": "I shift within the soil."},
        {"zh": "藤条拖着地", "en": "My vines drag the ground."},
        {"zh": "我从丛林里伸出去", "en": "I reach out of the jungle."},
        {"zh": "我朝有动静的方向倾", "en": "I lean toward the sound."},
        {"zh": "根须又深了一寸", "en": "My roots sink another inch."},
        {"zh": "我晃得叶子沙沙响", "en": "My leaves rustle as I sway."},
        {"zh": "我勾住了一根树枝", "en": "I hook onto a branch."},
        {"zh": "我慢慢挨过去", "en": "I edge over slowly."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在土里等", "en": "I wait in the soil."},
        {"zh": "藤蔓垂着", "en": "My vines hang loose."},
        {"zh": "这片丛林很湿", "en": "This jungle is damp."},
        {"zh": "我的花苞闭着", "en": "My bud stays closed."},
        {"zh": "我听见叶子上有虫", "en": "I hear insects on the leaves."},
        {"zh": "我长得像普通植物", "en": "I look like ordinary plants."},
        {"zh": "根把我钉在洞里", "en": "Roots pin me to the cave."},
        {"zh": "我慢慢卷起一片叶", "en": "I slowly curl a leaf."},
        {"zh": "我没有脚，但也算站得住", "en": "No feet, yet I hold my ground."},
        {"zh": "土里那点动静，我等它再近。", "en": "Something stirs in the dirt; I let it come closer."},
        {"zh": "我的藤有一节是枯的", "en": "One segment of my vine is dead."},
        {"zh": "洞里很暗", "en": "The cave is dark."},
        {"zh": "我从来不急着动", "en": "I never hurry."},
        {"zh": "我把自己摊开一点", "en": "I spread myself a little."},
        {"zh": "露水落在我叶上", "en": "Dew falls on my leaves."},
        {"zh": "土里有什么在动", "en": "Something moves in the soil."},
        {"zh": "我记着上一次猎物", "en": "I remember the last prey."},
        {"zh": "我的根须在下面绕", "en": "My roots wind below."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的根了", "en": "You stepped on my root."},
        {"zh": "你站在我的藤边上", "en": "You are standing on my vine."},
        {"zh": "你的脚踝正好在我藤边。", "en": "Your ankle sits right by my vine."},
        {"zh": "你的靴尖碰到我的卷须了。", "en": "Your boot tip is touching my tendril."},
        {"zh": "这些叶子不是装饰", "en": "These leaves are not decoration."},
        {"zh": "你听见叶子动了吗", "en": "Did you hear the leaves move?"},
        {"zh": "我没有脚，跑不掉，也不用跑", "en": "No feet, nowhere to run, no need to."},
        {"zh": "你的腿在我够得着的地方", "en": "Your legs are within my reach."},
        {"zh": "再半步，就到我的根边。", "en": "Half a step more and you reach my roots."},
        {"zh": "丛林里到处都是我", "en": "I am all over this jungle."},
        {"zh": "你背后也有藤", "en": "There are vines behind you too."},
        {"zh": "我把藤收紧了一点", "en": "I tightened a vine."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
