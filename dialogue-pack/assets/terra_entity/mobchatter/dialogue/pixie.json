{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着光痕飞过去。", "en": "I fly past trailing light."},
        {"zh": "我绕着你飞过半圈。", "en": "I arc halfway around you."},
        {"zh": "翅膀抖下一点粉。", "en": "My wings shed a little dust."},
        {"zh": "我飘在草尖上面。", "en": "I float just above the grass."},
        {"zh": "我慢慢靠近你的肩。", "en": "I drift toward your shoulder."},
        {"zh": "我不落地，只飘。", "en": "I never land, only hover."},
        {"zh": "我绕着老橡树，撒下一圈粉。", "en": "I circle the old oak, scattering a ring of dust."},
        {"zh": "我忽高忽低地飘。", "en": "I bob up and down."},
        {"zh": "我的光在夜里很亮。", "en": "My light is bright in the night."},
        {"zh": "我朝你背后的方向去。", "en": "I drift toward your back."},
        {"zh": "我在空中顿了顿。", "en": "I pause in the air."},
        {"zh": "我飘过去，没有声音。", "en": "I drift over without a sound."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在半空，不眨眼。", "en": "I hover, never blinking."},
        {"zh": "妖精的光，二十点护甲罩着。", "en": "Pixie light wrapped in twenty armor."},
        {"zh": "我的翅膀比纸还薄。", "en": "My wings are thinner than paper."},
        {"zh": "我身上缠着一圈光。", "en": "A ring of light wraps me."},
        {"zh": "我在听林子深处的响动。", "en": "I listen deep into the woods."},
        {"zh": "我的指尖有一点亮。", "en": "A small light sits at my fingertip."},
        {"zh": "我轻轻笑了一下。", "en": "I laugh softly once."},
        {"zh": "灰尘绕着我的光转。", "en": "Dust turns around my light."},
        {"zh": "我不需要落下休息。", "en": "I needn't land to rest."},
        {"zh": "我缓缓转过身。", "en": "I turn about slowly."},
        {"zh": "我在数这片林里的活物。", "en": "I count the living things here."},
        {"zh": "花在我下面开着。", "en": "Flowers bloom beneath me."},
        {"zh": "我的光把叶子照白。", "en": "My light bleaches the leaves."},
        {"zh": "我等着一个不知情的人。", "en": "I wait for someone unaware."},
        {"zh": "二十点护甲，也挡不住我的光。", "en": "Twenty armor doesn't stop my light."},
        {"zh": "我悬在叶尖上，慢慢数你的心跳。", "en": "I hover over a leaf tip, slowly counting your heartbeats."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看得见我，真好。", "en": "You can see me. How nice."},
        {"zh": "你身上有一点光，不是火。", "en": "There is a little light on you — not fire."},
        {"zh": "别打断我，翅膀刚张开。", "en": "Don't interrupt — my wings just opened."},
        {"zh": "你心跳吵得难听。", "en": "Your heartbeat is a racket."},
        {"zh": "我能看见你怕什么。", "en": "I can see what you fear."},
        {"zh": "你站的地方很暗。", "en": "You're standing somewhere dark."},
        {"zh": "我们近在咫尺。", "en": "We're within a breath of each other."},
        {"zh": "你的影在晃。", "en": "Your shadow is swaying."},
        {"zh": "我不必给理由。", "en": "I need give no reason."},
        {"zh": "你笑一下，我看看。", "en": "Smile, let me see."},
        {"zh": "这里是我的林子。", "en": "This wood is mine."},
        {"zh": "这片林子，我自己绕得出去。", "en": "I can find my way out of these woods."},
        {"zh": "我的光会跟着你。", "en": "My light will follow you."},
        {"zh": "直到你停下。", "en": "Until you stop."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光亮灭了一瞬。", "en": "My light guttered for an instant."},
        {"zh": "我的翅皱了一边。", "en": "One wing is crumpled."},
        {"zh": "我升到树梢，俯视你的伤。", "en": "I rise to the treetop and look down at your wound."},
        {"zh": "你的剑居然割到了我的翅膀。", "en": "Your sword actually cut my wing."},
        {"zh": "我散出一些光。", "en": "Some light spills from me."},
        {"zh": "光补上缺口，我又是完整的。", "en": "Light fills the gap; I am whole again."},
        {"zh": "我退到树影里，光只剩一线。", "en": "I retreat into the tree shadow, my light a thin line."},
        {"zh": "我的光暗了一格，笑也收了。", "en": "My light dims a notch, and my smile fades."},
        {"zh": "你让我有点生气。", "en": "You've annoyed me."},
        {"zh": "那就怨不得我。", "en": "Then don't blame me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那点光，太弱了。", "en": "That little glow is too weak."},
        {"zh": "你的东西没有魔力。", "en": "Your thing holds no magic."},
        {"zh": "妖精的光，比你的东西亮。", "en": "A pixie's light is brighter than anything you hold."},
        {"zh": "举高些。", "en": "Hold it higher."},
        {"zh": "这东西能换你一条命吗？", "en": "Would that buy your life?"},
        {"zh": "我不吃，我收集。", "en": "I don't eat. I collect."},
        {"zh": "它在我手里会亮。", "en": "It would glow in my hand."},
        {"zh": "给我吧。", "en": "Give it to me."},
        {"zh": "你这样举着很可笑。", "en": "You look foolish holding it like that."},
        {"zh": "我不需要它的味道。", "en": "I don't need its scent."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你穿过我的光了。", "en": "You passed through my light."},
        {"zh": "我往上一飘就避开。", "en": "One rise and I avoid you."},
        {"zh": "别用手抓空气。", "en": "Don't grab at the air."},
        {"zh": "你的手碰到我的翅。", "en": "Your hand touched my wing."},
        {"zh": "我身上有一点麻。", "en": "A tingle runs through me."},
        {"zh": "我退到树枝上方。", "en": "I back above the branches."},
        {"zh": "这点碰撞不碍飞行。", "en": "That doesn't stop my flying."},
        {"zh": "你的指节被烫了一下。", "en": "Your knuckle felt a burn."},
        {"zh": "我绕到你颈后。", "en": "I slip behind your neck."},
        {"zh": "我的光晕擦过你的肩甲。", "en": "My halo grazes your shoulder plate."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我对这些没兴趣。", "en": "I've no interest in that."},
        {"zh": "我的时间用在别处。", "en": "My time is spent elsewhere."},
        {"zh": "你连飞都不会。", "en": "You can't even fly."},
        {"zh": "林子里还有很多事。", "en": "There's much to do in the woods."},
        {"zh": "光不会为谁停留。", "en": "Light stays for no one."},
        {"zh": "你太快就老了。", "en": "You grow old far too fast."},
        {"zh": "别往这边凑。", "en": "Don't sidle over here."},
        {"zh": "这是个无聊的问题。", "en": "That's a dull question."},
        {"zh": "我要去巡我的林子。", "en": "I'm off to patrol my wood."},
        {"zh": "你可以退下了，妖精的尘别沾。", "en": "You may withdraw; do not touch pixie dust."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一点亮的东西。", "en": "Something bright."},
        {"zh": "这点光烫得我指尖发麻。", "en": "This little light numbs my fingertip."},
        {"zh": "这点光不纯。", "en": "This glow isn't pure."},
        {"zh": "我把它举高，让光透过去。", "en": "I hold it up and let the light pass through."},
        {"zh": "太重，我不要。", "en": "Too heavy, I'll leave it."},
        {"zh": "你掉了东西？", "en": "Did you drop something?"},
        {"zh": "那正好是我的。", "en": "That's mine now, fittingly."},
        {"zh": "我把它收进翅膀的光里。", "en": "I tuck it into the light of my wings."},
        {"zh": "它变暗了。", "en": "It dimmed."},
        {"zh": "我的翅膀亮得像灯。", "en": "My wings shine like a lamp."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经在这待太久了。", "en": "You've stayed here too long."},
        {"zh": "你被我套住了。", "en": "I've got you caught."},
        {"zh": "这个距离，我很快。", "en": "At this range I'm quick."},
        {"zh": "我的光开始亮了。", "en": "My light is brightening."},
        {"zh": "我翅上的光，像一小团粉。", "en": "My winglight is a small pink cloud."},
        {"zh": "你身后是树，前面是我。", "en": "Behind you a tree, before you me."},
        {"zh": "这片林子围住了你。", "en": "The wood has closed around you."},
        {"zh": "我的目光没松过。", "en": "My gaze never loosened."},
        {"zh": "现在，轮到我碰你了。", "en": "Now it is my turn to touch you."},
        {"zh": "眼睛别闭。", "en": "Don't shut your eyes."},
        {"zh": "妖精的粉末，先撒过来。", "en": "Fairy dust, scattered first."},
        {"zh": "你抬头也来不及。", "en": "Looking up won't be fast enough."},
        {"zh": "铁甲挡不住光的走向。", "en": "Iron armor cannot block the path of light."},
        {"zh": "我的翅膀停了，你的时间也停了。", "en": "My wings stop, and so does your time."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你的头转。", "en": "I circle your head."},
        {"zh": "我的光晃你的眼。", "en": "My light dazzles your eyes."},
        {"zh": "你往哪转我都在这边。", "en": "Wherever you turn, I'm here."},
        {"zh": "我快过你的手。", "en": "I'm quicker than your hands."},
        {"zh": "你的护甲没有缝也没用。", "en": "No seams in your armor won't help."},
        {"zh": "我的攻击走的是别的路。", "en": "My strikes take another path."},
        {"zh": "你听见翅声了吗？", "en": "Do you hear my wings?"},
        {"zh": "那只是风。", "en": "That was only wind."},
        {"zh": "我数第二声。", "en": "I count the second note."},
        {"zh": "我绕着你的耳朵飞。", "en": "I fly circles around your ear."},
        {"zh": "这让我很开心。", "en": "That delights me."},
        {"zh": "我的光，是骗你的。", "en": "My light is a trick."},
        {"zh": "你的头顶没有遮挡。", "en": "Nothing covers your head."},
        {"zh": "一触即可。", "en": "A single touch is enough."},
        {"zh": "正是此刻。", "en": "This very moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的指尖碰了你的颈。", "en": "My fingertip touched your neck."},
        {"zh": "我的指尖点在你颈侧，光透进去。", "en": "My fingertip touches your neck and light seeps in."},
        {"zh": "你被震得后退。", "en": "The shock sends you back."},
        {"zh": "这一击无声无息。", "en": "That strike made no sound."},
        {"zh": "你按着胸口喘气。", "en": "You clutch your chest, gasping."},
        {"zh": "我拖着光痕，绕到你侧后。", "en": "Trailing light, I slip around behind you."},
        {"zh": "你的护甲一点用没有。", "en": "Your armor was no use at all."},
        {"zh": "我的攻击不是铁能挡的。", "en": "Iron cannot block my strikes."},
        {"zh": "我贴着你的耳后，又笑了一声。", "en": "I cling behind your ear and laugh again."},
        {"zh": "你听得见我的笑吗？", "en": "Can you hear me laughing?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里亮起一小点光。", "en": "A small light wakes in the wood."},
        {"zh": "我从花瓣间升起来。", "en": "I rise from between the petals."},
        {"zh": "光绕着我的身体成圈。", "en": "Light rings my body."},
        {"zh": "没有人看见我来了。", "en": "No one saw me arrive."},
        {"zh": "我停在半空，等着。", "en": "I hover and wait."},
        {"zh": "我的翅还在慢慢张开。", "en": "My wings are still unfurling."},
        {"zh": "这片林子今夜的客人是我。", "en": "Tonight I'm the guest of this wood."},
        {"zh": "我的笑声很轻。", "en": "My laugh is very soft."},
        {"zh": "夜露从叶尖滴下来。", "en": "Dew drips from the leaf tips."},
        {"zh": "水面上的光，把我托起来。", "en": "The light on the water lifts me up."},
        {"zh": "这里没人能拦我。", "en": "No one here can stop me."},
        {"zh": "妖精的光，绕着我转。", "en": "Fairy light circles me."},
        {"zh": "林间的光聚成我的形状。", "en": "The forest light gathers into my shape."},
        {"zh": "你们该走了，可你们不走。", "en": "You should leave, but you won't."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火碰到我的光，闪了一下。", "en": "Fire touches my light and it flares."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从空中坠下，翅膀乱扑。", "en": "I fall, wings beating wild."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水熄了我的光。", "en": "Water puts out my light."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把光吹散了一瞬。", "en": "The blast scatters my light for an instant."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西穿过我的光。", "en": "That pierced my light."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力与我身上的光撞了。", "en": "Magic clashes with the light I carry."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不是靠吃活着的。", "en": "Food isn't what keeps me alive."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我的光被吸走。", "en": "Lightning strikes and drains my glow."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里我的光很小。", "en": "My light is small in the void."}
      ]
    }
  }
}
