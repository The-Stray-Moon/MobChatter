  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘在主人身后", "en": "I drift behind my master."},
        {"zh": "我一掠而过雪地", "en": "I skim over the snow."},
        {"zh": "我飘过雪面，没留下脚印。", "en": "I drift over the snow without a print."},
        {"zh": "我一跳就滑出去一段", "en": "One hop slides me a stretch."},
        {"zh": "我绕着主人的脚边转", "en": "I circle around my master's feet."},
        {"zh": "我从雪堆上飘过去", "en": "I drift over the snowdrift."},
        {"zh": "我贴着地面蹭过去", "en": "I brush along the ground."},
        {"zh": "我一步一滑地跟着", "en": "I slip and slide along behind."},
        {"zh": "我在半空浮着走", "en": "I float along in the air."},
        {"zh": "我慢慢挪到队伍前面", "en": "I ease up to the front."},
        {"zh": "我又飘回主人肩边", "en": "I drift back by my master."},
        {"zh": "我绕了个小圈", "en": "I loop a small circle."}
      ]
    },
    "idle": {
