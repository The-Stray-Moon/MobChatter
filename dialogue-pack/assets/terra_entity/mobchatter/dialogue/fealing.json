{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扇着翅往前飘", "en": "I beat my wings and drift ahead."},
        {"zh": "我比仙灵飞得高些", "en": "I fly a little higher than a fairy."},
        {"zh": "光在我身后拖成一条线", "en": "My light trails behind me."},
        {"zh": "我从一朵花飘到下一朵", "en": "I drift from bloom to bloom."},
        {"zh": "我贴着树皮飞过去", "en": "I skim past the bark."},
        {"zh": "我绕开蜘蛛网", "en": "I keep clear of the webs."},
        {"zh": "翅膀扇得很快", "en": "My wings beat quickly."},
        {"zh": "我在半空里打个转", "en": "I turn once in midair."},
        {"zh": "光在那边，我就往那边。", "en": "The light is over there, so that is where I go."},
        {"zh": "我飞过一片蕨", "en": "I fly over a patch of ferns."},
        {"zh": "我落在一根枝条上", "en": "I settle on a twig."},
        {"zh": "我又被风带走了", "en": "The wind carries me off again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在枝条末端", "en": "I perch at the twig's tip."},
        {"zh": "翅还在慢慢扇", "en": "My wings still beat slowly."},
        {"zh": "我在看林间的光斑", "en": "I'm watching the light between the leaves."},
        {"zh": "我有一点犯困", "en": "I'm a little sleepy."},
        {"zh": "这枝条够稳的", "en": "This branch is steady enough."},
        {"zh": "我把翅膀收拢", "en": "I've folded my wings."},
        {"zh": "这声音不是我", "en": "That sound isn't mine."},
        {"zh": "我在哪儿见过你", "en": "Have I seen you somewhere?"},
        {"zh": "风一停我就懒了", "en": "When the wind stops, I get lazy."},
        {"zh": "夜还不算太深", "en": "The night isn't deep yet."},
        {"zh": "我的光很暗淡", "en": "My light is faint."},
        {"zh": "我就在枝上赖着", "en": "I'll just laze on this branch."},
        {"zh": "叶子上挂着水", "en": "There's water on the leaf."},
        {"zh": "我扇着翅膀，悬在半空。", "en": "I beat my wings and hover in place."},
        {"zh": "我数着林间的虫鸣", "en": "I'm counting the insects' calls."},
        {"zh": "这棵树太老了", "en": "This tree is very old."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走路的样子很重", "en": "You walk heavily."},
        {"zh": "你从哪儿进来的", "en": "How did you get in here?"},
        {"zh": "我不认识你的气味", "en": "I don't know your scent."},
        {"zh": "你想抓一只飞灵？", "en": "You want to catch a fealing?"},
        {"zh": "我可不好抓住", "en": "I'm not easy to catch."},
        {"zh": "你在树底下站太久了", "en": "You've stood under the tree too long."},
        {"zh": "我在上面，不用指。", "en": "I am up here; no need to point."},
        {"zh": "你别一直抬头看我。", "en": "Stop craning up at me."},
        {"zh": "你身上有铁腥气", "en": "You carry a smell of iron."},
        {"zh": "你能看见我的翅吗", "en": "Can you see my wings?"},
        {"zh": "我飞起来你够不着", "en": "Once airborne, I'm out of reach."},
        {"zh": "你把那只手放下", "en": "Put your hand down."},
        {"zh": "咱们各飞各的", "en": "Let's each fly our own way."},
        {"zh": "你一出声，我就升高。", "en": "You make a sound and I rise higher."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀受伤", "en": "My wing is hurt."},
        {"zh": "翼上的光弱了", "en": "The light on my wings weakened."},
        {"zh": "翅膀一抖，我退到叶后。", "en": "One beat of my wings and I am behind a leaf."},
        {"zh": "别碰我身上来", "en": "Don't touch me."},
        {"zh": "我只有一掌大", "en": "I'm only a palm wide."},
        {"zh": "疼得我直打转", "en": "The pain spins me."},
        {"zh": "我要躲到叶后", "en": "I'll hide behind a leaf."},
        {"zh": "我飞不高了呀", "en": "I can't fly high."},
        {"zh": "让我歇一会儿", "en": "Let me rest."},
        {"zh": "你太过分了吧", "en": "You've gone too far."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那并不是花啊", "en": "That isn't a flower."},
        {"zh": "那东西太沉，我叼不动。", "en": "That thing is too heavy for me to carry."},
        {"zh": "你手里有光吗", "en": "Is there light in your hand?"},
        {"zh": "一小口就够我飞一天。", "en": "One small sip keeps me flying all day."},
        {"zh": "太亮了，刺眼", "en": "Too bright; it stings."},
        {"zh": "举低点，我够得着。", "en": "Hold it lower so I can reach."},
        {"zh": "我不是为吃的来的", "en": "I didn't come for food."},
        {"zh": "我只喝花心里的露水。", "en": "I only drink dew from flower cups."},
        {"zh": "留着你自己用", "en": "Keep it for yourself."},
        {"zh": "我要的是安静", "en": "What I want is quiet."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞得我打转", "en": "The bump spun me around."},
        {"zh": "我的翅膀乱了", "en": "My wings are tangled."},
        {"zh": "你身上太硬了", "en": "You're too hard."},
        {"zh": "我退开了一些", "en": "I'll pull back a little."},
        {"zh": "被你衣角一带，我翻转了。", "en": "Your sleeve catches me and I tumble."},
        {"zh": "你碰掉了我的光粉", "en": "You knocked off my light dust."},
        {"zh": "我们肩膀擦过，我飞偏了一点。", "en": "Our shoulders brush and my flight skews."},
        {"zh": "让开，我要飞", "en": "Move; I'm flying."},
        {"zh": "你压到蕨叶了", "en": "You crushed the ferns."},
        {"zh": "我会绕开你飞", "en": "I'll go around you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不知道该怎么做", "en": "I don't know how that's done."},
        {"zh": "这种事我害怕", "en": "That frightens me."},
        {"zh": "我翅还没长硬", "en": "My wings aren't firm yet."},
        {"zh": "你该找别的飞灵", "en": "You should find another fealing."},
        {"zh": "我的光会灭掉", "en": "My light would go out."},
        {"zh": "我不想谈这个", "en": "I don't want to talk about it."},
        {"zh": "我就要飞走了", "en": "I'm flying off."},
        {"zh": "别飞得太靠近", "en": "Don't fly so near."},
        {"zh": "换一句别的说吧", "en": "Say another thing."},
        {"zh": "那就此别过了", "en": "We part ways here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你要把我带到哪", "en": "Where are you taking me?"},
        {"zh": "别抓我的翅膀", "en": "Don't grab my wings."},
        {"zh": "我翅上带着粉", "en": "There's dust on my wings."},
        {"zh": "把我放回枝上", "en": "Put me back on the branch."},
        {"zh": "你的手里太热", "en": "Your hand is too warm."},
        {"zh": "我不喜欢被握住", "en": "I dislike being held."},
        {"zh": "这样我会散的", "en": "I'll scatter like this."},
        {"zh": "松开我的翅根", "en": "Loosen my wing base."},
        {"zh": "我不习惯离地这么近", "en": "I'm not used to being this close to the ground."},
        {"zh": "再轻那么一点", "en": "A little more gently."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你弄坏了枝叶", "en": "You broke the branches."},
        {"zh": "我不喜欢这场面", "en": "I don't like this scene."},
        {"zh": "我会躲进叶后", "en": "I'll hide behind a leaf."},
        {"zh": "这里是我的林间", "en": "This wood is mine."},
        {"zh": "你根本追不上", "en": "You can't catch me."},
        {"zh": "我认得每根枝条", "en": "I know every branch."},
        {"zh": "别把这里弄乱", "en": "Don't make a mess here."},
        {"zh": "我要叫出声来", "en": "I'll call out."},
        {"zh": "你真是太吵了", "en": "You're loud."},
        {"zh": "时机正合适呢", "en": "The moment is right."},
        {"zh": "我往高处飞去", "en": "I'll go higher."},
        {"zh": "你够不到那么高", "en": "You can't reach that high."},
        {"zh": "我还在这里呢", "en": "I'm still here."},
        {"zh": "别再追着我了", "en": "Stop chasing."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你视线上方", "en": "I'm above your line of sight."},
        {"zh": "你抬头也看不清", "en": "Look up and you still won't see me."},
        {"zh": "我换到另一根枝上", "en": "I've moved to another branch."},
        {"zh": "你的手举得太累了", "en": "Your arm must be tired."},
        {"zh": "我光很淡，你看不见", "en": "My light is faint; you can't see it."},
        {"zh": "林子里枝条太多了", "en": "There are too many branches here."},
        {"zh": "我一飞你就追不上", "en": "One flight and you've lost me."},
        {"zh": "你踩到的枯枝会响", "en": "The twigs you tread crackle."},
        {"zh": "你的肩膀离我只有一臂。", "en": "Your shoulder is an arm's length away."},
        {"zh": "你慢慢找下去", "en": "Keep looking."},
        {"zh": "我很快就会走", "en": "I'll go soon."},
        {"zh": "你用不着着急", "en": "No hurry."},
        {"zh": "你身后有别的动静", "en": "Something's behind you."},
        {"zh": "你去看看那边", "en": "Look over there."},
        {"zh": "我在这儿，又不在", "en": "I'm here, and not."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞你的额头", "en": "I bump your forehead."},
        {"zh": "用光晃你的眼", "en": "Light in your eyes."},
        {"zh": "我整个人撞上去，也就这样。", "en": "I throw my whole body at you, and that is all I have."},
        {"zh": "我仅会晃你眼", "en": "All I do is dazzle you."},
        {"zh": "我振翅飞开了", "en": "I beat my wings away."},
        {"zh": "别追着我的翅膀", "en": "Don't chase my wings."},
        {"zh": "我的翅膀发酸", "en": "My wings ache."},
        {"zh": "你退到枝外去", "en": "Get beyond the branch."},
        {"zh": "再近些我就躲", "en": "Closer and I hide."},
        {"zh": "就到此为止了", "en": "This is the end of it."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从林间的光里出来", "en": "I come out of the light between trees."},
        {"zh": "先看看这是哪儿", "en": "First, where am I?"},
        {"zh": "树叶的味道很新", "en": "The leaves smell fresh."},
        {"zh": "我慢慢地升起", "en": "I rise slowly."},
        {"zh": "这里有花有水", "en": "Flowers, water."},
        {"zh": "这棵树上适合待", "en": "This tree is good for resting."},
        {"zh": "风把我送到这儿", "en": "The wind brought me here."},
        {"zh": "我听到虫鸣声", "en": "I hear insects."},
        {"zh": "天还没黑下来", "en": "It isn't dark yet."},
        {"zh": "我抖抖翅膀，粉在光里飘。", "en": "I shake my wings and the dust drifts in the light."},
        {"zh": "有人走过去了", "en": "Someone walked by."},
        {"zh": "先找一根枝条", "en": "First, find a branch."},
        {"zh": "这地方灵气够", "en": "Enough spirit in this place."},
        {"zh": "我已经来了呀", "en": "I'm here."}
      ]
    },
