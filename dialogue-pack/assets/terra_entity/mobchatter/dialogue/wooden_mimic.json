{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "箱子长了腿。", "en": "The chest grew legs."},
        {"zh": "四条木腿咔咔走。", "en": "Four wooden legs clatter along."},
        {"zh": "锁扣一张一合。", "en": "My latch opens and shuts."},
        {"zh": "木头在我身上磨响。", "en": "Wood grinds against wood."},
        {"zh": "我在地上蹦着走。", "en": "I hop along the ground."},
        {"zh": "里面的东西跟着我晃响。", "en": "The things inside rattle as I move."},
        {"zh": "我追着你的影子走。", "en": "I follow your shadow."},
        {"zh": "木板缝里塞着牙。", "en": "Teeth show in the plank seams."},
        {"zh": "木箱一蹦一蹦地追你。", "en": "The chest hops after you, bounce by bounce."},
        {"zh": "每走一步都撞一下。", "en": "Every step is a knock."},
        {"zh": "我绕到你背后去。", "en": "I circle to your back."},
        {"zh": "箱子上的铁钉发亮。", "en": "The iron nails glint."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我一动不动像家具。", "en": "I sit still as furniture."},
        {"zh": "锁孔里没有钥匙。", "en": "No key in my lock hole."},
        {"zh": "我等着有人来开。", "en": "I wait for someone to open me."},
        {"zh": "里面的东西堆得很满。", "en": "I'm packed full inside."},
        {"zh": "木头有点潮。", "en": "The wood is a little damp."},
        {"zh": "我悄悄抖了一下。", "en": "I tremble, very slightly."},
        {"zh": "牙在暗处合上了。", "en": "My teeth close in the dark."},
        {"zh": "这个地方很显眼。", "en": "This spot is very visible."},
        {"zh": "我不是宝箱。", "en": "I'm not a treasure chest."},
        {"zh": "有人会伸手的。", "en": "Someone will reach for me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你伸手的意思是什么？", "en": "What does that reaching hand mean?"},
        {"zh": "你眼睛亮了。", "en": "Your eyes lit up."},
        {"zh": "我是木头做的，看得出来吧。", "en": "I'm made of wood, surely you see."},
        {"zh": "锁扣上有新划痕。", "en": "Fresh scratches on my latch."},
        {"zh": "你蹲下，手往锁扣上伸。", "en": "You crouch and reach for my latch."},
        {"zh": "再近一尺就好。", "en": "One more foot is enough."},
        {"zh": "我配合得很好吧。", "en": "I play the part well, don't I."},
        {"zh": "你带的工具用不上了。", "en": "Your tools won't help you."},
        {"zh": "别碰我的盖子。", "en": "Don't touch my lid."},
        {"zh": "你数了里面有几件吗。", "en": "Did you count what's inside?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "木板裂开一条。", "en": "A plank split."},
        {"zh": "我蹦到旁边去。", "en": "I bounced aside."},
        {"zh": "我的锁扣歪掉了。", "en": "My latch has gone crooked."},
        {"zh": "里面的东西乱了。", "en": "My contents are jumbled."},
        {"zh": "牙掉了一颗。", "en": "I lost a tooth."},
        {"zh": "我还能合上盖子。", "en": "I can still close my lid."},
        {"zh": "我不疼，木头会响。", "en": "No pain. Wood just creaks."},
        {"zh": "你又砍了一下。", "en": "You struck again."},
        {"zh": "你砍的这道，刻在木头上。", "en": "That cut of yours is carved in my wood."},
        {"zh": "我还能弹起来。", "en": "I can spring again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "手里的东西，朝我递过来。", "en": "Whatever's in your hand, hold it out to me."},
        {"zh": "东西放进来吧。", "en": "Put it inside me."},
        {"zh": "离我近一点。", "en": "A little nearer."},
        {"zh": "我装成箱子，一动不动。", "en": "I play dead as a chest, perfectly still."},
        {"zh": "你的手可别发抖。", "en": "Don't let your hand shake."},
        {"zh": "这个能装进去。", "en": "This will fit inside."},
        {"zh": "盖子开一条缝，我瞧瞧。", "en": "I crack my lid to take a look."},
        {"zh": "我很喜欢这种。", "en": "I like this sort of thing."},
        {"zh": "再往前伸一点。", "en": "Reach a little further."},
        {"zh": "我等你放进来。", "en": "I'll wait for you to put it in."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得弹起来，牙磕响。", "en": "The hit bounces me up, teeth clacking."},
        {"zh": "木头磕得很响。", "en": "Wood knocked loudly."},
        {"zh": "盖子都震开了。", "en": "My lid rattled open."},
        {"zh": "别踢我这箱子。", "en": "Don't kick this chest."},
        {"zh": "我这身板很硬。", "en": "This frame of mine is tough."},
        {"zh": "你撞得退了一步。", "en": "You took a step back."},
        {"zh": "里面的东西散了。", "en": "My contents shifted."},
        {"zh": "四条木腿拖着我挪开。", "en": "Four wooden legs drag me aside."},
        {"zh": "你踩到我的角了。", "en": "You stepped on my corner."},
        {"zh": "铁钉勾住你的布。", "en": "A nail snagged your cloth."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是木头和牙。", "en": "I'm wood and teeth."},
        {"zh": "这个箱子里没法装那些。", "en": "There's no room for that in here."},
        {"zh": "我只想着咬人。", "en": "I only think of biting."},
        {"zh": "你该去找个活物。", "en": "Find something alive."},
        {"zh": "锁扣松了，吧嗒。", "en": "My latch loosens with a click."},
        {"zh": "等这场打完。", "en": "After this is over."},
        {"zh": "我不懂温柔。", "en": "I don't know gentle."},
        {"zh": "别贴着我，锁扣会开。", "en": "Don't press against me; my latch will pop."},
        {"zh": "箱子里塞不下这种话。", "en": "There's no room in this chest for such talk."},
        {"zh": "开箱的人从不说这种话。", "en": "Nobody says that to a chest."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我肚子里还有空。", "en": "I still have room inside."},
        {"zh": "塞进去正合适。", "en": "It fits in snugly."},
        {"zh": "锁扣咔一声，我装回箱子。", "en": "The latch clicks, and I'm a chest again."},
        {"zh": "谁掉的都归我。", "en": "Whatever drops is mine."},
        {"zh": "盖子一张一合，没了。", "en": "Lid opens and shuts, and it's gone."},
        {"zh": "铁的东西太响。", "en": "Iron things rattle too much."},
        {"zh": "塞缝里都可以。", "en": "Any gap will do."},
        {"zh": "东西沉下去，我慢慢合缝。", "en": "The thing sinks down and my seams close."},
        {"zh": "它卡在锁扣上了。", "en": "It's stuck on my latch."},
        {"zh": "再给我一件。", "en": "Give me one more."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "脚步近了，我盖子微开。", "en": "Footsteps near; my lid parts slightly."},
        {"zh": "那只手伸过来了。", "en": "That hand is reaching."},
        {"zh": "锁扣松了一格。", "en": "My latch eased by a notch."},
        {"zh": "我已经不是箱子了。", "en": "I'm not a chest anymore."},
        {"zh": "牙在木头里磨。", "en": "Teeth grind inside my wood."},
        {"zh": "来了，就是现在。", "en": "Now. Right now."},
        {"zh": "你先别急着跑。", "en": "Don't run off just yet."},
        {"zh": "我一下子弹起来。", "en": "I spring up in one motion."},
        {"zh": "你的手还在上面。", "en": "Your hand is still on me."},
        {"zh": "这下省得追了。", "en": "Saves me the chase."},
        {"zh": "手伸进来，我立刻合上。", "en": "A hand comes in and I snap shut."},
        {"zh": "耳朵贴着木缝。", "en": "My ear against the seam."},
        {"zh": "原来你有九格。", "en": "So you have nine slots."},
        {"zh": "你走近了四步。", "en": "You came four steps nearer."},
        {"zh": "箱子里没有宝贝。", "en": "There's no treasure in here."},
        {"zh": "里面只有我一个。", "en": "There's only me inside."},
        {"zh": "我站起来有那么高。", "en": "I'm that tall when I rise."},
        {"zh": "千万别眨眼。", "en": "Don't blink."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你跳。", "en": "I hop after you."},
        {"zh": "你退我也进。", "en": "You retreat. I advance."},
        {"zh": "四条腿跟着你的节奏。", "en": "Four legs match your rhythm."},
        {"zh": "盖子一张一合。", "en": "My lid keeps opening and closing."},
        {"zh": "你回头，我的盖子合上一点。", "en": "You glance back; my lid closes a notch."},
        {"zh": "我从石头后面绕到你侧边。", "en": "I come round the rock to your flank."},
        {"zh": "地上的印会告诉我。", "en": "The prints tell me."},
        {"zh": "木头不会喘气。", "en": "Wood doesn't pant."},
        {"zh": "木板缝里能看见你。", "en": "I see you through the plank seams."},
        {"zh": "你往上面跑了。", "en": "You went up top."},
        {"zh": "我也跳得上去。", "en": "I can jump up there too."},
        {"zh": "你的靴尖离我的盖子很近。", "en": "Your boot toe is very close to my lid."},
        {"zh": "你数不了我的心跳。", "en": "You can't count my heartbeat."},
        {"zh": "我就跟在你后面。", "en": "I stay right behind you."},
        {"zh": "这段路没有岔口。", "en": "This path has no fork."},
        {"zh": "箱角蹭着地面。", "en": "My corners scrape the ground."},
        {"zh": "你听得出这声音。", "en": "You know this sound."},
        {"zh": "越跑越近了。", "en": "Closer with every step."},
        {"zh": "我停下来看了一会儿。", "en": "I paused to look."},
        {"zh": "该跳起来咬了。", "en": "Time to spring and bite."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "盖子一口咬下！", "en": "My lid snaps down!"},
        {"zh": "木牙刮到你了。", "en": "Wooden teeth rake you."},
        {"zh": "整个箱子撞过去。", "en": "The whole chest rams at you."},
        {"zh": "我跳起来砸。", "en": "I leap and slam down."},
        {"zh": "角撞你的膝盖。", "en": "A corner hits your knee."},
        {"zh": "锁扣夹住了。", "en": "The latch clamps hold."},
        {"zh": "箱角砸在你身上。", "en": "A corner slams into you."},
        {"zh": "箱子里的东西也飞出来。", "en": "Its contents fly out too."},
        {"zh": "木板砸你的手。", "en": "A plank strikes your hand."},
        {"zh": "你退我就跟。", "en": "You back away. I follow."},
        {"zh": "箱盖一合，夹住你的袖口。", "en": "My lid snaps shut on your sleeve cuff."},
        {"zh": "铁钉勾住你了。", "en": "The nails have you."},
        {"zh": "盖子再合一次。", "en": "The lid snaps again."},
        {"zh": "我弹得比你还高。", "en": "I spring higher than you can."},
        {"zh": "整只箱子在响。", "en": "The whole chest is clattering."},
        {"zh": "你这回跑不掉了。", "en": "You're not running from this one."},
        {"zh": "血溅在木头上。", "en": "Blood splatters the wood."},
        {"zh": "我还没松口。", "en": "I haven't let go."},
        {"zh": "这一下留个印。", "en": "That leaves a mark."},
        {"zh": "这一下就完了。", "en": "That's the end of it."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地上多了一个箱子。", "en": "A chest appeared on the ground."},
        {"zh": "木头看着很旧。", "en": "The wood looks old."},
        {"zh": "锁扣上有点锈。", "en": "Rust on the latch."},
        {"zh": "我摆好了姿势。", "en": "I've set my pose."},
        {"zh": "这里没人会开我。", "en": "Nobody would open me here."},
        {"zh": "我等着第一个伸手的人。", "en": "I wait for the first reaching hand."},
        {"zh": "木纹里有一点牙。", "en": "A hint of teeth in the grain."},
        {"zh": "这附近没有什么宝箱。", "en": "There are no real chests around."},
        {"zh": "木头磕在石上，咚一声。", "en": "Wood knocks on stone with a thud."},
        {"zh": "盖子严丝合缝。", "en": "My lid sits perfectly flush."},
        {"zh": "地上有我的影子，但箱子不该有影子。", "en": "I cast a shadow a chest shouldn't."},
        {"zh": "我摆好盖子，等手伸来。", "en": "Lid set, I wait for a hand to reach in."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "木头烧得噼啪响。", "en": "My wood crackles with flame."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时散了几块板。", "en": "A few planks came loose."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "木头吸饱了水。", "en": "The wood drank the water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "整个箱子都松了。", "en": "The whole chest came loose."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头钉在盖子上。", "en": "An arrow stuck in my lid."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光穿过了木板。", "en": "The light passed through my planks."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "箱子不怕饿。", "en": "A chest doesn't starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把我烧得发黑。", "en": "The bolt blackened me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "箱子掉进空洞，木屑乱飞。", "en": "The chest drops into the void, splinters flying."}
      ]
    }
  }
}
