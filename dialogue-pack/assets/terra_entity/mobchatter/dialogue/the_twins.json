{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "两只眼睛一起飞过来。", "en": "Two eyes come flying together."},
        {"zh": "我们一左一右靠近。", "en": "We close in, one left, one right."},
        {"zh": "红的那只飞得更高。", "en": "The red one flies higher."},
        {"zh": "绿的那只贴着地。", "en": "The green one keeps low."},
        {"zh": "我们的影子重叠了。", "en": "Our shadows overlap."},
        {"zh": "金属的眼眶发着光。", "en": "Metal sockets glow."},
        {"zh": "我们的视线从不分开。", "en": "Our gazes never separate."},
        {"zh": "我们绕着你转圈。", "en": "We circle around you."},
        {"zh": "两只一起转，很难瞄。", "en": "Two turning at once is hard to aim at."},
        {"zh": "两只眼绕着你交错飞。", "en": "Two eyes weave around you."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在半空悬着。", "en": "We hover in the air."},
        {"zh": "两只眼睛同时眨了一下。", "en": "Both eyes blink at once."},
        {"zh": "红光和绿光交替。", "en": "Red light, green light, alternating."},
        {"zh": "我们在等对方先动。", "en": "We wait for the other to move."},
        {"zh": "铁眼眶上有旧划痕。", "en": "Old scratches on the iron sockets."},
        {"zh": "两只瞳孔一起收缩。", "en": "Both pupils contract at once."},
        {"zh": "我们的转向完全一致。", "en": "We turn in perfect unison."},
        {"zh": "核心在轻轻响。", "en": "Our cores tick softly."},
        {"zh": "我们不需要落地。", "en": "We don't need to land."},
        {"zh": "这片天空是我们的。", "en": "This sky is ours."},
        {"zh": "我们一直盯着下面。", "en": "We keep watching below."},
        {"zh": "突然两只一起转过来。", "en": "Suddenly both turn together."},
        {"zh": "我们的间距保持不变。", "en": "Our spacing never changes."},
        {"zh": "夜里我们能看得很远。", "en": "We see far at night."},
        {"zh": "我们从来不会累。", "en": "We never tire."},
        {"zh": "我们等着被召来的人。", "en": "We wait for whoever is summoned."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我们都在看你。", "en": "We're both watching you."},
        {"zh": "你只有一个影子。", "en": "You've only one shadow."},
        {"zh": "两只眼睛，一个目标。", "en": "Two eyes, one target."},
        {"zh": "你在我们中间。", "en": "You're between us."},
        {"zh": "你往哪边看都不够。", "en": "Looking either way won't be enough."},
        {"zh": "我们不太喜欢被盯着。", "en": "We don't like being stared at."},
        {"zh": "红色的那只先看见你。", "en": "The red one saw you first."},
        {"zh": "你身上有温热的气。", "en": "There's warm air around you."},
        {"zh": "我们绕着你飞两圈。", "en": "We'll do two laps around you."},
        {"zh": "你没有第三只眼看我们。", "en": "You've no third eye for us."},
        {"zh": "你身上的热气我们都能感到。", "en": "We both feel the heat off you."},
        {"zh": "我们只看见一个你。", "en": "We see only one of you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一只眼睛的光暗了。", "en": "One eye's light dimmed."},
        {"zh": "一只眼闭上，另一只还亮。", "en": "One eye shuts; the other still glows."},
        {"zh": "铁眼眶被打歪。", "en": "An iron socket got knocked crooked."},
        {"zh": "我们同时抖了一下。", "en": "We both flinched at once."},
        {"zh": "核心的响声变了。", "en": "Our cores changed pitch."},
        {"zh": "有一只暂时看不见。", "en": "One of us can't see for now."},
        {"zh": "我们靠得更近了。", "en": "We moved closer together."},
        {"zh": "我们照样还能转。", "en": "We can still turn."},
        {"zh": "这一下打散了我们。", "en": "That broke us apart."},
        {"zh": "别以为这就完了。", "en": "Don't think this is finished."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我们不需要进食。", "en": "We don't need to eat."},
        {"zh": "那东西对我们没用。", "en": "That thing is useless to us."},
        {"zh": "拿开，别在我们中间。", "en": "Move it. Not between us."},
        {"zh": "我们只对活的有兴趣。", "en": "We're only interested in the living."},
        {"zh": "这个不亮，也不热。", "en": "This neither glows nor warms."},
        {"zh": "你想用它分散我们？", "en": "Trying to split our attention?"},
        {"zh": "两只眼睛都看着它。", "en": "Both eyes are on it."},
        {"zh": "我们不会为这个停下。", "en": "We won't stop for that."},
        {"zh": "血肉的味道，我们都闻到了。", "en": "We both smell the blood on you."},
        {"zh": "一小块肉，不够两只眼。", "en": "One small piece of meat isn't enough for two eyes."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了红的那只。", "en": "You hit the red one."},
        {"zh": "另一只已经绕到后面。", "en": "The other's already behind you."},
        {"zh": "我们不落地，撞不到。", "en": "We don't land, so there's little to hit."},
        {"zh": "两只眼，一只盯左一只盯右。", "en": "Two eyes: one on the left, one on the right."},
        {"zh": "我们同时让开。", "en": "We both moved aside."},
        {"zh": "你被两只夹在中间。", "en": "We've got you between us."},
        {"zh": "铁眼眶擦过你的肩。", "en": "An iron socket grazed your shoulder."},
        {"zh": "两只眼睛夹住你了。", "en": "Both eyes have you between them."},
        {"zh": "再挤我们就要出手。", "en": "Crowd us more and we strike."},
        {"zh": "我们的影子绕住你。", "en": "Our shadows surround you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们两个才是一对。", "en": "The two of us are already a pair."},
        {"zh": "这种事跟我们无关。", "en": "That doesn't concern us."},
        {"zh": "我们不需要第三个。", "en": "We don't need a third."},
        {"zh": "我们本来就是一体的。", "en": "We were one from the start."},
        {"zh": "我们只是两只眼睛。", "en": "We're only two eyes."},
        {"zh": "两只一起转过头。", "en": "Both heads turn away together."},
        {"zh": "这个我们不回答。", "en": "We won't answer that."},
        {"zh": "我们两只眼，一起转。", "en": "Our two eyes turn together."},
        {"zh": "我们飞高了一点。", "en": "We rose a little higher."},
        {"zh": "别在我们之间说这个。", "en": "Don't say that between us."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "红的那只先碰到它。", "en": "The red one touched it first."},
        {"zh": "我们用光把它抬起来。", "en": "We lift it with our light."},
        {"zh": "这个不用拿走。", "en": "No need to carry this off."},
        {"zh": "两只一起夹住它。", "en": "Both of us clamp onto it."},
        {"zh": "它从中间滑掉了。", "en": "It slipped through the middle."},
        {"zh": "我们把它推给你。", "en": "We push it over to you."},
        {"zh": "两只眼睛一起夹住了。", "en": "Both eyes clamped on at once."},
        {"zh": "我们根本没有手。", "en": "We don't have hands at all."},
        {"zh": "它在两只眼睛之间转。", "en": "It spins between the two eyes."},
        {"zh": "就留在这里吧。", "en": "Just leave it here."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我们同时锁定了你。", "en": "We've both marked you at once."},
        {"zh": "红光和绿光都对着你。", "en": "Red and green both face you."},
        {"zh": "我们分左右包过来。", "en": "We close in from left and right."},
        {"zh": "你看哪只都会漏掉一只。", "en": "Watch one, miss the other."},
        {"zh": "两只眼从两侧夹住你。", "en": "Two eyes flank you on both sides."},
        {"zh": "我们已经升上去了。", "en": "We've risen now."},
        {"zh": "你今天只有一个影子。", "en": "You've only one shadow today."},
        {"zh": "两只眼的距离正在缩。", "en": "The gap between the eyes is closing."},
        {"zh": "我们不会再等。", "en": "We won't wait any longer."},
        {"zh": "我们同时开始聚光。", "en": "We both begin to gather light."},
        {"zh": "你已经在我们中间。", "en": "You're already between us."},
        {"zh": "我们会一起出手。", "en": "We'll strike together."},
        {"zh": "我们两只眼都能看见你。", "en": "Both of us can see you."},
        {"zh": "你的位置我们已经算好。", "en": "We've worked out your position."},
        {"zh": "红色那只飞高了。", "en": "The red one has risen high."},
        {"zh": "绿的那只还压得很低。", "en": "The green one still hugs the ground."},
        {"zh": "我们各自守一边。", "en": "We each hold a side."},
        {"zh": "这一个角度没有人挡。", "en": "Nothing blocks this angle."},
        {"zh": "你在两只眼的中间。", "en": "You're between the two eyes."},
        {"zh": "我们已经很久没动了。", "en": "We've been still a long while."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你正往左边躲开。", "en": "You're dodging left."},
        {"zh": "右边那只已经到那了。", "en": "The right one's already there."},
        {"zh": "我们保持这个夹角。", "en": "We hold this angle."},
        {"zh": "你转身，我们换位。", "en": "You turn, we swap."},
        {"zh": "两只眼睛从来不同步。", "en": "The two eyes are never quite in sync."},
        {"zh": "你在数我们转了几圈。", "en": "You're counting our circles."},
        {"zh": "红色那只在蓄力。", "en": "The red one is charging."},
        {"zh": "绿色那只绕到你背后。", "en": "The green one's behind you."},
        {"zh": "你抬头就看不到脚下。", "en": "Look up and you lose your feet."},
        {"zh": "我们压低了高度。", "en": "We've dropped lower."},
        {"zh": "你再退就贴到墙了。", "en": "Another step and you're at the wall."},
        {"zh": "我们的光开始发烫。", "en": "Our light is heating up."},
        {"zh": "你的脚步乱了节奏。", "en": "Your footsteps lost their rhythm."},
        {"zh": "两只一起靠近很难挡。", "en": "Two closing together are hard to block."},
        {"zh": "这一刻我们等很久了。", "en": "We've waited long for this moment."},
        {"zh": "你脚下的地面亮起来。", "en": "The ground under you is lighting up."},
        {"zh": "我们各自瞄准一半。", "en": "We each aim at half of you."},
        {"zh": "别往两只中间跑。", "en": "Don't run between the two."},
        {"zh": "我们之间的空隙在收。", "en": "The gap between us is narrowing."},
        {"zh": "只剩下半息时间。", "en": "Only half a breath left."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "红光先扫过去。", "en": "The red beam sweeps first."},
        {"zh": "绿色那只从下面顶上来。", "en": "The green one drives up from below."},
        {"zh": "两道光在你身上合并。", "en": "Two beams merge on you."},
        {"zh": "我们一前一后撞过来。", "en": "We slam in from front and back."},
        {"zh": "你只挡住了一只。", "en": "You only blocked one."},
        {"zh": "铁眼眶磕在你肩上。", "en": "An iron socket cracked your shoulder."},
        {"zh": "我们分开，再合上。", "en": "We split apart, then close."},
        {"zh": "这一下两只一起落下。", "en": "This time both come down."},
        {"zh": "你的护甲开始发红。", "en": "Your armor is turning red."},
        {"zh": "我们退开重整。", "en": "We pull apart to reset."},
        {"zh": "红光弱了一瞬。", "en": "The red glow dimmed a moment."},
        {"zh": "绿的还在追你。", "en": "The green one's still on you."},
        {"zh": "这一击我们错开了。", "en": "We mistimed that one."},
        {"zh": "你的影子被照得很长。", "en": "Our light stretches your shadow long."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "两只眼睛一起亮起来。", "en": "Both eyes light up together."},
        {"zh": "我们悬在半空，慢慢转。", "en": "We hover and turn slowly."},
        {"zh": "红绿两道光交错。", "en": "Red and green light cross."},
        {"zh": "我们从同一个方向来。", "en": "We came from the same direction."},
        {"zh": "两只眼睛，一左一右睁开。", "en": "Two eyes open, one left, one right."},
        {"zh": "我们两个共用一双眼睛。", "en": "The two of us share one pair of eyes."},
        {"zh": "金属的声音在空中响。", "en": "Metal sounds in the air."},
        {"zh": "我们悬在半空，俯视你。", "en": "We hover in the air, looking down at you."},
        {"zh": "我们开始找寻目标。", "en": "We begin searching for a target."},
        {"zh": "两只眼同时转向地面。", "en": "Both eyes turn to the ground."},
        {"zh": "我们再靠近一点。", "en": "We move a little closer to each other."},
        {"zh": "这一带的天很开阔。", "en": "The sky here is wide open."},
        {"zh": "我们什么也没说。", "en": "We said nothing."},
        {"zh": "我们的核心同时启动。", "en": "Our cores started together."},
        {"zh": "风从两只之间穿过。", "en": "Wind passes between the two of us."},
        {"zh": "我们并排上升。", "en": "We rise side by side."},
        {"zh": "我们一直在看着。", "en": "We keep watching."},
        {"zh": "两只都没有眨眼。", "en": "Neither of us blinked."},
        {"zh": "我们的光把地面照亮。", "en": "Our light brightens the ground."},
        {"zh": "一起转，一起停。", "en": "Turn together, stop together."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光和我们的光混在一起。", "en": "Firelight mixes with ours."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我们被砸得往下坠。", "en": "The blow sent us dropping."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让我们的光变暗。", "en": "Water dims our light."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我们推向两边。", "en": "The blast threw us apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一枚东西打穿了眼框。", "en": "Something punched through a socket."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光和我们的光打架。", "en": "That light fights with ours."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我们不需要吃东西。", "en": "We don't need to eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让两只眼一片白。", "en": "The flash whited out both eyes."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有光，也没有热。", "en": "No light here. No heat."}
      ]
    }
  }
}
