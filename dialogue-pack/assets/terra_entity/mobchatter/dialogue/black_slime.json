{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下一下地弹过去。", "en": "I bounce my way along."},
        {"zh": "黑色的胶，抖得很厉害。", "en": "Black gel jiggling hard."},
        {"zh": "我在草上留下一道湿痕。", "en": "A wet trail behind me."},
        {"zh": "没有腿，只能蹦。", "en": "No legs — only hops."},
        {"zh": "我撞到石头，弹回来。", "en": "I hit a stone and bounce back."},
        {"zh": "身子一扁，又鼓起来。", "en": "I flatten, then swell up."},
        {"zh": "我滚一段，再跳一下。", "en": "I roll, then hop."},
        {"zh": "草丛被我压出坑。", "en": "The grass dents where I land."},
        {"zh": "我这一身，黏糊糊的。", "en": "This body is sticky all over."},
        {"zh": "跳得不远，但一直在跳。", "en": "Short hops, endlessly."},
        {"zh": "黑色的黏液在空中晃。", "en": "Black gel sways in the air."},
        {"zh": "我奔着有动静的地方去。", "en": "I head for whatever stirs."},
        {"zh": "一落地，石子都被粘住。", "en": "I land and pebbles stick."},
        {"zh": "我的节奏很单调。", "en": "My rhythm is monotonous."},
        {"zh": "影子圆圆的，一缩一张。", "en": "My round shadow swells and shrinks."},
        {"zh": "我慢慢挪过田埂。", "en": "I ooze across the field ridge."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停着，还在微微颤。", "en": "I stop, still quivering."},
        {"zh": "黏液从身上滴下来。", "en": "Gel drips off me."},
        {"zh": "地上积了一小滩。", "en": "A small puddle forms."},
        {"zh": "黑色的胶里，什么也没有。", "en": "There's nothing inside this black gel."},
        {"zh": "表面映出一点光。", "en": "My surface catches a glint."},
        {"zh": "一团黑的，贴在土上。", "en": "A black lump on the dirt."},
        {"zh": "我在感受地面。", "en": "I read the ground."},
        {"zh": "有虫爬进我身体里。", "en": "A bug crawls into me."},
        {"zh": "慢慢摊开，又收拢。", "en": "I spread out and gather."},
        {"zh": "我既不用眠也不用醒。", "en": "I neither sleep nor wake."},
        {"zh": "周围的草都黑了。", "en": "The grass around me darkens."},
        {"zh": "我在等一只脚落进来。", "en": "I'm waiting for a foot to land in me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我边上，地都黑了。", "en": "You stand beside me; the ground turns black."},
        {"zh": "我看不见，但我感觉得到。", "en": "Blind, but I feel you."},
        {"zh": "我的表面在动。", "en": "My surface ripples."},
        {"zh": "你的手指离我的胶很近。", "en": "Your fingers are close to my gel."},
        {"zh": "我黏，你别想甩开。", "en": "I'm sticky; you won't shake me off."},
        {"zh": "你的后脚挪开了半步。", "en": "Your back foot slid half a step."},
        {"zh": "我这一团没有脸。", "en": "This blob of mine has no face."},
        {"zh": "我的表面朝你鼓起来。", "en": "My surface bulges toward you."},
        {"zh": "我在慢慢往你那边挪。", "en": "I'm oozing toward you."},
        {"zh": "这块地，归我。", "en": "This ground is mine."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打得扁了一下。", "en": "The blow flattens me."},
        {"zh": "身体缺了一块。", "en": "A chunk of me is gone."},
        {"zh": "散开的胶又聚回来。", "en": "The scattered gel draws back in."},
        {"zh": "地上多了一摊。", "en": "Another puddle on the ground."},
        {"zh": "我不叫，因为我没有嘴。", "en": "I can't cry out; I've no mouth."},
        {"zh": "这点损失，不算什么。", "en": "That loss is nothing."},
        {"zh": "我往旁边塌了一块。", "en": "Part of me slumps aside."},
        {"zh": "黏液溅得到处都是。", "en": "Gel splatters everywhere."},
        {"zh": "缺的一角，慢慢流回来。", "en": "The missing corner flows slowly back."},
        {"zh": "我的节奏一下乱了。", "en": "My rhythm broke for a beat."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "食物会粘在我的胶里。", "en": "Food would gum up in my gel."},
        {"zh": "黏液会把食物包住。", "en": "My gel would swallow it."},
        {"zh": "你举着它，我没有兴趣。", "en": "You hold it out; I'm not interested."},
        {"zh": "我只对活的东西有反应。", "en": "Only living things draw me."},
        {"zh": "那东西会沉进我身体里。", "en": "It would sink into me."},
        {"zh": "我不饿，我只是想撞。", "en": "Not hungry; I just want to collide."},
        {"zh": "这点东西，太小了。", "en": "That's too small."},
        {"zh": "你收着那点东西吧。", "en": "Keep that little bit for yourself."},
        {"zh": "我往你脚边挪。", "en": "I ooze toward your feet."},
        {"zh": "别拿它挡我。", "en": "Don't use it to block me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一撞上，就粘住了。", "en": "I touch you and stick."},
        {"zh": "你的靴子上有我的胶。", "en": "My gel is on your boots."},
        {"zh": "我被弹开，又滚回来。", "en": "Bounced off, rolling back."},
        {"zh": "这一下，你也带了伤。", "en": "That left its mark on you."},
        {"zh": "我贴上去就不松。", "en": "Once I cling, I don't let go."},
        {"zh": "地上留下一片黑。", "en": "A black smear on the ground."},
        {"zh": "我的胶挂在你鞋跟上。", "en": "My gel hangs from your heel."},
        {"zh": "我弹得很轻。", "en": "My bounce is light."},
        {"zh": "这次撞在你小腿上。", "en": "This time I hit your shin."},
        {"zh": "我黏住你的裤腿。", "en": "I stick to your trouser leg."},
        {"zh": "我这一身，撞上谁都会脏。", "en": "Anyone I hit ends up filthy."},
        {"zh": "你越拍，我粘得越紧。", "en": "The more you swat, the tighter I stick."},
        {"zh": "我的胶吸住了地面。", "en": "My gel grips the ground."},
        {"zh": "鞋底陷进我身体里。", "en": "Your sole sinks into my body."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们分裂，不用伴侣。", "en": "We split; no mate needed."},
        {"zh": "两团胶碰在一起，合成一团。", "en": "Two blobs touch and merge."},
        {"zh": "然后再分开。", "en": "Then split apart again."},
        {"zh": "我们之间不用语言。", "en": "Language has no use between us."},
        {"zh": "黑色的胶，混在一起。", "en": "Black gel mixing together."},
        {"zh": "你分不清哪个是哪个。", "en": "You can't tell which is which."},
        {"zh": "同类多了，就更多。", "en": "More of us makes more still."},
        {"zh": "我们没有那种念头。", "en": "We have no such urges."},
        {"zh": "我们只是贴着。", "en": "We simply press together."},
        {"zh": "别再盯着我看了。", "en": "Stop staring at me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把东西包进身体里。", "en": "I wrap it into my body."},
        {"zh": "它慢慢沉下去。", "en": "It sinks slowly."},
        {"zh": "再浮出来时，已经脏了。", "en": "It rises again, soiled."},
        {"zh": "我不需要手。", "en": "I need no hands."},
        {"zh": "黏液裹住它。", "en": "Gel coats it."},
        {"zh": "掉在地上，被我吞进去。", "en": "It falls, and I take it in."},
        {"zh": "这点重量，我没有感觉。", "en": "I feel no weight."},
        {"zh": "它在我里面转。", "en": "It turns inside me."},
        {"zh": "过一会儿就化。", "en": "Soon it dissolves."},
        {"zh": "那东西太重，我吐出来。", "en": "That thing is too heavy; I spit it out."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西近了。", "en": "Something's close."},
        {"zh": "那边有东西在喘气。", "en": "Something over there is breathing."},
        {"zh": "地面在震，我感觉得到。", "en": "I feel the ground shake."},
        {"zh": "震动传过来，我转向它。", "en": "A tremor reaches me; I turn toward it."},
        {"zh": "我开始蹦过去。", "en": "I start hopping over."},
        {"zh": "这一路，我不停。", "en": "I don't stop on the way."},
        {"zh": "你身上的热，很明显。", "en": "Your warmth is obvious."},
        {"zh": "我锁住你的位置了。", "en": "I've fixed your position."},
        {"zh": "我压扁一下，准备弹。", "en": "I flatten to spring."},
        {"zh": "就这么直直过去。", "en": "Straight at you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跳一跳地追。", "en": "I chase in hops."},
        {"zh": "我按自己的节奏追上。", "en": "I catch up at my own pace."},
        {"zh": "我从来不改方向。", "en": "I never change course."},
        {"zh": "黏液在地上拖成线。", "en": "Gel trails a line behind me."},
        {"zh": "你被逼到墙根了。", "en": "You've been pushed to the wall."},
        {"zh": "每弹一下，就缩短一点。", "en": "Every hop shortens the gap."},
        {"zh": "我碰到的草都黑了。", "en": "The grass I touch turns black."},
        {"zh": "你踩到我的痕迹了。", "en": "You've stepped in my trail."},
        {"zh": "我这团胶不知累。", "en": "This gel of mine doesn't tire."},
        {"zh": "再来两下就到了。", "en": "Two more hops."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个撞上去！", "en": "I slam my whole body in!"},
        {"zh": "你身上沾了一片黑。", "en": "A black patch on you now."},
        {"zh": "我不咬，我粘。", "en": "I don't bite; I cling."},
        {"zh": "这一下，皮都烧了。", "en": "That one burns the skin."},
        {"zh": "我又弹起来。", "en": "I bounce up again."},
        {"zh": "别用手拨我。", "en": "Don't brush me off with your hand."},
        {"zh": "黏液渗进衣服里。", "en": "Gel seeps into your clothes."},
        {"zh": "你打不散我。", "en": "You can't scatter me."},
        {"zh": "我留了一片在你脚下。", "en": "I leave a patch at your feet."},
        {"zh": "下一跳，还是冲你。", "en": "Next hop, still at you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土里鼓起来。", "en": "I swell up out of the dirt."},
        {"zh": "一团黑，慢慢成形。", "en": "A black mass takes shape."},
        {"zh": "地上先湿了一块。", "en": "The ground dampens first."},
        {"zh": "我弹了一下，试试。", "en": "I hop once to test."},
        {"zh": "四周的草都在抖。", "en": "The grass trembles around me."},
        {"zh": "我在这里落地了。", "en": "I've landed here."},
        {"zh": "没有声音，只有黏响。", "en": "No sound but a wet squelch."},
        {"zh": "我从石缝底下渗出来。", "en": "I seep out from under the stones."},
        {"zh": "我先摊开，再收拢。", "en": "I spread, then gather."},
        {"zh": "附近有活物。", "en": "Something living nearby."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我咕嘟响。", "en": "Fire makes me bubble."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔在地上，摊成一片。", "en": "I hit the ground and splatter."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一泡，我散成一片。", "en": "Soaked in water, I spread thin."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸开的胶，落了一地。", "en": "Blown apart, my gel rains down."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西捅进胶里。", "en": "Something pokes into my gel."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术把我定成一团。", "en": "The spell holds me in one lump."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，只是变稀。", "en": "I don't eat; I just thin out."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我全身一颤。", "en": "Lightning hits and I shudder."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，一路滴。", "en": "I fall, dripping all the way."}
      ]
    }
  }
}
