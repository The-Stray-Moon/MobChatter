{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我整面墙往前推，地面都在抖。", "en": "I push forward as a wall; the ground shakes."},
        {"zh": "我的皮肉一层层翻动。", "en": "My flesh rolls in layers."},
        {"zh": "墙面上有许多张脸。", "en": "Many faces show on my wall."},
        {"zh": "我经过的地方，草都烧焦了。", "en": "Grass scorches where I pass."},
        {"zh": "我伸出一只手，又收回墙里。", "en": "A hand reaches out and sinks back in."},
        {"zh": "我的边缘擦着树，树就断了。", "en": "My edge grazes a tree and it snaps."},
        {"zh": "我拖动自己，声音很闷。", "en": "I drag myself along with a muffled sound."},
        {"zh": "血从墙脚往下淌。", "en": "Blood runs down my base."},
        {"zh": "我挤过一个狭窄的地方。", "en": "I squeeze through a narrow place."},
        {"zh": "我慢慢推进，从不后退。", "en": "I advance slowly and never retreat."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，慢慢起伏。", "en": "I stand, heaving slowly."},
        {"zh": "墙里有东西在动。", "en": "Something moves inside me."},
        {"zh": "我的嘴张开又合上。", "en": "Mouths open and close on me."},
        {"zh": "无数张嘴在墙里低鸣。", "en": "Countless mouths murmur inside my wall."},
        {"zh": "血从缝隙里渗出来。", "en": "Blood seeps from my crevices."},
        {"zh": "我在听这一层的动静。", "en": "I listen to this level."},
        {"zh": "我的眼睛到处都是。", "en": "Eyes are everywhere on me."},
        {"zh": "我不需要走路也能移动。", "en": "I can move without walking."},
        {"zh": "墙面上有一只手在抓。", "en": "A hand claws at my surface."},
        {"zh": "我的肉在慢慢长回来。", "en": "My flesh slowly grows back."},
        {"zh": "这地方太小了，我展不开。", "en": "This place is too small for me."},
        {"zh": "我把一块石头吞了进去。", "en": "I swallow a stone."},
        {"zh": "我在等一个人靠近。", "en": "I wait for someone to come near."},
        {"zh": "空气里有铁的味道。", "en": "Iron in the air."},
        {"zh": "我整面墙都在呼吸。", "en": "My whole wall is breathing."},
        {"zh": "这里就是我的场。", "en": "This is my arena."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你挨得太近了。", "en": "You are much too close."},
        {"zh": "我在你身后也有眼睛。", "en": "I have eyes behind you too."},
        {"zh": "你要跑很长一段路。", "en": "You will have to run a long way."},
        {"zh": "我的身体是这一整面墙。", "en": "This whole wall is my body."},
        {"zh": "你砍哪里都一样。", "en": "Cut anywhere. It is all the same."},
        {"zh": "你听见那些声音了吗。", "en": "Do you hear those voices?"},
        {"zh": "你会被挂在墙上。", "en": "You will hang on this wall."},
        {"zh": "这里没有退路。", "en": "There is no retreat here."},
        {"zh": "我闻得出血的味道。", "en": "I can smell blood."},
        {"zh": "你站得腿都在打颤。", "en": "Your legs are shaking as you stand."},
        {"zh": "你的盔甲挡不住我的肉。", "en": "Your armor cannot stop my flesh."},
        {"zh": "你走近一点来。", "en": "Come a little closer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一块肉被打烂了。", "en": "A piece of flesh is battered."},
        {"zh": "血一下子溅出来。", "en": "Blood sprays out."},
        {"zh": "被打烂的地方鼓了起来。", "en": "The crushed part swells back up."},
        {"zh": "这一刀砍得很深。", "en": "That cut went deep."},
        {"zh": "我很快会长回来。", "en": "It will grow back quickly."},
        {"zh": "我的声音变低了。", "en": "My voice has lowered."},
        {"zh": "肉在翻动，慢慢合上。", "en": "The flesh rolls and slowly closes."},
        {"zh": "我往前推了一点。", "en": "I pushed forward a little."},
        {"zh": "刀口翻开，又慢慢合上。", "en": "The cut gapes open, then slowly closes."},
        {"zh": "我是不会停的。", "en": "I do not stop."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "把它扔过来给我。", "en": "Throw it over to me."},
        {"zh": "这点东西，我一口就吞。", "en": "One mouthful and it is gone."},
        {"zh": "血味变得更浓了。", "en": "The smell of blood grows stronger."},
        {"zh": "那点血够我尝一口吗。", "en": "Is that much blood enough for a taste?"},
        {"zh": "放到墙根下边。", "en": "Put it at my base."},
        {"zh": "什么都吞得下。", "en": "I can swallow anything."},
        {"zh": "再往多里来一点。", "en": "A little more."},
        {"zh": "你身上就带着。", "en": "You carry some on you."},
        {"zh": "你别往后退开。", "en": "Do not back away."},
        {"zh": "我实在饿得很。", "en": "I am truly hungry."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞进我的肉里了。", "en": "You ran into my flesh."},
        {"zh": "这点冲力像风吹。", "en": "That impact is like a breeze."},
        {"zh": "退开，会被卷进去。", "en": "Get back or you will be drawn in."},
        {"zh": "你碰到了我的肋骨。", "en": "You touched a rib of mine."},
        {"zh": "我这一面很厚。", "en": "This face of me is thick."},
        {"zh": "你被推得退开了。", "en": "You were shoved aside."},
        {"zh": "别贴着我的墙根。", "en": "Do not hug my base."},
        {"zh": "这点力量，我不用理。", "en": "That force is not worth noticing."},
        {"zh": "往边上靠一靠。", "en": "Keep to the side."},
        {"zh": "血会沾在你身上。", "en": "Blood will get on you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是这一整面墙。", "en": "I am this entire wall."},
        {"zh": "我这样的形体不合适。", "en": "A form like mine does not suit it."},
        {"zh": "这里只有肉和骨。", "en": "There is only flesh and bone here."},
        {"zh": "这个问题别问。", "en": "Do not ask that."},
        {"zh": "我的嘴很多，没有一张能回答。", "en": "I have many mouths. None can answer."},
        {"zh": "我根本不需要。", "en": "I have no need of it."},
        {"zh": "你站远一点去。", "en": "Stand further away."},
        {"zh": "这话题不合适。", "en": "Not a fitting topic."},
        {"zh": "我只会往前推。", "en": "I only push forward."},
        {"zh": "往远处退开些。", "en": "Back far away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把地上的东西吸进来。", "en": "I draw in what lies on the ground."},
        {"zh": "墙脚的手把它抓住。", "en": "A hand at my base seizes it."},
        {"zh": "这点东西，塞不进缝。", "en": "This will not fit in a crevice."},
        {"zh": "一条长舌从肉缝里伸出来。", "en": "A long tongue slides out of a seam in my flesh."},
        {"zh": "它已经被消化了。", "en": "It has been digested."},
        {"zh": "我用不着低头。", "en": "I need not bow my head."},
        {"zh": "地上的东西归我墙脚。", "en": "Whatever lies on the ground belongs to my base."},
        {"zh": "嚼不烂就吐了。", "en": "Unchewable, so I spit it out."},
        {"zh": "还差那么一点点。", "en": "Just a little more."},
        {"zh": "我的手够得着。", "en": "My hand can reach."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进入了我的场。", "en": "You have entered my arena."},
        {"zh": "你现在归我了。", "en": "You are mine now."},
        {"zh": "我以为你会跑得更远。", "en": "I thought you would run further."},
        {"zh": "墙开始往前推。", "en": "The wall begins to advance."},
        {"zh": "你的后面也是我。", "en": "I am behind you too."},
        {"zh": "这一层没有出口。", "en": "This level has no exit."},
        {"zh": "我张开许多张嘴。", "en": "I open many mouths."},
        {"zh": "这一战要跑很久。", "en": "This fight will be a long run."},
        {"zh": "墙面裂开，伸出一条手臂。", "en": "My wall splits and an arm reaches out."},
        {"zh": "目标正在移动。", "en": "The target is moving."},
        {"zh": "这一整层都是我的肉。", "en": "This whole layer is my flesh."},
        {"zh": "我的肉比你耐得住跑。", "en": "My flesh outlasts your running."},
        {"zh": "再往里进一寸。", "en": "One inch closer."},
        {"zh": "你在中间，很好。", "en": "You are in the middle. Good."},
        {"zh": "这就开动起来。", "en": "Begin."},
        {"zh": "这一面墙就是尽头。", "en": "This wall is the end."},
        {"zh": "我已经推进来了。", "en": "I have advanced."},
        {"zh": "你在看哪一边。", "en": "Which way are you looking?"},
        {"zh": "我在你旁边了。", "en": "I am beside you now."},
        {"zh": "你尽管逃开吧。", "en": "Flee, then."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我把整面墙挪了半尺。", "en": "I shift the whole wall half a foot."},
        {"zh": "你的退路在缩短。", "en": "Your path back is shortening."},
        {"zh": "血从我身上滴下来。", "en": "Blood drips from me."},
        {"zh": "我的眼睛贴在你背上。", "en": "My eyes are on your back."},
        {"zh": "墙已经贴到你后背上。", "en": "The wall is already against your back."},
        {"zh": "这一面墙在靠近。", "en": "This wall is closing in."},
        {"zh": "石板在我的重量下开裂。", "en": "The flagstones crack under my weight."},
        {"zh": "你脚下有血迹。", "en": "There is blood at your feet."},
        {"zh": "我的手伸出来又收回去。", "en": "A hand reaches out and withdraws."},
        {"zh": "你的脚步声越来越急。", "en": "Your footsteps are coming faster."},
        {"zh": "等一下，还有一小段。", "en": "Wait. A little further."},
        {"zh": "墙里有骨头在互相挤。", "en": "Bones grind against each other inside my wall."},
        {"zh": "前面的通道已经堵死了。", "en": "The passage ahead is already sealed."},
        {"zh": "我用不着加速。", "en": "I need no acceleration."},
        {"zh": "我的指尖离你只差半臂。", "en": "My fingertips are half an arm from you."},
        {"zh": "墙影终于盖住了你。", "en": "At last my shadow covers you."},
        {"zh": "我吞下这一片。", "en": "I swallow this stretch whole."},
        {"zh": "你背后的路已经被我吃掉。", "en": "I've eaten the road behind you."},
        {"zh": "心跳就在耳边。", "en": "Your heartbeat is at my ear."},
        {"zh": "就是这一面墙。", "en": "This face of the wall."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "整面墙撞过去。", "en": "The whole wall slams forward."},
        {"zh": "一只手从墙里抓出来。", "en": "A hand lashes out of the wall."},
        {"zh": "我的嘴咬住你的手臂。", "en": "A mouth of mine bites your arm."},
        {"zh": "你被卷进肉里。", "en": "You are pulled into the flesh."},
        {"zh": "血溅了我一面。", "en": "Blood sprays across my face."},
        {"zh": "我推开你，用整块躯干。", "en": "I shove with my whole bulk."},
        {"zh": "这一下像被房子撞了。", "en": "That felt like being hit by a house."},
        {"zh": "我的舌头扫过地面。", "en": "My tongue sweeps the ground."},
        {"zh": "你被甩到墙上。", "en": "You are thrown against the wall."},
        {"zh": "这一下打得很闷。", "en": "That landed with a dull weight."},
        {"zh": "我的边缘刮到你。", "en": "My edge scraped you."},
        {"zh": "我的肉裹住你的手臂。", "en": "My flesh wraps around your arm."},
        {"zh": "我又伸出一只手。", "en": "I extend another hand."},
        {"zh": "一堵肉从上面塌下来。", "en": "A slab of flesh collapses down on you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这一面墙开始动。", "en": "This wall begins to move."},
        {"zh": "肉从地里长出来。", "en": "Flesh grows up out of the ground."},
        {"zh": "血先流了出来。", "en": "Blood comes first."},
        {"zh": "我张开第一张嘴。", "en": "I open my first mouth."},
        {"zh": "这一层由我镇着。", "en": "I hold this level."},
        {"zh": "骨节一节节接起来。", "en": "Bones join one by one."},
        {"zh": "我整面立起来。", "en": "I rise as a wall."},
        {"zh": "有人把我叫出来。", "en": "Someone has called me up."},
        {"zh": "我碾过的地方留下血泥。", "en": "Bloody mud is left where I grind past."},
        {"zh": "我把眼睛睁开。", "en": "I open my eyes."},
        {"zh": "血味把我从地里拽起来。", "en": "The smell of blood drags me up from the ground."},
        {"zh": "我从地面顶起一整面肉。", "en": "I raise a whole wall of flesh out of the ground."},
        {"zh": "墙面上有东西在动。", "en": "Something moves on my surface."},
        {"zh": "这一片很窄，正好。", "en": "This passage is narrow. Good."},
        {"zh": "我发出一声长响。", "en": "I let out a long sound."},
        {"zh": "你们跑不掉的。", "en": "You cannot run."},
        {"zh": "这面墙会跟着你。", "en": "This wall will follow you."},
        {"zh": "数三下，明白吗。", "en": "Three counts. Understood?"},
        {"zh": "别贴着墙壁走。", "en": "Do not walk along the wall."},
        {"zh": "我已经压过来了。", "en": "I am bearing down."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的肉，味道很怪。", "en": "Fire roasts my flesh. A strange smell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处塌下来。", "en": "I collapse from above."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的肉里，很沉。", "en": "Water fills my flesh and weighs me down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸撕开我半面墙。", "en": "The blast tears half my wall open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进肉里，还在晃。", "en": "An arrow sticks in my flesh, quivering."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我的肉缩起来。", "en": "This light makes my flesh shrink."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这一层没有可吃的。", "en": "There is nothing to eat on this level."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电把我的肉照得通透。", "en": "Lightning makes my flesh translucent."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "整个场都没了。", "en": "The whole arena is gone."}
      ]
    }
  }
}
