{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我振翅的声音很密。", "en": "My wingbeats are dense and fast."},
        {"zh": "翅膀嗡嗡，围着你转。", "en": "Wings buzzing, I circle you."},
        {"zh": "我贴着你肩膀飞。", "en": "I fly close to your shoulder."},
        {"zh": "我往前冲一段又停。", "en": "I dart forward and hover."},
        {"zh": "我的翅膀几乎看不见。", "en": "My wings are almost invisible."},
        {"zh": "你小跑，我慢慢跟。", "en": "You jog; I follow at my pace."},
        {"zh": "我落在一根枝上，又起飞。", "en": "I land on a twig, then take off."},
        {"zh": "嗡嗡两声，我换了边。", "en": "Two buzzes and I switch sides."},
        {"zh": "我从你耳边擦过。", "en": "I graze past your ear."},
        {"zh": "我在你头顶停住。", "en": "I hover above your head."},
        {"zh": "我跟着你的方向。", "en": "I keep your heading."},
        {"zh": "我振翅的声音变响了。", "en": "My buzzing has grown louder."},
        {"zh": "我绕着你的帽檐转。", "en": "I circle your hat brim."},
        {"zh": "我停在你的手指上。", "en": "I land on your finger."},
        {"zh": "我从你肩上跳起来飞。", "en": "I push off your shoulder into flight."},
        {"zh": "我贴着草尖找路。", "en": "I skim the grass tips to find a way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在你身边。", "en": "I hover beside you."},
        {"zh": "翅膀发热，我抖一抖。", "en": "My wings heat up; I shake them."},
        {"zh": "我在看你指的方向。", "en": "I look where you point."},
        {"zh": "我悬着，翅膀没停。", "en": "I hover, wings never still."},
        {"zh": "我在等你说话。", "en": "I wait for you to speak."},
        {"zh": "我的尾针收着。", "en": "My stinger is retracted."},
        {"zh": "我停在你肩上歇一下。", "en": "I rest on your shoulder a moment."},
        {"zh": "我在数周围的声音。", "en": "I count the sounds around us."},
        {"zh": "我的身体很小。", "en": "My body is very small."},
        {"zh": "我悬着，歪头看你的脸。", "en": "I hover, head tilted at your face."},
        {"zh": "我把翅膀压平。", "en": "I flatten my wings."},
        {"zh": "我在听更远的地方。", "en": "I listen further off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "主人，我在。", "en": "Master, I'm here."},
        {"zh": "你要我去看哪里？", "en": "Where should I look?"},
        {"zh": "我在你右耳后面。", "en": "I'm behind your right ear."},
        {"zh": "你不用管我。", "en": "Don't mind me."},
        {"zh": "我认得你的手势。", "en": "I know your signals."},
        {"zh": "我飞低一点。", "en": "I fly a little lower."},
        {"zh": "你的肩膀借我站一下。", "en": "Lend me your shoulder."},
        {"zh": "我在你肩后半尺跟着。", "en": "I keep half a foot behind your shoulder."},
        {"zh": "我不累，翅膀还轻。", "en": "I don't tire; my wings are still light."},
        {"zh": "你指哪我就去哪。", "en": "Point, and I go."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀漏风，我往下沉。", "en": "A wing leaks air; I sink."},
        {"zh": "一片翅膀被压弯了。", "en": "One wing is bent flat."},
        {"zh": "我挣扎着飞回来。", "en": "I struggle back into flight."},
        {"zh": "被打中了，我歪了一下。", "en": "Hit — I tilt in the air."},
        {"zh": "我发出一声细嗡。", "en": "I let out a thin buzz."},
        {"zh": "翅膀还在振。", "en": "The wings still beat."},
        {"zh": "我抖正了两片翅膀。", "en": "I shake my two wings straight."},
        {"zh": "我重新振翅。", "en": "I beat my wings again."},
        {"zh": "我贴在你的颈边。", "en": "I cling to your neck."},
        {"zh": "我重新悬停在原处。", "en": "I hover in place again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那点，是喂我的？", "en": "That in your hand — for me?"},
        {"zh": "你放在手心。", "en": "Put it in your palm."},
        {"zh": "我从上面落到你肩上。", "en": "I drop onto your shoulder."},
        {"zh": "我吃一点点。", "en": "I take a little."},
        {"zh": "这个很甜，我喜欢。", "en": "This is sweet. I like it."},
        {"zh": "你另一只手里还有吗？", "en": "Anything in your other hand?"},
        {"zh": "我抱着它飞。", "en": "I carry it in flight."},
        {"zh": "太大的我拿不动。", "en": "Too big and I can't carry it."},
        {"zh": "你的手别合上。", "en": "Don't close your hand."},
        {"zh": "我一下就吃完。", "en": "I'll finish it in one go."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你手指碰到我的翅脉。", "en": "Your finger touched a wing vein."},
        {"zh": "我一下弹开。", "en": "I bounce away."},
        {"zh": "我从你耳边擦过去。", "en": "I skim past your ear."},
        {"zh": "我落在你的帽子上。", "en": "I land on your hat."},
        {"zh": "我很轻，压不坏你。", "en": "I'm light; I won't crush you."},
        {"zh": "你的手挥过来，我闪开了。", "en": "Your hand swung; I dodged."},
        {"zh": "我退到你肩后。", "en": "I retreat behind your shoulder."},
        {"zh": "我们撞了一下，我没事。", "en": "We bumped; I'm fine."},
        {"zh": "撞了一下，我找回平衡。", "en": "One bump, and I find my balance."},
        {"zh": "我往上一窜让开。", "en": "I dart up out of the way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是个召唤物。", "en": "I am only a summon."},
        {"zh": "我这一族跟着召唤的人。", "en": "My kind follow whoever summons them."},
        {"zh": "你身边有我就够了。", "en": "Having me near is enough."},
        {"zh": "我落在你的手背。", "en": "I land on the back of your hand."},
        {"zh": "跟着你就够了。", "en": "Following you is enough."},
        {"zh": "我的位置就在你肩后。", "en": "My place is just behind your shoulder."},
        {"zh": "我把翅膀贴着你。", "en": "I press my wings to you."},
        {"zh": "我绕着同伴打转。", "en": "I circle my companion."},
        {"zh": "天黑了我也在。", "en": "I am here after dark too."},
        {"zh": "停在你肩上就好。", "en": "Staying on your shoulder is enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱起来飞。", "en": "I clasp it and fly."},
        {"zh": "这个我带得动。", "en": "I can carry this."},
        {"zh": "拖不动，我松了爪子。", "en": "Too heavy to drag; I let go."},
        {"zh": "我给你带回来。", "en": "I bring it back to you."},
        {"zh": "掉的东西我都看见了。", "en": "I see everything that falls."},
        {"zh": "我抱着它绕了一圈。", "en": "I carry it in a loop."},
        {"zh": "我松爪，它就落下。", "en": "I let go and it falls."},
        {"zh": "这个一点也不甜。", "en": "This isn't sweet at all."},
        {"zh": "抓不稳，掉在你脚边。", "en": "My grip slips; it falls at your feet."},
        {"zh": "爪子只能抓一样东西。", "en": "My claws can hold only one thing."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有东西。", "en": "There is something there."},
        {"zh": "我先飞过去看看。", "en": "I'll fly over and look."},
        {"zh": "你锁定的那个，我看见了。", "en": "I see the one you marked."},
        {"zh": "我的翅膀已经朝那边。", "en": "My wings already point that way."},
        {"zh": "我先过去探路。", "en": "I'll go ahead and scout."},
        {"zh": "我叫一声给你听。", "en": "I'll call so you hear."},
        {"zh": "它动了，我看见。", "en": "It moved. I saw it."},
        {"zh": "我绕到它上面。", "en": "I circle above it."},
        {"zh": "你跟着我的方向。", "en": "Follow my heading."},
        {"zh": "我悬在它上面盯着。", "en": "I hover over it, watching."},
        {"zh": "快到你抬头的时候了。", "en": "Almost time for you to look up."},
        {"zh": "我的尾针垂下来了。", "en": "My sting has dropped."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在它上面绕圈。", "en": "I circle above it."},
        {"zh": "它抬头，我就降一点。", "en": "It looks up; I drop lower."},
        {"zh": "我的影子落在它头顶。", "en": "My shadow falls on its head."},
        {"zh": "它往树后躲。", "en": "It ducks behind a tree."},
        {"zh": "我贴到它后颈上。", "en": "I cling to the back of its neck."},
        {"zh": "它的注意力在我这。", "en": "Its attention is on me."},
        {"zh": "你还差几步。", "en": "You're a few steps off."},
        {"zh": "我等你的信号。", "en": "I wait for your signal."},
        {"zh": "这个角度能扎到脖子。", "en": "From this angle I can sting the neck."},
        {"zh": "我收翅俯冲。", "en": "I fold and dive."},
        {"zh": "它跑向你那边了。", "en": "It's running your way."},
        {"zh": "主人的目标，就是我的。", "en": "My master's target is mine."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从上方扎下去。", "en": "I dive down from above."},
        {"zh": "我的尾针扎进去。", "en": "My stinger drives in."},
        {"zh": "翅膀一扇，把它掀翻。", "en": "One wingbeat flips it over."},
        {"zh": "这一下快得像眨眼。", "en": "That was as quick as a blink."},
        {"zh": "我抓它的眼。", "en": "I go for its eyes."},
        {"zh": "它被我缠住了。", "en": "I have it tangled."},
        {"zh": "尾巴一弯，再扎一针。", "en": "My tail curls and stings again."},
        {"zh": "我让开，你接着打。", "en": "I peel off; you finish."},
        {"zh": "我飞开，让它转向你。", "en": "I peel off so it turns to you."},
        {"zh": "我回到你肩边。", "en": "I return to your shoulder."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我被召唤出来了。", "en": "I have been summoned."},
        {"zh": "第一次飞，我先绕圈。", "en": "My first flight; I circle first."},
        {"zh": "你在哪里，我找不到。", "en": "Where are you? I can't find you."},
        {"zh": "我找到了你的气息。", "en": "I found your scent."},
        {"zh": "我轻轻落在你手背。", "en": "I settle lightly on your hand."},
        {"zh": "这洞口的风很暖。", "en": "The air at this cave mouth is warm."},
        {"zh": "刚出来，我先认你的脸。", "en": "Just summoned; first I learn your face."},
        {"zh": "我等你的命令。", "en": "I await your order."},
        {"zh": "我的针收好了。", "en": "My stinger is in."},
        {"zh": "我振了振翅膀。", "en": "I buzz my wings."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的翅膀，我掉下来。", "en": "Fire singes my wing and I drop."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处掉下去，撞在地上。", "en": "I fell from height and hit the ground."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让我飞不起来，我扑腾。", "en": "Water grounds me; I thrash."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹得打转。", "en": "The blast spins me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西擦过我的翅根。", "en": "Something grazed my wing's base."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "紫色的光让我看不清。", "en": "Violet light blurs my sight."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我振翅的声音越来越细。", "en": "The buzz of my wings grows thin."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光里我的翅膀亮了一下。", "en": "In the flash my wings lit up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有空气，我一直在掉。", "en": "No air, and I keep falling."}
      ]
    }
  }
}
