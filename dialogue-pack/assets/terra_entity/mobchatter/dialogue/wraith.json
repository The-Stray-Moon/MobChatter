{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在离地一寸处。", "en": "I float an inch off the ground."},
        {"zh": "袍角没有声音。", "en": "My robe hem makes no sound."},
        {"zh": "我不踩实任何东西。", "en": "I don't truly step on anything."},
        {"zh": "穿墙时冷了一下。", "en": "Passing through the wall was cold."},
        {"zh": "手里攥着一团光。", "en": "I hold a knot of light."},
        {"zh": "我飘过石阶。", "en": "I drift over the steps."},
        {"zh": "地上的草不动。", "en": "The grass doesn't stir."},
        {"zh": "我往前飘过去。", "en": "I drift forward."},
        {"zh": "身体轻得像烟。", "en": "My body is light as smoke."},
        {"zh": "身后没有脚印。", "en": "No prints behind me."},
        {"zh": "我绕开那堆火。", "en": "I circle wide of that fire."},
        {"zh": "影子淡得看不见。", "en": "My shadow is barely there."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，不碰任何东西。", "en": "I hang there, touching nothing."},
        {"zh": "手指在空中划过。", "en": "My fingers trace the air."},
        {"zh": "我的眼睛是两点白。", "en": "My eyes are two white points."},
        {"zh": "火太旺了，我往阴影里退。", "en": "The fire's too strong; I retreat into the shade."},
        {"zh": "我慢慢收拢袍子。", "en": "I gather my robe in."},
        {"zh": "风从我身上穿过。", "en": "The wind passes through me."},
        {"zh": "我想不起活着的时候。", "en": "I can't recall being alive."},
        {"zh": "我把光握紧。", "en": "I close my hand on the light."},
        {"zh": "石板下面有点凉。", "en": "Under the slab it's cool."},
        {"zh": "我在数走过的路。", "en": "I count the road behind me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你呵出的白气，我能看见。", "en": "I can see the white breath you exhale."},
        {"zh": "站远一点，我冷。", "en": "Stand off. I'm cold."},
        {"zh": "你能看见我吗。", "en": "Can you see me?"},
        {"zh": "你的热气飘过来了。", "en": "Your warmth drifts over."},
        {"zh": "我不想靠近火。", "en": "I don't want to go near fire."},
        {"zh": "我离地一寸，你踩不到。", "en": "An inch up. You can't step on me."},
        {"zh": "别把灯举高。", "en": "Don't raise that lamp."},
        {"zh": "活人走路的样子，我还记得。", "en": "I still remember how the living walk."},
        {"zh": "你手里有铁的味道。", "en": "Your hand smells of iron."},
        {"zh": "说句话，让我听听。", "en": "Say something. Let me hear."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的形体散了一瞬。", "en": "My form scattered for an instant."},
        {"zh": "光暗了一下。", "en": "The light dimmed."},
        {"zh": "光打过来，我的形体淡了。", "en": "Light strikes, and my form thins."},
        {"zh": "袍角被我扯破。", "en": "My robe hem tore."},
        {"zh": "这股冷更深了。", "en": "The chill grew deeper."},
        {"zh": "我的影子重新凝起来。", "en": "My shadow condenses again."},
        {"zh": "我一点也不怕疼。", "en": "Pain doesn't frighten me."},
        {"zh": "我的眼睛闪了闪。", "en": "My eyes flickered."},
        {"zh": "我记住这温度。", "en": "I remember that warmth."},
        {"zh": "你还挺能打。", "en": "You can fight, then."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那光有点暖。", "en": "That light is a little warm."},
        {"zh": "热食对我没用。", "en": "Warm food does nothing."},
        {"zh": "那股暖气飘过来了。", "en": "That warmth drifted over."},
        {"zh": "别举到我面前。", "en": "Don't hold it up to me."},
        {"zh": "我只需要一点热。", "en": "I only need a little heat."},
        {"zh": "搁在石头上，我看看就好。", "en": "Set it on the stone; I'll just look."},
        {"zh": "太亮了，我退开。", "en": "Too bright. I'm backing off."},
        {"zh": "热食穿过我，落在地上。", "en": "The warm food passes through me to the floor."},
        {"zh": "我记着这个味道。", "en": "I'll remember that smell."},
        {"zh": "你还留着自己用吧。", "en": "Keep it for yourself."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你穿过去，我散了一半。", "en": "You pass through and half of me scatters."},
        {"zh": "我像雾一样散了又聚。", "en": "I scattered like mist, then gathered."},
        {"zh": "别伸手进来。", "en": "Don't put your hand in."},
        {"zh": "我的袍子很凉。", "en": "My robe is cold."},
        {"zh": "这一撞没什么感觉。", "en": "That impact meant little."},
        {"zh": "我像烟一样飘开半尺。", "en": "I drift back half a foot like smoke."},
        {"zh": "你的肩膀打了个寒战。", "en": "Your shoulder shivered."},
        {"zh": "我身上没有骨头。", "en": "I have no bones."},
        {"zh": "我又飘回原处。", "en": "I drift back into place."},
        {"zh": "往旁边让开半尺。", "en": "Half a foot to the side."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就没有身体了。", "en": "I have no body left."},
        {"zh": "这份冷会伤到你。", "en": "This cold would hurt you."},
        {"zh": "别把你剩下的温度给我。", "en": "Don't give me what warmth you have left."},
        {"zh": "我连自己的名字都不记得。", "en": "I don't even know my name."},
        {"zh": "往前走，别转身看我。", "en": "Walk on, and don't turn to look at me."},
        {"zh": "我只是一点残余。", "en": "I'm only what's left over."},
        {"zh": "等天亮之前。", "en": "Before sunrise, maybe."},
        {"zh": "这种话，我听着更冷。", "en": "Words like that only make me colder."},
        {"zh": "我心里没有地方。", "en": "There's no room in me."},
        {"zh": "谢谢你还愿意站着。", "en": "Thank you for standing there."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "指尖一碰，它落到地上。", "en": "One touch of my fingertip and it drops."},
        {"zh": "我托不起来。", "en": "I can't lift it."},
        {"zh": "它落在我掌心又穿过。", "en": "It rests on my palm, then falls through."},
        {"zh": "这个对我没重量。", "en": "It has no weight for me."},
        {"zh": "我试着握一下。", "en": "Let me try to grip it."},
        {"zh": "它凉下来了。", "en": "It's gone cold."},
        {"zh": "它穿过我手心。", "en": "It fell through my palm."},
        {"zh": "我觉得它应该很值钱。", "en": "I think it must be valuable."},
        {"zh": "我记不清这些。", "en": "I can't recall these things."},
        {"zh": "我拿不动，你替我拿着。", "en": "I can't lift it; carry it for me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那团热气在动。", "en": "That warmth is moving."},
        {"zh": "活人的气味，在石头后面。", "en": "A living scent, behind the stone."},
        {"zh": "掌心的光聚起来了。", "en": "The light gathers in my hand."},
        {"zh": "光在掌心里转。", "en": "The light spins in my palm."},
        {"zh": "你转身了，我跟着转。", "en": "You turn, and I turn with you."},
        {"zh": "我不想伤你。", "en": "I don't want to hurt you."},
        {"zh": "这附近太安静了。", "en": "It's too quiet here."},
        {"zh": "我飘到你侧面。", "en": "I drift to your flank."},
        {"zh": "你的脚步变快了。", "en": "Your steps sped up."},
        {"zh": "活着时，我也这样转身。", "en": "When I lived, I turned like that too."},
        {"zh": "这里的空气发紧。", "en": "The air has gone tight."},
        {"zh": "我贴着地面飘。", "en": "I drift close to the floor."},
        {"zh": "你身后的空气冷了。", "en": "The air behind you went cold."},
        {"zh": "你跑多快，我都飘得到。", "en": "However fast you run, I drift there too."},
        {"zh": "这道弹幕已经成形。", "en": "The bolt has formed."},
        {"zh": "心跳一下，我就近一寸。", "en": "Every beat, I drift an inch closer."},
        {"zh": "现在就动手。", "en": "Now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我保持着这段距离。", "en": "I keep this distance."},
        {"zh": "你近了我就退。", "en": "Come closer and I back off."},
        {"zh": "掌心的光越聚越紧。", "en": "The light tightens in my palm."},
        {"zh": "我往高处飘一点。", "en": "I drift a little higher."},
        {"zh": "这样你够不到我。", "en": "Now you can't reach me."},
        {"zh": "你的箭从左边来。", "en": "Your arrow came from the left."},
        {"zh": "我绕着火堆走。", "en": "I circle the fire."},
        {"zh": "距离正合适。", "en": "The range is right."},
        {"zh": "我等你停下来。", "en": "I wait for you to stop."},
        {"zh": "风把我的袍子吹开。", "en": "The wind opens my robe."},
        {"zh": "你不该往低处跑。", "en": "You shouldn't run downhill."},
        {"zh": "这个角度很清楚。", "en": "This angle is clear."},
        {"zh": "再放一发出去。", "en": "Fire once more."},
        {"zh": "我的眼一直盯着。", "en": "My eyes never leave you."},
        {"zh": "你的手举到火光下。", "en": "Your hand rose to the torch."},
        {"zh": "我往高处飘。", "en": "I drift upward."},
        {"zh": "你躲在树后面也没用。", "en": "The tree won't save you."},
        {"zh": "弹幕已经出手。", "en": "The bolt is away."},
        {"zh": "再靠近一步。", "en": "One step closer."},
        {"zh": "你脚下一滑，我就出手。", "en": "One slip of your foot and I strike."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "手里的光推出去！", "en": "The light leaves my hand!"},
        {"zh": "我悬在你后颈那里。", "en": "I hover at the back of your neck."},
        {"zh": "寒气透过衣服。", "en": "The cold goes through cloth."},
        {"zh": "寒气顺着你衣领钻进去。", "en": "Cold crawls down inside your collar."},
        {"zh": "我又退回远处。", "en": "I retreat out of reach."},
        {"zh": "这一碰，你肩上结了霜。", "en": "This touch leaves frost on your shoulder."},
        {"zh": "我的指节穿过你。", "en": "My fingers pass through you."},
        {"zh": "你的牙开始轻轻打战。", "en": "Your teeth begin to chatter."},
        {"zh": "从你头顶上来。", "en": "From above your head."},
        {"zh": "指节已经贴上来了。", "en": "My knuckles are on you."},
        {"zh": "我缠住你的肩。", "en": "I wrap your shoulder."},
        {"zh": "先退，然后再放一发。", "en": "Fall back, fire again."},
        {"zh": "你跑开半步，我停在原地。", "en": "You spring back; I stop where I am."},
        {"zh": "我追不上跑的人。", "en": "I can't chase a runner."},
        {"zh": "这一发贴着地。", "en": "This shot skims the ground."},
        {"zh": "离开这堆火。", "en": "Leave the fire."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "空气先冷了。", "en": "The air went cold first."},
        {"zh": "墙角浮出两个白点。", "en": "Two white points float at the corner."},
        {"zh": "我的袍子在飘。", "en": "My robe is drifting."},
        {"zh": "地上的影子淡下去。", "en": "The shadow on the ground fades."},
        {"zh": "石墙里飘出一阵阴冷。", "en": "A chill seeps out of the stone wall."},
        {"zh": "这里有些旧的事。", "en": "There are old things here."},
        {"zh": "我没有踩出声音。", "en": "I made no sound on arrival."},
        {"zh": "火堆不欢迎我。", "en": "The campfire doesn't welcome me."},
        {"zh": "我停在半空等你。", "en": "I hang in the air and wait."},
        {"zh": "雾散开时我在。", "en": "I'm there when the fog clears."},
        {"zh": "这不是活人的温度。", "en": "This isn't the temperature of the living."},
        {"zh": "我又回到这块地。", "en": "I've come back to this ground."},
        {"zh": "手心里有光。", "en": "There's light in my palm."},
        {"zh": "我从来不敲门。", "en": "I never knock."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的形体烧散了。", "en": "Fire scattered my form."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下去，穿过了地面。", "en": "I fell and passed through the ground."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我压得很沉。", "en": "The water pressed me down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我的袍子撕开。", "en": "The blast tore my robe."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "东西穿过了我，还是疼。", "en": "It passed through. It still hurt."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这道光和我的不同。", "en": "This light isn't like mine."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的饥饿，是另一种空。", "en": "My hunger is a different kind of emptiness."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把我照得透明。", "en": "The flash made me transparent."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空吞掉了我的袍角。", "en": "The void swallows the hem of my robe."}
      ]
    }
  }
}
