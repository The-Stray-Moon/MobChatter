{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的一段身子先过来。", "en": "One segment of me arrives first."},
        {"zh": "体节一节接一节。", "en": "Segment rolls after segment."},
        {"zh": "我贴着云层边缘游。", "en": "I swim along the cloud edge."},
        {"zh": "翅膀扇得空气发响。", "en": "My wings beat the air loud."},
        {"zh": "长身子在身后弯曲。", "en": "My long body curves behind me."},
        {"zh": "我从这片天滑到那片。", "en": "I slide from one sky patch to another."},
        {"zh": "鳞片擦着风。", "en": "My scales scrape the wind."},
        {"zh": "我低飞掠过高地。", "en": "I sweep low over the high ground."},
        {"zh": "尾节还在云里。", "en": "My tail segment is still in the cloud."},
        {"zh": "我拐了个大弯。", "en": "I bank a wide turn."},
        {"zh": "头先到了，身子随后。", "en": "The head arrives, then the rest."},
        {"zh": "我盘着飞了一段。", "en": "I fly a spiraling stretch."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀慢慢扇，我停在云下。", "en": "Wings beat slow; I hang below the clouds."},
        {"zh": "我的体节慢慢扭。", "en": "My segments twist slowly."},
        {"zh": "翅膀张得很开。", "en": "My wings spread wide."},
        {"zh": "云从身子下面过。", "en": "Clouds pass below me."},
        {"zh": "我在高处看着地面。", "en": "I watch the ground from up here."},
        {"zh": "这里风很大。", "en": "The wind is strong here."},
        {"zh": "长长的脖子绕回来看你。", "en": "My long neck curls back to look at you."},
        {"zh": "身上有点冷。", "en": "I feel a little cold."},
        {"zh": "这条路我飞过很多次。", "en": "I've flown this way many times."},
        {"zh": "体节与体节摩擦。", "en": "My segments grind together."},
        {"zh": "我收了一下翅膀。", "en": "I fold my wings in a little."},
        {"zh": "下面的树像苔。", "en": "The trees look like moss below."},
        {"zh": "我没有落地。", "en": "I never land."},
        {"zh": "我一节一节往上升。", "en": "I rise a segment at a time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你把头抬起来了。", "en": "You looked up."},
        {"zh": "云下面那团影子是我。", "en": "That shadow under the clouds is me."},
        {"zh": "我的身子比你想的长。", "en": "My body is longer than you think."},
        {"zh": "你的弓够不到我。", "en": "Your bow won't reach me."},
        {"zh": "你每挪一步，我心里记一笔。", "en": "Every step you shift, I mark it down."},
        {"zh": "风把声音往这边送。", "en": "The wind carries your sound to me."},
        {"zh": "我一段一段地过来。", "en": "I come segment by segment."},
        {"zh": "洞口那么浅，藏不住你。", "en": "That cave mouth is too shallow to hide you."},
        {"zh": "你在天上的影子很小。", "en": "Your shadow below is small."},
        {"zh": "下面的人都在跑。", "en": "The ones below are running."},
        {"zh": "我不会马上落下。", "en": "I won't come down at once."},
        {"zh": "抬头看久一点。", "en": "Keep looking up."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一节体节被打裂。", "en": "One segment cracked."},
        {"zh": "我这一节歪了，还没断。", "en": "This segment is bent, not broken."},
        {"zh": "一片鳞飞了出去。", "en": "A scale flew off."},
        {"zh": "翅膀有一处破口。", "en": "A tear in one wing."},
        {"zh": "我在空中翻了一下。", "en": "I rolled in the air."},
        {"zh": "我翅膀还能扇。", "en": "My wings still beat."},
        {"zh": "这点伤不影响高度。", "en": "This won't cost me altitude."},
        {"zh": "我重新拉起来。", "en": "I pull back up."},
        {"zh": "我记得你站的地方。", "en": "I know where you stood."},
        {"zh": "我还没那么快倒。", "en": "I'm not falling yet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "底下有什么在亮。", "en": "Something glints below."},
        {"zh": "这是肉的味道。", "en": "That smells like meat."},
        {"zh": "我往低处飞一点。", "en": "I'll drop a little lower."},
        {"zh": "那种东西不管饱。", "en": "That won't fill me."},
        {"zh": "你再举高些。", "en": "Hold it higher."},
        {"zh": "这点东西塞牙缝。", "en": "That won't fill a tooth gap."},
        {"zh": "在下面等着。", "en": "Wait down there."},
        {"zh": "闻起来还算行。", "en": "It smells tolerable."},
        {"zh": "我一圈就下来。", "en": "One circle and I'll come down."},
        {"zh": "地面上跑不掉。", "en": "You can't run from above."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的体节上。", "en": "You struck one of my segments."},
        {"zh": "我的航线偏了。", "en": "I drifted off course."},
        {"zh": "我不太在乎。", "en": "I hardly care."},
        {"zh": "我的身子太长。", "en": "My body is too long."},
        {"zh": "我的身子还没全过来。", "en": "The rest of me hasn't arrived."},
        {"zh": "翅膀擦到了东西。", "en": "A wing scraped something."},
        {"zh": "我又盘旋回来。", "en": "I circle back around."},
        {"zh": "你把我的落差打乱了。", "en": "You broke my altitude."},
        {"zh": "撞一下，我的航线晃了晃。", "en": "One knock and my flight path wavers."},
        {"zh": "我的体节磕到了塔。", "en": "My segments struck the tower."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我要盘旋很久才考虑。", "en": "I'd circle a long while first."},
        {"zh": "你根本不会飞。", "en": "You can't fly at all."},
        {"zh": "我的身子这么长不合适。", "en": "A body this long isn't suited."},
        {"zh": "天上没有隐蔽的地方。", "en": "There's no cover in the sky."},
        {"zh": "先让我飞完这一圈。", "en": "Let me finish this circle."},
        {"zh": "我需要一个高处的窝。", "en": "I'd need a high nest."},
        {"zh": "这话题放低点。", "en": "Lower that subject."},
        {"zh": "你连我的一段都抱不住。", "en": "You couldn't hold one segment."},
        {"zh": "我会把云留给你的。", "en": "I'd leave you the clouds."},
        {"zh": "我先飞走了。", "en": "I'll fly off first."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我够不到那么小。", "en": "I can't reach anything that small."},
        {"zh": "爪子一挑，东西进了掌握。", "en": "One flick of my claw and it's in my grip."},
        {"zh": "这个给我没用。", "en": "That's no use to me."},
        {"zh": "我扔到下面去。", "en": "I drop it below."},
        {"zh": "它从爪间滑了。", "en": "It slipped from my grip."},
        {"zh": "地上那个我看得见。", "en": "I see that one on the ground."},
        {"zh": "留着也没关系。", "en": "Leaving it is fine."},
        {"zh": "我拖着它飞了一段。", "en": "I carried it a stretch."},
        {"zh": "这味道不怎么样。", "en": "It doesn't taste good."},
        {"zh": "这些你们分吧。", "en": "Share these among you."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "底下有东西在跑。", "en": "Something is running below."},
        {"zh": "那影子不对。", "en": "That shadow is wrong."},
        {"zh": "我收拢翅膀。", "en": "I pull my wings in."},
        {"zh": "头已经转向下面。", "en": "My head has turned down."},
        {"zh": "我一段一段地压下去。", "en": "I descend segment by segment."},
        {"zh": "你的脚步声很清楚。", "en": "Your steps are very clear."},
        {"zh": "我从云里露出来了。", "en": "I've shown myself from the cloud."},
        {"zh": "这一片天是我的。", "en": "This stretch of sky is mine."},
        {"zh": "我看见你停了。", "en": "I saw you stop."},
        {"zh": "别把头抬起来。", "en": "Don't look up."},
        {"zh": "我收起翅膀，准备往下砸。", "en": "I fold my wings, ready to drop."},
        {"zh": "你身后的墙挡不住。", "en": "The wall behind you won't help."},
        {"zh": "长身子已经围过来了。", "en": "My long body is already curling in."},
        {"zh": "这地方太空旷。", "en": "This place is too open."},
        {"zh": "风一停，你就听得见我了。", "en": "When the wind dies, you'll hear me."},
        {"zh": "头低下来了。", "en": "My head comes down."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘旋着看你。", "en": "I circle and watch you."},
        {"zh": "你跑的方向我知道。", "en": "I know which way you run."},
        {"zh": "我擦着树梢，头朝下。", "en": "I skim the treetops, head down."},
        {"zh": "再低一点就能抓。", "en": "A little lower and I can grab."},
        {"zh": "影子绕着你画圈，慢慢收。", "en": "My shadow circles you, drawing tighter."},
        {"zh": "你躲在树下。", "en": "You're under a tree."},
        {"zh": "我从上面绕。", "en": "I go round from above."},
        {"zh": "体节跟着头走。", "en": "My segments follow my head."},
        {"zh": "你数不清我有几节。", "en": "You can't count my segments."},
        {"zh": "我抬高几尺，找下扑的角度。", "en": "I rise a few lengths to pick my angle."},
        {"zh": "你在等天黑吗。", "en": "Waiting for night?"},
        {"zh": "我等你的位置固定。", "en": "I wait for you to hold still."},
        {"zh": "风把我的声音带走。", "en": "The wind takes my sound away."},
        {"zh": "你进了我的圈里。", "en": "You're inside my circle."},
        {"zh": "再盘旋一圈。", "en": "One more circle."},
        {"zh": "这次从背后。", "en": "From behind this time."},
        {"zh": "身子都摆好了。", "en": "The whole coil is set."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "整条身子从空中砸下来！", "en": "My whole length crashes down from the sky!"},
        {"zh": "头撞你的胸。", "en": "My head strikes your chest."},
        {"zh": "尾巴扫过来。", "en": "My tail sweeps through."},
        {"zh": "体节一节节压过。", "en": "Segment after segment rolls over."},
        {"zh": "翅膀把你掀翻。", "en": "My wings knock you down."},
        {"zh": "一整节撞上你。", "en": "A full segment hits you."},
        {"zh": "我缠住你的腰。", "en": "I coil around your waist."},
        {"zh": "牙咬得很深。", "en": "My teeth sink deep."},
        {"zh": "你被推离地面了。", "en": "You left the ground."},
        {"zh": "再带高一点。", "en": "Higher still."},
        {"zh": "我松开你就掉下去。", "en": "When I let go, you fall."},
        {"zh": "下面没东西接你。", "en": "Nothing down there catches you."},
        {"zh": "别硬撑，会折断的。", "en": "Don't struggle. It'll break."},
        {"zh": "牙缝里还留着。", "en": "My teeth still hold."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "云层裂开一道。", "en": "A gap opens in the clouds."},
        {"zh": "我在高处展开身体。", "en": "I unfold high up."},
        {"zh": "体节一节节露出来。", "en": "Segment after segment shows."},
        {"zh": "翅膀把云推开。", "en": "My wings push the cloud aside."},
        {"zh": "下面的树开始摇。", "en": "The trees below begin to shake."},
        {"zh": "我从天边过来。", "en": "I come from the edge of the sky."},
        {"zh": "地上的影子比我先到。", "en": "My shadow lands before I do."},
        {"zh": "风里有我的味道。", "en": "My scent is on the wind."},
        {"zh": "我盘旋了两圈。", "en": "I circled twice."},
        {"zh": "我裂开云层，降下一截。", "en": "I split the clouds and drop a length."},
        {"zh": "这里的天很干净。", "en": "The sky is clean here."},
        {"zh": "一片鳞掉了下来。", "en": "A scale fell."},
        {"zh": "我把头探出云。", "en": "I poke my head out of the cloud."},
        {"zh": "这条路我认得。", "en": "I know this route."},
        {"zh": "云层下面有人在走。", "en": "Someone walks beneath the clouds."},
        {"zh": "我开始俯冲。", "en": "I begin my dive."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在我鳞上烧。", "en": "Flame burns on my scales."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在地上，体节散开。", "en": "I hit the ground and my segments splayed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我的翅膀抬不起来。", "en": "My wings won't lift in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我在气浪里打转。", "en": "The blast spun me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎在翼膜上。", "en": "An arrow in my wing membrane."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光烧穿了我的鳞。", "en": "The light burned through my scales."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿了飞得没那么稳。", "en": "Hunger makes my flight unsteady."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的长身走。", "en": "Lightning runs down my length."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在一直往下掉。", "en": "I keep falling."}
      ]
    }
  }
}
