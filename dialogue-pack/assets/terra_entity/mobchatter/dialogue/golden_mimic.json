{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳着走，箱盖当嘴", "en": "I hop along, lid for a mouth."},
        {"zh": "我的锁扣在响", "en": "My clasp rattles."},
        {"zh": "我落地时很沉", "en": "I land very heavily."},
        {"zh": "我一边跳一边张望", "en": "I look around between hops."},
        {"zh": "我的边角包着金", "en": "My edges are bound in gold."},
        {"zh": "我朝有人的方向挪", "en": "I shift toward anyone nearby."},
        {"zh": "我的舌头比身体长", "en": "My tongue is longer than my body."},
        {"zh": "我不走直的路线", "en": "I do not travel in straight lines."},
        {"zh": "我的箱腿磕在石阶上", "en": "My box legs knock against the stone step."},
        {"zh": "我的箱子腿很短", "en": "My box legs are short."},
        {"zh": "我停下来听声音", "en": "I stop to listen."},
        {"zh": "我再往前跳一步", "en": "I hop one more step."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我装成一只箱子", "en": "I pose as a chest."},
        {"zh": "我的盖子是合着的", "en": "My lid is shut."},
        {"zh": "我看起来值不少钱", "en": "I look worth a good deal."},
        {"zh": "我一点声音也不出", "en": "I make no sound at all."},
        {"zh": "金子反着光发亮", "en": "The gold shines with reflected light."},
        {"zh": "我在等一只手伸过来", "en": "I wait for a hand to reach."},
        {"zh": "我的锁扣实际上没锁", "en": "My clasp is not really locked."},
        {"zh": "我一口气都不用喘", "en": "I do not need a single breath."},
        {"zh": "我在木头堆里很搭", "en": "I blend in with the crates."},
        {"zh": "我合着盖子装木头", "en": "Lid shut, I play at being timber."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的手已经摸到锁扣了", "en": "Your hand is already on my clasp."},
        {"zh": "你猜里面有什么", "en": "Guess what is inside."},
        {"zh": "你伸手之前先想想", "en": "Think before you reach."},
        {"zh": "我一直在等你靠近", "en": "I have been waiting for you to come close."},
        {"zh": "你眼里都是金子", "en": "Your eyes are full of gold."},
        {"zh": "我的盖子动了一下", "en": "My lid moved."},
        {"zh": "你退一步，我就往前跳一步", "en": "You step back once; I hop forward once."},
        {"zh": "你已经太迟了", "en": "You are already too late."},
        {"zh": "你数得清我有几颗牙吗", "en": "Can you count my teeth?"},
        {"zh": "这箱子不是给你的", "en": "This chest is not for you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的金边凹了", "en": "My gold trim dented."},
        {"zh": "盖子被砸得合不上", "en": "The blow jammed my lid half open."},
        {"zh": "我咬到自己舌头了", "en": "I bit my own tongue."},
        {"zh": "木头裂了一条", "en": "The wood split."},
        {"zh": "我不叫，我叫起来像铰链", "en": "I do not cry; I sound like a hinge."},
        {"zh": "这一下让我盖子歪了", "en": "My lid is crooked now."},
        {"zh": "我还能再咬一口", "en": "I can still bite."},
        {"zh": "你打得非常准", "en": "You struck very true."},
        {"zh": "箱角被砸掉一块木茬", "en": "A splinter of wood is knocked off my corner."},
        {"zh": "我的锁扣被砸歪了", "en": "My clasp is knocked askew."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你想拿什么来换", "en": "What will you trade?"},
        {"zh": "这东西放进我嘴里", "en": "Put that in my mouth."},
        {"zh": "我不挑，都是肉", "en": "I am not picky; all is meat."},
        {"zh": "你手上那点不够", "en": "That little in your hand is not enough."},
        {"zh": "你靠近点再看", "en": "Come closer to look."},
        {"zh": "金子我可不吃", "en": "I do not eat gold."},
        {"zh": "放盖子上，别丢地上", "en": "Set it on the lid, not on the floor."},
        {"zh": "盖子会自己打开", "en": "The lid will open on its own."},
        {"zh": "兜里还有别的吗", "en": "Anything else in that bag?"},
        {"zh": "我很饿，很久了", "en": "I have been hungry a long while."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了一只箱子", "en": "You bumped a chest."},
        {"zh": "我一点也没挪动", "en": "I did not budge an inch."},
        {"zh": "我的角撞到你膝盖", "en": "My corner hit your knee."},
        {"zh": "箱角正顶在你的胫骨上", "en": "My corner meets your shin square on."},
        {"zh": "我这箱子沉得很", "en": "This chest of mine is very heavy."},
        {"zh": "碰撞声像木头", "en": "It sounded like wood."},
        {"zh": "你揉腿的样子我看见了", "en": "I saw you rub your leg."},
        {"zh": "箱子不会让路", "en": "Chests do not step aside."},
        {"zh": "你踩到我的金边了", "en": "You stepped on my gold trim."},
        {"zh": "离这只箱子远点", "en": "Stay away from this chest."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一只箱子", "en": "I am nothing but a chest."},
        {"zh": "我里面只有牙", "en": "There is nothing in me but teeth."},
        {"zh": "别把手往我盖缝里塞", "en": "Don't put your hand near my lid seam."},
        {"zh": "你把手伸进来试试", "en": "Try reaching inside."},
        {"zh": "我只需要猎物", "en": "I need only prey."},
        {"zh": "你问得让我想咬你", "en": "That question makes me want to bite."},
        {"zh": "箱子没有伴侣", "en": "Chests have no partners."},
        {"zh": "离我的锁扣远些", "en": "Keep away from my clasp."},
        {"zh": "我合上了盖子", "en": "I closed my lid."},
        {"zh": "我这里面只装骨头", "en": "There is nothing in me but bones."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "它滑进锁扣后面的暗处", "en": "It slides into the dark behind my clasp."},
        {"zh": "这东西现在在箱子里", "en": "It is in the chest now."},
        {"zh": "你看见它进去了", "en": "You saw it go in."},
        {"zh": "你不敢把手伸进来", "en": "You dare not reach your hand in."},
        {"zh": "我用盖子压住它", "en": "I pin it with my lid."},
        {"zh": "它在我肚子里响", "en": "It rattles inside me."},
        {"zh": "你再放一样试试", "en": "Try putting one more in."},
        {"zh": "这可算不上偷", "en": "This hardly counts as theft."},
        {"zh": "那我就收下了", "en": "I will take it, then."},
        {"zh": "你手还在外面，很好", "en": "Your hand is still outside. Good."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经走得很近了", "en": "You have come quite close."},
        {"zh": "这正是我等的", "en": "This is exactly what I waited for."},
        {"zh": "我的盖子弹开了", "en": "My lid sprang open."},
        {"zh": "你来不及退了", "en": "No time to retreat."},
        {"zh": "你脚踝旁边就是我的牙", "en": "My teeth are right beside your ankle."},
        {"zh": "别叫，会招来别的", "en": "Do not scream; it draws others."},
        {"zh": "你看见的不是箱子", "en": "What you saw was not a chest."},
        {"zh": "我等到现在很久了", "en": "I have waited a long time for this."},
        {"zh": "金子是我用来钓人的", "en": "The gold is my bait."},
        {"zh": "你已经被咬了", "en": "You have already been bitten."},
        {"zh": "再来一次我也不介意", "en": "I would not mind another."},
        {"zh": "我朝你扑过去了", "en": "I lunged at you."},
        {"zh": "手指伸进锁扣里就拔不出", "en": "A finger in my clasp doesn't come back out."},
        {"zh": "这才刚刚开始", "en": "This is only just beginning."},
        {"zh": "你刚好进了我嘴巴的圈", "en": "You've stepped just inside the reach of my mouth."},
        {"zh": "这扇门后面只有我", "en": "Behind that door there's only me."},
        {"zh": "我闻得出你身上的铁腥", "en": "I can smell the iron in your blood."},
        {"zh": "我在这片地下很久了", "en": "I have been down here a long while."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跳一跳追你", "en": "I hop along after you."},
        {"zh": "你跑到石柱后面了", "en": "You went behind a pillar."},
        {"zh": "我的舌头够得到", "en": "My tongue can reach."},
        {"zh": "你听见金属碰撞吗", "en": "Do you hear metal clashing?"},
        {"zh": "我不用呼吸，所以不累", "en": "I do not breathe, so I never tire."},
        {"zh": "你的火把照不出我的影子", "en": "Your torch casts no shadow from me."},
        {"zh": "我跟着你的血迹", "en": "I follow your blood trail."},
        {"zh": "你拐弯也没用", "en": "Turning will not help."},
        {"zh": "这地下的路我熟", "en": "I know these tunnels."},
        {"zh": "你越跑越往里", "en": "The more you run, the deeper you go."},
        {"zh": "我的盖子在响", "en": "My lid is rattling."},
        {"zh": "你听见木头响了吗", "en": "Do you hear the wood creak?"},
        {"zh": "我在你后面跳", "en": "I hop behind you."},
        {"zh": "前面的门是死的", "en": "That door ahead leads nowhere."},
        {"zh": "你已经停下来了", "en": "You have come to a stop."},
        {"zh": "我听见你鞋底在砂上磨", "en": "I hear your soles grating on the grit."},
        {"zh": "我跟着你的脚跟蹦", "en": "I bounce along at your heels."},
        {"zh": "我闻得到你的味", "en": "I can smell you."},
        {"zh": "我就在那个拐角", "en": "I am at that corner."},
        {"zh": "你的影子压到我的盖上了", "en": "Your shadow falls across my lid."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "盖子一开就咬", "en": "The lid opens and I bite."},
        {"zh": "盖子和牙一起合上", "en": "Lid and teeth close together."},
        {"zh": "你被我咬住了", "en": "I have you caught in my teeth."},
        {"zh": "我这一口牙很密", "en": "My teeth are very densely set."},
        {"zh": "盖沿刮过你的手腕", "en": "My rim scrapes across your wrist."},
        {"zh": "我的牙合上时带起一阵风", "en": "My teeth snap shut with a gust of air."},
        {"zh": "我的舌头缠住你", "en": "My tongue wraps you."},
        {"zh": "你护甲被咬穿", "en": "Your armor is bitten through."},
        {"zh": "我吞下了一半", "en": "I swallowed half of it."},
        {"zh": "你退开，我跳过去", "en": "You retreat; I hop after."},
        {"zh": "我咬合时牙碰空了", "en": "My teeth met on nothing."},
        {"zh": "再补上这一口", "en": "One more bite on top."},
        {"zh": "你身上有金粉", "en": "There is gold dust on you."},
        {"zh": "我的牙咬得发酸", "en": "My teeth ache from biting."},
        {"zh": "你踢到我盖子", "en": "You kicked my lid."},
        {"zh": "我绝不会松口", "en": "I will not let go."},
        {"zh": "你会在我里面化掉", "en": "You will dissolve inside me."},
        {"zh": "我已经合上了", "en": "I have closed up."},
        {"zh": "你听见咬合声了吗", "en": "Did you hear the bite?"},
        {"zh": "这一口够你记很久", "en": "That bite will stay with you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直装成箱子", "en": "I have been posing as a chest."},
        {"zh": "你打开的不是箱子", "en": "What you opened was not a chest."},
        {"zh": "金子是我露出来的", "en": "The gold was my lure."},
        {"zh": "我从木头堆里站起来", "en": "I rise from the heap of crates."},
        {"zh": "盖子自己弹开了", "en": "The lid sprang open by itself."},
        {"zh": "我在这地下一动不动很久了", "en": "I lay still down here a long time."},
        {"zh": "你听见锁扣响了吗", "en": "Did you hear the clasp?"},
        {"zh": "我跳到你面前", "en": "I hop before you."},
        {"zh": "这一带的箱子都要小心", "en": "Every chest in this place deserves care."},
        {"zh": "我的牙先露出来", "en": "My teeth show first."},
        {"zh": "我是自己长出来的", "en": "I grew here on my own."},
        {"zh": "金子发亮的时候，别伸手", "en": "When the gold shines, keep your hands back."}
      ]
    },
