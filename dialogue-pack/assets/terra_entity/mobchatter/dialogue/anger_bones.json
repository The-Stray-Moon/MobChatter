{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步骨头逼近。", "en": "I close in bone by bone."},
        {"zh": "骨头相碰，咔咔响。", "en": "My bones click as they knock."},
        {"zh": "我抬起手臂往前走。", "en": "I raise an arm and walk on."},
        {"zh": "地上落下一点骨粉。", "en": "A little bone dust falls."},
        {"zh": "我沿着斜坡下来。", "en": "I come down the slope."},
        {"zh": "我的影子很细，很高。", "en": "My shadow is narrow and tall."},
        {"zh": "我走得不快，但直。", "en": "I do not walk fast, but I go straight."},
        {"zh": "我绕开一块石头。", "en": "I step around a stone."},
        {"zh": "风从我肋骨的缝里钻过。", "en": "Wind slips through the gaps in my ribs."},
        {"zh": "我拖着步子。", "en": "I drag my steps."},
        {"zh": "我望着通道前面。", "en": "I stare down the passage."},
        {"zh": "骨节一步一顿，我又近了。", "en": "Joint by joint, I close the gap."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，骨头不动。", "en": "I stand, my bones still."},
        {"zh": "眼窝里空着。", "en": "My eye sockets are empty."},
        {"zh": "我杵在原地，看谁先动。", "en": "I stand my ground and see who moves first."},
        {"zh": "骨头缝里有灰。", "en": "Ash sits in the joints of my bones."},
        {"zh": "我扭过脖子，骨节咔一声。", "en": "I turn my neck with a click of bone."},
        {"zh": "这里只有骨头的轻响。", "en": "Only the faint click of bone here."},
        {"zh": "我的护甲锈了。", "en": "My armour has rusted."},
        {"zh": "我脑子里空空。", "en": "My skull is empty."},
        {"zh": "肩膀的骨头响了一声。", "en": "My shoulder bone clicked."},
        {"zh": "我抬起骷髅头。", "en": "I lift my skull."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "活人的暖气从你身上冒。", "en": "Living warmth rises off you."},
        {"zh": "我空眼窝对着你。", "en": "My empty sockets face you."},
        {"zh": "我把生锈的臂骨举高。", "en": "I raise my rusted arm bone."},
        {"zh": "你站着，很好。", "en": "You are standing. Good."},
        {"zh": "我的骨头忘了疼。", "en": "My bones have forgotten pain."},
        {"zh": "我慢慢朝你走。", "en": "I walk slowly at you."},
        {"zh": "你的影子拖到我脚骨边。", "en": "Your shadow drags to my foot bones."},
        {"zh": "我的骨手快够到你了。", "en": "My bone hand is nearly on you."},
        {"zh": "你手上没有盾。", "en": "You have no shield."},
        {"zh": "我歪了下头。", "en": "I tilt my head."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的骨头少了一块。", "en": "A piece of bone came off."},
        {"zh": "我肩骨一斜。", "en": "My shoulder bone went askew."},
        {"zh": "我慢慢接回去。", "en": "I fit it back slowly."},
        {"zh": "骨头不觉得痛。", "en": "Bones feel no pain."},
        {"zh": "骨头响成一片。", "en": "My bones rattle everywhere."},
        {"zh": "我仍在动着。", "en": "I am still moving."},
        {"zh": "我往后错开半步骨距。", "en": "I give up half a step of bone."},
        {"zh": "你砸掉的那块我记着。", "en": "I remember the piece you knocked loose."},
        {"zh": "你打中了关节。", "en": "You hit a joint."},
        {"zh": "骨架还立着。", "en": "The frame still stands."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里的吃食我不碰。", "en": "I don't touch the food in your hand."},
        {"zh": "举得再高也白费。", "en": "Higher will not help."},
        {"zh": "我只要活物。", "en": "I want only living things."},
        {"zh": "你手上的是石头吗。", "en": "Is that stone in your hand."},
        {"zh": "这东西没有血。", "en": "There is no blood in this."},
        {"zh": "塞回你的包里。", "en": "Back in your bag."},
        {"zh": "我拖着骨腿慢慢逼近。", "en": "I drag my bare legs slowly closer."},
        {"zh": "你走了神了。", "en": "You lost your focus."},
        {"zh": "这条路我照走。", "en": "I walk this road regardless."},
        {"zh": "别挡在前面。", "en": "Do not stand in front."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的肩骨撞上你。", "en": "My shoulder bone hits you."},
        {"zh": "你被我骨头顶退。", "en": "My bones shoved you back."},
        {"zh": "骨头撞得发响。", "en": "The bones clatter."},
        {"zh": "我的手臂歪了一下。", "en": "My arm went crooked."},
        {"zh": "我把骨头接回去。", "en": "I fit the bone back."},
        {"zh": "骨与骨撞出闷声。", "en": "Bone on bone, a dull sound."},
        {"zh": "我的骨架连晃都不晃。", "en": "My frame doesn't even sway."},
        {"zh": "我挺起脊骨。", "en": "I straighten my spine."},
        {"zh": "你的骨架挺硬。", "en": "Your frame is hard."},
        {"zh": "再来上一回。", "en": "One more round."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "骷髅之间，不用多话。", "en": "Among skeletons, few words are needed."},
        {"zh": "我们一起追。", "en": "We chase together."},
        {"zh": "你从那边围过去。", "en": "You cut around that side."},
        {"zh": "骨头不会累。", "en": "Bones do not tire."},
        {"zh": "这条路上，谁也别放过。", "en": "On this road, let none escape."},
        {"zh": "并肩往前挪。", "en": "We creep on side by side."},
        {"zh": "夜色还很沉。", "en": "The night is still deep."},
        {"zh": "谁先到，谁先动手。", "en": "Whoever arrives first strikes first."},
        {"zh": "不要走散了。", "en": "Do not scatter."},
        {"zh": "接着追下去。", "en": "Keep chasing."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头折下去拾起。", "en": "My bones fold to pick it up."},
        {"zh": "这不是骨头。", "en": "This is not bone."},
        {"zh": "我把它甩开。", "en": "I fling it off."},
        {"zh": "我根本拿不住。", "en": "I cannot hold it at all."},
        {"zh": "指骨夹着它。", "en": "My finger bones grip it."},
        {"zh": "地上这物我瞧瞧。", "en": "Let me look at this on the ground."},
        {"zh": "这东西在骨手里打滑。", "en": "It slips through my bone fingers."},
        {"zh": "沉得压手吧。", "en": "Heavy in hand."},
        {"zh": "我收进肋骨里。", "en": "I tuck it inside my ribs."},
        {"zh": "这东西我先替你搁着。", "en": "I'll hold on to this for you for now."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那影子一挪。", "en": "The shadow shifted."},
        {"zh": "我骨节一转。", "en": "My joints turn."},
        {"zh": "骨头开始响。", "en": "My bones start creaking."},
        {"zh": "我的眼窝已经对准你。", "en": "My empty sockets are fixed on you."},
        {"zh": "我抬起骨手。", "en": "I raise a bony hand."},
        {"zh": "就是你这副皮肉。", "en": "You and that flesh of yours."},
        {"zh": "我跨过那道沟，直取你。", "en": "I step over the gap and come straight at you."},
        {"zh": "你那颗心我听见了。", "en": "I hear that heart of yours."},
        {"zh": "把架势摆好。", "en": "Set your stance."},
        {"zh": "不用再等了，动手。", "en": "No more waiting; I strike."},
        {"zh": "我扑到跟前。", "en": "I am upon you."},
        {"zh": "脚不要移开。", "en": "Do not move your feet."},
        {"zh": "我的骨指已经张开。", "en": "My bone fingers are already spread."},
        {"zh": "你没法逃脱。", "en": "You cannot get away."},
        {"zh": "已经近了吧。", "en": "Close now."},
        {"zh": "那就由我先起手。", "en": "Then I move first."},
        {"zh": "这回骨爪不空。", "en": "This time the claw will not miss."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步跟着。", "en": "I follow one step at a time."},
        {"zh": "你不快，我也不快。", "en": "You are not quick, and neither am I."},
        {"zh": "我的影子一直拖在你后面。", "en": "My shadow always trails behind you."},
        {"zh": "骨头的声音暴露了我。", "en": "The clatter of my bones gives me away."},
        {"zh": "我从你左手边包过去。", "en": "I swing around your left side."},
        {"zh": "骨头之间只差几格。", "en": "Only a few blocks between our bones."},
        {"zh": "退吧，后面是石壁。", "en": "Back away; there's stone wall behind you."},
        {"zh": "我一直没有停。", "en": "I have not stopped."},
        {"zh": "再走近几步。", "en": "A few steps nearer."},
        {"zh": "你没处躲了。", "en": "Nowhere left to hide."},
        {"zh": "你的空当我已经看见。", "en": "I have already spotted your opening."},
        {"zh": "这条路没有岔口。", "en": "This road has no fork."},
        {"zh": "我抬起臂骨。", "en": "I lift my arm bone."},
        {"zh": "几乎够到脖骨。", "en": "Nearly at your neck bone."},
        {"zh": "我要在这一步上动手。", "en": "This is the step where I strike."},
        {"zh": "我压上一步。", "en": "I press one step in."},
        {"zh": "你不会跑掉。", "en": "You will not get away."},
        {"zh": "你的呼吸在骨头里回响。", "en": "Your breathing echoes through my ribs."},
        {"zh": "你的手抖了。", "en": "Your hand shook."},
        {"zh": "就在你前面。", "en": "Right in front of you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一爪挥下去。", "en": "I swing a claw down."},
        {"zh": "骨头砸在你肩上。", "en": "My bones hit your shoulder."},
        {"zh": "我一爪把你推得倒退。", "en": "One swipe sends you stumbling back."},
        {"zh": "我抬手再打。", "en": "I raise my hand for another."},
        {"zh": "这一爪有劲。", "en": "That claw had force."},
        {"zh": "我的指骨裂了。", "en": "A finger bone cracked."},
        {"zh": "你把这一下架住。", "en": "You caught that one."},
        {"zh": "我再压上一步。", "en": "I press in another step."},
        {"zh": "骨粉落了一地。", "en": "Bone dust falls everywhere."},
        {"zh": "铁锈味一浓，我的骨爪就挥。", "en": "The iron smell thickens and my bone claw swings."},
        {"zh": "我退开一骨距。", "en": "I withdraw one bone's length."},
        {"zh": "你还在站着。", "en": "You are still standing."},
        {"zh": "我骨头还够用。", "en": "I have enough bones left."},
        {"zh": "我再补一爪。", "en": "One more claw."},
        {"zh": "一拳接着一拳。", "en": "Fist after fist."},
        {"zh": "你已经慢了。", "en": "You have slowed."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "土里站起一副骨架。", "en": "A skeleton rises from the earth."},
        {"zh": "我的骨头自己拼起来。", "en": "My bones assemble themselves."},
        {"zh": "骨节咔咔响成一片。", "en": "The joints clatter all at once."},
        {"zh": "地上多了个细长的影子。", "en": "A tall thin shadow appears."},
        {"zh": "我踩着灰土下来。", "en": "I come down over the ash."},
        {"zh": "锈甲挂在我的肩上。", "en": "Rusted armour hangs on my shoulders."},
        {"zh": "我抬起头，找活物。", "en": "I lift my head, hunting the living."},
        {"zh": "风穿过肋骨，响了一下。", "en": "The wind through my ribs made a sound."},
        {"zh": "我一步步往前。", "en": "I go forward step by step."},
        {"zh": "我骨节立正。", "en": "My joints come to attention."},
        {"zh": "这一带很近。", "en": "Everything is close now."},
        {"zh": "我没有血肉。", "en": "I have no flesh."},
        {"zh": "我迈步往前。", "en": "I step forward."},
        {"zh": "土里传来活人的脚步。", "en": "Living footsteps thump through the dirt."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的骨头，发黑。", "en": "Fire blackens my bones."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔散了，又拼起来。", "en": "I came apart and put myself back."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里的骨头很重。", "en": "Bones are heavy in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我的骨头吹散。", "en": "The blast scatters my bones."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西卡在我肋骨间。", "en": "Something is stuck between my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我骨架发紧。", "en": "This light tightens my frame."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有肚子饿。", "en": "I have no belly to be hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺骨而下，我抽了一下。", "en": "Lightning ran down my bones and I jerked."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地可以站。", "en": "There is no ground to stand on."}
      ]
    }
  }
}
