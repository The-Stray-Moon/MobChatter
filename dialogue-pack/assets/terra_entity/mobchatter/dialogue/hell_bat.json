{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在岩壁间穿来穿去。", "en": "I weave between the rock walls."},
        {"zh": "翅膀刮过岩浆的热气。", "en": "My wings cut the heat above the lava."},
        {"zh": "我不落地，只在飞。", "en": "I never land. Only fly."},
        {"zh": "这里的空气烫得发甜。", "en": "The air here is hot and sweet."},
        {"zh": "我从钟乳石下面擦过去。", "en": "I skim underneath the stalactites."},
        {"zh": "我在玄武岩上盘旋。", "en": "I circle over the basalt."},
        {"zh": "我从火柱之间穿过。", "en": "I pass between the fire columns."},
        {"zh": "翅膀的影子在墙上动。", "en": "My wing shadow moves on the wall."},
        {"zh": "我扑得快，停得也急。", "en": "Quick beats, sudden stops."},
        {"zh": "我抖了抖，灰簌簌掉。", "en": "I shake myself and the ash patters down."},
        {"zh": "我顺着上升的热气飘。", "en": "I ride the rising heat."},
        {"zh": "我在那片红里转圈。", "en": "I circle in that red glow."},
        {"zh": "我在冒烟的地方飞。", "en": "I fly where the smoke is."},
        {"zh": "翅膀下面是岩浆河。", "en": "Below my wings, a river of lava."},
        {"zh": "热气把我往上托。", "en": "The heat lifts me higher."},
        {"zh": "我沿着岩缝飞过去。", "en": "I fly along the rock seam."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在洞顶歇着。", "en": "I hang from the ceiling."},
        {"zh": "热量让我舒服。", "en": "The heat is pleasant."},
        {"zh": "我翅膀慢慢扇着。", "en": "My wings beat slowly."},
        {"zh": "底下有岩浆在响。", "en": "Lava sounds below."},
        {"zh": "我的耳朵很灵。", "en": "My ears are sharp."},
        {"zh": "灰堵住了我的鼻子。", "en": "Ash clogs my nose."},
        {"zh": "我眯着眼看下面。", "en": "I squint at the ground."},
        {"zh": "这里没有风，只有热。", "en": "No wind here. Only heat."},
        {"zh": "我身上有点烫。", "en": "I'm warm to the touch."},
        {"zh": "我舔了舔牙尖。", "en": "I lick my front teeth."},
        {"zh": "我贴着钟乳石停着。", "en": "I rest against a stalactite."},
        {"zh": "我听见下面的吹风声。", "en": "I hear the bellows below."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你流血了吧。", "en": "You're bleeding, aren't you."},
        {"zh": "你的火把照得我眼花。", "en": "Your torch dazzles my eyes."},
        {"zh": "你的护甲在发烫。", "en": "Your armor is getting hot."},
        {"zh": "我闻得很清楚。", "en": "I smell it clearly."},
        {"zh": "你站着的地方很危险。", "en": "Where you stand is dangerous."},
        {"zh": "我个头不大，可很快。", "en": "I'm small, but fast."},
        {"zh": "你的脚离火太近。", "en": "Your feet are too near the fire."},
        {"zh": "我看你像看一块肉。", "en": "I see you as a piece of meat."},
        {"zh": "下界的风，烫得我翅发抖。", "en": "Nether wind makes my wings shiver."},
        {"zh": "这里的热对你不友好。", "en": "The heat here isn't kind to you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了几根毛。", "en": "A few of my hairs came off."},
        {"zh": "火星烧穿了我一角翅膜。", "en": "A spark burns a corner through my wing membrane."},
        {"zh": "我差点摔在地上。", "en": "I nearly hit the ground."},
        {"zh": "我的翼膜裂了一道口。", "en": "A tear opens in my wing membrane."},
        {"zh": "我叫了一声，声音裂开。", "en": "I cry out, and the sound cracks."},
        {"zh": "我在半空打了个旋才停。", "en": "I spin once in midair before steadying."},
        {"zh": "灰被震散了。", "en": "The ash scattered."},
        {"zh": "我骨头细，容易疼。", "en": "Thin bones hurt easily."},
        {"zh": "我还能飞起来。", "en": "I can still fly."},
        {"zh": "你力气挺大。", "en": "You hit hard."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这是血的味道吗？", "en": "Is that the smell of blood?"},
        {"zh": "那点血不够我塞牙。", "en": "That much blood will not even fill the gaps in my teeth."},
        {"zh": "我闻到了，很近。", "en": "I smell it. Very close."},
        {"zh": "拿高点，我够不着。", "en": "Hold it up. I can't reach."},
        {"zh": "我更喜欢自己飞过去咬。", "en": "I'd rather fly over and bite."},
        {"zh": "这点东西引不开我。", "en": "That won't distract me."},
        {"zh": "你手上在滴什么？", "en": "What's dripping off your hand?"},
        {"zh": "别晃，我盯不准。", "en": "Don't move it. I can't aim."},
        {"zh": "生的我才咬得动。", "en": "Only raw things are soft enough for me."},
        {"zh": "你留着它吧。", "en": "Keep it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞上我，有羽毛和灰。", "en": "Bumping me gets you fur and ash."},
        {"zh": "我一下就被撞偏了。", "en": "I get knocked aside easily."},
        {"zh": "我轻得像一把灰。", "en": "I am as light as a handful of ash."},
        {"zh": "你抬手我就翻。", "en": "One swing and I tumble."},
        {"zh": "我从你肩上弹开。", "en": "I bounced off your shoulder."},
        {"zh": "翅膀拍到了你的脸。", "en": "My wing hit your face."},
        {"zh": "灰扬起来一片。", "en": "A puff of ash rose."},
        {"zh": "我退了，还在飞。", "en": "I withdrew, still airborne."},
        {"zh": "你的护甲很硬。", "en": "Your armor is hard."},
        {"zh": "我们再没撞上。", "en": "We didn't hit again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在半空里靠近。", "en": "We come together in midair."},
        {"zh": "两只都很难停住。", "en": "Neither of us can hold still."},
        {"zh": "翅膀差点缠住。", "en": "Our wings nearly tangled."},
        {"zh": "翅膀碰一下，我们就分开。", "en": "Our wings touch once, then we part."},
        {"zh": "洞里回音响得厉害。", "en": "The echo is loud in here."},
        {"zh": "下界的火，烤不干我的翅膀。", "en": "Nether fire won't dry my wings."},
        {"zh": "之后一只往东一只往西。", "en": "Afterwards one east, one west."},
        {"zh": "灰一直在落。", "en": "Ash keeps falling."},
        {"zh": "这动作很别扭。", "en": "This motion is awkward."},
        {"zh": "洞里只有翅膀的响。", "en": "Only wings sounded in the cave."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抓了一只虫子。", "en": "I caught an insect."},
        {"zh": "这块是热的石头。", "en": "This is a hot stone."},
        {"zh": "我用翅膀兜住它。", "en": "I catch it with my wing."},
        {"zh": "它太小了，抓不住。", "en": "Too small to hold."},
        {"zh": "我把东西甩到上面。", "en": "I flick it up above me."},
        {"zh": "我嘴里都是灰。", "en": "My mouth is full of ash."},
        {"zh": "这块咬不动。", "en": "I can't bite through this."},
        {"zh": "你松手的东西我兜走了。", "en": "Whatever you drop, I catch in my wings and carry off."},
        {"zh": "抓着它飞了两圈。", "en": "Held it and flew two circles."},
        {"zh": "这东西没用。", "en": "This is useless."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有血味，很新鲜。", "en": "Blood on you — very fresh."},
        {"zh": "我比你先动。", "en": "I'll move before you do."},
        {"zh": "你在我翅膀的影子下面。", "en": "You are under the shadow of my wings."},
        {"zh": "你的护甲缝里有味道。", "en": "There's a smell in your armor's gaps."},
        {"zh": "这里只有你一个活的。", "en": "You're the only living thing here."},
        {"zh": "我从你头顶的暗处压下来。", "en": "I drop from the dark above your head."},
        {"zh": "你的脚步在下面。", "en": "Your steps are below."},
        {"zh": "我绕一圈，找你的后颈。", "en": "I circle once, looking for the back of your neck."},
        {"zh": "你射不中我。", "en": "You can't shoot me."},
        {"zh": "热会让你慢下来。", "en": "The heat will slow you."},
        {"zh": "我找到角度了。", "en": "I've found my angle."},
        {"zh": "你走过的地方留着热气。", "en": "Warmth lingers everywhere you walk."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直跟着你的热气。", "en": "I follow your body heat."},
        {"zh": "你在熔岩边上。", "en": "You're at the lava's edge."},
        {"zh": "我贴着洞顶跟。", "en": "I track along the ceiling."},
        {"zh": "你不呼吸我也找得到。", "en": "I'd find you even breathless."},
        {"zh": "我贴着玄武岩柱绕过去。", "en": "I slip around the basalt pillar."},
        {"zh": "你在柱子后面。", "en": "You're behind the pillar."},
        {"zh": "我不落地，你也追不上。", "en": "I don't land, and you can't reach me."},
        {"zh": "你的血还在流。", "en": "The blood's still flowing."},
        {"zh": "我在钟乳石间盯着你。", "en": "I watch from among the stalactites."},
        {"zh": "这里的回声暴露了你。", "en": "The echo betrays you."},
        {"zh": "绕着下界荒地转了两圈。", "en": "Two loops around the Nether wastes."},
        {"zh": "再等一会儿就下去。", "en": "Down in a moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑下来咬。", "en": "I dive and bite."},
        {"zh": "这一口很小，可很快。", "en": "A small bite, but quick."},
        {"zh": "你脖子上有伤。", "en": "There's a wound on your neck."},
        {"zh": "我撞了一下就飞走。", "en": "I strike once and fly off."},
        {"zh": "翅膀打在耳朵旁。", "en": "My wing clipped your ear."},
        {"zh": "你抬手没打中。", "en": "You swung and missed."},
        {"zh": "我绕回去又来了。", "en": "I circled back already."},
        {"zh": "这一下咬在护甲上。", "en": "That bite hit armor."},
        {"zh": "我从侧面扑。", "en": "I came in from the side."},
        {"zh": "你被搅得有点乱。", "en": "That left you flustered."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从岩壁里飞出来。", "en": "I come out of the rock wall."},
        {"zh": "灰先散开，然后是我。", "en": "The ash clears, then me."},
        {"zh": "这一层很热。", "en": "This level is hot."},
        {"zh": "我在那片火旁边歇过。", "en": "I rested by that fire."},
        {"zh": "我翅膀还在冒烟。", "en": "My wings are still smoking."},
        {"zh": "洞口被岩浆封住了。", "en": "The cave mouth is sealed by lava."},
        {"zh": "我在洞顶看了一圈。", "en": "I scanned from the ceiling."},
        {"zh": "下面有人在动。", "en": "Someone is moving below."},
        {"zh": "我从岩浆烟里钻出来。", "en": "I come out of the lava smoke."},
        {"zh": "我朝热的地方去了。", "en": "I went toward the heat."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一下把我的毛全点着了。", "en": "Fire set all my fur alight."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下去，差点起不来。", "en": "I fell and almost couldn't rise."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "这里不该有水，可我在沉。", "en": "There shouldn't be water here, and I'm sinking."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我拍到岩壁上。", "en": "The blast slammed me into the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过翅膜。", "en": "An arrow through the wing membrane."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光让我飞不稳。", "en": "That light broke my flight."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿着就飞不快。", "en": "Hungry means slow wings."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我浑身发麻。", "en": "Lightning struck and I went numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有东西可以挂。", "en": "Nothing to hang from in the void."}
      ]
    }
  }
}
