{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扛着武器走在平原上", "en": "I tramp the plains with a weapon shouldered."},
        {"zh": "头盔太大，遮住一只眼", "en": "The helm's too big; it covers one eye."},
        {"zh": "我一边走一边骂", "en": "I curse as I walk."},
        {"zh": "靴子不合脚，走得歪", "en": "Boots don't fit; I walk crooked."},
        {"zh": "箭袋挂在腰后", "en": "My quiver hangs at my back."},
        {"zh": "平原的风吹乱我的耳朵", "en": "The wind ruffles my ears."},
        {"zh": "我踩平了一小片草", "en": "I flatten a patch of grass."},
        {"zh": "日头晃得我眼睛发花", "en": "The sun makes my eyes swim."},
        {"zh": "我走三步就回头看一眼", "en": "I look back every three steps."},
        {"zh": "这东西太重，懒得换", "en": "This thing's too heavy; not swapping."},
        {"zh": "一路走一路踢石子", "en": "I kick stones as I go."},
        {"zh": "我个子不高，步子不小", "en": "Short but with long strides."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着也在生气", "en": "I'm angry even standing still."},
        {"zh": "二百二十点血肉，够打一阵", "en": "Two hundred and twenty points; a long fight."},
        {"zh": "我把武器在手里转了转", "en": "I twirl the weapon in my hand."},
        {"zh": "平原上没什么好抢的", "en": "Nothing worth looting on these plains."},
        {"zh": "我拉了拉弓弦", "en": "I test the bowstring."},
        {"zh": "我耳朵听见很远的脚步", "en": "My ears catch footsteps far away."},
        {"zh": "我在等一个能打的", "en": "I'm waiting for someone worth fighting."},
        {"zh": "安静得我耳朵里发痒", "en": "So quiet my ears itch."},
        {"zh": "我往草丛里啐了一口", "en": "I spit into the grass."},
        {"zh": "我数着还能骂几句", "en": "Counting how many more curses I have."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在看什么看", "en": "What are you looking at?"},
        {"zh": "你比我高，我可不怕", "en": "You're taller, but I'm not scared."},
        {"zh": "你的东西我要了", "en": "Your things? Mine."},
        {"zh": "我一只手也能拿弓", "en": "I can handle a bow one-handed."},
        {"zh": "你站着不动，傻吗", "en": "Standing there like a fool?"},
        {"zh": "平原归我，你滚开", "en": "These plains are mine; get lost."},
        {"zh": "我记住你的脸", "en": "I've got your face memorized."},
        {"zh": "别拿那种眼神瞧我", "en": "Don't give me that look."},
        {"zh": "你那把武器看着不错", "en": "That weapon looks decent."},
        {"zh": "等我决定先砍还是先射", "en": "Let me decide: cut or shoot."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中我了，很好", "en": "You hit me; good."},
        {"zh": "我骂了一句，更凶了", "en": "I cursed and got meaner."},
        {"zh": "头盔被打歪了", "en": "My helm got knocked askew."},
        {"zh": "这点伤我扛得住", "en": "I can take this."},
        {"zh": "二百二十点，够你慢慢打", "en": "Two hundred twenty points; keep hitting."},
        {"zh": "我退半步重新举起弓", "en": "I step back and raise the bow."},
        {"zh": "耳朵被打得发红", "en": "My ears are red from the hit."},
        {"zh": "这笔账我刻在盔沿上", "en": "I notch that debt into my helm's rim."},
        {"zh": "你别以为这样就赢了", "en": "Don't think you've won."},
        {"zh": "胳膊没断，接着来", "en": "My arm's not broken; come again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "吃的？给我拿来", "en": "Food? Hand it over."},
        {"zh": "举着它，想让我少砍几下", "en": "Holding it up to save yourself a few cuts?"},
        {"zh": "我不挑，什么都能吃", "en": "I'm not picky; I eat anything."},
        {"zh": "放下它，然后滚", "en": "Drop it, then get lost."},
        {"zh": "一块面包就想打发我？", "en": "A loaf of bread is meant to buy me off?"},
        {"zh": "胡萝卜？我最讨厌这个", "en": "Carrots? My least favorite."},
        {"zh": "你敢跑的话我就射", "en": "Run, and I shoot."},
        {"zh": "我从来不谢别人", "en": "I don't thank people."},
        {"zh": "扔过来，别递给我", "en": "Toss it, don't hand it."},
        {"zh": "吃完再决定杀不杀你", "en": "I'll decide after eating."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我？你找死", "en": "You bumped me? You're dead."},
        {"zh": "我这身板非常结实", "en": "This body is sturdy."},
        {"zh": "你退了两步，我一步没动", "en": "You slid back; I didn't budge."},
        {"zh": "头盔撞在你的肋骨上", "en": "My helm hit your ribs."},
        {"zh": "别贴着我，我脾气差", "en": "Don't crowd me; my temper's bad."},
        {"zh": "这点碰撞我天天遇到", "en": "I get bumped every day."},
        {"zh": "撞上我算你倒霉", "en": "Running into me is your bad luck."},
        {"zh": "我用手肘把你顶开", "en": "I elbow you aside."},
        {"zh": "再撞我一下试试", "en": "Bump me again, I dare you."},
        {"zh": "你比我壮，我比你狠", "en": "You're stronger, but I'm meaner."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我连自己都照顾不过来", "en": "I can't even look after myself."},
        {"zh": "哥布林不谈这种事", "en": "Goblins don't discuss this."},
        {"zh": "先抢够了东西再说", "en": "Loot enough first."},
        {"zh": "我这脾气，没人受得住", "en": "With this temper, no one lasts."},
        {"zh": "你找错种族了", "en": "Wrong species."},
        {"zh": "我的窝里只放战利品", "en": "My den holds only loot."},
        {"zh": "再往前一步我就砍你", "en": "One more step and I swing."},
        {"zh": "我还有账没算完", "en": "I've got scores to settle."},
        {"zh": "这种事等打完这仗再说", "en": "Ask me after this fight."},
        {"zh": "走远点，别来烦我", "en": "Get clear and leave me alone."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有东西，归我", "en": "Something on the ground; mine."},
        {"zh": "我一弯腰，头盔掉了", "en": "I bent and my helm fell off."},
        {"zh": "这块铁能卖钱", "en": "This iron could sell."},
        {"zh": "我把它揣进怀里", "en": "I stuff it in my coat."},
        {"zh": "别抢，是我先看到的", "en": "Don't grab; I saw it first."},
        {"zh": "腐肉也收，有用处", "en": "Rotten flesh too; it's useful."},
        {"zh": "我用脚把它勾起来", "en": "I hook it up with a foot."},
        {"zh": "这点东西塞进口袋", "en": "This goes in the pocket."},
        {"zh": "地上掉的就是没主的", "en": "Dropped means unowned."},
        {"zh": "我捡完接着往前走", "en": "Picked up; moving on."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "总算有点事干了", "en": "Finally something to do."},
        {"zh": "先射一箭试试看", "en": "Let's try an arrow first."},
        {"zh": "我的弓已经拉满", "en": "My bow is at full draw."},
        {"zh": "你比我高，正好当靶子", "en": "You're taller—perfect target."},
        {"zh": "我把武器换到右手", "en": "I switch the weapon to my right hand."},
        {"zh": "平原上没有遮挡，你完了", "en": "No cover on the plains; you're done."},
        {"zh": "我从来不讲规矩", "en": "I don't play fair."},
        {"zh": "十五点一下，够你疼", "en": "Fifteen a hit hurts enough."},
        {"zh": "我耳朵听见你在喘", "en": "My ears hear you panting."},
        {"zh": "你退一步我就追", "en": "You retreat; I follow."},
        {"zh": "我要你身上的装备", "en": "I want your gear."},
        {"zh": "别指望我停下手", "en": "Don't expect me to stop."},
        {"zh": "这一带的规矩由我定", "en": "I make the rules here."},
        {"zh": "先砍腿，再砍你的头", "en": "Legs first, then the head."},
        {"zh": "你还剩下几口气", "en": "How many breaths left?"},
        {"zh": "箭头已经对准你的喉咙", "en": "My arrowhead is already on your throat."},
        {"zh": "别跑，跑起来更慢", "en": "Don't run; it's slower."},
        {"zh": "我笑的时候最危险", "en": "I'm most dangerous when I grin."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我从你左边的草丛钻出去", "en": "I slip out of the grass on your left."},
        {"zh": "我边走边把箭搭上", "en": "I nock an arrow as I circle."},
        {"zh": "你挡得住箭，挡不住我冲", "en": "Block the arrow, but not my charge."},
        {"zh": "我个子小，你的剑砍不着", "en": "I'm short; your blade swings over."},
        {"zh": "我贴到你的膝盖边", "en": "I get in at your knees."},
        {"zh": "你退进草丛里也没用", "en": "Hiding in the grass won't help."},
        {"zh": "我专射你的脚", "en": "I shoot at your feet."},
        {"zh": "你不追我，我就继续射", "en": "Don't chase, and I keep shooting."},
        {"zh": "你一追，我就跑开", "en": "Chase, and I run."},
        {"zh": "这样打我最舒服", "en": "This is how I like it."},
        {"zh": "我的箭不多了，但够用", "en": "Few arrows left, but enough."},
        {"zh": "你转身实在太慢", "en": "You turn slowly."},
        {"zh": "我绕三圈你就晕了", "en": "Three circles and you're dizzy."},
        {"zh": "你护甲下面有缝", "en": "There are gaps under your armor."},
        {"zh": "我瞄的就是那道缝", "en": "I'm aiming at that gap."},
        {"zh": "风不大，箭不会偏", "en": "Little wind; the arrow flies true."},
        {"zh": "你听见弓弦的响声了吗", "en": "Hear the bowstring?"},
        {"zh": "那是我在逗你玩", "en": "That was me playing with you."},
        {"zh": "下一箭可是真的", "en": "The next one's real."},
        {"zh": "别回头，后面没人", "en": "Don't look back; no one's there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一刀砍在你的膝盖上", "en": "A slash at your knee."},
        {"zh": "一箭射在你的护甲上", "en": "An arrow clangs off your armor."},
        {"zh": "我跳起来砍你的腰", "en": "I leap and slash at your waist."},
        {"zh": "头盔撞向你的肚子", "en": "My helm rams your belly."},
        {"zh": "先试试你的盾有多厚", "en": "Just testing how thick that shield is."},
        {"zh": "你挡住了，我换个角度", "en": "You blocked; I change angles."},
        {"zh": "我从下面往上砍", "en": "I cut upward from below."},
        {"zh": "我把弓当棍子砸", "en": "The bow swings like a club."},
        {"zh": "十五点一下，别嫌少", "en": "Fifteen a hit; don't complain."},
        {"zh": "我砍不准，但砍得很用力", "en": "My aim's poor, my force isn't."},
        {"zh": "你退我就追着砍你", "en": "You back off; I chop after you."},
        {"zh": "一箭，一刀，再来一箭", "en": "Arrow, blade, another arrow."},
        {"zh": "我边骂边砍更有劲", "en": "Cursing makes me swing harder."},
        {"zh": "你的膝盖在打颤", "en": "Your knees are knocking."},
        {"zh": "我踩在你的脚背上", "en": "I stand on your foot."},
        {"zh": "这一下冲你的脸来", "en": "This one's for your face."},
        {"zh": "你退了，我占了上风", "en": "You stepped back; I have the edge."},
        {"zh": "再来，我还没打够", "en": "Again; I'm not done."},
        {"zh": "我把弓背到身后", "en": "I sling the bow behind me."},
        {"zh": "我收刀喘一口气", "en": "Blade down; catching my breath."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从草丛里拱出来", "en": "I shove out of the grass."},
        {"zh": "头盔先露了出来", "en": "The helm comes up first."},
        {"zh": "平原上多了一个麻烦", "en": "One more nuisance on the plains."},
        {"zh": "我踩着草骂了一句", "en": "I tramp the grass and curse."},
        {"zh": "弓还没有上弦", "en": "The bow's not strung yet."},
        {"zh": "我的耳朵先动了", "en": "My ears move first."},
        {"zh": "地上被我踢出一个坑", "en": "I kicked a dent in the ground."},
        {"zh": "没人请我，我自己来的", "en": "No one invited me; I came anyway."},
        {"zh": "这片平原我转了大半辈子", "en": "I've roamed these plains half my life."},
        {"zh": "听见我的脚步就快躲", "en": "Hear my steps and you had better hide."},
        {"zh": "我扛着东西走了过来的", "en": "I walked over carrying this."},
        {"zh": "又要打上一架了", "en": "Another fight, then."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "身上着火，我满地打滚", "en": "I'm on fire and rolling."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下来，头盔磕了石头", "en": "I fell and my helm hit stone."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进了我的头盔", "en": "Water flooded my helm."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我炸得滚了半圈", "en": "The blast rolled me half a turn."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "你用箭射我？我也会", "en": "You shoot arrows? So do I."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这玩意儿一点都不讲道理", "en": "This stuff plays dirty."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得砍不动了", "en": "Too hungry to swing."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈下来，我的毛全立起来", "en": "Lightning struck; my hair stood up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没地了，我还在骂", "en": "No ground, and I'm still cursing."}
      ]
    }
  }
}
