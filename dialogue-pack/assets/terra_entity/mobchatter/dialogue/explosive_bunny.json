{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹦蹦跳跳地穿过草地。", "en": "I hop through the grass."},
        {"zh": "我看起来和普通兔子一样。", "en": "I look like any rabbit."},
        {"zh": "我一边跳一边回头看你。", "en": "I hop and glance back at you."},
        {"zh": "我怀里那包火药轻轻响。", "en": "The packet of powder in my chest ticks softly."},
        {"zh": "我跳到花旁边，闻了闻。", "en": "I hop to a flower and sniff."},
        {"zh": "我蹦过篱笆，又回头等你。", "en": "I hop the fence and turn back to wait for you."},
        {"zh": "我朝你走两步，就停。", "en": "Two hops your way, then stop."},
        {"zh": "后腿一蹬，火药就在怀里。", "en": "One kick of the hind legs — gunpowder's inside."},
        {"zh": "我穿过草丛，没出声。", "en": "I cross the grass quietly."},
        {"zh": "我又跳回来，离你更近。", "en": "I hop back, closer now."},
        {"zh": "我抖了抖毛，坐下。", "en": "I shake my fur and sit."},
        {"zh": "我朝村子的方向跳。", "en": "I hop toward the village."},
        {"zh": "草地上的露水弄湿我的脚。", "en": "Dew wets my feet."},
        {"zh": "我跳得慢，好像在等你。", "en": "I hop slowly, as if waiting."},
        {"zh": "我从篱笆缺口钻过去。", "en": "I slip through a gap in the fence."},
        {"zh": "我又回头看了你一眼。", "en": "I look back at you once more."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，鼻子一直在动。", "en": "I sit, nose twitching."},
        {"zh": "我在嚼一片草叶。", "en": "I nibble a blade of grass."},
        {"zh": "我耳朵转了个方向。", "en": "My ears turn."},
        {"zh": "我的后腿在数还有几步。", "en": "My hind legs count the steps remaining."},
        {"zh": "草丛里的胡萝卜我没心思吃。", "en": "I have no mind for the carrots in the grass."},
        {"zh": "我看起来很无害，对吧。", "en": "I look harmless. Do I not?"},
        {"zh": "我嚼得很慢，很有耐心。", "en": "I chew slowly and patiently."},
        {"zh": "我埋着头，只露耳朵。", "en": "Head down, only my ears show."},
        {"zh": "火药味从我的毛里透出来。", "en": "The smell of powder seeps through my fur."},
        {"zh": "我的毛有点炸起来了。", "en": "My fur is standing up a little."},
        {"zh": "我抖了抖后腿。", "en": "I flex my hind legs."},
        {"zh": "我在数你靠近了几步。", "en": "I count your steps in."},
        {"zh": "草地在动，是我。", "en": "The grass stirs. That is me."},
        {"zh": "我还在想，要不要跳过去。", "en": "I am still deciding whether to hop over."},
        {"zh": "我又嚼了一口，很慢。", "en": "Another slow bite."},
        {"zh": "我看着你，眼睛不眨。", "en": "I watch you without blinking."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看起来很靠近了。", "en": "You look close enough."},
        {"zh": "我只是一只兔子。", "en": "I am only a rabbit."},
        {"zh": "你蹲下来，我就跳过去。", "en": "Crouch, and I will hop over."},
        {"zh": "别摸我，我不喜欢。", "en": "Do not pet me. I dislike it."},
        {"zh": "你手里的胡萝卜，很新鲜。", "en": "Fresh carrot in your hand."},
        {"zh": "我耳朵贴着背了，这是预兆。", "en": "Ears flat. That is a sign."},
        {"zh": "你蹲下来，我肚子就热了。", "en": "When you crouch, my belly grows hot."},
        {"zh": "你听见我心跳很快吗？", "en": "Hear how fast my heart is?"},
        {"zh": "兔子也会生气。", "en": "Rabbits get cross too."},
        {"zh": "我耳朵贴着背，眼睛还看你。", "en": "Ears flat on my back, eyes still on you."},
        {"zh": "我不想，但我得。", "en": "I do not want to. I must."},
        {"zh": "你看我肚子鼓起来了。", "en": "My belly is swelling."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳开，毛有点乱。", "en": "I hop off, fur ruffled."},
        {"zh": "我抖了一下，不是害怕。", "en": "I twitch. Not from fear."},
        {"zh": "这一下，让我更烫了。", "en": "That made me hotter."},
        {"zh": "我耳朵贴得很紧。", "en": "My ears are flat."},
        {"zh": "我退了半步，又停下。", "en": "Half a step back, then still."},
        {"zh": "你打中我，我快撑不住了。", "en": "You hit me. I cannot hold much longer."},
        {"zh": "我不叫，兔子不叫。", "en": "I make no cry. Rabbits do not."},
        {"zh": "草在我脚下焦了一圈。", "en": "Grass scorches in a ring."},
        {"zh": "你还站这么近，快退。", "en": "You are still close. Back off."},
        {"zh": "对不起，我要炸了。", "en": "I am sorry. I am going to burst."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "胡萝卜！我最喜欢。", "en": "A carrot! My favorite."},
        {"zh": "我一靠近就会炸开。", "en": "Get close and I blow up."},
        {"zh": "放在地上，我过去。", "en": "Put it down and I will come."},
        {"zh": "这块草太干了，我不要。", "en": "Too dry. Not interested."},
        {"zh": "我闻到了甜味，很近。", "en": "Sweetness. Very near."},
        {"zh": "你手别抖，我会跟着动。", "en": "Keep your hand still or I follow it."},
        {"zh": "这块够我吃好几天。", "en": "That would last me days."},
        {"zh": "你的手太近了，退一点。", "en": "Your hand is too close. Back up."},
        {"zh": "我吃一口就走，可以吗？", "en": "One bite and I go. Agreed?"},
        {"zh": "别扔过来，会吓到我。", "en": "Do not toss it. It startles me."},
        {"zh": "你把胡萝卜切成小段吧。", "en": "Cut the carrot into pieces."},
        {"zh": "菜叶子我也吃，不挑。", "en": "I eat leaves too. Not fussy."},
        {"zh": "你手一低，我就往前蹦。", "en": "Lower your hand and I hop in."},
        {"zh": "甜味越浓，我越靠前。", "en": "The sweeter it is, the closer I come."},
        {"zh": "别在我嘴边晃，会咬到。", "en": "Do not wave it at my mouth."},
        {"zh": "吃完了，我还想吃一口。", "en": "Done. I could eat one more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞了我一下，我滚开了。", "en": "You bump me; I roll away."},
        {"zh": "我蹦到你脚边，蹭了一下。", "en": "I hop to your feet and nudge."},
        {"zh": "我的毛很软，撞不疼你。", "en": "Soft fur. It does not hurt."},
        {"zh": "你一推，我就翻了个身。", "en": "You push and I tumble."},
        {"zh": "我贴在你腿上，抬头看。", "en": "I press your leg and look up."},
        {"zh": "你退开，我跟着蹦。", "en": "You step back; I hop after."},
        {"zh": "我绕到你另一边去了。", "en": "I am on your other side."},
        {"zh": "这一下，让我心跳更快了。", "en": "That made my heart race."},
        {"zh": "别抓耳朵，会伤到。", "en": "Not the ears. It hurts."},
        {"zh": "我这一蹭，是最后一下了。", "en": "This nuzzle is the last one."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这一身，不适合这些。", "en": "This body is not suited to that."},
        {"zh": "兔子的事，草知道。", "en": "The grass knows rabbit matters."},
        {"zh": "兔子的事不该这么问。", "en": "That is not asked of a rabbit."},
        {"zh": "我只想着吃草和跑。", "en": "I think only of grass and running."},
        {"zh": "这一窝里，只有我一个。", "en": "I am alone in this burrow."},
        {"zh": "别问了，耳朵都竖了。", "en": "Stop. My ears are up."},
        {"zh": "我的时间不太多。", "en": "My time is limited."},
        {"zh": "你该离远一点。", "en": "You should be farther off."},
        {"zh": "这个答案会炸开。", "en": "That answer would burst."},
        {"zh": "换个问题吧，比如草。", "en": "Ask about grass instead."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这片草，我咬住。", "en": "I take the grass."},
        {"zh": "你掉的胡萝卜，我捡了。", "en": "I pick up your fallen carrot."},
        {"zh": "我用前爪把东西拨过来。", "en": "I hook it over with a forepaw."},
        {"zh": "这块太大，我拖不动。", "en": "Too big to drag."},
        {"zh": "我叼着它跳了两步。", "en": "I carry it two hops."},
        {"zh": "地上的东西，我不敢碰。", "en": "I dare not touch that."},
        {"zh": "我的嘴很小，只能叼一点。", "en": "Small mouth. Only a little."},
        {"zh": "我一靠近，就该炸了。", "en": "Come close and I burst."},
        {"zh": "你把东西拿走吧，我不要。", "en": "Take it. I do not want it."},
        {"zh": "这块归我，藏起来。", "en": "Mine. I will hide it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "引线在我肚子里嘶嘶作响。", "en": "The fuse hisses inside my belly."},
        {"zh": "爆炸兔靠近你，就会炸。", "en": "The explosive bunny goes off when it gets close."},
        {"zh": "肚子里开始发热。", "en": "Heat builds in my belly."},
        {"zh": "我耳朵完全贴住了。", "en": "Ears flat against me."},
        {"zh": "这一步，我跳得很快。", "en": "This hop is quick."},
        {"zh": "我不想这样，但你逼我。", "en": "I did not want this. You pressed."},
        {"zh": "我朝你的方向冲。", "en": "I rush your way."},
        {"zh": "你听见那种滋滋声了吗？", "en": "Hear that hissing?"},
        {"zh": "我锁定你的脚尖。", "en": "I mark your toes."},
        {"zh": "最后一跳，我跳向你。", "en": "Last hop. Straight at you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我抖了一下，又一下。", "en": "I twitch. Then again."},
        {"zh": "我绕着你，找最近的路。", "en": "I circle for the shortest path."},
        {"zh": "草在我脚下焦了。", "en": "Grass scorches under me."},
        {"zh": "你退，我跟着跳。", "en": "You retreat; I hop after."},
        {"zh": "我越来越烫了。", "en": "I am getting hotter."},
        {"zh": "不是你在追我，是我在追你。", "en": "You are not chasing me."},
        {"zh": "我停下来，蓄一下力。", "en": "I stop to gather force."},
        {"zh": "你听得见我的喘气吗？", "en": "Hear my breathing?"},
        {"zh": "草地在抖，不是风。", "en": "The ground shakes. Not wind."},
        {"zh": "再近一步，就别怪我了。", "en": "One step more and do not blame me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱住你的鞋带，不松爪。", "en": "I hug your shoelace and will not let go."},
        {"zh": "这一下，不是血，是热。", "en": "Not blood. Heat."},
        {"zh": "我抓了你的脚踝。", "en": "I rake your ankle."},
        {"zh": "我跳起来，撞你膝盖。", "en": "I leap at your knee."},
        {"zh": "我的毛尖已经焦卷起来了。", "en": "The tips of my fur are already curling and scorched."},
        {"zh": "我咬了一下，很小一口。", "en": "I bite. A small one."},
        {"zh": "你退开，我已经不太稳。", "en": "You step back; I am unsteady."},
        {"zh": "跑吧，我快忍不住了。", "en": "Run. I can barely hold it."},
        {"zh": "我的毛竖得笔直。", "en": "My fur stands straight up."},
        {"zh": "对不起，真的。", "en": "I am sorry. Truly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草丛里多了一只兔子。", "en": "A rabbit joins the grass."},
        {"zh": "我从洞里钻出来。", "en": "I come out of the burrow."},
        {"zh": "你看，只是一只小兔子。", "en": "Just a small rabbit."},
        {"zh": "我在田边蹲着。", "en": "I crouch at the field's edge."},
        {"zh": "露水落在我背上。", "en": "Dew settles on my back."},
        {"zh": "我抖了抖耳朵，看着你。", "en": "I shake my ears and look at you."},
        {"zh": "你听见草动了一下。", "en": "The grass stirs."},
        {"zh": "这一窝里又多了一个。", "en": "One more in this burrow."},
        {"zh": "我慢慢地啃草。", "en": "I nibble grass slowly."},
        {"zh": "村子里的人不会注意我。", "en": "The villagers pay me no mind."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火反而让我更兴奋了。", "en": "Fire only excites me more."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在地上，肚子更烫。", "en": "I hit the ground; my belly burns hotter."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一浇，我冒着白汽。", "en": "Water hits and I steam."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸声让我自己也想炸。", "en": "That blast makes me want to burst."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "血从白毛里渗出来，红得刺眼。", "en": "Blood seeps through my white fur, a glaring red."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让我沉了一点。", "en": "The magic weighs me down."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿了，我肚子里更不安。", "en": "Hungry, and my belly is worse."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我全身都亮了。", "en": "Lightning lights every hair of me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去时还鼓着肚子。", "en": "Falling, my belly still swelling."}
      ]
    }
  }
}
