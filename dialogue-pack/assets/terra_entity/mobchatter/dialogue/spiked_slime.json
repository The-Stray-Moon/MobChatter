{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跳一跳地挪过去。", "en": "I move in little hops."},
        {"zh": "落地时整个身体都扁了。", "en": "I flatten on every landing."},
        {"zh": "我身上的刺跟着抖。", "en": "The spikes on me shiver."},
        {"zh": "泥地被我一压一个坑。", "en": "Each landing leaves a dent."},
        {"zh": "我跳得慢，可一直跳。", "en": "Slow hops, endless ones."},
        {"zh": "刺扎在草里，拔出来响。", "en": "My spikes pull free of the grass."},
        {"zh": "我的刺在背上排成一圈。", "en": "Spikes ring my back."},
        {"zh": "我一次能跳两格远。", "en": "I can clear two blocks."},
        {"zh": "里面有个核在晃。", "en": "A core wobbles inside me."},
        {"zh": "我一弹一弹，越过矮墙。", "en": "Bounce by bounce, I clear the low wall."},
        {"zh": "一下一下，很有节奏。", "en": "Hop, hop. A steady rhythm."},
        {"zh": "我落地时溅起一点胶。", "en": "A little gel splashes where I land."},
        {"zh": "我用下压的力气跳。", "en": "I bounce by squeezing down."},
        {"zh": "我的影子一胀一缩。", "en": "My shadow swells and shrinks."},
        {"zh": "刺尖刮过地面，一路带响。", "en": "My spikes scrape the ground, noisy all the way."},
        {"zh": "刺尖朝外，谁碰谁疼。", "en": "Spikes out. Touch me and it stings."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在地上，慢慢鼓。", "en": "I sit and slowly swell."},
        {"zh": "我的刺不是装饰。", "en": "My spikes are not decoration."},
        {"zh": "太阳把我晒得发软。", "en": "The sun softens me."},
        {"zh": "等有人经过，我就弹起来。", "en": "When someone passes, I'll spring."},
        {"zh": "我身上沾了草屑。", "en": "Grass clings to me."},
        {"zh": "里面的核在转。", "en": "The core turns inside me."},
        {"zh": "空气对我不必要。", "en": "Air is not required for me."},
        {"zh": "四下里静得慌。", "en": "It is very still around here."},
        {"zh": "我压扁又鼓起来。", "en": "I flatten and swell again."},
        {"zh": "我的身体在微微颤。", "en": "I tremble faintly."},
        {"zh": "黏液表面起了波纹，你在附近。", "en": "Ripples cross my slime; you are near."},
        {"zh": "我等着下一次跳。", "en": "I wait for the next hop."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我的跳程内。", "en": "You stand within my hop."},
        {"zh": "我朝你这边偏了偏。", "en": "I lean your way."},
        {"zh": "我没有脸，不用看我的表情。", "en": "I have no face to read."},
        {"zh": "你一碰我就知道。", "en": "You touch me and you will know."},
        {"zh": "我鼓了一点。", "en": "I swell a little."},
        {"zh": "我鼓起身子，刺尖对着你。", "en": "I swell up, spike tips aimed at you."},
        {"zh": "我在数你的步伐。", "en": "I count your steps."},
        {"zh": "这点距离我一跳就到。", "en": "One hop covers that."},
        {"zh": "你看起来很硬。", "en": "You look hard."},
        {"zh": "软的东西撞着更疼。", "en": "Soft things strike harder."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我瘪了一下。", "en": "I deflate a little."},
        {"zh": "被打得乱弹，我还在蹦。", "en": "Knocked bouncing, I keep hopping."},
        {"zh": "一根尖刺断了，黏液往外冒。", "en": "A spike snaps off and slime oozes out."},
        {"zh": "我在地上摊开。", "en": "I spread out on the ground."},
        {"zh": "我又凝起来。", "en": "I gather myself again."},
        {"zh": "里面那个核在抖。", "en": "The core inside is shaking."},
        {"zh": "这点伤没什么。", "en": "This is nothing."},
        {"zh": "我跳得歪了。", "en": "My hop went crooked."},
        {"zh": "那一记很疼。", "en": "That one hurt."},
        {"zh": "我还能再撞。", "en": "I can hit again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "甜味飘过来，我的刺都立起。", "en": "A sweet scent drifts over and all my spikes rise."},
        {"zh": "我不用吃饭。", "en": "I do not need meals."},
        {"zh": "你放地上，我跳过去。", "en": "Put it down and I will hop to it."},
        {"zh": "这东西我不用。", "en": "I have no use for that."},
        {"zh": "我只想撞东西。", "en": "I only want to hit something."},
        {"zh": "你手上的东西太干净了。", "en": "What you hold is too clean."},
        {"zh": "我一跳一跳凑过去。", "en": "I hop over, one bounce at a time."},
        {"zh": "这不是吃的东西。", "en": "That is not food."},
        {"zh": "我跳了一下，算了。", "en": "One hop. Never mind."},
        {"zh": "你把它弄走吧。", "en": "Take it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一撞你，刺先到。", "en": "I hit you, and the spikes arrive first."},
        {"zh": "我整个身体压上去了。", "en": "My whole body comes down."},
        {"zh": "你被我撞得退开。", "en": "My hit knocks you back."},
        {"zh": "我在地上摊开又聚起来。", "en": "I spread out and gather again."},
        {"zh": "我身上的刺，比果冻硬。", "en": "My spikes are harder than my gel."},
        {"zh": "我撞完就跳开。", "en": "I hit and bounce off."},
        {"zh": "我的刺卡在你护甲上。", "en": "My spikes catch your plate."},
        {"zh": "这一下我晃得很厉害。", "en": "I wobble badly from that."},
        {"zh": "我们两个都退开。", "en": "We both give way."},
        {"zh": "你别正面撞我。", "en": "Do not hit me head on."},
        {"zh": "我又弹回来了。", "en": "I bounce back in."},
        {"zh": "这是我唯一的方式。", "en": "This is all I know how to do."},
        {"zh": "黏液沾到你身上。", "en": "Gel smears on you."},
        {"zh": "我停了一会儿才稳住。", "en": "I take a moment to settle."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上没有那些。", "en": "I have none of that."},
        {"zh": "我是个胶团。", "en": "I am a lump of gel."},
        {"zh": "你别再问了。", "en": "Do not ask."},
        {"zh": "我颤了一下。", "en": "I quiver once."},
        {"zh": "我慢慢弹到一边。", "en": "I bounce slowly aside."},
        {"zh": "那不是我该琢磨的。", "en": "Not for me to consider."},
        {"zh": "我只想找块湿地待着。", "en": "I just want a damp patch to rest on."},
        {"zh": "我压扁自己。", "en": "I flatten myself."},
        {"zh": "我一跳就走。", "en": "One hop and I am off."},
        {"zh": "我没这打算。", "en": "I have no such intention."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "尖刺一收，东西就进去了。", "en": "The spikes close, and it's swallowed up."},
        {"zh": "太硬了，进不去。", "en": "Too hard to take in."},
        {"zh": "我把它压住了。", "en": "I have it pinned."},
        {"zh": "我把它吐回去。", "en": "I spit it back out."},
        {"zh": "这东西不是胶。", "en": "This is not gel."},
        {"zh": "我把它拱到一旁。", "en": "I shove it to one side."},
        {"zh": "我跳过去又跳回来。", "en": "I hop over and back."},
        {"zh": "这毫无意义。", "en": "That means nothing."},
        {"zh": "我把它裹住了。", "en": "I have it enclosed."},
        {"zh": "我裹不进去。", "en": "I cannot wrap it in."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你跳过去了。", "en": "I am hopping at you."},
        {"zh": "你站在我落点上。", "en": "You are on my landing spot."},
        {"zh": "我的刺全竖着。", "en": "My spikes are all out."},
        {"zh": "你被撞到就疼。", "en": "Contact means pain."},
        {"zh": "我又鼓了一圈。", "en": "I swell another ring."},
        {"zh": "这次我算准了。", "en": "I have the distance."},
        {"zh": "别用身体挡。", "en": "Do not block with your body."},
        {"zh": "我的核心在抖。", "en": "My core is quivering."},
        {"zh": "我正在过来了。", "en": "I am coming over now."},
        {"zh": "逃也是白费的。", "en": "Fleeing is wasted effort."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "再跳近些，刺才够得着你。", "en": "One more hop and my spikes can reach you."},
        {"zh": "你躲到石头后面去了。", "en": "You have gone behind the stone."},
        {"zh": "我落地的地方有胶。", "en": "Gel marks my landings."},
        {"zh": "我一下一下逼近。", "en": "Hop by hop, I close in."},
        {"zh": "我全身是刺，你身上一根没有。", "en": "I am all spikes; you have none."},
        {"zh": "我从侧面撞。", "en": "I come at your side."},
        {"zh": "我跳起时，影子盖住你脚背。", "en": "When I leap, my shadow covers your feet."},
        {"zh": "你不动，我好瞄准。", "en": "Stay still and I can aim."},
        {"zh": "再跳一次就到。", "en": "One more hop."},
        {"zh": "这一次不会偏。", "en": "This one will not miss."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个身子砸过去。", "en": "My whole body slams into you."},
        {"zh": "刺刮过你的护腿。", "en": "Spikes scrape your greaves."},
        {"zh": "你被弹了一下。", "en": "You are jolted back."},
        {"zh": "我把整个身体压上。", "en": "I press my full body down."},
        {"zh": "这一下带着胶。", "en": "That came with gel."},
        {"zh": "我撞完自己也在抖。", "en": "The impact leaves me wobbling."},
        {"zh": "你的护甲上有凹痕。", "en": "A dent in your armor."},
        {"zh": "我弹了开去。", "en": "I bounce away."},
        {"zh": "这样够疼吗？", "en": "Does that hurt enough?"},
        {"zh": "再来一次，跳过去。", "en": "Once more. Hopping over."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "啪的一声，我落在这儿。", "en": "A wet slap, and I am here."},
        {"zh": "我在原地鼓了鼓。", "en": "I swell where I landed."},
        {"zh": "这一带没什么可撞的。", "en": "Little to hit here."},
        {"zh": "我的刺扎进土里。", "en": "My spikes dig into the soil."},
        {"zh": "我从一堆胶里起来。", "en": "I rise out of a heap of gel."},
        {"zh": "空气干得很。", "en": "The air is very dry."},
        {"zh": "我落地压扁，刺扎进土里。", "en": "I land flat, spikes stabbing the soil."},
        {"zh": "那边有人影。", "en": "A figure over there."},
        {"zh": "黏液摊开一圈，刺慢慢竖起。", "en": "My slime spreads in a ring; spikes rise slowly."},
        {"zh": "从我身上滴下来的东西很黏。", "en": "What drips from me is sticky."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我的胶就缩了。", "en": "Heat shrinks my gel."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下时摔得更扁。", "en": "I land flatter than usual."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我被冲散了。", "en": "Water thins me out."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀得四分五裂。", "en": "The blast scatters me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿进我的身体里。", "en": "It goes through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我的核发紧。", "en": "That light clenches my core."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我在慢慢变小。", "en": "I am shrinking."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我全身打颤。", "en": "Lightning strikes; I quiver all over."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有能落的地方。", "en": "Nothing here to land on."}
      ]
    }
  }
}
