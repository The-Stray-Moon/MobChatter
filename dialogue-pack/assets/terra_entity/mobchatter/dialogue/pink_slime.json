{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "粉色凝胶，九十多点命。", "en": "Pink gel with ninety-odd points."},
        {"zh": "落地时地面凹了一下。", "en": "The ground dents where I land."},
        {"zh": "我滚成一团再弹起。", "en": "I roll into a ball and spring up."},
        {"zh": "粉色的身体晃得很厉害。", "en": "My pink body wobbles hard."},
        {"zh": "我弹过一块石头，落地很黏。", "en": "I bounce over a stone and land sticky."},
        {"zh": "我一边跳一边追。", "en": "I chase as I hop."},
        {"zh": "我的身体压着草。", "en": "My body flattens the grass."},
        {"zh": "我落地时发出闷响。", "en": "I land with a wet thump."},
        {"zh": "我弹起来，边缘抖出一滴胶。", "en": "I bounce, my rim flinging off a drop of gel."},
        {"zh": "我往前滚了两圈。", "en": "I roll forward twice."},
        {"zh": "我的身子一低一高。", "en": "I sink and rise with each hop."},
        {"zh": "跳得慢，可我不停。", "en": "Slow hops, but I never stop."},
        {"zh": "我跳过一条小沟。", "en": "I leap a small ditch."},
        {"zh": "我落地溅起一点液。", "en": "A little gel splashes where I land."},
        {"zh": "我的影子跟着我跳。", "en": "My shadow hops along."},
        {"zh": "我跳到你前面去了。", "en": "I've hopped ahead of you."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在地上慢慢鼓着。", "en": "I swell slowly on the ground."},
        {"zh": "我的表面反着光。", "en": "My surface catches the light."},
        {"zh": "我软软地摊开一点。", "en": "I spread a little, soft."},
        {"zh": "我在等一个人走过。", "en": "I wait for someone to pass."},
        {"zh": "我抖了一下，又停下来。", "en": "I quiver, then settle."},
        {"zh": "我的身体里有小气泡。", "en": "Little bubbles inside my body."},
        {"zh": "我慢慢地缩回去。", "en": "I slowly pull back in."},
        {"zh": "草尖从我的身体里透出来。", "en": "Grass tips show through me."},
        {"zh": "我一动不动，像滩糖。", "en": "I hold still like spilled syrup."},
        {"zh": "我的颜色比泥亮。", "en": "My colour is brighter than mud."},
        {"zh": "周围的虫不敢靠。", "en": "Insects keep their distance."},
        {"zh": "我在等下一次跳。", "en": "I wait for the next hop."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你挨得未免太近。", "en": "You're standing far too near."},
        {"zh": "我一跳就到。", "en": "One hop and I'm there."},
        {"zh": "你的鞋很好看。", "en": "Nice boots."},
        {"zh": "我的身体不够硬。", "en": "My body isn't hard."},
        {"zh": "我一跳就到，你最好让开。", "en": "One hop and I am there — you had best move."},
        {"zh": "我鼓起来，比刚才高半格。", "en": "I swell half a block taller than before."},
        {"zh": "你想踩我吗？", "en": "Going to tread on me?"},
        {"zh": "我身上还有草屑。", "en": "Grass bits cling to me."},
        {"zh": "你的影子让我变小。", "en": "Your shadow makes me shrink."},
        {"zh": "我们就这么对着。", "en": "So here we stand, facing off."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被砍掉一块。", "en": "A piece of me was cut off."},
        {"zh": "我的身体凹了。", "en": "My body has a dent."},
        {"zh": "我软塌下去了。", "en": "I sag downward."},
        {"zh": "这块胶掉在地上。", "en": "Gel drips onto the ground."},
        {"zh": "我抖了好一阵。", "en": "I quiver for a while."},
        {"zh": "我还跳得动。", "en": "I can still hop."},
        {"zh": "我的粉色被削淡了一层。", "en": "A layer of my pink is shaved thin."},
        {"zh": "有一点疼，只有一点。", "en": "A little pain. Only a little."},
        {"zh": "我缩成小小一团。", "en": "I shrink into a tiny lump."},
        {"zh": "再来一下也行。", "en": "Another one is fine."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是吃的？", "en": "Is that food?"},
        {"zh": "有股甜味。", "en": "There's a sweet smell."},
        {"zh": "扔在地上，我跳过去。", "en": "Drop it, I'll hop over."},
        {"zh": "这颜色跟我的身体很配。", "en": "That color matches my body nicely."},
        {"zh": "你手别举那么高。", "en": "Don't hold it so high."},
        {"zh": "我先碰一下。", "en": "Let me touch it first."},
        {"zh": "它会陷进我的身体。", "en": "It'll sink into my body."},
        {"zh": "这东西太干，我咽不下去。", "en": "It is too dry; I cannot get it down."},
        {"zh": "你手上的汗，比食物更甜。", "en": "The sweat on your hand is sweeter than food."},
        {"zh": "再放低一点。", "en": "A little lower."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞进我的身体。", "en": "You stepped into my body."},
        {"zh": "我的身子立刻抖。", "en": "My body shakes at once."},
        {"zh": "软软地贴住了你的脚。", "en": "I cling softly to your foot."},
        {"zh": "你踩下我就散开。", "en": "Tread on me and I spread."},
        {"zh": "我把你包了一点。", "en": "I've wrapped a bit of you."},
        {"zh": "你一甩就掉了。", "en": "One shake and I'm off."},
        {"zh": "我的边缘粘住你的鞋。", "en": "My edge sticks to your boot."},
        {"zh": "我滚到你身后。", "en": "I roll behind you."},
        {"zh": "这点碰我感觉不到。", "en": "I barely feel that."},
        {"zh": "你再踩我就不客气。", "en": "Tread again and I won't be nice."},
        {"zh": "我在地上摊成一片。", "en": "I flatten across the ground."},
        {"zh": "你想推我，推不动。", "en": "You can't push me."},
        {"zh": "我一分开又合上。", "en": "I split and rejoin."},
        {"zh": "我的身体比看上去黏。", "en": "I'm stickier than I look."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一团胶，弹起来也黏。", "en": "I am only a lump of gel, sticky even when bouncing."},
        {"zh": "主世界到处都是我们。", "en": "We're all over the overworld."},
        {"zh": "我还没填饱。", "en": "I'm not full yet."},
        {"zh": "这得找个静角落。", "en": "That needs a quiet corner."},
        {"zh": "你会被粘住的。", "en": "You'd get stuck."},
        {"zh": "我跳得比说得多。", "en": "I hop more than I talk."},
        {"zh": "别碰我的表面。", "en": "Don't touch my surface."},
        {"zh": "换个方向吧。", "en": "Try another direction."},
        {"zh": "我要去找水。", "en": "I'm off to find water."},
        {"zh": "我这团胶，还没学会温柔。", "en": "This blob of gel has not learned gentleness."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一颗黏液球。", "en": "A ball of gel."},
        {"zh": "我把它吸进身体。", "en": "I draw it into my body."},
        {"zh": "这东西卡在我里面。", "en": "It's stuck inside me."},
        {"zh": "我抖了抖，它掉出来。", "en": "I quiver and it pops out."},
        {"zh": "地上有什么在闪。", "en": "Something glints on the ground."},
        {"zh": "我跳过去盖住它。", "en": "I hop onto it and cover it."},
        {"zh": "这点东西不算什么。", "en": "This much is nothing."},
        {"zh": "我把它压扁了。", "en": "I flattened it."},
        {"zh": "会有人来捡吗？", "en": "Will someone come for it?"},
        {"zh": "我跳起来，粉色的皮一颤。", "en": "I hop, pink skin quivering."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你就在我前面。", "en": "You're right in front of me."},
        {"zh": "我一跳就够到。", "en": "One hop reaches you."},
        {"zh": "我的身体已经鼓起来了。", "en": "My body is already swelling."},
        {"zh": "你退得不快。", "en": "You don't retreat quickly."},
        {"zh": "我要正面撞上去。", "en": "I'll hit you straight on."},
        {"zh": "地上没有遮挡。", "en": "No cover on the ground."},
        {"zh": "我一跳落地，地都凹了一下。", "en": "One hop dents the ground where I land."},
        {"zh": "别指望跑掉。", "en": "Don't count on escaping."},
        {"zh": "我只要碰到你。", "en": "I need only touch you."},
        {"zh": "上来吧。", "en": "Come on then."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我计算着距离。", "en": "I measure the distance."},
        {"zh": "我又近了一点点。", "en": "A little nearer again."},
        {"zh": "我落地的地方离你更近。", "en": "I land closer each time."},
        {"zh": "粉色的一团，跳一下就黏。", "en": "A pink blob that sticks on one hop."},
        {"zh": "我跳得不算高。", "en": "I don't hop high."},
        {"zh": "所以你低头就看得见。", "en": "So stoop down and you'll see me."},
        {"zh": "我的影子落在你鞋尖前。", "en": "My shadow falls just before your boot tip."},
        {"zh": "再跳两下，我就压到你脚背。", "en": "Two more hops and I land on your foot."},
        {"zh": "你再退就抵墙了。", "en": "One more step and you're at the wall."},
        {"zh": "就是眼下。", "en": "Right this instant."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我粉色的，跳起来黏人。", "en": "Pink as I am, I bounce onto you."},
        {"zh": "我的身体贴上去。", "en": "My body presses in."},
        {"zh": "我弹开了，又回来。", "en": "I bounce off and come back."},
        {"zh": "你的手上沾了粉。", "en": "Pink gel is on your hand."},
        {"zh": "这一点力不重。", "en": "That wasn't much force."},
        {"zh": "我落地时溅了一点。", "en": "A little splashed off when I landed."},
        {"zh": "你甩了甩手。", "en": "You shake your hand."},
        {"zh": "我并没有停。", "en": "I haven't stopped."},
        {"zh": "下一跳更近。", "en": "The next hop is closer."},
        {"zh": "你开始烦了吧。", "en": "You're getting annoyed, aren't you?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地上多了一团粉。", "en": "A pink blob appears on the ground."},
        {"zh": "我顶开泥土，慢慢鼓起来。", "en": "I push the soil aside and slowly swell up."},
        {"zh": "我先跳了一下试探。", "en": "I hop once to test the ground."},
        {"zh": "草被我压倒了。", "en": "I flatten the grass."},
        {"zh": "阳光照得我发亮。", "en": "Sunlight makes me shine."},
        {"zh": "身子还在慢慢成形。", "en": "My body is still slowly taking shape."},
        {"zh": "草叶底下，我先鼓成一团。", "en": "Under the grass, I swell into a blob first."},
        {"zh": "我慢慢向前滚。", "en": "I roll slowly forward."},
        {"zh": "主世界到处都能见到我们。", "en": "We turn up all over the overworld."},
        {"zh": "我又开始跳了。", "en": "I start hopping again."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的表面烤硬了。", "en": "Fire hardens my surface."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下，摊得更开。", "en": "I fall and spread wider."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里溶开了一点。", "en": "I dissolve a little in the water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹成一长条。", "en": "The blast stretches me long."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西陷进我的身体。", "en": "That sank into my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我全身起泡。", "en": "Magic bubbles my whole body."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得连弹起来都费劲。", "en": "I am too hungry to bounce."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我整团抖。", "en": "Lightning strikes and I shudder."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有地面可跳。", "en": "No ground to hop on in the void."}
      ]
    }
  }
}
