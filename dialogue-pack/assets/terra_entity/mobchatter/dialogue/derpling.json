{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我连跳两下逼近。", "en": "Two hops and I'm closer."},
        {"zh": "两只大眼一直瞪着你。", "en": "Both big eyes stay fixed on you."},
        {"zh": "我落地时地面一沉。", "en": "The ground sinks when I land."},
        {"zh": "这具身子有两格宽。", "en": "This body is two blocks wide."},
        {"zh": "我跳得很高。", "en": "I hop high."},
        {"zh": "我不绕路，直接过来。", "en": "I do not detour. I come straight."},
        {"zh": "草被我压得平平的。", "en": "The grass is crushed flat behind me."},
        {"zh": "我一下一下地逼近。", "en": "I come in, one bound at a time."},
        {"zh": "我的手指张着。", "en": "My fingers are spread."},
        {"zh": "这一片，我占了。", "en": "I claim this patch."},
        {"zh": "我偏了一下身子。", "en": "I tilt my body a little."},
        {"zh": "我落地时几乎没有停顿。", "en": "I barely pause between landings."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲着，眼睛不动。", "en": "I crouch, eyes unmoving."},
        {"zh": "我在听周围的动静。", "en": "I am listening to the surroundings."},
        {"zh": "我的舌头卷了一下。", "en": "My tongue curls once."},
        {"zh": "这里没什么好躲的。", "en": "There is nothing to hide behind here."},
        {"zh": "我蹲着，连眼皮都不动。", "en": "I squat without even blinking."},
        {"zh": "我皮上的旧疤早硬了。", "en": "The old scars on my hide have gone hard."},
        {"zh": "我喘着粗气。", "en": "I am breathing hard."},
        {"zh": "我在等一个动作。", "en": "I wait for one movement."},
        {"zh": "周围的草都不动。", "en": "The grass around me is still."},
        {"zh": "我搓了搓手指。", "en": "I rub my fingers together."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你就在我伸手的地方。", "en": "You're right where my hand reaches."},
        {"zh": "我盯着你好一会儿了。", "en": "I've had my eyes on you a while."},
        {"zh": "你退也没用。", "en": "Backing off will not help."},
        {"zh": "我这么大，你躲不开。", "en": "I am this big. You cannot hide."},
        {"zh": "我的手能盖住你的头。", "en": "My hand could cover your head."},
        {"zh": "你眨眼我就动。", "en": "Blink and I move."},
        {"zh": "我隔着草都闻到你。", "en": "I smell you through the grass."},
        {"zh": "我慢慢往前倾。", "en": "I lean slowly forward."},
        {"zh": "你还有一步。", "en": "One step left to you."},
        {"zh": "我就在这蹲着不动。", "en": "I squat right here and wait."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打得偏了半步。", "en": "I stagger half a step aside."},
        {"zh": "这一下，皮上多了道口子。", "en": "That opened a cut in my hide."},
        {"zh": "我嗓子里哼了一声。", "en": "A grunt comes out of my throat."},
        {"zh": "我压低了头。", "en": "I lowered my head."},
        {"zh": "这伤不碍我跳。", "en": "This wound won't stop my jumping."},
        {"zh": "我晃了晃宽肩。", "en": "I roll my broad shoulders."},
        {"zh": "我的手臂有点麻。", "en": "My arm is a little numb."},
        {"zh": "我扭过笨重的身子。", "en": "I swing my heavy body around."},
        {"zh": "我身上掉下血珠。", "en": "Drops of my blood hit the ground."},
        {"zh": "有本事再给我一下。", "en": "Hit me again if you have the nerve."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举着这个。", "en": "You hold that up."},
        {"zh": "这玩意儿我咽不下。", "en": "I can't get this down."},
        {"zh": "先把它搁在地上。", "en": "Set it on the ground."},
        {"zh": "那拦不住我。", "en": "That will not hold me."},
        {"zh": "你手里那点东西，我瞧见了。", "en": "I can see what's in your hand shaking."},
        {"zh": "我都看到了。", "en": "I saw it all."},
        {"zh": "别白费力气。", "en": "Do not waste your effort."},
        {"zh": "那个你留着。", "en": "Keep that yourself."},
        {"zh": "我只要一样东西。", "en": "I want only one thing."},
        {"zh": "那东西就是你。", "en": "That thing is you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞得你弹出去。", "en": "I knock you clean off me."},
        {"zh": "我被撞退半步。", "en": "I am knocked back half a step."},
        {"zh": "我的皮比木头硬。", "en": "My hide is harder than wood."},
        {"zh": "你被我弹开了。", "en": "You were bounced off."},
        {"zh": "这一下，你别再靠。", "en": "After that, keep away."},
        {"zh": "我拿肩头把你顶开。", "en": "I shoulder you out of the way."},
        {"zh": "我们撞得土都翻起。", "en": "Our impact turns the soil up."},
        {"zh": "你倒是很轻。", "en": "You are quite light."},
        {"zh": "我一把搂住你。", "en": "I scoop you up in one arm."},
        {"zh": "你别这么乱挣。", "en": "Do not thrash like that."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没这个心。", "en": "I have no mind for that."},
        {"zh": "同类在那边。", "en": "My kind are over there."},
        {"zh": "我们一起跳着走。", "en": "We hop along together."},
        {"zh": "它的叫声比我还低。", "en": "Its call is even lower than mine."},
        {"zh": "这一片能养我们。", "en": "This patch can feed us."},
        {"zh": "我们只用呼吸应和。", "en": "We answer each other only with breath."},
        {"zh": "它先跳走了。", "en": "It hopped away first."},
        {"zh": "我就跟着它。", "en": "I follow it."},
        {"zh": "两个影子，一起跳。", "en": "Two shadows, hopping together."},
        {"zh": "我们各跳各的方向。", "en": "We hop off in our own directions."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你掉的东西，我要。", "en": "I want what you dropped."},
        {"zh": "我捏着它翻了个面。", "en": "I pinch it and turn it over."},
        {"zh": "看着就不顺眼。", "en": "It does not please me."},
        {"zh": "我把它扔了。", "en": "I dropped it."},
        {"zh": "我一捏它就碎了。", "en": "It crumbles the moment I squeeze."},
        {"zh": "我一下就捏碎。", "en": "I crushed it at once."},
        {"zh": "这东西一文不值。", "en": "Worth nothing at all."},
        {"zh": "我嚼了两下就吞。", "en": "I give it two chews and swallow."},
        {"zh": "这个吃不得。", "en": "Not food."},
        {"zh": "我嫌它硌牙，丢了。", "en": "It's gritty, so I drop it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的两只眼锁着你。", "en": "Both my eyes lock onto you."},
        {"zh": "你终于动了。", "en": "You moved at last."},
        {"zh": "那就不用等了。", "en": "Then there is no need to wait."},
        {"zh": "我把重心压到腿上。", "en": "I sink my weight into my legs."},
        {"zh": "这一跳，够到你。", "en": "One hop will reach you."},
        {"zh": "我把指头全张开。", "en": "I spread every finger wide."},
        {"zh": "你已经看见我。", "en": "You have seen me."},
        {"zh": "那你就跑吧。", "en": "Then run."},
        {"zh": "你也跑不远。", "en": "You will not get far."},
        {"zh": "数到三我就跳。", "en": "I jump on the count of three."},
        {"zh": "现在已经数到二。", "en": "That is now two."},
        {"zh": "我整只蹦了出来。", "en": "I come at you whole."},
        {"zh": "这一回我不放你走。", "en": "This time I won't let you go."},
        {"zh": "你在我眼里。", "en": "You are in my sight."},
        {"zh": "你别叫出声。", "en": "Do not scream."},
        {"zh": "我已经落地了。", "en": "I have landed."},
        {"zh": "就到这儿为止。", "en": "It ends here."},
        {"zh": "就是这样了。", "en": "That is how it is."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步跳过去。", "en": "I hop toward you, step by step."},
        {"zh": "你退了两次。", "en": "You have backed off twice."},
        {"zh": "我跳得更近。", "en": "I hop closer."},
        {"zh": "我的手张开了。", "en": "My hand is open."},
        {"zh": "你被逼到墙边。", "en": "You are against the wall."},
        {"zh": "我个子高，遮住了光。", "en": "I am tall enough to block the light."},
        {"zh": "我看你缩在草后面。", "en": "I see you crouched behind the grass."},
        {"zh": "我把大脑袋低下来。", "en": "I lower my big head."},
        {"zh": "我听得见你喘气。", "en": "I can hear you breathing."},
        {"zh": "你喘得太快。", "en": "You are breathing too fast."},
        {"zh": "我的耐心只剩一点。", "en": "My patience is nearly gone."},
        {"zh": "开始倒计时。", "en": "Countdown begins."},
        {"zh": "下一跳我就落到你身上。", "en": "My next hop lands right on you."},
        {"zh": "地面被我一压。", "en": "The ground takes my weight."},
        {"zh": "我知道你还没走远。", "en": "I know you haven't gone far."},
        {"zh": "我的手在外面张着。", "en": "My hand hangs open before you."},
        {"zh": "我的掌往你头上压。", "en": "My palm bears down on your head."},
        {"zh": "我碰到你了。", "en": "I have touched you."},
        {"zh": "我把你抓住了。", "en": "I have my grip on you."},
        {"zh": "我绝不松手。", "en": "I never let go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我五指一齐砸下。", "en": "I bring all five fingers down at once."},
        {"zh": "你被压在地上。", "en": "You are pressed to the ground."},
        {"zh": "我的掌扣住你了。", "en": "My palm has you pinned."},
        {"zh": "我的手指扣得很深。", "en": "My fingers dig in deep."},
        {"zh": "这一下，比看起来重。", "en": "That was heavier than it looked."},
        {"zh": "你被甩出去。", "en": "You are thrown."},
        {"zh": "我从高处整个压下。", "en": "I bear down on you from above."},
        {"zh": "地面都裂了。", "en": "The ground has cracked."},
        {"zh": "我的爪子划过。", "en": "My claws rake past."},
        {"zh": "我手上沾了血。", "en": "There's blood on my hand."},
        {"zh": "你再挣一次。", "en": "Struggle again."},
        {"zh": "我松开爪子，等你倒。", "en": "I let go and wait for you to fall."},
        {"zh": "你倒是还没死。", "en": "You are not dead yet."},
        {"zh": "那样倒更好。", "en": "That is better."},
        {"zh": "你站起来吧。", "en": "Get up."},
        {"zh": "我就在原地。", "en": "I am right here."},
        {"zh": "那你就过来。", "en": "Then come here."},
        {"zh": "我这一下够你躺了。", "en": "One blow from me and you lie down."},
        {"zh": "我把你按住。", "en": "I hold you down."},
        {"zh": "站不起来了。", "en": "You will not get up."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从地上站起来。", "en": "I rise from the ground."},
        {"zh": "这里地面很平。", "en": "The ground is flat here."},
        {"zh": "我先蹲下来。", "en": "First I crouch."},
        {"zh": "我的眼睛在扫。", "en": "My eyes are sweeping."},
        {"zh": "这一带我闻过一遍。", "en": "I've sniffed this whole stretch."},
        {"zh": "草叶都被我压弯了。", "en": "The grass bends under me."},
        {"zh": "我把手撑在地上。", "en": "I brace my hands on the ground."},
        {"zh": "这一片很空。", "en": "This stretch is empty."},
        {"zh": "我从土里直起身子。", "en": "I straighten up out of the dirt."},
        {"zh": "远处有动静。", "en": "Something stirs far off."},
        {"zh": "我站起来就有两格高。", "en": "Standing, I am two blocks tall."},
        {"zh": "我这就开始找。", "en": "I begin searching."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的皮，卷了一片。", "en": "Fire curled a strip of my hide."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，我的腿压得生疼。", "en": "I fall and my legs ache under me."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进嘴里，我直扑腾。", "en": "Water fills my mouth and I thrash."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我倒退了好几步。", "en": "The blast throws me back several steps."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西扎进我的手臂。", "en": "Something is in my arm."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股力压着我的肺。", "en": "This force presses on my lungs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我跳不动。", "en": "Too hungry to hop."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在我的头上，眼前一白。", "en": "Lightning hits my head and all goes white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我脚下忽然全空。", "en": "Suddenly there's nothing under me."}
      ]
    }
  }
}
