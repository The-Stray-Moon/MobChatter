{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用翅膀拍着空气飞。", "en": "I beat the air with my wings."},
        {"zh": "我的身体有猫那么大。", "en": "I am the size of a cat."},
        {"zh": "我从树冠下飞过去。", "en": "I fly under the canopy."},
        {"zh": "我振翅时，孢子像尘一样落。", "en": "With each wingbeat, spores fall like dust."},
        {"zh": "翅膀上的菌斑在抖。", "en": "The fungal patches on my wings shiver."},
        {"zh": "孢子蝙蝠的翅，沾着粉。", "en": "Spore bat wings, dusted with spores."},
        {"zh": "我贴着洞穴顶飞。", "en": "I skim the cave roof."},
        {"zh": "我的叫声又尖又细。", "en": "My call is shrill and thin."},
        {"zh": "我不是真的蝙蝠。", "en": "I am not truly a bat."},
        {"zh": "我绕着同一根树干转。", "en": "I circle the same trunk."},
        {"zh": "我翅膀上的膜有洞。", "en": "There are holes in my wing membrane."},
        {"zh": "我飞得歪，可很快。", "en": "Crooked, but quick."},
        {"zh": "孢子落在我飞过的地方。", "en": "Spores settle where I pass."},
        {"zh": "我从高处俯冲下来。", "en": "I dive from above."},
        {"zh": "我翻了个身，继续飞。", "en": "I flip once and fly on."},
        {"zh": "我的耳朵在转。", "en": "My ears swivel."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒挂在洞顶上。", "en": "I hang from the ceiling."},
        {"zh": "孢子蝙的翅膀，一扇就掉粉。", "en": "One beat of a spore bat's wing drops dust."},
        {"zh": "我合起翅膀。", "en": "I fold my wings."},
        {"zh": "这一片是我孵出来的。", "en": "This patch grew from me."},
        {"zh": "血味在空气里。", "en": "Blood is in the air."},
        {"zh": "我的菌斑还在扩。", "en": "My fungus keeps spreading."},
        {"zh": "洞里有滴水声。", "en": "Water drips in the cave."},
        {"zh": "这点空气就够我活。", "en": "This much air is enough for me."},
        {"zh": "我的身体在轻轻抽。", "en": "My body twitches faintly."},
        {"zh": "我在听脚步声。", "en": "I listen for footsteps."},
        {"zh": "我挂在高处，抖落一层孢子。", "en": "Hanging high, I shake off a layer of spores."},
        {"zh": "我慢慢地扇了一下。", "en": "One slow wingbeat."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进我的孢子雾了。", "en": "You walked into my spore cloud."},
        {"zh": "孢子跟着我一路飘过来。", "en": "Spores drift along behind me."},
        {"zh": "我头朝下看你。", "en": "I look at you upside down."},
        {"zh": "别把手抬起来。", "en": "Do not raise your hand."},
        {"zh": "我的回声告诉我你在哪。", "en": "My echo tells me where you are."},
        {"zh": "你的呼吸会把孢子带进去。", "en": "Your breath draws the spores in."},
        {"zh": "我不在第一下就打你。", "en": "I do not strike at once."},
        {"zh": "我贴着你耳边扇风，试探你。", "en": "I fan the air by your ear, testing you."},
        {"zh": "这片洞穴归我。", "en": "This cave is mine."},
        {"zh": "你带了火，我不喜欢。", "en": "You brought fire. I dislike it."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "被打中翅膀，我坠了一截。", "en": "Hit in the wing, I drop a little."},
        {"zh": "我的翅膀撕了一角。", "en": "A corner of my wing tears."},
        {"zh": "孢子散得更乱了。", "en": "My spores scatter wildly."},
        {"zh": "我撞到墙上。", "en": "I hit the wall."},
        {"zh": "我发出一声尖啸。", "en": "I let out a shriek."},
        {"zh": "我还在天上飞。", "en": "I am still flying."},
        {"zh": "我的菌斑掉了。", "en": "Fungal patches come off."},
        {"zh": "我摇摇晃晃。", "en": "I wobble in the air."},
        {"zh": "你这一下很准，孢子从翼膜抖下来。", "en": "That was accurate; spores shake off my wing membrane."},
        {"zh": "这笔我记住了。", "en": "That is noted."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "血味更浓了。", "en": "The blood smell is stronger."},
        {"zh": "你手上那东西不是吃的。", "en": "What you hold is not food."},
        {"zh": "我只喝活物的血。", "en": "I drink only living blood."},
        {"zh": "把手放低些。", "en": "Lower your hand."},
        {"zh": "你举起东西，我压低盘旋。", "en": "You raise the item; I dip and circle."},
        {"zh": "这点还不够。", "en": "That is not enough."},
        {"zh": "我飞近了一点。", "en": "I come a little closer."},
        {"zh": "孢子沾上你了，再站会儿。", "en": "Spores cling to you. Stay a while."},
        {"zh": "我闻你身上的汗。", "en": "I smell the sweat on you."},
        {"zh": "你手里的东西太甜，我绕不开。", "en": "What you hold is too sweet; I can't stay away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀撞到你了。", "en": "My wing clips you."},
        {"zh": "我一歪，又飞正。", "en": "I tilt, then right myself."},
        {"zh": "你被孢子呛了一下。", "en": "The spores make you cough."},
        {"zh": "掉了几片菌斑。", "en": "A few fungal flakes fall."},
        {"zh": "我这身骨头轻得很。", "en": "These bones of mine are very light."},
        {"zh": "我贴着你肩膀擦过去了。", "en": "I grazed past your shoulder."},
        {"zh": "别对着空气扇。", "en": "Do not wave at the air."},
        {"zh": "我从你旁边绕了过去。", "en": "I slip around you."},
        {"zh": "这一点撞击不算什么。", "en": "That contact was nothing."},
        {"zh": "我又升回空中。", "en": "I am back in the air."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是孢子长出来的。", "en": "I grew from spores."},
        {"zh": "这种事在我的雾里。", "en": "That happens in my spore cloud."},
        {"zh": "你站远一些。", "en": "Stand further off."},
        {"zh": "我挂回去了。", "en": "I hang back up."},
        {"zh": "我躲回洞顶。", "en": "I retreat to the ceiling."},
        {"zh": "我还没吸够。", "en": "I have not fed enough."},
        {"zh": "我朝洞顶飞。", "en": "I fly to the ceiling."},
        {"zh": "我一声也不吭。", "en": "I make no sound at all."},
        {"zh": "这不是给你看的事。", "en": "That is not for you to see."},
        {"zh": "你给我出去。", "en": "Get out."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "那团肉还热，我落在旁边。", "en": "The flesh is still warm; I land beside it."},
        {"zh": "我用爪子抓住。", "en": "I catch it with my feet."},
        {"zh": "太重，我拎不起。", "en": "Too heavy for me to lift."},
        {"zh": "我叼着飞了一段。", "en": "I carry it a while."},
        {"zh": "掉在半路了。", "en": "I dropped it halfway."},
        {"zh": "这不是我想的。", "en": "That is not what I had in mind."},
        {"zh": "我扔下去了。", "en": "I let it drop."},
        {"zh": "洞里掉的东西很多。", "en": "Many things fall in caves."},
        {"zh": "我把它挂在洞顶。", "en": "I hang it from the ceiling."},
        {"zh": "我翅上长着孢子，别碰。", "en": "Spores grow on my wings; don't touch."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "孢子已经散在你头顶了。", "en": "The spores are already over your head."},
        {"zh": "孢子已经散开了。", "en": "The spores are already loose."},
        {"zh": "我从头顶下来。", "en": "I come from overhead."},
        {"zh": "你的脖子露着。", "en": "Your neck is bare."},
        {"zh": "我一俯冲就到。", "en": "One dive and I am there."},
        {"zh": "我没有眼睛也能找到你。", "en": "I find you without eyes."},
        {"zh": "这雾里你看不清我。", "en": "You cannot see me in this cloud."},
        {"zh": "你的叫声帮了我。", "en": "Your voice helps me."},
        {"zh": "我开始下压。", "en": "I begin my descent."},
        {"zh": "你退到石壁了。", "en": "You are against the wall."},
        {"zh": "就这么定了。", "en": "It is settled."},
        {"zh": "我扑下来了。", "en": "I am diving."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你头上转圈。", "en": "I wheel above your head."},
        {"zh": "孢子在往你脸上落。", "en": "Spores drift onto your face."},
        {"zh": "你气息越来越粗重。", "en": "Your breath grows heavier."},
        {"zh": "我在找你的角度。", "en": "I am finding my angle."},
        {"zh": "我的回声变了。", "en": "My echo has changed."},
        {"zh": "你在墙边，没有退路。", "en": "You are at the wall."},
        {"zh": "我从暗处来。", "en": "I come from the dark."},
        {"zh": "我悬在你后颈上方，等你停。", "en": "I hover over your nape, waiting for you to stop."},
        {"zh": "我翅膀的膜在响。", "en": "My wing membranes whisper."},
        {"zh": "火光一暗，我的孢子就压下来。", "en": "When the torch dims, my spores press down."},
        {"zh": "我翅膀上的孢子，一碰就散。", "en": "The spores on my wings scatter at a touch."},
        {"zh": "孢子云先到，我随后落下。", "en": "The spore cloud arrives first; I follow."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬在你颈侧。", "en": "I bite the side of your neck."},
        {"zh": "爪子抓过你的脸。", "en": "My claws rake your face."},
        {"zh": "孢子扑了你一脸。", "en": "A face full of spores."},
        {"zh": "我从上面撞你。", "en": "I strike from above."},
        {"zh": "这一口很小，可很深。", "en": "Small bite, deep."},
        {"zh": "我咬完立刻飞开。", "en": "I bite and fly off."},
        {"zh": "你的手扑了个空。", "en": "Your hands close on nothing."},
        {"zh": "血珠飞出来。", "en": "Beads of blood fly."},
        {"zh": "我翅上落着孢子，一路掉。", "en": "Spores fall from my wings as I fly."},
        {"zh": "你得抬头才看得见我。", "en": "You must look up to see me."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从洞顶掉下来。", "en": "I drop from the ceiling."},
        {"zh": "孢子先落在你身上。", "en": "The spores land on you first."},
        {"zh": "这片暗处很适合我。", "en": "This dark suits me."},
        {"zh": "我翅膀上的菌在发亮。", "en": "The fungus on my wings glows faintly."},
        {"zh": "我挂在洞顶，听见你呼吸。", "en": "Hanging from the cave roof, I hear you breathe."},
        {"zh": "我从墙上的一道缝挤出来。", "en": "I squeeze out of a crack in the wall."},
        {"zh": "我的叫声在洞里回响。", "en": "My cry echoes in the cave."},
        {"zh": "这里很潮湿。", "en": "It is damp here."},
        {"zh": "我在黑暗里兜了个圈。", "en": "I make one loop in the dark."},
        {"zh": "我扑到了你身上。", "en": "I have found you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一照，我的翅膀就卷了。", "en": "Fire curls my wings."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀兜不住风，我砸进落叶。", "en": "My wings can't catch air; I crash into the leaves."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀一湿，就飞不起来。", "en": "Wet wings, and I cannot rise."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我拍在洞壁上。", "en": "The blast slaps me into the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "我翅膀上的孢子，被箭打散了。", "en": "The spores on my wings scattered from the arrow."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我的孢子全灭。", "en": "That light kills my spores."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "很久没喝到血了。", "en": "It has been long since I tasted blood."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把整个洞照白。", "en": "Lightning whites out the cave."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有洞顶可以挂。", "en": "No ceiling here to hang from."}
      ]
    }
  }
}
