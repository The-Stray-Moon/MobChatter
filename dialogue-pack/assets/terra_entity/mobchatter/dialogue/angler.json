{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拎着鱼竿沿河走", "en": "I walk the river with a rod."},
        {"zh": "靴筒灌满河水，一步一响", "en": "My boots are full of river water and squelch each step."},
        {"zh": "我找鱼多的地方", "en": "I look for spots with fish."},
        {"zh": "这条河我走过很多回", "en": "I've walked this river many times."},
        {"zh": "渔网拖在地上", "en": "My net drags on the ground."},
        {"zh": "我在看水面的纹", "en": "I read the ripples."},
        {"zh": "帽子压得很低", "en": "My hat sits low."},
        {"zh": "我不急，鱼会等", "en": "No rush; the fish wait."},
        {"zh": "我踩着石头过河", "en": "I cross on the stones."},
        {"zh": "这条河湾藏着大鱼", "en": "A big one hides in this bend."},
        {"zh": "我边走边收线", "en": "I reel in as I walk."},
        {"zh": "脚下一滑，差点摔", "en": "Slipped; nearly fell."},
        {"zh": "河边的草太湿了", "en": "The riverside grass is too wet."},
        {"zh": "我边走边哼跑调的曲子", "en": "I hum a tune off-key as I walk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，竿插在泥里", "en": "I sit, the rod stuck in the mud."},
        {"zh": "水声听起来很好听", "en": "The water sounds good."},
        {"zh": "今天的鱼不太上钩", "en": "The fish aren't biting today."},
        {"zh": "我在估算水的深度", "en": "I'm estimating the depth."},
        {"zh": "浮子动了一下", "en": "The float twitched."},
        {"zh": "我挪了一下鱼桶", "en": "I shift the bucket."},
        {"zh": "河边的风有点凉", "en": "The riverside wind is chilly."},
        {"zh": "我钓了一辈子", "en": "I've fished all my life."},
        {"zh": "这条河有脾气", "en": "This river has a temper."},
        {"zh": "我看看天，快暗了", "en": "I check the sky; nearly dark."},
        {"zh": "我把线重新甩出去", "en": "I cast the line again."},
        {"zh": "坐在木头上最舒服", "en": "Sitting on this log is best."},
        {"zh": "我不在乎别人怎么看", "en": "I don't care what others think."},
        {"zh": "我等着那一下咬牙", "en": "Waiting for that tug."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是来买鱼的吗", "en": "Buying fish?"},
        {"zh": "脚抬起来，你踩着我的线", "en": "Lift your foot; you're standing on my line."},
        {"zh": "这条河是我先来的", "en": "I was on this river first."},
        {"zh": "你想钓鱼？我教你", "en": "Want to fish? I'll teach you."},
        {"zh": "你手上那东西能换鱼", "en": "That in your hand could buy fish."},
        {"zh": "别在水里面跺脚", "en": "Don't stomp in the water."},
        {"zh": "你站着挡住了我的光", "en": "You're blocking my light."},
        {"zh": "鱼都被你吓跑了", "en": "You scared off the fish."},
        {"zh": "这儿有给我住的屋子吗", "en": "Is there a house for me to live in?"},
        {"zh": "我说话直，别见怪", "en": "I'm blunt; don't mind."},
        {"zh": "你有没有钓到过大鱼", "en": "Have you ever caught a big one?"},
        {"zh": "水里有什么我知道不少", "en": "I know a lot about what's in the water."},
        {"zh": "坐下吧，别出声", "en": "Sit; don't make noise."},
        {"zh": "我的脾气看鱼获好坏", "en": "My mood depends on the catch."},
        {"zh": "今天运气一般般", "en": "Today's luck is so-so."},
        {"zh": "你看着不像会钓鱼的", "en": "You don't look like a fisher."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的鱼桶翻了", "en": "My bucket tipped over."},
        {"zh": "这一下打中了我的肩", "en": "That caught my shoulder."},
        {"zh": "我的竿子差点就断了", "en": "My rod nearly snapped."},
        {"zh": "我退到了水边", "en": "I fell back to the water's edge."},
        {"zh": "疼，但鱼还得钓", "en": "It hurts, but the fishing goes on."},
        {"zh": "你把我的鱼线踩断了", "en": "You snapped my line."},
        {"zh": "我不是打架的料", "en": "I'm no fighter."},
        {"zh": "我这身衣服全湿了", "en": "My clothes are soaked."},
        {"zh": "我闷哼一声，抱紧鱼竿", "en": "I grunt once and clutch my rod."},
        {"zh": "我已经记住你了", "en": "I'll remember you."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你要给我吃的？行", "en": "You're giving me food? Fine."},
        {"zh": "鱼饵？我自己带着", "en": "Bait? I have my own."},
        {"zh": "这味道引鱼，不引我", "en": "That smell draws fish, not me."},
        {"zh": "你把东西放在桶边", "en": "Put it by the bucket."},
        {"zh": "我不挑，填肚子就行", "en": "I'm not picky; it just needs to fill me."},
        {"zh": "你要是给鱼我更高兴", "en": "Give me a fish and I'm happier."},
        {"zh": "这点东西换不走钓点", "en": "That won't buy my fishing spot."},
        {"zh": "我吃了，但我不道谢", "en": "I'll eat, but I won't thank you."},
        {"zh": "坐一会儿，别急着走", "en": "Stay a while; don't rush off."},
        {"zh": "这鱼要是活的就好了", "en": "Wish this fish were alive."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我的桶撞翻了", "en": "You knocked over my bucket."},
        {"zh": "小心点，竿子很脆", "en": "Careful, the rod's brittle."},
        {"zh": "我身上全都是水", "en": "I'm soaked through."},
        {"zh": "让一让，我要甩竿", "en": "Move; I need room to cast."},
        {"zh": "你踩的石头是我的位置", "en": "That stone is my spot."},
        {"zh": "我退了一步，差点落水", "en": "I stepped back, nearly into the water."},
        {"zh": "这点碰撞算不得什么", "en": "That bump was nothing."},
        {"zh": "别贴着我，我手里有钩子", "en": "Don't crowd me; there's a hook in my hand."},
        {"zh": "你把我的鱼线缠住了", "en": "You tangled my line."},
        {"zh": "站到那边去，风从那边来", "en": "Stand over there; the wind comes from there."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这辈子只想钓鱼", "en": "All I want in life is fishing."},
        {"zh": "河边一个人更清静", "en": "The river's quieter alone."},
        {"zh": "我脾气差，你是知道的", "en": "You know my temper."},
        {"zh": "鱼比人更可靠", "en": "Fish are more reliable than people."},
        {"zh": "我的屋子还没有盖好", "en": "My house isn't built yet."},
        {"zh": "你能钓上一条再说", "en": "Catch one first, then we'll talk."},
        {"zh": "我说话难听，别往心里去", "en": "I talk harsh; don't take it in."},
        {"zh": "这条河够我一个人守", "en": "This river is enough for me."},
        {"zh": "别站着了，坐下吧", "en": "Don't stand; sit down."},
        {"zh": "还是聊聊鱼吧", "en": "Let's talk about fish instead."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有一条鱼", "en": "A fish on the ground."},
        {"zh": "我捡起来放进桶里", "en": "I put it in the bucket."},
        {"zh": "线头断了，我绕回来", "en": "The line broke; I wind it back."},
        {"zh": "这块石头压线正合适", "en": "This stone works as a weight."},
        {"zh": "掉的东西我顺手捡起", "en": "I pick up what's dropped."},
        {"zh": "水里漂来的也算收获", "en": "Floating in counts as a catch."},
        {"zh": "我的桶快满了", "en": "The bucket's nearly full."},
        {"zh": "这条小的，放回去吧", "en": "This small one goes back."},
        {"zh": "我用两根手指把它捏起", "en": "I pinch it up two-fingered."},
        {"zh": "别抢走我的鱼", "en": "Don't take my fish."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我的鱼都吓跑了", "en": "You scared off my fish."},
        {"zh": "我手里握着鱼钩", "en": "There's a hook in my hand."},
        {"zh": "我不常发火，但会", "en": "I don't often get angry, but I can."},
        {"zh": "河边的石头我也搬得动", "en": "I can lift riverside stones."},
        {"zh": "要打就打，别碰我的桶", "en": "Fight if you must; don't touch the bucket."},
        {"zh": "我这一竿还没收回来", "en": "My line's still out."},
        {"zh": "先动手的是你，别怪我", "en": "You threw the first blow; don't blame me."},
        {"zh": "这条河归我管", "en": "This river is mine."},
        {"zh": "每个钓点我都认得", "en": "I know every fishing spot."},
        {"zh": "你退开，我就当没发生", "en": "Step back and I'll forget it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着你，手没停下", "en": "I watch you; my hands keep working."},
        {"zh": "你不走，我就收竿", "en": "If you don't leave, I'll reel in."},
        {"zh": "水里冒泡了，是鱼", "en": "Bubbles in the water—fish."},
        {"zh": "你站的位置不太好", "en": "You're standing in a bad spot."},
        {"zh": "我等你犯下错误", "en": "I'm waiting for you to slip."},
        {"zh": "河边很滑，你知道的", "en": "The bank's slick; you know that."},
        {"zh": "我守在这儿，你总要过来", "en": "I'll hold here; you have to come past."},
        {"zh": "这条河只有一条路", "en": "There's one path along this river."},
        {"zh": "水声把你露得干干净净", "en": "The splashing gives you away completely."},
        {"zh": "再站一会儿你就知道", "en": "Stand a little longer and you'll see."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "竿子横着打了过来", "en": "The rod swings across."},
        {"zh": "我用鱼钩划你", "en": "I rake you with the hook."},
        {"zh": "一桶水泼了过去", "en": "A bucket of water in your face."},
        {"zh": "我拿竿尾顶你的胸口", "en": "I jab your chest with the rod's butt."},
        {"zh": "这一下是从下往上", "en": "This comes from below."},
        {"zh": "我踩住你的脚", "en": "I stomp your foot."},
        {"zh": "鱼桶砸在你的背上", "en": "The bucket hits your back."},
        {"zh": "你退到河里去了", "en": "You backed into the river."},
        {"zh": "我打得不好看，但实在", "en": "Not elegant, but it lands."},
        {"zh": "我收起竿站定", "en": "Rod back; stance set."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我扛着竿到了河边", "en": "I arrive at the river with my rod."},
        {"zh": "先找一个好钓点", "en": "First, a good spot."},
        {"zh": "这条河看着不错", "en": "This river looks promising."},
        {"zh": "桶放下，帽子压低", "en": "Bucket down, hat low."},
        {"zh": "水面很静，鱼在底下", "en": "The surface is calm; fish below."},
        {"zh": "我又回到这里了", "en": "I'm back again."},
        {"zh": "这里有屋子能住吗", "en": "Is there a house to live in here?"},
        {"zh": "我闻到了鱼腥味", "en": "I smell fish."},
        {"zh": "风从下游来，正好", "en": "Wind from downstream; perfect."},
        {"zh": "坐下，然后甩竿", "en": "Sit down, cast."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳进了河里", "en": "I jumped into the river."}
      ]
    },
    "hurt.fall": {
