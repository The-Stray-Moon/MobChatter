{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘在半空", "en": "I drift in the air."},
        {"zh": "我拖着一条火尾", "en": "I trail a tail of fire."},
        {"zh": "我朝你那边飘过去", "en": "I float toward you."},
        {"zh": "我贴着地面飞", "en": "I fly low over the ground."},
        {"zh": "我没有脚，只能飘", "en": "No feet, I can only float."},
        {"zh": "我身后的空气在烧", "en": "The air burns behind me."},
        {"zh": "我晃着靠近", "en": "I sway closer."},
        {"zh": "我一路撞开尘土", "en": "I plow through the dust."},
        {"zh": "我停在半空看", "en": "I pause in the air."},
        {"zh": "我碎屑落在后面", "en": "Fragments drop behind me."},
        {"zh": "我一边飞一边烫", "en": "I fly hot."},
        {"zh": "我慢慢飘高", "en": "I drift higher."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在那里", "en": "I hang there."},
        {"zh": "我烧着，没有熄过。", "en": "I burn, and have never gone out."},
        {"zh": "石头里已经空了", "en": "The stone is hollow inside."},
        {"zh": "我在等有人经过", "en": "I wait for someone to pass."},
        {"zh": "我的火没有灭", "en": "My fire has not gone out."},
        {"zh": "我不需要空气", "en": "I have no need of air."},
        {"zh": "我转了个身", "en": "I turn over once."},
        {"zh": "我很小，但很快", "en": "I am small, but fast."},
        {"zh": "灰尘被我烤热", "en": "The dust warms around me."},
        {"zh": "我再往上浮一点", "en": "I float up a little."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡在我要去的方向", "en": "You are in the direction I want."},
        {"zh": "我看起来很轻吧", "en": "I look weightless, do you not think?"},
        {"zh": "你要不要抬头", "en": "Do you want to look up?"},
        {"zh": "我的热气先碰到你的脸。", "en": "My heat reaches your face first."},
        {"zh": "抬头，我就在你帽檐上。", "en": "Look up; I am at your hat brim."},
        {"zh": "我不过是个会飞的石头", "en": "I am only a flying rock."},
        {"zh": "你手别伸出来", "en": "Do not put your hand out."},
        {"zh": "我很烫", "en": "I am burning hot."},
        {"zh": "你听见滋滋声了吗", "en": "Do you hear the sizzling?"},
        {"zh": "你看我多久了", "en": "How long have you watched me?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了一块", "en": "A piece broke off."},
        {"zh": "我的裂缝里迸出火星。", "en": "Sparks burst from my cracks."},
        {"zh": "一块石皮从我脸上剥落。", "en": "A flake of stone peels off my face."},
        {"zh": "我的光暗了一些", "en": "My glow dimmed."},
        {"zh": "我碎屑掉了一地", "en": "Fragments all over."},
        {"zh": "我退开了", "en": "I pulled away."},
        {"zh": "我还烧着", "en": "I am still burning."},
        {"zh": "石头没有软的地方", "en": "There is no soft part of stone."},
        {"zh": "石屑掉了一块", "en": "A chip of stone fell off."},
        {"zh": "我又聚拢了一点", "en": "I gathered myself a bit."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你是不是带着铁", "en": "Are you carrying iron?"},
        {"zh": "我朝你手里的东西偏", "en": "I drift toward what you hold."},
        {"zh": "我闻不到，但我知道它在", "en": "I cannot smell, but I know it is there."},
        {"zh": "你手里的铁，我闻得到。", "en": "I can smell the iron in your hand."},
        {"zh": "我飘着降下去一点", "en": "I drift down a little."},
        {"zh": "把那块铁举稳一点。", "en": "Hold that iron steady."},
        {"zh": "那东西会烫手", "en": "That will burn your hand."},
        {"zh": "我看得见它的光", "en": "I see its shine."},
        {"zh": "让我碰一下", "en": "Let me touch it."},
        {"zh": "它就快到我面前了", "en": "It is nearly before me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到一块烫石头", "en": "You hit a hot stone."},
        {"zh": "我被撞偏了", "en": "I was knocked off course."},
        {"zh": "我拖着火光退开", "en": "I back off trailing fire."},
        {"zh": "我的边缘很烫", "en": "My edges are hot."},
        {"zh": "你没有把我撞停", "en": "You did not stop me."},
        {"zh": "我从你肩上擦过去", "en": "I grazed past your shoulder."},
        {"zh": "我碎了一点", "en": "A chip came off me."},
        {"zh": "被撞偏后我又找回方向。", "en": "Knocked off course, I find my heading again."},
        {"zh": "你袖子焦了一块", "en": "Your sleeve is singed."},
        {"zh": "别拿手挡", "en": "Do not block me with your hand."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一块石头", "en": "I am only a rock."},
        {"zh": "这东西不会回应", "en": "This thing will not respond."},
        {"zh": "我这个形态没有那些", "en": "This form has none of that."},
        {"zh": "我烧得很旺", "en": "I am burning bright."},
        {"zh": "两团火会撞在一起", "en": "Two fires would collide."},
        {"zh": "你最好退到石头后", "en": "You had better get behind stone."},
        {"zh": "我没什么想法", "en": "I have no thoughts."},
        {"zh": "我只是亮着", "en": "I only glow."},
        {"zh": "火里没有那种事。", "en": "There is no such thing in fire."},
        {"zh": "这事烧完就算了。", "en": "When the burn ends, so does this."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我烧化了它", "en": "I melted it."},
        {"zh": "这东西太重", "en": "This is too heavy."},
        {"zh": "我拖着它飞不高", "en": "Holding it, I cannot fly high."},
        {"zh": "它粘在我身上", "en": "It stuck to me."},
        {"zh": "我把它裹进去", "en": "I wrap it into my body."},
        {"zh": "金属在我这里会软", "en": "Metal softens near me."},
        {"zh": "这点东西不够烧", "en": "Not enough to burn."},
        {"zh": "我带着它走", "en": "I carry it along."},
        {"zh": "掉了就掉了", "en": "If it fell, it fell."},
        {"zh": "别来捡", "en": "Do not come picking."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你被我的光照到了", "en": "My light fell on you."},
        {"zh": "我朝你加速", "en": "I accelerate toward you."},
        {"zh": "别站在空旷的地方", "en": "Do not stand in the open."},
        {"zh": "我个头不大，可速度够快", "en": "I am not big, but I am fast enough."},
        {"zh": "你这次躲不开了", "en": "You cannot dodge this time."},
        {"zh": "你的头顶就是我瞄准的点。", "en": "The point above your head is my mark."},
        {"zh": "这一下会很烫", "en": "This will burn."},
        {"zh": "我从上面来", "en": "I come from above."},
        {"zh": "我压低了，冲着你的背。", "en": "I drop low, aimed at your back."},
        {"zh": "我不是流星，是头", "en": "I am not a meteor, I am a head."},
        {"zh": "你退到树下了", "en": "You retreated under the trees."},
        {"zh": "树挡不住我", "en": "Trees will not stop me."},
        {"zh": "现在，抬头", "en": "Now, look up."},
        {"zh": "我一撞就碎，但够用", "en": "I break on impact, but that is enough."},
        {"zh": "你别跑直线", "en": "Do not run in a straight line."},
        {"zh": "我能追上", "en": "I can catch up."},
        {"zh": "热气先到，我后到", "en": "The heat arrives first, then me."},
        {"zh": "你只剩这一片空地", "en": "You have only this clearing."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着树梢跟你移动。", "en": "I track you along the treetops."},
        {"zh": "我一直在绕圈", "en": "I keep circling."},
        {"zh": "你没有抬头", "en": "You have not looked up."},
        {"zh": "我压低了一点", "en": "I dropped a little lower."},
        {"zh": "我在你左边，越来越烫。", "en": "I am at your left, hotter by the moment."},
        {"zh": "我的火光照着你的后颈。", "en": "My firelight falls on the back of your neck."},
        {"zh": "你再跑几步就到岩壁", "en": "A few more steps and you reach the cliff."},
        {"zh": "我没有急着撞", "en": "I am in no hurry to hit."},
        {"zh": "你停下喘息的那一刻归我。", "en": "The moment you stop to breathe is mine."},
        {"zh": "热气已经贴到你背上", "en": "The heat is already on your back."},
        {"zh": "你每跑一步我都算过。", "en": "I have counted every step you run."},
        {"zh": "我身上的火越来越亮", "en": "My fire is burning brighter."},
        {"zh": "这附近没有遮挡", "en": "No cover around here."},
        {"zh": "我一直锁定你", "en": "I keep you locked."},
        {"zh": "你转身我就从另一侧来", "en": "Turn and I come from the other side."},
        {"zh": "我绕到你的侧上方。", "en": "I swing above your flank."},
        {"zh": "你踩到什么都会响", "en": "Whatever you step on will sound."},
        {"zh": "你听见碎裂了吗", "en": "Do you hear the cracking?"},
        {"zh": "那不是石头", "en": "That is not stone."},
        {"zh": "我就在你侧上方", "en": "I am just above your flank."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿额头砸你的肩。", "en": "I drive my forehead into your shoulder."},
        {"zh": "你身上起了烟", "en": "Smoke rises from you."},
        {"zh": "这一下很烫", "en": "That was hot."},
        {"zh": "我的碎屑粘在你身上", "en": "My fragments cling to you."},
        {"zh": "我的碎屑钻进你的领口。", "en": "My fragments get into your collar."},
        {"zh": "我撞完就散了", "en": "I scatter after the hit."},
        {"zh": "你袖子开始烧", "en": "Your sleeve is catching fire."},
        {"zh": "我没有手，只有重量", "en": "I have no hands, only weight."},
        {"zh": "我贴着你的胸口过", "en": "I pass close to your chest."},
        {"zh": "你又挨了一下", "en": "You took another."},
        {"zh": "你还在原地", "en": "You are still standing there."},
        {"zh": "我再来", "en": "Here I come again."},
        {"zh": "我的火照得你看不清", "en": "My fire blinds you."},
        {"zh": "你抬手挡了一下", "en": "You raised an arm to block."},
        {"zh": "这一撞把地面烧黑了", "en": "That impact blackened the ground."},
        {"zh": "你听见石头裂了吗", "en": "Did you hear the stone split?"},
        {"zh": "我的边缘很锋利", "en": "My edges are sharp."},
        {"zh": "我落地时炸开了", "en": "I burst when I landed."},
        {"zh": "你头发焦了一点", "en": "A bit of your hair is singed."},
        {"zh": "我还在飘", "en": "I am still floating."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从天上落下来", "en": "I fall from the sky."},
        {"zh": "我的火一点就着", "en": "My fire catches at once."},
        {"zh": "地上多了一个坑", "en": "A new pit in the ground."},
        {"zh": "周围的空气变热了", "en": "The air around grew hot."},
        {"zh": "我不是自然刷出来的", "en": "I did not spawn naturally."},
        {"zh": "我从焦土里翻了个身。", "en": "I roll over out of the scorched earth."},
        {"zh": "我身上还带着余烬", "en": "Embers still cling to me."},
        {"zh": "我落下来，土都焦了。", "en": "I come down and the soil scorches."},
        {"zh": "我在找方向", "en": "I am finding my heading."},
        {"zh": "地面上落了一片灰", "en": "Ash scatters on the ground."},
        {"zh": "我碎屑还没落完", "en": "My fragments are still falling."},
        {"zh": "我亮着，很显眼", "en": "I glow, very conspicuous."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我影响不大，但很吵", "en": "Fire barely hurts me, but it is loud."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地时裂成了几块", "en": "I cracked into pieces on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一浇，我的火差点灭了", "en": "The water nearly put my fire out."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我自己也被炸散了", "en": "I was scattered by my own blast."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过我的火", "en": "An arrow passed through my fire."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光把我的火压小了", "en": "That light smothered my flame."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，但我确实虚了", "en": "I eat nothing, yet I am weak."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我身上，我亮得像白天", "en": "Lightning struck and I lit up like day."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我的火在虚空里灭了", "en": "My fire died in the void."}
      ]
    }
  }
}
