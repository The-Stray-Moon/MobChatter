      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "紫光一闪，我的回声乱了。", "en": "Violet light, and my echo scrambles."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得飞不稳。", "en": "Too hungry to fly straight."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把整个冰洞照亮。", "en": "The flash lights the whole ice cave."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有冰，没有风，我往下掉。", "en": "No ice, no wind — I fall."}
      ]
    }
  }
