{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着洞顶飞。", "en": "I fly close under the cave roof."},
        {"zh": "我的翅膀结着一层霜。", "en": "Frost crusts my wings."},
        {"zh": "我从冰柱之间穿过去。", "en": "I weave between icicles."},
        {"zh": "我的叫声划破了雪夜。", "en": "My cry cuts through the snowy night."},
        {"zh": "我绕着雪地低飞。", "en": "I fly low over the snow."},
        {"zh": "我的爪子缩在腹下。", "en": "My claws tuck under my belly."},
        {"zh": "我一头俯下去，又拉起来。", "en": "I dive and pull up."},
        {"zh": "我在河面上方滑过。", "en": "I glide above the frozen river."},
        {"zh": "我停在冰棱上。", "en": "I land on an ice spike."},
        {"zh": "我贴着雪面飞。", "en": "I skim the snow's surface."},
        {"zh": "我转了个大弯。", "en": "I bank wide."},
        {"zh": "每口气都在眼前结霜。", "en": "Every breath frosts in front of me."},
        {"zh": "我贴着洞顶翻了个身。", "en": "I flip over close to the roof."},
        {"zh": "我在冰柱上停了一下。", "en": "I pause on an icicle."},
        {"zh": "我从冰缝飞出去。", "en": "I fly out through the ice crack."},
        {"zh": "我在雪地上方转圈。", "en": "I circle above the snowfield."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒挂在冰洞顶上。", "en": "I hang upside down from the ice roof."},
        {"zh": "我的翅膀收着。", "en": "My wings are folded."},
        {"zh": "我在听冰裂的声音。", "en": "I listen to the ice cracking."},
        {"zh": "我的耳朵在洞里转了半圈。", "en": "My ears swivel half a turn."},
        {"zh": "缩成一团，像块冰。", "en": "Curled up, I look like a lump of ice."},
        {"zh": "天越冷，我越精神。", "en": "The colder it gets, the more awake I am."},
        {"zh": "我的毛上挂着冰晶。", "en": "Ice crystals cling to my fur."},
        {"zh": "耳朵转着，听冰下的声。", "en": "My ears turn, listening under the ice."},
        {"zh": "我在看下面走动的东西。", "en": "I watch things moving below."},
        {"zh": "舌头一碰，爪子粘住冰。", "en": "One touch of my tongue and my claws stick."},
        {"zh": "挂着不动，等有人路过。", "en": "Hanging still, waiting for someone to pass."},
        {"zh": "我在听风穿过冰缝。", "en": "I listen to wind in the ice cracks."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的热气让我流口水。", "en": "Your warmth makes me drool."},
        {"zh": "我挂在冰棱上，看你。", "en": "I hang from an icicle and watch you."},
        {"zh": "你不该进冰洞。", "en": "You shouldn't be in this ice cave."},
        {"zh": "我在你头顶画圈子。", "en": "I trace circles above your head."},
        {"zh": "你的手很暖。", "en": "Your hands are warm."},
        {"zh": "我落在冰柱上。", "en": "I land on an icicle."},
        {"zh": "你别举火把。", "en": "Don't raise that torch."},
        {"zh": "我闻得到你的血。", "en": "I smell your blood."},
        {"zh": "薄翅膀一扇就作响。", "en": "My thin wings rustle with every beat."},
        {"zh": "你一转头，我就动。", "en": "You turn your head, and I move."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉在冰上。", "en": "I land on the ice."},
        {"zh": "我贴着地爬，飞不起来。", "en": "I crawl along the ground, unable to fly."},
        {"zh": "爪子打滑，我抓紧冰。", "en": "My claws slip; I dig into the ice."},
        {"zh": "尖叫声在雪谷里回荡。", "en": "My shriek echoes through the snowy valley."},
        {"zh": "霜碎了，我尖叫一声。", "en": "The frost shatters; I shriek."},
        {"zh": "一只翅膀也能扑。", "en": "One wing can still beat."},
        {"zh": "我退回洞顶。", "en": "I retreat to the roof."},
        {"zh": "我贴着冰面。", "en": "I press to the ice."},
        {"zh": "我的耳朵贴着头。", "en": "My ears flatten to my head."},
        {"zh": "我在冰柱上抓稳了。", "en": "I grip the icicle firm."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那个有热气。", "en": "That gives off heat."},
        {"zh": "那点火光，刺得我眼疼。", "en": "That torchlight stings my eyes."},
        {"zh": "火光暖，我忍不住靠近。", "en": "The fire is warm; I can't help drawing near."},
        {"zh": "那个不吸血。", "en": "That has no blood in it."},
        {"zh": "你的手在冒热气。", "en": "Your hand is steaming."},
        {"zh": "我想靠近热。", "en": "I want to come near the warmth."},
        {"zh": "你别动，我在看你脖子。", "en": "Hold still; I'm watching your neck."},
        {"zh": "我停在你手上。", "en": "I land on your hand."},
        {"zh": "太热了，我退开。", "en": "Too hot; I pull back."},
        {"zh": "你身上还有热的东西吗。", "en": "Anything else warm on you?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我摔了下来。", "en": "You hit me and I fell."},
        {"zh": "我在地上爬了两下。", "en": "I scrabble on the ground."},
        {"zh": "我拍了两下，腾空。", "en": "Two beats and I'm airborne."},
        {"zh": "你挥手，我翻了个跟头。", "en": "You swat; I tumble head over heels."},
        {"zh": "我撞在冰柱上。", "en": "I hit an icicle."},
        {"zh": "我升到冰柱上面。", "en": "I climb above the icicles."},
        {"zh": "我们碰了一下，霜掉了。", "en": "We touched and frost fell."},
        {"zh": "你的手套上有冰。", "en": "There is ice on your glove."},
        {"zh": "我绕着冰柱飞开。", "en": "I fly around the icicle."},
        {"zh": "我落在冰面上。", "en": "I land on the ice."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是冰洞里的东西。", "en": "I am a creature of the ice cave."},
        {"zh": "这里的冬天很长。", "en": "Winter here is long."},
        {"zh": "我这一族不多。", "en": "There are few of us."},
        {"zh": "洞里只有冰，没有伴。", "en": "The cave holds only ice, no mate."},
        {"zh": "我挂在上面就好。", "en": "Hanging up here is enough."},
        {"zh": "你身上太暖了。", "en": "You are too warm."},
        {"zh": "我飞开一点。", "en": "I fly off a little."},
        {"zh": "这里不适合。", "en": "This isn't the place."},
        {"zh": "我要去找吃的。", "en": "I'm going to hunt."},
        {"zh": "你自己小心。", "en": "Watch yourself."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲下去抓。", "en": "I dive and grab it."},
        {"zh": "它冻在我爪子上。", "en": "It freezes to my claws."},
        {"zh": "我带不动这个。", "en": "I can't carry this."},
        {"zh": "我把它丢在冰上。", "en": "I drop it on the ice."},
        {"zh": "这个不够一口血。", "en": "Not a mouthful of blood."},
        {"zh": "我抓着它飞了一段。", "en": "I carry it a short way."},
        {"zh": "冻硬的东西从我爪间滑了。", "en": "The frozen thing slips my claws."},
        {"zh": "这个吸不出血。", "en": "No blood here to drink."},
        {"zh": "我把它推到雪里。", "en": "I push it into the snow."},
        {"zh": "我只要温暖的东西。", "en": "I only want something warm."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进冰洞里了。", "en": "You've come into the ice cave."},
        {"zh": "我从冰缝里坠下来。", "en": "I drop out of the ice crack."},
        {"zh": "你的热气很显眼。", "en": "Your heat stands out."},
        {"zh": "我绕着冰柱。", "en": "I circle the icicles."},
        {"zh": "这里是我的洞。", "en": "This cave is mine."},
        {"zh": "你踩雪的声音，我听见了。", "en": "I hear the sound of you breaking snow."},
        {"zh": "你退到冰墙边了。", "en": "You've backed to the ice wall."},
        {"zh": "我俯冲了一次，试距离。", "en": "I dove once to test the range."},
        {"zh": "你抬头，我就在冰棱上。", "en": "Look up — I'm on the icicle."},
        {"zh": "我贴着洞顶。", "en": "I hug the cave roof."},
        {"zh": "收翅，我朝你的脖子。", "en": "Wings folded, I go for your neck."},
        {"zh": "你的脖子空了。", "en": "Your neck is open."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "圈越收越紧，你跑不掉。", "en": "The circle tightens; you can't escape."},
        {"zh": "你转身，我就上升。", "en": "You turn, and I rise."},
        {"zh": "我的影子在冰面上。", "en": "My shadow is on the ice."},
        {"zh": "你听见翅膀声了吗。", "en": "Do you hear the wings?"},
        {"zh": "我落在你背后的冰柱上。", "en": "I land on the icicle behind you."},
        {"zh": "你往火把那边退。", "en": "You're retreating toward the torch."},
        {"zh": "火光让我看不清。", "en": "The torchlight blinds me."},
        {"zh": "我压低到你的高度。", "en": "I drop to your height."},
        {"zh": "你喘气的声音很响。", "en": "Your breathing is loud."},
        {"zh": "我要从侧面来。", "en": "I'll come from the side."},
        {"zh": "背后是冰墙，别退了。", "en": "An ice wall behind you; don't back up."},
        {"zh": "我的牙已经碰到了。", "en": "My teeth have touched."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲下来抓。", "en": "I dive and rake."},
        {"zh": "我的牙咬在你肩头。", "en": "My teeth close on your shoulder."},
        {"zh": "这一下很冷。", "en": "That was cold."},
        {"zh": "我撞在你脸上。", "en": "I hit your face."},
        {"zh": "你拍在冰面上。", "en": "You slap the ice."},
        {"zh": "雪林里，我贴着树飞。", "en": "In the snowy wood I fly between trunks."},
        {"zh": "我又在你手背上咬了一口。", "en": "I bite the back of your hand again."},
        {"zh": "你的伤口结了霜。", "en": "Frost forms on your wound."},
        {"zh": "我飞开，又回来。", "en": "I fly off and return."},
        {"zh": "你快点走，趁我还怕火。", "en": "Leave quickly, while I still fear fire."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从冰缝里飞出来。", "en": "I fly out of an ice crack."},
        {"zh": "厚冰底下，我醒过来。", "en": "Under thick ice, I wake."},
        {"zh": "冰水顺着翅膀往下滴。", "en": "Icy water drips from my wings."},
        {"zh": "我挂在洞顶。", "en": "I hang from the roof."},
        {"zh": "冷气从我身上散开。", "en": "Cold spreads off me."},
        {"zh": "冰面裂了，我钻出来。", "en": "The ice splits; I claw my way out."},
        {"zh": "我伸开翅膀。", "en": "I stretch my wings."},
        {"zh": "这里有一个洞。", "en": "There is a gap here."},
        {"zh": "我从冰缝里倒挂出来。", "en": "I hang out of an ice crack, upside down."},
        {"zh": "我闻到了暖的东西。", "en": "I smell something warm."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一近，我的翅膀上的霜就化了。", "en": "Fire nears and the frost on my wings melts."}
      ]
    },
