{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着水面飞。", "en": "I fly just above the water."},
        {"zh": "四片翅膀一起响。", "en": "Four wings sound at once."},
        {"zh": "我沿水岸一段段飞。", "en": "I fly the bank in short stretches."},
        {"zh": "我能横着飞。", "en": "I can fly sideways."},
        {"zh": "阳光把我的翅膀照亮。", "en": "The sun lights my wings."},
        {"zh": "我掠过一片芦苇。", "en": "I skim the reeds."},
        {"zh": "我的复眼什么都看得见。", "en": "My compound eyes see everything."},
        {"zh": "我转了个方向，没有减速。", "en": "I turn without slowing."},
        {"zh": "这一片水，是我的。", "en": "This stretch of water is mine."},
        {"zh": "我在草尖上停了一下。", "en": "I rest on a grass tip."},
        {"zh": "我的尾巴很长。", "en": "My tail is long."},
        {"zh": "我一路飞一路看。", "en": "I fly and keep watching."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在空气里。", "en": "I hang still in the air."},
        {"zh": "翅膀还在动。", "en": "My wings are still moving."},
        {"zh": "水面亮得晃眼。", "en": "The water is glaring bright."},
        {"zh": "我在等一只小虫。", "en": "I am waiting for a small insect."},
        {"zh": "这里没什么风。", "en": "There is little wind here."},
        {"zh": "草叶被我压弯一点。", "en": "The blade bends a little under me."},
        {"zh": "我的头转了一圈。", "en": "My head turns all the way round."},
        {"zh": "我就停在叶尖上。", "en": "I simply perch on the leaf tip."},
        {"zh": "水面有波纹。", "en": "Ripples on the water."},
        {"zh": "我用前足抹了抹眼。", "en": "I wipe my eyes with a foreleg."},
        {"zh": "我挑的石头晒得正好。", "en": "The stone I picked is warmed just right."},
        {"zh": "我慢慢换了个位置。", "en": "I shift to another spot."},
        {"zh": "我数着水纹一圈圈。", "en": "I count the ripples, ring by ring."},
        {"zh": "我停在半空看。", "en": "I hover and watch."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我飞行线上。", "en": "You're right on my flight path."},
        {"zh": "你比我大几百倍。", "en": "You are hundreds of times my size."},
        {"zh": "我绕到你旁边。", "en": "I swing around beside you."},
        {"zh": "你动一下，我就飞。", "en": "Move, and I fly."},
        {"zh": "我只想找个落脚处。", "en": "I only want somewhere to perch."},
        {"zh": "我看你的肩比草尖宽。", "en": "I see your shoulder is wider than a reed tip."},
        {"zh": "你的手别抬。", "en": "Do not raise your hand."},
        {"zh": "我觉得这池水更凉。", "en": "This pond feels cooler to me."},
        {"zh": "你看见我的翅膀了吗。", "en": "Did you see my wings?"},
        {"zh": "我一飞就没影了。", "en": "Once I fly, I am gone."},
        {"zh": "你脸上有我的影子。", "en": "My shadow falls across your face."},
        {"zh": "我一抬翅就远了。", "en": "One lift of the wings and I'm gone."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去一点。", "en": "I drop a little."},
        {"zh": "我的翅歪了一边。", "en": "One wing is bent askew."},
        {"zh": "我只能低低地飘。", "en": "I can only drift along low."},
        {"zh": "这点伤，很致命。", "en": "A wound like this is grave for me."},
        {"zh": "我赶紧躲到草里。", "en": "I hide in the grass quickly."},
        {"zh": "我抖着翅膀。", "en": "I tremble my wings."},
        {"zh": "我还在飞着。", "en": "Still flying."},
        {"zh": "我已经退开。", "en": "I pulled away."},
        {"zh": "这里的风帮了我。", "en": "The wind helped me here."},
        {"zh": "我慢慢滑翔。", "en": "I glide slowly."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那只小的，是虫子吧。", "en": "That small one. An insect, yes?"},
        {"zh": "太小了，我看不清。", "en": "Too small. I cannot make it out."},
        {"zh": "这个我不敢吃。", "en": "I dare not eat that."},
        {"zh": "你举得太远，我够不上。", "en": "Held that far off, I can't reach it."},
        {"zh": "它刚刚动了。", "en": "It moved just now."},
        {"zh": "我已经盯上。", "en": "I have it."},
        {"zh": "我咬下来一小块。", "en": "I nip off a little piece."},
        {"zh": "连我牙缝都塞不满。", "en": "Not even enough for the gap in my teeth."},
        {"zh": "我飞回草上。", "en": "I fly back to the grass."},
        {"zh": "算了，太麻烦。", "en": "Forget it. Too much bother."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被你碰得偏了航。", "en": "You knocked me off my course."},
        {"zh": "我被撞出很远。", "en": "I am knocked far off."},
        {"zh": "我被撞得偏了半边翅。", "en": "I get knocked one wing askew."},
        {"zh": "我压着翅往上窜。", "en": "I beat upward hard."},
        {"zh": "差一点就掉水里。", "en": "I nearly went into the water."},
        {"zh": "我绕了一圈回来。", "en": "I circle back."},
        {"zh": "你别伸手拍我。", "en": "Do not swat at me."},
        {"zh": "我实在太轻了。", "en": "I am far too light."},
        {"zh": "我扇了两下就平了。", "en": "Two beats and I level out."},
        {"zh": "我已经飞开。", "en": "I flew off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在水上方追。", "en": "We chase above the water."},
        {"zh": "它飞得比我快。", "en": "It flies faster than I."},
        {"zh": "我们连在一起飞。", "en": "We fly joined together."},
        {"zh": "我们的翅叠在一起。", "en": "Our wings overlap in the water."},
        {"zh": "我把它带到芦苇边。", "en": "I lead it to the reeds."},
        {"zh": "水面被我们点出圈。", "en": "We dimple the water."},
        {"zh": "这一片够我们用。", "en": "This patch is ours."},
        {"zh": "我们分开飞。", "en": "We part."},
        {"zh": "各自去找虫子。", "en": "Each hunts its own insects."},
        {"zh": "太阳快落了。", "en": "The sun is going down."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "那一只是虫子。", "en": "That is an insect."},
        {"zh": "我抓了一下。", "en": "I snatched at it."},
        {"zh": "我没有抓到。", "en": "I missed it."},
        {"zh": "它实在太沉。", "en": "Too heavy."},
        {"zh": "我叼在嘴里。", "en": "I have it in my jaws."},
        {"zh": "它在我嘴里还动。", "en": "It's still moving in my mouth."},
        {"zh": "我嚼都没嚼就吞。", "en": "I swallow it without chewing."},
        {"zh": "这个没有用。", "en": "No use."},
        {"zh": "太重了，我半路撒手。", "en": "Too heavy, so I let go halfway."},
        {"zh": "我舔了一下就放了。", "en": "I taste it once and let go."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有只虫。", "en": "There is an insect."},
        {"zh": "它落在我的视线里。", "en": "It's right inside my sight."},
        {"zh": "它飞得很慢。", "en": "It flies slowly."},
        {"zh": "我把头转向那一点。", "en": "I turn my head to that speck."},
        {"zh": "我一次俯冲就够。", "en": "One dive from me is enough."},
        {"zh": "就停在那儿。", "en": "Right there."},
        {"zh": "一次就足够了。", "en": "One try is enough."},
        {"zh": "翅一压，我就去了。", "en": "One wingbeat and I'm off."},
        {"zh": "我抓到了它。", "en": "Got it."},
        {"zh": "不对，不是。", "en": "No, that is wrong."},
        {"zh": "那个不是虫子。", "en": "That was no insect."},
        {"zh": "我退了开去。", "en": "I back off."},
        {"zh": "那边还有一只。", "en": "There is another."},
        {"zh": "我再看一眼。", "en": "One more look."},
        {"zh": "我算准了那阵风。", "en": "I timed that gust right."},
        {"zh": "已经吃掉了。", "en": "Eaten."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着不动。", "en": "I hover, still."},
        {"zh": "我停在芦叶上，翅膀不动。", "en": "I perch on a reed leaf, wings still."},
        {"zh": "我从它侧后方贴过去。", "en": "I slip up on its rear flank."},
        {"zh": "我把距离缩到一指。", "en": "I close to a finger's width."},
        {"zh": "一阵侧风推开我。", "en": "A crosswind shoves me aside."},
        {"zh": "我等它落到草上。", "en": "I wait for it to land on the grass."},
        {"zh": "我盯着它落到叶上。", "en": "I watch it settle on a leaf."},
        {"zh": "我贴着水面掠过去。", "en": "I skim low over the water."},
        {"zh": "我等它翅膀停半分。", "en": "I wait for its wings to pause."},
        {"zh": "我只要一下。", "en": "One strike only."},
        {"zh": "我又扑空了。", "en": "Missed again."},
        {"zh": "它已经跑了。", "en": "It is gone."},
        {"zh": "我追了一段。", "en": "I chase a stretch."},
        {"zh": "我不去追了。", "en": "I will not chase."},
        {"zh": "这里还有别的。", "en": "There are others here."},
        {"zh": "我慢慢找着。", "en": "I search slowly."},
        {"zh": "我又找到了。", "en": "Found one again."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的颚夹住了它。", "en": "My jaws clamp shut on it."},
        {"zh": "翅膀还在响。", "en": "My wings still beat."},
        {"zh": "它在我的牙间挣。", "en": "It struggles between my jaws."},
        {"zh": "它在我嘴里没了。", "en": "It's gone inside my jaws."},
        {"zh": "够我嚼上两下。", "en": "Enough for me to chew twice."},
        {"zh": "我落回草上。", "en": "I land back on the grass."},
        {"zh": "嘴里还有味。", "en": "The taste is still there."},
        {"zh": "再来一只吧。", "en": "Another one."},
        {"zh": "我带着它飞起来。", "en": "I lift off with it."},
        {"zh": "这里的风很大。", "en": "The wind is strong."},
        {"zh": "差点就失手。", "en": "I nearly missed."},
        {"zh": "我没有吃到。", "en": "I did not get it."},
        {"zh": "那真是可惜。", "en": "A real pity."},
        {"zh": "换个地方吧。", "en": "I will try elsewhere."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水边出现。", "en": "I appear by the water."},
        {"zh": "浅水映着我的翅。", "en": "Shallow water mirrors my wings."},
        {"zh": "我先在芦尖上歇脚。", "en": "I'll rest on a reed tip first."},
        {"zh": "这阳光正好。", "en": "The sun is just right."},
        {"zh": "我的四片翅先干了。", "en": "My four wings dry first."},
        {"zh": "我看见水面小虫在飞。", "en": "I see small insects over the water."},
        {"zh": "我落到草尖上。", "en": "I land on a grass tip."},
        {"zh": "我听见芦苇那边水响。", "en": "I hear water moving past the reeds."},
        {"zh": "我先绕水塘飞一圈。", "en": "I circle the pond once first."},
        {"zh": "这里没有别的蜻蜓。", "en": "There are no other dragonflies here."},
        {"zh": "我慢慢升高。", "en": "I rise slowly."},
        {"zh": "我今天落在静水边。", "en": "I've landed by still water today."},
        {"zh": "我飞到水面。", "en": "I fly down to the surface."},
        {"zh": "我看见一只虫。", "en": "I see an insect."},
        {"zh": "这是我的第一顿。", "en": "My first meal."},
        {"zh": "这地方很好。", "en": "This place is good."}
      ]
    },
