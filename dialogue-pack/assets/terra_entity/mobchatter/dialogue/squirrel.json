      "lines": [
        {"zh": "我蹦跳着穿过枯叶", "en": "I hop through the dry leaves."},
        {"zh": "我甩着大尾巴跑", "en": "I run with my big tail behind me."},
        {"zh": "我窜上树干又下来", "en": "I dart up the trunk and down."},
        {"zh": "我沿树枝一路小跑", "en": "I trot along the branch."},
