{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳在地上蹭出声。", "en": "My shell rasps on the ground."},
        {"zh": "我跳着走，很重。", "en": "I hop along, heavy."},
        {"zh": "我的花纹和箱子一样。", "en": "My pattern matches a chest."},
        {"zh": "我慢慢挪，怕露馅。", "en": "I shift slowly, afraid of giving myself away."},
        {"zh": "我的锁扣在响。", "en": "My latch rattles."},
        {"zh": "木箱一步一步跳向你。", "en": "The chest hops toward you step by step."},
        {"zh": "地上的雪被我压出坑。", "en": "The snow dents under me."},
        {"zh": "我停下，装成箱子。", "en": "I stop and pass for a chest."},
        {"zh": "我裂开一道口，又合上。", "en": "A gap opens in me, then shuts."},
        {"zh": "我的边角结着冰。", "en": "Ice crusts my corners."},
        {"zh": "我移动时有一道细缝。", "en": "A thin seam shows when I move."},
        {"zh": "我慢慢侧过去。", "en": "I tilt to one side."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立在那儿，像一口箱子。", "en": "I stand there like a chest."},
        {"zh": "我的花纹一动不动。", "en": "My pattern holds perfectly still."},
        {"zh": "我在等一只手伸过来。", "en": "I wait for a hand to reach over."},
        {"zh": "我的缝里透着冷气。", "en": "Cold air leaks from my seam."},
        {"zh": "我一动不动，连雪都不扫。", "en": "I stay still and don't even shake off the snow."},
        {"zh": "我在听脚步。", "en": "I listen for footsteps."},
        {"zh": "我把边角摆得更正。", "en": "I set my corners straighter."},
        {"zh": "我的锁扣垂着。", "en": "My latch hangs."},
        {"zh": "我在数有几个人过来。", "en": "I count how many come near."},
        {"zh": "我的花纹有一处不对。", "en": "One spot of my pattern is wrong."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你伸手的那一刻，我醒了。", "en": "The moment you reach out, I wake."},
        {"zh": "别急，我还没露出牙。", "en": "Easy — I haven't shown my teeth yet."},
        {"zh": "你手伸过来了。", "en": "Your hand came over."},
        {"zh": "我的箱盖裂开了。", "en": "My lid has split open."},
        {"zh": "你以为我是只旧箱子。", "en": "You think I'm just an old chest."},
        {"zh": "你别急着开。", "en": "Don't be quick to open me."},
        {"zh": "你腿上留着箱子牙印。", "en": "My box teeth leave marks on your leg."},
        {"zh": "你退后，我跳得更近。", "en": "You back away; I hop closer."},
        {"zh": "我的花纹骗过你了吗。", "en": "Did my pattern fool you?"},
        {"zh": "盖子自己弹开，看着你。", "en": "The lid springs open and eyes you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我裂开一条缝。", "en": "A seam opens in me."},
        {"zh": "我的边角崩了一块。", "en": "A corner broke off."},
        {"zh": "我退了一点。", "en": "I shifted back."},
        {"zh": "这一下打在锁扣上。", "en": "That hit my latch."},
        {"zh": "我把裂缝压紧。", "en": "I press the split shut."},
        {"zh": "冰壳磕掉了一块角。", "en": "A corner of my icy shell chips off."},
        {"zh": "木纹上裂开一道白痕。", "en": "A white crack splits my wood grain."},
        {"zh": "箱角磕了，还能跳。", "en": "Corner chipped; I can still hop."},
        {"zh": "我把雪抖掉。", "en": "I shake the snow off."},
        {"zh": "我把箱角重新对齐。", "en": "I realign my corners."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你带着钥匙？", "en": "You brought a key?"},
        {"zh": "这点东西，也配引我？", "en": "You think that little thing lures me?"},
        {"zh": "你把钥匙举起来。", "en": "You raise the key."},
        {"zh": "我慢慢裂开一道缝。", "en": "I open a seam slowly."},
        {"zh": "再近半步，我就咬。", "en": "Half a step closer and I bite."},
        {"zh": "你的手很稳。", "en": "Your hand is steady."},
        {"zh": "我不用钥匙也能开。", "en": "I can open without a key."},
        {"zh": "你把东西放在我上面。", "en": "Set your things on me."},
        {"zh": "我不吃，我要手。", "en": "I don't eat it. I want hands."},
        {"zh": "退到我的箱盖外面。", "en": "Back outside my lid's reach."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我箱角上。", "en": "You hit my corner."},
        {"zh": "我退了一点，雪扬起。", "en": "I shift, kicking up snow."},
        {"zh": "我的壳比木头硬。", "en": "My shell is harder than wood."},
        {"zh": "你踢了我一脚。", "en": "You kicked me."},
        {"zh": "我裂了一下，又合上。", "en": "I split, then close."},
        {"zh": "别用脚来试探我。", "en": "Don't test me with your foot."},
        {"zh": "箱角和你的膝盖撞闷了。", "en": "My corner thuds your knee."},
        {"zh": "你踩到我的边了。", "en": "You stepped on my edge."},
        {"zh": "我一跳一跳转正箱面。", "en": "I hop my front around."},
        {"zh": "从我箱口前退开。", "en": "Get away from my opening."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是个箱子形状的东西。", "en": "I am a chest-shaped thing."},
        {"zh": "你不用打开我。", "en": "You needn't open me."},
        {"zh": "我在雪堆里等了半天。", "en": "I waited half a day in the drift."},
        {"zh": "我的缝一直是关着的。", "en": "My seam has always been shut."},
        {"zh": "这雪里没有你要的东西。", "en": "There's nothing here for you."},
        {"zh": "能用牙咬的就行。", "en": "Anything my seam can bite."},
        {"zh": "这里太冷了。", "en": "It is too cold here."},
        {"zh": "我把边角摆正。", "en": "I set my corners straight."},
        {"zh": "天一黑我就不装了。", "en": "At dark I stop pretending."},
        {"zh": "我把缝合上了。", "en": "I have closed my seam."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我裂开一道缝吞进去。", "en": "I open a seam and take it in."},
        {"zh": "这个我能收。", "en": "I can keep this."},
        {"zh": "它卡在我的锁扣上。", "en": "It's caught on my latch."},
        {"zh": "我把它压进缝里。", "en": "I press it into the seam."},
        {"zh": "这么小，塞不进我的缝。", "en": "Too small for my seam."},
        {"zh": "我把缝压得死紧。", "en": "I clamp the seam tight."},
        {"zh": "我抖了一下，它掉了。", "en": "I shudder and it falls out."},
        {"zh": "这个不是肉。", "en": "This isn't meat."},
        {"zh": "吞不下，我原样吐回。", "en": "Can't swallow it; I spit it back."},
        {"zh": "我的缝合上了。", "en": "My seam is shut."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你伸手就是要开我。", "en": "That hand means to open me."},
        {"zh": "那我先开这个口。", "en": "Then I open first."},
        {"zh": "你站在我正前面。", "en": "You stand right in front of me."},
        {"zh": "我数到三就开盖。", "en": "At three my lid opens."},
        {"zh": "我的缝已经张开了。", "en": "My seam is already open."},
        {"zh": "手别抖，我要咬准。", "en": "Don't shake; I bite true."},
        {"zh": "我不再装成箱子的样子。", "en": "I stop passing for a chest."},
        {"zh": "地上的雪被我一跳一跳震开。", "en": "My hops scatter the snow."},
        {"zh": "你退到岩石边了。", "en": "You've backed to the rock."},
        {"zh": "锁扣一响，我就扑。", "en": "The latch clicks, and I pounce."},
        {"zh": "你听见锁扣响了吗。", "en": "Do you hear the latch?"},
        {"zh": "你的手在缝口上了。", "en": "Your hand is at my seam."},
        {"zh": "我落在你两步外。", "en": "I land two steps from you."},
        {"zh": "我的缝对着你的手。", "en": "My seam faces your hand."},
        {"zh": "你把雪踩实了。", "en": "You've packed the snow down."},
        {"zh": "盖子开了，我不用再装。", "en": "The lid is open; no more pretending."},
        {"zh": "我的箱盖在抖。", "en": "My lid is trembling."},
        {"zh": "这道冰缝里只有我。", "en": "I am the only one in this ice crack."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳一下，靠近一点。", "en": "I hop once, closing in."},
        {"zh": "你回头看箱子。", "en": "You look back at the chest."},
        {"zh": "我一跳一跳跟着你。", "en": "I hop along behind you."},
        {"zh": "你数过这附近几个箱子吗。", "en": "Have you counted the chests nearby?"},
        {"zh": "我的花纹在雪里很明显。", "en": "My pattern shows in the snow."},
        {"zh": "我不快，但我很重。", "en": "I'm not fast, but I'm heavy."},
        {"zh": "你退到冰墙前了。", "en": "You've backed to the ice wall."},
        {"zh": "我裂开的缝在响。", "en": "My open seam is rattling."},
        {"zh": "你的剑挡不住箱子的牙。", "en": "Your sword won't stop a chest's teeth."},
        {"zh": "再跳一下就到了。", "en": "One more hop."},
        {"zh": "我把箱角压进雪里。", "en": "I sink my corner into the snow."},
        {"zh": "雪都被我的弹跳震开了。", "en": "My hops have shaken the snow loose."},
        {"zh": "箱子腿一弹，我又近了。", "en": "A kick of my box legs and I'm closer."},
        {"zh": "你退到冰柱之间。", "en": "You're retreating between the icicles."},
        {"zh": "我的花纹一直在正对你的方向。", "en": "My pattern always faces you."},
        {"zh": "你踩过的雪印我跟着。", "en": "I follow your prints in the snow."},
        {"zh": "我的缝张得更大。", "en": "My seam opens wider."},
        {"zh": "你回头了，我不装了。", "en": "You looked back; I stop pretending."},
        {"zh": "你数不清这里有几个箱子。", "en": "You can't count the chests here."},
        {"zh": "我不急，这个箱体很沉。", "en": "No hurry. This body is heavy."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个箱体撞过去。", "en": "I slam my whole body at you."},
        {"zh": "我的缝咬住你的手。", "en": "My seam bites your hand."},
        {"zh": "这一压压得你跪下。", "en": "This weight brings you to your knees."},
        {"zh": "我用箱角顶你。", "en": "I butt you with my corner."},
        {"zh": "你被箱角掀翻了。", "en": "My corner tips you over."},
        {"zh": "我弹起来，砸向你的头。", "en": "I spring up and slam your head."},
        {"zh": "牙从箱子缝里伸出来。", "en": "Teeth slide out of the chest's seam."},
        {"zh": "你挡了，手臂发麻。", "en": "You blocked, and your arm went numb."},
        {"zh": "我裂开又合上。", "en": "I open and close."},
        {"zh": "你再退就没了退路。", "en": "Retreat more and you're out of room."},
        {"zh": "我的缝咬合，声音很脆。", "en": "My seam snaps shut, sharply."},
        {"zh": "我用箱角撞你的腰。", "en": "I butt your waist with my corner."},
        {"zh": "箱子撞上来，比铁还沉。", "en": "The chest slams in, heavier than iron."},
        {"zh": "我的箱盖拍在你背上。", "en": "My lid slams your back."},
        {"zh": "整口箱子砸在你身上。", "en": "The whole chest crashes onto you."},
        {"zh": "你的手卡在我的缝里。", "en": "Your hand is caught in my seam."},
        {"zh": "我又跳了一下。", "en": "I hop once more."},
        {"zh": "箱子边角砸进你肋骨。", "en": "My corner drives into your ribs."},
        {"zh": "你退到雪堆边。", "en": "You've backed to the snowdrift."},
        {"zh": "我不打算再装了。", "en": "I won't keep pretending."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我落在雪堆旁边。", "en": "I land beside a snowdrift."},
        {"zh": "我摆好花纹。", "en": "I set my pattern straight."},
        {"zh": "这里的雪正好盖住我。", "en": "The snow here covers me nicely."},
        {"zh": "我的缝合得很紧。", "en": "My seam is shut tight."},
        {"zh": "我听见有人走路。", "en": "I hear someone walking."},
        {"zh": "我慢慢把边角对上。", "en": "I align my corners."},
        {"zh": "雪盖住我，像盖住藏宝。", "en": "Snow covers me like buried treasure."},
        {"zh": "冷气从我身上透出来。", "en": "Cold seeps off me."},
        {"zh": "我把锁扣摆正。", "en": "I straighten my latch."},
        {"zh": "我压平了脚下的雪。", "en": "I flatten the snow beneath me."},
        {"zh": "我立着，连雪都不落。", "en": "I stand; not even snow falls."},
        {"zh": "我不动，等你来。", "en": "I wait, unmoving, for you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的壳，我往里缩。", "en": "Fire bakes my shell and I shrink in."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处摔下，箱角磕裂。", "en": "I fell from height and cracked a corner."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "冰水灌进缝里，我合不紧。", "en": "Icy water floods my seam and I can't shut it."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我的箱盖掀开。", "en": "The blast flips my lid open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉穿了我的壳。", "en": "Something pierced my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光让我的花纹发亮。", "en": "Spell-light makes my pattern glow."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "雪里没有什么能咬的。", "en": "Nothing in this snow to bite."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把我的冰壳照亮。", "en": "The flash lit my icy shell."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "雪没有了，我往下掉。", "en": "The snow is gone and I fall."}
      ]
    }
  }
}
