{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着长脸往前走", "en": "I drag my long face forward."},
        {"zh": "身子细，腿更细", "en": "A thin body, thinner legs."},
        {"zh": "我摇摇晃晃，但没停下。", "en": "I sway, but I do not stop."},
        {"zh": "我的嘴始终张着", "en": "My mouth stays open."},
        {"zh": "我贴着下界岩走", "en": "I keep close to the netherrack."},
        {"zh": "脚爪敲着石头", "en": "My claws tap the stone."},
        {"zh": "我朝有热的地方走", "en": "I move toward the heat."},
        {"zh": "我拖着步子走过黑岩。", "en": "I drag my steps across the black rock."},
        {"zh": "影子被岩浆映得发红", "en": "Lava tints my shadow red."},
        {"zh": "我一步一晃地挪", "en": "I lurch forward, step by step."},
        {"zh": "下界还是够热", "en": "The Nether is still hot."},
        {"zh": "我沿着裂隙走", "en": "I walk along the fissure."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在荒地中央", "en": "I stand in the middle of the waste."},
        {"zh": "这张脸一直这样", "en": "This face has always looked this way."},
        {"zh": "这双眼从不合上", "en": "These eyes never close."},
        {"zh": "热风把我的皮肤吹干", "en": "Hot wind dries my skin."},
        {"zh": "我在听谁在走动", "en": "I listen for footsteps."},
        {"zh": "嘴里有腥味的唾液", "en": "My mouth is full of sour spit."},
        {"zh": "我张着嘴，站在岩缝里。", "en": "I stand in the crevice with my mouth open."},
        {"zh": "岩浆的光照着我", "en": "Lava light falls on me."},
        {"zh": "这一带没什么可吃", "en": "Little to eat around here."},
        {"zh": "我歪头看远处", "en": "I tilt my head at the distance."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的脸比我正常", "en": "Your face is more normal than mine."},
        {"zh": "我的眼睛长在你脸上。", "en": "My eyes are fixed on that face of yours."},
        {"zh": "你为什么别扭开头", "en": "Why won't you turn away?"},
        {"zh": "我这张脸不好看", "en": "This face of mine isn't pleasant."},
        {"zh": "你踩进我的热气", "en": "You've stepped into my heat."},
        {"zh": "你在下界不该乱走", "en": "You shouldn't wander the Nether."},
        {"zh": "我闻到你身上的活气", "en": "I smell life on you."},
        {"zh": "你那张脸，比我好看吗。", "en": "Is that face of yours prettier than mine?"},
        {"zh": "我已经张开嘴", "en": "My mouth is open."},
        {"zh": "你退后一步吧", "en": "Take a step back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮肤裂了", "en": "My skin split."},
        {"zh": "这一下打在我脸上", "en": "That hit my face."},
        {"zh": "脖子歪了，我还是转过来。", "en": "My neck is twisted, but I still turn."},
        {"zh": "我退了整半步", "en": "I gave a full half step."},
        {"zh": "别碰我这层皮", "en": "Keep off this hide."},
        {"zh": "这一下钻心疼", "en": "That pain goes deep."},
        {"zh": "我的双腿软了", "en": "My legs went weak."},
        {"zh": "我还站得住呢", "en": "I'm still standing."},
        {"zh": "你做得很不错", "en": "You did well."},
        {"zh": "但你还差得远", "en": "But not enough."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "拿远点，我闻不出好坏。", "en": "Hold it farther; I cannot tell if it is good."},
        {"zh": "我不吃这东西", "en": "I don't eat that."},
        {"zh": "你举得高一点", "en": "Hold it higher."},
        {"zh": "那股味道很陌生", "en": "That smell is unfamiliar."},
        {"zh": "走近点，我看不清", "en": "Come closer; I can't see it well."},
        {"zh": "死的没意思，我要会跑的。", "en": "Dead things bore me; I want one that runs."},
        {"zh": "你手上还有别的味道", "en": "There's another smell on your hands."},
        {"zh": "放地上，然后你退开，我再看。", "en": "Put it down, step back, and I will look."},
        {"zh": "离我实在太远", "en": "Too far."},
        {"zh": "我等着你自己送来", "en": "I'll wait for you to hand it over."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的肩撞上我", "en": "Your shoulder hit me."},
        {"zh": "我身子细，容易被撞歪", "en": "I'm thin; easy to knock askew."},
        {"zh": "这一下让我转了个方向", "en": "That turned me around."},
        {"zh": "退到岩浆外头", "en": "Get away from the lava."},
        {"zh": "我的爪子擦到你了", "en": "My claw scraped you."},
        {"zh": "我们都没受什么伤", "en": "Neither of us is hurt much."},
        {"zh": "我擦着你的肩过去，别多看。", "en": "I brush past your shoulder; do not stare."},
        {"zh": "这下我的脖子更歪了", "en": "Now my neck is even more crooked."},
        {"zh": "再来我就抓你", "en": "Again and I'll claw."},
        {"zh": "给我快点走开", "en": "Go away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这张脸不适合", "en": "This face isn't suited to it."},
        {"zh": "我这张脸，不会有人凑近。", "en": "No one comes close to a face like mine."},
        {"zh": "我只会追和咬", "en": "I only chase and bite."},
        {"zh": "这种事跟我无关", "en": "That has nothing to do with me."},
        {"zh": "别站得那么近", "en": "Don't stand so near."},
        {"zh": "我饿了，不是别的", "en": "I'm hungry, nothing more."},
        {"zh": "这张脸别提这个", "en": "Not with this face."},
        {"zh": "别挡我的热气", "en": "Don't block my heat."},
        {"zh": "我没那种念头", "en": "I've no such thought."},
        {"zh": "往后面挪开去", "en": "Shuffle backwards away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "别抓我的脖子", "en": "Don't grab my neck."},
        {"zh": "我这骨架很轻", "en": "This frame is light."},
        {"zh": "我的爪子会划你", "en": "My claws will scratch you."},
        {"zh": "搁我回下界岩上", "en": "Set me on the netherrack."},
        {"zh": "这样我张不开嘴", "en": "I can't open my mouth like this."},
        {"zh": "腕子别颤成这样", "en": "Don't let your wrist tremble."},
        {"zh": "我不喜欢被拎着", "en": "I dislike being carried."},
        {"zh": "别掐我的颈子", "en": "Don't grip my neck."},
        {"zh": "我嘴里全是牙", "en": "My mouth is all teeth."},
        {"zh": "低些，再低些", "en": "Lower. Lower still."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的脚步乱了套", "en": "Your steps faltered."},
        {"zh": "我已经看见你", "en": "I see you."},
        {"zh": "这张脸对着你了", "en": "This face is turned on you."},
        {"zh": "我的腿细，但跑得快", "en": "Thin legs, but they run."},
        {"zh": "你别退到岩浆边", "en": "Don't back toward the lava."},
        {"zh": "我要喝你的血", "en": "I want your blood."},
        {"zh": "我已经在走了", "en": "I'm already walking."},
        {"zh": "这地方没有藏身处", "en": "Nowhere to hide here."},
        {"zh": "听见了？那是我拖地的脚。", "en": "Heard that? That is my foot dragging."},
        {"zh": "就是这个当口", "en": "Right at this moment."},
        {"zh": "你身上有光，太显眼", "en": "Your light makes you visible."},
        {"zh": "你的位置我记下", "en": "I've kept your position."},
        {"zh": "别出声喊叫啊", "en": "Don't make a sound."},
        {"zh": "这还没完得了", "en": "This isn't over yet."},
        {"zh": "你跑不过我的", "en": "You can't outrun me."},
        {"zh": "你把背露给我了", "en": "You've turned your back to me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我不快走，但一直往前。", "en": "I do not hurry, but I keep coming."},
        {"zh": "我的牙缝里塞着碎石。", "en": "Gravel is wedged between my teeth."},
        {"zh": "你退一步我便快一分", "en": "Each step back speeds me up."},
        {"zh": "岩浆边就是尽头", "en": "The lava is the end of the line."},
        {"zh": "你背后那面岩壁，我看得清。", "en": "That wall of rock behind you, I see it clearly."},
        {"zh": "我没有眼皮，合不上眼。", "en": "I have no lids that could close."},
        {"zh": "这张脸会一直在你眼里", "en": "This face stays in your sight."},
        {"zh": "你的膝盖在打颤，我看见了。", "en": "Your knees are shaking; I can see it."},
        {"zh": "我快到你身边", "en": "Almost."},
        {"zh": "我一口气一口气数", "en": "I count breath by breath."},
        {"zh": "你再挪动一步", "en": "One more step."},
        {"zh": "地下很热，你会先累", "en": "It's hot down here; you'll tire first."},
        {"zh": "就要碰到你了", "en": "Almost touching."},
        {"zh": "别回头找退路", "en": "Don't look back for an exit."},
        {"zh": "我看见你的背了", "en": "I see your back."},
        {"zh": "就这样别乱动", "en": "Just stay like this."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我张开嘴，直接啃下去。", "en": "I open wide and bite straight down."},
        {"zh": "爪子扫过去了", "en": "Claws sweep."},
        {"zh": "这张脸凑得很近", "en": "This face comes close."},
        {"zh": "你向后退去了", "en": "You pulled away."},
        {"zh": "我的牙擦过，只刮破皮。", "en": "My teeth graze and only scrape the skin."},
        {"zh": "再咬你一回吧", "en": "I bite you again."},
        {"zh": "血在下界的石头上", "en": "Blood on netherrack."},
        {"zh": "你的甲不够厚", "en": "Your armor isn't thick enough."},
        {"zh": "你别再挣扎了", "en": "Don't struggle."},
        {"zh": "我会一直追你", "en": "I'll keep chasing."},
        {"zh": "这一下算轻的", "en": "That was a light one."},
        {"zh": "你还站得住呢", "en": "You can still stand."},
        {"zh": "下一口会更重", "en": "The next bite is heavier."},
        {"zh": "都已经结束了", "en": "Finished."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从荒地那边过来", "en": "I come from across the waste."},
        {"zh": "这张脸先出现了", "en": "This face appeared first."},
        {"zh": "下界多了一个", "en": "The Nether has one more."},
        {"zh": "热风把我推醒", "en": "Hot wind pushed me awake."},
        {"zh": "我嗅到了，下界的风里有活人。", "en": "I smell it; the Nether wind carries the living."},
        {"zh": "这里的岩壁挡住风", "en": "The rock walls block the wind."},
        {"zh": "我在找活的东西", "en": "I'm looking for something alive."},
        {"zh": "岩浆照亮了我", "en": "Lava lit me up."},
        {"zh": "地上留着脚印", "en": "Footprints on the ground."},
        {"zh": "我慢慢地抬脚", "en": "I lift a foot slowly."},
        {"zh": "我还没吃东西", "en": "I haven't eaten."},
        {"zh": "这地方我喜欢", "en": "I like this place."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我的皮肤发焦", "en": "The fire scorched my skin."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从岩台上摔下去", "en": "I fell off the ledge."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "这水不像岩浆，冷得慌", "en": "This water isn't lava; it's cold."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我甩到岩壁上", "en": "The blast threw me against the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那根东西钉在肩里", "en": "That thing is pinned in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让我头晕", "en": "The spell makes my head spin."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我手都在抖", "en": "Hunger makes my hands shake."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷在这里很少见", "en": "Thunder is rare here."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空比下界还空", "en": "The void is emptier than the Nether."}
      ]
    }
  }
}
