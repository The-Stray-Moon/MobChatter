{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着沙面爬", "en": "I crawl close to the sand."},
        {"zh": "八条腿一起动", "en": "Eight legs move together."},
        {"zh": "尾巴在后面翘着", "en": "My tail arches behind me."},
        {"zh": "石缝里我爬得很稳", "en": "I crawl steadily through stone cracks."},
        {"zh": "我这身体很扁", "en": "My body is very flat."},
        {"zh": "我从砖缝里穿过去", "en": "I slip through the gap in the bricks."},
        {"zh": "爬一段，停一下", "en": "Crawl a stretch, pause."},
        {"zh": "风一吹，我就缩回去", "en": "A gust of wind and I pull back."},
        {"zh": "地上的影子很小", "en": "My shadow is tiny."},
        {"zh": "我走得不快，但会一直走", "en": "Not fast, but I keep going."},
        {"zh": "我在沙土上找地方", "en": "I'm looking for a spot in the sandy soil."},
        {"zh": "钳子在前，尾巴在后", "en": "Claws in front, tail behind."},
        {"zh": "我慢慢绕过石头", "en": "I slowly go around the stone."},
        {"zh": "夜里我才出来走动", "en": "I only come out at night."},
        {"zh": "影子挪一寸，我也挪一寸", "en": "The shadow moves an inch, and so do I"},
        {"zh": "我身上是褐色的", "en": "I'm brown all over."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着一动不动", "en": "I lie still."},
        {"zh": "我的尾巴卷起来了", "en": "My tail curls up."},
        {"zh": "我太小，没人注意", "en": "I'm too small to notice."},
        {"zh": "石头底下是我的窝", "en": "My nest is under the stone."},
        {"zh": "我在等虫子路过", "en": "I'm waiting for a bug to pass."},
        {"zh": "我的壳在反光", "en": "My shell catches light."},
        {"zh": "我钳子收在胸前", "en": "I keep my claws folded in front."},
        {"zh": "这片地方很干", "en": "This spot is dry."},
        {"zh": "我活不了多久", "en": "I won't live long."},
        {"zh": "谁踩到我，我也没办法", "en": "If someone steps on me, there's nothing I can do."},
        {"zh": "我在抬头看天", "en": "I'm looking at the sky."},
        {"zh": "我不需要做任何事", "en": "I don't need to do anything."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你实在太大了", "en": "You're too big."},
        {"zh": "我要躲到石头下面", "en": "I'll hide under the stone."},
        {"zh": "我的尾巴有毒，可我不用", "en": "My tail is venomous, but I won't use it."},
        {"zh": "你踩下来，我就没了", "en": "Step down and I'm gone."},
        {"zh": "我不主动，我怕", "en": "I don't start anything; I'm afraid."},
        {"zh": "你手上的影子把我盖住了", "en": "Your hand's shadow covers me."},
        {"zh": "我能爬上这面墙", "en": "I can climb walls."},
        {"zh": "你别动，我自己走", "en": "Hold still; I'll move myself."},
        {"zh": "我这点大小，伤不了你", "en": "My size can't hurt you."},
        {"zh": "你在看一只蝎子", "en": "You're looking at a scorpion."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被踩得有点扁", "en": "I've been pressed a bit flat."},
        {"zh": "背甲被踩出一道裂口", "en": "A crack splits across my back plate"},
        {"zh": "我被翻了个身", "en": "I'm on my back."},
        {"zh": "我腿掉了一条", "en": "I lost a leg."},
        {"zh": "这点疼，我受着", "en": "I bear this much pain."},
        {"zh": "我把尾巴卷到背上", "en": "I curl my tail over my back."},
        {"zh": "我往石缝里钻", "en": "I burrow into the crack."},
        {"zh": "我只能慢慢爬", "en": "I crawl slowly."},
        {"zh": "这一下，我半天动不了", "en": "After that I can't move for a while."},
        {"zh": "这么小，我还没死", "en": "Small as I am, I'm not dead."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这比我这只还大", "en": "That's bigger than I am."},
        {"zh": "这点东西太大了", "en": "That's too big for me."},
        {"zh": "我专吃小虫子", "en": "I eat small bugs."},
        {"zh": "你放下，我就闻闻", "en": "Put it down and I'll sniff."},
        {"zh": "我其实没那么饿", "en": "I'm not that hungry."},
        {"zh": "这味道太冲了", "en": "That smell's too sharp."},
        {"zh": "我只吃活虫子", "en": "I only eat living things."},
        {"zh": "别用钳子能夹的东西试我", "en": "Don't try me with things my claws can hold."},
        {"zh": "我躲得远一些", "en": "I'll keep my distance."},
        {"zh": "这口我咬不下", "en": "I can't take a bite of that."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被你撞翻了", "en": "You knocked me upside down."},
        {"zh": "我这么小，一碰就滚", "en": "I'm small; one touch and I roll."},
        {"zh": "你的鞋底把我整个盖住", "en": "Your sole blots out all of me"},
        {"zh": "我赶紧爬起来", "en": "I scramble up."},
        {"zh": "这一下，我掉了半条腿", "en": "That cost me half a leg."},
        {"zh": "我跑不了多远", "en": "I can't run far."},
        {"zh": "我缩进石缝里", "en": "I shrink into the crack."},
        {"zh": "你踩到我旁边了", "en": "You stepped right beside me."},
        {"zh": "沙被我蹭出个印", "en": "I scuff a mark in the sand."},
        {"zh": "你别碰我这只", "en": "Don't touch me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这么小，没想过", "en": "I'm so small; haven't thought about it."},
        {"zh": "石头下面还有别的", "en": "There are others under the stones."},
        {"zh": "我们各自躲着", "en": "We each hide alone."},
        {"zh": "这一带虫子不多", "en": "Few bugs around here."},
        {"zh": "你问这个，我很紧张", "en": "You asking makes me nervous."},
        {"zh": "我活不过这个季节", "en": "I won't outlive the season."},
        {"zh": "沙里什么也看不见", "en": "You can't see anything in the sand."},
        {"zh": "我钳子都举起来了", "en": "I've raised both my claws."},
        {"zh": "你别再说了吧", "en": "Say no more."},
        {"zh": "我这就要走了", "en": "I'm going."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这虫子太小了", "en": "This bug is too small."},
        {"zh": "钳子一合，就夹住了", "en": "One snap of the claw and it's held."},
        {"zh": "这个我拖不动", "en": "I can't drag this."},
        {"zh": "地上有点碎屑", "en": "Some crumbs on the ground."},
        {"zh": "我拿着走两步就掉了", "en": "I carry it two steps and drop it."},
        {"zh": "它钻进沙里了", "en": "It burrowed into the sand."},
        {"zh": "钳子夹这个太浪费", "en": "Wasting a claw on that, no."},
        {"zh": "这一块实在太大了", "en": "Too big."},
        {"zh": "我放在石头下面", "en": "I put it under the stone."},
        {"zh": "留给别个虫子吃", "en": "Leave it for others."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有只虫子正从砖缝里出来", "en": "A bug is just now coming out of the brick seam"},
        {"zh": "石缝里我看见它了", "en": "I see it through the stone gap."},
        {"zh": "我八条腿慢慢过", "en": "I go on eight legs, slowly."},
        {"zh": "石头的那一边", "en": "Past the stone."},
        {"zh": "这个不大，我能对付", "en": "It's small; I can handle it."},
        {"zh": "我贴着地面走", "en": "I keep low."},
        {"zh": "它背对着我，正是时候", "en": "Its back is to me, and the moment is right"},
        {"zh": "就差那么几步", "en": "Just a few steps."},
        {"zh": "这个方向是对的", "en": "Right way."},
        {"zh": "我停下来看看", "en": "I stop to check."},
        {"zh": "再近一步，我就能扎到", "en": "One step closer and I can sting"},
        {"zh": "我把钳子抬起", "en": "I raised a claw."},
        {"zh": "它就在那儿动着", "en": "It's moving."},
        {"zh": "我压低身子，从石头后绕出去", "en": "I flatten down and slip out from behind the stone"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我把两只钳子收得更低", "en": "I tuck both pincers lower to the ground"},
        {"zh": "它个头比我大", "en": "It's bigger than me."},
        {"zh": "我还是爬上去", "en": "I'll go anyway."},
        {"zh": "背后有石头挡着", "en": "The stone blocks behind me."},
        {"zh": "我尾巴翘起来了", "en": "My tail arches up."},
        {"zh": "它把身子转过去", "en": "It turned around."},
        {"zh": "我退一下再上", "en": "I back off and try again."},
        {"zh": "这沙子松得很", "en": "The sand is too loose."},
        {"zh": "我的腿陷下去一点", "en": "My legs sink a little."},
        {"zh": "贴地爬，就这样", "en": "Low to the ground; this way."},
        {"zh": "我再爬近一寸", "en": "One inch nearer."},
        {"zh": "我钳子张开了", "en": "My claws open."},
        {"zh": "它是跑不掉的", "en": "It can't get away."},
        {"zh": "我尾巴翘好了", "en": "My tail is raised."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用钳子去夹", "en": "I pinch with a claw."},
        {"zh": "尾巴扎了一下", "en": "My tail jabs once."},
        {"zh": "我这点毒，扎一下", "en": "One jab of my little venom."},
        {"zh": "它被我夹住了腿", "en": "I caught its leg."},
        {"zh": "我赶紧退回去", "en": "I hurry back."},
        {"zh": "毒我用得很少", "en": "I use venom very sparingly."},
        {"zh": "它把我甩开了", "en": "It shook me off."},
        {"zh": "我又钳了一下", "en": "I pinch again."},
        {"zh": "钳尖只在你皮上划了一道", "en": "My pincer only scored a line across your hide"},
        {"zh": "我躲回石头下", "en": "I duck back under the stone."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "石头底下多了一只", "en": "One more under the stone."},
        {"zh": "沙粒底下钻出一只小蝎子", "en": "A little scorpion works its way out of the sand"},
        {"zh": "这地方够干的", "en": "This place is dry enough."},
        {"zh": "我躲到砖缝里", "en": "I hide in the brick gap."},
        {"zh": "地上有我爬过的痕", "en": "There's a trail where I crawled."},
        {"zh": "我怕，但我会待着", "en": "I'm afraid, but I'll stay."},
        {"zh": "这里虫子应该不少", "en": "There should be bugs here."},
        {"zh": "我抬头看了下", "en": "I glanced up."},
        {"zh": "我先找个石头", "en": "First, a stone to hide under."},
        {"zh": "谁都不会注意到我", "en": "No one will notice me."}
      ]
    },
