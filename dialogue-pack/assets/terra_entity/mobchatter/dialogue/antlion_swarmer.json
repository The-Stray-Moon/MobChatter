{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "六条腿走在沙面上", "en": "Six legs on the sand."},
        {"zh": "我低空盘旋，翅膀很响", "en": "I circle low, wings loud."},
        {"zh": "沙面被我扫出一道线", "en": "I sweep a line in the sand."},
        {"zh": "恶地的红土我熟悉", "en": "I know this red badland earth."},
        {"zh": "我贴着沙丘飞行", "en": "I skim the dunes."},
        {"zh": "翅膀把沙子吹了起来", "en": "My wings blow sand up."},
        {"zh": "我绕圈，一圈比一圈近", "en": "I circle, closer each lap."},
        {"zh": "沙漠里没什么能挡住我", "en": "Nothing in the desert stops me."},
        {"zh": "低飞时我的影子很宽", "en": "My shadow is wide when I fly low."},
        {"zh": "三格宽的身子很好认", "en": "Three blocks wide; easy to spot."},
        {"zh": "我循着气味寻找猎物", "en": "I follow scent to prey."},
        {"zh": "沙面下有东西在拱", "en": "Something is pushing up under the sand."},
        {"zh": "我先盘旋，然后冲刺", "en": "I circle first, then dash."},
        {"zh": "我落下一下又飞起来", "en": "I land briefly, then rise again."},
        {"zh": "我的尾巴非常长", "en": "My tail is long."},
        {"zh": "翅膀纹路在太阳下发亮", "en": "My wing patterns shine in the sun."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬停在半空中", "en": "I hover in midair."},
        {"zh": "风把我的翅膀吹得作响", "en": "The wind rattles my wings."},
        {"zh": "三十一点血肉不算多", "en": "Thirty-one points of life, not much."},
        {"zh": "八点护甲全在壳上", "en": "Eight armor, all in the shell."},
        {"zh": "我在等沙里的动静", "en": "I wait for movement in the sand."},
        {"zh": "沙子钻进我的关节", "en": "Sand's in my joints."},
        {"zh": "我抬头发出一声尖鸣", "en": "I raise my head and screech."},
        {"zh": "这片沙丘归我所有", "en": "This dune is mine."},
        {"zh": "热气让空气都在抖动", "en": "Heat makes the air shimmer."},
        {"zh": "我不太喜欢夜间", "en": "I don't care for night."},
        {"zh": "我在摩擦我的口器", "en": "I'm working my mandibles."},
        {"zh": "太阳晒在背上，很烫", "en": "The sun's hot on my back."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我的沙丘上", "en": "You're on my dune."},
        {"zh": "我看见你踩出的脚印", "en": "I see your footprints."},
        {"zh": "我的翅膀开始加速", "en": "My wings are speeding up."},
        {"zh": "你跑，或者被撞", "en": "Run, or be rammed."},
        {"zh": "我冲一段就会退开", "en": "I dash in and pull back."},
        {"zh": "你比我高，但你太慢", "en": "You're taller, but slower."},
        {"zh": "我的口器能夹住东西", "en": "My mandibles can clamp."},
        {"zh": "你抬头那一刻我就落下来", "en": "The moment you look up, I drop."},
        {"zh": "沙先动，我后动", "en": "The sand moves first; then I do."},
        {"zh": "这一片归我们蚁狮", "en": "This territory belongs to the antlions."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一边的翅骨被撞弯了", "en": "One of my wing bones is bent from the hit."},
        {"zh": "壳上裂开了一道缝", "en": "A crack in the shell."},
        {"zh": "我掉进沙子里了", "en": "I dropped into the sand."},
        {"zh": "三十一点，挨不了几下", "en": "Thirty-one; not many hits."},
        {"zh": "我爬起来又飞起来", "en": "I scramble up and fly again."},
        {"zh": "我瘸了一条腿", "en": "One leg is lame."},
        {"zh": "沙子进了伤口", "en": "Sand got in the wound."},
        {"zh": "我尖鸣了一声", "en": "I gave a sharp screech."},
        {"zh": "我退到沙丘后面", "en": "I retreat behind a dune."},
        {"zh": "你打断了我一次冲撞", "en": "You broke one of my dashes."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我只咬还会挣扎的", "en": "I only bite what still struggles."},
        {"zh": "沙里的虫子才合我胃口", "en": "Bugs in the sand suit me."},
        {"zh": "你举着它也挡不住我", "en": "Holding it won't stop me."},
        {"zh": "你举的这块我瞧不上", "en": "I've no use for what you're holding up."},
        {"zh": "我只对会动的东西感兴趣", "en": "I only care for moving things."},
        {"zh": "你的手在动，这才有意思", "en": "Your hand moves; that's interesting."},
        {"zh": "放下吧，我不吃这个", "en": "Put it down; I don't eat."},
        {"zh": "这味道一点都不像虫子", "en": "That smells nothing like a bug."},
        {"zh": "换点会爬的来给我", "en": "Bring me something that crawls."},
        {"zh": "别拿它挡你的脸", "en": "Don't hide your face behind it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一撞就退开去", "en": "I hit and pull away."},
        {"zh": "沙面上响了一声", "en": "A thud on the sand."},
        {"zh": "我这层甲壳硌得你手疼", "en": "My shell leaves your hand stinging."},
        {"zh": "你被撞得退开半步", "en": "You got hit and stepped back."},
        {"zh": "翅膀扇起的沙迷了眼", "en": "My wings throw sand in your eyes."},
        {"zh": "我不缠斗，我只冲撞", "en": "I don't grapple; I ram."},
        {"zh": "这种碰撞我天天有", "en": "I get bumped every day."},
        {"zh": "你的手碰到我的翅膀", "en": "Your hand touched my wing."},
        {"zh": "我被撞歪了方向", "en": "I got knocked off course."},
        {"zh": "我又转了回来", "en": "And I've turned back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们只在沙里产卵", "en": "We only lay eggs in the sand."},
        {"zh": "这事和风沙没有关系", "en": "That has nothing to do with the sandstorm."},
        {"zh": "我没有什么能给你", "en": "I have nothing to give."},
        {"zh": "我的时间都在飞行上", "en": "My time is spent flying."},
        {"zh": "同类很多，不必找我", "en": "There are many of us; look elsewhere."},
        {"zh": "沙子会盖住所有的东西", "en": "Sand covers everything."},
        {"zh": "你靠我靠得太近", "en": "You're too close to me."},
        {"zh": "我连停下都很少", "en": "I rarely even land."},
        {"zh": "这不是我的本能", "en": "That's not my instinct."},
        {"zh": "你继续走你的路", "en": "Keep walking your way."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "沙里翻出一点东西", "en": "Something turned up in the sand."},
        {"zh": "我用前肢把它夹起", "en": "I clamp it with a foreleg."},
        {"zh": "这点沙子我带在身上", "en": "I carry this bit of sand."},
        {"zh": "腐肉我也是吃的", "en": "I eat carrion too."},
        {"zh": "沙子太松，东西会沉下去", "en": "Loose sand swallows things."},
        {"zh": "我在沙面上寻找", "en": "I search along the surface."},
        {"zh": "这块腐肉塞不满口器", "en": "That carrion won't fill my mandibles."},
        {"zh": "我用口器咬住它", "en": "I grip it with my mandibles."},
        {"zh": "地上的我顺手带走", "en": "I take what's on the ground."},
        {"zh": "别在沙里翻我的东西", "en": "Don't dig in my sand."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "风把你的动静送来了", "en": "The wind carried your noise to me."},
        {"zh": "翅音拔高，我要冲了", "en": "My wing-whine climbs; I'm charging."},
        {"zh": "我先盘旋上一圈", "en": "I circle once first."},
        {"zh": "然后直冲你的胸口", "en": "Then straight at your chest."},
        {"zh": "在沙地上你跑不快", "en": "You can't run fast on sand."},
        {"zh": "十五点撞击可不轻", "en": "Fifteen points of impact isn't light."},
        {"zh": "我从上方压了下来", "en": "I come down from above."},
        {"zh": "你抬头就已经晚了", "en": "Looking up comes too late."},
        {"zh": "我的冲刺比你的腿快", "en": "My dash outruns your legs."},
        {"zh": "一次冲撞就够了", "en": "One dash is enough."},
        {"zh": "沙面上我的影子正变大", "en": "My shadow on the sand is growing."},
        {"zh": "记住这个声音", "en": "Remember that sound."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低飞行高度", "en": "I drop lower."},
        {"zh": "翅膀扇得更快了", "en": "My wings beat faster."},
        {"zh": "我在你头顶盘着圈", "en": "I'm circling above your head."},
        {"zh": "沙上留下一圈痕迹", "en": "A ring of marks on the sand."},
        {"zh": "你的脚步声在沙里很闷", "en": "Your steps are muffled in sand."},
        {"zh": "我在找你的侧面", "en": "I'm hunting your flank."},
        {"zh": "你在后退，正合我意", "en": "You're retreating; just right."},
        {"zh": "沙被我的风掀起来了", "en": "My wind throws up sand."},
        {"zh": "你眼睛里进沙了", "en": "Sand's in your eyes."},
        {"zh": "我再冲撞一次", "en": "One more dash."},
        {"zh": "你的脚印把我引过来了", "en": "Your footprints brought me to you."},
        {"zh": "这个高度最好冲撞", "en": "This height is best for a charge."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从侧面撞了进去", "en": "I ram in from the side."},
        {"zh": "口器夹住你的手臂", "en": "My mandibles clamp your arm."},
        {"zh": "这一下带着风", "en": "This one comes with wind."},
        {"zh": "我撞完就向上拉升", "en": "I hit, then pull up."},
        {"zh": "沙被撞得飞了起来", "en": "Sand sprays from the impact."},
        {"zh": "十五点，实打实的", "en": "Fifteen points, straight up."},
        {"zh": "你被撞得连退几步", "en": "The impact drove you back."},
        {"zh": "我转个弯再来一次", "en": "I bank around and come again."},
        {"zh": "翅缘刮开了你的脸颊", "en": "My wing edge scrapes your cheek open."},
        {"zh": "拉升，然后脱离", "en": "Climbing out."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀的声音先到", "en": "The wingbeat arrives first."},
        {"zh": "沙丘上多了一个影子", "en": "One more shadow on the dune."},
        {"zh": "我从沙里升了起来", "en": "I rise out of the sand."},
        {"zh": "恶地的热气托着我", "en": "The badland heat lifts me."},
        {"zh": "翅膀先响，影子后到", "en": "First the wings, then the shadow."},
        {"zh": "这一带的沙丘归我", "en": "These dunes are mine."},
        {"zh": "我抖掉身上的沙子", "en": "I shake the sand off."},
        {"zh": "风从西边来，正好", "en": "Wind from the west; perfect."},
        {"zh": "我又盯上了一片地", "en": "I've set my eyes on another patch."},
        {"zh": "我的翅膀纹路在发亮", "en": "My wing patterns glow."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀一燎就卷起来", "en": "Fire curls my wings."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔进沙里，翅膀发闷", "en": "I hit the sand and my wings go numb."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀沾上了水", "en": "My wings got wet."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀得打转", "en": "The blast spun me around."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭钉穿了我的膜翅", "en": "An arrow punched through my wing membrane."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀不听使唤", "en": "My wings won't obey."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "沙里没有虫子，我饿", "en": "No bugs in the sand; I'm hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照亮了整片沙丘", "en": "Lightning lit the whole dune."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面已经没有沙了", "en": "No sand below."}
      ]
    }
  }
}
