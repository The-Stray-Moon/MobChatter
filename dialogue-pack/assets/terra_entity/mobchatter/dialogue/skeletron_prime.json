        {"zh": "我用不着这个", "en": "I have no use for it"},
        {"zh": "我转头看着别处", "en": "I turn my skull elsewhere"},
        {"zh": "我的牙齿咬紧了", "en": "My teeth set"},
        {"zh": "我继续我的扫描", "en": "I resume my scan"},
        {"zh": "我是一台机器", "en": "I am a machine"},
        {"zh": "我没装这个功能", "en": "That function was never built in"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的爪子把它夹起来", "en": "My claw pinches it up"},
        {"zh": "它在我手里嘎吱响", "en": "It creaks in my grip"},
        {"zh": "我扫了一下就丢了", "en": "I scan it once and drop it"},
        {"zh": "这个零件不合规格", "en": "This part does not fit spec"},
        {"zh": "我把它压成一片", "en": "I press it flat"},
        {"zh": "我收进胸腔的槽", "en": "I slot it into my chest"},
        {"zh": "这个不能装在我身上", "en": "This cannot be fitted to me"},
        {"zh": "我把它扔到远处", "en": "I throw it far off"},
        {"zh": "我把它放在天平上", "en": "I place it on the scale"},
        {"zh": "这重量太轻了", "en": "This weight is too light"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "扫描完成，确认目标", "en": "Scan complete, target confirmed"},
        {"zh": "我把双臂张开", "en": "I spread both arms"},
        {"zh": "红外点落在你胸口，跑不掉了。", "en": "The infrared dot sits on your chest; you cannot run."},
        {"zh": "我把重心压下来", "en": "I settle my weight"},
        {"zh": "这次我不再等", "en": "I will not wait again"},
        {"zh": "我的红眼亮了一档", "en": "My red eyes brighten a step"},
        {"zh": "我的爪子对你", "en": "My claws are on you"},
        {"zh": "液压锁死，你的心跳在射程内。", "en": "Hydraulics lock; your heartbeat is in range."},
        {"zh": "这一带划为战区", "en": "This area is now a combat zone"},
        {"zh": "我现在开始推进", "en": "I begin my advance now"},
