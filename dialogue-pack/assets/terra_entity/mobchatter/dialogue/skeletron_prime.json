{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的铁骨一节节转", "en": "My iron bones turn joint by joint"},
        {"zh": "蒸汽从我肩缝里冒", "en": "Steam leaks from my seams"},
        {"zh": "我碾过碎石往前走", "en": "I grind over the rubble"},
        {"zh": "我的齿轮咬着响", "en": "My gears bite and whine"},
        {"zh": "我每一步都落得很实", "en": "Every step lands solid"},
        {"zh": "我从烟里压过来", "en": "I press through the smoke"},
        {"zh": "我的爪子在石上刮", "en": "My claws scrape the stone"},
        {"zh": "我把挡路的残墙撞倒", "en": "I knock a broken wall aside"},
        {"zh": "我转向你所在的方位", "en": "I swing toward your bearing"},
        {"zh": "我的关节咔一咔", "en": "My joints snap into place"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着也发着响", "en": "I hover, and still I clank"},
        {"zh": "我的眼窝里是两个红点", "en": "Two red points sit in my sockets"},
        {"zh": "我慢慢校准方向", "en": "I recalibrate slowly"},
        {"zh": "我的钢牙咬在一起", "en": "My steel teeth grit"},
        {"zh": "我听到自己内部的嗡鸣", "en": "I hear the hum inside me"},
        {"zh": "我没有血肉可以累", "en": "No flesh to tire"},
        {"zh": "我把一只爪收紧", "en": "I clench one claw"},
        {"zh": "我的肋骨排得像栅栏", "en": "My ribs line up like a fence"},
        {"zh": "我在等你动手", "en": "I wait for you to act"},
        {"zh": "我的头颅微微偏了偏", "en": "My skull tips slightly"},
        {"zh": "我的肩甲上有一道旧痕", "en": "There is an old scar on my shoulder"},
        {"zh": "我缓缓张开双臂", "en": "I open both arms slowly"},
        {"zh": "我的铁腿一动不动", "en": "My iron legs hold still"},
        {"zh": "我在计算下一步", "en": "I am computing the next move"},
        {"zh": "蒸汽在我背后散开", "en": "Steam blooms behind me"},
        {"zh": "我整副骨架都静着", "en": "My whole frame goes quiet"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把红眼睛对准你", "en": "I fix my red eyes on you"},
        {"zh": "你在我扫描的范围里", "en": "You are inside my scanning range"},
        {"zh": "传感器读出你的心跳在加速。", "en": "My sensors read your pulse speeding up."},
        {"zh": "我低下铁颅看你", "en": "I lower my iron skull at you"},
        {"zh": "你这身皮肉太柔软", "en": "Too much soft flesh on you"},
        {"zh": "我的爪子在收紧", "en": "My claws are tightening"},
        {"zh": "你的位置已记录", "en": "Your position is recorded"},
        {"zh": "我朝你倾了倾身", "en": "I lean toward you"},
        {"zh": "你的武器划不进去", "en": "Your weapon will not cut deep"},
        {"zh": "我的红眼扫过你的手", "en": "My red eyes sweep your hands"},
        {"zh": "我调整了扫描的角度", "en": "I adjust my scanning angle"},
        {"zh": "你不值得第二次扫描", "en": "You are not worth a second scan"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的一块铁甲凹了", "en": "A plate of my iron dents"},
        {"zh": "我向后退一步", "en": "I take one step back"},
        {"zh": "齿轮咬了一下，随即恢复转动。", "en": "A gear catches, then resumes turning."},
        {"zh": "这一下有点力度", "en": "That one carried force"},
        {"zh": "我重新咬合关节", "en": "I re-seat my joints"},
        {"zh": "我的蒸汽漏了一股", "en": "A jet of steam escapes"},
        {"zh": "我重新锁定你", "en": "I reacquire you"},
        {"zh": "装甲凹了一点，运转照旧。", "en": "A small dent in the armor; everything still runs."},
        {"zh": "我的铁骨还在", "en": "My iron bones still hold"},
        {"zh": "我开始加速运转", "en": "I spin up my systems"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有进食程序", "en": "I have no feeding routine"},
        {"zh": "你把东西放我面前也没用", "en": "Placing it before me does nothing"},
        {"zh": "我连唾液都没有", "en": "I do not even have saliva"},
        {"zh": "这东西不在我的清单上", "en": "This is not on my list"},
        {"zh": "我扫了它一眼就丢开", "en": "I scan it once and dismiss it"},
        {"zh": "我的齿轮不吃你手里那东西。", "en": "My gears do not eat what is in your hand."},
        {"zh": "我只需要燃料，不需要食物", "en": "I need fuel, not food"},
        {"zh": "我把它推到地上", "en": "I push it to the ground"},
        {"zh": "我没有消化这种东西的部分", "en": "I have no part that digests this"},
        {"zh": "你别一直举着它", "en": "Stop holding it up"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的骨头撞上我的钢肋，响了。", "en": "Your bones crack against my steel ribs."},
        {"zh": "我的铁架动都不动", "en": "My iron frame does not stir"},
        {"zh": "你被铁架弹开", "en": "The iron frame throws you off"},
        {"zh": "我的腿上连痕都没有", "en": "Not a mark on my leg"},
        {"zh": "碰撞声在金属里回响", "en": "The knock rings in the metal"},
        {"zh": "我的关节重新咬合", "en": "My joints re-seat themselves"},
        {"zh": "你退开三步才站住", "en": "You need three steps to stop"},
        {"zh": "我的铁架一点没偏", "en": "The iron frame does not shift"},
        {"zh": "你的手震得发麻", "en": "Your hands go numb from it"},
        {"zh": "我把他顶回原地", "en": "I push you back where you stood"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "图纸上没有繁殖这一项。", "en": "There is no such feature on my blueprint."},
        {"zh": "我的名字只是个型号", "en": "My name is just a model number"},
        {"zh": "我只剩下任务", "en": "All I have left is the task"},
