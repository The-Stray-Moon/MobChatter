    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一格一格压过去", "en": "I advance mark by mark"},
        {"zh": "你往左，我的爪也在左", "en": "You go left, my claw follows"},
        {"zh": "我的锁定没有丢", "en": "My lock has not broken"},
        {"zh": "你再快也快不过我的计算", "en": "You cannot outrun my calculations"},
        {"zh": "我预判了你的闪身", "en": "I predicted your dodge"},
        {"zh": "你在后退，我看到了", "en": "You are retreating, I see it"},
