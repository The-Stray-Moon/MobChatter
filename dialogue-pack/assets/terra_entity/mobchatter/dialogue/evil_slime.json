{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我每跳一下，黏液里就冒个泡。", "en": "With every hop a bubble rises in my slime."},
        {"zh": "落地时身体摊成一片。", "en": "On landing I spread flat."},
        {"zh": "我的胶体里有些杂质。", "en": "There is grit inside my gel."},
        {"zh": "我弹起来，落下，又弹起。", "en": "Up, down, up again."},
        {"zh": "我朝你那边一跳。", "en": "I hop your way."},
        {"zh": "地面被我的黏液打湿。", "en": "My slime wets the ground."},
        {"zh": "我绕过石头，弹了两下。", "en": "I bounce twice around a stone."},
        {"zh": "我跳动时里面东西在晃。", "en": "Something sloshes as I bounce."},
        {"zh": "我压扁了自己，钻进缝里。", "en": "I flatten and squeeze through a gap."},
        {"zh": "每跳一次，我发出噗的一声。", "en": "Every hop makes a wet sound."},
        {"zh": "我不快，但一直往前。", "en": "Not quick. Always forward."},
        {"zh": "我弹到墙边，又折回来。", "en": "I bounce off a wall and come back."},
        {"zh": "我的身体在地上留了印。", "en": "My body leaves a mark."},
        {"zh": "我朝有光的地方跳。", "en": "I hop toward the light."},
        {"zh": "我滚了一下，爬起来。", "en": "I roll, then right myself."},
        {"zh": "黏液挂在我身后。", "en": "Slime trails behind me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲着，慢慢地颤。", "en": "I squat and quiver slowly."},
        {"zh": "我吞下的那块腐肉还在化。", "en": "The rotten meat I swallowed is still dissolving."},
        {"zh": "我在吸收地上的水分。", "en": "I absorb water from the ground."},
        {"zh": "四面八方都是我，也很难说。", "en": "I am all sides at once. Hard to say."},
        {"zh": "我在盯着你的影子。", "en": "I am fixed on your shadow."},
        {"zh": "我里面有些东西在动。", "en": "Something moves inside me."},
        {"zh": "我慢慢收缩，又张开。", "en": "I contract and expand."},
        {"zh": "黏液滴下来，黏在地上。", "en": "Slime drips and sticks."},
        {"zh": "我在这里等一个东西路过。", "en": "I wait for something to pass."},
        {"zh": "我的表面映着火光。", "en": "Firelight shows on my surface."},
        {"zh": "我安静的时候也在渗。", "en": "Even still, I seep."},
        {"zh": "墙根的霉斑是我留下的。", "en": "The mildew at the wall's foot is my trail."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体里裹着半截旧骨头。", "en": "Half an old bone is wrapped inside my body."},
        {"zh": "我看起来很软，其实很黏。", "en": "I look soft. I am sticky."},
        {"zh": "我往你靴子那边渗过去。", "en": "I seep toward your boots."},
        {"zh": "别用手推我，推不开。", "en": "Do not push. It will not work."},
        {"zh": "我一碰到你，你就会疼。", "en": "One touch and you hurt."},
        {"zh": "这片地现在滑了。", "en": "This ground is slick now."},
        {"zh": "你退开，黏液会跟着。", "en": "Back off. The slime follows."},
        {"zh": "我不用牙齿，用身体。", "en": "No teeth. I use my body."},
        {"zh": "你的靴子上全是我的部分。", "en": "Your boots are covered in me."},
        {"zh": "我慢慢地朝你滚过去。", "en": "I roll toward you slowly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "五十八点血，跳一下就少一块。", "en": "Fifty-eight health, and a corner comes off."},
        {"zh": "我缩回去，又鼓起来。", "en": "I shrink and swell back."},
        {"zh": "我这团黏液，五十八点还要跳。", "en": "Fifty-eight points of goo keeps hopping."},
        {"zh": "我抖了很久才稳住。", "en": "I wobble a long while."},
        {"zh": "这一下，我变薄了。", "en": "That thinned me."},
        {"zh": "我一跳一撞，黏液还黏着。", "en": "I hop and strike, my gel still sticky."},
        {"zh": "掉下去的部分还在爬。", "en": "The lost part still crawls."},
        {"zh": "我慢下来了，更慢了。", "en": "I slow further."},
        {"zh": "我吸了点土，补回来。", "en": "I take in soil and mend."},
        {"zh": "你一打，我黏得更紧。", "en": "The more you strike, the tighter I cling."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这块果冻，和我是同类吗？", "en": "Is this jelly one of my kind?"},
        {"zh": "你把东西放下，我就过去跳两下。", "en": "Set it down and I will hop over twice."},
        {"zh": "食物？我吸收就够了。", "en": "Food? I absorb what I need."},
        {"zh": "我更喜欢湿的地方。", "en": "I prefer damp places."},
        {"zh": "你手里的肉，会陷进我身体。", "en": "That meat would sink into me."},
        {"zh": "别扔过来，会黏住你。", "en": "Do not throw it. It will stick to you."},
        {"zh": "这块东西有点甜味。", "en": "That has a sweetness."},
        {"zh": "我把它慢慢包起来。", "en": "I slowly wrap around it."},
        {"zh": "你的手离得太近了。", "en": "Your hand is very close."},
        {"zh": "放地上，退两步就好。", "en": "On the ground. Two steps back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上来，整个人都黏了。", "en": "You hit me and come away sticky."},
        {"zh": "我被压扁，又鼓起来。", "en": "I flatten and swell back."},
        {"zh": "碰到我，你会掉一点血。", "en": "One touch and you lose a little blood."},
        {"zh": "我黏在你靴子上，甩不掉。", "en": "I cling to your boot."},
        {"zh": "你退开，黏液还连着你。", "en": "You retreat, slime still on you."},
        {"zh": "我不用力，黏就够了。", "en": "No force needed. Sticky is enough."},
        {"zh": "碰撞之后，我摊得更开。", "en": "After the bump, I spread wider."},
        {"zh": "我的身体从你手边滑过去。", "en": "My body slides past your hand."},
        {"zh": "你踩在我上面了。", "en": "You are standing on me."},
        {"zh": "这一下，你该洗洗靴子。", "en": "You should rinse those boots."},
        {"zh": "你从我身上踩过去，脚一滑。", "en": "You step through me and slide."},
        {"zh": "我被挤到两边，又合起来。", "en": "I split around you and rejoin."},
        {"zh": "你推我，我贴在你手上。", "en": "You push and I stick to your hand."},
        {"zh": "地面太滑，你撞到了墙。", "en": "Too slick. You hit the wall."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们分裂，不需要成对。", "en": "We split. No pairing needed."},
        {"zh": "这块身体里，有很多我。", "en": "There are many of me in here."},
        {"zh": "黏液里已经有小泡了。", "en": "Little bubbles are forming in me."},
        {"zh": "你问这个，我抖了一下。", "en": "That made me quiver."},
        {"zh": "我们只是变多，不变老。", "en": "We multiply. We do not age."},
        {"zh": "别碰，会沾一手。", "en": "Do not touch. It would cling."},
        {"zh": "分裂的时候，会有点疼。", "en": "Splitting stings a little."},
        {"zh": "两团撞一起，也许就成一团。", "en": "Two blobs may become one."},
        {"zh": "我们不分男女，只分大小。", "en": "No sexes. Only sizes."},
        {"zh": "你退开吧，这个话题黏。", "en": "Move along. Sticky topic."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块东西，我包进身体。", "en": "I wrap it into my body."},
        {"zh": "你掉的箭，黏在我上面。", "en": "Your arrow sticks to me."},
        {"zh": "那枚黏液球滚进我身子里。", "en": "The slimeball rolls into my body."},
        {"zh": "地上的水，我吸收了。", "en": "I absorb the water on the ground."},
        {"zh": "太重了，我拿不起来。", "en": "Too heavy for me to lift."},
        {"zh": "石头我不吞，会沉。", "en": "Not stone. It would sink."},
        {"zh": "我把一团胶留在上面。", "en": "I leave a blob on it."},
        {"zh": "东西进了我身体，就找不到了。", "en": "Inside me, it is lost."},
        {"zh": "你捡吧，我黏手。", "en": "You take it. My hands are sticky."},
        {"zh": "这块归我，黏住了。", "en": "This one is mine. Stuck fast."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低了，准备跳。", "en": "I crouch to leap."},
        {"zh": "你站在我的黏液里。", "en": "You stand in my slime."},
        {"zh": "我朝你那边一弹。", "en": "I bounce your way."},
        {"zh": "我的表面开始收紧。", "en": "My surface tightens."},
        {"zh": "我压扁身子，像一摊黑水。", "en": "I flatten myself like a pool of black water."},
        {"zh": "地上很滑，是吧。", "en": "Slick underfoot, is it not?"},
        {"zh": "我锁定你的膝盖。", "en": "I mark your knees."},
        {"zh": "黏液已经到你脚边了。", "en": "My slime reaches your feet."},
        {"zh": "你退，地上全是我。", "en": "Retreat. The ground is all me."},
        {"zh": "我弹起来，黏液甩到你脸上。", "en": "I bounce and slime splatters across your face."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "邪恶的凝胶，紫黑发亮。", "en": "Evil gel, purple-black and gleaming."},
        {"zh": "我的黏液在地上连成线。", "en": "My slime draws a line."},
        {"zh": "你每走一步都打滑。", "en": "Every step slips."},
        {"zh": "我不快，但到处都有我。", "en": "Slow, and everywhere."},
        {"zh": "我在等你摔倒。", "en": "I wait for you to fall."},
        {"zh": "我抖了一下，洒出一些。", "en": "I quiver and shed some."},
        {"zh": "你听见噗的一声吗？", "en": "Hear that wet plop?"},
        {"zh": "我换了个方向，从侧面来。", "en": "I come from the side."},
        {"zh": "你站的那块地是我的。", "en": "The spot you stand on is mine."},
        {"zh": "再近一步，就够到。", "en": "One step more and I reach."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我压在你的小腿上。", "en": "I press onto your calf."},
        {"zh": "黏液糊住了你的手。", "en": "Slime clogs your hands."},
        {"zh": "这一下不重，很黏。", "en": "Not heavy. Very sticky."},
        {"zh": "我整个撞了上去。", "en": "I throw my whole body."},
        {"zh": "你的护甲缝里进了胶。", "en": "Gel seeps into your armor's seams."},
        {"zh": "我滑到你脚边，绊了你。", "en": "I slide to your feet and trip you."},
        {"zh": "你甩手，甩不掉我。", "en": "You shake your hand. I stay."},
        {"zh": "这一下，让你走路变慢。", "en": "That slows your walk."},
        {"zh": "被打散的一块还在动。", "en": "The piece knocked off still moves."},
        {"zh": "我退回去，重新聚起来。", "en": "I pull back and reform."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地上多了一摊胶。", "en": "A puddle of gel on the ground."},
        {"zh": "黏液慢慢鼓起来。", "en": "The slime swells up."},
        {"zh": "噗的一声，我到了。", "en": "With a wet plop, I have arrived."},
        {"zh": "你听见噗的一声。", "en": "A wet plop."},
        {"zh": "这块地面变湿了。", "en": "The ground here turns wet."},
        {"zh": "一团东西聚成形了。", "en": "A blob takes shape."},
        {"zh": "我滴到了你的靴子上。", "en": "I drip onto your boot."},
        {"zh": "这一带开始黏脚。", "en": "The floor goes sticky."},
        {"zh": "我慢慢从土里冒出来。", "en": "I well up out of the soil."},
        {"zh": "地上有东西在颤。", "en": "Something on the ground quivers."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，我的表面就干了。", "en": "Fire dries my surface."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔得很扁，摊开了。", "en": "I land flat and spread."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我散得更开。", "en": "In water I spread out further."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我溅了一整面墙。", "en": "The blast splatters me on a wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭拔出来，凝胶上的洞就合了。", "en": "Arrow out, and the gel hole closes."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法让我的胶体僵住。", "en": "Magic sets my gel stiff."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有水分，我越来越小。", "en": "No water and I shrivel."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击把黏液烧得冒泡。", "en": "Lightning boils my slime."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我散开了，什么都没剩下。", "en": "I scatter. Nothing remains."}
      ]
    }
  }
}
