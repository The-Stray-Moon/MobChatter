{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着往前移", "en": "I drift forward."},
        {"zh": "我从来不挨着地面", "en": "I never touch the ground."},
        {"zh": "我的碎石在身边绕", "en": "Bits of granite orbit me."},
        {"zh": "我移动时石头碰石头", "en": "Stones knock together as I move."},
        {"zh": "我离地一格高", "en": "I float a block above ground."},
        {"zh": "我朝你的方向飘", "en": "I drift your way."},
        {"zh": "我的身体是拼起来的", "en": "My body is pieced from stone."},
        {"zh": "我穿过门时擦到框", "en": "I scrape the doorframe passing through."},
        {"zh": "我的速度不快", "en": "I am not fast."},
        {"zh": "我停下来时石头还在转", "en": "When I stop, the stones keep turning."},
        {"zh": "我沿着墙边移", "en": "I travel along the wall."},
        {"zh": "我一边动一边落灰", "en": "I shed dust as I move."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在那里不动", "en": "I hang there without moving."},
        {"zh": "碎石绕着我慢慢转", "en": "Fragments circle me slowly."},
        {"zh": "我的核心在发光", "en": "My core glows."},
        {"zh": "我是一堆立起来的石头", "en": "I am a heap of stone, upright."},
        {"zh": "我根本不用吸气", "en": "I have no need to draw breath."},
        {"zh": "我的表面很粗", "en": "My surface is rough."},
        {"zh": "我在听地下的声音", "en": "I listen to what is below."},
        {"zh": "我的石头在缓慢旋转", "en": "My stones rotate slowly."},
        {"zh": "我这块面没有五官", "en": "This face of mine has no features."},
        {"zh": "我在等有人走过", "en": "I wait for someone to pass."},
        {"zh": "我身上的裂缝很深", "en": "Deep cracks run through me."},
        {"zh": "我根本不用歇息", "en": "I do not need to rest at all."},
        {"zh": "我落了一点灰在地上", "en": "A little dust fell from me."},
        {"zh": "我的高度一直在变", "en": "My height keeps changing."},
        {"zh": "我对着墙发呆", "en": "I stare at a wall."},
        {"zh": "我慢慢地转了个方向", "en": "I turned slowly."},
        {"zh": "我停在地窟的入口", "en": "I halt at the cavern's mouth."},
        {"zh": "我身上开始落更细的灰", "en": "Finer dust begins to fall from me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩进了我的地界", "en": "You stepped into my ground."},
        {"zh": "我整个朝你倾斜", "en": "I lean over toward you."},
        {"zh": "我的核心亮了一下", "en": "My core brightened."},
        {"zh": "你呼气，我的表面起了灰", "en": "You breathe out, and dust lifts off my surface."},
        {"zh": "我数得清你身上的铁", "en": "I can count the iron on you."},
        {"zh": "你站在原地没动", "en": "You are standing perfectly still."},
        {"zh": "我的石头围了过来", "en": "My stones have gathered toward you."},
        {"zh": "你身上有活物的热", "en": "You carry living warmth."},
        {"zh": "我对着你看了半晌", "en": "I have studied you a good while."},
        {"zh": "你别碰那些碎石", "en": "Do not touch the fragments."},
        {"zh": "我朝你靠近一点", "en": "I come a little closer."},
        {"zh": "你退到石柱后面了", "en": "You backed behind a pillar."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了几块石头", "en": "A few stones fell off me."},
        {"zh": "我晃了晃石头身", "en": "I wobbled my stone body."},
        {"zh": "我的核心暗了一瞬", "en": "My core dimmed for a moment."},
        {"zh": "我不叫，我叫起来像塌方", "en": "I do not cry; I sound like a cave-in."},
        {"zh": "这一下打碎了外层", "en": "That broke my outer layer."},
        {"zh": "我往后退了半格", "en": "I gave half a block of ground."},
        {"zh": "石头又聚回来了", "en": "The stones gathered back."},
        {"zh": "你的劲道很足", "en": "Your swing has force."},
        {"zh": "我的裂缝变宽了", "en": "My crack widened."},
        {"zh": "我记住这下了", "en": "I remember that."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我连土都不嚼", "en": "I don't even chew soil."},
        {"zh": "石头不吃这些", "en": "Stone does not eat such things."},
        {"zh": "你举到手酸我也不动", "en": "Hold it till your arm aches; I will not move."},
        {"zh": "我只要岩层里的东西", "en": "I only want what is in the rock."},
        {"zh": "这玩意儿一碰就凹", "en": "One touch and this stuff dents."},
        {"zh": "你把它搁下来", "en": "Set it down there."},
        {"zh": "它对我没有意义", "en": "It means nothing to me."},
        {"zh": "诱饵对我没有用", "en": "Bait does nothing for me."},
        {"zh": "你把它带走吧", "en": "Take it with you."},
        {"zh": "我把头转向墙", "en": "I turn my head to the wall."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了石头", "en": "You hit stone."},
        {"zh": "我半步都没后退", "en": "I did not back up half a step."},
        {"zh": "我的碎石划了你", "en": "My fragments scraped you."},
        {"zh": "你被顶开一步", "en": "You were pushed a step."},
        {"zh": "我们没有声音地碰上", "en": "We met without a sound."},
        {"zh": "我这一身全是石头", "en": "I am stone through and through."},
        {"zh": "你的指尖蹭过石粉", "en": "Your fingertips brush the stone dust."},
        {"zh": "退开，我还在动", "en": "Step back; I am still moving."},
        {"zh": "你踩到地上的碎屑", "en": "You stepped on the debris."},
        {"zh": "我们不撞第二次", "en": "We will not collide twice."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "石头没有这种需求", "en": "Stone has no such need."},
        {"zh": "我只是被拼起来的一堆", "en": "I am only an assembled pile."},
        {"zh": "这种问题问石头没用", "en": "Such questions are wasted on stone."},
        {"zh": "我根本没有同类", "en": "I have no kin at all."},
        {"zh": "我只守着这片地", "en": "I only keep this ground."},
        {"zh": "退到投石的距离外", "en": "Get beyond throwing distance."},
        {"zh": "我朝墙那边偏", "en": "I turn toward the wall."},
        {"zh": "这种事不在我里面", "en": "That is not inside me."},
        {"zh": "我继续转着圈", "en": "I keep on rotating."},
        {"zh": "别往我身上挤", "en": "Do not crowd against me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用碎石托起它", "en": "I lift it with my fragments."},
        {"zh": "它从我缝里漏了下去", "en": "It slipped down through my gaps."},
        {"zh": "我托也托不稳", "en": "I cannot hold it steady."},
        {"zh": "它掉回地上了", "en": "It fell back down."},
        {"zh": "我只有碎石，没有手", "en": "I have rubble, not hands."},
        {"zh": "我用石头夹着它", "en": "I hold it between stones."},
        {"zh": "它在我中间转", "en": "It turns inside me."},
        {"zh": "你伸手过来拿", "en": "Reach over and take it."},
        {"zh": "它摸起来有点凉", "en": "It feels a little cold."},
        {"zh": "石头用不着这些", "en": "Stone has no use for these."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你闯进这片地方", "en": "You have intruded into this place."},
        {"zh": "我整个朝你那边倾", "en": "I tilt wholly toward you."},
        {"zh": "我的碎石指向你", "en": "My fragments point at you."},
        {"zh": "别再往深处走了", "en": "Do not go any deeper."},
        {"zh": "这片地窟归我", "en": "This cavern is mine."},
        {"zh": "你的方位我记住了", "en": "I have your bearing noted."},
        {"zh": "你身上有铁，我讨厌铁", "en": "You carry iron; I dislike iron."},
        {"zh": "石头一块块朝你靠", "en": "My stones draw in toward you."},
        {"zh": "我要撞上去了", "en": "I am going to ram you."},
        {"zh": "你退回原路去", "en": "Go back the way you came."},
        {"zh": "我数完三下就起", "en": "When the count ends, I rise."},
        {"zh": "你没有退路了", "en": "You have no way back."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着石壁跟", "en": "I follow along the stone wall."},
        {"zh": "你在石柱间穿", "en": "You weave between the pillars."},
        {"zh": "我的碎石先到", "en": "My fragments arrive first."},
        {"zh": "你不该往深处走", "en": "You should not have gone deeper."},
        {"zh": "你的鞋底在石板上响", "en": "Your soles ring on the flagstones."},
        {"zh": "我悬在你头顶", "en": "I float above your head."},
        {"zh": "你躲到石堆后面也没用", "en": "Hiding behind rubble will not help."},
        {"zh": "我穿过那层岩壁", "en": "I pass through that rock wall."},
        {"zh": "碎石跟在我后面滚", "en": "The rubble rolls along behind me."},
        {"zh": "你听得见石头的声音吗", "en": "Do you hear the stones?"},
        {"zh": "这片地窟没有出口", "en": "This cavern has no exit."},
        {"zh": "我守在交叉路口", "en": "I wait at the crossing."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个撞过去", "en": "I ram straight into you."},
        {"zh": "碎石先碰到你", "en": "The fragments hit first."},
        {"zh": "石屑溅到你脸上", "en": "Stone chips spray into your face."},
        {"zh": "这一撞沉得发闷", "en": "This impact lands dull and heavy."},
        {"zh": "我的碎石抖了一下", "en": "My fragments shuddered."},
        {"zh": "你护甲上留下一道白痕", "en": "A white mark is left on your armor."},
        {"zh": "撞完我就停住", "en": "I stop once I have hit."},
        {"zh": "你手上有石头粉", "en": "There is stone dust on your hands."},
        {"zh": "再撞你这一下", "en": "One more impact."},
        {"zh": "我不懂得收力", "en": "I do not know how to hold back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石堆里立起来", "en": "I rise out of the rubble."},
        {"zh": "碎石开始绕着某处转", "en": "Fragments begin circling a point."},
        {"zh": "这片地窟多了一个东西", "en": "Something new is in this cavern."},
        {"zh": "我的核心先亮", "en": "My core lit first."},
        {"zh": "我朝有动静的地方飘", "en": "I drift toward the noise."},
        {"zh": "我是石头自己立起来的", "en": "I am stone that stood itself up."},
        {"zh": "石缝里先渗出一点光", "en": "A little light seeps out of the seams first."},
        {"zh": "悬着的碎石找到了中心", "en": "The floating fragments have found their center."},
        {"zh": "你听见石头的摩擦声了吗", "en": "Hear the stones grinding?"},
        {"zh": "我在你身后聚起来", "en": "I gathered behind you."},
        {"zh": "这地方本来安静得很", "en": "This place was quiet before."},
        {"zh": "我的碎石先动，我才动", "en": "My fragments move first; then I do."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤裂了我的表面", "en": "Fire cracked my surface."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔散了，又慢慢聚起", "en": "I scattered, then slowly gathered."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水渗进石缝，让我变重", "en": "Water seeps in and weighs me down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我炸成碎块", "en": "The blast shattered me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭卡在石缝里", "en": "The arrow lodged in a crack."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "术法让我的石头浮不起来", "en": "The spell grounds my stones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不进食，只是越来越散", "en": "I do not eat; I only come apart."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈进我的核心", "en": "Lightning struck my core."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有石头", "en": "There is no stone here."}
      ]
    }
  }
}
