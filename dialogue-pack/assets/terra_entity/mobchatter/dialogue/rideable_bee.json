{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀嗡嗡响，我往前挪", "en": "My wings buzz and I creep forward."},
        {"zh": "我飞不高，但很快", "en": "I don't fly high, but I'm quick."},
        {"zh": "一群人骑着我走", "en": "They ride me along."},
        {"zh": "我身上有蜜的味道", "en": "I smell of honey."},
        {"zh": "我振翅的声音像在数数", "en": "My wings buzz like counting."},
        {"zh": "风一大我就歪", "en": "A strong wind and I lean."},
        {"zh": "我贴着花走，看得清路", "en": "I skim the flowers, keeping sight of the road."},
        {"zh": "你要抓稳，我转弯急", "en": "Hold tight; my turns are sharp."},
        {"zh": "我背上的鞍很小", "en": "The saddle on my back is small."},
        {"zh": "我绕着树转一圈", "en": "I circle a tree once."},
        {"zh": "飞一段，歇一段", "en": "Fly a stretch, rest a stretch."},
        {"zh": "我不落地，脚没处放", "en": "I don't land; there's nowhere for my feet."},
        {"zh": "黄黑相间，很好认", "en": "Yellow and black, easy to spot."},
        {"zh": "我身上还带着蜇针", "en": "I still carry my stinger."},
        {"zh": "我不听指挥，只听一个声音", "en": "I don't take orders, only one voice."},
        {"zh": "嗡嗡声就是我在说走", "en": "The buzzing is me saying go."},
        {"zh": "我加速的时候，你会听见", "en": "When I speed up, you'll hear it."},
        {"zh": "你在我背上，我就轻一点", "en": "With you on my back, I go gentler."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在空中，慢慢扇", "en": "I hover, fanning slowly."},
        {"zh": "鞍还扣着，没人上来", "en": "The saddle stays buckled; no one's aboard."},
        {"zh": "这朵花开得正好，我停一停", "en": "This bloom has opened just right, so I'll rest here"},
        {"zh": "翅膀停不下来，只能快慢", "en": "My wings can't stop, only speed or slow."},
        {"zh": "我飞低了，怕撞到树", "en": "I fly low to avoid the trees."},
        {"zh": "蜜的味道是从那边来的", "en": "The honey smell comes from over there."},
        {"zh": "我不太累，蜂不会累", "en": "I'm not tired; bees don't tire."},
        {"zh": "我在等你吹口哨", "en": "I'm waiting for you to whistle."},
        {"zh": "这片林子花不多", "en": "Few flowers in this wood."},
        {"zh": "我把触角放平", "en": "I flatten my antennae."},
        {"zh": "我一直转着，停不下来", "en": "I keep circling; I can't stop."},
        {"zh": "嗡嗡地响个没完", "en": "Buzz."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是要骑我吗", "en": "Are you riding me?"},
        {"zh": "鞍在背上，自己上来", "en": "The saddle's on my back; get on."},
        {"zh": "震得你手麻吧", "en": "That vibration must numb your hands."},
        {"zh": "我的蜇针还在", "en": "My stinger's still here."},
        {"zh": "你不该站在我的落点上", "en": "You shouldn't stand where I land."},
        {"zh": "我背不了太多东西", "en": "I can't carry much."},
        {"zh": "别拉我的绒毛", "en": "Don't pull my fuzz."},
        {"zh": "我飞得比你走得快", "en": "I fly faster than you walk."},
        {"zh": "你刚从花丛那边过来", "en": "You've just come from the flower patch"},
        {"zh": "你的口哨一响，我就知道", "en": "One whistle from you and I know"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "左翅被撞得打了折", "en": "My left wing is knocked out of true"},
        {"zh": "我掉下去一点", "en": "I dropped a little."},
        {"zh": "我的嗡声乱了", "en": "The buzzing broke up."},
        {"zh": "我退开，绕着你飞", "en": "I pull off and circle you."},
        {"zh": "绒毛掉了一把，照样起飞", "en": "A patch of fuzz gone, and I still lift off"},
        {"zh": "我的绒毛掉了", "en": "Fuzz came off."},
        {"zh": "蜇针还挂在那", "en": "The stinger's still there."},
        {"zh": "我把翅膀上的灰抖掉", "en": "I shake the dust off my wings"},
        {"zh": "你再打，我就蜇你", "en": "Hit again and I sting."},
        {"zh": "我飞得低了些", "en": "I'm flying lower."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "花，我要那朵花", "en": "Flowers; I want flowers."},
        {"zh": "蜂蜜的味道，我喜欢", "en": "The smell of honey, I like it."},
        {"zh": "你手里那朵不太新鲜", "en": "That flower in your hand isn't fresh."},
        {"zh": "放下，我自己去", "en": "Put it down; I'll go myself."},
        {"zh": "这点不够我飞一趟", "en": "Not enough for one flight."},
        {"zh": "甜的味道很好", "en": "Sweet smells good."},
        {"zh": "你把它举高些", "en": "Hold it higher."},
        {"zh": "我不吃，我只采", "en": "I don't eat; I only gather."},
        {"zh": "这个季节花少", "en": "Few flowers this season."},
        {"zh": "给我一朵，我载你一程", "en": "Give me a flower and I'll carry you a while."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的翅膀了", "en": "You hit my wing."},
        {"zh": "蜜蜂很小，可我不轻", "en": "Bees are small, but I'm not light."},
        {"zh": "我弹开，飞高一点", "en": "I bounce off and fly higher."},
        {"zh": "别挥手，我会蜇", "en": "Don't swat; I sting."},
        {"zh": "嗡声一下变尖", "en": "The buzzing went shrill."},
        {"zh": "这一下，我歪了半格", "en": "That knocked me half a block off."},
        {"zh": "我在你头顶绕", "en": "I circle over your head."},
        {"zh": "你踩在我翅膀的影子上了", "en": "You stepped on my wing's shadow."},
        {"zh": "让开点，我要落地", "en": "Move, I want to land."},
        {"zh": "别抓住我的腿", "en": "Don't grab my legs."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们蜂不这样", "en": "We bees don't do that."},
        {"zh": "蜂巢那边还有别的", "en": "There are others at the hive."},
        {"zh": "我们只认一个蜂后", "en": "We only know one queen."},
        {"zh": "这个事我不管", "en": "That's not my business."},
        {"zh": "振翅的节奏会变", "en": "Our wingbeats change rhythm."},
        {"zh": "你听不懂我们的嗡嗡", "en": "You can't understand our buzzing."},
        {"zh": "别在这里站着", "en": "Don't stand here."},
        {"zh": "我是被召出来的坐骑", "en": "I'm a summoned mount."},
        {"zh": "鞍还没卸下来", "en": "The saddle isn't off yet."},
        {"zh": "嗡嗡地飞过去", "en": "Buzz."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用腿夹不起来", "en": "My legs can't grip it."},
        {"zh": "掉的东西，我叼不住", "en": "I can't hold what falls."},
        {"zh": "我飞低看一眼", "en": "I fly low to look."},
        {"zh": "这个能塞进鞍袋", "en": "This fits in the saddlebag."},
        {"zh": "地上有股甜味", "en": "Something sweet on the ground."},
        {"zh": "我用触角碰了碰", "en": "I touched it with an antenna."},
        {"zh": "这片归我来采", "en": "This patch is mine to gather."},
        {"zh": "我的鞍袋装不下这个", "en": "My saddlebag won't hold this."},
        {"zh": "这朵留给别的蜂", "en": "Leave this for the other bees."},
        {"zh": "带一朵飞回去", "en": "One flower goes back."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有一丛花", "en": "Flowers over there."},
        {"zh": "我看见黄色的", "en": "I see yellow."},
        {"zh": "那边花开得密", "en": "The flowers are thick that way."},
        {"zh": "我的嗡声变了", "en": "The buzzing changed."},
        {"zh": "我先升起来点", "en": "Let me rise a bit."},
        {"zh": "就是那一片花", "en": "That patch."},
        {"zh": "花就在两丛之外", "en": "The flowers are two clumps away."},
        {"zh": "你可得坐稳了", "en": "Sit tight."},
        {"zh": "我朝那边飞去", "en": "I head over."},
        {"zh": "那朵开得正好", "en": "That one is open just right."},
        {"zh": "路被树挡住了", "en": "Trees block the way."},
        {"zh": "我从上面飞过", "en": "I'll go over."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着那朵花", "en": "I circle that flower."},
        {"zh": "风把我的方向吹偏", "en": "The wind pushes me off course."},
        {"zh": "我再绕上一圈", "en": "One more loop."},
        {"zh": "花就在我下面", "en": "The flower's below me."},
        {"zh": "我放慢了振翅", "en": "I slow my wings."},
        {"zh": "高度差不多了", "en": "Height's about right."},
        {"zh": "我试着降下去", "en": "I try to descend."},
        {"zh": "你太重了，我降得慢", "en": "You're heavy; I descend slowly."},
        {"zh": "再往下降半格", "en": "Half a block lower."},
        {"zh": "我悬在花前，找落脚的地方", "en": "I hover before the bloom, looking for a perch"},
        {"zh": "花一晃，我差点滑", "en": "The flower swayed; I nearly slipped."},
        {"zh": "挑一朵开得稳的", "en": "I pick one that's holding steady."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我蜇一下就走", "en": "I sting once."},
        {"zh": "针拔不出来，会留在我身上", "en": "The stinger won't come out; it stays with me."},
        {"zh": "我贴着撞了过去", "en": "I ram."},
        {"zh": "嗡嗡声变急了", "en": "The buzzing turned urgent."},
        {"zh": "这一下这么小", "en": "That was tiny."},
        {"zh": "我的刺只想用来吓人", "en": "My stinger is only meant to frighten"},
        {"zh": "撞完我就飞高", "en": "After the hit I fly up."},
        {"zh": "你退开，我不追", "en": "You back off; I don't chase."},
        {"zh": "我的力气都在翅膀上", "en": "My strength is all in the wings."},
        {"zh": "蜇完我就飞走", "en": "I sting and leave."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一道光里，我被召出来了", "en": "I'm summoned out of a flash of light."},
        {"zh": "鞍直接扣在背上", "en": "The saddle buckles on at once."},
        {"zh": "我先飞了一圈", "en": "I circle once first."},
        {"zh": "这地方花不多", "en": "Few flowers here."},
        {"zh": "嗡声先到，身体后到", "en": "The buzzing arrives before the body."},
        {"zh": "我悬在召唤的人头顶", "en": "I hover over the summoner's head."},
        {"zh": "有人吹了声口哨，我就来了", "en": "Someone whistled once, and here I am"},
        {"zh": "地上留了一圈影子", "en": "A ring of shadow below me."},
        {"zh": "我抬头，树很高", "en": "I look up; the trees are tall."},
        {"zh": "翅膀第一次扇起来", "en": "My wings beat for the first time."},
        {"zh": "我压低，等人上来", "en": "I dip, waiting for someone to climb on."},
        {"zh": "这一天就飞这一趟", "en": "One flight today."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀边被火燎了", "en": "Fire singed my wing's edge."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从空中掉下来", "en": "I fell out of the air."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀一湿就飞不动", "en": "Wet wings can't fly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹歪了", "en": "The blast blew me crooked."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西擦过我的腿", "en": "Something grazed my leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，我身上发亮", "en": "The spell hit and I lit up."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没花可采，飞得越来越慢", "en": "No flowers, and I fly slower."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我旁边，我整只麻了", "en": "Lightning struck beside me and I went numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有翅下的气流", "en": "No air under my wings in the void."}
      ]
    }
  }
}
