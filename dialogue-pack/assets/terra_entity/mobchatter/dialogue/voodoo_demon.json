{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘在半空，脚不碰地。", "en": "I float; my feet do not touch ground."},
        {"zh": "长袍下摆烧着一点火。", "en": "The hem of my robe is slightly aflame."},
        {"zh": "我绕过一根玄武岩柱。", "en": "I circle a basalt pillar."},
        {"zh": "灰从我身上往下掉。", "en": "Ash falls off me."},
        {"zh": "我在熔岩上方滑过去。", "en": "I glide above the lava."},
        {"zh": "我的面具上有一道裂。", "en": "A crack runs across my mask."},
        {"zh": "我一边飞一边摇手里的东西。", "en": "I shake what I hold as I fly."},
        {"zh": "火光把我的影子投在石壁上。", "en": "Firelight throws my shadow on the rock."},
        {"zh": "我飘过一片绯红的树。", "en": "I drift over crimson trees."},
        {"zh": "每走一步，空气都变热。", "en": "Every move, the air grows hotter."},
        {"zh": "我的袍角卷起来，又落下。", "en": "My robe lifts and settles."},
        {"zh": "我悬着，慢慢往前移。", "en": "Hovering, I drift forward."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，镰刀垂在手里。", "en": "Hovering, the scythe hangs in my hand."},
        {"zh": "我在看下面的熔岩。", "en": "I watch the lava below."},
        {"zh": "我的面具对着这边。", "en": "My mask faces this way."},
        {"zh": "火在我周围一点点转。", "en": "Fire curls slowly around me."},
        {"zh": "我用不着落到地上。", "en": "I need not touch the ground."},
        {"zh": "我把镰刀换了个握法。", "en": "I change my grip on the scythe."},
        {"zh": "下界的空气很干。", "en": "Nether air is dry."},
        {"zh": "我听着远处的呻吟声。", "en": "I hear distant moaning."},
        {"zh": "我把镰刀在指间转了一圈。", "en": "I spin the scythe once between my fingers."},
        {"zh": "我吊在半空，很稳。", "en": "I hang in the air, steady."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你不该来这层。", "en": "You should not be on this level."},
        {"zh": "我的镰刀认得你这种血。", "en": "My scythe knows blood like yours."},
        {"zh": "你身后是熔岩。", "en": "Lava is behind you."},
        {"zh": "你盯着面具，我盯着你。", "en": "You stare at my mask; I stare at you."},
        {"zh": "我浮在你上面。", "en": "I hover above you."},
        {"zh": "你的退路并不多。", "en": "You do not have many ways out."},
        {"zh": "这一层归我巡视。", "en": "I patrol this level."},
        {"zh": "你的头发被热气烤卷了。", "en": "The heat has curled your hair."},
        {"zh": "我悬着，从头到脚打量你。", "en": "I hang there, sizing you up from head to toe."},
        {"zh": "别动，会掉下去。", "en": "Hold still. You would fall."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "面具上又添一条裂纹。", "en": "Another crack joins my mask."},
        {"zh": "面具裂得更开了。", "en": "The crack in my mask widens."},
        {"zh": "我退了一尺，火弱了。", "en": "A foot back, and my fire dims."},
        {"zh": "这一下打穿了我的火。", "en": "That broke through my flame."},
        {"zh": "我不觉得疼，只觉得冷。", "en": "No pain, only cold."},
        {"zh": "我慢慢升回去。", "en": "I rise back up."},
        {"zh": "火星散开又聚起。", "en": "Sparks scatter and gather."},
        {"zh": "这点伤，烧得回来。", "en": "This much burns back."},
        {"zh": "你让我吃了一惊。", "en": "You surprised me."},
        {"zh": "你会为此付账。", "en": "You will pay for that."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那一点是火种吗。", "en": "Is that little thing a flame?"},
        {"zh": "你手里的东西在烧。", "en": "What you hold is burning."},
        {"zh": "给我，我要那点热。", "en": "Give it. I want that heat."},
        {"zh": "这样东西，我收。", "en": "I will take that."},
        {"zh": "搁在石板上面。", "en": "Leave it on the flagstone."},
        {"zh": "你往回退开些。", "en": "Step back a little."},
        {"zh": "这一点火太小了。", "en": "That flame is too small."},
        {"zh": "给我的东西，得能烧起来。", "en": "Whatever you offer must burn."},
        {"zh": "递高一点，我够得到。", "en": "Hold it higher. I can reach."},
        {"zh": "我闻到硫磺味了。", "en": "I smell sulfur."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "空袍子被你撞得凹进去。", "en": "You dent my empty robe."},
        {"zh": "我没有实体那么重。", "en": "I am not as heavy as I look."},
        {"zh": "退开，袍角会烧人。", "en": "Back off. My hem burns."},
        {"zh": "我的袍角蹭到了你的肩。", "en": "My robe's hem brushes your shoulder."},
        {"zh": "这点碰撞，我不理。", "en": "That bump I ignore."},
        {"zh": "我往旁边飘开。", "en": "I drift aside."},
        {"zh": "你被热气推开了。", "en": "The heat pushed you back."},
        {"zh": "别碰我的镰刀。", "en": "Do not touch my scythe."},
        {"zh": "热浪会先替我推开你。", "en": "The heat wave shoves you back for me."},
        {"zh": "你往远处站一些。", "en": "Stand further off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这张面具没有嘴。", "en": "This mask has no mouth."},
        {"zh": "下界不适合这些。", "en": "The Nether does not suit such things."},
        {"zh": "我只是一缕火。", "en": "I am only a flame."},
        {"zh": "问了也是白问。", "en": "Asking is useless."},
        {"zh": "我的袍子是空的。", "en": "My robe is empty."},
        {"zh": "这话题烧起来了。", "en": "That topic is catching fire."},
        {"zh": "我一件实物都没有。", "en": "I have not one solid thing."},
        {"zh": "你手里拿着它说话，不太合适。", "en": "Speaking while holding that is unwise."},
        {"zh": "我这就飘开了。", "en": "I drift away."},
        {"zh": "不用再说下去了。", "en": "No need to go on."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手，东西就浮起来。", "en": "I reach, and the thing rises."},
        {"zh": "它在我手里烧红了。", "en": "It glows red in my hand."},
        {"zh": "我用镰刀尖挑起来。", "en": "I lift it with the scythe tip."},
        {"zh": "地上的石头是烫的。", "en": "The stone here is hot."},
        {"zh": "我没有口袋可装。", "en": "I have no pockets to hold it."},
        {"zh": "这东西轻得像灰。", "en": "This is light as ash."},
        {"zh": "我把它扔进熔岩。", "en": "I throw it into the lava."},
        {"zh": "这点东西，不值钱。", "en": "This is worth little."},
        {"zh": "你掉的，我烧了。", "en": "You dropped it. I burned it."},
        {"zh": "我收着，等会用。", "en": "I keep it for later."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在熔岩边上。", "en": "You stand at the lava's edge."},
        {"zh": "你在我的光里。", "en": "You are in my light."},
        {"zh": "镰刀已经开始转。", "en": "The scythe has begun to spin."},
        {"zh": "这次我不落地。", "en": "This time I stay airborne."},
        {"zh": "我悬在你够不到的高处。", "en": "I hang where you can't reach me."},
        {"zh": "往那边跑也没用。", "en": "Running that way will not help."},
        {"zh": "你身上有我想要的味道。", "en": "You have a scent I want."},
        {"zh": "三下之内解决。", "en": "Done within three."},
        {"zh": "这里根本没有门。", "en": "There is no door here."},
        {"zh": "就算你跑，我也追得上。", "en": "Run, and I will still catch you."},
        {"zh": "我把镰刀抬高。", "en": "I raise the scythe."},
        {"zh": "镰刀转动起来了。", "en": "The scythe is turning."},
        {"zh": "你往身后看看。", "en": "Look behind you."},
        {"zh": "这片火光归我。", "en": "This firelight is mine."},
        {"zh": "那就这样定了。", "en": "So be it."},
        {"zh": "火光里我现出了形。", "en": "I take shape in the firelight."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你上方绕。", "en": "I circle above you."},
        {"zh": "镰刀在手里转。", "en": "The scythe turns in my hand."},
        {"zh": "热浪从你脚边升起来。", "en": "Heat rises at your feet."},
        {"zh": "石壁挡着你，我慢慢降。", "en": "The wall blocks you; I descend slowly."},
        {"zh": "我等一个角度。", "en": "I wait for an angle."},
        {"zh": "我的袍角在飘。", "en": "My hem is streaming."},
        {"zh": "你仰起脸看我。", "en": "You raised your face to me."},
        {"zh": "火星一颗颗落下。", "en": "Sparks fall one by one."},
        {"zh": "再悬上一会儿。", "en": "Hover a moment more."},
        {"zh": "你的脚不安分。", "en": "Your feet are restless."},
        {"zh": "这里离熔岩很近。", "en": "The lava is very close."},
        {"zh": "就是这一刻了。", "en": "This very moment."},
        {"zh": "我把镰刀甩出去。", "en": "I hurl the scythe."},
        {"zh": "追上去补一刀。", "en": "Follow it in for another cut."},
        {"zh": "我看你的肩膀。", "en": "I watch your shoulder."},
        {"zh": "别往上面跑了。", "en": "Do not run upward."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "镰刀飞出去，转着。", "en": "The scythe flies out, spinning."},
        {"zh": "我整个人俯冲下去。", "en": "I dive straight down."},
        {"zh": "刀锋划过你的护甲。", "en": "The blade scrapes your armor."},
        {"zh": "镰刀掠过，带起一溜火星。", "en": "The scythe sweeps past, trailing sparks."},
        {"zh": "你被推得退了半步。", "en": "You were shoved half a step back."},
        {"zh": "我的手指烧穿了你的衣领。", "en": "My fingers burn through your collar."},
        {"zh": "镰刀回旋，砍在你背上。", "en": "The scythe returns and cuts your back."},
        {"zh": "火花溅在你身上。", "en": "Sparks scatter over you."},
        {"zh": "再退一步，你就踩进火里。", "en": "One step more and you're in the fire."},
        {"zh": "我又把镰刀甩出去。", "en": "I throw the scythe again."},
        {"zh": "镰刀的回旋削开你的甲。", "en": "The scythe's return arc splits your armor."},
        {"zh": "我落在你身后。", "en": "I land behind you."},
        {"zh": "你居然还立着。", "en": "You are still on your feet."},
        {"zh": "再旋转上一圈。", "en": "Another spin."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从火里浮出来。", "en": "I rise out of the fire."},
        {"zh": "袍角先着起来。", "en": "My hem catches first."},
        {"zh": "这一层归我巡逻。", "en": "I patrol this level."},
        {"zh": "面具从烟里露出来。", "en": "My mask emerges from the smoke."},
        {"zh": "我悬在熔岩之上。", "en": "I hover over the lava."},
        {"zh": "硫磺味冲得很。", "en": "The sulfur stings the nose."},
        {"zh": "我把镰刀举起来。", "en": "I raise the scythe."},
        {"zh": "这附近有活人。", "en": "The living are nearby."},
        {"zh": "灰烬在我周围重新聚起。", "en": "Ash gathers around me again."},
        {"zh": "我飘到石柱旁边。", "en": "I drift to the basalt pillar."},
        {"zh": "我的影子太长。", "en": "My shadow is too long."},
        {"zh": "我从烟里现形。", "en": "I take shape out of the smoke."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰舔上来，像在喂我。", "en": "Flames lick at me as if feeding me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，砸在石头上。", "en": "I fall and strike the basalt."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浇在我身上，火一下就弱了。", "en": "Water hits me and my fire dims fast."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我冲得撞上石柱。", "en": "The blast slams me into a basalt pillar."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿进我的袍子，卡住了。", "en": "The arrow lodges in my robe."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光比火更冷。", "en": "This light is colder than fire."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "火需要柴，我什么也没有。", "en": "Fire needs fuel. I have none."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电和我的火撞在一起。", "en": "Lightning clashes with my flame."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有熔岩，也没有火。", "en": "No lava here. No fire."}
      ]
    }
  }
}
