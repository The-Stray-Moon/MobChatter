{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着步子，慢慢来。", "en": "I drag my steps, slow and steady."},
        {"zh": "绯红森林的土，是红的。", "en": "The crimson forest soil is red."},
        {"zh": "我的皮，像泡过血。", "en": "My skin looks steeped in blood."},
        {"zh": "我伸出手，往前探。", "en": "I reach out ahead of me."},
        {"zh": "走得不快，但很执拗。", "en": "Not fast, but relentless."},
        {"zh": "草丛被我踩得咯吱响。", "en": "The grass crackles under me."},
        {"zh": "我一路走，一路滴。", "en": "I walk and drip as I go."},
        {"zh": "这身红，跟林子一样。", "en": "This red matches the forest."},
        {"zh": "红土从我脚趾间挤过。", "en": "Red soil squeezes between my toes."},
        {"zh": "我朝着有呼吸的地方走。", "en": "I walk toward breathing."},
        {"zh": "红树在我身边过。", "en": "Red trees pass beside me."},
        {"zh": "我不会走错方向。", "en": "I never lose my direction."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，身体微微摇。", "en": "I stand, swaying slightly."},
        {"zh": "我的嘴唇裂得发疼。", "en": "My lips are split and sore."},
        {"zh": "红树的菌孢飘着。", "en": "Spores drift from the red trees."},
        {"zh": "我不累，也睡不着。", "en": "I can't tire, and I can't sleep."},
        {"zh": "我歪着头，听。", "en": "I tilt my head and listen."},
        {"zh": "身上的血，还没干。", "en": "The blood on me isn't dry."},
        {"zh": "手抬到一半又落下。", "en": "My hand rises halfway and drops."},
        {"zh": "这片森林，一直在呼吸。", "en": "This forest keeps breathing."},
        {"zh": "我的脚步，磨出了痕。", "en": "My pacing wears a track."},
        {"zh": "我不需要躲藏。", "en": "I needn't hide."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的脖子在跳。", "en": "Your neck is pulsing."},
        {"zh": "我的目光锁在你颈上。", "en": "My gaze is fixed on your neck."},
        {"zh": "你脚往后挪了。", "en": "Your feet have shifted back."},
        {"zh": "我不认得你，但我想吃。", "en": "I don't know you, but I want to eat."},
        {"zh": "我的手指很僵。", "en": "My fingers are stiff."},
        {"zh": "你手上的东西，没用。", "en": "That thing in your hand won't help."},
        {"zh": "我抬起一只僵硬的手。", "en": "I lift one stiff hand."},
        {"zh": "这林子，是我的家。", "en": "This forest is my home."},
        {"zh": "你闻起来，很新鲜。", "en": "You smell fresh."},
        {"zh": "我的目光没离开过你。", "en": "My gaze hasn't left you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被削掉一块。", "en": "A chunk of me is gone."},
        {"zh": "我歪着身子让开。", "en": "I twist aside."},
        {"zh": "这道口子我不当回事。", "en": "I make nothing of this wound."},
        {"zh": "血又流出来。", "en": "Blood flows again."},
        {"zh": "血从我的胸口渗出来。", "en": "Blood seeps out of my chest."},
        {"zh": "我偏了偏，又站直。", "en": "I lurch and straighten."},
        {"zh": "我一步接一步压上。", "en": "I press on, step after step."},
        {"zh": "我的手臂有点僵。", "en": "My arm is stiff."},
        {"zh": "这一下，让我偏了偏。", "en": "That blow made me list to one side."},
        {"zh": "疼这回事我早忘了。", "en": "Pain is something I forgot."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有肉我就吃。", "en": "If there's meat, I'll eat."},
        {"zh": "可这点远远不够。", "en": "But this is nowhere near enough."},
        {"zh": "你手里有肉味。", "en": "There's meat smell on your hands."},
        {"zh": "我一寸寸地靠过去。", "en": "I close in an inch at a time."},
        {"zh": "你放下，我捡。", "en": "Set it down; I'll take it."},
        {"zh": "我还是想要你。", "en": "I still want you."},
        {"zh": "这点东西，塞不住我。", "en": "That won't fill me."},
        {"zh": "血腥味钻进我鼻子。", "en": "Blood gets into my nose."},
        {"zh": "别把手往回缩。", "en": "Don't shrink your hand back."},
        {"zh": "我把手伸出去了。", "en": "My hand is reaching out."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我，你闻着更香了。", "en": "Hit me and you smell better."},
        {"zh": "我被撞得几乎没晃。", "en": "The blow barely rocked me."},
        {"zh": "这具身子沉得很。", "en": "This body is very heavy."},
        {"zh": "你退开的时候，我伸手。", "en": "As you pull back, I reach."},
        {"zh": "这一下，我抓住了布。", "en": "I caught your sleeve."},
        {"zh": "地上的血，蹭到你鞋上。", "en": "Blood smeared on your boots."},
        {"zh": "撞我，你只会慢下来。", "en": "Hitting me only slows you down."},
        {"zh": "我一歪，又撑住身子。", "en": "I lurch, then brace myself."},
        {"zh": "这点磕碰，身上的血都没抖。", "en": "That bump didn't shake the blood off me."},
        {"zh": "你踩着我的脚印。", "en": "You're standing in my prints."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这种，没有伴侣。", "en": "My kind have no mates."},
        {"zh": "绯红森林里，都是同类。", "en": "The crimson forest is full of kin."},
        {"zh": "我们之间没有话说。", "en": "There are no words between us."},
        {"zh": "我们只是都朝一个方向走。", "en": "We only walk the same way."},
        {"zh": "血把我们连在一起。", "en": "Blood ties us together."},
        {"zh": "这东西，我不懂。", "en": "I don't understand that."},
        {"zh": "别往这边靠。", "en": "Don't lean this way."},
        {"zh": "那种事，我早忘了。", "en": "I forgot that sort of thing long ago."},
        {"zh": "没有那种念头。", "en": "I have no such urge."},
        {"zh": "从这儿走开。", "en": "Get away from here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬了一口，又吐掉。", "en": "I bite once, then spit it out."},
        {"zh": "有血腥味，很好。", "en": "It smells of blood — good."},
        {"zh": "硬得我的牙咬不进去。", "en": "Too hard for my teeth."},
        {"zh": "东西掉了，我弯腰。", "en": "It fell; I bend down."},
        {"zh": "我的手指抓不住。", "en": "My fingers can't get a grip."},
        {"zh": "它在我手里发黏。", "en": "It's sticky in my hand."},
        {"zh": "我带着它走了一段。", "en": "I carry it a few steps."},
        {"zh": "嘴里只剩土腥味。", "en": "Only the taste of soil is left in my mouth."},
        {"zh": "我随手丢进草丛。", "en": "I toss it into the grass."},
        {"zh": "这点分量，填不了我。", "en": "This much can't fill me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "附近有喘气的东西。", "en": "Something nearby is breathing."},
        {"zh": "我的脸慢慢对准你。", "en": "My face slowly squares on you."},
        {"zh": "血的味道，变浓了。", "en": "The blood smell deepens."},
        {"zh": "你落在我的眼里了。", "en": "You've fallen into my sight."},
        {"zh": "我迈开腿，朝你过去。", "en": "I stretch my legs and come at you."},
        {"zh": "这片林子，没有出口。", "en": "No way out of this forest."},
        {"zh": "你退一步，我近两步。", "en": "You step back; I close two steps."},
        {"zh": "手指已经钩起来了。", "en": "My fingers are already curled."},
        {"zh": "你站的方位我记着。", "en": "I've noted the spot you stand on."},
        {"zh": "我正朝你挪。", "en": "I'm shuffling toward you."},
        {"zh": "你听见我的脚步吗？", "en": "Do you hear my steps?"},
        {"zh": "我马上到你跟前。", "en": "I'll be at you in a moment."},
        {"zh": "你的后背就在眼前。", "en": "Your back is right before me."},
        {"zh": "这一段路刚刚好。", "en": "This stretch is just right."},
        {"zh": "我看见你的喉咙。", "en": "I see your throat."},
        {"zh": "就趁这一瞬。", "en": "In this instant."},
        {"zh": "我的手抓住了。", "en": "My hand has caught you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你踏过的草，还弯着。", "en": "The grass you trod is still bent."},
        {"zh": "你跑，我就一直跟着。", "en": "Run, and I'll keep following."},
        {"zh": "林子里的路，我熟。", "en": "I know these forest paths."},
        {"zh": "你踩到的蘑菇，都红了。", "en": "The mushrooms you tread turn red."},
        {"zh": "我一直没停。", "en": "I haven't stopped."},
        {"zh": "我的手指，擦着树皮。", "en": "My fingers scrape the bark."},
        {"zh": "血从我的嘴角流下。", "en": "Blood runs from my mouth."},
        {"zh": "你一回头，我就不动了。", "en": "You turn; I stop moving."},
        {"zh": "别往那边跑。", "en": "Don't run that way."},
        {"zh": "那里的树更密。", "en": "The trees are thicker there."},
        {"zh": "我听着你的呼吸声。", "en": "I hear your breathing."},
        {"zh": "越来越近了。", "en": "Closer and closer."},
        {"zh": "那声响，我听见了。", "en": "I heard that snap."},
        {"zh": "我知道你藏在哪。", "en": "I know where you're hidden."},
        {"zh": "红树的影子里，我等着。", "en": "In the red tree's shadow, I wait."},
        {"zh": "我已经到跟前。", "en": "I'm right here now."},
        {"zh": "别再挣开这双手。", "en": "Stop fighting these hands."},
        {"zh": "你已经跑不掉了。", "en": "You can't run anymore."},
        {"zh": "我正对着你看。", "en": "I'm looking straight at you."},
        {"zh": "就到这一步了。", "en": "So this is where it ends."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一把抓过去！", "en": "I swipe at you!"},
        {"zh": "我的指头抠进你的袖子。", "en": "My fingers dig into your sleeve."},
        {"zh": "我一口咬实了。", "en": "My teeth close hard."},
        {"zh": "这一口，带着血。", "en": "That bite drew blood."},
        {"zh": "你推我，推不开。", "en": "You push; I don't budge."},
        {"zh": "我攥住了你的领口。", "en": "I knot your collar in my fist."},
        {"zh": "指节咔地响了一声。", "en": "My knuckles crack once."},
        {"zh": "你的血流到地上。", "en": "Your blood hits the ground."},
        {"zh": "我闻到了，更饿了。", "en": "The smell makes me hungrier."},
        {"zh": "挣动毫无用处。", "en": "Struggling accomplishes nothing."},
        {"zh": "牙陷进肉里，不松。", "en": "My teeth sink in and hold."},
        {"zh": "这一下，你软了。", "en": "That made your knees give."},
        {"zh": "我的重量全压在你身上。", "en": "My whole weight is on you."},
        {"zh": "你打得动我，但停不下我。", "en": "You can hurt me; you can't stop me."},
        {"zh": "我咬下第二口。", "en": "I take a second bite."},
        {"zh": "这一爪，先填一点。", "en": "This swipe fills me a little."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从红树后面走出来。", "en": "I step out from behind a red tree."},
        {"zh": "脚下是红色的土。", "en": "Red soil underfoot."},
        {"zh": "血腥味先飘到了。", "en": "The smell of blood arrives first."},
        {"zh": "红土上我抬起头来。", "en": "I raise my head from the red soil."},
        {"zh": "林子里有风。", "en": "Wind in the forest."},
        {"zh": "我的影子也是红的。", "en": "Even my shadow looks red."},
        {"zh": "周围有菌孢飘。", "en": "Spores float around me."},
        {"zh": "林子里有活物的气味。", "en": "Living scent in the forest."},
        {"zh": "我朝那边迈开步。", "en": "I set off that way."},
        {"zh": "这地方，我很熟。", "en": "I know this place well."},
        {"zh": "我拖着脚步。", "en": "I drag my feet."},
        {"zh": "你一回头，就看见我了。", "en": "Turn around and you'll see me."},
        {"zh": "我走出林子了。", "en": "I've come out of the trees."},
        {"zh": "你躲不到哪儿去。", "en": "There's nowhere to hide."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，皮就卷起来。", "en": "Fire curls my skin."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，骨头响得刺耳。", "en": "I fall; my bones creak sharply."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进肺里，我不喘了。", "en": "Water fills me; I stop breathing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我倒在地上。", "en": "The blast puts me on the ground."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭杆在我肩上颤。", "en": "The arrow shaft quivers in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光缠住我，手脚发沉。", "en": "Light coils around me; my limbs grow heavy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "空肚子响得像鼓。", "en": "My empty belly drums."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我身上，我一颤。", "en": "Lightning; I convulse."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，血往上飘。", "en": "I fall, blood drifting up."}
      ]
    }
  }
}
