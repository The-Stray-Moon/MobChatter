      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光烧得我发白", "en": "Spell light burns me pale."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得飞不稳", "en": "Hunger makes my flight unsteady."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光打得我浑身发麻", "en": "Lightning leaves me numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我往下掉，抓不到东西", "en": "I fall with nothing to catch."}
      ]
    }
  }
