{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我弓着背，一步一步蹭过去。", "en": "Hunched, I scrape forward step by step."},
        {"zh": "长臂垂到地上，拖着走。", "en": "My long arms drag along the ground."},
        {"zh": "我的皮贴骨头，动起来分明。", "en": "Skin to bone, every motion shows."},
        {"zh": "我走过的地方有一股臭味。", "en": "A stench follows where I walk."},
        {"zh": "我拖着脚，一步也不落。", "en": "I drag my feet but never fall behind."},
        {"zh": "脚趾在地面刮出声音。", "en": "My toes scrape the ground."},
        {"zh": "我歪着头，慢慢走。", "en": "Head askew, I walk slowly."},
        {"zh": "我的胸口起伏得很慢。", "en": "My chest rises and falls slowly."},
        {"zh": "我跟在你后面，隔着一段距离。", "en": "I follow at a set distance."},
        {"zh": "我从暗处慢慢挪出来。", "en": "I creep out of the dark."},
        {"zh": "我每一步都先试探一下。", "en": "I test each step before taking it."},
        {"zh": "我的背弯得比门框还低。", "en": "My back bends lower than a doorway."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪着脖子听远处。", "en": "I tilt my neck and listen far off."},
        {"zh": "我在嚼一块咬不烂的皮。", "en": "I'm chewing a scrap of hide that won't give."},
        {"zh": "我数着自己剩下的牙。", "en": "I count the teeth I have left."},
        {"zh": "我低下身子，贴在墙边。", "en": "I crouch against the wall."},
        {"zh": "我咬了几下空气。", "en": "I bite at the air."},
        {"zh": "我的喉头在动。", "en": "My throat works."},
        {"zh": "我在这儿杵了半天。", "en": "I have stood here half the day."},
        {"zh": "我听见有东西在喘。", "en": "I hear something breathing."},
        {"zh": "这具身体已经不太完整。", "en": "This body is not whole anymore."},
        {"zh": "我慢慢把头歪过去。", "en": "I tilt my head slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的血还是热的。", "en": "Your blood is still warm."},
        {"zh": "我身上闻到你味道。", "en": "I catch your scent."},
        {"zh": "我的手臂比你的长。", "en": "My arms are longer than yours."},
        {"zh": "你站着，我很喜欢。", "en": "You standing still suits me."},
        {"zh": "我很久没吃到活的了。", "en": "I have not eaten anything alive in a long while."},
        {"zh": "往后退是没有用的。", "en": "Backing away will not help."},
        {"zh": "这地方很暗，对吧。", "en": "It is dark here, is it not?"},
        {"zh": "我的牙合不上。", "en": "My teeth will not close."},
        {"zh": "你身上有护甲的味道。", "en": "You smell of armor."},
        {"zh": "铁片之间的缝我看得见。", "en": "I see the gaps between your iron plates."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的骨头断了一根。", "en": "One of my bones has broken."},
        {"zh": "我的肩脱了，我按回去。", "en": "My shoulder pops out; I push it back in."},
        {"zh": "身上的皮被划开。", "en": "My skin is cut open."},
        {"zh": "疼觉早就没有了。", "en": "Pain left me long ago."},
        {"zh": "我缩了缩脖子，又伸出来。", "en": "I shrink my neck, then stretch it out again."},
        {"zh": "这点伤，我还能动。", "en": "I can still move with this."},
        {"zh": "我按住那道伤口。", "en": "I press the wound."},
        {"zh": "你打得比我重。", "en": "You hit harder than I expected."},
        {"zh": "断掉的骨头顶着皮鼓出来。", "en": "A broken bone pushes up against my skin."},
        {"zh": "还会有下一次吗。", "en": "Is there more coming?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那一块是肉吗。", "en": "Is that piece meat?"},
        {"zh": "我要生着吃下去。", "en": "I want it raw."},
        {"zh": "你扔过来就行。", "en": "Just throw it over."},
        {"zh": "什么样的都行。", "en": "Any kind will do."},
        {"zh": "这味道让我走不动。", "en": "That smell stops my feet."},
        {"zh": "你手上还有别的。", "en": "You have more on you."},
        {"zh": "我不会等太久。", "en": "I will not wait long."},
        {"zh": "把它丢在地上。", "en": "Drop it on the ground."},
        {"zh": "放下那块肉，别晃。", "en": "Put that meat down and stop waving it."},
        {"zh": "这些还差得远。", "en": "Far from enough."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，硌手吧。", "en": "You hit me. Bony, is it not?"},
        {"zh": "我原地没有挪动分毫。", "en": "I did not shift in the least."},
        {"zh": "我身上就是骨头。", "en": "I am mostly bone."},
        {"zh": "你给我让开些。", "en": "Give me some room."},
        {"zh": "这点冲力推不动我的骨头。", "en": "That much force won't move my bones."},
        {"zh": "你推到我的肋骨了。", "en": "You pushed my ribs."},
        {"zh": "我呼出的气吹到你脸上。", "en": "My breath blows onto your face."},
        {"zh": "我挪开一点，随即又靠近。", "en": "I shift aside, then close in again."},
        {"zh": "你的靴跟碾过我的指节。", "en": "Your heel grinds over my knuckle."},
        {"zh": "别抓我的手臂。", "en": "Do not grab my arm."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经是这种样子了。", "en": "This is what I have become."},
        {"zh": "这堆骨头做不了别的。", "en": "These bones can do nothing else."},
        {"zh": "这个问题你不该问。", "en": "You should not ask that."},
        {"zh": "我只想着吃东西。", "en": "I think only of eating."},
        {"zh": "我连自己都不记得了。", "en": "I do not even remember myself."},
        {"zh": "你走近也没用。", "en": "Coming closer will not help."},
        {"zh": "这话题让我更饿。", "en": "That topic makes me hungrier."},
        {"zh": "你离我远一些。", "en": "Stay further from me."},
        {"zh": "我这副身子只想进食。", "en": "This body of mine only wants to feed."},
        {"zh": "别再提起这事。", "en": "Do not mention it again."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有一块东西。", "en": "Something on the ground."},
        {"zh": "我用长手指夹起来。", "en": "I pinch it with long fingers."},
        {"zh": "这是块肉，不太新鲜。", "en": "A piece of meat. Not fresh."},
        {"zh": "我直接塞进嘴里。", "en": "It goes straight into my mouth."},
        {"zh": "它从我指间滑掉了。", "en": "It slipped through my fingers."},
        {"zh": "我闻了一下，不吃了。", "en": "I sniff it and leave it."},
        {"zh": "我把它藏进破布里。", "en": "I hide it in my rags."},
        {"zh": "这一块啃不动。", "en": "This one will not chew."},
        {"zh": "我还能再找别的。", "en": "I can look for more."},
        {"zh": "别抢我的东西。", "en": "Do not take mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有活东西的气味。", "en": "I smell something alive."},
        {"zh": "我已经听见了。", "en": "I have heard it."},
        {"zh": "你别想着溜掉。", "en": "Do not think of slipping away."},
        {"zh": "这回我可不让。", "en": "This time I do not relent."},
        {"zh": "我不慌不忙地挪过去。", "en": "I shuffle over unhurried."},
        {"zh": "你跑得并不快。", "en": "You are not a fast runner."},
        {"zh": "饿意从骨头缝里钻出来。", "en": "Hunger seeps out from between my bones."},
        {"zh": "这里没有别的出路。", "en": "There is no other way out."},
        {"zh": "我开始动手了。", "en": "I am starting."},
        {"zh": "我把身子伏得极低。", "en": "I flatten down very low."},
        {"zh": "隔着一片林子我都闻得到。", "en": "I can smell you from across a grove."},
        {"zh": "你别出声喊人。", "en": "Do not call for help."},
        {"zh": "我这就走过去了。", "en": "I am walking over now."},
        {"zh": "只有你一个人。", "en": "Only you."},
        {"zh": "这倒并不难办。", "en": "This is not hard."},
        {"zh": "我的眼窝对着你一动不动。", "en": "My eye sockets stay fixed on you."},
        {"zh": "只要你一动就完了。", "en": "Move and it is over."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你跑吧，我总在后面。", "en": "Run; I'm always behind you."},
        {"zh": "我的脚趾先探到你的影子。", "en": "My toes find your shadow first."},
        {"zh": "你的汗味顺着墙根过来。", "en": "Your sweat drifts along the wall's base."},
        {"zh": "你心跳得快，我听得清。", "en": "Your heart races; I hear every beat."},
        {"zh": "我逼得你的背贴住石壁。", "en": "I've backed you against the stone wall."},
        {"zh": "我的手臂垂着，随时能抬。", "en": "My arms hang, ready to rise."},
        {"zh": "我用不着去跑。", "en": "I need no running."},
        {"zh": "你转身看后面了。", "en": "You turned to look behind."},
        {"zh": "这里太暗，你看不清我。", "en": "It is too dark for you to see me."},
        {"zh": "我的喉咙挤出干涩的声响。", "en": "A dry rasp scrapes out of my throat."},
        {"zh": "再往前挪三步。", "en": "Three steps more."},
        {"zh": "你开始发抖了。", "en": "You have begun to shake."},
        {"zh": "我连呼吸都省掉了。", "en": "I don't even waste breath."},
        {"zh": "饿到发昏，总算等到你。", "en": "Starved half-mad, I finally have you."},
        {"zh": "你已经退不动了。", "en": "You cannot retreat further."},
        {"zh": "好，现在就动手。", "en": "Good. Now."},
        {"zh": "我把手张到最大。", "en": "I spread my hands as wide as they go."},
        {"zh": "我挪动起来了。", "en": "I am moving."},
        {"zh": "已经够到你了。", "en": "I have reached you."},
        {"zh": "别跑，跑起来味道会散。", "en": "Don't run; running scatters your scent."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "长臂横扫过去。", "en": "A long arm sweeps across."},
        {"zh": "我的牙陷进你的肩头。", "en": "My teeth sink into your shoulder."},
        {"zh": "爪子抓进你的袖子。", "en": "Claws sink into your sleeve."},
        {"zh": "这一下撕开一道口子。", "en": "That opened a gash."},
        {"zh": "我把你往墙上推。", "en": "I push you into the wall."},
        {"zh": "我的骨头撞到你身上。", "en": "My bones strike you."},
        {"zh": "我的长臂从背后勾住你。", "en": "My long arm hooks you from behind."},
        {"zh": "我五指扣进你的锁骨。", "en": "My fingers dig into your collarbone."},
        {"zh": "我再撕了一口。", "en": "I tear in again."},
        {"zh": "我的指甲划过你肋侧。", "en": "My nails rake across your ribs."},
        {"zh": "这一招十分脏。", "en": "That was a filthy blow."},
        {"zh": "血从伤口流出来。", "en": "Blood runs out of the wound."},
        {"zh": "我舔掉指甲上的血。", "en": "I lick the blood off my nails."},
        {"zh": "你气还没喘匀。", "en": "You have not caught your breath."},
        {"zh": "我慢慢往后退开。", "en": "I draw back slowly."},
        {"zh": "你站都站不稳。", "en": "You cannot stand steady."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从暗处爬出来。", "en": "I crawl out of the dark."},
        {"zh": "我的骨头先露出来。", "en": "My bones show first."},
        {"zh": "这洞里堆着不少旧骨头。", "en": "This cave is heaped with old bones."},
        {"zh": "我直起身，很慢。", "en": "I straighten up, slowly."},
        {"zh": "我歪着头看了一圈。", "en": "I tilt my head and look around."},
        {"zh": "我的皮肤贴着骨头。", "en": "My skin clings to bone."},
        {"zh": "我拖着脚走了一步。", "en": "I drag a foot forward."},
        {"zh": "土里传来温热的心跳。", "en": "A warm heartbeat comes through the soil."},
        {"zh": "我从坟土里直起腰。", "en": "I straighten up out of the grave soil."},
        {"zh": "我的下颚垂到胸前。", "en": "My lower jaw hangs to my chest."},
        {"zh": "这里的阴暗正合我意。", "en": "This darkness suits me well."},
        {"zh": "我把脸转过来。", "en": "I turn my face toward you."},
        {"zh": "你们一个也别想走。", "en": "None of you will leave."},
        {"zh": "我把手指插进土里，撑起身体。", "en": "I dig my fingers into the soil and push myself up."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎得皮肉缩起来。", "en": "The heat shrinks my skin."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时我的关节散了。", "en": "My joints came loose on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进我的肺，可我不需要它。", "en": "Water fills my lungs, and I do not need them."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我的皮掀起来。", "en": "The blast lifts my skin."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头穿进我空着的胸腔。", "en": "The arrowhead passes into my hollow chest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我缩了一下。", "en": "This light makes me recoil."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿到骨头都空了。", "en": "Hunger has hollowed my bones."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电顺着骨头走了一遍。", "en": "Current runs along my bones."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面黑得和这里一样。", "en": "The dark below is like the dark here."}
      ]
    }
  }
}
