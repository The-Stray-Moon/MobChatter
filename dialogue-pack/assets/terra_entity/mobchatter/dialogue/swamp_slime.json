{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跳一跳地挪", "en": "I move along in hops."},
        {"zh": "我落在软泥上，陷了半截。", "en": "I land in soft mud and sink halfway."},
        {"zh": "我的身体拖出一条湿痕", "en": "My body leaves a wet trail."},
        {"zh": "我从水里挤出来", "en": "I squeeze out of the water."},
        {"zh": "我一下蹦过一丛草", "en": "One hop clears the grass."},
        {"zh": "我弹到石头上又滑下", "en": "I bounce on a stone and slide off."},
        {"zh": "我朝你那边跳", "en": "I hop your way."},
        {"zh": "我的表面一直在晃", "en": "My surface never stops wobbling."},
        {"zh": "我一弹一弹靠近", "en": "I bounce closer."},
        {"zh": "我挤出一点黏液", "en": "I squeeze out a bit of gel."},
        {"zh": "我一弹就越过了烂木头。", "en": "One bounce carries me over the rotting log."},
        {"zh": "我在泥里滚了半圈", "en": "I roll half over in the mud."},
        {"zh": "我又弹回原来的地方", "en": "I bounce back to where I was."},
        {"zh": "我一跳压弯了草", "en": "My hop bends the grass."},
        {"zh": "我一路拖出亮晶晶的泥痕。", "en": "I leave a glossy trail of mud behind."},
        {"zh": "我一跳一跳地走远", "en": "I hop away."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我摊在泥地上", "en": "I spread out on the mud."},
        {"zh": "泥水从我背上慢慢淌下。", "en": "Muddy water trickles slowly down my back."},
        {"zh": "我摊在泥里不动", "en": "I lie spread in the mud."},
        {"zh": "我的表面泛着水光", "en": "My surface shines wet."},
        {"zh": "我在泥里陷了一半", "en": "I am half sunk in the mud."},
        {"zh": "我慢慢缩又涨", "en": "I shrink and swell slowly."},
        {"zh": "我的身体发出响声", "en": "My body makes a sound."},
        {"zh": "我在水边待着", "en": "I stay by the water."},
        {"zh": "我轻轻地抖了一下", "en": "I quiver once."},
        {"zh": "我一弹也没弹", "en": "I have not bounced at all."},
        {"zh": "我的颜色和泥很像", "en": "My colour matches the mud."},
        {"zh": "我又涨大了一点", "en": "I swell a little."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把身子朝你转", "en": "I turn my body to you."},
        {"zh": "我的表面晃了晃", "en": "My surface ripples."},
        {"zh": "我在你脚边跳了一下", "en": "I hop by your feet."},
        {"zh": "你踩进来试试", "en": "Step in and see."},
        {"zh": "我的身体里有点东西", "en": "There is something inside me."},
        {"zh": "我朝你弹了半步", "en": "I bounce half a step your way."},
        {"zh": "泥水底下，我的眼睛没眨。", "en": "Beneath the muddy water, my eyes never blink."},
        {"zh": "我每跳一下，泥就溅起来。", "en": "Mud splashes with every hop I take."},
        {"zh": "我又跳了一下", "en": "I bounce once more."},
        {"zh": "你在我的范围里了", "en": "You are within my reach."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被压扁了一块", "en": "A part of me is flattened."},
        {"zh": "黏液溅了出来", "en": "Gel splashes out."},
        {"zh": "我晃了两下才成形", "en": "I wobble before taking shape."},
        {"zh": "我被打出一个缺口，又补上。", "en": "A gap is punched in me, and I fill it."},
        {"zh": "我身上破了个口", "en": "A gap opens in my body."},
        {"zh": "我又慢慢合上", "en": "It closes again."},
        {"zh": "我一下弹到一边", "en": "I bounce aside."},
        {"zh": "我慢慢涨回来", "en": "I slowly swell back."},
        {"zh": "我还在继续动", "en": "I am still moving."},
        {"zh": "我又挤了过来", "en": "I squash my way over again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西有点沉", "en": "That thing looks heavy."},
        {"zh": "我朝它弹过去", "en": "I bounce toward it."},
        {"zh": "我一口把它包住", "en": "I wrap it into my body."},
        {"zh": "我试着吞下去", "en": "I try to swallow it."},
        {"zh": "我抖了抖，把那东西抖出来。", "en": "I quiver until the thing falls out."},
        {"zh": "那东西太硬，我把它顶出来。", "en": "Too hard; I push it back out."},
        {"zh": "我不太想要这东西", "en": "I do not really want it."},
        {"zh": "我一下跳开了", "en": "I hop away."},
        {"zh": "那东西实在太硬", "en": "It is too hard."},
        {"zh": "我又弹了回来", "en": "I bounce back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，我弹开", "en": "You bump me and I bounce off."},
        {"zh": "我的身体凹下去又弹回", "en": "My body dents and springs back."},
        {"zh": "黏液沾到你脚上", "en": "Gel sticks to your foot."},
        {"zh": "我朝你挤了挤", "en": "I squash toward you."},
        {"zh": "你从我身上滑过去", "en": "You slide off me."},
        {"zh": "我被弹到一边", "en": "I bounce aside."},
        {"zh": "我又滚回原地", "en": "I roll back into place."},
        {"zh": "撞这一下我不疼", "en": "That bump did not hurt."},
        {"zh": "我身上的泥甩了你一身", "en": "My mud splashes onto you."},
        {"zh": "我一点点静止下来", "en": "I jiggle to a stop."},
        {"zh": "我又挪动了一下", "en": "I shift again."},
        {"zh": "我的表面晃了半天", "en": "My surface wobbles for a while."},
        {"zh": "你踩得我扁了一下", "en": "Your step flattens me a bit."},
        {"zh": "我又鼓了回来", "en": "I puff back up."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只弹过来了", "en": "Another bounces over."},
        {"zh": "我们撞在一起又弹开", "en": "We hit and spring apart."},
        {"zh": "我们并排泡在浑水里。", "en": "We soak side by side in the murky water."},
        {"zh": "我们一起泡在泥里", "en": "We soak in the mud together."},
        {"zh": "我们的表面挨在一起", "en": "Our surfaces press together."},
        {"zh": "它先弹着走开", "en": "It bounces off first."},
        {"zh": "我又跳了过去", "en": "I hop after it."},
        {"zh": "我们一起弹过草丛", "en": "We bounce through the grass together."},
        {"zh": "沼泽的水被我搅浑", "en": "I've muddied the swamp water"},
        {"zh": "我们又粘在一处", "en": "We stick together again."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽的水，泡得我发绿。", "en": "Swamp water soaks me green."},
        {"zh": "我慢慢把它吞进去", "en": "I slowly take it in."},
        {"zh": "它卡在我里面", "en": "It sticks inside me."},
        {"zh": "我又把它挤出来", "en": "I squeeze it back out."},
        {"zh": "我把它推出来一点", "en": "I push it partway out."},
        {"zh": "我把它裹进泥里，慢慢化开。", "en": "I wrap it in mud and let it dissolve."},
        {"zh": "我裹着它往前跳", "en": "I hop with it inside me."},
        {"zh": "我把它留在泥里", "en": "I leave it in the mud."},
        {"zh": "我又把它裹回去", "en": "I fold it back inside me."},
        {"zh": "我一松黏液就放开", "en": "My gel loosens and frees it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我弹起来对着你", "en": "I bounce up at you."},
        {"zh": "我的表面绷紧", "en": "My surface pulls tight."},
        {"zh": "我先把身体鼓到最大。", "en": "First I swell my body to its fullest."},
        {"zh": "我朝你那边挤", "en": "I squash my way toward you."},
        {"zh": "我的身体涨了一点", "en": "My body swells a little."},
        {"zh": "我在算跳的距离", "en": "I am measuring the hop."},
        {"zh": "我一点都不怕你", "en": "I am not afraid of you."},
        {"zh": "我先弹一下试试", "en": "I will try one bounce first."},
        {"zh": "你就在我的前面", "en": "You are right there."},
        {"zh": "我这就要撞过去了", "en": "I am about to slam into you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跳一跳跟着你", "en": "I bounce along after you."},
        {"zh": "我弹一下，烂泥就溅到你腿上", "en": "One hop and the muck splashes your legs."},
        {"zh": "你退开我就跳", "en": "You retreat; I hop."},
        {"zh": "我一直朝你那边挤", "en": "I keep squashing toward you."},
        {"zh": "我的黏液沾在地上", "en": "My gel smears the ground."},
        {"zh": "我不急着撞过去", "en": "I am in no hurry to slam."},
        {"zh": "沼泽的泥，等着你的脚。", "en": "The swamp mud is waiting for your feet."},
        {"zh": "你每走一步我就挪一点", "en": "Each step you take, I shift a little."},
        {"zh": "我贴得越来越近", "en": "I am very close."},
        {"zh": "我再弹一下就到了", "en": "One bounce and I am there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个身体撞上去", "en": "I slam my whole body into you."},
        {"zh": "我把你裹了一下", "en": "I wrap around you once."},
        {"zh": "黏液糊在你腿上", "en": "Gel smears your leg."},
        {"zh": "我弹起来压下去", "en": "I bounce up and come down."},
        {"zh": "你被我挤得退了", "en": "I crowd you back."},
        {"zh": "我又弹了一下", "en": "I bounce once more."},
        {"zh": "我撞完滚回原地", "en": "I slam and roll back."},
        {"zh": "我的身体被撞扁了", "en": "My body is squashed flat."},
        {"zh": "黏液糊在你腿上。", "en": "Slime is smeared up your leg."},
        {"zh": "我朝你的膝盖挤", "en": "I press at your knee."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从泥里鼓起来", "en": "I well up out of the mud."},
        {"zh": "我一出现就弹了一下", "en": "I bounce once as I appear."},
        {"zh": "黏液滴在我脚下", "en": "Gel drips at my feet."},
        {"zh": "水面起了一圈涟漪", "en": "A ripple spreads on the water."},
        {"zh": "我先慢慢涨大", "en": "First I swell up."},
        {"zh": "我从沼泽边挤上来", "en": "I squeeze up from the marsh edge."},
        {"zh": "我慢慢摊平在地上", "en": "I spread out on the ground."},
        {"zh": "我找到了这块湿地", "en": "I have found this wet ground."},
        {"zh": "我开始往你那边弹", "en": "I start bouncing your way."},
        {"zh": "我身上的泥还没干", "en": "The mud on me is still wet."}
      ]
    },
