{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着河岸走", "en": "I walk along the riverbank."},
        {"zh": "渔网搭在我肩上", "en": "A net rests on my shoulder."},
        {"zh": "我踩进浅水，又退回来", "en": "I step into the shallows, then back out."},
        {"zh": "我看看水里有没有鱼", "en": "I check the water for fish."},
        {"zh": "我绕过渔具箱", "en": "I step around the tackle box."},
        {"zh": "我提着桶走出门", "en": "I carry a bucket out the door."},
        {"zh": "我在木栈桥上走", "en": "I walk the wooden pier."},
        {"zh": "我停下来看水面", "en": "I stop to watch the water."},
        {"zh": "我朝有鱼跃的地方去", "en": "I head toward where fish jump."},
        {"zh": "裙边沾了点水", "en": "My hem is a little wet."},
        {"zh": "我踩得木板吱吱响", "en": "The planks creak under me."},
        {"zh": "我把桶换了只手", "en": "I switch the bucket to my other hand."},
        {"zh": "我又走到那片芦苇边", "en": "I'm back at the reeds."},
        {"zh": "我慢慢走到码头尽头", "en": "I walk to the pier's end."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠在栏杆上", "en": "I lean on the railing."},
        {"zh": "今天鱼不太咬钩", "en": "The fish aren't biting."},
        {"zh": "水面下的动静，我听得见。", "en": "I can hear what stirs beneath the surface."},
        {"zh": "屋里还算干净", "en": "The house is decent."},
        {"zh": "我把网补了几针", "en": "I mended the net a few stitches."},
        {"zh": "风向已经变了", "en": "The wind has shifted."},
        {"zh": "我在等傍晚来", "en": "I'm waiting for evening."},
        {"zh": "这条河我很熟", "en": "I know this river."},
        {"zh": "鱼漂一直没动", "en": "The float hasn't moved."},
        {"zh": "我把头发拨到耳后", "en": "I tuck my hair behind my ear."},
        {"zh": "今天有点闷热", "en": "It's a bit close today."},
        {"zh": "我在数桶里的鱼", "en": "I'm counting the fish in the bucket."},
        {"zh": "水面的光很好看", "en": "The light on the water is lovely."},
        {"zh": "我该收拾东西了", "en": "I should pack up soon."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也来钓鱼？", "en": "Do you fish too?"},
        {"zh": "我的房子就在那边", "en": "My house is over there."},
        {"zh": "你要问我路吗", "en": "Need directions?"},
        {"zh": "这条河有几种鱼", "en": "There are several fish in this river."},
        {"zh": "你的鞋都湿了", "en": "Your shoes are soaked."},
        {"zh": "你站这儿会挡住我的线", "en": "You're blocking my line."},
        {"zh": "我不太喜欢生人", "en": "I'm not fond of strangers."},
        {"zh": "你也是来钓鱼的？", "en": "Are you here to fish as well?"},
        {"zh": "今天收获不多", "en": "Not much of a catch today."},
        {"zh": "要不要看看我的网", "en": "Care to see my net?"},
        {"zh": "你能不能站到那边", "en": "Could you stand over there?"},
        {"zh": "水里的事我最清楚", "en": "I know the water best."},
        {"zh": "这条河早就不一样了", "en": "This river isn't what it was."},
        {"zh": "我这儿没别的东西", "en": "I haven't anything else here."},
        {"zh": "你说话轻一点", "en": "Speak softly."},
        {"zh": "我心情不太好", "en": "I'm not in a good mood."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的渔网破了", "en": "My net is torn."},
        {"zh": "你别举起手来", "en": "Don't raise a hand."},
        {"zh": "我退到屋里去", "en": "I'll retreat into the house."},
        {"zh": "我的渔网掉进了水里。", "en": "My net fell into the water."},
        {"zh": "我只是个渔女", "en": "I'm only a fisher girl."},
        {"zh": "我手上没武器", "en": "I have no weapon."},
        {"zh": "疼，我认输了", "en": "It hurts; I'll concede."},
        {"zh": "我心情更差了", "en": "My mood's worse now."},
        {"zh": "鱼全都翻白了", "en": "The fish are flipping."},
        {"zh": "别再动手打人", "en": "No more blows."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么鱼呀", "en": "What fish is that?"},
        {"zh": "我收鱼，不收别的", "en": "I take fish, not other things."},
        {"zh": "你自己留着吃吧", "en": "Keep it to eat yourself."},
        {"zh": "这条不算太大", "en": "This one isn't big."},
        {"zh": "你从哪儿捞的", "en": "Where did you pull it from?"},
        {"zh": "我更爱活蹦的", "en": "I prefer them lively."},
        {"zh": "这条鳞色不好", "en": "The scales look poor."},
        {"zh": "把鱼放进桶里", "en": "Put it in the bucket."},
        {"zh": "我心情好了一点点", "en": "That lifts my mood a little."},
        {"zh": "谢谢，但不必", "en": "Thank you, but no."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心我的渔网", "en": "Mind my net."},
        {"zh": "你撞到水桶了", "en": "You bumped the bucket."},
        {"zh": "水都溅出来了", "en": "The water splashed out."},
        {"zh": "站稳，栈桥滑", "en": "Steady; the pier is slippery."},
        {"zh": "我退到栏杆边", "en": "I step back to the railing."},
        {"zh": "没人在修这栏杆", "en": "Nobody mends this railing."},
        {"zh": "咱们都没磕着", "en": "Neither of us got hurt."},
        {"zh": "你踩到我的线了", "en": "You've stepped on my line."},
        {"zh": "让一让，我要收线", "en": "Let me through; I'm reeling in."},
        {"zh": "这座桥太窄了", "en": "This bridge is too narrow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我正忙着钓鱼", "en": "I'm busy fishing."},
        {"zh": "这事儿等闲下来再说", "en": "Ask when things are quiet."},
        {"zh": "我对这条河更上心", "en": "My heart's in this river."},
        {"zh": "你别站在我身后", "en": "Don't stand behind me."},
        {"zh": "今天没有心情", "en": "Not in the mood today."},
        {"zh": "我还是一个人好", "en": "I'm better on my own."},
        {"zh": "这个话题不合时宜", "en": "Wrong topic for now."},
        {"zh": "鱼还在咬钩呢", "en": "The fish are biting."},
        {"zh": "等收了网再说", "en": "Ask once the nets are in."},
        {"zh": "我得回去收拾了", "en": "I must go tidy up."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "放我回栈桥上", "en": "Set me back on the pier."},
        {"zh": "我的桶还在原地", "en": "My bucket is still there."},
        {"zh": "你这样我拿不了网", "en": "I can't hold the net like this."},
        {"zh": "我的裙子湿了", "en": "My skirt is wet."},
        {"zh": "你别抓我手腕", "en": "Don't grab my wrist."},
        {"zh": "我自己会走回去", "en": "I can walk back myself."},
        {"zh": "你要带我去河边？", "en": "Taking me to the river?"},
        {"zh": "我的鱼会死掉", "en": "My fish will die."},
        {"zh": "轻点，我不是袋子", "en": "Easy; I'm not a sack."},
        {"zh": "到地方放我下来", "en": "Set me down when we arrive."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你别往水里扔东西", "en": "Don't throw things in the water."},
        {"zh": "别踩我的渔线", "en": "Don't step on my line."},
        {"zh": "这里的水不欢迎脏东西", "en": "This water doesn't welcome filth."},
        {"zh": "我正看着你呢", "en": "I'm watching you."},
        {"zh": "我的渔具你别碰", "en": "Don't touch my gear."},
        {"zh": "这条河是我的生计", "en": "This river is my living."},
        {"zh": "站住，我的鱼竿横着呢。", "en": "Hold it, my rod is in your way."},
        {"zh": "我虽然不打鱼为生以外的事", "en": "Fishing is my trade, not fighting—"},
        {"zh": "但也不怕动手", "en": "But I'm not afraid to."},
        {"zh": "我可要喊人了", "en": "I'll call for help."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我手里有鱼竿", "en": "I have a rod in hand."},
        {"zh": "你脚下是湿泥", "en": "You're standing on wet mud."},
        {"zh": "栈桥只这一条路", "en": "The pier is the only way."},
        {"zh": "水边很容易滑", "en": "The bank is slippery."},
        {"zh": "我比你熟悉这里", "en": "I know this place better."},
        {"zh": "你退一步我就收手", "en": "One step back and I'll stop."},
        {"zh": "我把桶挪开了", "en": "I've moved the bucket aside."},
        {"zh": "你别踩我的线", "en": "Don't step on my line."},
        {"zh": "水里有的是办法", "en": "The water offers ways."},
        {"zh": "我喊一声，邻居就来", "en": "One shout brings the neighbors."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "吃我鱼竿一下", "en": "Take the rod."},
        {"zh": "这网也能罩人", "en": "A net catches people too."},
        {"zh": "我的鱼叉只赶人，不伤人。", "en": "My trident only shoos people off."},
        {"zh": "我这一下不重", "en": "That wasn't heavy."},
        {"zh": "别小看一个渔女", "en": "Don't underestimate a fisher girl."},
        {"zh": "我手上没什么力气", "en": "I've little strength."},
        {"zh": "但我熟悉这里", "en": "But I know this place."},
        {"zh": "水里站不稳吧", "en": "Hard to stand in water, isn't it?"},
        {"zh": "这一下是给你醒神", "en": "That was to wake you up."},
        {"zh": "退回岸上去吧", "en": "Get back to the bank."}
      ]
    },
