        {"zh": "河面平得像镜", "en": "The river is flat as glass."},
        {"zh": "今天能钓到几条", "en": "How many can I catch today?"},
        {"zh": "我把凳子搬到水边", "en": "I move the stool to the water's edge."}
      ]
    },
