{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跳一跳，沙就飞。", "en": "I hop and the sand flies."},
        {"zh": "我的身子被沙磨小了。", "en": "The sand has worn my body down."},
        {"zh": "身体一落地就摊开。", "en": "I spread out when I land."},
        {"zh": "我沿着沙丘走。", "en": "I travel along the dune."},
        {"zh": "我的边缘拖着沙。", "en": "Sand trails from my edges."},
        {"zh": "我跳得很别扭。", "en": "My hopping is awkward."},
        {"zh": "这一片沙子很松。", "en": "The sand is loose here."},
        {"zh": "我一点点往前蹭。", "en": "I ooze forward, bit by bit."},
        {"zh": "沙漠就是我的家。", "en": "The desert is my home."},
        {"zh": "我身上的沙越来越多。", "en": "More and more sand clings to me."},
        {"zh": "我每跳一次，就矮一点。", "en": "Every hop leaves me a little flatter."},
        {"zh": "我慢慢地滚过去。", "en": "I roll over slowly."},
        {"zh": "我从枯草旁边滑过。", "en": "I slide past a clump of dead grass."},
        {"zh": "这地方的太阳很毒。", "en": "The sun here is vicious."},
        {"zh": "我还没被晒干。", "en": "I have not dried out yet."},
        {"zh": "我往沙丘上去。", "en": "I head up the dune."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我瘫在沙上。", "en": "I sag onto the sand."},
        {"zh": "我的膜在晃。", "en": "My membrane quivers."},
        {"zh": "我的黏在沙里响。", "en": "My gel rustles in the sand."},
        {"zh": "我不需要水。", "en": "I do not need water."},
        {"zh": "我吸饱了沙子。", "en": "I've soaked up my fill of sand."},
        {"zh": "太阳把我的边晒硬了。", "en": "The sun has hardened my edges."},
        {"zh": "我在等着跳。", "en": "I am waiting to hop."},
        {"zh": "这一片很热。", "en": "This patch is hot."},
        {"zh": "我泡在热沙里发呆。", "en": "I soak in the hot sand and doze."},
        {"zh": "我的核心还在。", "en": "My core is intact."},
        {"zh": "我把沙抖松了。", "en": "I loosen the sand on me."},
        {"zh": "风把沙吹到我身上。", "en": "The wind blows sand onto me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也是来沙漠的？", "en": "Are you here for the desert too?"},
        {"zh": "你踩出的坑比我深。", "en": "Your prints are deeper than mine."},
        {"zh": "我弹了一下，让你看。", "en": "I bounce once so you can see."},
        {"zh": "我软得你手一捏就陷。", "en": "I'm soft enough that your hand sinks in."},
        {"zh": "沙子会进你鞋里。", "en": "Sand will get in your boots."},
        {"zh": "我没什么可怕的。", "en": "There is not much to fear from me."},
        {"zh": "你离我两格。", "en": "You are two blocks off."},
        {"zh": "你弯下腰才看得见我。", "en": "You have to bend down to see me."},
        {"zh": "你要不要跳一下？", "en": "Would you like to hop?"},
        {"zh": "我的边挂着沙粒。", "en": "Grains of sand cling to my rim."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我散了一块。", "en": "A piece of me scattered."},
        {"zh": "我缩了回去。", "en": "I pulled back in."},
        {"zh": "这一下，我矮了一半。", "en": "That took half my height."},
        {"zh": "我重新合拢。", "en": "I close up again."},
        {"zh": "我的边在抖。", "en": "My edges tremble."},
        {"zh": "是谁打的我？", "en": "Who hit me?"},
        {"zh": "沙上多了点黏。", "en": "There is a sticky patch on the sand."},
        {"zh": "我往沙丘后面退。", "en": "I shrink behind the dune."},
        {"zh": "我的核心没裂。", "en": "My core isn't cracked."},
        {"zh": "那你再试试。", "en": "Try again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那里面是水吗。", "en": "Is that water?"},
        {"zh": "那玩意儿我消化不了。", "en": "I can't digest that stuff."},
        {"zh": "你把它放低点。", "en": "Hold it lower."},
        {"zh": "还不够我裹一层。", "en": "Not enough to coat my skin."},
        {"zh": "我闻那味道带铁腥。", "en": "I smell iron in that stuff."},
        {"zh": "我一弹一弹凑近。", "en": "I bounce a little closer."},
        {"zh": "沙里没吃的。", "en": "There is nothing to eat in the sand."},
        {"zh": "我吞不下去。", "en": "I cannot swallow it."},
        {"zh": "那你自己留着。", "en": "Keep it yourself."},
        {"zh": "我只要沙子。", "en": "I want only sand."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩在我身上了。", "en": "You stepped on me."},
        {"zh": "我被踩扁了一块。", "en": "A part of me got flattened."},
        {"zh": "我黏在你鞋底。", "en": "I am stuck to your sole."},
        {"zh": "你踢了我一下。", "en": "You kicked me."},
        {"zh": "我压扁了又鼓起来。", "en": "I'm flattened, then I swell back."},
        {"zh": "你别挤压我。", "en": "Do not squash me."},
        {"zh": "我飞出去又滚回来。", "en": "I'm knocked away and roll back."},
        {"zh": "你脚上有我的沙。", "en": "You have my sand on your feet."},
        {"zh": "这一下，我矮了一截。", "en": "That cost me some height."},
        {"zh": "我的边黏住了。", "en": "My edge is stuck to you."},
        {"zh": "我从你脚边滑走。", "en": "I slide away from your foot."},
        {"zh": "撞我，你也会沾上沙。", "en": "Hit me and you get sandy."},
        {"zh": "我黏成一团还在。", "en": "I'm still one lump, still here."},
        {"zh": "那你再来一次。", "en": "Once more."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们挤在一起，成了一团。", "en": "We press together into one lump."},
        {"zh": "它黏得比我紧。", "en": "It holds its shape tighter than I do."},
        {"zh": "我们的膜碰在一起。", "en": "Our membranes touch."},
        {"zh": "沙地上多了一摊。", "en": "There is one more puddle on the sand."},
        {"zh": "我们分不出彼此。", "en": "We cannot tell each other apart."},
        {"zh": "然后慢慢分开。", "en": "Then we slowly separate."},
        {"zh": "两个核心，各自跳。", "en": "Two cores, hopping separately."},
        {"zh": "这片沙丘够我们挤。", "en": "This dune is room enough for us."},
        {"zh": "太阳落下去。", "en": "The sun is setting."},
        {"zh": "沙还是热的。", "en": "The sand is still warm."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "沙里有个东西。", "en": "Something is in the sand."},
        {"zh": "我把它裹进去。", "en": "I wrap it up inside me."},
        {"zh": "它在我身体里。", "en": "It is inside my body."},
        {"zh": "太重了，我沉下去。", "en": "Too heavy. I sink."},
        {"zh": "太硬了，我吐掉。", "en": "Too hard, so I spit it out."},
        {"zh": "不是能咽的东西。", "en": "Not something I can swallow."},
        {"zh": "我看你东西掉沙里了。", "en": "I saw your thing drop in the sand."},
        {"zh": "我用边把它拱回去。", "en": "I nudge it back with my edge."},
        {"zh": "它卡在我边上。", "en": "It is stuck on my edge."},
        {"zh": "我懒得管，让它埋着。", "en": "I can't be bothered; let it stay buried."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我感到那边的沙在动。", "en": "I feel the sand stirring over there."},
        {"zh": "我朝那边跳。", "en": "I hop that way."},
        {"zh": "沙子告诉我方向。", "en": "The sand tells me the way."},
        {"zh": "我摊平了，贴着沙滑。", "en": "I flatten out and slide over the sand."},
        {"zh": "我就冲那个影子去。", "en": "I go straight for that shadow."},
        {"zh": "我开始跳了。", "en": "I begin to hop."},
        {"zh": "一下就到了。", "en": "One hop and I am there."},
        {"zh": "你别跑开去。", "en": "Do not run off."},
        {"zh": "在沙里我追得上你。", "en": "In the sand I can catch you."},
        {"zh": "我弹起来，冲你去了。", "en": "I bounce up and come for you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的边贴着沙移过去。", "en": "My edge creeps along the sand."},
        {"zh": "我看你的脚印往后挪。", "en": "I watch your footprints shift back."},
        {"zh": "我的膜在抖。", "en": "My membrane is quivering."},
        {"zh": "沙被我推开了。", "en": "I push the sand aside."},
        {"zh": "我的边还没碰到你。", "en": "My edge hasn't touched you yet."},
        {"zh": "我再弹一次。", "en": "I bounce once more."},
        {"zh": "我再弹一下就到了。", "en": "One more bounce and I'm there."},
        {"zh": "我的影子盖到你了。", "en": "My shadow falls over you now."},
        {"zh": "我整只压下去。", "en": "I press down whole."},
        {"zh": "我的边贴到你了。", "en": "My edge is on you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整只扑上去。", "en": "I throw my whole body onto you."},
        {"zh": "你被裹住了。", "en": "You are wrapped up."},
        {"zh": "我的酸液沾到你。", "en": "My gel gets on you."},
        {"zh": "这点伤不重。", "en": "It is not a deep wound."},
        {"zh": "我弹开又回来。", "en": "I bounce off and come back."},
        {"zh": "沙子磨着皮肤。", "en": "The sand grinds your skin."},
        {"zh": "我被撞散了。", "en": "I was knocked apart."},
        {"zh": "我合回原样。", "en": "I go back to my shape."},
        {"zh": "我跳了一下。", "en": "One hop."},
        {"zh": "我又落地了。", "en": "I have landed."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙里冒出来。", "en": "I rise out of the sand."},
        {"zh": "我落在一片软沙上。", "en": "I land on a patch of soft sand."},
        {"zh": "我先摊平身子。", "en": "First I flatten out."},
        {"zh": "太阳在我头顶。", "en": "The sun is overhead."},
        {"zh": "我弹了一下。", "en": "I bounced once."},
        {"zh": "我身边连风都是烫的。", "en": "Even the wind around me is scorching."},
        {"zh": "远处有仙人掌。", "en": "There are cacti far off."},
        {"zh": "我的核心亮了一下。", "en": "My core flickered."},
        {"zh": "我得先立起来。", "en": "I need to lift myself first."},
        {"zh": "那就开始跳吧。", "en": "Time to hop."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，我的边就硬了。", "en": "The heat hardens my edges."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下去，摊成一片。", "en": "I fall and spread out flat."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我泡在水里，散得很快。", "en": "Soaking in water, I come apart fast."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我溅得到处都是。", "en": "The blast sprays me everywhere."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿进了我身体。", "en": "Something passed into my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的核心被冻住了。", "en": "My core has been frozen."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我越来越小。", "en": "I am getting smaller."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我亮了一下。", "en": "Lightning hits and I flare once."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "沙没了，我的黏团也在散。", "en": "No sand here - and my gel is coming apart."}
      ]
    }
  }
}
