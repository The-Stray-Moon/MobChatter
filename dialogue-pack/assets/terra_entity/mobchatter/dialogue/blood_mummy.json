{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "布条拖地，我一步步挪近。", "en": "Cloth dragging, I close in step by step."},
        {"zh": "绷带下面，什么也没有。", "en": "Nothing beneath these bandages."},
        {"zh": "膝盖僵着，我还是往前。", "en": "My knees are stiff, yet I keep going forward."},
        {"zh": "布条拖在地上。", "en": "Strips of cloth drag behind me."},
        {"zh": "这具身体不需要喘气。", "en": "This body doesn't need to breathe."},
        {"zh": "我抬脚，再慢慢放下。", "en": "I lift a foot, then set it down slowly."},
        {"zh": "我的手臂抬不起来。", "en": "My arms barely lift."},
        {"zh": "我朝你这边挪过来了。", "en": "I'm shuffling your way."},
        {"zh": "身上的布，早就旧了。", "en": "These wrappings are long worn."},
        {"zh": "我从不绕开东西。", "en": "I never go around anything."},
        {"zh": "你退，我还是一样快。", "en": "You retreat; my pace is the same."},
        {"zh": "我走得不快，但很近。", "en": "Not fast, but very close."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，布条在动。", "en": "I stand; the strips stir."},
        {"zh": "没有风，它们也动。", "en": "No wind, and still they move."},
        {"zh": "我的头，微微歪着。", "en": "My head tilts slightly."},
        {"zh": "土里透出一点凉气。", "en": "A little cold seeps from the earth."},
        {"zh": "身上的血，早就干了。", "en": "The blood on me dried long ago."},
        {"zh": "我既不用睡也不用歇。", "en": "I neither sleep nor rest."},
        {"zh": "绷带的缝隙里，是黑的。", "en": "Blackness between the bandages."},
        {"zh": "缠布的头转过半圈。", "en": "My wrapped head turns halfway."},
        {"zh": "脚下的地板，没响。", "en": "The floor doesn't creak."},
        {"zh": "我立在原地，布条不动。", "en": "I stand still; the wrappings hang."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的脸离我的布很近。", "en": "Your face is very close to my cloth."},
        {"zh": "我的脸，缠着布。", "en": "My face is wrapped in cloth."},
        {"zh": "我这对眼从不闭合。", "en": "These eyes of mine never close."},
        {"zh": "你退一尺，我进两尺。", "en": "Give a foot and I take two."},
        {"zh": "我没有表情。", "en": "I have no expression."},
        {"zh": "你呼吸的气味，很鲜活。", "en": "Your breath smells alive."},
        {"zh": "我的手，离你很近。", "en": "My hand is very near you."},
        {"zh": "别指望我停下。", "en": "Don't expect me to stop."},
        {"zh": "我记住了你呼吸的节拍。", "en": "I've memorized the rhythm of your breath."},
        {"zh": "布条下面，是空的。", "en": "Under the strips is emptiness."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "布条断了几根。", "en": "Several strips tore."},
        {"zh": "我整具身子退了半步。", "en": "My whole body draws back half a step."},
        {"zh": "这道口子我不放在心上。", "en": "I give this tear no thought."},
        {"zh": "破的地方，很快就干了。", "en": "The wound dries quickly."},
        {"zh": "我没有血可流。", "en": "I have no blood to lose."},
        {"zh": "我仍旧一步步往前走。", "en": "I keep walking forward, step by step."},
        {"zh": "我的动作迟了半拍。", "en": "My movement comes half a beat late."},
        {"zh": "布条飘了一下。", "en": "The strips flutter."},
        {"zh": "布条松了，我又缠紧。", "en": "The strips loosened; I wrap them tight again."},
        {"zh": "这具身体，不会疼。", "en": "This body doesn't feel pain."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不必张开口。", "en": "I don't have to open my mouth."},
        {"zh": "那些东西，对死人不算数。", "en": "Such things mean nothing to the dead."},
        {"zh": "食物对绷带没有意义。", "en": "Food means nothing to bandages."},
        {"zh": "我没有胃口。", "en": "I have no appetite."},
        {"zh": "你把食物放下，也是浪费。", "en": "Setting it down wastes it."},
        {"zh": "我想要的不是这些。", "en": "What I want isn't any of this."},
        {"zh": "你的手，别伸过来。", "en": "Don't reach out your hand."},
        {"zh": "把这些拿远些。", "en": "Take these further away."},
        {"zh": "我不需要供养。", "en": "I need no offerings."},
        {"zh": "这东西暖，我不要暖。", "en": "That thing is warm; I want no warmth."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，像撞一堵布墙。", "en": "You hit me like a cloth wall."},
        {"zh": "我一步也没有让。", "en": "I didn't give an inch."},
        {"zh": "布条缠到你身上。", "en": "A strip snagged on you."},
        {"zh": "我的力气，比你大。", "en": "My strength is greater than yours."},
        {"zh": "你往后挪了半步。", "en": "You shuffled back half a step."},
        {"zh": "我没有退的打算。", "en": "I've no intention of yielding."},
        {"zh": "这点磕碰，布条都没动。", "en": "That bump didn't even stir my wrappings."},
        {"zh": "我抬手，很慢。", "en": "I raise a hand, slowly."},
        {"zh": "退开，我不想沾上活气。", "en": "Back off; I don't want the smell of the living on me."},
        {"zh": "我仍旧一步步压过来。", "en": "I keep pressing forward, step by step."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我连自己都记不全。", "en": "I can't even remember all of myself."},
        {"zh": "这具身体，早就死了。", "en": "This body died long ago."},
        {"zh": "布条下没有心跳。", "en": "No heartbeat beneath the cloth."},
        {"zh": "同类之间，只是并肩。", "en": "Kin simply stand together."},
        {"zh": "两具躯壳，不必交谈。", "en": "Two husks have no need to talk."},
        {"zh": "你提这个，很可笑。", "en": "That's absurd to ask."},
        {"zh": "我只会往前走。", "en": "I only walk forward."},
        {"zh": "你的心跳，吵得我难受。", "en": "Your heartbeat is a noise I can't stand."},
        {"zh": "这类话我不回应。", "en": "I don't answer such talk."},
        {"zh": "往后退出去。", "en": "Back away out of here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起来，握在手里。", "en": "I pick it up and hold it."},
        {"zh": "手里的东西，会掉。", "en": "It slips from my fingers."},
        {"zh": "这些留着也是累赘。", "en": "These are only a burden."},
        {"zh": "我把它甩到墙角。", "en": "I fling it to the corner."},
        {"zh": "布条缠住了它。", "en": "A bandage snags on it."},
        {"zh": "我拖着它挪了两步。", "en": "I drag it two shuffling steps."},
        {"zh": "这分量轻得像空壳。", "en": "As light as an empty husk."},
        {"zh": "我没有感觉。", "en": "I feel nothing."},
        {"zh": "把它撂在那儿。", "en": "Leave it lying there."},
        {"zh": "我没那个兴趣。", "en": "I've no interest in that."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你一动，布条就朝你飘。", "en": "When you move, my strips drift toward you."},
        {"zh": "我整副身子转向你。", "en": "My whole body turns toward you."},
        {"zh": "布条绷紧了。", "en": "The bandages pull taut."},
        {"zh": "你进了我伸手的距离。", "en": "You're inside the reach of my hand."},
        {"zh": "这一路没有障碍。", "en": "The path to you is clear."},
        {"zh": "我举起了手。", "en": "I've raised my hand."},
        {"zh": "你还钉在原处。", "en": "You're still rooted there."},
        {"zh": "这倒正合我意。", "en": "That suits me well."},
        {"zh": "我迈开步子了。", "en": "I've taken my first step."},
        {"zh": "用不了多久。", "en": "It won't take much longer."},
        {"zh": "你退吧，没用的。", "en": "Retreat; it's useless."},
        {"zh": "你我已经算认识了。", "en": "Consider us acquainted."},
        {"zh": "这栋屋子里，只有我们。", "en": "Only us in this house."},
        {"zh": "你听见布条的声音吗？", "en": "Hear the cloth dragging?"},
        {"zh": "我们之间近了。", "en": "The gap between us has closed."},
        {"zh": "就定在此刻。", "en": "It is fixed at this moment."},
        {"zh": "我的手已经落下。", "en": "My hand has already fallen."},
        {"zh": "没有路给你走。", "en": "There's no way out for you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步跟着一步。", "en": "I follow, one step at a time."},
        {"zh": "你跑得快，我不用快。", "en": "You're fast; I needn't be."},
        {"zh": "布条拖在地上，声音很轻。", "en": "The cloth drags softly."},
        {"zh": "这走廊没有岔路。", "en": "No branches in this corridor."},
        {"zh": "我不追，我只等你停。", "en": "I don't chase; I only wait for you to stop."},
        {"zh": "手腕转了一下，指甲朝前。", "en": "My wrist turns; my nails point forward."},
        {"zh": "我的指甲很黑。", "en": "My nails are black."},
        {"zh": "你停在原地，很好。", "en": "You've stopped in place - good."},
        {"zh": "我数着你的脚步，不数时间。", "en": "I count your steps, not the hours."},
        {"zh": "布条在轻轻摆动。", "en": "The wrappings sway gently."},
        {"zh": "再走一步，就够到了。", "en": "One more step and I'll reach you."},
        {"zh": "你的呼吸很乱。", "en": "Your breathing is ragged."},
        {"zh": "我把手臂伸出去。", "en": "I extend my arm."},
        {"zh": "你就在前方。", "en": "You're right ahead."},
        {"zh": "手已经搭上了。", "en": "My hand is already on you."},
        {"zh": "别挣，也别动。", "en": "Don't struggle. Don't move."},
        {"zh": "到这里就完了。", "en": "This is where it ends."},
        {"zh": "安静下来吧。", "en": "Go quiet now."},
        {"zh": "我的手指已经对着你。", "en": "My fingers are already pointed at you."},
        {"zh": "这样安静，很好。", "en": "Quiet like this — good."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一拳打过去！", "en": "My fist swings out!"},
        {"zh": "布条缠住你的手。", "en": "The bandages wrap your arm."},
        {"zh": "这一下，很沉。", "en": "That one lands heavy."},
        {"zh": "我抓你的肩。", "en": "I grab your shoulder."},
        {"zh": "你挣不出这只手。", "en": "You won't twist free of this hand."},
        {"zh": "我的另一只手又抬起。", "en": "My other hand rises again."},
        {"zh": "指甲刮过你的脸。", "en": "My nails rake your face."},
        {"zh": "骨节在布里咔了一声。", "en": "A knuckle clicks inside the cloth."},
        {"zh": "这一掌够你跪下。", "en": "That palm puts you on your knees."},
        {"zh": "你后退，我上前。", "en": "You back off; I step in."},
        {"zh": "我的另一只手也来了。", "en": "My other hand comes too."},
        {"zh": "布条越缠越紧。", "en": "The strips pull tighter."},
        {"zh": "你打在我身上的，没感觉。", "en": "Your blows do nothing."},
        {"zh": "我会再来一次。", "en": "I'll do it once more."},
        {"zh": "这一掌按在你胸口上。", "en": "This palm presses onto your chest."},
        {"zh": "我这具身体不会停。", "en": "This body of mine won't stop."},
        {"zh": "这具躯壳不知疲倦。", "en": "This husk knows no weariness."},
        {"zh": "把眼睛对着我。", "en": "Turn your eyes on me."},
        {"zh": "布条越收越紧。", "en": "The wrappings draw tighter."},
        {"zh": "你的腿撑不住了。", "en": "Your legs won't hold."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从暗处走出来。", "en": "I walk out of the dark."},
        {"zh": "布条先垂下来。", "en": "The bandages hang down first."},
        {"zh": "没有脚步声。", "en": "No footsteps."},
        {"zh": "这间屋子，很安静。", "en": "This room is very quiet."},
        {"zh": "绷带底下，一点光也不透。", "en": "No light gets under the bandages."},
        {"zh": "空气里没有味道。", "en": "No scent in the air."},
        {"zh": "我站在门口。", "en": "I stand in the doorway."},
        {"zh": "你转过头来了。", "en": "You've turned around."},
        {"zh": "我慢慢举手。", "en": "I slowly raise a hand."},
        {"zh": "门里的人，我等着。", "en": "Whoever's inside — I wait."},
        {"zh": "我的影子拉到墙上。", "en": "My shadow reaches the wall."},
        {"zh": "外面的光，照不进来。", "en": "The outside light doesn't reach."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "布条一着火，就烧得快。", "en": "The bandages catch fast."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，布条散开。", "en": "I fall; the wrappings unravel."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浸透布条，我沉下去。", "en": "Water soaks the cloth and I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得布条全散了。", "en": "The blast shreds the wrappings."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉进我的身体。", "en": "Something pins into me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量，把我压住。", "en": "That force weighs me down."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不靠进食活着。", "en": "I don't live by eating."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一落，布条全焦了。", "en": "Lightning chars every strip."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，布条往上飘。", "en": "I fall; the strips flutter up."}
      ]
    }
  }
}
