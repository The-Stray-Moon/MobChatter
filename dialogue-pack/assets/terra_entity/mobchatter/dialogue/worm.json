{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一段段往前拱。", "en": "I push forward a segment at a time."},
        {"zh": "泥从身体两边挤开。", "en": "Mud parts on both sides of me."},
        {"zh": "我一伸一缩地往前拱。", "en": "I inch forward, stretching and bunching."},
        {"zh": "我从土里钻过。", "en": "I tunnel through the soil."},
        {"zh": "细雨打在我身上。", "en": "Fine rain lands on me."},
        {"zh": "我贴着湿土滑过去。", "en": "I slide along the wet soil."},
        {"zh": "身体弯成几道弯。", "en": "My body bends into curves."},
        {"zh": "土粒滚到我背上。", "en": "Grains of soil roll onto me."},
        {"zh": "我慢慢爬过石板。", "en": "I crawl slowly over a slab."},
        {"zh": "一段一段向前。", "en": "Segment after segment, forward."},
        {"zh": "我一条腿都没有。", "en": "I don't have a single leg."},
        {"zh": "我钻回土里又出来。", "en": "I go under and come back up."},
        {"zh": "湿气从土里上来。", "en": "Damp rises from the earth."},
        {"zh": "我绕过一粒小石子。", "en": "I go around a small pebble."},
        {"zh": "身体在地上留下亮线。", "en": "My body leaves a bright line."},
        {"zh": "我一点一点地移动。", "en": "I move by degrees."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘成一个小圈歇着。", "en": "I coil into a small ring to rest."},
        {"zh": "雨停了，土还是湿的。", "en": "Rain stopped. The soil stays wet."},
        {"zh": "我从土面探出一点头。", "en": "I poke a bit of my head above the soil."},
        {"zh": "身体偶尔抽动一下。", "en": "My body twitches now and then."},
        {"zh": "我在土里听着。", "en": "I listen from the soil."},
        {"zh": "土里一点声音都没有。", "en": "Not a sound in the soil."},
        {"zh": "我身上全是黏液。", "en": "Slime all over me."},
        {"zh": "泥土很凉快。", "en": "The soil is cool."},
        {"zh": "我慢慢伸开。", "en": "I slowly extend."},
        {"zh": "有什么在附近。", "en": "Something's nearby."},
        {"zh": "我藏到叶子下面。", "en": "I hide under a leaf."},
        {"zh": "这一段有点干。", "en": "This stretch is a little dry."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩在我旁边。", "en": "You stepped right beside me."},
        {"zh": "我小得差点看不见。", "en": "I'm so small you barely see me."},
        {"zh": "别拿石头压我。", "en": "Don't put a stone on me."},
        {"zh": "你的影子太黑了。", "en": "Your shadow is very dark."},
        {"zh": "我往前爬得很慢。", "en": "I crawl slowly."},
        {"zh": "你要找什么？", "en": "What are you looking for?"},
        {"zh": "土里全是我的路。", "en": "All these tunnels are mine."},
        {"zh": "你低头看我做什么。", "en": "Why look down at me?"},
        {"zh": "我没牙，咬不了你。", "en": "I have no teeth; I can't bite you."},
        {"zh": "你手里的棍子太粗了。", "en": "That stick is too thick for me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我把身体拧成一团。", "en": "I twist my body into a knot."},
        {"zh": "身上破了一段。", "en": "A segment of me is torn."},
        {"zh": "我在土里挣动。", "en": "I writhe in the soil."},
        {"zh": "身子弯得不太自然。", "en": "My body bends wrong."},
        {"zh": "泥里渗进了一点血。", "en": "A little blood seeps into the mud."},
        {"zh": "我拱了拱，还动得了。", "en": "I wriggle; I can still move."},
        {"zh": "我赶紧往下钻。", "en": "I burrow down fast."},
        {"zh": "我在土里蜷着，缓一缓。", "en": "I curl up in the soil and catch my breath."},
        {"zh": "这一段有点麻。", "en": "This segment feels numb."},
        {"zh": "我想回土里。", "en": "I want back in the soil."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是湿土吗？", "en": "Is that damp soil?"},
        {"zh": "潮湿的就好。", "en": "Damp is good."},
        {"zh": "有烂叶子吗？", "en": "Any rotting leaves?"},
        {"zh": "一小片烂叶子就够了。", "en": "One scrap of rotting leaf is enough."},
        {"zh": "这里的土一拱就开。", "en": "This soil opens at a single nudge."},
        {"zh": "别把我挖出来。", "en": "Don't dig me out."},
        {"zh": "让我钻进去看看。", "en": "Let me burrow in and see."},
        {"zh": "好闻的味道。", "en": "A good smell."},
        {"zh": "那一块更潮湿。", "en": "That patch is wetter."},
        {"zh": "我一段一段朝湿土挪。", "en": "I inch toward the damp soil, segment by segment."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被压得扁了一点，还活着。", "en": "I'm a little flattened, still alive."},
        {"zh": "我把自己叠起来。", "en": "I fold myself up."},
        {"zh": "你的鞋底压住了我一截。", "en": "Your boot sole pins part of me down."},
        {"zh": "泥把我裹住了。", "en": "Mud wrapped around me."},
        {"zh": "我在土里打了个滚。", "en": "I rolled through the soil."},
        {"zh": "身子被挤弯了。", "en": "My body got bent."},
        {"zh": "别用棍子拨我。", "en": "Don't flick me with that stick."},
        {"zh": "我钻下去躲一下。", "en": "I'll burrow under to hide."},
        {"zh": "我还算完整。", "en": "I'm still in one piece."},
        {"zh": "退开一点点。", "en": "A little space, please."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不过是条土里的虫。", "en": "I'm just a worm in the dirt."},
        {"zh": "土里不需要这个。", "en": "The soil has no need of that."},
        {"zh": "我连眼睛都看不清。", "en": "I can hardly see."},
        {"zh": "雨后才会有这种事。", "en": "That happens after rain."},
        {"zh": "你这么大，不合适。", "en": "You're far too big."},
        {"zh": "我先钻下去。", "en": "I'll go under first."},
        {"zh": "别一直盯着。", "en": "Stop staring."},
        {"zh": "我很快就好。", "en": "I'll be quick about it."},
        {"zh": "安静一点好吗。", "en": "Could you be quiet?"},
        {"zh": "我得先走了。", "en": "I should go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块土很软。", "en": "This clod is soft."},
        {"zh": "一口吞掉，慢慢消化。", "en": "One gulp, and I digest it slowly."},
        {"zh": "一点烂叶子。", "en": "A bit of rotten leaf."},
        {"zh": "我用头顶着往前拱。", "en": "I push it along with my head."},
        {"zh": "这比我重，拖不动。", "en": "This weighs more than I do; I can't drag it."},
        {"zh": "它贴在身上了。", "en": "It stuck to my body."},
        {"zh": "我绕过它，贴着土走。", "en": "I go around it, hugging the soil."},
        {"zh": "这里还有点湿。", "en": "Still damp here."},
        {"zh": "这根我啃不动。", "en": "I can't chew this one."},
        {"zh": "留着下面的路。", "en": "I'll save it for later."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的土在动。", "en": "The soil under me moves."},
        {"zh": "有个大家伙过来了。", "en": "Something big is coming."},
        {"zh": "我赶紧钻下去。", "en": "I burrow down in a hurry."},
        {"zh": "湿土能挡住。", "en": "Wet soil will hide me."},
        {"zh": "上面太亮了。", "en": "It's too bright up there."},
        {"zh": "那震动很重。", "en": "That vibration is heavy."},
        {"zh": "我把身子压进湿泥里。", "en": "I press my body down into the wet mud."},
        {"zh": "我听到了声音。", "en": "I heard it."},
        {"zh": "往更深处钻。", "en": "Deeper down."},
        {"zh": "这里的地面在震。", "en": "The ground here is shaking."},
        {"zh": "我钻进石头缝。", "en": "I slip into a stone crack."},
        {"zh": "别往这边找。", "en": "Don't search this way."},
        {"zh": "我缩成一小团，不动。", "en": "I curl into a small ball and stay still."},
        {"zh": "土会保护我。", "en": "The soil protects me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "那影子还在。", "en": "The shadow is still there."},
        {"zh": "我往下钻了一寸。", "en": "I went an inch deeper."},
        {"zh": "身体贴着泥不动。", "en": "My body presses flat to the mud."},
        {"zh": "它的鼻子贴着地面。", "en": "Its nose is to the ground."},
        {"zh": "土里没有光。", "en": "No light under the soil."},
        {"zh": "我屏住气，等脚步远些。", "en": "I hold my breath and wait for the steps to fade."},
        {"zh": "我动一下它就知道。", "en": "One move and it knows."},
        {"zh": "它踩在石头上了。", "en": "It stepped on stone."},
        {"zh": "我把头埋进去。", "en": "I bury my head."},
        {"zh": "它朝另一边看了。", "en": "It looked the other way."},
        {"zh": "等土停止震动。", "en": "Wait for the soil to settle."},
        {"zh": "湿土让我看不清。", "en": "The wet soil blinds me."},
        {"zh": "震动过去了。", "en": "The vibration passed."},
        {"zh": "我才慢慢伸出来。", "en": "Only now do I extend."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我甩着身子抽它的脚。", "en": "I whip my body at its feet."},
        {"zh": "黏在它鞋上。", "en": "I stick to its boot."},
        {"zh": "我缠住它的脚趾。", "en": "I wrap its toe."},
        {"zh": "我缠上去，又滑下来。", "en": "I coil around it and slide off."},
        {"zh": "这点力气太小。", "en": "This strength is tiny."},
        {"zh": "我扭动了一下。", "en": "I wriggle once."},
        {"zh": "它把我抖掉了。", "en": "It shook me off."},
        {"zh": "打不过，我一头钻进土。", "en": "Can't win, so I dive headfirst into the soil."},
        {"zh": "我只会这一招，缠上去。", "en": "This is all I have: wrap and hold."},
        {"zh": "我还是钻下去吧。", "en": "I'll just burrow down."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "下雨后泥土松了。", "en": "After the rain the soil loosened."},
        {"zh": "土面裂开，我先探出半截。", "en": "The soil splits, and I poke out half of me."},
        {"zh": "地面鼓起一小块。", "en": "A small bump on the ground."},
        {"zh": "我慢慢伸长了身体。", "en": "I stretch my body out."},
        {"zh": "我身上挂着湿土粒。", "en": "Wet clumps of soil cling to me."},
        {"zh": "这里湿得很。", "en": "It's very wet here."},
        {"zh": "我找到一条裂缝。", "en": "I found a crack."},
        {"zh": "周围没什么人。", "en": "Nobody much around."},
        {"zh": "我往有落叶的地方去。", "en": "I head for the fallen leaves."},
        {"zh": "地面有一条亮痕。", "en": "A bright line lies on the ground."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "土被烤干了，我也干了。", "en": "The soil dried, and so did I."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我重重摔在地上。", "en": "I hit the ground hard."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我泡得发胀。", "en": "Water swelled me up."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "整块土都翻开了。", "en": "The whole patch of soil turned over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根细尖穿透了我。", "en": "A thin point went through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "亮光让我浑身收紧。", "en": "The light made me clench."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得动不了。", "en": "Too hungry to move."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷钻进了湿土。", "en": "The current ran into wet soil."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有土。", "en": "There's no soil below."}
      ]
    }
  }
}
