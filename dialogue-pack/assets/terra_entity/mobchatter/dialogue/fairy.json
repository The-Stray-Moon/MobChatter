{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我提着一点光飘过去", "en": "I drift past carrying a little light."},
        {"zh": "翅膀小得几乎看不见", "en": "My wings are almost too small to see."},
        {"zh": "我绕着草叶打转", "en": "I circle the grass blades."},
        {"zh": "我飞得高高低低", "en": "I fly in dips and rises."},
        {"zh": "光点沿着我的路走", "en": "A trail of light follows my path."},
        {"zh": "我跳过一朵花", "en": "I hop over a flower."},
        {"zh": "我从根须的缝里钻过去。", "en": "I slip between the seams of the roots."},
        {"zh": "我飘着，没有声音", "en": "I drift, making no sound."},
        {"zh": "我贴着苔藓低低地飞。", "en": "I fly low along the moss."},
        {"zh": "光落在露水上", "en": "My light lands on the dew."},
        {"zh": "我停一下，又飞起来", "en": "I stop, then lift off again."},
        {"zh": "我从叶下钻过去", "en": "I slip under a leaf."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在半空中", "en": "I hover in place."},
        {"zh": "光明明灭灭的", "en": "My light brightens and dims."},
        {"zh": "我在听着风声", "en": "I'm listening to the wind."},
        {"zh": "我躲进这片影子，很凉快。", "en": "I hide in this patch of shade; it is cool."},
        {"zh": "我停在一片叶子上歇脚。", "en": "I rest on a single leaf."},
        {"zh": "我在看一朵花", "en": "I'm watching a flower."},
        {"zh": "我的翅膀轻轻扇着", "en": "My wings beat softly."},
        {"zh": "夜露落在我身上", "en": "Night dew settles on me."},
        {"zh": "我缩在花萼里不出来。", "en": "I stay tucked inside the calyx."},
        {"zh": "我很小，不容易看见", "en": "I'm small, easy to miss."},
        {"zh": "我很喜欢这里", "en": "I like it here."},
        {"zh": "我一点点往上飘", "en": "I drift a little upward."},
        {"zh": "光落在我的手心里", "en": "Light pools in my palm."},
        {"zh": "远处有人唱歌", "en": "Someone's singing far off."},
        {"zh": "我在叶尖上歇一歇", "en": "I rest on the leaf's tip."},
        {"zh": "光在我身边绕了一圈", "en": "Light curls once around me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看得见我？", "en": "You can see me?"},
        {"zh": "别把手伸到我面前", "en": "Don't reach out."},
        {"zh": "我不太喜欢被人看", "en": "I don't much like being looked at."},
        {"zh": "你有什么愿望", "en": "Do you have a wish?"},
        {"zh": "我飞过去，不碰你。", "en": "I will fly past without touching you."},
        {"zh": "你比树还要高", "en": "You're taller than the trees."},
        {"zh": "我飞到你眼睛那么高", "en": "I rise to the height of your eyes."},
        {"zh": "你身上的光太亮了", "en": "Your light is too bright."},
        {"zh": "你的手掌，比我整个人大。", "en": "Your palm is bigger than all of me."},
        {"zh": "你走你的，我不会跟。", "en": "Go on your way; I will not follow."},
        {"zh": "你要跟我来吗", "en": "Will you come along?"},
        {"zh": "我飞得并不快", "en": "I can't fly fast."},
        {"zh": "别在这时候说话", "en": "Don't speak just now."},
        {"zh": "你的影子罩住我了", "en": "Your shadow covers me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光暗下来", "en": "My light dimmed."},
        {"zh": "别动手来打我", "en": "Don't hit me."},
        {"zh": "我要躲起来的", "en": "I'm going to hide."},
        {"zh": "我的翅膀伤了", "en": "My wings are hurt."},
        {"zh": "我只有这么小", "en": "I'm so small."},
        {"zh": "疼，我要走了", "en": "It hurts; I'm leaving."},
        {"zh": "我够不到你了", "en": "I can't reach you now."},
        {"zh": "我在往草里钻", "en": "I'm burrowing into the grass."},
        {"zh": "我缩成一小点", "en": "I shrink to a dot."},
        {"zh": "让我躲一会儿", "en": "Let me hide a moment."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么东西", "en": "What is that?"},
        {"zh": "我不吃那些东西", "en": "I don't eat those."},
        {"zh": "你不用给我东西", "en": "You needn't give me anything."},
        {"zh": "我喜欢花，不吃蜜", "en": "I like flowers, not nectar."},
        {"zh": "那点光不够亮", "en": "That light isn't bright enough."},
        {"zh": "你举得太近了", "en": "You're holding it too close."},
        {"zh": "我更想要安静", "en": "I'd rather have quiet."},
        {"zh": "把它收回兜里", "en": "Put it back in your pocket."},
        {"zh": "花蜜？我脚边这片地上就有。", "en": "Nectar? There is plenty right here at my feet."},
        {"zh": "你真是太客气", "en": "You're very kind."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我了呀", "en": "You touched me."},
        {"zh": "差点被你踩到，我的光暗了。", "en": "Nearly stepped on, and my glow dims."},
        {"zh": "我退得非常远", "en": "I moved far away."},
        {"zh": "你实在太重了", "en": "You're too heavy."},
        {"zh": "我没事，只是吓了一跳", "en": "I'm fine, only startled."},
        {"zh": "我的翅膀差点折了", "en": "My wings nearly folded."},
        {"zh": "你压到草地了", "en": "You crushed the grass."},
        {"zh": "我绕开你飞走", "en": "I'll go around you."},
        {"zh": "这一下不疼的", "en": "That didn't hurt."},
        {"zh": "让我安静一会儿", "en": "Let me be."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还实在太小", "en": "I'm too small for that."},
        {"zh": "这件事我不懂", "en": "I don't understand that."},
        {"zh": "我更喜欢一个人飞", "en": "I prefer flying alone."},
        {"zh": "你去找别的仙灵吧", "en": "Find another fairy."},
        {"zh": "光会变暗下来", "en": "The light would dim."},
        {"zh": "这话让光暗了", "en": "Those words dim my light."},
        {"zh": "我现在该走了", "en": "I should go."},
        {"zh": "换一句别的说", "en": "Say another thing."},
        {"zh": "我害怕这种事", "en": "That frightens me."},
        {"zh": "那就在此别过", "en": "We part ways here."}
