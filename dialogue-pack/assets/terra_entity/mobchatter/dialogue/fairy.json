    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩着那朵野花", "en": "You're on that wildflower."},
        {"zh": "你别这么做了", "en": "Don't do that."},
        {"zh": "我会躲起来的", "en": "I'll hide."},
        {"zh": "你实在太吵了", "en": "You're too loud."},
        {"zh": "这里不欢迎吵闹", "en": "Noise isn't welcome here."},
        {"zh": "我就要离开了", "en": "I'm leaving."},
        {"zh": "我不想和你打架", "en": "I don't want to fight."},
        {"zh": "我打不过你的", "en": "I can't beat you."},
        {"zh": "但我能躲起来", "en": "But I can hide."},
        {"zh": "你别追着我了", "en": "Don't chase me."},
        {"zh": "你快停下来吧", "en": "Stop now."},
        {"zh": "我要叫别的仙灵来", "en": "I'll call the other fairies."},
        {"zh": "这朵花是我守着的", "en": "I keep this flower."},
        {"zh": "你弄坏了什么", "en": "What did you break?"}
