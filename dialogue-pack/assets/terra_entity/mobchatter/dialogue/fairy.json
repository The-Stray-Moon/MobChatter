    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在树叶后面", "en": "I'm behind the leaves."},
        {"zh": "你看不见我了", "en": "You can't see me now."},
        {"zh": "我的光也藏起来了", "en": "I've hidden my light too."},
        {"zh": "你走一步我就换地方", "en": "One step and I move."},
        {"zh": "我在这儿待不久", "en": "I won't stay here long."},
        {"zh": "手别伸到我这", "en": "Keep that hand off me."},
        {"zh": "你的鞋就在我花边上。", "en": "Your shoe is right at the edge of my flower."},
        {"zh": "你找错方向了", "en": "You're looking the wrong way."},
        {"zh": "很快我就飞走了", "en": "I'll fly off soon."},
        {"zh": "就一小会儿功夫", "en": "Just a moment."},
        {"zh": "我在树荫里面", "en": "I'm in the shade of the tree."},
        {"zh": "你听，光在响", "en": "Listen; the light hums."},
        {"zh": "我绕到你后面了", "en": "I'm behind you now."},
        {"zh": "我不擅长躲很久", "en": "I'm not good at hiding long."},
        {"zh": "你总归会累的", "en": "You'll tire eventually."}
      ]
    },
