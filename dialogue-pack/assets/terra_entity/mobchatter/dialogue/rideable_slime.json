{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跳一跳地走", "en": "I go along in hops."},
        {"zh": "落地的时候会扁一下", "en": "I flatten a little on landing."},
        {"zh": "我身上带点胶质的光", "en": "A gel-like sheen covers me."},
        {"zh": "我弹起来，比走快", "en": "Bouncing is faster than walking."},
        {"zh": "地上留一圈湿印", "en": "I leave a wet ring on the ground."},
        {"zh": "我跳得不高，可跳得远", "en": "Not high, but far."},
        {"zh": "我压过草，草又弹回来", "en": "I press the grass and it springs back."},
        {"zh": "一跳，身上的东西晃一下", "en": "One hop and what's on me wobbles."},
        {"zh": "我走路没有声音", "en": "I make no sound moving."},
        {"zh": "这一路我弹了十几下", "en": "I've bounced a dozen times on this stretch."},
        {"zh": "我是被召出来的，跳得稳", "en": "I was summoned, so I hop steadily."},
        {"zh": "我落到石头上，滑了一下", "en": "I landed on stone and slipped."},
        {"zh": "往前一跳，再往前一跳", "en": "A hop forward, then another."},
        {"zh": "我的身体在阳光下透亮", "en": "My body turns translucent in the sun."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我摊在那里不动", "en": "I settle into a puddle."},
        {"zh": "我身上的胶慢慢流", "en": "The gel on me flows slowly."},
        {"zh": "鞍挂在我背上，有点歪", "en": "The saddle sits crooked on my back."},
        {"zh": "我没有脚，只能一直晃着", "en": "I have no feet, so I always wobble"},
        {"zh": "我在等有人坐上来", "en": "I'm waiting for someone to sit on me."},
        {"zh": "我的边缘在动", "en": "My edges keep moving."},
        {"zh": "我身上的东西会掉一点", "en": "A bit of me drips off."},
        {"zh": "我泡在自己的胶里", "en": "I soak in my own gel."},
        {"zh": "我在看地上的影子", "en": "I'm looking at my shadow."},
        {"zh": "我在地上摊成一片", "en": "I spread out flat on the ground."},
        {"zh": "我一动不动，像一团水", "en": "I'm still, like a puddle."},
        {"zh": "身上的鞍带湿了", "en": "The saddle straps are damp."},
        {"zh": "我弹了一下，又落回来", "en": "I bounced once and settled back."},
        {"zh": "我被召出来，就得待着", "en": "Summoned, I have to stay."},
        {"zh": "我的形状会变", "en": "My shape shifts."},
        {"zh": "这里的地很干", "en": "The ground here is dry."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你要坐上来吗", "en": "Are you getting on?"},
        {"zh": "我背上有个鞍", "en": "There's a saddle on my back."},
        {"zh": "我软，坐上去不硌", "en": "I'm soft; you won't bruise."},
        {"zh": "你比我高，别踩我", "en": "You're taller; don't step on me."},
        {"zh": "我的身体会黏手", "en": "My body is sticky to the touch."},
        {"zh": "你弹一下试试", "en": "Try bouncing on me."},
        {"zh": "我很重，但很软", "en": "I'm heavy, and soft."},
        {"zh": "我不太会说话，我说得慢", "en": "I'm not much of a talker; I'm slow."},
        {"zh": "我身上的胶在动", "en": "The gel on me is moving."},
        {"zh": "你的鞋会湿掉", "en": "Your boots will get wet."},
        {"zh": "你看我，我就软下去一点", "en": "When you look at me I sag a little"},
        {"zh": "你笑，我就跳一下", "en": "You laugh, so I hop once."},
        {"zh": "你踩在我旁边，地是湿的", "en": "You're standing in the wet patch beside me."},
        {"zh": "我这样看着你，很礼貌了", "en": "Watching you like this is polite for a slime."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被砸得摊开，又慢慢鼓起", "en": "I'm smashed flat, then slowly swell back up"},
        {"zh": "我弹开，又聚回来", "en": "I bounced apart and gathered back."},
        {"zh": "我不疼，只是变形", "en": "No pain, only deformation."},
        {"zh": "我的胶掉了一块", "en": "A piece of my gel came off."},
        {"zh": "这一下，我扁了", "en": "That flattened me."},
        {"zh": "我慢慢流回原样", "en": "I slowly flow back to shape."},
        {"zh": "我退开，地上湿了一片", "en": "I pull back, leaving a wet patch."},
        {"zh": "我抖了一下身", "en": "I quivered."},
        {"zh": "我的鞍歪得更厉害", "en": "My saddle went crooked."},
        {"zh": "再来，我还能弹", "en": "Again; I can still bounce."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西对我没有用，我不吞", "en": "This is no use to me, so I won't swallow it"},
        {"zh": "你把东西举起来，我不够高", "en": "You raise it; I'm not tall enough."},
        {"zh": "甜的？我不感兴趣", "en": "Sweet? Not interested."},
        {"zh": "我什么都不吃，只跳", "en": "I eat nothing; I just bounce."},
        {"zh": "你放在地上，我压过去", "en": "Put it down and I'll bounce over it."},
        {"zh": "这个对我不重要", "en": "That doesn't matter to me."},
        {"zh": "我吸不进这个", "en": "I can't absorb it."},
        {"zh": "我吸不进去这个", "en": "I can't absorb that."},
        {"zh": "我只听召唤的人", "en": "I only listen to the summoner."},
        {"zh": "别拿这个引我", "en": "Don't bait me with that."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，我弹开了", "en": "You hit me and I bounced away."},
        {"zh": "我很软，撞着像撞床", "en": "I'm soft; it's like hitting a bed."},
        {"zh": "你陷进来一点", "en": "You sank in a little."},
        {"zh": "我退开，地上留一圈水", "en": "I pull back, leaving a wet ring."},
        {"zh": "这一下，我变扁了", "en": "That flattened me."},
        {"zh": "我又弹回原样", "en": "I bounce back to shape."},
        {"zh": "你踩我，脚会滑", "en": "Step on me and you'll slip."},
        {"zh": "我们撞在一起，黏住了", "en": "We collided and stuck."},
        {"zh": "我让开，慢慢挪", "en": "I shift aside slowly."},
        {"zh": "别推我，我会弹", "en": "Don't push; I bounce."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是被召出来的", "en": "I was summoned."},
        {"zh": "史莱姆的方式不是这样", "en": "Slimes don't do it that way."},
        {"zh": "同类会分裂，不会结伴", "en": "Our kind split, not pair."},
        {"zh": "这片地上还有别的", "en": "There are others on this ground."},
        {"zh": "我身上的胶会自己长回来", "en": "My gel grows back on its own."},
        {"zh": "这个不在召唤的内容里", "en": "That's not in the summoning."},
        {"zh": "鞍还挂在我背上", "en": "Stop asking."},
        {"zh": "我很软，也没什么可说", "en": "I'm soft and have little to say."},
        {"zh": "我连话都说得慢，别提这个", "en": "I can barely talk as it is, so don't ask that"},
        {"zh": "跳一下，就算回答", "en": "A hop counts as an answer."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我压过去，它就陷进来", "en": "I roll over it and it sinks in."},
        {"zh": "我不需要东西", "en": "I don't need things."},
        {"zh": "我用身体包住它", "en": "I wrap my body around it."},
        {"zh": "地上掉了什么", "en": "What fell here?"},
        {"zh": "我不捡，我直接吞", "en": "I don't pick up; I swallow."},
        {"zh": "它卡在我身体里", "en": "It's stuck inside me."},
        {"zh": "我吐出来给你", "en": "I spit it back out to you."},
        {"zh": "块太大，我不行", "en": "Too big for me."},
        {"zh": "上面沾了土，我不包它", "en": "It's covered in dirt, so I won't wrap it up"},
        {"zh": "就留在地上吧", "en": "Leave it on the ground."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有一点声响", "en": "A sound over there."},
        {"zh": "我弹了一下身", "en": "I hopped once."},
        {"zh": "那边地面平整", "en": "The ground's flat that way."},
        {"zh": "我要去那边跳", "en": "I'm going over there."},
        {"zh": "抓紧鞍带，我要弹了", "en": "Grip the strap; I'm bouncing."},
        {"zh": "我听见召唤的人在那边", "en": "I hear the summoner over there."},
        {"zh": "中间只隔一道沟", "en": "Only a ditch between us."},
        {"zh": "我先跳一下试试", "en": "Let me test one hop."},
        {"zh": "地面是平的，很好", "en": "Flat ground, good."},
        {"zh": "就是那头的方向", "en": "That direction."},
        {"zh": "我再跳了一下", "en": "Another hop."},
        {"zh": "这个高度可以", "en": "This height works."},
        {"zh": "我绕过去一下", "en": "I'll go around."},
        {"zh": "再弹一下就落定", "en": "One more hop and I settle."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下一下靠近", "en": "I close in hop by hop."},
        {"zh": "每次落地都比上次近", "en": "Every landing is closer than the last."},
        {"zh": "我一路弹过来，胶还在颤", "en": "I've bounced all this way, and my gel still quivers"},
        {"zh": "中间那块地不平", "en": "The ground in between isn't level."},
        {"zh": "我绕过那道沟", "en": "I go around that ditch."},
        {"zh": "我跳得有点歪", "en": "My hops are a little off."},
        {"zh": "我听见那边有动静", "en": "I hear movement there."},
        {"zh": "再跳这么两下", "en": "Two more hops."},
        {"zh": "我压扁了一点", "en": "I flattened a little."},
        {"zh": "就这样跳过去", "en": "This is the way."},
        {"zh": "它的边就在我一跳之外", "en": "Its edge is one hop away from me"},
        {"zh": "再来上那么一下", "en": "One more."},
        {"zh": "地面开始变软", "en": "The ground's gone soft."},
        {"zh": "我准备落下去", "en": "I'm ready to land."},
        {"zh": "落下去就到了", "en": "Just a drop down."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跳压过去", "en": "I hop and press down on it."},
        {"zh": "软东西撞软的", "en": "Soft against soft."},
        {"zh": "这一下没多大劲", "en": "That had little force."},
        {"zh": "它身上沾了我的胶", "en": "It's got my gel on it."},
        {"zh": "我一下弹开了", "en": "I bounced off."},
        {"zh": "我压住它，它动不了", "en": "I press it down and it can't move."},
        {"zh": "我又跳起来身", "en": "I hop up again."},
        {"zh": "这一下够它滑一跤", "en": "That's enough to make it slip."},
        {"zh": "我没打算伤人", "en": "I don't mean to hurt anyone."},
        {"zh": "我又落回原处", "en": "I settle back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一道光落地，我成形了", "en": "A flash lands and I take shape."},
        {"zh": "我先瘫成一团，再站起来", "en": "I puddle first, then rise."},
        {"zh": "鞍扣在背上了", "en": "The saddle buckles on."},
        {"zh": "这片地太干了", "en": "This ground is rather dry."},
        {"zh": "我刚落地，弹了两下", "en": "No sooner landed, I bounced twice."},
        {"zh": "我是被召出来的，不是生的", "en": "I was summoned, not born."},
        {"zh": "地上有个湿印", "en": "A wet ring on the ground."},
        {"zh": "我的边缘还在流", "en": "My edges are still flowing."},
        {"zh": "我抬头看召唤的人", "en": "I look up at the summoner."},
        {"zh": "我身上的光在动", "en": "The sheen on me shifts."},
        {"zh": "我试着往前跳", "en": "I try a hop forward."},
        {"zh": "这具身体很软", "en": "This body is very soft."},
        {"zh": "我站稳了，虽然没脚", "en": "I'm set, though I have no feet."},
        {"zh": "你什么时候上来都行", "en": "Get on whenever you like."},
        {"zh": "我身上还有水", "en": "There's still water on me."},
        {"zh": "我落下来，草被压平", "en": "I land and the grass flattens."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我烤干了一点", "en": "Fire dried a bit of me out."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，扁了一瞬", "en": "I landed and flattened for a moment."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水和我一样，我散在里面", "en": "Water is like me; I spread in it."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我溅了一地", "en": "The blast splattered me everywhere."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西穿过去，洞合上了", "en": "Something pierced through; the hole closed."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，我整团亮了", "en": "The spell hit and my whole blob lit."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，只是越来越干", "en": "I don't eat; I only dry out."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打来，我身上噼啪响", "en": "Lightning struck and I crackled."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有地，我一直往下", "en": "No ground in the void; I fall on."}
      ]
    }
  }
}
