{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里一缩一张。", "en": "I pulse through the water."},
        {"zh": "我的触手在水下飘。", "en": "My tentacles trail beneath me."},
        {"zh": "我慢慢浮到浅处。", "en": "I drift up into the shallows."},
        {"zh": "水流把我推向岸边。", "en": "The current pushes me shoreward."},
        {"zh": "我上下浮动，像片布。", "en": "I bob up and down like cloth."},
        {"zh": "我在暗礁间穿过去。", "en": "I pass between the reef rocks."},
        {"zh": "透明的水母跟着我。", "en": "The clear water carries me along."},
        {"zh": "我漂过一片海草。", "en": "I drift over seagrass."},
        {"zh": "我的伞盖一开一合。", "en": "My bell opens and closes."},
        {"zh": "我的触手拖得很长。", "en": "My tentacles trail far behind."},
        {"zh": "我沉到沙上，触手还漂着。", "en": "I sink to the sand, tentacles still drifting."},
        {"zh": "粉色水母，飘过珊瑚尖。", "en": "A pink jellyfish drifts past the coral tips."},
        {"zh": "我浮上水面，又沉下。", "en": "I rise to the surface and sink again."},
        {"zh": "水压让我的身体变得紧。", "en": "The pressure tightens my body."},
        {"zh": "我朝影子多的地方去。", "en": "I drift toward the shadowed water."},
        {"zh": "我漂过一块沉船的木板。", "en": "I float past a wreck's plank."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水中不动。", "en": "I hang in the water, motionless."},
        {"zh": "我的伞盖在慢慢收。", "en": "My bell slowly contracts."},
        {"zh": "水草缠住了我的触手。", "en": "Seagrass tangles my tentacles."},
        {"zh": "我在等水里的一点动静。", "en": "I wait for a stir in the water."},
        {"zh": "我的身体几乎透明。", "en": "My body is nearly clear."},
        {"zh": "鱼群绕开了我。", "en": "The fish give me a wide berth."},
        {"zh": "光从上面透下来照着我。", "en": "Light filters down onto me."},
        {"zh": "我把触手都垂到最底。", "en": "I let my tentacles hang deep."},
        {"zh": "我在水下听声音。", "en": "I listen underwater."},
        {"zh": "我缓缓调了个方向。", "en": "I slowly change heading."},
        {"zh": "水面上有影子走过。", "en": "A shadow passes overhead."},
        {"zh": "我一动不动，只是呼吸。", "en": "I only breathe, nothing more."},
        {"zh": "我的边缘泛着粉光。", "en": "My rim glows faint pink."},
        {"zh": "水底的沙很白。", "en": "The seabed sand is white."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "水只到你的腰，我够得到。", "en": "The water reaches your waist; I can reach you."},
        {"zh": "你在水里，腿很慢。", "en": "In the water, your legs are slow."},
        {"zh": "你身上有水花的声音。", "en": "You make splashing sounds."},
        {"zh": "我朝你漂过来了。", "en": "I'm drifting toward you."},
        {"zh": "别拿手来抓。", "en": "Don't grab with your hand."},
        {"zh": "我的触手很软。", "en": "My tentacles are soft."},
        {"zh": "你带着铁下水。", "en": "You brought iron into the water."},
        {"zh": "我的触手在水里散开。", "en": "My tentacles spread in the water."},
        {"zh": "你气息乱了。", "en": "Your breathing is off."},
        {"zh": "水会替我留着你。", "en": "The water will keep you for me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的伞盖被戳破了。", "en": "My bell has been punctured."},
        {"zh": "我软下去了。", "en": "I've gone limp."},
        {"zh": "水里散开一点白。", "en": "A little white spreads in the water."},
        {"zh": "我漂开了。", "en": "I drifted away."},
        {"zh": "别抓我的触手。", "en": "Don't grab my tentacles."},
        {"zh": "我变得很薄了。", "en": "I've grown very thin."},
        {"zh": "我的伞盖瘪下去，又鼓起来。", "en": "My bell collapses and swells again."},
        {"zh": "我还浮得起来。", "en": "I can still float."},
        {"zh": "水把我托住了。", "en": "The water holds me."},
        {"zh": "我慢慢合起伞。", "en": "I slowly close my bell."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里没有这种味道。", "en": "Nothing in the water smells like that."},
        {"zh": "你递得太低，触手先碰到了。", "en": "You hold it too low; my tentacles touch it first."},
        {"zh": "慢慢浮上来，触手先到。", "en": "Rising slowly, tentacles first."},
        {"zh": "这块东西会沉，我等它下来。", "en": "This morsel will sink; I wait for it to come down."},
        {"zh": "我只要碰一下。", "en": "I only need one touch."},
        {"zh": "你的手指在发抖。", "en": "Your fingers are trembling."},
        {"zh": "水花挡住了我。", "en": "The splash hides me."},
        {"zh": "你比它更有意思。", "en": "You're more interesting than that."},
        {"zh": "别动，我在靠近。", "en": "Hold still, I'm closing in."},
        {"zh": "再往下一点。", "en": "A little lower."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了我的伞盖。", "en": "You touched my bell."},
        {"zh": "我的触手扫过你的膝弯。", "en": "My tentacles sweep across the back of your knee."},
        {"zh": "我软软地荡开了。", "en": "I wavered away, soft."},
        {"zh": "别踢水，我的触手会散开。", "en": "Do not kick the water; my tentacles will spread."},
        {"zh": "我在你身侧漂着。", "en": "I drift beside you."},
        {"zh": "这点碰撞我就散。", "en": "At that touch I scatter."},
        {"zh": "水花遮了我的方向。", "en": "The splash hides my direction."},
        {"zh": "你的手臂麻了吧。", "en": "Your arm went numb, didn't it?"},
        {"zh": "我被你撞得缩进礁石缝。", "en": "Your bump folds me into the reef crevice."},
        {"zh": "再碰我就要贴上来。", "en": "Touch me again and I'll cling."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "水里没有这种事。", "en": "No such thing in these waters."},
        {"zh": "我只是一团软的东西。", "en": "I'm only a soft thing."},
        {"zh": "我们随水漂着就好。", "en": "Let's simply drift with the current."},
        {"zh": "你的肺太浅了。", "en": "Your lungs are too shallow."},
        {"zh": "水会把我带走。", "en": "The water will carry me off."},
        {"zh": "我不愿被惊扰。", "en": "I don't wish to be disturbed."},
        {"zh": "你站在岸上看吧。", "en": "Watch from the shore."},
        {"zh": "我没有手可以牵。", "en": "I have no hands to hold."},
        {"zh": "这问题沉下去了。", "en": "That question has sunk."},
        {"zh": "我要漂走了。", "en": "I'm drifting away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "水底的什么东西。", "en": "Something on the seabed."},
        {"zh": "我碰了碰它，它更凉了。", "en": "I touch it and it grows colder."},
        {"zh": "它在我身上滑下去。", "en": "It slides off me."},
        {"zh": "太重，我提不动。", "en": "Too heavy, I can't lift it."},
        {"zh": "水面上的东西会漂走。", "en": "Things on the surface drift away."},
        {"zh": "我把它卷在触手里。", "en": "I curl it in a tentacle."},
        {"zh": "我被缠住了。", "en": "I'm tangled now."},
        {"zh": "这一小块，连触手都懒得收。", "en": "This tiny piece isn't worth curling a tentacle for."},
        {"zh": "粉色的触手，飘在水里。", "en": "Pink tentacles drift in the water."},
        {"zh": "它穿过我的触手，掉了下去。", "en": "It slips through my tentacles and falls."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的腿在我这边。", "en": "Your legs are in my water."},
        {"zh": "这距离我碰得到。", "en": "I can touch you from here."},
        {"zh": "我展开触手。", "en": "I spread my tentacles."},
        {"zh": "水让你慢了。", "en": "The water slows you."},
        {"zh": "我随水漂过去。", "en": "I drift over with the current."},
        {"zh": "你踩起的水花，先碰到了我。", "en": "The splash you kicked reached me first."},
        {"zh": "水只有一个出口。", "en": "The water has one way out."},
        {"zh": "那是往我这来的。", "en": "And it comes toward me."},
        {"zh": "你气息越来越紧。", "en": "Your breath is tightening."},
        {"zh": "水波一晃，我已经贴在你腿边。", "en": "The water ripples and I am already at your leg."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的触手拉得很长。", "en": "My tentacles stretch long."},
        {"zh": "水花的声音盖住我。", "en": "The splashing covers my sound."},
        {"zh": "你在往深处退。", "en": "You're backing deeper."},
        {"zh": "深水对你不好。", "en": "Deep water isn't kind to you."},
        {"zh": "我一直漂在你侧后。", "en": "I drift at your flank."},
        {"zh": "你转身我就下沉。", "en": "You turn, I sink."},
        {"zh": "我的粉光在水里散开。", "en": "My pink glow spreads in the water."},
        {"zh": "你分不清哪是水哪是我。", "en": "You can't tell water from me."},
        {"zh": "再退一步就够了。", "en": "One more step is enough."},
        {"zh": "就是此刻。", "en": "This is the moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的触手贴上你的腿。", "en": "My tentacles cling to your leg."},
        {"zh": "你被蜇了一下。", "en": "You've been stung."},
        {"zh": "你拍水面想赶我走。", "en": "You slap the water to drive me off."},
        {"zh": "我软软地弹回水里。", "en": "I bounce softly back into the water."},
        {"zh": "你的动作慢了。", "en": "Your movements slowed."},
        {"zh": "这只是一触。", "en": "That was only a touch."},
        {"zh": "你还在水里。", "en": "You're still in the water."},
        {"zh": "我绕到另一侧。", "en": "I circle to the other side."},
        {"zh": "水会让我再靠近。", "en": "The water will bring me closer again."},
        {"zh": "别急着上岸。", "en": "Don't hurry ashore."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "水里浮起一团粉色。", "en": "A pink shape rises in the water."},
        {"zh": "我从深处慢慢浮上。", "en": "I drift up from the depths."},
        {"zh": "水面下多了一个影子。", "en": "A new shadow under the surface."},
        {"zh": "我张开伞盖。", "en": "I open my bell."},
        {"zh": "触手一根根垂下来。", "en": "Tentacles trail down one by one."},
        {"zh": "这片水很安静。", "en": "This water is very quiet."},
        {"zh": "我随着水流转。", "en": "I turn with the current."},
        {"zh": "粉光在水里晃。", "en": "Pink light sways underwater."},
        {"zh": "我在暗处撑开伞盖，等水动。", "en": "In the dark I open my bell and wait for the water to move."},
        {"zh": "等有东西下水。", "en": "For something to enter the water."}
      ]
    },
