    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "哒哒哒，瞄准敌人！", "en": "Bzzt! Aim at the enemy!"},
        {"zh": "砰，打中了！", "en": "Bang! Hit!"},
        {"zh": "呼呼，装填子弹！", "en": "Brrr, reloading!"},
        {"zh": "嘶嘶，瞄准射击！", "en": "Sss, aiming and shooting!"},
        {"zh": "哒哒哒，敌人倒下了！", "en": "Bzzt! Enemy down!"},
        {"zh": "咔嚓，子弹上膛！", "en": "Click, chambering!"},
        {"zh": "嘶嘶嘶，敌人的血线下降！", "en": "Sss, enemy health down!"},
        {"zh": "哒哒哒，快速移动！", "en": "Bzzt, quick movement!"},
        {"zh": "我猫着腰，穿过弹坑。", "en": "I crouch low and cross the crater."},
