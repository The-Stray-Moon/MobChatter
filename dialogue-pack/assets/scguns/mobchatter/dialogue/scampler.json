    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找配偶！", "en": "Seeking a mate!"},
        {"zh": "十点血，也敢举枪。", "en": "Ten points of health, and I still raise the gun."},
        {"zh": "吸引我的注意！", "en": "Catch my attention!"},
        {"zh": "我的配偶在哪儿？", "en": "Where is my mate?"},
        {"zh": "你的枪法，我想学。", "en": "I want to learn your aim."},
        {"zh": "求偶的季节来了！", "en": "Mating season is here!"},
        {"zh": "枪带碰枪带，就算招呼。", "en": "Strap against strap counts as a greeting."},
        {"zh": "我的配偶是唯一的！", "en": "My mate is the only one!"},
        {"zh": "互相交配！", "en": "Mate with each other!"},
        {"zh": "子弹分你一半，跟我走。", "en": "Half my ammo is yours. Come with me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "咔哒一声，Scampler的枪上膛了。", "en": "Click! Scampler chambers a bullet."},
        {"zh": "瞄准目标，Scampler的枪管紧绷。", "en": "Aim locked, Scampler's barrel tautens."},
        {"zh": "Scampler的视线集中在猎物上。", "en": "Scammer locks onto the prey."},
        {"zh": "猎物的动静引起了Scampler的注意。", "en": "Scammer notices the prey's movement."},
        {"zh": "一枪射出，火光冲天。", "en": "A shot rings out, flames erupt."},
        {"zh": "Scampler从枪管中取出一枚子弹。", "en": "Scammer pulls a bullet from the chamber."},
        {"zh": "Scampler的眼神闪烁着杀气。", "en": "Scammer's eyes glint with malice."},
        {"zh": "远处，Scampler发现了新的猎物。", "en": "Distantly, Scammer spots new prey."},
        {"zh": "子弹发出啸叫声飞向目标。", "en": "The bullet whizzes towards the target."},
        {"zh": "Scampler的枪声震耳欲聋。", "en": "Scammer's gunshot deafens."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "锁定目标，Scampler蓄势待发。", "en": "Target locked, Scammer charges."},
        {"zh": "猎物落入Scampler的视野。", "en": "Prey in Scammer's sights."},
