    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "脚被夹了！", "en": "Foot stuck!"},
        {"zh": "我这十点血，摔一下就见底。", "en": "Ten health. One fall and it's gone."},
        {"zh": "肚子被打穿了！", "en": "Stomach shot!"},
        {"zh": "血糊住镜片，我看不清。", "en": "Blood smears my lens; I can't see."},
        {"zh": "尾巴断了！", "en": "Tail broken!"},
        {"zh": "子弹卡在我的护目镜上。", "en": "A bullet lodged in my goggles."},
        {"zh": "尾巴被抓住了！", "en": "Tail grabbed!"},
        {"zh": "脑袋被击中了！", "en": "Head hit!"},
        {"zh": "我的翅膀被弹片削掉一半。", "en": "Shrapnel sheared half my wing off."},
        {"zh": "枪卡壳了，血也在漏。", "en": "My gun jammed, and I'm bleeding too."}
      ]
