    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的箱子里都是别人的东西。", "en": "Everything in my crate belongs to someone else."},
        {"zh": "滴答滴答，小心我！", "en": "Tic toc tic, watch out for me!"},
        {"zh": "盾牌后方，别想近身！", "en": "Behind my shield, no close!"},
        {"zh": "闪避，否则我会咬你！", "en": "Avoid me, or I'll bite you!"},
        {"zh": "嘶嘶嘶嘶，退后！", "en": "Sssssss, step back!"},
        {"zh": "警告，我的牙很锋利！", "en": "Warning, my teeth are sharp!"},
        {"zh": "嘶嘶嘶嘶，我要攻击了！", "en": "Sssssss, I'm attacking!"},
        {"zh": "小心，我的咬合力很强！", "en": "Beware, my bite is strong!"},
        {"zh": "滴答滴答，让我来教训你！", "en": "Tic toc tic, I'll teach you a lesson!"},
        {"zh": "嘶嘶嘶嘶，你逃不掉的！", "en": "Sssssss, you can't escape me!"}
      ]
    },
