        {"zh": "嘶嘶嘶嘶，我是供应小偷！", "en": "Sssss, I'm the supply scamp!"},
        {"zh": "滴答滴答，这里很安全！", "en": "Tic toc, this is safe!"},
        {"zh": "嘶嘶嘶嘶，物资就在眼前！", "en": "Sssss, supplies in sight!"},
        {"zh": "滴答滴答，来吧，我有你需要的！", "en": "Tic toc, come, I have what you need!"}
      ]
    },
