{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "呱呱叫着向前蹦蹦跳跳", "en": "Taps and jumps with a squeal"},
        {"zh": "移动中调整面具方向", "en": "Adjusts mask while walking"},
        {"zh": "快速奔跑，带起一阵尘土", "en": "Runs fast, kicking up dust"},
        {"zh": "低头寻找食物，快速吞咽", "en": "Bends to eat, gulps quickly"},
        {"zh": "发现食物就立即冲过去", "en": "Rushes to food upon sight"},
        {"zh": "跳跃着穿过灌木丛", "en": "Hops through bushes"},
        {"zh": "快速逃离敌人", "en": "Flees from enemies"},
        {"zh": "在空旷处悠闲地跳跃", "en": "Jumps around in open areas"},
        {"zh": "停下来整理面具和背包", "en": "Pauses to adjust mask and pack"},
        {"zh": "突然停下，警惕地环视四周", "en": "Suddenly stops, looking around"},
        {"zh": "我小跑时背包一晃一晃。", "en": "My pack bobs as I trot."},
        {"zh": "我顺着墙根往前挪。", "en": "I edge forward along the base of the wall."},
        {"zh": "我听见声响就改了道。", "en": "At the slightest noise I change course."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "蹲坐在地，轻声咕噜", "en": "Sits quietly, grunting softly"},
        {"zh": "缓慢梳理身上黄铜", "en": "Gently strokes its ancient brass"},
        {"zh": "轻摇脑袋，梳理着面具", "en": "Nods, grooming its mask"},
        {"zh": "盯着远方，思考着", "en": "Stares into the distance"},
        {"zh": "偶尔发出微弱的嘟囔声", "en": "Makes a soft, faint grumbling sound"},
        {"zh": "咀嚼着口中的食物", "en": "Chews its food"},
        {"zh": "轻轻抚摸身边的物品", "en": "Gently strokes nearby items"},
        {"zh": "翻找着背包中的东西", "en": "Flips through its pack"},
        {"zh": "伸展四肢，打个哈欠", "en": "Stretches, yawns"},
        {"zh": "舔舐着自己的面具", "en": "Licks its mask"},
        {"zh": "我把面具转了个方向。", "en": "I turn my mask to another angle."},
        {"zh": "我数着包里的弹丸。", "en": "I count the pellets in my pack."},
        {"zh": "我嗅了嗅黄铜的锈味。", "en": "I sniff the tang of brass."},
        {"zh": "我缩着脖子打了个嗝。", "en": "I duck my neck and hiccup."},
        {"zh": "我把东西往包里塞紧。", "en": "I wedge my things deeper into the pack."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "突然警觉，盯着玩家", "en": "Suddenly perks up, staring at the player"},
        {"zh": "我用远古黄铜换你一颗糖。", "en": "I'll trade ancient brass for a candy."},
        {"zh": "发现玩家后轻声叫唤", "en": "Grunts softly when it notices the player"},
        {"zh": "试图接近玩家，却又停住", "en": "Approaches the player, then stops"},
        {"zh": "警惕地盯着玩家，发出警告声", "en": "Squawks warningly, staring at the player"},
        {"zh": "靠近玩家，友好地咕噜", "en": "Approaches the player, grunting in a friendly way"},
        {"zh": "试图与玩家互动，发出邀请", "en": "Invites the player with a soft grunt"},
        {"zh": "观察玩家，寻找食物", "en": "Observes the player, looking for food"},
        {"zh": "突然警觉，准备攻击", "en": "Suddenly alert, prepares to attack"},
        {"zh": "发现玩家后快速逃跑", "en": "Rushes away when it notices the player"},
        {"zh": "我从面具后面偷看你。", "en": "I peek at you from behind my mask."},
        {"zh": "我退半步，又探出头。", "en": "I back off half a step, then peek out."},
        {"zh": "你的口袋鼓着，我嗅了嗅。", "en": "Your pocket bulges; I sniff at it."},
        {"zh": "我嗅了嗅你的袖子。", "en": "I sniff your sleeve."},
        {"zh": "被你一看，我缩成一团。", "en": "Under your gaze I shrink into a ball."},
        {"zh": "我举起爪子晃了晃。", "en": "I lift a paw and wave."},
        {"zh": "见你没动，我松了气。", "en": "Seeing you still, I relax."},
        {"zh": "我绕到你背后张望。", "en": "I circle behind you to look."},
        {"zh": "我把面具转向了你。", "en": "I turn my mask toward you."},
        {"zh": "我试探着靠近半步。", "en": "I test a half step closer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "面具裂开了！", "en": "My mask's cracked!"},
        {"zh": "面具磕歪了，我看不清路。", "en": "My mask knocked askew; I cannot see the path."},
        {"zh": "古代黄铜破了！", "en": "My ancient brass is broken!"},
        {"zh": "我的包开了，东西撒了一地。", "en": "My pack burst open and goods spilled."},
        {"zh": "这里！抓住我！", "en": "Catch me!"},
        {"zh": "后腿被弹片划开一道口。", "en": "Shrapnel opened a cut on my hind leg."},
        {"zh": "面具裂了，货还在背上。", "en": "The mask cracked — the cargo's still on my back."},
        {"zh": "别让我死在这里，包还没藏好。", "en": "Do not let me die here; my pack is not hidden."},
        {"zh": "谁来扶我一把，我起不来。", "en": "Someone help me up — I cannot rise."},
        {"zh": "面具歪了，我缩起腿。", "en": "Mask askew, I pull in my legs."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "诱惑你打开包裹！", "en": "You tempt it to open its包裹！"},
        {"zh": "你手上的食物它觊觎已久！", "en": "It covets the food in your hand！"},
        {"zh": "靠近点，我有吃的！", "en": "Come closer, I have food for you！"},
        {"zh": "你身上的气味吸引它！", "en": "Its scent is drawn to you！"},
        {"zh": "它盯着你的包裹！", "en": "It stares at your包裹！"},
        {"zh": "你散发的味道让它着迷！", "en": "It's entranced by your scent！"},
        {"zh": "它想要探索你的包裹！", "en": "It craves your包裹！"},
        {"zh": "包裹里的东西让它心动！", "en": "It's tempted by the contents！"},
        {"zh": "你身上的气味让它心动！", "en": "It's drawn to your scent！"},
        {"zh": "它想要品尝你的食物！", "en": "It wants to taste your food！"},
        {"zh": "古代黄铜一响，我就走不动。", "en": "One clink of ancient brass and I freeze."},
        {"zh": "我盯着黄铜，忘了害怕。", "en": "I stare at the brass and forget fear."},
        {"zh": "你手里有我想要的东西。", "en": "You hold something I want."},
        {"zh": "我把包口朝你掀开。", "en": "I tip my pack opening toward you."},
        {"zh": "我用面具蹭你的手。", "en": "I rub my mask against your hand."},
        {"zh": "只要一块黄铜就够了。", "en": "One piece of brass is enough."},
        {"zh": "我跟在你后面不肯走开。", "en": "I trail behind you and will not leave."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了Supply Scamp！", "en": "You collide with a Supply Scamp！"},
        {"zh": "小心！它会撞你！", "en": "Watch out！It will ram you！"},
        {"zh": "它撞向了你！", "en": "It rams into you！"},
        {"zh": "你撞倒了Supply Scamp！", "en": "You knock over a Supply Scamp！"},
        {"zh": "Supply Scamp撞上了障碍！", "en": "A Supply Scamp hits an obstacle！"},
        {"zh": "它被你撞翻了！", "en": "It's knocked over by you！"},
        {"zh": "你撞开了它的包裹！", "en": "You knock open its包裹！"},
        {"zh": "Supply Scamp撞开了障碍！", "en": "A Supply Scamp knocks open an obstacle！"},
        {"zh": "它撞破了包裹！", "en": "It breaks open a包裹！"},
        {"zh": "你撞散了它的包裹！", "en": "You scatter its包裹！"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "Supply Scamp寻找伴侣！", "en": "A Supply Scamp searches for a mate！"},
        {"zh": "它在寻找同伴！", "en": "It seeks a companion！"},
        {"zh": "它在寻找另一半！", "en": "It looks for a mate！"},
        {"zh": "它渴望找到伴侣！", "en": "It yearns for a mate！"},
        {"zh": "Supply Scamp想要繁殖！", "en": "A Supply Scamp desires to breed！"},
        {"zh": "它寻找着爱侣！", "en": "It seeks a lover！"},
        {"zh": "我把黄铜片推给对面的包。", "en": "I push a brass scrap toward the other pack."},
        {"zh": "Supply Scamp想要交配！", "en": "A Supply Scamp desires to mate！"},
        {"zh": "它渴望交配！", "en": "It yearns to mate！"},
        {"zh": "我把最亮的黄铜送给对方。", "en": "I offer my brightest brass to the other."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，爬行于地表.", "en": "Sibilant, crawling on the ground."},
        {"zh": "探头探脑，觅食于残骸.", "en": "Peering, foraging among debris."},
        {"zh": "啃咬着铁屑，咀嚼生铁.", "en": "Chewing on iron shavings."},
        {"zh": "轻巧跃过断壁残垣.", "en": "Leaping over ruins."},
        {"zh": "嗅闻金属气味，寻找补给.", "en": "Sniffing for metallic scent."},
        {"zh": "爬进箱子，翻找物品.", "en": "Crawling into crates, searching."},
        {"zh": "躲闪火光，藏于阴影.", "en": "Darting from light, hiding in shadows."},
        {"zh": "啃咬弹药，发出咔咔声.", "en": "Crunching ammo, making clicking noises."},
        {"zh": "在废墟中蠕动，寻找资源.", "en": "Wriggling through ruins, searching for resources."},
        {"zh": "吞下铁球，发出咕噜声.", "en": "Gulping down iron balls, making gurgling noises"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "发现目标，凝视片刻.", "en": "Locks on target, gazes."},
        {"zh": "眯起眼睛，紧盯着猎物.", "en": "Narrowing eyes, staring."},
        {"zh": "缓缓移动，接近目标.", "en": "Crawling closer to target."},
        {"zh": "伸出触手，触摸目标.", "en": "Extending feelers, touching target."},
        {"zh": "嗅闻空气，锁定猎物.", "en": "Sniffing air, locking on prey."},
        {"zh": "静默片刻，悄无声息.", "en": "Silent for a moment, unobtrusive."},
        {"zh": "盯紧猎物，准备攻击.", "en": "Fixing gaze on prey, ready to strike."},
        {"zh": "追踪目标，调整位置.", "en": "Tracking target, adjusting position."},
        {"zh": "靠近猎物，悄然无声.", "en": "Getting closer to prey, silently."},
        {"zh": "观察猎物，选择时机.", "en": "Observing prey, choosing moment."}
      ]
    },
