    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "角嘶鸣，步步为营！", "en": "Snarl, each step counts!"},
        {"zh": "蹄声急，火光频闪！", "en": "Hooves rush, flames flash!"},
        {"zh": "嘶吼震林，步步生烟！", "en": "Roar shakes the forest, smoke behind!"},
        {"zh": "野猪皮硬，步履无声！", "en": "Wild boar hide tough, steps silent!"},
        {"zh": "火器在手，步步为营！", "en": "Gun in hand, step by step!"},
        {"zh": "蹄声震林，火光如虹！", "en": "Hooves shake the forest, flames like a rainbow!"},
        {"zh": "野猪怒目，步步生风！", "en": "Wild boar glares, steps become gusts!"},
        {"zh": "火药味浓，步步生烟！", "en": "Gunpowder scent, smoke behind!"},
        {"zh": "林中怪兽，步步为营！", "en": "Forest creature, step by step!"},
        {"zh": "火器在握，步步生辉！", "en": "Gun in hand, every step shines!"},
        {"zh": "我不急，枪口一直跟着你。", "en": "I take my time; the muzzle stays on you."},
        {"zh": "蹄子踩着碎石，我绕到你侧面。", "en": "Hooves crunch gravel as I circle to your flank."}
      ]
    },
