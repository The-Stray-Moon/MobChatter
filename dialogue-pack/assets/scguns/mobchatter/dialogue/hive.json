{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嗡嗡嗡，我要吃你！", "en": "Buzz, buzz, I’m after you!"},
        {"zh": "蜜脾是我的食物！", "en": "Honeycomb is my food!"},
        {"zh": "我从蜂巢来！", "en": "I’m from the hive!"},
        {"zh": "看这里，我要咬你！", "en": "Look here, I’m going to bite you!"},
        {"zh": "蜂巢里爬出来，我饿了。", "en": "Out of the hive, and hungry."},
        {"zh": "蜜脾在我身上嗡嗡响。", "en": "Honeycomb hums on my body."},
        {"zh": "我用毒刺攻击！", "en": "I’ll sting you with my poison!"},
        {"zh": "我的力量很大！", "en": "I’m strong!"},
        {"zh": "蜜脾，我的战利品！", "en": "Honeycomb, my trophy!"},
        {"zh": "蜇你之前先吓吓你！", "en": "Scare you before I sting you!"},
        {"zh": "六条腿踩着蜜蜡走。", "en": "Six legs tread the beeswax."},
        {"zh": "翅膀带灰，扑得响。", "en": "Dusty wings beat loud."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "耐心等待猎物！", "en": "Waiting for prey..."},
        {"zh": "我的力量在增长！", "en": "Getting stronger..."},
        {"zh": "在这里休息一下！", "en": "Taking a rest..."},
        {"zh": "我需要更多蜜脾！", "en": "More honeycomb needed!"},
        {"zh": "静悄悄，等待时机！", "en": "Quiet, waiting for the right moment!"},
        {"zh": "我的巢穴很安全！", "en": "My hive is safe!"},
        {"zh": "保持警惕，敌人来了！", "en": "Alert, enemies coming!"},
        {"zh": "我在观察你！", "en": "Observing you..."},
        {"zh": "等待时机，然后攻击！", "en": "Waiting for the right moment to strike!"},
        {"zh": "把蜜脾往巢里推一推。", "en": "Nudging the honeycomb deeper into the nest."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在这里！我要抓你！", "en": "You’re here! I’m coming for you!"},
        {"zh": "你的位置被发现了！", "en": "Your position has been found!"},
        {"zh": "瞄准你了，瞄准你了！", "en": "Target locked, target locked!"},
        {"zh": "跑吧，我的蜂群比你快！", "en": "Run; my swarm is faster!"},
        {"zh": "躲不过的，蜂群已经散开。", "en": "No dodging, the swarm has spread."},
        {"zh": "我要用毒刺刺穿你！", "en": "I’m going to pierce you with my sting!"},
        {"zh": "别让我发现你！", "en": "Don’t let me find you!"},
        {"zh": "我已经看见你了！", "en": "I see you already!"},
        {"zh": "小心，我的毒刺！", "en": "Watch out, my sting!"},
        {"zh": "你的味道，我的蜂群记住了！", "en": "My swarm has your scent now!"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "触角折了，嗡嗡作响。", "en": "Torn antennae, buzzing."},
        {"zh": "翅膀破了，飞不起来。", "en": "Wings broken, can't fly."},
        {"zh": "身体受伤，痛得厉害。", "en": "Body injured, great pain."},
        {"zh": "脑袋撞伤，头晕目眩。", "en": "Headache from crash."},
        {"zh": "触角碰伤，嗡嗡作痛。", "en": "Antennae hurt, buzz."},
        {"zh": "翅膀破烂，动弹不得。", "en": "Wings ruined, can't move."},
        {"zh": "身体虚弱，飞行无力。", "en": "Weak body, poor flight."},
        {"zh": "触角受损，飞行摇晃。", "en": "Damaged antennae, wobbly flight."},
        {"zh": "翅膀受创，难以飞翔。", "en": "Wings hurt, hard to fly."},
        {"zh": "触角受伤，嗡嗡作响。", "en": "Torn antennae, buzz."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠近了，我的蜂蜜！", "en": "You come close, my honey!"},
        {"zh": "别想抢走我的蜜脾！", "en": "Don't try to take my honeycomb!"},
        {"zh": "我的巢穴里有美味！", "en": "Delicacies in my hive!"},
        {"zh": "饿的时候，毒刺更疼！", "en": "I sting harder when I'm hungry!"},
        {"zh": "蜂蜜的味道，你懂的。", "en": "Taste the honey. You know it."},
        {"zh": "我的家园，我的统治！", "en": "My home, my dominion!"},
        {"zh": "别惹我，否则尝尝我的毒！", "en": "Don't provoke me, feel the sting!"},
        {"zh": "用你的肉来填饱我的巢。", "en": "Fill my hive with your flesh!"},
        {"zh": "我的卵，未来的战士。", "en": "My eggs, future warriors."},
        {"zh": "靠近了，就做好牺牲的准备。", "en": "Come close, prepare to sacrifice."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "别碰蜂巢，会被蜇的！", "en": "Don't touch the hive; you'll be stung!"},
        {"zh": "我身上的蜜脾，撞一下就流。", "en": "One bump and the honeycomb drips off me."},
        {"zh": "你躲不开我的触角！", "en": "You can't avoid my antennae!"},
        {"zh": "我的身体坚硬如石！", "en": "My body is hard as stone!"},
        {"zh": "蜂蜡护着我，打不穿！", "en": "Wax shields me; you can't get through!"},
        {"zh": "我的身体是你的终点！", "en": "My body is your end point!"},
        {"zh": "这块蜂巢下面全是我的。", "en": "The comb under you is all mine."},
        {"zh": "我的身体，你的噩梦。", "en": "My body, your nightmare."},
        {"zh": "躲开，否则我会反击！", "en": "Get away, or I'll retaliate!"},
        {"zh": "我的身体，你的终点！", "en": "My body, your endpoint!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
