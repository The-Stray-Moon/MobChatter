    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "触碰蜜脾，甜美的诱惑。", "en": "Taste the honeyblock, sweet temptation."},
        {"zh": "怪异肉，滋养我的巢穴。", "en": "Mutated meat feeds my hive."},
