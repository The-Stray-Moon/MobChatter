      "lines": [
        {"zh": "嘶嘶，我好疼啊！", "en": "Ssssh, it hurts!"},
        {"zh": "哎呦，别碰我！", "en": "Ow, don't touch me!"},
        {"zh": "呜呜，我受伤了……", "en": "Oh, I'm hurt..."},
