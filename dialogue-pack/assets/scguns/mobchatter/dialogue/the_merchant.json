{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轻移步履，如同飞蛾翅膀拂过。", "en": "Flickering steps, like moth wings."},
        {"zh": "扇动着半透明的翅膀前行。", "en": "Flinging its translucent wings forward."},
        {"zh": "翅膀扇动间，发出轻微响声。", "en": "Slight sounds from its wing flapping."},
        {"zh": "闪烁着微弱光芒，轻盈地走动。", "en": "Glowing faintly, moving gracefully."},
        {"zh": "细长的触角在空中探来探去。", "en": "Long antennae probing the air."},
        {"zh": "在空中轻舞，寻找新的交易机会。", "en": "Dancing through the air, seeking deals."},
        {"zh": "翅膀振动时，带起一阵微风。", "en": "Wings vibrate, stirring a breeze."},
        {"zh": "翅膀上仿佛有夜空的星辰。", "en": "Wings adorned with starry skies."},
        {"zh": "在空中缓缓飘动，寻找食物。", "en": "Drifting in the air, seeking food."},
        {"zh": "翅膀边缘像燃烧的火苗。", "en": "Wings like flickering flames."},
        {"zh": "翅下挂着一排小零件叮当作响。", "en": "Small parts under its wings jingle as it moves."},
        {"zh": "它沿着柜台慢慢巡视货物。", "en": "It tours the counter, checking its wares."},
        {"zh": "翅膀掠过火药袋，带起粉尘。", "en": "Its wings brush a powder pouch, raising dust."},
        {"zh": "它挪到弹匣箱旁理货。", "en": "It shifts over to the magazine crate to sort stock."},
        {"zh": "翅尖扫过一排铜弹壳。", "en": "Its wingtip skims a row of brass casings."},
        {"zh": "它绕开地上的蓝图卷。", "en": "It steps around a rolled blueprint."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀轻轻抖动，仿佛在思考。", "en": "Wings gently shake, thinking."},
        {"zh": "静静地站立，如同夜色中的鬼火。", "en": "Standing still, like a ghostly fire."},
        {"zh": "轻轻扇动翅膀，享受宁静。", "en": "Gently flapping wings, enjoying peace."},
        {"zh": "翅膀偶尔轻摆，似在倾听。", "en": "Wings occasionally摆动, listening."},
        {"zh": "静默之中，翅膀似乎有秘密。", "en": "Silent wings, holding secrets."},
        {"zh": "翅膀轻颤，仿佛感受到了什么。", "en": "Wings tremble, sensing something."},
        {"zh": "静静地伫立，翅膀下藏着秘密。", "en": "Standing still, wings holding secrets."},
        {"zh": "翅膀轻轻摇动，像是在舞蹈。", "en": "Wings gently dance."},
        {"zh": "翅膀偶尔轻拍，似乎在自言自语。", "en": "Wings gently tap, muttering."},
        {"zh": "翅膀轻轻颤动，似乎在等待。", "en": "Wings gently tremble, waiting."},
        {"zh": "它把一枚弹壳反复擦了又擦。", "en": "It polishes one casing over and over."},
        {"zh": "翅下露出半张价目表。", "en": "Half a price list peeks from under its wing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "突然间，翅膀下露出贪婪的目光。", "en": "Suddenly, greedy eyes appear beneath wings."},
        {"zh": "翅膀紧绷，注视着玩家。", "en": "Tense wings, staring at the player."},
        {"zh": "翅膀紧闭，警惕地观察着。", "en": "Wings closed, cautiously observing."},
        {"zh": "我把货箱往身前挪了挪。", "en": "I nudge my crate a little closer."},
        {"zh": "翅膀半开，似乎想靠近。", "en": "Wings half-open, wanting to approach."},
        {"zh": "翅膀轻轻展开，注视玩家。", "en": "Wings gently spread, staring at the player."},
        {"zh": "翅膀轻轻扇动，凝视玩家。", "en": "Wings softly flapping, gazing at the player."},
        {"zh": "翅膀微微颤抖，眼神警惕。", "en": "Wings tremble slightly, eyes wary."},
        {"zh": "翅膀扇动间，眼神充满好奇。", "en": "Wings flapping, eyes curious."},
        {"zh": "翅膀轻轻张开，紧盯着玩家。", "en": "Wings gently open, fixating on the player."}
      ]
    },
    "hurt": {
