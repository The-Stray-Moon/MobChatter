        {"zh": "啊，我的盔甲碎了！", "en": "Ouch, my armor broke!"},
        {"zh": "嘶嘶，我的触角受伤了！", "en": "Ssssh, my antennae are hurt!"},
        {"zh": "呜呜，我的触须受伤了……", "en": "Oh, my feelers are hurt..."},
        {"zh": "嘶嘶，这可不妙！", "en": "Ssssh, this is bad!"},
        {"zh": "哎，我的盔甲受损了！", "en": "Ouch, my armor is damaged!"},
        {"zh": "嘶嘶，我不行了……", "en": "Ssssh, I can't take it..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你那把枪真好看，卖给我吧。", "en": "Nice gun, sell it to me."},
        {"zh": "来，看我的货物。", "en": "Check out my wares."},
        {"zh": "别走，你错过了好东西。", "en": "Don't go, you missed something."},
        {"zh": "用枪换我的宝石怎么样？", "en": "How about trading your gun for some gems?"},
        {"zh": "我的东西都是真货。", "en": "Everything I have is genuine."},
        {"zh": "看看这些独特的武器。", "en": "Check out these unique weapons."},
        {"zh": "这些盔甲能保护你。", "en": "These armor pieces will protect you."},
        {"zh": "我的宝藏里有你想要的。", "en": "My treasures have what you want."},
        {"zh": "用什么来交易？", "en": "What do you want to trade?"},
        {"zh": "我会用最好的价格交易。", "en": "I trade at the best price."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "别撞我的秤，秤会歪。", "en": "Don't jostle my scale; it will drift."},
        {"zh": "别撞货箱，里面的东西要卖。", "en": "Don't bump the crate; the goods are for sale."},
        {"zh": "小心点，我手里有枪。", "en": "Be careful, I have a gun."},
        {"zh": "我的货不卖给靠太近的人。", "en": "I do not sell to people who crowd me."},
        {"zh": "我的枪很危险。", "en": "My gun is dangerous."},
        {"zh": "你挡着我摆货的位置了。", "en": "You're standing where I lay out wares."},
        {"zh": "我不喜欢被人碰。", "en": "I don't like being touched."},
        {"zh": "你撞痛我了。", "en": "You hurt me."},
        {"zh": "我被你撞倒了。", "en": "I was knocked over by you."},
        {"zh": "你小心点，别动我。", "en": "Be careful, don't touch me."}
      ]
    },
