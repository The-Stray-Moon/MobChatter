        {"zh": "机械生命，觉醒！", "en": "Mechanical life awakens."},
        {"zh": "古堡深处，铁甲再现！", "en": "Iron knights from the dungeons."},
        {"zh": "齿轮转动，骑士降临！", "en": "Gears turn, knight arrives."},
