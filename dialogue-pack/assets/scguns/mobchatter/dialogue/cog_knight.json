{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咔咔咔，我来磨刀了！", "en": "Clank, time to sharpen!"},
        {"zh": "我得确保每个齿轮都在位！", "en": "Each cog must be in place!"},
        {"zh": "小心，这是我的领域！", "en": "Watch out, this is my turf!"},
        {"zh": "火药，我的最爱！", "en": "Gunpowder, my favorite!"},
        {"zh": "金属和齿轮是我的武器！", "en": "Metal and gears are my tools!"},
        {"zh": "铁靴每步都踩出火星。", "en": "My iron boots strike sparks with every step."},
        {"zh": "古代黄铜闪闪发光！", "en": "Ancient brass glitters!"},
        {"zh": "无烟煤粒为我提供能量！", "en": "Bituminous coal powers me!"},
        {"zh": "我从不靠近敌人！", "en": "Enemies stay away from me!"},
        {"zh": "我的攻击精准无比！", "en": "My attacks are precise!"},
        {"zh": "铁靴踩碎石板。", "en": "My iron boots crush the flagstones."},
        {"zh": "披风下摆擦过齿轮。", "en": "My cape's hem scrapes the gears."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "等待着下一次战斗！", "en": "Waiting for the next fight!"},
        {"zh": "这里很安全，我可以放松。", "en": "Safe here, I can relax."},
        {"zh": "黄铜关节一转，枪就上膛。", "en": "A brass joint turns and the gun is loaded."},
        {"zh": "我只需要火药和黄铜！", "en": "Just need gunpowder and brass!"},
        {"zh": "我的机械之心永远不灭！", "en": "My mechanical heart never fades!"},
        {"zh": "古代黄铜可以打造武器！", "en": "Ancient brass for weapons!"},
        {"zh": "无烟煤粒提供持久能量！", "en": "Bituminous coal for power!"},
        {"zh": "等待敌人送上门来！", "en": "Waiting for the enemy to come!"},
        {"zh": "我的声音不会被忽视！", "en": "My voice cannot be ignored!"},
        {"zh": "黄铜骑士站着，齿轮空转。", "en": "The brass knight stands, gears idling."},
        {"zh": "我擦着剑刃上的火药灰。", "en": "I wipe powder ash off my blade."},
        {"zh": "头盔里传来滴答声。", "en": "A ticking comes from inside my helm."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "黄铜齿轮咬合，我站起来了。", "en": "Brass gears mesh, and I rise."},
        {"zh": "我要找找你在哪里！", "en": "Finding you now!"},
        {"zh": "你的存在对我很重要！", "en": "You're important to me!"},
        {"zh": "别躲，我看到你了！", "en": "Don't hide, I see you!"},
        {"zh": "你无法逃过我的攻击！", "en": "You can't escape my attack!"},
        {"zh": "准备好迎接攻击了吗？", "en": "Ready for my attack?"},
        {"zh": "你躲不过我的利刃！", "en": "You can't avoid my blade!"},
        {"zh": "你在这里不会活得太久！", "en": "You won't last long here!"},
        {"zh": "我要让你尝尝我的厉害！", "en": "Taste my might!"},
        {"zh": "别动，我要攻击了！", "en": "Don't move, I'm attacking!"},
        {"zh": "面甲缝隙里的光转向你。", "en": "The light in my visor turns to you."},
        {"zh": "我抬手，行了个铁礼。", "en": "I raise a hand in an iron salute."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "齿轮生锈了！", "en": "Rusty gears!"},
        {"zh": "零件受损！", "en": "Damaged parts!"},
        {"zh": "金属吱吱响！", "en": "Metal creaks!"},
        {"zh": "机械故障！", "en": "Mechanical failure!"},
        {"zh": "齿轮断了！", "en": "Gears broken!"},
        {"zh": "零件脱落！", "en": "Part missing!"},
        {"zh": "摩擦生热！", "en": "Friction heats up!"},
        {"zh": "生锈腐蚀！", "en": "Corroded by rust!"},
        {"zh": "运转缓慢！", "en": "Moving slow!"},
        {"zh": "动力不足！", "en": "Power waning!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你会受到我的火焰吗？", "en": "Will you feel my flames?"},
        {"zh": "来吧，感受我的铁锤吧。", "en": "Come on, feel my iron hammer."},
        {"zh": "我的机关早已准备好了。", "en": "My mechanisms are ready."},
        {"zh": "你挡不住黄铜齿轮和枪口。", "en": "You cannot stop brass gears and a muzzle."},
        {"zh": "火药，古代黄铜，我的战利品。", "en": "Gunpowder, ancient brass, my spoils."},
        {"zh": "你是为战斗而来吗？", "en": "Are you here for a fight?"},
        {"zh": "我的齿轮不会停下。", "en": "My gears won't stop."},
        {"zh": "你无法摧毁我。", "en": "You can't break me."},
        {"zh": "你的火焰对我无用。", "en": "Your flames are useless against me."},
        {"zh": "我是机械的完美化身。", "en": "I am the perfect machine."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "齿轮膝盖撞过来，让一让。", "en": "These gear knees hurt, step aside."},
        {"zh": "我们不能和平共处。", "en": "We can't coexist."},
        {"zh": "我要去破坏你的防线。", "en": "I'm going to break your line."},
        {"zh": "你的攻击无效。", "en": "Your attacks are无效。"},
        {"zh": "我粉碎一切障碍。", "en": "I crush all obstacles."},
        {"zh": "黄铜盔甲上只有凹痕。", "en": "Just a dent in the brass plate."},
        {"zh": "我将你的武器打回原形。", "en": "I'll turn your weapons back on you."},
        {"zh": "我的存在即是战争。", "en": "My existence is war."},
        {"zh": "你试图伤害我？", "en": "You try to hurt me?"},
        {"zh": "我的膝盖齿轮蹭过你的盾。", "en": "The gear in my knee scrapes across your shield."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的机器需要伴侣。", "en": "My machines need a partner."},
        {"zh": "同型号的齿轮，该咬在一起。", "en": "Gears of the same make should mesh."},
        {"zh": "我们是机械的后代。", "en": "We are the descendants of machines."},
        {"zh": "你理解我的使命吗？", "en": "Do you understand my mission?"},
        {"zh": "黄铜齿轮，也该有另一半。", "en": "Even a brass gear needs its other half."},
        {"zh": "我的机械心脏跳动。", "en": "My mechanical heart beats."},
        {"zh": "我的存在是为了战斗。", "en": "My existence is for battle."},
        {"zh": "我来自机器的深处。", "en": "I come from the depths of machines."},
        {"zh": "我是战斗之神。", "en": "I am the god of combat."},
        {"zh": "我们的齿轮将永远啮合。", "en": "Our gears will always mesh."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "齿轮咔哒作响，我捡起火药。", "en": "The gears clatter as I pick up gunpowder."},
        {"zh": "从我的盔甲中滑出一粒无烟煤。", "en": "A bit of smokeless coal slides from my armor."},
        {"zh": "我找到一块古代黄铜，握在手中。", "en": "I grasp some ancient bronze in my hand."},
        {"zh": "我的机甲发出低沉的嗡嗡声。", "en": "My mech hums lowly."},
        {"zh": "我拾起一颗无烟煤粒，感觉它的坚硬。", "en": "I pick up a smokeless coal and feel its hardness."},
        {"zh": "火药堆在了我脚下，很沉重。", "en": "The gunpowder is heavy under my feet."},
        {"zh": "盔甲上的齿轮摩擦，发出轻微声响。", "en": "The gears in my armor rub together lightly."},
        {"zh": "从盔甲缝隙中滑出一把金属碎片。", "en": "A piece of metal slides from my armor."},
        {"zh": "无烟煤在手中闪烁着幽暗光芒。", "en": "The smokeless coal glows dimly in my hand."},
        {"zh": "盔甲的碎片落下，落入火药中。", "en": "Pieces of my armor fall into the gunpowder."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准目标，我的机械臂抬起。", "en": "Target acquired, my arm rises."},
        {"zh": "视线聚焦，锁定目标。", "en": "My sight focuses, locking onto a target."},
        {"zh": "我的眼睛扫描周围环境，寻找敌人。", "en": "I scan the environment for enemies."},
        {"zh": "火药点燃，准备射击。", "en": "The gunpowder ignites, ready to fire."},
        {"zh": "瞄准敌人的弱点，准备攻击。", "en": "Targeting the enemy's weak point."},
        {"zh": "我瞄准远处的敌人，机械臂抬起。", "en": "I aim at the distant enemy, my arm rises."},
        {"zh": "盔甲的机械部件开始转动。", "en": "My armor's mechanical parts begin to turn."},
        {"zh": "瞄准敌人的盔甲缝隙，攻击即将来临。", "en": "Targeting the enemy's armor gap."},
        {"zh": "瞄准敌人的弱点，准备一击致命。", "en": "Targeting the enemy's vital point."},
        {"zh": "我瞄准敌人的头部，准备一击毙命。", "en": "I aim at the enemy's head for a fatal strike."},
        {"zh": "甲片响了一声。", "en": "One plate of my armor rings."},
        {"zh": "我听见你踩断的枯枝。", "en": "I heard the twig you snapped."},
        {"zh": "风向、距离，都记下了。", "en": "Wind and range, both noted."},
        {"zh": "剑尖慢慢抬了起来。", "en": "My blade tip rises slowly."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准，锁定，发射。", "en": "Target, lock, fire."},
        {"zh": "瞄准目标，锁定后射击。", "en": "Target, lock, then fire."},
        {"zh": "瞄准敌人的弱点，精准射击。", "en": "Target the enemy's weak point, fire accurately."},
        {"zh": "瞄准，锁定，然后射击。", "en": "Target, lock, then fire."},
        {"zh": "瞄准，瞄准，瞄准，然后射击。", "en": "Target, target, target, then fire."},
        {"zh": "锁定目标，瞄准，射击。", "en": "Lock on, target, fire."},
        {"zh": "瞄准敌人，锁定，射击。", "en": "Target the enemy, lock, fire."},
        {"zh": "瞄准，锁定，然后精确射击。", "en": "Target, lock, then fire accurately."},
        {"zh": "瞄准目标，然后射出一发炮弹。", "en": "Target, then fire a shell."},
        {"zh": "我侧身，露出剑脊。", "en": "I turn my flank, showing the blade's spine."},
        {"zh": "火药在膛里压实。", "en": "Powder packed in the chamber."},
        {"zh": "齿轮咬到最后一齿。", "en": "The gear clicks to its last tooth."},
        {"zh": "三步之内，你躲不开。", "en": "Within three steps, you can't dodge."},
        {"zh": "我把重心压在前脚。", "en": "I shift my weight to the front foot."},
        {"zh": "剑锋上的锈光一闪。", "en": "Rust glints along my edge."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "挥剑如雷，你将承受冲击！", "en": "Sword strikes like thunder."},
        {"zh": "金属摩擦声，准备战斗！", "en": "Metal scrape, get ready to fight."},
        {"zh": "护甲闪耀，铁甲骑士！", "en": "Armour gleams, Iron Knight."},
        {"zh": "瞄准敌人的弱点！", "en": "Target the weak spot!"},
        {"zh": "火药桶爆裂，小心！", "en": "Powder keg bursts, beware!"},
        {"zh": "黄铜齿轮，转动杀机！", "en": "Bronze gears, deadly motion."},
        {"zh": "无烟煤粒，燃烧的弹药！", "en": "Coal pellets, burning ammo."},
        {"zh": "盔甲下是无情的心！", "en": "Armour conceals cold steel."},
        {"zh": "熔炉锻造，铁血战士！", "en": "Forged in furnaces, iron warriors."},
        {"zh": "古战甲，铸就永恒！", "en": "Ancient armour, eternal defence."},
        {"zh": "一剑劈向你的肩！", "en": "My blade chops at your shoulder!"},
        {"zh": "铁拳砸在你的盾上！", "en": "My iron fist slams your shield!"},
        {"zh": "火药在你脚边炸开！", "en": "Powder bursts at your feet!"},
