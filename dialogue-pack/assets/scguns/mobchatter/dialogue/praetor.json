        {"zh": "低吼着踏步前行", "en": "Growl and take strides"},
        {"zh": "铁面具闪烁着寒光", "en": "Iron mask glares"},
        {"zh": "缓慢逼近，步步为营", "en": "Slowly advance, step by step"},
        {"zh": "火器闪烁，准备开火", "en": "Weapons glint, ready to fire"},
        {"zh": "逼近猎物，瞄准射击", "en": "Close in, aim and shoot"},
        {"zh": "弹匣上膛，脚步不停。", "en": "Magazine seated, steps never stop."},
        {"zh": "枪口压得低，慢慢靠近。", "en": "Muzzle low, closing in slowly."}
      ]
    },
