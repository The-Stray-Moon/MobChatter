    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "黄铜面具下，我慢慢上膛。", "en": "Under the brass mask, I chamber a round."},
        {"zh": "步履沉重，逼近敌人", "en": "Heavy steps, close in"},
        {"zh": "挥舞铁面具威胁", "en": "Waving iron mask threats"},
