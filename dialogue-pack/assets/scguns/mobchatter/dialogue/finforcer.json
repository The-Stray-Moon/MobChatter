{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着水底的沙走。", "en": "I walk on the sandy bottom."},
        {"zh": "枪口垂着，滴水。", "en": "My muzzle hangs, dripping."},
        {"zh": "脚蹼推开一片水草。", "en": "My fins push the weeds aside."},
        {"zh": "我贴着岸边的礁石走。", "en": "I move along the shoreline rocks."},
        {"zh": "气泡从我耳边升上去。", "en": "Bubbles rise past my ear."},
        {"zh": "我慢慢从浅滩上岸。", "en": "I ease up out of the shallows."},
        {"zh": "盔甲里灌了水。", "en": "Water fills my armor."},
        {"zh": "我拖着枪在泥里走。", "en": "I drag the gun through mud."},
        {"zh": "水草在我脚上缠了一圈。", "en": "Weeds wrap once around my foot."},
        {"zh": "我朝着浅水处挪。", "en": "I shift toward the shallows."},
        {"zh": "鱼群被我惊散了。", "en": "The school scatters from me."},
        {"zh": "我在水线上来回走。", "en": "I pace the waterline."},
        {"zh": "我一步一步往深处去。", "en": "Step by step into deeper water."},
        {"zh": "枪托碰在岩石上响。", "en": "The stock knocks a rock."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我泡在水里等。", "en": "I wait, soaking in the water."},
        {"zh": "枪管上还挂着藻。", "en": "Algae clings to my barrel."},
        {"zh": "我换了弹匣。", "en": "I swap the magazine."},
        {"zh": "鳃盖缓了一下。", "en": "My gill plate eases."},
        {"zh": "潮水推着我的腿。", "en": "The tide nudges my legs."},
        {"zh": "我把枪举出水面。", "en": "I lift the gun clear of the water."},
        {"zh": "我把火药袋捂干。", "en": "I keep the powder pouch dry."},
        {"zh": "有鱼在我脚边转。", "en": "A fish circles my feet."},
        {"zh": "我盯着水线上的动静。", "en": "I watch the waterline."},
        {"zh": "镜片上全是水珠。", "en": "Water beads on my lenses."},
        {"zh": "我抖了抖护甲。", "en": "I shake my armor out."},
        {"zh": "阳光照到浅滩上。", "en": "Sun reaches the shallows."},
        {"zh": "我等一个会动的东西。", "en": "I wait for something that moves."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在干地上。", "en": "You're standing on dry ground."},
        {"zh": "这里的水不深。", "en": "The water isn't deep here."},
        {"zh": "我认得你的轮廓。", "en": "I know your outline."},
        {"zh": "再看看你的手。", "en": "Let me see your hands."},
        {"zh": "你的靴子在岸边。", "en": "Your boots are on the bank."},
        {"zh": "我不想弄湿你。", "en": "I'd rather not soak you."},
        {"zh": "退开半步吧。", "en": "Half a step back, please."},
        {"zh": "你身上没有海味。", "en": "You don't smell of the sea."},
        {"zh": "你也在找东西？", "en": "Looking for something too?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我咳出一口水。", "en": "I cough up water."},
        {"zh": "我往水里退。", "en": "I fall back toward the water."},
        {"zh": "我手上的枪晃了。", "en": "The gun wavered in my hand."},
        {"zh": "血在水里淡开。", "en": "Blood thins in the water."},
        {"zh": "我还能开火。", "en": "I can still fire."},
        {"zh": "我咬紧了牙。", "en": "I clench my teeth."},
        {"zh": "鳃盖动得更快了。", "en": "My gills work faster."},
        {"zh": "我记住你的位置。", "en": "I have your position."},
        {"zh": "我得换个掩体。", "en": "I need better cover."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那条是鱼吗？", "en": "Is that a fish?"},
        {"zh": "扔进水里来。", "en": "Drop it in the water."},
        {"zh": "这条还活着。", "en": "This one's still alive."},
        {"zh": "别举得太高。", "en": "Don't hold it too high."},
        {"zh": "我一眼就看出来了。", "en": "I spotted it at once."},
        {"zh": "慢慢放下来。", "en": "Lower it slowly."},
        {"zh": "我只要你手里那条。", "en": "I just want that fish."},
        {"zh": "味道飘到这儿了。", "en": "The smell drifted over."},
        {"zh": "你再靠近些。", "en": "Come a little closer."},
        {"zh": "别急着把它拿走。", "en": "Don't take it away yet."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩进我的水里了。", "en": "You stepped into my water."},
        {"zh": "水花溅了半身。", "en": "Splash up to the waist."},
        {"zh": "我的护甲很滑。", "en": "My armor is slick."},
        {"zh": "退开，我在瞄准。", "en": "Back off. I'm aiming."},
        {"zh": "别碰我的枪口。", "en": "Don't touch my muzzle."},
        {"zh": "我脚下一滑。", "en": "My foot slipped."},
        {"zh": "湿地站不稳。", "en": "Wet ground gives no footing."},
        {"zh": "这一撞我记住了。", "en": "I'll remember that bump."},
        {"zh": "你踩到我的脚蹼。", "en": "You stepped on my fin."},
        {"zh": "让开这条水线。", "en": "Clear this waterline."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "水里还有别的事。", "en": "There are other things in the water."},
        {"zh": "我在等一个目标。", "en": "I'm waiting on a target."},
        {"zh": "这种事在干地上说。", "en": "That's talked about on dry land."},
        {"zh": "我身上全是水。", "en": "I'm soaked through."},
        {"zh": "我不适合这些。", "en": "I'm not made for that."},
        {"zh": "先让我把枪收好。", "en": "Let me stow the gun first."},
        {"zh": "你连水都不下。", "en": "You don't even get in the water."},
        {"zh": "我们会被人看见。", "en": "We'd be seen."},
        {"zh": "改天再说吧。", "en": "Another day."},
        {"zh": "别站到射界里。", "en": "Get out of my firing line."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它捞起来。", "en": "I scoop it up."},
        {"zh": "这是鹦鹉螺壳。", "en": "This is a nautilus shell."},
        {"zh": "还能换几发子弹。", "en": "It'll buy a few rounds."},
        {"zh": "水底还有一枚。", "en": "Another one on the bottom."},
        {"zh": "我夹在腋下带回去。", "en": "I tuck it under my arm."},
        {"zh": "太重，带不走。", "en": "Too heavy to carry."},
        {"zh": "那条鱼我要了。", "en": "I'll take that fish."},
        {"zh": "这东西不多了。", "en": "Not many of these left."},
        {"zh": "我把它塞进袋里。", "en": "I stuff it in a pouch."},
        {"zh": "慢慢沉下去了。", "en": "It's sinking slowly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上的影子。", "en": "A shadow on the water."},
        {"zh": "它在岸上走。", "en": "It's walking on the bank."},
        {"zh": "我抬起枪口了。", "en": "My muzzle comes up."},
        {"zh": "火药还是干的。", "en": "The powder's still dry."},
        {"zh": "这个距离正好。", "en": "This range is right."},
        {"zh": "我往浅滩挪一步。", "en": "One step into the shallows."},
        {"zh": "水把声音吞掉了。", "en": "The water swallowed the sound."},
        {"zh": "我端平了枪。", "en": "I level the gun."},
        {"zh": "手要握稳了。", "en": "Steady hands now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着水线跟。", "en": "I track along the waterline."},
        {"zh": "它往礁石后面去了。", "en": "It's gone behind the rocks."},
        {"zh": "我的镜片擦清了。", "en": "I wiped my lenses clean."},
        {"zh": "再等它两秒。", "en": "Two more seconds."},
        {"zh": "水在给它遮掩。", "en": "The water covers it."},
        {"zh": "它把头露出来。", "en": "It showed its head."},
        {"zh": "我把呼吸压住。", "en": "I hold my breath."},
        {"zh": "子弹已经上膛。", "en": "Round chambered."},
        {"zh": "就是这一刻。", "en": "Right at this moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "枪托砸过去！", "en": "The stock swings!"},
        {"zh": "我用肩甲撞。", "en": "I ram with my pauldron."},
        {"zh": "近距离也能打。", "en": "Close range works too."},
        {"zh": "枪口顶着你。", "en": "The muzzle's against you."},
        {"zh": "一脚踹你膝窝。", "en": "A kick behind your knee."},
        {"zh": "水花盖住了你。", "en": "Water covers you."},
        {"zh": "这一下很实。", "en": "That landed solid."},
        {"zh": "你往后退了。", "en": "You backed off."},
        {"zh": "我湿手照样抓得稳。", "en": "Wet hands still hold."},
        {"zh": "给我两秒装弹。", "en": "Two seconds to reload."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "水面先破了一下。", "en": "The surface broke first."},
        {"zh": "我从浅滩站起来。", "en": "I rise out of the shallows."},
        {"zh": "枪管上还在滴水。", "en": "Water runs off my barrel."},
        {"zh": "潮水把我送上岸。", "en": "The tide puts me ashore."},
        {"zh": "鳃片一张一合。", "en": "My gill flaps open and close."},
        {"zh": "我踩稳了水底。", "en": "I find my footing."},
        {"zh": "岸上有一个影子。", "en": "A shape on the bank."},
        {"zh": "我把弹匣扣紧。", "en": "I seat the magazine."},
        {"zh": "这片水岸归我。", "en": "This shoreline is mine."},
        {"zh": "我慢慢抬起枪。", "en": "I raise the gun slowly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "湿甲被烤得冒烟。", "en": "My wet armor steams."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔进浅水，呛了一口。", "en": "I fell into the shallows and swallowed water."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我呛了，鳃也不管用。", "en": "I choked. My gills didn't help."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "水被炸得翻起来。", "en": "The water blew up around me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弹丸打在甲上弹开。", "en": "A round glanced off my plate."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光在水里更刺眼。", "en": "The light is worse in water."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得端不稳枪。", "en": "Too hungry to hold the gun steady."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着水面过来。", "en": "The current crossed the water."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "水里什么都没有了。", "en": "There's no water left."}
      ]
    }
  }
}
