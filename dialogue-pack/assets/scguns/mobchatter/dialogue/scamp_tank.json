{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "发出沉闷的轰鸣声，履带缓缓移动。", "en": "Muttering grumblings, treads roll slowly."},
        {"zh": "金属外壳摩擦地面，留下火花。", "en": "Metallic shell screeches, sparks fly."},
        {"zh": "引擎轰鸣，履带发出咔嚓声。", "en": "Engine rumbles, treads click."},
        {"zh": "笨重的身体向前移动。", "en": "Massive body moves forward."},
        {"zh": "枪口闪烁，准备射击。", "en": "Muzzle glows, readies for shot."},
        {"zh": "瞄准玩家，随时准备攻击。", "en": "Aim at player, ready to attack."},
        {"zh": "缓缓移动，警惕周围。", "en": "Slowly move, wary of surroundings."},
        {"zh": "一千点血，够你打很久。", "en": "A thousand health, enough for a long fight."},
        {"zh": "机械臂伸展，寻找目标。", "en": "Mechanical arm extends, seeks target."},
        {"zh": "履带碾过碎石，地都在抖。", "en": "My treads crush the gravel; the ground shakes."},
        {"zh": "十二点护甲，碾过碎石", "en": "Twelve points of armor rolling over gravel."},
        {"zh": "活塞起落，步伐一顿一顿", "en": "Pistons rise and fall in halting steps."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "机械手臂空转，无目标。", "en": "Mechanical arm spins, no target."},
        {"zh": "沉默地站立，等待命令。", "en": "Silently stands, awaits command."},
        {"zh": "转动炮塔，寻找威胁。", "en": "Turn turret, seeks threats."},
        {"zh": "不时发出闷响，自检。", "en": "Occasionally rumbles, self-checks."},
        {"zh": "机械关节吱吱作响。", "en": "Mechanical joints creak."},
        {"zh": "瞄准镜闪烁，寻找弱点。", "en": "Scope flickers, searches weak points."},
        {"zh": "无事可做，机械手臂空转。", "en": "Nothing to do, mechanical arm spins."},
        {"zh": "怠速的引擎低声哼着。", "en": "My idling engine hums low."},
        {"zh": "检查武器，确保准备就绪。", "en": "Inspects weapon, ensures readiness."},
        {"zh": "机械臂轻轻转动，检查炮塔。", "en": "Mechanical arm gently turns, checks turret."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "履带压过地面，先锁定。", "en": "Tracks roll over the ground, target locked."},
        {"zh": "瞄准玩家，怒吼一声。", "en": "Aim at player, snarl loudly."},
        {"zh": "转动炮塔，对准玩家。", "en": "Turn turret, aim at player."},
        {"zh": "发出警告的咆哮，锁定目标。", "en": "Rumble a warning, lock target."},
        {"zh": "瞄准玩家，机械眼闪烁。", "en": "Aim at player, eyes glow."},
        {"zh": "怒吼着，对准玩家。", "en": "Snarls, aims at player."},
        {"zh": "我的装甲厚得能挡炮弹。", "en": "My armor is thick enough to stop shells."},
        {"zh": "我的红眼灯扫过你。", "en": "My red eye-lamp sweeps over you."},
        {"zh": "光学镜片缩放，收进你的轮廓", "en": "Its lens zooms and swallows your outline."},
        {"zh": "枪口抬起，稳得像三脚架", "en": "The muzzle lifts, steady as a tripod."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "吱吱嘎嘎，我受伤害了！", "en": "Squeak-squeak, I'm hurt!"},
        {"zh": "我受点小伤，还能战斗！", "en": "Just a scratch, still fighting!"},
        {"zh": "液压管爆了，油喷出来。", "en": "A hydraulic line burst; oil sprays out."},
        {"zh": "火控失灵，准星在乱转。", "en": "Fire control is out; my reticle spins."},
        {"zh": "再打疼我，我就不友善了！", "en": "More pain, and I'll get nasty!"},
        {"zh": "小心我发怒！", "en": "Watch out, I'm angry!"},
        {"zh": "我的轮子受了伤！", "en": "My wheels are hurt!"},
        {"zh": "装甲裂了，螺丝在掉。", "en": "My armor is cracked; bolts are falling."},
        {"zh": "这伤可真深！", "en": "That's a deep wound!"},
        {"zh": "十二点护甲，也裂了缝。", "en": "Twelve points of armor, and a crack shows."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你会感受到炽热的弹壳吗？", "en": "Feel the heat of the spent shell."},
        {"zh": "尝尝我的枪口吧！", "en": "Taste my barrel!"},
        {"zh": "子弹在我的嘴里发出嘶嘶声。", "en": "The bullets hiss in my mouth."},
        {"zh": "让我看看你的胆量。", "en": "Let me see your courage."},
        {"zh": "你挡得住我的炮口吗？", "en": "Can you stop my cannon?"},
        {"zh": "十二点护甲的壳，你打得动？", "en": "Twelve points of armor, can you dent it?"},
        {"zh": "火药在我的体内燃烧。", "en": "The gunpowder burns within me."},
        {"zh": "瞄准，射击，爆炸。", "en": "Aim, shoot, explode."},
        {"zh": "感受我的毁灭之力。", "en": "Feel my destructive power."},
        {"zh": "我的炮管比你的心更冷。", "en": "My barrel is colder than your heart."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "钢铁碰撞钢铁的回响。", "en": "Steel meets steel."},
        {"zh": "我们的重锤即将相遇。", "en": "Our heavy hammers meet."},
        {"zh": "轰隆隆，我们的装甲碰撞。", "en": "Boom, our armor collides."},
        {"zh": "装甲的碰撞发出震耳欲聋的声音。", "en": "Armor clatters loudly."},
        {"zh": "金属的碰撞如同雷鸣。", "en": "Metal clatters like thunder."},
        {"zh": "我们的护甲即将碰撞。", "en": "Our armor will clash."},
        {"zh": "碰撞，钢铁的交响。", "en": "Collide, the metal symphony."},
        {"zh": "金属碰撞的声音回荡。", "en": "The sound of metal clashing echoes."},
        {"zh": "金属碰撞，火花四溅。", "en": "Metal clash, sparks fly."},
        {"zh": "我们的钢铁将碰撞。", "en": "Our steel will collide."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻求我的陪伴吧。", "en": "Seek my company."},
        {"zh": "装甲贴着装甲，像并肩。", "en": "Armor against armor, as if side by side."},
        {"zh": "千点血量的铁壳，慢慢挪。", "en": "A thousand-point iron shell, moving slow."},
        {"zh": "与我一起统治这片土地。", "en": "Rule with me."},
        {"zh": "寻找我们的未来。", "en": "Find our future."},
        {"zh": "与我一同飞翔。", "en": "Fly with me."},
        {"zh": "我这一千点血，够你打很久。", "en": "A thousand points of me takes a while."},
        {"zh": "与我共度时光。", "en": "Share time with me."},
        {"zh": "寻找永恒的伴侣。", "en": "Find eternal companionship."},
        {"zh": "与我共享荣耀。", "en": "Share glory with me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶声中，炮管闪着幽光。", "en": "Hisss, barrel glows."},
        {"zh": "金属甲壳，闪闪发光。", "en": "Metal shell, gleaming."},
        {"zh": "瞄准后，它咆哮着。", "en": "Roars after aiming."},
        {"zh": "沉闷的炮击声响。", "en": "Dull cannon roar."},
        {"zh": "装甲下，隐藏着火药。", "en": "Fireworks under armor."},
        {"zh": "它吐出一团火光。", "en": "Exhales a fireball."},
        {"zh": "机械战甲，沉着冷静。", "en": "Mechanical armor, calm."},
        {"zh": "瞄准并准备射击。", "en": "Aim and shoot."},
        {"zh": "它身上的武器发出声响。", "en": "Its weapons clatter."},
        {"zh": "古黄铜在阳光下反射。", "en": "Ancient brass glitters."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "十二点护甲，你瞄也没用。", "en": "Twelve armor. Aim all you like."},
        {"zh": "锁定你的坐标。", "en": "Locking on you."},
        {"zh": "瞄准镜闪烁，准备射击。", "en": "Scope flashes, ready to fire."},
        {"zh": "瞄准目标，扣动扳机。", "en": "Aim, pull trigger."},
        {"zh": "瞄准后，它开始移动。", "en": "Aim, move."},
        {"zh": "装甲板合上，炮口预热。", "en": "Armor plates shut; the barrel preheats."},
        {"zh": "瞄准了你的生物。", "en": "Aiming at you biomes."},
        {"zh": "瞄准并进行射击。", "en": "Aim and shoot."},
        {"zh": "它开始瞄准你的位置。", "en": "Aiming at you."},
        {"zh": "瞄准并准备行动。", "en": "Aim and act."},
        {"zh": "枪械 AI 接管，扳机预热", "en": "The gun AI takes over; the trigger warms up."},
        {"zh": "你进了它的火控名单", "en": "You are on its fire-control list."},
        {"zh": "弹道算好了，只差扣扳机", "en": "Ballistics solved; only the trigger remains."},
        {"zh": "一千点血，够我慢慢打", "en": "A thousand health; I can take my time."},
        {"zh": "它先封锁，再点射", "en": "First it pins you, then it fires."},
        {"zh": "火药味散开，你不会喜欢", "en": "Cordite smoke spreads; you will not like it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "火炮锁定目标。", "en": "Cannon targeting."},
        {"zh": "瞄准器开始运作。", "en": "Scope working."},
        {"zh": "瞄准后方的敌人。", "en": "Aim at enemies."},
        {"zh": "瞄准并标记目标。", "en": "Aim and mark."},
        {"zh": "炮口转向，液压在响。", "en": "The cannon turns; hydraulics whine."},
        {"zh": "瞄准并锁定目标。", "en": "Aim and lock."},
        {"zh": "瞄准并准备射击", "en": "Aim and shoot"},
        {"zh": "瞄准并标记生物。", "en": "Aim and mark."},
        {"zh": "瞄准后，它开始移动", "en": "Aim and move"},
        {"zh": "瞄具十字线压在你的胸口", "en": "The crosshair rests on your chest."},
        {"zh": "它算好了提前量", "en": "It has led the shot perfectly."},
        {"zh": "射界清空，只剩你一个", "en": "Firing lane cleared; only you remain."},
        {"zh": "弹匣入膛，咔哒一声", "en": "A magazine seats with a click."},
        {"zh": "黄铜弹壳在抛壳口等着", "en": "A brass case waits at the ejection port."},
        {"zh": "它压住呼吸，其实没有肺", "en": "It holds its breath, though it has no lungs."},
        {"zh": "三点一线，你正中间", "en": "Sight, barrel, and you, dead center."},
        {"zh": "炮塔微调两度，对准你的头", "en": "The turret adjusts two degrees to your head."},
        {"zh": "它不开火，先让你听见上膛", "en": "It does not fire; it lets you hear the chamber."},
        {"zh": "距离、风速、弹重，都记下了", "en": "Range, wind, bullet weight: all recorded."},
        {"zh": "第二次瞄准，比第一次更准", "en": "The second aim is truer than the first."}
      ]
    },
