    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到胡萝卜的味道了！", "en": "Smell those carrots!"},
        {"zh": "靠近点，给我苹果！", "en": "Come closer, give me an apple!"},
        {"zh": "这杯状地衣真好吃！", "en": "Yummy cup lichen!"},
        {"zh": "这么多食物，真幸福！", "en": "So much food, bliss!"},
        {"zh": "杯状地衣在手，我跟你走。", "en": "Cup lichen in your hand, and I follow."},
        {"zh": "这些胡萝卜真诱人！", "en": "Those carrots are tempting!"},
        {"zh": "苹果是我的最爱！", "en": "Apples are my favorite!"},
        {"zh": "快来跟我交朋友吧！", "en": "Be my friend!"},
        {"zh": "这些食物让我更有活力！", "en": "Food gives me energy!"},
        {"zh": "我找到了美味的食物！", "en": "Found delicious food!"},
        {"zh": "杯状地衣的味道，我认得", "en": "Cup lichen, I know that smell."},
        {"zh": "你手里是苹果吗", "en": "Is that an apple in your hand?"},
        {"zh": "再靠近点，我不跑", "en": "Come a little closer. I will not run."},
        {"zh": "让我闻闻你的手心", "en": "Let me sniff your palm."},
        {"zh": "给一口，我就跟着你", "en": "One bite, and I will follow you."},
        {"zh": "这份信任我愿意试试", "en": "I am willing to try this trust."}
      ]
    },
