    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "踏着轻快的步伐穿过雪地", "en": "Jumps gracefully through the snow"},
        {"zh": "用鹿角拨开低矮的灌木", "en": "Nudges low bushes with antlers"},
        {"zh": "悠闲地啃食杯状地衣", "en": "Chews on cup lichen leisurely"},
        {"zh": "在针叶林间快速穿梭", "en": "Skims through pine forests quickly"},
        {"zh": "用鼻子嗅寻胡萝卜的香味", "en": "Sniffs for carrot aroma with nose"},
        {"zh": "寻找新芽作为食物", "en": "Seeks new shoots for food"},
        {"zh": "轻盈地跃过小溪", "en": "Leaps over small streams lightly"},
        {"zh": "在雪地里留下足迹", "en": "Leaves footprints in the snow"},
        {"zh": "享受节日的装扮", "en": "Enjoys festive attire"},
        {"zh": "雪地中跳跃前行", "en": "Jumps forward in the snow"},
        {"zh": "蹄子踩碎薄冰", "en": "My hooves crack the thin ice."},
        {"zh": "顶着风往林子里走", "en": "I walk into the trees against the wind."},
        {"zh": "鼻息在冷空气里成雾", "en": "My breath fogs in the cold air."},
        {"zh": "沿着松林边缘走", "en": "I walk along the pine forest's edge."},
        {"zh": "雪深的地方就用跳的", "en": "Where snow is deep, I bound."},
        {"zh": "低头躲开低垂的松枝", "en": "I duck under a low pine branch."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "安静地站立在树旁", "en": "Stands quietly by a tree"},
        {"zh": "我用蹄子刨开雪，找下面的苔。", "en": "I paw the snow aside to find the lichen underneath."},
        {"zh": "享受阳光的温暖", "en": "Enjoys the warmth of the sun"},
        {"zh": "舔舐自己的毛皮", "en": "Licks its own fur"},
        {"zh": "鹿角上的霜化了一半，我甩甩头。", "en": "The frost on my antlers is half melted; I shake my head."},
        {"zh": "用角轻轻触碰地衣", "en": "Gently touches lichen with antlers"},
        {"zh": "安静地啃食胡萝卜", "en": "Chews carrots quietly"},
        {"zh": "享受和平的时光", "en": "Enjoys peaceful moments"},
        {"zh": "悠闲地打滚", "en": "Rolls leisurely"},
        {"zh": "享受苹果的甜美", "en": "Treats itself to an apple"},
        {"zh": "站在背风处避寒", "en": "I stand in the lee of the wind."},
        {"zh": "把鼻子埋进雪里找苔", "en": "I bury my nose in the snow for moss."},
        {"zh": "耳朵转着听四面", "en": "My ears swivel to every side."},
        {"zh": "鹿角上挂着一点霜", "en": "Frost clings to my antlers."},
        {"zh": "在冰刺之地慢慢嚼", "en": "I chew slowly in the Ice Spikes."},
        {"zh": "靠着树干歇一会儿", "en": "I rest a while against a trunk."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "用眼神注视着你", "en": "Looks at you with its eyes"},
        {"zh": "雪地里我靠近半步，又停住。", "en": "In the snow I take half a step closer, then stop."},
        {"zh": "靠近来查看玩家", "en": "Approaches to check on the player"},
