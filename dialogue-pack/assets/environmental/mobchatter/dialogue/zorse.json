        {"zh": "快速踢击，试图惊扰目标。", "en": "Quick KICK to startle the target."},
        {"zh": "用蹄子轻触，让目标移动。", "en": "Gentle KICK to move the target."},
        {"zh": "用蹄子轻弹，让目标显现。", "en": "Tap with a KICK to reveal the target."},
        {"zh": "踢出一条痕迹，锁定目标。", "en": "Kick a trail to lock on."}
      ]
    },
