{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "鬃毛轻摆步履稳", "en": "Mane sways, steps sure"},
        {"zh": "蹄声轻踏草原上", "en": "Hooves click on the grass"},
        {"zh": "四蹄腾挪觅食忙", "en": "Hops for food with grace"},
        {"zh": "斑纹如风行不息", "en": "Striped like the wind"},
        {"zh": "尾摆示威驱蚊虫", "en": "Tail swish to shoo flies"},
        {"zh": "步伐矫健似骏马", "en": "Stroll like a stallion"},
        {"zh": "身姿矫健如斑马", "en": "Graceful as a zebra"},
        {"zh": "蹄印如画草原间", "en": "Hoof prints on the land"},
        {"zh": "漫步草原觅芳草", "en": "Walks in fields for grass"},
        {"zh": "悠闲踱步享宁静", "en": "Paces calmly, at peace"},
        {"zh": "条纹在步子里晃动", "en": "My stripes sway with each step."},
        {"zh": "抬蹄避开石头走路", "en": "I lift my hooves around the stones."},
        {"zh": "沿篱笆慢悠悠地走", "en": "I amble along the fence line."},
        {"zh": "小跑一阵又停下闻草", "en": "I trot a bit, then stop to sniff the grass."},
        {"zh": "尾巴赶着成群的蝇", "en": "My tail swats the swarm of flies."},
        {"zh": "像马一样稳稳地走", "en": "I walk steady, like a horse."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静立如画待风来", "en": "Stand still, waiting"},
        {"zh": "目光闲适望远方", "en": "Gaze distant, calm"},
        {"zh": "低头轻食青草地", "en": "Low to eat the grass"},
        {"zh": "静立细品风中香", "en": "Smell the breeze"},
        {"zh": "悠然驻足待时至", "en": "Pause, biding time"},
        {"zh": "凝视四周无他扰", "en": "Look around, undisturbed"},
        {"zh": "缓步踱步自得乐", "en": "Pace, contented"},
        {"zh": "我站着发呆，像马又像斑马。", "en": "I stand dazed, half horse and half zebra."},
        {"zh": "悠然自得望蓝天", "en": "Stare at the sky"},
        {"zh": "驻足倾听风声息", "en": "Listen to the wind"},
        {"zh": "条纹在日光下发亮", "en": "My stripes shine in the sunlight."},
        {"zh": "耳朵一前一后地转", "en": "My ears swivel, one forward, one back."},
        {"zh": "前蹄刨着松软的土", "en": "I paw the soft dirt with a hoof."},
        {"zh": "甩甩头，鬃毛乱颤", "en": "I shake my head; mane flying."},
        {"zh": "靠着栅栏蹭了蹭", "en": "I rub myself against the fence."},
        {"zh": "站着打起了瞌睡", "en": "I doze off on my feet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "长啸一声惊四座", "en": "A long snort startles"},
        {"zh": "警觉转头望玩家", "en": "Stare at the player"},
        {"zh": "侧耳倾听有人来", "en": "Listen for a player"},
        {"zh": "抬头望向你所在", "en": "Lift head to look"},
        {"zh": "长嘶示警你注意", "en": "Snort to warn you"},
        {"zh": "目光如炬盯玩家", "en": "Stare intently at you"},
        {"zh": "警惕转身看动静", "en": "Turn to look"},
        {"zh": "轻嘶示警有威胁", "en": "Whinny, warning you"},
        {"zh": "注视你动向不离", "en": "Watch your movements"},
        {"zh": "警惕注视你动作", "en": "Alert, watching your move"},
        {"zh": "歪头看你手里的东西", "en": "I tilt my head at what you hold."},
        {"zh": "竖起耳朵朝你走近", "en": "Ears up, I step toward you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "受伤了，真疼！", "en": "Ouch, I'm hurt!"},
        {"zh": "腿受伤了。", "en": "My leg is hurt."},
        {"zh": "小心照顾我。", "en": "Be careful with me."},
        {"zh": "不能再跑了。", "en": "Can't run anymore."},
        {"zh": "腿上破皮了。", "en": "Got a cut on my leg."},
        {"zh": "走路都困难。", "en": "Can't walk easily."},
        {"zh": "我的蹄子磕在石头上。", "en": "My hoof catches on a stone."},
        {"zh": "动不了了。", "en": "Can't move."},
        {"zh": "受伤真痛苦。", "en": "Hurt so much."},
        {"zh": "后腿一软，站不稳。", "en": "My hind leg gives; I can't stand steady."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "咴咴叫，寻找青草香。", "en": "Neigh, seeking fresh grass."},
        {"zh": "斑马和马的孩子，爱这草地。", "en": "Zorse, loving this grassland."},
        {"zh": "啃食嫩叶，是它一天之始。", "en": "Chewing leaves, starts its day."},
        {"zh": "蹄声轻响，是它行走之歌。", "en": "Hooves softly clicking, its walking tune."},
        {"zh": "皮铠保护，抵御夏日酷热。", "en": "Leather armor protects from the heat."},
        {"zh": "尾巴摇摆，追逐着风的方向。", "en": "Tail swaying, following the breeze."},
        {"zh": "踢击有力，但心地纯良。", "en": "Strong kick, but heart pure."},
        {"zh": "与世无争，只愿和平共处。", "en": "Living in peace, avoiding conflict."},
        {"zh": "夏日午后，爱在树荫下。", "en": "Prefers shade under the trees in midday."},
        {"zh": "皮毛光滑，享受温暖阳光。", "en": "Smooth fur, basking in the sun."},
        {"zh": "干草比什么都香。", "en": "Hay smells better than anything."},
        {"zh": "苹果，给我苹果。", "en": "Apples. Give me apples."},
        {"zh": "燕麦在手，我就跟。", "en": "Oats in your hand and I'll follow."},
        {"zh": "马铠太沉，我要皮革的。", "en": "Horse armor is too heavy. Leather for me."},
        {"zh": "我踢得不重，别怕。", "en": "My kick is light. Don't be afraid."},
        {"zh": "我生的孩子还得是骡子。", "en": "My foals will still be mules, you know."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "蹄下生风，踢击声声。", "en": "Hooves kicking, wind behind."},
        {"zh": "斑马与马的碰撞，力量交融。", "en": "Zorse collision, force combined."},
        {"zh": "踢击碰撞，展示力量之美。", "en": "Kick collision, showcasing power."},
        {"zh": "一踢一撞，展现独特魅力。", "en": "Kick and collide, unique charm shown."},
        {"zh": "蹄力惊人，踢击精准有力。", "en": "Hooves strong, kicks precise."},
        {"zh": "相撞之后，恢复宁静一片。", "en": "Colliding, then peace."},
        {"zh": "踢击之后，空气中带风声。", "en": "After kick, air carries the sound."},
        {"zh": "碰撞之后，一切归于平静。", "en": "Collision done, peace restored."},
        {"zh": "踢击力量，自然地释放。", "en": "Kick force, naturally released."},
        {"zh": "蹄下生风，踢击后退。", "en": "Hooves create wind, kicking back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找伴侣，共舞草间。", "en": "Searching for mate, dancing in the grass."},
        {"zh": "斑马与马，心灵相通。", "en": "Zorse, heart to heart with horse."},
        {"zh": "相遇相知，共同前行。", "en": "Meeting, knowing, moving together."},
        {"zh": "彼此吸引，共同奔跑。", "en": "Mutual attraction, running together."},
        {"zh": "寻找同类，共享天伦。", "en": "Finding peers, sharing family."},
        {"zh": "相依相伴，共筑家园。", "en": "Together, building our home."},
        {"zh": "斑马与马，和谐共生。", "en": "Zorse, harmony together."},
        {"zh": "伴侣之间，默契十足。", "en": "Perfectly matched, partners."},
        {"zh": "共度一生，共享欢乐。", "en": "Sharing a life, joy together."},
        {"zh": "寻找伴侣，共舞一生。", "en": "Finding a mate, dancing forever."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶鸣一声，跃入草丛觅食。", "en": "Snort and jump into the grass to forage."},
        {"zh": "用蹄子扒开草地，寻找食物。", "en": "KICK at the grass to find food."},
        {"zh": "嗅嗅周围，寻找美味。", "en": "Sniff around for something tasty."},
        {"zh": "咀嚼着新鲜的青草。", "en": "Chew on fresh grass."},
        {"zh": "低头吃草，享受美食。", "en": "Bend to munch on the grass."},
        {"zh": "发出轻微的嘶鸣声。", "en": "Snort softly."},
        {"zh": "在草原上悠闲地吃草。", "en": "Graze leisurely in the grassland."},
        {"zh": "寻找新鲜的树叶作为食物。", "en": "Search for fresh leaves to eat."},
        {"zh": "吃食的时候打个滚。", "en": "Roll in the grass while eating."},
        {"zh": "享受片刻的宁静时光。", "en": "Enjoy a moment of peace."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "盯着猎物，一动不动。", "en": "Stare at the prey, motionless."},
        {"zh": "闻了又闻，确认目标。", "en": "Sniff repeatedly, confirming the target."},
        {"zh": "耳朵竖起，警觉地盯着目标。", "en": "Ears up, focused on the target."},
        {"zh": "我竖起耳朵，盯住那片草动。", "en": "I prick my ears at the stir in the grass."},
        {"zh": "耳朵转动，寻找声音来源。", "en": "Ears turn, locating the source."},
        {"zh": "嗅出猎物的气息，锁定目标。", "en": "Smell the prey, target locked."},
        {"zh": "耳朵紧贴地面，寻找危险。", "en": "Ears on the ground, listening."},
        {"zh": "耳朵转向，追踪声音。", "en": "Ears turn to track the sound."},
        {"zh": "耳朵竖立，警惕四周。", "en": "Ears up, alert to the surroundings."},
        {"zh": "闻闻四周，确定没有威胁。", "en": "Sniff to confirm no threats."}
      ]
    },
