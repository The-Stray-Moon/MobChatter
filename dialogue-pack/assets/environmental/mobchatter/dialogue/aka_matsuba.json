{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "游向阴影，寻找猎物。", "en": "Swim towards shadows, hunt prey."},
        {"zh": "漆黑中，我独行。", "en": "In darkness, I roam alone."},
        {"zh": "鱼儿们，藏好。", "en": "Fish, hide now."},
        {"zh": "阴影是我的领地。", "en": "Shadows are my realm."},
        {"zh": "等待，然后吞噬。", "en": "Wait, then devour."},
        {"zh": "夜色中，猎物稀少。", "en": "Few prey in the night."},
        {"zh": "我的眼睛，我的武器。", "en": "My eyes, my weapon."},
        {"zh": "在这片水域中游荡。", "en": "Swim in these waters."},
        {"zh": "黑暗中，我狩猎。", "en": "I hunt in darkness."},
        {"zh": "静默中，等待时机。", "en": "Silent, wait for prey."},
        {"zh": "红鳞掠过落花", "en": "Red scales slip past the fallen blossoms."},
        {"zh": "松针纹在背上游动", "en": "Pine-needle patterns ripple along its back."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静游弋，静待猎机。", "en": "Idle, waiting for prey."},
        {"zh": "水面之下，我沉思。", "en": "Beneath the surface, I ponder."},
        {"zh": "耐心，是狩猎之母。", "en": "Patience, mother of hunting."},
        {"zh": "平静中，我注视。", "en": "Steady, I watch."},
        {"zh": "等待，直到猎物现身。", "en": "Wait, until prey appears."},
        {"zh": "在这水域中潜行。", "en": "I sneak in these waters."},
        {"zh": "水面之下，我是王。", "en": "Below, I am king."},
        {"zh": "耐心等待，直到机会来临。", "en": "Wait patiently for the chance."},
        {"zh": "水面之下，我沉睡。", "en": "Beneath, I rest."},
        {"zh": "在阴影中，我隐匿。", "en": "In shadows, I hide."},
        {"zh": "悬在水草间轻轻摆尾", "en": "It hovers in the weeds, tail barely moving."},
        {"zh": "红影停在花荫下", "en": "A red shadow rests beneath the blossoms."},
        {"zh": "鳃盖一张一合很安静", "en": "Its gills open and close, unhurried."},
        {"zh": "让水流慢慢梳过鳞片", "en": "The current combs slowly through its scales."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物来了，注意！", "en": "Prey detected, beware!"},
        {"zh": "感知到了你的气息。", "en": "Your scent, I detect."},
        {"zh": "红松叶的斑纹，水一照就亮。", "en": "My red pine markings shine in the water."},
        {"zh": "你动了，我要攻击。", "en": "You move, I strike."},
        {"zh": "靠近我，危险。", "en": "Approach me, danger."},
        {"zh": "水里那抹红松色，就是我。", "en": "That red-pine glimmer in the water is me."},
        {"zh": "猎物近了，一击致命。", "en": "Prey near, fatal strike."},
        {"zh": "你在我瞄准的范围。", "en": "You're in my crosshairs."},
        {"zh": "我要捕食你。", "en": "I will feed on you."},
        {"zh": "你的动作触发了警报。", "en": "Your movement triggers alarm."},
        {"zh": "红鳞转向你的方向", "en": "Its red scales turn your way."},
        {"zh": "它从水草里探出头", "en": "It pokes its head out of the weeds."},
        {"zh": "隔着水面盯住你", "en": "It fixes on you through the water."},
        {"zh": "墨网般的鳞纹绷紧了", "en": "The net of dark scales pulls taut."},
        {"zh": "它游到你的倒影下面", "en": "It slides beneath your reflection."},
        {"zh": "你一动，它就抬头", "en": "You move, and it looks up."},
        {"zh": "红影在你脚边停住", "en": "The red shape stops at your feet."},
        {"zh": "它把你从头看到脚", "en": "It looks you over from head to toe."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "尾巴受了伤，游得慢了...", "en": "My tail is hurt, swimming slower..."},
        {"zh": "身上划伤，行动不便...", "en": "Scratches on my body, moving awkwardly..."},
        {"zh": "被尖石划伤，疼痛...", "en": "Pierced by a sharp stone, painful..."},
        {"zh": "鱼鳍受损，难以游动...", "en": "Fins injured, hard to swim..."},
        {"zh": "侧身受了伤，行动受限...", "en": "Sidelong injury, limited movement..."},
        {"zh": "鱼身被撞伤，行动迟缓...", "en": "Hit and injured, moving slowly..."},
        {"zh": "鱼鳍撕裂，游泳困难...", "en": "Fin torn, hard to swim..."},
        {"zh": "鱼身被划伤，行动受阻...", "en": "Cut on my body, movement impeded..."},
        {"zh": "鱼鳍被夹伤，游动受限...", "en": "Pinched fin, limited swimming..."},
        {"zh": "鱼鳍被割伤，行动不便...", "en": "Cut fin, moving awkwardly..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "鱼饵飘动，我来了。", "en": "Bait wiggles, here I come."},
        {"zh": "鱼鳍轻摆，诱惑难挡。", "en": "Fins sway, temptation hard to resist."},
        {"zh": "来吧，享受这盛宴。", "en": "Come, feast on this spread."},
        {"zh": "红叶中藏匿，静候佳餚。", "en": "Hidden in red leaves, awaiting prey."},
        {"zh": "锦鲤之变，何等华丽。", "en": "Koi variation, how splendid."},
        {"zh": "游动中寻找猎物。", "en": "Swimming to find prey."},
        {"zh": "红叶映衬下的优雅。", "en": "Elegance in red leaves."},
        {"zh": "静水深流，静待鱼饵。", "en": "Stagnant waters, waiting for bait."},
        {"zh": "游弋于水下，寻找猎物。", "en": "Swimming underwater, searching for prey."},
        {"zh": "红色如火焰，引诱猎物。", "en": "Red like flames, luring prey."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞上你，后果自负。", "en": "Collision means consequences."},
        {"zh": "你撞上了赤松叶。", "en": "Collision with Aka Matsuba."},
        {"zh": "躲避我的攻击。", "en": "Avoid my attack."},
        {"zh": "碰撞触发警告。", "en": "Collision triggers warning."},
        {"zh": "躲开我的触须。", "en": "Avoid my tendrils."},
        {"zh": "撞上我，你会后悔。", "en": "You'll regret the collision."},
        {"zh": "碰撞后退。", "en": "Retreat after collision."},
        {"zh": "红白鳞片被你撞散了光。", "en": "Your bump scatters the light on my red scales."},
        {"zh": "撞上我的触角。", "en": "Collision with my tentacles."},
        {"zh": "你和我相撞。", "en": "You collided with me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的红斑像秋叶。", "en": "My red patches look like autumn leaves."},
        {"zh": "寻找同类进行交配。", "en": "Searching for a mate to breed."},
        {"zh": "交配后，我们分裂。", "en": "After breeding, we split."},
        {"zh": "交配是我们的目标。", "en": "Breeding is our goal."},
        {"zh": "寻找交配伴侣。", "en": "Seeking a breeding partner."},
        {"zh": "交配后彼此分开。", "en": "Separate after breeding."},
        {"zh": "交配是生命的延续。", "en": "Breeding is life's continuation."},
        {"zh": "我在锦鲤群里转了个圈。", "en": "I circle once among the koi."},
        {"zh": "交配，然后各走各的。", "en": "Breeding, then go our ways."},
        {"zh": "交配是我们的任务。", "en": "Breeding is our task."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "游过我身旁，就变成我的晚餐吧。", "en": "Swim by and become my meal."},
        {"zh": "我的存在，连影子都让怪物惧怕。", "en": "Monsters fear my presence even in shadow."},
        {"zh": "你离我太近了，该死的。", "en": "You're too close, damn it."},
        {"zh": "在这阴暗的水中享受孤独吧。", "en": "Enjoy your solitude in this dark water."},
        {"zh": "我不会轻易放过你，怪物。", "en": "I won't let you go easily, monster."},
        {"zh": "你们这些家伙最好小心点。", "en": "You guys better be careful."},
        {"zh": "不要靠近我，危险就在身边。", "en": "Stay away from me, danger's nearby."},
        {"zh": "这里是我领地，别想进来。", "en": "This is my territory, stay out."},
        {"zh": "我的鳞片闪烁着恐惧之光。", "en": "My scales shine with fear."},
        {"zh": "这里没有你容身之处。", "en": "There's no place for you here."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物就在眼前，不会让它跑了。", "en": "Prey is in sight, it won't get away."},
        {"zh": "我闻到了你的恐惧，靠近点。", "en": "I smell your fear, come closer."},
        {"zh": "你逃不出我的视线。", "en": "You can't escape my sight."},
        {"zh": "你的存在激起了我的猎食欲望。", "en": "Your presence stirs my hunting desire."},
        {"zh": "让我看看你的真面目。", "en": "Let me see your true form."},
        {"zh": "猎物，给我留下。", "en": "Prey, stay with me."},
        {"zh": "不要试图逃脱，你无处可逃。", "en": "Don't try to escape, you have nowhere to go."},
        {"zh": "我的视线锁定在你身上。", "en": "My gaze is fixed on you."},
        {"zh": "你逃不过我的追踪。", "en": "You can't escape my tracking."},
        {"zh": "我的目标就是你，猎杀开始。", "en": "My target is you, the hunt begins."},
        {"zh": "池底的淤泥动了", "en": "The silt on the pond floor stirs."},
        {"zh": "它闻到你身上的铁味", "en": "It smells iron on you."},
        {"zh": "红鳞绷成一条直线", "en": "Its red scales draw into a straight line."},
        {"zh": "它把你算进了今天的食谱", "en": "It has put you on today's menu."},
        {"zh": "花荫下它开始加速", "en": "Beneath the blossoms it picks up speed."},
        {"zh": "它盯上的东西不会漂走", "en": "What it targets does not drift away."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "盯紧你的猎物，别让它跑了。", "en": "Keep your target in sight, don't let it get away."},
        {"zh": "我用我的眼睛锁定你。", "en": "I lock onto you with my eyes."},
        {"zh": "我的目光已经锁定，你动弹不得。", "en": "My gaze is locked, you can't move."},
        {"zh": "你要为你的存在付出代价。", "en": "You'll pay for your existence."},
        {"zh": "瞄准，开火。", "en": "Aim, fire."},
        {"zh": "你逃不了，我已经瞄准了。", "en": "You can't escape, I've got you in my sights."},
        {"zh": "集中注意力，锁定目标。", "en": "Concentrate, lock on target."},
        {"zh": "我已经瞄准了，别试图逃跑。", "en": "I've got you in my sights, don't try to run."},
        {"zh": "瞄准并击倒你的猎物。", "en": "Target and strike your prey."},
        {"zh": "我的焦点已经锁定，准备攻击。", "en": "My focus is locked, prepare to attack."},
        {"zh": "它贴着池底逼近", "en": "It closes in along the pond floor."},
        {"zh": "红影分开两排水草", "en": "The red shape parts two rows of weeds."},
        {"zh": "它绕到你背后去了", "en": "It has slipped around behind you."},
        {"zh": "水纹一圈圈收紧", "en": "The ripples tighten ring by ring."},
        {"zh": "它只露出背鳍", "en": "Only its dorsal fin shows."},
        {"zh": "它在你影子里游", "en": "It swims inside your shadow."},
        {"zh": "它算好了你转身的时机", "en": "It has timed when you will turn."},
        {"zh": "尾巴一压就冲过来", "en": "One downward flick and it charges."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，来吧，我的猎物！", "en": "Sssss, here, my prey!"},
        {"zh": "咕噜咕噜，我饿了！", "en": "Gurgle gurgle, I'm hungry!"},
        {"zh": "别想跑！我会抓住你！", "en": "Don't try to run! I'll catch you!"},
        {"zh": "咔嚓，我的牙齿锋利！", "en": "Snap, my teeth are sharp!"},
        {"zh": "你逃不掉的，赤松叶！", "en": "You can't escape, Aka Matsuba!"},
        {"zh": "别碰我的水，我用尾扫你。", "en": "Don't touch my water; I sweep you with my tail."},
        {"zh": "咕噜咕噜，猎物的味道！", "en": "Gurgle gurgle, the taste of prey!"},
        {"zh": "嘶嘶，品尝我的利爪！", "en": "Sss, taste my sharp claws!"},
        {"zh": "嘶嘶，这是我的地盘！", "en": "Sss, this is my territory!"},
        {"zh": "嘶嘶，猎杀时间！", "en": "Sss, time to hunt!"},
        {"zh": "红鳞擦过你的手腕", "en": "Red scales rake across your wrist."},
        {"zh": "它咬住你的衣角不放", "en": "It clamps onto your sleeve and holds."},
        {"zh": "尾鳍抽在你脸上", "en": "Its tail fin whips across your face."},
        {"zh": "它把你拽向深水", "en": "It hauls you toward the deep water."},
        {"zh": "池泥溅了你满身", "en": "Pond mud splashes all over you."},
        {"zh": "它用头狠狠顶你的膝", "en": "It butts its head hard into your knee."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "水草中，赤松叶现身！", "en": "Aka Matsuba emerges from the water plants!"},
        {"zh": "我在这里，观察四周！", "en": "I'm here, scanning the area!"},
        {"zh": "锦鲤的变体，赤松叶！", "en": "Koi variant, Aka Matsuba!"},
        {"zh": "我必须保持警惕！", "en": "I must stay alert!"},
        {"zh": "Blossom Woods的守护者！", "en": "Guardian of Blossom Woods!"},
        {"zh": "我在等待，猎物出现！", "en": "I wait, prey appears!"},
        {"zh": "水草丛中，我等待猎物！", "en": "Water plants, I wait for prey!"},
        {"zh": "我在此处巡逻！", "en": "I patrol here!"},
        {"zh": "水面下，赤松叶潜伏！", "en": "Aka Matsuba lurks underwater!"},
        {"zh": "水中，我就是霸主！", "en": "In water, I'm the boss!"},
        {"zh": "水面浮起一片红叶", "en": "A red leaf surfaces on the pond."},
        {"zh": "花荫下的水亮了", "en": "The water beneath the blossoms brightens."},
        {"zh": "红影从莲叶间滑出", "en": "A red shadow slides out from the lily pads."},
        {"zh": "池水染上一抹赤色", "en": "A crimson tinge spreads through the pond."},
        {"zh": "松针落水，它应声而来", "en": "A pine needle falls, and it answers."},
        {"zh": "它从落花堆里游出来", "en": "It swims out of the drift of petals."},
        {"zh": "怪物绕开了这片水", "en": "The monsters give this water a wide berth."},
        {"zh": "赤松叶在浅滩现身", "en": "Aka Matsuba shows itself in the shallows."}
      ]
    },
