  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "游动轻盈，鱼鳞闪亮。", "en": "Swims gracefully, scales shine."},
        {"zh": "追逐光点，跃出水面。", "en": "Chases light, leaps out."},
        {"zh": "避开阴影，穿梭水间。", "en": "Avoids shadows, swims through."},
        {"zh": "觅食水底，寻觅小虫。", "en": "Forages in the water, hunts small bugs."},
        {"zh": "缓缓游弋，静谧祥和。", "en": "Swims calmly, serene."},
        {"zh": "偶遇同伴，相互打声招呼。", "en": "Meets a friend, says hello."},
        {"zh": "游过洞穴，寻找安全之地。", "en": "Swims through caves, seeks safety."},
        {"zh": "偶尔跃起，激起水花。", "en": "Occasionally leaps, splashes."},
        {"zh": "警惕四周，感受气息。", "en": "Scans surroundings, senses aura."},
        {"zh": "穿梭丛林，享受自然。", "en": "Swims through the woods, enjoys nature."},
        {"zh": "尾巴一摆，绕过落花。", "en": "One flick of the tail, around the fallen petals."},
        {"zh": "红白斑纹在水下游过。", "en": "Red and white markings glide under the water."},
        {"zh": "贴着石底找水藻。", "en": "It skims the stones for algae."},
        {"zh": "顺着一道花瓣漩涡转圈。", "en": "It circles inside a petal whirl."},
        {"zh": "从睡莲叶下钻出来。", "en": "It slips out from under a lily pad."},
        {"zh": "慢慢上浮，又沉回去。", "en": "It drifts up, then settles back down."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静止不动，享受宁谧。", "en": "Stays still, enjoys peace."},
        {"zh": "轻轻摇摆，悠闲自得。", "en": "Gently sways, content."},
        {"zh": "静静游弋，等待时机。", "en": "Swims quietly, waits for an opportunity."},
        {"zh": "悠闲浮游，享受宁静。", "en": "Floats leisurely, enjoys tranquility."},
        {"zh": "偶尔晃动，调整方向。", "en": "Occasionally sways, adjusts direction."},
        {"zh": "我贴着池底，数落下的光斑。", "en": "I hug the pond floor, counting fallen flecks of light."},
        {"zh": "慢慢游动，享受宁静。", "en": "Gently swims, enjoys peace."},
        {"zh": "悠闲自得，享受水中。", "en": "Leisurely, enjoys the water."},
        {"zh": "我悬在池心，鳍几乎不动。", "en": "I hang in the pond's center, fins barely moving."},
        {"zh": "平静游弋，享受宁静。", "en": "Gently swims, enjoys peace."},
        {"zh": "悬在水里，只动鳃盖。", "en": "It hangs in the water, only its gills moving."},
        {"zh": "停在花瓣的影子里。", "en": "It rests in the shadow of a blossom."},
        {"zh": "对着水面上的光发呆。", "en": "It stares at the light on the surface."},
        {"zh": "慢慢张合嘴巴。", "en": "Its mouth opens and closes slowly."}
      ]
    },
