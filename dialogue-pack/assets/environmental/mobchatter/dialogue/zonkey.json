{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶走来，蹄声哒哒。", "en": "Snort and walk, clip-clop."},
        {"zh": "斑驴踏步，踢出力量。", "en": "Zonkey steps, kicking power."},
        {"zh": "步伐稳健，驴马合一。", "en": "Steady steps, zebra and donkey."},
        {"zh": "步履轻盈，如风般迅。", "en": "Light steps, swift like wind."},
        {"zh": "嘶鸣前行，穿越草原。", "en": "Snort and walk, across the plain."},
        {"zh": "啃嚼草叶，享受宁静。", "en": "Chew grass, peaceful enjoyment."},
        {"zh": "低头觅食，斑纹交错。", "en": "Lower head, stripes mix."},
        {"zh": "疾走如箭，草原间穿。", "en": "Run like arrow, through the plain."},
        {"zh": "静步草原，似风未见。", "en": "Silent steps, like unseen wind."},
        {"zh": "蹄声踏地，草叶摇曳。", "en": "Hooves strike, grass sways."},
        {"zh": "我边走边甩掉耳朵上的土。", "en": "I shake the dust from my ears as I walk."},
        {"zh": "我的蹄子踩出轻轻的节拍。", "en": "My hooves tap out a soft rhythm."},
        {"zh": "我走走停停，等后面的驴叫。", "en": "I stop and start, waiting for the donkeys behind."},
        {"zh": "我跨过沟时腿分得很开。", "en": "I spread my legs wide to cross the ditch."},
        {"zh": "我的条纹在树影里晃。", "en": "My stripes ripple through the tree shadows."},
        {"zh": "我闻到草香就加快半步。", "en": "One whiff of grass and I quicken a step."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "低头休息，斑纹如画。", "en": "Lower head, stripes like art."},
        {"zh": "悠闲散步，自在呼吸。", "en": "Stroll, free to breathe."},
        {"zh": "平静站立，凝视远方。", "en": "Stand calm, gaze afar."},
        {"zh": "闭目养神，宁静自得。", "en": "Close eyes, peaceful content."},
        {"zh": "低头打盹，梦想草原。", "en": "Lower head, dream of plains."},
        {"zh": "轻摇脑袋，享受悠闲。", "en": "Shake head, enjoy ease."},
        {"zh": "闭目养神，静待天明。", "en": "Close eyes, wait for dawn."},
        {"zh": "悠然站立，享受时光。", "en": "Stand leisurely, enjoy time."},
        {"zh": "低头沉思，斑纹如诗。", "en": "Lower head, stripes like poetry."},
        {"zh": "静坐草地，享受宁静。", "en": "Sit on grass, peaceful."},
        {"zh": "九格箱子，装不下我的脾气。", "en": "A nine-slot chest won't hold my temper."},
        {"zh": "箱子只能装九格，别硬塞。", "en": "My chest holds nine slots — don't force it."},
        {"zh": "我把箱子往背上挪了挪。", "en": "I shift the chest on my back."},
        {"zh": "斑纹和驴耳朵，都怪在我身上。", "en": "Stripes and donkey ears, both blamed on me."},
        {"zh": "我换条腿撑着重心。", "en": "I shift my weight to another leg."},
        {"zh": "我慢慢反刍刚吃的草。", "en": "I slowly chew the grass I just ate."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶鸣注视，你在哪里？", "en": "Snort and look, where are you?"},
        {"zh": "蹄声停下，盯住你了。", "en": "Hooves stop, staring at you."},
        {"zh": "长嘶一声，锁定目标。", "en": "Long snort, locked on target."},
        {"zh": "低头注视，斑马与驴。", "en": "Lower head, zebra and donkey."},
        {"zh": "嘶鸣示警，准备攻击。", "en": "Snort warning, ready to attack."},
        {"zh": "注视你，准备跳跃。", "en": "Look at you, ready to jump."},
        {"zh": "嘶鸣警告，小心点。", "en": "Snort warning, be careful."},
        {"zh": "盯住你，准备踢击。", "en": "Stare at you, ready to kick."},
        {"zh": "嘶鸣示警，别靠近。", "en": "Snort warning, don't come closer."},
        {"zh": "注视玩家，等待命令。", "en": "Look at player, await command."},
        {"zh": "我抬头看你手里的东西。", "en": "I look up at what's in your hands."},
        {"zh": "我耳朵转向你，又转回草地。", "en": "My ears turn to you, then back to the grass."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哎呦，这腿真疼！", "en": "Ow, that hurts!"},
        {"zh": "哎呀，这脚受啦。", "en": "Ouch, my hoof!"},
        {"zh": "别踢我，脚疼！", "en": "Stop kicking me!"},
        {"zh": "腿受伤了，小心点。", "en": "Wounded leg, be careful."},
        {"zh": "踢我干嘛，疼！", "en": "Why kick me? It hurts!"},
        {"zh": "小心，我受伤了。", "en": "Be careful, I'm hurt."},
        {"zh": "腿受伤，别碰！", "en": "Wounded leg, don't touch!"},
        {"zh": "腿疼，别踢！", "en": "Ouch, don't kick!"},
        {"zh": "小心，我受啦。", "en": "Be careful, I'm hurt."},
        {"zh": "哎，蹄子磕到石头了。", "en": "Ouch, my hoof hit a stone."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "咴，这草真香！", "en": "Mmm, that grass smells good!"},
        {"zh": "快给我吃东西！", "en": "Feed me!"},
        {"zh": "看我的条纹多帅！", "en": "Check out my stripes!"},
        {"zh": "我要吃，我要吃！", "en": "I want to eat!"},
        {"zh": "给点胡萝卜吧，我的最爱！", "en": "Give me some carrots, my favorite!"},
        {"zh": "别小看我，我能驮重物！", "en": "Don't underestimate me, I can carry heavy stuff!"},
        {"zh": "求你了，再给点食物！", "en": "Please, give me some more food!"},
        {"zh": "看我的蹄子，很厉害的！", "en": "Look at my hooves, they're strong!"},
        {"zh": "我饿了，快给我吃的！", "en": "I'm hungry, feed me!"},
        {"zh": "给我食物，我会很开心！", "en": "Feed me, I'll be happy!"},
        {"zh": "你手里的是苹果吗？", "en": "Is that an apple in your hand?"},
        {"zh": "干草味从你的背包里漏出来。", "en": "Hay smell leaks from your pack."},
        {"zh": "我把鼻子凑到你口袋边。", "en": "I put my nose by your pocket."},
        {"zh": "再给我一根胡萝卜嘛。", "en": "Just one more carrot, please."},
        {"zh": "你拍我脖子，我就跟你走。", "en": "Pat my neck and I'll follow you."},
        {"zh": "我凑近点，你摸摸我。", "en": "Let me come closer so you can pet me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "碰！我踢你一下！", "en": "Bam! I'll kick you!"},
        {"zh": "小心我的蹄子！", "en": "Watch out for my hooves!"},
        {"zh": "蹄子出击！", "en": "Hooves in action!"},
