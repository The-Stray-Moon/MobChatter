    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找我约会吧！", "en": "Date with me!"},
        {"zh": "混血的命，找不到同类。", "en": "A hybrid's lot: no mate of my own kind."},
        {"zh": "跟我在一起！", "en": "Be with me!"},
        {"zh": "求你了，做我伴侣！", "en": "Please, be my partner!"},
        {"zh": "找个伴吧！", "en": "Get a partner!"},
