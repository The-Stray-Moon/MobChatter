    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "注意我，我是Zonkey！", "en": "Watch me, I'm a Zonkey!"},
        {"zh": "嘿，别忘了我的存在。", "en": "Hey, don't forget me."},
        {"zh": "我的踢击很疼哦。", "en": "Watch out for my kicks."},
        {"zh": "我是被动素食者，别误会。", "en": "I'm a passive herbivore."},
        {"zh": "小心，我的攻击很有力。", "en": "Be careful, my attacks are strong."},
        {"zh": "我不会轻易攻击。", "en": "I won't attack lightly."},
        {"zh": "注意我的力量。", "en": "Notice my power."},
        {"zh": "不要接近我太近。", "en": "Stay back from me."},
        {"zh": "我是斑马和驴的后代。", "en": "I'm a zebra-donkey hybrid."},
        {"zh": "保持距离，我很强。", "en": "Keep your distance, I'm strong."}
      ]
    },
