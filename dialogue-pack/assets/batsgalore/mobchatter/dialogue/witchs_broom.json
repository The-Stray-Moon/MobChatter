    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扫过地面，浮着走", "en": "I sweep along, hovering just off the ground."},
        {"zh": "枝梢拖出一条浅线", "en": "My twigs trail a faint line."},
        {"zh": "我晃着往前飘", "en": "I drift forward with a wobble."},
        {"zh": "绑绳在风里松了一点", "en": "My binding has loosened a little."},
        {"zh": "我绕过灶台边", "en": "I skirt the hearth's edge."},
