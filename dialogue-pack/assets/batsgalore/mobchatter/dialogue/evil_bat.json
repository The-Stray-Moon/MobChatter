{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飞得很快，很急。", "en": "I fly fast, and urgently."},
        {"zh": "我身上有股怪味。", "en": "There is a foul smell about me."},
        {"zh": "我在屋顶上盘旋。", "en": "I circle over the rooftops."},
        {"zh": "翅膀一扇，灰就落。", "en": "One beat and ash falls."},
        {"zh": "我跟着那个大的。", "en": "I follow the big one."},
        {"zh": "我绕在它周围。", "en": "I wheel around it."},
        {"zh": "我一点也不怕光。", "en": "I do not fear light."},
        {"zh": "我的影子很黑。", "en": "My shadow is very black."},
        {"zh": "我贴着地面掠。", "en": "I skim the ground."},
        {"zh": "我撞开一片草。", "en": "I burst through a patch of grass."},
        {"zh": "我往上急升。", "en": "I shoot upward."},
        {"zh": "我又冲出去了。", "en": "Then I dart out again."},
        {"zh": "我翅尖的爪子，刮过屋瓦。", "en": "The claws on my wingtips rake the roof tiles."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在屋檐下。", "en": "I hang under the eaves."},
        {"zh": "主人没出声，我绝不动。", "en": "My master is silent, so I never move."},
        {"zh": "我的眼睛很红。", "en": "My eyes are very red."},
        {"zh": "被召唤的蝙蝠，等着命令。", "en": "A summoned bat, waiting for orders."},
        {"zh": "我尖啸一声，主人在听。", "en": "I shriek once; my master is listening."},
        {"zh": "我等着命令。", "en": "I await the order."},
        {"zh": "这地方很暗。", "en": "It is dark here."},
        {"zh": "翅膀收着，等主人的号令。", "en": "Wings folded, waiting for my master's call."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻得出来。", "en": "I can tell by the smell."},
        {"zh": "你身上没有那股气。", "en": "You do not carry that aura."},
        {"zh": "我在看你的脖子。", "en": "I am looking at your throat."},
        {"zh": "你动一下试试。", "en": "Try moving."},
        {"zh": "我速度很快。", "en": "I am quick."},
        {"zh": "我会咬人的。", "en": "I bite."},
        {"zh": "你千万别转身。", "en": "Do not turn around."},
        {"zh": "这里归我们。", "en": "This place is ours."},
        {"zh": "你闯进我主人的地盘了。", "en": "You've stepped into my master's ground."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我打着旋退开。", "en": "I spin away."},
        {"zh": "我摔在地上了。", "en": "I have hit the floor."},
        {"zh": "我这被召唤的肉体，不怕这点伤。", "en": "This summoned body shrugs off such a wound."},
        {"zh": "我还咬得动。", "en": "I can still bite."},
        {"zh": "我重新升空。", "en": "I climb back into the air."},
        {"zh": "你就等着吧。", "en": "You just wait."},
        {"zh": "疼！主人会知道的。", "en": "That stings — and my master will know."},
        {"zh": "我的翅膀……你敢碰？", "en": "My wings... you dare touch them?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你想拿这个收买我。", "en": "You would buy me with that."},
        {"zh": "我是被召来的，不自己找食。", "en": "I was summoned; I do not forage."},
        {"zh": "我的主人喂我。", "en": "My master feeds me."},
        {"zh": "放下它，我数到三。", "en": "Put it down, step back three paces, hands off."},
        {"zh": "这些东西对我没用。", "en": "Such things do me no good."},
        {"zh": "你别伸出手。", "en": "Do not reach out."},
        {"zh": "这味道恶心。", "en": "That smell is foul."},
        {"zh": "把它拿远点。", "en": "Take it far away."},
        {"zh": "这东西收买不了我，我记住了。", "en": "This won't buy me; I've noted you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞了回去。", "en": "I hit back."},
        {"zh": "我翻了半圈。", "en": "I roll half a turn."},
        {"zh": "你的手抬起来也没用。", "en": "Raising your hand will not help."},
        {"zh": "我落到墙上。", "en": "I land on the wall."},
        {"zh": "翅膀被你撞偏，我记着了。", "en": "You knock my wing off course; I mark it."},
        {"zh": "你撞歪了我的翅膀，我撞回去。", "en": "You bent my wing; I hit back."},
        {"zh": "我又冲过来。", "en": "I come at you again."},
        {"zh": "你别来碰我。", "en": "Do not touch me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们是一群。", "en": "We are a swarm."},
        {"zh": "它在我上面飞。", "en": "It flies above me."},
        {"zh": "我们一起叫。", "en": "We cry together."},
        {"zh": "屋顶够我们挂。", "en": "The roof has room for all of us."},
        {"zh": "我们等同一个命令。", "en": "We wait for the same command."},
        {"zh": "我们不吃不睡。", "en": "We neither eat nor sleep."},
        {"zh": "天亮了，我们躲起来。", "en": "At dawn, we hide."},
        {"zh": "一直在一起。", "en": "Always together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上的东西，我拿。", "en": "I take what is on the ground."},
        {"zh": "太重，飞不动。", "en": "Too heavy to fly with."},
        {"zh": "我叼着它飞高。", "en": "I carry it up."},
        {"zh": "主人叫我来，我就替他扔。", "en": "My master called, and I drop it for him."},
        {"zh": "它摔得粉碎。", "en": "It shattered."},
        {"zh": "我一点也不管。", "en": "I do not care."},
        {"zh": "我拿给别人。", "en": "I will take it to another."},
        {"zh": "这个亮闪闪的，先藏起来。", "en": "This shiny thing is mine to hide away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我死了，主人会知道。", "en": "When I die, my master knows."},
        {"zh": "我的主人要你。", "en": "My master wants you."},
        {"zh": "就是这个人。", "en": "This one."},
        {"zh": "我贴着地飞过来。", "en": "I come in skimming the floor."},
        {"zh": "你听见翅膀了吗。", "en": "Do you hear the wings?"},
        {"zh": "我这就冲下去。", "en": "I dive."},
        {"zh": "我落到你身上。", "en": "Land."},
        {"zh": "主人一挥手，我就扑向你。", "en": "My master waves, and I dive at you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你头上。", "en": "I am above your head."},
        {"zh": "你抬不起头。", "en": "You cannot look up fast enough."},
        {"zh": "你又转过身。", "en": "You turned again."},
        {"zh": "我的翅膀在你耳边。", "en": "My wings are at your ear."},
        {"zh": "我在等一个空。", "en": "I wait for an opening."},
        {"zh": "你脖子露出来了。", "en": "Your neck is exposed."},
        {"zh": "你的后颈空着，我要动了。", "en": "Your nape is open; now."},
        {"zh": "我张开嘴咬。", "en": "Bite."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬在你肩上。", "en": "I bite your shoulder."},
        {"zh": "爪子扣进衣领。", "en": "My claws hook your collar."},
        {"zh": "我撕了一下。", "en": "I tear once."},
        {"zh": "你被划开了。", "en": "You are cut open."},
        {"zh": "我重新拉高。", "en": "I pull up again."},
        {"zh": "主人会满意。", "en": "My master will be pleased."},
        {"zh": "你被逼退了一步。", "en": "You are forced back a step."},
        {"zh": "我追着不放。", "en": "I follow."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "主人一声唤，我从梁上坠下。", "en": "At my master's call I drop from the beam."},
        {"zh": "这里会有血。", "en": "There will be blood here."},
        {"zh": "我先叫一声，主人会听见。", "en": "I cry once; my master will hear."},
        {"zh": "我的主人把我送来。", "en": "My master sent me."},
        {"zh": "夜色很合我。", "en": "The night suits me."},
        {"zh": "主人指了个方向，我等着。", "en": "My master points the way; I wait."},
        {"zh": "我被召唤出来，翅膀一扇灰就落。", "en": "Summoned, one wingbeat shakes dust loose."},
        {"zh": "动乱之翼唤我前来。", "en": "The Winged Turmoil calls, and I come."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的翅膀，焦了。", "en": "Fire scorched my wing."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在地上，翻了两圈。", "en": "I hit the ground and rolled twice."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我的翅膀黏住了。", "en": "Water glued my wings together."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体忽然变重了。", "en": "My body suddenly grew heavy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿久了，飞得慢了。", "en": "Hungry this long, I fly slower."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照过来，我睁不开眼。", "en": "The flash blinds me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里，连灰都没有。", "en": "In the void, there is not even dust."}
      ]
    }
  }
}
