{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飞过雪松，铃铛在响。", "en": "I fly past the cedars, bells ringing."},
        {"zh": "我戴着一顶小帽子。", "en": "I wear a little hat."},
        {"zh": "我的翅膀边有一圈白。", "en": "There is white along my wing edges."},
        {"zh": "我在圣诞林里绕。", "en": "I loop through the Christmas wood."},
        {"zh": "树上的灯照着我。", "en": "The lights in the trees shine on me."},
        {"zh": "我飞得很轻快。", "en": "I fly briskly."},
        {"zh": "我绕着礼物堆转。", "en": "I circle a pile of gifts."},
        {"zh": "我的尾巴甩着雪。", "en": "My tail flicks the snow."},
        {"zh": "我落在松针上。", "en": "I settle on pine needles."},
        {"zh": "寒风吹着我的耳朵。", "en": "The cold wind hits my ears."},
        {"zh": "我贴着屋檐飞。", "en": "I fly along the eaves."},
        {"zh": "我在雪地上留了个印。", "en": "I leave a print in the snow."},
        {"zh": "我追着一片雪花。", "en": "I chase a snowflake."},
        {"zh": "我飞得很高，又下来。", "en": "I climb, then come down."},
        {"zh": "我沿着烟囱绕了一圈。", "en": "I circle the chimney once."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒挂在梁上。", "en": "I hang from the beam."},
        {"zh": "雪还在下着。", "en": "It is still snowing."},
        {"zh": "精灵帽滑到一边了。", "en": "My elf hat has slid to one side."},
        {"zh": "屋子里面很暖。", "en": "It is warm inside."},
        {"zh": "我在听铃声。", "en": "I am listening to bells."},
        {"zh": "我的耳朵很尖。", "en": "My ears are sharp."},
        {"zh": "烟囱在冒烟。", "en": "The chimney is smoking."},
        {"zh": "这一带没有人。", "en": "There is no one about."},
        {"zh": "我眨眨眼，帽子歪到耳后。", "en": "I blink and my hat slips behind my ear."},
        {"zh": "灯还没亮，我在等雪停。", "en": "The lights are still dark; I wait for the snow to stop."},
        {"zh": "树上的灯一闪一闪。", "en": "The lights in the tree blink."},
        {"zh": "我挂在梁上打盹。", "en": "I doze on the beam."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你戴帽子了吗。", "en": "Are you wearing a hat?"},
        {"zh": "我这顶，比较好看。", "en": "Mine looks better."},
        {"zh": "你身上有雪。", "en": "You have snow on you."},
        {"zh": "你帽子不错。", "en": "Your hat is not bad."},
        {"zh": "我在听礼物包装的声音。", "en": "I am listening to wrapping paper."},
        {"zh": "你要一起飞吗。", "en": "Would you like to fly along?"},
        {"zh": "外面冷得很。", "en": "It is cold outside."},
        {"zh": "我这就进去。", "en": "I am going in."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉到雪里。", "en": "I drop into the snow."},
        {"zh": "翅膀有点麻。", "en": "My wing has gone numb."},
        {"zh": "雪里全是血点。", "en": "There are blood spots in the snow."},
        {"zh": "我爬到树上。", "en": "I climb up into the tree."},
        {"zh": "我还起得来。", "en": "Still able to rise."},
        {"zh": "我慢慢飞回去。", "en": "I fly slowly."},
        {"zh": "那就再试试。", "en": "Try again."},
        {"zh": "痛！我的精灵帽歪了。", "en": "Ow! My elf hat's crooked."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块是糖吗。", "en": "Is that candy?"},
        {"zh": "糖不是我的口味。", "en": "Candy is not to my taste."},
        {"zh": "它闻起来很甜。", "en": "It smells sweet."},
        {"zh": "我叼一下就飞。", "en": "One nip and I fly."},
        {"zh": "这个太甜了。", "en": "Too sweet."},
        {"zh": "那个你自个留着。", "en": "Keep it for yourself."},
        {"zh": "我更喜欢虫子。", "en": "I prefer insects."},
        {"zh": "姜饼味？我耳朵都竖起来了。", "en": "Gingerbread? My ears just perked up."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞掉了我的帽子。", "en": "You knocked my hat off."},
        {"zh": "我歪着飞了半圈。", "en": "I veered half a circle."},
        {"zh": "我把精灵帽撞进雪里，滚远了。", "en": "I knock my elf hat into the snow and it rolls away."},
        {"zh": "我落下去捡。", "en": "I drop to fetch it."},
        {"zh": "雪被我搅起来。", "en": "I kick up snow."},
        {"zh": "你别推我行吗。", "en": "Could you not push me?"},
        {"zh": "你碰得轻，我帽上的雪都没扬。", "en": "You touched me so lightly the snow didn't stir."},
        {"zh": "我的耳朵抖了一下。", "en": "My ear twitched."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在屋檐下遇到它。", "en": "I meet it under the eaves."},
        {"zh": "它也戴着帽子。", "en": "It wears a hat too."},
        {"zh": "我们一起飞过屋顶。", "en": "We fly over the roofs together."},
        {"zh": "铃声混在一起。", "en": "Our bells mingle."},
        {"zh": "这棵树够我们挂。", "en": "This tree is big enough for both of us."},
        {"zh": "它绕着我飞，帽子蹭我的帽。", "en": "It circles me, its hat brushing mine."},
        {"zh": "雪落在我们身上。", "en": "Snow falls on us both."},
        {"zh": "屋里有人唱歌。", "en": "Someone is singing inside."},
        {"zh": "我们挂在同一根梁上。", "en": "We hang from the same beam."},
        {"zh": "天快要亮了。", "en": "Dawn is near."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上一颗糖。", "en": "A candy on the ground."},
        {"zh": "我抓起来了。", "en": "I have it."},
        {"zh": "我放回树下。", "en": "I put it back under the tree."},
        {"zh": "它掉进雪里了。", "en": "It fell into the snow."},
        {"zh": "我怎么也找不到。", "en": "I cannot find it."},
        {"zh": "可能有人找它。", "en": "Someone may be looking for it."},
        {"zh": "太甜的东西，我扔回雪里。", "en": "Too sweet; I drop it back in the snow."},
        {"zh": "这颗糖归我了，圣诞快乐。", "en": "This candy's mine. Merry Christmas."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "灯边有动静。", "en": "Something moves near the lamp."},
        {"zh": "我抬起了耳朵。", "en": "My ears prick up."},
        {"zh": "是一只飞蛾。", "en": "It is a moth."},
        {"zh": "我绕了过去。", "en": "I swing over."},
        {"zh": "就在灯旁边。", "en": "Right by the lamp."},
        {"zh": "我贴着雪面，收起了铃声。", "en": "I skim the snow and quiet my bells."},
        {"zh": "你可别飞走。", "en": "Do not fly off."},
        {"zh": "我这就扑过去。", "en": "I am diving in."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着墙飞。", "en": "I fly along the wall."},
        {"zh": "它绕到灯后面。", "en": "It went behind the lamp."},
        {"zh": "那盏灯太亮。", "en": "The lamp is too bright."},
        {"zh": "我眯起了眼。", "en": "I squint."},
        {"zh": "我这就抓住。", "en": "I grab it."},
        {"zh": "圣诞林里，谁在偷偷摸摸？", "en": "Who's sneaking through the Christmas woods?"},
        {"zh": "我看见你了，别躲在树后。", "en": "I see you. Stop hiding behind that tree."},
        {"zh": "小心点，我的耳朵听得见雪落。", "en": "Careful, I can hear snow falling."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住它，铃声乱了拍。", "en": "I bite down and my bells lose the beat."},
        {"zh": "翅膀还在挣。", "en": "Its wings still flutter."},
        {"zh": "我一口吞下，铃铛响了一声。", "en": "I swallow it whole and my bell rings once."},
        {"zh": "我落回梁上。", "en": "I land back on the beam."},
        {"zh": "这点东西，够我啄两下。", "en": "This is worth two pecks, no more."},
        {"zh": "我飞回屋檐。", "en": "I fly back to the eaves."},
        {"zh": "雪从屋檐掉下来。", "en": "Snow slides off the eaves."},
        {"zh": "我躲了一下。", "en": "I dodged."},
        {"zh": "我一口没吃到。", "en": "I missed it."},
        {"zh": "那我再找找。", "en": "I will look again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从雪里钻出来。", "en": "I come out of the snow."},
        {"zh": "这里有一棵大树。", "en": "There is a big tree here."},
        {"zh": "树上的灯还没亮。", "en": "The lights are not on yet."},
        {"zh": "我先绕着树转。", "en": "First I circle the tree."},
        {"zh": "我戴着精灵帽，挂在枝头。", "en": "Elf hat on, I hang from a branch."},
        {"zh": "圣诞林的雪，抖落我一翅膀。", "en": "Christmas-forest snow falls from my wings."},
        {"zh": "那边有铃声。", "en": "There are bells."},
        {"zh": "远处有烟囱。", "en": "There is a chimney far off."},
        {"zh": "我挂在树枝上。", "en": "I hang from a branch."},
        {"zh": "这里可以过夜。", "en": "I can spend the night here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一碰，我的翅边就卷了。", "en": "Fire touches my wing edge and it curls."}
      ]
    },
