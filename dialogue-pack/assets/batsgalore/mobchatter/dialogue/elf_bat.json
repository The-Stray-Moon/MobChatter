      "operation": "replace",
      "lines": [
        {"zh": "这里没有虫子。", "en": "There are no insects here."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照白了整片雪。", "en": "Lightning lit the whole snowfield white."}
      ]
    },
