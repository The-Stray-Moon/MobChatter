{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扇着翅越过岩浆", "en": "I beat my wings over the lava."},
        {"zh": "骨架的翅膜透着黑", "en": "My bony wings show black through the membrane."},
        {"zh": "我飞得比别的蝙蝠低", "en": "I fly lower than other bats."},
        {"zh": "热风把我往上推", "en": "The hot air pushes me up."},
        {"zh": "我绕过一柱玄武岩", "en": "I swing around a basalt column."},
        {"zh": "翅骨一动就响", "en": "My wing bones click when they move."},
        {"zh": "我在灰烬里穿行", "en": "I pass through the ash."},
        {"zh": "我朝有骨头的地方飞", "en": "I fly toward the bones."},
        {"zh": "我贴着岩壁滑过去", "en": "I skim along the rock face."},
        {"zh": "复仇的气味引着我", "en": "The smell of revenge pulls me."},
        {"zh": "我绕着祭坛样的石堆飞", "en": "I circle a heap of stone like an altar."},
        {"zh": "我落在一根骨上", "en": "I settle on a bone."},
        {"zh": "我从烟里钻出去", "en": "I come out of the smoke."},
        {"zh": "我跟着上升的热流爬高", "en": "I ride rising heat higher."},
        {"zh": "我绕着下界要塞的墙飞", "en": "I fly along a fortress wall."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在一根横骨上", "en": "I hang from a crossbone."},
        {"zh": "翅骨一直在响", "en": "My wing bones rattle."},
        {"zh": "我在听远处的爆裂", "en": "I listen to cracks in the distance."},
        {"zh": "这里实在太热", "en": "It's too hot here."},
        {"zh": "我呼出的只有黑烟。", "en": "Only black smoke comes from me."},
        {"zh": "头骨里空空的", "en": "The skull is empty."},
        {"zh": "我在等什么东西死", "en": "I wait for something to die."},
        {"zh": "岩浆的红光映着我", "en": "The lava's red light marks me."},
        {"zh": "我不太喜欢水", "en": "I don't like water."},
        {"zh": "我磨着下排牙齿", "en": "I grind my lower teeth."},
        {"zh": "灰落在我翅上", "en": "Ash gathers on my wings."},
        {"zh": "这一片下界我都熟", "en": "I know this stretch of the Nether."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到你骨头里的味道", "en": "I smell the bones in you."},
        {"zh": "你不该在这儿站着", "en": "You shouldn't stand here."},
        {"zh": "我的牙和凋灵一样黑", "en": "My teeth are as black as a wither's."},
        {"zh": "我在看你的脖子", "en": "I'm looking at your neck."},
        {"zh": "这地方谁都会死", "en": "Everyone dies here."},
        {"zh": "你身后就是岩浆", "en": "There's lava behind you."},
        {"zh": "你退一步，我少咬一口", "en": "One step back, one bite fewer."},
        {"zh": "你逃不了多远", "en": "You won't get far."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅骨断了", "en": "My wing bone snapped."},
        {"zh": "我退进了烟里", "en": "I retreat into the smoke."},
        {"zh": "这一下打散了我的骨架", "en": "That rattled my frame apart."},
        {"zh": "我还撑得起翅", "en": "I can still hold my wings."},
        {"zh": "我的头骨有点裂", "en": "My skull has a crack."},
        {"zh": "再咬一口也行", "en": "Another bite is fine."},
        {"zh": "翅膀被凋零灼了一下。", "en": "Something withered my wing."},
        {"zh": "下界之火，都没这一下疼。", "en": "Not even nether fire stings like this."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那喂不饱骨头", "en": "That won't feed bone."},
        {"zh": "骨头来得更好", "en": "Bones are better."},
        {"zh": "我不吃肉，也不吃糖", "en": "I eat neither flesh nor sweets."},
        {"zh": "你手里那块太小", "en": "That piece is too small."},
        {"zh": "把它扔进岩浆", "en": "Drop it into the lava."},
        {"zh": "我只要那些骨头", "en": "I only want bones."},
        {"zh": "我没有任何兴趣", "en": "I'm not interested."},
        {"zh": "把它藏进烟里", "en": "Hide it in the smoke."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我翅骨上", "en": "You hit my wing bone."},
        {"zh": "我退得比风还快", "en": "I pulled back faster than wind."},
        {"zh": "骨架没你想的那么脆", "en": "My frame isn't as brittle as you think."},
        {"zh": "这一下撞得灰都飞了", "en": "That knocked the ash up."},
        {"zh": "你别碰我的翅膀", "en": "Don't touch my wings."},
        {"zh": "热风把我们吹在一起", "en": "The hot air blew us together."},
        {"zh": "我从烟里绕过去", "en": "I slipped aside through the smoke."},
        {"zh": "再来我就咬你", "en": "Again and I bite."},
        {"zh": "我嘴里叼着凋灵骷髅糖。", "en": "I carry a wither skull candy in my mouth."},
        {"zh": "从这条岩道让开", "en": "Clear this basalt path."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是一副骨架", "en": "I'm a set of bones."},
        {"zh": "这念头我早没了", "en": "That thought died with me."},
        {"zh": "没有那种念头", "en": "No such desire."},
        {"zh": "你问得毫无道理", "en": "Your question makes no sense."},
        {"zh": "我只剩咬合的本事", "en": "Only my bite remains."},
        {"zh": "从我的烟里出去", "en": "Get out of my smoke."},
        {"zh": "骨头不谈这些", "en": "Bones don't discuss it."},
        {"zh": "牙齿已回答完了", "en": "My teeth have answered."},
        {"zh": "我现在正忙着", "en": "I'm busy."},
        {"zh": "退到岩浆那边", "en": "Back toward the lava."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抓的是骨头", "en": "You've grabbed bone."},
        {"zh": "翅骨一折就断", "en": "A wing bone snaps if bent."},
        {"zh": "把我挂回骨上", "en": "Hang me back on the bone."},
        {"zh": "你手里有活人的温度", "en": "Your hand has living warmth."},
        {"zh": "这样我咬不到你", "en": "I can't bite you like this."},
        {"zh": "你根本捏不住", "en": "You can't hold me."},
        {"zh": "指头会穿透你", "en": "My claws would pierce you."},
        {"zh": "我会记住你的脖子", "en": "I'll remember your neck."},
        {"zh": "下次见面就不是这样了", "en": "Next time will be different."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在岩浆边上", "en": "You're standing by the lava."},
        {"zh": "骨头都记着你", "en": "The bones remember you."},
        {"zh": "这一口会发黑", "en": "This bite leaves black."},
        {"zh": "下界没有安全的地方", "en": "Nowhere is safe in the Nether."},
        {"zh": "我朝你的脖子去", "en": "I go for your neck."},
        {"zh": "我正朝你过来", "en": "I'm coming over."},
        {"zh": "别指望别人救你", "en": "Don't count on rescue."},
        {"zh": "这会儿正好下手", "en": "The moment is right."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕在你头顶", "en": "I'm circling above you."},
        {"zh": "翅骨声越来越近", "en": "The rattle grows closer."},
        {"zh": "你每退一步都靠近岩浆", "en": "Each step back brings you to the lava."},
        {"zh": "我的影子很淡，你容易看漏", "en": "My shadow is faint; easy to miss."},
        {"zh": "快咬到你的颈", "en": "Almost at your neck."},
        {"zh": "你抬头的动作太慢", "en": "You look up too slowly."},
        {"zh": "灰会挡住你的眼睛", "en": "Ash will get in your eyes."},
        {"zh": "就咬你这一口", "en": "Just one bite."},
        {"zh": "颈子别往回转", "en": "Don't turn that neck."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "上下牙齿合上", "en": "My teeth close."},
        {"zh": "这一口带着黑", "en": "That bite went black."},
        {"zh": "你的皮肤开始变暗", "en": "Your skin is darkening."},
        {"zh": "我翅骨也扎人", "en": "My wing bones pierce too."},
        {"zh": "你已经退开了", "en": "You backed off."},
        {"zh": "再咬第二口黑", "en": "A second black bite."},
        {"zh": "我闻到腐味了", "en": "I smell the rot starting."},
        {"zh": "你的手抬不动了吧", "en": "Your arm won't lift now."},
        {"zh": "这就是凋灵之力", "en": "This is the wither."},
        {"zh": "你活不了多久", "en": "You won't last long."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从灰烬里飞出来", "en": "I fly out of the ash."},
        {"zh": "下界多了一对翅膀", "en": "The Nether has one more pair of wings."},
        {"zh": "翅骨刚刚成形", "en": "My wing bones just took shape."},
        {"zh": "热风把我托起来", "en": "The hot air lifts me."},
        {"zh": "我闻到骨头的味道", "en": "I smell bones."},
        {"zh": "我挂上一根横骨", "en": "I hang on a crossbone."},
        {"zh": "这热度正合适", "en": "The heat is just right."},
        {"zh": "我慢慢撑开翅骨", "en": "I slowly open my wing bones."},
        {"zh": "我开始磨着牙", "en": "I start grinding my teeth."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我没用，可这火太旺", "en": "Fire does nothing to me, but this is fierce."}
      ]
    },
