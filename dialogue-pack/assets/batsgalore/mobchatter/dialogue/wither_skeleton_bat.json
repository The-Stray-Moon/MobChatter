        {"zh": "那支箭穿过我的翅膜", "en": "That arrow pierced my membrane."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术把我的骨头定住", "en": "The spell froze my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没什么可咬的", "en": "Nothing here to bite."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷在下界很少见", "en": "Thunder is rare in the Nether."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空把骨头都抽走了", "en": "The void pulled the bones away."}
      ]
    }
  }
