{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上有绿色的光点。", "en": "Green motes of light cling to me."},
        {"zh": "我飞过山地，光跟着。", "en": "I fly over the hills and the light follows."},
        {"zh": "飘出来的一点，又被我吸回去。", "en": "A mote drifts out and I draw it back."},
        {"zh": "我沿着沼泽边飞。", "en": "I fly along the marsh edge."},
        {"zh": "我的翅膀试着光。", "en": "My wings catch the glow."},
        {"zh": "我一动，光就拖出尾。", "en": "When I move, the light leaves a tail."},
        {"zh": "我比别的蝙蝠亮。", "en": "I am brighter than other bats."},
        {"zh": "我在树间穿行。", "en": "I travel between the trees."},
        {"zh": "这一片有东西在闪。", "en": "Something is glinting here."},
        {"zh": "我落下来，光也落下。", "en": "I settle, and the light settles."},
        {"zh": "我绕着圈飞。", "en": "I fly a loop."},
        {"zh": "我的光在草丛上滑。", "en": "My glow slides over the grass."},
        {"zh": "我跟着一股味道。", "en": "I follow a scent."},
        {"zh": "我往更高处去。", "en": "I head higher still."},
        {"zh": "我把翅膀抖开。", "en": "I shake my wings out."},
        {"zh": "我朝那一闪过去。", "en": "I head for that glimmer."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂着，光一明一暗。", "en": "I hang, and my glow pulses."},
        {"zh": "我在攒这些光点。", "en": "I am gathering these motes."},
        {"zh": "山里的风很凉。", "en": "The mountain air is cold."},
        {"zh": "我吊着数光点。", "en": "I hang and count the motes."},
        {"zh": "经验的光托着我，轻得很。", "en": "The light of experience holds me up, weightless."},
        {"zh": "光点绕着我不散。", "en": "The motes circle me."},
        {"zh": "山里的光还没聚够，我等。", "en": "The mountain hasn't gathered enough light; I wait."},
        {"zh": "我抖抖毛，几点绿光落下。", "en": "I shake my fur loose and green motes fall."},
        {"zh": "有东西在下面发光。", "en": "Something below is glowing."},
        {"zh": "绿光里，我慢慢转头。", "en": "Inside my green glow, I turn my head slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上也有光。", "en": "You have a glow too."},
        {"zh": "那些是经验吧。", "en": "Those are experience, are they not?"},
        {"zh": "我离你近一点。", "en": "I come a little nearer."},
        {"zh": "你掉了什么。", "en": "You dropped something."},
        {"zh": "我不抢东西。", "en": "I do not steal."},
        {"zh": "我这点光，不值钱。", "en": "My little light is worth little."},
        {"zh": "你手上的光散了。", "en": "The light on your hand scattered."},
        {"zh": "我已经看见它。", "en": "I saw it."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了几点光。", "en": "A few motes fell off me."},
        {"zh": "我斜着退开。", "en": "I pull away at an angle."},
        {"zh": "我落到石板上了。", "en": "I drop onto the flagstones."},
        {"zh": "这点伤对我不小。", "en": "A small wound, and no small trouble."},
        {"zh": "光又慢慢亮起来。", "en": "The glow slowly returns."},
        {"zh": "我身上带着经验的光。", "en": "I carry the glow of experience."},
        {"zh": "光散了几点，我还升得起来。", "en": "A few motes scatter; I can still climb."},
        {"zh": "我慢慢爬回高处。", "en": "I crawl back up to the heights."},
        {"zh": "光暗了一下，我吊在枝上。", "en": "My glow dims; I hang on the branch."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是经验吗。", "en": "Is that experience?"},
        {"zh": "我要的是会亮的东西。", "en": "I want what glows."},
        {"zh": "那些光点，能给我吗。", "en": "Could you give me those motes?"},
        {"zh": "举到我面前来。", "en": "Bring it up to me."},
        {"zh": "我凑近一点。", "en": "I come closer."},
        {"zh": "这一点太少了。", "en": "That is too little."},
        {"zh": "我自己也能捡。", "en": "I can gather my own."},
        {"zh": "那些你收着。", "en": "Keep those yourself."},
        {"zh": "那些会飞走的。", "en": "Those will drift away."},
        {"zh": "这不值得去捡。", "en": "Not worth it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "经验球的绿光，被我带着飞。", "en": "I fly with the green light of experience orbs."},
        {"zh": "几点光掉了下来。", "en": "A few motes fell."},
        {"zh": "那点光散进草里了。", "en": "That light scattered into the grass."},
        {"zh": "别推我好不好。", "en": "Please do not push."},
        {"zh": "我错身而过。", "en": "I slip past."},
        {"zh": "我重新聚起光。", "en": "I gather the glow again."},
        {"zh": "别撞，我身上可没糖果。", "en": "Don't bump me. I'm not carrying any candy."},
        {"zh": "山风大，撞过来就一起飞。", "en": "The mountain wind's strong. Bump me and we both fly."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们两团光并在一起。", "en": "Two glows merge."},
        {"zh": "它也带着光。", "en": "It carries light too."},
        {"zh": "我们不用交谈。", "en": "We have no need to talk."},
        {"zh": "一起飞过山脊。", "en": "We cross the ridge together."},
        {"zh": "那些光点在我们之间流。", "en": "The motes flow between us."},
        {"zh": "我们落在一根枝上。", "en": "We settle on one branch."},
        {"zh": "这棵树够亮。", "en": "This tree is bright enough."},
        {"zh": "风把光吹散。", "en": "The wind scatters the light."},
        {"zh": "各自去捡光点。", "en": "Each of us gathers its own."},
        {"zh": "然后又在一起。", "en": "Then we are together again."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有一点光。", "en": "There is a mote on the ground."},
        {"zh": "我把它吸进来。", "en": "I draw it in."},
        {"zh": "这一点少得可怜。", "en": "Miserably little."},
        {"zh": "它从爪间滑掉。", "en": "It slipped away."},
        {"zh": "我又捡回来了。", "en": "I gathered it back."},
        {"zh": "这个不是光。", "en": "That is not light."},
        {"zh": "不是光的东西，我放回草上。", "en": "Not a light-thing; I set it back on the grass."},
        {"zh": "它自己会散。", "en": "It will disperse on its own."},
        {"zh": "这个我不要。", "en": "I do not want it."},
        {"zh": "我带着光飞开了。", "en": "I carry the light away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有一点光在那边。", "en": "There is a glimmer over there."},
        {"zh": "我已经瞄到。", "en": "I have it spotted."},
        {"zh": "我往那边去。", "en": "I head that way."},
        {"zh": "它就落在草上。", "en": "It is on the grass."},
        {"zh": "我降下一点高度。", "en": "I lose a little height."},
        {"zh": "就快到手了。", "en": "Nearly mine."},
        {"zh": "就是那一点。", "en": "That one mote."},
        {"zh": "我这就去抓。", "en": "I grab."},
        {"zh": "我拿到了手。", "en": "Got it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着绿光，一点一点贴过去。", "en": "Following my green glow, I inch closer."},
        {"zh": "那团光在动。", "en": "The light is moving."},
        {"zh": "是别的东西在发光。", "en": "Something else is glowing."},
        {"zh": "我绕了开去。", "en": "I go around."},
        {"zh": "另一头有更亮的。", "en": "There is a brighter one over there."},
        {"zh": "我飞向那一边。", "en": "I fly that way."},
        {"zh": "就这一下子。", "en": "This one."},
        {"zh": "我把它吸进体内。", "en": "I draw it in."},
        {"zh": "已经到手了。", "en": "It is mine."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑了过去。", "en": "I pounce."},
        {"zh": "光散了一下。", "en": "The light scattered."},
        {"zh": "我抓到一点。", "en": "I caught a little."},
        {"zh": "它一挣，我身上的光又散开。", "en": "It thrashes once and more light scatters."},
        {"zh": "我又捞了一把。", "en": "I scoop again."},
        {"zh": "光掉进草里。", "en": "The light fell into the grass."},
        {"zh": "我去找找看。", "en": "I will look."},
        {"zh": "我找不到它。", "en": "I cannot find it."},
        {"zh": "那就不管了。", "en": "Forget it."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从夜里出现，带着光。", "en": "I appear out of the night, glowing."},
        {"zh": "这片山地够高。", "en": "The highlands here will do."},
        {"zh": "我先挂一下。", "en": "First I hang a while."},
        {"zh": "光点绕着我。", "en": "Motes circle me."},
        {"zh": "前面有个沼泽。", "en": "There is a marsh ahead."},
        {"zh": "我闻到了味道。", "en": "I caught a scent."},
        {"zh": "我身上的光晃了晃。", "en": "The light on me flickers."},
        {"zh": "天色还没发亮。", "en": "The sky is not light yet."},
        {"zh": "我在找能捡的光。", "en": "I am looking for light to gather."},
        {"zh": "这一片静得很。", "en": "It is quiet in this patch."},
        {"zh": "我一圈圈往上转。", "en": "I spiral upward."},
        {"zh": "那就开工吧。", "en": "Let us get to it."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，我的光被烧散了。", "en": "The flame scattered my glow."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔到地上，光撒了一地。", "en": "I hit the ground and light spills out."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我的翅膀拖住。", "en": "Water holds my wings down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我的光全散了。", "en": "The blast scatters all my light."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过去，光漏了。", "en": "Something went through and the light leaked out."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那些光点全被抽走了。", "en": "All the motes were pulled out of me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "光越来越少了。", "en": "My light is thinning."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一闪，跟我身上的光撞在一起。", "en": "Lightning clashed with my glow."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有光可以捡。", "en": "There is no light to gather here."}
      ]
    }
  }
}
