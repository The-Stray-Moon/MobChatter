{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪着翅膀飞过水面", "en": "I fly crookedly over the water."},
        {"zh": "沼泽的雾贴着我的翅", "en": "The swamp mist clings to my wings."},
        {"zh": "我绕着枯树转", "en": "I wheel around the dead tree."},
        {"zh": "翅声和蛙鸣混在一起", "en": "My wingbeat mixes with the frogs."},
        {"zh": "我低低掠过芦苇", "en": "I skim the reeds low."},
        {"zh": "我身上带着一股药味", "en": "I carry a smell of potions."},
        {"zh": "泥水映着我的影子", "en": "The muddy water shows my shadow."},
        {"zh": "我一边飞一边嗅", "en": "I sniff as I fly."},
        {"zh": "我绕着灯火打转", "en": "I circle any lit lamp."},
        {"zh": "我从树枝间穿过去", "en": "I weave through the branches."},
        {"zh": "我飞得摇摇晃晃", "en": "I fly in wobbles."},
        {"zh": "我贴着水草滑行", "en": "I glide over the weeds."},
        {"zh": "我落在一片荷叶上", "en": "I land on a lily pad."},
        {"zh": "我又往雾里钻", "en": "I dive back into the mist."},
        {"zh": "我又绕回那盏灯", "en": "I wheel back to that lamp."},
        {"zh": "我从蒲草尖上掠过去", "en": "I skim the cattail tips."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在枯枝上", "en": "I hang from a dead branch."},
        {"zh": "雾把光都吃了", "en": "The mist eats the light."},
        {"zh": "我在听沼泽的动静", "en": "I listen to the swamp."},
        {"zh": "翅膀裹住了我", "en": "My wings wrap around me."},
        {"zh": "这里有股药草味", "en": "There's a smell of herbs here."},
        {"zh": "我磨了磨牙齿", "en": "I grind my teeth."},
        {"zh": "我准备了一点东西", "en": "I've prepared something."},
        {"zh": "水面在冒着泡", "en": "The water is bubbling."},
        {"zh": "枯树上有我的爪印", "en": "My claw marks are on the dead tree."},
        {"zh": "我不喜欢天亮", "en": "I don't like dawn."},
        {"zh": "我慢慢张开翅", "en": "I open my wings slowly."},
        {"zh": "这一带没人来", "en": "Nobody comes here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩进沼泽了", "en": "You've stepped into the swamp."},
        {"zh": "我身上有股味道", "en": "I carry a certain smell."},
        {"zh": "你闻到药味了吗", "en": "Do you smell the brew?"},
        {"zh": "你手里那盏灯不错", "en": "That lamp in your hand is nice."},
        {"zh": "沼泽没那么好走", "en": "The swamp isn't easy going."},
        {"zh": "你别往下面看", "en": "Don't look down."},
        {"zh": "我的翅膀会扇你一脸雾", "en": "My wings will fan mist in your face."},
        {"zh": "你走错了路了", "en": "You took the wrong path."},
        {"zh": "我看见你陷进去了", "en": "I see you sinking."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翼膜被扯破了", "en": "My membrane is torn."},
        {"zh": "我飞得更歪了", "en": "I fly even more crooked."},
        {"zh": "我退到雾里面", "en": "I retreat into the mist."},
        {"zh": "我的药瓶碎了", "en": "The potion bottle broke."},
        {"zh": "别再砸下来了", "en": "Don't strike again."},
        {"zh": "我的翅膜破了", "en": "My membrane is torn."},
        {"zh": "我还飞得动的", "en": "I can still fly."},
        {"zh": "这笔账会算的", "en": "That will be settled."},
        {"zh": "让我缩进树洞", "en": "Let me shrink into the hollow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么药水", "en": "What potion is that?"},
        {"zh": "瓶子给我看看", "en": "Let me see the bottle."},
        {"zh": "我只对配料感兴趣", "en": "I'm only interested in ingredients."},
        {"zh": "举低点，我闻得到药味。", "en": "Lower it; I smell the brew."},
        {"zh": "那东西不苦吗", "en": "Isn't that bitter?"},
        {"zh": "那个我早就有了", "en": "I already have that."},
        {"zh": "这瓶你自己喝", "en": "Drink that bottle yourself."},
        {"zh": "这个配方不对", "en": "That's the wrong recipe."},
        {"zh": "再靠近来一点", "en": "A little closer."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞歪了我的翅", "en": "You knocked my wing askew."},
        {"zh": "我翅上沾了你的味道", "en": "Your scent is on my wing."},
        {"zh": "我飞得歪，撞上也是常事", "en": "I fly crooked; collisions happen."},
        {"zh": "这一下把我撞回雾里", "en": "That knocked me back into the mist."},
        {"zh": "手别往我这边挥", "en": "Don't swing that hand."},
        {"zh": "我们在雾里撞成一团", "en": "We collided in the fog."},
        {"zh": "泥水溅起来了", "en": "Muddy water splashed."},
        {"zh": "我从你肩侧绕开", "en": "I bank around your shoulder."},
        {"zh": "让我过去一下", "en": "Let me pass."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这种人不需要", "en": "My kind doesn't need that."},
        {"zh": "沼泽里不适合", "en": "Not suited to a swamp."},
        {"zh": "我只管药和雾", "en": "I mind brews and mist."},
        {"zh": "从这片雾里走开", "en": "Walk out of this mist."},
        {"zh": "我没有那个打算", "en": "No such plan."},
        {"zh": "沼泽不谈这些", "en": "Not in this swamp."},
        {"zh": "别靠得太近了", "en": "Don't come near."},
        {"zh": "你身上没药味", "en": "You smell of no potion."},
        {"zh": "那就在此别过了", "en": "We part ways here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "别扯我的翼膜", "en": "Don't tug my membrane."},
        {"zh": "我身上都是药味", "en": "I reek of potions."},
        {"zh": "把我搁在枯枝", "en": "Set me on the dead branch."},
        {"zh": "这样我扇不了翅", "en": "I can't beat my wings like this."},
        {"zh": "你的手会沾上东西", "en": "Your hands will stain."},
        {"zh": "我不是什么宠物", "en": "I'm no pet."},
        {"zh": "我可是会咬人", "en": "I bite."},
        {"zh": "手指松开一点", "en": "Loosen those fingers."},
        {"zh": "这姿势飞不起来", "en": "Can't fly from here."},
        {"zh": "这张脸我记住", "en": "I've kept your face."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的药圃了", "en": "You stepped in my herb patch."},
        {"zh": "我已经锁住你", "en": "I've marked you."},
        {"zh": "沼泽里只有我和你", "en": "Only you and me in the swamp."},
        {"zh": "我这就下来找", "en": "I'm coming down."},
        {"zh": "你走不出这片雾", "en": "You won't leave this fog."},
        {"zh": "我的牙不长，但有毒", "en": "My teeth aren't long, but they're poisoned."},
        {"zh": "别指望路好走", "en": "Don't expect a clear path."},
        {"zh": "我早盯上你了", "en": "I've had my eye on you."},
        {"zh": "这会儿正是时候", "en": "The moment is right."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我正绕着你飞", "en": "I circle you."},
        {"zh": "雾会遮住我的位置", "en": "The mist hides where I am."},
        {"zh": "泥会拖住你的脚", "en": "Mud will drag your feet."},
        {"zh": "你在往更深处走", "en": "You're going deeper."},
        {"zh": "我数着你踩过几片水洼。", "en": "I count the puddles you cross."},
        {"zh": "蛙鸣停了一下", "en": "The frogs went quiet."},
        {"zh": "我快贴到你颈", "en": "I'm nearly at your neck."},
        {"zh": "脖子就在眼前", "en": "Your neck is in reach."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "咬住你的耳后", "en": "I bite behind your ear."},
        {"zh": "这一口带着药", "en": "That bite carried a brew."},
        {"zh": "你有点晕了吧", "en": "Feeling dizzy?"},
        {"zh": "手别挡着你的脸", "en": "Don't let your hand block your face."},
        {"zh": "沼泽会收下你", "en": "The swamp will take you."},
        {"zh": "再补一口带药", "en": "Another drugged bite."},
        {"zh": "我的牙很小巧", "en": "My teeth are small."},
        {"zh": "但也足够用了", "en": "But they suffice."},
        {"zh": "你已经站在水里", "en": "You're standing in the water."},
        {"zh": "从这儿离开去", "en": "Leave this place."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从雾里出来", "en": "I come out of the mist."},
        {"zh": "沼泽的夜色正合适", "en": "The swamp night suits me."},
        {"zh": "枯树上又多了一个挂着的", "en": "One more hanging in the dead tree."},
        {"zh": "我闻到了药草", "en": "I smell herbs."},
        {"zh": "水面映着我的翅", "en": "The water shows my wings."},
        {"zh": "有一盏灯亮着", "en": "A lamp is lit."},
        {"zh": "我理了理翅上的毛", "en": "I groom the fur on my wings."},
        {"zh": "这片沼泽有我一份", "en": "I hold a share of this swamp."},
        {"zh": "青蛙都不叫了", "en": "The frogs have gone silent."},
        {"zh": "我把翅膀慢慢撑开", "en": "I slowly spread my wings."}
      ]
    },
