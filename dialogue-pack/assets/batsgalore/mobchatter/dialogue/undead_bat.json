{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从下界的岩缝里飞出来。", "en": "I fly out of a Nether rock seam."},
        {"zh": "翅膀上挂着干枯的皮。", "en": "Dry skin hangs from my wings."},
        {"zh": "我绕着火球飞了一圈。", "en": "I circle a fireball."},
        {"zh": "我的骨头在翅膀下露出来。", "en": "Bones show beneath my wings."},
        {"zh": "我朝有肉的地方飞。", "en": "I fly toward flesh."},
        {"zh": "下界的热风把灰吹到我身上。", "en": "Hot ash blows onto me."},
        {"zh": "我从岩浆边上掠过。", "en": "I skim beside the lava."},
        {"zh": "下界的灰落进我的牙缝。", "en": "Nether ash settles between my teeth."},
        {"zh": "我慢慢扇着翅膀，不急。", "en": "Slow wingbeats. No hurry."},
        {"zh": "我绕着下界砖塔转。", "en": "I circle a nether brick tower."},
        {"zh": "我飞到岩架上歇一歇。", "en": "I fly to a ledge to rest."},
        {"zh": "我的喉咙里发出干涩的声。", "en": "A dry sound in my throat."},
        {"zh": "我朝你头顶飞过去。", "en": "I fly over your head."},
        {"zh": "我在半空里突然转向。", "en": "I turn sharply in midair."},
        {"zh": "我的翅膀像两张破皮。", "en": "My wings are two torn hides."},
        {"zh": "灰落在我身上，我不拍掉。", "en": "Ash settles. I let it."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒挂着，皮垂下来。", "en": "I hang, skin hanging down."},
        {"zh": "下界没有夜，我一直醒着。", "en": "No night here. I stay awake."},
        {"zh": "我在舔自己的骨头。", "en": "I lick my own bones."},
        {"zh": "火在我旁边烧，很舒服。", "en": "Fire nearby. Pleasant."},
        {"zh": "我的眼睛是两个小点。", "en": "My eyes are two small points."},
        {"zh": "我在听岩浆冒泡。", "en": "I listen to lava bubble."},
        {"zh": "这身皮已经干透了。", "en": "This hide has dried right out."},
        {"zh": "我的火球是绿的，别接。", "en": "My fireball is green. Don't catch it."},
        {"zh": "灰积在我的爪子上。", "en": "Ash on my claws."},
        {"zh": "我一动不动，像块破烂。", "en": "Still, I pass for debris."},
        {"zh": "喉咙里有点火，咽不下去。", "en": "Fire in my throat I cannot swallow."},
        {"zh": "下界的热让我更干。", "en": "The heat dries me further."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的核心，是祭坛要的四种之一。", "en": "My core is one of the altar's four."},
        {"zh": "我的牙比你手指还黄。", "en": "My teeth are yellower than your fingers."},
        {"zh": "下界很少见到你这种人。", "en": "Your kind is rare here."},
        {"zh": "别站着不动，我会过来。", "en": "Do not stand still. I will come."},
        {"zh": "我的喉咙里能吐火。", "en": "I can spit fire."},
        {"zh": "你手里的剑，砍不断死的东西。", "en": "Steel cuts nothing already dead."},
        {"zh": "这身皮不疼，也不怕。", "en": "This hide feels nothing."},
        {"zh": "你退到岩浆边了，退不动了。", "en": "You've backed to the lava's edge."},
        {"zh": "我很久没吃过活的了。", "en": "I have not fed on the living in a while."},
        {"zh": "叫我一声，我就过去。", "en": "Call me and I will come."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了一块干皮。", "en": "A piece of dry hide tears off."},
        {"zh": "骨头撞得咯吱响，我又飞起来。", "en": "My bones creak; I take wing again."},
        {"zh": "我肋骨断了一根，灰落进伤口。", "en": "One rib snaps and ash falls into the wound."},
        {"zh": "腐肉挂在我骨头上，我不疼。", "en": "Rotten flesh hangs on my bones; I feel nothing."},
        {"zh": "你的血味我记住了。", "en": "I have the smell of your blood."},
        {"zh": "我不叫，只发出干声。", "en": "I rasp instead of crying out."},
        {"zh": "我退到火边。", "en": "I retreat to the fire."},
        {"zh": "灰落了一身。", "en": "Ash covers me."},
        {"zh": "翼膜破洞，飞起来带着哨音。", "en": "A hole in my wing whistles as I fly."},
        {"zh": "半边翅膀焦了，我歪着飞。", "en": "Half a wing is scorched; I fly crooked."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉？这个正合适。", "en": "Rotten flesh? Just right."},
        {"zh": "你手里那块肉已经发黑了。", "en": "That meat has gone black."},
        {"zh": "我不吃新鲜的，太硬。", "en": "Not fresh. It fights back."},
        {"zh": "扔过来，我会在半空接住。", "en": "Toss it. I catch it midair."},
        {"zh": "放下，别让岩浆碰到。", "en": "Set it down. Keep it from lava."},
        {"zh": "你举的东西还在动。", "en": "What you hold still moves."},
        {"zh": "这块味道太重了，很好。", "en": "Strong smell. Good."},
        {"zh": "你的手别抖，我会咬到。", "en": "Keep still or I bite the hand."},
        {"zh": "亡灵核心，喂不饱这张嘴。", "en": "An undead core won't fill this mouth."},
        {"zh": "放地上，我落下来吃。", "en": "On the ground. I will drop for it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，摸到的是骨头。", "en": "You hit me and feel bone."},
        {"zh": "我被撞得翻了个身，又飞起。", "en": "I flip over and right myself."},
        {"zh": "我的皮挂在你袖子上了。", "en": "My hide catches your sleeve."},
        {"zh": "别抓我的翅膀，会断。", "en": "Not the wing. It breaks."},
        {"zh": "我没有体温，你感觉到了。", "en": "No warmth in me. You noticed."},
        {"zh": "我一侧身，就滑过去了。", "en": "I tilt and slide past."},
        {"zh": "碰撞让我掉了些干皮。", "en": "The bump sheds dry skin."},
        {"zh": "你退开，我落在岩架上。", "en": "You step back; I land on the ledge."},
        {"zh": "这一下不疼，我早死了。", "en": "No pain. I died long ago."},
        {"zh": "灰被撞得飞起来了。", "en": "The ash flew up from the impact."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "死掉的东西不谈这个。", "en": "The dead do not discuss that."},
        {"zh": "我是从腐肉上长出来的。", "en": "I grew on carrion."},
        {"zh": "这片下界，我只认得火。", "en": "In this Nether I know only fire."},
        {"zh": "你问得太干净了。", "en": "Your question is too clean."},
        {"zh": "我们不会多，只会烂。", "en": "We do not multiply. We rot."},
        {"zh": "别问了，牙都露出来了。", "en": "Stop. My teeth show."},
        {"zh": "我的同类在更热的洞里。", "en": "My kind are in hotter caves."},
        {"zh": "这块皮已经不属于我了。", "en": "This hide is not really mine."},
        {"zh": "你该担心自己的肉。", "en": "Worry about your own flesh."},
        {"zh": "我飞走了，话题结束。", "en": "I fly off. Topic over."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块腐肉，我叼走。", "en": "I carry off the carrion."},
        {"zh": "你掉的骨头，我用爪抓住。", "en": "I catch your fallen bone."},
        {"zh": "我用牙把它挑起来。", "en": "I hook it up with my teeth."},
        {"zh": "腐肉棒棒糖，我叼起来又掉。", "en": "The flesh lollipop slips from my jaws again."},
        {"zh": "这块东西还热着。", "en": "It is still warm."},
        {"zh": "我把它藏到岩石下。", "en": "I stash it under a rock."},
        {"zh": "地上的齿，是我的。", "en": "The tooth on the ground is mine."},
        {"zh": "我叼着它飞不快。", "en": "Carrying it, I fly slowly."},
        {"zh": "你捡吧，那块太干。", "en": "You take it. Too dry."},
        {"zh": "这块归我，别伸手。", "en": "Mine. Hands off."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "活人的热气，我在下界闻到了。", "en": "I smell living warmth here in the Nether."},
        {"zh": "我从岩架上起飞。", "en": "I launch from the ledge."},
        {"zh": "喉咙里开始热了。", "en": "Heat builds in my throat."},
        {"zh": "我朝你的方向飞。", "en": "I fly your way."},
        {"zh": "这一口火球，给你。", "en": "This fireball is for you."},
        {"zh": "我锁定你的影子。", "en": "I mark your shadow."},
        {"zh": "下界没有地方躲。", "en": "Nowhere to hide here."},
        {"zh": "你的血在跳，我听得见。", "en": "I hear your blood moving."},
        {"zh": "你在岩浆边上，正好。", "en": "At the lava's edge. Perfect."},
        {"zh": "现在，我张嘴。", "en": "Now I open my jaws."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你飞，越飞越低。", "en": "I circle lower and lower."},
        {"zh": "喉咙里的火已经满。", "en": "Fire fills my throat."},
        {"zh": "你每退一步，我就近一格。", "en": "Each step back, a block closer."},
        {"zh": "灰把光遮住了。", "en": "Ash dims the light."},
        {"zh": "我在等一个正好的角度。", "en": "I wait for the right angle."},
        {"zh": "你别看我怎么飞。", "en": "Do not follow my flight."},
        {"zh": "下界砖在我下面。", "en": "Nether brick below me."},
        {"zh": "你听见那种干哑的声吗？", "en": "Hear that dry rasp?"},
        {"zh": "再一圈，我就吐。", "en": "One more circle, then I spit."},
        {"zh": "喉咙里的火要出来了。", "en": "The fire in my throat is rising."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我吐出一个小火球。", "en": "I spit a small fireball."},
        {"zh": "火球擦过你的肩。", "en": "The fireball grazes your shoulder."},
        {"zh": "我撞在你胸口，很硬。", "en": "I hit your chest. Solid."},
        {"zh": "牙咬在你的护腕上。", "en": "My teeth find your bracer."},
        {"zh": "我吐出的火球舔到你的袖子。", "en": "My fireball licks your sleeve."},
        {"zh": "你被烧得退了半步。", "en": "The heat forces you back."},
        {"zh": "我的骨头撞得响。", "en": "My bones clack on impact."},
        {"zh": "你躲开了火球，没躲开爪子。", "en": "You dodged the fire, not the claws."},
        {"zh": "我又飞高了一些。", "en": "I climb a little."},
        {"zh": "下一次会更近。", "en": "The next will be closer."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "岩缝里传来干哑的一声。", "en": "A dry rasp from the rock seam."},
        {"zh": "下界的热风里多了个影子。", "en": "A shadow in the hot wind."},
        {"zh": "我从岩浆边上飞起来。", "en": "I lift from the lava's edge."},
        {"zh": "骨头在暗处反光。", "en": "Bone shines in the dark."},
        {"zh": "你听见翅膀摩擦的声。", "en": "Wings scraping."},
        {"zh": "灰被什么东西搅动了。", "en": "Something stirs the ash."},
        {"zh": "我落在一根断柱上。", "en": "I land on a broken pillar."},
        {"zh": "这一带多了一个死东西。", "en": "One more dead thing here."},
        {"zh": "我的喉咙里亮了。", "en": "My throat glows."},
        {"zh": "现在，我飞起来。", "en": "Now I take wing."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对死东西没什么用。", "en": "Fire does little to the dead."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在岩架上，散了一地。", "en": "I hit the ledge and scatter."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水？下界哪有水。", "en": "Water? Not here."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我吹到柱子上。", "en": "The blast throws me into a pillar."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过破皮，卡在骨头上。", "en": "An arrow through the hide, into bone."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让我的骨头僵住。", "en": "Arts stiffen my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有腐肉，我越来越轻。", "en": "No carrion and I lighten."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打进下界，我缩成一团。", "en": "Lightning reaches here. I curl up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空空的，我往下掉。", "en": "Nothing below. I fall."}
      ]
    }
  }
}
