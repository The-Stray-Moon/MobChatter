{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我压着气流往前滑", "en": "I ride the air current forward."},
        {"zh": "翼展几乎铺满这段林隙", "en": "My wingspan nearly fills the gap in the trees."},
        {"zh": "我绕祭坛飞了一圈", "en": "I circle the altar once."},
        {"zh": "翅声低沉，震得树叶抖", "en": "My wingbeat rattles the leaves."},
        {"zh": "我在幽魂橡木之间穿行", "en": "I pass between the ghost-oaks."},
        {"zh": "我落到断枝上歇了歇", "en": "I rest on a broken bough."},
        {"zh": "我这边飞一段，那边飞一段", "en": "I fly one stretch, then another."},
        {"zh": "我的翼膜透着暗光", "en": "My wing membrane shows a dim glow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在断枝上", "en": "I hang from the broken bough."},
        {"zh": "我在听祭坛的声音", "en": "I listen to the altar."},
        {"zh": "四个核都在那儿", "en": "All four cores are there."},
        {"zh": "林子安静得可疑", "en": "The wood is suspiciously quiet."},
        {"zh": "我的小兵在四周", "en": "My minions are all around."},
        {"zh": "我不急，等你自己进来", "en": "No hurry; I'll wait for you to come in."},
        {"zh": "这棵橡木已经枯了很久", "en": "This oak has been dead a long while."},
        {"zh": "我慢慢扇着翅", "en": "I fan my wings slowly."},
        {"zh": "空气里有铁和血", "en": "There's iron and blood in the air."},
        {"zh": "这个林子从今天起有主", "en": "This wood has a master now."},
        {"zh": "远处有人踩断了枝", "en": "Someone broke a branch far off."},
        {"zh": "我悬着等人上门", "en": "I hang, waiting for visitors."},
        {"zh": "血条在我身上亮着", "en": "The bar glows on me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你带着四种核来了", "en": "You've brought four cores."},
        {"zh": "祭坛认得你手里的东西", "en": "The altar knows what you carry."},
        {"zh": "你站得非常笔直", "en": "You stand very straight."},
        {"zh": "我的小兵已经看见你了", "en": "My minions have seen you."},
        {"zh": "你是来收我的", "en": "You've come to finish me."},
        {"zh": "这林子不欢迎生人", "en": "This wood doesn't welcome strangers."},
        {"zh": "你的眼睛在找祭坛", "en": "Your eyes are hunting the altar."},
        {"zh": "我在这林子里等久了", "en": "I've waited long in this wood."},
        {"zh": "我的翅膀能罩住你整个人", "en": "My wings can cover all of you."},
        {"zh": "你看我的翅膀，就该知道退路", "en": "Look at my wings; you'll know there's no way out."},
        {"zh": "四个核的光映在我身上", "en": "The four cores' light is on me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "血条降了一截", "en": "The bar dropped a notch."},
        {"zh": "你砍到了我的翼", "en": "You cut my wing."},
        {"zh": "我退了半个空", "en": "I gave half the air."},
        {"zh": "小兵被打散了", "en": "My minions scattered."},
        {"zh": "这一下值得记", "en": "That blow is worth noting."},
        {"zh": "我还会回来的", "en": "I'll come back from this."},
        {"zh": "你的武器不错", "en": "Your weapon is decent."},
        {"zh": "我的翼膜裂了", "en": "My membrane is split."},
        {"zh": "祭坛的力量还撑着我。", "en": "The altar's power still holds me."},
        {"zh": "接着继续下来", "en": "Continue."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西我不需要", "en": "I don't need that."},
        {"zh": "你以为我会被引开", "en": "You think I'd be drawn off."},
        {"zh": "核在你手里，很好", "en": "The cores are in your hands. Good."},
        {"zh": "放上祭坛试试", "en": "Try setting them on the altar."},
        {"zh": "祭坛不吃这些东西", "en": "The altar eats none of that."},
        {"zh": "收起来，我们开始", "en": "Put it away; let's begin."},
        {"zh": "那点甜味很可笑", "en": "That sweetness is laughable."},
        {"zh": "你举得越高越好", "en": "Lift it as high as you like."},
        {"zh": "我一样都不缺", "en": "I lack none of it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我翼骨上", "en": "You hit my wing bone."},
        {"zh": "我一个翅膀都没收", "en": "I didn't fold a single wing."},
        {"zh": "气流把你推开了", "en": "The draft shoved you back."},
        {"zh": "我的翼膜硬得像皮革", "en": "My membrane is tough as leather."},
        {"zh": "你退开时翅膀扫到你了", "en": "My wing caught you as you pulled back."},
        {"zh": "这片林隙太窄", "en": "This gap is too narrow."},
        {"zh": "我们撞得树叶都落了", "en": "Leaves fell from our collision."},
        {"zh": "这不叫撞，叫相遇", "en": "Not a bump; an encounter."},
        {"zh": "让开，我要起飞", "en": "Move; I'm taking off."},
        {"zh": "别贴着我翅膀走", "en": "Don't walk against my wings."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是这里唯一的主", "en": "I'm the only master here."},
        {"zh": "这种问题不该问", "en": "You shouldn't ask that."},
        {"zh": "我的血条还在，你也敢问", "en": "My bar still stands, and you ask that?"},
        {"zh": "我只在意祭坛", "en": "The altar is all I care for."},
        {"zh": "从我的林子里出去", "en": "Get out of my wood."},
        {"zh": "这副身体没有那部分", "en": "This body lacks that part."},
        {"zh": "别在我面前说", "en": "Don't say it before me."},
        {"zh": "林中不谈这些", "en": "Not in this wood."},
        {"zh": "你在耗我的耐心", "en": "You're spending my patience."},
        {"zh": "退到橡木外侧", "en": "Back beyond the oaks."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你以为拎得动我", "en": "You think you can carry me?"},
        {"zh": "我的翅膀会折", "en": "My wings will fold."},
        {"zh": "这样我怎么召唤小兵", "en": "How would I summon minions like this?"},
        {"zh": "从我翼下松开", "en": "Release me from under my wings."},
        {"zh": "你手上有核的味道", "en": "Your hands smell of cores."},
        {"zh": "我比你高得多", "en": "I'm far taller than you."},
        {"zh": "指头会被折断", "en": "Your fingers would snap."},
        {"zh": "这实在太可笑", "en": "This is absurd."},
        {"zh": "我一样能咬你", "en": "I can still bite you."},
        {"zh": "你早晚要后悔", "en": "You'll regret this."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了我的林子", "en": "You've entered my wood."},
        {"zh": "祭坛已经亮了", "en": "The altar is lit."},
        {"zh": "四个核都在位", "en": "All four cores are in place."},
        {"zh": "小兵们，起来", "en": "Minions, rise."},
        {"zh": "你打断了我的", "en": "You've interrupted me."},
        {"zh": "这一战会很长", "en": "This will be a long fight."},
        {"zh": "四个核都归我", "en": "All four cores are mine."},
        {"zh": "血条由我掌管", "en": "The bar answers to me."},
        {"zh": "你退不出去的", "en": "You can't get out."},
        {"zh": "橡木会替我说话", "en": "The oaks will speak for me."},
        {"zh": "我要你手里的核", "en": "I want your cores."},
        {"zh": "你就钉在那儿", "en": "Stay pinned right there."},
        {"zh": "你听见我的小兵了吗", "en": "Hear my minions?"},
        {"zh": "就趁这个空当", "en": "Right in this gap."},
        {"zh": "这林子不认你", "en": "This wood doesn't know you."},
        {"zh": "到我这里来吧", "en": "Come."},
        {"zh": "别指望能逃走", "en": "Don't hope to escape."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕你飞，一次比一次低", "en": "I circle, lower each pass."},
        {"zh": "我的小兵在你背后", "en": "My minions are at your back."},
        {"zh": "祭坛在我脚下", "en": "The altar is beneath me."},
        {"zh": "你数不清我有几个小兵", "en": "You can't count my minions."},
        {"zh": "树枝会挡住你的箭", "en": "Branches will stop your arrows."},
        {"zh": "每绕一圈我就更近", "en": "Each pass brings me closer."},
        {"zh": "我的翼声会压住你的听力", "en": "My wingbeat muffles your hearing."},
        {"zh": "你的核在发热吧", "en": "Are your cores heating up?"},
        {"zh": "这林子只留一个主", "en": "This wood keeps one master."},
        {"zh": "你再退也是我的地", "en": "Retreat; it's all my land."},
        {"zh": "我闻到你的怕", "en": "I smell your fear."},
        {"zh": "如今轮到你了", "en": "Your turn now."},
        {"zh": "脖子别往上抬", "en": "Don't lift that neck."},
        {"zh": "我的影子罩住你了", "en": "My shadow has covered you."},
        {"zh": "时候已经到了", "en": "The time has come."},
        {"zh": "小兵，围上去", "en": "Minions, surround."},
        {"zh": "血条还满着呢", "en": "The bar is still full."},
        {"zh": "你还有一口气", "en": "One breath left."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "翼骨抽下来了", "en": "Wing bone, down."},
        {"zh": "这一记有分量", "en": "That one had weight."},
        {"zh": "小兵会接着上", "en": "The minions follow."},
        {"zh": "你已经退回去", "en": "You backed off."},
        {"zh": "我的翼也是刀", "en": "My wing is a blade too."},
        {"zh": "血流在这片林子里", "en": "Blood in this wood."},
        {"zh": "再挨一记翼骨", "en": "Another wing-bone strike."},
        {"zh": "你挡不住三个方向", "en": "You can't cover three sides."},
        {"zh": "这一战我赢定了", "en": "I have this fight won."},
        {"zh": "跪着也没用处", "en": "Kneeling won't help."},
        {"zh": "飞起来你就看不见我", "en": "Once I'm up, you lose me."},
        {"zh": "你倒下时林子会安静", "en": "The wood will be quiet when you fall."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "祭坛四个座都亮了", "en": "All four seats of the altar lit up."},
        {"zh": "我从小兵中间升起来", "en": "I rise from among my minions."},
        {"zh": "这片幽魂橡木起了风", "en": "Wind rises in the ghost-oaks."},
        {"zh": "血条已经出现", "en": "The bar has appeared."},
        {"zh": "我把翅膀展开", "en": "I spread my wings."},
        {"zh": "橡木林在等这一战", "en": "The oak wood waited for this fight."},
        {"zh": "有人凑齐了核", "en": "Someone gathered the cores."},
        {"zh": "我的影子落在祭坛上", "en": "My shadow falls on the altar."},
        {"zh": "这次不会有人活着出去", "en": "No one leaves alive this time."},
        {"zh": "我从祭坛升起来", "en": "I rise from the altar."},
        {"zh": "林子开始暗了", "en": "The wood darkens."},
        {"zh": "小兵全都醒了", "en": "The minions are awake."},
        {"zh": "我抬起头，看见你", "en": "I raise my head and see you."},
        {"zh": "很久没有这样的客人", "en": "No guest like this in a long while."},
        {"zh": "祭坛的石头在响", "en": "The altar stones ring."},
        {"zh": "树都往后退了", "en": "The trees have drawn back."},
        {"zh": "你把核带来，我就来了", "en": "You bring the cores, and I come."},
        {"zh": "这一战，我应了", "en": "I accept this fight."},
        {"zh": "戏现在就开场", "en": "The show opens now."}
      ]
    },
