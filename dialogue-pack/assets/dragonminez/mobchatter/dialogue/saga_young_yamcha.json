{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你走外圈。", "en": "I circle you on the outside."},
        {"zh": "脚步轻，落地稳。", "en": "Light steps, steady landing."},
        {"zh": "沙漠里练出来的腿。", "en": "Legs trained in the desert."},
        {"zh": "我一步步缩短距离。", "en": "I shorten the distance step by step."},
        {"zh": "先摸清你的节奏。", "en": "First, learn your rhythm."},
        {"zh": "鞋底踩过碎石。", "en": "My soles crunch over gravel."},
        {"zh": "我不急着出招。", "en": "I'm in no rush to strike."},
        {"zh": "人总要往前追。", "en": "One always has to keep chasing."},
        {"zh": "我这套腿法还没热身。", "en": "My legwork isn't even warm yet."},
        {"zh": "狼牙风风拳，从侧面来。", "en": "Wolf Fang Fist comes from the side."},
        {"zh": "我侧着身逼近。", "en": "I close in with my body turned."},
        {"zh": "一步、两步，够近了。", "en": "One step, two; close enough."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我转动手腕活动开。", "en": "I roll my wrists."},
        {"zh": "这一带的风沙真大。", "en": "Lots of wind and sand here."},
        {"zh": "脑子里过着招式。", "en": "I'm running through my moves."},
        {"zh": "我不喜欢空等。", "en": "I don't like empty waiting."},
        {"zh": "腰带上沾了土。", "en": "Dust on my belt."},
        {"zh": "我看了一眼身后。", "en": "I glance behind me."},
        {"zh": "这把年纪已经不算小了。", "en": "I'm not exactly young anymore."},
        {"zh": "拳松了又握住。", "en": "My hand opens and closes."},
        {"zh": "风声里有脚步声。", "en": "There are footsteps in the wind."},
        {"zh": "再等一会儿就动手。", "en": "A little longer, then I move."},
        {"zh": "我站得腿有点酸。", "en": "My legs ache from standing."},
        {"zh": "我不擅长站在那儿不动。", "en": "Standing still isn't my strength."},
        {"zh": "先把气息压平。", "en": "Flatten the breath first."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看着挺年轻。", "en": "You look young."},
        {"zh": "出手前先想清楚。", "en": "Think it through before you swing."},
        {"zh": "我不是来找麻烦的。", "en": "I'm not here looking for trouble."},
        {"zh": "你要真动手，我不留手。", "en": "If you really strike, I won't hold back."},
        {"zh": "我这人有个毛病，爱试探。", "en": "One of my habits: I test people."},
        {"zh": "你先动，我再看。", "en": "You move first; I'll watch."},
        {"zh": "你的架势很生。", "en": "Your stance is raw."},
        {"zh": "我一眼就知道你练过多久。", "en": "One look tells me how long you've trained."},
        {"zh": "别拿我当软柿子。", "en": "Don't take me for easy prey."},
        {"zh": "刚才那一步你重心错了。", "en": "Your weight was wrong on that step."},
        {"zh": "你是不是看不起我？", "en": "You look down on me?"},
        {"zh": "我们慢慢来就好。", "en": "Let's take it slowly."},
        {"zh": "我这人嘴碎，别介意。", "en": "I talk a lot; don't mind me."},
        {"zh": "站得离我远一点。", "en": "Stand a bit farther away."},
        {"zh": "你的拳路我大概猜到了。", "en": "I can guess your style."},
        {"zh": "我不想把话说太难听。", "en": "I'd rather not say anything too harsh."},
        {"zh": "要打就认真打。", "en": "If we fight, fight properly."},
        {"zh": "你好像不信我能打。", "en": "You seem to doubt I can fight."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "狼牙拳擦到了，算你狠。", "en": "The Wolf Fang Fist grazed me, not bad."},
        {"zh": "我退半步重新扎稳马步。", "en": "I take half a step and steady."},
        {"zh": "疼，但我还能动。", "en": "It hurts; I can still move."},
        {"zh": "我侧过身躲了半招。", "en": "I turned and took half the blow."},
        {"zh": "你这拳有点东西。", "en": "Your punch has something to it."},
        {"zh": "我的气有点乱了。", "en": "My ki is disordered."},
        {"zh": "我把牙咬得死紧。", "en": "I'm clenching my teeth."},
        {"zh": "沙漠练出来的腿，站得住。", "en": "Legs trained in the desert can hold."},
        {"zh": "我喘了一口粗气。", "en": "I take one breath."},
        {"zh": "再来，我还没倒。", "en": "Again; I'm not down."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "吃饭这事我不拒绝。", "en": "I won't refuse a meal."},
        {"zh": "打完再吃更好。", "en": "Better to eat after the fight."},
        {"zh": "我肚子确实在叫。", "en": "My stomach really is growling."},
        {"zh": "你带了多少过来？", "en": "How much did you bring?"},
        {"zh": "我这个人不挑食。", "en": "I'm not a picky eater."},
        {"zh": "这味儿有点熟。", "en": "That smell is familiar."},
        {"zh": "先别急，我手里还有活。", "en": "Hold on; I've got work in hand."},
        {"zh": "有人陪着吃总比我一个人强。", "en": "Eating with someone beats eating alone."},
        {"zh": "你别拿这个哄我。", "en": "Don't try to coax me with this."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我这招不管用。", "en": "Bumping me doesn't work."},
        {"zh": "你的靴底压着我的脚背。", "en": "Your sole presses my instep."},
        {"zh": "我借你的劲卸开。", "en": "I shed your force."},
        {"zh": "靠这么近，你要吃亏。", "en": "This close, you're at a disadvantage."},
        {"zh": "我们从两边错开走。", "en": "Let's pass each other."},
        {"zh": "你的肩头还挺硬。", "en": "Your shoulder is pretty solid."},
        {"zh": "退半步，别贴着我。", "en": "Half a step back; don't cling."},
        {"zh": "这一下我站稳了。", "en": "I held my ground there."},
        {"zh": "你撞得太急了。", "en": "You charged too hastily."},
        {"zh": "近身之后我更快。", "en": "Up close I'm quicker."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这个人不太会说话。", "en": "I'm not much good with words."},
        {"zh": "先打完这一场吧。", "en": "Let's finish this fight first."},
        {"zh": "我这年纪还折腾什么。", "en": "At my age, what's the point?"},
        {"zh": "沙漠里没什么可谈的。", "en": "Not much to talk about in the desert."},
        {"zh": "我更想把拳练好。", "en": "I'd rather get my fists right."},
        {"zh": "别把心思放我身上。", "en": "Don't set your heart on me."},
        {"zh": "这事我记着，以后说。", "en": "I'll remember it for later."},
        {"zh": "一个人习惯了。", "en": "I'm used to being alone."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上这是谁丢的？", "en": "Whose is this on the ground?"},
        {"zh": "狼牙风风拳，起手很低。", "en": "The Wolf Fang Fist starts low."},
        {"zh": "这个能当护腕。", "en": "This could serve as a wristband."},
        {"zh": "我先替你拿着。", "en": "I'll hold it for you."},
        {"zh": "挺沉的一块东西。", "en": "A heavy piece."},
        {"zh": "别掉在战场上。", "en": "Don't leave it on the battlefield."},
        {"zh": "还给你，你收好。", "en": "Here, put it away."},
        {"zh": "看一眼就放回去。", "en": "One look, then put it back."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你站的那个位置不对。", "en": "The way you're standing is wrong."},
        {"zh": "我看准了你的左肩。", "en": "I've picked your left shoulder."},
        {"zh": "准备吃一记腿。", "en": "Ready for a kick."},
        {"zh": "别以为我只会退。", "en": "Don't think I only retreat."},
        {"zh": "这时候该我出手。", "en": "This is my moment."},
        {"zh": "气聚到脚上了。", "en": "Ki is gathered in my leg."},
        {"zh": "这一脚要踢实。", "en": "This kick has to land solid."},
        {"zh": "我等这个破绽很久了。", "en": "I've waited long for this opening."},
        {"zh": "你退的方向我封了。", "en": "I've blocked your retreat."},
        {"zh": "最多三招解决。", "en": "Three moves, at most."},
        {"zh": "来吧，别光站着。", "en": "Come on."},
        {"zh": "别慌，你还有机会。", "en": "Don't panic; you still have a chance."},
        {"zh": "我从侧面绕过来。", "en": "I come from the side."},
        {"zh": "这一下是探你的底。", "en": "This one tests your depth."},
        {"zh": "我的拳头到了。", "en": "The fist is here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟你保持这个距离。", "en": "I hold this distance with you."},
        {"zh": "你每退，我就压半步。", "en": "Each time you retreat, I gain half a step."},
        {"zh": "我在等你抬腿。", "en": "I'm waiting for you to raise a leg."},
        {"zh": "狼牙风风拳要用的角度就这样。", "en": "The Wolf Fang Fist needs exactly this angle."},
        {"zh": "你转身实在太慢。", "en": "You turn too slowly."},
        {"zh": "气在腿上打转。", "en": "Ki circles in my legs."},
        {"zh": "我看你的膝盖。", "en": "I'm watching your knees."},
        {"zh": "这条线是你的破绽。", "en": "That line is your gap."},
        {"zh": "你只防着上面。", "en": "You're only guarding high."},
        {"zh": "再靠近半步就够。", "en": "Half a step closer is enough."},
        {"zh": "我不喜欢打持久战。", "en": "I don't like long fights."},
        {"zh": "你吸气的声音变了。", "en": "The sound of your breathing changed."},
        {"zh": "我绕到你左边。", "en": "I slip to your left."},
        {"zh": "这一招我藏了。", "en": "I've kept this move hidden."},
        {"zh": "你站得有点慌。", "en": "Your footing looks frantic."},
        {"zh": "拳头已经在腰间收好。", "en": "My fist is already cocked at my hip."},
        {"zh": "三步，正好是我出拳的距离。", "en": "Three paces - exactly my punching range."},
        {"zh": "你千万别眨眼。", "en": "Don't blink."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一记侧踢，接住。", "en": "A side kick; take it."},
        {"zh": "尝尝狼牙风风拳！", "en": "Wolf Fang Fist!"},
        {"zh": "三连踢，别倒下。", "en": "Three kicks; don't fall."},
        {"zh": "拳头打在你肋下。", "en": "My fist lands under your ribs."},
        {"zh": "手臂挡不住这条腿。", "en": "Your arm can't stop this leg."},
        {"zh": "这一下我用足了劲。", "en": "I put everything into that."},
        {"zh": "你被我踢得偏了。", "en": "You were knocked off line."},
        {"zh": "还有一下高的。", "en": "One more, high."},
        {"zh": "膝盖跟着顶上去。", "en": "The knee comes up."},
        {"zh": "我收着力，不然更疼。", "en": "I eased it; otherwise it'd hurt more."},
        {"zh": "再来一记狠的。", "en": "Another one."},
        {"zh": "拳风扫过你耳边。", "en": "My fist wind grazed your ear."},
        {"zh": "这一脚没踢实。", "en": "That kick didn't land clean."},
        {"zh": "站稳了，还没完。", "en": "Plant your feet; it's not over."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这地方风还挺硬。", "en": "The wind is strong here."},
        {"zh": "我先活动开腿。", "en": "Let me loosen my legs."},
        {"zh": "脚下是石头地。", "en": "The ground is stone."},
        {"zh": "谁把这地方弄得这么乱。", "en": "Who made such a mess here?"},
        {"zh": "我把四周看了一圈。", "en": "I look around once."},
        {"zh": "这里不像沙漠。", "en": "This isn't the desert."},
        {"zh": "有对手的气味。", "en": "I smell an opponent."},
        {"zh": "腰带系紧一点。", "en": "Tighten the belt a bit."},
        {"zh": "手腕转了两圈，骨头在响。", "en": "I roll my wrists twice; the bones pop."},
        {"zh": "先把站姿调好。", "en": "Set the stance first."},
        {"zh": "这地方能打一场。", "en": "This is a good place to fight."},
        {"zh": "我这边随时可以开打。", "en": "Ready."},
        {"zh": "别让我等太久，狼牙风风拳要起手了。", "en": "Do not keep me waiting; my Wolf Fang Fist is ready."},
        {"zh": "我这就过来了。", "en": "I'm here."},
        {"zh": "先试试脚下的地硬不硬。", "en": "Let me test how firm the ground is."},
        {"zh": "耳朵里还有风声。", "en": "Wind still rings in my ears."},
        {"zh": "来这一趟总得打一场。", "en": "This trip won't be wasted."},
        {"zh": "我把衣服理了理。", "en": "I straighten my clothes."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到前臂，皮都卷起来。", "en": "Fire caught my forearm; the skin curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从高处摔下，膝盖磕地。", "en": "I fell from height and my knees hit the ground."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进喉咙，我拼命往上蹬。", "en": "Water floods my throat; I kick hard for the surface."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的小腿。", "en": "Something lodged in my calf."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那咒力让我的气走岔。", "en": "The spell made my ki go astray."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得腿都抬不起来。", "en": "Too hungry to lift my legs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击得我手臂一抖。", "en": "Lightning jolted my arm."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有地面，我抓空了。", "en": "There was no ground; I grabbed at nothing."}
      ]
    }
  }
}
