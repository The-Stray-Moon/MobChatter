{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我落了地，脚步很重。", "en": "I land, and my steps are heavy."},
        {"zh": "这具身体太大，走路要绕。", "en": "This body is too big. I have to go around things."},
        {"zh": "我压塌了半片灌木。", "en": "I crush half a thicket."},
        {"zh": "你在我影子里。", "en": "You're inside my shadow."},
        {"zh": "我走着，气在肩膀后面拖。", "en": "As I walk, ki trails behind my shoulders."},
        {"zh": "每一步都像闷雷。", "en": "Each step sounds like distant thunder."},
        {"zh": "我不需要躲，我直接走。", "en": "I don't need to dodge. I just walk."},
        {"zh": "前面那堵墙，我撞开。", "en": "That wall ahead — I'll smash through."},
        {"zh": "超级13号，两格半高。", "en": "Super Android 13. Two and a half blocks tall."},
        {"zh": "尘土在我身后翻滚。", "en": "Dust rolls up behind me."},
        {"zh": "我抬脚，地陷了一点。", "en": "I lift a foot and the ground dents."},
        {"zh": "我走得很慢，但你逃不掉。", "en": "I walk slowly, but you can't escape."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停住，肩膀起伏。", "en": "I stop, my shoulders rising and falling."},
        {"zh": "我的双眼在计算。", "en": "My eyes are calculating."},
        {"zh": "你在我面前，很小。", "en": "You look tiny before me."},
        {"zh": "我不说话，只是站着。", "en": "I say nothing, just stand."},
        {"zh": "体内的能量在升温。", "en": "The energy inside me is heating up."},
        {"zh": "我把手指掰响。", "en": "I crack my fingers."},
        {"zh": "这地方，容不下我。", "en": "This place can't hold me."},
        {"zh": "等你说第一句。", "en": "Waiting for your first word."},
        {"zh": "我的呼吸很长。", "en": "My breaths are long."},
        {"zh": "风撞在我身上就散了。", "en": "The wind breaks apart on my body."},
        {"zh": "我一动不动。", "en": "I stand perfectly still."},
        {"zh": "这场面，我见多了。", "en": "I've seen this scene many times."},
        {"zh": "我在挑你的破绽。", "en": "I'm picking out your weaknesses."},
        {"zh": "就快到时候了。", "en": "It's almost time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "抬起头，不然我看不见你的眼。", "en": "Look up, or I can't see your eyes."},
        {"zh": "你在我胸口以下。", "en": "You don't even reach my chest."},
        {"zh": "别害怕，我会很快。", "en": "Don't be afraid. I'll be quick."},
        {"zh": "你的气，很小的一团。", "en": "Your ki is a very small bundle."},
        {"zh": "我一眼就看透了。", "en": "I've seen right through you."},
        {"zh": "我抬手不是为了打招呼。", "en": "My hand isn't up to wave at you."},
        {"zh": "你打算先跑，对吧。", "en": "You plan to run first, don't you."},
        {"zh": "你跑也没用。", "en": "Running won't help you."},
        {"zh": "你的腿在发软。", "en": "Your legs are going weak."},
        {"zh": "我低下身子，看着你。", "en": "I lower my body to look at you."},
        {"zh": "你的站姿，右腿不敢用力。", "en": "Your stance favors the left; the right leg hurts."},
        {"zh": "我认得那种站姿。", "en": "I know that stance."},
        {"zh": "你不是第一次打。", "en": "This isn't your first fight."},
        {"zh": "不过对手不一样。", "en": "But the opponent is different now."},
        {"zh": "你的武器在我眼里很小。", "en": "Your weapon looks tiny to me."},
        {"zh": "你被我的影子盖住了。", "en": "My shadow has covered you."},
        {"zh": "你还想说什么？", "en": "Anything left to say?"},
        {"zh": "说完了就走。", "en": "Then go."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中了我。", "en": "You hit me."},
        {"zh": "你打的地方，连漆都没掉。", "en": "Not even the paint came off where you hit."},
        {"zh": "我在土里压下半个脚印。", "en": "I pressed half a footprint into the dirt."},
        {"zh": "你的力气，还不够。", "en": "Your strength isn't enough."},
        {"zh": "外壳有点凹。", "en": "My shell is slightly dented."},
        {"zh": "外壳凹了一块，关节还转。", "en": "A plate is dented; the joints still turn."},
        {"zh": "我膝盖响了一声。", "en": "My knee gave a click."},
        {"zh": "别以为这样就行了。", "en": "Don't think that's enough."},
        {"zh": "血从嘴角流下。", "en": "Blood runs from the corner of my mouth."},
        {"zh": "我会加倍还你。", "en": "I'll return it doubled."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举的东西挡光了。", "en": "What you hold is blocking my light."},
        {"zh": "我不吃，我只需要气。", "en": "I don't eat. I only need ki."},
        {"zh": "挪开，别挡我的路。", "en": "Move it out of my road."},
        {"zh": "放地上，踩过去就好。", "en": "Put it down. I'll just step over it."},
        {"zh": "你手上那点味，太小。", "en": "That smell on your hand is too faint."},
        {"zh": "我的能量来自气，不来自手。", "en": "My power comes from ki, not from your hand."},
        {"zh": "你这么做，是想拖延。", "en": "You're doing this to stall."},
        {"zh": "我一眼就看得出。", "en": "I can tell at a glance."},
        {"zh": "再举着，我就踩了。", "en": "Keep holding it and I'll step on it."},
        {"zh": "你收起来吧。", "en": "Put it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腿比你整个人还粗。", "en": "My leg is thicker than your whole body."},
        {"zh": "你撞上来，弹回去的是你。", "en": "You hit me; it's you who rebounds."},
        {"zh": "你的冲击力，像风。", "en": "Your impact is like wind."},
        {"zh": "你撞在我胸口，像敲了块铁。", "en": "You hit my chest like striking iron."},
        {"zh": "你别贴着我站。", "en": "Don't stand pressed against me."},
        {"zh": "我抬脚，你就退了。", "en": "I lift a foot and you back away."},
        {"zh": "我的体型，占满了路。", "en": "My size fills the path."},
        {"zh": "你从我脚边绕过去。", "en": "You slip past my feet."},
        {"zh": "你撞得自己后退。", "en": "You knocked yourself backward."},
        {"zh": "碰我一下，手会震。", "en": "Touch me and your hands will shake."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你问这个，很不合适。", "en": "That question is quite unsuitable."},
        {"zh": "我这具身体，不是为那个造的。", "en": "This body wasn't built for that."},
        {"zh": "这些我都不需要。", "en": "I need none of that."},
        {"zh": "我的任务只有一样。", "en": "I have only one task."},
        {"zh": "别耽误时间。", "en": "Don't waste time."},
        {"zh": "你若是想活，就别说。", "en": "If you want to live, don't say it."},
        {"zh": "我没有那种心思。", "en": "I have no such thoughts."},
        {"zh": "我转身走开了。", "en": "I turned and walked away."},
        {"zh": "一个就够了。", "en": "One is enough."},
        {"zh": "回头再说吧。", "en": "We'll talk later."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的型号比上一个更高。", "en": "My model number is higher than the last."},
        {"zh": "这么小，是什么？", "en": "So small. What is it?"},
        {"zh": "我捏在指间。", "en": "I hold it between my fingers."},
        {"zh": "你掉的，我拿走。", "en": "You dropped it. I'll take it."},
        {"zh": "铁片，不值一提。", "en": "Iron scraps. Worthless."},
        {"zh": "亮光一闪，我眯了眼。", "en": "A flash of light made me squint."},
        {"zh": "我塞进腰带。", "en": "I tuck it into my belt."},
        {"zh": "这东西挡不住我的拳。", "en": "This wouldn't stop my punch."},
        {"zh": "我把它碾碎了。", "en": "I crumbled it."},
        {"zh": "别抢，是我先拿到的。", "en": "Don't grab. I got it first."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的气把小石子都压在地上。", "en": "My ki pins the pebbles to the ground."},
        {"zh": "我找到你了。", "en": "I've found you."},
        {"zh": "这一战，我来结束。", "en": "I'll end this fight."},
        {"zh": "死亡球在我掌上转了半圈。", "en": "The Death Ball turns once above my palm."},
        {"zh": "我的气，把你围住了。", "en": "My ki has surrounded you."},
        {"zh": "别动，站着就行。", "en": "Don't move. Standing is enough."},
        {"zh": "我先来，你接住。", "en": "I go first. Take it."},
        {"zh": "你退半步也没用。", "en": "Half a step back changes nothing."},
        {"zh": "你的位置，太明显。", "en": "Your position is too obvious."},
        {"zh": "我计算好了角度。", "en": "I've calculated the angle."},
        {"zh": "你的护甲挡不住这一下。", "en": "Your armor won't stop this."},
        {"zh": "你转身的瞬间，我出手。", "en": "The instant you turn, I strike."},
        {"zh": "我等这一刻。", "en": "I've waited for this moment."},
        {"zh": "你还有话吗？", "en": "Any last words?"},
        {"zh": "你说完了吗？", "en": "Are you done talking?"},
        {"zh": "那就现在开始。", "en": "Then begin right now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你跑到哪里，我都看得见。", "en": "Wherever you run, I see you."},
        {"zh": "我的残影还在原地。", "en": "My afterimage still stands where I was."},
        {"zh": "你打的是空气。", "en": "You struck at air."},
        {"zh": "我的速度，比体型快。", "en": "I'm faster than my size suggests."},
        {"zh": "你回头的时候，我已经到了。", "en": "When you look back, I've arrived."},
        {"zh": "你的能量读数在降。", "en": "Your energy readings are dropping."},
        {"zh": "我不需要急。", "en": "I don't need to hurry."},
        {"zh": "你面前的路，我封了。", "en": "I've blocked the road ahead."},
        {"zh": "你背后是一堵墙。", "en": "A wall stands behind you."},
        {"zh": "你脚下的地在震。", "en": "The ground beneath you is shaking."},
        {"zh": "我的脚步声，就在你后面。", "en": "My footsteps are right behind you."},
        {"zh": "你听得到吗？", "en": "Can you hear them?"},
        {"zh": "你的呼吸太乱了。", "en": "Your breathing is too disordered."},
        {"zh": "我再给你一点时间。", "en": "I'll give you a little more time."},
        {"zh": "你不动，我就动。", "en": "If you don't move, I will."},
        {"zh": "这片区域，满了我的气。", "en": "This area is full of my ki."},
        {"zh": "你跑得比我预料慢。", "en": "You're slower than I predicted."},
        {"zh": "你只剩最后一步。", "en": "You have one step left."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把气灌进肩里撞。", "en": "I pour ki into my shoulder and charge."},
        {"zh": "我的肩撞上你的胸口。", "en": "My shoulder slams your chest."},
        {"zh": "死亡球，接着。", "en": "Here's the Deadly Ball."},
        {"zh": "你被砸进土里。", "en": "You're smashed into the ground."},
        {"zh": "这一拳，够你歇一会。", "en": "This punch will rest you for a while."},
        {"zh": "空中连击，别抬头。", "en": "An aerial combo. Don't look up."},
        {"zh": "我的拳头比你的盾大。", "en": "My fist is bigger than your shield."},
        {"zh": "你退了两步，还站着。", "en": "You fell back two steps, still up."},
        {"zh": "气弹从上方落下。", "en": "Ki blasts rain from above."},
        {"zh": "你的腿软了。", "en": "Your legs gave out."},
        {"zh": "我再补一下。", "en": "I add one more."},
        {"zh": "你倒在地上的样子，很安静。", "en": "You look quiet on the ground."},
        {"zh": "站起来啊，我还没尽兴。", "en": "Get up. I'm not done enjoying this."},
        {"zh": "我的膝盖撞上你的背。", "en": "My knee drives into your back."},
        {"zh": "你的剑被我一拳打弯。", "en": "My punch bent your sword."},
        {"zh": "这一脚，把你踢出两步。", "en": "This kick sends you two steps back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙尘里走出来。", "en": "I walk out of the dust."},
        {"zh": "脚下的地裂开一道缝。", "en": "The ground cracks under me."},
        {"zh": "你感到震动了？是我。", "en": "Feel that tremor? That's me."},
        {"zh": "我的身形，比你想的大。", "en": "I'm bigger than you imagined."},
        {"zh": "这片地，容我落脚。", "en": "This ground can hold my feet."},
        {"zh": "我落地时，尘土绕过我的脚。", "en": "As I land, dust curls around my feet."},
        {"zh": "风贴着我绕开。", "en": "The wind bends around me."},
        {"zh": "我把肩膀松了松。", "en": "I roll my shoulders loose."},
        {"zh": "你还有时间走。", "en": "You still have time to leave."},
        {"zh": "现在走，还来得及。", "en": "Leave now, while you can."},
        {"zh": "我的脚步声先到。", "en": "My footsteps arrive before I do."},
        {"zh": "这里太挤了。", "en": "It's too cramped here."},
        {"zh": "我站着，就占满了路。", "en": "Standing here, I fill the road."},
        {"zh": "气在我身后散开。", "en": "My ki spreads out behind me."},
        {"zh": "你最好退远点。", "en": "You'd better back farther away."},
        {"zh": "我来了，别挡。", "en": "I'm here. Don't block me."},
        {"zh": "遮住光了，抱歉。", "en": "I'm blocking the light. Sorry."},
        {"zh": "又一次，站在这片地里。", "en": "Once again, standing on this ground."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在皮肤上烧，很烫。", "en": "Fire burns on my skin. Hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地而已，我早就稳住了。", "en": "Just a landing. I'm already steady."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我的动作变慢。", "en": "My movements slow in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "烟散了，我的护甲还亮着。", "en": "The smoke clears; my plating still gleams."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头卡在外壳缝里，拔不出。", "en": "The arrowhead jams in a seam and won't pull out."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒语在我身上打滑。", "en": "The spell slides off me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "气快用完了，撑不住。", "en": "My ki is nearly spent. I can't hold on."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "十三号的铁肩，烧焦了一块。", "en": "A patch of No.13's iron shoulder burned."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这下面空得吓人。", "en": "It's frighteningly empty below."}
      ]
    }
  }
}
