{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小跑着跟上", "en": "I jog to keep up."},
        {"zh": "同伴在前面", "en": "My comrade is ahead."},
        {"zh": "我的步子轻一点", "en": "My steps are a bit lighter."},
        {"zh": "岩石缝里也能走", "en": "I can walk through rock crevices."},
        {"zh": "我边走边回头", "en": "I glance back as I walk."},
        {"zh": "绿色影子拉得很长", "en": "My green shadow stretches long."},
        {"zh": "我顺着坡跑下去", "en": "I run down the slope."},
        {"zh": "脚下沙沙响", "en": "Sand crunches underfoot."},
        {"zh": "我追上队伍", "en": "I catch up with the group."},
        {"zh": "我把头低着走", "en": "I walk with my head down."},
        {"zh": "风把我的耳朵吹凉", "en": "The wind cools my ears."},
        {"zh": "我踩着影子走", "en": "I walk along my own shadow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "队伍里不能少人", "en": "No one can be missing from the group."},
        {"zh": "我在数同伴", "en": "I am counting my comrades."},
        {"zh": "我们一起来的", "en": "We came together."},
        {"zh": "这块石头挡路", "en": "This rock is in the way."},
        {"zh": "我在等信号", "en": "I am waiting for a signal."},
        {"zh": "我的手有点痒", "en": "My hands are itching."},
        {"zh": "谁先动我就跟着", "en": "Whoever moves first, I follow."},
        {"zh": "我把土踩平了", "en": "I have flattened the dirt."},
        {"zh": "头顶的太阳很毒", "en": "The sun overhead is harsh."},
        {"zh": "我抓了抓脖子", "en": "I scratch my neck."},
        {"zh": "不说话也没关系", "en": "Silence is fine."},
        {"zh": "我在想这里有多少人", "en": "I wonder how many people are here."},
        {"zh": "同伴没动，我也不动", "en": "My comrade has not moved, so neither will I."},
        {"zh": "我们站成一排", "en": "We stand in a row."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你只有一个", "en": "There is only one of you."},
        {"zh": "我们好几个", "en": "There are several of us."},
        {"zh": "你在看谁", "en": "Who are you looking at?"},
        {"zh": "你先挑一个吧", "en": "Pick one of us first."},
        {"zh": "别站在我们中间", "en": "Do not stand between us."},
        {"zh": "我在量你的个头", "en": "I am measuring your height."},
        {"zh": "你比我想的瘦", "en": "You are thinner than I thought."},
        {"zh": "你眼睛往哪看", "en": "Where are your eyes going?"},
        {"zh": "我们不着急", "en": "We are in no hurry."},
        {"zh": "你手上没长东西", "en": "You have nothing on your hands."},
        {"zh": "你笑得有点假", "en": "Your smile is a little false."},
        {"zh": "要是你只有一个人", "en": "If you really are alone..."},
        {"zh": "你们是不是一伙的", "en": "Are you with them?"},
        {"zh": "看够了就说", "en": "Say something when you have looked enough."},
        {"zh": "我在等同伴先上", "en": "I wait for my comrade to go first."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打得歪了", "en": "I was knocked crooked."},
        {"zh": "我看了看同伴", "en": "I glance at my comrade."},
        {"zh": "这一拳我记住了", "en": "I will remember that punch."},
        {"zh": "我扶着胳膊", "en": "I hold my arm."},
        {"zh": "我的绿皮有点破", "en": "My green hide is a little torn."},
        {"zh": "我喘了口气", "en": "I catch my breath."},
        {"zh": "我退到同伴后面", "en": "I fall back behind my comrade."},
        {"zh": "有点疼，但能撑", "en": "It stings, but I can take it."},
        {"zh": "你别以为我倒了", "en": "Do not think I am down."},
        {"zh": "我站稳了", "en": "I have my footing again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这块土是湿的", "en": "This soil is damp."},
        {"zh": "我们分着吃", "en": "We will share it."},
        {"zh": "是给我们三个的吗", "en": "Is it for the three of us?"},
        {"zh": "我先看看同伴", "en": "Let me look at my comrade first."},
        {"zh": "闻起来像草根", "en": "It smells like roots."},
        {"zh": "你手里就那么一点", "en": "That is all you have?"},
        {"zh": "我在犹豫", "en": "I am hesitating."},
        {"zh": "放着，我一会儿来", "en": "Leave it, I will come by later."},
        {"zh": "同伴点头我就去", "en": "If my comrade nods, I go."},
        {"zh": "别只给我一个", "en": "Do not give it to just me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你挤到我们中间了", "en": "You squeezed between us."},
        {"zh": "我旁边还有人", "en": "There are others beside me."},
        {"zh": "别往我身上靠", "en": "Do not lean on me."},
        {"zh": "你撞了我同伴", "en": "You bumped my comrade."},
        {"zh": "我们挤成一团", "en": "We are all bunched together."},
        {"zh": "你的肩顶到我", "en": "Your shoulder knocked into me."},
        {"zh": "我脚下滑了一下", "en": "My foot slipped."},
        {"zh": "你退两步再说", "en": "Take two steps back first."},
        {"zh": "三个撞一个，你吃亏", "en": "Three against one, you lose."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们三个里就我没兴趣", "en": "Of the three of us, I am the one not interested."},
        {"zh": "站远点", "en": "Stand farther away."},
        {"zh": "这种时候还打不打", "en": "Are we still fighting now?"},
        {"zh": "我看看同伴怎么说", "en": "Let me see what my comrade says."},
        {"zh": "我不太明白", "en": "I do not really understand."},
        {"zh": "别把土踢起来", "en": "Do not kick up the dirt."},
        {"zh": "这跟我没关系", "en": "This has nothing to do with me."},
        {"zh": "你笑什么", "en": "What are you laughing at?"},
        {"zh": "我等一夜也没关系", "en": "I can wait all night."},
        {"zh": "别再问", "en": "Stop asking."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个我们分", "en": "We will split this."},
        {"zh": "我先拿在手上", "en": "I will hold it first."},
        {"zh": "掉下来就要捡", "en": "Dropped means pick it up."},
        {"zh": "这块归第二个人", "en": "This one belongs to the second."},
        {"zh": "我看看值不值", "en": "Let me see if it is worth it."},
        {"zh": "同伴不会介意的", "en": "My comrade will not mind."},
        {"zh": "小东西也算收获", "en": "Small things still count."},
        {"zh": "我不贪心", "en": "I am not greedy."},
        {"zh": "你捡得比我快", "en": "You pick things up faster than me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我们三个一起上", "en": "All three of us at once."},
        {"zh": "我排在第二个", "en": "I go second."},
        {"zh": "先从你背后包抄", "en": "We will flank you from behind."},
        {"zh": "你别看错人", "en": "Do not mistake which one I am."},
        {"zh": "我抓住你的胳膊", "en": "I go for your arm."},
        {"zh": "你退不出这个圈", "en": "You cannot leave this circle."},
        {"zh": "同伴已经上了", "en": "My comrade has already started."},
        {"zh": "我跟着动手", "en": "I join in."},
        {"zh": "我站在你左边", "en": "I take your left."},
        {"zh": "你左右都有人", "en": "You have someone on both sides."},
        {"zh": "这一下我来", "en": "This one is mine."},
        {"zh": "我咬住你的注意", "en": "I will hold your attention."},
        {"zh": "我出手不快但准", "en": "I am not fast, but I am accurate."},
        {"zh": "别往后看", "en": "Do not look behind you."},
        {"zh": "三对一不算多", "en": "Three to one is not too many."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我把你围在中间", "en": "We have you surrounded."},
        {"zh": "我跟着同伴的步子", "en": "I follow my comrade's pace."},
        {"zh": "你别转身太快", "en": "Do not turn so quickly."},
        {"zh": "我在你右侧", "en": "I am on your right."},
        {"zh": "我们先耗你的力气", "en": "We will wear you down first."},
        {"zh": "你挡得住前面吗", "en": "Can you guard the front?"},
        {"zh": "我贴着同伴靠过去", "en": "I close in behind my comrade."},
        {"zh": "你的腿开始软了", "en": "Your legs are softening."},
        {"zh": "我们换人上", "en": "We take turns."},
        {"zh": "你再退就贴墙了", "en": "One more step and you hit the wall."},
        {"zh": "我数你的喘息", "en": "I count your gasps."},
        {"zh": "我不叫，也不急", "en": "I do not shout, I do not rush."},
        {"zh": "这一圈我们收紧了", "en": "We are tightening the circle."},
        {"zh": "你别想分开我们", "en": "You will not split us up."},
        {"zh": "第二个人还没累", "en": "The second one is not tired yet."},
        {"zh": "你在找我们之间的缝", "en": "You are looking for a gap between us."},
        {"zh": "没有缝", "en": "There is no gap."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从侧面撞你", "en": "I hit from the side."},
        {"zh": "这一拳打在腰上", "en": "A blow to your side."},
        {"zh": "我抓你的袖子", "en": "I grab your sleeve."},
        {"zh": "你被我们夹住了", "en": "We have you pinched."},
        {"zh": "我踢你的脚踝", "en": "I kick your ankle."},
        {"zh": "同伴压着，我补一下", "en": "My comrade holds, I strike."},
        {"zh": "你转身就露出背", "en": "Turn and your back shows."},
        {"zh": "我用头撞你", "en": "I headbutt you."},
        {"zh": "这一下是我打的", "en": "That one was from me."},
        {"zh": "你别想只对付一个", "en": "You cannot fight only one of us."},
        {"zh": "我抓着你往下按", "en": "I drag you down."},
        {"zh": "我出拳很闷", "en": "My punch lands heavy and dull."},
        {"zh": "你的护甲挡了一边", "en": "Your armor covered one side."},
        {"zh": "我往你空处打", "en": "I strike where you are open."},
        {"zh": "第二下更闷", "en": "The second lands even heavier."},
        {"zh": "你喘得厉害了", "en": "You are breathing hard."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我们两个一起到了", "en": "Two of us arrived together."},
        {"zh": "岩石群让开", "en": "The rocks gave way."},
        {"zh": "我跟着同伴落地", "en": "I land beside my comrade."},
        {"zh": "这里石头比人多", "en": "More rocks here than people."},
        {"zh": "队伍齐了", "en": "The group is complete."},
        {"zh": "我脚下一堆碎石", "en": "Gravel under my feet."},
        {"zh": "我抬手看自己的手心", "en": "I turn my palm over."},
        {"zh": "我们走得不快", "en": "We do not move fast."},
        {"zh": "这地方开阔", "en": "This place is open."},
        {"zh": "远处有人影", "en": "A figure in the distance."},
        {"zh": "我站到同伴身后半步", "en": "I stand half a step behind my comrade."},
        {"zh": "土腥味还没散", "en": "The smell of soil has not faded."},
        {"zh": "我听见风穿过岩缝", "en": "I hear wind through the rocks."},
        {"zh": "好了，我们来了", "en": "All right, we are here."},
        {"zh": "你先挑我们中哪一个", "en": "Pick one of us first."},
        {"zh": "我把肩膀活动开", "en": "I roll my shoulders."},
        {"zh": "我落地时踩碎一块石头", "en": "A stone crunched under my landing."},
        {"zh": "我们站好了，你挑吧", "en": "We are set, so pick."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火过来了，我跳开", "en": "Fire, I jump clear."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石头上滚下去", "en": "I rolled off the rocks."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我嘴里", "en": "Water pours into my mouth."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "碎石全打在我身上", "en": "The gravel all hit me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有人从高处放箭", "en": "Someone shot from above."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我头发昏", "en": "That light makes my head swim."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我们带来的干粮吃完了", "en": "Our rations ran out."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光顺着岩石爬过来", "en": "Lightning crawled along the rocks."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "同伴也不见了", "en": "Even my comrade is gone."}
      ]
    }
  }
}
