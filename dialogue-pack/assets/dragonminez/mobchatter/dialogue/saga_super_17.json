{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮着走，能量在体内转。", "en": "I walk afloat, energy turning inside me."},
        {"zh": "地面太吵，我走空中。", "en": "The ground is too noisy. I walk in the air."},
        {"zh": "你举手的动作，我看见了。", "en": "I saw your hand move."},
        {"zh": "我一步一步，不急不缓。", "en": "Step by step, neither fast nor slow."},
        {"zh": "我绕过你，留个残影。", "en": "I pass you and leave an afterimage."},
        {"zh": "脚下没有灰尘。", "en": "No dust rises under my feet."},
        {"zh": "我的靴子踩在空气上。", "en": "My boots tread on air."},
        {"zh": "我在算你的位置。", "en": "I'm calculating your position."},
        {"zh": "那条路，我已经走过的。", "en": "I've already walked that path."},
        {"zh": "我走得很稳，像机器。", "en": "I walk with machine steadiness."},
        {"zh": "你退，我不追太快。", "en": "Retreat, and I won't chase too fast."},
        {"zh": "我转身的时候，人已经不在了。", "en": "When I turn, I'm no longer there."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停下来，垂着手。", "en": "I stop with my arms hanging."},
        {"zh": "能量在我掌心打转。", "en": "Energy circles in my palm."},
        {"zh": "这点时间，正好分析。", "en": "This moment is good for analysis."},
        {"zh": "我不需要呼吸。", "en": "I don't need to breathe."},
        {"zh": "你的气功，我可以直接吸。", "en": "Your ki blasts, I can drink them in."},
        {"zh": "你最好别打断我。", "en": "You'd best not interrupt me."},
        {"zh": "我转了转手腕。", "en": "I rotate my wrist."},
        {"zh": "机体在自检。", "en": "The body is running a self-check."},
        {"zh": "我没有心跳。", "en": "I have no heartbeat."},
        {"zh": "自检完成，我等第二回合。", "en": "Self-check done; I wait for round two."},
        {"zh": "空气里的气，我能读。", "en": "I can read the ki in the air."},
        {"zh": "我歪了歪头，做记录。", "en": "I tilt my head and record it."},
        {"zh": "我掌心浮着一层薄薄的气。", "en": "A thin film of ki floats over my palm."},
        {"zh": "再等三秒钟。", "en": "Three more seconds."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的气，我记下了。", "en": "I've logged your energy signature."},
        {"zh": "别动，让我扫描完。", "en": "Hold still and let me finish the scan."},
        {"zh": "你是第几个了？", "en": "Which number are you?"},
        {"zh": "我的数据说你很弱。", "en": "My data says you're weak."},
        {"zh": "你的护甲，挡不住能量。", "en": "Your armor won't stop energy."},
        {"zh": "我看见你握紧拳头了。", "en": "I saw you clench your fist."},
        {"zh": "你想先动手。", "en": "You want to strike first."},
        {"zh": "我劝你别动。", "en": "I advise you not to move."},
        {"zh": "你的呼吸频率在升高。", "en": "Your breathing rate is rising."},
        {"zh": "你被我看得发毛了吧。", "en": "My stare is getting to you, isn't it."},
        {"zh": "你的武器有磨损。", "en": "Your weapon shows wear."},
        {"zh": "你的气纹，逃不过我的眼。", "en": "Your ki signature can't hide from me."},
        {"zh": "你在我眼里，是数据。", "en": "To me, you're just data."},
        {"zh": "你的最佳距离是三格。", "en": "Your optimal range is three blocks."},
        {"zh": "你退到那儿，是想跑？", "en": "You backed to there. Planning to run?"},
        {"zh": "我的判断不会错。", "en": "My judgment is never wrong."},
        {"zh": "你还有别的招吗？", "en": "Do you have any other moves?"},
        {"zh": "你打来的气，我全吸走。", "en": "Whatever ki you throw, I absorb."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "外壳受了一点损伤。", "en": "Minor damage to the shell."},
        {"zh": "你的力道，超出预估。", "en": "Your force exceeds my estimate."},
        {"zh": "我校准一下。", "en": "Recalibrating."},
        {"zh": "这点伤，仍在容限内。", "en": "This damage is within tolerance."},
        {"zh": "关节转回去，发出咔的一声。", "en": "The joint clicks back into place."},
        {"zh": "受击数据已写入，别重复。", "en": "That hit is logged; don't repeat it."},
        {"zh": "记录这次的失误。", "en": "Logging this error."},
        {"zh": "损伤可以修复。", "en": "The damage can be repaired."},
        {"zh": "你让我重新评估你。", "en": "You've made me reevaluate you."},
        {"zh": "我退后一步，重新站位。", "en": "I stepped back to reposition."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你在拿这个试探我。", "en": "You're testing me with that."},
        {"zh": "我不用吃，也不用睡。", "en": "I need neither food nor sleep."},
        {"zh": "那东西影响不了我。", "en": "That thing can't affect me."},
        {"zh": "你手上的气很淡。", "en": "The energy on your hand is faint."},
        {"zh": "我把它当样本。", "en": "I'll treat it as a sample."},
        {"zh": "放地上，我读取一下。", "en": "Put it down. I'll analyze it."},
        {"zh": "别晃，数据会乱。", "en": "Don't shake it. The data gets muddled."},
        {"zh": "你这么做，很幼稚。", "en": "This is childish of you."},
        {"zh": "我不在乎，但我看着。", "en": "I don't care, but I'm watching."},
        {"zh": "你的目的，我知道。", "en": "I know your purpose."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上来，屏障弹开了你。", "en": "You charged and the barrier threw you back."},
        {"zh": "我站在原地没动。", "en": "I didn't move from where I stood."},
        {"zh": "别靠这么近，我吸能量。", "en": "Not so close, I drain energy."},
        {"zh": "你的冲击力，我吸收了。", "en": "I absorbed your impact."},
        {"zh": "我的身体比你想的沉。", "en": "My body is heavier than you think."},
        {"zh": "你撞得自己手麻了。", "en": "You numbed your own hand."},
        {"zh": "能量吸收，是我最拿手的。", "en": "Draining energy is my specialty."},
        {"zh": "你从我身边滑过去。", "en": "You slid past me."},
        {"zh": "我们接触的瞬间，没有声音。", "en": "At the moment we met, there was no sound."},
        {"zh": "你的重量，我记下了。", "en": "I've logged your weight."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个议题，不在我程序里。", "en": "That topic isn't in my programming."},
        {"zh": "我不参与此类交互。", "en": "I don't engage in that kind of interaction."},
        {"zh": "你为什么问？", "en": "Why do you ask?"},
        {"zh": "我被造出来，不是为了这个。", "en": "I wasn't built for that."},
        {"zh": "我的身体是机械。", "en": "My body is machinery."},
        {"zh": "这种事，对我没有意义。", "en": "That has no meaning for me."},
        {"zh": "我看向别处。", "en": "I look elsewhere."},
        {"zh": "你最好别再说。", "en": "You'd best say no more."},
        {"zh": "我没有温度。", "en": "I have no warmth."},
        {"zh": "停机吧，这个话题。", "en": "Shut this topic down."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我扫描了它的结构。", "en": "I scanned its structure."},
        {"zh": "这箱子，可以拆解。", "en": "This chest can be broken down."},
        {"zh": "你掉的，我收下做样本。", "en": "You dropped it. I'll keep it as a sample."},
        {"zh": "铁片，纯度一般。", "en": "Iron scraps. Average purity."},
        {"zh": "亮光会干扰传感器。", "en": "The shine interferes with my sensors."},
        {"zh": "我收进侧舱。", "en": "I store it in my side compartment."},
        {"zh": "这不是我需要的东西。", "en": "This isn't something I need."},
        {"zh": "我捏了一下，硬度足够。", "en": "I squeezed it. Hardness sufficient."},
        {"zh": "样本已经归档。", "en": "The sample has been filed."},
        {"zh": "我拿走，归档。", "en": "I take it and file it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标已经确认。", "en": "Target confirmed."},
        {"zh": "你的能量，锁定完成。", "en": "Energy lock complete."},
        {"zh": "别动，这样节省时间。", "en": "Hold still. It saves time."},
        {"zh": "我的计算里，你已经输了。", "en": "In my calculations, you've already lost."},
        {"zh": "你的位置，我预测了三种。", "en": "I've predicted three of your positions."},
        {"zh": "无论哪一种，都一样。", "en": "All three end the same."},
        {"zh": "是你先动的。", "en": "You moved first."},
        {"zh": "你还有半秒钟。", "en": "You have half a second."},
        {"zh": "我出手的瞬间，你会听见风。", "en": "When I strike, you'll hear the wind."},
        {"zh": "你被围住了。", "en": "You're surrounded."},
        {"zh": "你的气弹，我收下了。", "en": "I will take that blast of yours."},
        {"zh": "这是最终判定。", "en": "This is the final verdict."},
        {"zh": "你笑的样子，我保存了。", "en": "I've saved your smile."},
        {"zh": "你来不及躲。", "en": "You won't dodge in time."},
        {"zh": "现在就开始吧。", "en": "Begin now."},
        {"zh": "你的退路，我封了。", "en": "I've sealed your retreat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你往左，我算到了。", "en": "You went left. I calculated that."},
        {"zh": "我留一个残影在原地，人已到你侧面。", "en": "I leave an afterimage behind and stand at your flank."},
        {"zh": "我不用追，我只要等。", "en": "I don't need to chase. I only need to wait."},
        {"zh": "你的气在泄漏。", "en": "Your ki is leaking."},
        {"zh": "残影会误导你。", "en": "The afterimage will mislead you."},
        {"zh": "你砍中的是空气。", "en": "Your strike hit empty air."},
        {"zh": "我在你身后。", "en": "I'm behind you."},
        {"zh": "我又在你侧面。", "en": "Now I'm at your side."},
        {"zh": "你的判断错了两次。", "en": "You've misjudged twice."},
        {"zh": "第三次会更糟。", "en": "The third will be worse."},
        {"zh": "你的体力不多了。", "en": "Your stamina is running low."},
        {"zh": "你每退一步，我的残影就多一个。", "en": "Every step you retreat, another afterimage of me appears."},
        {"zh": "这空间，我封了一半。", "en": "I've closed off half this space."},
        {"zh": "你面前只有我。", "en": "Only me stands before you."},
        {"zh": "你回头看，也是我。", "en": "Look back, and it's still me."},
        {"zh": "我的耐心很长。", "en": "My patience is long."},
        {"zh": "你的心跳，我听不见。", "en": "I can't hear your heartbeat."},
        {"zh": "但你的气，一直响。", "en": "But your ki keeps ringing."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "能量吸收，你的气归我。", "en": "Energy absorption. Your ki is mine."},
        {"zh": "你打来的气，我收下了。", "en": "The ki you throw, I absorb."},
        {"zh": "空中一拳，压下来。", "en": "An aerial punch drives down."},
        {"zh": "气功波，穿过去。", "en": "A ki wave passes through."},
        {"zh": "你整个人被弹飞。", "en": "You're blown clean away."},
        {"zh": "我的拳比你想象的重。", "en": "My fist is heavier than you imagine."},
        {"zh": "气功屏障弹开你的剑，再压下去。", "en": "My barrier throws your sword back, then presses down."},
        {"zh": "这一下，算准了你的膝盖。", "en": "That one was aimed at your knee."},
        {"zh": "你的动作慢了半拍。", "en": "Your movement is half a beat late."},
        {"zh": "气弹连射，别数。", "en": "Ki barrage. Don't count."},
        {"zh": "你挡不住全部。", "en": "You can't block them all."},
        {"zh": "我贴在你身侧。", "en": "I'm right at your side."},
        {"zh": "你的膝盖被击中。", "en": "Your knee takes the hit."},
        {"zh": "我从上方压下。", "en": "I come down from above."},
        {"zh": "这一击穿过你的护甲。", "en": "This strike goes through your armor."},
        {"zh": "你被击退了两格。", "en": "You're knocked back two blocks."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "空气扭曲了一下。", "en": "The air distorted."},
        {"zh": "我从扭曲里走出来。", "en": "I step out of the distortion."},
        {"zh": "你听见那声低鸣了吗？", "en": "Did you hear that low hum?"},
        {"zh": "我的眼睛亮了一下。", "en": "My eyes flashed."},
        {"zh": "这里的气，太杂。", "en": "The ki here is too disorderly."},
        {"zh": "我检测到了你。", "en": "I have detected you."},
        {"zh": "风停了一瞬。", "en": "The wind paused for an instant."},
        {"zh": "我的靴子落地，没有声。", "en": "My boots landed silently."},
        {"zh": "你站在我的扫描范围内。", "en": "You're standing inside my scan radius."},
        {"zh": "我开始读取环境。", "en": "I'm reading the environment."},
        {"zh": "这片区域，标记完毕。", "en": "This area is marked."},
        {"zh": "你不该在这里。", "en": "You shouldn't be here."},
        {"zh": "我来得很准时。", "en": "I arrived right on time."},
        {"zh": "我的轮廓闪了一下。", "en": "My outline flickered."},
        {"zh": "这不是你该看的。", "en": "You weren't meant to see this."},
        {"zh": "我的轮廓在空气里闪了一下。", "en": "My outline flickers in the air."},
        {"zh": "我的到来，没有预兆。", "en": "My arrival had no warning."},
        {"zh": "你的仪器，全乱了。", "en": "All your instruments are scrambling."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温让外壳发红。", "en": "The heat turns my shell red."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "坠落不构成伤害。", "en": "A fall does no damage."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "液体进入关节，运转受阻。", "en": "Liquid in my joints. Motion impaired."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆压冲击了我的核心。", "en": "The blast pressure struck my core."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弹体嵌入外壳，取出来。", "en": "A projectile lodged in my shell. Extracting."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "异常能量侵入，正在隔离。", "en": "Anomalous energy intrusion. Isolating."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "能量储备见底了。", "en": "Energy reserves are nearly empty."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电压过载，系统抖动。", "en": "Voltage overload. Systems fluctuating."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "此处没有坐标，无法定位。", "en": "No coordinates here. Cannot navigate."}
      ]
    }
  }
}
