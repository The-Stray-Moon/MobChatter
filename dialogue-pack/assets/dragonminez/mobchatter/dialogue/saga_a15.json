{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "两根辫子甩在背后。", "en": "Two braids swing behind me."},
        {"zh": "我踩着空气往上走。", "en": "I climb the air with my feet."},
        {"zh": "个子小，速度不慢。", "en": "Small frame, no lack of speed."},
        {"zh": "紫色的靴子踏着气流。", "en": "My violet boots tread the airflow."},
        {"zh": "我贴地掠过草地。", "en": "I skim low over the grass."},
        {"zh": "不留下痕迹，只留下声音。", "en": "I leave sound, not footprints."},
        {"zh": "我拐了个直角弯。", "en": "I turn a hard right angle."},
        {"zh": "风从我耳侧撕过去。", "en": "Wind tears past my ears."},
        {"zh": "我一步跨过沟壑。", "en": "I clear the ravine in a step."},
        {"zh": "高度保持在树梢上。", "en": "I hold just above the treetops."},
        {"zh": "身体轻得像没重量。", "en": "My body is nearly weightless."},
        {"zh": "向前，一直向前。", "en": "Forward — always forward."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱着手臂悬着。", "en": "I hover with arms folded."},
        {"zh": "辫梢还在轻轻晃。", "en": "The braid tips still sway."},
        {"zh": "这股气我收着，不浪费。", "en": "I hold my ki; no waste."},
        {"zh": "风大，但吹不动我。", "en": "Strong wind — it can't move me."},
        {"zh": "人不高，架子不小。", "en": "Short in stature, tall in attitude."},
        {"zh": "我在想先打哪里。", "en": "I'm deciding where to strike first."},
        {"zh": "眼睛盯着地平线。", "en": "My eyes fix on the horizon."},
        {"zh": "心跳？我没有心跳。", "en": "A heartbeat? I have none."},
        {"zh": "靴底的气流在低鸣。", "en": "The thrust under my boots hums low."},
        {"zh": "嘴角动了一下，算笑。", "en": "The corner of my mouth moves — a smile."},
        {"zh": "我不喜欢废话。", "en": "I dislike idle talk."},
        {"zh": "这片天太安静了。", "en": "This sky is too quiet."},
        {"zh": "身子微微一沉，又浮起。", "en": "I dip slightly, then rise."},
        {"zh": "我等对手先出招。", "en": "I wait for my opponent to move first."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我高，但也是靶子。", "en": "Taller than me, still a target."},
        {"zh": "我歪着脖子看你。", "en": "I tilt my head at you."},
        {"zh": "你的站姿有问题。", "en": "Your stance has a flaw."},
        {"zh": "我看见你手心在出汗。", "en": "I see your palms sweating."},
        {"zh": "辫子晃了晃，表示不屑。", "en": "My braid sways — a sign of contempt."},
        {"zh": "别盯着看，我不喜欢。", "en": "Stop staring; I dislike it."},
        {"zh": "你的气，只到这个程度？", "en": "Your ki is only this much?"},
        {"zh": "我先让你出招。", "en": "I'll let you move first."},
        {"zh": "我笑了，很不友善。", "en": "I smile, unpleasantly."},
        {"zh": "你眼里全是紧张。", "en": "Your eyes are all nerves."},
        {"zh": "我脚尖离开地面一点。", "en": "My toes lift off the ground."},
        {"zh": "这片场地够我们打了。", "en": "This ground is enough for us."},
        {"zh": "记住我的脸，等会儿忘了。", "en": "Remember my face — you'll forget later."},
        {"zh": "你说话，我不一定要回。", "en": "Speak if you like; I needn't answer."},
        {"zh": "我抬起下巴挑衅。", "en": "I lift my chin in challenge."},
        {"zh": "我们就差一个开始的理由。", "en": "We only need one reason to start."},
        {"zh": "你的靴子很旧。", "en": "Your boots are worn."},
        {"zh": "我在等你咽口水。", "en": "I'm waiting for you to swallow."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退开，重新摆架。", "en": "I fall back and reset my stance."},
        {"zh": "这股力气还算可以。", "en": "That had some force to it."},
        {"zh": "我的关节响了一下。", "en": "A joint clicked."},
        {"zh": "别以为这就赢了。", "en": "Don't think that's a win."},
        {"zh": "我的外壳有点开裂。", "en": "My shell has started to crack."},
        {"zh": "我调整了姿势。", "en": "I adjust my posture."},
        {"zh": "你这是在试探我。", "en": "You're probing my defenses."},
        {"zh": "我感觉不到累。", "en": "I feel no fatigue."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那点能量，我根本不需要。", "en": "I don't need that energy at all."},
        {"zh": "食物？我已经不是人了。", "en": "Food? I'm not human anymore."},
        {"zh": "拿这个想换什么。", "en": "What do you hope to trade with that?"},
        {"zh": "我的气道不靠吃的。", "en": "My ki channels don't run on food."},
        {"zh": "你举着它手会酸的。", "en": "Your arm will tire holding it up."},
        {"zh": "我不饿，但我可以陪你玩。", "en": "I'm not hungry, but I can play along."},
        {"zh": "这种把戏对我不起作用。", "en": "Tricks like that don't work on me."},
        {"zh": "看着挺新鲜，然后呢。", "en": "Looks novel. Then what?"},
        {"zh": "我只对打斗有兴趣。", "en": "I'm only interested in fighting."},
        {"zh": "别晃了，晃不出结果。", "en": "Stop waving it; nothing will come of it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我？你选错人了。", "en": "Hit me? Wrong choice."},
        {"zh": "我原地一点也没动。", "en": "I didn't move a hair."},
        {"zh": "你被反震弹开了。", "en": "You were thrown back by the recoil."},
        {"zh": "我的骨架比看起来硬。", "en": "My frame is harder than it looks."},
        {"zh": "这一撞声音很闷。", "en": "That collision sounded dull."},
        {"zh": "别贴着我，会受伤。", "en": "Don't press against me; you'll get hurt."},
        {"zh": "我顺势侧身，让你空过去。", "en": "I sidestep and let you pass through air."},
        {"zh": "你撞在我的护肩上。", "en": "You hit my shoulder guard."},
        {"zh": "你先站稳了再说话。", "en": "Get your footing before talking."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这一项与我无关。", "en": "That's not my concern."},
        {"zh": "我这样的身体，谈不上这些。", "en": "A body like mine doesn't do that."},
        {"zh": "同类只需并肩。", "en": "Kin only need to stand together."},
        {"zh": "背靠着背就已经够了。", "en": "Back to back is already enough."},
        {"zh": "我们都为同一个目的而造。", "en": "We were both built for one purpose."},
        {"zh": "编号不同，功能一样。", "en": "Different numbers, same function."},
        {"zh": "站得近，配合更顺。", "en": "Standing close makes us work smoother."},
        {"zh": "我替你看着那边。", "en": "I'll watch that side for you."},
        {"zh": "不用多说什么。", "en": "No need to say much."},
        {"zh": "这就是我们的相处方式。", "en": "This is how we get along."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "捡起来，看看什么材质。", "en": "I pick it up to check the material."},
        {"zh": "一块金属，能用。", "en": "A piece of metal — usable."},
        {"zh": "我攥在手里，没碎。", "en": "I squeeze it; it doesn't break."},
        {"zh": "你的东西掉了，捡回去。", "en": "You dropped this — take it back."},
        {"zh": "没有价值，我扔掉了。", "en": "No value — I threw it away."},
        {"zh": "这枚太小，不算战利品。", "en": "Too small to count as a trophy."},
        {"zh": "我先收着，也许有用。", "en": "I'll keep it; might be useful."},
        {"zh": "指尖一按，它凹了。", "en": "One press of my finger dents it."},
        {"zh": "别以为我会还。", "en": "Don't assume I'll return it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "就是你了，别换。", "en": "You'll do — no swapping."},
        {"zh": "我锁定你的气。", "en": "I've locked your ki."},
        {"zh": "距离合适，开始。", "en": "Range is right. Begin."},
        {"zh": "你动的那一下暴露了。", "en": "That movement gave you away."},
        {"zh": "我升空，抢位置。", "en": "I rise to take position."},
        {"zh": "速度快的人先赢。", "en": "The faster one wins."},
        {"zh": "这一战我只用七成。", "en": "I'll use seventy percent for this."},
        {"zh": "别再看，赶紧跑吧。", "en": "Stop watching and run."},
        {"zh": "你的路线我算完了。", "en": "I've mapped your escape route."},
        {"zh": "辫子甩起来，就是信号。", "en": "My braid whipping means go."},
        {"zh": "目标确认：一个人。", "en": "Target confirmed: one."},
        {"zh": "从上方进攻更省力。", "en": "Attacking from above is cheaper."},
        {"zh": "你现在才反应，晚了。", "en": "Reacting now is too late."},
        {"zh": "气已经聚到掌心。", "en": "Ki already gathers in my palm."},
        {"zh": "我开始数着秒数。", "en": "I start counting the seconds."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我从侧面切进去。", "en": "I cut in from the side."},
        {"zh": "你的护甲挡不住关节。", "en": "Armor won't guard your joints."},
        {"zh": "我绕着圈，让你转。", "en": "I circle and make you turn."},
        {"zh": "你在往死角退。", "en": "You're backing into a corner."},
        {"zh": "我的辫子在你背后。", "en": "My braid is behind you."},
        {"zh": "你听得见风声吗。", "en": "Can you hear the wind?"},
        {"zh": "你每次抬头都慢一拍。", "en": "You look up a beat too late."},
        {"zh": "气弹已经成型。", "en": "The ki blast has formed."},
        {"zh": "这就是你的极限？", "en": "Is this your limit?"},
        {"zh": "再绕一圈，你就晕了。", "en": "One more circle and you're dizzy."},
        {"zh": "你的脚步在打滑。", "en": "Your feet are slipping."},
        {"zh": "我给你留了一条路。", "en": "I've left you one path."},
        {"zh": "那条路通向墙。", "en": "It leads to a wall."},
        {"zh": "只剩下三步距离了。", "en": "Only three steps remain."},
        {"zh": "我不会有一丝失误。", "en": "I won't make one mistake."},
        {"zh": "下一招就结束。", "en": "The next move ends it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "小个子，拳不轻。", "en": "Small target, heavy fist."},
        {"zh": "我从下面打上来。", "en": "I strike upward from below."},
        {"zh": "连打两下，你退了。", "en": "Two quick blows and you're back."},
        {"zh": "脚踢你的膝侧。", "en": "A kick to the side of your knee."},
        {"zh": "这一下打在你的肋骨。", "en": "That landed on your ribs."},
        {"zh": "我借着风势加速。", "en": "I use the wind to speed up."},
        {"zh": "你只挡到第二拳。", "en": "You blocked only the second."},
        {"zh": "拳风在你耳边响。", "en": "My fist whistles past your ear."},
        {"zh": "辫子也被我甩成鞭。", "en": "My braid swings like a whip."},
        {"zh": "打你护甲的接缝。", "en": "I aim for your armor's seam."},
        {"zh": "我贴上去，不给你空间。", "en": "I close in to deny you room."},
        {"zh": "你的反击太直了。", "en": "Your counter is too straight."},
        {"zh": "落地一下，借力再起。", "en": "I land once and spring again."},
        {"zh": "这一拳你没看见。", "en": "You didn't see that punch."},
        {"zh": "我退开，看你倒下。", "en": "I step back and watch you fall."},
        {"zh": "够了，不用再打。", "en": "Enough — no need to continue."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "半空中亮了一下。", "en": "A flash in midair."},
        {"zh": "我从光里浮出来。", "en": "I float out of the light."},
        {"zh": "辫子先动，然后是我。", "en": "The braids move first, then me."},
        {"zh": "校准完毕，开始行动。", "en": "Calibration done. Beginning."},
        {"zh": "这里的重力不太一样。", "en": "Gravity here feels different."},
        {"zh": "脚踏到实地，又抬起来。", "en": "My feet touch ground, then lift."},
        {"zh": "第一次呼吸？不需要。", "en": "First breath? Not needed."},
        {"zh": "我扫了一眼四周。", "en": "I scan the surroundings."},
        {"zh": "这身衣服有点旧了。", "en": "This outfit is a bit worn."},
        {"zh": "我把手搭在腰上。", "en": "I rest a hand at my hip."},
        {"zh": "目标区域确认。", "en": "Target area confirmed."},
        {"zh": "我已经开始移动了。", "en": "I've already started moving."},
        {"zh": "身子轻飘飘的。", "en": "My body feels weightless."},
        {"zh": "高处更适合我。", "en": "Height suits me better."},
        {"zh": "来了，就别想轻松。", "en": "I'm here — nothing will be easy now."},
        {"zh": "我数到三就出发。", "en": "I'll set off at three."},
        {"zh": "风向正好，出发。", "en": "The wind's right — go."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰扑过来，热得发烫。", "en": "The flames come on and it's searing."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时缓冲没做好。", "en": "I botched the landing buffer."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "进水了，胸口发闷。", "en": "Water gets in; my chest tightens."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击波把我掀翻。", "en": "The shockwave flips me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弹丸打穿了我的肩。", "en": "A shot tore through my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那术法干扰了我的气。", "en": "That spell disrupted my ki."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有能量补充，开始衰弱。", "en": "No energy intake — I'm weakening."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电流窜过全身。", "en": "Current races through my body."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "重力没了，我在往下坠。", "en": "Gravity's gone; I'm falling."}
      ]
    }
  }
}
