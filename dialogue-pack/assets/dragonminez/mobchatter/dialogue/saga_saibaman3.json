{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走在最后面", "en": "I walk at the very back."},
        {"zh": "我步子慢半拍", "en": "I lag half a step behind."},
        {"zh": "我咬着草茎走", "en": "I chew a grass stalk as I walk."},
        {"zh": "我拖着脚走", "en": "I scuff my feet along."},
        {"zh": "我顺着岩壁走", "en": "I follow the rock face."},
        {"zh": "我绕开大石头", "en": "I go around the big boulder."},
        {"zh": "我走一段就停下", "en": "I walk a while, then stop."},
        {"zh": "我的影子很小", "en": "My shadow is small."},
        {"zh": "我踩在碎石上", "en": "I step on broken stone."},
        {"zh": "我慢慢跟上队伍", "en": "I slowly catch up."},
        {"zh": "我把头转向声音", "en": "I turn my head toward the sound."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我有点困", "en": "I am a little sleepy."},
        {"zh": "这里太安静了", "en": "It is too quiet here."},
        {"zh": "我在听石头里的声音", "en": "I listen to the rocks."},
        {"zh": "种子一样大，牙都长齐了。", "en": "Seed-sized, with every tooth grown in."},
        {"zh": "同伴都不说话", "en": "None of my comrades speak."},
        {"zh": "我从岩石缝里钻出来，先看天。", "en": "I push out of a rock fissure and look up first."},
        {"zh": "我有点饿了", "en": "I am a bit hungry."},
        {"zh": "这风吹得我发凉", "en": "The wind chills me."},
        {"zh": "我站着也能打", "en": "I can fight from where I stand."},
        {"zh": "我在想该不该动手", "en": "I wonder whether to start."},
        {"zh": "我踢了块石头", "en": "I kick a stone."},
        {"zh": "我不想先动", "en": "I do not want to move first."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看了我三次了", "en": "You have looked at me three times."},
        {"zh": "我不是最小的", "en": "I am not the smallest."},
        {"zh": "你手别乱动", "en": "Keep your hands still."},
        {"zh": "你要挑我打吗", "en": "Are you picking a fight with me?"},
        {"zh": "我站在最后面", "en": "I am standing at the back."},
        {"zh": "你找我做什么", "en": "What do you want with me?"},
        {"zh": "我的眼睛也在看你", "en": "My eyes are on you too."},
        {"zh": "我听见你咽口水", "en": "I heard you swallow."},
        {"zh": "你看我，我就看你", "en": "You look at me, I look at you."},
        {"zh": "我不喜欢被盯着", "en": "I dislike being stared at."},
        {"zh": "你先开口", "en": "You speak first."},
        {"zh": "你的鞋上有泥", "en": "There is mud on your boots."},
        {"zh": "我慢慢握起拳", "en": "I slowly close my fist."},
        {"zh": "你的影子比我还短", "en": "Your shadow is shorter than mine."},
        {"zh": "我数到三就动手，战士一千二。", "en": "I count to three, at a power of twelve hundred."},
        {"zh": "别以为我好说话", "en": "Do not think I am easygoing."},
        {"zh": "你还不走", "en": "You are still here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打得摇晃", "en": "I sway from the blow."},
        {"zh": "我退到石头边", "en": "I back against the rocks."},
        {"zh": "你打在我肩上", "en": "You hit my shoulder."},
        {"zh": "我咬着嘴唇", "en": "I bite my lip."},
        {"zh": "这一下让我有点懵", "en": "That left me dazed."},
        {"zh": "我抬眼看你", "en": "I look up at you."},
        {"zh": "我反应迟了半拍", "en": "My reaction came half a beat late."},
        {"zh": "我扶着膝盖", "en": "I brace my knee."},
        {"zh": "我还没倒", "en": "I am not down yet."},
        {"zh": "疼，我记住了", "en": "It hurts, I will remember."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是甜的吗", "en": "Is that sweet?"},
        {"zh": "我肚子在响", "en": "My stomach is growling."},
        {"zh": "你抖一抖手里的东西", "en": "Shake that thing in your hand."},
        {"zh": "我闻到根茎的味道", "en": "I smell roots."},
        {"zh": "我不太敢过去", "en": "I am not sure I dare come over."},
        {"zh": "同伴先吃我就吃", "en": "If my comrade eats first, I will."},
        {"zh": "那块看起来不错", "en": "That piece looks decent."},
        {"zh": "你别逗我", "en": "Do not tease me."},
        {"zh": "我慢慢靠近一点", "en": "I creep a little closer."},
        {"zh": "再举高一点", "en": "Raise it a bit higher."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩的是我的脚趾", "en": "That was my toe you stepped on."},
        {"zh": "我最小，但也不软", "en": "I am the smallest, not the softest."},
        {"zh": "别把我挤到石头边", "en": "Do not push me against the rock."},
        {"zh": "我让开一点", "en": "I make some room."},
        {"zh": "你撞到我的腰", "en": "You hit my waist."},
        {"zh": "我一歪就抓住你", "en": "If I stumble, I grab you."},
        {"zh": "你身上有汗味", "en": "You smell of sweat."},
        {"zh": "我站回去了", "en": "I step back into place."},
        {"zh": "我们挤得没处站", "en": "There is no space for the three of us."},
        {"zh": "你再推我就打", "en": "Push again and I strike."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我最不适合这种场面", "en": "I am the worst fit for this."},
        {"zh": "我在后面等就行", "en": "I will just wait in the back."},
        {"zh": "这跟我有什么关系", "en": "What does this have to do with me?"},
        {"zh": "你倒是说句话", "en": "Say something, at least."},
        {"zh": "我看看石头", "en": "I look at the rocks instead."},
        {"zh": "别把这件事传出去", "en": "Do not spread this around."},
        {"zh": "我们都不太会", "en": "None of us is any good at this."},
        {"zh": "时间过得真慢", "en": "Time passes so slowly."},
        {"zh": "我这就走开", "en": "I will step away now."},
        {"zh": "别拦我", "en": "Do not stop me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢了一步", "en": "I was a step too slow."},
        {"zh": "这块我要了", "en": "I want this one."},
        {"zh": "碎石里也有东西", "en": "There is loot in the gravel."},
        {"zh": "我把它踢开再捡", "en": "I kick it loose, then pick it up."},
        {"zh": "没人看见我拿吧", "en": "Nobody saw me take it, right?"},
        {"zh": "我手小，抓得住", "en": "My hands are small, but I can grip."},
        {"zh": "这玩意儿硌手", "en": "This thing is rough in my hand."},
        {"zh": "我收进口袋", "en": "I pocket it."},
        {"zh": "别跟我抢", "en": "Do not take it from me."},
        {"zh": "算是白捡的", "en": "Found for free, then."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我先看你怎么打", "en": "I will watch how you fight first."},
        {"zh": "你露破绽了", "en": "You left an opening."},
        {"zh": "我从后面来", "en": "I come from behind."},
        {"zh": "我出手慢，但会到", "en": "I strike slowly, but it lands."},
        {"zh": "我已经记住了你的步子", "en": "I have learned your stride."},
        {"zh": "你退路被石头挡着", "en": "Your retreat is blocked by rock."},
        {"zh": "我握紧了拳头", "en": "My fist is clenched."},
        {"zh": "该我上了", "en": "My turn now."},
        {"zh": "我不喊，直接打", "en": "I do not shout, I just strike."},
        {"zh": "你还没发现我", "en": "You have not noticed me yet."},
        {"zh": "同伴会替我压阵", "en": "My comrade will cover me."},
        {"zh": "你后背空着", "en": "Your back is open."},
        {"zh": "这下轮到第三个人", "en": "Now it is the third one's turn."},
        {"zh": "我贴着岩壁过去", "en": "I move along the rock face."},
        {"zh": "你别只盯着他们", "en": "Do not watch only them."},
        {"zh": "我开始数了", "en": "I have started counting."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在你侧后", "en": "I stay at your flank and back."},
        {"zh": "你转过来也没用", "en": "Turning around will not help."},
        {"zh": "我拖住你的脚", "en": "I will slow your feet."},
        {"zh": "我抓起一把碎石", "en": "I scoop up a fistful of gravel."},
        {"zh": "我等你抬手", "en": "I wait for you to raise your arm."},
        {"zh": "我慢慢绕到下面", "en": "I work my way around below."},
        {"zh": "我不急这一时", "en": "I am in no hurry."},
        {"zh": "你还剩几口气", "en": "How many breaths do you have left?"},
        {"zh": "我数你的脚步", "en": "I count your steps."},
        {"zh": "你别往岩缝里钻", "en": "Do not squeeze into that crevice."},
        {"zh": "我挡在唯一的出口", "en": "I block the only way out."},
        {"zh": "你回头会看见我", "en": "Turn around and you will see me."},
        {"zh": "你的手在找武器", "en": "Your hand is searching for a weapon."},
        {"zh": "我听见你的喘气", "en": "I hear you panting."},
        {"zh": "我握好的石头在手里", "en": "The stone in my hand is ready."},
        {"zh": "就差你一个转身", "en": "All I need is one turn from you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我甩出这把碎石", "en": "I fling this fistful of gravel."},
        {"zh": "我撞你的腰", "en": "I ram your waist."},
        {"zh": "你眼睛迷住了吧", "en": "Got dust in your eyes?"},
        {"zh": "我从下面抓你", "en": "I grab you from below."},
        {"zh": "我一拳打在你膝上", "en": "A punch to your knee."},
        {"zh": "你退到岩壁上了", "en": "You are against the rock wall."},
        {"zh": "我扯住你的衣角", "en": "I snag the hem of your coat."},
        {"zh": "这一下没什么花招", "en": "No tricks in that one."},
        {"zh": "我压住你的手腕", "en": "I pin your wrist."},
        {"zh": "你手一松就完了", "en": "Your grip slips, and it is over."},
        {"zh": "我踢起一片沙", "en": "I kick up a spray of sand."},
        {"zh": "同伴同时到了", "en": "My comrade arrives at the same moment."},
        {"zh": "你被两边夹住", "en": "You are caught on both sides."},
        {"zh": "我低身再来", "en": "I drop low and hit again."},
        {"zh": "你挡得住上面挡不住下面", "en": "You guard high, not low."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我是最后一个到的", "en": "I am the last to arrive."},
        {"zh": "我从土里慢慢爬出", "en": "I crawl slowly out of the soil."},
        {"zh": "这里真够荒的", "en": "This place is truly barren."},
        {"zh": "我拍了拍身上的土", "en": "I brush the dirt off."},
        {"zh": "同伴已经到了", "en": "My comrades are already here."},
        {"zh": "我走到队伍后面", "en": "I fall in at the back."},
        {"zh": "石头挡住了阳光", "en": "The rocks block the sun."},
        {"zh": "我抬头看了一眼", "en": "I take one look up."},
        {"zh": "这片荒地归我们", "en": "This waste is ours."},
        {"zh": "我拉了拉手指", "en": "I pull at my fingers."},
        {"zh": "我们三个站成一线", "en": "The three of us line up."},
        {"zh": "我听见远处有人", "en": "I hear someone far off."},
        {"zh": "地上有脚印", "en": "There are footprints on the ground."},
        {"zh": "我不喜欢这么亮", "en": "I do not like this brightness."},
        {"zh": "我站定了", "en": "I am in place."},
        {"zh": "你看我们三个", "en": "Look at the three of us."},
        {"zh": "土腥气跟着我上来", "en": "The smell of earth comes up with me."},
        {"zh": "先动手的是谁", "en": "Who will move first?"}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一过来我就退了", "en": "Fire came and I backed off."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滑下来", "en": "I slid off the slope."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水呛进我的喉咙", "en": "Water choked my throat."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "石头全朝我飞", "en": "The stones all flew at me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭擦过我的耳朵", "en": "An arrow grazed my ear."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我眼前一片白光", "en": "A white flash blinded me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我们什么也没挖到", "en": "We found nothing to eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在我脚边", "en": "Lightning struck at my feet."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了", "en": "The ground vanished."}
      ]
    }
  }
}
