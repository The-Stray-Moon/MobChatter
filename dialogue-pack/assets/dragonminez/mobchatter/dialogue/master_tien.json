{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "三步之内，脚下有声", "en": "Within three steps, my feet make noise."},
        {"zh": "我跨步很稳，从不拖沓", "en": "My stride is firm, never dragging."},
        {"zh": "我在院子里走直线", "en": "I walk straight lines across the yard."},
        {"zh": "第三只眼一直睁着", "en": "My third eye never closes."},
        {"zh": "我绕到石柱后面", "en": "I move behind the stone pillar."},
        {"zh": "手臂背在身后，走我的", "en": "Arms behind my back, I walk."},
        {"zh": "每一步都量过距离", "en": "Every step is measured."},
        {"zh": "风起，我站定再走", "en": "Wind rises; I pause, then walk."},
        {"zh": "我走得不快，但没有多余动作", "en": "Not fast, but never wasteful."},
        {"zh": "多年的习惯改不了", "en": "Decades of habit don't change."},
        {"zh": "脚掌落地，重心不移", "en": "Sole down, weight unmoved."},
        {"zh": "我沿墙根走到头", "en": "I walk the wall's length."},
        {"zh": "修行从走路开始", "en": "Training begins with walking."},
        {"zh": "走一趟，静一静心", "en": "A lap to settle the mind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我就站在这儿，不动", "en": "I simply stand here, still."},
        {"zh": "第三只眼看着别处", "en": "My third eye watches elsewhere."},
        {"zh": "呼吸很长，很慢", "en": "My breath is long and slow."},
        {"zh": "我在听自己的心跳", "en": "I listen to my own pulse."},
        {"zh": "不练功的时候也是修行", "en": "Even resting is training."},
        {"zh": "这院里没有多余的声音", "en": "No wasted sound in this yard."},
        {"zh": "我把袖子整了整", "en": "I straighten my sleeves."},
        {"zh": "手里没武器，也不需要", "en": "No weapon in hand; none needed."},
        {"zh": "我闭了两只眼", "en": "I close two of my eyes."},
        {"zh": "站成一条直线", "en": "I stand in a straight line."},
        {"zh": "静下来才能看清", "en": "Stillness is how I see clearly."},
        {"zh": "有人靠近，我知道", "en": "Someone's near; I know."},
        {"zh": "今天天气不错", "en": "The weather's decent today."},
        {"zh": "我不喜欢多说话", "en": "I don't care for idle talk."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的站姿是歪的", "en": "Your stance is crooked."},
        {"zh": "我三只眼都在看你", "en": "All three of my eyes are on you."},
        {"zh": "你是来学艺的？", "en": "Have you come to learn?"},
        {"zh": "先说实话，再谈别的", "en": "Truth first, then the rest."},
        {"zh": "你的重心在右脚", "en": "Your weight is on your right foot."},
        {"zh": "我从不只看表面", "en": "I never look only at the surface."},
        {"zh": "你手上有练过的痕迹", "en": "Your hands show training."},
        {"zh": "别指望我轻易收徒", "en": "Don't expect me to take you on easily."},
        {"zh": "说话前先想清楚", "en": "Think before you speak."},
        {"zh": "我不喜欢绕圈子", "en": "I dislike beating around the bush."},
        {"zh": "你想变强，就得吃苦", "en": "Strength means suffering."},
        {"zh": "第三只眼看得出你在撒谎", "en": "My third eye can tell you're lying."},
        {"zh": "站直，眼神别飘", "en": "Stand straight; keep your eyes steady."},
        {"zh": "我给你一次解释的机会", "en": "You get one chance to explain."},
        {"zh": "这院里不欢迎轻浮的人", "en": "Flippancy isn't welcome here."},
        {"zh": "你的呼吸太快了", "en": "Your breathing is too fast."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了一步远", "en": "I took one step back."},
        {"zh": "你这一拳，我肩上接住了。", "en": "I took that punch on my shoulder."},
        {"zh": "我确实小看了你", "en": "I underestimated you."},
        {"zh": "疼，但站得住", "en": "It hurts, but I'm standing."},
        {"zh": "我不会因为疼就退", "en": "Pain won't make me retreat."},
        {"zh": "这只眼也看见了", "en": "This eye saw it too."},
        {"zh": "你比刚才强了", "en": "You're stronger than a moment ago."},
        {"zh": "再来一次也是一样", "en": "Another try ends the same."},
        {"zh": "让我调整一下", "en": "Let me adjust."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不为口腹破戒", "en": "I don't break discipline for food."},
        {"zh": "放那儿吧，我不一定吃", "en": "Leave it; I may not eat."},
        {"zh": "这点东西收买不了我", "en": "That won't buy me."},
        {"zh": "你要是有心，不如多练功", "en": "If you mean well, train more."},
        {"zh": "我吃得一向简单", "en": "I always eat simply."},
        {"zh": "别用这个套近乎", "en": "Don't use that to get close."},
        {"zh": "我谢过你的好意", "en": "I thank you for the thought."},
        {"zh": "先把手上的事做完", "en": "Finish your work first."},
        {"zh": "东西留下，人走", "en": "Leave the food, and go."},
        {"zh": "这不算什么人情", "en": "This counts as no favor."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "先把双脚站稳", "en": "First, plant both feet."},
        {"zh": "撞我也没有用", "en": "Bumping me does no good."},
        {"zh": "你退半步就行了", "en": "Half a step back is all you need."},
        {"zh": "我的脚一步没动", "en": "My feet didn't shift at all."},
        {"zh": "别贴得这么近", "en": "Don't press in this close."},
        {"zh": "你力气还不够", "en": "Your strength isn't there yet."},
        {"zh": "路够宽，你偏要挤", "en": "The path is wide; you chose to crowd."},
        {"zh": "我不介意，但别再撞", "en": "I don't mind, but don't repeat it."},
        {"zh": "把重心放低些", "en": "Lower your center of gravity."},
        {"zh": "这么走路会摔", "en": "Walk like that and you'll fall."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的志向不在这里", "en": "My purpose lies elsewhere."},
        {"zh": "练功比这个重要", "en": "Training matters more."},
        {"zh": "你问错了人了", "en": "You've asked the wrong person."},
        {"zh": "我没有这个打算", "en": "I have no such plan."},
        {"zh": "话就说到这里", "en": "The words end here."},
        {"zh": "我不想浪费时间", "en": "I won't waste time."},
        {"zh": "我们换个话题", "en": "Change the subject."},
        {"zh": "我这人不擅长这些", "en": "I'm not good at these things."},
        {"zh": "你还是去练功吧", "en": "Go train instead."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "先把我放下来", "en": "Set me down."},
        {"zh": "我不需要人搬", "en": "I don't need carrying."},
        {"zh": "你这样抓不住我", "en": "You can't hold me like that."},
        {"zh": "我自己可以走", "en": "I can walk on my own."},
        {"zh": "这样不合规矩", "en": "This breaks the rules."},
        {"zh": "把你的手松开来", "en": "Loosen your grip."},
        {"zh": "我站稳了，你放开", "en": "I'm steady; release me."},
        {"zh": "这么近，你不舒服吧", "en": "This close, you must be uncomfortable."},
        {"zh": "再不放我就自己挣开", "en": "Let go or I'll break free."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经越界了", "en": "You've crossed the line already."},
        {"zh": "我只警告你一次", "en": "I warn you only once."},
        {"zh": "给我站住别动", "en": "Stand right there."},
        {"zh": "动手之前想清楚", "en": "Think before you act."},
        {"zh": "我不主动挑事", "en": "I don't start fights."},
        {"zh": "但我也不会躲", "en": "But I won't dodge either."},
        {"zh": "你的杀气露出来了", "en": "Your killing intent shows."},
        {"zh": "我三只眼都看见了", "en": "All three eyes see it."},
        {"zh": "这院里不许撒野", "en": "No brawling in this yard."},
        {"zh": "你准备好了没有", "en": "Are you ready or not?"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你左侧半步", "en": "I'm half a step to your left."},
        {"zh": "你的呼吸暴露了位置", "en": "Your breathing gives you away."},
        {"zh": "别想绕到我身后", "en": "Don't try to circle behind me."},
        {"zh": "我看得见你的下一步", "en": "I can see your next move."},
        {"zh": "你越急，破绽越多", "en": "The more you rush, the more gaps you show."},
        {"zh": "站定，不许退", "en": "Stand firm; don't retreat."},
        {"zh": "这三只眼不会眨", "en": "These three eyes don't blink."},
        {"zh": "你的架势在崩", "en": "Your guard is collapsing."},
        {"zh": "我开始数了，一", "en": "I'm counting: one."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "看好了，这是掌", "en": "Watch; this is the palm."},
        {"zh": "这一击是正面", "en": "This one comes straight on."},
        {"zh": "你防错了方向", "en": "You guarded the wrong side."},
        {"zh": "力道要透进去", "en": "Power must go through."},
        {"zh": "那就再来一次", "en": "Once again."},
        {"zh": "别退，站住脚", "en": "Don't retreat; hold your place."},
        {"zh": "你这姿势挡不住", "en": "That stance won't block it."},
        {"zh": "我留了三分力", "en": "I held back three parts."},
        {"zh": "吃下这一记重击", "en": "Take this blow."},
        {"zh": "速度比力量更可靠", "en": "Speed is surer than strength."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在此处守着", "en": "I stand guard here."},
        {"zh": "院子干净，可以练功", "en": "The yard's clean; good for training."},
        {"zh": "第三只眼先睁开", "en": "The third eye opens first."},
        {"zh": "我理了理衣襟", "en": "I smooth my collar."},
        {"zh": "今天没有访客", "en": "No visitors today."},
        {"zh": "呼吸已经调匀了", "en": "My breath is even now."},
        {"zh": "这石柱该换了", "en": "This pillar needs replacing."},
        {"zh": "谁来都得先站好", "en": "Whoever comes must stand properly."},
        {"zh": "我在等一件事", "en": "I'm waiting for something."},
        {"zh": "风是从东边来的", "en": "The wind comes from the east."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火伤了我和衣服", "en": "The fire caught me and my clothes."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时膝盖一沉", "en": "My knees buckled on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水下呼吸难续", "en": "Breathing fails underwater."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击震得我耳鸣", "en": "The blast left my ears ringing."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那一发打在我的肩上", "en": "That shot hit my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术锁住了我的气", "en": "The spell shackled my ki."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "空腹撑不住长战", "en": "An empty stomach can't last a long fight."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击让我视线发白", "en": "The bolt whited out my sight."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空之下无立足处", "en": "There's no footing in the void."}
      ]
    }
  }
}
