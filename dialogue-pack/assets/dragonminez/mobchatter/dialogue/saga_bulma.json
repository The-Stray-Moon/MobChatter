{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着地面走，稳稳的。", "en": "I walk on the ground, steady."},
        {"zh": "这条路我熟，别带错路。", "en": "I know this road. Don't lead me wrong."},
        {"zh": "我走得很快，你跟上。", "en": "I walk fast. Keep up."},
        {"zh": "鞋跟敲在地上，咔咔响。", "en": "My heels click on the ground."},
        {"zh": "我抱着一堆东西走。", "en": "I'm walking with an armful of things."},
        {"zh": "你们这些赛亚人，走太慢。", "en": "You Saiyans walk too slowly."},
        {"zh": "我绕开那个坑。", "en": "I step around that pit."},
        {"zh": "这片地，我写过笔记。", "en": "I've written notes about this land."},
        {"zh": "我一边走一边算距离。", "en": "I calculate distances as I walk."},
        {"zh": "风吹乱头发，烦。", "en": "The wind ruins my hair. Annoying."},
        {"zh": "我低头看手里的仪器。", "en": "I glance down at the device in my hand."},
        {"zh": "前面有水声，去那边。", "en": "Water ahead. Let's go there."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在原地，翻着笔记。", "en": "I stand still, flipping through notes."},
        {"zh": "手指敲着膝盖。", "en": "My fingers tap my knee."},
        {"zh": "这种地方，值得研究。", "en": "This place is worth studying."},
        {"zh": "我抬头看看天色，还早。", "en": "I check the sky. Still early."},
        {"zh": "你站那儿别动。", "en": "Stand there and don't move."},
        {"zh": "我在算一件事。", "en": "I'm working out something."},
        {"zh": "有点饿了，等下再说。", "en": "A bit hungry. Later."},
        {"zh": "这机器怎么又卡住了。", "en": "Why is this machine stuck again."},
        {"zh": "我把头发撩到耳后。", "en": "I tuck my hair behind my ear."},
        {"zh": "我不喜欢等着。", "en": "I don't like waiting."},
        {"zh": "这里光线不错。", "en": "The light here is decent."},
        {"zh": "我又听见那声音了。", "en": "I heard that sound again."},
        {"zh": "我不是战士，可我也能站。", "en": "I'm no fighter, but I can stand."},
        {"zh": "我叹口气，继续。", "en": "I sigh and keep going."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看着我，有什么事？", "en": "You're staring at me. What is it?"},
        {"zh": "别挡光，我正看东西。", "en": "Don't block the light. I'm reading."},
        {"zh": "你的装备很旧了。", "en": "Your gear is old."},
        {"zh": "这身衣服，不是我做的。", "en": "That outfit wasn't made by me."},
        {"zh": "你要问路就问。", "en": "If you want directions, ask."},
        {"zh": "我的枪在包里，别逼我。", "en": "My gun's in the bag. Don't push me."},
        {"zh": "不过我可以。", "en": "But I can."},
        {"zh": "你的手别乱放。", "en": "Keep your hands to yourself."},
        {"zh": "我认得你这种表情。", "en": "I know that look."},
        {"zh": "你有话快说。", "en": "Out with it."},
        {"zh": "我皱了皱眉。", "en": "I frowned."},
        {"zh": "别靠太近，我身上有东西。", "en": "Don't come close. I'm carrying something."},
        {"zh": "你这样盯着，很没礼貌。", "en": "Staring like that is rude."},
        {"zh": "我不是软柿子。", "en": "I'm no pushover."},
        {"zh": "你要是赛亚人，我一眼看得出来。", "en": "If you're a Saiyan, I can tell at a glance."},
        {"zh": "我抬手理了理袖口。", "en": "I straighten my cuff."},
        {"zh": "你到底在笑什么？", "en": "What exactly are you smiling at?"},
        {"zh": "我的胶囊里还有装备。", "en": "I still have gear in my capsules."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你竟然打到我了。", "en": "You actually hit me."},
        {"zh": "疼死了，你知道不知道。", "en": "That hurt, you know."},
        {"zh": "我的衣服破了。", "en": "My clothes are torn."},
        {"zh": "这一下，我记着呢。", "en": "I'll be remembering that."},
        {"zh": "打坏我的装备，你要赔。", "en": "Break my gear and you pay for it."},
        {"zh": "我退了一步，稳住。", "en": "I step back and steady myself."},
        {"zh": "手有点发麻。", "en": "My hands are a little numb."},
        {"zh": "你力气还真大。", "en": "You're surprisingly strong."},
        {"zh": "腿麻了，可我还没倒。", "en": "My legs are numb but I'm still up."},
        {"zh": "这笔账，回头算。", "en": "I'll settle this later."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里的，是吃的吗？", "en": "Is that food in your hand?"},
        {"zh": "我刚好饿了。", "en": "I'm hungry, actually."},
        {"zh": "放着，我自己拿。", "en": "Leave it. I'll take it myself."},
        {"zh": "你这样做，有点奇怪。", "en": "This is a little strange of you."},
        {"zh": "我不吃来路不明的东西。", "en": "I don't eat things of unknown origin."},
        {"zh": "除非它是干净的。", "en": "Unless it's clean."},
        {"zh": "你举着不累吗？", "en": "Doesn't your arm get tired?"},
        {"zh": "好吧，给我看看。", "en": "Fine. Let me see it."},
        {"zh": "我不挑，但别太糟。", "en": "I'm not picky, but don't make it terrible."},
        {"zh": "递过来，谢了。", "en": "Hand it over. Thanks."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我了，看着点。", "en": "You bumped me — watch it."},
        {"zh": "我的东西差点掉了。", "en": "I nearly dropped my things."},
        {"zh": "别挤，我手里有仪器。", "en": "Don't crowd me. I'm holding equipment."},
        {"zh": "脚底下踩实了再动。", "en": "Plant your feet before you move."},
        {"zh": "我退一步，让开。", "en": "I step back to make room."},
        {"zh": "你肩膀太硬了。", "en": "Your shoulder is too hard."},
        {"zh": "我们撞在一起，我稳住手。", "en": "We collide, and I steady my hands."},
        {"zh": "你撞得我头发乱了。", "en": "You knocked my hair out of place."},
        {"zh": "东西没坏，运气好。", "en": "Nothing broke. Lucky."},
        {"zh": "下次走路看着点。", "en": "Watch where you're walking next time."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这种事，不适合现在谈。", "en": "Not the right time for such things."},
        {"zh": "我有我的打算。", "en": "I have my own plans."},
        {"zh": "我认识的人里，没一个是省心的。", "en": "None of the people I know are easy."},
        {"zh": "你的想法，我知道。", "en": "I know what you're thinking."},
        {"zh": "别把话说到那一步。", "en": "Don't take it that far."},
        {"zh": "我还有很多事要做。", "en": "I have a lot left to do."},
        {"zh": "我笑了一下，没答。", "en": "I smiled and said nothing."},
        {"zh": "等这一切结束吧。", "en": "After all this is over."},
        {"zh": "我不需要谁保护。", "en": "I don't need anyone's protection."},
        {"zh": "一个人也能过。", "en": "I can get by alone."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个我捡到了，归我。", "en": "I found this. Mine."},
        {"zh": "我看看，能用。", "en": "Let me see. Usable."},
        {"zh": "你还挺浪费的。", "en": "You're wasteful."},
        {"zh": "铁片？我有用处。", "en": "Iron scraps? I can use those."},
        {"zh": "这个插头不对。", "en": "This connector is wrong."},
        {"zh": "我擦干净再收。", "en": "I'll wipe it clean before storing it."},
        {"zh": "亮的东西，我总要多看两眼。", "en": "Shiny things always get a second look from me."},
        {"zh": "我装进包里。", "en": "I put it in my bag."},
        {"zh": "这箱子沉得离谱。", "en": "This chest is absurdly heavy."},
        {"zh": "别抢，我先拿到的。", "en": "Don't grab. I got it first."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "好吧，那就打。", "en": "Fine. Then we fight."},
        {"zh": "我先开口，你才动的。", "en": "I spoke first; that's when you moved."},
        {"zh": "别以为我不会。", "en": "Don't think I can't."},
        {"zh": "我算准了你的落点。", "en": "I've worked out where you'll land."},
        {"zh": "你的破绽在肩。", "en": "Your weakness is at the shoulder."},
        {"zh": "三秒，你自己选。", "en": "Three seconds. Your call."},
        {"zh": "一，二，三。", "en": "One, two, three."},
        {"zh": "我只说一次，让开。", "en": "I say it once. Move aside."},
        {"zh": "你后退了半步。", "en": "You took half a step back."},
        {"zh": "不过现在晚了。", "en": "But now it's too late."},
        {"zh": "我握紧拳头。", "en": "I clench my fist."},
        {"zh": "这一场，我奉陪。", "en": "I'll see this through."},
        {"zh": "你选错了人。", "en": "You picked the wrong person."},
        {"zh": "你别小看我。", "en": "Don't you underestimate me."},
        {"zh": "我抬手，示意你过来。", "en": "I beckon you over."},
        {"zh": "结束得会很快。", "en": "This will be over quickly."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你往哪边走，我都看着。", "en": "I see whichever way you go."},
        {"zh": "别以为我会追丢。", "en": "Don't think I'll lose you."},
        {"zh": "我的鞋跟不适合追人。", "en": "These heels aren't made for chasing."},
        {"zh": "不过我还是会追。", "en": "But I'll chase anyway."},
        {"zh": "你绕到石头后面。", "en": "You've slipped behind the stone."},
        {"zh": "我听见你的动静。", "en": "I hear you moving."},
        {"zh": "你跑得没我算得快。", "en": "You can't outrun my calculations."},
        {"zh": "我从这条道截你。", "en": "I'll cut you off on this path."},
        {"zh": "你喘得很厉害。", "en": "You're gasping hard."},
        {"zh": "再跑一会儿，你就慢下来。", "en": "Run a little more, and you'll slow down."},
        {"zh": "我把手里的东西放下了。", "en": "I've set my things down."},
        {"zh": "现在没有负担。", "en": "No burden now."},
        {"zh": "你回头，我就在那儿。", "en": "Look back. I'm right there."},
        {"zh": "这片地我走过。", "en": "I've walked this ground before."},
        {"zh": "我知道哪里走不通。", "en": "I know which ways are blocked."},
        {"zh": "你面前只剩一堵墙。", "en": "Only a wall lies ahead of you."},
        {"zh": "我不急，我等你累。", "en": "No rush. I'll wait for you to tire."},
        {"zh": "你的脚步越来越沉。", "en": "Your steps grow heavier."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一拳打在你肋骨上。", "en": "A punch to your ribs."},
        {"zh": "这一下，够你退两步。", "en": "That should put you back two steps."},
        {"zh": "我抬膝撞你的护腿缝。", "en": "I drive a knee into the gap in your greaves."},
        {"zh": "你的护甲有缝，我知道在哪儿。", "en": "Your armor has a gap. I know where."},
        {"zh": "手肘，很短的距离。", "en": "An elbow, from very close."},
        {"zh": "你挡住了，还行。", "en": "You blocked it. Not bad."},
        {"zh": "再来一下，接着。", "en": "Here's another. Take it."},
        {"zh": "我抓住你的手腕，反扭。", "en": "I grab your wrist and twist it back."},
        {"zh": "你被我绊了一下。", "en": "I tripped you."},
        {"zh": "这一脚，是我自学的。", "en": "I taught myself that kick."},
        {"zh": "你退了，我就跟上去。", "en": "You back off, and I follow."},
        {"zh": "你脸上结实挨了一下。", "en": "One lands square on your face."},
        {"zh": "我的拳头顶在你下巴。", "en": "My fist meets your chin."},
        {"zh": "这一掌打偏了半分。", "en": "That palm strike missed by half an inch."},
        {"zh": "我踩着你的脚背。", "en": "I step on the top of your foot."},
        {"zh": "你的手被我打落了。", "en": "I knocked your hand away."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从那边走过来，很自然。", "en": "I walk over from there, perfectly natural."},
        {"zh": "你没想到会是我吧。", "en": "You didn't expect me, did you."},
        {"zh": "我把工具包放下。", "en": "I set down my toolkit."},
        {"zh": "这里的空气不对。", "en": "The air here is wrong."},
        {"zh": "我看着你，先不开口。", "en": "I look at you and say nothing yet."},
        {"zh": "我是被派来的，还是自己来的？", "en": "Was I sent, or did I come myself?"},
        {"zh": "反正我到了。", "en": "Either way, I'm here."},
        {"zh": "我理了理衣服。", "en": "I smooth my clothes."},
        {"zh": "这片地方，我不熟。", "en": "I don't know this place."},
        {"zh": "但你看起来更不熟。", "en": "But you look even less familiar with it."},
        {"zh": "我抬起下巴。", "en": "I lift my chin."},
        {"zh": "你手放下来吧。", "en": "Put your hands down."},
        {"zh": "这么荒的地方，还有人。", "en": "Such a barren place, and yet someone's here."},
        {"zh": "我站在原地，看着你。", "en": "I stand there looking at you."},
        {"zh": "你这身装备，得换。", "en": "That gear of yours needs replacing."},
        {"zh": "我不是来抢东西的。", "en": "I'm not here to rob anyone."},
        {"zh": "除非你让我不得不。", "en": "Unless you force me to."},
        {"zh": "我的名字，你大概听过。", "en": "You've probably heard my name."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到袖子了，烫。", "en": "Fire caught my sleeve. Hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从这么高摔下来，腿都软。", "en": "Falling from that height leaves my legs weak."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进鼻子里，呛死了。", "en": "Water up my nose. Awful."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我的耳朵震得嗡嗡响。", "en": "The blast left my ears ringing."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭擦过去，划破了皮。", "en": "An arrow grazed me and broke the skin."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒语黏在我身上，甩不掉。", "en": "The spell clings to me and won't shake off."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得手都在抖。", "en": "Hunger has my hands shaking."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我整个人都僵了。", "en": "Lightning struck and I went rigid."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这下面什么都没有，太可怕。", "en": "There's nothing below here. Terrifying."}
      ]
    }
  }
}
