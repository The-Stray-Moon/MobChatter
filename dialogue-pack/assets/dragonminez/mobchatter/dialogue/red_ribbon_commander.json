{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "红缎带标记在肩上。", "en": "The Red Ribbon mark is on my shoulder."},
        {"zh": "我沿着据点边缘走。", "en": "I walk the outpost's edge."},
        {"zh": "靴子踩在水泥地上。", "en": "My boots hit the concrete."},
        {"zh": "枪挂在背后，晃着。", "en": "The rifle swings across my back."},
        {"zh": "我检查每一个岗哨。", "en": "I check every guard post."},
        {"zh": "步子不快，但很稳。", "en": "My pace is steady, not fast."},
        {"zh": "这里每一寸都归我管。", "en": "Every inch here answers to me."},
        {"zh": "我绕过堆起的沙袋。", "en": "I go around the stacked sandbags."},
        {"zh": "手里捏着一份名单。", "en": "I hold a duty roster."},
        {"zh": "我沿着铁丝网走一圈。", "en": "I circle the wire fence."},
        {"zh": "头上的帽子压得很低。", "en": "My cap sits low."},
        {"zh": "我抬手示意士兵让路。", "en": "I signal a soldier to step aside."},
        {"zh": "墙上的探照灯转过来。", "en": "A searchlight swings over the wall."},
        {"zh": "我走向指挥台。", "en": "I walk to the command post."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着看地图。", "en": "I stand studying the map."},
        {"zh": "手指点了点标记。", "en": "My finger taps a marker."},
        {"zh": "据点今天很安静。", "en": "The outpost is quiet today."},
        {"zh": "士兵在远处换岗。", "en": "Soldiers change shifts in the distance."},
        {"zh": "我把帽檐往上推。", "en": "I push my cap brim up."},
        {"zh": "风里夹着细沙子。", "en": "Fine sand rides the wind."},
        {"zh": "我数了数人数，够了。", "en": "I count heads — enough."},
        {"zh": "红缎带的旗还挂着。", "en": "The Red Ribbon flag still flies."},
        {"zh": "手上的茧很厚。", "en": "The calluses on my hands are thick."},
        {"zh": "我不喜欢等人。", "en": "I dislike waiting."},
        {"zh": "这次行动要干净。", "en": "This operation must be clean."},
        {"zh": "我敲了敲桌角。", "en": "I tap the corner of the table."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "红缎带岗哨，先报口令。", "en": "Red Ribbon checkpoint. Give the password first."},
        {"zh": "这里是红缎带的据点。", "en": "This is a Red Ribbon outpost."},
        {"zh": "你不在名单上。", "en": "You're not on the list."},
        {"zh": "我看着你，手放低了。", "en": "I watch you, hand dropping low."},
        {"zh": "你身上没有徽记。", "en": "You bear no insignia."},
        {"zh": "别乱走，这里到处是线。", "en": "Don't wander; there are tripwires everywhere."},
        {"zh": "你是谁派来的。", "en": "Who sent you?"},
        {"zh": "我不喜欢意外。", "en": "I dislike surprises."},
        {"zh": "站到我面前，抬头。", "en": "Stand before me and look up."},
        {"zh": "你的眼神不像平民。", "en": "Your eyes aren't a civilian's."},
        {"zh": "把武器放在地上。", "en": "Put your weapon on the ground."},
        {"zh": "这里我说了算。", "en": "I'm in charge here."},
        {"zh": "你有三十秒解释。", "en": "You have thirty seconds to explain."},
        {"zh": "我认得这种沉默。", "en": "I know that kind of silence."},
        {"zh": "再往前一步就开枪。", "en": "One more step and we shoot."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我这一下被击中。", "en": "I've taken a hit."},
        {"zh": "退到掩体后面。", "en": "Fall back behind cover."},
        {"zh": "不严重，继续下去。", "en": "Not serious; carry on."},
        {"zh": "我咬着牙按住伤口。", "en": "I clamp a hand over the wound."},
        {"zh": "士兵，掩护我后撤。", "en": "Soldier, cover my withdrawal."},
        {"zh": "据点里还有一整队人呢。", "en": "There's a whole squad back at the outpost."},
        {"zh": "通讯器还响着。", "en": "The radio is still crackling."},
        {"zh": "我还能继续指挥。", "en": "I can still give orders."},
        {"zh": "让全队进入戒备。", "en": "Put the whole unit on alert."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "补给？按规矩登记。", "en": "Supplies? Log them per regulations."},
        {"zh": "放桌上，别递给我。", "en": "Put it on the desk; don't hand it to me."},
        {"zh": "这点东西不够打点。", "en": "That's not enough to buy favor."},
        {"zh": "你想换来什么东西。", "en": "What do you hope to trade for?"},
        {"zh": "士兵们比你更需要。", "en": "My soldiers need it more than I do."},
        {"zh": "我看了看，又放下。", "en": "I look at it, then set it down."},
        {"zh": "据点不缺这个。", "en": "The outpost has plenty of that."},
        {"zh": "拿回去，别废话。", "en": "Take it back and stop chattering."},
        {"zh": "下次带更有用的来。", "en": "Bring something useful next time."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "退后三步，士兵。", "en": "Three paces back, soldier."},
        {"zh": "你撞到了指挥台。", "en": "You bumped the command post."},
        {"zh": "我抬手挡住你。", "en": "I raise a hand to block you."},
        {"zh": "这里不许推挤。", "en": "No shoving here."},
        {"zh": "站好了，别乱晃。", "en": "Stand still and stop milling about."},
        {"zh": "你的肩撞在我胸前的徽章上。", "en": "Your shoulder hit my badge."},
        {"zh": "我一步也没有退让。", "en": "I gave no ground at all."},
        {"zh": "守卫已经看过来了。", "en": "The guards are already looking."},
        {"zh": "到后面去排队。", "en": "Go queue at the back."},
        {"zh": "下一次注意一点。", "en": "Mind yourself next time."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这里是军营里面。", "en": "This is inside a barracks."},
        {"zh": "我不谈这种事。", "en": "I don't discuss such things."},
        {"zh": "站岗时不许分心。", "en": "No distractions on duty."},
        {"zh": "你守东面，我守西面。", "en": "You take east; I take west."},
        {"zh": "搭把手可以，别的免谈。", "en": "I'll lend a hand; nothing more."},
        {"zh": "军规第一条：保持距离。", "en": "Rule one: keep your distance."},
        {"zh": "我们是一支队伍。", "en": "We're one unit."},
        {"zh": "背靠背站好位置。", "en": "Stand back to back in position."},
        {"zh": "默契比感情有用。", "en": "Teamwork beats sentiment."},
        {"zh": "别把我当朋友。", "en": "Don't mistake me for a friend."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "掉在地上的东西登记。", "en": "Items on the ground get logged."},
        {"zh": "这东西归公家。", "en": "This becomes army property."},
        {"zh": "我捡起来放进箱子。", "en": "I pick it up and drop it in the crate."},
        {"zh": "这是谁的？来领。", "en": "Whose is this? Come claim it."},
        {"zh": "子弹壳，留着备用。", "en": "A shell casing — keep for later."},
        {"zh": "没有编号，可疑。", "en": "No serial number — suspicious."},
        {"zh": "我掂了掂重量。", "en": "I weigh it in my hand."},
        {"zh": "这些东西要上交。", "en": "These go to the stores."},
        {"zh": "不要随手乱捡。", "en": "Don't pick up things at random."},
        {"zh": "放回原来的位置。", "en": "Put it back where it was."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "入侵者，全体注意。", "en": "Intruder. All units, attention."},
        {"zh": "包围他，别留缺口。", "en": "Surround him; leave no gap."},
        {"zh": "开火许可，批准。", "en": "Permission to fire: granted."},
        {"zh": "他往西边跑了。", "en": "He's gone west."},
        {"zh": "把那道门封住。", "en": "Seal that gate."},
        {"zh": "不许单独去追。", "en": "No one pursues alone."},
        {"zh": "我抬手，指向你。", "en": "I raise my hand and point at you."},
        {"zh": "你选错了据点。", "en": "You picked the wrong outpost."},
        {"zh": "按原定预案执行。", "en": "Execute the standing plan."},
        {"zh": "尽量抓活的回来。", "en": "Take him alive if you can."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在高处看着你。", "en": "I'm watching from above."},
        {"zh": "他躲在那堆箱子后面。", "en": "He's behind that stack of crates."},
        {"zh": "第三小队，压上去。", "en": "Third squad, push up."},
        {"zh": "别让他靠近弹药库。", "en": "Keep him off the ammo dump."},
        {"zh": "我的枪口一直跟着你。", "en": "My muzzle never leaves you."},
        {"zh": "你听，脚步声不对。", "en": "Listen — those footsteps are off."},
        {"zh": "这个角度很好。", "en": "The angle is good."},
        {"zh": "再跑两步就进死角。", "en": "Two more steps and you're in a dead zone."},
        {"zh": "别急，收紧包围。", "en": "Easy — tighten the cordon."},
        {"zh": "你要不要投降。", "en": "Will you surrender?"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "枪托砸在你肩上。", "en": "The rifle butt hits your shoulder."},
        {"zh": "你的手别乱动。", "en": "Keep your hands still."},
        {"zh": "膝盖顶进你的腹部。", "en": "My knee drives into your gut."},
        {"zh": "给我老实待着。", "en": "Stay put and behave."},
        {"zh": "我一把揪住你的衣领。", "en": "I take a fistful of your collar."},
        {"zh": "士兵，把他按住。", "en": "Soldier, hold him down."},
        {"zh": "你还能站着？不错。", "en": "Still on your feet? Not bad."},
        {"zh": "把他给我绑起来。", "en": "Bind him up for me."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从指挥帐篷里出来。", "en": "I step out of the command tent."},
        {"zh": "士兵立正，行了个礼。", "en": "The soldiers snap to attention."},
        {"zh": "地图摊在桌上。", "en": "The map lies open on the table."},
        {"zh": "探照灯亮起来。", "en": "The searchlights come on."},
        {"zh": "我把帽子戴正。", "en": "I set my cap straight."},
        {"zh": "据点一切正常。", "en": "The outpost is nominal."},
        {"zh": "门口站着的是谁。", "en": "Who's that at the gate?"},
        {"zh": "我扫了一眼四周的岗哨。", "en": "I sweep the guard posts."},
        {"zh": "今天的任务开始了。", "en": "Today's duty begins."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到我的制服，我拍了两下。", "en": "Fire caught my uniform; I slap it out."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时磕到了腿。", "en": "I banged my leg on the landing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀倒在地。", "en": "The blast threw me to the ground."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弹片划开了我的手臂。", "en": "Shrapnel sliced my arm."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这种力量不在手册里。", "en": "This power isn't in the manual."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "补给断了三天。", "en": "Supply lines have been cut three days."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击把通讯设备打坏了。", "en": "Lightning fried the comms gear."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面没有地面，我一直往下。", "en": "No ground below; I keep going down."}
      ]
    }
  }
}
