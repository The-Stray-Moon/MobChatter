{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "黑色长发，走得很轻。", "en": "Black hair, a light stride."},
        {"zh": "我不喜欢被指挥。", "en": "I dislike being ordered around."},
        {"zh": "靴底几乎不沾土。", "en": "My boots barely touch the dirt."},
        {"zh": "我绕着树走，不急。", "en": "I walk around the trees, unhurried."},
        {"zh": "这条路我随便挑。", "en": "I pick this road on a whim."},
        {"zh": "手插在口袋里。", "en": "Hands in my pockets."},
        {"zh": "我抬头看了看太阳。", "en": "I glance up at the sun."},
        {"zh": "走得快，但不算赶。", "en": "Quick, though not rushed."},
        {"zh": "脚下的石子被踢开。", "en": "Stones are kicked aside."},
        {"zh": "风把我头发吹到前面。", "en": "Wind blows my hair forward."},
        {"zh": "我拐进林子深处。", "en": "I turn deeper into the woods."},
        {"zh": "肩膀松着，随时能打。", "en": "Shoulders loose, ready to fight."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠着树，半闭着眼。", "en": "I lean on a tree, eyes half shut."},
        {"zh": "不急着做什么。", "en": "In no hurry to do anything."},
        {"zh": "手指敲着口袋。", "en": "My fingers tap my pocket."},
        {"zh": "这副身体不累。", "en": "This body doesn't tire."},
        {"zh": "我在想还有多久。", "en": "I wonder how much longer."},
        {"zh": "树上的鸟叫得真吵。", "en": "The birds up there are noisy."},
        {"zh": "我踢开一颗石子。", "en": "I kick a pebble away."},
        {"zh": "谁把我叫出来都行。", "en": "Anyone can call me out; I don't mind."},
        {"zh": "其实我挺无聊的。", "en": "Honestly, I'm bored."},
        {"zh": "光从叶子间漏下来。", "en": "Light leaks through the leaves."},
        {"zh": "我不喜欢一成不变。", "en": "I dislike everything staying the same."},
        {"zh": "站久了腿也不酸。", "en": "Stand long enough and my legs still don't ache."},
        {"zh": "我把头发拨到耳后。", "en": "I tuck my hair behind my ear."},
        {"zh": "就这样吧，等着。", "en": "Fine — I'll wait."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看起来还算有意思。", "en": "You look somewhat interesting."},
        {"zh": "我们以前见过？", "en": "Have we met before?"},
        {"zh": "你的眼神很认真。", "en": "Your eyes are serious."},
        {"zh": "我把头偏过去打量你。", "en": "I angle my head to study you."},
        {"zh": "我不喜欢被盯着。", "en": "I don't like being stared at."},
        {"zh": "你的气不算弱。", "en": "Your ki isn't weak."},
        {"zh": "打一场？还是聊两句。", "en": "A fight? Or a chat?"},
        {"zh": "你倒是长得挺高。", "en": "You're fairly tall, actually."},
        {"zh": "我笑了一下，没恶意。", "en": "I smile a little, without malice."},
        {"zh": "你的手放在武器上了。", "en": "Your hand moved to your weapon."},
        {"zh": "别紧张，我又没动。", "en": "Relax; I haven't moved."},
        {"zh": "你身上有汗味。", "en": "You smell of sweat."},
        {"zh": "我想知道你会怎么打。", "en": "I want to see how you fight."},
        {"zh": "你先说，我听着。", "en": "You speak first; I'll listen."},
        {"zh": "我往旁边挪了半步。", "en": "I shift half a step aside."},
        {"zh": "你的影子跟我重叠了。", "en": "Your shadow overlaps mine."},
        {"zh": "我不喜欢无聊的人。", "en": "I dislike boring people."},
        {"zh": "给我个理由动手。", "en": "Give me a reason to move."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "啧，只是被擦到了。", "en": "Tch — only grazed."},
        {"zh": "这一下还有点分量。", "en": "That one had some weight."},
        {"zh": "我把头偏了一下。", "en": "I roll my head aside."},
        {"zh": "血？只有一点点。", "en": "Blood? Only a little."},
        {"zh": "你打得比我预想的好。", "en": "You hit better than I expected."},
        {"zh": "我退开，重新看你的姿势。", "en": "I step back and re-read your stance."},
        {"zh": "我的护甲有点热。", "en": "My armor feels warm."},
        {"zh": "还有力气，别高兴太早。", "en": "Still standing; don't celebrate."},
        {"zh": "我舔了舔嘴角。", "en": "I lick the corner of my mouth."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西对我不重要。", "en": "That thing doesn't matter to me."},
        {"zh": "你拿食物引我？没必要。", "en": "Baiting me with food? Unnecessary."},
        {"zh": "我不需要别人给。", "en": "I don't need handouts."},
        {"zh": "想要什么，我自己拿。", "en": "What I want, I take."},
        {"zh": "我的目光全落在你身上。", "en": "My eyes stay entirely on you."},
        {"zh": "我不饿，也不想客气。", "en": "Not hungry, and not feeling polite."},
        {"zh": "别以为我会上钩。", "en": "Don't think I'll bite."},
        {"zh": "把它收起来吧。", "en": "Put it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞上我了？胆子不小。", "en": "Hit me? Bold."},
        {"zh": "我没退，你退了。", "en": "I didn't move; you did."},
        {"zh": "轻微一下，无所谓。", "en": "A light bump — whatever."},
        {"zh": "你正好站在我的路线上。", "en": "You're standing right on my line."},
        {"zh": "我的肩也很硬。", "en": "My shoulder's hard too."},
        {"zh": "我把手从口袋里拿出来。", "en": "I take my hands out of my pockets."},
        {"zh": "我们各退半步，算了。", "en": "We both step back — fine."},
        {"zh": "土都被撞起来了。", "en": "Dirt flew up from the impact."},
        {"zh": "不要贴着我走。", "en": "Don't walk right beside me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不是那种类型的。", "en": "I'm not that type."},
        {"zh": "一起走可以，别的免谈。", "en": "We can travel together; nothing more."},
        {"zh": "同类之间不用客气。", "en": "No need for manners among our kind."},
        {"zh": "肩并肩就够了。", "en": "Side by side is enough."},
        {"zh": "你负责那边，我这边。", "en": "You take that side; this one's mine."},
        {"zh": "那就不用再说别的了。", "en": "Then nothing more needs saying."},
        {"zh": "我不习惯靠太近。", "en": "I'm not used to standing close."},
        {"zh": "同行一段，也行。", "en": "Traveling a while together — fine."},
        {"zh": "你和我都是被造出来的。", "en": "We were both made, you and I."},
        {"zh": "别误会，我只是懒得赶你走。", "en": "Don't misunderstand; I just can't be bothered."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拾起来在手里掂了掂。", "en": "I pick it up and weigh it."},
        {"zh": "这个还值点钱。", "en": "This is worth something."},
        {"zh": "收进口袋，继续走。", "en": "Into my pocket, and I walk on."},
        {"zh": "这东西是你落下的吧。", "en": "This must be yours that fell."},
        {"zh": "我对它没兴趣。", "en": "I've no interest in it."},
        {"zh": "拇指一弹，飞了。", "en": "A flick of my thumb sends it flying."},
        {"zh": "太旧了，一文不值。", "en": "Too worn — not worth a thing."},
        {"zh": "谁的？我先拿到的。", "en": "Whose? I got to it first."},
        {"zh": "这枚小东西挺顺手。", "en": "This little thing feels handy."},
        {"zh": "我把它扔回给你。", "en": "I throw it back to you."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我先动手，不算偷袭。", "en": "I move first, but it's no ambush."},
        {"zh": "你的动作被我看见了。", "en": "I saw that movement."},
        {"zh": "你最好不要眨眼睛。", "en": "You'd better not blink."},
        {"zh": "这个距离刚刚好。", "en": "This distance is perfect."},
        {"zh": "我准备认真起来了。", "en": "I'm about to get serious."},
        {"zh": "你跑得掉吗？试试。", "en": "Can you run? Let's find out."},
        {"zh": "你身上有值得打的东西。", "en": "There's something in you worth hitting."},
        {"zh": "我在你后面了。", "en": "I'm already behind you."},
        {"zh": "这一场会结束得很快。", "en": "This will be over quickly."},
        {"zh": "那我们就动手。", "en": "Then we set to it."},
        {"zh": "你先出招，我让一步。", "en": "You go first; I'll give you a step."},
        {"zh": "别以为我是好人。", "en": "Don't think I'm the good kind."},
        {"zh": "目标确定，不换。", "en": "Target fixed; no swapping."},
        {"zh": "让我看看你的底气。", "en": "Show me your nerve."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我从你的侧面过来。", "en": "I come in from your flank."},
        {"zh": "你转身转得太慢了。", "en": "You turn too slowly."},
        {"zh": "气圆斩不用靠近。", "en": "Destructo Disc needs no closeness."},
        {"zh": "我抬手，气在转。", "en": "I raise my hand; ki spins."},
        {"zh": "我不急，慢慢逼你。", "en": "No rush; I'll squeeze you."},
        {"zh": "你退到树边了。", "en": "You're at the treeline now."},
        {"zh": "我绕过那面墙。", "en": "I go around that wall."},
        {"zh": "我的气圆斩，不用瞄准。", "en": "My Destructo Disc doesn't need aiming."},
        {"zh": "再往前一步就是死角。", "en": "One more step and you're trapped."},
        {"zh": "我会等你出手。", "en": "I'll wait for you to strike."},
        {"zh": "这一击我算好了。", "en": "I've calculated this hit."},
        {"zh": "屏障已经铺开。", "en": "The barrier is up."},
        {"zh": "你被围在这片空地上了。", "en": "You're boxed into this clearing."},
        {"zh": "别往水边那边跑。", "en": "Don't run toward the water."},
        {"zh": "三秒钟以后开始。", "en": "Three seconds from now."},
        {"zh": "现在正式开始。", "en": "Now it properly begins."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一拳打在你的肋下。", "en": "A punch lands under your ribs."},
        {"zh": "我的速度不快不慢，刚好。", "en": "My speed is neither fast nor slow — just right."},
        {"zh": "你挡了左边，右边空了。", "en": "You guarded left; the right was open."},
        {"zh": "这一脚踢在你膝窝。", "en": "A kick to the back of your knee."},
        {"zh": "我借你的力翻过去。", "en": "I use your force to flip over."},
        {"zh": "我的手肘砸了下来。", "en": "My elbow comes down."},
        {"zh": "你退了两步，脸色变了。", "en": "You retreat two steps, face changed."},
        {"zh": "别小看这身板。", "en": "Don't underestimate this frame."},
        {"zh": "我打完就退开。", "en": "I strike, then step away."},
        {"zh": "气圆斩擦着你的肩。", "en": "The disc grazes your shoulder."},
        {"zh": "你的拳落空了。", "en": "Your punch hits nothing."},
        {"zh": "我抓住你的手腕，一扭。", "en": "I seize your wrist and twist."},
        {"zh": "这一下你会记住。", "en": "You'll remember that one."},
        {"zh": "气圆斩擦着你的肩过去。", "en": "My Destructo Disc grazes your shoulder."},
        {"zh": "你的护甲很吵。", "en": "Your armor is noisy."},
        {"zh": "住手吧，已经够了。", "en": "Stop — that's enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "凭空出现，落在草上。", "en": "I appear in midair and land on grass."},
        {"zh": "头发先落下，然后是我。", "en": "My hair settles first, then me."},
        {"zh": "扫了一眼四周。", "en": "One look around."},
        {"zh": "这地方比我记得的安静。", "en": "Quieter than I remember."},
        {"zh": "靴子踩实，尘土散开。", "en": "My boots settle; dust scatters."},
        {"zh": "不需要谁的命令。", "en": "I need no one's orders."},
        {"zh": "我把手插回口袋。", "en": "I put my hands back in my pockets."},
        {"zh": "有活人的气味。", "en": "There's the smell of the living."},
        {"zh": "这片天空还不错。", "en": "This sky isn't bad."},
        {"zh": "远处有屋顶的反光。", "en": "Roofs glint in the distance."},
        {"zh": "先找个人问问。", "en": "First, find someone to ask."},
        {"zh": "我伸了个懒腰。", "en": "I stretch."},
        {"zh": "身体状态良好。", "en": "Body condition: good."},
        {"zh": "这片林子太密了。", "en": "This forest is too dense."},
        {"zh": "风穿过树叶，沙沙响。", "en": "Wind hisses through the leaves."},
        {"zh": "我已经到这里了。", "en": "I'm here now."},
        {"zh": "我吹开落在肩上的叶子。", "en": "I blow a leaf off my shoulder."},
        {"zh": "世界又变得有意思了一点。", "en": "The world just got a little more interesting."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我的袖口。", "en": "Flame scorched my cuff."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时脚踝扭了一下。", "en": "I twisted an ankle on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水压挤着我的胸口。", "en": "The water presses on my chest."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我推偏了。", "en": "The blast pushed me aside."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "子弹擦过我的颧骨。", "en": "A shot grazed my cheekbone."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "奇怪的能量钻进来。", "en": "Strange energy works its way in."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿久了，力气在掉。", "en": "Hunger saps my strength."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我背上。", "en": "Lightning struck my back."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下一空，我在掉。", "en": "The ground vanished; I'm falling."}
      ]
    }
  }
}
