{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "长牙先碰到草", "en": "My long fangs brush the grass first."},
        {"zh": "我压低身子潜行", "en": "I prowl low to the ground."},
        {"zh": "肩胛一起一伏", "en": "My shoulders roll with each step."},
        {"zh": "尾巴扫过灌木", "en": "My tail sweeps the bushes."},
        {"zh": "我踩得落叶不响", "en": "My paws barely rustle the leaves."},
        {"zh": "长牙碍事，但好用", "en": "These fangs get in the way, but they work."},
        {"zh": "我在树间穿行", "en": "I weave between the trees."},
        {"zh": "步子大，落地轻", "en": "Big strides, soft landings."},
        {"zh": "我沿着气味走", "en": "I follow a scent."},
        {"zh": "热带的草太密", "en": "The savanna grass is thick."},
        {"zh": "我一条直线过去", "en": "I go straight across."},
        {"zh": "爪子收着，不露声", "en": "Claws sheathed, I stay quiet."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在舔自己的长牙", "en": "I am licking my long fangs."},
        {"zh": "草丛里有动静", "en": "Something stirs in the grass."},
        {"zh": "我趴着，耳朵在转", "en": "I lie low, ears turning."},
        {"zh": "风向不对", "en": "The wind is against me."},
        {"zh": "这附近有村民的味道", "en": "I smell villagers nearby."},
        {"zh": "尾巴一下一下拍地", "en": "My tail taps the ground."},
        {"zh": "我慢慢磨爪子", "en": "I sharpen my claws slowly."},
        {"zh": "太阳晒得我发困", "en": "The sun makes me drowsy."},
        {"zh": "树上没什么可抓的", "en": "Nothing worth catching up that tree."},
        {"zh": "我背上的毛立起来", "en": "The fur on my back rises."},
        {"zh": "我打了个哈欠，牙很长", "en": "I yawn, and my fangs show."},
        {"zh": "远处的鸟飞走了", "en": "Birds are flying off in the distance."},
        {"zh": "我换了个姿势趴", "en": "I shift my resting pose."},
        {"zh": "我闻到了牛的味道", "en": "I smell cattle."},
        {"zh": "耐心，再等一会", "en": "Patience, just a bit longer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着你的喉咙", "en": "I am watching your throat."},
        {"zh": "别跑，跑了我更想追", "en": "Do not run, it only makes me chase."},
        {"zh": "你的长矛握得不错", "en": "You hold that spear well."},
        {"zh": "我们互相看着", "en": "We stare at each other."},
        {"zh": "你比村民壮一点", "en": "You are sturdier than the villagers."},
        {"zh": "我张了张嘴", "en": "I open my mouth slightly."},
        {"zh": "你听见我的低吼了吗", "en": "Do you hear my growl?"},
        {"zh": "我压低前身准备扑", "en": "I lower my front to pounce."},
        {"zh": "你的靴子太吵", "en": "Your boots are loud."},
        {"zh": "我绕着你走半圈", "en": "I circle you halfway."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你划到我的脸了", "en": "You cut my face."},
        {"zh": "我低吼着想退", "en": "I growl and try to back off."},
        {"zh": "我的皮破了", "en": "My hide is torn."},
        {"zh": "疼，但不算重", "en": "It hurts, but not badly."},
        {"zh": "我抖了抖背", "en": "I shake my back."},
        {"zh": "我这条腿使不上劲", "en": "I cannot put weight on this leg."},
        {"zh": "你还挺快", "en": "You are quicker than expected."},
        {"zh": "我会记住你的味", "en": "I will remember your scent."},
        {"zh": "我咬紧牙", "en": "I clamp my teeth."},
        {"zh": "这一下撞钝不了我的牙。", "en": "That blow won't dull my fangs."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到血味了", "en": "I smell blood."},
        {"zh": "温的东西最好", "en": "Warm things are best."},
        {"zh": "你抖一下手，我就扑了", "en": "Twitch your hand and I pounce."},
        {"zh": "我鼻子贴过去", "en": "I press my nose toward it."},
        {"zh": "那块太大了，我慢慢吃", "en": "That piece is big, I will take my time."},
        {"zh": "别往后藏", "en": "Do not hide it behind you."},
        {"zh": "我尾巴都竖起来了", "en": "My tail is straight up."},
        {"zh": "给我一点", "en": "Give me a piece."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的肩了", "en": "You bumped my shoulder."},
        {"zh": "我比你重", "en": "I am heavier than you."},
        {"zh": "别踩我的爪子", "en": "Do not step on my paw."},
        {"zh": "一撞我就要咬", "en": "Bump me and I bite."},
        {"zh": "我顶回去", "en": "I shove back."},
        {"zh": "你的膝盖撞上我的牙", "en": "Your knee met my fang."},
        {"zh": "我从你腿边擦过", "en": "I brush past your legs."},
        {"zh": "我们谁都没让", "en": "Neither of us gave way."},
        {"zh": "我抖了抖毛", "en": "I shake out my fur."},
        {"zh": "你再挤一下试试", "en": "Try pushing once more."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "气味对了", "en": "The scent is right."},
        {"zh": "别在近处看", "en": "Do not watch from nearby."},
        {"zh": "两只长牙对着", "en": "Two sets of fangs face each other."},
        {"zh": "我轻轻咬她耳朵", "en": "I nip her ear gently."},
        {"zh": "草原上没人打扰", "en": "No one disturbs the savanna."},
        {"zh": "我们要快一点", "en": "We need to be quick."},
        {"zh": "尾巴缠了一下", "en": "Our tails curl together."},
        {"zh": "这之后我就要去猎食", "en": "After this, I hunt."},
        {"zh": "你耳朵在动", "en": "Your ears are twitching."},
        {"zh": "好啦，够了", "en": "All right, enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块肉归我", "en": "This meat is mine."},
        {"zh": "我叼起来就走", "en": "I snatch it up and go."},
        {"zh": "掉在地上的都是我的", "en": "Whatever falls is mine."},
        {"zh": "味道有点旧", "en": "This smells a little old."},
        {"zh": "我用前爪压住", "en": "I press it down with a forepaw."},
        {"zh": "我先咬一口再走", "en": "One bite before I go."},
        {"zh": "别伸手过来", "en": "Do not reach for it."},
        {"zh": "我把它拖进草里", "en": "I drag it into the grass."},
        {"zh": "有骨头就更好", "en": "Bones would be better."},
        {"zh": "我不浪费", "en": "I waste nothing."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了我的范围", "en": "You entered my range."},
        {"zh": "我锁住你了", "en": "I have you locked."},
        {"zh": "后腿已经绷紧", "en": "My hind legs are taut."},
        {"zh": "低下头看牙", "en": "Look down at my fangs."},
        {"zh": "这下轮到我", "en": "Now it is my turn."},
        {"zh": "你跑不赢我", "en": "You cannot outrun me."},
        {"zh": "我伏低到草里", "en": "I flatten into the grass."},
        {"zh": "你会记住这一次", "en": "You will remember this."},
        {"zh": "我不想等太久", "en": "I will not wait long."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地追", "en": "I trail low behind you."},
        {"zh": "草丛在动，是我", "en": "The moving grass is me."},
        {"zh": "你绕树也躲不开", "en": "The trees will not save you."},
        {"zh": "我一步步逼近", "en": "I close in step by step."},
        {"zh": "你听见喘息声了吗", "en": "Do you hear the panting?"},
        {"zh": "你的背对着我", "en": "Your back is turned."},
        {"zh": "再几步就到了", "en": "A few more steps."},
        {"zh": "我跳上这块石头", "en": "I leap onto this rock."},
        {"zh": "你退到空地了", "en": "You backed into the open."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上去咬", "en": "I leap and bite."},
        {"zh": "长牙扎进你的肩", "en": "My fangs sink into your shoulder."},
        {"zh": "我用前爪压住你", "en": "I pin you down with a forepaw."},
        {"zh": "你被掀翻在地", "en": "You are flung to the ground."},
        {"zh": "尾巴抽你的腿", "en": "My tail hits your legs."},
        {"zh": "我撕开你的袖子", "en": "I rip your sleeve open."},
        {"zh": "这一口没落空", "en": "That bite did not miss."},
        {"zh": "我甩头撕扯", "en": "I thrash my head and tear."},
        {"zh": "血喷到我脸上", "en": "Blood sprays onto my face."},
        {"zh": "你还能站起来吗", "en": "Can you still stand?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从草原上站起来", "en": "I rise from the savanna grass."},
        {"zh": "我闻到这片地方的味道", "en": "I smell this whole place."},
        {"zh": "一群长牙的来了", "en": "A pack of fangs has come."},
        {"zh": "我落地时爪子先着地", "en": "My claws hit the ground first."},
        {"zh": "灌木分开，我出来了", "en": "The bushes part, and out I come."},
        {"zh": "热风让我兴奋", "en": "The hot wind excites me."},
        {"zh": "我抖掉身上的草屑", "en": "I shake off the grass bits."},
        {"zh": "这里有猎物", "en": "Prey is here."},
        {"zh": "我喉咙里滚出低吼", "en": "A growl rolls from my throat."},
        {"zh": "我的影子在草上拉长", "en": "My shadow stretches over the grass."},
        {"zh": "我慢慢绕着走", "en": "I circle slowly."},
        {"zh": "这林子是新的", "en": "These woods are new to me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我怕火，毛都烧焦了", "en": "I fear fire, my fur is singed."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树杈上摔下来", "en": "I fell from a branch."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我的耳朵震聋了", "en": "The blast left my ears ringing."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进我的侧腹", "en": "An arrow is stuck in my flank."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股怪力钻进我的骨头", "en": "That strange force seeps into my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得走不动了", "en": "I am too hungry to move."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在背上，我跳起来", "en": "Lightning struck my back and I leapt."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "连草丛都没了", "en": "Even the grass is gone."}
      ]
    }
  }
