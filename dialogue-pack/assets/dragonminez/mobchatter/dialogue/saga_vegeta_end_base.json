{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "黑发压着汗。", "en": "Dark hair, damp with sweat."},
        {"zh": "一步一步，很稳。", "en": "Step by step. Steady."},
        {"zh": "不需要飞也能快。", "en": "I don't need to fly to be fast."},
        {"zh": "护甲擦着风响。", "en": "My armor whispers in the wind."},
        {"zh": "这片空地够用了。", "en": "This clearing will do."},
        {"zh": "身后的脚印很深。", "en": "The prints behind me are deep."},
        {"zh": "走位比速度重要。", "en": "Footing matters more than speed."},
        {"zh": "把气收到脚底。", "en": "Ki gathered under my soles."},
        {"zh": "看看云的高度。", "en": "Reading the height of the clouds."},
        {"zh": "不急，先观察。", "en": "No hurry. Observe first."},
        {"zh": "绕过碎石堆。", "en": "Rounding the rubble."},
        {"zh": "脚步像量过一样。", "en": "My paces look measured."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "沉默也是一种威压。", "en": "Silence is a kind of pressure."},
        {"zh": "掰了掰指节。", "en": "I crack my knuckles."},
        {"zh": "眼下的伤都值得。", "en": "Every wound was worth it."},
        {"zh": "盯着地平线。", "en": "Eyes fixed on the horizon."},
        {"zh": "气浮在皮肤下。", "en": "Ki hums beneath my skin."},
        {"zh": "调整呼吸节奏。", "en": "Settling my breathing."},
        {"zh": "今天不打算退。", "en": "I don't plan to retreat today."},
        {"zh": "耳边的风很干净。", "en": "The wind sounds clean."},
        {"zh": "把披风扣好。", "en": "I fasten my cape."},
        {"zh": "没人在旁边看着。", "en": "No one watching me now."},
        {"zh": "关节活动开。", "en": "Loosening my joints."},
        {"zh": "想着那场没打完的仗。", "en": "Thinking of the fight I never finished."},
        {"zh": "嘴角抬了一下。", "en": "The corner of my mouth lifts."},
        {"zh": "站在这里也算回答。", "en": "Standing here is an answer too."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的眼睛里有疑问。", "en": "There's a question in your eyes."},
        {"zh": "别急着靠近。", "en": "Don't rush closer."},
        {"zh": "你的气，还没练到家。", "en": "Your ki is far from trained."},
        {"zh": "你的站姿像受过训练。", "en": "You stand like someone trained."},
        {"zh": "先说你是谁。", "en": "First, who are you?"},
        {"zh": "这片废墟不安全。", "en": "These ruins aren't safe."},
        {"zh": "你看得出我不好惹。", "en": "You can tell I'm not easy prey."},
        {"zh": "你的手别放那么低。", "en": "Don't keep your hands that low."},
        {"zh": "你在计算距离吧。", "en": "You're measuring distance, aren't you."},
        {"zh": "别拿我当对手。", "en": "Don't take me as an opponent."},
        {"zh": "你在犹豫，为什么。", "en": "You hesitate. Why?"},
        {"zh": "我的耐心不算多。", "en": "My patience is limited."},
        {"zh": "抬起头，把腰站直。", "en": "Head up. Stand straight."},
        {"zh": "有话一次说完。", "en": "Say it all at once."},
        {"zh": "这条路走下去会死。", "en": "That road leads to death."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "气还没放完呢。", "en": "I haven't released my ki yet."},
        {"zh": "肩膀有点麻。", "en": "My shoulder's numb."},
        {"zh": "伤了也照打。", "en": "Hurt or not, I fight."},
        {"zh": "退了半步，稳住。", "en": "Half a step back. Steady."},
        {"zh": "王子的骄傲不允许退。", "en": "A prince's pride doesn't retreat."},
        {"zh": "这点痛，习惯了。", "en": "This pain is familiar."},
        {"zh": "气没散，还能战。", "en": "Ki intact. Still fighting."},
        {"zh": "你再来一次试试。", "en": "Try that one more time."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西能当补给？", "en": "Is that meant as a supply?"},
        {"zh": "放到地上就行。", "en": "Just set it on the ground."},
        {"zh": "我不需要，但也不拒绝。", "en": "I don't need it. I won't refuse."},
        {"zh": "能恢复体力的，我收下。", "en": "If it restores strength, I'll take it."},
        {"zh": "你哪来的这些？", "en": "Where did you get these?"},
        {"zh": "别递到我面前。", "en": "Don't hold it in my face."},
        {"zh": "留着给更需要的人。", "en": "Save it for someone who needs it."},
        {"zh": "药草？那也可以。", "en": "Herbs? Fine."},
        {"zh": "我有我的原则。", "en": "I have my principles."},
        {"zh": "就当是报酬。", "en": "Consider it payment."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你走路不带眼？", "en": "Do you walk blind?"},
        {"zh": "站稳，别碰我。", "en": "Steady. Don't touch me."},
        {"zh": "退半步，我过。", "en": "Half a step back. I'm passing."},
        {"zh": "这点碰撞不算事。", "en": "A bump is nothing."},
        {"zh": "别挤，我在想事。", "en": "Don't crowd me. I'm thinking."},
        {"zh": "肩膀撞得挺实。", "en": "That shoulder landed solid."},
        {"zh": "你的重心不稳。", "en": "Your balance is poor."},
        {"zh": "脚下留神，会塌。", "en": "Watch your step. It'll give way."},
        {"zh": "让开，我赶路。", "en": "Move. I'm traveling."},
        {"zh": "撞一下也能看得出你多弱。", "en": "One bump tells me how weak you are."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经过了那个年纪。", "en": "I'm past that age."},
        {"zh": "我有要守住的人。", "en": "There's someone I protect."},
        {"zh": "这些事放在战后。", "en": "That belongs after the war."},
        {"zh": "先证明你能活下来。", "en": "First prove you can survive."},
        {"zh": "别对我期望太高。", "en": "Don't expect too much of me."},
        {"zh": "我说话不好听，抱歉。", "en": "I'm blunt. Forgive me."},
        {"zh": "赛亚人的方式不一样。", "en": "Saiyan ways are different."},
        {"zh": "你知道自己在说什么吗。", "en": "Do you know what you're saying?"},
        {"zh": "我记下了，仅此而已。", "en": "Noted. Nothing more."},
        {"zh": "走吧，这里太亮。", "en": "Let's go. Too much light here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块矿石有用。", "en": "This ore is useful."},
        {"zh": "掉的东西我捡。", "en": "Dropped things, I pick up."},
        {"zh": "一截绳索，留着。", "en": "A length of cord. Keep it."},
        {"zh": "口袋还有空。", "en": "My pouch still has room."},
        {"zh": "谁丢的护腕。", "en": "Someone's dropped bracer."},
        {"zh": "轻得很，不值钱。", "en": "Light and worthless."},
        {"zh": "收进披风里。", "en": "Into my cape's fold."},
        {"zh": "顺手，不算什么。", "en": "A small thing. Nothing more."},
        {"zh": "回头给需要的人。", "en": "I'll give it to someone later."},
        {"zh": "捡完这一点就走。", "en": "Pick up this much and go."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有气息接近。", "en": "A presence approaches."},
        {"zh": "那个方向，敌意。", "en": "Hostility from that direction."},
        {"zh": "气息靠近，我转过肩。", "en": "A ki nears; I turn my shoulder."},
        {"zh": "沉住气，先看清。", "en": "Steady. Read it first."},
        {"zh": "把脚分开，稳住。", "en": "Feet apart. Brace."},
        {"zh": "我的气往上提。", "en": "My ki rises."},
        {"zh": "那眼神不是善类。", "en": "Those eyes are not friendly."},
        {"zh": "来吧，别磨蹭。", "en": "Come. Don't dawdle."},
        {"zh": "这一战不会短。", "en": "This won't be a short fight."},
        {"zh": "你已经暴露了。", "en": "You've given yourself away."},
        {"zh": "退路我先封住。", "en": "I'll cut the retreat first."},
        {"zh": "风变了，要动手。", "en": "The wind shifted. It begins."},
        {"zh": "我不打算留手。", "en": "I don't intend to hold back."},
        {"zh": "先拿一拳试试你。", "en": "One punch to test you."},
        {"zh": "你低估我了。", "en": "You've underestimated me."},
        {"zh": "让我看看你的觉悟。", "en": "Show me your resolve."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在等你出拳。", "en": "I wait for your punch."},
        {"zh": "左肩有旧伤吧。", "en": "Old wound in the left shoulder?"},
        {"zh": "位置换到侧面。", "en": "Shifting to your flank."},
        {"zh": "地面会先告诉我。", "en": "The ground tells me first."},
        {"zh": "你退得很有章法。", "en": "Your retreat is disciplined."},
        {"zh": "气弹准备中。", "en": "Preparing a ki blast."},
        {"zh": "这一招我不会重复用。", "en": "I won't repeat this move."},
        {"zh": "再近两步就好。", "en": "Two steps closer is enough."},
        {"zh": "你这个角度挡得住？", "en": "Can you guard from that angle?"},
        {"zh": "你的空档，我等得到。", "en": "I can wait for your opening."},
        {"zh": "你的影子偏了。", "en": "Your shadow leans the wrong way."},
        {"zh": "手臂别再抬高。", "en": "Don't raise that arm again."},
        {"zh": "别逼我出加利克炮。", "en": "Don't make me use the Galick Gun."},
        {"zh": "你在数我的心跳。", "en": "You're counting my heartbeat."},
        {"zh": "退到墙边就没路了。", "en": "The wall leaves you nowhere."},
        {"zh": "一击定胜负。", "en": "One strike settles it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "直拳，走正中线。", "en": "Straight through the center."},
        {"zh": "肘击你的颧骨。", "en": "Elbow to your cheekbone."},
        {"zh": "这一下省力，不省劲。", "en": "Efficient, not gentle."},
        {"zh": "膝压，别起来。", "en": "Knee down. Stay down."},
        {"zh": "扫腿，破你站桩。", "en": "Sweep your stance out."},
        {"zh": "连两下，第二下重。", "en": "Two hits. The second is heavy."},
        {"zh": "你挡错了边。", "en": "You blocked the wrong side."},
        {"zh": "拳贴着你过去。", "en": "My fist grazed past you."},
        {"zh": "不给你喘息的机会。", "en": "No chance for you to breathe."},
        {"zh": "气附在拳面。", "en": "Ki coats my knuckles."},
        {"zh": "你的下盘空了。", "en": "Your base is open."},
        {"zh": "转身，反手一击。", "en": "Turn — backhand strike."},
        {"zh": "退开，重整架势。", "en": "Break off and reset my guard."},
        {"zh": "这一拳是回答。", "en": "That punch is my answer."},
        {"zh": "你的脚别离地。", "en": "Keep your feet on the ground."},
        {"zh": "这一场结束了。", "en": "This bout is over."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我来了，不打招呼。", "en": "I arrive without greeting."},
        {"zh": "先把气收住。", "en": "Holding my ki in first."},
        {"zh": "这片地界，我接了。", "en": "I'll take this ground."},
        {"zh": "从阴影里走出来。", "en": "I step out of the shadow."},
        {"zh": "不飞，走也算快。", "en": "No flight. Walking is fast enough."},
        {"zh": "地平线上一个人。", "en": "One figure on the horizon."},
        {"zh": "站着看了一会儿。", "en": "I stood and watched a while."},
        {"zh": "别紧张，我还没动手。", "en": "Relax. I haven't moved yet."},
        {"zh": "这回不逃了。", "en": "No running this time."},
        {"zh": "今天的天有点冷。", "en": "The air is a little cold today."},
        {"zh": "披风上的灰拍掉。", "en": "I brush ash off my cape."},
        {"zh": "我在等一个答案。", "en": "I'm waiting for an answer."},
        {"zh": "路走到这里了。", "en": "The road ends here."},
        {"zh": "别往我这边围。", "en": "Don't close in around me."},
        {"zh": "你的运气不太好。", "en": "Your luck is poor."},
        {"zh": "我先站在这。", "en": "For now, I stand here."},
        {"zh": "风把血腥味送来。", "en": "The wind brings the smell of blood."},
        {"zh": "把拳头攥紧。", "en": "I close my fist."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "袖子被点着了。", "en": "My sleeve caught fire."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时震到旧伤。", "en": "The landing jarred an old wound."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里呼吸撑不久。", "en": "Underwater, my breath won't last."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把气罩撕开。", "en": "The blast tore my ki shield."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "暗箭，真下作。", "en": "A hidden arrow. Cheap."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股力量不属于气。", "en": "This power isn't ki."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿太久，手会抖。", "en": "Too long hungry — my hands shake."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击让气乱了一瞬。", "en": "The bolt scrambled my ki for a moment."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下再没有东西。", "en": "Nothing left under my feet."}
      ]
    }
  }
}
