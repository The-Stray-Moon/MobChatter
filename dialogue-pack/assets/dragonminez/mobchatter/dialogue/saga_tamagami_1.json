    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我高过整片树林", "en": "I stand taller than the trees"},
        {"zh": "长甲拖在身后走", "en": "My long plates trail behind me"},
        {"zh": "我一步越过一条沟", "en": "One step carries me over a ditch"},
        {"zh": "我把肩上的气推开", "en": "I push the ki off my shoulders"},
        {"zh": "我踏在地面上留下坑", "en": "My tread leaves a hollow"},
        {"zh": "我从高处缓缓下压", "en": "I descend slowly from above"},
        {"zh": "风被我劈成两半", "en": "The wind splits around me"},
        {"zh": "我悬在半空平移", "en": "I slide sideways through the air"},
        {"zh": "脚下光点跟着我走", "en": "Lights trail beneath my feet"},
        {"zh": "我把挡路的岩壁撞碎", "en": "I smash through the rock wall"},
        {"zh": "我斜着掠过云层", "en": "I cut across the clouds"},
        {"zh": "我收着力落地", "en": "I touch down with my weight held"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我安静地悬在空中", "en": "I hang quietly in the air"},
