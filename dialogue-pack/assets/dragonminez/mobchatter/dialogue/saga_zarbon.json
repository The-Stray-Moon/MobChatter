      "lines": [
        {"zh": "冲击把我的护甲掀开了。", "en": "The blast pried my armor open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的肩缝。", "en": "Something lodged in my shoulder seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力缠住了我的气。", "en": "Spellwork snared my ki."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我讨厌这种虚弱感。", "en": "I detest this weakness."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击让我手指发麻。", "en": "Lightning numbed my fingers."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的世界塌了。", "en": "The world beneath me gave way."}
      ]
    }
  }
