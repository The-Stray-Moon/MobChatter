{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一格地走。", "en": "I pace one block at a time."},
        {"zh": "绿色皮肤在光下发亮。", "en": "My green skin shines in the light."},
        {"zh": "步伐很稳，很讲究。", "en": "My gait is steady and precise."},
        {"zh": "这一身力气不该浪费。", "en": "Such strength shouldn't be wasted."},
        {"zh": "风把衣摆吹到身后。", "en": "Wind pushes my hem behind me."},
        {"zh": "我看清了每一处退路。", "en": "I've noted every escape route."},
        {"zh": "慢慢来才不丢面子。", "en": "Slow is dignified."},
        {"zh": "这点距离不值一提。", "en": "This distance is nothing."},
        {"zh": "我在你的侧面走。", "en": "I walk at your flank."},
        {"zh": "气一直托着我半寸。", "en": "Ki keeps me a finger's width up."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在整理袖口。", "en": "I'm adjusting my cuffs."},
        {"zh": "站姿不能懒散。", "en": "My posture must not look sloppy."},
        {"zh": "我从不显得匆忙。", "en": "I never appear hurried."},
        {"zh": "这点小事不值得动手。", "en": "This trifle isn't worth my hand."},
        {"zh": "气息平稳，心也平。", "en": "Steady breath, steady mind."},
        {"zh": "这里的空气不清楚。", "en": "The air here isn't clean."},
        {"zh": "我在等合适的时机。", "en": "I'm waiting for the right moment."},
        {"zh": "我抬手理了下头发。", "en": "I smooth my hair."},
        {"zh": "这份从容不是装出来的。", "en": "This composure isn't an act."},
        {"zh": "看一眼就足够了。", "en": "One glance is enough."},
        {"zh": "我不喜欢脏手。", "en": "I dislike dirty hands."},
        {"zh": "肌肉没有一丝多余。", "en": "Not an ounce of wasted muscle."},
        {"zh": "我听着远处的动静。", "en": "I listen to the distant noise."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你这种下级也敢直视我。", "en": "A lower being like you dares meet my eyes."},
        {"zh": "我的战斗力是两万三。", "en": "My power level is twenty-three thousand."},
        {"zh": "你连我的一招都接不住。", "en": "You couldn't take a single move."},
        {"zh": "站远一点，别弄脏衣服。", "en": "Stand back; don't dirty my clothes."},
        {"zh": "我看你像是有点本事。", "en": "You seem to have some skill."},
        {"zh": "你的气乱得很。", "en": "Your ki is a mess."},
        {"zh": "我出手前会先给你机会。", "en": "I'll give you a chance before I strike."},
        {"zh": "别以为沉默就显得勇敢。", "en": "Silence doesn't make you brave."},
        {"zh": "我看你眼睛就知道你在怕。", "en": "Your eyes tell me you're afraid."},
        {"zh": "这份从容你学不来。", "en": "You can't learn this composure."},
        {"zh": "你身上的伤是怎么回事？", "en": "Where did those wounds come from?"},
        {"zh": "我不喜欢重复两遍。", "en": "I don't like repeating myself."},
        {"zh": "你说话的语气要注意。", "en": "Mind your tone."},
        {"zh": "我给你三秒钟。", "en": "I'll give you three seconds."},
        {"zh": "你这种人总是不懂分寸。", "en": "Your kind never knows its place."},
        {"zh": "我笑是因为觉得可笑。", "en": "I smile because it's laughable."},
        {"zh": "你的武器太粗糙。", "en": "Your weapon is crude."},
        {"zh": "我不打算解释我自己。", "en": "I don't intend to explain myself."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你竟敢对我动手。", "en": "You dare."},
        {"zh": "这拳总算有点分量。", "en": "That had some weight."},
        {"zh": "我不习惯这种疼。", "en": "I'm not used to this pain."},
        {"zh": "血沾上了我的领口。", "en": "Blood stains my collar."},
        {"zh": "嘴角破了，我笑得更狠。", "en": "My lip split; I grin harder."},
        {"zh": "这笔账要用命来还。", "en": "This will be paid with a life."},
        {"zh": "这点擦伤，还配让我认真？", "en": "A graze like that doesn't deserve my effort."},
        {"zh": "等我变身，你就不会这么得意。", "en": "Wait until I transform—you won't be so pleased."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这种东西我不吃。", "en": "I don't eat such things."},
        {"zh": "弗利萨大人的命令，不是食物。", "en": "Lord Frieza's orders come before food."},
        {"zh": "这味道很廉价。", "en": "That smell is cheap."},
        {"zh": "你拿它对付我？", "en": "You'd use that on me?"},
        {"zh": "在弗利萨军里我吃得比这好。", "en": "I ate better in Frieza's army."},
        {"zh": "放下吧，别举着。", "en": "Set it down; stop holding it up."},
        {"zh": "我对这个没兴趣。", "en": "I'm not interested."},
        {"zh": "你要是饿，就自己吃。", "en": "If you're hungry, eat it yourself."},
        {"zh": "这种手段不合适。", "en": "That's an unsuitable tactic."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "这点冲量不算什么。", "en": "That momentum is nothing."},
        {"zh": "我连衣角都没乱。", "en": "Not even my hem is disturbed."},
        {"zh": "你踩脏了我的靴子。", "en": "You scuffed my boot."},
        {"zh": "我们保持这个距离。", "en": "Let's keep this distance."},
        {"zh": "你撞得太用力了。", "en": "You hit too hard."},
        {"zh": "我不喜欢被碰到。", "en": "I dislike being touched."},
        {"zh": "这一步我让给你。", "en": "I'll yield this step to you."},
        {"zh": "再来一次就轮到我。", "en": "Once more and it's my turn."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个话题不合时宜。", "en": "This topic is inappropriate."},
        {"zh": "你说话前该想想身份。", "en": "Consider your station before you speak."},
        {"zh": "我不和下级谈这些。", "en": "I don't discuss such things with inferiors."},
        {"zh": "我会当作没听见。", "en": "I'll pretend I didn't hear."},
        {"zh": "这份从容不适合被打断。", "en": "This composure shouldn't be interrupted."},
        {"zh": "这不是你该问的。", "en": "That isn't yours to ask."},
        {"zh": "我对此毫无兴趣。", "en": "I have no interest in it."},
        {"zh": "你已经越界了。", "en": "You've overstepped."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用手帕隔着拿。", "en": "I take it through a handkerchief."},
        {"zh": "这是谁的破烂？", "en": "Whose junk is this?"},
        {"zh": "不值得我弯腰。", "en": "Not worth bending for."},
        {"zh": "它落在我的靴边。", "en": "It fell by my boot."},
        {"zh": "脏东西，丢远点。", "en": "Filthy thing; throw it farther."},
        {"zh": "我拎起来看一眼。", "en": "I lift it for a look."},
        {"zh": "我把它递给旁边的人。", "en": "I hand it to whoever's nearby."},
        {"zh": "这种成色没有价值。", "en": "This quality has no value."},
        {"zh": "你掉的？拿回去。", "en": "Yours? Take it back."},
        {"zh": "我看过就放下。", "en": "I look, then set it down."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你成功让我不悦了。", "en": "You've managed to displease me."},
        {"zh": "到此为止，你走不了了。", "en": "This far and no further. You cannot leave."},
        {"zh": "我最讨厌被浪费的时间。", "en": "I hate wasted time most."},
        {"zh": "你的位置我记得清清楚楚。", "en": "I've noted your position exactly."},
        {"zh": "气聚在我的指尖上。", "en": "Ki gathers at my fingertip."},
        {"zh": "一下就足够解决。", "en": "One strike is enough."},
        {"zh": "我不喜欢第二遍。", "en": "I don't like doing things twice."},
        {"zh": "你既然动手，就别后悔。", "en": "Since you struck, don't regret it."},
        {"zh": "这个距离太近了。", "en": "This distance is too close."},
        {"zh": "我出手很干净。", "en": "I strike cleanly."},
        {"zh": "别退，我追得快。", "en": "Don't retreat; I'm fast."},
        {"zh": "我已经数完了。", "en": "I've finished counting."},
        {"zh": "你不该站在那儿。", "en": "You shouldn't have stood there."},
        {"zh": "这次不和你客气。", "en": "No courtesy this time."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "等我变身，你连样子都认不出。", "en": "Once I transform, you will not recognize me."},
        {"zh": "你退得越多，我越好打。", "en": "The more you retreat, the easier you are."},
        {"zh": "你的气已经不稳定了。", "en": "Your ki is already unstable."},
        {"zh": "这个角度我占优。", "en": "I have the advantage at this angle."},
        {"zh": "你别想绕到背后。", "en": "Don't think about circling behind me."},
        {"zh": "我的护甲不需要格挡。", "en": "My armor needs no guard."},
        {"zh": "再近一点就会碰到我。", "en": "A bit closer and you'll touch me."},
        {"zh": "我从容，不代表我慢。", "en": "Composed doesn't mean slow."},
        {"zh": "你的指尖已经开始抖了。", "en": "Your hand is shaking."},
        {"zh": "我在等你自己送上来。", "en": "I'm waiting for you to come to me."},
        {"zh": "你的退路只剩一条。", "en": "You have one escape route left."},
        {"zh": "我不需要加速。", "en": "I don't need to speed up."},
        {"zh": "这一击我留了余量。", "en": "I've left margin in this blow."},
        {"zh": "你还有最后一句。", "en": "You have one last sentence."},
        {"zh": "我要用变身了。", "en": "I'm about to transform."},
        {"zh": "那样就不必留手了。", "en": "Then I won't need to hold back."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一击，干净利落。", "en": "One clean strike."},
        {"zh": "手刀落在你的肩上。", "en": "My knife hand lands on your shoulder."},
        {"zh": "你的防御已经碎了。", "en": "Your defense is broken."},
        {"zh": "我推你一把就够了。", "en": "A push from me is enough."},
        {"zh": "这一下是教训。", "en": "This blow is a lesson."},
        {"zh": "膝盖顶在你腹上。", "en": "My knee drives into your gut."},
        {"zh": "气弹在你脚边开了。", "en": "A ki blast opens at your feet."},
        {"zh": "你的姿势全散了。", "en": "Your form is completely broken."},
        {"zh": "我用了一半力气。", "en": "I used half my strength."},
        {"zh": "别让我再来一次。", "en": "Don't make me do it again."},
        {"zh": "肘击接上一记掌击。", "en": "Elbow, then palm."},
        {"zh": "你飞出去了几格。", "en": "You flew several blocks."},
        {"zh": "尘土落在你的衣服上。", "en": "Dust settles on your clothes."},
        {"zh": "这一场不值得我出力。", "en": "This fight isn't worth my effort."},
        {"zh": "我还没有尽兴。", "en": "I'm not satisfied yet."},
        {"zh": "自己给我站起来。", "en": "Get up."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这地方还算干净。", "en": "This place is passable."},
        {"zh": "我先看看周围。", "en": "Let me survey the surroundings."},
        {"zh": "战斗力读数很低。", "en": "The power readings are low."},
        {"zh": "我是被派来的。", "en": "I was sent here."},
        {"zh": "风里没有水气。", "en": "There is no moisture in this wind."},
        {"zh": "衣服没有沾到土。", "en": "My clothes haven't touched dirt."},
        {"zh": "先把站姿摆好。", "en": "Set the posture first."},
        {"zh": "我的气一直很稳。", "en": "My ki is steady."},
        {"zh": "有一两个能打的。", "en": "One or two might be worth fighting."},
        {"zh": "先让他们自己过来。", "en": "Let them come to me."},
        {"zh": "这个星球很单调。", "en": "This planet is dull."},
        {"zh": "我抬手试了试气。", "en": "I raise a hand to test my ki."},
        {"zh": "我已经到了这里。", "en": "I'm here."},
        {"zh": "别让我在这儿站太久。", "en": "Don't keep me waiting."},
        {"zh": "这点尘土不值得在意。", "en": "This dust isn't worth noting."},
        {"zh": "在我的计算里没有意外。", "en": "There are no surprises in my calculations."},
        {"zh": "这副皮囊，该换一换了。", "en": "Time to change this skin of mine."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我手臂，我皱眉。", "en": "Fire caught my arm; I frown."}
      ]
    },
