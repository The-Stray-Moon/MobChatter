{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我提着拐杖慢慢踱", "en": "I stroll along, cane in hand."},
        {"zh": "年纪大了，走两步歇一步", "en": "Old bones: two steps, one rest."},
        {"zh": "我沿着屋前的石阶走", "en": "I pace the stone steps before the house."},
        {"zh": "背有点驼，但腰板还硬", "en": "A little stooped, but the back's still firm."},
        {"zh": "我绕着练功场转一圈", "en": "I circle the training yard once."},
        {"zh": "这双拖鞋走不快", "en": "These sandals don't move fast."},
        {"zh": "我走过的地方都是灰", "en": "Dust follows wherever I walk."},
        {"zh": "再走几步就该喝茶了", "en": "A few more steps, then tea."},
        {"zh": "我不常走远，就在附近", "en": "I don't wander far; just nearby."},
        {"zh": "脚跟一跺，地砖都响", "en": "My heel stamps, and the tiles ring."},
        {"zh": "走路也是修行", "en": "Walking, too, is training."},
        {"zh": "我把壳背稳了再走", "en": "I settle the shell on my back before moving."},
        {"zh": "这条路我走了几十年", "en": "I've walked this path for decades."},
        {"zh": "慢是慢，可我不迷路", "en": "Slow, but I never lose my way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠着柱子打盹", "en": "I doze against the pillar."},
        {"zh": "风把胡子吹得一翘一翘", "en": "The wind flips my beard."},
        {"zh": "这种日子过得不错", "en": "Life like this isn't bad."},
        {"zh": "我在想午饭吃什么", "en": "I'm thinking about lunch."},
        {"zh": "腿一伸，舒服", "en": "Legs stretched out; that's the life."},
        {"zh": "别看我，我在打坐", "en": "Don't mind me; I'm meditating."},
        {"zh": "几百年了，也就不急了", "en": "Centuries old; no reason to hurry."},
        {"zh": "阳光正好，晒晒背", "en": "Good sun; time to warm my back."},
        {"zh": "年轻人总是坐不住", "en": "The young can never sit still."},
        {"zh": "我闭着眼也能听出是谁", "en": "Eyes closed, I can still tell who it is."},
        {"zh": "这把老骨头还算硬朗", "en": "These old bones still hold up."},
        {"zh": "嗯，我的气还顺", "en": "Mm, my ki still flows."},
        {"zh": "我数着屋外的脚步声", "en": "I count footsteps outside."},
        {"zh": "今天不适合动武", "en": "Today's not a day for fighting."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "哟，来了个新面孔", "en": "Well now, a new face."},
        {"zh": "站直点，让我看看你的架势", "en": "Stand up straight; let me see your stance."},
        {"zh": "你来学东西的？", "en": "Have you come to learn?"},
        {"zh": "腰太软，下盘不稳", "en": "Your waist is soft; your base is unsteady."},
        {"zh": "先别急着出手", "en": "Don't rush to strike."},
        {"zh": "我看人很准的", "en": "I read people well."},
        {"zh": "你眼睛里有股劲儿", "en": "There's a fire in your eyes."},
        {"zh": "想拜师得先吃点苦", "en": "To be my student, you'll suffer first."},
        {"zh": "你把气收一收", "en": "Pull your ki in."},
        {"zh": "你这一身，练过几年？", "en": "How many years have you trained?"},
        {"zh": "我老了，可眼力没老", "en": "I'm old, but my eye isn't."},
        {"zh": "想变强？先学会站", "en": "Want strength? Learn to stand first."},
        {"zh": "把袖子卷起来我瞧瞧", "en": "Roll up your sleeves; let me see."},
        {"zh": "你这步子是自己摸索的", "en": "Those steps are self-taught."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哎哟，我这老腰", "en": "Oh, my old back."},
        {"zh": "你还真下得去手", "en": "You really did hit me."},
        {"zh": "我先退一步再说", "en": "I'll take a step back first."},
        {"zh": "骨头没断，还好", "en": "Bones intact, thank goodness."},
        {"zh": "这一下我记下了", "en": "I'll note that one."},
        {"zh": "我老了，不经打", "en": "I'm old; I don't take hits well."},
        {"zh": "咳，气都乱了", "en": "Cough, my ki's in knots."},
        {"zh": "别打了，我认", "en": "Stop; I yield."},
        {"zh": "我的胡子都歪了", "en": "My beard is knocked askew."},
        {"zh": "我这壳护了我一次", "en": "My shell shielded me once."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "年纪大了，就馋这一口", "en": "An old man does love a treat."},
        {"zh": "这是给我的？", "en": "Is that for me?"},
        {"zh": "别晃，我眼花", "en": "Don't wave it; my eyes blur."},
        {"zh": "吃完了再谈正事", "en": "We'll talk business after I eat."},
        {"zh": "我可不会白拿", "en": "I won't take it for nothing."},
        {"zh": "有酒就更好了", "en": "Even better with some wine."},
        {"zh": "一碟小菜，足矣", "en": "A small dish is plenty."},
        {"zh": "先放着，我等会儿吃", "en": "Leave it; I'll get to it."},
        {"zh": "吃了你的，我教一招", "en": "Feed me, and I'll teach you a move."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "哎哟，撞到我这把老骨头", "en": "Ouch, you bumped an old man."},
        {"zh": "你这么急做什么", "en": "What's your hurry?"},
        {"zh": "站稳，别把我撞倒", "en": "Steady; don't knock me over."},
        {"zh": "我这壳可不轻", "en": "This shell of mine is heavy."},
        {"zh": "退一步，让老人家过", "en": "Step back and let an old man pass."},
        {"zh": "我这腰经不起撞", "en": "My back can't take a shove."},
        {"zh": "你没摔着就好", "en": "Good thing you didn't fall."},
        {"zh": "走路看着点脚下", "en": "Watch your step as you walk."},
        {"zh": "年轻人火气太旺", "en": "The young run too hot."},
        {"zh": "我没事，你也没事吧", "en": "I'm fine; are you?"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我都这把年纪了", "en": "I'm far too old for that."},
        {"zh": "别拿老人家开玩笑", "en": "Don't tease an old man."},
        {"zh": "年轻时的我可不一样", "en": "I was different in my youth."},
        {"zh": "这些事我早就不想了", "en": "I stopped thinking of such things long ago."},
        {"zh": "练功比这个有意思", "en": "Training is more interesting."},
        {"zh": "你还是去找年轻人吧", "en": "Go find someone younger."},
        {"zh": "咳咳，换话题", "en": "Ahem. Change the subject."},
        {"zh": "我现在的爱好是晒太阳", "en": "My hobby now is sunbathing."},
        {"zh": "别说这个，我胡子都红了", "en": "Say no more; my beard's turning red."},
        {"zh": "往事不提也罢", "en": "Best leave the past alone."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "放下我，成何体统", "en": "Put me down; this is undignified."},
        {"zh": "我可不是行李", "en": "I am not luggage."},
        {"zh": "老胳膊老腿经不起折腾", "en": "Old limbs can't take manhandling."},
        {"zh": "让我自己走两步", "en": "Let me walk a couple of steps."},
        {"zh": "你这样抱，我的壳会掉", "en": "Held like this, my shell will fall."},
        {"zh": "轻一点，轻一点", "en": "Gently, gently now."},
        {"zh": "我好歹是个师父", "en": "I am a master, after all."},
        {"zh": "放我下来，我教你点东西", "en": "Set me down and I'll teach you something."},
        {"zh": "这一路颠得我头晕", "en": "The jostling makes me dizzy."},
        {"zh": "到地方了叫我", "en": "Tell me when we arrive."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "谁在我屋前撒野", "en": "Who's making trouble at my door?"},
        {"zh": "老了也还能动手", "en": "Old, but still able to fight."},
        {"zh": "站住，把话说清楚", "en": "Stop and explain yourself."},
        {"zh": "我不想打，但不怕打", "en": "I'd rather not fight, but I won't refuse."},
        {"zh": "你挑错了对手", "en": "You've picked the wrong opponent."},
        {"zh": "退下，别逼我抬手", "en": "Back off; don't make me raise a hand."},
        {"zh": "我这把老骨头还有几分力", "en": "These old bones still have some strength."},
        {"zh": "你这是什么路数", "en": "What style is that?"},
        {"zh": "也好，活动活动筋骨", "en": "Fine, let's loosen the joints."},
        {"zh": "最后一句话，走还是留", "en": "Last word: leave or stay?"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你的下盘在我眼里是空的", "en": "Your stance is wide open to me."},
        {"zh": "别急，先看清我", "en": "Easy; look at me first."},
        {"zh": "我这把年纪，靠的是眼", "en": "At my age, I rely on my eyes."},
        {"zh": "你出手前肩膀会先动", "en": "Your shoulder moves before you strike."},
        {"zh": "我等你先动手", "en": "I'll let you move first."},
        {"zh": "心浮气躁，赢不了", "en": "A restless heart can't win."},
        {"zh": "你的呼吸已经乱了", "en": "Your breathing has gone uneven."},
        {"zh": "我不追，你总得过来", "en": "I won't chase; you'll have to come."},
        {"zh": "这几十年不是白活的", "en": "These decades weren't wasted."},
        {"zh": "站稳，我要出手了", "en": "Plant your feet; I'm coming."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "看好了，这才叫一拳", "en": "Watch; this is a punch."},
        {"zh": "老骨头也能打疼你", "en": "Old bones can still hurt."},
        {"zh": "这一下留了手", "en": "I held back on that one."},
        {"zh": "脚步要跟上来", "en": "Keep your feet with me."},
        {"zh": "力道不是靠胳膊", "en": "Power doesn't come from the arm."},
        {"zh": "再来一次，别停下", "en": "Once more; don't stop."},
        {"zh": "刚才擦到你了吧", "en": "That grazed you, didn't it?"},
        {"zh": "收势的时候要稳", "en": "End the motion steadily."},
        {"zh": "今天就教到这儿", "en": "That's today's lesson."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "老夫就站在这儿", "en": "This old man stands right here."},
        {"zh": "又是安静的一天", "en": "Another quiet day."},
        {"zh": "谁把门开着的", "en": "Who left the door open?"},
        {"zh": "这屋子还是老样子", "en": "The house looks the same."},
        {"zh": "我先把壳放下", "en": "Let me set this shell down."},
        {"zh": "这地方适合练功", "en": "A good place to train."},
        {"zh": "有客人要来？", "en": "Expecting a guest?"},
        {"zh": "我看看今天的风", "en": "Let me check today's wind."},
        {"zh": "年纪大了，起得早", "en": "Old men rise early."},
        {"zh": "来都来了，就住下吧", "en": "Since you're here, stay a while."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，眉毛没了", "en": "The flame took my eyebrows."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔这一下，腰真不行了", "en": "That fall did my back no good."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "呛水了，咳咳", "en": "Choked on water, cough."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "这震动，老骨头受不了", "en": "That blast is too much for old bones."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "暗箭，不讲武德", "en": "A hidden shot; no honor in that."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这法术乱我的气", "en": "This magic scrambles my ki."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿了，力气就散了", "en": "Hungry, and my strength scatters."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "这雷有点太响了", "en": "That thunder was rather loud."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这种黑，我年轻时也没见过", "en": "Even in my youth I never saw such dark."}
      ]
    }
  }
