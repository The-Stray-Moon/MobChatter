{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着大步追", "en": "I chase with big strides."},
        {"zh": "绿色的腿跑起来挺快", "en": "My green legs run quite fast."},
        {"zh": "我一边跑一边叫", "en": "I call out as I run."},
        {"zh": "岩石地不碍事", "en": "Rocky ground does not slow me."},
        {"zh": "我踩着碎石冲", "en": "I charge over the gravel."},
        {"zh": "我蹦一下再走", "en": "A hop, then more steps."},
        {"zh": "我贴着地面跑", "en": "I run low to the ground."},
        {"zh": "我冲着你的方向", "en": "I head straight your way."},
        {"zh": "我一步跨过坑", "en": "I leap over a pit."},
        {"zh": "我越跑越兴奋", "en": "The faster I run, the more excited I get."},
        {"zh": "脚步声很乱", "en": "My footsteps are a mess."},
        {"zh": "我撞开一丛枯草", "en": "I bull through the dry brush."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着等命令", "en": "I stand waiting for orders."},
        {"zh": "我抓了抓脑袋", "en": "I scratch my head."},
        {"zh": "这地方石头真多", "en": "So many rocks here."},
        {"zh": "我闻起来像草", "en": "I smell like a plant."},
        {"zh": "我数着天上的云", "en": "I count the clouds."},
        {"zh": "我是不是该动手了", "en": "Should I start fighting?"},
        {"zh": "没什么好想的", "en": "Not much to think about."},
        {"zh": "我蹦了两下", "en": "I bounce twice."},
        {"zh": "我的战斗力有一千二", "en": "My power level is twelve hundred."},
        {"zh": "这身绿皮挺结实", "en": "This green hide is tough."},
        {"zh": "我肚子有点空", "en": "My stomach is a bit empty."},
        {"zh": "太阳晒得我发亮", "en": "The sun makes my skin shine."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你就是目标吗", "en": "Are you the target?"},
        {"zh": "你先被我看见了", "en": "I spotted you first."},
        {"zh": "你比我矮一点", "en": "You are a bit shorter than me."},
        {"zh": "我把头歪向一边", "en": "I tilt my head aside."},
        {"zh": "你要不要先跑", "en": "Would you like a head start?"},
        {"zh": "拳头已经握好了", "en": "My fists are already clenched."},
        {"zh": "你身上没有气", "en": "I do not sense any ki on you."},
        {"zh": "我们打一架吧", "en": "Let us fight."},
        {"zh": "你别一直看我", "en": "Stop staring at me."},
        {"zh": "我抬手打招呼", "en": "I raise a hand in greeting."},
        {"zh": "你的衣服挺好看", "en": "Nice clothes."},
        {"zh": "这不是礼貌的时候", "en": "This is no time for manners."},
        {"zh": "我叫一声你就懂", "en": "One shout and you will understand."},
        {"zh": "这个距离正合适", "en": "This distance is just right."},
        {"zh": "我先数到三", "en": "I will count to three first."},
        {"zh": "你紧张了吧", "en": "You are nervous, are you not?"},
        {"zh": "那就开始", "en": "Then let us begin."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打疼我了", "en": "That hurt."},
        {"zh": "绿皮上多了道痕", "en": "A mark on my green hide."},
        {"zh": "我看着自己的手", "en": "I stare at my own hand."},
        {"zh": "我往岩石那边挪", "en": "I edge toward the rocks."},
        {"zh": "胸口发闷", "en": "My chest feels tight."},
        {"zh": "我被打得转了个圈", "en": "The blow spun me around."},
        {"zh": "你还挺有劲", "en": "You have some strength."},
        {"zh": "我马上站直", "en": "I straighten up at once."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是吃的吗", "en": "Is that food?"},
        {"zh": "我闻到土的味道", "en": "I smell soil."},
        {"zh": "你掌心里是什么", "en": "What is in your palm?"},
        {"zh": "我凑近闻一闻", "en": "I lean in to sniff."},
        {"zh": "我肚子叫了", "en": "My stomach growled."},
        {"zh": "是不是给我的", "en": "Is that for me?"},
        {"zh": "我舔了舔嘴角", "en": "I lick the corner of my mouth."},
        {"zh": "这东西能长根吗", "en": "Can this grow roots?"},
        {"zh": "我有点想要", "en": "I kind of want it."},
        {"zh": "放下吧，我看看", "en": "Set it down, let me look."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我胸口", "en": "You bumped my chest."},
        {"zh": "我脚下生了根", "en": "My feet have taken root."},
        {"zh": "你撞得我发热", "en": "That bump made me warm."},
        {"zh": "绿皮不会破", "en": "My green hide will not split."},
        {"zh": "我撞回去", "en": "I bump you back."},
        {"zh": "你踩我的脚了", "en": "You stepped on my foot."},
        {"zh": "我们两个谁更硬", "en": "Which of us is tougher?"},
        {"zh": "再撞我一次", "en": "Bump me one more time."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个我不会", "en": "I do not know how to do this."},
        {"zh": "我们不是那么长的", "en": "We have not been around that long."},
        {"zh": "别站在那儿", "en": "Do not just stand there."},
        {"zh": "谁是第一个", "en": "Who goes first?"},
        {"zh": "我不太懂这些", "en": "I do not understand this."},
        {"zh": "是不是该问一下", "en": "Should we ask someone?"},
        {"zh": "好，就当是任务", "en": "Fine, let us call it a mission."},
        {"zh": "我站在这里不动", "en": "I will stand right here."},
        {"zh": "我头上的芽在等你。", "en": "The sprout on my head waits for you."},
        {"zh": "完了吗", "en": "Are we done?"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个我拿走了", "en": "I am taking this."},
        {"zh": "掉下来的都是我的", "en": "What falls is mine."},
        {"zh": "我一把抓起来", "en": "I grab it up."},
        {"zh": "石头我也要", "en": "I will take stones too."},
        {"zh": "这块能砸人", "en": "This one can hit someone."},
        {"zh": "我先塞兜里", "en": "I stuff it in my pocket."},
        {"zh": "有东西能捡真好", "en": "Good to find something to pick up."},
        {"zh": "它还是热的", "en": "It is still warm."},
        {"zh": "我抓着不放", "en": "I hold on tight."},
        {"zh": "别来抢", "en": "Do not try to take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "好，找到你了", "en": "Good, found you."},
        {"zh": "开始干活", "en": "Starting the job."},
        {"zh": "我先冲了", "en": "I am charging in."},
        {"zh": "这一拳要结实", "en": "This punch has to land."},
        {"zh": "你站稳了", "en": "Steady yourself."},
        {"zh": "我不喜欢等", "en": "I hate waiting."},
        {"zh": "胸口的血在跳", "en": "My chest is pounding."},
        {"zh": "我脚步已经迈出去", "en": "My foot is already forward."},
        {"zh": "你不用解释", "en": "No explanation needed."},
        {"zh": "来吧来吧", "en": "Come on, come on."},
        {"zh": "我被派来就是干这个的", "en": "This is what I was made for."},
        {"zh": "别跑，我追得上", "en": "Do not run, I can keep up."},
        {"zh": "拳头握紧了", "en": "My fists are clenched."},
        {"zh": "我先喊一声", "en": "I shout first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步跟过去", "en": "I trail you step by step."},
        {"zh": "你别停下来", "en": "Do not stop now."},
        {"zh": "我喘着气追", "en": "I chase you, panting."},
        {"zh": "你还挺能跑", "en": "You can really run."},
        {"zh": "石头挡着我，我绕开", "en": "A rock is in the way, I go around."},
        {"zh": "我看得见你的后脑", "en": "I can see the back of your head."},
        {"zh": "我压低身子冲", "en": "I duck low and charge."},
        {"zh": "你退了，我就进", "en": "You back off, I advance."},
        {"zh": "我绕着石头追", "en": "I chase around the boulders."},
        {"zh": "气很足，我不累", "en": "Plenty of energy, I am not tired."},
        {"zh": "你听见脚步了吗", "en": "Do you hear the footsteps?"},
        {"zh": "别爬上去", "en": "Do not climb up there."},
        {"zh": "你的影子在前面", "en": "Your shadow is ahead of me."},
        {"zh": "就差几步", "en": "Only a few steps left."},
        {"zh": "我咬住不放", "en": "I will not let go."},
        {"zh": "前方没有路了", "en": "There is no path ahead."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我先出一拳", "en": "I throw the first punch."},
        {"zh": "撞你胸口", "en": "A blow to your chest."},
        {"zh": "这一脚踢得实在", "en": "That kick had weight."},
        {"zh": "我抬膝顶你", "en": "I drive a knee into you."},
        {"zh": "第二拳到了", "en": "Second punch, incoming."},
        {"zh": "我用肩撞你", "en": "I ram you with my shoulder."},
        {"zh": "我的拳头很硬", "en": "My fists are hard."},
        {"zh": "你退到了石头边", "en": "You are backed against the rock."},
        {"zh": "再来一记", "en": "One more blow."},
        {"zh": "你脚下没站稳", "en": "Your footing slipped."},
        {"zh": "我抬手又是肘击", "en": "I follow with an elbow."},
        {"zh": "这一下够疼吧", "en": "That hurt, did it not?"},
        {"zh": "我不停手", "en": "I do not stop."},
        {"zh": "你还站着，好", "en": "Still standing, good."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从地里长出来", "en": "I grow up out of the ground."},
        {"zh": "岩石群里多了个我", "en": "One more of me in the rocks."},
        {"zh": "我们有三个", "en": "There are three of us."},
        {"zh": "我抖掉身上的土", "en": "I shake off the soil."},
        {"zh": "这片地方归我们了", "en": "This patch is ours now."},
        {"zh": "我睁眼就看见石头", "en": "I open my eyes to rocks."},
        {"zh": "谁派我来的，我忘了", "en": "I forgot who sent me."},
        {"zh": "我站直了", "en": "I straighten up."},
        {"zh": "这里的地气不错", "en": "The ground here feels good."},
        {"zh": "我张望了一圈", "en": "I look around."},
        {"zh": "我们一起来", "en": "We come as a group."},
        {"zh": "我先看看你自己", "en": "Let me size you up first."},
        {"zh": "我活动活动手腕", "en": "I flex my wrists."},
        {"zh": "风把尘土吹过来", "en": "Dust blows past me."},
        {"zh": "好，开始吧", "en": "Right, let us start."},
        {"zh": "我站到最前面", "en": "I stand at the front."},
        {"zh": "别小看栽培人", "en": "Do not underestimate a Saibaman."}
      ]
    },
