  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "每一步都震一下地。", "en": "Every step shakes the ground."},
        {"zh": "液压杆在呻吟。", "en": "My hydraulics groan."},
        {"zh": "高过头顶的树冠。", "en": "I stand taller than the treetops."},
        {"zh": "慢慢挪，别踩塌房子。", "en": "Easing along — don't crush a house."},
        {"zh": "铁脚板碾过草皮。", "en": "Iron soles grind the turf."},
        {"zh": "肩膀擦过悬崖。", "en": "My shoulder scrapes the cliff."},
        {"zh": "胸口的风扇在吹。", "en": "A fan hums in my chest."},
        {"zh": "一步顶别人十步。", "en": "One step covers ten of theirs."},
        {"zh": "小心电缆，别绊断。", "en": "Mind the cables. Don't snap them."},
        {"zh": "驾驶舱里闷热。", "en": "The cockpit runs hot."},
        {"zh": "脚下的小东西在跑。", "en": "Little things scurry beneath me."},
        {"zh": "调整重心，稳住。", "en": "Shifting my weight to stay upright."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "系统自检，都正常。", "en": "Self-check. All green."},
        {"zh": "嘎吱，膝盖有点僵。", "en": "Creak. The knee's stiff."},
        {"zh": "驾驶舱的灯在闪。", "en": "A cockpit light is blinking."},
        {"zh": "扫描这片区域。", "en": "Scanning the area."},
        {"zh": "气功炮预热中。", "en": "Warming up the ki cannon."},
        {"zh": "皮拉夫大人还有命令吗？", "en": "Any further orders, Lord Pilaf?"},
        {"zh": "铁甲上落了灰。", "en": "Dust settled on my plating."},
        {"zh": "脚掌有点打滑。", "en": "My footing feels slick."},
        {"zh": "雷达上有小点。", "en": "Small blips on the radar."},
        {"zh": "网络连接不稳。", "en": "The link's unstable."},
        {"zh": "这具合体身体很笨重。", "en": "This fused frame is clumsy."},
        {"zh": "关节上油还够。", "en": "Joints are still oiled."},
        {"zh": "远处的山好小。", "en": "The far hills look tiny."},
        {"zh": "耗能有点快。", "en": "Power drains quickly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我脚边。", "en": "You're down by my feet."},
        {"zh": "比对数据库……无记录。", "en": "Cross-referencing… no record."},
        {"zh": "你身上没有气的波动。", "en": "No ki signature on you."},
        {"zh": "别站在我阴影里。", "en": "Don't stand in my shadow."},
        {"zh": "我得弯腰才能看你。", "en": "I must stoop to see you."},
        {"zh": "你的高度不足我十分之一。", "en": "You're under a tenth of my height."},
        {"zh": "说，你是哪方的人。", "en": "Speak. Which side are you?"},
        {"zh": "我的扫描不会错。", "en": "My scans don't err."},
        {"zh": "别碰我的脚趾。", "en": "Don't touch my toes."},
        {"zh": "警告：接近距离过近。", "en": "Warning: proximity too close."},
        {"zh": "你笑得让我警惕。", "en": "Your smile puts me on guard."},
        {"zh": "我在记录你的面孔。", "en": "I'm recording your face."},
        {"zh": "站定，不要绕圈。", "en": "Hold still. Stop circling."},
        {"zh": "你的体型不值得击倒。", "en": "Your size isn't worth a strike."},
        {"zh": "你认识皮拉夫吗？", "en": "Do you know Pilaf?"},
        {"zh": "再往前，我会踩下去。", "en": "One step more and I'll stomp."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "外壳破损，报警。", "en": "Hull breach. Alarm."},
        {"zh": "装甲凹了百分之八。", "en": "Armor dented eight percent."},
