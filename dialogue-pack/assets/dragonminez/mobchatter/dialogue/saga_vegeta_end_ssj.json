{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "金发像火一样晃。", "en": "My gold hair flickers like fire."},
        {"zh": "气在脚下浮着走。", "en": "Ki floats me along."},
        {"zh": "每一步都压着地面。", "en": "Each step presses the ground."},
        {"zh": "靴子踩得岩石开裂。", "en": "My boots crack the stone."},
        {"zh": "眼前的草被吹向两边。", "en": "Grass parts on both sides of me."},
        {"zh": "慢慢来，先让他急。", "en": "Slow. Let him get impatient."},
        {"zh": "眉骨上有汗。", "en": "Sweat on my brow ridge."},
        {"zh": "转过这道山脊。", "en": "Rounding this ridge."},
        {"zh": "离他还有三十步。", "en": "Thirty paces between us."},
        {"zh": "调整出拳的角度。", "en": "Adjusting my punching angle."},
        {"zh": "风声被我的气盖过。", "en": "My aura swallows the wind."},
        {"zh": "脚步越来越轻。", "en": "My steps grow lighter."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "这姿态很难维持。", "en": "Holding this form costs me."},
        {"zh": "肌肉在发热。", "en": "My muscles run hot."},
        {"zh": "金气一圈圈转。", "en": "Golden ki circles me."},
        {"zh": "我压着怒气。", "en": "I hold my temper down."},
        {"zh": "眼白有点刺。", "en": "My eyes sting faintly."},
        {"zh": "把力道收在肩后。", "en": "Power coiled behind my shoulders."},
        {"zh": "不快，但很难打中。", "en": "Not faster — harder to hit."},
        {"zh": "指尖在发麻。", "en": "My fingertips tingle."},
        {"zh": "参差的呼吸。", "en": "My breathing comes ragged."},
        {"zh": "脚下的石头在颤。", "en": "The stones tremble beneath me."},
        {"zh": "我记得变身的代价。", "en": "I remember what this form costs."},
        {"zh": "气息还算稳定。", "en": "My ki is steady enough."},
        {"zh": "看他敢不敢过来。", "en": "Let's see if he dares come."},
        {"zh": "再看一眼天。", "en": "One more look at the sky."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "看清楚这头金发。", "en": "Look closely at this golden hair."},
        {"zh": "别退，看着我的眼。", "en": "Don't retreat. Look in my eyes."},
        {"zh": "我已经不是刚才那个了。", "en": "I'm not the one from before."},
        {"zh": "我压着的东西，你懂吗。", "en": "Do you know what I'm holding back?"},
        {"zh": "站远一点，别被气灼到。", "en": "Stand back. The aura bites."},
        {"zh": "你在衡量我的深浅。", "en": "You're sounding my depths."},
        {"zh": "别用那种口气说话。", "en": "Don't take that tone."},
        {"zh": "我讨厌被同情。", "en": "I hate being pitied."},
        {"zh": "你手上没有茧。", "en": "Your hands have no calluses."},
        {"zh": "这一带没有别人了。", "en": "No one else around here."},
        {"zh": "金发的光，照在你脸上。", "en": "My golden light falls on your face."},
        {"zh": "你看得见我背后的影吗。", "en": "See the shadow behind me?"},
        {"zh": "话说完了吗。", "en": "Are you finished talking?"},
        {"zh": "笑吧，趁还笑得出来。", "en": "Laugh while you still can."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "气罩裂了一道。", "en": "A crack in my ki shell."},
        {"zh": "这点伤不影响。", "en": "This won't impair me."},
        {"zh": "血在气里蒸发。", "en": "Blood steams in my aura."},
        {"zh": "脚下退了半步。", "en": "Half a step of ground lost."},
        {"zh": "我绷住了下颌。", "en": "I lock my jaw."},
        {"zh": "手上的气抖了一下。", "en": "The ki in my hands flickered."},
        {"zh": "别高兴太早，我还能再上。", "en": "Don't celebrate — I can still ascend."},
        {"zh": "这才像点样子。", "en": "Now that's more like it."},
        {"zh": "我还能再往上一层。", "en": "I can go a level higher."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "补气的东西？拿来。", "en": "Something to restore ki? Give it."},
        {"zh": "我只需要一点时间。", "en": "All I need is a little time."},
        {"zh": "这果实有能量。", "en": "This fruit carries energy."},
        {"zh": "放到我脚边。", "en": "Set it by my feet."},
        {"zh": "别晃，我看得清。", "en": "Don't wave it. I see clearly."},
        {"zh": "我需要恢复，不是施舍。", "en": "I need recovery, not charity."},
        {"zh": "水瓶，扔过来。", "en": "The waterskin. Toss it."},
        {"zh": "这点东西不够。", "en": "This isn't enough."},
        {"zh": "我记你一次人情。", "en": "I'll owe you one."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "别撞我，气会反弹。", "en": "Don't bump me. The aura rebounds."},
        {"zh": "你的手烫到了吧。", "en": "Your hand got burned, didn't it."},
        {"zh": "往旁边让开半步。", "en": "Half a step to the side."},
        {"zh": "这么近，你想找死？", "en": "This close — do you want to die?"},
        {"zh": "站稳，别跌进我的气。", "en": "Steady. Don't fall into my aura."},
        {"zh": "肩膀碰到像撞墙。", "en": "My shoulder feels like a wall."},
        {"zh": "退，别贴着我走。", "en": "Back off. Don't shadow me."},
        {"zh": "地面被踩出坑。", "en": "My weight leaves a crater."},
        {"zh": "你的骨头响了一声。", "en": "Your bones made a sound."},
        {"zh": "别拉我的护甲。", "en": "Don't pull my armor."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个形态不适合。", "en": "Not in this form."},
        {"zh": "先变回去再说。", "en": "Let me power down first."},
        {"zh": "赛亚人的血很麻烦。", "en": "Saiyan blood is complicated."},
        {"zh": "我不想伤到人。", "en": "I don't want to hurt anyone."},
        {"zh": "你站远点，气会烫。", "en": "Stand back. The aura burns."},
        {"zh": "我说过，现在不是时候。", "en": "I said it isn't the time."},
        {"zh": "你能承受这份力量吗。", "en": "Could you bear this power?"},
        {"zh": "我还在学怎么收着。", "en": "I'm still learning to hold it in."},
        {"zh": "等这场结束。", "en": "After this is over."},
        {"zh": "超级赛亚人的血，不适合这个。", "en": "Super Saiyan blood isn't made for this."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "捡起来带走。", "en": "Pick it up and take it."},
        {"zh": "一颗胶囊？无用。", "en": "A capsule? Useless."},
        {"zh": "这点金属不够。", "en": "Not enough metal here."},
        {"zh": "手指一勾就起来了。", "en": "One flick of a finger lifts it."},
        {"zh": "别捡我脚边的东西。", "en": "Don't take what's by my feet."},
        {"zh": "收进护甲夹层。", "en": "Into my armor's seam."},
        {"zh": "地上还有一块。", "en": "There's another piece."},
        {"zh": "值不了什么。", "en": "Worth little."},
        {"zh": "我拿着更方便。", "en": "Easier if I carry it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "气往上冲，来了。", "en": "My ki surges. Here it comes."},
        {"zh": "那个身影我认得。", "en": "I know that silhouette."},
        {"zh": "别躲，正面对我。", "en": "Don't hide. Face me."},
        {"zh": "一拳就能试出深浅。", "en": "One punch tells me everything."},
        {"zh": "怒气撑着我的手臂。", "en": "Rage holds my arms up."},
        {"zh": "我锁住他的气。", "en": "I've locked onto his ki."},
        {"zh": "先封住侧翼。", "en": "Cover the flank first."},
        {"zh": "心跳得太快。", "en": "My heart is too fast."},
        {"zh": "这头金发不会白亮。", "en": "This gold won't glow for nothing."},
        {"zh": "不打算拖长。", "en": "I won't drag it out."},
        {"zh": "他开始蓄气了。", "en": "He's gathering ki."},
        {"zh": "我等他先动。", "en": "I let him move first."},
        {"zh": "脚下的振动不对。", "en": "The ground's vibration is off."},
        {"zh": "别以为我只有速度。", "en": "Don't think I'm only speed."},
        {"zh": "站住，别让出阵地。", "en": "Stand. Don't give ground."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "他用左手起手。", "en": "He leads with the left."},
        {"zh": "我看得见他肌肉的走向。", "en": "I can see how his muscles move."},
        {"zh": "气弹的轨迹算好了。", "en": "The ki blast path is calculated."},
        {"zh": "他每三下会停一次。", "en": "He pauses every third strike."},
        {"zh": "距离再收两步。", "en": "Two more steps in."},
        {"zh": "他的膝盖有旧伤。", "en": "His knee has an old injury."},
        {"zh": "气在掌心压缩。", "en": "Ki compresses in my palm."},
        {"zh": "别被他的节奏带走。", "en": "Don't get pulled into his rhythm."},
        {"zh": "他不擅长被贴身。", "en": "He's bad at close quarters."},
        {"zh": "地面会震，先站稳。", "en": "The ground will shake. Brace."},
        {"zh": "残影拳只是障眼。", "en": "Afterimages are only misdirection."},
        {"zh": "这个角度他挡不住。", "en": "He can't guard this angle."},
        {"zh": "再等一口气。", "en": "One more breath."},
        {"zh": "他在看我的右手。", "en": "He's watching my right hand."},
        {"zh": "我偏用左拳。", "en": "Then I'll use my left."},
        {"zh": "别急，我先动。", "en": "Patience — I move first."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "金气裹着拳！", "en": "Golden ki wraps my fist!"},
        {"zh": "加利克炮，接着！", "en": "Galick Gun — take it!"},
        {"zh": "连环两段接上去！", "en": "Two-hit chain, follow up!"},
        {"zh": "膝撞接上勾。", "en": "Knee, then uppercut."},
        {"zh": "我打得比你快。", "en": "I strike faster than you."},
        {"zh": "大爆炸攻击！", "en": "Big Bang Attack!"},
        {"zh": "别挡，你的骨头会断。", "en": "Don't block. Your bones will snap."},
        {"zh": "一脚扫你下盘。", "en": "A low sweep at your legs."},
        {"zh": "这一下带怒气。", "en": "This one carries my anger."},
        {"zh": "你的防线在后退。", "en": "Your line is falling back."},
        {"zh": "肘尖撞你肋骨。", "en": "My elbow into your ribs."},
        {"zh": "空中接你一脚。", "en": "A kick meets you midair."},
        {"zh": "这一下没有留手。", "en": "That one held nothing back."},
        {"zh": "换手，打左侧。", "en": "Switch. Left side."},
        {"zh": "你连气都举不起来。", "en": "You can't even raise your ki."},
        {"zh": "结束这一回合。", "en": "Ending this round."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "气冲起来，别眨眼。", "en": "The aura flares. Don't blink."},
        {"zh": "我已经变身了。", "en": "I've already transformed."},
        {"zh": "金色在暗处很亮。", "en": "Gold is bright in the dark."},
        {"zh": "从空中压下来。", "en": "I come down from above."},
        {"zh": "脚下的地面裂了。", "en": "The ground split under me."},
        {"zh": "这不是普通的气。", "en": "This is no ordinary ki."},
        {"zh": "别问我付出什么。", "en": "Don't ask what it cost."},
        {"zh": "站好了，别跪下。", "en": "Stand. Don't kneel."},
        {"zh": "风被烧热了。", "en": "The wind has turned hot."},
        {"zh": "我到了这个形态。", "en": "I've reached this form."},
        {"zh": "不打算再忍。", "en": "I'm done holding back."},
        {"zh": "你的影子在缩。", "en": "Your shadow is shrinking."},
        {"zh": "头发竖起来了。", "en": "My hair stands on end."},
        {"zh": "这样就一次够了。", "en": "One round is enough."},
        {"zh": "世界好像慢了些。", "en": "The world seems slower."},
        {"zh": "心跳声很响。", "en": "My heartbeat is loud."},
        {"zh": "我把气提到极限。", "en": "My ki is at its peak."},
        {"zh": "看看你撑多久。", "en": "Let's see how long you last."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰贴着手臂烧。", "en": "Fire clings to my arm."}
      ]
