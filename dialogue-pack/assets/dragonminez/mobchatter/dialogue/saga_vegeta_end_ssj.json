      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着气脉往下钻。", "en": "Lightning runs down my ki veins."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "金光照不到底。", "en": "My gold light shows no bottom."}
      ]
    }
  }
