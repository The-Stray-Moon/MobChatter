{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "金发在风里烧。", "en": "Golden hair burns in the wind."},
        {"zh": "脚步轻，气很沉。", "en": "Light steps, heavy ki."},
        {"zh": "这片地界不熟。", "en": "This territory is unfamiliar."},
        {"zh": "绕开那些浮石。", "en": "Steering around the floating stones."},
        {"zh": "气场压得草都伏。", "en": "My aura flattens the grass."},
        {"zh": "慢慢走，先看清。", "en": "Walk slow. See everything first."},
        {"zh": "靴底擦过黑岩。", "en": "Boots scrape the black rock."},
        {"zh": "这里的重力有点怪。", "en": "Gravity here feels off."},
        {"zh": "换个高处站站。", "en": "Moving to higher ground."},
        {"zh": "气往前推，助我走。", "en": "Ki pushes me forward."},
        {"zh": "每一步都在蓄力。", "en": "Every step stores power."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "哼，这世界真无趣。", "en": "Hmph. This world bores me."},
        {"zh": "金气收一点，省着。", "en": "I pull my aura in a little."},
        {"zh": "调整站姿，别懈。", "en": "Fix my stance. No slacking."},
        {"zh": "看看手背的筋。", "en": "I study the veins on my hand."},
        {"zh": "等一个像样的对手。", "en": "Waiting for a worthy opponent."},
        {"zh": "气在体内打转。", "en": "Ki churns inside me."},
        {"zh": "这头金发真碍眼。", "en": "This golden hair is a nuisance."},
        {"zh": "王子不靠运气。", "en": "A prince doesn't rely on luck."},
        {"zh": "数着远处的声音。", "en": "Counting the distant sounds."},
        {"zh": "肩膀松一下，再紧上。", "en": "I roll my shoulder and lock it."},
        {"zh": "地面太软，不喜欢。", "en": "The ground is too soft. I dislike it."},
        {"zh": "气弹在掌心转了转。", "en": "A ki blast spins in my palm."},
        {"zh": "金气收了半分，又涨回去。", "en": "I pull my aura in, then let it surge."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你就是这里的强者？", "en": "Are you the strong one here?"},
        {"zh": "抬起头，让我看看。", "en": "Lift your head. Let me see."},
        {"zh": "你的气弱得可笑。", "en": "Your ki is laughable."},
        {"zh": "报上名字，快。", "en": "Name yourself. Quickly."},
        {"zh": "你不是赛亚人吧。", "en": "You're no Saiyan, are you."},
        {"zh": "我讨厌被人打量。", "en": "I dislike being sized up."},
        {"zh": "再往前，我就当你挑衅。", "en": "One more step and I call it a challenge."},
        {"zh": "你的眼睛里有火。", "en": "There's fire in your eyes."},
        {"zh": "有意思，你还敢看。", "en": "Interesting. You still look."},
        {"zh": "我要的是战斗，不是话。", "en": "I want a fight, not chatter."},
        {"zh": "别把我当成普通敌人。", "en": "Don't take me for an ordinary foe."},
        {"zh": "加利克炮，已经架好。", "en": "My Galick Gun is leveled."},
        {"zh": "这片地界谁做主？", "en": "Who rules this land?"},
        {"zh": "你的护甲不错，可惜。", "en": "Fine armor. A pity."},
        {"zh": "说，你有多强。", "en": "Tell me how strong you are."},
        {"zh": "你笑什么，说来听听。", "en": "What's so funny? Say it."},
        {"zh": "少了点狠劲。", "en": "You lack ferocity."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哼，有点分量。", "en": "Hmph. Some weight behind that."},
        {"zh": "擦破了皮而已。", "en": "Just a scrape."},
        {"zh": "我不承认疼。", "en": "I don't acknowledge pain."},
        {"zh": "这伤不影响速度。", "en": "This won't slow me."},
        {"zh": "气乱了半瞬。", "en": "My ki wavered a moment."},
        {"zh": "站稳，别丢脸。", "en": "Stand firm. No shame."},
        {"zh": "你的手劲还行。", "en": "Your strength is passable."},
        {"zh": "记住这感觉。", "en": "Remember this feeling."},
        {"zh": "还没到极限。", "en": "Nowhere near my limit."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西能提升战力？", "en": "Will that raise my power?"},
        {"zh": "交出来，我需要。", "en": "Hand it over. I need it."},
        {"zh": "修炼用的，归我。", "en": "Training gear. Mine."},
        {"zh": "食物？我不挑。", "en": "Food? I'm not fussy."},
        {"zh": "这药味不错。", "en": "That tonic smells decent."},
        {"zh": "别拿走，我看看。", "en": "Don't take it. Let me look."},
        {"zh": "能变强的东西我都收。", "en": "I take anything that makes me stronger."},
        {"zh": "这点补给不够。", "en": "This isn't enough supply."},
        {"zh": "你留着也没用。", "en": "It's useless in your hands."},
        {"zh": "先给我，理由以后说。", "en": "Give it to me. Reasons later."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我的人是要付代价的。", "en": "Bumping me comes at a price."},
        {"zh": "退开，别贴着我。", "en": "Back off. Don't crowd me."},
        {"zh": "你也太不小心了。", "en": "You're careless."},
        {"zh": "这点推撞不算什么。", "en": "A shove means nothing."},
        {"zh": "气一震就够你退。", "en": "One pulse of ki sends you back."},
        {"zh": "你的骨头还挺硬。", "en": "Your bones are harder than expected."},
        {"zh": "撞一下也能试探。", "en": "Even a bump is a test."},
        {"zh": "肩膀擦过，记着。", "en": "That shoulder brush — remember it."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "王子的血统不随便给。", "en": "A prince's blood isn't given freely."},
        {"zh": "这种事不在计划里。", "en": "That isn't in my plans."},
        {"zh": "你连我的气都承受不住。", "en": "You can't even bear my ki."},
        {"zh": "等我打到顶峰。", "en": "Wait until I reach my peak."},
        {"zh": "超级赛亚人的骄傲，不低头。", "en": "A Super Saiyan's pride does not bow."},
        {"zh": "赛亚人的伴侣要够强。", "en": "A Saiyan's mate must be strong."},
        {"zh": "我讨厌软弱的人。", "en": "I despise weakness."},
        {"zh": "以后再说，现在打。", "en": "Later. Now we fight."},
        {"zh": "你倒是有点胆量。", "en": "You do have some nerve."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这颗珠子归我。", "en": "That orb is mine."},
        {"zh": "拾起来，塞进腰带。", "en": "Pick it up. Into the belt."},
        {"zh": "一小块矿石，还行。", "en": "A small ore chunk. Acceptable."},
        {"zh": "这布能缠手。", "en": "This cloth wraps a fist."},
        {"zh": "谁掉的，我收了。", "en": "Whoever dropped it, I'm keeping it."},
        {"zh": "重量不错，趁手。", "en": "Good weight. Feels right."},
        {"zh": "收进腰带里。", "en": "Into my belt pouch."},
        {"zh": "有点能量残留。", "en": "It has an energy residue."},
        {"zh": "算你运气好，我先捡到。", "en": "Lucky for me I found it first."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "终于有点动静了。", "en": "At last, some movement."},
        {"zh": "你的气在挑衅我。", "en": "Your ki is provoking me."},
        {"zh": "别跑，正面来。", "en": "Don't run. Face me."},
        {"zh": "我的气已经绕过你了。", "en": "My ki has already circled you."},
        {"zh": "那双眼睛，是敌人。", "en": "Those eyes — hostile."},
        {"zh": "你的架势摆得不错。", "en": "Your stance isn't bad."},
        {"zh": "这么快就找上我？", "en": "Found me this fast?"},
        {"zh": "声音从那边来。", "en": "The sound came from there."},
        {"zh": "先手是我的。", "en": "The first move is mine."},
        {"zh": "别想藏，我看得见气。", "en": "Don't hide. I see ki."},
        {"zh": "这一片都归你选墓地？", "en": "You pick this ground as your grave?"},
        {"zh": "浪费时间的人得付代价。", "en": "Wasting my time has a cost."},
        {"zh": "正好，试试新招式。", "en": "Good. Time to test a new move."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你在绕，我在算。", "en": "You circle. I calculate."},
        {"zh": "你的落点我记住了。", "en": "I've memorized where you land."},
        {"zh": "残影拳不需要喊。", "en": "The afterimage needs no warning."},
        {"zh": "气弹已经排好。", "en": "My ki blasts are lined up."},
        {"zh": "别躲进阴影里。", "en": "Don't hide in the shadows."},
        {"zh": "你的速度比我预计慢。", "en": "Slower than I estimated."},
        {"zh": "我等你跳起来那刻。", "en": "I wait for the moment you jump."},
        {"zh": "大爆炸攻击在蓄。", "en": "Big Bang Attack is charging."},
        {"zh": "手上的气在发烫。", "en": "The ki in my hand runs hot."},
        {"zh": "距离压到五步。", "en": "Closing to five paces."},
        {"zh": "你的破绽在左膝。", "en": "Your gap is at the left knee."},
        {"zh": "这招我见过了。", "en": "I've seen that move."},
        {"zh": "让你先动，也算礼。", "en": "I'll let you move first. A courtesy."},
        {"zh": "别指望地形帮你。", "en": "Don't expect the terrain to save you."},
        {"zh": "气在脚下聚成台。", "en": "Ki forms a platform under me."},
        {"zh": "等一下，就一下。", "en": "One moment. Just one."},
        {"zh": "这角度刚好命中。", "en": "This angle lands clean."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "吃我一记加利克炮！", "en": "Take a Galick Gun!"},
        {"zh": "连打，别喘气！", "en": "Combo — don't breathe!"},
        {"zh": "膝撞，转身踢。", "en": "Knee, then a spinning kick."},
        {"zh": "你的守势破了。", "en": "Your guard is broken."},
        {"zh": "拳头带气，重。", "en": "Ki-charged fist. Heavy."},
        {"zh": "这一击是大爆炸！", "en": "This one is Big Bang Attack!"},
        {"zh": "肘压你胸口。", "en": "Elbow into your chest."},
        {"zh": "退半步，再来。", "en": "Half step back, again."},
        {"zh": "我不用看也打得到。", "en": "I can hit you without looking."},
        {"zh": "你的手慢了。", "en": "Your hands have slowed."},
        {"zh": "空中连击接上勾！", "en": "Air combo into an uppercut!"},
        {"zh": "撞开你的架势。", "en": "I smash your stance open."},
        {"zh": "别挡，你的手会断。", "en": "Don't block. It'll break."},
        {"zh": "接着，第二段！", "en": "Here's the second part!"},
        {"zh": "这一拳为了王族。", "en": "That fist was for the royal line."},
        {"zh": "你还能站着？", "en": "You can still stand?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "王子到了，抬头。", "en": "The prince is here. Look up."},
        {"zh": "金气冲天，看见了吗。", "en": "Golden aura to the sky. See it?"},
        {"zh": "这世界的强者在哪。", "en": "Where are the strong ones here?"},
        {"zh": "金色的气先落在你脚边。", "en": "My golden ki lands at your feet first."},
        {"zh": "别以为这是普通敌人。", "en": "Don't mistake me for a common foe."},
        {"zh": "气在脚下炸开。", "en": "Ki bursts under my feet."},
        {"zh": "站稳了，别跪。", "en": "Stand firm. Don't kneel."},
        {"zh": "我讨厌等待。", "en": "I hate waiting."},
        {"zh": "这一带归我清场。", "en": "I'll clear this area."},
        {"zh": "王子不请自来。", "en": "A prince needs no invitation."},
        {"zh": "影子先到你脚边。", "en": "My shadow reaches your feet first."},
        {"zh": "战斗的气息，很好。", "en": "The smell of battle. Good."},
        {"zh": "我站定，让气自己烧起来。", "en": "I stand still and let my ki burn."},
        {"zh": "换个对手给我。", "en": "Give me a better opponent."},
        {"zh": "这个星球的气不错。", "en": "This planet's air is decent."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗烧焦我的手套。", "en": "Flame singed my glove."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时脚踝一沉。", "en": "My ankle buckled on impact."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里没法放气弹。", "en": "No ki blasts underwater."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风掀翻我的气罩。", "en": "The blast tore my ki shield."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这暗器，很卑鄙。", "en": "A hidden shot. How petty."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "不是气，是别的把戏。", "en": "Not ki. Some other trick."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着打不痛快。", "en": "Fighting hungry is unsatisfying."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着气爬上来。", "en": "Lightning crawls along my ki."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "空无一物，脚下无地。", "en": "Nothing here. No ground."}
      ]
    }
  }
}
