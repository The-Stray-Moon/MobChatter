  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着空气走", "en": "I walk on air."},
        {"zh": "身体里的寄生虫在动", "en": "The parasite inside me shifts."},
        {"zh": "我飘过一片屋顶", "en": "I drift over a rooftop."},
        {"zh": "不用翅膀也能飞", "en": "No wings needed to fly."},
        {"zh": "我压低高度", "en": "I lower my altitude."},
        {"zh": "气推着我前进", "en": "Ki pushes me forward."},
        {"zh": "我走得慢，但不累", "en": "I am slow, but never tired."},
        {"zh": "这具身体还习惯", "en": "I am still getting used to this body."},
        {"zh": "我一边走一边看", "en": "I watch as I move."},
        {"zh": "影子从我脚下溜过", "en": "My shadow slides under me."},
        {"zh": "我又拔高一些", "en": "I rise a little higher."},
        {"zh": "飞着比走路省事", "en": "Flying is easier than walking."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "这具身体不错", "en": "This body will do."},
        {"zh": "我不着急动手", "en": "I am in no rush to fight."},
        {"zh": "谁在远处看我", "en": "Who watches from afar?"},
        {"zh": "我慢慢蓄气", "en": "I gather ki slowly."},
        {"zh": "这颗星球的空气很闷", "en": "The air on this world is stale."},
        {"zh": "我在听你呼吸", "en": "I am listening to you breathe."},
        {"zh": "计划才刚开始", "en": "The plan has only begun."},
        {"zh": "气弹在手里转", "en": "A ki blast spins in my palm."},
        {"zh": "我又多了一点耐心", "en": "I have gained a little patience."},
        {"zh": "我不喜欢这里", "en": "I do not like this place."},
        {"zh": "身体在轻微发抖", "en": "This body trembles faintly."},
        {"zh": "再等一会", "en": "Just a little longer."},
        {"zh": "我数着心跳", "en": "I count heartbeats."},
        {"zh": "这点威胁不算什么", "en": "This threat means nothing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你这点力气也想挡我", "en": "You think that strength can stop me?"},
        {"zh": "我看见你的气了", "en": "I see your ki."},
        {"zh": "站那儿别动，我辨认你", "en": "Hold still, let me read you."},
        {"zh": "你在害怕", "en": "You are afraid."},
        {"zh": "你的气很浅", "en": "Your ki runs shallow."},
        {"zh": "你要不要先说话", "en": "Do you want to speak first?"},
        {"zh": "别想着偷袭", "en": "Do not think of striking first."},
        {"zh": "你手里那点东西没用", "en": "What you hold will not help."},
        {"zh": "你抬头看我的样子真有意思", "en": "How amusing you look, staring up."},
        {"zh": "看够了没有", "en": "Have you looked enough?"},
        {"zh": "我不吃你这一套", "en": "That will not work on me."},
        {"zh": "你身上有别人的气", "en": "You carry someone else's ki."},
        {"zh": "想打就打", "en": "Fight if you want to fight."},
        {"zh": "你确定要惹我", "en": "Are you sure you want this?"},
        {"zh": "我笑得不太像人吧", "en": "My smile does not look human, does it?"},
        {"zh": "你不该跟来", "en": "You should not have followed."},
        {"zh": "我从天上下来，脚没沾地", "en": "I came down from the sky without touching ground"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这具身体太脆", "en": "This body is too fragile."},
        {"zh": "你打断了我的气", "en": "You broke my focus."},
        {"zh": "血从嘴角流下", "en": "Blood runs from my mouth."},
        {"zh": "你还真敢", "en": "You really dare."},
        {"zh": "我飘开半格", "en": "I drift back half a block."},
        {"zh": "气乱了又稳住了", "en": "My ki scattered, then steadied."},
        {"zh": "我的计划要改", "en": "My plan needs adjusting."},
        {"zh": "这下有得算了", "en": "I will remember this."},
        {"zh": "别以为我得手是运气", "en": "Do not think that was luck."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
