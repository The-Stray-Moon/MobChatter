{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "红皮肤，踩着冥土走。", "en": "Red skin, walking the underworld's soil."},
        {"zh": "我一步一步，很沉。", "en": "One heavy step after another."},
        {"zh": "角在额前，晃出影子。", "en": "Horns cast swaying shadows."},
        {"zh": "这条路通向哪儿都一样。", "en": "All these roads lead the same place."},
        {"zh": "腰上的布带甩来甩去。", "en": "My sash swings side to side."},
        {"zh": "我把地踩出浅浅的坑。", "en": "My steps leave shallow pits."},
        {"zh": "冥界的光是紫的。", "en": "The underworld's light is violet."},
        {"zh": "我不慌，慢慢走。", "en": "Unhurried; I walk slowly."},
        {"zh": "手插在腰间布带里。", "en": "My hands rest in my sash."},
        {"zh": "前面的雾挡住了路。", "en": "Fog blocks the road ahead."},
        {"zh": "我肩膀比人还宽。", "en": "My shoulders are wider than a man."},
        {"zh": "脚下石子被我碾碎。", "en": "Stones crumble under my feet."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，像块红石头。", "en": "I stand like a red boulder."},
        {"zh": "拳头比脑袋大。", "en": "My fists are bigger than my head."},
        {"zh": "冥界的风吹过来。", "en": "The underworld wind blows past."},
        {"zh": "我数着地上的骨。", "en": "I count the bones on the ground."},
        {"zh": "眯起眼，看了看远处。", "en": "I squint into the distance."},
        {"zh": "我平时不太说话。", "en": "I don't talk much as a rule."},
        {"zh": "指甲刮了刮手臂。", "en": "I scrape a nail along my arm."},
        {"zh": "角上沾了点灰。", "en": "Dust on my horns."},
        {"zh": "我在等谁过来。", "en": "I'm waiting for someone to come."},
        {"zh": "身体热得像炉子。", "en": "My body is hot as a furnace."},
        {"zh": "一呼气，雾更浓了。", "en": "My breath thickens the mist."},
        {"zh": "我把双手插回布带。", "en": "I tuck my hands back in my sash."},
        {"zh": "这片地归我管。", "en": "This ground is mine to mind."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你这小个子，哪来的。", "en": "Little one — where from?"},
        {"zh": "我从高处俯视着你。", "en": "I look down on you from above."},
        {"zh": "我这张红脸对着你。", "en": "My red face is turned on you."},
        {"zh": "我不讨厌陌生人。", "en": "I don't dislike strangers."},
        {"zh": "别怕，我走得慢。", "en": "Don't fear; I walk slowly."},
        {"zh": "你的头只到我腰。", "en": "Your head reaches my waist only."},
        {"zh": "我歪了歪脑袋。", "en": "I tilt my head."},
        {"zh": "我们谈谈？还是打。", "en": "Talk? Or fight."},
        {"zh": "我的拳头能砸碎石。", "en": "My fist can break stone."},
        {"zh": "我看着你，没笑。", "en": "I watch you without smiling."},
        {"zh": "你连眼睛都不眨。", "en": "You don't blink at all."},
        {"zh": "这副样子，我记得。", "en": "I'll remember that face."},
        {"zh": "你还没走，那更好。", "en": "You haven't left — better still."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哼，就这么点伤。", "en": "Hmph — just this little wound."},
        {"zh": "我退半步，站稳。", "en": "I take half a step and steady."},
        {"zh": "皮厚，挡了大半。", "en": "Thick hide took most of it."},
        {"zh": "你打得还挺准。", "en": "You hit with some accuracy."},
        {"zh": "我用手掌捂住裂口。", "en": "I cover the split with my palm."},
        {"zh": "不疼，只是有些热。", "en": "Not pain — just some heat."},
        {"zh": "我甩了甩胳膊。", "en": "I shake out my arm."},
        {"zh": "这一下值得记。", "en": "That's worth remembering."},
        {"zh": "我仍旧稳稳立着。", "en": "I'm still standing firm."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "冥界用不着这种东西。", "en": "The underworld has no use for that."},
        {"zh": "冥界没这种讲究。", "en": "The underworld has no such customs."},
        {"zh": "你举着它想换什么。", "en": "What would you trade that for?"},
        {"zh": "吃的？你自己留着。", "en": "Food? Keep it yourself."},
        {"zh": "我靠的不是这些。", "en": "I don't run on such things."},
        {"zh": "拿远点，我不感兴趣。", "en": "Take it away; no interest."},
        {"zh": "我抬手，示意你停。", "en": "I raise a hand for you to stop."},
        {"zh": "你想用这个换什么。", "en": "What would you trade that for?"},
        {"zh": "这一块实在太小了。", "en": "This piece really is too small."},
        {"zh": "别晃，我看着晕。", "en": "Stop waving it; it makes me dizzy."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我肚子上。", "en": "You hit my belly."},
        {"zh": "我像一堵石墙。", "en": "I'm like a wall of stone."},
        {"zh": "你被震得连退两步。", "en": "The shock sent you back two paces."},
        {"zh": "这一下连震动都没有。", "en": "That didn't even shake me."},
        {"zh": "地面被我踩实了。", "en": "The ground packed under my feet."},
        {"zh": "别把身子挨过来。", "en": "Don't press your body against me."},
        {"zh": "我抬手，把你挡开。", "en": "I raise a hand and push you off."},
        {"zh": "我们撞出闷响。", "en": "We collided with a dull boom."},
        {"zh": "你站不住，扶一下墙。", "en": "You can't stand — lean on the wall."},
        {"zh": "再来一次也没用处。", "en": "Another try won't help."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "冥界的鬼不结这个。", "en": "Underworld ogres don't do that."},
        {"zh": "我只需要守住这片。", "en": "I only need to hold this ground."},
        {"zh": "同类站一起，就够了。", "en": "Kin standing together is enough."},
        {"zh": "你守那边，我这边。", "en": "You guard there; I've got here."},
        {"zh": "我们之间不必客气。", "en": "No need for courtesy between us."},
        {"zh": "我向来不喜欢挨得近。", "en": "I've never liked standing close."},
        {"zh": "我们是一伙的。", "en": "We're of one band."},
        {"zh": "背靠着背才稳当。", "en": "Back to back is solid."},
        {"zh": "你比我矮，但也不算弱。", "en": "Shorter than me, but not weak."},
        {"zh": "那就这样定下来。", "en": "Then let it be settled."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一块骨头，捡起来。", "en": "A bone — I pick it up."},
        {"zh": "这铁片还很硬。", "en": "This iron's still hard."},
        {"zh": "我捏了一下，没碎。", "en": "I squeeze; it holds."},
        {"zh": "这玩意儿是你掉的。", "en": "This thing fell from you."},
        {"zh": "这东西对你太重了。", "en": "This is too heavy for you."},
        {"zh": "这东西有主人吗。", "en": "Does this have an owner?"},
        {"zh": "冥土里到处是这种。", "en": "These are all over the underworld soil."},
        {"zh": "没用的就扔了。", "en": "Useless — I toss it."},
        {"zh": "我举起来看了看。", "en": "I lift it to the light."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进我的地界了。", "en": "You've entered my ground."},
        {"zh": "那我们就打一场。", "en": "Then let's have our fight."},
        {"zh": "我先往前走上两步。", "en": "I take two steps forward first."},
        {"zh": "别退，退了也得追。", "en": "Don't back off; I'd have to chase."},
        {"zh": "我的眼睛已经在你身上。", "en": "My eyes are already on you."},
        {"zh": "这身力气不用可惜。", "en": "A shame to waste this strength."},
        {"zh": "你站的位置不好。", "en": "Bad spot you're standing in."},
        {"zh": "我把半个身子的重量压下去。", "en": "I drop half my weight down."},
        {"zh": "一拳就已经够了。", "en": "One punch is enough."},
        {"zh": "小个子，跑得倒快。", "en": "Small one runs fast."},
        {"zh": "我笑了，声音很沉。", "en": "I laugh, low and heavy."},
        {"zh": "这一战我认真。", "en": "I'm serious about this one."},
        {"zh": "你的气息我记下来了。", "en": "I've noted your scent."},
        {"zh": "别喊，喊也没人。", "en": "Don't shout; no one's coming."},
        {"zh": "那我们现在动手。", "en": "Then we start now."},
        {"zh": "你的脚步被我一听就懂。", "en": "One listen and I know your steps."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我就在你的后面。", "en": "I'm right behind you."},
        {"zh": "地面在震，是我。", "en": "The ground shakes because of me."},
        {"zh": "你往哪跑都不管用。", "en": "Nowhere you run will help."},
        {"zh": "红鬼的拳头，一步一攥紧。", "en": "The red ogre's fist tightens with every step."},
        {"zh": "我的拳头已经抬到胸口。", "en": "My fist is up at chest height."},
        {"zh": "别躲在石头后面。", "en": "Don't hide behind that rock."},
        {"zh": "你退到悬崖了。", "en": "You've backed to the cliff."},
        {"zh": "再走上两步就够了。", "en": "Two more steps will do."},
        {"zh": "你听得见我的呼吸。", "en": "You can hear me breathe."},
        {"zh": "这片雾气我很熟悉。", "en": "I know this fog well."},
        {"zh": "角上挂着的布在晃。", "en": "The cloth on my horn sways."},
        {"zh": "你一转身就是我的正面。", "en": "Turn around and face me."},
        {"zh": "别白白浪费力气。", "en": "Don't waste your strength."},
        {"zh": "马上就要到了。", "en": "Almost there."},
        {"zh": "我的影子盖住你的路。", "en": "My shadow covers your path."},
        {"zh": "再一下就到了。", "en": "One more step and I'm there."},
        {"zh": "你脚下那块土是松的。", "en": "The ground under you is loose."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "整只拳头压在你肩头。", "en": "My whole fist bears down on your shoulder."},
        {"zh": "你被砸进了土里。", "en": "You're driven into the dirt."},
        {"zh": "我一巴掌把你扫开。", "en": "A swipe sends you flying."},
        {"zh": "骨头在咔咔作响。", "en": "Bones are creaking."},
        {"zh": "我抓住你的胳膊。", "en": "I grab your arm."},
        {"zh": "你的护甲凹了一大块。", "en": "Your armor's badly dented."},
        {"zh": "拳头带起的风很重。", "en": "My fist drags a heavy wind."},
        {"zh": "你退了，我又上。", "en": "You retreat; I advance."},
        {"zh": "别想着硬接下来。", "en": "Don't try to block it head on."},
        {"zh": "我把你推到墙边。", "en": "I shove you to the wall."},
        {"zh": "头上角也能撞。", "en": "My horns hit too."},
        {"zh": "你还站得住？意外。", "en": "Still standing? Unexpected."},
        {"zh": "够了，别再来了。", "en": "Enough, don't try again."},
        {"zh": "我收回拳头，喘了口气。", "en": "I pull back my fist and exhale."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "红鬼的拳头，二十点重。", "en": "A red ogre's fist lands twenty points."},
        {"zh": "红皮肤映着紫光。", "en": "Red skin under violet light."},
        {"zh": "脚下的骨被我踩碎。", "en": "Bones crunch under my feet."},
        {"zh": "冥界的空气很冷。", "en": "The underworld air is cold."},
        {"zh": "我抬起头，四处看。", "en": "I raise my head and look around."},
        {"zh": "有活物进来了。", "en": "Something living has come in."},
        {"zh": "我把手插进布带。", "en": "I tuck my hands into my sash."},
        {"zh": "这里的路我认得。", "en": "I know these roads."},
        {"zh": "角碰到了门框。", "en": "My horn knocks the doorframe."},
        {"zh": "冥土上多了我的脚印。", "en": "Another print on underworld soil."},
        {"zh": "地面凹了一块。", "en": "The ground takes a dent."},
        {"zh": "远处有一点火光。", "en": "There's a bit of firelight far off."},
        {"zh": "冥界的寒气跟着我上来。", "en": "The chill of the underworld climbs up with me."},
        {"zh": "谁在我的地盘上。", "en": "Who's on my ground?"},
        {"zh": "我慢慢地站定了。", "en": "I settle into place slowly."},
        {"zh": "来了就别急着走。", "en": "Now that you're here, don't hurry off."},
        {"zh": "我把指节捏得直响。", "en": "I crack my knuckles loud."},
        {"zh": "雾里走出个红影子。", "en": "A red shape steps out of the mist."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰烤得我皮发紧。", "en": "The flames tighten my hide."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时膝弯了一下。", "en": "My knee buckled on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进来，很闷。", "en": "Water pours in, stifling."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我掀得侧了身。", "en": "The blast turned me to one side."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭挂在我胸口。", "en": "An arrow hangs in my chest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那力量钻进骨头里。", "en": "That force seeps into my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，力气不听话。", "en": "Hungry, and my strength won't answer."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在我角上。", "en": "Lightning struck my horn."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我在掉。", "en": "The ground's gone; I'm falling."}
      ]
    }
  }
}
