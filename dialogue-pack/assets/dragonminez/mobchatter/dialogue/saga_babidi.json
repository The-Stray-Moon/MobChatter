    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘着，不用腿", "en": "I float, I need no legs."},
        {"zh": "气托着我往前", "en": "My ki carries me forward."},
        {"zh": "我盘旋着移动", "en": "I circle as I move."},
        {"zh": "袍角在风里响", "en": "My robe snaps in the wind."},
        {"zh": "空中比地上稳", "en": "The air is steadier than the ground."},
        {"zh": "我滑过你头顶", "en": "I glide above your head."},
        {"zh": "我压着气慢慢飘", "en": "I keep my ki low and drift."},
        {"zh": "我专挑高处走", "en": "I keep to the high places."},
        {"zh": "靴子根本用不上", "en": "Boots are useless to me."},
        {"zh": "我绕过塔顶", "en": "I drift around the tower top."},
        {"zh": "气流追着我走", "en": "The air current chases me."},
        {"zh": "我随时能拔高", "en": "I can rise at any moment."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
