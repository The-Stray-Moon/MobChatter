{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我背着剑慢慢走", "en": "I walk slowly with the sword on my back."},
        {"zh": "靴子踩得地面咯吱响", "en": "My boots creak on the ground."},
        {"zh": "我沿着台阶上下走", "en": "I pace up and down the steps."},
        {"zh": "走几步就看看天", "en": "Every few steps I glance at the sky."},
        {"zh": "风把外套吹得鼓起来", "en": "The wind fills my coat."},
        {"zh": "我习惯走在人前面半步", "en": "I'm used to walking half a step ahead."},
        {"zh": "我绕到院门口张望", "en": "I go to the gate and look out."},
        {"zh": "我一边走一边想着事", "en": "I walk while turning something over in my mind."},
        {"zh": "步子不快，但没停过", "en": "Not fast, but never stopped."},
        {"zh": "我把剑带往上提了提", "en": "I hitch the sword belt up."},
        {"zh": "这个时辰的太阳正好", "en": "The sun's just right at this hour."},
        {"zh": "我往训练场那边去", "en": "I head toward the training ground."},
        {"zh": "回头看一眼才继续走", "en": "I glance back, then keep walking."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠墙站着，等", "en": "I stand against the wall, waiting."},
        {"zh": "剑在背上，手是空的", "en": "Sword on my back, hands empty."},
        {"zh": "天还是那个天", "en": "The sky is still that sky."},
        {"zh": "我在想一件事", "en": "I'm thinking about something."},
        {"zh": "安静下来反而安心", "en": "Quiet is comforting."},
        {"zh": "我摸了摸剑柄", "en": "I touch the hilt."},
        {"zh": "有些事不必现在解决", "en": "Some things needn't be settled now."},
        {"zh": "风里有雨的味道", "en": "The wind smells of rain."},
        {"zh": "我站得笔直不动", "en": "I stand perfectly straight."},
        {"zh": "等的时候也是准备", "en": "Waiting is also preparation."},
        {"zh": "我不喜欢闲着", "en": "I dislike idling."},
        {"zh": "但有时候只能等", "en": "But sometimes waiting is all there is."},
        {"zh": "远处有人说话", "en": "Someone's talking in the distance."},
        {"zh": "我在数院里的台阶", "en": "I count the yard's steps."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "先说你为什么来", "en": "First, why are you here?"},
        {"zh": "别急，我听着", "en": "No hurry; I'm listening."},
        {"zh": "你的眼睛很直", "en": "Your gaze is direct."},
        {"zh": "我认得出练过的人", "en": "I can tell someone who's trained."},
        {"zh": "你想要什么答案", "en": "What answer are you after?"},
        {"zh": "我说话直，你别介意", "en": "I speak plainly; don't mind it."},
        {"zh": "有些事我帮得上", "en": "Some things I can help with."},
        {"zh": "先坐下来再谈", "en": "Sit down first, then we talk."},
        {"zh": "你身上的气息不对", "en": "Something in your bearing is off."},
        {"zh": "我不喜欢含糊其辞", "en": "I dislike vague words."},
        {"zh": "你想要变强吗", "en": "Do you want to grow stronger?"},
        {"zh": "我教人只看一点", "en": "I judge students by one thing."},
        {"zh": "你肯不肯吃苦", "en": "Are you willing to endure hardship?"},
        {"zh": "把心里的问题说出来", "en": "Speak the question in your heart."},
        {"zh": "我没什么可藏的", "en": "I have nothing to hide."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这一下我失手了", "en": "I slipped up on that one."},
        {"zh": "我得退开半步", "en": "I should back off half a step."},
        {"zh": "之前是我小看你", "en": "I underestimated you before."},
        {"zh": "别再补上一下了", "en": "No more of that."},
        {"zh": "我要调整姿势", "en": "I need to reset my stance."},
        {"zh": "外套破了，剑还背在身上。", "en": "My jacket is torn; my sword is still on my back."},
        {"zh": "我还能再撑住", "en": "I can still hold out."},
        {"zh": "师父也会疼，只是不说。", "en": "Even a master feels pain. He just doesn't show it."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这是什么意思", "en": "What is this for?"},
        {"zh": "我不靠这个换交情", "en": "I don't trade in such things."},
        {"zh": "放那儿吧，谢谢", "en": "Leave it there; thank you."},
        {"zh": "你要是想学，直接开口", "en": "If you want to learn, just ask."},
        {"zh": "我现在还不饿", "en": "I'm not hungry right now."},
        {"zh": "这份心意我收下", "en": "I'll accept the gesture."},
        {"zh": "别浪费这些东西", "en": "Don't waste these things."},
        {"zh": "吃完了我还有事", "en": "I've work to do after this."},
        {"zh": "你倒是很客气", "en": "You're quite polite."},
        {"zh": "我不太习惯被人这样照顾", "en": "I'm not used to being looked after."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "抱歉，没看路", "en": "Sorry, I wasn't watching."},
        {"zh": "你撞上我的剑带了", "en": "You hit my sword belt."},
        {"zh": "你只要站稳就行", "en": "As long as you stay steady."},
        {"zh": "我们两个都没事", "en": "Neither of us is hurt."},
        {"zh": "走这么急干什么", "en": "What's the rush?"},
        {"zh": "这个院子有点窄", "en": "This yard is a bit tight."},
        {"zh": "你比我预想的结实", "en": "You're sturdier than I expected."},
        {"zh": "麻烦你让一下路", "en": "Excuse me, let me by."},
        {"zh": "撞完就各走各的", "en": "We bump, then go our ways."},
        {"zh": "下次注意着点", "en": "Mind it next time."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个我没什么好说的", "en": "I've nothing to say on that."},
        {"zh": "我还有别的事要想", "en": "I have other things on my mind."},
        {"zh": "不合适的时机", "en": "Wrong time for it."},
        {"zh": "我不擅长这类话题", "en": "I'm not good at this kind of talk."},
        {"zh": "这个咱们换话题吧", "en": "Let's change the subject."},
        {"zh": "我总惦记着别处", "en": "My thoughts are always elsewhere."},
        {"zh": "这种事得慢慢来", "en": "Such things take time."},
        {"zh": "先练功。别的事往后放。", "en": "Training first. Everything else can wait."},
        {"zh": "我不想敷衍你", "en": "I don't want to brush you off."},
        {"zh": "还是说正事吧", "en": "Let's get back to business."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我自己能走路", "en": "I can walk by myself."},
        {"zh": "别扯我的外套", "en": "Don't pull my coat."},
        {"zh": "剑会碰到你的", "en": "The sword will catch you."},
        {"zh": "先把我放下来吧", "en": "Set me down first."},
        {"zh": "这姿势使不上劲", "en": "I can't move like this."},
        {"zh": "你的力气不小", "en": "You're quite strong."},
        {"zh": "别把我当包裹", "en": "Don't treat me like baggage."},
        {"zh": "到地方我自然会走", "en": "I'll walk once we're there."},
        {"zh": "我肩上还有剑", "en": "My sword's still on my back."},
        {"zh": "这样看着很难看", "en": "This looks ridiculous."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经站在这里", "en": "I'm already here."},
        {"zh": "你要打，我奉陪", "en": "If you want a fight, I'll oblige."},
        {"zh": "别牵扯无关的人", "en": "Leave innocents out of it."},
        {"zh": "站住，别乱动", "en": "Stop and don't move."},
        {"zh": "我做过比这难的事", "en": "I've done harder than this."},
        {"zh": "你选错了时间", "en": "You chose the wrong time."},
        {"zh": "我警告你一次", "en": "One warning."},
        {"zh": "这把剑不是摆设", "en": "This blade isn't decoration."},
        {"zh": "你要后悔就现在退", "en": "Regret it now and withdraw."},
        {"zh": "我不会让你过去", "en": "I won't let you pass."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你从右边绕，我看得见", "en": "Circle right; I see it."},
        {"zh": "别动那些没防备的人", "en": "Don't touch the defenseless."},
        {"zh": "我在等你的破绽", "en": "I'm waiting for your opening."},
        {"zh": "你的步子太规律了", "en": "Your steps are too regular."},
        {"zh": "我数着你的节奏", "en": "I'm counting your rhythm."},
        {"zh": "再近一步就晚了", "en": "One more step and it's too late."},
        {"zh": "背对我是你的错", "en": "Turning your back was your error."},
        {"zh": "我不喊，直接来", "en": "No shouting; I just come."},
        {"zh": "你手里那东西太短", "en": "That thing in your hand is too short."}
      ]
    },
