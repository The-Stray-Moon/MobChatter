      "operation": "replace",
      "lines": [
        {"zh": "接住我这一剑", "en": "Catch this blade."},
        {"zh": "这一下很快的", "en": "This one is quick."},
        {"zh": "你刚才没看清吧", "en": "You didn't see that, did you?"},
        {"zh": "我留了几分力", "en": "I held back some strength."},
        {"zh": "别硬挡这一下", "en": "Don't block this head-on."},
        {"zh": "那我们再来一次", "en": "Once more, then."},
        {"zh": "剑不用出鞘也能赢", "en": "I can win without drawing."},
        {"zh": "你退得实在太慢", "en": "You retreat far too slowly."},
        {"zh": "这是最后一击", "en": "This is the last blow."}
