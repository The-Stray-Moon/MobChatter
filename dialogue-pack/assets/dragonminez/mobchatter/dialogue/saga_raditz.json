{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "长发拖到腰后。", "en": "My long hair falls to my waist."},
        {"zh": "踩在空气上，一步一步。", "en": "Each step lands on air."},
        {"zh": "护肩的甲片在响。", "en": "My shoulder guard rattles."},
        {"zh": "我不赶路，猎物会等。", "en": "No rush; prey waits."},
        {"zh": "探测器贴在耳边。", "en": "The scouter sits at my ear."},
        {"zh": "我飘过树冠的高度。", "en": "I drift above the treetops."},
        {"zh": "脚下的风被压出纹。", "en": "The wind ripples below my feet."},
        {"zh": "尾巴绕在腰间。", "en": "My tail is coiled at my waist."},
        {"zh": "我边走边扫视地面。", "en": "I scan the ground as I move."},
        {"zh": "这片地太小了。", "en": "This terrain is too small."},
        {"zh": "我朝读数最大的方向走。", "en": "I head toward the strongest reading."},
        {"zh": "身体不重，速度却快。", "en": "My body is light, my speed high."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "战斗力读数在跳。", "en": "The power reading is fluctuating."},
        {"zh": "我捏了捏指节。", "en": "I crack my knuckles."},
        {"zh": "这点风算什么。", "en": "This wind is nothing."},
        {"zh": "头发被吹得乱飞。", "en": "My hair whips around."},
        {"zh": "我盯着远处那座山。", "en": "I stare at that mountain."},
        {"zh": "赛亚人不需要休息。", "en": "A Saiyan needs no rest."},
        {"zh": "我抬起下巴，俯视。", "en": "I lift my chin and look down."},
        {"zh": "探测器发出细响。", "en": "The scouter gives a thin whine."},
        {"zh": "我把尾巴甩了一下。", "en": "I flick my tail."},
        {"zh": "这里的人真弱。", "en": "The people here are so weak."},
        {"zh": "我在算几分钟能结束。", "en": "I'm counting how many minutes this takes."},
        {"zh": "肩膀上的甲反光。", "en": "My shoulder plate glints."},
        {"zh": "空气里有尘土味。", "en": "There's dust in the air."},
        {"zh": "我只笑了一声。", "en": "I laughed exactly once."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是谁？读数这么低。", "en": "Who are you? Such a low reading."},
        {"zh": "地球人？看着就弱。", "en": "An Earthling? You look weak."},
        {"zh": "我低下头来瞧你。", "en": "I look down at you."},
        {"zh": "你的心跳很快。", "en": "Your heart is racing."},
        {"zh": "别盯着我的头发。", "en": "Don't stare at my hair."},
        {"zh": "你到底想要什么。", "en": "What is it you actually want?"},
        {"zh": "我可以先听你说完。", "en": "I can let you finish speaking."},
        {"zh": "你的气，几乎没有。", "en": "Your ki is nearly nothing."},
        {"zh": "我歪头，像在看虫子。", "en": "I tilt my head like I'm eyeing a bug."},
        {"zh": "你身后有人吗。", "en": "Anyone behind you?"},
        {"zh": "这副样子，我记住了。", "en": "I'll remember that look."},
        {"zh": "你难道不打算跑。", "en": "You're not going to run?"},
        {"zh": "我可没有那么好的耐心。", "en": "I'm not a patient sort."},
        {"zh": "你说完了没有。", "en": "Have you finished talking?"},
        {"zh": "我把探测器按了一下。", "en": "I tap the scouter."},
        {"zh": "你的同伴在哪。", "en": "Where are your companions?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哼，不过是擦破皮。", "en": "Hmph — merely a scratch."},
        {"zh": "你打得比读数好。", "en": "You hit better than your reading."},
        {"zh": "我退了一步，不错。", "en": "I stepped back — not bad."},
        {"zh": "这点伤，无所谓。", "en": "This wound is nothing."},
        {"zh": "我擦了擦嘴角。", "en": "I wipe the corner of my mouth."},
        {"zh": "甲片被打陷了。", "en": "A plate is dented in."},
        {"zh": "我的尾巴僵了一下。", "en": "My tail stiffens for a moment."},
        {"zh": "你会为这一下付出代价。", "en": "You'll pay for that."},
        {"zh": "我仍旧站得住。", "en": "I'm still on my feet."},
        {"zh": "别指望第二次。", "en": "Don't count on a second one."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这样的东西能吃吗。", "en": "Is this sort of thing edible?"},
        {"zh": "赛亚人不靠这个。", "en": "Saiyans don't run on that."},
        {"zh": "你拿它想换命？", "en": "Trading that for your life?"},
        {"zh": "我不靠这种东西打仗。", "en": "I don't fight on such things."},
        {"zh": "举着东西的样子真可笑。", "en": "Holding that up looks ridiculous."},
        {"zh": "有更强的敌人吗。", "en": "Is there a stronger enemy?"},
        {"zh": "我只想打一场像样的。", "en": "I only want a decent fight."},
        {"zh": "别再晃了，真烦人。", "en": "Stop waving it — it's annoying."},
        {"zh": "食物可以，但得更多。", "en": "Food will do, but I need more."},
        {"zh": "你把它放下，退后。", "en": "Set it down and step back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我可是动也没动。", "en": "I didn't move a muscle."},
        {"zh": "别撞赛亚人的肩甲。", "en": "Don't bump a Saiyan's shoulder guard."},
        {"zh": "尘土飞起来又落下。", "en": "Dust rises and settles."},
        {"zh": "别把身子靠过来。", "en": "Don't lean your body on me."},
        {"zh": "这一撞连痒都算不上。", "en": "That wasn't even a tickle."},
        {"zh": "我侧身，你就扑空。", "en": "I step aside; you hit air."},
        {"zh": "我们撞响了一声。", "en": "We collided with a crack."},
        {"zh": "站直了，别丢人现眼。", "en": "Stand up; don't make a fool of yourself."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "赛亚人不谈这个。", "en": "Saiyans don't discuss that."},
        {"zh": "同类只谈强弱。", "en": "Our kind only talk of strength."},
        {"zh": "你的战斗力多少。", "en": "What's your power level?"},
        {"zh": "站近点，让我看清。", "en": "Stand closer; let me see."},
        {"zh": "一起打，效率更高。", "en": "Fighting together is more efficient."},
        {"zh": "我不需要伙伴。", "en": "I don't need a partner."},
        {"zh": "肩并肩可以，别碍事。", "en": "Side by side is fine; don't get in my way."},
        {"zh": "血脉比什么都重要。", "en": "Bloodline matters above all."},
        {"zh": "你和我，同样的骄傲。", "en": "You and I share the same pride."},
        {"zh": "这就当作是结盟了。", "en": "Consider it an alliance."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个零件，能研究。", "en": "This part could be studied."},
        {"zh": "读数没有变化。", "en": "The reading doesn't change."},
        {"zh": "太轻了，没意思。", "en": "Too light — boring."},
        {"zh": "我捏了捏，变形了。", "en": "I squeeze it and it warps."},
        {"zh": "一块铁，换不了什么。", "en": "A piece of iron buys nothing."},
        {"zh": "我随手扔进腰包。", "en": "I toss it into my belt pouch."},
        {"zh": "这地方的东西都这么旧。", "en": "Everything here is so worn."},
        {"zh": "一枚指环？给谁的。", "en": "A ring? For whom?"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "读数确认，目标。", "en": "Reading confirmed: target."},
        {"zh": "那就我先动手了。", "en": "Then I'll strike first."},
        {"zh": "你身上的气归我了。", "en": "Your ki is mine now."},
        {"zh": "速度差距太大。", "en": "The speed gap is too wide."},
        {"zh": "我从上头下来。", "en": "I come down from above."},
        {"zh": "两星期天，够了吗。", "en": "Double Sunday — enough?"},
        {"zh": "你连反应都来不及。", "en": "You won't even have time to react."},
        {"zh": "这一场会很快。", "en": "This will be quick."},
        {"zh": "抓住活的也可以。", "en": "Taking you alive works too."},
        {"zh": "我已经锁定你了。", "en": "I've got you locked in."},
        {"zh": "你是第一个还是最后一个。", "en": "Are you the first or the last?"},
        {"zh": "我已经动起来了。", "en": "I've started moving."},
        {"zh": "你在我眼里慢得像石头。", "en": "You move like stone to me."},
        {"zh": "那就痛快打一场。", "en": "Then let's have a real fight."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕到你上面。", "en": "I circle above you."},
        {"zh": "你跑到哪都一样。", "en": "Running changes nothing."},
        {"zh": "探测器一直响。", "en": "The scouter keeps beeping."},
        {"zh": "这一掌会把地打穿。", "en": "This palm will punch through the ground."},
        {"zh": "我压着速度，别急。", "en": "I hold back my speed; no hurry."},
        {"zh": "你的两条腿在抖。", "en": "Both your legs are shaking."},
        {"zh": "探测器上的数字，不值一提。", "en": "The number on my scouter is nothing to fear."},
        {"zh": "退到墙边没用的。", "en": "The wall won't save you."},
        {"zh": "我抬手，气就来了。", "en": "I raise my hand and ki comes."},
        {"zh": "再靠近一点就行。", "en": "Just a bit closer."},
        {"zh": "我的尾巴在你身后。", "en": "My tail is behind you."},
        {"zh": "你想拖到我累？不可能。", "en": "Waiting for me to tire? Not happening."},
        {"zh": "你的同伴在哪，说吧。", "en": "Where are your friends? Speak."},
        {"zh": "这一击不会落空。", "en": "This strike won't miss."},
        {"zh": "还剩下两步距离。", "en": "Two steps left."},
        {"zh": "我咧开嘴笑了一下。", "en": "I bare my teeth in a grin."},
        {"zh": "这一切都结束了。", "en": "This is all over."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "这一拳打在你胸口。", "en": "This fist lands on your chest."},
        {"zh": "你被打飞出去。", "en": "You're knocked flying."},
        {"zh": "连击的第二下到了。", "en": "The combo's second hit lands."},
        {"zh": "手肘紧跟着砸下来。", "en": "The elbow follows it down."},
        {"zh": "我抓你的衣领。", "en": "I grab your collar."},
        {"zh": "你的护甲碎了。", "en": "Your armor breaks."},
        {"zh": "膝盖撞上你的肚子。", "en": "My knee meets your gut."},
        {"zh": "手刀切在你肩头。", "en": "A knife-hand strike to your shoulder."},
        {"zh": "你挡得还不错。", "en": "You blocked well enough."},
        {"zh": "气弹从掌心推出。", "en": "A ki blast leaves my palm."},
        {"zh": "你的脚离了地。", "en": "Your feet leave the ground."},
        {"zh": "我说话时也在打。", "en": "I talk and hit at the same time."},
        {"zh": "尾巴扫你的腿。", "en": "My tail sweeps your legs."},
        {"zh": "这一下够你躺一会儿。", "en": "That'll keep you down a while."},
        {"zh": "我收回手，看你。", "en": "I pull back my hand and watch."},
        {"zh": "不过就这么点本事。", "en": "Is that all the skill you have?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "探测器先扫过你的战力。", "en": "My scouter reads your power level first."},
        {"zh": "靴子踩碎了土块。", "en": "My boots crush the dirt."},
        {"zh": "探测器开始扫描。", "en": "The scouter begins to scan."},
        {"zh": "这颗星球真小。", "en": "This planet is tiny."},
        {"zh": "空气里有水的味道。", "en": "The air smells of water."},
        {"zh": "我站直，拍了拍袖子。", "en": "I straighten and dust off my sleeve."},
        {"zh": "读数低得一片平坦。", "en": "Every reading is flat and low."},
        {"zh": "谁在这里等我。", "en": "Who's waiting here for me?"},
        {"zh": "尾巴在身后甩开。", "en": "My tail swings out behind me."},
        {"zh": "我的任务开始了。", "en": "My mission begins."},
        {"zh": "远处升起一缕炊烟。", "en": "A wisp of cooking smoke rises far off."},
        {"zh": "我把头发甩到背后。", "en": "I toss my hair back."},
        {"zh": "我先找最强的。", "en": "First I'll find the strongest."},
        {"zh": "脚下的土还在晃。", "en": "The ground still trembles."},
        {"zh": "我已经落到这里了。", "en": "I've landed here now."},
        {"zh": "我的影子先落在他们头上。", "en": "My shadow lands on them first."},
        {"zh": "今天谁先倒霉，看运气。", "en": "Whoever's unlucky goes first today."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗舔着我的腿。", "en": "Flames lick my legs."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时土都被砸开了。", "en": "The ground burst open where I landed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进了肺，我咳了一下。", "en": "Water in my lungs — I cough."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭钉在我肩膀上。", "en": "An arrow sticks in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股能量咬进骨头。", "en": "This energy bites into bone."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着打不了硬仗。", "en": "I can't fight hard on an empty stomach."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我麻了半边。", "en": "Lightning strikes; half of me goes numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "底下没底，我一直在坠。", "en": "No bottom; I keep falling."}
      ]
    }
  }
}
