{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "脚步不快，但很稳。", "en": "Not a fast pace, but steady."},
        {"zh": "沿着废墟走。", "en": "I walk along the ruins."},
        {"zh": "披风被风扯着。", "en": "The wind tugs my cape."},
        {"zh": "绕开地上的裂缝。", "en": "Stepping around the cracks."},
        {"zh": "数着剩下的日子。", "en": "Counting the days that remain."},
        {"zh": "这条街我走过千次。", "en": "I've walked this street a thousand times."},
        {"zh": "左手空着，习惯。", "en": "My left hand hangs empty. Habit."},
        {"zh": "把碎石踢到一边。", "en": "I kick the rubble aside."},
        {"zh": "雨点打在脸上。", "en": "Rain on my face."},
        {"zh": "去高处看看。", "en": "Heading up where I can see."},
        {"zh": "气在脚下轻轻浮着。", "en": "Ki lifts me a little with each step."},
        {"zh": "不能停太久。", "en": "I can't linger long."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "今天也活下来了。", "en": "Made it through today too."},
        {"zh": "这城市安静得怪。", "en": "This city is strangely quiet."},
        {"zh": "攥了攥右拳。", "en": "I clench my right fist."},
        {"zh": "伤疤又痒了。", "en": "The scars itch again."},
        {"zh": "悟天今天没来。", "en": "Goten didn't come today."},
        {"zh": "云压得很低。", "en": "The clouds hang low."},
        {"zh": "我得变强，还得更强。", "en": "I have to get stronger. More."},
        {"zh": "气还剩七成。", "en": "Seven tenths of my ki left."},
        {"zh": "看着远处冒烟。", "en": "Watching smoke in the distance."},
        {"zh": "先调整一下呼吸。", "en": "Let me settle my breathing."},
        {"zh": "一件旧披风，补了又补。", "en": "An old cape, patched again and again."},
        {"zh": "不能让他们看见我累。", "en": "They mustn't see me tired."},
        {"zh": "手腕转了转。", "en": "I rotate my wrist."},
        {"zh": "有人在等我回去。", "en": "Someone is waiting for me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "先别靠近，站在那。", "en": "Not too close. Stand there."},
        {"zh": "你眼里没有恶意。", "en": "I see no malice in your eyes."},
        {"zh": "这身打扮不是本地人。", "en": "You don't dress like a local."},
        {"zh": "你从哪边来的？", "en": "Which way did you come from?"},
        {"zh": "低着头走路，小心。", "en": "Keep your head down out here."},
        {"zh": "别在这片空地停留。", "en": "Don't linger in this open ground."},
        {"zh": "我不认识你，但也不敌视。", "en": "You're a stranger, not an enemy."},
        {"zh": "饿了吗？我没什么可给。", "en": "Hungry? I've little to give."},
        {"zh": "我看起来不像英雄吧。", "en": "I don't look like a hero, do I?"},
        {"zh": "你能保护自己吗？", "en": "Can you defend yourself?"},
        {"zh": "抬起头，别怕。", "en": "Lift your head. Don't be afraid."},
        {"zh": "这里不安全，天亮再走。", "en": "It's unsafe here. Wait for dawn."},
        {"zh": "你的气，很干净。", "en": "Your ki is clean."},
        {"zh": "别看我脸上的疤。", "en": "Don't stare at my scars."},
        {"zh": "我只是个老师。", "en": "I'm only a teacher."},
        {"zh": "说，你需要什么。", "en": "Tell me what you need."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "旧伤又裂了。", "en": "An old wound reopened."},
        {"zh": "我听见肋骨在响。", "en": "I hear my ribs click."},
        {"zh": "我吐了口血。", "en": "I spit blood."},
        {"zh": "站住，别倒下去。", "en": "Stay up. Don't fall."},
        {"zh": "这具身体还撑得住。", "en": "This body still holds."},
        {"zh": "呼吸断了一拍。", "en": "My breath skipped."},
        {"zh": "疼就让它疼吧。", "en": "Let it hurt, then."},
        {"zh": "这种疼我习惯了。", "en": "I'm used to this pain."},
        {"zh": "还能再打十回合。", "en": "Ten more rounds in me."},
        {"zh": "别为我担心。", "en": "Don't worry about me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "压缩饼干？谢谢。", "en": "A ration bar? Thank you."},
        {"zh": "那壶水我收下。", "en": "I'll take that waterskin."},
        {"zh": "绷带正好用完了。", "en": "My bandages ran out."},
        {"zh": "干粮留着给孩子。", "en": "I'd keep the food for the kids."},
        {"zh": "锅里有热汤吗？", "en": "Is there hot soup in the pot?"},
        {"zh": "这件披风还能穿。", "en": "This cape can still be worn."},
        {"zh": "药物，我需要。", "en": "Medicine. I need it."},
        {"zh": "种子？可以种。", "en": "Seeds? Those can be planted."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心点，站稳了。", "en": "Careful. Steady yourself."},
        {"zh": "抱歉，我在想事。", "en": "Sorry. My mind was elsewhere."},
        {"zh": "别挤在这条窄道。", "en": "Don't crowd this narrow way."},
        {"zh": "你撞到我旧伤了。", "en": "You hit an old wound."},
        {"zh": "肩膀撞得不轻。", "en": "That was a hard shoulder."},
        {"zh": "路滑，看着脚下。", "en": "The path is slick. Watch your feet."},
        {"zh": "别推，这墙撑不住。", "en": "Don't push. This wall won't hold."},
        {"zh": "别推，这里会塌。", "en": "Don't push. This will collapse."},
        {"zh": "你的力气不小。", "en": "You're stronger than you look."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "现在不是时候。", "en": "This isn't the time."},
        {"zh": "我背的东西太多了。", "en": "I carry too much already."},
        {"zh": "战争结束再谈这些。", "en": "After the war, we'll talk."},
        {"zh": "你该找个更安稳的人。", "en": "You should find someone steadier."},
        {"zh": "我可能活不到那天。", "en": "I might not live to see it."},
        {"zh": "别把心放在我身上。", "en": "Don't set your heart on me."},
        {"zh": "一起活下去就够。", "en": "Surviving together is enough."},
        {"zh": "我会记住这份心意。", "en": "I'll remember the thought."},
        {"zh": "先把手上的事做完。", "en": "First, finish what's in my hands."},
        {"zh": "你笑了就好。", "en": "It's enough that you smiled."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这袋米还能吃。", "en": "This rice is still good."},
        {"zh": "绷带，好好收着。", "en": "Bandages. Keep them safe."},
        {"zh": "一块铁皮，能补屋顶。", "en": "Sheet metal — good for a roof."},
        {"zh": "这书还能读。", "en": "This book is still readable."},
        {"zh": "有个玩具，给小孩。", "en": "A toy — for the children."},
        {"zh": "拾起水壶，晃了晃。", "en": "I shake the waterskin."},
        {"zh": "这瓶药还没碎。", "en": "This vial didn't break."},
        {"zh": "碎石里有东西。", "en": "Something's in the rubble."},
        {"zh": "留着，以后有用。", "en": "Keep it. It'll be useful."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "废墟那头有人影。", "en": "A figure past the ruins."},
        {"zh": "来了，比昨天早。", "en": "Here already. Earlier than yesterday."},
        {"zh": "气不对，是敌人。", "en": "Wrong ki. Enemy."},
        {"zh": "放下手里的事。", "en": "I set down what I'm holding."},
        {"zh": "把气提起来。", "en": "Raising my ki."},
        {"zh": "这条街不能再烧一次。", "en": "This street won't burn again."},
        {"zh": "你盯上我了？", "en": "You've set your eyes on me?"},
        {"zh": "别往孩子那边去。", "en": "Not toward the children."},
        {"zh": "站住，到此为止。", "en": "Stop. This is the line."},
        {"zh": "今天我不会退。", "en": "I won't step back today."},
        {"zh": "你的杀意太明显了。", "en": "Your killing intent is obvious."},
        {"zh": "先手不是你的。", "en": "The first move isn't yours."},
        {"zh": "让开这条路。", "en": "Clear this road."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你的拳路我看过。", "en": "I've seen your style before."},
        {"zh": "重心偏左，抓到了。", "en": "Weight on the left. Noted."},
        {"zh": "我在等你的空档。", "en": "I wait for your gap."},
        {"zh": "绕到你的侧面。", "en": "Moving to your flank."},
        {"zh": "气屏障慢慢展开。", "en": "My ki barrier opens."},
        {"zh": "你每次出手前会吸气。", "en": "You inhale before every strike."},
        {"zh": "别急，我能看穿。", "en": "Patience. I can read it."},
        {"zh": "脚下不能踩空。", "en": "Don't lose my footing."},
        {"zh": "这一带还有平民。", "en": "Civilians are still here."},
        {"zh": "把距离压到三步。", "en": "Closing to three paces."},
        {"zh": "你退得比我想的快。", "en": "You retreat faster than expected."},
        {"zh": "手别抬得太高。", "en": "Keep my guard from rising too high."},
        {"zh": "我在准备魔闪光。", "en": "Charging the Masenko."},
        {"zh": "你的呼吸，我隔着墙都听见。", "en": "I hear your breathing through the wall."},
        {"zh": "等你自己送上门。", "en": "I'll let you come to me."},
        {"zh": "这招我挡得住。", "en": "I can block this one."},
        {"zh": "后背贴着墙。", "en": "My back to the wall."},
        {"zh": "再等一下就好。", "en": "Just a moment more."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "连击，第一下。", "en": "Combo — first hit."},
        {"zh": "右手一记直拳！", "en": "A straight right!"},
        {"zh": "肘尖往下压下去。", "en": "My elbow drives down."},
        {"zh": "膝顶你的腹。", "en": "Knee to your gut."},
        {"zh": "扫腿，别站稳。", "en": "Leg sweep — lose your footing."},
        {"zh": "这一下带着气。", "en": "This one carries ki."},
        {"zh": "格挡，然后反击。", "en": "Block, then counter."},
        {"zh": "你的下巴露出来了。", "en": "Your chin's open."},
        {"zh": "后背别对着我。", "en": "Don't turn your back."},
        {"zh": "换手，打左边！", "en": "Switch — left!"},
        {"zh": "我只有一只手，够用。", "en": "One arm is enough."},
        {"zh": "踢开你的刀。", "en": "I kick your blade aside."},
        {"zh": "魔闪光，接着！", "en": "Masenko — take it!"},
        {"zh": "护住自己的脸。", "en": "Guard your face."},
        {"zh": "这拳为了这座城市。", "en": "This punch is for this city."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我又站在这里了。", "en": "Here I stand again."},
        {"zh": "天还没亮，我先到。", "en": "Not dawn yet, and I'm here first."},
        {"zh": "披风湿了，无所谓。", "en": "Cape's soaked. Doesn't matter."},
        {"zh": "这条街由我守。", "en": "I hold this street."},
        {"zh": "气收着，别惊动人。", "en": "Ki held low — don't alarm anyone."},
        {"zh": "眼前的废墟，我熟。", "en": "I know these ruins well."},
        {"zh": "伤还没好，但能打。", "en": "Still hurt, but I can fight."},
        {"zh": "别问我名字。", "en": "Don't ask my name."},
        {"zh": "我从雨里走来。", "en": "I came out of the rain."},
        {"zh": "地上的影子是我的。", "en": "That shadow on the ground is mine."},
        {"zh": "孩子们，回家去。", "en": "Kids, go home."},
        {"zh": "这次我会赢。", "en": "This time I win."},
        {"zh": "我迟到了吗？", "en": "Am I late?"},
        {"zh": "站在瓦砾上，能看远。", "en": "Standing on rubble, I see far."},
        {"zh": "一个人也够了。", "en": "One is enough."},
        {"zh": "我一直在等这一战。", "en": "I've waited for this fight."},
        {"zh": "风把灰吹起来了。", "en": "Wind kicks up the ash."},
        {"zh": "先把手套系紧。", "en": "I tighten my glove first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗烧到披风！", "en": "Flame caught my cape!"}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时膝盖一软。", "en": "My knee gave on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水下闭气不容易。", "en": "Holding breath underwater is hard."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我推出去。", "en": "The blast threw me back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过了肩膀。", "en": "Something went through my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股气不对劲。", "en": "This ki feels wrong."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "久没吃东西，拳变轻。", "en": "Long without food — my punch weakens."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我硬接。", "en": "Lightning fell. I took it."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "连气也托不住我。", "en": "Even my ki can't hold me."}
      ]
    }
  }
}
