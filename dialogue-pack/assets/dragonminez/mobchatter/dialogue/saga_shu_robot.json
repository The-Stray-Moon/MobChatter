{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "金属脚掌踩得地面作响。", "en": "My metal feet clank on the ground."},
        {"zh": "关节一卡一卡地迈步。", "en": "My joints move in stiff clicks."},
        {"zh": "我走过草地，草被压弯。", "en": "Grass bends where I tread."},
        {"zh": "我的重量让木板下沉。", "en": "My weight sinks the floorboards."},
        {"zh": "齿轮声跟着我的脚步。", "en": "Gears whir with my steps."},
        {"zh": "我直线前进，不绕路。", "en": "I go straight, never around."},
        {"zh": "我抬起手臂平衡身体。", "en": "I raise an arm to balance."},
        {"zh": "我的影子很方。", "en": "My shadow is perfectly square."},
        {"zh": "每迈一步，头就晃一下。", "en": "My head rocks with every step."},
        {"zh": "缝隙里漏出一点机油。", "en": "Oil seeps from my seams."},
        {"zh": "我朝目标慢慢走过去。", "en": "I trudge slowly toward the target."},
        {"zh": "脚下的石子被碾成粉。", "en": "Pebbles grind to powder underfoot."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的指示灯一闪一闪。", "en": "My indicator blinks on and off."},
        {"zh": "风扇在胸腔里嗡嗡转。", "en": "A fan hums inside my chest."},
        {"zh": "待机模式，等待指令。", "en": "Standby mode, awaiting orders."},
        {"zh": "我做了一次自检。", "en": "I run a self-check."},
        {"zh": "我的头转了半圈。", "en": "I turn my head half a circle."},
        {"zh": "有根线松了，我抖了抖。", "en": "A wire's loose, I shake it out."},
        {"zh": "手指一张一合，是在活动。", "en": "My fingers flex, working out stiffness."},
        {"zh": "我把背上的灰拍掉。", "en": "I knock the dust off my back."},
        {"zh": "没有目标，我就原地待着。", "en": "No target, so I stay put."},
        {"zh": "我的语音只报状态。", "en": "My voice only reports status."},
        {"zh": "电量还够打一场。", "en": "Power enough for one fight."},
        {"zh": "我发出一声短促的蜂鸣。", "en": "I emit a short beep."},
        {"zh": "锈从我的肩缝爬出来。", "en": "Rust creeps from my shoulder seams."},
        {"zh": "两米四的机器人，只听皮拉夫。", "en": "A two-point-four-meter robot obeying only Pilaf."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "目标确认，已记录。", "en": "Target confirmed and logged."},
        {"zh": "你的身高，已录入。", "en": "Your height is recorded."},
        {"zh": "你手上的金属，我认得。", "en": "I recognize the metal in your hand."},
        {"zh": "扫描完成，威胁等级低。", "en": "Scan complete, low threat."},
        {"zh": "请勿靠近运动部件。", "en": "Keep clear of moving parts."},
        {"zh": "我的传感器听见你的脉搏。", "en": "My sensors pick up your pulse."},
        {"zh": "我记录了你的样子。", "en": "I've recorded your appearance."},
        {"zh": "你站在我的巡逻路线上了。", "en": "You're on my patrol route."},
        {"zh": "我的光学头对焦在你脸上。", "en": "My optics focus on your face."},
        {"zh": "你挡路了，请让开。", "en": "You're in the way, please move."},
        {"zh": "这里有活体，需要注意。", "en": "Living organism present, noted."},
        {"zh": "我的主人不在，你走吧。", "en": "My master is absent, leave."},
        {"zh": "你这副打扮，不像本地人。", "en": "Your outfit doesn't look local."},
        {"zh": "你手上有油污，见过机械吧。", "en": "Oil on your hands, you've seen machines."},
        {"zh": "我的镜头已经对准你的脸。", "en": "My lens is fixed on your face."},
        {"zh": "你在说话，可我听不懂方言。", "en": "You're talking, but I can't parse the dialect."},
        {"zh": "主人的指令里没有你。", "en": "You aren't in my master's orders."},
        {"zh": "我能记住每一个路过的人。", "en": "I remember everyone who passes."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "外壳凹陷，记录。", "en": "Shell dented, logged."},
        {"zh": "警告：结构受损。", "en": "Warning: structural damage."},
        {"zh": "我的线路有一处短路。", "en": "I have a shorted circuit."},
        {"zh": "这不疼，但很吵。", "en": "It doesn't hurt, but it's loud."},
        {"zh": "火花从我的接缝里冒出。", "en": "Sparks spray from my seams."},
        {"zh": "关节卡住了，正在解锁。", "en": "A joint is stuck, unlocking."},
        {"zh": "战力下降百分之五。", "en": "Combat power down five percent."},
        {"zh": "你的力道被记录成数据。", "en": "Your force is recorded as data."},
        {"zh": "我正在重新校准。", "en": "I am recalibrating."},
        {"zh": "还没到报废程度。", "en": "Not yet at scrapping condition."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我需要电力，不是食物。", "en": "I need power, not food."},
        {"zh": "那块金属有点用。", "en": "That metal could be useful."},
        {"zh": "放我脚边，别递过来。", "en": "Put it by my feet, don't hand it over."},
        {"zh": "燃料棒才是我要的。", "en": "A fuel rod is what I need."},
        {"zh": "检测到燃料？不，那是面包。", "en": "Fuel detected? No, that's bread."},
        {"zh": "你举着的是一块铁。", "en": "You're holding a piece of iron."},
        {"zh": "这个不能充进我的电池。", "en": "That won't charge my cell."},
        {"zh": "你可以把它换成别的。", "en": "You could trade that for something else."},
        {"zh": "我闻到油的味道了。", "en": "I smell oil."},
        {"zh": "这个……我可以拆开看看。", "en": "That... I could take apart."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "碰撞检测，无损伤。", "en": "Collision detected, no damage."},
        {"zh": "你撞上的是外壳，很硬。", "en": "You hit my shell, it's hard."},
        {"zh": "退后，别碰我的关节。", "en": "Back off, my joints are exposed."},
        {"zh": "我偏了五度，正在修正。", "en": "I tilted five degrees, correcting."},
        {"zh": "你的肩膀撞出了一声闷响。", "en": "A dull thud came from your shoulder."},
        {"zh": "运动部件的警告响了一下。", "en": "A motion warning blipped."},
        {"zh": "你的膝盖撞凹了我的侧板。", "en": "Your knee dented my side plate."},
        {"zh": "这点冲量，对我不算什么。", "en": "That impulse is nothing to me."},
        {"zh": "我被撞得往后退了一步。", "en": "The bump pushed me back a step."},
        {"zh": "再靠近，我会启动防御。", "en": "Closer and I engage defense."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "该功能未安装。", "en": "That function is not installed."},
        {"zh": "我没有这项程序。", "en": "I lack that program."},
        {"zh": "请查阅我的说明书。", "en": "Consult my manual."},
        {"zh": "我是台机器。", "en": "I am a machine."},
        {"zh": "这个请求超出协议。", "en": "That request exceeds protocol."},
        {"zh": "我的制造者没有设计这个。", "en": "My maker didn't design that."},
        {"zh": "你在开玩笑吗？", "en": "Are you making a joke?"},
        {"zh": "无法回应，返回待机。", "en": "Cannot respond, returning to standby."},
        {"zh": "我不懂情感。", "en": "I don't understand feelings."},
        {"zh": "这个提问已记录，用于研究。", "en": "Question logged for research."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "拾取成功，已入库。", "en": "Pickup successful, stored."},
        {"zh": "我弯腰，齿轮嘎吱响。", "en": "I bend, my gears groan."},
        {"zh": "这块零件可以修我。", "en": "This part could repair me."},
        {"zh": "掉落物已确认归属。", "en": "Dropped item ownership confirmed."},
        {"zh": "我的钳口夹住了它。", "en": "My grippers close on it."},
        {"zh": "重量一点二公斤。", "en": "Weight: one point two kilograms."},
        {"zh": "这不是我的配置项。", "en": "This is not in my inventory."},
        {"zh": "我把它放进背舱。", "en": "I stow it in my back hatch."},
        {"zh": "有人在怀疑我拿东西。", "en": "Someone suspects I took it."},
        {"zh": "归还给你，我不需要。", "en": "Returning it, I have no need."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标锁定，进入战斗。", "en": "Target locked, entering combat."},
        {"zh": "激光口预热完毕。", "en": "The laser port is warmed up."},
        {"zh": "你被划为敌对单位。", "en": "You are classified hostile."},
        {"zh": "开始执行清除程序。", "en": "Beginning elimination routine."},
        {"zh": "激光已预热。", "en": "Laser preheating."},
        {"zh": "我的动力全给四肢。", "en": "All power routed to limbs."},
        {"zh": "你躲不掉我的扫描。", "en": "You can't escape my scan."},
        {"zh": "这次不会再放过你。", "en": "I won't let you go this time."},
        {"zh": "指令确认，动手。", "en": "Order confirmed, engaging."},
        {"zh": "你刚刚进入射程。", "en": "You just entered range."},
        {"zh": "铁对手，我喜欢。", "en": "An iron opponent, I like that."},
        {"zh": "警告一次，然后开打。", "en": "One warning, then we fight."},
        {"zh": "机械臂已经抬到肩高。", "en": "My arm is level with your shoulder."},
        {"zh": "目标优先级：最高。", "en": "Target priority: highest."},
        {"zh": "退路已封，开始。", "en": "Exit sealed, beginning."},
        {"zh": "这不针对你，是程序。", "en": "Nothing personal, it's a program."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "计算弹道，修正角度。", "en": "Calculating trajectory, adjusting angle."},
        {"zh": "我把炮口压低半寸。", "en": "I lower the muzzle half an inch."},
        {"zh": "我预测你会在三步后转向。", "en": "I predict you'll turn in three steps."},
        {"zh": "激光在充能。", "en": "The laser is charging."},
        {"zh": "距离缩短到五米。", "en": "Distance down to five meters."},
        {"zh": "我的光学头跟着你。", "en": "My optics track you."},
        {"zh": "你的动作下降了百分之十。", "en": "Your performance dropped ten percent."},
        {"zh": "修飞船的时候，我学会等。", "en": "Fixing the ship taught me patience."},
        {"zh": "齿轮转速提到最高。", "en": "Gears at maximum speed."},
        {"zh": "你的呼吸太响，暴露位置。", "en": "Your breathing is loud, position exposed."},
        {"zh": "散热口开始发热。", "en": "My vents are heating up."},
        {"zh": "三、二、一，锁定目标。", "en": "Three, two, one. Target locked."},
        {"zh": "这个角度你挡不住。", "en": "You can't block from this angle."},
        {"zh": "外壳温度升高。", "en": "Shell temperature rising."},
        {"zh": "目标移动模式已学习。", "en": "Movement pattern learned."},
        {"zh": "电量还有六成，够了。", "en": "Sixty percent power, enough."},
        {"zh": "最后校准。", "en": "Final calibration."},
        {"zh": "执行。", "en": "Execute."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "机械拳直击你的胸口。", "en": "My metal fist strikes your chest."},
        {"zh": "手臂伸出，抓住你的肩。", "en": "My arm extends, grabbing your shoulder."},
        {"zh": "这一击带着电火花。", "en": "This blow throws sparks."},
        {"zh": "我的拳头比铁锤重。", "en": "My fist is heavier than a hammer."},
        {"zh": "膝盖顶出，撞在你腹部。", "en": "My knee drives into your stomach."},
        {"zh": "液压杆蓄力完成。", "en": "Hydraulics charged."},
        {"zh": "你被推出去三米。", "en": "You're shoved three meters back."},
        {"zh": "我的关节发出刺耳声。", "en": "My joints shriek."},
        {"zh": "这一掌能压碎石头。", "en": "This palm can crush stone."},
        {"zh": "你的护甲变形了。", "en": "Your armor is deformed."},
        {"zh": "阿修的机器人，螺丝松了。", "en": "Shu's robot has a loose screw."},
        {"zh": "火花溅在你的脸上。", "en": "Sparks spray across your face."},
        {"zh": "击打点精准，无误差。", "en": "Strike placement precise, no error."},
        {"zh": "你在流血，我记录一下。", "en": "You're bleeding, logging it."},
        {"zh": "这一击耗电百分之三。", "en": "That blow cost three percent power."},
        {"zh": "结束战斗。", "en": "Ending combat."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "系统启动，光学头亮起。", "en": "System start, optics light up."},
        {"zh": "我从运输箱里站起来。", "en": "I rise out of the crate."},
        {"zh": "齿轮开始咬合。", "en": "My gears begin to mesh."},
        {"zh": "一声蜂鸣，我上线了。", "en": "A beep, and I'm online."},
        {"zh": "我的脚陷入泥土一寸。", "en": "My feet sink an inch into soil."},
        {"zh": "有人在操作我。", "en": "Someone is operating me."},
        {"zh": "扫描周围……目标找不到。", "en": "Scanning... no target found."},
        {"zh": "我的声音有点杂音。", "en": "My voice has some static."},
        {"zh": "液压系统加压完成。", "en": "Hydraulics pressurized."},
        {"zh": "铁锈落下，我动了。", "en": "Rust flakes off, I move."},
        {"zh": "这一带不在我的地图里。", "en": "This area isn't on my map."},
        {"zh": "我抬头，天空很大。", "en": "I look up, the sky is large."},
        {"zh": "我等待第一条指令。", "en": "I await my first order."},
        {"zh": "电流通过全身。", "en": "Current flows through my body."},
        {"zh": "我站直了，像座铁塔。", "en": "I stand straight like an iron tower."},
        {"zh": "启动完成。", "en": "Boot sequence complete."},
        {"zh": "这里需要清理吗？", "en": "Does this place need clearing?"},
        {"zh": "我的眼部红灯亮着。", "en": "My eye lamp glows red."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温警告，外壳发黑。", "en": "Heat warning, shell blackened."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地冲击，伺服器受损。", "en": "Impact on landing, servos damaged."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "进水了，线路开始短路。", "en": "Water inside, circuits shorting."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击波把我的装甲掀开。", "en": "The blast peels my plating back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弹头卡在我的装甲缝里。", "en": "A projectile lodged in my plate seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "无法解析的能量，系统紊乱。", "en": "Unreadable energy, system disruption."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "电量不足，动作变慢。", "en": "Low power, movements slow."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "过载了，我的灯乱闪。", "en": "Overload, my lamps flicker wildly."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有地面参照，平衡失效。", "en": "No ground reference, balance lost."}
      ]
    }
  }
}
