{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我低空掠过去", "en": "I skim low across the ground."},
        {"zh": "残影留在原地", "en": "An afterimage stays behind."},
        {"zh": "我一闪就到了", "en": "One blink and I am there."},
        {"zh": "气在脚下炸开", "en": "Ki bursts under my feet."},
        {"zh": "我绕着圈靠近", "en": "I close in while circling."},
        {"zh": "速度比脚步更快", "en": "Faster than walking pace."},
        {"zh": "我把气收在背后", "en": "I keep my ki behind me."},
        {"zh": "地面被我踩出坑", "en": "My landing cracks the ground."},
        {"zh": "我斜着冲过去", "en": "I rush in at an angle."},
        {"zh": "风被我推开", "en": "I shove the air aside."},
        {"zh": "我踩过一道黑影", "en": "I leave a dark streak."},
        {"zh": "我低头前进", "en": "I advance with my head low."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在等身体长成", "en": "I wait for this body to mature."},
        {"zh": "力量还在积累", "en": "The power is still building."},
        {"zh": "远处有人吗", "en": "Is someone out there?"},
        {"zh": "气绕着我打转", "en": "Ki swirls around me."},
        {"zh": "这具身体还差一点", "en": "This body is almost ready."},
        {"zh": "我握着拳不动", "en": "I hold my fist still."},
        {"zh": "我能感觉到血在烧", "en": "I feel my blood burning."},
        {"zh": "别把我当孩子", "en": "Do not take me for a child."},
        {"zh": "变身的门还没打开", "en": "The door to transformation is still shut."},
        {"zh": "我的气在变重", "en": "My ki grows heavy."},
        {"zh": "时间还没到", "en": "The moment is not here yet."},
        {"zh": "我不需要休息", "en": "I do not need rest."},
        {"zh": "我笑得有点勉强", "en": "My smile is a little strained."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的气我看透了", "en": "I have read your ki."},
        {"zh": "你打不过我", "en": "You cannot beat me."},
        {"zh": "你身上有赛亚人的味道", "en": "You smell of a Saiyan."},
        {"zh": "你差半步就贴到我了", "en": "Half a step more and you are on me."},
        {"zh": "你手里的武器放低", "en": "Lower that weapon."},
        {"zh": "我记得输过的滋味", "en": "I know what losing tastes like."},
        {"zh": "这次不会了", "en": "Not this time."},
        {"zh": "你也是来试探我的", "en": "So you came to test me too."},
        {"zh": "我要看你到底多强", "en": "Let me see how strong you are."},
        {"zh": "你的呼吸在抖", "en": "Your breath is shaking."},
        {"zh": "你在算能不能跑", "en": "You are wondering if you can run."},
        {"zh": "别指望我手下留情", "en": "Do not hope for mercy."},
        {"zh": "我的气还没全开", "en": "I have not opened my full power."},
        {"zh": "你先动手吧", "en": "You strike first."},
        {"zh": "你的影子落在我脚边", "en": "Your shadow falls at my feet."},
        {"zh": "这一眼就够了", "en": "That look was enough."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中了我", "en": "You landed a hit."},
        {"zh": "这具身体还不够", "en": "This body is not enough."},
        {"zh": "我咬着牙", "en": "I grit my teeth."},
        {"zh": "血从指尖滴下去", "en": "Blood drips from my fingertips."},
        {"zh": "气乱了一瞬", "en": "My ki faltered an instant."},
        {"zh": "我向后滑了一步", "en": "I slid back one step."},
        {"zh": "别得意", "en": "Do not get smug."},
        {"zh": "我记着这一下", "en": "I will remember that."},
        {"zh": "我的怒气上来了", "en": "My anger is rising."},
        {"zh": "越打我会越强", "en": "The more you hit, the stronger I get."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那点能量归我", "en": "That energy is mine."},
        {"zh": "你身上有股活气", "en": "There is living ki on you."},
        {"zh": "我先吸一口", "en": "Let me sip first."},
        {"zh": "别把东西收回去", "en": "Do not put it away."},
        {"zh": "食物？太慢了", "en": "Food? Too slow."},
        {"zh": "我靠近你的手", "en": "I lean toward your hand."},
        {"zh": "那股气在跳", "en": "That ki is pulsing."},
        {"zh": "我要的不是这个", "en": "That is not what I want."},
        {"zh": "你这点诱饵不够", "en": "Your bait is not enough."},
        {"zh": "那就拿过来", "en": "Then hand it over."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我的气", "en": "You hit my ki."},
        {"zh": "别碰我的肩", "en": "Do not touch my shoulder."},
        {"zh": "我一步都没退", "en": "I did not step back."},
        {"zh": "你被弹开了吧", "en": "You bounced off, did you not?"},
        {"zh": "你的关节在响", "en": "Your joints are creaking."},
        {"zh": "别挤过来", "en": "Stop pushing in."},
        {"zh": "一撞就见高低", "en": "One bump shows the difference."},
        {"zh": "我连眼睛都没眨", "en": "I did not even blink."},
        {"zh": "你退两步再说话", "en": "Take two steps back before speaking."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没这个耐心", "en": "I have no patience for this."},
        {"zh": "别站旁边看", "en": "Do not stand and watch."},
        {"zh": "这身体不属于我", "en": "This body is not mine."},
        {"zh": "做完就走", "en": "Done, then I leave."},
        {"zh": "我不习惯这种温度", "en": "I am not used to this warmth."},
        {"zh": "别说话", "en": "Say nothing."},
        {"zh": "你最好忘掉", "en": "You had better forget it."},
        {"zh": "很快就会结束", "en": "It will be over soon."},
        {"zh": "我不想留下痕迹", "en": "I do not want to leave traces."},
        {"zh": "这不算什么", "en": "This means nothing."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个我要了", "en": "I will take this."},
        {"zh": "我一把抓过来", "en": "I snatch it up."},
        {"zh": "掉的东西没人捡", "en": "Nobody picked up what fell."},
        {"zh": "我塞进腰带", "en": "I stuff it into my belt."},
        {"zh": "这点东西不值一提", "en": "This is worth nothing."},
        {"zh": "我收着备用", "en": "I will keep it in reserve."},
        {"zh": "捡东西不费时间", "en": "Collecting costs no time."},
        {"zh": "我能用上", "en": "I can use this."},
        {"zh": "算我的战利品", "en": "Loot of mine, then."},
        {"zh": "别想拿回去", "en": "Do not think of taking it back."}
      ]
