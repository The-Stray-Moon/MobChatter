{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在空中缓缓滑过。", "en": "I glide slowly through the air."},
        {"zh": "脚下什么也踩不到。", "en": "There's nothing under my feet."},
        {"zh": "头发飘在身后。", "en": "My hair streams behind me."},
        {"zh": "我绕着你半圈。", "en": "I circle half around you."},
        {"zh": "气托着我升高。", "en": "Ki lifts me higher."},
        {"zh": "这副身子轻得很。", "en": "This body is very light."},
        {"zh": "一步就跨过树顶。", "en": "One stride clears the treetops."},
        {"zh": "我不需要落地。", "en": "I don't need to land."},
        {"zh": "风从我耳边掠过。", "en": "The wind slips past my ear."},
        {"zh": "飞行的节奏我熟。", "en": "I know the rhythm of flight."},
        {"zh": "先从高处看你。", "en": "I'll look at you from above first."},
        {"zh": "再靠近我一点。", "en": "A little closer."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在半空不动。", "en": "I hang motionless."},
        {"zh": "气在指尖上绕。", "en": "Ki coils around my fingertips."},
        {"zh": "这姿势很省力。", "en": "This posture costs nothing."},
        {"zh": "我垂眼看着下面。", "en": "I look down from half-lidded eyes."},
        {"zh": "我不喜欢站着。", "en": "I dislike standing."},
        {"zh": "头发落在肩上。", "en": "My hair settles on my shoulder."},
        {"zh": "手心有一点小气弹。", "en": "A small ki blast sits in my palm."},
        {"zh": "风把衣角吹开。", "en": "Wind pulls at my hem."},
        {"zh": "我的残影，你看得见几个？", "en": "How many of my afterimages do you see?"},
        {"zh": "这层高度正好。", "en": "This height is just right."},
        {"zh": "我看到了远处的东西。", "en": "I see something far off."},
        {"zh": "再高一点会更好。", "en": "A little higher would be better."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头看的样子真好笑。", "en": "The way you look up is amusing."},
        {"zh": "你够得到我吗？", "en": "Can you reach me?"},
        {"zh": "别用眼睛量我的斤两。", "en": "Do not size me up with your eyes."},
        {"zh": "你的气弱得可怜。", "en": "Your ki is pitifully weak."},
        {"zh": "站在那儿别动。", "en": "Stand there and don't move."},
        {"zh": "你身上有股泥土味。", "en": "You smell of dirt."},
        {"zh": "我下手不会太快。", "en": "I won't strike too quickly."},
        {"zh": "你眼睛里的东西我看得懂。", "en": "I can read what's in your eyes."},
        {"zh": "下面那些人值得你拼吗？", "en": "Are those people below worth it?"},
        {"zh": "我不习惯跟人平视。", "en": "I'm not used to meeting eyes level."},
        {"zh": "你的呼吸我数得清。", "en": "I can count your breaths."},
        {"zh": "别想着跳上来。", "en": "Don't think about jumping up."},
        {"zh": "我看你像在看虫子。", "en": "I look at you the way one looks at a bug."},
        {"zh": "你说完了没有？", "en": "Are you finished talking?"},
        {"zh": "这高度你打不到。", "en": "You can't hit this height."},
        {"zh": "我允许你多说一句。", "en": "I'll allow one more sentence."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你居然能打到我。", "en": "You actually hit me."},
        {"zh": "我退到半空里去。", "en": "I retreat into the air."},
        {"zh": "这一击打得我气息一晃。", "en": "That had weight."},
        {"zh": "我的气被震散了。", "en": "My ki was scattered."},
        {"zh": "我咬着牙稳住姿势。", "en": "I grit my teeth and steady my flight."},
        {"zh": "我的头发乱了一缕。", "en": "One strand of my hair is out of place."},
        {"zh": "你的运气不错。", "en": "You got lucky."},
        {"zh": "能碰到我，算你有几分本事。", "en": "Touching me means you've got some skill."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你以为我会为吃的下来？", "en": "You think I'd come down for food?"},
        {"zh": "那东西我不感兴趣。", "en": "That doesn't interest me."},
        {"zh": "你手上举的是什么？", "en": "What's that you're holding up?"},
        {"zh": "我不是野生的。", "en": "I'm not some wild creature."},
        {"zh": "这东西配不上我。", "en": "That's beneath me."},
        {"zh": "收起来，别晃了。", "en": "Put it away; stop waving it."},
        {"zh": "我一点也不饿。", "en": "I'm not hungry."},
        {"zh": "你要是饿了，自己吃。", "en": "If you're hungry, eat it yourself."},
        {"zh": "这种手段太幼稚。", "en": "That trick is childish."},
        {"zh": "你拿它换不了什么。", "en": "You can't trade it for anything."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的气流。", "en": "You hit my slipstream."},
        {"zh": "我不落地，你撞什么？", "en": "I don't land; what are you hitting?"},
        {"zh": "这一下把我推偏了。", "en": "That pushed me off line."},
        {"zh": "脏手别来碰我。", "en": "Don't touch me with dirty hands."},
        {"zh": "你连边都没沾到。", "en": "You didn't even graze me."},
        {"zh": "退开，我要落下。", "en": "Move; I'm landing."},
        {"zh": "别挤在地面上。", "en": "Don't crowd the ground."},
        {"zh": "气流被你打乱了。", "en": "You disturbed my airflow."},
        {"zh": "再来我就在你上方停。", "en": "Try again and I'll hover above you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这说法很无礼。", "en": "That is a rude suggestion."},
        {"zh": "你在跟谁讲话？", "en": "Who do you think you're speaking to?"},
        {"zh": "我会当你没说过。", "en": "I'll pretend you didn't say that."},
        {"zh": "站远些，别问这些。", "en": "Stand back. Do not ask about that."},
        {"zh": "你的胆子越来越大了。", "en": "Your nerve keeps growing."},
        {"zh": "我没有这种打算。", "en": "That is not my intention."},
        {"zh": "别把距离搞错了。", "en": "Don't mistake our distance."},
        {"zh": "我是战士，不是宠物。", "en": "I'm a warrior, not a pet."},
        {"zh": "再说一次试试。", "en": "Say it again and see."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这是掉下来的？", "en": "Did this fall?"},
        {"zh": "我不会弯腰去捡。", "en": "I don't bend down."},
        {"zh": "我用气把它浮起来。", "en": "I lift it with ki."},
        {"zh": "这是谁的东西？", "en": "Whose is this?"},
        {"zh": "我不捡地上的。", "en": "I don't pick things off the ground."},
        {"zh": "它浮在我掌心。", "en": "It floats in my palm."},
        {"zh": "弄脏了，还给你。", "en": "It's dirty; take it back."},
        {"zh": "这个不值得留。", "en": "This isn't worth keeping."},
        {"zh": "你要的话，接着。", "en": "If you want it, catch."},
        {"zh": "我把它丢下去。", "en": "I'll drop it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的气把我惹到了。", "en": "Your ki has annoyed me."},
        {"zh": "你已经被我的气围住。", "en": "My ki already surrounds you."},
        {"zh": "从上面打更省事。", "en": "Striking from above is simpler."},
        {"zh": "你就站着别动。", "en": "Don't move."},
        {"zh": "我先给你一次机会。", "en": "I'll give you one chance first."},
        {"zh": "你的脑袋在正下方。", "en": "Your head is right below."},
        {"zh": "这一下会很快。", "en": "This will be quick."},
        {"zh": "别再抬头看了。", "en": "Stop looking up."},
        {"zh": "我慢慢数到三。", "en": "I'll count to three."},
        {"zh": "你退再远也没用。", "en": "Running won't help."},
        {"zh": "残影拳会骗你的眼。", "en": "The afterimage fist will fool your eyes."},
        {"zh": "能挡住的没几个。", "en": "Few can block this."},
        {"zh": "我从上面下来了。", "en": "I'm coming down."},
        {"zh": "你身后也有我。", "en": "There's another me behind you."},
        {"zh": "时间已经到了。", "en": "Time's up."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你的头顶飞。", "en": "I fly along above your head."},
        {"zh": "你跑，我就慢慢跟。", "en": "Run, and I'll follow at my pace."},
        {"zh": "从你头顶落下的角度最好。", "en": "The angle from above is best."},
        {"zh": "我在等你的气乱。", "en": "I'm waiting for your ki to waver."},
        {"zh": "你抬头我就下压。", "en": "Look up and I'll drop."},
        {"zh": "这点距离我一瞬就到。", "en": "I cross that gap in an instant."},
        {"zh": "你把背对着我。", "en": "You've got your back to me."},
        {"zh": "再跑十步就到墙。", "en": "Ten more steps and you hit a wall."},
        {"zh": "我想看你怎么挣扎。", "en": "I want to watch you struggle."},
        {"zh": "气流已经绕住你。", "en": "The currents already circle you."},
        {"zh": "你走位太直了。", "en": "You run too straight."},
        {"zh": "我不用落地也能出手。", "en": "I can strike without landing."},
        {"zh": "你的同伴在哪？", "en": "Where's your partner?"},
        {"zh": "再往下一点就行。", "en": "Just a little lower."},
        {"zh": "我在你上方，离你两格。", "en": "I'm two blocks above you."},
        {"zh": "你刚才那下很聪明。", "en": "That move was clever."},
        {"zh": "不过还不够看。", "en": "But not enough."},
        {"zh": "这最后一下我留给你。", "en": "I'll save this last one for you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "从上方的一击。", "en": "A strike from above."},
        {"zh": "气弹贴脸炸开。", "en": "The blast bursts at your face."},
        {"zh": "这是连击第一段。", "en": "First hit of the combo."},
        {"zh": "你的护臂挡不住。", "en": "Your guard can't hold."},
        {"zh": "我从你侧面掠过。", "en": "I sweep past your flank."},
        {"zh": "这一下轻，只是提醒。", "en": "That was light; just a reminder."},
        {"zh": "你被打得跪下去了。", "en": "You were knocked to your knees."},
        {"zh": "风压让地面扬尘。", "en": "My wake kicks dust off the ground."},
        {"zh": "别磨蹭，我还有事。", "en": "Do not dawdle; I have things to do."},
        {"zh": "第二段紧跟着来。", "en": "Second hit incoming."},
        {"zh": "你的气防有破口。", "en": "Your ki guard has a gap."},
        {"zh": "这一击打在你肩上。", "en": "That one hit your shoulder."},
        {"zh": "给我滚到一边去。", "en": "Get out of my way."},
        {"zh": "这还没结束呢。", "en": "Not finished yet."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从上面过来。", "en": "I come from above."},
        {"zh": "这地方的风不错。", "en": "Good wind in this place."},
        {"zh": "这里的空气太沉。", "en": "The air is too heavy here."},
        {"zh": "谁在这里站着？", "en": "Who's here?"},
        {"zh": "我先悬停一会儿。", "en": "I'll hover a moment."},
        {"zh": "地面看起来很远。", "en": "The ground looks distant."},
        {"zh": "我的气还很稳。", "en": "My ki is steady."},
        {"zh": "这里的人很弱。", "en": "The people here are weak."},
        {"zh": "树顶正好落脚。", "en": "The treetops suit me."},
        {"zh": "我抖掉衣角上的尘。", "en": "I shake the dust from my hem."},
        {"zh": "空中转了一圈。", "en": "I turn once in the air."},
        {"zh": "来吧，别躲着了。", "en": "Come."},
        {"zh": "这个高度我喜欢。", "en": "I like this altitude."},
        {"zh": "下面有个活物。", "en": "Something living below."},
        {"zh": "我已经看见你了。", "en": "I see you."},
        {"zh": "把气往上提一提。", "en": "Lift the ki upward."},
        {"zh": "那我们就开始。", "en": "Begin."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过来，我侧身避开半招。", "en": "Fire swept at me; I dodged half of it."}
      ]
    },
