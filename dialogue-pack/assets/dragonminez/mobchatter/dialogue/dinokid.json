        {"zh": "你闻起来很好吃", "en": "You smell tasty."},
        {"zh": "你是大恐龙吗", "en": "Are you a big dinosaur?"},
        {"zh": "你的手指好长", "en": "Your fingers are so long."},
        {"zh": "你要蹲下来吗", "en": "Are you going to crouch down?"},
        {"zh": "你踩着我的影子了", "en": "You stepped on my shadow."},
        {"zh": "我们能不能一起走", "en": "Could we walk together?"},
        {"zh": "我张嘴给你看牙", "en": "I open my mouth to show my teeth."},
        {"zh": "你别靠太近", "en": "Do not come too close."},
        {"zh": "我斜着眼睛瞧你", "en": "I squint up at you."},
        {"zh": "你在藏什么好吃", "en": "What tasty thing are you hiding?"}
      ]
    },
    "hurt": {
