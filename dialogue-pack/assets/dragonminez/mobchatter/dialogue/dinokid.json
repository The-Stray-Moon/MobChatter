  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着小短腿", "en": "I waddle along on short legs."},
        {"zh": "尾巴帮我平衡", "en": "My tail keeps me balanced."},
        {"zh": "我跟在大的后面", "en": "I trail behind the big ones."},
        {"zh": "爪子踩得土响", "en": "My claws crunch on the dirt."},
        {"zh": "我一边走一边闻", "en": "I sniff as I walk."},
        {"zh": "红土粘上我的脚", "en": "Red dirt sticks to my feet."},
        {"zh": "我走三步跳一下", "en": "Three steps, then a hop."},
        {"zh": "我小心绕过石头", "en": "I pick my way around stones."},
        {"zh": "山坡很陡，我慢慢走", "en": "The slope is steep, so I go slow."},
        {"zh": "我叫一声再走", "en": "I chirp once, then move on."},
        {"zh": "我追着一只虫子跑", "en": "I chase after a bug."},
        {"zh": "小恐龙走路晃", "en": "A baby dinosaur walks with a wobble."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这等大恐龙", "en": "I wait here for the big ones."},
        {"zh": "阳光晒着背很舒服", "en": "The sun feels good on my back."},
        {"zh": "我咬着尾巴玩", "en": "I chew on my own tail."},
        {"zh": "有东西动了一下", "en": "Something moved just now."},
        {"zh": "我刨了刨土", "en": "I scratched at the dirt."},
        {"zh": "我肚子一直咕咕叫。", "en": "My belly keeps growling."},
        {"zh": "我蹲在草里", "en": "I crouch down in the grass."},
        {"zh": "风把我的气味吹走了", "en": "The wind carries my scent away."},
        {"zh": "我抬头找声音", "en": "I raise my head toward the noise."},
        {"zh": "别把我当石头", "en": "Do not mistake me for a rock."},
        {"zh": "我舔舔爪子", "en": "I lick my claws."},
        {"zh": "这地方有点干", "en": "It is rather dry here."},
        {"zh": "我想睡了", "en": "I feel sleepy."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
