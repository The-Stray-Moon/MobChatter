        {"zh": "我往后蹦了一步", "en": "I hop back a step."},
        {"zh": "好疼，好疼", "en": "It hurts, it hurts."},
        {"zh": "我叫得更大声", "en": "I screech louder."},
        {"zh": "我掉了一颗小牙", "en": "I lost a little tooth."},
        {"zh": "我躲到石头后面", "en": "I duck behind a rock."},
        {"zh": "你还真要打我", "en": "You really are going to hit me."}
      ]
    },
    "tempted": {
