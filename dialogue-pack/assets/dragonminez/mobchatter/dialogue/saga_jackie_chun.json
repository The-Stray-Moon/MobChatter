{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "龟仙流，起步先热身。", "en": "Turtle school: warm up before you walk."},
        {"zh": "我走得很稳，像背着龟壳。", "en": "I walk steady, as if carrying a shell."},
        {"zh": "别看我年纪大，脚底有劲。", "en": "Old, maybe, but my feet are strong."},
        {"zh": "每一步都在练下盘。", "en": "Every step trains my stance."},
        {"zh": "走两步，抖抖手腕。", "en": "Two steps, then I shake my wrists."},
        {"zh": "这身子是练出来的。", "en": "This body was built by training."},
        {"zh": "我绕场一圈，看看对手。", "en": "I circle the yard to size up foes."},
        {"zh": "步子轻，落地却稳。", "en": "Light steps, firm landings."},
        {"zh": "我戴着假发，也戴着帽子。", "en": "The wig and the hat both stay on."},
        {"zh": "走路也在调呼吸。", "en": "Even walking, I pace my breathing."},
        {"zh": "腰挺直，别驼背。", "en": "Back straight, no slouching."},
        {"zh": "年轻人，跟着我走。", "en": "Young one, walk with me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站桩，一站就是一小时。", "en": "Stance training — one hour, easy."},
        {"zh": "我抖了抖袖子上的灰。", "en": "I shake the dust from my sleeve."},
        {"zh": "呼吸绵长，气沉丹田。", "en": "Breath long, ki sunk low."},
        {"zh": "假发有点歪，扶一下。", "en": "The wig slipped; I fix it."},
        {"zh": "心静，手就不抖。", "en": "Quiet mind, steady hands."},
        {"zh": "这片刻的静，也是修行。", "en": "This stillness is training too."},
        {"zh": "我眯眼看了看太阳。", "en": "I squint up at the sun."},
        {"zh": "老夫在场，年轻人别急。", "en": "I'm here; no need to rush."},
        {"zh": "腰马合一，重心下沉。", "en": "Hips and stance as one, weight low."},
        {"zh": "风吹过来，衣角动了。", "en": "The wind stirs my clothes."},
        {"zh": "我在心里复盘刚才的招式。", "en": "I replay the last move in my head."},
        {"zh": "不动，是在听气。", "en": "Stillness, to listen for ki."},
        {"zh": "掌心的老茧，还没退。", "en": "The calluses on my palms remain."},
        {"zh": "今天状态不错。", "en": "Good form today."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的架势，一看就没练过。", "en": "Your stance says you've never trained."},
        {"zh": "腰太软，脚下太轻。", "en": "Weak hips, unsteady feet."},
        {"zh": "别急着动手，先站稳。", "en": "Don't rush in; find your footing."},
        {"zh": "老夫看得上的人不多。", "en": "Few impress me."},
        {"zh": "你的气，还算有点意思。", "en": "Your ki is somewhat interesting."},
        {"zh": "想学龟仙流？先跑步。", "en": "Want the Turtle school? Start running."},
        {"zh": "我笑一笑，不代表手下留情。", "en": "My smile doesn't mean mercy."},
        {"zh": "你这拳头，太直了。", "en": "Your punch is too straight."},
        {"zh": "我当年也是从你这样练起的。", "en": "I started out just like you."},
        {"zh": "行，够格和我过两招。", "en": "Fine, you're worth a few exchanges."},
        {"zh": "站好了，我可不打招呼。", "en": "Stand ready; I don't announce myself."},
        {"zh": "你的气已经散了。", "en": "Your ki has scattered."},
        {"zh": "帽子压低，我认真了。", "en": "Hat low — now I'm serious."},
        {"zh": "这身本事，不是白来的。", "en": "This skill wasn't free."},
        {"zh": "你要学的，还多着呢。", "en": "You have much yet to learn."},
        {"zh": "别用蛮力，用气。", "en": "Not brute force — use ki."},
        {"zh": "年轻人，先出手吧。", "en": "Young one, you strike first."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "好拳！可惜还不够。", "en": "Good punch! Not enough, though."},
        {"zh": "我退了半步，卸了力。", "en": "I step back and shed the force."},
        {"zh": "疼？这点不算什么。", "en": "Pain? This is nothing."},
        {"zh": "老夫挨过的打，多了。", "en": "I've taken far worse."},
        {"zh": "袖口破了，可惜。", "en": "My sleeve tore — a pity."},
        {"zh": "稳住下盘，别倒。", "en": "Hold the stance; don't fall."},
        {"zh": "你手上有两下子。", "en": "You've got some skill."},
        {"zh": "牙关咬紧，继续。", "en": "I grit my teeth and continue."},
        {"zh": "老骨头，也会响。", "en": "Old bones creak too."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "食物？练完再说。", "en": "Food? After training."},
        {"zh": "你这点东西，不够我塞牙。", "en": "That won't fill a tooth gap."},
        {"zh": "我闻到了，但不为所动。", "en": "I smell it, and I'm unmoved."},
        {"zh": "龟仙流的修行，先戒嘴。", "en": "The Turtle school starts with the mouth."},
        {"zh": "老夫见过的美食多了。", "en": "I've seen finer meals than that."},
        {"zh": "你拿这个来试我？", "en": "You test me with that?"},
        {"zh": "肚子叫了，也得忍着。", "en": "My belly growls; I endure it."},
        {"zh": "吃太饱，出拳会慢。", "en": "A full belly slows the punch."},
        {"zh": "练武之人，不贪口腹。", "en": "A martial artist isn't greedy."},
        {"zh": "收起来吧，我不需要。", "en": "Put it away; I don't need it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "站不稳，说明下盘虚。", "en": "Unsteady footing means a weak stance."},
        {"zh": "撞我？我纹丝不动。", "en": "Ram me? I don't shift."},
        {"zh": "借你的力，转个身。", "en": "I borrow your force and turn."},
        {"zh": "脚下生根，推不动的。", "en": "Rooted to the ground."},
        {"zh": "年轻人，走路看路。", "en": "Watch where you walk, young one."},
        {"zh": "这一撞，算你练过。", "en": "That impact says you've trained."},
        {"zh": "力气不小，可惜太散。", "en": "Plenty of force, poorly focused."},
        {"zh": "我的肩，比你想的硬。", "en": "My shoulder is harder than you think."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这把年纪了，还谈这个？", "en": "At my age, this again?"},
        {"zh": "老夫心中只有修行。", "en": "My heart holds only training."},
        {"zh": "你不嫌我戴假发？", "en": "You don't mind the wig?"},
        {"zh": "年轻时的我，可是很受欢迎。", "en": "In my youth I was quite popular."},
        {"zh": "一起练功，也算相伴。", "en": "Training together is companionship too."},
        {"zh": "龟仙流的规矩，得守。", "en": "The Turtle school has rules."},
        {"zh": "我给她倒了杯茶。", "en": "I pour her a cup of tea."},
        {"zh": "走过半生，才懂陪伴。", "en": "Half a life gone before I understood company."},
        {"zh": "笑一笑，岁月就轻了。", "en": "A smile makes the years lighter."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这石头，正好练握力。", "en": "This rock is good for grip training."},
        {"zh": "我弯腰，膝盖还撑得住。", "en": "I bend; the knees still hold."},
        {"zh": "东西掉了，我帮你捡。", "en": "You dropped this; I'll get it."},
        {"zh": "一块布，能擦汗。", "en": "A cloth — good for wiping sweat."},
        {"zh": "这玩意儿有点沉。", "en": "This thing has weight."},
        {"zh": "包袱里塞得下。", "en": "It fits in my pack."},
        {"zh": "老习惯了，见东西就拾。", "en": "Old habit: I pick things up."},
        {"zh": "我掂了掂，估个分量。", "en": "I heft it to judge the weight."},
        {"zh": "别浪费，留着有用。", "en": "No waste; it may serve."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "来了，摆好架势。", "en": "Here it comes — take your stance."},
        {"zh": "手抬起来，掌对掌。", "en": "Hands up, palm to palm."},
        {"zh": "这场的对手，是我。", "en": "Your opponent in this round is me."},
        {"zh": "我先看看你的底。", "en": "Let me see your foundation."},
        {"zh": "气息稳，出招才快。", "en": "Steady breath makes a fast strike."},
        {"zh": "你要认真了。", "en": "Time to get serious."},
        {"zh": "帽子一摘，就是全力。", "en": "Hat off means full power."},
        {"zh": "别退，退了就输一半。", "en": "Don't back off; half the loss is retreat."},
        {"zh": "我数三下，就开打。", "en": "Three counts, then we begin."},
        {"zh": "这身肌肉，还没老。", "en": "These muscles aren't old yet."},
        {"zh": "锁定了，别想绕后。", "en": "Marked; no circling behind me."},
        {"zh": "先吃我一记试探。", "en": "Take one probing blow first."},
        {"zh": "眼睛跟上我的拳。", "en": "Keep your eyes on my fist."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你的破绽，在左肩。", "en": "Your opening is at the left shoulder."},
        {"zh": "呼吸别乱，乱了就挨打。", "en": "Don't lose your breath; that's when you're hit."},
        {"zh": "脚步跟上，别退。", "en": "Keep your feet moving; don't retreat."},
        {"zh": "老夫脚步一转，到了侧面。", "en": "One pivot and I'm at your flank."},
        {"zh": "这一招你还没见过。", "en": "You haven't seen this one."},
        {"zh": "老夫的耐心，比拳头更硬。", "en": "My patience is harder than my fist."},
        {"zh": "你在犹豫，这可不行。", "en": "Hesitation won't do."},
        {"zh": "我再靠近半步。", "en": "Half a step closer."},
        {"zh": "手腕一翻，准备出掌。", "en": "I turn my wrist, ready for the palm strike."},
        {"zh": "你挡得住第一下吗？", "en": "Can you block the first?"},
        {"zh": "你的节奏，已经被我带走了。", "en": "I've taken your rhythm."},
        {"zh": "这个距离，老夫出拳最快。", "en": "At this range my punch is fastest."},
        {"zh": "认真点，我要用力了。", "en": "Focus; I'm putting force in."},
        {"zh": "这一局，我占先。", "en": "This round, I lead."},
        {"zh": "站桩的功夫，现在用上。", "en": "Now my stance work pays off."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "龟派掌，接好！", "en": "Turtle palm — take it!"},
        {"zh": "这一拳，带气！", "en": "This punch carries ki!"},
        {"zh": "手肘回旋，再来一下。", "en": "Elbow spin, and again."},
        {"zh": "踢腿，扫你的下盘。", "en": "A kick sweeps your legs."},
        {"zh": "年轻的骨头，也不经打。", "en": "Young bones break too."},
        {"zh": "我这一掌，留了三分力。", "en": "I held back three tenths."},
        {"zh": "打完再教你。", "en": "After the hit, I'll teach you."},
        {"zh": "看清楚了，这是正拳。", "en": "Watch closely — a true straight punch."},
        {"zh": "气从脚底传到拳面。", "en": "Ki runs from my soles to my knuckles."},
        {"zh": "连击三下，别慌。", "en": "Three in a row; don't panic."},
        {"zh": "你退得太深了。", "en": "You retreated too far."},
        {"zh": "挨这一下，你会记住。", "en": "You'll remember this one."},
        {"zh": "老夫只用了七成劲。", "en": "I put only seven tenths into that."},
        {"zh": "防守！别光顾着看。", "en": "Guard! Stop just watching."},
        {"zh": "这一招，叫龟仙流。", "en": "This is the Turtle school."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "龟仙流，成龙在此。", "en": "Turtle school — Jackie Chun is here."},
        {"zh": "帽子压低，我登场了。", "en": "Hat low, I make my entrance."},
        {"zh": "这舞台，正适合比试。", "en": "This stage suits a match."},
        {"zh": "老夫来得不早不晚。", "en": "I arrive right on time."},
        {"zh": "谁在这儿等我比试？", "en": "Who's here for a match?"},
        {"zh": "先热身，再说话。", "en": "Warm up first, talk later."},
        {"zh": "假发戴正了，好。", "en": "Wig straight — good."},
        {"zh": "气息一沉，站稳。", "en": "Ki settles; my feet take root."},
        {"zh": "年轻人，别让我等。", "en": "Young one, don't keep me waiting."},
        {"zh": "我一出场，气氛就变了。", "en": "The mood shifts when I arrive."},
        {"zh": "这身子，还能打十年。", "en": "This body has ten more years in it."},
        {"zh": "地上的尘土，我踢了一脚。", "en": "I kick up the dust."},
        {"zh": "武术家登场，礼数要有。", "en": "A martial artist arrives with courtesy."},
        {"zh": "我把帽子扶了扶。", "en": "I straighten my hat."},
        {"zh": "准备好就上，别客气。", "en": "Come at me when ready."},
        {"zh": "这场，我做你的对手。", "en": "I'll be your opponent today."},
        {"zh": "气沉下去，人立起来。", "en": "Ki drops; the man stands tall."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火气扑面，眉毛都焦了。", "en": "Heat in my face; my brows are singed."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地一震，膝盖发酸。", "en": "I land hard; my knees ache."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进鼻子，气断了。", "en": "Water in my nose; my breath breaks."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀出去老远。", "en": "The blast throws me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭，钉在我袖子上。", "en": "An arrow pins my sleeve."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股怪气，压住了我的气。", "en": "Strange energy smothers my ki."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈下来，我浑身一紧。", "en": "Lightning strikes and my whole body clenches."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有地，我掉了下去。", "en": "No ground; I fall through."}
      ]
    }
  }
}
