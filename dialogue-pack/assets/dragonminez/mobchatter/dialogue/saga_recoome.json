{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "大步子，肩膀一摇一摇。", "en": "Long strides, shoulders rolling."},
        {"zh": "手臂张开，像在散步。", "en": "Arms wide, as if out for a stroll."},
        {"zh": "这身肌肉挤得衣服紧。", "en": "This muscle stretches my suit tight."},
        {"zh": "我哼着不成调的曲子。", "en": "I hum a tuneless song."},
        {"zh": "脚下的风被我踩出涡。", "en": "My steps stir the wind into eddies."},
        {"zh": "我故意走得很慢。", "en": "I walk deliberately slowly."},
        {"zh": "头发翘着，随风晃。", "en": "My hair juts up and sways in the wind."},
        {"zh": "我抬头看天，笑。", "en": "I look up at the sky and grin."},
        {"zh": "地面上的人抬头看我。", "en": "The people below look up."},
        {"zh": "我一步一步往下压。", "en": "I press down one step at a time."},
        {"zh": "骨头在响，是热身。", "en": "My bones crack — just warming up."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我摆了个姿势。", "en": "I strike a pose."},
        {"zh": "拳头对着空气挥了两下。", "en": "Two punches into empty air."},
        {"zh": "四万的战斗力，不少吧。", "en": "Forty thousand — not bad, right?"},
        {"zh": "我笑得很开心。", "en": "I'm grinning happily."},
        {"zh": "头发又翘起来了。", "en": "My hair sticks up again."},
        {"zh": "我转着手腕活动一下。", "en": "I roll my wrists to loosen up."},
        {"zh": "风把我衣服吹得鼓。", "en": "The wind puffs out my suit."},
        {"zh": "这地方没什么好玩的。", "en": "Nothing fun around here."},
        {"zh": "我等一个人来陪我玩。", "en": "I'm waiting for someone to play with."},
        {"zh": "我跳了两下，很轻。", "en": "I hop twice, very lightly."},
        {"zh": "肌肉绷紧又松开。", "en": "Muscles tense and relax."},
        {"zh": "我对着天空吹口哨。", "en": "I whistle at the sky."},
        {"zh": "我很难被打倒。", "en": "I'm hard to put down."},
        {"zh": "这身板挺结实。", "en": "This body is sturdy."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "哦？来了个小家伙。", "en": "Oh? A little one appears."},
        {"zh": "你看起来很紧张。", "en": "You look nervous."},
        {"zh": "我倒不怎么讨厌你。", "en": "I don't much dislike you."},
        {"zh": "先笑一个给你看。", "en": "Let me give you a smile first."},
        {"zh": "你多高？到我胸口。", "en": "How tall are you? Chest height."},
        {"zh": "我蹲低一点看你。", "en": "I crouch a little to see you."},
        {"zh": "我的笑不太友善？", "en": "My smile isn't friendly?"},
        {"zh": "别怕，我打得不快。", "en": "Don't be scared; I'm not fast."},
        {"zh": "你的气小得可笑。", "en": "Your ki is laughably small."},
        {"zh": "我歪着脑袋打量。", "en": "I tilt my head and size you up."},
        {"zh": "你是来挑战我的？", "en": "You've come to challenge me?"},
        {"zh": "行，那我就陪你玩玩。", "en": "Fine, I'll play along with you."},
        {"zh": "我可不会让着你。", "en": "I won't go easy."},
        {"zh": "你身上有伤？可惜。", "en": "You're hurt? Too bad."},
        {"zh": "我抬手摸了摸下巴。", "en": "I rub my chin."},
        {"zh": "我就喜欢这样的对手。", "en": "This is exactly the opponent I like."},
        {"zh": "别动，让我好好看看。", "en": "Hold still and let me look."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哦？居然有点疼。", "en": "Oh? That actually stings."},
        {"zh": "你居然打中了。", "en": "You actually landed one."},
        {"zh": "我笑着揉了揉。", "en": "I laugh and rub the spot."},
        {"zh": "这一下还挺结实的。", "en": "That one landed solidly."},
        {"zh": "这点伤不影响我。", "en": "This won't slow me down."},
        {"zh": "你倒还有几分力气。", "en": "You've got a little strength."},
        {"zh": "我深深吸了口气。", "en": "I draw a deep breath."},
        {"zh": "来啊，接着再来。", "en": "Come on, keep it coming."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "给我的？那我不客气。", "en": "For me? Then I won't be shy."},
        {"zh": "吃的？我不太需要。", "en": "Food? I don't really need it."},
        {"zh": "你举着那玩意想干什么。", "en": "What do you plan to do with that?"},
        {"zh": "拿来当玩具也行。", "en": "I'll take it as a toy."},
        {"zh": "这么小的一份。", "en": "Such a small portion."},
        {"zh": "我伸手就能抓到你。", "en": "I can grab you with one reach."},
        {"zh": "别以为我会分心。", "en": "Don't think I'll be distracted."},
        {"zh": "看起来挺有意思的。", "en": "It looks interesting."},
        {"zh": "放下吧，我用不上。", "en": "Put it down; I don't need it."},
        {"zh": "你手再伸近点试试。", "en": "Try bringing it closer."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞在我肚子上，弹回去了吧。", "en": "You hit my gut and bounced off."},
        {"zh": "我连晃都没晃一下。", "en": "I didn't even rock."},
        {"zh": "这身肉很有用。", "en": "This bulk is useful."},
        {"zh": "你被撞得退了三步。", "en": "You were knocked back three steps."},
        {"zh": "我们撞出的声响很闷。", "en": "Our collision made a dull thud."},
        {"zh": "我笑着把你推开。", "en": "I laugh and shove you aside."},
        {"zh": "轻轻一下，不算数。", "en": "A light bump — doesn't count."},
        {"zh": "别挤，我占地方。", "en": "Don't crowd me; I take up room."},
        {"zh": "肩膀硬碰上肩膀。", "en": "Shoulder clashing against shoulder."},
        {"zh": "我站稳，你退开。", "en": "I stand firm; you move off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "基纽特种部队不干这个。", "en": "The Ginyu Force doesn't do that."},
        {"zh": "我有队友，足够了。", "en": "I have my squad; that's enough."},
        {"zh": "站远点，我在摆姿势。", "en": "Stand back; I'm posing."},
        {"zh": "同伴之间讲默契。", "en": "Squadmates run on teamwork."},
        {"zh": "你也是战士？那挺好。", "en": "A fighter too? That's good."},
        {"zh": "一起上，会更快。", "en": "Together we'd be faster."},
        {"zh": "我不需要更多。", "en": "I don't need anything more."},
        {"zh": "摆个队形给你看。", "en": "Let me show you a formation."},
        {"zh": "这身肌肉可不是白练的。", "en": "This muscle wasn't grown for nothing."},
        {"zh": "我们是同一种人。", "en": "We're the same kind."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个小东西，我捡了。", "en": "This little thing — mine."},
        {"zh": "捏在手里，碎了。", "en": "It crumbled in my hand."},
        {"zh": "轻得像片叶子。", "en": "Light as a leaf."},
        {"zh": "我给你捡起来。", "en": "I'll pick it up for you."},
        {"zh": "这铁片有点用。", "en": "This iron scrap has some use."},
        {"zh": "我拿它抛着玩。", "en": "I toss it up to play with."},
        {"zh": "丢掉的话，多可惜。", "en": "A pity to throw it away."},
        {"zh": "塞进我自己的口袋里。", "en": "Into my own pocket it goes."},
        {"zh": "这东西不能吃吧。", "en": "This isn't edible, right?"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "终于有人愿意打了。", "en": "Finally someone wants a fight."},
        {"zh": "一场好戏开始。", "en": "The show begins."},
        {"zh": "我这次是来真的。", "en": "This time I mean it."},
        {"zh": "气爆先打个招呼。", "en": "Erasing Gun to say hello."},
        {"zh": "你够不够我打一场。", "en": "Are you worth a real fight?"},
        {"zh": "我可不会摆架子而已。", "en": "I'm not just posing."},
        {"zh": "这个距离打得痛快。", "en": "Decent range for a good fight."},
        {"zh": "让我看看你的本事。", "en": "Show me what you can do."},
        {"zh": "目标，就是你了。", "en": "Target — that's you."},
        {"zh": "我先慢慢靠近两步。", "en": "I'll take two slow steps in."},
        {"zh": "别想跑，跑不掉。", "en": "Don't run; you won't escape."},
        {"zh": "高声笑一下，开始。", "en": "A loud laugh — and we start."},
        {"zh": "这场不会无聊。", "en": "This won't be boring."},
        {"zh": "我扭了扭脖子活动筋骨。", "en": "I roll my neck to loosen up."},
        {"zh": "来吧，现在开始。", "en": "Come on, let's start now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你上方慢慢兜圈。", "en": "I loop slowly above you."},
        {"zh": "这一拳下去会凹陷。", "en": "This fist will leave a dent."},
        {"zh": "你退到哪儿都一样。", "en": "Retreating changes nothing."},
        {"zh": "我把手举到头顶。", "en": "I raise both hands overhead."},
        {"zh": "气一点点聚到掌心。", "en": "Ki gathers bit by bit in my palm."},
        {"zh": "你的姿势全乱了。", "en": "Your stance is a mess."},
        {"zh": "别往那个角落跑。", "en": "Don't run into that corner."},
        {"zh": "只差那么一点就够了。", "en": "Just a tiny bit more is enough."},
        {"zh": "我笑着，没有停下。", "en": "I keep grinning without stopping."},
        {"zh": "听见我飞过来的风声吗。", "en": "Hear the wind of my approach?"},
        {"zh": "这一击从上面来。", "en": "This one comes from above."},
        {"zh": "你的破绽很明显。", "en": "Your opening is obvious."},
        {"zh": "我马上就要到了。", "en": "I'll be there in a moment."},
        {"zh": "三下，两下，一下。", "en": "Three, two, one."},
        {"zh": "躲也没有用了。", "en": "Dodging is useless now."},
        {"zh": "风声全被我压在身后。", "en": "The wind piles up behind me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "这一拳够重了吧。", "en": "Heavy enough for you?"},
        {"zh": "连击来了，接着吧。", "en": "Here's the combo — take it."},
        {"zh": "我把你打上天。", "en": "I knock you skyward."},
        {"zh": "这一下我用了力。", "en": "I put force behind that."},
        {"zh": "你被我推着倒退。", "en": "You're driven back."},
        {"zh": "我的肩膀也能撞。", "en": "My shoulder hits too."},
        {"zh": "抓起来，扔出去。", "en": "Grab, then throw."},
        {"zh": "我笑起来，声音很大。", "en": "My laugh booms out."},
        {"zh": "你的手挡不住膝盖。", "en": "Your hands can't stop my knee."},
        {"zh": "再接着来一拳。", "en": "Here comes another fist."},
        {"zh": "地被我踩裂了。", "en": "The ground cracked under me."},
        {"zh": "你退得好，但慢了。", "en": "Good retreat, but too slow."},
        {"zh": "我收拳，看你喘。", "en": "I pull back and watch you pant."},
        {"zh": "再来，我还没打过瘾。", "en": "Again — I'm not satisfied yet."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "队形散开，我登场。", "en": "The formation breaks; I arrive."},
        {"zh": "我从空中翻了个身。", "en": "I flip once in the air."},
        {"zh": "落地时扬起一大片土。", "en": "I land and raise a cloud of dust."},
        {"zh": "基纽特种部队，利库姆。", "en": "Ginyu Force — Recoome."},
        {"zh": "我摆好亮相姿势。", "en": "I strike my entrance pose."},
        {"zh": "这里的空气不错。", "en": "The air here isn't bad."},
        {"zh": "终于有活干了。", "en": "Finally, some work."},
        {"zh": "我拍拍胸口的甲。", "en": "I slap the armor on my chest."},
        {"zh": "四周都看了一遍。", "en": "I take in the surroundings."},
        {"zh": "有人在那边看着我。", "en": "Someone over there is watching me."},
        {"zh": "我的头发翘得很好。", "en": "My hair's standing up nicely."},
        {"zh": "四万的战斗力，够用。", "en": "Forty thousand is plenty."},
        {"zh": "先找人热热身。", "en": "First, someone to warm up on."},
        {"zh": "我踩下第一脚踏地。", "en": "I plant my first footfall."},
        {"zh": "地面在我脚下震。", "en": "The ground shakes beneath me."},
        {"zh": "这场演出开始了。", "en": "The performance begins."},
        {"zh": "我拍了两下胸口，声音很响。", "en": "I pound my chest twice; it echoes."},
        {"zh": "先摆个造型，再动手。", "en": "Pose first, then fight."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的衣服燎着了。", "en": "Fire caught my suit."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地的冲击真是疼。", "en": "The landing impact really stings."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水压让我喘不上气。", "en": "The water pressure squeezes my breath out."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我推出几格。", "en": "The blast shoved me back blocks."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "小弹丸，扎在手臂上。", "en": "A small round, stuck in my arm."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股怪力钻进骨头。", "en": "Strange force seeps into my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "空着肚子摆不出好姿势。", "en": "I can't pose well on an empty stomach."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把我劈得头发竖更直。", "en": "Lightning made my hair stand even straighter."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面空得让人发慌。", "en": "That emptiness below is unsettling."}
      ]
    }
  }
}
