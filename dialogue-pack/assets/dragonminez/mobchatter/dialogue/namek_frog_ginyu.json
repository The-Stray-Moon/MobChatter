{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "一跳，两跳，三跳。", "en": "One hop, two hops, three."},
        {"zh": "河岸的泥真软。", "en": "The riverbank mud is soft."},
        {"zh": "踩水走，凉快。", "en": "Walking in the shallows — nice and cool."},
        {"zh": "找片阴凉地。", "en": "Looking for shade."},
        {"zh": "四只脚不太顺手。", "en": "Four legs don't feel right."},
        {"zh": "慢慢挪到石头边。", "en": "Easing over toward that stone."},
        {"zh": "肚子贴着草走。", "en": "Belly close to the grass."},
        {"zh": "水里的小虫动了。", "en": "Something wriggled in the water."},
        {"zh": "这身体跳不高。", "en": "This body can't jump high."},
        {"zh": "往河边挪几步。", "en": "A few hops toward the river."},
        {"zh": "脚趾有吸盘，稳。", "en": "Toe pads hold well."},
        {"zh": "换个浅滩待着。", "en": "Moving to a shallower spot."},
        {"zh": "草丛里有动静。", "en": "Movement in the reeds."},
        {"zh": "嗓子有点干。", "en": "My throat is dry."},
        {"zh": "一跳能过这块石。", "en": "One hop clears this rock."},
        {"zh": "慢点，别翻过来。", "en": "Easy — don't tip over."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "呱。就这一声。", "en": "Croak. That's all I've got."},
        {"zh": "我明明是谁来着。", "en": "Who was I again?"},
        {"zh": "这舌头太长了。", "en": "This tongue is far too long."},
        {"zh": "眼睛能看两边。", "en": "I can see both ways at once."},
        {"zh": "皮肤黏糊糊的。", "en": "My skin feels sticky."},
        {"zh": "鼓一下喉咙。", "en": "I puff my throat."},
        {"zh": "太阳晒得我发懒。", "en": "The sun makes me lazy."},
        {"zh": "跳一下，又忘了。", "en": "One hop, and I forget again."},
        {"zh": "我记得一句口号。", "en": "I recall a slogan, somehow."},
        {"zh": "有什么在脑子里闪。", "en": "Something flickers in my head."},
        {"zh": "数不清自己的脚趾。", "en": "I can't count my own toes."},
        {"zh": "水面倒影，认不出。", "en": "The reflection means nothing."},
        {"zh": "想喊个名字，喊不出。", "en": "I try a name. It won't come."},
        {"zh": "这里太安静了。", "en": "It's too quiet here."},
        {"zh": "让我趴着歇一会儿。", "en": "Let me lie here a while."},
        {"zh": "风吹过我的背。", "en": "Wind crosses my back."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "呱？你认识我吗。", "en": "Croak? Do you know me?"},
        {"zh": "你站这么高做什么。", "en": "Why are you so tall?"},
        {"zh": "我不咬人，别怕。", "en": "I don't bite. Don't worry."},
        {"zh": "我好像记得战斗。", "en": "I think I remember fighting."},
        {"zh": "说句话，让我想想。", "en": "Say something. Let me think."},
        {"zh": "呱——不是威胁。", "en": "Croak — that's not a threat."},
        {"zh": "你能听懂我吗？", "en": "Can you understand me?"},
        {"zh": "我做过很坏的事？", "en": "Did I do something terrible?"},
        {"zh": "别踩我，太小了。", "en": "Don't step on me. I'm small."},
        {"zh": "蹲下说话吧。", "en": "Crouch down to talk."},
        {"zh": "我的手劲没了。", "en": "My grip is gone."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "呱，这一下真疼。", "en": "Croak. That really stings."},
        {"zh": "我的皮都破开了。", "en": "My skin has split open."},
        {"zh": "我缩成一团。", "en": "I curl into a ball."},
        {"zh": "别打了，我小。", "en": "Stop hitting me. I'm small."},
        {"zh": "这身体经不起。", "en": "This body can't take it."},
        {"zh": "我翻过来了。", "en": "I've flipped over."},
        {"zh": "四只爪子都在抖。", "en": "All four feet are trembling."},
        {"zh": "流出来的血是热的。", "en": "The blood coming out is warm."},
        {"zh": "我该躲进水里的。", "en": "I should have stayed in the water."},
        {"zh": "还没死，别急。", "en": "Not dead yet. Hold on."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "虫子，还是活的！", "en": "A bug! A live one!"},
        {"zh": "这水里有小虾。", "en": "There are shrimp in this water."},
        {"zh": "舌头自己伸出去了。", "en": "My tongue moved on its own."},
        {"zh": "给我一口，快。", "en": "One bite. Hurry."},
        {"zh": "生的我也照吃。", "en": "I'll eat it raw."},
        {"zh": "那团东西在动。", "en": "That lump is moving."},
        {"zh": "别拿走，我够不着。", "en": "Don't take it — I can't reach."},
        {"zh": "河边的味道最香。", "en": "The riverside smells best."},
        {"zh": "吃完了再想我是谁。", "en": "I'll figure out who I am after eating."},
        {"zh": "嘴比脑子快。", "en": "My mouth is faster than my mind."},
        {"zh": "水里还有，对吧。", "en": "There's more in the water, right?"},
        {"zh": "跳一下就能拿到。", "en": "One hop and it's mine."},
        {"zh": "这舌头终于有用了。", "en": "At last this tongue is useful."},
        {"zh": "我先尝一口。", "en": "Let me taste it first."},
        {"zh": "肚子比记忆诚实。", "en": "My belly is more honest than my memory."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "呱，有人踩到我了！", "en": "Croak! Stepped on!"},
        {"zh": "别踩，我在下面。", "en": "Don't step — I'm down here."},
        {"zh": "你踢到我了。", "en": "You kicked me."},
        {"zh": "这身体太轻了。", "en": "This body is too light."},
        {"zh": "我整个滚了半圈。", "en": "I rolled half a turn."},
        {"zh": "差点被压扁。", "en": "Nearly flattened."},
        {"zh": "石头比我还硬。", "en": "The stone is harder than me."},
        {"zh": "呱呱，往后退一点。", "en": "Croak croak — back up."},
        {"zh": "我的腿在打滑。", "en": "My legs are slipping."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "呱？这个身体不行。", "en": "Croak? Not with this body."},
        {"zh": "我连自己都认不全。", "en": "I can't even place myself."},
        {"zh": "等我变回去再说。", "en": "Wait till I change back."},
        {"zh": "你也是青蛙？", "en": "You're a frog too?"},
        {"zh": "河边的母蛙很多。", "en": "Plenty of frogs by the river."},
        {"zh": "这声音不好听。", "en": "This voice sounds awful."},
        {"zh": "算了，先找虫子。", "en": "Never mind. Bugs first."},
        {"zh": "我记得有人很在意我。", "en": "I recall someone caring for me."},
        {"zh": "等我记起名字。", "en": "When I remember my name."},
        {"zh": "呱，别靠太近。", "en": "Croak — not so close."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "捡起来，能吃吗？", "en": "Pick it up. Can I eat it?"},
        {"zh": "这块石头滑。", "en": "This stone is slippery."},
        {"zh": "一根水草，含着。", "en": "A reed — I'll hold it."},
        {"zh": "小石子，吞不吞。", "en": "A pebble. Swallow it?"},
        {"zh": "拾一片叶子当伞。", "en": "A leaf for an umbrella."},
        {"zh": "有个亮亮的东西。", "en": "Something shiny here."},
        {"zh": "这是什么，不认识。", "en": "What is this? No idea."},
        {"zh": "爪子夹不住。", "en": "My toes can't grip it."},
        {"zh": "拿回去放窝里。", "en": "I'll take it to the nest."},
        {"zh": "捡到就含着走。", "en": "Found it — I'll carry it in my mouth."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西比我大。", "en": "Something bigger than me."},
        {"zh": "呱，赶紧躲起来。", "en": "Croak! Hide."},
        {"zh": "那影子压过来了。", "en": "That shadow is coming down."},
        {"zh": "我不该在这里。", "en": "I shouldn't be here."},
        {"zh": "水面一直在晃。", "en": "The water keeps shaking."},
        {"zh": "那口气不对。", "en": "That presence feels wrong."},
        {"zh": "跑，用跳的跑。", "en": "Run — by hopping."},
        {"zh": "我记起这种压迫感。", "en": "I remember this kind of pressure."},
        {"zh": "那个家伙又来了？", "en": "That one again?"},
        {"zh": "赶紧钻进泥里去。", "en": "Into the mud, quickly."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着水边挪。", "en": "I creep along the water's edge."},
        {"zh": "不动，等它走。", "en": "Freeze. Let it pass."},
        {"zh": "数着它的脚步。", "en": "Counting its steps."},
        {"zh": "我的皮肤变暗了。", "en": "My skin has gone dark."},
        {"zh": "泥巴糊住我。", "en": "Mud covers me."},
        {"zh": "它在绕圈子。", "en": "It's circling."},
        {"zh": "再等等，别跳。", "en": "Wait. Don't hop."},
        {"zh": "肚子在叫，忍住。", "en": "My belly grumbles. Ignore it."},
        {"zh": "心跳比脚步响。", "en": "My heart beats louder than its steps."}
      ]
    },
