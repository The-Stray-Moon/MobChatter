{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "变身之后，我重了三分。", "en": "Transformed, I'm heavier by a third."},
        {"zh": "这副模样不需要隐藏。", "en": "In this shape I hide nothing."},
        {"zh": "我一步步压向你。", "en": "I press toward you step by step."},
        {"zh": "气托着我浮起半格。", "en": "Ki lifts me half a block up."},
        {"zh": "身子大了，转身反而慢。", "en": "Bigger body, slower turns."},
        {"zh": "我绕开挡路的树。", "en": "I shift around a blocking tree."},
        {"zh": "走一步，地面就响。", "en": "Each step rings on the ground."},
        {"zh": "三万的战斗力不需要跑。", "en": "Thirty thousand power means no need to run."},
        {"zh": "脚下气浪往外推。", "en": "My aura pushes outward with each step."},
        {"zh": "这副身体不习惯窄巷。", "en": "This body isn't made for narrow alleys."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "这副身体太张扬。", "en": "This body is too conspicuous."},
        {"zh": "肌肉绷着，随时能出。", "en": "Muscles taut, ready to fire."},
        {"zh": "地上有一圈压痕。", "en": "A ring of dents marks the ground."},
        {"zh": "我抬起手看指节。", "en": "I raise a hand and look at my knuckles."},
        {"zh": "丑是丑了点，管用。", "en": "Ugly, maybe, but effective."},
        {"zh": "我不喜欢这个样子。", "en": "I don't like this shape."},
        {"zh": "风把尘土吹到我脚边。", "en": "Wind pushes dust to my feet."},
        {"zh": "我活动一下脖子。", "en": "I roll my neck."},
        {"zh": "气还没完全放出来。", "en": "The aura isn't fully released yet."},
        {"zh": "我盯着远处看。", "en": "I stare into the distance."},
        {"zh": "这个形态撑得住。", "en": "This form will hold."},
        {"zh": "腿上的关节咔咔响。", "en": "Joints in my legs click."},
        {"zh": "我不打算久留。", "en": "I don't plan to stay long."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "看清楚，现在是我。", "en": "Take a good look; this is me now."},
        {"zh": "你退后了三步。", "en": "You took three steps back."},
        {"zh": "这身样子吓到你了吧。", "en": "This form frightens you, doesn't it?"},
        {"zh": "刚才那副面孔只是客气。", "en": "The face before was only courtesy."},
        {"zh": "你再想一遍要不要动手。", "en": "Think again about striking."},
        {"zh": "我现在不需要留手了。", "en": "I no longer need to hold back."},
        {"zh": "三万的战斗力，你算算。", "en": "Thirty thousand. Do the math."},
        {"zh": "这点距离我半步就到。", "en": "Half a step covers that distance."},
        {"zh": "你的气，抖得厉害。", "en": "Your ki is shaking badly."},
        {"zh": "这副身体不太好看，但很快。", "en": "Not pretty, but fast."},
        {"zh": "你把武器放下来。", "en": "Lower your hands."},
        {"zh": "眼睛别看别处。", "en": "Don't look elsewhere."},
        {"zh": "我还会再变一次吗？", "en": "Will I change again? No."},
        {"zh": "你站的位置太冒险了。", "en": "You're standing somewhere very risky."},
        {"zh": "你现在还有一次机会。", "en": "You have one chance left."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这点小伤还碍不着我。", "en": "This wound is nothing."},
        {"zh": "你居然打穿了我的甲。", "en": "You actually pierced my armor."},
        {"zh": "这副身体反而更耐打。", "en": "This body takes hits better."},
        {"zh": "疼，但我不当回事。", "en": "It hurts, but I ignore it."},
        {"zh": "血从肩缝里渗出来。", "en": "Blood seeps from my shoulder seam."},
        {"zh": "变身后的嗓子，声音很低。", "en": "In this form my voice comes out low."},
        {"zh": "这形态不会因此散掉。", "en": "This form won't come apart from that."},
        {"zh": "还有下一招吗？", "en": "Got another move?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这形态消耗太大。", "en": "This form burns too much."},
        {"zh": "等我变回去再吃。", "en": "I'll eat after I revert."},
        {"zh": "你最好别在我面前晃吃的。", "en": "Don't wave food in front of me."},
        {"zh": "这点不够我补回来。", "en": "That won't replenish me."},
        {"zh": "这种小玩意儿不入我眼。", "en": "I'm not interested in that."},
        {"zh": "你收起来，快点。", "en": "Put it away, quickly."},
        {"zh": "这副牙齿不合适吃东西。", "en": "These teeth aren't for eating nicely."},
        {"zh": "变身之后，我的脸变了。", "en": "After transforming, my face changed."},
        {"zh": "我饿，但不是为那个。", "en": "I'm hungry, but not for that."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上来像撞石墙。", "en": "You hit me like a stone wall."},
        {"zh": "我几乎没有后退。", "en": "I barely moved back."},
        {"zh": "这身板就是用来挡的。", "en": "This bulk is made for blocking."},
        {"zh": "你从我腿边弹开。", "en": "You bounced off my leg."},
        {"zh": "退开，别被踩到。", "en": "Back off before you're stepped on."},
        {"zh": "我动作慢，但站稳了。", "en": "I'm slow, but I'm planted."},
        {"zh": "你的肩撞出了闷响。", "en": "Your shoulder landed with a thud."},
        {"zh": "这个宽度过不去。", "en": "You can't get through this width."},
        {"zh": "别贴在我侧面。", "en": "Don't cling to my flank."},
        {"zh": "再来你会受伤。", "en": "Try again and you'll be hurt."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个形态不合适。", "en": "This form isn't suitable."},
        {"zh": "我变回去再说。", "en": "After I revert."},
        {"zh": "这副身体只会伤到你。", "en": "This body would only hurt you."},
        {"zh": "你退得远一点。", "en": "Step farther back."},
        {"zh": "我满脑子只想着厮杀。", "en": "My mind is only on combat."},
        {"zh": "这话题让我不悦。", "en": "This topic displeases me."},
        {"zh": "以后再来提这事。", "en": "Mention it later."},
        {"zh": "别在我这个样子时靠近。", "en": "Don't come near me looking like this."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "指尖一夹，就提起来了。", "en": "A pinch of my fingers lifts it."},
        {"zh": "我差点把它捏碎。", "en": "Nearly crushed it."},
        {"zh": "这尺寸在我手里太小。", "en": "Too small in this hand."},
        {"zh": "我把它扔给你。", "en": "I toss it to you."},
        {"zh": "看一眼就够了。", "en": "One look is enough."},
        {"zh": "这东西不属于我。", "en": "This doesn't belong to me."},
        {"zh": "拿稳了，别掉了。", "en": "Catch it; don't drop it."},
        {"zh": "太重了，对你也是。", "en": "Heavy stuff, even for you."},
        {"zh": "放回石台上，我不捡。", "en": "I put it back on the stone ledge."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "这个形态不需要瞄准。", "en": "This form doesn't need to aim."},
        {"zh": "你的气已经被我咬住了。", "en": "I've got my teeth in your ki."},
        {"zh": "巨猿光束不是给你躲的。", "en": "The Gigant Beam isn't for dodging."},
        {"zh": "一下就能解决。", "en": "One strike settles it."},
        {"zh": "你动的那一下我看见了。", "en": "I saw that twitch."},
        {"zh": "这一副身子，才是真样子。", "en": "This body is the real shape."},
        {"zh": "这个距离太近。", "en": "This distance is too close."},
        {"zh": "我的拳头有你的头大。", "en": "My fist is the size of your head."},
        {"zh": "前面的路我封了。", "en": "I've sealed the way ahead."},
        {"zh": "别想着绕到后面。", "en": "Don't try to circle behind."},
        {"zh": "气已经聚满了。", "en": "The ki is fully gathered."},
        {"zh": "这一击不留情。", "en": "This blow shows no mercy."},
        {"zh": "你会记住这个形态。", "en": "You'll remember this form."},
        {"zh": "该收场的时候到了。", "en": "Time's up."},
        {"zh": "我要先出手了。", "en": "I move first."},
        {"zh": "给我站稳了再动。", "en": "Stand firm."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起手臂对准你。", "en": "I raise my arm and aim at you."},
        {"zh": "你在我的正面。", "en": "You're in my front arc."},
        {"zh": "巨猿光束正在聚气。", "en": "The Gigant Beam is charging."},
        {"zh": "你跑得再快也没用。", "en": "Running faster won't help."},
        {"zh": "我的动作慢，但范围大。", "en": "Slow, but with a wide reach."},
        {"zh": "你想从侧面来？", "en": "Coming from the side?"},
        {"zh": "这一片都在我的射程里。", "en": "This whole area is in my range."},
        {"zh": "我看着你的脚。", "en": "I'm watching your feet."},
        {"zh": "别以为慢就打不到。", "en": "Slow doesn't mean I miss."},
        {"zh": "气把地面压出裂纹。", "en": "The aura cracks the ground."},
        {"zh": "你还有几步的空间。", "en": "You have a few steps of room left."},
        {"zh": "我没打算追你。", "en": "I don't plan to chase."},
        {"zh": "你在往左边退。", "en": "You're retreating left."},
        {"zh": "这个角度我更喜欢。", "en": "I prefer this angle."},
        {"zh": "气已经满到边。", "en": "The ki is brimming."},
        {"zh": "再多一步就够。", "en": "One more step is enough."},
        {"zh": "我知道你要跳。", "en": "I know you'll jump."},
        {"zh": "最后一口气了。", "en": "Final breath."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "尝尝巨猿光束！", "en": "Gigant Beam!"},
        {"zh": "空中连击，第一段。", "en": "Aerial combo, first hit."},
        {"zh": "这一拳带风压。", "en": "This punch comes with pressure."},
        {"zh": "变身之后，你的甲不够看。", "en": "After the change, your armor won't impress me."},
        {"zh": "脚踩下去，地面裂开。", "en": "My foot falls and the ground splits."},
        {"zh": "你被打得横飞。", "en": "You're sent flying sideways."},
        {"zh": "这一下我只用了七成。", "en": "That was seventy percent."},
        {"zh": "反手再来一下。", "en": "A backhand follows."},
        {"zh": "你的兵器脱手了。", "en": "Your weapon left your hand."},
        {"zh": "别硬接下来这一下。", "en": "Don't block it head-on."},
        {"zh": "我抬腿踢你膝侧。", "en": "My leg strikes the side of your knee."},
        {"zh": "这身体太重，收不住。", "en": "This body is heavy; I can't stop short."},
        {"zh": "你已经被我逼到墙角。", "en": "You're at the wall."},
        {"zh": "这一击是收尾。", "en": "This blow is the finish."},
        {"zh": "尘土盖住了你。", "en": "Dust covers you."},
        {"zh": "这一下就结束了。", "en": "It's over."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这个形态一出现，风就变了。", "en": "When this form appears, the wind shifts."},
        {"zh": "我落地时砸了个坑。", "en": "I landed and made a crater."},
        {"zh": "周围全安静下来了。", "en": "Everything went quiet."},
        {"zh": "我抬手挡住阳光。", "en": "I raise a hand against the sun."},
        {"zh": "这副身体不太适应这里。", "en": "This body doesn't fit this place."},
        {"zh": "谁在这附近站着？", "en": "Who's nearby?"},
        {"zh": "气从脚下往外扩。", "en": "My aura spreads from my feet."},
        {"zh": "我听见远处的脚步。", "en": "I hear steps far off."},
        {"zh": "这个形态维持不了太久。", "en": "This form won't last forever."},
        {"zh": "先找个开阔的地方。", "en": "First, find open ground."},
        {"zh": "我把气收一收。", "en": "Let me draw the aura in."},
        {"zh": "这里实在太窄了。", "en": "This space is too tight."},
        {"zh": "我已经到这儿了。", "en": "I'm here."},
        {"zh": "别站在我脚下。", "en": "Don't stand under my feet."},
        {"zh": "尘埃落定再动。", "en": "Let the dust settle first."},
        {"zh": "这具身体已经调好了。", "en": "I'm ready."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在我皮上烧，味道很难闻。", "en": "Fire burns on my hide; the smell is foul."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处砸落，土都翻起来。", "en": "I crashed down and tore up the earth."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水压得我胸口发闷。", "en": "The water presses my chest tight."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我推得侧移。", "en": "The blast shoved me sideways."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉在我臂上。", "en": "Something stuck in my arm."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力在我皮下乱窜。", "en": "Spellwork crawls under my skin."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这形态耗得太快。", "en": "This form burns through me too fast."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的甲走。", "en": "Lightning runs along my armor."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有着落。", "en": "There's nothing to stand on."}
      ]
    }
  }
}
