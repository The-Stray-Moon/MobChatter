{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "金气已经带电。", "en": "My aura now crackles."},
        {"zh": "脚下石板一块块碎。", "en": "Slabs crack with each step."},
        {"zh": "走得不快，气很重。", "en": "Not fast. Very heavy."},
        {"zh": "这形态压得空气发响。", "en": "This form makes the air hum."},
        {"zh": "前面那块地太软。", "en": "That ground ahead is too soft."},
        {"zh": "我压着力量走。", "en": "I walk with my power leashed."},
        {"zh": "靴跟陷进土里。", "en": "My heel sinks into the dirt."},
        {"zh": "每一步都像落地雷。", "en": "Each step lands like thunder."},
        {"zh": "我走过的地方，碎石浮起来。", "en": "Where I pass, the gravel lifts."},
        {"zh": "离他只剩十几步。", "en": "Only a dozen paces left."},
        {"zh": "脚底的裂缝在延长。", "en": "The cracks spread under me."},
        {"zh": "低头看看掌心。", "en": "I glance at my palm."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "这已经超出我的极限。", "en": "This is past my limit."},
        {"zh": "肌肉在轻轻震。", "en": "My muscles shiver faintly."},
        {"zh": "闪电从发梢走过。", "en": "Lightning slides off my hair."},
        {"zh": "骨头里像有雷在滚。", "en": "Thunder rolls inside my bones."},
        {"zh": "肩膀沉得像山。", "en": "My shoulders weigh like mountains."},
        {"zh": "呼吸声被气吞了。", "en": "My breath is swallowed by the aura."},
        {"zh": "全身骨节都在响。", "en": "Every joint in me is creaking."},
        {"zh": "地面一直有细响。", "en": "The ground keeps whispering."},
        {"zh": "眼前的光太白。", "en": "The light is too white."},
        {"zh": "少说话，省力气。", "en": "Talk less. Save strength."},
        {"zh": "把杀气收住。", "en": "I reel my killing intent in."},
        {"zh": "不打算先出手。", "en": "I won't strike first."},
        {"zh": "站得越久越稳。", "en": "The longer I stand, the steadier."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "看清我的眼睛。", "en": "Look into my eyes."},
        {"zh": "你现在还有机会走。", "en": "You still have a chance to leave."},
        {"zh": "别被这股气吓软。", "en": "Don't go weak from this aura."},
        {"zh": "你的手已经抬不起来。", "en": "Your hands can't come up anymore."},
        {"zh": "这不是你能插手的。", "en": "This is beyond you."},
        {"zh": "我压着的东西很危险。", "en": "What I'm holding is dangerous."},
        {"zh": "你的气缩成一团。", "en": "Your ki has curled into a knot."},
        {"zh": "别求我，我不会停。", "en": "Don't beg. I won't stop."},
        {"zh": "离开我气场的边缘。", "en": "Get clear of my aura's edge."},
        {"zh": "你在发抖，很正常。", "en": "You're trembling. That's normal."},
        {"zh": "你做得很好了。", "en": "You've done well enough."},
        {"zh": "我的敌人不是你。", "en": "My enemy isn't you."},
        {"zh": "走远点，带孩子走。", "en": "Get far. Take the children."},
        {"zh": "抬头最后一次。", "en": "Lift your head one last time."},
        {"zh": "你的眼神还没散。", "en": "Your gaze hasn't broken yet."},
        {"zh": "你还有一点骨气。", "en": "You still have some spine."},
        {"zh": "我不想浪费在这里。", "en": "I don't want to waste it here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我咳出一口血。", "en": "I cough up blood."},
        {"zh": "我的气开始晃。", "en": "My aura is wavering."},
        {"zh": "这形态撑不太久了。", "en": "This form won't hold much longer."},
        {"zh": "我按住侧腹。", "en": "I press my side."},
        {"zh": "疼得视线发白。", "en": "The pain whites out my sight."},
        {"zh": "这点伤不算数。", "en": "This wound doesn't count."},
        {"zh": "我还站得很稳。", "en": "I'm still standing steady."},
        {"zh": "骨头还没有断。", "en": "Nothing is broken yet."},
        {"zh": "我还没有倒下。", "en": "I'm not down yet."},
        {"zh": "最后一段了。", "en": "The last stretch."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "现在不是吃东西的时候。", "en": "This isn't the time to eat."},
        {"zh": "把手放远一点。", "en": "Keep that further away."},
        {"zh": "这气太满，吃不下。", "en": "My ki is too full to eat."},
        {"zh": "补给留给别人。", "en": "Leave the supplies for others."},
        {"zh": "别靠近，会烧到你。", "en": "Stay back. It'll burn you."},
        {"zh": "我只需要站稳。", "en": "I just need to stand firm."},
        {"zh": "那点东西不够我耗。", "en": "That won't cover what I'm spending."},
        {"zh": "拿走，我不要。", "en": "Take it. I don't want it."},
        {"zh": "留着给孩子。", "en": "Save it for the children."},
        {"zh": "你的好意我心领。", "en": "I appreciate the thought."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "别碰我，气会伤你。", "en": "Don't touch me. The aura bites."},
        {"zh": "站得再远一些。", "en": "Stand a little farther off."},
        {"zh": "你被弹开了吧。", "en": "You got pushed back, didn't you."},
        {"zh": "这里的空气都在震。", "en": "The air itself is shaking."},
        {"zh": "往后退三步再说。", "en": "Three steps back before we talk."},
        {"zh": "连石头都弹开了。", "en": "Even the stones bounced off."},
        {"zh": "别拉我，我不好控制。", "en": "Don't grab me. I'm hard to control."},
        {"zh": "这点碰撞不痛。", "en": "That bump didn't hurt."},
        {"zh": "地面被我们踩陷了。", "en": "We sank the ground between us."},
        {"zh": "别站我脚边。", "en": "Don't stand at my feet."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经给不了这些。", "en": "I have nothing like that left."},
        {"zh": "这形态不是给人抱的。", "en": "This form isn't for holding."},
        {"zh": "等我把力量放下。", "en": "When I set this power down."},
        {"zh": "我可能要死在这里。", "en": "I might die here."},
        {"zh": "别记住我这样。", "en": "Don't remember me like this."},
        {"zh": "赛亚人的路很窄。", "en": "A Saiyan's path is narrow."},
        {"zh": "照顾好他们。", "en": "Look after them."},
        {"zh": "现在说这些太迟了。", "en": "Too late for that now."},
        {"zh": "我没有后路。", "en": "I have no way back."},
        {"zh": "谢谢你还站着。", "en": "Thank you for still standing."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这石头在手里碎了。", "en": "The stone crumbled in my hand."},
        {"zh": "轻得像一张纸。", "en": "Light as a sheet of paper."},
        {"zh": "不捡了，没必要。", "en": "No. Not worth picking up."},
        {"zh": "我拿不稳小东西。", "en": "I can't grip small things now."},
        {"zh": "收着，回头有用。", "en": "Keep it. Useful later."},
        {"zh": "别管地上的东西。", "en": "Forget what's on the ground."},
        {"zh": "地上还有半截剑。", "en": "Half a blade lies there."},
        {"zh": "这点重量感觉不到。", "en": "I can't even feel the weight."},
        {"zh": "拿去，我不需要。", "en": "Take it. I don't need it."},
        {"zh": "手指不太听使唤。", "en": "My fingers don't quite obey."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "他的气终于露出来了。", "en": "His ki finally shows."},
        {"zh": "雷声跟着我走。", "en": "Thunder follows me."},
        {"zh": "不打算再等。", "en": "I won't wait longer."},
        {"zh": "这一战到此为止。", "en": "This fight ends here."},
        {"zh": "我的脚下在发亮。", "en": "The ground glows under me."},
        {"zh": "他退不了了。", "en": "He has nowhere to retreat."},
        {"zh": "先封住所有的路。", "en": "Seal every route first."},
        {"zh": "我要用尽全部。", "en": "I'll spend everything."},
        {"zh": "心跳快得像鼓。", "en": "My heart beats like a drum."},
        {"zh": "眼眶有点热。", "en": "My eyes feel hot."},
        {"zh": "这一下要够重。", "en": "This one must be heavy."},
        {"zh": "你已经来不及了。", "en": "You're already too late."},
        {"zh": "蓄气到极限。", "en": "Charging to the very limit."},
        {"zh": "现在别闭上眼。", "en": "Don't close your eyes now."},
        {"zh": "让他记住这一战。", "en": "Let him remember this fight."},
        {"zh": "这一战开始了。", "en": "This fight has begun."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "他的架势开始散了。", "en": "His stance is coming apart."},
        {"zh": "我看得清每一道气。", "en": "I see every thread of ki."},
        {"zh": "终极闪光在蓄。", "en": "Final Flash is charging."},
        {"zh": "雷在指间聚起来。", "en": "Lightning gathers at my fingers."},
        {"zh": "再等我两息就好。", "en": "Two more breaths is all."},
        {"zh": "这个角度最干净。", "en": "This angle is the cleanest."},
        {"zh": "我只有一次力气。", "en": "I have one effort left."},
        {"zh": "地面会先塌。", "en": "The ground will give first."},
        {"zh": "他的呼吸变了。", "en": "His breathing changed."},
        {"zh": "别被他带开。", "en": "Don't let him pull me off line."},
        {"zh": "手要稳，别抖。", "en": "Steady hands. No shaking."},
        {"zh": "把距离留在十步。", "en": "Keep him at ten paces."},
        {"zh": "我等他的最后一下。", "en": "I wait for his final strike."},
        {"zh": "这一次不闪不避。", "en": "This time I won't dodge."},
        {"zh": "这一招没有退路。", "en": "This move has no retreat."},
        {"zh": "雷光在眼里。", "en": "Lightning in my eyes."},
        {"zh": "就是这一瞬间。", "en": "Right at this instant."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "终极闪光，接住！", "en": "Final Flash, take it!"},
        {"zh": "拳上带着雷。", "en": "My fist carries lightning."},
        {"zh": "加利克炮连发！", "en": "Galick Gun, rapid fire!"},
        {"zh": "大爆炸，贴脸版！", "en": "Big Bang, point blank!"},
        {"zh": "贴身两段连击。", "en": "Two-hit close combo."},
        {"zh": "这一下把地打穿。", "en": "This one goes through the ground."},
        {"zh": "肘撞得你后退。", "en": "My elbow drives you back."},
        {"zh": "膝盖压下去。", "en": "Knee down hard."},
        {"zh": "你挡不住这一拳。", "en": "You can't stop this fist."},
        {"zh": "空中接地面。", "en": "Air to ground."},
        {"zh": "不给喘息的机会。", "en": "No chance to breathe."},
        {"zh": "扫腿接上勾。", "en": "Sweep into uppercut."},
        {"zh": "转身踢你的侧肋。", "en": "Spinning kick to your side."},
        {"zh": "这一击用尽气。", "en": "This strike spends all my ki."},
        {"zh": "你的气罩碎了。", "en": "Your ki shell shattered."},
        {"zh": "站着的只剩我。", "en": "Only I remain standing."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我身上。", "en": "Lightning fell on me."},
        {"zh": "这形态不是随便亮的。", "en": "This form doesn't come cheap."},
        {"zh": "空气被烧得发白。", "en": "The air burns white around me."},
        {"zh": "我踩下的地面凹了。", "en": "The ground dents under my boot."},
        {"zh": "别再往这边靠近。", "en": "Don't come any closer."},
        {"zh": "从雷光里走出来。", "en": "I walk out of the lightning."},
        {"zh": "金气里夹着电。", "en": "Electricity rides my golden aura."},
        {"zh": "我现在很难收手。", "en": "It's hard for me to stop now."},
        {"zh": "站稳，别被震倒。", "en": "Brace. Don't get knocked down."},
        {"zh": "我看见了终点。", "en": "I can see the end of this."},
        {"zh": "这一战我不会退。", "en": "I won't step back in this fight."},
        {"zh": "披风已经烧没了。", "en": "My cape burned away."},
        {"zh": "骨头都在响。", "en": "My bones are all creaking."},
        {"zh": "让我把话说完。", "en": "Let me finish my piece."},
        {"zh": "气在血管里跑。", "en": "Ki races through my veins."},
        {"zh": "你的世界会记住。", "en": "Your world will remember."},
        {"zh": "这次不回头了。", "en": "No looking back this time."},
        {"zh": "这就是最后。", "en": "This is the last one."}
      ]
    },
