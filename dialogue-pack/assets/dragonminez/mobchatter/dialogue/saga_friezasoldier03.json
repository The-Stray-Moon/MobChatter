{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "贴着地面飞，省时间。", "en": "I skim the ground — faster that way."},
        {"zh": "护目镜的读数在跳。", "en": "My scouter's numbers are jumping."},
        {"zh": "甲片在风里咔咔响。", "en": "My armor rattles in the wind."},
        {"zh": "绕平原一圈，找目标。", "en": "A lap of the plain, hunting targets."},
        {"zh": "脚步不停，气也不停。", "en": "Boots don't stop, and neither does my ki."},
        {"zh": "这片野地太安静了。", "en": "This wild ground is too quiet."},
        {"zh": "踩着草尖滑过去。", "en": "I slide over the tips of the grass."},
        {"zh": "弗利萨军的靴子不沾泥。", "en": "Frieza Force boots don't take mud."},
        {"zh": "翅膀？不，我靠气浮着。", "en": "Wings? No — ki holds me up."},
        {"zh": "队形散开，我走左边。", "en": "Spread out. I take the left."},
        {"zh": "侦察这条山脊。", "en": "Scouting this ridge."},
        {"zh": "速度不快，但不会停。", "en": "Not fast, but never stopping."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "护目镜读数：八百。", "en": "Scouter reads eight hundred."},
        {"zh": "调一下气，别浪费。", "en": "I trim my ki — no waste."},
        {"zh": "哼哼，这地方没强者。", "en": "Hmph. No strong ones here."},
        {"zh": "敲敲胸甲，听话。", "en": "I tap my chestplate. Still sound."},
        {"zh": "等命令，别乱跑。", "en": "Awaiting orders. No wandering."},
        {"zh": "呼吸均匀，蓄着气。", "en": "Even breaths, storing ki."},
        {"zh": "指挥官在哪？", "en": "Where's the commander?"},
        {"zh": "眼里只有数值。", "en": "My eyes only see numbers."},
        {"zh": "擦擦护目镜的镜片。", "en": "Wiping my scouter lens."},
        {"zh": "天空真亮，刺眼。", "en": "The sky's too bright."},
        {"zh": "想着回舰队交差。", "en": "Thinking of reporting back to the fleet."},
        {"zh": "把肩甲正一下。", "en": "I square my shoulder guard."},
        {"zh": "这具身体很好用。", "en": "This body serves me well."},
        {"zh": "不会累，只会等。", "en": "I don't tire. I only wait."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "护目镜亮了，你也算目标。", "en": "My scouter lights up — you're a target too."},
        {"zh": "抬脚，我要看你的鞋底。", "en": "Lift your feet. I want to see your boots."},
        {"zh": "你的气很弱，可怜。", "en": "Your ki is weak. Pitiful."},
        {"zh": "报出你的战力值。", "en": "State your power level."},
        {"zh": "别动，我在扫描。", "en": "Don't move. I'm scanning."},
        {"zh": "这星球的人都这么矮？", "en": "Everyone on this planet so short?"},
        {"zh": "你的眼神不服气。", "en": "Your eyes look defiant."},
        {"zh": "弗利萨军的规矩你懂吗？", "en": "Do you know Frieza Force rules?"},
        {"zh": "站直，别像虫子。", "en": "Stand straight. Don't crawl."},
        {"zh": "你是本地人还是入侵者？", "en": "Local, or an invader?"},
        {"zh": "我数三个数，你说话。", "en": "I count three. Then you talk."},
        {"zh": "护目镜里，你的心跳很快。", "en": "On my scouter, your heartbeat races."},
        {"zh": "命令只有一个：清空这片平原。", "en": "I have one order: clear these plains."},
        {"zh": "护目镜说你无害。", "en": "The scouter says harmless."},
        {"zh": "可惜，无害也得死。", "en": "Pity — harmless still dies."},
        {"zh": "你认识抵抗军吗？", "en": "Do you know the resistance?"},
        {"zh": "把武器放地上。", "en": "Put your weapon on the ground."},
        {"zh": "你的气在发抖。", "en": "Your ki trembles."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "护目镜碎了一角。", "en": "A corner of my scouter cracked."},
        {"zh": "甲片凹了，不错。", "en": "Dented my plate. Not bad."},
        {"zh": "我低估你了。", "en": "I underestimated you."},
        {"zh": "血味让我清醒。", "en": "The taste of blood wakes me."},
        {"zh": "这具身体会疼。", "en": "This body feels pain."},
        {"zh": "退一步，重新站好。", "en": "One step back. Reset stance."},
        {"zh": "我听见骨头在响。", "en": "I hear my bones creak."},
        {"zh": "你的气比读数高。", "en": "Your ki runs above the reading."},
        {"zh": "我记住了这一下。", "en": "I'll remember that hit."},
        {"zh": "这场还没结束呢。", "en": "This isn't over yet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是铁锭吗？给我。", "en": "Is that iron? Hand it over."},
        {"zh": "爆能炮的零件，眼熟了。", "en": "I know those blaster parts."},
        {"zh": "补给箱，打开。", "en": "Supply crate. Open it."},
        {"zh": "有用的东西都归军队。", "en": "Useful things belong to the army."},
        {"zh": "我不饿，我要装备。", "en": "I'm not hungry. I want equipment."},
        {"zh": "那块金属我要了。", "en": "I'll take that metal."},
        {"zh": "你的护目镜，不合脸。", "en": "Your scouter won't fit you."},
        {"zh": "箱子里的都归我。", "en": "Everything in the crate is mine."},
        {"zh": "技术员会喜欢这个。", "en": "The techs will like this."},
        {"zh": "别藏，我看见了。", "en": "Don't hide it. I saw."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我？你算什么东西。", "en": "You bumped me? What are you?"},
        {"zh": "别用脏手碰甲。", "en": "Keep your dirty hands off my armor."},
        {"zh": "站稳，不然我扶你一把。", "en": "Steady, or I'll steady you myself."},
        {"zh": "你的骨头很脆。", "en": "Your bones sound brittle."},
        {"zh": "退三步，这是命令。", "en": "Three steps back. That's an order."},
        {"zh": "撞得我护目镜歪了。", "en": "You knocked my scouter crooked."},
        {"zh": "让开，我在执行任务。", "en": "Move. I'm on assignment."},
        {"zh": "我的靴子被你踩脏了。", "en": "You scuffed my boots."},
        {"zh": "别蹭过来，我的枪口对着你。", "en": "Don't brush against me — my barrel is on you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "弗利萨军不鼓励这个。", "en": "The Frieza Force discourages this."},
        {"zh": "任务结束后再说。", "en": "Ask me after the mission."},
        {"zh": "你的战力配得上我。", "en": "Your power suits mine."},
        {"zh": "别在指挥官面前笑。", "en": "Don't smile in front of the commander."},
        {"zh": "我们回同一艘船。", "en": "We share the same ship."},
        {"zh": "护目镜摘了才看清你。", "en": "Only without the scouter do I see you."},
        {"zh": "战死的人不该有牵绊。", "en": "The dead shouldn't have ties."},
        {"zh": "你的编号是多少？", "en": "What's your designation?"},
        {"zh": "同队，就同一条命。", "en": "Same squad, same fate."},
        {"zh": "活下去，就有下次。", "en": "Live, and there'll be a next time."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "几块铁，凑合能用。", "en": "Some iron. It'll do."},
        {"zh": "爆能炮还能修。", "en": "This blaster can be fixed."},
        {"zh": "捡起掉落的零件。", "en": "I collect the fallen parts."},
        {"zh": "小气弹的引信。", "en": "A ki blast fuse."},
        {"zh": "这块矿有能量味。", "en": "This ore smells of energy."},
        {"zh": "谁掉的护目镜？", "en": "Whose scouter dropped?"},
        {"zh": "袋子里还空着。", "en": "My pouch still has room."},
        {"zh": "收起来，回去登记。", "en": "Take it. Log it later."},
        {"zh": "一截金属管，挺有用。", "en": "A metal tube. Useful."},
        {"zh": "战利品算我的功劳。", "en": "Loot counts as my credit."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "护目镜锁定了！", "en": "Scouter locked on!"},
        {"zh": "你身上有气的波动。", "en": "There's ki coming off you."},
        {"zh": "别跑了，浪费我时间。", "en": "Stop running. You're wasting my time."},
        {"zh": "外面的抵抗军？", "en": "Resistance from outside?"},
        {"zh": "数值不高，处理掉。", "en": "Low reading. Dispose of it."},
        {"zh": "你的气在上升。", "en": "Your ki is rising."},
        {"zh": "我闻到了战斗味。", "en": "I smell a fight."},
        {"zh": "敢抬头看我，有胆。", "en": "You dare look up at me. Bold."},
        {"zh": "他在地平线上。", "en": "He's on the horizon."},
        {"zh": "先解决这个。", "en": "Handle this one first."},
        {"zh": "命令：清除目标。", "en": "Order: eliminate target."},
        {"zh": "平原上没地方躲。", "en": "Nowhere to hide on this plain."},
        {"zh": "飞起来，从上面压。", "en": "I rise — attack from above."},
        {"zh": "你的同伴会来救你吗？", "en": "Will your friends come for you?"},
        {"zh": "既然撞见，就别怪。", "en": "You crossed my path. Your error."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你的步法很粗糙。", "en": "Your footwork is crude."},
        {"zh": "我在算你的落点。", "en": "I'm calculating where you'll land."},
        {"zh": "气不要浪费在逃。", "en": "Don't waste ki running."},
        {"zh": "你绕圈子，很无聊。", "en": "Circling is boring me."},
        {"zh": "从左侧接近。", "en": "Approaching from the left."},
        {"zh": "读数是三百二十。", "en": "Reading: three twenty."},
        {"zh": "你喘了，还能撑多久。", "en": "You're panting. How long left?"},
        {"zh": "我等你的气耗尽。", "en": "I'll wait for your ki to drain."},
        {"zh": "你的护甲挡不住气功。", "en": "Armor won't stop ki blasts."},
        {"zh": "我飞得比你跑得快。", "en": "I fly faster than you run."},
        {"zh": "这一带没有掩体。", "en": "No cover in this stretch."},
        {"zh": "别指望援军。", "en": "Don't count on reinforcements."},
        {"zh": "你的手在找退路。", "en": "Your hand is looking for an exit."},
        {"zh": "编号已上报。", "en": "Designation reported in."},
        {"zh": "护目镜锁定不掉了。", "en": "The lock won't shake."},
        {"zh": "你现在是猎物。", "en": "Now you're the prey."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一记直拳直奔面门！", "en": "A straight punch at the face!"},
        {"zh": "你的防守太软。", "en": "Your guard is soft."},
        {"zh": "膝撞，接上勾。", "en": "Knee, then an uppercut."},
        {"zh": "三十倍重力教过我。", "en": "Thirty times gravity taught me this."},
        {"zh": "一脚把你踢飞出去。", "en": "One kick sends you flying."},
        {"zh": "气聚在拳上！", "en": "Ki gathers in my fist!"},
        {"zh": "破你的架势。", "en": "I break your stance."},
        {"zh": "这一声叫得不错。", "en": "That was a satisfying sound."},
        {"zh": "连着来，别停。", "en": "Keep the combo going."},
        {"zh": "侧身，打你肋骨。", "en": "Turn — my fist finds your ribs."},
        {"zh": "一记肘击砸你后颈。", "en": "An elbow into the back of your neck."},
        {"zh": "别后退，会疼。", "en": "Don't back away. It'll hurt more."},
        {"zh": "气功贴着脸打出去！", "en": "Ki blast fired point blank!"},
        {"zh": "你的铁皮顶不住。", "en": "Your tin won't hold."},
        {"zh": "这拳是军规。", "en": "This punch is procedure."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "弗利萨军，报到。", "en": "Frieza Force, reporting in."},
        {"zh": "护目镜已开启。", "en": "Scouter online."},
        {"zh": "坐标：阿吉萨平原。", "en": "Coordinates: Ageeza plain."},
        {"zh": "我奉命来清理。", "en": "I'm here to clean up."},
        {"zh": "这星球归我们了。", "en": "This planet is ours now."},
        {"zh": "飞行模式，启动。", "en": "Flight mode, engaged."},
        {"zh": "地上的家伙抬头了。", "en": "The groundlings look up."},
        {"zh": "谁在这里生火？", "en": "Who lit a fire here?"},
        {"zh": "气在脚下，站稳。", "en": "Ki beneath my feet. Steady."},
        {"zh": "我从舰上下来。", "en": "I came down from the ship."},
        {"zh": "任务清单第一条。", "en": "First item on the mission list."},
        {"zh": "平原上多了个影子。", "en": "A new shadow on the plain."},
        {"zh": "你的基地暴露了。", "en": "Your base is compromised."},
        {"zh": "报上人口数量。", "en": "Report the population."},
        {"zh": "侦察队先到一步。", "en": "The scout team arrived first."},
        {"zh": "我带来的不是问候。", "en": "I bring no greetings."},
        {"zh": "甲片反光，看到了吗。", "en": "See the gleam of my armor?"},
        {"zh": "站好，别让我重复。", "en": "Stand straight. I won't repeat it."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰烤着我的甲片。", "en": "Flame cooks my armor plates."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地太猛，腿发麻。", "en": "Hard landing numbed my legs."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水下我用不了气。", "en": "No ki for me underwater."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击波撞得我打转。", "en": "The shockwave spun me around."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过护目镜。", "en": "Something cracked through my scouter."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股力量不是气。", "en": "This power isn't ki."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没补给，气撑不久。", "en": "No supplies — my ki won't last."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击穿了浮气场。", "en": "Lightning pierced my ki field."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里护目镜没读数。", "en": "The scouter reads nothing here."}
      ]
    }
  }
}
