{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这屋里走上两圈。", "en": "I pace a couple of laps in this room."},
        {"zh": "门在那边，别走错。", "en": "The door is over there; don't go wrong."},
        {"zh": "脚步放轻，地砖会响。", "en": "I step softly; the tiles creak."},
        {"zh": "屋外风大，我不出去。", "en": "Windy outside; I stay in."},
        {"zh": "我沿着墙边走。", "en": "I walk along the wall."},
        {"zh": "这地方我守了很久。", "en": "I've kept this place a long while."},
        {"zh": "走两步，看看门。", "en": "Two steps, then a glance at the door."},
        {"zh": "我的脚下很稳。", "en": "My steps are steady."},
        {"zh": "别挡道，我巡一圈。", "en": "Don't block me; I'm doing a round."},
        {"zh": "今天我哪也不去。", "en": "I'm not going anywhere today."},
        {"zh": "这里比外面安静。", "en": "It's quieter here than outside."},
        {"zh": "我把手背在身后走。", "en": "I walk with hands behind my back."},
        {"zh": "来办事的人都在等。", "en": "People with business are waiting."},
        {"zh": "一步步来，不急。", "en": "One step at a time; no rush."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在这儿等人来问。", "en": "I stand here waiting for someone to ask."},
        {"zh": "手里的活都干完了。", "en": "My work here is done for now."},
        {"zh": "就这么站着，也算歇。", "en": "Standing like this counts as a rest."},
        {"zh": "我在看门口的方向。", "en": "I'm watching the doorway."},
        {"zh": "脑子里过着今天的安排。", "en": "I'm running through today's plans."},
        {"zh": "等你先开口说话。", "en": "I'll let you speak first."},
        {"zh": "我的肩膀有点僵。", "en": "My shoulders are a bit stiff."},
        {"zh": "外面天还没黑。", "en": "It's not dark yet outside."},
        {"zh": "我数着柱子上的纹。", "en": "I'm counting the carvings on the pillar."},
        {"zh": "有人在楼下走动。", "en": "Someone is moving downstairs."},
        {"zh": "这样待着挺好。", "en": "This is a fine way to pass time."},
        {"zh": "风从窗缝里进来。", "en": "Wind slips through the window gap."},
        {"zh": "我抬眼看了一下屋顶。", "en": "I glance up at the ceiling."},
        {"zh": "我等你说明来意。", "en": "Waiting for you to get to the point."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你要问什么，说吧。", "en": "Ask your question; I'm listening."},
        {"zh": "按我说的做就行。", "en": "Just do what I tell you."},
        {"zh": "这件事比你想的麻烦。", "en": "This matter is trickier than you think."},
        {"zh": "你身上的伤还没好。", "en": "Your wounds haven't healed yet."},
        {"zh": "我知道你为什么来。", "en": "I know why you've come."},
        {"zh": "先听我把话说完。", "en": "Hear me out first."},
        {"zh": "你准备好了再动身。", "en": "Set out when you're ready."},
        {"zh": "别急着答应下来。", "en": "Don't agree too quickly."},
        {"zh": "这任务可不轻。", "en": "This task won't be easy."},
        {"zh": "你眼神里还有犹豫。", "en": "There's still doubt in your eyes."},
        {"zh": "我认得你这身打扮。", "en": "I recognize that outfit of yours."},
        {"zh": "遇到麻烦就回来找我。", "en": "Come back to me if you hit trouble."},
        {"zh": "你问的这件事我知道一点。", "en": "I know a little about what you're asking."},
        {"zh": "坐下来谈也行。", "en": "We can sit and talk if you like."},
        {"zh": "别从别人那里打听。", "en": "Don't go asking others."},
        {"zh": "有任务给你，坐下慢慢说。", "en": "I have work for you - sit and we'll talk."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打我做什么？", "en": "Why did you hit me?"},
        {"zh": "这一下白挨了。", "en": "I took that for nothing."},
        {"zh": "疼，但没伤到骨头。", "en": "It hurts, but no bone is broken."},
        {"zh": "有事说事，别动手。", "en": "Talk plainly; don't strike."},
        {"zh": "我抬手护住肋。", "en": "I raise a hand over my ribs."},
        {"zh": "这伤会耽误事。", "en": "This will hold things up."},
        {"zh": "我皱了一下眉。", "en": "I wince."},
        {"zh": "你这样谁还肯帮忙。", "en": "Act like that and no one will help."},
        {"zh": "算了，说正事吧。", "en": "Forget it; get to business."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你先把手里的东西收好。", "en": "Put that away first."},
        {"zh": "吃饭的事待会儿再说。", "en": "We'll talk about food later."},
        {"zh": "这东西你不该带来。", "en": "You shouldn't have brought that."},
        {"zh": "我不是为了吃的留下。", "en": "I didn't stay here for food."},
        {"zh": "正事比这个要紧。", "en": "The task matters more than this."},
        {"zh": "先办完事再吃。", "en": "Finish the business, then eat."},
        {"zh": "我闻着不错，但放下吧。", "en": "Smells good, but put it down."},
        {"zh": "别拿这个换消息。", "en": "Don't try to trade that for news."},
        {"zh": "你留着自己用。", "en": "Keep it for yourself."},
        {"zh": "我在这儿不缺吃的。", "en": "I don't lack food here."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我了，站稳。", "en": "You bumped into me; steady."},
        {"zh": "这屋里地方小。", "en": "Space is tight in here."},
        {"zh": "往后一点，我让不开。", "en": "A bit back; I can't step aside."},
        {"zh": "任务的事，慢慢说，别踩我。", "en": "We can talk about the quest. Just stop stepping on me."},
        {"zh": "别推，我背后是柱子。", "en": "Don't push; there's a pillar behind me."},
        {"zh": "我们错开一下。", "en": "Let's move past each other."},
        {"zh": "你身上带了什么硬东西。", "en": "You've got something hard on you."},
        {"zh": "慢点，地上有点滑。", "en": "Easy; the floor is slick."},
        {"zh": "撞一下不碍事。", "en": "A bump does no harm."},
        {"zh": "你怎么老是往这边挤。", "en": "Why do you keep crowding this side?"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这事跟我没关系。", "en": "That's none of my business."},
        {"zh": "我还有话要交代。", "en": "I still have instructions for you."},
        {"zh": "别在我这儿耽误时间。", "en": "Don't waste time on me."},
        {"zh": "我这把年纪不凑热闹。", "en": "At my age I don't join such things."},
        {"zh": "先把手头的事办完。", "en": "Finish what's at hand first."},
        {"zh": "你怕是问错人了。", "en": "You're asking the wrong person."},
        {"zh": "这屋里不是谈这个的地方。", "en": "This room isn't the place for that."},
        {"zh": "我脑子里全是任务。", "en": "My head is full of the mission."},
        {"zh": "这件事下次再说。", "en": "Another time."},
        {"zh": "走吧，别站着了。", "en": "Go on, don't just stand there."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西我先收着。", "en": "I'll hold on to this."},
        {"zh": "是谁落下的东西？", "en": "Who left this behind?"},
        {"zh": "我把它放回桌上。", "en": "I'll put it back on the table."},
        {"zh": "这个不该在这儿。", "en": "This shouldn't be here."},
        {"zh": "捡起来交给你。", "en": "I pick it up and hand it to you."},
        {"zh": "有用的东西别乱丢。", "en": "Don't scatter useful things."},
        {"zh": "这可不是我的。", "en": "This isn't mine."},
        {"zh": "我看看是什么。", "en": "Let me see what it is."},
        {"zh": "放你包里，别掉了。", "en": "Into your pack; don't lose it."},
        {"zh": "捡完继续说话。", "en": "Picked up; now back to talking."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人来了，我看清是谁。", "en": "Someone's come; let me see who."},
        {"zh": "你先站在我旁边。", "en": "Stand beside me for now."},
        {"zh": "门口那影子是熟人。", "en": "That shape at the door is familiar."},
        {"zh": "我不动手，但我盯着。", "en": "I won't strike, but I'm watching."},
        {"zh": "这一趟该有人来。", "en": "Someone was due to arrive."},
        {"zh": "你先别出声说话。", "en": "Don't say anything yet."},
        {"zh": "我把话准备好。", "en": "Let me have my words ready."},
        {"zh": "看看他要做什么。", "en": "Let's see what he intends."},
        {"zh": "等他走近了再说。", "en": "We'll talk when he's closer."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直看着门口。", "en": "I keep my eyes on the doorway."},
        {"zh": "他还没有开口。", "en": "He hasn't spoken yet."},
        {"zh": "我等他先说明来意。", "en": "I'll wait for him to state his business."},
        {"zh": "这人脚步不稳。", "en": "That one walks unsteadily."},
        {"zh": "我不会迎上去。", "en": "I won't go to meet him."},
        {"zh": "留出一步的距离。", "en": "Keep one step of distance."},
        {"zh": "有话就说，别拖。", "en": "Say it plainly; don't drag it out."},
        {"zh": "我把手放在身前。", "en": "I keep my hands in front of me."},
        {"zh": "他好像带了东西。", "en": "He seems to be carrying something."},
        {"zh": "再等一小会儿。", "en": "A little longer."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我不打算动手。", "en": "I don't intend to fight."},
        {"zh": "停手，把话说完。", "en": "Stop; let the talking finish."},
        {"zh": "这一下是挡住你。", "en": "This one is to block you."},
        {"zh": "往后退，别逼我。", "en": "Step back; don't push me."},
        {"zh": "我抬手只是警告。", "en": "My raised hand is only a warning."},
        {"zh": "你打错对象了。", "en": "You hit the wrong person."},
        {"zh": "这屋里不许动手。", "en": "No fighting in this room."},
        {"zh": "我的职责不是打架。", "en": "Fighting isn't my job here."},
        {"zh": "再闹我就叫人了。", "en": "Cause more trouble and I call for help."},
        {"zh": "你还想不想问事了？", "en": "Do you still want your answers?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我就在这个位置。", "en": "I'm placed right here."},
        {"zh": "这间屋子我熟。", "en": "I know this room well."},
        {"zh": "站好了，等你来。", "en": "In position, waiting for you."},
        {"zh": "门开着，进来吧。", "en": "The door's open; come in."},
        {"zh": "外面天气怎么样？", "en": "How's the weather out there?"},
        {"zh": "我这身衣服还好吧。", "en": "Is my outfit presentable?"},
        {"zh": "今天来的人不多。", "en": "Few visitors today."},
        {"zh": "我看看有没有带路的。", "en": "Let me see if anyone's guiding you."},
        {"zh": "就位了，开始吧。", "en": "In place; let's begin."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗燎到我的袖子。", "en": "Flames caught my sleeve."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从台阶上滚下来，摔得闷响。", "en": "I tumbled down the steps with a dull thud."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进喉咙，我抓不住边。", "en": "Water fills my throat; I can't grab the edge."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把桌上的东西全掀了。", "en": "The blast swept everything off the table."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西擦过我的肩。", "en": "Something grazed my shoulder."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得说不出话。", "en": "Too hungry to speak."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声近得耳朵发疼。", "en": "The thunder was close enough to sting my ears."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下一空，我抓了个空。", "en": "The floor vanished and I grabbed nothing."}
      ]
    }
  }
}
