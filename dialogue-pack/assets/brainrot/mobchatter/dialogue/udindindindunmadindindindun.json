{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一颠地过来", "en": "I come along with a bounce."},
        {"zh": "我甩着胳膊往前走", "en": "I swing my arms as I walk."},
        {"zh": "我绕着地面走一圈", "en": "I walk a circle on the ground."},
        {"zh": "我歪着身子靠近", "en": "I come closer, body tilted."},
        {"zh": "我从草里挤出来", "en": "I squeeze out of the grass."},
        {"zh": "我踩地的声音很响", "en": "My steps are loud."},
        {"zh": "我走到你前面站住", "en": "I stop in front of you."},
        {"zh": "我一步跨得很大", "en": "My stride is very wide."},
        {"zh": "我慢慢挪向你", "en": "I move slowly toward you."},
        {"zh": "我拐了个弯过来", "en": "I come around the corner."},
        {"zh": "我的影子跟着乱晃", "en": "My shadow jitters along with me."},
        {"zh": "我一路晃到你附近", "en": "I sway my way over to you."},
        {"zh": "我又往前顶了一步", "en": "I press one step forward."},
        {"zh": "我停住，脚掌压弯了草。", "en": "I stop, my foot bending the grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着晃来晃去", "en": "I stand and sway about."},
        {"zh": "我把头拗过去看", "en": "I twist my head round to look."},
        {"zh": "我的手臂垂着", "en": "My arms hang down."},
        {"zh": "我眼珠子钉在你身上", "en": "My eyes are pinned to you."},
        {"zh": "我绷着身子站住", "en": "I hold my body rigid."},
        {"zh": "我歪着头想了会", "en": "I tilt my head and think."},
        {"zh": "我呼出一口粗气", "en": "I blow out a rough breath."},
        {"zh": "我站着不动，脖子微微前倾。", "en": "I stand still, neck leaning slightly forward."},
        {"zh": "我忽然安静下来", "en": "I go quiet all at once."},
        {"zh": "我这名字，比我的牙还长。", "en": "My name is longer than my teeth."},
        {"zh": "我慢慢蹲低了", "en": "I crouch down slowly."},
        {"zh": "我又慢慢地站起来", "en": "I stand up again."},
        {"zh": "我在看你手里的东西", "en": "I am looking at what you hold."},
        {"zh": "我晃了晃肩膀", "en": "I roll my shoulders."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把脸转过来", "en": "I turn my face to you."},
        {"zh": "我歪头，影子的头也歪了。", "en": "I tilt my head, and my shadow tilts too."},
        {"zh": "我低头看你，得弯下脖子。", "en": "I look down at you, neck bent."},
        {"zh": "你不打算走吗", "en": "Are you not leaving?"},
        {"zh": "我朝你迈了半步", "en": "I take half a step toward you."},
        {"zh": "我瞅着你手掌", "en": "I peer at your palm."},
        {"zh": "我慢慢地举起拳头", "en": "I raise a fist slowly."},
        {"zh": "我垂着长手，等你先挥拳。", "en": "My long arms hang as I wait for your first punch."},
        {"zh": "你的衣服不错", "en": "Your clothes look decent."},
        {"zh": "我咧了下嘴角", "en": "The corner of my mouth lifts."},
        {"zh": "我往前压了压身子", "en": "I lean my weight forward."},
        {"zh": "你要是不动我就动了", "en": "If you do not move, I will."},
        {"zh": "我不喜欢等太久", "en": "I dislike waiting long."},
        {"zh": "我这边都备好了", "en": "My side is ready."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打得退开", "en": "The blow pushes me back."},
        {"zh": "我打了个趔趄站住", "en": "I stumble and catch myself."},
        {"zh": "我喉咙里闷响一下", "en": "One dull sound from my throat."},
        {"zh": "我转了转僵脖子", "en": "I twist my stiff neck."},
        {"zh": "我身上血迹斑斑", "en": "Blood patches cover me."},
        {"zh": "我支着膝盖爬起", "en": "I prop on a knee and rise."},
        {"zh": "这一下真是疼", "en": "That one stung."},
        {"zh": "我揉了一下肩膀", "en": "I rub my shoulder."},
        {"zh": "我还没打算停手", "en": "I do not mean to stop swinging."},
        {"zh": "我又握紧了拳", "en": "I close my fist again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里是什么", "en": "What is in your hand?"},
        {"zh": "我把脑袋偏了偏", "en": "I cock my head a little."},
        {"zh": "这东西我不太稀罕", "en": "I do not much care for this."},
        {"zh": "我拿指头戳了戳", "en": "I poke it with a finger."},
        {"zh": "敲得这么响，不是吃的。", "en": "It rings too loud to be food."},
        {"zh": "我一把把它拨回去", "en": "I bat it back at you."},
        {"zh": "我又把眼抬起来看你", "en": "I lift my eyes to you again."},
        {"zh": "你兜里还揣着别的吗", "en": "Anything else in your pocket?"},
        {"zh": "我对它不感兴趣", "en": "I am not interested."},
        {"zh": "我转身走开两步", "en": "I turn and walk two steps off."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你这一撞我晃了两晃", "en": "Your bump rocks me twice."},
        {"zh": "我把两腿钉稳了", "en": "I nail both legs down."},
        {"zh": "我们撞得响了一下", "en": "We collide with a sound."},
        {"zh": "你被我挤开了", "en": "I crowd you aside."},
        {"zh": "我抬脚让了让", "en": "I shift my foot out of the way."},
        {"zh": "我撞得自己也退了", "en": "I am knocked back a bit too."},
        {"zh": "我从你身边绕过去", "en": "I go around you."},
        {"zh": "你撞过来，我晃了晃才站住。", "en": "You crash in; I sway before finding my feet."},
        {"zh": "我又摆回原来的位置", "en": "I settle back into place."},
        {"zh": "这点斤两推不动我", "en": "That weight will not move me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一个颠着靠近", "en": "Another bobs closer."},
        {"zh": "我们歪头的方向一样", "en": "We tilt the same way."},
        {"zh": "它比我瘦一些", "en": "It is thinner than I."},
        {"zh": "我们并肩往你那边走", "en": "We walk toward you together."},
        {"zh": "我们一起晃着身体", "en": "We sway together."},
        {"zh": "它站在我左边", "en": "It stands at my left."},
        {"zh": "我们谁都不开口", "en": "Not one of us opens a mouth."},
        {"zh": "我们一道盯着你", "en": "We stare at you in a line."},
        {"zh": "它先跨了一步出去", "en": "It gets one step ahead first."},
        {"zh": "我跟着它过去", "en": "I go along after it."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我塌下腰去捡", "en": "I sag down to pick it up."},
        {"zh": "我捏起来对着光看", "en": "I pinch it up to the light."},
        {"zh": "我把它翻了个面", "en": "I turn it over."},
        {"zh": "我把它捏碎了", "en": "I crush it."},
        {"zh": "我牙一合就咬", "en": "My teeth close and bite."},
        {"zh": "我一口吐了出来", "en": "I spit it out."},
        {"zh": "我随手就扔了", "en": "I toss it away."},
        {"zh": "这块石头，我攥进掌心。", "en": "This stone, I close into my palm."},
        {"zh": "我塞进衣兜里", "en": "I stuff it into my coat."},
        {"zh": "我丢开就不再碰", "en": "I drop it and leave it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我把脸朝你那边挪", "en": "I swing my face your way."},
        {"zh": "我不再乱晃了", "en": "I stop swaying."},
        {"zh": "我把拳头握紧", "en": "I close my fist."},
        {"zh": "我朝你走一步", "en": "I take a step toward you."},
        {"zh": "我盯住你，一步也不眨。", "en": "I fix on you and don't blink once."},
        {"zh": "我一肩沉下去", "en": "One shoulder drops."},
        {"zh": "我这就开始了", "en": "I am about to start."},
        {"zh": "别动，我的眼睛已经定住。", "en": "Don't move; my eyes have locked on."},
        {"zh": "这几步我数过了", "en": "I have counted these steps."},
        {"zh": "这一拳分量很足", "en": "This fist carries weight."},
        {"zh": "我盯住你的腰", "en": "I fix on your waist."},
        {"zh": "我这就可以动手", "en": "I can start right now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你动一步我应一步", "en": "Each of your steps I answer."},
        {"zh": "你往左，我的长腿也往左。", "en": "You go left, and my long legs go left."},
        {"zh": "我在等你露出空隙", "en": "I wait for your opening."},
        {"zh": "我不急，先看你往哪跑。", "en": "No rush; let's see where you run."},
        {"zh": "我一节一节顶过去", "en": "I bear down joint by joint."},
        {"zh": "你把重心放在后脚", "en": "Your weight is on your back foot."},
        {"zh": "你抬手我就动了", "en": "Your hand lifts, and I move."},
        {"zh": "这个间距正合适", "en": "This spacing suits me."},
        {"zh": "再近一步，我就够到你。", "en": "One step closer, and I can reach you."},
        {"zh": "你胸口起伏，我全看在眼里。", "en": "I watch every rise and fall of your chest."},
        {"zh": "你退也没有用", "en": "Retreating will not help."},
        {"zh": "我随时能出手", "en": "I could strike any moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "这一拳下去，地板塌了一块。", "en": "One punch, and the floor caves in."},
        {"zh": "我打在他的侧腰", "en": "My blow lands on his flank."},
        {"zh": "我顺手又推了一把", "en": "I shove him as well."},
        {"zh": "他被我打得歪倒", "en": "The hit knocks him crooked."},
        {"zh": "我又砸下去一记", "en": "I hammer down once more."},
        {"zh": "我抓住他的肩", "en": "I catch his shoulder."},
        {"zh": "我把他甩到地上", "en": "I throw him down."},
        {"zh": "我敲起东西来像打鼓。", "en": "When I knock, it sounds like a drum."},
        {"zh": "你退开我就追", "en": "You back off; I follow."},
        {"zh": "我打得手都发麻", "en": "My hand goes numb from hitting."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我晃着出现在这里", "en": "I sway into view here."},
        {"zh": "我先扫了一遍场地", "en": "I sweep the ground once."},
        {"zh": "我侧着脸站着不动", "en": "I stand with my face turned."},
        {"zh": "影子比我先压到地上", "en": "My shadow hits the ground first."},
        {"zh": "我一踏一踏迈到中心", "en": "I tramp to the centre."},
        {"zh": "这儿的空气发闷", "en": "The air here is close and sour."},
        {"zh": "我立住没再挪脚", "en": "I stop and move no more."},
        {"zh": "我转转眼珠，踩碎了枯枝。", "en": "I roll my eyes and snap a dry twig underfoot."},
        {"zh": "我听到这儿有动静", "en": "Something moved here."},
        {"zh": "我慢慢把背拉直", "en": "I draw my back up slowly."},
        {"zh": "我开始朝你那边走", "en": "I start walking your way."},
        {"zh": "我抬起一只手来", "en": "I lift one hand."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧着了我的衣服", "en": "Fire catches my clothes."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时，我膝盖磕出闷响。", "en": "Landing, my knees crack with a dull thud."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水呛进喉咙，我猛咳起来。", "en": "Water floods my throat and I cough hard."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "被炸到一边，我还在数拍子。", "en": "Blown aside, I am still counting beats."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "我这名字太长，喊完你就跑了。", "en": "My name's so long you'll flee before I finish it."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光烧得我缩起来", "en": "Spell light makes me flinch."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得没力气了", "en": "Hunger takes my strength."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我站不住了", "en": "Lightning strikes and I stagger."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我往下掉", "en": "I fall away."}
      ]
    }
  }
}
