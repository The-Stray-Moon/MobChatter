{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时沙子都跳起来。", "en": "Sand jumps when I land."},
        {"zh": "我不太会走直线。", "en": "Straight lines are not my skill."},
        {"zh": "我的身体像一堆拼起来的。", "en": "My body looks pieced together."},
        {"zh": "我蹦着过去，省得走。", "en": "I bounce across instead of walking."},
        {"zh": "每跳一下，地上留个坑。", "en": "Every hop leaves a dent."},
        {"zh": "我歪着头往前蹦。", "en": "I hop along with my head tilted."},
        {"zh": "脚步声像有人在拍木头。", "en": "My steps sound like someone slapping wood."},
        {"zh": "我跳过了矮墙。", "en": "I hop a low wall."},
        {"zh": "我回头看了一眼，又跳。", "en": "I glance back, then hop again."},
        {"zh": "我不停地小跳。", "en": "I keep up a little bouncing."},
        {"zh": "我落地很重。", "en": "My landings are heavy."},
        {"zh": "我沿着栅栏跳。", "en": "I bounce along the fence."},
        {"zh": "跳着比走着快。", "en": "Hopping is faster than walking."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，腿在抖。", "en": "I stand, my leg twitching."},
        {"zh": "我随时会跳起来。", "en": "I might jump at any moment."},
        {"zh": "我不知道自己在等什么。", "en": "I do not know what I am waiting for."},
        {"zh": "我的影子一颤一颤。", "en": "My shadow flickers."},
        {"zh": "风把我的耳朵吹得直响。", "en": "Wind whistles through my ears."},
        {"zh": "地上有个坑是我踩的。", "en": "That dent is mine."},
        {"zh": "我这身拼件咯吱响了一下。", "en": "My stitched parts creak once."},
        {"zh": "我感到很不安。", "en": "I feel very uneasy."},
        {"zh": "我转了个身，又转回来。", "en": "I turn, then turn back."},
        {"zh": "这些拼起来的东西不太合。", "en": "These parts do not fit well."},
        {"zh": "我抓了抓地。", "en": "I scratch at the ground."},
        {"zh": "我听到什么了。", "en": "I heard something."},
        {"zh": "我的关节在乱响。", "en": "My joints are rattling."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你别站在我跳的方向。", "en": "Do not stand where I might land."},
        {"zh": "我一只脚长一只脚短，站不稳。", "en": "One leg longer than the other, I cannot stand steady."},
        {"zh": "你身上有猎食者的味道吗？", "en": "Do you smell of a predator?"},
        {"zh": "我也说不清我在干什么。", "en": "I could not explain what I am doing."},
        {"zh": "我抖了抖，准备跳。", "en": "I quiver, ready to spring."},
        {"zh": "你站在我跳不到的地方。", "en": "You stand just beyond my leap."},
        {"zh": "你的脸我不太看得懂。", "en": "I cannot quite read your face."},
        {"zh": "我走两步就跳一下，沙都跳起来。", "en": "Two steps and a hop; the sand leaps too."},
        {"zh": "你退开一小步。", "en": "One small step back, please."},
        {"zh": "我在地上磨了磨脚。", "en": "I scuff the ground."},
        {"zh": "我把你框在落点里了。", "en": "You are inside my landing zone."},
        {"zh": "你站着别动最好。", "en": "Best if you stand still."},
        {"zh": "我数你的步数。", "en": "I count your steps."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跃而起，落在你身后。", "en": "I leap up and land behind you."},
        {"zh": "缝线崩开，露出里面的填充。", "en": "A seam bursts, showing the stuffing inside."},
        {"zh": "我跳开，落地时腿还在抖。", "en": "I hop away, legs still shaking on landing."},
        {"zh": "我跳过去的时候，声音很响。", "en": "My leap makes a loud noise."},
        {"zh": "我撑着腿站起来。", "en": "I push myself up on my legs."},
        {"zh": "你力气很大。", "en": "You hit hard."},
        {"zh": "记住了，下次我跳得更准。", "en": "Noted, next time I jump more precisely."},
        {"zh": "嘶——这一下真有点疼。", "en": "Hsss — that one actually stung."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那个能吃吗？", "en": "Is that edible?"},
        {"zh": "放地上吧，我跳过去拿。", "en": "Put it down. I will hop over for it."},
        {"zh": "我跳过来拿。", "en": "I will hop over for it."},
        {"zh": "这不够我一口。", "en": "Not enough for one bite."},
        {"zh": "我闻了闻，不太敢。", "en": "I sniff, and hesitate."},
        {"zh": "你先退开。", "en": "Step back first."},
        {"zh": "我拿了就跑。", "en": "I take it and bounce off."},
        {"zh": "我闻着像胶，又像铁锈。", "en": "It smells of glue, and of rust."},
        {"zh": "再来一个。", "en": "Another one."},
        {"zh": "我吃完还想跳。", "en": "After eating, I still want to jump."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我弹开了。", "en": "I bounce away."},
        {"zh": "我们两个都滚了。", "en": "We both went rolling."},
        {"zh": "你撞在我缝线的接缝上。", "en": "You hit me on a stitched seam."},
        {"zh": "我落地时砸出一个浅坑。", "en": "I land and pound out a shallow pit."},
        {"zh": "我落地时压到你。", "en": "I landed on you."},
        {"zh": "我腿上的弹簧压得吱响。", "en": "The spring in my leg squeaks under pressure."},
        {"zh": "我站起身，抖了抖。", "en": "I get up and shake myself."},
        {"zh": "我们绕开一点。", "en": "Let us separate a little."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这样子，不合适。", "en": "Like this, I am not suited."},
        {"zh": "我连自己是什么都不知道。", "en": "I do not know what I am."},
        {"zh": "我跳开了。", "en": "I hop away."},
        {"zh": "我站在原地，没动。", "en": "I stay where I am."},
        {"zh": "这些拼件不太听话。", "en": "These parts do not obey."},
        {"zh": "我跳向你，比走路快。", "en": "I leap at you, faster than walking."},
        {"zh": "不了。", "en": "No."},
        {"zh": "我蹦到一边，再蹦回来。", "en": "I hop aside, then hop back."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳过去叼起来。", "en": "I hop over and take it."},
        {"zh": "这个比我大。", "en": "This is bigger than me."},
        {"zh": "我叼起来，又嫌它太硬。", "en": "I pick it up in my mouth, then find it too hard."},
        {"zh": "我跳起来，一口叼住它。", "en": "I leap and snatch it in my teeth."},
        {"zh": "我的脚抓不住。", "en": "My feet cannot grip it."},
        {"zh": "我跳了两下就走了。", "en": "Two hops and I leave it."},
        {"zh": "我拿着。", "en": "I have it."},
        {"zh": "不需要。", "en": "Do not need it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "这一下我压上了全部。", "en": "I am putting everything into this."},
        {"zh": "我盯住你的上身。", "en": "I fix on your torso."},
        {"zh": "落点我算好了。", "en": "I have the landing point."},
        {"zh": "我不喜欢被打。", "en": "I dislike being hit."},
        {"zh": "我压低了腿。", "en": "I bend my legs."},
        {"zh": "你站的地方正好。", "en": "You are standing just right."},
        {"zh": "我腿上的肌腱一根根绷起来。", "en": "The tendons in my legs tighten one by one."},
        {"zh": "我从侧面跳。", "en": "I come in from the side."},
        {"zh": "你和我的坑一样高。", "en": "You and my dents are the same height."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在等你站定。", "en": "I wait for you to settle."},
        {"zh": "跃起来那一下，才是我。", "en": "The leap is the real me."},
        {"zh": "我的腿在蓄力。", "en": "My legs are loading."},
        {"zh": "你退，我就跟，一蹦一蹦地跟。", "en": "You step back, I follow, hop by hop."},
        {"zh": "我这一跳会落在你身上。", "en": "This jump lands on you."},
        {"zh": "地上是我的坑。", "en": "These dents are mine."},
        {"zh": "我把落点算在你脚前三寸。", "en": "I aim my landing three inches before your feet."},
        {"zh": "风现在对我有利。", "en": "The wind favors me."},
        {"zh": "你的重心偏了。", "en": "Your weight has shifted."},
        {"zh": "跳。", "en": "Jump."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个身体撞过去。", "en": "I throw my whole body at you."},
        {"zh": "落地时把你压住。", "en": "I land on you."},
        {"zh": "我用膝盖撞你。", "en": "I drive a knee in."},
        {"zh": "我也摔了一下。", "en": "I flop down too."},
        {"zh": "这一跳没算准。", "en": "That jump was miscalculated."},
        {"zh": "别以为我只会跳。", "en": "Do not think jumping is all I do."},
        {"zh": "我一跃就到你面前。", "en": "One leap and I am before you."},
        {"zh": "跳起来砸你，躲得开算你赢。", "en": "I leap and slam — dodge it and you win."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳进这片地。", "en": "I hop into this ground."},
        {"zh": "落地时砸了一下。", "en": "My landing thumps."},
        {"zh": "我也不知道怎么来的。", "en": "I do not know how I got here."},
        {"zh": "这里的地板很硬。", "en": "This floor is hard."},
        {"zh": "我歪着头看四周。", "en": "I look around, head tilted."},
        {"zh": "我先试探了一步。", "en": "I test one step."},
        {"zh": "我的影子先动。", "en": "My shadow moves first."},
        {"zh": "风里有土味。", "en": "Earth on the wind."},
        {"zh": "我从土里蹦出来，草屑乱飞。", "en": "I burst out of the soil, grass bits flying."},
        {"zh": "我在找能跳的地方。", "en": "I look for somewhere to spring from."},
        {"zh": "远处有一个坑。", "en": "There is a dent in the distance."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎得我直跳。", "en": "Fire makes me dance and leap."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔得翻了身。", "en": "I land and roll over."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的缝里。", "en": "Water fills my seams."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀得翻跟头。", "en": "The blast flips me head over heels."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一个东西扎进我的壳。", "en": "Something sticks into my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我的腿乱抽。", "en": "That light makes my legs jerk."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我跳得更高。", "en": "Lightning strikes; I leap even higher."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地给我落。", "en": "No ground here to land on."}
      ]
    }
  }
}
