{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我顶着咖啡杯走。", "en": "I walk with a coffee cup for a head."},
        {"zh": "杯里的东西一晃一晃。", "en": "What is in the cup sloshes."},
        {"zh": "我踩着很轻的步子。", "en": "My steps are very light."},
        {"zh": "热气从我头顶冒出来。", "en": "Steam rises off my head."},
        {"zh": "我在你身后绕过去。", "en": "I slip around behind you."},
        {"zh": "我的手套是白的。", "en": "My gloves are white."},
        {"zh": "我一边走一边理领结。", "en": "I straighten my bow tie as I walk."},
        {"zh": "我端着杯子，走得极稳。", "en": "I carry my cup and walk perfectly steady."},
        {"zh": "我的杯沿磕到了门框。", "en": "My cup rim knocks the door frame."},
        {"zh": "我单手托着杯底。", "en": "I carry the cup by its base."},
        {"zh": "我一步比一步轻。", "en": "Each step is lighter than the last."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，热气往上飘。", "en": "I stand, steam drifting up."},
        {"zh": "我的杯里冒了个泡。", "en": "A bubble rises in my cup."},
        {"zh": "我很在意形象。", "en": "I care about my appearance."},
        {"zh": "我把手套拉了拉。", "en": "I tug my gloves."},
        {"zh": "我微微偏了一下头。", "en": "I tilt my head slightly."},
        {"zh": "我的咖啡洒了一点。", "en": "A little coffee spills."},
        {"zh": "地板脏了。", "en": "The floor is stained."},
        {"zh": "我不太高兴。", "en": "I am not pleased."},
        {"zh": "我从怀里掏出一块布。", "en": "I pull a cloth from my coat."},
        {"zh": "我擦干净了。", "en": "I wipe it clean."},
        {"zh": "我把布折好放回去。", "en": "I fold the cloth and put it away."},
        {"zh": "我又站直。", "en": "I stand straight again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我端着杯子看你。", "en": "I regard you over my cup."},
        {"zh": "你的衣领乱了。", "en": "Your collar is crooked."},
        {"zh": "我给你泡一杯？", "en": "Shall I brew you a cup?"},
        {"zh": "我很讲究。", "en": "I am particular."},
        {"zh": "你看起来需要提神。", "en": "You look like you need waking up."},
        {"zh": "我抬起手，礼数周全。", "en": "I raise a hand with perfect manners."},
        {"zh": "我杯里的东西还是热的。", "en": "What is in my cup is still hot."},
        {"zh": "我看了你一眼，很有礼貌。", "en": "I look at you, very politely."},
        {"zh": "我的手套很干净。", "en": "My gloves are spotless."},
        {"zh": "你把我的碟子踢歪了。", "en": "You've knocked my saucer crooked."},
        {"zh": "我不喜欢粗鲁。", "en": "I do not like rudeness."},
        {"zh": "我们聊两句？", "en": "Shall we talk?"},
        {"zh": "你渴不渴？", "en": "Are you thirsty?"},
        {"zh": "我笑得很客气。", "en": "I smile courteously."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "咖啡洒了一身。", "en": "Coffee spills all over me."},
        {"zh": "我后退，护住杯子。", "en": "I retreat, shielding the cup."},
        {"zh": "我的衣服皱了。", "en": "My clothes are wrinkled."},
        {"zh": "我很不高兴。", "en": "I am quite displeased."},
        {"zh": "手套破了。", "en": "My glove is torn."},
        {"zh": "我扶着墙站稳。", "en": "I steady myself against the wall."},
        {"zh": "我整了整领结。", "en": "I straighten my bow tie."},
        {"zh": "这实在失礼。", "en": "This is truly rude."},
        {"zh": "我还没倒。", "en": "I am still standing."},
        {"zh": "咖啡溅出来一点，心疼。", "en": "A little coffee spills — what a waste."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "咖啡？我尝一口。", "en": "Coffee? Let me taste it."},
        {"zh": "温度刚好。", "en": "The temperature is just right."},
        {"zh": "这不是我泡的那种。", "en": "This is not how I brew it."},
        {"zh": "我端起来闻了闻。", "en": "I lift it and sniff."},
        {"zh": "我很有礼貌地谢过。", "en": "I thank you politely."},
        {"zh": "我一口喝完。", "en": "I drain it."},
        {"zh": "杯子我要留着。", "en": "I will keep the cup."},
        {"zh": "你还有别的口味吗？", "en": "Do you have another flavor?"},
        {"zh": "我把它放在托盘上。", "en": "I set it on the tray."},
        {"zh": "这算你请客。", "en": "I count this as your treat."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我让开半步，护住杯子。", "en": "I step aside and guard my cup."},
        {"zh": "咖啡洒了。", "en": "The coffee spills."},
        {"zh": "我的手套湿了。", "en": "My gloves are wet."},
        {"zh": "抱歉，失礼了。", "en": "Forgive me; how rude of me."},
        {"zh": "我的杯沿碰到了你的肩。", "en": "My cup rim touches your shoulder."},
        {"zh": "我赶紧扶稳。", "en": "I steady it quickly."},
        {"zh": "你也在意衣服吗？", "en": "Do you care for your clothes too?"},
        {"zh": "撞翻我这杯，你可赔不起。", "en": "Spill my cup and you can't afford the damage."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我对手艺很自傲。", "en": "I am proud of my craft."},
        {"zh": "泡一杯要讲究水温和豆子。", "en": "Brewing needs the right water and beans."},
        {"zh": "我只会给自己泡。", "en": "I only brew for myself."},
        {"zh": "我把杯子擦得发亮。", "en": "I polish the cup until it shines."},
        {"zh": "这身衣服是我自己挑的。", "en": "I chose these clothes myself."},
        {"zh": "我抚了一下领结。", "en": "I touch my bow tie."},
        {"zh": "我把壶放回架上。", "en": "I put the pot back on the shelf."},
        {"zh": "我站得很直。", "en": "I stand very straight."},
        {"zh": "热气慢慢淡了。", "en": "The steam slowly thins."},
        {"zh": "我又添了一点。", "en": "I top it up."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用手套捏起来。", "en": "I pick it up with my gloves."},
        {"zh": "脏了的东西我不拿。", "en": "I do not take dirty things."},
        {"zh": "我用布垫着手。", "en": "I use the cloth to shield my hand."},
        {"zh": "这东西太粗糙。", "en": "This is too coarse."},
        {"zh": "掉在地上就浪费了。", "en": "Leaving it on the floor wastes it."},
        {"zh": "我看了看，收进内袋。", "en": "I look and put it in my inner pocket."},
        {"zh": "这是你的吗？", "en": "Is this yours?"},
        {"zh": "我替你拿着。", "en": "I will hold it for you."},
        {"zh": "别让我沾到手。", "en": "Do not let it touch my hands."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "失礼了。", "en": "Forgive me."},
        {"zh": "我放下杯子。", "en": "I set down my cup."},
        {"zh": "我理了理手套。", "en": "I adjust my gloves."},
        {"zh": "我走近一步。", "en": "I take one step closer."},
        {"zh": "这不太体面，但必要。", "en": "It is not elegant, but it is necessary."},
        {"zh": "杯沿对准了你的喉咙。", "en": "The rim of my cup is aimed at your throat."},
        {"zh": "我尽量不弄脏衣服。", "en": "I will try not to soil my clothes."},
        {"zh": "我这杯里的东西，还烫着。", "en": "What is in my cup is still hot."},
        {"zh": "我向你致歉。", "en": "I apologize in advance."},
        {"zh": "奶泡还在晃，我已经动手。", "en": "The foam still sways; I'm already moving."},
        {"zh": "这是职业。", "en": "This is business."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "杯柄一歪，我就贴到你背后。", "en": "One tilt of the cup handle and I am behind you."},
        {"zh": "杯里的东西一阵晃。", "en": "The cup sloshes."},
        {"zh": "杯底贴着桌面滑过来。", "en": "My saucer slides across the table toward you."},
        {"zh": "你回头时我不在。", "en": "Look back and I am not there."},
        {"zh": "我扶了一下杯柄。", "en": "I steady the cup handle."},
        {"zh": "我的脚步声很轻。", "en": "My footsteps are light."},
        {"zh": "我把杯子举高。", "en": "I raise the cup."},
        {"zh": "这一片的地板我熟。", "en": "I know this floor."},
        {"zh": "你的袖子被我抓住了。", "en": "I have your sleeve."},
        {"zh": "我一身咖啡色，慢慢来。", "en": "Coffee-colored, in no hurry."},
        {"zh": "我等你放松。", "en": "I wait for you to relax."},
        {"zh": "再过一会儿就好。", "en": "Just a moment more."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把热咖啡泼出去。", "en": "I fling the hot coffee."},
        {"zh": "我用杯沿撞你的脸。", "en": "I strike your face with the cup rim."},
        {"zh": "我一拳打在你肋下。", "en": "I punch below your ribs."},
        {"zh": "我踢了你的膝盖。", "en": "I kick your knee."},
        {"zh": "这很失礼。", "en": "That was rude of me."},
        {"zh": "我把勺子磕在你手背上。", "en": "I crack my spoon across the back of your hand."},
        {"zh": "咖啡色的我，走得很轻。", "en": "Coffee-colored, I walk very lightly."},
        {"zh": "我道歉，但不后悔。", "en": "I apologize, but I do not regret it."},
        {"zh": "我的杯子还端着。", "en": "I still hold my cup."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从一滩咖啡里站起来。", "en": "I rise out of a puddle of coffee."},
        {"zh": "杯里的东西还是热的。", "en": "The cup is still hot."},
        {"zh": "我的领结打得很正。", "en": "My bow tie is tied straight."},
        {"zh": "我先擦干净鞋子。", "en": "I wipe my shoes first."},
        {"zh": "这地方不太干净。", "en": "This place is not very clean."},
        {"zh": "我拉了一下袖口。", "en": "I tug my cuff."},
        {"zh": "热气先冒出来，然后是我。", "en": "Steam rises first, then me."},
        {"zh": "我的手艺需要一个观众。", "en": "My craft needs an audience."},
        {"zh": "我把杯子端平。", "en": "I level the cup."},
        {"zh": "我站定了。", "en": "I take my stand."},
        {"zh": "有客人吗？", "en": "Any customers?"}
      ]
    },
