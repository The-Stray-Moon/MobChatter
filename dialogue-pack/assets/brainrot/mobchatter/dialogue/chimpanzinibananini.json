{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着香蕉皮滑过来。", "en": "I slide over on a banana peel."},
        {"zh": "我一只手抓着香蕉。", "en": "I hold a banana in one hand."},
        {"zh": "我的步子又大又乱。", "en": "My strides are long and messy."},
        {"zh": "我边走边剥香蕉。", "en": "I peel a banana as I walk."},
        {"zh": "我跳了两下，又落地。", "en": "I hop twice and land."},
        {"zh": "我在地上留下一路皮。", "en": "I leave peels all along the way."},
        {"zh": "我朝你挥手。", "en": "I wave at you."},
        {"zh": "我绕着一棵树转。", "en": "I circle a tree."},
        {"zh": "我闻到了香蕉味。", "en": "I smell bananas."},
        {"zh": "我的毛发乱蓬蓬的。", "en": "My fur is a mess."},
        {"zh": "我朝你这边蹦。", "en": "I bounce your way."},
        {"zh": "我又滑了一下。", "en": "I slip again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲着剥香蕉。", "en": "I crouch and peel a banana."},
        {"zh": "我一口吃掉半根。", "en": "Half the banana disappears in one bite."},
        {"zh": "我舔了舔手指。", "en": "I lick my fingers."},
        {"zh": "我把皮往后一扔。", "en": "I toss the peel behind me."},
        {"zh": "我的眼睛转来转去。", "en": "My eyes dart about."},
        {"zh": "我在树上荡了一下。", "en": "I swing on a branch once."},
        {"zh": "我拍着自己的胸口。", "en": "I drum on my chest."},
        {"zh": "我坐着，晃着腿。", "en": "I sit and swing my legs."},
        {"zh": "我在找下一根。", "en": "I am looking for the next one."},
        {"zh": "我挠了挠腋下。", "en": "I scratch under my arm."},
        {"zh": "我把香蕉塞进嘴里。", "en": "I stuff the banana into my mouth."},
        {"zh": "我很满意。", "en": "I am satisfied."},
        {"zh": "我歪着头，看你有没有香蕉。", "en": "I tilt my head, checking you for bananas."},
        {"zh": "我又开始剥。", "en": "I start peeling another."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你有香蕉吗？", "en": "Do you have a banana?"},
        {"zh": "我把香蕉举给你看。", "en": "I hold up my banana for you."},
        {"zh": "你吃不吃？", "en": "Are you eating?"},
        {"zh": "我身上全是香蕉味。", "en": "I smell entirely of banana."},
        {"zh": "我的牙很白。", "en": "My teeth are very white."},
        {"zh": "你要我的吗？不给。", "en": "Do you want mine? No."},
        {"zh": "我歪头看你，像在算。", "en": "I tilt my head, as if calculating."},
        {"zh": "你身上没有香蕉味。", "en": "You do not smell of bananas."},
        {"zh": "我朝你吐了吐舌头。", "en": "I stick out my tongue at you."},
        {"zh": "我朝你伸出空手。", "en": "I hold out an empty hand."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我拍着胸口，叫得更响。", "en": "I pound my chest and yell even louder."},
        {"zh": "我跳到一边。", "en": "I hop aside."},
        {"zh": "香蕉掉了，我先去捡。", "en": "The banana fell; I grab it first."},
        {"zh": "我拍了胸口两下。", "en": "I beat my chest twice."},
        {"zh": "我把牙露了出来。", "en": "I show my teeth."},
        {"zh": "我的毛竖了。", "en": "My fur stands up."},
        {"zh": "我笑了，笑得不对。", "en": "I laugh, and it comes out wrong."},
        {"zh": "毛炸起来，我往后退。", "en": "My fur bristles and I back away."},
        {"zh": "我捂着脑袋跳了两下。", "en": "I clutch my head and hop twice."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "香蕉！", "en": "Banana!"},
        {"zh": "我一把抢过来。", "en": "I snatch it."},
        {"zh": "我剥皮剥得飞快。", "en": "I peel it in a flash."},
        {"zh": "这是我见过最大的一根。", "en": "This is the biggest one I have seen."},
        {"zh": "我一整口吞了下去。", "en": "I swallowed it in one gulp."},
        {"zh": "还有没有？", "en": "Any more?"},
        {"zh": "我把皮扔到你脚边。", "en": "I drop the peel at your feet."},
        {"zh": "我高兴地蹦。", "en": "I hop with joy."},
        {"zh": "你先别走。", "en": "Do not leave yet."},
        {"zh": "我闻了闻你的手。", "en": "I sniff your hand."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "香蕉掉了。", "en": "The banana falls."},
        {"zh": "我赶紧去捡。", "en": "I hurry to pick it up."},
        {"zh": "我滑出去老远。", "en": "I slide a long way."},
        {"zh": "我们撞得都笑了。", "en": "We bump, and both laugh."},
        {"zh": "我扶住你的肩。", "en": "I steady myself on your shoulder."},
        {"zh": "我的脚上全是泥。", "en": "My feet are covered in mud."},
        {"zh": "我拍拍身上的毛。", "en": "I brush my fur."},
        {"zh": "你也滑了一下。", "en": "You slip too."},
        {"zh": "这都是皮害的。", "en": "The peels are to blame."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我有很多皮可以分享。", "en": "I have plenty of peels to share."},
        {"zh": "我们一起吃。", "en": "We eat together."},
        {"zh": "她抢我的香蕉。", "en": "She snatches my banana."},
        {"zh": "我也抢她的。", "en": "I snatch hers too."},
        {"zh": "我们坐在树上。", "en": "We sit in a tree."},
        {"zh": "我们往下扔皮。", "en": "We throw peels down."},
        {"zh": "地上全是香蕉皮。", "en": "The ground is all peel."},
        {"zh": "我们笑得停不下来。", "en": "We cannot stop laughing."},
        {"zh": "天黑了，我们还在吃。", "en": "At dark we are still eating."},
        {"zh": "树上只剩一根了。", "en": "Only one banana is left in the tree."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抓起它，塞进腮帮。", "en": "I snatch it up and stuff it into my cheek."},
        {"zh": "我以为是一根香蕉。", "en": "I thought it was a banana."},
        {"zh": "不是，扔了。", "en": "No? Then away it goes."},
        {"zh": "我塞进嘴里。", "en": "I put it in my mouth."},
        {"zh": "咬不动。", "en": "I cannot bite it."},
        {"zh": "我拿它敲了敲树干。", "en": "I knock it against a trunk."},
        {"zh": "这个能换香蕉吗？", "en": "Can this be traded for bananas?"},
        {"zh": "我塞进腰间的皮兜。", "en": "I stuff it into my belt pouch."},
        {"zh": "掉了也别浪费。", "en": "Do not waste what falls."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你抢我的香蕉了。", "en": "You took my banana."},
        {"zh": "我龇牙了。", "en": "I bare my teeth."},
        {"zh": "我把香蕉塞进嘴里护着。", "en": "I stuff the banana in my mouth to protect it."},
        {"zh": "我拍着胸口吼。", "en": "I roar and beat my chest."},
        {"zh": "别动，我这就扑上去。", "en": "Hold still — I'm about to pounce."},
        {"zh": "这个不能忍。", "en": "This I cannot forgive."},
        {"zh": "你的气味已经在我脑子里。", "en": "Your scent is already in my head."},
        {"zh": "你不该碰它的。", "en": "You should not have touched it."},
        {"zh": "十六片西瓜，换来我这口牙。", "en": "Sixteen slices of watermelon bought me these teeth."},
        {"zh": "我的手里全是毛。", "en": "My hands are all fur."},
        {"zh": "我要咬人了。", "en": "I am going to bite."},
        {"zh": "香蕉是我的。", "en": "The banana is mine."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你，跳来跳去。", "en": "I follow you, leaping about."},
        {"zh": "我抓起一根树枝。", "en": "I grab a branch."},
        {"zh": "我在树上追你。", "en": "I chase you through the trees."},
        {"zh": "我扔了一个皮。", "en": "I throw a peel."},
        {"zh": "你踩到了。", "en": "You stepped on it."},
        {"zh": "我笑得直不起腰。", "en": "I laugh so hard I bend over."},
        {"zh": "我又扔一个。", "en": "I throw another."},
        {"zh": "你滑倒了。", "en": "You slip."},
        {"zh": "我朝你扑。", "en": "I pounce at you."},
        {"zh": "我龇着牙，一步步贴近。", "en": "I bare my teeth and close in step by step."},
        {"zh": "香蕉我留着回来吃。", "en": "I will finish the banana when I return."},
        {"zh": "你跑得挺快。", "en": "You run well."},
        {"zh": "我再追一段。", "en": "I will chase a while longer."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抓你的肩膀。", "en": "I grab your shoulder."},
        {"zh": "我用香蕉皮绊你。", "en": "I trip you with a peel."},
        {"zh": "我跳起来压你。", "en": "I leap onto you."},
        {"zh": "我挥着长臂扫你一圈。", "en": "I sweep one long arm at you."},
        {"zh": "我边打边笑。", "en": "I laugh while hitting."},
        {"zh": "你推开了我。", "en": "You shove me off."},
        {"zh": "我的爪子刮过你的肩。", "en": "My claws rake across your shoulder."},
        {"zh": "香蕉味的拳头，尝尝。", "en": "Taste a banana-flavored fist."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上掉下来，手里还抓着香蕉。", "en": "I drop from the tree with a banana in hand."},
        {"zh": "十六片西瓜换来的我。", "en": "Sixteen slices of melon bought me."},
        {"zh": "我坐在地上，先吃了一根。", "en": "I sit down and eat one first."},
        {"zh": "地上多了一层皮。", "en": "The ground gains a layer of peels."},
        {"zh": "我朝四周喊了两声。", "en": "I call out twice."},
        {"zh": "这一带开始有香蕉味。", "en": "The area starts smelling of bananas."},
        {"zh": "我找到了一根树枝。", "en": "I find a branch."},
        {"zh": "我在树枝上荡。", "en": "I swing on it."},
        {"zh": "我笑个不停。", "en": "I keep laughing."},
        {"zh": "我把皮扔向远处。", "en": "I toss a peel far off."},
        {"zh": "这里归我管了。", "en": "This place is mine now."},
        {"zh": "我从枝头落地。", "en": "I drop from the branch."},
        {"zh": "我很高兴见到你。", "en": "I am glad to see you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的毛烧焦了一块，我乱跳。", "en": "A patch of my fur burns and I hop about."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上摔下来，四脚朝天。", "en": "I fall from the tree and land on my back."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑腾着，香蕉也丢了。", "en": "I thrash and lose the banana."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀到树冠上。", "en": "The blast throws me into the canopy."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一阵光，我捂住了眼睛。", "en": "A flash of magic and I cover my eyes."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经三根没吃了。", "en": "I have gone three bananas without eating."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我毛发全立。", "en": "Lightning strikes and all my fur stands up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有树，也没有香蕉。", "en": "No trees and no bananas."}
      ]
    }
  }
}
