{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用后腿一蹬。", "en": "I push off with my hind legs."},
        {"zh": "一步能跳两格远。", "en": "One hop covers two blocks."},
        {"zh": "长尾巴拖着平衡。", "en": "My long tail balances me."},
        {"zh": "夜里的草很凉。", "en": "The night grass is cool."},
        {"zh": "我贴着地面跳。", "en": "I hop low to the ground."},
        {"zh": "前爪收在胸前。", "en": "My forepaws tuck to my chest."},
        {"zh": "我跳过一道土沟。", "en": "I leap a shallow gully."},
        {"zh": "草叶被我压弯。", "en": "The grass bends under me."},
        {"zh": "我沿着窝边转。", "en": "I circle near my burrow."},
        {"zh": "耳朵在夜里很灵。", "en": "My ears are sharp at night."},
        {"zh": "我慢慢蹦到灌木后。", "en": "I hop behind the bush."},
        {"zh": "沙土从爪间漏下。", "en": "Sand slips between my claws."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我白天躲在洞里。", "en": "I hide in my burrow by day."},
        {"zh": "太阳太亮了。", "en": "The sun is too bright."},
        {"zh": "白天轮到我睡，打个哈欠。", "en": "By day I sleep. A yawn, then."},
        {"zh": "耳朵转了半圈。", "en": "My ears rotate halfway."},
        {"zh": "我趴着不动。", "en": "I lie still."},
        {"zh": "洞里很凉快。", "en": "It's cool in the burrow."},
        {"zh": "我蹲着舔湿了前爪。", "en": "I crouch and lick my forepaws wet."},
        {"zh": "我把鼻子探出去。", "en": "I poke my nose out."},
        {"zh": "身上还有点土。", "en": "Still some soil on me."},
        {"zh": "我在等天黑下来。", "en": "I wait for the dark."},
        {"zh": "尾巴卷在身边。", "en": "My tail curls beside me."},
        {"zh": "我啃了一小口草根。", "en": "I nibble a bit of root."},
        {"zh": "这洞是我挖的。", "en": "I dug this burrow."},
        {"zh": "草的味道飘进来。", "en": "The smell of grass drifts in."},
        {"zh": "我的长耳朵转了半圈。", "en": "My long ears swing half a turn."},
        {"zh": "这白天实在太长。", "en": "The day is far too long."},
        {"zh": "我尖叫一声报信。", "en": "I screech once to warn you."},
        {"zh": "快晚上了吧。", "en": "Nearly evening, isn't it."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在洞口了。", "en": "You're standing at my burrow."},
        {"zh": "我是夜里的动物。", "en": "I'm a creature of the night."},
        {"zh": "我的后腿很有力。", "en": "My hind legs are powerful."},
        {"zh": "我的尾巴一碰就断。", "en": "My tail comes off at a touch."},
        {"zh": "你想喂我吗？", "en": "Are you going to feed me?"},
        {"zh": "这些草我能吃。", "en": "I can eat this grass."},
        {"zh": "你蹲下，我才看清你。", "en": "Crouch, and only then do I see you clearly."},
        {"zh": "我闻到你手心的味道。", "en": "I smell your palm."},
        {"zh": "你脚下有绿宝石味。", "en": "Emerald smell under your feet."},
        {"zh": "我记住你的手心。", "en": "I know your palm."},
        {"zh": "你走的时候我跟着。", "en": "I'll follow when you go."},
        {"zh": "你要在这里等吗？", "en": "Will you wait here?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "耳朵压平了。", "en": "My ears flattened."},
        {"zh": "我疼得直跳。", "en": "The pain makes me hop."},
        {"zh": "后腿还有劲。", "en": "My hind legs still work."},
        {"zh": "我咬紧牙忍住。", "en": "I grit my teeth and bear it."},
        {"zh": "我记住你的味。", "en": "I know your scent."},
        {"zh": "我躲起来了。", "en": "I'm hiding."},
        {"zh": "我蹬地一跳，把疼甩在沙土后面。", "en": "I kick off the ground and leave the pain behind in the dust."},
        {"zh": "耳朵一抖，我缩回洞里舔伤口。", "en": "Ears twitching, I shrink into my burrow to lick the wound."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是草根吗？", "en": "Is that a root?"},
        {"zh": "这一根很嫩的。", "en": "This one is quite tender."},
        {"zh": "多递几根过来。", "en": "Hand over a few more."},
        {"zh": "我闻到它的味。", "en": "I smell it."},
        {"zh": "搁在地面上就行。", "en": "On the ground is fine."},
        {"zh": "我不吃肉的。", "en": "I don't eat meat."},
        {"zh": "这草能让我长大。", "en": "This grass helps me grow."},
        {"zh": "先别把手收回去。", "en": "Don't take your hand back."},
        {"zh": "我要这一片。", "en": "I want that clump."},
        {"zh": "慢慢递过来。", "en": "Hand it over slowly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的长尾巴被压住。", "en": "My long tail is pinned."},
        {"zh": "我一弹就退开了。", "en": "One spring and I'm clear."},
        {"zh": "我弹得挺高。", "en": "I bounced up quite high."},
        {"zh": "你的靴子挡住洞。", "en": "Your boot blocks my burrow."},
        {"zh": "洞里被撞塌了一点。", "en": "Part of the burrow caved in."},
        {"zh": "我翻过身又站起来。", "en": "I rolled and got up."},
        {"zh": "土全扬起来了。", "en": "Soil went everywhere."},
        {"zh": "别推我进洞。", "en": "Don't push me into the burrow."},
        {"zh": "站稳一点走路。", "en": "Walk steady."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "夜里的草原上才谈。", "en": "We talk on the savanna at night."},
        {"zh": "先看看你的洞。", "en": "Let me see your burrow first."},
        {"zh": "我挖得比你好。", "en": "I dig better than that."},
        {"zh": "你的耳朵不够长。", "en": "Your ears aren't long enough."},
        {"zh": "你连后腿都没有。", "en": "You don't even have hind legs."},
        {"zh": "先让我啃点草根。", "en": "Let me gnaw a root first."},
        {"zh": "天亮之前我得回去。", "en": "I must be back before dawn."},
        {"zh": "慢慢跳过来就好。", "en": "Just hop over slowly."},
        {"zh": "我怕太大的动静。", "en": "Big noises frighten me."},
        {"zh": "我记下你的气味。", "en": "I've kept your scent."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块我挖出来的。", "en": "I dug this up."},
        {"zh": "有点硬，能吃吗。", "en": "It's hard. Edible?"},
        {"zh": "我刨开土看看。", "en": "I scratch the soil aside."},
        {"zh": "是块小石头。", "en": "It's a little stone."},
        {"zh": "我含着带回洞。", "en": "I'll carry it to the burrow."},
        {"zh": "这味道很奇怪。", "en": "This smells strange."},
        {"zh": "地里还有东西。", "en": "There's more in the ground."},
        {"zh": "爪子有点疼。", "en": "My claws ache."},
        {"zh": "这一个我留着。", "en": "I'll keep this one."},
        {"zh": "我挖了好久。", "en": "I dug for a long while."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "草里有响动。", "en": "Something in the grass."},
        {"zh": "草被什么东西分开。", "en": "The grass is parting."},
        {"zh": "耳朵全竖起来。", "en": "My ears are fully up."},
        {"zh": "我往洞口退。", "en": "I back toward the burrow."},
        {"zh": "我听见爪子声。", "en": "I hear claws."},
        {"zh": "天色太暗了。", "en": "It's too dark to see."},
        {"zh": "我可以一跳逃走。", "en": "One hop and I'm gone."},
        {"zh": "它挡住了路。", "en": "It's blocking the way."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它的味道还没散。", "en": "Its scent hasn't faded."},
        {"zh": "我贴着地不动。", "en": "I press flat and hold still."},
        {"zh": "草够高能藏住我。", "en": "The grass is tall enough."},
        {"zh": "洞口就在后面。", "en": "The burrow is right behind me."},
        {"zh": "它的鼻子在嗅。", "en": "Its nose is working."},
        {"zh": "等它走远些。", "en": "Wait till it's farther."},
        {"zh": "它朝洞口看了。", "en": "It looked at my burrow."},
        {"zh": "我一点点地挪。", "en": "I shift a little at a time."},
        {"zh": "差不多安全了。", "en": "Nearly safe."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用后腿蹬它。", "en": "I kick with my hind legs."},
        {"zh": "前爪抓一下。", "en": "A swipe of my forepaw."},
        {"zh": "咬它的手指。", "en": "I nip its fingers."},
        {"zh": "我吓得乱跳。", "en": "I jump about in panic."},
        {"zh": "我后腿一蹬，能跳得很高。", "en": "One kick of my hind legs carries me high."},
        {"zh": "我要跑走了。", "en": "I'm running."},
        {"zh": "你快放开我。", "en": "Let go of me now."},
        {"zh": "一弹，两弹，远了。", "en": "Bounce, bounce, gone."},
        {"zh": "洞里最安全。", "en": "The burrow is safest."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草原上多了一个小影子。", "en": "A small shadow on the savanna."},
        {"zh": "我从洞里探头。", "en": "I poke out of the burrow."},
        {"zh": "太阳刚下去。", "en": "The sun just went down."},
        {"zh": "土还挂在毛上。", "en": "Soil clings to my fur."},
        {"zh": "草原上，我先伸了个懒腰。", "en": "On the savanna, I stretch first."},
        {"zh": "夜风很舒服。", "en": "The night wind feels good."},
        {"zh": "我跳到草边。", "en": "I hop to the grass edge."},
        {"zh": "这里草很多。", "en": "Plenty of grass here."},
        {"zh": "洞里爬出来，先刨草根。", "en": "Out of the burrow, I dig for grass roots."},
        {"zh": "风声盖住了我的脚步。", "en": "The wind hides my steps."},
        {"zh": "远处有火光。", "en": "Firelight in the distance."},
        {"zh": "我慢慢蹦出来。", "en": "I hop out slowly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛被燎焦了。", "en": "My fur singed."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时后腿撞疼。", "en": "My hind leg jarred on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过了我的耳朵。", "en": "Water closed over my ears."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "土全塌下来。", "en": "The soil caved in."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "后腿被扎了一下。", "en": "Something pierced my hind leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我毛都竖起。", "en": "The light raised my fur."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得跳不动。", "en": "Too hungry to hop."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在草原上。", "en": "The bolt struck the savanna."}
      ]
    }
  }
}
