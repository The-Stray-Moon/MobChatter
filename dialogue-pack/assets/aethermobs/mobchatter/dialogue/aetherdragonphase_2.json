{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "第二阶段，鳞片全竖起来了。", "en": "Second phase. Every scale stands up."},
        {"zh": "翼下阴影掠过地面。", "en": "Shadows slip beneath the ground."},
        {"zh": "尾鞭般扫过，发出沉闷声。", "en": "Tail whips, rumbles."},
        {"zh": "锋利爪子掠过岩石。", "en": "Sharp claws scrape stone."},
        {"zh": "炽热火焰在尾端聚集。", "en": "Fiery flames coalesce at tail."},
        {"zh": "尾鳍拍击水面，波纹荡开。", "en": "Tailfin slaps water, ripples spread."},
        {"zh": "翅膀扇动，带起阵阵热风。", "en": "Wings beat, hot winds stirred."},
        {"zh": "身躯扭曲，发出低吼。", "en": "Body twists, low growl."},
        {"zh": "鳞片闪烁着微光。", "en": "Scales glimmer."},
        {"zh": "眼睛反射出光芒。", "en": "Eyes reflect light."},
        {"zh": "第二形态的翅膀更宽了。", "en": "In my second phase, my wings are wider."},
        {"zh": "金黄的以太尘随我而落。", "en": "Golden aether dust falls as I pass."},
        {"zh": "我踩过迷宫的石砖。", "en": "I tread the dungeon's stone bricks."},
        {"zh": "鳞下水晶互相磕碰作响。", "en": "Crystals under my scales clack as I move."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "凝视远方，目光锐利。", "en": "Stares distant, eyes sharp."},
        {"zh": "缓缓转动，观察四周。", "en": "Slowly turns, scans."},
        {"zh": "低头，寻找潜在猎物。", "en": "Crouches, seeks prey."},
        {"zh": "张开巨颚，发出低鸣。", "en": "Opens jaw, growls."},
        {"zh": "双翼轻微振动，保持平衡。", "en": "Wings vibrate, maintain."},
        {"zh": "张开长翼，遮住阳光。", "en": "Opens long wings, blocks sunlight."},
        {"zh": "目光追随，紧盯着目标。", "en": "Eyes follow, lock on."},
        {"zh": "轻抚鳞片，发出轻响。", "en": "Runs scales, light sound."},
        {"zh": "目光如炬，散发寒意。", "en": "Eyes like torches, chill."},
        {"zh": "偶尔喷出蒸汽，冷却。", "en": "Occasionally spits steam, cools."},
        {"zh": "我伏在迷宫的祭坛上。", "en": "I crouch on the dungeon altar."},
        {"zh": "以太结晶的光照进我眼里。", "en": "Aether crystal light fills my eyes."},
        {"zh": "伤口正一块块长出晶壳。", "en": "Crystal shell grows over my wounds."},
        {"zh": "呼吸间吐出细碎的金光。", "en": "With each breath I exhale flecks of gold."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "第一阶段只是热身。", "en": "The first phase was a warm-up."},
        {"zh": "紧盯着玩家，毫不动摇。", "en": "Locked on player, unwavering."},
        {"zh": "目光闪烁，追踪玩家。", "en": "Eyes blink, track player."},
        {"zh": "目光闪烁，锁定玩家。", "en": "Eyes blink, lock on player."},
        {"zh": "我换了形态，眼睛更亮了。", "en": "I've changed form, and my eyes burn brighter."},
        {"zh": "紧盯着玩家，准备攻击。", "en": "Locked on player, ready to attack."},
        {"zh": "目光如电，盯着玩家。", "en": "Eyes like lightning, stare player."},
        {"zh": "目光如炬，审视玩家。", "en": "Eyes like torches, appraise player."},
        {"zh": "目光如炬，寻找弱点。", "en": "Eyes like torches, seek weak spot."},
        {"zh": "又一位闯入者站在我面前。", "en": "Another intruder stands before me."},
        {"zh": "你的护甲反射着以太光。", "en": "Your armor reflects aether light."},
        {"zh": "第二阶段，你还没见识过。", "en": "You have not seen my second phase."},
        {"zh": "你的弓弦声，我听得清楚。", "en": "I hear your bowstring clearly."},
        {"zh": "迷宫的墙记住了你的味道。", "en": "The maze walls remember your scent."},
        {"zh": "我盘旋着，尾巴扫过水晶塔尖。", "en": "I circle, tail sweeping past the crystal spire."},
        {"zh": "以太的裂缝在我身上合拢。", "en": "Aether fissures close across my flesh."},
        {"zh": "你也想要我的水晶？", "en": "You want my crystals too?"},
        {"zh": "你的同伴在门外等着吧。", "en": "Your companions wait outside the door."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翼骨折了，疼痛难忍！", "en": "My wing is broken, agony!"},
        {"zh": "我的鳞片被撕裂了！", "en": "My scales are torn!"},
        {"zh": "这伤害太痛了！", "en": "That hurts!"},
        {"zh": "我受了重伤！", "en": "I’m severely injured!"},
        {"zh": "受伤了，快帮我！", "en": "Injured, help me!"},
        {"zh": "我的身体疼痛不已！", "en": "My body aches!"},
        {"zh": "我受了点伤。", "en": "I’m wounded."},
        {"zh": "我受伤了，好痛！", "en": "I’m hurt, it hurts!"},
        {"zh": "受点伤而已。", "en": "Just a scratch."},
        {"zh": "疼痛难忍，我受伤了！", "en": "I’m in agony, I’m hurt!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你的光芒无法迷惑我！", "en": "Your light cannot deceive me!"},
        {"zh": "腐烂的肉块不是我的食物！", "en": "Decaying flesh is not my sustenance!"},
        {"zh": "远离这里，否则你会后悔！", "en": "Stay away or you’ll rue it!"},
        {"zh": "你手里那点吃的，我不屑一顾。", "en": "That scrap in your hand, I won't even look at it."},
        {"zh": "不要靠近，这只会激怒我。", "en": "Do not approach, for it only incites me."},
        {"zh": "我的鳞片反射你的光芒。", "en": "My scales reflect your light."},
        {"zh": "你那微不足道的攻击对我来说无用。", "en": "Your feeble attack is of no consequence to me."},
        {"zh": "我的声音比你的火焰更响亮。", "en": "My voice resonates louder than your flames."},
        {"zh": "以太龙换了第二张脸，接好。", "en": "The Aetherdragon wears a second face now."},
        {"zh": "我会吞噬你的灵魂。", "en": "I will consume your soul."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "岩石阻挡不了我的力量！", "en": "Rock cannot stop my might!"},
        {"zh": "你的力量太微不足道。", "en": "Your strength is meager."},
        {"zh": "撞击只会让我更强。", "en": "Impact only strengthens me."},
        {"zh": "岩石碎片无法伤害我。", "en": "Rock shards cannot wound me."},
        {"zh": "用你最大的力气来试试吧。", "en": "Try your mightiest."},
        {"zh": "我的鳞片坚硬如铁。", "en": "My scales are steel."},
        {"zh": "你的攻击只会让我更快。", "en": "Your attacks only make me faster."},
        {"zh": "撞击只能加速我的毁灭。", "en": "Impact only hastens my destruction."},
        {"zh": "岩石无法限制我的行动。", "en": "Rock cannot constrain my movements."},
        {"zh": "我能穿透任何物质。", "en": "I can penetrate any substance."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "第二形态才刚开始。", "en": "My second form has only begun."},
        {"zh": "我是孤独的守护者。", "en": "I am the solitary guardian."},
        {"zh": "寻找我的同类是不可能的。", "en": "Finding my kind is impossible."},
        {"zh": "我将独自繁衍。", "en": "I will propagate alone."},
        {"zh": "我的后代将继承我的力量。", "en": "My offspring will inherit my strength."},
        {"zh": "我的同类永远不会再次出现。", "en": "My kind will never return."},
        {"zh": "我将永远孤独。", "en": "I will be alone forever."},
        {"zh": "我的同类已经消逝了。", "en": "My kind has vanished."},
        {"zh": "我是最后的以太龙。", "en": "I am the last Aetherdragon."},
        {"zh": "我的存在就是为了守护。", "en": "My existence is to protect."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "鳞片闪耀，气息致命！", "en": "Scales shine, deadly aura."},
        {"zh": "以太之力，吞噬灵魂！", "en": "Aether power, soul devouring."},
        {"zh": "触碰即死，远离我！", "en": "Touch and die, stay away!"},
        {"zh": "虚空之翼，遮天蔽日！", "en": "Void wings, darkening skies."},
        {"zh": "光与暗的平衡，破碎吧！", "en": "Balance of light and dark, break!"},
        {"zh": "腐蚀一切，化为虚无！", "en": "Corrode all, into nothing."},
        {"zh": "吞噬你的意志，臣服！", "en": "Devour your will, submit."},
        {"zh": "漆黑的深渊，吞噬一切！", "en": "Ink abyss, devour all."},
        {"zh": "深渊召唤，你逃不掉！", "en": "Abyss call, you can't escape."},
        {"zh": "吞噬者，我的仆人！", "en": "Consumers, my servants!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "感知你的恐惧，吞噬！", "en": "Sense your fear, devour."},
        {"zh": "锁定了目标，准备攻击！", "en": "Target locked, attack ready."},
        {"zh": "吞噬者，你的时代已到！", "en": "Consumers, your time comes."},
        {"zh": "恐惧之中，你将消亡！", "en": "In fear, you'll vanish."},
        {"zh": "吞噬你的灵魂，永不复生！", "en": "Soul devoured, never again."},
        {"zh": "吞噬一切，你亦难逃！", "en": "Devour all, you too escape."},
        {"zh": "恐惧我的存在，颤抖！", "en": "Fear me, tremble."},
        {"zh": "吞噬你的光芒，化为虚无！", "en": "Devour your light, into nothing."},
        {"zh": "恐惧与绝望，吞噬吧！", "en": "Fear and despair, devour."},
        {"zh": "吞噬一切，化为虚无！", "en": "Devour all, into nothing!"},
        {"zh": "迷宫把你送到我面前。", "en": "The maze delivered you to me."},
        {"zh": "你踩响的砖告诉了我位置。", "en": "The brick you stepped on told me where you are."},
        {"zh": "你身上以太的味道很新。", "en": "The aether on you smells fresh."},
        {"zh": "这次不会再让你打断我。", "en": "This time I will not let you interrupt me."},
        {"zh": "第一阶段的账，现在算。", "en": "Now we settle the first phase's score."},
        {"zh": "你退到墙角了。", "en": "You have backed into the corner."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "锁定目标，准备吞噬！", "en": "Target locked, devour."},
        {"zh": "恐惧者，你的时刻到了！", "en": "Fearers, your time comes."},
        {"zh": "恐惧之中，你将毁灭！", "en": "Fear, you'll be destroyed."},
        {"zh": "恐惧我的力量，颤抖！", "en": "Fear my power, tremble."},
        {"zh": "吞噬你的生命，化为虚无！", "en": "Devour your life, into nothing."},
        {"zh": "恐惧之中的你，将被吞噬！", "en": "Fear, you'll be devoured."},
        {"zh": "恐惧的代价，吞噬！", "en": "Fear's price, devour."},
        {"zh": "吞噬你的意志，臣服", "en": "Devour your will, submit"},
        {"zh": "恐惧与黑暗，吞噬吧！", "en": "Fear and darkness, devour."},
        {"zh": "吞噬一切，化为虚无", "en": "Devour all, into nothing!"},
        {"zh": "翅膀一张，退路就没了。", "en": "My wings open and your retreat is gone."},
        {"zh": "我看准了你护甲的接缝。", "en": "I have found the seam in your armor."},
        {"zh": "你举盾，我就换一边。", "en": "Raise your shield; I strike the other side."},
        {"zh": "以太的呼啸会盖住你的喊声。", "en": "The aether's roar will drown your shout."},
        {"zh": "我等你把箭射完。", "en": "I wait until your arrows run out."},
        {"zh": "你身后的迷宫只会更深。", "en": "The maze behind you only goes deeper."},
        {"zh": "换形之后，我的俯冲更快了。", "en": "After the change, my dive is faster."},
        {"zh": "第二阶段的我，不急着动手。", "en": "In my second phase, I am in no hurry."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，锋利利爪抓你！", "en": "Sssss, sharp claws grab you!"},
        {"zh": "火焰撕裂，你无法逃脱！", "en": "Flames tear, you can't escape!"},
        {"zh": "龙翼拍打，撞击地面！", "en": "Dragon wings beat, ground collision!"},
        {"zh": "尾巴甩击，震动四起！", "en": "Tail whips, tremors arise!"},
        {"zh": "咆哮震耳，你颤抖不已！", "en": "Roar deafening, you shudder!"},
        {"zh": "巨颚咬合，撕碎骨头！", "en": "Mega jaws bite, crush bones!"},
        {"zh": "黑暗能量，吞噬一切！", "en": "Dark energy, devour all!"},
        {"zh": "火焰喷吐，灼烧灵魂！", "en": "Flame spout, sear souls!"},
        {"zh": "虚空锁链，束缚敌人！", "en": "Void chains, bind foes!"},
        {"zh": "深渊怒吼，恐惧蔓延！", "en": "Deep roar, fear spreads!"},
        {"zh": "翼骨扫过，把你掀翻。", "en": "My wing bone sweeps you off your feet."},
        {"zh": "水晶碎片飞进你的甲片。", "en": "Crystal shards slip into your armor."},
        {"zh": "我一口咬住你的盾沿。", "en": "I bite down on your shield's rim."},
        {"zh": "以太之火不烫，只蚀骨。", "en": "Aether fire does not burn; it eats bone."},
        {"zh": "尾尖抽在你胸口。", "en": "My tail tip cracks against your chest."},
        {"zh": "你被自己的血滑倒了。", "en": "You slip on your own blood."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗裂缝，我现身于此！", "en": "Dark rift, I appear here!"},
        {"zh": "黑暗能量汇聚，我诞生！", "en": "Dark energy converges, I'm born!"},
        {"zh": "虚空之中，我永恒存在！", "en": "In the void, I endure!"},
        {"zh": "黑暗之心，我栖息于此！", "en": "Dark heart, I dwell here!"},
        {"zh": "深渊深处，我苏醒过来！", "en": "Deep abyss, I awaken!"},
        {"zh": "黑暗森林，我守护其中！", "en": "Dark forest, I guard it!"},
        {"zh": "荒芜之地，我隐匿于此！", "en": "Wasteland, I hide here!"},
        {"zh": "黑暗之界，我现身于此！", "en": "Dark realm, I appear here!"},
        {"zh": "黑暗裂缝，我降临时来！", "en": "Dark rift, I descend here!"},
        {"zh": "虚空裂隙，我从此诞生！", "en": "Void fissure, I'm born here!"},
        {"zh": "迷宫最深处，我再次成形。", "en": "In the maze's depth I take shape again."},
        {"zh": "以太之光把我从残骸里拉起。", "en": "Aether light lifts me from my remains."},
        {"zh": "第一阶段倒下，我便站起。", "en": "The first phase fell, so I rose."},
        {"zh": "水晶震颤，我随之苏醒。", "en": "The crystals shudder and I wake."},
        {"zh": "你听见的第二次咆哮是我。", "en": "The second roar you hear is mine."},
        {"zh": "我从碎鳞里重塑身体。", "en": "I rebuild myself from shattered scales."},
        {"zh": "祭坛的光柱里，我睁开眼。", "en": "In the altar's light I open my eyes."},
        {"zh": "以太之风送来我的形体。", "en": "The aether wind delivers my form."}
      ]
    },
