        {"zh": "一钳落下，地面裂开。", "en": "One blow and the floor cracks."},
        {"zh": "我把你扫向盐壁。", "en": "I sweep you into the salt wall."},
        {"zh": "重击之后，我慢慢收钳。", "en": "After the heavy blow, I draw my claw back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "盐地牢的深处召唤我！", "en": "Summoned from the deep salt dungeon!"},
        {"zh": "盐柱裂开，我从缝里挤出来。", "en": "The salt pillar splits, and I squeeze out."},
        {"zh": "从岩缝中钻出！", "en": "Crawling out from the cracks!"},
        {"zh": "地牢入口涌出！", "en": "Spewing out from the dungeon entrance!"},
        {"zh": "在岩壁中现身！", "en": "Appearing from the rock walls!"},
        {"zh": "从盐矿中爬出！", "en": "Crawling out from the salt mine!"},
        {"zh": "从岩层中裂开！", "en": "Splitting open from the rock layers!"},
        {"zh": "从地底深处冒出来！", "en": "Emerging from the depths below!"},
        {"zh": "从岩洞中钻出！", "en": "Drilling out from the cave!"},
        {"zh": "在盐地牢中召唤！", "en": "Summoned in the salt dungeon!"},
        {"zh": "盐之王从地牢醒来。", "en": "The salt king wakes in his dungeon."},
        {"zh": "我踏碎了盐柱。", "en": "I shatter a salt pillar as I rise."},
        {"zh": "盐风先到，我随后。", "en": "The salt wind comes first. Then me."},
        {"zh": "我的王座就在盐层下。", "en": "My throne lies beneath the salt layer."},
        {"zh": "潮声停了，盐蟹王现身。", "en": "The tide falls silent. The salt crab king appears."},
        {"zh": "我从盐壳里破出来。", "en": "I break out through the salt crust."},
        {"zh": "整座地牢都在颤动。", "en": "The whole dungeon trembles."},
        {"zh": "盐晶亮了，我在此。", "en": "The salt crystals glow. I am here."},
        {"zh": "我的王冠由盐晶铸成。", "en": "My crown is cast from salt crystal."},
        {"zh": "深层的守卫，醒了。", "en": "The deep warden has woken."}
      ]
    },
