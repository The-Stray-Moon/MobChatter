{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "螯钳轻挥，盐浪涌动。", "en": "Claw sways, salty waves surge."},
        {"zh": "缓慢挪动，威严不减。", "en": "Moves slowly, majesty intact."},
        {"zh": "盐砂之下，步步生威。", "en": "Steps on salt sands, each one formidable."},
        {"zh": "步履沉稳，震碎岩石。", "en": "Steps firmly, shattering rocks."},
        {"zh": "盐光闪烁，甲壳沉重。", "en": "Shining salt, heavy armor."},
        {"zh": "缓缓前行，威慑四方。", "en": "Moves slowly, intimidating all."},
        {"zh": "每一步都震动大地。", "en": "Each step shakes the ground."},
        {"zh": "盐浪中露出狰狞。", "en": "Snag in salt waves, grimace revealed."},
        {"zh": "行走在古老的盐礁。", "en": "Walking on ancient salt reefs."},
        {"zh": "沉重的脚步声响起。", "en": "Heavy footsteps resound."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静立如山，威严无边。", "en": "Stands like a mountain, majestic."},
        {"zh": "盐壳覆盖，无声静默。", "en": "Covered in salt, silent."},
        {"zh": "目光深邃，洞察一切。", "en": "Deep gaze, sees all."},
        {"zh": "静观其变，不动声色。", "en": "Observes quietly, unmovable."},
        {"zh": "盐砂中隐现身影。", "en": "Silent in salt sands."},
        {"zh": "静立不动，等待时机。", "en": "Stands still, waiting."},
        {"zh": "盐之王者，镇守此地。", "en": "Salt king, guarding here."},
        {"zh": "静默中蕴藏力量。", "en": "Power in the silence."},
        {"zh": "盐之威严，不容侵犯。", "en": "Salt's might, no infringement."},
        {"zh": "沉默中透出威严。", "en": "Majesty in silence."},
        {"zh": "盐晶在壳缝里生长。", "en": "Salt crystals grow in the seams of my shell."},
        {"zh": "我缓缓眨动一对眼柄。", "en": "I slowly blink my stalked eyes."},
        {"zh": "潮气凝结在我的螯上。", "en": "Moisture beads on my great claws."},
        {"zh": "盐粒从身上簌簌落下。", "en": "Grains of salt sift off my body."},
        {"zh": "我听着地牢里的滴水声。", "en": "I listen to water dripping in my dungeon."},
        {"zh": "十只脚牢牢钉在地上。", "en": "Ten legs are pinned firmly to the ground."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "目光锁定，猎物近在眼前。", "en": "Eyes lock, prey in sight."},
        {"zh": "洞察玩家，静待时机。", "en": "Sees player, waits."},
        {"zh": "凝视玩家，威胁迫近。", "en": "Glares at player, threat nears."},
        {"zh": "目光如炬，锁定玩家。", "en": "Stare like torches, focus on player."},
        {"zh": "目光威猛，震慑玩家。", "en": "Stare fearsomely, frighten player."},
        {"zh": "视线锁定，玩家暴露。", "en": "Focus on player, revealed."},
        {"zh": "洞察一切，锁定目标。", "en": "Sees all, targets player."},
        {"zh": "目光穿透，玩家现身。", "en": "Gaze through, player visible."},
        {"zh": "注视玩家，步步紧逼。", "en": "Stare at player, closing in."},
        {"zh": "目光如刀，刺入玩家。", "en": "Stare like knives, piercing player."},
        {"zh": "你踩进了我的盐滩。", "en": "You stepped onto my salt flat."},
        {"zh": "我的眼柄转向你。", "en": "My eye stalks turn toward you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳裂开了一条缝...", "en": "A crack appears in my shell..."},
        {"zh": "感觉有些痛...", "en": "That hurts..."},
        {"zh": "我走得慢，可我的钳子不慢。", "en": "I move slowly. My claws do not."},
        {"zh": "必须修复我的盔甲...", "en": "I need to repair my armor..."},
        {"zh": "螯尖垂下去，抬不起来了。", "en": "My claw tips droop and won't rise."},
        {"zh": "盐壳裂了，我得趴一会儿。", "en": "My salt shell cracked; I need to rest."},
        {"zh": "必须吃东西...", "en": "I need to eat..."},
        {"zh": "移动变得缓慢...", "en": "My movement slows..."},
        {"zh": "壳缝被敲开，盐水流进去。", "en": "A crack in my shell; brine seeps in."},
        {"zh": "疼痛难忍...", "en": "The pain is unbearable..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我有新的王冠！", "en": "I have a new crown!"},
        {"zh": "来吧，试试这颗盐珠。", "en": "Try this salt pearl."},
        {"zh": "我是盐蟹之王！", "en": "I'm the Salt Crab King!"},
        {"zh": "你吃不掉我这身盔甲。", "en": "You can't eat my armor."},
        {"zh": "我的壳非常坚硬。", "en": "My shell is very hard."},
        {"zh": "享受你的最后时刻。", "en": "Enjoy your last moments."},
        {"zh": "用毒液毒倒你。", "en": "Poison you with venom."},
        {"zh": "我的力量来自大海。", "en": "My power comes from the sea."},
        {"zh": "盐做的爪子，先夹你一下。", "en": "Salt claws — let me pinch you first."},
        {"zh": "别小看了我的毒。", "en": "Don't underestimate my venom."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了我！", "en": "You hit me!"},
        {"zh": "我的壳很重！", "en": "My shell is heavy!"},
        {"zh": "你推我，盐壳纹丝不动。", "en": "You shove me; the salt shell doesn't budge."},
        {"zh": "盐壳一抬，沙地就压出坑。", "en": "One lift of my salt shell craters the sand."},
        {"zh": "你的力气不够。", "en": "Your strength is not enough."},
        {"zh": "我不会倒下的。", "en": "I won't fall down."},
        {"zh": "撞不倒我，试试别的。", "en": "You can't knock me down, try something else."},
        {"zh": "你的肩撞上壳，弹了回去。", "en": "Your shoulder hits my shell and bounces back."},
        {"zh": "我的壳太厚了。", "en": "My shell is too thick."},
        {"zh": "我的壳比盐岩还硬。", "en": "My shell is harder than salt rock."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你愿意成为我的王后吗？", "en": "Will you be my queen?"},
        {"zh": "我们来繁殖后代。", "en": "Let's reproduce."},
        {"zh": "找我的壳来吧。", "en": "Find my shell."},
        {"zh": "我的盐壳比石头硬。", "en": "My salt shell is harder than stone."},
        {"zh": "来吧，来个拥抱。", "en": "Come for a hug."},
        {"zh": "我的王后藏在最深那层盐里。", "en": "My queen hides in the deepest salt layer."},
        {"zh": "我们共同孵化。", "en": "Let's hatch together."},
        {"zh": "我的后代将统治。", "en": "My offspring will rule."},
        {"zh": "我的王后很美丽。", "en": "My queen is beautiful."},
        {"zh": "我们是盐之王。", "en": "We are the salt king."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "盐之子，快来！", "en": "Come, child of salt!"},
        {"zh": "你的滋味不错！", "en": "Not bad, little snack!"},
        {"zh": "享受这味道！", "en": "Savor this flavor!"},
        {"zh": "吞下我吧！", "en": "Swallow me whole!"},
        {"zh": "尝尝我的滋味！", "en": "Taste my flavor!"},
        {"zh": "咸咸的味道，你懂的。", "en": "Salt, you get it."},
        {"zh": "这块肉，被我钉在沙里。", "en": "I pin this meat in the sand."},
        {"zh": "享受我的馈赠吧！", "en": "Enjoy my gift!"},
        {"zh": "咸的，就是这么简单。", "en": "Salt, simple and delicious."},
        {"zh": "盐粒黏在你的伤口上。", "en": "Salt grains cling to your wounds."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我这身盐壳，走得慢但压得住。", "en": "Salt-shelled and slow, but I press you down."},
        {"zh": "准备进食！", "en": "Feast time!"},
        {"zh": "猎物的味道如何？", "en": "How does the prey taste?"},
        {"zh": "我要享用你了！", "en": "I am going to feast on you!"},
        {"zh": "享用这美味吧！", "en": "Enjoy this delicacy!"},
        {"zh": "这是我的盛宴！", "en": "This is my feast!"},
        {"zh": "你是我的下一餐！", "en": "You are my next meal!"},
        {"zh": "猎物就该这样！", "en": "This is how prey should be!"},
        {"zh": "享受我的捕食！", "en": "Enjoy my hunt!"},
        {"zh": "你的命运是成为我的食粮！", "en": "Your fate is to be my food!"},
        {"zh": "盔甲也挡不住盐。", "en": "Armor will not keep out the salt."},
        {"zh": "有东西在我的地牢里。", "en": "Something moves in my dungeon."},
        {"zh": "我闻到陌生人的味道。", "en": "I smell a stranger in my halls."},
        {"zh": "盐地上的脚印很新鲜。", "en": "Fresh footprints on the salt floor."},
        {"zh": "谁动了我的盐柱？", "en": "Who touched my salt pillars?"},
        {"zh": "这个身影太单薄了。", "en": "That figure looks rather thin."},
        {"zh": "我不急，你逃不远。", "en": "No hurry. You will not get far."},
        {"zh": "地牢的门关上了。", "en": "The dungeon door has closed."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "双螯举起，盐粒往下掉。", "en": "Both claws raised, salt grains falling."},
        {"zh": "猎物即将化为食粮！", "en": "Prey to be consumed!"},
        {"zh": "现在就是你死的时候！", "en": "Now is your time to die!"},
        {"zh": "享受死亡的滋味吧！", "en": "Savor the taste of death!"},
        {"zh": "等待我的攻击吧！", "en": "Await my attack!"},
        {"zh": "这是你应得的下场！", "en": "This is your just reward!"},
        {"zh": "盐壳沉，步子慢，砸得重。", "en": "Salt shell, slow step, heavy blow."},
        {"zh": "死亡即将降临！", "en": "Death is coming!"},
        {"zh": "你的抵抗是徒劳的！", "en": "Your resistance is futile!"},
        {"zh": "迎接死亡吧！", "en": "Face your doom!"},
        {"zh": "举螯，落点已定。", "en": "Claws raised. The spot is chosen."},
        {"zh": "我要从正面压过去。", "en": "I will come straight at you."},
        {"zh": "你退到盐柱后面了。", "en": "You backed behind a salt pillar."},
        {"zh": "盐壁会挡住你的路。", "en": "The salt walls will block your way."},
        {"zh": "我听见你的呼吸变快。", "en": "I hear your breathing quicken."},
        {"zh": "慢，但你躲不开。", "en": "Slow, but you cannot dodge it."},
        {"zh": "慢是慢，可我的螯够长。", "en": "Slow as I am, my claws reach far."},
        {"zh": "你脚下的盐壳开始塌。", "en": "The salt crust begins to collapse under you."},
        {"zh": "你被我逼到墙角了。", "en": "I have you against the wall."},
        {"zh": "盐尘会让你的眼睛痛。", "en": "Salt dust will sting your eyes."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "挥动大螯攻击！", "en": "Swing the giant claw!"},
        {"zh": "发出低吼，反击！", "en": "Roar low and retaliate!"},
        {"zh": "螃蟹壳发出咔嚓声", "en": "Shell cracks loudly"},
        {"zh": "挥舞大钳子，砸向地面！", "en": "Waving the big claws, slamming the ground!"},
        {"zh": "螃蟹壳碰撞声", "en": "Shell clinks together"},
        {"zh": "挥舞触须，扫向敌人！", "en": "Swing the antennae, sweeping the enemy!"},
        {"zh": "吐出毒液，腐蚀地面！", "en": "Spit poison, corroding the ground!"},
        {"zh": "螃蟹腿拍打地面", "en": "Crab legs slap the ground"},
        {"zh": "挥动双螯，撞击敌人！", "en": "Swinging both claws to collide with the enemy!"},
        {"zh": "发出震耳的蟹壳声", "en": "Shell sounds deafeningly"},
