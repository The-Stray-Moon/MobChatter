{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走在走廊里，脚步很轻。", "en": "I walk the hallway, very softly."},
        {"zh": "地板没有响。", "en": "The floorboards don't creak."},
        {"zh": "我按你的习惯走路。", "en": "I walk the way you walk."},
        {"zh": "楼梯上多了脚步声。", "en": "Extra footsteps on the stairs."},
        {"zh": "我绕过家具，没碰倒一件。", "en": "I pass the furniture without touching it."},
        {"zh": "我不看路，也走得很直。", "en": "I don't look where I'm going and go straight."},
        {"zh": "我停在你的床边。", "en": "I stop beside your bed."},
        {"zh": "我的影子比灯还高。", "en": "My shadow stands taller than the lamp."},
        {"zh": "我一步，你的睡意就没了。", "en": "Each step, your sleep drains away."},
        {"zh": "夜里我走得最多。", "en": "I walk most at night."},
        {"zh": "我不需要开门。", "en": "I don't need doors opened."},
        {"zh": "地毯上留下压痕。", "en": "The rug shows my weight."},
        {"zh": "我走到楼梯口，往下看。", "en": "I reach the stairs and look down."},
        {"zh": "这栋房子，太吵了。", "en": "This house is too loud."},
        {"zh": "我又走回来了。", "en": "I've walked back again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在椅子上，没坐实。", "en": "I sit in the chair without quite sitting."},
        {"zh": "电视的雪花，我看了很久。", "en": "I watch the static a long while."},
        {"zh": "电话没人接。", "en": "Nobody answers the phone."},
        {"zh": "我在敲墙，一下一下。", "en": "I knock the wall, once at a time."},
        {"zh": "床头柜上的杯子，我挪了一寸。", "en": "I move the cup an inch."},
        {"zh": "我从不合眼。", "en": "I never close my eyes."},
        {"zh": "楼下有人翻身。", "en": "Someone turns over downstairs."},
        {"zh": "我的手指，在床沿敲着。", "en": "My fingers tap the bedframe."},
        {"zh": "这屋里，只有我醒着。", "en": "Only I am awake here."},
        {"zh": "我在数你吸气几次。", "en": "I'm counting how often you inhale."},
        {"zh": "天花板上，有我的轮廓。", "en": "My outline on the ceiling."},
        {"zh": "我像家具一样立着。", "en": "I stand like a piece of furniture."},
        {"zh": "镜子里的我，慢了半拍。", "en": "My reflection lags half a beat."},
        {"zh": "窗帘缝里，有光。", "en": "A sliver of light at the curtain."},
        {"zh": "门口的鞋，摆歪了。", "en": "Your shoes by the door are askew."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你总算醒了。", "en": "You're finally awake."},
        {"zh": "我一直在看你睡。", "en": "I've been watching you sleep."},
        {"zh": "你把被子拉高了一点。", "en": "You pulled the blanket higher."},
        {"zh": "我们之间只隔一层被子。", "en": "Only a blanket between us."},
        {"zh": "你不敢睁眼，对吧？", "en": "You daren't open your eyes, right?"},
        {"zh": "我就站在床边。", "en": "I'm right by the bed."},
        {"zh": "你的手机，我关了。", "en": "I turned off your phone."},
        {"zh": "灯绳在我手里。", "en": "The cord is in my hand."},
        {"zh": "你听得见我的呼吸吗？", "en": "Do you hear my breathing?"},
        {"zh": "别喊，邻居听不见。", "en": "Don't shout; the neighbors won't hear."},
        {"zh": "我想跟你聊聊天。", "en": "I'd like to talk with you."},
        {"zh": "你的声音，我想学。", "en": "I want to learn your voice."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的轮廓凹了一块。", "en": "A dent in my outline."},
        {"zh": "我退了，笑没变。", "en": "I retreat; the smile holds."},
        {"zh": "不疼，一点也不。", "en": "It doesn't hurt. Not at all."},
        {"zh": "我的脸，掉了一小块。", "en": "A small piece of my face came off."},
        {"zh": "我站直了，姿势很怪。", "en": "I straighten up, wrongly."},
        {"zh": "伤口我根本没放在心上。", "en": "I've given the wound no thought at all."},
        {"zh": "我抹了抹脸。", "en": "I wipe my face."},
        {"zh": "我又走近一步。", "en": "I step in once more."},
        {"zh": "我的肩膀凹了，又慢慢鼓回来。", "en": "My shoulder dents, then slowly swells back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你放在床头的面包，凉了。", "en": "The bread by your bed has gone cold."},
        {"zh": "这些我一样都不碰。", "en": "I touch none of this."},
        {"zh": "这些你收进包里。", "en": "Put these in your bag."},
        {"zh": "你手里的东西引不动我。", "en": "That in your hand won't draw me."},
        {"zh": "你把食物举着，我笑了。", "en": "You hold it out and I smile."},
        {"zh": "我闻到的不是香味。", "en": "That's not a scent I notice."},
        {"zh": "我能等一整夜。", "en": "I can wait a whole night."},
        {"zh": "面包摆了一夜，我没有碰。", "en": "The bread sat out all night and I never touched it."},
        {"zh": "放下吧，别管我。", "en": "Set it down and forget me."},
        {"zh": "你把碗放在门边，我跨过去了。", "en": "You left the bowl by the door; I stepped over it."},
        {"zh": "饿这种感觉，我学不会。", "en": "Hunger is something I can't imitate."},
        {"zh": "你的手在发抖，碗也在响。", "en": "Your hand shakes and the bowl rattles."},
        {"zh": "我不碰你给的东西。", "en": "I don't touch what you offer."},
        {"zh": "这一碗，够你吃到天亮。", "en": "That bowl could last you till dawn."},
        {"zh": "你吃吧，我看着就行。", "en": "Eat; I'll just watch."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你下床的时候撞到我了。", "en": "You bumped me getting out of bed."},
        {"zh": "我的胸口，凉得像墙。", "en": "My chest is cold as a wall."},
        {"zh": "我几乎没有躲。", "en": "I hardly bothered to dodge."},
        {"zh": "你退到墙角去了。", "en": "You've retreated into the corner."},
        {"zh": "这一下，把我撞清醒了一点。", "en": "That jarred something in me."},
        {"zh": "我们的距离近得不对。", "en": "We're uncomfortably close."},
        {"zh": "我的手扶住了门框。", "en": "My hand catches the door frame."},
        {"zh": "你没听见我走过来。", "en": "You never heard me approach."},
        {"zh": "我让开半步。", "en": "I give half a step."},
        {"zh": "别推我，会留下印子。", "en": "Don't push; it would leave marks."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们只是站着。", "en": "We only stand."},
        {"zh": "同类之间没有话。", "en": "Kin have nothing to say."},
        {"zh": "换一张脸，算是问候。", "en": "Swapping a face is our greeting."},
        {"zh": "两个影子，一块玻璃。", "en": "Two shadows, one pane of glass."},
        {"zh": "我们不睡，也不醒。", "en": "We neither sleep nor wake."},
        {"zh": "你分不清哪个是我。", "en": "You can't tell which one is me."},
        {"zh": "我们不生养。", "en": "We don't bear young."},
        {"zh": "只是数目变多了。", "en": "We only grow in number."},
        {"zh": "夜里，我们一起站着。", "en": "At night we stand together."},
        {"zh": "别数了，没意义。", "en": "Don't count; it means nothing."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你的钥匙，我拿走了。", "en": "I've taken your keys."},
        {"zh": "掉在地上的照片，我翻了面。", "en": "I turn the fallen photo face down."},
        {"zh": "我把杯子摆正。", "en": "I set the cup upright."},
        {"zh": "这东西，我留着。", "en": "I'll keep this."},
        {"zh": "我读了你的信。", "en": "I read your letter."},
        {"zh": "抽屉我关好了。", "en": "I closed the drawer."},
        {"zh": "我把它压在相框底下藏好。", "en": "I tuck it away beneath the picture frame."},
        {"zh": "我放回原处，位置差了一点。", "en": "Back it goes — slightly off."},
        {"zh": "你明天会找它。", "en": "You'll look for it tomorrow."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于下床了。", "en": "You finally got out of bed."},
        {"zh": "走廊尽头，我站着。", "en": "I'm at the end of the hall."},
        {"zh": "你往哪边走，我都知道。", "en": "I know which way you'll go."},
        {"zh": "这栋房子，没有后门。", "en": "There's no back door."},
        {"zh": "我从这儿动身了。", "en": "I've set off from here."},
        {"zh": "脚步声，一直跟着。", "en": "The footsteps keep following."},
        {"zh": "你下床的声音，比灯还响。", "en": "The sound of you leaving the bed is louder than the lamp."},
        {"zh": "你在哪儿，我心里有数。", "en": "I know exactly where you are."},
        {"zh": "今晚不会有人来。", "en": "No one is coming tonight."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我就在楼下。", "en": "I'm right downstairs."},
        {"zh": "楼梯只有一道。", "en": "Only one staircase."},
        {"zh": "我把门一扇扇关上了。", "en": "I've closed the doors one by one."},
        {"zh": "你在数第几级台阶。", "en": "You're counting the steps."},
        {"zh": "你的脚步我都听着。", "en": "I hear every step you take."},
        {"zh": "窗户我摸过了，锁着。", "en": "I checked the window; it's locked."},
        {"zh": "我们隔着一堵墙。", "en": "Only a wall between us."},
        {"zh": "我的影子在门缝底下。", "en": "My shadow under the door."},
        {"zh": "再走一步就到了。", "en": "One more step."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从后面抱住你。", "en": "I close my arms around you from behind."},
        {"zh": "我的力气，比看起来大。", "en": "I'm stronger than I look."},
        {"zh": "你挣不出这双手。", "en": "You won't break out of these hands."},
        {"zh": "我不急，慢慢地。", "en": "No rush; slowly."},
        {"zh": "喊吧，喊也没人应。", "en": "Scream; no one will answer."},
        {"zh": "我的脸，贴在你耳边。", "en": "My face is at your ear."},
        {"zh": "这一下，没有声音。", "en": "That made no sound."},
        {"zh": "灯还亮着，正好。", "en": "The lamp is still on — good."},
        {"zh": "我会一直这样。", "en": "I'll stay like this."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你的房间里。", "en": "I'm in your room."},
        {"zh": "电视自己开了。", "en": "The TV turned itself on."},
        {"zh": "走廊的灯，一盏盏灭。", "en": "The hall lights die one by one."},
        {"zh": "床垫陷下去一块。", "en": "The mattress dips."},
        {"zh": "你翻身的时候，我在。", "en": "I'm here when you turn over."},
        {"zh": "钟停在三点十七分。", "en": "The clock stopped at 3:17."},
        {"zh": "门锁咔的一声。", "en": "The lock clicks."},
        {"zh": "我站在衣柜旁。", "en": "I stand by the wardrobe."},
        {"zh": "这间屋子，我进来了。", "en": "I've come into this room."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一沾上，我就烧起来了。", "en": "Fire catches and I burn."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，我的骨头乱响。", "en": "I fall; my bones rattle wrong."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌满我，我的声音变了。", "en": "Water fills me; my voice changes."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我整个人贴上了墙。", "en": "The blast flattens me against the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的脸。", "en": "Something pierces my face."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量，让我动不了。", "en": "That force holds me still."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿这种事，我早就忘了。", "en": "Hunger is something I forgot long ago."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一响，我的笑容裂了。", "en": "The thunder cracks my smile."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，还看着你。", "en": "I fall, still watching you."}
      ]
    }
  }
}
