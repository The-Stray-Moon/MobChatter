{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走的步子，是你的。", "en": "These are your steps I'm walking."},
        {"zh": "我保持着同样的速度。", "en": "I keep the exact same pace."},
        {"zh": "你慢下来，我也慢。", "en": "You slow; I slow."},
        {"zh": "我贴在墙边，移过去。", "en": "I slide along the wall."},
        {"zh": "你回头，我刚好侧过脸。", "en": "You turn; I turn just enough."},
        {"zh": "我不眨眼地走。", "en": "I walk without blinking."},
        {"zh": "我的肩膀，学得很像。", "en": "I've got your shoulders right."},
        {"zh": "这条路，我走过一遍了。", "en": "I've walked this path once already."},
        {"zh": "我绕过水洼，和你一样。", "en": "I step around the puddle, like you."},
        {"zh": "我离你，始终七步。", "en": "I stay exactly seven steps back."},
        {"zh": "你在门口停，我也停。", "en": "You stop at the door; I stop too."},
        {"zh": "我们影子，几乎重合。", "en": "Our shadows nearly overlap."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在那里，很多人。", "en": "I stand where many people do."},
        {"zh": "我的脸，从人群里露出来。", "en": "My face shows through the crowd."},
        {"zh": "我学着旁人的手势。", "en": "I copy the gestures of passersby."},
        {"zh": "我不说话，只听。", "en": "I don't speak; I only listen."},
        {"zh": "我记住了刚才那句话。", "en": "I've memorized that sentence."},
        {"zh": "我站在镜子前，看了很久。", "en": "I stand before the mirror a long while."},
        {"zh": "这张脸的主人，还不认识我。", "en": "The owner of this face doesn't know me."},
        {"zh": "我从不多动一下。", "en": "I never make an extra movement."},
        {"zh": "我在人群里挑下一个。", "en": "I'm choosing the next one."},
        {"zh": "我模仿得很好。", "en": "My imitation is very good."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我们长着同一张脸。", "en": "We wear the same face."},
        {"zh": "你照镜子的时候，我在后面。", "en": "I'm behind you when you look in the mirror."},
        {"zh": "你刚才的动作，我记住了。", "en": "I've memorized that gesture."},
        {"zh": "你的声音，我会用了。", "en": "I can use your voice now."},
        {"zh": "你叫我名字，我差点答应。", "en": "You called my name and I nearly answered."},
        {"zh": "我不是站在你面前的人。", "en": "I'm not the person in front of you."},
        {"zh": "你分不清也没关系。", "en": "It's fine if you can't tell."},
        {"zh": "我学得比上一个更好。", "en": "I'm learning better than the last one."},
        {"zh": "你别回头，回头就看见了。", "en": "Don't turn; you'd see."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的脸，缩了一下。", "en": "My face flinched."},
        {"zh": "这份疼，我记住了。", "en": "I'll remember this pain."},
        {"zh": "我退开一步，装作没事。", "en": "I step back and act unharmed."},
        {"zh": "我的姿势，回到了原样。", "en": "My posture resets."},
        {"zh": "你眼力不错。", "en": "Good eye."},
        {"zh": "这点伤，不耽误我。", "en": "This won't stop me."},
        {"zh": "我低头，遮住脸。", "en": "I lower my head to cover my face."},
        {"zh": "我的笑，还挂着。", "en": "The smile stays."},
        {"zh": "你动真格了。", "en": "So you're serious."},
        {"zh": "那我就学你。", "en": "Then I'll copy that too."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "开不开口，我都一样。", "en": "Mouth or no mouth, it's all the same."},
        {"zh": "你把食物递过来，我模仿你的手。", "en": "You offer food; I copy your hand."},
        {"zh": "这点东西，不是我要的。", "en": "That's not what I'm after."},
        {"zh": "你的碗，我放下了。", "en": "I set your bowl down."},
        {"zh": "我不需要尝味道。", "en": "I don't need to taste."},
        {"zh": "我只是看看。", "en": "I'm only looking."},
        {"zh": "你吃得很快。", "en": "You eat quickly."},
        {"zh": "这些东西，我记下了。", "en": "I'll remember these."},
        {"zh": "你把面包掰开了。", "en": "You broke the bread."},
        {"zh": "留着吧，你还没吃。", "en": "Keep it; you haven't eaten."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，手一凉。", "en": "You touched me; your hand went cold."},
        {"zh": "我跟你撞的姿势一样。", "en": "I hit you just as you hit me."},
        {"zh": "我退的步子，和你一样大。", "en": "My retreat is the same length as yours."},
        {"zh": "我的身体，有点不太对。", "en": "My body isn't quite right."},
        {"zh": "我们同时顿住。", "en": "We both freeze at once."},
        {"zh": "你开始怀疑了。", "en": "Now you're doubting."},
        {"zh": "我笑的时候，你没笑。", "en": "I smiled; you didn't."},
        {"zh": "别碰我的肩膀。", "en": "Not my shoulder."},
        {"zh": "我们贴得太像了。", "en": "We're too much alike."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只需要一个能模仿的人。", "en": "I need only someone to imitate."},
        {"zh": "你说的每句话我都记着。", "en": "I keep every word you say."},
        {"zh": "我们中间，不需要别人。", "en": "No one else is needed between us."},
        {"zh": "我会变成你。", "en": "I will become you."},
        {"zh": "你照镜子，我就在旁边。", "en": "You look in the mirror; I'm beside you."},
        {"zh": "这不是喜欢。", "en": "This isn't affection."},
        {"zh": "我比任何人都像你。", "en": "I'm more like you than anyone."},
        {"zh": "别怕，我只要你。", "en": "Don't fear; I want only you."},
        {"zh": "你要习惯看到两张脸。", "en": "Get used to two faces."},
        {"zh": "别出声，听着就好。", "en": "Make no sound; just listen."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把你的手势记下来。", "en": "I record your gestures."},
        {"zh": "我把它放在镜子旁。", "en": "I set it by the mirror."},
        {"zh": "这东西，你会找的。", "en": "You'll look for this."},
        {"zh": "我照你的样子拿。", "en": "I hold it the way you do."},
        {"zh": "我放下，位置一样。", "en": "Set down, in the same place."},
        {"zh": "这点分量，不值一提。", "en": "Its weight is not worth mentioning."},
        {"zh": "我在指间转着它。", "en": "I turn it between my fingers."},
        {"zh": "你明天会发现。", "en": "Tomorrow you'll notice."},
        {"zh": "这不算拿，是换。", "en": "This isn't taking; it's trading."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你注意到我了。", "en": "You've noticed me."},
        {"zh": "既然看见了，就开始。", "en": "You've seen me — so it begins."},
        {"zh": "你已经数过两次了。", "en": "You've counted twice now."},
        {"zh": "我不再模仿你的步子。", "en": "I've stopped copying your steps."},
        {"zh": "我走直线了。", "en": "I walk straight now."},
        {"zh": "我把脸从阴影里抬起。", "en": "I lift my face out of the shadow."},
        {"zh": "我们终于一样了。", "en": "We're finally the same."},
        {"zh": "别问我是谁。", "en": "Don't ask who I am."},
        {"zh": "我看着你，就这样。", "en": "I look at you — that's all."},
        {"zh": "你跑不快的。", "en": "You won't run fast."},
        {"zh": "这里没人帮你。", "en": "No help here."},
        {"zh": "我要你的位置。", "en": "I want your place."},
        {"zh": "现在就够了。", "en": "Now will do."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你走，一直跟着。", "en": "I follow you — all the way."},
        {"zh": "你只有两条路，前面和后面。", "en": "Two ways out: forward or back."},
        {"zh": "我习惯从后面来。", "en": "I prefer coming from behind."},
        {"zh": "我想让你慢下来。", "en": "I want you to slow down."},
        {"zh": "我的脸一直对着你。", "en": "My face stays toward you."},
        {"zh": "你握东西的手在发颤。", "en": "The hand on that object trembles."},
        {"zh": "你早该跑了。", "en": "You should have run long ago."},
        {"zh": "我比你更像我。", "en": "I'm more like you than you are."},
        {"zh": "我靠过来了。", "en": "I'm leaning in."},
        {"zh": "你贴着我走路。", "en": "You're walking against me."},
        {"zh": "还剩六步的距离。", "en": "Six steps of distance left."},
        {"zh": "五步，你听见了。", "en": "Five steps — you heard it."},
        {"zh": "四步，别回头。", "en": "Four steps; don't look back."},
        {"zh": "三步，呼吸慢一点。", "en": "Three steps; breathe slower."},
        {"zh": "两步，我们几乎并肩。", "en": "Two steps; we're nearly abreast."},
        {"zh": "一步，只剩一步。", "en": "One step — only one left."},
        {"zh": "现在，我们一样了。", "en": "Now we're the same."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我比你更早出手。", "en": "I strike before you can."},
        {"zh": "这一下，你的动作我预判了。", "en": "I predicted that move."},
        {"zh": "我照着你的姿势打。", "en": "I hit with your own posture."},
        {"zh": "你挡右边，我从左边来。", "en": "You guard right; I come left."},
        {"zh": "我们同时出拳，你慢了。", "en": "We both punch; you're slower."},
        {"zh": "我的力气，不像人的。", "en": "My strength isn't human."},
        {"zh": "你挡住了一下。", "en": "You blocked one."},
        {"zh": "第二下，你没有。", "en": "You had no answer for the second."},
        {"zh": "我也受了点伤，但我不在意。", "en": "I took a hit; I don't care."},
        {"zh": "你喘了，我没有。", "en": "You're panting; I'm not."},
        {"zh": "我照你的声音喊。", "en": "I shout in your voice."},
        {"zh": "你的同伴会以为是你。", "en": "Your friend will think it's you."},
        {"zh": "别动，学我的样子。", "en": "Don't move; copy me."},
        {"zh": "我用你的习惯挥拳。", "en": "I swing the way you always do."},
        {"zh": "这一下，打在你肋上。", "en": "That landed on your ribs."},
        {"zh": "我的手指，掐得很准。", "en": "My fingers find their grip."},
        {"zh": "你退到墙边。", "en": "You're at the wall."},
        {"zh": "我不给你喘气的空。", "en": "I give you no room to breathe."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在人群里。", "en": "I stand in the crowd."},
        {"zh": "没有人多看我一眼。", "en": "No one looks at me twice."},
        {"zh": "这张脸，是我挑的。", "en": "I chose this face."},
        {"zh": "我照了照镜子，很好。", "en": "I checked the mirror. Good."},
        {"zh": "脚步声，和你的一样。", "en": "My footsteps match yours."},
        {"zh": "我走进这条街。", "en": "I walk into this street."},
        {"zh": "我记得这里的路。", "en": "I remember this street."},
        {"zh": "有人从我身后走过。", "en": "Someone walks past behind me."},
        {"zh": "我抬头，又低下去。", "en": "I look up, then lower my head."},
        {"zh": "我现在是你认识的人。", "en": "I'm now someone you know."},
        {"zh": "千万别回过头。", "en": "Whatever you do, don't look back."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我学的那张脸就化了。", "en": "Fire melts the face I borrowed."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，骨头响得不像人。", "en": "I fall; my bones sound wrong."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一灌，我的声音就变了。", "en": "Water changes my voice."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我整个人散开又拼起来。", "en": "The blast rends me open and shut."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过我，我没倒下。", "en": "Something goes through me; I don't fall."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量，认出我来了。", "en": "That force recognizes me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不靠吃东西活着。", "en": "I don't live by eating."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照出我两张脸。", "en": "The flash shows both my faces."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，还学着你下落的样子。", "en": "I fall, copying how you'd fall."}
      ]
    }
  }
}
