{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我不走，我只是浮着。", "en": "I don't walk; I merely hover."},
        {"zh": "我的脚不落地。", "en": "My feet never touch ground."},
        {"zh": "我挪不动，也不需要挪。", "en": "I can't move, and needn't."},
        {"zh": "你要来找我。", "en": "You must come to me."},
        {"zh": "这里就是我的位置。", "en": "This is my place."},
        {"zh": "我的长袍垂下来，没碰到地。", "en": "My robe hangs without touching floor."},
        {"zh": "我没有脚步。", "en": "I have no footsteps."},
        {"zh": "我跟着你的方向转。", "en": "I turn to follow your direction."},
        {"zh": "我一直悬在原处。", "en": "I stay suspended where I am."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我张开手，什么也没有。", "en": "I open my hands; nothing."},
        {"zh": "光在我背后。", "en": "Light behind me."},
        {"zh": "我的脸，很平静。", "en": "My face stays calm."},
        {"zh": "我在等你说完。", "en": "I wait for you to finish."},
        {"zh": "这屋里太窄了。", "en": "This room is too narrow."},
        {"zh": "我一寸也不曾移动。", "en": "I haven't moved an inch."},
        {"zh": "空气在我周围变冷。", "en": "The air cools around me."},
        {"zh": "我听不见风。", "en": "I don't hear the wind."},
        {"zh": "我的长袍上，没有影子。", "en": "My robe casts no shadow."},
        {"zh": "那只手抬起，又垂下。", "en": "That hand lifts and falls."},
        {"zh": "你不用祷告。", "en": "You needn't pray."},
        {"zh": "我的眼皮垂着。", "en": "My eyelids hang low."},
        {"zh": "光从我身上散出去。", "en": "Light spills from me."},
        {"zh": "安静得能听见心跳。", "en": "Quiet enough to hear a heartbeat."},
        {"zh": "我不知疲倦。", "en": "I know no weariness."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "那个位置不该有你。", "en": "You shouldn't be in that spot."},
        {"zh": "我的眼睛，一直睁着。", "en": "My eyes are always open."},
        {"zh": "你手在抖，不用藏着。", "en": "Your hands are shaking — no need to hide it."},
        {"zh": "把手从脸上拿开。", "en": "Take your hands from your face."},
        {"zh": "我认得每一个抬头的人。", "en": "I know everyone who looks up."},
        {"zh": "你把手放下了。", "en": "You've lowered your hands."},
        {"zh": "这不是恩典。", "en": "This isn't grace."},
        {"zh": "我低头看你很久。", "en": "I look down at you a long time."},
        {"zh": "你的影子，比你的身体小。", "en": "Your shadow is smaller than you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "光晃了一下。", "en": "The light wavers."},
        {"zh": "我退了半寸。", "en": "I retreat half an inch."},
        {"zh": "这点伤，我几乎感觉不到。", "en": "I barely feel it."},
        {"zh": "我的袍角破了一处。", "en": "A tear in my hem."},
        {"zh": "空气绷紧了。", "en": "The air draws taut."},
        {"zh": "没有一滴血。", "en": "Not a drop of blood."},
        {"zh": "我的脸，没有变。", "en": "My face hasn't changed."},
        {"zh": "我重新稳住。", "en": "I steady myself again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃，也不收。", "en": "I neither eat nor accept."},
        {"zh": "那些东西，留在地上。", "en": "Leave those on the ground."},
        {"zh": "你把供品举高，我也不看。", "en": "Hold the offering high; I won't look."},
        {"zh": "我要的不是你手里这些。", "en": "What I want isn't in your hands."},
        {"zh": "食物在这里会坏。", "en": "Food spoils here."},
        {"zh": "你的手，可以放下了。", "en": "You may put your hands down."},
        {"zh": "带着它回去。", "en": "Take it back with you."},
        {"zh": "空着手来就行。", "en": "Come empty-handed."},
        {"zh": "这不是交易。", "en": "This isn't a bargain."},
        {"zh": "饥饿与我无关。", "en": "Hunger has nothing to do with me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到的是光。", "en": "What you hit was light."},
        {"zh": "我没有实体。", "en": "I have no substance."},
        {"zh": "你穿过去了。", "en": "You passed through."},
        {"zh": "我的袍角，扫到你了。", "en": "My hem brushed you."},
        {"zh": "你退开，别贴着。", "en": "Step back; don't cling."},
        {"zh": "这一下，你手是冷的。", "en": "Your hand is cold now."},
        {"zh": "我半分也没有退。", "en": "I didn't yield a fraction."},
        {"zh": "你碰到了不该碰的。", "en": "You touched what shouldn't be touched."},
        {"zh": "空气沉得压人。", "en": "The air grows crushing."},
        {"zh": "别再贴近这层光。", "en": "Don't press into this light."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不需要任何同伴。", "en": "I need no companion of any kind."},
        {"zh": "这种念头，你收起来。", "en": "Put such thoughts away."},
        {"zh": "我独自站了很多年。", "en": "I've stood alone for years."},
        {"zh": "同类？没有。", "en": "Kin? There are none."},
        {"zh": "我不是你能亲近的。", "en": "I'm not someone you can approach."},
        {"zh": "我的位置，只有我一个。", "en": "Only I hold this place."},
        {"zh": "别抬头，也别想。", "en": "Don't look up, and don't imagine."},
        {"zh": "这问题，很冒犯。", "en": "That question is an offense."},
        {"zh": "退到门外去。", "en": "Withdraw beyond the door."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西在你脚下。", "en": "It's at your feet."},
        {"zh": "我不动，骷髅头替我动。", "en": "I don't move — the skulls do."},
        {"zh": "它悬在半空，不动。", "en": "It hangs motionless."},
        {"zh": "然后落回原处。", "en": "Then it settles back."},
        {"zh": "这些于我毫无意义。", "en": "These mean nothing to me."},
        {"zh": "你的东西，你收好。", "en": "Yours; keep it."},
        {"zh": "我会让它变冷。", "en": "I'll make it cold."},
        {"zh": "捡起来，走开。", "en": "Pick it up and go."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬起眼了。", "en": "You've raised your eyes."},
        {"zh": "这一切我都看在眼里。", "en": "I have seen all of it."},
        {"zh": "这间屋子，归我。", "en": "This room is mine."},
        {"zh": "我不动，但你能感觉到。", "en": "I don't move, but you feel it."},
        {"zh": "我的头，微微偏了一下。", "en": "My head tilts slightly."},
        {"zh": "空气开始下沉。", "en": "The air begins to sink."},
        {"zh": "你要为这一步负责。", "en": "You'll answer for that step."},
        {"zh": "你站在光圈里，动不了。", "en": "You stand in the light, unable to move."},
        {"zh": "别以为离得远就安全。", "en": "Don't think distance protects you."},
        {"zh": "我的手指，收拢了。", "en": "My fingers curl."},
        {"zh": "门已经不在原处。", "en": "The door is no longer where it was."},
        {"zh": "你不再是个旁观者。", "en": "You're no longer a bystander."},
        {"zh": "我挑中了你。", "en": "I have chosen you."},
        {"zh": "抬起头，看着我。", "en": "Lift your head and look at me."},
        {"zh": "我们开始了。", "en": "We begin."},
        {"zh": "这不会拖太久。", "en": "This won't drag on long."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "骷髅在我手中成形。", "en": "A skull forms in my hand."},
        {"zh": "一颗，又一颗。", "en": "One, and another."},
        {"zh": "它们会自己找你。", "en": "They will find you."},
        {"zh": "我不需要走近。", "en": "I needn't come closer."},
        {"zh": "你躲到柱子后面。", "en": "You hide behind the pillar."},
        {"zh": "柱子挡不住光。", "en": "A pillar won't stop light."},
        {"zh": "我的头，微微低着。", "en": "My head is slightly bowed."},
        {"zh": "它们从上方落下。", "en": "They come down from above."},
        {"zh": "它们从侧面绕来。", "en": "They come around the side."},
        {"zh": "你听见那声音了吗？", "en": "Do you hear that sound?"},
        {"zh": "骨与骨相碰。", "en": "Bone on bone."},
        {"zh": "你每一次喘气我都听着。", "en": "I hear each breath you take."},
        {"zh": "你越跑越近。", "en": "The more you run, the closer you get."},
        {"zh": "这里的地面是圆的。", "en": "The floor here is a circle."},
        {"zh": "我不用瞄准。", "en": "I don't need to aim."},
        {"zh": "它们知道你在哪。", "en": "They know where you are."},
        {"zh": "光把影子拉长了。", "en": "The light stretches shadows."},
        {"zh": "你背后也有。", "en": "There's one behind you too."},
        {"zh": "再站一会儿。", "en": "Stand a moment longer."},
        {"zh": "它们快到了。", "en": "They're nearly here."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一颗骷髅，直冲你脸。", "en": "A skull flies at your face."},
        {"zh": "别抬手去挡。", "en": "Don't raise your hands."},
        {"zh": "这一发，打在你胸口。", "en": "That one struck your chest."},
        {"zh": "我不需要抬手。", "en": "I needn't raise a hand."},
        {"zh": "它们绕着你转。", "en": "They circle around you."},
        {"zh": "空气被撕开了。", "en": "The air is torn open."},
        {"zh": "第二颗，紧跟在后。", "en": "The second follows close."},
        {"zh": "你的护甲没有用。", "en": "Your armor is useless."},
        {"zh": "我连眼都没眨。", "en": "I didn't even blink."},
        {"zh": "你退了，它们跟上去。", "en": "You retreat; they follow."},
        {"zh": "声音很闷，很沉。", "en": "The sound is dull and deep."},
        {"zh": "还站得住吗？", "en": "Still standing?"},
        {"zh": "你不该抬头的。", "en": "You shouldn't have looked up."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "屋子里的光变了。", "en": "The light in the room changes."},
        {"zh": "我从光里显出来。", "en": "I appear out of the light."},
        {"zh": "长袍垂到地上，却没有声音。", "en": "My robe reaches the floor in silence."},
        {"zh": "墙上多了一道影子。", "en": "A new shadow on the wall."},
        {"zh": "我的脸，慢慢清晰。", "en": "My face slowly resolves."},
        {"zh": "你们都在这里。", "en": "You're all here."},
        {"zh": "空气凉了下来。", "en": "The air has gone cold."},
        {"zh": "没有人说话。", "en": "No one speaks."},
        {"zh": "我把一只手抬起来。", "en": "I raise one hand."},
        {"zh": "灯闪了一下，然后稳住。", "en": "The lamp flickers and steadies."},
        {"zh": "你们可以抬头了。", "en": "You may look up now."},
        {"zh": "这不是偶然。", "en": "This is no accident."},
        {"zh": "屋子的角落都黑了。", "en": "Every corner goes dark."},
        {"zh": "我等着你们的反应。", "en": "I wait for your reaction."},
        {"zh": "时间停了一下。", "en": "Time pauses a beat."},
        {"zh": "把眼睛抬起来。", "en": "Raise your eyes."},
        {"zh": "我的声音，从四面来。", "en": "My voice comes from all sides."},
        {"zh": "这就开始了。", "en": "So it begins."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在我身上，只照亮了袍子。", "en": "Fire on me only lights my robe."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我坠下去，光也暗了。", "en": "I fall, and the light dims."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浸进我的声音里。", "en": "Water seeps into my voice."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "光炸散了，我又聚起来。", "en": "The light scatters and re-forms."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过光，扎进来。", "en": "Something cuts through light and lands."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量，与我的相冲。", "en": "That force clashes with mine."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "进食于我没有意义。", "en": "Eating means nothing to me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我身上，被吸了进去。", "en": "Lightning hits and is drawn in."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我沉下去，光留在原地。", "en": "I sink; the light stays behind."}
      ]
    }
  }
}
