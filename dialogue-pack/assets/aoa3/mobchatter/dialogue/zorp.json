        {"zh": "利爪紧绷，准备致命一击。", "en": "Claws tighten, ready for the kill."},
        {"zh": "嘶嘶低鸣，瞄准你的致命之处。", "en": "Sssss, aiming for your fatal spot."},
        {"zh": "腹部荧光闪烁，瞄准你的破绽。", "en": "Abdomen glows, targeting your flaw."},
        {"zh": "皮肤下的肌肉膨胀，准备攻击。", "en": "Muscles bulge, ready to strike."},
        {"zh": "眼中绿光大盛，锁定你的致命弱点。", "en": "Green eyes glow, targeting your fatal weakness."},
        {"zh": "它的指节捏得咔咔响", "en": "Its knuckles crack as it clenches them."},
        {"zh": "它侧身，找你的空当", "en": "It angles its body, hunting an opening."},
        {"zh": "呼吸声粗重，压过来", "en": "Its heavy breathing closes in."},
        {"zh": "它把拳头举到肩高", "en": "It lifts a fist to shoulder height."},
        {"zh": "它算好了两步的距离", "en": "It has measured the two-step gap."},
        {"zh": "月尘在它脚边打转", "en": "Moon dust swirls at its feet."},
        {"zh": "它微微弓背，蓄势待发", "en": "It arches its back, coiling to spring."},
        {"zh": "它没有退路，也不打算退", "en": "It has no way back and wants none."},
        {"zh": "它盯着你的护甲接缝", "en": "It eyes the seams in your armor."},
        {"zh": "它把重心压到前脚", "en": "It shifts its weight onto the front foot."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶嘶，我要吃了你！", "en": "Hisssss, I'm going to eat you!"},
        {"zh": "准备迎接死亡吧！", "en": "Prepare to meet thy doom!"},
        {"zh": "让你尝尝我的利爪！", "en": "Feel the sharpness of my claws!"},
        {"zh": "快闪开！我来了！", "en": "Move! Here I come!"},
        {"zh": "缺氧的地方，你跑不快。", "en": "In this airless place, you cannot run fast."},
        {"zh": "月尘扬起，我寸步不让。", "en": "Moon dust rises; I give no ground."},
        {"zh": "月球上没地方躲。", "en": "No place to hide on the moon."},
        {"zh": "我的拳头砸进月壤。", "en": "My fist drives into the lunar soil."},
        {"zh": "月球上的骨头，比你的硬。", "en": "Bones grown on the moon are harder than yours."},
