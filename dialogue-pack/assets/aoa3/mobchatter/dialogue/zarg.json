    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身体被撕裂，疼痛难忍。", "en": "My flesh is torn apart, agony!"},
        {"zh": "鲜血直流，生命垂危。", "en": "Blood flows, my end is near."},
        {"zh": "伤口深如沟壑，痛不欲生。", "en": "Wounds run deep, unbearable pain."},
        {"zh": "挣扎中生命流逝，快死了。", "en": "Life drains away in struggle, I'm dying."},
