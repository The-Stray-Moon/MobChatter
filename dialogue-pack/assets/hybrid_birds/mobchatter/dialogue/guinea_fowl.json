{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小步快走，头一点一点。", "en": "I trot, head bobbing."},
        {"zh": "我的羽毛上全是白点。", "en": "My plumage is speckled white all over."},
        {"zh": "我穿过草丛，几乎看不见。", "en": "I cross the grass and nearly vanish in it."},
        {"zh": "我一边走一边啄。", "en": "I peck as I walk."},
        {"zh": "我绕着一块石头转了半圈。", "en": "I go half around a stone."},
        {"zh": "我的脚很细，走得很快。", "en": "My legs are thin, and quick."},
        {"zh": "我忽然停下，歪头。", "en": "I stop short and tilt my head."},
        {"zh": "然后继续往前走。", "en": "Then walk on."},
        {"zh": "我贴着一丛草根走。", "en": "I keep close to a clump of grass roots."},
        {"zh": "有虫，我啄了两下。", "en": "Insects. Two pecks."},
        {"zh": "吃到了，继续走。", "en": "Got them. Moving on."},
        {"zh": "我走到空地上，看了看。", "en": "I reach open ground and look about."},
        {"zh": "太开了，我退回去。", "en": "Too open. I go back."},
        {"zh": "我又回到草里。", "en": "I go back into the grass."},
        {"zh": "那里更安全。", "en": "It is safer there."},
        {"zh": "草比我高，我钻着走。", "en": "The grass is taller than me; I weave through."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在草里，一动不动。", "en": "I crouch in the grass without moving."},
        {"zh": "一侧的眼睛，盯着草里的动静。", "en": "One eye on each side, watching the grass."},
        {"zh": "我一直在听着。", "en": "I never stop listening."},
        {"zh": "草籽落在我背上，我没动。", "en": "Grass seed settles on my back; I stay still."},
        {"zh": "我压低身子，草里很暖。", "en": "I crouch low; the grass is warm."},
        {"zh": "我的羽毛上有细纹。", "en": "There are fine lines in my plumage."},
        {"zh": "我一直觉得这很好看。", "en": "I have always thought it handsome."},
        {"zh": "风把我的冠羽吹动。", "en": "The wind stirs the crest on my head."},
        {"zh": "有只虫爬过我的脚。", "en": "A bug crawls over my foot."},
        {"zh": "我一口啄下去。", "en": "I peck."},
        {"zh": "它已经不见了。", "en": "It is gone."},
        {"zh": "我又蹲好了。", "en": "I settle back down."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走近了，我不动。", "en": "You come near. I do not move."},
        {"zh": "我等你再走近一点。", "en": "I wait for you to come a little closer."},
        {"zh": "你再走一步，我就窜了。", "en": "One more step and I bolt."},
        {"zh": "我一下窜出去。", "en": "I bolt."},
        {"zh": "跑了几步又停。", "en": "A few steps on, I stop."},
        {"zh": "然后回头看你。", "en": "Then look back at you."},
        {"zh": "你没有追上来。", "en": "You do not chase."},
        {"zh": "我又低下头啄草。", "en": "I lower my head and peck the grass."},
        {"zh": "但一直在看你。", "en": "But I keep watching you."},
        {"zh": "你的影子很长。", "en": "Your shadow is long."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫了一声，窜进草里。", "en": "I call and bolt into the grass."},
        {"zh": "我蹲着一动不动。", "en": "I crouch still."},
        {"zh": "我一次能带四只雏鸟。", "en": "I can raise four keets at once."},
        {"zh": "我拖着翅膀往草深处钻。", "en": "I drag a wing deeper into the grass."},
        {"zh": "我蹭着草往前挪。", "en": "I creep along the grass."},
        {"zh": "走两步就停下。", "en": "Two steps and I stop."},
        {"zh": "听一听动静。", "en": "Listen."},
        {"zh": "然后再往前走。", "en": "Then walk on."},
        {"zh": "跑得动，还能再跑。", "en": "Still running. Still can."},
        {"zh": "那就已经够了。", "en": "That is enough."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那些是谷粒。", "en": "That is grain."},
        {"zh": "我点着头，一步一步凑近。", "en": "Head bobbing, I edge closer step by step."},
        {"zh": "啄起了一粒。", "en": "One peck, one grain."},
        {"zh": "又啄起一粒。", "en": "Another."},
        {"zh": "我的头点得很快。", "en": "My head bobs quickly."},
        {"zh": "别的珠鸡也来了。", "en": "The other guineas come too."},
        {"zh": "羽毛挨着羽毛，谁都不让。", "en": "Feather against feather, nobody yields."},
        {"zh": "我们吃了不少。", "en": "We eat a good deal."},
        {"zh": "你退开，我们就散。", "en": "You step back and we scatter."},
        {"zh": "可都没有走远。", "en": "But none goes far."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踢到草，我窜开了。", "en": "You kick the grass and I dart away."},
        {"zh": "我炸开翅膀，尖叫着窜开。", "en": "I burst my wings open and shriek away."},
        {"zh": "我跑出一段才停。", "en": "I run a stretch before stopping."},
        {"zh": "我跑出一段，才敢回头看。", "en": "I run a ways before daring to look back."},
        {"zh": "你就站在原地。", "en": "You are standing still."},
        {"zh": "我慢慢走回来。", "en": "I walk slowly back."},
        {"zh": "可我从旁边绕开。", "en": "But I go around you."},
        {"zh": "我从另一边过去。", "en": "I go by on the other side."},
        {"zh": "珠鸡的爪，这个距离正好。", "en": "A guinea fowl's claws — just the right distance."},
        {"zh": "我继续找吃的。", "en": "I go back to foraging."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只在草的另一边。", "en": "Another is on the far side of the grass."},
        {"zh": "我们互相叫着。", "en": "We call to each other."},
        {"zh": "声音很尖，很急。", "en": "The calls are sharp and quick."},
        {"zh": "我就跑了过去。", "en": "I run over."},
        {"zh": "我一次能孵四只小珠鸡。", "en": "I hatch four keets at a time."},
        {"zh": "我的冠羽立起来了。", "en": "My crest stands up."},
        {"zh": "她的也立起来。", "en": "So does hers."},
        {"zh": "我用脚刨土，她在旁边看着。", "en": "I scratch the soil; she watches beside me."},
        {"zh": "草叶垫在里面。", "en": "Grass blades line it."},
        {"zh": "她伏进那个坑里。", "en": "She settles into the hollow."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我啄起来，又放下。", "en": "I peck it up, then drop it."},
        {"zh": "这实在太小了。", "en": "This is far too small."},
        {"zh": "我用脚刨了刨。", "en": "I scratch at it with a foot."},
        {"zh": "下面有虫子。", "en": "Insects underneath."},
        {"zh": "我把它们吃了。", "en": "I eat them."},
        {"zh": "那个东西不是吃的。", "en": "That other thing is not food."},
        {"zh": "我又补了一啄。", "en": "I add one more peck."},
        {"zh": "啄了两下，这东西是硬的。", "en": "Two pecks, and it's hard as stone."},
        {"zh": "一窝四只，够热闹。", "en": "Four keets a clutch. Lively."},
        {"zh": "接着继续找。", "en": "Back to searching."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶尖一抖，我的头就定住了。", "en": "A leaf tip twitches and my head freezes."},
        {"zh": "我的头停住了。", "en": "My head stops."},
        {"zh": "是一只虫子。", "en": "A bug."},
        {"zh": "不大，却能吃。", "en": "Small, but edible."},
        {"zh": "白点羽毛贴住草根。", "en": "My spotted feathers press against the grass roots."},
        {"zh": "我再走一步。", "en": "One more step."},
        {"zh": "它还在爬，我的脖子先动了。", "en": "It keeps crawling; my neck moves first."},
        {"zh": "我把头抬了抬。", "en": "I raise my head a little."},
        {"zh": "一下子就啄下去。", "en": "And peck down."},
        {"zh": "这就吃到了。", "en": "Got it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着那个小东西。", "en": "I fix on the small thing."},
        {"zh": "它往草根里钻。", "en": "It goes into the grass roots."},
        {"zh": "我用脚刨开草根。", "en": "I scratch the roots open."},
        {"zh": "它逃出来了。", "en": "It runs out."},
        {"zh": "我立刻跟上。", "en": "I follow at once."},
        {"zh": "它钻进草根，我跟着拐。", "en": "It ducks into the roots; I turn with it."},
        {"zh": "我随着它拐弯。", "en": "I turn with it."},
        {"zh": "它停在一块叶子下面。", "en": "It stops under a leaf."},
        {"zh": "我把喙对准它，停了一息。", "en": "I line my beak up and hold one breath."},
        {"zh": "我一啄下去。", "en": "I peck down."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一啄，很准。", "en": "One peck, precise."},
        {"zh": "虫子被叨住了。", "en": "The bug is caught."},
        {"zh": "我一次能带四只小珠鸡。", "en": "I bring four keets at a time."},
        {"zh": "然后吞下去。", "en": "Then swallow."},
        {"zh": "喉咙动了一下。", "en": "My throat moves once."},
        {"zh": "我把胸前理顺。", "en": "I smooth my breast."},
        {"zh": "有一根歪了。", "en": "One is out of place."},
        {"zh": "我啄了两下才顺。", "en": "Two pecks and it lies right."},
        {"zh": "我啄完，抬头看有没有别的。", "en": "Done pecking, I look up for more."},
        {"zh": "太阳还挂在那儿。", "en": "The sun is still there."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从草籽堆里站起来。", "en": "I rise out of a heap of grass seed."},
        {"zh": "羽毛上沾着碎屑。", "en": "Bits of chaff cling to my feathers."},
        {"zh": "这里的草很高。", "en": "The grass is tall here."},
        {"zh": "正好用来藏身。", "en": "Good for hiding."},
        {"zh": "我歪头听了听。", "en": "I tilt my head and listen."},
        {"zh": "没有大的声音。", "en": "No large sounds."},
        {"zh": "我小步走出去。", "en": "I step out."},
        {"zh": "地上有虫子。", "en": "Insects on the ground."},
        {"zh": "我先吃了几口。", "en": "I eat a few first."},
        {"zh": "然后才看四周。", "en": "Only then do I look around."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的羽毛，我一头钻进草里。", "en": "Fire scorches my feathers and I dive into the grass."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处掉下来，落在硬地上。", "en": "I fall from a height onto hard ground."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水盖过我，我乱拍翅膀。", "en": "Water closes over me; I beat my wings wildly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀翻，草叶乱飞。", "en": "The blast throws me over and grass flies."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭羽扎进我翅膀，我扑进草里。", "en": "The fletching sticks in my wing; I crash into the grass."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光罩住我，我僵住了。", "en": "Strange light wraps me and I freeze."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "找不到虫，我越来越轻。", "en": "No insects to be found, and I grow lighter."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下，我浑身一紧。", "en": "Lightning falls and every part of me tightens."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "草地没了，我在黑里扑腾。", "en": "The grass is gone and I flail in the dark."}
      ]
    }
  }
}
