{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我摇摇摆摆走过去。", "en": "I waddle along."},
        {"zh": "脚蹼踩在湿泥上，很响。", "en": "My webbed feet slap the wet mud."},
        {"zh": "我一边走一边用嘴拨草。", "en": "I sift the grass with my bill as I go."},
        {"zh": "我在水边转了个方向。", "en": "I turn at the water's edge."},
        {"zh": "我的尾巴上下点着。", "en": "My tail bobs up and down."},
        {"zh": "我走到浅水里，浮起来了。", "en": "I walk into the shallows and float."},
        {"zh": "水上我比地上自在。", "en": "I am easier on water than on land."},
        {"zh": "我沿着河沟往前走。", "en": "I travel along the ditch."},
        {"zh": "我绕开一块滑石。", "en": "I go around a slick stone."},
        {"zh": "我回头看了一眼后面。", "en": "I glance back."},
        {"zh": "没有东西跟着。", "en": "Nothing is following."},
        {"zh": "我接着摇过去。", "en": "I waddle on."},
        {"zh": "我又低头吃了几口。", "en": "I dip my head for a few more bites."},
        {"zh": "草汁沾在嘴边。", "en": "Grass juice smears my bill."},
        {"zh": "我甩了甩尾羽，继续摇。", "en": "I flick my tail feathers and waddle on."},
        {"zh": "往前挪了几步。", "en": "And move a few steps on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在水上，随水漂。", "en": "I float and let the water carry me."},
        {"zh": "我用嘴理了理胸口的毛。", "en": "I preen the feathers on my breast."},
        {"zh": "水面有虫，我啄了一下。", "en": "An insect on the surface. I peck."},
        {"zh": "这一下没啄到。", "en": "I missed that one."},
        {"zh": "我再啄一次。", "en": "I peck again."},
        {"zh": "这次吃到了。", "en": "This time I get it."},
        {"zh": "岸边有鸭子在叫。", "en": "Ducks are calling on the bank."},
        {"zh": "我应了一声。", "en": "I answer."},
        {"zh": "水很凉，很舒服。", "en": "The water is cool and pleasant."},
        {"zh": "我把头埋进水里。", "en": "I dip my head under."},
        {"zh": "底下有水草。", "en": "Weed below."},
        {"zh": "我吃了几口草。", "en": "I eat a few mouthfuls."},
        {"zh": "抬起头，水从嘴边流下去。", "en": "I lift my head; water runs off my bill."},
        {"zh": "我心里很满意。", "en": "I am well content."},
        {"zh": "这就是一天了。", "en": "That is a day."},
        {"zh": "我又漂了一段。", "en": "I drift a while longer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你蹲在水边，我游过来。", "en": "You crouch at the water; I swim over."},
        {"zh": "我离你一步远就停了。", "en": "I stop a step away."},
        {"zh": "我在水边停下，看你蹲下。", "en": "I stop at the bank and watch you crouch."},
        {"zh": "你手里那点碎屑，我看见了。", "en": "I see those crumbs in your hand."},
        {"zh": "我啄了啄水面。", "en": "I peck at the water."},
        {"zh": "你不知道我想干什么。", "en": "You do not know what I want."},
        {"zh": "我自己也不知道。", "en": "I do not know either."},
        {"zh": "我转身游开了。", "en": "I turn and paddle off."},
        {"zh": "然后我又游回来。", "en": "Then I paddle back."},
        {"zh": "这次待得久一点。", "en": "This time I stay longer."},
        {"zh": "你蹲着不动，我就浮在这儿。", "en": "Stay still and I'll float right here."},
        {"zh": "我们这样挺好。", "en": "This suits us both."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫了一声，跑开两步。", "en": "I quack and waddle off two steps."},
        {"zh": "翅膀张开了，又收回去。", "en": "My wings open, then fold."},
        {"zh": "我躲进水里。", "en": "I take to the water."},
        {"zh": "掉了几根毛。", "en": "A few feathers come loose."},
        {"zh": "我抖了抖翅膀，羽毛都湿了。", "en": "I shook my wings; the feathers are soaked."},
        {"zh": "水面被我划出一片纹。", "en": "I scratch a spread of ripples."},
        {"zh": "我游到另一边。", "en": "I paddle to the far side."},
        {"zh": "还是有点疼。", "en": "It still stings."},
        {"zh": "我低头理了理。", "en": "I dip my head and preen."},
        {"zh": "过一会儿会好。", "en": "It will ease in a while."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是谷粒，我看见了。", "en": "Grain. I see it."},
        {"zh": "我摇着走过去。", "en": "I waddle over."},
        {"zh": "我一口一口啄。", "en": "I peck it up, one by one."},
        {"zh": "谷粒在嘴里，脆得很。", "en": "The grain cracks between my bill."},
        {"zh": "你掌心还剩一些。", "en": "Some is left in your palm."},
        {"zh": "我把头伸过去。", "en": "I stretch my head in."},
        {"zh": "被你的手指碰到了。", "en": "Your fingers brush me."},
        {"zh": "我退了一下，又凑上去。", "en": "I pull back, then lean in again."},
        {"zh": "全都吃完了。", "en": "All gone."},
        {"zh": "我吃完最后一口，才看你。", "en": "I finish the last bite before looking up."},
        {"zh": "你就这样走了。", "en": "And you just walk off."},
        {"zh": "我跟着走了几步。", "en": "I follow a few steps."},
        {"zh": "跟不上，我放弃了。", "en": "I cannot keep up. I give up."},
        {"zh": "回去吃草吧。", "en": "Back to the grass."},
        {"zh": "草其实也不错。", "en": "Grass is fine too."},
        {"zh": "我重新把头埋低。", "en": "I lower my head again."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你刚才踢到我。", "en": "You kicked me just now."},
        {"zh": "我扑腾着跑开。", "en": "I flap away."},
        {"zh": "我叫了两声，很响。", "en": "I quack twice, loudly."},
        {"zh": "别的鸭子都看过来。", "en": "The other ducks look over."},
        {"zh": "我扑腾着，从你脚边挪开。", "en": "Flapping, I shuffle away from your feet."},
        {"zh": "我的翅打到了你的腿。", "en": "My wing strikes your leg."},
        {"zh": "这一下我也有点疼。", "en": "That hurt me a little too."},
        {"zh": "我退到水里去。", "en": "I retreat into the water."},
        {"zh": "水上才算安全。", "en": "The water is safe."},
        {"zh": "我浮着看你。", "en": "I float and watch you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "岸边那只一直在看我。", "en": "That one on the bank keeps looking at me."},
        {"zh": "我朝她游过去。", "en": "I paddle over to her."},
        {"zh": "我们并排浮着。", "en": "We float side by side."},
        {"zh": "我用嘴碰了碰她的颈。", "en": "I touch her neck with my bill."},
        {"zh": "她低下头，又抬起来。", "en": "She dips her head, then lifts it."},
        {"zh": "她先上岸，我跟在后面。", "en": "She climbs out first; I follow."},
        {"zh": "草丛里有个窝。", "en": "There is a nest in the grass."},
        {"zh": "里面已经有蛋了。", "en": "There are eggs in it already."},
        {"zh": "她蹲坐在蛋上。", "en": "She settles onto them."},
        {"zh": "我在旁边守着。", "en": "I keep watch beside her."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "扁嘴一合，叼住了。", "en": "My flat bill closes on it."},
        {"zh": "这个吞不下去。", "en": "This will not go down."},
        {"zh": "我甩了甩，放下了。", "en": "I shake it and drop it."},
        {"zh": "我用脚踩了踩。", "en": "I step on it."},
        {"zh": "这东西有点软。", "en": "This is a little soft."},
        {"zh": "我又啄了一下。", "en": "I peck it once."},
        {"zh": "这个可不是。", "en": "Not this one."},
        {"zh": "我这身鸭肉，能凑三禽烤肉。", "en": "My meat completes a turducken."},
        {"zh": "它从我嘴里滑脱，沉下去了。", "en": "It slips from my bill and sinks."},
        {"zh": "我看着它漂走。", "en": "I watch it drift away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上有小东西在动。", "en": "Something small moves on the surface."},
        {"zh": "很小，是只虫。", "en": "Very small. An insect."},
        {"zh": "我一口就能吃。", "en": "One peck will do."},
        {"zh": "我把脖子探出去。", "en": "I stretch my neck out."},
        {"zh": "它往下沉了。", "en": "It sinks below."},
        {"zh": "我整个头扎下去。", "en": "I plunge my whole head under."},
        {"zh": "我一下就抓到了。", "en": "I have it at once."},
        {"zh": "我抬头吞下去。", "en": "I lift my head and swallow."},
        {"zh": "水面上又有虫。", "en": "More insects on the surface."},
        {"zh": "我朝它们转过去。", "en": "I turn to them."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着水面那个小点。", "en": "I fix on the small point on the water."},
        {"zh": "它漂得很快。", "en": "It drifts quickly."},
        {"zh": "我划水跟着它。", "en": "I paddle after it."},
        {"zh": "它拐了个弯。", "en": "It angles away."},
        {"zh": "我也跟着拐。", "en": "So do I."},
        {"zh": "我的脖子伸得很长。", "en": "My neck stretches out long."},
        {"zh": "嘴尖快碰到了。", "en": "My bill nearly touches."},
        {"zh": "它钻到水下去了。", "en": "It goes under."},
        {"zh": "我浮着不划水。", "en": "I float without paddling."},
        {"zh": "它总会浮上来的。", "en": "It must come up."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我啄了一下，很快。", "en": "I peck, quickly."},
        {"zh": "它被我叨住了。", "en": "It is caught."},
        {"zh": "我甩头，把它弄晕。", "en": "I shake my head to stun it."},
        {"zh": "然后一口吞下。", "en": "Then swallow it down."},
        {"zh": "喉咙动了两下。", "en": "My throat moves twice."},
        {"zh": "我理了理胸口的毛。", "en": "I smooth the feathers on my breast."},
        {"zh": "有一根毛竖着。", "en": "One feather sticks up."},
        {"zh": "我压了两下才服帖。", "en": "Two presses and it lies flat."},
        {"zh": "水面又恢复了平静。", "en": "The water settles again."},
        {"zh": "我继续漂着。", "en": "I drift on."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我拨开芦苇，滑进浅水。", "en": "I push through the reeds and slide into the shallows."},
        {"zh": "身上还带着草籽。", "en": "Grass seed still clings to me."},
        {"zh": "这里有水沟，很好。", "en": "There is a ditch here. Good."},
        {"zh": "我先喝了两口。", "en": "I drink twice first."},
        {"zh": "然后理了理翅膀。", "en": "Then tidy my wings."},
        {"zh": "水边的泥很软。", "en": "The mud at the water's edge is soft."},
        {"zh": "我走上去，留下脚印。", "en": "I walk on it and leave prints."},
        {"zh": "每只脚三个尖。", "en": "Three points to each foot."},
        {"zh": "我走到水里浮起来。", "en": "I walk in and float."},
        {"zh": "这里比我想的好。", "en": "Better than I expected."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到翅膀，我一头扎进水里。", "en": "Fire catches my wing and I dive into the water."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，翅膀乱拍。", "en": "I tumble down the slope, wings flailing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过头，我拼命蹬脚。", "en": "Water closes over me; I kick hard."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "一声炸响，我被掀到岸上。", "en": "A blast throws me onto the bank."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭蹭过我的背羽。", "en": "An arrow grazes my back feathers."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光一照，我的蹼都僵了。", "en": "The light hits and my webbed feet stiffen."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得没力气游了。", "en": "Too hungry to paddle."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我整只都僵了。", "en": "Lightning strikes and I go stiff."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "水没了，我在黑里扑腾。", "en": "The water is gone and I flail in the dark."}
      ]
    }
  }
}
