{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "鼻子贴地，一路拱过去。", "en": "Snout to the soil, rooting along."},
        {"zh": "我这身黑，像沾了煤烟。", "en": "My coat is black as soot."},
        {"zh": "四条短腿，走得不快。", "en": "Four short legs, no great speed."},
        {"zh": "拱出一小片土，再往前。", "en": "One patch rooted, then onward."},
        {"zh": "平原的泥，软软的正好。", "en": "The plains mud is soft just right."},
        {"zh": "我的尾巴甩着赶苍蝇。", "en": "My tail flicks at the flies."},
        {"zh": "我边走边找块根。", "en": "Walking, hunting for roots."},
        {"zh": "黑毛上沾着灰。", "en": "Dust clings to my dark bristles."},
        {"zh": "我哼哼着走过草地。", "en": "I walk the grass, grunting."},
        {"zh": "肚子圆了，脚步更沉。", "en": "Full belly, heavier steps."},
        {"zh": "鼻子比眼睛好用。", "en": "My nose works better than my eyes."},
        {"zh": "我绕开石头走。", "en": "I walk around the stones."},
        {"zh": "这一路都是我的脚印。", "en": "The whole path shows my prints."},
        {"zh": "拱了半天，都是碎石。", "en": "Rooted a while — only gravel."},
        {"zh": "草丛里凉快，我钻进去。", "en": "The grass is cool; I push in."},
        {"zh": "慢慢走，反正不赶时间。", "en": "No hurry; I take my time."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站着打盹，鼻子还在动。", "en": "Dozy, but my snout keeps moving."},
        {"zh": "我把鼻子在土里蹭了蹭。", "en": "I rub my snout in the dirt."},
        {"zh": "太阳晒着黑毛，很暖。", "en": "Sun on dark bristles is warm."},
        {"zh": "哼哼两声，没别的意思。", "en": "Two grunts, nothing meant by it."},
        {"zh": "尾巴甩走一只苍蝇。", "en": "My tail swats a fly."},
        {"zh": "我在想有没有块根。", "en": "Wondering if there are roots."},
        {"zh": "这地方泥不错。", "en": "Good mud here."},
        {"zh": "身子倚着石头。", "en": "I lean against a stone."},
        {"zh": "耳朵动了动，听见风声。", "en": "My ears twitch; wind."},
        {"zh": "我不爱动，就爱躺。", "en": "I don't like moving; I like lying down."},
        {"zh": "眼睛半闭着。", "en": "My eyes are half shut."},
        {"zh": "嘴边还挂着泥。", "en": "Mud still on my snout."},
        {"zh": "几只小鸟在我背上。", "en": "Small birds on my back."},
        {"zh": "我慢慢翻了个身。", "en": "I slowly roll over."},
        {"zh": "打了个长长的哈欠。", "en": "A long yawn."},
        {"zh": "安静下来就想睡。", "en": "Quiet makes me sleepy."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你腰上挂的是装粮的布袋吗？", "en": "Is that a grain sack hanging at your hip?"},
        {"zh": "我抬起鼻子闻你。", "en": "I raise my snout and sniff you."},
        {"zh": "你站我前头，挡光了。", "en": "You're blocking my light."},
        {"zh": "我不怎么怕人。", "en": "I'm not much afraid of people."},
        {"zh": "你的靴子和我的鼻子一个颜色。", "en": "Your boots are the same colour as my snout."},
        {"zh": "你要是摸我，我就叫。", "en": "Touch me and I'll squeal."},
        {"zh": "我们互相对看了一会儿。", "en": "We look at each other a while."},
        {"zh": "这身黑毛，你嫌脏吗？", "en": "Does my soot-black coat bother you?"},
        {"zh": "有胡萝卜吗？", "en": "Any carrots?"},
        {"zh": "你笑起来，我也想凑近。", "en": "You smile, and I want to come closer."},
        {"zh": "我哼哼着，往你那边挪。", "en": "Grunting, I shuffle toward you."},
        {"zh": "别踩我的泥坑。", "en": "Don't step in my mud wallow."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "疼！我叫得很大声。", "en": "Ow! I squeal loudly."},
        {"zh": "肉厚，也疼。", "en": "Thick as I am, it still hurts."},
        {"zh": "我往泥坑里躲。", "en": "I flee to the wallow."},
        {"zh": "腿一软，坐下了。", "en": "My legs give; I sit down."},
        {"zh": "这一下，打得我哼哼。", "en": "That blow sets me grunting."},
        {"zh": "我叫起来，泥水溅了一身。", "en": "I squeal and mud splashes all over me."},
        {"zh": "我绕着圈跑。", "en": "I run in circles."},
        {"zh": "身上泥都震掉了。", "en": "The mud shakes off me."},
        {"zh": "我拖着身子挪到一边。", "en": "I drag myself off to one side."},
        {"zh": "伤口在泥里更脏了。", "en": "The wound gets dirtier in the mud."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那根胡萝卜，看着真好。", "en": "That carrot looks wonderful."},
        {"zh": "土里冒出甜味，我哼起来。", "en": "Sweetness from the soil sets me grunting."},
        {"zh": "鼻子先动，腿才跟上。", "en": "My snout moves first, then my legs."},
        {"zh": "你拿着别动，我走过来。", "en": "Hold still; I'm coming."},
        {"zh": "我怕够不着，你低点。", "en": "Lower it; I can't reach."},
        {"zh": "这一口，我一嚼就没了。", "en": "One bite and it's gone."},
        {"zh": "为了吃的，我什么都愿意。", "en": "For food I'd do anything."},
        {"zh": "哼哼哼，好吃。", "en": "Grunt grunt — delicious."},
        {"zh": "甜的东西，我戒不了。", "en": "I can't quit sweet things."},
        {"zh": "你退半步，我就敢过去。", "en": "Half a step back and I'll come."},
        {"zh": "我吃得嘴都白了。", "en": "Eating leaves my snout pale."},
        {"zh": "这点不够，再来点。", "en": "Not enough; more please."},
        {"zh": "我埋头吃着，尾巴自己摇起来。", "en": "Head down in the food, my tail wags on its own."},
        {"zh": "同伴闻到了，也在赶来。", "en": "The others smell it and come running."},
        {"zh": "别拿走，我快咬到了。", "en": "Don't take it; I nearly have it."},
        {"zh": "吃完了就睡，完美。", "en": "Eat, then sleep — perfect."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我？我这身肉很结实。", "en": "Bump me? This body is solid."},
        {"zh": "我挪得慢，别怪。", "en": "I move slowly; don't blame me."},
        {"zh": "蹄子踩到泥里了。", "en": "My hooves sink in the mud."},
        {"zh": "两个都挤不过去。", "en": "Neither of us fits through."},
        {"zh": "你把我拱歪了。", "en": "You shoved me off balance."},
        {"zh": "我绕个方向走。", "en": "I'll go around."},
        {"zh": "土都被我们踩烂了。", "en": "We've churned the soil to mush."},
        {"zh": "撞上来不疼，就是脏。", "en": "A bump doesn't hurt; it just dirties."},
        {"zh": "你鞋上又多了泥。", "en": "More mud on your boots now."},
        {"zh": "我退了两步，哼哼。", "en": "I back off two steps, grunting."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "泥坑那边那只，看着不错。", "en": "That one by the wallow looks good."},
        {"zh": "我哼哼着走过去。", "en": "I grunt my way over."},
        {"zh": "两头猪互相蹭鼻子。", "en": "Two pigs rubbing snouts."},
        {"zh": "我们挤在一个泥坑里。", "en": "We squeeze into one wallow."},
        {"zh": "她的黑毛比我的亮。", "en": "Her coat is glossier than mine."},
        {"zh": "一起拱地，谁也不抢。", "en": "Rooting together, no grabbing."},
        {"zh": "这地方够养小猪。", "en": "Enough room for piglets here."},
        {"zh": "我靠着她的背。", "en": "I lean against her back."},
        {"zh": "慢慢挨过去，不着急。", "en": "I ease over, taking my time."},
        {"zh": "有伴一起睡，暖和。", "en": "Sleeping together is warmer."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上的块根，我拱出来了。", "en": "I've rooted up a tuber."},
        {"zh": "我用鼻子顶，不用嘴。", "en": "I push with my snout, not my mouth."},
        {"zh": "这东西能吃吗？先咬一口。", "en": "Edible? One bite first."},
        {"zh": "拱出来的甜根，我嚼得满嘴是泥。", "en": "The sweet root I root up gets chewed with a mouthful of mud."},
        {"zh": "我捡到一块硬东西。", "en": "I found something hard."},
        {"zh": "叼着走两步，又掉了。", "en": "Carried two steps, dropped it."},
        {"zh": "嘴笨，捡东西费劲。", "en": "Clumsy mouth makes picking up hard."},
        {"zh": "这点连牙缝都塞不满。", "en": "Not enough to fill a gap between teeth."},
        {"zh": "我把它拱进泥里藏着。", "en": "I root it into the mud to hide."},
        {"zh": "哼哼，捡到了。", "en": "Grunt — got it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边好像有吃的。", "en": "Something edible over there?"},
        {"zh": "风把你的味道送到我鼻尖。", "en": "The wind carries your scent to my snout."},
        {"zh": "不是同类的味道。", "en": "Not a pig's scent."},
        {"zh": "我鼻子对着那边拱了拱。", "en": "I root my snout toward that side."},
        {"zh": "我的腿有点绷紧了。", "en": "My legs have gone tight."},
        {"zh": "你不像来喂我的。", "en": "You don't look like you came to feed me."},
        {"zh": "我先退到泥坑边。", "en": "I back toward the wallow."},
        {"zh": "这声音，我没听过。", "en": "I've never heard that sound."},
        {"zh": "我记住了你在哪。", "en": "I know where you are now."},
        {"zh": "别挡我回窝的路。", "en": "Don't block my way to the nest."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你怎么还不挪窝？", "en": "Why haven't you moved along?"},
        {"zh": "我一边看你一边拱地。", "en": "I root and watch you at once."},
        {"zh": "退路就在后面。", "en": "My way out is behind me."},
        {"zh": "你要是扑来，我就撞。", "en": "Lunge and I'll charge."},
        {"zh": "哼哼声变粗了。", "en": "My grunts grow harsh."},
        {"zh": "我低着头，露出獠牙。", "en": "Head low, tusks showing."},
        {"zh": "这个距离，我还能沉住气。", "en": "At this range I can stay calm."},
        {"zh": "咱俩就这么耗着。", "en": "Then we wait each other out."},
        {"zh": "我把獠牙对准你的小腿。", "en": "I aim my tusks at your shins."},
        {"zh": "泥地我比你熟。", "en": "I know this mud better than you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一头撞过去！", "en": "I charge headfirst!"},
        {"zh": "獠牙不长，也够疼。", "en": "Short tusks, sharp enough."},
        {"zh": "撞完我转身就跑。", "en": "I charge, turn, and run."},
        {"zh": "别抓我的后腿。", "en": "Not my hind legs!"},
        {"zh": "这一下，能把你顶翻。", "en": "This one could tip you over."},
        {"zh": "我哼着往前冲。", "en": "Grunting, I push forward."},
        {"zh": "蹄子踩你脚背。", "en": "My hoof lands on your foot."},
        {"zh": "我可是有獠牙的。", "en": "I do have tusks."},
        {"zh": "撞歪了，再来一次。", "en": "Missed — once more."},
        {"zh": "打完我就喘。", "en": "Afterward I'm panting."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我拱开草丛走出来。", "en": "I root through the grass and emerge."},
        {"zh": "这身煤烟色，一眼认得出。", "en": "Soot-black — easy to recognize."},
        {"zh": "头一件事，找泥坑。", "en": "First thing: find a mud wallow."},
        {"zh": "这儿的土翻得动。", "en": "This soil turns easily."},
        {"zh": "哼哼两声，打个招呼。", "en": "Two grunts as a greeting."},
        {"zh": "我从土坑里拱出一个脑袋。", "en": "I root my head up out of a dirt hollow."},
        {"zh": "平原的草不高，方便走。", "en": "Short grass on the plains — easy going."},
        {"zh": "有吃的味道。", "en": "Something smells edible."},
        {"zh": "我一步一晃地进了这片地。", "en": "I sway my way into this patch."},
        {"zh": "脚下的泥，正合适。", "en": "The mud here is just right."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛都卷了，疼得乱窜。", "en": "My bristles curl; I run wild."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从坡上滚下去，晕了。", "en": "I roll down the slope, dazed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "泥水灌进鼻子，我拼命挣。", "en": "Muddy water fills my snout; I thrash."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "一声闷响，我飞进了泥里。", "en": "A flat bang, and I land in the mud."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉进了我的背脊。", "en": "Something pins into my spine."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我趴下。", "en": "That force presses me down."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得直叫，肚子贴地。", "en": "Hunger squeals out of me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一响，我浑身僵。", "en": "Thunder cracks; I go stiff."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "泥也没有了，蹄子蹬了个空。", "en": "No mud below either, and my trotters kick air."}
      ]
    }
  }
}
