  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "挥舞长角，向前移动。", "en": "Swing horns, move forward."},
        {"zh": "步履缓慢而坚定。", "en": "Walk slowly and firmly."},
        {"zh": "用长角扫过地面。", "en": "Swish horns over ground."},
        {"zh": "向前方投去凶狠目光。", "en": "Stare menacingly ahead."},
        {"zh": "挥动角，轻移脚步。", "en": "Swing horns, step gently."},
        {"zh": "我一步一步把土踩实。", "en": "I pack the soil down step by step."},
        {"zh": "我四蹄压过干裂的土。", "en": "My hooves press the cracked earth."},
        {"zh": "以沉重的步伐行走。", "en": "Walk with heavy steps."},
        {"zh": "用角触碰地面。", "en": "Tap ground with horns."},
        {"zh": "缓慢地移动头部。", "en": "Move head slowly."},
        {"zh": "两角向前，埋头推进", "en": "Horns forward, I push ahead."},
        {"zh": "颈盾擦过矮树丛", "en": "My frill scrapes through the brush."},
        {"zh": "四足压得地面发颤", "en": "My four feet make the ground tremble."},
        {"zh": "绕着领地边缘走一圈", "en": "I walk the edge of my territory."},
        {"zh": "鼻子喷出一口白气", "en": "A puff of breath leaves my snout."},
        {"zh": "短腿却走得很快", "en": "Short legs, but I move fast."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "懒洋洋地休息。", "en": "Rest lazily."},
        {"zh": "盯着猎物发呆。", "en": "Stare at prey."},
        {"zh": "张嘴露出獠牙。", "en": "Show fangs."},
        {"zh": "悠闲地吃草。", "en": "Eat grass leisurely."},
        {"zh": "舔舐自己的角。", "en": "Lick horns."},
        {"zh": "低头寻找食物。", "en": "Lower head for food."},
        {"zh": "发出低沉的呜呜声。", "en": "Rumble softly."},
        {"zh": "我甩掉角上的草屑。", "en": "I shake the grass off my horns."},
        {"zh": "咀嚼着青草。", "en": "Chew grass."},
        {"zh": "舔食身上的苔藓。", "en": "Lick moss off."},
        {"zh": "把角在树干上磨亮", "en": "I polish my horns on a trunk."},
        {"zh": "颈盾迎着阳光发亮", "en": "My frill brightens in the sun."},
        {"zh": "低头啃了几口蕨叶", "en": "I lower my head for a few fern bites."},
        {"zh": "耳朵转动，听着林子里", "en": "My ears swivel toward the trees."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "盯紧玩家的动作。", "en": "Focus on player."},
        {"zh": "三只角对着你，别靠近。", "en": "Three horns aimed at you — stay back."},
        {"zh": "靠近玩家。", "en": "Approach player."},
        {"zh": "用角指着玩家。", "en": "Point at player with horns."},
        {"zh": "我的角尖对着你的胸口。", "en": "My horn tip points at your chest."},
        {"zh": "发出警告的声音。", "en": "Give warning roar."},
        {"zh": "发出低吼，警告玩家。", "en": "Roar warning."},
        {"zh": "我从颈盾后面看你。", "en": "I watch you from behind my frill."},
        {"zh": "角低下来，你站得太近了。", "en": "Horns lowered — you're standing too close."},
        {"zh": "发出愤怒的咆哮。", "en": "Rumble angrily."},
        {"zh": "颈盾张开，显得更大", "en": "I flare my frill to look bigger."},
        {"zh": "前脚重重跺了一下", "en": "I stomp a forefoot hard."},
        {"zh": "从草丛后露出半张脸", "en": "Half my face shows above the grass."},
        {"zh": "盯着你看，一动不动", "en": "I stare at you without moving."},
        {"zh": "喉咙里滚出低鸣", "en": "A low rumble turns in my throat."},
        {"zh": "把身体横在你面前", "en": "I plant myself across your path."}
      ]
    },
