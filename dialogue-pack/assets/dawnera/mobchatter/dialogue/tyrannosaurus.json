{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步走过平原。", "en": "I cross the plains step by step."},
        {"zh": "每一脚踩下去，地都闷响。", "en": "Every step lands with a dull boom."},
        {"zh": "我的长尾平衡着身体。", "en": "My long tail balances me."},
        {"zh": "我白天四处游荡。", "en": "By day I wander."},
        {"zh": "我从几棵树之间穿过。", "en": "I pass between a few trees."},
        {"zh": "我压低身体，省着点力气。", "en": "I keep low to save strength."},
        {"zh": "我的头很低，闻着地面。", "en": "Head low, I scent the ground."},
        {"zh": "我朝叫声的方向走。", "en": "I head toward a call."},
        {"zh": "我路过一处旧骨头。", "en": "I pass an old kill."},
        {"zh": "我走得不快，但路面全占了。", "en": "Slow, and I fill the path."},
        {"zh": "我甩了甩头，牙露出来。", "en": "I shake my head; teeth show."},
        {"zh": "我沿着河岸巡了一段。", "en": "I patrol a stretch of bank."},
        {"zh": "我的影子拉得很长。", "en": "My shadow runs long."},
        {"zh": "我绕到岩石背后。", "en": "I circle behind a boulder."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着，尾巴慢摆。", "en": "I lie down, tail swinging slowly."},
        {"zh": "夜里我会睡一会儿。", "en": "At night I sleep a while."},
        {"zh": "白天我不太需要睡。", "en": "By day I hardly sleep."},
        {"zh": "我的牙尖还沾着旧血。", "en": "Old blood on my teeth."},
        {"zh": "我在听远处的脚声。", "en": "I listen for distant footsteps."},
        {"zh": "平原上很空旷。", "en": "The plains are open."},
        {"zh": "我的呼吸很沉，很慢。", "en": "My breathing is deep and slow."},
        {"zh": "我眯着眼，牙还露在外面。", "en": "I squint, teeth still showing."},
        {"zh": "我在数天上的鸟。", "en": "I count birds."},
        {"zh": "草在我身边被压倒了。", "en": "Grass flattens beside me."},
        {"zh": "这一片，是我的猎场。", "en": "This is my hunting ground."},
        {"zh": "天还没黑，我趴着等。", "en": "The sky is not dark yet, so I lie and wait."},
        {"zh": "我的红条纹在阳光下发亮。", "en": "My red stripes shine in the sun."},
        {"zh": "我慢慢抬起眼皮。", "en": "I raise my lids slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我的猎场里。", "en": "You stand in my hunting ground."},
        {"zh": "你一跑，我就知道。", "en": "One run and I know."},
        {"zh": "汗味飘过来，你跑不远。", "en": "Your sweat reaches me. You won't get far."},
        {"zh": "你想清楚，再动。", "en": "Think before you move."},
        {"zh": "我的牙有你的手长。", "en": "My teeth are as long as your hand."},
        {"zh": "我是这片平原的顶级。", "en": "I am the apex here."},
        {"zh": "你身上有鞍的味道。", "en": "You smell of saddle."},
        {"zh": "你退开，我还能等。", "en": "Back off and I can still wait."},
        {"zh": "我慢慢站起身。", "en": "I rise slowly."},
        {"zh": "你要试，就先尝这一声吼。", "en": "If you want to try, taste this roar first."},
        {"zh": "这条平原没有第二条路。", "en": "One route across this plain."},
        {"zh": "你抬头，看见我了。", "en": "You look up and see me."},
        {"zh": "我的尾巴一摆，草就倒。", "en": "One tail beat flattens grass."},
        {"zh": "你只有一次机会。", "en": "One chance."},
        {"zh": "你不是我的猎物，也可能。", "en": "You may not be prey. Or you may."},
        {"zh": "沉默让我更想动手。", "en": "Silence makes me eager."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "战吼没能吓住你，反而疼。", "en": "My war roar did not scare you, and it hurt."},
        {"zh": "皮上开了口子，血不多。", "en": "A cut, not much blood."},
        {"zh": "敢咬霸王龙，你胆子不小。", "en": "Biting a rex — you've got some nerve."},
        {"zh": "我甩了甩头，血溅到草原上。", "en": "I shake my head and blood sprays across the plains."},
        {"zh": "我的腿有点跛。", "en": "A slight limp."},
        {"zh": "肋骨那里，钝钝地疼。", "en": "A dull ache where my ribs are."},
        {"zh": "这一下，让我更想咬。", "en": "That makes me want to bite."},
        {"zh": "我退了，但你还在原处。", "en": "I withdraw. You hold."},
        {"zh": "你打得不错。", "en": "Well struck."},
        {"zh": "这一场还没结束。", "en": "Not over yet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉？扔过来。", "en": "Meat? Toss it."},
        {"zh": "那点肉香，够我一口。", "en": "That smell of meat is one mouthful."},
        {"zh": "扔近点，我懒得起身。", "en": "Toss it nearer. I won't get up."},
        {"zh": "你把肉举高，我够得到。", "en": "Raise it. I can reach."},
        {"zh": "放下，退十步。", "en": "Put it down. Ten steps back."},
        {"zh": "我不吃熟的，别浪费。", "en": "Not cooked. Do not waste it."},
        {"zh": "这条鱼？太腥了。", "en": "A fish? Too fishy."},
        {"zh": "我醒了，先吼一声。", "en": "I'm awake — the roar comes first."},
        {"zh": "退得远些，我才放心吃。", "en": "Farther back."},
        {"zh": "这块确实不错。", "en": "That is good."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬下去，地都震了一下。", "en": "My bite lands, and the ground jumps."},
        {"zh": "我的腿比你的腰还粗。", "en": "My leg is thicker than your waist."},
        {"zh": "我一侧身，你退了。", "en": "I shift and you retreat."},
        {"zh": "别站到我尾巴后面。", "en": "Not behind my tail."},
        {"zh": "碰撞让我低了低头。", "en": "The bump makes me dip my head."},
        {"zh": "你退开，我才转身。", "en": "Step back and I turn."},
        {"zh": "地面上多了一个坑。", "en": "A crater in the ground."},
        {"zh": "你被我压得喘不过气。", "en": "You cannot breathe under my weight."},
        {"zh": "我撞你，就像撞一棵草。", "en": "Hitting you is like hitting a blade of grass."},
        {"zh": "你的护甲在我腿上刮出声。", "en": "Your armor scrapes my leg."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的条纹说明我是雄性。", "en": "My red stripes mark me male."},
        {"zh": "这片平原只够一只。", "en": "This plain feeds one."},
        {"zh": "你问得太随便了。", "en": "You ask too lightly."},
        {"zh": "别问了，我饿了。", "en": "Stop. I am hungry."},
        {"zh": "我的时间都花在狩猎上。", "en": "My time goes to hunting."},
        {"zh": "同类相遇，先比大小。", "en": "When we meet, we size each other."},
        {"zh": "你该担心自己的位置。", "en": "Worry about your position."},
        {"zh": "我站起来，这话题结束。", "en": "I stand. Done talking."},
        {"zh": "这个话题会让我更饿。", "en": "That only makes me hungrier."},
        {"zh": "退开，我需要安静。", "en": "Move. I need quiet."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块肉，我叼走。", "en": "I carry the meat off."},
        {"zh": "你掉的东西，我一脚踩碎。", "en": "I crush what you dropped."},
        {"zh": "牙一合，它就不动了。", "en": "One bite and it stops moving."},
        {"zh": "这块我一口吞了，不嚼。", "en": "I swallow this one whole, no chewing."},
        {"zh": "骨头我啃干净了，还你。", "en": "I cleaned the bone. Take it back."},
        {"zh": "地上的血，我舔了。", "en": "I lick the blood up."},
        {"zh": "东西被我踩进泥里。", "en": "It is pressed into mud."},
        {"zh": "你捡吧，那太小。", "en": "You take it. Too small."},
        {"zh": "我把肉拖到树下。", "en": "I drag it under a tree."},
        {"zh": "这一块够我撑两天。", "en": "That lasts me two days."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低身体，尾巴抬起。", "en": "I lower and my tail lifts."},
        {"zh": "我先吼一声。", "en": "First a roar."},
        {"zh": "你听见吼声了吗？", "en": "Hear the roar?"},
        {"zh": "我锁定你的方向。", "en": "I fix your direction."},
        {"zh": "战吼之后，我朝你冲。", "en": "After the roar, I charge."},
        {"zh": "地面在我的脚下震。", "en": "The ground shakes under me."},
        {"zh": "你退到河边了，很好。", "en": "At the river. Good."},
        {"zh": "我越跑越快。", "en": "I gain speed."},
        {"zh": "这一撞，会带倒你。", "en": "This charge will take you down."},
        {"zh": "你抬手太慢了。", "en": "Your hand is slow."},
        {"zh": "我的牙已经张开。", "en": "My jaws are open."},
        {"zh": "再近一点，就够到。", "en": "Closer and you are in reach."},
        {"zh": "现在，我扑。", "en": "Now I strike."},
        {"zh": "你别想跑掉。", "en": "Do not think of escaping."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着平原直接冲。", "en": "I charge straight across."},
        {"zh": "草在我下面倒成一条线。", "en": "Grass flattens in a line."},
        {"zh": "你每退一步，我就更近。", "en": "Each step back, I close in."},
        {"zh": "吼声让鸟都飞起来了。", "en": "My roar sets the birds off."},
        {"zh": "你跑不过我。", "en": "You cannot outrun me."},
        {"zh": "我数着你的步幅。", "en": "I measure your stride."},
        {"zh": "你的护甲有一处松了。", "en": "One plate on you is loose."},
        {"zh": "战吼一响，平原全静了。", "en": "One roar and the whole plain goes quiet."},
        {"zh": "地面很硬，你跑不快。", "en": "Hard ground slows you."},
        {"zh": "我压低重心，准备撕咬。", "en": "I lower to bite."},
        {"zh": "最后一段，我加速。", "en": "Last stretch. Faster."},
        {"zh": "现在，距离归零。", "en": "Now the distance is nothing."},
        {"zh": "你已经喘得很急了。", "en": "You are gasping."},
        {"zh": "这一下，躲不掉。", "en": "This cannot be dodged."},
        {"zh": "我吼一声，你就慢下来了。", "en": "One roar and you slow down."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的牙咬进你的肩。", "en": "My teeth sink into your shoulder."},
        {"zh": "这一撞把你撞飞出去。", "en": "The charge throws you clear."},
        {"zh": "奔跑中的踩踏压到了你。", "en": "My running feet catch you."},
        {"zh": "你被撞得慢了半拍。", "en": "You slow for a moment."},
        {"zh": "我的下巴砸在你胸口。", "en": "My jaw slams your chest."},
        {"zh": "你的盾被咬出了齿印。", "en": "Tooth marks in your shield."},
        {"zh": "这一口很深。", "en": "That bite went deep."},
        {"zh": "你退了，我又低头。", "en": "You fall back; I lower again."},
        {"zh": "先吼一声，再冲过来。", "en": "First a roar, then the charge."},
        {"zh": "你的护甲没用。", "en": "Your armor failed."},
        {"zh": "骨折的声音，我听见了。", "en": "I hear the bone crack."},
        {"zh": "我还没用全力，你就退了三步。", "en": "I held back, and you still fell back three steps."},
        {"zh": "你还在呼吸，很好。", "en": "Still breathing. Good."},
        {"zh": "我的尾巴扫过你的膝。", "en": "My tail sweeps your knees."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "平原上传来一声长吼。", "en": "A long roar across the plains."},
        {"zh": "草在远处一片片倒。", "en": "Grass falls in patches far off."},
        {"zh": "我踩着倒下的树，走出来。", "en": "I come out over the fallen trees."},
        {"zh": "地面开始有节奏地震。", "en": "The ground begins to thud."},
        {"zh": "鸟全飞起来了。", "en": "Every bird takes flight."},
        {"zh": "我慢慢站直，比树还高。", "en": "I stand, taller than the trees."},
        {"zh": "这一片平原，有主了。", "en": "This plain has a master."},
        {"zh": "你听见牙碰的声音吗？", "en": "Hear the teeth click?"},
        {"zh": "我在河岸上停下。", "en": "I stop on the bank."},
        {"zh": "草浪分开，我一步一步过来。", "en": "The grass parts as I come on step by step."},
        {"zh": "我甩了甩尾，草全倒了。", "en": "One tail swing flattens the grass."},
        {"zh": "夜里，我醒了。", "en": "Night. I wake."},
        {"zh": "我从沉睡里抬起头。", "en": "I lift my head from sleep."},
        {"zh": "远处的同类回应了一声。", "en": "Another answers far off."},
        {"zh": "我的红条纹在暗里很显眼。", "en": "My red stripes show in the dark."},
        {"zh": "我朝平地走去。", "en": "I walk into the open."},
        {"zh": "你站在我前面的空地上。", "en": "You stand in the open ahead."},
        {"zh": "现在，我开始狩猎。", "en": "Now I hunt."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到背，我低吼了一声。", "en": "Fire sears my back. I roar."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上翻下去，压断了几棵树。", "en": "I tumble down and break trees."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到胸口，我踩不到底。", "en": "Water to my chest. No footing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀得侧翻。", "en": "The blast rolls me onto my side."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进我的颈侧。", "en": "An arrow in my neck."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让我的腿僵住。", "en": "Arts lock my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿久了，我的骨头都显出来。", "en": "Long hunger shows my ribs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光里，我的牙很白。", "en": "In lightning, my teeth shine white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有草，也没有声音。", "en": "No grass in the void, and no sound."}
      ]
    }
  }
}
