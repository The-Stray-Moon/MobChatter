{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土里拱出来一点。", "en": "I push a little way out of the soil."},
        {"zh": "我钻过腐叶下的软泥。", "en": "I bore through soft mud under rotted leaves."},
        {"zh": "泥土从我身上滚下去。", "en": "Soil rolls off me."},
        {"zh": "我沿着土层的缝钻。", "en": "I follow the seams in the soil."},
        {"zh": "我在地面下移动，看不见。", "en": "I travel under the surface."},
        {"zh": "我钻过一块松软的土。", "en": "I bore through loose earth."},
        {"zh": "我朝有腐叶的地方去。", "en": "I head toward rotted leaves."},
        {"zh": "我身后的土塌回原样。", "en": "The soil closes behind me."},
        {"zh": "我围着树根绕了一圈。", "en": "I circle a tree root."},
        {"zh": "土里一拱，往前挪半格。", "en": "One push through the soil, half a block on."},
        {"zh": "我钻到石缝下面去了。", "en": "I slip under a stone."},
        {"zh": "地面隆起一道细线。", "en": "A thin ridge lifts in the soil."},
        {"zh": "我从草丛下面穿过去。", "en": "I pass under the grass."},
        {"zh": "我往深处钻了一点。", "en": "I sink a little deeper."},
        {"zh": "我沿着湿土走，很省力。", "en": "Damp soil is easy to cross."},
        {"zh": "我从地里抬起身子。", "en": "I lift my body from the earth."},
        {"zh": "我绕着石块转了半圈。", "en": "I circle a stone half way."},
        {"zh": "我又沉回土里。", "en": "I sink back down."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘在土里，不动。", "en": "I coil in the soil, still."},
        {"zh": "土层下面很安静。", "en": "Quiet under the earth."},
        {"zh": "我在听上面有没有脚步。", "en": "I listen for footsteps above."},
        {"zh": "我的身体在慢慢蠕动。", "en": "My body creeps slowly."},
        {"zh": "土里有腐叶的味道。", "en": "Rotten leaves in the soil."},
        {"zh": "我的皮很湿，很凉。", "en": "My skin is damp and cool."},
        {"zh": "我盘成一个圈。", "en": "I coil into a ring."},
        {"zh": "我在等土温一点。", "en": "I wait for the soil to warm."},
        {"zh": "树根从我旁边穿过去。", "en": "A root passes beside me."},
        {"zh": "我在数头顶的声音。", "en": "I count sounds overhead."},
        {"zh": "我大部分身体还在地里。", "en": "Most of me is still underground."},
        {"zh": "我慢慢伸缩了一下。", "en": "I stretch once."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你感觉到了吗？脚下。", "en": "Feel that? Underfoot."},
        {"zh": "我就在这层土下面。", "en": "I am under this layer."},
        {"zh": "你看不见我，除非我出来。", "en": "You cannot see me unless I surface."},
        {"zh": "你踩的那块土是松的。", "en": "That soil is loose."},
        {"zh": "我听见你落地了。", "en": "I heard you land."},
        {"zh": "我很少到地面上来。", "en": "I rarely come up."},
        {"zh": "这条土道是我的。", "en": "This burrow is mine."},
        {"zh": "你的脚步声传得很深。", "en": "Your steps carry deep."},
        {"zh": "你别用手挖。", "en": "Do not dig with your hands."},
        {"zh": "我慢慢往上挪了。", "en": "I am moving up."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我断了一小截。", "en": "A small segment breaks off."},
        {"zh": "我缩回土里去了。", "en": "I pull back underground."},
        {"zh": "土被我搅乱了。", "en": "The soil is churned."},
        {"zh": "断口渗出泥水，我往深处缩。", "en": "Mud seeps from the break; I shrink deeper."},
        {"zh": "我不叫，土里没有声音。", "en": "I make no sound down here."},
        {"zh": "我慢慢地蠕回原处。", "en": "I creep back."},
        {"zh": "土从伤口灌进来，很沉。", "en": "Soil seeps into the wound, heavy."},
        {"zh": "我退了，土又盖回去。", "en": "I retreat; soil covers it."},
        {"zh": "这一下，让我缩得更深。", "en": "That drives me deeper."},
        {"zh": "掉下来的那截还在动。", "en": "The lost piece still moves."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐叶？这个正合适。", "en": "Rotten leaves? Perfect."},
        {"zh": "你把土翻开，我才会来。", "en": "Turn the soil and I will come."},
        {"zh": "我不吃活的，只吃烂的。", "en": "Not living things. Rotten ones."},
        {"zh": "这块东西还太新鲜。", "en": "Too fresh."},
        {"zh": "你把东西埋进土里吧。", "en": "Bury it."},
        {"zh": "我闻到了很重的土味。", "en": "Strong smell of earth."},
        {"zh": "这块太硬，我吞不下。", "en": "Too hard to swallow."},
        {"zh": "东西在土里，我就找得到。", "en": "In soil, I can find it."},
        {"zh": "我慢慢拱到它旁边。", "en": "I work my way over."},
        {"zh": "地上一动，我就缩回去。", "en": "One stir and I retreat."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我身上的土了。", "en": "You stepped on the soil above me."},
        {"zh": "你的脚陷进我的通道。", "en": "Your foot breaks into my tunnel."},
        {"zh": "我碰到你的靴底，缩回去了。", "en": "I touch your boot and pull back."},
        {"zh": "土层塌了一块。", "en": "A patch of soil caves."},
        {"zh": "我从土里钻出来，身上还带泥。", "en": "I come up from soil still earthy."},
        {"zh": "你把土踩实了，我难钻。", "en": "You packed the soil. Harder to move."},
        {"zh": "我绕着你的脚转了半圈。", "en": "I circle your foot."},
        {"zh": "这一下，你差点摔倒。", "en": "You nearly fell."},
        {"zh": "我退了，土还在动。", "en": "I retreat; the soil still moves."},
        {"zh": "别拿铲子插进来。", "en": "Do not put a spade in here."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "土里的事，土里说。", "en": "Earth matters stay in the earth."},
        {"zh": "我们产卵在湿土里。", "en": "We lay eggs in damp soil."},
        {"zh": "你问得太上面了。", "en": "You ask from too far above."},
        {"zh": "这一带只有我这一条。", "en": "Only one of me here."},
        {"zh": "别挖了，我下去了。", "en": "Stop digging. I am going down."},
        {"zh": "我盘起来，就是这个意思。", "en": "Coiling is my answer."},
        {"zh": "我的同类在更深的土里。", "en": "My kind are deeper."},
        {"zh": "土一压，什么都看不见。", "en": "Soil hides everything."},
        {"zh": "你该问问我的通道。", "en": "Ask about my tunnels."},
        {"zh": "我缩回土里，不答了。", "en": "I sink away. No answer."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这片腐叶，我拖进土里。", "en": "I drag the leaf down."},
        {"zh": "你掉的东西，被土盖住了。", "en": "Soil covers what you dropped."},
        {"zh": "这块东西，我用头顶进土。", "en": "I push this into the soil with my head."},
        {"zh": "泥土里，我只能一点点拱。", "en": "In the dirt I can only inch along."},
        {"zh": "我吞了一口土，里面有碎屑。", "en": "I swallow soil and crumbs."},
        {"zh": "这块东西有金属味。", "en": "That tastes of metal."},
        {"zh": "我把卵挪到更湿的土层。", "en": "I move eggs to wetter soil."},
        {"zh": "东西掉进我的通道里了。", "en": "It fell into my tunnel."},
        {"zh": "你挖吧，我不抢。", "en": "Dig it up. I will not take it."},
        {"zh": "这块留在土里，让它烂。", "en": "Leave it to rot."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "上面有脚步。", "en": "Footsteps above."},
        {"zh": "我开始往上挪。", "en": "I start moving up."},
        {"zh": "我锁定你站的位置。", "en": "I mark where you stand."},
        {"zh": "我的身体在土里收紧。", "en": "My body tightens in the soil."},
        {"zh": "我先从你后面出来。", "en": "I surface behind you."},
        {"zh": "你脚下的土变松了。", "en": "The soil loosens under you."},
        {"zh": "这一下，我从下面来。", "en": "This comes from below."},
        {"zh": "泥土下面，我数着你的脚步。", "en": "Under the soil, I count your steps."},
        {"zh": "你退到草边了，很好。", "en": "At the grass edge. Good."},
        {"zh": "我把头抬出地面。", "en": "I lift my head out of the soil."},
        {"zh": "现在，我拱上来。", "en": "Now I break through."},
        {"zh": "你不会听见我的。", "en": "You will not hear me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在地面下跟着你。", "en": "I follow beneath the surface."},
        {"zh": "土在我上面微微隆起。", "en": "The soil lifts where I pass."},
        {"zh": "你每走一步，我就近一寸。", "en": "Each step, I gain an inch."},
        {"zh": "草根在我旁边断开。", "en": "Roots part beside me."},
        {"zh": "我盘成一个圈，等你进来。", "en": "I coil a ring for you."},
        {"zh": "你听得见土在响吗？", "en": "Hear the soil shift?"},
        {"zh": "我在等你的重心落稳。", "en": "I wait for your weight to settle."},
        {"zh": "你脚下的地已经不实了。", "en": "The ground is hollow now."},
        {"zh": "我的通道绕着你。", "en": "My tunnel circles you."},
        {"zh": "再近一点，我就收紧。", "en": "A little closer and I tighten."},
        {"zh": "我不急，土里很凉快。", "en": "No hurry. It is cool down here."},
        {"zh": "现在，我缠上来。", "en": "Now I coil up."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土里钻出来，撞你。", "en": "I burst up and strike."},
        {"zh": "我从土里顶你的脚底。", "en": "I push up through the soil under your foot."},
        {"zh": "这一下不重，但会绊。", "en": "Not heavy, but it trips."},
        {"zh": "土和水一起甩到你身上。", "en": "Earth and water spray on you."},
        {"zh": "你摔了一下，我松开。", "en": "You fall; I release."},
        {"zh": "我用身体扫你的腿。", "en": "My body sweeps your legs."},
        {"zh": "我的皮很滑，抓不住我。", "en": "My skin slips through your grip."},
        {"zh": "这一下，你踩不到实处。", "en": "Now you cannot find footing."},
        {"zh": "我缩回土里，再出来。", "en": "I sink and surface again."},
        {"zh": "你退开，土落回原样。", "en": "You retreat; the soil settles."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "土层下面鼓起一个包。", "en": "A small hump swells in the soil."},
        {"zh": "土里有点动静。", "en": "Movement in the soil."},
        {"zh": "我从落叶下面钻出来。", "en": "I come up under the leaves."},
        {"zh": "你听见一声轻轻的沙沙。", "en": "A soft rustle."},
        {"zh": "土层塌了一个小洞。", "en": "A small hole opens."},
        {"zh": "我盘在树根旁边。", "en": "I coil by a root."},
        {"zh": "这一处土很松，是我翻的。", "en": "I loosened this soil."},
        {"zh": "我的身体先露出土面。", "en": "My body shows first."},
        {"zh": "地面在动，不是风。", "en": "The ground moves. Not wind."},
        {"zh": "我在你脚边钻出来。", "en": "I surface at your feet."},
        {"zh": "泥土落回我的洞里。", "en": "Soil falls back into my hole."},
        {"zh": "这一片土，归我翻。", "en": "I turn this soil."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤到土面，我往下缩。", "en": "Fire on the surface. I go down."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土里滚出来，落在草上。", "en": "I tumble out onto the grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进通道，我往上爬。", "en": "Water floods my tunnel."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把整层土掀开。", "en": "The blast opens the whole layer."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进土里，差一点。", "en": "An arrow in the soil, nearly."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让我的身体僵住。", "en": "Arts stiffen my body."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有腐叶，我越来越细。", "en": "No leaves and I grow thin."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打进土里，我全身一麻。", "en": "Lightning reaches me through soil."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "土层下面是空，我往下掉。", "en": "Nothing under the soil. I fall."}
      ]
    }
  }
}
