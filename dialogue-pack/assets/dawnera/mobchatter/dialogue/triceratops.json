{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踏着平原的草地走过。", "en": "I cross the plain, grass underfoot."},
        {"zh": "我的角盾很宽，挡着风。", "en": "My frill is wide; it blocks the wind."},
        {"zh": "我一步一步，地会震。", "en": "Each step shakes the ground."},
        {"zh": "我从蕨丛里挤过去。", "en": "I push through the ferns."},
        {"zh": "我沿着河边慢慢走。", "en": "I walk along the river."},
        {"zh": "我的尾巴甩着，赶走虫。", "en": "My tail swings off the flies."},
        {"zh": "我绕着一块巨石转了半圈。", "en": "I circle a boulder."},
        {"zh": "我停下，听林子里的响动。", "en": "I stop and listen to the woods."},
        {"zh": "我的蹄子压碎了枯枝。", "en": "My feet snap dry branches."},
        {"zh": "我朝远处的牛群走过去。", "en": "I head toward the herd."},
        {"zh": "我走得不快，但很有分量。", "en": "Unhurried, and heavy."},
        {"zh": "我从林边走到草地中央。", "en": "I move from the treeline to the middle."},
        {"zh": "我的影子比整棵树还宽。", "en": "My shadow is wider than a tree."},
        {"zh": "我在泥里踩出深坑。", "en": "My feet sink deep in mud."},
        {"zh": "我沿着老路走，走得很熟。", "en": "I follow the old path."},
        {"zh": "我挪开步子，朝蕨丛那边去。", "en": "I shift my step toward the ferns."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，慢慢嚼草。", "en": "I stand and chew grass."},
        {"zh": "我的角盾在阳光下很亮。", "en": "My frill is bright in the sun."},
        {"zh": "我在听远处的动静。", "en": "I listen to distant noise."},
        {"zh": "我的呼吸很粗，很慢。", "en": "My breathing is coarse and slow."},
        {"zh": "蝇子围着我的眼睛转。", "en": "Flies circle my eyes."},
        {"zh": "我卧下，把腿收起来。", "en": "I lie down and fold my legs."},
        {"zh": "这片草地，够我吃很久。", "en": "Enough grass here for a long while."},
        {"zh": "我甩了甩头，角碰出声。", "en": "I shake my head; horns clack."},
        {"zh": "我慢慢地反刍。", "en": "I chew my cud."},
        {"zh": "树影盖住我的背。", "en": "Shade covers my back."},
        {"zh": "我在等太阳偏西。", "en": "I wait for the sun to slope."},
        {"zh": "我抬头看了一眼天色。", "en": "I glance at the sky."},
        {"zh": "草根有点甜。", "en": "The roots are sweet."},
        {"zh": "我在数远处的同伴。", "en": "I count my companions."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "三只角都对着你的方向。", "en": "All three horns point your way."},
        {"zh": "我的角尖对着你。", "en": "My horn tips point at you."},
        {"zh": "你背着鞍，是想骑我吗？", "en": "You carry a saddle. Want to ride me?"},
        {"zh": "这处平原归我吃。", "en": "This plain is my grazing ground."},
        {"zh": "我的角盾有两米宽。", "en": "My frill is two meters wide."},
        {"zh": "你想骑我？先走近点。", "en": "Ride me? Come closer first."},
        {"zh": "你手里的鞍，我认得。", "en": "I know that saddle."},
        {"zh": "我不主动撞人，但会。", "en": "I do not charge first, but I can."},
        {"zh": "你退开，我继续吃草。", "en": "Back off and I keep grazing."},
        {"zh": "我的眼睛在角盾后面。", "en": "My eyes sit behind the frill."},
        {"zh": "鞍还在我背上，别乱碰。", "en": "The saddle is still on my back. Hands off."},
        {"zh": "三只角，两只对着你。", "en": "Three horns. Two are pointed at you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的角盾被撞了一下。", "en": "A blow lands on my frill."},
        {"zh": "我退了半步，地都震了。", "en": "Half a step shakes the ground."},
        {"zh": "角盾侧面又挨了一下。", "en": "Another blow to the side of my frill."},
        {"zh": "角盾上又添了一道白痕。", "en": "Another white scar on my frill."},
        {"zh": "皮很厚，但也破了。", "en": "Thick hide, and still cut."},
        {"zh": "角上缺了一块，鞍也歪了。", "en": "A chunk is missing from my horn and my saddle's crooked."},
        {"zh": "草叶上沾了我的血。", "en": "Grass wears my blood."},
        {"zh": "我甩了甩头，稳住了。", "en": "I shake my head and steady."},
        {"zh": "我朝你转过来。", "en": "I turn to you."},
        {"zh": "这一下，让我更想撞。", "en": "That makes me want to charge."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "蕨叶？这个我爱吃。", "en": "Fern fronds? My favorite."},
        {"zh": "你把草举高，我够得到。", "en": "Raise it. I can reach."},
        {"zh": "这一把太干了，不行。", "en": "Too dry."},
        {"zh": "放地上，我慢慢吃。", "en": "On the ground. I eat slowly."},
        {"zh": "我不吃果子和肉。", "en": "Not fruit. Not meat."},
        {"zh": "这块草很嫩，不错。", "en": "Tender. Good."},
        {"zh": "你手里的东西还在滴汁。", "en": "That is still dripping sap."},
        {"zh": "别晃，草会散。", "en": "Do not shake it."},
        {"zh": "这一把不够我一口。", "en": "Not one mouthful."},
        {"zh": "你拿着，我就跟着走。", "en": "Hold it and I will follow."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的角盾上。", "en": "You hit my frill."},
        {"zh": "我像一堵会走的墙。", "en": "I am a walking wall."},
        {"zh": "我一侧身，你就退了。", "en": "I shift and you retreat."},
        {"zh": "别站在我角的正前方。", "en": "Not in front of my horns."},
        {"zh": "我的肩一顶，你退了半格。", "en": "One shove of my shoulder, and you slide back half a block."},
        {"zh": "碰撞之后，我还站着。", "en": "After the bump, I stand."},
        {"zh": "地上被我们踩出两道痕。", "en": "Two lines in the grass."},
        {"zh": "你退开，我低下头。", "en": "You step back; I lower my head."},
        {"zh": "这一下，只是碰了一下。", "en": "That was only a brush."},
        {"zh": "你该离我的角远一些。", "en": "Stay clear of the horns."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "牛群里的事，由最强那头管。", "en": "The strongest of the herd decides."},
        {"zh": "我的角盾就是给对手看的。", "en": "The frill is for rivals."},
        {"zh": "我的角能做成鞍，你信吗？", "en": "My horns can be made into a saddle — believe it?"},
        {"zh": "这处平原上只有我一只。", "en": "Only one of me on this plain."},
        {"zh": "别问了，草更好谈。", "en": "Stop. Grass is easier."},
        {"zh": "角斗起来，声音传很远。", "en": "Horn fights carry far."},
        {"zh": "我只管吃草和走。", "en": "I mind grass and walking."},
        {"zh": "你站远些，别被卷进去。", "en": "Stand clear."},
        {"zh": "我把头低下去，不答。", "en": "I lower my head. No answer."},
        {"zh": "这话题我用尾巴扫掉。", "en": "My tail sweeps it away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这把草，我卷进嘴里。", "en": "I curl the grass into my mouth."},
        {"zh": "你掉的鞍带，我用角挑起。", "en": "I lift your dropped strap on a horn."},
        {"zh": "太重了，我顶一下。", "en": "Too heavy. I nudge it."},
        {"zh": "角上挂了点东西。", "en": "Something caught on my horn."},
        {"zh": "地上的根，我也吃。", "en": "I eat the roots too."},
        {"zh": "我把这东西推到一边。", "en": "I push it aside."},
        {"zh": "你的东西掉进泥里了。", "en": "Yours fell in the mud."},
        {"zh": "这块没味道。", "en": "No scent to this."},
        {"zh": "你捡吧，我不动。", "en": "Take it. I will not move."},
        {"zh": "我把它踩稳了。", "en": "I plant a foot on it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "三只角压低，对准你的腰。", "en": "Three horns dip, leveled at your waist."},
        {"zh": "你站在我的路上了。", "en": "You are in my path."},
        {"zh": "我开始刨地。", "en": "I paw the ground."},
        {"zh": "角盾对着你，退开。", "en": "Frill toward you. Move."},
        {"zh": "这一撞，我不打算收。", "en": "I will not hold back."},
        {"zh": "你退到树边了，不够。", "en": "By the tree. Not enough."},
        {"zh": "我的呼吸变重了。", "en": "My breathing deepens."},
        {"zh": "地面开始震，是我。", "en": "The ground shakes. That is me."},
        {"zh": "角度刚刚好。", "en": "The angle is right."},
        {"zh": "你要试，就来。", "en": "If you want to try, come."},
        {"zh": "我的前蹄抬起来了。", "en": "My foreleg lifts."},
        {"zh": "现在，我冲。", "en": "Now I charge."},
        {"zh": "这一下，你会记住。", "en": "You will remember this."},
        {"zh": "我锁定了你的胸口。", "en": "I mark your chest."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "三只角，一步步压过去。", "en": "Three horns, step by step, I push forward."},
        {"zh": "我的角分开前面的草。", "en": "My horns part the grass."},
        {"zh": "你每退一步，地就响一次。", "en": "Each step back, the ground speaks."},
        {"zh": "我数着距离。", "en": "I measure the distance."},
        {"zh": "你站在平地上，没有遮挡。", "en": "Flat ground. No cover."},
        {"zh": "我慢慢转成侧身。", "en": "I turn broadside."},
        {"zh": "角盾挡住了你的视线。", "en": "My frill blocks your view."},
        {"zh": "我听得见你的呼吸。", "en": "I hear your breathing."},
        {"zh": "你退到河边了，没路了。", "en": "At the river. No path."},
        {"zh": "再近一步，就进角下。", "en": "One step more and you are under the horn."},
        {"zh": "我停下来，先看准。", "en": "I stop to aim."},
        {"zh": "现在，我不停了。", "en": "Now I do not stop."},
        {"zh": "三只角和你的木棍比一比。", "en": "Three horns against your little stick."},
        {"zh": "还有两步，我加速。", "en": "Two steps. I accelerate."},
        {"zh": "我低下头，角尖就位。", "en": "Head low. Horns set."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的角撞在你胸口。", "en": "My horns hit your chest."},
        {"zh": "这一下把你顶开三格。", "en": "That knocks you three blocks."},
        {"zh": "角盾一甩，你退了。", "en": "My frill swings; you retreat."},
        {"zh": "前蹄踏下去，土飞起来。", "en": "My foreleg stamps; earth sprays."},
        {"zh": "你挡住了角，没挡住重量。", "en": "You stopped the horns, not the weight."},
        {"zh": "这一撞把枯枝踩断。", "en": "That charge snaps dead branches."},
        {"zh": "我退开，重新低头。", "en": "I withdraw and lower again."},
        {"zh": "你的护甲凹了一块。", "en": "Your armor dents."},
        {"zh": "这一下，我也晃了。", "en": "That shook me too."},
        {"zh": "你还站着，很好。", "en": "Still standing. Good."},
        {"zh": "我的鼻子在喘。", "en": "My nostrils flare."},
        {"zh": "这回我用的是角尖。", "en": "This time I used the tips."},
        {"zh": "草地被我们压平了。", "en": "The grass is flattened."},
        {"zh": "这一下，够了。", "en": "That is enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "平原上多了一道影子。", "en": "A new shadow on the plain."},
        {"zh": "我慢慢从树后走出来。", "en": "I walk out from behind the trees."},
        {"zh": "草被压开一条宽路。", "en": "A wide path presses in the grass."},
        {"zh": "你听见沉重的蹄声。", "en": "Heavy footsteps."},
        {"zh": "角盾从蕨丛上露出来。", "en": "A frill shows above the ferns."},
        {"zh": "我从干涸的河床走上来。", "en": "I climb out of the dry riverbed."},
        {"zh": "这一片草地，有主了。", "en": "This grass has a master."},
        {"zh": "我甩了甩头，角发出声。", "en": "I shake my head; horns clack."},
        {"zh": "我慢慢走到水边。", "en": "I walk to the water."},
        {"zh": "蝇子先到，我后到。", "en": "Flies first, then me."},
        {"zh": "我低下头，开始吃草。", "en": "I lower my head and graze."},
        {"zh": "远处的同伴叫了一声。", "en": "A companion calls far off."},
        {"zh": "我的蹄子踩实了地面。", "en": "My feet press the earth."},
        {"zh": "你转身时，我已经到了。", "en": "I am there when you turn."},
        {"zh": "我把影子投在你身上。", "en": "My shadow falls on you."},
        {"zh": "这一处，归我吃。", "en": "I graze here."},
        {"zh": "我从林边慢慢走进开阔地。", "en": "I move from the trees into the open."},
        {"zh": "角盾在朝阳里发亮。", "en": "My frill catches the sunrise."},
        {"zh": "我先看看，再决定。", "en": "I look first, then decide."},
        {"zh": "现在，你看见我了。", "en": "Now you see me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到背，我甩了甩尾。", "en": "Fire on my back; my tail swings."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滑下，站不稳。", "en": "I slide down the slope."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到胸口，我走不动。", "en": "Water to my chest. I stall."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀得侧过去。", "en": "The blast tips me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进角盾的边。", "en": "An arrow sticks in the frill's edge."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让我的腿发沉。", "en": "Arts weigh down my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有草，我瘦了。", "en": "No grass and I thin."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在角盾上，很响。", "en": "Lightning on my frill. Loud."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下平原裂开，下面是空。", "en": "The plain splits to void."}
      ]
    }
  }
}
