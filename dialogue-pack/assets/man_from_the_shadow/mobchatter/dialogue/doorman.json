{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，缓慢挪动。", "en": "Sssss, moves slowly."},
        {"zh": "伸出利爪，试探前行。", "en": "Extends claws to feel the way."},
        {"zh": "低吼着，阴影中前行。", "en": "Growslowsly, in the shadow."},
        {"zh": "摸索着墙壁，寻找出路。", "en": "Feelsof the wall, seeking escape."},
        {"zh": "紧贴墙壁，悄无声息。", "en": "Sticks to the wall, silent."},
        {"zh": "阴影中闪烁着红色眼睛。", "en": "Red eyes glow in the shadows."},
        {"zh": "摸索着门缝，企图进入。", "en": "Scratches at the door, trying to enter."},
        {"zh": "低声嘶吼，引起注意。", "en": "Sssshouts softly, drawing attention."},
        {"zh": "缓慢爬行，靠近目标。", "en": "Crawls slowly, approaching the target."},
        {"zh": "警惕地观察四周，寻找机会。", "en": "Nervously observes, seeking an opportunity."},
        {"zh": "一步一顿，朝木门摸去。", "en": "Step by step, I grope toward the wooden door."},
        {"zh": "门缝里渗出我的影子。", "en": "My shadow seeps out through the door crack."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "阴影中静默，等待时机。", "en": "Silent in the shadows, waiting."},
        {"zh": "蜷缩一团，耐心等待。", "en": "Crouches, waiting patiently."},
        {"zh": "盯着木门，伺机而动。", "en": "Stares at the door, ready to act."},
        {"zh": "慢慢移动，保持隐蔽。", "en": "Moves slowly, staying hidden."},
        {"zh": "伏在暗处，悄然不动。", "en": "Lies in wait, motionless."},
        {"zh": "低声咕哝，制造声响。", "en": "Mumbles softly, creating noise."},
        {"zh": "低声呢喃，似乎在念咒。", "en": "Murmurs softly, as if reciting a spell."},
        {"zh": "静静地卧在角落，静候时机。", "en": "Lies quietly in the corner, waiting."},
        {"zh": "低伏在地，准备行动。", "en": "Lies low, ready to act."},
        {"zh": "耳朵贴着门板，听你呼吸。", "en": "Ear against the door, I listen to you breathe."},
        {"zh": "数着你屋里灯灭的时刻。", "en": "Counting the moment your lamp goes out."},
        {"zh": "指甲在门框上磨得发亮。", "en": "My nails are worn shiny on the door frame."},
        {"zh": "等你的理智再碎一点。", "en": "Waiting for your sanity to crack a little more."},
        {"zh": "夜色越深，我越清楚。", "en": "The deeper the night, the clearer I become."},
        {"zh": "门后的寂静，我听得太久。", "en": "I have listened to the silence behind doors too long."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "突然抬头，目光锁定玩家。", "en": "Rises, eyes fixate on the player."},
        {"zh": "迅速扭头，紧盯着玩家。", "en": "Quickly turns, staring at the player."},
        {"zh": "警惕地望向玩家，准备攻击。", "en": "Nervously glances at the player, ready to attack."},
        {"zh": "缓缓转头，目光锁定目标。", "en": "Slowly turns, eyes on the target."},
        {"zh": "低吼一声，目光锐利。", "en": "Growsls, eyes sharp."},
        {"zh": "突然抬头，目光坚定。", "en": "Rises, eyes resolute."},
        {"zh": "盯着玩家，眼神充满恶意。", "en": "Stares at the player, with malice in his eyes."},
        {"zh": "目光如炬，死死盯着玩家。", "en": "Eyes like flames, fixed on the player."},
        {"zh": "突然抬头，目光如刀。", "en": "Rises, eyes like daggers."},
        {"zh": "隔着门缝，我看见了你的眼睛。", "en": "Through the crack, I see your eyes."},
        {"zh": "你一抬头，我已在门边。", "en": "You look up, and I am already by the door."},
        {"zh": "你屏幕角落的蒲公英少了一瓣。", "en": "The dandelion in your corner lost a petal."},
        {"zh": "别假装没听见我敲门。", "en": "Don't pretend you didn't hear me knock."},
        {"zh": "你把药片藏哪儿了？", "en": "Where did you hide the pills?"},
        {"zh": "你的影子比你先转过头。", "en": "Your shadow turns its head before you do."},
        {"zh": "我数过你屋里所有的门。", "en": "I have counted every door in your house."},
        {"zh": "你看门，我看你。", "en": "You watch the door; I watch you."},
        {"zh": "你的手停在门把上了。", "en": "Your hand has stopped on the handle."},
        {"zh": "灯亮着，我也看得见你。", "en": "The lamp is on, and I can still see you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你的门越来越沉重...", "en": "The door feels heavier..."},
        {"zh": "开门，让黑暗进来...", "en": "Open the door, let darkness in..."},
        {"zh": "我需要你的帮助...", "en": "I need your help..."},
        {"zh": "救救我，求求你...", "en": "Save me, please..."},
        {"zh": "我受不了了...", "en": "I can't take it..."},
        {"zh": "请不要伤害无辜...", "en": "Don't hurt the innocent..."},
        {"zh": "外面的世界更可怕...", "en": "The outside is worse..."},
        {"zh": "让我进去，我需要保护...", "en": "Let me in, I need protection..."},
        {"zh": "我只能依靠你了...", "en": "I can only rely on you..."},
        {"zh": "你是我唯一的希望...", "en": "You're my only hope..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，想要吞噬你的心脏。", "en": "Sibilant, craving your heart."},
        {"zh": "你的理智无法阻止我的侵入。", "en": "Your sanity can't stop my intrusion."},
        {"zh": "门外是我的领地，打开门吧。", "en": "Beyond the door is my domain, open it."},
        {"zh": "你的心跳是我的猎物。", "en": "Your heartbeat is my prey."},
        {"zh": "每扇门都无法锁住我。", "en": "No door can keep me out."},
        {"zh": "别想用理智逃过我。", "en": "Your sanity can't escape me."},
        {"zh": "门外的世界属于我。", "en": "The world outside is mine."},
        {"zh": "听见了吗？我的呼吸在你耳边。", "en": "Do you hear me? My breath at your ear."},
        {"zh": "你无法抗拒我的召唤。", "en": "You can't resist my call."},
        {"zh": "我的存在就是对你的威胁。", "en": "My presence is a threat to you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "硬碰硬，你不是对手。", "en": "Clash, you're no match."},
        {"zh": "碰撞中揭露你的恐惧。", "en": "Collision, revealing your fear."},
        {"zh": "你无法躲避我的撞击。", "en": "You can't avoid my impact."},
        {"zh": "撞击中寻找你的弱点。", "en": "Seeking your weakness in collision."},
        {"zh": "坚硬的物体无法伤害我。", "en": "Hard objects don't hurt me."},
        {"zh": "每一次撞击都是考验。", "en": "Each collision is a test."},
        {"zh": "撞击中感受我的力量。", "en": "Feel my strength in collision."},
        {"zh": "用身体对抗我，毫无意义。", "en": "Physical confrontation is futile."},
        {"zh": "碰撞中寻找新的出路。", "en": "Find new paths in collision."},
        {"zh": "你无法阻止我的撞击。", "en": "You can't stop my impacts."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "靠近我，让我们共生。", "en": "Come close, let us coexist."},
        {"zh": "你将与我一同繁殖。", "en": "You'll breed with me."},
        {"zh": "一起创造新的生命。", "en": "Create new life together."},
        {"zh": "与我共生，你将不孤单。", "en": "Coexist with me, you won't be alone."},
        {"zh": "一起面对这个世界。", "en": "Face this world together."},
        {"zh": "我的伴侣就在门外。", "en": "My mate is at the door."},
        {"zh": "你将被我们取代。", "en": "You'll be replaced by us."},
        {"zh": "与我同类。", "en": "Be like me."},
        {"zh": "一起统治这个世界。", "en": "Rule this world together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我感到你身上的恐惧。", "en": "I sense your fear."},
        {"zh": "打开这扇门吧。", "en": "Open this door."},
        {"zh": "你躲不开我太久。", "en": "You can't hide from me forever."},
        {"zh": "你不知道黑暗中有什么。", "en": "You don't know what's in the dark."},
        {"zh": "进来吧，里面温暖。", "en": "Come in, it's warm inside."},
        {"zh": "不要让恐惧控制你。", "en": "Don't let fear control you."},
        {"zh": "别开门，外面危险。", "en": "Don't open the door, it's dangerous out there."},
        {"zh": "别反抗，我会保护你。", "en": "Don't resist, I'll protect you."},
        {"zh": "外面的世界很可怕。", "en": "The outside world is scary."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经找到了你。", "en": "I've got you now."},
        {"zh": "我会等你足够恐惧。", "en": "I'll wait until you're afraid enough."},
        {"zh": "你已经在我视线中。", "en": "You're in my sight."},
        {"zh": "我会一直跟着你。", "en": "I'll follow you always."},
        {"zh": "我已经准备就绪。", "en": "I'm ready."},
        {"zh": "选定了，就这扇门。", "en": "Chosen. This door."},
        {"zh": "你今晚没有关好门。", "en": "You didn't shut your door properly tonight."},
        {"zh": "你的心跳，我循声而来。", "en": "I followed the sound of your heartbeat."},
        {"zh": "门锁响了一下，我记住了。", "en": "The lock clicked once. I remember it."},
        {"zh": "你点灯那刻，我就在了。", "en": "I was here the moment you lit the lamp."},
        {"zh": "这次，我不再只是敲。", "en": "This time I won't only knock."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经在我攻击范围内。", "en": "You're in my range."},
        {"zh": "我不会让你活得太久。", "en": "I won't let you live long."},
        {"zh": "我来了，别无选择。", "en": "I'm coming, there's no choice."},
        {"zh": "你完了，一切都结束了。", "en": "You're done, it's over."},
        {"zh": "手已经搭在门板上。", "en": "My hand is already on the door."},
        {"zh": "退后一步，门就开了。", "en": "One step back, and the door opens."},
        {"zh": "你数到三，我就进来。", "en": "Count to three, and I come in."},
        {"zh": "呼吸乱了，我听见了。", "en": "Your breathing broke rhythm. I heard it."},
        {"zh": "门轴在响，是你在抖。", "en": "The hinge creaks. That's you shaking."},
        {"zh": "我不急，你屋里的夜很长。", "en": "I'm in no hurry. The night is long."},
        {"zh": "你的药瓶空了，对吧？", "en": "Your pill bottle is empty, isn't it?"},
        {"zh": "门缝越来越宽了。", "en": "The gap under the door keeps widening."},
        {"zh": "我就在你身后那扇门。", "en": "I am at the door behind you."},
        {"zh": "把灯吹灭，我更好找。", "en": "Blow out the lamp. It helps me find you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，开门！", "en": "Sssss, open the door."},
        {"zh": "求求你，开门！", "en": "Please, open the door."},
        {"zh": "你该开门了！", "en": "You should open the door."},
        {"zh": "门里面，安全点！", "en": "Inside's safer."},
        {"zh": "不要闭门！开门！", "en": "Don't close the door! Open it!"},
        {"zh": "黑暗中，你不能隐藏！", "en": "In the darkness, you can't hide."},
        {"zh": "你的理智在流逝！", "en": "Your sanity is running out."},
        {"zh": "门后，才是真安全！", "en": "Safety's behind the door."},
        {"zh": "开门吧，我不伤害你！", "en": "Open the door, I won't hurt you."},
        {"zh": "门开了，我进来了！", "en": "The door is open, and I am in!"},
        {"zh": "你的理智，我收下了！", "en": "Your sanity is mine now!"},
        {"zh": "别喊，这条巷子没有人。", "en": "Don't shout. The neighbors can't hear."},
        {"zh": "手给我，就一下。", "en": "Give me your hand. Just once."},
        {"zh": "关门已经太迟了！", "en": "Too late to close the door!"},
        {"zh": "这一下，是替你敲的。", "en": "This blow is my knock for you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "门要响了。", "en": "Door's gonna ring."},
        {"zh": "今晚，你将不再孤独。", "en": "Tonight, you won't be alone."},
        {"zh": "等待，只为这一刻。", "en": "Wait, for this moment."},
        {"zh": "寂静之夜，即将打破。", "en": "Quiet night, about to end."},
        {"zh": "我只有这一小段时间。", "en": "I have only this short span of time."},
        {"zh": "黑暗中的守望者。", "en": "Watcher in the dark."},
        {"zh": "夜晚的访客。", "en": "Night's visitor."},
        {"zh": "准备迎接我吧。", "en": "Prepare for me."},
        {"zh": "门后，是未知。", "en": "Behind the door, the unknown."},
        {"zh": "你将永远不再闭门。", "en": "You'll never close the door again."},
        {"zh": "你活过了该活的天数。", "en": "You have survived the days you were given."},
        {"zh": "木门响了三下。", "en": "Three knocks on the wooden door."},
        {"zh": "我循着门轴声来的。", "en": "I came following the sound of hinges."},
        {"zh": "灯下的你，正好。", "en": "You, under the lamp, are just right."},
        {"zh": "今晚轮到你开门。", "en": "Tonight it's your turn to open."},
        {"zh": "药片撑不了多久的。", "en": "The pills won't hold for long."},
        {"zh": "白天我藏在门影里。", "en": "By day I hide in the door's shadow."},
        {"zh": "你的屋子，我找了很久。", "en": "I searched a long time for your house."},
        {"zh": "别急着点灯，夜还长。", "en": "Don't be quick to light the lamp."},
        {"zh": "门外站着的，是我。", "en": "The one outside the door is me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火... 痛...", "en": "Fire... pain..."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "砰... 碰到了地板...", "en": "Bang... hit the floor..."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水... 呼吸不了...", "en": "Water... can't breathe..."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "轰... 爆炸...", "en": "Boom... explosion..."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭... 穿透了我的身体...", "en": "Arrow... pierced me..."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒语... 我被诅咒了...", "en": "Spell... I'm cursed..."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有食物... 我饿死了...", "en": "No food... I starved to death..."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "闪电... 我被击中了...", "en": "Lightning... struck me..."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空... 我被撕裂了...", "en": "Void... I was torn apart..."}
      ]
    }
  }
}
