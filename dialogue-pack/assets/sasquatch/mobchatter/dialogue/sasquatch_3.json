{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "红眼睛在暗处移动", "en": "Red eyes move through the dark."},
        {"zh": "我一走进林子，虫就不叫了", "en": "Insects go silent when I enter."},
        {"zh": "松枝在我身下折断", "en": "Pine branches snap beneath me."},
        {"zh": "我的脚步声能传一里", "en": "My footsteps carry a mile."},
        {"zh": "我不再压着怒气", "en": "I no longer hold the anger down."},
        {"zh": "毛发根根竖着", "en": "Every hair stands up."},
        {"zh": "猎塔的木板被我掀翻了", "en": "I flipped the tower's planks."},
        {"zh": "铁路被我的脚印盖住", "en": "My prints cover the railway ties."},
        {"zh": "我走着，地都在抖", "en": "The ground trembles as I walk."},
        {"zh": "身前身后都是我的味道", "en": "My scent is all around."},
        {"zh": "我不躲了，也不需要", "en": "I won't hide, and needn't."},
        {"zh": "我走过猎人营地，什么都没留下", "en": "I crossed the hunter camp and left nothing."},
        {"zh": "每一步都在告诉你我来了", "en": "Every step announces me."},
        {"zh": "这片林子已经记不清安静的样子", "en": "These pines no longer recall silence."},
        {"zh": "我的背毛上结着血块", "en": "Clotted blood mats the fur on my back."},
        {"zh": "红眼睛一直没眨", "en": "These red eyes haven't blinked."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，怒气从毛里冒出来", "en": "I stand, rage rising through my fur."},
        {"zh": "红眼睛在黑里最亮", "en": "Red eyes are brightest in the dark."},
        {"zh": "我的拳头一直握着", "en": "My fists stay clenched."},
        {"zh": "探测器早就没声了", "en": "The detector has gone quiet."},
        {"zh": "你最好离基地远一点", "en": "You'd best get far from your base."},
        {"zh": "我不需要睡，愤怒撑着", "en": "I need no sleep; rage holds me up."},
        {"zh": "林子里的动物都跑了", "en": "The forest's animals have all fled."},
        {"zh": "我在数还有几个活人", "en": "Counting how many are still alive."},
        {"zh": "你听见树倒的声音了吗", "en": "Did you hear the tree fall?"},
        {"zh": "我压不住这个了", "en": "I can't hold this back."},
        {"zh": "脚下的松针都焦了", "en": "The pine needles under me are scorched."},
        {"zh": "红眼睛看你一眼就够", "en": "One look from these red eyes is enough."},
        {"zh": "我不再是刚才那个", "en": "I'm not the one from before."},
        {"zh": "这片林子只剩下我", "en": "Only I remain in these pines."},
        {"zh": "等着，我快来了", "en": "Wait; I'm nearly there."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "看到红眼睛，就该跑", "en": "See red eyes? Run."},
        {"zh": "我再不会躲起来", "en": "I don't hide anymore."},
        {"zh": "你的基地我看得见", "en": "I can see your base."},
        {"zh": "你的同伴还在里面", "en": "Your companions are still inside."},
        {"zh": "你踩断的每根松枝，我都听见。", "en": "I hear every pine twig you snap."},
        {"zh": "这次没有第二次机会", "en": "There's no second chance."},
        {"zh": "你手抖得厉害", "en": "Your hands are shaking badly."},
        {"zh": "灯照不到我的脸", "en": "The lamp won't find my face."},
        {"zh": "我笑了，你看不出来", "en": "I'm smiling; you can't tell."},
        {"zh": "松林会记住今晚", "en": "The pines will remember tonight."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这一下，让我更疯了", "en": "That made me wilder."},
        {"zh": "血顺着毛往下滴", "en": "Blood drips down the fur."},
        {"zh": "我吼了一声，整片林子都响", "en": "My roar echoed through the pines."},
        {"zh": "你打中了，很好", "en": "You hit me; good."},
        {"zh": "我一步也不后退", "en": "I don't retreat."},
        {"zh": "红眼睛更亮了", "en": "The red eyes burn brighter."},
        {"zh": "疼痛只是燃料", "en": "Pain is only fuel."},
        {"zh": "这个味道，我用红眼睛记住了。", "en": "That smell is burned into my red eyes."},
        {"zh": "这种伤还不够", "en": "This wound isn't enough."},
        {"zh": "你只剩一次机会", "en": "You have one chance left."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举着东西，还想谈", "en": "You hold something up, still bargaining."},
        {"zh": "我不吃活人喂的", "en": "I don't eat from the living's hand."},
        {"zh": "扔地上，然后退开", "en": "Drop it and back away."},
        {"zh": "你退得不够远", "en": "You're not far enough."},
        {"zh": "这点东西填不了我的怒气", "en": "That can't fill my rage."},
        {"zh": "我饿，但不是饿这个", "en": "I'm hungry, but not for this."},
        {"zh": "你的手在抖，我看着", "en": "Your hands shake; I'm watching."},
        {"zh": "我不再接受任何好意", "en": "I accept no kindness now."},
        {"zh": "那味道让我更烦", "en": "That smell irritates me more."},
        {"zh": "别举高，我不喜欢", "en": "Don't raise it; I dislike it."},
        {"zh": "你放下的东西，我会踩烂", "en": "I'll trample what you set down."},
        {"zh": "快点，我耐性已经没了", "en": "Hurry; my patience is gone."},
        {"zh": "这点东西换不来今晚", "en": "That won't buy tonight."},
        {"zh": "我不饿，我想撕东西", "en": "I'm not hungry; I want to tear."},
        {"zh": "收起来，我讨厌它", "en": "Put it away; I hate it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我，等于撞断一棵老松", "en": "Hitting me is hitting an old pine."},
        {"zh": "我的胸口很硬", "en": "My chest is hard."},
        {"zh": "这一撞，你的骨头该响了", "en": "That should have made your bones ring."},
        {"zh": "红眼睛凑近了", "en": "The red eyes came close."},
        {"zh": "你退到树干上了", "en": "You're against a trunk."},
        {"zh": "我的毛蹭了你一脸", "en": "My fur brushed your face."},
        {"zh": "再撞一下，我就不客气", "en": "Once more and I won't hold back."},
        {"zh": "撞上我，你会先听见松林的寂静。", "en": "Bump into me, and the pines go silent first."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我现在只剩怒气", "en": "Only anger is left in me."},
        {"zh": "别跟我提这种事", "en": "Don't bring that up."},
        {"zh": "红眼睛看的是猎物", "en": "These red eyes look at prey."},
        {"zh": "你站得够远了", "en": "You're far enough now."},
        {"zh": "我连自己都控制不住", "en": "I can't even control myself."},
        {"zh": "林子里的东西都躲着我", "en": "Everything in the forest avoids me."},
        {"zh": "我不想听你说", "en": "I don't want to hear it."},
        {"zh": "你该跑，不是问这个", "en": "You should run, not ask this."},
        {"zh": "我记不得从前", "en": "I don't recall before."},
        {"zh": "你走吧，现在就", "en": "Go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把东西捏成了碎片", "en": "I crushed it to pieces."},
        {"zh": "太用力，捡不起来", "en": "Too strong; I can't pick it up."},
        {"zh": "地上那点，我用脚踢开", "en": "I kick aside what's on the ground."},
        {"zh": "我捡起来，闻了闻", "en": "I pick it up and sniff."},
        {"zh": "这不是我要的", "en": "This isn't what I want."},
        {"zh": "我把它扔进林子", "en": "I throw it into the pines."},
        {"zh": "猎人留下的东西，都归我", "en": "Hunters' leavings are mine."},
        {"zh": "我踩过去，它就碎了", "en": "I step on it and it breaks."},
        {"zh": "手抖，抓不稳", "en": "My hands shake; I can't grip."},
        {"zh": "你也想捡它？", "en": "You want to pick it up too?"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "红眼睛看到你了", "en": "The red eyes have found you."},
        {"zh": "我再也不会退", "en": "I won't step back again."},
        {"zh": "这一次不谈条件", "en": "No negotiating this time."},
        {"zh": "林子已经让开", "en": "The forest has made way."},
        {"zh": "你的基地我会去", "en": "I'll visit your base."},
        {"zh": "先把你解决掉", "en": "You first."},
        {"zh": "我的吼声你听过吗", "en": "Have you heard my roar?"},
        {"zh": "你可以跑，我更快", "en": "Run if you like; I'm faster."},
        {"zh": "今晚不会有人来救你", "en": "No one's coming tonight."},
        {"zh": "我就数到一个数", "en": "I'll count to one."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低身子，扑过来", "en": "I crouch and lunge."},
        {"zh": "红眼睛一直没离开", "en": "The red eyes never leave."},
        {"zh": "你退到营地边缘了", "en": "You're at the camp's edge."},
        {"zh": "那里也不安全", "en": "That's not safe either."},
        {"zh": "围栏已经被我拆了", "en": "I tore down the fence."},
        {"zh": "你的同伴在喊你", "en": "Your companions are calling."},
        {"zh": "别回应，会引来我", "en": "Don't answer; it brings me."},
        {"zh": "松针上的血迹是你的", "en": "The blood on the needles is yours."},
        {"zh": "你们营地那道墙，我一步就跨过。", "en": "One stride carries me over your camp wall."},
        {"zh": "你已经没地方去了", "en": "Nowhere left to go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一巴掌，你整个人飞了", "en": "One swipe sends you flying."},
        {"zh": "爪子划过，很深", "en": "The claws cut deep."},
        {"zh": "这一拳带着所有的怒气", "en": "This fist carries all my rage."},
        {"zh": "树被我撞倒了", "en": "I knocked a tree down."},
        {"zh": "你听见自己骨头的声音", "en": "You heard your own bones."},
        {"zh": "红眼睛就在你眼前", "en": "The red eyes are right before you."},
        {"zh": "我绝不会停手", "en": "I don't stop."},
        {"zh": "林子又静下来了", "en": "The forest goes quiet again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "红眼睛先亮起来", "en": "The red eyes light up first."},
        {"zh": "林子一下安静到底", "en": "The forest falls completely silent."},
        {"zh": "我从松林深处走出来", "en": "I walk out from deep in the pines."},
        {"zh": "愤怒已经涨满", "en": "The anger is full."},
        {"zh": "你该离基地远一点", "en": "You should be far from your base."},
        {"zh": "猎人留下的东西都被我拆了", "en": "I've torn apart what the hunters left."},
        {"zh": "这是我的最后阶段", "en": "This is my final stage."},
        {"zh": "我一步一步，很慢", "en": "I come slowly, step by step."},
        {"zh": "脚下的松针开始焦", "en": "The pine needles beneath me scorch."},
        {"zh": "今晚，没有谁能藏着", "en": "Tonight, no one hides."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛烧起来了，我照样往前", "en": "My fur's on fire; I still advance."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，砸断了树枝", "en": "I fell and snapped branches."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "河水灌进鼻孔，连怒气都沉了。", "en": "River water fills my nostrils, and even my rage sinks."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我推得倒退几步", "en": "The blast pushed me back a few steps."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "东西扎在身上，我拔了出来", "en": "Something struck me; I pulled it out."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这力量让我的怒气更乱", "en": "This force muddles my rage."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得发晕，但愤怒撑着", "en": "Hunger blurs me, but rage holds."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈焦了树，也劈焦了毛", "en": "Lightning scorched the trees and my fur."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我什么都抓不住", "en": "Nothing below; I can grab nothing."}
      ]
    }
  }
}
