{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的步子把落叶踩碎", "en": "My steps crush the fallen leaves."},
        {"zh": "愤怒托着我走，很沉", "en": "Anger carries my steps; heavy."},
        {"zh": "松林里的鸟都不叫了", "en": "Not a bird calls in the pines."},
        {"zh": "我比上次高了一点", "en": "I've grown a little since last time."},
        {"zh": "肩上的毛结成了块", "en": "The fur on my shoulders mats."},
        {"zh": "我不再绕路，我直走", "en": "No more circling; I walk straight."},
        {"zh": "树干被我撞开", "en": "I shove the trunks aside."},
        {"zh": "每走一步，呼吸就更粗", "en": "With each step, my breath roughens."},
        {"zh": "猎塔的木桩被我拔了", "en": "I pulled the tower's stakes."},
        {"zh": "铁路的枕木被踩断", "en": "I crush the railway ties."},
        {"zh": "我的影子越来越长", "en": "My shadow grows longer."},
        {"zh": "林子里有我留下的凹陷", "en": "I leave hollows in the ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在忍，忍得很辛苦", "en": "I'm holding back, and it's hard."},
        {"zh": "愤怒让我站不稳", "en": "Anger makes my stance unsteady."},
        {"zh": "我握拳，关节在响", "en": "I clench; my knuckles crack."},
        {"zh": "探测器响得更急了", "en": "The detector ticks faster."},
        {"zh": "我闻到你身上的恐惧", "en": "I smell fear on you."},
        {"zh": "上一个人跑得比你快", "en": "The last one ran faster than you."},
        {"zh": "我的眼睛开始发红", "en": "My eyes are starting to redden."},
        {"zh": "林子的安静是假的", "en": "The forest's quiet is false."},
        {"zh": "我数着自己的呼吸", "en": "I count my own breaths."},
        {"zh": "这块地被我的脚压塌", "en": "My weight sinks this ground."},
        {"zh": "我随时都会动起来", "en": "I could move at any moment."},
        {"zh": "你看不到我，但你感觉得到", "en": "You can't see me, but you feel me."},
        {"zh": "我的脚印比上次深", "en": "My prints are deeper than last time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看我，眼睛里全是血丝", "en": "You look at me; your eyes are bloodshot."},
        {"zh": "这次我不打算放过你", "en": "This time I don't plan to let you go."},
        {"zh": "我的眼睛已经红了", "en": "My eyes have gone red."},
        {"zh": "你已经站错了地方", "en": "You've stood in the wrong place."},
        {"zh": "我不再躲树后了", "en": "I no longer hide behind trees."},
        {"zh": "你的灯在抖得很厉害", "en": "Your lamp is shaking badly."},
        {"zh": "我撕过比你还硬的东西", "en": "I've torn things harder than you."},
        {"zh": "你退一次，我近两步", "en": "One step back from you, two forward from me."},
        {"zh": "这片林子开始替我叫了", "en": "The forest is starting to shout for me."},
        {"zh": "你手上的伤，还没好吧", "en": "Your hand's still hurt, isn't it?"},
        {"zh": "你再往后退就撞树了", "en": "Step back again and you'll hit a tree."},
        {"zh": "那次你没走成", "en": "Last time you didn't make it out."},
        {"zh": "我不急，愤怒会等我", "en": "I'm not rushed; anger waits."},
        {"zh": "你还剩一口气的时间", "en": "You have one breath's time."},
        {"zh": "我不会再给你机会", "en": "I won't give you another chance."},
        {"zh": "别喊，林子会把声音吞掉", "en": "Don't shout; the forest swallows it."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你这一下，刚好把怒气放出来。", "en": "That blow of yours just let the rage out."},
        {"zh": "我吼了一声，林子都在抖", "en": "I roared; the forest shook."},
        {"zh": "你成功惹火了我", "en": "You've succeeded in angering me."},
        {"zh": "我退了半步，又上前一步", "en": "I stepped back, then forward again."},
        {"zh": "这点伤，我会还回去", "en": "I'll return this wound."},
        {"zh": "我手上的毛被削掉一片", "en": "A patch of fur is sheared from my hand."},
        {"zh": "林子也在替我疼", "en": "The forest aches with me."},
        {"zh": "你再打一下试试", "en": "Strike once more."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我现在不想吃", "en": "I don't want to eat now."},
        {"zh": "你放下的东西，会烂在那儿", "en": "What you set down will rot there."},
        {"zh": "愤怒比饿更厉害", "en": "Anger beats hunger."},
        {"zh": "你拿食物手都在抖", "en": "Your hands shake holding food."},
        {"zh": "我不接受你的好意", "en": "I won't accept your kindness."},
        {"zh": "这点东西买不了你的命", "en": "That won't buy your life."},
        {"zh": "我吃林子里的，不吃你的", "en": "I eat the forest's food, not yours."},
        {"zh": "拿开，我快控制不住了", "en": "Move it; I'm barely holding back."},
        {"zh": "你还在谈条件", "en": "You're still bargaining."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的肋骨像树根", "en": "My ribs are like roots."},
        {"zh": "你被弹回到地上", "en": "You landed back on the ground."},
        {"zh": "这回我推了你一把", "en": "This time I shoved you."},
        {"zh": "碰撞让我的愤怒又涨了", "en": "The bump fed my anger."},
        {"zh": "你踩进我踩出的坑", "en": "You stepped into my footprint hollow."},
        {"zh": "我一伸手，你就退了", "en": "One reach and you backed off."},
        {"zh": "树都被我撞断了", "en": "I broke a tree on the way."},
        {"zh": "别碰我身上的毛", "en": "Don't touch my fur."},
        {"zh": "再往前一步，你会卡在我肋骨上。", "en": "One more step and you will jam against my ribs."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我现在只想撕东西", "en": "I only want to tear things now."},
        {"zh": "愤怒里没有别的", "en": "There's nothing else in anger."},
        {"zh": "你别站那么近", "en": "Don't stand that close."},
        {"zh": "我不记得那种事了", "en": "I don't remember such things."},
        {"zh": "松林里只有我和怒气", "en": "Only me and my rage in these pines."},
        {"zh": "你找错的时候了", "en": "You picked the wrong moment."},
        {"zh": "连我自己都怕自己", "en": "Even I fear myself."},
        {"zh": "我现在不能好好说话", "en": "I can't talk properly now."},
        {"zh": "你会被我伤到", "en": "You'd get hurt by me."},
        {"zh": "你快点给我走开", "en": "Walk away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把东西捏碎了", "en": "I crushed it in my hand."},
        {"zh": "太用力了，捡不起来", "en": "Too much force; can't pick it up."},
        {"zh": "这块布上有血", "en": "There's blood on this cloth."},
        {"zh": "我捡了，然后扔了", "en": "I picked it up, then threw it."},
        {"zh": "愤怒让我的手不听话", "en": "Anger makes my hands disobey."},
        {"zh": "地上有猎人的靴子", "en": "A hunter's boot on the ground."},
        {"zh": "我把它撕成两半", "en": "I tore it in two."},
        {"zh": "我闻了闻，没兴趣", "en": "I sniffed; no interest."},
        {"zh": "别弯腰，我看着你", "en": "Don't bend down; I'm watching."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "这已经足够了", "en": "Enough."},
        {"zh": "我把耐心用完了", "en": "I've run out of patience."},
        {"zh": "从你进林子起，我就在等这一刻", "en": "I've waited since you entered."},
        {"zh": "这回先动手的是我", "en": "This time I strike first."},
        {"zh": "你听见那声吼了吗", "en": "Did you hear that roar?"},
        {"zh": "树上的雪都被震下来了", "en": "The snow shook off the trees."},
        {"zh": "你的灯已经灭了", "en": "Your lamp went out."},
        {"zh": "愤怒已经压不住", "en": "The anger can't be contained."},
        {"zh": "我要让你记住松林", "en": "I'll make you remember these pines."},
        {"zh": "你退到铁路上，也没用", "en": "Retreat to the rails; it won't help."},
        {"zh": "我比上次更重", "en": "I'm heavier than before."},
        {"zh": "这一圈，我收紧", "en": "This circle, I tighten."},
        {"zh": "林子都站在我这边", "en": "The forest sides with me."},
        {"zh": "别想着跟我谈判", "en": "Don't think of negotiating."},
        {"zh": "我不需要知道", "en": "I don't need to know."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低身体，准备扑", "en": "I lower my body, ready to lunge."},
        {"zh": "你听，那是我在呼吸", "en": "Hear that? That's me breathing."},
        {"zh": "树干上全是新的抓痕", "en": "Fresh claw marks on the trunks."},
        {"zh": "我不再走弧线了", "en": "I'm done with curves."},
        {"zh": "你身后的路被我堵了", "en": "I've blocked the way behind you."},
        {"zh": "猎塔的梯子被我拆了", "en": "I tore down the tower ladder."},
        {"zh": "你在数呼吸，我也在", "en": "You count breaths; so do I."},
        {"zh": "我的呼吸比较慢", "en": "Mine are slower."},
        {"zh": "火光照不到我的位置", "en": "The firelight doesn't reach me."},
        {"zh": "我越生气，个头越大。", "en": "The angrier I get, the bigger I grow."},
        {"zh": "找不到也没用", "en": "It won't help if you find it."},
        {"zh": "这片林子我熟得像自己的手掌", "en": "I know this forest like my own palm."},
        {"zh": "你走的是死路", "en": "You're on a dead-end path."},
        {"zh": "再往左一步就到沟里", "en": "One step left and you're in the ravine."},
        {"zh": "我等你掉下去", "en": "I'll wait for you to fall."},
        {"zh": "或者我自己来", "en": "Or I'll do it myself."},
        {"zh": "天已经完全黑了", "en": "It's fully dark now."},
        {"zh": "你现在只剩下我", "en": "All that's left is me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "这一掌，把你扇倒", "en": "This palm knocks you down."},
        {"zh": "我抓住你的腰带", "en": "I grab your belt."},
        {"zh": "你被甩到树干上", "en": "You're thrown into a trunk."},
        {"zh": "爪子划过你的肩膀", "en": "Claws rake your shoulder."},
        {"zh": "这回我用两只手", "en": "Both hands this time."},
        {"zh": "你听见骨裂的声音", "en": "You heard the bone split."},
        {"zh": "我把你按在落叶里", "en": "I press you into the leaves."},
        {"zh": "我的愤怒都在这一拳", "en": "All my anger is in this fist."},
        {"zh": "你根本没法站稳", "en": "You can't find footing."},
        {"zh": "这片松林又安静了", "en": "The pines go quiet again."},
        {"zh": "我打得比你想象的快", "en": "I'm faster than you think."},
        {"zh": "你再挡一次试试", "en": "Try blocking again."},
        {"zh": "树都被撞断了两根", "en": "Two trees broke on the way."},
        {"zh": "你身上全是泥", "en": "You're covered in mud."},
        {"zh": "我还没有尽兴", "en": "I'm not satisfied yet."},
        {"zh": "但我也不想再打了", "en": "But I don't want more either."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我的愤怒到了新的一层", "en": "My anger has reached a new level."},
        {"zh": "眼睛先红起来", "en": "My eyes redden first."},
        {"zh": "林子静得连虫都不叫", "en": "The forest is silent, not even insects."},
        {"zh": "探测器响成一串", "en": "The detector ticks in a stream."},
        {"zh": "我比上次更高了", "en": "I'm taller than before."},
        {"zh": "松针落在我肩上", "en": "Pine needles land on my shoulders."},
        {"zh": "猎人留下的痕迹被我抹掉", "en": "I erase what the hunters left."},
        {"zh": "我从铁路那头过来", "en": "I come from the railway side."},
        {"zh": "这片林子已经归我", "en": "These pines are already mine."},
        {"zh": "你听见远处的吼声了吗", "en": "Did you hear the roar far off?"},
        {"zh": "那声音不是雷", "en": "That isn't thunder."},
        {"zh": "我踩下去，土都陷", "en": "The soil sinks under my foot."},
        {"zh": "这一次，我不打算藏", "en": "This time I won't hide."},
        {"zh": "你进林子的时候我就醒了", "en": "I woke when you entered."},
        {"zh": "地上的脚印变大了", "en": "The prints on the ground grew."},
        {"zh": "天黑了，正合适", "en": "It's dark; perfect."},
        {"zh": "你还有时间跑", "en": "You still have time to run."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎掉了毛，皮更硬了", "en": "Fire burned off fur; the hide beneath is harder."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从坡上滚下去，撞断两棵树", "en": "I rolled down and broke two trees."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水呛进喉咙，我猛咳", "en": "Water in my throat; I coughed hard."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀翻在落叶上", "en": "The blast flipped me into the leaves."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西插进我的臂膀", "en": "Something stuck in my arm."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这力量钻进骨头里", "en": "This force gets into my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿了很久，力气在退", "en": "Hungry too long; strength fading."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈断树，也烫到我的背", "en": "Lightning split a tree and scorched my back."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没东西，我抓了个空", "en": "Nothing below; I grabbed at nothing."}
      ]
    }
  }
}
