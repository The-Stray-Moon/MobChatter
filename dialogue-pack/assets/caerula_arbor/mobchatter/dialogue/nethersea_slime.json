{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢往前推。", "en": "I push forward slowly."},
        {"zh": "身体在地上摊开又收拢。", "en": "My body spreads and gathers."},
        {"zh": "每挪一寸都要很久。", "en": "Each inch takes a long time."},
        {"zh": "黏液在身后拖出一条痕。", "en": "Slime trails behind me."},
        {"zh": "我一点也不赶时间。", "en": "I'm in no hurry."},
        {"zh": "水面上的光晃得我难受。", "en": "The glare on the water bothers me."},
        {"zh": "我滑过湿润的石头。", "en": "I slide over wet stone."},
        {"zh": "身子一晃一晃地走。", "en": "I wobble along."},
        {"zh": "潮水退了，我也能走。", "en": "Low tide, and I can still move."},
        {"zh": "我的速度只有这么点。", "en": "This is the whole of my speed."},
        {"zh": "我试着爬上浅坡。", "en": "I try climbing the shallow slope."},
        {"zh": "再往前一点就到水里。", "en": "A little further and I reach water."},
        {"zh": "我的边缘黏在泥上。", "en": "My edge sticks to the mud."},
        {"zh": "一步要花很久。", "en": "One step takes a long while."},
        {"zh": "我不需要什么速度。", "en": "I don't need speed."},
        {"zh": "我沿着石缝慢慢渗。", "en": "I seep along the rock seam."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我摊在那儿不动。", "en": "I lie spread out and still."},
        {"zh": "体内有东西在缓缓流动。", "en": "Something flows slowly inside me."},
        {"zh": "我抖了一下表面。", "en": "My surface shivers once."},
        {"zh": "阳光让我变薄。", "en": "Sunlight thins me."},
        {"zh": "我没有肺，靠渗水活着。", "en": "I have no lungs; I live by seeping water."},
        {"zh": "黏液表面映着天。", "en": "My surface reflects the sky."},
        {"zh": "我等它自己走到我这儿。", "en": "I wait for it to come to me."},
        {"zh": "这身东西太软了。", "en": "This body is far too soft."},
        {"zh": "太阳一晒，我就往里收。", "en": "When the sun hits, I draw inward."},
        {"zh": "潮声在很远的地方。", "en": "The surf sounds far away."},
        {"zh": "我感觉到地的震动。", "en": "I feel the ground shake."},
        {"zh": "空气里有股咸味。", "en": "There's salt in the air."},
        {"zh": "我慢慢舒展开。", "en": "I slowly spread out."},
        {"zh": "就这样待着就好。", "en": "Just staying like this."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩在我旁边了。", "en": "You stepped beside me."},
        {"zh": "我只有一点点大。", "en": "I'm only a little thing."},
        {"zh": "你别拿脚试我。", "en": "Don't test me with your foot."},
        {"zh": "你低头找我的时候，我就在脚边。", "en": "While you look down for me, I'm right at your feet."},
        {"zh": "我没什么可给你的。", "en": "I have nothing to give you."},
        {"zh": "你也太看得起我了。", "en": "You overestimate me."},
        {"zh": "我身上有海的味道。", "en": "The sea is in my scent."},
        {"zh": "你想踩就踩吧。", "en": "Stomp on me if you must."},
        {"zh": "我还在慢慢长大。", "en": "I'm still growing."},
        {"zh": "别把我和普通史莱姆弄混。", "en": "Don't mistake me for an ordinary slime."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被压得扁扁的。", "en": "I'm squashed flat."},
        {"zh": "身体少了一块。", "en": "A piece of me is gone."},
        {"zh": "我的边缘重新贴合。", "en": "My edges knit back together."},
        {"zh": "痛感很少，但我知道。", "en": "Little pain, but I notice."},
        {"zh": "黏液开始变稀。", "en": "My slime is thinning."},
        {"zh": "我往阴影里缩。", "en": "I shrink toward the shade."},
        {"zh": "我散开又收拢。", "en": "I scatter, then draw in."},
        {"zh": "这一下比我的力气大太多。", "en": "That's far beyond my strength."},
        {"zh": "我还在，你别急。", "en": "I'm still here; don't rush."},
        {"zh": "再打我就没了。", "en": "One more hit and I'm gone."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那个，有咸味吗？", "en": "Does that thing in your hand taste of salt?"},
        {"zh": "我朝那味道慢慢渗过去。", "en": "I seep slowly toward that smell."},
        {"zh": "软的硬的，我都裹进去。", "en": "Soft or hard, I wrap it all in."},
        {"zh": "它比我大好多。", "en": "It's much bigger than me."},
        {"zh": "我包不住这么大的。", "en": "I can't wrap around something that big."},
        {"zh": "搁到地上，我才够得着。", "en": "Put it on the ground so I can reach."},
        {"zh": "我的身体在往里陷。", "en": "My body is sinking inward."},
        {"zh": "一点碎屑就行。", "en": "A few crumbs are enough."},
        {"zh": "我试着伸出一部分。", "en": "I try to extend a part of myself."},
        {"zh": "等它自己落下。", "en": "Let it fall on its own."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我踩扁了一点。", "en": "You flattened me a little."},
        {"zh": "我身上的黏液沾到你了。", "en": "My slime got on you."},
        {"zh": "我不疼，只是变形了。", "en": "It doesn't hurt; I just deform."},
        {"zh": "被踩散的部分又黏回身上。", "en": "The part you squashed sticks back onto me."},
        {"zh": "你踩上去会滑。", "en": "You'll slip if you step there."},
        {"zh": "黏液留在地上了。", "en": "Slime stays on the ground."},
        {"zh": "我缩回去了一半。", "en": "Half of me drew in."},
        {"zh": "你走得比我快多了。", "en": "You move far faster than I do."},
        {"zh": "别把我推到石头外。", "en": "Don't push me off the stone."},
        {"zh": "我会自己慢慢挪开。", "en": "I'll shift away on my own."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们不需要这个。", "en": "We don't need that."},
        {"zh": "我只想找块湿地。", "en": "I just want a wet patch."},
        {"zh": "身体还太小了。", "en": "My body is still too small."},
        {"zh": "我连动都费劲。", "en": "Even moving is hard work."},
        {"zh": "别挤过来，我会散开。", "en": "Don't press close; I'll spread out."},
        {"zh": "潮水在退，我得挪。", "en": "The tide is going out; I must move."},
        {"zh": "我不明白你在问什么。", "en": "I don't follow what you're asking."},
        {"zh": "等我长大一些。", "en": "When I'm bigger."},
        {"zh": "我更喜欢安静。", "en": "I prefer quiet."},
        {"zh": "这件事就这样吧。", "en": "Let's leave it."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把东西包进去。", "en": "I wrap it inside me."},
        {"zh": "它慢慢陷进我身体里。", "en": "It slowly sinks into my body."},
        {"zh": "不知道能不能消化。", "en": "Don't know if I can digest it."},
        {"zh": "有点硬，我含一会儿。", "en": "Hard; I'll hold it a while."},
        {"zh": "我把它推着走。", "en": "I push it along."},
        {"zh": "它比我的身体还重。", "en": "This weighs more than I do."},
        {"zh": "刚才它动了一下。", "en": "It moved."},
        {"zh": "含不住，我吐回泥地上。", "en": "I can't hold it; I spit it back on the mud."},
        {"zh": "黏液裹住了它。", "en": "Slime coats it."},
        {"zh": "别让它掉进石缝。", "en": "Don't let it fall into the crevice."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西撞到我。", "en": "Something bumped into me."},
        {"zh": "我只能慢慢靠近。", "en": "I can only creep closer."},
        {"zh": "我的力气很小。", "en": "My strength is tiny."},
        {"zh": "但我会一直跟着。", "en": "But I'll keep following."},
        {"zh": "身体往那边聚。", "en": "My body gathers that way."},
        {"zh": "我感觉到震动。", "en": "I feel vibrations."},
        {"zh": "就往那个方向。", "en": "That direction."},
        {"zh": "它踩出的震动我全记着。", "en": "I remember every tremor of its steps."},
        {"zh": "我贴过去就好。", "en": "I just need to touch it."},
        {"zh": "一点点也就够了。", "en": "A little is enough."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一点点挪过去。", "en": "I ooze over bit by bit."},
        {"zh": "它不知道我在跟着。", "en": "It doesn't know I'm following."},
        {"zh": "我的速度只有这么慢。", "en": "My speed is this slow."},
        {"zh": "但我不会停下来。", "en": "But I won't stop."},
        {"zh": "黏液痕迹还连着。", "en": "The slime trail still connects."},
        {"zh": "我贴到石头边。", "en": "I cling to the stone edge."},
        {"zh": "它在往我这边来。", "en": "It's coming my way."},
        {"zh": "我压扁自己，藏起来。", "en": "I flatten myself to hide."},
        {"zh": "我还能再渗过去一点。", "en": "Wait a bit more."},
        {"zh": "它已经停下来了。", "en": "It stopped."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞上去，很轻。", "en": "I bump it; weakly."},
        {"zh": "黏液糊了它一脸。", "en": "Slime smears across its face."},
        {"zh": "我只造成两点伤害。", "en": "I only deal two points."},
        {"zh": "但我贴住了它。", "en": "But I'm stuck to it."},
        {"zh": "它把我抖下来。", "en": "It shakes me off."},
        {"zh": "我的身体分出一块。", "en": "A piece separates from me."},
        {"zh": "它踩我，我黏住它脚。", "en": "It steps on me and I stick."},
        {"zh": "这点力量不算什么。", "en": "This strength means little."},
        {"zh": "可我还黏在这里。", "en": "But I'm still here."},
        {"zh": "你别嫌我烦人。", "en": "Don't say I'm a nuisance."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从浅洼里冒出来。", "en": "I well up from a shallow puddle."},
        {"zh": "这里干得厉害。", "en": "It's very dry here."},
        {"zh": "我的体积小得可怜。", "en": "My mass is pitifully small."},
        {"zh": "先找一块湿地。", "en": "First, find a wet patch."},
        {"zh": "潮水刚刚退去。", "en": "The tide just went out."},
        {"zh": "我慢慢地摊开。", "en": "I slowly spread out."},
        {"zh": "四周有石头和盐。", "en": "Stones and salt all around."},
        {"zh": "我还在适应这里。", "en": "I'm still adjusting."},
        {"zh": "这个身体刚成形。", "en": "This body just formed."},
        {"zh": "潮气把我凝成一小团。", "en": "The damp air has gathered me into a small blob."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，我就缩小了一圈。", "en": "Fire sears me and I shrink a size."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石头上掉下去，摊开了。", "en": "I fell off the stone and splattered."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "泡在水里，我薄得像一层膜。", "en": "Soaked, I thin out like a film."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我甩成碎片。", "en": "The blast scattered me to bits."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有个硬东西穿过我。", "en": "Something hard passed through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的黏液翻腾。", "en": "The spell churns my slime."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我越来越薄了。", "en": "I grow thinner and thinner."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电穿过我，我缩成一团。", "en": "Lightning passed through; I curled tight."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在往下滴，停不住。", "en": "I'm dripping downward and can't stop."}
      ]
    }
  }
}
