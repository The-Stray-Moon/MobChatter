{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "四蹄陷进湿泥里。", "en": "Four hooves sink into the wet mud."},
        {"zh": "背上的菌褶在抖。", "en": "Fungal frills shiver on my back."},
        {"zh": "慢慢走到水边。", "en": "Slowly toward the water."},
        {"zh": "尾巴甩掉水珠。", "en": "My tail flicks off the water."},
        {"zh": "每走一步都挤出水。", "en": "Every step squeezes out water."},
        {"zh": "哞——低低的一声。", "en": "Moo — a low, wet sound."},
        {"zh": "颈上的皮在发亮。", "en": "My neck hide shines damp."},
        {"zh": "沿着滩涂踱步。", "en": "Pacing along the flats."},
        {"zh": "蹄子踩碎贝壳。", "en": "Hooves crunch the shells."},
        {"zh": "鼻子喷出咸气。", "en": "I snort salt air."},
        {"zh": "背上的东西在长大。", "en": "The growth on my back thickens."},
        {"zh": "绕过一块礁石。", "en": "Rounding a rock."},
        {"zh": "走得很慢，很稳。", "en": "Slow and steady."},
        {"zh": "肚子垂着水草。", "en": "Waterweed hangs from my belly."},
        {"zh": "一步步挪向村里。", "en": "Trudging toward the village."},
        {"zh": "湿草被压成一条路。", "en": "Wet grass flattens into a trail."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我嚼着咸草。", "en": "I chew salty grass."},
        {"zh": "背上的菌在呼吸。", "en": "The growth on my back breathes."},
        {"zh": "一只眼睛看向海。", "en": "One eye turns to the sea."},
        {"zh": "甩甩耳朵上的水。", "en": "I shake water from my ears."},
        {"zh": "站定，慢慢反刍。", "en": "Standing still, slow cud."},
        {"zh": "身边飞来小虫。", "en": "Small flies gather around me."},
        {"zh": "皮下的东西动了一下。", "en": "Something moves beneath my hide."},
        {"zh": "远处的村庄还有烟。", "en": "Smoke still rises from the village."},
        {"zh": "我舔了舔鼻梁。", "en": "I lick my muzzle."},
        {"zh": "我的腿有点僵。", "en": "My legs have gone stiff."},
        {"zh": "潮水已经退去了。", "en": "The tide has gone out."},
        {"zh": "低低地叫一声。", "en": "A low call, once."},
        {"zh": "草从蹄缝里长出来。", "en": "Grass sprouts between my hooves."},
        {"zh": "我把头低下。", "en": "I lower my head."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你闻起来像人。", "en": "You smell like a person."},
        {"zh": "站那儿别动。", "en": "Stand there. Don't move."},
        {"zh": "我认得村庄的味道。", "en": "I know the smell of a village."},
        {"zh": "你的手是暖的。", "en": "Your hands are warm."},
        {"zh": "我不再是牛了。", "en": "I'm not a cow anymore."},
        {"zh": "你也是它们的食物。", "en": "You're their food too."},
        {"zh": "别摸我的背。", "en": "Don't touch my back."},
        {"zh": "潮水来了你就跑。", "en": "When the tide comes, run."},
        {"zh": "哞，我警告一次。", "en": "Moo. That's your one warning."},
        {"zh": "你的村子在那边。", "en": "Your village is that way."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "皮破了，流白水。", "en": "My hide split, leaking pale fluid."},
        {"zh": "哞，这一下真疼。", "en": "Moo. That really hurts."},
        {"zh": "我晃了两下。", "en": "I staggered twice."},
        {"zh": "背上的菌在缩。", "en": "The growth on my back shrinks."},
        {"zh": "腿软了一下。", "en": "My legs gave a little."},
        {"zh": "流出来的血是温的。", "en": "The blood is warm."},
        {"zh": "别打我的角。", "en": "Not the horns."},
        {"zh": "四条腿还撑得住。", "en": "Four legs still hold me."},
        {"zh": "这不是牛该受的。", "en": "No cow should take this."},
        {"zh": "它们会记住你的。", "en": "They'll remember you."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那捆草很嫩。", "en": "That bundle of grass is tender."},
        {"zh": "盐块，那个我要。", "en": "Salt. I want it."},
        {"zh": "放在地上吧。", "en": "Put it on the ground."},
        {"zh": "我闻到粮仓味。", "en": "I smell a granary."},
        {"zh": "这个能吃，我知道。", "en": "I know this can be eaten."},
        {"zh": "你手再伸长些，我够得着。", "en": "Reach a little farther and I can get it."},
        {"zh": "别急着把手收回去。", "en": "Don't pull your hand back yet."},
        {"zh": "蘑菇的味道？", "en": "The smell of mushrooms?"},
        {"zh": "我很久没吃过好的。", "en": "I haven't eaten well in ages."},
        {"zh": "那把草，推到蹄边来。", "en": "Push that bundle of grass to my hooves."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "别顶我的肚子。", "en": "Don't butt my belly."},
        {"zh": "你撞得我一晃。", "en": "You set me swaying."},
        {"zh": "退开，我要走了。", "en": "Move. I'm walking on."},
        {"zh": "湿皮很滑吧。", "en": "My hide is slippery, isn't it."},
        {"zh": "别抓我的角。", "en": "Don't grab my horn."},
        {"zh": "蹄子会踩到你。", "en": "My hooves will find you."},
        {"zh": "这里泥太深。", "en": "The mud is deep here."},
        {"zh": "挤过来做什么。", "en": "Why crowd me?"},
        {"zh": "我背上的东西碰不得。", "en": "Don't touch what's on my back."},
        {"zh": "你身上沾了泥。", "en": "You're covered in mud now."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "海嗣不需要伴侣。", "en": "Seaborn need no partners."},
        {"zh": "我身体里有别的东西。", "en": "There's something else inside me."},
        {"zh": "我身上的东西不答应。", "en": "The thing inside me refuses."},
        {"zh": "你先站远一点。", "en": "Stand farther off first."},
        {"zh": "哞，别再往下说了。", "en": "Moo. Say no more."},
        {"zh": "这身皮里的事，别提。", "en": "Don't speak of what's under this hide."},
        {"zh": "我身上长着别人的东西。", "en": "Something else grows on me."},
        {"zh": "这东西会传染的。", "en": "This thing spreads."},
        {"zh": "等潮水退去。", "en": "Wait for the tide to fall."},
        {"zh": "我记不住这些。", "en": "I can't hold on to this."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这草能咽下去。", "en": "This grass will go down."},
        {"zh": "捡起一块盐。", "en": "I pick up a salt chunk."},
        {"zh": "贝壳，嚼着响。", "en": "A shell — it crunches."},
        {"zh": "地上的水藻。", "en": "Algae off the ground."},
        {"zh": "我嘴里已经塞满了。", "en": "My mouth is already full."},
        {"zh": "这石头有咸味。", "en": "This stone tastes of salt."},
        {"zh": "慢慢叼起来。", "en": "I lift it slowly."},
        {"zh": "我叼着它往滩涂走。", "en": "I carry it in my mouth toward the flats."},
        {"zh": "有一块湿布。", "en": "A wet rag here."},
        {"zh": "这味道我不认识。", "en": "This scent I don't know."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "铁傀儡的铁味。", "en": "The smell of iron golem."},
        {"zh": "那是个村民吧。", "en": "That's a villager, isn't it."},
        {"zh": "我的角自己转向了村子。", "en": "My horns turn toward the village on their own."},
        {"zh": "身体自己转过去。", "en": "My body turns on its own."},
        {"zh": "那不是我想要的。", "en": "That's not what I want."},
        {"zh": "我控制不住腿。", "en": "I can't control my legs."},
        {"zh": "潮水让我这么做。", "en": "The tide makes me do this."},
        {"zh": "前面那人的味道，太熟了。", "en": "The one ahead smells far too familiar."},
        {"zh": "哞，对不住了。", "en": "Moo. I'm sorry."},
        {"zh": "它们在我脑子里说话。", "en": "They're speaking in my head."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢跟在后头。", "en": "I follow slowly behind."},
        {"zh": "蹄子不敢踩响。", "en": "My hooves stay quiet."},
        {"zh": "他往村里走。", "en": "He's heading into the village."},
        {"zh": "铁皮会挡住我吗。", "en": "Will iron stop me?"},
        {"zh": "低一点，别被发现。", "en": "Keep low. Don't be seen."},
        {"zh": "我闻到他身上的汗。", "en": "I smell the sweat on him."},
        {"zh": "再靠近我几步。", "en": "A few steps closer to me."},
        {"zh": "它们催我快些。", "en": "They urge me faster."},
        {"zh": "泥里的蹄印一步跟着一步。", "en": "My hoofprints in the mud follow one after another."},
        {"zh": "他停下来了。", "en": "He stopped."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "低头顶过去！", "en": "Head down and charge!"},
        {"zh": "角撞你的腰。", "en": "My horn into your side."},
        {"zh": "蹄子踏下去。", "en": "Hoof stamp."},
        {"zh": "撞倒了就好。", "en": "Knock it down — that's enough."},
        {"zh": "把它压住在泥里。", "en": "I pin it in the mud."},
        {"zh": "这一下不是我。", "en": "That wasn't me."},
        {"zh": "别挣扎，很快。", "en": "Don't struggle. It's quick."},
        {"zh": "血混着海水。", "en": "Blood mixed with seawater."},
        {"zh": "头再抬一次。", "en": "My head comes up again."},
        {"zh": "这一顶，海水溅了满地。", "en": "One gore and seawater splashes everywhere."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从滩上走来。", "en": "I come up off the flats."},
        {"zh": "牛的样子还在。", "en": "The cow shape lingers."},
        {"zh": "背上的菌破皮而出。", "en": "The growth breaks through my hide."},
        {"zh": "海水还挂在角上。", "en": "Seawater clings to my horns."},
        {"zh": "村庄就在前面。", "en": "The village is right ahead."},
        {"zh": "我听见召唤声。", "en": "I hear the calling."},
        {"zh": "哞，这一声变了。", "en": "Moo — that sound has changed."},
        {"zh": "蹄子踩出第一个坑。", "en": "My hoof makes the first print."},
        {"zh": "我身上在长东西。", "en": "Something is growing on me."},
        {"zh": "这片草地归它们了。", "en": "This grassland belongs to them now."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "湿皮被烤得发响。", "en": "My wet hide sizzles."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，蹄子打滑。", "en": "My hooves slipped on the fall."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌满我的肺。", "en": "Water fills my lungs."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "泥浆溅了我一脸。", "en": "Mud splashed all over my face."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进我的腿。", "en": "An arrow in my leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光在我体内烧。", "en": "The light burns inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得乳房都瘪了。", "en": "Hunger has hollowed me out."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "水里的雷更疼。", "en": "Lightning through water hurts more."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下一片虚。", "en": "The ground is gone."}
      ]
    }
  }
}
