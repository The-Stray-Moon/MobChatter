{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢悠悠地挪着", "en": "I shuffle along slowly."},
        {"zh": "四足的步子拖得很长", "en": "My four feet drag a long stride."},
        {"zh": "我从水里爬上湿岸", "en": "I climb from the water onto wet bank."},
        {"zh": "我一步一停往前走", "en": "I stop at every step."},
        {"zh": "身上的硬壳擦着石头", "en": "My shell scrapes the stones."},
        {"zh": "我侧身挤过窄缝", "en": "I squeeze through a narrow gap."},
        {"zh": "我在泥里踩出脚印", "en": "I leave prints in the mud."},
        {"zh": "我绕着水洼走一圈", "en": "I walk once around the pool."},
        {"zh": "我抬头看了看路", "en": "I lift my head to check the way."},
        {"zh": "我慢慢拉近距离", "en": "I slowly close the distance."},
        {"zh": "我的影子在地上拖", "en": "My shadow drags behind me."},
        {"zh": "我走过的地方留着水", "en": "Water marks where I have been."},
        {"zh": "我晃晃悠悠地走", "en": "I sway as I go."},
        {"zh": "我沿着岸边一直走", "en": "I keep walking along the bank."},
        {"zh": "我一步压碎一层泥壳", "en": "Each step cracks the dried mud."},
        {"zh": "我一直走到路尽头", "en": "I walk to the end of the path."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，壳上滴水", "en": "I stand and my shell drips."},
        {"zh": "我在慢慢换气", "en": "I am slowly breathing."},
        {"zh": "我的触须探了探", "en": "My tendrils probe the air."},
        {"zh": "我伏着连壳都不动", "en": "I lie so still my shell does not move."},
        {"zh": "我把身体沉低了", "en": "I settle my body lower."},
        {"zh": "我一直在看水面", "en": "I am watching the water."},
        {"zh": "我的硬壳反着光", "en": "My shell catches the light."},
        {"zh": "我在等什么靠近", "en": "I wait for something to come near."},
        {"zh": "我把一条腿收起来", "en": "I draw one leg in."},
        {"zh": "我的呼吸很轻", "en": "My breathing is very faint."},
        {"zh": "我在听风的动静", "en": "I listen to the wind."},
        {"zh": "我缓慢地转了转头", "en": "I turn my head slowly."},
        {"zh": "我身上的水干了", "en": "The water on me has dried."},
        {"zh": "我慢慢把身体撑住", "en": "I brace myself slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起硬壳看你", "en": "I raise my shell to look at you."},
        {"zh": "你在我前面挡住了路", "en": "You are blocking my path."},
        {"zh": "我把触须转向你", "en": "My tendrils turn toward you."},
        {"zh": "我不急，你让让", "en": "I am in no hurry; step aside."},
        {"zh": "你身上有水的味道", "en": "You smell of water."},
        {"zh": "我朝你挪了半步", "en": "I shift half a step your way."},
        {"zh": "你的鞋底沾着海藻。", "en": "There's seaweed on the sole of your boot."},
        {"zh": "我等着你走开", "en": "I wait for you to leave."},
        {"zh": "你的影子盖住了我", "en": "Your shadow covers me."},
        {"zh": "我在原地不动", "en": "I stay where I am."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "撞得我的腕足都缩了一下。", "en": "The hit makes my arm-legs shrink back."},
        {"zh": "我慢慢缩了缩", "en": "I draw myself in slowly."},
        {"zh": "我四条腿晃了晃", "en": "My four legs wobble."},
        {"zh": "泥水沾上了伤口", "en": "Mud gets into the wound."},
        {"zh": "我的触须缩回去了", "en": "My tendrils retract."},
        {"zh": "骨头闷响，我往泥里沉了点。", "en": "A dull crack; I sink a little into the mud."},
        {"zh": "我把它记下来了", "en": "I have logged it."},
        {"zh": "我慢慢稳住了", "en": "I steady myself slowly."},
        {"zh": "血混在泥水里", "en": "Blood mixes with the mud."},
        {"zh": "我还要往前挪", "en": "I still mean to move forward."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那东西湿的", "en": "What you hold is wet."},
        {"zh": "我伸出触须碰", "en": "I reach out a tendril."},
        {"zh": "我拖着身子靠过去", "en": "I drag myself closer."},
        {"zh": "我用腕足把它兜住", "en": "I cup it in a cirrus."},
        {"zh": "这东西，不合我的口味。", "en": "This does not suit my palate."},
        {"zh": "我闻了一下就退了", "en": "I sniff it and pull back."},
        {"zh": "我把它拱回你那边", "en": "I nudge it back toward you."},
        {"zh": "这东西我不打算碰", "en": "I do not mean to touch this."},
        {"zh": "我盯着它看了一会儿", "en": "I stare at it a while."},
        {"zh": "我转身慢慢挪开", "en": "I turn and shuffle off."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我壳上", "en": "You hit my shell."},
        {"zh": "我被顶得滑了一下", "en": "The shove makes me slide."},
        {"zh": "我的壳硬得很", "en": "My shell is hard."},
        {"zh": "我往泥里侧了侧身", "en": "I tip sideways into the mud."},
        {"zh": "我们擦出一点水声", "en": "We brush with a wet sound."},
        {"zh": "你往后退开一截", "en": "You pull back a little."},
        {"zh": "我稳住四条腿", "en": "I steady my four legs."},
        {"zh": "这么撞我不疼", "en": "Such a knock does not hurt."},
        {"zh": "我挪着绕到旁边", "en": "I shuffle around to the side."},
        {"zh": "泥地上多了两道印", "en": "Two new marks in the mud."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "她慢慢挪过来了", "en": "She shuffles over to me."},
        {"zh": "我们俩挨着立住", "en": "The two of us stand together."},
        {"zh": "我的触须碰上她的", "en": "My tendrils touch hers."},
        {"zh": "我们一起往水里走", "en": "We walk toward the water together."},
        {"zh": "她比我大半圈", "en": "She is a size larger."},
        {"zh": "我们的壳互相磨着", "en": "Our shells grind together."},
        {"zh": "她停在半格之外", "en": "She stops half a block away."},
        {"zh": "我们一起沉进浅水", "en": "We sink into the shallows together."},
        {"zh": "我们谁也没出声", "en": "Neither of us makes a sound."},
        {"zh": "她跟着我慢慢走", "en": "She follows me at my slow pace."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用触须把它卷起来", "en": "I curl it up with a tendril."},
        {"zh": "海嗣的泥底下，藏着我的存货。", "en": "Under the seaborn mud lies my hoard."},
        {"zh": "我用腕足举起来端详", "en": "I raise it on a cirrus to inspect."},
        {"zh": "我把它塞进壳缝", "en": "I tuck it into a shell seam."},
        {"zh": "我一口咬碎了", "en": "I bite it apart."},
        {"zh": "我用触须扫到一旁", "en": "I sweep it aside with a tendril."},
        {"zh": "我慢慢捡起它", "en": "I pick it up slowly."},
        {"zh": "它从我的触须间滑走", "en": "It slips through my tendrils."},
        {"zh": "我把它留在原处", "en": "I leave it where it was."},
        {"zh": "我拖着它往前走", "en": "I drag it along."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我忽然停住了", "en": "I come to a stop."},
        {"zh": "我的触须全部竖起", "en": "All my tendrils stand up."},
        {"zh": "我转向你的方向", "en": "I turn your way."},
        {"zh": "我的壳缝收紧", "en": "My shell seams tighten."},
        {"zh": "我开始往前挪", "en": "I begin to move forward."},
        {"zh": "这一下我记在身上", "en": "I log that hit in my body."},
        {"zh": "泥地上我的脚印变深", "en": "My prints deepen in the mud."},
        {"zh": "我把硬壳压低", "en": "I lower my hard shell."},
        {"zh": "我不打算再退了", "en": "I do not mean to retreat."},
        {"zh": "我慢慢张开了口", "en": "I slowly open my mouth."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一寸一寸挪近", "en": "I inch nearer."},
        {"zh": "泥地被我压出响声", "en": "The mud squelches under me."},
        {"zh": "我慢，但我会堵住路。", "en": "I'm slow, but I'll block your way."},
        {"zh": "我还在等更好的角度", "en": "I wait for a better angle."},
        {"zh": "你退一步我挪一步", "en": "One of your steps, one of mine."},
        {"zh": "我的触须在试探", "en": "My tendrils are testing."},
        {"zh": "我把硬壳侧对你", "en": "I turn my shell to face you."},
        {"zh": "我并不急着撞你", "en": "I am in no hurry to charge."},
        {"zh": "你在水边站着", "en": "You are standing by the water."},
        {"zh": "我的腕足已经张开。", "en": "My tendrils are already spread wide."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用壳撞过去", "en": "I ram with my shell."},
        {"zh": "我的触须抽在你腿上", "en": "My tendril flicks your leg."},
        {"zh": "我压过来，你退了", "en": "I lean in and you give ground."},
        {"zh": "我一口咬在他的手臂", "en": "I bite into his arm."},
        {"zh": "我用四条腿顶住", "en": "I brace with all four legs."},
        {"zh": "这一撞带着我的分量", "en": "That charge carried my weight."},
        {"zh": "他挡下第一下，第二下没挡住", "en": "He stops one, not the next."},
        {"zh": "我把他挤到水边", "en": "I crowd him to the water's edge."},
        {"zh": "我慢慢收住身子", "en": "I pull myself back."},
        {"zh": "泥地被我踩得稀烂", "en": "The mud is churned to soup."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从浅水里站起来", "en": "I rise out of the shallows."},
        {"zh": "壳上的水往下淌", "en": "Water runs off my shell."},
        {"zh": "我先试了试脚下的泥", "en": "First I test the mud."},
        {"zh": "我慢慢挪到岸上", "en": "I haul myself onto the bank."},
        {"zh": "我的影子落在水面上", "en": "My shadow falls on the water."},
        {"zh": "周围安静得只剩水声", "en": "Only water sounds remain."},
        {"zh": "我立在这里不动", "en": "I stand here without moving."},
        {"zh": "我抬壳瞟了你一下", "en": "I tip my shell and glance at you."},
        {"zh": "我身上的气味很重", "en": "My smell is strong."},
        {"zh": "我这一带走了很久", "en": "I have walked this area long."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤干了我壳上的水", "en": "Fire dries the water off my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从岸上滚了下来", "en": "I roll down the bank."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进了我的壳缝", "en": "Water seeps into my shell."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀翻在地上", "en": "The blast flips me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭卡在我的壳上", "en": "An arrow sticks in my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光钻进了我的壳缝", "en": "Spell light works into my seams."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得挪不动了", "en": "Hunger stops me from moving."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我的壳上", "en": "Lightning strikes my shell."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的泥忽然没了", "en": "The mud beneath me is gone."}
      ]
    }
  }
