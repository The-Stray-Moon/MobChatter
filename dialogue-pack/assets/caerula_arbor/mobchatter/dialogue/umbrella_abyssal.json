{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着宽大的身子上岸。", "en": "I haul my broad body ashore."},
        {"zh": "伞盖一样的背褶张开。", "en": "My umbrella-like back folds open."},
        {"zh": "我一步一步压过滩涂。", "en": "I press across the flat, step by step."},
        {"zh": "身体太重，走得慢。", "en": "Too heavy to walk quickly."},
        {"zh": "身后留下一道深痕。", "en": "A deep furrow follows me."},
        {"zh": "我在雾里挪动。", "en": "I shift through the fog."},
        {"zh": "触须扫过地面。", "en": "My tendrils sweep the ground."},
        {"zh": "我是巢涌者，带着群。", "en": "I am a Swarmcaller; I bring the swarm."},
        {"zh": "我的体重压碎贝壳。", "en": "My weight cracks shells."},
        {"zh": "我沿着潮水往上走。", "en": "I follow the tide inland."},
        {"zh": "伞盖撑开挡风。", "en": "My hood spreads against the wind."},
        {"zh": "我慢慢转向前方。", "en": "I slowly turn forward."},
        {"zh": "每一步都有黏液声。", "en": "Each step sounds wet."},
        {"zh": "我往有人的方向去。", "en": "I head where the people are."},
        {"zh": "海嗣在岸上也有脚步声。", "en": "Even on land, the Seaborn has footsteps."},
        {"zh": "我拖着影子走过去。", "en": "I drag my shadow along."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在泥里喘。", "en": "I lie in the mud and breathe."},
        {"zh": "伞盖一张一合。", "en": "My hood opens and closes."},
        {"zh": "身体里在搏动。", "en": "Something pulses inside me."},
        {"zh": "我在等群聚拢。", "en": "I wait for the swarm to gather."},
        {"zh": "雾贴着我的背。", "en": "Fog lies on my back."},
        {"zh": "我的触须探着空气。", "en": "My tendrils test the air."},
        {"zh": "这里的水分不够。", "en": "Not enough moisture here."},
        {"zh": "我慢慢把伞盖收拢。", "en": "I slowly fold my hood in."},
        {"zh": "地面被我压出凹坑。", "en": "The ground dents under me."},
        {"zh": "我嗅到铁锈味。", "en": "I smell rust."},
        {"zh": "我不需要躲起来。", "en": "I don't need to hide."},
        {"zh": "我听见岸上有铁器碰撞。", "en": "I hear iron clashing on the shore."},
        {"zh": "我压低声音震动。", "en": "I hum low."},
        {"zh": "现在还不到时候。", "en": "Not yet time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我面前太小了。", "en": "You're so small in front of me."},
        {"zh": "我的伞盖能盖住你。", "en": "My hood could cover you."},
        {"zh": "我带着一支群。", "en": "I bring a swarm with me."},
        {"zh": "你的村子挡不住我们。", "en": "Your village can't hold us."},
        {"zh": "我不急，群会先到。", "en": "No rush; the swarm arrives first."},
        {"zh": "你闻起来像村子的味道。", "en": "You smell of a village."},
        {"zh": "你举着铁片，挡不住我的触须。", "en": "You raise a scrap of iron; it won't stop my tendrils."},
        {"zh": "你身后还有人吗？", "en": "Are there others behind you?"},
        {"zh": "别站在我的触须边上。", "en": "Don't stand by my tendrils."},
        {"zh": "我看你像看一扇门。", "en": "I look at you like a doorway."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "皮太厚，伤口其实不深。", "en": "My hide is thick; the wound isn't deep."},
        {"zh": "血和黏液一起流。", "en": "Blood and slime run together."},
        {"zh": "我拖着身子退了半步。", "en": "I give half a step."},
        {"zh": "疼得我压低了身子。", "en": "Pain makes me lower my bulk."},
        {"zh": "你这一刀够深的。", "en": "Your blade went deep."},
        {"zh": "我抖了一下触须。", "en": "My tendrils twitch."},
        {"zh": "我的血肉会自己长回去。", "en": "My flesh knits itself back."},
        {"zh": "群会替我记住。", "en": "The swarm will remember for me."},
        {"zh": "我沉住气，黏液又裹紧伤口。", "en": "I steady myself; slime seals the wound again."},
        {"zh": "再撞我一次看看。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我一张嘴，这点量塞牙缝。", "en": "One mouthful and that much barely fills a tooth gap."},
        {"zh": "群里的比我更饿。", "en": "The swarm is hungrier than I."},
        {"zh": "把食物搁在泥上，再退开。", "en": "Set the food on the mud, then step back."},
        {"zh": "我只咽得下带血气的活物。", "en": "I can only swallow living things that smell of blood."},
        {"zh": "这点腥气，引不动我的群。", "en": "That faint reek won't move my swarm."},
        {"zh": "我更喜欢活的。", "en": "I prefer it alive."},
        {"zh": "你拿着一会儿也行。", "en": "You can keep holding it."},
        {"zh": "这点量连开胃都不算。", "en": "That wouldn't even be an appetizer."},
        {"zh": "我会让它们来拿。", "en": "I'll let them come take it."},
        {"zh": "你最好自己吃掉。", "en": "You'd best eat it yourself."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你整个人撞进我身上。", "en": "You crashed into my bulk."},
        {"zh": "你这一撞，我连皮都没晃。", "en": "That charge didn't even stir my hide."},
        {"zh": "你被我的体重挡回来。", "en": "My weight pushed you back."},
        {"zh": "你这点分量拦不住我。", "en": "Your little weight can't stop me."},
        {"zh": "踩到我等于踩进泥。", "en": "Stepping on me is like stepping in mud."},
        {"zh": "我的触须缠住你脚踝。", "en": "My tendril caught your ankle."},
        {"zh": "这一下你站不稳。", "en": "You can't keep your footing."},
        {"zh": "我的身子一偏，你就滑下去了。", "en": "One tilt of my bulk and you slide off."},
        {"zh": "我转身会很慢。", "en": "I turn very slowly."},
        {"zh": "再撞我就压下去。", "en": "Bump again and I'll press down."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "巢涌者不这样繁衍。", "en": "Swarmcallers don't breed that way."},
        {"zh": "群会自己长大。", "en": "The swarm grows on its own."},
        {"zh": "这具身体不合适。", "en": "This body isn't suited."},
        {"zh": "我在等潮水上来。", "en": "I'm waiting on the tide."},
        {"zh": "你站得远一点。", "en": "Stand farther."},
        {"zh": "这问题没有意义。", "en": "That question is meaningless."},
        {"zh": "潮水一涨，我就得带群走。", "en": "When the tide rises, I must lead the swarm."},
        {"zh": "换个时间再说。", "en": "Another time."},
        {"zh": "我不需要一个伴。", "en": "I need no companion."},
        {"zh": "走开，别挡着我。", "en": "Go away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的触须探了探，又松开。", "en": "My tendril tests it, then lets go."},
        {"zh": "我卷起它，掂了掂就丢。", "en": "I coil it up, weigh it once, and drop it."},
        {"zh": "带回巢里去放着。", "en": "Back to the nest with it."},
        {"zh": "这个给群里的小的。", "en": "This goes to the small ones."},
        {"zh": "我压一下试试。", "en": "Let me press it once."},
        {"zh": "我一下就压碎了。", "en": "It broke."},
        {"zh": "这个不值得带走。", "en": "Not worth taking."},
        {"zh": "就近埋进泥里。", "en": "Bury it in the mud nearby."},
        {"zh": "是谁把这东西落下的？", "en": "Who dropped this?"},
        {"zh": "这点碎渣，让小的来捡。", "en": "Let the little ones pick up these crumbs."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有一个村子在那边。", "en": "There's a village over there."},
        {"zh": "群已经往那边去了。", "en": "The swarm already moves that way."},
        {"zh": "群还没动，我先盯上你了。", "en": "The swarm hasn't moved; I've fixed on you first."},
        {"zh": "你站在最前面。", "en": "You're standing at the front."},
        {"zh": "我先撞开这扇门。", "en": "I'll break this gate first."},
        {"zh": "伞盖撑到最大。", "en": "My hood opens to its widest."},
        {"zh": "它们会跟着我来。", "en": "They'll follow me in."},
        {"zh": "你在我的路线上。", "en": "You're on my path."},
        {"zh": "这一撞就足够了。", "en": "One charge is enough."},
        {"zh": "我闻到血的味道。", "en": "I smell blood."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿肩膀顶着你往前推。", "en": "I push you forward with my shoulder."},
        {"zh": "你退一步我跟着。", "en": "You retreat; I follow."},
        {"zh": "我的触须在前面探。", "en": "My tendrils feel ahead."},
        {"zh": "你身后就是墙。", "en": "There's a wall behind you."},
        {"zh": "我压着不让你绕侧。", "en": "I keep you from circling."},
        {"zh": "群的声音越来越近。", "en": "The swarm's sound grows closer."},
        {"zh": "我不需要跑起来。", "en": "I don't need to run."},
        {"zh": "你的刀砍不进这层皮。", "en": "Your blade won't cut this hide."},
        {"zh": "再近一点就撞。", "en": "One step closer and I charge."},
        {"zh": "你喘得越急，我听得越准。", "en": "The harder you pant, the better I hear you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "整个人压过去。", "en": "I press my whole bulk forward."},
        {"zh": "触须把你扫倒。", "en": "A tendril sweeps you down."},
        {"zh": "我的手劲不大，但很重。", "en": "My swing is weak, but heavy."},
        {"zh": "你被顶在墙上。", "en": "You're pinned to the wall."},
        {"zh": "伞盖罩住你了。", "en": "My hood closes over you."},
        {"zh": "地上留下黏液。", "en": "Slime stays on the ground."},
        {"zh": "这一下撞碎了门框。", "en": "That shattered the doorframe."},
        {"zh": "你在我的影子里。", "en": "You're inside my shadow."},
        {"zh": "再来一次就压扁。", "en": "Once more and you're flat."},
        {"zh": "你就待着别动。", "en": "Don't move."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从深水里升起。", "en": "I rise from the deep."},
        {"zh": "滩涂被我的重量压响。", "en": "The flat groans under my weight."},
        {"zh": "群在岸上等我。", "en": "The swarm waits for me on shore."},
        {"zh": "雾很浓，正好合适。", "en": "Thick fog; good."},
        {"zh": "我把伞盖撑开。", "en": "I spread my hood."},
        {"zh": "空气里有村子的味道。", "en": "The air carries a village's scent."},
        {"zh": "我抖落身上的水。", "en": "I shake the water off."},
        {"zh": "这里的地很软。", "en": "The ground is soft here."},
        {"zh": "我的触须先落地。", "en": "My tendrils touch down first."},
        {"zh": "湿泥被我踩得往下陷。", "en": "The wet mud sinks under my tread."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到伞盖边缘，卷了起来。", "en": "Fire curled the edge of my hood."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "这一摔，连骨头都在震。", "en": "That fall rattled even my bones."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我往深处拖。", "en": "The water drags me deeper."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸掀开了我的伞盖。", "en": "The blast peeled my hood back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭卡在我的厚皮外头。", "en": "The arrow stuck outside my thick hide."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力在我体内乱撞。", "en": "Spellwork ricochets inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "群里的声音变弱了。", "en": "The swarm's voices weaken."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷穿过我的身体，我僵了一下。", "en": "Lightning crossed my body; I locked up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "底下空了，我还在往下沉。", "en": "The bottom is gone; I keep sinking."}
      ]
    }
  }
}
