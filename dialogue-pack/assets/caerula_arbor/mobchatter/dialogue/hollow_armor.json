{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "铁靴踏地，空空响。", "en": "Iron boots ring on the ground, hollow."},
        {"zh": "盔甲里没有人。", "en": "There's no one inside this armor."},
        {"zh": "每一步都自己走。", "en": "Each step takes itself."},
        {"zh": "关节在自言自语。", "en": "The joints mutter to themselves."},
        {"zh": "护甲片相互摩擦。", "en": "The plates grind against each other."},
        {"zh": "铁靴踩着旧砖，一路响。", "en": "My iron boots clank along the old bricks."},
        {"zh": "头盔里只有风。", "en": "Only wind inside the helm."},
        {"zh": "铁手套攥了攥空。", "en": "The gauntlet closes on nothing."},
        {"zh": "走近海边再折返。", "en": "To the shore, then back."},
        {"zh": "脚步很轻，铁却重。", "en": "Light steps, heavy iron."},
        {"zh": "站直，走直线。", "en": "Stand tall. Walk straight."},
        {"zh": "谁给我留下的？", "en": "Who left me here?"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "空盔甲在等待。", "en": "The hollow armor waits."},
        {"zh": "关节自己锁上。", "en": "My joints lock on their own."},
        {"zh": "面甲后没有眼。", "en": "No eyes behind the visor."},
        {"zh": "我听见铁在呼吸。", "en": "I hear the iron breathing."},
        {"zh": "手指慢慢张开。", "en": "My fingers open slowly."},
        {"zh": "这具身体不是我。", "en": "This body isn't mine."},
        {"zh": "刻痕还在胸甲上。", "en": "The marks remain on my breastplate."},
        {"zh": "谁在敲我的胸甲？", "en": "Who's knocking on my breastplate?"},
        {"zh": "我把头盔歪了歪。", "en": "I tilt the helm."},
        {"zh": "铁锈落在地上。", "en": "Rust falls to the ground."},
        {"zh": "没有心跳，很安静。", "en": "No heartbeat. Very quiet."},
        {"zh": "站了很久了。", "en": "I've stood a long while."},
        {"zh": "袍角被风吹起。", "en": "Wind lifts my tattered skirt."},
        {"zh": "我在等一个名字。", "en": "I'm waiting for a name."},
        {"zh": "胸口有个空洞。", "en": "There's a hollow in my chest."},
        {"zh": "铠甲也需要休息。", "en": "Even armor needs rest."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你到底在找谁？", "en": "Who exactly are you seeking?"},
        {"zh": "面甲里没有脸。", "en": "There's no face in this visor."},
        {"zh": "你的呼吸声很响。", "en": "Your breathing is loud."},
        {"zh": "我认得活人。", "en": "I recognize the living."},
        {"zh": "别去碰那些铁锈。", "en": "Don't touch that rust."},
        {"zh": "这身甲不是我的。", "en": "This armor isn't mine."},
        {"zh": "你听见铁响了吗。", "en": "Do you hear the iron?"},
        {"zh": "我在等一个命令。", "en": "I'm waiting for an order."},
        {"zh": "我的影子压到你了。", "en": "My shadow falls on you."},
        {"zh": "铁不会撒谎。", "en": "Iron doesn't lie."},
        {"zh": "这具甲里，早就没人了。", "en": "No one has been inside this armor for a long time."},
        {"zh": "说个名字给我听。", "en": "Say a name for me to hear."},
        {"zh": "我很沉，别倚靠。", "en": "I'm heavy. Don't lean on me."},
        {"zh": "你要走哪条路？", "en": "Which road are you taking?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "有一片甲凹了。", "en": "One plate is dented."},
        {"zh": "里面是空的，别白费。", "en": "It's hollow inside. Waste of effort."},
        {"zh": "铁屑掉下来。", "en": "Iron filings fall."},
        {"zh": "我晃了一下。", "en": "I swayed."},
        {"zh": "关节发出尖响。", "en": "My joints screech."},
        {"zh": "疼？我不知道那是什么。", "en": "Pain? I don't know."},
        {"zh": "凹进去的那块，我自己敲平。", "en": "I hammer the dented plate flat myself."},
        {"zh": "这一下留了印。", "en": "That left a mark."},
        {"zh": "锈也一起掉了。", "en": "Rust flaked off with it."},
        {"zh": "你接着来试试。", "en": "Go on. Try again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这块铁很新。", "en": "This iron is new."},
        {"zh": "给我，我能用上。", "en": "Give it. I can use it."},
        {"zh": "铁锈也需要滋养。", "en": "Even rust needs feeding."},
        {"zh": "那是护甲片吗？", "en": "Are those armor plates?"},
        {"zh": "我缺一块肩甲。", "en": "I'm missing a pauldron."},
        {"zh": "叮的一声，好熟悉。", "en": "That clink is familiar."},
        {"zh": "放下，我来拿。", "en": "Set it down. I'll take it."},
        {"zh": "这油能润关节。", "en": "This oil will free my joints."},
        {"zh": "这把铁锤的木柄，正好补我的肘。", "en": "This hammer's haft will fit my elbow joint."},
        {"zh": "多谢，我记住了。", "en": "Thanks. I'll remember."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在铁上。", "en": "You struck iron."},
        {"zh": "退后，我很沉。", "en": "Back off. I'm heavy."},
        {"zh": "叮——回声不错。", "en": "Clang — a fine echo."},
        {"zh": "别拽我的臂甲。", "en": "Don't pull my vambrace."},
        {"zh": "我站得住，你呢。", "en": "I'm steady. Are you?"},
        {"zh": "你撞上甲面，退了两步。", "en": "You hit my breastplate and stagger back two steps."},
        {"zh": "一块甲片掉了。", "en": "A plate fell off."},
        {"zh": "碰一下就够你疼。", "en": "One touch and you'll ache."},
        {"zh": "别贴这么近，我甲片利。", "en": "Don't press so close — my plates are sharp."},
        {"zh": "一寸也够我响半天。", "en": "An inch rings for ages."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我里面是空的。", "en": "I'm hollow inside."},
        {"zh": "这具身体给不了什么。", "en": "This body has nothing to give."},
        {"zh": "我连自己是谁都不知道。", "en": "I don't even know who I am."},
        {"zh": "有个人曾在这里。", "en": "Someone used to be here."},
        {"zh": "等我想起来。", "en": "When I remember."},
        {"zh": "这甲里空着，等不到人。", "en": "This armor is empty; no one is coming."},
        {"zh": "铁碰铁不会温暖。", "en": "Iron on iron gives no warmth."},
        {"zh": "你该找个活人。", "en": "You should find someone alive."},
        {"zh": "我会一直站着。", "en": "I'll keep standing."},
        {"zh": "谢谢你问这一句。", "en": "Thank you for asking."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块铁归我。", "en": "This iron is mine."},
        {"zh": "我能把它装上。", "en": "I can fit this on."},
        {"zh": "一枚旧扣子。", "en": "An old clasp."},
        {"zh": "钉子和铰链，有用。", "en": "Nails and hinges. Useful."},
        {"zh": "这个声音真好听。", "en": "That sound pleases me."},
        {"zh": "我会好好收着。", "en": "I'll keep it safe."},
        {"zh": "拿不起来，太滑。", "en": "Can't lift it. Too slick."},
        {"zh": "空腔里正好缺这一块。", "en": "My hollow is missing exactly this piece."},
        {"zh": "放到我胸甲里。", "en": "Put it in my chest cavity."},
        {"zh": "我记下这份人情。", "en": "I owe you for this."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "铁匠的味道。", "en": "The smell of a smith."},
        {"zh": "有东西在接近。", "en": "Something is drawing near."},
        {"zh": "我要挡住这里。", "en": "I'll hold this spot."},
        {"zh": "关节全部锁紧。", "en": "All joints locking."},
        {"zh": "这身甲开始发热。", "en": "This armor is warming up."},
        {"zh": "谁在损坏我的壳。", "en": "Who's damaging my shell."},
        {"zh": "站到路口中央。", "en": "I take the middle of the road."},
        {"zh": "不会让你过去。", "en": "I won't let you pass."},
        {"zh": "敲一敲胸甲，回应。", "en": "I tap my breastplate in answer."},
        {"zh": "来的不是朋友。", "en": "This one isn't a friend."},
        {"zh": "我听见拔刀声。", "en": "I heard a blade drawn."},
        {"zh": "抬起手，握拳。", "en": "I raise my hand and close it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "铁不会眨眼。", "en": "Iron doesn't blink."},
        {"zh": "我在算你的步伐。", "en": "I'm counting your paces."},
        {"zh": "你越退，墙越近。", "en": "The more you retreat, the closer the wall."},
        {"zh": "墙角可以夹住你。", "en": "The corner can pin you."},
        {"zh": "我的盾还稳。", "en": "My shield still holds."},
        {"zh": "你手上有汗。", "en": "Your palms are sweating."},
        {"zh": "等你自己靠近。", "en": "I wait for you to come."},
        {"zh": "甲片已经对齐。", "en": "My plates are aligned."},
        {"zh": "我在听你握住刀柄的手。", "en": "I listen to the hand closing on your hilt."},
        {"zh": "我站在这里不动。", "en": "I stay right here."},
        {"zh": "铁的重心很稳。", "en": "Iron keeps its balance."},
        {"zh": "再走三步就到。", "en": "Three steps more and you're here."},
        {"zh": "我不需要躲。", "en": "I don't need to dodge."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "铁拳直接砸下来！", "en": "The iron fist comes down!"},
        {"zh": "横着劈，别去挡。", "en": "Sideways slash. Don't block."},
        {"zh": "肩甲撞过去！", "en": "Pauldron charge!"},
        {"zh": "铁手套砸下去，地都裂。", "en": "My gauntlet comes down and the ground cracks."},
        {"zh": "甲片夹住你。", "en": "My plates clamp on you."},
        {"zh": "抬起手，再压下去。", "en": "Arm up, then down."},
        {"zh": "铁靴踢你膝。", "en": "An iron boot at your knee."},
        {"zh": "回声比声音大。", "en": "The echo is louder than the hit."},
        {"zh": "你撞得退开。", "en": "You're knocked back."},
        {"zh": "再举一次手。", "en": "My arm rises again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "铁盔从土里立起。", "en": "An iron helm rises from the soil."},
        {"zh": "空甲里灌进了风。", "en": "Wind fills the empty armor."},
        {"zh": "叮的一声，我醒着。", "en": "One clink — and I'm awake."},
        {"zh": "没有人穿上我。", "en": "No one put me on."},
        {"zh": "关节自己接好了。", "en": "The joints assembled themselves."},
        {"zh": "站在废墟中间。", "en": "I stand amid the ruins."},
        {"zh": "很轻，也很重。", "en": "Very light. Also very heavy."},
        {"zh": "我听见海的回声。", "en": "I hear the sea's echo."},
        {"zh": "有人来过这里。", "en": "Someone has been here."},
        {"zh": "我把面甲放下了。", "en": "I lower my visor."},
        {"zh": "这具甲还完整。", "en": "This armor is still whole."},
        {"zh": "铁盔先动，甲片跟着立起。", "en": "The helm moves first, then the plates rise with it."},
        {"zh": "铁在暗处也亮。", "en": "Iron gleams even in the dark."},
        {"zh": "谁给我下的命令？", "en": "Who gave me my orders?"}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "铁被烧红了。", "en": "The iron glows red."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时甲片散了。", "en": "Plates scattered on impact."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "盔甲里灌满了水。", "en": "Water fills the armor."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "震得我甲片乱响。", "en": "The blast rattles my plates."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "钉子卡在甲缝里。", "en": "A spike wedged in a seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光能穿过铁。", "en": "That light passes through iron."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "铁也会磨损。", "en": "Even iron wears down."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着甲片跑。", "en": "Lightning runs along my plates."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "铁在往下坠。", "en": "The iron is falling."}
      ]
    }
  }
}
