{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "爪子踩过湿石头。", "en": "Claws cross wet stone."},
        {"zh": "毛发成绺，滴着水。", "en": "My fur hangs in wet clumps."},
        {"zh": "低低贴着地面走。", "en": "I move low along the ground."},
        {"zh": "鼻子一直嗅着。", "en": "My nose never stops."},
        {"zh": "尾巴扫开海草。", "en": "My tail sweeps the seaweed."},
        {"zh": "一步一停，听声音。", "en": "A step, a pause, a listen."},
        {"zh": "脊背上裂出硬鳞。", "en": "Hard scales split along my spine."},
        {"zh": "慢慢往村里摸。", "en": "Creeping toward the village."},
        {"zh": "喉里压着一口气。", "en": "A growl held in my throat."},
        {"zh": "爪尖刮出细痕。", "en": "Claws leave thin lines."},
        {"zh": "绕到上风处。", "en": "Working around to upwind."},
        {"zh": "我贴着礁石，一点声不出。", "en": "I hug the rocks without a sound."},
        {"zh": "水从耳后流下来。", "en": "Water runs behind my ears."},
        {"zh": "慢慢踱，不显急。", "en": "An easy pace. No hurry shown."},
        {"zh": "骨节在皮下发响。", "en": "Bones click beneath my hide."},
        {"zh": "影子比身体先到。", "en": "My shadow arrives before me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "坐下，抖抖毛。", "en": "I sit and shake my coat."},
        {"zh": "牙缝里塞着东西。", "en": "Something's stuck in my teeth."},
        {"zh": "耳朵转向海水。", "en": "Ears turn toward the sea."},
        {"zh": "舔掉爪上的血。", "en": "I lick blood off my claws."},
        {"zh": "喘得有节奏。", "en": "My panting finds a rhythm."},
        {"zh": "背上的鳞硬了。", "en": "The scales on my back harden."},
        {"zh": "望着村口的灯。", "en": "I stare at the lamp at the village gate."},
        {"zh": "闻风里的味道。", "en": "Sniffing what the wind carries."},
        {"zh": "低低哼了一声。", "en": "A low noise in my throat."},
        {"zh": "尾巴不动了。", "en": "My tail goes still."},
        {"zh": "舌头舔过獠牙。", "en": "My tongue passes the fangs."},
        {"zh": "这里的风是咸的。", "en": "The wind here tastes of salt."},
        {"zh": "趴下，又起来。", "en": "Down, then up again."},
        {"zh": "地上的水洼照我。", "en": "A puddle shows me my shape."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你跑不过我四条腿。", "en": "You can't outrun my four legs."},
        {"zh": "你身上的味不对。", "en": "Your scent is wrong."},
        {"zh": "站住，我要看清。", "en": "Hold still. I want a look."},
        {"zh": "你手里的火把照不远。", "en": "That torch in your hand doesn't reach far."},
        {"zh": "海藻缠在我毛里，我闻见你了。", "en": "Seaweed tangles in my fur; I can smell you."},
        {"zh": "这地方归它们了。", "en": "This place belongs to them now."},
        {"zh": "别伸手过来。", "en": "Don't reach out."},
        {"zh": "你也是两脚的猎物。", "en": "You're two-legged prey too."},
        {"zh": "我认得你的村子。", "en": "I know your village."},
        {"zh": "慢慢退，别转身。", "en": "Back away slow. Don't turn."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你龇出牙。", "en": "I bare my teeth at you."},
        {"zh": "毛被血粘住。", "en": "Blood mats my fur."},
        {"zh": "后腿有点软。", "en": "My hind leg feels weak."},
        {"zh": "低吼，别靠近。", "en": "Growl. Stay back."},
        {"zh": "我这张嘴还能咬。", "en": "These jaws still bite."},
        {"zh": "皮裂了一道。", "en": "A tear in my hide."},
        {"zh": "痛得耳朵压平。", "en": "Pain pins my ears flat."},
        {"zh": "这一下，让我后腿打颤。", "en": "That blow leaves my hind legs trembling."},
        {"zh": "记住你的味道。", "en": "I'll remember your scent."},
        {"zh": "你有本事再来一次。", "en": "Come at me again, then."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那味道，鲜的。", "en": "That smell. Fresh."},
        {"zh": "扔下来，快点。", "en": "Drop it. Hurry."},
        {"zh": "肉，还是骨头？", "en": "Meat, or bone?"},
        {"zh": "我闻到血的甜。", "en": "I smell the sweetness of blood."},
        {"zh": "别晃动那块。", "en": "Don't wave that piece."},
        {"zh": "丢过来，我就放过你的手。", "en": "Toss it over and I'll spare your hand."},
        {"zh": "那东西在滴。", "en": "It's dripping."},
        {"zh": "我饿得发抖。", "en": "I'm shaking with hunger."},
        {"zh": "再扔远一点。", "en": "Throw it farther."},
        {"zh": "这味道不属于海。", "en": "This scent isn't from the sea."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你再撞我就咬人。", "en": "Bump me again and I bite."},
        {"zh": "退开，别挡路。", "en": "Back off. Clear the way."},
        {"zh": "你的腿碰到我的牙。", "en": "Your leg met my teeth."},
        {"zh": "我脚下很稳。", "en": "I keep my footing."},
        {"zh": "湿毛蹭你一身。", "en": "My wet fur rubs off on you."},
        {"zh": "别抓我的项背。", "en": "Don't grab my scruff."},
        {"zh": "再挤一次试试。", "en": "Crowd me again. Try."},
        {"zh": "你踩到我的爪了。", "en": "You stepped on my paw."},
        {"zh": "我肩一沉，把你撞开。", "en": "I drop my shoulder and knock you aside."},
        {"zh": "地上都是水，滑。", "en": "Slick water everywhere."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "海嗣不讲这个。", "en": "Seaborn don't do that."},
        {"zh": "你身上是陆地的味。", "en": "You smell of dry land."},
        {"zh": "等潮声停下。", "en": "When the tide sounds stop."},
        {"zh": "我只想狩猎。", "en": "I only want to hunt."},
        {"zh": "这股味道会沾上你。", "en": "This smell will cling to you."},
        {"zh": "我身体里有别的东西在动。", "en": "Something else moves in me."},
        {"zh": "这会害了你。", "en": "This would ruin you."},
        {"zh": "我不记得怎么亲近。", "en": "I don't remember how to be close."},
        {"zh": "闻到血我就变了。", "en": "The smell of blood changes me."},
        {"zh": "你走了，我就当没闻过。", "en": "Leave, and I'll pretend I never smelled you."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头，可以咬。", "en": "A bone. Good to gnaw."},
        {"zh": "捡起这块肉。", "en": "I take the meat."},
        {"zh": "一截皮带，嚼着。", "en": "A leather strap — chewable."},
        {"zh": "爪子勾起来了。", "en": "My claws hooked it."},
        {"zh": "这个有点软。", "en": "This one is soft."},
        {"zh": "拖回窝里去藏着。", "en": "I'll drag it to the den."},
        {"zh": "我咬住了，别来抢。", "en": "I've got it. Don't take it."},
        {"zh": "埋进湿沙里。", "en": "I bury it in wet sand."},
        {"zh": "这味道还真不错。", "en": "That's not a bad taste."},
        {"zh": "还有一点碎渣。", "en": "Some scraps left."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "铁皮的味道。", "en": "The smell of iron."},
        {"zh": "村口的灯下有人。", "en": "Someone under the gate lamp."},
        {"zh": "我伏得更低了。", "en": "I crouch lower."},
        {"zh": "肌肉自己绷紧。", "en": "My muscles tighten on their own."},
        {"zh": "那不是我的意思。", "en": "That isn't my intent."},
        {"zh": "潮水在叫我。", "en": "The tide is calling me."},
        {"zh": "牙齿开始发痒。", "en": "My teeth itch."},
        {"zh": "你站住，牙已经露出来了。", "en": "Stand still — my teeth are already bared."},
        {"zh": "那盏灯下，影子只剩一个。", "en": "Under that lamp there's only one shadow."},
        {"zh": "一声低吼，开始。", "en": "One growl, and it begins."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它的背影越来越近，越来越清楚。", "en": "Its back grows nearer and clearer."},
        {"zh": "风帮我遮住味道。", "en": "The wind hides my scent."},
        {"zh": "贴地，慢慢挪。", "en": "Low to the ground, easing in."},
        {"zh": "等它弯腰那一瞬。", "en": "I wait for it to bend over."},
        {"zh": "爪子在泥里陷。", "en": "My claws sink in the mud."},
        {"zh": "它还没有察觉。", "en": "It hasn't noticed."},
        {"zh": "再跟上去五步。", "en": "Five more paces after it."},
        {"zh": "风把它的气味送到我鼻尖。", "en": "The wind carries its scent to my nose."},
        {"zh": "尾巴压得死死的。", "en": "My tail stays flat."},
        {"zh": "潮声一停我就扑。", "en": "When the tide sound stops, I pounce."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个人扑上去！", "en": "I throw myself at you!"},
        {"zh": "獠牙咬进小腿！", "en": "Fangs sink into the calf!"},
        {"zh": "爪子把皮撕开了。", "en": "Claws tear the hide open."},
        {"zh": "甩头，撕下来。", "en": "I shake my head and rip."},
        {"zh": "压在你身上。", "en": "I pin you down."},
        {"zh": "我咬住不放，血是咸的。", "en": "I bite down and don't let go; the blood is salty."},
        {"zh": "别叫，一下就结束。", "en": "Don't scream. It's quick."},
        {"zh": "血的腥味好浓。", "en": "The blood smells so strong."},
        {"zh": "退开来，再来一次。", "en": "Back off, then again."},
        {"zh": "牙还没松开。", "en": "My jaws haven't let go."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从浪里爬上来。", "en": "I crawl out of the surf."},
        {"zh": "湿毛贴着骨头。", "en": "Wet fur clings to my bones."},
        {"zh": "这不是狼的叫声。", "en": "That's no wolf's howl."},
        {"zh": "海在背后推我。", "en": "The sea pushes at my back."},
        {"zh": "四肢长得不对。", "en": "My limbs grew wrong."},
        {"zh": "我闻到陆地的味道。", "en": "I smell dry land."},
        {"zh": "踩上第一块干地。", "en": "I set foot on the first dry ground."},
        {"zh": "村子在那边。", "en": "The village is that way."},
        {"zh": "喉咙里有别人的声音。", "en": "Another voice sits in my throat."},
        {"zh": "我来了，别关灯。", "en": "I'm here. Don't put out the lamp."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛烧出焦味。", "en": "My fur smells burnt."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，我滚进了浅水。", "en": "I fall and roll into the shallows."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的鼻子。", "en": "Water up my nose."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "耳朵嗡得听不见。", "en": "My ears ring, deafened."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿了我的肩。", "en": "An arrow through my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光刺得我退开。", "en": "That light drives me back."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿到肋骨都数得清。", "en": "Hungry enough to count my ribs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着湿毛烧。", "en": "Lightning runs through my wet fur."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我抓不住。", "en": "Nothing to grip. I'm falling."}
      ]
    }
  }
}
