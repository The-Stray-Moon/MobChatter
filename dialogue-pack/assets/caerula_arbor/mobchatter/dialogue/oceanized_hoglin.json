{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "湿蹄踩出黏响。", "en": "Wet hooves squelch with every step."},
        {"zh": "背上长满了壳。", "en": "Shells have grown over my back."},
        {"zh": "慢慢踱，不着急。", "en": "A slow pace. No hurry."},
        {"zh": "鼻子里全是海水味。", "en": "Seawater fills my snout."},
        {"zh": "獠牙刮过草皮。", "en": "My tusks rake the turf."},
        {"zh": "皮下的东西在爬。", "en": "Something moves under my hide."},
        {"zh": "往猪灵的气味走。", "en": "Following the smell of piglins."},
        {"zh": "沉重地挪动身子。", "en": "I shift my heavy bulk."},
        {"zh": "我走过，滩上多一串坑。", "en": "I pass and leave a line of pits in the shore."},
        {"zh": "地面被踩成泥。", "en": "My steps turn the ground to mud."},
        {"zh": "沿着海岸线走。", "en": "I walk the shoreline."},
        {"zh": "一步一步巡视。", "en": "Pacing out my territory."},
        {"zh": "喉咙里有水声。", "en": "Water rattles in my throat."},
        {"zh": "壳与壳互相摩擦。", "en": "Shell plates grind together."},
        {"zh": "这股潮味让我清醒。", "en": "This tide smell keeps me alert."},
        {"zh": "走得像块会动的礁石。", "en": "I move like a walking reef."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站定，鳃盖在动。", "en": "Standing still, gills working."},
        {"zh": "嚼着嘴里的海草。", "en": "Chewing the seaweed in my mouth."},
        {"zh": "身上的藤壶痒。", "en": "The barnacles itch."},
        {"zh": "盯着远处的水面。", "en": "I stare at the distant water."},
        {"zh": "鼻子抽了两下。", "en": "Two sniffs of the air."},
        {"zh": "皮肉鼓了一下。", "en": "A lump bulges in my flank."},
        {"zh": "听潮声起落。", "en": "Listening to the tide rise and fall."},
        {"zh": "獠牙上还挂着肉丝。", "en": "Meat still clings to my tusks."},
        {"zh": "把背在石头上蹭。", "en": "I scrape my back on the rock."},
        {"zh": "慢慢喘着气。", "en": "Breathing slow and heavy."},
        {"zh": "什么在壳下面动。", "en": "Something stirs under the shell."},
        {"zh": "嘴角淌着咸水。", "en": "Salt water runs from my jaw."},
        {"zh": "站在这片湿地上。", "en": "I stand in this wet ground."},
        {"zh": "等着谁先靠近。", "en": "Waiting for someone to come close."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上是干土味。", "en": "You smell of dry earth."},
        {"zh": "看着我，别退。", "en": "Look at me. Don't back off."},
        {"zh": "我认得活物。", "en": "I know living things."},
        {"zh": "你的腿在抖。", "en": "Your legs are shaking."},
        {"zh": "站远点，我饿。", "en": "Stay back. I'm hungry."},
        {"zh": "你也会变成这样。", "en": "You'll turn like this too."},
        {"zh": "这里的水已经改了。", "en": "The water here has changed."},
        {"zh": "别伸手，獠牙不客气。", "en": "Hands off. My tusks don't ask."},
        {"zh": "你的气味很淡。", "en": "Your scent is faint."},
        {"zh": "你握东西的手，一直在发抖。", "en": "The hand holding that thing keeps shaking."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "裂口里渗出咸水。", "en": "Salt water seeps from the crack."},
        {"zh": "我的血是咸的。", "en": "My blood tastes of salt."},
        {"zh": "我发出低吼。", "en": "I let out a low bellow."},
        {"zh": "皮下的东西缩了一下。", "en": "Something under my hide flinched."},
        {"zh": "退半步，站稳。", "en": "Half a step back. Steady."},
        {"zh": "这伤口不算深。", "en": "The wound isn't deep."},
        {"zh": "獠牙还好好在。", "en": "My tusks are still sound."},
        {"zh": "水从伤口冒出来。", "en": "Water seeps from the wound."},
        {"zh": "我记住了你的味。", "en": "I've learned your scent."},
        {"zh": "獠牙还齐，我还能顶。", "en": "My tusks are still whole and I can still charge."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这味道，能吃吗。", "en": "This smell. Is it food?"},
        {"zh": "拿来，我不挑。", "en": "Give it. I'm not picky."},
        {"zh": "海里的东西最好。", "en": "Things from the sea are best."},
        {"zh": "生的也行，快给我。", "en": "Raw works. Give it here."},
        {"zh": "我嗅到腐味了。", "en": "I caught a rot smell."},
        {"zh": "放地上，我过去。", "en": "Set it down. I'll come."},
        {"zh": "别拿走那一块。", "en": "Don't take that piece."},
        {"zh": "我什么都吞得下。", "en": "I can swallow anything."},
        {"zh": "这个气味很新。", "en": "This scent is new."},
        {"zh": "再给我一点。", "en": "Give me a little more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我得用命赔。", "en": "Bumping me costs you."},
        {"zh": "湿壳很滑吧。", "en": "The shell is slick, isn't it."},
        {"zh": "退开，我在走。", "en": "Back off. I'm moving."},
        {"zh": "你的肩膀撞疼了。", "en": "Your shoulder must ache."},
        {"zh": "别挤在礁石边。", "en": "Don't crowd the rocks."},
        {"zh": "我这一身壳很硬。", "en": "This hide is hard."},
        {"zh": "你踩到我的湿泥了。", "en": "You stepped in my mud."},
        {"zh": "再推我就转身。", "en": "Push again and I'll turn."},
        {"zh": "我身上还在滴水。", "en": "I'm still dripping."},
        {"zh": "退开，蹄下全是我的泥。", "en": "Back off — the mud under my hooves is mine."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "海不需要这个。", "en": "The sea has no need of that."},
        {"zh": "我只想吞和长。", "en": "I only want to eat and grow."},
        {"zh": "潮水会把我们连起来。", "en": "The tide will join us."},
        {"zh": "等长到更大。", "en": "When I've grown larger."},
        {"zh": "这些壳会分给你。", "en": "These shells will be yours too."},
        {"zh": "潮水退了再说。", "en": "Wait for the tide to fall."},
        {"zh": "水里比岸上暖和。", "en": "The water is warmer than the shore."},
        {"zh": "我没有那份心。", "en": "I don't have that in me."},
        {"zh": "海嗣不这样繁衍。", "en": "Seaborn don't breed that way."},
        {"zh": "跟着潮声走就行。", "en": "Just follow the tide."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个能吞下去。", "en": "This can be swallowed."},
        {"zh": "捡起来压在蹄下。", "en": "I pin it under my hoof."},
        {"zh": "一小块肉，归我。", "en": "A morsel of meat. Mine."},
        {"zh": "石头上有藻。", "en": "Algae on this stone."},
        {"zh": "收进壳缝里。", "en": "I tuck it into a shell gap."},
        {"zh": "没用也含着。", "en": "Useless, but I'll hold it."},
        {"zh": "这东西有海水味。", "en": "This thing smells of seawater."},
        {"zh": "沙里还埋着半块。", "en": "Half a piece buried in sand."},
        {"zh": "我的嘴比手好用。", "en": "My mouth works better than hands."},
        {"zh": "谁掉的就归我了。", "en": "Whatever's dropped is mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那股猪灵味。", "en": "That piglin smell."},
        {"zh": "是活的，还在动。", "en": "Alive and moving."},
        {"zh": "獠牙开始发痒。", "en": "My tusks itch."},
        {"zh": "礁石后面有活物在喘。", "en": "Something breathes behind the rocks."},
        {"zh": "别再靠近水边。", "en": "Don't come nearer the water."},
        {"zh": "你踏进了我的滩。", "en": "You've stepped into my shallows."},
        {"zh": "现在该吃饭了。", "en": "Now it's time to eat."},
        {"zh": "壳下的肌肉绷紧。", "en": "The muscle under my shell tightens."},
        {"zh": "转头，对准它。", "en": "I turn and face it."},
        {"zh": "让它跑两步。", "en": "Let it run two steps."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着这股味。", "en": "I follow that scent."},
        {"zh": "它往石堆后面躲。", "en": "It's hiding behind the stones."},
        {"zh": "潮水会截住它。", "en": "The tide will cut it off."},
        {"zh": "慢一点，别惊它。", "en": "Slow. Don't spook it."},
        {"zh": "蹄子踩得很轻。", "en": "My hooves fall quietly."},
        {"zh": "它回头看我了。", "en": "It glanced back at me."},
        {"zh": "它的蹄声一乱，我就知道。", "en": "When its hoofbeats falter, I know."},
        {"zh": "海腥味把它圈在这了。", "en": "The smell of the sea has it penned here."},
        {"zh": "它无路可退了。", "en": "It has nowhere left."},
        {"zh": "我的影子盖住它。", "en": "My shadow covers it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "獠牙顶过去！", "en": "Tusks drive in!"},
        {"zh": "一口就把你咬住。", "en": "One bite and I have you."},
        {"zh": "用壳撞开它。", "en": "I ram it with my shell."},
        {"zh": "压下去，别动。", "en": "Down. Stay down."},
        {"zh": "这一口带着海腥。", "en": "This bite tastes of the sea."},
        {"zh": "甩头把它撕开来。", "en": "I shake my head and tear it."},
        {"zh": "蹄子踩上去。", "en": "My hoof comes down."},
        {"zh": "这肉还在动呢。", "en": "The meat is still moving."},
        {"zh": "别再白费力气了。", "en": "Stop wasting your strength."},
        {"zh": "吞下去就完了。", "en": "Swallow and it's done."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "海水推我上岸。", "en": "The sea pushes me ashore."},
        {"zh": "我从浪里走出来。", "en": "I walk out of the surf."},
        {"zh": "身上还挂着藻。", "en": "Algae still hangs on me."},
        {"zh": "这片滩归我了。", "en": "This shore is mine."},
        {"zh": "壳一片片硬起来。", "en": "My plates harden one by one."},
        {"zh": "潮味盖住了风。", "en": "Tide smell smothers the wind."},
        {"zh": "脚踩在湿沙上。", "en": "Feet on wet sand."},
        {"zh": "我长得比昨天大。", "en": "I'm bigger than yesterday."},
        {"zh": "谁在这片地上？", "en": "Who's on this ground?"},
        {"zh": "这片滩的泥，刚被我踩软。", "en": "The mud on this shore is still soft from my steps."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧焦了我的湿皮。", "en": "Fire scorched my wet hide."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时壳撞得发响。", "en": "My shell clattered on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我反而不适。", "en": "Water, and I'm uncomfortable."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "壳被震得发白。", "en": "The blast bleached my shell."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉进我的背。", "en": "Something stuck in my back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光让海嗣不安。", "en": "That light unsettles the seaborn in me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得獠牙发软。", "en": "Hunger weakens my tusks."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打湿滩，我浑身一颤。", "en": "Lightning on the wet shore jolted me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有滩了。", "en": "No shore beneath me."}
      ]
    }
  }
}
