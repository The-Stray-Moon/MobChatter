{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着水底窜过去。", "en": "I dart along the seabed."},
        {"zh": "小身子一摆，就远了一截。", "en": "One flick of my small body carries me far."},
        {"zh": "我绕着礁石转圈。", "en": "I circle the reef stone."},
        {"zh": "水里划出一道细纹。", "en": "A thin line cuts through the water."},
        {"zh": "我逆着水流冲。", "en": "I push against the current."},
        {"zh": "几条一起游，像一片碎影。", "en": "A few of us swim like scattered shadows."},
        {"zh": "我靠得太近礁壁。", "en": "I have come too near the reef wall."},
        {"zh": "尾鳍一拍，加速。", "en": "A beat of my tail and I accelerate."},
        {"zh": "我钻进水草里。", "en": "I slip into the weeds."},
        {"zh": "一群从我身边掠过。", "en": "A group flashes past me."},
        {"zh": "我在浅水里转了个弯。", "en": "I bank in the shallows."},
        {"zh": "身体小，转身也快。", "en": "Small body, quick turns."},
        {"zh": "我冒了个泡。", "en": "I let out a bubble."},
        {"zh": "我游得没个方向。", "en": "I swim without a clear direction."},
        {"zh": "水底的沙被我扬起。", "en": "I kick up the sand."},
        {"zh": "我顺着暗流一直游。", "en": "I ride the undercurrent on and on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，尾鳍轻摆。", "en": "I hover, tail fin moving gently."},
        {"zh": "水光在我鳞上跳。", "en": "The water's light dances on my scales."},
        {"zh": "水草边有点动静。", "en": "Something stirs by the water grass."},
        {"zh": "礁缝里很阴凉。", "en": "The reef crack is cool and dark."},
        {"zh": "我吐出一串小泡。", "en": "I release a string of small bubbles."},
        {"zh": "周围没有大鱼。", "en": "There are no big fish around."},
        {"zh": "我贴着石头不动。", "en": "I hold still against the stone."},
        {"zh": "鳃一开一合。", "en": "My gills open and close."},
        {"zh": "我听得见水压的变化。", "en": "I can feel the pressure shift."},
        {"zh": "这片水，我很熟。", "en": "I know this water well."},
        {"zh": "我轻轻晃着身子。", "en": "I rock gently."},
        {"zh": "上面有影子掠过。", "en": "A shadow passes above."},
        {"zh": "我没有停太久。", "en": "I never linger long."},
        {"zh": "我警觉地转了下头。", "en": "I turn my head, alert."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在水里？", "en": "You are standing in the water?"},
        {"zh": "我绕你的脚踝转。", "en": "I circle your ankle."},
        {"zh": "你比礁石还大。", "en": "You are bigger than the reef."},
        {"zh": "我一动，你就看不见了。", "en": "If I move, you will lose sight of me."},
        {"zh": "我贴着你的小腿打转。", "en": "I circle against your calf."},
        {"zh": "你抬手，我就退。", "en": "Raise your hand, and I back off."},
        {"zh": "这里每道水纹我都熟。", "en": "I know every ripple here."},
        {"zh": "你身上有血味吗？", "en": "Is that blood I smell on you?"},
        {"zh": "我不大，但我很快。", "en": "I am small, but swift."},
        {"zh": "你再靠近，我就扑。", "en": "Come closer, and I lunge."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我猛地窜开。", "en": "I bolt away."},
        {"zh": "鳞被打掉几片。", "en": "A few scales were knocked off."},
        {"zh": "挨了一下，我就还口。", "en": "Struck once, I bite back once."},
        {"zh": "水底腾起一层沙。", "en": "A layer of sand lifts off the bottom."},
        {"zh": "我转了两圈才停。", "en": "I spin twice before stopping."},
        {"zh": "身子有点歪。", "en": "My body is slightly crooked."},
        {"zh": "我摆尾还能动。", "en": "My tail can still work."},
        {"zh": "我的血把水染出一缕。", "en": "My blood stains the water in a thread."},
        {"zh": "快离我远点。", "en": "Get away from me."},
        {"zh": "我躲进礁缝里。", "en": "I duck into a reef crack."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有东西的味道。", "en": "Something tasty is in the water."},
        {"zh": "扔进来，我抢。", "en": "Drop it in; I will snatch it."},
        {"zh": "这块太硬了。", "en": "This piece is too hard."},
        {"zh": "我绕着饵打了个转。", "en": "I circle the bait once."},
        {"zh": "你把饵按在水面别动。", "en": "Hold the bait still at the surface."},
        {"zh": "我先咬一小口。", "en": "Let me take a small bite first."},
        {"zh": "这水里的味道变了。", "en": "The taste of the water has changed."},
        {"zh": "我一口就吞了。", "en": "I swallow it in one go."},
        {"zh": "还有没有别的？", "en": "Is there anything else?"},
        {"zh": "其他几条也在看。", "en": "The others are watching too."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞在你腿上，弹开。", "en": "I bump your leg and bounce away."},
        {"zh": "小身子撞得不重。", "en": "A small body does not hit hard."},
        {"zh": "我被水推得偏了。", "en": "The water shoves me off course."},
        {"zh": "我打了两个转才停。", "en": "I spun twice before stopping."},
        {"zh": "你挡了我的道。", "en": "You are in my way."},
        {"zh": "我撞完就跑。", "en": "I hit and run."},
        {"zh": "水花在我周围炸开。", "en": "A splash bursts around me."},
        {"zh": "我眼前有点花。", "en": "My sight is swimming."},
        {"zh": "别用脚踢水。", "en": "Do not kick at the water."},
        {"zh": "我又游回你脚边。", "en": "I swim back to your feet."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "几条一起，更安全。", "en": "A few together is safer."},
        {"zh": "水里一片细影。", "en": "A blur of small shadows in the water."},
        {"zh": "我跟着前面那条。", "en": "I follow the one ahead."},
        {"zh": "转向要整齐。", "en": "We must turn together."},
        {"zh": "礁缝里能躲。", "en": "The reef cracks will hide us."},
        {"zh": "不要游散了。", "en": "Do not scatter."},
        {"zh": "这一群，越来越多了。", "en": "This school keeps growing."},
        {"zh": "水流带我们走。", "en": "The current carries us."},
        {"zh": "同一种鳞色。", "en": "The same scale colour."},
        {"zh": "游得再快些。", "en": "Swim a little faster."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住就往下沉。", "en": "I bite and sink with it."},
        {"zh": "太小了，塞牙缝。", "en": "Too small. It barely fills the gap."},
        {"zh": "我一口吞掉。", "en": "I swallow it whole."},
        {"zh": "沉到沙里的，我翻出来。", "en": "I root out what sank into the sand."},
        {"zh": "这口已经变味了。", "en": "This bite has turned."},
        {"zh": "它从嘴里滑走了。", "en": "It slipped out of my mouth."},
        {"zh": "我把它抢到了。", "en": "I snatched it."},
        {"zh": "分我一点，别全吃。", "en": "Leave me some."},
        {"zh": "味道还凑合。", "en": "The taste will do."},
        {"zh": "我叼着游开。", "en": "I swim off with it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水流被搅了一下。", "en": "The current got disturbed."},
        {"zh": "我朝那边冲。", "en": "I rush that way."},
        {"zh": "水纹乱走了。", "en": "The ripples are running wrong."},
        {"zh": "那东西是你。", "en": "That thing is you."},
        {"zh": "我尾巴一摆就冲出去。", "en": "One flick of my tail and I dart."},
        {"zh": "你在我的水里。", "en": "You are in my water."},
        {"zh": "水纹一乱，我就扑。", "en": "The ripples break, and I lunge."},
        {"zh": "小的也会咬人。", "en": "Small things bite too."},
        {"zh": "我摆好尾鳍。", "en": "I set my tail fin."},
        {"zh": "我冲上去了。", "en": "I am charging in."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你的水纹。", "en": "I follow your ripples."},
        {"zh": "你踩的地方有影子。", "en": "There is a shadow where you step."},
        {"zh": "我绕你一圈。", "en": "I circle you once."},
        {"zh": "我在你脚踝旁的水里。", "en": "I am in the water beside your ankle."},
        {"zh": "你抬脚，我就沉。", "en": "You lift a foot, and I dive."},
        {"zh": "水底我能藏。", "en": "I can hide in the murk."},
        {"zh": "再凑近半格。", "en": "Half a block nearer."},
        {"zh": "你转身，我就换边。", "en": "You turn, and I switch sides."},
        {"zh": "我等着你下水。", "en": "I wait for you to enter the water."},
        {"zh": "只差一点点。", "en": "Just barely short."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬上去。", "en": "I bite into you."},
        {"zh": "小牙，也够疼。", "en": "Small teeth still hurt."},
        {"zh": "我撞在你脚踝。", "en": "I butt your ankle."},
        {"zh": "扑上去就咬。", "en": "I lunge and bite."},
        {"zh": "你被拽得歪了一下。", "en": "You were tugged off balance."},
        {"zh": "我咬完就退。", "en": "I bite and retreat."},
        {"zh": "水花溅了起来。", "en": "Water splashes up."},
        {"zh": "这一下不算深。", "en": "That one did not go deep."},
        {"zh": "我绕回来再试。", "en": "I circle back to try again."},
        {"zh": "你在往外流血。", "en": "You are bleeding out."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "水里多了几条细影。", "en": "A few small shadows appear in the water."},
        {"zh": "我从水下钻出来。", "en": "I slip up from under the water."},
        {"zh": "一摆尾，我就到了。", "en": "One tail flick and I am here."},
        {"zh": "水面上泛开一圈纹。", "en": "A ring spreads on the surface."},
        {"zh": "我冲得很急。", "en": "I came in fast."},
        {"zh": "这一带全是我们的水。", "en": "All this water is ours."},
        {"zh": "我冒出水泡。", "en": "I blow bubbles."},
        {"zh": "我贴着礁石出现。", "en": "I appear along the reef."},
        {"zh": "几条一起上。", "en": "Several of us at once."},
        {"zh": "我盯着上方。", "en": "I watch above."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面有火，我不敢上去。", "en": "There is fire on the surface, so I stay down."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我被甩出水面，摔在岸上。", "en": "I was flung out and landed on the bank."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里是我的家，可这一口气不对。", "en": "The water is my home, but this breath is wrong."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我甩进礁缝。", "en": "The blast throws me into a reef crack."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西从水里钻进来。", "en": "Something bored in through the water."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光在水里也没散。", "en": "The light did not fade even in water."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "水里找不到吃的。", "en": "I cannot find anything to eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着水爬满我的鳞。", "en": "Lightning crawls across every scale."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "鳃里干得发疼。", "en": "My gills ache with dryness."}
      ]
    }
  }
}
