{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你直直地扑", "en": "I lunge straight at you."},
        {"zh": "我从浅水里扑上岸", "en": "I lunge from the shallows onto land."},
        {"zh": "我差不多贴着泥爬", "en": "I crawl almost flat on the mud."},
        {"zh": "我一段一段往前拱", "en": "I hump forward segment by segment."},
        {"zh": "我甩开身上的水", "en": "I shake the water off."},
        {"zh": "我斜着冲向岸边", "en": "I veer toward the bank."},
        {"zh": "我一边游一边找", "en": "I swim and search at once."},
        {"zh": "我拐了个弯绕过来", "en": "I bend my course around."},
        {"zh": "我扒着石头往上爬", "en": "I claw up over the stone."},
        {"zh": "我一步跨过水洼", "en": "I hop over the puddle."},
        {"zh": "我贴着你的影子走", "en": "I follow along your shadow."},
        {"zh": "我不停地往前挪", "en": "I keep pressing forward."},
        {"zh": "我把水草撞开", "en": "I barge through the weeds."},
        {"zh": "我蹭着河岸爬", "en": "I scrape along the riverbank."},
        {"zh": "我一路留下湿痕", "en": "I leave a wet trail behind."},
        {"zh": "我探着头往前走", "en": "I go with my head craned out."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着，身体在动", "en": "I crouch, my body working."},
        {"zh": "我的表面在翻涌", "en": "My surface churns."},
        {"zh": "我在水里转着圈", "en": "I turn circles in the water."},
        {"zh": "我的触须伸出去又收回", "en": "My tendrils reach and withdraw."},
        {"zh": "我在闻空气里的味道", "en": "I am tasting the air."},
        {"zh": "我伏在石头上不动", "en": "I lie still on the stone."},
        {"zh": "我的身体里有光在动", "en": "Light moves inside my body."},
        {"zh": "我慢慢鼓起来又瘪下去", "en": "I swell and deflate slowly."},
        {"zh": "我一直在看岸上", "en": "I am looking at the bank."},
        {"zh": "我的呼吸带着水声", "en": "My breathing comes with water sounds."},
        {"zh": "我把身体贴在石头上", "en": "I press my body to the stone."},
        {"zh": "我在等水再退一点", "en": "I wait for the water to fall."},
        {"zh": "我把几条腕足缠在一起", "en": "I knot a few cirri together."},
        {"zh": "我一节一节地蠕动", "en": "I ripple segment by segment."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头，全是眼", "en": "I raise my head, all eyes."},
        {"zh": "我已经看见你了", "en": "I have already seen you."},
        {"zh": "我往你那边靠", "en": "I lean your way."},
        {"zh": "我的身体在收紧", "en": "My body pulls taut."},
        {"zh": "你在岸上站着", "en": "You are standing on the bank."},
        {"zh": "我盯上了你的脚跟", "en": "I have my eye on your heel."},
        {"zh": "我伸出一根腕足", "en": "I extend one cirrus."},
        {"zh": "我根本没把你放眼里", "en": "I do not count you at all."},
        {"zh": "你退到水里来吧", "en": "Come down into the water."},
        {"zh": "我在等你先挪脚", "en": "I wait for your foot to move."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
