{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面滑行。", "en": "I slide along close to the ground."},
        {"zh": "四足撑起细长的身子。", "en": "Four limbs hold up this narrow body."},
        {"zh": "我绕着礁石走位。", "en": "I weave around the reef stones."},
        {"zh": "先找好射击的角度。", "en": "First, find a good firing angle."},
        {"zh": "我把肚皮贴到湿泥上。", "en": "I press my belly to the wet mud."},
        {"zh": "湿泥里走起来黏。", "en": "The wet mud is sticky to walk."},
        {"zh": "我沿着岸线推进。", "en": "I advance along the shoreline."},
        {"zh": "身上的囊袋一鼓一瘪。", "en": "The sacs on me swell and slacken."},
        {"zh": "雾遮住了我的形状。", "en": "The fog hides my outline."},
        {"zh": "我挪到礁石背面藏好。", "en": "I settle behind the back of the reef stone."},
        {"zh": "距离不够就再近些。", "en": "Not close enough; move closer."},
        {"zh": "我的步幅不大。", "en": "My stride is short."},
        {"zh": "爪子扣住湿滑的岩面。", "en": "My claws grip the slick rock."},
        {"zh": "我慢慢挪到射程内。", "en": "I shift slowly into range."},
        {"zh": "身后留下一串湿印。", "en": "A trail of wet marks follows me."},
        {"zh": "我侧身走过裂缝。", "en": "I edge past the fissure."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏着，囊袋收着。", "en": "I crouch, sacs drawn in."},
        {"zh": "黏液在体内聚起来。", "en": "Slime gathers inside me."},
        {"zh": "我在等一个准头。", "en": "I'm waiting for a clean shot."},
        {"zh": "这具身体的皮很薄。", "en": "This body's hide is thin."},
        {"zh": "海嗣的声音在我脑里。", "en": "The Seaborn's voice is in my head."},
        {"zh": "我抬头嗅了嗅。", "en": "I lift my head and sniff."},
        {"zh": "风向正好，帮我藏住味道。", "en": "The wind's right; it hides my scent."},
        {"zh": "我把前肢收紧。", "en": "I tuck my forelimbs in."},
        {"zh": "黏液一滴落在地上。", "en": "A drop of slime falls."},
        {"zh": "有脚步踩碎了干贝壳。", "en": "Footsteps crunch dry shells."},
        {"zh": "我慢慢吐了口气。", "en": "I let out a slow breath."},
        {"zh": "石头后面很安全。", "en": "Behind this stone is safe."},
        {"zh": "我在数他的步伐。", "en": "I'm counting his paces."},
        {"zh": "囊袋还没鼓满呢。", "en": "A little longer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的肩膀全露在外面。", "en": "Your shoulders are all exposed."},
        {"zh": "这个距离我正好出手。", "en": "This is just the distance for me."},
        {"zh": "你身后那面墙挡不住我。", "en": "That wall behind you won't stop me."},
        {"zh": "我一直在瞄你。", "en": "I've been aiming at you."},
        {"zh": "你的护甲只护住胸口。", "en": "Your armor only guards your chest."},
        {"zh": "我不用靠太近。", "en": "I don't need to get close."},
        {"zh": "海嗣让我看着你。", "en": "The Seaborn tells me to watch you."},
        {"zh": "你左边有块石头。", "en": "There's a stone on your left."},
        {"zh": "你听得见囊袋的声音吗？", "en": "Can you hear the sacs?"},
        {"zh": "你要跑我就追。", "en": "Run, and I'll chase."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的囊袋破了一个。", "en": "A sac burst."},
        {"zh": "黏液从伤口流出来。", "en": "Slime leaks from the wound."},
        {"zh": "我的皮太薄了。", "en": "My hide is too thin."},
        {"zh": "我弹开半步，重新伏低。", "en": "I spring back half a step and crouch again."},
        {"zh": "疼得囊袋缩紧。", "en": "Pain tightens my sacs."},
        {"zh": "瞄准散了，我得重新找角度。", "en": "My aim scattered; I need a new angle."},
        {"zh": "我压低身子躲。", "en": "I duck lower."},
        {"zh": "血混着黏液流下。", "en": "Blood mixes with slime."},
        {"zh": "掩护没了，我得挪。", "en": "My cover's gone; I must move."},
        {"zh": "别逼我再挨一下。", "en": "Don't make me take another."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块东西是肉吗？", "en": "Is that meat?"},
        {"zh": "我没空吃东西。", "en": "No time to eat."},
        {"zh": "放低点，我看看。", "en": "Lower it so I can see."},
        {"zh": "那股腥甜，害我慢了半拍。", "en": "That sweetish reek cost me half a beat."},
        {"zh": "我不吃，我要打。", "en": "I'm not eating; I'm hunting."},
        {"zh": "留着自己用吧。", "en": "Keep it for yourself."},
        {"zh": "那股腥味是活的。", "en": "Smells alive."},
        {"zh": "放下，然后转过身。", "en": "Put it down and turn around."},
        {"zh": "吃东西会误了我的准头。", "en": "Eating would spoil my aim."},
        {"zh": "黏液在我嘴里变酸。", "en": "Slime turns sour in my mouth."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了我的囊袋。", "en": "You bumped my sacs."},
        {"zh": "这一下差点把黏液挤出来。", "en": "That nearly squeezed the slime out."},
        {"zh": "我被推得退了半格。", "en": "I was shoved back half a block."},
        {"zh": "别靠这么近，我瞄不准。", "en": "Don't crowd me; I can't aim."},
        {"zh": "我的皮经不起撞。", "en": "My hide can't take impacts."},
        {"zh": "尾巴一抽，囊袋差点漏出来。", "en": "My tail jerks and my sacs nearly burst."},
        {"zh": "我们错开一点。", "en": "Let's pass."},
        {"zh": "撞得我囊袋里一阵翻。", "en": "The bump sloshed everything in my sacs."},
        {"zh": "我的囊袋漏了一点。", "en": "A little leaked from my sacs."},
        {"zh": "再撞我就先打你。", "en": "Bump me again and I shoot first."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没这个打算。", "en": "That's not my intention."},
        {"zh": "海嗣不该这样延续。", "en": "Seaborn don't continue that way."},
        {"zh": "我在忙着找目标。", "en": "I'm busy finding targets."},
        {"zh": "这具身体太瘦。", "en": "This body is too thin."},
        {"zh": "你离得远一点。", "en": "Get farther away."},
        {"zh": "潮水还在涨着。", "en": "The tide is still rising."},
        {"zh": "我不懂这些事。", "en": "I don't understand such things."},
        {"zh": "现在真的不行。", "en": "Not now."},
        {"zh": "别打断我瞄人。", "en": "Don't interrupt my aim."},
        {"zh": "你换个位置站。", "en": "Stand somewhere else."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我扒拉两下，把它翻过来。", "en": "I paw at it twice and flip it over."},
        {"zh": "这个能堵住囊袋。", "en": "This could plug a sac."},
        {"zh": "肉块，留到以后。", "en": "Meat; save it for later."},
        {"zh": "太沉了，我用囊袋顶它。", "en": "Too heavy; I nudge it with my sacs."},
        {"zh": "我把它踢到石头后面。", "en": "I kick it behind the stone."},
        {"zh": "这是谁的组织？", "en": "Whose tissue is this?"},
        {"zh": "它黏在我爪上。", "en": "It's stuck to my claw."},
        {"zh": "留着当诱饵用。", "en": "Keep it as bait."},
        {"zh": "先放在这儿吧。", "en": "Leave it here for now."},
        {"zh": "我在检查有没有血。", "en": "I'm checking it for blood."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西进我的视线了。", "en": "Something entered my line of sight."},
        {"zh": "我把前肢抬起来。", "en": "I raise my forelimbs."},
        {"zh": "囊袋鼓起来了。", "en": "My sacs are swelling."},
        {"zh": "先瞄准它的头。", "en": "Aim for the head first."},
        {"zh": "这个角度很干净。", "en": "This angle is clean."},
        {"zh": "他还没看见我。", "en": "He hasn't seen me yet."},
        {"zh": "我把呼吸压住了。", "en": "I hold my breath."},
        {"zh": "只有三格距离。", "en": "Three blocks of distance."},
        {"zh": "就只打这一发。", "en": "Just this one shot."},
        {"zh": "你千万不要乱动。", "en": "Don't move."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢平移找角度。", "en": "I side-step slowly for a better angle."},
        {"zh": "你躲在石头后，我不急。", "en": "You're behind the stone; I'm patient."},
        {"zh": "囊袋又鼓了一圈。", "en": "The sacs swelled another ring."},
        {"zh": "我顺着岩缝摸到你的侧后。", "en": "I creep along the rock seam to your flank."},
        {"zh": "你探头的瞬间就是机会。", "en": "The moment you peek is my chance."},
        {"zh": "我贴着地，很难被看到。", "en": "I'm low to the ground, hard to see."},
        {"zh": "再退就出射程了。", "en": "Another step back and you're out of range."},
        {"zh": "他的肩膀露出来了。", "en": "His shoulder is exposed."},
        {"zh": "你往左躲，我就往左喷。", "en": "Dodge left, and that's where I spit."},
        {"zh": "这一发要落在他脚前。", "en": "This one lands in front of his feet."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "黏液喷出去了。", "en": "The slime sprays out."},
        {"zh": "正中你的胸口。", "en": "Square in your chest."},
        {"zh": "补上一记前肢。", "en": "A forelimb strike follows."},
        {"zh": "腐蚀得相当快。", "en": "It corrodes fast."},
        {"zh": "喷得你睁不开眼。", "en": "You can't open your eyes."},
        {"zh": "黏液在地上冒烟。", "en": "The slime smokes on the ground."},
        {"zh": "你被推得歪了。", "en": "You were knocked off balance."},
        {"zh": "再补上一发黏液。", "en": "Another shot."},
        {"zh": "我的爪子划到你了。", "en": "My claw raked you."},
        {"zh": "别用手去擦它。", "en": "Don't wipe it with your hand."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水边爬上来。", "en": "I crawl up from the water's edge."},
        {"zh": "囊袋里已经满了。", "en": "My sacs are already full."},
        {"zh": "先找一处掩体。", "en": "Find cover first."},
        {"zh": "这里到处是石头。", "en": "Stones everywhere here."},
        {"zh": "风向我这边吹。", "en": "Wind blows toward me."},
        {"zh": "岸上的风一吹，我打了个抖。", "en": "The shore wind hits and I shudder."},
        {"zh": "我把身子压低了。", "en": "I flatten down."},
        {"zh": "远处有个人影。", "en": "A figure far off."},
        {"zh": "海嗣在召唤我。", "en": "The Seaborn calls me."},
        {"zh": "我慢慢爬到石缝里。", "en": "I creep into a rock crevice."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到囊袋，黏液沸腾。", "en": "Fire hit a sac; the slime boiled."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从岩壁上摔下来。", "en": "I fell from the rock wall."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我压得喘不上气。", "en": "Water crushes the breath out of me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把黏液全掀翻了。", "en": "The blast blew all my slime away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过我的肩。", "en": "An arrow passed through my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的囊袋抽紧。", "en": "The spell clenches my sacs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "囊袋里没东西可喷了。", "en": "There's nothing left in my sacs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在湿皮上，我抽紧。", "en": "Lightning struck my wet hide; I clenched."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面没有可以贴的地。", "en": "There's no ground to cling to."}
      ]
    }
  }
}
