    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗中，我苏醒了！", "en": "In the dark, I awaken."},
        {"zh": "齿环转起来，我爬出来了。", "en": "My ring of teeth spins; I have crawled out."},
        {"zh": "夜幕下，我狩猎！", "en": "In the night, I hunt."},
        {"zh": "腐肉滋养我！", "en": "Decay feeds me."},
        {"zh": "阴影中，我成长！", "en": "In shadows, I grow."},
        {"zh": "饥饿的呼唤！", "en": "The call of hunger."},
        {"zh": "这片土地，我的领地！", "en": "This land, my territory."},
        {"zh": "寂静，我开始行动！", "en": "Silence, I move."},
        {"zh": "我的眼睛，黑暗！", "en": "My eyes, darkness."},
        {"zh": "腐烂的气息，我的召唤！", "en": "The stench of decay, my call."},
        {"zh": "石缝里钻出一条盘着的龙。", "en": "A coiled dragon wrings itself out of the rock."},
