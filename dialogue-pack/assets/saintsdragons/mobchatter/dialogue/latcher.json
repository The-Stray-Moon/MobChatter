        {"zh": "獠牙扎进你的小臂！", "en": "Fangs punch into your forearm!"},
        {"zh": "它整条扑上来，把你拽倒！", "en": "It throws its full length and drags you down!"},
        {"zh": "毒牙划开你的侧肋！", "en": "Venom fangs rake your ribs!"},
        {"zh": "它咬住你的靴子往后拖！", "en": "It bites your boot and hauls backward!"},
        {"zh": "它的头撞在你胸口！", "en": "Its skull rams your chest!"}
      ]
