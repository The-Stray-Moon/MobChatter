  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "炙焰在背，脚步沉稳。", "en": "Fiery spine, steady steps."},
        {"zh": "火焰舔舐大地，步步为营。", "en": "Flames lick the ground, each step counts."},
        {"zh": "尾随热浪，缓缓行进。", "en": "Following the heat wave, it moves slowly."},
        {"zh": "炙热身躯，稳健前行。", "en": "Burning body, steady stride."},
        {"zh": "炽热之躯，缓缓移动。", "en": "Fiery form, slow movement."},
        {"zh": "炎焰缭绕，缓缓挪动。", "en": "Writhing flames, slow movement."},
        {"zh": "热浪滚滚，稳步前行。", "en": "Rumbling heat, steady advance."},
        {"zh": "炙热体魄，沉重步伐。", "en": "Burning body, heavy footsteps."},
        {"zh": "火焰环绕，步步为营地行进。", "en": "Flames encircle, advancing step by step."},
        {"zh": "炽热之躯，稳重前行。", "en": "Burning form, steady pace."},
        {"zh": "六条腿压下焦黑岩层。", "en": "Six legs press into the scorched rock."},
        {"zh": "足迹过处，草不再生。", "en": "Where I walk, no grass returns."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静立火海之中。", "en": "Standing in the midst of flames."},
        {"zh": "火海中的沉思者。", "en": "Thinker in the sea of flames."},
        {"zh": "火焰间缓慢踱步。", "en": "Slowly pacing in the flames."},
        {"zh": "静立火海，沉思片刻。", "en": "Standing in the flames, contemplating."},
        {"zh": "火焰中的冷静观察。", "en": "Cool observation in the flames."},
        {"zh": "火海中的静默守望。", "en": "Silent watch in the sea of flames."},
        {"zh": "火焰中的静止观察。", "en": "Steady observation in the flames."},
        {"zh": "在火海中徘徊。", "en": "Wandering in the flames."},
        {"zh": "火焰中的静止思考。", "en": "Pausing in the flames to think."},
        {"zh": "火海中的静止凝视。", "en": "Pausing in the flames to gaze."},
        {"zh": "鳞片缝隙透出红光。", "en": "Red light seeps between my scales."},
        {"zh": "尾尖一下一下敲着地面。", "en": "My tail tip taps the ground."},
        {"zh": "热浪在我身周打转。", "en": "Heat waves circle around me."},
        {"zh": "闭眼歇着，呼吸仍烫。", "en": "I rest with closed eyes, yet my breath still burns."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "感受到你的威胁。", "en": "Feeling your threat."},
        {"zh": "焦土从我的六条腿下铺开。", "en": "Burnt ground spreads beneath my six legs."},
        {"zh": "你让我分心了。", "en": "You're distracting me."},
        {"zh": "你站得太近，我鼻孔里的火亮了。", "en": "You stand too close; the fire in my nostrils flares."},
        {"zh": "你让我分心了，火焰。", "en": "You're distracting me, flames."},
        {"zh": "你的行动引起我的注意。", "en": "Your actions caught my attention."},
        {"zh": "你让我分心了，人类。", "en": "You're distracting me, human."},
        {"zh": "你闯入了我的领域，火焰。", "en": "You've entered my domain, flames."},
        {"zh": "你的行为引起我的注意。", "en": "Your behavior caught my attention."},
        {"zh": "你让我分心了，敌人。", "en": "You're distracting me, enemy."},
        {"zh": "你的影子投在我鳞片上。", "en": "Your shadow falls on my scales."},
        {"zh": "站远处说话，别靠近。", "en": "Speak from a distance. Do not come closer."}
      ]
    },
    "hurt": {
