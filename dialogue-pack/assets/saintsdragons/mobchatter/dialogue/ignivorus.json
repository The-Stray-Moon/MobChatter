    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰如潮，吞噬一切！", "en": "Flames surge, consuming all!"},
        {"zh": "你有何物，可与我争？", "en": "What do you have to contend with me?"},
        {"zh": "这里是我的领地，滚！", "en": "This is my territory, get out!"},
        {"zh": "别逼我展示獠牙！", "en": "Don't逼me show my fangs!"},
        {"zh": "火焰是我生命之源！", "en": "Fire is my lifeblood!"},
        {"zh": "你能否承受我的热量？", "en": "Can you withstand my heat?"},
        {"zh": "火焰中孕育力量！", "en": "Strength is born of flames!"},
        {"zh": "离我的蛋远点！", "en": "Keep away from my eggs!"},
        {"zh": "六条腿踩过，地面还在烧。", "en": "Six legs passed — the ground still burns."},
        {"zh": "那块肉放下，别烤焦了才递给我。", "en": "Put that meat down before you hand it to me burnt."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
