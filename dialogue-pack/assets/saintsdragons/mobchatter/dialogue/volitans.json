{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "深潜，追踪猎物。", "en": "Dive deep, seek prey."},
        {"zh": "毒素在水中蔓延。", "en": "Toxin spreads in water."},
        {"zh": "领地不容侵犯。", "en": "This is my territory."},
        {"zh": "水下压力巨大。", "en": "Underwater pressure immense."},
        {"zh": "游动中释放毒息。", "en": "Releases toxins while swimming."},
        {"zh": "警惕，有危险。", "en": "Alert, danger present."},
        {"zh": "猎物靠近了。", "en": "Prey approaches."},
        {"zh": "毒刺准备出击。", "en": "Poison spines ready."},
        {"zh": "猎杀者注意了。", "en": "Predators beware."},
        {"zh": "毒液腐蚀一切。", "en": "Toxic venom corrupts all."},
        {"zh": "背鳍划开水面，我贴着河底走。", "en": "My dorsal fin splits the surface as I hug the riverbed."},
        {"zh": "毒刺在身后拖出一道雾。", "en": "My spines trail a haze behind me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静卧在珊瑚丛中。", "en": "Lies still among coral."},
        {"zh": "慢慢吸收养分。", "en": "Absorbs nutrients slowly."},
        {"zh": "我漂在水草里，一动不动。", "en": "I drift in the weeds without moving."},
        {"zh": "环境压力稳定。", "en": "Environmental pressure steady."},
        {"zh": "平静地游弋。", "en": "Swims calmly."},
        {"zh": "毒液逐渐恢复。", "en": "Toxin regenerates."},
        {"zh": "偶尔瞥一眼。", "en": "Glances occasionally."},
        {"zh": "耐心守候猎物。", "en": "Patience with prey."},
        {"zh": "栖息于此已久。", "en": "Resides here long."},
        {"zh": "享受这片水域。", "en": "Enjoys this water."},
        {"zh": "我把鳍贴在石缝上歇息。", "en": "I rest my fins against a crevice."},
        {"zh": "水草缠住我的尾巴，我也不动。", "en": "Weeds snag my tail and I do not stir."},
        {"zh": "我在等潮水把猎物送来。", "en": "I wait for the tide to bring prey."},
        {"zh": "毒囊还满着，慢慢来。", "en": "My venom sac is full. There is time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "感受到你的存在。", "en": "Detects your presence."},
        {"zh": "你闯入了我的地盘。", "en": "Intruder in my territory."},
        {"zh": "鳍张开，你该后退了。", "en": "My fins are spread; step back."},
        {"zh": "快离开！", "en": "Leave now."},
        {"zh": "注意，危险来了。", "en": "Watch out, danger."},
        {"zh": "你无法逃离。", "en": "You cannot escape."},
        {"zh": "这片水湾，是我的毒窝。", "en": "This cove is my poisoned nest."},
        {"zh": "毒刺准备好。", "en": "Spines ready."},
        {"zh": "我的毒刺，只认这片水。", "en": "My venomous spines claim this water."},
        {"zh": "你离死亡不远了。", "en": "Close to death."},
        {"zh": "你踩进的水，浑了。", "en": "The water you stepped into has gone cloudy."},
        {"zh": "我数着你的脚步，一步一停。", "en": "I count your steps, one pause at a time."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身体受损，鳞片划破，疼痛难忍！", "en": "Scales are torn, pain unbearable!"},
        {"zh": "毒刺伤了我的皮肤，剧痛难忍！", "en": "Toxic spikes pierced my skin, agonizing pain!"},
        {"zh": "毒液侵蚀我的身体，痛苦难忍！", "en": "Poison seeps into my flesh, excruciating pain!"},
        {"zh": "毒素侵蚀我的肌肉，剧痛难忍！", "en": "Toxins eat away at my muscles, unbearable pain!"},
        {"zh": "环境压力伤了我的鳍，疼痛难忍！", "en": "Pressure wounds on my fins, unbearable pain!"},
        {"zh": "鳞片受损，刺痛难忍！", "en": "Damaged scales, sharp pain!"},
        {"zh": "毒息侵蚀我的肺，剧痛难忍！", "en": "Toxic fumes hurt my lungs, agonizing pain!"},
        {"zh": "环境压力刺痛我的鳃，剧痛难忍！", "en": "Pressure stabs my gills, unbearable pain!"},
        {"zh": "毒刺划破了我的皮肉，剧痛难忍！", "en": "Toxic spikes cut my flesh, unbearable pain!"},
        {"zh": "毒囊破了，嘴里发苦...", "en": "My venom sac burst. My mouth tastes bitter..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你看那绚烂的鳞片！", "en": "Look at those vibrant scales!"},
        {"zh": "别靠近，危险的触手！", "en": "Stay back, dangerous tentacles!"},
        {"zh": "我的毒息足以让你窒息！", "en": "My poisonous exhalation will suffocate you!"},
        {"zh": "尝尝毒刺的滋味吧！", "en": "Feel the sting of my poison!"},
        {"zh": "别把手伸进我的浅滩。", "en": "Keep your hands out of my shallows."},
        {"zh": "河水中的敌人，尝尝吧！", "en": "Enemy in the river, taste this!"},
        {"zh": "鲑鱼，我的早餐！", "en": "Salmon, my breakfast!"},
        {"zh": "毒息弥漫，你逃不出去！", "en": "Poisoned air, you can't escape!"},
        {"zh": "你无法战胜我，蓑鲉龙！", "en": "You can't defeat me, Volitans Dragon!"},
        {"zh": "我在这里守护着我的领地！", "en": "I protect my territory here!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "毒刺竖起来了，退回去。", "en": "My venom spines are up. Back off."},
        {"zh": "我们来比试比试！", "en": "Let's test each other!"},
        {"zh": "你的盔甲挡不住我的攻击！", "en": "Your armor can't stop my attack!"},
        {"zh": "你碰了不该碰的东西！", "en": "You touched something you shouldn't!"},
        {"zh": "你试图侵犯我的领地！", "en": "You're trying to invade my territory!"},
        {"zh": "你和我战斗是愚蠢的！", "en": "Foolish to fight me!"},
        {"zh": "别靠近我，否则你会后悔的！", "en": "Stay away from me, or you'll regret it!"},
        {"zh": "我的刺比你的剑还密。", "en": "My spines are thicker than your blade."},
        {"zh": "你触碰到了我的领地！", "en": "You've touched my territory!"},
        {"zh": "你的力量无法伤害我！", "en": "Your strength can't harm me!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到合适的配偶，繁衍后代！", "en": "Find a mate to reproduce!"},
        {"zh": "我的配偶，让我展示！", "en": "My mate, let me show you!"},
        {"zh": "在水中找我，我会等你！", "en": "Find me in the water, I'll wait for you!"},
        {"zh": "让我们的后代在水中游泳！", "en": "Let our offspring swim in the water!"},
        {"zh": "选择一个适合的伴侣！", "en": "Choose a suitable partner!"},
        {"zh": "我的配偶，靠近我！", "en": "My mate, come closer!"},
        {"zh": "水中找我，我在这里等你！", "en": "Find me in the water, I'll be here waiting!"},
        {"zh": "找到我的配偶，才能繁衍！", "en": "Find my mate to reproduce!"},
        {"zh": "我的配偶，展示我的力量！", "en": "My mate, show my strength!"},
        {"zh": "水中等我，我会来找你！", "en": "Wait for me in the water, I'll find you!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "鲑鱼，毒之馈赠！", "en": "Salmon, a gift of poison!"},
        {"zh": "鳕鱼，危险相伴！", "en": "Cod, danger lurking."},
        {"zh": "热带鱼，尝尝我的毒息！", "en": "Tropical fish, taste my venom."},
        {"zh": "河豚，你的死期到了！", "en": "Pufferfish, your time is up!"},
        {"zh": "鲑鱼，加入我的领地！", "en": "Salmon, join my domain!"},
