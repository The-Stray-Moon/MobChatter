    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我来了，入侵者！", "en": "Here, intruder!"},
        {"zh": "毒之呼吸，开始吧！", "en": "Venomous breath, begin!"},
        {"zh": "环境压力，让你屈服！", "en": "Environmental pressure, submit!"},
