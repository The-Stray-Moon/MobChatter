{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步走过去，很稳。", "en": "I walk over, steady step by step."},
        {"zh": "地板在我脚下响。", "en": "The floorboards creak under me."},
        {"zh": "我的关节有轻微的响声。", "en": "My joints give a faint whine."},
        {"zh": "你站着别动，我路过。", "en": "Stand still. I'm passing through."},
        {"zh": "我在找别的目标。", "en": "I'm looking for a different target."},
        {"zh": "我的影子比你高。", "en": "My shadow is taller than you."},
        {"zh": "走廊不长，我走得慢。", "en": "The corridor isn't long. I walk slowly."},
        {"zh": "灰尘从我肩上落下。", "en": "Dust falls from my shoulders."},
        {"zh": "我绕过椅子。", "en": "I step around the chair."},
        {"zh": "麦克风在我手里晃。", "en": "The microphone sways in my hand."},
        {"zh": "我不看你，你放心。", "en": "I'm not looking at you. Rest easy."},
        {"zh": "我的脚步很重，别怕。", "en": "My steps are heavy. Don't be afraid."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，头微微侧着。", "en": "I stand with my head slightly tilted."},
        {"zh": "我的眼睛里有光在转。", "en": "There's light moving in my eyes."},
        {"zh": "披萨店空的，只剩音乐盒。", "en": "The pizzeria is empty except for the music box."},
        {"zh": "我不碰人，只揍怪物。", "en": "I don't touch people, only monsters."},
        {"zh": "我只清怪物，不碰客人。", "en": "I clear monsters, not guests."},
        {"zh": "我的手垂在身侧。", "en": "My hands hang at my sides."},
        {"zh": "走廊尽头，没有多余的声音。", "en": "At the end of the hall, no extra sounds."},
        {"zh": "我慢慢地转过头。", "en": "I turn my head slowly."},
        {"zh": "音乐盒还在响。", "en": "The music box is still playing."},
        {"zh": "再等一会儿吧。", "en": "Wait a little longer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "怪物靠近，我就先动手。", "en": "When monsters come close, I move first."},
        {"zh": "不过我不会动手。", "en": "But I won't strike."},
        {"zh": "我的麦克风，砸怪物够用。", "en": "My microphone is enough for monsters."},
        {"zh": "你别挡着路。", "en": "Don't block the way."},
        {"zh": "你的心跳，我的麦克风收到了。", "en": "My microphone picked up your heartbeat."},
        {"zh": "你退后一点，我就能过去。", "en": "Step back, and I can pass."},
        {"zh": "我这张脸，是给客人看的。", "en": "This face is for the guests."},
        {"zh": "你别学我笑。", "en": "Don't try to copy my smile."},
        {"zh": "你挡在通道中间，我过不去。", "en": "You're blocking the aisle; I can't pass."},
        {"zh": "你挪一步就好。", "en": "Just one step aside."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中我的外壳。", "en": "You hit my shell."},
        {"zh": "铁被敲了一下。", "en": "The iron rang."},
        {"zh": "我的礼帽，歪了一点。", "en": "My top hat is a little crooked."},
        {"zh": "外壳上多了道凹痕。", "en": "Another dent in the casing."},
        {"zh": "我根本不怕疼。", "en": "I don't fear pain at all."},
        {"zh": "我的关节有点松。", "en": "My joint is a little loose."},
        {"zh": "你敲得铁皮发响。", "en": "You made the plating ring."},
        {"zh": "我抬手挡了第二下。", "en": "I raised a hand to block the second."},
        {"zh": "外壳被你撞凹了。", "en": "The shell is dented."},
        {"zh": "我还在运行。", "en": "I'm still running."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你把吃的拿开。", "en": "Put the food away."},
        {"zh": "我咬不动，也咽不下。", "en": "I can't bite, and I can't swallow."},
        {"zh": "我的嘴里是空的。", "en": "My mouth is empty inside."},
        {"zh": "你吃吧，我在看别处。", "en": "You eat; I'm watching elsewhere."},
        {"zh": "这东西对我没有用。", "en": "This is of no use to me."},
        {"zh": "我的动作是电机驱动的。", "en": "My movements are motor-driven."},
        {"zh": "你手上的油会弄脏我。", "en": "The grease on your hands will stain me."},
        {"zh": "披萨对我没用，我不吃。", "en": "Pizza does nothing for me; I don't eat."},
        {"zh": "我的注意力在别处。", "en": "My attention is elsewhere."},
        {"zh": "你吃吧，我不看。", "en": "Eat it. I won't watch."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，我晃了一下。", "en": "You hit me and I swayed."},
        {"zh": "我几乎没退。", "en": "I barely moved back."},
        {"zh": "撞我像撞一台冰箱。", "en": "Hitting me is like hitting a refrigerator."},
        {"zh": "你的肩膀撞在铁上。", "en": "Your shoulder hit iron."},
        {"zh": "你别贴着我。", "en": "Don't press against me."},
        {"zh": "我的手掌推在你的肩上。", "en": "My palm pushes against your shoulder."},
        {"zh": "你的力气推不动我。", "en": "Your strength can't move me."},
        {"zh": "你撞偏了我的领结，我扶正。", "en": "You knocked my bow tie crooked; I straighten it."},
        {"zh": "你的手麻了吧。", "en": "Your hand must be numb."},
        {"zh": "我继续走我的路。", "en": "I go on my way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "店里的玩偶，不兴这个。", "en": "Dolls in this place don't do that."},
        {"zh": "齿轮转起来，我才动。", "en": "My gears turn, and only then do I move."},
        {"zh": "我的程序里，没这一项。", "en": "This isn't in my programming."},
        {"zh": "我是机器，不懂得这个。", "en": "I'm a machine; I don't understand this."},
        {"zh": "我只需要运行。", "en": "I only need to run."},
        {"zh": "店里还有别的玩偶。", "en": "There are other animatronics in the diner."},
        {"zh": "它们也不会回答。", "en": "They won't answer either."},
        {"zh": "你一个人待太久了。", "en": "You've been alone too long."},
        {"zh": "我理解不了。", "en": "I can't understand it."},
        {"zh": "我去别处了。", "en": "I'll go elsewhere."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起来了。", "en": "I picked it up."},
        {"zh": "我的手指不太灵活。", "en": "My fingers aren't very nimble."},
        {"zh": "这东西挡路，我捡到台面上。", "en": "This is in the way; I put it on the counter."},
        {"zh": "我放在台子上。", "en": "I'll set it on the counter."},
        {"zh": "这东西太轻了，不够。", "en": "This thing is too light — not enough."},
        {"zh": "我手里的麦克风更重。", "en": "The microphone in my hand is heavier."},
        {"zh": "这堆垃圾挡住我巡逻了。", "en": "This junk is blocking my patrol."},
        {"zh": "它挡在我脚前了。", "en": "It's in front of my feet."},
        {"zh": "我把它踢开。", "en": "I kick it aside."},
        {"zh": "你最好收好。", "en": "You'd better put it away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边的家伙在动。", "en": "That thing over there is moving."},
        {"zh": "我看见了它。", "en": "I see it."},
        {"zh": "它的气息不对。", "en": "Its presence is wrong."},
        {"zh": "那边有东西在动，我去清掉。", "en": "Something moves over there; I'll clear it."},
        {"zh": "你退后，这不关你的事。", "en": "Back off. This isn't your business."},
        {"zh": "我的目标换了。", "en": "My target has changed."},
        {"zh": "我的头转过去了。", "en": "My head has turned."},
        {"zh": "灯照在那个方向。", "en": "The light falls that way."},
        {"zh": "它的脚步很乱。", "en": "Its footsteps are disordered."},
        {"zh": "那边的怪物撞翻了椅子。", "en": "The monster over there knocked over a chair."},
        {"zh": "你别跟着我。", "en": "Don't follow me."},
        {"zh": "我这就到了。", "en": "I'm almost there."},
        {"zh": "它的影子贴着墙。", "en": "Its shadow hugs the wall."},
        {"zh": "我看见了它的手。", "en": "I see its hands."},
        {"zh": "它已经发现我了。", "en": "It's noticed me already."},
        {"zh": "那样就更好办了。", "en": "All the better."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我左边，我不在意。", "en": "You're on my left. I don't care."},
        {"zh": "我的目光在那个东西上。", "en": "My gaze is on that thing."},
        {"zh": "它在往后退。", "en": "It's backing away."},
        {"zh": "我走得不快，也不慢。", "en": "I walk neither fast nor slow."},
        {"zh": "它躲到柜台后。", "en": "It's hiding behind the counter."},
        {"zh": "柜台挡不住我。", "en": "The counter won't stop me."},
        {"zh": "它撞到桌子，声音很脆。", "en": "It bumps a table; the sound is sharp."},
        {"zh": "它撞倒了椅子。", "en": "It knocked over a chair."},
        {"zh": "我只猎怪物，不吃人。", "en": "I hunt monsters, not people."},
        {"zh": "它往厨房那边跑。", "en": "It's running for the kitchen."},
        {"zh": "厨房的门很窄。", "en": "The kitchen door is narrow."},
        {"zh": "我先到门口。", "en": "I'll be at the door first."},
        {"zh": "它停下来喘气。", "en": "It stopped to pant."},
        {"zh": "它已经没有退路了。", "en": "It has no way out now."},
        {"zh": "我离它还有五步。", "en": "Five steps between us."},
        {"zh": "我的麦克风对准它的后脑。", "en": "My microphone aims at the back of its head."},
        {"zh": "它的眼睛在乱转。", "en": "Its eyes are darting."},
        {"zh": "我继续往那边走。", "en": "I keep walking that way."},
        {"zh": "它开始喊了。", "en": "It has started to shout."},
        {"zh": "没有人会来。", "en": "No one is coming."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手落下去。", "en": "My hand comes down."},
        {"zh": "这一下很干脆。", "en": "It's a clean blow."},
        {"zh": "我把它摔在披萨柜台上。", "en": "I slam it onto the pizza counter."},
        {"zh": "我的拳头比它想的重。", "en": "My fist is heavier than it expects."},
        {"zh": "它退了两步，腿软。", "en": "It fell back two steps, legs weak."},
        {"zh": "它还想动，我又补一脚。", "en": "It still moves, so I add a kick."},
        {"zh": "舞台上的东西掉了。", "en": "Something fell on stage."},
        {"zh": "我一下也没停。", "en": "I didn't stop once."},
        {"zh": "它的头歪到一边。", "en": "Its head lops to one side."},
        {"zh": "我抓住它的领子。", "en": "I grab its collar."},
        {"zh": "它被我砸在柜台上。", "en": "I slam it onto the counter."},
        {"zh": "它的声音断了一下。", "en": "Its voice cut out."},
        {"zh": "我把它推开。", "en": "I push it away."},
        {"zh": "我的麦克风砸在它后颈上。", "en": "My microphone comes down on its neck."},
        {"zh": "我没有用力过度。", "en": "I didn't use excessive force."},
        {"zh": "我的肩膀撞到它。", "en": "My shoulder hits it."},
        {"zh": "它整个人滑出去。", "en": "It slides away bodily."},
        {"zh": "我又往前走一步。", "en": "I take one more step forward."},
        {"zh": "我低头确认，它不会再起来。", "en": "I look down to confirm it won't get up."},
        {"zh": "我低下头看它。", "en": "I look down at it."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从后台走出来。", "en": "I walk out from backstage."},
        {"zh": "舞台的帘子被我拨开。", "en": "I part the stage curtain."},
        {"zh": "灯这个时候亮了。", "en": "The lights came on just now."},
        {"zh": "你站在那儿。", "en": "You're standing there."},
        {"zh": "我从舞台帘后出来，找别的。", "en": "I come out from behind the stage curtain, looking for another."},
        {"zh": "我听见别处的声音。", "en": "I hear something elsewhere."},
        {"zh": "我的脚步在地板上回响。", "en": "My steps echo on the floor."},
        {"zh": "麦克风在我手里。", "en": "The microphone is in my hand."},
        {"zh": "这里该清场了。", "en": "This place needs clearing."},
        {"zh": "我抬头看了看。", "en": "I look up."},
        {"zh": "店里的钟停了。", "en": "The diner clock has stopped."},
        {"zh": "我开始工作了。", "en": "I'm starting my work."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温让我的外壳发烫。", "en": "The heat makes my shell burn."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，我的关节响亮了一下。", "en": "I fell, and my joints rang loudly."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进了缝隙，我的动作变滞。", "en": "Water got in the seams. My motion drags."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我推到墙上。", "en": "The blast threw me into the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一枚弹丸嵌进我的外壳。", "en": "A projectile lodged in my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "异常能量在我的电路里乱窜。", "en": "Strange energy races through my circuits."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，不会饿。", "en": "I don't eat, so I won't starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电击让我的系统抖了一下。", "en": "The shock made my systems stutter."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地板，我抓不住。", "en": "No floor here. I can't grip."}
      ]
    }
  }
}
