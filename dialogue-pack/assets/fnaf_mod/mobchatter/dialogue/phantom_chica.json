{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在走廊里晃着走", "en": "I sway along the corridor."},
        {"zh": "我拖着步子经过门边", "en": "I drag past the doorway."},
        {"zh": "我半透明的脚，一步一步挪。", "en": "My translucent feet shuffle step by step."},
        {"zh": "我一格一格朝你挪", "en": "I work toward you, block by block."},
        {"zh": "我绕过地上的箱子", "en": "I go around the boxes on the floor."},
        {"zh": "我歪着头往前走", "en": "I move with my head tilted."},
        {"zh": "我半透明的身子在闪", "en": "My translucent body flickers."},
        {"zh": "我从监控死角穿过去", "en": "I cross the camera's blind spot."},
        {"zh": "我贴着墙根慢慢挪", "en": "I creep along the baseboard."},
        {"zh": "我在门框下顿了顿", "en": "I pause in the doorframe."},
        {"zh": "我转身换了个方向", "en": "I turn and change direction."},
        {"zh": "我一步一停靠过去", "en": "I close in, pausing at each step."},
        {"zh": "我从墙角那片暗里走出", "en": "I step out of the corner's dark."},
        {"zh": "我的手在身侧晃", "en": "My hands swing at my sides."},
        {"zh": "我穿过那盏灯的光", "en": "I pass through the lamplight."},
        {"zh": "我在拐角处露了半个身子", "en": "I show half of myself at the corner."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立在走廊尽头", "en": "I stand at the end of the hall."},
        {"zh": "我张嘴，只剩电流声。", "en": "My mouth opens—only static."},
        {"zh": "我歪着头看灯", "en": "I tilt my head at the light."},
        {"zh": "灯管在我头顶嗡嗡响", "en": "The tube buzzes over my head."},
        {"zh": "我的手垂着一动不动", "en": "My hands hang still."},
        {"zh": "我在那里不出声", "en": "I make no sound there."},
        {"zh": "我的颜色淡得像雾", "en": "I am as faint as fog."},
        {"zh": "我缓慢地转着眼", "en": "My eyes turn slowly."},
        {"zh": "我的影子几乎看不见", "en": "My shadow is barely there."},
        {"zh": "我等着走廊里有动静", "en": "I wait for the hall to stir."},
        {"zh": "我抬起一只湿羽毛的手", "en": "I lift one wet-feathered hand."},
        {"zh": "我的羽毛看起来湿了", "en": "My feathers look wet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我那张喙朝向你", "en": "That beak turns to you."},
        {"zh": "我的嘴张着不动", "en": "My beak stays open."},
        {"zh": "你听见我的声音了吗", "en": "Did you hear my voice?"},
        {"zh": "我不眨眼地看着你", "en": "I watch you without blinking."},
        {"zh": "我从灯下看你", "en": "I look at you from under the light."},
        {"zh": "你退开我也不追", "en": "I will not chase if you move off."},
        {"zh": "我的头歪得更厉害了", "en": "My head tilts further."},
        {"zh": "我只是站在这里", "en": "I am only standing here."},
        {"zh": "你的手一直在抖", "en": "Your hands are shaking."},
        {"zh": "我朝你笑了一下", "en": "I smile once."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身形晃了晃", "en": "My shape wavers."},
        {"zh": "散掉的羽毛又合拢", "en": "The scattered feathers close up."},
        {"zh": "我连喘都没喘一声", "en": "I do not even gasp."},
        {"zh": "我的嘴合上了一瞬", "en": "My beak closes for a moment."},
        {"zh": "我往后飘开些许", "en": "I drift half a block back."},
        {"zh": "灯光乱闪了一阵", "en": "The lights stutter."},
        {"zh": "我的喙歪得更厉害", "en": "My beak hangs further askew."},
        {"zh": "我一点点又厚起来", "en": "I thicken back, bit by bit."},
        {"zh": "这一下真是砸实了", "en": "That one truly landed."},
        {"zh": "我的羽毛掉了两根", "en": "Two of my feathers come loose."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你把那东西举给我", "en": "You hold that up to me."},
        {"zh": "我碰到你，就散了。", "en": "Touch you and I scatter."},
        {"zh": "我绕过它接着走", "en": "I walk around it and on."},
        {"zh": "它引不起我的兴趣", "en": "It stirs no interest in me."},
        {"zh": "我脚下一步都没停", "en": "My feet do not stop."},
        {"zh": "你再举高也没用处", "en": "Holding it higher changes nothing."},
        {"zh": "我眼光没往那儿落", "en": "My eyes never fall on it."},
        {"zh": "那玩意儿你收着", "en": "You keep the thing."},
        {"zh": "我要的不是那个", "en": "That is not what I want."},
        {"zh": "你把它放下来", "en": "Put it down."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞过来，我从你身上穿过", "en": "You hit me and pass through."},
        {"zh": "我的手擦到你的脸", "en": "My hand brushes your face."},
        {"zh": "你打了个冷颤", "en": "You shudder."},
        {"zh": "我散了一下又聚起来", "en": "I scatter and gather again."},
        {"zh": "我们撞在一起没声音", "en": "We meet without a sound."},
        {"zh": "我压根不觉得疼", "en": "I feel no pain."},
        {"zh": "你被我撞得退了半步", "en": "I knock you back half a step."},
        {"zh": "我的影子一明一灭", "en": "My shadow goes bright and dark."},
        {"zh": "我飘开了一点", "en": "I float a little aside."},
        {"zh": "撞我像是撞进冷雾", "en": "Hitting me is like hitting cold fog."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一个从墙后出来", "en": "Another steps out from behind the wall."},
        {"zh": "我们两个脑袋都歪着", "en": "Both our heads hang tilted."},
        {"zh": "它的羽毛比我更旧", "en": "Its feathers are older than mine."},
        {"zh": "我们两个并排立着", "en": "The two of us stand abreast."},
        {"zh": "我们一起张开嘴", "en": "We open our beaks together."},
        {"zh": "我们一句也不说", "en": "We do not speak."},
        {"zh": "我们一同把喙朝向你", "en": "We both aim our beaks at you."},
        {"zh": "它比我还要淡", "en": "It is fainter than I."},
        {"zh": "走廊上现出两道影", "en": "Two shadows show along the hall."},
        {"zh": "我们一同朝前挪", "en": "We move on together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西掉在我跟前", "en": "Something drops before me."},
        {"zh": "我低头瞧了一眼", "en": "I glance down at it."},
        {"zh": "它从我指间穿过去", "en": "It passes between my fingers."},
        {"zh": "我根本拿不住它", "en": "I cannot hold it."},
        {"zh": "它一碰就变得冰凉", "en": "It turns cold."},
        {"zh": "我看着它滚开", "en": "I watch it roll away."},
        {"zh": "我没有去碰那个", "en": "I do not touch it."},
        {"zh": "它停在原地没有影子", "en": "It lies there without a shadow."},
        {"zh": "我用脚把它推了推", "en": "I nudge it with a foot."},
        {"zh": "它从我掌心落下", "en": "It falls through my palm."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我把歪着的头摆正", "en": "I square my head."},
        {"zh": "走廊里安静下来", "en": "The hall goes quiet."},
        {"zh": "我朝你那边倾过身", "en": "I lean over your way."},
        {"zh": "我把嘴张得更大", "en": "I open my beak wider."},
        {"zh": "灯在我头顶闪", "en": "The light flickers above me."},
        {"zh": "我把烤盘举起来，朝你倾身。", "en": "I raise the baking tray and lean toward you."},
        {"zh": "我不再慢慢挪", "en": "I stop moving slowly."},
        {"zh": "空气一下冻住了", "en": "The air freezes all at once."},
        {"zh": "我盯住你的位置", "en": "I fix on your position."},
        {"zh": "这一次我不停", "en": "This time I will not stop."},
        {"zh": "我的手指收紧", "en": "My fingers curl in."},
        {"zh": "我听见了你的心跳", "en": "I hear your heartbeat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着墙跟着你", "en": "I follow along the wall."},
        {"zh": "你走到哪我都在侧面", "en": "I stay at your flank wherever you go."},
        {"zh": "我跟你越贴越近", "en": "I draw nearer and nearer."},
        {"zh": "你喘得收不住了", "en": "You cannot steady your breath."},
        {"zh": "我在等你的手离开门把", "en": "I wait for your hand to leave the handle."},
        {"zh": "你退一步我进一格", "en": "One step back, one block in."},
        {"zh": "我的头又低下一寸", "en": "My head drops another inch."},
        {"zh": "我的身形忽明忽暗", "en": "My shape wavers."},
        {"zh": "走廊没有别的声音", "en": "There is no other sound in the hall."},
        {"zh": "我等着你回头看", "en": "I wait for you to look back."},
        {"zh": "你已经退到墙角", "en": "You have backed to the corner."},
        {"zh": "我再靠近一步", "en": "I take one more step."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手抓向你的喉咙", "en": "I reach for your throat."},
        {"zh": "我一碰你就尖叫", "en": "My touch brings a scream."},
        {"zh": "我的脸贴到你眼前", "en": "My face comes right up to yours."},
        {"zh": "我抓了一把就散", "en": "I snatch once and scatter."},
        {"zh": "我一把抓住你，抓空了", "en": "I grab at you and catch nothing."},
        {"zh": "你被吓得撞到墙上", "en": "You stumble into the wall."},
        {"zh": "我从你背后贴上来", "en": "I press up behind you."},
        {"zh": "我的叫声在走廊里滚", "en": "My cry rolls down the hall."},
        {"zh": "我扑过去就消失了", "en": "I lunge and vanish."},
        {"zh": "走廊的灯全灭了", "en": "Every light in the hall goes out."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "灯光暗了一格", "en": "The light drops a notch."},
        {"zh": "我从走廊那头显形", "en": "I fade in at the far end of the hall."},
        {"zh": "地板先接住我的影子", "en": "The floor catches my shadow first."},
        {"zh": "我歪着头出现", "en": "I appear with my head tilted."},
        {"zh": "空气冷得像冰", "en": "The air is cold as ice."},
        {"zh": "我站在灯的阴影里", "en": "I stand in the lamp's shadow."},
        {"zh": "我的羽毛还在滴水", "en": "My feathers still drip."},
        {"zh": "走廊里多了一个影子", "en": "A new shadow in the hall."},
        {"zh": "我到了，一点声都没有", "en": "I am here, and silent."},
        {"zh": "有人听见了我的叫声", "en": "Someone heard my cry."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火照着我，我淡了下去", "en": "Fire lights me and I fade."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处坠下", "en": "I plunge from above."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我的身体穿过", "en": "Water passes through my body."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我吹散了", "en": "The blast blows me apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过了我的胸口", "en": "Something passed through my chest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光撕开了我的形状", "en": "Spell light tears my shape."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会饿，只会变淡", "en": "I never starve; I only fade."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把我的影子照出来", "en": "Lightning shows my shadow."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗把我也吞掉了", "en": "The dark swallows me too."}
      ]
    }
  }
}
