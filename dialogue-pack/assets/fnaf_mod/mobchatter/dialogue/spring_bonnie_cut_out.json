{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我其实不会走。", "en": "I don't actually walk."},
        {"zh": "纸板被风推着晃。", "en": "The wind rocks my cardboard."},
        {"zh": "脚下的支架吱一声。", "en": "My stand creaks once."},
        {"zh": "被拖过来一点。", "en": "Dragged a little way."},
        {"zh": "我只会往前倾。", "en": "I can only lean forward."},
        {"zh": "影子在墙上来回摇。", "en": "My shadow sways on the wall."},
        {"zh": "地板上拖出划痕。", "en": "Scrape marks on the floor."},
        {"zh": "谁会推着我走？", "en": "Who's pushing me along?"},
        {"zh": "我的边缘卷起来了。", "en": "My edges have curled."},
        {"zh": "离墙近一点更好看。", "en": "Better closer to the wall."},
        {"zh": "一步也不会走。", "en": "Not one step do I take."},
        {"zh": "转个身都得靠人。", "en": "Turning me takes a person."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一块纸板。", "en": "I'm only cardboard."},
        {"zh": "笑脸印得很正。", "en": "My smile is printed straight."},
        {"zh": "边角有点潮。", "en": "The corners feel damp."},
        {"zh": "我在这里挂了很久。", "en": "I've hung here a long while."},
        {"zh": "观众一直不来。", "en": "The audience never comes."},
        {"zh": "弹簧锁的图样很旧。", "en": "The springlock print is faded."},
        {"zh": "纸板做的我，站在墙角。", "en": "Cardboard me, propped against the wall."},
        {"zh": "墙上钉子松了。", "en": "The nail in the wall is loose."},
        {"zh": "立牌背面，还印着旧菜单。", "en": "The back of this standee still shows an old menu."},
        {"zh": "灯光斜着照我。", "en": "The lamp hits me sideways."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也来看我？", "en": "Come to look at me too?"},
        {"zh": "我盯着每个进门的人。", "en": "I watch everyone who comes in."},
        {"zh": "别撕我的角。", "en": "Don't tear my ears."},
        {"zh": "你站得比我还久。", "en": "You've stood longer than I have."},
        {"zh": "这块纸受不住力。", "en": "This card can't take force."},
        {"zh": "你看到我背后的支架吗。", "en": "See the stand behind me?"},
        {"zh": "我一直在同一个位置。", "en": "I've never left this spot."},
        {"zh": "你的影子压到我了。", "en": "Your shadow is on me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被折了一道。", "en": "I've been creased."},
        {"zh": "纸边裂开了。", "en": "My edge split."},
        {"zh": "我的支架歪掉了。", "en": "My stand has gone crooked."},
        {"zh": "我的图案糊了。", "en": "My print is smeared."},
        {"zh": "这一下打了个洞。", "en": "That punched a hole."},
        {"zh": "我晃了半天。", "en": "I wobbled for ages."},
        {"zh": "没什么可疼的。", "en": "There's nothing to hurt."},
        {"zh": "我还挂在墙上。", "en": "I'm still on the wall."},
        {"zh": "别把我撕开。", "en": "Don't tear me apart."},
        {"zh": "纸板也会怕。", "en": "Even cardboard can fear."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在餐台边，一整天。", "en": "I stand by the counter all day."},
        {"zh": "纸板不需要食物。", "en": "Cardboard needs no food."},
        {"zh": "那点东西对我没用。", "en": "That does nothing for me."},
        {"zh": "你要是饿了就自己吃。", "en": "If you're hungry, eat it yourself."},
        {"zh": "我只能看着。", "en": "All I can do is watch."},
        {"zh": "香气穿不过我。", "en": "The smell passes right through me."},
        {"zh": "钉得我动不了。", "en": "I'm nailed in place."},
        {"zh": "拿远点，会弄湿我。", "en": "Take it away. It'll dampen me."},
        {"zh": "食物放在我面前，也没用。", "en": "Food set before me changes nothing."},
        {"zh": "别把油滴在我身上。", "en": "Don't drip grease on me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一层纸。", "en": "I'm a single layer of card."},
        {"zh": "别撞，我会被折出痕。", "en": "Don't hit. I'll crease."},
        {"zh": "我倒下去就起不来。", "en": "If I fall, I can't get up."},
        {"zh": "支架晃得厉害。", "en": "My stand wobbles badly."},
        {"zh": "这一下留了个坑。", "en": "That left a dent."},
        {"zh": "纸边割不了人。", "en": "Card edges cut nothing."},
        {"zh": "小心，我还要挂着。", "en": "Careful. I'm meant to hang here."},
        {"zh": "背板已经弯了。", "en": "My backing is already bent."},
        {"zh": "别把我推离原位。", "en": "Don't push me off my mark."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "别对纸板说这种话。", "en": "Don't say that to cardboard."},
        {"zh": "我们是纸板，不会相爱。", "en": "We are cardboard; we do not fall in love."},
        {"zh": "你去和真人说吧。", "en": "Say it to someone real."},
        {"zh": "我的印刷都褪色了。", "en": "My print has faded."},
        {"zh": "我对面只有一堵墙。", "en": "All I face is a wall."},
        {"zh": "这份心意挂着就好。", "en": "Let the thought hang here."},
        {"zh": "我不会回应。", "en": "I won't answer."},
        {"zh": "你笑了，我也不会。", "en": "You smiled. I won't."},
        {"zh": "别靠太近，会压皱。", "en": "Not too close. You'll crumple me."},
        {"zh": "我只是一张图。", "en": "I'm only a picture."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手不能动。", "en": "My hands can't move."},
        {"zh": "掉在我脚边的。", "en": "It fell at my feet."},
        {"zh": "我只能看着它。", "en": "I can only look at it."},
        {"zh": "纸板捡不了东西。", "en": "Cardboard can't pick things up."},
        {"zh": "它压在我的影子上。", "en": "It lies on my shadow."},
        {"zh": "我看得出它值钱。", "en": "I can tell it's worth something."},
        {"zh": "钉子上挂着点灰。", "en": "Dust hangs on the nail."},
        {"zh": "它就躺在那儿。", "en": "There it lies."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看得见，但动不了。", "en": "I see you. I can't move."},
        {"zh": "我在盯着门口。", "en": "I'm staring at the doorway."},
        {"zh": "我不追任何人。", "en": "I chase no one."},
        {"zh": "弹簧锁的图在发亮？", "en": "Is the springlock print glowing?"},
        {"zh": "纸板没有腿。", "en": "Cardboard has no legs."},
        {"zh": "谁把灯调暗了。", "en": "Someone dimmed the light."},
        {"zh": "我听见脚步声靠近。", "en": "I hear steps coming near."},
        {"zh": "我以为自己会站起来。", "en": "I thought I'd stand up."},
        {"zh": "这只是画的一张脸。", "en": "It's only a drawn face."},
        {"zh": "我还是在原地。", "en": "I'm still in place."},
        {"zh": "我的影子朝你转。", "en": "My shadow turns toward you."},
        {"zh": "别站在这道线里。", "en": "Don't stand inside this line."},
        {"zh": "你要走近看看吗。", "en": "Won't you come closer to look?"},
        {"zh": "我被钉得很牢。", "en": "I'm nailed down tight."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我只有两个画的眼睛。", "en": "I have only two painted eyes."},
        {"zh": "我连头都不能转。", "en": "I can't even turn my head."},
        {"zh": "你走到我右边了。", "en": "You're on my right now."},
        {"zh": "我的视线是固定的。", "en": "My gaze is fixed."},
        {"zh": "我猜你要去后屋。", "en": "I guess you're headed to the back room."},
        {"zh": "纸板不会预判。", "en": "Cardboard doesn't predict."},
        {"zh": "我在等你靠近。", "en": "I'm waiting for you nearer."},
        {"zh": "角落的阴影在动。", "en": "The shadow in the corner moves."},
        {"zh": "那不是我在动。", "en": "That isn't me moving."},
        {"zh": "我把重量压在支架上。", "en": "My weight rests on the stand."},
        {"zh": "你在犹豫什么呢。", "en": "What are you hesitating for?"},
        {"zh": "我无法做任何事。", "en": "There is nothing I can do."},
        {"zh": "这张脸不会变。", "en": "This face never changes."},
        {"zh": "纸上的眼睛不会转。", "en": "Printed eyes don't move."},
        {"zh": "你听见纸的响声吗。", "en": "Do you hear the paper rustle?"},
        {"zh": "被风吹得轻轻摇。", "en": "The draft makes me rock."},
        {"zh": "我只是一块立牌，别躲。", "en": "I am only a standee; no need to dodge."},
        {"zh": "可我还是一块纸。", "en": "Yet I'm still cardboard."},
        {"zh": "别让我等到天亮。", "en": "Don't make me wait till dawn."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我举不起手。", "en": "I can't lift a hand."},
        {"zh": "纸板砸人只会弯。", "en": "Cardboard hits nothing but air."},
        {"zh": "这一下只是影子。", "en": "That was only a shadow."},
        {"zh": "我的边角碰到你。", "en": "My edge brushed you."},
        {"zh": "我扑过去是不可能的。", "en": "Lunging is impossible for me."},
        {"zh": "这是画中的动作。", "en": "This is a drawn motion."},
        {"zh": "支架先撑不住了。", "en": "The stand gives out first."},
        {"zh": "你能听见纸响吗。", "en": "Do you hear the paper?"},
        {"zh": "我不过是块招牌。", "en": "I'm nothing but a sign."},
        {"zh": "笑一笑就够吓人。", "en": "A smile is frightening enough."},
        {"zh": "你退开是因为害怕。", "en": "You stepped back from fear."},
        {"zh": "我可没碰到你。", "en": "I never touched you."},
        {"zh": "纸角划过你的袖子。", "en": "A paper corner grazed your sleeve."},
        {"zh": "这一下不会留伤。", "en": "That leaves no wound."},
        {"zh": "风把我推向你。", "en": "The draft pushed me at you."},
        {"zh": "别倒在我身上。", "en": "Don't fall onto me."},
        {"zh": "纸板也只能这样。", "en": "Cardboard can only do this."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "有人把我支起来了。", "en": "Someone set me upright."},
        {"zh": "餐厅角落多了一块纸。", "en": "A new bit of card in the diner."},
        {"zh": "我印着弹簧兔的脸。", "en": "I wear Spring Bonnie's face."},
        {"zh": "钉子钉进墙里。", "en": "The nail goes into the wall."},
        {"zh": "这里的光很暗。", "en": "The light is poor here."},
        {"zh": "灰尘还没擦掉。", "en": "The dust hasn't been wiped."},
        {"zh": "我闻到了陈旧的味道。", "en": "I smell something old."},
        {"zh": "纸板落在木地板上。", "en": "Cardboard lands on wood."},
        {"zh": "这就是我的位置。", "en": "This is my place."},
        {"zh": "好像有客人来了。", "en": "A customer seems to have come."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "纸边卷起来发黑。", "en": "My edges curl and blacken."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒了，脸贴地。", "en": "I fell. Face down."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "纸吸饱了水。", "en": "The card soaked through."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "纸屑飞了一屋子。", "en": "Paper scraps all over the room."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一个洞穿了过去。", "en": "A hole went right through."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "图案自己动了一下。", "en": "The print shifted by itself."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "纸板不怕饿。", "en": "Cardboard doesn't starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "图案被烧得发白。", "en": "The lightning bleached my print."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "纸片被风卷走了。", "en": "The paper drifted away."}
      ]
    }
  }
}
