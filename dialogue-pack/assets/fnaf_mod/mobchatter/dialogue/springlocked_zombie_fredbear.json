{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "金毛底下露出铁架。", "en": "Iron frame shows through golden fur."},
        {"zh": "一步一晃，骨头响。", "en": "I sway a step. Bones creak."},
        {"zh": "西装下摆拖着地。", "en": "My suit skirt drags the floor."},
        {"zh": "手臂僵在半空。", "en": "My arm stays stiff midair."},
        {"zh": "脚步像被线拉着。", "en": "My feet feel pulled on strings."},
        {"zh": "弹簧在体内松了。", "en": "The springlocks came loose."},
        {"zh": "帽子歪到了耳后。", "en": "My hat slid behind my ear."},
        {"zh": "灯照出我身上的洞。", "en": "The lamp shows the holes in me."},
        {"zh": "皮肉和棉絮混着。", "en": "Flesh and stuffing mixed."},
        {"zh": "往有人的方向挪。", "en": "Trudging toward anything living."},
        {"zh": "台阶上磕了一下。", "en": "I stumbled on the step."},
        {"zh": "金头随着脚步摇。", "en": "My golden head bobs as I walk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我这张脸还能笑。", "en": "This face of mine can still smile."},
        {"zh": "铁件在里面挪。", "en": "Metal shifts inside me."},
        {"zh": "呼吸声其实是风。", "en": "The breath you hear is wind."},
        {"zh": "帽檐挂着线头。", "en": "Threads hang from my hat brim."},
        {"zh": "这身金布退色了。", "en": "The golden cloth has faded."},
        {"zh": "我数着灯闪的次数。", "en": "I count the light's flickers."},
        {"zh": "手举着放不下。", "en": "My hand won't come down."},
        {"zh": "嘴里塞着棉花。", "en": "Cotton fills my mouth."},
        {"zh": "我听见孩子在笑。", "en": "I hear children laughing."},
        {"zh": "舞台那边很空。", "en": "The stage is empty."},
        {"zh": "关节发出咔嗒。", "en": "A joint clicks."},
        {"zh": "我站着，也算表演。", "en": "Standing counts as a show."},
        {"zh": "身上有铁锈味。", "en": "I smell of rust."},
        {"zh": "眼睛不会眨。", "en": "My eyes never blink."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你认得我吗？", "en": "Do you recognize me?"},
        {"zh": "我戴了帽子来。", "en": "I came wearing my hat."},
        {"zh": "你的脸好小。", "en": "Your face is so small."},
        {"zh": "别怕，我不快。", "en": "Don't fear me. I'm slow."},
        {"zh": "我身上有弹簧。", "en": "There are springs in me."},
        {"zh": "你来吃饭还是来看我？", "en": "Here to eat, or to see me?"},
        {"zh": "你的鞋踩在地毯上。", "en": "Your shoes are on the carpet."},
        {"zh": "站那么远做什么。", "en": "Why stand so far off?"},
        {"zh": "我的笑是缝的。", "en": "My smile was stitched on."},
        {"zh": "这里的灯原来更亮。", "en": "The lights used to be brighter."},
        {"zh": "我要抱一下。", "en": "I want a hug."},
        {"zh": "你的手放在门把上。", "en": "Your hand is on the doorknob."},
        {"zh": "金毛掉了不少。", "en": "A lot of my gold fur is gone."},
        {"zh": "我在这站了很多年。", "en": "I've stood here for years."},
        {"zh": "你走近一点。", "en": "Come a little closer."},
        {"zh": "孩子们都不来了。", "en": "The children stopped coming."},
        {"zh": "你不笑，真可惜。", "en": "You don't smile. A pity."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "铁件被撞歪了。", "en": "A metal piece got knocked crooked."},
        {"zh": "棉花掉出来一团。", "en": "A clump of stuffing falls out."},
        {"zh": "我晃了两下没倒。", "en": "I sway twice but don't fall."},
        {"zh": "金毛被扯下一片。", "en": "A patch of gold fur came off."},
        {"zh": "我发出低低的笑。", "en": "I let out a low laugh."},
        {"zh": "弹簧扎进肉里。", "en": "A spring digs into flesh."},
        {"zh": "帽子又歪了。", "en": "My hat went crooked again."},
        {"zh": "这些伤攒了很多年。", "en": "These wounds piled up for years."},
        {"zh": "我还在慢慢走。", "en": "I'm still walking."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "能分我一口吗？", "en": "Could I have a bite?"},
        {"zh": "我闻到了蛋糕。", "en": "I smell cake."},
        {"zh": "我嘴里都是棉花。", "en": "My mouth is full of cotton."},
        {"zh": "那盘东西真好看。", "en": "That plate looks nice."},
        {"zh": "你拿着的是什么。", "en": "What are you holding?"},
        {"zh": "我好像很饿。", "en": "I think I'm hungry."},
        {"zh": "我的手伸不到那里。", "en": "My hand won't reach there."},
        {"zh": "放到我面前来。", "en": "Put it in front of me."},
        {"zh": "它闻起来是甜的。", "en": "It smells sweet."},
        {"zh": "留着，我一会儿吃。", "en": "Leave it. I'll eat later."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的铁架了。", "en": "You hit the frame inside me."},
        {"zh": "我的铁架从毛里戳出来。", "en": "My steel frame pokes through the fur."},
        {"zh": "退一步，我身上有刺。", "en": "Step back. I have spikes."},
        {"zh": "金毛蹭到你身上。", "en": "My fur rubs off on you."},
        {"zh": "别挤，我转身很慢。", "en": "Don't crowd. I turn slowly."},
        {"zh": "我们撞得都响了。", "en": "We both made a sound."},
        {"zh": "你闻到我身上的味了吧。", "en": "You smell me now, don't you."},
        {"zh": "站稳，地板滑。", "en": "Steady. The floor is slick."},
        {"zh": "别碰我的胳膊。", "en": "Don't touch my arm."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经不算活着。", "en": "I'm not really alive."},
        {"zh": "这身西装里没人了。", "en": "There's nobody in this suit."},
        {"zh": "孩子，别靠这么近。", "en": "Child, not so close."},
        {"zh": "我只需要有人看演出。", "en": "I only need an audience."},
        {"zh": "跟我跳支舞吧。", "en": "Dance one with me."},
        {"zh": "我的手太硬。", "en": "My hands are too hard."},
        {"zh": "灯灭了就该走了。", "en": "When the lights go out, you should leave."},
        {"zh": "我等了太久。", "en": "I waited too long."},
        {"zh": "你该找个暖和的。", "en": "You should find someone warm."},
        {"zh": "笑一个就好。", "en": "Just smile for me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "手指夹不住。", "en": "My fingers won't pinch."},
        {"zh": "捡起来给我看看。", "en": "Pick it up and show me."},
        {"zh": "这是我的扣子。", "en": "That's my button."},
        {"zh": "掉了就掉了。", "en": "If it dropped, it dropped."},
        {"zh": "我捡不起来这个。", "en": "I can't lift this one."},
        {"zh": "零件还有用。", "en": "Spare parts are still useful."},
        {"zh": "这个我记得。", "en": "I remember this one."},
        {"zh": "放进我口袋吧。", "en": "Put it in my pocket."},
        {"zh": "地上还有一半。", "en": "There's another half."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "夜班开始了。", "en": "The night shift begins."},
        {"zh": "那不是我的客人。", "en": "That's not my customer."},
        {"zh": "铁架开始收紧。", "en": "The frame tightens."},
        {"zh": "弹簧一根根弹开。", "en": "Springs pop one by one."},
        {"zh": "我听见门锁响。", "en": "I heard the lock click."},
        {"zh": "这孩子站错了地方。", "en": "This one stands in the wrong place."},
        {"zh": "我笑得更开了。", "en": "My smile opens wider."},
        {"zh": "我朝那个方向走。", "en": "I head in that direction."},
        {"zh": "脚步声停了。", "en": "The footsteps stopped."},
        {"zh": "这身金衣在发烫。", "en": "My golden suit runs hot."},
        {"zh": "僵尸的步子，从旧餐厅跟来。", "en": "A zombie's gait follows you out of the old diner."},
        {"zh": "不能让你出去。", "en": "I can't let you leave."},
        {"zh": "手已经抬起来了。", "en": "My hand is already up."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在朝你走。", "en": "I'm walking toward you."},
        {"zh": "你退到椅子后面。", "en": "You're behind the chair."},
        {"zh": "我的脚步很慢。", "en": "My steps are slow."},
        {"zh": "可我的脚步不停。", "en": "But my steps don't stop."},
        {"zh": "地毯上留了印。", "en": "I leave prints on the carpet."},
        {"zh": "你的呼吸很快。", "en": "Your breathing is fast."},
        {"zh": "我记得门在哪。", "en": "I remember where the door is."},
        {"zh": "帽子遮着我的眼。", "en": "My hat shades my eyes."},
        {"zh": "你撞到桌子了。", "en": "You bumped the table."},
        {"zh": "那声音暴露你了。", "en": "That sound gave you away."},
        {"zh": "我没有痛觉。", "en": "I feel no pain."},
        {"zh": "身上的铁在动。", "en": "The iron in me is moving."},
        {"zh": "我抱住你就好了。", "en": "I only need to hold you."},
        {"zh": "别往后台跑。", "en": "Don't run backstage."},
        {"zh": "那里没有出口。", "en": "There's no exit there."},
        {"zh": "我又笑了一下。", "en": "I smiled again."},
        {"zh": "等我走过去。", "en": "Wait till I walk over."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "让我抱你一下。", "en": "Let me hold you."},
        {"zh": "手臂合拢了。", "en": "My arms close."},
        {"zh": "金毛底下是铁。", "en": "Iron lies under the gold."},
        {"zh": "这一下很重。", "en": "This blow lands heavy."},
        {"zh": "别再挣开了。", "en": "Stop wriggling free."},
        {"zh": "铁件戳到你了。", "en": "The frame jabbed you."},
        {"zh": "嘴角还在笑。", "en": "I'm still smiling."},
        {"zh": "再抱紧一点。", "en": "Hold tighter."},
        {"zh": "你的肩膀陷下去了。", "en": "Your shoulder gave way."},
        {"zh": "就当是份礼物吧。", "en": "Consider it a gift."},
        {"zh": "别叫，会吵到客人。", "en": "Don't scream. It upsets the guests."},
        {"zh": "一次就够了。", "en": "One is enough."},
        {"zh": "你还在动吗。", "en": "Are you still moving?"},
        {"zh": "我身上有东西流出来。", "en": "Something leaks out of me."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "舞台的幕拉开了。", "en": "The stage curtain opened."},
        {"zh": "金色的熊站在门口。", "en": "A golden bear stands in the door."},
        {"zh": "我的西装上落着灰。", "en": "Dust lies on my suit."},
        {"zh": "灯亮了又灭。", "en": "The lights came on, then died."},
        {"zh": "我从来没离开过这栋楼。", "en": "I never left this building."},
        {"zh": "有人把我叫醒。", "en": "Someone woke me."},
        {"zh": "弹簧锁一声轻响。", "en": "The springlock clicked."},
        {"zh": "帽檐挡住了灯泡。", "en": "My hat brim blocks the bulb."},
        {"zh": "地板上响起缓慢的脚步。", "en": "Slow steps sound on the floor."},
        {"zh": "我的家就在这儿。", "en": "My home is right here."},
        {"zh": "孩子都走光了。", "en": "The children have all gone."},
        {"zh": "我等这一天很久了。", "en": "I've waited long for this."},
        {"zh": "金毛里渗出东西。", "en": "Something seeps through the fur."},
        {"zh": "门口的光被挡住。", "en": "I block the light in the doorway."},
        {"zh": "别回过头来看。", "en": "Don't look back."},
        {"zh": "该开始营业了。", "en": "Time to open for business."},
        {"zh": "我一步一步地来。", "en": "I come one step at a time."},
        {"zh": "今晚会有客人。", "en": "There'll be a guest tonight."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "金布烧得皱起来。", "en": "The gold cloth curls in flame."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔倒时铁架响得很大。", "en": "The frame clanged when I fell."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进西装里。", "en": "Water filled my suit."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "填充物被炸出来。", "en": "Stuffing burst out of me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有个洞穿进肩膀。", "en": "A hole punched my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我想起后台。", "en": "That light reminds me of backstage."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直饿着。", "en": "I've been hungry all along."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "弹簧被电得跳起来。", "en": "The springs jumped with the current."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "地面消失了。", "en": "The floor is gone."}
      ]
    }
  }
}
