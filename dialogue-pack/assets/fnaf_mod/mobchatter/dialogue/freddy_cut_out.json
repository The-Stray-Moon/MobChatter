{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我是块纸板，站着不动。", "en": "I'm cardboard. I stand still."},
        {"zh": "风一吹，我会晃。", "en": "When the wind blows, I wobble."},
        {"zh": "海报不会走路。", "en": "Posters don't walk."},
        {"zh": "我的边上卷起来了。", "en": "My edges have curled."},
        {"zh": "立牌有立牌的活法。", "en": "A cutout has its own way of living."},
        {"zh": "我被钉在墙角。", "en": "I'm pinned in the corner."},
        {"zh": "你要是绕着我走，我更好看。", "en": "If you walk around me, I look better."},
        {"zh": "这一面是正面，别转我。", "en": "This is my front. Don't turn me."},
        {"zh": "我的影子很薄。", "en": "My shadow is thin."},
        {"zh": "地板翘起来，我歪着。", "en": "The floor warped, so I lean."},
        {"zh": "我背后什么都没有。", "en": "There's nothing behind me."},
        {"zh": "风停，我也停。", "en": "When the wind stops, so do I."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立在原地，笑。", "en": "I stand here smiling."},
        {"zh": "这张脸印得很清楚。", "en": "This face is clearly printed."},
        {"zh": "纸边有点发黄了。", "en": "The paper edges have yellowed."},
        {"zh": "我没法转头。", "en": "I can't turn my head."},
        {"zh": "店里的灯照着我。", "en": "The diner light shines on me."},
        {"zh": "我身后是墙。", "en": "Behind me is a wall."},
        {"zh": "我只是被放在这儿。", "en": "I was simply put here."},
        {"zh": "灰尘落在一侧。", "en": "Dust collects on one side."},
        {"zh": "我脚底压着电线。", "en": "I'm standing on a cord."},
        {"zh": "这是我最好的角度。", "en": "This is my best angle."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你歪头看我。", "en": "You tilt your head at me."},
        {"zh": "我永远是正面的。", "en": "I'm always facing front."},
        {"zh": "你再看看我身后。", "en": "Take a look behind me."},
        {"zh": "那里只有墙。", "en": "There's only wall there."},
        {"zh": "你伸手摸我了吗？", "en": "Did you touch me?"},
        {"zh": "纸面摸着是凉的。", "en": "Paper feels cold."},
        {"zh": "你退后一点，看整张。", "en": "Step back and see the whole thing."},
        {"zh": "我的眼睛印得有点偏。", "en": "My eyes were printed slightly off."},
        {"zh": "我比你还早站在这里。", "en": "I stood here before you did."},
        {"zh": "别用手指敲，会凹的。", "en": "Don't tap me. It dents."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我打弯了。", "en": "You bent me."},
        {"zh": "纸板凹了一块。", "en": "A dent in the cardboard."},
        {"zh": "立牌的角被折弯了。", "en": "The corner of my cardboard is bent."},
        {"zh": "别撕，撕了就完了。", "en": "Don't tear me. That's the end."},
        {"zh": "胶带松了一点。", "en": "The tape loosened a bit."},
        {"zh": "我的正面皱了。", "en": "My front is creased."},
        {"zh": "这一下，纸上多了印。", "en": "Now there's a mark on the print."},
        {"zh": "我还立着呢。", "en": "I'm still standing."},
        {"zh": "你力气用得过头了。", "en": "You used too much force."},
        {"zh": "我的边又卷了。", "en": "My edge curled again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "食物会弄脏我的印刷笑脸。", "en": "Food would stain my printed smile."},
        {"zh": "纸板不需要进食。", "en": "Cardboard doesn't need food."},
        {"zh": "你把它放在我面前，很浪费。", "en": "Leaving it before me is a waste."},
        {"zh": "我是纸板做的，风一吹就晃。", "en": "Made of cardboard, I sway in the wind."},
        {"zh": "别让油滴到纸上。", "en": "Don't drip grease on the paper."},
        {"zh": "那张嘴是印上去的。", "en": "That mouth is printed on."},
        {"zh": "你举着，我闻不到。", "en": "You hold it up, and I can't smell."},
        {"zh": "拿开一点，挡着我了。", "en": "Move it. It's blocking me."},
        {"zh": "你自己吃掉比较好。", "en": "Better to eat it yourself."},
        {"zh": "别把油滴到我身上。", "en": "Don't drip grease on me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了我，我倒了一下。", "en": "You hit me and I tipped."},
        {"zh": "纸板折了个角。", "en": "A corner of me folded."},
        {"zh": "你把我撞歪了。", "en": "You knocked me crooked."},
        {"zh": "扶我一把，谢谢。", "en": "Give me a hand up. Thanks."},
        {"zh": "我太轻了，一推就走。", "en": "I'm too light. One push and I slide."},
        {"zh": "我的正面还是朝外。", "en": "I'm still facing outward."},
        {"zh": "你踩到我脚底了。", "en": "You stepped on my base."},
        {"zh": "我发出纸的声音。", "en": "I made a papery sound."},
        {"zh": "我倒向你，别躲。", "en": "I'm falling your way. Don't dodge."},
        {"zh": "我又靠回墙上。", "en": "I leaned back against the wall."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一张纸。", "en": "I'm only a sheet of paper."},
        {"zh": "你跟我谈这个？", "en": "You're talking to me about this?"},
        {"zh": "墙上还有另一张。", "en": "There's another one on the wall."},
        {"zh": "我们被贴在一起。", "en": "We were pasted together."},
        {"zh": "她也是笑着的。", "en": "She's smiling too."},
        {"zh": "这面墙，我们俩占满了。", "en": "Between us we fill this wall."},
        {"zh": "别把我们分开。", "en": "Don't pull us apart."},
        {"zh": "胶带会松的。", "en": "The tape will loosen."},
        {"zh": "夜里的店很安静。", "en": "The diner is quiet at night."},
        {"zh": "墙上贴着的我们，一直笑着。", "en": "The two of us on the wall keep smiling."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿不住它。", "en": "I can't hold it."},
        {"zh": "纸板的手是平的。", "en": "Cardboard hands are flat."},
        {"zh": "它滚到我脚下了。", "en": "It rolled to my feet."},
        {"zh": "我看得见，但捡不了。", "en": "I can see it, but can't pick it up."},
        {"zh": "你自己来吧。", "en": "Come get it yourself."},
        {"zh": "别让它压着我的边。", "en": "Don't let it press my edge."},
        {"zh": "它把我的影子挡住了。", "en": "It's blocking my shadow."},
        {"zh": "我站不稳，别放我身上。", "en": "I can't stay steady. Don't put it on me."},
        {"zh": "它会压塌我的。", "en": "It'll crush me."},
        {"zh": "就让它待着吧。", "en": "Just let it stay."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会追谁。", "en": "I don't chase anyone."},
        {"zh": "我的脸一直朝着前面。", "en": "My face always points forward."},
        {"zh": "你在那边走来走去。", "en": "You're walking about over there."},
        {"zh": "我只看得到正前方。", "en": "I can only see straight ahead."},
        {"zh": "你走到我侧面了。", "en": "You've moved to my side."},
        {"zh": "那里我看不见。", "en": "I can't see you there."},
        {"zh": "纸板的边被风掀起一角。", "en": "The wind lifts a corner of my cardboard edge."},
        {"zh": "我还是这张笑脸。", "en": "Still the same painted smile."},
        {"zh": "你要是怕，可以走。", "en": "If you're scared, you can leave."},
        {"zh": "这儿没有危险。", "en": "There's no danger here."},
        {"zh": "我不过是一张纸。", "en": "I'm nothing but paper."},
        {"zh": "别把自己绕进去。", "en": "Don't talk yourself into a fright."},
        {"zh": "我没法开口。", "en": "I can't speak up."},
        {"zh": "你听见的声音，不是我。", "en": "The voice you hear isn't mine."},
        {"zh": "我只会一直笑着。", "en": "All I do is keep smiling."},
        {"zh": "从早到晚，都是这张脸。", "en": "Same face, morning to night."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我不动，所以你也别怕。", "en": "I don't move, so don't be afraid."},
        {"zh": "我印在这面墙上，走不了。", "en": "I'm printed on this wall; I can't walk."},
        {"zh": "我的眼睛印在这个方向。", "en": "My eyes are printed this way."},
        {"zh": "你走出去了，我就看不见。", "en": "Once you leave, I can't see you."},
        {"zh": "我其实一直朝前。", "en": "I actually face straight ahead."},
        {"zh": "你回头了三次。", "en": "You've looked back three times."},
        {"zh": "我三次都在原位。", "en": "All three times I was in place."},
        {"zh": "灯管的声音像呼吸。", "en": "The light tube sounds like breathing."},
        {"zh": "那是灯，不是我。", "en": "That's the light, not me."},
        {"zh": "纸不会呼吸。", "en": "Paper doesn't breathe."},
        {"zh": "你的手电扫过来。", "en": "Your torch sweeps over."},
        {"zh": "我的颜色被照得很亮。", "en": "My colors turn bright in it."},
        {"zh": "你已经走近了。", "en": "You've come closer now."},
        {"zh": "我没有后退。", "en": "I didn't retreat."},
        {"zh": "我没法后退。", "en": "I can't back away."},
        {"zh": "你背后是出口。", "en": "The exit is behind you."},
        {"zh": "我还在这面墙上。", "en": "I'm still on this wall."},
        {"zh": "我跟着你转不了头。", "en": "I can't turn to follow you."},
        {"zh": "你看我多久都一样。", "en": "Look as long as you like. It's the same."},
        {"zh": "我一直笑着。", "en": "I keep smiling."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有拳头。", "en": "I have no fists."},
        {"zh": "你打我，纸上多了个洞。", "en": "Hit me and there's a hole in the paper."},
        {"zh": "我的拳头是印的。", "en": "My fists are printed on."},
        {"zh": "纸板能做什么？", "en": "What can cardboard do?"},
        {"zh": "你打我，我只会响。", "en": "Hit me, and I only make a sound."},
        {"zh": "我朝你这面倒过来。", "en": "I topple toward you."},
        {"zh": "别推，我压不住你。", "en": "Don't push. I can't pin you."},
        {"zh": "我的边缘划到你了吗？", "en": "Did my edge catch you?"},
        {"zh": "那是纸，划不深的。", "en": "It's paper. It won't cut deep."},
        {"zh": "纸板打不痛任何人。", "en": "Cardboard doesn't hurt anyone."},
        {"zh": "你挥拳，纸上起了皱。", "en": "You swung, and the paper creased."},
        {"zh": "我的脸被撞得对折。", "en": "My face got folded in half."},
        {"zh": "这一下，我站得更歪了。", "en": "Now I'm leaning even more."},
        {"zh": "我从墙上滑下来一点。", "en": "I've slid a little down the wall."},
        {"zh": "我只会拍到你手上。", "en": "All I can do is flap against your hand."},
        {"zh": "你把我拍得直响。", "en": "You swatted me, and I rattled."},
        {"zh": "我的下半截还撑着。", "en": "My lower half still holds."},
        {"zh": "纸屑落了一地。", "en": "Scraps of paper fell all over."},
        {"zh": "我连站都快站不住。", "en": "I can barely keep standing."},
        {"zh": "你赢了，我只是一张纸。", "en": "You win. I'm only paper."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在这面墙上。", "en": "I've been on this wall all along."},
        {"zh": "灯亮的时候，你才看见。", "en": "The lights came on and you finally saw me."},
        {"zh": "墙上有三张，我是中间。", "en": "Three on the wall. I'm the middle one."},
        {"zh": "这个位置很显眼。", "en": "This position stands out."},
        {"zh": "我被立在入口旁边。", "en": "I was placed by the entrance."},
        {"zh": "你进来，第一眼就是我。", "en": "You walked in and saw me first."},
        {"zh": "纸的味道还在。", "en": "The smell of paper lingers."},
        {"zh": "胶带还很新。", "en": "The tape is still fresh."},
        {"zh": "我照着店里最亮的地方。", "en": "I face the brightest part of the diner."},
        {"zh": "我笑得很标准。", "en": "My smile is perfectly standard."},
        {"zh": "我刚被贴上去。", "en": "I was just pasted up."},
        {"zh": "你站哪都能看到我。", "en": "Wherever you stand, you can see me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "纸一碰到火，就烧得很快。", "en": "Paper catches fire fast."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒下去，就再也立不起来。", "en": "If I fall, I'll never stand again."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一泡，我就烂了。", "en": "Soaked in water, I fall apart."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀翻，纸屑飞散。", "en": "The blast flipped me and paper scraps flew."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿了过去，留个洞。", "en": "An arrow went through, leaving a hole."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光扫过来，我的颜色更亮了。", "en": "The light passed and my colors brightened."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "纸不用吃饭，也不会饿。", "en": "Paper doesn't eat, so it can't starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电打上来，我的边一下子黑了。", "en": "The strike turned my edge black."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "掉进虚空，纸也留不下。", "en": "In the void, not even paper remains."}
      ]
    }
  }
}
