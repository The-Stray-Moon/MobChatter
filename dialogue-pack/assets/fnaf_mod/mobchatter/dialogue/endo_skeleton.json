{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的关节咔咔响", "en": "My joints click with each step."},
        {"zh": "金属脚踩在砖上", "en": "Metal feet on the tiles."},
        {"zh": "我走得很僵", "en": "I walk stiffly."},
        {"zh": "电线从肋骨间垂着", "en": "Wires dangle between my ribs."},
        {"zh": "我晃着往前走", "en": "I sway as I move."},
        {"zh": "空眼眶对着前面", "en": "Empty sockets face forward."},
        {"zh": "我的骨架很轻", "en": "My frame is very light."},
        {"zh": "走起来有回声", "en": "My steps echo."},
        {"zh": "我转头，脖子响了", "en": "My neck creaks as I turn."},
        {"zh": "我没有皮，只有铁", "en": "No skin, only metal."},
        {"zh": "我慢慢穿过走廊", "en": "I cross the corridor slowly."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，灯没亮", "en": "I stand here, unlit."},
        {"zh": "四处看看就好", "en": "Just looking around."},
        {"zh": "我的手指抽了一下", "en": "My fingers twitch."},
        {"zh": "这间屋里有回声", "en": "There is an echo in this room."},
        {"zh": "我没有表情", "en": "I have no expression."},
        {"zh": "我的头歪着", "en": "My head hangs crooked."},
        {"zh": "风扇声音很吵", "en": "That fan is loud."},
        {"zh": "我在原地张望", "en": "I look around from where I stand."},
        {"zh": "我听见脚步，但不追", "en": "I hear footsteps, but I do not chase."},
        {"zh": "关节里进了灰", "en": "Dust got into my joints."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我面前", "en": "You are standing before me."},
        {"zh": "你在等我动吗", "en": "Waiting for me to move?"},
        {"zh": "我只是个骨架", "en": "I am only an endoskeleton."},
        {"zh": "你的手电照到我了", "en": "Your torch found me."},
        {"zh": "我不追人", "en": "I do not chase people."},
        {"zh": "我的眼睛不会亮", "en": "My eyes will not light up."},
        {"zh": "你要看多久", "en": "How long will you look?"},
        {"zh": "你退后一点，我关节脏", "en": "Step back, my joints are dusty."},
        {"zh": "我认得这身制服", "en": "I know that uniform."},
        {"zh": "你听见我关节的声音了吗", "en": "Do you hear my joints?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的电线断了", "en": "A wire snapped."},
        {"zh": "我掉了颗螺栓", "en": "A bolt came loose."},
        {"zh": "关节处发出怪声", "en": "My joint made an odd sound."},
        {"zh": "我站不稳了", "en": "I cannot stay balanced."},
        {"zh": "我的头歪过去了", "en": "My head lolls."},
        {"zh": "火花溅出来", "en": "Sparks scatter."},
        {"zh": "我不会流血", "en": "I do not bleed."},
        {"zh": "骨架有点变形", "en": "My frame is bent."},
        {"zh": "我的手指不动了", "en": "My fingers stopped moving."},
        {"zh": "别再打了", "en": "Stop hitting me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我的嘴是空的", "en": "My mouth is an empty frame."},
        {"zh": "我把牙关咬空了", "en": "My jaw closed on nothing."},
        {"zh": "你把那东西举给谁看", "en": "Who are you showing that to?"},
        {"zh": "我的传感器动了一下", "en": "A sensor stirred."},
        {"zh": "我只能原地看", "en": "I can only watch from here."},
        {"zh": "拿走吧", "en": "Take it away."},
        {"zh": "我这一身零件够用了", "en": "My parts are enough for me."},
        {"zh": "有点响，我听见了", "en": "It rattles, I heard it."},
        {"zh": "放回去", "en": "Put it back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "金属碰到金属", "en": "Metal against metal."},
        {"zh": "我不太会躲", "en": "I am not good at dodging."},
        {"zh": "你撞得我关节错位", "en": "That knocked a joint loose."},
        {"zh": "我站得不稳", "en": "I am not standing steady."},
        {"zh": "我的手臂晃了晃", "en": "My arm swung."},
        {"zh": "你退开，我要落地", "en": "Step aside, I need to settle."},
        {"zh": "骨头和铁不一样", "en": "Bone and steel are different things."},
        {"zh": "我撞到墙了", "en": "I walked into the wall."},
        {"zh": "地砖很硬", "en": "The tiles are hard."},
        {"zh": "我慢半拍才反应", "en": "I react half a beat late."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有这种设计", "en": "I was not built for this."},
        {"zh": "关节对不上", "en": "Our joints do not line up."},
        {"zh": "别站这么近", "en": "Do not stand so close."},
        {"zh": "我只是台机器", "en": "I am only a machine."},
        {"zh": "这不在程序里", "en": "This is not in my programming."},
        {"zh": "我不会回应的", "en": "I will not respond."},
        {"zh": "灯都没开", "en": "The lights are not even on."},
        {"zh": "让我安静站着", "en": "Let me stand quietly."},
        {"zh": "你最好走开", "en": "You had better walk away."},
        {"zh": "这不是我该做的事", "en": "This is not for me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起来了", "en": "I picked it up."},
        {"zh": "我手指不太灵活", "en": "My fingers are not nimble."},
        {"zh": "这东西有点重", "en": "This is a little heavy."},
        {"zh": "我拿一会儿就放下", "en": "I will hold it, then set it down."},
        {"zh": "放进我的胸腔", "en": "I put it in my chest cavity."},
        {"zh": "我没打算留下", "en": "I do not mean to keep it."},
        {"zh": "手里有东西响声大", "en": "Things rattle in my grip."},
        {"zh": "它卡在我指缝里", "en": "It is stuck between my fingers."},
        {"zh": "我放回原处", "en": "I put it back where it was."},
        {"zh": "我拿着也没用", "en": "No use to me either way."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看过来，不代表要打", "en": "I look, that does not mean I fight."},
        {"zh": "你在我视野里", "en": "You are in my view."},
        {"zh": "我没有攻击指令", "en": "I have no attack order."},
        {"zh": "别指望我追", "en": "Do not expect me to chase."},
        {"zh": "你还是离远点", "en": "Keep your distance anyway."},
        {"zh": "我只是想看清你", "en": "I only want a closer look."},
        {"zh": "我的传感器锁住你", "en": "My sensors have caught you."},
        {"zh": "就站在那儿", "en": "Just stand there."},
        {"zh": "你走进我的范围", "en": "You stepped into my range."},
        {"zh": "我的步伐变慢了", "en": "My steps slowed."},
        {"zh": "我不会咬人", "en": "I do not bite."},
        {"zh": "这不算威胁", "en": "This is not a threat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我没在跟着你", "en": "I am not following you."},
        {"zh": "我走路本来就慢", "en": "I walk slowly by nature."},
        {"zh": "我在数地砖", "en": "I am counting floor tiles."},
        {"zh": "你别跑，我不追", "en": "Do not run, I will not chase."},
        {"zh": "我的关节响得清楚", "en": "My joints are loud."},
        {"zh": "我停在这个门口", "en": "I stop at this doorway."},
        {"zh": "我没有恶意", "en": "I mean no harm."},
        {"zh": "你走远一点，我就停下", "en": "Go farther and I stop."},
        {"zh": "我只是一直看着", "en": "I just keep watching."},
        {"zh": "走廊尽头很暗", "en": "The end of the hall is dark."},
        {"zh": "我没有别的动作", "en": "I have no other move."},
        {"zh": "我的影子不自然", "en": "My shadow looks wrong."},
        {"zh": "你要去哪", "en": "Where are you going?"},
        {"zh": "我还在原地", "en": "I am still where I was."},
        {"zh": "我数到十就转身", "en": "I will turn at ten."},
        {"zh": "你的脚步声我记下了", "en": "I noted your footsteps."},
        {"zh": "我把手垂下来了", "en": "I let my arms hang."},
        {"zh": "不用管我", "en": "Ignore me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬手，只是抬手", "en": "I raise my arm, only raise it."},
        {"zh": "我没有出手", "en": "I did not strike."},
        {"zh": "我的关节卡住了", "en": "My joint seized up."},
        {"zh": "手指扫到你了", "en": "My fingers brushed you."},
        {"zh": "我往前倾了一下", "en": "I tipped forward slightly."},
        {"zh": "这不是攻击", "en": "That was not an attack."},
        {"zh": "我撞到你，对不起", "en": "I bumped you, my apologies."},
        {"zh": "我扶着墙站住", "en": "I brace myself on the wall."},
        {"zh": "别以为我要扑上来", "en": "Do not think I am lunging."},
        {"zh": "我真的打不了人", "en": "I truly cannot fight."},
        {"zh": "我的动作只是抽搐", "en": "That was only a twitch."},
        {"zh": "你在防着我", "en": "You are guarding against me."},
        {"zh": "我没有恶意，真的", "en": "Truly, I mean nothing by it."},
        {"zh": "我退回去了", "en": "I am backing off now."},
        {"zh": "开关在我背后", "en": "The switch is on my back."},
        {"zh": "我不会再靠近", "en": "I will come no closer."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我被放下来了", "en": "I have been set down."},
        {"zh": "刷怪蛋亮了一下", "en": "The spawn egg flashed."},
        {"zh": "我的关节在响", "en": "My joints are creaking."},
        {"zh": "这里没有灯", "en": "There are no lights here."},
        {"zh": "不是自然生成的", "en": "I was not born here."},
        {"zh": "谁把我摆在这", "en": "Who placed me here?"},
        {"zh": "灰尘落了一身", "en": "Dust settles all over me."},
        {"zh": "我的视线很低", "en": "My line of sight is low."},
        {"zh": "房间很空", "en": "The room is empty."},
        {"zh": "我试着动了动手指", "en": "I try to wiggle my fingers."},
        {"zh": "我听见风扇在转", "en": "I hear a fan turning."},
        {"zh": "我被放在走廊", "en": "I was placed in a corridor."},
        {"zh": "手腕转了一圈", "en": "My wrist rotates fully."}
      ]
    },
