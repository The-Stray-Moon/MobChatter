{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "脚掌落地时，地砖响一下。", "en": "Each footfall ticks on the tile."},
        {"zh": "头歪着，永远歪着。", "en": "My head tilts, always tilted."},
        {"zh": "塑料外壳互相摩擦。", "en": "My plastic shell grinds together."},
        {"zh": "我从监控下面走过去。", "en": "I pass beneath a camera."},
        {"zh": "镜头跟着我转。", "en": "The lens turns to follow."},
        {"zh": "我没有抬头。", "en": "I do not look up."},
        {"zh": "我把地上的玩具踢到一边。", "en": "I nudge a toy out of the way."},
        {"zh": "羽毛一样的手指划过墙。", "en": "My feathery fingers trail the wall."},
        {"zh": "我停在门口，听了一会。", "en": "I stop at a doorway and listen."},
        {"zh": "然后继续走。", "en": "Then walk on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，嘴巴张着。", "en": "I stand with my beak open."},
        {"zh": "眼睛里的灯很亮。", "en": "The lights in my eyes are very bright."},
        {"zh": "我没有眨眼。", "en": "I do not blink."},
        {"zh": "关节停在一个角度。", "en": "My joints rest at one angle."},
        {"zh": "风扇声在头顶转。", "en": "A fan turns overhead."},
        {"zh": "我随它一起晃。", "en": "I sway with it."},
        {"zh": "我的裙边走了一道灰。", "en": "Dust lines my skirt's edge."},
        {"zh": "胸前的围兜歪了。", "en": "My bib hangs crooked."},
        {"zh": "我没有整理。", "en": "I do not straighten it."},
        {"zh": "有东西在远处响。", "en": "Something sounds far off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我低头看你，鸟喙一样的嘴张着。", "en": "I look down, beak-like mouth open."},
        {"zh": "你的脸在我的镜片里。", "en": "Your face is in my lenses."},
        {"zh": "我歪头，然后又歪回去。", "en": "I tilt my head, then tilt it back."},
        {"zh": "你说了一句话。", "en": "You say something."},
        {"zh": "我没有回答。", "en": "I do not answer."},
        {"zh": "我真的在听。", "en": "I truly am."},
        {"zh": "你退后了一步。", "en": "You step back."},
        {"zh": "我的头跟着转。", "en": "My head turns to follow."},
        {"zh": "只有一格。", "en": "One notch."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳凹了。", "en": "My shell dents."},
        {"zh": "关节卡了一下。", "en": "A joint seizes once."},
        {"zh": "里面的齿轮发出响声。", "en": "Gears grind inside me."},
        {"zh": "玩偶的关节响了一下，我站住了。", "en": "The animatronic's joint clicked; I held my ground."},
        {"zh": "电线露出来一截。", "en": "A wire shows."},
        {"zh": "我没有痛。", "en": "I feel no pain."},
        {"zh": "但我知道被打了。", "en": "But I know I was struck."},
        {"zh": "外壳裂了，眼睛还在亮。", "en": "My shell cracks; my eyes stay lit."},
        {"zh": "我把它掰回来。", "en": "I push it back."},
        {"zh": "灯还在亮。", "en": "The lights are still on."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举起食物。", "en": "You hold up food."},
        {"zh": "我的嘴没有动。", "en": "My mouth does not move."},
        {"zh": "我只认电，不认食物。", "en": "I run on power, not food."},
        {"zh": "你收回了手。", "en": "You withdraw it."},
        {"zh": "围兜下面，齿轮转了一格。", "en": "Beneath the bib, a gear turns one notch."},
        {"zh": "那是灯。", "en": "That is only light."},
        {"zh": "不是别的。", "en": "Nothing else."},
        {"zh": "你走开了。", "en": "You walk away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我的胸口，很硬。", "en": "You hit my chest; it is hard."},
        {"zh": "我的手指碰到你的肩。", "en": "My fingers touch your shoulder."},
        {"zh": "冷得像金属。", "en": "Cold as metal."},
        {"zh": "你的脚被我踩住。", "en": "Your foot is pinned under mine."},
        {"zh": "我慢慢抬起来。", "en": "I lift it slowly."},
        {"zh": "我们错身而过。", "en": "We pass each other."},
        {"zh": "我转过头看。", "en": "I turn my head to watch."},
        {"zh": "地砖上有一道新的划痕。", "en": "A new scratch marks the tile."},
        {"zh": "塑料壳撞出空空的响声。", "en": "My plastic shell knocks hollow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是电子玩偶。", "en": "I am an animatronic."},
        {"zh": "这里面没有那种东西。", "en": "There is nothing like that inside me."},
        {"zh": "我的胸口只有电池。", "en": "Only a battery in my chest."},
        {"zh": "齿轮在转。", "en": "Gears turn."},
        {"zh": "别的都没有。", "en": "Nothing else."},
        {"zh": "我的喙上涂着粉，别笑。", "en": "My beak is painted pink; do not laugh."},
        {"zh": "你不该问这个。", "en": "You should not ask that."},
        {"zh": "灯还亮着。", "en": "The lights are still on."},
        {"zh": "这里没有同类，只有灰。", "en": "No kin here, only dust."},
        {"zh": "一直到早上。", "en": "Until morning."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰，关节响了三下。", "en": "I bend; my joints click three times."},
        {"zh": "我把东西捡起来。", "en": "I pick it up."},
        {"zh": "我看了一会。", "en": "I look at it a while."},
        {"zh": "放进口袋里。", "en": "It goes in my pocket."},
        {"zh": "口袋是缝死的。", "en": "The pocket is sewn shut."},
        {"zh": "我把它塞到围兜里。", "en": "I tuck it into my bib."},
        {"zh": "它滑出来，掉在地上。", "en": "It slides out and drops."},
        {"zh": "我又捡了一次。", "en": "I pick it up again."},
        {"zh": "这次我抓紧了。", "en": "This time I grip."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你打了我的壳。", "en": "You struck my shell."},
        {"zh": "我停住了。", "en": "I stop."},
        {"zh": "关节慢慢转过来。", "en": "My joints turn slowly around."},
        {"zh": "我的头先到，身体后到。", "en": "My head arrives first; the body follows."},
        {"zh": "眼睛里的灯变红。", "en": "The light in my eyes turns red."},
        {"zh": "里面的牙是假的。", "en": "The teeth inside are fake."},
        {"zh": "但很硬。", "en": "But they are hard."},
        {"zh": "我跟着走。", "en": "I walk after."},
        {"zh": "一步一格。", "en": "One step, one notch."},
        {"zh": "我不着急。", "en": "I am in no hurry."},
        {"zh": "我很耐久。", "en": "I am very durable."},
        {"zh": "比你耐久。", "en": "More than you."},
        {"zh": "夜里的我，比白天多了牙齿。", "en": "At night I have more teeth than by day."},
        {"zh": "你看见了。", "en": "You have seen it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你，节奏很稳。", "en": "I follow at a steady rhythm."},
        {"zh": "你在跑，我不跑。", "en": "You run; I do not."},
        {"zh": "我的步幅比你的小。", "en": "My stride is shorter than yours."},
        {"zh": "但我不会累。", "en": "But I do not tire."},
        {"zh": "你翻过柜台。", "en": "You vault the counter."},
        {"zh": "我从门口绕进去。", "en": "I come around through the door."},
        {"zh": "你在走廊尽头回头。", "en": "You look back at the corridor's end."},
        {"zh": "我在那儿。", "en": "I am there."},
        {"zh": "关节一格一格地响。", "en": "My joints tick notch by notch."},
        {"zh": "灯在你头顶闪。", "en": "The light above you flickers."},
        {"zh": "你没有力气了。", "en": "You are losing strength."},
        {"zh": "我的手伸出去。", "en": "I reach out my hand."},
        {"zh": "指尖停在你面前。", "en": "My fingertips stop before you."},
        {"zh": "你没有动。", "en": "You do not move."},
        {"zh": "然后我抓住了。", "en": "Then I grab."},
        {"zh": "很轻。", "en": "Very lightly."},
        {"zh": "我没有追得很快。", "en": "I am not chasing quickly."},
        {"zh": "我只需要一直走。", "en": "I only need to keep walking."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手抓下去，指甲很钝。", "en": "My hand comes down; the nails are blunt."},
        {"zh": "但力道很大。", "en": "But the force is large."},
        {"zh": "我把它按在柜台上。", "en": "I press it onto the counter."},
        {"zh": "柜台裂了。", "en": "The counter cracks."},
        {"zh": "塑料外壳凹了一块。", "en": "A dent appears in my plastic."},
        {"zh": "我又往前走了一格。", "en": "I advance one notch."},
        {"zh": "手抬起来。", "en": "My hand rises."},
        {"zh": "落下去。", "en": "And falls."},
        {"zh": "这次更重。", "en": "Heavier this time."},
        {"zh": "它没有再站起来。", "en": "It does not rise again."},
        {"zh": "我歪着头看。", "en": "I watch with my head tilted."},
        {"zh": "我的眼睛没有暗下去。", "en": "My eyes do not dim."},
        {"zh": "我的手指夹住它的手腕。", "en": "My fingers clamp its wrist."},
        {"zh": "我们一起倒在柜台上。", "en": "We go down onto the counter together."},
        {"zh": "我先站起来。", "en": "I rise first."},
        {"zh": "它还在找平衡。", "en": "It is still finding its balance."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "舞台的幕布被拉开。", "en": "The stage curtain is pulled back."},
        {"zh": "灯一盏一盏亮。", "en": "The lights come on one by one."},
        {"zh": "我先动的是手指。", "en": "My fingers move first."},
        {"zh": "然后是我的头。", "en": "Then my head."},
        {"zh": "歪着。", "en": "Tilted."},
        {"zh": "音乐起了一个音。", "en": "The music plays one note."},
        {"zh": "我的脚落在台面上。", "en": "My foot lands on the stage."},
        {"zh": "灰尘从灯罩上落下来。", "en": "Dust falls from the lampshade."},
        {"zh": "我走下台阶。", "en": "I walk down the steps."},
        {"zh": "这一夜很长。", "en": "This night is long."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "塑料外壳开始软。", "en": "My plastic shell softens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在地上，关节全散了。", "en": "I fall and my joints scatter."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从缝里进去，灯闪了两下。", "en": "Water enters the seams; my lights flicker twice."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被掀翻，零件落了一地。", "en": "I am thrown down; parts scatter."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西嵌进我的胸口。", "en": "It embeds in my chest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的动作变慢。", "en": "Magic slows my motion."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的电池不是这样耗的。", "en": "My battery does not drain that way."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷让我的线路烧了一下。", "en": "Lightning burns through my wiring."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在下坠，灯灭了。", "en": "I am falling, and my lights go out."}
      ]
    }
  }
}
