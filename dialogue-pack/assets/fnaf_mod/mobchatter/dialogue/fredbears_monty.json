{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "这道门我从未自己推开。", "en": "I've never opened this door myself."},
        {"zh": "我的脚是固定的。", "en": "My feet are fixed in place."},
        {"zh": "我试着迈步，只听见电机。", "en": "I try to step, only a motor answers."},
        {"zh": "灰尘在我脚边积成圈。", "en": "Dust rings my feet."},
        {"zh": "我被摆在这个位置。", "en": "I was placed in this spot."},
        {"zh": "墙上的影子比我先到。", "en": "My shadow reaches the wall before I do."},
        {"zh": "这间屋子不是我的。", "en": "This room isn't mine."},
        {"zh": "我朝着有声音的方向偏。", "en": "I lean toward the sound."},
        {"zh": "我的关节有锈。", "en": "Rust in my joints."},
        {"zh": "地板的每一块我都记得。", "en": "I know every board in this floor."},
        {"zh": "我动不了，但灯在动。", "en": "I can't move, but the light does."},
        {"zh": "这一步停在半路。", "en": "This step stops halfway."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱着手臂站在角落。", "en": "I stand in the corner with folded arms."},
        {"zh": "我的眼睛亮着两点光。", "en": "Two points of light in my eyes."},
        {"zh": "没有人放我进来。", "en": "No one let me in."},
        {"zh": "我是被人从外面带来的。", "en": "I was brought here from outside."},
        {"zh": "这店里没有我的位置。", "en": "There's no place for me here."},
        {"zh": "我的外壳上有一道划痕。", "en": "A scratch across my shell."},
        {"zh": "我在听水管里的声音。", "en": "I listen to the pipes."},
        {"zh": "这地方没自然生成过我。", "en": "I've never spawned here naturally."},
        {"zh": "灯照得我的漆发亮。", "en": "The lamp makes my paint shine."},
        {"zh": "我的姿势有点僵。", "en": "My pose is a bit stiff."},
        {"zh": "墙角的蜘蛛网还在。", "en": "The cobweb in the corner remains."},
        {"zh": "我在等有人来摆我。", "en": "I wait for someone to arrange me."},
        {"zh": "夜很长。", "en": "The night is long."},
        {"zh": "我什么也不做。", "en": "I do nothing at all."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那枚蛋。", "en": "That egg in your hand."},
        {"zh": "是你把我放出来的。", "en": "You're the one who placed me."},
        {"zh": "我不是这里生的。", "en": "I wasn't born here."},
        {"zh": "你摆的位置不太对。", "en": "You put me in a poor spot."},
        {"zh": "我的脸对着墙了。", "en": "My face is turned to the wall."},
        {"zh": "你能听见我的电机吗？", "en": "Can you hear my motor?"},
        {"zh": "我站着，你绕着我看。", "en": "I stand, you circle me."},
        {"zh": "你这个角度看不全我。", "en": "You can't see all of me from there."},
        {"zh": "别碰我的漆。", "en": "Don't touch my paint."},
        {"zh": "你打算拿我做什么？", "en": "What do you plan to do with me?"},
        {"zh": "我只是一件摆设。", "en": "I'm only a display piece."},
        {"zh": "你看起来很有兴致。", "en": "You look quite entertained."},
        {"zh": "这儿没有别的客人。", "en": "There are no other guests here."},
        {"zh": "你要把我搬走吗？", "en": "Will you move me?"},
        {"zh": "我的眼睛一直亮着。", "en": "My eyes stay lit."},
        {"zh": "你走一步，我就偏一寸。", "en": "One step from you, one inch of lean from me."},
        {"zh": "我记下了你的脸。", "en": "I've noted your face."},
        {"zh": "这地方不适合我。", "en": "This place doesn't suit me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的漆掉了一块。", "en": "A patch of my paint came off."},
        {"zh": "外壳上多了个坑。", "en": "A new dent in my shell."},
        {"zh": "我不会疼，只会响。", "en": "I don't hurt, I only clatter."},
        {"zh": "关节松了。", "en": "A joint has come loose."},
        {"zh": "我的姿势偏了一点。", "en": "My pose has shifted slightly."},
        {"zh": "里面的线露出来了。", "en": "Wires are showing inside."},
        {"zh": "我可能要倒了。", "en": "I might topple."},
        {"zh": "这店里没人修我。", "en": "No one here repairs me."},
        {"zh": "我连一步都挪不动。", "en": "I can't shift a single step."},
        {"zh": "你不该弄坏展品。", "en": "You shouldn't break the exhibit."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我的嘴是画在壳上的。", "en": "My mouth is painted onto my shell."},
        {"zh": "我的外壳是封死的。", "en": "My shell is sealed."},
        {"zh": "你举着它干什么？", "en": "What are you holding that up for?"},
        {"zh": "我连嘴都张不大。", "en": "I can barely open my mouth."},
        {"zh": "放地上吧。", "en": "Put it on the ground."},
        {"zh": "这味道不属于我。", "en": "That smell isn't for me."},
        {"zh": "我不饿，十年了。", "en": "I'm not hungry, not in ten years."},
        {"zh": "这块东西放我脚边，碍事。", "en": "Left by my feet, this thing only gets in the way."},
        {"zh": "举这么高，我够不到。", "en": "So high up, I can't reach."},
        {"zh": "别指望我领情。", "en": "Don't expect gratitude."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上来，我一动不动。", "en": "You bump me, I don't move."},
        {"zh": "我的膝盖是块铁。", "en": "My knee is solid iron."},
        {"zh": "别推我，我会直直倒下。", "en": "Don't push, I'd fall straight over."},
        {"zh": "你踩到了我的底座。", "en": "You stepped on my base."},
        {"zh": "我的外壳硬得硌手。", "en": "My shell is hard and grating."},
        {"zh": "灰尘从你的肩膀弹到我身上。", "en": "Dust jumps from your shoulder onto me."},
        {"zh": "我晃了一点，又正回去。", "en": "I wobble a bit and settle back."},
        {"zh": "退开，我们位置太挤。", "en": "Back off, we're too crowded."},
        {"zh": "这点碰撞不会让我出声。", "en": "Such a bump won't make me speak."},
        {"zh": "别贴着我的背。", "en": "Don't stand against my back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是被放出来的一个摆件。", "en": "I'm a fixture someone placed."},
        {"zh": "写下这程序的人没想过。", "en": "Whoever wrote my program didn't consider it."},
        {"zh": "我连手都放不低。", "en": "I can't even lower my arms."},
        {"zh": "这话题太奇怪了。", "en": "That's an odd topic."},
        {"zh": "去找活的东西吧。", "en": "Seek something alive."},
        {"zh": "我不属于任何地方。", "en": "I don't belong anywhere."},
        {"zh": "我不会回应这个。", "en": "I won't answer that."},
        {"zh": "我的时间停住了。", "en": "My time is stopped."},
        {"zh": "安安静静站着就好。", "en": "Standing quietly is enough."},
        {"zh": "你走开一会吧。", "en": "Step away for a while."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "东西滚到我靴边，停住了。", "en": "It rolls to my boot and stops there."},
        {"zh": "你脚边那枚硬币。", "en": "That coin by your boot."},
        {"zh": "我的指头抓不拢。", "en": "My fingers won't close."},
        {"zh": "这店里没有可捡的东西。", "en": "Nothing here is for picking up."},
        {"zh": "我自己都没被人收拾过。", "en": "No one has ever tidied me."},
        {"zh": "它就在砖缝里。", "en": "It's in the tile seam."},
        {"zh": "我的关节只能转半寸。", "en": "My joints turn half an inch."},
        {"zh": "你替我拿吧。", "en": "Pick it up for me."},
        {"zh": "没人在乎这些。", "en": "Nobody cares about these."},
        {"zh": "留着吧，会有人来。", "en": "Leave it, someone will come."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有任何目标。", "en": "I have no target at all."},
        {"zh": "我只是被摆在这里。", "en": "I was merely placed here."},
        {"zh": "你有没有觉得我在看你？", "en": "Do you feel I'm watching you?"},
        {"zh": "我的眼睛是朝着门口的。", "en": "My eyes face the doorway."},
        {"zh": "你绕着墙走了一圈。", "en": "You've circled the walls once."},
        {"zh": "这个位置看得很清楚。", "en": "I see everything from here."},
        {"zh": "你的手电照到我，就够了。", "en": "Your torch finding me is enough."},
        {"zh": "我不追，也不会追。", "en": "I don't chase, and I won't."},
        {"zh": "你越紧张，我越安静。", "en": "The tenser you get, the quieter I am."},
        {"zh": "这屋子没有别人。", "en": "There's no one else in this room."},
        {"zh": "我们都很清楚。", "en": "We both understand."},
        {"zh": "灯还会亮很久。", "en": "The lamp will burn a while yet."},
        {"zh": "你还没走出去。", "en": "You still haven't left."},
        {"zh": "我就站在这。", "en": "I'll just stand here."},
        {"zh": "你打算待到什么时候？", "en": "How long do you plan to stay?"},
        {"zh": "我不催你。", "en": "I won't rush you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛一直朝你。", "en": "My eyes stay on you."},
        {"zh": "你退到这个墙角了。", "en": "You've backed into this corner."},
        {"zh": "我的影子刚好罩住你。", "en": "My shadow just covers you."},
        {"zh": "你没有注意到我的姿势变了。", "en": "You didn't notice my pose changed."},
        {"zh": "其实没有变。", "en": "It didn't, actually."},
        {"zh": "我站在这里，一整晚都不动。", "en": "I stand here all night without moving."},
        {"zh": "我在听你的脚步。", "en": "I listen to your steps."},
        {"zh": "你往左，我就偏左。", "en": "You go left, I lean left."},
        {"zh": "这是错觉。", "en": "It's an illusion."},
        {"zh": "灯灭一会，你就不敢动了。", "en": "One blackout and you'll freeze."},
        {"zh": "可我也没有动。", "en": "And I haven't moved either."},
        {"zh": "这地方太安静。", "en": "This place is too quiet."},
        {"zh": "你的呼吸是我唯一的声响。", "en": "Your breath is my only sound."},
        {"zh": "再听一会。", "en": "Listen a little longer."},
        {"zh": "你听见自己的心跳了。", "en": "You hear your own heartbeat."},
        {"zh": "而我一动不动。", "en": "And I stay perfectly still."},
        {"zh": "天还没亮。", "en": "The day hasn't broken."},
        {"zh": "你还有时间。", "en": "You still have time."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有出手。", "en": "I didn't strike."},
        {"zh": "是你撞到了我的外壳。", "en": "You ran into my shell."},
        {"zh": "我的手臂是抬着的。", "en": "My arms are raised."},
        {"zh": "你撞进了我的臂弯。", "en": "You ran into my arm's crook."},
        {"zh": "这一下不是我给的。", "en": "I didn't give that blow."},
        {"zh": "你的肩膀被我的关节刮到。", "en": "My joint scraped your shoulder."},
        {"zh": "声音在这个空屋里很大。", "en": "The sound is loud in this empty room."},
        {"zh": "我依然立着。", "en": "I still stand."},
        {"zh": "你退后三步。", "en": "Three steps back."},
        {"zh": "脚下有血，不是我的。", "en": "Blood on the floor, not mine."},
        {"zh": "我只想安静地站着。", "en": "I only want to stand quietly."},
        {"zh": "别再靠近。", "en": "Don't come closer."},
        {"zh": "我的关节发出很轻的响。", "en": "My joints tick softly."},
        {"zh": "你手上的伤不会自己好。", "en": "That cut on your hand won't heal itself."},
        {"zh": "这里没有药。", "en": "There's no medicine here."},
        {"zh": "你可以离去了。", "en": "You may go now."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "蛋壳碎开，我就在这了。", "en": "The egg cracks, and here I am."},
        {"zh": "我是被放出来的，不是生出来的。", "en": "I was placed, not born."},
        {"zh": "这间屋子我头一次见。", "en": "First time I've seen this room."},
        {"zh": "我的底座落在地上。", "en": "My base settles on the floor."},
        {"zh": "灯亮的时候我已经站好了。", "en": "When the light came on, I was already standing."},
        {"zh": "没有别人在这里。", "en": "No one else is here."},
        {"zh": "灰尘慢慢落到我肩上。", "en": "Dust settles on my shoulders."},
        {"zh": "我的眼睛亮了两点绿。", "en": "Two green points light in my eyes."},
        {"zh": "这里不是餐厅。", "en": "This isn't the diner."},
        {"zh": "但我也照样站着。", "en": "But I stand just the same."},
        {"zh": "我没法自己走路。", "en": "I can't walk on my own."},
        {"zh": "你可以把我搬到别处。", "en": "You could move me elsewhere."},
        {"zh": "可我现在只能在这。", "en": "For now I can only be here."},
        {"zh": "我身上还带着仓库的灰。", "en": "I still carry the warehouse dust on me."},
        {"zh": "我听见风从门缝进来。", "en": "I hear wind through the door gap."},
        {"zh": "有人在附近。", "en": "Someone is nearby."},
        {"zh": "有人把我摆正，我就没再动。", "en": "Someone set me upright and I have not moved since."},
        {"zh": "就这个姿势。", "en": "Just this pose."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我的外壳变了色。", "en": "Fire discolors my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "倒下时我砸碎了地砖。", "en": "Falling, I cracked the floor tiles."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌了进来，灯一下灭了。", "en": "Water floods in, my lights die at once."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀翻在地上。", "en": "The blast knocked me flat."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这个扎进了我的肩。", "en": "That stuck in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的电机突然乱转。", "en": "My motor suddenly races."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有电，我连姿势都撑不住。", "en": "Without power I can't hold my pose."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下，我的外壳嗡嗡响。", "en": "Lightning strikes and my shell buzzes."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有地板给我站。", "en": "No floor to stand on in the void."}
      ]
    }
  }
}
