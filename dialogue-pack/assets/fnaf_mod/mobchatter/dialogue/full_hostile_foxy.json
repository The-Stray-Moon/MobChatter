{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的钩子刮着墙", "en": "My hook scrapes the wall."},
        {"zh": "木头关节吱吱响", "en": "My wooden joints creak."},
        {"zh": "走廊被我一步步占满", "en": "I fill the corridor step by step."},
        {"zh": "眼罩歪了一边", "en": "My eyepatch is askew."},
        {"zh": "走廊太窄了", "en": "The corridor is too narrow."},
        {"zh": "我低头穿过门框", "en": "I duck through the doorway."},
        {"zh": "我的尾巴摆来摆去", "en": "My tail swings side to side."},
        {"zh": "铁钩在灯下反光", "en": "The hook glints under the lamp."},
        {"zh": "我不跑，我走", "en": "I do not run, I walk."},
        {"zh": "我每一步都很沉", "en": "Every step lands heavy."},
        {"zh": "披风缠在腿上", "en": "My cape tangles around my legs."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这儿等", "en": "I wait here."},
        {"zh": "灯闪的时候我就在", "en": "I am here when the light flickers."},
        {"zh": "我磨了磨钩子", "en": "I rub the edge of my hook."},
        {"zh": "这层楼没人", "en": "This floor is empty."},
        {"zh": "我歪着头听", "en": "I tilt my head to listen."},
        {"zh": "我的下巴合不严", "en": "My jaw will not close right."},
        {"zh": "我数着走廊里的脚步", "en": "I count footsteps in the hall."},
        {"zh": "好久没有跑过了", "en": "It has been long since I ran."},
        {"zh": "袖子上的布破了", "en": "The cloth on my sleeve is torn."},
        {"zh": "我慢慢地转过头", "en": "I turn my head slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "跑吧", "en": "Run."},
        {"zh": "我看着你从这儿过去", "en": "I watched you go by."},
        {"zh": "你的手电很亮", "en": "Your torch is very bright."},
        {"zh": "你退到哪儿都一样", "en": "Retreating will not change anything."},
        {"zh": "海盗的钩子，已经举起来。", "en": "The pirate's hook is raised."},
        {"zh": "我笑了", "en": "I am grinning."},
        {"zh": "你挡着门口了", "en": "You are blocking the doorway."},
        {"zh": "我这边有钩子", "en": "I have a hook on this side."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的下巴松了", "en": "My jaw came loose."},
        {"zh": "我的木头裂开一道", "en": "A split opened in my wood."},
        {"zh": "你打断了我的腿", "en": "You broke my leg."},
        {"zh": "我的眼罩掉了", "en": "My eyepatch fell off."},
        {"zh": "钩子握不稳了", "en": "My grip on the hook is shaky."},
        {"zh": "我发出木头的声音", "en": "I make a wooden sound."},
        {"zh": "你打得比我快", "en": "You strike faster than I do."},
        {"zh": "我还在走", "en": "I am still walking."},
        {"zh": "这次算你厉害", "en": "You got me this time."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那不是我要的东西", "en": "That is not what I want."},
        {"zh": "你举着它想干什么", "en": "What are you doing with that?"},
        {"zh": "我只要人", "en": "I only want people."},
        {"zh": "放下来，别浪费时间", "en": "Put it down, do not waste time."},
        {"zh": "我闻到你身上的味道", "en": "I smell you."},
        {"zh": "你手里那点东西挡不住我", "en": "That will not stop me."},
        {"zh": "我不感兴趣", "en": "I am not interested."},
        {"zh": "我走了", "en": "I am coming anyway."},
        {"zh": "这东西晃得我烦", "en": "Its swaying annoys me."},
        {"zh": "别想引开我", "en": "Do not try to lure me away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的胸口", "en": "You hit my chest."},
        {"zh": "我几乎不退", "en": "I barely move back."},
        {"zh": "木头很沉", "en": "The wood is heavy."},
        {"zh": "你撞完就想跑", "en": "Bump me and then run?"},
        {"zh": "我的钩子擦过你的肩", "en": "My hook brushed your shoulder."},
        {"zh": "你被顶到墙上了", "en": "You are pressed against the wall."},
        {"zh": "我的眼罩掉了一点", "en": "My eyepatch slipped."},
        {"zh": "让开，路太窄", "en": "Move, the hall is narrow."},
        {"zh": "我的手腕转了一下", "en": "My wrist rotated."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只会追人", "en": "I only chase."},
        {"zh": "我们的关节对不上", "en": "Our joints do not fit."},
        {"zh": "别站在走廊里", "en": "Do not stand in the corridor."},
        {"zh": "我身上是旧木头", "en": "I am made of old wood."},
        {"zh": "你最好马上走", "en": "You had best leave now."},
        {"zh": "灯灭了就什么都不算", "en": "When the lights die, nothing counts."},
        {"zh": "我不看这种事", "en": "I do not watch such things."},
        {"zh": "我的钩子还拿着", "en": "I am still holding my hook."},
        {"zh": "别挡在走廊中间", "en": "Do not stand in the middle of the hall."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一手拿得住", "en": "I can hold it in one hand."},
        {"zh": "钩子不方便捡东西", "en": "A hook is awkward for picking things up."},
        {"zh": "掉的东西我踩过去", "en": "I walk over what falls."},
        {"zh": "这个我用得上", "en": "I can use this."},
        {"zh": "我夹在指缝里", "en": "I wedge it between my fingers."},
        {"zh": "布条我留着", "en": "I will keep the cloth strip."},
        {"zh": "我抓着它晃了晃", "en": "I shake it in my grip."},
        {"zh": "有人要找这个吗", "en": "Is someone looking for this?"},
        {"zh": "我先收着", "en": "I will hold on to it."},
        {"zh": "别伸手抢", "en": "Do not reach for it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你跑得不够快", "en": "You are not running fast enough."},
        {"zh": "你回头看了", "en": "You looked back."},
        {"zh": "现在开始是追逐", "en": "Now the chase begins."},
        {"zh": "我记住这个走廊了", "en": "I know this corridor."},
        {"zh": "你的脚印在这儿", "en": "Your prints are here."},
        {"zh": "我不会停", "en": "I will not stop."},
        {"zh": "我的钩子已经抬起来", "en": "My hook is already raised."},
        {"zh": "你选了这条错路", "en": "You chose the wrong hall."},
        {"zh": "门锁上也没用", "en": "Locking the door will not help."},
        {"zh": "钩子已经举过肩", "en": "My hook is above my shoulder."},
        {"zh": "你别躲在柜子里", "en": "Do not hide in the locker."},
        {"zh": "灯闪了", "en": "The lights flickered."},
        {"zh": "你还没跑", "en": "You have not started running."},
        {"zh": "这一层我熟", "en": "I know this floor."},
        {"zh": "别回头看第二次", "en": "Do not look back a second time."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在走廊尽头", "en": "I am at the end of the hall."},
        {"zh": "你听，木头在响", "en": "Listen, wood creaking."},
        {"zh": "你拐弯我就抄近道", "en": "Turn a corner and I take the shortcut."},
        {"zh": "钩尖擦过墙皮", "en": "The hook's tip scrapes the wallpaper."},
        {"zh": "你手电照不到我", "en": "Your torch does not reach me."},
        {"zh": "门后面不安全", "en": "Behind the door is not safe."},
        {"zh": "你就快跑不动了", "en": "You are almost out of breath."},
        {"zh": "我不急，我一直在走", "en": "I am in no hurry, I keep walking."},
        {"zh": "你数着还剩几扇门", "en": "Counting how many doors are left?"},
        {"zh": "通风口太小了", "en": "The vent is too small."},
        {"zh": "这条路是死的", "en": "This passage is a dead end."},
        {"zh": "我离你十几步", "en": "I am a dozen steps away."},
        {"zh": "你听见脚步声了吗", "en": "Do you hear the footsteps?"},
        {"zh": "你把背贴在墙上了", "en": "Your back is against the wall."},
        {"zh": "我的眼罩后面也看得见", "en": "I see even behind this eyepatch."},
        {"zh": "再跑一会", "en": "Run a little longer."},
        {"zh": "这层楼只有一扇出口", "en": "This floor has one way out."},
        {"zh": "我把它堵住了", "en": "I am blocking it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "钩子横着扫过来", "en": "My hook sweeps across."},
        {"zh": "我压住你的肩", "en": "I pin your shoulder."},
        {"zh": "这一下是木头的重量", "en": "That was the weight of old wood."},
        {"zh": "你被甩到墙边", "en": "You are thrown to the wall."},
        {"zh": "我的下巴咬合了一下", "en": "My jaw snapped shut."},
        {"zh": "你护住了胸口", "en": "You guarded your chest."},
        {"zh": "钩子勾住你的袖子", "en": "My hook snags your sleeve."},
        {"zh": "我抬手就是一下", "en": "I raise my arm and swing."},
        {"zh": "你退了半步，还不够", "en": "You stepped back, not far enough."},
        {"zh": "我的钩尖碰到你了", "en": "The hook's point found you."},
        {"zh": "下一钩更沉", "en": "The next hook lands heavier."},
        {"zh": "你摔倒在电线上了", "en": "You fell onto the wires."},
        {"zh": "我压得很低", "en": "I keep low."},
        {"zh": "这一下你听见了吧", "en": "You heard that one, surely."},
        {"zh": "别拉着帘子", "en": "Do not grab the curtain."},
        {"zh": "我抓住你的领子", "en": "I grab your collar."},
        {"zh": "你还能站起来", "en": "You can still stand."},
        {"zh": "我就站在这里", "en": "I am standing right here."},
        {"zh": "下一下更重", "en": "The next is heavier."},
        {"zh": "你跑不掉了", "en": "You are not getting away."}
      ]
    },
