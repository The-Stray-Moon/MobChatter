{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "长耳朵拖过地面。", "en": "My long ears drag the floor."},
        {"zh": "紫色的布褪成灰。", "en": "Purple cloth faded to gray."},
        {"zh": "脚踝发出铁响。", "en": "My ankle rattles with iron."},
        {"zh": "一步一停，往前挪。", "en": "A step, a pause, forward."},
        {"zh": "西装下摆被勾住。", "en": "My suit snags on things."},
        {"zh": "手臂僵着抬不起来。", "en": "My arm won't lift."},
        {"zh": "牙齿缝里透出光。", "en": "Light shows through my teeth."},
        {"zh": "背驼得越来越低。", "en": "My back stoops lower."},
        {"zh": "靴子在木板上响。", "en": "My boots creak on the boards."},
        {"zh": "朝亮着灯的屋子去。", "en": "Heading for the lit room."},
        {"zh": "弹簧在膝里咔嗒。", "en": "A spring clicks in my knee."},
        {"zh": "影子歪得不成样子。", "en": "My shadow is misshapen."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "耳朵垂着，听风。", "en": "Ears drooping, I listen."},
        {"zh": "我数墙里的声音。", "en": "I count the sounds in the walls."},
        {"zh": "嘴里咬着旧布带。", "en": "An old strap between my teeth."},
        {"zh": "关节一直在响。", "en": "My joints never stop creaking."},
        {"zh": "这身紫衣有股潮味。", "en": "This purple suit smells damp."},
        {"zh": "手指僵成一个形状。", "en": "My fingers froze in one shape."},
        {"zh": "灯泡晃得我发晕。", "en": "The swaying bulb makes me dizzy."},
        {"zh": "我站的位置看得见门。", "en": "From here I can see the door."},
        {"zh": "身体里的铁在挪。", "en": "Iron shifts inside me."},
        {"zh": "我试着张嘴，只出声。", "en": "I try to speak — only a sound."},
        {"zh": "地上有一小片血。", "en": "A small patch of blood."},
        {"zh": "鼻子早就不在了。", "en": "My nose has long been gone."},
        {"zh": "我在想我是谁。", "en": "I wonder who I am."},
        {"zh": "门外没有风。", "en": "No draft at the door."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你听见我的声音吗？", "en": "Can you hear my voice?"},
        {"zh": "我的耳朵是不是太长。", "en": "Are my ears too long?"},
        {"zh": "别站在那里不动。", "en": "Don't just stand there."},
        {"zh": "紫色底下全是铁。", "en": "Iron under all this purple."},
        {"zh": "我的笑有点歪。", "en": "My smile is a little crooked."},
        {"zh": "你把手放下了，好。", "en": "You lowered your hands. Good."},
        {"zh": "我在这层楼很久了。", "en": "I've been on this floor a long while."},
        {"zh": "紫色在暗处看不出。", "en": "Purple hides in the dark."},
        {"zh": "你要找出口吧。", "en": "You're looking for a way out."},
        {"zh": "我说话很慢。", "en": "I speak very slowly."},
        {"zh": "你的呼吸真好听。", "en": "Your breathing sounds lovely."},
        {"zh": "我想碰一下你的手。", "en": "I want to touch your hand."},
        {"zh": "灯照不到我的角落。", "en": "The lamp misses my corner."},
        {"zh": "别怕这只耳朵。", "en": "Don't fear this ear."},
        {"zh": "你还愿意看吗。", "en": "Do you still want to look?"},
        {"zh": "我想不起自己的名字。", "en": "I can't recall my name."},
        {"zh": "站远一点也好。", "en": "Standing farther back is fine too."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手臂掉了一截。", "en": "A piece of my arm came off."},
        {"zh": "布面撕开，露铁了。", "en": "The cloth tore, showing iron."},
        {"zh": "耳朵被扯断了半只。", "en": "Half an ear got torn."},
        {"zh": "我的一条腿卡住了。", "en": "One leg has jammed."},
        {"zh": "紫布上多了道口子。", "en": "Another rip in the purple."},
        {"zh": "嘴里流出黑色的东西。", "en": "Something black runs from my mouth."},
        {"zh": "我还站在这里。", "en": "I'm still standing here."},
        {"zh": "弹簧又弹出一根。", "en": "Another spring popped out."},
        {"zh": "我记住你的外套。", "en": "I remember your coat."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我根本咬不动它。", "en": "I can't chew it at all."},
        {"zh": "闻起来是甜的。", "en": "It smells sweet."},
        {"zh": "手够不到那里。", "en": "My hand won't reach."},
        {"zh": "我张着嘴，可咬不下去。", "en": "My mouth hangs open, but it cannot bite down."},
        {"zh": "放进我嘴里吧。", "en": "Put it in my mouth."},
        {"zh": "嘴里还含着布。", "en": "There's still cloth in my mouth."},
        {"zh": "那味道吸引我。", "en": "That smell pulls at me."},
        {"zh": "你拿着别动。", "en": "Hold it still."},
        {"zh": "过来，往这边过来。", "en": "Come here. Come here."},
        {"zh": "我很久没吃到热的。", "en": "Long since I ate anything warm."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "别碰我的耳朵。", "en": "Don't touch my ears."},
        {"zh": "你撞到我的膝了。", "en": "You hit my knee."},
        {"zh": "铁在里面响。", "en": "Iron rings inside me."},
        {"zh": "我站不太稳。", "en": "I don't stand too steady."},
        {"zh": "退开，我身上有刺。", "en": "Back off. I have spikes."},
        {"zh": "紫布扯开一道口。", "en": "A tear in the purple cloth."},
        {"zh": "弹簧里还卡着旧骨头。", "en": "Old bones still jam the springlocks."},
        {"zh": "我们撞得很响。", "en": "We hit with a clatter."},
        {"zh": "别推我，我会倒。", "en": "Don't push me. I'll fall."},
        {"zh": "让我扶一下墙。", "en": "Let me brace on the wall."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这副样子不行。", "en": "Not looking like this."},
        {"zh": "里面全是铁和布。", "en": "Only iron and cloth inside."},
        {"zh": "你该去找活的。", "en": "Find someone alive."},
        {"zh": "我只是想有个人说话。", "en": "I only wanted someone to talk to."},
        {"zh": "我连拥抱都做不好。", "en": "I can't even hug properly."},
        {"zh": "耳朵别贴着我。", "en": "Keep your ears off me."},
        {"zh": "天黑之前走吧。", "en": "Leave before dark."},
        {"zh": "这身衣脱不下来。", "en": "This suit won't come off."},
        {"zh": "你笑起来真好看。", "en": "Your smile is lovely."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手不听话。", "en": "My hands won't obey."},
        {"zh": "捡起来放到我手心。", "en": "Pick it up. Put it in my palm."},
        {"zh": "这块布能补衣袖。", "en": "This cloth can patch my sleeve."},
        {"zh": "地上有颗扣子。", "en": "A button on the floor."},
        {"zh": "我夹不住了。", "en": "I can't pinch it anymore."},
        {"zh": "这声音真脆。", "en": "Such a crisp sound."},
        {"zh": "这是块零件吗？", "en": "Is this a machine part?"},
        {"zh": "那就留着吧。", "en": "Then I'll keep it."},
        {"zh": "我手上还沾着油。", "en": "There's still grease on my hand."},
        {"zh": "还有一半没捡。", "en": "Half of it's still there."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "门口的灯灭了。", "en": "The lamp by the door died."},
        {"zh": "那个人站在走廊。", "en": "That one stands in the hall."},
        {"zh": "弹簧一根根动。", "en": "Springs move one by one."},
        {"zh": "我听见你的鞋。", "en": "I hear your shoes."},
        {"zh": "这只耳朵转过去了。", "en": "This ear turned toward you."},
        {"zh": "我的耳朵竖起来了。", "en": "My ears went up."},
        {"zh": "不能让你走。", "en": "I can't let you go."},
        {"zh": "这层楼只有我们。", "en": "Only us on this floor."},
        {"zh": "往那边退是墙。", "en": "Back there is a wall."},
        {"zh": "这块地板我踩过。", "en": "I've stepped on this board."},
        {"zh": "有人在看我们吗。", "en": "Is anyone watching us?"},
        {"zh": "笑一下，然后就动。", "en": "One smile, then I move."},
        {"zh": "别让我走完这段。", "en": "Don't let me finish this walk."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在跟着你的脚步。", "en": "I follow your footsteps."},
        {"zh": "你拐进那间屋了。", "en": "You turned into that room."},
        {"zh": "那屋子只有一个门。", "en": "That room has one way out."},
        {"zh": "我的脚很沉。", "en": "My feet are heavy."},
        {"zh": "耳朵听见你的心跳。", "en": "My ears catch your heartbeat."},
        {"zh": "我一步一步往前。", "en": "One step at a time."},
        {"zh": "紫布擦着墙。", "en": "The purple cloth brushes the wall."},
        {"zh": "你屏住呼吸了吧。", "en": "You're holding your breath."},
        {"zh": "我没打算跑。", "en": "I don't intend to run."},
        {"zh": "门把手响了一下。", "en": "The doorknob turned."},
        {"zh": "我就站在原地看。", "en": "I stand and watch."},
        {"zh": "你藏得不太好。", "en": "You're not hiding well."},
        {"zh": "我听见布料摩擦。", "en": "I hear fabric rustle."},
        {"zh": "再过一会儿。", "en": "In a moment."},
        {"zh": "灯泡在头顶晃。", "en": "The bulb sways overhead."},
        {"zh": "让我走近一些。", "en": "Let me come closer."},
        {"zh": "你的喘气越来越急。", "en": "Your gasps come faster."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "手抓住你了。", "en": "My hand caught you."},
        {"zh": "耳朵甩过去。", "en": "My ear whips across."},
        {"zh": "铁架顶出来。", "en": "The frame juts out."},
        {"zh": "别挣，很快就空。", "en": "Don't struggle. It'll be quick."},
        {"zh": "这一抓带着弹簧。", "en": "This grip carries a springlock."},
        {"zh": "我的笑还挂着。", "en": "My smile is still there."},
        {"zh": "肩膀扭了一下。", "en": "I twisted my shoulder."},
        {"zh": "你软下去了。", "en": "You went limp."},
        {"zh": "我会好好放好你。", "en": "I'll set you down properly."},
        {"zh": "这不是我想做的。", "en": "This isn't what I wanted."},
        {"zh": "手放不开了。", "en": "My hands won't open."},
        {"zh": "千万别出声。", "en": "Not a sound."},
        {"zh": "很轻的，放心。", "en": "It's gentle. Don't worry."},
        {"zh": "我身上掉了几颗钉。", "en": "A few pins fell out of me."},
        {"zh": "下一次就不会了。", "en": "There won't be a next time."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "走廊尽头出现一个影子。", "en": "A shape at the end of the hall."},
        {"zh": "紫布在暗处发亮。", "en": "The purple gleams in the dark."},
        {"zh": "我的耳朵先探出来。", "en": "My ears come out first."},
        {"zh": "木板响了一下。", "en": "The floorboard creaked."},
        {"zh": "我从后台出来。", "en": "I come out from backstage."},
        {"zh": "身上挂着一根弹簧。", "en": "A spring hangs off me."},
        {"zh": "谁把灯关了。", "en": "Who turned off the light."},
        {"zh": "这一层楼归我走。", "en": "This floor is mine to walk."},
        {"zh": "我听见有人。", "en": "I hear someone."},
        {"zh": "帽子有点大。", "en": "The hat is a little big."},
        {"zh": "我站到了门边。", "en": "I take my place by the door."},
        {"zh": "你没有锁门。", "en": "You didn't lock the door."},
        {"zh": "今晚我醒着。", "en": "Tonight I'm awake."},
        {"zh": "紫衣上又破了一个洞。", "en": "Another hole in my purple suit."},
        {"zh": "我慢慢地走过来。", "en": "I come over slowly."},
        {"zh": "别看我的脸。", "en": "Don't look at my face."},
        {"zh": "你还在这里吗。", "en": "Are you still here?"},
        {"zh": "我要开始了。", "en": "I'm about to begin."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "紫布烧出焦边。", "en": "Flame charred the purple."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔倒时耳朵先着地。", "en": "My ear hit first on the way down."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从耳朵灌进去。", "en": "Water poured into my ear."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "填充物飞了一走廊。", "en": "Stuffing flew down the hall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头卡在铁架里。", "en": "An arrowhead stuck in my frame."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光透过了我的脸。", "en": "That light passed through my face."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就饿着。", "en": "I've been hungry all along."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "铁架把我烧得发亮。", "en": "The current lit up my frame."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "整条走廊都没了。", "en": "The whole hall is gone."}
      ]
    }
  }
}
