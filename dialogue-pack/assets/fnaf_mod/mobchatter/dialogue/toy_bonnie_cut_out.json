{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我没走过路，我只有一块纸板。", "en": "I have never walked; I am board and ink."},
        {"zh": "我的姿势永远是同一个。", "en": "My pose never changes."},
        {"zh": "风把我吹得往前倾了一点。", "en": "Wind leans me forward a little."},
        {"zh": "支架在地上刮了一声。", "en": "My stand scrapes the floor once."},
        {"zh": "我被挪了半格，就不再动。", "en": "I am shifted half a block and stop."},
        {"zh": "我的影子是扁的。", "en": "My shadow is flat."},
        {"zh": "纸上印的脚不落地。", "en": "The feet printed on me never touch ground."},
        {"zh": "我斜着靠在墙边。", "en": "I lean against the wall at an angle."},
        {"zh": "有人把我从台上搬下来。", "en": "Someone lifts me off the stage."},
        {"zh": "我又被立回原来的地方。", "en": "I am set back where I was."},
        {"zh": "我没有方向可去。", "en": "I have no direction to go."},
        {"zh": "我只是换了个角度。", "en": "I have only changed my angle."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，笑容印在纸面上。", "en": "I stand with a smile printed on paper."},
        {"zh": "光线斜过来，我的一半变暗。", "en": "Light slants and half of me darkens."},
        {"zh": "颜料顺着接缝往下淌。", "en": "Paint runs down the seams."},
        {"zh": "它们一直看着同一个方向。", "en": "They always look the same way."},
        {"zh": "我只是墙上的一片纸。", "en": "I'm just a sheet of paper on the wall."},
        {"zh": "没有人来擦。", "en": "No one comes to wipe it."},
        {"zh": "我的边缘翘起来一点。", "en": "One edge of me curls slightly."},
        {"zh": "风扇吹得我轻轻响。", "en": "A fan makes me whisper."},
        {"zh": "这间厅里没有别人。", "en": "There is no one else in this hall."},
        {"zh": "只有音乐还在放。", "en": "Only the music keeps playing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛画着正对你。", "en": "My painted eyes face you exactly."},
        {"zh": "你站在我前面，我没有反应。", "en": "You stand before me; I do not react."},
        {"zh": "我不会转头。", "en": "I cannot turn my head."},
        {"zh": "你看久了会觉得我在动。", "en": "Stare long enough and I seem to move."},
        {"zh": "那只是光。", "en": "It is only the light."},
        {"zh": "我笑得很开。", "en": "My smile is very wide."},
        {"zh": "纸面上没有一点皱。", "en": "There is not a wrinkle on me."},
        {"zh": "你伸手碰了碰。", "en": "You reach out and touch."},
        {"zh": "纸板边缘卷起来一点。", "en": "The cardboard's edge curls a little."},
        {"zh": "然后又静止。", "en": "Then I am still again."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞歪了。", "en": "I am knocked askew."},
        {"zh": "纸面凹进去一块。", "en": "A dent presses into the paper."},
        {"zh": "我的笑皱了一点。", "en": "My smile creases a little."},
        {"zh": "我从台上滑下去。", "en": "I slide off the stage."},
        {"zh": "边角撕开一道。", "en": "A corner tears open."},
        {"zh": "我叫不出来。", "en": "I cannot."},
        {"zh": "我被扶起来了。", "en": "I am set upright."},
        {"zh": "那道裂还在。", "en": "The crack remains."},
        {"zh": "笑容没有变。", "en": "The smile has not changed."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会吃，我是块牌子。", "en": "I cannot eat; I am a sign."},
        {"zh": "食物放在我脚边，我够不到。", "en": "Food sits at my feet; I cannot reach."},
        {"zh": "我的手臂是平面的。", "en": "My arms are flat."},
        {"zh": "你举起来给我看。", "en": "You hold it up to show me."},
        {"zh": "那是画上去的。", "en": "It is painted on."},
        {"zh": "你把它放下。", "en": "You set it down."},
        {"zh": "它在我影子里。", "en": "It lies in my shadow."},
        {"zh": "我连嘴都是印上去的。", "en": "Even my mouth is printed on."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上纸板，它倒了。", "en": "You hit the board and it falls."},
        {"zh": "我倒下去，还是笑着的。", "en": "I fall, still smiling."},
        {"zh": "你把我扶起来。", "en": "You stand me up again."},
        {"zh": "我的边角被压弯了。", "en": "My corner is bent."},
        {"zh": "你拍了拍灰。", "en": "You brush off the dust."},
        {"zh": "我的表面比你的护甲凉。", "en": "My surface is colder than your armor."},
        {"zh": "纸板晃了晃，又立稳了。", "en": "The cardboard sways, then settles."},
        {"zh": "我稳稳立着。", "en": "I stand firm."},
        {"zh": "没有再动。", "en": "And move no more."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是印刷品。", "en": "I am a print."},
        {"zh": "我笑在纸上。", "en": "My smile is on paper."},
        {"zh": "那个笑不会变。", "en": "That smile will not change."},
        {"zh": "我不会反对。", "en": "I will not object."},
        {"zh": "我只会换一个背景。", "en": "I will only change my backdrop."},
        {"zh": "音乐继续。", "en": "The music continues."},
        {"zh": "我还是笑着。", "en": "And I am still smiling."},
        {"zh": "纸板也有心，只是不会跳。", "en": "Cardboard has a heart too, it just doesn't beat."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "有人把我整块拿起来。", "en": "Someone lifts me whole."},
        {"zh": "我比看上去轻。", "en": "I am lighter than I look."},
        {"zh": "我的边角在手里弯了。", "en": "My edge bends in the hand."},
        {"zh": "我被靠在另一面墙上。", "en": "I am leaned on another wall."},
        {"zh": "这里的灯更暗。", "en": "The light here is dimmer."},
        {"zh": "我的笑还是那个笑。", "en": "My smile stays the same."},
        {"zh": "我被翻过来，背面是灰的。", "en": "I am turned over; the back is grey."},
        {"zh": "又翻回去。", "en": "And turned back."},
        {"zh": "我被放下了。", "en": "I am set down."},
        {"zh": "这里也不错。", "en": "This will do as well."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛画着，一直对着前面。", "en": "My painted eyes always face forward."},
        {"zh": "有人走进了我的视野。", "en": "Someone has entered my view."},
        {"zh": "我不会追。", "en": "I do not chase."},
        {"zh": "我只是被看着。", "en": "I am only looked at."},
        {"zh": "你也看着我。", "en": "And you look back."},
        {"zh": "这就够了。", "en": "That is enough."},
        {"zh": "我的笑容不变。", "en": "My smile does not change."},
        {"zh": "走廊的灯灭了一瞬。", "en": "The hallway light dies for a moment."},
        {"zh": "我只是把画的眼睛对准你。", "en": "I only aim my painted eyes at you."},
        {"zh": "我的画眼一直对着门口。", "en": "My painted eyes face the doorway."},
        {"zh": "我是纸板，风一吹就倒。", "en": "I am cardboard. One gust and I fall."},
        {"zh": "我的纸面上有一道裂。", "en": "There is a crack across my face."},
        {"zh": "你还是走过来了。", "en": "And still you walk over."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你一走开，我的眼睛还对着你。", "en": "When you move, my eyes still face you."},
        {"zh": "那是画上去的角度。", "en": "That is the painted angle."},
        {"zh": "你绕到侧面，我的眼没跟。", "en": "You circle; my eyes do not follow."},
        {"zh": "你松了一口气。", "en": "You exhale in relief."},
        {"zh": "然后你回头看。", "en": "Then you look back."},
        {"zh": "我还是刚才的样子。", "en": "I am exactly as before."},
        {"zh": "厅里的灯忽明忽暗。", "en": "The hall lights waver."},
        {"zh": "音乐卡了一下。", "en": "The music stutters."},
        {"zh": "光圈扫过我的脸，停住了。", "en": "The beam crosses my face and stops."},
        {"zh": "我的笑在光里很清楚。", "en": "My smile is very clear in the light."},
        {"zh": "纸边翘着。", "en": "A paper edge curls."},
        {"zh": "风从门口进来。", "en": "Wind enters from the doorway."},
        {"zh": "我被吹得轻响。", "en": "I whisper in it."},
        {"zh": "你退到门边。", "en": "You back to the door."},
        {"zh": "我没有跟。", "en": "I do not follow."},
        {"zh": "我从来不用跟。", "en": "I never need to."},
        {"zh": "你走了。", "en": "You leave."},
        {"zh": "我还笑着。", "en": "I am still smiling."},
        {"zh": "你站得够久了，我数着。", "en": "You've stood long enough. I'm counting."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手臂是纸的，碰不到你。", "en": "My arms are paper; they cannot reach."},
        {"zh": "你撞在我身上，纸角划了你的手。", "en": "You bump me and my corner cuts your hand."},
        {"zh": "我没有打你。", "en": "I did not strike you."},
        {"zh": "是支架倒了。", "en": "The stand fell over."},
        {"zh": "你被压了一下。", "en": "It lands on you."},
        {"zh": "我从台上滑下来。", "en": "I slide off the stage."},
        {"zh": "边角擦过你的脸。", "en": "An edge grazes your face."},
        {"zh": "很薄的一道口子。", "en": "A very thin cut."},
        {"zh": "我躺在地上。", "en": "I lie on the floor."},
        {"zh": "还是笑着。", "en": "Still smiling."},
        {"zh": "你的膝盖碰到支架。", "en": "Your knee hits the stand."},
        {"zh": "你踢开我，我倒向一边。", "en": "You kick me; I topple to one side."},
        {"zh": "纸边割破你的手指。", "en": "My edge slices your finger."},
        {"zh": "我压在你的脚上。", "en": "I lie across your foot."},
        {"zh": "你把我扔到墙角。", "en": "You throw me into the corner."},
        {"zh": "我撞上墙，掉了下来。", "en": "I hit the wall and drop."},
        {"zh": "笑还是那个笑。", "en": "The smile is the same smile."},
        {"zh": "我留在地上。", "en": "I stay on the floor."},
        {"zh": "等有人再把我立起来。", "en": "Until someone stands me up again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "厅里的灯先亮了一排。", "en": "A row of lights comes on first."},
        {"zh": "然后我出现在台上。", "en": "Then I appear on the stage."},
        {"zh": "我是被摆上去的。", "en": "I was placed here."},
        {"zh": "我的笑容对着门口。", "en": "My smile faces the doorway."},
        {"zh": "地板上有我扁扁的影子。", "en": "My flat shadow lies on the floor."},
        {"zh": "音乐从墙里传出来。", "en": "Music seeps from the walls."},
        {"zh": "没有人来。", "en": "No one comes."},
        {"zh": "我从墙边立起来。", "en": "I stand up from the wall's edge."},
        {"zh": "等到有人推门。", "en": "Until someone pushes the door."},
        {"zh": "门开了。", "en": "The door opens."},
        {"zh": "我笑着。", "en": "I am smiling."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火从下沿烧上来，纸边卷了。", "en": "Fire climbs my lower edge; the paper curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从台上摔下去，纸角折了。", "en": "I fall off the stage and my corner folds."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浸透纸面，颜色化开。", "en": "Water soaks the print and the colours run."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我撕成两半。", "en": "The blast tears me in two."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西在我身上穿了个洞。", "en": "It punches a hole through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让印刷的颜色变黑。", "en": "Magic blackens the printed colours."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "纸板不会饿，只会褪色。", "en": "Cardboard doesn't starve; it fades."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把纸面烧出一圈焦痕。", "en": "Lightning chars a ring into my face."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有光，我笑不出来。", "en": "In the void there is no light to show my smile."}
      ]
    }
  }
}
