{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我被推着挪了一点，轮子没有。", "en": "I am shoved a little; I have no wheels."},
        {"zh": "盒子的一角在地板上蹭。", "en": "One corner of the box scrapes the floor."},
        {"zh": "我不会自己走。", "en": "I cannot walk by myself."},
        {"zh": "有人搬我，我才会换地方。", "en": "I move only when someone carries me."},
        {"zh": "我的盖子跟着晃。", "en": "My lid rocks along."},
        {"zh": "地板上的划痕是我留下的。", "en": "The floor's scuff marks are mine."},
        {"zh": "我停在展柜边上。", "en": "I stop beside the display case."},
        {"zh": "又被推回去半尺。", "en": "Then am pushed back half a foot."},
        {"zh": "盒身里的东西在响。", "en": "Something rattles inside me."},
        {"zh": "我晃了一下，盖子合上。", "en": "I rock; the lid shuts."},
        {"zh": "灯光扫过我的表面。", "en": "A light sweeps my surface."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在角落里，盖着半开的盖。", "en": "I squat in a corner, lid half open."},
        {"zh": "里面的东西一动不动。", "en": "What is inside does not move."},
        {"zh": "塑料的边角有一点裂。", "en": "One plastic corner is cracked."},
        {"zh": "我看不到外面。", "en": "I cannot see outside."},
        {"zh": "但我听得见脚步。", "en": "But I hear footsteps."},
        {"zh": "有人从我面前过去。", "en": "Someone passes in front of me."},
        {"zh": "盒身轻轻震了一下。", "en": "My body trembles faintly."},
        {"zh": "然后又不震了。", "en": "Then is still."},
        {"zh": "灰落进缝里。", "en": "Dust falls into the seams."},
        {"zh": "我没有盖紧。", "en": "I am not closed tight."},
        {"zh": "一有风就会响。", "en": "Any wind makes me rattle."},
        {"zh": "我在等很久。", "en": "I am used to long waits."},
        {"zh": "久到我已经习惯。", "en": "Long enough that I am used to it."},
        {"zh": "盖子边有一颗小螺丝，松了很久。", "en": "A small screw on the lid has been loose a long while."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你能看见我的时候，我也知道。", "en": "When you can see me, I know it."},
        {"zh": "盖缝里有一条黑。", "en": "A sliver of black shows in my lid's gap."},
        {"zh": "你把脸凑近了。", "en": "You bring your face close."},
        {"zh": "你推了推我的盖。", "en": "You nudge my lid."},
        {"zh": "它没有开。", "en": "It does not open."},
        {"zh": "你退后了一点。", "en": "You step back."},
        {"zh": "灯照在我的塑料面上。", "en": "Light falls on my plastic."},
        {"zh": "反光很好看。", "en": "The shine is nice."},
        {"zh": "你不该在这里停。", "en": "You should not linger here."},
        {"zh": "我只是一只玩具箱。", "en": "I am only a toy box."},
        {"zh": "真的。", "en": "Truly."},
        {"zh": "你说你不是来玩的。", "en": "You say you did not come to play."},
        {"zh": "那你站那么近做什么。", "en": "Then why stand so close?"},
        {"zh": "我把盖抬高了一点。", "en": "I lift my lid a little."},
        {"zh": "你能看见里面的黑。", "en": "You can see the black inside."},
        {"zh": "我又放下去。", "en": "I lower it again."},
        {"zh": "我很久没被人看过。", "en": "No one has looked at me in a long time."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "咯的一声，我的角裂了。", "en": "With a crack, my corner splits."},
        {"zh": "我歪向一边。", "en": "I tilt to one side."},
        {"zh": "盖被震开。", "en": "The lid is knocked open."},
        {"zh": "里面的东西缩回去。", "en": "What is inside shrinks back."},
        {"zh": "我又合上了。", "en": "I close it again."},
        {"zh": "我的表面凹了一块。", "en": "A dent appears on my surface."},
        {"zh": "我没有叫，我叫不出来。", "en": "I do not cry out; I cannot."},
        {"zh": "我在地上转了半圈。", "en": "I spin half a turn on the floor."},
        {"zh": "划痕更深了。", "en": "The scuff deepens."},
        {"zh": "我还开着一条缝。", "en": "I am still open a crack."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你把东西递到盖缝前。", "en": "You hold something to my lid's gap."},
        {"zh": "我装不下。", "en": "I cannot take it."},
        {"zh": "塞进来一点就卡住了。", "en": "It jams at the edge."},
        {"zh": "你抽回去。", "en": "You pull it back."},
        {"zh": "盒子里本来就有东西。", "en": "There is already something inside."},
        {"zh": "不止一样。", "en": "More than one thing."},
        {"zh": "我把盖合紧。", "en": "I close my lid tight."},
        {"zh": "你听不见里面。", "en": "You cannot hear what is inside."},
        {"zh": "我也不想让你听见。", "en": "I do not want you to."},
        {"zh": "箱子开着，你却走开了。", "en": "The box is open, and you walked away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踢到我，盖子响了一声。", "en": "You kick me; my lid clacks."},
        {"zh": "我晃了两圈才停。", "en": "I wobble twice and stop."},
        {"zh": "你的脚撞在角上。", "en": "Your foot strikes my corner."},
        {"zh": "有点疼吧。", "en": "That must hurt."},
        {"zh": "盖子被震开了条缝。", "en": "The impact opens my lid a crack."},
        {"zh": "我又把它合上。", "en": "I shut it again."},
        {"zh": "你蹲下来看。", "en": "You crouch to look."},
        {"zh": "什么也没有。", "en": "There is nothing."},
        {"zh": "我慢慢地不动了。", "en": "I slowly go still."},
        {"zh": "你也站了起来。", "en": "You rise, too."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是容器。", "en": "I am a container."},
        {"zh": "容器不需要这些。", "en": "A container has no need of that."},
        {"zh": "我只是装东西。", "en": "I only hold things."},
        {"zh": "装久了就装出了味道。", "en": "Hold them long enough and a smell comes."},
        {"zh": "你自己闻闻。", "en": "Smell for yourself."},
        {"zh": "算了，别闻。", "en": "Never mind. Do not."},
        {"zh": "盖子合得更紧了。", "en": "My lid closes tighter."},
        {"zh": "你也感觉到了。", "en": "You feel it too."},
        {"zh": "盒子里没有回应，只有响动。", "en": "No answer from the box, only a rattle."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我抱起来。", "en": "You lift me up."},
        {"zh": "比你以为的重。", "en": "I am heavier than you thought."},
        {"zh": "里面的东西撞在壁上。", "en": "What is inside knocks the walls."},
        {"zh": "你差点脱手。", "en": "You nearly drop me."},
        {"zh": "你把我放到另一张台上。", "en": "You set me on another table."},
        {"zh": "这里有灰。", "en": "There is dust here."},
        {"zh": "你拍了拍。", "en": "You pat me."},
        {"zh": "盖差点翻开。", "en": "The lid nearly flips open."},
        {"zh": "你按住了。", "en": "You hold it down."},
        {"zh": "谢谢。", "en": "Thank you."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我前面，没有走。", "en": "You stand before me and do not leave."},
        {"zh": "这个姿势很危险。", "en": "That is a dangerous posture."},
        {"zh": "盒子盖着，里面的东西醒着。", "en": "The box is shut; what's inside is awake."},
        {"zh": "盒子也不会动。", "en": "A box does not move either."},
        {"zh": "但你听见了那一声。", "en": "But you heard that sound."},
        {"zh": "从里面传出来的。", "en": "It came from inside."},
        {"zh": "你把耳朵凑近。", "en": "You put your ear near."},
        {"zh": "声音停了。", "en": "The sound stops."},
        {"zh": "你等了一会，又听见。", "en": "You wait, and hear it again."},
        {"zh": "这次更近。", "en": "Closer this time."},
        {"zh": "你把头抬起来。", "en": "You lift your head."},
        {"zh": "我就在你面前。", "en": "I am right in front of you."},
        {"zh": "盖还是半开的。", "en": "The lid is still half open."},
        {"zh": "你伸手了。", "en": "You reach out."},
        {"zh": "别。", "en": "Do not."},
        {"zh": "太晚了。", "en": "Too late."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "盒子跟着你挪了一点。", "en": "The box shifts a little after you."},
        {"zh": "你没有推它。", "en": "You did not push it."},
        {"zh": "地板上的划痕变长了。", "en": "The scuff on the floor grows longer."},
        {"zh": "你退到门口。", "en": "You retreat to the door."},
        {"zh": "灯光把你的影子投过来。", "en": "The light throws your shadow at me."},
        {"zh": "我的盖在动。", "en": "My lid is moving."},
        {"zh": "一下，一下。", "en": "Once. Once more."},
        {"zh": "像有人在里面顶。", "en": "As if something pushes from within."},
        {"zh": "你数着它。", "en": "You count the beats."},
        {"zh": "数到第七下停了。", "en": "At the seventh it stops."},
        {"zh": "你不敢再数。", "en": "You dare not count further."},
        {"zh": "空气里有塑料和灰的味。", "en": "The air smells of plastic and dust."},
        {"zh": "我的盖开了一条。", "en": "A gap opens in my lid."},
        {"zh": "它一直没合上。", "en": "It never closes."},
        {"zh": "你跑了。", "en": "You run."},
        {"zh": "划痕跟着你的方向。", "en": "The scuff marks follow your direction."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "盒角撞在你的脚踝。", "en": "My corner strikes your ankle."},
        {"zh": "我的盖子突然翻开。", "en": "My lid flips open suddenly."},
        {"zh": "里面的东西扑出来。", "en": "Something lunges out."},
        {"zh": "你被撞倒在地上。", "en": "You are knocked to the floor."},
        {"zh": "盒子压在你的胸口。", "en": "The box presses your chest."},
        {"zh": "你推不动。", "en": "You cannot shove it off."},
        {"zh": "你的手指扣住缝。", "en": "Your fingers catch the seam."},
        {"zh": "它合上了。", "en": "It closes."},
        {"zh": "你抽回来，指尖见了血。", "en": "You pull out; your fingertip bleeds."},
        {"zh": "盒子滚到一边。", "en": "The box rolls aside."},
        {"zh": "又不动了。", "en": "And is still."},
        {"zh": "我的边角顶进你的小腿。", "en": "My edge digs into your calf."},
        {"zh": "咔一声，合上了。", "en": "It clicks shut."},
        {"zh": "你用力甩开。", "en": "You wrench your hand free."},
        {"zh": "盒子撞在墙上。", "en": "The box hits the wall."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "走廊尽头的灯亮了一下。", "en": "A light kindles at the end of the corridor."},
        {"zh": "我就在那张台子上。", "en": "I am on that table."},
        {"zh": "没有人搬我过来。", "en": "No one carried me here."},
        {"zh": "我的盖是关着的。", "en": "My lid is shut."},
        {"zh": "台面有我的圆印。", "en": "My ring mark sits on the surface."},
        {"zh": "灰尘在动。", "en": "The dust is moving."},
        {"zh": "我震了一下。", "en": "I tremble once."},
        {"zh": "又安静。", "en": "Then quiet."},
        {"zh": "有脚步声靠近。", "en": "Footsteps approach."},
        {"zh": "灯光照到我的角上。", "en": "Light reaches my corner."},
        {"zh": "你停在了门口。", "en": "You stop at the doorway."},
        {"zh": "我把盖开了一点。", "en": "I open my lid a little."},
        {"zh": "进来看看。", "en": "Come and look inside."},
        {"zh": "我来的时候没有人注意。", "en": "No one noticed when I arrived."},
        {"zh": "现在注意到了。", "en": "Now someone has."},
        {"zh": "我把盖往开的方向挪。", "en": "I push my lid toward open."},
        {"zh": "一点。", "en": "Just a little."},
        {"zh": "够你看清了。", "en": "Enough for you to see."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "塑料化了，边角滴下来。", "en": "The plastic melts; my corner drips."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从台上掉下去，盖弹开了。", "en": "I fall off the table; my lid springs open."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进盒子里，里面的东西浮起来。", "en": "Water floods me and the contents float."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被炸开，盖子飞了。", "en": "I burst apart; the lid flies off."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西打进我的盒壁。", "en": "It punches through my wall."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让塑料表面起了纹。", "en": "Magic raises veins on my plastic."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，也不动。", "en": "I don't eat, and I don't move."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把我烧出一股焦味。", "en": "Lightning leaves a burnt stench in me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在黑暗里，盒子就是我的全部。", "en": "In the dark, the box is all there is."}
      ]
    }
  }
}
