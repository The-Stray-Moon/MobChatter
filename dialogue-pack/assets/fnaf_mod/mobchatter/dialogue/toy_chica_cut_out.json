{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我被立在门边，脚是印的。", "en": "I am stood by the door; my feet are printed."},
        {"zh": "纸板后面有一根细支杆。", "en": "A thin prop holds me from behind."},
        {"zh": "有人碰了一下，我就转了半圈。", "en": "A touch spins me half about."},
        {"zh": "转完就不动了。", "en": "Then I stop."},
        {"zh": "我的围兜印得很清楚。", "en": "My bib is printed very clearly."},
        {"zh": "它永远是歪的。", "en": "It is always crooked."},
        {"zh": "我斜靠着墙走不了路。", "en": "Leaning on the wall, I cannot walk."},
        {"zh": "风把我的一角掀起。", "en": "Wind lifts one corner of me."},
        {"zh": "拍回去又翘起来。", "en": "It drops back, then curls again."},
        {"zh": "地板上的影子随我摇晃。", "en": "My shadow sways on the floor."},
        {"zh": "我被搬到了另一间。", "en": "I am carried to another room."},
        {"zh": "还是同样的角度。", "en": "Still the same angle."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，喙印成黄色。", "en": "I stand with a yellow-printed beak."},
        {"zh": "灯照在我脸上。", "en": "Light falls on my face."},
        {"zh": "纸面有点发黄了。", "en": "The paper has yellowed a little."},
        {"zh": "边角卷了起来。", "en": "A corner has curled."},
        {"zh": "我没有去管。", "en": "I do not fix it."},
        {"zh": "身后的支杆很细。", "en": "The prop behind me is thin."},
        {"zh": "但我立得稳。", "en": "Yet I stand firm."},
        {"zh": "有只虫从脚下爬过。", "en": "A bug crawls past my feet."},
        {"zh": "我看不见它。", "en": "I cannot see it."},
        {"zh": "我的脸只在正面。", "en": "My face exists only on the front."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛印得很圆。", "en": "My eyes are printed perfectly round."},
        {"zh": "你站在我的正前方。", "en": "You stand directly in front of me."},
        {"zh": "这个角度最好。", "en": "This is the best angle."},
        {"zh": "你往旁边挪了一步。", "en": "You step to the side."},
        {"zh": "我的眼神没有跟着。", "en": "My gaze does not follow."},
        {"zh": "你笑了笑。", "en": "You smile."},
        {"zh": "我也在笑，一直笑着。", "en": "I am smiling too, always smiling."},
        {"zh": "你伸手翻开我的一角。", "en": "You lift one of my corners."},
        {"zh": "背面写着一行字。", "en": "There is a line of writing on the back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的纸面被戳了一个洞。", "en": "A hole is punched through me."},
        {"zh": "我倒下来，又被人立起。", "en": "I fall and am stood up again."},
        {"zh": "颜色被蹭掉一块。", "en": "A patch of colour is rubbed away."},
        {"zh": "我歪了。", "en": "I am crooked."},
        {"zh": "笑还在。", "en": "The smile remains."},
        {"zh": "我叫不出来的。", "en": "I cannot cry out."},
        {"zh": "支杆响了一下。", "en": "The prop creaks."},
        {"zh": "纸面起了皱。", "en": "The paper wrinkles."},
        {"zh": "我还是对着你笑。", "en": "I am still smiling at you."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你把食物举起来。", "en": "You hold food up."},
        {"zh": "我闻不到。", "en": "I cannot smell it."},
        {"zh": "我的鼻子是画的。", "en": "My nose is drawn on."},
        {"zh": "你把东西塞到我手边。", "en": "You tuck it against my hand."},
        {"zh": "它掉在地上。", "en": "It drops to the floor."},
        {"zh": "我没有接。", "en": "I did not catch it."},
        {"zh": "我的手指是平的。", "en": "My fingers are flat."},
        {"zh": "你捡起来了。", "en": "You pick it up."},
        {"zh": "纸板做的手，拿不了东西。", "en": "Cardboard hands can't hold anything."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，我倒下。", "en": "You hit me and I fall."},
        {"zh": "纸面拍在地板上。", "en": "The paper slaps the floor."},
        {"zh": "支杆歪了。", "en": "The prop is bent."},
        {"zh": "我斜着立了一会。", "en": "I lean for a while."},
        {"zh": "然后彻底倒下。", "en": "Then fall flat."},
        {"zh": "我的影子扁在地上。", "en": "My shadow lies flat."},
        {"zh": "我还在笑。", "en": "I am still smiling."},
        {"zh": "一直都在笑。", "en": "Have always been smiling."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是纸板。", "en": "I am cardboard."},
        {"zh": "我只有正面。", "en": "I have only a front."},
        {"zh": "背后什么都没有。", "en": "There is nothing behind."},
        {"zh": "这事该去问别人。", "en": "Ask someone else."},
        {"zh": "我连动都不能动。", "en": "I cannot even move."},
        {"zh": "只有风能翻动我。", "en": "Only wind can turn me."},
        {"zh": "风过去了。", "en": "The wind passes."},
        {"zh": "我还是刚才的角度。", "en": "I keep the same angle."},
        {"zh": "灯还在照。", "en": "The light keeps falling."},
        {"zh": "我继续笑着。", "en": "I keep smiling."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我整块抱起来。", "en": "You lift me whole."},
        {"zh": "我比纸沉一点。", "en": "I am a little heavier than paper."},
        {"zh": "支杆夹在你的手臂下。", "en": "The prop catches under your arm."},
        {"zh": "你把我放到另一张墙上。", "en": "You set me against another wall."},
        {"zh": "那里的光更亮。", "en": "The light is brighter there."},
        {"zh": "我的颜色看起来更黄。", "en": "My colours look more yellow."},
        {"zh": "你退后看了一会。", "en": "You step back and look."},
        {"zh": "这个角度也还行。", "en": "This angle will do."},
        {"zh": "我留在墙上。", "en": "I stay on the wall."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "门口有人。", "en": "Someone is at the door."},
        {"zh": "我的眼睛正好对着门口。", "en": "My eyes happen to face the door."},
        {"zh": "你进来了。", "en": "You come in."},
        {"zh": "你看见了我。", "en": "You see me."},
        {"zh": "你愣了一下。", "en": "You hesitate."},
        {"zh": "这很正常。", "en": "That is normal."},
        {"zh": "很多人第一次都会。", "en": "Most people do at first."},
        {"zh": "我又不会动。", "en": "I cannot move, after all."},
        {"zh": "你走近了。", "en": "You come closer."},
        {"zh": "我的笑在你脸前展开。", "en": "My smile spreads in front of your face."},
        {"zh": "纸面反着光。", "en": "The paper catches the light."},
        {"zh": "碰到的是纸。", "en": "Your fingers meet paper."},
        {"zh": "只有纸。", "en": "Only paper."},
        {"zh": "你还是退了。", "en": "And still you step back."},
        {"zh": "这次退得很快。", "en": "Quickly this time."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你走到侧面去。", "en": "You move to the side."},
        {"zh": "我还在看你。", "en": "I am still looking at you."},
        {"zh": "不，是那个方向。", "en": "No. At that direction."},
        {"zh": "你绕回来，我又在看你。", "en": "You come round; I am looking at you again."},
        {"zh": "你开始怀疑。", "en": "You begin to doubt."},
        {"zh": "我是不是真的只是纸。", "en": "Whether I am really only paper."},
        {"zh": "你伸手拍我的脸。", "en": "You slap my face."},
        {"zh": "纸面凹了一块。", "en": "The paper dents."},
        {"zh": "它慢慢弹回来。", "en": "It slowly springs back."},
        {"zh": "灯忽明忽暗。", "en": "The light wavers."},
        {"zh": "我的笑在闪。", "en": "My smile flickers."},
        {"zh": "我是纸板，风一吹就歪。", "en": "I'm cardboard — one gust and I tilt."},
        {"zh": "你转身跑了。", "en": "You turn and run."},
        {"zh": "我的眼睛对着你跑的方向。", "en": "My eyes face the way you ran."},
        {"zh": "那只是我印的角度。", "en": "That is only my printed angle."},
        {"zh": "你信吗。", "en": "Do you believe it?"},
        {"zh": "你看我一眼，又走回来。", "en": "You glance at me, then come back."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的纸角划破你的手背。", "en": "My paper edge cuts the back of your hand."},
        {"zh": "你撞上支杆，它断了。", "en": "You hit the prop and it snaps."},
        {"zh": "我整块倒在你身上。", "en": "I fall flat onto you."},
        {"zh": "纸面很轻，但吓人。", "en": "The paper is light, but it frightens."},
        {"zh": "你把我撕开一半。", "en": "You tear me in half."},
        {"zh": "你愣在那里。", "en": "You freeze there."},
        {"zh": "我把另一半压下去。", "en": "The other half presses down."},
        {"zh": "你的手被纸边勒住。", "en": "A paper edge binds your hand."},
        {"zh": "很薄，也很利。", "en": "Thin, and very sharp."},
        {"zh": "我的支杆扫到你的膝盖。", "en": "My prop sweeps your knee."},
        {"zh": "它在地板上转了一圈。", "en": "It spins once on the floor."},
        {"zh": "你踩住它。", "en": "You pin it underfoot."},
        {"zh": "纸面还在挣扎一样地响。", "en": "The paper rustles as if struggling."},
        {"zh": "只是风。", "en": "It is only wind."},
        {"zh": "我的手印在你腿上。", "en": "My printed hand marks your leg."},
        {"zh": "你把它抹开。", "en": "You wipe it off."},
        {"zh": "我又倒回墙角。", "en": "I fall back into the corner."},
        {"zh": "这一回没有人来立。", "en": "This time no one stands me up."},
        {"zh": "我脸朝下。", "en": "My face is down."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "有人把我钉在墙上。", "en": "Someone pins me to the wall."},
        {"zh": "钉子穿过后面的支杆。", "en": "The nail goes through the prop."},
        {"zh": "我正对着走廊。", "en": "I face the corridor."},
        {"zh": "灯照着我。", "en": "The light is on me."},
        {"zh": "墙皮掉了一点。", "en": "A little paint flakes off."},
        {"zh": "灰尘落在我头顶。", "en": "Dust settles on my head."},
        {"zh": "有脚步声。", "en": "Footsteps."},
        {"zh": "我在笑。", "en": "I am smiling."},
        {"zh": "一直是这样。", "en": "It has always been so."},
        {"zh": "你停在门口。", "en": "You stop in the doorway."},
        {"zh": "我也在看你。", "en": "And I am looking at you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火从下沿烧起来，笑被吞掉一半。", "en": "Fire climbs from below and eats half my smile."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从墙上掉下来，边角折了。", "en": "I fall off the wall and fold at the corner."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把纸泡软，颜色流下来。", "en": "Water softens the paper and the colours run."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撕成几片，落在不同的地方。", "en": "I am torn into pieces that land apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿过去，留下一个圆孔。", "en": "It passes through, leaving a round hole."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让印刷的线条扭了。", "en": "Magic warps the printed lines."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "纸板不会饿。", "en": "Cardboard does not hunger."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把我烧成一圈黑边。", "en": "Lightning leaves me a black rim."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗里没有人看我笑。", "en": "In the dark, no one sees me smile."}
      ]
    }
  }
}
