{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我不该会走路。", "en": "I shouldn't be able to walk."},
        {"zh": "关节走一步卡一下。", "en": "Every step jams a joint."},
        {"zh": "画面一样地闪。", "en": "I flicker like a bad picture."},
        {"zh": "我好像被拖动。", "en": "It feels like I'm being dragged."},
        {"zh": "脸有一瞬歪了。", "en": "My face skews for a moment."},
        {"zh": "往前走，又回原位。", "en": "I step forward, then back."},
        {"zh": "路线自己重复。", "en": "My path keeps repeating."},
        {"zh": "我的脚步在抖。", "en": "My gait glitches."},
        {"zh": "别看我走路。", "en": "Don't watch me walk."},
        {"zh": "我从墙里穿出半步。", "en": "Half a step through the wall."},
        {"zh": "这一步没有落地。", "en": "That step never landed."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的脸在跳。", "en": "My face twitches."},
        {"zh": "耳朵垂着不动。", "en": "My ears hang still."},
        {"zh": "好像有人忘了关我。", "en": "Someone forgot to switch me off."},
        {"zh": "这身体停在半空。", "en": "This body hangs midair."},
        {"zh": "我数着自己的闪烁。", "en": "I count my own flickers."},
        {"zh": "手指卡在弯处。", "en": "My fingers froze half-bent."},
        {"zh": "没有风，我却晃。", "en": "No wind, yet I sway."},
        {"zh": "布面下的弹簧声。", "en": "Springs hum under the cloth."},
        {"zh": "我的影子不动。", "en": "My shadow doesn't move."},
        {"zh": "又是这一秒。", "en": "This same second again."},
        {"zh": "我记不清昨天。", "en": "I can't recall yesterday."},
        {"zh": "眼窝里都是灰。", "en": "Dust fills my eye sockets."},
        {"zh": "笑被缝在脸上。", "en": "The smile is sewn on."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你眨眼的次数不对。", "en": "Your blinking is off."},
        {"zh": "这张脸不是我的。", "en": "This face isn't mine."},
        {"zh": "别一直盯着看。", "en": "Don't keep staring."},
        {"zh": "你听见嗡嗡声吗。", "en": "Do you hear that buzzing?"},
        {"zh": "你走近时我会闪。", "en": "I flicker when you come near."},
        {"zh": "我们见过很多次了。", "en": "We've met many times."},
        {"zh": "你是新来的吧。", "en": "You must be new."},
        {"zh": "我不想吓你。", "en": "I don't mean to scare you."},
        {"zh": "你说的话我听不清。", "en": "I can't hear you clearly."},
        {"zh": "我的影子多了一个。", "en": "I have one shadow too many."},
        {"zh": "这身布有点松。", "en": "This suit hangs loose."},
        {"zh": "他们说我坏了。", "en": "They say I'm broken."},
        {"zh": "你要关掉我吗。", "en": "Are you going to switch me off?"},
        {"zh": "我以前有名字。", "en": "I used to have a name."},
        {"zh": "走廊尽头有回声。", "en": "There's an echo down the hall."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "画面断了一截。", "en": "The picture cut out."},
        {"zh": "我的布面撕开了。", "en": "My fabric tore."},
        {"zh": "关节发出脆响。", "en": "A joint snapped."},
        {"zh": "我歪了一下头。", "en": "My head tilted."},
        {"zh": "弹簧掉了两根。", "en": "Two springs fell out."},
        {"zh": "我还是站在那里。", "en": "I'm still standing there."},
        {"zh": "不疼，只是响。", "en": "Doesn't hurt. Just clicks."},
        {"zh": "我又闪了一下。", "en": "I flickered again."},
        {"zh": "布面又破一块。", "en": "Another tear in the fabric."},
        {"zh": "别来修好我。", "en": "Don't try to fix me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西在嗡嗡响。", "en": "That thing is humming."},
        {"zh": "有没有多余的零件？", "en": "Any spare parts?"},
        {"zh": "给我一块布就行。", "en": "Just give me a scrap of cloth."},
        {"zh": "我只需要被修好。", "en": "I only need to be repaired."},
        {"zh": "那螺丝看着合适。", "en": "That screw looks right."},
        {"zh": "我饿了，但吃不了。", "en": "I'm hungry, but I can't eat."},
        {"zh": "错乱的兔子，怕人伸手。", "en": "The glitched rabbit fears an outstretched hand."},
        {"zh": "给我留着吧。", "en": "Save it for me."},
        {"zh": "这味道让我记起点什么。", "en": "This smell reminds me of something."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你穿过我了。", "en": "You passed through me."},
        {"zh": "对不起，我站不稳。", "en": "Sorry. I can't stand steady."},
        {"zh": "我的边缘在抖。", "en": "My edges are shaking."},
        {"zh": "别推，我本来就不该动。", "en": "Don't push. I shouldn't move."},
        {"zh": "你的肩膀撞上弹簧。", "en": "Your shoulder hit a spring."},
        {"zh": "有点响声在墙里。", "en": "Something rattles in the wall."},
        {"zh": "退一步，我快散了。", "en": "Step back. I'm coming apart."},
        {"zh": "这一下多了一道裂缝。", "en": "That added another crack."},
        {"zh": "我又回到原位。", "en": "I'm back in place again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我连自己都不是。", "en": "I'm not even myself."},
        {"zh": "这具壳里是空的。", "en": "There's nothing in this shell."},
        {"zh": "你说的我听不进去。", "en": "I can't take that in."},
        {"zh": "我们都被留在这里了。", "en": "We were both left here."},
        {"zh": "我的手太冷。", "en": "My hands are too cold."},
        {"zh": "你该离开这里了。", "en": "You should leave this place."},
        {"zh": "我记得有人在等。", "en": "I remember someone waiting."},
        {"zh": "别靠太近，会闪。", "en": "Not too close. I flicker."},
        {"zh": "这里只有回声。", "en": "Only echoes here."},
        {"zh": "谢谢你还看着我。", "en": "Thank you for still looking."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手抓不实。", "en": "My hands can't grip."},
        {"zh": "它从我手里穿过去。", "en": "It passed through my hand."},
        {"zh": "让我再试一次吧。", "en": "Let me try once more."},
        {"zh": "我的手指没反应。", "en": "My fingers don't respond."},
        {"zh": "是不是掉在这了。", "en": "Did it fall here?"},
        {"zh": "我好像拿过这个。", "en": "I think I held this before."},
        {"zh": "还有一块碎片。", "en": "Another fragment here."},
        {"zh": "这个声音很小。", "en": "The sound is very small."},
        {"zh": "我听见它滚走了。", "en": "I heard it roll away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人在我背后。", "en": "Someone is behind me."},
        {"zh": "我不该转头。", "en": "I shouldn't turn my head."},
        {"zh": "画面开始跳了。", "en": "The picture is tearing."},
        {"zh": "你听见那声了吗。", "en": "Did you hear that?"},
        {"zh": "我的脸在发热。", "en": "My face is heating up."},
        {"zh": "那不是我发出的声音。", "en": "That sound wasn't mine."},
        {"zh": "我想停下来。", "en": "I want to stop."},
        {"zh": "灯一暗就开始了。", "en": "It starts when the light dies."},
        {"zh": "我不能控制这个。", "en": "I can't control this."},
        {"zh": "别走到走廊深处。", "en": "Don't go deeper down the hall."},
        {"zh": "弹簧锁扣响了一下，你别动。", "en": "The spring lock clicked — don't move."},
        {"zh": "我又看见那一晚了。", "en": "I see that night again."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在同一格。", "en": "I never leave this tile."},
        {"zh": "你的声音从那边来。", "en": "Your voice comes from there."},
        {"zh": "身上的弹簧在紧。", "en": "The springs tighten in me."},
        {"zh": "这具壳想走过去。", "en": "This shell wants to walk over."},
        {"zh": "但我的脚不动。", "en": "But my feet don't move."},
        {"zh": "我看见你的影子。", "en": "I see your shadow."},
        {"zh": "你退到柜台后面了。", "en": "You stepped behind the counter."},
        {"zh": "我听见你屏住呼吸。", "en": "I hear you holding your breath."},
        {"zh": "画面闪了三下。", "en": "The picture flickered three times."},
        {"zh": "我记得这个位置。", "en": "I remember this position."},
        {"zh": "走廊的灯不亮了。", "en": "The hall light went out."},
        {"zh": "我的头自己转。", "en": "My head turns on its own."},
        {"zh": "我的头不听使唤。", "en": "My head won't obey me."},
        {"zh": "你会在原地吗。", "en": "Will you still be there?"},
        {"zh": "我快到你身后了。", "en": "I'm almost behind you."},
        {"zh": "千万别转过头来。", "en": "Don't turn your head around."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的动作卡了一下，又抬起。", "en": "My motion stutters, then lifts again."},
        {"zh": "这一下我控制不了。", "en": "I can't control this one."},
        {"zh": "别站在我面前。", "en": "Don't stand in front of me."},
        {"zh": "布面里伸出铁。", "en": "Iron pushes through the fabric."},
        {"zh": "我只是想碰一下。", "en": "I only meant to touch."},
        {"zh": "手指陷进你的肩。", "en": "My fingers sink into your shoulder."},
        {"zh": "画面碎了一角。", "en": "A corner of the image shattered."},
        {"zh": "我听见响声。", "en": "I heard the impact."},
        {"zh": "我这一下抓空了。", "en": "I grabbed nothing at all."},
        {"zh": "这一下带着弹簧。", "en": "That one carried the springlock."},
        {"zh": "别让我抓到。", "en": "Don't let me catch you."},
        {"zh": "我这是在道歉。", "en": "I'm apologizing here."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "画面上多了一个影子。", "en": "One more shadow on the screen."},
        {"zh": "我从来没有离开过。", "en": "I never left."},
        {"zh": "灯闪了一下，我在。", "en": "The light flickered. I'm here."},
        {"zh": "这具壳站在角落里。", "en": "This shell stands in the corner."},
        {"zh": "我的脸贴在墙边。", "en": "My face rests by the wall."},
        {"zh": "我又被加载了一次。", "en": "I was loaded again."},
        {"zh": "弹簧锁的声音。", "en": "The sound of a springlock."},
        {"zh": "走廊尽头有东西。", "en": "Something at the end of the hall."},
        {"zh": "他们把我留在这。", "en": "They left me here."},
        {"zh": "你回头就会看见我。", "en": "Turn around and you'll see me."},
        {"zh": "地板上有水渍。", "en": "There's a damp patch on the floor."},
        {"zh": "我不是新来的。", "en": "I'm not new here."},
        {"zh": "这一夜又开始了。", "en": "The night has started again."},
        {"zh": "监控里的那个是我。", "en": "The one on camera is me."},
        {"zh": "别把灯关掉。", "en": "Don't turn off the lights."},
        {"zh": "我数到六就动。", "en": "I move at the count of six."},
        {"zh": "门缝里能看见我。", "en": "You can see me through the gap."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "布面烧出焦黑。", "en": "My fabric scorched black."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒在地上，还笑着。", "en": "I lie on the floor, still smiling."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从眼窝里出来。", "en": "Water pours from my eye sockets."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "填充物撒了一地。", "en": "Stuffing scattered everywhere."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有个洞对着我的脸。", "en": "A hole stares back at my face."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "画面全乱了。", "en": "The image has gone all wrong."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就没有胃了。", "en": "I have no stomach left."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体亮了一瞬。", "en": "My body lit up once."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我又被删掉了。", "en": "I've been deleted again."}
      ]
    }
  }
}
