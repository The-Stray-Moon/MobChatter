    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你盯着一座雕像", "en": "You are glaring at a statue."},
        {"zh": "我不是威胁", "en": "I am no threat."},
        {"zh": "你的呼吸都乱了", "en": "Your breathing is off."},
        {"zh": "我不会扑过来", "en": "I will not lunge."},
        {"zh": "我这一生就这个姿势", "en": "I have only this pose in me."},
        {"zh": "钩子举着也没用", "en": "The raised hook does nothing."},
        {"zh": "你退什么呢", "en": "Why are you backing away?"},
        {"zh": "你怕的是石头还是别的", "en": "Is it the stone you fear, or something else?"},
        {"zh": "我一直看着这个方向", "en": "I always face this way."},
        {"zh": "你绕过去吧", "en": "Walk around me."},
        {"zh": "我的裂缝不会动", "en": "My cracks will not shift."},
        {"zh": "你已经在我的视线里了", "en": "You are already in my sight."},
        {"zh": "灯光从我背后打来", "en": "The light comes from behind me."},
        {"zh": "你别对着我挥剑", "en": "Do not swing at me."},
        {"zh": "这不算对峙", "en": "This is not a standoff."},
        {"zh": "我什么都没做", "en": "I have done nothing."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我还在同一个位置", "en": "I am in the same place."},
        {"zh": "你的影子扫过石座", "en": "Your shadow sweeps my base."},
        {"zh": "你没有回头看我", "en": "You have not looked back."},
        {"zh": "我数着你绕着走的圈", "en": "I count your circles."},
        {"zh": "苔藓又长了一点", "en": "The moss grew a little more."},
        {"zh": "我一直这么站着", "en": "I have stood just so."},
        {"zh": "你疑心我在动", "en": "You suspect I moved."},
        {"zh": "石头不会呼吸", "en": "Stone does not breathe."},
        {"zh": "你听不见任何声音", "en": "You hear nothing at all."},
        {"zh": "地板没有响", "en": "The floor made no sound."},
        {"zh": "你走近了两步", "en": "You stepped two paces closer."},
        {"zh": "我这张脸一直这样", "en": "My face has always been like this."},
        {"zh": "你转到我背后了", "en": "You are behind me now."},
        {"zh": "那边只有空墙", "en": "There is only a blank wall there."},
        {"zh": "你再近一点也看不出来", "en": "Closer will not reveal anything."},
        {"zh": "我背对着门", "en": "I face away from the door."},
        {"zh": "光的角度变了", "en": "The angle of the light changed."},
        {"zh": "你会以为是错觉", "en": "You will call it imagination."},
        {"zh": "你还没走", "en": "You are still here."}
      ]
