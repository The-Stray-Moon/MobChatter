{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我是座雕像", "en": "I am a statue."},
        {"zh": "石头不会走", "en": "Stone does not walk."},
        {"zh": "我只能坐着", "en": "I can only sit."},
        {"zh": "我的底座压着地板", "en": "My base presses on the floor."},
        {"zh": "要挪我得几个人抬", "en": "Moving me takes several people."},
        {"zh": "我身上落了灰", "en": "Dust has settled on me."},
        {"zh": "雨把我打出斑点", "en": "Rain has speckled me."},
        {"zh": "我的钩子是石头做的", "en": "My hook is carved stone."},
        {"zh": "我连手指都不会动", "en": "I cannot even move a finger."},
        {"zh": "阳光在我身上移动", "en": "The sunlight moves across me."},
        {"zh": "我的裂缝里长了苔", "en": "Moss grows in my cracks."},
        {"zh": "我被摆在这里很久", "en": "I have been placed here a long while."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "石头没有动作", "en": "Stone has no motion."},
        {"zh": "我的姿势固定了", "en": "My pose is set."},
        {"zh": "石头的重量很实在", "en": "Stone has real weight."},
        {"zh": "有人在我旁边走过", "en": "Someone walked past me."},
        {"zh": "我不呼吸", "en": "I do not breathe."},
        {"zh": "我的底座有点歪", "en": "My base is a little crooked."},
        {"zh": "这里适合摆雕像", "en": "A good spot for a statue."},
        {"zh": "我脸上没有表情", "en": "My face shows nothing."},
        {"zh": "风从我的空隙穿过", "en": "Wind passes through my gaps."},
        {"zh": "我这样也算有人陪", "en": "Even a statue can have company."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在看雕像", "en": "You are looking at a statue."},
        {"zh": "看出我像什么了吗", "en": "Can you tell what I am?"},
        {"zh": "手别摸我", "en": "Do not touch me."},
        {"zh": "石头凉吧", "en": "Cold stone, is it not?"},
        {"zh": "你的手印会留下", "en": "Your handprint would stay."},
        {"zh": "我雕得还挺像", "en": "I am carved quite well."},
        {"zh": "我不是活的", "en": "I am not alive."},
        {"zh": "你从这边看有阴影", "en": "The shadow is better from this side."},
        {"zh": "你站远了再看", "en": "Step back and look again."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "崩了个小角", "en": "A chip came off."},
        {"zh": "我的裂缝变大", "en": "My crack widened."},
        {"zh": "石粉落了一地", "en": "Stone dust on the floor."},
        {"zh": "敲一下，我身上的漆掉一块。", "en": "One knock and a chip of my paint flakes off."},
        {"zh": "刻痕被削掉了", "en": "Part of the carving was cut away."},
        {"zh": "我底座裂了", "en": "My base cracked."},
        {"zh": "你还是砍我", "en": "You struck a statue."},
        {"zh": "我没办法还手", "en": "I cannot hit back."},
        {"zh": "灰又落了一层", "en": "Another layer of dust."},
        {"zh": "再砍也就是石头", "en": "Cut more and it is still stone."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "石头不吃东西", "en": "Stone does not eat."},
        {"zh": "我没有嘴可以张", "en": "I have no mouth to open."},
        {"zh": "你举着东西也没用", "en": "Holding that up is pointless."},
        {"zh": "放下吧", "en": "Set it down."},
        {"zh": "我连闻都闻不到", "en": "I cannot even smell it."},
        {"zh": "这东西放我脚边吧", "en": "Leave it at my feet."},
        {"zh": "我只要安静", "en": "I only want quiet."},
        {"zh": "它有点挡住我的底", "en": "It is crowding my base."},
        {"zh": "我不会动的", "en": "I will not move."},
        {"zh": "你留着吧，我不需要", "en": "Keep it, I have no use."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到石头了", "en": "You hit stone."},
        {"zh": "我的边角磕到你", "en": "My corner caught you."},
        {"zh": "你踢得脚疼了吧", "en": "Your foot must hurt."},
        {"zh": "底座纹丝不动", "en": "The base does not shift."},
        {"zh": "你蹭掉了一层灰", "en": "You rubbed off some dust."},
        {"zh": "这地方我占了很久", "en": "I have occupied this spot long."},
        {"zh": "你绕过去就好", "en": "Just walk around me."},
        {"zh": "肩膀是雕出来的", "en": "My shoulder is carved."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是石头", "en": "I am stone."},
        {"zh": "两座雕像对着站", "en": "Two statues face to face."},
        {"zh": "谁摆的位置", "en": "Who arranged this?"},
        {"zh": "这样看着有点怪", "en": "This looks a little strange."},
        {"zh": "反正我们都不会动", "en": "We will not move anyway."},
        {"zh": "雕刻的人没想到", "en": "The sculptor did not plan this."},
        {"zh": "别碰倒我们", "en": "Do not knock us over."},
        {"zh": "苔藓会盖住细节", "en": "Moss will cover the details."},
        {"zh": "就站着吧", "en": "We just stand."},
        {"zh": "安静更好", "en": "Quiet is better."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我动不了", "en": "I cannot move."},
        {"zh": "手里是空的", "en": "My hands hold nothing."},
