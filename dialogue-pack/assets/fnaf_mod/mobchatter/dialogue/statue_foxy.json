      "lines": [
        {"zh": "我一动也没动", "en": "I did not move at all."},
        {"zh": "你撞上了我的钩尖", "en": "You ran into my hook's point."},
        {"zh": "石头比刀硬", "en": "Stone is harder than a blade."},
        {"zh": "这一下是你自己撞的", "en": "That one was your own doing."},
        {"zh": "我前倾不了", "en": "I cannot lean forward."},
        {"zh": "你手背流血了", "en": "Your hand is bleeding."},
        {"zh": "我的边缘划了你", "en": "My edge scraped you."},
        {"zh": "你要绕就绕远点", "en": "If you walk around, go wide."},
        {"zh": "我什么也没挥", "en": "I swung nothing."},
        {"zh": "你腿上留了道印", "en": "There is a mark on your leg."},
        {"zh": "这算我动了么", "en": "Did that count as me moving?"},
        {"zh": "别再靠过来", "en": "Do not come closer."},
        {"zh": "石头是冷的", "en": "Stone is cold."},
        {"zh": "我的表情没变", "en": "My expression did not change."},
        {"zh": "你退开就行了", "en": "Just back away."},
