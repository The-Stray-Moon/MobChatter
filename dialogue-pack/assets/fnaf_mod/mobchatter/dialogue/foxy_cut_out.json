{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走不动", "en": "I cannot walk."},
        {"zh": "纸板腿不会弯", "en": "Cardboard legs do not bend."},
        {"zh": "我只能歪一下", "en": "I can only lean."},
        {"zh": "风把我吹得晃", "en": "The wind makes me wobble."},
        {"zh": "我没有脚", "en": "I have no feet."},
        {"zh": "纸板很轻", "en": "Cardboard is light."},
        {"zh": "我被挪动过几次", "en": "I have been moved a few times."},
        {"zh": "地面倾斜我就倒", "en": "A tilted floor and I fall."},
        {"zh": "我的影子比身体厚", "en": "My shadow is thicker than I am."},
        {"zh": "我一动就是别人搬我", "en": "If I move, someone carried me."},
        {"zh": "我的边缘卷起来了", "en": "My edges are curling."},
        {"zh": "纸板折痕越来越深", "en": "The crease in my board deepens."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我是块立牌", "en": "I am a standee."},
        {"zh": "我就站在这儿", "en": "I just stand here."},
        {"zh": "我的笑容是画上去的", "en": "My grin is painted on."},
        {"zh": "灯照着我的正面", "en": "The light hits my front."},
        {"zh": "我背后一片空白", "en": "My back is blank."},
        {"zh": "灰尘落在我肩上", "en": "Dust settles on my shoulder."},
        {"zh": "靠墙能立得久", "en": "Leaning on a wall lasts longer."},
        {"zh": "我属于这间屋子", "en": "I belong to this room."},
        {"zh": "你从侧面看我就薄", "en": "From the side I am thin."},
        {"zh": "我没有脊椎", "en": "I have no spine."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在看我，还是看纸板", "en": "Are you looking at me, or the cardboard?"},
        {"zh": "我这边是正面", "en": "This is my front side."},
        {"zh": "别戳我", "en": "Do not poke me."},
        {"zh": "我一戳就破", "en": "Poke me and I tear."},
        {"zh": "你站远点看更像", "en": "I look better from farther away."},
        {"zh": "我的眼睛是印的", "en": "My eyes are printed."},
        {"zh": "你要把我搬走吗", "en": "Are you going to move me?"},
        {"zh": "我今天不想倒", "en": "I would rather not fall today."},
        {"zh": "你看得挺久", "en": "You have looked a while."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "纸板裂开了", "en": "The cardboard split."},
        {"zh": "我歪向一边", "en": "I am leaning to one side."},
        {"zh": "我的图案被划了", "en": "My print got scratched."},
        {"zh": "角上缺了一块", "en": "A corner is missing."},
        {"zh": "我快倒了", "en": "I am about to fall."},
        {"zh": "纸屑掉了一地", "en": "Paper scraps on the floor."},
        {"zh": "我没法还手", "en": "I cannot hit back."},
        {"zh": "我的支架弯了", "en": "My stand is bent."},
        {"zh": "别捅我的正面", "en": "Do not stab my front."},
        {"zh": "我只是一块板", "en": "I am only a board."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有嘴", "en": "I have no mouth."},
        {"zh": "纸板不吃东西", "en": "Cardboard eats nothing."},
        {"zh": "我连手都抬不起", "en": "I cannot even raise a hand."},
        {"zh": "拿开吧，挡光了", "en": "Move it, it blocks the light."},
        {"zh": "我只会看着", "en": "All I can do is watch."},
        {"zh": "这东西应该放别处", "en": "That belongs somewhere else."},
        {"zh": "我闻到纸的味道", "en": "I smell paper."},
        {"zh": "就这样吧", "en": "Leave it at that."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞倒我了", "en": "You knocked me over."},
        {"zh": "我躺在地上了", "en": "Now I am on the floor."},
        {"zh": "纸板折了角", "en": "A corner of my board bent."},
        {"zh": "你踩到我的脸了", "en": "You stepped on my face."},
        {"zh": "我比看起来脆", "en": "I am more fragile than I look."},
        {"zh": "扶我起来好吗", "en": "Would you stand me up?"},
        {"zh": "我靠回去了一点", "en": "I leaned back into place."},
        {"zh": "风一吹我就倒", "en": "One gust and I go down."},
        {"zh": "我的支架松了", "en": "My stand came loose."},
        {"zh": "别用肩膀顶我", "en": "Do not shoulder into me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是块纸板", "en": "I am a piece of cardboard."},
        {"zh": "两块纸板靠在一起", "en": "Two boards leaning together."},
        {"zh": "这样也能站着", "en": "We can stand like this."},
        {"zh": "别压上来，会塌", "en": "Do not lean on me, we will collapse."},
        {"zh": "我们都不动", "en": "Neither of us moves."},
        {"zh": "这幅画挺搭", "en": "The pictures go together."},
        {"zh": "谁也看不见我们", "en": "No one sees us."},
        {"zh": "靠着墙就好", "en": "Against the wall is enough."},
        {"zh": "纸是可以拼的", "en": "Paper can be pieced together."},
        {"zh": "就这样靠着", "en": "We lean, that is all."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿不起来", "en": "I cannot pick anything up."},
        {"zh": "我的手是印的", "en": "My hands are painted."},
        {"zh": "掉在我脚下的也没用", "en": "Things at my feet are no use to me."},
        {"zh": "等我被人搬走", "en": "Wait until someone moves me."},
        {"zh": "我连转身都难", "en": "I can barely turn."},
        {"zh": "东西滚到我脚边", "en": "Something rolled to my feet."},
        {"zh": "别指望我捡", "en": "Do not count on me to pick it up."},
        {"zh": "我只会看着它", "en": "I can only look at it."},
        {"zh": "它会一直躺在那儿", "en": "It will lie there."},
        {"zh": "帮我捡一下", "en": "Pick it up for me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯上你了，虽然我动不了", "en": "I have my eye on you, though I cannot move."},
        {"zh": "你踩了我一脚", "en": "You stepped on me."},
        {"zh": "我的钩子是画的", "en": "My hook is painted on."},
        {"zh": "我张着嘴也咬不到", "en": "My mouth is open and cannot bite."},
        {"zh": "你以为我要扑过来", "en": "You think I am about to lunge."},
        {"zh": "我就这一副姿势", "en": "This is my only pose."},
        {"zh": "我在你身后，一直看着", "en": "I am behind you, always watching."},
        {"zh": "你走开我也不追", "en": "Walk away, I will not follow."},
        {"zh": "我这样很吓人吧", "en": "I must look frightening like this."},
        {"zh": "我的笑容一直不变", "en": "My grin never changes."},
        {"zh": "灯闪的时候我更明显", "en": "I stand out when the lights flicker."},
        {"zh": "你别回头", "en": "Do not turn around."},
        {"zh": "我离你很近", "en": "I am very close to you."},
        {"zh": "我只能站着", "en": "Standing is all I can do."},
        {"zh": "我只是印在纸板上的钩子。", "en": "I am only a hook printed on cardboard."},
        {"zh": "这一眼，就够了。", "en": "One look is all it takes."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在原地", "en": "I never leave this spot."},
        {"zh": "你走到哪儿我都看着", "en": "I watch wherever you go."},
        {"zh": "我没动，是灯在闪", "en": "I have not moved, the light flickered."},
        {"zh": "你回头也没用", "en": "Turning around will not help."},
        {"zh": "我没有呼吸", "en": "I do not breathe."},
        {"zh": "我的影子不动", "en": "My shadow does not move."},
        {"zh": "你越看越觉得我在动", "en": "The longer you look, the more I seem to move."},
        {"zh": "墙角的我很安静", "en": "In the corner I am very quiet."},
        {"zh": "你绕到我后面了", "en": "You have gone behind me."},
        {"zh": "我这边只能看见墙", "en": "All I can see is the wall."},
        {"zh": "你走一步，我还在原处", "en": "One step from you, I am still here."},
        {"zh": "灯灭的时候我呢", "en": "Where am I when the lights go out?"},
        {"zh": "我不追，但一直都在", "en": "I do not chase, but I am always here."},
        {"zh": "这间屋子的角落里", "en": "In the corner of this room."},
        {"zh": "你听见纸的声音吗", "en": "Do you hear the paper creak?"},
        {"zh": "我把头转向你，其实没有", "en": "I turn my head toward you, or do I?"},
        {"zh": "你别贴着我", "en": "Do not press against me."},
        {"zh": "我一直正对着门", "en": "I always face the door."},
        {"zh": "这张脸不会变", "en": "This face never changes."},
        {"zh": "我站得比你想的久", "en": "I have stood here longer than you think."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我挥不了手", "en": "I cannot swing."},
        {"zh": "我的钩子只是图案", "en": "My hook is only a picture."},
        {"zh": "我张着嘴吓你", "en": "I open my mouth to scare you."},
        {"zh": "我的牙齿是印上去的", "en": "My teeth are printed on."},
        {"zh": "我前倾了一下", "en": "I tipped forward a bit."},
        {"zh": "纸板擦到你了", "en": "The board brushed you."},
        {"zh": "我倒了，撞到你", "en": "I fell, and hit you."},
        {"zh": "纸板边缘刮了你", "en": "The cardboard edge scraped you."},
        {"zh": "我没有真的碰到", "en": "I did not really touch you."},
        {"zh": "你别退那么远", "en": "No need to back away that far."},
        {"zh": "我只是个摆设", "en": "I am only decoration."},
        {"zh": "我的边缘锋利一点", "en": "My edge is a little sharp."},
        {"zh": "风把我推向你", "en": "The wind pushed me at you."},
        {"zh": "你被我吓到了吧", "en": "I startled you, did I not?"},
        {"zh": "我连咬合都做不到", "en": "I cannot even bite down."},
        {"zh": "这算我赢吗", "en": "Does that count as my win?"},
        {"zh": "我摔在你脚边", "en": "I landed at your feet."},
        {"zh": "我一直保持这个笑容", "en": "I keep this grin the whole time."},
        {"zh": "你身上落了纸屑", "en": "There are paper scraps on you."}
      ]
    },
