      "operation": "replace",
      "lines": [
        {"zh": "我被挂在了墙上", "en": "I was hung on the wall."},
        {"zh": "刷怪蛋把我摆出来", "en": "The egg set me up."},
        {"zh": "这里原本有个空位", "en": "There was an empty spot here."},
        {"zh": "我站得不太正", "en": "I am not quite straight."},
        {"zh": "我背后靠着木架", "en": "A wooden frame backs me."},
        {"zh": "灯光照到我脸上", "en": "The light hit my face."},
        {"zh": "这一角正好放我", "en": "This corner suits me."},
        {"zh": "我闻起来像新纸", "en": "I smell like fresh paper."},
        {"zh": "我试着站稳", "en": "I try to stand firm."},
        {"zh": "这屋子我熟", "en": "I know this room."},
        {"zh": "摆放的角度很重要", "en": "The angle matters."},
        {"zh": "我的脚底是平的", "en": "My base is flat."}
      ]
    },
