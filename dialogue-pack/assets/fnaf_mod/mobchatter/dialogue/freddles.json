{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步都动不了。", "en": "I can't take a single step."},
        {"zh": "爪子是缝上去的。", "en": "My claws are sewn on."},
        {"zh": "我在地板上待着。", "en": "I stay on the floorboards."},
        {"zh": "这双腿短得可怜。", "en": "These little legs are pitifully short."},
        {"zh": "你想踢我，我就滚一圈。", "en": "Kick me and I'll roll once."},
        {"zh": "柜子下面是我的位置。", "en": "Under the cabinet is my spot."},
        {"zh": "我背上的毛不会动。", "en": "The fur on my back doesn't move."},
        {"zh": "你走过我身边，带起风。", "en": "You pass by and stir the air."},
        {"zh": "灯光从我头顶扫过去。", "en": "The light sweeps over my head."},
        {"zh": "我就这么歪着。", "en": "I just sit here, tilted."},
        {"zh": "我本来该在床下的。", "en": "I was supposed to be under the bed."},
        {"zh": "这间屋子里，我最矮。", "en": "In this room, I'm the shortest."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我缩着，一动不动。", "en": "I'm huddled, perfectly still."},
        {"zh": "我的眼睛很大。", "en": "My eyes are very big."},
        {"zh": "你会不会觉得我在动？", "en": "Do you think I'm moving?"},
        {"zh": "那是光的问题。", "en": "That's the lighting."},
        {"zh": "我在这儿待了很久。", "en": "I've been here a long while."},
        {"zh": "灰落满了我的头。", "en": "Dust covers my head."},
        {"zh": "我有点旧了。", "en": "I'm a bit worn."},
        {"zh": "一屋子安静。", "en": "The whole room is quiet."},
        {"zh": "我不会打呼。", "en": "I don't snore."},
        {"zh": "我趴在床边，等你闭眼。", "en": "I lie by the bed, waiting for your eyes to close."},
        {"zh": "我什么都听不见。", "en": "I can't hear anything."},
        {"zh": "我的小爪子朝外。", "en": "My little paws point outward."},
        {"zh": "别用脚碰我。", "en": "Don't nudge me with your foot."},
        {"zh": "我连眨眼都做不到。", "en": "I can't even blink."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你低头看我了。", "en": "You've looked down at me."},
        {"zh": "我这么小，你看得清吗？", "en": "I'm this small. Can you see me clearly?"},
        {"zh": "我的牙是画出来的。", "en": "My teeth are painted on."},
        {"zh": "你蹲下来了。", "en": "You crouched down."},
        {"zh": "别用手抓我。", "en": "Don't grab me with your hand."},
        {"zh": "我不会咬人。", "en": "I don't bite."},
        {"zh": "我这张脸挺旧的。", "en": "This face of mine is worn."},
        {"zh": "你笑了，为什么？", "en": "You laughed. Why?"},
        {"zh": "我一点都不好笑。", "en": "I'm not funny at all."},
        {"zh": "我从柜底仰着脸，灰尘很厚。", "en": "I look up from under the cabinet, thick with dust."},
        {"zh": "你挡住灯了。", "en": "You're blocking the light."},
        {"zh": "我只是堆在原地的玩偶。", "en": "Just a pile of dolls, unmoving."},
        {"zh": "我身上有股灰味。", "en": "I smell of dust."},
        {"zh": "你后退了一下。", "en": "You stepped back a little."},
        {"zh": "我连姿势都没换。", "en": "I haven't even changed pose."},
        {"zh": "你的鞋尖离我很近。", "en": "Your boot tip is very close."},
        {"zh": "你的膝盖就在我眼前。", "en": "Your knee is right in front of me."},
        {"zh": "再近就踩到了。", "en": "Any closer and you'll step on me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的毛被扯了。", "en": "My fur got pulled."},
        {"zh": "你把我踢翻了。", "en": "You tipped me over."},
        {"zh": "我滚到墙角。", "en": "I rolled into the corner."},
        {"zh": "布裂开了一道。", "en": "The cloth split open."},
        {"zh": "这点伤，我本来就旧。", "en": "It's just wear. I was old already."},
        {"zh": "我翻过来，又不动了。", "en": "I tipped over and went still again."},
        {"zh": "填充物掉出来了。", "en": "Stuffing is coming out."},
        {"zh": "你鞋尖踢得我翻过去。", "en": "Your boot tip flipped me over."},
        {"zh": "我歪着，看着你。", "en": "I'm tilted, looking at you."},
        {"zh": "我一点都不疼。", "en": "I don't feel pain at all."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你拿什么哄我？", "en": "What are you coaxing me with?"},
        {"zh": "我嘴里是画出来的。", "en": "My mouth is painted on."},
        {"zh": "这堆毛不吃东西。", "en": "This heap of fur doesn't eat."},
        {"zh": "你放地上，也没用。", "en": "Putting it on the floor won't help."},
        {"zh": "我根本闻不到。", "en": "I can't smell it at all."},
        {"zh": "你留着吧，别给我。", "en": "Keep it. Don't give it to me."},
        {"zh": "那东西看着挺软。", "en": "That looks soft."},
        {"zh": "我不是活物。", "en": "I'm not a living thing."},
        {"zh": "你举着它很累吧。", "en": "Your arm must be tired."},
        {"zh": "放下，然后走吧。", "en": "Put it down and go."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踢到我，我滚了。", "en": "You kicked me and I rolled."},
        {"zh": "我撞到墙边。", "en": "I hit the wall."},
        {"zh": "我这么轻，一碰就跑。", "en": "I'm light. One touch and I slide."},
        {"zh": "别用脚尖拨我。", "en": "Don't nudge me with your toe."},
        {"zh": "我的位置变了。", "en": "I've changed position."},
        {"zh": "我脸朝下了。", "en": "My face is down now."},
        {"zh": "灰扬起来一圈。", "en": "A ring of dust rose."},
        {"zh": "你把我踢进了柜子底。", "en": "You kicked me under the cabinet."},
        {"zh": "我卡在缝里。", "en": "I'm stuck in the gap."},
        {"zh": "我又不动了。", "en": "I've gone still again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟谁配对？", "en": "Who would I pair with?"},
        {"zh": "我只是个玩偶。", "en": "I'm only a doll."},
        {"zh": "你别问这种话。", "en": "Don't ask such things."},
        {"zh": "屋子里没有别的。", "en": "There's nothing else in this room."},
        {"zh": "这堆布，不会回应。", "en": "This pile of cloth won't answer."},
        {"zh": "你自言自语。", "en": "You're talking to yourself."},
        {"zh": "我歪着头，看着地。", "en": "I tilt my head and look at the floor."},
        {"zh": "这夜还长着呢。", "en": "The night is still long."},
        {"zh": "你该出去了。", "en": "You should leave."},
        {"zh": "门就在那边。", "en": "The door is right over there."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我什么都拿不动。", "en": "I can't lift anything."},
        {"zh": "我的爪子是软的。", "en": "My paws are soft."},
        {"zh": "你掉的东西滚过来了。", "en": "What you dropped rolled this way."},
        {"zh": "它停在我脚边。", "en": "It stopped by my feet."},
        {"zh": "我看着它，没办法。", "en": "I look at it. Nothing I can do."},
        {"zh": "你最好自己捡。", "en": "You'd better pick it up yourself."},
        {"zh": "它沾上灰了。", "en": "It's covered in dust now."},
        {"zh": "就在那儿别动。", "en": "Just leave it there."},
        {"zh": "我连手指都张不开。", "en": "I can't even open my fingers."},
        {"zh": "我帮不了你的。", "en": "I can't help you."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会盯上谁。", "en": "I don't fix on anyone."},
        {"zh": "我的眼睛画在布上，动不了。", "en": "My eyes are painted on cloth; they can't move."},
        {"zh": "你在那边动。", "en": "You're moving over there."},
        {"zh": "我只能看着地板。", "en": "I can only look at the floor."},
        {"zh": "你没有危险。", "en": "You're in no danger."},
        {"zh": "这一点我能保证。", "en": "That much I can promise."},
        {"zh": "灯管响了一声。", "en": "The light tube clicked."},
        {"zh": "你别跳起来。", "en": "Don't jump."},
        {"zh": "我连爪子都没抬。", "en": "I haven't lifted a paw."},
        {"zh": "这屋子里只有你。", "en": "Only you are in this room."},
        {"zh": "你踩得地板都在响，我听着。", "en": "The floor booms under you; I listen."},
        {"zh": "安静点就好。", "en": "Just be quiet."},
        {"zh": "你是不是在怕我？", "en": "Are you afraid of me?"},
        {"zh": "真的没必要。", "en": "There's really no need."},
        {"zh": "我只是放在这儿。", "en": "I'm just placed here."},
        {"zh": "我不追任何人的。", "en": "I don't chase anyone."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我不追，也动不了。", "en": "I can't chase, or move."},
        {"zh": "你为什么一直看我？", "en": "Why do you keep looking at me?"},
        {"zh": "你绕着我走了三圈。", "en": "You've circled me three times."},
        {"zh": "我一直在原位。", "en": "I've been in place the whole time."},
        {"zh": "你的影子把我盖住。", "en": "Your shadow covers me."},
        {"zh": "我什么也看不见。", "en": "I can't see anything now."},
        {"zh": "灯又亮起来了。", "en": "The light is back on."},
        {"zh": "你还在那儿。", "en": "You're still there."},
        {"zh": "你手电的光晃过去。", "en": "Your torchlight swings past."},
        {"zh": "我眼睛有点反光。", "en": "My eyes reflect a little."},
        {"zh": "那不是活的光。", "en": "It's not living light."},
        {"zh": "我从柜子缝里看你走远。", "en": "I watch you leave through the cabinet gap."},
        {"zh": "我还在柜子底下。", "en": "I'm still under the cabinet."},
        {"zh": "我什么都没变。", "en": "Nothing about me has changed."},
        {"zh": "那声音不是我发出来的。", "en": "That sound didn't come from me."},
        {"zh": "这里只有风。", "en": "It's only the wind here."},
        {"zh": "你回头看了两次。", "en": "You've looked back twice."},
        {"zh": "我两次都在原地。", "en": "Both times I was in the same place."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是站着，不动。", "en": "I just stand here, not moving."},
        {"zh": "我没有攻击的动作。", "en": "I have no attack motion."},
        {"zh": "你打我，我只会翻。", "en": "Hit me, and I only tip over."},
        {"zh": "我翻过来，脸朝上。", "en": "I'm flipped over, face up."},
        {"zh": "我的牙咬不动东西。", "en": "My teeth can't bite anything."},
        {"zh": "你踩我一下，我就扁了。", "en": "Step on me and I'd flatten."},
        {"zh": "我那么小，能做什么？", "en": "I'm so small. What could I do?"},
        {"zh": "我连挥手都不会。", "en": "I can't even wave."},
        {"zh": "你打在棉花上。", "en": "You're hitting cotton."},
        {"zh": "我的爪子抓不住你。", "en": "My paws can't grip you."},
        {"zh": "我只会晃两下。", "en": "All I can do is wobble twice."},
        {"zh": "这一下，我脸朝地了。", "en": "Now my face is in the floor."},
        {"zh": "我太小了，碰不到你。", "en": "I'm too small to reach you."},
        {"zh": "你根本没受伤吧？", "en": "You weren't hurt at all, were you?"},
        {"zh": "我连靠近都做不到。", "en": "I can't even get close."},
        {"zh": "你别太用力。", "en": "Don't use so much force."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我本来就在这儿。", "en": "I was here all along."},
        {"zh": "你没注意到而已。", "en": "You just didn't notice."},
        {"zh": "我从床下被放到这儿。", "en": "I was put here from under the bed."},
        {"zh": "屋子里多了一点灰。", "en": "The room gained a bit of dust."},
        {"zh": "你开灯的时候，我就在。", "en": "I was here when you turned on the light."},
        {"zh": "我没从哪儿来。", "en": "I didn't come from anywhere."},
        {"zh": "是这间屋子本来就有我。", "en": "This room already had me in it."},
        {"zh": "这地板好凉。", "en": "This floor is cold."},
        {"zh": "灯光正好照到我。", "en": "The light falls right on me."},
        {"zh": "我小小的，在角落。", "en": "Small, in the corner."},
        {"zh": "你又看见我了。", "en": "You've seen me again."},
        {"zh": "这次别踢我。", "en": "Don't kick me this time."},
        {"zh": "我歪在柜子边上。", "en": "I'm tilted against the cabinet."},
        {"zh": "上面全是灰。", "en": "There's dust all over me."},
        {"zh": "你站在我面前。", "en": "You're standing in front of me."},
        {"zh": "我什么都做不了。", "en": "There's nothing I can do."},
        {"zh": "你还是看了我一眼。", "en": "You still glanced at me."},
        {"zh": "这样也就够了。", "en": "That's enough."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "布一碰到火就卷起来。", "en": "The cloth curled the moment fire touched it."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从高处掉下来，我滚了好久。", "en": "I fell from a height and rolled a long way."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我泡软了。", "en": "Water soaked me soft."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹到房间那头。", "en": "The blast blew me to the far side of the room."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一针扎进我的肚子。", "en": "A needle went into my belly."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光扫过我，我的颜色变了。", "en": "The light passed and my colors changed."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这堆毛不会饿。", "en": "This heap of fur doesn't get hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声在屋里回响，我抖。", "en": "Thunder echoed in the room. I shook."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "掉下去，就再也找不到了。", "en": "Fall in, and I'd never be found."}
      ]
    }
  }
}
