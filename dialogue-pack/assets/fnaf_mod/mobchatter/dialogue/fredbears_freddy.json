{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的礼帽从来没歪过。", "en": "My top hat has never sat crooked."},
        {"zh": "我该上台，可脚不走。", "en": "I should be on stage, but my feet won't go."},
        {"zh": "我把话筒举在胸前。", "en": "I hold the microphone at my chest."},
        {"zh": "我的领结有点松。", "en": "My bow tie has come a little loose."},
        {"zh": "锃亮的地板映着我。", "en": "The polished floor reflects me."},
        {"zh": "我一步步挪，其实没动。", "en": "I shift step by step, yet don't move."},
        {"zh": "我的毛毡上落了一层灰。", "en": "Dust lies on my felt fur."},
        {"zh": "我朝着舞台中央偏。", "en": "I lean toward center stage."},
        {"zh": "灯光在我脚边切开一块亮。", "en": "The light cuts a bright square at my feet."},
        {"zh": "我拖着一只笨重的脚。", "en": "I drag one heavy foot."},
        {"zh": "麦克风的线缠住了我。", "en": "The mic cable has tangled me."},
        {"zh": "我保持着登台的姿势。", "en": "I hold my entrance pose."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我张着嘴，像在唱歌。", "en": "My mouth hangs open as if singing."},
        {"zh": "我在等孩子们进来。", "en": "I wait for the children to come in."},
        {"zh": "我的眼睛一闪一闪。", "en": "My eyes flicker on and off."},
        {"zh": "话筒里只有电流声。", "en": "Only static from the microphone."},
        {"zh": "我的礼帽边缘磨白了。", "en": "The brim of my hat has gone pale."},
        {"zh": "我数着店里剩下的椅子。", "en": "I count the chairs left in the diner."},
        {"zh": "夜里的餐厅太安静。", "en": "The diner is too quiet at night."},
        {"zh": "我听见冰箱在响。", "en": "I hear the fridge humming."},
        {"zh": "我的掌心是硬塑料。", "en": "My palms are hard plastic."},
        {"zh": "我站得很直，像在敬礼。", "en": "I stand straight as if saluting."},
        {"zh": "有只飞蛾撞在灯上。", "en": "A moth taps the lamp."},
        {"zh": "我等着音乐开始。", "en": "I wait for the music to start."},
        {"zh": "我的耳朵有点歪。", "en": "One of my ears sits slightly off."},
        {"zh": "这里曾有很多笑声。", "en": "There used to be so much laughter."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "欢迎光临，客人。", "en": "Welcome, guest."},
        {"zh": "你站在我的舞台前。", "en": "You stand before my stage."},
        {"zh": "我的眼睛一直看着你。", "en": "My eyes have been on you all along."},
        {"zh": "你要听一首歌吗？", "en": "Would you like a song?"},
        {"zh": "你的手电太亮了。", "en": "Your torch is too bright."},
        {"zh": "我记得你穿的这身。", "en": "I remember that uniform."},
        {"zh": "别把帽子碰下来。", "en": "Don't knock my hat off."},
        {"zh": "你看起来没睡好。", "en": "You look like you haven't slept."},
        {"zh": "这个时间不该有客人。", "en": "There shouldn't be guests at this hour."},
        {"zh": "我的笑容是缝上去的。", "en": "My smile is stitched on."},
        {"zh": "我这一身绒毛，摸起来很旧。", "en": "My fuzz feels very old."},
        {"zh": "我在听你说话。", "en": "I'm listening to you."},
        {"zh": "你的影子盖住了我的脚。", "en": "Your shadow covers my feet."},
        {"zh": "皮带在响，是我。", "en": "The belts are creaking, that's me."},
        {"zh": "你往哪走我都看得见。", "en": "Whichever way you go, I see it."},
        {"zh": "别怕，我只是站着。", "en": "Don't fear, I'm only standing."},
        {"zh": "今晚的观众只有你。", "en": "Tonight's audience is only you."},
        {"zh": "我低头看你，礼帽挡住光。", "en": "I look down at you, my top hat shading the light."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的毛毡裂开了。", "en": "My felt has split."},
        {"zh": "礼帽被撞歪了。", "en": "My hat got knocked askew."},
        {"zh": "我没有痛，只有响。", "en": "I feel no pain, only noise."},
        {"zh": "我的领结掉了一半。", "en": "Half my bow tie has fallen."},
        {"zh": "里面全是线。", "en": "It's all wires inside."},
        {"zh": "我的笑容歪了。", "en": "My smile is crooked now."},
        {"zh": "这身衣服又破了。", "en": "These clothes are torn again."},
        {"zh": "我还立得起来。", "en": "I can still stay upright."},
        {"zh": "你弄坏了店里的财产。", "en": "You damaged the diner's property."},
        {"zh": "等天亮有人来修。", "en": "At dawn someone will repair me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我吃不了，孩子。", "en": "I can't eat, child."},
        {"zh": "话筒比食物重要。", "en": "The microphone matters more than food."},
        {"zh": "你举得那么高，想给我？", "en": "Held up so high, is it for me?"},
        {"zh": "我的胃里是空的铁盒。", "en": "An empty metal box in my belly."},
        {"zh": "放桌上吧，摆整齐。", "en": "Set it on the table, neatly."},
        {"zh": "我连手指都弯不了。", "en": "I can't even bend my fingers."},
        {"zh": "你留着垫肚子。", "en": "Keep it for your own hunger."},
        {"zh": "这味道，我记不得。", "en": "That smell, I don't recall it."},
        {"zh": "我是摆件，连一步都动不了。", "en": "I'm a prop — I can't take a single step."},
        {"zh": "你的好意我用不上。", "en": "Your kindness is wasted on me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞了我的话筒。", "en": "You knocked my microphone."},
        {"zh": "我的礼帽晃了一下。", "en": "My hat wobbled."},
        {"zh": "别靠在我的台子上。", "en": "Don't lean on my stage."},
        {"zh": "地板震了一下，我没动。", "en": "The floor shook, I didn't."},
        {"zh": "你的肩膀撞在我胸口。", "en": "Your shoulder met my chest."},
        {"zh": "灰尘从我的耳朵里掉出来。", "en": "Dust spills from my ear."},
        {"zh": "你撞掉了我的礼帽，帽檐磕地。", "en": "You knock off my top hat and its brim hits the floor."},
        {"zh": "退开，这身毛毡怕扯。", "en": "Back off, this felt tears easily."},
        {"zh": "你踩到了麦克风的线。", "en": "You stepped on the mic cable."},
        {"zh": "再撞，我会倒下来。", "en": "Another bump and I'd topple."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是舞台上的熊。", "en": "I'm the bear on stage."},
        {"zh": "这种事，节目单里没有。", "en": "That isn't on the program."},
        {"zh": "我的手指是塑料的。", "en": "My fingers are plastic."},
        {"zh": "我只会唱歌和招手。", "en": "I only sing and wave."},
        {"zh": "你还年轻，问点别的。", "en": "You're young, ask something else."},
        {"zh": "我在这里太久了。", "en": "I've been here far too long."},
        {"zh": "我的动作只有几个。", "en": "I have only a few motions."},
        {"zh": "活人该找活人。", "en": "The living should seek the living."},
        {"zh": "这话我不想接。", "en": "I'd rather not answer that."},
        {"zh": "我的礼帽下面，只有绒布。", "en": "Under my top hat there is only felt."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手合不上。", "en": "My hands won't close."},
        {"zh": "掉在台下的，你捡吧。", "en": "What fell off stage, you pick it up."},
        {"zh": "我看得见，臂伸不过去。", "en": "I see it, my arm can't reach."},
        {"zh": "放我脚边，我踩着。", "en": "Put it by my foot, I'll stand on it."},
        {"zh": "这店里的东西都有主。", "en": "Everything in this diner has an owner."},
        {"zh": "那枚硬币在椅子下面。", "en": "That coin is under the chair."},
        {"zh": "我的头低不下去。", "en": "I can't lower my head."},
        {"zh": "以前有人会收这些。", "en": "Someone used to collect these."},
        {"zh": "摆件不需要东西，你拿。", "en": "A display piece needs nothing — take it."},
        {"zh": "明天会有人来扫。", "en": "Someone will sweep tomorrow."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的歌还没唱完。", "en": "My song isn't finished."},
        {"zh": "你站在台下。", "en": "You're standing below the stage."},
        {"zh": "我的眼睛一直在你身上。", "en": "My eyes never left you."},
        {"zh": "门锁了，别试了。", "en": "The door's locked, don't bother."},
        {"zh": "这个时间只有节目。", "en": "At this hour, only the show."},
        {"zh": "你听得见音乐吗？", "en": "Can you hear the music?"},
        {"zh": "我再抬不起手，但看着你。", "en": "I can't raise my hand, but I watch you."},
        {"zh": "你走到了舞台边上。", "en": "You've come to the stage edge."},
        {"zh": "我们的距离在缩短。", "en": "The distance between us is closing."},
        {"zh": "不是我靠近，是你。", "en": "Not me approaching, it's you."},
        {"zh": "你的手电快没电了。", "en": "Your torch is dimming."},
        {"zh": "这店里就剩你一个。", "en": "Only you remain in the diner."},
        {"zh": "还有我。", "en": "And me."},
        {"zh": "你的呼吸声我听见了。", "en": "I hear your breathing."},
        {"zh": "往后退，看台上。", "en": "Step back, watch the stage."},
        {"zh": "表演还没开始。", "en": "The performance hasn't begun."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼灯不闪了。", "en": "My eye lights have stopped flickering."},
        {"zh": "这旋律你认得吧。", "en": "You know this melody, don't you?"},
        {"zh": "我的头只能转一点。", "en": "My head turns only a little."},
        {"zh": "你走到哪个角落我都数着。", "en": "I count the corners you reach."},
        {"zh": "麦克风里有杂音。", "en": "Static crackles in the microphone."},
        {"zh": "你的手电照到了我的牙。", "en": "Your light found my teeth."},
        {"zh": "这不是演出的一部分。", "en": "This isn't part of the show."},
        {"zh": "灯一闪，我又近了一点。", "en": "The light flickers, I'm a little nearer."},
        {"zh": "地板在响，不是我在走。", "en": "The floor creaks, though I don't walk."},
        {"zh": "你退到了门口。", "en": "You've backed to the door."},
        {"zh": "可门在另一边。", "en": "But the door is elsewhere."},
        {"zh": "你听见了吧。", "en": "You heard that, didn't you?"},
        {"zh": "我们都很安静。", "en": "We're both very quiet."},
        {"zh": "只有电流在响。", "en": "Only current hums."},
        {"zh": "我等着你动。", "en": "I wait for you to move."},
        {"zh": "一动就是现在。", "en": "Moving is now."},
        {"zh": "别闭眼。", "en": "Don't close your eyes."},
        {"zh": "六点还差很久。", "en": "Six is still far away."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把话筒砸了下去。", "en": "I bring the microphone down."},
        {"zh": "你被我一把推开。", "en": "I shove you back."},
        {"zh": "我的手掌很沉。", "en": "My palm is heavy."},
        {"zh": "这一下落在你肩上。", "en": "That one landed on your shoulder."},
        {"zh": "你退到台边了。", "en": "You're at the stage edge."},
        {"zh": "我没有出第二下。", "en": "I didn't follow up."},
        {"zh": "我的关节响得像鼓。", "en": "My joints clack like a drum."},
        {"zh": "你的血溅在地板上。", "en": "Your blood spots the floor."},
        {"zh": "这演出不太好看了。", "en": "The show is getting ugly."},
        {"zh": "站稳，别摔。", "en": "Steady, don't fall."},
        {"zh": "话筒砸下去，线缠住你。", "en": "The microphone comes down and its cord tangles you."},
        {"zh": "我的毛毡被扯下来一块。", "en": "A patch of felt tore off me."},
        {"zh": "灯又闪了。", "en": "The light flickered again."},
        {"zh": "这一下是我的全部。", "en": "That was all I had."},
        {"zh": "你最好现在离开。", "en": "You'd best leave now."},
        {"zh": "观众散场了。", "en": "The audience has left."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "幕布升起，我已在台上。", "en": "The curtain rises, I'm already on stage."},
        {"zh": "有人把我搬到灯下。", "en": "Someone set me under the light."},
        {"zh": "我的礼帽先亮起来。", "en": "My top hat catches the light first."},
        {"zh": "今天的舞台只有我一个。", "en": "The stage is mine alone today."},
        {"zh": "我的脚步声很闷。", "en": "My footsteps land muffled."},
        {"zh": "台下的椅子都空着。", "en": "Every seat below is empty."},
        {"zh": "灯一亮，我的领结正对着台下。", "en": "The lights rise and my bow tie faces the seats."},
        {"zh": "扬声器响了一声。", "en": "The speaker pops once."},
        {"zh": "灰尘在光柱里飘。", "en": "Dust drifts in the light beam."},
        {"zh": "我站到了标志的位置。", "en": "I take the marked spot."},
        {"zh": "这个姿势我熟。", "en": "I know this pose well."},
        {"zh": "我又回到了这里。", "en": "I've returned here again."},
        {"zh": "台下的地板上还有旧印。", "en": "Old marks remain on the floor below."},
        {"zh": "门被谁推动了。", "en": "Someone pushed the door."},
        {"zh": "客人来了。", "en": "A guest has come."},
        {"zh": "让我先理理领结。", "en": "Let me straighten my bow tie."},
        {"zh": "灯全亮了。", "en": "All the lights are on."},
        {"zh": "幕布后，我先清了清嗓子。", "en": "Behind the curtain, I clear my throat first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛毡一烧就冒黑烟。", "en": "The felt burns and smokes black."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒下，帽子滚出去了。", "en": "I fall, my hat rolls away."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进壳里，声音都闷了。", "en": "Water fills my shell, everything muffles."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的舞台掀了。", "en": "The blast rips my stage apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西扎进了我的礼帽。", "en": "That lodged in my top hat."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的电路乱跳，动作也乱了。", "en": "My circuits jump, my motions stutter."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有电，我什么也做不了。", "en": "Without power I can do nothing."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下，我的灯全亮了。", "en": "Lightning strikes, every light of mine flares."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里，舞台也没了。", "en": "In the void, even the stage is gone."}
      ]
    }
  }
}
