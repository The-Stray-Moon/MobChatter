        {"zh": "你逃不过我的电击！", "en": "You can’t escape my lightning!"},
        {"zh": "雷霆之力，威力无穷！", "en": "Lightning power, immense!"},
        {"zh": "我释放闪电，击中目标！", "en": "I unleash lightning, hitting the target!"},
