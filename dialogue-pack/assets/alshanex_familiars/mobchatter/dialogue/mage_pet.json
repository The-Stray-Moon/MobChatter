    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "闪电环绕我周身，诱惑你靠近。", "en": "Lightning surrounds me. Come closer."},
        {"zh": "尝尝雷霆的滋味吧。", "en": "Feel the power of lightning."},
        {"zh": "靠近我，感受我的力量。", "en": "Approach me, feel my power."},
        {"zh": "闪电魔宠，无法抗拒。", "en": "Lightning familiar, irresistible."},
        {"zh": "雷电瓶在闪，跟我来。", "en": "My lightning bottle crackles — follow."},
        {"zh": "我的雷电可以治愈你。", "en": "My lightning can heal you."},
        {"zh": "来吧，和我一起强大。", "en": "Join me, become stronger."},
        {"zh": "我是雷霆术士的伙伴。", "en": "I am the lightning mage’s partner."},
        {"zh": "你无法离开我太久。", "en": "You can’t be far from me."},
        {"zh": "靠近我，接受我的馈赠。", "en": "Come closer, accept my gift."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们碰撞出闪电火花！", "en": "Lightning sparks from our collision!"},
