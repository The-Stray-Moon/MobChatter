    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "电光闪烁，我受了伤。", "en": "Flickering lightning, I'm hurt."},
        {"zh": "电击缠绕，我受伤了。", "en": "Electricity wraps around me."},
        {"zh": "雷电交加，我受伤了。", "en": "Lightning strikes, I'm hurt."},
