  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "电闪雷鸣中跳跃前行", "en": "Jumping forward amidst lightning and thunder"},
        {"zh": "闪电围绕我舞动", "en": "Lightning swirls around me"},
        {"zh": "快速跃过崎岖山地", "en": "Leaping over rugged terrain quickly"},
        {"zh": "追踪主人的身影", "en": "Chasing after the master's shadow"},
        {"zh": "与雷电一同奔跑", "en": "Running with lightning"},
        {"zh": "闪避岩块和风化石", "en": "Dodging rocks and eroded stones"},
        {"zh": "冲向远处的光点", "en": "Racing towards distant lights"},
        {"zh": "雷电噼啪作响，我疾行", "en": "Popping lightning, I run fast"},
        {"zh": "避开洞穴和岩层", "en": "Avoiding caves and rock layers"},
        {"zh": "雷鸣声中急行军", "en": "Marching at a quick pace in thunder"},
        {"zh": "踩着岩脊往下跑", "en": "It runs down the ridge line"},
        {"zh": "电尾划出一道蓝痕", "en": "Its electric tail draws a blue streak"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静站立，充满力量", "en": "Standing still, brimming with power"},
        {"zh": "等待指令，守护周遭", "en": "Waiting for orders, guarding the surroundings"},
        {"zh": "闪电环绕，我屹立不动", "en": "Lightning swirling, I stand still"},
        {"zh": "耐心等待，随时准备", "en": "Patiently waiting, always ready"},
        {"zh": "闭眼冥想，雷电充能", "en": "Closing eyes, charging with lightning"},
        {"zh": "目光深邃，雷电闪烁", "en": "Deep eyes, lightning flickering"},
        {"zh": "静待主人召唤", "en": "Waiting for the master's call"},
        {"zh": "等待时机，蓄力待发", "en": "Waiting for the moment, ready to strike"},
        {"zh": "保持专注，雷电缭绕", "en": "Maintaining focus, lightning surrounding"},
        {"zh": "静静地站立，雷电环绕", "en": "Standing quietly, lightning encircling"},
        {"zh": "它在雪线上等主人", "en": "It waits for its owner above the snowline"},
        {"zh": "尾巴尖端噼啪漏电", "en": "Sparks leak from the tip of its tail"},
        {"zh": "它把头埋进绒毛里充电", "en": "It tucks its head into its fur to recharge"},
        {"zh": "雷云下它显得很自在", "en": "It looks at ease under a thunderhead"},
        {"zh": "它跟着苦力怕转了半圈", "en": "It circles a creeper half a turn"},
        {"zh": "它数着远处山头的闪电", "en": "It counts the lightning on distant peaks"}
      ]
    },
