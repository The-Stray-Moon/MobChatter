{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩在泥里，一步一陷。", "en": "I step in mud and sink a little."},
        {"zh": "身上挂着水草。", "en": "Weeds hang off me."},
        {"zh": "我走的这条路很软。", "en": "This path is soft underfoot."},
        {"zh": "床木的根绊了我一下。", "en": "A mangrove root caught me."},
        {"zh": "我一边走一边滴水。", "en": "Water drips off me as I walk."},
        {"zh": "我不怕水，我住在水边。", "en": "Water doesn't bother me. I live by it."},
        {"zh": "我慢慢从芦苇里出来。", "en": "I come slowly out of the reeds."},
        {"zh": "我踩着水草根，慢慢过去。", "en": "I step on the roots of the water weeds and move on."},
        {"zh": "沼泽把路藏起来了。", "en": "The swamp hides the path."},
        {"zh": "我朝那片浅水走。", "en": "I head for the shallows."},
        {"zh": "裤腿上全是淤泥。", "en": "My legs are caked with silt."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在浅水里。", "en": "I stand in the shallows."},
        {"zh": "水草缠着我的腿。", "en": "Weeds wrap around my legs."},
        {"zh": "泥里在冒泡。", "en": "Bubbles rise from the mud."},
        {"zh": "我身上有股烂泥味。", "en": "I smell of rotting mud."},
        {"zh": "我不动，像根枯木。", "en": "Holding still, I look like dead wood."},
        {"zh": "我听见虫子在叫。", "en": "I hear the insects calling."},
        {"zh": "太阳在这里很闷。", "en": "The sun is heavy here."},
        {"zh": "有水蛭爬在我身上。", "en": "Leeches cling to me."},
        {"zh": "沼泽的泥裹住了我。", "en": "Swamp mud has wrapped me up."},
        {"zh": "水面照出我的样子。", "en": "The water shows my shape."},
        {"zh": "我在这里泡了很久。", "en": "I've soaked here a long while."},
        {"zh": "脚下的泥很暖。", "en": "The mud under me is warm."},
        {"zh": "我在等有人踩进水里。", "en": "I wait for someone to step in."},
        {"zh": "我抬手赶走一只虫。", "en": "I brush off an insect."},
        {"zh": "这里的气味很重。", "en": "The smell here is heavy."},
        {"zh": "我吐出一口沼泽气。", "en": "I breathe out swamp air."},
        {"zh": "水纹一圈圈散开。", "en": "Ripples spread in rings."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩进我的水了。", "en": "You've stepped into my water."},
        {"zh": "你的靴子会进泥。", "en": "Your boots will fill with mud."},
        {"zh": "这里的水不好喝。", "en": "The water here isn't drinkable."},
        {"zh": "你看起来不常来沼泽。", "en": "You don't come to the swamp often."},
        {"zh": "我的手上全是泥。", "en": "My hands are all mud."},
        {"zh": "你退后也没用，路是软的。", "en": "Backing up won't help. The path is soft."},
        {"zh": "你身上干净得太显眼。", "en": "You're too clean to blend in."},
        {"zh": "我这张脸泡了很久。", "en": "This face soaked a long time."},
        {"zh": "你听到水声了吗？", "en": "Heard that water sound?"},
        {"zh": "我身上的东西会咬人。", "en": "What's on me bites."},
        {"zh": "你想摸我？别摸。", "en": "Touch me? Don't."},
        {"zh": "这片水只有一条浅路。", "en": "There's one shallow way through."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了一块泥。", "en": "A clump of mud fell off."},
        {"zh": "这一下打进水里。", "en": "That landed in the water."},
        {"zh": "我身上的水草断了。", "en": "The weeds on me broke."},
        {"zh": "半张脸掉进水里，我又捞回来。", "en": "Half my face drops into the water; I fish it back."},
        {"zh": "泥把我的伤糊住了。", "en": "The mud covers the wound."},
        {"zh": "我本来就半烂了。", "en": "I was half rotted anyway."},
        {"zh": "你的武器上都是泥。", "en": "Your weapon is muddy now."},
        {"zh": "我退了一点，水浑了。", "en": "I stepped back and the water clouded."},
        {"zh": "泥水从伤口灌进去，不疼。", "en": "Muddy water seeps into the wound; it does not hurt."},
        {"zh": "我还没沉下去。", "en": "I haven't gone under yet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "食物？我吃不下了。", "en": "Food? I can't keep it down."},
        {"zh": "你举着东西，我闻着不对。", "en": "You hold it up. Something's off."},
        {"zh": "我不饿，我泡着就行。", "en": "Not hungry. I'll just soak."},
        {"zh": "把它放岸边。", "en": "Leave it on the bank."},
        {"zh": "泥里有很多东西。", "en": "There's plenty in the mud."},
        {"zh": "你那块面包，泡软了也不香。", "en": "That bread of yours is not tempting, even soaked."},
        {"zh": "你把它拿走，会坏的。", "en": "Take it away or it'll spoil."},
        {"zh": "我嘴里都是泥味。", "en": "My mouth tastes only mud."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞上我，一身泥。", "en": "Bump me and you're muddy."},
        {"zh": "你踩进了我站的水里。", "en": "You stepped into the water I'm in."},
        {"zh": "别挤，脚下是软的。", "en": "Don't crowd. The ground's soft."},
        {"zh": "我们两个都陷下去一点。", "en": "We both sank a little."},
        {"zh": "你退开时带起一片泥。", "en": "Backing off kicked up mud."},
        {"zh": "我的衣服湿透了。", "en": "My clothes are soaked through."},
        {"zh": "你的手上有水草。", "en": "There's weed on your hand."},
        {"zh": "沼泽的泥会记住你的脚步。", "en": "The swamp mud remembers every step you take."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我泡得太久了。", "en": "I've soaked too long."},
        {"zh": "两个我，泥都要翻起来。", "en": "Two of us would churn the mud."},
        {"zh": "水会浑得看不见。", "en": "The water would turn opaque."},
        {"zh": "别站在岸上看。", "en": "Don't watch from the bank."},
        {"zh": "我们身上都是水草。", "en": "We're both covered in weeds."},
        {"zh": "它比我泡得更久。", "en": "It's soaked longer than me."},
        {"zh": "泥浆溅到芦苇上了。", "en": "Mud splashed on the reeds."},
        {"zh": "分开后水面才平。", "en": "Afterwards the water settles."},
        {"zh": "这不叫繁殖，叫扎根。", "en": "Not breeding. Rooting."},
        {"zh": "我们连声音都没有。", "en": "Neither of us made a sound."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我从泥里挖出一块。", "en": "I dig something out of the mud."},
        {"zh": "这东西泡得发软。", "en": "This has soaked soft."},
        {"zh": "我捡起来，全是泥。", "en": "I picked it up. All mud."},
        {"zh": "我把它按进水里洗。", "en": "I dunk it in the water."},
        {"zh": "泥里有骨头。", "en": "There are bones in the mud."},
        {"zh": "我拿着它走，滴着水。", "en": "I carry it, dripping."},
        {"zh": "这块我收着。", "en": "I'll keep this."},
        {"zh": "我手指缝里全是沙。", "en": "There's sand between my fingers."},
        {"zh": "这水草我拔出来了。", "en": "I pulled this weed out."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进浅水了。", "en": "You've walked into the shallows."},
        {"zh": "这地方你没我熟。", "en": "You don't know this place like I do."},
        {"zh": "泥会拖住你的脚。", "en": "The mud will drag at your feet."},
        {"zh": "你退到深水就麻烦了。", "en": "Back into the deep water and you're in trouble."},
        {"zh": "我看得见你踩出的泡。", "en": "I can see the bubbles you raise."},
        {"zh": "我身上有毒，你知道吧。", "en": "There's poison on me. You know that."},
        {"zh": "水草会缠住你。", "en": "The weeds will catch you."},
        {"zh": "泥在往下陷，你走不快了。", "en": "The mud is sinking; you can't move fast now."},
        {"zh": "我慢慢来，不着急。", "en": "I come slowly. No hurry."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我泡在水里等你。", "en": "I soak in the water and wait."},
        {"zh": "你在我左前面的芦苇里。", "en": "You're in the reeds ahead and left."},
        {"zh": "泥把你脚印留下了。", "en": "The mud keeps your prints."},
        {"zh": "我不追，我等着。", "en": "I don't chase. I wait."},
        {"zh": "你在水里走不快。", "en": "You can't move fast in water."},
        {"zh": "水草一动我就知道。", "en": "When the weeds move, I know."},
        {"zh": "这里的雾帮了我。", "en": "The fog here helps me."},
        {"zh": "你绕路要多走很久。", "en": "Going around takes you far."},
        {"zh": "水面上的泡是你的。", "en": "Those bubbles on the surface are yours."},
        {"zh": "我一直没出声。", "en": "I've made no sound."},
        {"zh": "你身后那根枯木是我。", "en": "That dead log behind you is me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手，泥一起糊上去。", "en": "I reach out, mud and all."},
        {"zh": "这一下带着水草。", "en": "This one comes with weeds."},
        {"zh": "你身上开始发麻了。", "en": "The numbness is starting."},
        {"zh": "我的手很凉。", "en": "My hands are cold."},
        {"zh": "沼气一涌，力气就上来了。", "en": "Marsh gas surges and my strength returns."},
        {"zh": "你退的时候陷了一下。", "en": "You sank when you stepped back."},
        {"zh": "泥水溅了你一脸。", "en": "Muddy water splashed your face."},
        {"zh": "我的指甲里有泥。", "en": "There's mud under my nails."},
        {"zh": "你吸进去的那点会难受。", "en": "What you breathed in will hurt."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从泥底下浮上来。", "en": "I surface from under the mud."},
        {"zh": "水面起了泡。", "en": "Bubbles came up."},
        {"zh": "岸边多了一个影子。", "en": "A shape appeared on the bank."},
        {"zh": "我一直泡在那边。", "en": "I've been soaking over there."},
        {"zh": "我站起来，泥往下掉。", "en": "I stood and the mud ran off."},
        {"zh": "芦苇响了一下。", "en": "The reeds rustled once."},
        {"zh": "这地方本来就是我的。", "en": "This place was always mine."},
        {"zh": "我的鞋里全是水。", "en": "My boots are full of water."},
        {"zh": "有人踩到岸边了。", "en": "Someone stepped onto the bank."},
        {"zh": "我从红树林那边来。", "en": "I came from the mangroves."},
        {"zh": "沼泽今天很安静。", "en": "The swamp is quiet today."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我身上的沼气点着了。", "en": "Fire lit the gas on me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔进泥里，半天没起来。", "en": "I fell in the mud and stayed down."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我自己就泡在水里，还是在沉。", "en": "I live in water, and I'm still sinking."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "泥和水一起溅起来。", "en": "Mud and water flew up together."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进我肩膀，泥堵住了。", "en": "An arrow in my shoulder; mud plugged it."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光让泥都干了。", "en": "That light dried the mud on me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，也没饿过。", "en": "I don't eat, and I've never been hungry."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有泥可以抓。", "en": "There's no mud to grip in the void."}
      ]
    }
  }
}
