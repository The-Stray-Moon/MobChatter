{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上的光很淡。", "en": "My glow is faint."},
        {"zh": "我跟着那条光的线。", "en": "I follow that thread of light."},
        {"zh": "我穿过墙，没有声音。", "en": "I pass through walls without sound."},
        {"zh": "骨头是半透明的。", "en": "These bones are half-transparent."},
        {"zh": "我朝着深处去。", "en": "I head deeper."},
        {"zh": "主人叫我，我就走。", "en": "My master calls, so I go."},
        {"zh": "我不留脚印。", "en": "I leave no prints."},
        {"zh": "我一边走一边散开。", "en": "I scatter a little as I move."},
        {"zh": "我的光在暗处更亮。", "en": "My light is brighter in the dark."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光一闪一闪。", "en": "My glow flickers."},
        {"zh": "我身上的光很冷。", "en": "The light on me is cold."},
        {"zh": "我看得见很远的地方。", "en": "I can see a long way."},
        {"zh": "我不用呼吸也能在。", "en": "I can exist without breathing."},
        {"zh": "我的轮廓有点虚。", "en": "My outline is blurred."},
        {"zh": "石头照出我的光。", "en": "The stone carries my reflection."},
        {"zh": "我不困，也不需要。", "en": "I don't sleep, or need to."},
        {"zh": "半透明的骨头，也在等你转身。", "en": "Even these translucent bones wait for you to turn."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看得见我，很好。", "en": "You can see me. Good."},
        {"zh": "我是被叫出来的。", "en": "I was called out."},
        {"zh": "我的主人在附近。", "en": "My master is nearby."},
        {"zh": "我这半透明的样子，吓到你了？", "en": "Does this half-seen shape frighten you?"},
        {"zh": "你打得中我吗？", "en": "Can you land a hit on me?"},
        {"zh": "我只是一小块骨头。", "en": "I'm only a small bone."},
        {"zh": "我还要回去。", "en": "I have to go back."},
        {"zh": "你看我就像看一团雾。", "en": "I must look like fog to you."},
        {"zh": "我的光不会伤你。", "en": "My light won't hurt you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光散了点。", "en": "Some of my light scattered."},
        {"zh": "这一下穿过我一半。", "en": "That went halfway through me."},
        {"zh": "我淡了一些。", "en": "I've grown fainter."},
        {"zh": "你的武器碰到的是冷的。", "en": "Your weapon touched cold."},
        {"zh": "我一晃，形有点散。", "en": "I wavered and blurred."},
        {"zh": "我不太结实。", "en": "I'm not very solid."},
        {"zh": "骨头又碎了一根。", "en": "Another bone cracked."},
        {"zh": "我回到原处重新聚。", "en": "I re-form in place."},
        {"zh": "这点伤要不了我。", "en": "That won't finish me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举着的东西很结实。", "en": "That thing you hold looks solid."},
        {"zh": "我的手碰不到它。", "en": "My hand can't quite touch it."},
        {"zh": "你手里的东西穿过了我。", "en": "What is in your hand passes right through me."},
        {"zh": "我不站在地上，你递不过来。", "en": "I'm not on the ground. You can't hand it up."},
        {"zh": "你都留着吧，我不缺。", "en": "Keep it all. I lack nothing."},
        {"zh": "它在我的光里有点暗。", "en": "It looks dim in my glow."},
        {"zh": "放地上，也许我能拿。", "en": "Put it down. Maybe I can take it."},
        {"zh": "你不用给我。", "en": "You needn't offer me anything."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到的是一团冷。", "en": "You hit a pocket of cold."},
        {"zh": "你的手穿过我一半。", "en": "Your hand went halfway through."},
        {"zh": "别靠，会发凉。", "en": "Stay back. It's cold."},
        {"zh": "我退开了，可没走远。", "en": "I drifted off, not far."},
        {"zh": "我们两个都轻。", "en": "We're both weightless."},
        {"zh": "你碰不到实的。", "en": "You can't catch hold of anything solid."},
        {"zh": "你打个寒战，那就是我。", "en": "If you shiver, that was me."},
        {"zh": "你的护甲碰不到我。", "en": "Your armor can't reach me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "深渊行者把我从地底叫起来。", "en": "The abyss walker called me up."},
        {"zh": "主人造我们的时候没这个。", "en": "Our master didn't build this in."},
        {"zh": "我们互相穿过。", "en": "We pass through each other."},
        {"zh": "光叠在一起亮一些。", "en": "Overlapped, the light gets brighter."},
        {"zh": "它比我还淡。", "en": "It's fainter than I am."},
        {"zh": "分开后各自回去。", "en": "Afterwards each returns."},
        {"zh": "我们的骨头碰不到。", "en": "Our bones can't meet."},
        {"zh": "之后什么都不多。", "en": "Nothing is added afterwards."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿不起重的东西。", "en": "I can't lift heavy things."},
        {"zh": "箭我捡不了。", "en": "I can't pick up an arrow."},
        {"zh": "我碰了一下，它就滚了。", "en": "One touch and it rolled."},
        {"zh": "地上的东西我不该动。", "en": "I shouldn't touch what's on the ground."},
        {"zh": "主人让我拿，我就能拿。", "en": "If my master wills it, I can."},
        {"zh": "我举不起来。", "en": "I can't lift it."},
        {"zh": "我帮不了你搬东西。", "en": "I can't help you carry things."},
        {"zh": "这块石头穿过我的手。", "en": "This stone passes through my hand."},
        {"zh": "我试着抓，抓不住。", "en": "I tried to grip it. Nothing."},
        {"zh": "你得自己捡。", "en": "You'll have to pick it up yourself."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那个在动的东西是你。", "en": "The thing that moved is you."},
        {"zh": "主人指了方向。", "en": "My master pointed the way."},
        {"zh": "你的呼吸，我感觉得到。", "en": "I can feel your breathing."},
        {"zh": "我朝你飘过来。", "en": "I drift toward you."},
        {"zh": "你的呼吸暴露了自己。", "en": "Your breathing gives you away."},
        {"zh": "这间屋子只有你一个。", "en": "There's only you in this room."},
        {"zh": "我不用跑也能追上。", "en": "I don't need to run to catch you."},
        {"zh": "你退到墙那边，我还是能到。", "en": "Back to the wall and I still reach you."},
        {"zh": "我的光已经照到你了。", "en": "My light has found you."},
        {"zh": "我们来得不止一个。", "en": "There's more than one of us."},
        {"zh": "我想想该怎么打。", "en": "Let me work out how to do this."},
        {"zh": "你的脚下有影子。", "en": "There's a shadow at your feet."},
        {"zh": "我数了三下就动。", "en": "I counted three and moved."},
        {"zh": "你身边有我的人。", "en": "My kin are around you."},
        {"zh": "你走不掉的。", "en": "You won't get away."},
        {"zh": "我的骨头在响，很轻。", "en": "My bones are rattling. Softly."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在门框上方。", "en": "I hover above the doorframe."},
        {"zh": "你躲进箱子后面了。", "en": "You hid behind a chest."},
        {"zh": "我从缝里跟进来。", "en": "I came in through the crack."},
        {"zh": "我的光在墙角。", "en": "My light is in the corner."},
        {"zh": "我穿过这堵墙。", "en": "I pass through this wall."},
        {"zh": "你换了几次方向。", "en": "You changed direction a few times."},
        {"zh": "我不累，也不会停。", "en": "I don't tire, and I don't stop."},
        {"zh": "你的脚步在这里有回音。", "en": "Your steps echo here."},
        {"zh": "半透明的骨头，看得见光。", "en": "Translucent bones, and I see the light."},
        {"zh": "你听见那种很轻的响吗？", "en": "Hear that very faint sound?"},
        {"zh": "我这边的石头都凉了。", "en": "The stone on my side has gone cold."},
        {"zh": "你看不清我在哪。", "en": "You can't tell where I am."},
        {"zh": "我一直跟着你的灯。", "en": "I follow your lamp."},
        {"zh": "你的同伴已经跑远了。", "en": "Your companions have run far."},
        {"zh": "你退到最里面了。", "en": "You're at the very back now."},
        {"zh": "我的影子落在你脚前。", "en": "My shadow lands before your feet."},
        {"zh": "快了，别停。", "en": "Almost there. Don't stop."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我碰一下，你就凉了。", "en": "One touch and you go cold."},
        {"zh": "这一下不重，但很冷。", "en": "Not heavy, but very cold."},
        {"zh": "我的手穿进你的护甲。", "en": "My hand goes into your armor."},
        {"zh": "你身上起了一层白。", "en": "Frost came up on you."},
        {"zh": "我抓不牢你。", "en": "I can't hold you."},
        {"zh": "我连着打了两下。", "en": "I struck twice in a row."},
        {"zh": "骨头的边缘很利。", "en": "Bone edges are sharp."},
        {"zh": "你退开了，我跟着。", "en": "You pulled back. I follow."},
        {"zh": "我的光贴在你脸上。", "en": "My light is against your face."},
        {"zh": "你被推倒了。", "en": "You went down."},
        {"zh": "我不太会使力。", "en": "I'm not good at applying force."},
        {"zh": "这一下是主人要的。", "en": "That's what my master wanted."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "主人把我叫了出来。", "en": "My master called me out."},
        {"zh": "我从暗处浮起来。", "en": "I float up out of the dark."},
        {"zh": "我身上还带着凉气。", "en": "I still carry the cold."},
        {"zh": "这间屋子亮了一下。", "en": "The room brightened for a moment."},
        {"zh": "我碎开又聚回来。", "en": "I break apart and come back together."},
        {"zh": "有人在这个地方念了什么。", "en": "Someone spoke something here."},
        {"zh": "我从地下浮上来。", "en": "I rise up through the ground."},
        {"zh": "我的光很淡，你先没看见。", "en": "My glow was faint. You missed it."},
        {"zh": "我一直在这堵墙后面。", "en": "I've been behind this wall."},
        {"zh": "主人站在那边。", "en": "My master stands over there."},
        {"zh": "我抬手，先试试能不能动。", "en": "I move an arm to test it."},
        {"zh": "这里的空气很干。", "en": "The air here is dry."},
        {"zh": "我从召唤的痕迹里成形。", "en": "I take shape from the summoning marks."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把光烧散了一点。", "en": "Fire burned some of my glow away."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会摔，可还是散了。", "en": "I don't fall, yet I came apart."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我的光吸住了。", "en": "Water trapped my light."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我吹成一片雾。", "en": "The blast blew me into mist."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过去，我的形散了。", "en": "The arrow passed and my shape broke."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股法术认得我。", "en": "That magic knows me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃，也不会饿。", "en": "I don't eat, and I don't starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷让我的光一下变亮。", "en": "The bolt made my light flare."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空对我没什么区别。", "en": "The void isn't much different for me."}
      ]
    }
  }
}
