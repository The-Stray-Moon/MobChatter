      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿侵蚀你的意志。", "en": "Hunger eats at your will."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "闪电撕裂你的肉体。", "en": "Lightning rips through your flesh."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空侵蚀你的存在。", "en": "Void erodes your being."}
      ]
    }
  }
