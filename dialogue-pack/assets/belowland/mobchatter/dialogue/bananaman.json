{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "缓慢蠕动，如同活死人。", "en": "Slowly crawl, like a living dead."},
        {"zh": "身体扭曲，向前蠕动。", "en": "Body twists, moving forward."},
        {"zh": "触碰地面，缓慢前行。", "en": "Touching the ground, moving slowly."},
        {"zh": "慢慢爬行，寻找猎物。", "en": "Slowly crawl, seeking prey."},
        {"zh": "缓慢移动，几乎不动。", "en": "Move slowly, barely moving."},
        {"zh": "爬行缝隙中，缓慢前进。", "en": "Crawling in the gap, moving slowly."},
        {"zh": "触碰目标，瞬间秒杀。", "en": "Touch target, instantly killing."},
        {"zh": "缓慢移动，静谧无声。", "en": "Move slowly, silent."},
        {"zh": "爬行中，寻找猎物。", "en": "Crawling, seeking prey."},
        {"zh": "缓慢移动，目光凶狠。", "en": "Move slowly, with a fierce gaze."},
        {"zh": "从爬行缝隙里挤出来。", "en": "I squeeze out of the crawling gap."},
        {"zh": "速度只有零点零八，很慢。", "en": "My speed is barely a crawl."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "无头怪静静地躺着。", "en": "Headless stands still."},
        {"zh": "无头怪静静地等待。", "en": "Headless waits quietly."},
        {"zh": "无头怪静静地栖息。", "en": "Headless rests quietly."},
        {"zh": "无头怪静静地观察。", "en": "Headless watches quietly."},
        {"zh": "无头怪静静地守候。", "en": "Headless guards quietly."},
        {"zh": "无头怪静静地休息。", "en": "Headless rests quietly."},
        {"zh": "无头怪静静地思考。", "en": "Headless thinks quietly."},
        {"zh": "无头怪静静地聆听。", "en": "Headless listens quietly."},
        {"zh": "无头怪静静地守护。", "en": "Headless guards quietly."},
        {"zh": "灾厄墓穴里只有我一个。", "en": "I am the only one in the Catacombs."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从一格高的缝里爬出来，慢极了。", "en": "I crawl out of a one-block gap, very slowly."},
        {"zh": "我从爬行缝里抬起头看你。", "en": "I lift my head from the crawl gap to see you."},
        {"zh": "慢慢爬，一寸一寸地。", "en": "Crawling slowly, inch by inch."},
        {"zh": "注视玩家，准备出手。", "en": "Fixes on the player, ready to strike."},
        {"zh": "石缝里伸出苍白的手。", "en": "A pale hand reaches from the crack."},
        {"zh": "我从那条一格的缝里，慢慢爬出来。", "en": "I crawl out of that one-block gap, slowly."},
        {"zh": "注视玩家，悄无声息。", "en": "Fixes on the player, silent."},
        {"zh": "注视玩家，静静等待。", "en": "Fixes on the player, quietly waiting."},
        {"zh": "没有头，却一直对着你。", "en": "Headless, yet always facing you."},
        {"zh": "注视玩家，准备下手。", "en": "Fixes on the player, ready to act."},
        {"zh": "我只有一个，专等你来。", "en": "There is only me, and I wait for you."},
        {"zh": "碰我一下，你就没了。", "en": "One touch from me and you are gone."},
        {"zh": "我没有头，也能看见你。", "en": "I have no head, yet I see you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身体开始腐烂，慢慢缩小。", "en": "Your flesh starts to rot and shrink."},
        {"zh": "伤口流着绿色黏液。", "en": "Green slime leaks from your wounds."},
        {"zh": "伤口渗出诡异液体。", "en": "Strange liquids seep from your wounds."},
        {"zh": "骨头被敲裂了，好痛。", "en": "My bones are cracked, it hurts."},
        {"zh": "皮肤开始腐烂。", "en": "Your skin begins to rot."},
        {"zh": "慢慢消瘦下去。", "en": "You slowly waste away."},
        {"zh": "伤口散发着恶臭。", "en": "Your wounds emit a foul stench."},
        {"zh": "腐烂的气息弥漫。", "en": "A stench of decay permeates the air."},
        {"zh": "你感到越来越虚弱。", "en": "You feel increasingly weak."},
        {"zh": "腐烂侵蚀你的肌肉。", "en": "Decay eats away at your muscles."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你踏进我的缝隙了。", "en": "You stepped into my crawlspace."},
        {"zh": "你的食物真香！", "en": "Your food smells good!"},
        {"zh": "别靠近我，不然你会后悔的！", "en": "Don't come closer or you'll regret it!"},
        {"zh": "你怎么还不吃我？", "en": "Why aren't you eating me?"},
        {"zh": "你这么慢，永远也吃不到我！", "en": "You're so slow, you'll never get me!"},
        {"zh": "你吃我，你会后悔的！", "en": "Eating me will make you regret it!"},
        {"zh": "我从那条矮缝里爬出来。", "en": "I crawl out of that low gap."},
        {"zh": "你走开，我饿了！", "en": "Go away, I'm hungry!"},
        {"zh": "不要碰我，我会杀了你！", "en": "Don't touch me, I'll kill you!"},
        {"zh": "你这么慢，我根本不在乎！", "en": "You're so slow, I don't care!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你一碰，我就抓你。", "en": "One touch from you and I grab you."},
        {"zh": "我不会让你这么轻易接近！", "en": "I won't let you get close that easily!"},
        {"zh": "你撞破了我的世界！", "en": "You've broken my world!"},
        {"zh": "我没有头，撞了也不疼。", "en": "No head. A bump means nothing."},
        {"zh": "别再往前，我的触角先碰到你。", "en": "One step more and my antennae touch you."},
        {"zh": "你怎么这么笨？", "en": "How stupid are you?"},
        {"zh": "你撞不动我，我已经死了！", "en": "You can't hurt me, I'm already dead!"},
        {"zh": "你撞上我，你会后悔的！", "en": "Hitting me will make you regret it!"},
        {"zh": "我不会这么容易被撞死！", "en": "I won't die that easily!"},
        {"zh": "你撞不动我，我已经无敌了！", "en": "You can't hurt me, I'm invincible!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我从缝隙里爬出来，只为了你。", "en": "I crawled out of the gap only for you."},
        {"zh": "骨缝里等了你好久。", "en": "I've waited in the bone cracks for you."},
        {"zh": "你是唯一能打动我的！", "en": "You're the only one who can touch me!"},
        {"zh": "来和我共舞吧！", "en": "Dance with me!"},
        {"zh": "我从一格的缝里爬出来。", "en": "I crawl out of a one-block gap."},
        {"zh": "墓穴只容得下一只无头怪。", "en": "Only one headless thing fits in these catacombs."},
        {"zh": "你是我梦寐以求的伴侣！", "en": "You're the one I've been dreaming of!"},
        {"zh": "我慢得像棵树，也等你。", "en": "I am slow as a tree, and still I wait."},
        {"zh": "你是唯一能让我动心的！", "en": "You're the only one who can make me move!"},
        {"zh": "墓穴里只剩我一个了。", "en": "I'm the only one left in the catacombs."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "无头怪的皮肤泛着幽光。", "en": "Its skin glows faintly."},
        {"zh": "它似乎在等待着猎物。", "en": "It seems to be waiting for prey."},
        {"zh": "我没有头，也不需要眼睛。", "en": "I have no head, and no need for eyes."},
        {"zh": "它缓慢地蠕动着。", "en": "It moves slowly."},
        {"zh": "它从缝隙中缓缓爬出。", "en": "It crawls out from the缝隙中。"},
        {"zh": "它几乎察觉不到的存在感。", "en": "Its nearly undetectable presence."},
        {"zh": "无头怪发出微弱的嘶嘶声。", "en": "It hisses faintly."},
        {"zh": "它缓慢地靠近目标。", "en": "It slowly approaches the target."},
        {"zh": "它的触碰即为致命。", "en": "Its touch is fatal."},
        {"zh": "它在黑暗中无声无息。", "en": "It moves silently in the dark."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经成为了它的目标。", "en": "You have become its target."},
        {"zh": "它悄然接近，无声无息。", "en": "It approaches silently."},
        {"zh": "它的触碰足以致命。", "en": "Its touch is致命的。"},
        {"zh": "我从一格里爬出来，很慢很慢。", "en": "I crawl out of a one-block gap, very slowly."},
        {"zh": "它会悄无声息地靠近。", "en": "It will approach quietly."},
        {"zh": "它已经锁定你的位置。", "en": "It has locked onto your position."},
        {"zh": "它的目光如刀。", "en": "Its gaze is like a刀。"},
        {"zh": "它缓慢但坚定地逼近。", "en": "It advances slowly but surely."},
        {"zh": "它的目光在你身上停留。", "en": "Its gaze lingers on you."},
        {"zh": "它似乎知道你在哪里。", "en": "It seems to know where you are."},
        {"zh": "裂缝那边有动静。", "en": "Something moves beyond the gap."},
        {"zh": "我慢慢挪，你慢慢等。", "en": "I creep forward. You wait."},
        {"zh": "墓穴里终于来了活物。", "en": "Something living, at last, in the crypt."},
        {"zh": "我看得见，你没有头灯。", "en": "I can see you, headlamp or not."},
        {"zh": "一碰就到，别急。", "en": "One touch is all it takes. No rush."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它触碰即可秒杀。", "en": "It can kill with a touch."},
        {"zh": "它悄无声息地锁定目标。", "en": "It silently locks onto its target."},
        {"zh": "它的攻击几乎不可察觉。", "en": "Its attack is nearly undetectable."},
        {"zh": "它将目标置于死地。", "en": "It places its target in harm's way."},
        {"zh": "它的存在足以致命。", "en": "Its presence is致命的。"},
        {"zh": "它悄无声息地逼近。", "en": "It approaches silently."},
        {"zh": "擦到皮肤就再无机会。", "en": "One brush of skin and there is no second chance."},
        {"zh": "它悄无声息地行动。", "en": "It moves silently."},
        {"zh": "它的攻击无声无息。", "en": "Its attack is silent."},
        {"zh": "它悄无声息地锁定。", "en": "It locks silently."},
        {"zh": "手抬起来了，很慢。", "en": "My hand lifts, slowly."},
        {"zh": "你再退，也退不出墓穴。", "en": "Back away all you like, you cannot leave the crypt."},
        {"zh": "我摸到你的影子了。", "en": "I have touched your shadow."},
        {"zh": "别跑，我追不上，但你得等。", "en": "Don't run. I cannot chase, but you must wait."},
        {"zh": "这一触，不流血。", "en": "This touch draws no blood."},
        {"zh": "墓穴的墙挡着你呢。", "en": "The crypt walls are blocking you."},
        {"zh": "我很慢，可你不会更快。", "en": "I am slow, but you will not be faster."},
        {"zh": "你听见我的爬行声了。", "en": "You hear my crawling."},
        {"zh": "近了，就差一步。", "en": "Closer now. One step left."},
        {"zh": "我不用咬，碰一下就好。", "en": "I need not bite. A touch will do."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "低吼几声，触碰即亡", "en": "Roar softly, touch and die"},
        {"zh": "无声无息，一击毙命", "en": "Silent, one-hit kill"},
        {"zh": "靠近即死，无头之魂", "en": "Death by proximity, headless spirit"},
        {"zh": "无需挥舞，自生恐惧", "en": "No swing needed, insta-fear"},
        {"zh": "触碰即死，无形之刃", "en": "Touch to die,无形之刃"},
        {"zh": "无头亦有威，触即灭", "en": "Headless, touch to die"},
        {"zh": "无声怒吼，致命之吻", "en": "Silent roar, deadly kiss"},
        {"zh": "无头亦无惧，致命一触", "en": "Headless, deadly touch"},
        {"zh": "无声中致命，无形中死神", "en": "Death in silence, death in the void"},
        {"zh": "无声杀机，一击毙敌", "en": "Silent killer, one-hit kill"},
        {"zh": "碰到了，你已经完了。", "en": "Touched. You are finished."},
        {"zh": "不用挥爪，一下就够。", "en": "No claws needed. Once is enough."},
        {"zh": "你的命归墓穴了。", "en": "Your life belongs to the crypt."},
        {"zh": "我慢，可这一下很准。", "en": "I am slow, but this strike is sure."},
        {"zh": "没有头，也能收你。", "en": "Headless, yet I claim you."},
        {"zh": "别喊，没人听得见。", "en": "Don't shout. No one hears."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "在缝隙中爬出", "en": "Crawls out of缝隙"},
        {"zh": "从黑暗深处", "en": "From deep darkness"},
        {"zh": "无声之中降临", "en": "Arrives in silence"},
        {"zh": "黑暗中的触手", "en": "Darkness reaching"},
        {"zh": "无声中出现", "en": "Appears in silence"},
        {"zh": "从缝隙中蠕动", "en": "Creeps from缝隙"},
        {"zh": "黑暗中伸展", "en": "Stretches in darkness"},
        {"zh": "从阴暗中浮现", "en": "Appears from shadows"},
        {"zh": "墓穴的缝隙里有了声音。", "en": "A sound comes from the crypt's gap."},
        {"zh": "一格高的缝，我钻得进。", "en": "A one-block gap, and I fit through."},
        {"zh": "我从墓穴深处挪出来。", "en": "I creep out of the crypt's depths."},
        {"zh": "这里只容得下我一个。", "en": "Only one of me fits here."},
        {"zh": "缓慢地，我站在你面前。", "en": "Slowly, I stand before you."},
        {"zh": "灾厄墓穴又醒了。", "en": "The Catacombs wake again."}
      ]
    },
