      "lines": [
        {"zh": "嗡嗡飞行，四处搜寻腐化之地。", "en": "Buzzing around, seeking corrupted lands."},
        {"zh": "腐化真菌，令我变得更加强大。", "en": "Corrupted fungi, making me stronger."},
        {"zh": "嗡嗡飞行，感染一切生物。", "en": "Buzzing, infecting all creatures."},
        {"zh": "我飞向腐化的天空。", "en": "I fly in the corrupted sky."},
        {"zh": "嗡嗡，嗡嗡，我将你包围。", "en": "Buzz, buzz, I surround you."},
        {"zh": "腐化的蜂蜜，滋养我的生命。", "en": "Corrupted honey, nourishing my life."},
        {"zh": "寻找新的腐化区域。", "en": "Seeking new corrupted areas."},
        {"zh": "嗡嗡，我将你感染。", "en": "Buzz, I infect you."},
        {"zh": "飞行于腐化之地。", "en": "Flying in corrupted lands."},
        {"zh": "嗡嗡嗡，我来感染你。", "en": "Buzz, buzz, I infect you."},
