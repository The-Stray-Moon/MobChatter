{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在欧兰伍德林里爬。", "en": "I crawl through the Orlanwood."},
        {"zh": "树干在我身边显得细。", "en": "The trunks look thin beside me."},
        {"zh": "鳞片刮过地面，沙沙响。", "en": "My scales rasp the ground."},
        {"zh": "欧兰伍德的蛇，能吞下整个人。", "en": "An Oranwood serpent can swallow a whole person."},
        {"zh": "树干上留下了痕。", "en": "A mark is left on the bark."},
        {"zh": "我的腹鳞一片片压过落叶。", "en": "Scale by scale, my belly crosses the leaves."},
        {"zh": "林子里非常暗。", "en": "The wood is dim."},
        {"zh": "光只落在上面。", "en": "Light falls only high up."},
        {"zh": "我的身体比欧兰伍德的树干还粗。", "en": "My body is thicker than an Orlanwood trunk."},
        {"zh": "太远了，够不到。", "en": "Too far to reach."},
        {"zh": "我低下头继续走。", "en": "I lower my head and go on."},
        {"zh": "我听见林子里细碎的响。", "en": "I hear small rustles in the wood."},
        {"zh": "我把身子收住。", "en": "I check my bulk."},
        {"zh": "等它自己出来。", "en": "Wait for it to show itself."},
        {"zh": "它没有出来。", "en": "It does not."},
        {"zh": "我接着往前爬。", "en": "I crawl on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘在一处空地上。", "en": "I lie coiled in a clearing."},
        {"zh": "头搁在自己身上。", "en": "My head rests on my own body."},
        {"zh": "我的黄眼在暗处发亮。", "en": "My yellow eyes glow in the dark."},
        {"zh": "我一点也不眨眼。", "en": "I do not blink."},
        {"zh": "林子里的声音我都听得见。", "en": "I hear every sound in the wood."},
        {"zh": "虫在土里，鸟在枝上。", "en": "Insects in the soil, birds in the branches."},
        {"zh": "我都不感兴趣。", "en": "None of it interests me."},
        {"zh": "我的舌头伸出去，又收回来。", "en": "My tongue goes out and back."},
        {"zh": "地上有叶子的味道。", "en": "The ground tastes of leaves."},
        {"zh": "我等大的东西。", "en": "I wait for something large."},
        {"zh": "只有大的才够。", "en": "Only large will do."},
        {"zh": "我又把身子收紧一圈。", "en": "I take in one more coil."},
        {"zh": "风穿过我的鳞片。", "en": "Wind passes over my scales."},
        {"zh": "我半天才吐一口气。", "en": "I let out one breath in a long while."},
        {"zh": "很久才动一次。", "en": "Once in a long while."},
        {"zh": "我可以这样待上好几天。", "en": "I can stay like this for days."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进了空地。", "en": "You walk into the clearing."},
        {"zh": "我把头高高昂起。", "en": "I raise my head high."},
        {"zh": "欧兰伍德森林里，我盘着不动。", "en": "In the Orinwood I coil still."},
        {"zh": "我留在原处不动。", "en": "I hold where I am."},
        {"zh": "你也停下了脚。", "en": "You stop too."},
        {"zh": "我的头慢慢升高。", "en": "My head rises slowly."},
        {"zh": "比你的头顶还高。", "en": "Above the top of your head."},
        {"zh": "你往后挪半步。", "en": "You shift half a step back."},
        {"zh": "我懒得去理会。", "en": "I cannot be troubled."},
        {"zh": "我昂着头，不出声。", "en": "I hold my head high and say nothing."},
        {"zh": "我的嘴能张得很大。", "en": "My mouth can open very wide."},
        {"zh": "你会想这一点。", "en": "You will be thinking of that."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的长身一扭。", "en": "My long body twists."},
        {"zh": "鳞片上有一道裂口。", "en": "A split opens in my scales."},
        {"zh": "我的长身又收紧。", "en": "My long body tightens again."},
        {"zh": "我的头又昂起来。", "en": "My head rises again."},
        {"zh": "看着打我的人。", "en": "Looking at whoever struck."},
        {"zh": "我连鳞片都不响。", "en": "Not even my scales whisper."},
        {"zh": "只是张开了嘴。", "en": "I only open my mouth."},
        {"zh": "嘴里一片漆黑。", "en": "It is black inside."},
        {"zh": "我的鳞缝里渗出血腥味。", "en": "Blood seeps between my scales."},
        {"zh": "我等它再来一次。", "en": "I wait for it to come again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那实在太小了。", "en": "That is too small."},
        {"zh": "我把头凑近了。", "en": "I bring my head close."},
        {"zh": "仔细闻了闻。", "en": "And scent it."},
        {"zh": "这不是猎物。", "en": "Not prey."},
        {"zh": "我把头退开了。", "en": "I draw back."},
        {"zh": "我的舌头又收回去。", "en": "My tongue withdraws."},
        {"zh": "你放下的那点，我看不上。", "en": "What you set down, I won't look at."},
        {"zh": "那点东西，我不屑一顾。", "en": "I watch you, not the thing."},
        {"zh": "等它慢慢坏掉。", "en": "Let it spoil."},
        {"zh": "这东西不够我塞牙。", "en": "It will not fill a tooth gap."},
        {"zh": "我需要整只的。", "en": "I need something whole."},
        {"zh": "活的更好些。", "en": "Live is better."},
        {"zh": "我又把身子盘回来。", "en": "I coil back down."},
        {"zh": "这个下午还是空的。", "en": "The afternoon is still empty."},
        {"zh": "我静静等着。", "en": "I wait in stillness."},
        {"zh": "总会有大的来。", "en": "Something large always comes."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我鳞上，弹开了。", "en": "You hit my scales and bounce off."},
        {"zh": "我的鳞几乎没有感觉。", "en": "My scales barely feel it."},
        {"zh": "我听见你踩断了枯枝。", "en": "I hear you snap a dead branch."},
        {"zh": "我的姿势没有改。", "en": "My pose has not changed."},
        {"zh": "我只是把身体盘紧了一点。", "en": "I only draw my coils a little tighter."},
        {"zh": "欧兰伍德的林子，我吞得下你。", "en": "In Ouranwood, I can swallow you whole."},
        {"zh": "你从旁边绕过去了。", "en": "You go around."},
        {"zh": "我看着你走过去。", "en": "I watch you go."},
        {"zh": "你一点也没跑。", "en": "You do not run."},
        {"zh": "我略有些兴致。", "en": "I am mildly interested."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "林子另一头还有一条。", "en": "There is another at the far end of the wood."},
        {"zh": "我嗅到它了。", "en": "I have caught the scent."},
        {"zh": "我慢慢爬过去，欧兰伍德的落叶太厚。", "en": "I crawl closer; Oranwood leaves lie thick."},
        {"zh": "它比我的尾巴短一点。", "en": "It is a bit shorter than my tail."},
        {"zh": "我们并排盘着。", "en": "We coil side by side."},
        {"zh": "头都朝着上面。", "en": "Both heads pointed up."},
        {"zh": "我们盘着，谁也没动。", "en": "Coiled together, neither of us stirs."},
        {"zh": "过了很久才动。", "en": "A long time passes before either stirs."},
        {"zh": "两个头靠在一起。", "en": "Two heads lean together."},
        {"zh": "然后各自分开。", "en": "Then part."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头看它，实在太小了。", "en": "I lower my head; it is far too small."},
        {"zh": "实在是太小了。", "en": "Far too small."},
        {"zh": "我用舌头碰了一下。", "en": "I touch it with my tongue."},
        {"zh": "太小了，填不满我。", "en": "Too small to fill me."},
        {"zh": "我用吻尖把它拨开。", "en": "I nudge it aside with my snout."},
        {"zh": "或者压进土里。", "en": "Or press it into the soil."},
        {"zh": "它的痕迹消失了。", "en": "Its trace is gone."},
        {"zh": "我又盘回原处。", "en": "I coil back into place."},
        {"zh": "地上多了一个浅坑。", "en": "A shallow hollow is left in the ground."},
        {"zh": "明天它会被叶子盖住。", "en": "Tomorrow the leaves will cover it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在树后面。", "en": "Something is behind the tree."},
        {"zh": "比虫子大得多。", "en": "Bigger than a bug."},
        {"zh": "我侧头看过去。", "en": "I tilt my head that way."},
        {"zh": "它背对着我，还在挪。", "en": "Its back is to me, and it keeps moving."},
        {"zh": "我慢慢把头升起来。", "en": "I raise my head slowly."},
        {"zh": "它未曾看见我。", "en": "It has not seen me."},
        {"zh": "我从地上滑出去。", "en": "I slide forward along the ground."},
        {"zh": "叶子盖住了我的声音。", "en": "The leaves cover my sound."},
        {"zh": "它猛地收住了脚。", "en": "It checks its step sharply."},
        {"zh": "我立刻一动不动。", "en": "I freeze at once."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面跟着它。", "en": "I follow it along the ground."},
        {"zh": "它一点瞧不见我。", "en": "It cannot see me."},
        {"zh": "我的鳞和土一个色。", "en": "My scales are the color of soil."},
        {"zh": "我一段一段地靠近。", "en": "I close in, length by length."},
        {"zh": "欧兰伍德的蛇怪，能吞下你。", "en": "The Ouranwood basilisk can swallow you."},
        {"zh": "我把头停住。", "en": "I stop."},
        {"zh": "它一点没发觉。", "en": "It has not perceived me."},
        {"zh": "我顺着落叶潜到它身后。", "en": "I slide through the leaves behind it."},
        {"zh": "我的头升到它肩膀的高度。", "en": "My head rises to its shoulder."},
        {"zh": "然后升得更高。", "en": "Then higher."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬下去，整只都进去了。", "en": "I bite, and the whole of it goes in."},
        {"zh": "我的嘴能张到很宽。", "en": "My mouth opens very wide."},
        {"zh": "喉咙一点一点推。", "en": "My throat works it down."},
        {"zh": "我的颈子绷直。", "en": "My neck goes taut."},
        {"zh": "身体鼓了一块。", "en": "A bulge shows in my body."},
        {"zh": "我在原地盘起。", "en": "I coil where I lie."},
        {"zh": "消化要花很久。", "en": "Digesting takes a long while."},
        {"zh": "这几天我不动。", "en": "For days I will not move."},
        {"zh": "有东西来也不管。", "en": "If something comes, I will not care."},
        {"zh": "我吃得太撑了。", "en": "I am overfull."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "腐叶翻开，我抬起头。", "en": "Rotting leaves part; I raise my head."},
        {"zh": "身上全是泥土。", "en": "Soil all over me."},
        {"zh": "这里叫欧兰伍德。", "en": "This place is called Orlanwood."},
        {"zh": "树很高，光很淡。", "en": "The trees are tall. The light is thin."},
        {"zh": "我把头仰起来。", "en": "I lift my face upward."},
        {"zh": "头顶的枝杈交错。", "en": "The branches cross overhead."},
        {"zh": "我一圈圈盘起。", "en": "I coil myself ring by ring."},
        {"zh": "先量一下这块空地。", "en": "First, size this clearing."},
        {"zh": "正好容得下我。", "en": "It is just enough for me."},
        {"zh": "我把头搁在身体上。", "en": "I rest my head on my body."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到鳞片，我立刻缩成一团。", "en": "Fire reaches my scales and I curl tight at once."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下，压断了三棵树。", "en": "I roll down the slope and break three trees."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进嘴里，我拼命往前挣。", "en": "Water floods my mouth; I strain forward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸响把我掀起来，又摔回林子。", "en": "The blast lifts me and slams me back into the wood."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的鳞缝。", "en": "An arrow finds the gap between my scales."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光压住我，我连头都抬不起。", "en": "Strange light presses me down; I cannot even lift my head."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "很久没有大东西，我的身子开始瘦。", "en": "No large prey for a long time, and my body thins."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我身上，我全身的鳞都响了。", "en": "Lightning strikes me and every scale rings."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "林地不见了，我在黑里翻着坠。", "en": "The forest floor is gone and I tumble through black."}
      ]
    }
  }
}
