{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "后腿折起来，再弹直", "en": "My hind legs fold, then snap straight."},
        {"zh": "一跳就是两格远", "en": "One hop covers two blocks."},
        {"zh": "甲壳在地上磕出响", "en": "My shell knocks the ground."},
        {"zh": "落点永远挑硬的", "en": "I always land on the hard spots."},
        {"zh": "我沿着巢穴边缘跳", "en": "I hop along the nest's edge."},
        {"zh": "一跳一停，看看四周", "en": "Hop, pause, look around."},
        {"zh": "我的触角上下点", "en": "My antennae bob."},
        {"zh": "草地在我下面晃", "en": "The grass sways beneath me."},
        {"zh": "我跳上石块，再跳下去。", "en": "I hop onto the stone and down again."},
        {"zh": "从草叶上弹过去", "en": "I spring off a blade of grass."},
        {"zh": "六条腿落地很稳", "en": "Six legs land sure."},
        {"zh": "背后留下一串坑", "en": "A string of dents behind me."},
        {"zh": "我朝高处跳去", "en": "I hop uphill."},
        {"zh": "那里的风很好", "en": "The wind's better there."},
        {"zh": "再一跳就到了", "en": "One more hop and I'm there."},
        {"zh": "翅膀在甲下折着", "en": "Wings folded under my shell."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "蹲着，后腿蓄着劲", "en": "Crouched, my hind legs loaded."},
        {"zh": "甲壳上有细密的纹", "en": "Fine ridges cross my shell."},
        {"zh": "触角扫过草尖", "en": "My antennae sweep the grass tips."},
        {"zh": "我伏在地上，数你的脚步。", "en": "I lie low, counting your footfalls."},
        {"zh": "脚下的土，有动静。", "en": "The soil underfoot is stirring."},
        {"zh": "后腿又收紧一点", "en": "My hind legs coil tighter."},
        {"zh": "我缩起腿，像一粒小石子。", "en": "I tuck my legs in like a little pebble."},
        {"zh": "让它再靠近些", "en": "Let it come closer."},
        {"zh": "这样跳得才准", "en": "That's how the jump lands true."},
        {"zh": "风向也对得上", "en": "The wind's right too."},
        {"zh": "我的腿绷着，随时弹。", "en": "My legs are coiled, ready to spring."},
        {"zh": "都准备妥当了", "en": "Everything's ready."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从草里看你", "en": "I watch from the grass."},
        {"zh": "我比你矮这么多", "en": "I'm so much shorter than you."},
        {"zh": "我跳起来才到你的腰", "en": "Even jumping, I reach your waist."},
        {"zh": "触角朝你伸过去", "en": "My antennae reach toward you."},
        {"zh": "我在估你的动作", "en": "I'm reading your movement."},
        {"zh": "你的鞋底悬在我头顶。", "en": "Your sole hangs above my head."},
        {"zh": "往后退了半步，助跑。", "en": "Half a step back. Getting a run-up."},
        {"zh": "然后又站住了", "en": "Then hold."},
        {"zh": "我跳得比你想的快", "en": "I'm quicker than you think."},
        {"zh": "你不信就试试", "en": "Try me if you doubt it."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下弹开很远", "en": "I spring far away."},
        {"zh": "甲壳裂了一道", "en": "A crack opens in my shell."},
        {"zh": "体液一点点渗出", "en": "Fluid seeps out."},
        {"zh": "我落地没稳，翻了个跟头。", "en": "I land badly and tumble over."},
        {"zh": "六条腿有一只不动", "en": "One of my six legs won't move."},
        {"zh": "我侧躺在地上", "en": "I lie on my side."},
        {"zh": "我跳起来的时候，腿会响。", "en": "My legs click when I leap."},
        {"zh": "触角还在动着", "en": "My antennae still move."},
        {"zh": "我还能跳起来", "en": "I can still hop."},
        {"zh": "那就能跑得掉", "en": "So I can still run."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这是什么气味", "en": "What smell is this?"},
        {"zh": "触角使劲动了动", "en": "My antennae work."},
        {"zh": "是能吃的东西", "en": "Something edible."},
        {"zh": "我往前跳了一下", "en": "I hop forward once."},
        {"zh": "然后又跳了一下", "en": "Then again."},
        {"zh": "这一下更近了", "en": "Closer now."},
        {"zh": "我低头，用口器碰了碰", "en": "I dip and touch it with my mouthparts."},
        {"zh": "居然真的能咬", "en": "It gives."},
        {"zh": "我咬了一口吃", "en": "I take a bite."},
        {"zh": "这一口不算多", "en": "Not much of a bite."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得翻壳", "en": "I'm flipped onto my shell."},
        {"zh": "六条腿在空中乱蹬", "en": "Six legs kick at air."},
        {"zh": "我翻回正面去", "en": "I right myself."},
        {"zh": "然后一下弹开", "en": "Then spring clear."},
        {"zh": "甲壳磕在地上响", "en": "My shell clacks on the ground."},
        {"zh": "我停在两步外", "en": "I stop two hops away."},
        {"zh": "触角抖了一抖", "en": "My antennae tremble."},
        {"zh": "然后又立起来", "en": "Then lift again."},
        {"zh": "这一下压根不疼", "en": "That didn't even hurt."},
        {"zh": "我继续往前跳", "en": "I keep hopping."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "巢里同类很多", "en": "There are many in the nest."},
        {"zh": "我们靠气味认", "en": "We know each other by scent."},
        {"zh": "我跳到她旁边", "en": "I hop over beside her."},
        {"zh": "用触角碰了碰", "en": "Our antennae touch."},
        {"zh": "她跳开，我又跟上", "en": "She hops off. I follow."},
        {"zh": "跳了三次才停", "en": "Three hops and she stops."},
        {"zh": "她埋在土里一些东西", "en": "She buries something in the soil."},
        {"zh": "那里会长出新的", "en": "Something new will grow there."},
        {"zh": "我守着那块土", "en": "I watch over that patch."},
        {"zh": "守到它自己开", "en": "Until it opens on its own."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前脚扒住", "en": "I cling with my forelegs."},
        {"zh": "太重，跳不起来", "en": "Too heavy to jump with."},
        {"zh": "只好拖着它走", "en": "I drag it instead."},
        {"zh": "拖了两步就放下", "en": "Two steps and I drop it."},
        {"zh": "我在旁边跳了跳", "en": "I hop beside it."},
        {"zh": "我又拖了一段", "en": "Drag it further."},
        {"zh": "这粒种子，我抱在怀里。", "en": "I clutch this seed to my chest."},
        {"zh": "我啃了一下试试", "en": "I test it with a chew."},
        {"zh": "这个肯定不行", "en": "No good."},
        {"zh": "我便一下跳开", "en": "I hop away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "地面上有震动", "en": "Vibration in the ground."},
        {"zh": "地面的震动，把我引向你。", "en": "The ground's vibration draws me toward you."},
        {"zh": "后腿紧紧收紧", "en": "Hind legs coil."},
        {"zh": "身体压得很低", "en": "Body low."},
        {"zh": "触角全都朝前", "en": "Every antenna forward."},
        {"zh": "我在等它再近一步", "en": "Waiting for one more step."},
        {"zh": "它再靠近一步", "en": "One more step."},
        {"zh": "机会就是现在", "en": "The moment is now."},
        {"zh": "我一下弹出去", "en": "I spring."},
        {"zh": "落地时已经在你身上", "en": "And land on you."},
        {"zh": "脚爪抓住布料", "en": "My claws catch cloth."},
        {"zh": "落地然后再咬", "en": "Then bite."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳到你的侧面", "en": "I hop to your flank."},
        {"zh": "再跳到另一侧", "en": "Then to the other side."},
        {"zh": "你每次转头都慢半拍", "en": "You're half a beat late each turn."},
        {"zh": "我一直在换位置", "en": "I never stay in one spot."},
        {"zh": "草地给了我掩护", "en": "The grass covers me."},
        {"zh": "我跳得非常低", "en": "I hop low."},
        {"zh": "不越过你的膝盖", "en": "Never above your knee."},
        {"zh": "你低头也看不全", "en": "Even looking down, you miss me."},
        {"zh": "我的后腿压紧，准备弹射。", "en": "My hind legs compress, ready to launch."},
        {"zh": "我从它后面来", "en": "From behind."},
        {"zh": "我现在就起跳", "en": "Jumping now."},
        {"zh": "落地就咬下去", "en": "Land and bite."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我弹起来，撞向你的膝盖。", "en": "I spring up and hit your knee."},
        {"zh": "六条腿在你身上找地方", "en": "Six legs find purchase on you."},
        {"zh": "口器狠狠咬下", "en": "My mouthparts bite down."},
        {"zh": "这一下不够深", "en": "Not deep enough."},
        {"zh": "我又补了一口", "en": "I add another bite."},
        {"zh": "你挥手，我被拍开了", "en": "You swat, and I'm knocked loose."},
        {"zh": "落地翻了个身", "en": "I land and roll."},
        {"zh": "立刻又弹起来", "en": "Up again at once."},
        {"zh": "甲壳上有一道白痕", "en": "A white mark on my shell."},
        {"zh": "我先退开再说", "en": "I withdraw first."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草里弹出一个影子", "en": "A shape springs out of the grass."},
        {"zh": "落到一块石头上", "en": "It lands on a stone."},
        {"zh": "我抖了抖甲壳", "en": "I shake my shell."},
        {"zh": "这是虫潮的地盘", "en": "This is swarm ground."},
        {"zh": "我闻到了巢的味道", "en": "I smell the nest."},
        {"zh": "其实一点也不远", "en": "Not far at all."},
        {"zh": "我先跳两下试试", "en": "I test two hops."},
        {"zh": "六条腿还好用", "en": "Legs work."},
        {"zh": "风向朝巢那边", "en": "Wind runs toward the nest."},
        {"zh": "那就赶紧出发吧", "en": "Then off I go."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "甲壳被烤得翘起来", "en": "Heat warps my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时腿折了一下", "en": "A leg buckles on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我蹬不上去", "en": "In water I can't kick my way up."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我弹飞，甲壳嗡嗡响。", "en": "The blast flings me away, my shell ringing."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西打穿了我的甲", "en": "Something punches through my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "甲壳里一阵发麻", "en": "A numbness fills my shell."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得跳不起来", "en": "Too hungry to jump."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打得我六腿一僵", "en": "Lightning freezes all six legs."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我下面没有地", "en": "Nothing below."}
      ]
    }
  }
