{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我皮上的暗斑，蹭过草尖。", "en": "Dark spots on my hide brush the grass tips."},
        {"zh": "我的身体圆鼓鼓的。", "en": "My body is round and swollen."},
        {"zh": "里面装着什么东西。", "en": "There is something inside me."},
        {"zh": "我的短脚挪一步歇一步。", "en": "My short legs take a step, then rest."},
        {"zh": "走太快会颠。", "en": "Too fast and it jolts."},
        {"zh": "我踩过草地，草被压平。", "en": "I cross the grass and it lies flat."},
        {"zh": "我停下来歇一歇。", "en": "I stop to rest."},
        {"zh": "歇够了，我又颠起来。", "en": "Rested enough, I waddle on."},
        {"zh": "我的影子短短的。", "en": "My shadow is short."},
        {"zh": "我个子并不高。", "en": "I am not tall."},
        {"zh": "前面有块石头。", "en": "A stone ahead."},
        {"zh": "我贴着草边绕开。", "en": "I skirt along the grass."},
        {"zh": "碰上会出声。", "en": "Bumping would make a sound."},
        {"zh": "我不想出声。", "en": "I do not want to make a sound."},
        {"zh": "草给我压出窄窄一条。", "en": "I press a narrow trail through the grass."},
        {"zh": "这样就安全了。", "en": "Safe."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，肚子起伏。", "en": "I stand and my belly rises and falls."},
        {"zh": "里面有很轻的嘶声。", "en": "There is a faint hiss inside."},
        {"zh": "我自己听得见。", "en": "I can hear it."},
        {"zh": "别人听不到。", "en": "No one else can."},
        {"zh": "我的皮是粗糙的。", "en": "My hide is coarse."},
        {"zh": "有斑，颜色很暗。", "en": "Mottled, and dark."},
        {"zh": "我的引信垂在草里，没响。", "en": "My fuse hangs in the grass, quiet."},
        {"zh": "风从那个方向来。", "en": "The wind comes from there."},
        {"zh": "我伏得更低一些。", "en": "I sink a little lower."},
        {"zh": "风势小了一点。", "en": "The wind is less."},
        {"zh": "我在此处等候。", "en": "I wait here."},
        {"zh": "等一个合适的距离。", "en": "For the right distance."},
        {"zh": "我的脚在地上磨了磨。", "en": "I scuff my feet on the ground."},
        {"zh": "这个位置可以。", "en": "This position will do."},
        {"zh": "我收住四只脚。", "en": "I bring my feet to rest."},
        {"zh": "然后不再动。", "en": "And stay still."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你朝我走过来了。", "en": "You come near."},
        {"zh": "我挡在路上，引信对着你。", "en": "I block the path, fuse pointed at you."},
        {"zh": "我的肚子鼓了一下。", "en": "My belly swells once."},
        {"zh": "里面响了一声。", "en": "Something clicks inside."},
        {"zh": "你听见了那声。", "en": "You heard it."},
        {"zh": "你的脚步顿住了。", "en": "Your steps halt."},
        {"zh": "正是这个距离。", "en": "Just so."},
        {"zh": "你往后退去。", "en": "You move back."},
        {"zh": "退得越远越好。", "en": "The further the better."},
        {"zh": "我的引线一响，你就该躲。", "en": "When my fuse hisses, hide."},
        {"zh": "直到你走远了。", "en": "Until you are far."},
        {"zh": "我才把身子松下来。", "en": "Only then do I relax."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个晃了一下。", "en": "I lurch."},
        {"zh": "肚子里的东西撞到了壳。", "en": "What is inside me knocks its casing."},
        {"zh": "我站住不动了。", "en": "I hold still."},
        {"zh": "等它自己安静。", "en": "Until it settles."},
        {"zh": "过了一会儿才动。", "en": "Only then do I move."},
        {"zh": "身上有一道裂。", "en": "There is a crack in me."},
        {"zh": "我垂眼看那道裂。", "en": "I look down at the crack."},
        {"zh": "这个碰不得。", "en": "I must not touch it."},
        {"zh": "我缓缓往前挪。", "en": "I move along slowly."},
        {"zh": "比刚才更慢了。", "en": "Slower than before."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我肚里装的是火，不是饭。", "en": "My belly holds fire, not food."},
        {"zh": "你把那玩意儿举高。", "en": "You hold that thing up high."},
        {"zh": "我瞧了眼，没动。", "en": "I glance, and do not move."},
        {"zh": "里面的东西不需要。", "en": "What is inside me needs nothing."},
        {"zh": "你举了那么久。", "en": "You hold it a long while."},
        {"zh": "我侧过身去。", "en": "I turn my body aside."},
        {"zh": "这样你就明白了。", "en": "Then you will understand."},
        {"zh": "你把那东西放地上。", "en": "You set that thing on the ground."},
        {"zh": "我没有去碰。", "en": "I do not touch it."},
        {"zh": "它会留在地上。", "en": "It will stay on the ground."},
        {"zh": "我嫌它太小，绕去别处。", "en": "Too small for me; I go around."},
        {"zh": "走了几步，我回头看了一眼。", "en": "A few steps on, I look back."},
        {"zh": "那东西还搁着。", "en": "It is still lying there."},
        {"zh": "引信还长，我再挪一点。", "en": "The fuse is long; I'll shuffle on."},
        {"zh": "吃的塞不住我肚里的缝。", "en": "Food can't plug the gap in my belly."},
        {"zh": "我什么也不求。", "en": "I want for nothing."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我，我歪了歪。", "en": "You touch me and I tilt."},
        {"zh": "那声音在壳里闷了一下。", "en": "The sound thuds inside my casing."},
        {"zh": "我立刻就站住。", "en": "I stand still at once."},
        {"zh": "你也跟着站住。", "en": "You too."},
        {"zh": "我们彼此对望。", "en": "We look at each other."},
        {"zh": "你慢慢往后退。", "en": "You back away slowly."},
        {"zh": "一直退到很远。", "en": "All the way to a good distance."},
        {"zh": "我才把身子放松。", "en": "Only then do I relax."},
        {"zh": "那声嘶从我壳里漏出来。", "en": "The hiss leaks out of my shell."},
        {"zh": "这一下险得很。", "en": "Far too near."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "草地那边还有一个。", "en": "There is another across the meadow."},
        {"zh": "它也在慢慢走。", "en": "It is walking slowly too."},
        {"zh": "我们两个圆影子，谁也不敢近。", "en": "We two round shadows dare not come close."},
        {"zh": "谁也不敢靠近。", "en": "Neither dares come close."},
        {"zh": "我们就这样走。", "en": "So we walk as we are."},
        {"zh": "一前一后在走。", "en": "One ahead, one behind."},
        {"zh": "都保持着距离。", "en": "Keeping the distance."},
        {"zh": "草地非常宽阔。", "en": "The meadow is wide."},
        {"zh": "够我们这样走很久。", "en": "Enough for a long walk like this."},
        {"zh": "天黑了，我们各自找地方。", "en": "At dark we each find a place."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我垂头看了看。", "en": "I lower my head and look."},
        {"zh": "这东西不算大。", "en": "This thing is not large."},
        {"zh": "我用前脚碰了一下。", "en": "I touch it with a forefoot."},
        {"zh": "它滚得很远。", "en": "It rolls away."},
        {"zh": "滚出去老远。", "en": "Quite far."},
        {"zh": "我看着它滚远，没挪脚。", "en": "I watch it roll off and don't move a foot."},
        {"zh": "弯腰会压到肚子。", "en": "Bending would press my belly."},
        {"zh": "我低头盯着，懒得弯腰。", "en": "I stare down at it, too lazy to bend."},
        {"zh": "它停在草里了。", "en": "It stops in the grass."},
        {"zh": "我扭过头走开。", "en": "I turn my head and go."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我脚下的土在轻轻发震。", "en": "The soil under my feet is trembling."},
        {"zh": "我把肚子收住。", "en": "I draw my belly in."},
        {"zh": "里面的嘶声变大了。", "en": "The hiss inside grows louder."},
        {"zh": "我用脚趾抓住地。", "en": "My toes dig into the ground."},
        {"zh": "近了，我数它的脚步。", "en": "Closer now; I count its steps."},
        {"zh": "我估了一下距离。", "en": "I judge the distance."},
        {"zh": "大约十步远。", "en": "Ten paces."},
        {"zh": "现在只剩八步。", "en": "Eight."},
        {"zh": "已经只剩六步。", "en": "Six."},
        {"zh": "它一步也没停。", "en": "It has not stopped."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直对着它。", "en": "I keep facing it."},
        {"zh": "我肚里的火药，刚装满。", "en": "My belly's just been loaded with powder."},
        {"zh": "它往右，我也转。", "en": "It goes right; so do I."},
        {"zh": "我肚里装满火药，转身费劲。", "en": "My belly full of powder, I turn slowly."},
        {"zh": "我转身不快。", "en": "I do not turn quickly."},
        {"zh": "但我一直对着。", "en": "But I keep facing it."},
        {"zh": "它绕了半个圈。", "en": "It circles halfway."},
        {"zh": "我跟着转了半圈。", "en": "I follow halfway."},
        {"zh": "我的脚在地上蹭出声。", "en": "My feet rasp on the ground."},
        {"zh": "它更害怕了。", "en": "That frightens it more."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把肚子挺到你面前。", "en": "I push my belly up against you."},
        {"zh": "那声音大得吓人。", "en": "The sound is enormous."},
        {"zh": "火光从里面冲出来。", "en": "Fire bursts out of me."},
        {"zh": "我整个被掀翻了。", "en": "I am thrown over."},
        {"zh": "在地上滚了两圈。", "en": "And roll twice."},
        {"zh": "草烧黑了一片。", "en": "A patch of grass is blackened."},
        {"zh": "我翻正身子，肚子还在嘶。", "en": "I right myself, belly still hissing."},
        {"zh": "身上少了一块。", "en": "A piece of me is gone."},
        {"zh": "剩下的还是圆的。", "en": "What remains is still round."},
        {"zh": "引信烧到头，我还在往前走。", "en": "The fuse burns to the end and I keep walking."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "土块落下，我先露引信。", "en": "Clods fall away; my fuse comes up first."},
        {"zh": "身上还挂着草根。", "en": "Grass roots still hang on me."},
        {"zh": "我站在草地上。", "en": "I stand in the meadow."},
        {"zh": "太阳亮得刺眼。", "en": "The sun is bright."},
        {"zh": "慢慢转了一圈，引线在响。", "en": "Turned slowly. The fuse hisses."},
        {"zh": "这里非常开阔。", "en": "It is open here."},
        {"zh": "实在太开阔了。", "en": "Too open."},
        {"zh": "有东西会看见我。", "en": "Something will see me."},
        {"zh": "我朝矮草那边走。", "en": "I head for the shorter grass."},
        {"zh": "我慢慢地走。", "en": "Slowly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，我肚子里的东西立刻躁动。", "en": "Fire touches me and what is inside me surges."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，撞得头晕。", "en": "I roll down the slope and my head spins."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进嘴里，我扑腾着往岸上挣。", "en": "Water floods my mouth; I thrash for the bank."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "别人的爆炸把我掀翻，我自己的还没响。", "en": "Another's blast throws me over; my own has not sounded."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的肚子。", "en": "An arrow lodges in my belly."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光压住我肚子里的东西。", "en": "Strange light presses down on what is inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不用吃，可我的皮在变薄。", "en": "I need no food, but my hide thins."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我整个人一麻。", "en": "Lightning strikes and I go numb all over."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "草地没了，我在黑里翻着坠。", "en": "The meadow is gone and I tumble through black."}
      ]
    }
  }
}
