{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着池子飞。", "en": "I circle the pool."},
        {"zh": "我身上的光在水面晃。", "en": "My light wavers on the water."},
        {"zh": "我飞得很稳，很慢。", "en": "I fly steady and slow."},
        {"zh": "我朝有人的方向滑。", "en": "I glide toward anyone there."},
        {"zh": "我在池边停一停。", "en": "I pause by the pool's edge."},
        {"zh": "我的翅膀几乎没有声音。", "en": "My wings make almost no sound."},
        {"zh": "我绕过那根石柱。", "en": "I round the stone pillar."},
        {"zh": "我沿着光的方向飞。", "en": "I fly along the light."},
        {"zh": "我在石柱之间滑过去。", "en": "I glide between the stone pillars."},
        {"zh": "我从水面上掠过。", "en": "I skim over the water."},
        {"zh": "我朝索尔阿克西斯的深处飞。", "en": "I fly deeper into Thoraxis."},
        {"zh": "我贴着水面滑出一段。", "en": "I skim a stretch across the water."},
        {"zh": "我的光把水面照白。", "en": "My light turns the water white."},
        {"zh": "我飞到你身后。", "en": "I fly behind you."},
        {"zh": "我不急着落下。", "en": "I'm in no hurry to land."},
        {"zh": "我慢慢降了下来。", "en": "I descend slowly."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在池子上面。", "en": "I hover above the pool."},
        {"zh": "我的光亮一阵灭一阵。", "en": "My light pulses."},
        {"zh": "水面非常平静。", "en": "The water is flat."},
        {"zh": "我在听水滴声。", "en": "I listen to dripping water."},
        {"zh": "我的翅膀轻轻抖。", "en": "My wings quiver softly."},
        {"zh": "我只在水面上悬着。", "en": "I'm doing nothing."},
        {"zh": "池子里有什么在动。", "en": "Something moves in the pool."},
        {"zh": "水纹把我一圈圈推开。", "en": "The ripples push me out in rings."},
        {"zh": "石壁上反射着我。", "en": "The wall reflects me."},
        {"zh": "我把翅膀张平，不动。", "en": "I spread my wings flat and hold."},
        {"zh": "只有水滴在石壁上响。", "en": "Only water drips on the stone."},
        {"zh": "我等着光再亮起。", "en": "I wait for the light."},
        {"zh": "远处传来水声。", "en": "Water sounds far off."},
        {"zh": "我绕着池心打转。", "en": "I turn in place."},
        {"zh": "空气里有湿气。", "en": "There's dampness in the air."},
        {"zh": "我又亮了一点。", "en": "I brighten a little."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你能看见我的光吗？", "en": "Can you see my light?"},
        {"zh": "我一直在这池子上。", "en": "I've always been over this pool."},
        {"zh": "你是来找东西的？", "en": "Have you come looking for something?"},
        {"zh": "这池水并不深。", "en": "This pool isn't deep."},
        {"zh": "我的光会引路。", "en": "My light shows the way."},
        {"zh": "你别伸手碰我。", "en": "Don't reach out to touch me."},
        {"zh": "我发的东西很奇怪。", "en": "What I give off is strange."},
        {"zh": "这池底没有你要的东西。", "en": "There is nothing you want at this pool's bottom."},
        {"zh": "我在这池上看了你很久。", "en": "I've watched you a while."},
        {"zh": "这地方只有我。", "en": "Only I am here."},
        {"zh": "你身上没有光。", "en": "You carry no light."},
        {"zh": "别把手伸进我的光里。", "en": "Do not put your hand into my light."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光被击得碎成几片。", "en": "My light is struck into pieces."},
        {"zh": "我的光贴着水面缓了缓。", "en": "My light sinks to the water and steadies."},
        {"zh": "这一下打到了我的翅膀。", "en": "That struck my wing."},
        {"zh": "我晃了晃又稳住。", "en": "I wobbled and steadied."},
        {"zh": "我并不算结实。", "en": "I'm not sturdy."},
        {"zh": "池水接住了一点光。", "en": "The pool caught some of my light."},
        {"zh": "我退到池子中央。", "en": "I retreat to the pool's center."},
        {"zh": "我的光要缓一缓。", "en": "My light needs to recover."},
        {"zh": "我还悬在池水上方。", "en": "I'm still here."},
        {"zh": "别再来一次了。", "en": "Not again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这池水不养这些东西。", "en": "I don't eat."},
        {"zh": "我吃的是池上的浮光。", "en": "I feed on the floating light above the pool."},
        {"zh": "你举着它想做什么？", "en": "What are you holding it up for?"},
        {"zh": "先把它放下来。", "en": "Put it down."},
        {"zh": "我要的只是光。", "en": "What I want is light."},
        {"zh": "这上面没有光。", "en": "There's no light on it."},
        {"zh": "这块你自己收着吧。", "en": "Keep it."},
        {"zh": "我根本不需要它。", "en": "I don't need it."},
        {"zh": "把它拿走好了。", "en": "Take it away."},
        {"zh": "这不合我的口味。", "en": "Not to my taste."},
        {"zh": "你换个地方放。", "en": "Put it somewhere else."},
        {"zh": "我会把它忘掉。", "en": "I'll forget it."},
        {"zh": "别在我池边放。", "en": "Don't leave it by my pool."},
        {"zh": "这里只需要水。", "en": "Only water belongs here."},
        {"zh": "你手里那点光太弱了。", "en": "That little light in your hand is too weak."},
        {"zh": "真的并不需要。", "en": "Truly, no need."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到的是我的光。", "en": "You touched my wing."},
        {"zh": "我的光微微晃了晃。", "en": "My light flickered."},
        {"zh": "我飘开了一点。", "en": "I drifted aside."},
        {"zh": "水面上起了圈。", "en": "Rings spread on the water."},
        {"zh": "你站在池子边上。", "en": "You're standing at the pool's edge."},
        {"zh": "我几乎不占地方。", "en": "I take almost no space."},
        {"zh": "你碰到的地方凉了一下。", "en": "Where you touched grows briefly cold."},
        {"zh": "这点触碰伤不到我。", "en": "That contact is nothing."},
        {"zh": "你别把我按进水里。", "en": "Don't push me into the water."},
        {"zh": "我从你手上滑开。", "en": "I slip from your hand."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只不过是一束光。", "en": "I'm only light."},
        {"zh": "这个池子不需要那些。", "en": "This pool has no need of that."},
        {"zh": "我并没有身体。", "en": "I have no body."},
        {"zh": "这问题我不明白。", "en": "I don't understand that question."},
        {"zh": "我在这待了很久。", "en": "I've been here a long while."},
        {"zh": "你从池边退开吧。", "en": "Go on."},
        {"zh": "我不会离开这池水。", "en": "I won't leave this water."},
        {"zh": "这事情不必再提。", "en": "Don't mention it."},
        {"zh": "这池水不需要这些。", "en": "I need nothing."},
        {"zh": "别打扰这片静。", "en": "Don't disturb this quiet."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我照着它看了看。", "en": "I cast light on it."},
        {"zh": "它把光都反出来了。", "en": "It's glowing."},
        {"zh": "我根本抬不动它。", "en": "I can't lift it."},
        {"zh": "它并不属于我。", "en": "It isn't mine."},
        {"zh": "这个我能拖一点。", "en": "I can drag it a little."},
        {"zh": "它掉进池里了。", "en": "It fell into the pool."},
        {"zh": "我把它推回岸上。", "en": "I push it back to the shore."},
        {"zh": "我记不清它的样子。", "en": "I can't recall its shape."},
        {"zh": "就留在水里吧。", "en": "Leave it in the water."},
        {"zh": "你把它捡起来。", "en": "You pick it up."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人走进池边了。", "en": "Someone has come to the pool."},
        {"zh": "我朝他那边转。", "en": "I turn toward him."},
        {"zh": "我的光凝成一团。", "en": "My light gathers into a ball."},
        {"zh": "我的光凝在你头顶上方。", "en": "My light gathers above your head."},
        {"zh": "我把光聚成一小团。", "en": "I draw my light into a small ball."},
        {"zh": "你先站着别动。", "en": "Stand still first."},
        {"zh": "我正在瞄准目标。", "en": "I'm taking aim."},
        {"zh": "光会从上面落下。", "en": "The light falls from above."},
        {"zh": "别退进池子里。", "en": "Don't back into the pool."},
        {"zh": "就趁这一刻吧。", "en": "Now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光落在你肩上，很轻。", "en": "My light rests lightly on your shoulder."},
        {"zh": "我的光一直在你身上。", "en": "My light stays on you."},
        {"zh": "你在下面走，我跟着。", "en": "I follow wherever you go."},
        {"zh": "池水反着我的光。", "en": "The pool reflects my light."},
        {"zh": "我再凝聚一团。", "en": "I gather another one."},
        {"zh": "池面把光反到你眼睛里。", "en": "The pool throws my light into your eyes."},
        {"zh": "你开始找地方躲。", "en": "You're looking for cover."},
        {"zh": "这附近没有遮挡。", "en": "There's none nearby."},
        {"zh": "我一点点往上。", "en": "I inch upward."},
        {"zh": "光弹在我手边。", "en": "The light bolt is at my side."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "光弹打在你脚边。", "en": "A light bolt hits at your feet."},
        {"zh": "另一团打在你的肩。", "en": "Another hits your shoulder."},
        {"zh": "你被晃得睁不开眼。", "en": "You can't open your eyes."},
        {"zh": "我退到池子上方。", "en": "I retreat above the pool."},
        {"zh": "我的光又亮了。", "en": "My light flares again."},
        {"zh": "你身上的影子被拉长。", "en": "Your shadow stretches long."},
        {"zh": "光弹在你脚边炸开。", "en": "A light bolt bursts at your feet."},
        {"zh": "这一发只是警告。", "en": "That shot was only a warning."},
        {"zh": "但你闯进来了。", "en": "But you came in."},
        {"zh": "我还会再发一次。", "en": "I'll fire again."}
      ]
    },
