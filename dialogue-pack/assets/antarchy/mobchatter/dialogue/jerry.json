{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一边爬一边念叨。", "en": "I mutter as I crawl."},
        {"zh": "我的腿敲着石面。", "en": "My legs tap the stone."},
        {"zh": "我跟在虫潮后头。", "en": "I follow the swarm."},
        {"zh": "我走过的地方有响声。", "en": "I leave noise wherever I pass."},
        {"zh": "我踩着同伴的背走。", "en": "I walk over my companions' backs."},
        {"zh": "我朝你那边挪。", "en": "I shift toward you."},
        {"zh": "我的身体一节一节的。", "en": "My body comes in segments."},
        {"zh": "我绕到你脚后，嘴一直没停。", "en": "I circle behind your feet, mouth never stopping."},
        {"zh": "我不怕被看见。", "en": "I don't mind being seen."},
        {"zh": "我往前挤了一点。", "en": "I crowd a little forward."},
        {"zh": "我一边走一边说。", "en": "I talk while walking."},
        {"zh": "我往虫潮里钻。", "en": "I burrow into the swarm."},
        {"zh": "我从石头下面爬出来。", "en": "I crawl from under the stone."},
        {"zh": "我把肚皮压低，从石缝底下钻过。", "en": "I flatten my belly and squeeze under the rock seam."},
        {"zh": "我挤开了两只同伴。", "en": "I shoved two kin aside."},
        {"zh": "我这张嘴一直不停。", "en": "I never stop talking."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲着磨口器。", "en": "I crouch and grind my mouthparts."},
        {"zh": "我在自言自语。", "en": "I'm talking to myself."},
        {"zh": "我用触角敲了敲身边同伴的壳。", "en": "I tap my antennae on the shell of the kin beside me."},
        {"zh": "我蹲着磨我的口器。", "en": "I'm doing nothing."},
        {"zh": "我在看虫潮的方向。", "en": "I watch where the swarm goes."},
        {"zh": "我的触须晃来晃去。", "en": "My antennae swing about."},
        {"zh": "我数着身边的人。", "en": "I count those around me."},
        {"zh": "这里的地很干。", "en": "The ground is dry here."},
        {"zh": "我又开始说了。", "en": "I've started talking again."},
        {"zh": "风把我的声音吹散。", "en": "Wind scatters my voice."},
        {"zh": "我渐渐把嘴闭上了。", "en": "I gradually fall quiet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你听见我在说什么吗？", "en": "Did you catch what I said?"},
        {"zh": "我一直在讲，你没听。", "en": "I've been talking; you weren't listening."},
        {"zh": "你站在这片地上。", "en": "You're standing on this ground."},
        {"zh": "虫潮会过来的。", "en": "The swarm will come."},
        {"zh": "我只是先说两句。", "en": "I'm just saying a few words first."},
        {"zh": "你看看我的腿。", "en": "Look at my legs."},
        {"zh": "我比你想的结实。", "en": "I'm tougher than you think."},
        {"zh": "我喋喋不休，停不下来。", "en": "I chatter and cannot stop."},
        {"zh": "我仰起头，口器还沾着石粉。", "en": "I tilt my head up, stone dust still on my mouthparts."},
        {"zh": "我说完这些话了。", "en": "I'm finished talking."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打断了一下。", "en": "That interrupted me."},
        {"zh": "我的甲裂了，嘴里还在嘟囔。", "en": "My shell splits, and I am still muttering."},
        {"zh": "壳凹了一块，我还爬得动。", "en": "My shell is dented; I can still crawl."},
        {"zh": "这点伤碍不着我爬。", "en": "This wound is nothing."},
        {"zh": "我一边疼一边说。", "en": "I complain while in pain."},
        {"zh": "血抹在青石上了。", "en": "Blood on the stone."},
        {"zh": "我已经记住你。", "en": "I remember you."},
        {"zh": "我这副身子断了，还能爬。", "en": "Cut apart, and I still crawl."},
        {"zh": "你再踩一脚看看。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西啃得动吗？", "en": "Can this be eaten?"},
        {"zh": "我什么都往嘴里塞。", "en": "I'm not picky."},
        {"zh": "你放下，我过来。", "en": "Set it down; I'll come."},
        {"zh": "这么一点塞不住牙。", "en": "That's far too little."},
        {"zh": "虫潮会先赶到那里。", "en": "The swarm will get there first."},
        {"zh": "这个味道一般。", "en": "The smell is so-so."},
        {"zh": "我这副壳，对食物没兴趣。", "en": "With this shell, food does not interest me."},
        {"zh": "还有别的东西吗？", "en": "Is there anything else?"},
        {"zh": "把它递过来吧。", "en": "Hand it over."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我的腿踩住了。", "en": "You stepped on my leg."},
        {"zh": "我的尖叫在石缝里来回撞。", "en": "My screech bounces back and forth in the crevice."},
        {"zh": "我从你脚下爬出来。", "en": "I crawl out from under your foot."},
        {"zh": "我滚下石阶，腿还在乱划。", "en": "I tumble down the stone steps, legs flailing."},
        {"zh": "你别往这边挤。", "en": "Don't crowd me."},
        {"zh": "虫潮里，我话最多。", "en": "In the swarm, I talk the most."},
        {"zh": "我的壳还算硬。", "en": "My shell is fairly hard."},
        {"zh": "我绕开你走过去。", "en": "I go around you."},
        {"zh": "我说过别挤我。", "en": "I said don't crowd."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在忙着说话。", "en": "I'm busy talking."},
        {"zh": "虫潮里有的是同类。", "en": "The swarm is full of my kind."},
        {"zh": "你并不太合适。", "en": "You're not suitable."},
        {"zh": "我在等新的卵。", "en": "I'm waiting on a new brood."},
        {"zh": "这个我还不懂。", "en": "I don't understand this."},
        {"zh": "你别打断我说话。", "en": "Don't interrupt me."},
        {"zh": "我现在正忙着。", "en": "I'm busy."},
        {"zh": "你从这片石头退开。", "en": "Move along."},
        {"zh": "这事情以后谈吧。", "en": "Later."},
        {"zh": "你别再打听下去。", "en": "Don't ask."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这石头底下是什么？", "en": "What's this?"},
        {"zh": "我用嘴叼着它走。", "en": "I carry it in my jaws."},
        {"zh": "这玩意儿挺沉的。", "en": "Fairly heavy."},
        {"zh": "这东西嚼起来费劲。", "en": "Not food."},
        {"zh": "这玩意儿是 Jerry Nucleus 吗？", "en": "Is this a Jerry Nucleus?"},
        {"zh": "我把它塞给同伴。", "en": "I hand it to a companion."},
        {"zh": "这块肉早就不新鲜。", "en": "Not much use."},
        {"zh": "就放在地面上。", "en": "Leave it on the ground."},
        {"zh": "这是谁掉下的东西？", "en": "Who dropped it?"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "这边有人站着。", "en": "Someone's here."},
        {"zh": "我先喊上一声。", "en": "First I shout."},
        {"zh": "虫潮听到我了。", "en": "The swarm heard me."},
        {"zh": "这个距离不远。", "en": "The distance isn't far."},
        {"zh": "我一边说一边靠近。", "en": "I talk while approaching."},
        {"zh": "你就把脚钉在石上。", "en": "Stand still."},
        {"zh": "趁石头还没被踩热。", "en": "Now."},
        {"zh": "我要咬你的脚。", "en": "I bite your foot."},
        {"zh": "你别想跑开了。", "en": "Don't run."},
        {"zh": "我们数量很多。", "en": "We're many."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直跟着你走。", "en": "I keep following you."},
        {"zh": "我边跟边念叨。", "en": "I mutter as I trail you."},
        {"zh": "同伴也在靠近。", "en": "My kin are closing too."},
        {"zh": "石头缝里全是腿。", "en": "Legs in every crack."},
        {"zh": "你听见那沙沙声吗？", "en": "Listen to that sound."},
        {"zh": "你踩碎最后一块青石，虫潮就围上来。", "en": "You crush the last slab of stone, and the swarm closes in."},
        {"zh": "再走一步就好。", "en": "One more step."},
        {"zh": "我给你让条路。", "en": "I'll give you a path."},
        {"zh": "不行，我不让开。", "en": "No, I won't."},
        {"zh": "我又改主意了。", "en": "I changed my mind again."},
        {"zh": "这个位置不错。", "en": "This spot is good."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住你的鞋。", "en": "I bite your boot."},
        {"zh": "我爬上你的腿。", "en": "I climb your leg."},
        {"zh": "我撕开一道口。", "en": "I tear an opening."},
        {"zh": "我一扯就掉下来。", "en": "One pull and I'm off."},
        {"zh": "我又爬回它身上。", "en": "I'm back on."},
        {"zh": "我这一下不重。", "en": "This bite isn't heavy."},
        {"zh": "但你很多地方都露着。", "en": "But you have a lot exposed."},
        {"zh": "虫潮压过来，你挡不住的。", "en": "The swarm rolls in — you can't hold it back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石缝里挤出来了。", "en": "I come out of the crack."},
        {"zh": "我先清了下嗓子。", "en": "First I clear my throat."},
        {"zh": "同伴们都已经到了。", "en": "My kin have arrived."},
        {"zh": "我开始说起来了。", "en": "I begin talking."},
        {"zh": "太阳晒得有点猛。", "en": "The sun is a bit strong."},
        {"zh": "我数了数我们。", "en": "I counted us."},
        {"zh": "这里能躲一躲。", "en": "Good cover here."},
        {"zh": "我沿着地面往前爬。", "en": "I crawl forward."},
        {"zh": "先溜去啃点石头。", "en": "First find some food."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的腿，我跳起来。", "en": "Fire caught my leg; I leapt."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石头上掉下去，翻了几圈。", "en": "I fell off the stone and tumbled."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从口器里灌进去。", "en": "Water floods my mouthparts."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀进虫潮里。", "en": "The blast threw me into the swarm."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过我的甲。", "en": "Something pierced my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我说不出话。", "en": "That force left me speechless."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我没力气念叨。", "en": "Too hungry to mutter."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把石头照得发白。", "en": "The flash lit the whole stone."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "石头下面没有底。", "en": "No bottom under the stone."}
      ]
    }
  }
}
