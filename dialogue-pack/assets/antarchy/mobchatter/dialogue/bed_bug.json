{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着床脚往上爬。", "en": "I climb the bedpost."},
        {"zh": "我的身体是扁的，很薄。", "en": "My body is flat, very thin."},
        {"zh": "我钻进床板的缝里。", "en": "I slip into a crack in the boards."},
        {"zh": "里面很暗，很暖。", "en": "Dark and warm inside."},
        {"zh": "我从这头爬到那头。", "en": "I crawl from one end to the other."},
        {"zh": "我们一群藏在床缝里，等你躺下。", "en": "We hide in the bed seam until you lie down."},
        {"zh": "被子下面有热气。", "en": "Heat under the blanket."},
        {"zh": "我贴着木纹横着走。", "en": "I walk sideways along the grain."},
        {"zh": "我停下来，等一会儿。", "en": "I stop and wait a while."},
        {"zh": "然后又继续往前。", "en": "Then continue."},
        {"zh": "地板上有几粒碎屑。", "en": "A few crumbs on the floor."},
        {"zh": "我从旁边绕开了。", "en": "I go around."},
        {"zh": "有更近的在床上。", "en": "Something closer is on the bed."},
        {"zh": "我爬得快了一些。", "en": "I crawl a little faster."},
        {"zh": "我的脚几乎不响。", "en": "My feet make almost no sound."},
        {"zh": "我爬到了床沿。", "en": "I reach the bed's edge."},
        {"zh": "我停下来看着。", "en": "I stop and look."},
        {"zh": "那里有东西在呼吸。", "en": "Something is breathing there."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我藏在缝里，只露一点。", "en": "I hide in the crack, barely showing."},
        {"zh": "我们一群挤在床缝里。", "en": "We crowd into the seams of the bed."},
        {"zh": "我不喜欢亮光。", "en": "I do not like light."},
        {"zh": "我朝更深处退。", "en": "I retreat deeper."},
        {"zh": "木头有旧的味道。", "en": "The wood smells old."},
        {"zh": "我在缝里数着脚步。", "en": "In the crack, I count the footsteps."},
        {"zh": "我的触角慢慢动。", "en": "My antennae move slowly."},
        {"zh": "我听见上面的呼吸。", "en": "I hear breathing above."},
        {"zh": "很慢，也很沉。", "en": "Slow and deep."},
        {"zh": "他已经睡着了。", "en": "He is asleep."},
        {"zh": "我挪到被角下面。", "en": "I move under the corner of the quilt."},
        {"zh": "床架晃了，我缩回去。", "en": "The frame shifts; I shrink back."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你掀开被子，我就在那儿。", "en": "You throw back the blanket and I am there."},
        {"zh": "我比你的指甲还小。", "en": "I am smaller than your nail."},
        {"zh": "你不一定看得见。", "en": "You may not even see me."},
        {"zh": "我紧贴着床板。", "en": "I press to the boards."},
        {"zh": "你的手过来了。", "en": "Your hand comes over."},
        {"zh": "我一缩，钻回缝里。", "en": "I shrink and slip back into the crack."},
        {"zh": "你在外面找着。", "en": "You search outside."},
        {"zh": "我已经在里面了。", "en": "I am already inside."},
        {"zh": "你根本找不到。", "en": "You will not find me."},
        {"zh": "我把头探出来一点。", "en": "I put my head out a little."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我压扁自己，贴紧木头。", "en": "I flatten myself against the wood."},
        {"zh": "断了一条腿。", "en": "One leg is broken."},
        {"zh": "我还能爬动。", "en": "I can still crawl."},
        {"zh": "只是慢下来了。", "en": "Only slowly."},
        {"zh": "我朝缝里退去。", "en": "I retreat into the crack."},
        {"zh": "木头挡住我一半。", "en": "The wood shields half of me."},
        {"zh": "我躲在里面等。", "en": "I hide inside and wait."},
        {"zh": "等到安静下来。", "en": "For it to go quiet."},
        {"zh": "然后我才敢动。", "en": "Then I move."},
        {"zh": "伤口会被压住。", "en": "The wound will be pressed shut."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一群，藏在床板下。", "en": "We hide in a swarm under the bed."},
        {"zh": "我从缝里出来了。", "en": "I come out of the crack."},
        {"zh": "沿着床单往上爬。", "en": "I climb the sheet."},
        {"zh": "我的身体还是扁的。", "en": "My body stays flat."},
        {"zh": "快到的时候我停了。", "en": "I stop when near."},
        {"zh": "先等上一会儿。", "en": "Wait a while first."},
        {"zh": "我听见上面的呼吸变沉。", "en": "I hear the breathing above grow heavy."},
        {"zh": "现在时机到了。", "en": "The moment is here."},
        {"zh": "我一下落下去。", "en": "I drop."},
        {"zh": "动作非常快。", "en": "Very quickly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的手指碰到我。", "en": "Your finger touches me."},
        {"zh": "我被推得翻了身。", "en": "I am rolled over."},
        {"zh": "我立刻翻回来。", "en": "I right myself at once."},
        {"zh": "钻到床板下面。", "en": "And slip under the boards."},
        {"zh": "那里你够不到。", "en": "You cannot reach there."},
        {"zh": "我一点一点爬。", "en": "I crawl an inch at a time."},
        {"zh": "灰落进我的关节缝。", "en": "Dust settles into my joints."},
        {"zh": "我把灰抖干净。", "en": "I shake the dust off."},
        {"zh": "然后又扁回去。", "en": "And flatten again."},
        {"zh": "这样就看不出了。", "en": "Now I cannot be seen."},
        {"zh": "我从床单的褶里翻出来。", "en": "I tumble out of a fold in the sheet."},
        {"zh": "又钻回褶里去。", "en": "And slip back into it."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "床板缝里还有一只。", "en": "There is another in the board crack."},
        {"zh": "我闻到床板背面那股味。", "en": "I smell the scent under the boards."},
        {"zh": "我循着那股味摸过去。", "en": "I follow that scent to it."},
        {"zh": "我们并排贴着木头。", "en": "We lie side by side against the wood."},
        {"zh": "我们的脚挤在一道缝里。", "en": "Our legs crowd into one crack."},
        {"zh": "然后一起往里走。", "en": "Then we go deeper in together."},
        {"zh": "这条缝很长。", "en": "This crack is long."},
        {"zh": "够我们两个住。", "en": "Enough for two of us."},
        {"zh": "天亮了也看不见我们。", "en": "Even by daylight we are not seen."},
        {"zh": "我们就在里面待着。", "en": "We stay inside."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "床上的虫，慢慢爬过去。", "en": "The bed bug creeps slowly over."},
        {"zh": "我六只脚圈住这点碎屑。", "en": "Six legs close around the crumb."},
        {"zh": "比我还要大。", "en": "Bigger than I am."},
        {"zh": "我一点推不动。", "en": "I cannot move it."},
        {"zh": "我在它上面爬了一圈。", "en": "I crawl a circle over it."},
        {"zh": "我啃了两口，吐出来。", "en": "I gnaw twice and spit it out."},
        {"zh": "我又爬回床脚。", "en": "I crawl back to the bedpost."},
        {"zh": "我顺着床脚爬。", "en": "And climb."},
        {"zh": "然后回到缝里。", "en": "Back into the crack."},
        {"zh": "那里才是我的地方。", "en": "That is my place."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有股热气靠近。", "en": "Heat comes near."},
        {"zh": "我从缝里探出触角。", "en": "I put my antennae out of the crack."},
        {"zh": "暖烘烘的一片。", "en": "Warm and close."},
        {"zh": "而且动得很慢。", "en": "And slow."},
        {"zh": "我顺着床单的褶往上。", "en": "I climb along a fold in the sheet."},
        {"zh": "沿着床板边缘。", "en": "Along the edge of the boards."},
        {"zh": "热气就在我头前面。", "en": "The warmth is right before my head."},
        {"zh": "我一直朝它去。", "en": "I keep heading for it."},
        {"zh": "我的脚没有声音。", "en": "My feet make no sound."},
        {"zh": "近得就在眼前。", "en": "Right before me."},
        {"zh": "我把脚停住。", "en": "I halt my feet."},
        {"zh": "等它再慢一点。", "en": "Wait for it to slow more."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴在被子上。", "en": "I press against the blanket."},
        {"zh": "一点点往前挪。", "en": "Inching forward."},
        {"zh": "它的呼吸就在下面。", "en": "Its breathing is right below."},
        {"zh": "我跟着那个起伏。", "en": "I move with the rise and fall."},
        {"zh": "它翻了个身。", "en": "It turns over."},
        {"zh": "我马上就停下。", "en": "I stop at once."},
        {"zh": "它没有压到我。", "en": "It does not crush me."},
        {"zh": "我又开始往前挪。", "en": "I begin to move again."},
        {"zh": "被子被我顶起一点。", "en": "The blanket lifts a little over me."},
        {"zh": "我赶快钻进去。", "en": "I hurry under."},
        {"zh": "里面更加暖。", "en": "It is warmer in here."},
        {"zh": "我沿着腿的方向走。", "en": "I follow the line of a leg."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扎进皮肤，吸了一口。", "en": "I pierce the skin and take a sip."},
        {"zh": "很轻的一小口。", "en": "A very small bite."},
        {"zh": "它翻了个身，没被我弄醒。", "en": "It rolls over, not woken by me."},
        {"zh": "臭虫成群，退了也是围上来。", "en": "Bed bugs swarm. Backing off only brings them closer."},
        {"zh": "再稍等上一刻。", "en": "A moment more."},
        {"zh": "血的味道出来了。", "en": "The taste of blood comes."},
        {"zh": "我又爬了回去。", "en": "I return."},
        {"zh": "这次咬得更久。", "en": "This time I hold longer."},
        {"zh": "臭虫成群，退了也围上来。", "en": "Bed bugs swarm; retreating only brings them back."},
        {"zh": "我吃得太饱了。", "en": "Too full."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从床板的缝里钻出来。", "en": "I come out of the board crack."},
        {"zh": "这里是一间卧室。", "en": "This is a bedroom."},
        {"zh": "木头、布、还有人的味道。", "en": "Wood, cloth, and the smell of people."},
        {"zh": "我沿着床脚爬。", "en": "I climb the bedpost."},
        {"zh": "上面铺着被子。", "en": "A blanket lies on top."},
        {"zh": "我钻到被子下面。", "en": "I get under it."},
        {"zh": "这里非常暖。", "en": "It is warm here."},
        {"zh": "我钻进床脚的裂缝。", "en": "I slip into the crack by the bedpost."},
        {"zh": "等着夜深下来。", "en": "And wait for deep night."},
        {"zh": "那时人才睡得沉。", "en": "Then people sleep deepest."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热一逼，我的身体就干瘪了。", "en": "The heat shrivels my body at once."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从床上掉下来，落地时翻了个身。", "en": "I fall off the bed and land on my back."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我泡住，我蹬不动腿。", "en": "Water soaks me and my legs will not work."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "墙根震塌了，我翻进去。", "en": "The wall base crumbles; I tumble in."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根木刺穿过我的身体。", "en": "A splinter passes through my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光落下来，我动不了。", "en": "Strange light falls and I cannot move."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "好久没喝到血，我的肚子瘪了。", "en": "No blood for a long while; my belly is flat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下，我六条腿一僵。", "en": "Lightning falls and my six legs stiffen."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "床没了，我在黑里往下掉。", "en": "The bed is gone and I fall through black."}
      ]
    }
  }
}
