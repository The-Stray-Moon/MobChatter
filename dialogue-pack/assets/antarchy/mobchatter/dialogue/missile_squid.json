{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用喷口推着自己走。", "en": "I push myself along with my siphon."},
        {"zh": "我的鳍在深水里扇。", "en": "My fins beat in the deep water."},
        {"zh": "我身边的水很冷。", "en": "The water beside me is cold."},
        {"zh": "我朝着深处滑行。", "en": "I glide toward the depths."},
        {"zh": "我的触腕收成一束。", "en": "My arms gather into a bundle."},
        {"zh": "我从海沟上方游过。", "en": "I swim over the trench."},
        {"zh": "我的身体像一枚弹头。", "en": "My body is shaped like a warhead."},
        {"zh": "深海的蓝里我看不清远。", "en": "In the deep blue I can't see far."},
        {"zh": "我顺着寒流走。", "en": "I ride the cold current."},
        {"zh": "水压把我的形状压紧了。", "en": "The pressure keeps my shape tight."},
        {"zh": "我改变方向，很慢。", "en": "I change course slowly."},
        {"zh": "我斜着下沉了一截。", "en": "I sink obliquely."},
        {"zh": "有一只被射出去过。", "en": "One of us was fired once."},
        {"zh": "我贴着海床滑。", "en": "I skim the seabed."},
        {"zh": "我的影子在海底很小。", "en": "My shadow on the bottom is small."},
        {"zh": "我又回到水层中间。", "en": "I return to mid-water."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我一动不动地挂在冷水里", "en": "I hang motionless in the cold water."},
        {"zh": "我的触腕慢慢展开。", "en": "My arms unfold slowly."},
        {"zh": "深海里只有我自己的水声", "en": "Down here there's only the sound of my own water."},
        {"zh": "气泡从我腕间往上跑", "en": "Bubbles race up from between my arms."},
        {"zh": "我的身体有一点温热。", "en": "My body is slightly warm."},
        {"zh": "我在等猎物游过来。", "en": "I wait for prey to swim by."},
        {"zh": "我把侧鳍贴回身侧", "en": "I fold my side fins back against my body."},
        {"zh": "头顶的光很远。", "en": "The light overhead is far."},
        {"zh": "我慢慢转动身体。", "en": "I turn slowly."},
        {"zh": "我的喷口一开一合。", "en": "My siphon opens and closes."},
        {"zh": "我在等远处的水压变一下", "en": "I wait for the pressure far off to shift."},
        {"zh": "我沉到石缝边上。", "en": "I settle by a rock crevice."},
        {"zh": "我的皮褪成深海的黑紫", "en": "My skin fades to deep-sea purple-black."},
        {"zh": "深处传来闷响。", "en": "A dull sound comes from the depth."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也潜到这么深。", "en": "You dived this deep too."},
        {"zh": "我的触腕比看起来长。", "en": "My arms are longer than they look."},
        {"zh": "我在这里等猎物。", "en": "I wait for prey here."},
        {"zh": "你身上的气泡很亮。", "en": "Your bubbles are bright."},
        {"zh": "我的身体朝你转。", "en": "My body turns toward you."},
        {"zh": "这片水属于我。", "en": "This water belongs to me."},
        {"zh": "我身体很硬，像石头。", "en": "My body is hard as stone."},
        {"zh": "你听见水压的声音了吗？", "en": "Do you hear the pressure?"},
        {"zh": "我没有眼睛那样的小东西。", "en": "I don't have anything as small as eyes."},
        {"zh": "我悬在你头顶的水里", "en": "I hang in the water above your head."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我往下一沉。", "en": "I sink a little."},
        {"zh": "一条触腕松了。", "en": "One arm falls loose."},
        {"zh": "我的壳上多了一道。", "en": "A mark appears on my shell."},
        {"zh": "我吐出一股水雾。", "en": "I blow out a puff of mist."},
        {"zh": "血在我周围散开。", "en": "Blood spreads around me."},
        {"zh": "我沉下去一段。", "en": "I sink a stretch."},
        {"zh": "我翻正身子，触腕向后收", "en": "I right myself and pull my arms back."},
        {"zh": "壳裂了一点，我还能游", "en": "My shell is cracked; I can still swim."},
        {"zh": "我盯着你的动作。", "en": "I watch your movement."},
        {"zh": "我还在水里。", "en": "I'm still in the water."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有鱼鳞味。", "en": "Fish scales in the water."},
        {"zh": "你把它沉下来。", "en": "Let it sink."},
        {"zh": "血味顺着水来。", "en": "Blood comes with the current."},
        {"zh": "我的触腕已经伸出去了。", "en": "My arms are already out."},
        {"zh": "这点塞不住牙。", "en": "Not worth a bite."},
        {"zh": "我把它卷住。", "en": "I coil around it."},
        {"zh": "别拉，会撕破。", "en": "Don't pull; it'll tear."},
        {"zh": "我把触腕收回。", "en": "I draw my arms back."},
        {"zh": "这点肉很嫩。", "en": "This meat is tender."},
        {"zh": "底下还有吗？", "en": "Any more down there?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我的触腕。", "en": "You touched one of my arms."},
        {"zh": "我立刻收回来。", "en": "I pull it back at once."},
        {"zh": "我们的腕把水搅成一片浑", "en": "Our arms churn the water into a blur."},
        {"zh": "我的身体撞到你，很硬。", "en": "My body hits you; it's hard."},
        {"zh": "你被推开了。", "en": "You're pushed aside."},
        {"zh": "我停在原处，等她过去", "en": "I hold where I am and let her pass."},
        {"zh": "气泡从我们之间升起。", "en": "Bubbles rise between us."},
        {"zh": "我的鳍扫过你的腿。", "en": "My fin sweeps your leg."},
        {"zh": "我慢慢退下去。", "en": "I withdraw slowly."},
        {"zh": "水把我们推开又合拢", "en": "The water pushes us apart, then closes."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只也在水层里。", "en": "Another hangs in the water layer."},
        {"zh": "我们的触腕缠在一起。", "en": "Our arms twine together."},
        {"zh": "她比我还硬。", "en": "She's harder than I am."},
        {"zh": "我跟着她往海沟底沉", "en": "I sink with her toward the trench floor."},
        {"zh": "海沟下面有石缝。", "en": "There are crevices below the trench."},
        {"zh": "她把卵塞进石缝，我守着", "en": "She tucks the eggs into a crack; I keep watch."},
        {"zh": "我贴着她守了一整夜", "en": "I stay close beside her all night."},
        {"zh": "水压把我们压得很近。", "en": "The pressure holds us close."},
        {"zh": "她慢慢升上去。", "en": "She rises slowly."},
        {"zh": "我跟着她走。", "en": "I follow her."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把那块卷起来。", "en": "I curl around it."},
        {"zh": "它从我腕间直往下坠", "en": "It drops straight down out of my arms."},
        {"zh": "我用触腕夹住。", "en": "I hold it with an arm."},
        {"zh": "我咬出来一块海底石", "en": "I bite loose a piece of seafloor stone."},
        {"zh": "我松开腕，让它沉回去", "en": "I let go and it sinks back down."},
        {"zh": "有一块鱼骨。", "en": "There's a fish bone."},
        {"zh": "我把它收进腕间。", "en": "I tuck it among my arms."},
        {"zh": "它轻得像气泡。", "en": "It's light as a bubble."},
        {"zh": "我用喙磕了它一下", "en": "I tap it once with my beak."},
        {"zh": "它在我喙间散成碎末", "en": "It crumbles to bits between my beak."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有动静。", "en": "Something moved in the water."},
        {"zh": "我掉转身体。", "en": "I turn my body around."},
        {"zh": "我的触腕张开了。", "en": "My arms spread."},
        {"zh": "它只有我一半那么长", "en": "It's barely half my length."},
        {"zh": "我在它的上方。", "en": "I'm above it."},
        {"zh": "水压帮我压住它。", "en": "The pressure helps pin it."},
        {"zh": "我收拢触腕，往下压", "en": "I draw my arms in and press downward."},
        {"zh": "它没察觉水动。", "en": "It hasn't felt the water move."},
        {"zh": "我的触腕已经过去了。", "en": "My arms have already gone out."},
        {"zh": "我不打算给它机会", "en": "I don't mean to give it a chance."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着水跟下去。", "en": "I follow down through the water."},
        {"zh": "它往岸边去。", "en": "It's heading for the shore."},
        {"zh": "我在它后面。", "en": "I'm behind it."},
        {"zh": "我的鳍一直扇着。", "en": "My fins keep beating."},
        {"zh": "我尝到水里多了金属味", "en": "I taste metal that wasn't in the water before."},
        {"zh": "它开始往上游。", "en": "It's swimming upward."},
        {"zh": "我也浮上去。", "en": "I rise too."},
        {"zh": "它撞到礁石。", "en": "It hit the reef."},
        {"zh": "它忽然停下。", "en": "It suddenly stops."},
        {"zh": "距离非常近了。", "en": "The distance is very short."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一卷，它动不了。", "en": "I coil; it can't move."},
        {"zh": "喙咬进它的肉。", "en": "My beak bites into flesh."},
        {"zh": "水被血染开。", "en": "Blood spreads in the water."},
        {"zh": "它挣了几下。", "en": "It struggles a few times."},
        {"zh": "我缠住它，往海沟底下拖", "en": "I wrap it and drag it down the trench."},
        {"zh": "海床上有声音。", "en": "There's a sound on the seabed."},
        {"zh": "我松开了触腕。", "en": "I release my arms."},
        {"zh": "剩下的沉下去。", "en": "What's left sinks."},
        {"zh": "我掉头往上游。", "en": "I turn and rise."},
        {"zh": "气泡往上升。", "en": "Bubbles rise."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "深水里多了一片暗。", "en": "A shadow appears in the deep."},
        {"zh": "我从水层下面浮上来。", "en": "I rise from below the layer."},
        {"zh": "冷水的味道很清楚。", "en": "The cold water tastes clear."},
        {"zh": "我的鳍先动。", "en": "My fins move first."},
        {"zh": "这里的海沟很深。", "en": "The trench here is deep."},
        {"zh": "我调整了一下方向。", "en": "I adjusted my heading."},
        {"zh": "我的身体在压力里很稳。", "en": "My body holds steady under pressure."},
        {"zh": "有鱼群在远处。", "en": "A school of fish is far off."},
        {"zh": "我掉头往鱼群那边游", "en": "I turn and swim toward the school of fish."},
        {"zh": "我抬头，水面透下一点光", "en": "I look up; a little light comes down through the surface."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水里也烫，我的触腕缩了。", "en": "Even here it burns; my arms retract."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在硬地上，触腕摊开。", "en": "I hit hard ground, arms splayed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水压忽然大得撑不住。", "en": "The pressure suddenly overwhelms me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把水推成一圈，我被卷了。", "en": "The blast pushes the water in a ring; I'm caught."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根利钩卡在我腕间。", "en": "A hook lodges in my arm."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "水流忽然不听我使唤。", "en": "The water stops obeying me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我空得连腕都抬不动。", "en": "Too empty to lift an arm."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电流窜进水里，我的腕全直了", "en": "Current floods the water; all my arms go rigid."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里干得我鳃都张不开", "en": "It's so dry here my gills won't open."}
      ]
    }
  }
}
