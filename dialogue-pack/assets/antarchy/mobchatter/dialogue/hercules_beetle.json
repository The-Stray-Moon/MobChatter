{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我六条腿压过灌木。", "en": "Six legs crush through the shrubs."},
        {"zh": "我的角比树干还粗。", "en": "My horn is thicker than a trunk."},
        {"zh": "我一路推平草丛。", "en": "I flatten the grass as I go."},
        {"zh": "我推着土坡一路往上。", "en": "I push my way up the earthen slope."},
        {"zh": "我的壳在阳光下很硬。", "en": "My shell is hard in the sun."},
        {"zh": "我一步一步推过去。", "en": "I push forward step by step."},
        {"zh": "脚下的土被我拱开。", "en": "I plow the soil aside."},
        {"zh": "我一步一坑，走得慢。", "en": "A pit per step; I move slowly."},
        {"zh": "我转个身要推开一片草。", "en": "Turning pushes a patch of grass down."},
        {"zh": "我从树根中间硬挤过去。", "en": "I force through the roots."},
        {"zh": "我走到哪都留下沟。", "en": "I leave a furrow wherever I go."},
        {"zh": "我慢慢爬上土坡。", "en": "I climb the earthen slope."},
        {"zh": "我用角顶开石头。", "en": "I shove a stone aside with my horn."},
        {"zh": "我的身体有一格多长。", "en": "My body is more than a block long."},
        {"zh": "我朝领地边上巡。", "en": "I patrol the territory's edge."},
        {"zh": "挡路的我都直接顶开。", "en": "I don't need to go around."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在树根旁。", "en": "I rest by the tree roots."},
        {"zh": "我的角抵着土。", "en": "My horn rests against the soil."},
        {"zh": "我的触角贴着土，没动。", "en": "My antennae touch the soil, still."},
        {"zh": "我的口器在磨。", "en": "My mouthparts grind."},
        {"zh": "阳光把壳晒热了。", "en": "Sun warms my shell."},
        {"zh": "我保持着一动不动。", "en": "I keep still."},
        {"zh": "附近的草还在晃。", "en": "The grass nearby is still swaying."},
        {"zh": "我慢慢抬起前腿。", "en": "I lift a foreleg slowly."},
        {"zh": "草叶那边有东西动。", "en": "Something moves far off."},
        {"zh": "我伏在树根旁不响。", "en": "I'm doing nothing."},
        {"zh": "我的翅膀收在壳下。", "en": "My wings are folded under the shell."},
        {"zh": "我等它自己过来。", "en": "I wait for it to come."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我领地上。", "en": "You're standing on my ground."},
        {"zh": "我一冲就能推平这里。", "en": "One charge would level this place."},
        {"zh": "我的角能挑开你的盾。", "en": "My horn can pry your shield open."},
        {"zh": "你仔细看我的壳。", "en": "Look at my shell."},
        {"zh": "我什么都能吃。", "en": "I eat anything."},
        {"zh": "你不该来卡瓦林。", "en": "You shouldn't have come to Khavarin."},
        {"zh": "那泥味是从卡瓦林带来的。", "en": "That mud smell is from Khavarin."},
        {"zh": "我冲起来停不住。", "en": "Once I charge, I can't stop."},
        {"zh": "你退得够快吗？", "en": "Can you retreat fast enough?"},
        {"zh": "你踩的是我巡过的路。", "en": "You are standing on my patrol path."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一道裂缝从壳顶开下来。", "en": "A crack runs down from the top of my shell."},
        {"zh": "我被撞得偏了。", "en": "I was knocked off line."},
        {"zh": "这一下顶得我发闷。", "en": "That stung."},
        {"zh": "我的腿麻了一下。", "en": "One leg went numb."},
        {"zh": "我偏着身子退了退。", "en": "I gave half a step."},
        {"zh": "我的角还完好。", "en": "My horn is still there."},
        {"zh": "腿还在，角也没断。", "en": "Legs still work, horn unbroken."},
        {"zh": "血从壳缝里流出来。", "en": "Blood runs from a seam in my shell."},
        {"zh": "你这股味我记住了。", "en": "I'll remember you."},
        {"zh": "你再顶一次试试。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这正是 Broodfruit 的香味。", "en": "The smell of Broodfruit."},
        {"zh": "这个东西我认得。", "en": "I know this one."},
        {"zh": "放下吧，我会过来。", "en": "Set it down; I'll come."},
        {"zh": "我受伤时才会安静。", "en": "Only when hurt do I calm down."},
        {"zh": "这东西能安抚我。", "en": "This can soothe me."},
        {"zh": "我挪着六条腿靠近。", "en": "I approach slowly."},
        {"zh": "把那颗果子放低一点。", "en": "Lower that fruit a little."},
        {"zh": "我吃了会记住你。", "en": "If I eat it, I'll remember you."},
        {"zh": "再给我一颗吧。", "en": "Give me another."},
        {"zh": "那是 Broodfruit，我认得。", "en": "That is Broodfruit. I know it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的壳上。", "en": "You struck my shell."},
        {"zh": "我被你顶偏了一点。", "en": "You nudged me off line."},
        {"zh": "我的角扫到了你。", "en": "My horn swept you."},
        {"zh": "再挤，我就把你顶开。", "en": "Push again and I shove you off."},
        {"zh": "这点磕碰伤不到甲壳。", "en": "That impact is nothing."},
        {"zh": "我一停，脚陷进松土。", "en": "When I stop, my feet sink into loose soil."},
        {"zh": "我的角把你挑得转了半圈。", "en": "My horn spins you half around."},
        {"zh": "我很少被人推动。", "en": "I'm rarely pushed."},
        {"zh": "闪开，我要推过去。", "en": "Move; I'm passing."},
        {"zh": "再多撞我就冲。", "en": "One more bump and I charge."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这时候不是配对。", "en": "This isn't the season for that."},
        {"zh": "我的角还留着推石头。", "en": "My horn is for pushing stones."},
        {"zh": "你不是我这一类。", "en": "You're not my kind."},
        {"zh": "我在看着领地。", "en": "I'm watching the territory."},
        {"zh": "你退到十步开外。", "en": "Stand farther off."},
        {"zh": "我今天心情不好。", "en": "My mood is bad."},
        {"zh": "别靠到我身边。", "en": "Don't come near."},
        {"zh": "你给我走开一点。", "en": "Move aside."},
        {"zh": "我转身去巡另一片草。", "en": "I turn to patrol another patch."},
        {"zh": "角还没长齐，不谈这个。", "en": "My horn is not full-grown. Not now."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用角拱起来。", "en": "I flip it up with my horn."},
        {"zh": "我嗅了嗅就扔开。", "en": "I sniff and drop it."},
        {"zh": "这个东西我能吃。", "en": "This is edible."},
        {"zh": "它沉得我顶不起来。", "en": "Too heavy."},
        {"zh": "我咬碎了一块。", "en": "I bit a piece off."},
        {"zh": "它卡在我的角上。", "en": "It's stuck on my horn."},
        {"zh": "这是哪个丢的东西？", "en": "Whose is this?"},
        {"zh": "壳太硬，我咬不动它。", "en": "Its shell is too hard to bite."},
        {"zh": "我用角把它拱着走。", "en": "I push it along."},
        {"zh": "就留在原来的地方。", "en": "Leave it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踏进了我推平的草圈。", "en": "You stepped into my flattened ring of grass."},
        {"zh": "我的角跟着你转过去。", "en": "My horn swings around after you."},
        {"zh": "我的角先低下来。", "en": "My horn lowers first."},
        {"zh": "我这一冲很快。", "en": "This charge is fast."},
        {"zh": "我要推平这片草。", "en": "I'll flatten this grass."},
        {"zh": "你背后是一堵土坡。", "en": "There is an earth bank at your back."},
        {"zh": "我已经开始跑了。", "en": "I'm running."},
        {"zh": "我不太会转向。", "en": "I'm not good at turning."},
        {"zh": "别挡在我的角尖前。", "en": "Don't stand dead ahead."},
        {"zh": "我闻到你的心跳。", "en": "I smell your heartbeat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我死死盯住你的脚。", "en": "I keep my eyes on you."},
        {"zh": "我每迈一步，草就折一片。", "en": "Each step I take folds another patch of grass."},
        {"zh": "草在我脚下倒成一片。", "en": "Grass falls flat under me."},
        {"zh": "我压低角，后腿蹬紧。", "en": "I lower my horn and set my hind legs."},
        {"zh": "你退得越远我冲得越快。", "en": "The farther you retreat, the faster I charge."},
        {"zh": "这圈树根以内都归我。", "en": "All inside these roots is mine."},
        {"zh": "我顺着坡势斜冲下来。", "en": "I charge down along the slope."},
        {"zh": "我背上这层壳很厚。", "en": "My shell is thick."},
        {"zh": "你根本打不穿的。", "en": "You can't break it."},
        {"zh": "你还有地方退吗？", "en": "Anywhere left to retreat?"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个身子撞在你腰上。", "en": "My whole body hits your waist."},
        {"zh": "角尖挑开你的盾。", "en": "My horn tip pries your shield."},
        {"zh": "你被推得后退。", "en": "You were driven back."},
        {"zh": "我把草都推平了。", "en": "I flattened all the grass."},
        {"zh": "撞上去时我整只都压过来。", "en": "On impact, all of me comes down."},
        {"zh": "你被撞到树上。", "en": "You hit a tree."},
        {"zh": "我的角卡住了。", "en": "My horn got stuck."},
        {"zh": "你快点退开去。", "en": "Get back."},
        {"zh": "这回我撞的是你的膝。", "en": "This time I go for your knee."},
        {"zh": "你被我整个挑开了。", "en": "I shoved you aside."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我的角先顶开一层土。", "en": "My horn pushes up through the soil first."},
        {"zh": "这片地面很平。", "en": "This ground is flat."},
        {"zh": "我先立起角来。", "en": "First I raise my horn."},
        {"zh": "我从腐叶堆里翻上来。", "en": "I heave up out of the leaf litter."},
        {"zh": "草的味道很新。", "en": "The grass smells fresh."},
        {"zh": "我在找领地的边界。", "en": "I'm finding the territory's edge."},
        {"zh": "脚下踩着一片泥。", "en": "Mud underfoot."},
        {"zh": "我的壳还带着土。", "en": "My shell is still muddy."},
        {"zh": "远处立着几棵树。", "en": "Trees far off."},
        {"zh": "我立起来，比草丛高一头。", "en": "I rise a head above the grass."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的壳，发出响声。", "en": "Fire bakes my shell; it crackles."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上翻下去，壳磕在石上。", "en": "I tumbled off the slope and struck stone."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水压得我喘不上气。", "en": "Water crushes the breath from me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我整只掀翻。", "en": "The blast flipped me right over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西卡在我的壳缝里。", "en": "Something stuck in my shell's seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我浑身发紧。", "en": "That force clenched me all over."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我推不动东西。", "en": "Too hungry to push anything."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我的壳上，我抖了一下。", "en": "Lightning hit my shell; I jolted."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的地被抽走了。", "en": "The ground was pulled from under me."}
      ]
    }
  }
}
