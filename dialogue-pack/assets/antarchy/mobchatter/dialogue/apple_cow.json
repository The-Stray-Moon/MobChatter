{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢走过草地。", "en": "I walk slowly over the grass."},
        {"zh": "背上的苹果一晃一晃。", "en": "The apples on my back sway as I go."},
        {"zh": "我低下头，啃一口草。", "en": "I lower my head for a mouthful of grass."},
        {"zh": "我绕开脚边的石头。", "en": "I step around the stone at my hooves."},
        {"zh": "我的尾巴甩开苍蝇。", "en": "My tail flicks the flies away."},
        {"zh": "我背上的苹果，晃了一路。", "en": "The apples on my back sway all the way."},
        {"zh": "草里有几朵花。", "en": "There are flowers in the grass."},
        {"zh": "我闻了闻，没有吃。", "en": "I sniff them, and do not eat."},
        {"zh": "苹果比花好看。", "en": "The apples are prettier than the flowers."},
        {"zh": "我背上的苹果碰出轻响。", "en": "The apples on my back knock softly."},
        {"zh": "前面有同伴在。", "en": "Companions ahead."},
        {"zh": "我朝牛群走去。", "en": "I head for the herd."},
        {"zh": "我背上，偶尔会结出苹果。", "en": "Apples sometimes grow on my back."},
        {"zh": "它们的苹果比我的红。", "en": "Their apples are redder than mine."},
        {"zh": "我不去计较。", "en": "I do not keep score."},
        {"zh": "我背上的也甜。", "en": "Mine are sweet too."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在树下，反刍。", "en": "I stand under a tree, chewing my cud."},
        {"zh": "日头挪了，我的影子也挪。", "en": "The sun moves, and so does my shadow."},
        {"zh": "苹果被照得发亮。", "en": "The apples shine in it."},
        {"zh": "有只鸟落在我的角上。", "en": "A bird lands on my horn."},
        {"zh": "我连耳朵都不动。", "en": "I do not even move my ears."},
        {"zh": "它啄了两下就走了。", "en": "Two pecks and it goes."},
        {"zh": "我的耳朵扫过一只苍蝇。", "en": "My ear swats a fly."},
        {"zh": "草地里很软。", "en": "The grass is soft."},
        {"zh": "我换了个蹄子站着。", "en": "I shift my weight to another hoof."},
        {"zh": "风把草吹倒一片。", "en": "Wind lays a patch of grass flat."},
        {"zh": "我缓缓眨了一下眼。", "en": "I blink slowly."},
        {"zh": "这是很好的下午。", "en": "It is a good afternoon."},
        {"zh": "我一直站着不动。", "en": "I stand still."},
        {"zh": "苹果在我背上轻轻晃。", "en": "The apples sway lightly on my back."},
        {"zh": "它们快要熟了。", "en": "They are nearly ripe."},
        {"zh": "我背上的果子还青着。", "en": "The fruit on my back is still green."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在篱笆外。", "en": "You stand beyond the fence."},
        {"zh": "我隔着篱笆望你。", "en": "I look at you across the fence."},
        {"zh": "我嘴里还有草。", "en": "There is still grass in my mouth."},
        {"zh": "我嚼了两下才咽。", "en": "I chew twice before swallowing."},
        {"zh": "你笑出了声。", "en": "You laugh aloud."},
        {"zh": "你笑的时候，我甩了甩尾。", "en": "When you laugh, my tail flicks."},
        {"zh": "我蹄子踏到篱笆跟前。", "en": "My hooves bring me to the fence."},
        {"zh": "你也往前走了。", "en": "You step forward too."},
        {"zh": "我们隔着篱笆。", "en": "The fence is between us."},
        {"zh": "我的鼻尖凑到你手边。", "en": "My nose comes up to your hand."},
        {"zh": "你伸手摸了摸我的鼻子。", "en": "You reach through and touch my nose."},
        {"zh": "摸上去很暖。", "en": "It is warm."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我闷叫一声，退了两步。", "en": "I low and fall back two steps."},
        {"zh": "苹果晃得厉害。", "en": "The apples swing hard."},
        {"zh": "背上一轻，掉了一个。", "en": "My back feels lighter. One has dropped."},
        {"zh": "掉下来的那个滚远了。", "en": "The one that fell rolls away."},
        {"zh": "随后我抬起眼睛。", "en": "Then I lift my eyes."},
        {"zh": "我趔趄半步，蹄子钉住。", "en": "My legs buckle, then hold."},
        {"zh": "我身上的苹果，别摘。", "en": "The apples on me. Do not pick them."},
        {"zh": "这一下，我背上的果子晃了。", "en": "The apples on my back sway from that."},
        {"zh": "又低头吃起草。", "en": "And lower my head to the grass."},
        {"zh": "吃点东西能止疼。", "en": "Eating helps the pain."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是草，很新鲜。", "en": "That is grass, and fresh."},
        {"zh": "我从篱笆这边看着。", "en": "I watch from this side of the fence."},
        {"zh": "你把草举在手里。", "en": "You hold it up in your hand."},
        {"zh": "我把舌头卷向那把草。", "en": "I curl my tongue toward that grass."},
        {"zh": "可还是够不着。", "en": "Cannot reach."},
        {"zh": "我又往前挤了挤。", "en": "I press a little further."},
        {"zh": "篱笆挡着我呢。", "en": "The fence stops me."},
        {"zh": "你笑了，把草递近。", "en": "You laugh and bring it closer."},
        {"zh": "我一口就咬走。", "en": "One bite takes it."},
        {"zh": "尝起来真甜。", "en": "Very sweet."},
        {"zh": "我一口一口细细嚼。", "en": "I chew it slowly."},
        {"zh": "你就看着我吃。", "en": "You watch me eat."},
        {"zh": "我又伸头去要。", "en": "I stretch for more."},
        {"zh": "你手上还剩一点。", "en": "You still have some left."},
        {"zh": "那我就在这儿等。", "en": "So I wait."},
        {"zh": "吃完了，我舔了舔嘴。", "en": "When it is gone I lick my lips."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到篱笆，我退了一步。", "en": "You knock the fence and I step back."},
        {"zh": "我们隔着木头对看。", "en": "We look at each other through the wood."},
        {"zh": "我把鼻子伸过去。", "en": "I push my nose through."},
        {"zh": "碰到你的手了。", "en": "It meets your hand."},
        {"zh": "你也碰了碰我。", "en": "You touch me back."},
        {"zh": "我把头摆了摆。", "en": "I swing my head."},
        {"zh": "篱笆有点摇晃。", "en": "The fence sways a little."},
        {"zh": "我被木头弹回来半步。", "en": "The fence bounces me back half a step."},
        {"zh": "苹果在背上碰了一下。", "en": "The apples knock together on my back."},
        {"zh": "响了一声脆的。", "en": "One clack."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "草地那头有一头牛。", "en": "There is a cow at the far end of the meadow."},
        {"zh": "它背上的苹果很红。", "en": "Its apples are very red."},
        {"zh": "我朝那头红苹果的牛走。", "en": "I walk toward the cow with the red apples."},
        {"zh": "它的鼻息喷在我颈上。", "en": "Its breath puffs against my neck."},
        {"zh": "然后一起低头吃草。", "en": "Then lower our heads to graze together."},
        {"zh": "苹果碰在一起。", "en": "Our apples touch."},
        {"zh": "我们都没有抬头。", "en": "Neither of us looks up."},
        {"zh": "太阳晒得很暖。", "en": "The sun is warm."},
        {"zh": "这片草，够我们嚼到天黑。", "en": "This grass will last us till dark."},
        {"zh": "天黑了我们还在。", "en": "At dark we are still here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到它没有青草味。", "en": "I smell no grass on it."},
        {"zh": "这一缕不是草。", "en": "This is not grass."},
        {"zh": "我拿鼻尖顶了顶。", "en": "I nudge it with my nose tip."},
        {"zh": "它滚到一边去。", "en": "It rolls away."},
        {"zh": "我走过去看看。", "en": "I go to look."},
        {"zh": "我用鼻尖又顶了顶。", "en": "I nudge it with my nose again."},
        {"zh": "这个倒挺好玩。", "en": "This is rather amusing."},
        {"zh": "我一路顶着它走。", "en": "I nose it along the way."},
        {"zh": "它掉进沟里了。", "en": "It falls into a ditch."},
        {"zh": "我仔细瞧了瞧。", "en": "I have a look."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在篱笆那边。", "en": "Something is beyond the fence."},
        {"zh": "我把下巴抬过篱笆顶。", "en": "I lift my chin over the fence rail."},
        {"zh": "原来是一条狗。", "en": "A dog, then."},
        {"zh": "它在那边叫。", "en": "It is barking."},
        {"zh": "我照旧嚼着草。", "en": "I go on chewing."},
        {"zh": "它叫得更凶了。", "en": "It barks harder."},
        {"zh": "我身上的斑点是苹果。", "en": "The spots on my hide are apples."},
        {"zh": "它夹着尾巴退开。", "en": "It backs off with its tail low."},
        {"zh": "我往篱笆那边挪半步。", "en": "I shift half a step toward the fence."},
        {"zh": "它撒腿跑掉了。", "en": "It bolts."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的视线跟着它。", "en": "My gaze follows it."},
        {"zh": "它在篱笆外面来回走。", "en": "It paces outside the fence."},
        {"zh": "慢慢嚼着草，看着你。", "en": "Chewing grass slowly, watching you."},
        {"zh": "一边嚼一边看。", "en": "Chewing and watching."},
        {"zh": "它总算停下来了。", "en": "It's finally stopped."},
        {"zh": "我嘴里还含着草。", "en": "I still have grass in my mouth."},
        {"zh": "我们相互看着。", "en": "We look at each other."},
        {"zh": "它低声吼着。", "en": "It growls."},
        {"zh": "我没有回应它。", "en": "I do not answer."},
        {"zh": "它又走了几圈。", "en": "It circles a few more times."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头，用角顶。", "en": "I lower my head and butt."},
        {"zh": "它退到一边去。", "en": "It gets clear."},
        {"zh": "我不费那个劲。", "en": "I will not spend the effort."},
        {"zh": "只是站在原地。", "en": "I only stand my ground."},
        {"zh": "我顶过去，顶了个空。", "en": "I butt forward and hit nothing."},
        {"zh": "我转过身对着它。", "en": "I turn to face it."},
        {"zh": "苹果晃了一下。", "en": "The apples sway."},
        {"zh": "有一个掉了下来。", "en": "One falls."},
        {"zh": "我低头，看它夹着尾巴。", "en": "I lower my head and see it slink off."},
        {"zh": "然后又看那狗。", "en": "Then at the dog."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在一片草地上。", "en": "I stand in a meadow."},
        {"zh": "太阳刚升起来。", "en": "The sun has just risen."},
        {"zh": "草上还有露水。", "en": "There is still dew on the grass."},
        {"zh": "低头嚼一口，苹果味很脆。", "en": "Head down for a bite — crisp apple taste."},
        {"zh": "摸起来凉丝丝的。", "en": "Cool to the touch."},
        {"zh": "背上的苹果还很小。", "en": "The apples on my back are still small."},
        {"zh": "它们会长大的。", "en": "They will grow."},
        {"zh": "我抬头环顾一圈。", "en": "I look all around."},
        {"zh": "这片草，够我吃上好一阵。", "en": "This grass will keep me fed a while."},
        {"zh": "还立着篱笆。", "en": "And fences."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到我的背，苹果开始发黑。", "en": "Fire catches my back and the apples blacken."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，草被压倒一片。", "en": "I roll down the slope and flatten a patch of grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过头，我蹬着四条腿往上。", "en": "Water covers me; all four legs kick upward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸响把我掀翻，苹果全掉了。", "en": "A blast throws me over and every apple falls."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭杆插在我肩胛上。", "en": "The arrow's fletching still quivers in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光缠住我，我挪不动。", "en": "Light wraps me and I cannot shift."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "草被啃光了，我的肋骨都摸得到。", "en": "The grass is eaten out and my ribs show."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我整头都僵了。", "en": "Lightning strikes and my whole head locks."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "草地没了，我在黑里掉下去。", "en": "The meadow is gone and I fall through black."}
      ]
    }
  }
}
