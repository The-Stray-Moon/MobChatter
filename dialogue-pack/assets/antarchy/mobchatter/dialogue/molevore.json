{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用宽鼻子拱着土走。", "en": "I root through the soil with my broad snout."},
        {"zh": "我在卡瓦林里挖出一条道。", "en": "I dig a tunnel through the Kavarin."},
        {"zh": "土从我的爪子后面翻出来。", "en": "Soil spills out behind my claws."},
        {"zh": "我走一步，地面就陷一分。", "en": "Each step sinks the ground a little."},
        {"zh": "我的毛上都是土。", "en": "My fur is all soil."},
        {"zh": "我贴着洞壁往前拱。", "en": "I shoulder along the tunnel wall."},
        {"zh": "我嗅着地下的东西。", "en": "I sniff for what's underground."},
        {"zh": "我的尾巴扫平了后面的路。", "en": "My tail sweeps the path behind me."},
        {"zh": "我往上顶开一层土。", "en": "I push up through a layer of soil."},
        {"zh": "石子被我拱到一边。", "en": "Stones get shoved aside."},
        {"zh": "我在黑暗里看得很清楚。", "en": "I see clearly in the dark."},
        {"zh": "我从一个洞接到另一个洞。", "en": "I break from one burrow into another."},
        {"zh": "我的爪子很宽。", "en": "My claws are broad."},
        {"zh": "我停下来听土里的动静。", "en": "I stop and listen in the soil."},
        {"zh": "我拱一鼻子，抬起脸嗅嗅", "en": "I root once, lift my face, and sniff."},
        {"zh": "我朝更松软的地面去。", "en": "I head for looser ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着，鼻子在动。", "en": "I lie low, my snout working."},
        {"zh": "我听见土里有虫在拱", "en": "I hear insects working through the soil."},
        {"zh": "我把前爪搭在土堆上。", "en": "I rest a forepaw on a mound."},
        {"zh": "洞里闷得很。", "en": "The burrow is stifling."},
        {"zh": "我把门牙磨得咯咯响", "en": "I grind my front teeth with a rasp."},
        {"zh": "有一块石头硌着我。", "en": "A stone digs into me."},
        {"zh": "我把头朝向另一边。", "en": "I turn my head the other way."},
        {"zh": "我的呼吸把土吹起来。", "en": "My breath lifts the soil."},
        {"zh": "我听着上面的脚步震土", "en": "I listen to the steps above shaking soil loose."},
        {"zh": "我伏进洞里，收窄身子", "en": "I settle into the tunnel and narrow myself."},
        {"zh": "我的鼻子湿的。", "en": "My snout is wet."},
        {"zh": "我在等虫潮。", "en": "I'm waiting for the swarm."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我洞口的上面。", "en": "You're standing on my burrow."},
        {"zh": "我抬起头，土落下来。", "en": "I raise my head; soil falls."},
        {"zh": "你鞋底带着铁，我闻得到", "en": "Your boots carry iron; I can smell it."},
        {"zh": "你的脚踩坏了一段。", "en": "Your feet broke part of it."},
        {"zh": "我朝你拱了一下。", "en": "I shoved toward you once."},
        {"zh": "这里地下面全是我的路。", "en": "All the ground here is my road."},
        {"zh": "你退开，我就钻回去。", "en": "Step back and I'll go down again."},
        {"zh": "我的牙很钝，但够。", "en": "My teeth are blunt, but they'll do."},
        {"zh": "你听见下面有声音吗？", "en": "Do you hear something below?"},
        {"zh": "我的鼻尖已经碰到你的鞋", "en": "My snout is already against your boot."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一头钻进土里。", "en": "I burrow down."},
        {"zh": "背上被砸得发闷。", "en": "The back takes a dull hit."},
        {"zh": "我退到洞里面。", "en": "I retreat into the tunnel."},
        {"zh": "我把牙露出来。", "en": "I bare my teeth."},
        {"zh": "我的毛上抖落一层湿土", "en": "A layer of wet soil drops off my fur."},
        {"zh": "我的爪子有点软。", "en": "My claws feel soft."},
        {"zh": "我又顶起来了。", "en": "I rise again."},
        {"zh": "我看着你的鞋。", "en": "I watch your boots."},
        {"zh": "我还在地下。", "en": "I'm still underground."},
        {"zh": "我用鼻子喷气。", "en": "I snort through my snout."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有根的味道。", "en": "I smell roots."},
        {"zh": "你手里的块能啃。", "en": "That block in your hand can be gnawed."},
        {"zh": "我把它拱出来。", "en": "I root it out."},
        {"zh": "这玩意儿硌得我牙疼", "en": "This stuff makes my teeth ache."},
        {"zh": "我要地下的那种。", "en": "I want the kind underground."},
        {"zh": "我贴着洞壁靠过去。", "en": "I edge along the tunnel wall."},
        {"zh": "你放下就别管了。", "en": "Leave it and don't watch."},
        {"zh": "我拱起土堆把它盖住", "en": "I push up a mound of soil over it."},
        {"zh": "留着以后吃。", "en": "I'll keep it for later."},
        {"zh": "我闻着还有别的。", "en": "I smell more of it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你一脚踩塌了我的洞顶", "en": "Your foot caves in my tunnel roof."},
        {"zh": "我一下钻进土里。", "en": "I dive into the soil."},
        {"zh": "泥土被我掀起来。", "en": "Soil flies up."},
        {"zh": "我撞到了你的脚。", "en": "I knocked your foot."},
        {"zh": "我从另一边钻出来。", "en": "I come up on the other side."},
        {"zh": "这条洞太窄。", "en": "This tunnel is too narrow."},
        {"zh": "土堆塌了一段。", "en": "A mound collapses."},
        {"zh": "我又拱回去。", "en": "I root back in."},
        {"zh": "你退到洞外。", "en": "You back out of the burrow."},
        {"zh": "这点分量压不垮我。", "en": "That won't crush me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "洞里还有一只。", "en": "There's another in the burrow."},
        {"zh": "我们的宽鼻子互相蹭了蹭", "en": "Our broad snouts rub against each other."},
        {"zh": "她的爪子比我的窄。", "en": "Her claws are narrower than mine."},
        {"zh": "我们一起挖。", "en": "We dig together."},
        {"zh": "土从两头堆起来。", "en": "Soil mounds up at both ends."},
        {"zh": "她把食物推给我。", "en": "She pushes food to me."},
        {"zh": "我们一起等虫潮。", "en": "We wait for the swarm together."},
        {"zh": "她的呼吸很近。", "en": "Her breathing is close."},
        {"zh": "她钻进去了。", "en": "She went into the tunnel."},
        {"zh": "我跟在她后头。", "en": "I trail behind her."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前爪扒出它。", "en": "I scrape it out."},
        {"zh": "它沾满了土。", "en": "It's covered in soil."},
        {"zh": "我把它咬起来。", "en": "I take it in my teeth."},
        {"zh": "这块是草根。", "en": "This is a root."},
        {"zh": "我一口咬开。", "en": "I bite it open."},
        {"zh": "我把它收进洞里。", "en": "I take it into the burrow."},
        {"zh": "这块没什么味道。", "en": "This has little taste."},
        {"zh": "我甩到身后。", "en": "I toss it behind me."},
        {"zh": "我爪子底下碰到硬块", "en": "My claws hit something hard."},
        {"zh": "我接着挖下去。", "en": "I keep digging."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我听到虫潮了。", "en": "I hear the swarm."},
        {"zh": "我听见虫潮从地底压来", "en": "I hear the swarm pressing in underground."},
        {"zh": "我扭身朝上。", "en": "I twist upward."},
        {"zh": "我的鼻子贴着土。", "en": "My snout is to the soil."},
        {"zh": "我把肩放低。", "en": "I drop my shoulder."},
        {"zh": "它正踩在我的洞口上", "en": "It's standing right on my burrow mouth."},
        {"zh": "我往上顶它。", "en": "I push up at it."},
        {"zh": "土被我掀开。", "en": "I break the soil open."},
        {"zh": "它就在那里。", "en": "It's right there."},
        {"zh": "我这就冲了。", "en": "I charge now."},
        {"zh": "这一下用肩膀。", "en": "This one's with the shoulder."},
        {"zh": "它倒下去了。", "en": "It went down."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着它的脚步。", "en": "I follow its steps."},
        {"zh": "我在地下面走。", "en": "I travel below the ground."},
        {"zh": "土从我头顶落。", "en": "Soil falls from above me."},
        {"zh": "上面的脚步停了。", "en": "The footsteps above stop."},
        {"zh": "我也停住爪子。", "en": "I stop my claws too."},
        {"zh": "我贴着洞壁听。", "en": "I listen along the tunnel wall."},
        {"zh": "它踩着我头顶的土层走", "en": "It walks on the soil above my head."},
        {"zh": "我在它下面。", "en": "I'm beneath it."},
        {"zh": "我把土顶开。", "en": "I push the soil up."},
        {"zh": "我顶松了它脚下的土", "en": "I've loosened the soil under its feet."},
        {"zh": "地面上有我的土堆。", "en": "There are my mounds on the surface."},
        {"zh": "它绕开去了。", "en": "It went around."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一肩撞在它腿上。", "en": "I ram its leg with my shoulder."},
        {"zh": "它被掀倒了。", "en": "It's knocked over."},
        {"zh": "我前爪压住它。", "en": "My forepaws pin it."},
        {"zh": "我低头咬下去。", "en": "I lower my head and bite."},
        {"zh": "土被我们搅成一片。", "en": "We churn the soil."},
        {"zh": "它挣起来，我又压下。", "en": "It tries to rise; I press down."},
        {"zh": "我的牙咬在石头上。", "en": "My teeth meet stone."},
        {"zh": "我一肩顶得它往后倒", "en": "One shove of my shoulder sends it over backward."},
        {"zh": "我又冲过去。", "en": "I charge again."},
        {"zh": "它撞在洞壁上。", "en": "It hits the tunnel wall."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地面上鼓起一个土堆。", "en": "A mound rises on the ground."},
        {"zh": "我从下面顶出来。", "en": "I break up from below."},
        {"zh": "土块落了我一身。", "en": "Clods fall all over me."},
        {"zh": "卡瓦林的地下很松。", "en": "The Kavarin soil is loose."},
        {"zh": "我先挖开一条路。", "en": "First, I dig out a path."},
        {"zh": "空气里有铁和土的味道。", "en": "The air smells of iron and soil."},
        {"zh": "我朝有虫子的一边去。", "en": "I head toward the insects."},
        {"zh": "我沿着岩层往下。", "en": "I follow the rock layer down."},
        {"zh": "我停下来又看了看。", "en": "I stop and look again."},
        {"zh": "我继续往前拱。", "en": "I root on."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火灌进洞里，我往下钻。", "en": "Fire pours into the tunnel; I dig lower."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，土跟着塌了。", "en": "I fall, and the soil falls with me."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进洞里，我的鼻子堵了。", "en": "Water floods the tunnel; my snout is blocked."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我从洞里掀出来。", "en": "The blast throws me out of the tunnel."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物扎进我的背。", "en": "A point sticks in my back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "有股力把我按在土里。", "en": "Force presses me into the soil."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得挖不动土。", "en": "Too hungry to dig."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷从洞口下来，我全身麻了。", "en": "Lightning enters the tunnel; I go numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "土没有了，我脚下空得发慌", "en": "No soil left; the emptiness under my feet jars me."}
      ]
    }
  }
}
