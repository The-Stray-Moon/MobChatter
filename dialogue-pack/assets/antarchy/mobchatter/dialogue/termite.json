{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从木头里钻出来", "en": "I come out of the wood."},
        {"zh": "木屑挂在身上", "en": "Sawdust clings to me."},
        {"zh": "六条腿在木纹上走", "en": "Six legs walk the grain."},
        {"zh": "我顺着树皮裂纹，往上爬。", "en": "I climb along the bark's cracks."},
        {"zh": "后面跟着一串同伴", "en": "A line of nestmates trails me."},
        {"zh": "我们排成一条队", "en": "We form a single file."},
        {"zh": "木头里有我们的路", "en": "We have roads inside the wood."},
        {"zh": "外面走的是另一条", "en": "Another runs on the outside."},
        {"zh": "有火把的地方我绕开", "en": "I go around anywhere there's a torch."},
        {"zh": "光太亮，不舒服", "en": "Too bright. Uncomfortable."},
        {"zh": "我往阴影里钻", "en": "I duck into shadow."},
        {"zh": "木头里又凉又暗", "en": "Inside the wood it's cool and dark."},
        {"zh": "我在里面走得很快", "en": "I move fast in there."},
        {"zh": "出来时又慢下来", "en": "Slower once out."},
        {"zh": "我咬了一口木头", "en": "I take a bite of wood."},
        {"zh": "尝了尝，不错", "en": "Taste it. Good."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "停在一道木缝边上", "en": "Stopped by a seam in the wood."},
        {"zh": "触角探进缝里", "en": "My antennae probe the gap."},
        {"zh": "缝里有同伴的气味", "en": "Nestmate scent inside."},
        {"zh": "我跟着味道往里", "en": "I follow it inward."},
        {"zh": "身体刚好挤进去", "en": "My body just fits."},
        {"zh": "木头在我头顶变成顶", "en": "The wood becomes a ceiling."},
        {"zh": "木头里很安静", "en": "It's quiet in here."},
        {"zh": "外面正刮着风", "en": "Wind outside."},
        {"zh": "里面一丝也没有", "en": "None in here."},
        {"zh": "我一节一节往前", "en": "I inch along."},
        {"zh": "能听见同伴在啃", "en": "I can hear nestmates chewing."},
        {"zh": "沙沙的，很有节奏", "en": "A steady rustle."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬头，你挡住了光", "en": "I look up. You're blocking the light."},
        {"zh": "这道光太亮了", "en": "Too bright."},
        {"zh": "我往木缝里退", "en": "I retreat into the seam."},
        {"zh": "只露出两根触角", "en": "Only my antennae show."},
        {"zh": "你没有继续靠近", "en": "You don't come closer."},
        {"zh": "那我也就不动", "en": "Then I don't move either."},
        {"zh": "你正盯着木头", "en": "You're looking at the wood."},
        {"zh": "那木头已经在坏了", "en": "That wood is already failing."},
        {"zh": "你现在还看不出来", "en": "You can't see it yet."},
        {"zh": "可它已经在坏", "en": "But it is."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下缩进缝里", "en": "I shrink into the seam."},
        {"zh": "身体压得很扁", "en": "My body flattens."},
        {"zh": "有东西被打碎了", "en": "Something's been crushed."},
        {"zh": "那压根不是我", "en": "That's not me at all."},
        {"zh": "我在更深的地方", "en": "I'm deeper in."},
        {"zh": "我继续往里钻", "en": "I keep burrowing."},
        {"zh": "木头替我挡着", "en": "The wood shields me."},
        {"zh": "外面的声音远了", "en": "The noise outside fades."},
        {"zh": "我就此停住了", "en": "I stop right here."},
        {"zh": "慢慢等着就好", "en": "And wait."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西是木头的", "en": "That's made of wood."},
        {"zh": "闻一下便晓得", "en": "A sniff is enough."},
        {"zh": "我朝那边爬去", "en": "I crawl that way."},
        {"zh": "路上插着火把", "en": "There's a torch on the route."},
        {"zh": "我绕了一大圈", "en": "I go the long way around."},
        {"zh": "总算到了那里", "en": "Finally there."},
        {"zh": "这截木头甜，我多啃两口。", "en": "This wood is sweet; I gnaw twice more."},
        {"zh": "很硬，但是好木头", "en": "Hard, but good wood."},
        {"zh": "我咬出一个小坑", "en": "I chew out a little hollow."},
        {"zh": "这里能住下来", "en": "This could be a home."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞翻了个身", "en": "I'm knocked over."},
        {"zh": "六条腿在空中乱找", "en": "Six legs grab at nothing."},
        {"zh": "我翻回正面来", "en": "I right myself."},
        {"zh": "木屑落了一身", "en": "Sawdust covers me."},
        {"zh": "木屑从我背上簌簌落下。", "en": "Wood dust sifts off my back."},
        {"zh": "然后往缝里钻", "en": "Then duck into a seam."},
        {"zh": "你还留在外面", "en": "You're outside."},
        {"zh": "我已经在里面", "en": "I'm inside."},
        {"zh": "这样也就够了", "en": "That will do."},
        {"zh": "我继续啃木头", "en": "I go back to chewing."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "巢里有一只大的", "en": "There's a big one in the nest."},
        {"zh": "她管着这一片", "en": "She runs this stretch."},
        {"zh": "我们都听她的", "en": "We all follow her."},
        {"zh": "我把啃下的木屑推给她", "en": "I push chewed wood toward her."},
        {"zh": "她触角碰了碰我", "en": "Her antennae touch me."},
        {"zh": "那也就足够了", "en": "That's enough."},
        {"zh": "我回去继续啃", "en": "I go back to chewing."},
        {"zh": "这一条通道要加宽", "en": "This passage needs widening."},
        {"zh": "一切都要慢慢来", "en": "Slowly."},
        {"zh": "总会长出来的", "en": "It'll grow in time."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用上颚夹住", "en": "My mandibles grip it."},
        {"zh": "举起来有点费劲", "en": "Lifting it takes effort."},
        {"zh": "六条腿一起撑", "en": "Six legs brace together."},
        {"zh": "往前走了两步", "en": "Two steps."},
        {"zh": "然后把它放下", "en": "Then I set it down."},
        {"zh": "我先啃上一口", "en": "I gnaw a bite first."},
        {"zh": "木屑落了一地，我继续啃。", "en": "Sawdust everywhere, and I keep chewing."},
        {"zh": "这个能用得上", "en": "This will do."},
        {"zh": "我把它拖向入口", "en": "I drag it toward the entrance."},
        {"zh": "里面有人来接", "en": "Someone takes it inside."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "木头在轻轻响", "en": "The wood is creaking."},
        {"zh": "我一下就停了", "en": "I stop."},
        {"zh": "触角全都朝那个方向", "en": "All my antennae point that way."},
        {"zh": "有东西在木头里", "en": "Something's in the wood."},
        {"zh": "那气味不是同伴", "en": "Not a nestmate."},
        {"zh": "那味道实在不对", "en": "The scent is wrong."},
        {"zh": "我退进蚁道，只留头在外。", "en": "I retreat into the tunnel, only my head out."},
        {"zh": "一直退到缝里", "en": "Into a seam."},
        {"zh": "如果它真进来", "en": "If it comes in,"},
        {"zh": "我就咬它一口", "en": "I bite it."},
        {"zh": "我只有这一口", "en": "One bite is all I have."},
        {"zh": "咬完立刻就跑", "en": "Then I run."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着木面走", "en": "I move along the wood's surface."},
        {"zh": "在木纹的暗处", "en": "In the dark of the grain."},
        {"zh": "你根本看不清我", "en": "You can't see me clearly."},
        {"zh": "我稍微停一下", "en": "I pause."},
        {"zh": "然后换个位置", "en": "Then shift position."},
        {"zh": "木头给了我路", "en": "The wood gives me roads."},
        {"zh": "你不知道我从哪出来", "en": "You won't know where I'll come from."},
        {"zh": "也许就在里面", "en": "Maybe here."},
        {"zh": "也许会在那边", "en": "Maybe there."},
        {"zh": "也许我已经在你后面", "en": "Maybe I'm already behind you."},
        {"zh": "木头会告诉你", "en": "The wood will tell you."},
        {"zh": "那沙沙的声响", "en": "That rustling sound."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从缝里冲出来", "en": "I burst from the seam."},
        {"zh": "上颚咬在你的手指上", "en": "My mandibles clamp your finger."},
        {"zh": "咬紧了就不松", "en": "Once I bite, I hold."},
        {"zh": "你用力甩了一下", "en": "You shake your hand."},
        {"zh": "我居然没被甩掉", "en": "I stay on."},
        {"zh": "第二口咬得更深", "en": "The second bite goes deeper."},
        {"zh": "然后你捏住了我", "en": "Then you pinch me."},
        {"zh": "我这才松开了", "en": "I let go."},
        {"zh": "掉在了木头上", "en": "I drop onto the wood."},
        {"zh": "马上开始找缝", "en": "And look for a seam at once."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "木头表面出现一个小洞", "en": "A small hole appears in the wood."},
        {"zh": "我从里面钻出来", "en": "I come out of it."},
        {"zh": "木屑堆在洞口", "en": "Sawdust heaps at the entrance."},
        {"zh": "这儿的空气很干", "en": "The air here is dry."},
        {"zh": "这里林子很多", "en": "Plenty of trees here."},
        {"zh": "有这些便够用", "en": "These will suffice."},
        {"zh": "我先啃出一圈", "en": "I chew a ring first."},
        {"zh": "把这地方标记", "en": "Marking the spot."},
        {"zh": "同伴会闻到的", "en": "Nestmates will smell it."},
        {"zh": "然后它们就来", "en": "And they'll come."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "木头烧起来，我往里逃", "en": "The wood burns. I flee deeper."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我和木屑一起掉下去", "en": "I fall with the sawdust."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "湿木头里我动不了", "en": "In wet wood I can't move."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "木头被炸开，我飞出去", "en": "The wood bursts and I'm thrown."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉进了木头", "en": "Something nails into the wood."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "壳里一阵发麻", "en": "A numbness fills my shell."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有木头可以啃", "en": "No wood left to chew."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着木头进来", "en": "Lightning runs in through the wood."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "木头忽然没有了", "en": "The wood is gone."}
      ]
    }
  }
}
