{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在洞里一节一节地拱。", "en": "I push through the burrow segment by segment."},
        {"zh": "我身上没有眼睛。", "en": "I have no eyes."},
        {"zh": "我的口器在土里不停开合", "en": "My mouthparts work open and shut in the dirt."},
        {"zh": "洞壁湿冷，贴着我的皮。", "en": "The tunnel wall is cold against my skin."},
        {"zh": "我的身子扭着往前。", "en": "My body twists forward."},
        {"zh": "土从后面被推出去。", "en": "Soil gets pushed out behind me."},
        {"zh": "我在卡瓦林的深处爬。", "en": "I crawl deep in the Kavarin."},
        {"zh": "碎石卡在我身上，我抖掉。", "en": "Grit sticks to me; I shake it off."},
        {"zh": "我往上探出一点。", "en": "I probe upward a little."},
        {"zh": "我在地下一段一段走。", "en": "I travel underground in stages."},
        {"zh": "我把前面挖松了。", "en": "I loosen what's ahead."},
        {"zh": "我的节环一收一放。", "en": "My rings contract and release."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘在洞里。", "en": "I coil in the tunnel."},
        {"zh": "我的口器慢慢磨。", "en": "My mouthparts grind slowly."},
        {"zh": "土里有细小的声音。", "en": "Tiny sounds in the soil."},
        {"zh": "上面有人走动。", "en": "Someone walks above."},
        {"zh": "我的节环一收一放地动", "en": "My rings tighten and slacken."},
        {"zh": "洞里没有光。", "en": "There's no light here."},
        {"zh": "我在等震动。", "en": "I'm waiting for a vibration."},
        {"zh": "我把头探出去一点。", "en": "I poke my head out a little."},
        {"zh": "我又缩回来。", "en": "I pull it back in."},
        {"zh": "我的皮在轻轻颤。", "en": "My skin trembles faintly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我感到了震动。", "en": "I feel the vibration."},
        {"zh": "你站在我头顶。", "en": "You're standing over my head."},
        {"zh": "我没有眼睛看你。", "en": "I have no eyes to see you."},
        {"zh": "你的脚步我全听见。", "en": "I hear every one of your steps."},
        {"zh": "我一节节从土里竖起", "en": "I rise out of the soil ring by ring."},
        {"zh": "这片地下都是我的。", "en": "All this ground is mine."},
        {"zh": "你退开，我就下去。", "en": "Step back and I'll go down."},
        {"zh": "我的口器够大。", "en": "My mouthparts are big enough."},
        {"zh": "你到底想怎样？", "en": "What do you actually want?"},
        {"zh": "我在下面等你。", "en": "I'll wait for you below."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我疼得往洞底退", "en": "The pain drives me back down the burrow."},
        {"zh": "我的节环松了一节。", "en": "One of my rings has loosened."},
        {"zh": "土从上面塌下来。", "en": "Soil collapses from above."},
        {"zh": "我发不出声。", "en": "I can't make a sound."},
        {"zh": "我整条身子缩成一团", "en": "I screw my whole length into a knot."},
        {"zh": "血渗进土里。", "en": "Blood seeps into the soil."},
        {"zh": "我又卷起来。", "en": "I coil up again."},
        {"zh": "我往湿土更深处缩", "en": "I shrink deeper into the wet soil."},
        {"zh": "我还在挪动着。", "en": "I'm still shifting."},
        {"zh": "我慢慢往前。", "en": "I work my way forward."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有肉在土里。", "en": "There's meat in the soil."},
        {"zh": "我闻着味道过去。", "en": "I follow the smell."},
        {"zh": "这块埋在下面。", "en": "It's buried under here."},
        {"zh": "你把土拨开。", "en": "Brush the soil aside."},
        {"zh": "我从土里露头。", "en": "My head shows from the soil."},
        {"zh": "这个够我一阵。", "en": "This will do me for a while."},
        {"zh": "我先探一探。", "en": "Let me probe it first."},
        {"zh": "就地吃掉了。", "en": "I eat it right here."},
        {"zh": "我一口下去只崩了牙", "en": "One bite and I only chip a tooth."},
        {"zh": "我再找一找。", "en": "I'll look again."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到了我的洞顶。", "en": "You stepped on my tunnel roof."},
        {"zh": "土塌下一块。", "en": "A patch of soil collapses."},
        {"zh": "我一下缩进身后的土洞", "en": "I snap back into the tunnel behind me."},
        {"zh": "我从另一边顶出来。", "en": "I break out on the other side."},
        {"zh": "你撞到了我的身子。", "en": "You hit my body."},
        {"zh": "我的节环夹了一下。", "en": "My rings clamp once."},
        {"zh": "土全塌下来了。", "en": "The soil has all collapsed."},
        {"zh": "我扭身挣脱了。", "en": "I twisted free."},
        {"zh": "我又钻下去。", "en": "I go back down."},
        {"zh": "洞又合上了。", "en": "The tunnel closes again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "洞里还有一条。", "en": "There's another in the tunnel."},
        {"zh": "我们挨在一起。", "en": "We press together."},
        {"zh": "她的节比我密。", "en": "Her rings are closer together."},
        {"zh": "我们一起往深处。", "en": "We go deeper together."},
        {"zh": "土被挤出两边。", "en": "Soil bulges at both sides."},
        {"zh": "她没有声音。", "en": "She makes no sound."},
        {"zh": "我贴着她不动。", "en": "I stay pressed against her."},
        {"zh": "洞被我们撑宽了。", "en": "We widen the tunnel."},
        {"zh": "她先往前挪。", "en": "She moves forward first."},
        {"zh": "我在后面跟上。", "en": "I follow behind."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它拢进节环之间", "en": "I gather it between my rings."},
        {"zh": "它有肉的味道。", "en": "It smells of meat."},
        {"zh": "我用身子把它圈起来", "en": "I loop my body around it."},
        {"zh": "这是根老骨。", "en": "An old bone."},
        {"zh": "我试着咬它。", "en": "I test it with my teeth."},
        {"zh": "它在我嘴里碎。", "en": "It breaks in my mouth."},
        {"zh": "我把它压住。", "en": "I hold it down."},
        {"zh": "土把它埋了。", "en": "The soil buried it."},
        {"zh": "这味道我不碰", "en": "I won't touch what smells like this."},
        {"zh": "我叼着它钻回湿土", "en": "I carry it back down into the wet soil."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "震动很清楚。", "en": "The vibration is clear."},
        {"zh": "我朝上方去。", "en": "I move upward."},
        {"zh": "我的口器张成一个圆", "en": "My mouthparts open into a ring."},
        {"zh": "它就在旁边。", "en": "It's right beside me."},
        {"zh": "我从土里出来。", "en": "I come out of the soil."},
        {"zh": "我的身子缠过去。", "en": "My body coils out."},
        {"zh": "土翻起来一片。", "en": "The soil turns over."},
        {"zh": "它还没反应过来。", "en": "It hasn't reacted yet."},
        {"zh": "我把它收紧了。", "en": "I tighten around it."},
        {"zh": "它被我压住。", "en": "It's pinned."},
        {"zh": "我开始咬下去。", "en": "I start to bite."},
        {"zh": "我缠得它只剩喘气", "en": "I wrap it until it can only gasp."},
        {"zh": "土里就剩我和它", "en": "Down in the soil there's only it and me."},
        {"zh": "它塌下去了。", "en": "It collapsed."},
        {"zh": "我还卷着它。", "en": "I'm still coiled around it."},
        {"zh": "我盘好身子，等它靠近", "en": "I coil up and wait for it to come close."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着震动走。", "en": "I follow the vibration."},
        {"zh": "我在地下面靠近。", "en": "I close in underground."},
        {"zh": "它在上面不动了。", "en": "It's stopped above."},
        {"zh": "我停下身子。", "en": "I halt my body."},
        {"zh": "它再走，我又跟。", "en": "It moves; I follow."},
        {"zh": "洞越来越窄。", "en": "The tunnel narrows."},
        {"zh": "我换了一条路。", "en": "I take another route."},
        {"zh": "它就压在我头顶。", "en": "It's right over my head."},
        {"zh": "我从侧面出去。", "en": "I come out to the side."},
        {"zh": "距离很短了。", "en": "The distance is short."},
        {"zh": "我从土里探出头。", "en": "I poke my head out."},
        {"zh": "它退了一步，看见我了", "en": "It steps back — it has seen me."},
        {"zh": "那我就不藏了。", "en": "Then I won't hide."},
        {"zh": "我整个出来。", "en": "I come all the way out."},
        {"zh": "我顺着震动一节节逼近", "en": "I close in segment by segment, tracking the tremor."},
        {"zh": "该我动手了。", "en": "My turn to strike."},
        {"zh": "洞壁在我身上擦过。", "en": "The tunnel wall scrapes along me."},
        {"zh": "我感觉到它的重量。", "en": "I feel its weight."},
        {"zh": "土在微微震动。", "en": "The soil trembles faintly."},
        {"zh": "我又往前一节。", "en": "One more segment forward."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一卷，它倒了。", "en": "I coil; it goes down."},
        {"zh": "我的口器咬进去。", "en": "My mouthparts bite in."},
        {"zh": "它被压得动不了。", "en": "It can't move under me."},
        {"zh": "土被血浸了。", "en": "Blood soaks the soil."},
        {"zh": "它挣开一半。", "en": "It works half free."},
        {"zh": "我每一节都往死里箍", "en": "Every segment of me clamps down harder."},
        {"zh": "它没有声音。", "en": "It made no sound."},
        {"zh": "我的节环一节节夹紧。", "en": "My rings clamp one by one."},
        {"zh": "洞里安静下来。", "en": "The tunnel goes quiet."},
        {"zh": "我没有停口。", "en": "I don't stop biting."},
        {"zh": "它彻底不挣了。", "en": "It stopped struggling entirely."},
        {"zh": "我松了一圈，它还在动", "en": "I ease one coil off; it still moves."},
        {"zh": "我把它拖进去。", "en": "I drag it inside."},
        {"zh": "洞重新合上了。", "en": "The tunnel closes up."},
        {"zh": "我整个身体缠上去。", "en": "I wrap my whole body around it."},
        {"zh": "它在我下面抽动。", "en": "It twitches beneath me."},
        {"zh": "我把土盖在它身上。", "en": "I pull soil over it."},
        {"zh": "洞里全是土味。", "en": "The tunnel smells only of earth."},
        {"zh": "我松开节环，往后滑", "en": "I loosen my rings and slide back."},
        {"zh": "它的形状变了。", "en": "Its shape has changed."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地下的土松了一块。", "en": "A patch of soil loosens below."},
        {"zh": "我从深处钻上来。", "en": "I come up from deep down."},
        {"zh": "土堆在洞口。", "en": "Soil piles at the opening."},
        {"zh": "卡瓦林下面全是路。", "en": "There are paths everywhere under Kavarin."},
        {"zh": "我扭动身子试试。", "en": "I twist to test myself."},
        {"zh": "洞里静得可怕。", "en": "The tunnel is eerily still."},
        {"zh": "我听见上面的脚步。", "en": "I hear steps above."},
        {"zh": "我从洞底往上钻", "en": "I bore upward from the tunnel floor."},
        {"zh": "我把头探出去。", "en": "I poke my head out."},
        {"zh": "空气是干的。", "en": "The air is dry."},
        {"zh": "我探了探头，又沉下去", "en": "I poke my head out, then sink back."},
        {"zh": "我调转脑袋往另一边钻", "en": "I turn my head and bore the other way."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火灌进洞里，我的皮在收。", "en": "Fire pours in; my skin retracts."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从洞顶掉下来，节环撞散了。", "en": "I fall from the roof; my rings jar apart."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "泥水灌进来，我扭着往上。", "en": "Muddy water floods in; I twist upward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把洞震塌了。", "en": "The blast collapses the tunnel."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物穿进了土里的我。", "en": "A point goes through me in the soil."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我的节环都僵住。", "en": "That light freezes every ring."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得缩成一团。", "en": "Hunger curls me tight."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电顺着湿土传下来。", "en": "The current comes down through wet soil."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面没有土了。", "en": "There's no soil below."}
      ]
    }
  }
}
