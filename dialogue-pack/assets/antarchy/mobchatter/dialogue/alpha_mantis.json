{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我四足落地，甲板相撞有声。", "en": "I land on four legs; my plates clash."},
        {"zh": "前肢折在胸前，像两把刀。", "en": "My forelimbs fold at my chest like blades."},
        {"zh": "我沿着巢的边缘走。", "en": "I walk the rim of my nest."},
        {"zh": "地面的土被我的爪子翻开。", "en": "My claws turn the soil."},
        {"zh": "每走一步，草就折一片。", "en": "Each step snaps a patch of grass."},
        {"zh": "我每走一步，头就转一下。", "en": "With each step, I turn my head."},
        {"zh": "复眼里有很多个你。", "en": "You appear many times in my eyes."},
        {"zh": "我压着步子，沿巢巡过去。", "en": "I keep my stride low and patrol the nest."},
        {"zh": "我倒着退了半步。", "en": "I step back half a pace."},
        {"zh": "又往前压了一点。", "en": "Then press forward a little."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，前肢抬了一半。", "en": "I stand with forelimbs half raised."},
        {"zh": "甲壳上有旧的裂痕。", "en": "Old cracks mark my shell."},
        {"zh": "这些我不在意。", "en": "I do not mind these."},
        {"zh": "我的触角扫过一片草。", "en": "My antennae sweep across the grass."},
        {"zh": "我闻到了很多东西。", "en": "I smell many things."},
        {"zh": "其中一个是敌人。", "en": "One of them is an enemy."},
        {"zh": "我伏在草里没有出声。", "en": "I lie in the grass without a sound."},
        {"zh": "我数着草叶的动静。", "en": "I count the stirring of the grass."},
        {"zh": "翅膀又抖了一下。", "en": "My wings shiver again."},
        {"zh": "虫子从我脚边爬过。", "en": "An insect crawls past my feet."},
        {"zh": "我连塞甲缝都嫌它小。", "en": "An insect that small won't fill a seam."},
        {"zh": "这么小的东西，我懒得动。", "en": "Too small a thing to stir myself for."},
        {"zh": "我抬头看远处。", "en": "I look into the distance."},
        {"zh": "那片山是我的。", "en": "That ridge is mine."},
        {"zh": "那片林也是。", "en": "That forest too."},
        {"zh": "我一格一格地眨眼。", "en": "I blink notch by notch."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的复眼里，你有很多块。", "en": "My compound eyes split you into many pieces."},
        {"zh": "复眼里你没有死角。", "en": "In my eyes you have no blind spot."},
        {"zh": "我的前肢抬起来。", "en": "My forelimbs rise."},
        {"zh": "刀口对着你。", "en": "The edges face you."},
        {"zh": "你后退那一步，我看在眼里。", "en": "That one step back, I saw it."},
        {"zh": "前肢还没收回去。", "en": "My forelimbs are not yet lowered."},
        {"zh": "我把前肢放下。", "en": "I lower them."},
        {"zh": "这一次就算了。", "en": "Let this one pass."},
        {"zh": "你居然没有走。", "en": "You did not leave."},
        {"zh": "那你就看着。", "en": "Then watch."},
        {"zh": "我正对着你，甲板全开。", "en": "I face you squarely, plates spread."},
        {"zh": "让你看清我有多大。", "en": "Let you see how large I am."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了半步，甲板相撞。", "en": "I give half a step; my plates clash."},
        {"zh": "前肢一只抬不起来。", "en": "One forelimb won't lift."},
        {"zh": "壳上裂开一道。", "en": "A crack opens in my shell."},
        {"zh": "我把身体拧过来。", "en": "I twist my body around."},
        {"zh": "让裂口朝里。", "en": "Turning the crack inward."},
        {"zh": "流出来的血很黏。", "en": "My blood comes thick."},
        {"zh": "它顺着甲板流。", "en": "It runs along the plates."},
        {"zh": "我把裂口藏到内侧。", "en": "I turn the split inward."},
        {"zh": "我一点点撑住。", "en": "I brace myself bit by bit."},
        {"zh": "翅膀又开始抖。", "en": "My wings begin to shiver."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我的前肢只夹活的东西。", "en": "My forelimbs grip only what lives."},
        {"zh": "我只吃活的东西。", "en": "I only eat what lives."},
        {"zh": "你放下，我数你退几步。", "en": "Put it down, then step back three paces."},
        {"zh": "气味太淡，引不动我。", "en": "The scent is too faint to draw me."},
        {"zh": "气味太稀薄。", "en": "The scent is too thin."},
        {"zh": "我抬起眼来。", "en": "I lift my eyes."},
        {"zh": "你还没有走。", "en": "You have not left."},
        {"zh": "那你就是那口吃的。", "en": "Then you are the meal."},
        {"zh": "我的前肢又抬起来。", "en": "My forelimbs rise again."},
        {"zh": "这次不放下。", "en": "This time they stay up."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的甲板上。", "en": "You hit my plate."},
        {"zh": "像撞到一堵活的墙。", "en": "Like a living wall."},
        {"zh": "这点冲撞，让我挪了半寸。", "en": "That shove moved me half an inch."},
        {"zh": "我转了转身体。", "en": "I rotate my body."},
        {"zh": "前肢横过来。", "en": "My forelimbs come across."},
        {"zh": "你止住了脚。", "en": "You stop your feet."},
        {"zh": "我没有立刻出手。", "en": "I do not strike at once."},
        {"zh": "我停住，看你敢不敢再来。", "en": "I halt and watch whether you dare again."},
        {"zh": "草在我脚下断。", "en": "Grass snaps beneath me."},
        {"zh": "风把我的翅膀吹响。", "en": "Wind rattles my wings."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "巢里的事不由我。", "en": "The nest is not mine to decide."},
        {"zh": "我只守边界。", "en": "I only hold the boundary."},
        {"zh": "有幼虫在巢里叫。", "en": "Larvae call from within."},
        {"zh": "我不回头看。", "en": "I do not look back."},
        {"zh": "同族从我旁边过去。", "en": "Kin pass beside me."},
        {"zh": "同族过来，我也没让。", "en": "A kinsman came; I still did not yield."},
        {"zh": "巢口由我守着，谁也别进。", "en": "I guard the nest mouth; no one enters."},
        {"zh": "谁也不能进。", "en": "No one enters."},
        {"zh": "翅膀抖了两下。", "en": "My wings shiver twice."},
        {"zh": "我一直立在巢边。", "en": "I stand at the nest's edge."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它夹在两只刀口间。", "en": "A small piece, held between my blades."},
        {"zh": "它被我夹断了。", "en": "It snaps in my grip."},
        {"zh": "我用刀口拨了拨它。", "en": "I nudge it with my blade."},
        {"zh": "没用的，我踩进土里。", "en": "Useless; I press it into the soil."},
        {"zh": "没用的东西，我丢开。", "en": "Worthless thing; I cast it aside."},
        {"zh": "这个也勉强能用。", "en": "This will barely do."},
        {"zh": "我塞进口器下面。", "en": "I tuck it under my mouthparts."},
        {"zh": "我随手放下。", "en": "I set it down carelessly."},
        {"zh": "我不需要带东西。", "en": "I need carry nothing."},
        {"zh": "我的巢里什么都有。", "en": "My nest has everything."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西进了我的地界。", "en": "Something has entered my ground."},
        {"zh": "我一下子转过身。", "en": "I swing around at once."},
        {"zh": "前肢全部张开。", "en": "Both forelimbs open wide."},
        {"zh": "翅膀立起来。", "en": "My wings rise."},
        {"zh": "这样我看起来更大。", "en": "This makes me look larger."},
        {"zh": "我把甲压低到草面。", "en": "I drop my shell to grass level."},
        {"zh": "四只脚一起蹬地。", "en": "All four feet drive off."},
        {"zh": "我整个人扑出去。", "en": "I hurl myself out."},
        {"zh": "草被切开一条路。", "en": "The grass parts in a line."},
        {"zh": "它扭过身来。", "en": "It twists around."},
        {"zh": "慢得实在可笑。", "en": "Laughably slow."},
        {"zh": "我已经到它面前。", "en": "I am already in front of it."},
        {"zh": "前肢抬到最高。", "en": "My forelimbs reach their highest."},
        {"zh": "然后我把前肢落下。", "en": "Then my forelimbs come down."},
        {"zh": "它抬臂来挡。", "en": "It raises an arm to block."},
        {"zh": "前肢从上面绕过去。", "en": "My forelimbs come around above."},
        {"zh": "它已经来不及。", "en": "It is too late for it."},
        {"zh": "我一刀砸下去。", "en": "I strike down."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它正在绕圈。", "en": "It is circling."},
        {"zh": "我随它转动。", "en": "I rotate with it."},
        {"zh": "不着急出手。", "en": "No need to strike yet."},
        {"zh": "我看它的脚。", "en": "I watch its feet."},
        {"zh": "它往左边去。", "en": "It goes left."},
        {"zh": "我横移一步。", "en": "I sidestep."},
        {"zh": "它又往左边去。", "en": "It goes left again."},
        {"zh": "我又横着挪。", "en": "I sidestep again."},
        {"zh": "它绕到左边，我横过去。", "en": "It circles left; I slide across."},
        {"zh": "它撞上了我的影子。", "en": "It has hit my shadow."},
        {"zh": "它没地方去了。", "en": "It has nowhere left."},
        {"zh": "我把前肢举起来。", "en": "I raise my forelimbs."},
        {"zh": "刀口朝下压着。", "en": "The edges press downward."},
        {"zh": "这一下要它记住。", "en": "This blow must be remembered."},
        {"zh": "我砸落下去。", "en": "I crash down."},
        {"zh": "地上的草飞起来。", "en": "Grass sprays up."},
        {"zh": "它被扫得很远。", "en": "It is swept far."},
        {"zh": "我不必再动。", "en": "I need not move further."},
        {"zh": "它已经受了教育。", "en": "It has been taught."},
        {"zh": "我把前半身立得更高。", "en": "I raise my forebody higher."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "前肢斩下去，土都被切开。", "en": "My forelimb falls and cuts the soil."},
        {"zh": "它被扫得翻倒。", "en": "It is swept over."},
        {"zh": "我换另一只。", "en": "I switch to the other."},
        {"zh": "前肢扫开它的手臂。", "en": "My forelimb sweeps its arm aside."},
        {"zh": "它退到草外。", "en": "It backs out of the grass."},
        {"zh": "我的甲板撞过去，草断了。", "en": "My plates slam in; the grass snaps."},
        {"zh": "甲板撞进它的胸。", "en": "My plate drives into its chest."},
        {"zh": "它伏低了身子。", "en": "It stoops low."},
        {"zh": "前肢又抬起来。", "en": "My forelimbs rise again."},
        {"zh": "这一次我停住了。", "en": "This time I hold."},
        {"zh": "它已经不动。", "en": "It has stopped moving."},
        {"zh": "一刀扫过，我才退开。", "en": "One blade sweep, then I withdraw."},
        {"zh": "翅膀收在背上。", "en": "My wings fold against my back."},
        {"zh": "草上全是断口。", "en": "The grass is all cut edges."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "巢的边缘多了一道影子。", "en": "A shape appears at the nest's rim."},
        {"zh": "我把身体立直了。", "en": "I draw myself upright."},
        {"zh": "甲板一块块撑开。", "en": "My plates spread plate by plate."},
        {"zh": "前肢从胸前展开。", "en": "My forelimbs unfold from my chest."},
        {"zh": "翅膀立起来又贴回去。", "en": "My wings rise, then flatten."},
        {"zh": "我比同族大很多。", "en": "I am far larger than my kin."},
        {"zh": "从一出生就是这样。", "en": "It has been so since birth."},
        {"zh": "巢里的叫声停了。", "en": "The calls in the nest stop."},
        {"zh": "它们知道该安静。", "en": "They know to be quiet."},
        {"zh": "我走到最外面。", "en": "I walk to the outermost edge."},
        {"zh": "我从草里现身，比同族高。", "en": "I emerge from the grass, taller than my kin."},
        {"zh": "我面朝着来路。", "en": "I face the way in."},
        {"zh": "我闻到风从林子那边来。", "en": "The wind has shifted from the woods."},
        {"zh": "我从巢边立起，刀口朝外。", "en": "I rise at the nest edge, blades outward."},
        {"zh": "对着那个方向。", "en": "Toward it."},
        {"zh": "所以我守在最外面。", "en": "So I keep the outermost edge."},
        {"zh": "谁进来都得先过我。", "en": "Anyone entering must pass me first."},
        {"zh": "我一直这样等着。", "en": "I always wait like this."},
        {"zh": "很久也没关系。", "en": "A long wait is no trouble."},
        {"zh": "我立着，一夜都不会累。", "en": "I stand watch and never tire all night."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的甲，缝里冒烟。", "en": "Fire roasts my shell; smoke rises from the seams."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上翻下去，甲板磕碎一块。", "en": "I tumble off a slope and crack a plate."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进甲缝，我乱蹬。", "en": "Water enters my seams; I kick wildly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我翻了个身。", "en": "The blast rolls me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西卡在甲板缝里。", "en": "It wedges between my plates."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我的前肢定住。", "en": "A cold locks my forelimbs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得太久，前肢都在抖。", "en": "Hungry so long my forelimbs tremble."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我的甲上，亮了一片。", "en": "Lightning strikes my shell and lights a whole plate."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有地面可以蹬。", "en": "No ground to brace against."}
      ]
    }
  }
}
