    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我的肚子晃了。", "en": "You bumped me and my belly sloshed."},
        {"zh": "我侧身挪到石棱上。", "en": "I sidle onto the ledge."},
        {"zh": "这一下我差点吐出来。", "en": "That nearly made me spit."},
        {"zh": "我的腿抓稳了。", "en": "My legs have a good grip."},
