{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "六条腿错着走，肚子拖在后面。", "en": "Six legs step out of time; my belly drags behind."},
        {"zh": "我一边走一边鼓肚子。", "en": "I puff my abdomen as I walk."},
        {"zh": "我沿着石缝爬。", "en": "I crawl along the crack in the stone."},
        {"zh": "我的口器上挂着一点东西。", "en": "Something hangs from my mouthparts."},
        {"zh": "我拖着肚子挪过石面。", "en": "I drag my belly across the stone."},
        {"zh": "我从虫群中间穿过去。", "en": "I go through the middle of the swarm."},
        {"zh": "我在石头下绕了半圈。", "en": "I go half around under the stone."},
        {"zh": "我的腿在沙上划出印子。", "en": "My legs scratch lines in the sand."},
        {"zh": "我走到能看见下面的地方。", "en": "I move to where I can see below."},
        {"zh": "我又鼓了一下肚子。", "en": "I puff my abdomen again."},
        {"zh": "我停在虫群边上。", "en": "I stop at the edge of the swarm."},
        {"zh": "我慢慢地挪到高处。", "en": "I shift slowly up high."},
        {"zh": "我从石棱爬下去。", "en": "I crawl down off the ledge."},
        {"zh": "我又回到虫群里。", "en": "I've rejoined the swarm."},
        {"zh": "我沿着墙缝横着走。", "en": "I move sideways along the wall's crack."},
        {"zh": "我停下来鼓了一下。", "en": "I stop and puff once."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着，肚子一鼓一缩。", "en": "I lie still, my abdomen swelling and shrinking."},
        {"zh": "我的口器在慢慢地动。", "en": "My mouthparts work slowly."},
        {"zh": "我在听下面的动静。", "en": "I'm listening for movement below."},
        {"zh": "我的眼睛几乎不转。", "en": "My eyes barely move."},
        {"zh": "我在等一个够近的目标。", "en": "I'm waiting for a target close enough."},
        {"zh": "我的腿抓着石头。", "en": "My legs grip the stone."},
        {"zh": "肚子里的东西在晃。", "en": "What's in my belly sloshes."},
        {"zh": "我伏着，肚子还在胀。", "en": "I lie still, belly still swelling."},
        {"zh": "我的壳上有干掉的痕迹。", "en": "There are dried marks on my shell."},
        {"zh": "我又鼓了鼓。", "en": "I puff up again."},
        {"zh": "我的触角朝下指着。", "en": "My antennae point downward."},
        {"zh": "我在慢慢数着。", "en": "I'm counting slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你正上方的缝里。", "en": "I'm in the crack right above you."},
        {"zh": "我把口器抬起来了。", "en": "I've raised my mouthparts."},
        {"zh": "我的肚子鼓得很满。", "en": "My abdomen is full and swollen."},
        {"zh": "你不该站在那。", "en": "You shouldn't stand there."},
        {"zh": "我的头慢慢地转。", "en": "My head turns slowly."},
        {"zh": "我很远就能吐到。", "en": "I can spit a long way."},
        {"zh": "你正背对着我的口器。", "en": "Your back is turned to my mouthparts."},
        {"zh": "我嘴里的东西晃了晃。", "en": "The stuff in my mouth sloshes."},
        {"zh": "我先试了试风向。", "en": "I test the wind first."},
        {"zh": "我把头稍微低了一点。", "en": "I dip my head a fraction."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我往石缝深处退。", "en": "I retreat deeper into the crack."},
        {"zh": "这一下打在我肚子上。", "en": "That hit my abdomen."},
        {"zh": "我的腿一软。", "en": "My legs buckle."},
        {"zh": "我口器里流出来东西。", "en": "Something runs out of my mouthparts."},
        {"zh": "我慢慢地往缝里爬。", "en": "I crawl slowly into the crack."},
        {"zh": "肚子瘪下去一点。", "en": "My abdomen sags a little."},
        {"zh": "我憋住不出一点声。", "en": "I hold back every sound."},
        {"zh": "我轻轻地抖肚子。", "en": "I shake my abdomen gently."},
        {"zh": "我又爬回原先的角落。", "en": "I crawl back to my old corner."},
        {"zh": "这味道我留着了。", "en": "I'm keeping this smell."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "石下有东西在挪。", "en": "Something's shifting below the stone."},
        {"zh": "我把头压到石棱后面。", "en": "I lower my head behind the ledge."},
        {"zh": "我不必靠得很近。", "en": "I don't need to get close."},
        {"zh": "我侧过身，口器对准。", "en": "I turn sideways, mouthparts aimed."},
        {"zh": "肚子里的东西还没攒够。", "en": "I have not stored enough yet."},
        {"zh": "我口器上的东西在滴。", "en": "Something drips from my mouthparts."},
        {"zh": "你站在那里很好。", "en": "Standing there suits me."},
        {"zh": "我鼓了一下肚子。", "en": "I puffed my abdomen."},
        {"zh": "从这高度我吐得准。", "en": "From this height I'll hit clean."},
        {"zh": "我又闻了一下。", "en": "I sniff once more."}
      ]
