    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的口器一直没移开。", "en": "My mouthparts never shift away."},
        {"zh": "它往左，我的头跟着转。", "en": "It goes left; my head follows."},
        {"zh": "站在这儿就够得到。", "en": "From here I can already reach it."},
        {"zh": "它的路线我算好了。", "en": "I've worked out its path."},
        {"zh": "它站住，我就定住。", "en": "It stops, so I freeze."},
        {"zh": "我在等它露出脖子。", "en": "I wait for it to bare its neck."},
        {"zh": "虫群在下面聚拢。", "en": "The swarm is gathering below."},
        {"zh": "我的口器里越来越满。", "en": "My mouthparts are filling."},
        {"zh": "它走到开阔地了。", "en": "It's reached the open ground."},
        {"zh": "这个时机最好。", "en": "The timing is perfect."},
        {"zh": "我的肚子一缩。", "en": "My abdomen contracts."},
        {"zh": "它往石头那边跑了。", "en": "It's running for the rocks."}
