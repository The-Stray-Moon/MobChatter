    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "它的肚子鼓得比我满。", "en": "Its abdomen is fuller than mine."},
        {"zh": "它的肚子比我小。", "en": "Its abdomen is smaller than mine."},
        {"zh": "我们贴着趴在一处。", "en": "We lie pressed together."},
        {"zh": "我们一起鼓肚子。", "en": "We puff our abdomens together."},
