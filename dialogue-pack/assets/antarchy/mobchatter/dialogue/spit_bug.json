    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用口器叼起来。", "en": "I take it in my mouthparts."},
        {"zh": "这东西还在抽动。", "en": "This thing is still twitching."},
        {"zh": "我把它嚼了。", "en": "I chewed it up."},
        {"zh": "嚼不动，我原样吐出来。", "en": "It will not chew; I spit it out as it was."},
        {"zh": "我把它含在口器里。", "en": "I hold it in my mouthparts."},
