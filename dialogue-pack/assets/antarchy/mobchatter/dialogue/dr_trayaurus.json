{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在实验室里走来走去。", "en": "I pace around the laboratory."},
        {"zh": "我带着记录板走几步。", "en": "I walk a few steps with my clipboard."},
        {"zh": "我沿着工作台边巡视。", "en": "I make a round along the benches."},
        {"zh": "我绕过一堆仪器。", "en": "I go around a stack of instruments."},
        {"zh": "我慢慢走到门口。", "en": "I walk slowly to the doorway."},
        {"zh": "我停下来，看了看表。", "en": "I stop and check my watch."},
        {"zh": "我扶着镜框，穿过实验室。", "en": "I push up my glasses and cross the lab."},
        {"zh": "我走到样本柜前面。", "en": "I walk over to the sample cabinet."},
        {"zh": "我在走廊里踱着步。", "en": "I pace in the corridor."},
        {"zh": "我推了推眼镜，继续走。", "en": "I push up my glasses and walk on."},
        {"zh": "我朝窗边挪过去。", "en": "I move toward the window."},
        {"zh": "我又转回工作台。", "en": "I turn back to the bench."},
        {"zh": "我沿着书架走过去。", "en": "I walk past the bookshelves."},
        {"zh": "我一步步走近观察窗。", "en": "I step toward the observation window."},
        {"zh": "我把外衣拉了拉，站定。", "en": "I tug my coat and stand still."},
        {"zh": "我慢慢退到桌后。", "en": "I withdraw behind the desk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我低头写着什么。", "en": "I look down and write something."},
        {"zh": "我举起试管看了看。", "en": "I hold up a test tube and look."},
        {"zh": "我在等一批数据。", "en": "I'm waiting for a batch of data."},
        {"zh": "我的笔停在纸上。", "en": "My pen stops on the paper."},
        {"zh": "我推了推眼镜。", "en": "I push up my glasses."},
        {"zh": "我听见实验设备的响动。", "en": "I hear the equipment humming."},
        {"zh": "我在这里工作很久了。", "en": "I've worked here a long time."},
        {"zh": "我把记录板放在桌上。", "en": "I set the clipboard on the desk."},
        {"zh": "我慢慢敲了敲桌面。", "en": "I tap the table slowly."},
        {"zh": "我在想一个难题。", "en": "I'm pondering a hard problem."},
        {"zh": "我抬头看了看仪器。", "en": "I glance up at the instrument."},
        {"zh": "这里的东西都不能乱动。", "en": "Nothing here may be moved."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你来了，我正在记录。", "en": "You're here; I'm recording."},
        {"zh": "我摘下眼镜看了看你。", "en": "I take off my glasses to look at you."},
        {"zh": "你有新鲜样本吗？", "en": "Do you have a fresh sample?"},
        {"zh": "八个铀锭和一颗牙，对吧？", "en": "Eight uranium ingots and a tooth, yes?"},
        {"zh": "我这里有根汁汽水。", "en": "I have root beer here."},
        {"zh": "玉米热狗要不要？", "en": "Care for a corn dog?"},
        {"zh": "我在等我的邮件。", "en": "I'm waiting on my mail."},
        {"zh": "我说的每句都有依据。", "en": "Everything I say is grounded."},
        {"zh": "你先坐，我马上好。", "en": "Sit down; I'll be right there."},
        {"zh": "你看到窗外的海了吗？", "en": "Did you see the sea outside?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼镜歪了。", "en": "My glasses are askew."},
        {"zh": "这一下打到了我的肩。", "en": "That hit my shoulder."},
        {"zh": "我退了半步，扶住桌子。", "en": "I step back and grab the table."},
        {"zh": "仪器的读数都乱了。", "en": "The readings are scrambled."},
        {"zh": "我揉了揉被打的地方。", "en": "I rub where I was struck."},
        {"zh": "这完全不合科学。", "en": "That defies all science."},
        {"zh": "我的记录板上多了一道。", "en": "A mark appeared on my clipboard."},
        {"zh": "眼镜歪了，记录板还夹着。", "en": "My glasses sit crooked; my clipboard is still tucked."},
        {"zh": "我得重新记录一次。", "en": "I'll have to record it again."},
        {"zh": "请你冷静一点。", "en": "Please calm down."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "样本？让我看看。", "en": "A sample? Let me look."},
        {"zh": "这个品质不错。", "en": "This is of decent quality."},
        {"zh": "这铀锭的成色，你哪来的？", "en": "Where did you get uranium of this grade?"},
        {"zh": "放在托盘上就好。", "en": "Just set it on the tray."},
        {"zh": "这值得研究一下。", "en": "This merits study."},
        {"zh": "我先称一下重量。", "en": "Let me weigh it first."},
        {"zh": "我把它收进柜里。", "en": "I put it in the cabinet."},
        {"zh": "下回多带点，我拿汽水换。", "en": "Bring more next time; I'll trade root beer for it."},
        {"zh": "这正合我的实验。", "en": "This suits my experiment exactly."},
        {"zh": "我很满意这次交易。", "en": "I'm satisfied with this trade."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，我手上拿着东西。", "en": "Careful, my hands are full."},
        {"zh": "我把椅子挪开让路。", "en": "I move a chair out of the way."},
        {"zh": "这里有仪器，别撞。", "en": "Instruments here; don't bump them."},
        {"zh": "我那支试管差点掉了。", "en": "My test tube nearly fell."},
        {"zh": "我扶住桌子站稳。", "en": "I steady myself on the table."},
        {"zh": "实验室的走道很窄。", "en": "The lab aisle is narrow."},
        {"zh": "你撞到了我的记录板。", "en": "You knocked my clipboard."},
        {"zh": "我又把眼镜推上去了。", "en": "I push my glasses up again."},
        {"zh": "我整理了一下外衣。", "en": "I straighten my coat."},
        {"zh": "请你下次敲门。", "en": "Please knock next time."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "她也是实验室的研究员。", "en": "She's a researcher here too."},
        {"zh": "我们一起看同一份数据。", "en": "We read the same data together."},
        {"zh": "她把我的眼镜扶正了。", "en": "She straightens my glasses."},
        {"zh": "我们讨论到很晚。", "en": "We talk late into the night."},
        {"zh": "她笑起来很像某个人。", "en": "Her laugh reminds me of someone."},
        {"zh": "我们一起喝根汁汽水。", "en": "We drink root beer together."},
        {"zh": "实验室的灯一直亮着。", "en": "The lab lights stay on."},
        {"zh": "这一夜，数据也很漂亮。", "en": "Tonight the data is beautiful too."},
        {"zh": "明天还有实验。", "en": "There are experiments tomorrow."},
        {"zh": "我送她到门口。", "en": "I walk her to the door."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我戴上手套捡起来。", "en": "I put on a glove and pick it up."},
        {"zh": "我先称了称它。", "en": "I weigh it first."},
        {"zh": "这得登记一下。", "en": "This must be logged."},
        {"zh": "我把它放进托盘。", "en": "I set it on the tray."},
        {"zh": "标签写在这儿。", "en": "The label goes here."},
        {"zh": "这比看上去轻。", "en": "It's lighter than it looks."},
        {"zh": "我把它归到样本柜。", "en": "I file it in the sample cabinet."},
        {"zh": "这东西有研究价值。", "en": "This has research value."},
        {"zh": "我先拍照记录。", "en": "I photograph it first."},
        {"zh": "铀锭和克拉肯牙，收好了。", "en": "Uranium ingot and kraken tooth — stowed."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有个样本。", "en": "There's a sample there."},
        {"zh": "我看见了，别动它。", "en": "I see it; don't touch it."},
        {"zh": "我拎着记录板，慢慢靠近。", "en": "Clipboard in hand, I edge closer."},
        {"zh": "这值得看一眼。", "en": "That's worth a look."},
        {"zh": "那一处我圈进记录。", "en": "I note that spot in the log."},
        {"zh": "我开始记录。", "en": "I begin recording."},
        {"zh": "距离不远，两步。", "en": "Not far; two steps."},
        {"zh": "好，标记这一个。", "en": "Fine, I tag this one."},
        {"zh": "我戴上手套。", "en": "I put on my gloves."},
        {"zh": "手套戴好，笔也拿稳。", "en": "Gloves on, pen steady."},
        {"zh": "我先把灯调亮。", "en": "I brighten the lamp first."},
        {"zh": "好，实验现在开始。", "en": "Good, the experiment starts now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我踮脚一点点凑近。", "en": "I creep over on tiptoe."},
        {"zh": "我看清它的形状了。", "en": "I can make out its shape."},
        {"zh": "我再凑近一点。", "en": "I lean a little closer."},
        {"zh": "我的笔已经准备好了。", "en": "My pen is ready."},
        {"zh": "距离刚好够观察。", "en": "The distance is right for observation."},
        {"zh": "我换个角度看。", "en": "I change my viewing angle."},
        {"zh": "我记下了这个细节。", "en": "I've noted that detail."},
        {"zh": "再靠近一寸。", "en": "An inch closer."},
        {"zh": "这样就很完美了。", "en": "This is quite perfect."},
        {"zh": "我抬了抬眼镜。", "en": "I push up my glasses."},
        {"zh": "这就是我要的数据。", "en": "This is the data I wanted."},
        {"zh": "我慢慢伸手过去。", "en": "I reach out slowly."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手挡开了你。", "en": "I put a hand out to fend you off."},
        {"zh": "我用记录板挡了一下。", "en": "I block with my clipboard."},
        {"zh": "我撞翻了试管架，连忙扶住。", "en": "I knock over a rack of tubes and catch at it."},
        {"zh": "这不是我的强项。", "en": "This isn't my strength."},
        {"zh": "我抓起一支试管扔了。", "en": "I snatch a test tube and throw it."},
        {"zh": "玻璃在地上碎了。", "en": "Glass breaks on the floor."},
        {"zh": "我按住桌沿稳住自己。", "en": "I grip the bench to steady myself."},
        {"zh": "我叫了一声，声音不大。", "en": "I call out, not loudly."},
        {"zh": "我退到柜子旁边。", "en": "I retreat beside the cabinet."},
        {"zh": "这点力气不够用。", "en": "That strength isn't enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从实验室里抬起头。", "en": "I look up from my bench."},
        {"zh": "仪器响了一声，我转过身。", "en": "An instrument beeps and I turn."},
        {"zh": "特雷奥勒斯博士，在此。", "en": "Dr. Trayaurus, at your service."},
        {"zh": "我把护目镜推上额头。", "en": "I push my goggles up onto my forehead."},
        {"zh": "我从一堆仪器后面走出。", "en": "I step out from behind the instruments."},
        {"zh": "我手里拿着一份清单。", "en": "I'm holding a list."},
        {"zh": "实验室今天很安静。", "en": "The lab is very quiet today."},
        {"zh": "我抬头看了看你。", "en": "I look up at you."},
        {"zh": "我这儿正缺个帮手。", "en": "I'm short a helper here."},
        {"zh": "我把样本放回架子上。", "en": "I put the sample back on the rack."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的外衣烧了个洞。", "en": "A hole burned through my coat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从台阶上摔下去，记录板飞了。", "en": "I fall down the steps; my clipboard flies."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的护目镜里。", "en": "Water gets inside my goggles."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "实验室的玻璃全碎了。", "en": "All the lab glass shattered."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭钉在我的书架旁边。", "en": "An arrow sticks beside my bookshelf."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光的频率我没见过。", "en": "I've never seen that frequency of light."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我一整天没吃东西。", "en": "I haven't eaten all day."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打中了天线，读数全乱了。", "en": "Lightning hit the antenna; readings scrambled."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有实验室的地板。", "en": "There's no lab floor here."}
      ]
    }
  }
