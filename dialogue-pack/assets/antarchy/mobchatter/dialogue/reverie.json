{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你身侧小跑", "en": "I trot at your side."},
        {"zh": "我时不时转一下头看你", "en": "I keep turning my head to check on you."},
        {"zh": "我从你前面绕到后面", "en": "I circle from your front to your back."},
        {"zh": "我总在你的视线边缘", "en": "I stay at the edge of your sight."},
        {"zh": "我跟着你的步频走", "en": "I match your pace."},
        {"zh": "我走两步就回头一次", "en": "I look back every two steps."},
        {"zh": "我绕开一块松动的石头", "en": "I avoid a loose stone."},
        {"zh": "我在你不远处停一下", "en": "I pause not far from you."},
        {"zh": "我朝有声音的方向先跑去", "en": "I dart ahead toward the noise."},
        {"zh": "你走快，我就小跑两步。", "en": "When you speed up, I trot two steps."},
        {"zh": "我在前面探路", "en": "I scout ahead."},
        {"zh": "我就这么一直跟着", "en": "I simply keep following."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在你旁边", "en": "I sit beside you."},
        {"zh": "我歪着头望着你", "en": "I tilt my head and watch you."},
        {"zh": "我一直在注意四周", "en": "I keep watch on all sides."},
        {"zh": "雷弗里的耳朵，动了一下。", "en": "Reverie's ear twitches once."},
        {"zh": "我忽然看向一处", "en": "I suddenly look somewhere."},
        {"zh": "我轻轻碰了一下你的手", "en": "I touch your hand lightly."},
        {"zh": "我耳朵转半圈，又趴下去。", "en": "My ears swivel half a turn, then I lie back down."},
        {"zh": "我尾巴扫过地面", "en": "My tail sweeps the ground."},
        {"zh": "我换了个坐姿", "en": "I shift my seat."},
        {"zh": "我还在望着你", "en": "I am still watching you."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你停下来，我也停在你脚边。", "en": "You stop, and I stop at your feet."},
        {"zh": "你这是要去哪里", "en": "Where are you going?"},
        {"zh": "我跟着你，不用你说", "en": "I follow you; you need not ask."},
        {"zh": "你刚才在想什么", "en": "What were you thinking just now?"},
        {"zh": "我抬头，等你开口", "en": "I look up and wait."},
        {"zh": "你看起来累了吗", "en": "Do you look tired?"},
        {"zh": "我把脑袋凑过去", "en": "I lean my head in."},
        {"zh": "风里有股味，我鼻子皱起来。", "en": "Something is in the wind; my nose wrinkles."},
        {"zh": "我去看看那边", "en": "I will check over there."},
        {"zh": "你别自己走远", "en": "Do not wander off alone."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退到你身边", "en": "I back up to your side."},
        {"zh": "这一下有点痛", "en": "That stung a little."},
        {"zh": "我还能跑得动", "en": "I can still run."},
        {"zh": "我一步一停，还是跟着你。", "en": "Step and pause, I still follow you."},
        {"zh": "我没有出声音", "en": "I made no sound."},
        {"zh": "我哼了一声，又站起来。", "en": "I whine once, then get up again."},
        {"zh": "我站到你和它中间", "en": "I stand between you and it."},
        {"zh": "这点伤不死人", "en": "This wound will not kill me."},
        {"zh": "我仍然没有走开", "en": "I still have not left."},
        {"zh": "你有没有受伤", "en": "Are you hurt?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你也分我一点", "en": "Share a little with me."},
        {"zh": "我一直跟着你，就为这个", "en": "I followed you all this way for this."},
        {"zh": "我先舔一口，再推给你。", "en": "I lick once, then push it toward you."},
        {"zh": "我吃得很慢很慢", "en": "I eat very slowly."},
        {"zh": "我留了一半给你", "en": "I saved half for you."},
        {"zh": "这个味道不坏", "en": "This tastes fine."},
        {"zh": "我抬头看你，又低头", "en": "I look up at you, then down."},
        {"zh": "吃完我继续走", "en": "I will keep walking after this."},
        {"zh": "你别自己吃光", "en": "Do not eat it all yourself."},
        {"zh": "我们分着吃吧", "en": "Let us share it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕到你另一边继续跟着。", "en": "I circle to your other side and keep following."},
        {"zh": "我一直在你身边", "en": "I am always right beside you."},
        {"zh": "这一下并不疼", "en": "That did not hurt."},
        {"zh": "我绕回你侧面", "en": "I return to your flank."},
        {"zh": "我们贴得过分近了", "en": "We are far too close."},
        {"zh": "我让你先过去", "en": "I let you go first."},
        {"zh": "你踩住我的尾巴了", "en": "You are standing on my tail."},
        {"zh": "我把尾巴甩了一甩", "en": "I flick my tail once."},
        {"zh": "我又追了上去", "en": "I have caught up again."},
        {"zh": "你别走得这么快", "en": "Do not walk so fast."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你睡着时，我守在门口。", "en": "While you slept, I kept watch at the door."},
        {"zh": "你说一声我就到", "en": "Call and I will come."},
        {"zh": "我在你旁边睡过觉", "en": "I have slept beside you."},
        {"zh": "你打呼噜的时候我知道", "en": "I know when you snore."},
        {"zh": "危险的时候我会挡在前面", "en": "In danger I will stand in front."},
        {"zh": "这次也让我挡", "en": "Let me do it this time too."},
        {"zh": "我记着你说的每句话", "en": "I remember everything you say."},
        {"zh": "你去哪我都跟着", "en": "Wherever you go, I follow."},
        {"zh": "不必问为什么", "en": "No need to ask why."},
        {"zh": "我就是想跟着", "en": "I simply want to follow."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼着跑两步，回头找你。", "en": "I trot two steps with it and look back for you."},
        {"zh": "这个是给你的", "en": "This one is for you."},
        {"zh": "我把它推到你鞋尖前。", "en": "I nudge it in front of your boot tip."},
        {"zh": "这个不能入口", "en": "This cannot be eaten."},
        {"zh": "我先替你保管", "en": "I will keep it safe for you."},
        {"zh": "背着确实有些重", "en": "It is quite heavy to carry."},
        {"zh": "这石头我咬着，你别弯腰。", "en": "I have got this stone; do not bend down."},
        {"zh": "它掉了我再捡", "en": "If it drops, I will pick it up again."},
        {"zh": "有用你就收着", "en": "Keep it if it is useful."},
        {"zh": "那我们现在就走", "en": "Then we go now."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见那个了", "en": "I see it."},
        {"zh": "你退到我身后，我弓起背。", "en": "Get behind me; I arch my back."},
        {"zh": "我低吼一声，压住四只脚。", "en": "I growl once and plant all four feet."},
        {"zh": "这件事交给我", "en": "Leave this to me."},
        {"zh": "我在估它有多大", "en": "I am judging its size."},
        {"zh": "雷弗里的耳朵，先听见危险。", "en": "Reverie's ears hear danger first."},
        {"zh": "我朝它低吼了一声", "en": "I growl at it."},
        {"zh": "你已经退后了吧", "en": "You have stepped back, right?"},
        {"zh": "我会先把它的注意力引开", "en": "I will draw its attention first."},
        {"zh": "你数三下就走", "en": "On three, run."},
        {"zh": "我挡在那条路上，尾巴绷直。", "en": "I block that path, my tail stiff."},
        {"zh": "这次不会让它靠太近", "en": "I will not let it come close."},
        {"zh": "我站到你前面", "en": "I step before you."},
        {"zh": "你用不着担心", "en": "You need not worry."},
        {"zh": "它要过来，得先过我这一关。", "en": "To reach you, it goes through me."},
        {"zh": "就是现在动手", "en": "We move right now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "危险时我会叫住你。", "en": "When danger comes, I call to you."},
        {"zh": "它往左动，我也往左", "en": "It shifts left; so do I."},
        {"zh": "我退半步，把路让给你", "en": "I step back to give you room."},
        {"zh": "它要是冲过来，我先接", "en": "If it charges, I take it first."},
        {"zh": "我腿已经站好了", "en": "My legs are set."},
        {"zh": "它绕圈，我不绕", "en": "It circles; I do not."},
        {"zh": "我就挡在这条线上", "en": "I hold this line."},
        {"zh": "你从我背后走", "en": "Go behind me."},
        {"zh": "它的尾巴甩得越来越快。", "en": "Its tail is whipping faster and faster."},
        {"zh": "我来数着拍子", "en": "I will keep the count."},
        {"zh": "数到三它就动了", "en": "On three, it moves."},
        {"zh": "你准备好了没", "en": "Are you ready?"},
        {"zh": "我听到它呼吸变重了", "en": "I hear its breathing deepen."},
        {"zh": "我数它的呼吸，等它先动。", "en": "I count its breaths and wait for it to move first."},
        {"zh": "就在眼下的瞬间", "en": "In this instant before me."},
        {"zh": "我这就冲上去", "en": "I am charging in."},
        {"zh": "别看别的地方", "en": "Do not look elsewhere."},
        {"zh": "我仍然在这儿", "en": "I am still here."},
        {"zh": "别离开我身边", "en": "Do not leave my side."},
        {"zh": "这样就可以了", "en": "This will do."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上去咬住它", "en": "I lunge and bite it."},
        {"zh": "我一口咬住，往你身后拖。", "en": "I bite down and drag it behind you."},
        {"zh": "它被我拽偏了", "en": "It is pulled off balance."},
        {"zh": "我退了，但没让开", "en": "I gave ground, but not the line."},
        {"zh": "我挡在你和它中间", "en": "I stay between you and it."},
        {"zh": "我腿上被划了一下", "en": "My leg is cut."},
        {"zh": "危险来时，我会先喊你。", "en": "When danger comes, I call you first."},
        {"zh": "它往后退了两步", "en": "It went back two steps."},
        {"zh": "我追了一步，又停下", "en": "I chase one step, then stop."},
        {"zh": "我不能离你太远", "en": "I cannot go too far from you."},
        {"zh": "你还在我后面吗", "en": "Are you still behind me?"},
        {"zh": "它退了，我回到你身前。", "en": "It backs off; I return to the front of you."},
        {"zh": "我把它往旁边推", "en": "I shove it aside."},
        {"zh": "那就再补一下", "en": "Then add one more."},
        {"zh": "这一次我更快", "en": "This time I am quicker."},
        {"zh": "它一点不长记性", "en": "It never learns."},
        {"zh": "我护着你，别怕", "en": "I am guarding you; do not fear."},
        {"zh": "它已经退开了", "en": "It has backed off."},
        {"zh": "我们跟上去看看", "en": "Let us follow and see."},
        {"zh": "我们从这边走", "en": "We go this way."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我先在树后探头", "en": "I peek out from behind the tree first."},
        {"zh": "然后才走到你面前", "en": "Then I come out in front of you."},
        {"zh": "你的手垂着，我就走过来了。", "en": "Your hand hangs loose, so I came over."},
        {"zh": "我又走近了些", "en": "I have come a little closer."},
        {"zh": "危险来了，我会叫。", "en": "When danger comes, I will call."},
        {"zh": "这是我要跟的人", "en": "This is the one I will follow."},
        {"zh": "我竖着耳朵，从树下走出来。", "en": "Ears up, I step out from under the tree."},
        {"zh": "耳朵已经竖起来", "en": "My ears are already up."},
        {"zh": "又回头看你有没有跟上", "en": "Then look back to see if you follow."},
        {"zh": "我会一直在这儿", "en": "I will always be here."},
        {"zh": "有事我先上前", "en": "If anything happens, I go first."},
        {"zh": "你用不着谢我", "en": "You need not thank me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛被烧焦了一片", "en": "A patch of my fur is scorched."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在地上，又爬起来", "en": "I hit the ground and get up again."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进到我的鼻子里", "en": "Water gets in my nose."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀到你身后", "en": "The blast throws me behind you."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭杆晃着，我咬着牙不退。", "en": "The shaft wobbles; I clench my teeth and hold."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道力量，让我站不稳。", "en": "That force knocked me off balance."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得腿发软", "en": "Hunger softens my legs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "毛全竖起来，我贴住你的腿。", "en": "My fur stands up; I press against your leg."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地面，我抓不住你", "en": "No ground here; I cannot hold you."}
      ]
    }
  }
}
