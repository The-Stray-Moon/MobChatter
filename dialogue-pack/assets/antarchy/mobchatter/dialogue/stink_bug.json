{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢吞吞地爬着", "en": "I crawl along at my own pace."},
        {"zh": "背甲像一片盾", "en": "My back plate is shaped like a shield."},
        {"zh": "六条腿一步一步挪", "en": "Six legs carry me a step at a time."},
        {"zh": "走过的地方草都歪了", "en": "The grass bends where I've been."},
        {"zh": "我朝林子边上走", "en": "I head for the wood's edge."},
        {"zh": "触角一直没停", "en": "My antennae never stop."},
        {"zh": "前面好像有人", "en": "Someone's up ahead."},
        {"zh": "我没什么可急的", "en": "Nothing to hurry for."},
        {"zh": "反正他们会自己过来", "en": "They always come closer on their own."},
        {"zh": "我慢吞吞往前爬", "en": "I creep forward."},
        {"zh": "后面的气味很难散", "en": "The smell behind me lingers."},
        {"zh": "我走了一路，那味道也跟了一路", "en": "It follows me the whole way."},
        {"zh": "我跨过叶缘，落到下一片。", "en": "I cross the leaf edge onto the next."},
        {"zh": "叶子被压得往下弯", "en": "The leaf sags under me."},
        {"zh": "我换个轻点的落脚处", "en": "I shift to a lighter foothold."},
        {"zh": "这里能看见路上", "en": "From here I can see the path."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴在叶子上，背甲像一片盾。", "en": "I lie on the leaf, my back plate like a shield."},
        {"zh": "背甲对着上面", "en": "My back plate faces up."},
        {"zh": "颜色跟叶子差不多", "en": "My color nearly matches it."},
        {"zh": "我的肚子在鼓", "en": "My abdomen swells."},
        {"zh": "我抬起触角，闻到汗味。", "en": "I lift my antennae and smell sweat."},
        {"zh": "我趴伏着不动", "en": "I lie still."},
        {"zh": "等它再近一点", "en": "A little closer."},
        {"zh": "我把腹尖抬起来", "en": "I raise the tip of my abdomen."},
        {"zh": "我准对了方向", "en": "And aim it."},
        {"zh": "现在正是好时机", "en": "Now is the perfect time."},
        {"zh": "我听到了咳嗽声", "en": "I hear coughing."},
        {"zh": "那是我的功劳", "en": "That was my doing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从叶子上看你", "en": "I look at you from the leaf."},
        {"zh": "你还没有闻到", "en": "You haven't smelled it yet."},
        {"zh": "你马上就会闻到", "en": "But you will."},
        {"zh": "我把腹尖抬高了一点", "en": "I lift my abdomen tip a little."},
        {"zh": "你竟一步没退", "en": "You didn't retreat at all."},
        {"zh": "这倒是很勇敢", "en": "That's brave."},
        {"zh": "或者说很不聪明", "en": "Or very unwise."},
        {"zh": "我又动了一下", "en": "I shift again."},
        {"zh": "有味道散出来了", "en": "Something's leaking out."},
        {"zh": "你的鼻子会先知道", "en": "Your nose will know first."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下缩起来", "en": "I curl up."},
        {"zh": "腿都收到身下", "en": "Legs tuck beneath me."},
        {"zh": "甲上有一道裂", "en": "A crack in my shell."},
        {"zh": "我慢慢撑开来", "en": "I slowly unfold."},
        {"zh": "腹部撑得发紧", "en": "My abdomen feels stretched tight."},
        {"zh": "那是要喷的前兆", "en": "That's the warning before a spray."},
        {"zh": "你退远一点好", "en": "Better step further away."},
        {"zh": "我警告过一次了", "en": "That's one warning."},
        {"zh": "第二次就不是警告", "en": "The second won't be."},
        {"zh": "我把腹尖抬起", "en": "I raise my tail."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那边到底是什么", "en": "What's that?"},
        {"zh": "我爬近了一点", "en": "I crawl a little nearer."},
        {"zh": "我往前闻了闻", "en": "I sniff at it up close."},
        {"zh": "闻起来很不对劲", "en": "Wrong."},
        {"zh": "这东西根本不能吃", "en": "This can't be eaten."},
        {"zh": "那片烂叶，比你的手好闻。", "en": "That rotten leaf smells better than your hand."},
        {"zh": "我吃的是别的", "en": "I eat other things."},
        {"zh": "叶子底下那些", "en": "The ones under leaves."},
        {"zh": "你没看到而已", "en": "You just don't see them."},
        {"zh": "我继续找别的", "en": "I keep looking."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一放屁，你就得捏鼻子。", "en": "One puff and you hold your nose."},
        {"zh": "六条腿抓了一下叶子", "en": "Six legs grip the leaf."},
        {"zh": "差点就翻过去", "en": "Nearly rolled over."},
        {"zh": "我总算稳住了，卡瓦林的空气很臭。", "en": "I finally steadied; Khavarin's air stinks."},
        {"zh": "肚子鼓了一下", "en": "My abdomen swells once."},
        {"zh": "那是紧张鼓的", "en": "That's nerves."},
        {"zh": "再碰我，整片林子都臭。", "en": "Touch me again and the whole grove stinks."},
        {"zh": "我被你一碰，喷出一团雾。", "en": "Your touch makes me puff out a cloud."},
        {"zh": "这里离你更近", "en": "Closer to you here."},
        {"zh": "也更危险一点", "en": "And more dangerous."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们用气味找彼此", "en": "We find each other by scent."},
        {"zh": "那气味对我们很清晰", "en": "It's very clear to us."},
        {"zh": "对人就不太友好", "en": "Less friendly to other things."},
        {"zh": "我在叶片背面找到她", "en": "I find her under a leaf."},
        {"zh": "我们用触角碰了碰", "en": "Our antennae touch."},
        {"zh": "然后各自趴着", "en": "Then we both settle."},
        {"zh": "卵会产在叶背", "en": "Eggs go on the leaf's underside."},
        {"zh": "产成一簇一簇", "en": "In little clusters."},
        {"zh": "过些天就有小的", "en": "In a few days, the small ones."},
        {"zh": "它们也会这样走路", "en": "They'll walk the same way."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前足夹住", "en": "My forelegs take it."},
        {"zh": "举到口器前面", "en": "I bring it to my mouthparts."},
        {"zh": "我只咬了两下", "en": "Two bites."},
        {"zh": "吃着实在太干", "en": "Too dry."},
        {"zh": "我就把它放了", "en": "I let it go."},
        {"zh": "叶子上的汁更多", "en": "The leaf has more juice."},
        {"zh": "我又爬回去吸", "en": "I crawl back to sip."},
        {"zh": "这个要好得多", "en": "Better."},
        {"zh": "吸完了才离开", "en": "Then move on."},
        {"zh": "我爬得慢一点", "en": "Slowly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你再靠近，我就放臭气。", "en": "One step closer and I release my stench."},
        {"zh": "我把腹尖抬到最高", "en": "I raise my abdomen to its highest."},
        {"zh": "肚子里的东西在动", "en": "What's inside me stirs."},
        {"zh": "我已经对准了", "en": "Aimed."},
        {"zh": "这东西洗不掉", "en": "This won't wash off."},
        {"zh": "会跟着你一天", "en": "It'll follow you all day."},
        {"zh": "我开始数一二三", "en": "I count one, two, three."},
        {"zh": "这是我数第一声", "en": "One."},
        {"zh": "这是我数第二声", "en": "Two."},
        {"zh": "你居然还不退", "en": "You're still not backing off."},
        {"zh": "那就数到第三", "en": "Then three."},
        {"zh": "我一下喷出去", "en": "Spray."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我缀在你后头", "en": "I tag along behind you."},
        {"zh": "我走得并不快，可你总得停下来。", "en": "I am not fast, but you must stop sometime."},
        {"zh": "可你总得停下来", "en": "But you have to stop sometime."},
        {"zh": "我就在等你停", "en": "I'm waiting for it."},
        {"zh": "味道会一直散", "en": "The smell keeps leaking."},
        {"zh": "你开始闻到了", "en": "You're starting to notice."},
        {"zh": "你转头开始找", "en": "You turn to look."},
        {"zh": "我在叶子底下", "en": "I'm under a leaf."},
        {"zh": "一放屁，连你自己都受不了。", "en": "One blast and even you cannot stand it."},
        {"zh": "那个距离正好", "en": "That's just the range."},
        {"zh": "我把腹部抬起来", "en": "I lift my abdomen."},
        {"zh": "我正对着你，屁股翘起来。", "en": "I face you, rear end raised."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我轻轻喷了一下", "en": "I spray once."},
        {"zh": "一片雾散开来", "en": "A mist spreads out."},
        {"zh": "你立刻就退了", "en": "You recoil."},
        {"zh": "接着就开始咳", "en": "Then cough."},
        {"zh": "眼睛开始流泪", "en": "Your eyes water."},
        {"zh": "我趁机爬开去", "en": "While you're busy, I crawl off."},
        {"zh": "爬了两步又停下", "en": "Two steps and I stop."},
        {"zh": "我回头看了你", "en": "I look back."},
        {"zh": "你居然还在咳", "en": "Still coughing."},
        {"zh": "这味道能留很久", "en": "That smell will linger."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子背面多了个东西", "en": "Something appears under a leaf."},
        {"zh": "背甲反了一点光", "en": "My shield plate catches a little light."},
        {"zh": "我从叶背翻正，六足站稳。", "en": "I right myself from the leaf's underside, six feet planted."},
        {"zh": "六条腿找到位置", "en": "Six legs find their places."},
        {"zh": "我还没动，气味先散开。", "en": "Before I move, the smell spreads."},
        {"zh": "那是我带来的", "en": "I brought it."},
        {"zh": "我朝林子边爬", "en": "I crawl toward the wood's edge."},
        {"zh": "那边有人经过", "en": "Someone passes that way."},
        {"zh": "我沿着卡瓦林的叶脉爬。", "en": "I crawl along a Kavarin leaf vein."},
        {"zh": "一点都不用急", "en": "No rush."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "甲壳烤得发软", "en": "Heat softens my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我翻了几个身才停", "en": "I tumble several times before stopping."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我蹬不动", "en": "In water my legs can't push."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀到很远", "en": "The blast throws me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西打进了甲", "en": "Something lodges in my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "肚子里一阵翻", "en": "My abdomen churns."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得连爬都爬不动", "en": "Too hungry to crawl."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打得我腿都僵了", "en": "Lightning stiffens my legs."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子底下没有地", "en": "No ground under the leaf."}
      ]
    }
  }
}
