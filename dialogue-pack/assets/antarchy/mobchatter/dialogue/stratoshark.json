{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在高空的云层里游", "en": "I swim through clouds high above."},
        {"zh": "身体横着划过空气", "en": "My body slides sideways through the air."},
        {"zh": "尾鳍一摆，方向就变", "en": "One stroke of my tail changes my heading."},
        {"zh": "下面的陆地很小", "en": "The land below looks very small."},
        {"zh": "我能看见很远的地方", "en": "I can see a long way."},
        {"zh": "风从我鳃边穿过去", "en": "Wind passes through my gills."},
        {"zh": "我根本不需要水", "en": "I don't need water."},
        {"zh": "云比水轻得多", "en": "Cloud is so much lighter than water."},
        {"zh": "我绕着塔顶转了一圈", "en": "I circle a tower top once."},
        {"zh": "那里的气流很稳", "en": "The air is steady there."},
        {"zh": "我顺着气流滑出去", "en": "I ride the current out."},
        {"zh": "背鳍切开一片云", "en": "My dorsal fin cuts a cloud open."},
        {"zh": "云在我身后合上", "en": "It closes behind me."},
        {"zh": "我又找到一股上升的", "en": "I find an updraft."},
        {"zh": "停下，等它带我", "en": "I wait and let it carry me."},
        {"zh": "往更高的地方", "en": "Higher still."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "悬在半空，几乎不动", "en": "Hovering almost motionless."},
        {"zh": "鳍只是微微摆着", "en": "My fins sway slightly."},
        {"zh": "云从我身上飘过去", "en": "Cloud drifts past me."},
        {"zh": "下面是整片森林", "en": "A whole forest below."},
        {"zh": "我看得清每一条河", "en": "I can pick out every river."},
        {"zh": "有鸟在比我低的地方", "en": "Birds fly lower than me."},
        {"zh": "它们不往这上面来", "en": "They don't come up this high."},
        {"zh": "空气稀薄，很干净", "en": "The air is thin and clean."},
        {"zh": "我张嘴，风灌进来", "en": "I open my mouth and wind rushes in."},
        {"zh": "牙齿很尖，一排排", "en": "Rows of sharp teeth."},
        {"zh": "我把嘴慢慢合拢", "en": "I close my jaws slowly."},
        {"zh": "就那样继续悬着", "en": "And keep hovering."},
        {"zh": "这样的高度很好", "en": "This height suits me."},
        {"zh": "安静，也没有人", "en": "Quiet, and no one around."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "高空的风，只托得住我这副鳍。", "en": "Only these fins ride the high wind."},
        {"zh": "你像一粒小石子", "en": "You look like a pebble."},
        {"zh": "我慢慢压低高度", "en": "I drop my altitude slowly."},
        {"zh": "云在我下面分开", "en": "Cloud parts beneath me."},
        {"zh": "你朝上面抬头", "en": "You looked up."},
        {"zh": "他也许并没有", "en": "Maybe not."},
        {"zh": "我又降了一点", "en": "I drop a little more."},
        {"zh": "现在你能看清了", "en": "Now you can see clearly."},
        {"zh": "然后你开始跑", "en": "And you run."},
        {"zh": "跑也一点没用", "en": "Running won't help."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我在空中翻了一圈", "en": "I roll once in the air."},
        {"zh": "鳍断了一小截", "en": "A fin is torn a little."},
        {"zh": "我勉强稳住身体", "en": "I steady myself."},
        {"zh": "高度掉了不少", "en": "I've lost a lot of height."},
        {"zh": "我拍了两下尾", "en": "Two strokes of my tail."},
        {"zh": "重新往上爬升", "en": "And climb again."},
        {"zh": "血在空中散成雾", "en": "Blood sprays into mist."},
        {"zh": "一眨眼就没了", "en": "Gone in a blink."},
        {"zh": "我在高空游，鳍切开云。", "en": "I swim at height, fins cutting cloud."},
        {"zh": "上面要安全得多", "en": "It's safer up high."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "底下有人举着东西", "en": "Someone lifts something below."},
        {"zh": "我从云里探出头", "en": "I poke out of the cloud."},
        {"zh": "我探出头闻了闻", "en": "And sniff."},
        {"zh": "那分明是血味", "en": "Blood."},
        {"zh": "我喜欢那味道", "en": "I like that smell."},
        {"zh": "我慢慢往下滑", "en": "I slide downward."},
        {"zh": "我转了半圈身", "en": "Half a turn."},
        {"zh": "然后在云里收住", "en": "Then hold."},
        {"zh": "只是还不够近", "en": "Not close enough."},
        {"zh": "你再举高一点", "en": "Hold it higher."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我从云里撞出来", "en": "I burst out of the cloud."},
        {"zh": "撞上的是一股气流", "en": "What I hit was a current."},
        {"zh": "身体歪了一下", "en": "My body tilts."},
        {"zh": "我调整了鳍位", "en": "I adjust my fins."},
        {"zh": "身体又稳住了", "en": "Steady again."},
        {"zh": "你在下面躲着", "en": "You're dodging below."},
        {"zh": "云散开，我看清你的位置。", "en": "The clouds part; I see exactly where you are."},
        {"zh": "只是角度不对", "en": "Only the angle's wrong."},
        {"zh": "我又绕了过去", "en": "I circle around."},
        {"zh": "现在角度对了", "en": "Now the angle's right."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "高处有别的影子", "en": "Another shape up high."},
        {"zh": "它也横着游动", "en": "It swims sideways too."},
        {"zh": "我们互相绕了两圈", "en": "We circle each other twice."},
        {"zh": "两只尾鳍错开", "en": "Our tails pass."},
        {"zh": "然后一起往云深处去", "en": "Then into the deep cloud together."},
        {"zh": "那里一个人没有", "en": "No one up there."},
        {"zh": "也没有任何方向", "en": "And no directions."},
        {"zh": "只剩下风和云", "en": "Only wind and cloud."},
        {"zh": "我们就这样游", "en": "So we swim."},
        {"zh": "我们就一直游", "en": "On and on."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我收起鳍，从云里俯冲。", "en": "I fold my fins and dive out of the clouds."},
        {"zh": "我的牙在云层里合拢。", "en": "My teeth close in the cloud layer."},
        {"zh": "然后往上飞起", "en": "Then climb."},
        {"zh": "嘴里紧紧叼着", "en": "Held in my jaws."},
        {"zh": "血一路往下滴", "en": "Blood drips down."},
        {"zh": "滴到很远的树上", "en": "Onto distant trees."},
        {"zh": "我绕回云层里", "en": "I circle back into the cloud."},
        {"zh": "在那里慢慢吃", "en": "And eat slowly there."},
        {"zh": "那里没人会看见", "en": "No one will see."},
        {"zh": "这样反而更好", "en": "Better that way."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "下头有什么在挪", "en": "Something shifts down there."},
        {"zh": "我把身形压平", "en": "I flatten my shape."},
        {"zh": "鳍全部收拢好", "en": "Fins pulled in."},
        {"zh": "风在耳边响，我开始下坠。", "en": "Wind roars past as I begin to fall."},
        {"zh": "云一层层分开", "en": "Cloud peels back in layers."},
        {"zh": "越高越快，风推着我。", "en": "The higher I go, the faster, the wind pushes me."},
        {"zh": "风在耳边响着", "en": "Wind roars past."},
        {"zh": "你已经听见了", "en": "You've heard it."},
        {"zh": "你抬头看看吧", "en": "Look up."},
        {"zh": "现在已经来不及", "en": "Too late."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "高空的鲨，翅在云里。", "en": "A sky shark, wings in the clouds."},
        {"zh": "一圈比一圈低", "en": "Each circle lower."},
        {"zh": "你完全看不到我", "en": "You simply can't see me."},
        {"zh": "云层挡在中间", "en": "The cloud is between us."},
        {"zh": "风把我的影子吹散", "en": "The wind scatters my shadow."},
        {"zh": "你只能听见声音", "en": "You can only hear."},
        {"zh": "一阵一阵的响", "en": "On and off."},
        {"zh": "像很远的雷声", "en": "Like distant thunder."},
        {"zh": "那其实不是雷", "en": "It isn't thunder."},
        {"zh": "我又低了一圈", "en": "Another circle lower."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲下来咬", "en": "I dive and bite."},
        {"zh": "牙齿一排排合上", "en": "Rows of teeth close."},
        {"zh": "咬到的是护甲", "en": "I get armor."},
        {"zh": "利齿在铁面一滑", "en": "My teeth slide off metal."},
        {"zh": "我赶紧拉起高度", "en": "I pull up."},
        {"zh": "然后再绕回来", "en": "And come around."},
        {"zh": "第二次角度更好", "en": "The second pass is better."},
        {"zh": "这次咬在肩上", "en": "This time I find your shoulder."},
        {"zh": "血一下溅出来", "en": "Blood sprays."},
        {"zh": "我绝对不会松口", "en": "I don't let go."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "云层里开了一道口子", "en": "A gap opens in the cloud."},
        {"zh": "我从中滑出来", "en": "I slide out of it."},
        {"zh": "背鳍先探出来", "en": "Dorsal fin first."},
        {"zh": "然后整个身体", "en": "Then the whole body."},
        {"zh": "这里的天很高", "en": "The sky is high here."},
        {"zh": "云层也非常多", "en": "Plenty of cloud."},
        {"zh": "高空的冷风，正合我意。", "en": "The cold wind at this height suits me."},
        {"zh": "我把鳃张开了", "en": "I open my gills."},
        {"zh": "风从里面穿过去", "en": "Wind runs through them."},
        {"zh": "我还活得好好的", "en": "Still alive."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在云里烧不起来", "en": "Fire can't catch in cloud."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下去，撞在树冠上", "en": "I fall and hit the canopy."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水比空气沉，我往下沉", "en": "Water is heavier. I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我推得翻滚", "en": "The blast sends me tumbling."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿破了我的鳍", "en": "Something punches through my fin."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "气流不受控了", "en": "The currents won't obey me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得连滑都滑不动", "en": "Too hungry to glide."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷和云一起炸开", "en": "Lightning bursts with the cloud."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面没有云，也没有地", "en": "No cloud below. No ground."}
      ]
    }
  }
}
