{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬着前肢，一步一步走。", "en": "I walk with my forelimbs raised."},
        {"zh": "翅膀贴在背上，很薄。", "en": "My wings lie thin on my back."},
        {"zh": "我踩在草叶上，草弯了。", "en": "I step on a blade; it bends."},
        {"zh": "我的头能转过半圈。", "en": "My head can turn half a circle."},
        {"zh": "我六条腿走得很轻。", "en": "I walk lightly on six legs."},
        {"zh": "我在草丛间找路。", "en": "I pick a way through the grass."},
        {"zh": "我的前肢上有刺。", "en": "There are spines on my forelimbs."},
        {"zh": "我从一片叶走到另一片。", "en": "I go from leaf to leaf."},
        {"zh": "我收住腿，脑袋对准你", "en": "I stop my legs and level my head at you."},
        {"zh": "我的绿色和草很像。", "en": "My green matches the grass."},
        {"zh": "我绕到那棵树的背面。", "en": "I work around the back of that tree."},
        {"zh": "灌木里我更好藏。", "en": "I hide better in the bushes."},
        {"zh": "我慢慢举起一条前肢。", "en": "I slowly raise a forelimb."},
        {"zh": "我在林子里兜了一圈。", "en": "I made a circuit of the wood."},
        {"zh": "脚步一点声音都没有。", "en": "My steps make no sound."},
        {"zh": "我沿着树皮往上爬。", "en": "I climb up the bark."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把前肢收到胸前。", "en": "I fold my forelimbs to my chest."},
        {"zh": "我把自己摆成一片嫩叶", "en": "I arrange myself into a young leaf."},
        {"zh": "我的复眼在转。", "en": "My compound eyes shift."},
        {"zh": "我在听虫鸣。", "en": "I'm listening to insects."},
        {"zh": "我的口器慢慢磨动。", "en": "My mouthparts grind slowly."},
        {"zh": "风一吹，草就动了。", "en": "The wind moves the grass."},
        {"zh": "我等一个不小心的小东西。", "en": "I wait for something careless."},
        {"zh": "我的肚子在轻轻抽动。", "en": "My abdomen pulses."},
        {"zh": "我趴在一片叶子下面。", "en": "I lie under a leaf."},
        {"zh": "我盯着草尖之外的地方", "en": "I fix on the ground beyond the grass tips."},
        {"zh": "我又把前肢举起来。", "en": "I raise my forelimbs again."},
        {"zh": "我很有耐性。", "en": "I'm patient."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我眼里像一棵树", "en": "You look like a tree to me."},
        {"zh": "我把三角脑袋侧过来", "en": "I tip my triangular head to one side."},
        {"zh": "我的前肢是折起来的。", "en": "My forelimbs are folded."},
        {"zh": "你踩到了我旁边的草。", "en": "You stepped on the grass beside me."},
        {"zh": "我退到叶子的背面。", "en": "I slip to the back of the leaf."},
        {"zh": "这片草丛归我管", "en": "This patch of grass answers to me."},
        {"zh": "我盯住你的手指。", "en": "I fix on your fingers."},
        {"zh": "你一动我就知道。", "en": "I'll know the moment you move."},
        {"zh": "我不怕，但我会等。", "en": "I'm not afraid, but I'll wait."},
        {"zh": "手别靠近草里。", "en": "Keep your hand out of the grass."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一弹腿，滑到草丛后", "en": "I kick off and slip behind the grass."},
        {"zh": "一条腿不太灵活了。", "en": "One leg isn't working well."},
        {"zh": "我抬起前肢护住自己。", "en": "I raise my forelimbs to guard."},
        {"zh": "我一点动静都没有。", "en": "I make no movement at all."},
        {"zh": "翅膀歪了一点。", "en": "A wing is a bit bent."},
        {"zh": "我退到叶子背面。", "en": "I retreat under a leaf."},
        {"zh": "绿色的液体渗出来。", "en": "Green fluid seeps out."},
        {"zh": "我还可以爬。", "en": "I can still crawl."},
        {"zh": "我又把前肢张开。", "en": "I spread my forelimbs again."},
        {"zh": "我歪着脑袋，一动不动", "en": "I keep my head cocked, perfectly still."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有小虫的味道。", "en": "That smells of insect."},
        {"zh": "搁在叶子上就行。", "en": "Leave it on the leaf."},
        {"zh": "我慢慢举起前肢。", "en": "I raise my forelimbs slowly."},
        {"zh": "这个太近了。", "en": "That's too close."},
        {"zh": "我等着它动。", "en": "I wait for it to move."},
        {"zh": "活的我更有兴趣。", "en": "I prefer it alive."},
        {"zh": "我往前挪了一节。", "en": "I shift forward a notch."},
        {"zh": "我一口都吃不饱", "en": "One mouthful won't fill me."},
        {"zh": "我先看一看。", "en": "Let me look first."},
        {"zh": "我不是很饿。", "en": "I'm not very hungry."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到了我的腿。", "en": "You touched my leg."},
        {"zh": "我一下跳开。", "en": "I spring away."},
        {"zh": "我的翅膀响了一下。", "en": "My wings whirred once."},
        {"zh": "我晃了晃，又贴稳叶面", "en": "I sway, then settle back onto the leaf."},
        {"zh": "草叶来回乱晃。", "en": "The grass blade shakes."},
        {"zh": "我重新抬起前肢。", "en": "I raise my forelimbs again."},
        {"zh": "你只碰倒了我身边的草叶", "en": "All you knocked over was the grass beside me."},
        {"zh": "这点重量我扛得住。", "en": "I can take that much weight."},
        {"zh": "我又退远了些。", "en": "I backed off a bit more."},
        {"zh": "我侧着身子走开。", "en": "I sidle away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只在灌木顶上。", "en": "Another is on top of the bush."},
        {"zh": "她的前肢比我细。", "en": "Her forelimbs are slimmer than mine."},
        {"zh": "我们绕着枝走了一圈。", "en": "We circle the branch once."},
        {"zh": "她的翅膀打开了。", "en": "She opened her wings."},
        {"zh": "我靠过去，很慢。", "en": "I come close, slowly."},
        {"zh": "我们的触角碰了一下。", "en": "Our antennae touched."},
        {"zh": "她往上爬，我跟着。", "en": "She climbs; I follow."},
        {"zh": "她的绿色偏黄。", "en": "Her green is more yellow."},
        {"zh": "我们连触角都不碰响", "en": "We don't even let our antennae click."},
        {"zh": "她停在一片叶上。", "en": "She stopped on a leaf."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起一只小虫。", "en": "I take up a small insect."},
        {"zh": "它还在蹬腿。", "en": "It's still kicking."},
        {"zh": "我用前肢夹住了。", "en": "I hold it in my forelimbs."},
        {"zh": "这块是叶子。", "en": "This is a leaf."},
        {"zh": "我把它拨下叶子。", "en": "I flick it off the leaf."},
        {"zh": "我舌尖上有一点甜", "en": "There's a little sweetness on my tongue."},
        {"zh": "我放下又拿起来。", "en": "I set it down, then lift it again."},
        {"zh": "这么小，我夹都夹不住", "en": "So small I can't even grip it."},
        {"zh": "它从我手里掉了。", "en": "It fell from my grip."},
        {"zh": "我夹着它慢慢挪开", "en": "I carry it away at a slow crawl."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "草动了一下。", "en": "The grass moved."},
        {"zh": "我抬起了前肢。", "en": "I raised my forelimbs."},
        {"zh": "我的眼睛盯着那里。", "en": "My eyes are fixed there."},
        {"zh": "它的个头还不到我一半", "en": "It's less than half my size."},
        {"zh": "我把身子伏到草根高度", "en": "I drop to the height of the grass roots."},
        {"zh": "风正好朝我这边。", "en": "The wind is at my side."},
        {"zh": "我又挪近了一寸", "en": "I edge an inch closer."},
        {"zh": "它没有发觉。", "en": "It hasn't noticed."},
        {"zh": "我的腿收紧了。", "en": "My legs coil."},
        {"zh": "前肢举到位了。", "en": "My forelimbs are set."},
        {"zh": "我算好了落爪的位置", "en": "I've worked out where my claws will land."},
        {"zh": "我等的就是这个空隙", "en": "This is the gap I was waiting for."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我追着它挪。", "en": "I creep after it."},
        {"zh": "我一叶一叶地挪过去", "en": "I work my way over, leaf by leaf."},
        {"zh": "我盯着叶背那道阴影", "en": "I fix on the shadow under the leaf."},
        {"zh": "我绕到上面。", "en": "I work around above."},
        {"zh": "我的前肢一直举着。", "en": "My forelimbs stay up."},
        {"zh": "它的脚步停了。", "en": "Its steps stop."},
        {"zh": "我也收住腿。", "en": "I check my legs too."},
        {"zh": "距离只有一掌。", "en": "A palm's width away."},
        {"zh": "它在往我这边看。", "en": "It's looking my way."},
        {"zh": "我又往下压了压。", "en": "I sink a little lower."},
        {"zh": "它的呼吸快了。", "en": "Its breathing quickened."},
        {"zh": "我一下就出手。", "en": "I strike in one go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "前肢一收，夹住它。", "en": "My forelimbs snap shut."},
        {"zh": "刺扎了进去。", "en": "The spines go in."},
        {"zh": "它在我手里乱动。", "en": "It thrashes in my grip."},
        {"zh": "我低头，把口器咬进它", "en": "I dip my head and bite my mouthparts into it."},
        {"zh": "血在我口器边上。", "en": "Blood is at my mouthparts."},
        {"zh": "我一口口嚼。", "en": "I chew it piece by piece."},
        {"zh": "翅膀抖了一下。", "en": "My wings twitch."},
        {"zh": "它不再挣了。", "en": "It stopped struggling."},
        {"zh": "我把它叼到叶上。", "en": "I carry it onto the leaf."},
        {"zh": "周围非常安静。", "en": "It's very quiet around."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一片叶子上多了个影子。", "en": "A shadow appears on a leaf."},
        {"zh": "我从灌木里出来。", "en": "I come out of the bush."},
        {"zh": "我的绿色混在草里。", "en": "My green blends with the grass."},
        {"zh": "我把头抬到草尖高。", "en": "I raise my head to the grass tips."},
        {"zh": "林子很热闹。", "en": "The wood is lively."},
        {"zh": "我找到一处好的枝。", "en": "I found a good branch."},
        {"zh": "我把前肢收在胸前。", "en": "I fold my forelimbs to my chest."},
        {"zh": "风把草吹得压下去。", "en": "The wind flattens the grass."},
        {"zh": "我钻进更密的草丛", "en": "I slip into the thicker grass."},
        {"zh": "这地方有虫子。", "en": "There are insects here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一过，我的前肢就卷了。", "en": "Fire passes and my forelimbs curl."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从枝上掉下去，翻了个身。", "en": "I fall from the branch, flipping."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我整只淹了。", "en": "Water covers me entirely."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我甩进草里。", "en": "The blast throws me into the grass."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭从我的薄翅中间穿过", "en": "An arrow passes through the middle of my thin wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我的腿僵住。", "en": "That light stiffens my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得前肢都抬不起来。", "en": "Too hungry to raise my forelimbs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把我照成一团白。", "en": "Lightning turns me a ball of white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有草，也没有叶。", "en": "No grass, no leaves."}
      ]
    }
  }
}
