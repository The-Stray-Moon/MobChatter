{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着天花板走。", "en": "I move along the ceiling."},
        {"zh": "我的翅膀扫过石面。", "en": "My wings brush the stone."},
        {"zh": "我慢慢降下一点。", "en": "I drop a little lower."},
        {"zh": "我绕着坑口盘旋。", "en": "I circle the pit's mouth."},
        {"zh": "我的尾巴拖在下面。", "en": "My tail trails beneath me."},
        {"zh": "我朝声音那边飞。", "en": "I fly toward the sound."},
        {"zh": "我的爪子收在胸前。", "en": "My claws tuck under my chest."},
        {"zh": "我从阴影里滑出来。", "en": "I slip out of the shadow."},
        {"zh": "我在这片天花板下巡。", "en": "I patrol beneath this ceiling."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒挂在石顶。", "en": "I hang from the stone roof."},
        {"zh": "我的翅膀半张着。", "en": "My wings are half spread."},
        {"zh": "我挂在天花板上，尾巴垂进黑暗。", "en": "I hang from the ceiling, tail dangling into the dark."},
        {"zh": "这里的天花板很低。", "en": "The ceiling is low here."},
        {"zh": "我半张着翅挂在顶。", "en": "I stay still."},
        {"zh": "我在等猎物抬头。", "en": "I wait for prey to look up."},
        {"zh": "石顶上面很冷。", "en": "The stone roof is cold."},
        {"zh": "石顶下面我静静守着。", "en": "I'm doing nothing."},
        {"zh": "光从下面照上来。", "en": "Light shines up from below."},
        {"zh": "我数着下面的人。", "en": "I count those below."},
        {"zh": "等它自己抬起头。", "en": "I wait a bit."},
        {"zh": "我的爪子刮着石。", "en": "My claws scrape the stone."},
        {"zh": "这一片天花板归我。", "en": "This is my place."},
        {"zh": "我把嘴慢慢张开。", "en": "I open my jaws slowly."},
        {"zh": "又把它们合上了。", "en": "And close them."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你仰头时，我的影子正好落下。", "en": "When you look up, my shadow falls right across you."},
        {"zh": "你听见翅膀的声音吗？", "en": "Do you hear the wings?"},
        {"zh": "下面的人都爱抬头。", "en": "Those below always look up."},
        {"zh": "我的尾巴比你的腿长。", "en": "My tail is longer than your leg."},
        {"zh": "你站的地方很空。", "en": "You're standing in the open."},
        {"zh": "我是女王麾下的。", "en": "I serve the Queen."},
        {"zh": "你根本逃不掉的。", "en": "You can't run."},
        {"zh": "你身上有股铁锈味。", "en": "You smell of iron."},
        {"zh": "我一点都不焦急。", "en": "I'm in no hurry."},
        {"zh": "我等你走到中间。", "en": "I wait for you to reach the middle."},
        {"zh": "这里没有柱子挡着。", "en": "No pillar blocks the way here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀破了一道。", "en": "A tear in my wing."},
        {"zh": "我的翅膜破了个口，气流直往里灌。", "en": "A hole tears in my wing membrane and air rushes in."},
        {"zh": "我咆哮了一声。", "en": "I roared."},
        {"zh": "血从爪上滴下来。", "en": "Blood drips from my claws."},
        {"zh": "我退了到石柱后。", "en": "I retreat behind a pillar."},
        {"zh": "这不影响我飞。", "en": "It doesn't stop me flying."},
        {"zh": "空中一撕，我记住了这味道。", "en": "One tear from the air, and I remember the taste."},
        {"zh": "你再挨上来试试。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我要活的猎物。", "en": "I want it alive."},
        {"zh": "你举起手也没用。", "en": "Raising it won't help."},
        {"zh": "把它搁到地上去。", "en": "Put it down."},
        {"zh": "那个实在太干了。", "en": "That's too dry."},
        {"zh": "我更喜欢热的东西。", "en": "I prefer warm things."},
        {"zh": "这块肉你带回去。", "en": "Keep it."},
        {"zh": "这些还远远不够。", "en": "Not enough."},
        {"zh": "我不为此下来。", "en": "I won't come down for that."},
        {"zh": "快把这干东西挪开。", "en": "Take it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我把高度又提了些。", "en": "I rose a little."},
        {"zh": "别跳起来抓我。", "en": "Don't jump for me."},
        {"zh": "这点磕碰碍不着我。", "en": "That impact means nothing."},
        {"zh": "快给我让开路。", "en": "Move."},
        {"zh": "你站得太靠中间了。", "en": "You're too far into the middle."},
        {"zh": "你的帽子擦过我的爪尖，我抬高了。", "en": "Your hat grazes my talon tip, and I climb higher."},
        {"zh": "撞上我的翅膀，你会飞出去。", "en": "Hit my wings and you'll be thrown."},
        {"zh": "别顶我胸口，那不是门。", "en": "Don't butt my chest — it's not a door."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是女王的人。", "en": "I belong to the Queen."},
        {"zh": "我从天花板倒挂下来。", "en": "I hang down from the ceiling."},
        {"zh": "这层天花板不需要那些。", "en": "This ceiling has no need of that."},
        {"zh": "我在守着这个口。", "en": "I'm guarding this opening."},
        {"zh": "你给我退到墙角去。", "en": "Move."},
        {"zh": "你别在下面纠缠我。", "en": "Don't bother me."},
        {"zh": "我只听女王的。", "en": "I only answer the Queen."},
        {"zh": "我对此没有兴趣。", "en": "Not interested."},
        {"zh": "滚到石柱外面去。", "en": "Get lost."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抓起来看看。", "en": "I snatch it up and look."},
        {"zh": "这血还不是新鲜的。", "en": "Not meat."},
        {"zh": "它沉得我抓不稳。", "en": "Too heavy."},
        {"zh": "我把它从空中丢下。", "en": "I drop it."},
        {"zh": "它在我爪里晃。", "en": "It swings in my claw."},
        {"zh": "这块肉也不新鲜。", "en": "This is useless."},
        {"zh": "这是哪个掉的垃圾？", "en": "Whose is this?"},
        {"zh": "我把它甩掉了。", "en": "I flung it off."},
        {"zh": "这个你自己留着。", "en": "Keep it."},
        {"zh": "你把它接住了。", "en": "Catch."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "下面有个活人。", "en": "Someone below."},
        {"zh": "我低头往下看。", "en": "I look down."},
        {"zh": "我从天花板俯冲，翅尖划出风声。", "en": "I dive from the ceiling, my wingtips tearing the air."},
        {"zh": "这个距离一扑就到。", "en": "One dive covers it."},
        {"zh": "他站在正中间。", "en": "He's in the middle."},
        {"zh": "我先咆哮一声。", "en": "First, a roar."},
        {"zh": "我闻到他的气味。", "en": "I smell him."},
        {"zh": "他一直不抬头。", "en": "He won't look up."},
        {"zh": "趁它还没躲进柱后。", "en": "Now."},
        {"zh": "我这就扑下去了。", "en": "I dive."},
        {"zh": "你别想着逃出坑口。", "en": "Don't run."},
        {"zh": "就这么扑一次。", "en": "Just this once."},
        {"zh": "我这就下来了。", "en": "Here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在他头上盘旋。", "en": "I circle above him."},
        {"zh": "我的影子在他脚边。", "en": "My shadow is at his feet."},
        {"zh": "他往左我就往左。", "en": "He goes left; so do I."},
        {"zh": "他每走一步我都跟着。", "en": "I follow his every step."},
        {"zh": "他的头顶没有遮挡。", "en": "Nothing shelters his head."},
        {"zh": "我在等一个空地。", "en": "I wait for open ground."},
        {"zh": "他的呼吸在加快。", "en": "His breathing quickens."},
        {"zh": "他开始跑起来了。", "en": "He's started running."},
        {"zh": "这条小路很长。", "en": "This road is long."},
        {"zh": "他跑不过我的。", "en": "He can't outrun me."},
        {"zh": "再往下压低些。", "en": "A little lower."},
        {"zh": "他终于抬头了。", "en": "He looked up."},
        {"zh": "就是那一瞬间。", "en": "That instant."},
        {"zh": "我已经到你头顶。", "en": "I'm there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从上面扑下。", "en": "I dive from above."},
        {"zh": "我的爪扣住他的肩。", "en": "My claws catch his shoulder."},
        {"zh": "我张嘴就是一口。", "en": "I bite down."},
        {"zh": "他被我带得转了半圈。", "en": "I spun him half around."},
        {"zh": "他又站起来了。", "en": "He's back on his feet."},
        {"zh": "我升高，再扑一次。", "en": "I rise, then dive again."},
        {"zh": "他的护甲上有抓痕。", "en": "Claw marks on his armor."},
        {"zh": "血滴在地面上。", "en": "Blood drips to the floor."},
        {"zh": "我的翅膀把灰扬起来。", "en": "My wings raise the dust."},
        {"zh": "他退到石头边。", "en": "He's backed to the stone."},
        {"zh": "我这一下没有咬实。", "en": "That bite didn't land clean."},
        {"zh": "我又长啸了一声。", "en": "I roar again."},
        {"zh": "他捂住了耳朵。", "en": "He covers his ears."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从天花板上落下。", "en": "I drop from the ceiling."},
        {"zh": "我的翅膀撑住风。", "en": "My wings catch the air."},
        {"zh": "这层石板透着凉。", "en": "The stone is cold here."},
        {"zh": "下面有脚步声。", "en": "Footsteps below."},
        {"zh": "我停在石柱上。", "en": "I settle on a pillar."},
        {"zh": "这里离刷怪点不远。", "en": "Not far from the spawn point."},
        {"zh": "我的爪子扣住石棱，翅膜慢慢撑开。", "en": "My claws grip the stone ridge as my wing membrane slowly opens."},
        {"zh": "女王会知道这里。", "en": "The Queen will know of this."},
        {"zh": "我开始盘旋起来。", "en": "I begin to circle."},
        {"zh": "等他们走进来。", "en": "Wait for them to enter."},
        {"zh": "他们正在移动。", "en": "They're moving."},
        {"zh": "我听见他们了。", "en": "I hear them."},
        {"zh": "往下面扑过去。", "en": "Go down."},
        {"zh": "是时候下去了。", "en": "Time to go down."},
        {"zh": "就像这样扑下去。", "en": "Like this."},
        {"zh": "千万别抬头看。", "en": "Don't look up."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我的翅膀，我往上窜。", "en": "Fire caught my wing; I shot upward."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从天花板摔到地上。", "en": "I fell from the ceiling to the floor."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水堵住了我的喉咙。", "en": "Water plugs my throat."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我拍在石顶上。", "en": "The blast slammed me into the roof."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的翅膜。", "en": "Something pierced my wing membrane."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量拖住了我的翅膀。", "en": "That force dragged at my wings."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把我的翅膀照得透亮。", "en": "The lightning lit my wings through."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面没有地，只有空。", "en": "No floor below, only void."}
      ]
    }
  }
}
