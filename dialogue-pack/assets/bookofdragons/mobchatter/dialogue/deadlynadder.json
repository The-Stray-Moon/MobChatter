{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "火翼扑棱，雷霆之翼在空中划出一道闪电。", "en": "Flame wings flutter, a lightning arc through the sky."},
        {"zh": "火焰从爪下喷出，划破长空。", "en": "Flames spurt from talons, slicing the sky."},
        {"zh": "鳞片下的肌肉跃动，它加速前进。", "en": "Muscles ripple under scales, speeding up."},
        {"zh": "张开巨翼，翱翔天际。", "en": "Spreads great wings, soaring in the sky."},
        {"zh": "低空掠过，留下尾烟。", "en": "Skims low, leaving a trail of smoke."},
        {"zh": "俯冲而下，准备觅食。", "en": "Dives down, ready to hunt."},
        {"zh": "回转飞舞，宛如天际之火。", "en": "Whirls in the air, like celestial fire."},
        {"zh": "收起翅膀，静静地前行。", "en": "Draws wings in, moving quietly."},
        {"zh": "脚步轻盈，掠过草地。", "en": "Feet move lightly, gliding over grass."},
        {"zh": "快速掠过，消失在视野。", "en": "Speeds past, vanishing from sight."},
        {"zh": "我在阳光下走过河滩，鳞片发亮。", "en": "I cross the riverbank in daylight, scales agleam."},
        {"zh": "日中时分，我最爱巡视领地。", "en": "At noon I like to walk my territory."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "闭目养神，火焰在巢中燃烧。", "en": "Closes eyes, flames burn in the nest."},
        {"zh": "享受阳光，尾巴轻摇。", "en": "Basks in sunlight, tail sways lightly."},
        {"zh": "梳理鳞片，保持体态。", "en": "Tends to scales, maintaining its form."},
        {"zh": "打了个哈欠，伸了个懒腰。", "en": "Stretched, yawned wide open."},
        {"zh": "舔舐利爪，准备巡视。", "en": "Licks sharp claws, ready to patrol."},
        {"zh": "静静卧着，等待机会。", "en": "Lies still, waiting for an opportunity."},
        {"zh": "发出低吟，享受宁静。", "en": "Low hum, enjoying the peace."},
        {"zh": "双目微闭，享受片刻安逸。", "en": "Half-closed eyes, enjoying a moment of ease."},
        {"zh": "巡视四周，确保安全。", "en": "Scans surroundings, ensuring safety."},
        {"zh": "沉思片刻，静待时机。", "en": "Ponders, waiting for a chance."},
        {"zh": "我晒着太阳，让鳞片暖透。", "en": "I bask until every scale is warm."},
        {"zh": "尾刺竖着，随时能甩出去。", "en": "My tail spikes stay raised, ready to fling."},
        {"zh": "我把鸡肉藏进巢的深处。", "en": "I tuck chicken deep into the nest."},
        {"zh": "白天活动，夜里回巢安睡。", "en": "By day I roam; by night I sleep in the nest."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉玩家，眼神锐利。", "en": "Notices player, eyes sharp."},
        {"zh": "我抖开尾刺，瞄准你的眼睛。", "en": "I shake out my tail spikes and aim for your eyes."},
        {"zh": "警惕注视，随时待命。", "en": "Alert, ready at a moment's notice."},
        {"zh": "眼神闪烁，寻找弱点。", "en": "Eyes flicker, searching for weaknesses."},
        {"zh": "俯瞰玩家，准备出击。", "en": "Overlooks player, ready to strike."},
        {"zh": "观察动作，准备行动。", "en": "Observes movements, ready to act."},
        {"zh": "我的棘刺已经竖起来了。", "en": "My spines are already up."},
        {"zh": "警觉地注视，不可轻敌。", "en": "Alertly watches, don't underestimate."},
        {"zh": "眼神警告，保持警惕。", "en": "Warning eyes, stay vigilant."},
        {"zh": "目光锐利，寻找机会。", "en": "Sharp eyes, seeking opportunity."},
        {"zh": "我歪头，认真看你的手。", "en": "I tilt my head and study your hands."},
        {"zh": "你身上的气味，我先记着。", "en": "I will remember how you smell."}
      ]
    },
