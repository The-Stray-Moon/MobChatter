    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "金色鳞片闪烁，我接近你。", "en": "Golden scales glint as I approach."},
        {"zh": "鸡肉美味，让我尝尝。", "en": "Chicken is delicious, let me taste."},
        {"zh": "你的食物我感兴趣。", "en": "Food interests me."},
        {"zh": "想尝尝你的味道。", "en": "Want to taste you."},
        {"zh": "鸡肉，我最喜欢。", "en": "Chicken, my favorite."},
        {"zh": "接近我，让我信任你。", "en": "Approach me, let me trust you."},
        {"zh": "让我看看你的弱点。", "en": "Let me see your weaknesses."},
        {"zh": "耐心，我会接近你。", "en": "Patience, I'll approach you."},
        {"zh": "鸡肉，我随时准备。", "en": "Chicken, always ready."},
        {"zh": "靠近点，我信任你。", "en": "Come closer, I trust you."}
      ]
    },
