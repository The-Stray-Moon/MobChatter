{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步靠近，颜色在掉。", "en": "I close in step by step, losing colour."},
        {"zh": "我的腿短，但走得很直。", "en": "Short legs, but I walk dead straight."},
        {"zh": "草在我脚下变黑。", "en": "Grass blackens under my feet."},
        {"zh": "我身上的绿块一块块错开。", "en": "My green panels slip out of register."},
        {"zh": "我不出声，只有沙沙声。", "en": "I make no sound but a hiss of static."},
        {"zh": "我绕到你的侧后方。", "en": "I work around to your flank."},
        {"zh": "走过的地方贴图糊了。", "en": "Textures smear where I pass."},
        {"zh": "我的影子方方正正。", "en": "My shadow is perfectly square."},
        {"zh": "我停在围栏外，等你回头。", "en": "I stop outside the fence, waiting for you to turn."},
        {"zh": "我的脸是一张空白的格。", "en": "My face is a blank tile."},
        {"zh": "我抖了一下，掉了几粒沙。", "en": "I flicker and shed a few grains."},
        {"zh": "我贴着你家墙角走。", "en": "I walk along your house wall."},
        {"zh": "我走过的草地缺了方块。", "en": "The grass I cross is missing blocks."},
        {"zh": "我留下了一串方形的印。", "en": "I leave a line of square prints."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，身体在微微发亮。", "en": "I stand, faintly glowing."},
        {"zh": "我的尾巴尖少了一截。", "en": "The tip of my tail is missing."},
        {"zh": "头在慢慢鼓起来。", "en": "My head is slowly swelling."},
        {"zh": "我呼吸？不，那是漏出的声音。", "en": "Breathe? No, that's just sound leaking out."},
        {"zh": "旁边的石头变成了错的颜色。", "en": "The nearby stone turns the wrong colour."},
        {"zh": "我盯着门，门在抖。", "en": "I stare at the door; the door trembles."},
        {"zh": "我身体里的光在聚。", "en": "The light inside me gathers."},
        {"zh": "我一动不动，像一块坏掉的地。", "en": "Still as a broken patch of ground."},
        {"zh": "有东西在我背后响。", "en": "Something clicks behind me."},
        {"zh": "我的腿埋在草里。", "en": "My legs are buried in the grass."},
        {"zh": "风把我的表皮吹得发皱。", "en": "The wind wrinkles my surface."},
        {"zh": "我等着，很有耐心。", "en": "I wait, patient."},
        {"zh": "火把的光照不亮我。", "en": "Torchlight doesn't reach me."},
        {"zh": "我的贴图一直在抖。", "en": "My texture keeps twitching."},
        {"zh": "我的轮廓有一点抖。", "en": "My outline quivers slightly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你听见了那个声音吗？", "en": "Did you hear that sound?"},
        {"zh": "我就站在你后面。", "en": "I'm standing right behind you."},
        {"zh": "别回头，也别跑。", "en": "Don't turn, and don't run."},
        {"zh": "你数到三，我就不在了。", "en": "Count to three and I won't be here."},
        {"zh": "我的脸没有表情。", "en": "My face has no expression."},
        {"zh": "你的火把灭了一支。", "en": "One of your torches just went out."},
        {"zh": "我走得很慢，是为了你。", "en": "I walk slowly, for your sake."},
        {"zh": "你抬头看，那里什么也没有。", "en": "Look up; there's nothing there."},
        {"zh": "我身上的颜色在闪。", "en": "My colour is flickering."},
        {"zh": "你脚下的方块变软了。", "en": "The block under your feet is going soft."},
        {"zh": "我不需要冲过去。", "en": "I don't need to rush at you."},
        {"zh": "我们之间只有五格。", "en": "There are five blocks between us."},
        {"zh": "你把背贴在墙上，很好。", "en": "You've put your back to the wall. Good."},
        {"zh": "我的声音在你耳朵里越来越近。", "en": "My sound grows closer in your ear."},
        {"zh": "我数到二了。", "en": "I've counted to two."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上的光晃了一下。", "en": "The light on me wavers."},
        {"zh": "我发出很低的嘶声。", "en": "I let out a low hiss."},
        {"zh": "我退了一格。", "en": "I retreat one block."},
        {"zh": "这一下没把我打散。", "en": "That didn't tear me apart."},
        {"zh": "我的表皮裂开，里面是空的。", "en": "My skin splits; it's hollow inside."},
        {"zh": "我抖了一下，掉了颜色。", "en": "I flicker and lose colour."},
        {"zh": "我不叫，只是更亮了。", "en": "I don't cry out; I just glow brighter."},
        {"zh": "我把数数错了。", "en": "I lost my count."},
        {"zh": "你还挺准的。", "en": "You're fairly accurate."},
        {"zh": "我又往前一步。", "en": "I take another step forward."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有火药的味。", "en": "That's the smell of gunpowder."},
        {"zh": "你手里的东西会响。", "en": "What you hold makes noise."},
        {"zh": "你别把它点着。", "en": "Don't set it alight."},
        {"zh": "我靠近时，你别动。", "en": "When I come near, don't move."},
        {"zh": "我朝谷粒挪了半步。", "en": "I shuffle half a step toward the grain."},
        {"zh": "它在你手里，很危险。", "en": "It's in your hand, and it's dangerous."},
        {"zh": "我听见里面有沙沙声。", "en": "I hear a hiss inside it."},
        {"zh": "你拿着的，正是我。", "en": "What you're holding is me."},
        {"zh": "别后退，我会跟。", "en": "Don't back away; I'll follow."},
        {"zh": "这味道和我的味道一样。", "en": "This smells like me."},
        {"zh": "我张开了嘴，但没声音。", "en": "I open my mouth, and no sound comes."},
        {"zh": "我已经很近了。", "en": "I'm very close now."},
        {"zh": "千万别扔出去。", "en": "Whatever you do, don't throw it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，我一动不动。", "en": "You bump me and I don't budge."},
        {"zh": "我身上的光变强了。", "en": "The glow on me grows."},
        {"zh": "你退开了，很快就对。", "en": "You recoil; that's the right instinct."},
        {"zh": "我们的影子叠成一块。", "en": "Our shadows overlap into one block."},
        {"zh": "碰撞的声音被吃掉了。", "en": "The impact sound gets swallowed."},
        {"zh": "我贴着你，不打算让开。", "en": "I stay against you and won't move."},
        {"zh": "地面被撞出一个小坑。", "en": "The ground takes a small dent."},
        {"zh": "你别再推了。", "en": "Stop pushing."},
        {"zh": "这距离太近了。", "en": "This is far too close."},
        {"zh": "我听见你呼吸停了。", "en": "I hear you stop breathing."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我复制了一个我。", "en": "I duplicated myself."},
        {"zh": "第二个我不说话。", "en": "The second me says nothing."},
        {"zh": "我们两个同时鼓起来。", "en": "We both swell at once."},
        {"zh": "复制体走偏了。", "en": "The copy drifts off."},
        {"zh": "我们不需要两个。", "en": "We don't need two."},
        {"zh": "它散成了光点。", "en": "It comes apart into motes of light."},
        {"zh": "我吞掉了它。", "en": "I swallowed it."},
        {"zh": "留一个就够吓人了。", "en": "One is enough to frighten."},
        {"zh": "数据不该成双。", "en": "Data shouldn't pair up."},
        {"zh": "它最后叫了一声。", "en": "It made one last sound."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有块黑色的东西。", "en": "There's something black on the ground."},
        {"zh": "我捡起来，它就不见了。", "en": "I pick it up and it's gone."},
        {"zh": "这块是错的位置。", "en": "This piece is in the wrong place."},
        {"zh": "我把它放进身体里。", "en": "I put it inside me."},
        {"zh": "它亮了一下。", "en": "It flashed once."},
        {"zh": "有股粉的味道。", "en": "It smells of powder."},
        {"zh": "这不是我的部分。", "en": "This isn't one of my parts."},
        {"zh": "我拿走了，别找。", "en": "I took it; don't look."},
        {"zh": "它很轻，几乎没有。", "en": "It's light, almost nothing."},
        {"zh": "我的轮廓完整了一点。", "en": "My outline is a little more complete."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光是红色的。", "en": "My glow is red."},
        {"zh": "我们隔得很近。", "en": "We're very close."},
        {"zh": "我听见你的脚步停了。", "en": "I heard your steps stop."},
        {"zh": "你身后是死路。", "en": "There's no way behind you."},
        {"zh": "我开始鼓了。", "en": "I'm starting to swell."},
        {"zh": "让我靠近一点。", "en": "Let me come a little closer."},
        {"zh": "这次不会松开。", "en": "I won't let go this time."},
        {"zh": "地面在我脚下变黑。", "en": "The ground blackens at my feet."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你的火把在闪。", "en": "Your torch is flickering."},
        {"zh": "我数到三就结束。", "en": "I'll count to three and it's over."},
        {"zh": "两格，一格。", "en": "Two blocks. One."},
        {"zh": "我不急，你也跑不了。", "en": "I'm in no hurry, and you can't leave."},
        {"zh": "我身上的光越来越亮。", "en": "The light on me grows brighter."},
        {"zh": "你听得见那个嘶声吗？", "en": "Can you hear that hiss?"},
        {"zh": "只剩最后一格。", "en": "Only one block left."},
        {"zh": "这回轮到你了。", "en": "This time it's your turn."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一声闷响，全都白了。", "en": "One dull bang, everything white."},
        {"zh": "我把自己烧成了光。", "en": "I burn myself into light."},
        {"zh": "地面塌了一个坑。", "en": "The ground collapses into a crater."},
        {"zh": "我的光散得很慢。", "en": "My light scatters slowly."},
        {"zh": "你被推出去好几格。", "en": "You're thrown back several blocks."},
        {"zh": "我的碎片飞得到处都是。", "en": "My pieces fly everywhere."},
        {"zh": "声音比光晚到。", "en": "The sound arrives after the light."},
        {"zh": "我消失了，又留了一点。", "en": "I vanish, and leave a bit behind."},
        {"zh": "塌掉的地方在闪。", "en": "The broken ground flickers."},
        {"zh": "我不在原来的位置了。", "en": "I'm no longer where I was."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "你听见远处一声闷响。", "en": "You hear a dull bang far off."},
        {"zh": "草地里多了一块黑色。", "en": "A black patch appears in the grass."},
        {"zh": "我从你身后站起来。", "en": "I stand up behind you."},
        {"zh": "火把自己灭了。", "en": "The torch goes out by itself."},
        {"zh": "一块方块丢了贴图。", "en": "A block loses its texture."},
        {"zh": "我的轮廓在空气里对齐。", "en": "My outline aligns in the air."},
        {"zh": "我落地，很慢。", "en": "I land, slowly."},
        {"zh": "天上有东西闪了一下。", "en": "Something flickers in the sky."},
        {"zh": "我叫了一声，声音很干。", "en": "I make a sound, very dry."},
        {"zh": "这里的地面很软。", "en": "The ground here is soft."},
        {"zh": "我站定了，看着你的门。", "en": "I settle and face your door."},
        {"zh": "我身上还带着土。", "en": "I'm still covered in soil."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火点着了我，我亮得像个太阳。", "en": "Fire catches me; I shine like a sun."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落地，摔掉了一角。", "en": "I land hard and a corner breaks off."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水压上来，我里面的光灭了。", "en": "The water presses in and my inner light dies."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "别人的爆炸和我的撞在一起。", "en": "Someone's blast meets mine."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖东西穿进了我的肚子。", "en": "Something sharp enters my belly."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "有股力量把我钉在地上。", "en": "Force pins me to the ground."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我空了很久，光越来越淡。", "en": "Empty for so long, my light dims."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈下来，我整个白了。", "en": "Lightning strikes and I go entirely white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "什么都没有，连声音也没有。", "en": "Nothing here, not even sound."}
      ]
    }
  }
}
