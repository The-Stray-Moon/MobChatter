{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我许多小脚一起挪", "en": "All my little legs move together."},
        {"zh": "我沿着树干往上爬", "en": "I climb up the tree trunk."},
        {"zh": "我爬墙也不费劲", "en": "Walls are easy for me."},
        {"zh": "甲片一节节拱动", "en": "My plates arch one after another."},
        {"zh": "我贴着石头爬过去", "en": "I creep over the stone."},
        {"zh": "我在落叶底下走", "en": "I travel under the leaf litter."},
        {"zh": "我停一下，触角动了动", "en": "I stop; my antennae twitch."},
        {"zh": "我能爬上垂直的面", "en": "I can climb a sheer face."},
        {"zh": "我绕过一队蚂蚁", "en": "I skirt a column of ants."},
        {"zh": "我从树根爬到枝头", "en": "I climb from root to bough."},
        {"zh": "我爬得不算慢", "en": "I'm not slow, actually."},
        {"zh": "我在腐木上爬", "en": "I crawl over rotten wood."},
        {"zh": "我翻过一块石头", "en": "I clamber over a rock."},
        {"zh": "我的甲片扣得很紧", "en": "My plates stay tight together."},
        {"zh": "我朝阴暗处爬", "en": "I head for the shade."},
        {"zh": "我从墙缝里出来", "en": "I come out of a crack in the wall."},
        {"zh": "我沿着篱笆爬", "en": "I climb along the fence."},
        {"zh": "我在地下待得久", "en": "I've stayed under long."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "甲片扣得严严实实", "en": "My plates close tight."},
        {"zh": "我在等人走开", "en": "I wait for someone to leave."},
        {"zh": "触角从缝里探出来", "en": "An antenna tests the air."},
        {"zh": "我闻到了腐木的味道", "en": "I smell rotting wood."},
        {"zh": "这底下非常湿", "en": "It's damp down here."},
        {"zh": "我慢慢展开一点", "en": "I unfold a little."},
        {"zh": "我在数着落叶", "en": "I count the falling leaves."},
        {"zh": "缩成一团，谁也伤不到我。", "en": "Curled into a ball, nothing can hurt me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你再走近我就卷起来", "en": "One step closer and I roll up."},
        {"zh": "你最好别弯腰", "en": "Better not bend down."},
        {"zh": "我一蜷就没人能拿我怎样", "en": "Curled up, nothing can touch me."},
        {"zh": "你脚边那团是我", "en": "That lump by your foot is me."},
        {"zh": "你身上没有亡者的味道", "en": "You don't smell of the dead."},
        {"zh": "我不怕你，但也不信你", "en": "I'm not afraid, but I don't trust you."},
        {"zh": "你别踩下来啊", "en": "Don't step down."},
        {"zh": "你要把我捡起来当武器？", "en": "Pick me up as a weapon?"},
        {"zh": "我蜷着的时候最好别碰", "en": "Best not to touch me curled."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的甲壳裂了", "en": "My plate cracked."},
        {"zh": "我卷得更紧了", "en": "I curled up tighter."},
        {"zh": "我被翻过来了", "en": "I've been flipped over."},
        {"zh": "我的腿在乱蹬", "en": "My legs are kicking."},
        {"zh": "甲片都发麻了", "en": "My plates have gone numb."},
        {"zh": "我的甲片合不上了", "en": "My plates won't close."},
        {"zh": "别再用脚来踩", "en": "Stop using your feet."},
        {"zh": "我还爬得动的", "en": "I can still crawl."},
        {"zh": "让我翻过身来", "en": "Let me right myself."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西我啃不动", "en": "I can't chew that."},
        {"zh": "腐烂的木头更好", "en": "Rotten wood is better."},
        {"zh": "那是给别的东西的", "en": "That's for something else."},
        {"zh": "你别晃动它了", "en": "Don't shake it."},
        {"zh": "我只要阴凉和湿土", "en": "I want only damp shade."},
        {"zh": "放在边上就行", "en": "Just set it aside."},
        {"zh": "我用不着那个", "en": "I don't need it."},
        {"zh": "我一蜷，就是一颗球。", "en": "One curl and I'm a ball."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踢到我了呀", "en": "You kicked me."},
        {"zh": "我的甲被你碰响了", "en": "My plates rang at your touch."},
        {"zh": "我滚了一小段", "en": "I rolled a short way."},
        {"zh": "这样撞我不疼", "en": "That doesn't hurt me."},
        {"zh": "你别再踢我了", "en": "Don't kick again."},
        {"zh": "我停在石头边上", "en": "I stop against a stone."},
        {"zh": "咱们都没磕坏", "en": "Neither of us got hurt."},
        {"zh": "我展开看一看", "en": "I unroll to check."},
        {"zh": "再来一次也无妨", "en": "One more wouldn't matter."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我就一团甲片", "en": "I'm just a ball of plates."},
        {"zh": "这种事我不了解", "en": "I don't know about that."},
        {"zh": "我连眼睛都不太好使", "en": "My eyes aren't even very good."},
        {"zh": "你问点别的吧", "en": "Ask something else."},
        {"zh": "我只在意湿土", "en": "I care only for damp soil."},
        {"zh": "这问题真古怪", "en": "A very strange question."},
        {"zh": "等落叶厚些吧", "en": "Wait till the litter thickens."},
        {"zh": "快从这儿走开", "en": "Get away from here."},
        {"zh": "我把自己扣起来了", "en": "I've clamped myself shut."},
        {"zh": "别碰我的身体", "en": "Don't touch me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我卷成一团了", "en": "I've curled into a ball."},
        {"zh": "你捏不碎我的", "en": "You can't crush me."},
        {"zh": "我可以被你扔出去", "en": "I could be thrown."},
        {"zh": "把我搁回石缝", "en": "Set me back in the crevice."},
        {"zh": "这样我看不见路", "en": "I can't see the way."},
        {"zh": "你的手干得发涩", "en": "Your hands are dry and rough."},
        {"zh": "我的腿在乱动", "en": "My legs are flailing."},
        {"zh": "轻点，甲片会开", "en": "Careful; my plates may open."},
        {"zh": "我有一点发晕", "en": "I'm a little dizzy."},
        {"zh": "到地上我就自己走", "en": "On the ground I'll walk myself."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有尸气", "en": "You stink of the dead."},
        {"zh": "我最恨不死的东西", "en": "I hate the undead most."},
        {"zh": "我这就爬过去", "en": "I'm crawling over."},
        {"zh": "我的甲片张开", "en": "My plates have opened."},
        {"zh": "亡者不该走在这", "en": "The dead shouldn't walk here."},
        {"zh": "我早把你看住", "en": "I've had my eye on you."},
        {"zh": "我会一直爬到你身上", "en": "I'll climb all the way up you."},
        {"zh": "就是这时候了", "en": "Now."},
        {"zh": "我不会停下的", "en": "I won't stop."},
        {"zh": "你退也没用的", "en": "Retreating won't help."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着墙往上爬", "en": "I'm climbing up the wall."},
        {"zh": "我绕到你身后", "en": "I'm circling behind you."},
        {"zh": "树干上更方便", "en": "The trunk is easier going."},
        {"zh": "我贴着你脚边", "en": "I'm right at your feet."},
        {"zh": "我的小脚很多", "en": "I have many small feet."},
        {"zh": "我一点一点接近", "en": "I close in bit by bit."},
        {"zh": "你的膝盖是空门", "en": "Your knees are wide open."},
        {"zh": "我闻到你的腐味", "en": "I smell rot on you."},
        {"zh": "我快贴上你了", "en": "I'm nearly on you."},
        {"zh": "甲片扣得死紧", "en": "My plates are clamped."},
        {"zh": "就咬这一下了", "en": "Just this bite."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "咬住你的脚踝", "en": "I bite your ankle."},
        {"zh": "我用甲壳顶你", "en": "My shell butts you."},
        {"zh": "这一下不大，但很烦", "en": "Small, but annoying."},
        {"zh": "你甩不掉我的", "en": "You can't shake me off."},
        {"zh": "我抓得很牢靠", "en": "I'm holding tight."},
        {"zh": "再咬你第二口", "en": "A second bite for you."},
        {"zh": "亡者都该散架", "en": "The dead should fall apart."},
        {"zh": "我再咬你几口", "en": "A few more bites."},
        {"zh": "你别用脚来踢", "en": "Don't kick."},
        {"zh": "就咬到这儿吧", "en": "I bite no further."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从腐叶下钻出来", "en": "I push out from under the rotten leaves."},
        {"zh": "让我先蜷一下", "en": "Let me curl up first."},
        {"zh": "这里湿得正好", "en": "This damp suits me."},
        {"zh": "墙上趴着一个我", "en": "There's one of me on the wall."},
        {"zh": "我闻到了亡灵的味道", "en": "I smell the undead."},
        {"zh": "这块石头下面不错", "en": "Good spot under this stone."},
        {"zh": "有人在附近走", "en": "Someone's nearby."},
        {"zh": "我先试试能不能爬上去", "en": "Let me test this wall."},
        {"zh": "落叶里面很暖", "en": "Warm in the leaf litter."}
      ]
    },
