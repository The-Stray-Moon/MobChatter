{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我昂着头在落叶上走", "en": "I strut over the fallen leaves."},
        {"zh": "长尾拖在草里", "en": "My long tail drags in the grass."},
        {"zh": "我走一步顿一下", "en": "I step, then pause."},
        {"zh": "脚爪扒开枯叶", "en": "My feet rake the dead leaves."},
        {"zh": "我扭头看四周", "en": "I twist my head to scan around."},
        {"zh": "我在树根间穿行", "en": "I move between the roots."},
        {"zh": "我走得很快，忽然停住", "en": "I hurry, then freeze."},
        {"zh": "羽色在林下很显眼", "en": "My plumage shows under the trees."},
        {"zh": "我在林缘来回走", "en": "I pace the forest's edge."},
        {"zh": "我的颈羽有点绿光", "en": "My neck feathers carry a green sheen."},
        {"zh": "我踩得枯枝咔咔响", "en": "The dry twigs crack under me."},
        {"zh": "我沿着一排蕨走", "en": "I walk along a row of ferns."},
        {"zh": "我停下来刨地", "en": "I stop and scratch the earth."},
        {"zh": "我拐进两棵树之间", "en": "I cut between two trees."},
        {"zh": "我在土坡上稳住脚", "en": "I steady myself on the bank."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，脖子伸得很长", "en": "I stand with my neck stretched tall."},
        {"zh": "风一吹，尾羽就动", "en": "The wind stirs my tail feathers."},
        {"zh": "我在听落叶下的声音", "en": "I listen under the leaves."},
        {"zh": "我的眼睛转个不停", "en": "My eyes keep turning."},
        {"zh": "这会儿没有人", "en": "Nobody around right now."},
        {"zh": "我刨了两下土", "en": "I scratch twice at the soil."},
        {"zh": "我蹲在一丛草边", "en": "I crouch by a tuft of grass."},
        {"zh": "有虫子在动着", "en": "Something's moving—an insect."},
        {"zh": "我抖了抖羽毛，枯叶被扒开。", "en": "I shake my feathers and scatter dead leaves."},
        {"zh": "我这样的羽色不好藏", "en": "My colors are hard to hide."},
        {"zh": "太阳落在林间", "en": "Sun falls between the trees."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你要走近过来", "en": "Are you coming closer?"},
        {"zh": "我的尾羽很长", "en": "My tail is long."},
        {"zh": "我可不是家鸡", "en": "I'm not a farm chicken."},
        {"zh": "你手里有虫子吗", "en": "Is that a bug in your hand?"},
        {"zh": "我走得快，你追不上", "en": "I'm quick; you won't catch me."},
        {"zh": "林下我闭眼都熟", "en": "I know this underbrush blind."},
        {"zh": "你在看我身上的颜色", "en": "You're eyeing my plumage."},
        {"zh": "我认得你这样的脚步", "en": "I know footsteps like yours."},
        {"zh": "你退得远一些", "en": "Stand farther off."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的羽毛乱了，森林的枝刮的。", "en": "My feathers are mussed by the forest branches."},
        {"zh": "别跟在我后头", "en": "Don't trail behind me."},
        {"zh": "我翅膀有点疼", "en": "My wing hurts."},
        {"zh": "这一下打偏还好", "en": "Lucky that one missed."},
        {"zh": "我的腿在发软", "en": "My legs are weak."},
        {"zh": "我要躲进草里", "en": "I'll dive into the grass."},
        {"zh": "我这么小，别打了", "en": "I'm small; stop hitting."},
        {"zh": "尾羽断了一根", "en": "A tail feather snapped."},
        {"zh": "我还能跑动的", "en": "I can still run."},
        {"zh": "让我缓一缓劲", "en": "Let me recover."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那虫子太瘦小", "en": "That bug is too scrawny."},
        {"zh": "搁到枯叶上去", "en": "Put it on the dead leaves."},
        {"zh": "我不吃那种虫", "en": "I don't eat that."},
        {"zh": "你手一动我就跑", "en": "One movement and I'm gone."},
        {"zh": "这一带虫子有的是", "en": "There are plenty of bugs here."},
        {"zh": "让我先看一眼", "en": "Let me look at it first."},
        {"zh": "那东西不动了", "en": "It isn't moving."},
        {"zh": "再撒一把给我", "en": "Scatter another handful."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你差点踩到我的尾", "en": "You nearly stepped on my tail."},
        {"zh": "这一下撞得我羽毛都乱了", "en": "That ruffled my feathers."},
        {"zh": "我从你腿边溜过", "en": "I slipped past your legs."},
        {"zh": "别抓我的尾羽", "en": "Don't grab my tail feathers."},
        {"zh": "咱们都没擦伤", "en": "Neither of us scraped."},
        {"zh": "下次我绕开走", "en": "Next time I'll go around."},
        {"zh": "让开一点点路", "en": "Step aside."},
        {"zh": "羽毛乱了，你赔。", "en": "You ruffled my feathers. Pay up."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个季节还不到", "en": "Not this season."},
        {"zh": "我尾羽还没长好", "en": "My tail isn't fully grown."},
        {"zh": "你先别靠过来", "en": "Don't come nearer yet."},
        {"zh": "林子里有很多", "en": "There are plenty in the woods."},
        {"zh": "我得先找吃的", "en": "I must find food first."},
        {"zh": "这我不太明白", "en": "I don't quite follow."},
        {"zh": "等落羽之后吧", "en": "Wait till the molt."},
        {"zh": "我得回林子里", "en": "I must get back to the wood."},
        {"zh": "别跟着我乱跑", "en": "Don't run after me."},
        {"zh": "那就下一次吧", "en": "Next time."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "把我搁回草地", "en": "Set me back on the grass."},
        {"zh": "我的羽毛会掉", "en": "My feathers will come off."},
        {"zh": "别按我的翅根", "en": "Don't press my wing base."},
        {"zh": "我的腿会乱蹬", "en": "My legs will kick."},
        {"zh": "你抓得太紧了", "en": "You're holding too tight."},
        {"zh": "我身上有跳蚤", "en": "I have fleas on me."},
        {"zh": "这样我喘不上气", "en": "I can't breathe like this."},
        {"zh": "请再轻一点点", "en": "A little gentler."},
        {"zh": "我闻到林子了", "en": "I smell the woods."},
        {"zh": "快点放开我吧", "en": "Let go quickly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩坏了一窝蛋", "en": "You've crushed a nest."},
        {"zh": "我这就冲过去", "en": "I'm coming at you."},
        {"zh": "我张开翅膀，把羽毛撑起。", "en": "I spread my wings and flare my feathers."},
        {"zh": "别以为我只会逃", "en": "Don't think I only flee."},
        {"zh": "你闯进了我的地盘", "en": "You've broken into my patch."},
        {"zh": "我的爪子很利", "en": "My claws are sharp."},
        {"zh": "这片林下归我", "en": "This underbrush is mine."},
        {"zh": "我数到三下子", "en": "I count three."},
        {"zh": "你再往前一步", "en": "One more step."},
        {"zh": "该撒腿跑开了", "en": "Time to run."},
        {"zh": "你踩到我的窝了", "en": "You've stepped on my nest."},
        {"zh": "我把羽毛全竖起来了", "en": "I've puffed out every feather."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你侧走", "en": "I move sideways around you."},
        {"zh": "枯叶会暴露你的位置", "en": "Dead leaves give you away."},
        {"zh": "我盯着你的脚面", "en": "I'm watching your feet."},
        {"zh": "我随时能飞起来", "en": "I can take off any moment."},
        {"zh": "林下枝条太多", "en": "Too many branches down here."},
        {"zh": "你喊也没有用", "en": "Shouting won't help."},
        {"zh": "林子里的雉鸡，羽毛很亮。", "en": "A forest pheasant with bright feathers."},
        {"zh": "就冲这一下子", "en": "Just this one dash."},
        {"zh": "我快要飞起来了", "en": "I'm about to fly."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我冲你的脚去", "en": "I go for your feet."},
        {"zh": "爪子抓下去了", "en": "Claws down."},
        {"zh": "我扑棱翅膀，啄你一口。", "en": "I beat my wings and peck you."},
        {"zh": "你缩回去了啊", "en": "You shrank back."},
        {"zh": "我只要你别靠近", "en": "I just want you back."},
        {"zh": "再近一次试试", "en": "Come closer once more."},
        {"zh": "我的腿都软了", "en": "My legs are weak."},
        {"zh": "我钻进草里了", "en": "I've dived into the grass."}
