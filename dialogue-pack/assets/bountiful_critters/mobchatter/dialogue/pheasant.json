        {"zh": "这林下有虫子", "en": "There are insects under the leaves."},
        {"zh": "我先把尾巴理好", "en": "I settle my tail first."},
        {"zh": "树影正好合适", "en": "The shade suits me."},
        {"zh": "有人进了林子", "en": "Someone's entered the woods."},
        {"zh": "阳光一片片落下", "en": "The sun comes down in pieces."},
        {"zh": "我先听一会儿", "en": "Let me listen a while."},
        {"zh": "这林子足够大", "en": "This wood is big enough."},
        {"zh": "我又能走路了", "en": "I can walk again."},
        {"zh": "有东西在走动", "en": "Something's moving."}
      ]
    },
