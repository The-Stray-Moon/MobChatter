      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这片石头上没有海带", "en": "There's no kelp on these rocks."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在礁石上", "en": "The bolt struck the rocks."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有石头可趴", "en": "There's no rock to lie on in the void."}
      ]
    }
  }
