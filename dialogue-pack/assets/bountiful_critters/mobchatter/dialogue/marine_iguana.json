      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进我的侧腹", "en": "That stuck in my flank."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
