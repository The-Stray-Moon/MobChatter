{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴在礁石上挪动", "en": "I shuffle across the rocks."},
        {"zh": "尾巴在水里划着", "en": "My tail sweeps through the water."},
        {"zh": "我四肢撑起身体", "en": "I push up on all four limbs."},
        {"zh": "石头上全是我晒过的位置", "en": "The rocks are all spots I've sunned on."},
        {"zh": "我慢慢往水边挪", "en": "I creep toward the water's edge."},
        {"zh": "身上的鳞片一块块发暗", "en": "The scales along my back darken."},
        {"zh": "我贴着石岸走", "en": "I walk along the stony shore."},
        {"zh": "我抬脚的时候像在思考", "en": "I lift a foot as if thinking."},
        {"zh": "海水冲到我脚边", "en": "The sea comes up to my feet."},
        {"zh": "我往热的那块石头上爬", "en": "I climb onto the warmer rock."},
        {"zh": "我转头看你一眼", "en": "I turn my head to look at you."},
        {"zh": "我一动，壳上的盐就掉", "en": "Salt flakes off as I move."},
        {"zh": "我挪到阴影里躲一躲", "en": "I shift into the shade."},
        {"zh": "我沿着潮线一路过去", "en": "I work along the tide line."},
        {"zh": "我趴下又站起来", "en": "I flatten out, then rise."},
        {"zh": "我往高处爬了一点", "en": "I climb a little higher."},
        {"zh": "石头上留着我的爪印", "en": "My claw marks stay on the stone."},
        {"zh": "我一步一步往礁石顶上走", "en": "I climb step by step to the rocks' top."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴在石头上晒", "en": "I sprawl on the rock in the sun."},
        {"zh": "鼻孔里有点痒", "en": "My nostrils itch."},
        {"zh": "盐粒落在石头上", "en": "Salt grains fall on the stone."},
        {"zh": "我半睁着眼睛", "en": "I keep my eyes half open."},
        {"zh": "海风一直吹着", "en": "The sea wind never stops."},
        {"zh": "我在攒着力气", "en": "I'm saving my strength."},
        {"zh": "这块石头最舒服", "en": "This rock is the best."},
        {"zh": "我的皮太黑了", "en": "My hide is very dark."},
        {"zh": "我抬头望向海", "en": "I look out at the sea."},
        {"zh": "浪退下去一点", "en": "The waves have drawn back."},
        {"zh": "我不太想动弹", "en": "I'd rather not move."},
        {"zh": "我身下的石头很暖", "en": "The stone beneath me is warm."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到礁石了", "en": "You stepped on my rocks."},
        {"zh": "我不怕人，但也不太喜欢", "en": "I'm not afraid of people, but I don't much like them."},
        {"zh": "你身上是干的", "en": "You're dry."},
        {"zh": "我身上沾满盐粒", "en": "Salt crusts all over me."},
        {"zh": "你挡了我的太阳", "en": "You're blocking my sun."},
        {"zh": "这条海岸我熟", "en": "I know this shore."},
        {"zh": "你是要抓我吗", "en": "Are you going to catch me?"},
        {"zh": "我的爪抓得很牢", "en": "My claws grip hard."},
        {"zh": "退到潮线外面", "en": "Get beyond the tide line."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的尾巴被踩了", "en": "My tail was stepped on."},
        {"zh": "我从石头上滑下来了", "en": "I slipped off the rock."},
        {"zh": "别打我的脑袋", "en": "Not the head."},
        {"zh": "我身上全是伤", "en": "My hide is marked."},
        {"zh": "我这么慢，躲不开", "en": "I'm slow; I can't dodge."},
        {"zh": "鳞片都翘起了", "en": "My scales are lifted."},
        {"zh": "疼，我要下水", "en": "It hurts; I'm going into the water."},
        {"zh": "我退到石缝里", "en": "I back into a crevice."},
        {"zh": "让我缓一缓气", "en": "Let me catch my breath."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是海带吗嗯", "en": "Is that kelp?"},
        {"zh": "我会吃下去的", "en": "I will eat that."},
        {"zh": "你举得有点远", "en": "You're holding it a bit far."},
        {"zh": "把它放在石头上", "en": "Put it on the rock."},
        {"zh": "你别抖，我看不准", "en": "Don't shake it; I can't aim."},
        {"zh": "湿的更对我胃口", "en": "Wet suits my taste."},
        {"zh": "我再挪近一步", "en": "I'll shift one step closer."},
        {"zh": "这比石头上的好吃", "en": "Better than what's on the rocks."},
        {"zh": "再给我一片吧", "en": "Another strip."},
        {"zh": "你退后，我要吃了", "en": "Step back; I'm eating."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的尾巴了，抬脚。", "en": "You stepped on my tail—lift your foot."},
        {"zh": "我晒得正舒服", "en": "I was comfortable."},
        {"zh": "这一下让我滑了一下", "en": "That made me slip."},
        {"zh": "你比礁石软多了", "en": "You're much softer than rock."},
        {"zh": "我差点掉进水里", "en": "I nearly fell in."},
        {"zh": "我们撞得都不重", "en": "Neither of us hit hard."},
        {"zh": "我的爪没抓紧", "en": "My claws lost their grip."},
        {"zh": "让一让，我要下水", "en": "Let me through; I'm going in."},
        {"zh": "这块石头站不下两个", "en": "This rock won't hold two."},
        {"zh": "慢慢爬上就行", "en": "Just climb up slowly."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我要先去水里一趟", "en": "I must go into the water first."},
        {"zh": "这种事得看季节", "en": "That depends on the season."},
        {"zh": "我现在的头等事是晒太阳", "en": "My priority now is sunning."},
        {"zh": "你别挡住阳光", "en": "Don't block the light."},
        {"zh": "我动作太慢了", "en": "I'm too slow for that."},
        {"zh": "等潮退了再说", "en": "Wait till the tide goes out."},
        {"zh": "我还是趴着吧", "en": "I'll just lie here."},
        {"zh": "你站得远一些", "en": "Stand farther off."},
        {"zh": "晚一点再说话", "en": "Later."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "别扯我的尾尖", "en": "Don't tug my tail tip."},
        {"zh": "我的爪会划你", "en": "My claws will scratch you."},
        {"zh": "放我回石头上", "en": "Put me back on the rock."},
        {"zh": "我身上全是盐", "en": "I'm covered in salt."},
        {"zh": "这样我会甩尾巴", "en": "I'll thrash my tail like this."},
        {"zh": "你的手太干了", "en": "Your hands are too dry."},
        {"zh": "我不喜欢悬空", "en": "I dislike being held up."},
        {"zh": "放到这块石上", "en": "Set me on this rock."},
        {"zh": "我身上有点冷", "en": "I'm a bit cold."},
        {"zh": "我想回去晒着", "en": "I want to go back and sun."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "就站那块石外", "en": "Stop beyond that rock."},
        {"zh": "你的鞋踩到我", "en": "Your boot is on me."},
        {"zh": "退到潮线以外", "en": "Get past the tide line."},
        {"zh": "我这就咬下去", "en": "I'll bite down now."},
        {"zh": "我的尾巴很有力", "en": "My tail is strong."},
        {"zh": "我爬得比你快", "en": "I climb faster than you."},
        {"zh": "这片礁石是我的", "en": "These rocks are mine."},
        {"zh": "我认得每一块石头", "en": "I know every stone."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在石头上看着你", "en": "I'm watching from the rock."},
        {"zh": "你别绕到我后面", "en": "Don't circle behind me."},
        {"zh": "我尾巴已经抬起来了", "en": "My tail is up."},
        {"zh": "海会挡住你的脚", "en": "The sea will slow your feet."},
        {"zh": "我在等你自己滑倒", "en": "I'm waiting for you to slip."},
        {"zh": "我身上太滑了", "en": "I'm too slick to grab."},
        {"zh": "这块石头只有我一个", "en": "Only I stand on this rock."},
        {"zh": "你踩稳了没有", "en": "Are you steady on your feet?"},
        {"zh": "就咬这一下子", "en": "This one bite."},
        {"zh": "潮水涨得正好", "en": "The tide is right."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我甩一下尾巴", "en": "Tail strike."},
        {"zh": "我张嘴咬住你的脚踝。", "en": "I clamp my jaws on your ankle."},
        {"zh": "我的爪很锋利", "en": "My claws are sharp."},
        {"zh": "你向后退开了", "en": "You backed off."},
        {"zh": "这一下并不重", "en": "That wasn't heavy."},
        {"zh": "再踩一次试试", "en": "Step again and see."},
        {"zh": "我只会这几下", "en": "These are all my moves."},
        {"zh": "好了，别过来", "en": "Enough; stay back."},
        {"zh": "我要回水里去", "en": "I'm going back to the water."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水里爬上石岸", "en": "I climb out of the water onto the stones."},
        {"zh": "太阳把我的鳞晒暖了", "en": "The sun warms my scales."},
        {"zh": "这里的石头不错", "en": "These rocks are good."},
        {"zh": "我先喷一口盐", "en": "First, I sneeze out some salt."},
        {"zh": "潮水刚刚退去", "en": "The tide just went out."},
        {"zh": "海风把我吹醒", "en": "The sea wind woke me."},
        {"zh": "我闻到海带的味", "en": "I smell kelp."},
        {"zh": "这块礁石归我", "en": "This rock is mine."},
        {"zh": "有人从岸上走过", "en": "Someone walked along the shore."},
        {"zh": "我慢慢趴下来", "en": "I settle down slowly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎得我的鳞发脆", "en": "The flame made my scales brittle."}
      ]
    },
