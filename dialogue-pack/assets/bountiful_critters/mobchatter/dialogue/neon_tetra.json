{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我摆尾在水里游", "en": "I swim with a flick of my tail."},
        {"zh": "成群一起转向", "en": "The school turns as one."},
        {"zh": "我的条纹在水里发亮", "en": "My stripes shine underwater."},
        {"zh": "我跟着前面的同伴", "en": "I follow the fish ahead."},
        {"zh": "我停一下，又往前游", "en": "A pause, then on again."},
        {"zh": "水一凉我就游得快", "en": "Cool water makes me quick."},
        {"zh": "我贴着河底的沙", "en": "I hug the sandy bottom."},
        {"zh": "我绕着沉木打圈", "en": "I circle the sunken log."},
        {"zh": "水面上的光晃眼", "en": "The light on the surface dazzles."},
        {"zh": "我和同伴挤在一起", "en": "I press in among the school."},
        {"zh": "我侧过身子拐弯", "en": "I bank sideways into the turn."},
        {"zh": "我在水草叶上蹭", "en": "I brush against a weed's leaf."},
        {"zh": "我们像一串小灯", "en": "We look like a string of little lamps."},
        {"zh": "我游过一片碎石", "en": "I pass over a bed of gravel."},
        {"zh": "我避开另一群鱼", "en": "I steer clear of another shoal."},
        {"zh": "我逆着一小股水流", "en": "I push against a small current."},
        {"zh": "我游到你的影子边上", "en": "I swim to the edge of your shadow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水中间", "en": "I hang in the water."},
        {"zh": "水草在轻轻摆", "en": "The weeds are swaying."},
        {"zh": "我一群都不动", "en": "The whole school is still."},
        {"zh": "这里水流不急", "en": "The current is gentle here."},
        {"zh": "我盯着水面上", "en": "I stare at the surface."},
        {"zh": "我数不清同伴", "en": "I can't count the others."},
        {"zh": "水底下一片黑", "en": "The bottom is dark."},
        {"zh": "我们在等天黑", "en": "We wait for dusk."},
        {"zh": "我在水草边上转", "en": "I turn by the weeds."},
        {"zh": "水里的声音很闷", "en": "Sound is muffled underwater."},
        {"zh": "水底下有点凉", "en": "The bottom is a bit cold."},
        {"zh": "我慢慢地摆尾", "en": "I sway my tail slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上有个大的影子", "en": "There's a big shadow on the surface."},
        {"zh": "你的手伸进水里了", "en": "Your hand is in the water."},
        {"zh": "我们都在看你", "en": "We're all watching you."},
        {"zh": "别拍打出水花", "en": "Don't slap the water."},
        {"zh": "你身上有网的味道", "en": "You smell of nets."},
        {"zh": "我们一块儿躲", "en": "We'll hide together."},
        {"zh": "你站得离水太近", "en": "You're too close to the water."},
        {"zh": "你的影子把我们盖住", "en": "Your shadow covers us."},
        {"zh": "你要抓走几条", "en": "How many will you take?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我们全都散了", "en": "We scattered."},
        {"zh": "别抓我的身体", "en": "Don't grab me."},
        {"zh": "水变得浑浊了", "en": "The water clouded."},
        {"zh": "我撞在石头上", "en": "I hit a stone."},
        {"zh": "我掉了一片鳞", "en": "A scale came off."},
        {"zh": "我们躲进水草", "en": "We hid in the weeds."},
        {"zh": "我还游得动的", "en": "I can still swim."},
        {"zh": "同伴在找我呢", "en": "The others are looking for me."},
        {"zh": "让我游开去吧", "en": "Let me swim away."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么碎屑", "en": "What crumb is that?"},
        {"zh": "我们不吃那个", "en": "We don't eat that."},
        {"zh": "水面上有碎屑", "en": "There are crumbs on the surface."},
        {"zh": "你扔下来的太小了", "en": "What you dropped is too small."},
        {"zh": "我们都围过来了", "en": "We've all gathered."},
        {"zh": "别动，水会晃", "en": "Don't move; the water ripples."},
        {"zh": "那东西不吸引我", "en": "That doesn't tempt me."},
        {"zh": "水底的虫更好", "en": "Insects on the bottom are better."},
        {"zh": "你先扔得远点", "en": "Throw it farther first."},
        {"zh": "再撒一点点吧", "en": "Scatter a little more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞到你身上", "en": "I bumped into you."},
        {"zh": "水一浑我们就乱", "en": "Muddy water scatters us."},
        {"zh": "我在你手边打了个转", "en": "I spun beside your hand."},
        {"zh": "别碰我，我们很轻", "en": "Don't touch; we're light."},
        {"zh": "同伴都散开了", "en": "The others scattered."},
        {"zh": "水面被搅动了", "en": "The surface is churned."},
        {"zh": "我们重新聚起来", "en": "We gather again."},
        {"zh": "我贴着你游过去", "en": "I swim past against you."},
        {"zh": "让一让，我们要过", "en": "Let us through."},
        {"zh": "我们太小，撞不动你", "en": "We're too small to move you."},
        {"zh": "水面炸开一朵花", "en": "The surface burst into spray."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "水暖了才会这样", "en": "Only when the water warms."},
        {"zh": "我们一群一起游", "en": "We swim as a school."},
        {"zh": "这会儿还没到", "en": "Not this season yet."},
        {"zh": "你别看着我们", "en": "Don't watch."},
        {"zh": "到水草后面去", "en": "Behind the weeds."},
        {"zh": "我们只看水流", "en": "We only follow the current."},
        {"zh": "这话题太奇怪", "en": "That's a strange thing to ask."},
        {"zh": "等水暖些再说", "en": "Wait till the water warms."},
        {"zh": "水流会带走这些", "en": "The current carries such things away."},
        {"zh": "我们游走就是了", "en": "We'll just swim off."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "别捏我们身上", "en": "Don't squeeze us."},
        {"zh": "我们在你手里乱撞", "en": "We thrash in your hand."},
        {"zh": "水离我们太远了", "en": "The water is too far."},
        {"zh": "把我们放回去", "en": "Put us back."},
        {"zh": "你的手心很热", "en": "Your palm is hot."},
        {"zh": "我们会喘不上气", "en": "We can't breathe."},
        {"zh": "别把我们分开", "en": "Don't separate us."},
        {"zh": "我们身上很滑", "en": "We're slippery."},
        {"zh": "手下再放轻些", "en": "Ease your grip further."},
        {"zh": "快点放我们回去", "en": "Put us back quickly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我们都躲开了", "en": "We've all darted away."},
        {"zh": "你抓不到我们", "en": "You can't catch us."},
        {"zh": "水流帮着我们", "en": "The current helps us."},
        {"zh": "我们数量太多", "en": "There are too many of us."},
        {"zh": "你手伸得再深也没用", "en": "Reaching deeper won't help."},
        {"zh": "我们会躲进水草", "en": "We'll hide in the weeds."},
        {"zh": "别拍打那水面", "en": "Don't slap the surface."},
        {"zh": "你在那儿站着就好", "en": "Just stand there."},
        {"zh": "我们游远一点", "en": "We'll swim a little farther."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们分成两群", "en": "We've split into two groups."},
        {"zh": "你追这一群，那群就散", "en": "Chase one; the other scatters."},
        {"zh": "水底的影子不是你", "en": "That shadow below isn't yours."},
        {"zh": "我们在水草里", "en": "We're in the weeds."},
        {"zh": "你数不清我们的", "en": "You can't count us."},
        {"zh": "水流会把我们带走", "en": "The current will take us."},
        {"zh": "你的手太慢了", "en": "Your hand is too slow."},
        {"zh": "我们看到你的每一个动作", "en": "We see every move you make."},
        {"zh": "我们快散开了", "en": "We'll scatter soon."},
        {"zh": "我们已经散开", "en": "We've scattered."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我们撞你的手", "en": "We bump your hand."},
        {"zh": "没多大点力气", "en": "Not much force."},
        {"zh": "你手一抖就散了", "en": "One twitch and we scatter."},
        {"zh": "我们在你指缝里", "en": "We're between your fingers."},
        {"zh": "这一下只是乱撞", "en": "That was just thrashing."},
        {"zh": "你抓不住我们的", "en": "You can't hold us."},
        {"zh": "我们越挣越滑", "en": "The more we struggle, the slicker we get."},
        {"zh": "我撞你一下，就闪进水草。", "en": "I bump you once and dart into the weeds."},
        {"zh": "我们要沉下去了", "en": "We're sinking down."},
        {"zh": "我们已经游远", "en": "We've swum off."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一群游进来", "en": "We swim in as a school."},
        {"zh": "水草刚好够藏", "en": "The weeds are just enough cover."},
        {"zh": "河水清澈见底", "en": "The river is clear to the bottom."},
        {"zh": "我们先绕一圈", "en": "Let us circle once."},
        {"zh": "这里的虫不少", "en": "Plenty of insects here."},
        {"zh": "太阳照到水底了", "en": "Sun reaches the bottom."},
        {"zh": "我们从深处上来", "en": "We rise from deeper water."},
        {"zh": "有人站在岸上", "en": "Someone's on the bank."},
        {"zh": "我们的条纹亮了一下", "en": "Our stripes flashed."},
        {"zh": "我们顺着水流", "en": "Follow the current."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水一热，我们就受不了", "en": "We can't bear warm water."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我们从水里被甩到地上", "en": "We were flung out onto dry ground."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我们本来就在水里", "en": "We were already in the water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把水都推开了", "en": "The blast pushed the water away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西从我们中间穿过", "en": "That shot passed through our school."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让水流乱了", "en": "The spell roiled the current."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在水面上，整片河都亮了", "en": "The bolt lit the whole river."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有水", "en": "There's no water in the void."}
      ]
    }
  }
}
