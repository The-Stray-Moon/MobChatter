{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "一颗心脏在走动", "en": "A heart is walking."},
        {"zh": "没有腿，我照样移动", "en": "No legs, yet I still move."},
        {"zh": "火焰从里往外烧", "en": "Fire burns from the inside out."},
        {"zh": "每跳一下，地面就亮", "en": "Each beat lights the ground."},
        {"zh": "我是温迪戈最后的一部分", "en": "I'm the wendigo's last part."},
        {"zh": "骨与肉在火里响", "en": "Bone and flesh crackle in the fire."},
        {"zh": "我身后留下焦痕", "en": "Scorch marks trail behind me."},
        {"zh": "我拖着一段断骨", "en": "I drag a broken bone along."},
        {"zh": "我的跳动声很沉", "en": "My beating is deep."},
        {"zh": "热浪把草压弯", "en": "The heat bows the grass."},
        {"zh": "我慢慢地移动", "en": "I move slowly."},
        {"zh": "血滴在地上会烧", "en": "Where my blood falls, it burns."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在火焰中间", "en": "I hang inside the flames."},
        {"zh": "跳动声越来越慢", "en": "The beating slows."},
        {"zh": "我以为自己会死透", "en": "I thought I'd die completely."},
        {"zh": "一千点生命，全在火里", "en": "A thousand points, all in fire."},
        {"zh": "这团火一时半会熄不掉", "en": "This fire won't die soon."},
        {"zh": "我在等最后一次跳", "en": "I wait for the final beat."},
        {"zh": "肉在烧，却烧不完", "en": "The flesh burns but never finishes."},
        {"zh": "四周的空气都在扭曲", "en": "The air around me warps."},
        {"zh": "我记得那对鹿角", "en": "I remember those antlers."},
        {"zh": "火里还有东西在动", "en": "Something still moves in the flame."},
        {"zh": "我不需要方向", "en": "I need no direction."},
        {"zh": "我只是一颗心", "en": "I'm only a heart."},
        {"zh": "地上已经没有脚印", "en": "No footprints remain."},
        {"zh": "我在原地跳着", "en": "I beat in place."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你亲手杀了我", "en": "You killed me yourself."},
        {"zh": "现在我只是一团火", "en": "Now I'm only a fire."},
        {"zh": "你看得见我还跳着", "en": "You can see I'm still beating."},
        {"zh": "你想拿走这颗心", "en": "You want to take this heart."},
        {"zh": "那你得伸手进来", "en": "Then reach into the fire."},
        {"zh": "这团火不会灭", "en": "This fire won't die."},
        {"zh": "你身上的影子在跳", "en": "The shadow on you is pulsing."},
        {"zh": "站这里很热吧", "en": "Hot standing here, isn't it?"},
        {"zh": "你会带着我走", "en": "You'll carry me away."},
        {"zh": "我记得你的刀", "en": "I remember your knife."},
        {"zh": "你身上有那个味道", "en": "You carry that smell."},
        {"zh": "我还会跳很久", "en": "I'll beat for a long while."},
        {"zh": "你说不定会听见", "en": "You might still hear it."},
        {"zh": "那声音会跟着你", "en": "That sound will follow you."},
        {"zh": "我最后还是会凉", "en": "In the end I'll go cold."},
        {"zh": "但还不是现在", "en": "But not now."},
        {"zh": "抖了也没关系", "en": "It doesn't matter if it does."},
        {"zh": "这团火会记得你", "en": "The fire will remember you."},
        {"zh": "再往这边走近一点", "en": "Come a little closer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "火被打得晃了一下", "en": "The fire flickered from the blow."},
        {"zh": "火星溅得到处都是", "en": "Sparks scatter everywhere."},
        {"zh": "我几乎是杀不死的", "en": "I'm nearly unkillable."},
        {"zh": "这具身体已经死了", "en": "This body is already dead."},
        {"zh": "我的心还在跳着", "en": "My heart is still beating."},
        {"zh": "光线暗了一瞬", "en": "The light dimmed briefly."},
        {"zh": "灰落得满地都是", "en": "Ash falls everywhere."},
        {"zh": "你打碎了一点骨头", "en": "You broke a little bone."},
        {"zh": "火又重新旺起来", "en": "The fire flares again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我并不需要吃东西", "en": "I don't eat."},
        {"zh": "一颗心不需要喂", "en": "A heart needs no feeding."},
        {"zh": "你举着的东西会烧起来", "en": "What you hold will catch fire."},
        {"zh": "我想要的只有火", "en": "Fire is all I want."},
        {"zh": "那点东西一秒成灰", "en": "That turns to ash in a second."},
        {"zh": "我烧的不是这个", "en": "What I burn isn't that."},
        {"zh": "我对食物没兴趣", "en": "I've no interest in food."},
        {"zh": "你留着吧，别靠近", "en": "Keep it; don't come close."},
        {"zh": "火的胃口才是我", "en": "Fire's appetite is me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞进火里了", "en": "You collided with fire."},
        {"zh": "我的热度很高", "en": "My heat runs high."},
        {"zh": "你退半步，衣服冒烟", "en": "You stepped back, clothes smoking."},
        {"zh": "我几乎没有实体", "en": "I'm barely solid."},
        {"zh": "碰到我的地方会烫", "en": "Where you touched me burns."},
        {"zh": "我还在这里烧着", "en": "I'm still burning here."},
        {"zh": "心跳传到你手心", "en": "My pulse reached your palm."},
        {"zh": "这其实算不上碰撞", "en": "That wasn't really a bump."},
        {"zh": "离远一点为好", "en": "It's best to keep your distance."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一团余烬", "en": "I'm only embers."},
        {"zh": "心脏不谈这些", "en": "A heart doesn't speak of that."},
        {"zh": "我连人形都没有", "en": "I don't even have a shape."},
        {"zh": "这份火不能分给谁", "en": "This fire can't be shared."},
        {"zh": "我正在慢慢熄灭", "en": "I'm slowly going out."},
        {"zh": "你找的是那个东西", "en": "You're after the other thing."},
        {"zh": "它已经不在了", "en": "It isn't here anymore."},
        {"zh": "我身上烫得很", "en": "I'm burning hot."},
        {"zh": "让我安静烧完", "en": "Let me burn out in peace."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上还有一些骨骸", "en": "There are bones on the ground."},
        {"zh": "我用火焰去碰", "en": "I touch them with flame."},
        {"zh": "它一下就焦了", "en": "They char instantly."},
        {"zh": "我根本捡不起来", "en": "I can't pick them up at all."},
        {"zh": "这些对我并不重要", "en": "These don't matter to me."},
        {"zh": "我的心只装着火", "en": "My heart holds only fire."},
        {"zh": "脚下还有碎骨", "en": "More bone fragments below."},
        {"zh": "我让火把它烧着", "en": "I let the fire take it."},
        {"zh": "你尽管把它拿走", "en": "Go ahead and take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的火转向你了", "en": "My fire has turned to you."},
        {"zh": "你离我非常近", "en": "You're extremely close to me."},
        {"zh": "一千点，够烧很久", "en": "A thousand points; long burning."},
        {"zh": "我不追，我在这里烧", "en": "I won't chase; I burn here."},
        {"zh": "你的鞋会先着火", "en": "Your boots will catch first."},
        {"zh": "我是死物，但还会动", "en": "I'm dead, yet I still move."},
        {"zh": "火苗窜起来了", "en": "The flames have leapt up."},
        {"zh": "这其实不算攻击", "en": "This isn't really an attack."},
        {"zh": "这是最后的东西", "en": "This is all that's left."},
        {"zh": "你先做好准备", "en": "Better get ready first."},
        {"zh": "我的火转向你了，你的鞋会先着。", "en": "My fire has turned to you; your boots will catch first."},
        {"zh": "比刚才亮得多", "en": "Brighter than before."},
        {"zh": "你听见跳声了吗", "en": "Do you hear the beating?"},
        {"zh": "已经非常近了", "en": "It's very close now."},
        {"zh": "就在你的面前", "en": "Right in front of you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你这边移", "en": "I drift toward you."},
        {"zh": "热量会先传到你身上", "en": "The heat reaches you first."},
        {"zh": "火苗伸得比我还远", "en": "The flames reach farther than I do."},
        {"zh": "你身上的汗就是反应", "en": "Your sweat is the answer."},
        {"zh": "我在烧你的路", "en": "I'm burning your path."},
        {"zh": "地上的草都焦了", "en": "The grass beneath is scorched."},
        {"zh": "我不需要追过去", "en": "I needn't chase."},
        {"zh": "我的跳动越来越快", "en": "My beating quickens."},
        {"zh": "你能听见那个节奏", "en": "You can hear that rhythm."},
        {"zh": "它和你的心跳不一样", "en": "It doesn't match your heartbeat."},
        {"zh": "灰会落在你身上", "en": "Ash will fall on you."},
        {"zh": "火焰里，我慢慢转向你。", "en": "Inside the flames, I turn slowly toward you."},
        {"zh": "这团火灭不下去", "en": "This fire can't be put out."},
        {"zh": "它只会慢慢变小", "en": "It only shrinks."},
        {"zh": "但我现在很旺", "en": "But right now I'm roaring."},
        {"zh": "那是我又跳了一下", "en": "That was another beat."},
        {"zh": "火苗变了方向", "en": "The flames changed direction."},
        {"zh": "它正朝着你那边", "en": "It's heading toward you."},
        {"zh": "近得躲不开了", "en": "So close you can't dodge."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗扫到你身上", "en": "The flames sweep across you."},
        {"zh": "我一跳，火花四散", "en": "One beat and sparks scatter."},
        {"zh": "这股热浪推着你", "en": "The heat wave pushes you."},
        {"zh": "你的衣服点着了", "en": "Your clothes caught fire."},
        {"zh": "我撞过去，很烫", "en": "I ram you, and it burns."},
        {"zh": "火花落在你脸上", "en": "Sparks land on your face."},
        {"zh": "这不是刻意的一击", "en": "This wasn't a deliberate blow."},
        {"zh": "我只是一直在烧", "en": "I only keep burning."},
        {"zh": "你退开，火还在", "en": "You retreat; the fire remains."},
        {"zh": "我会一直跳下去", "en": "I'll keep beating on."},
        {"zh": "骨头烧断的开裂声", "en": "Bones crack as they burn."},
        {"zh": "灰全都飘起来了", "en": "Ash rises everywhere."},
        {"zh": "你身上多了一片焦", "en": "You've a new scorch mark."},
        {"zh": "燃烧的心跳，催我向前。", "en": "My burning heartbeat drives me forward."},
        {"zh": "火焰忽然拔高", "en": "The flame suddenly surges."},
        {"zh": "我的心还在跳", "en": "My heart is still beating."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "那具身体倒了", "en": "That body has fallen."},
        {"zh": "火从里面冒出来", "en": "Fire spills out from within."},
        {"zh": "一颗心脏在燃烧", "en": "A heart is burning."},
        {"zh": "那个音效响了起来", "en": "The sound rang out."},
        {"zh": "我从尸体里升起来", "en": "I rise out of the corpse."},
        {"zh": "骨头在火里裂开", "en": "Bones split in the fire."},
        {"zh": "周围的地面都焦了", "en": "The ground around is scorched."},
        {"zh": "我还活着，只是这样", "en": "I'm alive, in this way only."},
        {"zh": "跳动声传得很远", "en": "My beating carries far."},
        {"zh": "热度会先传开来", "en": "The heat spreads first."},
        {"zh": "这片林子静不下来", "en": "This forest won't be quiet."},
        {"zh": "我是最后的那个东西", "en": "I'm the last of it."},
        {"zh": "尸体已经没有了", "en": "The corpse is gone."},
        {"zh": "只剩下这一颗心", "en": "Only this heart remains."},
        {"zh": "鹿角倒在不远处", "en": "Antlers lie nearby."},
        {"zh": "我不再看它们", "en": "I don't look at them."},
        {"zh": "火光照亮了树", "en": "The fire lights the trees."},
        {"zh": "你听见那声低响了吗", "en": "Did you hear that low sound?"},
        {"zh": "那是它在跳动", "en": "That's it beating."},
        {"zh": "我烧到你拿走它", "en": "I burn until you take it."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我没有意义", "en": "Fire means nothing to me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，火却更旺", "en": "I fell, and the fire blazed higher."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一浇，我暗了一半", "en": "Water hit me; half my light died."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把火星吹得很远", "en": "The blast blew sparks far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过了火", "en": "Something passed through the fire."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这力量压得火变小", "en": "This force shrinks my fire."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，火窜得更高", "en": "Lightning struck; the fire leapt higher."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "火在空中还在烧", "en": "The fire still burns in the air."}
      ]
    }
  }
