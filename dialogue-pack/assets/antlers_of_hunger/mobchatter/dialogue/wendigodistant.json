{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在很远的地方走着", "en": "I walk far away."},
        {"zh": "树挡着，你只看得到轮廓", "en": "Trees hide me; you see only a shape."},
        {"zh": "我一圈一圈地绕", "en": "I circle round and round."},
        {"zh": "我踩断的枝条很轻", "en": "The branches I break are thin."},
        {"zh": "我走得很慢，不着急", "en": "I walk slowly, unhurried."},
        {"zh": "我一直在你视野的边缘", "en": "I stay at the edge of your sight."},
        {"zh": "鹿角在树冠间移动", "en": "My antlers shift among the crowns."},
        {"zh": "我走一步停三步", "en": "One step forward, three paused."},
        {"zh": "我沿着林线游荡", "en": "I roam along the tree line."},
        {"zh": "你回头时我不动", "en": "When you look back, I don't move."},
        {"zh": "我的脚印很浅", "en": "My footprints are shallow."},
        {"zh": "我在找一只走散的动物", "en": "I'm hunting a stray animal."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "这一带够我待很久", "en": "I can stay here a long while."},
        {"zh": "不饿的时候我只看着", "en": "When not hungry, I only watch."},
        {"zh": "你的营火还亮着", "en": "Your campfire is still lit."},
        {"zh": "我在数你们有几个人", "en": "I'm counting how many of you."},
        {"zh": "我很少靠得近", "en": "I rarely come close."},
        {"zh": "远处那一声是我的", "en": "That distant cry is mine."},
        {"zh": "树影把我藏得很好", "en": "Tree shadows hide me well."},
        {"zh": "我用不着动手", "en": "I needn't act."},
        {"zh": "光是看着就足够了", "en": "Just watching is enough."},
        {"zh": "你睡觉时我也在", "en": "I'm there while you sleep."},
        {"zh": "我在不在都一样", "en": "Here or not here, it's the same."},
        {"zh": "我的存在本身就是提醒", "en": "My presence is the reminder."},
        {"zh": "风把我的声音送过去", "en": "The wind carries my voice to you."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看不到我，对吧", "en": "You can't see me, can you?"},
        {"zh": "我在那棵树后面", "en": "I'm behind that tree."},
        {"zh": "你刚才是觉得有人看吧", "en": "Did you feel watched?"},
        {"zh": "那是真的发生过", "en": "That was real."},
        {"zh": "我离你还很远", "en": "I'm far from you."},
        {"zh": "远到你觉得安全", "en": "Far enough to feel safe."},
        {"zh": "你的火光照不到我", "en": "Your firelight doesn't reach me."},
        {"zh": "但我看得见火光", "en": "But I can see it."},
        {"zh": "你数树，我数你", "en": "You count trees; I count you."},
        {"zh": "我们的距离刚刚好", "en": "Our distance is just right."},
        {"zh": "你再近，我也会近", "en": "Come closer, and so will I."},
        {"zh": "我还没打算过来", "en": "I don't intend to come yet."},
        {"zh": "你会先受不了", "en": "You'll break first."},
        {"zh": "这片林子是我的", "en": "These woods are mine."},
        {"zh": "你只是路过而已", "en": "You're only passing through."},
        {"zh": "我记得你的轮廓", "en": "I remember your outline."},
        {"zh": "下次我还会在这里", "en": "I'll be here next time too."},
        {"zh": "别往林子深处走", "en": "Don't go deep into the woods."},
        {"zh": "那里离我太近", "en": "That's too close to me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你居然打到我了", "en": "You actually hit me."},
        {"zh": "这一下让我重视你", "en": "That made me take you seriously."},
        {"zh": "我不习惯被找到", "en": "I'm not used to being found."},
        {"zh": "我的血是黑的", "en": "My blood is black."},
        {"zh": "我换了棵树后", "en": "I moved behind another tree."},
        {"zh": "我记住这个角度了", "en": "I've noted that angle."},
        {"zh": "我会待得更远一些", "en": "I'll stay a little farther."},
        {"zh": "然后再回来找你", "en": "And then come back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举着的食物，留给自己吧。", "en": "Keep the food you hold for yourself."},
        {"zh": "活的东西才算", "en": "Only living things count."},
        {"zh": "隔着很远也看得到", "en": "I can see that from far off."},
        {"zh": "那点东西不值得我靠近", "en": "That's not worth approaching."},
        {"zh": "我在这里有别的食物", "en": "I have other food out here."},
        {"zh": "林子里动物够吃了", "en": "The forest's animals suffice."},
        {"zh": "你留着吧，别举着", "en": "Keep it; don't hold it up."},
        {"zh": "你越举，我越不动", "en": "The more you hold it, the stiller I stay."},
        {"zh": "这不是我下来的理由", "en": "That's not why I'd come down."},
        {"zh": "拿开，我只想看着", "en": "Put it away; I only want to watch."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你根本撞不到我", "en": "You can't reach me."},
        {"zh": "我们之间还隔着树", "en": "There are trees between us."},
        {"zh": "你走过来我就退", "en": "Come closer and I retreat."},
        {"zh": "这一点接触不算什么", "en": "This brief contact is nothing."},
        {"zh": "你碰到的是我的影子", "en": "You touched my shadow."},
        {"zh": "我的手非常凉", "en": "My hands are very cold."},
        {"zh": "你不该走这么近", "en": "You shouldn't come this close."},
        {"zh": "现在你知道了", "en": "Now you know."},
        {"zh": "你这就退回去吧", "en": "Go back the way you came."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是远远看着", "en": "I only watch from afar."},
        {"zh": "这不是我在此的原因", "en": "That's not why I'm here."},
        {"zh": "我的距离就是回答", "en": "My distance is my answer."},
        {"zh": "林子里只有风声", "en": "Only wind in these woods."},
        {"zh": "我不需要别的，林子里有我一个就够。", "en": "I need nothing else; one of me is enough in these woods."},
        {"zh": "你该问的不是这个", "en": "That's not what you should ask."},
        {"zh": "别过来，站住", "en": "Don't come over; stay put."},
        {"zh": "我一直都是这样", "en": "I've always been this way."},
        {"zh": "远远看着就足够了", "en": "Watching is enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有动物的残骸", "en": "Animal remains on the ground."},
        {"zh": "我在远处就看得到", "en": "I can see them from afar."},
        {"zh": "远处林子里，我一直看着你。", "en": "From the far trees I keep watching you."},
        {"zh": "这点残骸够一顿", "en": "These remains make a meal."},
        {"zh": "我不急，慢慢吃", "en": "No hurry; I eat slowly."},
        {"zh": "骨头留在原地", "en": "I leave the bones where they are."},
        {"zh": "地上有血，我闻得到", "en": "I smell the blood."},
        {"zh": "我不碰你放下的东西", "en": "I don't touch what you leave."},
        {"zh": "这是在我地盘上的", "en": "This is on my ground."},
        {"zh": "吃完我还会回来", "en": "I'll come back after eating."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进林子了", "en": "You've entered the woods."},
        {"zh": "林子深处，我看着你。", "en": "Deep in the trees, I watch you."},
        {"zh": "一步距离就够", "en": "One step is enough."},
        {"zh": "我等你走错方向", "en": "I wait for you to go the wrong way."},
        {"zh": "你前面没有路", "en": "There's no path ahead."},
        {"zh": "我在那个方向", "en": "I'm in that direction."},
        {"zh": "不用往后面看", "en": "Don't bother looking back."},
        {"zh": "我就在你前面", "en": "I'm ahead."},
        {"zh": "你已经在圈里了", "en": "You're already inside the circle."},
        {"zh": "我压根用不着动", "en": "I needn't move."},
        {"zh": "你会自己过来", "en": "You'll come to me."},
        {"zh": "这片林子会帮忙", "en": "The woods will help."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你走，我也走", "en": "You move; I move."},
        {"zh": "你每一步我都知道", "en": "I know your every step."},
        {"zh": "树叶的声音暴露了你", "en": "The leaves betray you."},
        {"zh": "你是绕不出去的", "en": "You can't circle out."},
        {"zh": "这里的地形我熟", "en": "I know this terrain."},
        {"zh": "你越走就越深", "en": "You're going deeper."},
        {"zh": "深处的树更密", "en": "The trees thicken deeper in."},
        {"zh": "我就在树后面", "en": "I'm behind a trunk."},
        {"zh": "你回头只有影子", "en": "Look back: only shadows."},
        {"zh": "那些影子会动", "en": "Shadows move."},
        {"zh": "我用不着走近", "en": "I've no need to come near."},
        {"zh": "你的心跳越来越响", "en": "Your heartbeat grows loud."},
        {"zh": "我也听得一清二楚", "en": "And I hear it."},
        {"zh": "再走一段就到尽头", "en": "A little farther and it ends."},
        {"zh": "尽头处没有路", "en": "No path at the end."},
        {"zh": "我站在远树间，不急着靠近。", "en": "I stand among distant trees, in no hurry."},
        {"zh": "你不用急着跑", "en": "No need to run in a hurry."},
        {"zh": "我也不会着急", "en": "And I won't rush either."},
        {"zh": "我们都有时间", "en": "We both have time."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树后出来", "en": "I step out from behind a tree."},
        {"zh": "长手一下就跨过距离", "en": "One long arm crosses the gap."},
        {"zh": "你挡住了，退了好几步", "en": "You blocked, and slid back steps."},
        {"zh": "我在很远的地方挥了一下，没有声音。", "en": "Far off, I swing once, and there is no sound."},
        {"zh": "树在我身后断了", "en": "A tree snapped behind me."},
        {"zh": "我就在你的侧面", "en": "I'm at your flank."},
        {"zh": "你的火把掉了", "en": "Your torch fell."},
        {"zh": "我把你推回林子里", "en": "I push you back into the woods."},
        {"zh": "你还是看不见我", "en": "You still can't see me."},
        {"zh": "这一下从你看不见的方向来", "en": "This comes from where you can't see."},
        {"zh": "我的鹿角顶到你后背", "en": "My antlers butt your back."},
        {"zh": "我抓住你的衣领拖了一段", "en": "I grab your collar and drag you."},
        {"zh": "树被我的手扫断了", "en": "My hand swept a tree apart."},
        {"zh": "你被拖进了更深的林子", "en": "You're dragged deeper into the woods."},
        {"zh": "然后我松手，退开", "en": "Then I let go and withdraw."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在很远的地方出现", "en": "I appear far away."},
        {"zh": "先是一声嘶吼", "en": "First, a shriek."},
        {"zh": "树影里有一对鹿角", "en": "Antlers in the tree shadows."},
        {"zh": "我在你视野的边上", "en": "I'm at the edge of your sight."},
        {"zh": "这段距离让人难受", "en": "This distance is uncomfortable."},
        {"zh": "我不靠近，也不走", "en": "I neither approach nor leave."},
        {"zh": "你的营地我看得见", "en": "I can see your camp."},
        {"zh": "风把我的气味吹散", "en": "The wind scatters my scent."},
        {"zh": "我就在林线那一段", "en": "I'm along that stretch of tree line."},
        {"zh": "你听到第二次了吗", "en": "Did you hear the second one?"},
        {"zh": "那说明我换了位置", "en": "It means I moved."},
        {"zh": "你开始往那边看了", "en": "You're starting to look that way."},
        {"zh": "我一直都在那里", "en": "I've been here all along."},
        {"zh": "只是你没注意到", "en": "You just didn't notice."},
        {"zh": "远远地看着你", "en": "Watching, from afar."},
        {"zh": "林线那头的动静，我听见了。", "en": "I hear the stir beyond the treeline."},
        {"zh": "我不必现身出来", "en": "I needn't show myself."},
        {"zh": "有声音就够了", "en": "The sound is enough."},
        {"zh": "这个夜里还很长", "en": "The night is still long."},
        {"zh": "你会一直想着我", "en": "You'll keep thinking of me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光暴露了我的位置", "en": "The firelight exposed my position."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上落了下来", "en": "I fell from a tree."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水会让我留下痕迹", "en": "Water leaves traces of me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "林子被炸开一片", "en": "A stretch of woods was blown open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "你的箭找到了我", "en": "Your arrow found me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这力量让我无处可藏", "en": "This force leaves me nowhere to hide."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得待不住了", "en": "Hunger makes me restless."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照亮了整片林子", "en": "Lightning lit the whole forest."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我也在坠", "en": "Nothing below; even I fall."}
      ]
    }
  }
}
