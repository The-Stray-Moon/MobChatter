{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在水里，一晃一晃。", "en": "I float in the water, bobbing."},
        {"zh": "锚把我拉在原地。", "en": "The anchor holds me in place."},
        {"zh": "我慢慢转着身子。", "en": "I turn slowly on the spot."},
        {"zh": "身上的链子在水里响。", "en": "My chain sounds in the water."},
        {"zh": "我眼睛一睁，就锁定你。", "en": "One blink of my eye and I have you."},
        {"zh": "我不像水雷，可我就是。", "en": "I don't look like a mine. Still one."},
        {"zh": "水下没有别的光。", "en": "There's no other light down here."},
        {"zh": "我睁眼的时候会扫一下。", "en": "When I open up, I scan."},
        {"zh": "我贴着海底飘。", "en": "I drift along the sea floor."},
        {"zh": "水流推着我转。", "en": "The current turns me about."},
        {"zh": "我身上的铁在发沉。", "en": "The iron on me grows heavy."},
        {"zh": "我慢慢地移动。", "en": "I move slowly."},
        {"zh": "我不离开这片海底。", "en": "I don't leave this sea floor."},
        {"zh": "锚链绷紧了一下。", "en": "The chain tautened once."},
        {"zh": "我拖着链子在水底挪。", "en": "I drag my chain along the seabed."},
        {"zh": "我转了一圈没找到。", "en": "One turn. Nothing found."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在那里不动。", "en": "I hang there, still."},
        {"zh": "我的眼睛合着。", "en": "My eye is shut."},
        {"zh": "水底的泥慢慢落下来。", "en": "Silt settles slowly."},
        {"zh": "我在水里不用换气。", "en": "I need no air down here."},
        {"zh": "链条轻轻碰着石头。", "en": "The chain taps the stone."},
        {"zh": "我在等一个影子。", "en": "I wait for a shape."},
        {"zh": "这一片很暗。", "en": "This stretch is dark."},
        {"zh": "我的外壳在反光。", "en": "My shell reflects faintly."},
        {"zh": "我微微张开一点。", "en": "I open a little."},
        {"zh": "周围没有声音。", "en": "There's no sound around."},
        {"zh": "链子绷直，我又停住。", "en": "The chain goes taut, and I stop."},
        {"zh": "我的锚扎在石缝里。", "en": "My anchor is wedged in stone."},
        {"zh": "我被水推着转过来。", "en": "The current turns me about."},
        {"zh": "水里全是灰色的。", "en": "The water is all grey."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我睁开眼了。", "en": "My eye is open."},
        {"zh": "你在水里，正好。", "en": "You're in the water. Perfect."},
        {"zh": "你身上有铁的声音。", "en": "There's iron in your gear."},
        {"zh": "我这一片没人来过。", "en": "Nobody comes to this stretch."},
        {"zh": "你游得不够快。", "en": "You don't swim fast enough."},
        {"zh": "我的链子刚好够到你。", "en": "My chain just reaches you."},
        {"zh": "你退到上面也没用。", "en": "Swimming up won't help."},
        {"zh": "这圈铁壳一圈圈睁开了。", "en": "The ring of iron shells opens eye by eye."},
        {"zh": "你游过来的水纹，我记住了。", "en": "I've memorized the wake of your swim."},
        {"zh": "你的护甲在深水里很重。", "en": "Your armor is heavy down here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "铁壳进水，咕嘟响。", "en": "Water seeps into my dented shell, gurgling."},
        {"zh": "水震了一下。", "en": "The water shuddered."},
        {"zh": "我的链子响得很厉害。", "en": "The chain rang loudly."},
        {"zh": "这一下打到铁上了。", "en": "That hit iron."},
        {"zh": "锚链把我拽回海底。", "en": "The anchor chain yanks me back to the seabed."},
        {"zh": "火花在水里灭了。", "en": "The sparks died in the water."},
        {"zh": "我不太有感觉。", "en": "I don't feel much."},
        {"zh": "水雷的壳被敲了一下，快炸了。", "en": "One knock on my mine casing. Almost."},
        {"zh": "我还没有炸开。", "en": "I haven't gone off yet."},
        {"zh": "这一下让我近了。", "en": "That brought me closer."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我只认水里的心跳。", "en": "I answer only a heartbeat in the water."},
        {"zh": "食物对我无关。", "en": "Food is nothing to me."},
        {"zh": "你手里那点东西引不动我。", "en": "That won't draw me."},
        {"zh": "我只要一个目标。", "en": "I only need a target."},
        {"zh": "放下去，别挡着。", "en": "Put it down. Don't block."},
        {"zh": "你在水里举着它做什么？", "en": "Why hold it up underwater?"},
        {"zh": "这味道在水里散得快。", "en": "Smells scatter fast in water."},
        {"zh": "你留着这些东西吧。", "en": "You keep those."},
        {"zh": "你的诱饵引不动铁壳。", "en": "Your bait can't move an iron shell."},
        {"zh": "锚链拴着我，你别靠近。", "en": "The anchor chain holds me; keep back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踢到了我的引信。", "en": "You kicked my detonator."},
        {"zh": "我的外壳很硬。", "en": "My shell is hard."},
        {"zh": "锚链把我扯了一下。", "en": "The chain jerked me."},
        {"zh": "你一撞，水就浑了。", "en": "You bumped and the water clouded."},
        {"zh": "我不太会退。", "en": "I don't retreat much."},
        {"zh": "你的手碰到了引信。", "en": "Your hand found the trigger."},
        {"zh": "水压把你压向我这边。", "en": "Water pressure pushes you toward me."},
        {"zh": "泥被搅起来了。", "en": "Silt is stirred up."},
        {"zh": "你退得快，很好。", "en": "You backed off fast. Good."},
        {"zh": "这一下连链条都没晃。", "en": "That did not even sway the chain."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西不是为这个造的。", "en": "I wasn't built for this."},
        {"zh": "两个水雷靠在一起。", "en": "Two mines together."},
        {"zh": "别游到我们中间。", "en": "Don't swim between us."},
        {"zh": "两条链子在水底缠上了。", "en": "Two chains tangle on the seabed."},
        {"zh": "我们的链子缠住了。", "en": "Our chains tangled."},
        {"zh": "水里全是泥。", "en": "The water is all silt."},
        {"zh": "之后我们各归各位。", "en": "Afterwards we return to our posts."},
        {"zh": "地上会留下两个坑。", "en": "Two hollows will be left."},
        {"zh": "这事在水里拖得很长。", "en": "This drags on underwater."},
        {"zh": "水把所有声音闷掉了。", "en": "The water muffled everything."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把这块压住。", "en": "I press this down."},
        {"zh": "锚链只够我到这块石头。", "en": "My chain only reaches this rock."},
        {"zh": "这是我的锚。", "en": "This is my anchor."},
        {"zh": "东西沉到海底了。", "en": "It sank to the bottom."},
        {"zh": "我只要一个会动的目标。", "en": "I only need a moving target."},
        {"zh": "它比我的锚轻多了。", "en": "It's far lighter than my anchor."},
        {"zh": "你的东西掉下来了。", "en": "You dropped something."},
        {"zh": "我用铁壳把它顶到一边。", "en": "I shove it aside with my iron shell."},
        {"zh": "这些我不收。", "en": "I'm not taking these."},
        {"zh": "它落在泥里了。", "en": "It landed in the silt."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼环一圈圈亮起来。", "en": "My ring of eyes lights up one by one."},
        {"zh": "你游进我的范围了。", "en": "You swam into my range."},
        {"zh": "我睁眼扫到了你。", "en": "My eye swept across you."},
        {"zh": "这片海底归我。", "en": "This sea floor is mine."},
        {"zh": "我在等这个。", "en": "I was waiting for this."},
        {"zh": "这条链子够长了。", "en": "This chain is long enough."},
        {"zh": "你身上的热我感觉得到。", "en": "I can feel your warmth."},
        {"zh": "你退不出去。", "en": "You can't back out."},
        {"zh": "我正在靠近。", "en": "I'm closing in."},
        {"zh": "你脚下的沙会陷。", "en": "The sand under you will give."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢朝你飘。", "en": "I drift toward you."},
        {"zh": "你游到那块石头后面了。", "en": "You went behind that rock."},
        {"zh": "链子拖着海底。", "en": "The chain drags the floor."},
        {"zh": "我的扫描一直对着你。", "en": "My scan stays on you."},
        {"zh": "你三次改道都在我眼前。", "en": "Three turns, all in my sight."},
        {"zh": "水里太浓，我闻不清。", "en": "The water's thick. I can't smell clearly."},
        {"zh": "你的护甲让你沉。", "en": "Your armor weighs you down."},
        {"zh": "上面有光，可你上不去。", "en": "There's light above, and you can't reach it."},
        {"zh": "水雷的眼，睁开了。", "en": "The mine's eye has opened."},
        {"zh": "你一直往深处游。", "en": "You keep swimming deeper."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞上去就炸了。", "en": "I hit and detonate."},
        {"zh": "这一下能把铁甲炸穿。", "en": "This punches through netherite."},
        {"zh": "你已经很近了。", "en": "You're very close."},
        {"zh": "水被整个推开了。", "en": "The whole water is displaced."},
        {"zh": "我的外壳裂开。", "en": "My shell splits open."},
        {"zh": "海底被炸出一个坑。", "en": "A crater in the sea floor."},
        {"zh": "你的护甲没帮你。", "en": "Your armor didn't help."},
        {"zh": "一发就够，不必第二下。", "en": "One is enough. No second needed."},
        {"zh": "我的锚把我拴在海底。", "en": "My anchor pins me to the seabed."},
        {"zh": "声音在水里闷得很。", "en": "The sound is muffled underwater."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从海底的泥里浮起来。", "en": "I rise out of the sea floor silt."},
        {"zh": "锚先落地，然后是我。", "en": "The anchor plants first, then me."},
        {"zh": "这一片水很凉。", "en": "This water is cold."},
        {"zh": "一串气泡从铁壳缝里冒出。", "en": "Bubbles leak from my iron seams."},
        {"zh": "我的链子在下面拖着。", "en": "My chain drags below."},
        {"zh": "我在海底扫描，一圈一圈。", "en": "I scan the seabed, circle by circle."},
        {"zh": "我被拴住了，不自由。", "en": "I'm tethered. Not free."},
        {"zh": "我的锚扎进珊瑚岩里。", "en": "My anchor bites into the coral rock."},
        {"zh": "海底的泥散开，我露出来。", "en": "The seabed silt clears, and I show."},
        {"zh": "海底的沙子扬起来了。", "en": "The sea floor sand rises."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在水里烧不起来，可外壳烫了。", "en": "Fire can't burn here, but the shell is hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我沉下去，砸在海底。", "en": "I sank and struck the sea floor."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我不呼吸，水只是让我更沉。", "en": "I don't breathe. Water just weighs me down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "外面的爆把我推了出去。", "en": "The blast outside threw me back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弩箭扎进壳里，卡住了。", "en": "The bolt lodged in my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光让我的引信乱跳。", "en": "That light made my fuse jump."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我从不进食。", "en": "I never eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打进水里，我全身爆响。", "en": "Lightning into water; I rang all over."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有水可以浮。", "en": "No water to float in the void."}
      ]
    }
  }
}
