  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着大步走", "en": "I stride along."},
        {"zh": "我的腿是姜饼的", "en": "My legs are made of gingerbread."},
        {"zh": "我走过的地方掉糖屑", "en": "Sugar crumbs fall where I walk."},
        {"zh": "我盯着你围裙上的口袋", "en": "I stare at the pocket on your apron"},
        {"zh": "我一走就有香味", "en": "A sweet smell follows me."},
        {"zh": "我拐过糖果屋的墙角", "en": "I turn past the candy house."},
        {"zh": "我的脚步很脆", "en": "My steps are brittle."},
        {"zh": "我朝储藏桶的方向走", "en": "I head for the storage barrel."},
        {"zh": "我一边走一边摸口袋", "en": "I pat my pockets as I walk."},
        {"zh": "我跳过一颗糖豆", "en": "I hop over a gumdrop."},
        {"zh": "我的手臂在晃", "en": "My arms sway as I move."},
        {"zh": "我踮着脚尖走路", "en": "I walk on the tips of my toes."}
      ]
    },
    "idle": {
