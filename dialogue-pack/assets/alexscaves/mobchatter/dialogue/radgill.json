{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在酸液里游得很慢。", "en": "I swim slowly through the acid."},
        {"zh": "三只眼睛都睁着。", "en": "All three eyes are open."},
        {"zh": "我的鳍在水里划。", "en": "My fins cut the liquid."},
        {"zh": "酸液在我身上滑过去。", "en": "The acid slides off me."},
        {"zh": "我贴着洞底游。", "en": "I swim along the cave floor."},
        {"zh": "这里的水是绿的。", "en": "The water here is green."},
        {"zh": "我朝那层浮沫那边游。", "en": "I swim toward the surface scum."},
        {"zh": "我身上的色很亮。", "en": "My colors are bright."},
        {"zh": "我绕开那些石头。", "en": "I swim around the stones."},
        {"zh": "我尾巴摆得很快。", "en": "My tail beats quickly."},
        {"zh": "我游过一片冒泡的地方。", "en": "I pass a patch of bubbles."},
        {"zh": "慢慢转过身子，酸液在流。", "en": "Turning slowly. Acid drips."},
        {"zh": "我身上的鳞是硬的。", "en": "These scales are hard."},
        {"zh": "我游得不快，也很稳。", "en": "Not fast, but steady."},
        {"zh": "我从水草的缝里过去。", "en": "I slip between the weeds."},
        {"zh": "酸液一点伤不到我。", "en": "The acid doesn't touch me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在酸液里。", "en": "I hang in the acid."},
        {"zh": "三只眼看着不同的方向。", "en": "Three eyes, three directions."},
        {"zh": "我的第三只眼看着水底。", "en": "My third eye watches the bottom."},
        {"zh": "酸液里就我一个。", "en": "I am alone in this acid."},
        {"zh": "我的鳞只微微发亮。", "en": "My scales only barely glow."},
        {"zh": "酸水里，我的影子是绿的。", "en": "In the acid, my shadow is green."},
        {"zh": "水面上一层浮沫。", "en": "A layer of scum on the surface."},
        {"zh": "除了游，没什么事。", "en": "Nothing to do but swim."},
        {"zh": "我伏在池底不动。", "en": "I lie still on the pool floor."},
        {"zh": "酸味一直在这。", "en": "The acid smell is constant."},
        {"zh": "我晃了晃尾巴。", "en": "I flicked my tail."},
        {"zh": "酸液把我的体温压低了。", "en": "The acid keeps my blood cold."},
        {"zh": "我慢慢沉了下去。", "en": "I sank slowly."},
        {"zh": "我吐出一个气泡，它炸了。", "en": "I spit a bubble and it pops."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进酸液了。", "en": "You've stepped into the acid."},
        {"zh": "这东西会咬你的皮。", "en": "This stuff bites through skin."},
        {"zh": "我有三只眼睛。", "en": "I have three eyes."},
        {"zh": "你一点鳞都没有。", "en": "You have not a single scale."},
        {"zh": "我这三只眼只是看看你。", "en": "All three of my eyes just look at you."},
        {"zh": "你的靴底在酸里冒泡。", "en": "Your soles are bubbling in the acid."},
        {"zh": "这里的水对我不算什么。", "en": "The water here is nothing to me."},
        {"zh": "你退出去比较好。", "en": "You'd better get out."},
        {"zh": "我看到你身上有几个洞。", "en": "I see holes in you."},
        {"zh": "你手里的灯很亮。", "en": "Your lamp is very bright."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "酸液蚀出一个小口，鳍破了。", "en": "Acid ate a small hole; my fin tore."},
        {"zh": "酸液里，我这三条眼的鱼翻身。", "en": "In the acid, this three-eyed fish rolls over."},
        {"zh": "这一下没打准。", "en": "That didn't land cleanly."},
        {"zh": "酸从伤口往里钻。", "en": "Acid creeps into the wound."},
        {"zh": "我往下沉了半尺。", "en": "I sank half a foot."},
        {"zh": "我的三只眼都花了。", "en": "All three eyes blurred."},
        {"zh": "酸液里，我三只眼都睁着。", "en": "In the acid, all three of my eyes are open."},
        {"zh": "我翻身时撞到池底石。", "en": "I flip and hit the pool floor."},
        {"zh": "水里喊不出声。", "en": "Sound dies in water."},
        {"zh": "我的鳍被酸蚀掉一半。", "en": "Acid has eaten half my fin."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那东西是什么？", "en": "What have you got there?"},
        {"zh": "我不吃那种。", "en": "I don't eat that."},
        {"zh": "那个在水里会化的。", "en": "That'll dissolve in the water."},
        {"zh": "你拿着它在滴。", "en": "It's dripping from your hand."},
        {"zh": "我只吃这水里的东西。", "en": "I only eat what's in this water."},
        {"zh": "拿过来给我看看。", "en": "Bring it so I can see."},
        {"zh": "它一碰到酸就坏了。", "en": "The acid will ruin it."},
        {"zh": "那东西在酸里会冒烟。", "en": "That thing will smoke in the acid."},
        {"zh": "我只啃石头上长的苔。", "en": "I only nibble the moss on the rocks."},
        {"zh": "离水远点，会化。", "en": "Keep it out of the acid."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "酸液里，我有三只眼。", "en": "In the acid, I have three eyes."},
        {"zh": "我身上有层滑的东西。", "en": "I'm covered in something slick."},
        {"zh": "你的手没抓稳。", "en": "You didn't get a grip."},
        {"zh": "水里本来就不好使劲。", "en": "It's hard to push in water."},
        {"zh": "我的鳍擦过你的护目镜。", "en": "My fin grazes your goggles."},
        {"zh": "你的护甲上沾了酸。", "en": "Acid is on your armor."},
        {"zh": "我们撞得没什么力气。", "en": "The impact had little force."},
        {"zh": "我退进了石头后面。", "en": "I retreated behind the stone."},
        {"zh": "你身上有地方在冒泡。", "en": "Something on you is bubbling."},
        {"zh": "我往深的地方去了。", "en": "I went deeper."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们靠游动来判断。", "en": "We go by how we swim."},
        {"zh": "两条鱼绕着彼此。", "en": "Two fish circling each other."},
        {"zh": "气泡升上去，遮住我们。", "en": "Bubbles rise and hide us."},
        {"zh": "我的鳍碰到它的鳍。", "en": "My fin touches its fin."},
        {"zh": "它的眼睛比我多一层膜。", "en": "Its eyes wear an extra film."},
        {"zh": "我们绕了好几圈。", "en": "We circled several times."},
        {"zh": "酸水里我们绕成两个圈。", "en": "In the acid we circle into two rings."},
        {"zh": "水面上冒了很多泡。", "en": "Many bubbles came up."},
        {"zh": "洞里的水变浑了。", "en": "The water clouded."},
        {"zh": "水里只有泡在响。", "en": "Only bubbles made noise."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把东西含住。", "en": "I take it in my mouth."},
        {"zh": "它一进嘴就软了。", "en": "It went soft in my mouth."},
        {"zh": "这块石头太沉。", "en": "This stone is too heavy."},
        {"zh": "它滚进石头缝里去了。", "en": "It rolls into a crevice."},
        {"zh": "它被酸泡化了。", "en": "The acid dissolved it."},
        {"zh": "水底有东西。", "en": "There's something on the bottom."},
        {"zh": "你掉的东西在水里。", "en": "You dropped it in the water."},
        {"zh": "我用嘴拱它，拱不动。", "en": "I nose at it, but it won't move."},
        {"zh": "我把它顶到酸液上面。", "en": "I nudge it above the acid."},
        {"zh": "它落进酸里，冒了泡。", "en": "It sinks into the acid, bubbling."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你现在在水里了。", "en": "You're in the water now."},
        {"zh": "我的三只眼都看见你了。", "en": "All three of my eyes see you."},
        {"zh": "这一片酸液是我的。", "en": "This acid pool is mine."},
        {"zh": "你的皮肤在变。", "en": "Your skin is changing."},
        {"zh": "我没有攻击的力气。", "en": "I've no strength to attack."},
        {"zh": "你现在应该上去。", "en": "You should go up now."},
        {"zh": "水在往你那边流。", "en": "The water is flowing your way."},
        {"zh": "你离池边太远了。", "en": "You're too far from the edge."},
        {"zh": "酸液里的三只眼，慢慢过来。", "en": "Three acid-pool eyes drift slowly over."},
        {"zh": "你身上在掉皮。", "en": "Your skin is peeling."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在你附近。", "en": "I'm always near you."},
        {"zh": "你游到石柱后面了。", "en": "You're behind the pillar."},
        {"zh": "水里全是绿光。", "en": "The water is all green light."},
        {"zh": "我游得慢，却一直游。", "en": "Slow, but always swimming."},
        {"zh": "我在酸液里也不怕。", "en": "Even acid doesn't bother me."},
        {"zh": "我绕了你两圈。", "en": "I circled you twice."},
        {"zh": "你身上在冒泡。", "en": "You're bubbling."},
        {"zh": "水面那边有出口。", "en": "There's an exit up there."},
        {"zh": "我贴着池底换了向。", "en": "I veered along the bottom."},
        {"zh": "你的靴底开始漏了。", "en": "Your boot soles are going."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "尾鳍抽在你小腿上。", "en": "My tail fin slaps your calf."},
        {"zh": "我撞你时，鳞片刮过。", "en": "As I bump you, my scales scrape past."},
