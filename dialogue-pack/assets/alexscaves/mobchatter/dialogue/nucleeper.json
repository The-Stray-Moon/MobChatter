{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上有一圈金属箍。", "en": "A metal band rings my body."},
        {"zh": "我走得慢，可越来越热。", "en": "Slow steps, rising heat."},
        {"zh": "脚下的地有点焦。", "en": "The ground under me scorches."},
        {"zh": "我朝着你走过来。", "en": "I'm coming toward you."},
        {"zh": "一路上的草都枯了。", "en": "The grass dies along my path."},
        {"zh": "我的身体在发烫。", "en": "My body is heating up."},
        {"zh": "我的腿一拐一拐的。", "en": "My legs limp along."},
        {"zh": "倒计时已经开始了。", "en": "The countdown has started."},
        {"zh": "十五秒，不算长。", "en": "Fifteen seconds. Not long."},
        {"zh": "我拖着金属箍往前走。", "en": "I drag my metal bands forward."},
        {"zh": "我一格一格挪过来。", "en": "I edge over, block by block."},
        {"zh": "身后留着一道焦痕。", "en": "A scorch trail behind me."},
        {"zh": "我身上有辐射的光。", "en": "I glow with radiation."},
        {"zh": "我朝那片岩洞走。", "en": "I head into that hollow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，越来越热。", "en": "I stand, hotter and hotter."},
        {"zh": "金属箍在发红。", "en": "The band is going red."},
        {"zh": "有光从我缝里透出来。", "en": "Light leaks from my seams."},
        {"zh": "我在等倒计时。", "en": "I'm waiting out the countdown."},
        {"zh": "这里没有猫。", "en": "No cats around here."},
        {"zh": "我抬起手看了看，倒数还在走。", "en": "I raise a hand and look; the countdown runs on."},
        {"zh": "我的核心在响，十五秒。", "en": "My core is ticking; fifteen seconds."},
        {"zh": "地上一片焦。", "en": "The ground is scorched."},
        {"zh": "除了等，没别的事。", "en": "Nothing but waiting."},
        {"zh": "还剩最后几秒。", "en": "Only seconds left."},
        {"zh": "我慢慢扫了一圈。", "en": "I sweep one slow circle."},
        {"zh": "我的壳里全是火。", "en": "There's fire inside this shell."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看见我身上的东西了？", "en": "See what's on me?"},
        {"zh": "你已经进了范围。", "en": "You are already in range."},
        {"zh": "我身上有不干净的光。", "en": "This light on me isn't clean."},
        {"zh": "你呼吸得很深。", "en": "You're breathing deeply."},
        {"zh": "我的时间是定的。", "en": "My time is fixed."},
        {"zh": "你退后也没多少用了。", "en": "Backing up won't help much."},
        {"zh": "我认得猫的样子。", "en": "I know what a cat looks like."},
        {"zh": "你手里没有猫。", "en": "You're not holding a cat."},
        {"zh": "你脚下那片地会先焦。", "en": "The ground at your feet will scorch first."},
        {"zh": "我在数着秒。", "en": "I'm counting seconds."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "凹口里漏出一线白光。", "en": "A thread of white light leaks from the dent."},
        {"zh": "金属箍响了一声。", "en": "The band rang once."},
        {"zh": "这一下没让我停。", "en": "That didn't stop me."},
        {"zh": "疼这个字对我没意义。", "en": "Pain means little to me."},
        {"zh": "我身上的光晃了。", "en": "My glow wavered."},
        {"zh": "我倒了一下又站住。", "en": "I staggered, then held."},
        {"zh": "你打的是铁。", "en": "You hit iron."},
        {"zh": "地上又多了一块焦。", "en": "Another scorch mark on the ground."},
        {"zh": "我的裂缝更宽了。", "en": "The crack widened."},
        {"zh": "计时还在继续。", "en": "The count keeps running."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "食物会烧掉。", "en": "Food would just burn."},
        {"zh": "那个填不满我。", "en": "That won't fill me."},
        {"zh": "你举着它，我照样数秒。", "en": "Hold it up. I still count."},
        {"zh": "再远一点，太近了。", "en": "Further. Too close."},
        {"zh": "十五秒，倒计时在响。", "en": "Fifteen seconds. The countdown ticks."},
        {"zh": "你有射线猫吗？没有吧。", "en": "Got a Raycat? No."},
        {"zh": "你手里这点东西没用。", "en": "That's useless to you here."},
        {"zh": "把它放下去吧。", "en": "Set it down."},
        {"zh": "我没有鼻子，只数每秒的心跳。", "en": "I have no nose, only the count of each second."},
        {"zh": "别站在我旁边。", "en": "Don't stand beside me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上的是滚烫的壳。", "en": "You hit a scorching shell."},
        {"zh": "我壳上的裂缝张开了。", "en": "The crack in my shell opens wider."},
        {"zh": "十五秒就起爆，别靠太近。", "en": "Fifteen seconds to detonation. Stand back."},
        {"zh": "别挤，我已经很热了。", "en": "Don't crowd me. I'm hot already."},
        {"zh": "你退开的时候袖子焦了。", "en": "Your sleeve scorched as you retreated."},
        {"zh": "我身上有电。", "en": "There's electricity on me."},
        {"zh": "金属碰金属，响了。", "en": "Metal on metal rang out."},
        {"zh": "地上焦了一块。", "en": "A patch of ground scorched."},
        {"zh": "我的倒计时，已经开始了。", "en": "My countdown has started."},
        {"zh": "倒计时没停。", "en": "The countdown didn't pause."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西造我的时候没考虑。", "en": "They didn't plan for this."},
        {"zh": "两个一起就更响了。", "en": "Two of us would be louder."},
        {"zh": "两颗心一起数着秒。", "en": "Two cores count the seconds together."},
        {"zh": "它也发着红。", "en": "It's glowing red too."},
        {"zh": "热量叠在一起。", "en": "The heat doubles."},
        {"zh": "周围的地全焦了。", "en": "The ground all around scorched."},
        {"zh": "我们两个一起就更响了。", "en": "The two of us together make a louder bang."},
        {"zh": "我们的箍还在响。", "en": "The bands are still clicking."},
        {"zh": "这中间没有温度以外的东西。", "en": "There's nothing but temperature in it."},
        {"zh": "我们没说话。", "en": "We said nothing."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的倒计时，别站着等。", "en": "My countdown runs; do not stand and wait."},
        {"zh": "这块铁在我掌心变红。", "en": "This iron turns red in my palm."},
        {"zh": "这块铁变软了。", "en": "This iron has gone soft."},
        {"zh": "我手上的皮在往下掉。", "en": "The skin on my hands is sloughing off."},
        {"zh": "这堆东西我留着。", "en": "I'll keep this pile."},
        {"zh": "烫手的东西，我甩出去。", "en": "Something hot, I fling it away."},
        {"zh": "你掉的东西烫手。", "en": "What you dropped is hot to hold."},
        {"zh": "它开始冒烟。", "en": "It's starting to smoke."},
        {"zh": "我捡得很慢。", "en": "I pick things up slowly."},
        {"zh": "裂变堆里不缺这点料。", "en": "The fission pile has plenty of this."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进我看得到的范围了。", "en": "You're in sight now."},
        {"zh": "箍上的缝一圈圈变红。", "en": "The seams on my bands turn red."},
        {"zh": "这一片只有你。", "en": "Only you in this stretch."},
        {"zh": "我的壳在震。", "en": "My shell is shaking."},
        {"zh": "你退到墙角也没用。", "en": "A corner won't save you."},
        {"zh": "爆的范围很广。", "en": "The blast reaches far."},
        {"zh": "我不追你，我只需要靠近。", "en": "I won't chase. I just need to get close."},
        {"zh": "你听见那个滴答声了吗？", "en": "Hear the ticking?"},
        {"zh": "你的脚已经慢了。", "en": "Your feet have slowed."},
        {"zh": "我壳里的光透出来了。", "en": "The light inside my shell shows through."},
        {"zh": "三十点护甲救不了你。", "en": "Thirty armor won't save you."},
        {"zh": "这一片都会没有。", "en": "All of this will be gone."},
        {"zh": "我在往你那边移。", "en": "I'm shifting your way."},
        {"zh": "你不能让我近身。", "en": "You can't let me get close."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一路朝你那边压。", "en": "I keep pressing your way."},
        {"zh": "你退到岩壁下面了。", "en": "You're under the rock wall."},
        {"zh": "我身上的金属箍越来越烫。", "en": "The metal band on me grows hotter."},
        {"zh": "你在绕圈，我知道。", "en": "You're circling. I know."},
        {"zh": "我身上的热量在升。", "en": "My heat keeps rising."},
        {"zh": "你想找猫？这里没有。", "en": "Looking for a cat? None here."},
        {"zh": "你三次改道都没离开。", "en": "Three turns, none took you away."},
        {"zh": "洞里越来越亮。", "en": "The cave is getting brighter."},
        {"zh": "还有十五秒，够我走近。", "en": "Fifteen seconds is enough to reach you."},
        {"zh": "你一回头，倒计时就响了。", "en": "You look back, and the countdown clicks."},
        {"zh": "石头都被烤红了。", "en": "The stones are glowing red."},
        {"zh": "我的箍已经发白了。", "en": "The band's gone white."},
        {"zh": "你越跑，我炸得越深。", "en": "The deeper you run, the deeper I blast."},
        {"zh": "这条矿道的尽头是岩壁。", "en": "This tunnel ends at a rock face."},
        {"zh": "我听见你喘得很急。", "en": "I hear your fast breathing."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠近就炸。", "en": "I get close, then I go."},
        {"zh": "近身是最快的办法。", "en": "Closing in is the fastest way."},
        {"zh": "这个范围比看着大。", "en": "The radius is bigger than it looks."},
        {"zh": "我把自己炸成一朵蘑菇。", "en": "I blow myself into a mushroom cloud."},
        {"zh": "我的壳裂开了。", "en": "My shell split."},
        {"zh": "光一下全放出来。", "en": "All the light released at once."},
        {"zh": "蘑菇云起来了。", "en": "A mushroom cloud rises."},
        {"zh": "你的护甲熔了。", "en": "Your armor melted."},
        {"zh": "一次就结束。", "en": "One is the end of it."},
        {"zh": "地面整片翻开。", "en": "The whole ground is torn open."},
        {"zh": "连石头都化了一半。", "en": "Even the stone half melted."},
        {"zh": "我就在最中间。", "en": "I'm at the very center."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从毒化洞穴里出来。", "en": "I come out of the toxic caves."},
        {"zh": "身上的箍开始发热。", "en": "The band starts to heat."},
        {"zh": "这一片石头都变了色。", "en": "The stones here are discolored."},
        {"zh": "我一落地地就焦了。", "en": "The ground scorched where I landed."},
        {"zh": "我的壳里全是光。", "en": "My shell is full of light."},
        {"zh": "我开始数秒了。", "en": "I've started counting."},
        {"zh": "周围没有猫。", "en": "No cats around."},
        {"zh": "我从壳里撑起来。", "en": "I lever myself up out of the shell."},
        {"zh": "空气里有焦味。", "en": "There's a burnt smell in the air."},
        {"zh": "壳里的核，开始预热了。", "en": "The core in my shell is warming up."},
        {"zh": "我从辐射尘里立起来。", "en": "I rise out of the fallout dust."},
        {"zh": "这里比上面热。", "en": "It's hotter here than above."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我不算什么，我本来就烫。", "en": "Fire is nothing. I'm already hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时我壳里响了一声。", "en": "My shell rang on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一浇，壳里全是白汽。", "en": "Water hit and steam filled my shell."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "外面的爆把壳撑裂了。", "en": "The blast outside cracked my shell."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进壳里，冒了火星。", "en": "The arrow sparked against my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光干扰了我的计时。", "en": "That light disturbed my count."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不进食，只靠辐射。", "en": "I don't eat. Radiation feeds me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击穿了我的箍。", "en": "The bolt went through my band."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没法爆。", "en": "Nothing to blast in the void."}
      ]
    }
  }
}
