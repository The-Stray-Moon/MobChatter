    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着水烧过来", "en": "Lightning burned through the water."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这地方干得连水都没有", "en": "This place is dry past even water"}
      ]
    }
  }
