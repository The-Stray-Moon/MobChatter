{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里慢慢蠕动", "en": "I undulate slowly through the water."},
        {"zh": "我身上有很多毛", "en": "My body is covered in bristles."},
        {"zh": "我贴着海床爬", "en": "I crawl along the seafloor."},
        {"zh": "我一节一节把身子推向前", "en": "I push myself forward segment by segment"},
        {"zh": "水从我身边流过", "en": "Water flows past me."},
        {"zh": "我朝有微光的地方去", "en": "I head toward faint light."},
        {"zh": "我摆动着往前走", "en": "I swim forward in waves."},
        {"zh": "我的毛在水里散开", "en": "My bristles fan out in the water."},
        {"zh": "我绕过一块沉船木", "en": "I skirt a piece of wreck timber."},
        {"zh": "我在海沟里穿行", "en": "I travel through the trench."},
        {"zh": "我留下的水痕很淡", "en": "My wake is faint."},
        {"zh": "我一点点沉向暗处的海床", "en": "I sink toward the dark sea floor, bit by bit"},
        {"zh": "我一边动一边探", "en": "I feel my way as I move."},
        {"zh": "我从石缝上方滑过", "en": "I glide over a rock seam."},
        {"zh": "我挪得慢，可从不停下", "en": "I move slowly, but I never stop"},
        {"zh": "我朝着水声去", "en": "I head toward the sound of water."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴在海床上", "en": "I press to the seafloor."},
        {"zh": "我的毛在轻轻摆", "en": "My bristles sway gently."},
        {"zh": "我不动的时候像一株草", "en": "Still, I look like a plant."},
        {"zh": "水里的光很暗", "en": "The light here is dim."},
        {"zh": "我没有攻击的意思", "en": "I have no mind to attack."},
        {"zh": "我在等水里的碎屑", "en": "I wait for drifting scraps."},
        {"zh": "我身上的毛一下全收了", "en": "All my bristles draw in at once"},
        {"zh": "我的节在慢慢搏动", "en": "My segments pulse slowly."},
        {"zh": "我把自己埋进沙里一半", "en": "I am half-buried in sand."},
        {"zh": "我听着远处的动静", "en": "I listen to distant movement."},
        {"zh": "我缓缓转动前端", "en": "I turn my front end slowly."},
        {"zh": "我的身体很长", "en": "My body is long."},
        {"zh": "我这一身全是软肉", "en": "I am all soft tissue."},
        {"zh": "我贴着一块温的石头", "en": "I rest against a warm stone."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你游得离我很近", "en": "You swim very close."},
        {"zh": "我往沙里缩了缩", "en": "I shrank toward the sand."},
        {"zh": "你比沉船兽小得多", "en": "You are far smaller than a hullbreaker."},
        {"zh": "我的眼睛很小", "en": "My eyes are very small."},
        {"zh": "我不打算伤谁", "en": "I intend no harm to anyone."},
        {"zh": "你身上带着光", "en": "You are carrying light."},
        {"zh": "我把前端抬起来", "en": "I lift my front end."},
        {"zh": "你别来拉扯我", "en": "Do not pull at me."},
        {"zh": "我的毛会粘在你手上", "en": "My bristles will cling to your hand."},
        {"zh": "你继续游过去吧", "en": "Swim on past, then."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我蜷得紧紧的", "en": "I curl up tight."},
        {"zh": "我的毛断了几根", "en": "A few bristles broke."},
        {"zh": "我往沙里钻进去", "en": "I burrow down into the sand."},
        {"zh": "我不叫，水里传不出", "en": "I cannot cry; water carries nothing."},
        {"zh": "这一下让我瘪了", "en": "That left me deflated."},
        {"zh": "我一点点舒展开", "en": "I open out little by little."},
        {"zh": "我还没被压烂", "en": "I have not been crushed yet."},
        {"zh": "这一下扎在节缝上", "en": "That landed in a segment seam."},
        {"zh": "我的节在抽动", "en": "My segments are twitching."},
        {"zh": "我记着这处石头", "en": "I will remember this stone."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西我咽不下", "en": "I cannot swallow that."},
        {"zh": "水里的碎屑才是我的", "en": "Drifting scraps are mine."},
        {"zh": "你把东西撒下来试试", "en": "Try scattering it down."},
        {"zh": "它沉得相当快", "en": "It sinks quite quickly."},
        {"zh": "我在等它沉到底", "en": "I wait for it to settle."},
        {"zh": "这玩意儿硌得我毛都竖了", "en": "This thing makes my bristles stand up"},
        {"zh": "我先尝尝这水", "en": "Let me taste the water first."},
        {"zh": "你的手停着别动", "en": "Leave your hand where it is."},
        {"zh": "我只会把水弄浑", "en": "I would only cloud the water."},
        {"zh": "你收进背包里吧", "en": "Put it in your backpack."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的身体了", "en": "You hit my body."},
        {"zh": "我软软地让开", "en": "I yield softly."},
        {"zh": "我的毛粘到你", "en": "My bristles stuck to you."},
        {"zh": "这一下几乎没伤到谁", "en": "That barely hurt anyone."},
        {"zh": "我们撞得很慢", "en": "We met very slowly."},
        {"zh": "我把身子蜷紧了", "en": "I pulled my body in tight."},
        {"zh": "你的手穿过了我", "en": "Your hand passed through me."},
        {"zh": "我缩进岩缝里", "en": "I withdrew into a rock crevice."},
        {"zh": "水被搅起了沙", "en": "Sand swirled up."},
        {"zh": "别挤着我游过去", "en": "Do not swim pressed against me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这样的一辈子都在水里", "en": "My kind spend their whole lives in water."},
        {"zh": "这种事要等水暖", "en": "That waits for warm water."},
        {"zh": "我在海床上，不谈这个", "en": "I am on the seafloor; not this."},
        {"zh": "我的身体不是给谁碰的", "en": "My body is not for touching."},
        {"zh": "你问得让我缩起来", "en": "That question makes me curl."},
        {"zh": "我只想安静地漂", "en": "I only want to drift quietly."},
        {"zh": "我把自己卷成一团毛球", "en": "I curl into a ball of bristles"},
        {"zh": "别过来打扰我", "en": "Do not come and disturb me."},
        {"zh": "你从这儿游开", "en": "Swim away from here."},
        {"zh": "我没有那种需求", "en": "I have no such need."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用毛抓住它", "en": "I catch it in my bristles."},
        {"zh": "它滑得抓不住", "en": "It is too slippery to hold."},
        {"zh": "我把它裹起来", "en": "I wrap it up."},
        {"zh": "它慢慢陷进我的身体", "en": "It slowly sinks into my body."},
        {"zh": "我把它们裹住了", "en": "I have wrapped it up."},
        {"zh": "我用毛把它托起来递给你", "en": "I lift it on my bristles and offer it"},
        {"zh": "这东西不属于海床", "en": "This does not belong on the seafloor."},
        {"zh": "我根本举不起来", "en": "I cannot lift it at all."},
        {"zh": "你游下来拿吧", "en": "Swim down and take it."},
        {"zh": "我就留在原处", "en": "I will leave it where it is."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水流忽然变了", "en": "The current suddenly changed."},
        {"zh": "我往那股水痕去", "en": "I go for that wake."},
        {"zh": "不是你，是那块东西", "en": "Not you; that thing."},
        {"zh": "我只要海床上的东西", "en": "I only want what lies on the seafloor."},
        {"zh": "我开始移动了", "en": "I have begun moving."},
        {"zh": "这具身体不喜欢快", "en": "This body dislikes speed."},
        {"zh": "我贴着海床靠过去", "en": "I hug the seafloor and close in."},
        {"zh": "那个味道很新鲜", "en": "That scent is fresh."},
        {"zh": "我锁定了那块沉下去的东西", "en": "I fixed on that sunken thing."},
        {"zh": "我慢慢挪过去了", "en": "I am drifting over slowly."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着海床爬", "en": "I crawl along the seafloor."},
        {"zh": "水流把它带走了", "en": "The current took it away."},
        {"zh": "我跟在那道水痕后", "en": "I follow the wake."},
        {"zh": "这里的沙很软", "en": "The sand here is soft."},
        {"zh": "我绕过那块沉木", "en": "I go around the wreck timber."},
        {"zh": "它落进了石缝", "en": "It fell into a seam."},
        {"zh": "我伸出前端去探", "en": "I extend my front to feel."},
        {"zh": "我很慢，但我总会到", "en": "Slow, but I always arrive."},
        {"zh": "石头压住了它", "en": "A stone pins it."},
        {"zh": "我把它推出来", "en": "I push it out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个缠上去", "en": "I wrap myself right around you."},
        {"zh": "这一下只是碰", "en": "This is only a touch."},
        {"zh": "我的毛刺了你", "en": "My bristles prick you."},
        {"zh": "我缠得并不紧", "en": "I did not wrap tightly."},
        {"zh": "你被缠了一下", "en": "You were wrapped for a moment."},
        {"zh": "我缩回身子里", "en": "I drew myself back in."},
        {"zh": "我的身体没有骨头", "en": "My body has no bones."},
        {"zh": "这顶多算缠了一下", "en": "That was barely a wrap."},
        {"zh": "我掉在沙上了", "en": "I dropped onto the sand."},
        {"zh": "我继续往下沉", "en": "I sink on down."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从海床上抬起前端", "en": "I lift my front off the seafloor."},
        {"zh": "水底多了一条影子", "en": "A long shadow joins the bottom."},
        {"zh": "我本来就在这片海沟里", "en": "I was in this trench already."},
        {"zh": "我的毛先在水里散开", "en": "My bristles fanned out first."},
        {"zh": "水流把我推来了", "en": "The current brought me."},
        {"zh": "我慢慢从沙里出来", "en": "I ease out of the sand."},
        {"zh": "我的身体探出石缝", "en": "My body slides from a seam."},
        {"zh": "这里的光很暗", "en": "The light here is dim."},
        {"zh": "我朝你的灯光去", "en": "I head toward your lamp."},
        {"zh": "你看不出哪是头", "en": "You cannot tell which end is my head."}
      ]
    },
