{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你走过来，很慢", "en": "I walk toward you, slowly."},
        {"zh": "我的脚步比你慢半拍", "en": "My step lags half a beat behind yours."},
        {"zh": "我走过的地方没有痕迹", "en": "I leave no trace where I pass."},
        {"zh": "我沿着你的路走", "en": "I walk the way you came."},
        {"zh": "我不绕开任何东西", "en": "I don't go around anything."},
        {"zh": "我穿过那棵树继续走", "en": "I pass through that tree and keep walking."},
        {"zh": "我的影子比你淡", "en": "My shadow is fainter than yours."},
        {"zh": "我走得不快，但一直走", "en": "I'm not fast, but I never stop."},
        {"zh": "你一停，我就停", "en": "When you stop, I stop."},
        {"zh": "我又往你那边挪一寸。", "en": "I slide an inch closer to you."},
        {"zh": "我从你刚才站的地方走过", "en": "I walk through where you just stood."},
        {"zh": "我朝你的方向来", "en": "I'm coming your way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在几步之外。", "en": "I stand a few steps away."},
        {"zh": "你移开视线，我还在", "en": "You look away; I'm still here."},
        {"zh": "我没有表情，也没有动作", "en": "I have no expression and no movement."},
        {"zh": "我身上的轮廓不太清", "en": "My outline is not quite clear."},
        {"zh": "你看见的可能是假的", "en": "What you see might be false."},
        {"zh": "我把头转向你这边", "en": "I turn my head your way."},
        {"zh": "我不打算说话", "en": "I don't intend to speak."},
        {"zh": "你数着我在不在", "en": "You keep checking whether I'm there."},
        {"zh": "我一直在那个位置", "en": "I've been in that spot all along."},
        {"zh": "你听见自己的脚步回音", "en": "You hear the echo of your own steps."},
        {"zh": "我没有呼吸，也不用。", "en": "I have no breath to need."},
        {"zh": "我慢慢举起一只手", "en": "I raise one hand, slowly."},
        {"zh": "举到一半就停了", "en": "It stops halfway up."},
        {"zh": "我看着你，不动", "en": "I watch you without moving."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看我的时候，我就在。", "en": "When you look at me, I am there."},
        {"zh": "我抬起头，和你对上", "en": "I raise my head and meet your eyes."},
        {"zh": "你确定这是第一次见我吗", "en": "Are you sure this is our first meeting?"},
        {"zh": "我记得你走来的方向", "en": "I remember which way you came."},
        {"zh": "你的影子在我旁边", "en": "Your shadow is beside me."},
        {"zh": "我的手在抬高一点", "en": "My hand rises a little more."},
        {"zh": "你为什么不说话", "en": "Why don't you speak?"},
        {"zh": "我也不会开口说话", "en": "I won't either."},
        {"zh": "我们站着，谁也不动", "en": "We stand, neither of us moving."},
        {"zh": "是你先眨的眼睛", "en": "You blinked first."},
        {"zh": "你觉得我像什么", "en": "What do you think I am?"},
        {"zh": "你已经在想答案了", "en": "You're already forming an answer."},
        {"zh": "那个答案不对", "en": "That answer is wrong."},
        {"zh": "你能看见我的脚吗", "en": "Can you see my feet?"},
        {"zh": "我也没有看你的", "en": "I haven't looked at yours either."},
        {"zh": "我们之间隔着几格", "en": "A few blocks lie between us."},
        {"zh": "这个距离在变短", "en": "The distance is getting shorter."},
        {"zh": "不是我走过去的", "en": "I'm not the one who moved."},
        {"zh": "你低头看了看脚下", "en": "You looked down at your feet."},
        {"zh": "现在把头抬起来看我。", "en": "Now raise your head and look at me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中的只是空气。", "en": "You struck only air."},
        {"zh": "我没有动，也没有躲", "en": "I didn't move, and didn't dodge."},
        {"zh": "我没有受伤这回事", "en": "Being wounded isn't a thing for me."},
        {"zh": "我看着你打完这一下", "en": "I watched you finish that swing."},
        {"zh": "然后你还站在原地", "en": "And you're still standing here."},
        {"zh": "我连影子都没有留给你。", "en": "I didn't even leave you a shadow."},
        {"zh": "这一点改变不算什么", "en": "That small change means nothing."},
        {"zh": "你越来越不确定", "en": "You grow less and less certain."},
        {"zh": "我只是换了个位置", "en": "I only changed position."},
        {"zh": "现在我在你另一边", "en": "Now I'm on your other side."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你拿这个做什么", "en": "What are you doing with that?"},
        {"zh": "我不需要你给的东西", "en": "I don't need anything you give."},
        {"zh": "我连看都没看", "en": "I haven't even looked at it."},
        {"zh": "你把东西举得太高了", "en": "You're holding it too high."},
        {"zh": "我靠近了半步", "en": "I've come half a step nearer."},
        {"zh": "这不算被吸引", "en": "This isn't being drawn in."},
        {"zh": "我只是往前走", "en": "I'm only walking forward."},
        {"zh": "你退开的时候很急", "en": "You backed away quickly."},
        {"zh": "这让我更好奇了", "en": "That only makes me more curious."},
        {"zh": "你把它留着吧", "en": "Keep it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你从我身上走了过去", "en": "You walked right through me."},
        {"zh": "你没有感觉到什么", "en": "You didn't feel a thing."},
        {"zh": "我却退了一步", "en": "Yet I stepped back."},
        {"zh": "我的手几乎碰到你", "en": "My hand almost touched you."},
        {"zh": "只差那么一点", "en": "Only a little short."},
        {"zh": "碰撞之后，你转身了", "en": "After the contact, you turned."},
        {"zh": "我站在那里没有动", "en": "I stood there without moving."},
        {"zh": "你的呼吸很乱", "en": "Your breathing is ragged."},
        {"zh": "这么近，我还是看不清", "en": "This close, I'm still unclear."},
        {"zh": "你开始后退了", "en": "You've started retreating."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你要我留下来吗", "en": "Do you want me to stay?"},
        {"zh": "我一直都在这里", "en": "I've been here all along."},
        {"zh": "你不用害怕我", "en": "You needn't fear me."},
        {"zh": "我也不怕你什么", "en": "And I don't fear you."},
        {"zh": "我们可以站久一点", "en": "We could stand here longer."},
        {"zh": "时间对你我不同", "en": "Time runs differently for us."},
        {"zh": "你走了，我还站着", "en": "If you go, I'll still be standing."},
        {"zh": "我会一直站在这里", "en": "I'll stand here the whole time."},
        {"zh": "这其实不算等待", "en": "This isn't waiting."},
        {"zh": "这只是我本来的样子", "en": "It's simply what I am."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰去捡，没够到", "en": "I bend for it and miss."},
        {"zh": "我的手穿过了它", "en": "My hand passes through it."},
        {"zh": "东西还在原处", "en": "It's still where it was."},
        {"zh": "我看了很久，没有碰", "en": "I look a long while and don't touch."},
        {"zh": "你捡吧，我不争", "en": "Pick it up. I won't contest it."},
        {"zh": "它在你那边，我在这边", "en": "It's on your side; I'm on mine."},
        {"zh": "这东西不是我的。", "en": "This thing is not mine."},
        {"zh": "我碰不到任何实物", "en": "I can't touch anything solid."},
        {"zh": "除了碰到你以外", "en": "Except you."},
        {"zh": "那也只是一瞬间", "en": "And only for an instant."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于停下来了", "en": "You've stopped."},
        {"zh": "我也跟着停下来", "en": "I stop as well."},
        {"zh": "这里的路只有一条", "en": "There's only one path here."},
        {"zh": "你回头看了三次", "en": "You've looked back three times."},
        {"zh": "每一次我都在场", "en": "I was there each time."},
        {"zh": "你开始加快脚步", "en": "You've quickened your pace."},
        {"zh": "我不会去追你", "en": "I won't chase."},
        {"zh": "我会在你前面", "en": "I'll be ahead of you."},
        {"zh": "这里的岔路是我选的", "en": "I chose the fork you took."},
        {"zh": "你听见后面有声音", "en": "You hear something behind you."},
        {"zh": "刚才那个不是我", "en": "That isn't me."},
        {"zh": "我在你的前面", "en": "I'm in front."},
        {"zh": "你转过这个弯就会看到", "en": "Round this bend and you'll see."},
        {"zh": "我一直站在这里", "en": "I've stood here all along."},
        {"zh": "我在这里等很久了", "en": "I've waited a long time."},
        {"zh": "现在你终于到了", "en": "Now you've arrived."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们之间只差两步。", "en": "Only two steps remain between us."},
        {"zh": "你并没有在走路", "en": "You aren't walking."},
        {"zh": "那是我在靠近", "en": "It's I who am closing in."},
        {"zh": "你手里的东西，握得太紧。", "en": "You're gripping that too tightly."},
        {"zh": "那个挡不住我", "en": "That won't stop me."},
        {"zh": "我并没有恶意", "en": "I mean no harm."},
        {"zh": "我也没有善意", "en": "I mean no good either."},
        {"zh": "我只是要靠近", "en": "I only want to come near."},
        {"zh": "你别睁眼，我真不在这儿。", "en": "Keep your eyes shut. I'm truly not here."},
        {"zh": "幻影只有一个，就是你面前。", "en": "There's one hallucination: the one before you."},
        {"zh": "树后面什么都没有", "en": "There's nothing behind the trees."},
        {"zh": "你不必看那边", "en": "You needn't look that way."},
        {"zh": "你需要看着我", "en": "Look at me."},
        {"zh": "我只有一点血，可你看不清我。", "en": "One point of health, and you can't see me right."},
        {"zh": "这样就很对了", "en": "That's right."},
        {"zh": "再多站一会儿", "en": "Stand a moment longer."},
        {"zh": "我马上就要到了", "en": "I'm nearly there."},
        {"zh": "你千万不要动", "en": "Don't move."},
        {"zh": "就保持现在这样", "en": "Just like this."},
        {"zh": "现在，闭上眼睛", "en": "Now. Close your eyes."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手碰了你一下", "en": "I reach out and touch you once."},
        {"zh": "很轻，你几乎没察觉", "en": "Very lightly; you barely noticed."},
        {"zh": "你打了个寒颤", "en": "You shiver."},
        {"zh": "我的手缩回去了", "en": "My hand withdraws."},
        {"zh": "你摸了摸那个位置", "en": "You touch the spot."},
        {"zh": "什么也不会留下", "en": "There's nothing there."},
        {"zh": "可你已经开始发抖", "en": "Yet you're already shaking."},
        {"zh": "我没有用多少力气", "en": "I used very little strength."},
        {"zh": "我碰过的膝盖，还在发软。", "en": "The knee I touched is still weak."},
        {"zh": "我还在你旁边", "en": "I'm still beside you."},
        {"zh": "你的脸一下子白了。", "en": "Your face has gone white."},
        {"zh": "你开始怀疑自己", "en": "You've begun to doubt yourself."},
        {"zh": "这就是我的全部", "en": "That's all of it."},
        {"zh": "我没有别的招数", "en": "I have no other tricks."},
        {"zh": "我只有一点生命，所以你才看得见我。", "en": "One health; that's why you can see me."},
        {"zh": "很好，那就继续", "en": "Good. Then let's continue."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我出现在你的余光里", "en": "I appear in the corner of your eye."},
        {"zh": "你转过去时，那里是空的", "en": "When you turn, it's empty."},
        {"zh": "我真的在那里过吗", "en": "Was I ever really there?"},
        {"zh": "你听见了一声脚步", "en": "You heard one footstep."},
        {"zh": "那是我停下的声音", "en": "That was me coming to a stop."},
        {"zh": "我不记得自己怎么出现。", "en": "I do not recall how I appeared."},
        {"zh": "这里的光让我显出形状", "en": "The light here gives me shape."},
        {"zh": "我站定了，看着你", "en": "I settle and watch you."},
        {"zh": "你还没有发现", "en": "You haven't noticed yet."},
        {"zh": "你数到十就会看到", "en": "Count to ten and you'll see."},
        {"zh": "我已经数到第八下了", "en": "Eight."},
        {"zh": "现在数字到了九", "en": "Nine."},
        {"zh": "现在数到了十", "en": "Ten."},
        {"zh": "你总算抬起头来了。", "en": "You finally looked up."},
        {"zh": "我一直就在那里", "en": "I was there."},
        {"zh": "从来都没有离开", "en": "All along."},
        {"zh": "你的手开始发抖", "en": "Your hands begin to shake."},
        {"zh": "这其实很正常", "en": "That's only natural."},
        {"zh": "你一眨眼，我就换个位置。", "en": "Blink, and I'm somewhere else."},
        {"zh": "把它看得更清楚些", "en": "Take a clearer look."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光照着我，我不烫", "en": "Firelight falls on me; I'm not hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有往下掉", "en": "I didn't fall."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水在我周围停住了", "en": "The water stops around me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "烟散了，我还在这里", "en": "The smoke clears, and I'm still here."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过我，落在地上", "en": "The arrow passes through and falls."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这道术光没有照见我", "en": "This magic's light didn't find me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有身体要喂养", "en": "I've no body to feed."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光里，你看见我笑了", "en": "In the lightning you see me smile."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里，我离你更近", "en": "In the void, I'm closer to you."}
      ]
    }
  }
}
