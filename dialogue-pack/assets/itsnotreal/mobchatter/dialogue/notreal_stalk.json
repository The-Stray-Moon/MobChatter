{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我不走，我只是在别处", "en": "I don't walk. I'm simply elsewhere."},
        {"zh": "你回头时，我近了半格", "en": "When you look back, I'm half a block closer."},
        {"zh": "距离对我来说没有意义", "en": "Distance means nothing to me."},
        {"zh": "我在你的余光里移动", "en": "I move in the corner of your eye."},
        {"zh": "你往前走，我就在后面", "en": "You walk on; I am behind."},
        {"zh": "我从不发出脚步声", "en": "I never make a footstep."},
        {"zh": "树影挪了位置，是我", "en": "The tree's shadow shifted. That was me."},
        {"zh": "我沿着你的路线跟着", "en": "I follow along your route."},
        {"zh": "我不动，可我一直跟着。", "en": "I do not move, yet I follow."},
        {"zh": "这片林子里我无处不在", "en": "I am everywhere in this wood."},
        {"zh": "我一点一点地靠近", "en": "I come closer, a little at a time."},
        {"zh": "你不会看见我怎么动", "en": "You'll never see how I move."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立在那里，很久了", "en": "I've stood there a long while."},
        {"zh": "我没有呼吸，也没有影子", "en": "I have no breath, and no shadow."},
        {"zh": "你数不清我出现了几次", "en": "You can't count how often I've appeared."},
        {"zh": "我不动，但你在移动", "en": "I stay still, but you are moving."},
        {"zh": "我记得你每一次回头", "en": "I remember every time you looked back."},
        {"zh": "这具身体一直站在这里", "en": "This body has always stood here."},
        {"zh": "我等你再往前走一步", "en": "I wait for you to take one more step."},
        {"zh": "空气在我周围变重了", "en": "The air grows heavy around me."},
        {"zh": "我没有恶意，也没有善意", "en": "I mean no harm, and no good."},
        {"zh": "你听见的声音不是我", "en": "The sound you heard wasn't me."},
        {"zh": "我不需要理解你在做什么", "en": "I needn't understand what you're doing."},
        {"zh": "你看树，我就在树的方向", "en": "Look at the trees; I'll be that way."},
        {"zh": "我一直在原处", "en": "I have been in the same place all along."},
        {"zh": "你会开始怀疑自己", "en": "You'll begin to doubt yourself."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你总算正眼看我了。", "en": "You finally looked at me straight."},
        {"zh": "别把视线移开", "en": "Don't look away."},
        {"zh": "我的名字，写不出来", "en": "My name can't be written."},
        {"zh": "你把我记成什么样了", "en": "What did you take me for?"},
        {"zh": "我一直在这儿，只是你没看", "en": "I've been here all along. You just didn't look."},
        {"zh": "你的呼吸浅得像没有。", "en": "Your breathing has grown shallow."},
        {"zh": "我们可以这样站着", "en": "We can stand like this."},
        {"zh": "你手心的汗我看见了", "en": "I see the sweat on your palms."},
        {"zh": "再多看我一会", "en": "Look a little longer."},
        {"zh": "我不是你想象的东西", "en": "I'm not what you imagine."},
        {"zh": "你在算要跑几步", "en": "You're counting how many steps to run."},
        {"zh": "那样也没有用", "en": "That won't help."},
        {"zh": "我从来不眨眼睛", "en": "I never blink."},
        {"zh": "你的影子还在，我的不在", "en": "Your shadow is still there. Mine isn't."},
        {"zh": "你已经开始怀疑了", "en": "You're already doubting."},
        {"zh": "这就是我想要的", "en": "That's what I wanted."},
        {"zh": "别把眼睛闭上", "en": "Don't shut your eyes."},
        {"zh": "你闭上眼，我也在", "en": "Close them, and I'm still here."},
        {"zh": "你会记得这一刻的", "en": "You'll remember this moment."},
        {"zh": "现在，别把眼闭上。", "en": "Now, do not close your eyes."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中的是空气", "en": "You struck empty air."},
        {"zh": "我没有地方可以受伤", "en": "I've nowhere to be wounded."},
        {"zh": "你的武器没有碰到我", "en": "Your weapon touched nothing."},
        {"zh": "我退了一步，仍在原处", "en": "I stepped back and stayed put."},
        {"zh": "你听见的声音并不是我", "en": "The sound you heard wasn't me."},
        {"zh": "这一点都不影响我", "en": "This doesn't affect me."},
        {"zh": "我看起来像受伤了吗", "en": "Do I look wounded?"},
        {"zh": "你在对着影子挥砍", "en": "You're swinging at a shadow."},
        {"zh": "我一直站着没动", "en": "I've stood without moving."},
        {"zh": "你开始怀疑了", "en": "You're beginning to doubt."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那些食物对我没用。", "en": "That food means nothing to me."},
        {"zh": "你举着它，像在驱赶什么", "en": "You hold it up as if to ward me off."},
        {"zh": "那对我毫无意义", "en": "That means nothing to me."},
        {"zh": "我只看你，不看它", "en": "I watch you, not it."},
        {"zh": "你伸手的时候，我近了", "en": "While you reached out, I came closer."},
        {"zh": "这不能让我走开", "en": "This won't make me leave."},
        {"zh": "你把东西收起来吧", "en": "Put it away."},
        {"zh": "我不需要任何东西", "en": "I need nothing at all."},
        {"zh": "你留着它，会更安心", "en": "Keep it. You'll feel safer."},
        {"zh": "它挡不住我什么", "en": "It won't stop me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你穿过了我站着的地方", "en": "You passed through where I stood."},
        {"zh": "我并没有身体让你撞", "en": "I have no body for you to hit."},
        {"zh": "你的肩膀是空的", "en": "Your shoulder met nothing."},
        {"zh": "你退开时，我还在原处", "en": "When you stepped back, I hadn't moved."},
        {"zh": "碰撞对我没有意义", "en": "Collision means nothing to me."},
        {"zh": "你摸到的只是冷空气", "en": "All you touched was cold air."},
        {"zh": "我又出现在另一边", "en": "I'm on the other side now."},
        {"zh": "你撞到的，是你自己", "en": "What you hit was yourself."},
        {"zh": "我让开了一步", "en": "I gave way one step."},
        {"zh": "你开始怀疑眼睛了", "en": "You're starting to doubt your eyes."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这种东西，没有伴", "en": "A thing like me has no companion."},
        {"zh": "你要跟我站在一起吗", "en": "Will you stand with me?"},
        {"zh": "你站久了，就会变成我", "en": "Stand long enough and you'll become me."},
        {"zh": "我不需要陪伴", "en": "I need no company."},
        {"zh": "我不记得有谁留下过", "en": "I don't recall anyone staying."},
        {"zh": "你站在哪，我记住了。", "en": "I remember exactly where you stood."},
        {"zh": "不要离我太近了", "en": "Don't come too close."},
        {"zh": "我只会一直看着", "en": "I only ever watch."},
        {"zh": "你若离开，我也不会追", "en": "If you leave, I won't follow."},
        {"zh": "我不会追，你也会回来", "en": "I won't follow. You'll come back."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "捡东西？我连地都碰不到。", "en": "Pick it up? I can't even touch the floor."},
        {"zh": "它穿过我的手落地", "en": "It passes through my hand and falls."},
        {"zh": "这个位置我记住了", "en": "I've noted where it lies."},
        {"zh": "我不需要这个东西", "en": "I don't need it."},
        {"zh": "你捡吧，我不抢", "en": "Pick it up. I won't take it."},
        {"zh": "它在地上会一直在", "en": "It will stay on the ground."},
        {"zh": "我碰不到任何东西", "en": "I can't touch anything."},
        {"zh": "你捡起来时，我离得更近", "en": "As you picked it up, I came nearer."},
        {"zh": "这些对我没有用", "en": "These are of no use to me."},
        {"zh": "留在原地就好", "en": "Leave it where it is."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就在看着你了", "en": "I've been watching you all along."},
        {"zh": "你走到这一步，正好", "en": "This is exactly where I wanted you."},
        {"zh": "附近没有别人了", "en": "There's no one else nearby."},
        {"zh": "这片林子开始安静", "en": "The wood is going quiet."},
        {"zh": "我数过你的步子", "en": "I've counted your steps."},
        {"zh": "你回头，我就换个地方", "en": "You look back; I move elsewhere."},
        {"zh": "我就在你刚才站的位置", "en": "I'm where you were just standing."},
        {"zh": "你听不见我走近的。", "en": "You will not hear me come closer."},
        {"zh": "天暗得刚刚好", "en": "The light is failing just right."},
        {"zh": "我站着不挪，眼睛不眨。", "en": "I stand without moving. I do not blink."},
        {"zh": "我开始向你靠近", "en": "I begin to close in."},
        {"zh": "你根本不用跑", "en": "You needn't run."},
        {"zh": "你跑也没有用", "en": "Running won't help."},
        {"zh": "我看着你，一直看着", "en": "I watch you. Always watching."},
        {"zh": "再走几步就到了", "en": "A few more steps."},
        {"zh": "你已经属于这里", "en": "You already belong here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你身后三格", "en": "I'm three blocks behind you."},
        {"zh": "你转身，那里什么都没有", "en": "You turn, and there's nothing."},
        {"zh": "我在树上，不在树下", "en": "I'm in the tree, not under it."},
        {"zh": "你的脚步越来越快", "en": "Your pace keeps quickening."},
        {"zh": "不用看，我还在", "en": "No need to look. I'm still here."},
        {"zh": "我已经在你前面了", "en": "I'm ahead of you now."},
        {"zh": "这条路只有一头", "en": "This path has only one end."},
        {"zh": "你的火苗抖得厉害。", "en": "Your flame is trembling badly."},
        {"zh": "我不会一次靠近太多", "en": "I won't come too close at once."},
        {"zh": "慢慢来，才够久", "en": "Slow, so it lasts longer."},
        {"zh": "你听见的树叶声是我", "en": "The leaves you hear are me."},
        {"zh": "你数到十，我就在那里", "en": "Count to ten, and I'll be there."},
        {"zh": "我一直保持着这个距离", "en": "I keep exactly this distance."},
        {"zh": "你的手已经不稳了", "en": "Your hands aren't steady now."},
        {"zh": "这片林子没有出口", "en": "There's no way out of this wood."},
        {"zh": "你走的方向我选好了", "en": "I've chosen the way you'll go."},
        {"zh": "我从不发出声音", "en": "I never make a sound."},
        {"zh": "你已无处可去", "en": "You've nowhere left to go."},
        {"zh": "我就在这一步之外", "en": "I'm just beyond this step."},
        {"zh": "就是现在，来了", "en": "Now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我根本没有碰你", "en": "I didn't touch you."},
        {"zh": "你的伤，不是从我来的", "en": "Your wound didn't come from me."},
        {"zh": "我站着，你就倒下了。", "en": "I stood still and you fell."},
        {"zh": "你转身太快，自己撞了", "en": "You turned too fast and hit something."},
        {"zh": "空气变冷了，仅此而已", "en": "The air turned cold. That's all."},
        {"zh": "你听见的呼吸是自己的", "en": "The breathing you hear is your own."},
        {"zh": "我从不先动手", "en": "I never strike first."},
        {"zh": "你开始抓不到重心", "en": "You're losing your balance."},
        {"zh": "血迹在你身后", "en": "The blood trail is behind you."},
        {"zh": "你回头了三次", "en": "You looked back three times."},
        {"zh": "到这里就已经够了。", "en": "This is far enough already."},
        {"zh": "你还没有想明白", "en": "You still don't understand."},
        {"zh": "我一直没动过", "en": "I never moved at all."},
        {"zh": "是你自己在往前走", "en": "You're the one who kept walking."},
        {"zh": "别再往后面看了", "en": "Stop looking behind you."},
        {"zh": "看着你的前面", "en": "Look ahead."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我不记得自己何时出现", "en": "I don't recall when I appeared."},
        {"zh": "你只是终于看见了我", "en": "You merely saw me at last."},
        {"zh": "我从来都在这里", "en": "I have always been here."},
        {"zh": "树影里多了个轮廓", "en": "A shape has joined the tree shadows."},
        {"zh": "空气先变冷了", "en": "The air turned cold first."},
        {"zh": "我没有踏出任何一步", "en": "I didn't take a single step."},
        {"zh": "你的火把暗了一下", "en": "Your torch dimmed once."},
        {"zh": "这地方的鸟不叫了", "en": "The birds here have gone silent."},
        {"zh": "我站在你刚才看过的地方", "en": "I'm where you just looked."},
        {"zh": "你不该来这片林子", "en": "You shouldn't have come to this wood."},
        {"zh": "我记得你进门的样子", "en": "I remember how you entered."},
        {"zh": "现在，我们开始了", "en": "Now, we begin."},
        {"zh": "你不要开口去喊", "en": "Don't shout."},
        {"zh": "没有人会到这里来", "en": "No one will come."},
        {"zh": "我出生就不必做什么。", "en": "I was made to do nothing."},
        {"zh": "你已经在我的范围里", "en": "You're already within my reach."},
        {"zh": "你回头的那一刻", "en": "The moment you look back."},
        {"zh": "我会在那儿等着你", "en": "I will be there."},
        {"zh": "就保持这样吧", "en": "Just like this."},
        {"zh": "就一直这样看着我", "en": "Keep watching me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光照出我的轮廓", "en": "The firelight shows my outline."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有高处可以掉下来", "en": "There's no height here to fall from."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水在我脚下散开了", "en": "The water parts at my feet."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "烟散开了，我还在", "en": "The smoke clears, and I'm still here."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过去，钉在树上", "en": "The arrow passes through and sticks in a tree."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这道术光没照出我", "en": "This spell's light doesn't reveal me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿这种事，我不懂。", "en": "Hunger is not something I understand."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷照亮了整片林子", "en": "Lightning lights up the whole wood."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我也在往下坠，很平静", "en": "I'm falling too, quite calmly."}
      ]
    }
  }
}
