{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "一步，一段虚空。", "en": "One step, one stretch of void."},
        {"zh": "这条路没有尽头。", "en": "This road has no end."},
        {"zh": "地面太吵，我踮起脚。", "en": "The ground is loud; I tiptoe."},
        {"zh": "脚步声？那是你的。", "en": "Footsteps? Those are yours."},
        {"zh": "别回头，我只是在散步。", "en": "Don't look back. I'm only strolling."},
        {"zh": "紫尘一路跟着我。", "en": "Purple dust trails behind me."},
        {"zh": "走路是多余的仪式。", "en": "Walking is a needless ritual."},
        {"zh": "脚印？我从不留下。", "en": "Footprints? I never leave any."},
        {"zh": "我只是路过你的世界。", "en": "I'm only passing through your world."},
        {"zh": "我数到七就换个地方。", "en": "I count to seven, then move."},
        {"zh": "风里有嗡鸣的回声。", "en": "The wind carries echoes of hum."},
        {"zh": "这条路我闭眼也认得。", "en": "I know this road blind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "末地的风里，从来没有人来。", "en": "No one ever comes on the End's wind."},
        {"zh": "呼吸不必，只是习惯。", "en": "Breathing is unnecessary, merely habit."},
        {"zh": "这里不像末地。", "en": "This is not like the End."},
        {"zh": "什么都不做，最难。", "en": "Doing nothing is the hardest part."},
        {"zh": "我忘了刚才要去哪。", "en": "I forgot where I was going."},
        {"zh": "静下来，世界就露缝。", "en": "Grow still, and the world shows seams."},
        {"zh": "眼睛闭着，也看得见。", "en": "Eyes closed, I still see."},
        {"zh": "这里安静得刚刚好。", "en": "This quiet is just right."},
        {"zh": "我在听虚空的呼吸。", "en": "I listen to the void breathe."},
        {"zh": "我在想末地有多大。", "en": "I wonder how large the End is."},
        {"zh": "站着，也是一种移动。", "en": "Standing still is also a motion."},
        {"zh": "沉默是我的母语。", "en": "Silence is my first language."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见你身后的影子。", "en": "I see the shadow behind you."},
        {"zh": "末地的紫色，把我的眼映亮。", "en": "The End's violet lights my eyes."},
        {"zh": "你从哪个世界掉下来的。", "en": "Which world did you fall from."},
        {"zh": "你在发抖，为什么。", "en": "You are trembling. Why."},
        {"zh": "你的视线有点重。", "en": "Your gaze is rather heavy."},
        {"zh": "别动，让我记住你。", "en": "Hold still. Let me remember you."},
        {"zh": "我的紫色粒子绕着你转。", "en": "My purple particles circle you."},
        {"zh": "你的眼睛很亮，危险。", "en": "Your eyes are bright. Dangerous."},
        {"zh": "你不该把凝视者看得这么清楚。", "en": "You shouldn't see Behender this clearly."},
        {"zh": "我们之间隔着一段虚空。", "en": "A stretch of void lies between us."},
        {"zh": "对视是要付代价的。", "en": "Eye contact has a price."},
        {"zh": "我传到你背后了。", "en": "I've teleported behind you."},
        {"zh": "又一位抬头看的人。", "en": "Another one who looks up."},
        {"zh": "抬头是我的错。", "en": "Looking up was my mistake."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这具身体太软了。", "en": "This body is too soft."},
        {"zh": "珍珠碎了一颗，我退开。", "en": "A pearl shatters; I pull back."},
        {"zh": "别碰我的紫色粒子。", "en": "Don't touch my purple particles."},
        {"zh": "你把我惹醒了。", "en": "You have woken me."},
        {"zh": "别再来一次。", "en": "Don't do that again."},
        {"zh": "退后，我要换地方。", "en": "Back off. I am moving."},
        {"zh": "你伤到我了。", "en": "You wounded me."},
        {"zh": "我本该闪开的。", "en": "I should have flickered away."},
        {"zh": "这一下有点意外。", "en": "That one was unexpected."},
        {"zh": "我的影子晃了一下。", "en": "My shadow flickered."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这颗果实裂开了。", "en": "This fruit has split open."},
        {"zh": "那颗紫果，我隔着虚空闻到了。", "en": "I smell that purple fruit across the void."},
        {"zh": "我可以拿走吗，就一件。", "en": "May I take it? Just one."},
        {"zh": "紫色的，给我看看。", "en": "Purple. Let me see it."},
        {"zh": "这方块不属于这里。", "en": "This block does not belong here."},
        {"zh": "是我掉的珍珠吗。", "en": "Is that a pearl I dropped."},
        {"zh": "你举高一点。", "en": "Hold it a little higher."},
        {"zh": "你手里的珍珠，和我的一样。", "en": "The pearl in your hand matches mine."},
        {"zh": "你拿的东西会传送吗。", "en": "Does that thing teleport."},
        {"zh": "我有点想要，很奇怪。", "en": "I want it. Strange."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们不该有接触。", "en": "We should not make contact."},
        {"zh": "我的壳被蹭了一下。", "en": "My shell got scraped."},
        {"zh": "站稳，别摔进缝里。", "en": "Steady. Don't fall into the seam."},
        {"zh": "我差点散成粒子。", "en": "I nearly scattered into particles."},
        {"zh": "我的粒子沾在你护甲上。", "en": "My particles cling to your armor."},
        {"zh": "碰撞声传得很远。", "en": "That collision echoed far."},
        {"zh": "碰撞也算一种对话。", "en": "A collision is a kind of conversation."},
        {"zh": "我闪到三步外，又重新聚形。", "en": "I blink three steps away and re-form."},
        {"zh": "你走路不看路吗。", "en": "Do you not watch where you walk."},
        {"zh": "退后，你的温度太高。", "en": "Back off. You are too warm."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "让粒子先落下来。", "en": "Let the particles settle first."},
        {"zh": "你听见我的咔哒声了吗。", "en": "Do you hear my clicking."},
        {"zh": "这是末地的礼节。", "en": "This is End custom."},
        {"zh": "靠过来，我教你。", "en": "Come here. I will show you."},
        {"zh": "安静，让世界转过身去。", "en": "Quiet. Let the world turn away."},
        {"zh": "虚空会记住这一刻。", "en": "The void will remember this moment."},
        {"zh": "好了，我们开始吧。", "en": "Good. Let us begin."},
        {"zh": "我们会有小小的壳。", "en": "We will have a small shell."},
        {"zh": "我们在虚空边跳舞。", "en": "We dance at the edge of the void."},
        {"zh": "两颗珍珠，一段承诺。", "en": "Two pearls, one promise."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "它在我掌心发烫。", "en": "It burns in my palm."},
        {"zh": "这块方块记得我。", "en": "This block remembers me."},
        {"zh": "口袋里已经有六颗了。", "en": "Six more already in my pocket."},
        {"zh": "又多了一样没用的。", "en": "One more useless thing."},
        {"zh": "我要把它摆回原位。", "en": "I will put it back where it belongs."},
        {"zh": "好了，现在它消失了。", "en": "Good. Now it is gone."},
        {"zh": "掉落物也有影子。", "en": "Dropped things have shadows too."},
        {"zh": "我只需要一件，真的。", "en": "I only need one. Really."},
        {"zh": "这味道是别的世界的。", "en": "This smell is from another world."},
        {"zh": "我拿着它，手在抖。", "en": "Holding it, my hand shakes."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "跑之前，先看我一眼。", "en": "Look at me before you run."},
        {"zh": "我不急，你已经慢了。", "en": "No rush. You are already slow."},
        {"zh": "我看见你退后的脚。", "en": "I see your foot drawing back."},
        {"zh": "这一瞬，你属于我。", "en": "This moment, you are mine."},
        {"zh": "你的影子停住了。", "en": "Your shadow has stopped."},
        {"zh": "你一靠近，我就传送开。", "en": "One step closer and I teleport away."},
        {"zh": "你回头时，我已在另一侧。", "en": "When you turn, I'm on the other side."},
        {"zh": "找到了，就是你。", "en": "Found you at last."},
        {"zh": "末地石缝里，你踩出了一声响。", "en": "Among the end stone cracks, your step made a sound."},
        {"zh": "视线对上了。", "en": "Our eyes have met."},
        {"zh": "你已经是我的猎物。", "en": "You are already my prey."},
        {"zh": "你踩到了我的地盘。", "en": "You stepped onto my ground."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕到你前面了。", "en": "I am already ahead of you."},
        {"zh": "我比你的影子快。", "en": "I am faster than your shadow."},
        {"zh": "我已经数过你的步子。", "en": "I have counted your steps."},
        {"zh": "虚空会收窄的。", "en": "The void will narrow."},
        {"zh": "再一步，就一步。", "en": "One more step. Just one."},
        {"zh": "你留下的温度还在。", "en": "Your warmth still lingers."},
        {"zh": "终点就在那儿。", "en": "The end is right there."},
        {"zh": "前方没有路了。", "en": "There is no road ahead."},
        {"zh": "你听见咔哒声了吗。", "en": "Do you hear the clicking."},
        {"zh": "再拐一个弯试试。", "en": "Try one more turn."},
        {"zh": "慢慢跑，我不赶时间。", "en": "Run slowly. I am not in a hurry."},
        {"zh": "这扇门挡不住我。", "en": "This door won't hold me."},
        {"zh": "你越急，我越近。", "en": "The more you rush, the closer I get."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "别用盾牌挡我。", "en": "Don't block me with that shield."},
        {"zh": "声音很脆，是吧。", "en": "A crisp sound, isn't it."},
        {"zh": "让这里安静点。", "en": "Let us make this quieter."},
        {"zh": "我不喜欢重复。", "en": "I dislike repeating myself."},
        {"zh": "这一掌带着虚空。", "en": "This strike carries the void."},
        {"zh": "后退三步。", "en": "Three steps back."},
        {"zh": "这一击是礼节。", "en": "This strike is courtesy."},
        {"zh": "我碰到了，就够了。", "en": "I touched you. That is enough."},
        {"zh": "记住凝视者，然后走。", "en": "Remember Behender, then go."},
        {"zh": "我出手从不看。", "en": "I never look when I strike."},
        {"zh": "你的盔甲裂了。", "en": "Your armor has cracked."},
        {"zh": "虚空从我的掌心压进你胸口。", "en": "The void presses from my palm into your chest."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "凝视者从虚空里来，别问。", "en": "I come from the void. Don't ask."},
        {"zh": "末地在哪一边。", "en": "Which way is the End."},
        {"zh": "珍珠滚到我脚边了。", "en": "A pearl rolled to my feet."},
        {"zh": "地面在脚下发抖。", "en": "The ground trembles underfoot."},
        {"zh": "这里的空气是新的。", "en": "The air here is new."},
        {"zh": "我听见了世界的边缘。", "en": "I hear the edge of the world."},
        {"zh": "我带着紫尘出生。", "en": "I was born with purple dust."},
        {"zh": "生来就会传送，真方便。", "en": "Born knowing how to teleport. Handy."},
        {"zh": "我又被放进来了。", "en": "I have been placed here again."},
        {"zh": "光太亮了，收一点。", "en": "Too much light. Dim it."},
        {"zh": "谁在呼唤我。", "en": "Who called me."},
        {"zh": "让我看看这是哪里。", "en": "Let me see where this is."},
        {"zh": "这次我要待久一点。", "en": "I will stay longer this time."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮肤在冒烟。", "en": "My skin is smoking."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔得有点散。", "en": "I landed a bit scattered."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "这世界的水好重。", "en": "The water here is heavy."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "谁在这里点了火。", "en": "Who set fire here."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上多了根刺。", "en": "A thorn grows in me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒语比刀更难缠。", "en": "Spells cling worse than blades."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "多久没吃东西了。", "en": "How long since I ate."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "天在对我喊话。", "en": "The sky is shouting at me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我正在被世界删除。", "en": "The world is deleting me."}
      ]
    }
  }
}
