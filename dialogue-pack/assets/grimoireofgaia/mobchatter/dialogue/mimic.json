      "lines": [
        {"zh": "箭卡进我的缝里", "en": "An arrow wedged in my seams."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量掀开了我的盖", "en": "That power forced my lid open."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得牙发痒", "en": "Hunger makes my teeth itch."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈裂了我整块板", "en": "Lightning split a whole plank."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "连箱子一起掉下去", "en": "The whole chest falls away."}
      ]
    }
  }
}
