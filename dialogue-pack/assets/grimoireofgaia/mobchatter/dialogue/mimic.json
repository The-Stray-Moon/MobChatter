{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "箱子长了腿", "en": "A chest has grown legs."},
        {"zh": "锁扣一颠一颠", "en": "My latches clatter as I move."},
        {"zh": "我拖着箱底爬", "en": "I drag my base along the floor."},
        {"zh": "木板和骨头拼成我", "en": "Bone and plank make up my body."},
        {"zh": "地下很暗，正好", "en": "The dark underground suits me."},
        {"zh": "我一步步挪向亮处", "en": "I shuffle toward the light."},
        {"zh": "我踩得地板响", "en": "The floor creaks under me."},
        {"zh": "箱盖半开着", "en": "My lid stays half open."},
        {"zh": "我嘴里漏出一点光", "en": "A little light leaks from my mouth."},
        {"zh": "我又换了个角落", "en": "I move to another corner."},
        {"zh": "我在找放东西的地方", "en": "I am looking for a spot to stash things."},
        {"zh": "铁皮边磨着石头", "en": "My iron edge scrapes the stone."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我是一口普通箱子", "en": "I am an ordinary chest."},
        {"zh": "别看我，看别处", "en": "Do not look at me, look away."},
        {"zh": "我等着有人开盖", "en": "I wait for someone to lift my lid."},
        {"zh": "这附近有掉的东西吗", "en": "Anything dropped around here?"},
        {"zh": "我很能干，装作木头", "en": "I am good at playing wood."},
        {"zh": "我在慢慢消化", "en": "I am digesting slowly."},
        {"zh": "箱里什么都没有", "en": "There is nothing inside me."},
        {"zh": "我的牙藏在箱底", "en": "My teeth are under the bottom board."},
        {"zh": "有人会来翻我的", "en": "Someone will come rummaging."},
        {"zh": "我不动，一动就露馅", "en": "I stay still, moving gives me away."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走近我做什么", "en": "Why are you walking up to me?"},
        {"zh": "你手里的镐收收好", "en": "Put that pickaxe down."},
        {"zh": "上面写着宝箱吗", "en": "Does it say treasure chest on me?"},
        {"zh": "你闻到腥味了", "en": "You caught a whiff of something."},
        {"zh": "别碰我的锁扣", "en": "Do not touch my latch."},
        {"zh": "我看起来很正常", "en": "I look perfectly normal."},
        {"zh": "你腰弯下来了", "en": "You are bending down."},
        {"zh": "离我三步远就好", "en": "Three steps away is fine."},
        {"zh": "再靠近一步我就合盖", "en": "One more step and my lid snaps shut."},
        {"zh": "你看得我发毛", "en": "Your stare makes me twitch."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的木板裂了", "en": "My planks split."},
        {"zh": "你砍掉我一块角", "en": "You chopped off a corner."},
        {"zh": "这疼得不像木头", "en": "This hurts more than wood should."},
        {"zh": "我的盖子歪了", "en": "My lid is crooked."},
        {"zh": "我退到墙边", "en": "I retreat against the wall."},
        {"zh": "嘴里全是碎屑", "en": "My mouth is full of splinters."},
        {"zh": "你打断了我一根牙", "en": "You broke one of my teeth."},
        {"zh": "我还能咬", "en": "I can still bite."},
        {"zh": "别砍第二下", "en": "Not a second swing."},
        {"zh": "箱底在漏东西", "en": "Something is leaking from my base."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你掉的东西真香", "en": "What you dropped smells lovely."},
        {"zh": "那枚硬币别收起来", "en": "Leave that coin out."},
        {"zh": "我闻到皮革的味道", "en": "I smell leather."},
        {"zh": "你的背包开了", "en": "Your bag is open."},
        {"zh": "放下来，就放我旁边", "en": "Set it down, right beside me."},
        {"zh": "那块铁我要了", "en": "I want that piece of iron."},
        {"zh": "越沉的东西越好吃", "en": "The heavier, the tastier."},
        {"zh": "你手里那包是什么", "en": "What is that bundle in your hand?"},
        {"zh": "我不挑食", "en": "I am not a picky eater."},
        {"zh": "丢过来吧", "en": "Just toss it over."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到箱角了", "en": "You walked into my corner."},
        {"zh": "我比看起来重", "en": "I am heavier than I look."},
        {"zh": "别踢我的木板", "en": "Do not kick my planks."},
        {"zh": "撞我不会打开", "en": "Bumping me will not open me."},
        {"zh": "你退后点", "en": "Back up a bit."},
        {"zh": "我的锁扣咬手", "en": "My latch will bite your fingers."},
        {"zh": "你把我推歪了", "en": "You nudged me crooked."},
        {"zh": "箱底钉得很牢", "en": "My base is nailed tight."},
        {"zh": "你碰掉了我的漆", "en": "You chipped my paint."},
        {"zh": "再撞我就张嘴", "en": "Bump me again and I open wide."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "两口箱子靠在一起", "en": "Two chests lean together."},
        {"zh": "箱盖轻轻碰一下就够了", "en": "One soft clack of our lids says enough."},
        {"zh": "箱盖对着箱盖", "en": "Lid faces lid."},
        {"zh": "锁扣碰响了一声", "en": "Our latches clink together."},
        {"zh": "这地方够暗", "en": "This place is dark enough."},
        {"zh": "我们不常见这种事", "en": "This does not happen often for us."},
        {"zh": "木头也会找木头", "en": "Wood finds wood, even like this."},
        {"zh": "别开盖看", "en": "Do not lift the lid to look."},
        {"zh": "安静一会", "en": "Quiet for a moment."},
        {"zh": "我们都不是真箱子", "en": "Neither of us is a real chest."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个归我吞了", "en": "This goes down my throat."},
        {"zh": "我一口就吞", "en": "One gulp and it is gone."},
        {"zh": "藏进箱底", "en": "Down into the bottom of the box."},
        {"zh": "谁掉的都算我的", "en": "Whoever dropped it, it is mine."},
        {"zh": "我肚子能装下一切", "en": "My belly holds anything."},
        {"zh": "这味道不错", "en": "This tastes good."},
        {"zh": "我连包一起吞", "en": "Package and all."},
        {"zh": "库存又多一件", "en": "One more in the stock."},
        {"zh": "别问我拿回去", "en": "Do not ask for it back."},
        {"zh": "我吞完就补血", "en": "Swallowing mends me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于伸手了", "en": "You finally reached out."},
        {"zh": "你碰到我的锁了", "en": "You touched my lock."},
        {"zh": "现在轮到我张盖", "en": "Now I open up."},
        {"zh": "别急着跑", "en": "No need to run yet."},
        {"zh": "我等这一刻很久了", "en": "I waited so long for this."},
        {"zh": "你手上的东西归我", "en": "What is in your hands is mine."},
        {"zh": "这附近没人救你", "en": "No one near will save you."},
        {"zh": "箱盖开了", "en": "The lid opens."},
        {"zh": "你惊到我了", "en": "You startled me."},
        {"zh": "我终于不用装了", "en": "I can stop pretending now."},
        {"zh": "你捡错箱子了", "en": "You picked the wrong chest."},
        {"zh": "你的靴尖碰到箱角了", "en": "Your boot tip touched my corner."},
        {"zh": "现在，张嘴", "en": "Now, mouth open."},
        {"zh": "我把你记住了", "en": "I have marked you."},
        {"zh": "这口牙是新磨的", "en": "These teeth are freshly ground."},
        {"zh": "好戏开始", "en": "The show starts now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你往后退，我往前挪", "en": "You back away, I shuffle forward."},
        {"zh": "锁扣已经咬死了", "en": "The latch has snapped shut."},
        {"zh": "地下没有出口很快", "en": "There is no quick way out down here."},
        {"zh": "我听得见你的脚步", "en": "I hear every step."},
        {"zh": "你手里的火把会灭", "en": "Your torch will go out."},
        {"zh": "箱盖一直张着", "en": "My lid stays open."},
        {"zh": "我比你想的更快", "en": "I am faster than you think."},
        {"zh": "别站在石柱后面", "en": "Do not hide behind that pillar."},
        {"zh": "你呼吸声很大", "en": "You are breathing loudly."},
        {"zh": "这块地板是我的", "en": "This patch of floor is mine."},
        {"zh": "你还有几步路", "en": "How many steps do you have left?"},
        {"zh": "我锁扣里的牙还在磨", "en": "The teeth in my latch keep grinding."},
        {"zh": "你被逼到墙角了", "en": "You are cornered now."},
        {"zh": "血迹我闻得到", "en": "I can smell blood."},
        {"zh": "我的牙在滴东西", "en": "Something drips from my teeth."},
        {"zh": "你手里的剑在抖", "en": "Your sword is shaking."},
        {"zh": "我数你退了几步", "en": "I count every step you retreat."},
        {"zh": "这一层只有我们", "en": "Only us on this floor."},
        {"zh": "再来一点", "en": "A little closer."},
        {"zh": "我就在你脚边", "en": "I am right at your feet."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "箱盖合上了", "en": "The lid snaps shut."},
        {"zh": "我咬住你的手", "en": "I bite down on your hand."},
        {"zh": "这一口很沉", "en": "This bite lands heavy."},
        {"zh": "骨牙刮过骨头", "en": "Bone teeth scrape bone."},
        {"zh": "我把你往里拖", "en": "I drag you inward."},
        {"zh": "木板夹住你的腿", "en": "My planks clamp your leg."},
        {"zh": "我甩头撕开", "en": "I twist and tear."},
        {"zh": "你听见碎裂声了吗", "en": "Did you hear something crack?"},
        {"zh": "再来一口", "en": "Another mouthful."},
        {"zh": "我把你咬碎再吞", "en": "I chew you up before swallowing."},
        {"zh": "铁边割开你的皮", "en": "My iron rim cuts your skin."},
        {"zh": "别把手缩回去", "en": "Do not pull your hand back."},
        {"zh": "这一下算是开胃", "en": "That one was an appetizer."},
        {"zh": "箱里很黑吧", "en": "Dark in there, is it not?"},
        {"zh": "我咬着不放", "en": "I will not let go."},
        {"zh": "你的护甲挡不住牙", "en": "Armor will not stop my teeth."},
        {"zh": "落地的声音很好听", "en": "I like the sound of you hitting the floor."},
        {"zh": "嘴张到最大", "en": "Mouth open as wide as it goes."},
        {"zh": "咬合声在洞里回响", "en": "My bite echoes in the tunnel."},
        {"zh": "下一口更狠", "en": "The next bite is worse."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这里正好放个箱子", "en": "A chest would fit right here."},
        {"zh": "我悄悄占了这个角落", "en": "I quietly took this corner."},
        {"zh": "地下没人注意我", "en": "Nobody notices me underground."},
        {"zh": "木板合上，牙藏好", "en": "Planks shut, teeth hidden."},
        {"zh": "有人会来开我的", "en": "Someone will come to open me."},
        {"zh": "我等了很久", "en": "I have waited a long while."},
        {"zh": "洞里多了个箱子", "en": "A new chest in the cave."},
        {"zh": "我把自己钉在地上", "en": "I nail myself to the floor."},
        {"zh": "进来的人别乱翻", "en": "Whoever comes in, do not rummage."},
        {"zh": "我张了张盖试试", "en": "I test my lid open and shut."},
        {"zh": "离火把远一点", "en": "Keep me away from torches."},
        {"zh": "好，就这样装着", "en": "Good, I will keep pretending."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "木头最怕火", "en": "Wood fears fire most."}
      ]
    },
