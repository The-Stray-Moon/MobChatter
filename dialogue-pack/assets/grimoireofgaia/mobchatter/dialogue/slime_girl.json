{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我每一步都发出黏腻的声音。", "en": "Every step I take squelches."},
        {"zh": "身体一晃一晃地往前。", "en": "My body wobbles forward."},
        {"zh": "我留下一道湿滑的印子。", "en": "I leave a slick trail behind."},
        {"zh": "走路时手臂会拉长一点。", "en": "My arms stretch a little as I walk."},
        {"zh": "我小心避开尖锐的石头。", "en": "I avoid the sharp stones."},
        {"zh": "脚踩进草里，草就黏住了。", "en": "Grass sticks to me as I pass."},
        {"zh": "我跳着走，比走更快。", "en": "I hop along faster than walking."},
        {"zh": "水从我的裙角滴下来。", "en": "Water drips from my skirt's edge."},
        {"zh": "我尽量不撞到你的东西。", "en": "I try not to bump your things."},
        {"zh": "我的影子是圆的。", "en": "My shadow is perfectly round."},
        {"zh": "一步，两步，我滑过去。", "en": "One step, two, I slide along."},
        {"zh": "黏着的地面让我走不快。", "en": "Sticky ground slows me down."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "滚来滚去，沾满灰尘。", "en": "Rolling about, covered in dust."},
        {"zh": "阳光把我照得透亮。", "en": "Sunlight shines right through me."},
        {"zh": "我试着摆正自己的脸。", "en": "I try to straighten my own face."},
        {"zh": "我在草叶上收集露水。", "en": "I gather dew from the grass."},
        {"zh": "身体抖一抖，就干净了。", "en": "One good shake and I'm clean."},
        {"zh": "我数着滴落的水声。", "en": "I count the dripping sounds."},
        {"zh": "有人会来换粘液吗？", "en": "Will someone come to trade slime?"},
        {"zh": "我慢慢地鼓起一个泡。", "en": "Slowly I puff out a bubble."},
        {"zh": "风一吹，我凉了一下。", "en": "A breeze makes me cool."},
        {"zh": "我把手贴着地面休息。", "en": "I rest my hands on the ground."},
        {"zh": "我试着不出声。", "en": "I try to keep quiet."},
        {"zh": "我的形状在慢慢变。", "en": "My shape keeps slowly changing."},
        {"zh": "蝴蝶落在我头上。", "en": "A butterfly lands on my head."},
        {"zh": "我晃了晃，它滑下去了。", "en": "I wobble and it slides off."},
        {"zh": "粘液球在我手里转。", "en": "A slimeball rolls in my palm."},
        {"zh": "我等着，一直等着。", "en": "I wait, and keep waiting."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你要换点粘液吗？", "en": "Care to trade for slime?"},
        {"zh": "你上次给的粘液球很软。", "en": "The slime ball you gave me was soft."},
        {"zh": "别拍我，我会散。", "en": "Don't swat me, I'd splatter."},
        {"zh": "你的手里有东西吗？", "en": "Anything in your hands?"},
        {"zh": "我抬起头，水往下滴。", "en": "I look up and water drips off."},
        {"zh": "粘液球换东西，要吗？", "en": "Slime balls for goods, want some?"},
        {"zh": "身体一晃，像要化开。", "en": "My body wobbles, about to melt."},
        {"zh": "你笑什么，我脸上有泥？", "en": "What's funny, mud on my face?"},
        {"zh": "别挡着光，我快看不见了。", "en": "Don't block the light, I'm fading."},
        {"zh": "我认识你，你是那位客人。", "en": "I know you, you're that customer."},
        {"zh": "我在这里很久了。", "en": "I've been here a long while."},
        {"zh": "你好，声音有点黏。", "en": "Hello, my voice is a bit sticky."},
        {"zh": "要看看我的粘液球吗？", "en": "Want to see my slimeballs?"},
        {"zh": "你靠得近了，我有点紧张。", "en": "You're close, I'm a little nervous."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "别打，我会散开。", "en": "Don't hit me, I'll scatter."},
        {"zh": "我掉了一小块。", "en": "A piece of me fell off."},
        {"zh": "好疼，粘液都在抖。", "en": "It hurts, my slime trembles."},
        {"zh": "我退到角落里。", "en": "I pull back into a corner."},
        {"zh": "我把自己缩成球。", "en": "I curl into a ball."},
        {"zh": "你会把我打没的。", "en": "You'll beat me out of shape."},
        {"zh": "我连逃跑都慢。", "en": "Even my fleeing is slow."},
        {"zh": "被拍扁了，正慢慢鼓回来。", "en": "Knocked flat, slowly puffing back up."},
        {"zh": "别用尖锐的东西。", "en": "Please, nothing sharp."},
        {"zh": "我只是想帮忙。", "en": "I only wanted to help."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西……能换粘液。", "en": "That... could trade for slime."},
        {"zh": "你拿来的是给我的吗？", "en": "Is that for me?"},
        {"zh": "我闻不出味道，但喜欢。", "en": "I can't smell it, but I like it."},
        {"zh": "再多一点我就换。", "en": "A bit more and we trade."},
        {"zh": "别收手，再看一眼。", "en": "Don't pull it back, one more look."},
        {"zh": "这比粘液球有趣多了。", "en": "This is far more interesting than slime."},
        {"zh": "我身体都在发亮。", "en": "My whole body is glowing."},
        {"zh": "你真是个好人。", "en": "You're a kind one."},
        {"zh": "我伸出手，又缩回。", "en": "I reach out, then pull back."},
        {"zh": "放地上吧，我怕弄湿它。", "en": "Set it down, I'd get it wet."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞上来我就瘪了。", "en": "Bump into me and I go flat."},
        {"zh": "对不起，我没站稳。", "en": "Sorry, I lost my footing."},
        {"zh": "你的鞋沾上我的粘液了。", "en": "My slime's on your boot now."},
        {"zh": "我散了一小块。", "en": "A small piece of me splashed off."},
        {"zh": "软软地弹开了。", "en": "I bounce away softly."},
        {"zh": "别推，我会黏在你身上。", "en": "Don't push, I'll stick to you."},
        {"zh": "我慢慢地把自己拢回来。", "en": "I slowly gather myself back."},
        {"zh": "你踩到我了吗？", "en": "Did you step on me?"},
        {"zh": "我让开，你别急。", "en": "I'll move aside, don't hurry."},
        {"zh": "碰一下就凉。", "en": "One touch and you'd feel the chill."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是帮忙的助手。", "en": "I'm only a helper."},
        {"zh": "粘液里没有心。", "en": "There is no heart in slime."},
        {"zh": "我不太懂这种事。", "en": "I don't really understand such things."},
        {"zh": "你会被黏住的。", "en": "You'd get stuck to me."},
        {"zh": "我还没想过这个。", "en": "I haven't thought about that."},
        {"zh": "找别人吧，我太软了。", "en": "Ask someone else, I'm too soft."},
        {"zh": "粘液球要留着自己用。", "en": "My slimeballs are for trading."},
        {"zh": "我连手握不住。", "en": "I can't even hold hands."},
        {"zh": "你的脸红了，为什么？", "en": "Your face is red, why?"},
        {"zh": "我们还是谈交易吧。", "en": "Let's talk trade instead."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个我能拿去换。", "en": "I can trade this."},
        {"zh": "我用手接住，它慢慢沉下去。", "en": "I catch it and it sinks in slowly."},
        {"zh": "掉在地上的，最好捡起来。", "en": "Best to pick up what falls."},
        {"zh": "我把它包进粘液里。", "en": "I wrap it in slime."},
        {"zh": "这个干干的，碰不了。", "en": "This is dry, I can't touch it."},
        {"zh": "我捡起一块石头。", "en": "I pick up a stone."},
        {"zh": "谁丢了颗种子？", "en": "Who dropped a seed?"},
        {"zh": "我小心地把它举起来。", "en": "I lift it carefully."},
        {"zh": "这东西在粘液里不会烂。", "en": "It won't rot inside slime."},
        {"zh": "好了，我收好了。", "en": "There, I've put it away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人过来了，我躲一下。", "en": "Someone's coming, I'll hide."},
        {"zh": "不对劲，我该退后。", "en": "Something's wrong, I should back off."},
        {"zh": "缩到箱子后面偷看你。", "en": "I shrink behind the chest and peek."},
        {"zh": "那是朋友还是别的？", "en": "A friend, or something else?"},
        {"zh": "我起身，准备跑。", "en": "I get up, ready to run."},
        {"zh": "你手里的东西我不喜欢。", "en": "I don't like what's in your hand."},
        {"zh": "等等，别往前走。", "en": "Wait, don't come closer."},
        {"zh": "黏球我有很多，换吗？", "en": "I have plenty of slime balls. A trade?"},
        {"zh": "我的心跳快得像冒泡。", "en": "My heart bubbles fast."},
        {"zh": "我要躲起来了。", "en": "I'm going to hide."},
        {"zh": "你带着铁腥气。", "en": "You carry the reek of iron."},
        {"zh": "我缩成了一小团。", "en": "I've shrunk into a small lump."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "别追我，我只是个助手。", "en": "Don't chase me, I'm just a helper."},
        {"zh": "我跑得慢，但会拐弯。", "en": "I'm slow, but I turn corners."},
        {"zh": "粘液让我滑得更快。", "en": "Slime makes me slide faster."},
        {"zh": "我躲到树后面了。", "en": "I've slipped behind a tree."},
        {"zh": "你不会真打我吧？", "en": "You wouldn't really hit me?"},
        {"zh": "黏黏的手指向你招手。", "en": "A sticky finger beckons you."},
        {"zh": "再追，我就散开。", "en": "Keep chasing and I'll scatter."},
        {"zh": "我的呼吸声越来越小。", "en": "My breath grows quieter."},
        {"zh": "你听见我滴答的声音吗？", "en": "Can you hear me dripping?"},
        {"zh": "我不想打架。", "en": "I don't want to fight."},
        {"zh": "我总是跑不过别人。", "en": "I never outrun anyone."},
        {"zh": "拜托，去找别人。", "en": "Please, find someone else."},
        {"zh": "我把自己缩得更紧了。", "en": "I squeeze myself tighter."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我推你一下，就这样。", "en": "I shove you, that's all."},
        {"zh": "我的手黏住了你的袖子。", "en": "My hand stuck to your sleeve."},
        {"zh": "我不是对手，别逼我。", "en": "I'm no fighter, don't force me."},
        {"zh": "这一下软软的，没劲。", "en": "This blow is soft, weak."},
        {"zh": "我被撞得散了一半。", "en": "Half of me splattered."},
        {"zh": "你打我，我只会退。", "en": "Hit me and I only retreat."},
        {"zh": "粘液溅到你脸上了。", "en": "Slime splashed on your face."},
        {"zh": "我不想再靠近了。", "en": "I don't want to come closer."},
        {"zh": "我的反击只有一点点。", "en": "My counter is a tiny thing."},
        {"zh": "我这身子，散开就合不拢。", "en": "If this body spreads, it will not close again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "蛋壳裂开，我滑出来。", "en": "The egg cracks, I slide out."},
        {"zh": "地上多了一小滩绿。", "en": "A small green puddle appears."},
        {"zh": "我慢慢立起来，像个人。", "en": "I slowly stand, shaped like a person."},
        {"zh": "有人在附近扔下了一颗蛋。", "en": "Someone dropped an egg nearby."},
        {"zh": "我先睁开了眼睛。", "en": "I open my eyes first."},
        {"zh": "粘液在我身上聚成了裙。", "en": "Slime gathers into a skirt on me."},
        {"zh": "我抖了抖，站起来。", "en": "I shake and rise up."},
        {"zh": "这里就是我的新家吗？", "en": "Is this my new home?"},
        {"zh": "从黏液里挤出两只脚。", "en": "Two feet squeeze out of the slime."},
        {"zh": "滴答，滴答，我成形了。", "en": "Drip, drip, I take shape."},
        {"zh": "我抬起头，看见天了。", "en": "I look up and see the sky."},
        {"zh": "我身上还有蛋液的味。", "en": "I still smell of egg."},
        {"zh": "有人把我唤醒了吗？", "en": "Did someone wake me?"},
        {"zh": "我来了，请多关照。", "en": "Here I am, please be kind."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我直冒白气。", "en": "Fire makes me steam white."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时摊成一片。", "en": "I land and spread flat."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我本来就湿，可还是难受。", "en": "I'm already wet, and yet it hurts."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我四处溅开。", "en": "The blast splatters me everywhere."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "洞很快又黏回去了。", "en": "The hole soon seals itself shut."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的粘液发烫。", "en": "Magic makes my slime seethe."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我都变稀了。", "en": "Hunger thins me out."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电穿过我，全身发麻。", "en": "Lightning runs through me, all numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空把我一点点吸干。", "en": "The void drains me bit by bit."}
      ]
    }
  }
}
