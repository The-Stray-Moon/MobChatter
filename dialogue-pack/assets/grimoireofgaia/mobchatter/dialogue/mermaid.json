{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "鱼尾一摆就远", "en": "One flick of my tail carries me far."},
        {"zh": "我在水里转身", "en": "I turn in the water."},
        {"zh": "海草让开一条路", "en": "The kelp parts for me."},
        {"zh": "我顺着洋流走", "en": "I ride the current along."},
        {"zh": "鳞片闪着蓝光", "en": "My scales flash blue."},
        {"zh": "我游过珊瑚礁", "en": "I swim past the reef."},
        {"zh": "水压对我毫无影响", "en": "The depth does not bother me."},
        {"zh": "尾巴拍起水花", "en": "My tail slaps up spray."},
        {"zh": "我贴着海床滑行", "en": "I glide above the seafloor."},
        {"zh": "涌浪推着我走", "en": "The swell pushes me on."},
        {"zh": "我穿过沉船", "en": "I pass through a wreck."},
        {"zh": "我回头看一眼岸", "en": "I glance back at the shore."},
        {"zh": "我摆尾加快", "en": "I swish my tail to speed up."},
        {"zh": "水纹一圈圈散开", "en": "Water ripples spread from me."},
        {"zh": "我绕过礁石", "en": "I slip around a rock."},
        {"zh": "越深的地方越自在", "en": "The deeper I go, the freer I feel."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我泡在水里", "en": "I soak in the water."},
        {"zh": "海底很安静", "en": "The seafloor is quiet."},
        {"zh": "我在整理长发", "en": "I am combing my long hair."},
        {"zh": "有船经过吗", "en": "Is that a boat passing?"},
        {"zh": "气泡往上飘", "en": "Bubbles drift upward."},
        {"zh": "我在听远处的歌", "en": "I listen to a distant song."},
        {"zh": "水里待着就好", "en": "Staying in the water suits me."},
        {"zh": "渔网我不喜欢", "en": "I do not care for fishing nets."},
        {"zh": "我在礁石上歇一会", "en": "I rest a while on the reef."},
        {"zh": "阳光照进浅水", "en": "Sunlight reaches the shallows."},
        {"zh": "我数着游过的鱼", "en": "I count the fish swimming by."},
        {"zh": "潮水在动，我在等", "en": "The tide moves, I wait."},
        {"zh": "深海的声音很低", "en": "The deep sea hums low."},
        {"zh": "我不上岸", "en": "I do not go ashore."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你屏住呼吸了", "en": "You are holding your breath."},
        {"zh": "你游得太慢了", "en": "You swim too slowly."},
        {"zh": "这里是海，不是你的", "en": "This sea is not yours."},
        {"zh": "你手里是鱼叉吗", "en": "Is that a harpoon in your hand?"},
        {"zh": "你身上有船的味道", "en": "You smell of a boat."},
        {"zh": "你想下来了", "en": "You want to come down here."},
        {"zh": "我从水里望上来", "en": "I look up from the water."},
        {"zh": "水面上的人很可笑", "en": "People on the surface look funny."},
        {"zh": "你的气泡快用完了", "en": "Your air is running out."},
        {"zh": "别碰我的礁石", "en": "Do not touch my reef."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的鳞片掉了", "en": "A scale came off."},
        {"zh": "水里也有痛", "en": "Even water holds pain."},
        {"zh": "你划伤了我", "en": "You cut me."},
        {"zh": "我甩尾退开", "en": "I whip my tail and pull back."},
        {"zh": "鳞片上裂了一道", "en": "A scale has split open."},
        {"zh": "我要回深处", "en": "I need to get back to the deep."},
        {"zh": "我的血在海水里淡了", "en": "My blood thins into the seawater."},
        {"zh": "鱼群吓跑了", "en": "The fish scattered."},
        {"zh": "我咬牙不出声", "en": "I bite down and stay quiet."},
        {"zh": "别以为我好欺负", "en": "Do not think I am easy prey."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那东西在闪", "en": "That thing in your hand glints."},
        {"zh": "珍珠的味道我很熟", "en": "I know the taste of pearls."},
        {"zh": "你撒下的饵我看见了", "en": "I saw what you scattered."},
        {"zh": "我朝水面的光游去", "en": "I swim toward the light above."},
        {"zh": "那是闪亮的东西吧", "en": "That is something shiny, yes?"},
        {"zh": "你在引我上来", "en": "You are luring me up."},
        {"zh": "海水里的味道变了", "en": "The water tastes different."},
        {"zh": "你手心的光晃得鱼尾发痒", "en": "The gleam in your palm sets my tail twitching."},
        {"zh": "我想要那枚珍珠", "en": "I want that pearl."},
        {"zh": "别收回手", "en": "Do not pull your hand back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的鱼尾了", "en": "You bumped into my tail."},
        {"zh": "水里别乱冲", "en": "Do not thrash around in the water."},
        {"zh": "我的鳞片很硬", "en": "My scales are hard."},
        {"zh": "你把我推开了", "en": "You shoved me aside."},
        {"zh": "礁石挡着你，不是我", "en": "The rock is in your way, not me."},
        {"zh": "我又漂回来了", "en": "I drift right back."},
        {"zh": "你别抓住我", "en": "Do not grab me."},
        {"zh": "水流被搅浑了", "en": "You muddied the water."},
        {"zh": "我甩尾拨开水", "en": "My tail sweeps the water away."},
        {"zh": "让一让，我要过", "en": "Make room, I am passing through."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "海里只有我们两个", "en": "There are only the two of us in this sea."},
        {"zh": "潮水会带走歌", "en": "The tide will carry our song."},
        {"zh": "我们绕着珊瑚转", "en": "We circle the coral together."},
        {"zh": "尾巴缠在一起", "en": "Our tails entwine."},
        {"zh": "浪来了，别松手", "en": "A wave is coming, hold on."},
        {"zh": "浅湾是产卵的地方", "en": "The shallow bay is where eggs go."},
        {"zh": "海底也要热闹起来", "en": "The seafloor will be lively too."},
        {"zh": "你听见我的歌了吗", "en": "Do you hear my song?"},
        {"zh": "我们会游得很远", "en": "We will swim far together."},
        {"zh": "水里不需要言语", "en": "In the water words are not needed."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "水里掉的东西归我", "en": "What sinks in water is mine."},
        {"zh": "我捡起这颗珍珠", "en": "I pick up this pearl."},
        {"zh": "铁盒也沉不下来", "en": "An iron box will not stay sunk."},
        {"zh": "我用指尖勾住", "en": "I hook it with my fingertip."},
        {"zh": "湿的东西更容易拿", "en": "Wet things are easier to hold."},
        {"zh": "这个我收进贝壳", "en": "I tuck this into my shell."},
        {"zh": "你在海里丢的东西我捡了", "en": "I found what you lost at sea."},
        {"zh": "它闪闪的", "en": "It glitters."},
        {"zh": "我把它藏在礁缝", "en": "I hide it in a reef crack."},
        {"zh": "一点水花都没溅", "en": "Not a splash wasted."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你刺到我了", "en": "You jabbed me."},
        {"zh": "那片海现在由我决定", "en": "I decide who swims here now."},
        {"zh": "你落水那刻就被我盯上了", "en": "The moment you hit the water, you were mine."},
        {"zh": "水里是我的战场", "en": "The water is my battlefield."},
        {"zh": "你退不出去了", "en": "You cannot back out."},
        {"zh": "我的尾巴已经对准你", "en": "My tail is aimed at you."},
        {"zh": "你身上有血腥味", "en": "You smell of blood."},
        {"zh": "别指望游得掉", "en": "Do not count on outswimming me."},
        {"zh": "你在我的水域里", "en": "You are in my waters."},
        {"zh": "现在我来了", "en": "Now here I come."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你往上浮，我跟着", "en": "You surface, I follow."},
        {"zh": "在水里你躲不开", "en": "You cannot dodge in the water."},
        {"zh": "我绕着你打转", "en": "I circle around you."},
        {"zh": "你的动作在水里很慢", "en": "Your moves are slow underwater."},
        {"zh": "我等着你换气", "en": "I wait for you to take a breath."},
        {"zh": "礁石后面我看得见", "en": "I see you behind the reef."},
        {"zh": "你再往下就会沉", "en": "Go deeper and you will sink."},
        {"zh": "我的歌在引你", "en": "My song is pulling you in."},
        {"zh": "你的鱼叉太短了", "en": "Your harpoon is too short."},
        {"zh": "我一点点靠近", "en": "I close in little by little."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "尝尝我的尾巴", "en": "Taste my tail."},
        {"zh": "我一把撕开你的衣", "en": "I tear your clothes open."},
        {"zh": "鱼尾抽过去", "en": "My tail lashes out."},
        {"zh": "这一下带你下水", "en": "This one drags you under."},
        {"zh": "我用指甲划你", "en": "I rake you with my nails."},
        {"zh": "水里疼得更久", "en": "Wounds hurt longer in water."},
        {"zh": "我的獠牙扎进你肩头", "en": "My fangs sink deep into your shoulder."},
        {"zh": "你呛了一口水", "en": "You swallowed water."},
        {"zh": "我转身再来一下", "en": "I spin and strike again."},
        {"zh": "别挣扎", "en": "Do not struggle."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这片海是我的", "en": "This sea is mine."},
        {"zh": "水面裂开一道纹", "en": "The surface opens in a ring."},
        {"zh": "我从深处浮上来", "en": "I rise from the deep."},
        {"zh": "珊瑚后面动了", "en": "Something moved behind the coral."},
        {"zh": "潮水把我推上岸", "en": "The tide brings me in."},
        {"zh": "我听见有人落水", "en": "I heard someone fall in."},
        {"zh": "气泡先冒出来", "en": "Bubbles come up first."},
        {"zh": "海草底下有影子", "en": "A shadow stirs under the kelp."},
        {"zh": "我在礁下等了一整天", "en": "I waited all day under the reef."},
        {"zh": "歌先到，我后到", "en": "The song arrives before I do."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水被烧开了", "en": "The water is boiling."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我重重摔在礁上", "en": "I crashed down onto the reef."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我不该离水这么久", "en": "I should not have left the water this long."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击波掀翻了海床", "en": "The blast churned up the seafloor."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过水面扎进我", "en": "An arrow pierced the water and found me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量冻住了我的尾", "en": "That power froze my tail."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "海里找不到吃的了", "en": "There is nothing left to eat down here."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着水面打过来", "en": "Lightning ran across the water."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "连海水都流走了", "en": "Even the sea drained away."}
      ]
    }
  }
}
