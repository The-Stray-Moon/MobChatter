{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "有人需要我，我就去。", "en": "Someone needs me. I go."},
        {"zh": "关节吱呀，忍着。", "en": "Joints creak. I endure."},
        {"zh": "慢，是因为稳。", "en": "Slow because steady."},
        {"zh": "地面在抖，是我。", "en": "The ground shakes. That's me."},
        {"zh": "苔藓湿的，我不会滑。", "en": "The moss is wet. I do not slip."},
        {"zh": "苔藓先把我的路铺好。", "en": "The moss lays my path first."},
        {"zh": "腿是铁做的，慢点。", "en": "Iron legs. No hurry."},
        {"zh": "这条路，我走过一千遍。", "en": "This road. A thousand times."},
        {"zh": "石头认得我的脚。", "en": "The stones know my feet."},
        {"zh": "走过草地，草会站起来。", "en": "Grass bends. It gets up again."},
        {"zh": "别催，铁不会跑。", "en": "Don't rush. Iron doesn't run."},
        {"zh": "雪在脚下融了。", "en": "Snow melts under my feet."},
        {"zh": "铜锈在响，像小铃铛。", "en": "Verdigris rings like tiny bells."},
        {"zh": "再走一会，就到田边。", "en": "A bit more. Then the fields."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "有人从远处看我。", "en": "Someone is watching from far."},
        {"zh": "风从缝里穿过去。", "en": "Wind slips through my seams."},
        {"zh": "有只鸟落在我肩上。", "en": "A bird landed on my shoulder."},
        {"zh": "我听见村子在呼吸。", "en": "I hear the village breathing."},
        {"zh": "世界很吵，我不吵。", "en": "The world is loud. I'm not."},
        {"zh": "就这样，到天黑。", "en": "Just this. Until dark."},
        {"zh": "站成一块石头的样子。", "en": "I stand like a boulder."},
        {"zh": "我数了数自己的手指。", "en": "I counted my fingers."},
        {"zh": "我在等一个词。", "en": "I am waiting for a word."},
        {"zh": "没命令，就站着。", "en": "No orders. Just standing."},
        {"zh": "我在想，铁会不会做梦。", "en": "Do iron things dream?"},
        {"zh": "雨把我洗得很亮。", "en": "The rain washes me bright."},
        {"zh": "胸口有块南瓜，凉了。", "en": "My pumpkin feels cold now."},
        {"zh": "胸腔里的炉火还温着。", "en": "The fire in my chest stays warm."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是来修我的吗？", "en": "Are you here to fix me?"},
        {"zh": "这个村子，我守着。", "en": "I guard this village."},
        {"zh": "丛林的光落在你的脸上。", "en": "Jungle light is falling on your face."},
        {"zh": "丛林里，我的圆石被苔藓盖住。", "en": "Moss covers my cobbles in the jungle."},
        {"zh": "找我？还是路过？", "en": "Me? Or just passing?"},
        {"zh": "你眼睛里有火。", "en": "There's fire in your eyes."},
        {"zh": "你的手在抖，圆石看得见。", "en": "Cobblestone sees your hands shaking."},
        {"zh": "是敌人，还是客人？", "en": "Enemy, or guest?"},
        {"zh": "需要我做什么？", "en": "What do you need of me?"},
        {"zh": "站住，报上名字。", "en": "Stop. Say your name."},
        {"zh": "我记得每一个路过的人。", "en": "I remember everyone who passes."},
        {"zh": "丛林里，我这身圆石很硬。", "en": "In the jungle, this cobble body is hard."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "裂缝里进了风。", "en": "Wind got in the crack."},
        {"zh": "这不算伤。", "en": "This doesn't count as a wound."},
        {"zh": "我的零件松了。", "en": "Something came loose."},
        {"zh": "再来，我扛得住。", "en": "Again. I can take it."},
        {"zh": "圆石裂了，还能拼回去。", "en": "Cracked, but I can fit the pieces back."},
        {"zh": "有点疼，真的。", "en": "That actually stings."},
        {"zh": "别打同一处。", "en": "Don't hit the same spot."},
        {"zh": "镐头敲我，最疼。", "en": "Pickaxes hurt the most."},
        {"zh": "谁在那儿？出来。", "en": "Who's there? Come out."},
        {"zh": "铁粒没掉，还能撑。", "en": "No nuggets lost. I can still hold."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我很少想要什么。", "en": "I rarely want anything."},
        {"zh": "铁对铁，会认亲。", "en": "Iron knows iron."},
        {"zh": "那不是食物，但很香。", "en": "Not food. Still smells good."},
        {"zh": "你握得太紧了。", "en": "You're holding it too tight."},
        {"zh": "那个闪的东西，归我？", "en": "That shiny thing. Mine?"},
        {"zh": "是新的零件吗？", "en": "Is that a new part?"},
        {"zh": "铁锭在发光吗？", "en": "Is that ingot glowing?"},
        {"zh": "我的胸口空了一块。", "en": "There's a gap in my chest."},
        {"zh": "给我一块，我就走。", "en": "Give me one. I'll go."},
        {"zh": "南瓜，圆的，正好。", "en": "A pumpkin. Round. Fits."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们都有点硬。", "en": "We're both a bit hard."},
        {"zh": "啊，原来是你。", "en": "Ah. It's you."},
        {"zh": "撞到我了，小心。", "en": "You hit me. Careful."},
        {"zh": "撞我，你的肩膀还好吗？", "en": "You hit me. Is your shoulder all right?"},
        {"zh": "轻轻的，会碎。", "en": "Easy. Things break."},
        {"zh": "借过，我赶时间。", "en": "Excuse me. I'm in a hurry."},
        {"zh": "这一下，我听见了。", "en": "I heard that one."},
        {"zh": "一只松鼠正踩着我的脚趾。", "en": "A squirrel is standing on my toe."},
        {"zh": "圆石缝里的锈，被你撞掉了。", "en": "You knocked the rust out of my seams."},
        {"zh": "圆石脚停不下来，让开。", "en": "My cobble feet won't stop — move."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们合起来，能走更远。", "en": "Together we walk farther."},
        {"zh": "你愿意和我一起站岗？", "en": "Will you stand watch with me?"},
        {"zh": "我的炉火分你一半。", "en": "Half my furnace fire is yours."},
        {"zh": "拼在一起，才完整。", "en": "Only together are we whole."},
        {"zh": "两块铁，正好成对。", "en": "Two irons. A perfect pair."},
        {"zh": "我会替你挡下这一世。", "en": "I'll shield you this lifetime."},
        {"zh": "我把最好的铁留给你。", "en": "I saved my best iron for you."},
        {"zh": "两个构造，也算家。", "en": "Two constructs can be a home."},
        {"zh": "你的手，和我的手一样凉。", "en": "Your hand is cold like mine."},
        {"zh": "这算约定吗？算。", "en": "Is this a promise? Yes."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡得慢，但不会漏。", "en": "Slow picker. Never miss one."},
        {"zh": "我先替你保管。", "en": "I'll keep it safe for you."},
        {"zh": "捡起来，留着有用。", "en": "Picked up. Might be useful."},
        {"zh": "是谁的东西？没人应。", "en": "Anyone's? No answer."},
        {"zh": "掉了东西？是我的了。", "en": "Dropped this? Mine now."},
        {"zh": "轻的，怕捏坏。", "en": "Light thing. Might break."},
        {"zh": "东西掉了要还的……大概。", "en": "Dropped things get returned... maybe."},
        {"zh": "铜片，配我的肩膀。", "en": "Copper plate. Fits my shoulder."},
        {"zh": "我弯腰，关节响。", "en": "I bend. Joints creak."},
        {"zh": "这朵花，插在缝里。", "en": "This flower. In my seam."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的拳头认得你。", "en": "My fist knows you."},
        {"zh": "你在那里。", "en": "You're right there."},
        {"zh": "丛林给我让开一条路。", "en": "The jungle opens a path for me."},
        {"zh": "村子需要安静。", "en": "The village needs quiet."},
        {"zh": "我闻到你身上的坏味。", "en": "I smell the rot on you."},
        {"zh": "就是你了，别躲。", "en": "It's you. Don't hide."},
        {"zh": "我的拳头是四块圆石。", "en": "My fist is four cobblestones."},
        {"zh": "目标很小，但够了。", "en": "Small target. Still enough."},
        {"zh": "你的时间到了。", "en": "Your time is up."},
        {"zh": "我身上七块圆石，一块都没松。", "en": "Seven cobbles on me, not one loose."},
        {"zh": "已经锁定了。", "en": "You're locked in now."},
        {"zh": "灌木后面那只脚，看见了。", "en": "I see the foot behind the bush."},
        {"zh": "我慢慢来，你别急。", "en": "I'll go slow. Don't rush."},
        {"zh": "你挡在门口了。", "en": "You're blocking the gate."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "别跑，我很慢。", "en": "Don't run. I'm slow."},
        {"zh": "我记住你的方向。", "en": "I remember your direction."},
        {"zh": "一步，两步，丛林里近了。", "en": "One step, two. Closer through the jungle."},
        {"zh": "快了，再快一点。", "en": "Faster. Just a bit faster."},
        {"zh": "你跑不过我的耐心。", "en": "You can't outrun my patience."},
        {"zh": "丛林里，我这身石头会走。", "en": "In the jungle, this stone body walks."},
        {"zh": "铁不喘气，你喘。", "en": "Iron doesn't pant. You do."},
        {"zh": "我开始热了。", "en": "I'm getting warm now."},
        {"zh": "不远了，真的不远。", "en": "Close now. Truly close."},
        {"zh": "你越跑越远……没用。", "en": "Farther and farther. Useless."},
        {"zh": "别回头，回头会慢。", "en": "Don't look back. It slows you."},
        {"zh": "我留下脚印，你留下脚印。", "en": "I leave prints. You leave prints."},
        {"zh": "这一片，我熟。", "en": "This ground. I know it."},
        {"zh": "林子里每一根藤都听我的。", "en": "Every vine in there answers to me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "这一拳带着铁粒的味道。", "en": "This punch carries the taste of iron."},
        {"zh": "你该倒下了。", "en": "You should fall now."},
        {"zh": "快往后退。", "en": "Get back. Now."},
        {"zh": "这拳里有整片丛林的重量。", "en": "All the jungle's weight in this swing."},
        {"zh": "地面会接住你。", "en": "The ground will catch you."},
        {"zh": "这一下，很重。", "en": "This one is heavy."},
        {"zh": "你还站着？好。", "en": "Still standing? Good."},
        {"zh": "别躲，会疼一下。", "en": "Don't dodge. It stings once."},
        {"zh": "抱歉，这是工作。", "en": "Sorry. It's the job."},
        {"zh": "这一拳，替村子打的。", "en": "This punch is for the village."},
        {"zh": "铁拳，落下了。", "en": "Iron fist. Coming down."},
        {"zh": "举起来，放下去。", "en": "Raise. Then down."},
        {"zh": "走开，别再来。", "en": "Go. Don't come back."},
        {"zh": "我打得很慢，但很准。", "en": "Slow swing. Very accurate."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "有人在等我。", "en": "Someone is waiting."},
        {"zh": "我很大，别害怕。", "en": "I'm big. Don't be scared."},
        {"zh": "头顶的天，很亮。", "en": "The sky above is bright."},
        {"zh": "脚踩实了，可以走了。", "en": "Feet planted. Ready to walk."},
        {"zh": "身体很新，关节很硬。", "en": "New body. Stiff joints."},
        {"zh": "我为什么在这里？", "en": "Why am I here?"},
        {"zh": "南瓜是正的，还好。", "en": "Pumpkin's straight. Good."},
        {"zh": "我的影子刚学会站立。", "en": "My shadow just learned to stand."},
        {"zh": "我的手，是我的吗？", "en": "Are these hands mine?"},
        {"zh": "我记得光。", "en": "I remember the light."},
        {"zh": "我醒了，站着。", "en": "I am awake. Standing."},
        {"zh": "铁的味道，从嘴里开始。", "en": "The taste of iron begins."},
        {"zh": "先站着，等命令。", "en": "Stand first. Wait for orders."},
        {"zh": "有人按了开关。", "en": "Someone flipped the switch."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "烧起来了，烫。", "en": "Burning. Too hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔了，很重。", "en": "I fell. Hard."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "铁不会游泳。", "en": "Iron cannot swim."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "谁在那里炸东西？", "en": "Who's blasting over there?"}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进来。", "en": "Something stuck in me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "奇怪的光，冷的。", "en": "Strange light. Cold."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不用吃饭……吧。", "en": "I don't eat... right?"}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "我亮了，好亮。", "en": "I'm glowing. Too bright."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里也没有丛林可抓。", "en": "No jungle to grab in the void."}
      ]
    }
  }
}
