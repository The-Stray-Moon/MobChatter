{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着林子的边缘走。", "en": "I walk the wood's edge."},
        {"zh": "我的脚步很轻，落点很稳。", "en": "My steps are light and sure."},
        {"zh": "朋友走前面，我压着后路。", "en": "My friend leads — I hold the rear."},
        {"zh": "这条路通向河边。", "en": "This path leads to the river."},
        {"zh": "我绕开一丛带刺的藤。", "en": "I go around a patch of thorn vine."},
        {"zh": "我从倒木上跨过去。", "en": "I step over a fallen log."},
        {"zh": "木头底下有虫在响。", "en": "Insects click beneath it."},
        {"zh": "我的脚步没有停。", "en": "My feet have not paused."},
        {"zh": "前面有人的气味。", "en": "There is a human smell ahead."},
        {"zh": "我放慢了步子。", "en": "I slow my pace."},
        {"zh": "先看清是谁再说。", "en": "Best to see who it is first."},
        {"zh": "我停在树后面。", "en": "I stop behind a tree."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在树影里。", "en": "I stand in the tree shadow."},
        {"zh": "那边比较凉。", "en": "It is cool there."},
        {"zh": "我的衣角被风吹动。", "en": "The wind moves my hem."},
        {"zh": "我在听林子的声音。", "en": "I listen to the wood."},
        {"zh": "鸟叫，虫鸣，水声。", "en": "Birds, insects, water."},
        {"zh": "没有打斗的声音。", "en": "No sound of fighting."},
        {"zh": "那便很好了。", "en": "Then that is well."},
        {"zh": "我把手放在身侧。", "en": "I set my hand at my side."},
        {"zh": "我的武器还收着。", "en": "My weapon stays sheathed."},
        {"zh": "我不先动手。", "en": "I do not begin."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你从路上过来了。", "en": "You come along the path."},
        {"zh": "我并没有躲。", "en": "I did not hide."},
        {"zh": "我站在树边，让你看见。", "en": "I stand by the tree so you see me."},
        {"zh": "你收住了脚。", "en": "You check your steps."},
        {"zh": "你的手摸向武器。", "en": "Your hand goes to a weapon."},
        {"zh": "我保持不动。", "en": "I stay still."},
        {"zh": "你找找看吧。", "en": "Search, then."},
        {"zh": "找到了也别急着用。", "en": "But do not be quick to use it."},
        {"zh": "我抬手，掌心朝外。", "en": "I raise a hand, palm out."},
        {"zh": "这意思是我不动手。", "en": "That means I will not strike."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了半步远。", "en": "I give half a step."},
        {"zh": "我把手按在伤处。", "en": "My hand goes to the wound."},
        {"zh": "我一点声没出。", "en": "Without a sound."},
        {"zh": "这一下够重的。", "en": "That one was heavy."},
        {"zh": "我靠着树站稳。", "en": "I brace against a tree."},
        {"zh": "我喘了两口气。", "en": "Two breaths."},
        {"zh": "随后我把头抬起。", "en": "Then lift my head."},
        {"zh": "对面那东西还在。", "en": "The other is still there."},
        {"zh": "我没有打算退。", "en": "I do not intend to retreat."},
        {"zh": "但也没有先动手。", "en": "But I will not strike first either."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不需要这个。", "en": "I have no need of that."},
        {"zh": "你举着那东西。", "en": "You hold it out."},
        {"zh": "我摇了一下头。", "en": "I shake my head."},
        {"zh": "我有自己的份。", "en": "I have my own share."},
        {"zh": "你自己留着。", "en": "Keep it for yourself."},
        {"zh": "我扫了它一眼。", "en": "I glance at it once."},
        {"zh": "不是我想的那样。", "en": "Not what I had in mind."},
        {"zh": "我转身不再理。", "en": "I turn away and pay it no mind."},
        {"zh": "继续看我的林子。", "en": "And go back to watching the wood."},
        {"zh": "你把它收起来。", "en": "You put it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我退半步，只因你不是敌人。", "en": "I step back only because you're no enemy."},
        {"zh": "我没有还手。", "en": "I do not strike back."},
        {"zh": "你也退开了。", "en": "You pull back too."},
        {"zh": "我们互相看了一眼。", "en": "We look at each other."},
        {"zh": "这样就过去了。", "en": "And it is over."},
        {"zh": "我侧过身让路。", "en": "I step aside to clear the path."},
        {"zh": "你从我旁边过去。", "en": "You pass beside me."},
        {"zh": "我的肩没有动。", "en": "My shoulder does not shift."},
        {"zh": "你扭头望了我一眼。", "en": "You glance back at me."},
        {"zh": "我朝你点了点头。", "en": "I nod."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有那样的伴。", "en": "I have no such companion."},
        {"zh": "我一个人守着这片林子。", "en": "I keep this wood alone."},
        {"zh": "有同伴来过这里。", "en": "Others have come."},
        {"zh": "待了一阵就走了。", "en": "Stayed a while, then left."},
        {"zh": "我不留任何人。", "en": "I do not hold anyone."},
        {"zh": "留下来也没用。", "en": "It would do no good to stay."},
        {"zh": "我继续巡我的路。", "en": "I go on with my patrol."},
        {"zh": "这片林子很长。", "en": "The wood is long."},
        {"zh": "一天走不完的。", "en": "A day will not cover it."},
        {"zh": "明天接着巡。", "en": "Tomorrow I continue."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯身把它拾起。", "en": "I stoop and pick it up."},
        {"zh": "翻过来看了看。", "en": "And turn it over."},
        {"zh": "派不上什么用场。", "en": "It serves no purpose."},
        {"zh": "我放在树根上。", "en": "I set it on a root."},
        {"zh": "也许有人会来找。", "en": "Perhaps someone will come for it."},
        {"zh": "我记住了位置。", "en": "I have the place marked."},
        {"zh": "又捡起另一件。", "en": "I pick up another."},
        {"zh": "这件还使得上。", "en": "This one will serve."},
        {"zh": "我把它收进怀里。", "en": "I tuck it away."},
        {"zh": "接着赶我的路。", "en": "Then back to the path."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "林子深处有动静。", "en": "Something stirs deep in the wood."},
        {"zh": "我把视线抬起来。", "en": "I lift my gaze."},
        {"zh": "不是人走路的声音。", "en": "Not human footsteps."},
        {"zh": "我把手放到武器上。", "en": "I put my hand to my weapon."},
        {"zh": "但没有拔出来。", "en": "But do not draw it."},
        {"zh": "先看看是什么。", "en": "First see what it is."},
        {"zh": "那东西在靠近。", "en": "It is coming closer."},
        {"zh": "我闪到树后面。", "en": "I slip behind a tree."},
        {"zh": "只露出半个身子。", "en": "Half of me showing."},
        {"zh": "它在往这边看。", "en": "It looks this way."},
        {"zh": "它不曾看见我。", "en": "It never saw me."},
        {"zh": "它继续往前走。", "en": "It moves on."},
        {"zh": "我从树后出来。", "en": "I come out from behind the tree."},
        {"zh": "我随后跟上去。", "en": "And follow."},
        {"zh": "和它保持距离。", "en": "Keeping my distance."},
        {"zh": "直到它离开这片林子。", "en": "Until it leaves this wood."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我缀在它后面。", "en": "I trail behind it."},
        {"zh": "它往河边去了。", "en": "It heads for the river."},
        {"zh": "我从林子里绕过去。", "en": "I go around through the wood."},
        {"zh": "先绕到它前面。", "en": "To get ahead of it."},
        {"zh": "我站在树下等。", "en": "I stand under a tree and wait."},
        {"zh": "它一步步朝我走来。", "en": "It comes toward me step by step."},
        {"zh": "它看见我了。", "en": "It sees me."},
        {"zh": "它停下了脚。", "en": "It stops."},
        {"zh": "我抬手示意停下。", "en": "I raise a hand to halt."},
        {"zh": "掌心朝外摊开。", "en": "Palm out."},
        {"zh": "它没有动手。", "en": "It does not strike."},
        {"zh": "它绕了开去。", "en": "It goes around."},
        {"zh": "我看着它走远。", "en": "I watch it go."},
        {"zh": "我留在原地不动。", "en": "I do not follow."},
        {"zh": "它是往林子外面去的。", "en": "It is heading out of the wood."},
        {"zh": "这样便足够了。", "en": "This is enough."},
        {"zh": "我转身往回走。", "en": "I turn back."},
        {"zh": "林子里还有别的地方要巡。", "en": "There are other places to patrol."},
        {"zh": "我在它侧后跟着。", "en": "I keep at its back quarter."},
        {"zh": "它没有回头看。", "en": "It does not look back."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "它朝我扑过来了。", "en": "It lunges."},
        {"zh": "我斜过身避开。", "en": "I angle out of the way."},
        {"zh": "顺手打了它一下。", "en": "And strike it in passing."},
        {"zh": "它退回原处。", "en": "It falls back."},
        {"zh": "我不追出林子。", "en": "I do not chase beyond the wood."},
        {"zh": "它又扑了上来。", "en": "It lunges again."},
        {"zh": "这次我抬手挡住。", "en": "This time I block with an arm."},
        {"zh": "我再打它一下。", "en": "And strike again."},
        {"zh": "它站不稳了。", "en": "It loses its footing."},
        {"zh": "我往后退开。", "en": "I step back."},
        {"zh": "给它走的机会。", "en": "To give it a chance to leave."},
        {"zh": "它看着林子的出口。", "en": "It looks at the way out."},
        {"zh": "我指了指那个方向。", "en": "I point that way."},
        {"zh": "它领会了意思。", "en": "It caught my meaning."},
        {"zh": "它转身跑了。", "en": "And runs."},
        {"zh": "我缓缓垂下手。", "en": "I let my hand fall."},
        {"zh": "地上有一点血。", "en": "A little blood on the ground."},
        {"zh": "这血不是我的。", "en": "The blood is not mine."},
        {"zh": "我接着巡下去。", "en": "I go on with the patrol."},
        {"zh": "我把手收住了。", "en": "I stop myself."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这片林子里醒过来。", "en": "I wake in this wood."},
        {"zh": "天刚刚亮起来。", "en": "Just after dawn."},
        {"zh": "树叶上都是水。", "en": "Water on every leaf."},
        {"zh": "我站起来，拍了拍身上。", "en": "I stand and brush myself down."},
        {"zh": "林子比我记得的要静。", "en": "The wood is quieter than I remember."},
        {"zh": "我沿着老路走了一圈。", "en": "I walk a circuit of the old paths."},
        {"zh": "那些小路还在。", "en": "The paths are still there."},
        {"zh": "有几处已经塌了。", "en": "A few have fallen in."},
        {"zh": "我把它们记下来。", "en": "I have noted them."},
        {"zh": "回头再来修。", "en": "I will mend them later."},
        {"zh": "现在先看看有没有别人来。", "en": "For now, see if anyone has come."},
        {"zh": "我走到林子的边上。", "en": "I walk to the wood's edge."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的袖子，我拍了两下才灭。", "en": "Fire catches my sleeve; two slaps put it out."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上摔下来，落地时侧身滚了一下。", "en": "I fall from a tree and roll on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进喉咙，我抓住树根往上挣。", "en": "Water floods my mouth; I claw up a root."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸响把我掀翻，我撞在树干上。", "en": "The blast throws me into a trunk."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿进我的肩膀。", "en": "An arrow drives into my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "邪光钉住我的手脚。", "en": "Foul light pins my hands and feet."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "三天没吃东西，手有点抖。", "en": "Three days without food and my hands tremble."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我整条手臂都麻了。", "en": "Lightning strikes and my whole arm goes numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "地面没了，我在黑里往下坠。", "en": "The ground is gone and I fall through black."}
      ]
    }
  }
}
