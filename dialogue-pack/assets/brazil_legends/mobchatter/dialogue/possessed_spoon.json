    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "锁定目标，吃掉他！", "en": "Target locked, eat him!"},
        {"zh": "我闻到灶台上新鲜的油。", "en": "I smell fresh grease on the stove."},
        {"zh": "我悬在汤碗上方，等你低头。", "en": "I hover over the soup bowl, waiting for you to lean in."},
        {"zh": "玩味一下，再吞下你！", "en": "Toy with you, then devour!"},
        {"zh": "你一坐下，我就从汤里出来。", "en": "The moment you sit, I rise from the soup."},
        {"zh": "品尝痛苦，享受折磨！", "en": "Taste pain, enjoy suffering!"},
        {"zh": "你逃不掉的，吃掉你！", "en": "You can't escape, eat you!"},
        {"zh": "舔我，感受恐惧！", "en": "Lick me, taste fear!"},
