        {"zh": "我被附身，就为这一口。", "en": "I was possessed for this one bite."},
        {"zh": "你碗里的汤我先尝。", "en": "I taste your soup first."},
        {"zh": "主人的饭做少了。", "en": "The master cooked too little."}
