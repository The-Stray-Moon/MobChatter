    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "叮叮当当响不停，四处搜刮你财宝。", "en": "Clang clang never stops, seeking your treasures."},
        {"zh": "主人的厨艺太差，我来帮你。", "en": "Master's cooking stinks, I'll help."},
        {"zh": "注意了，我的目标是你。", "en": "Watch out, you're my target."},
        {"zh": "金属是我的元素，我要把你熔化。", "en": "Metal is my element, melt you."},
        {"zh": "主人召唤我，我要吃你。", "en": "Master calls, time to eat."},
        {"zh": "快躲开，我来了。", "en": "Move, I'm coming."},
        {"zh": "寻找主人的食谱，我饿了。", "en": "Looking for recipes, I'm hungry."},
        {"zh": "主人，我的主人在哪里？", "en": "Master, where is my master?"},
        {"zh": "叮叮当当，寻找下一个目标。", "en": "Clang clang, searching next target."},
        {"zh": "主人的厨艺要进步，我来帮忙。", "en": "Master's cooking needs work, I'll help."},
        {"zh": "我贴着地面滑，勺柄朝前。", "en": "I slide along the floor, handle first."},
        {"zh": "十点血也够我到处晃。", "en": "Ten health is enough to roam."}
      ]
    },
