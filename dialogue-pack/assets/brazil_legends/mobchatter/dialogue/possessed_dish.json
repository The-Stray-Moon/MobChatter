        {"zh": "我是盘子，也是战士！", "en": "I'm a dish, I'm a warrior!"},
        {"zh": "我在地砖上一颠一颠地滚。", "en": "I bump and roll across the tiles."},
        {"zh": "我只会保护我的主人！", "en": "I protect my master!"},
        {"zh": "瓷边一路磕着地", "en": "My porcelain rim knocks along the ground."},
        {"zh": "嗡嗡滚下石阶", "en": "I buzz down the stone steps."}
      ]
    },
