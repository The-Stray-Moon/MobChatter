    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咔嚓咔嚓，我是被附身的盘子！", "en": "Click click, I'm the possessed dish!"},
        {"zh": "小心，别被我切到！", "en": "Be careful, or I'll cut you!"},
        {"zh": "叮当作响，我的主人让我来对付你！", "en": "Tinkle, my master sent me to get you!"},
