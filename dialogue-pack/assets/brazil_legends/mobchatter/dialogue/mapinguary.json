{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "踏着雪地咯吱作响", "en": "Crunching snow underfoot"},
        {"zh": "缓缓挪动冰封身躯", "en": "Moving slowly, icy body"},
        {"zh": "轻盈地滑过雪地", "en": "Sliding gracefully over snow"},
        {"zh": "踏出一串雪爪印", "en": "Leaving snowshoe prints"},
        {"zh": "寒风中踏雪前行", "en": "Moving through snow in chill wind"},
        {"zh": "在雪地留下一串足迹", "en": "Leaving footprints in the snow"},
        {"zh": "脚步声在寂静中回响", "en": "Footsteps echo in silence"},
        {"zh": "轻盈掠过雪地", "en": "Passing over snow lightly"},
        {"zh": "雪中留下浅浅爪印", "en": "Leaves shallow prints in the snow"},
        {"zh": "雪地里无声前行", "en": "Moving silently in the snow"},
        {"zh": "踩碎薄冰，低头嗅着地面。", "en": "I break thin ice and sniff the ground."},
        {"zh": "厚毛上挂着霜，一步一晃。", "en": "Frost clings to my thick fur; I sway with each step."},
        {"zh": "绕过松树，爪子陷进雪里。", "en": "I go around a pine, claws sinking into snow."},
        {"zh": "呼出的白气拖在身后。", "en": "My breath trails white behind me."},
        {"zh": "沿着冰脊缓缓下坡。", "en": "I descend slowly along the ice ridge."},
        {"zh": "在针叶林间挪动庞大的身躯。", "en": "I move my bulk through the conifer forest."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在雪里，像一块黑岩。", "en": "I stand in the snow like a black boulder."},
        {"zh": "享受寒冷的空气", "en": "Basking in the cold"},
        {"zh": "松枝上的雪，落在我鼻尖。", "en": "Snow from the pine bough lands on my nose."},
        {"zh": "我在雪里蹭背，霜掉了一层。", "en": "I rub my back in the snow; a layer of frost falls."},
        {"zh": "享受冬日的宁静", "en": "Relishing the winter calm"},
        {"zh": "冷地方的毛厚，伸展都慢。", "en": "Thick fur from the cold — even stretching is slow."},
        {"zh": "静静地咀嚼着食物", "en": "Chewing quietly"},
        {"zh": "风声里只有我一个呼吸。", "en": "Only my breathing joins the wind."},
        {"zh": "在雪中慢慢打转", "en": "Spinning slowly in snow"},
        {"zh": "冰面下有条鱼，我听着。", "en": "I listen to a fish under the ice."},
        {"zh": "靠着松树，把背上的雪抖落。", "en": "Against a pine, I shake the snow off my back."},
        {"zh": "张嘴接住飘下的雪花。", "en": "I open my mouth to catch falling snow."},
        {"zh": "趴进雪堆，只露出背脊。", "en": "I flop into a drift with only my back showing."},
        {"zh": "用爪子慢慢梳理厚毛。", "en": "I comb my thick fur with a claw."},
        {"zh": "听着冰面下细微的裂响。", "en": "I listen to the small cracks under the ice."},
        {"zh": "打了个哈欠，白气散开。", "en": "I yawn, and my breath spreads white."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "目光转向你", "en": "Eyes on you"},
        {"zh": "冰刺平原的冷风先替我闻你。", "en": "The cold wind off the ice spikes smells you first."},
        {"zh": "朝向玩家瞥了一眼", "en": "Glanced at the player"},
        {"zh": "冷风把你的气味送过来。", "en": "The cold wind brings your scent to me."},
        {"zh": "针叶林这么冷，我照样走。", "en": "The pine forest is cold, and I keep walking."},
        {"zh": "我从松枝后看你抬脚。", "en": "From behind a pine bough I watch you lift a foot."},
        {"zh": "冷地方的毛更厚，也更凶。", "en": "Cold places grow thicker fur. And temper."},
        {"zh": "注意到了你的举动", "en": "Noticing your actions"},
        {"zh": "眼神中露出警觉", "en": "Alert eyes"},
        {"zh": "静静地注视着你", "en": "Eyes fixed on you"},
        {"zh": "从松枝后抬起眼。", "en": "I raise my eyes from behind a pine bough."},
        {"zh": "鼻翼动了动，气味不对。", "en": "My nostrils twitch; the scent is wrong."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身体冻得直打颤。", "en": "Shivering from the cold."},
        {"zh": "耳朵被冻得耷拉下来。", "en": "Ears droop from the cold."},
        {"zh": "鼻子里呼出白气。", "en": "Breathing out steam."},
        {"zh": "浑身裹着厚厚的毛。", "en": "Thick fur covers its body."},
        {"zh": "眼睛里透出寒光。", "en": "Cold glint in its eyes."},
        {"zh": "缓慢挪动着沉重的身躯。", "en": "Slowly moving heavy body."},
        {"zh": "四肢在雪地里留下痕迹。", "en": "Leaves marks in the snow."},
        {"zh": "耳朵冻得通红。", "en": "Ears are red from the cold."},
        {"zh": "瑟缩着身体取暖。", "en": "Curling up to warm up."},
        {"zh": "喘息声中带着寒意。", "en": "Breathing with cold in it."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "胡萝卜的甜味，混在霜里。", "en": "The sweetness of carrots mixes with the frost."},
        {"zh": "我闻到了美味的胡萝卜！", "en": "I can smell the delicious carrots!"},
        {"zh": "那边的胡萝卜堆真大啊！", "en": "Such a big pile of carrots over there!"},
        {"zh": "快给它胡萝卜，它会听话的！", "en": "Give it a carrot and it will listen!"},
        {"zh": "雪下的草根，嚼起来是甜的。", "en": "The roots under the snow taste sweet."},
        {"zh": "吃胡萝卜可以暖暖肚子！", "en": "Eating carrots warms my belly!"},
        {"zh": "来吧，分享你的胡萝卜！", "en": "Come on, share your carrot!"},
        {"zh": "这地上的胡萝卜真好吃！", "en": "The carrots on the ground are tasty!"},
        {"zh": "胡萝卜是我的最爱！", "en": "Carrots are my favorite!"},
        {"zh": "吃胡萝卜可以抵御寒冷！", "en": "Eating carrots fights the cold!"},
        {"zh": "你手里的东西闻着像松果。", "en": "What you hold smells like pinecones."},
        {"zh": "跟着你，也许有得吃。", "en": "Following you might mean food."},
        {"zh": "你踩开的雪下有草根。", "en": "Under the snow you kicked loose, there are roots."},
        {"zh": "别走，我还能再吃一点。", "en": "Don't go; I could eat a little more."},
        {"zh": "你身上的味道不刺鼻。", "en": "Your scent is not harsh."},
        {"zh": "你口袋鼓着，我不急着走。", "en": "Your pocket bulges; I am in no hurry."}
      ]
    },
