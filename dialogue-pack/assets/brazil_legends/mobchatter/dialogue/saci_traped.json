  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用指甲刮着瓶底。", "en": "I scrape the bottle bottom with a nail."},
        {"zh": "啃食草根", "en": "Chews on roots"},
        {"zh": "困在瓶子里的我，只能看。", "en": "Bottled as I am, I can only watch."},
        {"zh": "用小手摸索", "en": "Pokes with tiny hands"},
        {"zh": "舔舔被束缚的手腕", "en": "Licks bound wrist"},
        {"zh": "小心地移动", "en": "Cautiously moves"},
        {"zh": "四处嗅探", "en": "Sniffs around"},
        {"zh": "我在瓶里转圈，撞玻璃。", "en": "I circle inside, bumping the glass."},
        {"zh": "啃食树叶", "en": "Chews leaves"},
        {"zh": "轻轻跳跃", "en": "Gently hops"},
        {"zh": "单腿跳了两下，摔回瓶底。", "en": "One hop, two, and I fall back to the bottle floor."},
        {"zh": "红帽子歪着，跳不起来。", "en": "My red cap is crooked and I cannot hop."},
        {"zh": "转个身，风都带不起来。", "en": "I spin, but no whirlwind comes."},
        {"zh": "在瓶壁上蹭了蹭背。", "en": "I rub my back along the glass."},
        {"zh": "抓着瓶口的绳子晃。", "en": "I swing on the string at the bottle's mouth."},
        {"zh": "数着瓶底的草根挪过去。", "en": "I count the roots on the bottle floor and shuffle over."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蜷在瓶角，屏住呼吸。", "en": "I curl in the corner and hold my breath."},
        {"zh": "瓶子里太窄，我转不开身。", "en": "The bottle is too narrow to turn around in."},
        {"zh": "瓶口太小，我出不去。", "en": "The bottle's mouth is too narrow."},
        {"zh": "舔着受伤的手腕", "en": "Tongues injured wrist"},
        {"zh": "瓶口透进来一点光", "en": "A little light comes in through the bottle's mouth"},
        {"zh": "轻轻摇晃身体", "en": "Shakes body gently"},
        {"zh": "低头吃草", "en": "Bends down to eat"},
        {"zh": "舔舔嘴巴", "en": "Licks lips"},
        {"zh": "轻声哼唱", "en": "Sings softly"},
        {"zh": "抱着那顶红帽子发呆。", "en": "I hug my red cap and stare."},
        {"zh": "听瓶外的风转了一圈。", "en": "I listen to the wind circle outside."},
        {"zh": "把烟斗倒过来敲了敲。", "en": "I knock my pipe upside down."},
        {"zh": "单腿撑久了，有点麻。", "en": "Standing on one leg goes numb after a while."},
        {"zh": "想编个辫子，没有风。", "en": "I would braid a whirlwind, but there is no wind."},
        {"zh": "朝瓶口喊了一声，回音。", "en": "I shout at the neck. Only an echo answers."},
        {"zh": "把脸贴在玻璃上看外面。", "en": "I press my face to the glass and look out."}
      ]
    },
