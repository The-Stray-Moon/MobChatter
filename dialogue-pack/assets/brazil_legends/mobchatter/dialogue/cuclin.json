{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜噜噜噜噜噜噜噜！", "en": "Gurgle gurgle gurgle gurgle!"},
        {"zh": "我的小肚肚饿了！", "en": "My tummy's hungry!"},
        {"zh": "跟上我，小家伙！", "en": "Follow me, little one!"},
        {"zh": "找点东西吃吧！", "en": "Get some food!"},
        {"zh": "咕噜，咕噜，咕噜！", "en": "Gurgle, gurgle, gurgle!"},
        {"zh": "别跑，小家伙！", "en": "Don't run, little one!"},
        {"zh": "我踩着库卡的脚印往前跑。", "en": "I run along Cuca's footprints."},
        {"zh": "这里！有吃的！", "en": "Here! There's food!"},
        {"zh": "快点，别磨蹭！", "en": "Hurry, don't dawdle!"},
        {"zh": "咕噜噜，脚底粘着泥！", "en": "Gururu, mud stuck to my feet!"},
        {"zh": "我跟着库卡走！", "en": "I walk where Cuca goes!"},
        {"zh": "咕噜，这条路我熟！", "en": "Gulu, I know this path!"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在库卡的门口，等她回来。", "en": "I crouch at Cuca's door, waiting for her."},
        {"zh": "库卡不在，我先守着。", "en": "Cuca's away; I'll hold the post."},
        {"zh": "安静点，别打扰我！", "en": "Be quiet, don't disturb me!"},
        {"zh": "我的食物在哪里？", "en": "Where's my food?"},
        {"zh": "谁碰我的耳朵，我就咬谁！", "en": "Whoever touches my ears gets bitten!"},
        {"zh": "咕噜，咕噜！", "en": "Gurgle, gurgle!"},
        {"zh": "库卡的咒语还没念完，我等着。", "en": "Cuca's spell is not finished; I wait."},
        {"zh": "库卡的影子还挂在墙上。", "en": "Cuca's shadow still hangs on the wall."},
        {"zh": "咕噜，风里有味道！", "en": "Gulu, there's a smell in the wind!"},
        {"zh": "我蹲着，别吵我！", "en": "I'm squatting, don't bother me!"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在这里！", "en": "You're here!"},
        {"zh": "别动，小家伙！", "en": "Don't move, little one!"},
        {"zh": "我躲进蕨叶，只露出尖牙。", "en": "I hide in the ferns with only my fangs showing."},
        {"zh": "咕噜咕噜", "en": "Gurgle gurgle! — Cuclin, look player"},
        {"zh": "过来陪我玩！", "en": "Come play with me!"},
        {"zh": "你动了，小家伙！", "en": "You moved, little one!"},
        {"zh": "咕噜，咕噜", "en": "Gurgle, gurgle! — Cuclin, look player"},
        {"zh": "我就躲在你身后的草里。", "en": "I hide in the grass right behind you."},
        {"zh": "你走不了！", "en": "You can't go!"},
        {"zh": "咕噜，你在看我？", "en": "Gulu, are you looking at me?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的耳朵被削掉一小块，呜。", "en": "A piece of my ear is sliced off, wailing."},
        {"zh": "啊！别碰我！", "en": "Ouch! Don't touch me!"},
        {"zh": "我抱着肚子滚到库卡脚边。", "en": "I clutch my belly and roll to Cuca's feet."},
        {"zh": "我跟着库卡跑腿。", "en": "I run errands for Cuca."},
        {"zh": "好痛，痛...", "en": "Ouch, ouch..."},
        {"zh": "快点！我受伤了！", "en": "Help! I'm hurt!"},
        {"zh": "呜呜，疼...", "en": "Aww, it hurts..."},
        {"zh": "我缩进树洞，咕噜声都哑了。", "en": "I shrink into a tree hollow, my gurgle hoarse."},
        {"zh": "我...我受伤了...", "en": "I'm... I'm hurt..."},
        {"zh": "咕噜，我的腿软了…", "en": "Gulu, my legs have gone weak..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜噜，猎物就在眼前！", "en": "Rumble, prey is near!"},
        {"zh": "别想逃！我的爪子很快！", "en": "No escape! My claws are quick!"},
        {"zh": "吃点小鱼吧，库卡的小伙伴！", "en": "Have some fish, my Kuka buddy!"},
        {"zh": "森林深处，我们的领地！", "en": "Deeper into the forest, our home!"},
        {"zh": "库卡说活肉最香，我信她。", "en": "Cuca says living meat tastes best; I believe her."},
        {"zh": "跟我回家，尝尝库卡的爱！", "en": "Come home, taste Kuka's love!"},
        {"zh": "用你的心，感受我的亲近！", "en": "Feel my closeness with your heart!"},
        {"zh": "一起分享食物，库卡的友伴！", "en": "Share the food, Kuka's companion!"},
        {"zh": "森林之王，我永远跟随！", "en": "Forest king, I follow forever!"},
        {"zh": "战斗中，我最强大的！", "en": "In battle, I'm the strongest!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我咕噜一声，爪子先扑过去。", "en": "I gurgle and lunge with my claws first."},
        {"zh": "让我穿过，库卡的信号！", "en": "Let me through, Kuka's signal!"},
        {"zh": "别靠近我，小心我的爪子！", "en": "Stay back, beware my claws!"},
        {"zh": "我的角，可以顶你！", "en": "My horns, they can gore you!"},
        {"zh": "互相碰撞，证明实力！", "en": "Collide to prove your strength!"},
        {"zh": "用你的力量，挑战我吧！", "en": "Challenge me with your strength!"},
        {"zh": "我们比比，看谁更强！", "en": "Let's see who's the stronger!"},
        {"zh": "我的速度，无人能敌！", "en": "My speed, none can match!"},
        {"zh": "碰撞中，展现真正的自己！", "en": "Show yourself in the collision!"},
        {"zh": "谁更强，看这一击！", "en": "Who's stronger, let's clash!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "库卡的手下也想成个家。", "en": "Even Cuca's minion wants a home."},
        {"zh": "库卡的小宝贝，未来希望！", "en": "Kuka's little ones, future hope!"},
        {"zh": "用声音，召唤伴侣！", "en": "Call your mate with sound!"},
        {"zh": "交配时刻，库卡的荣幸！", "en": "Mating time, Kuka's honor!"},
        {"zh": "我的声音，吸引你的注意！", "en": "My voice, catch your eye!"},
        {"zh": "库卡的宝宝，未来继承人！", "en": "Kuka's babies, future heirs!"},
        {"zh": "用叫声，表达爱意！", "en": "Call out love in sound!"},
        {"zh": "库卡的后代，未来希望！", "en": "Kuka's offspring, future hope!"},
        {"zh": "交配后，更强的力量！", "en": "After mating, greater strength!"},
        {"zh": "库卡的伴侣，永恒的伙伴！", "en": "Kuka's partner, eternal comrade!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜噜，好饿！", "en": "Rumble, so hungry!"},
        {"zh": "我把半只虫子塞进嘴里嚼。", "en": "I stuff half a bug into my mouth and chew."},
        {"zh": "咕噜咕噜，肚子叫！", "en": "Gurgle, gurgle, stomach rumbling!"},
        {"zh": "我要吃东西了！", "en": "I'm hungry, I'm hungry!"},
        {"zh": "这里肯定有吃的！", "en": "There's gotta be food here!"},
        {"zh": "咕噜咕噜，我要找吃的！", "en": "Gurgle, gurgle, I'm hungry!"},
        {"zh": "这块腐肉的气味让我打滚。", "en": "The smell of this carrion makes me roll on the ground."},
        {"zh": "我抓着你的裤腿，咕噜着讨吃。", "en": "I grab your trouser leg and gurgle for food."},
        {"zh": "咕噜咕噜，快点！", "en": "Gurgle, hurry!"},
        {"zh": "食物在哪里？！", "en": "Where's the food?!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "库卡让我盯住你。", "en": "Cuca told me to watch you."},
        {"zh": "我来了，快跑！", "en": "Here I come, run!"},
        {"zh": "库卡走到哪，我跟到哪。", "en": "Where Cuclá goes, I follow."},
        {"zh": "我压低身子，后腿刨着土。", "en": "I lower myself and paw at the dirt with my hind legs."},
        {"zh": "目标锁定，攻击！", "en": "Target locked, attack!"},
        {"zh": "玩家，我要吃了你！", "en": "Player, I'm coming for you!"},
        {"zh": "我的尖牙对准你的小腿肚。", "en": "My fangs aim at your calf."},
        {"zh": "玩家，我要抓你！", "en": "Player, I'm coming for you!"},
        {"zh": "攻击模式启动！", "en": "Attack mode engaged!"},
        {"zh": "锁定玩家，靠近攻击！", "en": "Player locked, closing in to attack!"},
        {"zh": "咕噜，我闻到你了！", "en": "Gulu, I smell you!"},
        {"zh": "小家伙，站住！", "en": "Little one, stand still!"},
        {"zh": "库卡说，可以动手！", "en": "Cuca says I may start!"},
        {"zh": "咕噜噜，今天有肉！", "en": "Gururu, meat today!"},
        {"zh": "你跑，我更快！", "en": "Run, and I'm still faster!"},
        {"zh": "咕噜，我的牙齿痒！", "en": "Gulu, my teeth itch!"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "紧盯着目标！", "en": "Fixing on target!"},
        {"zh": "库卡的影子下，我扑上来。", "en": "From Kuka's shadow, I lunge."},
        {"zh": "目标在我的视线里！", "en": "Target in sight!"},
        {"zh": "我数着你抬脚的间隙，咕噜。", "en": "I count the gaps between your steps, gurgle."},
        {"zh": "库卡的手下，专挑落单的。", "en": "Cuca's minion picks off stragglers."},
        {"zh": "我数着你的步子，咕噜，咕噜。", "en": "I count your steps, gurgle, gurgle."},
        {"zh": "目标锁定，不会错过！", "en": "Target locked, won't miss!"},
        {"zh": "库卡的手势一落，我扑出去。", "en": "Cuca's hand drops, and I spring out."},
        {"zh": "锁定玩家，攻击！", "en": "Targeting player, attack!"},
        {"zh": "瞄准目标，攻击！", "en": "Targeting, attack!"},
        {"zh": "我盯住你的腿了！", "en": "I've got my eye on your legs!"},
        {"zh": "咕噜，就等这一下！", "en": "Gulu, just waiting for this one!"},
        {"zh": "我从这边扑过去！", "en": "I'll pounce from this side!"},
        {"zh": "你转身，我就咬！", "en": "Turn around and I bite!"},
        {"zh": "咕噜噜，别躲了！", "en": "Gururu, stop hiding!"},
        {"zh": "我的爪子已经张开！", "en": "My claws are already spread!"},
        {"zh": "你退到墙边了，咕噜！", "en": "You've backed to the wall, gulu!"},
        {"zh": "我先咬，再问！", "en": "I bite first, ask later!"},
        {"zh": "咕噜，你喘得真响！", "en": "Gulu, you breathe so loud!"},
        {"zh": "一步，就一步！", "en": "One step, just one step!"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
