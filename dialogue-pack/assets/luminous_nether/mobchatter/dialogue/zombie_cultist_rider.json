{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉的骑手，还是要冲锋。", "en": "A rider of rotten flesh still charges."},
        {"zh": "腐肉的味道，真美妙！", "en": "Delicious flesh smell!"},
        {"zh": "真菌平原，我们的家园！", "en": "Mushroom Plains, our home!"},
        {"zh": "我的坐骑，强壮且敏捷！", "en": "My mount, strong and swift!"},
        {"zh": "腐烂的肉，我的盛宴！", "en": "Rotten meat, my feast!"},
        {"zh": "猎杀那些弱小的旅人！", "en": "Hunt the weak travelers!"},
        {"zh": "我的皮肤，坚不可摧！", "en": "My skin, indestructible!"},
        {"zh": "邪教的秘密，藏于腐土！", "en": "Cult secrets, in the slime!"},
        {"zh": "饥饿的嚎叫，我的本能！", "en": "Ravenous howl, my instinct!"},
        {"zh": "腐肉与鲜血，我们的粮食！", "en": "Flesh and blood, our food!"},
        {"zh": "驱着坐骑踏过菌毯", "en": "I drive my mount across the fungal mat."},
        {"zh": "缰绳一扯，转向东边", "en": "A tug of the reins turns us east."},
        {"zh": "坐骑的蹄子踩碎蘑菇", "en": "My mount's hooves crush the mushrooms."},
        {"zh": "旗子挂在鞍边晃着", "en": "The banner sways from my saddle."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的存在，即是恐惧！", "en": "Fear me!"},
        {"zh": "等待猎物，耐心最重要！", "en": "Patience, the key!"},
        {"zh": "邪教的誓言，永生不死！", "en": "Cult vow, eternal life!"},
        {"zh": "腐肉的味道，永不停歇！", "en": "Never-ending flesh smell!"},
        {"zh": "我的皮肤，不再有疼痛！", "en": "My skin, no pain!"},
        {"zh": "邪教之子，永不倒下！", "en": "Cult son, never fall!"},
        {"zh": "等待时机，一击必杀！", "en": "Wait for the chance, one hit kill!"},
        {"zh": "腐肉的诱惑，无法抗拒！", "en": "Flesh temptation, irresistible!"},
        {"zh": "我的力量，源自腐土！", "en": "My strength, from the slime!"},
        {"zh": "邪教的信仰，永远燃烧！", "en": "Cult faith, forever burning!"},
        {"zh": "在菌伞下低着头", "en": "I bow my head under a fungal cap."},
        {"zh": "坐骑刨着脚边的土", "en": "My mount scrapes the dirt."},
        {"zh": "用腐肉喂手里的兽", "en": "I feed the beast in my hand carrion."},
        {"zh": "数着祭坛上的骨头", "en": "I count the bones on the altar."},
        {"zh": "把旗子插在地上歇息", "en": "I plant the banner and rest."},
        {"zh": "喉咙里念着含混的词", "en": "Muddled words mutter in my throat."},
        {"zh": "等人送来下一批肉", "en": "I wait for the next batch of meat."},
        {"zh": "任坐骑舔我的靴子", "en": "I let my mount lick my boot."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你，我的猎物！", "en": "You, my prey!"},
        {"zh": "我的眼睛，洞察一切！", "en": "My eyes, see all!"},
        {"zh": "恐惧吧，人类！", "en": "Fear, human!"},
        {"zh": "我的目光，让你颤抖！", "en": "My gaze, makes you tremble!"},
        {"zh": "你躲不开，我的追捕！", "en": "You can't escape, my hunt!"},
        {"zh": "我的武器，致命的镰刀！", "en": "My weapon, the deadly scythe!"},
        {"zh": "死亡的阴影，笼罩你！", "en": "Death's shadow, over you!"},
        {"zh": "你的命运，今天结束！", "en": "Your fate, today ends!"},
        {"zh": "你的灵魂，属于我！", "en": "Your soul, mine!"},
        {"zh": "恐惧与死亡，你选哪个？", "en": "Fear or death, which one?"},
        {"zh": "从菌伞阴影里望你", "en": "I watch you from the fungus shade."},
        {"zh": "把旗子转向你这边", "en": "I turn the banner toward you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "肌肉在颤抖，我感到害怕。", "en": "Muscles tremble, fear grips me."},
        {"zh": "我感受到生命离我而去。", "en": "Life is slipping away from me."},
        {"zh": "血肉模糊，疼痛难忍。", "en": "Gore and agony fill my body."},
        {"zh": "腐肉在流血，伤口很深。", "en": "Wounds bleed through the flesh."},
        {"zh": "嘶嘶声中，我几乎要坚持不住。", "en": "Hisssss, nearly give in."},
        {"zh": "伤口渗出腐烂的血。", "en": "Wounds ooze rotten blood."},
        {"zh": "疣猪兽跑了，我摔下来。", "en": "My hog bolted; I fell off."},
        {"zh": "疼痛让我无法忍受。", "en": "Pain is unbearable."},
        {"zh": "伤口感染，我快不行了。", "en": "Infection sets in, I'm done."},
        {"zh": "我快不行了，求求你。", "en": "I'm dying, please help."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到腐肉，缰绳拉不住。", "en": "I smell carrion; the reins can't hold me."},
        {"zh": "腐肉的香气，太诱人了。", "en": "The smell of rotten flesh is too tempting."},
        {"zh": "食腐肉，这是命！", "en": "Eat the rotten flesh, it's a matter of life."},
        {"zh": "菌原平原，我的领地。", "en": "Mushroom fields, my territory."},
        {"zh": "疣猪兽，我的坐骑！", "en": "Warhog, my mount!"},
        {"zh": "骑乘，是力量的象征。", "en": "Riding is a symbol of power."},
        {"zh": "疣猪兽一停，我就伸手去够。", "en": "My hoglin halts and I reach for it."},
        {"zh": "别想逃，菌原平原！", "en": "No escape, in the mushroom fields!"},
        {"zh": "驯服我？门儿都没有。", "en": "Tame me? No way."},
        {"zh": "腐肉的美味，难以抗拒。", "en": "The taste of the rotten flesh is irresistible."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "砰！撞上了！", "en": "Bang! Collided!"},
        {"zh": "菌原平原的震动！", "en": "Mushroom fields shake!"},
        {"zh": "疣猪兽，注意！", "en": "Warhog, watch out!"},
        {"zh": "碰撞，是我的本能。", "en": "Collision is my instinct."},
        {"zh": "撞飞你，很简单。", "en": "Sending you flying is easy."},
        {"zh": "菌原平原的震动，就是我的存在。", "en": "The shake of the mushroom fields is my presence."},
        {"zh": "别靠近，否则被撞飞。", "en": "Stay back, or you'll be sent flying."},
        {"zh": "撞上你，我的荣幸。", "en": "To collide with you, an honor."},
        {"zh": "疣猪兽，用力一撞。", "en": "Warhog, give it a good shove."},
        {"zh": "菌原平原的碰撞，无处不在。", "en": "Collisions in the mushroom fields are everywhere."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到配偶，很不容易。", "en": "Finding a mate is hard."},
        {"zh": "菌原平原的夜晚，才是我们的时刻。", "en": "The night in the mushroom fields is ours."},
        {"zh": "疣猪兽，跟我战斗。", "en": "Warhog, fight with me."},
        {"zh": "我们，是菌原平原的主宰。", "en": "We are the rulers of the mushroom fields."},
        {"zh": "找到伴侣，才能繁衍。", "en": "Find a partner to reproduce."},
        {"zh": "菌原平原的夜晚，才是真正的开始。", "en": "The night in the mushroom fields is the real beginning."},
        {"zh": "疣猪兽，我的战斗伙伴。", "en": "Warhog, my battle companion."},
        {"zh": "找到配偶，才能延续。", "en": "Find a mate to continue."},
        {"zh": "夜晚来临，开始求偶。", "en": "Nightfall, time for courtship."},
        {"zh": "菌原平原的夜晚，充满激情。", "en": "The night in the mushroom fields is passionate."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "骑着疣猪兽，嘶嘶作响。", "en": "Rides a wart pig, hisses."},
        {"zh": "腐肉和肉，都归我。", "en": "Spoiled meat and flesh, mine."},
        {"zh": "真菌平原上，我是王。", "en": "King of the mushroom fields."},
        {"zh": "腐肉堆里，找块好鞍。", "en": "Spoiled flesh, find a saddle."},
        {"zh": "疣猪兽是我的坐骑。", "en": "Wart pig is my mount."},
        {"zh": "顺手捞起鞍边的腐肉。", "en": "I scoop up the carrion by my saddle."},
        {"zh": "啃食腐肉，补充力量。", "en": "Eats spoiled flesh, gains strength."},
        {"zh": "真菌平原，我的家。", "en": "Mushroom fields, my home."},
        {"zh": "骑手，就是我要的。", "en": "Rider, that's what I want."},
        {"zh": "猎杀入侵者，保护领地。", "en": "Hunts invaders, protects territory."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物来了，紧盯着。", "en": "Prey approaches, eyes on it."},
        {"zh": "腐肉味，引诱着。", "en": "Spoiled flesh, lure."},
        {"zh": "猎物的味道，真香。", "en": "Prey's scent, so good."},
        {"zh": "猎物出现，准备出击。", "en": "Prey appears, ready to attack."},
        {"zh": "入侵者，给我尝尝。", "en": "Invaders, taste this."},
        {"zh": "真菌平原上，腐肉喂着我的坐骑。", "en": "On the fungal plain, rotten flesh feeds my mount."},
        {"zh": "猎物逃不掉，已被锁定。", "en": "Prey has nowhere to run, locked."},
        {"zh": "目标就在眼前，准备吞食。", "en": "Target in sight, ready to eat."},
        {"zh": "猎杀目标，满足欲望。", "en": "Kills target, satisfies."},
        {"zh": "坐骑狂奔，目标就在前。", "en": "Mount charges, target in sight."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物的喉咙，我的目标。", "en": "Target is the prey's throat."},
        {"zh": "瞄准喉咙，一击毙命。", "en": "Target the throat, one shot kill."},
        {"zh": "猎物的脖子，是我的靶子。", "en": "Target is the prey's neck."},
        {"zh": "瞄准目标，精准致命。", "en": "Targeted shot, deadly."},
        {"zh": "猎物的头部，我的射击点。", "en": "Target is the prey's head."},
        {"zh": "腐肉味的骑手，只瞄你的头。", "en": "A rotten-smelling rider aims only at your head."},
        {"zh": "猎物的弱点，我的目标。", "en": "Target is the prey's weakness."},
        {"zh": "瞄准弱点，一箭双穿。", "en": "Target the weak spot, double pierce."},
        {"zh": "猎物的心脏，我的靶心。", "en": "Target is the prey's heart."},
        {"zh": "瞄准心脏，致命一刻。", "en": "Target the heart, lethal."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "挥舞着腐朽长矛！", "en": "Swinging a rotten spear!"},
        {"zh": "嘶嘶地咬向敌人！", "en": "Snarling bite at the enemy!"},
        {"zh": "挥刀砍向对手！", "en": "Swinging the cleaver!"},
        {"zh": "挥舞锈蚀铁剑！", "en": "Swinging the rusted sword!"},
        {"zh": "咆哮着挥舞武器！", "en": "Roaring with weapon!"},
        {"zh": "用尖牙撕裂肉体！", "en": "Tearing flesh with teeth!"},
        {"zh": "嘶叫着冲向前方！", "en": "Snarling charge!"},
        {"zh": "挥舞着扭曲的刀片！", "en": "Swinging the twisted blade!"},
        {"zh": "用武器撕开敌人的喉咙！", "en": "Slicing the enemy's throat!"},
        {"zh": "发出野兽般的怒吼！", "en": "Roaring like a beast!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "从腐土中诞生！", "en": "Rising from the fungi!"},
        {"zh": "从真菌平原中出现！", "en": "Emerging from the plains!"},
        {"zh": "从地下深处涌出！", "en": "Rising from below!"},
        {"zh": "从裂开的大地中出现！", "en": "Emerging from the fissure!"},
        {"zh": "从地下洞穴中涌出！", "en": "Rushing from the cave!"},
        {"zh": "从真菌的怀抱中现身！", "en": "Appearing from the fungi!"},
        {"zh": "坐骑从菌林里踱出来。", "en": "My mount steps out of the fungal wood."},
        {"zh": "从腐烂的土壤中诞生！", "en": "Rising from the decay!"},
        {"zh": "从地表裂缝中冒出！", "en": "Emerging from the ground crack!"},
        {"zh": "从地下涌出的邪教徒！", "en": "Zombified cultist from underground!"},
        {"zh": "孢子落地，我从土里站起", "en": "Spores fall and I stand from the soil."},
        {"zh": "坐骑从菌林里踱出来", "en": "My mount paces out of the fungal wood."},
        {"zh": "祭坛边多了一个骑手", "en": "One more rider at the altar."},
        {"zh": "菌原上响起了鼓声", "en": "A drum begins on the fungal plain."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎坐骑的毛，也燎我的脸。", "en": "Fire sears my mount's hide and my face alike."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "坠地的冲击，剧痛无比。", "en": "Fall impact, excruciating pain."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浸透了我的皮肤。", "en": "Water soaks my skin."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸的冲击波撕裂了我的身体。", "en": "Explosion tears through my body."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿鞍皮，扎进疣猪兽背。", "en": "The arrow pierces my saddle and my beast's back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法的力量将我撕裂。", "en": "Magic tears me apart."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿感如影随形。", "en": "Hunger haunts me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在鞍上，坐骑惊了。", "en": "Lightning strikes my saddle; my mount panics."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空中的寒冷让我难以忍受。", "en": "Void's cold sears me."}
      ]
    }
  }
}
