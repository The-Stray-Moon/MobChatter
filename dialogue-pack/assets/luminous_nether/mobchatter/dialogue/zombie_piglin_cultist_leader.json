  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "烂了半边脸，旗帜我还举着。", "en": "Half my face rotted, yet I hold the banner."},
        {"zh": "腐肉味引诱着我。", "en": "The stench of flesh draws me."},
        {"zh": "这土地是我的。", "en": "This soil is mine."},
        {"zh": "我拄着旗杆，踩过紫泥。", "en": "I lean on my banner and wade the purple muck."},
        {"zh": "邪教徒的旗帜随风飘。", "en": "The cultist banner flutters in the breeze."},
        {"zh": "腐化的力量在增强。", "en": "Corruption grows stronger."},
        {"zh": "饥饿的召唤。", "en": "The call of hunger."},
        {"zh": "跟随我的命令。", "en": "Follow my command."},
        {"zh": "腐肉，我的食物。", "en": "Flesh, my food."},
        {"zh": "邪教徒之魂。", "en": "Cultist souls."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "沉思中...腐化永恒。", "en": "Musing... corruption endures."},
        {"zh": "腐肉味淡了，我还在等。", "en": "The rotten smell faded; I am still waiting."},
        {"zh": "邪教徒之歌。", "en": "Cultist's song."},
        {"zh": "腐化之息。", "en": "Corruption's breath."},
        {"zh": "冥想中的邪教徒。", "en": "Cultist in meditation."},
        {"zh": "寂静中的等待。", "en": "Silent wait."},
        {"zh": "腐化的低语。", "en": "Whispers of corruption."},
        {"zh": "邪教徒的祈祷。", "en": "Cultist's prayer."},
        {"zh": "灵魂的呼唤。", "en": "Soul's call."},
        {"zh": "腐化之主。", "en": "Master of corruption."},
        {"zh": "金粒在指缝里发烫。", "en": "Gold nuggets burn between my fingers."},
        {"zh": "真菌在肺里慢慢长。", "en": "Fungus grows slowly in my lungs."},
        {"zh": "旗帜垂着，等风来。", "en": "The banner hangs, waiting for wind."},
        {"zh": "腐肉吃完，还剩半块。", "en": "Half a piece of rotten flesh left."},
        {"zh": "我数着帐篷里的头骨。", "en": "I count the skulls in the tent."},
        {"zh": "猪鼻哼气，念完这段咒。", "en": "My snout snorts; the chant is done."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你，是我的猎物。", "en": "You, my prey."},
        {"zh": "你的血，是我的养分。", "en": "Your blood, my nourishment."},
        {"zh": "邪教徒的胜利。", "en": "Cultist's victory."},
        {"zh": "你的恐惧，我的力量。", "en": "Your fear, my strength."},
        {"zh": "邪教徒的怒吼。", "en": "Cultist's roar."},
        {"zh": "腐化之光。", "en": "Light of corruption."},
        {"zh": "猎物的颤抖。", "en": "Prey's tremble."},
        {"zh": "邪教徒的宣告。", "en": "Cultist's declaration."},
        {"zh": "腐化的目光。", "en": "Corruption's gaze."},
        {"zh": "邪教徒的复仇。", "en": "Cultist's revenge."},
        {"zh": "生人味，比腐肉新鲜。", "en": "Living scent, fresher than rotten flesh."},
        {"zh": "旗子的下摆，正对着你。", "en": "The banner's hem points right at you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶……我受够了!", "en": "Sigh… I've had enough!"},
        {"zh": "呜……真菌要了我的命!", "en": "Wooow… the fungi got me!"},
        {"zh": "嘶嘶……这肉真好吃!", "en": "Ssshh… this meat tastes good!"},
        {"zh": "呜呜……我要回去!", "en": "Wooow… I'm going back!"},
        {"zh": "嘶嘶……真菌之神保佑!", "en": "Ssshh… Fungi God protect!"},
        {"zh": "呜……别吃了!", "en": "Wooow… stop eating!"},
        {"zh": "嘶嘶……我们不孤单!", "en": "Ssshh… we’re not alone!"},
        {"zh": "呜……要下雨了!", "en": "Wooow… it’s going to rain!"},
        {"zh": "嘶嘶……我受够了战斗!", "en": "Ssshh… I’m tired of fighting!"},
        {"zh": "呜呜……你别过来!", "en": "Wooow… don’t come closer!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉诱惑我，黄金在我心中闪耀！", "en": "Corrupted meat tempts me, gold glimmers in my heart."},
        {"zh": "邪教的旗帜招引我，腐烂之源！", "en": "The cult banner calls me, source of decay!"},
        {"zh": "我听见食物的呼唤，真菌平原深处！", "en": "Food calls to me, in the depths of the Fungi Plains!"},
        {"zh": "腐肉是唯一的美味，黄金为我所用！", "en": "Corrupted meat is the only treat, gold serves me."},
        {"zh": "邪教的教义驱使我，腐化之地！", "en": "The cult’s doctrines drive me, in the corrupted lands!"},
        {"zh": "腐肉与黄金，邪教的奖励！", "en": "Corrupted meat and gold, cult rewards."},
        {"zh": "黄金在召唤，邪教徒兄弟！", "en": "Gold calls, brother in the cult!"},
        {"zh": "腐化的力量吸引我，黄金为证！", "en": "Corruption’s power draws me, gold testifies!"},
        {"zh": "邪教的信徒，黄金为我而来！", "en": "Cult followers, gold for me!"},
        {"zh": "腐肉滋养我，黄金铸就我力量！", "en": "Corrupted meat feeds me, gold forges my strength!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "真菌平原的风暴中，我粉碎一切！", "en": "In the storm of the Fungi Plains, I粉碎一切！"},
        {"zh": "邪教的力量让我不可阻挡！", "en": "The cult’s power makes me unstoppable."},
        {"zh": "我的撞击，粉碎一切腐朽之物！", "en": "My collision,粉碎一切腐朽！"},
        {"zh": "腐化的冲击波击破一切阻挡！", "en": "The corruption’s shockwave breaks all barriers!"},
        {"zh": "真菌平原上，我就是风暴！", "en": "In the Fungi Plains, I am the storm."},
        {"zh": "撞击粉碎腐化之物，邪教之敌！", "en": "Collisions粉碎腐化，cult enemies!"},
        {"zh": "我的力量压倒一切！腐化之墙！", "en": "My power overcomes all! Corruption’s wall!"},
        {"zh": "真菌平原的毁灭之力，我的力量！", "en": "The Fungi Plains’ force of destruction, my power!"},
        {"zh": "邪教的怒火，摧毁一切！", "en": "The cult’s fury, destruction of all!"},
        {"zh": "真菌之墙，我用撞击摧毁！", "en": "The Fungi Wall, I destroy with collisions!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "邪教徒，我们是同类！", "en": "Cultists, we are the same!"},
        {"zh": "我们的力量结合，成为更强！", "en": "Our powers combined, stronger together!"},
        {"zh": "与我并肩，邪教之子！", "en": "Stand with me, cult offspring!"},
        {"zh": "腐化的爱，连接我们的心！", "en": "Corruption’s love, binds our hearts!"},
        {"zh": "邪教之子，共同战斗！", "en": "Cult offspring, fight together!"},
        {"zh": "我们的结合，邪教的力量！", "en": "Our union, cult power!"},
        {"zh": "邪教的纽带，将我们相连！", "en": "The cult’s bond, unites us!"},
        {"zh": "腐化的结合，我们的力量！", "en": "Corruption’s union, our strength!"},
        {"zh": "邪教的兄弟，共同战斗！", "en": "Cult brothers, fight together!"},
        {"zh": "与我共生，邪教之子！", "en": "Be one with me, cult offspring!"}
      ]
    },
