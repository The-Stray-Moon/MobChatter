    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "祭坛缺一个，你来得正巧。", "en": "The altar lacks one, and here you are."},
        {"zh": "猎物近了，准备攻击。", "en": "Prey near, ready to attack."},
        {"zh": "烂掉的鼻子里，还闻得到金子。", "en": "My rotted snout still smells gold."},
        {"zh": "猎物在视野内。", "en": "Prey in sight."},
        {"zh": "旗子一指，祭品就是你了。", "en": "My banner points - you're the offering."},
        {"zh": "猎物现身，行动开始。", "en": "Prey revealed, action starts."},
        {"zh": "发现猎物，行动开始。", "en": "Target found, action starts."},
