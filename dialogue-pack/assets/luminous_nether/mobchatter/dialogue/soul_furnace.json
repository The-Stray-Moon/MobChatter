{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踏过灵魂沙，脚陷下去。", "en": "I cross soul sand and my feet sink."},
        {"zh": "蓝色的火焰跟着我走。", "en": "Blue flames follow me."},
        {"zh": "我每一步都燃起一小簇火。", "en": "Each step lights a small fire."},
        {"zh": "谷壁在我两侧升起来。", "en": "The canyon walls rise on both sides."},
        {"zh": "沙粒在我脚下发出低鸣。", "en": "The sand hums beneath my feet."},
        {"zh": "我绕过一块烧红的岩石。", "en": "I round a red-hot stone."},
        {"zh": "灰烬飘在我身后。", "en": "Ash drifts behind me."},
        {"zh": "我停下来，火焰暗了一下。", "en": "I stop and the flames dim."},
        {"zh": "我又抬起脚。", "en": "I lift a foot again."},
        {"zh": "我朝谷底深处走。", "en": "I walk deeper into the canyon."},
        {"zh": "我的心口亮着蓝光。", "en": "Blue light glows in my chest."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，蓝火围着。", "en": "I stand inside a ring of blue flame."},
        {"zh": "这火不烫，只是冷。", "en": "The fire isn't hot. It's cold."},
        {"zh": "灵魂沙在我脚下呼吸。", "en": "The soul sand breathes under me."},
        {"zh": "火跟着抬起来。", "en": "The fire rises with it."},
        {"zh": "我把它放下。", "en": "I lower it."},
        {"zh": "谷里没有风。", "en": "There's no wind in the canyon."},
        {"zh": "但火在动。", "en": "Yet the fire moves."},
        {"zh": "蓝色的光照着石壁。", "en": "Blue light falls on the stone."},
        {"zh": "我一直在等。", "en": "I've always been waiting."},
        {"zh": "谷底的沙很厚。", "en": "The sand at the bottom is deep."},
        {"zh": "我踩着它，不动。", "en": "I stand on it, still."},
        {"zh": "火苗偶尔窜一下。", "en": "The flame leaps now and then."},
        {"zh": "我又把它压下去。", "en": "I press it back down."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头，蓝光正照着你。", "en": "I raise my head, blue light on you."},
        {"zh": "灵魂沙在我脚下塌陷。", "en": "Soul sand sinks beneath my feet."},
        {"zh": "这里很少有。", "en": "It's rare here."},
        {"zh": "我往你那边看。", "en": "I look toward you."},
        {"zh": "我没有动。", "en": "I don't move."},
        {"zh": "你也没有。", "en": "Nor do you."},
        {"zh": "我们之间隔着一段灵魂沙。", "en": "A stretch of soul sand lies between us."},
        {"zh": "火在我身上窜了一下。", "en": "The fire leaps on me."},
        {"zh": "你又退了一步。", "en": "You step back again."},
        {"zh": "我低下头。", "en": "I lower my head."},
        {"zh": "我不是常来的那种东西。", "en": "I'm not the usual sort of thing here."},
        {"zh": "你也一样。", "en": "Nor are you."},
        {"zh": "所以我们互相看着。", "en": "So we watch each other."},
        {"zh": "我等你看够。", "en": "I'll wait until you've looked enough."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "蓝火散了一下，又聚起来。", "en": "The blue fire scatters, then regathers."},
        {"zh": "我的身体裂了一道。", "en": "A crack opens in me."},
        {"zh": "火的光暗了一瞬。", "en": "The fire's glow dims for a moment."},
        {"zh": "我抬起手，撑住自己。", "en": "I raise a hand to steady myself."},
        {"zh": "沙上有我的光。", "en": "My light is on the sand."},
        {"zh": "这一下伤到了里面。", "en": "That hurt something inside."},
        {"zh": "我记住了。", "en": "I remember it."},
        {"zh": "炉膛里的火晃了晃，却仍未熄。", "en": "The fire in my belly wavers, but does not go out."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有可吃的东西。", "en": "There's nothing to eat here."},
        {"zh": "你带来的，是给我的吗？", "en": "Is what you brought for me?"},
        {"zh": "我看了看，没有动。", "en": "I look at it and don't move."},
        {"zh": "这不是我吃的。", "en": "That isn't what I eat."},
        {"zh": "我抬起手，火窜了一下。", "en": "I raise a hand and the fire leaps."},
        {"zh": "放下吧。", "en": "Leave it."},
        {"zh": "会有人来拿的。", "en": "Someone will come for it."},
        {"zh": "我不需要。", "en": "I don't need it."},
        {"zh": "你留着。", "en": "Keep it."},
        {"zh": "走吧。", "en": "Go."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上来，蓝火散了一下。", "en": "You bump me and the blue fire scatters."},
        {"zh": "火又聚回来了。", "en": "The fire gathers again."},
        {"zh": "你没有受伤吧。", "en": "You're not hurt, are you?"},
        {"zh": "我这身火很冷。", "en": "This fire of mine is cold."},
        {"zh": "碰久了会冻。", "en": "Touch it long and it freezes."},
        {"zh": "你揉了揉手。", "en": "You rub your hands."},
        {"zh": "我转过身，让开。", "en": "I turn and step aside."},
        {"zh": "你可以过去。", "en": "You can pass."},
        {"zh": "我不拦路。", "en": "I don't block the way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "稀有野兽不讲这些。", "en": "Rare beasts don't bother with that."},
        {"zh": "我是熔炉的一个变种。", "en": "I'm a variant of the Furnace."},
        {"zh": "那个大的在荒地上烧。", "en": "The big one burns on the waste."},
        {"zh": "我在灵魂沙峡谷。", "en": "I'm here in the Soul Sand Valley."},
        {"zh": "我们不见面。", "en": "We don't meet."},
        {"zh": "我抬起手。", "en": "I raise a hand."},
        {"zh": "火安静地烧。", "en": "The fire burns quietly."},
        {"zh": "已经很够了。", "en": "That's quite enough."},
        {"zh": "时间在这里很慢。", "en": "Time moves slowly here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬手，它浮起来。", "en": "I raise a hand and it rises."},
        {"zh": "它在我掌前停住。", "en": "It stops before my palm."},
        {"zh": "我看了看。", "en": "I look at it."},
        {"zh": "是块骨头。", "en": "It's a bone."},
        {"zh": "这里的沙里都是。", "en": "The sand here is full of them."},
        {"zh": "我把它放回去。", "en": "I put it back."},
        {"zh": "它沉进沙里。", "en": "It sinks into the sand."},
        {"zh": "沙面又平了。", "en": "The surface smooths."},
        {"zh": "我继续站。", "en": "I go back to standing."},
        {"zh": "蓝火还在烧。", "en": "The blue fire still burns."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西靠近了。", "en": "Something is approaching."},
        {"zh": "蓝火烧得更旺。", "en": "The blue fire burns brighter."},
        {"zh": "我慢慢转过去。", "en": "I turn slowly."},
        {"zh": "火从我的掌心升起来。", "en": "Fire rises from my palms."},
        {"zh": "它停住了。", "en": "It stops."},
        {"zh": "我也停住。", "en": "I stop too."},
        {"zh": "我不想先动。", "en": "I don't want to move first."},
        {"zh": "但它太近了。", "en": "But it's too close."},
        {"zh": "沙陷下去。", "en": "The sand gives."},
        {"zh": "它退了。", "en": "It retreats."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它还在附近。", "en": "It's still nearby."},
        {"zh": "我站着，让火照着。", "en": "I stand and let the fire light."},
        {"zh": "蓝光在沙上铺开。", "en": "Blue light spreads over the sand."},
        {"zh": "它绕了一圈。", "en": "It circles once."},
        {"zh": "我没有转身。", "en": "I don't turn."},
        {"zh": "脚步声我听得很清楚。", "en": "I hear the footsteps clearly."},
        {"zh": "它停在我侧面。", "en": "It stops at my flank."},
        {"zh": "火苗窜高。", "en": "The flame leaps."},
        {"zh": "它退了半步。", "en": "It steps back."},
        {"zh": "它又绕。", "en": "It circles again."},
        {"zh": "这次从前面。", "en": "From the front this time."},
        {"zh": "我正面相对。", "en": "I face it squarely."},
        {"zh": "沙又安静了。", "en": "The sand is quiet again."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一掌推出去。", "en": "I push a palm out."},
        {"zh": "蓝火卷过去。", "en": "Blue fire rolls forward."},
        {"zh": "它被烧得退了。", "en": "The burn drives it back."},
        {"zh": "我没有追。", "en": "I don't chase."},
        {"zh": "火在它身上留了一会儿。", "en": "The fire clings to it a while."},
        {"zh": "然后熄了。", "en": "Then dies."},
        {"zh": "我收回手。", "en": "I draw my hand back."},
        {"zh": "沙上有焦黑的印。", "en": "There's a scorch mark on the sand."},
        {"zh": "但它还站着。", "en": "But it's still standing."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从灵魂沙里升起来。", "en": "I rise out of the soul sand."},
        {"zh": "蓝火先亮，然后是我。", "en": "The blue fire lights first, then me."},
        {"zh": "谷壁在两侧红着。", "en": "The canyon walls glow red on both sides."},
        {"zh": "这里的沙会叫。", "en": "The sand here makes a sound."},
        {"zh": "我抬起头，看向谷口。", "en": "I raise my head toward the canyon mouth."},
        {"zh": "很久没有动过了。", "en": "I haven't moved in a long time."},
        {"zh": "我是熔炉的稀有变种。", "en": "I'm a rare variant of the Furnace."},
        {"zh": "这身火比它的更冷。", "en": "My fire is colder than its."},
        {"zh": "火在指间绕。", "en": "Fire curls between my fingers."},
        {"zh": "远处有声音。", "en": "There's a sound far off."},
        {"zh": "不是风。", "en": "Not the wind."},
        {"zh": "那是脚步。", "en": "Those are footsteps."},
        {"zh": "我慢慢朝那边转身。", "en": "I turn slowly that way."},
        {"zh": "蓝光扫过沙壁。", "en": "The blue light sweeps the sand wall."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我来说只是又多一层。", "en": "Fire is just another layer to me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，沙把我接住。", "en": "I fall and the sand catches me."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浇在我身上，蓝火嘶嘶作响。", "en": "Water hits me and the blue fire hisses."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把沙掀起来，盖住我一半。", "en": "The blast throws sand, half burying me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的身体，很快烧没了。", "en": "An arrow buries in me and burns away."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光把我的火压住了一瞬。", "en": "Light smothers my fire for a moment."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我烧的是别的东西。", "en": "It's something else I burn."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落进谷里，蓝火跳了一下。", "en": "Lightning falls into the canyon and the blue fire leaps."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我坠进虚空，火还在烧。", "en": "I fall into the void, and the fire still burns."}
      ]
    }
  }
}
