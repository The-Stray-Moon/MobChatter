{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "疣猪兽一颠，我的鞍就响。", "en": "My hog's trot rattles my saddle."},
        {"zh": "我主，杀！", "en": "Master, kill!"},
        {"zh": "噬肉！噬肉！", "en": "Flesh! Flesh!"},
        {"zh": "平原上的猎物！", "en": "Prey on the plains!"},
        {"zh": "猪猪，前进！", "en": "Pig, move forward!"},
        {"zh": "菌体的怒火！", "en": "Fury of the fungi!"},
        {"zh": "杀戮之刃！", "en": "Knife of slaughter!"},
        {"zh": "疣猪兽一夹腿，就该冲了。", "en": "Squeeze the hoglin's flank and we charge."},
        {"zh": "菌人，冲锋！", "en": "Fungi, charge!"},
        {"zh": "菌土被猪兽的蹄翻起来。", "en": "The boar's hooves turn up the fungal soil."},
        {"zh": "疣猪兽的蹄刨着菌土。", "en": "My hoglin's hooves tear the fungal soil."},
        {"zh": "缰绳一拉，坐骑转向。", "en": "A tug on the reins turns my mount."},
        {"zh": "旗帜在菌盖下飘。", "en": "My banner flutters under the caps."},
        {"zh": "我们绕过一丛大菌盖。", "en": "We round a giant mushroom cap."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "注视着你...", "en": "Staring at you..."},
        {"zh": "疣猪兽一冲，我就跟上。", "en": "When the hoglin charges, I follow."},
        {"zh": "邪教的信仰！", "en": "Cult's faith!"},
        {"zh": "等待...狩猎...", "en": "Wait... Hunt..."},
        {"zh": "疣猪兽的背比地面稳。", "en": "The hoglin's back is steadier than the ground."},
        {"zh": "坐骑在嚼菌根，我闻着你的方向。", "en": "My mount chews fungal roots; I sniff toward you."},
        {"zh": "邪教徒，保持警惕！", "en": "Cultist, be alert!"},
        {"zh": "菌盖下太安静，我在等蹄声。", "en": "It is too quiet under the caps; I wait for hooves."},
        {"zh": "信仰指引我！", "en": "Faith guides me!"},
        {"zh": "邪教的号角...", "en": "Cult's horn..."},
        {"zh": "我数着菌菇的圈纹。", "en": "I count the rings on the mushrooms."},
        {"zh": "坐骑在嚼菌根。", "en": "My mount chews on fungal roots."},
        {"zh": "我在等献祭的钟声。", "en": "I wait for the sacrifice bell."},
        {"zh": "鞍带松了，我紧一紧。", "en": "The girth slipped; I tighten it."},
        {"zh": "远处的火把是我的弟兄。", "en": "Those torches far off are my brothers."},
        {"zh": "我摸了摸獠牙上的缺口。", "en": "I feel the notch in my tusk."},
        {"zh": "风吹过菌林，像低语。", "en": "Wind through the fungi sounds like whispering."},
        {"zh": "生猪肉只剩最后一块。", "en": "Only one raw porkchop left."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物在哪儿？", "en": "Where's the prey?"},
        {"zh": "我主，他在这里！", "en": "Master, he's here!"},
        {"zh": "瞄准他...", "en": "Target him..."},
        {"zh": "他的位置...", "en": "His position..."},
        {"zh": "猎物的味道越来越浓...", "en": "Prey scent grows stronger..."},
        {"zh": "猎物在躲藏...", "en": "The prey is hiding..."},
        {"zh": "捕捉他！", "en": "Capture him!"},
        {"zh": "火把举高些，我要看清你的脸。", "en": "Raise the torch higher; I want to see your face."},
        {"zh": "邪教徒，瞄准他！", "en": "Cultist, aim at him!"},
        {"zh": "追踪他的气息...", "en": "Track his scent..."},
        {"zh": "旗帜不是你的，站住。", "en": "That banner isn't yours; halt."},
        {"zh": "你身上没有我们的印记。", "en": "You bear none of our marks."},
        {"zh": "坐骑闻到你，烦躁起来。", "en": "My mount smells you and grows restless."},
        {"zh": "你走进菌林的方式不对。", "en": "You walk into the grove all wrong."},
        {"zh": "我数过你的脚印。", "en": "I've counted your footprints."},
        {"zh": "你手里的东西反着光。", "en": "What you hold glints."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "伤口渗出真菌汁液。", "en": "Fungal ooze seeps from the wound."},
        {"zh": "盔甲被侵蚀，腐烂了。", "en": "Armor is eroded, rotting away."},
        {"zh": "战斗中受伤，疼痛难忍。", "en": "Injured in battle, the pain is unbearable."},
        {"zh": "真菌腐化侵蚀我的身体。", "en": "Fungal corruption eats at my body."},
        {"zh": "伤口愈合缓慢，真菌生长。", "en": "Wounds heal slowly, fungal growth."},
        {"zh": "盔甲受损，真菌渗透。", "en": "Armor damaged, fungal seepage."},
        {"zh": "战斗中受了伤。", "en": "Injured in battle."},
        {"zh": "真菌侵入，伤口疼痛。", "en": "Fungal invasion, painful wound."},
        {"zh": "被击中，伤口出血。", "en": "Hit, bleeding wound."},
        {"zh": "战斗受伤，虚弱不堪。", "en": "Wounded in battle, feeling weak."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "注视着你，似乎在权衡。", "en": "Staring at you, weighing you up."},
        {"zh": "你散发的热量让它不安。", "en": "The heat you give off unsettles it."},
        {"zh": "渴望着你身上的肉。", "en": "Craving the flesh on your body."},
        {"zh": "你身上的装备让它困惑。", "en": "Its confusion over your gear."},
        {"zh": "它用眼神威胁你。", "en": "It threatens you with a glance."},
        {"zh": "它舔了舔嘴唇，显得贪婪。", "en": "It licks its lips, greedily."},
        {"zh": "你身上的魔药引起了它的注意。", "en": "The potion on you catches its eye."},
        {"zh": "你身上的盔甲让它犹豫。", "en": "Its armor makes it hesitate."},
        {"zh": "你的盔甲反射的光让它退缩。", "en": "Its armor reflects light, making it recoil."},
        {"zh": "它看着你的食物，垂涎欲滴。", "en": "It looks at your food, drooling."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "突然加速，撞向你。", "en": "Sudden acceleration, collides with you."},
        {"zh": "撞飞你的物品。", "en": "Collides, sending your items flying."},
        {"zh": "它用疣猪兽撞向敌人。", "en": "It uses the piglin to ram enemies."},
        {"zh": "它撞毁周围的障碍。", "en": "It rams nearby obstacles."},
        {"zh": "撞向你的盾牌。", "en": "Collides with your shield."},
        {"zh": "撞碎你的建筑。", "en": "Collides, breaking your structure."},
        {"zh": "撞倒你的陷阱。", "en": "Collides, disabling your traps."},
        {"zh": "用疣猪兽撞向你。", "en": "Ram you with the piglin."},
        {"zh": "撞散你的部队。", "en": "Ram your army apart."},
        {"zh": "撞毁你的防御。", "en": "Collides, breaching your defenses."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找伴侣来繁衍。", "en": "Seeks a mate to reproduce."},
        {"zh": "用嘶吼吸引同类。", "en": "Howls to attract others."},
        {"zh": "与同类进行交配。", "en": "Mates with others."},
        {"zh": "在菌菇平原交配。", "en": "Reproduces in the mushroom fields."},
        {"zh": "用尖啸吸引配偶。", "en": "Screams to attract a mate."},
        {"zh": "它发出求偶声。", "en": "It emits a mating call."},
        {"zh": "在夜间寻找伴侣。", "en": "Searches for a mate at night."},
        {"zh": "交配后消失不见。", "en": "Disappears after mating."},
        {"zh": "它用特殊叫声吸引配偶。", "en": "It calls for a mate with a special sound."},
        {"zh": "交配后返回战场。", "en": "Returns to the battle after mating."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "低语着咒语，挥舞着魔杖。", "en": "Whispering spells, waving the staff."},
        {"zh": "手中的魔杖闪烁着微光。", "en": "The staff glows in his hand."},
        {"zh": "嘶嘶作响，眼中露出杀机。", "en": "Hisses, eyes glowing with rage."},
        {"zh": "低声咒骂，握紧手中武器。", "en": "Muttering curses, clutching his weapon."},
        {"zh": "挥动镰刀，准备收割。", "en": "Swinging the scythe, ready to harvest."},
        {"zh": "咒语脱口而出，黑雾弥漫。", "en": "Spell out, black mist fills the air."},
        {"zh": "魔咒激荡，地面裂开。", "en": "Magic surges, earth cracks open."},
        {"zh": "魔力汇聚，光芒四射。", "en": "Magic gathers, light bursts forth."},
        {"zh": "尖啸着，向目标逼近。", "en": "Screaming, closing in on the target."},
        {"zh": "魔杖一挥，黑烟四起。", "en": "Staff waves, black smoke rises."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "注视着远方，寻找猎物。", "en": "Staring into the distance, searching for prey."},
        {"zh": "疣猪兽一蹬地，我的长矛就下来。", "en": "My hoglin kicks off and my spear comes down."},
        {"zh": "猪兽的耳朵竖起来，你就在前面。", "en": "My boar's ears prick up — you are just ahead."},
        {"zh": "嘶嘶声中，瞄准猎物。", "en": "Sibilant hiss, aiming at prey."},
        {"zh": "疣猪兽一冲，你的血条就难看。", "en": "One boar charge and your health bar looks bad."},
        {"zh": "目光如炬，瞄准猎物。", "en": "Eyes ablaze, targeting prey."},
        {"zh": "长矛尖压低，猪兽开始刨地。", "en": "I lower the spear tip; my boar begins to paw the ground."},
        {"zh": "黑烟中，他的目光锐利。", "en": "In the black smoke, his gaze sharp."},
        {"zh": "眼中杀机，锁定目标。", "en": "Eyes filled with rage, locking on target."},
        {"zh": "注视着你，准备行动。", "en": "Staring at you, ready to act."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "低吼一声，锁定目标。", "en": "Grumbles, locking on target."},
        {"zh": "嘶嘶声中，目标被锁定。", "en": "Sibilant hiss, target locked."},
        {"zh": "低声咒骂，锁定目标。", "en": "Muttering curses, target locked."},
        {"zh": "黑雾中，目标被发现。", "en": "Black mist, target found."},
        {"zh": "缰绳一松，疣猪兽的獠牙对准你。", "en": "I slacken the reins; the boar's tusks point at you."},
        {"zh": "疣猪兽冲在前面，我举刀。", "en": "The hoglin charges ahead; I raise my blade."},
        {"zh": "低吟咒语，锁定目标。", "en": "Murmurs spells, target locked."},
        {"zh": "低语咒语，目标被发现。", "en": "Whispers spells, target found."},
        {"zh": "我夹紧疣猪兽，长矛压低了。", "en": "I squeeze the boar between my knees and level my spear."},
        {"zh": "松开缰绳，冲锋！", "en": "Reins loose, charge!"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "疣猪兽一冲，我挥刀。", "en": "My hog charges; I swing."},
        {"zh": "腐菌的味道不错！", "en": "Mushroom tastes good."},
        {"zh": "猪兽是我的坐骑！", "en": "Piglin steed!"},
        {"zh": "平原上的战斗！", "en": "Battle in the plains!"},
        {"zh": "你的血条会很惨！", "en": "Your HP will be bad."},
        {"zh": "驯服我，我会更强大！", "en": "Tame me, I’ll be stronger!"},
        {"zh": "菌菇是我的食物！", "en": "Mushrooms are my food."},
        {"zh": "战斗结束后分享食物！", "en": "Share food after battle."},
        {"zh": "别小看我，邪教一员！", "en": "Don’t underestimate, cultist!"},
        {"zh": "真菌平原，我的家园！", "en": "Mushroom fields, my home!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "平原上来了邪教徒！", "en": "Cultist appears!"},
        {"zh": "我的猪兽更勇猛！", "en": "My steed is fierce!"},
        {"zh": "邪教徒的战斗开始！", "en": "Cultist battle starts!"},
        {"zh": "战斗中享受杀戮！", "en": "Enjoy the kill!"},
        {"zh": "平原上都是我们的！", "en": "All plains are ours!"},
        {"zh": "被我驯服，你更强！", "en": "Tame me, you’ll be stronger!"},
        {"zh": "菌菇使我们强大！", "en": "Mushrooms make us strong!"},
        {"zh": "战斗结束，分享食物！", "en": "Share food after battle!"},
        {"zh": "邪教徒的领地！", "en": "Cultist territory!"},
        {"zh": "真菌平原，邪教圣地！", "en": "Mushroom fields, cult shrine!"},
        {"zh": "菌林里响起号角。", "en": "A horn sounds in the fungal wood."},
        {"zh": "蹄声惊起一片孢子。", "en": "Hooves kick up a cloud of spores."},
        {"zh": "我们踏着菌盖的影子来了。", "en": "We come through the shadows of the caps."},
        {"zh": "平原上竖起一面邪教旗。", "en": "A cult banner rises over the plain."}
      ]
    },
