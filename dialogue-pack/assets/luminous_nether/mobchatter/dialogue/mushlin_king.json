      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进菌柄里", "en": "Something lodges in my stem."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "土里的菌丝乱了", "en": "The mycelium in the soil goes wild."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "土变瘦了，我在缩小", "en": "The soil's gone thin. I'm shrinking."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，孢子全亮了", "en": "Lightning strikes and all my spores flare."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "土没有了，根也断了", "en": "No soil. My roots tear free."}
      ]
    }
  }
