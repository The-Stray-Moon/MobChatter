{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "菌盖下的身体缓慢移动", "en": "My body shifts slowly under the cap."},
        {"zh": "我走过的地方长出小蘑菇", "en": "Small mushrooms rise where I pass."},
        {"zh": "菌丝拖在身后，发着微光", "en": "Mycelium trails behind me, faintly glowing."},
        {"zh": "每一步都踩着软土", "en": "Every step sinks into soft earth."},
        {"zh": "我沿着菌林边巡游", "en": "I patrol the fungal wood's edge."},
        {"zh": "袍子一样的菌裙扫过地面", "en": "My skirt of gills sweeps the ground."},
        {"zh": "孢子在身后飘", "en": "Spores drift behind me."},
        {"zh": "空气里有股潮味", "en": "The air smells damp."},
        {"zh": "我朝祭坛那边走", "en": "I head toward the shrine."},
        {"zh": "那里的邪教徒等我", "en": "The cultists wait for me there."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，菌盖轻轻开合", "en": "I stand, my cap opening and closing."},
        {"zh": "光从菌褶之间透出来", "en": "Light seeps between my gills."},
        {"zh": "脚下的土地在长东西", "en": "Something grows from the soil beneath me."},
        {"zh": "又细小又苍白", "en": "Small and pale."},
        {"zh": "我低头看了一眼", "en": "I glance down."},
        {"zh": "然后就移开视线", "en": "Then look away."},
        {"zh": "孢子落在我肩上", "en": "Spores settle on my shoulder."},
        {"zh": "然后又飘走了", "en": "Then drift off."},
        {"zh": "远处有人在跪拜", "en": "Someone kneels in the distance."},
        {"zh": "我根本不去看", "en": "I don't look."},
        {"zh": "他们总是这样", "en": "They always do."},
        {"zh": "我只需要在这里", "en": "I only need to be here."},
        {"zh": "菌盖慢慢转了个方向", "en": "My cap turns slowly."},
        {"zh": "把菌盖对着光", "en": "Toward the light."},
        {"zh": "这样长得更好", "en": "It grows better this way."},
        {"zh": "这片菌林都是我的", "en": "This whole fungal wood is mine."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢把头转过来", "en": "I turn my head slowly."},
        {"zh": "菌盖下的眼睛很暗", "en": "The eyes under my cap are very dark."},
        {"zh": "你居然没有跪", "en": "You didn't kneel."},
        {"zh": "这让我很意外", "en": "That surprises me."},
        {"zh": "那些穿袍的都跪了", "en": "The robed ones all kneel."},
        {"zh": "你不是他们的", "en": "You're not one of theirs."},
        {"zh": "我往前挪了一点", "en": "I shift forward a little."},
        {"zh": "孢子朝你飘过去", "en": "Spores drift toward you."},
        {"zh": "你屏住了呼吸", "en": "You hold your breath."},
        {"zh": "这倒是很聪明", "en": "Clever."},
        {"zh": "我慢慢停下来", "en": "I stop."},
        {"zh": "再给你一次机会", "en": "One more chance for you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "菌盖裂了一道", "en": "A crack opens in my cap."},
        {"zh": "孢子从伤口散出来", "en": "Spores pour from the wound."},
        {"zh": "我向后挪了挪", "en": "I ease backward."},
        {"zh": "菌丝缩回地下", "en": "My mycelium retracts underground."},
        {"zh": "这一击当真不轻", "en": "That blow was genuinely heavy."},
        {"zh": "我缓缓把首低下", "en": "I lower my crown slowly."},
        {"zh": "我一盯着你看", "en": "Looking right at you."},
        {"zh": "你打中了一个王", "en": "You struck a king."},
        {"zh": "这片林子记住了", "en": "This wood will remember."},
        {"zh": "它会替我说话", "en": "It will speak for me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有人举起了东西", "en": "Something is raised."},
        {"zh": "我不吃那种东西", "en": "I don't eat that."},
        {"zh": "我吃的是土里的东西", "en": "I eat what's in the soil."},
        {"zh": "你脚下就长着", "en": "It grows under your feet."},
        {"zh": "菌丝会自己伸过去", "en": "The mycelium will reach for it."},
        {"zh": "你不需要给我", "en": "You don't need to offer it."},
        {"zh": "我正在生长着", "en": "I'm growing."},
        {"zh": "不需要你来喂我", "en": "I don't need feeding."},
        {"zh": "把东西收起来吧", "en": "Put it away."},
        {"zh": "那会白白浪费", "en": "It would be wasted."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了菌柄", "en": "You bumped my stem."},
        {"zh": "硬得像一段木头", "en": "Hard as wood."},
        {"zh": "孢子飞了一片", "en": "A cloud of spores bursts out."},
        {"zh": "你连着咳了两下", "en": "You cough twice."},
        {"zh": "我往后退了一点", "en": "I draw back a little."},
        {"zh": "不想现在就伤你", "en": "I don't want to hurt you just yet."},
        {"zh": "菌盖晃了一下", "en": "My cap sways."},
        {"zh": "光暗了一瞬间", "en": "The glow dims for an instant."},
        {"zh": "然后又恢复了", "en": "Then returns."},
        {"zh": "你退开了一些", "en": "You back away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "菌林里没有别的王", "en": "There's no other king in this wood."},
        {"zh": "这里只有我一个", "en": "Only me."},
        {"zh": "我是从土里长出来的", "en": "I grew out of the soil."},
        {"zh": "长得非常之大", "en": "And grew very large."},
        {"zh": "邪教徒把我当成神", "en": "The cultists took me for a god."},
        {"zh": "我安然接受了", "en": "I accepted."},
        {"zh": "他们供奉，我庇护", "en": "They offer. I shelter."},
        {"zh": "这片菌林因此很大", "en": "That's why this wood is so large."},
        {"zh": "它会一直长下去", "en": "It will keep growing."},
        {"zh": "一直到我覆盖这片平原", "en": "Until I cover this whole plain."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "菌丝伸过去卷住", "en": "Mycelium reaches and curls around it."},
        {"zh": "然后拖进土里", "en": "Then drags it underground."},
        {"zh": "在那里慢慢消化", "en": "Where it slowly dissolves."},
        {"zh": "这不是我需要的", "en": "Not what I need."},
        {"zh": "但也不会浪费", "en": "But it won't be wasted."},
        {"zh": "土里什么都吃", "en": "The soil eats everything."},
        {"zh": "我继续向前挪", "en": "I edge onward."},
        {"zh": "脚下又多了一朵小蘑菇", "en": "Another small mushroom rises under me."},
        {"zh": "这就是我的回报", "en": "That's the return."},
        {"zh": "慢慢长起来吧", "en": "Slow growth."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到了我的菌丝", "en": "You stepped on my mycelium."},
        {"zh": "它已经知道了", "en": "It already knows."},
        {"zh": "我能感觉到震动", "en": "I feel the tremor."},
        {"zh": "从很远的地方传来", "en": "From very far away."},
        {"zh": "整片菌林都在传", "en": "The whole wood passes it along."},
        {"zh": "它在告诉我你在哪", "en": "It tells me where you are."},
        {"zh": "我把脸转过去", "en": "I turn my face away."},
        {"zh": "正好对准了你", "en": "Squarely at you."},
        {"zh": "孢子开始聚集", "en": "Spores begin to gather."},
        {"zh": "空气变得浑浊", "en": "The air thickens."},
        {"zh": "这片土地会把你留下", "en": "This ground will keep you."},
        {"zh": "不是活着的那种", "en": "Not in a living way."},
        {"zh": "我朝你缓缓过去", "en": "I drift slowly toward you."},
        {"zh": "我走得很慢很慢", "en": "I walk very slowly."},
        {"zh": "但绝不会停下", "en": "But I won't stop."},
        {"zh": "菌盖在头顶张开", "en": "My cap opens overhead."},
        {"zh": "像撑开一把伞", "en": "Like an umbrella."},
        {"zh": "伞下就是我的", "en": "And under it is mine."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一寸寸逼近", "en": "I close in inch by inch."},
        {"zh": "地上的菌丝跟着动", "en": "The mycelium moves with me."},
        {"zh": "它们在你脚下汇合", "en": "It gathers beneath your feet."},
        {"zh": "你看不见那些细的", "en": "You can't see the fine threads."},
        {"zh": "等你看见就晚了", "en": "When you do, it's too late."},
        {"zh": "我就在这停下", "en": "I stop."},
        {"zh": "我向下垂低了头", "en": "I bow my head down."},
        {"zh": "孢子慢慢下沉", "en": "Spores settling slowly."},
        {"zh": "一粒粒落在草上", "en": "Onto the grass."},
        {"zh": "草根开始变白", "en": "The grass goes white."},
        {"zh": "然后一片片倒下", "en": "Then falls."},
        {"zh": "一排排地倒下", "en": "Row after row."},
        {"zh": "一直朝你那边去", "en": "Heading your way."},
        {"zh": "你退到石头上了", "en": "You've climbed onto a rock."},
        {"zh": "石头也会长东西", "en": "Stone grows things too."},
        {"zh": "只是长得慢一点", "en": "Just more slowly."},
        {"zh": "我有的是耐性", "en": "I have patience to spare."},
        {"zh": "这片林子等了很久", "en": "This wood has waited a long while."},
        {"zh": "再多等上一会儿", "en": "A little longer more."},
        {"zh": "对我没有区别", "en": "No difference."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "菌盖整个压下来", "en": "My cap comes down."},
        {"zh": "沉得像一堵墙", "en": "Like a wall."},
        {"zh": "你被整个顶开", "en": "You're shoved aside."},
        {"zh": "孢子扑了你一脸", "en": "Spores burst into your face."},
        {"zh": "你开始咳起来", "en": "You start coughing."},
        {"zh": "我伸出几根菌丝", "en": "I extend mycelium."},
        {"zh": "缠住你的脚踝", "en": "It wraps your ankle."},
        {"zh": "你一扯就断了", "en": "One pull and it snaps."},
        {"zh": "可还有很多根", "en": "But there's plenty more."},
        {"zh": "你脚下到处都是", "en": "All underfoot."},
        {"zh": "我在等它长回来", "en": "I wait for it to regrow."},
        {"zh": "长得非常之快", "en": "Very quickly."},
        {"zh": "你看一看脚下", "en": "Look down."},
        {"zh": "这就是我的武器", "en": "That's my weapon."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "菌林中间鼓起来一块", "en": "The middle of the fungal wood swells."},
        {"zh": "土被慢慢顶开", "en": "The soil is pushed apart."},
        {"zh": "我先露出菌盖", "en": "My cap shows first."},
        {"zh": "身形非常之大", "en": "Very large."},
        {"zh": "然后是我的身体", "en": "Then my body."},
        {"zh": "周围的邪教徒跪下了", "en": "The cultists around kneel."},
        {"zh": "我没有看他们", "en": "I don't look at them."},
        {"zh": "我在看这片地", "en": "I'm looking at the ground."},
        {"zh": "它非常之肥沃", "en": "It's rich."},
        {"zh": "能长很多东西", "en": "It can grow a great deal."},
        {"zh": "我抖了抖菌裙", "en": "I shake out my gill skirt."},
        {"zh": "孢子一下散开", "en": "Spores scatter."},
        {"zh": "空气里全是我的味道", "en": "The air is full of me."},
        {"zh": "从今天开始算", "en": "From today."},
        {"zh": "这片平原归我", "en": "This plain is mine."},
        {"zh": "那就先长起来", "en": "First grow."},
        {"zh": "然后再说别的", "en": "Then discuss the rest."},
        {"zh": "我不赶这点时间", "en": "I'm in no rush for time."},
        {"zh": "土会一直等我", "en": "The soil will wait for me."},
        {"zh": "它一直都在等", "en": "It always has."}
      ]
    },
