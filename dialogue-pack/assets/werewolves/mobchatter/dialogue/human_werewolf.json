{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "低吼着穿过树林", "en": "Growls through the forest."},
        {"zh": "毛发竖起，警惕地走着", "en": "Fur standing, walking cautiously."},
        {"zh": "狼人轻盈地奔跑", "en": "Lycanthrope runs lightly."},
        {"zh": "它舔了舔嘴唇", "en": "It licks its lips."},
        {"zh": "脚步沉重，尾巴摇摆", "en": "Heavy footsteps, tail swaying."},
        {"zh": "警惕地嗅着周围", "en": "Sniffing cautiously around."},
        {"zh": "步伐沉重，发出嘶嘶声", "en": "Heavy steps, hissing."},
        {"zh": "低着头快速行走", "en": "Head down, walking fast."},
        {"zh": "小心地探索着前方", "en": "Exploring cautiously ahead."},
        {"zh": "尾巴摇摆，快速移动", "en": "Tail swaying, moving fast."},
        {"zh": "拉紧斗篷，快步走开", "en": "Cloak pulled tight, I walk fast"},
        {"zh": "手指抠着木门缝", "en": "My fingers pry at the wooden door seam"},
        {"zh": "在针叶林里绕小路", "en": "I take the side path through the pines"},
        {"zh": "回头看了一眼又低头", "en": "One glance back, then my head drops"},
        {"zh": "踩碎薄冰，脚步一顿", "en": "Thin ice cracks, and I freeze"},
        {"zh": "避开村庄的灯火", "en": "I keep clear of the village lights"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "紧盯着猎物", "en": "Stares intently at prey."},
        {"zh": "我站在门口，手还扶着门框。", "en": "I stand at the door, hand on the frame."},
        {"zh": "身体放松，打量环境", "en": "Relaxed body, surveying the environment."},
        {"zh": "舔了舔爪子", "en": "Licks its paws."},
        {"zh": "目光闪烁，思考着", "en": "Eyes gleam, thinking."},
        {"zh": "轻摇尾巴，放松", "en": "Tail wags, relaxes."},
        {"zh": "懒洋洋地躺着", "en": "Lies lazily."},
        {"zh": "专注地盯着某物", "en": "Stares intensely at something."},
        {"zh": "慵懒地伸了个懒腰", "en": "Stretches lazily."},
        {"zh": "舔了舔自己的爪子", "en": "Licks its own paws."},
        {"zh": "背靠松树，攥着拳头", "en": "Back to a pine, fists clenched"},
        {"zh": "盯着自己的手发呆", "en": "I stare at my own hands"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "发现玩家，目光闪烁", "en": "Finds player, eyes gleam."},
        {"zh": "看着玩家，尾巴竖起", "en": "Stares at player, tail up."},
        {"zh": "紧盯着玩家，发出低吼", "en": "Stares at player, low growl."},
        {"zh": "我这副人形，撑不了太久。", "en": "This human shape won't hold much longer."},
        {"zh": "观察玩家，尾巴摇摆", "en": "Observes player, tail swaying."},
        {"zh": "目光如狼，死死盯着", "en": "Eyes like wolves, fixated."},
        {"zh": "目光锐利，盯着玩家", "en": "Sharp eyes, staring at player."},
        {"zh": "注意到了玩家，发出低吼", "en": "Notices player, low growl."},
        {"zh": "注视着玩家，尾巴竖起", "en": "Staring at player, tail up."},
        {"zh": "目光凶狠，盯着玩家", "en": "Fierce eyes, staring at player."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我人形的嗓子，发出狼的声。", "en": "From a human throat comes a wolf's cry."},
        {"zh": "惨叫一声倒地", "en": "A sharp cry falls"},
        {"zh": "嘶嘶叫着受伤", "en": "Snarling in hurt"},
        {"zh": "狼嚎间倒地", "en": "Falls amidst howls"},
        {"zh": "人形还没变完，别逼我。", "en": "I'm not fully changed yet — don't push me."},
        {"zh": "受伤狼嚎", "en": "Injured howl"},
        {"zh": "哀嚎倒地", "en": "Screaming fall"},
        {"zh": "狼嚎中倒下", "en": "Falls in howls"},
        {"zh": "狼嚎带伤", "en": "Injured howl"},
        {"zh": "嚎叫倒地", "en": "Howls then falls"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "人类形态时渴望猎物的气味。", "en": "Craves the scent of prey in human form."},
        {"zh": "接近时发出低沉的嚎叫。", "en": "Issues a low growl as you approach."},
        {"zh": "夜晚会变成狼形。", "en": "Shifts into wolf form at night."},
        {"zh": "咬伤会传染狼人。", "en": "Bite to infect with lycanthropy."},
        {"zh": "喜欢在雪地捕猎。", "en": "Prefers to hunt in snow."},
        {"zh": "饥饿时会攻击旅人。", "en": "Attacks travelers when hungry."},
        {"zh": "寻找伴侣时发出呼噜声。", "en": "Rumbles when seeking a mate."},
        {"zh": "狼人形态时眼中有红光。", "en": "Red eyes in wolf form."},
        {"zh": "狼人会留下爪痕。", "en": "Leaves claw marks."},
        {"zh": "月光下更易变成狼。", "en": "More likely to shift under moonlight."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "突然出现吓你一跳。", "en": "Startles you with a sudden appearance."},
        {"zh": "撞到你会咬你。", "en": "Bites if it collides with you."},
        {"zh": "狼人体型比你大得多。", "en": "Much larger than you."},
        {"zh": "撞倒你后再攻击。", "en": "Attacks after knocking you down."},
        {"zh": "狼人会试图逃走。", "en": "Tries to run away."},
        {"zh": "狼人的速度很快。", "en": "Rapidly swift."},
        {"zh": "狼人会留下毛发。", "en": "Leaves fur behind."},
        {"zh": "撞上它会受伤。", "en": "Injures you if you collide."},
        {"zh": "狼人会用爪子攻击。", "en": "Attacks with its claws."},
        {"zh": "狼人力量很大。", "en": "Strong and powerful."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "发出求偶的嚎叫。", "en": "Howls to attract a mate."},
        {"zh": "狼人寻找伴侣。", "en": "Wolves seek a mate."},
        {"zh": "与伴侣互相摩擦。", "en": "Rub against a mate."},
        {"zh": "狼人对伴侣忠诚。", "en": "Faithful to its mate."},
        {"zh": "求偶时会亲密。", "en": "Intimate during courtship."},
        {"zh": "狼人喜欢独处。", "en": "Prefers solitude."},
        {"zh": "狼人有强烈的领地意识。", "en": "Has a strong territoriality."},
        {"zh": "狼人会用吻求偶。", "en": "Kisses to court."},
        {"zh": "狼人伴侣关系稳固。", "en": "Mate bonds are strong."},
        {"zh": "狼人有固定的配偶。", "en": "Has a permanent mate."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "闻到了新鲜血液的味道。", "en": "Smell of fresh blood."},
        {"zh": "找到下一个宿主。", "en": "Next host found."},
        {"zh": "这个声音很诱人。", "en": "That sound is tempting."},
        {"zh": "人形走久了，肚子空。", "en": "Walking as a man leaves my belly empty."},
        {"zh": "这里适合睡觉。", "en": "Good place to sleep."},
        {"zh": "我捡起一件旧披风，盖住背。", "en": "I pick up an old cloak and drape my back."},
        {"zh": "这件旧衣服，还带着人味。", "en": "These old clothes still smell human."},
        {"zh": "不要惊动我。", "en": "Don’t disturb me."},
        {"zh": "这里的食物很丰富。", "en": "Abundant food here."},
        {"zh": "我假装捡柴，等谁落单。", "en": "I pretend to gather wood, waiting for someone alone."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我收起人形，指甲先长出来。", "en": "I shed my human shape; the claws come first."},
        {"zh": "抓住机会。", "en": "Take the chance."},
        {"zh": "我推开门，木轴响了一声。", "en": "I push the door open; the hinge creaks."},
        {"zh": "被咬过的人，都要走这条路。", "en": "Anyone bitten walks this road."},
        {"zh": "别逼我现在就变身。", "en": "Don't make me change right now."},
        {"zh": "我还能开门，别把我当野兽。", "en": "I can still open doors; don't call me a beast yet."},
        {"zh": "猎物在我掌中。", "en": "The prey is in my hand."},
        {"zh": "你活得太久了。", "en": "You’ve lived too long."},
        {"zh": "结束这一切。", "en": "End it now."},
        {"zh": "你属于我的。", "en": "You are mine."},
        {"zh": "别逼我，我不想变", "en": "Don't push me. I don't want to change"},
        {"zh": "你一靠近，它就醒了", "en": "Come closer and it wakes up"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "盯紧它。", "en": "Watch it."},
        {"zh": "小心它。", "en": "Beware of it."},
        {"zh": "靠近它。", "en": "Approach it."},
        {"zh": "攻击它。", "en": "Attack it."},
        {"zh": "我四肢着地，骨头在响。", "en": "I drop to all fours; my bones crack."},
        {"zh": "杀死它。", "en": "Kill it."},
        {"zh": "别让它跑了。", "en": "Don’t let it go."},
        {"zh": "瞄准它。", "en": "Aim at it."},
        {"zh": "攻击它的弱点。", "en": "Attack its weak point."},
        {"zh": "消灭它。", "en": "Eliminate it."},
        {"zh": "喉咙里滚出狼的低吼", "en": "A wolf's growl rolls in my throat"},
        {"zh": "手指正一点点变长", "en": "My fingers are growing longer"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嚎叫一声扑向你！", "en": "Howl and lunge at you!"},
        {"zh": "狼牙撕咬你的喉咙！", "en": "Wolf fangs bite your throat!"},
        {"zh": "爪子抓破你的皮肤！", "en": "Claws scratch your skin!"},
        {"zh": "扑倒你，用利爪伤害！", "en": "Tackle you and maul with claws!"},
        {"zh": "狼嘴咬断你的手臂！", "en": "Wolf mouth bites off your arm!"},
        {"zh": "咬住你不放，狠狠撕咬！", "en": "Hold and bite hard!"},
        {"zh": "凶猛攻击，狼爪抓伤你！", "en": "Fierce attack, claw you!"},
        {"zh": "扑向你，狼牙紧咬不放！", "en": "Charge and bite with fangs!"},
        {"zh": "撕裂你的肉体，释放狼性！", "en": "Rip your flesh, unleash wolf!"},
        {"zh": "用利爪撕开你的衣服！", "en": "Slash your clothes with claws!"}
      ]
    },
