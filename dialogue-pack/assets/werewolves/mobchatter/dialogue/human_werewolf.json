        {"zh": "月光下，变成狼人！", "en": "Transform under the moonlight!"},
        {"zh": "夜晚出现，变成狼人！", "en": "Appear as a lycanthrope at night!"},
        {"zh": "月圆之夜，化为狼人！", "en": "Transform on full moon night!"},
        {"zh": "月光加持，变成狼人！", "en": "Moonlight transforms you!"},
        {"zh": "夜晚降临，化为狼人！", "en": "Nightfall, transform into a lycanthrope!"},
        {"zh": "月光下现身，变成狼人！", "en": "Reveal yourself as a lycanthrope under the moon!"},
        {"zh": "月圆时，变成狼人！", "en": "Transform on a full moon!"},
        {"zh": "月光中现身，变成狼人！", "en": "Reveal yourself in the moonlight!"},
        {"zh": "雪地里走来一个人影", "en": "A figure walks across the snow"},
        {"zh": "松林间有人低声喘息", "en": "Someone pants quietly among the pines"}
      ]
    },
