{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "黑白条纹，走路一摇一摆", "en": "Black and white stripes, waddling along."},
        {"zh": "我尾巴翘着，这算警告", "en": "My tail's up; that's a warning."},
        {"zh": "我走过的地方怪物退开", "en": "Where I walk, monsters back off."},
        {"zh": "步子不大，走得很稳", "en": "Short steps, very steady."},
        {"zh": "我贴着地面嗅过去", "en": "I sniff along the ground."},
        {"zh": "这身花纹在夜里很显眼", "en": "These markings stand out at night."},
        {"zh": "我边走边往后看", "en": "I walk and glance behind."},
        {"zh": "我的爪子在土里刨", "en": "My paws scratch the soil."},
        {"zh": "我带着监守者的气息", "en": "I carry a warden's presence."},
        {"zh": "我慢慢挪动，别急", "en": "I move slowly; don't rush."},
        {"zh": "我的尾巴比身子还显眼", "en": "My tail draws more notice than I do."},
        {"zh": "我绕过草丛走大路", "en": "I skirt the brush and take the open path."},
        {"zh": "我一停下周围就安静", "en": "I stop, and everything goes quiet."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲着，尾巴不动", "en": "I crouch, tail still."},
        {"zh": "监守者这名字不是白叫的", "en": "Warden isn't just a name for me."},
        {"zh": "我能让怪东西走开", "en": "I can make strange things leave."},
        {"zh": "我在听地底下的动静", "en": "I'm listening underground."},
        {"zh": "我抖了抖胡须", "en": "I twitch my whiskers."},
        {"zh": "我自己也清楚这身味道", "en": "I know my own smell well."},
        {"zh": "我不怕大个子", "en": "I'm not afraid of big things."},
        {"zh": "我背上有点痒", "en": "My back itches."},
        {"zh": "我闻到了熟悉的味道", "en": "I smell something familiar."},
        {"zh": "夜里我的眼睛更亮", "en": "My eyes shine brighter at night."},
        {"zh": "我蹲低了，准备动", "en": "I crouch low, ready to move."},
        {"zh": "我没打算先出手", "en": "I don't plan to strike first."},
        {"zh": "我在等一个疏忽", "en": "I'm waiting for one mistake."},
        {"zh": "尾巴尖轻轻敲着地", "en": "My tail tip taps the ground."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上没有甜浆果味", "en": "You don't smell of sweet berries."},
        {"zh": "你看见我尾巴了吗", "en": "Did you see my tail?"},
        {"zh": "我不喜欢被突然靠近", "en": "I dislike sudden approaches."},
        {"zh": "你一伸手我就喷", "en": "Reach out and I'll spray."},
        {"zh": "我的名字里有监守者", "en": "My name includes Warden."},
        {"zh": "你手上那东西能吃吗", "en": "Is that in your hand edible?"},
        {"zh": "我不介意你就站着", "en": "I don't mind you standing there."},
        {"zh": "你的靴子踩得很响", "en": "Your boots are loud."},
        {"zh": "我在看你有无坏心", "en": "I'm checking your intent."},
        {"zh": "你身上没有怪味，还好", "en": "You don't smell wrong; good."},
        {"zh": "看得出你不怕我", "en": "I can tell you're not afraid."},
        {"zh": "我说不清自己凶不凶", "en": "I can't say if I'm fierce."},
        {"zh": "我盯着你，你别动", "en": "I'm watching you; hold still."},
        {"zh": "你蹲下来我就不走", "en": "Crouch down and I'll stay."},
        {"zh": "我尾巴还翘着", "en": "My tail is still up."},
        {"zh": "你在看我的条纹", "en": "You're looking at my stripes."},
        {"zh": "这是警告色，你知道吗", "en": "These are warning colors, you know."},
        {"zh": "我的毛竖起来了", "en": "My fur is standing up."},
        {"zh": "再靠近一点试试看", "en": "Try coming one step closer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我尾巴一下竖起来", "en": "My tail shot straight up."},
        {"zh": "我退开，准备喷", "en": "I back off, ready to spray."},
        {"zh": "这点伤我还站得住", "en": "I can still stand with this."},
        {"zh": "我的毛塌了一块", "en": "A patch of fur flattened."},
        {"zh": "你打断了我的警戒", "en": "You broke my watch."},
        {"zh": "我低声哼了一声", "en": "I gave a low huff."},
        {"zh": "我不太常挨打", "en": "I don't get hit often."},
        {"zh": "我的尾巴还在", "en": "My tail is intact."},
        {"zh": "再来我就喷了", "en": "One more and I spray."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "甜浆果？我认得", "en": "Sweet berries? I know them."},
        {"zh": "你手里那几个够不够", "en": "Are those few in your hand enough?"},
        {"zh": "放地上，我自己来", "en": "Put them down; I'll come."},
        {"zh": "我不吃胡萝卜，那是别人的事", "en": "I don't eat carrots; that's others' business."},
        {"zh": "这一颗尝着很甜", "en": "This berry is sweet."},
        {"zh": "你伸手我就退", "en": "Reach out and I back off."},
        {"zh": "再给一颗我就留下", "en": "One more berry and I'll stay."},
        {"zh": "我一口一口慢慢吃", "en": "I eat it bite by bite."},
        {"zh": "这种东西能让我安心", "en": "These make me feel safe."},
        {"zh": "跟在后面走一段也行", "en": "Trailing a while is fine."},
        {"zh": "甜浆果是我唯一喜欢的", "en": "Sweet berries are all I like."},
        {"zh": "你手心的味道很好", "en": "Your palm smells nice."},
        {"zh": "我靠近了，别动", "en": "I'm coming closer; hold still."},
        {"zh": "再多一点我就认你", "en": "More of these, and I'm yours."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，我尾巴就翘起来", "en": "Bump me and my tail goes up."},
        {"zh": "我退了一步才稳住", "en": "I step back and steady."},
        {"zh": "我的毛挡了一点", "en": "My fur took some of it."},
        {"zh": "监守者臭鼬的尾巴被踩住。", "en": "The warden skunk's tail is pinned."},
        {"zh": "我身上有监守者的硬气", "en": "I have a warden's toughness."},
        {"zh": "别贴着我，我很敏感", "en": "Don't press against me; I'm jumpy."},
        {"zh": "我歪了一下，没倒下", "en": "I tilted, didn't fall."},
        {"zh": "你比我想的要重", "en": "You're heavier than I thought."},
        {"zh": "再挤我真的会喷", "en": "Squeeze again and I will spray."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只认甜浆果", "en": "I only answer to sweet berries."},
        {"zh": "先让我闻闻你", "en": "Let me sniff you first."},
        {"zh": "我尾巴翘着不是那意思", "en": "My raised tail doesn't mean that."},
        {"zh": "我们臭鼬不讲这些", "en": "We skunks don't bother with that."},
        {"zh": "草地上够我们俩转", "en": "The grass is wide enough for two."},
        {"zh": "慢慢来，我胆子小", "en": "Slowly; I'm timid."},
        {"zh": "等我吃饱了再说", "en": "After I've eaten."},
        {"zh": "我的味道你受得了吗", "en": "Can you stand my smell?"},
        {"zh": "贴着走一段吧", "en": "Walk beside me a while."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有一颗浆果", "en": "A berry on the ground."},
        {"zh": "我叼起来慢慢嚼", "en": "I take it and chew."},
        {"zh": "我用爪子压住它", "en": "I press it with a paw."},
        {"zh": "这点东西我收着", "en": "I'll keep this."},
        {"zh": "地上掉的我都闻一闻", "en": "I sniff everything dropped."},
        {"zh": "这颗脏了，我不要", "en": "This one's dirty; no thanks."},
        {"zh": "我用两只前爪捧起来", "en": "I hold it in both front paws."},
        {"zh": "这一颗留着后面吃", "en": "This one's saved for later."},
        {"zh": "别抢走这一颗", "en": "Don't take this one."},
        {"zh": "掉在我脚边就是我的", "en": "Dropped at my feet, it's mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的尾巴一竖，臭腺就满了。", "en": "My tail rises and my scent glands fill."},
        {"zh": "我已经警告过了", "en": "I already warned you."},
        {"zh": "你要么退，要么忍着", "en": "Step back, or take it."},
        {"zh": "我喷出去的东西很难洗", "en": "What I spray is hard to wash off."},
        {"zh": "这不是攻击，是请你走", "en": "This isn't an attack; it's a request."},
        {"zh": "我一转身就喷", "en": "I turn and spray."},
        {"zh": "怪物都怕这个", "en": "Monsters fear this."},
        {"zh": "这味道会在你身上留一个月", "en": "It'll linger on you for a month."},
        {"zh": "我背对着你，别过来", "en": "I'm turning my back; stay there."},
        {"zh": "尾巴举高，最后警告", "en": "Tail raised high: last warning."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢抬起尾巴", "en": "I slowly raise my tail."},
        {"zh": "你每走一步我就压低", "en": "Every step forward, I crouch lower."},
        {"zh": "我背对你的时候最危险", "en": "I'm most dangerous with my back turned."},
        {"zh": "我不用转身也能喷", "en": "I needn't face you to spray."},
        {"zh": "草丛就在我旁边", "en": "The brush is beside me."},
        {"zh": "我的白纹，一路亮到尾巴尖。", "en": "My white stripe runs bright to the tail tip."},
        {"zh": "我等着你伸手", "en": "I wait for you to reach out."},
        {"zh": "数到三我就转身", "en": "On three I turn."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "已经喷出去了", "en": "It's out."},
        {"zh": "这一下没有伤口，只有味道", "en": "No wound, only stink."},
        {"zh": "前爪抓住你的鞋", "en": "My front paws grab your shoe."},
        {"zh": "你退了我就停", "en": "You back off; I stop."},
        {"zh": "这味道洗不掉", "en": "That smell won't wash out."},
        {"zh": "我喷完转身就跑", "en": "I spray and run."},
        {"zh": "你揉眼睛也没用", "en": "Rubbing your eyes won't help."},
        {"zh": "再靠近我还会喷", "en": "Come closer and I'll spray again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑白条纹先出现", "en": "Black and white stripes appear first."},
        {"zh": "这一带没有怪物敢靠近", "en": "No monster dares come near."},
        {"zh": "尾巴翘着，算是报到", "en": "Tail up; that's my report."},
        {"zh": "监守者的气息跟着我", "en": "A warden's presence comes with me."},
        {"zh": "我闻了闻这片土地", "en": "I sniff this ground."},
        {"zh": "草被我的爪子刨开", "en": "My paws scratch the grass open."},
        {"zh": "夜里的东西都往后退", "en": "Things of the night retreat."},
        {"zh": "我来了，就安静了", "en": "I'm here, so it's quiet now."},
        {"zh": "别站在我后面", "en": "Don't stand behind me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛被燎了，味道更难闻", "en": "Fur singed; the smell got worse."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去翻了半圈", "en": "I fell and rolled half a turn."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我不太会游泳", "en": "I'm not much of a swimmer."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀进草丛", "en": "The blast threw me into the brush."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的尾巴", "en": "Something struck my tail."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这力量让我浑身发麻", "en": "This force numbs me all over."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没浆果了，我饿", "en": "No berries left; I'm hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈下来，毛全立了", "en": "Lightning struck; all my fur stood up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有地面了", "en": "There's no ground below."}
      ]
    }
  }
}
