{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕过你，绕得很慢。", "en": "I circle you, very slowly."},
        {"zh": "脚下没有印子。", "en": "My steps leave no prints."},
        {"zh": "我的身体是半透明的。", "en": "My body is half see-through."},
        {"zh": "我沿着矿道边缘走。", "en": "I keep to the tunnel's edge."},
        {"zh": "我的脚步声比你晚一点。", "en": "My footfalls trail yours slightly."},
        {"zh": "我在你背后停了一下。", "en": "I pause behind you."},
        {"zh": "我走过水洼，水面不动。", "en": "I cross a puddle and it doesn't stir."},
        {"zh": "我在你灯光的边上走。", "en": "I walk at the edge of your lamp."},
        {"zh": "我的影子很淡。", "en": "My shadow is very faint."},
        {"zh": "我从石缝里穿过去。", "en": "I pass through a crack in the rock."},
        {"zh": "我一直在同一个距离。", "en": "I stay at the same distance."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的头轻轻偏了一下。", "en": "My head tilts slightly."},
        {"zh": "我听你挖石头。", "en": "I listen to you mining."},
        {"zh": "洞里没有风，我却动了。", "en": "There's no wind, yet I move."},
        {"zh": "我的呼吸声很轻。", "en": "My breathing is very light."},
        {"zh": "我在数你的镐声。", "en": "I'm counting your pick strikes."},
        {"zh": "我抬手碰了碰墙。", "en": "I raise a hand and touch the wall."},
        {"zh": "我的手没有碰到。", "en": "My hand doesn't make contact."},
        {"zh": "我一直在你身后走着。", "en": "I've been walking behind you all along."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你听见有人在走吗？", "en": "Do you hear someone walking?"},
        {"zh": "你转过来，我不见了。", "en": "You turn, and I'm gone."},
        {"zh": "我的名字在你头顶浮现。", "en": "My name surfaces above your head."},
        {"zh": "那不是你的眼睛。", "en": "Those aren't your eyes."},
        {"zh": "你摸不到我。", "en": "You can't touch me."},
        {"zh": "你的镐停在半空。", "en": "Your pick hangs mid-swing."},
        {"zh": "我不用走过来。", "en": "I don't need to come closer."},
        {"zh": "我贴着你的后背，你感觉不到。", "en": "I press against your back and you cannot feel it."},
        {"zh": "你听见声音，却看不见人。", "en": "You hear it and see no one."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我淡了一下。", "en": "I faded for a moment."},
        {"zh": "我的轮廓散开。", "en": "My outline comes apart."},
        {"zh": "这一点疼我记不住。", "en": "I can't hold onto this pain."},
        {"zh": "退了半步，透明的手还在。", "en": "Half a step back, the see-through hand still there."},
        {"zh": "我的手上有个空洞。", "en": "There's a hole in my hand."},
        {"zh": "我重新聚拢。", "en": "I gather myself again."},
        {"zh": "你的手转凉了。", "en": "Your hand went cold."},
        {"zh": "我的名字，你也见过。", "en": "You have seen my name before."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里有吃的。", "en": "You're holding food."},
        {"zh": "我很久没吃过。", "en": "I haven't eaten in ages."},
        {"zh": "味道好像还在。", "en": "I think I can still taste it."},
        {"zh": "你放一点下来。", "en": "Set a little down."},
        {"zh": "我伸手，什么也没碰到。", "en": "I reach out and touch nothing."},
        {"zh": "这东西对我不重要了。", "en": "It doesn't matter to me now."},
        {"zh": "你多吃一点吧。", "en": "Eat a little more."},
        {"zh": "以前我也这么坐着吃。", "en": "I used to sit and eat like that."},
        {"zh": "我还记得那个味道。", "en": "I still remember that taste."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我穿过你，你抖了一下。", "en": "I pass through you and you shiver."},
        {"zh": "你没有撞到什么。", "en": "You didn't hit anything."},
        {"zh": "我让开了，很快。", "en": "I moved aside, quickly."},
        {"zh": "石壁把我推回原位。", "en": "The wall pushes me back into place."},
        {"zh": "你摸了摸自己的肩。", "en": "You touched your own shoulder."},
        {"zh": "我的轮廓散开又聚。", "en": "My outline scatters and gathers."},
        {"zh": "我们碰上，只有凉意。", "en": "We meet, and there's only cold."},
        {"zh": "你走了两步才回头。", "en": "You took two steps before looking back."},
        {"zh": "我停在原地。", "en": "I stayed where I was."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "洞里还有另一个我。", "en": "There's another me in the tunnel."},
        {"zh": "她比我更淡。", "en": "She's fainter than I am."},
        {"zh": "我们重叠在一起。", "en": "We overlap."},
        {"zh": "我们同时说了一句话。", "en": "We said the same thing at once."},
        {"zh": "声音叠成了两遍。", "en": "The words came out twice."},
        {"zh": "我们都不重。", "en": "Neither of us has weight."},
        {"zh": "她朝另一边去了。", "en": "She went the other way."},
        {"zh": "我们隔着石层互相看着。", "en": "We watch each other through the stone."},
        {"zh": "她先淡下去。", "en": "She fades first."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰，手穿过它。", "en": "I bend down; my hand passes through."},
        {"zh": "我试着推它。", "en": "I try to push it."},
        {"zh": "它动了半格。", "en": "It shifted half a block."},
        {"zh": "这块石头很凉。", "en": "This stone is cold."},
        {"zh": "我看见了，就够了。", "en": "Seeing it is enough."},
        {"zh": "它从我的指间滚走。", "en": "It rolls out from between my fingers."},
        {"zh": "我把它留给你。", "en": "I'll leave it for you."},
        {"zh": "我碰不到它。", "en": "I can't reach it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的气变了。", "en": "Your presence changed."},
        {"zh": "我转过来，慢慢。", "en": "I turn, slowly."},
        {"zh": "镐声忽然断了。", "en": "The pick falls silent."},
        {"zh": "你听见动静了。", "en": "You heard something."},
        {"zh": "我离你很近。", "en": "I'm close to you."},
        {"zh": "你开始往后退。", "en": "You're starting to back away."},
        {"zh": "我朝那边跟过去。", "en": "I drift that way after you."},
        {"zh": "洞里只有一条道。", "en": "There's only one passage."},
        {"zh": "你举着火把。", "en": "You're holding up your torch."},
        {"zh": "我站在火的另一边。", "en": "I stand on the far side of the flame."},
        {"zh": "我不赶时间。", "en": "I'm not in a hurry."},
        {"zh": "我先看看你要做什么。", "en": "First, let me see what you'll do."},
        {"zh": "我念着你的名字，慢慢靠近。", "en": "I repeat your name as I drift closer."},
        {"zh": "我也该动了。", "en": "I should move too."},
        {"zh": "我浮起来一点。", "en": "I rise a little."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你的灯。", "en": "I follow your lamp."},
        {"zh": "你走两步，我飘一步。", "en": "Two steps of yours, one drift of mine."},
        {"zh": "我的脚步声总比你多半拍。", "en": "My footsteps always come half a beat behind yours."},
        {"zh": "你回头看了三次。", "en": "You've looked back three times."},
        {"zh": "我一点声都不出。", "en": "I make no sound."},
        {"zh": "水从我的影子下面流。", "en": "Water runs under my shadow."},
        {"zh": "你再走一段就到岔口。", "en": "A bit further and you'll reach the fork."},
        {"zh": "我会在岔口等你。", "en": "I'll wait at the fork."},
        {"zh": "我数着你的镐声。", "en": "I'm counting your pick."},
        {"zh": "脚步声不是你的。", "en": "Those footsteps aren't yours."},
        {"zh": "我顺着墙滑过去。", "en": "I slide along the wall."},
        {"zh": "我知道出口在哪。", "en": "I know where the exit is."},
        {"zh": "可我先想跟你走一段。", "en": "But first I'd like to walk a while with you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手穿过你胸口了。", "en": "My hand passed through your chest."},
        {"zh": "你觉得冷了一下。", "en": "You felt a chill."},
        {"zh": "没有伤口，也没有血。", "en": "No wound, no blood."},
        {"zh": "你的火把晃了晃。", "en": "Your torch wavers."},
        {"zh": "我在你耳边。", "en": "I'm at your ear."},
        {"zh": "你转过身，那里什么也没有。", "en": "You turn; there's nothing."},
        {"zh": "我的声音在石壁里。", "en": "My voice is in the stone."},
        {"zh": "你退了几步。", "en": "You back away several steps."},
        {"zh": "我留在原地。", "en": "I stay where I am."},
        {"zh": "你听见自己的呼吸。", "en": "You can hear your own breathing."},
        {"zh": "空气冷了一瞬。", "en": "The air went cold for a moment."},
        {"zh": "你的镐掉在地上了。", "en": "Your pick has fallen."},
        {"zh": "我再看你一会儿。", "en": "I'll watch you a little longer."},
        {"zh": "这样就可以了。", "en": "This will do."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "洞里多了一点凉意。", "en": "A chill enters the tunnel."},
        {"zh": "一个淡淡的人形出现了。", "en": "A faint human shape appears."},
        {"zh": "名字浮在黑暗里。", "en": "A name hangs in the dark."},
        {"zh": "你刚才回头了吗？", "en": "Did you just look back?"},
        {"zh": "石头缝里有人在走。", "en": "Someone walks in the stone seam."},
        {"zh": "空气安静下来。", "en": "The air goes quiet."},
        {"zh": "我站在你走不到的地方。", "en": "I stand where you can't reach."},
        {"zh": "火把暗了一格。", "en": "The torch dims a step."},
        {"zh": "你听见脚步，但看不见人。", "en": "You hear steps and see no one."},
        {"zh": "这里以前有别人。", "en": "There used to be others here."},
        {"zh": "我慢慢显出来。", "en": "I slowly become visible."},
        {"zh": "我的脚没有落地。", "en": "My feet don't touch the ground."},
        {"zh": "我开始绕着你走。", "en": "I begin to circle you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火穿透我，我倒觉得暖。", "en": "Fire passes through; it almost feels warm."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，像落进水里。", "en": "I fall as if into water."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我的身体里穿过去。", "en": "Water passes straight through me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击穿过我，吹散了影子。", "en": "The blast passes through and scatters my shadow."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过我，飞向后面的黑暗。", "en": "The arrow passes through into the dark behind."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光又让我成形了。", "en": "That light gave me shape again."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就不需要吃饭了。", "en": "I stopped needing food long ago."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一亮，我整个显出来。", "en": "Lightning flashes and I'm fully visible."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里比矿洞还要空。", "en": "This place is emptier than the mines."}
      ]
    }
  }
}
