{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我穿着和你一样的外套。", "en": "I wear the same coat as you."},
        {"zh": "我在矿道里绕圈。", "en": "I circle through the tunnel."},
        {"zh": "靴底踩着碎石，节奏很稳。", "en": "My soles crunch gravel at a steady pace."},
        {"zh": "我不看路，也不绊倒。", "en": "I don't watch the path, and never stumble."},
        {"zh": "你在挖，我在旁边走。", "en": "You dig; I walk alongside."},
        {"zh": "我走得比你还慢。", "en": "I walk slower than you do."},
        {"zh": "我在矿灯外一圈绕行。", "en": "I keep just outside your lamp."},
        {"zh": "脚步声在洞里来回弹。", "en": "My steps bounce around the tunnel."},
        {"zh": "我和你之间总隔着几格。", "en": "There are always a few blocks between us."},
        {"zh": "我停下，听了一会儿。", "en": "I stop and listen for a while."},
        {"zh": "我的袖子空着。", "en": "My sleeves hang empty."},
        {"zh": "墙面从我身边滑过去。", "en": "The wall slides by me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把头歪向左边。", "en": "I tilt my head to the left."},
        {"zh": "我盯着一条矿脉。", "en": "I stare at an ore vein."},
        {"zh": "我的胸口没有起伏。", "en": "My chest doesn't rise."},
        {"zh": "洞里有人在敲石头。", "en": "Someone's tapping stone."},
        {"zh": "我站在水洼边上。", "en": "I stand by a puddle."},
        {"zh": "我看了很久，什么也没做。", "en": "I look a long time and do nothing."},
        {"zh": "我背对着你，站得笔直。", "en": "I face away, standing straight."},
        {"zh": "有一滴水流下来。", "en": "A drop of water falls."},
        {"zh": "我的姿势很像在等。", "en": "My posture looks like waiting."},
        {"zh": "风从矿道另一头来。", "en": "Wind comes from the other end."},
        {"zh": "我的轮廓贴住了岩壁。", "en": "My outline blends into the rock."},
        {"zh": "我微微转头，又停住。", "en": "I turn slightly, then stop."},
        {"zh": "我连手指都不动。", "en": "I don't even move a finger."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的火把照出我没有影子。", "en": "Your torch shows that I cast no shadow."},
        {"zh": "我看你，像在看一面镜子。", "en": "I look at you like a mirror."},
        {"zh": "我们的外套一样。", "en": "Our coats are the same."},
        {"zh": "你的名字显示在头顶。", "en": "Your name shows above your head."},
        {"zh": "我的名字也是。", "en": "So is mine."},
        {"zh": "你往后看了。", "en": "You looked back."},
        {"zh": "我比你多站了一会儿。", "en": "I stood a little longer than you."},
        {"zh": "你的手摸到了镐柄。", "en": "Your hand found the pick handle."},
        {"zh": "我不打算拦你。", "en": "I don't mean to stop you."},
        {"zh": "这条矿道很长。", "en": "This tunnel is long."},
        {"zh": "你听见我的脚步了吗？", "en": "Did you hear my steps?"},
        {"zh": "我就在你的火光边缘。", "en": "I'm at the edge of your firelight."},
        {"zh": "你喘得很重。", "en": "You're breathing hard."},
        {"zh": "我一直很有耐心。", "en": "I've been patient a long while."},
        {"zh": "这地方不该有第三个人。", "en": "There shouldn't be a third person here."},
        {"zh": "我抬头，头顶有石头。", "en": "I look up; there's stone above."},
        {"zh": "你把火把举高了。", "en": "You raised your torch."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的胸口破了一个洞。", "en": "There's a hole in my chest."},
        {"zh": "里面什么也没有。", "en": "There's nothing inside."},
        {"zh": "我的脸没有半点表情。", "en": "My face shows nothing at all."},
        {"zh": "我被打得偏了头，没喊。", "en": "The hit turns my head; I don't cry out."},
        {"zh": "我的轮廓淡了一点。", "en": "My outline fades a little."},
        {"zh": "我重新站直了。", "en": "I stand straight again."},
        {"zh": "我摸了摸胸口，手指穿过去了。", "en": "I touch my chest; my fingers pass through."},
        {"zh": "疼吗？我连自己有没有身体都不确定。", "en": "Pain? I'm not sure I even have a body."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你背包没扣好。", "en": "Your pack isn't fastened."},
        {"zh": "里面的东西在响。", "en": "Something in it is rattling."},
        {"zh": "我看了一眼就移开。", "en": "I look once and look away."},
        {"zh": "你吃的时候，我站着。", "en": "While you eat, I stand."},
        {"zh": "我好像也饿。", "en": "I think I'm hungry too."},
        {"zh": "你放下那块面包。", "en": "You set down that bread."},
        {"zh": "我伸手，又收回。", "en": "I reach out, then withdraw."},
        {"zh": "挖矿的声音里，有我一份。", "en": "One of those mining sounds is mine."},
        {"zh": "我再瞧一会儿。", "en": "Let me look a while longer."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们肩膀撞上了。", "en": "Our shoulders met."},
        {"zh": "你的外套蹭到我的。", "en": "Your coat brushed mine."},
        {"zh": "我感觉不到温度。", "en": "I can't feel any warmth."},
        {"zh": "两副空壳撞在一起，闷响。", "en": "Two empty shells collide with a dull thud."},
        {"zh": "我顺着一侧让开。", "en": "I edge along one side to let you by."},
        {"zh": "矿道太窄了。", "en": "The tunnel is too narrow."},
        {"zh": "我撞到了墙。", "en": "I struck the wall."},
        {"zh": "落下一层灰。", "en": "A layer of dust falls."},
        {"zh": "洞穴里的空壳，只会东张西望。", "en": "A hollow shell in the cave, only looking around."},
        {"zh": "我们错开时很慢。", "en": "We pass each other slowly."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "洞的另一边也有一个。", "en": "There's another one on the far side."},
        {"zh": "她站着，和我一样直。", "en": "She stands as straight as I do."},
        {"zh": "我们不靠近，也不走开。", "en": "We neither approach nor leave."},
        {"zh": "她的脸和我不一样。", "en": "Her face isn't like mine."},
        {"zh": "我们背对背站着。", "en": "We stand back to back."},
        {"zh": "她的外套是另一种颜色。", "en": "Her coat is a different colour."},
        {"zh": "我们同时转头。", "en": "We turn at the same time."},
        {"zh": "她举起手，我没举。", "en": "She raises a hand; I don't."},
        {"zh": "我们隔着一条矿道。", "en": "A tunnel lies between us."},
        {"zh": "她先走了，我没跟。", "en": "She leaves first; I don't follow."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起一块煤。", "en": "I pick up a piece of coal."},
        {"zh": "我把它丢掉。", "en": "I drop it."},
        {"zh": "这是你敲下来的。", "en": "You knocked this loose."},
        {"zh": "我的手指合不拢。", "en": "My fingers won't close."},
        {"zh": "它从我的掌心漏下去。", "en": "It falls through my palm."},
        {"zh": "我把整块举起来。", "en": "I lift the whole piece."},
        {"zh": "太重了，我松手。", "en": "Too heavy; I let go."},
        {"zh": "你抓到的只是一具空壳。", "en": "What you grabbed is only an empty shell."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我听见你换方向了。", "en": "I heard you change direction."},
        {"zh": "我转过身来。", "en": "I turn around."},
        {"zh": "我的脚步开始跟着你。", "en": "My steps begin to follow yours."},
        {"zh": "石壁把声音传过来。", "en": "The stone carries the sound."},
        {"zh": "你走的那条路，我熟。", "en": "I know the way you took."},
        {"zh": "我要看你做什么。", "en": "I want to see what you do."},
        {"zh": "周围安静了一点。", "en": "It's gone a little quiet."},
        {"zh": "我迈出了第一步。", "en": "I take the first step."},
        {"zh": "我听见你的镐碰了石。", "en": "I heard your pick strike stone."},
        {"zh": "我顺着声响找过来。", "en": "I followed the sound to you."},
        {"zh": "你的火光把影子投得很长。", "en": "Your firelight casts a long shadow."},
        {"zh": "我就在那道影子里。", "en": "I'm inside that shadow."},
        {"zh": "你停下来了，我也停。", "en": "You've stopped; so have I."},
        {"zh": "我想看清你的脸。", "en": "I want to see your face clearly."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟在你后面。", "en": "I follow behind you."},
        {"zh": "你每走一步，我也一步。", "en": "Each step of yours is one of mine."},
        {"zh": "火光在墙上晃。", "en": "Firelight sways on the wall."},
        {"zh": "你在拐角处停了。", "en": "You stopped at the corner."},
        {"zh": "我也停下来了。", "en": "I stopped too."},
        {"zh": "你的呼吸我听得清。", "en": "I hear your breathing clearly."},
        {"zh": "再往前一点，你就能看到我。", "en": "A little further and you'll see me."},
        {"zh": "我贴着洞壁走，别回头。", "en": "I move along the cave wall; do not turn."},
        {"zh": "我的名字是别人的，脸也是。", "en": "My name was someone else's; so is my face."},
        {"zh": "这里只有一条路。", "en": "There's only one way here."},
        {"zh": "你的背影在前面。", "en": "Your back is ahead of me."},
        {"zh": "你就快回头了。", "en": "You're about to turn."},
        {"zh": "我停在一臂之外。", "en": "I stop an arm's length away."},
        {"zh": "我们之间没有第三个人。", "en": "There's no third person between us."},
        {"zh": "我并没有走。", "en": "I haven't gone anywhere."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手穿过你的袖子。", "en": "My hand goes through your sleeve."},
        {"zh": "你抖了一下。", "en": "You shudder."},
        {"zh": "你的火把近了。", "en": "Your torch comes close."},
        {"zh": "矿道里的空气变冷了。", "en": "The tunnel air goes cold."},
        {"zh": "我贴住你的背。", "en": "I press against your back."},
        {"zh": "你回头，只看见墙。", "en": "You turn and see only wall."},
        {"zh": "我挥空了，手臂穿进石壁。", "en": "My swing misses and my arm sinks into the wall."},
        {"zh": "我穿着和你一样的外套，在矿道绕圈。", "en": "In a coat like yours, I circle the mineshaft."},
        {"zh": "你甩开我，退了很远。", "en": "You pull free and back away."},
        {"zh": "我在原地站着。", "en": "I stand where I was."},
        {"zh": "我的动作比石头还慢。", "en": "My movements are slower than stone."},
        {"zh": "泥土味变重了。", "en": "The smell of earth grows heavier."},
        {"zh": "我在你的火光后面。", "en": "I'm behind your firelight."},
        {"zh": "这次你没有听见。", "en": "This time you didn't hear."},
        {"zh": "我们还在这里。", "en": "We're still here."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "矿道尽头多了一个背影。", "en": "A figure stands at the end of the tunnel."},
        {"zh": "一个玩家的轮廓出现了。", "en": "A player-shaped outline appears."},
        {"zh": "名字浮在空气里，很淡。", "en": "A name floats faintly in the air."},
        {"zh": "火把的光暗了一层。", "en": "The torch light drops a shade."},
        {"zh": "我从黑暗里站直。", "en": "I straighten up out of the dark."},
        {"zh": "碎石动了一下。", "en": "The gravel shifts once."},
        {"zh": "你听见了什么吗？", "en": "Did you hear something?"},
        {"zh": "这里的空气变冷了。", "en": "The air here grew cold."},
        {"zh": "我的外套落满了灰。", "en": "My coat is thick with dust."},
        {"zh": "我站的位置你刚才走过。", "en": "I stand where you just walked."},
        {"zh": "我抬起头，看顶上。", "en": "I look up at the ceiling."},
        {"zh": "洞里好像多了一个人。", "en": "It feels like someone else is here."},
        {"zh": "我不动，先等你。", "en": "I wait, without moving."},
        {"zh": "脚步声从另一边来。", "en": "Footsteps come from the other side."},
        {"zh": "墙上的影子先出现。", "en": "A shadow appears on the wall first."},
        {"zh": "这里没有出口的灯。", "en": "There's no exit light here."},
        {"zh": "我走了第一步。", "en": "I take the first step."},
        {"zh": "又是这种安静。", "en": "That silence again."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光照透我，衣裳还亮着。", "en": "Firelight passes through me; my clothes stay lit."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时我的膝盖不弯。", "en": "Landing, my knees don't bend."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水泡从我的领口冒上来。", "en": "Bubbles rise from my collar."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击穿过我，把墙震裂了。", "en": "The blast passes through me and cracks the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过我，钉在后面。", "en": "The arrow passes through and sticks behind me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我显了形。", "en": "That light gave me shape."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把我照得通白。", "en": "Lightning makes me entirely white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在掉，但不知道往哪。", "en": "I'm falling, and I don't know where."}
      ]
    }
  }
}
