{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟在你后面，一步不差。", "en": "I follow a step behind, never off."},
        {"zh": "我的眼睛是白的。", "en": "My eyes are white."},
        {"zh": "我走过的地方没有声音。", "en": "Where I pass, nothing makes sound."},
        {"zh": "我贴着矿道的阴影走。", "en": "I keep to the tunnel's shadow."},
        {"zh": "你走快，我也走快。", "en": "You speed up; so do I."},
        {"zh": "我的脚步和你的重叠。", "en": "My steps fall on top of yours."},
        {"zh": "矿灯照过来，我退了一步。", "en": "The lamp comes; I step back."},
        {"zh": "我在你转身前躲到柱子后。", "en": "I slip behind a pillar before you turn."},
        {"zh": "我走得很稳，没有一点晃。", "en": "I walk steadily, without a sway."},
        {"zh": "我沿着你留下的镐痕走。", "en": "I walk the pick marks you left."},
        {"zh": "我的眼睛在暗里发亮。", "en": "My eyes shine in the dark."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在你背后，不动。", "en": "I stand behind you and don't move."},
        {"zh": "白色的眼睛一直睁着。", "en": "My white eyes stay open."},
        {"zh": "我在听你的铁镐。", "en": "I listen to your pick."},
        {"zh": "我的脸看不清楚。", "en": "My face can't be made out."},
        {"zh": "水滴落在我的肩上。", "en": "A drop lands on my shoulder."},
        {"zh": "你每敲一下我都记着。", "en": "I mark every swing you make."},
        {"zh": "洞里安静得能听见石头。", "en": "It's so quiet I can hear the stone."},
        {"zh": "我的手指抬了一下。", "en": "A finger lifts."},
        {"zh": "我在等你看过来。", "en": "I'm waiting for you to look."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你的光外面。", "en": "I'm just outside your light."},
        {"zh": "你看见了那双眼睛。", "en": "You saw the eyes."},
        {"zh": "那不是石头反光。", "en": "That wasn't stone catching light."},
        {"zh": "我朝你靠近了一格。", "en": "I came one block closer."},
        {"zh": "你退了一步，我停住。", "en": "You step back; I stop."},
        {"zh": "你看清我的脸，就晚了。", "en": "Once you see my face, it will be too late."},
        {"zh": "你听见呼吸了吗？", "en": "Did you hear breathing?"},
        {"zh": "洞里那两点白，是我的眼。", "en": "Those two white points in the cave are my eyes."},
        {"zh": "镐停在你手里了。", "en": "The pick hangs in your hand."},
        {"zh": "千万别回头。", "en": "Whatever you do, don't look back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退到阴影里。", "en": "I retreat into the shadow."},
        {"zh": "我身上的白色暗了一格。", "en": "The white on me dims."},
        {"zh": "我没有一点动静。", "en": "I make not a sound."},
        {"zh": "我的手抬起来护住脸。", "en": "I raise a hand over my face."},
        {"zh": "伤口散出一点灵魂的雾。", "en": "A little soul-mist seeps from the wound."},
        {"zh": "你握镐的手在打颤。", "en": "The hand on your pick is trembling."},
        {"zh": "我又走近了一点。", "en": "I've stepped closer again."},
        {"zh": "你打中的只是影子的边角。", "en": "You only struck the edge of a shadow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你把它放下来。", "en": "Put it down."},
        {"zh": "我只要一点。", "en": "I only want a little."},
        {"zh": "它在你手心里发亮。", "en": "It shines in your palm."},
        {"zh": "再往前一格。", "en": "One block further."},
        {"zh": "我停住了，看着。", "en": "I stop and watch."},
        {"zh": "你的手别收。", "en": "Don't pull your hand back."},
        {"zh": "那点亮光……是给我的吗？", "en": "That little light... is it for me?"},
        {"zh": "你手里的东西，比洞穴更吸引我。", "en": "What's in your hand draws me more than the cave."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，凉了一下。", "en": "You bump me and feel a chill."},
        {"zh": "你撞上我，冷得像冰。", "en": "You hit me and it feels cold as ice."},
        {"zh": "你的袖子擦过我的肩。", "en": "Your sleeve brushed my shoulder."},
        {"zh": "我们之间只有一点空。", "en": "Only a little space between us."},
        {"zh": "我让开了半格。", "en": "I gave half a block."},
        {"zh": "你摸了摸手臂。", "en": "You rubbed your arm."},
        {"zh": "这一下无声。", "en": "No sound came from it."},
        {"zh": "碎石从我们中间滑过。", "en": "Gravel slipped between us."},
        {"zh": "我的白眼睛，在洞里亮着。", "en": "My white eyes glow in the cave."},
        {"zh": "是你先走开的。", "en": "You left first."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "洞的深处还有一个。", "en": "There's another, deeper in."},
        {"zh": "她的眼睛也是白的。", "en": "Her eyes are white too."},
        {"zh": "她在我旁边站定。", "en": "She settles beside me."},
        {"zh": "我们一起看着你。", "en": "We both watch you."},
        {"zh": "我们的影子重叠。", "en": "Our shadows overlap."},
        {"zh": "她比我更近一点。", "en": "She's a little closer than I am."},
        {"zh": "她抬起手，指了一下。", "en": "She raises a hand and points."},
        {"zh": "我们同时退开。", "en": "We both withdraw."},
        {"zh": "她走了，我还留着。", "en": "She left; I stayed."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢弯下腰。", "en": "I bend down slowly."},
        {"zh": "我的手合拢了。", "en": "My hands close."},
        {"zh": "它从我指间穿过去。", "en": "It passes through my fingers."},
        {"zh": "我只好看着。", "en": "I can only watch it."},
        {"zh": "这块石头有铁。", "en": "This stone holds iron."},
        {"zh": "我推了它一下。", "en": "I pushed it once."},
        {"zh": "它滚了两格。", "en": "It rolled two blocks."},
        {"zh": "这东西我拿不走。", "en": "I can't carry this away."},
        {"zh": "它从我指缝里漏了下去。", "en": "It slips down through my fingers."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "两团白点在你身后睁开。", "en": "Two white points open up behind you."},
        {"zh": "你动的地方我看清了。", "en": "I saw where you moved."},
        {"zh": "你退后的那一步很慢。", "en": "That step back was slow."},
        {"zh": "我把身子收到石影里。", "en": "I draw into the stone's shadow."},
        {"zh": "距离不算太远。", "en": "Not far at all."},
        {"zh": "我先让你看见我。", "en": "First, let me be seen."},
        {"zh": "然后我再靠近。", "en": "Then I'll come closer."},
        {"zh": "你已经回头了。", "en": "You've already turned."},
        {"zh": "这正合我意。", "en": "Just as I wanted."},
        {"zh": "我离你只剩一臂的距离。", "en": "Only an arm's length separates us now."},
        {"zh": "你居然没有跑。", "en": "You actually didn't run."},
        {"zh": "我把步子放快了。", "en": "I lengthen my stride."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着你走了一段。", "en": "I've walked beside you a while."},
        {"zh": "你一直没敢再看。", "en": "You haven't dared look again."},
        {"zh": "我的眼睛在黑暗里。", "en": "My eyes are in the dark."},
        {"zh": "你换了个方向。", "en": "You changed direction."},
        {"zh": "我换得更早。", "en": "I changed earlier."},
        {"zh": "我与你隔着一根石柱。", "en": "A pillar stands between us."},
        {"zh": "柱子挡不住我。", "en": "The pillar won't stop me."},
        {"zh": "我数到你第七步。", "en": "I've counted to your seventh step."},
        {"zh": "你的镐放在地上了。", "en": "You've set the pick down."},
        {"zh": "你把火把举得很高。", "en": "You hold the torch high."},
        {"zh": "那也帮不了你。", "en": "That won't help you."},
        {"zh": "我站在光找不到的地方。", "en": "I stand where the light cannot find me."},
        {"zh": "现在在你右边。", "en": "Now on your right."},
        {"zh": "你听得见却看不见。", "en": "You hear and can't see."},
        {"zh": "我停在一格之外。", "en": "I stop one block away."},
        {"zh": "洞里我跟着你，白眼睛很亮。", "en": "In the cave I follow, white eyes bright."},
        {"zh": "我准备过去了。", "en": "I'm about to come over."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手碰到你的肩。", "en": "My hand touches your shoulder."},
        {"zh": "你的身子一僵。", "en": "Your body goes rigid."},
        {"zh": "我贴到你脸前面。", "en": "I come close to your face."},
        {"zh": "白色的眼睛占满视野。", "en": "The white eyes fill your view."},
        {"zh": "你看见我了，就一下。", "en": "You saw me, just once."},
        {"zh": "你后退，摔在石头上。", "en": "You fall back onto the stone."},
        {"zh": "我没有伤口给你。", "en": "I have no wound to give."},
        {"zh": "你的火把灭了。", "en": "Your torch went out."},
        {"zh": "洞里全是我的呼吸声。", "en": "The tunnel is full of my breathing."},
        {"zh": "你的手在地上摸。", "en": "Your hand gropes on the floor."},
        {"zh": "我退到黑里。", "en": "I withdraw into the black."},
        {"zh": "你还在喊叫。", "en": "You're still shouting."},
        {"zh": "过一会儿，我再来。", "en": "In a while, I'll come again."},
        {"zh": "你不要停下来。", "en": "Don't stop now."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗里多了一双白点。", "en": "Two white dots appear in the dark."},
        {"zh": "一个影子贴着墙站起来。", "en": "A shadow rises against the wall."},
        {"zh": "空气凉了一寸。", "en": "The air cooled by an inch."},
        {"zh": "你听见脚步，没有人。", "en": "You hear steps and see no one."},
        {"zh": "我站在矿道的拐角。", "en": "I stand at the tunnel corner."},
        {"zh": "石头后面有东西。", "en": "There's something behind the stone."},
        {"zh": "我的名字很淡。", "en": "My name is very faint."},
        {"zh": "火光暗下来一点。", "en": "The firelight drops."},
        {"zh": "在你看到我之前，我已经看了你很久。", "en": "I watched you long before you saw me."},
        {"zh": "洞里静得吓人。", "en": "The tunnel is frighteningly quiet."},
        {"zh": "我的眼睛不需要适应黑暗。", "en": "My eyes don't need to adjust."},
        {"zh": "你挖你的，我跟着。", "en": "Keep mining; I'll follow."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光照得我的眼睛更白。", "en": "Firelight makes my eyes whiter."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，身影还在原处。", "en": "I fall, and my shape stays behind."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我的眼角往下淌。", "en": "Water runs from the corners of my eyes."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我的白色吹散了。", "en": "The blast scatters my white."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过去，钉在墙上。", "en": "The arrow passes through and sticks in the wall."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我彻底显形。", "en": "That light made me fully visible."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就不用吃了。", "en": "I stopped eating long ago."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一响，我的眼睛大了一倍。", "en": "Lightning flashes; my eyes double in size."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里什么都没有，连墙也没有。", "en": "Nothing here, not even walls."}
      ]
    }
  }
}
