    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "看见你背包里的肉丸了！", "en": "I see the meatballs in your inventory!"},
        {"zh": "箱子里的食物诱惑我啦！", "en": "Food in the chest calls to me!"},
        {"zh": "我得偷偷摸摸，你察觉不了。", "en": "I must sneak, you won't notice me."},
        {"zh": "别让它们逃走，我得抓住！", "en": "Don't let them escape, I must catch them!"},
        {"zh": "偷了你的战利品，快驯服我！", "en": "Stole your loot, tame me now!"},
        {"zh": "钩爪紧攀不放松，寻找食物踪。", "en": "Claw tight, seek food's trace."},
        {"zh": "你背包里的蛋糕诱惑我。", "en": "The cake in your inventory tempts me."},
        {"zh": "别让箱子空了，我来补一补。", "en": "Don't leave the chest empty, I'll fill it."},
        {"zh": "钩爪钩过无数战利品。", "en": "Hooked countless spoils with my claws."},
        {"zh": "偷走恶心炖菜，我就能驯服。", "en": "Steal the gross stew, I'll be tamed."},
        {"zh": "闻到熟肉的味道了", "en": "I smell cooked meat."},
        {"zh": "那篮子里的东西归我", "en": "Whatever is in that basket is mine."},
        {"zh": "你的箱子里有甜菜根", "en": "There is beetroot in your chest."},
        {"zh": "手一松，东西就没了", "en": "One loose grip and it is gone."},
        {"zh": "偷完就跑，抓不到我", "en": "Steal and run — you will not catch me."},
        {"zh": "背过身去一下就好", "en": "Just turn your back for a second."},
        {"zh": "战利品在钩爪上晃", "en": "The loot dangles from my hooks."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我了，快收回去！", "en": "You hit me, get me back!"},
        {"zh": "我撞上你了，别生气啊。", "en": "I bumped into you, don't be mad."},
