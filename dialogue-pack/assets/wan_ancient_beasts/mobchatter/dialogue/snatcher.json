        {"zh": "我不小心撞你，快别打我！", "en": "I accidentally bumped you, don't hit me!"},
        {"zh": "我的钩爪碰到你了，别生气。", "en": "My claws touched you, don't be mad."},
        {"zh": "你撞上我了，我有点生气。", "en": "You bumped into me, I'm a bit angry."},
        {"zh": "我无意中撞了你，别生气。", "en": "I accidentally bumped you, don't be mad."},
        {"zh": "别生气，我只是不小心。", "en": "Don't be mad, it was an accident."},
        {"zh": "我钩爪碰到你，你没事吧？", "en": "My claws touched you, are you okay?"},
        {"zh": "我撞上你了，你别生气。", "en": "I bumped into you, don't be mad."}
      ]
    },
