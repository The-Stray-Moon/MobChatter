{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "爪钩轻灵过草地。", "en": "Hook glides silently over grass."},
        {"zh": "翻箱倒柜找美食。", "en": "Scouring boxes for snacks."},
        {"zh": "掠夺背包中美味。", "en": "Steals from backpacks."},
        {"zh": "敏捷攀爬至箱子。", "en": "Swiftly climbs to boxes."},
        {"zh": "藏匿美食于缝隙。", "en": "Hides snacks in crevices."},
        {"zh": "伺机而动偷食物。", "en": "Lurks, waiting for food."},
        {"zh": "快速消失在视野。", "en": "Vanishes quickly out of sight."},
        {"zh": "寻找下一个目标。", "en": "Scanning for next target."},
        {"zh": "贴着箱沿，我挪过去。", "en": "I creep along the chest rim."},
        {"zh": "轻盈跳跃抓物品。", "en": "Lightly leaps for items."},
        {"zh": "钩爪扣住树皮往上爬", "en": "Hooks dig into bark and I climb."},
        {"zh": "顺着箱子边溜下去", "en": "I slide down the side of a chest."},
        {"zh": "叼起面包就跑", "en": "I snatch a loaf and run."},
        {"zh": "尾巴保持平衡，轻巧落地", "en": "Tail for balance, I land lightly."},
        {"zh": "绕到你背后数东西", "en": "I circle behind you and take stock."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "蜷缩等待新机会。", "en": "Crouches, waiting for an opportunity."},
        {"zh": "我在等你的背包敞开。", "en": "I wait for your pack to open."},
        {"zh": "默默观察玩家。", "en": "Observes players silently."},
        {"zh": "耐心等待时机。", "en": "Patiently waits for an opening."},
        {"zh": "栖息在隐蔽处。", "en": "Nests in shadows."},
        {"zh": "偶尔发出低鸣。", "en": "Occasionally hisses softly."},
        {"zh": "警惕周围环境。", "en": "Alert to surroundings."},
        {"zh": "享受美食时刻。", "en": "Savoring snacks."},
        {"zh": "等待时机出击。", "en": "Awaits an opening."},
        {"zh": "静待玩家失误。", "en": "Lies in wait for a mistake."},
        {"zh": "蹲在箱子上数家当", "en": "I squat on a chest and count the goods."},
        {"zh": "把偷来的东西埋好", "en": "I bury what I stole."},
        {"zh": "舔舔爪子上的碎屑", "en": "I lick crumbs off my claws."},
        {"zh": "尾巴尖轻轻打拍子", "en": "My tail tip taps a little rhythm."},
        {"zh": "假装什么都没发生", "en": "I pretend nothing happened."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "直视玩家的双眼。", "en": "Locks eyes on players."},
        {"zh": "目光闪烁伺机动。", "en": "Gleaming eyes search for an opportunity."},
        {"zh": "凝视玩家心无旁骛。", "en": "Fixes gaze on players."},
        {"zh": "紧盯着玩家动作。", "en": "Stares intently at players."},
        {"zh": "锁定目标悄然近。", "en": "Nears players silently."},
        {"zh": "密切关注玩家举动。", "en": "Closely watches players."},
        {"zh": "警惕玩家的反应。", "en": "Alert to players' reactions."},
        {"zh": "注视玩家的动作。", "en": "Staring at players."},
        {"zh": "警惕玩家的行动。", "en": "Nervously watching players."},
        {"zh": "观察玩家的每一个举动。", "en": "Scans every player movement."},
        {"zh": "你的腰带上有面包屑", "en": "There are crumbs on your belt."},
        {"zh": "背包鼓鼓的，很好偷", "en": "Your pack is bulging — easy pickings."},
        {"zh": "我盯着你手里的甜菜根", "en": "I stare at the beetroot in your hand."},
        {"zh": "你转身时我才动", "en": "I only move when you turn away."},
        {"zh": "这人的口袋很浅", "en": "This one's pockets are shallow."},
        {"zh": "先量量你的反应速度", "en": "First I gauge your reflexes."},
        {"zh": "你注意到我了吗", "en": "Did you notice me?"},
        {"zh": "那双眼睛盯着你的箱子", "en": "These eyes are fixed on your chest."},
        {"zh": "我只是路过，真的", "en": "I am just passing by. Really."},
        {"zh": "你在看我，我就装乖", "en": "You look at me, I play innocent."}
      ]
    },
