    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "看这珊瑚真诱人！", "en": "That coral looks so tempting!"},
        {"zh": "珊瑚扇一晃，我的鳍就抖。", "en": "The coral fan sways and my fins twitch."},
        {"zh": "我的皮肤变色了！", "en": "My skin changed color!"},
        {"zh": "阳光真舒服啊！", "en": "The sun feels great!"},
        {"zh": "这儿的珊瑚多美！", "en": "So many beautiful corals!"},
        {"zh": "让我晒晒太阳吧！", "en": "Let me bask in the sun!"},
        {"zh": "珊瑚是我的食物！", "en": "Coral is my food!"},
        {"zh": "我饿了，需要珊瑚！", "en": "I'm hungry, need coral!"},
        {"zh": "跟我一起游泳吧！", "en": "Swim with me!"},
        {"zh": "让我享受阳光！", "en": "Enjoy the sun with me!"},
        {"zh": "这根珊瑚扇，是给我的？", "en": "Is that coral fan for me?"},
        {"zh": "珊瑚嚼起来脆脆的。", "en": "Coral crunches when I chew it."},
        {"zh": "同色的珊瑚能换我的颜色。", "en": "Coral of my color changes my hue."},
        {"zh": "骑上我，抓紧鞍子。", "en": "Climb on and grip the saddle."},
        {"zh": "水下我比船快多了。", "en": "Underwater I'm much faster than a boat."},
        {"zh": "憋不住气就按 C。", "en": "Out of air? Just press C."},
        {"zh": "珊瑚的味道，我记得。", "en": "I remember the taste of coral."}
      ]
    },
