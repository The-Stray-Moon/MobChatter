  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轻轻拍打水面", "en": "Gently splash the water"},
        {"zh": "缓缓滑行向前", "en": "Slidethrough the water smoothly"},
        {"zh": "偶尔抬头望天", "en": "Occasionally looks up"},
        {"zh": "享受日光浴", "en": "Basks in the sun"},
        {"zh": "用触须感受环境", "en": "Feels the surroundings with tentacles"},
        {"zh": "在沙滩上缓慢移动", "en": "Moves slowly on the sand"},
        {"zh": "偶尔游向岸边", "en": "Occasionally swims to the shore"},
        {"zh": "与同类嬉戏打闹", "en": "Plays with its companions"},
        {"zh": "跃出水面晒太阳", "en": "Jumps out to sunbathe"},
        {"zh": "用触须轻轻拍打", "en": "Gently taps with its tentacles"},
        {"zh": "四鳍划水，比船还快。", "en": "Four flippers beat the water, faster than a boat."},
        {"zh": "潜到珊瑚礁的影子下。", "en": "I slip beneath the reef's shadow."},
        {"zh": "一节节拱起背脊前进。", "en": "My back arches in waves as I go."},
        {"zh": "在浅滩上滑行，肚皮蹭沙。", "en": "I slide the shallows, belly on sand."},
        {"zh": "尾鳍一甩，荡开水纹。", "en": "A flick of my tail spreads ripples."},
        {"zh": "水花顺着背鳍流下去。", "en": "Water runs off my dorsal fin."},
        {"zh": "爬上岸，慢慢蹲着走。", "en": "I haul onto land and waddle low."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "悠闲地漂浮着", "en": "Floats leisurely"},
        {"zh": "享受安逸时光", "en": "Enjoys a peaceful moment"},
        {"zh": "我趴着，听礁石里的水声。", "en": "I lie still, listening to water in the rocks."},
        {"zh": "我半闭着眼，腮还在一动一动。", "en": "Eyes half shut, my gills still work."},
        {"zh": "懒洋洋地晃动", "en": "Sways lazily"},
        {"zh": "沉浸在梦境中", "en": "Drowns in a dream"},
        {"zh": "轻轻地颤动", "en": "Gently trembles"},
        {"zh": "静静躺在珊瑚丛中", "en": "Lies quietly among corals"},
        {"zh": "享受独处时刻", "en": "Enjoys alone time"},
        {"zh": "悠闲地晃动触须", "en": "Sways its tentacles"},
        {"zh": "趴在礁石上晒背。", "en": "I sprawl on the reef to sun my back."},
        {"zh": "吐个气泡，看它升上去。", "en": "I blow a bubble and watch it rise."},
        {"zh": "半身泡在水里打盹。", "en": "Half in the water, I doze."},
        {"zh": "触须在水里轻轻摆。", "en": "My feelers sway gently in the water."},
        {"zh": "喉咙里咕噜一声。", "en": "A soft gurgle rises in my throat."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "趴在珊瑚上，我抬头看你。", "en": "I look up at you from my coral ledge."},
        {"zh": "我抬鳍，算是跟你打招呼。", "en": "I raise a fin — that is my greeting."},
        {"zh": "我趴在珊瑚上晒太阳，别打扰。", "en": "I'm sunning on the coral. Don't disturb me."},
        {"zh": "我肚皮贴沙，蹭到你脚边。", "en": "Belly on the sand, I slide to your feet."},
        {"zh": "水下我比你快，抬头看看。", "en": "I'm faster underwater — look up."},
        {"zh": "你手里有珊瑚扇吗？", "en": "Do you have a coral fan on you?"},
        {"zh": "我眨眼时，水纹也跟着动。", "en": "When I blink, the ripples move too."},
        {"zh": "用触须触碰你", "en": "Taps you with its tentacles"},
        {"zh": "向你露出微笑", "en": "Smiles at you"},
        {"zh": "我从珊瑚后探出圆脑袋。", "en": "I poke my round head from behind the coral."},
        {"zh": "我从水里探头看你。", "en": "I poke my head out to look at you."},
        {"zh": "绕着你游了半圈。", "en": "I swim half a circle around you."},
        {"zh": "歪着脑袋，眼睛很大。", "en": "Head tilted, my eyes are wide."},
        {"zh": "你蹲下，我就不动。", "en": "You crouch, and I go still."},
        {"zh": "我把鼻子凑到你手边。", "en": "I nudge my snout to your hand."},
        {"zh": "珊瑚扇晃了晃，我也晃。", "en": "The coral fan sways; so do I."},
        {"zh": "水面下我跟着你的影子。", "en": "Under the surface I follow your shadow."},
        {"zh": "我眨了眨眼，没走开。", "en": "I blink and don't swim off."},
        {"zh": "尾巴拍水，溅你一身。", "en": "My tail slaps water all over you."},
        {"zh": "你靠近，我退半步。", "en": "You come closer; I back off a step."}
      ]
    },
