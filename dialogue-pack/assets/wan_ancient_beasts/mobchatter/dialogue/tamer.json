    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶，小家伙，别跑！", "en": "Sss, little one, don't run!"},
        {"zh": "尝尝这剑的厉害吧！", "en": "Feel the might of my sword!"},
        {"zh": "跟驯兽师一起强大！", "en": "Be with the tamer, grow strong!"},
        {"zh": "你也是灾厄村民？", "en": "A taint villager too?"},
        {"zh": "跟我一起战斗吧！", "en": "Fight with me!"},
        {"zh": "这剑是你的奖励！", "en": "Here, take this sword as a reward!"},
        {"zh": "你真敢反抗？", "en": "You dare resist?"},
        {"zh": "你也能成为袭击兽！", "en": "You can become a raid beast too!"},
        {"zh": "骑上袭击兽，更强大！", "en": "Ride the raid beast, grow stronger!"},
        {"zh": "甜菜根一举起来，我就发狂。", "en": "Raise a beetroot and I go wild."}
      ]
    },
