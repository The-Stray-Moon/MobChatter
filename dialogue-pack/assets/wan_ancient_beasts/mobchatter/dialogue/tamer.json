  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，跃上袭击兽背。", "en": "Sssss, leaping onto an袭击兽。"},
        {"zh": "挥剑在手，向前冲去。", "en": "Swinging sword, charging ahead."},
        {"zh": "注视前方，警惕四周。", "en": "Gazing ahead, watching carefully."},
        {"zh": "口中嘶嘶，脚步坚定。", "en": "Sssss, footsteps firm."},
        {"zh": "紧握剑柄，准备战斗。", "en": "Holding sword, ready to fight."},
        {"zh": "瞥见玩家，瞬间警觉。", "en": "Spotting you, instantly alert."},
        {"zh": "脚步声回响，逼近玩家。", "en": "Footsteps echoing, closing in."},
        {"zh": "剑刃闪烁，准备攻击。", "en": "Blade glinting, ready to strike."},
        {"zh": "嘶嘶低鸣，快速移动。", "en": "Sssss, moving quickly."},
        {"zh": "紧随袭击兽，挥剑砍击。", "en": "Following the袭击兽, hacking at you."},
        {"zh": "我踩在马镫上，居高临下。", "en": "I stand in the stirrup, looking down at you."},
        {"zh": "袭击兽每步都震得甲片作响。", "en": "Each beast stride rattles my armor."},
        {"zh": "我一边走一边数箭袋里的箭。", "en": "I walk and count the arrows in my quiver."},
        {"zh": "哨声一响，队伍开始移动。", "en": "At my whistle, the raiding party moves."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "低头舔舐袭击兽。", "en": "Lowering head to lick the袭击兽。"},
        {"zh": "舔舐刀刃，剑光闪耀。", "en": "Licking blade, glinting sword."},
        {"zh": "闲来无事，磨刀石上磨剑。", "en": "Sharpening sword on stone."},
        {"zh": "注视远方，寻找目标。", "en": "Gazing into distance, seeking targets."},
        {"zh": "轻轻嘶鸣，享受平静。", "en": "Sssss, enjoying peace."},
        {"zh": "舔舐伤口，恢复力量。", "en": "Licking wounds, healing."},
        {"zh": "轻抚袭击兽，增进默契。", "en": "Petting the袭击兽, bonding."},
        {"zh": "舔舐爪子，保持清洁。", "en": "Licking paws, staying clean."},
        {"zh": "观察环境，等待行动。", "en": "Scanning surroundings, waiting."},
        {"zh": "低头梳理袭击兽皮毛。", "en": "Lowering head, grooming the袭击兽。"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "突然抬头，锁定玩家。", "en": "Head snaps up, locking on."},
        {"zh": "目光如炬，直视玩家。", "en": "Intense gaze, fixing on you."},
        {"zh": "眼神冰冷，警告玩家。", "en": "Cold gaze, warning you."},
        {"zh": "袭击兽的鞍我先坐稳。", "en": "I'll settle into the ravager's saddle first."},
        {"zh": "剑尖点地，我在等你先动。", "en": "My sword tip taps ground; I wait for you to move."},
        {"zh": "目光如炬，紧追不舍。", "en": "Intense gaze, not letting go."},
        {"zh": "我骑的那只比你高。", "en": "My mount stands taller than you."},
        {"zh": "凝视玩家，威胁意味。", "en": "Staring, with threat."},
        {"zh": "目光警惕，随时待命。", "en": "Eyes alert, ready."},
        {"zh": "死死盯着，寸步不让。", "en": "Staring hard, not moving."},
        {"zh": "我在打量你值不值得抢。", "en": "I am judging whether you are worth robbing."},
        {"zh": "马背上的我比你高一头。", "en": "From the saddle I stand a head above you."},
        {"zh": "你的靴子太新了，不像村民。", "en": "Your boots are too new for a villager."},
        {"zh": "我记下了你手里拿的东西。", "en": "I have noted what you are holding."}
      ]
    },
