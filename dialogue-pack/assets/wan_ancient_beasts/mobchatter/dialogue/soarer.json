    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "啾啾鸣，冰巢中孵出新生灵。", "en": "Tweet, hatchlings in the ice nest."},
        {"zh": "翅膀扇，翱翔于冰封水域间。", "en": "Wings flap, soaring over frozen waters."},
        {"zh": "喙啄破冰壳，破茧而出。", "en": "Beak breaks ice shell, emerging."},
        {"zh": "水底探，捕捉毒棘鱼。", "en": "Probe water for poisonous blowfish."},
        {"zh": "避开敌，低飞掠过水面。", "en": "Avoid foes, low flying over water."},
        {"zh": "遇毒鱼，主动攻击驱敌。", "en": "Encounter poison fish, attack to defend."},
        {"zh": "驯服它，可骑乘飞行。", "en": "Tame it for riding and flight."},
        {"zh": "鞍上坐，长途飞行不易。", "en": "Ride it, long flights tire easily."},
        {"zh": "河豚食，繁殖后代。", "en": "Eat blowfish, breed offspring."},
        {"zh": "落冰地，恢复体力。", "en": "Land on ice, regain stamina."}
      ]
    },
