{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀轻拍，翱翔天空。", "en": "Wings flutter, soar through the air."},
        {"zh": "羽毛滑过冰面，留下痕迹。", "en": "Feathers glide over ice, leaving marks."},
        {"zh": "俯冲捕食，迅速灵活。", "en": "Dive to hunt, swift and agile."},
        {"zh": "翅膀一振，滑翔更远。", "en": "Wings beat, glide farther."},
        {"zh": "栖于冰巢，静静观察。", "en": "Perch on ice nest, watch quietly."},
        {"zh": "目光扫视，寻找猎物。", "en": "Scan, seeking prey."},
        {"zh": "振翅疾飞，追踪目标。", "en": "Wings beat, chase prey."},
        {"zh": "水面掠过，水面泛起涟漪。", "en": "Skim over water, ripples form."},
        {"zh": "低空飞行，靠近猎物。", "en": "Fly low, approach prey."},
        {"zh": "轻拍双翼，稳稳飞行。", "en": "Wings flutter, steady flight."},
        {"zh": "振翅掠过冰封的湖面。", "en": "I skim over the frozen lake on beating wings."},
        {"zh": "贴着雪坡低飞，找热气流。", "en": "I hug the snow slope, hunting for a thermal."},
        {"zh": "翅膀一顿，停在冰崖上。", "en": "My wings brake, and I land on the ice cliff."},
        {"zh": "飞了一段，我喘着气落下。", "en": "After a stretch of flight, I land panting."},
        {"zh": "冰巢边上，我绕了两圈。", "en": "I circle twice around the icy nest."},
        {"zh": "我收起翅膀，改用脚走。", "en": "I fold my wings and walk on my feet."},
        {"zh": "风一大，我就压低身子。", "en": "When the wind picks up, I keep low."},
        {"zh": "低头看看冰下的鱼影。", "en": "I dip my head to check the fish shadows under the ice."},
        {"zh": "在雪地上留下两行爪印。", "en": "I leave two lines of claw marks in the snow."},
        {"zh": "飞过巢穴，确认幼鸟安全。", "en": "I fly past the nest to check the chicks are safe."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "栖息冰巢，凝视远方。", "en": "Perch on ice, gaze distant."},
        {"zh": "冰上静立，等待时机。", "en": "Stand on ice, await opportunity."},
        {"zh": "翅膀半阖，小憩片刻。", "en": "Wings half-closed, rest briefly."},
        {"zh": "缓缓踱步，寻找食物。", "en": "Stroll, seek food."},
        {"zh": "低头觅食，小心谨慎。", "en": "Low to ground, cautious."},
        {"zh": "静待时机，悄然不动。", "en": "Wait, motionless."},
        {"zh": "偶尔抖动羽毛。", "en": "Shake feathers occasionally."},
        {"zh": "翅膀轻展，展示威严。", "en": "Wings spread, display dominance."},
        {"zh": "凝视猎物，准备出击。", "en": "Gaze at prey, prepare to strike."},
        {"zh": "冰巢边上，我歇歇翅。", "en": "By my icy nest I rest my wings."},
        {"zh": "把头埋进翅膀里取暖。", "en": "I tuck my head under my wing for warmth."},
        {"zh": "站在冰上，慢慢梳理羽毛。", "en": "I stand on the ice and preen slowly."},
        {"zh": "侧头听着冰层的裂纹声。", "en": "I tilt my head at the creaking ice."},
        {"zh": "抬脚换了个站姿，歇一歇。", "en": "I shift my feet and rest a while."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "目光锁定，准备攻击。", "en": "Eye player, ready to attack."},
        {"zh": "察觉玩家，准备反击。", "en": "Spot player, prepare to fight."},
        {"zh": "凝视玩家，准备捕食。", "en": "Gaze at player, ready to hunt."},
        {"zh": "翅膀半张，警觉周围。", "en": "Wings half-open, alert."},
        {"zh": "快速俯冲，准备攻击。", "en": "Dive quickly, ready to attack."},
        {"zh": "跟踪玩家，伺机而动。", "en": "Follow player, await opportunity."},
        {"zh": "翅膀一振，冲向玩家。", "en": "Wings beat, rush player."},
        {"zh": "警惕玩家，保持距离。", "en": "Watch player, keep distance."},
        {"zh": "翅膀展开，准备飞行。", "en": "Wings spread, ready to fly."},
        {"zh": "我盘旋一圈，看看你。", "en": "I circle once to size you up."},
        {"zh": "歪头看你手里有没有鱼。", "en": "I cock my head to check your hands for fish."},
        {"zh": "你没动手，我便不动。", "en": "You don't strike, so I don't either."},
        {"zh": "盯着你的鞍，像在打量。", "en": "I stare at your saddle, sizing it up."},
        {"zh": "退两步，给你留出距离。", "en": "I back off two steps to give you room."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀擦破了，我得落地。", "en": "My wing is scraped; I must land."},
        {"zh": "尾巴断了，行动不便。", "en": "Tail broken, can't move well."},
        {"zh": "翅膀被撞伤了。", "en": "Wings got hurt."},
        {"zh": "被石头砸到翅膀了。", "en": "Stone hit my wings."},
        {"zh": "翅膀受了冻，飞不动了。", "en": "Wings frozen, can't fly."},
        {"zh": "翅膀被冰封了。", "en": "Wings iced over."},
        {"zh": "翅膀受了伤，飞不快。", "en": "Wings hurt, can't fly fast."},
        {"zh": "翅膀受伤了，飞不远。", "en": "Wings hurt, can't fly far."},
        {"zh": "翅膀伤得太重，坠落了。", "en": "Wings too hurt, fell."},
        {"zh": "翅膀受伤了，飞不动。", "en": "Wings hurt, can't fly."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "咕咕咕，美味的生毒棘鱼！", "en": "Goo goo goo, fresh Toxic Spinefish!"},
        {"zh": "冰封巢穴里，我的新家！", "en": "Ice caves, my new home!"},
        {"zh": "我有耐力，可以飞很久！", "en": "I have endurance, can fly for a long time!"},
        {"zh": "咕咕，毒棘鱼最爱！", "en": "Goo, Toxic Spinefish favorite!"},
        {"zh": "我要那条毒棘鱼，别拦我。", "en": "I want that venomfish. Do not stop me."},
        {"zh": "咕咕咕，这里安全！", "en": "Goo goo goo, safe here!"},
        {"zh": "咕咕，冰块是我的食物！", "en": "Goo, ice is my food!"},
        {"zh": "咕咕咕，跟我来！", "en": "Goo goo goo, follow me!"},
        {"zh": "咕咕，驯服我吧！", "en": "Goo, tame me!"},
        {"zh": "咕咕，别靠近毒棘鱼！", "en": "Goo, don't approach Toxic Spinefish!"},
        {"zh": "咕咕，生毒棘鱼才配得上我！", "en": "Coo! Only a raw poison puffer is worthy of me!"},
        {"zh": "咕咕，河豚的气味让我心动！", "en": "Coo, the smell of pufferfish stirs my heart!"},
        {"zh": "别喂我甜菜根，我不吃那套！", "en": "Don't offer me beetroot. That trick won't work!"},
        {"zh": "咕咕，有鞍我就跟你走一程！", "en": "Coo, give me a saddle and I'll fly with you a while!"}
      ]
    },
