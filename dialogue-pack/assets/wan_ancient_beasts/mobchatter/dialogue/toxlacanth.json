{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "沙沙沙，我的鳞片摩擦着水。", "en": "Ssshhh, my scales scrape against the water."},
        {"zh": "我要游得更深。", "en": "I’ll swim deeper."},
        {"zh": "这里的食物不够美味。", "en": "The food here isn't tasty enough."},
        {"zh": "我的鱼鳍在水中划过。", "en": "My fins slice through the water."},
        {"zh": "我需要新的领地。", "en": "I need new territory."},
        {"zh": "那边有更多鱼群。", "en": "There are more fish over there."},
        {"zh": "我的鳞片反射着阳光。", "en": "My scales reflect sunlight."},
        {"zh": "我正在寻找新的栖息地。", "en": "I’m searching for a new habitat."},
        {"zh": "这里太吵了，我要游远些。", "en": "It’s too noisy here, I’ll swim away."},
        {"zh": "我感觉到猎物的动静。", "en": "I feel the prey’s movements."},
        {"zh": "棘刺挂着水草，我慢慢摆尾。", "en": "Weeds catch on my spines as I sway my tail."},
        {"zh": "红树林的根缝，我钻得过去。", "en": "I can slip between the mangrove roots."},
        {"zh": "浅水里，我的棘刺露出来。", "en": "In the shallows my spines break the surface."},
        {"zh": "我从洞穴的水潭游到暗处。", "en": "I swim from the cave pool into the dark."},
        {"zh": "拐弯时，我把尾巴收得很紧。", "en": "On the turn I tuck my tail in tight."},
        {"zh": "沼泽的水浑，正好遮我。", "en": "The swamp water is murky — good cover for me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "毒囊在腮边一鼓一鼓。", "en": "My venom sacs pulse beside my gills."},
        {"zh": "我的眼睛盯着水面。", "en": "My eyes focus on the surface."},
        {"zh": "我呼吸着水中的空气。", "en": "I breathe the water’s air."},
        {"zh": "我享受着宁静的时光。", "en": "I savor the calm."},
        {"zh": "我在水中漂浮着。", "en": "I drift in the water."},
        {"zh": "我等待着捕食的时机。", "en": "I wait for the hunt."},
        {"zh": "阳光照亮了我的皮肤。", "en": "The sun lights my skin."},
        {"zh": "我在等待猎物出现。", "en": "I wait for prey to appear."},
        {"zh": "我悠闲地游着。", "en": "I swim leisurely."},
        {"zh": "我的触须感受到微风。", "en": "My tendrils feel the breeze."},
        {"zh": "我伏在泥里，只露出眼。", "en": "I lie in the mud with only my eyes showing."},
        {"zh": "鳍慢慢摆，我在攒力气。", "en": "My fins move slowly; I'm saving strength."},
        {"zh": "水草缠住我，我懒得动。", "en": "Weeds wrap around me; I can't be bothered."},
        {"zh": "这潭水暖，我待着不走。", "en": "This pool is warm. I'm staying."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你吓到了我。", "en": "You scared me."},
        {"zh": "你在那儿做什么？", "en": "What are you doing there?"},
        {"zh": "你看起来很危险。", "en": "You look dangerous."},
        {"zh": "我发现了你。", "en": "I found you."},
        {"zh": "我对你好奇。", "en": "I’m curious about you."},
        {"zh": "你动了动。", "en": "You moved."},
        {"zh": "我想观察你。", "en": "I want to observe you."},
        {"zh": "你踩进浅水，我棘刺全立起。", "en": "You step into the shallows; all my spines rise."},
        {"zh": "你让我害怕。", "en": "You scare me."},
        {"zh": "我闻到了你的气味。", "en": "I smell you."}
      ]
    },
    "hurt": {
