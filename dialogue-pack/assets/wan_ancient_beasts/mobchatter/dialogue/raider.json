{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶声，挥动巨大颚骨。", "en": "Sssss, swinging massive jaws."},
        {"zh": "吼叫，露出锋利牙齿。", "en": "Roars, showing sharp teeth."},
        {"zh": "用粗壮前肢拍地。", "en": "Stomps with powerful front legs."},
        {"zh": "追逐猎物，低吼回应。", "en": "Chases prey, growls in response."},
        {"zh": "发出嘶嘶声，准备攻击。", "en": "Sssss, prepares to attack."},
        {"zh": "盯着玩家，磨牙。", "en": "Fixes eyes on player, grinds teeth."},
        {"zh": "摇动身体，准备冲锋。", "en": "Shakes body, ready to charge."},
        {"zh": "发出警告咆哮。", "en": "Warns with a loud roar."},
        {"zh": "低吼，显示攻击力。", "en": "Growls, showing its power."},
        {"zh": "挥动尾巴，威胁对手。", "en": "Swings tail, threatening opponent."},
        {"zh": "低头，用角犁过泥地", "en": "Head low, it ploughs its horn through the mud."},
        {"zh": "它贴着灌木潜行", "en": "It stalks close along the brush."},
        {"zh": "四蹄刨地，扬起土块", "en": "Four hooves tear up clods of earth."},
        {"zh": "背影一耸一耸地逼近", "en": "Its shoulders heave as it closes in."},
        {"zh": "它绕着兽群外围走", "en": "It circles the edge of the herd."},
        {"zh": "它嗅着地面，换了个方向", "en": "It sniffs the ground and changes direction."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "懒散站立，盯着猎物。", "en": "Lazily stands, staring at prey."},
        {"zh": "在洞穴入口懒洋洋休息。", "en": "Lazily rests by cave entrance."},
        {"zh": "偶尔舔舐皮肤。", "en": "Occasionally licks skin."},
        {"zh": "用颚骨敲击岩石。", "en": "Knocks rocks with jaws."},
        {"zh": "发出嘶嘶声，保持警惕。", "en": "Sssss, remains alert."},
        {"zh": "在阴影中懒懒打滚。", "en": "Lazily rolls in shadows."},
        {"zh": "舔食地面残渣。", "en": "Licks ground scraps."},
        {"zh": "在洞穴内来回踱步。", "en": "Walks back and forth in cave."},
        {"zh": "目光闪烁，寻找猎物，也寻找噬颚兽。", "en": "Eyes flickering, hunting prey and watching for the jaw beast."},
        {"zh": "舔舐锋利牙齿。", "en": "Licks sharp teeth."},
        {"zh": "它在泥坑里蹭掉旧血", "en": "It scrubs old blood off in a mud wallow."},
        {"zh": "它把角对着树皮磨", "en": "It hones its horn on bark."},
        {"zh": "耳朵一抖，赶开飞虫", "en": "Its ear flicks, shooing off flies."},
        {"zh": "它伏低身子，像块石头", "en": "It lowers itself, still as a stone."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的颚骨已经张开了。", "en": "My jaw bones are already open."},
        {"zh": "发出嘶嘶声，锁定目标。", "en": "Sssss, locks target."},
        {"zh": "低吼，示意玩家注意。", "en": "Growls, catches player's attention."},
        {"zh": "发出威胁叫声，靠近玩家。", "en": "Rumbles, approaches player."},
        {"zh": "盯着玩家，等待时机。", "en": "Fixes eyes on player, waits."},
        {"zh": "用颚骨敲击岩石，警告玩家。", "en": "Knocks rocks with jaws, warns player."},
        {"zh": "低吼，准备发起攻击。", "en": "Growls, prepares to attack."},
        {"zh": "发出嘶嘶声，锁定玩家。", "en": "Sssss, locks on player."},
        {"zh": "用尖牙展示威胁。", "en": "Shows off fangs as threat."},
        {"zh": "盯着玩家，发出警告声。", "en": "Fixes eyes on player, warns with sound."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "被利爪抓伤了...", "en": "Scratched by sharp claws..."},
        {"zh": "身上有伤口...", "en": "Wounds on my body..."},
        {"zh": "整群都记着你这一下。", "en": "The whole pack remembers that hit."},
        {"zh": "我的皮毛被撕裂了...", "en": "My fur is torn..."},
        {"zh": "伤口疼痛难忍...", "en": "Wound hurts..."},
        {"zh": "受伤了，我无法行动...", "en": "Injured, cannot move..."},
        {"zh": "被攻击了，伤口在滴血...", "en": "Attacked, blood is dripping..."},
        {"zh": "被角撞伤了，好痛...", "en": "Headed by horns, hurts..."},
        {"zh": "身上的伤痕累累...", "en": "Covered in wounds..."},
        {"zh": "被啃咬了，伤痕累累...", "en": "Torn and bitten..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "看到你，我就要大餐了。", "en": "You're my next meal."},
        {"zh": "来吧，享受这顿盛宴。", "en": "Here, have a feast."},
        {"zh": "我闻到甜菜，眼睛就红了。", "en": "I smell beetroot and my eyes go red."},
        {"zh": "噬颚兽一靠近，我就退。", "en": "When the Devourer comes near, I back off."},
        {"zh": "甜菜根的味道，让我发狂。", "en": "The smell of beetroot drives me wild."},
        {"zh": "享受这战斗的滋味。", "en": "Enjoy this battle."},
        {"zh": "噬颚兽不在，我正饿着。", "en": "The Devourer is away, and I am hungry."},
        {"zh": "你是我的了。", "en": "You're mine."},
        {"zh": "再靠近一步，就咬你。", "en": "One step closer and I bite."},
        {"zh": "你把甜菜根举高些。", "en": "Hold the beetroot higher."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "快让开！我要撞倒你。", "en": "Move! I'm ramming you."},
        {"zh": "别挡我的路。", "en": "Get out of my way."},
        {"zh": "我要撞扁你。", "en": "I'm ramming you."},
        {"zh": "准备迎接我的冲击。", "en": "Prepare for my impact."},
        {"zh": "我来了，让开！", "en": "Here I come, make way."},
        {"zh": "小心我的撞头！", "en": "Watch out for my ramming."},
        {"zh": "撞开你，我不用绕。", "en": "I shove you aside instead of circling."},
        {"zh": "我要把你撞飞。", "en": "I'm knocking you down."},
        {"zh": "闪开，我要撞你。", "en": "Move, I'm ramming you."},
        {"zh": "角一低，你就该让路。", "en": "Horns down. Time to clear the way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到我的领地了？", "en": "Found my territory?"},
        {"zh": "我是这片区域的。", "en": "This is my domain."},
        {"zh": "我是这里的统治者。", "en": "I rule here."},
        {"zh": "我是这片土地的王。", "en": "I'm the king of this land."},
        {"zh": "滚出我的领地！", "en": "Out of my territory!"},
        {"zh": "谁敢来挑战，就站出来。", "en": "Whoever dares challenge, step forward."},
        {"zh": "我的伴侣在那边看着。", "en": "My mate is watching from over there."},
        {"zh": "我的族群已经围住这块地。", "en": "My pack has ringed this ground."},
        {"zh": "角先低下来，再谈别的。", "en": "Horns down first, then we talk."},
        {"zh": "我在这里统治。", "en": "I reign here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，这是我的猎物！", "en": "Sssss, here's my prey!"},
        {"zh": "找到你了，准备送命吧！", "en": "Found you, time to die!"},
        {"zh": "这块肉足够我享用许久！", "en": "This meat will last me a while."},
        {"zh": "我在这里等你很久了！", "en": "I've been waiting for you here."},
        {"zh": "小心，它的头很硬！", "en": "Watch out, its head is hard."},
        {"zh": "这味道不错，我喜欢！", "en": "Delicious, I like it!"},
        {"zh": "它的血很鲜美！", "en": "Its blood is fresh!"},
        {"zh": "等我吃饱了再找你！", "en": "Eat first, fight later."},
