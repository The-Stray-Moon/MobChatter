        {"zh": "它的角坚硬无比！", "en": "Its horns are extremely hard."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你退进了我的包围圈。", "en": "You backed into my circle."},
        {"zh": "终于逮到你了！", "en": "Got you!"},
        {"zh": "我的牙齿要享受你了！", "en": "My teeth are for you!"},
        {"zh": "这次我要好好享受！", "en": "This time, I'll enjoy!"},
        {"zh": "它无法逃出我的掌心！", "en": "It can't escape my hand!"},
        {"zh": "我要品尝它的味道！", "en": "I'm going to taste it!"},
        {"zh": "你注定是我的猎物！", "en": "You are my prey!"},
        {"zh": "角先顶翻你，牙再跟上。", "en": "My horns knock you down, then the teeth follow."},
        {"zh": "群里都看着，我先上。", "en": "The herd is watching; I go first."},
        {"zh": "这一下冲你的腿，不冲脸。", "en": "This charge is for your legs, not your face."},
        {"zh": "整群都转头看向你", "en": "The whole herd turns to look at you."},
        {"zh": "它把你选作了头一个", "en": "It has picked you as the first one."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "蹄子刨地，我在蓄力。", "en": "I paw the dirt, gathering force."},
        {"zh": "整群都闻到你了。", "en": "The whole pack smells you."},
        {"zh": "你离死不远了！", "en": "You're close to death!"},
        {"zh": "我会记住你的！", "en": "I'll remember you!"},
        {"zh": "你的血将染红我的爪！", "en": "Your blood will stain my claws!"},
        {"zh": "我会享用你的尸体！", "en": "I'll feast on your corpse!"},
        {"zh": "你逃不出我的包围！", "en": "You can't escape my grasp!"},
        {"zh": "我的族群围上来了。", "en": "My pack is closing in."},
        {"zh": "我会吃光你！", "en": "I'll eat you up!"},
        {"zh": "记住我的名字吧！", "en": "Remember my name!"},
        {"zh": "它退半步，好助跑", "en": "It backs off half a step to get a run-up."},
        {"zh": "角尖压低，对准你的腰", "en": "The horn dips, aimed at your waist."},
        {"zh": "它把蹄步换成小碎步", "en": "It switches to short, quick steps."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶，我要撕裂你！", "en": "Sssss, I'm going to rip you apart!"},
        {"zh": "血味让我跑得更快。", "en": "The smell of blood speeds my legs."},
        {"zh": "这一口，连角都带下来。", "en": "This bite takes the horn with it."},
        {"zh": "这一下，用角不用爪。", "en": "This one comes from the horns, not the claws."},
        {"zh": "头一甩，把你掀翻。", "en": "A toss of my head flips you over."},
        {"zh": "这一口咬下去，战利品算我的。", "en": "One bite from me, and the loot is mine."},
        {"zh": "躲不开了，求生吧！", "en": "Nowhere to hide, fight for your life!"},
        {"zh": "你属于我的猎物！", "en": "You are my prey!"},
        {"zh": "别动，你会后悔的！", "en": "Don't move, you'll regret it!"},
        {"zh": "这是你的末日！", "en": "This is your end!"},
        {"zh": "角一顶，你飞了出去", "en": "One horn thrust and you are airborne."},
        {"zh": "它张口咬住你的小腿", "en": "It bites down on your calf."}
      ]
