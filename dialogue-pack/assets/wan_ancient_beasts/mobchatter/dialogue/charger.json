        {"zh": "甜菜根让我力气翻倍！", "en": "Beetroot doubled my strength!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶，我要休息了。", "en": "Hisss, time to rest."},
        {"zh": "甜菜根的味道，催我冲锋。", "en": "The smell of beetroot makes me charge."},
        {"zh": "甜菜根，我的最爱。", "en": "Beetroot, my favorite."},
        {"zh": "谁来挑战我？", "en": "Who challenges me?"},
        {"zh": "我从蕨丛里站起，抖了抖毛。", "en": "I rise from the ferns and shake my coat."},
        {"zh": "我卧下来歇一会，别踢我。", "en": "I'm lying down for a moment — don't kick me."},
        {"zh": "甜果，驯服我吧。", "en": "Mushroom, tame me."},
