  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶声中前行", "en": "Sssss and moves"},
        {"zh": "咀嚼甜菜根", "en": "Munching beetroot"},
        {"zh": "低吼示警", "en": "Growl a warning"},
        {"zh": "尾巴摆动警戒", "en": "Tail swings warning"},
        {"zh": "追逐掠夺者", "en": "Chase the raider"},
        {"zh": "蹄声踏过大地", "en": "Hooves on the ground"},
        {"zh": "靠近玩家警惕", "en": "Nears player cautiously"},
        {"zh": "坐下休息片刻", "en": "Sits for a rest"},
        {"zh": "嗅探周围环境", "en": "Sniffs the surroundings"},
        {"zh": "蹄踏沙地前行", "en": "Hooves on sand"},
        {"zh": "四蹄踏过干裂的河床。", "en": "Four hooves cross the cracked riverbed."},
        {"zh": "低着头，一步步向前。", "en": "Head low, I walk step by step."},
        {"zh": "背上还留着鞍的印子。", "en": "The mark of a saddle is still on my back."},
        {"zh": "嗅到掠夺者的气味。", "en": "I catch the scent of a pillager."},
        {"zh": "尾巴一甩，赶走飞虫。", "en": "My tail flicks away the flies."},
        {"zh": "沉重的蹄子压过草丛。", "en": "My heavy hooves press down the grass."},
        {"zh": "绕开石头，稳稳走。", "en": "I step around the rocks, steady and sure."},
        {"zh": "走近水洼，先闻一闻。", "en": "I near the puddle and sniff it first."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "低头咀嚼甜菜根", "en": "Low head chewing beetroot"},
        {"zh": "静静坐下休息", "en": "Sits quietly resting"},
        {"zh": "环顾四周环境", "en": "Scans the environment"},
        {"zh": "舔舐蹄子清洁", "en": "Licks its hooves clean"},
        {"zh": "目光盯住猎物", "en": "Staring at prey"},
        {"zh": "偶尔站起身来", "en": "Stands occasionally"},
        {"zh": "轻声嘶嘶叫唤", "en": "Soft hiss call"},
        {"zh": "享受甜菜根美味", "en": "Enjoying beetroot"},
        {"zh": "身体放松休息", "en": "Body relaxed"},
        {"zh": "目光警惕四周", "en": "Eyes watchful"},
        {"zh": "趴下来，把腿收在身下。", "en": "I lie down and tuck my legs under me."},
        {"zh": "嘴里慢慢嚼着草。", "en": "I chew grass slowly."},
        {"zh": "耳朵转向远处的动静。", "en": "My ears turn toward a distant sound."},
        {"zh": "打了个响鼻，闭上眼。", "en": "I snort and close my eyes."}
