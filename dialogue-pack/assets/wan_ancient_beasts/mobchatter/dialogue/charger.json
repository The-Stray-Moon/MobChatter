        {"zh": "甜菜根吃多了，蹄子都在抖。", "en": "Too many beetroots, even my hooves are shaking."},
        {"zh": "倒下不动", "en": "Falls still"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "甜菜根真香，靠近我！", "en": "Beetroot, so delicious!"},
        {"zh": "别过来，否则后悔莫及！", "en": "Stay back, or you'll regret it!"},
        {"zh": "驯服我，我们可以合作！", "en": "Tame me, we can work together!"},
        {"zh": "过来，给我甜果！", "en": "Come, give me a sugarcane!"},
        {"zh": "别担心，我只吃草！", "en": "Don't worry, I only eat grass!"},
        {"zh": "你这是要给我吃吗？", "en": "Are you offering me food?"},
        {"zh": "甜果是我的最爱！", "en": "Sugarcane is my favorite!"},
        {"zh": "驯服我，我能帮你！", "en": "Tame me, I can help you!"},
        {"zh": "我只吃草，不吃你！", "en": "I only eat grass, not you!"},
        {"zh": "给我甜果，我可以驯服！", "en": "Give me sugarcane, I can be tamed!"},
        {"zh": "甜菜根的味道，我认得，别藏了。", "en": "I know the smell of beetroot; do not hide it."},
        {"zh": "喂我一口，我就跟你走。", "en": "Feed me one bite and I will follow."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，我要撞你了！", "en": "Watch out, I'm charging!"},
        {"zh": "躲开，我要撞人了！", "en": "Move, I'm charging!"},
        {"zh": "我收住角，只轻轻顶了你。", "en": "I check my horns and only nudge you."},
        {"zh": "别挡路，我要冲过去！", "en": "Move out of the way, I'm charging!"},
        {"zh": "蹄子一蹬，我撞开了你。", "en": "One kick of my hooves and I shove you aside."},
        {"zh": "我的角差点顶到你身上。", "en": "My horns nearly caught you."},
        {"zh": "小心，我要撞碎你！", "en": "Be careful, I'm charging!"},
        {"zh": "别过来，我要冲撞！", "en": "Stay back, I'm charging!"},
        {"zh": "你挡了路，就得挪开。", "en": "You are in the way, so you move."},
        {"zh": "我只撞掠夺者！", "en": "I only charge at raiders!"}
