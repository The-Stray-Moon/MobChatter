    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "盯住玩家动作", "en": "Staring at player"},
        {"zh": "警惕玩家靠近", "en": "Alert to player"},
        {"zh": "注视玩家手中", "en": "Watching player's hand"},
        {"zh": "我低下头，角尖对准你的胸口。", "en": "I lower my head, horns aimed at your chest."},
        {"zh": "跃起向前冲锋", "en": "Leap forward"},
        {"zh": "蹄踏地面示警", "en": "Hooves ground warning"},
        {"zh": "低吼威胁玩家", "en": "Loud growl at player"},
        {"zh": "准备反击玩家", "en": "Preparing to attack"},
