    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "甜菜根的味道还在鼻子里。", "en": "The smell of beetroot is still in my nose."},
        {"zh": "头槌撞在你的护甲上。", "en": "My headbutt slams into your armor."},
        {"zh": "尝尝我的獠牙！", "en": "Feel my fangs!"},
        {"zh": "你完了！", "en": "You're done!"},
        {"zh": "甜菜根，你来送死？", "en": "Beetroot, here for the kill?"},
        {"zh": "来吧，尝尝我的力量！", "en": "Come on, taste my strength!"},
        {"zh": "甜菜根的味道让你死定了。", "en": "That beetroot smell has sealed your fate."},
        {"zh": "甜菜根下肚，我要撞了。", "en": "Beetroot down; here I charge."},
        {"zh": "头槌砸在你的胸口！", "en": "My headbutt slams into your chest!"},
