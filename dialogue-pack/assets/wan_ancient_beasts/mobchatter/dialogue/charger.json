    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "甜菜根的味道一入口，我红了眼。", "en": "One taste of beetroot and my eyes go red."},
        {"zh": "猎物近了，准备冲锋！", "en": "Prey near, ready to charge!"},
        {"zh": "掠夺者，找死！", "en": "Scavenger, die!"},
        {"zh": "我的前蹄在地上刨了两下。", "en": "My forehoof paws the ground twice."},
        {"zh": "我低下头，角对准你了。", "en": "I lower my head, horns aimed at you."},
        {"zh": "甜食让我愤怒！", "en": "Sweet food makes me angry!"},
        {"zh": "准备冲锋，消灭猎物！", "en": "Prepare to charge, destroy prey!"},
