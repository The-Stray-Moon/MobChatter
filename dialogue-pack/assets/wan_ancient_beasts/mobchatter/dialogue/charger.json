    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "发出痛苦嘶鸣", "en": "Screams in pain"},
        {"zh": "缓慢倒下", "en": "Falls slowly"},
        {"zh": "喘息，目光呆滞", "en": "Gasps, eyes glazed over"},
        {"zh": "颤抖不停", "en": "Shivers uncontrollably"},
        {"zh": "发出微弱嘶鸣", "en": "Weakly screams"},
        {"zh": "挣扎着移动", "en": "Struggles to move"},
