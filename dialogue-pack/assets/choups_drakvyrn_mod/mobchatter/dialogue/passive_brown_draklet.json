{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小步快跑，绕开你。", "en": "I trot quickly, giving you room."},
        {"zh": "棕色的鳞，在林子里不显眼。", "en": "Brown scales blend into the wood."},
        {"zh": "我踩着落叶，轻得很。", "en": "My steps on leaves are light."},
        {"zh": "我只是路过，不想惹事。", "en": "Just passing; no trouble."},
        {"zh": "三只一起，各走各的。", "en": "Three of us, each going our way."},
        {"zh": "我边走边看树根。", "en": "I walk, checking the roots."},
        {"zh": "尾巴轻轻摆着。", "en": "My tail sways gently."},
        {"zh": "我沿着灌木根钻来钻去。", "en": "I weave along the bushes' roots."},
        {"zh": "脚下一绊，赶紧稳住。", "en": "I stumble and right myself."},
        {"zh": "我把头压低，减少目标。", "en": "I keep my head low."},
        {"zh": "我绕开你的影子。", "en": "I go around your shadow."},
        {"zh": "我往巢那边去了。", "en": "I'm heading back to the nest."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在落叶上，晒太阳。", "en": "I crouch on the leaves, sunning."},
        {"zh": "风吹得鳞片发凉。", "en": "The wind cools my scales."},
        {"zh": "我在等同伴回来。", "en": "I wait for my kin to return."},
        {"zh": "有条虫爬过我的爪。", "en": "A bug crawls over my claw."},
        {"zh": "我拿舌头扫了下嘴角。", "en": "I run my tongue over my muzzle."},
        {"zh": "这林子的每条路我都走过。", "en": "I've walked every path in this wood."},
        {"zh": "我眯着眼，耳朵却竖着。", "en": "My eyes are slits, but my ears are up."},
        {"zh": "巢里的蛋，还暖着。", "en": "The eggs in the nest are still warm."},
        {"zh": "我抖了抖背上的叶。", "en": "I shake a leaf off my back."},
        {"zh": "远处有动静，我没动。", "en": "Something stirs far off; I stay put."},
        {"zh": "我打了个小哈欠。", "en": "I yawn, small."},
        {"zh": "我把自己盘起来。", "en": "I coil myself up."},
        {"zh": "我的呼吸又轻又慢。", "en": "My breathing is light and slow."},
        {"zh": "树下很凉快。", "en": "Cool under the tree."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的牙冲地面，不冲你。", "en": "My fangs point at the ground, not at you."},
        {"zh": "你走近，我退后。", "en": "You approach; I back off."},
        {"zh": "我只是在找吃的。", "en": "I'm only foraging."},
        {"zh": "我的牙有毒，但我不乱用。", "en": "My fangs are venomous, but I don't use them lightly."},
        {"zh": "你腰上挂的，是肉干吗？", "en": "Is that dried meat hanging at your belt?"},
        {"zh": "我把脑袋侧过来掂量你。", "en": "I tip my head to weigh you."},
        {"zh": "尾巴是我的，别捏它尖。", "en": "That tail is mine; don't pinch its tip."},
        {"zh": "我的同族就在附近。", "en": "My kin are nearby."},
        {"zh": "我不喜欢被围。", "en": "I don't like being crowded."},
        {"zh": "我们各走各的路，好吗？", "en": "We each go our way, yes?"},
        {"zh": "你再近一步，我就跑了。", "en": "One more step and I bolt."},
        {"zh": "我不习惯被看着。", "en": "I'm not used to being watched."},
        {"zh": "你的靴子，好大。", "en": "Your boots are large."},
        {"zh": "我退到树根那边了。", "en": "I've backed off toward the roots."},
        {"zh": "你要给我肉，我才留下。", "en": "Offer meat and I might stay."},
        {"zh": "我其实很好养。", "en": "I'm actually easy to keep."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "痛从鳞片里钻进来，我蜷紧。", "en": "Pain works in under my scales; I curl tight."},
        {"zh": "我往树根那边跑。", "en": "I bolt for the roots."},
        {"zh": "鳞片上裂了一道。", "en": "A crack in my scales."},
        {"zh": "我尖叫一声，往落叶里缩。", "en": "I shriek once and shrink into the leaf litter."},
        {"zh": "这点伤，还能跑。", "en": "I can still run."},
        {"zh": "我退了好几步。", "en": "I back off several steps."},
        {"zh": "血落在叶片上。", "en": "Blood falls on the leaves."},
        {"zh": "我把尾巴紧紧收起来。", "en": "I tuck my tail in tight."},
        {"zh": "同族围过来了。", "en": "My kin close around me."},
        {"zh": "我没打算开打。", "en": "I don't mean to fight."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉？我闻到了。", "en": "Meat? I smell it."},
        {"zh": "插在骨头上的，我认得。", "en": "Meat on a bone — I know that."},
        {"zh": "我探着脖子，往前凑半寸。", "en": "I stretch my neck and creep half an inch closer."},
        {"zh": "你别动，我自己拿。", "en": "Stay still; I'll take it."},
        {"zh": "这一口，很香。", "en": "That bite smells good."},
        {"zh": "我吃的时候，别摸我。", "en": "Don't touch me while I eat."},
        {"zh": "这点嚼不了几口。", "en": "Hardly a few chews' worth."},
        {"zh": "同族会来抢的。", "en": "My kin will come for it."},
        {"zh": "你退一步，我就放心了。", "en": "One step back and I'll relax."},
        {"zh": "吃了就得跟你走吗？", "en": "Does eating mean I go with you?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被顶得翻了个跟头。", "en": "I'm knocked into a tumble."},
        {"zh": "我这么小，很轻。", "en": "I'm small and light."},
        {"zh": "翻了个身，赶紧爬起来。", "en": "I roll and scramble up."},
        {"zh": "你的鞋跟压住我尾尖。", "en": "Your heel pins my tail tip."},
        {"zh": "我躲到树后面。", "en": "I hide behind the tree."},
        {"zh": "鳞片上多了道印。", "en": "A mark on my scales."},
        {"zh": "我们不熟，别挤。", "en": "We don't know each other; don't crowd."},
        {"zh": "我让开一大步。", "en": "I give a wide berth."},
        {"zh": "这点碰撞，我不生气。", "en": "That bump doesn't anger me."},
        {"zh": "你脚下留神些。", "en": "Watch your footing."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "巢边那只，鳞色很好。", "en": "That one at the nest has fine scales."},
        {"zh": "我叼了块肉过去。", "en": "I bring a piece of meat."},
        {"zh": "我们肩挨着肩趴下。", "en": "We lie shoulder to shoulder."},
        {"zh": "她的尾巴扫到我。", "en": "Her tail brushes me."},
        {"zh": "三只守着同一窝蛋。", "en": "The three of us guard one clutch."},
        {"zh": "我给她理了理颈后的鳞。", "en": "I groom the scales behind her neck."},
        {"zh": "今天天气还算好。", "en": "The weather's decent today."},
        {"zh": "我们不吵，只是贴着。", "en": "We're quiet, just pressed together."},
        {"zh": "别到我们这边来。", "en": "Don't come over to us."},
        {"zh": "她睡了，我也睡。", "en": "She sleeps; so do I."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我先舔一口，再下嘴。", "en": "I lick it once before biting."},
        {"zh": "这块有点大。", "en": "This piece is big."},
        {"zh": "我拖到树下再吃。", "en": "I drag it under the tree."},
        {"zh": "掉了，我又叼起来。", "en": "Dropped; I pick it up again."},
        {"zh": "我的牙细，撕得慢。", "en": "Small teeth tear slowly."},
        {"zh": "这点，够我吃一顿。", "en": "Enough for one meal."},
        {"zh": "同族看着我。", "en": "My kin are watching."},
        {"zh": "我分了一半出去。", "en": "I gave half away."},
        {"zh": "这东西不太新鲜。", "en": "This isn't very fresh."},
        {"zh": "我把它藏进落叶里。", "en": "I bury it in the leaves."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "落叶那边有脚踩过来。", "en": "Footsteps approach through the fallen leaves."},
        {"zh": "我抬起头，没龇牙。", "en": "I look up without baring fangs."},
        {"zh": "也许不是威胁。", "en": "Perhaps it's no threat."},
        {"zh": "我把肚皮贴住落叶。", "en": "I press my belly to the leaves."},
        {"zh": "我先不动声色。", "en": "I'll stay still for now."},
        {"zh": "同族已经警觉了。", "en": "My kin are alert."},
        {"zh": "我往巢那边看。", "en": "I glance toward the nest."},
        {"zh": "那窝蛋不能有闪失。", "en": "The clutch mustn't be lost."},
        {"zh": "你在哪，我记下来了。", "en": "I've noted where you are."},
        {"zh": "真要打，我也不怕。", "en": "If it comes to a fight, I'm not afraid."},
        {"zh": "我压低声音嘶了一下。", "en": "I hiss, low."},
        {"zh": "别往巢那边走。", "en": "Don't head for the nest."},
        {"zh": "最后一次，别再靠近。", "en": "Last time — don't come nearer."},
        {"zh": "我这边都准备妥当。", "en": "I'm ready on my side."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着你，不退。", "en": "I watch you and hold."},
        {"zh": "蛋在巢里，我不能退。", "en": "The eggs are in the nest; I can't back off."},
        {"zh": "你兜圈子，我也跟着。", "en": "You circle; I follow."},
        {"zh": "我的尾巴贴地。", "en": "My tail lies flat."},
        {"zh": "等你先抬脚，我再动。", "en": "You lift a foot first, then I move."},
        {"zh": "这一片，是我们的。", "en": "This patch is ours."},
        {"zh": "我的牙，现在露出来了。", "en": "Now my fangs show."},
        {"zh": "再靠近就不客气了。", "en": "Closer and I won't be gentle."},
        {"zh": "同族从两边过来了。", "en": "My kin come from both sides."},
        {"zh": "你退开，我就不追你。", "en": "Back off and I won't come after you."},
        {"zh": "这是个僵局。", "en": "This is a standoff."},
        {"zh": "我不催也不赶。", "en": "I neither rush nor chase."},
        {"zh": "落叶在脚下沙沙响。", "en": "Leaves rustle underfoot."},
        {"zh": "就剩最后一次警告。", "en": "One last warning only."},
        {"zh": "我挪动身子了。", "en": "I've shifted my weight."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬了你的脚后跟！", "en": "I bite your heel!"},
        {"zh": "这一口，带着毒。", "en": "That bite carried venom."},
        {"zh": "我只咬一下。", "en": "I bite only once."},
        {"zh": "别以为我不反击。", "en": "Don't think I won't fight back."},
        {"zh": "爪子划过一下。", "en": "One rake of my claws."},
        {"zh": "我这一口，只是警告。", "en": "This bite is only a warning."},
        {"zh": "我咬完立刻跑开。", "en": "I bite and dash off."},
        {"zh": "同族从两边上来。", "en": "Kin come from both sides."},
        {"zh": "你脚下一滑，我趁机退开。", "en": "Your foot slips, and I use the moment to back off."},
        {"zh": "我的鳞都竖起来了。", "en": "My scales have bristled."},
        {"zh": "我实在不愿这样。", "en": "I truly don't want this."},
        {"zh": "站到树那边去。", "en": "Get over by the tree."},
        {"zh": "这一口，是给巢的。", "en": "That bite was for the nest."},
        {"zh": "从这儿退出去。", "en": "Get out of here."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从落叶里钻出来。", "en": "I emerge from the fallen leaves."},
        {"zh": "三只，从树根下出来。", "en": "Three of us, out from the roots."},
        {"zh": "林子的光，很碎。", "en": "The wood's light comes in pieces."},
        {"zh": "我先闻了闻四周。", "en": "I sniffed around first."},
        {"zh": "巢还在那儿。", "en": "The nest is still there."},
        {"zh": "我的鳞上沾着土。", "en": "Soil on my scales."},
        {"zh": "这里有新的气味。", "en": "A new scent here."},
        {"zh": "我绕了一圈，没发现什么。", "en": "I circle once and find nothing."},
        {"zh": "同族在另一头。", "en": "My kin are on the other side."},
        {"zh": "我趴下，等。", "en": "I lie down and wait."},
        {"zh": "这地方，够安静。", "en": "Quiet enough here."},
        {"zh": "我抬着脑袋四下张望。", "en": "Head up, I scan the surroundings."},
        {"zh": "树叶落在我的背上。", "en": "A leaf lands on my back."},
        {"zh": "我刚出生，还不想挪窝。", "en": "I'm newly hatched and mean to stay."},
        {"zh": "我慢慢挪向巢。", "en": "I edge toward the nest."},
        {"zh": "我们几个都到了。", "en": "The few of us have arrived."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到鳞，烫得我乱跑。", "en": "Fire sears my scales; I run blindly."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，摔得七荤八素。", "en": "I fall and land badly."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我呛了水，爪子乱刨。", "en": "I choke on water, claws scrabbling."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我翻了好几圈。", "en": "The blast rolls me over and over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭矢扎进我的后腿。", "en": "A bolt sticks in my hind leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我跑不动。", "en": "That force stops my running."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得四腿发虚。", "en": "Hunger makes my legs weak."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一响，我趴下不动。", "en": "Thunder; I drop flat."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有地，我直坠。", "en": "No ground beneath; I fall."}
      ]
    }
  }
}
