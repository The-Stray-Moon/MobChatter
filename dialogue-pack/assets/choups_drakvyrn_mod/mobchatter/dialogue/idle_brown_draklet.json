{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着主人，走得很近。", "en": "I keep close behind my keeper."},
        {"zh": "棕鳞在脚边一闪。", "en": "Brown scales flicker at your heel."},
        {"zh": "我小跑着跟上，又停下等你。", "en": "I trot to catch up, then stop and wait."},
        {"zh": "等你叫，我再动。", "en": "I move when you call."},
        {"zh": "我的尾巴翘着。", "en": "My tail rides high."},
        {"zh": "我绕着你的脚打转。", "en": "I circle your feet."},
        {"zh": "我落脚很轻，怕惊着林子。", "en": "I set my feet softly, wary of startling the wood."},
        {"zh": "不命令，我就不远走。", "en": "Without an order, I don't stray."},
        {"zh": "我抬头，看你的手。", "en": "I look up at your hands."},
        {"zh": "走到哪儿，我跟到哪儿。", "en": "Wherever you go, I follow."},
        {"zh": "地面上留着我的小印。", "en": "My small prints on the ground."},
        {"zh": "我踩着你影子的边跟着。", "en": "I follow along the edge of your shadow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在旁边，等你说话。", "en": "I sit beside you, waiting."},
        {"zh": "我下巴搭在前爪上打盹。", "en": "I doze with my chin on my forepaws."},
        {"zh": "风把鳞片吹凉了。", "en": "The wind cools my scales."},
        {"zh": "耳朵动了一下。", "en": "One ear twitches."},
        {"zh": "我不吵，也不走。", "en": "I'm quiet, and I stay."},
        {"zh": "我在看着林子的边。", "en": "I watch the forest's edge."},
        {"zh": "尾巴尖一下一下敲着土。", "en": "My tail tip taps the dirt, beat by beat."},
        {"zh": "你一抬手，我耳朵先动。", "en": "When you raise a hand, my ears move first."},
        {"zh": "我伏下身子，收起爪尖。", "en": "I settle low and sheathe my claws."},
        {"zh": "太阳晒得鳞片发暖。", "en": "The sun warms my scales."},
        {"zh": "我换了个姿势趴着。", "en": "I shift how I lie."},
        {"zh": "我守着这片林子，眼也不眨。", "en": "I keep watch over this wood without blinking."},
        {"zh": "有虫飞过，我看了一眼。", "en": "A bug flies by; I glance."},
        {"zh": "我缩在离你一步的地方。", "en": "I curl up one step from you."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你要我做什么？", "en": "What do you want me to do?"},
        {"zh": "我的牙不会对着你。", "en": "My fangs don't point at you."},
        {"zh": "你手一抬，我就知道。", "en": "When your hand lifts, I understand."},
        {"zh": "我在等你下命令。", "en": "I'm waiting for your order."},
        {"zh": "我的尾巴摇得很轻。", "en": "My tail wags slightly."},
        {"zh": "别把我忘了。", "en": "Don't forget about me."},
        {"zh": "我不咬你，我咬别人。", "en": "I don't bite you; I bite others."},
        {"zh": "你在前头，我盯着后面的树。", "en": "You go ahead; I keep an eye on the trees behind."},
        {"zh": "我抬起头，把脖子露给你。", "en": "I lift my head and bare my neck."},
        {"zh": "你的手，我认得。", "en": "I know your hand."},
        {"zh": "打猎的时候，我冲前面。", "en": "In a hunt, I go first."},
        {"zh": "我看着你，不走开。", "en": "I watch you and don't leave."},
        {"zh": "你累了，我就守着。", "en": "If you're tired, I'll keep watch."},
        {"zh": "我的鳞，可以摸。", "en": "You may touch my scales."},
        {"zh": "我们要去哪儿？", "en": "Where are we going?"},
        {"zh": "你笑，我就高兴。", "en": "When you smile, I'm glad."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠着你的靴子喘气。", "en": "I lean against your boot and pant."},
        {"zh": "鳞裂了，但不碍事。", "en": "A cracked scale, nothing more."},
        {"zh": "我叫了一声，忍住了。", "en": "I cry out once and bear it."},
        {"zh": "四条腿还撑得住我。", "en": "Four legs still hold me up."},
        {"zh": "这点疼我忍得下。", "en": "I can bear this pain."},
        {"zh": "血落在落叶上。", "en": "Blood falls on the leaves."},
        {"zh": "我的尾巴耷拉下来。", "en": "My tail sags."},
        {"zh": "皮外伤，我舔舔就好。", "en": "A scratch; a few licks will do."},
        {"zh": "我伏低，护着肚子。", "en": "I crouch, guarding my belly."},
        {"zh": "我还可以打。", "en": "I can still fight."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉？我先看看你。", "en": "Meat? Let me check with you first."},
        {"zh": "你点头，我才吃。", "en": "I eat once you nod."},
        {"zh": "同族在那边看着。", "en": "My kin are watching."},
        {"zh": "我吃一半，留一半。", "en": "I'll eat half and keep half."},
        {"zh": "你手里的，我能拿吗？", "en": "May I take that from your hand?"},
        {"zh": "这点填不饱肚子。", "en": "That won't fill my belly."},
        {"zh": "我吃慢一点。", "en": "I'll eat slowly."},
        {"zh": "别让别的来抢。", "en": "Don't let the others take it."},
        {"zh": "吃完我还跟着你。", "en": "After eating, I still follow you."},
        {"zh": "这口我谢过了。", "en": "I thank you for that bite."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我给让出一条路。", "en": "I've cleared a path."},
        {"zh": "撞疼你了吗？", "en": "Did that hurt you?"},
        {"zh": "我的鳞有点硬。", "en": "My scales are a bit hard."},
        {"zh": "我贴在你脚边，容易碰。", "en": "Staying at your heel, I get bumped."},
        {"zh": "我退一步，蹲下。", "en": "I step back and crouch."},
        {"zh": "这一下我不是有意的。", "en": "That wasn't on purpose."},
        {"zh": "我绕着你的腿走了半圈。", "en": "I circle half around your legs."},
        {"zh": "这点碰撞，没关系。", "en": "That bump is fine."},
        {"zh": "你的靴底压住我尾巴尖。", "en": "Your sole pins my tail tip."},
        {"zh": "我在你旁边，别急。", "en": "I'm beside you; take it easy."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "主人同意，我才去。", "en": "Only with my keeper's leave."},
        {"zh": "那只棕鳞，跟我很配。", "en": "That brown one suits me."},
        {"zh": "我们在巢边转圈。", "en": "We circle by the nest."},
        {"zh": "她先闻了闻我的手。", "en": "She sniffs my foreleg first."},
        {"zh": "主人看着我们。", "en": "My keeper watches us."},
        {"zh": "巢里铺了软叶。", "en": "Softer leaves for the nest."},
        {"zh": "我们轮流守着这窝。", "en": "We take turns guarding it."},
        {"zh": "我不往远处去。", "en": "I won't go far."},
        {"zh": "她蹭了蹭我的鳞。", "en": "She nuzzles my scales."},
        {"zh": "这样的日子就很好。", "en": "Days like this are good."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起来，等你示意。", "en": "I pick it up and wait for a sign."},
        {"zh": "这个要带回去吗？", "en": "Should I bring this back?"},
        {"zh": "我把它搁在你跟前。", "en": "I set it down before you."},
        {"zh": "掉了，我去捡。", "en": "Dropped; I'll fetch it."},
        {"zh": "我叼一件就满了嘴。", "en": "One item fills my mouth."},
        {"zh": "我叼得很稳。", "en": "I carry it securely."},
        {"zh": "这东西不重。", "en": "It isn't heavy."},
        {"zh": "你点头，我就放下。", "en": "Nod and I'll put it down."},
        {"zh": "我留着给你。", "en": "I keep it for you."},
        {"zh": "东西落哪儿，我记在脑子里。", "en": "I've noted where it fell."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有影子滑了过来。", "en": "A shadow has slid over."},
        {"zh": "我站起来，挡在前面。", "en": "I rise and stand in front."},
        {"zh": "那是敌人不成？", "en": "Could that be an enemy?"},
        {"zh": "我等你示意。", "en": "I await your signal."},
        {"zh": "我呲着牙，等你点头。", "en": "I bare my teeth and wait for your nod."},
        {"zh": "我贴地潜过去，不发出声。", "en": "I creep in flat to the ground, silent."},
        {"zh": "有我挡着，你退后些。", "en": "I'm blocking it; you move back."},
        {"zh": "我的眼锁住那边。", "en": "My eyes lock that way."},
        {"zh": "它进到我能扑到的圈里了。", "en": "It's inside the ring I can pounce from."},
        {"zh": "你退后，我上前。", "en": "You fall back; I go forward."},
        {"zh": "我把它的位置刻下来。", "en": "I've fixed its position."},
        {"zh": "这一次，我来。", "en": "This time, I'll handle it."},
        {"zh": "我这边准备好了。", "en": "I'm ready here."},
        {"zh": "你一句话就行。", "en": "Just say the word."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我横在你和它之间。", "en": "I put myself between you and it."},
        {"zh": "它再近，我就扑。", "en": "One step closer and I lunge."},
        {"zh": "我的尾巴绷成一条线。", "en": "My tail draws into a line."},
        {"zh": "我牙关闭着，一步不挪。", "en": "My jaws stay shut; I don't give an inch."},
        {"zh": "我在等你的手势。", "en": "I wait for your gesture."},
        {"zh": "地上的落叶在响。", "en": "Leaves rustle on the ground."},
        {"zh": "它绕，我也绕。", "en": "It circles; so do I."},
        {"zh": "你的背后，我守住了。", "en": "I've got your back."},
        {"zh": "同族也过来了。", "en": "My kin have come too."},
        {"zh": "三步就能扑到。", "en": "Three strides to the pounce."},
        {"zh": "它每个动作我都数着。", "en": "I count its every move."},
        {"zh": "一击就够了。", "en": "One strike should do."},
        {"zh": "这一刻终于到了。", "en": "The moment is finally here."},
        {"zh": "我后爪一压，扑了出去。", "en": "I load my hind legs and spring."},
        {"zh": "别让它碰到你。", "en": "It won't reach you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我替你咬它！", "en": "I bite it for you!"},
        {"zh": "毒已经挂上牙了。", "en": "Venom's on my fangs."},
        {"zh": "这一口，很快。", "en": "That bite was quick."},
        {"zh": "我横过身子，替你挡那一下。", "en": "I throw myself across to take that blow for you."},
        {"zh": "爪子只划了一下。", "en": "Only one rake of the claws."},
        {"zh": "它退了，我追半步。", "en": "It retreats; I follow half a step."},
        {"zh": "它往你那边一步，我就咬。", "en": "One step toward you and I bite."},
        {"zh": "同族也一起上了。", "en": "My kin join in too."},
        {"zh": "我的鳞被撞了一下。", "en": "My scales took a hit."},
        {"zh": "它腿在抖，再加一口。", "en": "Its legs are shaking; one more bite."},
        {"zh": "我还想再来一口。", "en": "I'd like one more bite."},
        {"zh": "血溅到你了吗？我挡慢了。", "en": "Did its blood splash you? I was slow."},
        {"zh": "这一口这就够了。", "en": "That bite is enough."},
        {"zh": "我回到你脚边。", "en": "I return to your heel."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着主人进了林子。", "en": "I follow my keeper into the wood."},
        {"zh": "棕鳞在落叶上很显眼。", "en": "Brown scales stand out on leaves."},
        {"zh": "我把这块地闻了个遍。", "en": "I've sniffed every part of this ground."},
        {"zh": "这地方安全吗？", "en": "Is this place safe?"},
        {"zh": "我在你脚边坐下。", "en": "I sit at your heel."},
        {"zh": "风送来一股不属于林子的味。", "en": "The wind brings a scent not of this wood."},
        {"zh": "同族在远处。", "en": "My kin are far off."},
        {"zh": "我抬头望着你。", "en": "I look up at you."},
        {"zh": "尾巴摆了两下。", "en": "My tail swings twice."},
        {"zh": "我等着你的命令。", "en": "I wait for orders."},
        {"zh": "林子深得很。", "en": "The wood runs deep."},
        {"zh": "我守在外侧。", "en": "I take the outer side."},
        {"zh": "我们走哪边？", "en": "Which way do we go?"},
        {"zh": "我跟紧一点。", "en": "I'll keep closer."},
        {"zh": "我站在斑驳的树影里。", "en": "I stand in the dappled tree shadow."},
        {"zh": "我嗅了嗅你的靴子。", "en": "I sniff at your boot."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，我跳到你身后。", "en": "Fire; I leap behind you."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，翻了个身。", "en": "I fall and roll."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我呛水了，扑腾着想上岸。", "en": "I choke and thrash for the bank."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我撞在树干上。", "en": "The blast slams me into a trunk."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "后腿中了一箭，我瘸着退。", "en": "An arrow in my hind leg; I limp back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "邪力箍住了我的身子。", "en": "Foul force binds my body."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得没力气跟了。", "en": "Too hungry to keep up."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一响，我贴紧地面。", "en": "Thunder; I press to the ground."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空荡荡，我往下坠。", "en": "The ground's gone; I fall."}
      ]
    }
  }
}
