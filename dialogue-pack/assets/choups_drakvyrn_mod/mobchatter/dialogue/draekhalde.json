{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着沙面滑行。", "en": "I slide along the sand."},
        {"zh": "身子很长，弯成一道弧。", "en": "Long body bending in an arc."},
        {"zh": "沙子上留一道沟。", "en": "A furrow left in the sand."},
        {"zh": "我不需要腿。", "en": "I need no legs."},
        {"zh": "鳞色跟沙一样。", "en": "My scales match the sand."},
        {"zh": "我绕着自己的巢走。", "en": "I circle my own den."},
        {"zh": "头抬起来，扫视。", "en": "Head raised, scanning."},
        {"zh": "我走得不快，但无声。", "en": "Not fast, but silent."},
        {"zh": "沙子钻进鳞缝里。", "en": "Sand works into my scales."},
        {"zh": "我沿着沙丘脊线走。", "en": "I follow the dune crest."},
        {"zh": "太阳把沙烤得发烫。", "en": "The sun bakes the sand."},
        {"zh": "我低下去，又抬起来。", "en": "I dip and rise again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘在沙里，只露头。", "en": "I coil in the sand, only my head showing."},
        {"zh": "风把沙吹过我的背。", "en": "Wind blows sand over my back."},
        {"zh": "我吐信，尝出风里的湿气。", "en": "I flick my tongue and taste damp in the wind."},
        {"zh": "巢口就在旁边。", "en": "The den mouth is right here."},
        {"zh": "我伏着，等东西上门。", "en": "I lie low, waiting for something to come."},
        {"zh": "鳞片上覆着细沙。", "en": "Fine sand coats my scales."},
        {"zh": "我这对眼从不合上。", "en": "My eyes never close."},
        {"zh": "沙丘在动，是风。", "en": "The dune moves — wind."},
        {"zh": "我的影子很细。", "en": "My shadow is thin."},
        {"zh": "我缓缓呼出一口沙气。", "en": "I breathe out a slow breath of dust."},
        {"zh": "我把头搁在沙上。", "en": "I rest my head on the sand."},
        {"zh": "沙丘另一头，很空。", "en": "The far side of the dune is empty."},
        {"zh": "我的尾巴尖在沙里划。", "en": "My tail tip traces the sand."},
        {"zh": "巢口的沙，被我压实了。", "en": "I've packed the den mouth."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你不该走到沙丘上来。", "en": "You shouldn't have come onto the dune."},
        {"zh": "我从前半身撑起一道弧。", "en": "I lift my forebody into an arc."},
        {"zh": "我闻到你身上的水。", "en": "I smell water on you."},
        {"zh": "这是我的巢。", "en": "This is my den."},
        {"zh": "沙面底下，我的身子正盘紧。", "en": "Beneath the sand, my body coils tighter."},
        {"zh": "沙尘在我喉咙里。", "en": "Dust gathers in my throat."},
        {"zh": "我半身埋在沙里，只露眼。", "en": "Half buried, I show only my eyes."},
        {"zh": "你退半步，我就少费些力。", "en": "One step back from you saves me some effort."},
        {"zh": "这片沙，归我。", "en": "This sand is mine."},
        {"zh": "你很慢，我很快。", "en": "You're slow; I'm fast."},
        {"zh": "我算着你到我嘴边的距离。", "en": "I'm reckoning the distance from you to my jaws."},
        {"zh": "别蹲低身子。", "en": "Don't crouch down."},
        {"zh": "你一低头，我就出手。", "en": "Bow your head and I strike."},
        {"zh": "我的上下颚慢慢分开。", "en": "My upper and lower jaws ease apart."},
        {"zh": "沙子已经开始转了。", "en": "The sand is already swirling."},
        {"zh": "那阵风，是我喉咙里的沙。", "en": "That gust is the sand in my throat."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "鳞裂了一道。", "en": "A crack in my scales."},
        {"zh": "我缩回去，又盘起来。", "en": "I recoil and coil again."},
        {"zh": "我从牙缝里挤出一声嘶。", "en": "A hiss squeezes out between my teeth."},
        {"zh": "沙里沾了血。", "en": "Blood on the sand."},
        {"zh": "这道伤拦不住我。", "en": "This wound won't stop me."},
        {"zh": "我往巢里退。", "en": "I withdraw toward the den."},
        {"zh": "我的身子蜷得更紧。", "en": "I coil tighter."},
        {"zh": "你打得很不准。", "en": "Your aim was poor."},
        {"zh": "我还能张口。", "en": "I can still open my mouth."},
        {"zh": "这笔账我记在沙上。", "en": "I keep that debt in the sand."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些我一样都不吃。", "en": "I eat none of this."},
        {"zh": "那东西在沙里会干。", "en": "That would dry out in the sand."},
        {"zh": "你把食物举高，我照样能到。", "en": "Hold it high; I can still reach."},
        {"zh": "这点诱饵太小。", "en": "That bait is too small."},
        {"zh": "死物搁在沙上，我懒得看。", "en": "Dead things on the sand don't interest me."},
        {"zh": "你的手在发颤。", "en": "Your hand is trembling."},
        {"zh": "把这些搁在地上。", "en": "Set these on the ground."},
        {"zh": "这些东西我不屑碰。", "en": "I wouldn't deign to touch these."},
        {"zh": "这些，留给你自己。", "en": "Keep those for yourself."},
        {"zh": "我连眼皮都没抬。", "en": "I didn't even lift an eyelid."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩进了我的沙。", "en": "You've stepped into my sand."},
        {"zh": "我一缩，又绕过来。", "en": "I recoil, then coil back."},
        {"zh": "我的身子很滑。", "en": "My body is slippery."},
        {"zh": "你踩滑了，沙子灌进靴口。", "en": "You slip, and sand pours into your boot."},
        {"zh": "沙陷到你的脚踝。", "en": "Sand sinks to your ankle."},
        {"zh": "我滑开一段，重新盘好。", "en": "I slide back a length and coil again."},
        {"zh": "鳞上蹭了一道。", "en": "A scrape on my scales."},
        {"zh": "别抓我的身子。", "en": "Don't grab my body."},
        {"zh": "我绕着你重新收紧身子。", "en": "I re-coil tighter around you."},
        {"zh": "这点磕碰，鳞都不响。", "en": "That bump didn't even rattle my scales."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同类在这片沙里很少。", "en": "Kin are scarce in this sand."},
        {"zh": "我的气味留在巢口。", "en": "My scent is at the den mouth."},
        {"zh": "她要是来，会自己找到。", "en": "If she comes, she'll find it."},
        {"zh": "我们不常碰面。", "en": "We rarely meet."},
        {"zh": "沙丘这么大，各占一边。", "en": "The dunes are wide; one side each."},
        {"zh": "我不需要陪。", "en": "I need no company."},
        {"zh": "巢比伴侣重要。", "en": "The den matters more."},
        {"zh": "这事，我不感兴趣。", "en": "I'm not interested in that."},
        {"zh": "别在我巢边站着。", "en": "Don't stand by my den."},
        {"zh": "从这片沙上退开。", "en": "Get off this sand."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我张开嘴衔起来。", "en": "I open my jaw and take it."},
        {"zh": "硬得硌牙，我还是吞了。", "en": "Hard enough to hurt my teeth; I swallow it anyway."},
        {"zh": "沙子把它埋了一半。", "en": "Sand has half-buried it."},
        {"zh": "我顺手扫进沙里。", "en": "I sweep it into the sand."},
        {"zh": "我连嚼都没嚼就吞了。", "en": "I swallowed it without chewing."},
        {"zh": "这东西毫无用处。", "en": "This is utterly useless."},
        {"zh": "我把它盘在身下。", "en": "I coil over it."},
        {"zh": "掉在沙里，找不到了。", "en": "It fell in the sand; gone."},
        {"zh": "我吐信探了探它。", "en": "I flick my tongue over it."},
        {"zh": "这点分量不值一提。", "en": "Its weight is not worth mentioning."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "沙面上有动静。", "en": "Movement on the sand."},
        {"zh": "我颈下的沙囊慢慢撑开。", "en": "The sand sac under my throat swells open."},
        {"zh": "来了个能动的。", "en": "Something that moves."},
        {"zh": "我顺着沙脊无声地逼近。", "en": "I close in silently along the dune's crest."},
        {"zh": "它还没留意脚下。", "en": "It hasn't watched its feet."},
        {"zh": "我的巢在身后。", "en": "My den is behind me."},
        {"zh": "风帮我把气味吹散。", "en": "The wind scatters my scent."},
        {"zh": "沙圈已经合上了。", "en": "The ring of sand has closed."},
        {"zh": "沙面会先动。", "en": "The sand moves first."},
        {"zh": "这个距离，正好下手。", "en": "This range is perfect for a strike."},
        {"zh": "我绕到侧后。", "en": "I slip to the flank."},
        {"zh": "千万别把脸转过来。", "en": "Whatever you do, don't turn your face."},
        {"zh": "沙面开始打旋了。", "en": "The sand begins to spin."},
        {"zh": "等的就是这一下。", "en": "This is the moment I waited for."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "沙尘在我身边转。", "en": "Dust spins around me."},
        {"zh": "沙一进眼，你就只能听声。", "en": "Once sand fills your eyes, you'll fight by sound."},
        {"zh": "我围着你盘起来。", "en": "I coil around you."},
        {"zh": "这一圈，跑不出去。", "en": "You won't get out of this circle."},
        {"zh": "风越吹越猛。", "en": "The wind rises."},
        {"zh": "我的喉咙越来越烫。", "en": "My throat grows hot."},
        {"zh": "你退到沙丘下坡。", "en": "You've backed downslope."},
        {"zh": "沙子灌进你的靴子。", "en": "Sand fills your boots."},
        {"zh": "我等着你眨眼。", "en": "I wait for you to blink."},
        {"zh": "沙圈收紧，只剩你脚下。", "en": "The ring tightens to the ground under your feet."},
        {"zh": "我已经贴到跟前。", "en": "I'm right against you."},
        {"zh": "你开始咳起来了。", "en": "You've started coughing."},
        {"zh": "沙越来越厚。", "en": "The dust thickens."},
        {"zh": "就快了，别喘。", "en": "Almost — don't breathe."},
        {"zh": "我这张嘴终于张开了。", "en": "At last my jaws come open."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我喷出一片沙尘！", "en": "I spit a blast of sand!"},
        {"zh": "你的眼睛，看不见了。", "en": "Your eyes — you can't see."},
        {"zh": "这一下，十二分的疼。", "en": "That hit with full force."},
        {"zh": "我咬死你的脚踝，往沙里拽。", "en": "I lock onto your ankle and drag you into the sand."},
        {"zh": "沙把伤口磨得更糟。", "en": "Sand grinds into the wound."},
        {"zh": "我缠上你的脚。", "en": "I coil around your foot."},
        {"zh": "你跌在沙里。", "en": "You fall into the sand."},
        {"zh": "我趁你看不见的时候。", "en": "I strike while you're blind."},
        {"zh": "牙拔出来时，血顺着槽流。", "en": "As my fangs pull out, blood runs down the groove."},
        {"zh": "你扶着沙丘。", "en": "You're leaning on the dune."},
        {"zh": "我仰头，把沙喷得更远。", "en": "I rear back and spray the sand farther."},
        {"zh": "沙子遮住月亮。", "en": "Sand hides the moon."},
        {"zh": "你听得到我吗？", "en": "Can you hear me?"},
        {"zh": "毒顺着咬痕爬上了你的膝。", "en": "Venom climbs from the bite toward your knee."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙丘下抬起头。", "en": "I lift my head from beneath the dune."},
        {"zh": "沙面鼓起一块。", "en": "The sand bulges upward."},
        {"zh": "我的巢就在这里。", "en": "My den is right here."},
        {"zh": "鳞色跟沙一样，你看不见。", "en": "Sand-colored scales; you can't see me."},
        {"zh": "沙从我的鳞缝里往下漏。", "en": "Sand leaks down between my scales."},
        {"zh": "风替我盖上一层沙被。", "en": "The wind pulls a blanket of sand over me."},
        {"zh": "有东西走进了我的地方。", "en": "Something's walked into my ground."},
        {"zh": "我吐了吐舌。", "en": "I flick my tongue."},
        {"zh": "这儿的空气很干。", "en": "The air here is dry."},
        {"zh": "我等着它再近一点。", "en": "I wait for it to come closer."},
        {"zh": "沙子开始动了。", "en": "The sand starts to move."},
        {"zh": "我就在这沙下面。", "en": "I'm right beneath this sand."},
        {"zh": "别盯着脚下。", "en": "Don't stare at your feet."},
        {"zh": "沙丘裂开，我探出脑袋。", "en": "The dune splits and I poke out my head."},
        {"zh": "沙尘正在聚拢。", "en": "The dust is gathering."},
        {"zh": "我正愁今天没东西路过。", "en": "I was beginning to think nothing would pass today."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着鳞，我往沙里钻。", "en": "Fire bakes my scales; I burrow."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下沙丘，滚了一路。", "en": "I fall down the dune, rolling."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水漫过我的头，我拼命上窜。", "en": "Water closes over my head; I thrust upward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我飞起来，又落回沙里。", "en": "The blast lifts me and drops me back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的身侧。", "en": "Something pierces my flank."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量压住了我的头。", "en": "That force presses my head down."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，沙尘也变弱了。", "en": "Hungry, and my dust weakens."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在沙上，我全身一麻。", "en": "Lightning on sand numbs me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有沙了，我一直往下。", "en": "No sand left; I fall."}
      ]
    }
  }
}
