{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我低着身子快跑。", "en": "I run low and fast."},
        {"zh": "棕色的鳞，贴着落叶。", "en": "Brown scales against fallen leaves."},
        {"zh": "我三步并作两步。", "en": "I take two strides for every one."},
        {"zh": "森林里，我跑得比谁都快。", "en": "In this forest, nothing outruns me."},
        {"zh": "我的尾巴撑着平衡。", "en": "My tail holds my balance."},
        {"zh": "我绕着巢边的树跑。", "en": "I run around the trees by my nest."},
        {"zh": "我边走边磨牙，毒液在滴。", "en": "I grind my teeth as I walk, venom dripping."},
        {"zh": "我踩着枯枝，咔一声。", "en": "A dry twig snaps under me."},
        {"zh": "我朝你的方向跑。", "en": "I run in your direction."},
        {"zh": "我贴着地面，很矮。", "en": "I keep low to the ground."},
        {"zh": "爪子抓地，一蹬就窜。", "en": "My claws dig in and I shoot forward."},
        {"zh": "鳞片在光下泛油。", "en": "My scales sheen with oil."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在巢边，等着。", "en": "I lie by the nest, waiting."},
        {"zh": "我的眼睛跟着你转。", "en": "My eyes track you."},
        {"zh": "喉咙里在响。", "en": "Something rumbles in my throat."},
        {"zh": "毒囊鼓着，已经满了。", "en": "My venom sac is full."},
        {"zh": "我的爪尖刮着地。", "en": "My claws score the earth."},
        {"zh": "这一带有我的气味。", "en": "My scent marks this area."},
        {"zh": "我把头抬起来闻风。", "en": "I lift my head and scent the wind."},
        {"zh": "风吹过鳞片，沙沙响。", "en": "Wind rasps over my scales."},
        {"zh": "我这对眼一直睁着。", "en": "My eyes stay open."},
        {"zh": "我垂下头，耳朵仍朝向你。", "en": "I lower my head, ears still aimed at you."},
        {"zh": "我换到能看清你的角度。", "en": "I shift to an angle where I can see you."},
        {"zh": "树影盖着我。", "en": "The tree shadow covers me."},
        {"zh": "我的爪子在土里刨了两下。", "en": "I scratch the dirt twice."},
        {"zh": "树上的鸟都不叫了。", "en": "The birds in the trees have gone quiet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "巢里有三颗蛋，你离远点。", "en": "Three eggs in this nest — keep your distance."},
        {"zh": "我把鼻尖对准你的膝盖。", "en": "I point my snout at your knee."},
        {"zh": "我的牙上有毒。", "en": "There's venom on my fangs."},
        {"zh": "三个一起，你对付不了。", "en": "Three of us — you can't handle that."},
        {"zh": "喉咙里滚出一串低吼。", "en": "A low growl rolls from my throat."},
        {"zh": "你别退，也别进。", "en": "Neither back away nor come closer."},
        {"zh": "我瞄着你的喉结。", "en": "I aim at your throat."},
        {"zh": "我的鳞是棕色的。", "en": "My scales are brown."},
        {"zh": "这巢里有蛋。", "en": "There are eggs in this nest."},
        {"zh": "再迈半步，我就咬你脚踝。", "en": "Half a step more and I bite your ankle."},
        {"zh": "我已经准备好扑了。", "en": "I'm ready to spring."},
        {"zh": "你身上的味儿，很新。", "en": "Your scent is new."},
        {"zh": "我咬人从来不问缘由。", "en": "I never ask why before biting."},
        {"zh": "我的尾巴在扫。", "en": "My tail is sweeping."},
        {"zh": "把手里的东西放下。", "en": "Put down what you're holding."},
        {"zh": "我伏低身子，只等你再动。", "en": "I crouch low, just waiting for you to move."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "肩上的鳞裂了，血渗出来。", "en": "The scale on my shoulder split; blood seeps out."},
        {"zh": "我撑起前爪，抖掉身上的土。", "en": "I push up on my forelegs and shake off the dirt."},
        {"zh": "我嘶了一声，退了。", "en": "I hiss and back off."},
        {"zh": "这一口伤不到我筋骨。", "en": "That bite didn't reach my bones."},
        {"zh": "尾巴一甩，抽在落叶上。", "en": "My tail cracks against the leaves."},
        {"zh": "我伏低一点，蓄着劲。", "en": "I crouch lower, gathering myself."},
        {"zh": "血滴进了落叶里。", "en": "Blood drips into the leaf litter."},
        {"zh": "同族叫了一声。", "en": "My kin cried out."},
        {"zh": "我退到树根后。", "en": "I retreat behind the roots."},
        {"zh": "这不影响我咬人。", "en": "This won't stop my bite."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是块带血的肉。", "en": "That's a piece of bloody meat."},
        {"zh": "你举着它，我闻得到。", "en": "I can smell it from there."},
        {"zh": "先尝一口，再决定跟不跟。", "en": "One taste first, then I decide whether to follow."},
        {"zh": "肉插在骨头上？有意思。", "en": "Meat on a bone? Interesting."},
        {"zh": "我不吃生的太久。", "en": "I don't stay on raw for long."},
        {"zh": "给一口，我就不追。", "en": "One bite and I stop chasing."},
        {"zh": "这点不够三条分。", "en": "Not enough for three."},
        {"zh": "你退后，我再过来。", "en": "Step back; then I'll come."},
        {"zh": "我的同族也在看。", "en": "My kin are watching too."},
        {"zh": "放下它，然后退。", "en": "Put it down, then back away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我的鳞很硬。", "en": "You hit me; my scales are hard."},
        {"zh": "我一骨碌翻起来，鳞上沾土。", "en": "I roll upright, dirt on my scales."},
        {"zh": "爬起来，牙还露着。", "en": "Up again, fangs still bared."},
        {"zh": "我这么轻，一撞就滚。", "en": "I'm so light, one bump sends me rolling."},
        {"zh": "尾巴被踩住，我扭头就咬。", "en": "My tail is pinned; I twist and bite."},
        {"zh": "这一下，你手上有味道了。", "en": "Now your hand carries my scent."},
        {"zh": "我退到树根边。", "en": "I retreat to the tree roots."},
        {"zh": "这点磕碰不算什么。", "en": "That bump is nothing."},
        {"zh": "我又扑到你身上。", "en": "I'm on you again."},
        {"zh": "别拿脚来踹。", "en": "Don't try kicking."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "巢里的那只，鳞色很亮。", "en": "That one at the nest has bright scales."},
        {"zh": "我把猎物拖过去。", "en": "I drag a catch over to her."},
        {"zh": "我们挤在树根下。", "en": "We crowd under the roots."},
        {"zh": "三只一起守着蛋。", "en": "The three of us guard the eggs."},
        {"zh": "她比我还凶。", "en": "She's fiercer than I am."},
        {"zh": "我舔了舔她的颈。", "en": "I lick her neck."},
        {"zh": "巢里铺了干叶子。", "en": "The nest is lined with dry leaves."},
        {"zh": "我守前半夜，她守后半夜。", "en": "I watch the first half of the night; she takes the second."},
        {"zh": "别靠近那边。", "en": "Don't go near that."},
        {"zh": "她咬你了，活该。", "en": "She bit you — deserved."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块肉还带着热气。", "en": "This meat is still steaming."},
        {"zh": "我一叼就跑。", "en": "I snatch it and run."},
        {"zh": "这块太小了。", "en": "Too small."},
        {"zh": "我的嘴不大。", "en": "My mouth isn't big."},
        {"zh": "它卡在牙缝里。", "en": "It's stuck between my teeth."},
        {"zh": "我不跟同族抢。", "en": "I don't fight my kin over it."},
        {"zh": "叼回巢里去。", "en": "Off to the nest with it."},
        {"zh": "掉了，我回头找。", "en": "Dropped; I look back for it."},
        {"zh": "这东西腥得厉害。", "en": "This reeks strongly."},
        {"zh": "这块我先压在落叶下。", "en": "I'll pin this under the leaf litter first."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里进了东西。", "en": "Something entered the wood."},
        {"zh": "我抬起头，牙露出来。", "en": "I raise my head, fangs out."},
        {"zh": "这味道，不是猎物。", "en": "This scent isn't prey."},
        {"zh": "我把肚皮压进腐叶里。", "en": "I press my belly into the rotting leaves."},
        {"zh": "同族也叫了一声。", "en": "My kin called out too."},
        {"zh": "我已经把你圈进来了。", "en": "I've already circled you in."},
        {"zh": "我后腿蹬实，就要窜出去。", "en": "My hind legs plant; I'm about to bolt."},
        {"zh": "你的脚步太响。", "en": "Your steps are too loud."},
        {"zh": "从侧面过去。", "en": "I'll take the flank."},
        {"zh": "你后脚刚动，我就知道了。", "en": "The moment your back foot moves, I know."},
        {"zh": "树枝在我脚下断。", "en": "A branch snaps under me."},
        {"zh": "三步就能追上。", "en": "Three strides is all."},
        {"zh": "毒已经挂在牙上。", "en": "The venom is on my fangs."},
        {"zh": "我从树根边冲出去。", "en": "I burst from the roots."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地跑。", "en": "I run low along the ground."},
        {"zh": "你往哪边挪，我封哪边。", "en": "Whichever way you shift, I block it."},
        {"zh": "三只从三边来。", "en": "Three of us from three sides."},
        {"zh": "你背抵着树干。", "en": "Your back is to the trunk."},
        {"zh": "我不叫了，我要咬。", "en": "No more hissing; I'm biting."},
        {"zh": "我的尾巴绷直。", "en": "My tail goes straight."},
        {"zh": "只剩一步的距离。", "en": "Only one stride left."},
        {"zh": "我蹬地跃起来了。", "en": "I've kicked off the ground."},
        {"zh": "毒牙对准你的腿。", "en": "Fangs aimed at your leg."},
        {"zh": "你越挣，我围得越紧。", "en": "The more you struggle, the tighter I close in."},
        {"zh": "这一下，你会麻。", "en": "You'll go numb."},
        {"zh": "再挣扎也没用。", "en": "Struggling won't help."},
        {"zh": "毒牙卡住，绝不松开。", "en": "My fangs are set — no letting go."},
        {"zh": "同族围上来了。", "en": "My kin are closing in."},
        {"zh": "这一口就收尾。", "en": "This bite finishes it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的牙咬实了！", "en": "My teeth clamp down!"},
        {"zh": "毒顺着牙进去了。", "en": "The venom goes in with the fangs."},
        {"zh": "我用爪子扒你的腿。", "en": "My claws rake your leg."},
        {"zh": "咬完我立刻后撤。", "en": "I bite and immediately withdraw."},
        {"zh": "你腿开始软了。", "en": "Your leg is going weak."},
        {"zh": "我的牙不长，但够深。", "en": "Short fangs, deep enough."},
        {"zh": "我尖声嘶了一下。", "en": "I hiss sharply."},
        {"zh": "我又跳上来了。", "en": "I leap up again."},
        {"zh": "别碰我的脖颈。", "en": "Keep off my neck."},
        {"zh": "同族咬在你的另一边。", "en": "My kin bites your other side."},
        {"zh": "毒上来，你的膝盖先软。", "en": "The venom hits, and your knees go first."},
        {"zh": "牙再合上一次。", "en": "My teeth close once more."},
        {"zh": "这毒，会一阵一阵来。", "en": "The venom comes in waves."},
        {"zh": "我看着你倒。", "en": "I watch you fall."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土缝里挤出半个身子。", "en": "I squeeze half my body out of an earthen gap."},
        {"zh": "三只一起，一起来的。", "en": "Three of us, arriving together."},
        {"zh": "这是我出生的小巢。", "en": "This is the nest where I was born."},
        {"zh": "落叶被我踩响。", "en": "Leaves crunch under me."},
        {"zh": "我先绕巢一圈。", "en": "First I circle the nest."},
        {"zh": "棕色的鳞，藏在树影里。", "en": "Brown scales hidden in shade."},
        {"zh": "这林子里，有活物。", "en": "Living things in this wood."},
        {"zh": "我抬起头嗅了嗅风。", "en": "I raise my head and scent the wind."},
        {"zh": "我的同族也在附近。", "en": "My kin are nearby."},
        {"zh": "巢里有蛋，得守着。", "en": "Eggs to guard in the nest."},
        {"zh": "我压低身子，等。", "en": "I crouch and wait."},
        {"zh": "这地方，我们占了。", "en": "We've claimed this spot."},
        {"zh": "地上的叶子，在动。", "en": "The leaves on the ground stir."},
        {"zh": "我探出头来了。", "en": "I've poked my head out."},
        {"zh": "别往这边挪。", "en": "Don't edge this way."},
        {"zh": "毒牙已经挂在嘴外。", "en": "Venom fangs already bared."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到鳞，我跳开。", "en": "Fire sears my scales; I leap away."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，骨头咔咔响。", "en": "I fall; my bones clack."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我喝了好几口水，四爪乱抓。", "en": "I swallow mouthfuls of water, paws flailing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我翻着滚出去。", "en": "The blast sends me tumbling."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支小箭扎住我的脊背。", "en": "A small arrow bites my spine."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量把我钉住。", "en": "That force pins me down."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得牙都在抖。", "en": "Hunger makes my fangs chatter."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一响，我缩起来了。", "en": "Thunder; I curl up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没东西，我直直坠。", "en": "Nothing below; I fall straight down."}
      ]
    }
  }
}
