        {"zh": "我在等你说话", "en": "I wait for you to speak."},
        {"zh": "我已经哭不出声了", "en": "I can no longer make a sound."},
        {"zh": "但眼泪还在流", "en": "But the tears still fall."},
        {"zh": "这里只有一个出口", "en": "There is only one way out."},
        {"zh": "灯照不到我这里", "en": "The light does not reach me."},
        {"zh": "你的影子比我的短", "en": "Your shadow is shorter than mine."},
        {"zh": "我就在你身边", "en": "I am right beside you."}
      ]
