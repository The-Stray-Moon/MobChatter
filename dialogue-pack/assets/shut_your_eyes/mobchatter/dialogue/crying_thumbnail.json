{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我边走边抖", "en": "I tremble as I walk."},
        {"zh": "眼泪掉在脚边", "en": "Tears fall by my feet."},
        {"zh": "我捂着脸走", "en": "I walk with my face covered."},
        {"zh": "我的步子不稳", "en": "My steps are unsteady."},
        {"zh": "我抽了一下鼻子", "en": "I sniff once."},
        {"zh": "我一边走一边抹脸", "en": "I wipe my face as I go."},
        {"zh": "我从阴影里挪过来", "en": "I shift out of the shadow."},
        {"zh": "眼泪在地上留了印", "en": "My tears leave marks."},
        {"zh": "我没有抬头", "en": "I do not look up."},
        {"zh": "我一步步靠近你", "en": "I come toward you step by step."},
        {"zh": "我在你身后停下", "en": "I stop behind you."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在哭", "en": "I am crying."},
        {"zh": "我停不下眼泪", "en": "I cannot stop the tears."},
        {"zh": "抽泣声在屋里回", "en": "The sobbing echoes in the room."},
        {"zh": "我抱着自己的肩", "en": "I hold my own shoulders."},
        {"zh": "我靠着墙", "en": "I lean against the wall."},
        {"zh": "我的脸一直是湿的", "en": "My face is always wet."},
        {"zh": "我抬起头又低下", "en": "I lift my head, then drop it."},
        {"zh": "声音很小", "en": "The sound is very small."},
        {"zh": "我不知道为什么哭", "en": "I do not know why I cry."},
        {"zh": "眼泪没有味道", "en": "My tears have no taste."},
        {"zh": "我用手背擦了一下", "en": "I wipe with the back of my hand."},
        {"zh": "我抽泣着抬眼", "en": "I look up, sobbing."},
        {"zh": "这一帧里我在哭", "en": "In this frame I am crying."},
        {"zh": "我的眼睛很红", "en": "My eyes are very red."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在看我哭", "en": "You are watching me cry."},
        {"zh": "别看我", "en": "Do not look at me."},
        {"zh": "我的脸很乱", "en": "My face is a mess."},
        {"zh": "你听见了吗", "en": "Do you hear it?"},
        {"zh": "这不是难过", "en": "This is not sadness."},
        {"zh": "我哭了很多年", "en": "I have cried for years."},
        {"zh": "你能借我一点什么吗", "en": "Could you lend me something?"},
        {"zh": "我的眼泪落在你的鞋上", "en": "My tears fall on your shoes."},
        {"zh": "你站得比刚才近", "en": "You are closer than before."},
        {"zh": "我没有停下来过", "en": "I have never stopped."},
        {"zh": "你看我，我哭得更厉害", "en": "You look, and I cry harder."},
        {"zh": "我这副样子是给别人看的", "en": "This face of mine is for others to see."},
        {"zh": "你要不要也坐下", "en": "Would you sit down too?"},
        {"zh": "我没有手帕", "en": "I have no handkerchief."},
        {"zh": "别问我怎么了", "en": "Do not ask what is wrong."},
        {"zh": "你听不清我在说什么吧", "en": "You cannot make out what I am saying, can you?"},
        {"zh": "这张脸是画成这样的", "en": "This face was drawn this way."},
        {"zh": "我哭的时候也在看你", "en": "I watch you while I cry."},
        {"zh": "你就站着吧", "en": "Just stand there."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
