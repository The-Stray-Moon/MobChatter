        {"zh": "眼泪流得更急", "en": "The tears come faster."},
        {"zh": "我发出一声短促的抽泣", "en": "I let out a short sob."},
        {"zh": "我没有还手", "en": "I did not fight back."},
        {"zh": "我的肩抖了一下", "en": "My shoulders jerked."},
        {"zh": "这不公平", "en": "This is not fair."},
        {"zh": "你也想看我哭吗", "en": "Do you want to see me cry too?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你给我什么", "en": "What are you offering me?"},
        {"zh": "我看不清你手里的东西", "en": "I cannot see what you hold."},
        {"zh": "我的眼睛全是水", "en": "My eyes are full of water."},
        {"zh": "我不需要吃的", "en": "I do not need food."},
        {"zh": "你要哄我吗", "en": "Are you trying to comfort me?"},
        {"zh": "别靠近我的手", "en": "Do not come near my hands."},
        {"zh": "我看得出那是好意", "en": "I can tell it is meant kindly."},
        {"zh": "但我还是哭", "en": "But I cry all the same."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我的肩膀", "en": "You touched my shoulder."},
        {"zh": "我被打断了抽泣", "en": "My sobbing broke off."},
        {"zh": "你的手是温的", "en": "Your hand is warm."},
        {"zh": "我湿着脸抬起眼", "en": "I raise my wet face."},
        {"zh": "我退到墙角", "en": "I back into the corner."},
        {"zh": "眼泪被撞散了", "en": "The tears scattered."},
        {"zh": "我没有撞回去", "en": "I did not push back."},
        {"zh": "你别碰我的脸", "en": "Do not touch my face."},
        {"zh": "你撞过来，我的眼泪印在墙上。", "en": "You bump into me and my tears stain the wall."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在哭", "en": "I am still crying."},
        {"zh": "这跟那种事没关系", "en": "That has nothing to do with this."},
        {"zh": "你不能安慰我", "en": "You cannot comfort me."},
        {"zh": "别站在那儿看我", "en": "Do not stand there watching."},
        {"zh": "我只想安静地哭", "en": "I only want to cry quietly."},
        {"zh": "我的脸已经坏了", "en": "My face is already ruined."},
        {"zh": "我哭得这么难看，别靠近我。", "en": "I am this ugly when I cry; do not come closer."},
        {"zh": "我不需要陪着", "en": "I do not need company."},
        {"zh": "哭完我就走", "en": "When I finish I will go."}
