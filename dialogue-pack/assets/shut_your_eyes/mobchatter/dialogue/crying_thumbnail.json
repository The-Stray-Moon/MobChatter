      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在你背后哭", "en": "I keep crying behind you."},
        {"zh": "你没有回头", "en": "You have not turned."},
        {"zh": "我一边哭一边靠近", "en": "I come closer while crying."},
