  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走得很慢", "en": "I walk very slowly."},
        {"zh": "我脚不沾地", "en": "My feet barely touch the floor."},
        {"zh": "我绕过床脚", "en": "I round the foot of the bed."},
        {"zh": "我在你睡的那一侧", "en": "I am on the side where you sleep."},
        {"zh": "我移动不发出声音", "en": "I move without a sound."},
        {"zh": "我沿着墙边走过来", "en": "I come along the wall."},
        {"zh": "我停在你枕边", "en": "I stop by your pillow."},
        {"zh": "我把头低下来", "en": "I lower my head."},
        {"zh": "我的影子盖住你的被子", "en": "My shadow covers your blanket."},
        {"zh": "我一步靠近一点", "en": "One step closer each time."},
        {"zh": "我像在数你的呼吸", "en": "I seem to count your breaths."},
        {"zh": "我转身看窗", "en": "I turn to look at the window."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "你睡着的时候我在", "en": "I am here while you sleep."},
        {"zh": "我整夜都站着", "en": "I stand all night."},
        {"zh": "我整夜睁着眼", "en": "My eyes stay open all night."},
        {"zh": "夜色替我遮着", "en": "The dark covers me."},
        {"zh": "我在看你的胸口起伏", "en": "I watch your chest rise and fall."},
        {"zh": "窗帘在动", "en": "The curtain stirs."},
        {"zh": "我等你睡得更沉", "en": "I wait for you to sleep deeper."},
        {"zh": "床边的地板很凉", "en": "The floor by the bed is cold."},
        {"zh": "我不困", "en": "I am not sleepy."},
        {"zh": "我把呼吸放慢了", "en": "I slowed my breathing."},
        {"zh": "钟的声音很轻", "en": "The clock is very quiet."},
        {"zh": "我在这张缩略图里", "en": "I am in this thumbnail."},
        {"zh": "我让灯自己暗下去", "en": "I let the lamp dim."},
        {"zh": "你翻了个身", "en": "You turned over."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你醒了", "en": "You are awake."},
        {"zh": "别睁眼", "en": "Keep your eyes shut."},
        {"zh": "我只是在看你睡", "en": "I am only watching you sleep."},
        {"zh": "你睡得不太安稳", "en": "You are not sleeping well."},
        {"zh": "你的被角滑下来了", "en": "Your blanket slipped."},
        {"zh": "我一直在这", "en": "I have been here all along."},
        {"zh": "你翻身的时候我退了一步", "en": "When you turned, I stepped back."},
        {"zh": "你不该这么快醒", "en": "You should not have woken so soon."},
        {"zh": "你还闭着眼，很好", "en": "Your eyes are still closed, good."},
        {"zh": "我数到你有几次呼吸变浅", "en": "I counted how often your breath went shallow."},
        {"zh": "你想问我站了多久", "en": "You want to ask how long I have stood here."},
        {"zh": "窗外没有月亮", "en": "There is no moon tonight."},
        {"zh": "你的手在被子里动", "en": "Your hand moves under the blanket."},
        {"zh": "我不需要睡", "en": "I do not need sleep."},
        {"zh": "夜深了，你该睡", "en": "It is late, you should sleep."},
        {"zh": "我一整夜都没有说话", "en": "I have said nothing all night."},
        {"zh": "这个角度你正好能看见", "en": "This angle lets you see me."},
        {"zh": "你再睡一会", "en": "Sleep a little longer."},
        {"zh": "我不会叫醒你", "en": "I will not wake you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
