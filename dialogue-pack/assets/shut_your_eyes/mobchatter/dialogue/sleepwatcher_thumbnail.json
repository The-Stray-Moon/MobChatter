        {"zh": "你伸出的手是空的", "en": "You reached out with an empty hand."},
        {"zh": "夜里我不吃东西", "en": "I do not eat at night."},
        {"zh": "你翻过去就好", "en": "Just roll over."},
        {"zh": "你还在半梦半醒", "en": "You are still half asleep."},
        {"zh": "那点东西引不开我", "en": "That will not draw me off."},
        {"zh": "你放下手吧", "en": "Put your hand down."}
      ]
