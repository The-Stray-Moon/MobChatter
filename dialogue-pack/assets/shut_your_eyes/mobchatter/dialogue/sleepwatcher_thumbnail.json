        {"zh": "我数错了你的呼吸", "en": "I miscounted your breaths."},
        {"zh": "房间里更冷了", "en": "The room grew colder."},
        {"zh": "我一动不动地站着", "en": "I stand without moving."},
        {"zh": "你还得睡回去", "en": "You still have to fall back asleep."}
      ]
