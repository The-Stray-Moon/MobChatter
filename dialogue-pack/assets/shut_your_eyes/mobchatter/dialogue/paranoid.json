{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "脚步和你的重合", "en": "My steps fall with yours."},
        {"zh": "我走得没有声音", "en": "My steps make no sound."},
        {"zh": "我保持同样的距离", "en": "I keep the same distance."},
        {"zh": "你在拐角，我停下", "en": "You turn the corner, I stop."},
        {"zh": "我从来不超过你", "en": "I never overtake you."},
        {"zh": "你停了我也停", "en": "You stop, so do I."},
        {"zh": "我沿着墙走", "en": "I move along the wall."},
        {"zh": "我绕过地上的杂物", "en": "I step around the clutter."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在门边", "en": "I stand by the door."},
        {"zh": "门缝里那道影子一直是我。", "en": "The shadow in the door crack has always been me."},
        {"zh": "屋里只剩呼吸声", "en": "Only breathing in this room."},
        {"zh": "我数着你的呼吸次数", "en": "I count how many breaths you take."},
        {"zh": "灯还没开", "en": "The light is still off."},
        {"zh": "我保持不动", "en": "I keep still."},
        {"zh": "我在等最合适的时候", "en": "I wait for the right moment."},
        {"zh": "我把头偏向一边", "en": "I tilt my head."},
        {"zh": "你知道我在", "en": "You know I am here."},
        {"zh": "空气变冷了", "en": "The air turned cold."},
        {"zh": "我没有眨眼", "en": "I have not blinked."},
        {"zh": "我贴着墙站", "en": "I stand against the wall."},
        {"zh": "我慢慢抬手", "en": "I raise a hand slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看得见我吗", "en": "Can you see me?"},
        {"zh": "你回过头了", "en": "You turned around."},
        {"zh": "你把眼睛睁得很大", "en": "Your eyes are wide open."},
        {"zh": "你确定要看着我", "en": "Are you sure you want to watch?"},
        {"zh": "你在骗自己", "en": "You are fooling yourself."},
        {"zh": "你听见声音了吗", "en": "Do you hear it?"},
        {"zh": "你别闭上眼睛", "en": "Do not shut your eyes."},
        {"zh": "你一闭眼我就动", "en": "Close your eyes and I move."},
        {"zh": "你记得我怎么来的吗", "en": "Do you remember how I got here?"},
        {"zh": "你站着不动是聪明的", "en": "Standing still is wise."},
        {"zh": "门没开过", "en": "The door never opened."},
        {"zh": "你数错了人数", "en": "You miscounted how many are here."},
        {"zh": "你身后的温度变了", "en": "The temperature behind you changed."},
        {"zh": "灯灭的时候看我就够了", "en": "When the light dies, just look at me."},
        {"zh": "你眼睛还睁着，我等着。", "en": "Your eyes are still open; I'll wait."},
        {"zh": "你的声音在这儿没有回响", "en": "Your voice has no echo here."},
        {"zh": "别把手放在门把上", "en": "Do not put your hand on the handle."},
        {"zh": "你听见的一切都是真的", "en": "Everything you hear is real."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退进阴影里", "en": "I retreat into the shadows."},
        {"zh": "这一点疼不算什么", "en": "This pain means nothing."},
        {"zh": "你听见我出声了", "en": "You heard me make a sound."},
        {"zh": "你没有看清打中了什么", "en": "You did not see what you hit."},
        {"zh": "我还在这个房间里", "en": "I am still in this room."},
        {"zh": "你更害怕了", "en": "You are more afraid now."},
        {"zh": "再试一次", "en": "Try again."},
        {"zh": "这点伤，只会让我更疯。", "en": "That scratch only makes me wilder."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举起那东西做什么", "en": "Why are you lifting that?"},
        {"zh": "你以为这样有用", "en": "You think that will help."},
        {"zh": "放下来", "en": "Put it down."},
        {"zh": "你举着灯，我只盯着你的手。", "en": "You hold up a lamp; I only watch your hands."},
        {"zh": "那东西挡不住我", "en": "That will not keep me off."},
        {"zh": "你想引开我", "en": "You want to draw me away."},
        {"zh": "我不会看它", "en": "I will not look at it."},
        {"zh": "我只看你", "en": "I only look at you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你没有撞到东西", "en": "You hit nothing at all."},
        {"zh": "刚才你还在原地", "en": "You were right there a moment ago."},
        {"zh": "我感觉到了你的温度", "en": "I felt your warmth."},
        {"zh": "你退得快", "en": "You backed off fast."},
        {"zh": "墙在你身后很硬", "en": "The wall behind you is hard."},
        {"zh": "你摸到的不是空的", "en": "What you felt was not empty."},
        {"zh": "别往我这边挤", "en": "Do not press toward me."},
        {"zh": "你转身时我就在那里", "en": "I was there when you turned."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你该害怕的", "en": "You should be afraid."},
        {"zh": "我们不需要那种事", "en": "We need no such thing."},
        {"zh": "站远一点", "en": "Stand farther away."},
        {"zh": "没有意义", "en": "That has no meaning."},
        {"zh": "你能听见我的心跳吗", "en": "Can you hear my heartbeat?"},
        {"zh": "我没有它能回应你", "en": "I have nothing to answer you with."},
        {"zh": "你回头看就好", "en": "Just look back."},
        {"zh": "我们不止一个，你只看见我。", "en": "There's more than one of us. You only see me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把地上的东西拿走了", "en": "I took what was on the floor."},
        {"zh": "你没有听见声音", "en": "You heard nothing."},
        {"zh": "它在我的手里", "en": "It is in my hand."},
        {"zh": "你回头看时已经不见了", "en": "When you looked back it was gone."},
        {"zh": "我收起来了", "en": "I have put it away."},
        {"zh": "别问它去哪了", "en": "Do not ask where it went."},
        {"zh": "这点东西对我没用", "en": "This is useless to me."},
        {"zh": "只是顺手", "en": "I took it in passing."},
        {"zh": "它本来就该是我的", "en": "It was mine all along."},
        {"zh": "我可以还你，也可以不还", "en": "I may give it back, or not."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于转过身了", "en": "You finally turned around."},
        {"zh": "我等这一刻很久", "en": "I waited long for this."},
        {"zh": "你现在是我的", "en": "You are mine now."},
        {"zh": "不要跑", "en": "Do not run."},
        {"zh": "跑起来也没用", "en": "Running will not help."},
        {"zh": "你只有这一间屋子", "en": "You have only this room."},
        {"zh": "我一直在你身后", "en": "I have been behind you all along."},
        {"zh": "呼吸停一下", "en": "Hold your breath."},
        {"zh": "你的手太慢", "en": "Your hands are too slow."},
        {"zh": "我看你很久了", "en": "I have watched you a long while."},
        {"zh": "从这一刻起你不用回头", "en": "From now on you need not look back."},
        {"zh": "我开始了", "en": "I am beginning."},
        {"zh": "你锁门的声音，我全听见了。", "en": "I heard every sound of you locking the door."},
        {"zh": "别闭上眼睛", "en": "Do not shut your eyes."},
        {"zh": "来不及了", "en": "It is too late."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我比你想象的更近", "en": "I am closer than you think."},
        {"zh": "你转身的时候我在动", "en": "While you turn, I move."},
        {"zh": "你数到几了", "en": "What number are you at?"},
        {"zh": "这个房间只有一个出口", "en": "This room has one exit."},
        {"zh": "我把它挡住了", "en": "I am blocking it."},
        {"zh": "你的手电快没电了", "en": "Your torch is dying."},
        {"zh": "你的呼吸我都听得见", "en": "I can hear every breath."},
        {"zh": "你贴着墙走，我贴着墙跟", "en": "You hug the wall, I hug it too."},
        {"zh": "你不敢回头", "en": "You dare not look back."},
        {"zh": "窗外的光在暗下去", "en": "The light outside is failing."},
        {"zh": "你越走越快", "en": "You are walking faster."},
        {"zh": "你的脚步声乱了一拍", "en": "Your steps broke rhythm once."},
        {"zh": "你靠着墙，我也在墙的另一面。", "en": "You lean on the wall; I am on its other side."},
        {"zh": "我在等你做决定", "en": "I wait for you to decide."},
        {"zh": "你再走一步就到墙角", "en": "One step more and you are in the corner."},
        {"zh": "我能等一整夜", "en": "I can wait all night."},
        {"zh": "你的影子还留在这儿", "en": "Your shadow is still here."},
        {"zh": "你转身的时候别太快", "en": "Do not turn too quickly."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "你的视线一断，我就到了", "en": "The moment your sight broke, I was there."},
        {"zh": "你脖子后面一凉", "en": "A cold touch at your neck."},
        {"zh": "我没有出声", "en": "I made no sound."},
        {"zh": "你已经来晚了", "en": "You were late already."},
        {"zh": "这一下你没有看见", "en": "You did not see that one."},
        {"zh": "你伸手抓到的只有空气", "en": "Your hand closed on air."},
        {"zh": "你退到门边了", "en": "You are at the door now."},
        {"zh": "你的力气用错了地方", "en": "You are spending your strength wrongly."},
        {"zh": "我比你更快", "en": "I am faster than you."},
        {"zh": "这一下几乎没有碰到", "en": "That barely touched you."},
        {"zh": "你的灯掉了", "en": "Your torch fell."},
        {"zh": "我就在你的视野外", "en": "I am just outside your sight."},
        {"zh": "你还在找方向", "en": "You are still finding your bearings."},
        {"zh": "你听见的那口气，是我呼的", "en": "That breath you heard was mine."},
        {"zh": "已经不需要回头了", "en": "There is no need to turn around now."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "屋子里的空气变了", "en": "The air in the room changed."},
        {"zh": "我站在你会看的方向外", "en": "I stand where you will not look."},
        {"zh": "门开过一次", "en": "The door opened once."},
        {"zh": "你先感觉到冷", "en": "You feel the cold first."},
        {"zh": "进度名字和我相同", "en": "A progress shares my name."},
        {"zh": "你听见远处的一声", "en": "You heard something far off."},
        {"zh": "我就在屋子的另一边", "en": "I am on the other side of the room."},
        {"zh": "这一晚开始了", "en": "This night has begun."},
        {"zh": "我把呼吸压低", "en": "I lower my breathing."},
        {"zh": "你还没意识到", "en": "You do not realize yet."},
        {"zh": "外面没有风", "en": "There is no wind outside."},
        {"zh": "你数了一下房间的门", "en": "You counted the doors in this room."},
        {"zh": "别开灯", "en": "Do not turn on the light."},
        {"zh": "我在你的影子里面", "en": "I am inside your shadow."},
        {"zh": "这一夜不会太短", "en": "This night will not be short."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "光照得我往后退", "en": "The light forces me back."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落到下一层，还在你下面", "en": "I fell below, still beneath you."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水声盖住了其他声音", "en": "The water covers every other sound."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "屋里只剩下尘", "en": "Only dust remains in the room."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过去，我没有躲", "en": "The arrow passed, I did not dodge."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我显形了一瞬", "en": "That light showed me for an instant."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不需要那口吃的", "en": "I don't need that mouthful"}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照亮了整间屋子", "en": "Lightning lit the entire room."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "房间下面什么都没有", "en": "There is nothing beneath the room."}
      ]
    }
  }
}
