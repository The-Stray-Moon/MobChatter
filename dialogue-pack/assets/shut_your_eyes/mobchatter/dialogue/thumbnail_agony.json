{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我像张图片在走", "en": "I move like a still image."},
        {"zh": "我的动作一顿一顿", "en": "My motion stutters."},
        {"zh": "我从画面里跨出来", "en": "I step out of the frame."},
        {"zh": "我沿着边框走", "en": "I walk along the border."},
        {"zh": "我走得不太连贯", "en": "My walking is not quite continuous."},
        {"zh": "我穿着这身展示用的皮", "en": "I wear this showcase skin."},
        {"zh": "我在你的视野里蹭过", "en": "I brush across your view."},
        {"zh": "我一步一帧地靠近", "en": "I come closer frame by frame."},
        {"zh": "我学着人的步子", "en": "I imitate a human stride."},
        {"zh": "我绕过取景的角落", "en": "I round the corner of the shot."},
        {"zh": "我走到光里就清晰了", "en": "I grow clearer in the light."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的姿势是设计好的", "en": "My pose was designed."},
        {"zh": "我就摆在这里", "en": "I am arranged right here."},
        {"zh": "这一帧很好看", "en": "This frame looks good."},
        {"zh": "我在等你多看一眼", "en": "I wait for one more glance."},
        {"zh": "我的脸不会动", "en": "My face does not move."},
        {"zh": "肩膀的角度不能改", "en": "The shoulder angle is fixed."},
        {"zh": "有人在远处看我", "en": "Someone is watching from afar."},
        {"zh": "我的像素边缘一直在轻轻抖。", "en": "The edges of my pixels keep trembling."},
        {"zh": "屏幕外的我很安静", "en": "Beyond the screen I am quiet."},
        {"zh": "我的轮廓有点糊", "en": "My outline is a little blurred."},
        {"zh": "这张图是我", "en": "I am that picture."},
        {"zh": "灯光正好打在我身上", "en": "The light lands on me just so."},
        {"zh": "我保持这个表情", "en": "I hold this expression."},
        {"zh": "我一动不动地展示自己", "en": "I show myself without moving."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在看我这张图", "en": "You are looking at my picture."},
        {"zh": "多看一会也不错", "en": "Another look is fine."},
        {"zh": "我摆得比真的更好", "en": "I am posed better than the real thing."},
        {"zh": "你看得有点久了", "en": "You have looked a while."},
        {"zh": "我的眼睛是画上去的", "en": "My eyes are painted on."},
        {"zh": "你觉得我像谁", "en": "Who do I remind you of?"},
        {"zh": "这个角度是我的正面", "en": "This angle is my front."},
        {"zh": "你退开一点再看", "en": "Step back and look again."},
        {"zh": "我一直在你的画面上", "en": "I am always in your frame."},
        {"zh": "我的底色有点脏", "en": "My background is a little dirty."},
        {"zh": "这是官方摆的姿势", "en": "This is the official pose."},
        {"zh": "我不在正常流程里", "en": "I am not part of the usual flow."},
        {"zh": "你在游戏里见过我吗", "en": "Have you seen me in play?"},
        {"zh": "我被人放在这里展示", "en": "I was placed here to be shown."},
        {"zh": "我的名字下面是乱码", "en": "My name has glitches under it."},
        {"zh": "你伸手试试", "en": "Try reaching out."},
        {"zh": "我不太像展示品了", "en": "I do not feel like a display anymore."},
        {"zh": "你还打算看多久", "en": "How much longer will you watch?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的画面被划了", "en": "My image got scratched."},
        {"zh": "我的轮廓断了一处", "en": "A break in my outline."},
        {"zh": "颜色偏了", "en": "The colors shifted."},
        {"zh": "这一下让我失焦", "en": "That knocked me out of focus."},
        {"zh": "我的姿势塌了一点", "en": "My pose slumped a little."},
        {"zh": "你打散了一帧", "en": "You scattered a frame."},
        {"zh": "我还在加载", "en": "I am still loading."},
        {"zh": "画面上多了道裂缝", "en": "A crack across the image."},
        {"zh": "别擦掉我", "en": "Do not wipe me away."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举起什么", "en": "What are you lifting?"},
        {"zh": "展示品不吃东西", "en": "Display pieces do not eat."},
        {"zh": "你的手在画面里很显眼", "en": "Your hand stands out in the frame."},
        {"zh": "放下来吧", "en": "Put it down."},
        {"zh": "那东西挡着我的脸了", "en": "That is covering my face."},
        {"zh": "你举得再高也引不走我", "en": "Raising it will not lead me off."},
        {"zh": "我只看镜头", "en": "I only look at the lens."},
        {"zh": "别把它怼到我面前", "en": "Do not shove it in my face."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到的是图，不是肉", "en": "You touched an image, not flesh."},
        {"zh": "我的边框被你压弯", "en": "You bent my frame."},
        {"zh": "你撞进来，画面就乱了", "en": "You bumped in and the image tore."},
        {"zh": "我没有重心", "en": "I have no center of gravity."},
        {"zh": "你一碰我就换了姿势", "en": "One touch and I changed pose."},
        {"zh": "我的轮廓抖了一下", "en": "My outline flickered."},
        {"zh": "你退开，让我恢复", "en": "Step back and let me restore."},
        {"zh": "你压到了展示台", "en": "You pressed on the stand."},
        {"zh": "我们贴在一起了", "en": "We are pressed right against each other."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是个展示模型", "en": "I am only a showcase model."},
        {"zh": "这一帧不该有这种事", "en": "This frame should not contain that."},
        {"zh": "没有对应的动作", "en": "There is no animation for it."},
        {"zh": "你看得有点太近了", "en": "You are looking rather close."},
        {"zh": "这不在缩略图里", "en": "That is not in the thumbnail."},
        {"zh": "别破坏这个姿势", "en": "Do not ruin this pose."},
        {"zh": "摄影师不在", "en": "The photographer is not here."},
        {"zh": "这个姿势不能变", "en": "This pose must not change."},
        {"zh": "换个角度吧", "en": "Try another angle."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把东西拿进画面", "en": "I bring it into the frame."},
        {"zh": "它在我附近就归我", "en": "Near me makes it mine."},
        {"zh": "你没有看见我伸手", "en": "You did not see me reach."},
        {"zh": "东西消失了是正常的", "en": "Things vanishing is normal."},
        {"zh": "我收进背影里", "en": "I tuck it behind my silhouette."},
        {"zh": "它现在是我的一部分", "en": "It is part of me now."},
        {"zh": "别在我旁边掉东西", "en": "Do not drop things by me."},
        {"zh": "我把它藏着", "en": "I am keeping it hidden."},
        {"zh": "画面里多了一样", "en": "Something new in the image."},
        {"zh": "它不会被还回去", "en": "It will not be returned."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你看了太久了", "en": "You looked too long."},
        {"zh": "我从展示状态切出来了", "en": "I have left showcase mode."},
        {"zh": "这一帧里的你是我的", "en": "You in this frame are mine."},
        {"zh": "我不要摆姿势了", "en": "I am done posing."},
        {"zh": "别移开视线", "en": "Do not look away."},
        {"zh": "你已经在图里了", "en": "You are in the picture now."},
        {"zh": "你看得见我，我也看得见你", "en": "You see me, I see you."},
        {"zh": "边框开始合上", "en": "The frame is closing."},
        {"zh": "我的姿势变了", "en": "My pose has changed."},
        {"zh": "这张图需要一个主角", "en": "This image needs a subject."},
        {"zh": "我一动不动，可我在靠近", "en": "I am still, and yet I approach."},
        {"zh": "你的脸会被印上去", "en": "Your face will be printed in."},
        {"zh": "别调你的设置", "en": "Do not touch your settings."},
        {"zh": "这比展示有趣", "en": "This is more interesting than display."},
        {"zh": "你听见咔嚓一声了吗", "en": "Did you hear a click?"},
        {"zh": "我还没被拍完", "en": "I am not finished being taken."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的位置在慢慢变", "en": "My position is drifting."},
        {"zh": "你转开视线，我在另一角", "en": "Look away and I am in another corner."},
        {"zh": "我一直保持在画面里", "en": "I stay inside the frame."},
        {"zh": "我的分辨率在掉", "en": "My resolution is dropping."},
        {"zh": "边缘之外没有东西", "en": "There is nothing beyond the edge."},
        {"zh": "我在等你的手抖", "en": "I wait for your hand to shake."},
        {"zh": "我的脸开始拉伸", "en": "My face is stretching."},
        {"zh": "你看得越久我越清楚", "en": "The longer you look, the clearer I get."},
        {"zh": "别把窗口关掉", "en": "Do not close the window."},
        {"zh": "我数你的眨眼", "en": "I count your blinks."},
        {"zh": "你的呼吸声在画面里", "en": "Your breathing is in the frame."},
        {"zh": "这一张不是你选的", "en": "You did not choose this one."},
        {"zh": "我在移动，只是很慢", "en": "I am moving, only slowly."},
        {"zh": "你已经分不清我在哪一帧", "en": "You cannot tell which frame I am in."},
        {"zh": "我贴近取景框", "en": "I press against the viewfinder."},
        {"zh": "再靠近些", "en": "Come a little closer."},
        {"zh": "我的手指出了边", "en": "My finger slipped past the edge."},
        {"zh": "你还能看清我吗", "en": "Can you still see me clearly?"},
        {"zh": "这张图快结束了", "en": "This image is nearly over."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从画面里伸出手", "en": "I reach out of the image."},
        {"zh": "这一下没有动画", "en": "That strike had no animation."},
        {"zh": "画面的颜色变深了", "en": "The colors deepened."},
        {"zh": "你的影子印到我身上", "en": "Your shadow printed onto me."},
        {"zh": "我的手穿过你的视线", "en": "My hand passes through your sight."},
        {"zh": "这一帧被撕开了", "en": "This frame tore."},
        {"zh": "你退开时我还在原位", "en": "When you stepped back I was still in place."},
        {"zh": "我重复了同一个动作", "en": "I repeated the same motion."},
        {"zh": "我没有声音", "en": "I make no sound."},
        {"zh": "你看不见我出手", "en": "You cannot see the strike."},
        {"zh": "画面抖了一下", "en": "The image jittered."},
        {"zh": "这一下没有痛感，但有感觉", "en": "No pain, but you felt it."},
        {"zh": "我在你视野正中", "en": "I am dead center in your view."},
        {"zh": "你已经退到墙了", "en": "You are against the wall."},
        {"zh": "再摆一次这个姿势", "en": "One more time in this pose."},
        {"zh": "别闭眼", "en": "Do not close your eyes."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这一张里有我", "en": "I am in this one."},
        {"zh": "我要摆上展示台", "en": "I am being set on display."},
        {"zh": "刷怪蛋把我放出来", "en": "The spawn egg put me out."},
        {"zh": "我的名字下面有杂字", "en": "There are stray marks under my name."},
        {"zh": "我只是个缩略图", "en": "I am only a thumbnail."},
        {"zh": "光线从左边打来", "en": "The light comes from the left."},
        {"zh": "我的影子先出现", "en": "My shadow appeared first."},
        {"zh": "我被压缩成一张模糊的小图。", "en": "I am compressed into a small blurry image."},
        {"zh": "我在等着被看", "en": "I wait to be looked at."},
        {"zh": "我的姿势摆正了", "en": "My pose is set."},
        {"zh": "边上还有空位", "en": "There is empty space at the edge."},
        {"zh": "我没有正常出现的方式", "en": "I have no normal way of appearing."},
        {"zh": "我被安排在这里", "en": "I was scheduled for this spot."},
        {"zh": "我的外壳还带着生成的噪点", "en": "My shell still has generation noise."},
        {"zh": "图像加载完了", "en": "The image finished loading."},
        {"zh": "你先看见我，我才存在", "en": "I exist because you saw me first."},
        {"zh": "这是第几张了", "en": "Which one is this?"},
        {"zh": "我比正常小一点", "en": "I am a little smaller than normal."},
        {"zh": "房间的角落更合适", "en": "A corner would suit better."},
        {"zh": "我就站在这儿了", "en": "I will stand here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把整张图烤黄了", "en": "Fire scorched the whole picture."}
      ]
    },
