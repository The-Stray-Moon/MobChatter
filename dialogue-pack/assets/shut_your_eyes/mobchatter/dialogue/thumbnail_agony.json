        {"zh": "画面被打成了碎片", "en": "The image was blown to pieces."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有一个洞穿过了我", "en": "A hole passed through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "有人调了我的参数", "en": "Someone adjusted my parameters."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "图不需要吃东西", "en": "A picture needs no food."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "一道白光把整帧照花了", "en": "A white flash blew out the frame."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "画面什么都没有了", "en": "The image is empty now."}
      ]
    }
  }
