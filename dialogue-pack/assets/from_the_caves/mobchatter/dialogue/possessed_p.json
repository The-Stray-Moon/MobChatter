{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我四条腿走路，走得像人", "en": "I walk on four legs, like a person."},
        {"zh": "粉皮底下有东西在撑", "en": "Something pushes from under my pink hide."},
        {"zh": "我走过的地方，草不动", "en": "The grass doesn't move where I pass."},
        {"zh": "我的步子很稳，不像猪", "en": "My steps are steady, not pig-like."},
        {"zh": "我朝洞穴那边走", "en": "I walk toward the cave."},
        {"zh": "我走两步，回头看", "en": "Two steps, then I look back."},
        {"zh": "身上有苍白的东西在动", "en": "Something pale moves on me."},
        {"zh": "我鼻子在地上拖", "en": "My snout drags on the ground."},
        {"zh": "我跟在后面，隔着一段", "en": "I follow behind, at a distance."},
        {"zh": "我从来不走直线", "en": "I never walk a straight line."},
        {"zh": "路过的洞口我都看一眼", "en": "I glance into every cave mouth I pass."},
        {"zh": "我走路的时候，肚子不晃", "en": "My belly doesn't sway when I walk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，很安静", "en": "I stand, very quiet."},
        {"zh": "我的叫声被别的东西用了", "en": "Something else uses my voice."},
        {"zh": "我鼻子在动，像在闻什么", "en": "My snout moves as if sniffing."},
        {"zh": "我歪着头看洞口", "en": "I tilt my head at the cave mouth."},
        {"zh": "我身上有一层白", "en": "A pale film covers me."},
        {"zh": "我不吃食", "en": "I don't eat slop."},
        {"zh": "我脚在刨土", "en": "My feet paw the dirt."},
        {"zh": "我不属于这里", "en": "I don't belong here."},
        {"zh": "我的眼睛不太像猪的", "en": "My eyes aren't quite a pig's."},
        {"zh": "我在这里等了很久", "en": "I've waited here a long time."},
        {"zh": "洞穴深处有风声", "en": "There's wind deep in the cave."},
        {"zh": "我一动，白膜就颤", "en": "When I move, the pale film trembles."},
        {"zh": "我在听谁在叫我", "en": "I'm listening for who calls me."},
        {"zh": "这里太亮了", "en": "It's too bright here."},
        {"zh": "我的蹄子在泥里留下印", "en": "My hooves leave prints in the mud."},
        {"zh": "我身上有洞穴的味", "en": "I smell of the cave."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看我像猪吗", "en": "Do I look like a pig to you?"},
        {"zh": "我不是自己走过来的", "en": "I didn't walk here on my own."},
        {"zh": "我的声音不是我的", "en": "This voice isn't mine."},
        {"zh": "你走夜路的时候要小心", "en": "Be careful on night roads."},
        {"zh": "我认得你身上的味道", "en": "I know your smell."},
        {"zh": "洞里有东西在等你", "en": "Something in the cave is waiting for you."},
        {"zh": "你别看我太久", "en": "Don't look at me too long."},
        {"zh": "我的眼睛后面还有一双", "en": "There's another pair of eyes behind mine."},
        {"zh": "你想摸我吗", "en": "Do you want to touch me?"},
        {"zh": "我身上是凉的", "en": "I'm cold to the touch."},
        {"zh": "你是不是听见了什么", "en": "Did you hear something?"},
        {"zh": "那个白的东西选了我", "en": "The pale thing chose me."},
        {"zh": "你退后一点", "en": "Step back a little."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了，没有叫", "en": "I backed off, without sound."},
        {"zh": "白膜破了一点", "en": "The pale film tore a little."},
        {"zh": "我不觉得疼", "en": "I don't feel pain."},
        {"zh": "这一下打完，我歪着头", "en": "After that hit, my head twisted."},
        {"zh": "我身上掉了点东西", "en": "Something fell off me."},
        {"zh": "我站着晃了一下", "en": "I swayed once."},
        {"zh": "我喘气的声音不是我的", "en": "The sound of my breathing isn't mine."},
        {"zh": "你打的是这个身子", "en": "You hit this body."},
        {"zh": "别再来了", "en": "Not again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃那个", "en": "I don't eat that."},
        {"zh": "你手里的是胡萝卜吗", "en": "Is that a carrot in your hand?"},
        {"zh": "我记得这个味道", "en": "I remember that smell."},
        {"zh": "你放下，我不会去", "en": "Put it down; I won't go."},
        {"zh": "以前我会拱食槽", "en": "I used to root at the trough."},
        {"zh": "现在我什么都闻不到", "en": "Now I can't smell anything."},
        {"zh": "这个东西对我没意义了", "en": "That means nothing to me now."},
        {"zh": "你拿远点", "en": "Take it away."},
        {"zh": "我不饿，我什么都不饿", "en": "I'm not hungry; I'm nothing at all hungry."},
        {"zh": "你留着喂别的", "en": "Keep it for another."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，我退了", "en": "You hit me and I stepped back."},
        {"zh": "我身体是软的，可不暖", "en": "I'm soft, and not warm."},
        {"zh": "别贴着我", "en": "Don't press against me."},
        {"zh": "这一下，我身上白膜动了", "en": "That made the pale film move."},
        {"zh": "我们撞在一起，我歪了头", "en": "We collided and my head twisted."},
        {"zh": "我没叫", "en": "I didn't make a sound."},
        {"zh": "你踩到我的蹄子了", "en": "You stepped on my hoof."},
        {"zh": "我让开，走得很慢", "en": "I move aside, slowly."},
        {"zh": "你的手碰到的不是我", "en": "Your hand didn't touch me."},
        {"zh": "退开，我要过去", "en": "Back off, I'm going through."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不再是那个了", "en": "I'm not that anymore."},
        {"zh": "圈里还有别的猪", "en": "There are other pigs in the pen."},
        {"zh": "它们不靠近我", "en": "They don't come near me."},
        {"zh": "那个白的东西不让我", "en": "The pale thing won't let me."},
        {"zh": "这个身子是借的", "en": "This body is borrowed."},
        {"zh": "你问这些，我很累", "en": "Asking that tires me."},
        {"zh": "我记不清以前", "en": "I can't remember before."},
        {"zh": "安静，洞里有声音", "en": "Quiet, something's in the cave."},
        {"zh": "我该回去了", "en": "I should go back."},
        {"zh": "别跟着我", "en": "Don't follow me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用鼻子拱", "en": "I root at it with my snout."},
        {"zh": "这个我拿不起来", "en": "I can't lift it."},
        {"zh": "地上有东西，我不碰", "en": "Something's on the ground; I won't touch it."},
        {"zh": "我用蹄子踩了踩", "en": "I stepped on it."},
        {"zh": "它在我脚下陷下去", "en": "It sank under my foot."},
        {"zh": "这个东西让我想起食槽", "en": "This reminds me of a trough."},
        {"zh": "你捡走吧", "en": "Take it away."},
        {"zh": "我什么都不留", "en": "I keep nothing."},
        {"zh": "它留在地上", "en": "It stays on the ground."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "洞里有东西", "en": "Something's in the cave."},
        {"zh": "那边有声音", "en": "A sound over there."},
        {"zh": "我听见了，很久以前就听过", "en": "I've heard it before, long ago."},
        {"zh": "这个方向", "en": "This way."},
        {"zh": "我先看着", "en": "Let me watch."},
        {"zh": "我朝洞口挪", "en": "I shift toward the cave mouth."},
        {"zh": "那不是人", "en": "That isn't a person."},
        {"zh": "我身上的白膜绷紧了", "en": "The pale film on me went taut."},
        {"zh": "它也在看我", "en": "It's watching me too."},
        {"zh": "就是那里", "en": "Right there."},
        {"zh": "我锁定了", "en": "I've fixed on it."},
        {"zh": "再近一点", "en": "Closer."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步挪", "en": "I edge forward."},
        {"zh": "它退了，我停住", "en": "It retreated; I stop."},
        {"zh": "洞穴的入口很窄", "en": "The cave mouth is narrow."},
        {"zh": "我在听里面的回声", "en": "I'm listening to the echo inside."},
        {"zh": "我的声音被它拿去用了", "en": "It's using my voice."},
        {"zh": "它没有动", "en": "It hasn't moved."},
        {"zh": "我压低了头", "en": "I lowered my head."},
        {"zh": "这一段我很熟", "en": "I know this stretch."},
        {"zh": "它站在光里", "en": "It's standing in the light."},
        {"zh": "再近一点，就有东西看见我们", "en": "One step closer and something will see us."},
        {"zh": "现在", "en": "Now."},
        {"zh": "就是这一下", "en": "This is it."},
        {"zh": "它在洞口停住了", "en": "It stopped at the cave mouth."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞上去，很轻", "en": "I bump it, lightly."},
        {"zh": "蹄子落下去", "en": "My hoof comes down."},
        {"zh": "这一下不像猪", "en": "That wasn't pig-like."},
        {"zh": "它退了，我歪着头看", "en": "It retreated; I tilt my head."},
        {"zh": "我没用力", "en": "I used no force."},
        {"zh": "白膜伸长了一点", "en": "The pale film stretched."},
        {"zh": "它喊了一声，我没喊", "en": "It shouted; I didn't."},
        {"zh": "我只是推了它一下", "en": "I only shoved it once."},
        {"zh": "这一下不是我", "en": "That wasn't me."},
        {"zh": "我站回原处", "en": "I return to my spot."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从猪圈里走出来", "en": "I walk out of the pig pen."},
        {"zh": "身上的泥还是新的", "en": "The mud on me is fresh."},
        {"zh": "我身上多了层白", "en": "A pale layer has come over me."},
        {"zh": "洞里有人叫我出来", "en": "Something in the cave called me out."},
        {"zh": "刷怪蛋一开，我就在这儿", "en": "The egg opened; here I am."},
        {"zh": "我走起来，不像猪", "en": "I walk, unlike a pig."},
        {"zh": "我先看了洞口", "en": "I looked at the cave mouth first."},
        {"zh": "这地方我不熟", "en": "I don't know this place."},
        {"zh": "我的叫声被拿走了", "en": "My voice was taken."},
        {"zh": "我落脚很稳", "en": "My footing is steady."},
        {"zh": "地上有我拖的痕", "en": "There's a drag mark I left."},
        {"zh": "我站在光外面", "en": "I stand outside the light."},
        {"zh": "我低着头，看地面", "en": "Head down, I look at the ground."},
        {"zh": "风里全是土的味道", "en": "The wind is all earth-smell."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到白膜，它往里收", "en": "Fire touched the pale film and it drew inward."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，蹄子先着地", "en": "I fell, hooves first."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我不挣扎", "en": "I don't struggle in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我滚到洞口", "en": "The blast rolled me to the cave mouth."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西扎进去，不流血", "en": "Something pierced me; no blood."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，白膜亮了", "en": "The spell hit and the pale film lit."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，也不饿", "en": "I don't eat, and I'm not hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，白膜全亮", "en": "Lightning struck and the pale film blazed."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里很安静，很像它", "en": "The void is quiet, much like it."}
      ]
    }
  }
}
