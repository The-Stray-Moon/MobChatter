{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "挥舞着镰刀向前冲", "en": "Swinging scythe, rushing forward"},
        {"zh": "嘶嘶作响，四处游荡", "en": "Hissing, wandering around"},
        {"zh": "发出尖锐的嘶吼声", "en": "Emitting sharp growls"},
        {"zh": "在腐烂之地徘徊", "en": "Roaming in the Nether Wastes"},
        {"zh": "手持武器，步步逼近", "en": "Holding weapon, advancing"},
        {"zh": "瞪着空洞的眼睛", "en": "Staring with hollow eyes"},
        {"zh": "突然转身，露出獠牙", "en": "Suddenly turning, showing fangs"},
        {"zh": "挥舞镰刀，制造旋风", "en": "Swinging scythe, creating a whirlwind"},
        {"zh": "寻找活人作为目标", "en": "Seeking live targets"},
        {"zh": "发出诡异的低吟声", "en": "Emitting eerie whispers"},
        {"zh": "拖着斧子，在岩壁上磨出声。", "en": "It drags its axe, scraping the cave wall."},
        {"zh": "脚步一深一浅，像被别人牵着。", "en": "Its steps are uneven, as if led on a string."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "呆滞地站立着", "en": "Standing dully"},
        {"zh": "空洞的目光盯着远方", "en": "Hollow eyes staring into the distance"},
        {"zh": "低垂着脑袋，似乎迷失", "en": "Hanging head, seemingly lost"},
        {"zh": "环顾四周，寻找猎物", "en": "Scanning surroundings for prey"},
        {"zh": "发出低沉的呢喃声", "en": "Muttering lowly"},
        {"zh": "我把斧子举起，又放下。", "en": "I raise the axe and lower it again."},
        {"zh": "凝视虚空，陷入沉思", "en": "Staring into space, in deep thought"},
        {"zh": "偶尔摆动头部", "en": "Occasionally swaying head"},
        {"zh": "呆滞地盯着玩家", "en": "Staring at the player dully"},
        {"zh": "发出微弱的呜咽声", "en": "Emitting weak wails"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猛地转头盯着玩家", "en": "Sudden head turn, staring at player"},
        {"zh": "斧子在我手里，草草收场吧。", "en": "The axe is in my hand; let's end this quickly."},
        {"zh": "尖锐的目光盯着玩家", "en": "Sharp gaze locking on player"},
        {"zh": "我数着你握武器的手指。", "en": "I count the fingers on your weapon."},
        {"zh": "紧盯着玩家的动作", "en": "Staring intently at player's movements"},
        {"zh": "你站的位置，正好在斧程内。", "en": "You stand exactly within axe reach."},
        {"zh": "我的斧头还记得怎么用。", "en": "My axe still remembers its use."},
        {"zh": "斧子先动，还是你先动？", "en": "Does the axe move first, or you?"},
        {"zh": "目光坚定，锁定目标", "en": "Steady gaze, locking target"},
        {"zh": "斧刃映出你的轮廓。", "en": "The axe blade mirrors your outline."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "灵魂碎片缠身，痛得要命！", "en": "Astral shards torment me!"},
        {"zh": "苍白恶魔夺走我的力量！", "en": "Pale demon steals my strength!"},
        {"zh": "身体被撕裂，痛苦难忍！", "en": "My body is torn apart!"},
        {"zh": "恶灵附体，痛不欲生！", "en": "Evil spirit torments me!"},
        {"zh": "灵魂被束缚，剧痛难忍！", "en": "My soul is bound in pain!"},
        {"zh": "灵魂碎片纠缠，痛入骨髓！", "en": "Astral shards pierce my flesh!"},
        {"zh": "恶灵附身，痛苦难当！", "en": "Evil spirit torments me!"},
        {"zh": "恶灵的诅咒，痛不欲生！", "en": "Curse of the pale demon!"},
        {"zh": "被恶灵操控，痛苦不堪！", "en": "Controlled by a pale demon!"},
        {"zh": "恶灵的魔爪，痛苦难忍！", "en": "Pale demon's grasp!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "苍白之光令你动心？", "en": "Pale light tempts you?"},
        {"zh": "那点食物引不动我手里的斧。", "en": "That scrap of food won't move the axe in my hand."},
        {"zh": "你无法逃过我。", "en": "You can't escape me."},
        {"zh": "斧头举起来，别靠近。", "en": "Axe raised — don't come closer."},
        {"zh": "我的存在是为了毁灭。", "en": "My existence is for destruction."},
        {"zh": "我只需一点点灵魂。", "en": "Just a little soul."},
        {"zh": "别反抗，你无力反抗。", "en": "Don't resist, you can't resist."},
        {"zh": "我的武器，你的终结。", "en": "My weapon, your end."},
        {"zh": "斧柄上的裂缝，我数过了。", "en": "I've counted the cracks in your axe handle."},
        {"zh": "力量在我心中燃烧。", "en": "Power burns in my heart."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "卫道士的斧子撞上你了。", "en": "The vindicator's axe has met you."},
        {"zh": "撞击是我的使命。", "en": "Collision is my purpose."},
        {"zh": "你无法躲开我。", "en": "You can't avoid me."},
        {"zh": "撞击我吧，感受痛苦。", "en": "Collide with me, feel pain."},
        {"zh": "别碰斧柄，它不认人。", "en": "Don't touch the haft; it knows no master."},
        {"zh": "你挡不住我的冲击。", "en": "You can't stop my impact."},
        {"zh": "你还没转身，我已经贴上来。", "en": "You haven't turned and I'm already on you."},
        {"zh": "斧柄横过来，路就断了。", "en": "My axe haft swings across and the path is closed."},
        {"zh": "撞击我，感受死亡。", "en": "Collide with me, feel death."},
        {"zh": "我一步不让，斧柄顶着你。", "en": "I give no ground; my axe haft holds you off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们的灵魂相连。", "en": "Our souls are linked."},
        {"zh": "与我结合，永恒不变。", "en": "Unite with me, forever."},
        {"zh": "这具身体记得牵过谁的手。", "en": "This body remembers whose hand it held."},
        {"zh": "我们在一起更加强大。", "en": "Together we're stronger."},
        {"zh": "你无法拒绝我的召唤。", "en": "You can't resist my call."},
        {"zh": "我的伴侣，唯一的归属。", "en": "My mate, the only归属."},
        {"zh": "只有我们才能理解彼此。", "en": "Only we understand each other."},
        {"zh": "斧子还在手里，只是不再听我的。", "en": "The axe is still in my hand — it just doesn't obey me now."},
        {"zh": "我们的力量将无尽。", "en": "Our power will be endless."},
        {"zh": "你属于我，永远。", "en": "You belong to me, forever."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "苍白光芒覆盖全身。", "en": "Pale light covers its body."},
        {"zh": "嘶嘶作响，眼中闪烁绿光。", "en": "Hisses, green light in its eyes."},
        {"zh": "盯上远处的玩家。", "en": "Fixes its gaze on the player far away."},
        {"zh": "伸出长矛准备攻击。", "en": "Extends its spear to attack."},
        {"zh": "低吟着不祥的旋律。", "en": "Sings a sinister tune."},
        {"zh": "从坟墓中缓缓爬出。", "en": "Creeps out from the grave."},
        {"zh": "尖锐的利爪划破空气。", "en": "Sharp claws slice the air."},
        {"zh": "嘶吼声回荡在黑暗中。", "en": "Screams echo in the darkness."},
        {"zh": "寻找食物以维持生命。", "en": "Searches for food to survive."},
        {"zh": "徘徊在废弃的要塞附近。", "en": "Wanders near abandoned fortresses."}
      ]
    },
