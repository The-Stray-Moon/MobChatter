  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，脚步沉重。", "en": "Sssss, heavy footsteps."},
        {"zh": "身体扭曲，朝前爬行。", "en": "Body twists, crawling forward."},
        {"zh": "发出低沉嘶吼，向前冲刺。", "en": "Low growl, charges forward."},
        {"zh": "眼球转动，寻找猎物。", "en": "Eyes roll, searching for prey."},
        {"zh": "挥舞着镰刀，快速移动。", "en": "Swinging scythe, moving fast."},
        {"zh": "发出阴森叫声，四处游荡。", "en": "Scary cry, wandering around."},
        {"zh": "张开翅膀，缓慢飞行。", "en": "Spreads wings, slow flight."},
        {"zh": "嘶嘶低语，似乎在呢喃。", "en": "Sssss, mumbling to itself."},
        {"zh": "突然加速，向玩家冲去。", "en": "Suddenly speeds up, charging at the player."},
        {"zh": "挥舞镰刀，试图攻击。", "en": "Swings scythe, trying to attack."},
        {"zh": "穿过石壁，留下苍白痕。", "en": "It passes through stone, leaving pale marks."},
        {"zh": "悬在洞穴顶上滑行。", "en": "It glides along the cave roof."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "目光呆滞，四处张望。", "en": "Staring blankly, looking around."},
        {"zh": "低头啃食腐烂物品。", "en": "Bends down to eat decayed items."},
        {"zh": "呆立不动，似乎在思考。", "en": "Stands still, seemingly thinking."},
        {"zh": "啃咬空气，发出嘶嘶声。", "en": "Bites air, making sssss sounds."},
        {"zh": "缓慢转头，寻找同伴。", "en": "Slowly turns head, looking for others."},
        {"zh": "低头沉思，似乎在回忆。", "en": "Low head, seemingly remembering."},
        {"zh": "附身的恼鬼，翅膀在洞里响。", "en": "A possessed vex's wings rattle in the cave."},
        {"zh": "低头咀嚼，享受腐烂食物。", "en": "Bends down, savoring decayed food."},
        {"zh": "呆滞地看着远处。", "en": "Staring blankly at distance."},
        {"zh": "低头啃咬，似乎在消化。", "en": "Bends down, digesting something."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "突然盯着玩家，怒目而视。", "en": "Suddenly stares at the player,怒目而视."},
        {"zh": "我把惨白的脸凑到你眼前。", "en": "I push my deathly pale face right up to yours."},
        {"zh": "眼睛发光，锁定玩家。", "en": "Eyes glow, locking on the player."},
        {"zh": "发出低吼，准备攻击。", "en": "Low growl, preparing to attack."},
        {"zh": "目光犀利，紧盯着玩家。", "en": "Sharp eyes, staring at the player."},
        {"zh": "我嘶了一声，那不是我的声音。", "en": "I hissed, and that was not my voice."},
        {"zh": "眼睛闪烁，锁定玩家。", "en": "Eyes flicker, locking on."},
