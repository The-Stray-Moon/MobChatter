    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从洞壁里挤出，带着白毛。", "en": "I squeeze from the cave wall, trailing white moss."},
        {"zh": "咕咕咕，来送死吧！", "en": "Gurgle, come to die!"},
        {"zh": "嘶嘶嘶，苍白之魂！", "en": "Sssss, Pale Spirit!"},
        {"zh": "咕咕咕，黑暗降临！", "en": "Gurgle, darkness comes!"},
        {"zh": "嘶嘶嘶，跟我一起堕落！", "en": "Sssss, join me in damnation!"},
        {"zh": "咕咕咕，这是你的新家！", "en": "Gurgle, this is your new home!"},
        {"zh": "嘶嘶嘶，阴影中的守卫！", "en": "Sssss, guardian of shadows!"},
        {"zh": "咕咕咕，小心我的诅咒！", "en": "Gurgle, beware my curse!"},
