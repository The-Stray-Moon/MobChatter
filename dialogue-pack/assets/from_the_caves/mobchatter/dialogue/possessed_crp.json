{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，缓慢前行", "en": "Sssss, moving slowly"},
        {"zh": "绿光闪烁，蠕动身体", "en": "Green glow flickers, wiggling body"},
        {"zh": "咕噜咕噜，发出低吼", "en": "Grunting, low growl"},
        {"zh": "瞪大眼睛，追逐玩家", "en": "Wide eyes, chasing player"},
        {"zh": "皮肤紧绷，紧张不安", "en": "Skin tight, nervous"},
        {"zh": "尾巴摆动，试图逃窜", "en": "Tail swaying, trying to flee"},
        {"zh": "嘶嘶嘶嘶，不断警告", "en": "Sssss, constant warning"},
        {"zh": "身体扭曲，准备爆炸", "en": "Body distorting, ready to explode"},
        {"zh": "发出尖啸，步步逼近", "en": "Screeching, advancing"},
        {"zh": "咕噜咕噜，口水滴落", "en": "Grunting, drooling"},
        {"zh": "苍白的光在皮下走。", "en": "Pale light moves under my skin."},
        {"zh": "关节点点作响地挪动。", "en": "My joints click as I shift."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "瘫倒在地，无精打采", "en": "Lying down, lazy"},
        {"zh": "目光呆滞，失去活力", "en": "Staring blankly, lifeless"},
        {"zh": "慢慢蠕动，行动缓慢", "en": "Slowly wiggling, moving slow"},
        {"zh": "呼吸沉重，疲惫不堪", "en": "Heavy breathing, exhausted"},
        {"zh": "身体僵硬，无法动弹", "en": "Stiff body, unable to move"},
        {"zh": "眼神空洞，毫无生气", "en": "Empty eyes, no life"},
        {"zh": "咕噜咕噜，声音低沉", "en": "Grunting, deep voice"},
        {"zh": "皮肤苍白，如同死尸", "en": "Pale skin, like a corpse"},
        {"zh": "目光凶狠，随时待命", "en": "Fierce eyes, ready to strike"},
        {"zh": "身体颤抖，即将爆发", "en": "Shaking body, about to explode"},
        {"zh": "它在我身体里翻了个身。", "en": "It turned over inside my body."},
        {"zh": "我听见地下的低语。", "en": "I hear whispering underground."},
        {"zh": "引线在皮下烧，影子才跟上。", "en": "The fuse burns under my skin; my shadow follows late."},
        {"zh": "这具身体不太听我使唤。", "en": "This body doesn't quite obey me."},
        {"zh": "我数着洞穴里的呼吸。", "en": "I count the breaths in this cave."},
        {"zh": "安静，它正在听。", "en": "Quiet; it is listening."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼眶里，苍白的光在烧。", "en": "Pale light burns inside my eye sockets."},
        {"zh": "引线在燃，可我不想炸了。", "en": "The fuse is lit, but I don't want to blow."},
        {"zh": "紧紧盯着，欲食之", "en": "Staring intently, hungry for flesh"},
        {"zh": "目光闪烁，寻找目标", "en": "Glimmering eyes, searching target"},
        {"zh": "瞪大眼睛，锁定玩家", "en": "Wide eyes, locking on player"},
        {"zh": "死死盯住，伺机而动", "en": "Staring, waiting to strike"},
        {"zh": "目光阴森，恐怖无比", "en": "Creepy eyes, terrifying"},
        {"zh": "盯紧玩家，不敢放松", "en": "Staring at player, not relaxing"},
        {"zh": "目光如刀，锋利无比", "en": "Eyes like knives, sharp"},
        {"zh": "注视玩家，准备吞噬", "en": "Looking at player, ready to devour"},
        {"zh": "附身之后，我看得更多。", "en": "Possessed, I see so much more."},
        {"zh": "你的影子也被谁盯着。", "en": "Something watches your shadow too."},
        {"zh": "我认得你身上的旧伤。", "en": "I recognize the old wounds on you."},
        {"zh": "洞里每个转角都有眼睛。", "en": "Every corner here has an eye."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "苍白光芒闪烁，痛苦呻吟。", "en": "Pale glow flickers, pained moan."},
        {"zh": "惨叫连连，痛苦难忍。", "en": "Pained cries, agony never ends."},
        {"zh": "哀号连连，痛苦中挣扎。", "en": "Screams of agony, struggling."},
        {"zh": "痛苦尖叫，苍白身躯颤抖。", "en": "Pained shriek, pale body trembles."},
        {"zh": "痛苦嘶吼，苍白之光黯淡。", "en": "Pained roar, pale light fades."},
        {"zh": "痛苦号叫，苍白光芒摇曳。", "en": "Pained howl, pale light wavers."},
        {"zh": "惨叫连连，痛苦无法忍受。", "en": "Pained cries, pain unbearable."},
        {"zh": "尖叫不断，痛苦煎熬。", "en": "Non-stop screams, agony."},
        {"zh": "痛苦尖叫，苍白身躯扭曲。", "en": "Pained screams, pale body twists."},
        {"zh": "哀号连连，痛苦难逃。", "en": "Screams of agony, escape impossible."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，你被它的光芒吸引。", "en": "Sizzles, drawing you in with its glow."},
        {"zh": "它的皮肤发出幽光，似乎在诱惑你。", "en": "Its skin glows, tempting you with mystery."},
        {"zh": "它靠近你，试图引诱你靠近。", "en": "It approaches, trying to draw you closer."},
        {"zh": "它的声音低沉，似乎在低语。", "en": "Its voice is a low, seductive whisper."},
        {"zh": "它发出轻微的颤动，仿佛在暗示什么。", "en": "It trembles subtly, hinting at something sinister."},
        {"zh": "它的触须轻轻触碰你，试图安抚你。", "en": "Its tentacles gently touch you, trying to calm you."},
        {"zh": "你手里的面包，引线都闻到了。", "en": "Even my fuse smells the bread in your hand."},
        {"zh": "它靠近你，似乎在等待时机。", "en": "It draws near, waiting for the perfect moment."},
        {"zh": "它发出轻柔的呢喃，让你感到不安。", "en": "It emits a soft, unsettling coo."},
        {"zh": "它轻轻触碰你的手，试图让你放松。", "en": "It gently touches your hand, trying to relax you"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "砰地一声，它爆炸了。", "en": "BOOM! It explodes."},
        {"zh": "它的身体破碎了，化为尘土。", "en": "Its body shatters into dust."},
        {"zh": "它猛然爆裂，碎片飞溅。", "en": "It explodes, sending fragments flying."},
        {"zh": "砰！它与你相撞。", "en": "CRASH! It collides with you."},
        {"zh": "你被它的爆炸波及，感到疼痛。", "en": "You're hit by its explosion, feeling pain."},
        {"zh": "它猛然一震，与你碰撞。", "en": "It jerks suddenly, colliding with you."},
        {"zh": "砰！你被它撞飞了。", "en": "CRASH! You're knocked away by it."},
        {"zh": "你被它的冲击波击退。", "en": "You're pushed back by its shockwave."},
        {"zh": "它猛烈一震，撞向你。", "en": "It shakes violently, colliding with you."},
        {"zh": "砰！你感到一股力量将你击退。", "en": "CRASH! A force pushes you back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "它靠近另一只，发出求偶声。", "en": "It approaches another, emitting a mating call."},
        {"zh": "两只互相触碰触须，似乎在交流。", "en": "They touch tentacles, exchanging something."},
        {"zh": "它们彼此靠近，发出低鸣。", "en": "They draw close, emitting low rumbles."},
        {"zh": "它轻触另一只，试图吸引它。", "en": "It gently touches the other, trying to attract it."},
        {"zh": "它们互相触碰，仿佛在确认身份。", "en": "They touch each other, confirming identity."},
        {"zh": "它们互相触碰触须，发出轻声。", "en": "They touch tentacles, emitting soft sounds."},
        {"zh": "它靠近另一只，发出求偶的呢喃。", "en": "It approaches another, emitting a mating coo."},
        {"zh": "它们互相触碰，似乎在进行某种仪式。", "en": "They touch each other, performing some ritual."},
        {"zh": "它轻触另一只，似乎在安抚它。", "en": "It gently touches the other, trying to soothe it."},
        {"zh": "它们互相触碰，发出轻声呢喃。", "en": "They touch each other, emitting soft coos."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "苍白之光笼罩我", "en": "Pale light surrounds me."},
        {"zh": "饥渴的呼唤响起", "en": "A call of hunger."},
        {"zh": "地面即将颤抖", "en": "The ground will tremble."},
        {"zh": "吞噬一切的欲望", "en": "Desire to consume all."},
        {"zh": "我把矿灯踢灭，再慢慢找。", "en": "I kick out the mine lamp, then search slowly."},
        {"zh": "暗夜的低语", "en": "Whispers in the night."},
        {"zh": "吸取生命的力量", "en": "Absorb life force."},
        {"zh": "怨恨转化为力量", "en": "Hatred becomes power."},
        {"zh": "死亡的舞步", "en": "Dance of death."},
        {"zh": "它想要的东西，我拿来了。", "en": "I brought what it wanted."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "感知到你的恐惧", "en": "Feel your fear."},
        {"zh": "引线已被恶魔点燃。", "en": "The demon has lit my fuse."},
        {"zh": "准备引爆", "en": "Ready to explode."},
        {"zh": "靠近我，尝尝痛苦", "en": "Come closer, feel the pain."},
        {"zh": "感受到你的绝望", "en": "Sense your despair."},
        {"zh": "我体内的东西点了根引线。", "en": "Something inside me lit a fuse."},
        {"zh": "撕裂你的灵魂", "en": "Tear your soul."},
        {"zh": "恐惧让一切变得更简单", "en": "Fear makes it simpler."},
        {"zh": "痛苦中寻找解脱", "en": "Find relief in pain."},
        {"zh": "被附身的苦力怕，引信亮了。", "en": "A possessed creeper — the fuse is lit."},
        {"zh": "你来对了地方，也来错了。", "en": "You came to the right place. And the wrong one."},
        {"zh": "苍白的东西转向你了。", "en": "The pale thing has turned toward you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准你的心脏", "en": "Target your heart."},
        {"zh": "击溃你的意志", "en": "Crush your will."},
        {"zh": "让恐惧吞噬你", "en": "Let fear consume you."},
        {"zh": "你的痛苦即我的快乐", "en": "Your pain is my joy."},
        {"zh": "释放死亡的诅咒", "en": "Release the curse of death."},
        {"zh": "感受死亡的逼近", "en": "Feel death approaching."},
        {"zh": "痛苦中你会屈服", "en": "You will yield to pain."},
        {"zh": "恐惧让你变得脆弱", "en": "Fear makes you weak."},
        {"zh": "你越怕，引线烧得越快。", "en": "The more you fear, the faster the fuse burns."},
        {"zh": "恐惧中你会崩溃", "en": "You will collapse in fear."},
        {"zh": "我的身体在鼓起来。", "en": "My body is swelling."},
        {"zh": "引线很短，你猜猜看。", "en": "The fuse is short. Guess."},
        {"zh": "退后，我不想炸到你。", "en": "Back off; I'd rather not blow you up."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "退开，苦力怕的壳要裂了。", "en": "Back away; the creeper's shell is splitting."},
        {"zh": "我的引线已经烧到一半了。", "en": "My fuse is already half burned."},
        {"zh": "咕咕咕，尝尝我的毒气！", "en": "Gurgle, taste my gas!"},
        {"zh": "啊啊啊，燃烧吧！", "en": "Ahh, burn!"},
        {"zh": "咕咕咕，我来了！", "en": "Gurgle, here I come!"},
        {"zh": "嘶嘶嘶，尝尝我的愤怒！", "en": "Sssss, taste my fury!"},
        {"zh": "嘶嘶嘶，火焰即将爆发！", "en": "Sssss, flames about to burst!"},
        {"zh": "咕咕咕，别靠近我！", "en": "Gurgle, stay away!"},
        {"zh": "这声嘶响不是我发出的。", "en": "That hiss didn't come from me."},
        {"zh": "咕咕咕，我要吞噬你！", "en": "Gurgle, I'll consume you!"}
