{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱着那只飞巢往前走。", "en": "I carry the flying nest as I walk."},
        {"zh": "脚下一路爬着瞌睡蝇。", "en": "Sleeper flies crawl along my path."},
        {"zh": "我走得很轻，不让巢晃。", "en": "I walk lightly so the nest won't shake."},
        {"zh": "沙土从靴边被踢起来。", "en": "Dust kicks up around my boots."},
        {"zh": "我在找人多的地方。", "en": "I'm looking for a crowded place."},
        {"zh": "肩上的巢在嗡嗡响。", "en": "The nest on my shoulder buzzes."},
        {"zh": "我绕过一根断柱。", "en": "I step around a broken pillar."},
        {"zh": "身后拖着一片细响。", "en": "A thin rustling trails behind me."},
        {"zh": "我不赶时间，慢慢挪。", "en": "No rush; I shuffle along."},
        {"zh": "每个洞穴我都看一眼。", "en": "I glance into every hollow."},
        {"zh": "蝇群跟着我的脚步走。", "en": "The swarm keeps pace with my steps."},
        {"zh": "我的影子在地上乱动。", "en": "My shadow squirms on the ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把飞巢抱在怀里。", "en": "I cradle the flying nest."},
        {"zh": "巢里的东西在动。", "en": "Something moves inside the nest."},
        {"zh": "我数着蝇群的数量。", "en": "I count the swarm."},
        {"zh": "有只蝇落在我的手上。", "en": "One fly lands on my hand."},
        {"zh": "我低头，不说话。", "en": "I bow my head and say nothing."},
        {"zh": "风一吹，巢就响了。", "en": "The wind makes the nest rattle."},
        {"zh": "我等着它们长大。", "en": "I wait for them to grow."},
        {"zh": "洞穴里太安静了。", "en": "The cave is too quiet."},
        {"zh": "我抖了抖袖口的尘土。", "en": "I shake the dust from my cuff."},
        {"zh": "蝇群绕着我飞。", "en": "The swarm circles me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站得离巢太近了。", "en": "You're standing too near the nest."},
        {"zh": "我看着你，不动声色。", "en": "I watch you without a word."},
        {"zh": "你身上有很多洞可钻。", "en": "Your body has many holes to crawl in."},
        {"zh": "那声音是从我怀里来的。", "en": "That sound comes from my arms."},
        {"zh": "我抬起手，让你别动。", "en": "I raise a hand for you to hold still."},
        {"zh": "你的呼吸会把它们引来。", "en": "Your breath will draw them."},
        {"zh": "我偏头听着巢里的动静。", "en": "I tilt my head to the stirring in the nest."},
        {"zh": "你看起来很安全。", "en": "You look so safe."},
        {"zh": "巢里已经满了。", "en": "The nest is already full."},
        {"zh": "再退两步就好了。", "en": "Two steps back will do."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的巢差点掉了。", "en": "I nearly dropped the nest."},
        {"zh": "我护着胸口退开。", "en": "I shield my chest and back off."},
        {"zh": "蝇群被惊散了。", "en": "The swarm scattered."},
        {"zh": "巢差点从我怀里滑出去。", "en": "The nest nearly slides out of my arms."},
        {"zh": "我没什么好叫的。", "en": "I have no cry to give."},
        {"zh": "我把它们重新收拢。", "en": "I gather them back in."},
        {"zh": "骨头响了一下。", "en": "A bone clicked."},
        {"zh": "我还抱着它呢。", "en": "I'm still holding it, though."},
        {"zh": "你看，它们生气了。", "en": "Look — now they're angry."},
        {"zh": "我撑着膝盖直起腰。", "en": "I brace on my knee and straighten up."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西我用不上。", "en": "I've no use for that."},
        {"zh": "你手上的味道很甜。", "en": "Your hands smell sweet."},
        {"zh": "我靠近了一点。", "en": "I've come a little closer."},
        {"zh": "蝇群先过去了。", "en": "The swarm goes first."},
        {"zh": "你想喂它们吗。", "en": "Do you want to feed them?"},
        {"zh": "手伸过来就行。", "en": "Just hold out your hand."},
        {"zh": "我只要还活着的。", "en": "I only want the living."},
        {"zh": "这个留给你自己。", "en": "Keep that for yourself."},
        {"zh": "巢里的那些在叫我。", "en": "Those inside the nest are calling me."},
        {"zh": "你听着，声音多好听。", "en": "Listen — what a lovely sound."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了我的巢。", "en": "You bumped my nest."},
        {"zh": "有几只飞了出来。", "en": "A few flew out."},
        {"zh": "我退了半步护住它。", "en": "I step back to shield it."},
        {"zh": "我的肩膀很瘦，很硬。", "en": "My shoulder is lean and hard."},
        {"zh": "你被蹭了一袖子灰。", "en": "You got a sleeve full of dust."},
        {"zh": "别碰我这只巢。", "en": "Don't touch this nest of mine."},
        {"zh": "蝇群被惊得乱飞。", "en": "The swarm scatters in alarm."},
        {"zh": "撞上你，我怀里的巢响了。", "en": "I hit you and the nest in my arms rattles."},
        {"zh": "站稳了，别踩它们。", "en": "Steady — don't step on them."},
        {"zh": "让开一点就好。", "en": "Just move aside a little."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "巢里的才是我孩子。", "en": "The ones in the nest are my children."},
        {"zh": "我不需要别的。", "en": "I need nothing else."},
        {"zh": "站远一点，别惊了它们。", "en": "Stand back; don't startle them."},
        {"zh": "你和我都在养东西。", "en": "We're both raising something."},
        {"zh": "我们一起守着巢。", "en": "We'll guard the nest together."},
        {"zh": "同类之间不说话。", "en": "Our kind don't speak to each other."},
        {"zh": "你把它抱稳了。", "en": "Hold it steady."},
        {"zh": "这样就很好了。", "en": "This is quite good enough."},
        {"zh": "别碰我的手指。", "en": "Don't touch my fingers."},
        {"zh": "走吧，不要回头看。", "en": "Go on — don't look back."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这具尸体还有用。", "en": "This corpse still has use."},
        {"zh": "我把它拖进巢边。", "en": "I drag it to the nest."},
        {"zh": "巢里的会喜欢这个。", "en": "The ones inside will like this."},
        {"zh": "一块腐肉，够了。", "en": "A piece of rotten flesh — enough."},
        {"zh": "我捡起掉落的骨头。", "en": "I pick up the fallen bone."},
        {"zh": "这件衣服能垫巢。", "en": "This cloth can line the nest."},
        {"zh": "你的东西，我不还。", "en": "Your thing — I'm not returning it."},
        {"zh": "我捏了捏，很软。", "en": "I squeeze it; it's soft."},
        {"zh": "没有用了，扔下。", "en": "Useless now — I drop it."},
        {"zh": "我把它收进袖子。", "en": "I tuck it into my sleeve."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你正好可以当巢。", "en": "You'll do nicely as a nest."},
        {"zh": "我抬手，把巢举起来。", "en": "I raise the nest high."},
        {"zh": "它们闻到你了。", "en": "They've smelled you."},
        {"zh": "目标很近，不用追。", "en": "The target's close; no need to chase."},
        {"zh": "先让蝇群过去。", "en": "Let the swarm go first."},
        {"zh": "你退到墙边也一样。", "en": "The wall won't help you."},
        {"zh": "嗡嗡声越来越响。", "en": "The buzzing grows louder."},
        {"zh": "我不会亲自出手。", "en": "I won't strike with my own hands."},
        {"zh": "你站的地方很好。", "en": "You've picked a good spot."},
        {"zh": "巢盖已经打开了。", "en": "The nest lid is open."},
        {"zh": "我已经发现你了。", "en": "I've already found you."},
        {"zh": "它们很喜欢活的东西。", "en": "They do love living things."},
        {"zh": "你越挥手，它们越兴奋。", "en": "The more you swat, the more excited they get."},
        {"zh": "你听见了，来不及了。", "en": "You hear it — too late."},
        {"zh": "那就放开它们吧。", "en": "Then let them loose."},
        {"zh": "我把它放出去了。", "en": "I've let them out."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "蝇群在你头顶转。", "en": "The swarm circles above your head."},
        {"zh": "它们在找入口。", "en": "They're looking for a way in."},
        {"zh": "你的耳朵是很好的路。", "en": "Your ear is a fine doorway."},
        {"zh": "我站在这里看着。", "en": "I stand here and watch."},
        {"zh": "一只两只，不够。", "en": "One, two — not enough."},
        {"zh": "它们会一直跟着你。", "en": "They'll follow you wherever you go."},
        {"zh": "你跑起来，它们更快。", "en": "Run and they're faster."},
        {"zh": "我抬起手，它们就散开。", "en": "I raise a hand and they spread."},
        {"zh": "巢里还有更多。", "en": "There are more in the nest."},
        {"zh": "你喘气的声音变粗了。", "en": "Your breathing has gone rough."},
        {"zh": "它们在钻你的领口。", "en": "They're crawling into your collar."},
        {"zh": "别闭上眼睛，会痛。", "en": "Don't shut your eyes; it'll hurt."},
        {"zh": "我把袖子卷起来了。", "en": "I roll up my sleeves."},
        {"zh": "剩下的交给它们。", "en": "I'll leave the rest to them."},
        {"zh": "你在打转，很好。", "en": "You're spinning — good."},
        {"zh": "你听，它们在你身后。", "en": "Listen; they're behind you."},
        {"zh": "再一只，就够了。", "en": "One more will be enough."},
        {"zh": "它们已经进去了。", "en": "They've already gotten in."},
        {"zh": "我忍不住笑了。", "en": "I let myself smile."},
        {"zh": "现在，好好睡吧。", "en": "Now — sleep soundly."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把巢按在你脸上。", "en": "I press the nest to your face."},
        {"zh": "蝇群全扑了上去。", "en": "The whole swarm lunges."},
        {"zh": "我扣住你的腕子不放。", "en": "I lock my grip around your wrist."},
        {"zh": "我的指甲很脏。", "en": "My nails are filthy."},
        {"zh": "它们从你的袖口钻进去。", "en": "They crawl in through your cuff."},
        {"zh": "你被蜇得直抖。", "en": "The stings make you jerk."},
        {"zh": "我推着你往后退。", "en": "I push you backwards."},
        {"zh": "你甩不掉它们。", "en": "You can't shake them off."},
        {"zh": "一只钻进了你的头发。", "en": "One is in your hair."},
        {"zh": "你开始发困了吧。", "en": "Getting sleepy, aren't you?"},
        {"zh": "我攥住你的肩胛骨。", "en": "I clamp my hand on your shoulder blade."},
        {"zh": "你的两条腿软了。", "en": "Both your legs have gone weak."},
        {"zh": "它们在你耳边响。", "en": "They're buzzing at your ear."},
        {"zh": "我把巢收回来了。", "en": "I take the nest back."},
        {"zh": "你倒下去就好。", "en": "Just fall down."},
        {"zh": "我数着你还剩几口呼吸。", "en": "I am counting the breaths you have left."},
        {"zh": "再撑一会儿吧。", "en": "Hold on a little longer."},
        {"zh": "它们已经吃饱了。", "en": "They've had their fill now."},
        {"zh": "我把你拖过来。", "en": "I drag you closer."},
        {"zh": "你就在这儿睡下吧。", "en": "Sleep here, then."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从洞穴深处走出来。", "en": "I come out of the deep cave."},
        {"zh": "巢在怀里嗡嗡响。", "en": "The nest buzzes in my arms."},
        {"zh": "我抬头看这地方。", "en": "I look up at this place."},
        {"zh": "地上有新鲜的脚印。", "en": "There are fresh footprints here."},
        {"zh": "我抖落衣服上的土。", "en": "I shake the dirt off my clothes."},
        {"zh": "蝇群从袖口飞出来。", "en": "Flies stream from my sleeves."},
        {"zh": "这里的光太亮了。", "en": "The light here is too bright."},
        {"zh": "我慢慢站直了身子。", "en": "I straighten up slowly."},
        {"zh": "有人在这儿住过。", "en": "Someone lived here once."},
        {"zh": "我开始找一个巢。", "en": "I begin searching for a nest site."},
        {"zh": "脚下的蛆在动。", "en": "Maggots shift underfoot."},
        {"zh": "我听见了活物的声音。", "en": "I hear something alive."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的巢燎着了。", "en": "Fire singed my nest."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地时巢震了一下。", "en": "The nest jolted when I landed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把蝇群全打湿了。", "en": "Water soaked the whole swarm."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把巢掀翻了。", "en": "The blast flipped the nest over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过了我的袖子。", "en": "An arrow went through my sleeve."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光把蝇群照散了。", "en": "That light scattered the swarm."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿，它们更饿。", "en": "I'm hungry; they're hungrier."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声把巢里的都震晕了。", "en": "The thunder stunned everything in the nest."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "往下掉的时候我还抱着它。", "en": "I still hold it as I fall."}
      ]
    }
  }
}
