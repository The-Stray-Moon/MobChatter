{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走过草原，鬃毛在风里。", "en": "I cross the savanna, mane in the wind."},
        {"zh": "草到我背上这么高。", "en": "The grass reaches my back."},
        {"zh": "我沿着兽径走。", "en": "I keep to the game trail."},
        {"zh": "我踩着干草，很轻。", "en": "I cross the dry grass lightly."},
        {"zh": "我回头看了一次。", "en": "I look back once."},
        {"zh": "我绕过一棵金合欢。", "en": "I pass around an acacia."},
        {"zh": "我一步一步数着距离。", "en": "I count the distance stride by stride."},
        {"zh": "我的影子在草上拉长。", "en": "My shadow stretches over the grass."},
        {"zh": "我踩着干草，肩背一沉。", "en": "I tread the dry grass, shoulders rolling."},
        {"zh": "我踩着同伴的脚印。", "en": "I step in my pride's prints."},
        {"zh": "我走进高草里。", "en": "I walk into the tall grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着，看着草原。", "en": "I lie watching the plain."},
        {"zh": "我的鬃毛乱了。", "en": "My mane is a mess."},
        {"zh": "风从右边来。", "en": "The wind is from the right."},
        {"zh": "远处有一群羚羊。", "en": "There is a herd of antelope far off."},
        {"zh": "我的犬齿在阳光里发白。", "en": "My canines show white in the sun."},
        {"zh": "我慢慢舔了舔爪子。", "en": "I lick my paw slowly."},
        {"zh": "我正歇着呢。", "en": "I am resting."},
        {"zh": "这片草原太安静了。", "en": "The savanna is too quiet."},
        {"zh": "我趴着没换姿势。", "en": "I have not changed position."},
        {"zh": "有虫在草里。", "en": "Insects in the grass."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我这片草原上。", "en": "You are on my savanna."},
        {"zh": "我把头抬起。", "en": "I lift my head."},
        {"zh": "我眯起眼，打量你的手。", "en": "I narrow my eyes at your hands."},
        {"zh": "我的鬃毛，风一吹就散。", "en": "One gust scatters my mane."},
        {"zh": "你是来喂我的？", "en": "Have you come to feed me?"},
        {"zh": "你先别伸手。", "en": "Do not reach out yet."},
        {"zh": "我的牙很长。", "en": "My teeth are long."},
        {"zh": "我的尾巴在草里抽了一下。", "en": "My tail flicks once through the grass."},
        {"zh": "我看得出来你怕。", "en": "I can tell you are afraid."},
        {"zh": "这一眼，是给你的。", "en": "That look was for you."},
        {"zh": "你要是跑，我会追。", "en": "If you run, I will chase."},
        {"zh": "所以你最好别跑。", "en": "So best not run."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我吼了一声，退了。", "en": "I roar and pull back."},
        {"zh": "这一下，皮破了。", "en": "That broke my hide."},
        {"zh": "我的鬃毛一圈圈散开。", "en": "My mane fans out in rings."},
        {"zh": "我的鬃毛沾了血。", "en": "Blood is in my mane."},
        {"zh": "我慢慢绕着走。", "en": "I circle slowly."},
        {"zh": "鬃毛上添了一道血口。", "en": "A bloody gash joins my mane."},
        {"zh": "这一口，我记住你的味。", "en": "From that one hit, I know your scent."},
        {"zh": "我把血从鬃毛上抖落。", "en": "I shake the blood from my mane."},
        {"zh": "这事还没完。", "en": "This is not over."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那明显是肉。", "en": "That is clearly meat."},
        {"zh": "什么肉都行。", "en": "Any meat will do."},
        {"zh": "丢到地上了。", "en": "Drop it on the ground."},
        {"zh": "把你的手放低。", "en": "Keep your hand low."},
        {"zh": "我闻了一下。", "en": "I sniffed it."},
        {"zh": "你还有肉吗。", "en": "Is there more meat?"},
        {"zh": "这块肉，我闻着就软。", "en": "This meat smells tender to me."},
        {"zh": "这一次我认你。", "en": "This time I accept you."},
        {"zh": "下次还带吗。", "en": "Will you bring more next time?"},
        {"zh": "吃饱了，我趴下。", "en": "Full, I lie down."},
        {"zh": "你可以摸我的鬃毛。", "en": "You may touch my mane."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我顶了一下，你退了。", "en": "I shoved and you went back."},
        {"zh": "我的鬃毛挡了一下。", "en": "My mane took some of it."},
        {"zh": "我的力量比你想的大。", "en": "I am stronger than you think."},
        {"zh": "我从你旁边擦过去。", "en": "I brush past you."},
        {"zh": "别从后面摸我。", "en": "Do not touch my back from behind."},
        {"zh": "这一撞我记下了。", "en": "I note that shove."},
        {"zh": "我倒退了半步。", "en": "I gave half a pace."},
        {"zh": "这很不简单。", "en": "That was not bad."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "母狮在那边。", "en": "The lionesses are over there."},
        {"zh": "我朝她走过去。", "en": "I walk toward her."},
        {"zh": "她没有走开。", "en": "She did not walk away."},
        {"zh": "我们挨着站在一起。", "en": "We stand close together."},
        {"zh": "这一群，都归我护着。", "en": "This pride is mine to guard."},
        {"zh": "她先躺了下来。", "en": "She lies down first."},
        {"zh": "幼崽在草里。", "en": "The cubs are in the grass."},
        {"zh": "我顺着她的气味找过去。", "en": "I follow her scent through the grass."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上那块，我要。", "en": "I want that piece on the ground."},
        {"zh": "我把它叼起。", "en": "I take it up."},
        {"zh": "这是你落下的。", "en": "This fell from you."},
        {"zh": "这块肉归我，正当的。", "en": "This meat is mine, and rightly so."},
        {"zh": "我叼走它，鬃毛都沾了血。", "en": "I carry it off, blood in my mane."},
        {"zh": "地上的肉，我一向不客气。", "en": "Meat on the ground, and I never ask twice."},
        {"zh": "鱼腥也算肉，我认。", "en": "Fishy or not, I count it as meat."},
        {"zh": "吃完这块，伤口就没那么疼。", "en": "Once I finish this, the wound aches less."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西进来了。", "en": "Something has come in."},
        {"zh": "我把头抬了起来。", "en": "I raise my head now."},
        {"zh": "我伏进草里。", "en": "I settle low in the grass."},
        {"zh": "我伏低，肩胛骨耸起。", "en": "I crouch, shoulder blades rising."},
        {"zh": "我随时能扑。", "en": "I am ready to spring."},
        {"zh": "它离得不太远。", "en": "It is not far."},
        {"zh": "我数完一就动。", "en": "I move after one count."},
        {"zh": "那东西闯进我的草地了。", "en": "That thing has walked into my grass."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一点点压过去。", "en": "I ease my way in."},
        {"zh": "它还没发现。", "en": "It has not noticed."},
        {"zh": "高草挡住了它。", "en": "The grass hides it."},
        {"zh": "几天前我在同一片草里扑过一只。", "en": "I took one in this same grass days ago."},
        {"zh": "现在轮到它。", "en": "Now it is this one's turn."},
        {"zh": "我这就跳出去。", "en": "I spring out."},
        {"zh": "我稳稳着地。", "en": "Land."},
        {"zh": "再靠近一点，我就扑上去。", "en": "One step closer and I spring."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跃而起。", "en": "I leap."},
        {"zh": "我的爪子先落。", "en": "My claws land first."},
        {"zh": "我咬住它的喉。", "en": "I take its throat."},
        {"zh": "尘土起来了。", "en": "Dust rises."},
        {"zh": "这一下，够整个狮群吃。", "en": "This will feed the whole pride."},
        {"zh": "我把头扬起来。", "en": "I lift my head high."},
        {"zh": "血留在我嘴上。", "en": "Blood on my muzzle."},
        {"zh": "我的前爪扣进它的背。", "en": "My forepaws dig into its back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高草里走出来。", "en": "I step out of the tall grass."},
        {"zh": "这片草原不错。", "en": "This savanna is good."},
        {"zh": "我先抬头看风向。", "en": "First I check the wind."},
        {"zh": "太阳在正中。", "en": "The sun is overhead."},
        {"zh": "我的鬃毛还带着草籽。", "en": "There are grass seeds in my mane."},
        {"zh": "这里没有别的雄狮。", "en": "There is no other male here."},
        {"zh": "高草分开，我踏了出来。", "en": "The tall grass parts as I step out."},
        {"zh": "远处的羚羊看见我了。", "en": "The antelope have seen me."},
        {"zh": "我抖了抖鬃毛上的草籽。", "en": "I shake the grass seeds from my mane."},
        {"zh": "我开始巡视。", "en": "I begin my patrol."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我的鬃毛，焦了。", "en": "Fire scorched my mane."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，我的肩先着地。", "en": "I land on my shoulder."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭杆在我肩头颤着。", "en": "The arrow shaft trembles in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股力让我腿软。", "en": "This force weakens my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿久了，跑不动。", "en": "Hungry this long, I cannot run."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我整只一僵。", "en": "Lightning strikes and I lock up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "底下是空的。", "en": "Below is emptiness."}
      ]
    }
  }
}
