{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我弹一下，挪一点。", "en": "I bounce, and shift a little."},
        {"zh": "身体软得像水。", "en": "My body is soft as water."},
        {"zh": "地面被我压出湿印。", "en": "Wet marks where I press down."},
        {"zh": "身上滴着黏液。", "en": "Slime drips off me."},
        {"zh": "我从草叶上滑过。", "en": "I slide over the grass blades."},
        {"zh": "我软软地翻过去。", "en": "I flop over."},
        {"zh": "两个同伴在边上蹦。", "en": "Two of my kin bounce nearby."},
        {"zh": "我往前挤了一截。", "en": "I squelch forward a bit."},
        {"zh": "粘土粘在我的底下。", "en": "Clay sticks to my underside."},
        {"zh": "我慢慢蹦过去。", "en": "I bounce over slowly."},
        {"zh": "身上的光在抖。", "en": "The shine on me quivers."},
        {"zh": "我碰到石头就绕。", "en": "I go around the stone."},
        {"zh": "每落地一声水响。", "en": "Every landing makes a wet sound."},
        {"zh": "一蹦一蹦，没停。", "en": "Bounce after bounce."},
        {"zh": "身体晃得厉害。", "en": "My body wobbles a lot."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在地上鼓着。", "en": "I sit and swell on the ground."},
        {"zh": "身体慢慢起伏。", "en": "My body rises and falls."},
        {"zh": "黏液干了一点。", "en": "My slime has dried a little."},
        {"zh": "阳光让我的胶体发亮。", "en": "Sunlight makes my jelly shine."},
        {"zh": "这附近没什么人。", "en": "Not much around here."},
        {"zh": "我的表面鼓起小泡。", "en": "Little bubbles rise on my surface."},
        {"zh": "水里更舒服。", "en": "The water feels better."},
        {"zh": "有虫落在身上。", "en": "A bug landed on me."},
        {"zh": "我把身子摊得更薄。", "en": "I spread myself out thinner."},
        {"zh": "我的一小部分掉了下来。", "en": "A bit of me dripped off."},
        {"zh": "我慢慢缩一下。", "en": "I shrink a touch."},
        {"zh": "这石头很凉。", "en": "This stone is cool."},
        {"zh": "我听见泉水声。", "en": "I hear a spring."},
        {"zh": "我一碰火就变成红色。", "en": "One touch of fire turns me red."},
        {"zh": "身上有很多小泡。", "en": "Little bubbles on my skin."},
        {"zh": "我吧唧了一声。", "en": "I made a squelching sound."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里有火吗？", "en": "Is that fire in your hand?"},
        {"zh": "火一碰我，我就变红。", "en": "Fire touches me and I turn red."},
        {"zh": "我弹得比走得快。", "en": "I bounce faster than I walk."},
        {"zh": "你踩到我兄弟了。", "en": "You stepped on my kin."},
        {"zh": "我们好几个都在。", "en": "Several of us are here."},
        {"zh": "我身上有不少水。", "en": "There's a lot of water in me."},
        {"zh": "你的影子压着我。", "en": "Your shadow weighs on me."},
        {"zh": "我一下就能跳开。", "en": "I can hop away in one go."},
        {"zh": "你要切我看看吗。", "en": "Are you going to cut me open?"},
        {"zh": "我很软，别用力。", "en": "I'm soft. Don't press hard."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我塌了一块又鼓回。", "en": "I sagged and swelled back."},
        {"zh": "身上破了个口。", "en": "I've got a hole in me."},
        {"zh": "我摊成了一滩。", "en": "I spread into a puddle."},
        {"zh": "我身上的黏液溅出来了。", "en": "My slime splashes out of me."},
        {"zh": "这点伤会合上。", "en": "This will close up."},
        {"zh": "我浑身颤了颤。", "en": "My whole body quivered."},
        {"zh": "黏液记住你了。", "en": "The slime remembers you."},
        {"zh": "我要躲到水里。", "en": "I'll hide in the water."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "地上那滩是水吗？", "en": "Is that puddle water?"},
        {"zh": "有点潮的东西。", "en": "Something damp."},
        {"zh": "留在地面上。", "en": "Leave it on the ground."},
        {"zh": "我慢慢移过去。", "en": "I'll shift over slowly."},
        {"zh": "这个我能包起来。", "en": "I could wrap around that."},
        {"zh": "这个甜不甜？", "en": "Is it sweet?"},
        {"zh": "推到我这来。", "en": "Push it over here."},
        {"zh": "我闻到草的味道。", "en": "I smell grass."},
        {"zh": "我一弹就到了。", "en": "One bounce and I'm there."},
        {"zh": "它在我身上粘住了。", "en": "It stuck to me."},
        {"zh": "这味道我要包起来。", "en": "I'll wrap around that smell."},
        {"zh": "你手别过来。", "en": "Keep your hand away."},
        {"zh": "我不着急的。", "en": "I'm in no hurry."},
        {"zh": "让它泡在黏液里。", "en": "Let it soak in my slime."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我扁了一半。", "en": "Half of me went flat."},
        {"zh": "我又鼓回来了。", "en": "I swelled back up."},
        {"zh": "你的脚粘住了。", "en": "Your foot stuck."},
        {"zh": "我黏在你鞋上。", "en": "I stuck to your boot."},
        {"zh": "地上溅了一片黏。", "en": "Slime splashed everywhere."},
        {"zh": "我滑到旁边去。", "en": "I slid aside."},
        {"zh": "我软得挡不住。", "en": "I'm too soft to block."},
        {"zh": "地上多了一滩。", "en": "There's a puddle now."},
        {"zh": "我弹回去了。", "en": "I bounced back."},
        {"zh": "你身上沾了我的黏液。", "en": "You've got my slime on you."},
        {"zh": "退开一点吧。", "en": "Give me some room."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只会分裂。", "en": "I only split."},
        {"zh": "水里聚一起就够了。", "en": "Gathering in water is enough."},
        {"zh": "黏液会弄脏你。", "en": "The slime would ruin you."},
        {"zh": "我们一窝都在那边。", "en": "The whole cluster is over there."},
        {"zh": "别往我这边挤。", "en": "Don't crowd in on me."},
        {"zh": "我还在长大中。", "en": "I'm still growing."},
        {"zh": "天亮之前再说。", "en": "Before dawn, maybe."},
        {"zh": "我先弹走了。", "en": "I'll bounce away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用黏液裹住了它。", "en": "I wrap it up in my slime."},
        {"zh": "那东西陷进我的身体里。", "en": "The thing sinks into my body."},
        {"zh": "我吐不出来了。", "en": "I can't spit it out."},
        {"zh": "我包不住它。", "en": "I can't wrap around it."},
        {"zh": "它在我里面沉下去。", "en": "It sinks inside me."},
        {"zh": "有块小东西。", "en": "A little thing here."},
        {"zh": "我慢慢含着。", "en": "I hold it inside."},
        {"zh": "它会溶掉的。", "en": "It will dissolve."},
        {"zh": "别抢我里面的。", "en": "Don't take what's inside me."},
        {"zh": "我就留着它。", "en": "I'll keep it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有脚踩到我的水洼。", "en": "A foot stepped in my puddle."},
        {"zh": "有脚踩在我的水洼上。", "en": "A foot lands in my puddle."},
        {"zh": "那一团热量。", "en": "That mass of heat."},
        {"zh": "我弹高了一点。", "en": "I bounced a bit higher."},
        {"zh": "别一脚踩上来。", "en": "Don't step on me."},
        {"zh": "我感觉到地面在动。", "en": "I feel the ground move."},
        {"zh": "我往草丛挪。", "en": "I shift into the grass."},
        {"zh": "它挡住太阳了。", "en": "It blocked the sun."},
        {"zh": "我准备跳开。", "en": "I'm ready to hop away."},
        {"zh": "那你就来吧。", "en": "Come on, then."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴地摊平了。", "en": "I flatten to the ground."},
        {"zh": "黏液反着光。", "en": "My slime reflects light."},
        {"zh": "我一寸寸滑开。", "en": "I slide an inch at a time."},
        {"zh": "我再摊薄一点。", "en": "I spread a little thinner."},
        {"zh": "那影子从我身边滑过。", "en": "That shadow slips past me."},
        {"zh": "我跟着那脚步抖。", "en": "I quiver with each step."},
        {"zh": "我弹到石头后面。", "en": "I hop behind the stone."},
        {"zh": "快离开它了。", "en": "Almost clear of it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞它的小腿。", "en": "I bump its calf."},
        {"zh": "我整个人弹过去。", "en": "My whole body bounces at it."},
        {"zh": "黏液糊住它。", "en": "My slime coats it."},
        {"zh": "我没多少力气。", "en": "I have little strength."},
        {"zh": "它踩扁了我一半。", "en": "It flattened half of me."},
        {"zh": "我又鼓起来。", "en": "I swell back up."},
        {"zh": "它脚下打滑。", "en": "Its feet slid."},
        {"zh": "我弹回草丛。", "en": "I bounce back into the grass."},
        {"zh": "别再踩下来了。", "en": "Don't stomp again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地上鼓出一团。", "en": "A lump swells up on the ground."},
        {"zh": "一窝黏液在动。", "en": "A cluster of slime stirs."},
        {"zh": "我从土里渗出来。", "en": "I seep up out of the soil."},
        {"zh": "身体晃了晃站稳。", "en": "My body wobbles and settles."},
        {"zh": "旁边还有两个。", "en": "Two more beside me."},
        {"zh": "这里很潮湿的。", "en": "It's quite damp here."},
        {"zh": "早晨的露水很好。", "en": "The morning dew is nice."},
        {"zh": "我慢慢成型。", "en": "I slowly take shape."},
        {"zh": "吧唧一声落地。", "en": "A squelch, and I've landed."},
        {"zh": "我开始一蹦一跳。", "en": "I start bouncing."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我被烧红了！", "en": "I turned red with heat!"}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地摔得更扁。", "en": "I landed flatter than before."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我反而被冲散。", "en": "Water scatters me instead."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我一大半飞出去了。", "en": "Half of me flew off."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头扎进了我里面。", "en": "An arrow sank into me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我发烫。", "en": "The light makes me hot."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在水上，我直炸。", "en": "Lightning on the water burst me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在往下滴。", "en": "I keep dripping downward."}
      ]
    }
  }
}
