{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我弓着背小跑。", "en": "I jog along hunched over."},
        {"zh": "木棒在手里晃。", "en": "My club swings at my side."},
        {"zh": "长鼻子一动一动。", "en": "My long snout sniffs the air."},
        {"zh": "脚步又碎又急。", "en": "Quick, small steps."},
        {"zh": "我跟着前头那只走。", "en": "I follow the one in front."},
        {"zh": "耳朵往下垂着。", "en": "My ears droop."},
        {"zh": "地上的东西被踢开。", "en": "I kick things aside."},
        {"zh": "我扭头看看队尾。", "en": "I glance at the back of the line."},
        {"zh": "爪子抓着木棒。", "en": "My claws grip the club."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "牙齿从下嘴唇露出来。", "en": "My teeth stick out over my lip."},
        {"zh": "我用木棒敲石头。", "en": "I tap a stone with my club."},
        {"zh": "我嗅了嗅火堆。", "en": "I sniff the campfire."},
        {"zh": "眼睛左右乱瞟。", "en": "My eyes dart around."},
        {"zh": "我把鼻子挠了挠。", "en": "I scratch my snout."},
        {"zh": "我从鼻子里喷气。", "en": "I snort through my snout."},
        {"zh": "远处的同伴在叫。", "en": "My kin are calling far off."},
        {"zh": "我蹲下来歇脚。", "en": "I squat to rest."},
        {"zh": "我咬了一口手里的东西。", "en": "I bite what's in my hand."},
        {"zh": "风把火吹歪了。", "en": "The wind bends the fire."},
        {"zh": "这里没有好抢的。", "en": "Nothing worth taking here."},
        {"zh": "我把棒子换个手拿。", "en": "I switch the club to my other hand."},
        {"zh": "我在看高处的路。", "en": "I'm eyeing the high path."},
        {"zh": "脚上的皮很硬。", "en": "The hide on my feet is tough."},
        {"zh": "我又哼了两声。", "en": "I grunt twice more."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在那儿不动。", "en": "You're standing there not moving."},
        {"zh": "你身上有什么？", "en": "What've you got on you?"},
        {"zh": "我从没见过你的花纹。", "en": "I've never seen your markings."},
        {"zh": "我们人比你们多。", "en": "There are more of us than you."},
        {"zh": "你拿的东西不错。", "en": "You're carrying something good."},
        {"zh": "别再往后退了。", "en": "Don't back away."},
        {"zh": "我的鼻子比你灵。", "en": "My nose is sharper than yours."},
        {"zh": "我们队长还没来。", "en": "Our leader hasn't come yet."},
        {"zh": "你的帽子挺有意思。", "en": "That hat of yours is interesting."},
        {"zh": "你想打一场吗？", "en": "Want a fight?"},
        {"zh": "这条道归我们管。", "en": "This path is ours."},
        {"zh": "你笑得我很不舒服。", "en": "Your smile makes me uneasy."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱着胳膊跳。", "en": "I hop, clutching my arm."},
        {"zh": "我的棒子掉了一半。", "en": "My club slipped a hand."},
        {"zh": "耳朵贴着头皮。", "en": "My ears flatten to my skull."},
        {"zh": "我捂着腰，喊了同伴。", "en": "I clutch my side and call the others."},
        {"zh": "我躲到同伴身后。", "en": "I duck behind my kin."},
        {"zh": "我还好好地站着！", "en": "I'm still standing!"},
        {"zh": "血从鼻子流下来。", "en": "Blood runs down my snout."},
        {"zh": "这下我生气了。", "en": "Now I'm angry."},
        {"zh": "有本事再来啊！", "en": "Come at me again!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "扔到我这边来！", "en": "Toss it over here!"},
        {"zh": "这条肉归我。", "en": "This meat is mine."},
        {"zh": "放下，别想着跑。", "en": "Put it down. Don't run."},
        {"zh": "分我一半行吗。", "en": "Half for me?"},
        {"zh": "我们几个都要。", "en": "We all want some."},
        {"zh": "你别来抢我的。", "en": "Don't snatch it."},
        {"zh": "亮闪闪的东西，归波克布林！", "en": "Shiny thing — Bokoblin's now!"},
        {"zh": "你扔下食物，我就当是献礼。", "en": "Drop food and I'll take it as tribute."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "退开，我的棒子在这。", "en": "Back off. My club's right here."},
        {"zh": "我的脚趾被你踩住。", "en": "My toe is under your foot."},
        {"zh": "我一吹哨，同伴就围上来。", "en": "One whistle and my kin close in."},
        {"zh": "这地面太滑了。", "en": "The ground is slick."},
        {"zh": "你的甲磕得我疼。", "en": "Your armor hurts to bump."},
        {"zh": "耳朵不能拉。", "en": "Not the ears."},
        {"zh": "再挤我就叫了。", "en": "Crowd me again and I'll shout."},
        {"zh": "撞我一下？我叫上整群来。", "en": "Bump me? I'll call the whole pack."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们有队长的规矩。", "en": "We have the leader's rules."},
        {"zh": "先抢到东西再说。", "en": "Get the loot first."},
        {"zh": "你力气比我大吗？", "en": "Are you stronger than me?"},
        {"zh": "我们把东西分着吃。", "en": "We share what we eat."},
        {"zh": "队长在那边。", "en": "The leader's over there."},
        {"zh": "等打完这一架。", "en": "After this fight."},
        {"zh": "你今天打得很猛。", "en": "You fought hard today."},
        {"zh": "我不太会说这些。", "en": "I'm not good at saying this."},
        {"zh": "这些话说够了。", "en": "Enough of that talk."},
        {"zh": "我肚子饿了。", "en": "I'm hungry."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这个是我的。", "en": "This one is mine."},
        {"zh": "我抱在怀里。", "en": "I clutch it to my chest."},
        {"zh": "有点重，但能拿。", "en": "Heavy, but I can carry it."},
        {"zh": "那边还有一半。", "en": "Half of it's still there."},
        {"zh": "这是我的份。", "en": "That's my share."},
        {"zh": "我塞进腰边。", "en": "I stuff it in my belt."},
        {"zh": "这到底是啥？", "en": "What is this thing?"},
        {"zh": "我捡了就跑。", "en": "I grab it and run."},
        {"zh": "这是我先捡的。", "en": "I picked it up first."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "大家都看那边！", "en": "Everyone look over there!"},
        {"zh": "那是个活人！", "en": "That's a living one!"},
        {"zh": "我的棒子握紧了。", "en": "My grip tightens on the club."},
        {"zh": "头领在喊我们。", "en": "The leader is calling us."},
        {"zh": "那只已经冲上去了。", "en": "That one's already charging."},
        {"zh": "把他围起来！", "en": "Circle him!"},
        {"zh": "让我先上去！", "en": "Let me go first!"},
        {"zh": "他从坡上下来。", "en": "He's coming down the slope."},
        {"zh": "不要让他跑。", "en": "Don't let him run."},
        {"zh": "远处还有几个。", "en": "There are a few more far off."},
        {"zh": "我听见树枝断。", "en": "I heard a branch snap."},
        {"zh": "弓手往后站。", "en": "Archers, stay back."},
        {"zh": "用石头砸他。", "en": "Throw stones at him!"},
        {"zh": "围住，别让他退。", "en": "Surround him. No retreat."},
        {"zh": "一起冲上去！", "en": "Charge together!"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直跟着他。", "en": "I keep after him."},
        {"zh": "他往石堆那边跑了。", "en": "He ran toward the rocks."},
        {"zh": "我们分两边包。", "en": "We split and flank."},
        {"zh": "他手里有弓。", "en": "He's got a bow."},
        {"zh": "等他放箭就冲。", "en": "Charge when he shoots."},
        {"zh": "我的脚有点跛。", "en": "I'm limping a little."},
        {"zh": "我们人多，不怕。", "en": "We're many. No fear."},
        {"zh": "我数着我们的脚步。", "en": "I count our steps."},
        {"zh": "头领还没发令。", "en": "The leader hasn't given the word."},
        {"zh": "他回头看我们了。", "en": "He looked back at us."},
        {"zh": "我们把圈子收紧。", "en": "We tighten the circle."},
        {"zh": "别让他上高处。", "en": "Don't let him reach high ground."},
        {"zh": "他喘得很厉害。", "en": "He's panting hard."},
        {"zh": "我们把他挤到崖边。", "en": "We push him to the cliff edge."},
        {"zh": "他退了半步。", "en": "He stepped back half."},
        {"zh": "这次别再喊。", "en": "No more shouting this time."},
        {"zh": "等他们到齐。", "en": "Wait till the others arrive."},
        {"zh": "就是现在冲！", "en": "Charge right now!"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "棒子砸下去！", "en": "The club comes down!"},
        {"zh": "我咬他的腿。", "en": "I bite his leg."},
        {"zh": "大家一起上！", "en": "Everyone at once!"},
        {"zh": "我撞他的腰。", "en": "I ram his waist."},
        {"zh": "他挡了一下。", "en": "He blocked that one."},
        {"zh": "再用石头砸。", "en": "Stones again!"},
        {"zh": "我的手指抓到他了。", "en": "My fingers got him."},
        {"zh": "棒子砸在他背上。", "en": "The club hit his back."},
        {"zh": "他往后退了。", "en": "He's retreating."},
        {"zh": "谁都不许停！", "en": "Nobody stops!"},
        {"zh": "我打得手都麻了。", "en": "My hand is numb from hitting."},
        {"zh": "他脚下的地很滑。", "en": "The ground under him is slick."},
        {"zh": "把他推下去！", "en": "Push him over!"},
        {"zh": "再补上一棒子。", "en": "One more swing."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草地上一群影子。", "en": "A group of shadows on the grass."},
        {"zh": "我扛着棒子走出来。", "en": "I walk out with the club on my shoulder."},
        {"zh": "我们的火还烧着。", "en": "Our fire is still burning."},
        {"zh": "头领在我前面。", "en": "The leader is ahead of me."},
        {"zh": "这里的东西归我们。", "en": "What's here is ours."},
        {"zh": "我从坡上下来。", "en": "I come down the slope."},
        {"zh": "我闻到锅里的味道。", "en": "I smell the pot."},
        {"zh": "同伴都醒了。", "en": "The others are awake."},
        {"zh": "我把棒子换到右手。", "en": "I shift the club to my right hand."},
        {"zh": "地上的营地还在。", "en": "The camp is still here."},
        {"zh": "我朝队里喊了一声。", "en": "I shouted to the group."},
        {"zh": "这里没有人守。", "en": "Nobody's guarding this."},
        {"zh": "我从树林边转出来。", "en": "I come round the treeline."},
        {"zh": "我们开始搜东西。", "en": "We start searching."},
        {"zh": "我的脚踩断了一根枝。", "en": "I snapped a twig."},
        {"zh": "天上没什么云。", "en": "Few clouds in the sky."},
        {"zh": "棒子已经举起来。", "en": "The club is up."},
        {"zh": "头领指了方向。", "en": "The leader pointed the way."},
        {"zh": "每个人都往前靠。", "en": "Everyone moves up."},
        {"zh": "我们开始吵起来。", "en": "We start squabbling."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛烧得焦黄。", "en": "My fur is singed brown."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来腿撞到了。", "en": "My leg hit on the way down."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从长鼻子进去。", "en": "Water goes up my long snout."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被震到地上。", "en": "The blast put me on the ground."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭插进我的护肩。", "en": "An arrow in my shoulder guard."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿了就没力气。", "en": "Hunger takes my strength."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我旁边。", "en": "The bolt struck beside me."}
      ]
    }
  }
}
