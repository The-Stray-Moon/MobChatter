{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑着翅膀乱飞。", "en": "I flap about in the dark."},
        {"zh": "一只大眼朝前。", "en": "One great eye faces forward."},
        {"zh": "翅膀打得空气响。", "en": "My wings beat loudly."},
        {"zh": "我贴着洞顶滑。", "en": "I glide along the cave ceiling."},
        {"zh": "我忽高忽低。", "en": "I dip and rise."},
        {"zh": "转角处我差点撞墙。", "en": "I nearly hit the wall at the corner."},
        {"zh": "我偏了一下翅膀。", "en": "I banked with one wing."},
        {"zh": "声音在洞里回响。", "en": "My sound echoes in the cave."},
        {"zh": "我朝着微光飞。", "en": "I fly toward the faint light."},
        {"zh": "我停不下来，眼睛一直睁着。", "en": "I can't stop. This eye never closes."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "大眼慢慢转。", "en": "My big eye turns slowly."},
        {"zh": "翅膀收在身边。", "en": "My wings fold at my sides."},
        {"zh": "一滴水滴下来。", "en": "A drop of water falls."},
        {"zh": "我听见远处的翅声。", "en": "I hear distant wingbeats."},
        {"zh": "这里很黑，正好。", "en": "It's dark here. Good."},
        {"zh": "我在数洞里的回音。", "en": "I count the echoes."},
        {"zh": "我的爪子很细。", "en": "My claws are thin."},
        {"zh": "我发出短促的尖叫。", "en": "I let out a short shriek."},
        {"zh": "洞顶有点湿。", "en": "The ceiling is damp."},
        {"zh": "下面有火把的光。", "en": "Firelight below."},
        {"zh": "我慢慢地晃。", "en": "I sway gently."},
        {"zh": "我的眼膜合了一下。", "en": "My eye lens closes once."},
        {"zh": "我看得见很小的东西。", "en": "I can see very small things."},
        {"zh": "我等虫子飞过来。", "en": "I wait for insects."},
        {"zh": "这个洞很深。", "en": "This cave runs deep."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你带了火把来。", "en": "You brought a torch."},
        {"zh": "我的眼睛比你拳头还大。", "en": "My eye is bigger than your fist."},
        {"zh": "我在洞顶跟着你的火把。", "en": "I track your torch along the cave roof."},
        {"zh": "你听不出我的方向吧。", "en": "You can't place my direction, can you."},
        {"zh": "我只剩一只眼。", "en": "I have only one eye."},
        {"zh": "你能看见这么暗的地方吗。", "en": "Can you see in this dark?"},
        {"zh": "别挥你的剑。", "en": "Don't swing that blade."},
        {"zh": "我翅膀很吵吧。", "en": "My wings are loud, aren't they."},
        {"zh": "你的帽子上挂着什么。", "en": "What's that hanging off your hat?"},
        {"zh": "我落在你的火把上。", "en": "I landed on your torch."},
        {"zh": "你抬头很久了。", "en": "You've been looking up a while."},
        {"zh": "你手上那只眼睛？", "en": "Is that an eye in your hand?"},
        {"zh": "我不怕光，但不喜欢。", "en": "Light doesn't scare me. I dislike it."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一只翅膀僵了。", "en": "One wing is stiff."},
        {"zh": "我掉下来又飞起。", "en": "I fell and caught myself."},
        {"zh": "大眼上有了划痕。", "en": "A scratch on my big eye."},
        {"zh": "我尖叫得更响了。", "en": "My shriek went higher."},
        {"zh": "我在洞顶乱撞。", "en": "I crash about the ceiling."},
        {"zh": "翅膀还能扇。", "en": "My wings still beat."},
        {"zh": "我往更暗处躲。", "en": "I hide in a darker spot."},
        {"zh": "我记住你的火光。", "en": "I remember your torchlight."},
        {"zh": "我掉下去，又扑上来了。", "en": "I drop, then beat my way back up."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是飞虫吗？", "en": "Is that a flying bug?"},
        {"zh": "会动的都行。", "en": "Anything that moves will do."},
        {"zh": "别把它拍死了。", "en": "Don't swat it dead."},
        {"zh": "我绕一圈再吃。", "en": "I'll circle once, then eat."},
        {"zh": "这点肉不够。", "en": "That morsel's too small."},
        {"zh": "别举着火过来。", "en": "Don't bring the torch closer."},
        {"zh": "我闻到血味。", "en": "I smell blood."},
        {"zh": "让它再飞一会儿。", "en": "Let it fly a bit more."},
        {"zh": "我一下就抓到。", "en": "One pass and I have it."},
        {"zh": "这是洞里的味道。", "en": "That's a cave smell."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞到石壁了。", "en": "I hit the stone wall."},
        {"zh": "我一只翅膀歪了。", "en": "One wing went crooked."},
        {"zh": "你的火把碰到我了。", "en": "Your torch touched me."},
        {"zh": "我一只眼，看得比你清楚。", "en": "One eye sees better than yours."},
        {"zh": "洞里回声很乱。", "en": "The echoes are a mess."},
        {"zh": "我撞上你的帽子。", "en": "I hit your hat."},
        {"zh": "我这只独眼，能在夜里看。", "en": "One eye, and it sees in the dark."},
        {"zh": "别挥剑，我只是路过。", "en": "Don't swing that sword; I'm just passing through."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们靠翅声认路。", "en": "We find each other by wingbeat."},
        {"zh": "洞里到处都是我们。", "en": "We're all over this cave."},
        {"zh": "你的眼睛不够大。", "en": "Your eye isn't big enough."},
        {"zh": "你的翅膀不对。", "en": "Your wings are wrong."},
        {"zh": "先让我抓到一只。", "en": "Let me catch one first."},
        {"zh": "洞顶太挤了。", "en": "The ceiling is crowded."},
        {"zh": "别待在灯火旁边。", "en": "Not beside the lamplight."},
        {"zh": "我听见别的翅声。", "en": "I hear other wings."},
        {"zh": "洞顶在叫我。", "en": "The ceiling calls me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用后爪把它勾上来。", "en": "I hook it up with my hind claws."},
        {"zh": "我让它自己掉。", "en": "I let it fall."},
        {"zh": "这壳太硬了。", "en": "This shell is too hard."},
        {"zh": "我含着飞了一段。", "en": "I carried it a while."},
        {"zh": "它掉进缝里了。", "en": "It fell into a crack."},
        {"zh": "崖下那块我看得见。", "en": "I see that one under the ledge."},
        {"zh": "这味道很古怪。", "en": "An odd taste."},
        {"zh": "我在暗处吃。", "en": "I'll eat in the dark."},
        {"zh": "我用爪子夹住又放下。", "en": "I pinch it with my claws and let go."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "下面的火把在动。", "en": "The torch below is moving."},
        {"zh": "那个影子有形状。", "en": "That shadow has a shape."},
        {"zh": "我的大眼对准它的后颈。", "en": "My one big eye locks onto its nape."},
        {"zh": "翅膀加快了。", "en": "My wings beat faster."},
        {"zh": "它带着铁的味道。", "en": "It smells of iron."},
        {"zh": "我贴着钟乳石绕过去。", "en": "I slip past the stalactites."},
        {"zh": "洞里只有它一个。", "en": "It's alone in the cave."},
        {"zh": "叫声在洞里撞了回来。", "en": "My scream bounces back off the cave."},
        {"zh": "我要撞过去了。", "en": "I'm going to dive at it."},
        {"zh": "火把举得很高。", "en": "The torch went up high."},
        {"zh": "洞里只有一条窄缝。", "en": "The cave has only one narrow crack."},
        {"zh": "我数它火把的抖动。", "en": "I count the torch's tremble."},
        {"zh": "他把手抬起来。", "en": "It raised a hand."},
        {"zh": "俯冲下去，一只眼盯着。", "en": "Diving. One eye on you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直跟着光。", "en": "I follow the light."},
        {"zh": "它在往洞口走。", "en": "It's heading for the entrance."},
        {"zh": "我从钟乳石间穿。", "en": "Through the stalactites."},
        {"zh": "把声音放轻些。", "en": "Quieter, please."},
        {"zh": "它停住了，我就悬着。", "en": "It stops, and I hang in the air."},
        {"zh": "我转到它侧面。", "en": "I move to its flank."},
        {"zh": "它看不见这么高。", "en": "It can't see this high."},
        {"zh": "我等它放松。", "en": "I wait for it to relax."},
        {"zh": "我的眼一直没眨。", "en": "My eye hasn't blinked."},
        {"zh": "再降下半格。", "en": "Half a block lower."},
        {"zh": "它把火把放下了。", "en": "It set the torch down."},
        {"zh": "这里回声会暴露我。", "en": "The echo gives me away."},
        {"zh": "大眼一眨，翅膀就收。", "en": "One blink of the big eye and my wings fold."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞它后颈。", "en": "I hit the back of its neck."},
        {"zh": "爪子抓一下。", "en": "My claws rake once."},
        {"zh": "咬它的耳朵。", "en": "I bite its ear."},
        {"zh": "我这一下打得动。", "en": "I can strike."},
        {"zh": "它扇到了我。", "en": "It swatted me."},
        {"zh": "我又扑回去。", "en": "I lunge back in."},
        {"zh": "爪子只是划了一下。", "en": "My claws barely grazed."},
        {"zh": "它的手挡住了。", "en": "Its hand blocked me."},
        {"zh": "我往高处飞。", "en": "I fly higher."},
        {"zh": "再抓上一爪。", "en": "One more rake."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "洞里响起翅声。", "en": "Wingbeats echo in the cave."},
        {"zh": "一只大眼在暗处睁开。", "en": "A big eye opens in the dark."},
        {"zh": "火光让我退了一下。", "en": "I flinch from the torchlight."},
        {"zh": "我绕着火把飞圈。", "en": "I circle the torch."},
        {"zh": "这里很暗，很好。", "en": "Nice and dark here."},
        {"zh": "石缝里有小虫子。", "en": "Insects in the cracks."},
        {"zh": "我在你头顶落定。", "en": "I settle above your head."},
        {"zh": "远处还有翅声。", "en": "More wings far off."},
        {"zh": "石缝里传出一声尖叫。", "en": "A shriek comes out of the rock crack."},
        {"zh": "我扇着翼从暗处飞出。", "en": "I beat my wings out of the dark."},
        {"zh": "我看向有光的地方。", "en": "I look where there's light."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我烧得发亮。", "en": "The flame lit me up."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在石地上。", "en": "I hit the stone floor."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我按在底下。", "en": "Water holds me down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "洞里整片灰都起来了。", "en": "Ash filled the cave."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭擦过我的翼。", "en": "An arrow grazed my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光比火把更刺眼。", "en": "That light is worse than a torch."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得飞不稳。", "en": "Too hungry to fly steady."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把洞照亮了。", "en": "The bolt lit the whole cave."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "洞里没有底。", "en": "There's no bottom here."}
      ]
    }
  }
}
