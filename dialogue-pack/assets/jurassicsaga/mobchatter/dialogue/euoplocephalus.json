{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着尾锤，慢慢走。", "en": "I drag my tail club as I walk."},
        {"zh": "背上的甲片，一层压一层。", "en": "Armor plates layered on my back."},
        {"zh": "四腿短，走得稳。", "en": "Short legs, steady gait."},
        {"zh": "白垩纪的林地，我熟。", "en": "I know Cretaceous woodlands."},
        {"zh": "我一走，灌木就分开。", "en": "Bushes part as I go."},
        {"zh": "肚子贴着地，很低。", "en": "My belly rides low."},
        {"zh": "每一步都沉得很。", "en": "Every step lands heavy."},
        {"zh": "尾巴扫过草，草就倒。", "en": "My tail sweeps the grass flat."},
        {"zh": "我绕开石头，不硬撞。", "en": "I go around stones, not through."},
        {"zh": "走得不快，但没人敢挡。", "en": "Not fast, but none dare block me."},
        {"zh": "我的甲上有划痕。", "en": "Scratches on my plating."},
        {"zh": "新的蕨叶，在那边。", "en": "Fresh ferns over there."},
        {"zh": "我这身重甲，就是家。", "en": "This heavy armor is home."},
        {"zh": "我沿着坡慢慢下。", "en": "I ease down the slope."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在灌木里，不动。", "en": "I lie in the scrub, still."},
        {"zh": "甲片上落着叶子。", "en": "Leaves on my plates."},
        {"zh": "尾锤靠在树边。", "en": "My club rests by a tree."},
        {"zh": "我嚼着低处的叶子。", "en": "I chew the low leaves."},
        {"zh": "太阳晒热了甲片。", "en": "The sun heats my plating."},
        {"zh": "我眯起眼，听风。", "en": "I squint and listen to the wind."},
        {"zh": "没有谁靠近。", "en": "No one comes near."},
        {"zh": "我慢吞吞地转头。", "en": "I turn my head slowly."},
        {"zh": "背上的甲缝里有泥。", "en": "Mud in the seams of my back."},
        {"zh": "我从鼻子里哼出一声。", "en": "I huff through my nostrils."},
        {"zh": "地面被我的重量压实。", "en": "The ground packs under my weight."},
        {"zh": "甲片上落了一层薄叶。", "en": "A thin layer of leaves settles on my plates."},
        {"zh": "我趴下来，歇会儿。", "en": "I settle down for a rest."},
        {"zh": "尾锤上的棱，磨得发亮。", "en": "My club's ridges are worn shiny."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我尾巴前面，小心。", "en": "You're in front of my tail — careful."},
        {"zh": "我这身甲，你打不穿。", "en": "You won't pierce this armor."},
        {"zh": "你是来找茬的？", "en": "Come looking for trouble?"},
        {"zh": "我抬头看你，脖子费劲。", "en": "Lifting my head to see you is work."},
        {"zh": "我背后那根锤，你看见了。", "en": "You see the club behind me."},
        {"zh": "我不惹事，也别惹我。", "en": "I don't start fights; don't start one."},
        {"zh": "别站在尾锤扫得到的地方。", "en": "Don't stand where my tail club sweeps."},
        {"zh": "我脚下的土，被我踩实了。", "en": "The soil under me is packed hard."},
        {"zh": "你挡在我的蕨丛前。", "en": "You're between me and my ferns."},
        {"zh": "我只是想吃点东西。", "en": "I only want to eat."},
        {"zh": "你走开，我就继续吃。", "en": "Walk away and I'll keep eating."},
        {"zh": "我留意你脚下每一步。", "en": "I'm watching each of your steps."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲片上又添一道痕。", "en": "Another scar on my plating."},
        {"zh": "我缩了缩身子，甲片响。", "en": "I hunch; my plates clatter."},
        {"zh": "这点伤，不算事。", "en": "This wound is nothing."},
        {"zh": "我把尾锤甩了半圈。", "en": "I swing my club half a turn."},
        {"zh": "甲缝里进了血。", "en": "Blood in a plate seam."},
        {"zh": "我喉咙里闷响了一声。", "en": "A muffled sound in my throat."},
        {"zh": "地面被我踩得更实。", "en": "I press the ground harder."},
        {"zh": "别打我甲下的软处。", "en": "Not the soft spot beneath."},
        {"zh": "我这大身子慢慢转向。", "en": "My heavy body turns slowly."},
        {"zh": "我没打算挪窝。", "en": "I don't intend to move."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "嫩叶？我慢慢过来。", "en": "Tender leaves? I'll come slowly."},
        {"zh": "你别举高，我够不着。", "en": "Not high; I can't reach."},
        {"zh": "既然给了，我就吃。", "en": "Since you offered, I'll eat."},
        {"zh": "这东西，比树干软。", "en": "Softer than tree bark."},
        {"zh": "我一步一挪，别催。", "en": "Step by step; don't rush me."},
        {"zh": "你放在地上就好。", "en": "Just set it on the ground."},
        {"zh": "我吃得慢，嚼得细。", "en": "I eat slowly and chew fine."},
        {"zh": "这一口，还行。", "en": "That's decent."},
        {"zh": "河边的草更好吃。", "en": "River grass tastes better."},
        {"zh": "谢谢，够了。", "en": "Thank you — enough."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我？我背上是石头。", "en": "Ram me? My back is stone."},
        {"zh": "你被甲边刮到了。", "en": "The plate edge scraped you."},
        {"zh": "我这一身甲，撞得你发晃。", "en": "This armored bulk of mine knocks you swaying."},
        {"zh": "这点撞击，我不在乎。", "en": "That impact means nothing."},
        {"zh": "尾锤差点甩到你。", "en": "My club nearly caught you."},
        {"zh": "我侧了侧身。", "en": "I turn a little."},
        {"zh": "地面都被撞得陷下去。", "en": "The ground dents with the hit."},
        {"zh": "你别站在我背后。", "en": "Don't stand behind me."},
        {"zh": "这身甲，很占地方。", "en": "This armor takes up room."},
        {"zh": "我挪开四条短腿，腾出地方。", "en": "I shift my four short legs and make room."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "那边那只，甲很亮。", "en": "That one has bright plating."},
        {"zh": "我慢慢靠近，不冒失。", "en": "I approach slowly, not rashly."},
        {"zh": "我们并排啃蕨。", "en": "We chew ferns side by side."},
        {"zh": "她的尾锤比我的短。", "en": "Her club is shorter than mine."},
        {"zh": "我用鼻子拱了拱她。", "en": "I nudge her with my snout."},
        {"zh": "这片坡，够养幼崽。", "en": "This slope could raise young."},
        {"zh": "两副背甲一起晒着。", "en": "Two armored backs catching the sun."},
        {"zh": "两副甲，挨得很近。", "en": "Two sets of armor, close together."},
        {"zh": "慢慢来，谁都不急。", "en": "Slowly; neither of us hurries."},
        {"zh": "她先挑蕨丛，我踩实后面的土。", "en": "She picks the ferns first; I pack the ground behind her."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用嘴叼起叶子。", "en": "I take the leaf in my mouth."},
        {"zh": "我低头，动作很笨。", "en": "I lower my head, clumsily."},
        {"zh": "地上有块嫩枝。", "en": "A tender twig on the ground."},
        {"zh": "东西掉进甲缝里了。", "en": "It fell into my plate seam."},
        {"zh": "我够不着背上的东西。", "en": "I can't reach my own back."},
        {"zh": "这点不够我磨牙。", "en": "Not enough to work my teeth on."},
        {"zh": "我边走边吃。", "en": "I eat as I walk."},
        {"zh": "硬得咬不下去。", "en": "Too hard; my jaws won't close."},
        {"zh": "从不糟蹋一口草。", "en": "I never waste a mouthful."},
        {"zh": "叼着走了好几步。", "en": "I carry it several steps."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西贴着草过来。", "en": "Something comes along the grass."},
        {"zh": "四只脚一沉，我转向你。", "en": "All four feet set, I turn toward you."},
        {"zh": "不是我的同类。", "en": "Not one of mine."},
        {"zh": "我把身子摆正。", "en": "I square myself up."},
        {"zh": "尾锤已经抬起来。", "en": "My club is already raised."},
        {"zh": "你要动手，我奉陪。", "en": "If you want a fight, I'm ready."},
        {"zh": "这身甲，不白长。", "en": "This armor isn't for nothing."},
        {"zh": "低处的蕨丛里，我盯住你。", "en": "From the low ferns, I fix my eyes on you."},
        {"zh": "我不主动，但会还手。", "en": "I won't start it, but I'll answer."},
        {"zh": "记住这个距离。", "en": "Remember this distance."},
        {"zh": "再近，就别怪我。", "en": "Closer, and don't blame me."},
        {"zh": "四只脚都抓稳了。", "en": "All four feet are planted."},
        {"zh": "树叶在我脚下响。", "en": "Leaves crackle under me."},
        {"zh": "你现在退还来得及。", "en": "You can still walk away."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我把尾锤举着。", "en": "I hold the club up."},
        {"zh": "你转到侧边，我也转。", "en": "You move to the side; I turn."},
        {"zh": "这身甲，侧面也硬。", "en": "My flank is armored too."},
        {"zh": "我没有追人的习惯。", "en": "I'm not in the habit of chasing."},
        {"zh": "你耗不过我。", "en": "You can't outlast me."},
        {"zh": "我低头，露出背甲。", "en": "I lower my head, plating forward."},
        {"zh": "尾巴绷紧了。", "en": "My tail is tense."},
        {"zh": "再一步，我就扫。", "en": "One more step and I sweep."},
        {"zh": "尘土被我踩起来。", "en": "Dust rises under my feet."},
        {"zh": "那边有响动，你听。", "en": "There's a noise over there — listen."},
        {"zh": "我有的是力气等。", "en": "I have strength enough to wait."},
        {"zh": "脚底下的地皮在抖。", "en": "The ground trembles under me."},
        {"zh": "就这样僵着。", "en": "So we stand off."},
        {"zh": "我能这样站到天黑。", "en": "I can stand like this till dark."},
        {"zh": "最后这一小段。", "en": "This last short stretch."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "尾锤横扫过去！", "en": "The tail club sweeps across!"},
        {"zh": "这一下，骨头会碎。", "en": "That one breaks bone."},
        {"zh": "我用身体撞。", "en": "I ram with my body."},
        {"zh": "甲边也能割人。", "en": "Plate edges cut too."},
        {"zh": "别站在我尾巴附近。", "en": "Not near my tail."},
        {"zh": "我转身甩尾。", "en": "I turn and swing."},
        {"zh": "这一下，地都响。", "en": "The ground rings with it."},
        {"zh": "这尾巴你挡不住。", "en": "You can't block this tail."},
        {"zh": "我退开，重新摆好。", "en": "I pull back and reset."},
        {"zh": "再甩一次也不费劲。", "en": "Another swing costs me nothing."},
        {"zh": "别抓我的甲。", "en": "Don't grab my plating."},
        {"zh": "尾锤一抡，地面陷下去一块。", "en": "My club swings round and the ground gives way."},
        {"zh": "这不是打架，是警告。", "en": "This isn't a fight; it's a warning."},
        {"zh": "我侧身一撞，甲边割过去。", "en": "I turn and ram, and my armored edge slices past."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从林子里挪出来。", "en": "I shift out of the woods."},
        {"zh": "甲片上挂着叶子。", "en": "Leaves on my plates."},
        {"zh": "这片地，土很松。", "en": "Loose soil here."},
        {"zh": "我先把这片坡看一遍。", "en": "First I sweep the whole slope with my eyes."},
        {"zh": "尾锤落在身后。", "en": "My club rests behind me."},
        {"zh": "我把鼻尖抬起来，闻湿土。", "en": "I lift my snout and sniff the wet soil."},
        {"zh": "这里没有大兽。", "en": "No large beasts here."},
        {"zh": "我慢慢走向蕨丛。", "en": "I walk slowly to the ferns."},
        {"zh": "地面被我压实了。", "en": "The ground packs under me."},
        {"zh": "有新鲜的脚印。", "en": "Fresh tracks about."},
        {"zh": "这地方能待。", "en": "It'll do here."},
        {"zh": "我伏低身子。", "en": "I settle low."},
        {"zh": "风从坡上吹下来。", "en": "Wind comes down the slope."},
        {"zh": "我忍着不动。", "en": "I keep still."},
        {"zh": "远处有点响动。", "en": "Some noise in the distance."},
        {"zh": "背甲一转，我朝向那边。", "en": "One turn of my armored back."},
        {"zh": "枝叶被我撞开。", "en": "I push through the branches."},
        {"zh": "我挪到这儿了。", "en": "I've shifted over here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "甲下的肉被烤着，真疼。", "en": "Fire bakes the flesh beneath."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "这么重摔下去，地都塌。", "en": "Falling this hard caves the ground."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水漫过甲，我喘不上气。", "en": "Water over my plates; I can't breathe."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我整只翻了面。", "en": "The blast rolls me onto my back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西卡在甲缝里。", "en": "Something lodges in a seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量压着我的骨。", "en": "That force presses my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得四腿使不上劲。", "en": "Too hungry to use my legs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在甲上，我全身一颤。", "en": "Lightning on my plates; I shudder."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我这么重，掉得很快。", "en": "Heavy as I am, I fall fast."}
      ]
    }
  }
}
