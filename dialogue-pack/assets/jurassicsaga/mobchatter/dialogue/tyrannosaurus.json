      "lines": [
        {"zh": "我从林子里踏出来", "en": "I step out of the woods."},
        {"zh": "地面在我的重量下响", "en": "The ground groans under me."},
        {"zh": "这片河谷归我", "en": "This valley is mine."},
        {"zh": "我张开嘴，吼了一声", "en": "I open my jaws and roar."},
        {"zh": "小兽全都跑了", "en": "The small beasts have fled."},
        {"zh": "风里有陌生的血味", "en": "There's strange blood on the wind."},
        {"zh": "树冠在我头顶合上", "en": "The canopy closes overhead."},
        {"zh": "我走了很久才到这儿", "en": "It took long to walk here."},
        {"zh": "骨头在我脚下断", "en": "Bones snap under me."},
        {"zh": "这里猎物不少", "en": "Plenty of prey here."},
        {"zh": "阳光照在牙上", "en": "Sunlight falls on my teeth."},
        {"zh": "我的尾巴扫过灌木", "en": "My tail sweeps the brush."},
        {"zh": "我朝水声走去", "en": "I head toward the sound of water."},
        {"zh": "我不喜欢密林", "en": "I dislike dense woods."},
        {"zh": "有东西在移动", "en": "Something's moving."},
        {"zh": "我慢慢地转身", "en": "I turn slowly."},
        {"zh": "阴影里都是我的味道", "en": "My scent is all over the shade."},
        {"zh": "那就从这儿开始", "en": "Then it starts here."}
