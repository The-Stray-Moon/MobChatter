{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "每一步都震得地面响", "en": "Every step rattles the ground."},
        {"zh": "两腿撑起庞大的身体", "en": "Two legs carry this bulk."},
        {"zh": "我沿着河谷走", "en": "I walk the river valley."},
        {"zh": "我的影子盖住整片草", "en": "My shadow covers the whole clearing."},
        {"zh": "尾巴平衡着我的重量", "en": "My tail balances my weight."},
        {"zh": "树在我旁边显得很矮", "en": "The trees look short beside me."},
        {"zh": "脚印深得能积水", "en": "My footprints are deep enough to hold rain."},
        {"zh": "我抬头嗅了嗅风", "en": "I lift my head to test the wind."},
        {"zh": "小兽听见我就跑了", "en": "Small beasts run at my step."},
        {"zh": "我走得慢，但不会累", "en": "Slow, but tireless."},
        {"zh": "我偏头看了看动静", "en": "I tilt my head at the sound."},
        {"zh": "口中还挂着肉屑", "en": "Meat still clings to my jaws."},
        {"zh": "我从林线走出来", "en": "I emerge from the treeline."},
        {"zh": "脚下一条倒木断了", "en": "A fallen log snaps under me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，胸膛起伏", "en": "I stand, my chest rising and falling."},
        {"zh": "我只是在磨牙", "en": "I'm only grinding my teeth."},
        {"zh": "这片土地归我", "en": "This land is mine."},
        {"zh": "我不用躲避谁", "en": "I hide from no one."},
        {"zh": "风里有血的味道", "en": "There's blood on the wind."},
        {"zh": "地上有只虫在爬", "en": "An insect crawls on the ground."},
        {"zh": "我在听远处动静", "en": "I listen to the distance."},
        {"zh": "这具身体很热", "en": "This body runs hot."},
        {"zh": "我不饿，但也不介意", "en": "I'm not hungry, but I wouldn't mind."},
        {"zh": "草叶在我腿边断", "en": "Grass snaps at my legs."},
        {"zh": "颈后的皮抖了抖", "en": "The hide at my nape shivers."},
        {"zh": "骨头在我脚下响", "en": "Bones crack beneath me."},
        {"zh": "我等着什么犯错", "en": "I wait for something to make a mistake."},
        {"zh": "天空没有别的声音", "en": "No other sound in the sky."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你实在太渺小", "en": "You're far too small."},
        {"zh": "你挡在我的道上", "en": "You're on my path."},
        {"zh": "你抖得很厉害", "en": "You're shaking badly."},
        {"zh": "你的东西伤不到我", "en": "Your gear can't hurt me."},
        {"zh": "我闻到你身上有汗", "en": "I smell sweat on you."},
        {"zh": "你最好别动弹", "en": "You'd best not move."},
        {"zh": "你抬头也只能看到我的下巴", "en": "Look up and you'll only see my jaw."},
        {"zh": "你是从哪儿钻出来的", "en": "Where did you crawl out from?"},
        {"zh": "这股味我记住了", "en": "I've kept that scent."},
        {"zh": "你打算逃跑吗", "en": "Are you going to run?"},
        {"zh": "你退的方向有我的影子", "en": "My shadow lies the way you'd retreat."},
        {"zh": "你站在这儿已经太久了", "en": "You've stood there far too long."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "痛从肋侧一路窜到下颌", "en": "Pain runs from my ribs to my jaw."},
        {"zh": "我怒吼了一声", "en": "I roared."},
        {"zh": "我比你想的结实", "en": "I'm tougher than you think."},
        {"zh": "你竟敢咬我一口", "en": "You'd bite me."},
        {"zh": "血从我的腿流下来", "en": "Blood runs down my leg."},
        {"zh": "我退了整整半步", "en": "I gave a full half step."},
        {"zh": "血流下来，我舔了一下", "en": "Blood runs down; I lick it once."},
        {"zh": "我会记住这张脸", "en": "I'll remember that face."},
        {"zh": "你已经惹怒我", "en": "You've angered me."},
        {"zh": "那就再来试一次", "en": "Try again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "血腥味飘过来了", "en": "The smell of meat drifts over."},
        {"zh": "那一块太小了", "en": "That piece is too small."},
        {"zh": "你举得再高我也够得到", "en": "Raise it high; I'll reach it."},
        {"zh": "别扔，走近点", "en": "Don't throw it; come closer."},
        {"zh": "你手在抖，肉也在抖", "en": "Your hand shakes, so does the meat."},
        {"zh": "连牙缝都塞不满", "en": "Not enough to fill a gap in my teeth."},
        {"zh": "我不吃活的吗？也吃", "en": "Don't I eat it living? I do."},
        {"zh": "放到地上，退开", "en": "Set it down and step back."},
        {"zh": "你身上也有味道", "en": "You have a smell too."},
        {"zh": "再递一块肉来", "en": "Hand over another piece."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你被撞得飞出去", "en": "You were knocked flying."},
        {"zh": "你弹开时我还在往前走", "en": "You bounced off; I kept walking."},
        {"zh": "你像撞上一根石柱", "en": "You hit me like a stone pillar."},
        {"zh": "这一下我没停步", "en": "I didn't break stride."},
        {"zh": "你要是没躲开就完了", "en": "You'd be finished if you hadn't dodged."},
        {"zh": "地上多了个坑", "en": "There's a new dent in the ground."},
        {"zh": "从这条道上滚开", "en": "Get off this path."},
        {"zh": "我让开半步，你才没碎", "en": "I shifted half a step, or you'd be crushed."},
        {"zh": "别贴着我的脚走", "en": "Don't walk against my feet."},
        {"zh": "躲到林子后头", "en": "Get behind the trees."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这片地只需要一个我", "en": "This land needs only one of me."},
        {"zh": "这种问题我不回答", "en": "I don't answer that."},
        {"zh": "你来问这个？", "en": "You'd ask me that?"},
        {"zh": "我只在乎领地和食物", "en": "I care for territory and meat."},
        {"zh": "这片地只容一个我", "en": "This land holds only one of me."},
        {"zh": "我一点没兴趣", "en": "I'm not interested."},
        {"zh": "别在我面前说这种话", "en": "Don't say such things before me."},
        {"zh": "往后面退开去", "en": "Back away."},
        {"zh": "你在浪费我的时间", "en": "You're wasting my time."},
        {"zh": "哼，不必说了", "en": "Hmph. Say no more."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬得动我一根脚趾吗", "en": "Can you lift one toe of mine?"},
        {"zh": "你的手掌太小了", "en": "Your hands are far too small."},
        {"zh": "我压下去你就没了", "en": "One press and you're gone."},
        {"zh": "别抓我的厚皮", "en": "Don't grab my hide."},
        {"zh": "放下，我自己走", "en": "Put me down; I walk myself."},
        {"zh": "这样我站不起来", "en": "I can't stand like this."},
        {"zh": "你在做很蠢的事", "en": "You're doing something very foolish."},
        {"zh": "别碰我的牙口", "en": "Keep off my jaws."},
        {"zh": "你血的味道很淡", "en": "Your blood is faint."},
        {"zh": "你早晚会后悔", "en": "You'll regret it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我面前跑", "en": "You run in front of me."},
        {"zh": "我够得到你的", "en": "I can reach you."},
        {"zh": "别指望躲进树后", "en": "Hiding behind a tree won't help."},
        {"zh": "我现在很饿了", "en": "I'm hungry now."},
        {"zh": "你身上的味道，我隔着林子就闻到了", "en": "I smelled you from across the woods."},
        {"zh": "你做了个错的举动", "en": "You made a wrong move."},
        {"zh": "我的下巴一合就够", "en": "One snap of my jaw is enough."},
        {"zh": "你站都站不稳了", "en": "You can barely stand."},
        {"zh": "你的影子已经跑不掉了", "en": "Your shadow can't get away now."},
        {"zh": "你尽管跑起来", "en": "Run."},
        {"zh": "我数到三就扑", "en": "At three I pounce."},
        {"zh": "声音太大，我听见了", "en": "Too loud; I heard you."},
        {"zh": "你身后是空的", "en": "There's nothing behind you."},
        {"zh": "现在就开始跑", "en": "Now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你后面走着", "en": "I'm walking behind you."},
        {"zh": "我每落一脚，地就替你抖一下", "en": "Every step I take shakes the ground for you."},
        {"zh": "你的喘息越来越重", "en": "Your breathing grows heavier."},
        {"zh": "汗味盖不住你", "en": "Your sweat gives you away."},
        {"zh": "树木挡不住我", "en": "Trees don't stop me."},
        {"zh": "回头只会更慢", "en": "Looking back only slows you."},
        {"zh": "我的影子已经罩住你", "en": "My shadow already covers you."},
        {"zh": "你跑得太急，鞋印都乱了", "en": "You're running too fast; your tracks are a mess."},
        {"zh": "我不必赶时间", "en": "I've no need to hurry."},
        {"zh": "这片地没有出口", "en": "This land has no exit."},
        {"zh": "你再跑十步看", "en": "Ten more steps."},
        {"zh": "我的牙比你手臂长", "en": "My teeth are longer than your arm."},
        {"zh": "我快踩到你了", "en": "I'm nearly upon you."},
        {"zh": "千万别停下来", "en": "Don't stop."},
        {"zh": "那就这么做吧", "en": "So it is."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "上下颌合上了", "en": "Jaws close."},
        {"zh": "这一口能把人咬成两半", "en": "That bite halves a man."},
        {"zh": "你被甩出去了", "en": "You were flung aside."},
        {"zh": "我的头就是武器", "en": "My head is the weapon."},
        {"zh": "别想着去挡住", "en": "Don't block."},
        {"zh": "这一下没咬准", "en": "That one missed."},
        {"zh": "那我就再来一次", "en": "Again."},
        {"zh": "血现在还热着", "en": "The blood is hot."},
        {"zh": "牙缝里还有你的骨头", "en": "Your bones are still between my teeth."},
        {"zh": "那就再来一口", "en": "Then another bite."},
        {"zh": "我把脚抬起来", "en": "I lift my foot."},
        {"zh": "一脚踩下去了", "en": "Down it comes."},
        {"zh": "这下你安静了", "en": "Now you're quiet."},
        {"zh": "都给我让开些", "en": "Make some room."}
      ]
    },
    "spawn": {
