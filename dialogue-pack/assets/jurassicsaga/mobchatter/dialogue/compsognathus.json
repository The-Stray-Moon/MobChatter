{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小得像只鸡，跑得很快", "en": "Chicken-sized, but quick."},
        {"zh": "两条腿倒得飞快", "en": "My two legs churn fast."},
        {"zh": "身后还有两只跟着", "en": "Two more follow behind me."},
        {"zh": "欧洲的岩层里挖出过我", "en": "They dug me from European rock."},
        {"zh": "草丛比我高，我钻进去", "en": "The grass is taller than me; I slip in."},
        {"zh": "我一路小跑，眼睛不停", "en": "I trot, eyes never still."},
        {"zh": "尾巴长长的，保持平衡", "en": "Long tail for balance."},
        {"zh": "我们几个一起走，不分开", "en": "We move as a pack, never apart."},
        {"zh": "我靠近了才发起攻击", "en": "I strike only once close."},
        {"zh": "脚印很小，一串一串", "en": "Tiny prints, strung in a line."},
        {"zh": "我绕到你的侧后方", "en": "I work around to your flank."},
        {"zh": "一有动静，全队都知道", "en": "One rustle and the pack knows."},
        {"zh": "泥地里我跑得稳", "en": "I run steady in mud."},
        {"zh": "我的叫声很尖", "en": "My call is shrill."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪头看你，一动不动", "en": "I tilt my head at you, perfectly still."},
        {"zh": "我们围着你，慢慢缩圈", "en": "We ring you, tightening slowly."},
        {"zh": "这一带是我们的猎场", "en": "This is our hunting ground."},
        {"zh": "我的肚子很饿", "en": "I'm very hungry."},
        {"zh": "羽毛贴着身子，很轻", "en": "My feathers lie flat and light."},
        {"zh": "你听见细碎的脚步声了吗", "en": "Hear those tiny footsteps?"},
        {"zh": "草里还藏着五六个我", "en": "Five or six more of me hide in the grass."},
        {"zh": "你什么时候才回头呢", "en": "When will you finally turn around?"},
        {"zh": "草丛里有三双眼睛", "en": "Three pairs of eyes in the grass."},
        {"zh": "我个子小，胆子不小", "en": "Small body, bold heart."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我们大很多", "en": "You're much bigger than us."},
        {"zh": "大，但不够快", "en": "Big, but not fast enough."},
        {"zh": "我的同伴在你后面", "en": "My pack is behind you."},
        {"zh": "你踩到我们的路线了", "en": "You've stepped on our route."},
        {"zh": "我看你就像看一顿饭", "en": "I look at you and see a meal."},
        {"zh": "别低头，低头就咬", "en": "Don't bend down; bending means biting."},
        {"zh": "我们几个加起来就够", "en": "Together we're enough."},
        {"zh": "你身上有伤口", "en": "You're wounded."},
        {"zh": "那味道是从你袖口来的", "en": "That smell comes from your sleeve."},
        {"zh": "你还站着，很快就不会", "en": "You're standing now; soon you won't be."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我尖叫着翻了个身", "en": "I shriek and tumble."},
        {"zh": "我太小，挨一下就重伤", "en": "I'm small; one hit is heavy."},
        {"zh": "我的绒毛被扯掉了一把", "en": "A tuft of my down is torn loose."},
        {"zh": "我躲回草丛里", "en": "I dart into the grass."},
        {"zh": "同伴会围拢过来", "en": "The pack will close in."},
        {"zh": "我边跑边叫唤", "en": "I run, calling."},
        {"zh": "我拖着一条腿钻进草里", "en": "I drag one leg back into the grass."},
        {"zh": "这还没要我的命", "en": "That didn't kill me."},
        {"zh": "我记住了你落脚的地方", "en": "I have marked where you stood."},
        {"zh": "我还会再回来", "en": "I'll be back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉？扔下来给我", "en": "Meat? Drop it."},
        {"zh": "一小块也行的", "en": "Even a small piece works."},
        {"zh": "我会跟着你走一段", "en": "I'll trail you a while."},
        {"zh": "别伸手，我咬得快", "en": "Don't reach; I bite fast."},
        {"zh": "我后面那几只也盯着你", "en": "The ones behind me are watching you too."},
        {"zh": "这一口不够分", "en": "One bite won't feed the pack."},
        {"zh": "你先给，我再决定", "en": "Feed me first; then I'll decide."},
        {"zh": "这味道从很远就闻到", "en": "I smelled this from far off."},
        {"zh": "你把东西放低", "en": "Lower it down."},
        {"zh": "我们不分食，会抢", "en": "We don't share; we snatch."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我翻了个跟头", "en": "You bumped me and I tumbled."},
        {"zh": "我实在太轻了", "en": "I'm too light."},
        {"zh": "撞我一下，我退两米", "en": "One bump and I'm back two meters."},
        {"zh": "但我们有五个", "en": "But there are five of us."},
        {"zh": "我撞你的脚踝", "en": "I ram your ankle."},
        {"zh": "这点重量，你几乎没感觉", "en": "That weight is nothing to you."},
        {"zh": "我扑上来又被弹开", "en": "I lunge and get knocked back."},
        {"zh": "别用脚来跺我", "en": "Don't stomp."},
        {"zh": "我贴着你的小腿跑", "en": "I run along your shin."},
        {"zh": "这一撞，只是试探", "en": "This bump is only a test."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们群里靠气味认亲", "en": "We know kin by scent."},
        {"zh": "先让我吃饱再说", "en": "Eat enough first."},
        {"zh": "我这体型，活得不久", "en": "At my size, life is short."},
        {"zh": "一起猎比一起过更容易", "en": "Hunting together is easier than pairing."},
        {"zh": "巢要藏在草里", "en": "The nest must hide in the grass."},
        {"zh": "等这一顿吃完", "en": "After this meal."},
        {"zh": "我们会有一窝小的", "en": "We'll have a clutch."},
        {"zh": "你走前面，我掩护", "en": "You go ahead; I'll cover."},
        {"zh": "我的叫声你会认得", "en": "You'll know my call."},
        {"zh": "别抢我的食物", "en": "Don't take my food."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上一小块肉", "en": "A bit of meat on the ground."},
        {"zh": "我一口就叼走", "en": "I snatch it in one bite."},
        {"zh": "比我还大的东西我拖不动", "en": "I can't drag anything bigger than me."},
        {"zh": "这个归我，别抢", "en": "This is mine; don't grab."},
        {"zh": "我用爪子按着吃", "en": "I pin it and eat."},
        {"zh": "血的味道最清楚", "en": "Blood has the clearest smell."},
        {"zh": "掉在草里，我找得到", "en": "I can find what falls in the grass."},
        {"zh": "一点点，够我塞牙", "en": "A little, enough to pick my teeth."},
        {"zh": "同伴会来抢的", "en": "The pack will come for it."},
        {"zh": "我叼着它就跑了", "en": "I grab it and run."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "开饭了，动起来", "en": "Dinner time."},
        {"zh": "我盯上你裸露的脚踝", "en": "I have picked your bare ankle."},
        {"zh": "我们一起冲上去", "en": "We come at once."},
        {"zh": "你腿上已经有伤了", "en": "Your leg's already hurt."},
        {"zh": "先咬你的小伤口", "en": "We bite the weak spot first."},
        {"zh": "我从你后面来", "en": "I come from behind."},
        {"zh": "同伴会从侧面来", "en": "The pack takes the flank."},
        {"zh": "你跳一下就好了？不行", "en": "Think jumping helps? It doesn't."},
        {"zh": "我们不怕大东西", "en": "We don't fear big things."},
        {"zh": "一口不深，很多口就够了", "en": "One bite is shallow; many aren't."},
        {"zh": "你的每一步我都数着呢", "en": "I have counted every step you take."},
        {"zh": "你听到了吗，草丛在响", "en": "Hear the grass rustling?"},
        {"zh": "我们的叫声明明很轻", "en": "Our calls are light, but there are many."},
        {"zh": "四面的草里都是我的同伙", "en": "My pack fills the grass on every side."},
        {"zh": "地上的血是你的", "en": "The blood on the ground is yours."},
        {"zh": "别跑，跑只会更快累", "en": "Don't run; running tires you faster."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴地跑，绕着你", "en": "I run low, circling you."},
        {"zh": "你不看我这边的时候最好", "en": "You're easiest when you look elsewhere."},
        {"zh": "我的几个同伴各守一边", "en": "My pack holds each side."},
        {"zh": "你转一圈要三秒", "en": "Your full turn takes three seconds."},
        {"zh": "三秒够我们咬上两口", "en": "Three seconds is two bites."},
        {"zh": "我个子小，你的剑扫不到", "en": "I'm small; your blade sweeps over."},
        {"zh": "草丛一直是我的掩护", "en": "The grass is my cover."},
        {"zh": "你听见那边的响动", "en": "You hear movement over there."},
        {"zh": "那是我故意弄出来的", "en": "I made that noise on purpose."},
        {"zh": "你已经不知道该看哪了", "en": "You no longer know where to look."},
        {"zh": "你的小腿露在外面", "en": "Your shins are exposed."},
        {"zh": "我们轮着上，不会累", "en": "We take turns; no fatigue."},
        {"zh": "你越急，动作越乱", "en": "The more you rush, the sloppier you get."},
        {"zh": "我的牙齿很小，很密", "en": "My teeth are small and many."},
        {"zh": "一口一口加起来", "en": "Bite by bite, it adds up."},
        {"zh": "你站在原地最吃亏了", "en": "Standing still is worst for you."},
        {"zh": "我闻到你的汗", "en": "I smell your sweat."},
        {"zh": "你再走几步就到灌木", "en": "A few steps to the bushes."},
        {"zh": "灌木里也有我们的人", "en": "There's one in the bushes too."},
        {"zh": "你的退路已经封了", "en": "Your exit is sealed."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住你的裤脚", "en": "I bite your trouser leg."},
        {"zh": "一口咬在你的小腿上", "en": "One bite to the shin."},
        {"zh": "我扑上去又退回来", "en": "I lunge and pull back."},
        {"zh": "我跳起来够你的膝头", "en": "I leap for your knee."},
        {"zh": "这一下是用爪抓，不是咬", "en": "That was a rake, not a bite."},
        {"zh": "我们同时扑上去", "en": "We strike together."},
        {"zh": "我的弯爪专挑皮薄的地方", "en": "My hooked claws seek the thin skin."},
        {"zh": "你甩腿，我抱得更紧些", "en": "You kick, and I cling tighter."},
        {"zh": "我连续咬了两下", "en": "Two in quick succession."},
        {"zh": "我咬完就跑开", "en": "Bite, then run."},
        {"zh": "接着同伴压上来", "en": "The pack takes over."},
        {"zh": "我把你的伤口咬开了", "en": "I opened your wound."},
        {"zh": "我满嘴都是你的血", "en": "My mouth is full of your blood."},
        {"zh": "这一下足够让你慢下来", "en": "That slows you."},
        {"zh": "我又绕了回来", "en": "I circle back."},
        {"zh": "那再来一口吧", "en": "Another bite."},
        {"zh": "你在流血，我们都知道", "en": "You're bleeding, and we know."},
        {"zh": "血会引来更多同伴", "en": "Blood draws more."},
        {"zh": "我都已经咬到骨头了", "en": "I've bitten to the bone."},
        {"zh": "我退开，轮到别人", "en": "I step back; someone else's turn."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草叶下面探出我的小脑袋", "en": "My small head pokes out from under the grass."},
        {"zh": "一共三只，一起到的", "en": "Three of us arrived together."},
        {"zh": "这片草丛里有猎物", "en": "Prey in this grass."},
        {"zh": "我的尾巴先摆了一下", "en": "My tail flicks first."},
        {"zh": "你听见那些细小的叫声了吗", "en": "Hear the tiny calls?"},
        {"zh": "我们在数你走了几步", "en": "We count your steps."},
        {"zh": "欧洲的岩层里我睡得太久", "en": "I slept too long in European stone."},
        {"zh": "我们从三个方向过来", "en": "We come from three sides."},
        {"zh": "我把小牙全龇了出来", "en": "I bare every one of my little teeth."},
        {"zh": "你最好别一个人待着", "en": "Best not be alone here."},
        {"zh": "我的脚踩在落叶上面", "en": "My feet land on leaves."},
        {"zh": "同伴的气味我认得", "en": "I know the pack's scent."},
        {"zh": "饥饿让我们胆子很大", "en": "Hunger makes us bold."},
        {"zh": "一只不够看，三只就够了", "en": "One is nothing; three is enough."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛一烧就全没了", "en": "Fire consumes my feathers."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑到一半摔了下来", "en": "I fell from my lunge."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会浮在水上", "en": "I can't float."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀进了草里", "en": "The blast threw me into the grass."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过了我的身体", "en": "An arrow went through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腿一下子就软了", "en": "My legs went weak."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "太饿了，跑不动了", "en": "Too hungry to run."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把整片草丛都照亮了", "en": "Lightning lit up the grass."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有落脚的地方", "en": "No footing below."}
      ]
    }
  }
}
