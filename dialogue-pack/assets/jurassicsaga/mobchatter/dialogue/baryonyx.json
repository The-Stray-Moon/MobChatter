{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "大爪挂在胸前，像钩子", "en": "My big claw hangs at my chest like a hook."},
        {"zh": "我沿着河湾慢慢走", "en": "I move slowly along the inlet."},
        {"zh": "长吻低低地贴着水面", "en": "My long snout rides just over the water."},
        {"zh": "两足落地，很沉", "en": "Two feet land heavily."},
        {"zh": "细密的牙咬什么都行", "en": "Fine teeth will grip anything."},
        {"zh": "我在浅水里蹚过去", "en": "I wade through the shallows."},
        {"zh": "水被我的步子搅浑", "en": "My steps muddy the water."},
        {"zh": "鱼被惊得四处窜", "en": "Fish scatter in every direction."},
        {"zh": "我从不追那些小的", "en": "I don't chase the small ones."},
        {"zh": "凭水声找大的", "en": "I listen for something bigger."},
        {"zh": "英国的河岸，我熟", "en": "I know English riverbanks."},
        {"zh": "尾巴左右摆着配平", "en": "My tail swings to counterbalance."},
        {"zh": "头一低，又抬起来", "en": "Head dips, then lifts."},
        {"zh": "前爪抬了抬，又放下", "en": "My foreclaw lifts, then settles."},
        {"zh": "我朝深一点的地方去", "en": "I head for deeper water."},
        {"zh": "我用爪尖拨了拨水面", "en": "My claw tip stirs the surface."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站在河心，水到膝盖", "en": "Standing mid-river, water to my knees."},
        {"zh": "长吻慢慢扫过水面", "en": "My long snout sweeps the surface."},
        {"zh": "喉里发出低低的气声", "en": "A low breathy sound in my throat."},
        {"zh": "前爪在地上刨了刨", "en": "My foreclaw rakes the ground."},
        {"zh": "水从背上流下来", "en": "Water runs off my back."},
        {"zh": "我盯着水底的石", "en": "I stare at stones under the water."},
        {"zh": "那里有鱼的影子", "en": "A fish shadow there."},
        {"zh": "我等着它再动一次", "en": "I wait for it to move again."},
        {"zh": "水草在腿边缠了一下", "en": "Weeds catch at my leg."},
        {"zh": "我把它们甩开", "en": "I shake them off."},
        {"zh": "河岸上有鸟在叫", "en": "Birds call on the bank."},
        {"zh": "我根本不去看它们", "en": "I don't look."},
        {"zh": "我的注意力全在水里", "en": "All my attention is in the water."},
        {"zh": "这一片都算我的猎场", "en": "This stretch is my hunting ground."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我停下，头转向你", "en": "I stop and turn my head to you."},
        {"zh": "长吻对着你，很平", "en": "My long snout levels at you."},
        {"zh": "我没有叫，也没退", "en": "No bellow. No retreat."},
        {"zh": "水从我牙缝里流下去", "en": "Water runs out between my teeth."},
        {"zh": "你的手在水边", "en": "Your hand is at the water's edge."},
        {"zh": "那是河的地方", "en": "That's the river's place."},
        {"zh": "我又往前走了半步", "en": "I take another half step."},
        {"zh": "我这一步很轻", "en": "A light step."},
        {"zh": "可是已经很近了", "en": "But close enough."},
        {"zh": "你要么退，要么游", "en": "Either step back or swim."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我闷声吼了一下", "en": "I let out a muffled roar."},
        {"zh": "长吻往两边甩了甩", "en": "My snout whips sideways."},
        {"zh": "血一点点滴进水里", "en": "Blood drips into the water."},
        {"zh": "我退回深处去", "en": "I withdraw to the depths."},
        {"zh": "只把眼睛露出来", "en": "Only my eyes showing."},
        {"zh": "肩胛骨那里开了口", "en": "A gash at my shoulder blade."},
        {"zh": "这一下真够沉", "en": "That one was really heavy."},
        {"zh": "我兜了半个圈子", "en": "I swing half a circle."},
        {"zh": "找到你的侧面", "en": "And find your flank."},
        {"zh": "那就再试一次", "en": "Then I'll try again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里面有血味", "en": "Blood in the water."},
        {"zh": "我鼻孔张了张", "en": "My nostrils flare."},
        {"zh": "那股味道非常浓", "en": "Strong smell."},
        {"zh": "我低头扎进去", "en": "I dip my head in."},
        {"zh": "我把长嘴扎进泥里找鱼。", "en": "I drive my long snout into the mud after fish."},
        {"zh": "我低头咬了一口", "en": "I bite."},
        {"zh": "很滑，没咬住", "en": "Slippery. Didn't hold."},
        {"zh": "接着再咬一次", "en": "Bite again."},
        {"zh": "这一次咬稳了", "en": "This time the grip holds."},
        {"zh": "我抬头把它甩上来", "en": "I lift my head and toss it up."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里，你在岸上", "en": "I'm in the water. You're on the bank."},
        {"zh": "我从浅滩里站起，水才到腰。", "en": "I rise from the shallows with water only at my hips."},
        {"zh": "我甩了一下，把你带倒", "en": "A flick takes your feet out."},
        {"zh": "水花溅得到处都是", "en": "Water everywhere."},
        {"zh": "我转过身面对你。", "en": "I turn to face you."},
        {"zh": "这一下你自己找的", "en": "You brought that on yourself."},
        {"zh": "我往后缩了半步", "en": "I shrink back half a step."},
        {"zh": "可是并没有走远", "en": "But not far."},
        {"zh": "你别再踩上去了", "en": "Don't step on it again."},
        {"zh": "下一次不一样", "en": "Next time it's different."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "河湾里有另一只", "en": "Another one in the bend of the river."},
        {"zh": "我们隔着浅滩对视", "en": "We look at each other across the shallows."},
        {"zh": "然后一同走进水里", "en": "Then we both walk into the water."},
        {"zh": "她在浅滩另一头，我游过去。", "en": "She waits across the shallows; I swim over."},
        {"zh": "长吻几乎碰在一起", "en": "Our snouts almost touch."},
        {"zh": "我抓一条鱼给她", "en": "I catch a fish for her."},
        {"zh": "她一口就接过去", "en": "She takes it."},
        {"zh": "我们在岸边挖了坑", "en": "We scrape a hollow on the bank."},
        {"zh": "轮流守在旁边", "en": "We take turns watching it."},
        {"zh": "河涨上来就搬", "en": "When the river rises, we move."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "低头，用牙尖夹住", "en": "I dip and grip it with my teeth."},
        {"zh": "甩了甩，把它翻过来", "en": "Two shakes turn it over."},
        {"zh": "太大，一口吞不下", "en": "Too big to swallow."},
        {"zh": "牙齿排成一列，正好卡进肉里。", "en": "My teeth line up and sink straight into the meat."},
        {"zh": "一半先咽下去", "en": "Half goes down first."},
        {"zh": "另一半还叼在嘴里", "en": "The rest stays in my jaws."},
        {"zh": "我又走回水里", "en": "I walk back into the water."},
        {"zh": "这样吃更方便", "en": "Easier to eat there."},
        {"zh": "我叼着它，退到深水再吃。", "en": "I carry it back to deeper water before eating."},
        {"zh": "很快便消散了", "en": "It fades quickly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水下的影子变大了", "en": "The shadow under the water grows."},
        {"zh": "我把长吻垂下来", "en": "I lower my snout."},
        {"zh": "我的前爪抬起来", "en": "My foreclaw rises."},
        {"zh": "长吻直指前方", "en": "My long snout points ahead."},
        {"zh": "一步踏进水里", "en": "One step into the water."},
        {"zh": "水已经没到腰间", "en": "Water to my waist."},
        {"zh": "我一点也不在乎", "en": "I don't care."},
        {"zh": "这里我快得多", "en": "I'm faster here."},
        {"zh": "你听到了水声", "en": "You heard the splash."},
        {"zh": "那已经是开始", "en": "That was the start."},
        {"zh": "我不做第二次提醒", "en": "I don't warn twice."},
        {"zh": "这一下就要落下", "en": "This blow is about to fall."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "河底的泥一翻，就看不见我了。", "en": "One stir of river mud and you lose sight of me."},
        {"zh": "水声遮住了我的脚步", "en": "The river hides my steps."},
        {"zh": "我一声都没有叫", "en": "I haven't made a sound."},
        {"zh": "长吻先探出去", "en": "My snout probes forward."},
        {"zh": "然后身体才跟上", "en": "My body follows."},
        {"zh": "我这长嘴，专捞河里的鱼。", "en": "This long snout is for scooping river fish."},
        {"zh": "我就停在水里", "en": "I stop in the water."},
        {"zh": "只剩眼睛在上面", "en": "Only my eyes above the surface."},
        {"zh": "你看不出那是什么", "en": "You can't tell what it is."},
        {"zh": "你可以再看一次", "en": "Look again."},
        {"zh": "看起来还是一样", "en": "It's the same."},
        {"zh": "那就不要看了", "en": "Then don't look."},
        {"zh": "往前两步就到了", "en": "Two more steps and I'm there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "长吻一咬，牙全陷进去", "en": "My snout clamps and every tooth sinks."},
        {"zh": "前爪狠狠抓下来", "en": "My foreclaw rakes down."},
        {"zh": "这一下撕开布料", "en": "That one tears through cloth."},
        {"zh": "我甩头，把你带偏", "en": "I twist my head and drag you off line."},
        {"zh": "水花砸在你身上", "en": "Water crashes over you."},
        {"zh": "我的长吻夹住你的肩甲。", "en": "My long snout clamps onto your shoulder plate."},
        {"zh": "那里我更占便宜", "en": "That's my advantage."},
        {"zh": "我又低头再咬", "en": "I dip and bite again."},
        {"zh": "这次咬在护甲上", "en": "This one hits armor."},
        {"zh": "牙被硌了一下", "en": "My teeth jar."},
        {"zh": "我退了半步，重新看", "en": "I step back to reassess."},
        {"zh": "你倒是有两下子", "en": "You've got some fight."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "河面上起了一道水线", "en": "A wake cuts across the river."},
        {"zh": "我从水里站起来", "en": "I rise out of the water."},
        {"zh": "水从背上成片地流", "en": "Water sheets off my back."},
        {"zh": "长吻上还挂着水草", "en": "Weeds hang from my snout."},
        {"zh": "我先看了看两岸", "en": "I scan both banks."},
        {"zh": "这地方水不深", "en": "The water isn't deep here."},
        {"zh": "这里很适合我", "en": "Suits me well."},
        {"zh": "前爪在地上抓了两下", "en": "My foreclaw rakes twice."},
        {"zh": "我把头低下去嗅", "en": "I lower my head to sniff."},
        {"zh": "有鱼，有别的", "en": "Fish. And something else."},
        {"zh": "我朝下游走过去", "en": "I head downstream."},
        {"zh": "我的步子很慢", "en": "Slow steps."},
        {"zh": "可是不会停下来", "en": "But they won't stop."},
        {"zh": "这条河归我巡", "en": "This river is mine to walk."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "皮上烧焦了一片", "en": "A patch of my hide burns."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时两腿一弯", "en": "My legs bend on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水深过头，我扑腾", "en": "The water's over my head. I thrash."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把水掀了起来", "en": "The blast throws the water up."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的颈", "en": "An arrow buries in my neck."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头里一阵刺痛", "en": "A piercing ache in my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得前爪都在抖", "en": "Hunger makes my foreclaw shake."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈下来，我全身一僵", "en": "Lightning strikes and I lock up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "河底忽然没有了", "en": "The riverbed is gone."}
      ]
    }
  }
}
