{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "扁圆的身子在水里推", "en": "My deep round body pushes through water."},
        {"zh": "大尾鳍一摆就是几格", "en": "One beat of my big tail carries me yards."},
        {"zh": "内陆海道的浑水", "en": "The murky water of the inland sea."},
        {"zh": "我巡着礁石边上", "en": "I work along the reef's edge."},
        {"zh": "背鳍竖着，很少收", "en": "My dorsal fin stays up."},
        {"zh": "我侧过身，换了个层", "en": "I roll and change depth."},
        {"zh": "小鱼的影子在前面", "en": "A small fish's shadow ahead."},
        {"zh": "我一点也不急着追", "en": "I don't rush it."},
        {"zh": "我慢慢地凑近", "en": "I edge closer slowly."},
        {"zh": "尾巴几乎不动", "en": "My tail barely moves."},
        {"zh": "浑浊里我更占便宜", "en": "The murk favors me."},
        {"zh": "下面有软体动物的壳", "en": "Shells on the bottom."},
        {"zh": "我压低，贴着沙游", "en": "I drop low, skimming sand."},
        {"zh": "一口就把它咬碎", "en": "One bite crushes them."},
        {"zh": "我在内海道的浅水里巡游。", "en": "I cruise the shallows of the inland sea."},
        {"zh": "这片海道从前更大", "en": "This seaway used to be wider."},
        {"zh": "现在只剩这么多", "en": "Now only this much is left."},
        {"zh": "我游过一片暗色的沙", "en": "I pass over a stretch of dark sand."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "停在礁石旁的水里", "en": "Hovering by the reef."},
        {"zh": "鳃盖一下一下地动", "en": "My gill cover works steadily."},
        {"zh": "阳光落在背上", "en": "Sunlight on my back."},
        {"zh": "下方有活物在动", "en": "Something living moves below."},
        {"zh": "我并没有下去", "en": "I don't go down."},
        {"zh": "我还想再看一看", "en": "I want to watch more."},
        {"zh": "有鱼群从我身边过", "en": "A school passes me."},
        {"zh": "它们主动绕开了", "en": "They give me room."},
        {"zh": "这倒是件好事", "en": "That's good."},
        {"zh": "我的牙很短，但很硬", "en": "My teeth are short, but hard."},
        {"zh": "我咬得动这些壳", "en": "I can break shell."},
        {"zh": "水草在慢慢地摇", "en": "The weeds sway."},
        {"zh": "我又往深处沉", "en": "I sink deeper again."},
        {"zh": "有只海龟从远处划过", "en": "A sea turtle crosses far off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上有个影子", "en": "A shadow on the surface."},
        {"zh": "我在底下盯着你", "en": "I eye you from underneath."},
        {"zh": "你立在浅水当中", "en": "You stand in the shallows."},
        {"zh": "我游近了一点", "en": "I come a little closer."},
        {"zh": "然后我又停住", "en": "Then stop."},
        {"zh": "你的腿我能咬到", "en": "I could reach your legs."},
        {"zh": "可是还不值得", "en": "Not worth it yet."},
        {"zh": "我绕着转了半圈", "en": "I loop halfway around."},
        {"zh": "水被我推得发浑", "en": "My passing stirs the water."},
        {"zh": "你往后一步步退", "en": "You step back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我猛摆了一下尾巴", "en": "My tail lashes once."},
        {"zh": "水立刻就浑了", "en": "The water clouds instantly."},
        {"zh": "身上掉了一片鳞", "en": "A scale comes off."},
        {"zh": "我沉到礁石后面", "en": "I sink behind the reef."},
        {"zh": "血在水里拉成一条", "en": "Blood trails in a line."},
        {"zh": "我绕着游了一圈", "en": "I circle once."},
        {"zh": "确认没东西再跟来", "en": "Checking nothing followed."},
        {"zh": "伤口在鳃旁边", "en": "The wound is near my gills."},
        {"zh": "呼吸有点费力", "en": "Breathing is a little labored."},
        {"zh": "可是我还能游", "en": "But I can still swim."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西掉进水里", "en": "Something fell in."},
        {"zh": "我总是第一个到", "en": "I'm first to it."},
        {"zh": "我先咬了一口", "en": "I take a bite."},
        {"zh": "可味道不太对", "en": "Something's off."},
        {"zh": "可是味道还行", "en": "But the taste is passable."},
        {"zh": "我紧跟着又咬", "en": "I bite once more."},
        {"zh": "这一次我吞下去了", "en": "This time I swallow."},
        {"zh": "水里还有碎片", "en": "More pieces drifting."},
        {"zh": "我一条条地找", "en": "I hunt them one by one."},
        {"zh": "找得非常仔细", "en": "Very thoroughly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "水被撞出一大片波纹", "en": "A wide ripple spreads from the impact."},
        {"zh": "我侧身让了一下", "en": "I roll slightly aside."},
        {"zh": "涟漪散得很快", "en": "The ripples fade quickly."},
        {"zh": "我换了个深度", "en": "I change depth."},
        {"zh": "你在上面，我在下面", "en": "You above, me below."},
        {"zh": "这样不会撞上", "en": "That way we don't collide."},
        {"zh": "我继续巡我的", "en": "I go back to patrolling."},
        {"zh": "这片水并不宽", "en": "This water isn't wide."},
        {"zh": "可是够我转个身", "en": "But it's enough to turn in."},
        {"zh": "转得很慢，很稳", "en": "Slow and smooth."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们并排游过礁石", "en": "We swim the reef together."},
        {"zh": "她的身体比我的圆", "en": "Her body is rounder than mine."},
        {"zh": "我们的尾巴一起摆", "en": "Our tails beat at once."},
        {"zh": "水里有卵散开", "en": "Eggs scatter in the water."},
        {"zh": "数量很多，又很小", "en": "Many, and very small."},
        {"zh": "海水会把它们带走", "en": "The sea will carry them."},
        {"zh": "我们就不去管了", "en": "We don't follow."},
        {"zh": "继续游我们的", "en": "We keep swimming."},
        {"zh": "这片海道够大", "en": "This seaway is large enough."},
        {"zh": "总会有几条活下来", "en": "Some will survive."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一口咬住，咽下去", "en": "One bite and it's down."},
        {"zh": "壳碎了，肉在里面", "en": "The shell cracks. Meat inside."},
        {"zh": "我慢慢吸出来", "en": "I draw it out slowly."},
        {"zh": "这个实在太小了", "en": "This one's too small."},
        {"zh": "我又找了一个", "en": "I find another."},
        {"zh": "这一个相当不错", "en": "This one's good."},
        {"zh": "吃完把壳吐掉", "en": "Done. I spit out the shell."},
        {"zh": "水里有碎屑往下沉", "en": "Crumbs sink in the water."},
        {"zh": "小鱼赶来捡碎屑", "en": "Small fish come for them."},
        {"zh": "我把螺壳吐进内海的沙里。", "en": "I spit the shell out onto the inland sea sand."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有一股味道", "en": "A taste in the water."},
        {"zh": "我掉头朝那边", "en": "I swing around toward it."},
        {"zh": "尾巴摆得慢了", "en": "My tail slows."},
        {"zh": "我不想吓跑它", "en": "I don't want to spook it."},
        {"zh": "礁石正好挡着", "en": "The reef hides me."},
        {"zh": "我兜到另一侧", "en": "I swing around the far side."},
        {"zh": "它居然还停在那", "en": "Still there."},
        {"zh": "这段距离不远", "en": "Close enough."},
        {"zh": "我压得更低了", "en": "I press lower still."},
        {"zh": "鳍全都收住了", "en": "Fins pulled in."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在它侧面", "en": "I stay on its flank."},
        {"zh": "它一直没有发现", "en": "It hasn't noticed."},
        {"zh": "水色帮我遮住形状", "en": "The water hides my shape."},
        {"zh": "它往左，我往左", "en": "It goes left. I go left."},
        {"zh": "等到水浅的地方", "en": "Wait for shallower water."},
        {"zh": "那里它转不开", "en": "It can't turn there."},
        {"zh": "我推着它过去", "en": "I herd it that way."},
        {"zh": "它开始慌乱起来", "en": "It's starting to panic."},
        {"zh": "慌乱里就慢了", "en": "Panic slows it down."},
        {"zh": "机会就在那里", "en": "Right there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬在它侧面", "en": "I bite into its flank."},
        {"zh": "牙很短，但夹得很紧", "en": "Short teeth, but a tight grip."},
        {"zh": "身体一甩，把它拖住", "en": "One twist drags it back."},
        {"zh": "尾巴拍了一下", "en": "My tail slaps once."},
        {"zh": "水被搅得白花花的", "en": "The water churns white."},
        {"zh": "它使劲挣了两下", "en": "It struggles twice."},
        {"zh": "可它没有挣开", "en": "It doesn't get free."},
        {"zh": "我又咬深一点", "en": "I bite deeper."},
        {"zh": "血在水里化开来", "en": "Blood dissolves in the water."},
        {"zh": "这就是我的吃法", "en": "That's how I feed."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上浮起一层波纹", "en": "A layer of ripples rises on the surface."},
        {"zh": "我的背鳍先破水", "en": "My dorsal fin breaks the surface first."},
        {"zh": "然后整个身子浮上来", "en": "Then the whole body."},
        {"zh": "水从这里流得很慢", "en": "The water moves slowly here."},
        {"zh": "我喜欢这样的地方", "en": "I like places like this."},
        {"zh": "下面有一片礁石", "en": "Reef below."},
        {"zh": "还有各种壳类", "en": "And shellfish."},
        {"zh": "够我吃上一阵", "en": "Enough to last a while."},
        {"zh": "我又沉下去了", "en": "I sink back down."},
        {"zh": "沿着礁边游过去", "en": "Swimming along the reef edge."},
        {"zh": "尾巴慢慢地摆", "en": "Tail beating slowly."},
        {"zh": "水很浑，正合适", "en": "Murky water. Perfect."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水烫了，我往下钻", "en": "The water heats. I dive."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我被甩到岸上，乱拍", "en": "Flung onto land, I thrash."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "这水里居然没有气", "en": "Even this water has no air."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "水被炸开，我被推走", "en": "The water bursts and I'm shoved."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿进水里扎中我", "en": "Something cut the water and struck me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "水流全不对了", "en": "The current is all wrong."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得游得很慢", "en": "Hunger slows my swimming."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下水面，我发麻", "en": "Lightning struck the surface and I went numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "水忽然没有了", "en": "The water is gone."}
      ]
    }
  }
