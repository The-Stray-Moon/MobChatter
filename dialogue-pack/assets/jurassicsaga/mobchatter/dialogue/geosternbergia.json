{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在地上，走得笨拙。", "en": "On the ground I walk clumsily."},
        {"zh": "翼收在身侧，拖着地。", "en": "Wings folded, dragging."},
        {"zh": "七米多的翼展，走不快。", "en": "Seven-meter wingspan, slow on foot."},
        {"zh": "我用四肢撑地挪。", "en": "I shuffle on all fours."},
        {"zh": "海滩的沙，陷得深。", "en": "The beach sand sinks deep."},
        {"zh": "我一跳，才有风。", "en": "Only a jump catches wind."},
        {"zh": "长喙抬起来扫。", "en": "My long beak sweeps up."},
        {"zh": "骨头空，身子很轻。", "en": "Hollow bones make me light."},
        {"zh": "翼尖刮过沙面。", "en": "Wingtips graze the sand."},
        {"zh": "我找高处起飞。", "en": "I look for height to launch."},
        {"zh": "风从崖上下来。", "en": "Wind comes off the cliff."},
        {"zh": "我慢慢走向那块岩。", "en": "I head for that rock."},
        {"zh": "地上走一步，天上省十倍。", "en": "One step here, ten in the air."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在崖边，等风。", "en": "I stand at the cliff and wait for wind."},
        {"zh": "翼半张，微微抖。", "en": "Wings half open, quivering."},
        {"zh": "海在下面，声音很响。", "en": "The sea is loud below."},
        {"zh": "我的喙很长，很轻。", "en": "My beak is long and light."},
        {"zh": "我偏头看着水面。", "en": "I turn my head toward the water."},
        {"zh": "风向掉了个头。", "en": "The wind has turned."},
        {"zh": "我把翼膜抖开又收拢。", "en": "I fan the membranes open and shut."},
        {"zh": "远处有一群鱼。", "en": "A school of fish out there."},
        {"zh": "崖上的石头，晒得暖。", "en": "The cliff stone is warm."},
        {"zh": "我在等一个上升气流。", "en": "I'm waiting for an updraft."},
        {"zh": "我压下翅膀，又抬起。", "en": "I lower my wings and lift them."},
        {"zh": "我张了张喙，活动一下。", "en": "I open my beak to loosen it."},
        {"zh": "崖下的浪，一层层推。", "en": "Waves push in layers below."},
        {"zh": "我的影子在崖壁上。", "en": "My shadow on the cliff face."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头看我，很高吧。", "en": "Looking up at me — quite a view?"},
        {"zh": "我的翼张开，比你还宽。", "en": "My wings span wider than you."},
        {"zh": "你站的地方，是我起飞的跑道。", "en": "You're standing on my runway."},
        {"zh": "别抓我的翼膜。", "en": "Don't grab the wing membrane."},
        {"zh": "我在你上方的气流里。", "en": "I ride the current above you."},
        {"zh": "你不像能飞的。", "en": "You don't look like you can fly."},
        {"zh": "我的喙里没有牙。", "en": "There are no teeth in my beak."},
        {"zh": "这崖头，是我休息的地方。", "en": "This cliff top is my resting spot."},
        {"zh": "我张翼，是要走了。", "en": "Spreading my wings means I'm leaving."},
        {"zh": "风从我翅下穿过去。", "en": "Wind passes under my wings."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翼膜破了一道。", "en": "A tear in the wing membrane."},
        {"zh": "我歪着身子站稳。", "en": "I steady myself, tilted."},
        {"zh": "骨头轻，也怕摔。", "en": "Light bones fear a fall."},
        {"zh": "一声锐响从我喉里出。", "en": "A shrill note breaks from my throat."},
        {"zh": "我缩起翼，退了一步。", "en": "I fold my wings and step back."},
        {"zh": "这点伤，还能飞。", "en": "I can still fly with this."},
        {"zh": "羽毛掉了几片。", "en": "A few feathers came loose."},
        {"zh": "我抖了抖翼。", "en": "I shake my wings."},
        {"zh": "落地的时候，腿一软。", "en": "My legs buckle on landing."},
        {"zh": "别压我的翼。", "en": "Don't press my wings."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是条鱼吗？", "en": "Is that a fish down there?"},
        {"zh": "我落地很笨，让我慢慢来。", "en": "Landing is awkward; let me come slowly."},
        {"zh": "这么点，只够塞牙。", "en": "That much only fills a tooth gap."},
        {"zh": "你举高些，我够得到。", "en": "Hold it higher; I can reach."},
        {"zh": "我不抢人手里的东西。", "en": "I don't snatch from hands."},
        {"zh": "放在石上，我下来。", "en": "Set it on the rock and I'll come down."},
        {"zh": "我记得这味道。", "en": "I remember this smell."},
        {"zh": "你退后，我才落。", "en": "Step back and I'll land."},
        {"zh": "叼着飞走，很方便。", "en": "Easy to carry off in flight."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我，我的骨头轻。", "en": "Bump me; my bones are light."},
        {"zh": "翼被压到，很疼。", "en": "My wing got pinned; it hurts."},
        {"zh": "我踉跄了两步。", "en": "I stumble two steps."},
        {"zh": "地上不方便，我知道。", "en": "Awkward on the ground — I know."},
        {"zh": "你让开，我要起飞。", "en": "Move aside; I'm taking off."},
        {"zh": "沙被我的翼尖扫起来了。", "en": "My wingtip swept the sand up."},
        {"zh": "这点磕碰，不碍飞。", "en": "That bump won't stop me flying."},
        {"zh": "我的翼尖扫到你。", "en": "My wingtip caught you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "崖上那只，翼很宽。", "en": "That one on the cliff has broad wings."},
        {"zh": "我们并排站在风里。", "en": "We stand side by side in the wind."},
        {"zh": "我张开翼，它也张开。", "en": "I spread; it spreads too."},
        {"zh": "一起盘旋上升。", "en": "We spiral up together."},
        {"zh": "崖壁上的台，够我们落脚。", "en": "The ledge fits us both."},
        {"zh": "我们不唱，只叫。", "en": "We don't sing; we call."},
        {"zh": "海面映着两个影子。", "en": "Two shadows on the sea."},
        {"zh": "巢在崖缝里。", "en": "The nest goes in a cliff crack."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用喙叼起来。", "en": "I take it in my beak."},
        {"zh": "鱼滑，差点掉了。", "en": "Slippery fish; nearly dropped it."},
        {"zh": "这点重量，我无所谓。", "en": "Weight means little to me."},
        {"zh": "叼着飞，风会扯。", "en": "In flight the wind tugs at it."},
        {"zh": "掉在海里，捞不回来。", "en": "Dropped in the sea; can't retrieve it."},
        {"zh": "我甩了甩头，吞下去。", "en": "I toss my head and swallow."},
        {"zh": "这东西小得可怜。", "en": "This thing is pitifully small."},
        {"zh": "我带回去给同伴。", "en": "I'll take it back for my mate."},
        {"zh": "我的喙尖很准。", "en": "My beak tip is precise."},
        {"zh": "我留下了一半。", "en": "I kept half."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "下面有东西在动。", "en": "Something moves below."},
        {"zh": "我抬高头，看清了。", "en": "I raise my head and see it."},
        {"zh": "那不是鱼群。", "en": "That's not a school."},
        {"zh": "我张开翼，试风。", "en": "I spread my wings and test the wind."},
        {"zh": "从上面下去最快。", "en": "Coming from above is fastest."},
        {"zh": "它还没往上看。", "en": "It hasn't looked up."},
        {"zh": "崖上的风，刚好。", "en": "The cliff wind is just right."},
        {"zh": "我蹬了两下往后退。", "en": "I push back a couple of paces."},
        {"zh": "再等它一会儿。", "en": "Wait a little longer."},
        {"zh": "起跳点，就这里。", "en": "This is my launch point."},
        {"zh": "我俯下身子贴住崖面。", "en": "I flatten against the cliff face."},
        {"zh": "我抬起翼尖，感风。", "en": "I lift a wingtip to feel the wind."},
        {"zh": "它还在低头找食。", "en": "It's still head-down, foraging."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "从高处看，它跑不掉。", "en": "From up here, it can't escape."},
        {"zh": "翅膀不动，也能滑。", "en": "I can glide without a beat."},
        {"zh": "七米的翼展，够我盯很久。", "en": "With seven meters of wingspan, I can watch for ages."},
        {"zh": "风把我托住。", "en": "The wind holds me up."},
        {"zh": "影子先落到地上。", "en": "My shadow lands first."},
        {"zh": "我压低，靠近些。", "en": "I drop lower, closing in."},
        {"zh": "这个角度，很好。", "en": "This angle is good."},
        {"zh": "我调整了俯冲的角度。", "en": "I've adjusted my dive angle."},
        {"zh": "你跑也没有用。", "en": "Running won't help you."},
        {"zh": "我顺着气流往下。", "en": "I ride the current down."},
        {"zh": "我把翼收了起来。", "en": "I've drawn my wings in."},
        {"zh": "就差一点了。", "en": "Just about there."},
        {"zh": "角度已经对准。", "en": "The angle is set."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从上面扑下来！", "en": "I dive from above!"},
        {"zh": "我长喙直扎下去。", "en": "My long beak stabs down."},
        {"zh": "翼一扇，把你掀开。", "en": "A wingbeat sweeps you aside."},
        {"zh": "爪子抓住了你的肩。", "en": "My claws catch your shoulder."},
        {"zh": "这一下，从高处来的。", "en": "That came from height."},
        {"zh": "我落地不太稳。", "en": "My landing is unsteady."},
        {"zh": "别伸手抓我的翼。", "en": "Don't grab my wing."},
        {"zh": "我发出一声刺耳的叫。", "en": "I let out a piercing cry."},
        {"zh": "喙尖硬得像石头。", "en": "My beak tip is hard as stone."},
        {"zh": "你被逼退开了。", "en": "You were driven back."},
        {"zh": "这一击足够。", "en": "That strike suffices."},
        {"zh": "我跳起来，重新起飞。", "en": "I leap and take off again."},
        {"zh": "别在崖下站着。", "en": "Don't stand below the cliff."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从崖上滑下来。", "en": "I glide down from the cliff."},
        {"zh": "翼展开，影子扫过地面。", "en": "Wings wide, my shadow sweeps the ground."},
        {"zh": "海风把我接住。", "en": "The sea wind catches me."},
        {"zh": "这里风不错。", "en": "Good wind here."},
        {"zh": "我落在岩上，收翼。", "en": "I land on rock and fold my wings."},
        {"zh": "我一身骨头很轻。", "en": "My bones are very light."},
        {"zh": "我先看看海面。", "en": "First I scan the sea."},
        {"zh": "崖壁的台子够宽。", "en": "The ledge is wide enough."},
        {"zh": "风里带着鱼腥。", "en": "Fish on the wind."},
        {"zh": "海那头有条船。", "en": "There's a boat out on the sea."},
        {"zh": "我偏头，听了听。", "en": "I tilt my head and listen."},
        {"zh": "我准备起飞。", "en": "I ready myself to fly."},
        {"zh": "高处总是更好。", "en": "Height is always better."},
        {"zh": "风一停，我就走。", "en": "When the wind drops, I go."},
        {"zh": "我的翼还没完全展开。", "en": "My wings aren't fully open yet."},
        {"zh": "落脚的地方就这儿。", "en": "This is the place to land."},
        {"zh": "我抬眼扫过云层。", "en": "I lift my eyes across the clouds."},
        {"zh": "我从崖上下来了。", "en": "I've come down from the cliff."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "翼膜一碰到火就卷。", "en": "Fire curls the membrane."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔在地上，骨头响。", "en": "I hit the ground; bones crack."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进喙里，我扑腾。", "en": "Water in my beak; I thrash."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿了翼。", "en": "An arrow through my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我失了风。", "en": "That force robs me of the wind."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得飞不动。", "en": "Too hungry to fly."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一闪，我从半空掉了下去。", "en": "A flash, and I fall from the air."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有气流，我直坠。", "en": "No air; I plummet."}
      ]
    }
  }
}
