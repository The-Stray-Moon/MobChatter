{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "两米高，一身羽毛", "en": "Two meters tall, covered in feathers."},
        {"zh": "第二趾的镰爪抬着", "en": "My second-toe sickle stays raised."},
        {"zh": "尾巴笔直，帮我平衡", "en": "My tail is straight, keeping balance."},
        {"zh": "我的骨架，第一个被认出来", "en": "My skeleton was the first recognized."},
        {"zh": "一步一探，很谨慎", "en": "Every step tested, careful."},
        {"zh": "我沿着林缘走", "en": "I walk the forest edge."},
        {"zh": "羽毛随步子轻晃", "en": "My feathers sway with each step."},
        {"zh": "我不喜欢开阔地", "en": "I dislike open ground."},
        {"zh": "树多的地方我才安心", "en": "I'm at ease only among trees."},
        {"zh": "我绕开灌丛，走硬土", "en": "I skirt the brush, on firm ground."},
        {"zh": "爪尖轻轻点地", "en": "My claw tips barely touch down."},
        {"zh": "我在找一条能伏击的线", "en": "I'm finding a line to ambush from."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，颈部前伸", "en": "I stand, neck forward."},
        {"zh": "我的羽毛在风里抖", "en": "My feathers shiver in the wind."},
        {"zh": "我在算计距离", "en": "I'm calculating distance."},
        {"zh": "一条完整的骨架，让人认识了我", "en": "A complete skeleton introduced me."},
        {"zh": "我不用跑，也能很快", "en": "I needn't run to be fast."},
        {"zh": "林缘的气味最杂", "en": "The forest edge has the most scents."},
        {"zh": "镰爪一直抬着，不落灰", "en": "The sickle stays up, clear of dust."},
        {"zh": "我在听哪边有脚步", "en": "I'm hearing which side has steps."},
        {"zh": "我不喜欢被打断", "en": "I dislike being interrupted."},
        {"zh": "这片林地有我的抓痕", "en": "These woods bear my claw marks."},
        {"zh": "我随时能起跳", "en": "I could leap at any moment."},
        {"zh": "我低头理了理羽毛", "en": "I lower my head and preen."},
        {"zh": "远处的树在动", "en": "The trees in the distance move."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在开阔地上", "en": "You're on open ground."},
        {"zh": "我的脖子比你的视线长", "en": "My neck reaches farther than your gaze."},
        {"zh": "你的护甲缝隙在腋下", "en": "Your armor gapes at the armpit."},
        {"zh": "我已经看到了", "en": "I've seen it."},
        {"zh": "你不用转身，我知道你在哪", "en": "No need to turn; I know where you are."},
        {"zh": "我两米高，不算大", "en": "Two meters isn't large."},
        {"zh": "但对付你足够了", "en": "But enough for you."},
        {"zh": "你的靴子踩得很重", "en": "Your boots land heavily."},
        {"zh": "我还没决定从哪边", "en": "I haven't decided which side."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退开，羽毛竖起", "en": "I pull back, feathers up."},
        {"zh": "这一下打在腿上", "en": "That hit my leg."},
        {"zh": "我落地不太稳", "en": "I landed unsteadily."},
        {"zh": "血迹沾在羽根", "en": "Blood at my feather base."},
        {"zh": "我压低身子，准备还击", "en": "I crouch, ready to answer."},
        {"zh": "你打断了我的节奏", "en": "You broke my rhythm."},
        {"zh": "这点伤，能忍", "en": "I can bear this."},
        {"zh": "我绕到了树后面", "en": "I slip behind a tree."},
        {"zh": "你下次抓不到我", "en": "You won't catch me next time."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉的话，先放下", "en": "Meat; put it down."},
        {"zh": "我自己会去猎", "en": "I hunt for myself."},
        {"zh": "你的手离我太近", "en": "Your hand is too close."},
        {"zh": "扔过来，别递过来", "en": "Toss it, don't hand it over."},
        {"zh": "我先看看有没有诈", "en": "First I check for a trick."},
        {"zh": "这点东西，不够我跳一次", "en": "Not worth one leap."},
        {"zh": "我不吃活的喂的", "en": "I don't eat from a living hand."},
        {"zh": "你退开三步远", "en": "Back off three steps."},
        {"zh": "但我不为它低头", "en": "But I won't bow for it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我的胸骨", "en": "You hit my breastbone."},
        {"zh": "羽毛很滑，你没抓住", "en": "My feathers are slick; you missed."},
        {"zh": "我不躲，我只是不退", "en": "I don't dodge; I just don't yield."},
        {"zh": "这一撞，你手腕该响了", "en": "That should have made your wrist click."},
        {"zh": "我的体重比看起来重", "en": "I'm heavier than I look."},
        {"zh": "你被弹到树边", "en": "You're knocked to a tree."},
        {"zh": "我侧过身，让你过去", "en": "I turn side-on to let you by."},
        {"zh": "碰到我的镰爪了", "en": "You touched my sickle claw."},
        {"zh": "下一次我会起跳", "en": "Next time I'll leap."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的羽毛要够亮", "en": "My feathers must be bright enough."},
        {"zh": "先看我能不能猎", "en": "Watch whether I can hunt first."},
        {"zh": "一起守着这片林缘", "en": "Let's hold this forest edge together."},
        {"zh": "我的镰爪不会对你", "en": "My sickle won't turn on you."},
        {"zh": "窝要藏在树根之间", "en": "The nest must hide among roots."},
        {"zh": "慢慢绕圈，别急", "en": "Circle slowly; no rush."},
        {"zh": "羽毛挨着羽毛，算应了", "en": "Feather against feather means yes."},
        {"zh": "这片林子够养活两只", "en": "These woods feed two."},
        {"zh": "你的步法还不错", "en": "Your footwork isn't bad."},
        {"zh": "你就跟上来吧", "en": "Keep up with me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "叼起肉，退到树根后。", "en": "I snatch the meat and retreat behind a root."},
        {"zh": "这一块，够我半顿", "en": "This much is half a meal."},
        {"zh": "骨头我留在树下", "en": "I leave the bones under a tree."},
        {"zh": "别抢，我速度很快", "en": "Don't grab; I'm very quick."},
        {"zh": "我叼着跳上树根", "en": "I carry it up onto a root."},
        {"zh": "这点东西不值得我弯腰", "en": "This isn't worth bending for."},
        {"zh": "血的味道很新鲜", "en": "The blood smells fresh."},
        {"zh": "我边吃边看四周", "en": "I eat and scan around."},
        {"zh": "吃完就换个地方", "en": "After eating, I move on."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "起跳前，我先压低", "en": "Before leaping, I crouch."},
        {"zh": "镰爪对准你的腿", "en": "The sickle aims at your leg."},
        {"zh": "腋下的缝，我要了", "en": "That armpit gap is mine."},
        {"zh": "我先切开你的腿筋", "en": "I'll cut your hamstring first."},
        {"zh": "你跑起来就更快倒下", "en": "Running makes you fall sooner."},
        {"zh": "林缘是我的主场", "en": "The forest edge is my ground."},
        {"zh": "你的护甲动起来会开口", "en": "Your armor opens as you move."},
        {"zh": "一次就足够解决", "en": "One leap is enough."},
        {"zh": "你听见羽毛的声音了吗", "en": "Hear the feathers?"},
        {"zh": "那声音并不是鸟", "en": "That's not a bird."},
        {"zh": "等你的重心偏一点", "en": "Wait for your balance to tip."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "镰刀爪抬起，找你的腿。", "en": "My sickle claw lifts, aiming for your leg."},
        {"zh": "每圈都更近一点", "en": "Each lap closer."},
        {"zh": "你的膝盖是弱点", "en": "Your knees are weak points."},
        {"zh": "我把你逼到林缘", "en": "I'm herding you to the forest edge."},
        {"zh": "树越多，我越快", "en": "More trees, and I'm faster."},
        {"zh": "你转身，我就换边", "en": "You turn; I switch sides."},
        {"zh": "镰爪一直抬着", "en": "The sickle stays raised."},
        {"zh": "你的脚步越来越沉", "en": "Your steps grow heavier."},
        {"zh": "我在等你重心偏前", "en": "Waiting for your weight to lean forward."},
        {"zh": "你退到开阔地了", "en": "You've backed into the open."},
        {"zh": "那里对我不好", "en": "That's bad for me."},
        {"zh": "但我还是更快", "en": "But I'm faster."},
        {"zh": "羽毛竖起，爪子扣进土里。", "en": "My feathers bristle, claws dig into the dirt."},
        {"zh": "我再绕上半个圈", "en": "Half a lap more."},
        {"zh": "我落地时你已经来不及", "en": "By my landing you're too late."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从侧面跳起", "en": "I leap from the flank."},
        {"zh": "镰爪扣进你的腿", "en": "The sickle hooks your leg."},
        {"zh": "我连着咬了两口", "en": "Two quick bites."},
        {"zh": "我用后腿蹬开树皮", "en": "My hind legs kick off the bark."},
        {"zh": "落地时你已经在流血", "en": "By my landing you're bleeding."},
        {"zh": "这一抓划得很深", "en": "This rake goes deep."},
        {"zh": "你抬盾，我从下面来", "en": "You raise the shield; I come under."},
        {"zh": "羽毛扫过你的眼", "en": "My feathers brush your eyes."},
        {"zh": "我的爪子勾住你的带子", "en": "My claws hook your strap."},
        {"zh": "你被拖倒在地", "en": "You're dragged down."},
        {"zh": "我再补上一击", "en": "One more strike."},
        {"zh": "我跳回了林缘", "en": "I leap back to the tree line."},
        {"zh": "血溅在我的羽上", "en": "Blood on my feathers."},
        {"zh": "下一跳我会瞄准脖子", "en": "Next leap I aim for the neck."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从林缘站起来", "en": "I rise at the tree line."},
        {"zh": "两米高的影子，带着羽", "en": "A two-meter shadow, feathered."},
        {"zh": "镰爪是最先落地的", "en": "The sickle claw lands first."},
        {"zh": "白垩纪的林地多了个猎手", "en": "One more hunter in these Cretaceous woods."},
        {"zh": "我的骨架曾被人挖出来", "en": "My skeleton was once dug out."},
        {"zh": "羽毛还没理顺", "en": "My feathers aren't settled yet."},
        {"zh": "这一带树够多", "en": "Enough trees here."},
        {"zh": "我听见了远处的脚步", "en": "I hear footsteps far off."},
        {"zh": "我压低身子，藏在树后", "en": "I crouch behind a trunk."},
        {"zh": "我先看一遍地形", "en": "I study the terrain first."},
        {"zh": "我抬头，颈子伸出去", "en": "I raise my head, neck extended."},
        {"zh": "我没有同伴，只有自己", "en": "No pack; only me."},
        {"zh": "这片林缘归我", "en": "This tree line is mine."},
        {"zh": "你从那边来，我看得清", "en": "I can see you coming from there."},
        {"zh": "我等着你走近些", "en": "I wait for you to come closer."},
        {"zh": "起跳的距离我算好了", "en": "I've measured the leap."},
        {"zh": "覆羽的驰龙，正面别站。", "en": "Don't stand in front of a feathered dromaeosaur."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛燎起来，我拍打", "en": "My feathers caught; I beat at them."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "起跳时撞到树枝", "en": "A branch caught me mid-leap."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛吸水，太重了", "en": "Soaked feathers are too heavy."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腿一时使不上力", "en": "My legs won't answer."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿太久，跳不远", "en": "Too hungry to leap far."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光下，我全身羽毛都亮了", "en": "In the lightning, every feather lit."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有落脚点", "en": "No landing place below."}
      ]
    }
  }
