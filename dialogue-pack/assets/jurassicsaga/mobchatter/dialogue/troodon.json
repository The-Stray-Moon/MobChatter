{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踮着脚快速小跑", "en": "I trot on nimble toes."},
        {"zh": "头一低一抬，眼睛不停", "en": "My head dips; my eyes never rest."},
        {"zh": "我在蕨类间穿行", "en": "I weave between the ferns."},
        {"zh": "两脚落地几乎没有声", "en": "My two feet land near silently."},
        {"zh": "我绕着你的外圈走", "en": "I walk a wide circle around you."},
        {"zh": "我一边走一边嗅", "en": "I sniff as I go."},
        {"zh": "爪子收着，随时能抓", "en": "My claws are kept ready."},
        {"zh": "我斜着靠近，不直行", "en": "I approach on a slant, never straight."},
        {"zh": "我蹦过一段倒木", "en": "I hop a fallen log."},
        {"zh": "群里的都跟着我", "en": "The others follow me."},
        {"zh": "我停一下，判断风向", "en": "I pause to judge the wind."},
        {"zh": "我跑起来时尾巴平直", "en": "My tail levels out when I run."},
        {"zh": "我从矮树丛下钻过", "en": "I duck beneath the shrubs."},
        {"zh": "我踩进泥里就立刻跳开", "en": "I spring clear of the mud at once."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立起来，四处看", "en": "I stand tall and scan around."},
        {"zh": "耳朵转向了那片蕨", "en": "My ears turn toward the ferns."},
        {"zh": "一、二、三，我数清了", "en": "One, two, three. I've counted."},
        {"zh": "这个声音不对", "en": "That sound isn't right."},
        {"zh": "我抓着一根树枝", "en": "I clutch a twig."},
        {"zh": "我的指头很灵活", "en": "My fingers are nimble."},
        {"zh": "我歪着头在听", "en": "I tilt my head to listen."},
        {"zh": "我闻到了汗味", "en": "I smell sweat."},
        {"zh": "我在等群里回应", "en": "I wait for the pack's answer."},
        {"zh": "动作得小心些", "en": "Careful now."},
        {"zh": "我抓了抓自己的肋侧", "en": "I scratch my own ribs."},
        {"zh": "我在找一个能跳上去的石台", "en": "I'm looking for a rock to spring onto."},
        {"zh": "我绕着你换了半圈", "en": "I've shifted half a circle around you."},
        {"zh": "我盯上了你腰上的东西", "en": "I'm eyeing the thing at your waist."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的眼神往树后飘", "en": "Your eyes drift behind the tree."},
        {"zh": "你身后还有谁", "en": "Who else is behind you?"},
        {"zh": "你走路的声音很重", "en": "You walk heavily."},
        {"zh": "你的手指在动", "en": "Your fingers are moving."},
        {"zh": "你手上有东西", "en": "Something's in your hand."},
        {"zh": "你不是本地的东西", "en": "You aren't from here."},
        {"zh": "我比你想的快", "en": "I'm faster than you think."},
        {"zh": "你的靴子会绊住你", "en": "Your boots will trip you."},
        {"zh": "你其实不必跑", "en": "No need to run."},
        {"zh": "我记住你的方向了", "en": "I've marked which way you face."},
        {"zh": "你手里那根棍子太长了", "en": "That stick of yours is too long."},
        {"zh": "你要走近就别急", "en": "If you're coming closer, don't rush."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我弹开了一步", "en": "I sprang back a step."},
        {"zh": "这一下打偏了", "en": "That glance caught me."},
        {"zh": "我的手被砍了", "en": "My hand was cut."},
        {"zh": "我缩起脖子，往蕨丛里退", "en": "I tuck my neck and slip back into the ferns."},
        {"zh": "腿上挨了一下，站不稳", "en": "A hit to the leg, and I can't stand firm."},
        {"zh": "你比预期敏捷", "en": "You're quicker than expected."},
        {"zh": "我跳开了一步", "en": "I spring a step away."},
        {"zh": "这下打乱了我的节奏", "en": "That broke my rhythm."},
        {"zh": "群马上就会来", "en": "The pack will come."},
        {"zh": "这张脸我记下", "en": "I've kept that face."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西是什么", "en": "What's that?"},
        {"zh": "我不吃死掉的东西", "en": "I don't eat carrion."},
        {"zh": "你举那么高，我够不着", "en": "Hold it that high and I can't reach."},
        {"zh": "退后，我要看", "en": "Step back; I want a look."},
        {"zh": "那个实在太小", "en": "That's too small."},
        {"zh": "你手上没有血味", "en": "No blood on your hands."},
        {"zh": "我不为这个冒险", "en": "I won't risk myself for that."},
        {"zh": "你把它放地上", "en": "Put it on the ground."},
        {"zh": "这不合我的口味", "en": "That doesn't suit my taste."},
        {"zh": "你走开一点点", "en": "Step away a bit."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你肩膀撞到我", "en": "Your shoulder hit me."},
        {"zh": "我退得非常快", "en": "I pulled back fast."},
        {"zh": "我的手抓住你的袖子", "en": "My hand caught your sleeve."},
        {"zh": "我们撞了一下就分开", "en": "We hit once and parted."},
        {"zh": "你比我重得多", "en": "You're heavier than I am."},
        {"zh": "我从你旁边弹开", "en": "I sprang aside from you."},
        {"zh": "别抓我的尾巴", "en": "Don't grab my tail."},
        {"zh": "这样近很危险", "en": "This close is dangerous."},
        {"zh": "我已经绕开了", "en": "I've gone around."},
        {"zh": "再来一次我可咬", "en": "Once more and I bite."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "群里的规矩你懂吗", "en": "Do you know the pack's rules?"},
        {"zh": "这得看季节的", "en": "That depends on the season."},
        {"zh": "我们靠气味认彼此", "en": "We know each other by scent."},
        {"zh": "这事得等雨季过去", "en": "That has to wait for the rains to pass."},
        {"zh": "这种事不用急", "en": "No hurry for that."},
        {"zh": "先看看谁更强", "en": "First, who's stronger."},
        {"zh": "我不和外来者谈这个", "en": "I don't discuss it with outsiders."},
        {"zh": "你先退开一些", "en": "Back off."},
        {"zh": "等群散开再说", "en": "Wait till the pack scatters."},
        {"zh": "我要看着四周", "en": "I must watch our surroundings."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抓的是我脖子", "en": "You've got my neck."},
        {"zh": "我的牙会咬进去", "en": "My teeth will sink in."},
        {"zh": "我的爪子够得到你的手", "en": "My claws can reach your hand."},
        {"zh": "松手，我自己跑", "en": "Let go; I run myself."},
        {"zh": "我比看起来轻", "en": "I'm lighter than I look."},
        {"zh": "别拉我的尾巴", "en": "Don't pull my tail."},
        {"zh": "这样我挣得开", "en": "I can twist free like this."},
        {"zh": "你的手别打颤", "en": "Steady those hands."},
        {"zh": "血腥味从你手上飘来", "en": "Blood-smell drifts off your hand."},
        {"zh": "把爪子松开来", "en": "Let go."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经落后了", "en": "You're lagging."},
        {"zh": "我已经看见了", "en": "I saw it."},
        {"zh": "你转身的那一刻", "en": "The moment you turned."},
        {"zh": "群就在我后面", "en": "The pack is behind me."},
        {"zh": "你身边的人都不见了", "en": "The ones beside you are gone."},
        {"zh": "我们绕成一个圈", "en": "We've made a circle."},
        {"zh": "你的背后没有墙", "en": "There's no wall at your back."},
        {"zh": "咬住就不松开", "en": "Once I bite, I hold."},
        {"zh": "你跑不出林子", "en": "You won't leave this wood."},
        {"zh": "该扑上去了吧", "en": "Time to pounce."},
        {"zh": "我已经做记号", "en": "I've marked you."},
        {"zh": "喊也没有用的", "en": "Shouting won't help."},
        {"zh": "我们一起扑上去", "en": "We come together."},
        {"zh": "你只剩一步了", "en": "One more step."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你左边绕", "en": "I circle on your left."},
        {"zh": "你喘得比刚才重了", "en": "You're breathing heavier than before."},
        {"zh": "我伏在蕨叶后面", "en": "I'm low behind the ferns."},
        {"zh": "你的手已经僵了", "en": "Your hand has stiffened."},
        {"zh": "蕨叶挡了我一半", "en": "The ferns hide half of me."},
        {"zh": "你要是跑，我先咬腿", "en": "Run, and I take your legs first."},
        {"zh": "你每退一步都踩到枯枝", "en": "Every step back cracks a twig."},
        {"zh": "我知道你的速度", "en": "I know how fast you are."},
        {"zh": "群已经围上了", "en": "The pack has closed in."},
        {"zh": "你抬手的那一刻", "en": "The moment you raise your hand."},
        {"zh": "再挪近半步路", "en": "Half a step nearer."},
        {"zh": "我就等这一刻", "en": "Right now."},
        {"zh": "你的背后有人", "en": "Someone's at your back."},
        {"zh": "别往回头去看", "en": "Don't look back."},
        {"zh": "你已经数不清我们几个", "en": "You've lost count of us."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬你的腿脚", "en": "Leg bite."},
        {"zh": "爪子抓进去了", "en": "Claws in."},
        {"zh": "这一下快得很", "en": "That was quick."},
        {"zh": "你的脚退得太迟", "en": "Your feet retreat too late."},
        {"zh": "我跳上去咬你", "en": "I spring up."},
        {"zh": "再来咬你一口", "en": "Another bite."},
        {"zh": "血味让我咬得更深", "en": "The taste of blood makes me bite deeper."},
        {"zh": "你已经站不稳", "en": "You're unsteady."},
        {"zh": "群会接着扑上", "en": "The pack follows up."},
        {"zh": "我不会中途松口", "en": "I won't let go halfway."},
        {"zh": "这一下只是开胃", "en": "That was only the start."},
        {"zh": "你还跑得动吗", "en": "Can you still run?"},
        {"zh": "你退后一点吧", "en": "Back away."},
        {"zh": "到这里就够了", "en": "Enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从蕨丛里出来", "en": "I step out of the ferns."},
        {"zh": "我抬起头，四下看", "en": "I raise my head and look around."},
        {"zh": "这里有血的味道", "en": "There's blood in the air."},
        {"zh": "群还没有赶过来", "en": "The pack hasn't arrived."},
        {"zh": "我先占个好位置", "en": "I take the better position first."},
        {"zh": "踩着枯叶走过来", "en": "I come over the dead leaves."},
        {"zh": "枯叶上有脚步压过", "en": "Steps press through the dead leaves."},
        {"zh": "树影够我藏身", "en": "The shadows are enough cover."},
        {"zh": "我正慢慢靠近", "en": "I close in slowly."},
        {"zh": "这里没什么可吃", "en": "Little to eat here."},
        {"zh": "我第一次睁开眼", "en": "I opened my eyes for the first time."},
        {"zh": "这地方的猎物不少", "en": "Plenty of prey here."},
        {"zh": "让我先试试看", "en": "Let me test the ground."},
        {"zh": "这股风正帮我", "en": "This wind serves me."},
        {"zh": "我压低身子走", "en": "I move low."},
        {"zh": "现在还不用急", "en": "No rush yet."},
        {"zh": "鼻子里全是生人的味", "en": "My nose is full of stranger-smell."},
        {"zh": "有人就在附近", "en": "Someone's close."}
      ]
    },
