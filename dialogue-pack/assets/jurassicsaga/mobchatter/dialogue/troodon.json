      "lines": [
        {"zh": "饿着追不动猎物", "en": "Hungry, I can't chase prey."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在树上，光刺得我眼花", "en": "The bolt split the tree and blinded me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空得难受", "en": "The emptiness underfoot is wrong."}
      ]
    }
  }
