{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "长尾一摆，我滑出三丈", "en": "One sweep of my tail carries me far."},
        {"zh": "长身划过水面", "en": "My long body cuts the water's surface."},
        {"zh": "鳍肢一扇，前进一截", "en": "One stroke of my flipper, one more length."},
        {"zh": "我沿着礁石游", "en": "I swim along the reef."},
        {"zh": "尾巴推着我往前", "en": "My tail pushes me on."},
        {"zh": "水面被我拱起一道浪", "en": "My back raises a wave."},
        {"zh": "我贴着海床滑过去", "en": "I slide low over the seabed."},
        {"zh": "浅水处我转身很慢", "en": "Shallow water makes my turns slow."},
        {"zh": "我浮上来换口气", "en": "I surface for a breath."},
        {"zh": "整片海湾都是我的水域", "en": "The whole bay is my water."},
        {"zh": "我游得很稳，不着急", "en": "I swim steadily, unhurried."},
        {"zh": "鱼群在我前面散了", "en": "The fish scatter ahead of me."},
        {"zh": "我侧身钻过石缝", "en": "I roll through the rock gap."},
        {"zh": "头顶的光一条条落下来", "en": "Light falls down in strips."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在水层中间", "en": "I hang between the water layers."},
        {"zh": "我的嘴微微张着", "en": "My jaws are slightly parted."},
        {"zh": "水从我的鳃边流走", "en": "Water flows past my gills."},
        {"zh": "我在听水里的动静", "en": "I'm listening to the water."},
        {"zh": "海床上的影子是我", "en": "That shadow on the seabed is mine."},
        {"zh": "我慢慢地摆动尾巴", "en": "I sway my tail slowly."},
        {"zh": "这个深度刚好", "en": "This depth suits me."},
        {"zh": "我等着什么游过来", "en": "I wait for something to swim close."},
        {"zh": "背鳍露出水面", "en": "My dorsal fin breaks the surface."},
        {"zh": "我很长，也很安静", "en": "I'm long, and quiet."},
        {"zh": "鳞上有旧的伤", "en": "Old scars mark my hide."},
        {"zh": "这一带没有对手", "en": "I have no rival here."},
        {"zh": "气泡一串串升上去", "en": "Bubbles rise in strings."},
        {"zh": "我在水下张望", "en": "I peer through the green water."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你不该下到水里", "en": "You shouldn't be in the water."},
        {"zh": "你在我水面上扑腾", "en": "You splash on my surface."},
        {"zh": "你呼吸撑不久", "en": "You can't hold your breath long."},
        {"zh": "我比你整个人都长", "en": "I'm longer than you are tall."},
        {"zh": "你腰上的钩子我看清了", "en": "I see the hook at your belt clearly."},
        {"zh": "你的东西在水里很慢", "en": "Your gear is slow in water."},
        {"zh": "我看得见你的腿", "en": "I see your legs."},
        {"zh": "你退到岸边去", "en": "Get back to the shore."},
        {"zh": "这片海只有一个主人", "en": "This sea has one master."},
        {"zh": "你别想游过我", "en": "You won't outswim me."},
        {"zh": "你腰上挂着钩子", "en": "You've a hook at your belt."},
        {"zh": "你在我影子里游", "en": "You're swimming in my shadow."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一道口子从背上拉开", "en": "A gash opened along my back."},
        {"zh": "我在水里打了个转", "en": "I spun once in the water."},
        {"zh": "侧腹的鳞翻了起来", "en": "The scales on my flank peeled up."},
        {"zh": "我很少会受伤", "en": "I'm rarely hurt."},
        {"zh": "红色在水里一层层散开", "en": "Red spreads in layers through the water."},
        {"zh": "我还游得动呢", "en": "I can still swim."},
        {"zh": "你比看起来有力", "en": "You're stronger than you look."},
        {"zh": "我不退，这是我的水域", "en": "I won't retreat; these are my waters."},
        {"zh": "这一口我记着", "en": "I'll remember that blow."},
        {"zh": "再咬一次也不迟", "en": "One more bite won't hurt."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这点分量不够瞧", "en": "Not worth a glance."},
        {"zh": "我不吃扔下来的东西", "en": "I don't eat what's thrown to me."},
        {"zh": "水里的血味更好", "en": "Blood in the water is better."},
        {"zh": "你手里的是鱼吗", "en": "Is that a fish in your hand?"},
        {"zh": "扔得再远一点", "en": "Throw it farther."},
        {"zh": "我不为这个露出牙齿", "en": "I won't show my teeth for that."},
        {"zh": "你太靠近水边了", "en": "You're too near the water's edge."},
        {"zh": "这点分量不值得我动", "en": "Not worth my moving."},
        {"zh": "把它放回水里", "en": "Put it back in the water."},
        {"zh": "再多给我一点", "en": "More than that."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在礁石上？不，是我", "en": "You hit the reef? No, me."},
        {"zh": "我这么长，转身要时间", "en": "I'm this long; turning takes time."},
        {"zh": "水流把你推开了", "en": "The current pushed you aside."},
        {"zh": "你碰到我的侧腹了", "en": "You touched my flank."},
        {"zh": "我不习惯被碰", "en": "I'm not used to being touched."},
        {"zh": "这一下连水都晃了", "en": "Even the water swayed."},
        {"zh": "你的东西卡在我鳍上", "en": "Your gear snagged my flipper."},
        {"zh": "让开，我要游过", "en": "Make way; I swim through."},
        {"zh": "我在水里比你灵活", "en": "I'm nimbler than you in water."},
        {"zh": "退回浅滩上去", "en": "Go back to the shallows."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这片海不需要第二个主人", "en": "This sea needs no second master."},
        {"zh": "这种时候不该出现在这儿", "en": "Not the time for it."},
        {"zh": "我只在意水域", "en": "I care only for my waters."},
        {"zh": "你问得毫无意义", "en": "Your question means nothing."},
        {"zh": "我已经很老了", "en": "I'm very old."},
        {"zh": "深水里不谈这些", "en": "Not in the deep."},
        {"zh": "我独占这片湾", "en": "I keep this bay alone."},
        {"zh": "你快快游开去", "en": "Go away."},
        {"zh": "水会带走这些声音", "en": "The water carries such words away."},
        {"zh": "别在我水里说", "en": "Not in my water."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我这身长你抬不起", "en": "You can't lift this length."},
        {"zh": "我的身长超过你的船", "en": "I'm longer than your boat."},
        {"zh": "这样我的鳍折了", "en": "Held so, my flipper folds."},
        {"zh": "把我送回深水", "en": "Put me back in deep water."},
        {"zh": "我离水撑不了多久", "en": "I won't last long out of water."},
        {"zh": "你抓住的是我的鳞", "en": "You've grabbed my scales."},
        {"zh": "你的手太小了", "en": "Your hands are too small."},
        {"zh": "你会被水冲走", "en": "The water will take you."},
        {"zh": "把你的鳍松开", "en": "Let go."},
        {"zh": "放低一点，慢慢来", "en": "Lower me slowly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了我的水域", "en": "You've entered my waters."},
        {"zh": "我比你的船还快", "en": "I'm faster than your boat."},
        {"zh": "你回头，我就在那儿", "en": "Turn back and I'm there."},
        {"zh": "水里没人帮你", "en": "No one helps you in the water."},
        {"zh": "我要把你驱出去", "en": "I'll drive you out."},
        {"zh": "这片海湾是我先来的", "en": "I was in this bay first."},
        {"zh": "你的气味留在这片湾里", "en": "Your scent stays in this bay."},
        {"zh": "别往岸边游去", "en": "Don't swim for the shore."},
        {"zh": "我只需要咬一次", "en": "One bite is all I need."},
        {"zh": "破水的时候到了", "en": "Time to break the surface."},
        {"zh": "水会留下痕迹", "en": "The water will keep the trace."},
        {"zh": "那艘船救不了你", "en": "That boat won't save you."},
        {"zh": "这片水域只有一条路", "en": "There's only one way through this water."},
        {"zh": "你还有几口气", "en": "How many breaths left?"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我就在你下面", "en": "I'm beneath you."},
        {"zh": "水底那道影子是我的尾巴", "en": "That shape below is my tail."},
        {"zh": "你游泳的姿势太乱", "en": "Your swimming is all wrong."},
        {"zh": "我已经绕到你前面", "en": "I'm already ahead of you."},
        {"zh": "你很慢，我很有耐心", "en": "You're slow; I'm patient."},
        {"zh": "你在往深处游", "en": "You're heading deeper."},
        {"zh": "水面在我背上", "en": "The surface rides on my back."},
        {"zh": "你听不见我过来", "en": "You can't hear me coming."},
        {"zh": "这一口从下面来", "en": "This bite comes from below."},
        {"zh": "礁石挡住了你的退路", "en": "The reef blocks your retreat."},
        {"zh": "别再蹬你的腿", "en": "Don't kick."},
        {"zh": "深水对你更糟", "en": "Deep water is worse for you."},
        {"zh": "我数你的气泡", "en": "I'm counting your bubbles."},
        {"zh": "就快要追上了", "en": "Almost."},
        {"zh": "水面上的光挡了你的眼", "en": "The glare on the surface blinds you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一口就咬住了", "en": "Seized."},
        {"zh": "这一口能咬穿船板", "en": "These jaws bite through planks."},
        {"zh": "你被我带进了深处", "en": "I've taken you down into the deep."},
        {"zh": "浪打上了礁石", "en": "The wave broke over the reef."},
        {"zh": "别挣，挣不脱", "en": "Don't struggle; you can't."},
        {"zh": "我的力气还留着大半", "en": "Most of my strength is still held back."},
        {"zh": "这一口只是试试牙", "en": "That bite only tested my teeth."},
        {"zh": "水里没有地方躲", "en": "Nowhere to hide in water."},
        {"zh": "你还在我嘴里", "en": "You're still in my jaws."},
        {"zh": "再来试一次吧", "en": "Try again."},
        {"zh": "这片水域清净了", "en": "These waters are quiet again."},
        {"zh": "有本事浮上去", "en": "Surface if you can."},
        {"zh": "已经全都结束", "en": "Finished."},
        {"zh": "我要沉下去了", "en": "I'm diving."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我一路从海沟游上来", "en": "I swam up from the trench."},
        {"zh": "海床动了一下", "en": "The seabed stirred."},
        {"zh": "我的背鳍破了水面", "en": "My fin breaks the surface."},
        {"zh": "这片海湾从今天起有主", "en": "This bay has a master from today."},
        {"zh": "水里的鱼都散了", "en": "The fish scattered."},
        {"zh": "我先绕上一圈", "en": "Let me circle once first."},
        {"zh": "我的身长还在长", "en": "I'm still growing."},
        {"zh": "这深度让我舒服", "en": "This depth is comfortable."},
        {"zh": "谁在我的水面上", "en": "Who's on my surface?"},
        {"zh": "我闻到了船的味道", "en": "I smell a boat."},
        {"zh": "我把头探出水面", "en": "I lift my head above the surface."},
        {"zh": "这一带礁石我熟", "en": "I know these rocks."},
        {"zh": "水面非常平静", "en": "The surface is still."},
        {"zh": "我在暗处绕了很多圈", "en": "I've circled many times in the dark."},
        {"zh": "潮水正在上涨", "en": "The tide is rising."},
        {"zh": "这片湾容不下吵闹", "en": "This bay tolerates no noise."},
        {"zh": "今天的海很清", "en": "The sea is clear today."},
        {"zh": "我要巡视一遍", "en": "I'll patrol the bay."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上的火烤得我鳞片发烫", "en": "Fire on the water heats my scales."}
      ]
