{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "四蹄压得地面发闷", "en": "My four feet make a muffled thud."},
        {"zh": "颈盾在阳光下很亮", "en": "My frill gleams in the sun."},
        {"zh": "我一步一顿地走过草地", "en": "I plod across the grass."},
        {"zh": "角往前倾，随时准备", "en": "My horns tilt forward, ready."},
        {"zh": "蹄印在泥里排成一线", "en": "My hoofprints line up in the mud."},
        {"zh": "尾巴拨开一丛蕨", "en": "My tail parts a clump of ferns."},
        {"zh": "我吃一口，走两步", "en": "A mouthful, then two steps."},
        {"zh": "这身架子很沉", "en": "This frame is heavy."},
        {"zh": "我的步子比同伴稳", "en": "My gait is steadier than my herd's."},
        {"zh": "我绕开幼崽站的地方", "en": "I step around where the young stand."},
        {"zh": "走过湿地时我放慢", "en": "I slow at the marsh."},
        {"zh": "我抬头看了看林缘", "en": "I glance at the forest's edge."},
        {"zh": "我的颈盾挡住了后面的视线", "en": "The frill blocks what's behind me."},
        {"zh": "走一段我就停下听", "en": "Every so often I stop and listen."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头啃草", "en": "I lower my head to graze."},
        {"zh": "角上挂着几根草", "en": "Grass hangs from my horns."},
        {"zh": "我慢慢地咀嚼", "en": "I chew slowly."},
        {"zh": "群里的气味我都认得", "en": "I know every scent in the herd."},
        {"zh": "风从海那边来", "en": "The wind comes off the sea."},
        {"zh": "尾巴扫开一只牛虻", "en": "My tail flicks a horsefly away."},
        {"zh": "此刻没什么可怕的", "en": "Nothing to fear right now."},
        {"zh": "重心落在后蹄上", "en": "My weight settles on my hind hooves."},
        {"zh": "我在听虫鸣声", "en": "I listen to the insects."},
        {"zh": "晒着太阳挺好", "en": "Good to stand in the sun."},
        {"zh": "小的一直在叫", "en": "The young keep calling."},
        {"zh": "我站着也能打盹", "en": "I can doze standing."},
        {"zh": "颈盾上的旧痕还在", "en": "Old scars remain on my frill."},
        {"zh": "我不想被这么多眼睛盯着", "en": "I don't want this many eyes on me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我的草地上", "en": "You're standing on my grass."},
        {"zh": "你把角对着我试试", "en": "Try pointing horns at me."},
        {"zh": "我没打算惹事", "en": "I don't mean trouble."},
        {"zh": "你后退三步，我才放松", "en": "Back up three steps and I'll relax."},
        {"zh": "我的角不是给人玩的", "en": "These horns aren't toys."},
        {"zh": "你在看我的颈盾", "en": "You're staring at my frill."},
        {"zh": "我比你想象的重", "en": "I'm heavier than you imagine."},
        {"zh": "你身上有别的兽味", "en": "You smell of other beasts."},
        {"zh": "这附近有幼崽", "en": "There are young nearby."},
        {"zh": "你别朝那边走", "en": "Don't go that way."},
        {"zh": "你走开一点，我在吃草", "en": "Step back; I'm grazing."},
        {"zh": "我认得你这种站姿", "en": "I know that kind of stance."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的颈盾被砍了", "en": "My frill was cut."},
        {"zh": "这一下砸在背上", "en": "That landed on my back."},
        {"zh": "我退了半步远些", "en": "I gave half a step."},
        {"zh": "你找到了侧面的空当", "en": "You found my flank."},
        {"zh": "角上裂了一道", "en": "A crack on my horn."},
        {"zh": "疼归疼，四蹄还钉着", "en": "Pain or not, my hooves stay planted."},
        {"zh": "我从喉咙里挤出声音", "en": "A sound forced out of my throat."},
        {"zh": "这伤不算什么", "en": "This wound is nothing."},
        {"zh": "我还能冲一次", "en": "I can still charge."},
        {"zh": "你最好往后退", "en": "You'd better step back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那几根草塞不住牙", "en": "Those few stalks won't fill a tooth."},
        {"zh": "我不吃奇怪的东西", "en": "I don't eat strange things."},
        {"zh": "放下，我自己来", "en": "Set it down; I'll help myself."},
        {"zh": "这点分量不够塞牙", "en": "Not enough to fill a tooth."},
        {"zh": "你举得比草还高", "en": "You hold it above the grass."},
        {"zh": "我不为吃的冒险", "en": "I won't risk myself for food."},
        {"zh": "那边草更多些", "en": "There's more grass over there."},
        {"zh": "这点草只够垫牙", "en": "That grass barely pads my teeth."},
        {"zh": "我不挑，但也不傻", "en": "I'm not picky, but not foolish."},
        {"zh": "退开，我要吃了", "en": "Step back; I'm eating."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我肩膀撞到你", "en": "My shoulder caught you."},
        {"zh": "你撞我像撞树", "en": "You hit me like a tree."},
        {"zh": "我只退了一步", "en": "I gave one step."},
        {"zh": "地上都被我踩陷了", "en": "I pressed the ground down."},
        {"zh": "借过，别挡着角", "en": "Out of the way, don't block my horns."},
        {"zh": "你没受伤了吧", "en": "You're not hurt?"},
        {"zh": "不过是擦了一下肩", "en": "That was only a brush of shoulders."},
        {"zh": "角尖擦过你的腰间", "en": "My horn tip grazed your waist."},
        {"zh": "步子太大，收不住", "en": "My stride is long; I can't stop."},
        {"zh": "我侧了下身，角差点划到你", "en": "I turned my flank; my horn nearly caught you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我守的是群，不是伴", "en": "I guard a herd, not a mate."},
        {"zh": "群里幼崽还没走远", "en": "The calves haven't gone far yet."},
        {"zh": "先看看周围有没有危险", "en": "First, check for danger."},
        {"zh": "角要碰角才算回应", "en": "Horns must meet horns in answer."},
        {"zh": "我动作笨，别催", "en": "I'm clumsy; don't rush me."},
        {"zh": "群里的都在看", "en": "The herd is watching."},
        {"zh": "慢慢来就好了", "en": "Slowly is fine."},
        {"zh": "这时候该吃草", "en": "This is grazing time."},
        {"zh": "换一个时候吧", "en": "Another time."},
        {"zh": "我们守好这片地就行", "en": "Let's just hold this ground."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这身架子你抬不动", "en": "You can't lift this frame."},
        {"zh": "我的角会顶到你", "en": "My horns will catch you."},
        {"zh": "放下，我自己站", "en": "Set me down; I stand myself."},
        {"zh": "这姿势我四蹄都使不上劲", "en": "Like this, all four feet are useless."},
        {"zh": "你会被压扁的", "en": "You'd be crushed."},
        {"zh": "别扯我的颈盾", "en": "Don't pull my frill."},
        {"zh": "我这么重，你撑不住", "en": "I'm too heavy for you."},
        {"zh": "别揪我的颈盾", "en": "Don't pull my frill."},
        {"zh": "地离我太远了", "en": "The ground is too far."},
        {"zh": "放低点，慢慢放", "en": "Lower me slowly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "再近一步就进我的角下", "en": "One step closer and you're under my horns."},
        {"zh": "我不喜欢被逼近", "en": "I dislike being cornered."},
        {"zh": "角已经低下来了", "en": "My horns are lowered."},
        {"zh": "站定别往前走", "en": "Stand and go no further."},
        {"zh": "退到篱笆外面", "en": "Get beyond the fence."},
        {"zh": "我身上有伤也照样冲", "en": "Wounded or not, I charge."},
        {"zh": "你退得慢了半拍", "en": "You retreated half a beat too late."},
        {"zh": "你挡住幼崽了", "en": "You're blocking the young."},
        {"zh": "我不喊，我直接冲", "en": "No bellow; I just charge."},
        {"zh": "这是最后的警告", "en": "This is the final warning."},
        {"zh": "我的角尖对着你", "en": "My horn tips face you."},
        {"zh": "你的步子我一步不落", "en": "I don't miss a single step of yours."},
        {"zh": "你后退了，很好", "en": "You're backing off. Good."},
        {"zh": "我的角可不等你准备好", "en": "My horns won't wait for you to be ready."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "头压得比草还低", "en": "My head is lower than the grass."},
        {"zh": "我的前腿在刨土", "en": "My forelegs paw the dirt."},
        {"zh": "你每一步我都看着", "en": "I watch your every step."},
        {"zh": "颈盾在后面护着我", "en": "The frill guards my back."},
        {"zh": "这身重量就是武器", "en": "This weight is my weapon."},
        {"zh": "你退到石头后也没用", "en": "A rock won't stop me."},
        {"zh": "我冲起来收不住", "en": "Once I charge, I can't stop."},
        {"zh": "你的皮挡不住角", "en": "Your hide won't stop a horn."},
        {"zh": "地面在我脚下震", "en": "The ground shakes under me."},
        {"zh": "我这里没人能拦", "en": "Nothing here can stop me."},
        {"zh": "就等你转过身", "en": "Waiting for you to turn."},
        {"zh": "风朝你那边吹", "en": "The wind blows toward you."},
        {"zh": "你吸气吸得太急了", "en": "You're drawing breath too fast."},
        {"zh": "别抬头，我在这儿", "en": "Don't look up; I'm here."},
        {"zh": "角尖就到你面", "en": "My horn tip is at you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我顶过去了！", "en": "Gore!"},
        {"zh": "这一下会用上全身", "en": "That one uses my whole body."},
        {"zh": "你退了半步远", "en": "You gave half a step."},
        {"zh": "我的角够硬的", "en": "My horns are hard enough."},
        {"zh": "你根本挡不住", "en": "You can't block it."},
        {"zh": "别站着当靶子", "en": "Don't stand there as a target."},
        {"zh": "这一下只是推", "en": "That was only a push."},
        {"zh": "再近我就不客气", "en": "Closer and I won't be gentle."},
        {"zh": "这一下撞得我直喘", "en": "That charge left me gasping."},
        {"zh": "退回去，回到篱笆外", "en": "Back off, back beyond the fence."},
        {"zh": "角尖擦到你了", "en": "My horn grazed you."},
        {"zh": "这一下撞得实", "en": "This one lands solid."},
        {"zh": "往后退开三步", "en": "Three steps back."},
        {"zh": "我不会追过去的", "en": "I won't chase."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从林缘走出来", "en": "I emerge from the forest's edge."},
        {"zh": "四蹄落在地上很实", "en": "My four feet land firmly."},
        {"zh": "草够我吃一顿", "en": "Grass enough here."},
        {"zh": "群在那边等我", "en": "The herd waits over there."},
        {"zh": "我先看看风向", "en": "Let me check the wind first."},
        {"zh": "河对岸有动静", "en": "Something moves across the river."},
        {"zh": "我用角顶开挡路的蕨叶", "en": "I push the ferns aside with my horns."},
        {"zh": "这里的草很嫩", "en": "The grass is tender here."},
        {"zh": "我得找块高一点的地", "en": "I need higher ground."},
        {"zh": "有人从这里过", "en": "Someone's been through."},
        {"zh": "我把角在树上蹭了蹭", "en": "I rub my horns on a tree."},
