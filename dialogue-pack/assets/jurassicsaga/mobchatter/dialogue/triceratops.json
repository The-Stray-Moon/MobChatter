        {"zh": "这地方适合歇脚", "en": "Good spot to rest."},
        {"zh": "天色还早着呢", "en": "Still early."},
        {"zh": "我慢慢走进去", "en": "I walk in slowly."},
        {"zh": "让幼崽先走过来", "en": "The young go first."},
        {"zh": "我不喜欢沼泽", "en": "I dislike the marsh."},
        {"zh": "远处传来雷声", "en": "Thunder in the distance."}
      ]
    },
