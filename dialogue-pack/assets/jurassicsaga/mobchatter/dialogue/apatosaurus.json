{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "长颈掠过树冠", "en": "My long neck sweeps past the treetops."},
        {"zh": "四足落地像闷鼓", "en": "Four feet drum the earth like a dull drum."},
        {"zh": "我一步能跨过半个院子", "en": "One step clears half a courtyard."},
        {"zh": "尾巴拖在身后，很长", "en": "My tail trails far behind me."},
        {"zh": "我在蕨丛里缓缓前进", "en": "I move slowly through the ferns."},
        {"zh": "地面被踩出浅坑", "en": "The ground dents where I walk."},
        {"zh": "低下头啃中层枝叶", "en": "I dip my head to browse mid-height leaves."},
        {"zh": "一边走一边吃", "en": "Eating as I go."},
        {"zh": "脖子低低地摆过去", "en": "My neck sways low across."},
        {"zh": "几步后再抬起来", "en": "Then lifts again after a few strides."},
        {"zh": "幼崽跟在我腿侧", "en": "The young ones walk at my flank."},
        {"zh": "我们拉成一条长线", "en": "We stretch into a long line."},
        {"zh": "林间的风被我分开", "en": "I part the forest wind as I go."},
        {"zh": "影子长得出奇", "en": "My shadow runs absurdly long."},
        {"zh": "我踩碎了一段枯木", "en": "I crush a dead log underfoot."},
        {"zh": "然后继续向前", "en": "Then keep moving."},
        {"zh": "步子慢，但从不间断", "en": "Slow, but never stopping."},
        {"zh": "这一片都是我的食场", "en": "This whole stretch is my feeding ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "四条柱子似的腿立着", "en": "Four column legs stand still."},
        {"zh": "脖子高高抬起", "en": "My neck held high."},
        {"zh": "我在嚼高处够来的叶", "en": "Chewing leaves brought down from high."},
        {"zh": "我的嘴巴慢慢磨着", "en": "My jaws grind slowly."},
        {"zh": "尾巴轻轻摆着", "en": "My tail sways lightly."},
        {"zh": "树下有群小兽", "en": "Small beasts shelter under me."},
        {"zh": "我从不赶它们走", "en": "I never drive them off."},
        {"zh": "几只小兽在我脚边躲雨。", "en": "A few small beasts shelter from the rain by my feet."},
        {"zh": "它啄了啄，我不动", "en": "It pecks. I stay still."},
        {"zh": "风穿过我的肋骨", "en": "Wind moves through my ribs."},
        {"zh": "侏罗纪的长颈，够到中层叶子。", "en": "My Jurassic neck reaches mid-level leaves."},
        {"zh": "我这长脖子，够到最高的树冠。", "en": "This long neck reaches the highest crowns."},
        {"zh": "我该换个地方吃了", "en": "Time to eat somewhere else."},
        {"zh": "先不动，再等一会", "en": "Not yet. A little longer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从很高处看你", "en": "I look at you from far above."},
        {"zh": "你站在我的脚边", "en": "You stand by my feet."},
        {"zh": "我把脖子弯下来", "en": "I bend my neck down."},
        {"zh": "头降到你面前", "en": "My head comes level with you."},
        {"zh": "你退了半步，我停了", "en": "You step back. I stop."},
        {"zh": "我只不过看看你", "en": "I'm only looking."},
        {"zh": "你的味道很陌生", "en": "Your scent is unfamiliar."},
        {"zh": "我又把脖子抬起来", "en": "I raise my neck again."},
        {"zh": "脖子又收回高处", "en": "Back to the heights."},
        {"zh": "你在我下面很安全", "en": "You're safe beneath me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "长脖子一低，整片蕨林都动。", "en": "One dip of my neck and the whole fern bed moves."},
        {"zh": "这一下打在我腿上", "en": "That hit my leg."},
        {"zh": "我往侧面挪了半步", "en": "I shift half a step aside."},
        {"zh": "皮很厚，但不代表没感觉", "en": "Thick hide, but I still feel it."},
        {"zh": "幼崽跑到我身后", "en": "The young scurry behind me."},
        {"zh": "低头看看，皮开了一道口。", "en": "Head down, and the hide has split open."},
        {"zh": "伤口其实很浅", "en": "It's shallow."},
        {"zh": "脖子重新抬高了", "en": "My neck goes back up."},
        {"zh": "我腿上的皮很厚，血却流得慢。", "en": "The hide on my leg is thick, yet the blood runs slow."},
        {"zh": "皮厚，也不等于不疼。", "en": "A thick hide does not mean no pain."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那些叶子举得很高", "en": "Those leaves are held up high."},
        {"zh": "我把脖子伸过去", "en": "My neck reaches over."},
        {"zh": "这下总算够到了", "en": "Got them at last."},
        {"zh": "一扯就是一大把", "en": "One pull brings a whole armful."},
        {"zh": "嚼起来非常慢", "en": "Slow chewing."},
        {"zh": "味道还挺不错", "en": "Good taste."},
        {"zh": "你还举着它们吗", "en": "Are you still holding them up?"},
        {"zh": "那我再等一会", "en": "Then I'll wait a while."},
        {"zh": "脖子太长了，很难低", "en": "My neck is long. Lowering it is hard."},
        {"zh": "你举高一点就好", "en": "Just hold them high."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你上方，你撞到的是我的腿", "en": "I'm above you. You hit my leg."},
        {"zh": "那条腿比柱子还粗", "en": "That leg is thicker than a pillar."},
        {"zh": "你一下子弹开了", "en": "You bounce off."},
        {"zh": "我垂下头瞧了瞧", "en": "I lower my head to look."},
        {"zh": "没踩到你，很好", "en": "Didn't step on you. Good."},
        {"zh": "我把整条腿横移，地面都震了。", "en": "I shift a whole leg sideways and the ground shakes."},
        {"zh": "我这一步非常慢", "en": "That step is slow."},
        {"zh": "我已经给了你时间", "en": "I gave you time."},
        {"zh": "我的脖子一低，够到树顶。", "en": "My neck dips to the treetops."},
        {"zh": "我又低头继续吃", "en": "I go back to eating."},
        {"zh": "我的脚趾比你人还大", "en": "My toe is bigger than you are."},
        {"zh": "你贴着我的脚背站着", "en": "You're standing against my foot."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们把长颈并在一起", "en": "Our long necks come together."},
        {"zh": "走路时肩并着肩", "en": "We walk shoulder to shoulder."},
        {"zh": "她吃高处，我吃低处", "en": "She browses high. I browse low."},
        {"zh": "同一片林子够我们吃", "en": "One wood can feed us both."},
        {"zh": "幼崽跟在两头之间", "en": "The young ones walk between us."},
        {"zh": "灰扑扑的，很小", "en": "Dusty and very small."},
        {"zh": "我们绕着它们走", "en": "We step around them."},
        {"zh": "夜里挤在一起睡", "en": "At night we sleep in a huddle."},
        {"zh": "热从彼此身上传过来", "en": "Warmth passes between us."},
        {"zh": "我对此已经很满意", "en": "I'm content with that."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用长颈卷了一把", "en": "My neck curls around a bunch."},
        {"zh": "扯下来，整个含着", "en": "I pull it loose and hold it all."},
        {"zh": "慢慢嚼，汁水往下滴", "en": "Chewing slowly, juice dripping."},
        {"zh": "地上的我不要", "en": "I don't take what's on the ground."},
        {"zh": "够不着才下来", "en": "Only if I can't reach up high."},
        {"zh": "再高一点就不太够", "en": "Even then, hardly worth it."},
        {"zh": "我把脖子抬高", "en": "I lift my neck."},
        {"zh": "上面那些更好", "en": "The ones up there are better."},
        {"zh": "我继续往上够", "en": "I keep reaching."},
        {"zh": "这一把终于到手", "en": "This armful is mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我听到树在响", "en": "I hear trees cracking."},
        {"zh": "我把脖子转向那边", "en": "My neck turns that way."},
        {"zh": "幼崽先往中间靠", "en": "The young ones crowd inward first."},
        {"zh": "我把它们围在里面", "en": "I close around them."},
        {"zh": "我的四条腿站定", "en": "Four legs set."},
        {"zh": "尾巴抬起来一点", "en": "My tail lifts slightly."},
        {"zh": "我一声都不吼", "en": "I don't bellow."},
        {"zh": "我只是站在那里", "en": "I just stand."},
        {"zh": "这个体积就是话", "en": "This size speaks for itself."},
        {"zh": "你明白这一点就好", "en": "As long as you understand."},
        {"zh": "再靠近就不同了", "en": "Any closer and it changes."},
        {"zh": "我把幼崽拢在四条腿之间。", "en": "I gather the calves between my four legs."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢吞吞转过身", "en": "I turn about, unhurried."},
        {"zh": "这一步要很久", "en": "That takes a while."},
        {"zh": "但方向已经对着你", "en": "But now I face you."},
        {"zh": "尾巴横在你和树之间", "en": "My tail lies between you and the trees."},
        {"zh": "你的退路并不多", "en": "Few ways out."},
        {"zh": "我从来不去追", "en": "I don't chase."},
        {"zh": "追不上，也没必要", "en": "Can't, and no need."},
        {"zh": "你走远一点就好", "en": "Just go far enough."},
        {"zh": "幼崽都在我身后", "en": "The young are behind me."},
        {"zh": "我低头看它们一眼", "en": "I glance down at them."},
        {"zh": "然后把头抬回来", "en": "Then raise my head again."},
        {"zh": "然后再看你一次", "en": "And look at you once more."},
        {"zh": "希望这是最后一次", "en": "I hope that's the last."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "尾巴扫过去，很慢但很重", "en": "My tail sweeps. Slow, but heavy."},
        {"zh": "这一下把你推出了几步", "en": "It shoves you several paces."},
        {"zh": "前脚抬起来又落下", "en": "My forefoot lifts and comes down."},
        {"zh": "落点在你旁边", "en": "It lands beside you."},
        {"zh": "地面塌了一块", "en": "The ground caves in."},
        {"zh": "我的脖子撞过来", "en": "My neck swings in."},
        {"zh": "我甩尾之前，先把幼崽护到身后。", "en": "Before I swing my tail, I push the calves behind me."},
        {"zh": "这是最后一次", "en": "This is the last time."},
        {"zh": "你挡住了，整个人在退", "en": "You block it, and you're sliding back."},
        {"zh": "我不追，继续吃", "en": "I don't follow. Back to eating."},
        {"zh": "幼崽都跟着我走", "en": "The young come with me."},
        {"zh": "就到这里为止", "en": "That's all."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里多了一根会动的柱子", "en": "A moving pillar appears in the wood."},
        {"zh": "然后又是一根", "en": "Then another."},
        {"zh": "我的四条腿落稳", "en": "Four legs settle."},
        {"zh": "脖子慢慢抬到树顶", "en": "My neck rises to the treetops."},
        {"zh": "附近的树都在摇", "en": "The nearby trees all shake."},
        {"zh": "鸟从树冠里飞起来", "en": "Birds burst from the canopy."},
        {"zh": "我先嚼了两口", "en": "I take two mouthfuls first."},
        {"zh": "这里的蕨很密", "en": "Dense ferns here."},
        {"zh": "够我吃上很久", "en": "Enough to last a while."},
        {"zh": "幼崽从后面跟上来", "en": "The young catch up behind me."},
        {"zh": "它们比我矮太多", "en": "They're so much shorter than me."},
        {"zh": "我放慢了脚步", "en": "So I slow my pace."},
        {"zh": "这样安排就刚好", "en": "That works."},
        {"zh": "我们慢慢往前走", "en": "We move on slowly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "皮上焦了一块，很刺鼻", "en": "A patch of hide burns, sharp and acrid."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时四条腿都震了", "en": "All four legs shock on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水深得抬不起头", "en": "The water is too deep to lift my head."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风推得我侧了一步", "en": "The blast nudges me a step sideways."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根箭插进我身侧的厚皮。", "en": "An arrow sticks in the thick hide of my flank."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "骨缝里一阵发酸", "en": "A sour ache runs between my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得抬不起脖子", "en": "Too hungry to lift my neck."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在背上，我全身一沉", "en": "Lightning hits my back and I sag."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的地空了", "en": "No ground beneath."}
      ]
    }
  }
}
