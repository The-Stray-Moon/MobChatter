{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面蜿蜒前进。", "en": "I wind forward along the ground."},
        {"zh": "身体一节节推动，很慢。", "en": "Segment by segment, very slow."},
        {"zh": "我从落叶上滑过去，没有声音。", "en": "I slide over the leaf litter without a sound."},
        {"zh": "我绕过树干，盘了一下。", "en": "I loop around a trunk."},
        {"zh": "我的舌头不断探出。", "en": "My tongue keeps slipping out."},
        {"zh": "我沿着灌木的根部走。", "en": "I follow the base of the brush."},
        {"zh": "我停下来，把头抬高。", "en": "I stop and lift my head."},
        {"zh": "落叶被我推开一条线。", "en": "The leaves part along my line."},
        {"zh": "我从草丛里露出一段身体。", "en": "Part of my body shows above the grass."},
        {"zh": "我慢慢地换了个方向。", "en": "I slowly change direction."},
        {"zh": "我缩起前半身，再往前伸。", "en": "I draw my front in, then extend."},
        {"zh": "我的尾巴扫过枯枝。", "en": "My tail brushes dry twigs."},
        {"zh": "我沿着阳光的边缘走。", "en": "I follow the edge of the sunlight."},
        {"zh": "我抬起身体前半截，探路。", "en": "I lift my front half to probe ahead."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘在石头旁边，不动。", "en": "I coil by a stone, still."},
        {"zh": "阳光落在我背上。", "en": "Sun lies on my back."},
        {"zh": "我的头搭在自己身上。", "en": "My head rests on my own coil."},
        {"zh": "只有舌头偶尔出来。", "en": "Only my tongue comes out now and then."},
        {"zh": "空气里有很多味道。", "en": "The air is full of scents."},
        {"zh": "我在分辨其中一种。", "en": "I'm sorting out one of them."},
        {"zh": "风把叶子吹到我身上。", "en": "Wind blows a leaf onto me."},
        {"zh": "我没有甩开它。", "en": "I don't shake it off."},
        {"zh": "这片石头是暖的。", "en": "This stone is warm."},
        {"zh": "我慢慢把身体收紧。", "en": "I slowly draw myself in."},
        {"zh": "附近有老鼠的味道。", "en": "There's a rat's scent nearby."},
        {"zh": "但现在不用急。", "en": "But there's no rush now."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的热量很大。", "en": "You give off a lot of heat."},
        {"zh": "我把头抬到和你眼睛一样高。", "en": "I raise my head level with your eyes."},
        {"zh": "我尝了尝空气。", "en": "I taste the air."},
        {"zh": "我往前移了一点。", "en": "I shift forward a little."},
        {"zh": "我下巴贴着地，没有要扑。", "en": "Chin to the ground, not about to lunge."},
        {"zh": "但我也不退。", "en": "But I won't back off either."},
        {"zh": "我的身体在展开。", "en": "My body is uncoiling."},
        {"zh": "你不必怕。", "en": "You don't have to be afraid."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下盘紧。", "en": "I coil tight at once."},
        {"zh": "身体里有一处疼。", "en": "There's a pain inside my body."},
        {"zh": "我慢慢展开，想逃。", "en": "I uncoil slowly, trying to flee."},
        {"zh": "鳞片上有了裂口。", "en": "A split opens between my scales."},
        {"zh": "蛇身挨了一下，我把盘解开。", "en": "Struck once, I loosen my coils."},
        {"zh": "我半截身子挤进石缝里。", "en": "Half my body squeezes into the crevice."},
        {"zh": "我的蛇身比我的脾气长。", "en": "My body is longer than my temper."},
        {"zh": "我抬起头发抖。", "en": "I lift my head, trembling."},
        {"zh": "还能动，鳞片还在。", "en": "Still moving. Scales still on."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有热的味道。", "en": "Something warm smells good."},
        {"zh": "你放下的东西，我闻到了。", "en": "I smell what you've set down."},
        {"zh": "先用舌头尝。", "en": "I taste with my tongue first."},
        {"zh": "这可以。", "en": "This will do."},
        {"zh": "我整个吞下去。", "en": "I swallow it whole."},
        {"zh": "不需要嚼。", "en": "No need to chew."},
        {"zh": "你手里的味道，让我的舌头动。", "en": "That smell in your hand makes my tongue flick."},
        {"zh": "我吃完还要待着。", "en": "After eating, I'll stay a while."},
        {"zh": "这点分量，塞不满我的肚子。", "en": "That much won't fill my belly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我盘紧了。", "en": "You bump me and I coil tight."},
        {"zh": "你那一脚，踩乱了我的盘。", "en": "Your step scattered my coils."},
        {"zh": "我把它抽回来。", "en": "I pull it back."},
        {"zh": "我没有发怒。", "en": "I'm not angry."},
        {"zh": "我只是退开。", "en": "I simply move away."},
        {"zh": "我们各自待着。", "en": "We each keep to ourselves."},
        {"zh": "我继续晒着。", "en": "I go back to basking."},
        {"zh": "我盘着的身子散开，从你脚边滑过。", "en": "My coiled body unspools and slides past your feet."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同类的味道很淡。", "en": "A kin's scent is faint."},
        {"zh": "我沿着它走了一段。", "en": "I follow it a while."},
        {"zh": "气味断在石头边。", "en": "The scent ends at a stone."},
        {"zh": "我盘起来等。", "en": "I coil and wait."},
        {"zh": "什么也没有来。", "en": "Nothing comes."},
        {"zh": "天气还暖。", "en": "It's still warm."},
        {"zh": "我可以再等等。", "en": "I can wait longer."},
        {"zh": "石头会一直暖着。", "en": "The stone will stay warm."},
        {"zh": "时间很长。", "en": "There's plenty of time."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "它比我以为的大。", "en": "It's bigger than I thought."},
        {"zh": "我试试能不能吞。", "en": "I try to swallow it."},
        {"zh": "下巴脱开了。", "en": "My jaw unhinges."},
        {"zh": "我慢慢往下送。", "en": "I work it down slowly."},
        {"zh": "卡住了。", "en": "It's stuck."},
        {"zh": "这个太宽了。", "en": "This is too wide."},
        {"zh": "我盘回去。", "en": "I coil back."},
        {"zh": "等它软一点。", "en": "Wait for it to soften."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有热源在移动。", "en": "A heat source is moving."},
        {"zh": "脖子鼓起来，我先吸一口气。", "en": "Neck swelling, I take one deep breath."},
        {"zh": "舌头尝到了位置。", "en": "My tongue gives me the position."},
        {"zh": "我松开盘，把前半身放平。", "en": "I uncoil and flatten my front half."},
        {"zh": "它没有注意。", "en": "It isn't paying attention."},
        {"zh": "我靠近到一臂之距。", "en": "I close to within a body length."},
        {"zh": "我的舌尖尝出你的方向。", "en": "My tongue-tip tastes which way you went."},
        {"zh": "准备。", "en": "Ready."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘起来，比站着宽。", "en": "Coiled, I'm wider than I stand."},
        {"zh": "叶子挡住了我一半。", "en": "The leaves hide half of me."},
        {"zh": "我沿着草根，一寸寸挪近。", "en": "Along the grass roots, inch by inch."},
        {"zh": "它往另一边走了。", "en": "It's moving the other way."},
        {"zh": "我绕过去。", "en": "I go around."},
        {"zh": "我把它逼到石头边。", "en": "I press it toward the stone."},
        {"zh": "我抬起身子。", "en": "I raise my body."},
        {"zh": "我的影子罩住它。", "en": "My shadow covers it."},
        {"zh": "安静，等它再近一尺。", "en": "Quiet. Wait until it's another foot closer."},
        {"zh": "我缠上去。", "en": "I wrap around it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我先缠住，再把嘴凑上去。", "en": "First I coil, then I bring my mouth in."},
        {"zh": "身体一圈圈缠上去。", "en": "My body loops around it."},
        {"zh": "每一圈都收紧。", "en": "Each loop tightens."},
        {"zh": "它挣扎，我缠得更紧。", "en": "It struggles; I tighten."},
        {"zh": "这一下不为吃，只为制服。", "en": "This isn't to eat. It's to subdue."},
        {"zh": "它抽动一下，我收一圈。", "en": "It twitches once, and I take up a coil."},
        {"zh": "我的肌肉很酸。", "en": "My muscles ache."},
        {"zh": "我松开一点。", "en": "I loosen a little."},
        {"zh": "它喘上气了。", "en": "It can breathe again."},
        {"zh": "我盘回暖石上。", "en": "I coil back on the warm stone."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "鳞片上沾着湿土。", "en": "Wet soil clings to my scales."},
        {"zh": "这里比巢里亮。", "en": "It's brighter than my nest."},
        {"zh": "我先盘起来。", "en": "I coil up first."},
        {"zh": "周围的味道很多。", "en": "There are many scents around."},
        {"zh": "我慢慢展开一段身体。", "en": "I extend part of my body."},
        {"zh": "我找到一块石头。", "en": "I find a stone."},
        {"zh": "爬上去，摊开。", "en": "I climb on and spread out."},
        {"zh": "风从头上过。", "en": "Wind passes overhead."},
        {"zh": "有东西在远处。", "en": "Something is far off."},
        {"zh": "让它过来。", "en": "Let it come."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我在地上翻滚，压着火。", "en": "I roll to smother the flames."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我砸在落叶上，身体摊开。", "en": "I hit the leaf litter, my body spread."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进来，我拼命抬头上浮。", "en": "Water floods in; I fight to raise my head."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀到石头边。", "en": "The blast throws me against a stone."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光锁住我，一圈也挣不开。", "en": "Light locks me so I can't loosen a single coil."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿让我动作更慢。", "en": "Hunger slows me further."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的身体走。", "en": "Lightning runs the length of my body."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我坠下去，身体拉长。", "en": "I fall, my body stretched long."}
      ]
    }
  }
}
