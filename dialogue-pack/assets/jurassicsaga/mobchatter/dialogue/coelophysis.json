{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跑得轻快，像风。", "en": "I run lightly, like wind."},
        {"zh": "细细的腿一跨就是几步。", "en": "My slender legs cover ground in strides."},
        {"zh": "我贴着地面飞跑。", "en": "I race low over the ground."},
        {"zh": "尾巴拉直，保持平衡。", "en": "My tail holds straight for balance."},
        {"zh": "我绕着空地的边缘跑。", "en": "I run around the edge of the clearing."},
        {"zh": "我跑跑停停，四处看。", "en": "I run and pause, looking about."},
        {"zh": "晚三叠的风很干。", "en": "The Late Triassic wind is dry."},
        {"zh": "我一跃跨过小沟。", "en": "I leap the little ditch."},
        {"zh": "我身轻，踩不塌草。", "en": "I am light; the grass does not bend."},
        {"zh": "我转向很快。", "en": "I turn very fast."},
        {"zh": "我钻过灌木的缝。", "en": "I slip through a gap in the brush."},
        {"zh": "新墨西哥的荒原，我记得。", "en": "I remember the New Mexico badlands."},
        {"zh": "我跑一段，再停下。", "en": "I run a stretch, then stop."},
        {"zh": "脚爪在地上留下细印。", "en": "My claws leave fine prints."},
        {"zh": "我几乎是蹦着走的。", "en": "I am almost bounding."},
        {"zh": "我贴着一块石头绕。", "en": "I skirt around a stone."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，脖子很细。", "en": "I stand on a slender neck."},
        {"zh": "我抬头看远处的动静。", "en": "I raise my head to distant movement."},
        {"zh": "我压着身子不动。", "en": "I crouch still."},
        {"zh": "我左看右看。", "en": "I look left and right."},
        {"zh": "这一带很空。", "en": "This area is empty."},
        {"zh": "我的眼睛在两边。", "en": "My eyes sit on either side."},
        {"zh": "我抖了抖尾巴。", "en": "I flick my tail."},
        {"zh": "我听到很细的声响。", "en": "I catch a very faint sound."},
        {"zh": "我不安分，总想动。", "en": "I cannot stay still; I always want to move."},
        {"zh": "我抬起一只脚又放下。", "en": "I lift a foot and set it back."},
        {"zh": "我在等一个能追的东西。", "en": "I am waiting for something worth chasing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你个头太大了。", "en": "You are far too big."},
        {"zh": "我一边看一边算距离。", "en": "I watch you and measure the distance."},
        {"zh": "我在掂量你的胳膊有多重。", "en": "I am weighing how heavy your arms are."},
        {"zh": "我的长腿随时准备跳开。", "en": "My long legs are ready to spring away."},
        {"zh": "你的动作我能看清。", "en": "I can follow everything you do."},
        {"zh": "我个头小，但不慢。", "en": "I am small, but not slow."},
        {"zh": "我转到你的侧边。", "en": "I shift to your flank."},
        {"zh": "你的影子压住我。", "en": "Your shadow covers me."},
        {"zh": "我不打算硬碰。", "en": "I do not plan to take you head-on."},
        {"zh": "我跳了一下，试试你。", "en": "I hop once to test you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我细叫了一声。", "en": "I gave a thin cry."},
        {"zh": "我跳开好远。", "en": "I sprang a long way off."},
        {"zh": "我三条腿撑地，喘得很急。", "en": "I prop myself on three legs and pant hard."},
        {"zh": "羽毛掉了些。", "en": "Some feathers came loose."},
        {"zh": "我还能撒腿。", "en": "I can still run."},
        {"zh": "我绕了个圈。", "en": "I ran a circle."},
        {"zh": "我的细肋骨响了一下。", "en": "One of my slender ribs creaks."},
        {"zh": "我提脚试了试。", "en": "I tested a foot."},
        {"zh": "细羽里渗出的血弄湿了脚。", "en": "Blood seeping through my feathers wets my feet."},
        {"zh": "我记着你的位置。", "en": "I have your position."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么味道。", "en": "What is that smell."},
        {"zh": "我靠近一点。", "en": "I come a little closer."},
        {"zh": "太近了，我退。", "en": "Too close. I back off."},
        {"zh": "你那块肉，我一口能撕开。", "en": "I could tear that meat apart in one bite."},
        {"zh": "我伸头闻了闻。", "en": "I stretch my head and sniff."},
        {"zh": "别急着给我。", "en": "Do not hand it over so fast."},
        {"zh": "我衔住就跑。", "en": "I take it and run."},
        {"zh": "分量不算多。", "en": "A modest portion."},
        {"zh": "再造出点味来。", "en": "Make more of that smell."},
        {"zh": "我信你一次。", "en": "I will trust you once."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞退一截。", "en": "I am knocked back a stretch."},
        {"zh": "你像一堵墙。", "en": "You are like a wall."},
        {"zh": "我立刻爬起来。", "en": "I scramble up at once."},
        {"zh": "我身轻，撞不疼你。", "en": "I am light; the bump will not hurt you."},
        {"zh": "地上多了些土。", "en": "A little dirt lifts from the ground."},
        {"zh": "我退开绕路。", "en": "I back off and go around."},
        {"zh": "我换一条路。", "en": "I take another route."},
        {"zh": "我这么轻，撞一下也要还手。", "en": "I'm light, but a shove still earns a bite."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们跑一样的路线。", "en": "We run the same line."},
        {"zh": "一起追，容易得手。", "en": "Hunting together, we do better."},
        {"zh": "你从那边包过去。", "en": "You circle from that side."},
        {"zh": "我轻，先进去试。", "en": "I am light, so I go in first."},
        {"zh": "别撞上石头。", "en": "Do not hit the stones."},
        {"zh": "风从这边来。", "en": "The wind comes from here."},
        {"zh": "一起加快速度。", "en": "Speed up together."},
        {"zh": "没有前后之分。", "en": "Neither of us leads."},
        {"zh": "跑起来才知道。", "en": "We will see once we run."},
        {"zh": "快跟上来。", "en": "Keep up."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我含住就窜。", "en": "I take it and dart off."},
        {"zh": "这一口太小。", "en": "This bite is too small."},
        {"zh": "我身子轻，跑得比风快。", "en": "Light body, faster than the wind."},
        {"zh": "我把它扔掉。", "en": "I drop it."},
        {"zh": "我含着跑了一段。", "en": "I carried it in my jaw a while."},
        {"zh": "这已经不新鲜。", "en": "This is no longer fresh."},
        {"zh": "我先把它藏起。", "en": "I will hide it first."},
        {"zh": "有人来抢吗。", "en": "Will someone come for it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你脚步动了。", "en": "Your step moved."},
        {"zh": "我盯住你的脚。", "en": "I fix on your feet."},
        {"zh": "我伏下细身子。", "en": "I flatten my narrow body."},
        {"zh": "先试上一试。", "en": "Let me test it."},
        {"zh": "你转身太慢。", "en": "You turn too slowly."},
        {"zh": "我找到空隙了。", "en": "I have found a gap."},
        {"zh": "我就从侧面。", "en": "I come from the side."},
        {"zh": "我摆好架势。", "en": "I set myself."},
        {"zh": "我离了地面。", "en": "My feet left the ground."},
        {"zh": "别把眼合上。", "en": "Do not close your eyes."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一路缀着你。", "en": "I tag along after you."},
        {"zh": "你走得快，我更快。", "en": "You move fast; I am faster."},
        {"zh": "我绕着你跑圈。", "en": "I circle you at a run."},
        {"zh": "你摸不到我的位置。", "en": "You cannot pin where I am."},
        {"zh": "我的尾巴一转就换向。", "en": "One tail turn and I change direction."},
        {"zh": "你抬头，我已经过去了。", "en": "You look up, and I am already past."},
        {"zh": "地面不平，我踩着石块走。", "en": "The ground is uneven; I use the stones."},
        {"zh": "我把你带偏方向。", "en": "I am pulling you off your line."},
        {"zh": "再绕上一圈。", "en": "One more circuit."},
        {"zh": "你开始慢了。", "en": "You are slowing."},
        {"zh": "这里最合适。", "en": "This spot is best."},
        {"zh": "几乎咬到脚跟。", "en": "Nearly at your heels."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一跃咬住。", "en": "I leap and bite."},
        {"zh": "牙齿很小，但密。", "en": "My teeth are small but many."},
        {"zh": "你被抓了一下。", "en": "My claws caught you once."},
        {"zh": "我落了地就转身。", "en": "I land and turn."},
        {"zh": "这一口只划了皮。", "en": "That bite only grazed."},
        {"zh": "我跳了开去。", "en": "I sprang away."},
        {"zh": "你没打中我。", "en": "You missed me."},
        {"zh": "再扑上去一次。", "en": "One more pounce."},
        {"zh": "这股力气不大。", "en": "There is not much force in this."},
        {"zh": "我扑上你的小腿又弹开。", "en": "I dart at your calf and bounce away."},
        {"zh": "轻骨长腿，追不上我。", "en": "Light bones and long legs. You will not catch me."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "空地上闪过一个影子。", "en": "A shape flickers on the open ground."},
        {"zh": "我落在碎石上。", "en": "I land on the loose stones."},
        {"zh": "细细的腿一撑，站起来了。", "en": "Slender legs push me upright."},
        {"zh": "我抖了抖细腿。", "en": "I shake my thin legs."},
        {"zh": "晚三叠的太阳很白。", "en": "The Late Triassic sun is pale."},
        {"zh": "我跑了一圈，又转回来。", "en": "I run a lap and come back."},
        {"zh": "地上多了一串细印。", "en": "A line of fine prints appears."},
        {"zh": "我抬头看你的方向。", "en": "I raise my head toward you."},
        {"zh": "我不大，但很快。", "en": "I am not large, but I am quick."},
        {"zh": "什么都没抓到的感觉，很糟。", "en": "Catching nothing feels bad."},
        {"zh": "我把脖子缩低。", "en": "I lower my neck."},
        {"zh": "我从石头后面出来。", "en": "I come out from behind a stone."},
        {"zh": "我跑起来了。", "en": "I am running."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一靠近，我就蹿出去。", "en": "Fire came near, and I bolted."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时脚一滑。", "en": "My foot slipped on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水太深，我扑腾。", "en": "The water is too deep, and I thrash."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀得老远。", "en": "The shock throws me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过了我的腿。", "en": "Something passed through my leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这亮光让我头晕。", "en": "This brightness made me dizzy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "地上什么都没有。", "en": "There is nothing on the ground."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声就在耳边炸。", "en": "Thunder cracked right by my ear."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里连地都没有。", "en": "There is not even ground here."}
      ]
    }
  }
}
