{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我是这一群的头领", "en": "I lead this pack."},
        {"zh": "羽毛沿背脊竖起", "en": "Feathers rise along my spine."},
        {"zh": "我的爪子弹出来又收起", "en": "My claws extend, then retract."},
        {"zh": "雌性是队伍的中心", "en": "The females are the pack's core."},
        {"zh": "我走在队伍最前面", "en": "I walk at the front."},
        {"zh": "脚趾上的镰爪不落地", "en": "My sickle claw stays off the ground."},
        {"zh": "我们排成一条直线", "en": "We move in a line."},
        {"zh": "我用低鸣分配位置", "en": "A low call assigns positions."},
        {"zh": "尾巴帮我平衡转向", "en": "My tail balances every turn."},
        {"zh": "白垩纪的林地，我熟", "en": "I know these Cretaceous woods."},
        {"zh": "每一步都在数着距离", "en": "Every step measures the gap."},
        {"zh": "我回头看了一眼队伍", "en": "I look back at the pack."},
        {"zh": "落后的会被留下", "en": "The stragglers get left behind."},
        {"zh": "我不叫喊，我只示意", "en": "I don't shout; I signal."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，队伍也停着", "en": "I stand, and the pack stands."},
        {"zh": "我的等级写在姿态上", "en": "My rank shows in my posture."},
        {"zh": "幼崽不敢靠近我", "en": "The juveniles keep their distance."},
        {"zh": "首领不必多说话", "en": "A leader needn't talk much."},
        {"zh": "我在听林子分层的声响", "en": "I listen to the forest's layers."},
        {"zh": "我清点着部下", "en": "I count my pack."},
        {"zh": "我的羽毛有些乱", "en": "My feathers are a bit ruffled."},
        {"zh": "爪子在地上留下痕迹", "en": "My claws left marks."},
        {"zh": "风带来了猎物的味道", "en": "The wind carries prey scent."},
        {"zh": "我抬头，喉咙动了动", "en": "I raise my head and my throat moves."},
        {"zh": "我在定今晚的方向", "en": "I'm choosing tonight's direction."},
        {"zh": "不服的会被赶出去", "en": "The disobedient get driven out."},
        {"zh": "我们等着天黑", "en": "We wait for dark."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你不是我的部下", "en": "You're not one of mine."},
        {"zh": "我已经评估过你", "en": "I've assessed you."},
        {"zh": "你的站姿太松", "en": "Your stance is loose."},
        {"zh": "我的部落在你身后", "en": "My pack is behind you."},
        {"zh": "首领看人从不回避", "en": "A leader never avoids a gaze."},
        {"zh": "你退，或者被围", "en": "Either retreat or be surrounded."},
        {"zh": "我在看你有无同伴", "en": "Checking whether you have a pack."},
        {"zh": "你是一个人，很好", "en": "You're alone; good."},
        {"zh": "喉咙里的低鸣是警告", "en": "The rumble in my throat is a warning."},
        {"zh": "我还没有决定", "en": "I haven't decided yet."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一声低鸣，队伍后撤", "en": "I rumble and the pack falls back."},
        {"zh": "羽毛被撕开了", "en": "My feathers got torn."},
        {"zh": "我依然还是首领", "en": "I'm still the leader."},
        {"zh": "我退到圈外重新整队", "en": "I step outside the ring to reset."},
        {"zh": "部下都在看着我", "en": "The pack is watching me."},
        {"zh": "首领不能倒下", "en": "A leader can't fall."},
        {"zh": "我的腿有点发僵", "en": "My leg has stiffened."},
        {"zh": "这处伤，我记着", "en": "I'll remember this wound."},
        {"zh": "队形并没有散", "en": "The formation holds."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉？先放在地上", "en": "Meat? Set it down first."},
        {"zh": "我不会为食物低头", "en": "I won't lower my head for food."},
        {"zh": "先让最弱的吃", "en": "The weakest eat first."},
        {"zh": "你手里的不够分", "en": "That's not enough to share."},
        {"zh": "我让部下去试", "en": "I'll send a subordinate first."},
        {"zh": "这是试探，不是讨好", "en": "This is a test, not flattery."},
        {"zh": "你放得太靠前了", "en": "You set it too close."},
        {"zh": "退到三步以外去", "en": "Back up three steps."},
        {"zh": "我不吃施舍来的东西", "en": "I don't eat handouts."},
        {"zh": "你另有别的意思", "en": "You mean something more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的肩膀", "en": "You hit my shoulder."},
        {"zh": "我的羽毛被压了一下", "en": "My feathers got pressed."},
        {"zh": "队伍立刻围拢上来", "en": "The pack closes in at once."},
        {"zh": "这一撞，你已被标记", "en": "That bump has marked you."},
        {"zh": "碰撞在等级里毫无意义", "en": "Bumping means nothing in rank."},
        {"zh": "你碰的是首领本人", "en": "You touched the leader."},
        {"zh": "一声低鸣，全队停住", "en": "One rumble and the pack halts."},
        {"zh": "别再碰我第二次", "en": "Don't touch me twice."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "最高等级的雌性说了算", "en": "The highest-ranked female decides."},
        {"zh": "我已经有位置了", "en": "I already hold a place."},
        {"zh": "这是群里面的事", "en": "This is a matter within the pack."},
        {"zh": "你不在我的群里", "en": "You're not in my pack."},
        {"zh": "羽色姿态猎术，缺一不可", "en": "Plumage, posture, hunting—all required."},
        {"zh": "先证明你会狩猎", "en": "Prove you can hunt first."},
        {"zh": "队伍需要的是稳定", "en": "The pack needs stability."},
        {"zh": "别站得比我更高", "en": "Don't stand taller than me."},
        {"zh": "我低鸣一声就是拒绝", "en": "One low call is a refusal."},
        {"zh": "回到你该在的位置", "en": "Return to where you belong."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我先让部下确认", "en": "I let a subordinate check it."},
        {"zh": "骨头归我所有", "en": "The bones are mine."},
        {"zh": "这点东西不够一群吃", "en": "Not enough for the pack."},
        {"zh": "我叼起来，把头抬高", "en": "I lift it, head high."},
        {"zh": "部下都在看着", "en": "The pack is watching."},
        {"zh": "分食要看等级高低", "en": "Sharing follows rank."},
        {"zh": "我不弯腰去捡东西", "en": "I don't stoop to pick it up."},
        {"zh": "这一块就留下", "en": "This one stays."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "现在开始包抄", "en": "Flank it."},
        {"zh": "从两侧散开去", "en": "Spread to both sides."},
        {"zh": "我从正面压上去", "en": "I take the front."},
        {"zh": "你是猎物，不是对手", "en": "You're prey, not a rival."},
        {"zh": "镰爪会比我先到", "en": "The sickle claw arrives first."},
        {"zh": "我们的队形已经成型", "en": "Our formation is set."},
        {"zh": "别指望跑得掉", "en": "Don't count on escaping."},
        {"zh": "队里最慢的也比你快", "en": "Even our slowest is faster than you."},
        {"zh": "你先流血，再倒下", "en": "You bleed first, then fall."},
        {"zh": "合围之后才开始", "en": "We begin once surrounded."},
        {"zh": "我从你右侧切进去", "en": "I cut in from your right."},
        {"zh": "后排已经绕到你身后", "en": "The rear rank is behind you."},
        {"zh": "你不用看，听声音就够了", "en": "No need to look; listen."},
        {"zh": "这是一次常规狩猎", "en": "This is routine hunting."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步把圈收紧", "en": "I tighten the circle, step by step."},
        {"zh": "队伍的呼吸都同步了", "en": "The pack breathes in sync."},
        {"zh": "你转向哪边都是后背", "en": "Whichever way you turn, your back shows."},
        {"zh": "镰爪不沾地，出手很快", "en": "My sickle claw stays raised; it's fast."},
        {"zh": "部下在等你犯错", "en": "The pack waits for your mistake."},
        {"zh": "你的脚步越来越零碎", "en": "Your steps grow choppy."},
        {"zh": "一声低鸣，左边收紧", "en": "One rumble and the left closes."},
        {"zh": "再一低鸣，右边收紧", "en": "Another, and the right closes."},
        {"zh": "你已经在喘了", "en": "You're panting."},
        {"zh": "我不累，我在分配体力", "en": "I don't tire; I ration effort."},
        {"zh": "我退一步，是为让你前进", "en": "I step back so you step forward."},
        {"zh": "你在往我预设的方向走", "en": "You're walking where I wanted."},
        {"zh": "这片林地没有直线可走", "en": "There are no straight lines in these woods."},
        {"zh": "每根树干都挡着你", "en": "Every trunk is against you."},
        {"zh": "你已经听了三次低鸣", "en": "You've heard three rumbles."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "镰爪划了下来", "en": "The sickle claw slashes down."},
        {"zh": "我跳起来扑你的肩", "en": "I leap for your shoulder."},
        {"zh": "羽毛炸开，显得更大", "en": "My feathers flare to look bigger."},
        {"zh": "一口咬住你的颈侧", "en": "A bite to the side of your neck."},
        {"zh": "这是撕扯，不是砍", "en": "This is a tear, not a cut."},
        {"zh": "我一落地就转向", "en": "I land and pivot."},
        {"zh": "队伍同时扑了上来", "en": "The pack lunges as one."},
        {"zh": "你的手臂被抓住了", "en": "Your arm is caught."},
        {"zh": "我用后腿蹬开你", "en": "I kick off from you."},
        {"zh": "首领出手最省力", "en": "The leader's strikes are shortest."},
        {"zh": "你退，部下就补位", "en": "You retreat; my pack fills in."},
        {"zh": "再补上一记镰爪", "en": "Another sickle rake."},
        {"zh": "血味让队伍兴奋起来", "en": "The smell of blood excites the pack."},
        {"zh": "我退回队形中线", "en": "I return to the center line."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一声低鸣，队伍就位", "en": "One call and the pack takes position."},
        {"zh": "身后的族群停在树影里。", "en": "My pack halts in the tree shadows."},
        {"zh": "羽毛在晨雾里发亮", "en": "My feathers gleam in the morning mist."},
        {"zh": "白垩纪林地有了主人", "en": "These Cretaceous woods have a master."},
        {"zh": "部下从两侧聚拢过来", "en": "The pack gathers from both sides."},
        {"zh": "镰爪先露了出来", "en": "My sickle claw shows first."},
        {"zh": "这一带猎场归我们", "en": "These hunting grounds are ours."},
        {"zh": "雌性的队列已经排好", "en": "The female ranks are set."},
        {"zh": "我抬头，喉咙在动", "en": "I raise my head; my throat works."},
        {"zh": "一声低鸣，全队安静", "en": "One rumble and the pack goes silent."},
        {"zh": "我们从琥珀里回来", "en": "We returned from the amber."},
        {"zh": "地上的落叶被踩碎", "en": "Fallen leaves crushed underfoot."},
        {"zh": "我在中间，部下在外圈", "en": "I'm in the center; the pack forms the ring."},
        {"zh": "今晚会变得很长", "en": "Tonight will be long."},
        {"zh": "你听见的不止一声", "en": "You'll hear more than one call."},
        {"zh": "队伍比我更饥饿", "en": "The pack is hungrier than I am."},
        {"zh": "我是这一群的首领", "en": "I am this pack's leader."},
        {"zh": "这一群由我带着", "en": "I lead this pack."}
      ]
    },
    "hurt.fire": {
