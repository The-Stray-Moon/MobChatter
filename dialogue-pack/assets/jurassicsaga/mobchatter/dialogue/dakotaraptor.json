      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "队伍饿久了会闹起来", "en": "A hungry pack grows restless."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光里影子全乱了", "en": "In the lightning, our shadows scattered."}
      ]
    },
    "hurt.void": {
