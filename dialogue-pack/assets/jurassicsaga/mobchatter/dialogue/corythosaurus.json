{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "头冠在前面，我慢慢走", "en": "Crest forward, I walk slowly."},
        {"zh": "鸭嘴一张一合，嚼着草", "en": "My duck bill works at the grass."},
        {"zh": "四条腿踩着软土", "en": "Four legs on soft soil."},
        {"zh": "白垩纪的北美西部，我熟", "en": "I know Cretaceous western North America."},
        {"zh": "我走得不快，队伍很散", "en": "Not fast, and the herd spreads out."},
        {"zh": "尾巴在后面摆", "en": "My tail sways behind."},
        {"zh": "我沿着河岸走", "en": "I walk along the riverbank."},
        {"zh": "头冠里能发出声音", "en": "The crest can sound a call."},
        {"zh": "这一群有十几头", "en": "There are a dozen of us."},
        {"zh": "我的脚掌很宽", "en": "My feet are broad."},
        {"zh": "草被我们吃出一条路", "en": "We graze a path through the grass."},
        {"zh": "水边有我踩的浅坑", "en": "I leave shallow prints by the water."},
        {"zh": "幼崽走在队伍中间", "en": "The young walk in the middle."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，头冠有点歪", "en": "I stand; my crest tilts a little."},
        {"zh": "风吹过头冠，声音很闷", "en": "Wind across the crest makes a low note."},
        {"zh": "我低下头吃草", "en": "I lower my head to graze."},
        {"zh": "这一片草够我们吃", "en": "This grass feeds us all."},
        {"zh": "我用叫声和同伴说话", "en": "I speak to the herd by calls."},
        {"zh": "我警觉但不紧张", "en": "Alert, but not tense."},
        {"zh": "我的嘴像鸭子的", "en": "My snout is like a duck's."},
        {"zh": "河那边有动静", "en": "Something moves across the river."},
        {"zh": "我把幼崽挡在身后", "en": "I keep the young behind me."},
        {"zh": "这里的土很湿", "en": "The soil is wet here."},
        {"zh": "我这一身只有草和皮", "en": "I have nothing to give you."},
        {"zh": "草的味道还行", "en": "The grass tastes fine."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站着别动，让我看", "en": "Stand still; let me look."},
        {"zh": "我的头冠能分辨声音", "en": "My crest sorts out sounds."},
        {"zh": "你身上没有青草味", "en": "You don't smell of grass."},
        {"zh": "我不喜欢人靠太近", "en": "I don't like being approached."},
        {"zh": "你站在我队伍前面", "en": "You're in front of my herd."},
        {"zh": "我往旁边挪了一下", "en": "I shifted aside."},
        {"zh": "你不是这个时代的东西", "en": "You're not from this age."},
        {"zh": "我听得清你的脚步", "en": "I understand your footsteps."},
        {"zh": "我不会先出手", "en": "I won't strike first."},
        {"zh": "但我会叫出声", "en": "But I will call."},
        {"zh": "你听见我叫了吗", "en": "Did you hear my call?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一声叫，队伍就乱了", "en": "I called, and the herd stirred."},
        {"zh": "我又往后退了两步", "en": "I stepped back twice."},
        {"zh": "皮很厚，可还是疼", "en": "Thick hide, still painful."},
        {"zh": "鸭嘴撞歪了，脖子发闷。", "en": "My duckbill is knocked askew, my neck aches."},
        {"zh": "同伴都围过来了", "en": "The herd has gathered."},
        {"zh": "我不跑，我挡着", "en": "I don't run; I stand."},
        {"zh": "伤口正在渗血", "en": "The wound is seeping."},
        {"zh": "幼崽被吓坏了", "en": "The young are frightened."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "草？我什么时候都吃", "en": "Grass? I eat all the time."},
        {"zh": "你手里那一点不够", "en": "That's not enough."},
        {"zh": "跟着你走也可以", "en": "I'll follow along."},
        {"zh": "我吃得慢，你别催我", "en": "I eat slowly; don't rush me."},
        {"zh": "这一把闻着还不错", "en": "This handful smells all right."},
        {"zh": "我的队伍也会跟过来", "en": "My herd will come too."},
        {"zh": "别放下就转身走", "en": "Don't drop it and turn away."},
        {"zh": "我一口就能吃完它", "en": "I'd finish that in one bite."},
        {"zh": "低头嗅了嗅你手里的嫩枝。", "en": "I lower my head to sniff the tender shoots."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的后腿", "en": "You hit my hind leg."},
        {"zh": "我这身体非常沉", "en": "This body is heavy."},
        {"zh": "我晃了一下没倒下", "en": "I swayed, didn't fall."},
        {"zh": "让一让，我腿多", "en": "Make way; I have four legs."},
        {"zh": "这一撞让队伍乱了", "en": "The bump confused the herd."},
        {"zh": "沉重的身子撞得树叶乱响。", "en": "My heavy body rattles the leaves."},
        {"zh": "别紧贴在我的侧面", "en": "Don't walk against my flank."},
        {"zh": "这一撞你该站不稳了", "en": "That should steady you."},
        {"zh": "我不喜欢被挤着", "en": "I don't like being crowded."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "头冠的颜色是给你看的", "en": "The crest's coloring is for you."},
        {"zh": "叫声一低，就是我在示好", "en": "A low call is my good will."},
        {"zh": "我们会在河岸筑窝", "en": "We'd nest by the riverbank."},
        {"zh": "队伍里我已经有伴了", "en": "I already have a mate in the herd."},
        {"zh": "我们一起护着幼崽", "en": "Let's guard the young together."},
        {"zh": "我们并排吃草吧", "en": "We graze side by side."},
        {"zh": "你的头冠也很不错", "en": "Your crest is fine too."},
        {"zh": "叫声对上了就算应下", "en": "If our calls match, it's agreed."},
        {"zh": "这片河岸够宽", "en": "The bank is wide enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有新嫩芽", "en": "Fresh shoots on the ground."},
        {"zh": "这点草我叼着走", "en": "I carry this grass along."},
        {"zh": "掉在地上的我不挑", "en": "Fallen food; I'm not picky."},
        {"zh": "这一片我吃了一半", "en": "I've eaten half of this patch."},
        {"zh": "我嚼得非常慢", "en": "I chew slowly."},
        {"zh": "我用舌头把它卷起", "en": "I curl it up with my tongue."},
        {"zh": "别抢，是我先到的", "en": "Don't grab; I got here first."},
        {"zh": "地上那枚果子，我正想吃。", "en": "That fruit on the ground—I had my eye on it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我发出低沉的警告", "en": "I sound a low warning."},
        {"zh": "队伍开始聚拢起来", "en": "The herd is bunching up."},
        {"zh": "我把幼崽护在身后", "en": "I tuck the young behind me."},
        {"zh": "我的头冠发出声音", "en": "My crest is sounding."},
        {"zh": "我不会一直后退", "en": "I won't keep retreating."},
        {"zh": "我们用身体挡住", "en": "We block with our bodies."},
        {"zh": "我的前脚非常有力", "en": "My forelegs are strong."},
        {"zh": "你被围到中间了", "en": "You're in the middle of the herd."},
        {"zh": "我一踩你就躲不开", "en": "If I stomp, you can't dodge."},
        {"zh": "我们的数量很多", "en": "We have numbers."},
        {"zh": "这一下是撞，不是咬", "en": "This is a charge, not a bite."},
        {"zh": "退开，我们不想流血", "en": "Back off; we don't want blood."},
        {"zh": "你听见十几声叫了吗", "en": "Hear a dozen calls?"},
        {"zh": "我的叫声就是命令", "en": "My call is an order."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经正对着你", "en": "I've turned to face you."},
        {"zh": "队伍从两侧合拢", "en": "The herd closes on both sides."},
        {"zh": "你用武器，我用体重", "en": "You use a weapon; I use weight."},
        {"zh": "你退一步我进一步", "en": "You step back; I step forward."},
        {"zh": "我不快，但我够宽", "en": "I'm not quick, but I'm wide."},
        {"zh": "我的尾巴也能打人", "en": "My tail can hit too."},
        {"zh": "水边太软，你站不稳", "en": "The bank is soft; you can't stand firm."},
        {"zh": "河岸这一侧被堵住了", "en": "This side of the bank is blocked."},
        {"zh": "不止一头在动", "en": "More than one is moving."},
        {"zh": "我护着幼崽，不让开", "en": "I guard the young; I won't yield."},
        {"zh": "再靠近我就撞过去", "en": "Any closer and I charge."},
        {"zh": "你的退路是那条河", "en": "Your way out is the river."},
        {"zh": "河里还有别的东西", "en": "Something's in the river."},
        {"zh": "你只能选一边了", "en": "You can only pick one side."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "前脚踩下来了", "en": "My forefoot comes down."},
        {"zh": "头冠顶在你的胸口", "en": "My crest butts your chest."},
        {"zh": "这一下非常重", "en": "That one is heavy."},
        {"zh": "你被撞得后退", "en": "You were knocked back."},
        {"zh": "我用后腿蹬你", "en": "I kick with a hind leg."},
        {"zh": "同伴也在撞你", "en": "The herd rams too."},
        {"zh": "你的盾挡不住重量", "en": "Your shield won't stop weight."},
        {"zh": "我压低整个身子", "en": "I lower my body."},
        {"zh": "这一撞冲你的腿来", "en": "This charge goes at your legs."},
        {"zh": "你倒了，我不追", "en": "You fell; I don't chase."},
        {"zh": "我退回队伍里", "en": "I back into the herd."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "鸭嘴先探出草丛", "en": "The duck bill emerges from the grass."},
        {"zh": "白垩纪河岸醒过来了", "en": "The Cretaceous riverbank stirs."},
        {"zh": "我是从琥珀里出来的", "en": "I came from the amber."},
        {"zh": "我们一群都到了", "en": "The whole herd has arrived."},
        {"zh": "头冠在晨光里发亮", "en": "The crest gleams in the dawn."},
        {"zh": "这片草地我们占了", "en": "We claim this meadow."},
        {"zh": "我的脚踩实了地面", "en": "My feet find solid ground."},
        {"zh": "不远处还有好几头", "en": "A few more are close by."},
        {"zh": "叫声从河那边传来", "en": "Calls come from across the river."},
        {"zh": "我们沿着水边行走", "en": "We keep to the water's edge."},
        {"zh": "幼崽躲在队伍中间", "en": "The young hide in the middle."},
        {"zh": "我用叫声报出位置", "en": "I call to mark our place."},
        {"zh": "河岸的草够我们吃", "en": "The bank's grass feeds us."},
        {"zh": "我甩了甩头冠", "en": "I shake my crest."},
        {"zh": "这是我出生的地带", "en": "This is where I was born."},
        {"zh": "北美西部的风我认得", "en": "I know western North America's wind."},
        {"zh": "我们慢慢散开吃草", "en": "We spread out to graze."},
        {"zh": "你先别靠得太近", "en": "Don't come too close yet."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过背，我冲进河里", "en": "Fire on my back; I charged into the river."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下河岸，腿扭了", "en": "I fell off the bank and twisted a leg."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过嘴，我拼命抬头", "en": "Water over my snout; I strain upward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把队伍炸散了", "en": "The blast scattered the herd."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这力量让我站不稳", "en": "This force makes me unsteady."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "草被吃光了，我饿", "en": "The grass is gone; I'm hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在河岸大树上", "en": "Lightning struck a tree on the bank."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有草地了", "en": "No grass beneath me."}
      ]
    }
  }
}
