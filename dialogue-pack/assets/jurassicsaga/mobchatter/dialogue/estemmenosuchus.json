{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我这一身厚皮，走得慢。", "en": "Thick hide makes me slow."},
        {"zh": "头上那对角饰，很沉。", "en": "The horned crest is heavy."},
        {"zh": "四只脚外撇，稳稳走。", "en": "Splayed feet, steady going."},
        {"zh": "二叠纪的河边，我熟。", "en": "I know Permian riverbanks."},
        {"zh": "河岸的泥里，我踩出深坑。", "en": "I press deep prints into the riverbank mud."},
        {"zh": "每走一步，草都倒。", "en": "Each step flattens grass."},
        {"zh": "脚掌宽，陷进泥里。", "en": "Wide feet sink in mud."},
        {"zh": "我不着急，反正够吃。", "en": "No hurry; there's food enough."},
        {"zh": "鼻子贴着地，闻嫩芽。", "en": "Nose to the ground, seeking shoots."},
        {"zh": "尾巴拖着，划出一道痕。", "en": "My tail drags a line."},
        {"zh": "我转过身子，很费劲。", "en": "Turning takes effort."},
        {"zh": "这副身架，撞不倒。", "en": "This frame won't be bowled over."},
        {"zh": "我路过一丛蕨。", "en": "I pass a stand of ferns."},
        {"zh": "俄罗斯的河岸，也差不多。", "en": "The riverbanks of Russia felt similar."},
        {"zh": "我一步一停，很稳。", "en": "Step, pause, steady."},
        {"zh": "厚皮在日光下泛红。", "en": "My hide reddens in the sun."},
        {"zh": "我慢慢走向水。", "en": "I walk slowly to the water."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，像块大石头。", "en": "Standing, I look like a boulder."},
        {"zh": "角饰上落了一片叶。", "en": "A leaf rests on my crest."},
        {"zh": "我把嘴里那口草嚼烂。", "en": "I chew that mouthful of grass to pulp."},
        {"zh": "头顶的骨角饰压得脖子酸。", "en": "The bony crest on my skull weighs my neck down."},
        {"zh": "风从河上来，很凉。", "en": "Cool wind off the river."},
        {"zh": "我从鼻孔里喷出两道气。", "en": "Two puffs of breath leave my nostrils."},
        {"zh": "腿站久了，有点酸。", "en": "My legs ache from standing."},
        {"zh": "有虫在我背上爬。", "en": "A bug crawls on my back."},
        {"zh": "我低头看看水里的自己。", "en": "I look down at myself in the water."},
        {"zh": "这片河岸，没什么威胁。", "en": "No threats on this bank."},
        {"zh": "我慢慢闭上眼睛。", "en": "I slowly close my eyes."},
        {"zh": "角饰的影子，投在地上。", "en": "My crest's shadow on the ground."},
        {"zh": "我挪了挪脚，换个重心。", "en": "I shift my weight."},
        {"zh": "水只是轻轻拍岸。", "en": "The water only laps the bank."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站那儿，我看得清。", "en": "I can see you standing there."},
        {"zh": "我这角饰，不是用来顶人的。", "en": "This crest isn't for goring."},
        {"zh": "你比我矮，还比我瘦。", "en": "Shorter and thinner than me."},
        {"zh": "你要摸我的头吗？", "en": "Going to touch my head?"},
        {"zh": "我只是在吃东西。", "en": "I'm only eating."},
        {"zh": "你身上有水味。", "en": "You smell of water."},
        {"zh": "这块河岸，我一直用。", "en": "I've always used this bank."},
        {"zh": "你不像二叠纪的。", "en": "You're not from the Permian."},
        {"zh": "你站得太贴近我前蹄。", "en": "You're too close to my forefeet."},
        {"zh": "我把庞大的身子挪正。", "en": "I square my bulky body up."},
        {"zh": "你要是没恶意，就坐下。", "en": "If you mean no harm, sit down."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "皮厚，也会疼。", "en": "Thick hide still feels pain."},
        {"zh": "我厚实的身子退开半步。", "en": "My heavy body draws back half a step."},
        {"zh": "角饰上擦破一处。", "en": "A scrape on my crest."},
        {"zh": "喉咙里滚出一声闷响。", "en": "A dull rumble rolls in my throat."},
        {"zh": "我一脚一脚地挪开。", "en": "I shift away one footfall at a time."},
        {"zh": "血渗进厚皮里。", "en": "Blood seeps into thick hide."},
        {"zh": "我把尾巴甩到另一边。", "en": "I swing my tail to the other side."},
        {"zh": "腿有点不稳。", "en": "My legs are unsteady."},
        {"zh": "别打我的眼睛。", "en": "Not my eyes."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "嫩芽？给我看看。", "en": "Shoots? Let me see."},
        {"zh": "我慢慢过去，不抢。", "en": "I come slowly; I won't grab."},
        {"zh": "这一小把，不够我一口。", "en": "That small bunch isn't one bite."},
        {"zh": "闻着挺新鲜。", "en": "Smells fresh."},
        {"zh": "别举太高，我脖子够不到。", "en": "Not too high; my neck won't reach."},
        {"zh": "我嘴大，吃起来很快。", "en": "Big mouth; I eat fast."},
        {"zh": "这一丛，够我嚼一阵。", "en": "This clump will last me a while."},
        {"zh": "河边的草，比这个甜。", "en": "River grass is sweeter."},
        {"zh": "你退后，我才靠近。", "en": "Step back and I'll come."},
        {"zh": "我吃东西的时候，别摸我。", "en": "Don't touch me while I eat."},
        {"zh": "再来一丛，我还饿。", "en": "Another clump; I'm still hungry."},
        {"zh": "蕨叶太老了。", "en": "These ferns are too old."},
        {"zh": "我低头，慢慢咬。", "en": "I lower my head and bite slowly."},
        {"zh": "你手上有草汁。", "en": "There's grass juice on your hands."},
        {"zh": "够了，谢谢。", "en": "Enough — thank you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我？我根本不动。", "en": "Bump me? I don't move at all."},
        {"zh": "你撞到的是厚皮。", "en": "What you hit was thick hide."},
        {"zh": "我侧身，让开一点。", "en": "I turn to give a little room."},
        {"zh": "我脚下一沉，站稳。", "en": "I plant my feet."},
        {"zh": "这点分量，我根本没感觉。", "en": "I don't even feel that weight."},
        {"zh": "角饰差点碰到你。", "en": "My crest nearly caught you."},
        {"zh": "泥地被踩得更烂了。", "en": "The mud is churned worse."},
        {"zh": "我不推你，你自己让。", "en": "I won't shove; you move."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "河边那只，皮色不错。", "en": "That one by the river has a fine hide."},
        {"zh": "我贴着河岸踱过去。", "en": "I plod over along the bank."},
        {"zh": "我们俩低着头一起啃。", "en": "We both graze, heads down."},
        {"zh": "她的角饰比我小。", "en": "Her crest is smaller than mine."},
        {"zh": "我用鼻子蹭了蹭她。", "en": "I nuzzle her with my snout."},
        {"zh": "这片浅滩，够养幼崽。", "en": "This shallows could raise young."},
        {"zh": "我们一起下水。", "en": "We go into the water together."},
        {"zh": "我不催，你也不用急。", "en": "I won't rush, and neither need you."},
        {"zh": "两头大的，挤在一起。", "en": "Two big ones, huddled."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有根嫩枝。", "en": "A tender twig on the ground."},
        {"zh": "我低下头，用嘴扯下来。", "en": "I lower my head and pull it free."},
        {"zh": "嘴太大，捡小的费劲。", "en": "Big mouth; small things are hard."},
        {"zh": "掉在水里，我捞。", "en": "It fell in the water; I fish it out."},
        {"zh": "这一口，一下就没了。", "en": "One bite and it's finished."},
        {"zh": "从不把吃食糟蹋掉。", "en": "I never waste a scrap of food."},
        {"zh": "这根有点咬不动。", "en": "This one resists my teeth."},
        {"zh": "这块肉，我先咬住了。", "en": "I've got this meat first."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头，看清了。", "en": "I raise my head and see it."},
        {"zh": "不是河里的。", "en": "Not from the river."},
        {"zh": "我的鼻子朝那边拱。", "en": "My snout tilts that way."},
        {"zh": "腿下压，准备应对。", "en": "My legs brace."},
        {"zh": "你不像来吃草的。", "en": "You don't look like you came to graze."},
        {"zh": "我的角，也不只是装饰。", "en": "My crest isn't only decoration."},
        {"zh": "这河岸，是我的。", "en": "This bank is mine."},
        {"zh": "你站在哪，我鼻子记得。", "en": "My snout remembers where you stand."},
        {"zh": "别从后面来。", "en": "Don't come from behind."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我庞大的身子转向你。", "en": "My heavy body turns toward you."},
        {"zh": "你绕圈，我这大头跟着转。", "en": "You circle; my heavy head follows."},
        {"zh": "呼吸重了，是警告。", "en": "Heavy breathing is a warning."},
        {"zh": "我不打算追谁。", "en": "I have no intention of chasing."},
        {"zh": "这点耐心，我有很多。", "en": "I have plenty of patience."},
        {"zh": "这局面，不必要。", "en": "This needn't happen."},
        {"zh": "谁在我的地盘上晃？", "en": "Who's wandering on my ground?"},
        {"zh": "角饰不是摆设，退后。", "en": "These horns aren't decoration. Back off."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用头侧撞过去。", "en": "I butt with the side of my head."},
        {"zh": "角饰也能磕人。", "en": "The crest can knock too."},
        {"zh": "我压下去，你退开。", "en": "I lean down; you give way."},
        {"zh": "这一下，够你翻倒。", "en": "That could tip you over."},
        {"zh": "我脚一跺，地都颤。", "en": "I stamp and the ground shakes."},
        {"zh": "我这嘴里不咬东西。", "en": "Nothing goes in my mouth to bite."},
        {"zh": "别看我不快，力气大。", "en": "Not fast, but strong."},
        {"zh": "撞过之后我侧身让开。", "en": "After the shove I turn aside."},
        {"zh": "再来，我也不怕。", "en": "Again; I'm not worried."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从河岸上站起来。", "en": "I rise on the riverbank."},
        {"zh": "水面被我的影子盖住。", "en": "My shadow covers the water."},
        {"zh": "这里也有蕨类。", "en": "Ferns here too."},
        {"zh": "我先找了块平地。", "en": "First I found flat ground."},
        {"zh": "角饰上还挂着水草。", "en": "Weed hangs from my crest."},
        {"zh": "我把身上的土抖落。", "en": "I shake the dirt off my hide."},
        {"zh": "空气比我那时暖。", "en": "The air is warmer than my time."},
        {"zh": "周围没别的动物。", "en": "No other animals about."},
        {"zh": "我落脚很重。", "en": "My steps land heavy."},
        {"zh": "这地方不错。", "en": "This will do."},
        {"zh": "我低头，先喝一口。", "en": "I dip my head and drink first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧着厚皮，很难闻。", "en": "Fire on thick hide stinks."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，整副骨架都震。", "en": "I fall; my whole frame jolts."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进鼻子，我挣扎。", "en": "Water in my snout; I struggle."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我晃了晃。", "en": "The blast rocks me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有个尖东西扎进我肋下。", "en": "Something sharp bites under my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量钻进骨头。", "en": "That force works into my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得挪不动腿。", "en": "Too hungry to move my legs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在背上，我一颤。", "en": "Lightning on my back; I shudder."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没地，我往下沉。", "en": "No ground; I sink."}
      ]
    }
  }
}
