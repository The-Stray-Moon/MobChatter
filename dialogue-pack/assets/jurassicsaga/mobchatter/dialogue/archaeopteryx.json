{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从这根枝跳到那根", "en": "I hop from this branch to that one."},
        {"zh": "爪子在树皮上抓了一下", "en": "My claws catch the bark once."},
        {"zh": "羽毛上的印子像叶片", "en": "My feather patterns look like leaves."},
        {"zh": "我顺着树干往上走", "en": "I work my way up the trunk."},
        {"zh": "我的头上下点着", "en": "My head bobs as I go."},
        {"zh": "尾羽很长，一直伸在后面", "en": "My long tail trails behind."},
        {"zh": "我从枝上滑下去", "en": "I glide off the branch."},
        {"zh": "落点选在另一棵树上", "en": "I aim for another tree."},
        {"zh": "翅膀张开，然后收住", "en": "Wings out, then tucked."},
        {"zh": "爪子先落，身体才到", "en": "Claws land before my body does."},
        {"zh": "德国那边的林子，我熟", "en": "I know the woods of Germany."},
        {"zh": "我在低枝间横向移动", "en": "I move sideways through low branches."},
        {"zh": "有虫就停一下", "en": "A bug stops me."},
        {"zh": "吃完才继续走", "en": "Eat, then move on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站在枝上，尾巴很直", "en": "Perched, my tail held straight."},
        {"zh": "翅膀微微张开", "en": "My wings open a fraction."},
        {"zh": "羽毛在光下发亮", "en": "My feathers shine in the light."},
        {"zh": "我歪头看着下面", "en": "I tilt my head at the ground below."},
        {"zh": "我歪头找树皮缝里的小虫。", "en": "I tilt my head to hunt bugs in the bark cracks."},
        {"zh": "有片叶子在落", "en": "A leaf is falling."},
        {"zh": "我紧紧盯住它", "en": "I fix on it."},
        {"zh": "看它落到哪里", "en": "Watching where it lands."},
        {"zh": "然后就不管了", "en": "Then I lose interest."},
        {"zh": "我抖了抖尾羽", "en": "I shake my tail feathers."},
        {"zh": "牙齿很细，很密", "en": "My teeth are fine and close-set."},
        {"zh": "我没有真正的喙", "en": "I have no true beak."},
        {"zh": "所以吃东西得小心", "en": "So I eat carefully."},
        {"zh": "树上的风很稳", "en": "The wind up here is steady."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头时，我正换脚站着。", "en": "When you look up, I'm shifting from foot to foot."},
        {"zh": "你总算抬起眼", "en": "You finally looked up."},
        {"zh": "你的手心里有新翻的泥土味。", "en": "Your palm smells of freshly turned soil."},
        {"zh": "你的脑袋很大", "en": "Your head is very large."},
        {"zh": "我一跳就能到你肩上", "en": "One hop and I could reach your shoulder."},
        {"zh": "可是我并没有跳", "en": "But I don't hop."},
        {"zh": "我抓着枝，左右晃", "en": "I grip the branch and sway."},
        {"zh": "你手上的东西我看到了", "en": "I've seen what's in your hand."},
        {"zh": "看上去不能下嘴", "en": "It doesn't look edible."},
        {"zh": "我不看你，改看落下来的叶子。", "en": "I stop watching you and watch a falling leaf instead."},
        {"zh": "随后又转回来了", "en": "Then it turns back."},
        {"zh": "你居然还在那儿", "en": "You're still there."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了几根羽毛", "en": "A few feathers come loose."},
        {"zh": "我跳到更高的枝", "en": "I hop to a higher branch."},
        {"zh": "我的细牙咬不住痛，只好忍着。", "en": "My fine teeth can't bite pain away, so I endure it."},
        {"zh": "翅根被扯到，我只能贴着树皮。", "en": "My wing base is wrenched — I can only press against the bark."},
        {"zh": "我死贴着枝干不动", "en": "I cling dead still to the branch."},
        {"zh": "一直等到痛过去", "en": "Waiting for the pain to pass."},
        {"zh": "我的尾羽歪了", "en": "My tail feathers are askew."},
        {"zh": "我慢慢把它理顺", "en": "I set them straight, slowly."},
        {"zh": "我还能飞起来", "en": "I can still fly."},
        {"zh": "那就算还不错", "en": "Then that's fine."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那可能是虫子", "en": "That might be a bug."},
        {"zh": "我沿着枝靠近", "en": "I move along the branch."},
        {"zh": "我把头低下去看", "en": "Head down to look."},
        {"zh": "这根本不是虫子", "en": "Not a bug."},
        {"zh": "也不是什么果子", "en": "Not fruit either."},
        {"zh": "于是我又缩回去", "en": "I pull back."},
        {"zh": "树上的虫子更靠得住", "en": "Bugs on trees are more reliable."},
        {"zh": "我在树皮上找", "en": "I search the bark."},
        {"zh": "终于找到一个", "en": "Found one."},
        {"zh": "这个才是真的", "en": "This one's the real thing."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我差点掉下树", "en": "I nearly fall off the tree."},
        {"zh": "翅膀张开稳住", "en": "Wings flare to steady me."},
        {"zh": "我滑到下面一根枝", "en": "I glide to a branch below."},
        {"zh": "树枝一抖，我换了个抓握。", "en": "The branch jolts and I shift my grip."},
        {"zh": "我用头理了理", "en": "I smooth them with my head."},
        {"zh": "然后重新站好", "en": "Then settle again."},
        {"zh": "别去摇动树干", "en": "Don't shake the trunk."},
        {"zh": "这一下倒不碍事", "en": "That doesn't hinder me."},
        {"zh": "我往上爬了一段", "en": "I climb a little higher."},
        {"zh": "那里要安全得多", "en": "It's safer there."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我展开翅膀给她看", "en": "I spread my wings to show her."},
        {"zh": "羽毛上的纹路最漂亮", "en": "The patterns are at their best."},
        {"zh": "她也张开翅膀", "en": "She spreads hers too."},
        {"zh": "我们在枝上绕圈", "en": "We circle on the branch."},
        {"zh": "然后一起滑到另一棵", "en": "Then glide to another tree together."},
        {"zh": "落在同一根枝上", "en": "Landing on the same branch."},
        {"zh": "尾巴并着尾巴", "en": "Tail beside tail."},
        {"zh": "她啄了啄我的颈", "en": "She pecks my neck."},
        {"zh": "我慢慢垂下头", "en": "I lower my head slowly."},
        {"zh": "这已经算很不错", "en": "That counts as quite good."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前爪按住，再啄两下。", "en": "I pin it with a foreclaw, then peck twice."},
        {"zh": "甩了两下才咽", "en": "Two shakes to swallow."},
        {"zh": "太硬，咽不下", "en": "Too hard to swallow."},
        {"zh": "我又吐了出来", "en": "I spit it out."},
        {"zh": "我用爪尖扣住", "en": "I pin it with a claw."},
        {"zh": "然后我再啄一口", "en": "And peck at it."},
        {"zh": "这一次终于碎了", "en": "This time it breaks."},
        {"zh": "一点一点地吃", "en": "Eating it piece by piece."},
        {"zh": "吃完梳梳羽毛", "en": "Done. I preen."},
        {"zh": "我接着往下搜寻", "en": "I keep searching downward."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "底下有什么在动", "en": "Something stirs below."},
        {"zh": "没有胸骨，我飞得不高。", "en": "Without a keel, I cannot fly high."},
        {"zh": "尾巴保持笔直", "en": "My tail stays straight."},
        {"zh": "我的翅膀半张开", "en": "Wings half open."},
        {"zh": "我在心里算距离", "en": "I'm judging the distance."},
        {"zh": "这个高度正合适", "en": "The height is just right."},
        {"zh": "我从枝上落下", "en": "I drop from the branch."},
        {"zh": "不是飞，是滑", "en": "Not flying. Gliding."},
        {"zh": "落点在它旁边", "en": "Landing beside it."},
        {"zh": "爪子一下子伸出去", "en": "Claws out."},
        {"zh": "我从枝上滑下去，翅膀没张。", "en": "I slide off the branch without opening my wings."},
        {"zh": "我一下抓住了", "en": "Caught it in one grab."},
        {"zh": "树枝弹了一下，我借力", "en": "The branch springs back. I use it."},
        {"zh": "羽毛把风声滤掉了", "en": "My feathers muffle the wind."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕到枝的另一侧", "en": "I move to the far side of the branch."},
        {"zh": "你怕是找不到我", "en": "You likely won't find me."},
        {"zh": "羽毛颜色和树皮一样", "en": "My feathers match the bark."},
        {"zh": "我贴着枝干不动", "en": "I press to the branch."},
        {"zh": "我一直在等你转身", "en": "Waiting for you to turn."},
        {"zh": "然后我再滑下来", "en": "Then I'll glide down."},
        {"zh": "这个角度不好", "en": "Not a good angle."},
        {"zh": "我再高一点点", "en": "A little higher."},
        {"zh": "现在角度好多了", "en": "Much better now."},
        {"zh": "滑行的路线很直", "en": "My glide line is straight."},
        {"zh": "风帮我抬了一下", "en": "The wind lifts me once."},
        {"zh": "落点就在那里", "en": "There's the landing point."},
        {"zh": "我已经准备好了呀", "en": "I'm all ready."},
        {"zh": "那就让我下去", "en": "Then let me drop."},
        {"zh": "一爪抓抓住它", "en": "Grab it in one claw."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "爪子从上往下抓", "en": "My claws rake downward."},
        {"zh": "牙很细，咬不深", "en": "Fine teeth. They don't bite deep."},
        {"zh": "我一半是恐龙，一半是鸟。", "en": "Half dinosaur, half bird."},
        {"zh": "我扑了一下就退", "en": "One lunge, then back."},
        {"zh": "这一下借了滑行的力", "en": "I used the glide for that."},
        {"zh": "你挥手，我飞开了", "en": "You swat, and I'm gone."},
        {"zh": "落到另一根枝上", "en": "Onto another branch."},
        {"zh": "羽毛乱了一半", "en": "Half my feathers are ruffled."},
        {"zh": "我理了理，继续看", "en": "I smooth them and keep watching."},
        {"zh": "你的护甲太硬", "en": "Your armor is too hard."},
        {"zh": "我根本咬不动", "en": "I can't bite through."},
        {"zh": "那我就不咬了", "en": "Then I won't bother."},
        {"zh": "我朝上面爬去", "en": "I climb higher."},
        {"zh": "然后离开这里", "en": "And leave."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "枝上多了一只带羽毛的东西", "en": "A feathered thing appears on a branch."},
        {"zh": "尾羽先垂下来", "en": "My tail feathers hang first."},
        {"zh": "然后我才站直", "en": "Then I straighten up."},
        {"zh": "羽毛还有点湿", "en": "My feathers are still damp."},
        {"zh": "我把它们抖开", "en": "I shake them out."},
        {"zh": "这棵树非常高", "en": "The tree is tall."},
        {"zh": "能看见很远的地方", "en": "I can see a long way."},
        {"zh": "下面有路，有水", "en": "Roads and water below."},
        {"zh": "我先理了理羽", "en": "First I preen."},
        {"zh": "然后才往下看", "en": "Then look down."},
        {"zh": "这里的虫子应该不少", "en": "Plenty of insects here, I'd guess."},
        {"zh": "我打算仔细找找", "en": "I plan to look."},
        {"zh": "顺着树干往下", "en": "Down the trunk."},
        {"zh": "爪子抓得稳稳的", "en": "Claws sure."},
        {"zh": "我一点一点往下", "en": "Bit by bit."},
        {"zh": "我没什么好急的", "en": "There's nothing to rush."},
        {"zh": "我把尾羽摆正", "en": "I straighten my tail feathers."},
        {"zh": "这一带空气干燥", "en": "The air here is dry."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛一燎就焦", "en": "Fire singes my feathers."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "着地时爪子发软", "en": "My claws weaken on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "湿了翅膀，浮不起来", "en": "Wet wings. I can't stay up."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我从枝上掀掉", "en": "The blast tears me off the branch."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过我的尾羽", "en": "Something pierces my tail feathers."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我分不清方向了", "en": "I've lost my sense of direction."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得飞不起来", "en": "Too hungry to fly."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我睁不开眼", "en": "Lightning light makes me squeeze my eyes shut."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚边的枝没有了", "en": "The branch is gone."}
      ]
    }
  }
}
