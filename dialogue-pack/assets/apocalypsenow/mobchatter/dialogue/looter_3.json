    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "抓住他，别让他跑了。", "en": "Get him, don't let him run."},
        {"zh": "咬住他的腿。", "en": "Grab his leg."},
        {"zh": "别让他逃走。", "en": "Don't let him escape."},
        {"zh": "用利爪抓住他。", "en": "Lunge with my claws."},
        {"zh": "狠狠地咬下去。", "en": "Sink your teeth in hard."},
        {"zh": "咬住他的脖子。", "en": "Grab his throat."},
        {"zh": "别让他逃脱。", "en": "Don't let him get away."},
        {"zh": "攻击他的心脏。", "en": "Target his heart."},
        {"zh": "紧紧抓住他。", "en": "Hold him tight."},
        {"zh": "别让他跑远。", "en": "Don't let him get too far away."},
