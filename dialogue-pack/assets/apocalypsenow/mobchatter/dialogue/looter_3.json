        {"zh": "别捂伤口，越捂越慢。", "en": "Clutch that wound and you slow down."},
        {"zh": "你退路有具会动的尸体。", "en": "Something's moving behind you."},
        {"zh": "你背包鼓着，我看见了。", "en": "Your pack is full. I noticed."},
        {"zh": "你手里的棍子太短。", "en": "That stick of yours is too short."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用枪托砸你的下巴。", "en": "I slam my rifle butt into your jaw."},
        {"zh": "指甲缝里还卡着上一顿。", "en": "Last meal's bits still wedge under my nails."},
        {"zh": "不逃了？你想死吗？", "en": "No running? You want to die?"},
        {"zh": "这包东西现在归我。", "en": "This bag of yours is mine now."},
        {"zh": "我一脚踹在你的膝弯上。", "en": "I kick the back of your knee."},
        {"zh": "我的牙缝里还塞着布条。", "en": "Cloth scraps are still stuck in my teeth."},
        {"zh": "我的牙嵌进你的护腕。", "en": "My teeth sink into your bracer."},
