  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "发出嘶嘶声，缓慢前进", "en": "Sssss, moves slowly"},
        {"zh": "脚步声，缓慢行走", "en": "Steps, moves slowly"},
        {"zh": "嘶嘶声中露出尖牙", "en": "Sss, sharp teeth shown"},
        {"zh": "舔了舔嘴唇，缓缓移动", "en": "Tasted lips, moves slowly"},
        {"zh": "咀嚼声，缓缓向前", "en": "Chewing sound, moves slowly"},
        {"zh": "嘶嘶声中接近猎物", "en": "Sss, approaching prey"},
        {"zh": "磨牙声，缓缓行进", "en": "Grinding teeth, moves slowly"},
        {"zh": "低吼着向前走", "en": "Growls, moves forward"},
        {"zh": "张开嘴，嘶嘶声中前进", "en": "Opens mouth, sss"},
        {"zh": "舔了舔地面，慢慢走开", "en": "Tasted ground, slowly leaves"},
        {"zh": "背着鼓囊囊的麻袋慢慢走。", "en": "He trudges along with a bulging sack."},
        {"zh": "踩着废墟的碎砖前进。", "en": "He picks his way over rubble."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "低垂着眼睛，盯着地面", "en": "Low eyes, staring at ground"},
        {"zh": "缓缓摇晃头部，似乎思考", "en": "Shaking head slowly, thinking"},
        {"zh": "舔了舔嘴唇，似乎在回味", "en": "Tasted lips, relishing"},
        {"zh": "嘶嘶声中打量周围环境", "en": "Sss, surveying surroundings"},
        {"zh": "低头舔着身体，似乎在自疗", "en": "Tasting body, self-healing"},
        {"zh": "咬咬手指，似乎在计数", "en": "Biting fingers, counting"},
        {"zh": "舔了舔手指，露出牙齿", "en": "Tasting fingers, showing teeth"},
        {"zh": "舔了舔伤口，似乎在愈合", "en": "Tasting wound, healing"},
        {"zh": "嘶嘶声中自言自语", "en": "Sss, mumbling to self"},
        {"zh": "低头舔了舔地面，似乎在寻找线索", "en": "Tasting ground, searching clues"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的同伴都倒下了，你还站着。", "en": "My crew's all down, and you're still standing."},
        {"zh": "露出凶光，盯着玩家", "en": "Sharp eyes, staring at player"},
        {"zh": "嘶嘶声中盯着玩家", "en": "Sss, staring at player"},
        {"zh": "低吼着盯着玩家", "en": "Growling, staring at player"},
        {"zh": "咬紧嘴唇，盯着玩家", "en": "Biting lips, staring at player"},
        {"zh": "露出獠牙，盯着玩家", "en": "Showing fangs, staring at player"},
        {"zh": "舔了舔嘴唇，盯着玩家", "en": "Tasting lips, staring at player"},
        {"zh": "眼神锐利，盯着玩家", "en": "Sharp eyes, staring at player"},
        {"zh": "张开嘴，露出獠牙盯着玩家", "en": "Opens mouth, showing fangs, staring at player"},
