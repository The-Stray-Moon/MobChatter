    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这疼死我了！", "en": "Ouch, that hurts!"},
        {"zh": "我要死了！", "en": "I'm dying!"},
        {"zh": "我按住腰上的伤口。", "en": "I press a hand to the wound at my waist."},
        {"zh": "别让那家伙靠近！", "en": "Don't let it get near!"},
        {"zh": "我的小腿歪向不该有的方向。", "en": "My calf bends the wrong way."},
        {"zh": "血从我的袖口滴下来。", "en": "Blood drips from my sleeve."},
        {"zh": "快给我水喝！", "en": "Give me water!"},
        {"zh": "快给我药草！", "en": "Give me some herbs!"},
        {"zh": "你快来救救我！", "en": "Save me, please!"},
        {"zh": "这道口子得缠上。", "en": "This cut needs wrapping."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "背包鼓鼓的，我先看看。", "en": "That bulging pack. Let me look."},
        {"zh": "别想逃脱，你的肉很美味。", "en": "Don’t think you can escape. Your flesh is delicious."},
        {"zh": "不要接近我，否则你会后悔。", "en": "Stay back, or you’ll regret it."},
        {"zh": "跟我走，你会被转化的。", "en": "Follow me. You’ll be transformed."},
        {"zh": "你的物品对我没用。", "en": "Your items are useless to me."},
        {"zh": "我的眼睛盯着你的弱点。", "en": "My eyes are on your weaknesses."},
        {"zh": "你的末影珍珠对我无用。", "en": "Your Elytra won’t help you."},
        {"zh": "你会为你的贪婪付出代价。", "en": "You’ll pay for your greed."},
        {"zh": "我不在乎你是谁。", "en": "I don’t care who you are."},
        {"zh": "来吧，享受这个。", "en": "Here, take this."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的肩膀撞歪了我的背包。", "en": "Your shoulder knocks my pack askew."},
        {"zh": "滚开，这是我的领地。", "en": "Get out of my territory."},
        {"zh": "你不会想惹我的。", "en": "You don’t want to mess with me."},
        {"zh": "别让我发现你。", "en": "Don’t let me find you."},
        {"zh": "废墟里的东西都归我。", "en": "Everything in these ruins is mine."},
        {"zh": "我不会饶过你。", "en": "I won’t spare you."},
        {"zh": "你挡了我的路，必须解决。", "en": "You’re in my way. I need to deal with you."},
        {"zh": "我要清理这个区域。", "en": "I’m cleaning up this area."},
        {"zh": "这片废墟归我先搜。", "en": "I search these ruins first."},
        {"zh": "让开，我来过了。", "en": "Move, I’ve been here before."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "跟我一起吧，我们会强大。", "en": "Join me. We’ll be stronger together."},
        {"zh": "废墟里，我们分同一罐水。", "en": "In the ruins, we share the same canteen."},
        {"zh": "和我交配，一起生存。", "en": "Mate with me. Survive together."},
        {"zh": "末世的夜里，只剩我们俩。", "en": "On this dead night, only the two of us are left."},
        {"zh": "和我在一起，你会活下来。", "en": "Stay with me, you’ll survive."},
        {"zh": "搭伙分粮，比一个人活得久。", "en": "Sharing rations outlives going solo."},
        {"zh": "来吧，我们是同类。", "en": "Come, we’re the same."},
        {"zh": "和我合作，我们会更强大。", "en": "Work with me. We’ll be stronger."},
        {"zh": "我会保护你，你愿意吗？", "en": "I’ll protect you. Will you join me?"},
        {"zh": "搭个伙，活下来的机会大点。", "en": "Teaming up might keep us alive."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，这里有美味。", "en": "Sssss, something tasty here."},
        {"zh": "尝尝吧，人类的肉！", "en": "Taste this, human flesh!"},
        {"zh": "找点东西吃吧。", "en": "Time to eat something."},
