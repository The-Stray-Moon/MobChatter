        {"zh": "包给我，滚开！", "en": "Give me the bag and get lost!"},
        {"zh": "咬你一口也能传染。", "en": "One bite can pass it on."},
        {"zh": "你流血流得太快了。", "en": "You're bleeding out fast."},
        {"zh": "别怪我，末世的规矩。", "en": "Don't blame me. End-times rules."}
