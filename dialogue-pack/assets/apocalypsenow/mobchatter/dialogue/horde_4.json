{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "靠近了，猎物！", "en": "Prey nears!"},
        {"zh": "感觉到了，我要吃！", "en": "Feeling it, I'm gonna eat!"},
        {"zh": "追逐！追逐！", "en": "Chase! Chase!"},
        {"zh": "腐肉的味道！", "en": "Smell the flesh!"},
        {"zh": "撕碎你！", "en": "Tear you apart!"},
        {"zh": "这一群，全都跟着你。", "en": "This whole crowd follows you."},
        {"zh": "第四波踩着碎玻璃往这边来。", "en": "The fourth wave crunches glass on its way here."},
        {"zh": "这一带，我们四个说了算。", "en": "The four of us rule this area."},
        {"zh": "快点来吧！", "en": "Come on now!"},
        {"zh": "踩着碎玻璃，一声一声。", "en": "Crunching broken glass, step by step."},
        {"zh": "第四个也爬起来了。", "en": "The fourth one rises too."},
        {"zh": "断腿拖地，照样往前。", "en": "A broken leg drags, but I keep moving."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "在这里等待猎物。", "en": "Waiting for prey."},
        {"zh": "耐心等待，不要急。", "en": "Be patient, don't rush."},
        {"zh": "猎物很快就会出现。", "en": "Prey will come soon."},
        {"zh": "准备好了，随时出击。", "en": "Ready, waiting to strike."},
        {"zh": "周围没有动静。", "en": "No movement around."},
        {"zh": "保持安静，不要惊动我。", "en": "Stay quiet, don't disturb me."},
        {"zh": "等待是最致命的武器。", "en": "Patience is the deadliest weapon."},
        {"zh": "猎物一到就行动。", "en": "Act when prey arrives."},
        {"zh": "耐心等待，机会总会出现。", "en": "Be patient, opportunity always comes."},
        {"zh": "保持警惕，不要放松。", "en": "Stay alert, don't relax."},
        {"zh": "废墟里只剩风在响。", "en": "Only the wind moves in the ruins."},
        {"zh": "数着还有几个能站起。", "en": "Counting how many can still stand."},
        {"zh": "等这阵疼痛慢慢过去。", "en": "Waiting for this pain to fade."},
        {"zh": "尸群里没人开口说话。", "en": "No one in the horde speaks."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物，我要吃了你！", "en": "Prey, I'm gonna eat you!"},
        {"zh": "找到你了，过来吧！", "en": "Found you, come here!"},
        {"zh": "你动了，我要追杀你！", "en": "You moved, I'm gonna chase you!"},
        {"zh": "盯紧你，不会让你逃掉！", "en": "Keeping an eye on you, won't let you escape!"},
        {"zh": "你腿还完好，我看着可惜。", "en": "Your legs are still whole; what a waste."},
        {"zh": "看着我，你死定了！", "en": "Looking at me, you're dead!"},
        {"zh": "抓住你，我要撕碎你！", "en": "Catch you, I'm gonna rip you apart!"},
        {"zh": "你动了，我要追！", "en": "You moved, I'm gonna chase!"},
        {"zh": "我数着你还有几扇窗能跳。", "en": "I count how many windows you have left."},
        {"zh": "盯着你，我不放过你！", "en": "Staring at you, I won't let you go!"},
        {"zh": "你的腿还完好，真可惜。", "en": "Your legs are still whole. A shame."},
        {"zh": "血味顺着风飘到我这儿。", "en": "The smell of blood drifts to me on the wind."},
        {"zh": "这双眼睛只看得见你。", "en": "These eyes see only you."},
        {"zh": "我把你记进尸群名单。", "en": "I put you on the horde's list."},
        {"zh": "你的近战武器太短了。", "en": "Your melee weapon is too short."},
        {"zh": "活人，站住让我看看。", "en": "Living one, stand still and let me look."},
        {"zh": "你身后还有三个和我一样。", "en": "Three more like me stand behind you."},
        {"zh": "别移开眼，我在数你。", "en": "Don't look away. I am counting you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，身体摇摇欲坠。", "en": "Sssss, trembling body."},
        {"zh": "第四级的身子，也开始漏血。", "en": "Even a fourth-tier body starts leaking."},
        {"zh": "被砍伤，血肉模糊。", "en": "Cut, bloody mess."},
        {"zh": "被电击，颤抖不已。", "en": "Electrified, trembling."},
        {"zh": "饥饿难耐，眼神凶恶。", "en": "Starving, vicious eyes."},
        {"zh": "跌落受伤，行动迟缓。", "en": "Fell, sluggish."},
        {"zh": "被雷劈中，痛苦惨叫。", "en": "Thunderstruck, agony."},
        {"zh": "被爆炸震伤，摇摇欲坠。", "en": "Explosion, wobbling."},
        {"zh": "被箭射中，惨叫连连。", "en": "Arrow, wailing."},
        {"zh": "又断一条腿，还能爬。", "en": "Another leg snaps, and I can still crawl."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你散发的热量真诱人。", "en": "Your warmth is irresistible."},
        {"zh": "赶紧找个东西填填肚子吧。", "en": "Find something to eat."},
        {"zh": "这些腐肉很快就能吃上。", "en": "These rotten flesh will soon be eaten."},
        {"zh": "你的血液很美味。", "en": "Your blood is delicious."},
        {"zh": "快点，猎物就在你身边。", "en": "Hurry, the prey is by your side."},
        {"zh": "你的暖气从门缝里漏出来。", "en": "Your warmth leaks out under the door."},
        {"zh": "快点，不然会被同伴吃掉。", "en": "Hurry, or you'll be eaten by others."},
        {"zh": "你的体温让我感到不安。", "en": "Your temperature is unsettling."},
        {"zh": "来吧，我保证不伤害你。", "en": "Come, I promise not to hurt you."},
        {"zh": "你的血液中蕴藏着力量。", "en": "Your blood holds power."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "第四波尸群已经围上。", "en": "The fourth wave has you surrounded."},
        {"zh": "快闪开，我要袭击。", "en": "Move, I'm attacking."},
        {"zh": "挡我路了，闪开。", "en": "Get out of my way."},
        {"zh": "门板后挤着四个，门要倒了。", "en": "Four of us behind the door; it is coming down."},
        {"zh": "退后，我需要空间。", "en": "Step back, I need space."},
        {"zh": "别动，我要吃了你。", "en": "Don't move, I'm going to eat you."},
        {"zh": "让开，尸群要过去。", "en": "Move — the horde is coming through."},
        {"zh": "小心，我要攻击。", "en": "Be careful, I'm attacking."},
        {"zh": "你把门口堵死，我照样挤。", "en": "You block the doorway; I squeeze through anyway."},
        {"zh": "别动，我要咬你。", "en": "Don't move, I'm going to bite you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "求求你，跟我交配。", "en": "Please, mate with me."},
        {"zh": "跟我交配，我能给你力量。", "en": "Mate with me, I can give you strength."},
        {"zh": "咬一口，你就归我们这队。", "en": "One bite, and you belong to our pack."},
        {"zh": "跟我交配，我们可以繁殖。", "en": "Mate with me, we can reproduce."},
        {"zh": "快点，我们来交配。", "en": "Hurry, let's mate."},
        {"zh": "来吧，我需要你。", "en": "Come, I need you."},
        {"zh": "跟我交配，我能帮你。", "en": "Mate with me, I can help you."},
        {"zh": "来吧，我保证不伤害你", "en": "Come, I promise not to hurt you"},
        {"zh": "留下吧，给尸群添一个。", "en": "Stay, and add one to the horde."},
        {"zh": "尸群要变多，得靠你。", "en": "The horde grows through you."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你闻到了吗？腐烂的美味！", "en": "Can you smell it? Rotting deliciousness!"},
        {"zh": "饥饿让我变得更强大！", "en": "Hunger makes me stronger!"},
        {"zh": "这里的食物太多了！", "en": "Too much food here!"},
        {"zh": "血肉模糊的盛宴！", "en": "A feast of flesh and blood!"},
        {"zh": "吃掉他们，填满我的肚子！", "en": "Eat them, fill my belly!"},
        {"zh": "死亡的味道如此美妙！", "en": "The taste of death is sweet."},
        {"zh": "这块骨头归我，别碰。", "en": "This bone is mine; do not touch it."},
        {"zh": "腐烂的满足感！", "en": "The satisfaction of rotting!"},
        {"zh": "我捡起半块砖，往你头上砸。", "en": "I pick up half a brick and swing at your head."},
        {"zh": "捡块碎砖，砸门正好。", "en": "A brick chunk will do for breaking doors."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的目标就在那里！", "en": "My target is there!"},
        {"zh": "锁定！射击！", "en": "Lock! Fire!"},
        {"zh": "那个玩家看起来很好！", "en": "That player looks good!"},
        {"zh": "追踪他们！", "en": "Track them!"},
        {"zh": "玩家的味道很香！", "en": "The player smells good!"},
        {"zh": "攻击他们，杀死他们！", "en": "Attack them, kill them!"},
        {"zh": "我的目标很清晰！", "en": "My target is clear!"},
        {"zh": "第四波，从不敲门。", "en": "The fourth wave never knocks."},
        {"zh": "抓住这个机会！", "en": "Seize the opportunity!"},
        {"zh": "第四拨尸群，已经围上来。", "en": "The fourth wave has already closed in."},
        {"zh": "门板挡不住第四波。", "en": "A door will not stop the fourth wave."},
        {"zh": "铁门后面有呼吸声。", "en": "Someone breathes behind that iron door."},
        {"zh": "这群人里还有活口。", "en": "There is a live one in this group."},
        {"zh": "窗户破了，路就通了。", "en": "The window broke, so the way is open."},
        {"zh": "顺着血迹找过去。", "en": "Follow the blood trail over there."},
        {"zh": "烟还没散，人没走远。", "en": "The smoke has not cleared. They are close."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的牙齿渴望鲜血！", "en": "My teeth crave blood!"},
        {"zh": "我一喊，这条街的尸体都会起来。", "en": "One call and every corpse on this street rises."},
        {"zh": "咬碎他们的骨头！", "en": "Crush their bones!"},
        {"zh": "享受战斗的乐趣！", "en": "Enjoy the fight!"},
        {"zh": "我的力量来自战斗！", "en": "My strength comes from battle!"},
        {"zh": "我就是死亡！", "en": "I am death!"},
        {"zh": "这一波尸群，比上一波多。", "en": "This horde is bigger than the last one."},
        {"zh": "死亡之吻即将降临！", "en": "Death's kiss is coming!"},
        {"zh": "让恐惧成为他们的负担！", "en": "Let fear be their burden!"},
        {"zh": "吞噬灵魂，让它们成为我的一部分！", "en": "Consume souls, let them become part of me!"},
        {"zh": "先咬腿，你就跑不动。", "en": "I bite your leg first, and you cannot run."},
        {"zh": "流血的那个先倒下。", "en": "The one bleeding falls first."},
        {"zh": "我们围成半圈慢慢收。", "en": "We close a half circle, slowly."},
        {"zh": "痛到极处，你总会叫。", "en": "Pain always makes you cry out."},
        {"zh": "你砍倒我，后面还有。", "en": "Cut me down. There are more behind."},
        {"zh": "这片废墟里没人会来。", "en": "Nobody comes to these ruins."},
        {"zh": "这一口我不会松。", "en": "This bite does not let go."},
        {"zh": "你听得见我的牙在响。", "en": "You can hear my teeth clicking."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "第四波到了，别数了。", "en": "Wave four is here. Stop counting."},
        {"zh": "我撕开你的护甲，连着皮。", "en": "I tear your armor open, skin and all."},
        {"zh": "来了，我要吃了你！", "en": "Here, I'm going to eat you!"},
        {"zh": "别动，我会咬你！", "en": "Don't move, I'll bite you!"},
        {"zh": "求求你，远离我！", "en": "Please, stay away!"},
        {"zh": "我咬住你的小腿，往后拖。", "en": "I bite your shin and drag you back."},
        {"zh": "四只手一起按上你的背。", "en": "Four hands press down on your back."},
        {"zh": "别想活！", "en": "You won't live!"},
        {"zh": "我会吞噬你！", "en": "I'll devour you!"},
        {"zh": "你逃不掉，我会吃掉你！", "en": "You can't escape, I'll eat you!"},
        {"zh": "咬住小腿，把你拖倒。", "en": "I bite your calf and drag you down."},
        {"zh": "护甲撕开，皮也撕开。", "en": "The armor tears, and so does skin."},
        {"zh": "这一下留了道血口。", "en": "That one left a bleeding cut."},
        {"zh": "四只手一起按上来。", "en": "Four hands press down at once."},
        {"zh": "你疼得站不稳了。", "en": "The pain makes your knees give."},
        {"zh": "尝尝尸群的饥饿。", "en": "Taste the hunger of the horde."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "一群丧尸要来了！", "en": "A horde of zombies is coming!"},
        {"zh": "更多丧尸加入我！", "en": "More zombies join me!"},
        {"zh": "丧尸们，准备进攻！", "en": "Zombies, get ready to attack!"},
        {"zh": "这里会有更多丧尸！", "en": "More zombies will appear here!"},
        {"zh": "召唤更多的丧尸！", "en": "Summon more zombies!"},
        {"zh": "等待着更多的丧尸！", "en": "More zombies are waiting!"},
        {"zh": "丧尸，准备战斗！", "en": "Zombies, prepare to fight!"},
        {"zh": "丧尸们，一起战斗！", "en": "Zombies, fight together!"},
        {"zh": "更多的丧尸将出现！", "en": "More zombies will appear!"},
        {"zh": "加入我们，变成丧尸！", "en": "Join us and become a zombie!"},
        {"zh": "第四波，从街角来了。", "en": "The fourth wave comes from the street corner."},
        {"zh": "墙外脚步越来越密。", "en": "Footsteps thicken outside the wall."},
        {"zh": "这栋楼里全是我们。", "en": "This whole building is us."},
        {"zh": "别关灯，我们看得见。", "en": "Don't bother with the lights. We see anyway."},
        {"zh": "你敲的每扇门都开了。", "en": "Every door you knock on opens."},
        {"zh": "数一数，已经有四群。", "en": "Count them. That is four groups already."},
        {"zh": "我们顺着脚印找到你。", "en": "We followed your footprints to you."},
        {"zh": "废墟里站起来一排。", "en": "A row of us stands up in the ruins."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰灼烧，痛苦嘶叫。", "en": "Burning, agony."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔落受伤，摇摇欲坠。", "en": "Fall, wobbling."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "溺水受伤，喘息求生。", "en": "Drowning, gasping."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸震伤，痛苦嘶叫。", "en": "Explosion, agony."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "被箭射中，惨叫连连", "en": "Arrow, wailing"}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "被魔法烧伤，痛苦嘶叫。", "en": "Magic burn, agony."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿难耐，眼神凶恶", "en": "Starving, vicious eyes"}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "被雷劈中，痛苦惨叫", "en": "Thunderstruck, agony"}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "坠入虚空，痛苦嘶叫。", "en": "Void, agony."}
      ]
    }
  }
