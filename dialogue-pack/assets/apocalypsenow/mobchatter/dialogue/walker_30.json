{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "一步一步艰难挪动", "en": "Shuffling along slowly"},
        {"zh": "腐烂身躯拖行", "en": "Decaying body dragging"},
        {"zh": "缓慢蠕动向前", "en": "Slowly shuffling forward"},
        {"zh": "发出腐臭脚步声", "en": "Giving off a stench"},
        {"zh": "蹒跚前行，步履蹒跚", "en": "Shuffling with difficulty"},
        {"zh": "腐烂体表下骨头摩擦", "en": "Bones grinding beneath rotten skin"},
        {"zh": "步伐沉重，腐肉碎裂", "en": "Heavy footsteps, flesh cracking"},
        {"zh": "饥饿驱使我前进", "en": "Hunger drives me forward"},
        {"zh": "摸索前行，寻找食物", "en": "Scouring the ground for food"},
        {"zh": "每一步都是挣扎", "en": "Each step is a struggle"},
        {"zh": "膝盖反向弯着，继续走", "en": "Knees bent the wrong way, still walking"},
        {"zh": "半个下巴在走动时掉落", "en": "Half my jaw drops off as I walk"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的双眼空洞无神", "en": "Rotting eyes lifeless"},
        {"zh": "腐烂肢体无力垂落", "en": "Limbs hang weakly"},
        {"zh": "我低头盯着一只蚂蚁爬。", "en": "I lower my head and watch an ant crawl."},
        {"zh": "眼神空洞，浑然无知", "en": "Empty eyes, mindless"},
        {"zh": "腐烂皮肤下骨头隐约可见", "en": "Bones show through decaying flesh"},
        {"zh": "枯萎的手指无力垂下", "en": "Withered fingers hanging down"},
        {"zh": "目光呆滞，毫无知觉", "en": "Stare blankly, senseless"},
        {"zh": "腐烂的手指在摸索", "en": "Rotting fingers feel around"},
        {"zh": "静默无声，呆滞不动", "en": "Silent, motionless"},
        {"zh": "腐烂肢体轻轻颤动", "en": "Rotten limbs tremble slightly"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "注视玩家，寻找猎物", "en": "Stare at player, searching for prey"},
        {"zh": "你身上的血味，跟得很远。", "en": "The smell of your blood carries far."},
        {"zh": "向玩家张望，试图锁定目标", "en": "Scan for player, locking target"},
        {"zh": "一只眼睛也够看清你了。", "en": "One eye is enough to see you."},
        {"zh": "察觉玩家，缓缓逼近", "en": "Notice player, creep closer"},
        {"zh": "目光闪烁，锁定猎物", "en": "Gleam, locking on prey"},
        {"zh": "寻找玩家，寻找机会", "en": "Seek player, seek opportunity"},
        {"zh": "目光死死盯着玩家", "en": "Stare intently at player"},
        {"zh": "注意玩家，等待时机", "en": "Notice player, waiting for chance"},
        {"zh": "我盯着你，一步也不退。", "en": "I stare at you and don't step back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的皮肤在颤抖。", "en": "Decaying flesh trembles."},
        {"zh": "腐烂的声音在呻吟。", "en": "Decaying voice moans."},
        {"zh": "身体腐烂了。", "en": "Decaying body."},
        {"zh": "这条腿，怕是要掉。", "en": "This leg is about to come off."},
        {"zh": "死亡的味道。", "en": "Death's scent."},
        {"zh": "腐烂的骨头嘎吱作响。", "en": "Decaying bones creak."},
        {"zh": "腐烂的肌肉在抽搐。", "en": "Decaying muscles twitch."},
        {"zh": "腐烂的血管在跳动。", "en": "Decaying veins pulse."},
        {"zh": "腐烂的血液在流淌。", "en": "Decaying blood flows."},
        {"zh": "腐烂的皮肤在腐烂。", "en": "Decaying flesh decays."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的血会滋养我！", "en": "Your blood will nourish me!"},
        {"zh": "别吃那个，它有毒！", "en": "Don't eat that, it's poisonous!"},
        {"zh": "过来尝尝我的味道！", "en": "Come taste me!"},
        {"zh": "你不会想离开的……", "en": "You won't want to leave..."},
        {"zh": "看着我的脸，你就会明白……", "en": "Look at my face, and you'll understand..."},
        {"zh": "我有力量改变你！", "en": "I have the power to change you!"},
        {"zh": "别挣扎，很快你也会这样！", "en": "Don't struggle, you'll be like me soon!"},
        {"zh": "你的同伴正在腐烂！", "en": "Your companions are rotting!"},
        {"zh": "加入我，我们会更强大！", "en": "Join me, we'll be stronger!"},
        {"zh": "咬一口，你就跟我走", "en": "One bite, and you walk with me"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们撞到一起了！", "en": "We collided!"},
        {"zh": "我的烂袖子挂住你了。", "en": "My rotting sleeve snags on you."},
        {"zh": "退后，这是我的领地！", "en": "Back off, this is my territory!"},
        {"zh": "小心，我有硬甲！", "en": "Watch out, I have tough skin!"},
        {"zh": "你挡了我的路，我要绕路！", "en": "You're in my way, I'll find another path!"},
        {"zh": "你的移动让我厌烦了！", "en": "Your movement irritates me!"},
        {"zh": "我们撞上了，快避开！", "en": "We collided, get out of my way!"},
        {"zh": "我的力量足以击倒你！", "en": "My strength can knock you down!"},
        {"zh": "让开，我需要空间！", "en": "Move, I need space!"},
        {"zh": "挡着我了，我推你一下！", "en": "You're in my way, I'll push you!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到我的伴侣，我们繁衍！", "en": "Find my mate, we'll reproduce!"},
        {"zh": "靠近我，我会保护你！", "en": "Come close, I'll protect you!"},
        {"zh": "你身上的温度还够暖。", "en": "You still carry enough warmth."},
        {"zh": "我需要一个伴侣来延续！", "en": "I need a mate to continue!"},
        {"zh": "你看起来很适合做我的伴侣！", "en": "You look fit to be my mate!"},
        {"zh": "腐烂的味道会引来同类。", "en": "The smell of rot will draw my own kind."},
        {"zh": "谁敢碰她，我咬断他的手。", "en": "Whoever touches her loses a hand."},
        {"zh": "找到我的伴侣，我们会一起生存！", "en": "Find my mate, we'll survive together!"},
        {"zh": "活人和死人，能不能凑一对？", "en": "Can the living and the dead pair up?"},
        {"zh": "我会给你保护，你愿意吗？", "en": "I'll give you protection, will you?"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉在腐烂，", "en": "Decaying flesh..."},
        {"zh": "寻找新的肉源。", "en": "Seeking fresh meat..."},
        {"zh": "我的目标是血肉。", "en": "Blood and flesh..."},
        {"zh": "骨头里有血。", "en": "Bones have blood..."},
        {"zh": "饥饿驱使我前行。", "en": "Hunger drives me..."},
        {"zh": "腐烂的肉如此甜美。", "en": "Sweet are the decayed flesh."},
        {"zh": "这块肉够撑到明天。", "en": "This meat will last until tomorrow."},
        {"zh": "咬碎骨头的声音。", "en": "Crushing bones..."},
        {"zh": "我的世界只有肉。", "en": "My world is flesh..."},
        {"zh": "捡起一块带血的布", "en": "I pick up a bloodstained rag"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你就在三步外，我数过了。", "en": "You're three paces away. I counted."},
        {"zh": "你腿上的旧伤在发甜。", "en": "The old wound on your leg smells sweet."},
        {"zh": "我站在门口，等你自己出来。", "en": "I stand at the door and wait for you to come out."},
        {"zh": "呼吸...然后...结束。", "en": "Breathing... then... end..."},
        {"zh": "血的味道，从你膝盖上来。", "en": "The smell of blood rises from your knee."},
        {"zh": "吞噬灵魂的时刻。", "en": "Moment of soul consumption..."},
        {"zh": "等待它接近。", "en": "Wait for it to come close..."},
        {"zh": "你腿上有旧伤，我闻得到。", "en": "There's an old wound on your leg. I smell it."},
        {"zh": "它很快就会成为我的一部分。", "en": "It will soon be a part of me..."},
        {"zh": "它会成为我的营养。", "en": "It will be my sustenance..."},
        {"zh": "你还在喘气，好事", "en": "You're still breathing. Good"},
        {"zh": "走廊尽头有活物", "en": "Something alive at the end of the hall"},
        {"zh": "你的心跳太大了", "en": "Your heartbeat is far too loud"},
        {"zh": "我闻到没烂的味道", "en": "I smell something not yet rotten"},
        {"zh": "有脚步，不是我的", "en": "Footsteps. Not mine"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "靠近，我的猎物。", "en": "Come closer, my prey..."},
        {"zh": "感受我存在的恐惧。", "en": "Feel the fear of my existence..."},
        {"zh": "一步一拖，我照样抓得住你。", "en": "One dragging step at a time, and I still catch you."},
        {"zh": "恐惧只会让你更美味。", "en": "Fear makes you tastier..."},
        {"zh": "现在就是你死的时候。", "en": "Now is your time to die..."},
        {"zh": "我的到来就是死亡。", "en": "My arrival is death..."},
        {"zh": "等待你的痛苦。", "en": "Wait for your pain..."},
        {"zh": "我站这儿很久了，腿都僵了。", "en": "I've stood here so long my legs have stiffened."},
        {"zh": "我数着你的脚步，不会数错。", "en": "I count your steps. I don't miscount."},
        {"zh": "我拖着腿慢慢靠近。", "en": "I drag one leg closer."},
        {"zh": "你退进死胡同了", "en": "You've backed into a dead end"},
        {"zh": "我慢慢地，但我不停", "en": "I'm slow, but I never stop"},
        {"zh": "门闩挡不住我", "en": "A door bolt won't hold me"},
        {"zh": "你打穿我的肚子，我照走", "en": "Shoot through my gut, I still walk"},
        {"zh": "一路滴着血靠近你", "en": "I leave a trail of blood coming to you"},
        {"zh": "你额头上全是汗", "en": "Your forehead is soaked in sweat"},
        {"zh": "我撞在门上，门在响", "en": "I hit the door. The door is cracking"},
        {"zh": "你数着子弹，我数着步子", "en": "You count bullets. I count steps"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，抓紧咬一口！", "en": "Sssss, bite now!"},
        {"zh": "血肉，就该尝尝！", "en": "Flesh, it's meant to be tasted!"},
        {"zh": "牙齿陷进你的肩膀里。", "en": "My teeth sink into your shoulder."},
        {"zh": "腐烂，让我享受吧！", "en": "腐烂，享受吧！Decay, enjoy it!"},
        {"zh": "吃点血肉，挺美味的！", "en": "Some flesh, very tasty!"},
        {"zh": "来吧，来点疼痛吧！", "en": "Here, have some pain!"},
        {"zh": "断腿，再来一腿！", "en": "Break a leg, do it again!"},
        {"zh": "咬我，你会后悔的！", "en": "Bite me, you’ll regret it!"},
        {"zh": "享受这痛苦！", "en": "Enjoy the pain!"},
        {"zh": "吸血，吸个够！", "en": "Drink blood, drink all you can!"},
        {"zh": "牙齿陷进你的肩膀！", "en": "My teeth sink into your shoulder!"},
        {"zh": "咬下你一块袖子！", "en": "I tear off a piece of your sleeve!"},
        {"zh": "用额头顶你的脸！", "en": "My forehead slams your face!"},
        {"zh": "指甲刮进你的手臂！", "en": "Nails rake into your arm!"},
        {"zh": "把你压在地上！", "en": "I crush you to the ground!"},
        {"zh": "撕开你的护腿！", "en": "I rip open your leggings!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "门口有影子，不是我的。", "en": "A shadow in the doorway. Not mine."},
        {"zh": "腐肉堆里找吃的！", "en": "Scavenge the rot!"},
        {"zh": "垃圾堆的气味让我安心。", "en": "The smell of the trash heap settles me."},
        {"zh": "这里很安全，吃点肉！", "en": "Safe here, have some flesh!"},
        {"zh": "末日，我们的时代！", "en": "The end, our time!"},
        {"zh": "腐化，我的命运！", "en": "Decay, my destiny!"},
        {"zh": "腐烂的希望，我的食粮！", "en": "Decaying hope, my meal!"},
        {"zh": "末世的晚餐，开始吧！", "en": "Dinner in the end, let’s eat!"},
        {"zh": "腐烂，永不停息！", "en": "Decay, never ceasing!"},
        {"zh": "腐烂者，我们来了！", "en": "Decay, here we come!"},
        {"zh": "废墟下面有动静", "en": "Something stirs under the rubble"},
        {"zh": "一堆碎砖开始挪动", "en": "A pile of bricks starts to shift"},
        {"zh": "我从翻倒的车后站起", "en": "I rise from behind the wrecked car"},
        {"zh": "街道上又多了一个影子", "en": "One more shadow on the street"}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮肤一碰火就卷起来。", "en": "My skin curls at the first touch of flame."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "跌落的痛苦！", "en": "Falling pain!"}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "河底的泥把我往下拽。", "en": "The river mud pulls me under."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸撕裂我！", "en": "Explosion tears me!"}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭射穿我！", "en": "Arrow pierces me!"}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔力击穿我！", "en": "Magic hits me!"}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿吞噬我！", "en": "Hunger devours me!"}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "闪电劈中我！", "en": "Lightning strikes me!"}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空吞噬我！", "en": "Void devours me!"}
      ]
    }
  }
}
