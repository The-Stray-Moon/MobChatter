    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "蠕动前行，发出低沉嘶嘶声。", "en": "Moves slowly, hissing softly."},
        {"zh": "爬行时摩擦地面，发出沙沙声。", "en": "Scratches the ground while moving."},
        {"zh": "缓慢蠕动，寻找腐肉。", "en": "Crawls slowly, seeking decayed flesh."},
        {"zh": "只剩上半身，也照样往前爬。", "en": "Only the upper half left, and I still crawl on."},
        {"zh": "缓慢移动，寻找新鲜血液。", "en": "Moves slowly, seeking fresh blood."},
        {"zh": "发出咯吱声，接近猎物。", "en": "Makes creaking sounds, approaching prey."},
        {"zh": "在腐肉堆中摸索，发出咀嚼声。", "en": "Scourges through flesh, making chewing sounds."},
        {"zh": "缓慢前行，寻找新的食物来源。", "en": "Crawls slowly, seeking new food sources."},
        {"zh": "在腐烂的环境中蠕动。", "en": "Moves in the decaying environment."},
        {"zh": "咀嚼腐肉，发出咕噜声。", "en": "Chews on decayed flesh, making gurgling sounds."},
        {"zh": "半截身子拖着往前爬", "en": "It hauls its half-body forward."},
        {"zh": "只用两只手扒着地面", "en": "It pulls itself along on two hands."}
      ]
    },
