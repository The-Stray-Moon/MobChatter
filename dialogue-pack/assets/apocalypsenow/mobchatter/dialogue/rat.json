{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着墙根跑。", "en": "I run along the base of the wall."},
        {"zh": "我的肚子擦着地。", "en": "My belly brushes the ground."},
        {"zh": "我钻过一道砖缝。", "en": "I slip through a crack in the bricks."},
        {"zh": "尾巴拖着灰。", "en": "My tail drags through the ash."},
        {"zh": "这一片废墟，我熟。", "en": "I know these ruins."},
        {"zh": "我贴着影子走。", "en": "I keep to the shadows."},
        {"zh": "我一步一停。", "en": "I step and pause."},
        {"zh": "我绕过一堆碎玻璃。", "en": "I go around broken glass."},
        {"zh": "我的爪子很小。", "en": "My claws are tiny."},
        {"zh": "我往前走一段，又回头。", "en": "I go a stretch, then look back."},
        {"zh": "我穿过一条空走廊。", "en": "I cross an empty corridor."},
        {"zh": "我跟在别的老鼠后面。", "en": "I follow the other rats."},
        {"zh": "我从管子里钻出来。", "en": "I come out of a pipe."},
        {"zh": "我在瓦砾间找路。", "en": "I pick a way through the rubble."},
        {"zh": "我走得很急。", "en": "I move hurriedly."},
        {"zh": "我又钻回了墙里。", "en": "I duck back into the wall."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在角落里。", "en": "I crouch in the corner."},
        {"zh": "废墟里的饼干屑，归我了。", "en": "Cracker crumbs in the ruins are mine."},
        {"zh": "我听着上面的声音。", "en": "I listen to the sounds above."},
        {"zh": "这里有股油味。", "en": "There is an oil smell here."},
        {"zh": "我不动，等一等。", "en": "I hold still and wait."},
        {"zh": "我的耳朵转了一下。", "en": "One ear turns."},
        {"zh": "这地方没人。", "en": "There is no one here."},
        {"zh": "我舔了舔爪子。", "en": "I lick my paw."},
        {"zh": "灰尘落在我背上。", "en": "Dust settles on my back."},
        {"zh": "我在数出口。", "en": "I am counting exits."},
        {"zh": "我什么都没做。", "en": "I do nothing."},
        {"zh": "我抬起头嗅了嗅。", "en": "I lift my head and sniff."},
        {"zh": "墙缝里比外面暖。", "en": "The gap is warmer than outside."},
        {"zh": "我又缩回去一点。", "en": "I pull back a little."},
        {"zh": "外面的风很冷。", "en": "The wind outside is cold."},
        {"zh": "我等着天黑。", "en": "I wait for dark."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你脚很大。", "en": "Your feet are large."},
        {"zh": "我不打算靠近。", "en": "I do not mean to come close."},
        {"zh": "我在你鞋边上。", "en": "I am by your shoe."},
        {"zh": "你一抬脚我就窜走。", "en": "Lift a foot and I bolt."},
        {"zh": "你有吃的吗。", "en": "Do you have food?"},
        {"zh": "我不咬人。", "en": "I do not bite people."},
        {"zh": "这地方归我们。", "en": "This place is ours."},
        {"zh": "你堵住了我的墙缝。", "en": "You are blocking my crack in the wall."},
        {"zh": "我抬头看你。", "en": "I look up at you."},
        {"zh": "你身上有血味。", "en": "You smell of blood."},
        {"zh": "我离你三步。", "en": "I am three steps off."},
        {"zh": "你别踢。", "en": "Do not kick."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚了一圈，爬起来。", "en": "I roll and get up."},
        {"zh": "我的尾巴被踩了。", "en": "My tail was stepped on."},
        {"zh": "我窜进缝里。", "en": "I dart into a crack."},
        {"zh": "这点伤，很要命。", "en": "A wound like this is grave for me."},
        {"zh": "我抖着身子。", "en": "I am trembling."},
        {"zh": "血滴在灰上。", "en": "Blood on the ash."},
        {"zh": "我慢慢往墙里退。", "en": "I back into the wall."},
        {"zh": "还能跑。", "en": "Still able to run."},
        {"zh": "我钻进管子里。", "en": "I slip into the pipe."},
        {"zh": "我等着。", "en": "I wait."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是吃的吗。", "en": "Is that food?"},
        {"zh": "我闻着像。", "en": "It smells like it."},
        {"zh": "你放低一点。", "en": "Put it lower."},
        {"zh": "我够不到。", "en": "I cannot reach."},
        {"zh": "太小一块。", "en": "Too small a piece."},
        {"zh": "我叼走了。", "en": "I took it."},
        {"zh": "还有吗。", "en": "Any more?"},
        {"zh": "这味道很旧。", "en": "That smells old."},
        {"zh": "我藏在墙缝里。", "en": "I hide it in a crack."},
        {"zh": "回头再来拿。", "en": "I will come back for it."},
        {"zh": "你也饿吧。", "en": "You are hungry too, yes?"},
        {"zh": "我不抢你的。", "en": "I will not snatch yours."},
        {"zh": "这够我两天。", "en": "This will last me two days."},
        {"zh": "谢谢你。", "en": "Thank you."},
        {"zh": "我记住这个地方了。", "en": "I remember this place now."},
        {"zh": "下次还在这儿。", "en": "Same place next time."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你靴子擦过我的背，我钻进管里。", "en": "Your boot grazes my back; I shoot into the pipe."},
        {"zh": "我窜到墙缝里。", "en": "I dart into a crack."},
        {"zh": "我的尾巴被你踩了。", "en": "You stepped on my tail."},
        {"zh": "我从你脚背上跑过去。", "en": "I run over your foot."},
        {"zh": "你要看着脚下。", "en": "Watch where you step."},
        {"zh": "这点碰撞，我受得住。", "en": "I can take that much."},
        {"zh": "我退到一边。", "en": "I move aside."},
        {"zh": "灰被我们踢起来。", "en": "We kick up dust."},
        {"zh": "别堵着缝口。", "en": "Do not block the gap."},
        {"zh": "我绕过去了。", "en": "I went around."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "墙里有好几只。", "en": "There are several of us in the wall."},
        {"zh": "它比我瘦。", "en": "It is thinner than I."},
        {"zh": "墙缝里，我们挤成一团。", "en": "In the wall crack we huddle into one ball."},
        {"zh": "这一窝在管子下面。", "en": "The nest is under the pipe."},
        {"zh": "我们不争食。", "en": "We do not fight over food."},
        {"zh": "它先睡。", "en": "It sleeps first."},
        {"zh": "我守着洞口。", "en": "I watch the opening."},
        {"zh": "外面有脚步声。", "en": "Footsteps outside."},
        {"zh": "我们都停了。", "en": "We all go still."},
        {"zh": "然后继续睡。", "en": "Then we sleep again."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有一点吃的。", "en": "There is a scrap of food."},
        {"zh": "我们四只一起穿过废墟。", "en": "Four of us cross the ruins together."},
        {"zh": "太硬，咬不动。", "en": "Too hard to bite."},
        {"zh": "我拖了一段。", "en": "I drag it a stretch."},
        {"zh": "它卡在缝里了。", "en": "It is stuck in the crack."},
        {"zh": "我把它藏好。", "en": "I stash it away."},
        {"zh": "这是我的。", "en": "This is mine."},
        {"zh": "你掉的？", "en": "You dropped this?"},
        {"zh": "我不要这个。", "en": "I do not want that."},
        {"zh": "我吃掉了。", "en": "I ate it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西能吃。", "en": "Something edible."},
        {"zh": "我看见它了。", "en": "I see it."},
        {"zh": "我贴着地面趴低。", "en": "I flatten myself to the ground."},
        {"zh": "就几步。", "en": "Just a few steps."},
        {"zh": "它没注意。", "en": "It has not noticed."},
        {"zh": "我过去了。", "en": "I am going."},
        {"zh": "快到了。", "en": "Nearly there."},
        {"zh": "别动。", "en": "Do not move."},
        {"zh": "我拿了。", "en": "I have it."},
        {"zh": "跑。", "en": "Run."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地爬。", "en": "I creep along the floor."},
        {"zh": "再近一点。", "en": "A little closer."},
        {"zh": "你的影子里有面包屑。", "en": "There are crumbs in your shadow."},
        {"zh": "我停在砖缝边。", "en": "I stop at the crack."},
        {"zh": "等它转过去。", "en": "Wait for it to turn."},
        {"zh": "好。", "en": "Good."},
        {"zh": "现在。", "en": "Now."},
        {"zh": "我冲了。", "en": "I dart."},
        {"zh": "抢到了。", "en": "I got it."},
        {"zh": "我叼起碎屑就撤。", "en": "I grab the crumbs and retreat."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬了一口。", "en": "I bit it once."},
        {"zh": "它松开了一点。", "en": "It let go a little."},
        {"zh": "我抢到一块。", "en": "I got a piece."},
        {"zh": "这不够。", "en": "Not enough."},
        {"zh": "我又冲了一次。", "en": "I dart in again."},
        {"zh": "被踢开了。", "en": "I am kicked aside."},
        {"zh": "我滚了两圈。", "en": "I roll twice."},
        {"zh": "爬起来就跑。", "en": "I get up and run."},
        {"zh": "嘴里还叼着。", "en": "Still carrying it."},
        {"zh": "值了。", "en": "Worth it."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从墙缝里钻出来。", "en": "I come out of the wall crack."},
        {"zh": "这里到处都是灰。", "en": "There is ash everywhere."},
        {"zh": "我先闻了闻。", "en": "First I sniff."},
        {"zh": "这地方有吃的。", "en": "There is food here."},
        {"zh": "下水道里，我熟得很。", "en": "The sewers are my home ground."},
        {"zh": "墙里有动静，我竖起耳。", "en": "Something moves in the wall; my ears rise."},
        {"zh": "我钻到瓦砾下面。", "en": "I go under the rubble."},
        {"zh": "这一片没人。", "en": "No one here."},
        {"zh": "我找到了个洞。", "en": "I found a hole."},
        {"zh": "开始找吧。", "en": "Let me start looking."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，我的毛就卷了。", "en": "Fire curls my fur."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处掉下，摔得发懵。", "en": "I fall and lie stunned."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水淹上来，我拼命蹬。", "en": "Water rises and I kick wildly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我撞在墙上。", "en": "The blast slams me into the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西穿了我的腿。", "en": "Something went through my leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腿不听使唤。", "en": "My legs will not obey."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我走不动。", "en": "Too hungry to walk."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照过来，我僵住了。", "en": "The flash froze me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有墙，也没有缝。", "en": "No walls here, and no cracks."}
      ]
    }
  }
}
