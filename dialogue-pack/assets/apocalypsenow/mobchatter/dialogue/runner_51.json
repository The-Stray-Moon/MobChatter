    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉散发诱惑，吸引我靠近。", "en": "腐肉’s allure draws me closer."},
        {"zh": "你的汗味，我在两条街外就闻到。", "en": "I smelled your sweat two streets away."},
        {"zh": "接近那些腐烂的味道。", "en": "Seek out the putrid scent."},
        {"zh": "我被你身上的腐肉吸引。", "en": "Your flesh’s decay attracts me."},
        {"zh": "腐肉的气味驱使我行动。", "en": "Decay’s scent compels me."},
        {"zh": "你身上的腐肉是美味。", "en": "Your flesh is delicious."},
        {"zh": "我闻到了美味的腐肉。", "en": "Delicious flesh is nearby."},
        {"zh": "腐肉的诱惑难以抵抗。", "en": "Decay’s lure is hard to resist."},
        {"zh": "腐肉的味道如此诱人。", "en": "Decay’s taste is inviting."},
        {"zh": "我渴望你的腐肉。", "en": "I crave your flesh."}
      ]
    },
