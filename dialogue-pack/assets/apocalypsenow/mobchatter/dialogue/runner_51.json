    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一瘸一拐，喉咙嘶个不停。", "en": "I limp along, my throat hissing without end."},
        {"zh": "拖着残腿走动", "en": "Drag injured legs"},
        {"zh": "慢慢靠近，眼神空洞", "en": "Creep closer, hollow gaze"},
        {"zh": "啃咬腐烂的手臂", "en": "Bite at rotting arm"},
        {"zh": "盯着你，腐臭气息", "en": "Stare at you, foul stench"},
        {"zh": "舔舐地面的腐肉", "en": "Lick at ground flesh"},
