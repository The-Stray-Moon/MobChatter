{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "拖着腐烂身躯前行", "en": "拖行 with rotting body"},
        {"zh": "蹒跚地走向末地", "en": "Shamble to the Nether"},
        {"zh": "腐肉在腐肉上摩擦", "en": "Skin rubs on skin"},
        {"zh": "步伐沉重，腐朽前行", "en": "Heavy steps, decayed前行"},
        {"zh": "向更远的末地进发", "en": "Marching to the Nether"},
        {"zh": "缓慢移动，寻找食物", "en": "Slow move, seeking food"},
        {"zh": "腐烂脚步声响起", "en": "腐烂脚步 echo"},
        {"zh": "脚步声在地面上回响", "en": "Footsteps echo on ground"},
        {"zh": "腐烂的行走声音", "en": "Rotting footsteps sound"},
        {"zh": "在尸群中寻找猎物", "en": "Scanning for prey in horde"},
        {"zh": "一条腿拖着另一条腿挪。", "en": "One leg drags the other along."},
        {"zh": "脚踝歪着，我还是往前。", "en": "My ankle is crooked; still I go on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的身躯静止", "en": "Corpse still"},
        {"zh": "静静等待猎物出现", "en": "Wait for prey"},
        {"zh": "腐肉堆中懒散躺着", "en": "Lying in the corpse pile"},
        {"zh": "目光呆滞，无所事事", "en": "Stare, idle"},
        {"zh": "腐烂中度过无意义的时光", "en": "Decay meaningless"},
        {"zh": "我靠着断墙，阳光晒着烂肉。", "en": "I lean on a broken wall as sun roasts my rotting flesh."},
        {"zh": "缓慢转动眼球", "en": "Slow eye movement"},
        {"zh": "腐烂中的片刻宁静", "en": "Brief calm in decay"},
        {"zh": "无目的地四处游荡", "en": "Wandering aimlessly"},
        {"zh": "腐烂躯体懒散自嘲", "en": "Corpse mocks itself"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪着头，一直盯着你。", "en": "My head tilts and I keep staring at you."},
        {"zh": "贪婪地盯着玩家", "en": "Greedy gaze on player"},
        {"zh": "试图发现玩家", "en": "Seeking player"},
        {"zh": "我的眼球在眼眶里慢慢转。", "en": "My eyeballs turn slowly in their sockets."},
        {"zh": "碎掉的眼镜后面，我看见了。", "en": "Behind cracked glasses, I see you."},
        {"zh": "目光游离于玩家", "en": "Drifting gaze on player"},
        {"zh": "目光闪烁着贪婪", "en": "Greedy eyes"},
        {"zh": "盯紧玩家的身影", "en": "Fixated on player"},
        {"zh": "目光中充满渴望", "en": "Desire in eyes"},
        {"zh": "目光凶狠地盯着玩家", "en": "Fierce gaze on player"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉在我体内腐烂", "en": "Decay eats at my flesh"},
        {"zh": "疼痛撕扯着我的灵魂", "en": "Pain rends my soul"},
        {"zh": "腐烂的皮肤下是空洞", "en": "Empty where my skin was"},
        {"zh": "骨髓在腐烂中枯竭", "en": "Marrow fades in decay"},
        {"zh": "尸虫吞噬着我的灵魂", "en": "Corpses feed on my soul"},
        {"zh": "死亡之风在我的骨中吹过", "en": "Death whispers in my bones"},
        {"zh": "腐肉的恶臭弥漫四周", "en": "Putrid stench fills the air"},
        {"zh": "我的脚步声掩盖了痛苦", "en": "My footsteps mask agony"},
        {"zh": "腐烂在每一寸肌肤下", "en": "Decay under every inch"},
        {"zh": "腐肉将我从内到外侵蚀", "en": "Decay eats from the inside"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的肉味勾引着你靠近。", "en": "The stench of decay pulls you closer."},
        {"zh": "你体内有股冲动，想尝尝我的肉。", "en": "An urge stirs in you to taste my flesh."},
        {"zh": "我能感受到你的欲望。", "en": "I can feel your desire."},
        {"zh": "靠近我，你会获得力量。", "en": "Come closer, you'll gain strength."},
        {"zh": "尝一口我的肉，你会变得更强大。", "en": "Taste my flesh, and you'll grow stronger."},
        {"zh": "你渴望的，我都能给你。", "en": "What you desire, I can give you."},
        {"zh": "别抵抗，加入我们吧。", "en": "Resist not, join us."},
        {"zh": "来吧，一起统治这个世界。", "en": "Come, rule the world with us."},
        {"zh": "你的同类已经放弃，为何不加入我们？", "en": "Your kind has given up, why not join us?"},
        {"zh": "把嘴凑过来，我不会咬太重。", "en": "Come closer; I will bite gently."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了我的视线。", "en": "You've collided with my sight."},
        {"zh": "躲开，我的视线覆盖了整片区域。", "en": "Move, my sight spans this area."},
        {"zh": "撞上我，你就沾了这身腐烂。", "en": "Bump me and the rot rubs off on you."},
        {"zh": "墓园这片土，是我先来的。", "en": "I reached this graveyard soil first."},
        {"zh": "避让，否则我会攻击。", "en": "Move, or I'll attack."},
        {"zh": "你离得太近了，我能看到你的恐惧。", "en": "You're too close, I see your fear."},
        {"zh": "你的存在干扰了我的视线。", "en": "Your presence interferes with my sight."},
        {"zh": "别靠近，否则你会死。", "en": "Don't come closer, or you'll die."},
        {"zh": "你阻挡了我的视线，快离开。", "en": "You block my sight, move away."},
        {"zh": "肩膀撞一下，骨头就掉渣。", "en": "One shoulder bump and bones flake off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同类，一起繁殖。", "en": "Mate, let's reproduce."},
        {"zh": "我们需要更多行尸。", "en": "We need more walkers."},
        {"zh": "来吧，来繁殖下一代。", "en": "Come, reproduce the next generation."},
        {"zh": "我们是同类，应该繁衍。", "en": "We are kind, we should procreate."},
        {"zh": "寻找更多可以变成行尸的生物。", "en": "Find more to turn into walkers."},
        {"zh": "只有与同类交配，才能生存下去。", "en": "Only by mating with our kind can we survive."},
        {"zh": "我们是末世的希望，繁衍下去。", "en": "We are hope in the apocalypse, procreate."},
        {"zh": "同类相残，才能生存。", "en": "Survival through同类相残."},
        {"zh": "繁衍后代，让末世更有力量。", "en": "Procreate offspring, make the apocalypse stronger."},
        {"zh": "来嘛，我身上的腐肉分你一半。", "en": "Come; share my rotting flesh."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "皮肤干瘪，肌肉松弛。", "en": "Dry skin, loose muscles."},
        {"zh": "腐烂肢体，难以愈合。", "en": "Rotten limbs, hard to heal."},
        {"zh": "骨瘦如柴，皮肉紧贴。", "en": "Bony frame, skin tight."},
        {"zh": "尸臭难闻，四处扩散。", "en": "Putrid smell, spreading everywhere."},
        {"zh": "伤口不断流血，难以止住。", "en": "Wound bleeding, hard to stop."},
        {"zh": "步履蹒跚，行动缓慢。", "en": "Shuffling, slow movement."},
        {"zh": "视线模糊，行动迟缓。", "en": "Blurred vision, slow action."},
        {"zh": "腐肉覆盖，皮肉俱裂。", "en": "Flesh rotted, skin cracked."},
        {"zh": "腐烂未尽，骨肉模糊。", "en": "Half-decayed, bones visible."},
        {"zh": "腐化躯体，行尸走肉。", "en": "Corrupted body, walking dead."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "闻到食物气息。", "en": "Smell food."},
        {"zh": "追踪猎物气味。", "en": "Track prey."},
        {"zh": "视线锁定猎物。", "en": "Lock on target."},
        {"zh": "靠近目标，准备攻击。", "en": "Approach target, ready to attack."},
        {"zh": "注意到了潜在食物。", "en": "Noticed potential food."},
        {"zh": "锁定行动中的猎物。", "en": "Locked on moving prey."},
        {"zh": "寻找可食用的腐肉。", "en": "Search for edible flesh."},
        {"zh": "察觉到附近有食物。", "en": "Detect food nearby."},
        {"zh": "闻到猎物的味道。", "en": "Smell prey."},
        {"zh": "寻找可食用的目标。", "en": "Search for edible target."},
        {"zh": "有人在墙那边喘气。", "en": "Someone is breathing past the wall."},
        {"zh": "我抬起头，闻到了活肉。", "en": "I lift my head and smell living meat."},
        {"zh": "这双眼睛终于有用了。", "en": "These eyes are finally useful."},
        {"zh": "你动一下，我就转向你。", "en": "Move once, and I turn to you."},
        {"zh": "来吧，别躲在门后。", "en": "Come out; do not hide behind the door."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "喉咙里挤出一声，腿已经动了。", "en": "A rasp escapes my throat; my legs already move."},
        {"zh": "靠近猎物，准备噬咬。", "en": "Approach prey, ready to bite."},
        {"zh": "盯紧猎物，静待时机。", "en": "Stare at prey, waiting."},
        {"zh": "瞄准目标，准备撕咬。", "en": "Aim at target, ready to bite."},
        {"zh": "咬住猎物，发出嘶嘶声。", "en": "Bite prey, sssss."},
        {"zh": "用嘴撕扯猎物，发出嘶鸣。", "en": "Tear prey, hiss."},
        {"zh": "用力撕咬，发出沉重呼吸。", "en": "Bite hard, heavy breathing."},
        {"zh": "紧紧咬住猎物，不放手。", "en": "Hold prey, don't let go."},
        {"zh": "撕破猎物皮肤，流出血液。", "en": "Rip skin, blood flows."},
        {"zh": "咬破猎物，流出鲜血。", "en": "Bite, blood spurts."},
        {"zh": "我一步一步蹭过去。", "en": "I shuffle toward you, step by step."},
        {"zh": "我不急，我从不急。", "en": "I am in no hurry. I never am."},
        {"zh": "你关门也没用，我会撞。", "en": "Close the door; I will break it."},
        {"zh": "腐臭的味道越来越浓。", "en": "The stench grows thicker."},
        {"zh": "两条手臂僵在胸前，放不下。", "en": "Both arms stiff at my chest, and I cannot lower them."},
        {"zh": "你在喘，我听见了。", "en": "You are panting; I hear it."},
        {"zh": "我摔一跤也能爬起来。", "en": "Even if I fall, I get back up."},
        {"zh": "你的火把挡不住我太久。", "en": "Your torch will not hold me long."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "啃咬尸体，腐烂味儿!", "en": "Chew on flesh, stench!"},
        {"zh": "腐肉的味道，不错!", "en": "Decaying flesh, good!"},
        {"zh": "吃点血肉!", "en": "Some flesh!"},
        {"zh": "腐烂的馈赠!", "en": "Decay's gift!"},
        {"zh": "吞下这腐臭!", "en": "Swallow this stench!"},
        {"zh": "啃咬骨骼，嘶嘶声!", "en": "Chomp bones, hiss!"},
        {"zh": "腐烂的骨头!", "en": "Decaying bone!"},
        {"zh": "腐肉盛宴!", "en": "Flesh feast!"},
        {"zh": "吞食腐肉!", "en": "Eat decay!"},
        {"zh": "啃咬，吸血!", "en": "Chomp, drink blood!"},
        {"zh": "牙口不好，但咬得住。", "en": "My teeth are poor, but they hold."},
        {"zh": "手指抠进你的手臂。", "en": "My fingers dig into your arm."},
        {"zh": "咬下去，你走不掉了。", "en": "One bite, and you cannot leave."},
        {"zh": "我扑你，摔在我自己身上。", "en": "I lunge and land on my own corpse."},
        {"zh": "撕开皮，血是热乎的。", "en": "I tear the skin; the blood is warm."},
        {"zh": "你踢我，我抱住你的腿。", "en": "Kick me, and I hug your leg."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "腐化之地，诞生!", "en": "Spawn in decay!"},
        {"zh": "腐烂者，再生!", "en": "Rise, decayer!"},
        {"zh": "腐肉中成长!", "en": "Grow in decay!"},
        {"zh": "末日的召唤!", "en": "Call of the end!"},
        {"zh": "腐化之地现生!", "en": "Spawn in rot!"},
        {"zh": "腐肉中的生命!", "en": "Life in decay!"},
        {"zh": "腐烂的起源!", "en": "Origin of decay!"},
        {"zh": "腐肉的新生!", "en": "New in decay!"},
        {"zh": "腐化之地再现!", "en": "Re-spawn in rot!"},
        {"zh": "腐肉中的诞生!", "en": "Spawn in flesh!"},
        {"zh": "坟头的土松了，我出来了。", "en": "The grave soil loosens; I climb out."},
        {"zh": "我已经记不清自己是谁。", "en": "I can no longer recall who I was."},
        {"zh": "身上还挂着半件旧衣服。", "en": "Half an old shirt still hangs on me."},
        {"zh": "这一片废墟，我来走走。", "en": "These ruins are mine to wander."}
      ]
    },
