      "lines": [
        {"zh": "爬行如风，无声无息。", "en": "Scurrying silent, swift."},
        {"zh": "虫之大军，悄无声息。", "en": "Silent swarm advances."},
        {"zh": "在地上找食，忙碌不停。", "en": "Scouring the ground for food."},
        {"zh": "四处寻找，不惧黑夜。", "en": "Scouring day and night."},
        {"zh": "爬行在角落，寻找食物。", "en": "Crawling in corners, seeking food."},
        {"zh": "黑暗中滑行，寻找美味。", "en": "Sliding in darkness, seeking delicacies."},
        {"zh": "在垃圾堆中翻找，寻找美味。", "en": "Searching through trash for treats."},
        {"zh": "在厨房搜寻，寻找食物。", "en": "Searching kitchens for food."},
        {"zh": "在夜晚寻找食物，无声无息。", "en": "Scouring night, silent."},
        {"zh": "在裂缝中穿梭，寻找食物。", "en": "Scurrying in cracks, seeking food."},
        {"zh": "六条腿，贴着墙根跑", "en": "Six legs racing along the baseboard."},
        {"zh": "触角先探路，身子才跟上", "en": "Antennae scout ahead before the body follows."},
        {"zh": "三到五只，一起窜出来", "en": "Three to five of us burst out together."},
        {"zh": "从水管后面绕过来", "en": "It slips around from behind the pipe."},
        {"zh": "爬过碎砖，一晃就没了", "en": "Over broken brick, gone in a blink."},
        {"zh": "鞘翅蹭着地面沙沙响", "en": "Wing cases rasp softly on the ground."}
      ]
    },
