{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，这里不安全。", "en": "Hissss, this place is dangerous."},
        {"zh": "脚下有碎玻璃，跟着我走。", "en": "There is broken glass underfoot; walk behind me."},
        {"zh": "保持距离，我刀还没收。", "en": "Keep your distance; my blade is still out."},
        {"zh": "我是7号幸存者。", "en": "I'm Survivor 7."},
        {"zh": "这里的夜晚很冷。", "en": "The nights here are cold."},
        {"zh": "别碰我肩上的旧伤。", "en": "Don't touch the old wound on my shoulder."},
        {"zh": "我有同伴在附近。", "en": "I have allies nearby."},
        {"zh": "我的武器在背包里。", "en": "My weapon is in my bag."},
        {"zh": "保持安静，别惊动它们。", "en": "Be quiet, don't awaken them."},
        {"zh": "我们需要更多的弹药。", "en": "We need more ammo."},
        {"zh": "压低身子贴着墙走", "en": "I hug the wall, keeping low."},
        {"zh": "边走边看身后", "en": "I walk and keep checking behind me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我翻着这排货架，找罐头。", "en": "I'm combing these shelves for canned food."},
        {"zh": "我守在这扇门后面，别怕。", "en": "I am holding this door. Do not be afraid."},
        {"zh": "不要来打扰我。", "en": "Don't bother me."},
        {"zh": "我正在休息。", "en": "I'm resting."},
        {"zh": "注意周围的声音。", "en": "Listen to your surroundings."},
        {"zh": "这里很安静。", "en": "It's quiet here."},
        {"zh": "我有重要的信息。", "en": "I have important info."},
        {"zh": "这里没有敌对生物。", "en": "There are no hostile mobs here."},
        {"zh": "我需要补给。", "en": "I need supplies."},
        {"zh": "窗外的脚步声，我数到第三遍。", "en": "Third time now I have counted steps outside."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在这翻什么？先说清楚。", "en": "What are you digging for here? Explain."},
        {"zh": "别吓我！", "en": "Don't scare me!"},
        {"zh": "你看起来很强壮。", "en": "You look strong."},
        {"zh": "你有光吗？", "en": "Do you have a light?"},
        {"zh": "你有武器吗？", "en": "Do you have a weapon?"},
        {"zh": "你是个幸存者？", "en": "A survivor, huh?"},
        {"zh": "你有治疗品吗？", "en": "Do you have healing items?"},
        {"zh": "你看起来很害怕。", "en": "You look scared."},
        {"zh": "小心，它们来了。", "en": "Watch out, they're coming."},
        {"zh": "你手里的枪，先把保险关上。", "en": "Put the safety on that gun first."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身体受伤，好痛苦！", "en": "Wound hurts..."},
        {"zh": "这口子得缝，不然会烂。", "en": "This cut needs stitches or it will rot."},
        {"zh": "末世里，血味会招来它们。", "en": "In this world, blood draws them."},
        {"zh": "受伤了，真难受！", "en": "Wounded, so painful."},
        {"zh": "身体受伤了，很疼！", "en": "Wounded, really painful."},
        {"zh": "受伤了，得找医生！", "en": "Need a healer."},
        {"zh": "身体受了伤，好痛！", "en": "Wounded, so painful."},
        {"zh": "受伤了，快找治疗！", "en": "Wounded, need help!"},
        {"zh": "身体受创，真疼！", "en": "Wound hurts!"},
        {"zh": "受伤了，赶紧治疗！", "en": "Seek healing!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "来吧，给我点儿吃的。", "en": "Come on, give me some food."},
        {"zh": "看我的爪子，你想要的都在这里。", "en": "Look at my claws, what you want is here."},
        {"zh": "我是同类，可以交易。", "en": "I'm one of them, we can trade."},
        {"zh": "你需要武器，我可以提供。", "en": "You need weapons, I can provide."},
        {"zh": "别怕，我们合作吧。", "en": "Don't be afraid, let's work together."},
        {"zh": "你们的光很美，可以交易。", "en": "Your light is beautiful, we can trade."},
        {"zh": "给我点食物，我不会伤害你。", "en": "Give me some food, I won't hurt you."},
        {"zh": "交换食物，我们会互相帮助。", "en": "Exchange food, we'll help each other."},
        {"zh": "你们可以带我去安全的地方吗？", "en": "Can you take me to a safe place?"},
        {"zh": "我能帮你们对抗其他生物。", "en": "I can help you fight other creatures."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，我来帮你。", "en": "Watch out, I'll help you."},
        {"zh": "我们共同对付它。", "en": "We take it down together."},
        {"zh": "退后，这扇门我来撬。", "en": "Step back; I'll pry this door."},
        {"zh": "一起战斗，我们会胜利的。", "en": "Fight together, we'll win."},
        {"zh": "让我来解决它。", "en": "Let me deal with it."},
        {"zh": "它危险，让我们分开。", "en": "It's dangerous, let's keep our distance."},
        {"zh": "别害怕，我会保护你。", "en": "Don't be scared, I'll protect you."},
        {"zh": "我们一同对抗敌人。", "en": "We fight against the enemies together."},
        {"zh": "跟我来，我知道出路。", "en": "Follow me, I know the way out."},
        {"zh": "不要攻击，我们是朋友。", "en": "Don't attack, we're friends."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们找个地方安静聊一聊。", "en": "Let's find a quiet place to talk."},
        {"zh": "我俩可以一起行动。", "en": "We can work together."},
        {"zh": "跟我来，我带你去看看。", "en": "Follow me, I'll show you around."},
        {"zh": "我们可以一起找食物。", "en": "We can find food together."},
        {"zh": "一起觅食，我会保护你。", "en": "Let's forage together, I'll protect you."},
        {"zh": "让我们结伴而行。", "en": "Let's travel together."},
        {"zh": "一起探索未知。", "en": "Explore the unknown together."},
        {"zh": "跟我来，我带你回家。", "en": "Follow me, I'll take you home."},
        {"zh": "一起面对挑战吧。", "en": "Face the challenges together."},
        {"zh": "我们可以相互依靠。", "en": "We can rely on each other."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这是最后一块面包！", "en": "The last loaf of bread!"},
        {"zh": "来吧，共享我的晚餐。", "en": "Have some of my dinner."},
        {"zh": "你有食物吗？", "en": "Got any food?"},
        {"zh": "别怕，我不会吃你的。", "en": "Don't worry, I won't eat you."},
        {"zh": "我能给你带来希望。", "en": "I can bring you hope."},
        {"zh": "把面包给我！", "en": "Give me the bread!"},
        {"zh": "我们一起生存下去。", "en": "Survive with me."},
        {"zh": "我需要食物来恢复。", "en": "Need food to recover."},
        {"zh": "这片废楼，我先占下了。", "en": "I claimed these ruins first."},
        {"zh": "这袋米谁也别想碰。", "en": "Nobody touches this sack of rice."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "注意，它来了。", "en": "Watch out, it's coming."},
        {"zh": "它在接近。", "en": "It's getting closer."},
        {"zh": "小心，它要攻击了。", "en": "Be careful, it's attacking."},
        {"zh": "它想吃你。", "en": "It wants to eat you."},
        {"zh": "它的视线锁定你了。", "en": "Its sight is on you."},
        {"zh": "不要离开。", "en": "Don't move."},
        {"zh": "它在寻找猎物。", "en": "It's hunting."},
        {"zh": "它会攻击你的。", "en": "It will attack you."},
        {"zh": "我这把枪只剩两发，别浪费。", "en": "Two rounds left; do not waste them."},
        {"zh": "它对你会感兴趣。", "en": "It might be interested in you."},
        {"zh": "前面有动静，别出声", "en": "Something is moving ahead. Stay quiet."},
        {"zh": "把刀握紧，慢慢过去", "en": "Grip the knife and move up slow."},
        {"zh": "那脚步声不像人", "en": "Those footsteps do not sound human."},
        {"zh": "我数着它拖脚的节奏。", "en": "I count the rhythm of its dragging steps."},
        {"zh": "先找个能躲的地方", "en": "First, find somewhere to hide."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我要吸取你的能量。", "en": "I'll drain your energy."},
        {"zh": "我数过子弹，只剩一发。", "en": "I counted my rounds. One left."},
        {"zh": "你的生命是我的食物。", "en": "Your life is my food."},
        {"zh": "我手里的燃烧瓶已经点了。", "en": "The molotov in my hand is already lit."},
        {"zh": "我会享受你的。", "en": "I'll enjoy you."},
        {"zh": "你的力量属于我。", "en": "Your strength is mine."},
        {"zh": "你的灵魂是我的。", "en": "Your soul is mine."},
        {"zh": "巷口我守过两夜，没睡。", "en": "Two nights on this alley, no sleep."},
        {"zh": "我不会再放过你。", "en": "I won't let you go again."},
        {"zh": "你已经在我掌中。", "en": "You're in my grasp."},
        {"zh": "它转过弯就会看见我们", "en": "It turns the corner, it sees us."},
        {"zh": "瞄着它的膝盖", "en": "Aim for its knee."},
        {"zh": "一动手就不能停", "en": "Once we start, do not stop."},
        {"zh": "退路在左边巷子里", "en": "The way out is the alley to the left."},
        {"zh": "别让它咬到你的手", "en": "Do not let it bite your hand."},
        {"zh": "咬伤是治不好的", "en": "A bite cannot be cured."},
        {"zh": "我数到三一起上", "en": "On three, we go together."},
        {"zh": "让它先扑个空", "en": "Let it lunge at nothing first."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "饿急了，我咬你的手腕。", "en": "Hunger wins; I bite your wrist."},
        {"zh": "躲开，我饿了！", "en": "Move, I'm hungry!"},
        {"zh": "尝尝幸存者的味道！", "en": "Try the survivor's taste!"},
        {"zh": "你的肉比罐头新鲜。", "en": "Your flesh is fresher than canned meat."},
        {"zh": "快点来，我等不及了！", "en": "Come on, I can't wait!"},
        {"zh": "你的血很鲜美！", "en": "Your blood is fresh!"},
        {"zh": "别跑，我追你！", "en": "Don't run, I'll catch you!"},
        {"zh": "我用撬棍砸你的膝。", "en": "I swing a crowbar at your knee."},
        {"zh": "幸存者的拳头，比牙还硬。", "en": "A survivor's fist is harder than teeth."},
        {"zh": "我的牙齿很锋利！", "en": "My teeth are sharp!"},
        {"zh": "照着头砸下去！", "en": "Bring it down on its head!"},
        {"zh": "一刀砍在它的肘上！", "en": "A slash across its elbow!"},
        {"zh": "别停手，它还会起来！", "en": "Do not stop; it gets back up!"},
        {"zh": "我按住它，你来！", "en": "I hold it down. You strike!"},
        {"zh": "血溅到我脸上了！", "en": "Blood is on my face!"},
        {"zh": "这一下是替他们偿的！", "en": "That one is for the ones it took!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从废车后面出来了，别慌。", "en": "I'm stepping out from behind the wreck, don't panic."},
        {"zh": "寻找食物的时间到了！", "en": "Time to find food!"},
        {"zh": "夜里我看得比你清楚。", "en": "I see better than you in the dark."},
        {"zh": "我还活着，背包还没丢。", "en": "I am alive, and I still have my pack."},
        {"zh": "等待我的，只有死亡！", "en": "All I face is death!"},
        {"zh": "末日已经来临！", "en": "The end is here!"},
        {"zh": "你们都是我的猎物！", "en": "All of you are my prey!"},
        {"zh": "这个世界，只有我！", "en": "This world, only me!"},
        {"zh": "来吧，让我来收割！", "en": "Come, let me harvest!"},
        {"zh": "生存者，准备迎接死亡！", "en": "Survivors, prepare to die!"},
        {"zh": "废墟里钻出个人影", "en": "A figure crawls out of the ruins."},
        {"zh": "我从破墙后走出来", "en": "I step out from behind a broken wall."},
        {"zh": "刀还在，人就还活着", "en": "Knife still here, so I am still alive."},
        {"zh": "这里还有活人，别怕", "en": "There is still a living one here. Do not be afraid."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "着火啦！快帮我扑灭！", "en": "I'm on fire! Help me put it out!"}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从高处摔下受伤！", "en": "Fell and hurt!"}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进肺里了，拉我！", "en": "Water's in my lungs, pull me up!"}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "耳鸣压过了远处的尸群声。", "en": "Ringing drowns out the horde in the distance."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "被弹射物击伤！", "en": "Shot by projectile!"}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光打过来，皮都焦了。", "en": "That light scorched my skin."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得受了伤！", "en": "Starved and hurt!"}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在废墟上，也打中我。", "en": "Lightning hit the ruins and me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "坠入虚无受了伤！", "en": "Void hurt me!"}
      ]
    }
  }
}
