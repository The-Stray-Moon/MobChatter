{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "缓慢拖动身躯", "en": "Drag its body slowly"},
        {"zh": "摇晃着前行", "en": "Shuffle forward"},
        {"zh": "腐烂的手指摸索", "en": "Rotten fingers feel around"},
        {"zh": "腐臭的气味令人作呕", "en": "Stench makes you gag"},
        {"zh": "蹒跚着接近", "en": "Lurch closer"},
        {"zh": "发出腐烂的呻吟", "en": "Moan in decay"},
        {"zh": "摸索着前行", "en": "Feel its way forward"},
        {"zh": "腐烂的肌肉蠕动", "en": "Rotten muscles move"},
        {"zh": "我的拖鞋在柏油上蹭出声音。", "en": "My slippers scrape across the asphalt."},
        {"zh": "腐烂的肢体摆动", "en": "Rotten limbs swing"},
        {"zh": "拖鞋在柏油上蹭出声", "en": "A slipper scrapes on the asphalt."},
        {"zh": "它一步一歪挪过马路", "en": "It limps across the road."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的双眼空洞", "en": "Rotting eyes hollow"},
        {"zh": "腐烂的手垂落", "en": "Rotten hands hang"},
        {"zh": "腐烂的皮肤松弛", "en": "Rotten skin hangs loose"},
        {"zh": "腐烂的嘴不停蠕动", "en": "Rotten mouth moves non-stop"},
        {"zh": "我靠着翻倒的购物车喘气。", "en": "I lean on an overturned shopping cart and wheeze."},
        {"zh": "腐烂的躯体摇晃", "en": "Rotten body sways"},
        {"zh": "腐烂的手指扭曲", "en": "Rotten fingers twist"},
        {"zh": "腐烂的肌肉松弛", "en": "Rotten muscles relax"},
        {"zh": "腐烂的肢体瘫软", "en": "Rotten limbs hang limp"},
        {"zh": "它靠着翻倒的车喘息", "en": "It leans on a flipped car, wheezing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪头，脖子里的骨头响。", "en": "I tilt my head and bones grind in my neck."},
        {"zh": "寻找玩家", "en": "Look for player"},
        {"zh": "我拖着一条腿跟着你", "en": "I drag one leg after you"},
        {"zh": "我看你，是因为你会动。", "en": "I watch you because you move."},
        {"zh": "我这双烂眼，只盯着活人。", "en": "These rotted eyes only watch the living."},
        {"zh": "路灯下，你的影子会动。", "en": "Under the streetlight, your shadow moves."},
        {"zh": "我在废弃公交站后面找你。", "en": "I look for you behind the abandoned bus stop."},
        {"zh": "你抬手，我的下颌也跟着松。", "en": "You raise your hand and my jaw loosens too."},
        {"zh": "你的汗味顺着热风飘过来。", "en": "Your sweat drifts over on the warm wind."},
        {"zh": "我盯着你手里那把生锈的撬棍。", "en": "I stare at the rusty crowbar in your hand."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的皮肉在呻吟。", "en": "Rotting flesh groans."},
        {"zh": "腐肉下的骨头在哀嚎。", "en": "Bones beneath the rotting flesh cry out."},
        {"zh": "我的膝盖软了，跪在柏油上。", "en": "My knees give and I kneel on the asphalt."},
        {"zh": "我的骨头在碎裂。", "en": "My bones are breaking."},
        {"zh": "疼痛如刀割。", "en": "Pain like a knife."},
        {"zh": "我的手还伸着，已经抓不住。", "en": "My hand is still reaching but cannot grip."},
        {"zh": "血流出来，我却感觉不到。", "en": "Blood runs out, and I feel nothing."},
        {"zh": "我需要进食。", "en": "I need to feed."},
        {"zh": "我无法再支撑。", "en": "I can’t hold on."},
        {"zh": "腿上的伤口又裂开了。", "en": "The wound on my leg split again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉吸引我，鲜血滋养我！", "en": "腐肉 feeds me, blood nourishes me!"},
        {"zh": "腐烂的气息，驱使我前行！", "en": "Rotten scent, drives me forward!"},
        {"zh": "饥饿的召唤，无尽的吞噬！", "en": "Call of hunger, endless devouring!"},
        {"zh": "你身上有我所需的肉！", "en": "You have the meat I need!"},
        {"zh": "我的触手，寻找你的肉！", "en": "My tentacles seek your flesh!"},
        {"zh": "腐烂的本能，驱使我行动！", "en": "Decay's instinct drives me!"},
        {"zh": "血与肉，永不停歇！", "en": "Blood and flesh, never cease!"},
        {"zh": "你的痛苦，我的享受！", "en": "Your pain, my pleasure!"},
        {"zh": "腐烂的触感，满足我的需求！", "en": "Rotten touch, fulfills me!"},
        {"zh": "腐肉中藏匿的力量！", "en": "Power in the rotten meat!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头与骨头碰撞！", "en": "Bone clatters against bone!"},
        {"zh": "肉体接触，腐烂！", "en": "Flesh touches, decays!"},
        {"zh": "我们的灵魂交汇！", "en": "Our souls meet!"},
        {"zh": "腐烂的肉体碰撞！", "en": "Decaying flesh collides!"},
        {"zh": "触手缠绕，腐烂加剧！", "en": "Tentacles entwine, decay grows!"},
        {"zh": "腐烂的触碰，无尽痛苦！", "en": "Decaying touch, endless pain!"},
        {"zh": "骨骼摩擦，腐烂加剧！", "en": "Bone scrapes, decay worsens!"},
        {"zh": "腐烂的碰撞，痛苦加剧！", "en": "Decaying collision, pain intensifies!"},
        {"zh": "腐肉摩擦，更加腐烂！", "en": "Rotten meat rubs, decays more!"},
        {"zh": "腐烂的肢体碰撞，痛苦无尽！", "en": "Decaying limbs collide, pain unending!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到同类，我的使命！", "en": "Found a mate, my purpose!"},
        {"zh": "腐烂的伴侣，共同毁灭！", "en": "Decay's partner, mutual annihilation!"},
        {"zh": "同类的气息，诱惑我！", "en": "Mate's scent, lures me!"},
        {"zh": "腐烂的繁殖，延续死亡！", "en": "Decay's breeding,延续 death!"},
        {"zh": "共同的腐烂，共享痛苦！", "en": "Shared decay, shared pain!"},
        {"zh": "同类相食，腐烂不断！", "en": "Mutual consumption, decay unending!"},
        {"zh": "腐烂的结合，痛苦的延续！", "en": "Decay's union, pain's continuation!"},
        {"zh": "同类的触碰，腐烂加速！", "en": "Mate's touch, decay speeds!"},
