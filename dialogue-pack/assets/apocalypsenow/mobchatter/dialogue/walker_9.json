    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你就是我的下一餐。", "en": "You're my next meal."},
        {"zh": "我看见你的恐惧。", "en": "I see your fear."},
        {"zh": "你是下一个。", "en": "You're next."},
        {"zh": "你的灵魂属于我。", "en": "Your soul is mine."},
        {"zh": "你的命垂危。", "en": "Your life is in peril."},
        {"zh": "我一步一步挪，也够到你。", "en": "Step by step, I still reach you."},
        {"zh": "你将属于我。", "en": "You will be mine."},
        {"zh": "我加速时，那只脚拖得更响。", "en": "When I speed up, my dragging foot gets louder."},
        {"zh": "腐烂的手抓住门框了。", "en": "A rotting hand has gripped the doorframe."},
