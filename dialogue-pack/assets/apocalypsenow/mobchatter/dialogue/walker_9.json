        {"zh": "它闻到活人的汗味", "en": "It smells living sweat."},
        {"zh": "下颌松脱后又咬紧", "en": "Its jaw unhinges, then clenches."},
        {"zh": "它朝你的方向歪头", "en": "It tilts its head your way."},
        {"zh": "它拖着一条腿加速", "en": "It drags a leg and speeds up."},
        {"zh": "它伸出指甲发黑的手", "en": "It reaches out with black nails."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我要撕碎你。", "en": "I'll tear you apart."},
        {"zh": "你跑进死胡同了，前面是砖墙。", "en": "You ran into a dead end; brick wall ahead."},
        {"zh": "你快点来吧。", "en": "Come on over."},
        {"zh": "我不会让你走的。", "en": "I won't let you go."},
        {"zh": "你注定要死。", "en": "You're destined to die."},
        {"zh": "我闻到你腿上的旧伤在流血。", "en": "I smell the old wound on your leg bleeding."},
        {"zh": "我不累，也不会停下来喘。", "en": "I do not tire, and I do not stop to breathe."},
        {"zh": "拖着一只脚，我从街角转出来。", "en": "Dragging one foot, I come around the corner."},
        {"zh": "它盯着你的小腿", "en": "It stares at your calf."},
        {"zh": "那一口会留一辈子", "en": "That bite will last a lifetime."},
        {"zh": "它等你弯腰捡东西", "en": "It waits for you to bend down."},
        {"zh": "它绕到你受伤那侧", "en": "It circles to your wounded side."},
        {"zh": "腐指掐住你袖口", "en": "Rotting fingers pinch your sleeve."},
        {"zh": "它的咬合力很惊人", "en": "Its bite force is startling."},
        {"zh": "它不急，也不会累", "en": "It isn't hurried; it never tires."},
        {"zh": "它闻到了你在流血", "en": "It smells your bleeding."},
        {"zh": "它贴地爬了过来", "en": "It crawls low across the ground."},
        {"zh": "你的腿会先撑不住", "en": "Your leg will give first."}
      ]
    },
