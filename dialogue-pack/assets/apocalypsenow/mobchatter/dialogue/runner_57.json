{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "拖着腐肉的腿慢慢行走", "en": "Dragging rotting fleshed legs"},
        {"zh": "在腐肉上拖行", "en": "Dragging over the flesh"},
        {"zh": "腐烂的手臂摆动前行", "en": "Rotting arms swinging"},
        {"zh": "步伐沉重，满身疮痍", "en": "Heavy steps, full of wounds"},
        {"zh": "步履蹒跚地穿过腐土", "en": "Shuffling through the rotten soil"},
        {"zh": "缓慢挪动那腐烂的身躯", "en": "Moving slowly with rotting body"},
        {"zh": "在腐肉与骨头间缓慢前行", "en": "Creeping between flesh and bones"},
        {"zh": "用残缺的肢体行走", "en": "Walking with missing limbs"},
        {"zh": "腐烂的脚拖在地上", "en": "Rotting feet dragging"},
        {"zh": "拖着满是伤口的身子前行", "en": "Dragging forward with wounds"},
        {"zh": "它小跑着，关节咔咔响", "en": "It half-runs, its joints clicking."},
        {"zh": "破鞋在地上拖出声音", "en": "A torn shoe scrapes along the ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的皮肤上空闲", "en": "Rotting skin idling"},
        {"zh": "腐烂的手臂垂下不动", "en": "Rotting arms hanging down"},
        {"zh": "腐烂的腿在原地空闲", "en": "Rotting legs idle in place"},
        {"zh": "腐烂的手轻轻摇晃", "en": "Rotting hand gently swinging"},
        {"zh": "腐烂的皮肤上空无一物", "en": "Rotting skin with nothing on it"},
        {"zh": "腐烂的手臂空闲着", "en": "Rotting arms idle"},
        {"zh": "腐烂的身躯空闲着", "en": "Rotting body idling"},
        {"zh": "腐烂的脚停在原地", "en": "Rotting feet stationary"},
        {"zh": "它歪着头，嘴里淌着口水", "en": "It tilts its head, drooling."},
        {"zh": "它靠墙站着，膝盖发抖", "en": "It leans on a wall, knees shaking."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "盯着你，意图咬人", "en": "Staring at you, intent to bite"},
        {"zh": "注意到你，露出獠牙", "en": "Noticing you, showing fangs"},
        {"zh": "向你投来贪婪的目光", "en": "Greedy look towards you"},
        {"zh": "紧盯着你，试图接近", "en": "Fixing you with a gaze"},
        {"zh": "獠牙露出来，口水先滴了。", "en": "My fangs bare, and saliva drips first."},
        {"zh": "你一动就盯着你", "en": "Staring at you with every move"},
        {"zh": "盯着你，希望能咬到你", "en": "Staring at you, hoping to bite you"},
        {"zh": "死死盯着你，想要攻击", "en": "Deadly staring, wanting to attack"},
        {"zh": "盯紧你，准备扑上", "en": "Pinning you down, ready to attack"},
        {"zh": "盯着你，流露出渴望", "en": "Staring at you, with desire"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "被拖进尸堆，我还在挣。", "en": "Dragged into the pile — I'm still fighting."},
        {"zh": "小腿折了，我爬也要追上。", "en": "My shin's snapped; I'll crawl after you."},
        {"zh": "别打头，我还想再爬起来！", "en": "Not the head; I still want to get up again!"},
        {"zh": "我嘶哑地吼，声音都破了。", "en": "I rasp a scream; my voice has torn."},
        {"zh": "还没追上你，先别打我。", "en": "I haven't caught you. Stop hitting me."},
        {"zh": "腿断了，我就用爬的。", "en": "Leg's broken, so I crawl."},
        {"zh": "腿又断了，谁来扶我一把！", "en": "My leg's broken again. Someone help me up!"},
        {"zh": "别打头，我还能站起来。", "en": "Not the head — I can still get up."},
        {"zh": "腿断了，爬也要咬你", "en": "My leg is broken; I will crawl and still bite you."},
        {"zh": "它吐出一口黑血", "en": "It spits out a mouthful of black blood."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到了食物的味道！", "en": "I smell food!"},
        {"zh": "快来吧，我要吃了你！", "en": "Come here, I'll eat you!"},
        {"zh": "肉的味道真好！", "en": "The meat tastes good!"},
        {"zh": "我的肚子好饿！", "en": "I'm so hungry!"},
        {"zh": "你跑啊，我膝盖反着也能追！", "en": "Run! My knees bend backwards and I'll still catch you."},
        {"zh": "快来帮我找食物！", "en": "Come help me find food!"},
        {"zh": "我的牙齿真锋利！", "en": "My teeth are sharp!"},
        {"zh": "你身上的肉真多！", "en": "You have so much meat!"},
        {"zh": "你的肉还在跳，我闻到了！", "en": "Your flesh is still twitching; I smell it!"},
        {"zh": "这是我最喜欢的食物！", "en": "This is my favorite food!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "别挡，我要冲过去。", "en": "Don't block me — I'm charging through."},
        {"zh": "撞到你真痛！", "en": "Colliding with you hurts!"},
        {"zh": "我一头撞上你，牙先到！", "en": "I ram you headfirst, teeth first!"},
        {"zh": "你怎么那么硬！", "en": "Why are you so hard?"},
        {"zh": "我撞飞了你！", "en": "I knocked you away!"},
        {"zh": "你动都没动！", "en": "You didn't move!"},
        {"zh": "让开，前面还有活人。", "en": "Move; there are living people ahead."},
        {"zh": "我撞倒了你！", "en": "I knocked you down!"},
        {"zh": "你真不好撞！", "en": "You're hard to hit!"},
        {"zh": "我撞翻了你！", "en": "I knocked you over!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这么多同类里，我只跟着你。", "en": "So many of us, and I follow only you."},
        {"zh": "两只奔尸一起跑，追得更快。", "en": "Two runners side by side move faster."},
        {"zh": "来吧，让我陪陪你！", "en": "Come, let me be with you!"},
        {"zh": "你身上还有温度，配我正好。", "en": "You still have warmth; you'll do."},
        {"zh": "我追不动了，歇会儿。", "en": "Too tired to chase. Resting."},
        {"zh": "我在这条街上等活人等久了。", "en": "I've waited a long time on this street for the living."},
        {"zh": "活人的腿比我快。", "en": "A living human runs faster than me."},
        {"zh": "你还有一口气，我闻得到。", "en": "You still have a breath in you; I can smell it."},
        {"zh": "和我交配吧，亲爱的！", "en": "Mate with me, dear!"},
        {"zh": "我们一起战斗！", "en": "Let's fight together!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿难耐，我寻找食物", "en": "Starving, I seek food"},
