        {"zh": "与障碍物碰撞，我受伤了！", "en": "Collided with an obstacle, injured!"},
        {"zh": "碰撞后，我疼痛难忍！", "en": "Collision, pain unbearable!"},
        {"zh": "肉体碰撞，我的骨头作响！", "en": "Impact, bones creak!"},
        {"zh": "撞击地面，我感到剧痛！", "en": "Impact, pain sharp!"},
        {"zh": "碰撞后，我疼痛难忍，喘息不止！", "en": "Collision, gasping in pain!"},
        {"zh": "撞击后，我的尸体会颤抖！", "en": "Impact, body trembles!"},
        {"zh": "与障碍物碰撞，我痛苦不已！", "en": "Collision, agony unbearable!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
