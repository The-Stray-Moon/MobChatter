{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "拖着腐烂的身体前进", "en": "拖着 rotting body forward"},
        {"zh": "蹒跚着靠近你", "en": "staggering closer to you"},
        {"zh": "腐烂的手指抓向你", "en": "rotten fingers reaching for you"},
        {"zh": "缓慢挪动步子", "en": "slowly shuffling"},
        {"zh": "腐烂的皮肤剥落", "en": "rotting skin peeling off"},
        {"zh": "摇摇晃晃地行走在黑暗中", "en": "shuffling in the darkness"},
        {"zh": "啃咬着地上的腐肉", "en": "chomping on rotting flesh"},
        {"zh": "发出令人不安的声响", "en": "emitting unsettling sounds"},
        {"zh": "努力将自己从地上拉起", "en": "struggling to rise from the ground"},
        {"zh": "我腿上的伤，跑起来更疼。", "en": "This leg wound hurts worse when I run."},
        {"zh": "踉跄两步，猛地窜出", "en": "Two stumbles, then a sudden sprint"},
        {"zh": "脚踝扭着也要跑", "en": "Ankle twisted, and still running"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "凝视着远处", "en": "staring off into the distance"},
        {"zh": "眼神空洞", "en": "blank stare"},
        {"zh": "机械地重复动作", "en": "mechanical movements"},
        {"zh": "偶尔抽搐一下", "en": "occasional twitch"},
        {"zh": "盯着你许久", "en": "staring at you for a long time"},
        {"zh": "发出低沉的嘶嘶声", "en": "releasing a low hiss"},
        {"zh": "缓缓环顾四周", "en": "slowly scanning the area"},
        {"zh": "仿佛在思考", "en": "seems to be thinking"},
        {"zh": "无意识地舔舐自己的伤口", "en": "licking its own wounds unconsciously"},
        {"zh": "机械地摇摆身体", "en": "mechanically swaying"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我翻白的眼睛，一直对着你的。", "en": "My blank eyes stay locked on yours."},
        {"zh": "紧盯着你的身影", "en": "fixing its gaze on you"},
        {"zh": "你手一动，我的头就跟着偏。", "en": "Your hand moves; my head tilts after it."},
        {"zh": "我的眼睛，就剩一只还看得清。", "en": "Only one of my eyes still sees clearly."},
        {"zh": "朝你方向转动头颅", "en": "turning its head towards you"},
        {"zh": "目光充满欲望", "en": "desirous gaze"},
        {"zh": "凝视着你的轮廓", "en": "staring at your silhouette"},
        {"zh": "试图找到你的位置", "en": "trying to locate you"},
        {"zh": "你屏住气，我还是转过头来。", "en": "You hold your breath, but I still turn my head."},
        {"zh": "专注地观察你", "en": "intently observing you"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "断腿了！", "en": "Leg broken!"},
        {"zh": "腿断了！", "en": "Broken leg!"},
        {"zh": "咬伤真疼！", "en": "That bite hurts!"},
        {"zh": "腿断了，快逃！", "en": "Leg gone, run!"},
        {"zh": "疼得要命！", "en": "Incredible pain!"},
        {"zh": "腿断了，走不了！", "en": "Leg gone, can't move!"},
        {"zh": "被咬得好疼！", "en": "That bite really hurts!"},
        {"zh": "跑得太快，摔得更疼。", "en": "Running fast makes the pain worse."},
        {"zh": "腿断了，跑不动！", "en": "Can't run, leg gone!"},
        {"zh": "膝盖折了，我只能用手往前爬。", "en": "My knee gives out; I pull myself forward on my hands."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿难耐，盯上附近的活人！", "en": "Starving, eyeing nearby humans!"},
        {"zh": "看见食物，我欲念难耐！", "en": "Spotting food, my hunger burns!"},
        {"zh": "靠近我，你会付出代价！", "en": "Draw near, and you'll pay!"},
        {"zh": "它们是我的食物，必须消灭！", "en": "They're mine, must be eradicated!"},
        {"zh": "饥饿驱使我猎杀更多！", "en": "Hunger drives me to hunt more!"},
        {"zh": "活人肉，是生存必需品！", "en": "Human flesh, essential for survival!"},
        {"zh": "只有血肉才能填饱我饥肠！", "en": "Only flesh can sate my hunger!"},
        {"zh": "猎物的味道，我无法抗拒！", "en": "Victim's scent, I can't resist!"},
        {"zh": "饥饿之下的我，无所畏惧！", "en": "Hunger makes me fearless!"},
        {"zh": "活人，我的下一个目标！", "en": "Human, my next target!"}
      ]
    },
    "collide": {
