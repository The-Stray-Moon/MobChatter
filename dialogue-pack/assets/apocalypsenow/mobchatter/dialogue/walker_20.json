{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "蹒跚前行，啃骨声响起。", "en": "Shuffle, bones crunch underfoot."},
        {"zh": "阴冷目光盯着你。", "en": "Cold, hollow gaze on you."},
        {"zh": "脚步沉重，肉腐烂。", "en": "Heavy foot, flesh decays."},
        {"zh": "啃食骨骼，发出低吼。", "en": "Chomp bones, growl low."},
        {"zh": "腐臭气息扑鼻而来。", "en": "Putrid breath fills the air."},
        {"zh": "缓慢移动，腐肉滴落。", "en": "Move slow, flesh drips off."},
        {"zh": "饥饿驱使我前进。", "en": "Hunger drives me forward."},
        {"zh": "腐烂躯体挣扎前行。", "en": "Decaying body shuffles."},
        {"zh": "寻找腐肉，不择手段。", "en": "Seek rot, take any way."},
        {"zh": "腐烂皮肉随步摇曳。", "en": "Decaying flesh sways with steps."},
        {"zh": "脚踝歪着，还在往前。", "en": "My ankle is bent and I still move forward."},
        {"zh": "指甲刮过砖墙，一路白痕。", "en": "Nails scrape the brick, leaving pale lines."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "空洞目光盯着远方。", "en": "Empty gaze fixed in distance."},
        {"zh": "我身上的破布被风吹得鼓起来。", "en": "The wind balloons the rags hanging off me."},
        {"zh": "啃咬空气中的腐肉。", "en": "Chomp at air, flesh decayed."},
        {"zh": "腐肉下垂，空洞无神。", "en": "Flesh hangs, gaze empty."},
        {"zh": "腐烂的手指触碰地面。", "en": "Rotting fingers touch ground."},
        {"zh": "风一吹，我身上这层皮就晃。", "en": "One gust and this layer of skin sways."},
        {"zh": "空洞目光中闪过贪婪。", "en": "Greed in empty gaze passes."},
        {"zh": "腐烂的肢体不自主地摆动。", "en": "Rotting limbs twitch, move."},
        {"zh": "等待着下一个目标。", "en": "Waiting for next target."},
        {"zh": "腐烂的指尖触碰灰尘。", "en": "Fingertips touch dust, decayed."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "盯上你，腐肉垂下。", "en": "Gaze fixed, flesh hangs down."},
        {"zh": "目光锁定，腐肉晃动。", "en": "Gaze locked, flesh swings."},
        {"zh": "盯着你，腐肉颤抖。", "en": "Fixed gaze, flesh trembles."},
        {"zh": "盯紧你，腐肉松垂。", "en": "Gaze tightens, flesh droops."},
        {"zh": "向你望去，腐肉下垂。", "en": "Glance at you, flesh hangs."},
        {"zh": "凝视你，腐肉颤动。", "en": "Stare at you, flesh quivers."},
        {"zh": "盯住你，腐肉晃动。", "en": "Gaze at you, flesh swings."},
        {"zh": "盯着你，腐肉下垂。", "en": "Fixed gaze, flesh hangs."},
        {"zh": "目光锁定，腐肉松垂。", "en": "Gaze tightens, flesh droops."},
        {"zh": "盯紧你，腐肉颤动。", "en": "Gaze fixed, flesh quivers."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我捂着裂开的肋侧，血从指缝流。", "en": "I clutch my split ribs as blood leaks through my fingers."},
        {"zh": "骨头碎了，走路都疼！", "en": "Broken bones, every step hurts!"},
        {"zh": "腐烂肉体，无法愈合！", "en": "Decaying flesh, can't heal!"},
        {"zh": "饥饿如焚，无法停止！", "en": "Starving, can't stop!"},
        {"zh": "腐肉之躯，无力反抗！", "en": "Decaying flesh, can't resist!"},
        {"zh": "痛苦无尽，行尸般活着！", "en": "Endless pain, undead life!"},
        {"zh": "无法疗伤，只能苟活！", "en": "Incurable, just survive!"},
        {"zh": "伤痕累累，无法治愈！", "en": "Wounds never heal!"},
        {"zh": "腐朽之身，伤痕累累！", "en": "Decaying body, scars everywhere!"},
        {"zh": "被砍断一半，仍往前挪。", "en": "Half cut through, and I still shuffle on."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉的诱惑让我无法抗拒。", "en": "腐肉's allure is too much to resist."},
        {"zh": "饥饿驱使我寻找新的猎物。", "en": "Hunger drives me to find new prey."},
        {"zh": "这里的食物很香。", "en": "The food here smells good."},
        {"zh": "我必须吃点东西。", "en": "I need to eat something."},
        {"zh": "这具尸体看起来很好。", "en": "This corpse looks good."},
        {"zh": "我的肚子在叫。", "en": "My stomach is growling."},
        {"zh": "你把肉举高，我的脖子拼命伸长。", "en": "You lift the meat, and my neck strains upward."},
        {"zh": "腐烂的味道诱惑着我。", "en": "The smell of decay lures me."},
        {"zh": "这尸体适合啃食。", "en": "This corpse is perfect to gnaw on."},
        {"zh": "我在这里找到了美味。", "en": "I found a tasty morsel here."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞上了一个东西。", "en": "I collided with something."},
        {"zh": "有东西撞到了我。", "en": "Something hit me."},
        {"zh": "我撞上了其他玩家。", "en": "I collided with a player."},
        {"zh": "我撞到了一个陷阱。", "en": "I hit a trap."},
        {"zh": "我撞到了另一行尸。", "en": "I collided with another walker."},
        {"zh": "我撞上了石头。", "en": "I hit a stone."},
        {"zh": "我撞上了铁砧。", "en": "I hit an anvil."},
        {"zh": "我撞上了树。", "en": "I hit a tree."},
        {"zh": "我撞上了熔炉。", "en": "I hit a furnace."},
        {"zh": "我撞上了箱子。", "en": "I hit a chest."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "一具女尸在废墟里回我低吼。", "en": "A she-corpse in the rubble answers my growl."},
        {"zh": "尸群里，也想找个伴。", "en": "Even in a horde, I want company."},
        {"zh": "我看到了我的伴侣。", "en": "I saw my mate."},
        {"zh": "我要和它繁殖。", "en": "I need to breed with it."},
        {"zh": "尸群里也有个伴。", "en": "Even a horde has a partner."},
        {"zh": "我要找到我的配偶。", "en": "I need to find my spouse."},
        {"zh": "两个行尸，一起晃过废墟。", "en": "Two walkers sway past the ruins."},
        {"zh": "我要和它交配。", "en": "I need to mate with it."},
        {"zh": "我准备交配。", "en": "I'm ready to mate."},
        {"zh": "我对着空巷低吼，没有回应。", "en": "I growl into the empty alley; nothing answers."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "指尖碰到块生锈的铁皮。", "en": "My fingertip finds rusty sheet metal."},
        {"zh": "抓紧我，会更疼！", "en": "Hold me tighter, it hurts more!"},
        {"zh": "我抓起地上的罐头，抱进怀里。", "en": "I snatch a can from the ground and hug it."},
        {"zh": "捡起一块腐肉，慢慢嚼。", "en": "I pick up a scrap of rotten meat and chew."},
        {"zh": "别走，我还没吃完上顿。", "en": "Do not go — I have not finished the last one."},
        {"zh": "别走，我还未享用！", "en": "Don't run, I'm not done yet!"},
        {"zh": "这里！来吃吧！", "en": "Here! Eat up!"},
        {"zh": "被咬的滋味如何？", "en": "How does being bitten feel?"},
        {"zh": "腐烂的气息，如此诱人！", "en": "The stench, so enticing!"},
        {"zh": "我会慢慢享用你！", "en": "I'll savor you slowly!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "转过墙角，我闻到了活人的汗。", "en": "Around the corner, I smell living sweat."},
        {"zh": "猎物，我会抓住你！", "en": "Prey, I'll catch you!"},
        {"zh": "目标锁定，即将撕碎！", "en": "Target locked, tearing apart!"},
        {"zh": "我的触手会缠住你！", "en": "My tentacles will hold you!"},
        {"zh": "你呼吸越快，我越近。", "en": "The faster you breathe, the closer I get."},
        {"zh": "我的爪子会抓住你！", "en": "My claws will grasp you!"},
        {"zh": "目标已锁定，准备吞噬！", "en": "Target locked, ready to devour!"},
        {"zh": "你的痛苦即将开始！", "en": "Your pain is about to begin!"},
        {"zh": "我要尝尝你的味道！", "en": "I'll taste your flavor!"},
        {"zh": "猎物落入我手！", "en": "Prey in my hands!"},
        {"zh": "你身上有股温热的味。", "en": "You carry a warm smell."},
        {"zh": "脚步声一停，我就知道。", "en": "When your steps stop, I know."},
        {"zh": "这具身体是第二十号。", "en": "This body is number twenty."},
        {"zh": "你躲在门后，门在抖。", "en": "You hide behind the door. The door shakes."},
        {"zh": "血腥味从你袖口出来。", "en": "Blood smell comes from your sleeve."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "这一口要咬穿护甲。", "en": "This bite goes through armor."},
        {"zh": "我会让你后悔！", "en": "You'll regret this!"},
        {"zh": "我张开五指，皮从骨头上滑下来。", "en": "I spread my fingers, skin sliding off the bone."},
        {"zh": "我一步一步逼近，脚骨咔咔响。", "en": "I close in step by step, ankle bones clicking."},
        {"zh": "这副身子慢，可它不会停。", "en": "This body is slow, but it never stops."},
        {"zh": "我要享受你！", "en": "I'll enjoy you!"},
        {"zh": "我的指甲都磨秃了。", "en": "My nails are worn to stubs."},
        {"zh": "你会为这一刻后悔！", "en": "You'll regret this moment!"},
        {"zh": "我是你的死亡！", "en": "I am your death!"},
        {"zh": "感受我的触碰！", "en": "Feel my touch!"},
        {"zh": "被咬的伤口不会好。", "en": "A bite wound never heals."},
        {"zh": "慢慢走，你也会累。", "en": "I walk slowly. You will tire first."},
        {"zh": "断腿也拦不住我。", "en": "A broken leg does not stop me."},
        {"zh": "你砍断我的手，我还在走。", "en": "Cut off my arm and I keep walking."},
        {"zh": "我不喊，只喘气。", "en": "I don't shout. I only wheeze."},
        {"zh": "尸变之后，就不疼了。", "en": "After the turn, there is no pain."},
        {"zh": "过几天，你走路也这样。", "en": "In a few days you will walk like this too."},
        {"zh": "这片废墟够我们走很久。", "en": "These ruins give us a long walk."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，要你的命！", "en": "Sssss, your life for this!"},
        {"zh": "我张开的下巴合不上了。", "en": "My jaw hangs open and will not close."},
        {"zh": "痛，痛，痛！", "en": "Pain, pain, pain!"},
        {"zh": "喉咙干了，只有咬才能解。", "en": "My throat is dry; only biting helps."},
        {"zh": "腿断了，呜呜！", "en": "Leg broken, woe is me!"},
        {"zh": "抓紧我，流血！", "en": "Hem hem, hold on tight!"},
        {"zh": "我扑上去，牙咬进你的肩膀。", "en": "I lunge, sinking my teeth into your shoulder."},
        {"zh": "我按住你的胸口，低头就咬。", "en": "I pin your chest and bite down."},
        {"zh": "我的下巴咬得太猛，脱臼了。", "en": "I bit too hard and my jaw's out of joint."},
        {"zh": "我一把抱住你，牙齿找你的脖子。", "en": "I grab you and hunt for your neck with my teeth."},
        {"zh": "牙齿咬进你的前臂。", "en": "My teeth sink into your forearm."},
        {"zh": "抓一把，扯下袖子。", "en": "One grab rips off your sleeve."},
        {"zh": "这一口，会留疤。", "en": "This bite will leave a mark."},
        {"zh": "我压上来，很沉。", "en": "I lean on you. I am heavy."},
        {"zh": "咬到骨头才松口。", "en": "I let go only at the bone."},
        {"zh": "血腥味更浓了。", "en": "The smell of blood grows stronger."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "腐化的大地，我的家！", "en": "Corrupted earth, my home!"},
        {"zh": "我从尸堆底下撑起一只手。", "en": "I push one hand out from under the pile of corpses."},
        {"zh": "天一黑，我就从土里爬起来。", "en": "When night falls, I rise from the soil."},
        {"zh": "腐朽之地，我的命运！", "en": "Decay, my destiny!"},
        {"zh": "腐烂，我的归宿！", "en": "Rot, my home!"},
        {"zh": "我从不害怕！", "en": "Fear me not!"},
        {"zh": "末日是我的舞台！", "en": "Apocalypse, my stage!"},
        {"zh": "在这，我永生！", "en": "Eternal here!"},
        {"zh": "腐朽的肉，我的养分！", "en": "Decayed flesh, my sustenance!"},
        {"zh": "死亡，我的伴侣！", "en": "Death, my companion!"},
        {"zh": "从翻倒的公交底下爬出。", "en": "I crawl out from under an overturned bus."},
        {"zh": "这具身体已经走了很远。", "en": "This body has walked a long way."},
        {"zh": "街上又多了一个摇晃的影子。", "en": "One more swaying shape on the street."},
        {"zh": "我从尸堆里撑起来。", "en": "I push myself up out of the pile."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰灼烧，痛苦难忍！", "en": "Burned by fire, agony!"}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "跌落深渊，痛不欲生！", "en": "Fell into abyss, pain!"}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌满我的胸腔，我往下沉。", "en": "Water fills my chest, and I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸冲击，碎片飞溅！", "en": "Explosion, shrapnel everywhere!"}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭矢贯穿，伤口如割！", "en": "Arrow pierced, wounds deep!"}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法撕裂，血流不止！", "en": "Magical tear, bleeding!"}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得太久，我的腿已经撑不住。", "en": "Hunger has gone on too long; my legs give way."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷电劈体，疼痛难忍！", "en": "Lightning strike, agony!"}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "坠入虚空，无尽痛苦！", "en": "Void, endless suffering!"}
      ]
    }
  }
}
