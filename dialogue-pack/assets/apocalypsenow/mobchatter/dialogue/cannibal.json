{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "骨嶙嶙，步蹒跚。", "en": "Bones jingle, stumble along."},
        {"zh": "腐肉裹瘦骨，蹒跚行。", "en": "Ribs wrapped in flesh, shuffle on."},
        {"zh": "骷髅行，风中摇。", "en": "Skull walks, swaying in the breeze."},
        {"zh": "枯骨踏地声，步步惊。", "en": "Grinding bones underfoot, step by step."},
        {"zh": "骸骨碎，尘土扬。", "en": "Bones shatter, dust rises."},
        {"zh": "干枯的肉，摇摇晃。", "en": "Dry flesh sways on bones."},
        {"zh": "骷髅摇摆行，似枯叶。", "en": "Skull swaying, like dry leaves."},
        {"zh": "骸骨轻，步履摇。", "en": "Bones light, steps shaky."},
        {"zh": "腐肉皮，飘风中。", "en": "Flesh flaps in the wind."},
        {"zh": "枯骨行，风中啸。", "en": "Bones walk, howling in the wind"},
        {"zh": "裸足踩碎枯枝，声响渐近。", "en": "Bare feet snap twigs, coming closer."},
        {"zh": "沿着血迹，一步一步跟。", "en": "Step by step, following the blood trail."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉披，骨露森。", "en": "Flesh hangs, bones show."},
        {"zh": "腐肉尸，静无声。", "en": "Corpse still, no sound."},
        {"zh": "腐肉披，眼空洞。", "en": "Flesh hangs, eyes empty."},
        {"zh": "骨嶙峋，尸寂默。", "en": "Bones jingle, corpse silent."},
        {"zh": "腐肉干，骨嶙峋。", "en": "Flesh dried, bones jingle."},
        {"zh": "骨嶙峋，腐肉枯。", "en": "Bones jingle, flesh withers."},
        {"zh": "腐肉皮，风吹干。", "en": "Flesh skin, dried by the wind."},
        {"zh": "腐肉尸，骨相森。", "en": "Corpse with flesh, bones stark."},
        {"zh": "干枯尸，骸骨显。", "en": "Dry corpse, bones show."},
        {"zh": "腐肉皮，风中颤。", "en": "Flesh skin, flutters in the wind"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "窥眼洞，骨中藏。", "en": "Gaze through empty eye sockets."},
        {"zh": "窥眼洞，空洞眼。", "en": "Gaze through hollow eyes."},
        {"zh": "骨中藏，眼洞窥。", "en": "Bones hide, eyes peer out."},
        {"zh": "骷髅眼，空洞洞。", "en": "Skull eyes, hollow and empty."},
        {"zh": "眼空洞，骨中藏。", "en": "Eyes empty, bones hide."},
        {"zh": "眼洞中，骨中藏。", "en": "Eyes hollow, bones hidden."},
        {"zh": "窥眼洞，骨相森。", "en": "Gaze through hollow eyes, bones stark."},
        {"zh": "骨中藏，眼洞显。", "en": "Bones hide, eyes peer out."},
        {"zh": "血糊住半张脸，还盯着你。", "en": "Blood masks half its face; it still stares."},
        {"zh": "它舔了舔牙，认出你是活人。", "en": "It licks its teeth and knows you're alive."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的骨头快散架了！", "en": "My bones are breaking!"},
        {"zh": "别吃我，我会跑！", "en": "Don't eat me, I'll run!"},
        {"zh": "快跑，它们要来了！", "en": "Run! They're coming!"},
        {"zh": "血从咬痕里渗出来，我笑了。", "en": "Blood seeps from the bite mark, and I grin."},
        {"zh": "好痛啊！", "en": "That hurts!"},
        {"zh": "我嘴角的血，不是我的。", "en": "The blood on my mouth is not mine."},
        {"zh": "别咬我！", "en": "Don't bite me!"},
        {"zh": "放我一马！", "en": "Go easy on me!"},
        {"zh": "血从嘴角淌下来，还没完。", "en": "Blood runs from my mouth. I am not done."},
        {"zh": "我闻到自己流血了。", "en": "I can smell my own blood."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有我渴望的味道。", "en": "You have the taste I crave."},
        {"zh": "来吧，享受这野味。", "en": "Come, savor this wild treat."},
        {"zh": "你为何还不成为我的晚餐？", "en": "Why aren't you my meal yet?"},
        {"zh": "猎物的味道总是如此诱人。", "en": "The scent of prey is always alluring."},
        {"zh": "不要走，留下来陪我。", "en": "Don't go, stay with me."},
        {"zh": "你身上有我的同类气息。", "en": "You smell like my kin."},
        {"zh": "你的血肉如此鲜美。", "en": "Your flesh is so succulent."},
        {"zh": "来，让我尝尝你的味道。", "en": "Come, let me taste you."},
        {"zh": "你为何如此抗拒？", "en": "Why resist?"},
        {"zh": "你的肉将是我新的力量。", "en": "Your flesh will be my new strength."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "不要挡住我的路。", "en": "Move out of my way."},
        {"zh": "你的存在让我厌烦。", "en": "Your presence irritates me."},
        {"zh": "让开，我要找我的猎物。", "en": "Move, I seek my prey."},
        {"zh": "不要打扰我。", "en": "Leave me alone."},
        {"zh": "你撞上我，我的刀留在原地。", "en": "You bump me; my knife stays where it was."},
        {"zh": "滚开，这里是我的领地。", "en": "Get out, this is my territory."},
        {"zh": "我们肩膀相撞，你退了一步。", "en": "Our shoulders collide and you take a step back."},
        {"zh": "离开，否则你会后悔。", "en": "Get away, or you'll regret it."},
        {"zh": "别让我看见你。", "en": "Don't let me see you."},
        {"zh": "让开，不然我不会饶你。", "en": "Move, or you won't survive."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "来，让我们的灵魂结合。", "en": "Come, let our souls merge."},
        {"zh": "你的伴侣只能是我。", "en": "Your mate can only be me."},
        {"zh": "你属于我和我的族群。", "en": "You belong to me and my kin."},
        {"zh": "与我交配，让我们更强。", "en": "Mate with me, let us grow stronger."},
        {"zh": "只有我能给予你力量。", "en": "Only I can give you strength."},
        {"zh": "咬一口，你就再也好不了。", "en": "One bite and you never heal."},
        {"zh": "你注定是我的伴侣。", "en": "You are destined to be my mate."},
        {"zh": "让我们一起进化。", "en": "Let's evolve together."},
        {"zh": "与我交配，共享我的力量。", "en": "Mate with me, share my power."},
        {"zh": "你是唯一配得上我的人。", "en": "You are the only one worthy of me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "苍白的皮肤发出冷光", "en": "Pale skin glows cold"},
        {"zh": "腐烂的牙齿咬住地面", "en": "Decaying teeth bite the ground"},
        {"zh": "干瘪的手指摸索着食物", "en": "Withered fingers search for food"},
        {"zh": "嘶哑的声音发出低吼", "en": "Hoarse voice rumbles low"},
        {"zh": "阴暗的嗓音叫嚣着猎物", "en": "Dark voice taunts the prey"},
        {"zh": "饥饿的目光盯着你", "en": "Starved eyes fix on you"},
        {"zh": "腐臭的气息扑面而来", "en": "Putrid breath hits you"},
        {"zh": "骨节突出的手抓住你", "en": "Bony hands grab you"},
        {"zh": "嘶嘶声中牙齿磨擦着", "en": "Sibilant teeth scrape together"},
        {"zh": "破败的袍子遮不住饥饿", "en": "Ragged robes can't hide hunger"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你被锁定为下一个目标", "en": "You are locked as the next target"},
        {"zh": "你的气味被闻到了", "en": "Your scent was detected"},
        {"zh": "你进入了我的视野", "en": "You are in my sights"},
        {"zh": "我舔了舔牙缝里的旧血。", "en": "I lick old blood from between my teeth."},
        {"zh": "你无法逃脱我的注意", "en": "You can't escape my notice"},
        {"zh": "你将是我的下一个牺牲品", "en": "You will be my next sacrifice"},
        {"zh": "你的生命即将终结", "en": "Your life will end soon"},
        {"zh": "我将享用你的肉", "en": "I will feast on your flesh"},
        {"zh": "你的血将滋养我", "en": "Your blood will nourish me"},
        {"zh": "你将被送入永恒的黑夜", "en": "You will be sent to eternal night"},
        {"zh": "你不该在这片废墟过夜。", "en": "You shouldn't sleep in these ruins."},
        {"zh": "活人的味道，跑不掉。", "en": "The living smell always gives you away."},
        {"zh": "你身上还有热气，别浪费。", "en": "You are still warm, so wasteful."},
        {"zh": "骨堆那边，我等着你。", "en": "I'll wait by the bone pile."},
        {"zh": "这一带只剩我和你。", "en": "Only you and I are left out here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你的疼痛无法减轻", "en": "Your pain can't be eased"},
        {"zh": "痛苦将伴随你", "en": "Pain will accompany you"},
        {"zh": "你的挣扎无济于事", "en": "Your struggles are futile"},
        {"zh": "我将不饶你一命", "en": "I will not spare your life"},
        {"zh": "你将陷入无尽的痛苦", "en": "You will be tormented endlessly"},
        {"zh": "你将感受我的力量", "en": "You will feel my power"},
        {"zh": "你的灵魂将归我所有", "en": "Your soul will be mine"},
        {"zh": "我将享受你的死亡", "en": "I will enjoy your death"},
        {"zh": "你的死亡将唤醒我", "en": "Your death will awaken me"},
        {"zh": "我将从你身上吸取力量", "en": "I will draw strength from you"},
        {"zh": "你流一点血，我就知道。", "en": "One drop of blood and I'll know."},
        {"zh": "腿先断，你就跑不动了。", "en": "Break the leg and you stop running."},
        {"zh": "别想着包扎，来不及。", "en": "Don't bother bandaging. No time."},
        {"zh": "我的牙磨得很利。", "en": "I keep my teeth sharp."},
        {"zh": "你闻着像同类的肉。", "en": "You smell like kin meat."},
        {"zh": "把门关好，我会爬窗。", "en": "Bar the door; I use windows."},
        {"zh": "咬一口，伤口就发黑。", "en": "One bite and the wound darkens."},
        {"zh": "你会变成我们中的一个。", "en": "You'll turn into one of us."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "撕裂你的皮肉！", "en": "Tear your flesh!"},
        {"zh": "咬下去，你也会开始流血。", "en": "One bite, and you start bleeding too."},
        {"zh": "吃掉你的血肉！", "en": "Eat your flesh!"},
        {"zh": "你的血会流到地上。", "en": "Your blood will end up on the ground."},
        {"zh": "让我的爪子沾满鲜血！", "en": "Let my claws be stained with blood!"},
        {"zh": "别跑，我饿得牙都发痒。", "en": "Don't run; hunger makes my teeth itch."},
        {"zh": "你的骨骼也会成为我的食物！", "en": "Your bones will be my meal too!"},
        {"zh": "我扑上去，先咬你的肩膀。", "en": "I lunge and bite your shoulder first."},
        {"zh": "你的生命之血流干！", "en": "Your lifeblood runs dry!"},
        {"zh": "让我的利爪撕裂你！", "en": "Rip you apart with my claws!"},
        {"zh": "一口咬进你的肩。", "en": "A bite sinks into your shoulder."},
        {"zh": "指甲抠进你的眼窝。", "en": "Nails dig at your eye socket."},
        {"zh": "咬完，血就止不住。", "en": "The bite won't stop bleeding."},
        {"zh": "我啃你的指节。", "en": "I gnaw your knuckles."},
        {"zh": "牙齿磨着你的骨头。", "en": "Teeth grind against your bone."},
        {"zh": "你倒下前，我先吃一口。", "en": "I eat before you hit the ground."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗中走来新的猎物！", "en": "A new prey approaches in the darkness!"},
        {"zh": "我来了，准备迎接死亡吧！", "en": "I come for you, prepare to die!"},
        {"zh": "废墟里，我数着今天的第一顿饭。", "en": "In the ruins, I count today's first meal."},
        {"zh": "我咬过的人，也会站起来。", "en": "Those I bite will stand up too."},
        {"zh": "黑暗带来了新的牺牲品！", "en": "Darkness brings a new sacrifice!"},
        {"zh": "我将吞噬这片土地！", "en": "I shall devour this land!"},
        {"zh": "这里是我的坟墓，也是你的终点！", "en": "This is my grave, and yours too!"},
        {"zh": "迎接死亡，成为我的食物！", "en": "Embrace death, be my meal!"},
        {"zh": "新的食人族正在觉醒！", "en": "A new cannibal is rising!"},
        {"zh": "黑暗吞噬一切，包括你！", "en": "The darkness devours all, including you!"},
        {"zh": "废墟里，我醒了。", "en": "I woke in the ruins."},
        {"zh": "篝火的烟把我引来。", "en": "Campfire smoke drew me here."},
        {"zh": "这一带的骨头都是我的。", "en": "Every bone here is mine."},
        {"zh": "饥饿从地窖里爬出来。", "en": "Hunger crawls out of the cellar."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "血在流，火还在追我。", "en": "I'm bleeding and the fire still follows."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "跌进火堆里了！", "en": "Fell into a fire!"}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水淹到我了！", "en": "Water is drowning me!"}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸震到了我！", "en": "Exploded on me!"}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭尾还在抖，我拔出来咬断。", "en": "The arrow shaft still quivers; I pull it out and bite it apart."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光打在我身上，皮肉焦了一块。", "en": "Light strikes me and a patch of flesh chars."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得站不稳了！", "en": "Starving to death!"}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷电烧焦了我的头发。", "en": "Lightning scorches my hair."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我的刀也跟着掉。", "en": "The ground vanishes and my knife falls too."}
      ]
    }
  }
}
