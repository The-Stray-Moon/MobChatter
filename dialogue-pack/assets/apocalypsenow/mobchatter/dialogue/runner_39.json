        {"zh": "别逼我攻击。", "en": "Don't逼 me to attack."},
        {"zh": "滚，否则我会流血。", "en": "Move or I'll bleed."},
        {"zh": "你挡了我的路，我不会饶你。", "en": "You're in my way, I won't spare you."},
        {"zh": "走开，不然我会杀了你。", "en": "Move or I'll kill you."}
      ]
    },
