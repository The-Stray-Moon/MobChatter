    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "蹒跚前行，发出咯吱声", "en": "Shuffle forward, creaking bones"},
        {"zh": "拖着断腿行走", "en": "Drag its broken leg"},
        {"zh": "嘶嘶地向前移动", "en": "Sibilantly move forward"},
        {"zh": "蹒跚地穿过泥泞", "en": "Struggle through mud"},
