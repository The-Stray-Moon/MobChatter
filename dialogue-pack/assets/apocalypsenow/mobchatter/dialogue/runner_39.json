    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腿断了，动不了了。", "en": "Leg broken, can't move."},
        {"zh": "好痛，快治治我。", "en": "So painful, help me."},
        {"zh": "流血了，流血了！", "en": "Bleeding, bleeding."},
        {"zh": "咬伤真疼，快帮我。", "en": "Bitten, it hurts."},
        {"zh": "伤口裂开，好疼。", "en": "Wound tearing, so painful."},
        {"zh": "全身无力，快点。", "en": "Weak, hurry."},
        {"zh": "疼痛难忍，救命。", "en": "Painful, help."},
        {"zh": "血流到脚踝，我还在跑。", "en": "Blood to my ankles, and I'm still running."},
        {"zh": "我的腿折了，爬不快。", "en": "My leg snapped; I cannot crawl far."},
        {"zh": "太疼了，快救救我。", "en": "Too painful, help me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉诱惑着你，走近点。", "en": "腐肉 lures you closer."},
        {"zh": "你闻到了我的味道？", "en": "You smell my flesh?"},
        {"zh": "你的血液里也有饥饿。", "en": "Your blood craves hunger too."},
        {"zh": "吃点这，让你更强壮。", "en": "Eat this and you'll be stronger."},
        {"zh": "别停下，我还没玩够。", "en": "Keep going, I'm not done yet."},
        {"zh": "我的腿很快，你追不上我。", "en": "My legs are quick, you can't catch me."},
        {"zh": "尝尝我的速度。", "en": "Feel my speed."},
        {"zh": "你不想尝尝我的血吗？", "en": "Want to taste my blood?"},
        {"zh": "来吧，让我们一起腐化。", "en": "Come, let's corrupt together."},
        {"zh": "你的运气不好，今天要死了。", "en": "Bad luck today, you're dead now."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
