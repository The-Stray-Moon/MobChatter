      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把我烧得更焦。", "en": "The strike burned me even blacker."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "坠入虚无，完了！", "en": "Fall into void, over!"}
      ]
