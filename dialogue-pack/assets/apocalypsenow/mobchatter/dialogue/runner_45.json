{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "拖着双腿前行。", "en": "拖着 legs to move."},
        {"zh": "干枯皮肤刮擦地面。", "en": "Dry skin scrapes the ground."},
        {"zh": "发出干瘪衣服的声音。", "en": "Dry clothes creak."},
        {"zh": "脚步声逐渐接近。", "en": "Footsteps approach."},
        {"zh": "张嘴发出嘶嘶声。", "en": "Sibilant breaths through mouth."},
        {"zh": "啃食腐肉的声音。", "en": "Chewing on rotting flesh."},
        {"zh": "蹒跚着前进。", "en": "Shambles forward."},
        {"zh": "寻找可食用的尸体。", "en": "Hunts for edible corpses."},
        {"zh": "咬向地面的肉块。", "en": "Bites at ground meat."},
        {"zh": "在腐肉上啃咬。", "en": "Bites on the corpse."},
        {"zh": "膝盖反着弯，还在走。", "en": "Knees bent backwards, still walking."},
        {"zh": "喉咙里挤出半声呜咽。", "en": "Half a moan squeezes from its throat."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪着头，看你眼皮会不会眨。", "en": "I tilt my head, watching whether your eyelids move."},
        {"zh": "舔干瘪的嘴唇。", "en": "Licks dry lips."},
        {"zh": "盯着远处的猎物。", "en": "Stares at distant prey."},
        {"zh": "盯着空中的影子。", "en": "Stares at airborne shadows."},
        {"zh": "舔食地上的血迹。", "en": "Licks up bloodstains."},
        {"zh": "舔食腐烂的骨头。", "en": "Licks at rotten bones."},
        {"zh": "舔食散落的肉块。", "en": "Licks up dropped meat."},
        {"zh": "盯着远处的气味。", "en": "Stares at distant smells."},
        {"zh": "盯着手中的腐肉。", "en": "Stares at hand-held flesh."},
        {"zh": "舔食手中的腐肉。", "en": "Licks hand-held flesh."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "注视着玩家的身影。", "en": "Focuses on player’s silhouette."},
        {"zh": "注意玩家的动静。", "en": "Takes notice of player’s movements."},
        {"zh": "盯上玩家的位置。", "en": "Locks on to player’s location."},
        {"zh": "你的轮廓在雾里，我盯住了。", "en": "Your outline shows in the fog, and I fix on it."},
        {"zh": "盯上玩家的动作。", "en": "Locks on to player’s actions."},
        {"zh": "注视着玩家的脚步。", "en": "Focuses on player’s footsteps."},
        {"zh": "盯上玩家的呼吸。", "en": "Locks on to player’s breath."},
        {"zh": "注视着玩家的动静。", "en": "Focuses on player’s movements."},
        {"zh": "盯着玩家的身影移动。", "en": "Stares at player’s silhouette move."},
        {"zh": "注视着玩家的行走。", "en": "Focuses on player’s walk."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "断腿了，动不了了！", "en": "Lost a leg, can't move!"},
        {"zh": "流血不止！", "en": "Won't stop bleeding!"},
        {"zh": "牙印已经发黑了，来不及了。", "en": "The bite mark is already blackening. Too late."},
        {"zh": "好饿，找食物！", "en": "Starving, find food!"},
        {"zh": "跌倒了，起不来！", "en": "Fell, can't get up!"},
        {"zh": "被雷击了，快死！", "en": "Lightning hit, dying!"},
        {"zh": "饥饿难耐！", "en": "Hunger, hunger!"},
        {"zh": "快找到食物！", "en": "Find food!"},
        {"zh": "到处乱窜！", "en": "Hopping around!"},
        {"zh": "肩膀被打穿了，还在往前。", "en": "Its shoulder is punched through. It keeps going."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "饥渴难耐，逼近你", "en": "Hunger gnaws, closing in on you."},
        {"zh": "腐肉的味道诱惑我", "en": "Flesh's scent calls to me."},
        {"zh": "就在这儿，流血吧", "en": "Here, bleed out."},
        {"zh": "丧尸的盛宴即将开始", "en": "The feast of the zombies begins."},
        {"zh": "你血液的味道，令人陶醉", "en": "Your blood's taste is intoxicating."},
        {"zh": "靠近我，感受痛苦", "en": "Come closer, feel the pain."},
        {"zh": "饥饿让我变得疯狂", "en": "Hunger drives me mad."},
        {"zh": "你是我的猎物", "en": "You're my prey."},
        {"zh": "吞噬你，化为一缕烟", "en": "Devour you, become smoke."},
        {"zh": "丧尸永远不会厌倦", "en": "Zombies never tire of it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的骨头即将粉碎", "en": "Your bones crumble."},
        {"zh": "撞击让我更接近终点", "en": "Impact fuels my end."},
        {"zh": "碰一碰，你将消散", "en": "Touch, and you'll fade."},
        {"zh": "我的身体由痛苦构成", "en": "My body is pain."},
        {"zh": "你的碰撞无用", "en": "Your collisions are futile."},
        {"zh": "碰撞不能阻止我", "en": "Collisions cannot stop me."},
        {"zh": "每一次碰撞都让我更近", "en": "Each collision brings me closer."},
        {"zh": "你的碰撞只会加速我的脚步", "en": "Your collisions only hasten my steps."},
        {"zh": "与我相撞，你会后悔", "en": "Collide with me, and you'll regret it."},
        {"zh": "我的力量来自于碰撞", "en": "My power comes from collisions."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同类，一起走向终结", "en": "Fellow, towards the end."},
        {"zh": "与我结合，化为一尸", "en": "Join me, become one."},
        {"zh": "同类，共享这片土地", "en": "Fellow, share this land."},
        {"zh": "与我交配，感受痛苦", "en": "Mate with me, feel pain."},
        {"zh": "同类，共同前往终结", "en": "Fellow, to the end together."},
        {"zh": "你的痛苦将是我伴侣", "en": "Your pain will be my companion."},
        {"zh": "同类，共享这腐朽", "en": "Fellow, share this decay."},
        {"zh": "与我交配，化为一尸", "en": "Mate with me, become one."},
        {"zh": "同类，一起走向毁灭", "en": "Fellow, towards destruction."},
        {"zh": "同类，共享这腐化", "en": "Fellow, share this corruption."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，肉块", "en": "Sssss, flesh chunk"},
        {"zh": "骨头咔嚓", "en": "Crunchy bones"},
        {"zh": "滴答滴答，血液", "en": "Drip, drip, blood"},
        {"zh": "伤口嘶嘶", "en": "Ssssh, wound"},
        {"zh": "吸血开始", "en": "Vampiric bite"},
        {"zh": "撕裂伤痕", "en": "Tearing wounds"},
        {"zh": "流血不止", "en": "Oozing blood"},
        {"zh": "碎玻璃扎进掌心，我照样抓。", "en": "Glass bites my palm, and I grab it anyway."},
        {"zh": "断腿呻吟", "en": "Legs breaking"},
        {"zh": "手指抠着肉块，往嘴里送。", "en": "Fingers claw at the meat and push it into its mouth."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "注意目标", "en": "Target acquired"},
        {"zh": "你翻窗的动静，我听见了。", "en": "I heard you climb through the window."},
        {"zh": "寻找人类", "en": "Seeking humans"},
        {"zh": "靠近猎物", "en": "Approach prey"},
        {"zh": "追踪气味", "en": "Tracking scent"},
        {"zh": "锁定气息", "en": "Scent detected"},
        {"zh": "肉块味道", "en": "Flesh smell"},
        {"zh": "饥饿难耐", "en": "Hunger pangs"},
        {"zh": "靠近食物", "en": "Closer to food"},
        {"zh": "目标附近", "en": "Target nearby"},
        {"zh": "转过头，脖子响了一声。", "en": "It turns its head; the neck cracks."},
        {"zh": "看见你了，腿开始加速。", "en": "It sees you. The legs speed up."},
        {"zh": "隔着两棵树，气味对上了。", "en": "Two trees away, the scent matches."},
        {"zh": "喉咙里的声音变尖了。", "en": "The sound in its throat sharpens."},
        {"zh": "目标是你，只跑不绕。", "en": "The target is you. It runs straight."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "吸食血液", "en": "Drinking blood"},
        {"zh": "咬碎骨头", "en": "Crushing bones"},
        {"zh": "撕裂皮肤", "en": "Tearing skin"},
        {"zh": "它的伤口也在渗血", "en": "Its own wound is oozing too"},
        {"zh": "痛苦尖叫", "en": "Pained scream"},
        {"zh": "惨叫连连", "en": "Pained wails"},
        {"zh": "痛苦挣扎", "en": "Pained thrashing"},
        {"zh": "惨烈战斗", "en": "Bloody battle"},
        {"zh": "痛不欲生", "en": "Severe agony"},
        {"zh": "撕裂伤口", "en": "Tearing wounds"},
        {"zh": "它张着嘴，唾液拉成丝。", "en": "Mouth open, saliva stringing between its teeth."},
        {"zh": "脚下打滑，还是冲过来。", "en": "It slips, and still comes on."},
        {"zh": "手臂往前伸，指节发白。", "en": "Arms reach out, knuckles pale."},
        {"zh": "它不断加速，喘得像破风箱。", "en": "It keeps speeding up, wheezing like a broken bellows."},
        {"zh": "你退到墙角，它笑了。", "en": "You back into a corner, and it grins."},
        {"zh": "它不用眼睛，用气味找你。", "en": "It does not use eyes. It tracks you by smell."},
        {"zh": "每一步都踩得地面发颤。", "en": "Every step makes the ground shudder."},
        {"zh": "它绕过石头，直奔你来。", "en": "It rounds the boulder and comes straight for you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住你的腰带，往回扯。", "en": "I clamp your belt and haul backward."},
        {"zh": "啃掉它的肉！", "en": "Chomp its flesh!"},
        {"zh": "疼痛，痛苦！", "en": "Pain, suffering!"},
        {"zh": "撕开它的皮肤！", "en": "Tear its skin!"},
        {"zh": "它在流血！", "en": "It's bleeding!"},
        {"zh": "腿断了，求饶！", "en": "Leg broken, beg!"},
        {"zh": "吞噬它的生命力！", "en": "Suck its life!"},
        {"zh": "鲜血，快咬！", "en": "Blood, bite now!"},
        {"zh": "腐烂它的骨头！", "en": "Rot its bones!"},
        {"zh": "它的痛苦，我的快乐！", "en": "Its pain, my joy!"},
        {"zh": "咬住你的手臂，死不松口。", "en": "It bites your arm and will not let go."},
        {"zh": "指甲抠进你的脖子。", "en": "Nails dig into your neck."},
        {"zh": "它把你扑倒，压在身上。", "en": "It tackles you down and pins you."},
        {"zh": "牙齿刮过骨头，发出声响。", "en": "Teeth scrape bone with a rasp."},
        {"zh": "你的伤口开始流血。", "en": "Your wound begins to bleed."},
        {"zh": "它咬下一块，嚼都不嚼。", "en": "It tears off a chunk and does not even chew."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从地下室的门后挤出来。", "en": "I squeeze out from behind the cellar door."},
        {"zh": "腐朽之地，我诞生！", "en": "Born from decay!"},
        {"zh": "饥饿难耐，进食！", "en": "Hunger, feed!"},
        {"zh": "这条街的垃圾桶，都归我翻。", "en": "Every bin on this street is mine to rifle."},
        {"zh": "腐肉是我的食物！", "en": "Rotting flesh is mine!"},
        {"zh": "我蹲在废弃车的阴影里。", "en": "I crouch in the shadow of an abandoned car."},
        {"zh": "腐化的灵魂！", "en": "Corrupted soul!"},
        {"zh": "腐土里爬起来，先找吃的。", "en": "I rise from the rot and look for food first."},
        {"zh": "街角的血迹还没干，我过去。", "en": "The blood at the corner is still wet; I head there."},
        {"zh": "腐烂，重生！", "en": "Decay, rebirth!"},
        {"zh": "废墟里，有人扶着墙站起来。", "en": "In the ruins, someone hauls itself up by a wall."},
        {"zh": "一具尸体抽动了一下。", "en": "A corpse twitches once."},
        {"zh": "它从瓦砾下爬出来，满身灰。", "en": "It crawls out from the rubble, gray with dust."},
        {"zh": "街头多了一个摇晃的影子。", "en": "Another swaying shape joins the street."}
      ]
    },
