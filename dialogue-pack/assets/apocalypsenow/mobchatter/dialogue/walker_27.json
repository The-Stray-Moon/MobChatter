{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "缓慢挪动.", "en": "Move slowly."},
        {"zh": "腐烂的肢体摆动.", "en": "Rotting limbs shuffle."},
        {"zh": "发出嘎吱声.", "en": "Creaks loudly."},
        {"zh": "慢慢逼近.", "en": "Creeps closer."},
        {"zh": "盯着你看.", "en": "Stares at you."},
        {"zh": "摸索着前行.", "en": "Shambles forward."},
        {"zh": "啃咬空气.", "en": "Nibbles at air."},
        {"zh": "缓慢蠕动.", "en": "Slithers slowly."},
        {"zh": "寻找食物.", "en": "Searches for food."},
        {"zh": "嘶嘶作响.", "en": "Hisses softly."},
        {"zh": "第二十七号，拖着腿走", "en": "Variant twenty-seven, dragging a leg."},
        {"zh": "它走得不快，但从不歇", "en": "Not fast, but it never rests."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的皮肤松弛.", "en": "Skin hangs loose."},
        {"zh": "无精打采地站立.", "en": "Languidly stands."},
        {"zh": "凝视远方.", "en": "Stares into distance."},
        {"zh": "目光呆滞.", "en": "Blank gaze."},
        {"zh": "腐烂的躯体颤抖.", "en": "Rotting body shudders."},
        {"zh": "呼吸声微弱.", "en": "Weak breathing."},
        {"zh": "空洞的眼神.", "en": "Void eyes."},
        {"zh": "腐烂的手指扭曲.", "en": "Corpse fingers twist."},
        {"zh": "偶尔抽搐.", "en": "Occasionally twitches."},
        {"zh": "腐朽的面容.", "en": "Rotting visage."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "追踪你的身影.", "en": "Tracks your silhouette."},
        {"zh": "紧盯着你.", "en": "Stares straight at you."},
        {"zh": "露出獠牙.", "en": "Shows fangs."},
        {"zh": "张嘴嘶吼.", "en": "Gapes and snarls."},
        {"zh": "伸长脖子.", "en": "Stretches neck."},
        {"zh": "试图靠近.", "en": "Attempts to approach."},
        {"zh": "目光凶狠.", "en": "Fierce gaze."},
        {"zh": "盯着你看很久.", "en": "Stares at you for a long time."},
        {"zh": "寻找你的气味.", "en": "Tries to scent you."},
        {"zh": "试图抓住你.", "en": "Strains to grab you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头嘎吱作响，我感觉不妙。", "en": "My bones creak. This isn't good."},
        {"zh": "我被咬了，感觉要死了。", "en": "Bitten. I feel like I'm dying."},
        {"zh": "腿断了，动弹不得。", "en": "My leg is broken. I can't move."},
        {"zh": "我走不动了，要死了。", "en": "I can't walk. I'm dying."},
        {"zh": "这疼痛难忍，快帮我。", "en": "This pain is unbearable. Help me."},
        {"zh": "流血不止，快救救我。", "en": "Can't stop bleeding. Help me."},
        {"zh": "我在腐烂，快走开。", "en": "I'm rotting. Stay away."},
        {"zh": "我被你咬了，现在很疼。", "en": "You bit me. It hurts."},
        {"zh": "疼痛难忍，快帮我。", "en": "This hurts. Help me."},
        {"zh": "快帮我，我动不了了。", "en": "Help me, I can't move."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的肉在吸引我...", "en": "Decaying flesh is tempting..."},
        {"zh": "我想尝尝那个...", "en": "I want to taste that..."},
        {"zh": "靠近我，我能让你腐烂...", "en": "Come closer, I can rot you..."},
        {"zh": "我的触手能抓住你...", "en": "My tentacles can grab you..."},
        {"zh": "我要撕碎你...", "en": "I’ll rip you apart..."},
        {"zh": "你味道不错...", "en": "You taste good..."},
        {"zh": "跟我们一起腐烂吧...", "en": "Join us in decay..."},
        {"zh": "腐烂的终点在召唤我...", "en": "The end of decay calls me..."},
        {"zh": "我需要更多的腐肉...", "en": "I need more decayed flesh..."},
        {"zh": "我感觉得到你的恐惧...", "en": "I can feel your fear..."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "碰撞会让我们腐烂得更快...", "en": "Collisions speed up our decay..."},
        {"zh": "小心，我们很快会碰上...", "en": "Watch out, we’re about to collide..."},
        {"zh": "我们的身体会黏在一起...", "en": "Our bodies will stick together..."},
        {"zh": "我撞上你了，腐烂的伙伴...", "en": "I撞上你了, decayed companion..."},
        {"zh": "我们的腐烂会加剧...", "en": "Our decay will intensify..."},
        {"zh": "互相碰撞，腐烂得更快...", "en": "Collide, decay faster..."},
        {"zh": "碰撞会带来更多腐肉...", "en": "Collisions bring more decayed flesh..."},
        {"zh": "腐烂的行尸互相碰撞...", "en": "Decaying walkers collide..."},
        {"zh": "我们彼此之间越来越近...", "en": "We’re getting closer to each other..."},
        {"zh": "腐烂的身体互相接触...", "en": "Decaying bodies touch..."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到一个腐烂的伴侣...", "en": "Find a decaying mate..."},
        {"zh": "我们需要繁殖，腐烂的后代...", "en": "We need to reproduce, decaying offspring..."},
        {"zh": "腐烂的行尸求偶...", "en": "Decaying walkers mate..."},
        {"zh": "互相缠绕，繁殖腐烂...", "en": "Wound each other, breed decay..."},
        {"zh": "我们是腐烂的伙伴...", "en": "We are decayed companions..."},
        {"zh": "腐烂是我们的纽带...", "en": "Decay is our bond..."},
        {"zh": "我们腐烂，我们在一起...", "en": "We decay, we are together..."},
        {"zh": "腐烂的行尸，求偶...", "en": "Decaying walkers, mate..."},
        {"zh": "腐烂的行尸想要繁殖...", "en": "Decaying walkers want to mate..."},
        {"zh": "互相缠绕，腐烂的结合...", "en": "Wound each other, decayed union..."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的肌肉触碰我", "en": "Decaying flesh touches me"},
        {"zh": "快点来帮我", "en": "Help me, quickly"},
        {"zh": "求你别靠近", "en": "Stay away from me"},
        {"zh": "你闻起来像血", "en": "You smell like blood"},
        {"zh": "我的肉眼见腐烂", "en": "My flesh is rotting"},
        {"zh": "救救我，我是第27号", "en": "Save me, I'm Variant 27"},
        {"zh": "我只剩骨头", "en": "I'm nothing but bones"},
        {"zh": "求你帮我", "en": "Help me"},
        {"zh": "我的血很咸", "en": "My blood is salty"},
        {"zh": "我需要你的帮助", "en": "I need your help"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标来了", "en": "Target acquired"},
        {"zh": "我的鼻子早烂了，可还认得血。", "en": "My nose rotted off long ago, but it still knows blood."},
        {"zh": "猎物终于来了", "en": "Prey at last"},
        {"zh": "你离我近了", "en": "You're close"},
        {"zh": "你的血很甜", "en": "Your blood is sweet"},
        {"zh": "你是我食物", "en": "You're my food"},
        {"zh": "我要吃你", "en": "I'll eat you"},
        {"zh": "我要杀了你", "en": "I'll kill you"},
        {"zh": "全群系都有我，你躲不开", "en": "I spawn in every biome; you cannot hide."},
        {"zh": "咬一口，你就治不好了", "en": "One bite, and you never heal."},
        {"zh": "我闻得到活人的热气", "en": "I can smell the heat of the living."},
        {"zh": "第二十七号的牙，记住它", "en": "Remember the teeth of variant twenty-seven."},
        {"zh": "尸变已经开始，别靠近", "en": "The turning has begun; stay back."},
        {"zh": "走慢点，反正你会等我", "en": "Walk slow; you will wait for me anyway."},
        {"zh": "这片废墟，归我巡了", "en": "These ruins are mine to patrol."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我来咬你", "en": "I'll bite you"},
        {"zh": "我来撕开你", "en": "I'll tear you open"},
        {"zh": "我来吃你的心脏", "en": "I'll eat your heart"},
        {"zh": "我来咬你的腿", "en": "I'll bite your leg"},
        {"zh": "我来撕裂你", "en": "I'll rip you apart"},
        {"zh": "我来吃你的眼睛", "en": "I'll eat your eyes"},
        {"zh": "我来撕开你的喉咙", "en": "I'll tear open your throat"},
        {"zh": "我来咬你的手", "en": "I'll bite your hand"},
        {"zh": "我来撕开你的胃", "en": "I'll tear open your stomach"},
        {"zh": "我来吃你的骨头", "en": "I'll eat your bones"},
        {"zh": "我先咬腿，你就跑不快", "en": "First your leg, then you cannot run."},
        {"zh": "流血会一直流，别指望止住", "en": "The bleeding will not stop; do not hope."},
        {"zh": "疼痛让你手抖，我看得见", "en": "Pain shakes your hands; I can see it."},
        {"zh": "断腿机制，很快轮到你", "en": "The broken-leg mechanic comes for you soon."},
        {"zh": "我一步步挪，你一步步退", "en": "I shuffle forward; you shuffle back."},
        {"zh": "没有解药，只有腐肉", "en": "No cure, only rotten flesh."},
        {"zh": "你身上的伤口在发黑", "en": "The wound on you is turning black."},
        {"zh": "别浪费力气，我会一直走", "en": "Do not waste strength; I keep walking."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "咬到骨头，也不松口。", "en": "Even at the bone, I do not let go."},
        {"zh": "你的血肉，我的盛宴！", "en": "Your flesh, my feast!"},
        {"zh": "我啃着你的肩膀，发出湿响。", "en": "I gnaw your shoulder with a wet sound."},
        {"zh": "快投降，否则我吃了你！", "en": "Surrender or I’ll eat you!"},
        {"zh": "感受死亡的滋味！", "en": "Feel the taste of death!"},
        {"zh": "来吧，尝尝我锋利的牙齿！", "en": "Come on, taste my sharp teeth!"},
        {"zh": "我不会饶恕任何活物！", "en": "I won’t spare any living thing!"},
        {"zh": "腐朽之躯，我的粮食！", "en": "Decaying flesh, my food!"},
        {"zh": "你的骨头，我的晚餐！", "en": "Your bones, my dinner!"},
        {"zh": "吃掉你，让我更强大！", "en": "Eat you, make me stronger!"},
        {"zh": "咬住不放，直到骨头响", "en": "I bite and hold until bones creak."},
        {"zh": "你被咬了，就回不去了", "en": "You were bitten; there is no going back."},
        {"zh": "指甲抠进你的袖口", "en": "My nails dig into your sleeve."},
        {"zh": "牙缝里还留着上一个人的肉", "en": "The last one's meat is still in my teeth."},
        {"zh": "我压上来，重量比你想象的重", "en": "I fall on you heavier than you expect."},
        {"zh": "这一口，够你疼很久", "en": "This bite will hurt you a long time."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "来了，新的猎物！", "en": "Here, new prey!"},
        {"zh": "寻找下一个目标！", "en": "Find the next target!"},
        {"zh": "末世，我的归宿！", "en": "Doomed world, my home!"},
        {"zh": "这里，会很疼！", "en": "Here, it’ll hurt!"},
        {"zh": "第二十七号从沟里翻上来。", "en": "Number twenty-seven climbs out of the ditch."},
        {"zh": "新的生命，新的痛苦！", "en": "New life, new pain!"},
        {"zh": "寻找痛苦，我来了！", "en": "Seeking pain, here I come!"},
        {"zh": "死亡之地，我的乐园！", "en": "Land of death, my paradise!"},
        {"zh": "废墟里，又站起来一个", "en": "Another one stands up in the ruins."},
        {"zh": "尸变名单上，添了第二十七个", "en": "Variant twenty-seven joins the turned."},
        {"zh": "配置没关我，我就来了", "en": "The config left me on, so here I am."},
        {"zh": "世界还没变，我先变了", "en": "The world has not turned; I turned first."},
        {"zh": "草丛里站起来，慢慢抬头", "en": "I rise from the grass and lift my head slowly."},
        {"zh": "你听见的第一声，是我的脚步", "en": "The first thing you hear is my step."}
      ]
    },
