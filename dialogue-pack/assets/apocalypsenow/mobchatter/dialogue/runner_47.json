{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "步履蹒跚向前行", "en": "Shuffle forward slowly"},
        {"zh": "追逐目标不放松", "en": "Chase the target without stopping"},
        {"zh": "步伐沉重如石块", "en": "Step heavy as a stone"},
        {"zh": "饥饿驱使我前行", "en": "Hunger drives me forward"},
        {"zh": "寻找鲜肉来充饥", "en": "Seek fresh flesh to eat"},
        {"zh": "我踩着碎玻璃，一路嘶叫过来。", "en": "Crunching over broken glass, I hiss my way toward you."},
        {"zh": "腐臭气息扑鼻来", "en": "Rotten stench hits your nose"},
        {"zh": "咬伤带来无尽痛", "en": "Bite brings endless pain"},
        {"zh": "断腿拖在身后", "en": "A broken leg drags behind me."},
        {"zh": "血流一路，我不停", "en": "I bleed the whole way and do not stop."},
        {"zh": "关节反着也能走", "en": "My joints bend backwards and still walk."},
        {"zh": "我闻到了活人的汗", "en": "I smell living sweat."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站立不动等机会", "en": "Stand still for a chance"},
        {"zh": "缓慢扭动身躯", "en": "Slowly twist body"},
        {"zh": "眼神空洞望四方", "en": "Empty eyes look around"},
        {"zh": "舔舐伤口血迹斑", "en": "Lick wounds with blood stains"},
        {"zh": "腐烂肢体不自主", "en": "Decaying limbs move involuntarily"},
        {"zh": "腐臭之躯难安逸", "en": "Corroded body cannot rest"},
        {"zh": "腐烂血液不停流", "en": "Corrupted blood flows ceaselessly"},
        {"zh": "腐朽生命难自持", "en": "Decaying life hard to hold"},
        {"zh": "痛苦中苟延残喘", "en": "Survive in pain"},
        {"zh": "我数自己的心跳，没有", "en": "I count my heartbeat. There is none."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉玩家目光锐", "en": "Notice player with sharp gaze"},
        {"zh": "盯紧目标不放松", "en": "Fix on target without letting go"},
        {"zh": "饥饿目光如炬火", "en": "Hunger eyes like flames"},
        {"zh": "追踪猎物不放手", "en": "Pursue prey without letting go"},
        {"zh": "腐尸紧盯着你", "en": "Decaying corpse stares at you"},
        {"zh": "腐肉之光凝视你", "en": "Corpse's flesh light focuses on you"},
        {"zh": "腐臭目光如刀割", "en": "Rotten gaze like a knife"},
        {"zh": "腐尸目光锁定你", "en": "Decaying corpse locks on you"},
        {"zh": "我认出你身上的热", "en": "I recognize the heat on you."},
        {"zh": "你走路的声音太响了", "en": "Your footsteps are far too loud."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "伤口流出黑血。", "en": "Black blood seeps from the wound."},
        {"zh": "骨头嘎吱作响。", "en": "Bones creak."},
        {"zh": "肌肉开始腐烂。", "en": "Muscle starts to rot."},
        {"zh": "行动变得迟缓。", "en": "Movement slows."},
        {"zh": "疼痛难忍。", "en": "Intense pain."},
        {"zh": "视线逐渐模糊。", "en": "Vision blurs."},
        {"zh": "腿骨断裂。", "en": "Leg bones break."},
        {"zh": "全身无力。", "en": "Weakness overcomes me."},
        {"zh": "步伐开始摇晃。", "en": "Steps stagger."},
        {"zh": "我感到疲惫。", "en": "I feel tired."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的肌肉诱惑着你靠近", "en": "Rotting flesh lures you closer"},
        {"zh": "我需要你的血液来恢复", "en": "I need your blood to heal"},
        {"zh": "你闻到了我的气息了吗？", "en": "Did you smell me?"},
        {"zh": "你将成为我同类的一员", "en": "You'll join my kind"},
        {"zh": "品尝我的力量，感受痛苦", "en": "Taste my strength, feel the pain"},
        {"zh": "饥饿让我变得更强", "en": "Hunger makes me stronger"},
        {"zh": "你无法逃脱我的魔爪", "en": "You can't escape my grasp"},
        {"zh": "我的牙齿渴望你的鲜血", "en": "My teeth crave your blood"},
        {"zh": "与我一起，你会变得更强", "en": "With me, you'll be stronger"},
        {"zh": "我是不死者的试金石", "en": "I'm a test of the undead"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡住了我的路", "en": "You're in my way"},
        {"zh": "碰撞让我们更近", "en": "Collisions bring us closer"},
        {"zh": "你阻止了我的前进", "en": "You stopped my advance"},
        {"zh": "我们不可避免地相遇", "en": "Our paths inevitably cross"},
        {"zh": "我们只能互相伤害", "en": "We can only harm each other"},
        {"zh": "你阻止了我的行动", "en": "You obstruct my movement"},
        {"zh": "你阻止了我们的融合", "en": "You prevent our fusion"},
        {"zh": "我们只能相撞而过", "en": "We can only collide and pass"},
        {"zh": "阻止我前进的人将受罚", "en": "Those who block my path are punished"},
        {"zh": "你阻碍了我的命运", "en": "You obstruct my destiny"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "跟我走，废墟里有个能睡的地方。", "en": "Follow me. There's a place to sleep in the ruins."},
        {"zh": "我们共同繁衍后代", "en": "We'll reproduce together"},
        {"zh": "你是我的完美伴侣", "en": "You're my perfect mate"},
        {"zh": "和我生下不死之子", "en": "Bear me an undead offspring"},
        {"zh": "你将成为我的配偶", "en": "You'll be my mate"},
        {"zh": "你是唯一能理解我存在的人", "en": "You're the only one who understands my existence"},
        {"zh": "与我共筑亡灵家族", "en": "Build the undead family with me"},
        {"zh": "你将成为我的伴侣", "en": "You'll be my companion"},
        {"zh": "你愿意加入我的行列吗？", "en": "Will you join my ranks?"},
        {"zh": "和我一起走向永恒", "en": "Join me in eternity"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "身体湿滑，如同泥潭！", "en": "Body slick as mud."},
        {"zh": "闻着像是腐肉的味道！", "en": "Smells like rotting flesh."},
        {"zh": "触感冰冷，仿佛死亡！", "en": "Ice-cold touch, like death itself."},
        {"zh": "皮肤下流动着暗红色的液体！", "en": "Dark red liquid flows beneath the skin."},
        {"zh": "目光空洞，如同被遗忘！", "en": "Empty eyes, as if forgotten."},
        {"zh": "喉咙发出嘶嘶声，逼近中！", "en": "Sibilant hiss as it closes in."},
        {"zh": "肌肉松弛，步伐沉重！", "en": "Relaxed muscles, heavy步态."},
        {"zh": "咬下一口，腐烂的味道！", "en": "Rotten taste in the bite."},
        {"zh": "流血不止，痛苦呻吟！", "en": "Unstoppable bleeding, painful moans."},
        {"zh": "腐烂的肢体，摇摇欲坠！", "en": "Decaying limbs, hanging by a thread."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "看见猎物，眼中闪烁贪婪！", "en": "Glimmer of greed in its eyes."},
        {"zh": "瞄准目标，脚步更加接近！", "en": "Target sighted, steps closer."},
        {"zh": "腐肉的气息，吸引着它！", "en": "Flesh scent draws it in."},
        {"zh": "饥饿驱使，直奔猎物！", "en": "Hunger drives it to its prey."},
        {"zh": "腐朽的双手，抓紧猎物！", "en": "Rotting hands grasp the prey."},
        {"zh": "饥饿的低吼，威胁着你！", "en": "Rumbling growl, a threat."},
        {"zh": "腐烂的牙齿，即将咬下！", "en": "Rotting teeth, ready to bite."},
        {"zh": "触感冰冷，向你逼近！", "en": "Ice-cold touch, closing in."},
        {"zh": "腐臭的气息，令人窒息！", "en": "Overwhelming stench."},
        {"zh": "腐烂的双手，紧紧抓住你！", "en": "Rotting hands clutch you."},
        {"zh": "活人的味道，在那边", "en": "The smell of the living, over there."},
        {"zh": "腿断了也得追上去", "en": "Broken leg or not, I close in."},
        {"zh": "我把脸转向你的方向", "en": "I turn my face toward you."},
        {"zh": "喉咙里挤出嘶声", "en": "A hiss squeezes out of my throat."},
        {"zh": "第四十七号开始跑了", "en": "Number forty-seven starts to run."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "腿断了也要追着你。", "en": "Broken leg or not, I'm chasing you."},
        {"zh": "目标在视野内，无法逃跑！", "en": "Target within sight, no escape."},
        {"zh": "猎物落入陷阱，痛苦挣扎！", "en": "Prey caught, painful struggles."},
        {"zh": "猎物就在眼前，无法忽视！", "en": "Prey in plain sight, cannot ignore."},
        {"zh": "伤口感染，疼痛难忍！", "en": "Infection, unbearable pain."},
        {"zh": "腐烂的爪子，撕裂猎物！", "en": "Rotting claws tear the prey."},
        {"zh": "伤口流血，痛苦尖叫！", "en": "Blood flows, painful screams."},
        {"zh": "腐烂的皮肤，暴露伤口！", "en": "Decaying skin, revealing wounds."},
        {"zh": "猎物的痛苦，难以置信！", "en": "Prey's agony, unbelievable."},
        {"zh": "腐烂的牙齿，深深咬下！", "en": "Rotting teeth, deep bite."},
        {"zh": "我不绕路，直接撞过来", "en": "No detours; I come straight at you."},
        {"zh": "我的指甲卡进你的袖子", "en": "My nails catch in your sleeve."},
        {"zh": "伤口在冒黑水，我不在乎", "en": "My wound leaks black, and I don't care."},
        {"zh": "你退一步，我就快一步", "en": "You retreat; I gain a step."},
        {"zh": "我盯着你的腿", "en": "I am watching your legs."},
        {"zh": "咬下去你就完了", "en": "One bite and you are finished."},
        {"zh": "尸变的味道从你身上起", "en": "The smell of turning rises from you."},
        {"zh": "我的呼吸贴在你耳边", "en": "My breath is right at your ear."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的尸体向你扑来。", "en": "Decaying corpse lunges at you."},
        {"zh": "腿断了，我更危险。", "en": "Leg broken, I’m more dangerous now."},
        {"zh": "你闻到了我身上的腐臭吗？", "en": "Can you smell the rot on me?"},
        {"zh": "你离我越近，就越危险。", "en": "The closer you are, the more danger you face."},
        {"zh": "被你打倒，我还会抓着你的脚踝。", "en": "Knock me down and I'll still grab your ankle."},
        {"zh": "我的血流得很快。", "en": "My blood flows fast."},
        {"zh": "你无法治愈我的伤口。", "en": "You can’t cure my wounds."},
        {"zh": "断腿让我跑得更快。", "en": "My broken leg makes me faster."},
        {"zh": "我是第47号。", "en": "I’m Variant 47."},
        {"zh": "我渴望你的鲜血。", "en": "Your blood is my desire."},
        {"zh": "我一口咬在你肩上", "en": "I sink my teeth into your shoulder."},
        {"zh": "断骨的茬口戳向你", "en": "The jagged bone of my leg jabs at you."},
        {"zh": "我把你往地上压", "en": "I drag you down to the ground."},
        {"zh": "指甲划开你的皮", "en": "My nails open your skin."},
        {"zh": "我撕下你一块肉", "en": "I tear off a piece of you."},
        {"zh": "血喷在脸上，更饿了", "en": "Blood hits my face and I hunger more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "从阴影中爬出来！", "en": "Crawling from the shadows!"},
        {"zh": "饥饿的奔尸来了。", "en": "Starving runner arrives."},
        {"zh": "一条街跑完，找下一口气。", "en": "One street done — who's next to breathe?"},
        {"zh": "腐烂的生物群落。", "en": "Decaying biomes."},
        {"zh": "夜晚，我的时刻。", "en": "Night is my time."},
        {"zh": "我是死亡的使者。", "en": "I am the harbinger of death."},
        {"zh": "这里，你会找到我。", "en": "Here, you will find me."},
        {"zh": "我从不独自行动。", "en": "I never act alone."},
        {"zh": "腐臭的歌声。", "en": "Stench song."},
        {"zh": "死亡的气息。", "en": "Whiff of death."},
        {"zh": "坟墓的土在动", "en": "The grave dirt is moving."},
        {"zh": "我从尸堆里站起来", "en": "I stand up out of the corpse pile."},
        {"zh": "天黑了，我该出来了", "en": "It is dark; time for me to come out."},
        {"zh": "被咬的人也成了我", "en": "The one who was bitten became me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰烧伤我的皮肤。", "en": "Fire burns my skin."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔在地上！", "en": "I fell on the ground!"}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我不必呼吸，水却灌了进来。", "en": "I don't need breath, yet water pours in."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸震裂我的身体。", "en": "Explosion shakes my body."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭矢刺穿我的肉。", "en": "Arrow pierces my flesh."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法之力侵蚀我的灵魂。", "en": "Magic corrupts my soul."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿夺走了我的力量。", "en": "Hunger strips my strength."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷电击中我的肉体。", "en": "Lightning strikes my body."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空吞噬我的生命。", "en": "Void consumes my life."}
      ]
    }
  }
