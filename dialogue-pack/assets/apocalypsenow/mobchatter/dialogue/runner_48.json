      "operation": "replace",
      "lines": [
        {"zh": "我这张脸，泡水泡烂了。", "en": "This face of mine has soaked to rags."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被爆炸伤到了！", "en": "Explosion hurt me!"}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进肋骨，我照样扑上来。", "en": "An arrow lodges in my ribs; I lunge anyway."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打中我的腿，我还在冲。", "en": "A spell hit my leg; I still charge."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿到只剩骨头，走不动", "en": "Starved to bone, I can't walk"}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "我被雷劈了！", "en": "Lightning hit me!"}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉进虚空了！", "en": "Fell into void!"}
      ]
    }
  }
