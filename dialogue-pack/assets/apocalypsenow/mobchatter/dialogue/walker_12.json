{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "步伐沉重，拖着腐烂的肢体前行。", "en": "Shuffles with decayed limbs."},
        {"zh": "腐肉在脚下发出嘎吱声。", "en": "Decaying flesh creaks underfoot."},
        {"zh": "饥饿的双眼寻找下一个目标。", "en": "Starved eyes scan for a target."},
        {"zh": "腐烂的皮肤在风中沙沙作响。", "en": "Decaying skin rustles in the wind."},
        {"zh": "腐尸蹒跚向前，步履蹒跚。", "en": "Shambles forward, steps unsteady."},
        {"zh": "咬一口腐烂的肉，发出咯吱声。", "en": "Grinds decayed flesh between teeth."},
        {"zh": "腐烂的双手摸索着地面。", "en": "Decaying hands feel the ground."},
        {"zh": "腐烂的肌肉在骨骼上蠕动。", "en": "Decaying flesh crawls over bones."},
        {"zh": "腐尸步履蹒跚，试图接近玩家。", "en": "Shambles towards the player."},
        {"zh": "腐肉在鞋底摩擦发出声响。", "en": "Decaying flesh scrapes against boots."},
        {"zh": "我的下巴垂到胸口。", "en": "My jaw hangs down to my chest."},
        {"zh": "我一步步挪，不赶时间。", "en": "I shuffle on, in no hurry."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "懒洋洋地躺在地面上。", "en": "Lies lazily on the ground."},
        {"zh": "目光呆滞，盯着前方。", "en": "Stares blankly into the distance."},
        {"zh": "腐烂的肢体无力地摆动。", "en": "Decayed limbs weakly twitch."},
        {"zh": "腐尸发出低沉的嘶嘶声。", "en": "Whispers a low, decaying sound."},
        {"zh": "腐肉在微风中摇晃。", "en": "Decaying flesh sways in the breeze."},
        {"zh": "腐烂的皮肤松弛地垂下。", "en": "Decaying skin hangs slack."},
        {"zh": "腐尸发出沙哑的叫声。", "en": "Screams in a hoarse voice."},
        {"zh": "腐烂的头发散落在脸上。", "en": "Decaying hair falls over face."},
        {"zh": "腐尸无声地摇晃。", "en": "Shakes silently."},
        {"zh": "腐烂的手指蜷缩着。", "en": "Decaying fingers curl."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "注视着玩家，寻找可攻击的机会。", "en": "Scans for the player, searching for an attack."},
        {"zh": "盯着玩家，贪婪的目光闪烁。", "en": "Fixes on the player, greedy eyes glinting."},
        {"zh": "目光紧盯着玩家，准备攻击。", "en": "Stares intently at the player, ready to attack."},
        {"zh": "缓缓移动，朝玩家靠近。", "en": "Slowly moves towards the player."},
        {"zh": "目光闪烁，寻找机会撕咬。", "en": "Eyes flicker, searching for a bite opportunity."},
        {"zh": "盯着玩家，腐烂的嘴角露出獠牙。", "en": "Fixes on the player, rotting lips revealing teeth."},
        {"zh": "凝视玩家，腐烂的双手伸向玩家。", "en": "Gazes at the player, decayed hands reaching out."},
        {"zh": "盯住玩家，腐烂的肌肉蠕动。", "en": "Glares at the player, decayed flesh writhing."},
        {"zh": "目光坚定，盯着玩家不放。", "en": "Steadfast gaze on the player."},
        {"zh": "腐烂的眼睛死死盯着玩家。", "en": "Decaying eyes fixate on the player."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的皮肉在滴血。", "en": "Rotten flesh is oozing blood."},
        {"zh": "伤口疼痛难忍。", "en": "The wound is excruciating."},
        {"zh": "我的骨头快断了。", "en": "My bones are breaking."},
        {"zh": "腐烂的肌体会腐朽。", "en": "Rotten flesh decays."},
        {"zh": "腐肉疼痛无比。", "en": "Rotten flesh hurts."},
        {"zh": "我的手臂垂着，只剩皮连着。", "en": "My arm hangs on by nothing but skin."},
        {"zh": "腐烂的组织在坏死。", "en": "Decaying tissue is necrotic."},
        {"zh": "腐肉即将脱落。", "en": "Flesh will fall off."},
        {"zh": "腐烂的皮肉在溃烂。", "en": "Decaying flesh is溃烂."},
        {"zh": "我的膝盖又错开了。", "en": "My knee has slipped out again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你散发的热量吸引了我。", "en": "You're emitting heat, drawing me in."},
        {"zh": "我能闻到你的腐肉。", "en": "I can smell your rotting flesh."},
        {"zh": "靠近我，你会有危险。", "en": "Stay close, and you'll be in danger."},
        {"zh": "我的视线集中在你身上。", "en": "My focus is on you."},
        {"zh": "你是我的下一顿大餐。", "en": "You're my next meal."},
        {"zh": "我不需要同情。", "en": "I don't need sympathy."},
        {"zh": "你不会活着离开这里。", "en": "You won't be leaving here alive."},
        {"zh": "靠近，我会抓住你。", "en": "Come close, and I'll grab you."},
        {"zh": "你身上那点暖，我闻得到。", "en": "I can smell the warmth on you."},
        {"zh": "你背包里的腌肉，味飘过来了。", "en": "The cured meat in your pack drifts over to me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞上了一个障碍。", "en": "I've collided with an obstacle."},
        {"zh": "什么东西挡住了我的路。", "en": "Something's blocking my path."},
        {"zh": "我撞在门框上，肩膀脱了臼。", "en": "I hit the door frame and my shoulder pops out."},
        {"zh": "我撞上了坚硬的东西。", "en": "I've collided with something hard."},
        {"zh": "前方有东西挡住了我。", "en": "There's something in front of me."},
        {"zh": "我撞上了墙壁。", "en": "I've collided with a wall."},
        {"zh": "我撞到了一个箱子。", "en": "I've collided with a chest."},
        {"zh": "我撞上了一堆石块。", "en": "I've collided with a pile of rocks."},
        {"zh": "我撞到了你的尸体。", "en": "I've collided with your corpse."},
        {"zh": "铁齿夹住脚踝，骨头响了。", "en": "A trap bit my ankle; the bone cracked."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个末世里，谁还找伴侣。", "en": "In this wasteland, who still looks for a mate?"},
        {"zh": "找一个同伴。", "en": "Find a partner."},
        {"zh": "废墟里只剩我们两个会动的。", "en": "Only the two of us still move in these ruins."},
        {"zh": "尸变之后，没人陪我。", "en": "Since turning, no one stays with me."},
        {"zh": "你愿意与我一起吗？", "en": "Will you join me?"},
        {"zh": "我寻找我的另一半。", "en": "I'm searching for my other half."},
        {"zh": "我们一起走进那片废墟。", "en": "Let's walk into those ruins together."},
        {"zh": "我们需要一个家庭。", "en": "We need a family."},
        {"zh": "尸群里，谁还记得说话。", "en": "In a horde, who still remembers speech?"},
        {"zh": "我想要一个伴侣。", "en": "I want a partner."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "干枯的手指触碰我！", "en": "Dry fingers touch me!"},
        {"zh": "腐烂的手臂抱紧我！", "en": "Rotten arms hug me!"},
        {"zh": "疼痛从伤口传来！", "en": "Pain from the wound!"},
        {"zh": "咀嚼骨骼的声音...", "en": "Crunching bones..."},
        {"zh": "腐烂的体味弥漫...", "en": "Rotten smell..."},
        {"zh": "寻找下一个猎物...", "en": "Looking for prey..."},
        {"zh": "我捡起腐肉，连土一起塞进嘴。", "en": "I pick up the rotten flesh and shove the dirt in with it."},
        {"zh": "腐烂之吻...", "en": "Rotten kiss..."},
        {"zh": "饥饿的行尸...", "en": "Hungering walker..."},
        {"zh": "你闻起来很好吃...", "en": "You smell delicious..."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标发现...", "en": "Target acquired..."},
        {"zh": "猎物就在眼前...", "en": "Prey in sight..."},
        {"zh": "腐烂的眼睛盯着你...", "en": "Rotting eyes on you..."},
        {"zh": "腐肉的气味引导我...", "en": "Rotten flesh guides me..."},
        {"zh": "你的气息让我兴奋...", "en": "Your scent excites me..."},
        {"zh": "猎物近在咫尺...", "en": "Prey so close..."},
        {"zh": "你逃不掉了...", "en": "You can't escape..."},
        {"zh": "这是你的终点...", "en": "This is your end..."},
        {"zh": "腐烂的希望...", "en": "Rotting hope..."},
        {"zh": "你逃不了的...", "en": "You can't escape..."},
        {"zh": "有人在前面喘气。", "en": "Someone's breathing up ahead."},
        {"zh": "我的肚子一直在叫。", "en": "My stomach won't stop growling."},
        {"zh": "活人的味道穿过墙。", "en": "The smell of the living comes through the wall."},
        {"zh": "我记得你走的方向。", "en": "I remember which way you went."},
        {"zh": "我要摸到你的肩膀。", "en": "I want to get my hand on your shoulder."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "咬断你的喉咙...", "en": "Choke your throat..."},
        {"zh": "撕开你的胸膛...", "en": "Rip open your chest..."},
        {"zh": "尝尝我的牙齿...", "en": "Taste my teeth..."},
        {"zh": "碎骨的声音...", "en": "Breaking bones..."},
        {"zh": "感受我的力量...", "en": "Feel my strength..."},
        {"zh": "你无法逃脱...", "en": "You can't escape..."},
        {"zh": "腐烂的力量...", "en": "Rotting power..."},
        {"zh": "痛苦将伴随你...", "en": "Pain will be with you..."},
        {"zh": "你的命不久矣...", "en": "Your life is short..."},
        {"zh": "等待我的终结...", "en": "Await my end..."},
        {"zh": "我的牙齿一直在打颤。", "en": "My teeth keep chattering."},
        {"zh": "你越跑，我越想吃。", "en": "The more you run, the hungrier I get."},
        {"zh": "我在数你还剩几步。", "en": "I'm counting the steps you have left."},
        {"zh": "我的指头朝你伸着。", "en": "My fingers reach toward you."},
        {"zh": "停下吧，别累着自己。", "en": "Stop running; don't tire yourself."},
        {"zh": "你的血会流到我脚上。", "en": "Your blood will run to my feet."},
        {"zh": "我把你按在地上，别怪。", "en": "Don't blame me if I pin you down."},
        {"zh": "我只需要再近一步。", "en": "I only need one more step."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一爪抓下去，指甲留在肉里。", "en": "I rake down and my nail stays in the flesh."},
        {"zh": "我这一口，专挑关节。", "en": "This bite aims for the joints."},
        {"zh": "别动，会更痛！", "en": "Don't move, it'll hurt more!"},
        {"zh": "我咬住你的袖子，布比肉好咬。", "en": "I bite your sleeve; cloth tears easier than flesh."},
        {"zh": "血顺着我下巴滴到砖缝里。", "en": "Blood runs off my chin into the cracks of the bricks."},
        {"zh": "死在这里吧！", "en": "Die here!"},
        {"zh": "你动不了了！", "en": "You can't move!"},
        {"zh": "咬掉你的脑袋！", "en": "Chew off your head!"},
        {"zh": "求你别咬我！", "en": "Please, don't bite me!"},
        {"zh": "你是我的午餐！", "en": "You're my lunch!"},
        {"zh": "我挠了你一下，指甲断了。", "en": "I rake you, and a nail snaps off."},
        {"zh": "我咬在你盾牌边缘。", "en": "I bite the rim of your shield."},
        {"zh": "我撞你，自己也倒了。", "en": "I ram you and fall over myself."},
        {"zh": "我的手抓住你的腰带。", "en": "My hand catches your belt."},
        {"zh": "我啃你的护腕。", "en": "I gnaw at your bracer."},
        {"zh": "我把你往墙上按。", "en": "I push you against the wall."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这里的食物很香！", "en": "Food smells good here!"},
        {"zh": "尸群在街口聚齐了，走吧。", "en": "The horde's assembled at the corner — move."},
        {"zh": "这个位置适合我！", "en": "This spot is good!"},
        {"zh": "更多活人在这里！", "en": "More living ones here!"},
        {"zh": "这里的腐肉最多！", "en": "Most of the rot here!"},
        {"zh": "这里没人会打扰我！", "en": "No one will bother me here!"},
        {"zh": "这里的食物最适合我！", "en": "Food here suits me best!"},
        {"zh": "这里就是我的新家！", "en": "This is my new home!"},
        {"zh": "更多活人会来！", "en": "More living ones will come!"},
        {"zh": "我要开始吃东西！", "en": "Time to eat!"},
        {"zh": "我从一堆破布下面起来。", "en": "I rise from under a pile of rags."},
        {"zh": "我的手指先抓到了光。", "en": "My fingers catch the light first."},
        {"zh": "废墟里多了我这个动静。", "en": "The ruins gain another noise: me."},
        {"zh": "我从门后慢慢地转出来。", "en": "I turn slowly out from behind a door."}
      ]
    },
