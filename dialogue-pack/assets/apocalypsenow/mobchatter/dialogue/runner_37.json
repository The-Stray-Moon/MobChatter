      "operation": "replace",
      "lines": [
        {"zh": "溺水了，透不过气。", "en": "Drowned, can't breathe."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸震断了我的腿。", "en": "Explosion, leg broken."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭射中了我的腿。", "en": "Arrow hit, leg hurt."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法击中我了。", "en": "Magic hit."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没吃东西，饿死的。", "en": "Starved to death."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击把我半边身子烧黑了。", "en": "The lightning scorched half my body black."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "掉入虚空，完了。", "en": "Fell into void."}
      ]
    }
  }
}
