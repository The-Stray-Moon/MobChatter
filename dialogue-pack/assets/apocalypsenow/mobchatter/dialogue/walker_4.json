      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法伤害了我的灵魂。", "en": "Magic damaged my soul."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿让我的皮肉松弛。", "en": "Starvation slackens my flesh."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击让我腐烂得更快。", "en": "Lightning accelerates my decay."}
      ]
    },
    "hurt.void": {
