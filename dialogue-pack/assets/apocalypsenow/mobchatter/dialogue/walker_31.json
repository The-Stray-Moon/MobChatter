      "operation": "replace",
      "lines": [
        {"zh": "腐烂双手抓向你", "en": "Rotting hands grab at you"},
        {"zh": "腐臭的嘶吼，逼近", "en": "Rotten howl, closing in"},
        {"zh": "腐烂的长牙刺来", "en": "Rotting fangs pierce you"},
        {"zh": "腐朽的指尖撕裂", "en": "Rotting fingertips tear at you"},
        {"zh": "腐烂的气息逼近", "en": "Rotten breath nears"},
        {"zh": "腐尸的爪子来了", "en": "Claws of the corpse approach"},
