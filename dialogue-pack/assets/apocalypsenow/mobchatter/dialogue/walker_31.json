{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "蹒跚前行", "en": "Shuffle forward"},
        {"zh": "我一步一步把左腿拖过来。", "en": "I drag my left leg forward, one step at a time."},
        {"zh": "步履沉重", "en": "Heavy steps"},
        {"zh": "我一步一拖，追着地上的血。", "en": "Step and drag, I follow the blood on the ground."},
        {"zh": "腐烂脚步", "en": "Decaying steps"},
        {"zh": "慢慢靠近", "en": "Approach slowly"},
        {"zh": "我一步一拖，跟着地上的血。", "en": "Step by drag, I follow the blood on the ground."},
        {"zh": "摸索前行", "en": "Stumble forward"},
        {"zh": "缓缓行进", "en": "Move slowly"},
        {"zh": "拖着一条不听使唤的腿走。", "en": "I walk dragging a leg that will not obey."},
        {"zh": "光脚踩过碎玻璃，也不停下。", "en": "Bare feet cross broken glass without stopping."},
        {"zh": "断了一条腿，还在往前。", "en": "One leg broken, still moving on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "目光呆滞", "en": "Stare blankly"},
        {"zh": "四处徘徊", "en": "Roam around"},
        {"zh": "我站着，肩膀一点点塌下去。", "en": "I stand still as my shoulders sag."},
        {"zh": "风把我的衣角吹得猎猎响。", "en": "The wind snaps the rag of my coat."},
        {"zh": "啃咬木头", "en": "Chew wood"},
        {"zh": "舔舐伤口", "en": "Lick wounds"},
        {"zh": "目光紧盯着", "en": "Stare intensely"},
        {"zh": "四处走动", "en": "Walk around"},
        {"zh": "无目的游荡", "en": "Roam aimlessly"},
        {"zh": "靠在断墙上，喉咙发干。", "en": "I lean on a broken wall, throat dry."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的呼吸让我的头偏了一下。", "en": "Your breath makes my head tilt."},
        {"zh": "转向玩家", "en": "Turning to player"},
        {"zh": "我的眼白对着你转过来。", "en": "My clouded eyes turn toward you."},
        {"zh": "一步，再一步，我来了", "en": "One step, another — here I come"},
        {"zh": "我没有眼珠，照样看着你。", "en": "No eyeballs, and I still watch you."},
        {"zh": "我闻着你的味道转弯。", "en": "I turn corners following your scent."},
        {"zh": "寻找目标", "en": "Finding target"},
        {"zh": "我的头一直歪着，看你。", "en": "My head stays tilted, watching you."},
        {"zh": "从门框后面探出半张脸。", "en": "Half my face shows from behind the door frame."},
        {"zh": "头一歪，眼珠先转过来。", "en": "My head tilts, then my eyes turn."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "腐烂的肉在嘶裂。", "en": "Rotten flesh tears."},
        {"zh": "虚弱的身体在颤抖。", "en": "Weak body trembles."},
        {"zh": "饥饿的痛苦在蔓延。", "en": "Hunger's pain spreads."},
        {"zh": "痛苦在吞噬我。", "en": "Pain consumes me."},
        {"zh": "腐烂在侵蚀我。", "en": "Decay eats me."},
        {"zh": "我颤抖着。", "en": "I tremble."},
        {"zh": "痛苦的挣扎。", "en": "Struggle in pain."},
        {"zh": "腐烂的血在流淌。", "en": "Decaying blood flows."},
        {"zh": "肚子空了，咬合都变慢。", "en": "Empty stomach, and my bite has gone slow."},
        {"zh": "我断掉的腿在拖着我。", "en": "My broken leg drags at me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿了，求你给点吃的。", "en": "I’m hungry, please give me something to eat."},
        {"zh": "伤口在动，我就跟着动。", "en": "My wound twitches; so do I."},
        {"zh": "你的血很好喝。", "en": "Your blood tastes good."},
        {"zh": "跟我一起吧，你不会饿。", "en": "Come with me, you won’t be hungry."},
        {"zh": "这味道不错。", "en": "This tastes good."},
        {"zh": "你不知道活着有多苦。", "en": "You don’t know how hard life is."},
        {"zh": "求求你别杀我。", "en": "Please don’t kill me."},
        {"zh": "这片荒地连腐肉都晒干了。", "en": "Even the rotten meat is dried out in this waste."},
        {"zh": "你包里那块面包，别藏了。", "en": "That bread in your bag. Don't hide it."},
        {"zh": "你腿上那道血口，很香。", "en": "That open cut on your leg smells good."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们撞在一起，骨头响了。", "en": "We collided; something cracked."},
        {"zh": "肩膀的骨头被你撞错了位。", "en": "You knocked my shoulder bone out of place."},
        {"zh": "我不喜欢你。", "en": "I don’t like you."},
        {"zh": "这双腿只会往前挪。", "en": "These legs only shuffle forward."},
        {"zh": "让开，尸体不刹车。", "en": "Move it — corpses don't brake."},
        {"zh": "肩头烂穿，骨头露在外面。", "en": "My shoulder rotted through—bone showing."},
        {"zh": "我需要空间。", "en": "I need space."},
        {"zh": "你的肩膀撞散了我脸上的灰。", "en": "Your shoulder knocks the ash off my face."},
        {"zh": "我贴着墙根走过去。", "en": "I edge along the wall past you."},
        {"zh": "肩膀撞上来，骨头咯吱响。", "en": "My shoulder hits; bones creak."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的血已经不太流了。", "en": "My blood barely flows anymore."},
        {"zh": "我们交配吧。", "en": "Let’s mate."},
        {"zh": "和我交配。", "en": "Mate with me."},
        {"zh": "我们需要繁衍。", "en": "We need to reproduce."},
        {"zh": "一起繁衍吧。", "en": "Reproduce together."},
        {"zh": "来吧，交配。", "en": "Come on, mate."},
        {"zh": "我需要你。", "en": "I need you."},
        {"zh": "和我交配，繁衍后代。", "en": "Mate with me, to reproduce."},
        {"zh": "我们需要后代。", "en": "We need offspring."},
        {"zh": "求你帮助我。", "en": "Help me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，腐烂的双手伸向你！", "en": "Sssshhh, rotten hands reaching for you!"},
        {"zh": "饥饿的双眼注视着你...", "en": "Hungry eyes on you..."},
        {"zh": "蛆虫在你伤口中蠕动...", "en": "Worms squirming in your wounds..."},
        {"zh": "腐臭的气息笼罩着你...", "en": "A foul stench surrounds you..."},
        {"zh": "你感受到了我的痛苦...", "en": "You feel my agony..."},
        {"zh": "腐肉的触感...", "en": "Flesh's touch..."},
        {"zh": "你的血肉是我的食物...", "en": "Your flesh is my food..."},
        {"zh": "蛆虫会带你走向终结...", "en": "Worms will bring you to your end..."},
        {"zh": "腐烂的触碰...", "en": "Rotten touch..."},
        {"zh": "你终将化为尘埃...", "en": "You shall be dust..."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到了你的气息...", "en": "I smell your presence..."},
        {"zh": "你已无法逃脱...", "en": "You cannot escape..."},
        {"zh": "你的血肉是我的...", "en": "Your flesh is mine..."},
        {"zh": "你是我新的猎物...", "en": "You are my new prey..."},
        {"zh": "腐化的力量吸引着你...", "en": "Corrupted power draws you..."},
        {"zh": "你的末日降临...", "en": "Your doom is here..."},
        {"zh": "你逃不出我的手掌...", "en": "You cannot escape my grasp..."},
        {"zh": "腐化的阴影笼罩你...", "en": "Corruption's shadow falls on you..."},
        {"zh": "你的命运在我掌握...", "en": "Your fate is in my hands..."},
        {"zh": "你终将成为我的...", "en": "You shall be mine..."},
        {"zh": "活人，一个人，正好。", "en": "A living man, alone, just right."},
        {"zh": "你身上有没结痂的伤口。", "en": "You have a wound that has not scabbed."},
        {"zh": "我听见你喘气的声音。", "en": "I hear you breathing."},
        {"zh": "这边，往这边走。", "en": "This way, come this way."},
        {"zh": "你那点火光在废墟里太亮。", "en": "That little light of yours is too bright here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的触碰将带给你痛苦...", "en": "My touch will bring you pain..."},
        {"zh": "你无法逃避我的攻击...", "en": "You cannot avoid my attack..."},
        {"zh": "你的痛苦即将开始...", "en": "Your pain is about to begin..."},
