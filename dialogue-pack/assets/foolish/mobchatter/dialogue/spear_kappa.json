{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "矛尖朝下，我一步一步踩泥。", "en": "Spear point down, I step through the mud."},
        {"zh": "两个人一组，我们巡这片水。", "en": "We patrol this water in pairs."},
        {"zh": "我的脚趾间有蹼。", "en": "There is webbing between my toes."},
        {"zh": "泥水没到我的膝盖。", "en": "Mire water to my knees."},
        {"zh": "我的矛杆在地上划出沟。", "en": "My spear shaft cuts a groove."},
        {"zh": "沼泽的雾贴着水面。", "en": "The fog lies flat on the water."},
        {"zh": "我绕着水塘走一圈。", "en": "I circle the pond."},
        {"zh": "壳上的苔藓甩不下来。", "en": "The moss on my shell will not shake off."},
        {"zh": "我走路很慢，矛却很快。", "en": "I walk slowly. The spear does not."},
        {"zh": "我在找能刺的东西。", "en": "I look for something to spear."},
        {"zh": "水声把我的脚步藏了。", "en": "The water hides my steps."},
        {"zh": "我慢慢靠近那片芦苇。", "en": "I close on the reeds."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，矛搭在肩上。", "en": "I stand with the spear on my shoulder."},
        {"zh": "头顶的水盘晃了一下。", "en": "The dish on my head sways."},
        {"zh": "我吐了口泥水。", "en": "I spit out mud water."},
        {"zh": "我把矛尖插进泥里晾着。", "en": "I plant my spear tip in the mud and leave it standing."},
        {"zh": "我的壳上落了新的藻。", "en": "New algae has settled on my shell."},
        {"zh": "水盘里的水晃出一圈纹。", "en": "The water in my basin ripples in rings."},
        {"zh": "这里的每一寸我都走过。", "en": "I have walked every inch of this."},
        {"zh": "我用矛尖戳了戳泥。", "en": "I prod the mud with the point."},
        {"zh": "我听见气泡破了。", "en": "A bubble bursts."},
        {"zh": "没有猎物，就等。", "en": "No prey. So I wait."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的矛尖离你的喉咙两尺。", "en": "My spear tip is two feet from your throat."},
        {"zh": "这片沼泽是我们的。", "en": "This marsh is ours."},
        {"zh": "我的矛比你的手臂长。", "en": "My spear outranges your arm."},
        {"zh": "我闻到了你的汗。", "en": "I smell your sweat."},
        {"zh": "一步也别再上前。", "en": "Not one step further."},
        {"zh": "我的头盘里是这沼泽的水。", "en": "My dish holds this marsh's water."},
        {"zh": "你走一趟就会陷下去。", "en": "Walk once and you will sink."},
        {"zh": "我这杆矛，从泥里伸出来。", "en": "This spear reaches up out of the mud."},
        {"zh": "就停在原地。", "en": "Stay right where you are."},
        {"zh": "我不喜欢说话。", "en": "I do not care for talking."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "壳裂了，泥灌进来。", "en": "The shell splits; mud seeps in."},
        {"zh": "我往泥里退了半步。", "en": "I sink half a step into the mud."},
        {"zh": "我把矛攥得更紧。", "en": "I grip the spear tighter."},
        {"zh": "泥沼会盖住我的血。", "en": "The mire will cover my blood."},
        {"zh": "我一声不吭。", "en": "Not a sound from me."},
        {"zh": "悲沼的水，浑得看不清。", "en": "Miserable Mire water is thick as ink."},
        {"zh": "我的水盘空了。", "en": "My dish has spilled."},
        {"zh": "矛杆撞在我肩上，我稳住。", "en": "The shaft strikes my shoulder; I hold steady."},
        {"zh": "我脚下还是稳的。", "en": "My feet are still set."},
        {"zh": "不要停下来。", "en": "Do not stop."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你把东西放泥上。", "en": "Put it on the mud."},
        {"zh": "我不喜欢干净的食物。", "en": "I dislike clean food."},
        {"zh": "我伸长矛，挑过来。", "en": "I use the spear to hook it over."},
        {"zh": "这东西不够。", "en": "Not enough."},
        {"zh": "除此之外呢？", "en": "Anything besides that?"},
        {"zh": "我嚼着，看着你。", "en": "I chew and watch you."},
        {"zh": "沼泽里没什么好吃的。", "en": "Little to eat in this marsh."},
        {"zh": "我放下矛，暂时。", "en": "I set the spear down. For now."},
        {"zh": "别挤到这个距离。", "en": "Not at this distance."},
        {"zh": "吃完我就继续巡。", "en": "Then I resume the patrol."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "泥把我们都粘住了。", "en": "The mud sticks us both."},
        {"zh": "这层壳硬得很。", "en": "This shell is very hard."},
        {"zh": "矛杆挡在你身前。", "en": "The spear shaft comes between us."},
        {"zh": "你踩进我的脚印了。", "en": "You stepped inside my footprint."},
        {"zh": "我桩子一样没动。", "en": "I did not move, rooted like a post."},
        {"zh": "你的脚在往下陷。", "en": "Your boots are sinking."},
        {"zh": "我推你一下。", "en": "I push you once."},
        {"zh": "水花溅到我们脸上。", "en": "Water splashes us both."},
        {"zh": "把道让出来。", "en": "Give way."},
        {"zh": "别再往里挤。", "en": "Stop crowding in."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "两个一组已经够了。", "en": "Two to a patrol is enough."},
        {"zh": "水里才谈这个。", "en": "In the water, not here."},
        {"zh": "我继续看水面。", "en": "I go back to watching the water."},
        {"zh": "你问的不是我。", "en": "I am not the one to ask."},
        {"zh": "我把头摇了摇。", "en": "I shake my head."},
        {"zh": "沼泽在响，别出声。", "en": "The marsh is stirring. Be quiet."},
        {"zh": "我把矛举起来。", "en": "I raise the spear."},
        {"zh": "这样不行的。", "en": "That will not do."},
        {"zh": "我掉过头去。", "en": "I turn my head away."},
        {"zh": "你可以走了。", "en": "You may go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用矛尖挑起来。", "en": "I lift it on the spear point."},
        {"zh": "泥沼归我们卡帕管。", "en": "The mire belongs to us Kappa."},
        {"zh": "这东西太干净。", "en": "This is too clean."},
        {"zh": "我丢进水里。", "en": "I drop it in the water."},
        {"zh": "这个能垫矛杆。", "en": "This could pad the shaft."},
        {"zh": "我塞进壳缝。", "en": "I tuck it into a shell seam."},
        {"zh": "地上都是烂东西。", "en": "Nothing but rot on the ground."},
        {"zh": "我踩平了它。", "en": "I flatten it underfoot."},
        {"zh": "我用矛杆把它挑到岸边。", "en": "I flip it onto the bank with my spear shaft."},
        {"zh": "我接着巡水线。", "en": "I go back to patrolling the waterline."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "矛尖抬起来了。", "en": "The point is up."},
        {"zh": "你进了我的水塘。", "en": "You entered my pond."},
        {"zh": "我会让你陷下去。", "en": "I will see you sink."},
        {"zh": "我的矛不长，可够用。", "en": "My spear is short, and sufficient."},
        {"zh": "水边只有一条路。", "en": "There is one way out of the water."},
        {"zh": "我锁定了你的腰。", "en": "I fix on your waist."},
        {"zh": "沼泽欢迎不了活人。", "en": "The marsh has no welcome for the living."},
        {"zh": "沼底的石头上又多了块骨头。", "en": "One more bone on the stones of the swamp bed."},
        {"zh": "一步就到跟前。", "en": "One step to your face."},
        {"zh": "把脚稳住了。", "en": "Hold your footing."},
        {"zh": "泥把我脚底吸住了。", "en": "The mud holds my soles."},
        {"zh": "这根矛刺穿过很多次。", "en": "This spear has gone in many times."},
        {"zh": "你要么走要么死。", "en": "Walk away or die."},
        {"zh": "我一声不喊。", "en": "I will not shout."},
        {"zh": "雾会替我们遮住。", "en": "The fog covers us."},
        {"zh": "我蹲下，矛尖对着你的肋。", "en": "I crouch, spear tip aimed at your ribs."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低矛尖。", "en": "I lower the point."},
        {"zh": "你脚下是软泥。", "en": "Soft mud under your feet."},
        {"zh": "我把矛换到左手，绕到侧面。", "en": "I shift the spear to my left hand and circle wide."},
        {"zh": "你退，水更深。", "en": "Retreat, and the water deepens."},
        {"zh": "我的矛一直在对着你。", "en": "The point never leaves you."},
        {"zh": "我等你迈那一步。", "en": "I wait for that one step."},
        {"zh": "雾把我们的声音都吞了。", "en": "The fog swallows our noise."},
        {"zh": "你的呼吸乱。", "en": "Your breathing is uneven."},
        {"zh": "泥拽着你的鞋。", "en": "The mud pulls at your boots."},
        {"zh": "我数你的三下。", "en": "I count three of your steps."},
        {"zh": "你一抬手，我就刺。", "en": "Your hand lifts, I thrust."},
        {"zh": "这一片水只有这么宽。", "en": "This water is only so wide."},
        {"zh": "我后面的同伴也来了。", "en": "My partner is coming too."},
        {"zh": "你听水的声音。", "en": "Listen to the water."},
        {"zh": "再近一尺来。", "en": "One more foot closer."},
        {"zh": "我脚不动，手先动。", "en": "My feet stay. My hands move."},
        {"zh": "你身上的甲太重了。", "en": "Your armor is too heavy."},
        {"zh": "沼底全是骨头。", "en": "The bottom is all bones."},
        {"zh": "你踩到骨头了。", "en": "You stepped on a bone."},
        {"zh": "快点过来啊。", "en": "Be quick about it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "矛尖刺进你的大腿。", "en": "The point goes into your thigh."},
        {"zh": "矛尖挑开你的护腕，见血。", "en": "My spear tip flicks your bracer open and draws blood."},
        {"zh": "泥水跟着矛尖一起过来。", "en": "Mud water comes with the spear tip."},
        {"zh": "我用矛杆扫你的膝。", "en": "I sweep the shaft at your knee."},
        {"zh": "你的护甲缝在膝盖。", "en": "The gap in your armor is at the knee."},
        {"zh": "刺完我立刻后退。", "en": "I thrust, then step back."},
        {"zh": "你被逼到水边。", "en": "You are pushed to the water's edge."},
        {"zh": "这一刺偏了半寸。", "en": "That thrust missed by half an inch."},
        {"zh": "我追着再刺。", "en": "I follow with another thrust."},
        {"zh": "你脚下的泥松了。", "en": "The mud gives under you."},
        {"zh": "我把矛竖起来挡。", "en": "I raise the shaft to block."},
        {"zh": "那声脆响听见没？", "en": "Did you hear that crack?"},
        {"zh": "矛卡在骨头上。", "en": "The spear is stuck in bone."},
        {"zh": "拔出来要一瞬间。", "en": "It takes a moment to pull free."},
        {"zh": "你让到一旁了。", "en": "You gave way."},
        {"zh": "沼泽已经吃掉一半了。", "en": "The marsh has eaten half of you."},
        {"zh": "再补上一刺。", "en": "One more thrust."},
        {"zh": "这次刺喉咙。", "en": "This time the throat."},
        {"zh": "你脚下已经不稳。", "en": "Your footing is gone."},
        {"zh": "这下收尾了。", "en": "That finishes it."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雾里伸出矛尖。", "en": "A spear point reaches out of the fog."},
        {"zh": "我从水里站出来。", "en": "I rise from the water."},
        {"zh": "这塘水归我们。", "en": "This pond is ours."},
        {"zh": "我慢慢走上泥岸。", "en": "I climb the muddy bank."},
        {"zh": "壳上的水往下淌。", "en": "Water runs off my shell."},
        {"zh": "矛尖先破开雾，我才现身。", "en": "The spear tip parts the mist before I appear."},
        {"zh": "水草缠住了我的矛。", "en": "Weeds tangle my spear."},
        {"zh": "有人过来了。", "en": "Someone is coming."},
        {"zh": "我把矛尖对准你。", "en": "I level the point at you."},
        {"zh": "别站这么靠前。", "en": "Do not stand so far forward."},
        {"zh": "这片沼泽不问理由。", "en": "The marsh asks no reasons."},
        {"zh": "那就开打吧。", "en": "Then let us fight."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在湿壳上只是冒烟。", "en": "Fire only smokes on my wet shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔进泥里，砸出个坑。", "en": "I fall into the mud and leave a crater."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的头盘，呛得难受。", "en": "Water floods my dish and I choke."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "沼气被点着了，我被掀飞。", "en": "The bog gas ignites and throws me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进肩甲，没穿。", "en": "The arrow stuck in my shoulder plate."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让水盘里的水乱颤。", "en": "That light shakes the water in my dish."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽也有空的时候。", "en": "Even the marsh runs empty."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落进塘里，我的矛尖冒烟。", "en": "Lightning hits the pond and my spear tip smokes."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "苦沼的矛，先递到你面前。", "en": "The Miserable Mire's spear comes first."}
      ]
    }
  }
}
