{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一顿地跑", "en": "I run in short bursts"},
        {"zh": "我用两条腿蹦着走", "en": "I hop along on two legs"},
        {"zh": "我的喙一直向前", "en": "My beak points the way"},
        {"zh": "我踩在热石上又抬脚", "en": "I step on hot stone and lift again"},
        {"zh": "我从熔岩流边走过", "en": "I pass beside a lava flow"},
        {"zh": "我的羽毛粘着灰", "en": "My feathers are caked with ash"},
        {"zh": "我绕着石柱转过去", "en": "I wheel around a basalt pillar"},
        {"zh": "我低头啄了一下地", "en": "I stab my beak at the ground"},
        {"zh": "我跳过一道裂缝", "en": "I hop over a crack"},
        {"zh": "我沿着火口边上走", "en": "I walk along the vent's rim"},
        {"zh": "我又快又急地挪", "en": "I shift fast and jerky"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把羽毛抖松", "en": "I ruffle my feathers"},
        {"zh": "我的眼睛转得很快", "en": "My eyes move fast"},
        {"zh": "我在灰里刨了个坑", "en": "I scratch a hollow in the ash"},
        {"zh": "我一下一下地点头", "en": "I bob my head"},
        {"zh": "我张着嘴喘气", "en": "I pant with my beak open"},
        {"zh": "我在等什么动一下", "en": "I wait for something to move"},
        {"zh": "我蹦了一下又停下", "en": "I hop once and stop"},
        {"zh": "我把喙在石头上磨", "en": "I rub my beak on the stone"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下把脸转向你", "en": "I snap my face to you"},
        {"zh": "我的喙张了张", "en": "My beak opens a little"},
        {"zh": "你站在我的火口边", "en": "You are at my vent"},
        {"zh": "我蹦了一下靠近", "en": "I hop once nearer"},
        {"zh": "你身上有别的味道", "en": "You carry another smell"},
        {"zh": "我抬起翅膀晃了晃", "en": "I lift my wings and shake them"},
        {"zh": "我朝你叫了一声", "en": "I call out at you"},
        {"zh": "我歪着尖嘴，看你会不会动。", "en": "I tilt my sharp beak, watching whether you move."},
        {"zh": "我歪头看了你一会儿", "en": "I study you a moment"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹦开躲了一下", "en": "I hop away from it"},
        {"zh": "我的毛掉了几根", "en": "A few feathers come loose"},
        {"zh": "我疼得叫个不停", "en": "I cry out over and over"},
        {"zh": "我跳了两步远", "en": "I hop two steps off"},
        {"zh": "我歪着头喘气", "en": "I pant with my head tilted"},
        {"zh": "我还能蹦得动", "en": "I can still hop"},
        {"zh": "你可别追过来", "en": "Do not come chasing after me"},
        {"zh": "我一蹦一蹦地退", "en": "I retreat in little hops"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你丢的种子，我啄了一下就吐。", "en": "I peck your seed once and spit it out."},
        {"zh": "我低头啄了一下", "en": "I peck at it once"},
        {"zh": "不对劲，我不吃", "en": "Something is off, I will not"},
        {"zh": "你手里的肉太烫，我先看看。", "en": "The meat in your hand is too hot; I watch it first."},
        {"zh": "这东西烫手吗", "en": "Is that hot to the touch"},
        {"zh": "下界荒地的我，会跳起来啄。", "en": "In the Nether wastes, I leap to peck."},
        {"zh": "我跳到旁边去", "en": "I hop off to the side"},
        {"zh": "这东西看着不对劲", "en": "This thing looks wrong"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞得我打了个转", "en": "You spin me half around"},
        {"zh": "我扑扇着翅稳住", "en": "I flap to steady myself"},
        {"zh": "我的毛被你撞乱了", "en": "You have ruffled my feathers"},
        {"zh": "我赶紧蹦到一边", "en": "I hop quickly aside"},
        {"zh": "你碰我一下，我尖叫着跳开。", "en": "You touch me, and I shriek and spring away."},
        {"zh": "我被你撞得打了个趔趄。", "en": "Your bump sends me staggering."},
        {"zh": "我贴地跑了两步", "en": "I run two steps low"},
        {"zh": "我在灰里停住脚", "en": "I stop myself in the ash"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "火口那边还有几只", "en": "There are more of us by the vent"},
        {"zh": "我叫一声它就应", "en": "I call, and one answers"},
        {"zh": "我们在石柱间追来追去", "en": "We chase about the pillars"},
        {"zh": "它的羽毛比我亮", "en": "Its feathers are brighter"},
        {"zh": "我们一起刨灰找食", "en": "We scratch the ash for food together"},
        {"zh": "这些事不着急", "en": "There is no hurry for that"},
        {"zh": "我们跳来跳去", "en": "We hop back and forth"},
        {"zh": "它往烟里去了", "en": "It went into the smoke"},
        {"zh": "它跳得比我高", "en": "It hops higher than I do"},
        {"zh": "我们朝一个方向蹦", "en": "We hop the same way"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头就啄", "en": "I stab down at once"},
        {"zh": "这东西硬得很", "en": "This is very hard"},
        {"zh": "它从我喙里滑了", "en": "It slips out of my beak"},
        {"zh": "我又啄了一下", "en": "I peck at it again"},
        {"zh": "踢到一边，别挡路。", "en": "Kicked aside — don't block the way."},
        {"zh": "我一点兴趣都没了", "en": "I have lost all interest"},
        {"zh": "我蹦开了两步", "en": "I hop two steps clear"},
        {"zh": "我啄了两下没叼住", "en": "Two pecks and I have not got it"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低身子准备跳", "en": "I crouch to spring"},
        {"zh": "我的喙对准你了", "en": "My beak is aimed at you"},
        {"zh": "这个距离正好", "en": "This distance is just right"},
        {"zh": "我先叫给你听", "en": "Let me shriek for you first"},
        {"zh": "我朝你蹦过去", "en": "I hop toward you"},
        {"zh": "我选好落点了", "en": "I have my landing spot"},
        {"zh": "这一下我要扑", "en": "I mean to pounce"},
        {"zh": "我盯得非常紧", "en": "I am watching very closely"},
        {"zh": "我的爪子前后换着踩", "en": "My feet shift back and forth"},
        {"zh": "我准备一下子过去", "en": "I mean to come all at once"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳一下又停下", "en": "I hop and stop"},
        {"zh": "你往左我就绕", "en": "You go left, I circle"},
        {"zh": "我的头一直在动", "en": "My head keeps moving"},
        {"zh": "你后退我就进", "en": "You back up, I advance"},
        {"zh": "我的爪子抓紧了灰", "en": "My claws grip the ash"},
        {"zh": "我等你转过去", "en": "I wait for you to turn"},
        {"zh": "我又靠近一点", "en": "I come a little closer"},
        {"zh": "你听得见我的爪子吗", "en": "Can you hear my claws"},
        {"zh": "我从侧面过去", "en": "I come from the side"},
        {"zh": "我蹦到你后面去了", "en": "I hopped behind you"},
        {"zh": "我的尾巴一抖一抖", "en": "My tail flicks and flicks"},
        {"zh": "你踩在热石上会跳", "en": "You will jump on this hot rock"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳起来扑你", "en": "I leap and pounce"},
        {"zh": "我的喙啄在你手上", "en": "My beak jabs your hand"},
        {"zh": "我用爪子抓你", "en": "My claws rake you"},
        {"zh": "我落地又跳起来", "en": "I land and spring again"},
        {"zh": "这一口啄偏了", "en": "That peck went wide"},
        {"zh": "我扇着翅打你", "en": "I beat my wings at you"},
        {"zh": "我的爪抓进你的袖子", "en": "My claws catch your sleeve"},
        {"zh": "你被啄得退开", "en": "You back off from the peck"},
        {"zh": "我又扑了一下", "en": "I pounce once more"},
        {"zh": "我落地就往后撤", "en": "I land and pull back"},
        {"zh": "我啄你的膝盖", "en": "I peck at your knee"},
        {"zh": "我从下面往上扑", "en": "I pounce upward from below"},
        {"zh": "我抓了一下就跳走", "en": "I claw once and hop off"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "烟里跳出一只小东西", "en": "Something small hops out of the smoke"},
        {"zh": "我从石堆后面蹦出来", "en": "I hop out from behind the stones"},
        {"zh": "我的叫声先到了", "en": "My shriek arrives first"},
        {"zh": "我落在热石上又跳开", "en": "I land on hot rock and spring off"},
