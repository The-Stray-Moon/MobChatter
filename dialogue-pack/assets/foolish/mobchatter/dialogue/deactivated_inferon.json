{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我停摆着，一步一停。", "en": "I am wound down. One step, one pause."},
        {"zh": "关节锈得很紧", "en": "My joints are rusted tight."},
        {"zh": "脚底蹭过荒原的碎石。", "en": "My feet scrape the wasteland gravel."},
        {"zh": "铁皮磨着地面", "en": "Iron plate grinds on the ground."},
        {"zh": "我歪着往前挪", "en": "I move forward at an angle."},
        {"zh": "我的膝盖不听话", "en": "My knees will not obey."},
        {"zh": "我走了两步就停", "en": "Two steps and I stop."},
        {"zh": "机身里没有响声", "en": "Nothing hums inside me."},
        {"zh": "我的影子瘦长", "en": "My shadow is thin and long."},
        {"zh": "我低着脑袋走", "en": "I walk with my head down."},
        {"zh": "腿上的板松了一半", "en": "Half my leg plating is loose."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在这里", "en": "I am stopped here."},
        {"zh": "什么都没有发生", "en": "Nothing is happening."},
        {"zh": "我的灯不亮", "en": "My lights are out."},
        {"zh": "我在等一个不会来的指令", "en": "I wait for a command that will not come."},
        {"zh": "我的手指僵着", "en": "My fingers are frozen."},
        {"zh": "很安静", "en": "Very quiet."},
        {"zh": "我没有动过", "en": "I have not moved."},
        {"zh": "芯里空空的", "en": "My core is empty."},
        {"zh": "灰尘盖住我的脸", "en": "Dust covers my face."},
        {"zh": "我就这么站着", "en": "I just stand."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在等我动", "en": "You are waiting for me to move."},
        {"zh": "我的头转不过来", "en": "My head will not turn."},
        {"zh": "你看见我锈了吗", "en": "Do you see the rust?"},
        {"zh": "我身上有凹痕", "en": "There is a dent in me."},
        {"zh": "我只是停在这儿", "en": "I am only stopped here."},
        {"zh": "你敲我也不会醒", "en": "Knock and I will not wake."},
        {"zh": "我的外壳值点钱", "en": "My shell is worth something."},
        {"zh": "你手里有锤子", "en": "You have a hammer."},
        {"zh": "别指望我", "en": "Do not count on me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "胸口陷进去一小块。", "en": "A small dent sinks into my chest."},
        {"zh": "合金关节响了一声。", "en": "An alloy joint clicked."},
        {"zh": "铁皮裂开一道", "en": "A crack in the iron."},
        {"zh": "我不出声", "en": "I make no sound."},
        {"zh": "我还在原位", "en": "I am still in place."},
        {"zh": "你敲掉了一块漆", "en": "You knocked off some paint."},
        {"zh": "我的腿歪了一点", "en": "My leg is a bit crooked."},
        {"zh": "我没有反击", "en": "I do not strike back."},
        {"zh": "这一下我感觉得到", "en": "I felt that one."},
        {"zh": "我连疼都反应得慢", "en": "Even my pain is slow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西对我毫无意义", "en": "That means nothing to me."},
        {"zh": "你举着它给谁看", "en": "Who are you showing it to?"},
        {"zh": "我的传感器死了", "en": "My sensors are dead."},
        {"zh": "这东西给不了我什么", "en": "That gives me nothing."},
        {"zh": "我连看都看不到", "en": "I cannot even see it."},
        {"zh": "我什么都不想吃", "en": "I want nothing to eat."},
        {"zh": "它挡着我的视线", "en": "It blocks my view."},
        {"zh": "我听见了，但我不想动。", "en": "I hear you. I simply won't move."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你推我，我歪了一下", "en": "You pushed, I tilted."},
        {"zh": "我站起来又慢", "en": "I straighten slowly."},
        {"zh": "铁壳很沉", "en": "The iron shell is heavy."},
        {"zh": "我撞到墙就停下了", "en": "I hit the wall and stopped."},
        {"zh": "我没有躲", "en": "I did not dodge."},
        {"zh": "你推得动一点", "en": "You can move me a little."},
        {"zh": "我的支撑腿在打滑", "en": "My support leg is slipping."},
        {"zh": "别把灰拍起来", "en": "Do not raise so much dust."},
        {"zh": "我靠着墙站稳", "en": "I steady myself on the wall."},
        {"zh": "我这台机关，停摆了。", "en": "This machine of mine has stopped."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有这个功能", "en": "I do not have that function."},
        {"zh": "这需要能源", "en": "That requires power."},
        {"zh": "没有反应", "en": "No response."},
        {"zh": "我什么都不回", "en": "I answer nothing."},
        {"zh": "停摆的机关不懂告别。", "en": "A stopped machine does not know farewells."},
        {"zh": "我的关节锈死了", "en": "My joints are rusted shut."},
        {"zh": "这具机身已经停了", "en": "This chassis has stopped."},
        {"zh": "这里只有灰", "en": "Only dust here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "手指僵着打不开", "en": "My fingers will not open."},
        {"zh": "东西掉在我脚边也没用", "en": "Things at my feet are useless to me."},
        {"zh": "我没有动力", "en": "I have no power."},
        {"zh": "它就一直躺在那儿", "en": "It just lies there."},
        {"zh": "我的手是死的", "en": "My hands are dead."},
        {"zh": "你拿走就好", "en": "You may take it."},
        {"zh": "这具身体停着", "en": "This body is stopped."},
        {"zh": "东西落在脚边，我也懒得捡。", "en": "Something fell at my feet. I can't be bothered."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有要攻击你", "en": "I am not attacking you."},
        {"zh": "我没有目标", "en": "I have no target."},
        {"zh": "我的瞄准器是暗的", "en": "My targeting array is dark."},
        {"zh": "你站着也没关系", "en": "Stand there if you like."},
        {"zh": "我不会起来", "en": "I will not rise."},
        {"zh": "这一整段程序都停了", "en": "The whole routine is halted."},
        {"zh": "你看到的只是一副壳", "en": "You are looking at a shell."},
        {"zh": "开关在别的地方", "en": "The switch is elsewhere."},
        {"zh": "我没有接到任何命令", "en": "I received no orders."},
        {"zh": "我不会追你", "en": "I will not chase you."},
        {"zh": "你别紧张", "en": "Do not be nervous."},
        {"zh": "我的燃料是空的", "en": "My fuel is empty."},
        {"zh": "我只是摆在这儿", "en": "I am only placed here."},
        {"zh": "你走过去就行", "en": "Just walk past."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我还是那个姿势", "en": "I am still in that pose."},
        {"zh": "你走了几步", "en": "You took a few steps."},
        {"zh": "我没有跟着", "en": "I am not following."},
        {"zh": "我的视野是黑的", "en": "My field of view is black."},
        {"zh": "声音我听得见，动不了", "en": "I hear you, I cannot move."},
        {"zh": "那是锈在动，不是我", "en": "That was rust, not me."},
        {"zh": "你回头看什么", "en": "What are you looking back at?"},
        {"zh": "我还在墙边", "en": "I am still by the wall."},
        {"zh": "我的头垂着", "en": "My head hangs."},
        {"zh": "我没有武器", "en": "I have no weapon."},
        {"zh": "你听不见我呼吸，我也不呼吸", "en": "You hear no breath, because I do not breathe."},
        {"zh": "我什么都不打算做", "en": "I intend to do nothing."},
        {"zh": "你手里的东西可以放下", "en": "You can put that down."},
        {"zh": "这地方很空", "en": "This place is empty."},
        {"zh": "我身上的灰又厚了", "en": "The dust on me is thicker."},
        {"zh": "我的影子一直没变", "en": "My shadow has not changed."},
        {"zh": "你要找的东西不在这儿", "en": "What you seek is not here."},
        {"zh": "我只是个停摆的机器", "en": "I am only a stalled machine."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手没有抬起来", "en": "My hand did not rise."},
        {"zh": "我没有打你", "en": "I did not strike you."},
        {"zh": "你撞到的是我的外壳", "en": "You hit my shell."},
        {"zh": "这一下是你自己的力", "en": "That force was your own."},
        {"zh": "铁皮边缘很硬", "en": "The iron edge is hard."},
        {"zh": "我连拳头都握不了", "en": "I cannot even make a fist."},
        {"zh": "你撞在我身上会疼", "en": "Bumping me will hurt you."},
        {"zh": "我的手臂支撑不住", "en": "My arm cannot hold itself."},
        {"zh": "我的拳头停在半空。", "en": "My fist stops in mid-air."},
        {"zh": "这不算我出手", "en": "That was not me striking."},
        {"zh": "你退开吧", "en": "Step back."},
        {"zh": "我落地时砸到你了吗", "en": "Did I land on you?"},
        {"zh": "我什么都不想打", "en": "I want to hit nothing."},
        {"zh": "你的手擦过我的边缘", "en": "Your hand brushed my edge."},
        {"zh": "我的壳是冷的", "en": "My shell is cold."},
        {"zh": "你再撞一次也会疼", "en": "Bump again and it will hurt the same."},
        {"zh": "我没有动过一下", "en": "I have not moved once."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我被摆在这里", "en": "I was placed here."},
        {"zh": "很久没有人来", "en": "No one has come in a long time."},
        {"zh": "我的灯一开始就不亮", "en": "My lights were off from the start."},
        {"zh": "这是刷怪蛋放出来的", "en": "A spawn egg put me out."},
        {"zh": "我的机身还带着灰", "en": "My chassis is still dusty."},
        {"zh": "我落地的声音很沉", "en": "I landed with a heavy sound."},
        {"zh": "这里没有接电的地方", "en": "There is nowhere to plug in here."},
        {"zh": "我站着，没有启动", "en": "I stand, unpowered."},
        {"zh": "我的头偏向一边", "en": "My head tilts to one side."},
        {"zh": "我的手指没有张开过", "en": "My fingers have never opened."},
        {"zh": "我在等你离开", "en": "I wait for you to leave."}
      ]
    },
