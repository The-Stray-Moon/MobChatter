{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地走，腿很短", "en": "I keep low; my legs are short."},
        {"zh": "背上那块晶石一晃一晃", "en": "The crystal on my back sways."},
        {"zh": "花丛里我穿过去", "en": "I go through the flower patch."},
        {"zh": "我的壳反着光", "en": "My shell throws back the light."},
        {"zh": "我走得不快，但一直在动", "en": "Not fast, but always moving."},
        {"zh": "紫色的地上，我很难看清", "en": "On purple ground I'm hard to spot."},
        {"zh": "每步都踩得很轻", "en": "Every step is light."},
        {"zh": "我绕开那些高的花", "en": "I skirt the tall flowers."},
        {"zh": "一窝四只，脚步很密", "en": "Four to a nest, and the steps are dense."},
        {"zh": "石头缝我也能钻", "en": "I can squeeze through stone gaps."},
        {"zh": "走过去，花瓣落了一地", "en": "I pass and petals fall."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴着，晶石还亮", "en": "I lie low, the crystal still glowing."},
        {"zh": "这一片花丛是我的", "en": "This patch of flowers is mine."},
        {"zh": "我用前爪刨了刨土", "en": "I scratch at the dirt."},
        {"zh": "光的颜色会变", "en": "The light's color changes."},
        {"zh": "我不太大，也不算小", "en": "I'm not big, nor small."},
        {"zh": "我在听花丛里的动静", "en": "I'm listening in the flowers."},
        {"zh": "身上的棱角碰到叶子", "en": "My edges touch the leaves."},
        {"zh": "我在等天黑还是等别的，都不重要", "en": "I wait, for dark or something else."},
        {"zh": "晶石里有东西在动", "en": "Something moves inside the crystal."},
        {"zh": "我不需要站起来也能看", "en": "I can see without standing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在花丛外面", "en": "You're outside the flower patch."},
        {"zh": "我背上这块，别碰", "en": "Don't touch this on my back."},
        {"zh": "我盯着你，你也盯着我", "en": "I watch you, you watch me."},
        {"zh": "这一窝四只，都在这", "en": "Four of us, all here."},
        {"zh": "你在犹豫", "en": "You're hesitating."},
        {"zh": "你身上的颜色和这里不搭", "en": "Your colors don't match this place."},
        {"zh": "你想拿我背上的石头", "en": "You want the stone on my back."},
        {"zh": "别低头，我看不清你的眼", "en": "Don't lower your head; I can't see your eyes."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳里嵌着宝石。", "en": "Gems are set into my shell."},
        {"zh": "晶石暗了一下", "en": "My crystal dimmed."},
        {"zh": "我退到花丛里", "en": "I retreat into the flowers."},
        {"zh": "这一下，我缩起来了", "en": "That made me curl up."},
        {"zh": "我不叫，叫了会暴露", "en": "I don't cry out; it gives me away."},
        {"zh": "我压低身体", "en": "I flatten down."},
        {"zh": "再打我就钻洞", "en": "Hit again and I go into a hole."},
        {"zh": "这一下疼", "en": "That hurt."},
        {"zh": "我还亮着", "en": "I'm still glowing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西会发光吗", "en": "Does that thing shine?"},
        {"zh": "我喜欢亮的东西", "en": "I like bright things."},
        {"zh": "你举起来给我看看", "en": "Hold it up so I can see."},
        {"zh": "这点光不够", "en": "That's not enough light."},
        {"zh": "石头我不要，我要闪的", "en": "I don't want stone; I want shine."},
        {"zh": "这不是我的同类", "en": "That's not one of mine."},
        {"zh": "你手里那个有棱", "en": "That one has facets."},
        {"zh": "我在闻", "en": "I'm sniffing."},
        {"zh": "放近点", "en": "Bring it closer."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我，我退一步就站住", "en": "One bump and I plant myself."},
        {"zh": "别贴着我，棱会划你", "en": "Don't lean; my edges cut."},
        {"zh": "花瓣被我们撞乱了", "en": "We've scattered the petals."},
        {"zh": "我在你脚下钻过去", "en": "I slip under your feet."},
        {"zh": "这一下，你被划到了", "en": "That scratched you."},
        {"zh": "让开，我要钻缝", "en": "Move, I'm going into a gap."},
        {"zh": "撞到石头，我弹回来", "en": "I hit stone and bounced back."},
        {"zh": "我们挤在一处", "en": "We're crowded together."},
        {"zh": "别推，我会咬", "en": "Don't push; I bite."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在这一窝里", "en": "We're all in this nest."},
        {"zh": "四只里两只是一对", "en": "Two of the four are a pair."},
        {"zh": "花丛深处还有窝", "en": "There are more nests deeper in the flowers."},
        {"zh": "这种事不用你管", "en": "That's not your concern."},
        {"zh": "我们的光会互相照", "en": "Our lights shine on each other."},
        {"zh": "石头是从土里挖的", "en": "The stones were dug from the soil."},
        {"zh": "你走了再说", "en": "Go away first."},
        {"zh": "这一片够我们住", "en": "This patch is enough for us."},
        {"zh": "同类的味道很近", "en": "A kin's smell is very close."},
        {"zh": "别在这儿站着", "en": "Don't stand here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块石头闪闪的", "en": "This stone is shiny."},
        {"zh": "它比我还沉", "en": "It's heavier than I am."},
        {"zh": "地上这几块，我都要", "en": "All these on the ground, I want them."},
        {"zh": "我叼起来，走两步又放下", "en": "I pick it up, take two steps, and drop it."},
        {"zh": "这个不够亮", "en": "This isn't bright enough."},
        {"zh": "我把它塞进土里", "en": "I shove it into the soil."},
        {"zh": "别人掉的，正好", "en": "Someone dropped it; good."},
        {"zh": "地上一闪一闪的", "en": "Something glints on the ground."},
        {"zh": "这块是我的", "en": "This one's mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踏进花丛了", "en": "You've stepped into the flowers."},
        {"zh": "那边有脚步声", "en": "Footsteps over there."},
        {"zh": "这一窝都抬起头了", "en": "The whole nest lifted their heads."},
        {"zh": "我先动，剩下的跟上", "en": "I move first; the rest follow."},
        {"zh": "这个距离，够我扑", "en": "Close enough to pounce."},
        {"zh": "你的影子投在花上", "en": "Your shadow falls on the flowers."},
        {"zh": "有缝隙，我钻得过去", "en": "There's a gap; I can slip through."},
        {"zh": "花太高，挡着你", "en": "The flowers are tall and hide you."},
        {"zh": "就现在", "en": "Now."},
        {"zh": "我的晶石亮起来了", "en": "My crystal lit up."},
        {"zh": "我把爪子伸出来", "en": "I extend my claws."},
        {"zh": "从侧面进", "en": "Come in from the side."},
        {"zh": "这一片我熟", "en": "I know this patch."},
        {"zh": "锁定了", "en": "Locked on."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在花茎下面走", "en": "I move under the stems."},
        {"zh": "你还站着不动", "en": "You're still standing there."},
        {"zh": "棱面折出你的影子，我慢慢靠过去。", "en": "My facets catch your reflection; I edge closer."},
        {"zh": "我压着草过去", "en": "I go through the grass, low."},
        {"zh": "我的光会露位置", "en": "My light gives my position away."},
        {"zh": "我把晶石转了个方向", "en": "I turn the crystal away."},
        {"zh": "这一窝在往两边散", "en": "The nest is fanning out."},
        {"zh": "你先动了", "en": "You moved first."},
        {"zh": "我不急，我等你低头", "en": "No rush; I wait for you to look down."},
        {"zh": "紫花挡着我，也挡着你", "en": "The purple flowers hide us both."},
        {"zh": "再两步", "en": "Two steps more."},
        {"zh": "现在这个角度", "en": "This angle now."},
        {"zh": "跳", "en": "Jump."},
        {"zh": "我换了个花缝，从那边看你", "en": "I switch to another gap and watch you from there."},
        {"zh": "你不低头，我就得跳更高", "en": "If you don't look down, I'll have to jump higher."},
        {"zh": "我的腿蓄着劲", "en": "My legs are loaded."},
        {"zh": "花丛的动静盖住了我", "en": "The rustle of the flowers covers me."},
        {"zh": "再近半步，我就够得到", "en": "Half a step more and I'll reach."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上去咬住", "en": "I leap and bite."},
        {"zh": "爪子划过你的腿", "en": "My claws rake your leg."},
        {"zh": "晶石撞在你膝上", "en": "The crystal strikes your knee."},
        {"zh": "我跳开，又扑回来", "en": "I spring away and come back."},
        {"zh": "这一下很浅", "en": "That one was shallow."},
        {"zh": "你抬脚，我钻到下面", "en": "You lift a foot, so I duck under."},
        {"zh": "花丛被我们踩乱了", "en": "We've trampled the flower patch."},
        {"zh": "同伴从后面上", "en": "My kin come from behind."},
        {"zh": "这一下够你退", "en": "That's enough to push you back."},
        {"zh": "我退了，晶石还亮", "en": "I pull back, crystal still lit."},
        {"zh": "血滴在紫花上", "en": "Blood drips on the purple flowers."},
        {"zh": "你还站着", "en": "You're still standing."},
        {"zh": "我们四只一起上", "en": "All four of us at once."},
        {"zh": "这一下不轻", "en": "That one wasn't light."},
        {"zh": "我从花底下钻出来", "en": "I come out from under the flowers."},
        {"zh": "你退到花丛外", "en": "You've backed out of the patch."},
        {"zh": "我们跟着", "en": "We follow."},
        {"zh": "收爪", "en": "Claws in."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "花丛下面冒出一个小小的影子", "en": "A small shadow rises under the flowers."},
        {"zh": "晶石撑开泥土，我抖落一身碎屑。", "en": "Crystal pushes the soil apart; I shake off the grit."},
        {"zh": "背上的晶石已经有了光", "en": "The crystal on my back already glows."},
        {"zh": "这一窝多了我一只", "en": "The nest has one more of me."},
        {"zh": "紫色的花瓣下面正好", "en": "Under purple petals is just right."},
        {"zh": "花丛里亮起一小块棱晶。", "en": "A small prism lights up among the blooms."},
        {"zh": "这里的花比别处密", "en": "The flowers are denser here."},
        {"zh": "我在找一块好石头", "en": "I'm looking for a good stone."},
        {"zh": "有脚步声，先躲", "en": "Footsteps; I hide first."},
        {"zh": "我从石缝里出来", "en": "I come out of a stone gap."},
        {"zh": "这一带我第一次来", "en": "This is my first time here."},
        {"zh": "我抬头，光很刺眼", "en": "I look up; the light stings."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，外壳就酥了", "en": "Fire made my shell brittle."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，晶石磕在地上", "en": "I fell, crystal striking the ground."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一泡，光就弱了", "en": "Soaked, my light fades."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我滚出花丛", "en": "The blast rolled me out of the flowers."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭撞在壳上，弹开了", "en": "The arrow struck my shell and bounced."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，晶石乱闪", "en": "The spell hit and my crystal flashed wildly."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿了，光就淡", "en": "Hungry, my light thins."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打来，整块晶石都亮了", "en": "Lightning struck and the whole crystal blazed."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有花，也没有土", "en": "No flowers in the void, and no soil."}
      ]
    }
  }
}
