{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我穿过暗叶林，步子很长。", "en": "I cross the darkleaf wood with long strides."},
        {"zh": "我的身子又高又瘦。", "en": "My body is tall and lean."},
        {"zh": "我的脚踩在腐叶上，无声。", "en": "My feet fall silently on rotten leaves."},
        {"zh": "我经过一棵树，摸了摸树皮。", "en": "I pass a tree and touch its bark."},
        {"zh": "那里有孢子，我认得。", "en": "There are spores there. I know them."},
        {"zh": "我绕开一丛发光的菌。", "en": "I go around a patch of glowing fungus."},
        {"zh": "它们还没有熟。", "en": "They are not ripe yet."},
        {"zh": "这片菌床，我记住了", "en": "I will remember this fungus bed."},
        {"zh": "我继续往里走。", "en": "I go deeper."},
        {"zh": "林子越深，光越暗。", "en": "The deeper in, the dimmer the light."},
        {"zh": "我正好喜欢这样。", "en": "That suits me exactly."},
        {"zh": "我停下，抬头看了看。", "en": "I stop and look up."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，孢子在我周围浮。", "en": "I stand and spores drift around me."},
        {"zh": "我呼出一口气，是灰绿的。", "en": "I breathe out, and it is grey-green."},
        {"zh": "那些孢子会落在叶上。", "en": "Those spores will settle on the leaves."},
        {"zh": "过些天就会长出来。", "en": "In a few days they will grow."},
        {"zh": "我慢慢转着身。", "en": "I turn slowly."},
        {"zh": "我在看哪棵树更合适。", "en": "I am judging which tree suits them best."},
        {"zh": "这一棵太干了。", "en": "This one is too dry."},
        {"zh": "那一棵又太新。", "en": "That one is too young."},
        {"zh": "中间那棵正好。", "en": "The middle one is right."},
        {"zh": "我挪步凑近它。", "en": "I step over to it."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了暗叶林。", "en": "You have come into the darkleaf wood."},
        {"zh": "我站定，先看你有没有面罩", "en": "I stop and check whether you wear a mask."},
        {"zh": "我比你高一个头。", "en": "I stand a head taller than you."},
        {"zh": "你没有戴面罩。", "en": "You wear no mask."},
        {"zh": "那可不太好。", "en": "That is not good at all."},
        {"zh": "我呼出的气会碰到你。", "en": "My breath will reach you."},
        {"zh": "我朝后退开。", "en": "I draw back."},
        {"zh": "不是为你，是为林子。", "en": "Not for you. For the wood."},
        {"zh": "我的脚踩在腐叶上，一点声都没有。", "en": "My feet on rotted leaves make no sound."},
        {"zh": "但你要走，我不拦。", "en": "But if you go, I will not stop you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退开，孢子散得更远。", "en": "I pull back and the spores scatter wider."},
        {"zh": "我身上的菌丝断了。", "en": "My mycelium has torn."},
        {"zh": "菌丝断了几根，我按住", "en": "A few threads snapped; I press them down."},
        {"zh": "伤口并不深。", "en": "The wound is not deep."},
        {"zh": "我抬手捂住伤口。", "en": "I cover it with a hand."},
        {"zh": "孢子从指缝出来。", "en": "Spores escape between my fingers."},
        {"zh": "我靠着树站着。", "en": "I lean against a tree."},
        {"zh": "树皮是凉的。", "en": "The bark is cool."},
        {"zh": "我慢慢站直身子。", "en": "I straighten slowly."},
        {"zh": "腿还听话，暗叶林还深", "en": "My legs still obey; the darkleaf wood runs deep."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这味道太干净，不合我", "en": "Too clean a smell; not for me."},
        {"zh": "你把它举得很高。", "en": "You hold it high."},
        {"zh": "我的孢子不感兴趣。", "en": "My spores take no interest."},
        {"zh": "这里的东西都长得慢。", "en": "Everything here grows slowly."},
        {"zh": "我长得也慢。", "en": "I grow slowly too."},
        {"zh": "我盯了它一阵。", "en": "I stare at it a while."},
        {"zh": "然后我转过身。", "en": "Then I turn away."},
        {"zh": "有棵树需要我。", "en": "A tree needs me."},
        {"zh": "暗叶林里，孢子是我的路标。", "en": "In Darkleaf Woods, spores are my signposts."},
        {"zh": "这林子里没有你的份。", "en": "There is no share for you in this wood."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我几乎没动。", "en": "You hit me and I barely move."},
        {"zh": "我俯下身，孢子落下来", "en": "I bend forward and spores drift down."},
        {"zh": "我的手抬起来，又放下，孢子太多。", "en": "I raise a hand and lower it; too many spores."},
        {"zh": "暗叶林里，我一跃就到你面前。", "en": "In Darkleaf Woods one leap brings me close."},
        {"zh": "暗叶林里，我跃起来扑。", "en": "In Darkleaf Woods, I leap to strike."},
        {"zh": "我的肩擦过你的头。", "en": "My shoulder brushes your head."},
        {"zh": "你要小心，我身上有孢子。", "en": "Be careful. I carry spores."},
        {"zh": "吸进去会不舒服。", "en": "Breathe them in and you will not feel well."},
        {"zh": "你退了，这很好。", "en": "You step back. Good."},
        {"zh": "我继续走我的。", "en": "I go on my way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里还有另一个。", "en": "There is another in the wood."},
        {"zh": "我们隔着一段路。", "en": "A stretch of path between us."},
        {"zh": "它也在撒孢子。", "en": "It is scattering spores too."},
        {"zh": "两片孢子云碰在一起。", "en": "Our two clouds meet."},
        {"zh": "那是最快的方式。", "en": "That is the quickest way."},
        {"zh": "孢子云一碰就够了", "en": "Two clouds touching is enough."},
        {"zh": "这样对林子更好。", "en": "It is better for the wood."},
        {"zh": "我掉头走回林里。", "en": "I turn back into the wood."},
        {"zh": "它也转身走开。", "en": "So does it."},
        {"zh": "孢子还在飘着。", "en": "The spores keep drifting."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯身，从叶堆里拣出来", "en": "I stoop and lift it from the leaf pile."},
        {"zh": "是一块腐木。", "en": "A piece of rotten wood."},
        {"zh": "刚刚好够用。", "en": "Just what is needed."},
        {"zh": "腐木塞进树杈，孢子会来", "en": "Rotten wood into the fork; the spores will come."},
        {"zh": "孢子会喜欢这里。", "en": "The spores will like it here."},
        {"zh": "我拍了拍手。", "en": "I clap my hands."},
        {"zh": "灰落下来一层。", "en": "Ash falls."},
        {"zh": "再瞧一眼，孢子还没落", "en": "One more glance; the spores have not settled."},
        {"zh": "是一块腐木，刚刚好够用。", "en": "A piece of rotten wood — just enough."},
        {"zh": "我退开几步离开。", "en": "I step away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在林子里走。", "en": "Something is walking in the wood."},
        {"zh": "它的脚步太重。", "en": "Its steps are too heavy."},
        {"zh": "我转过去，正对它。", "en": "I turn to face it."},
        {"zh": "我的孢子已经散出去了。", "en": "My spores are already out."},
        {"zh": "它吸进去了一些。", "en": "It has breathed some in."},
        {"zh": "它开始咳起来。", "en": "It begins to cough."},
        {"zh": "我一步一步，压着落叶", "en": "Step by step, pressing the fallen leaves."},
        {"zh": "它的脚步快不起来。", "en": "It cannot quicken its steps."},
        {"zh": "我循着孢子味找过来。", "en": "I followed the smell of spores here."},
        {"zh": "它退进了我的孢子雾里", "en": "It backs straight into my spore cloud."},
        {"zh": "但退不了多远。", "en": "But not far."},
        {"zh": "我的孢子跟着它。", "en": "My spores follow it."},
        {"zh": "我停下来，看着。", "en": "I stop and watch."},
        {"zh": "到这个地步就行了。", "en": "That is far enough."},
        {"zh": "它会自己慢下来。", "en": "It will slow on its own."},
        {"zh": "暗叶林的孢子，我闻得最准。", "en": "No one smells Darkleaf spores better."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着它走动。", "en": "I follow it."},
        {"zh": "我的孢子一直往前飘。", "en": "My spores drift ahead."},
        {"zh": "它又咳了一声。", "en": "It coughs again."},
        {"zh": "它的脚步开始乱。", "en": "Its steps begin to wander."},
        {"zh": "它扶住了一棵树。", "en": "It steadies itself on a tree."},
        {"zh": "那棵树上有菌。", "en": "There is fungus on that tree."},
        {"zh": "那是我种的。", "en": "I planted it."},
        {"zh": "它靠在那儿喘。", "en": "It leans there, gasping."},
        {"zh": "我朝它靠过去。", "en": "I close in on it."},
        {"zh": "它把头抬起来。", "en": "It looks up."},
        {"zh": "我比它高很多。", "en": "I am much taller."},
        {"zh": "我举起枯瘦的手。", "en": "I lift my gaunt hand."},
        {"zh": "孢子在我掌心聚起来。", "en": "Spores gather in my palm."},
        {"zh": "然后又散开。", "en": "And then spread."},
        {"zh": "它咳得更厉害。", "en": "It coughs harder."},
        {"zh": "它倒在地上了。", "en": "It goes down."},
        {"zh": "我在旁边蹲下。", "en": "I crouch beside it."},
        {"zh": "就这样看着。", "en": "And watch."},
        {"zh": "不用我亲自动手。", "en": "I need not strike myself."},
        {"zh": "林子会处理完。", "en": "The wood will finish it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一把抓住它的肩。", "en": "I seize its shoulder."},
        {"zh": "它比我以为的轻。", "en": "Lighter than I expected."},
        {"zh": "我把它按到树上。", "en": "I pin it to a tree."},
        {"zh": "孢子从我嘴里出去。", "en": "Spores leave my mouth."},
        {"zh": "正好在它脸上。", "en": "Right in its face."},
        {"zh": "它拼命地挣扎。", "en": "It thrashes."},
        {"zh": "我就让它挣。", "en": "I let it."},
        {"zh": "我又吹了一次。", "en": "I blow once more."},
        {"zh": "它开始软下去。", "en": "It goes slack."},
        {"zh": "我松开了手。", "en": "I let go."},
        {"zh": "它顺着树干滑下去。", "en": "It slides down the trunk."},
        {"zh": "我低头看了很久，才动。", "en": "I look down for a long time, then move."},
        {"zh": "然后走向那棵菌树。", "en": "Then walk to the fungus tree."},
        {"zh": "我检查了菌丝。", "en": "I check the mycelium."},
        {"zh": "长得还不错。", "en": "It is growing well."},
        {"zh": "这才是正经事。", "en": "This is the real work."},
        {"zh": "我蹲下身去。", "en": "I crouch down."},
        {"zh": "慢慢拨开腐叶。", "en": "And part the rotten leaves."},
        {"zh": "新的地方要留着。", "en": "A new patch must be left clear."},
        {"zh": "我做成了一件。", "en": "There. Done."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树根间站起来。", "en": "I rise from among the roots."},
        {"zh": "腐叶沾在我身上。", "en": "Rotten leaves cling to me."},
        {"zh": "暗叶林的气味很重。", "en": "The darkleaf wood smells heavy."},
        {"zh": "我深吸了一口。", "en": "I take a deep breath of it."},
        {"zh": "这里适合孢子。", "en": "This suits spores."},
        {"zh": "树冠密得只剩一线光", "en": "The canopy leaves one thin line of light."},
        {"zh": "密得看不见天。", "en": "So thick the sky is lost."},
        {"zh": "这里正合适。", "en": "Perfect."},
        {"zh": "我开始往深处走。", "en": "I start deeper in."},
        {"zh": "脚边有菌子。", "en": "Fungus at my feet."},
        {"zh": "我蹲下去看它。", "en": "I crouch to look."},
        {"zh": "它们长得很好。", "en": "They are growing well."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到菌丝，那味道很难闻。", "en": "Fire reaches the mycelium and the stink is foul."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下，摔进腐叶里。", "en": "I fall from height into the rotten leaves."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进来，孢子被冲走了。", "en": "Water floods in and my spores are washed away."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀翻，叶子和孢子一起飞。", "en": "The blast flips me and leaves and spores fly."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的侧肋。", "en": "An arrow lodges in my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光压下来，我的孢子停住了。", "en": "Strange light presses down and my spores halt."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有腐木，菌丝开始干。", "en": "No rotten wood, and the mycelium dries."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈下来，我的菌丝全焦了。", "en": "Lightning strikes and my mycelium is scorched."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "林地的地没了，我往下坠。", "en": "The forest floor is gone and I fall."}
      ]
    }
  }
}
