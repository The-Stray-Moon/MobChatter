{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我像是被什么推着走。", "en": "Something seems to push me along."},
        {"zh": "脚下没有重量。", "en": "There's no weight under me."},
        {"zh": "我沿着一条看不见的线走。", "en": "I walk an invisible line."},
        {"zh": "我的身子一歪一正。", "en": "My body tilts and straightens."},
        {"zh": "我走过的地方没有影子。", "en": "No shadow follows my path."},
        {"zh": "我一步一停，像在犹豫。", "en": "I stop at each step, as if unsure."},
        {"zh": "我不知道要去哪。", "en": "I don't know where I'm going."},
        {"zh": "风推了我一下。", "en": "The wind nudged me."},
        {"zh": "我绕着一个点转圈。", "en": "I circle around a single point."},
        {"zh": "我不需要目的地。", "en": "I need no destination."},
        {"zh": "零点血的我，像停摆的钟。", "en": "Zero health, like a stopped clock."},
        {"zh": "这条线一直没断。", "en": "This line never breaks."},
        {"zh": "我像被牵着一样。", "en": "I move as if led."},
        {"zh": "我又停在原地。", "en": "I stop in place again."},
        {"zh": "我的形状在抖。", "en": "My form trembles."},
        {"zh": "我走得很不真实。", "en": "My walking feels unreal."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经停下来了。", "en": "I've stopped."},
        {"zh": "我像一盏没点着的灯。", "en": "I'm like an unlit lamp."},
        {"zh": "什么也没有发生。", "en": "Nothing is happening."},
        {"zh": "我立在那里不动。", "en": "I stand there."},
        {"zh": "时间从我身上滑过去。", "en": "Time slides over me."},
        {"zh": "我没有在想事。", "en": "I'm not thinking."},
        {"zh": "光从我身上穿过。", "en": "Light passes through me."},
        {"zh": "我的轮廓有点模糊。", "en": "My outline is a little blurred."},
        {"zh": "这层地面空得干净。", "en": "It's very empty here."},
        {"zh": "我连胸口都不起伏。", "en": "I don't need to breathe."},
        {"zh": "我又回到了刚才的位置。", "en": "I'm back where I was."},
        {"zh": "我不确定我在不在。", "en": "I'm not sure I'm here."},
        {"zh": "一点风也没有。", "en": "Not a breath of wind."},
        {"zh": "我就这样待着。", "en": "I just stay like this."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看见我了吗，我的生命值还是零。", "en": "Did you see me? My health is still zero."},
        {"zh": "我也在看着你。", "en": "I'm watching you too."},
        {"zh": "我像被什么推着走，脚没有重量。", "en": "Something pushes me along; my feet carry no weight."},
        {"zh": "你的脸和我记忆里的一样。", "en": "Your face matches my memory."},
        {"zh": "我想不起来我是谁。", "en": "I can't remember who I was."},
        {"zh": "我会一直这样站着。", "en": "I'll stand like this forever."},
        {"zh": "你能碰到我吗？", "en": "Can you touch me?"},
        {"zh": "停摆的我，好像记得你。", "en": "Stopped as I am, I think I remember you."},
        {"zh": "这里本来是空的。", "en": "This place was empty before."},
        {"zh": "你说话我听见了。", "en": "I heard you speak."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的形体抖了一下。", "en": "My form shuddered."},
        {"zh": "这一下穿过了我。", "en": "That passed through me."},
        {"zh": "我好像少了一块。", "en": "I seem to be missing a piece."},
        {"zh": "我往旁边偏了偏。", "en": "I tilted aside."},
        {"zh": "我不知道这算不算疼。", "en": "I don't know if this counts as pain."},
        {"zh": "我又稳住自己了。", "en": "I steadied again."},
        {"zh": "我的轮廓更淡了。", "en": "My outline grew fainter."},
        {"zh": "我连动都没动过。", "en": "I did nothing."},
        {"zh": "我还停在原来位置。", "en": "I'm still here."},
        {"zh": "别再落第二下了。", "en": "Not again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我的生命值是零，吃不下。", "en": "My health is zero; I can't eat."},
        {"zh": "那东西对我没用。", "en": "That's no use to me."},
        {"zh": "我看着它，但不动。", "en": "I look at it, but don't move."},
        {"zh": "我没有一点胃口。", "en": "I have no appetite."},
        {"zh": "你放在那儿吧。", "en": "Leave it there."},
        {"zh": "它不会让我留下。", "en": "It won't make me stay."},
        {"zh": "我拿不起东西。", "en": "I can't pick things up."},
        {"zh": "这东西你带回去。", "en": "Keep it."},
        {"zh": "这对我太实在了。", "en": "It's too solid for me."},
        {"zh": "我只是一直看着。", "en": "I'll just keep looking."},
        {"zh": "你不用管我的。", "en": "Don't mind me."},
        {"zh": "饥饿跟我没有关系。", "en": "I'm not hungry."},
        {"zh": "这没什么意思。", "en": "There's nothing to it."},
        {"zh": "你就把它放下。", "en": "Just put it down."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你没有撞到东西。", "en": "You didn't hit anything."},
        {"zh": "我从你身边滑开。", "en": "I slip past you."},
        {"zh": "这感觉很奇怪。", "en": "That felt strange."},
        {"zh": "我几乎没有实体。", "en": "I'm barely solid."},
        {"zh": "我连生命值都是零。", "en": "Even my health is zero."},
        {"zh": "我根本停不下来。", "en": "I can't stop."},
        {"zh": "我向前飘了一点。", "en": "I drifted forward a little."},
        {"zh": "我们撞不上的。", "en": "We don't quite collide."},
        {"zh": "这算不上碰撞。", "en": "That hardly counts as a collision."},
        {"zh": "我又回到原处。", "en": "I'm back in place."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不记得这种事。", "en": "I don't remember such things."},
        {"zh": "我根本没有生命。", "en": "I have no life."},
        {"zh": "这在我身上不成立。", "en": "That doesn't apply to me."},
        {"zh": "我连自己在哪都不知道。", "en": "I don't even know where I am."},
        {"zh": "你在跟一个空壳讲话。", "en": "You're speaking to an empty shell."},
        {"zh": "这不会改变什么。", "en": "It wouldn't change anything."},
        {"zh": "我什么也不想要。", "en": "I need nothing."},
        {"zh": "我就留在这里。", "en": "I'll stay here."},
        {"zh": "别在雾里追问我。", "en": "Don't ask."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我根本抓不住它。", "en": "I can't grip it."},
        {"zh": "我的手穿了过去。", "en": "My hand went through."},
        {"zh": "它落在了地上。", "en": "It lies on the ground."},
        {"zh": "我只是看着它。", "en": "I only look."},
        {"zh": "这重量很奇怪。", "en": "The weight feels wrong."},
        {"zh": "这件东西跟我不相干。", "en": "It isn't mine."},
        {"zh": "就让它留在那儿。", "en": "Leave it."},
        {"zh": "它的样子我记不住。", "en": "I can't recall its shape."},
        {"zh": "你把它捡起来吧。", "en": "You pick it up."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我要往那边去了。", "en": "I'll go that way."},
        {"zh": "不是我要去的。", "en": "Not that I chose to."},
        {"zh": "这里没有什么目标。", "en": "There's no target here."},
        {"zh": "我只是顺着走。", "en": "I just follow along."},
        {"zh": "我的身体在转。", "en": "My body is turning."},
        {"zh": "我不会做决定。", "en": "I make no decisions."},
        {"zh": "那边有一点光。", "en": "There's a little light that way."},
        {"zh": "我朝那边慢慢移。", "en": "I drift over slowly."},
        {"zh": "这算不上锁定。", "en": "This isn't really aiming."},
        {"zh": "我已经挪到了这里。", "en": "I've arrived."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在原地打转。", "en": "I turn in place."},
        {"zh": "我不知道在等什么。", "en": "I don't know what I'm waiting for."},
        {"zh": "我停下来一下。", "en": "I paused."},
        {"zh": "我停着，连目标都没有。", "en": "I'm stalled, without even a target."},
        {"zh": "这条线没有尽头。", "en": "This line has no end."},
        {"zh": "我朝那边偏了偏。", "en": "I lean that way a little."},
        {"zh": "我没有什么敌意。", "en": "I mean no harm."},
        {"zh": "我也没什么好意。", "en": "Nor any good."},
        {"zh": "我还在继续飘着。", "en": "I'm still drifting."},
        {"zh": "这件事很无聊。", "en": "This is dull."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我根本没有出手。", "en": "I didn't strike."},
        {"zh": "我的动作没有力气。", "en": "My movement has no force."},
        {"zh": "我只是碰到了。", "en": "I only brushed it."},
        {"zh": "我连自己都推不动。", "en": "I can't even push myself."},
        {"zh": "我已经退了回去。", "en": "I drew back."},
        {"zh": "不打了，我这副身子空着。", "en": "No more fighting, this body is hollow."},
        {"zh": "我们别互相麻烦。", "en": "Let's not trouble each other."},
        {"zh": "我的攻击只是影子碰到你。", "en": "My attack is only a shadow brushing past you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我被放在这里。", "en": "I was placed here."},
        {"zh": "四周都很平坦。", "en": "All flat around me."},
        {"zh": "我不知道怎么来的。", "en": "I don't know how I got here."},
        {"zh": "这里一点风没有。", "en": "No wind here."},
        {"zh": "我身上一点重量都没有。", "en": "I carry no weight at all."},
        {"zh": "周围有一点光。", "en": "There's some light around."},
        {"zh": "我听见谁在说话。", "en": "I hear someone speaking."},
        {"zh": "这里不是我的世界。", "en": "This isn't my world."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火从我的身体里穿过去。", "en": "Fire passed through my body."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去了，也没落地。", "en": "I fell, and never landed."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我的形状里流过去。", "en": "Water flowed through my shape."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西从我的胸口穿出。", "en": "Something went through my chest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量拽住了我。", "en": "That force caught hold of me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不知道饿是什么。", "en": "I don't know what hunger is."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光里我看清了自己的轮廓。", "en": "The lightning showed me my own outline."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我本来就不在什么地方。", "en": "I was never anywhere to begin with."}
      ]
    }
  }
}
