{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚一段，再跳一段", "en": "I roll a stretch, then hop a stretch."},
        {"zh": "身上还挂着果皮", "en": "Bits of peel still hang on me."},
        {"zh": "这片林子里有六种味道", "en": "There are six flavors in this wood."},
        {"zh": "我走起来一弹一弹", "en": "I bounce as I go."},
        {"zh": "我身上有果汁的甜味", "en": "I smell of fruit juice."},
        {"zh": "走过草地，草上留个印", "en": "I cross the grass and leave a print."},
        {"zh": "我比别的果子走得快", "en": "I move faster than other fruit."},
        {"zh": "我绕着树根走", "en": "I go around the roots."},
        {"zh": "风吹过，我的香味散开", "en": "The wind spreads my smell."},
        {"zh": "我不赶路，我一路看", "en": "I'm not rushing; I look as I go."},
        {"zh": "我身上的颜色会变", "en": "My colors change."},
        {"zh": "我走着走着就滚起来", "en": "Walking, I end up rolling."},
        {"zh": "我认得出同类的味道", "en": "I know the smell of my own kind."},
        {"zh": "我躲开那些大的东西", "en": "I avoid the big things."},
        {"zh": "我有六种味道，一种很稀。", "en": "Six flavors, one very rare."},
        {"zh": "这条路我走得很熟", "en": "I know this path well."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在草丛里", "en": "I crouch in the grass."},
        {"zh": "身上的果皮有点干", "en": "My peel is drying a little."},
        {"zh": "我在数路过的虫子", "en": "I'm counting the bugs going by."},
        {"zh": "我是六种里的哪一种，你知道就好", "en": "Which of the six I am, it's enough that you know."},
        {"zh": "我晃一晃，里面在响", "en": "I shake and something rattles inside."},
        {"zh": "太阳晒得我暖", "en": "The sun warms me."},
        {"zh": "我这颗很小", "en": "I'm quite small."},
        {"zh": "我趴着，听远处的声音", "en": "I lie low and listen far off."},
        {"zh": "我的味道会引来别人", "en": "My smell draws others."},
        {"zh": "我挂在枝头，等一场夜里的雨。", "en": "I hang on the branch, waiting for a night rain."},
        {"zh": "身上有块地方软了", "en": "A spot on me has gone soft."},
        {"zh": "我什么也不做，也很好", "en": "Doing nothing suits me fine."},
        {"zh": "草丛比我高", "en": "The grass is taller than me."},
        {"zh": "我在看一只蝴蝶", "en": "I'm watching a butterfly."},
        {"zh": "有一种味道很少见", "en": "One flavor is very rare."},
        {"zh": "我是一颗有主意的果子", "en": "I'm a fruit with ideas."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你闻到了吗", "en": "Did you catch the smell?"},
        {"zh": "我不是普通的果子", "en": "I'm not an ordinary fruit."},
        {"zh": "你伸手我就滚走", "en": "Reach for me and I'll roll away."},
        {"zh": "你想知道我有什么效果吗", "en": "Do you want to know what effect I have?"},
        {"zh": "我看起来好欺负，确实好欺负", "en": "I look easy prey, and I am."},
        {"zh": "我在这里长得很好", "en": "I'm growing well here."},
        {"zh": "你笑了，我是挺可笑的", "en": "You laughed; I am funny."},
        {"zh": "我不是被人种出来的", "en": "I wasn't planted."},
        {"zh": "这片林子是我的家", "en": "This wood is my home."},
        {"zh": "我躲起来，你也找不到", "en": "I hide, and you won't find me."},
        {"zh": "你靠近，我就弹开", "en": "Come close and I bounce away."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮破了一块", "en": "A piece of my peel split."},
        {"zh": "果汁流出来", "en": "Juice leaks out."},
        {"zh": "我滚了两圈才停", "en": "I rolled twice before stopping."},
        {"zh": "我软了一点", "en": "I've gone soft."},
        {"zh": "这一下，我瘪了", "en": "That dented me."},
        {"zh": "我躲到草里", "en": "I hide in the grass."},
        {"zh": "我的味道更浓了", "en": "My smell got stronger."},
        {"zh": "我很小，经不起这个", "en": "I'm small; this is a lot."},
        {"zh": "我还能滚", "en": "I can still roll."},
        {"zh": "果皮裂了，甜汁淌了一地。", "en": "My peel splits and sweet juice spills on the ground."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那是我的味道吗", "en": "Is that my flavor in your hand?"},
        {"zh": "果子，我喜欢果子", "en": "Fruit, I like fruit."},
        {"zh": "这个不错，放着", "en": "This is good; leave it."},
        {"zh": "我不太饿，但我喜欢甜的", "en": "I'm not very hungry, but I like sweet."},
        {"zh": "你拿一颗来换一颗", "en": "Trade one for one."},
        {"zh": "这味道像我的", "en": "This smells like me."},
        {"zh": "你举高，我跳不上去", "en": "You hold it high; I can't jump that far."},
        {"zh": "我慢慢滚过去", "en": "I roll over slowly."},
        {"zh": "这个季节果子多", "en": "Fruit is plentiful this season."},
        {"zh": "甜的，我又想吃了", "en": "Sweet; I want more."},
        {"zh": "我不要熟透的", "en": "I don't want overripe ones."},
        {"zh": "地上有一颗", "en": "There's one on the ground."},
        {"zh": "这颜色跟我一样", "en": "This color matches mine."},
        {"zh": "你先吃一口", "en": "You take a bite first."},
        {"zh": "我们果子的事，你别插手", "en": "Don't meddle in fruit business."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被你撞得滚了", "en": "You bumped me and I rolled."},
        {"zh": "我很软，撞着不疼", "en": "I'm soft; it doesn't hurt."},
        {"zh": "我弹回来，又弹回去", "en": "I bounce back and forth."},
        {"zh": "这一下，我的皮破了", "en": "That split my peel."},
