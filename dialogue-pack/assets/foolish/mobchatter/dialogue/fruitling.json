    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们是一颗一颗的", "en": "We come one by one."},
        {"zh": "林子里还有别的果子", "en": "There are other fruits in the wood."},
        {"zh": "不同的味道不会配在一起", "en": "Different flavors don't pair."},
        {"zh": "同种的味道会互相找", "en": "The same flavor finds its own."},
        {"zh": "那种少见的，几乎见不到", "en": "The rare one is almost never seen."},
        {"zh": "我们不会长成一棵树", "en": "We won't grow into a tree."},
        {"zh": "地上滚着好几颗", "en": "Several are rolling on the ground."},
        {"zh": "你看见就看见了，别管", "en": "You saw it; leave it be."},
        {"zh": "等熟了再说", "en": "Ask when we're ripe."},
        {"zh": "这颗有点酸", "en": "This one's a bit sour."}
      ]
