  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我很高，走得很慢", "en": "I am tall, and I walk slowly."},
        {"zh": "一步要挪很久", "en": "Each step takes a long while."},
        {"zh": "我的肩碰到门框", "en": "My shoulder scrapes the doorframe."},
        {"zh": "脚下的砖在响", "en": "The tiles sound under me."},
        {"zh": "我低头走过横梁", "en": "I duck under the beams."},
        {"zh": "我的步子卡顿", "en": "My strides stutter."},
        {"zh": "我从殿里挪到殿外", "en": "I shift from hall to hall."},
        {"zh": "我走得摇摇晃晃", "en": "I sway as I go."},
        {"zh": "我停在半路", "en": "I stop halfway."},
        {"zh": "甲片摩擦着响", "en": "My plates grind."},
        {"zh": "我的影子遮住一条路", "en": "My shadow covers a whole path."},
        {"zh": "我转身很慢", "en": "I turn very slowly."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着不动", "en": "I stand still."},
        {"zh": "我连任务都没有", "en": "I do not even have a task."},
        {"zh": "芯里很安静", "en": "My core is quiet."},
        {"zh": "我等着，但没有人来", "en": "I wait, but no one comes."},
        {"zh": "我的头低着", "en": "My head hangs low."},
        {"zh": "这地方太矮了", "en": "This place is too low."},
        {"zh": "我的动作很呆板", "en": "My motions are mechanical."},
        {"zh": "灰尘落满肩膀", "en": "Dust fills my shoulders."},
        {"zh": "我的脚一直没挪过", "en": "My feet have not shifted."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你只到我腰那么高", "en": "You reach only to my waist."},
        {"zh": "你抬头看我", "en": "You look up at me."},
        {"zh": "我不会动", "en": "I will not move."},
        {"zh": "我的机身是停着的", "en": "My frame is stopped."},
        {"zh": "你手里那东西太小", "en": "What you hold is too small."},
        {"zh": "我没有敌意", "en": "I bear no hostility."},
        {"zh": "你敲我也没用", "en": "Knocking will not help."},
        {"zh": "我的壳很值钱", "en": "My shell is worth a lot."},
        {"zh": "你最好别靠太近", "en": "You had best not come near."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
