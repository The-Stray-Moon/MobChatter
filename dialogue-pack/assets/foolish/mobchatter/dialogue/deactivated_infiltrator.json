        {"zh": "铁壳里也传得进去", "en": "It reaches into the iron shell too."},
        {"zh": "我没有倒下", "en": "I did not fall."},
        {"zh": "你打得挺用力", "en": "You hit with some force."},
        {"zh": "我的重心还没偏", "en": "My balance has not shifted."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不用吃", "en": "I do not eat."},
        {"zh": "我的面罩是封死的", "en": "My faceplate is sealed."},
        {"zh": "我看不清那是什么", "en": "I cannot tell what that is."},
