{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我嗡嗡地飞过去。", "en": "I buzz past."},
        {"zh": "翅膀快得看不清。", "en": "My wings move too fast to see."},
        {"zh": "我在你看不见的高度绕。", "en": "I circle at a height you can't reach."},
        {"zh": "我贴着草尖掠过。", "en": "I skim over the grass tips."},
        {"zh": "我一停一起，很难抓。", "en": "I stop and start. Hard to catch."},
        {"zh": "我从树杈间穿过去。", "en": "I thread between the branches."},
        {"zh": "我绕着你的帽檐打转。", "en": "I circle the brim of your hat."},
        {"zh": "那具身体小，但很快。", "en": "Small body, but quick."},
        {"zh": "我悬在你后领上方。", "en": "I hover just above your collar."},
        {"zh": "我飞得不稳，但不停。", "en": "My flight's erratic, but constant."},
        {"zh": "我低飞到你的耳边。", "en": "I dip down by your ear."},
        {"zh": "我一寸寸逼近你的脖子。", "en": "Inch by inch, I close on your neck."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀声又细又烦。", "en": "My wingbeat is thin and maddening."},
        {"zh": "我的翅膀一直嗡嗡响。", "en": "My wings keep humming."},
        {"zh": "我停在蕨叶背面歇翅。", "en": "I rest on the underside of a fern leaf."},
        {"zh": "我在听有什么在动。", "en": "Listening for movement."},
        {"zh": "我的身体很小，很难打中。", "en": "I'm small and hard to hit."},
        {"zh": "这片林子里猎物很多。", "en": "Plenty of prey in this grove."},
        {"zh": "我慢慢地梳着腿。", "en": "I groom my legs slowly."},
        {"zh": "气味一直没变。", "en": "The smells haven't changed."},
        {"zh": "我等着谁落单。", "en": "Waiting for someone to stray."},
        {"zh": "我落在树皮上歇一会儿。", "en": "Resting on bark a moment."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有热味。", "en": "You carry a warm smell."},
        {"zh": "你站着不动，正好。", "en": "Standing still suits me."},
        {"zh": "我正绕着你飞。", "en": "I'm flying circles around you."},
        {"zh": "你挥手也打不到我。", "en": "Swatting won't reach me."},
        {"zh": "你的皮肤露在外面。", "en": "Your skin is exposed."},
        {"zh": "我贴在你耳边嗡鸣。", "en": "I buzz right beside your ear."},
        {"zh": "你听见嗡嗡声了吗？", "en": "Do you hear the buzzing?"},
        {"zh": "我落在你脖子上。", "en": "I land on your neck."},
        {"zh": "我想找个地方落脚。", "en": "I want somewhere to land."},
        {"zh": "你走这么快做什么。", "en": "Why walk so fast?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我这对小翅，绕着你转三圈了。", "en": "These little wings have circled you thrice."},
        {"zh": "我掉了一段高度。", "en": "I dropped some height."},
        {"zh": "我歪着飞开了。", "en": "I flew off crooked."},
        {"zh": "我被拍得斜着飞。", "en": "The swat sent me flying sideways."},
        {"zh": "我的腿有一根断了。", "en": "One of my legs snapped."},
        {"zh": "我的翅膀还能拍。", "en": "My wings can still beat."},
        {"zh": "我的嗡鸣声高了半度。", "en": "My buzzing rose half a tone."},
        {"zh": "我钻进苔藓缝里。", "en": "I slip into a crack in the moss."},
        {"zh": "翅破一边，我还能飞。", "en": "With one wing torn, I can still fly."},
        {"zh": "我再绕上一圈看看。", "en": "I'll circle once more and look."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那个东西是血吗？", "en": "Is that thing blood?"},
        {"zh": "我闻到血的腥气。", "en": "I smell the tang of blood."},
        {"zh": "我要温的、湿的。", "en": "I want something warm and wet."},
        {"zh": "别晃，我落不准。", "en": "Don't wave it. I can't land."},
        {"zh": "有伤口就更好了。", "en": "A wound would be even better."},
        {"zh": "我要温热的东西。", "en": "I want something warm."},
        {"zh": "拿走，这太干了。", "en": "Take it away. Too dry."},
        {"zh": "你手上有汗味。", "en": "Your hands smell of sweat."},
        {"zh": "我喜欢静止的东西。", "en": "I like things that stay still."},
        {"zh": "这点不够，我要更多。", "en": "Not enough. I want more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你打到了空气。", "en": "You hit empty air."},
        {"zh": "我从你手底下过去了。", "en": "I slipped under your hand."},
        {"zh": "我贴到了你的肩。", "en": "I've landed on your shoulder."},
        {"zh": "你的袖子把我扫开了。", "en": "Your sleeve swept me off."},
        {"zh": "我弹开，绕着树飞。", "en": "I spring away and circle the tree."},
        {"zh": "撞一下，我的翅都不抖。", "en": "One bump and my wings do not even quiver."},
        {"zh": "我从缝隙里钻过去了。", "en": "I slipped through the gap."},
        {"zh": "别拍，会拍到自己。", "en": "Don't swat. You'll hit yourself."},
        {"zh": "寄生蝇这么小，绕到你耳后。", "en": "A parasitic fly this small slips behind your ear."},
        {"zh": "你的巴掌追不上我。", "en": "Your palm cannot catch me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我目前只想找血。", "en": "Right now I only want blood."},
        {"zh": "这种事现在不重要。", "en": "That doesn't matter now."},
        {"zh": "你是猎物，不是同类。", "en": "You're prey, not my kind."},
        {"zh": "这个我不打算谈。", "en": "I don't mean to discuss that."},
        {"zh": "林子里的同类够多了。", "en": "There are plenty of my kind here."},
        {"zh": "我的时间都在飞。", "en": "My time is all spent flying."},
        {"zh": "我一振翅飞走了。", "en": "I beat my wings and left."},
        {"zh": "这问题让我烦。", "en": "That question annoys me."},
        {"zh": "我只管下一顿。", "en": "I only mind the next meal."},
        {"zh": "我落到别处去了。", "en": "I've settled elsewhere."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "太小了，没意思。", "en": "Too small. Not worth it."},
        {"zh": "这不流汁，我不要。", "en": "No juice in it. I'll pass."},
        {"zh": "我落上去看了看。", "en": "I landed on it to look."},
        {"zh": "它已经干透了。", "en": "It's dried right through."},
        {"zh": "我用腿抱不起来。", "en": "My legs can't lift it."},
        {"zh": "这个有点味道。", "en": "This one has some smell."},
        {"zh": "我从它上面飞过去。", "en": "I fly right over it."},
        {"zh": "不是血，我不要。", "en": "Not blood. I don't want it."},
        {"zh": "我在旁边绕了两圈。", "en": "I circled it twice."},
        {"zh": "我最后放弃了。", "en": "I gave up in the end."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我锁定了你的脖颈。", "en": "I've fixed on your neck."},
        {"zh": "这个距离我能一下到。", "en": "I can reach in one dash."},
        {"zh": "你的皮肤露得太多。", "en": "Too much skin is showing."},
        {"zh": "我绕到你的死角。", "en": "I've moved to your blind side."},
        {"zh": "你放下手之后最好。", "en": "Best right after you lower your hand."},
        {"zh": "你身上有一道伤口。", "en": "There's a wound on you."},
        {"zh": "我等你的动作停下。", "en": "I wait for you to stop moving."},
        {"zh": "嗡嗡声会盖住别的。", "en": "The buzzing covers other sounds."},
        {"zh": "你甩不掉我的。", "en": "You can't shake me off."},
        {"zh": "我要落在你的后颈。", "en": "I'll land on the back of your neck."},
        {"zh": "我停在你后颈的空气里。", "en": "I hover in the air behind your neck."},
        {"zh": "你的血在皮肤下面。", "en": "Your blood is right under the skin."},
        {"zh": "我把高度压低了。", "en": "I've dropped my altitude."},
        {"zh": "再近一点就落。", "en": "A little closer and I land."},
        {"zh": "这一针，你来不及躲。", "en": "This sting will come too fast to dodge."},
        {"zh": "你还在往那边走。", "en": "You're still walking that way."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我还在你周围。", "en": "I'm still around you."},
        {"zh": "我一下近，一下远。", "en": "Close, then far, then close."},
        {"zh": "你抬手想拍我？", "en": "Raising your hand to swat me?"},
        {"zh": "我从你视野外绕。", "en": "I circle outside your view."},
        {"zh": "你的呼吸声很大。", "en": "Your breathing is loud."},
        {"zh": "等你手腕垂下来。", "en": "I wait for your wrist to drop."},
        {"zh": "你往树边靠了。", "en": "You've moved toward the tree."},
        {"zh": "我的翅膀声变轻了。", "en": "My wingbeat has gone quiet."},
        {"zh": "你已经出汗了。", "en": "You're sweating now."},
        {"zh": "这个角度我能落上去。", "en": "I can land from this angle."},
        {"zh": "你还没发现我在这儿。", "en": "You haven't found me here."},
        {"zh": "我再绕上一圈。", "en": "One more circle."},
        {"zh": "你身边没有人帮你。", "en": "No one is beside you to help."},
        {"zh": "我贴着你的肩飞。", "en": "I'm flying along your shoulder."},
        {"zh": "你甩头也没用。", "en": "Shaking your head won't help."},
        {"zh": "我只差最后半尺。", "en": "I'm half a foot away."},
        {"zh": "你停下脚步了。", "en": "You stopped walking."},
        {"zh": "现在就是空隙。", "en": "This is the opening."},
        {"zh": "我要落在你衣领上。", "en": "I am going to land on your collar."},
        {"zh": "你会感觉到一下刺痛。", "en": "You'll feel one sharp sting."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬进你的皮肤。", "en": "I bite into your skin."},
        {"zh": "这一下很轻但很深。", "en": "Light, but it goes deep."},
        {"zh": "我叮在你的后颈。", "en": "I sting the back of your neck."},
        {"zh": "你拍到了自己。", "en": "You slapped yourself."},
        {"zh": "我叮完就弹开。", "en": "I sting and bounce away."},
        {"zh": "从伤口边上我又来一次。", "en": "I'm back at the wound's edge."},
        {"zh": "你甩头，我跟着。", "en": "You shake your head. I follow."},
        {"zh": "这一口留下了红点。", "en": "That left a red mark."},
        {"zh": "平原的寄生蝇，专挑手背。", "en": "A plains parasite fly picks the back of your hand."},
        {"zh": "你抓不到这么小的我。", "en": "You can't catch something this small."},
        {"zh": "我叮完就退开。", "en": "I sting and pull back."},
        {"zh": "你再挥手我就走。", "en": "Wave again and I'm gone."},
        {"zh": "这回咬到了衣领。", "en": "This time I got your collar."},
        {"zh": "我绕到另一边了。", "en": "I've moved to the other side."},
        {"zh": "你的血有点甜。", "en": "Your blood is a little sweet."},
        {"zh": "我要再来一下。", "en": "I'll take one more."},
        {"zh": "我用腿抓你的头发。", "en": "I grab your hair with my legs."},
        {"zh": "我钻进你的领口。", "en": "I slip inside your collar."},
        {"zh": "你一动我就换位置。", "en": "When you move, I switch spots."},
        {"zh": "这一下扎在你的耳后。", "en": "This one goes behind your ear."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我先停在叶上。", "en": "First I settle on a leaf."},
        {"zh": "这片平原很开阔。", "en": "This plain is wide open."},
        {"zh": "空气里有血的味道。", "en": "There's blood in the air."},
        {"zh": "我挑最高的那根枝。", "en": "I pick the highest branch."},
        {"zh": "我从林窗里穿过去。", "en": "I cut through a gap in the canopy."},
        {"zh": "我开始找落单的。", "en": "I start looking for strays."},
        {"zh": "嗡嗡声在林子里回响。", "en": "The buzz echoes in the woods."},
        {"zh": "我飞得很低，避开鸟。", "en": "I fly low to avoid the birds."},
        {"zh": "我在这棵树上歇脚。", "en": "I'm resting on this tree."},
        {"zh": "我发现了新鲜的汗味。", "en": "I've caught fresh sweat."},
        {"zh": "我先绕两圈看看。", "en": "Two circles to look first."},
        {"zh": "我还没选定目标。", "en": "I haven't chosen a target."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗一燎，我的翅膀卷了。", "en": "A lick of flame curled my wing."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉进了草丛里。", "en": "I dropped into the grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我的翅膀粘住了。", "en": "Water glued my wings down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我吹出很远。", "en": "The blast blew me far away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根细东西擦过我。", "en": "Something thin grazed me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我一阵眩晕。", "en": "That light left me dizzy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我好久没吸到血了。", "en": "I haven't fed in a long while."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照得我翅膀发麻。", "en": "The flash numbed my wings."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我往下掉，飞不动了。", "en": "Falling, and I can't fly."}
      ]
    }
  }
}
