{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我这么宽，走路很费劲", "en": "I'm this wide; walking is hard work."},
        {"zh": "整个身子一晃一晃", "en": "My whole body sways."},
        {"zh": "地上的草被我压平", "en": "The grass flattens under me."},
        {"zh": "我拖着肚子往前挪", "en": "I drag my belly forward."},
        {"zh": "我比门还宽", "en": "I'm wider than a door."},
        {"zh": "晶石长了满满一身", "en": "Crystals cover me entirely."},
        {"zh": "树挡住我，我绕一大圈", "en": "Trees block me; I go the long way."},
        {"zh": "每一步都很沉", "en": "Every step is heavy."},
        {"zh": "我走着，石头从我身上掉", "en": "Stones drop off me as I walk."},
        {"zh": "路太窄了，我过不去", "en": "The path is too narrow; I can't pass."},
        {"zh": "我慢慢地挪，你等着", "en": "I shift slowly; you wait."},
        {"zh": "我的影子能盖住一整片", "en": "My shadow covers a whole patch."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，像一块山岩", "en": "I stand like a crag."},
        {"zh": "身上的晶石碰在一起响", "en": "The crystals on me knock together."},
        {"zh": "我这么重，懒得动", "en": "I'm this heavy; I can't be bothered."},
        {"zh": "光在我身上散开", "en": "Light scatters across me."},
        {"zh": "大块晶石起伏，像在打瞌睡。", "en": "My great crystal bulk rises and falls, half asleep."},
        {"zh": "我在看地上一片小草", "en": "I'm looking at a patch of small grass."},
        {"zh": "这块地方被我占着了", "en": "This spot is taken by me."},
        {"zh": "我一个转身都要很久", "en": "Even turning takes me a while."},
        {"zh": "我身上的棱角有多有少", "en": "My facets are many and few."},
        {"zh": "这里有东西爬过我", "en": "Something crawled over me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我前面像根草", "en": "In front of me you're like a blade of grass."},
        {"zh": "你比我的爪子还小", "en": "You're smaller than my claw."},
        {"zh": "我转身要一阵子，别急", "en": "Turning takes me a while; don't rush."},
        {"zh": "我身上的晶石，别碰", "en": "Don't touch the crystals on me."},
        {"zh": "我盯着你，你也知道", "en": "I'm watching you, and you know it."},
        {"zh": "你的护甲对我没用", "en": "Your armor means nothing to me."},
        {"zh": "我抬起脚，你就该走了", "en": "When I lift a foot, you should go."},
        {"zh": "我慢慢来，但不会停", "en": "I'm slow, but I don't stop."},
        {"zh": "你这么小，我差点没看见", "en": "So small I nearly missed you."},
        {"zh": "我看着你，是因为你在我前面", "en": "I look at you because you're in my way."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了一步，地都陷了", "en": "I took a step back and the ground sank."},
        {"zh": "身上的晶石掉了几块", "en": "A few crystals fell off me."},
        {"zh": "这一下打在我壳上", "en": "That hit my shell."},
        {"zh": "我歪了一点，正回来", "en": "I tilted a bit and righted."},
        {"zh": "我很重，不容易倒", "en": "I'm heavy and hard to topple."},
        {"zh": "碎屑从我身上落", "en": "Fragments fall off me."},
        {"zh": "你还得多打几下", "en": "You'll need more hits than that."},
        {"zh": "疼是很久以后才来的", "en": "The pain comes much later."},
        {"zh": "碎了一角，我照样立着。", "en": "A corner chips off; still I stand."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃，我吃石头", "en": "I don't eat; I eat stone."},
        {"zh": "你手里那块太软", "en": "That in your hand is too soft."},
        {"zh": "我要的是晶石", "en": "I want crystal."},
        {"zh": "这个不够沉", "en": "Not heavy enough."},
        {"zh": "你放下就走", "en": "Put it down and go."},
        {"zh": "我不稀罕", "en": "I don't care for that."},
        {"zh": "石头比这个有味道", "en": "Stone has more flavor."},
        {"zh": "你的东西我不拿", "en": "I won't take your things."},
        {"zh": "这块太小", "en": "This is too small."},
        {"zh": "留着吧", "en": "Keep it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，像撞墙", "en": "You hit me like a wall."},
        {"zh": "你被推回来了", "en": "You were shoved back."},
        {"zh": "退开，晶棱会划伤你。", "en": "Back off. My crystal edges will cut you."},
        {"zh": "我挪了半天，才移一步", "en": "I shifted forever to move one step."},
        {"zh": "这一下，我的晶石掉了一块", "en": "A crystal fell off me."},
        {"zh": "你踩上的不是石头，是我的脚。", "en": "That is not a rock you stepped on. It is my foot."},
        {"zh": "我不躲，我太重", "en": "I don't dodge; I'm too heavy."},
        {"zh": "我退不了，只能转", "en": "I can't retreat; I can only turn."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这么大，找伴很难", "en": "Being this big makes pairing hard."},
        {"zh": "同类在很远的地方", "en": "My kind are far away."},
        {"zh": "这种话我不太会回应", "en": "I'm not good at answering that."},
        {"zh": "我身上的晶石会自己长", "en": "My crystals grow on their own."},
        {"zh": "这事不重要", "en": "That doesn't matter."},
        {"zh": "别问了", "en": "Stop asking."},
        {"zh": "我一个就够占地方", "en": "I take up enough room alone."},
        {"zh": "山那边的回声是同类吗", "en": "Is that echo from the hills one of mine?"},
        {"zh": "不像", "en": "It doesn't seem so."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块石头正合我意", "en": "This stone suits me."},
        {"zh": "晶爪压住那件小东西，收进缝里。", "en": "My crystal claws pin the little thing and tuck it into a seam."},
        {"zh": "我捡起来很慢", "en": "I pick it up slowly."},
        {"zh": "这玩意儿太小", "en": "Too small."},
        {"zh": "地上那些，我一块块收", "en": "I gather those on the ground one by one."},
        {"zh": "我不弯腰，我蹲下", "en": "I don't bend; I crouch."},
        {"zh": "它陷进我的壳里了", "en": "It sank into my shell."},
        {"zh": "这个不够硬", "en": "Not hard enough."},
        {"zh": "掉的东西都归我", "en": "Fallen things are mine."},
        {"zh": "我没地方放", "en": "I've nowhere to put it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我前面", "en": "You're standing in front of me."},
        {"zh": "这么小的目标，我也看得见", "en": "Even a target this small, I can see."},
        {"zh": "转身要花点时间", "en": "Turning will take some time."},
        {"zh": "我先挪到你那边", "en": "I'll shift over to your side."},
        {"zh": "这一片都归我看守", "en": "I watch over this whole patch."},
        {"zh": "有声音，从我脚边", "en": "A sound, by my feet."},
        {"zh": "你退了几步，还在", "en": "You stepped back a few and you're still there."},
        {"zh": "距离不重要，我够大", "en": "Distance hardly matters; I'm big."},
        {"zh": "就你一个", "en": "Just you."},
        {"zh": "这块地方我守着", "en": "I keep this ground."},
        {"zh": "你在我的范围里", "en": "You're inside my reach."},
        {"zh": "我准备好了", "en": "I'm ready."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "每挪一步，地面都轻轻震。", "en": "Each step of mine makes the ground tremble."},
        {"zh": "我抬脚要很久", "en": "Lifting my foot takes ages."},
        {"zh": "我的步子很响", "en": "My steps are loud."},
        {"zh": "你在石头后面，挡不住", "en": "A stone won't hide you."},
        {"zh": "我再挪半步", "en": "Half a step more."},
        {"zh": "你的呼吸我听不见，但看得见", "en": "I can't hear your breath, but I see it."},
        {"zh": "这一片地我熟", "en": "I know this ground."},
        {"zh": "我压低身子，很难看", "en": "I lower myself; it's ugly."},
        {"zh": "你走到我侧边了", "en": "You've come to my flank."},
        {"zh": "那边我也够得着", "en": "I can reach there too."},
        {"zh": "晶石在响", "en": "The crystals are ringing."},
        {"zh": "我只转半圈", "en": "I turn half a circle."},
        {"zh": "地都在震", "en": "The ground shakes."},
        {"zh": "你再退就出不了这片", "en": "Back up more and you're out of this patch."},
        {"zh": "就在这儿", "en": "Right here."},
        {"zh": "我抬起前爪", "en": "I lift a forepaw."},
        {"zh": "我转过庞大的晶身，朝你挪。", "en": "I turn my vast crystal body and shift toward you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "前爪拍下去", "en": "A forepaw slams down."},
        {"zh": "整个身子压上", "en": "My whole body presses down."},
        {"zh": "你被拍进土里", "en": "You're driven into the soil."},
        {"zh": "晶石刮到你", "en": "The crystals scraped you."},
        {"zh": "我动作慢，可我不需要快", "en": "I'm slow, and I don't need speed."},
        {"zh": "我用晶臂把你扫到岩壁上。", "en": "My crystal arm sweeps you into the rock wall."},
        {"zh": "地被我拍出一个坑", "en": "My strike leaves a pit."},
        {"zh": "它退了，我没追", "en": "It retreated; I didn't follow."},
        {"zh": "这一下之后，我喘了", "en": "After that, I panted."},
        {"zh": "我抬起另一只爪", "en": "I raise the other forepaw."},
        {"zh": "你还在动", "en": "You're still moving."},
        {"zh": "我再压一次", "en": "I press again."},
        {"zh": "身上的碎石掉了一地", "en": "Rubble falls off me."},
        {"zh": "你被挤在石头和墙之间", "en": "You're wedged between stone and wall."},
        {"zh": "我转过身，背对你", "en": "I turn my back to you."},
        {"zh": "这一下够重", "en": "That was heavy enough."},
        {"zh": "我没打算停", "en": "I don't plan to stop."},
        {"zh": "你再站一次", "en": "Stand up once more."},
        {"zh": "我等着", "en": "I wait."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地面先裂开，我才出来", "en": "The ground cracked first, then I came out."},
        {"zh": "我这么大，站都站不稳", "en": "Being this big, I can barely stand."},
        {"zh": "身上的晶石刚长齐", "en": "The crystals on me just finished growing."},
        {"zh": "这一片被我占了", "en": "I've taken this patch."},
        {"zh": "我落地，尘土飞扬", "en": "I land and dust billows."},
        {"zh": "有个声音在下面响", "en": "A sound echoes beneath me."},
        {"zh": "我慢慢抬头", "en": "I raise my head slowly."},
        {"zh": "地上的影子一下子宽了", "en": "My shadow widened suddenly."},
        {"zh": "我不是自然出来的", "en": "I didn't come naturally."},
        {"zh": "我站稳了，用了很久", "en": "Standing steady took a long while."},
        {"zh": "这里够不够宽", "en": "Is this wide enough?"},
        {"zh": "我抖了抖，碎屑落下", "en": "I shake and fragments fall."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的壳，裂了几道", "en": "Fire baked my shell and cracked it."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我其实没掉下去，是地塌了", "en": "I didn't fall; the ground gave way."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水淹不过我，只是很凉", "en": "Water can't swallow me; it's only cold."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸掉了我半身晶石", "en": "The blast took half my crystals."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭弹在晶石上，叮一声", "en": "The arrow pinged off a crystal."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，我整身都在亮", "en": "The spell hit and my whole body glowed."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我吃石头，不吃别的", "en": "I eat stone, nothing else."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我背上，晶石全亮", "en": "Lightning struck my back and every crystal blazed."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有地，我沉下去", "en": "No ground in the void; I sink."}
      ]
    }
  }
}
