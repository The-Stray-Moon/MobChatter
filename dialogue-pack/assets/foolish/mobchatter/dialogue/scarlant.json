{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着一队同类穿过田野", "en": "I cross the field with a column of my kind."},
        {"zh": "六条腿踩在干草上", "en": "Six legs on dry grass."},
        {"zh": "我们走成一条长长的线", "en": "We walk in one long line."},
        {"zh": "红色的壳在红光里", "en": "Red shells in the red light."},
        {"zh": "前面那只停，我也停", "en": "The one ahead stops; I stop."},
        {"zh": "我们走过猩红的草", "en": "We pass through crimson grass."},
        {"zh": "触角互相碰一下", "en": "Our antennae touch."},
        {"zh": "地上留下了细碎的痕", "en": "We leave fine tracks."},
        {"zh": "队伍的尾巴还在很远", "en": "The tail of the column is far behind."},
        {"zh": "我不看路，我跟着味道", "en": "I do not watch the path; I follow scent."},
        {"zh": "风把草压低，我们在里面", "en": "The wind flattens the grass; we move within."},
        {"zh": "一群二十只，走得整整齐齐", "en": "Twenty of us, walking in order."},
        {"zh": "我的颚一直动着", "en": "My mandibles keep working."},
        {"zh": "我们绕着田地外沿走", "en": "We skirt the field's outer edge."},
        {"zh": "中间那只负责带路", "en": "The one in the middle leads."},
        {"zh": "我们的气味是一条线", "en": "Our scent makes one line."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一群挤在一起", "en": "We crowd together as a group."},
        {"zh": "触角在空气里画圈", "en": "Antennae trace circles in the air."},
        {"zh": "我在等前面的信号", "en": "I wait for a signal from the front."},
        {"zh": "猩红的草很软", "en": "The crimson grass is soft."},
        {"zh": "我们的壳互相靠着", "en": "Our shells press together."},
        {"zh": "这里刚刚什么都没发生", "en": "Nothing just happened here."},
        {"zh": "土地被我们踩实了", "en": "The ground is packed by us."},
        {"zh": "我慢慢晃了晃触角", "en": "I wave my antennae slowly."},
        {"zh": "我数了一下，少了三只", "en": "Three are missing from my count."},
        {"zh": "我们谁也没动", "en": "None of us moved."},
        {"zh": "我清理了一下前腿", "en": "I clean a foreleg."},
        {"zh": "远处有同伴在挖土", "en": "A comrade digs in the distance."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀在你脸边嗡嗡响。", "en": "My wings buzz beside your face."},
        {"zh": "我闻到你的味道是新的", "en": "Your smell is new."},
        {"zh": "我的触角伸向你", "en": "My antennae reach toward you."},
        {"zh": "你为什么一个人来", "en": "Why do you come alone?"},
        {"zh": "我看了你,又看同伴", "en": "I look at you, then at my companions."},
        {"zh": "我们没有敌意，暂时", "en": "We mean no harm. For now."},
        {"zh": "你手上没有武器", "en": "Your hands hold no weapon."},
        {"zh": "你在往前走，我们就退", "en": "You step forward; we step back."},
        {"zh": "这块地里没有你这样的东西", "en": "Nothing like you belongs in this field."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退开，同伴补上", "en": "I fall back; a comrade takes my place."},
        {"zh": "壳上有一块裂", "en": "A crack in my shell."},
        {"zh": "我在地上翻了半圈", "en": "I roll half over."},
        {"zh": "几条腿使不上力", "en": "Several legs will not work."},
        {"zh": "我的触角折了一截", "en": "One antenna is snapped."},
        {"zh": "队伍一步没停", "en": "The column did not stop."},
        {"zh": "我依然跟得上", "en": "I can still keep up."},
        {"zh": "这只是我一只的事", "en": "This is only my own trouble."},
        {"zh": "同伴把我顶起来", "en": "A comrade props me up."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那点东西", "en": "That small thing in your hand."},
        {"zh": "我们闻到了，但不动", "en": "We smell it, and do not move."},
        {"zh": "你举着它，站得很僵", "en": "You hold it up, standing stiff."},
        {"zh": "一只只敢靠近的", "en": "The one who is boldest approaches."},
        {"zh": "它在我们的地界外面", "en": "It lies outside our bounds."},
        {"zh": "你放下，我们就松口", "en": "Put it down and we will relent."},
        {"zh": "一点东西喂不了我们一群", "en": "One morsel will not feed the group."},
        {"zh": "你的手不要抖", "en": "Stop trembling your hand."},
        {"zh": "谁也不许先上", "en": "No one is to go first."},
        {"zh": "你在旁边看着就行", "en": "Just watching will do."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞进来，队形乱了", "en": "Your impact breaks our formation."},
        {"zh": "我们一下子散开又聚起", "en": "We scatter and re-form."},
        {"zh": "几只围到你两侧", "en": "Several of us move to your flanks."},
        {"zh": "我被推得转了半圈", "en": "I am spun half around."},
        {"zh": "队伍在后面发出响声", "en": "The column behind rattles."},
        {"zh": "你踩到了我的同伴", "en": "You stepped on a comrade."},
        {"zh": "我们一起往前挤", "en": "We crowd forward together."},
        {"zh": "壳碰壳，声音很密", "en": "Shell on shell, a dense sound."},
        {"zh": "这一撞让队伍停了", "en": "That stopped the column."},
        {"zh": "我们不会让路", "en": "We do not give way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们只有一只雌的", "en": "There is only one female among us."},
        {"zh": "我们围绕着她转", "en": "We circle around her."},
        {"zh": "谁靠太近，谁就被赶", "en": "Whoever comes too near gets driven off."},
        {"zh": "队伍比什么都重", "en": "The colony comes first."},
        {"zh": "我们共用一个巢", "en": "We share one nest."},
        {"zh": "我们之间的信号很细", "en": "Our signals are subtle."},
        {"zh": "触角碰一下，意思就传开", "en": "One antenna touch spreads the meaning."},
        {"zh": "我们没有别的打算", "en": "We have no other intentions."},
        {"zh": "这里的地是我们守的", "en": "This ground is ours to hold."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前颚夹起来", "en": "I take it in my mandibles."},
        {"zh": "我们几只一起搬", "en": "Several of us carry it together."},
        {"zh": "太重了，得再来几只", "en": "Too heavy; we need more of us."},
        {"zh": "这是从田里掉出来的", "en": "This fell from the field."},
        {"zh": "我把这东西顶在头上。", "en": "I balance this on my head."},
        {"zh": "它卡在草根间", "en": "It is wedged in the grass roots."},
        {"zh": "我们把它拖回巢", "en": "We drag it back toward the nest."},
        {"zh": "有东西挡着搬不动", "en": "Something blocks the load."},
        {"zh": "谁掉了这个东西", "en": "Who dropped this?"},
        {"zh": "我们分开来搬", "en": "We share the carrying."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你动了我们的人", "en": "You touched one of ours."},
        {"zh": "整个队伍都停下来了", "en": "The whole column has halted."},
        {"zh": "触角一起转向你", "en": "Every antenna turns to you."},
        {"zh": "我们先围，再动手", "en": "We surround first, then strike."},
        {"zh": "队形正在展开", "en": "The formation is spreading."},
        {"zh": "一起上，这是规矩", "en": "Together, that is the rule."},
        {"zh": "你最好不要动", "en": "Best if you do not move."},
        {"zh": "已经等了很久", "en": "Long awaited."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着队伍绕你", "en": "I move around you with the column."},
        {"zh": "你每一次转身都慢", "en": "Every turn you make is slow."},
        {"zh": "我们分成三路", "en": "We split three ways."},
        {"zh": "草很高，我们很低", "en": "The grass is tall; we are low."},
        {"zh": "我们从四面来", "en": "We come from all sides."},
        {"zh": "队形收得更紧", "en": "The formation drew in."},
        {"zh": "我们没有谁怕你", "en": "None of us fears you."},
        {"zh": "我们都在同一口气里", "en": "We move on one breath."},
        {"zh": "你已经退到地头了", "en": "You have reached the field's headland."},
        {"zh": "我们人数比你多", "en": "We outnumber you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我先咬你的脚踝", "en": "I bite your ankle first."},
        {"zh": "几只一起扑上来", "en": "Several of us leap at once."},
        {"zh": "这一下咬在护腿上", "en": "That bite hit your leg guard."},
        {"zh": "颚很小，但很多", "en": "Small jaws, but many."},
        {"zh": "你甩开了两只", "en": "You threw off two of us."},
        {"zh": "我们从下面爬上去", "en": "We climb up from below."},
        {"zh": "我的同伴跟着我上", "en": "My comrades follow me up."},
        {"zh": "你被咬的地方发麻", "en": "The bitten spot goes numb."},
        {"zh": "我再一次贴上去", "en": "I press in again."},
        {"zh": "队形一点没散", "en": "The formation holds."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一群从红光里出来", "en": "We come out of the red glow as a group."},
        {"zh": "队伍从田边开始", "en": "The column begins at the field edge."},
        {"zh": "我是第二十只", "en": "I am the twentieth."},
        {"zh": "触角互相碰过，就算认识", "en": "Antennae touched; that counts as knowing."},
        {"zh": "我们排好了先后", "en": "We have settled our order."},
        {"zh": "前面的那只起了步", "en": "The one in front set off."},
        {"zh": "我踩着前一只的痕走", "en": "I step in the tracks ahead."},
        {"zh": "我们的气味留在地上", "en": "Our scent stays on the ground."},
        {"zh": "我张开颚，试了试", "en": "I open my mandibles and test them."},
        {"zh": "十九只在等我", "en": "Nineteen are waiting for me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我的壳，卷起来", "en": "Fire scorches my shell, and it curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从草叶上摔下来", "en": "I fall off a grass blade."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我和同伴冲开", "en": "Water separates me from the group."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把整队掀翻", "en": "The blast flips the whole column."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎穿了我的腹", "en": "Something pierces my abdomen."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那力量让我队伍乱了", "en": "That force breaks our formation."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我咬自己的腿", "en": "Hungry enough to bite my own leg."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打到地上，队伍全散", "en": "Lightning strikes and the column scatters."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有队伍也没有地", "en": "No colony here, and no ground."}
      ]
    }
  }
}
