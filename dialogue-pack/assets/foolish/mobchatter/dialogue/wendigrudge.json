{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着庞大的身体走。", "en": "I drag my enormous body forward."},
        {"zh": "我一步就压塌一段墙。", "en": "One step collapses a stretch of wall."},
        {"zh": "我的影子盖住了整条路。", "en": "My shadow covers the whole path."},
        {"zh": "我的手指扫过树梢。", "en": "My fingers sweep the treetops."},
        {"zh": "我走过的地方地面下沉。", "en": "The ground sinks where I pass."},
        {"zh": "我的角刮到了岩石。", "en": "My horns scrape the rock."},
        {"zh": "我的呼吸让雾更浓。", "en": "My breath thickens the fog."},
        {"zh": "转身要很久，你等得起吗？", "en": "Turning takes a while — can you wait?"},
        {"zh": "我迈步时整片林子都响。", "en": "The whole wood rings when I step."},
        {"zh": "我朝那点火光走。", "en": "I head for that firelight."},
        {"zh": "我一点也不赶路。", "en": "I'm not rushing."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，像一座山。", "en": "I stand like a mountain."},
        {"zh": "我的手垂到地面。", "en": "My hands hang to the ground."},
        {"zh": "雪落在我的肩上不化。", "en": "Snow on my shoulders doesn't melt."},
        {"zh": "我低头看着脚下的树。", "en": "I look down at the trees at my feet."},
        {"zh": "我等它自己走近。", "en": "I wait for it to come close."},
        {"zh": "这里没有任何东西能挡住我。", "en": "Nothing here can stop me."},
        {"zh": "我把重心挪了挪。", "en": "I shift my weight."},
        {"zh": "远处有很小的声音。", "en": "There's a very small sound far off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你连我的手掌都不到。", "en": "You don't even reach my palm."},
        {"zh": "我垂眼俯视着你。", "en": "I look down at you."},
        {"zh": "你要在我脚下站多久？", "en": "How long will you stand at my feet?"},
        {"zh": "我的名字被山记住了。", "en": "The mountain remembers my name."},
        {"zh": "你身上有一点光。", "en": "There's a little light on you."},
        {"zh": "我不需要用手打你。", "en": "I needn't use my hands on you."},
        {"zh": "这片土地的重压是我的。", "en": "The weight of this land is mine."},
        {"zh": "你听见我呼吸了吗？", "en": "Do you hear me breathe?"},
        {"zh": "我走近一步就够。", "en": "One step from me is enough."},
        {"zh": "你整个人在发抖。", "en": "You're shaking."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮上有一道痕。", "en": "A mark shows on my hide."},
        {"zh": "这一下不够看。", "en": "That's not nearly enough."},
        {"zh": "我的身子晃了一下。", "en": "I swayed once."},
        {"zh": "没有血，我只觉得冷。", "en": "No blood — I only feel cold."},
        {"zh": "你的刀刃砍在我岩皮上，滑开了。", "en": "Your blade slid off my stone hide."},
        {"zh": "岩层一样的皮也破了。", "en": "Even hide like strata can split."},
        {"zh": "我的手指握紧了。", "en": "My fingers clench."},
        {"zh": "我不生气，只是记下。", "en": "I'm not angry; I only note it."},
        {"zh": "你再试一次给我看。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那点东西不值得我碰。", "en": "That isn't worth my touch."},
        {"zh": "你举着它，像举一粒沙。", "en": "You hold it up like a grain of sand."},
        {"zh": "这么小一口，不值得我弯腰。", "en": "Too small a bite to bend over for."},
        {"zh": "你把它搁到地上。", "en": "Set it on the ground."},
        {"zh": "它对我来说什么都不是。", "en": "It means nothing to me."},
        {"zh": "别给我摆什么供品。", "en": "I need no offerings."},
        {"zh": "这点东西你带走。", "en": "Keep it."},
        {"zh": "我看不见那么小的东西。", "en": "I can't see anything that small."},
        {"zh": "这点把戏太无趣。", "en": "Pointless."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上来我毫无所觉。", "en": "I barely felt it."},
        {"zh": "你被弹开了一段。", "en": "You were thrown back a distance."},
        {"zh": "我的皮像岩层。", "en": "My hide is like strata."},
        {"zh": "我往旁边让开半步。", "en": "I give half a step."},
        {"zh": "你根本挡不住我。", "en": "You can't stop me."},
        {"zh": "这一下地面都陷了。", "en": "The ground sank from that."},
        {"zh": "我从你上面跨过去。", "en": "I step over you."},
        {"zh": "你给我走远一点。", "en": "Get farther off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这事情与我无关。", "en": "That's none of my concern."},
        {"zh": "我这副身体太大了。", "en": "I'm far too large."},
        {"zh": "这不会有什么结果。", "en": "Nothing would come of it."},
        {"zh": "我连转身都费劲。", "en": "I can hardly turn."},
        {"zh": "你离开这里吧。", "en": "Go."},
        {"zh": "我不谈这些事情。", "en": "I don't discuss such things."},
        {"zh": "我只想让这片地安静。", "en": "I only want this land quiet."},
        {"zh": "别在我脚下停。", "en": "Don't linger at my feet."},
        {"zh": "你给我退到一边去。", "en": "Move along."},
        {"zh": "用不着再说了。", "en": "Say no more."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我看不清那么小的东西。", "en": "I can't make out anything so small."},
        {"zh": "我碰一下就碎了。", "en": "One touch and it breaks."},
        {"zh": "我不吃，只是来杀。", "en": "I'm not here to eat, only to kill."},
        {"zh": "它卡在我指缝里。", "en": "It's stuck between my fingers."},
        {"zh": "我随手把它扔了。", "en": "I dropped it."},
        {"zh": "它只有指甲盖那么大。", "en": "Too small."},
        {"zh": "就把它搁在那里吧。", "en": "Leave it where it is."},
        {"zh": "它被我的手指压扁了。", "en": "My finger flattened it."},
        {"zh": "你把它捡走吧。", "en": "You take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经转向你了。", "en": "I've turned toward you."},
        {"zh": "我根本用不着跑。", "en": "I needn't run."},
        {"zh": "你抬头看也看不清。", "en": "Looking up won't let you see it all."},
        {"zh": "我慢慢举起手。", "en": "I raise a hand slowly."},
        {"zh": "你想往哪里逃？", "en": "Where would you flee?"},
        {"zh": "你踩的这块地是我的。", "en": "The ground you stand on is mine."},
        {"zh": "我只要来一下。", "en": "One blow is enough."},
        {"zh": "别站在开阔地。", "en": "Don't stand in the open."},
        {"zh": "我已经听见你了。", "en": "I hear you."},
        {"zh": "你实在太轻了。", "en": "You're very light."},
        {"zh": "我这就走到你面前。", "en": "I'm coming."},
        {"zh": "你在原地站住了。", "en": "Stand firm."},
        {"zh": "就在这一片地上。", "en": "Here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步就跨过半个林子。", "en": "One step crosses half the woods."},
        {"zh": "凭你的腿跑不了多远。", "en": "Speed won't help you."},
        {"zh": "三格高的影子，一直罩着你。", "en": "A three-block shadow keeps covering you."},
        {"zh": "我拖着步子压上来。", "en": "I bear down slowly."},
        {"zh": "你的脚印我看得见。", "en": "I can see your prints."},
        {"zh": "我抬手就能扫平一片。", "en": "One sweep of my hand levels the area."},
        {"zh": "你在不停喘气。", "en": "You're panting."},
        {"zh": "再退就是山壁。", "en": "Further back is the cliff."},
        {"zh": "我来回看了两次。", "en": "I looked twice."},
        {"zh": "山壁上那道影子，就是我。", "en": "That shape on the cliff face is me."},
        {"zh": "你身上那点光很显眼。", "en": "That little light on you stands out."},
        {"zh": "这道震动是我。", "en": "That tremor is me."},
        {"zh": "这是最后一步。", "en": "The last step."},
        {"zh": "我已经站到这一步。", "en": "I've reached you."},
        {"zh": "把头给我低下来。", "en": "Bow your head."},
        {"zh": "就这样不要动。", "en": "Just so."},
        {"zh": "你用不着发抖。", "en": "No need to fear."},
        {"zh": "很快就会结束。", "en": "It's quick."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一脚踏下去。", "en": "I bring my foot down."},
        {"zh": "地面被我踩裂了。", "en": "The ground splits."},
        {"zh": "我的手扫倒了一排树。", "en": "My hand fells a row of trees."},
        {"zh": "你被震得站不住。", "en": "The shock knocks you off your feet."},
        {"zh": "你被抛到半空。", "en": "You were thrown into the air."},
        {"zh": "我的手指擦过你头顶。", "en": "My fingers brushed over your head."},
        {"zh": "岩石被踩成了粉。", "en": "Rock crumbled to powder."},
        {"zh": "你居然还在这里？", "en": "Still there?"},
        {"zh": "不会再有下一回。", "en": "There's no second warning."},
        {"zh": "我的手抬起来，寒气先到。", "en": "My hand rises, and the cold arrives first."},
        {"zh": "这次会压到底。", "en": "This time I press all the way."},
        {"zh": "就这样结束吧。", "en": "Let it end here."},
        {"zh": "你实在太渺小。", "en": "You're so small."},
        {"zh": "我几乎看不见你。", "en": "I can hardly see you."},
        {"zh": "风都被我推开了。", "en": "I pushed the wind aside."},
        {"zh": "地面沉了三格。", "en": "The ground sank three blocks."},
        {"zh": "这一切都完了。", "en": "Done."},
        {"zh": "终于安静下来了。", "en": "Quiet now."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从山雾里站起来。", "en": "I rise out of the mountain mist."},
        {"zh": "我的肩擦过云。", "en": "My shoulders brush the clouds."},
        {"zh": "林子在我脚下显得很小。", "en": "The woods look small at my feet."},
        {"zh": "我落地时地面一震。", "en": "The ground shakes when I land."},
        {"zh": "这里是我的地界。", "en": "This is my domain."},
        {"zh": "雪在我脚边化开。", "en": "Snow melts at my feet."},
        {"zh": "雪地里，我慢慢直起背。", "en": "In the snow, I straighten up slowly."},
        {"zh": "我呼出的气成了雾。", "en": "My breath becomes fog."},
        {"zh": "远处有一点光。", "en": "A small light far off."},
        {"zh": "我听见很小的声音。", "en": "I hear a very small sound."},
        {"zh": "我在找那个声音。", "en": "I'm looking for that sound."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在山雾里烧，我的皮发烫。", "en": "Fire burns in the mist; my hide grows hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒下去，压断了一片树。", "en": "I fell and crushed a swath of trees."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到我的胸口，我还在往下。", "en": "Water reaches my chest, still rising."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的皮掀开一道口子。", "en": "The blast opened a gash in my hide."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉在我的肩上。", "en": "Something stuck in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量在我体内回响。", "en": "That force echoes inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这片地已经没什么可给我的了。", "en": "This land gives me nothing more."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我身上，我僵了一瞬。", "en": "Lightning struck me; I locked for an instant."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的地整片塌下去。", "en": "The ground fell away entirely."}
      ]
    }
  }
}
