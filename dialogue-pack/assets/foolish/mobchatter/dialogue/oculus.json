{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在下界的荒地上。", "en": "I drift over the nether wastes."},
        {"zh": "身下的热气把我托起来。", "en": "Heat from below holds me up."},
        {"zh": "我慢慢滑过岩浆边。", "en": "I glide past the lava's edge."},
        {"zh": "我的影子落在焦土上。", "en": "My shadow falls on scorched earth."},
        {"zh": "四处都是红的，正好。", "en": "Everything's red here. Good."},
        {"zh": "我移过一片熔岩湖。", "en": "I pass over a lava lake."},
        {"zh": "我飘过岩浆，影子投在岩壁。", "en": "I drift over the lava, my shadow cast on the wall."},
        {"zh": "我在找一个好角度。", "en": "Looking for a good angle."},
        {"zh": "热风把我的轮廓吹动。", "en": "Hot wind ripples my outline."},
        {"zh": "我向前飘了一小段。", "en": "I drift forward a little."},
        {"zh": "我绕着石柱转过去。", "en": "I round a basalt pillar."},
        {"zh": "空气在我周围扭曲。", "en": "The air warps around me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "下界荒地上，我盯着你。", "en": "Over the nether wastes, I watch you."},
        {"zh": "我在看着整片荒地。", "en": "I'm watching the whole waste."},
        {"zh": "热浪一层层撞上我。", "en": "Waves of heat break against me."},
        {"zh": "我慢慢地转动。", "en": "I rotate slowly."},
        {"zh": "下界荒地的高处，我飘着。", "en": "I drift high over the Nether wastes."},
        {"zh": "我等着有人抬头。", "en": "Waiting for someone to look up."},
        {"zh": "硫磺的味道很浓。", "en": "The smell of sulphur is thick."},
        {"zh": "我的巨眼映着火光。", "en": "My great eye reflects the firelight."},
        {"zh": "这块地方视野很好。", "en": "This spot has a fine view."},
        {"zh": "我一直在缓慢地漂移。", "en": "I keep drifting, slow and steady."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在看那边。", "en": "I've been watching that way."},
        {"zh": "我们隔得太远了。", "en": "We're far too far apart."},
        {"zh": "我这一只大眼，看得比谁都远。", "en": "This one great eye sees farther than any."},
        {"zh": "这里的空气对你不好。", "en": "This air is bad for you."},
        {"zh": "我就悬在你的上方。", "en": "I'm hovering right above you."},
        {"zh": "风声里，我在你上面。", "en": "In that wind sound, I am above you."},
        {"zh": "你走得实在太急了。", "en": "You're walking far too fast."},
        {"zh": "你还抬头了，很好。", "en": "You looked up. Good."},
        {"zh": "我很少碰到会看我的人。", "en": "Few look at me."},
        {"zh": "你要不要上来看看？", "en": "Care to come up and see?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的边缘散了又聚。", "en": "My edges scattered and re-formed."},
        {"zh": "我往后退出几尺。", "en": "I've withdrawn several feet."},
        {"zh": "光在我身上抖动。", "en": "The light shivers across me."},
        {"zh": "这一下让我歪了一点。", "en": "That tilted me a little."},
        {"zh": "我浮得没那么稳了。", "en": "I'm hovering less steadily."},
        {"zh": "我这么高的身子，飘在荒地上。", "en": "This tall body drifts over the wastes."},
        {"zh": "热浪把我的形状搅乱。", "en": "The heat muddles my shape."},
        {"zh": "我慢慢把自己转正。", "en": "I slowly right myself."},
        {"zh": "别以为这样就够了。", "en": "Don't think that's enough."},
        {"zh": "我到现在还没有散。", "en": "I still haven't come apart."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我连岩浆都不喝。", "en": "I do not even drink lava."},
        {"zh": "把那东西拿开。", "en": "Take that thing away."},
        {"zh": "我没有胃，也不会饿。", "en": "I have no stomach and never go hungry."},
        {"zh": "你手里有热的东西。", "en": "You're holding something hot."},
        {"zh": "那股味道让我不舒服。", "en": "That smell bothers me."},
        {"zh": "这些对我也没用。", "en": "These are useless to me."},
        {"zh": "我更喜欢它在燃烧。", "en": "I'd like it better burning."},
        {"zh": "东西留下，人走开。", "en": "Leave the thing. Walk away."},
        {"zh": "我看它像一块石头。", "en": "It looks like a stone to me."},
        {"zh": "我从来不需要进食。", "en": "I've never needed to feed."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了空气。", "en": "You hit empty air."},
        {"zh": "我浮得比你高。", "en": "I float above you."},
        {"zh": "我升高半格避开你。", "en": "I rise half a block to avoid you."},
        {"zh": "别用手往上够。", "en": "Don't reach upward."},
        {"zh": "我们之间还有距离。", "en": "There's still distance between us."},
        {"zh": "我的身体不实。", "en": "My body isn't solid."},
        {"zh": "你从下面过去了。", "en": "You passed underneath."},
        {"zh": "我低了一点，又升回去。", "en": "I dipped lower, then rose again."},
        {"zh": "这里的热气推了我一把。", "en": "A gust of heat pushed me off."},
        {"zh": "再近一步，我就开火。", "en": "One step closer and I open fire."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是在这里飘着。", "en": "I only drift here."},
        {"zh": "我的眼睛不为此睁开。", "en": "My eye does not open for such things."},
        {"zh": "两只眼，正好对上。", "en": "Two eyes, meeting just right."},
        {"zh": "你问的这个问题很怪。", "en": "That's a peculiar question."},
        {"zh": "下界里没有这些。", "en": "There's no such thing in the Nether."},
        {"zh": "我只是一只眼睛。", "en": "I'm only an eye."},
        {"zh": "我慢慢飘走了。", "en": "I drifted slowly away."},
        {"zh": "别拿这个来搭话。", "en": "Don't use that to start a conversation."},
        {"zh": "我只看着下面的火。", "en": "I only watch the fire below."},
        {"zh": "我只想看着火。", "en": "I only want to watch the fire."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用一股热气抬起来。", "en": "I lift it with a gust."},
        {"zh": "这个太沉，我拿不动。", "en": "Too heavy for me to hold."},
        {"zh": "下面有东西在闪。", "en": "Something glints down there."},
        {"zh": "不是好东西，别捡。", "en": "Not a good thing. Leave it."},
        {"zh": "我把它吸到眼前。", "en": "I draw it up to my eye."},
        {"zh": "这块石头还烫着。", "en": "This stone is still hot."},
        {"zh": "我这会儿不需要它。", "en": "I don't need it right now."},
        {"zh": "我把它推回原地。", "en": "I push it back where it was."},
        {"zh": "我根本没有手可拿。", "en": "I have no hands at all."},
        {"zh": "它在我下面很远。", "en": "It's far beneath me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我的视线正中。", "en": "You're dead center in my sight."},
        {"zh": "这个距离正好出手。", "en": "Good distance to strike."},
        {"zh": "你的弓箭先对准了我。", "en": "Your bow aimed at me first."},
        {"zh": "红光里有你的影子。", "en": "Your shadow's in the red glow."},
        {"zh": "我一直跟着你的位置。", "en": "I've tracked your position."},
        {"zh": "我已经升得更高了。", "en": "I've risen higher now."},
        {"zh": "你看不见我，我看得见你。", "en": "You can't see me. I see you."},
        {"zh": "往左边跑也没用。", "en": "Running left won't help."},
        {"zh": "我等这一下来了。", "en": "I've waited for this."},
        {"zh": "这个角度没有遮挡。", "en": "No cover from this angle."},
        {"zh": "我开始聚气了。", "en": "I'm gathering now."},
        {"zh": "你在我的领地里。", "en": "You're in my territory."},
        {"zh": "别躲到石柱后面。", "en": "Don't hide behind the pillar."},
        {"zh": "我的视线一直没移开。", "en": "My sight hasn't left you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你在往那边退。", "en": "You're retreating that way."},
        {"zh": "把距离拉开也没用。", "en": "Opening the distance won't help."},
        {"zh": "我一直保持在这个高度。", "en": "I'll hold this height."},
        {"zh": "你在数我的位置。", "en": "You're trying to place me."},
        {"zh": "下面的热浪能帮我。", "en": "The heat below helps me."},
        {"zh": "我看见你的肩膀动了。", "en": "I saw your shoulder move."},
        {"zh": "再等上一息时间。", "en": "One more breath of time."},
        {"zh": "影子落下去，正好罩住你。", "en": "My shadow falls and covers you exactly."},
        {"zh": "你已经把手抬起来。", "en": "You've raised your hand."},
        {"zh": "我稍微偏了一点。", "en": "I've shifted slightly."},
        {"zh": "你后面就是岩浆。", "en": "Lava is right behind you."},
        {"zh": "你只剩下一条路。", "en": "You've only one way left."},
        {"zh": "我在这里很稳。", "en": "I'm very steady here."},
        {"zh": "你抬头，正好撞上我的视线。", "en": "You look up and meet my gaze."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一束热光打下去。", "en": "A beam of hot light goes down."},
        {"zh": "你被掀翻在地。", "en": "You've been knocked flat."},
        {"zh": "这一下从上方来。", "en": "This one comes from above."},
        {"zh": "我贴近了再打。", "en": "I close in, then strike."},
        {"zh": "热风扫过你的脸。", "en": "Hot wind rakes your face."},
        {"zh": "你挡住了，但退了。", "en": "You blocked it, but you gave ground."},
        {"zh": "我的光让地面发红。", "en": "My light turns the ground red."},
        {"zh": "再来上这么一下。", "en": "Come and take another."},
        {"zh": "你躲开得非常快。", "en": "You dodged very fast."},
        {"zh": "我从另一边过来了。", "en": "I've come around the other side."},
        {"zh": "我的骨拳只用了三分力。", "en": "My bony fist used only a third of its strength."},
        {"zh": "你身上的味道焦了。", "en": "Something of yours is scorched."},
        {"zh": "我往上退了一点。", "en": "I've pulled up a little."},
        {"zh": "落点偏了半步。", "en": "That landed half a step wide."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从荒地的热气里浮起。", "en": "I rise from the waste's heat."},
        {"zh": "下界的光是红的。", "en": "The Nether's light is red."},
        {"zh": "我张开，慢慢转动。", "en": "I open and rotate slowly."},
        {"zh": "这里离岩浆很近。", "en": "The lava's very close here."},
        {"zh": "我找了块高一点的地方。", "en": "I've found a higher spot."},
        {"zh": "硫磺味道冲上来。", "en": "Sulphur fumes rise."},
        {"zh": "我的影子投在岩石上。", "en": "My shadow falls on the rock."},
        {"zh": "我还没有选定目标。", "en": "I haven't picked a target yet."},
        {"zh": "热浪把我往上托。", "en": "Heat carries me up."},
        {"zh": "我在这片荒地停下。", "en": "I settle over this waste."},
        {"zh": "我今天格外清醒。", "en": "I'm unusually alert today."},
        {"zh": "我看向远处的地平。", "en": "I look toward the horizon."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火让我整个亮起来。", "en": "Fire lights me up entirely."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我被砸得往下坠。", "en": "The blow sent me dropping."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "这里的水是滚的。", "en": "The water here boils."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我的轮廓撕开。", "en": "The blast tore my outline open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "下界的天上，我的眼被穿透。", "en": "In the Nether sky, my eye is pierced."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光和我的光撞上了。", "en": "That light collided with mine."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会饿，只是变淡。", "en": "I don't starve. I just fade."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我一片白。", "en": "The flash turned me white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里连热都没有。", "en": "There isn't even heat here."}
      ]
    }
  }
}
