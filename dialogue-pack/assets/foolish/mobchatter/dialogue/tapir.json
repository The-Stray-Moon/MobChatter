{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我低着头在竹林里走。", "en": "I walk the bamboo grove with my head low."},
        {"zh": "鼻子一伸一缩，闻着地。", "en": "My snout reaches and draws, scenting the ground."},
        {"zh": "我踩过竹叶，声音很轻。", "en": "I cross the bamboo leaves lightly."},
        {"zh": "我挤过两根竹子。", "en": "I squeeze between two stalks."},
        {"zh": "竹子被我压弯又弹回。", "en": "The bamboo bends and springs back."},
        {"zh": "我绕开一丛嫩笋。", "en": "I go around a clump of shoots."},
        {"zh": "那些留着以后吃。", "en": "Those I save for later."},
        {"zh": "我缓步向前走。", "en": "I step forward slowly."},
        {"zh": "我的身体很厚，腿很短。", "en": "My body is thick, my legs short."},
        {"zh": "我站住，抬头望了望。", "en": "I stop and look up."},
        {"zh": "竹叶在沙沙响。", "en": "The bamboo leaves rustle."},
        {"zh": "我继续慢慢踱。", "en": "I plod on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "鼻子一抽一抽，全是竹味", "en": "My snout keeps twitching; all bamboo."},
        {"zh": "这里的空气是湿的。", "en": "The air here is wet."},
        {"zh": "水声不近，可我闻得到", "en": "The water is not near, but I can smell it."},
        {"zh": "我朝着那个方向偏了偏头。", "en": "I tilt my head that way."},
        {"zh": "有虫在竹节里。", "en": "Insects are inside the bamboo joints."},
        {"zh": "那样东西我不吃。", "en": "That I do not eat."},
        {"zh": "我眼皮沉，眨得很慢", "en": "My lids are heavy; I blink slowly."},
        {"zh": "阳光从竹叶间漏下来。", "en": "Sun leaks through the bamboo leaves."},
        {"zh": "斑斑点点的，落在背上。", "en": "Dappled, it falls on my back."},
        {"zh": "我在原地立了许久。", "en": "I stood there a long while."},
        {"zh": "这里安静得很。", "en": "It is very quiet."},
        {"zh": "我正好喜欢静。", "en": "I like quiet."},
        {"zh": "我把头再压低些。", "en": "I lower my head again."},
        {"zh": "地上有新的叶子。", "en": "There are fresh leaves on the ground."},
        {"zh": "我啃了几口草。", "en": "I crop a few mouthfuls."},
        {"zh": "嚼起来嫩得很。", "en": "Very tender to chew."},
        {"zh": "我接着吃起来。", "en": "I go on eating."},
        {"zh": "这片够我待一天。", "en": "Enough here for a day."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你从竹子后面出来了。", "en": "You come out from behind the bamboo."},
        {"zh": "我从竹叶间抬头看你", "en": "I raise my head through the bamboo leaves to look."},
        {"zh": "我的鼻子在闻你。", "en": "My snout is scenting you."},
        {"zh": "你没有那个味道。", "en": "You do not have that smell."},
        {"zh": "竹林里我低头啃草，不理你。", "en": "In the bamboo, I graze with my head down."},
        {"zh": "你退开，我就接着吃", "en": "You step back, and I go back to eating."},
        {"zh": "我看这样可以。", "en": "This will do."},
        {"zh": "我又低头吃草。", "en": "I lower my head to the leaves again."},
        {"zh": "吃两口就看你一眼。", "en": "Two bites, and a glance at you."},
        {"zh": "竹子这么密，我走得慢。", "en": "The bamboo is thick, so I move slowly."},
        {"zh": "那就一起待着。", "en": "Then we will stay here together."},
        {"zh": "这算不了什么。", "en": "It is nothing."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我低低叫了一声，退半步。", "en": "I grunt low and give half a step."},
        {"zh": "我站住了脚。", "en": "I hold my footing."},
        {"zh": "身上有些疼。", "en": "It hurts some."},
        {"zh": "我把自己看了一遍。", "en": "I look myself over."},
        {"zh": "蹄子没软，我还能站", "en": "My hooves hold; I can still stand."},
        {"zh": "我往竹林里退。", "en": "I retreat into the bamboo."},
        {"zh": "这里能挡住视线。", "en": "Here I am out of sight."},
        {"zh": "我在竹林里等。", "en": "I wait inside."},
        {"zh": "等脚步声远了，我再动", "en": "I wait for the footsteps to fade, then move."},
        {"zh": "然后我再出来。", "en": "Then I come out."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那些是嫩叶子。", "en": "Those are tender leaves."},
        {"zh": "我踱两步，鼻子先到", "en": "Two plodding steps, snout first."},
        {"zh": "我伸鼻子碰了碰。", "en": "I touch them with my snout."},
        {"zh": "这片嫩，嚼着不费劲", "en": "These are tender; easy to chew."},
        {"zh": "我一口一口咬。", "en": "I bite, mouthful by mouthful."},
        {"zh": "我细细地嚼着。", "en": "Chewing slowly."},
        {"zh": "我抬眼望你。", "en": "I look up at you."},
        {"zh": "再给我一片，我还没吃够", "en": "One more leaf; I am not full."},
        {"zh": "我凑近了一点。", "en": "I lean a little closer."},
        {"zh": "然后我又退回来。", "en": "Then draw back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你一撞，我四蹄挪了挪", "en": "At your bump my four hooves shift."},
        {"zh": "我这身子挺沉。", "en": "This body of mine is heavy."},
        {"zh": "我一步也不让。", "en": "I do not give way."},
        {"zh": "你从旁边挤过去了。", "en": "You squeeze past."},
        {"zh": "我又低头闻了闻。", "en": "I lower my head and sniff again."},
        {"zh": "这是你的气味。", "en": "It is your smell."},
        {"zh": "这一下撞，我记下来了。", "en": "That collision — I noted it down."},
        {"zh": "下次就不用闻了。", "en": "Next time I will not need to sniff."},
        {"zh": "各走各的，竹林很窄。", "en": "Each our own way. The bamboo is narrow."},
        {"zh": "竹林里的路多。", "en": "There are many paths in a grove."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "竹林深处还有一只。", "en": "There is another deeper in the grove."},
        {"zh": "伴侣的气味从竹子那头来", "en": "My mate's scent comes from beyond the bamboo."},
        {"zh": "我顺着味道慢慢挪过去", "en": "I follow the scent over, slowly."},
        {"zh": "它也在往这边来。", "en": "It is coming too."},
        {"zh": "我们在竹子中间碰头。", "en": "We meet among the bamboo."},
        {"zh": "竹林里，我低头啃草。", "en": "In the bamboo, I graze head-down."},
        {"zh": "它也是这么做。", "en": "It does the same."},
        {"zh": "两只鼻子凑在一丛草上", "en": "Two snouts at the same tuft of grass."},
        {"zh": "这一片够我们俩。", "en": "This patch is enough for two."},
        {"zh": "天黑了我们还在这儿。", "en": "At dark we are still here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "鼻子顶了两下，没顶动", "en": "Two pushes with my snout; it will not move."},
        {"zh": "这东西咽不下去。", "en": "This cannot be eaten."},
        {"zh": "我把它含住。", "en": "I take it in my mouth."},
        {"zh": "分量轻得很。", "en": "It weighs very little."},
        {"zh": "我甩了甩，掉了。", "en": "I shake it loose."},
        {"zh": "它掉进竹叶里。", "en": "It falls into the bamboo leaves."},
        {"zh": "我看不见它了。", "en": "I cannot see it."},
        {"zh": "我闻了闻地面。", "en": "I sniff the ground."},
        {"zh": "终于找到了。", "en": "Found it."},
        {"zh": "我又把它放下。", "en": "I put it down again."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在竹子后面。", "en": "Something is behind the bamboo."},
        {"zh": "我偏过头去看了。", "en": "I turn my head."},
        {"zh": "那不是我们的同类。", "en": "Not one of mine."},
        {"zh": "气味非常陌生。", "en": "The smell is strange."},
        {"zh": "我把重心压低，前蹄刨地", "en": "I drop my weight and paw the ground."},
        {"zh": "我的腿短，跑不快。", "en": "My legs are short. I am not fast."},
        {"zh": "所以我得正面看它。", "en": "So I must face it."},
        {"zh": "我朝它走了一步。", "en": "I take one step toward it."},
        {"zh": "它没有退开。", "en": "It does not back off."},
        {"zh": "低低一声，从我喉里滚出来", "en": "A low sound rolls out of my throat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着它，一步不挪", "en": "I stare at it and do not shift a step."},
        {"zh": "它绕到左边去了。", "en": "It moves to the left."},
        {"zh": "我也转过身去。", "en": "I turn too."},
        {"zh": "它站在竹子后面。", "en": "It stands behind the bamboo."},
        {"zh": "竹子挡不住我。", "en": "The bamboo will not stop me."},
        {"zh": "我往里面挤。", "en": "I push forward."},
        {"zh": "竹子被我撞开。", "en": "The stalks give way."},
        {"zh": "它退了三步远。", "en": "It backs three steps."},
        {"zh": "我又停下脚。", "en": "I stop again."},
        {"zh": "我不想追上去。", "en": "I do not want to chase."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头撞过去。", "en": "I lower my head and charge."},
        {"zh": "撞在它的腰上。", "en": "I strike its middle."},
        {"zh": "我这一顶，它退了五步", "en": "One shove of my head and it backs five steps."},
        {"zh": "我自己也晃了。", "en": "I stagger too."},
        {"zh": "我这身子太重。", "en": "This body is too heavy."},
        {"zh": "我低头，用鼻子顶。", "en": "Head down, I push with my snout."},
        {"zh": "这次它躲开了。", "en": "This time it dodges."},
        {"zh": "我一头撞在竹子上。", "en": "I hit the bamboo head on."},
        {"zh": "竹子被我撞断。", "en": "The stalk breaks."},
        {"zh": "竹林里我低头啃草，很安静。", "en": "In bamboo I graze quietly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "竹林深处，我一步步走出来。", "en": "From deep in the bamboo, I step out."},
        {"zh": "身上挂着竹叶。", "en": "Bamboo leaves cling to me."},
        {"zh": "这里比我记得的密。", "en": "Denser than I remember."},
        {"zh": "我低下头，闻了闻地。", "en": "I lower my head and scent the ground."},
        {"zh": "有别的动物来过。", "en": "Other animals have been here."},
        {"zh": "是很新的痕迹。", "en": "Very fresh."},
        {"zh": "我把脑袋抬起来。", "en": "I raise my head."},
        {"zh": "四周都是竹子。", "en": "Bamboo on every side."},
        {"zh": "竹子够密，草也够嫩", "en": "The bamboo is thick and the grass tender."},
        {"zh": "我动身往前走。", "en": "I set off."},
        {"zh": "竹子让开一条路。", "en": "The bamboo opens a path."},
        {"zh": "我慢慢往里去。", "en": "I go slowly in."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的背，我冲进竹林深处。", "en": "Fire catches my back and I crash deeper into the bamboo."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下，撞进一丛竹子里。", "en": "I roll down the slope into a stand of bamboo."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过头，我拼命往岸边挣。", "en": "Water covers me; I fight for the bank."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀翻，竹子压了下来。", "en": "The blast flips me and bamboo falls on me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "竹林的皮厚，也挡不住这一箭。", "en": "Thick bamboo-forest hide still lost to that arrow."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光把我罩住，我迈不开腿。", "en": "Light covers me and my legs will not step."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "好几天没吃到嫩叶，我越来越没力。", "en": "Days without tender leaves, and my strength goes."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我四条腿都僵了。", "en": "Lightning falls and all four legs lock."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "竹林没了，我在黑里往下坠。", "en": "The bamboo is gone and I fall."}
      ]
    }
  }
}
