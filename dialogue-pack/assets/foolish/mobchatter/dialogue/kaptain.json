{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我移动得慢，但不会停。", "en": "I move slowly, and never stop."},
        {"zh": "二十点护甲，走起来闷响。", "en": "Twenty points of armor, and every step a dull thud."},
        {"zh": "我拖着脚走，泥在脚下。", "en": "I drag my feet through the mud."},
        {"zh": "我一步比一步沉。", "en": "Each step lands heavier."},
        {"zh": "水到腰了，我还是往前走。", "en": "Waist-deep, and still I go."},
        {"zh": "我的壳像一面墙。", "en": "My shell is a wall."},
        {"zh": "我慢慢转过头找你。", "en": "I turn my head slowly to find you."},
        {"zh": "我走过的地方，泥都翻起来。", "en": "Where I walk, the mud churns up."},
        {"zh": "我不会绕路。", "en": "I do not go around."},
        {"zh": "烂木桥被我踩断了。", "en": "The rotten bridge gives under me."},
        {"zh": "我一路碾压过去。", "en": "I crush my way across."},
        {"zh": "泥水从我背上流下去。", "en": "Mud water runs off my shell."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，很重。", "en": "I stand, and I am heavy."},
        {"zh": "泥在我脚上升。", "en": "Mud settles around my feet."},
        {"zh": "我喘得像拉风箱。", "en": "I wheeze like a bellows."},
        {"zh": "我不着急，谁也跑不掉。", "en": "No hurry. No one escapes."},
        {"zh": "我壳上的青苔厚得能种东西。", "en": "Moss thick enough to plant on."},
        {"zh": "我慢慢转开一只眼。", "en": "I turn one eye aside."},
        {"zh": "水声就在近处。", "en": "Water sounds close by."},
        {"zh": "我在等泥沉下来。", "en": "I wait for the mud to settle."},
        {"zh": "我的爪子很钝。", "en": "My claws are blunt."},
        {"zh": "这片泥沼也会被我压实。", "en": "Even this mire will pack under me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你正站在我影子里。", "en": "You are standing in my shadow."},
        {"zh": "我比你高半个头，重三倍。", "en": "Half a head taller, three times heavier."},
        {"zh": "跑是没用的。", "en": "Running is useless."},
        {"zh": "我看得见你很累。", "en": "I can see you are tired."},
        {"zh": "你在看我的壳。", "en": "You are looking at my shell."},
        {"zh": "壳上的鳞甲，能挡二十点。", "en": "The scutes on my shell stop twenty points."},
        {"zh": "我一巴掌就够。", "en": "One blow is enough."},
        {"zh": "你手上那把东西太轻。", "en": "That thing in your hand is too light."},
        {"zh": "水里你更没处躲。", "en": "In water you have even less room."},
        {"zh": "我慢慢过来。", "en": "I am coming."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲凹了一块。", "en": "A plate is dented."},
        {"zh": "我的甲上又多一道白痕。", "en": "Another white score on my shell."},
        {"zh": "我吸了口气，声音很粗。", "en": "I take a rough breath."},
        {"zh": "我还没给打倒。", "en": "I have not been felled."},
        {"zh": "泥沼会把我扶住。", "en": "The mire holds me up."},
        {"zh": "我抬手护住眼睛。", "en": "I raise an arm over my eyes."},
        {"zh": "疼是疼，还能走。", "en": "It hurts. I can still walk."},
        {"zh": "我的甲厚二十点，你慢慢敲。", "en": "Twenty points of shell — knock away."},
        {"zh": "让我再受一次。", "en": "Let me take another."},
        {"zh": "我仍旧一步步向前。", "en": "Still forward, step by step."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西我不挑。", "en": "I am not particular."},
        {"zh": "你放地上，我慢慢吃。", "en": "Put it down. I eat slowly."},
        {"zh": "还不够我吃。", "en": "Not enough for me."},
        {"zh": "我嚼得比你想的慢。", "en": "I chew slower than you think."},
        {"zh": "你还有没有，我拿龟壳跟你换。", "en": "Any more? I will trade a turtle scute for it."},
        {"zh": "我吃完还得喝水。", "en": "After this I will want water."},
        {"zh": "这东西有点干。", "en": "This is dry."},
        {"zh": "别盯着我吃。", "en": "Do not stare while I eat."},
        {"zh": "一口就咽了。", "en": "One gulp and it is gone."},
        {"zh": "再多喂我些。", "en": "Feed me more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞的是一座小山。", "en": "You hit a hillside."},
        {"zh": "我脚下没挪。", "en": "My feet did not shift."},
        {"zh": "你被弹回泥里。", "en": "You bounce back into the mud."},
        {"zh": "二十点护甲，你伤不到。", "en": "Twenty points. You cannot touch it."},
        {"zh": "我抬脚，很慢。", "en": "I lift a foot, slowly."},
        {"zh": "我的壳把你顶开了。", "en": "My shell shoulders you aside."},
        {"zh": "泥里的声音很闷。", "en": "The sound in the mud is dull."},
        {"zh": "你站稳了吗？", "en": "Are you standing?"},
        {"zh": "别从侧面来。", "en": "Do not come from the side."},
        {"zh": "把道路让开。", "en": "Make way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这么重，不合适。", "en": "I am too heavy for that."},
        {"zh": "泥沼里不需要这些。", "en": "The mire has no use for it."},
        {"zh": "我转开身子。", "en": "I turn my bulk aside."},
        {"zh": "你实在太轻。", "en": "You are far too light."},
        {"zh": "我这二十点护甲，走起来闷响。", "en": "Twenty points of armor; my steps thud."},
        {"zh": "我摆了摆手。", "en": "I wave a hand."},
        {"zh": "水深的地方才说得上。", "en": "Only in deep water is it spoken of."},
        {"zh": "我这身重甲，跳不了舞。", "en": "In this heavy shell, I cannot dance."},
        {"zh": "别再多问了。", "en": "Ask nothing more."},
        {"zh": "回去你的路上。", "en": "Back to your road."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "弯下腰真费力。", "en": "Bending down is hard work."},
        {"zh": "我用爪尖勾起它。", "en": "I hook it up with a claw tip."},
        {"zh": "这个实在太小。", "en": "This is far too small."},
        {"zh": "我压在壳下面。", "en": "I press it under my shell."},
        {"zh": "我把它塞进壳缝里收着。", "en": "I wedge it into a seam of my shell."},
        {"zh": "我一脚就压碎了。", "en": "One step crushes it."},
        {"zh": "地上的东西都是我的。", "en": "Everything here is mine."},
        {"zh": "我顶着它往前。", "en": "I push it ahead of me."},
        {"zh": "这东西用不上。", "en": "This is of no use."},
        {"zh": "拿走也不迟。", "en": "It can wait."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过我的膝盖，我照样走。", "en": "Water reaches my knees, and I keep walking."},
        {"zh": "你不会跑过我。", "en": "You will not outwalk me."},
        {"zh": "我的壳挡住了你的路。", "en": "My shell blocks your path."},
        {"zh": "这一片水是我的。", "en": "This water is mine."},
        {"zh": "我抬起了手臂。", "en": "My arm comes up."},
        {"zh": "你打不穿二十点甲。", "en": "You will not break twenty points."},
        {"zh": "我慢慢来，可是很重。", "en": "Slow, and heavy."},
        {"zh": "你的武器在我身上会断。", "en": "Your weapon will break on me."},
        {"zh": "水里也是我的地。", "en": "The water is mine too."},
        {"zh": "站定别乱动。", "en": "Stand fast. Do not move."},
        {"zh": "一步就到你跟前。", "en": "One step to your face."},
        {"zh": "我不会心软。", "en": "I will not soften."},
        {"zh": "你退到烂泥里了。", "en": "You are backing into slop."},
        {"zh": "我等着你过来。", "en": "I wait for you to come."},
        {"zh": "这一掌很沉。", "en": "This palm is heavy."},
        {"zh": "那就动手来吧。", "en": "Then let us begin."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步碾过去。", "en": "I grind forward, step by step."},
        {"zh": "你退，泥会拉住你。", "en": "Retreat, and the mud will hold you."},
        {"zh": "我的动作慢，可是够近。", "en": "My swing is slow, and close enough."},
        {"zh": "你听，我的壳在响。", "en": "Listen — my shell is creaking."},
        {"zh": "你的箭射在甲上，直接弹开。", "en": "Your arrow hits my shell and bounces off."},
        {"zh": "我抬手的幅度很小。", "en": "The windup is a short motion."},
        {"zh": "你手上的武器在抖。", "en": "Your weapon is trembling."},
        {"zh": "你打我很费劲吧。", "en": "You are working hard to hurt me."},
        {"zh": "水里我也能追。", "en": "I can chase you in the water too."},
        {"zh": "水到你的腰了。", "en": "Water to your waist."},
        {"zh": "我的壳一动，泥水就晃。", "en": "When my shell shifts, the muddy water sloshes."},
        {"zh": "我一个都没有。", "en": "I have none at all."},
        {"zh": "再近一格来。", "en": "One block closer."},
        {"zh": "我压得地面都陷。", "en": "The ground sinks under me."},
        {"zh": "不要回身看。", "en": "Do not turn round."},
        {"zh": "我就立在这儿。", "en": "I stand right here."},
        {"zh": "我离你两格，已经够近了。", "en": "Two blocks away is close enough for me."},
        {"zh": "你只能硬挡。", "en": "You can only block."},
        {"zh": "我累了，可我能撑。", "en": "I am tired. I can take more."},
        {"zh": "给我倒下去。", "en": "Go down."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬脚踩住你的盾沿。", "en": "I plant my foot on the rim of your shield."},
        {"zh": "我的壳一顶，你退了半步。", "en": "One shove of my shell and you stagger back."},
        {"zh": "这一下十五点。", "en": "Fifteen points on that one."},
        {"zh": "我的壳撞得你后退。", "en": "My shell knocks you back."},
        {"zh": "你的护甲塌了一块。", "en": "Your plate has caved in."},
        {"zh": "我抬脚踩你的脚背。", "en": "I stamp on your instep."},
        {"zh": "我下水也能游，别想跑。", "en": "I swim too. Don't run."},
        {"zh": "你手边的武器掉了。", "en": "Your weapon drops."},
        {"zh": "我把你往水里推。", "en": "I shove you toward the water."},
        {"zh": "泥和水一起翻起来。", "en": "Mud and water churn."},
        {"zh": "这一下慢，但很实。", "en": "Slow, and it lands."},
        {"zh": "我这身壳，是从海里捡的。", "en": "This shell of mine came from the sea."},
        {"zh": "我再来一下。", "en": "Another one."},
        {"zh": "血混在泥里看不出来。", "en": "Blood does not show in this mud."},
        {"zh": "你让开了路。", "en": "You cleared out."},
        {"zh": "我力气还剩很多。", "en": "Plenty of strength left."},
        {"zh": "我一掌拍在你的护胸上。", "en": "My palm lands on your chestplate."},
        {"zh": "就到这儿吧。", "en": "Let it end here."},
        {"zh": "再来一下下。", "en": "One more blow."},
        {"zh": "到这里收手。", "en": "That is enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水里探出身子。", "en": "I rise up out of the water."},
        {"zh": "泥从我身上滑下去。", "en": "Mud slides off me."},
        {"zh": "这片泥沼很浅，容不下我。", "en": "This mire is shallow for me."},
        {"zh": "我踩下去，地面陷了一寸。", "en": "The ground sinks an inch under me."},
        {"zh": "我环顾了一下四周。", "en": "I look around the area."},
        {"zh": "水从壳缝里喷出来。", "en": "Water jets from my shell's seams."},
        {"zh": "我来了，不会走。", "en": "I have come, and I will not leave."},
        {"zh": "这里的味道，闻着像家。", "en": "This smell, it feels like home."},
        {"zh": "我拖着脚步靠近。", "en": "I drag my steps closer."},
        {"zh": "有人挡在面前。", "en": "Someone stands in my way."},
        {"zh": "我把壳往前一转。", "en": "I turn my shell forward."},
        {"zh": "闪到旁边去。", "en": "Get out of the way."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在湿壳上冒白烟。", "en": "Fire steams off my wet shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下来，砸出半格深的坑。", "en": "I leave a half-block crater."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我太重，水一深就站不住。", "en": "Too heavy. Deep water takes my footing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸只让我矮了半截。", "en": "The blast only lowers me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西嵌进我的壳里。", "en": "It lodges in my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力从壳缝钻进去。", "en": "Magic finds the seams."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，我走得更慢了。", "en": "Hungry, my pace drops further."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我背上，我抖了一下。", "en": "Lightning hits my back; I shudder once."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有泥，我站不住。", "en": "No mud. I cannot stand."}
      ]
    }
  }
}
