{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我长腿交替迈着，走得像在量地。", "en": "My long legs step as if measuring the ground."},
        {"zh": "头上几根羽冠往后倒。", "en": "The crest feathers trail behind my head."},
        {"zh": "我走在热带草原的干草上。", "en": "I walk the dry savanna grass."},
        {"zh": "每一步都很高。", "en": "Each step is high."},
        {"zh": "我停下来踩了一脚。", "en": "I stop and stamp once."},
        {"zh": "草丛里有什么动了。", "en": "Something moves in the grass."},
        {"zh": "我侧过头去看。", "en": "I turn my head to look."},
        {"zh": "又没有动静了。", "en": "It goes still again."},
        {"zh": "我继续踩着草走。", "en": "I keep stepping through the grass."},
        {"zh": "腿的影子在地上很长。", "en": "My legs cast long shadows."},
        {"zh": "我绕着蚁丘走了一圈。", "en": "I circle an anthill."},
        {"zh": "又回头看了看。", "en": "And glance back."},
        {"zh": "风把干草吹得沙沙响。", "en": "Wind rasps the dry grass."},
        {"zh": "太阳晒得厉害。", "en": "The sun is fierce."},
        {"zh": "我眼睛都不眨。", "en": "I do not even blink."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，脖子笔直。", "en": "I stand with my neck straight."},
        {"zh": "羽冠被风掀起来。", "en": "Wind lifts my crest."},
        {"zh": "远处的草动了一下。", "en": "The far grass stirs."},
        {"zh": "我抬着一只脚，站了很久。", "en": "I hold one foot up, standing still a long while."},
        {"zh": "那只不过是风。", "en": "That is only wind."},
        {"zh": "我把脖子放低一点。", "en": "I lower my neck a little."},
        {"zh": "腿上沾了灰。", "en": "Dust coats my legs."},
        {"zh": "然后把它放下。", "en": "Then set it down."},
        {"zh": "这样重复了几次。", "en": "I do this several times."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你不像要吃的东西。", "en": "You do not look like food."},
        {"zh": "也不像危险。", "en": "Nor like danger."},
        {"zh": "我没有走开。", "en": "I do not walk away."},
        {"zh": "你也没有走。", "en": "Neither did you."},
        {"zh": "风从我们之间过去。", "en": "Wind passes between us."},
        {"zh": "我垂下脖子看你。", "en": "I lower my neck to look at you."},
        {"zh": "我又抬了回去。", "en": "And lift it again."},
        {"zh": "也就这样了。", "en": "That is all there is."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳开一步，羽毛竖起来。", "en": "I hop back a step, feathers up."},
        {"zh": "翅膀张了一下。", "en": "My wings flare once."},
        {"zh": "长腿有点发软。", "en": "My long legs feel weak."},
        {"zh": "喙张开，没有出声。", "en": "My beak opens without a sound."},
        {"zh": "胸口起伏得很快。", "en": "My chest rises and falls fast."},
        {"zh": "草被我踩乱。", "en": "The grass is churned at my feet."},
        {"zh": "我看向那个方向。", "en": "I look that way."},
        {"zh": "这一次我没有走。", "en": "This time I do not walk away."},
        {"zh": "我伏下长腿。", "en": "I fold my long legs low."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在草里爬。", "en": "Something crawls in the grass."},
        {"zh": "我盯着那个地方。", "en": "I fix on that spot."},
        {"zh": "然后一脚踩下去。", "en": "Then stamp down."},
        {"zh": "尘土跳起来。", "en": "Dust leaps up."},
        {"zh": "我低头去看。", "en": "I look down."},
        {"zh": "草里空空的。", "en": "The grass is empty."},
        {"zh": "我抬起头来。", "en": "I lift my head up."},
        {"zh": "我又接着走。", "en": "I walk on again."},
        {"zh": "这种机会很多。", "en": "Such chances are many."},
        {"zh": "我不赶这个时间。", "en": "I am not in any hurry."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的长腿一弯，又站直。", "en": "My long leg bends, then straightens."},
        {"zh": "我跳开了一点。", "en": "I hop aside a little."},
        {"zh": "我回头看你。", "en": "I look back at you."},
        {"zh": "你把身体让开了。", "en": "You move aside."},
        {"zh": "我慢慢把羽毛收好。", "en": "I settle my feathers slowly."},
        {"zh": "然后继续站。", "en": "Then stand again."},
        {"zh": "草被我们踩倒一片。", "en": "A patch of grass is flattened."},
        {"zh": "我们没有再碰。", "en": "We do not touch again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在草原上绕圈。", "en": "We circle on the savanna."},
        {"zh": "羽冠全竖起来。", "en": "My crest stands fully up."},
        {"zh": "我一跳一跳。", "en": "I hop, and hop."},
        {"zh": "她也跟着跳。", "en": "She hops too."},
        {"zh": "我们隔得很远。", "en": "We keep our distance."},
        {"zh": "然后一起停下。", "en": "Then stop together."},
        {"zh": "巢在矮树上。", "en": "The nest is in a low tree."},
        {"zh": "用草和枝条编的。", "en": "Woven of grass and twigs."},
        {"zh": "我守在下面。", "en": "I keep watch below."},
        {"zh": "直到蛋孵出来。", "en": "Until the eggs hatch."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我低头啄起来。", "en": "I peck it up."},
        {"zh": "它在我的喙里晃。", "en": "It rattles in my beak."},
        {"zh": "喙里这东西咬不动，我甩头。", "en": "This thing won't crack; I shake my head."},
        {"zh": "我一甩脖子。", "en": "I jerk my neck."},
        {"zh": "把它吐出去。", "en": "And spit it out."},
        {"zh": "这个还算行。", "en": "This one will do."},
        {"zh": "我又低下头找。", "en": "I lower my head to search again."},
        {"zh": "这顿小点心，我收下了。", "en": "A little snack like this? I'll take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩住不动。", "en": "I plant my foot still."},
        {"zh": "脖子伸得很直。", "en": "My neck stretches straight."},
        {"zh": "一只脚抬起来。", "en": "One foot lifts."},
        {"zh": "脚悬在半空中。", "en": "My foot hangs in the air."},
        {"zh": "我踩下去了。", "en": "I stamp down."},
        {"zh": "你敢碰我，就别想走。", "en": "You touched me. Now you're not leaving."},
        {"zh": "再不后退，我可要动脚。", "en": "Step back, or these legs start swinging."},
        {"zh": "你抬手的瞬间，我盯住了你。", "en": "The moment you raise your hand, my eyes lock on."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它转身就跑。", "en": "It turns and runs."},
        {"zh": "我追了上去。", "en": "I go after it."},
        {"zh": "长腿几步就追上。", "en": "A few long strides close the gap."},
        {"zh": "它拐弯，我也拐。", "en": "It turns; I turn."},
        {"zh": "干草在我腿间分。", "en": "Dry grass parts between my legs."},
        {"zh": "我张开翅膀。", "en": "I spread my wings."},
        {"zh": "这样拐得更快。", "en": "It lets me turn faster."},
        {"zh": "它钻进石头缝。", "en": "It slips into a rock crack."},
        {"zh": "我把脚收回来。", "en": "I draw my foot back."},
        {"zh": "草里的蛇一动，我抬脚。", "en": "A snake stirs in the grass; I lift a foot."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳起来，双脚一起踢。", "en": "I leap and kick with both feet."},
        {"zh": "它被踢得退开。", "en": "It is knocked back."},
        {"zh": "我落下，站稳。", "en": "I land and steady."},
        {"zh": "我的翅膀张着。", "en": "My wings stay spread."},
        {"zh": "它又靠过来。", "en": "It comes close again."},
        {"zh": "我这次用喙。", "en": "This time I use my beak."},
        {"zh": "一下啄在它手上。", "en": "One peck to its hand."},
        {"zh": "它缩回去了。", "en": "It pulls back."},
        {"zh": "我收起翅膀。", "en": "I fold my wings."},
        {"zh": "站在原地看它。", "en": "And watch it from where I stand."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "干草上落下一道长影。", "en": "A long shadow falls on the dry grass."},
        {"zh": "我先站直了腿。", "en": "First I straighten my legs."},
        {"zh": "我这才抬起头。", "en": "Only then do I raise my head."},
        {"zh": "羽冠被风掀了一下。", "en": "Wind lifts my crest once."},
        {"zh": "草原上的蛇，我一脚踩住。", "en": "Savanna snakes go under my foot."},
        {"zh": "草原宽得很。", "en": "The savanna is wide."},
        {"zh": "草里有很多声音。", "en": "Many sounds in the grass."},
        {"zh": "我落地，羽冠被风掀起。", "en": "I land, my crest lifted by the wind."},
        {"zh": "尘土散了开去。", "en": "The dust scatters."},
        {"zh": "全是干枯的草。", "en": "Nothing but dead grass."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的羽毛，焦味很重。", "en": "Fire singes my feathers; the stench is strong."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下，长腿先着地。", "en": "I fall from height, legs first."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里没有我落脚的地方。", "en": "There is nowhere in the water to stand."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀出草面。", "en": "The blast throws me up out of the grass."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进我的翅膀。", "en": "It lodges in my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我的腿僵硬。", "en": "A cold stiffens my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我连硬壳虫都吃。", "en": "Hungry enough to eat hard-shelled beetles."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在草原上，我伏低。", "en": "Lightning strikes the savanna; I flatten."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有地面可以踩。", "en": "No ground to stamp on."}
      ]
    }
  }
}
