{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "六条腿落在红色的草上。", "en": "Six legs settle on the crimson grass."},
        {"zh": "我沿着族群的外沿巡。", "en": "I patrol the colony's outer rim."},
        {"zh": "甲壳在光下泛着暗红。", "en": "My shell glints dull red."},
        {"zh": "每走一段，我就停下听。", "en": "Every so often I stop and listen."},
        {"zh": "红色的田野里只有我们。", "en": "Only we live on the crimson field."},
        {"zh": "我用触角碰了碰旁边的草。", "en": "I touch the grass with an antenna."},
        {"zh": "草弯下去，又弹回来。", "en": "It bends, then springs back."},
        {"zh": "我继续沿着线走。", "en": "I go on along the line."},
        {"zh": "同族在远处让开。", "en": "My kin make way at a distance."},
        {"zh": "我不看它们。", "en": "I do not look at them."},
        {"zh": "我的位置在最外面。", "en": "My place is the outermost."},
        {"zh": "所以我走得很慢，很稳。", "en": "So I walk slowly, steadily."},
        {"zh": "有风从外头来。", "en": "Wind comes from beyond."},
        {"zh": "我抬高触角闻。", "en": "I raise my antennae to taste it."},
        {"zh": "我把脚站定了。", "en": "I plant my feet."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在边界上，一动不动。", "en": "I stand at the boundary, still."},
        {"zh": "口器在轻轻磨。", "en": "My mouthparts grind softly."},
        {"zh": "后腿撑着身体，前腿抬起。", "en": "Hind legs brace; forelegs raised."},
        {"zh": "这个姿势可以随时动。", "en": "From this stance I can move at once."},
        {"zh": "红色的草在我脚边摇。", "en": "The red grass sways at my feet."},
        {"zh": "我听见巢里的声音。", "en": "I hear the nest behind me."},
        {"zh": "有幼虫在叫。", "en": "Larvae are calling."},
        {"zh": "我不朝巢那边看。", "en": "I do not look toward the nest."},
        {"zh": "守在外面更重要。", "en": "Guarding outside matters more."},
        {"zh": "太阳把甲壳晒热了。", "en": "The sun warms my shell."},
        {"zh": "我的六条腿都没动。", "en": "None of my six legs move."},
        {"zh": "直到有东西靠近。", "en": "Until something comes near."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我转过整个身体。", "en": "I turn my whole body."},
        {"zh": "你没有让开。", "en": "You do not step aside."},
        {"zh": "我的口器停了一下。", "en": "My mouthparts pause."},
        {"zh": "我又继续磨着。", "en": "I grind on."},
        {"zh": "你站在线外面。", "en": "You stand beyond the line."},
        {"zh": "我把前腿放下来。", "en": "I lower my forelegs."},
        {"zh": "不是投降，是准备。", "en": "Not surrender: preparation."},
        {"zh": "你动了一步。", "en": "You take a step."},
        {"zh": "我也跟着动了。", "en": "So do I."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了半寸，又站回去。", "en": "I give half an inch, then take it back."},
        {"zh": "口器合上了。", "en": "My mouthparts close."},
        {"zh": "腿有一瞬间发软。", "en": "My legs weaken for an instant."},
        {"zh": "我还是撑住了。", "en": "I hold my ground."},
        {"zh": "后面的幼虫在叫。", "en": "The larvae behind me call."},
        {"zh": "我回头确认幼虫还藏着。", "en": "I glance back to check the larvae are hidden."},
        {"zh": "我重新面朝外面。", "en": "I face outward again."},
        {"zh": "这是我要守的地方。", "en": "This is what I guard."},
        {"zh": "我钉在原地，甲壳发亮。", "en": "I hold my ground, shell gleaming."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我把东西推到一边。", "en": "I push it aside."},
        {"zh": "族群里不需要施舍。", "en": "The colony needs no charity."},
        {"zh": "你举着它，很耐心。", "en": "You hold it out, patient."},
        {"zh": "我的触角在它上面扫。", "en": "My antennae sweep over it."},
        {"zh": "没有我要的东西。", "en": "There is nothing I want."},
        {"zh": "我把身体转开。", "en": "I turn my body away."},
        {"zh": "我退回界线。", "en": "I step back to the line."},
        {"zh": "我不再看了。", "en": "I stop looking."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我挪了半寸。", "en": "I shift half an inch."},
        {"zh": "然后立刻站回去。", "en": "And take it back at once."},
        {"zh": "你踩到我的腿。", "en": "You step on my leg."},
        {"zh": "我把腿抽出来。", "en": "I pull it free."},
        {"zh": "我沿着族群的外沿巡，暗红甲发亮。", "en": "My dark red shell gleams as I patrol the colony's rim."},
        {"zh": "你从线上退开。", "en": "You step off the line."},
        {"zh": "我在线上站着。", "en": "I stand on the line."},
        {"zh": "红草被踩出一块印。", "en": "A print is left in the red grass."},
        {"zh": "等它自己立起来。", "en": "I wait for it to rise."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这些事由族群安排。", "en": "The colony arranges such things."},
        {"zh": "我只是守在外面。", "en": "I only guard the outside."},
        {"zh": "里面的事我不看。", "en": "I do not watch what happens within."},
        {"zh": "有幼虫爬到我脚边。", "en": "Larvae crawl to my feet."},
        {"zh": "我用触角把它们推回去。", "en": "I nudge them back with my antennae."},
        {"zh": "它们还太小。", "en": "They are still too small."},
        {"zh": "风从外面来。", "en": "Wind comes from beyond."},
        {"zh": "我转过去对着它。", "en": "I turn to face it."},
        {"zh": "外面没有东西。", "en": "There is nothing outside."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用口器夹起来。", "en": "I take it in my mouthparts."},
        {"zh": "我用口器试了试这东西的硬软。", "en": "I test the thing's hardness with my mandibles."},
        {"zh": "我把它放到界线外。", "en": "I set it outside the line."},
        {"zh": "又回到自己的位置。", "en": "Then return to my place."},
        {"zh": "红草在它旁边摇。", "en": "The red grass sways beside it."},
        {"zh": "我没再看它。", "en": "I do not look again."},
        {"zh": "远处有同族经过。", "en": "Kin pass in the distance."},
        {"zh": "它们没有停。", "en": "They do not stop."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "界线被踩了。", "en": "The line has been crossed."},
        {"zh": "我整个身体转过去。", "en": "I turn my whole body."},
        {"zh": "触角全部竖起。", "en": "My antennae all stand up."},
        {"zh": "甲壳下的肌肉绷紧。", "en": "The muscle beneath my shell tightens."},
        {"zh": "我把口器张开。", "en": "My mouthparts open."},
        {"zh": "你要进到里面去。", "en": "You mean to go inside."},
        {"zh": "那是不行的。", "en": "That cannot be allowed."},
        {"zh": "族群在后面。", "en": "The colony is behind me."},
        {"zh": "这是我在这儿的原因。", "en": "That is why I am here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着它横移。", "en": "I sidestep around it."},
        {"zh": "六条腿配合得很紧。", "en": "My six legs work tightly together."},
        {"zh": "它想从侧面过。", "en": "It tries to pass on the flank."},
        {"zh": "我横在它前面。", "en": "I set myself across its way."},
        {"zh": "它抬起手来。", "en": "It raises a hand."},
        {"zh": "我低下头，用甲迎上。", "en": "I lower my head and meet it with shell."},
        {"zh": "撞出一声闷响。", "en": "A dull crack."},
        {"zh": "它的手退了。", "en": "Its hand recoils."},
        {"zh": "我回到线上。", "en": "I return to the line."},
        {"zh": "它绕到另一边。", "en": "It goes round the other side."},
        {"zh": "我又横移过去。", "en": "I sidestep again."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "前腿劈下去。", "en": "My forelegs come down."},
        {"zh": "甲壳的边缘刮过它。", "en": "My shell's edge rakes it."},
        {"zh": "口器咬住它的衣角。", "en": "My mouthparts catch its hem."},
        {"zh": "我把它往线外推。", "en": "I push it past the line."},
        {"zh": "它往后错开半步。", "en": "It shifts half a step back."},
        {"zh": "我又用甲顶。", "en": "I butt with my shell again."},
        {"zh": "它斜着倒过去。", "en": "It topples sideways."},
        {"zh": "它倒向红线外。", "en": "It falls outside the red line."},
        {"zh": "我立在红线上。", "en": "I stand on the red line."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "红草被压出一块空地。", "en": "A patch of red grass is pressed flat."},
        {"zh": "我站在那块空地上。", "en": "I stand in that patch."},
        {"zh": "甲壳还是新的。", "en": "My shell is still new."},
        {"zh": "我转头看四周。", "en": "I turn my head to look around."},
        {"zh": "族群在远处。", "en": "The colony is far off."},
        {"zh": "它们没有过来。", "en": "They do not come over."},
        {"zh": "我自己走过去。", "en": "I walk over myself."},
        {"zh": "走到它们的外面。", "en": "To the outside of them."},
        {"zh": "然后我就停下。", "en": "Then I stop."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我的甲壳发脆。", "en": "Fire makes my shell brittle."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，腿绞在一起。", "en": "I roll down a slope, legs tangled."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进口器，我乱蹬。", "en": "Water fills my mouthparts; I kick wildly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我掀过红线。", "en": "The blast throws me over the red line."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西钉进我的甲。", "en": "It lodges in my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我的腿停了。", "en": "A cold stops my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得连红草都咬。", "en": "Hungry enough to bite the red grass."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在红草上，我伏低。", "en": "Lightning strikes the red grass; I flatten."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，我找不到线。", "en": "The ground is gone; I cannot find the line."}
      ]
    }
  }
}
