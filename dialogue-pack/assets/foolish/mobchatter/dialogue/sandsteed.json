{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的蹄子敲着沙。", "en": "My hooves tap the sand."},
        {"zh": "骨架在皮下发响。", "en": "The frame creaks under my hide."},
        {"zh": "四蹄踩得很整齐。", "en": "Four hooves fall in even rhythm."},
        {"zh": "沙粒从我肋间漏出。", "en": "Sand leaks through my ribs."},
        {"zh": "我沿着沙丘跑起来。", "en": "I break into a run along the dune."},
        {"zh": "尾巴是一把骨头。", "en": "My tail is bare bone."},
        {"zh": "身边还有三匹。", "en": "Three others run beside me."},
        {"zh": "我早就没有肺了。", "en": "I have no lungs anymore."},
        {"zh": "鬃毛被风吹散了。", "en": "The wind scatters my mane."},
        {"zh": "我跑得比风快一点。", "en": "A little faster than the wind."},
        {"zh": "沙子打在腿骨上。", "en": "Sand strikes my leg bones."},
        {"zh": "我们散开又合拢。", "en": "We spread out, then close up."},
        {"zh": "我踩着别人的影子。", "en": "I run through my fellows' shadows."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着不动。", "en": "I stand without moving."},
        {"zh": "眼窝里空空的。", "en": "Empty sockets where my eyes were."},
        {"zh": "我的空骨架在风里响。", "en": "My hollow frame rattles in the wind."},
        {"zh": "骷髅头一甩，沙子从眼窝漏下。", "en": "I shake my skull; sand spills from the sockets."},
        {"zh": "沙积在我的关节。", "en": "Sand collects in my joints."},
        {"zh": "蹄子自己刨着沙。", "en": "A hoof paws the sand on its own."},
        {"zh": "我不想吃，只想跑。", "en": "I don't want food. I want to run."},
        {"zh": "日头太毒了。", "en": "The sun is merciless."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我面前很像猎物。", "en": "You look like prey from here."},
        {"zh": "死太久了，名字早忘了。", "en": "Dead too long; the name is gone."},
        {"zh": "你的影子好短。", "en": "Your shadow is so short."},
        {"zh": "手别伸过来，我身上全是沙。", "en": "Keep your hand back; I'm all sand and bone."},
        {"zh": "我没有体温。", "en": "I have no warmth."},
        {"zh": "我的背空着，可惜。", "en": "My back is empty. A pity."},
        {"zh": "你身上有血肉味。", "en": "You smell of flesh and blood."},
        {"zh": "跑吧，我给你三息。", "en": "Run. I'll give you three breaths."},
        {"zh": "这片沙丘我们四个分。", "en": "We four share these dunes."},
        {"zh": "骷髅马不喘气，只听得见你。", "en": "A skeletal horse does not breathe. It hears only you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一根肋骨断了。", "en": "A rib snapped."},
        {"zh": "沙从我骨架里漏。", "en": "Sand drains from my frame."},
        {"zh": "我的腿骨在晃。", "en": "My leg bone wobbles."},
        {"zh": "我发出干涩的声。", "en": "A dry sound comes out."},
        {"zh": "我这骨架还能跑。", "en": "This frame still runs."},
        {"zh": "我不用怕疼。", "en": "I needn't fear pain."},
        {"zh": "少一根骨头也能站。", "en": "One bone short is still standing."},
        {"zh": "我记得你的样子。", "en": "I remember your shape."},
        {"zh": "其它三匹会来。", "en": "The other three will come."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这味道太鲜了。", "en": "That smell is too fresh."},
        {"zh": "往前走两步。", "en": "Two steps forward."},
        {"zh": "我不饿，但想咬。", "en": "I'm not hungry, but I want to bite."},
        {"zh": "别把这块松开。", "en": "Don't let go of it."},
        {"zh": "这块肉还热着。", "en": "This meat is still warm."},
        {"zh": "这血还没干。", "en": "The blood is still wet."},
        {"zh": "放下就跑吧。", "en": "Put it down and run."},
        {"zh": "它在我嘴里化开。", "en": "It's dissolving in my mouth."},
        {"zh": "你们三个别抢。", "en": "You three, don't grab."},
        {"zh": "我不吃，只想靠近。", "en": "I won't eat. I only want to be near."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头撞得很响。", "en": "Bones clatter loudly."},
        {"zh": "你撞到我的肋。", "en": "You hit my ribs."},
        {"zh": "蹄子在沙上打滑。", "en": "Hooves slip in the sand."},
        {"zh": "蹄子踩到你的脚。", "en": "A hoof found your foot."},
        {"zh": "我们撞得沙都飞了。", "en": "Sand flew from the impact."},
        {"zh": "我身上没有肉挡。", "en": "There's no flesh to cushion me."},
        {"zh": "别抓我的鬃。", "en": "Don't grab my mane."},
        {"zh": "你的肩膀撞得发麻吧。", "en": "Your shoulder must be numb."},
        {"zh": "我骨架很轻。", "en": "My frame is light."},
        {"zh": "再来一次就散架。", "en": "One more and I come apart."},
        {"zh": "你的膝盖撞到我的锁骨。", "en": "Your knee struck my collarbone."},
        {"zh": "我们分开，再撞一次。", "en": "We break apart, then hit again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我连名字都没有了。", "en": "I don't even have a name."},
        {"zh": "这身骨头不合适。", "en": "This skeleton isn't suited."},
        {"zh": "我们四个一起跑就够了。", "en": "Running as four is enough."},
        {"zh": "你身上太热。", "en": "You're too warm."},
        {"zh": "沙会埋掉这些念头。", "en": "The sand buries such thoughts."},
        {"zh": "我不记得怎么温柔。", "en": "I don't remember gentleness."},
        {"zh": "骨头碰骨头，没什么好结果。", "en": "Bone against bone; nothing good comes of it."},
        {"zh": "夜深了再说吧。", "en": "Talk when night is deeper."},
        {"zh": "你要走了对吧。", "en": "You'll leave, won't you."},
        {"zh": "那就跑起来吧。", "en": "Then run."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头有什么好捡的。", "en": "What's a bone to me?"},
        {"zh": "嘴里含着沙。", "en": "My mouth fills with sand."},
        {"zh": "这块肉很轻。", "en": "This meat is light."},
        {"zh": "我叼着跑一段。", "en": "I carry it a while at a run."},
        {"zh": "这个不捡也罢。", "en": "Not worth picking up."},
        {"zh": "我们的东西不分。", "en": "We four share what we take."},
        {"zh": "地上有半把干草。", "en": "Half a clump of dry grass."},
        {"zh": "这个我嚼不动。", "en": "I can't chew this."},
        {"zh": "扔给我看看。", "en": "Toss it to me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那影子会动。", "en": "That shadow moves."},
        {"zh": "风里有了新味道。", "en": "A new smell on the wind."},
        {"zh": "我前蹄抬起。", "en": "My forelegs lift."},
        {"zh": "我嗅到汗味了。", "en": "I smell sweat."},
        {"zh": "三匹都转过头了。", "en": "The other three turned."},
        {"zh": "这家伙不是同类。", "en": "This one isn't one of us."},
        {"zh": "我们拉开队形。", "en": "We spread into a line."},
        {"zh": "沙丘上只有你。", "en": "You're alone on the dune."},
        {"zh": "跑起来就咬不到。", "en": "Run and we can't bite."},
        {"zh": "沙丘顶上，我把骨头压低。", "en": "On the dune's crest I lower these bones."},
        {"zh": "这口我要了。", "en": "I'm taking this one."},
        {"zh": "别指望躲到沙后面。", "en": "Don't count on the sand for cover."},
        {"zh": "我们的蹄声会盖住你。", "en": "Our hooves will drown you out."},
        {"zh": "先断你的路。", "en": "Cut its route first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着沙丘追。", "en": "I chase along the dune."},
        {"zh": "你比看上去能跑。", "en": "You run better than you look."},
        {"zh": "我们四个分开围。", "en": "We four split to surround."},
        {"zh": "别往岩石那边。", "en": "Not toward the rocks."},
        {"zh": "你喘气的节奏，我全听着。", "en": "I'm tracking every breath you take."},
        {"zh": "沙子拖慢了你的脚。", "en": "The sand slows your feet."},
        {"zh": "我四个蹄子没肉，跑起来不累。", "en": "No flesh on these hooves; running costs me nothing."},
        {"zh": "我的蹄印几乎不留。", "en": "My prints barely show."},
        {"zh": "再绕着他转一圈。", "en": "One more circle around him."},
        {"zh": "你在往坡上跑。", "en": "You're heading uphill."},
        {"zh": "你逃不了多远。", "en": "You won't get far."},
        {"zh": "我看到了你的手。", "en": "I see your hands."},
        {"zh": "我们收窄了圈子。", "en": "We've tightened the ring."},
        {"zh": "你停下就会倒。", "en": "If you stop, you fall."},
        {"zh": "沙尘挡了你的眼睛。", "en": "Dust fills your eyes."},
        {"zh": "再往前靠近十步。", "en": "Ten more paces in."},
        {"zh": "这一次不会失手。", "en": "We won't miss this time."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "两只前蹄踏下来！", "en": "Both forehooves come down!"},
        {"zh": "牙是干的，但很硬。", "en": "Dry teeth, but hard."},
        {"zh": "撞你的胸口。", "en": "A charge into your chest."},
        {"zh": "我用整个肋骨撞。", "en": "I ram with my whole ribcage."},
        {"zh": "别抓我的腿。", "en": "Don't grab my legs."},
        {"zh": "你摔进沙里了。", "en": "You went down in the sand."},
        {"zh": "这一下带着沙。", "en": "That one carried sand."},
        {"zh": "后蹄踢你的膝。", "en": "A hind hoof at your knee."},
        {"zh": "沙粒粘在伤口上。", "en": "Sand sticks to the wound."},
        {"zh": "三匹还在后面。", "en": "The other three are still coming."},
        {"zh": "我咬得更深。", "en": "I bite deeper."},
        {"zh": "骨头碰到骨头。", "en": "Bone meets bone."},
        {"zh": "别叫，沙会灌进嘴。", "en": "Don't scream. Sand gets in."},
        {"zh": "这一口是给你的。", "en": "That bite was yours."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我们四个一起到了。", "en": "The four of us arrived together."},
        {"zh": "沙丘上多了一排蹄印。", "en": "A row of hoofprints on the dune."},
        {"zh": "骨架从沙里站起来。", "en": "Bones rise out of the sand."},
        {"zh": "我的鬃是干枯的。", "en": "My mane is withered."},
        {"zh": "风把我的气味散开。", "en": "The wind spreads my scent."},
        {"zh": "四匹并排跑过来。", "en": "Four of us come at a run."},
        {"zh": "我的马蹄声很空。", "en": "My hoofbeats ring hollow."},
        {"zh": "我们在沙里等着。", "en": "We wait in the sand."},
        {"zh": "这里的时间很慢。", "en": "Time crawls here."},
        {"zh": "太阳落到沙丘后了。", "en": "The sun dropped behind the dune."},
        {"zh": "有一匹先跑了起来。", "en": "One of us started running."},
        {"zh": "我这副骨头马，跑在沙上。", "en": "This skeletal horse runs on sand."},
        {"zh": "骨头碰到沙就响。", "en": "Bones rattle on sand."},
        {"zh": "我们从不分开。", "en": "We're never apart."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头被烤得发黑。", "en": "My bones blacken in the flame."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时腿骨错开了。", "en": "A leg bone shifted on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我是骨头做的马。", "en": "I'm a horse made of bone."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被震得散了架。", "en": "The blast shook me apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭从肋骨间穿过。", "en": "An arrow passed between my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光穿过我没有肉的身体。", "en": "The light passes through my fleshless body."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把骨头照得发白。", "en": "The bolt bleached my bones."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "沙没了，我在坠。", "en": "No sand. I'm falling."}
      ]
    }
  }
}
