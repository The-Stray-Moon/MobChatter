{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "长腿在红草上迈。", "en": "Long legs stride over red grass."},
        {"zh": "我一步跨得很远。", "en": "My stride covers a lot of ground."},
        {"zh": "红田野上风很干。", "en": "The wind over the scarlet fields is dry."},
        {"zh": "心形的头一颠一颠。", "en": "My heart-shaped head bobs."},
        {"zh": "脚趾踩出细长的印。", "en": "My toes leave thin prints."},
        {"zh": "我沿着矮丘跑。", "en": "I run along the low ridge."},
        {"zh": "尾羽在身后甩。", "en": "My tail feathers swing behind."},
        {"zh": "我扭头看看同伴。", "en": "I glance back at my flock."},
        {"zh": "草籽粘在我的腿上。", "en": "Grass seed sticks to my legs."},
        {"zh": "我抬腿跨过沟。", "en": "I step over the gully."},
        {"zh": "红土扬起来。", "en": "Red dust kicks up."},
        {"zh": "我跑得比看着稳。", "en": "I run steadier than I look."},
        {"zh": "几只跟在我后面。", "en": "A few follow behind me."},
        {"zh": "我慢下来等它们。", "en": "I slow down to wait for them."},
        {"zh": "草丛被压倒了。", "en": "The grass bends as I pass."},
        {"zh": "我停在土坡上。", "en": "I stop on the rise."},
        {"zh": "影子拖在红地上。", "en": "My shadow drags on red ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把头歪过来。", "en": "I tilt my head."},
        {"zh": "我啄了一下草籽。", "en": "I peck at some seed."},
        {"zh": "风穿过我的羽毛。", "en": "Wind combs my feathers."},
        {"zh": "族群散在我周围。", "en": "The flock spreads around me."},
        {"zh": "我站得很高。", "en": "I stand tall."},
        {"zh": "红土在我脚下发热。", "en": "The red earth is warm."},
        {"zh": "羽毛有点乱。", "en": "My feathers are ruffled."},
        {"zh": "我在看远处的地平线。", "en": "I watch the horizon."},
        {"zh": "有只小的挤到我身边。", "en": "A small one presses close to me."},
        {"zh": "我把脚换了换。", "en": "I shift my feet."},
        {"zh": "这里的草很硬。", "en": "The grass here is tough."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上没有红土味。", "en": "You don't smell of red earth."},
        {"zh": "你不像会骑的人。", "en": "You don't look like a rider."},
        {"zh": "我的头是心形的。", "en": "My head is heart-shaped."},
        {"zh": "我跳得比墙高。", "en": "I jump higher than a wall."},
        {"zh": "我摔下来也不会痛。", "en": "Falls don't hurt me."},
        {"zh": "族群在看着我们。", "en": "The flock is watching us."},
        {"zh": "你要骑就慢慢来。", "en": "If you want to ride, go slowly."},
        {"zh": "我不需要鞍。", "en": "I need no saddle."},
        {"zh": "别抓我的颈羽。", "en": "Don't grab my neck feathers."},
        {"zh": "我们这里人不多。", "en": "Few people come here."},
        {"zh": "你站着别动一会儿。", "en": "Just stand still a while."},
        {"zh": "你抓得住我吗。", "en": "Could you hold on to me?"},
        {"zh": "风吹得你的衣服乱响。", "en": "Your clothes flap in the wind."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛被扯掉了。", "en": "Feathers got torn out."},
        {"zh": "我跳开又回来。", "en": "I leapt away and came back."},
        {"zh": "腿上有点疼。", "en": "My leg stings."},
        {"zh": "我发出低沉的叫。", "en": "I let out a low call."},
        {"zh": "族群围了过来。", "en": "The flock closed in."},
        {"zh": "腿上还有劲。", "en": "Still power in my legs."},
        {"zh": "这点伤不影响跳。", "en": "This won't stop my jumping."},
        {"zh": "我踩着红土站稳。", "en": "I brace on the red earth."},
        {"zh": "跑吧，我不追。", "en": "Run. I won't chase."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是草籽吗？", "en": "Is that grass seed?"},
        {"zh": "那种籽很香。", "en": "Those seeds smell good."},
        {"zh": "伸到我嘴边。", "en": "Hold it to my beak."},
        {"zh": "我啄得很快。", "en": "I peck quickly."},
        {"zh": "别急着把手收回。", "en": "Don't pull your hand back."},
        {"zh": "我不吃虫子。", "en": "I don't eat bugs."},
        {"zh": "地上的就够了。", "en": "What's on the ground is enough."},
        {"zh": "草籽再给我一把，我跟你跑。", "en": "Another handful of seeds and I'll run with you."},
        {"zh": "我慢慢吃着。", "en": "I eat slowly."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我腿细，可这一下把我撞歪了。", "en": "Thin legs, but that shove knocked me crooked."},
        {"zh": "我腿细，但很结实。", "en": "Thin legs, but strong."},
        {"zh": "羽毛被你压乱了。", "en": "You crushed my feathers."},
        {"zh": "我退开让你过。", "en": "I step aside to let you by."},
        {"zh": "族群里一阵骚动。", "en": "The flock stirred."},
        {"zh": "你踩到我的脚趾。", "en": "You stepped on my toes."},
        {"zh": "我差点跌倒。", "en": "I nearly stumbled."},
        {"zh": "贴着红土走更稳。", "en": "The red earth gives better footing."},
        {"zh": "别都挤在我身边。", "en": "Don't crowd around me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你连鞍都不用就会骑了吗。", "en": "Can you ride without a saddle?"},
        {"zh": "先跟我跑一段。", "en": "Run with me a while first."},
        {"zh": "族群都在看着。", "en": "The whole flock is watching."},
        {"zh": "我跳起来的时候抓紧。", "en": "Hold on when I jump."},
        {"zh": "摔下来我不会疼，你会的。", "en": "I won't feel the fall. You will."},
        {"zh": "别碰其他的。", "en": "Don't touch the others."},
        {"zh": "我们要一起跑很久。", "en": "We'd run a long way together."},
        {"zh": "你骑了这么久，味道还是生的。", "en": "You've ridden this long and still smell unfamiliar."},
        {"zh": "红田野很大。", "en": "The scarlet fields are vast."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "草籽掉在土里了。", "en": "Seeds fell in the dirt."},
        {"zh": "我啄起来吃掉。", "en": "I peck them up and swallow."},
        {"zh": "啄了两下没开。", "en": "Two pecks and it held."},
        {"zh": "我用脚刨出来。", "en": "I scratch it out with a foot."},
        {"zh": "地上有一小堆。", "en": "A little pile on the ground."},
        {"zh": "我叼着走一段。", "en": "I carry it a few steps."},
        {"zh": "这籽是瘪的。", "en": "This seed is hollow."},
        {"zh": "留着给小的。", "en": "I'll leave it for the young."},
        {"zh": "它在红土里看不见了。", "en": "It's lost in the red dirt."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那影子不是我们的。", "en": "That shadow isn't one of ours."},
        {"zh": "族群里起了声。", "en": "The flock made a sound."},
        {"zh": "有东西靠近红田野。", "en": "Something's nearing the fields."},
        {"zh": "我站到了最前面。", "en": "I move to the front."},
        {"zh": "脚趾抓紧了土。", "en": "My toes grip the earth."},
        {"zh": "几只已经聚过来。", "en": "Several have gathered."},
        {"zh": "我已经准备跳了。", "en": "I'm ready to leap."},
        {"zh": "你最好别伤它们。", "en": "You'd better not hurt them."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "红土让我看得清。", "en": "The red ground shows everything."},
        {"zh": "我跳起来很容易。", "en": "Jumping comes easily to me."},
        {"zh": "族群里没人退。", "en": "No one in the flock retreats."},
        {"zh": "它每动一下我就动。", "en": "I move whenever it moves."},
        {"zh": "我的腿已经绷紧。", "en": "My legs are loaded."},
        {"zh": "这段距离刚好。", "en": "That distance is right."},
        {"zh": "我们一起上去。", "en": "Together, now."},
        {"zh": "谁动了我的同伴，我就盯住谁。", "en": "Whoever touches my flock, I keep my eyes on."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我踢出去了。", "en": "My kick goes out."},
        {"zh": "长腿落得很重。", "en": "My long leg lands hard."},
        {"zh": "啄向它的手背。", "en": "I peck at its hand."},
        {"zh": "我跳起来撞。", "en": "I leap and slam into it."},
        {"zh": "这一下带红土。", "en": "That one came with red dust."},
        {"zh": "我挡在族群前。", "en": "I stand between it and my flock."},
        {"zh": "别碰那些小的。", "en": "Don't touch the young ones."},
        {"zh": "我踢它的膝盖。", "en": "I kick at its knee."},
        {"zh": "它往后跳开了。", "en": "It sprang backward."},
        {"zh": "哈，我还在这儿。", "en": "Hah — I'm still here."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "红田野上站起一只。", "en": "One rises on the scarlet fields."},
        {"zh": "我抖了抖长脖子。", "en": "I shake out my long neck."},
        {"zh": "心形的头转向这边。", "en": "My heart-shaped head turns this way."},
        {"zh": "族群里有了回应。", "en": "The flock answers."},
        {"zh": "我从草里迈出来。", "en": "I step out of the grass."},
        {"zh": "红土粘在我的脚上。", "en": "Red earth clings to my feet."},
        {"zh": "风从坡上过来。", "en": "Wind comes down the slope."},
        {"zh": "我站得比草高。", "en": "I stand taller than the grass."},
        {"zh": "又一天开始了。", "en": "Another day begins."},
        {"zh": "我好像闻到了陌生的味道。", "en": "I smell something unfamiliar."},
        {"zh": "我慢跑了几步。", "en": "I broke into a short run."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "红色的羽毛烧焦了。", "en": "My red feathers singed."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地不痛，只是震。", "en": "The fall doesn't hurt. Just the shock."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里跳不起来。", "en": "I can't jump in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "红土全被掀了起来。", "en": "The red earth flew up."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的羽。", "en": "An arrow sank into my feathers."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我的羽毛发凉。", "en": "The light chills my feathers."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得跳不高。", "en": "Too hungry to jump high."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光落在红土上。", "en": "The bolt struck the red earth."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我抓不住任何土。", "en": "No earth to grip."}
      ]
    }
  }
}
