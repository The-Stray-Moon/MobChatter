{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在灰树林间快步走过。", "en": "I move quickly through the ashen wood."},
        {"zh": "我的脚踩在灰上，扬起细尘。", "en": "My feet raise fine ash."},
        {"zh": "我尽量避开开阔地。", "en": "I keep out of the open where I can."},
        {"zh": "我贴着烧焦的树干走。", "en": "I keep to the charred trunks."},
        {"zh": "我的皮肤上有暗红的裂纹。", "en": "Dark red cracks run across my hide."},
        {"zh": "我走过的地方，灰会陷下去。", "en": "The ash sinks where I pass."},
        {"zh": "身后只有灰，我继续走", "en": "Only ash behind me; I walk on."},
        {"zh": "后面没有东西。", "en": "Nothing behind."},
        {"zh": "我又加快了两步。", "en": "I quicken two paces."},
        {"zh": "我在树后停了一下。", "en": "I pause behind a tree."},
        {"zh": "这里风小一些。", "en": "Less wind here."},
        {"zh": "我换了个方向走。", "en": "I take another direction."},
        {"zh": "地上有烧过的根。", "en": "Burnt roots in the ground."},
        {"zh": "我一步跨过去。", "en": "I step over them."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，喉咙里有暗火。", "en": "I stand with a dull fire in my throat."},
        {"zh": "我不抖，让灰盖住背", "en": "I do not shake; let the ash cover my back."},
        {"zh": "我抖了一下，灰散了。", "en": "I shake and it scatters."},
        {"zh": "我在看远处那群。", "en": "I am watching the others far off."},
        {"zh": "它们也在看我。", "en": "They are watching me too."},
        {"zh": "我们都不靠近。", "en": "None of us comes closer."},
        {"zh": "这是我这一族的方式。", "en": "That is the way of my kind."},
        {"zh": "我的呼吸带出一点热。", "en": "My breath carries a little heat."},
        {"zh": "脚下的灰在冒烟。", "en": "The ash under me smokes."},
        {"zh": "我把脚挪开。", "en": "I shift my feet away."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了灰树林，我看见了。", "en": "You have entered the ashen wood. I see you."},
        {"zh": "我停下，先看你手里。", "en": "I stop and look at your hands first."},
        {"zh": "没有火把，很好。", "en": "No torch. Good."},
        {"zh": "灰林的树，替我挡着你的视线。", "en": "The ashen trees block your view of me."},
        {"zh": "你还在往前走。", "en": "You keep coming."},
        {"zh": "我张开嘴，让你看见喉咙。", "en": "I open my mouth so you see my throat."},
        {"zh": "那里面有点光。", "en": "There is light in it."},
        {"zh": "你退两步，我喉里的火暗了", "en": "You step back two paces; my throat-fire dims."},
        {"zh": "这样才算像话。", "en": "That is more like it."},
        {"zh": "你走你的，我们各走各的", "en": "You go your way; we go ours."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了两步，喉咙亮起来。", "en": "I fall back two paces, throat glowing."},
        {"zh": "灰从伤口里冒出来。", "en": "Ash rises from the wound."},
        {"zh": "我低头喘了一下。", "en": "I lower my head and gasp."},
        {"zh": "身上的裂纹更亮了。", "en": "The cracks on me brighten."},
        {"zh": "这一下让我不太稳。", "en": "That left me unsteady."},
        {"zh": "灰林的树，挡了我一下。", "en": "An ashen tree caught me."},
        {"zh": "树皮被烫黑了。", "en": "The bark blackens where I touch it."},
        {"zh": "我赶紧挪开了。", "en": "I move away quickly."},
        {"zh": "火还在喉咙里。", "en": "The fire is still in my throat."},
        {"zh": "那我还能再打。", "en": "Then I can still fight."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西我不吃，别递。", "en": "I don't eat that. Don't offer."},
        {"zh": "你把那东西举起来了。", "en": "You've lifted that thing up."},
        {"zh": "灰林的居民，看归看，不动。", "en": "Ashen Woods resident — I look, but don't move."},
        {"zh": "灰树林里没有我爱吃的。", "en": "There is nothing I like in the ashen wood."},
        {"zh": "我往前半步，又停。", "en": "I take half a step, then stop."},
        {"zh": "那东西在冒热气。", "en": "That thing is steaming."},
        {"zh": "烫手的东西，我离远点", "en": "Anything hot in hand, I keep my distance."},
        {"zh": "我把背转过去。", "en": "I turn my back."},
        {"zh": "你最好也离开。", "en": "You had best leave too."},
        {"zh": "这里不适合你。", "en": "This place is not for you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我立刻跳开。", "en": "You bump me and I spring away."},
        {"zh": "我的喉咙亮了一下。", "en": "My throat glows once."},
        {"zh": "那只是警告。", "en": "That was only a warning."},
        {"zh": "我退到树后去。", "en": "I retreat behind the tree."},
        {"zh": "再近一步，喉咙就亮", "en": "One step closer and my throat lights."},
        {"zh": "我身上的灰被撞掉了。", "en": "The ash is knocked off me."},
        {"zh": "底下的皮肤更红。", "en": "The hide beneath is redder."},
        {"zh": "灰从肩上落了，我看看", "en": "Ash fell from my shoulder; I check."},
        {"zh": "又抬起头看你。", "en": "Then up at you."},
        {"zh": "灰林里，我们隔着三步", "en": "In the ashen wood, three paces between us."},
        {"zh": "我想让开，脚下打了个滑。", "en": "I try to clear the way and slip."},
        {"zh": "我扶着树，站定了。", "en": "I brace on a tree and steady."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "那群里有另一位。", "en": "There is another in the group."},
        {"zh": "我们隔着一段灰地对看。", "en": "We look at each other across the ash."},
        {"zh": "然后各自转开。", "en": "Then we each turn away."},
        {"zh": "灰树林的规矩就是这样。", "en": "That is the custom of the ashen wood."},
        {"zh": "我不会靠近她。", "en": "I will not approach her."},
        {"zh": "靠得太近会烫。", "en": "Too close, and it burns."},
        {"zh": "所以我们就这么站着。", "en": "So we stand as we are."},
        {"zh": "隔着一段距离。", "en": "At a distance."},
        {"zh": "过一会儿我就走了。", "en": "After a while I leave."},
        {"zh": "灰上留下两串脚印。", "en": "Two trails of prints remain in the ash."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上烧着火，别靠太近。", "en": "I'm burning. Don't come too close."},
        {"zh": "是块烧过的木头。", "en": "A piece of burnt wood."},
        {"zh": "我的手指一碰，它就碎了。", "en": "One touch and it crumbles."},
        {"zh": "我把手甩了甩。", "en": "I shake my hand."},
        {"zh": "灰沾在我的指缝里。", "en": "Ash is caught between my fingers."},
        {"zh": "我把它抹在树干上。", "en": "I wipe it on a trunk."},
        {"zh": "手又干净了。", "en": "My hand is clean again."},
        {"zh": "我照着原路走。", "en": "I go on along my path."},
        {"zh": "焦木一碰就碎，不值", "en": "Burnt wood crumbles at a touch; not worth it."},
        {"zh": "这里没有值得带的。", "en": "Nothing here worth carrying."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "四只同伴，都闻到它了", "en": "All four of my companions smell it."},
        {"zh": "灰烬林里，我们四只一群。", "en": "In the Ashen Woods, we come four at a time."},
        {"zh": "喉咙里的火开始动了。", "en": "The fire in my throat stirs."},
        {"zh": "我把嗓子压低。", "en": "I sink my body low."},
        {"zh": "它在往我这边来，正好。", "en": "It's coming my way. Good."},
        {"zh": "我退了一步，又停。", "en": "I give a step, then stop."},
        {"zh": "退到这个距离够了。", "en": "That distance is far enough."},
        {"zh": "我张嘴露出暗火。", "en": "I open my mouth and show the ember."},
        {"zh": "热从牙缝里出去。", "en": "Heat escapes between my teeth."},
        {"zh": "它瞧见我了。", "en": "It sees me."},
        {"zh": "它定在原地。", "en": "It freezes in place."},
        {"zh": "可它没有走。", "en": "But it does not leave."},
        {"zh": "那我也只能动了。", "en": "Then I must move too."},
        {"zh": "四只一起，从灰里冲出去", "en": "Four of us burst out of the ash at once."},
        {"zh": "一口就够了。", "en": "One burst is enough."},
        {"zh": "然后我就走。", "en": "Then I go."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在灰里，只露喉光", "en": "I crouch in the ash, showing only my throat-light."},
        {"zh": "灰盖住了我的脚。", "en": "Ash covers my feet."},
        {"zh": "我绕着它走动。", "en": "I walk around it."},
        {"zh": "灰被我的脚扫起来。", "en": "My feet sweep up ash."},
        {"zh": "它转过来看我。", "en": "It turns to watch me."},
        {"zh": "我就停住脚。", "en": "So I stop."},
        {"zh": "它转回去，我又动。", "en": "It turns away, and I move again."},
        {"zh": "喉咙一直亮着。", "en": "My throat stays lit."},
        {"zh": "等它侧过身，再喷一口", "en": "I wait for it to turn, then spit."},
        {"zh": "从侧面下手最好。", "en": "The flank is best."},
        {"zh": "我贴着一棵树过去。", "en": "I slip along a tree."},
        {"zh": "它没有瞧见。", "en": "It did not see."},
        {"zh": "我把距离又缩短。", "en": "I shorten the distance."},
        {"zh": "它正喘着气。", "en": "It is breathing hard."},
        {"zh": "灰树林里很热。", "en": "It is hot in the ashen wood."},
        {"zh": "对它是热，对我不算。", "en": "For it. Not for me."},
        {"zh": "我站在它侧后。", "en": "I am at its back quarter."},
        {"zh": "它还没转过身。", "en": "It has not turned."},
        {"zh": "我的牙缝里冒出热气。", "en": "Heat leaks between my teeth."},
        {"zh": "现在喷出去。", "en": "Spit it out now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口喷出一团火。", "en": "I spit a burst of flame."},
        {"zh": "火扑到它身上。", "en": "The fire takes it."},
        {"zh": "它退了，拍打着衣服。", "en": "It recoils, beating at itself."},
        {"zh": "我冲上去撞了一下。", "en": "I charge and strike."},
        {"zh": "然后我又退开。", "en": "Then I pull back."},
        {"zh": "我不喜欢贴太近。", "en": "I do not like to be close."},
        {"zh": "它在地上打滚。", "en": "It rolls on the ground."},
        {"zh": "我站在几步外看着。", "en": "I watch from a few paces off."},
        {"zh": "它还没有断气。", "en": "It is not finished yet."},
        {"zh": "我张开嘴，准备第二次。", "en": "I open my mouth for a second burst."},
        {"zh": "它抬手挡住了。", "en": "It raises an arm to block."},
        {"zh": "火散在灰里。", "en": "The fire scatters on the ash."},
        {"zh": "火喷完了，我喉咙发烫", "en": "The burst is out; my throat burns."},
        {"zh": "我的喉咙有点疼。", "en": "My throat aches a little."},
        {"zh": "我绕着它转，找下一次机会。", "en": "I circle it, looking for the next opening."},
        {"zh": "火在我嘴里翻。", "en": "Fire churns in my mouth."},
        {"zh": "我又喷了一口。", "en": "I spit again."},
        {"zh": "这一口更短了。", "en": "This one is shorter."},
        {"zh": "我的喉咙在收紧。", "en": "My throat is tightening."},
        {"zh": "我退进了灰里。", "en": "I retreat into the ash."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "灰堆翻开，我探出半个身子", "en": "The ash heap parts; I rise half out of it."},
        {"zh": "身上的灰一层层落下去。", "en": "Ash falls off me in sheets."},
        {"zh": "我的喉咙里还有余火。", "en": "There is still fire in my throat."},
        {"zh": "这片树林烧过。", "en": "This wood has burned."},
        {"zh": "这地方很合我意。", "en": "This place suits me."},
        {"zh": "远处有几只同类。", "en": "There are others far off."},
        {"zh": "它们也是刚醒的。", "en": "They too have just woken."},
        {"zh": "我们彼此看了一眼。", "en": "We look at one another."},
        {"zh": "然后各走各的。", "en": "Then go our separate ways."},
        {"zh": "灰积在颈后，我懒得抖", "en": "Ash piles at my nape; I cannot be bothered to shake."},
        {"zh": "我没有把它拍掉。", "en": "I do not brush it off."},
        {"zh": "我迈开步子走。", "en": "I begin to walk."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我没什么用，可还是烫。", "en": "Fire does little to me, but it still burns."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处摔下，砸进灰里。", "en": "I fall from height into the ash."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进喉咙，我的火差点灭。", "en": "Water floods my throat and my fire nearly goes out."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀翻，灰扑了一身。", "en": "The blast flips me and ash covers me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭镞钻进我的肩膀。", "en": "An arrowhead buries in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪力压住我喉咙里的火。", "en": "Strange force clamps the fire in my throat."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有东西烧，我的火弱了。", "en": "Nothing to burn, and my fire weakens."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我整个人都亮了。", "en": "Lightning strikes and I light up all over."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "灰地没了，我在黑里坠。", "en": "The ash is gone and I fall through black."}
      ]
    }
  }
}
