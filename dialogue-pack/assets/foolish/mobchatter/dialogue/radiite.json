{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小跑着穿过荒地，尾巴翘着。", "en": "I trot across the wasteland, tail up."},
        {"zh": "步子碎，声音也小。", "en": "Short steps, quiet too."},
        {"zh": "我贴着石头边跑过去。", "en": "I run along the rock's edge."},
        {"zh": "扬起来的尘土是黄褐色的。", "en": "The dust I kick up is tawny."},
        {"zh": "我一边跑一边看两边。", "en": "I run and watch both sides."},
        {"zh": "爪子在硬土上敲出细响。", "en": "Claws tap on hard earth."},
        {"zh": "我跳过一道裂缝。", "en": "I hop over a crack."},
        {"zh": "我的身体很小，容易藏。", "en": "My body is small and easy to hide."},
        {"zh": "我绕着一丛枯草转。", "en": "I circle a clump of dry grass."},
        {"zh": "我停下来闻了闻。", "en": "I stop to sniff."},
        {"zh": "我一直贴着地势低的地方走。", "en": "I keep to the low ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在石头上，耳朵动。", "en": "Crouched on a rock, ears twitching."},
        {"zh": "我在啃一小块干东西。", "en": "I gnaw a small dry thing."},
        {"zh": "我的尾巴扫过地面。", "en": "My tail brushes the ground."},
        {"zh": "荒地里没多少活物。", "en": "Not much lives in the wasteland."},
        {"zh": "废土的放射体，缩得更小。", "en": "A wasteland radiant curls smaller."},
        {"zh": "风里有沙子的味道。", "en": "There is sand in the wind."},
        {"zh": "沙子钻进毛里，我甩开。", "en": "Sand works into my fur; I shake it."},
        {"zh": "荒原的风吹过来，我就在这儿晒着。", "en": "The wasteland wind blows and I just bask in it."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你离我太拢了。", "en": "You are far too near."},
        {"zh": "废土上的石头带着辐射。", "en": "The stones of this wasteland carry radiation."},
        {"zh": "我不惹你，你也别惹我。", "en": "I do not bother you. Do not bother me."},
        {"zh": "我在这一带找吃的。", "en": "I am looking for food around here."},
        {"zh": "我这么小，不值得你动手。", "en": "I am too small to be worth it."},
        {"zh": "你蹲下来，我退到石缝。", "en": "You crouch; I back into a crevice."},
        {"zh": "我往后退出去了。", "en": "I have backed away."},
        {"zh": "荒地里没地方躲。", "en": "There is nowhere to hide in the wasteland."},
        {"zh": "你的脚别挪动。", "en": "Do not shift your feet."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我挨了这一下，腿都软了。", "en": "That one took the strength from my legs."},
        {"zh": "我一口气窜出老远。", "en": "I bolted a long way off."},
        {"zh": "腿上有一道口子。", "en": "A cut on my leg."},
        {"zh": "我缩在石头后面。", "en": "I curl up behind a stone."},
        {"zh": "疼，可我还跑得动。", "en": "It hurts, but I can still run."},
        {"zh": "我的血从耳后滴到硬土。", "en": "My blood drips from behind my ear."},
        {"zh": "血滴在沙地上。", "en": "Blood drips on the sand."},
        {"zh": "我把头低了下去。", "en": "I keep my head down."},
        {"zh": "这点伤，忍得住。", "en": "I can bear this."},
        {"zh": "别再往这边挪了。", "en": "Do not edge any closer."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那点吃的，给我。", "en": "That bit of food. Give it."},
        {"zh": "给我什么我都吃。", "en": "Whatever you give me, I eat."},
        {"zh": "把它扔在地上。", "en": "Throw it on the ground."},
        {"zh": "这味道闻着不赖。", "en": "That smells decent."},
        {"zh": "我只要那点吃的，放地上。", "en": "I only want that food, on the ground."},
        {"zh": "这味道，值得我冒个险。", "en": "This smell is worth the risk."},
        {"zh": "这么点不够吃。", "en": "That is not enough to eat."},
        {"zh": "你别跟着我上来。", "en": "Do not follow me up here."},
        {"zh": "再多扔一点过来。", "en": "Throw a little more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你蹭了我一下。", "en": "You grazed me."},
        {"zh": "废土里，我身上有点辐射热。", "en": "In the wasteland, my body carries a little radiation heat."},
        {"zh": "我这么小，一碰就翻。", "en": "So small. One nudge overturns me."},
        {"zh": "这点事，不值得计较。", "en": "Not worth making anything of."},
        {"zh": "尾巴被你踩了。", "en": "You stepped on my tail."},
        {"zh": "离远一点说话。", "en": "Talk from further away."},
        {"zh": "地面很硬，摔着疼。", "en": "Hard ground. Falling hurts."},
        {"zh": "我不挡你的路。", "en": "I am not blocking your way."},
        {"zh": "你从那边绕过去。", "en": "Go around that way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这荒地里同类不多。", "en": "There are few of my kind here."},
        {"zh": "得先找着水源。", "en": "Water first."},
        {"zh": "每群就四只，够挤了。", "en": "Four to a group is crowded enough."},
        {"zh": "等过了这片干地。", "en": "Once past this dry stretch."},
        {"zh": "我才刚找到窝。", "en": "I only just found a den."},
        {"zh": "这季节没东西吃。", "en": "Nothing to eat this season."},
        {"zh": "这会儿不合适。", "en": "Not at this moment."},
        {"zh": "别往我身上凑。", "en": "Do not crowd me."},
        {"zh": "过一阵子再说。", "en": "Some other time."},
        {"zh": "我先走一步了。", "en": "I am going on ahead."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有块碎东西。", "en": "A scrap on the ground."},
        {"zh": "吃不下去，吐了。", "en": "Cannot swallow. I spit it out."},
        {"zh": "这个根本啃不动。", "en": "This will not chew at all."},
        {"zh": "我拖着走了两步。", "en": "I drag it two steps."},
        {"zh": "你快把手撒开。", "en": "Let go of it quickly."},
        {"zh": "这颗碎石我会收好，别来抢。", "en": "I'll keep this pebble safe. Don't try to take it."},
        {"zh": "废土上掉的东西，都算我的。", "en": "Whatever drops in the wastes belongs to me."},
        {"zh": "捡起来容易，守得住才算本事。", "en": "Picking it up is easy, keeping it is the real trick."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有点动静。", "en": "Something shifted over there."},
        {"zh": "我停住不动了。", "en": "I have come to a stop."},
        {"zh": "你挡在我前面。", "en": "You are in front of me."},
        {"zh": "我把身子伏低。", "en": "I go low."},
        {"zh": "这里没有石头可躲。", "en": "No rock to hide behind."},
        {"zh": "你只要再走一步。", "en": "Just one more step."},
        {"zh": "你抬手，我后腿就绷紧。", "en": "You raise a hand; my hind legs tense."},
        {"zh": "不走我就反击。", "en": "If you do not go, I hit back."},
        {"zh": "四只都在附近。", "en": "Four of us are near."},
        {"zh": "我四只同类都在你右边。", "en": "Four of my kin are on your right."},
        {"zh": "我抬起头，看你比我高多少。", "en": "I look up to see how much taller you are."},
        {"zh": "你没拿武器，我不信。", "en": "No weapon in hand. I do not believe it."},
        {"zh": "这附近还有三只同类。", "en": "Three of my kin are close by."},
        {"zh": "我要不要先叫你一声。", "en": "Should I give you a warning first?"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着圈看你。", "en": "I watch you while circling."},
        {"zh": "我和你的距离不变。", "en": "The distance stays the same."},
        {"zh": "你一动我就退。", "en": "You move and I back off."},
        {"zh": "沙地上不好跑快。", "en": "The sand makes running hard."},
        {"zh": "我数着你留下的印子。", "en": "I count the prints you leave."},
        {"zh": "我把耳朵压平了。", "en": "My ears are laid flat."},
        {"zh": "我找到一块高点的石头。", "en": "I found a higher rock."},
        {"zh": "再近我就咬你。", "en": "Any closer and I bite."},
        {"zh": "这样挺不错的。", "en": "This is quite good."},
        {"zh": "废土的石头，替我挡了半个身。", "en": "A wasteland rock hides half of me."},
        {"zh": "你左脚踩进了松土。", "en": "Your left foot sank in loose soil."},
        {"zh": "我在算你离石头还有几步。", "en": "I count your steps to the rock."},
        {"zh": "我算着你还有几步到石头。", "en": "I count your steps to the rock."},
        {"zh": "风把沙吹进我的眼睛。", "en": "Sand blows into my eyes."},
        {"zh": "你先动，我就躲。", "en": "You move first, I dodge."},
        {"zh": "我不叫，叫了没用。", "en": "I do not cry out. It would do no good."},
        {"zh": "我的尾巴绷住了。", "en": "My tail is stiff."},
        {"zh": "地面太干，跑起来有灰。", "en": "The ground is so dry it raises dust."},
        {"zh": "再熬一小会儿。", "en": "Hold out a bit longer."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上去咬你的脚踝。", "en": "I snap at your ankle."},
        {"zh": "爪子挠了一下。", "en": "A claw swipe."},
        {"zh": "这一下力气很小。", "en": "There is very little force in that."},
        {"zh": "你踢了过来，我躲开。", "en": "You kick; I dodge."},
        {"zh": "我又啃了一口。", "en": "I gnaw in again."},
        {"zh": "我咬在你的脚踝骨上。", "en": "I bite right on your ankle bone."},
        {"zh": "我退开两步远。", "en": "I back off two paces."},
        {"zh": "这点疼，你不在意。", "en": "You would hardly feel it."},
        {"zh": "我又扑了一回。", "en": "I pounced once more."},
        {"zh": "咬上一口就跑。", "en": "One bite and run."},
        {"zh": "你还站在原地。", "en": "You are still standing there."},
        {"zh": "我四条腿还没软。", "en": "My four legs are still steady."},
        {"zh": "再补上一下子。", "en": "One more for good measure."},
        {"zh": "这一下真够狠。", "en": "That was vicious."},
        {"zh": "你给我别乱动。", "en": "Do not move."},
        {"zh": "我咬住了就不松。", "en": "I bite and do not let go."},
        {"zh": "我把嘴松开了。", "en": "I have let go."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "荒地的太阳很毒。", "en": "The wasteland sun is vicious."},
        {"zh": "沙里还有我的脚印。", "en": "My prints are still in the sand."},
        {"zh": "这一带有四只同类。", "en": "Four of us in this area."},
        {"zh": "我先抖了抖土。", "en": "First I shake off the dust."},
        {"zh": "我抬头找阴凉。", "en": "I look up for shade."},
        {"zh": "这地方比我想的干。", "en": "Drier here than I expected."},
        {"zh": "我从土坎下面上来。", "en": "I climb up from under the bank."},
        {"zh": "附近有点动静。", "en": "A small sound nearby."},
        {"zh": "我把身子趴低了。", "en": "I flatten myself down."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石头上滑下来了。", "en": "I slipped off the rock."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "这水对我来说太深。", "en": "This water is too deep for me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我睁不开眼。", "en": "This light blinds me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "荒地里找不到什么。", "en": "There is little to find in the wasteland."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电打在石头上，我跳了起来。", "en": "Lightning hits the stone; I leap."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "沙子没了，我在往下掉。", "en": "No sand. I fall."}
      ]
    }
  }
}
