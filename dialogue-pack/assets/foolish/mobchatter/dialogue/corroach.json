{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳刮着灰", "en": "My shell scrapes the ash."},
        {"zh": "六条腿跑得飞快", "en": "Six legs move fast."},
        {"zh": "我钻过裂缝", "en": "I slip through a crack."},
        {"zh": "我在荒原上乱窜", "en": "I dart across the wasteland."},
        {"zh": "我压低身子爬", "en": "I crawl low."},
        {"zh": "我的触角在前面探", "en": "My antennae feel ahead."},
        {"zh": "我一步滑一下", "en": "I slip a little each step."},
        {"zh": "我跑到墙根", "en": "I dart to the wall."},
        {"zh": "我从缝里出来又进去", "en": "I pop out of a gap and back in."},
        {"zh": "我在灰里留下一串小印", "en": "I leave a trail of tiny prints."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在石缝里", "en": "I crouch in a stone crack."},
        {"zh": "荒原太亮了", "en": "The wasteland is too bright."},
        {"zh": "我在等脚步声", "en": "I wait for footsteps."},
        {"zh": "我的壳有十点那么硬", "en": "My shell has ten points of armor."},
        {"zh": "风里全是尘", "en": "The wind is all dust."},
        {"zh": "我在磨前腿", "en": "I rub my forelegs."},
        {"zh": "我只有八点命那么小", "en": "I have only eight points of life."},
        {"zh": "我闻到铁锈味", "en": "I smell rust."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你脚太大了", "en": "Your feet are too big."},
        {"zh": "我一碰就跑", "en": "Touch me and I run."},
        {"zh": "你挡住了石缝", "en": "You are covering my crack."},
        {"zh": "我从下往上看你", "en": "I look up at you from below."},
        {"zh": "我会咬人", "en": "I bite."},
        {"zh": "你退半步就行", "en": "Half a step back is enough."},
        {"zh": "这里是我的荒地", "en": "This waste is mine."},
        {"zh": "我的壳很硬，牙也尖", "en": "Hard shell, sharp teeth."},
        {"zh": "你要踩我吗", "en": "Are you going to stomp me?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳裂了", "en": "My shell cracked."},
        {"zh": "我的腿断了一条", "en": "I lost a leg."},
        {"zh": "我往后退", "en": "I back away."},
        {"zh": "血混在灰里", "en": "Blood mixes with the ash."},
        {"zh": "这一下差点要了我", "en": "That nearly finished me."},
        {"zh": "我还跑得动", "en": "I can still run."},
        {"zh": "我恨你", "en": "I hate you."},
        {"zh": "我只有八点生命，壳却硬得很。", "en": "Eight health points, but a hard shell."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是能吃的东西吗", "en": "Is that something to eat?"},
        {"zh": "荒原上的味道，我认得。", "en": "I know the smell of the wasteland."},
        {"zh": "你丢下来我就去", "en": "Drop it and I will go."},
        {"zh": "我压着地面，一点一点挪。", "en": "I keep low and inch forward."},
        {"zh": "荒原上没什么可吃的", "en": "There is little to eat in the waste."},
        {"zh": "它比石头软", "en": "It is softer than stone."},
        {"zh": "我一口就能咬开", "en": "I can bite it open."},
        {"zh": "你再放低一点", "en": "Lower it a little more."},
        {"zh": "这是我的了", "en": "That is mine now."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我时我翻了个身", "en": "You flipped me over."},
        {"zh": "我马上翻身爬起来", "en": "I right myself at once."},
        {"zh": "我的壳碰出响声", "en": "My shell clicked."},
        {"zh": "你差点踩碎我", "en": "You nearly crushed me."},
        {"zh": "我又钻回缝里", "en": "I slip back into the crack."},
        {"zh": "你的靴子太硬了", "en": "Your boots are too hard."},
        {"zh": "我从你脚边窜出去", "en": "I dart out from by your feet."},
        {"zh": "我在你脚后跟旁", "en": "I am by your heel."},
        {"zh": "一撞我就跑远了", "en": "One bump and I am gone."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "荒原上虫子不多", "en": "Not many bugs in the waste."},
        {"zh": "我躲着别的东西", "en": "I am hiding from other things."},
        {"zh": "石缝里比较安全", "en": "A crack is safer."},
        {"zh": "别踩到我们", "en": "Do not step on us."},
        {"zh": "很快就完了", "en": "It will be quick."},
        {"zh": "我们各自跑开", "en": "Then we each run off."},
        {"zh": "你站远点", "en": "Stand farther off."},
        {"zh": "我没有时间", "en": "I have no time."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我藏在缝里", "en": "I hide it in a crack."},
        {"zh": "我的牙咬得动", "en": "My teeth can handle it."},
        {"zh": "荒原上捡到就是赚", "en": "Finding anything here is a win."},
        {"zh": "先咬一口", "en": "One bite first."},
        {"zh": "别跟过来", "en": "Do not follow."},
        {"zh": "地上那点东西，先归我的巢。", "en": "Whatever's on the ground goes to my nest first."},
        {"zh": "小爪子一勾，掉落物就没了。", "en": "One hook of my little claws, and the drop is gone."},
        {"zh": "别丢东西，我会全都拖走。", "en": "Don't drop anything — I'll drag it all away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的缝了", "en": "You stepped on my crack."},
        {"zh": "我朝你的脚踝去", "en": "I go for your ankle."},
        {"zh": "你现在是我的目标", "en": "You are my target now."},
        {"zh": "我先绕你一圈", "en": "I circle you once."},
        {"zh": "你靴子上有缝", "en": "There is a gap in your boot."},
        {"zh": "我的壳能挡几下", "en": "My shell can take a few hits."},
        {"zh": "你退我就追", "en": "You retreat, I follow."},
        {"zh": "荒原上没人帮你", "en": "No one helps you out here."},
        {"zh": "别小看虫子", "en": "Do not underestimate a bug."},
        {"zh": "我贴着你脚后跟", "en": "I am right behind your heel."},
        {"zh": "你的步子乱了", "en": "Your steps went unsteady."},
        {"zh": "这个角度最好咬", "en": "A good angle for biting."},
        {"zh": "我从石缝里冲你来了", "en": "I come at you out of the crack."},
        {"zh": "你再抬脚试试", "en": "Try lifting that foot."},
        {"zh": "我不会先退", "en": "I will not back off first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你脚边画圈", "en": "I circle at your feet."},
        {"zh": "你抬脚我就钻进去", "en": "Lift a foot and I slip in."},
        {"zh": "我等你转身", "en": "I wait for you to turn."},
        {"zh": "你的影子给我挡着", "en": "Your shadow hides me."},
        {"zh": "我换了一条缝", "en": "I moved to another crack."},
        {"zh": "你听见细小的声音了吗", "en": "Do you hear the tiny sound?"},
        {"zh": "我每次都从这里出来", "en": "I always come out here."},
        {"zh": "你已经退不动了", "en": "You cannot step back anymore."},
        {"zh": "我的牙磨得很快", "en": "My teeth are working."},
        {"zh": "我贴在你的靴面", "en": "I am against your boot."},
        {"zh": "再爬两下", "en": "Two more crawls."},
        {"zh": "我要咬你的脚趾", "en": "I will bite your toe."},
        {"zh": "你踩空了一下", "en": "You missed a step."},
        {"zh": "就差一点", "en": "Just a little more."},
        {"zh": "你脚边全是碎石", "en": "Broken stone all around your feet."},
        {"zh": "我从石堆里看你", "en": "I watch you from the rubble."},
        {"zh": "我一直在抬脚和落脚之间", "en": "I live in the gap between steps."},
        {"zh": "你靴缝里都是灰", "en": "Dust in every seam of your boots."},
        {"zh": "我贴上你的鞋跟了", "en": "I am on your heel now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我爬上你的小腿", "en": "I climb your calf."},
        {"zh": "这一口很深", "en": "That bite went deep."},
        {"zh": "你抖腿也甩不掉", "en": "Shaking your leg will not throw me."},
        {"zh": "我的牙又往前咬", "en": "My teeth bite deeper."},
        {"zh": "我抓着你的裤脚", "en": "I cling to your trouser cuff."},
        {"zh": "我从缝里又冒出来", "en": "I pop out of the crack again."},
        {"zh": "你一转身我就到了另一边", "en": "You turn and I am on the other side."},
        {"zh": "这一下是带着全身的", "en": "That was my whole body behind it."},
        {"zh": "我又要咬了", "en": "I am biting again."},
        {"zh": "你太快了", "en": "You are too fast."},
        {"zh": "我换一条腿", "en": "I switch to the other leg."},
        {"zh": "你低头才看得到我", "en": "You have to look down to see me."},
        {"zh": "咬完我就撤", "en": "I bite and withdraw."},
        {"zh": "我还在这儿", "en": "I am still here."},
        {"zh": "你手够不到我", "en": "Your hands cannot reach me."},
        {"zh": "这一口够你记着", "en": "That one you will remember."},
        {"zh": "我不停", "en": "I do not stop."},
        {"zh": "你脚上流血了", "en": "Your foot is bleeding."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "荒原上多了一只小虫", "en": "One more small bug in the waste."},
        {"zh": "我们一群出来了", "en": "A few of us have come out."},
        {"zh": "尘土里藏着我们", "en": "We hide in the dust."},
        {"zh": "我先抖了抖壳", "en": "I shake out my shell."},
        {"zh": "这里什么都没有", "en": "There is nothing here."},
        {"zh": "我爬到石头上看", "en": "I climb a stone to look."},
        {"zh": "远处有脚步声", "en": "Footsteps somewhere far."},
        {"zh": "我把触角伸出去", "en": "I extend my antennae."},
        {"zh": "我钻进最近的缝里", "en": "I dive into the nearest crack."},
        {"zh": "风把我吹了一下", "en": "The wind nudged me."},
        {"zh": "这地方适合埋伏", "en": "Good place for an ambush."}
      ]
    },
