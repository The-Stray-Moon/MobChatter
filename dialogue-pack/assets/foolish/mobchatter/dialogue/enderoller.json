{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着高地边缘跑。", "en": "I run along the highland edge."},
        {"zh": "小脚踩得很快，没有声。", "en": "My small feet patter silently."},
        {"zh": "我矮身穿过石缝。", "en": "I duck through a stone gap."},
        {"zh": "我在末地高地上窜得很快。", "en": "I dart fast across the End highlands."},
        {"zh": "我贴着地面滑动过去。", "en": "I slide low across the ground."},
        {"zh": "我的身体一滚一滚。", "en": "My body rolls as I go."},
        {"zh": "我从小丘后绕出来。", "en": "I come around a mound."},
        {"zh": "我朝有声音的方向去。", "en": "I head toward the noise."},
        {"zh": "我的影子短小，跑得很快。", "en": "My shadow is small and quick."},
        {"zh": "我拐了个急弯。", "en": "I take a sharp turn."},
        {"zh": "我压低身子往前钻。", "en": "I duck forward."},
        {"zh": "我在砂石上滑了半步。", "en": "I slip half a step on gravel."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲着，骨节响了一下。", "en": "I crouch, a joint clicks."},
        {"zh": "我的眼睛是两颗亮点。", "en": "My eyes are two bright points."},
        {"zh": "我在末地高地上等。", "en": "I wait on the End highlands."},
        {"zh": "风把紫色的尘吹过来。", "en": "Wind blows violet dust over."},
        {"zh": "我的关节不自然地弯着。", "en": "My joints bend unnaturally."},
        {"zh": "我歪着头，像在算。", "en": "I tilt my head, as if calculating."},
        {"zh": "我蜷成一圈，尾尖在抽。", "en": "I curl into a ring, tail tip twitching."},
        {"zh": "我在听远处的声音。", "en": "I listen to something far off."},
        {"zh": "我的身高只到你膝盖。", "en": "I'm only knee-high to you."},
        {"zh": "我伏下来，缩紧了。", "en": "I crouch and draw in."},
        {"zh": "我伸了伸腿，又缩回。", "en": "I stretch a leg, then pull it back."},
        {"zh": "我一动不动，像块石。", "en": "I stay still as a stone."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我的高地上。", "en": "You're standing on my highland."},
        {"zh": "你比我高大，我不怕。", "en": "You're bigger. I'm not afraid."},
        {"zh": "你的靴影盖住我了。", "en": "Your boot's shadow covers me."},
        {"zh": "我的眼已经锁好。", "en": "My eyes are locked on."},
        {"zh": "你动一下我就动。", "en": "You move, I move."},
        {"zh": "这地方很空，很好。", "en": "This place is empty. Good."},
        {"zh": "你的膝盖是弱点。", "en": "Your knees are the weak point."},
        {"zh": "你没看见我，是吧？", "en": "You didn't see me, did you?"},
        {"zh": "你弯腰时，我正看着你。", "en": "I watch you as you bend down."},
        {"zh": "我在这儿，抬头。", "en": "I'm here. Look up."},
        {"zh": "你手上的东西不会比我的牙快。", "en": "That's no faster than my teeth."},
        {"zh": "你站的地方我记住了。", "en": "I've noted where you stand."},
        {"zh": "我们的距离在缩。", "en": "The gap is closing."},
        {"zh": "你退也没关系。", "en": "Retreating is fine too."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "背甲裂开，我缩成一团。", "en": "My back plate splits; I curl into a ball."},
        {"zh": "我滚开，滚进石缝里。", "en": "I roll away into a stone crack."},
        {"zh": "腿有点不听使唤。", "en": "A leg won't answer."},
        {"zh": "这点伤我还能跑。", "en": "I can still run."},
        {"zh": "末地高地，我缩成一团。", "en": "On the End highlands, I curl into a ball."},
        {"zh": "你踩到了我的尾。", "en": "You stepped on my tail."},
        {"zh": "血滴在砂上。", "en": "Blood drops on the grit."},
        {"zh": "我忍着不出声。", "en": "I endure without a sound."},
        {"zh": "壳裂了，我记住了你。", "en": "My shell cracked; I will remember you."},
        {"zh": "我还站着呢。", "en": "I'm still standing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块肉，滚得动吗？", "en": "Can that meat be rolled?"},
        {"zh": "扔过来，我不挑。", "en": "Toss it, I'm not picky."},
        {"zh": "我闻见了。", "en": "I smell it."},
        {"zh": "太远，再近点。", "en": "Too far, closer."},
        {"zh": "活的更好。", "en": "Alive is better."},
        {"zh": "你手别张开。", "en": "Don't open your hand."},
        {"zh": "这点不够一口。", "en": "Not even a mouthful."},
        {"zh": "落下来就归我。", "en": "If it falls, it's mine."},
        {"zh": "我更想咬你的脚踝。", "en": "I'd rather bite your ankle."},
        {"zh": "你拿它挡我？", "en": "You'd use that to block me?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踢到了我。", "en": "You kicked me."},
        {"zh": "我翻了个身又站住。", "en": "I roll over and recover."},
        {"zh": "你脚尖蹭到我背上的甲。", "en": "Your toe scraped the shell on my back."},
        {"zh": "我的壳很轻。", "en": "My shell is light."},
        {"zh": "你险些把我踩平。", "en": "You almost flattened me."},
        {"zh": "我绕到你另一只脚边。", "en": "I shift to your other foot."},
        {"zh": "这点碰撞我就弹开。", "en": "At that bump I spring off."},
        {"zh": "你的脚背上有个印子。", "en": "There's a mark on your instep."},
        {"zh": "我贴在地上避开。", "en": "I flatten to the ground."},
        {"zh": "再来我可不躲了。", "en": "Again and I won't dodge."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "高地上有很多同伴。", "en": "Many of my kind are on the highland."},
        {"zh": "我用不上那个。", "en": "I have no use for that."},
        {"zh": "先活过今天。", "en": "Survive today first."},
        {"zh": "我的身体太小。", "en": "My body is too small."},
        {"zh": "你连我的样子都不清楚。", "en": "You don't even know what I look like."},
        {"zh": "别靠那么近。", "en": "Don't come so close."},
        {"zh": "那是别的生物的事。", "en": "That's for other creatures."},
        {"zh": "我要去追猎物了。", "en": "I'm going after prey."},
        {"zh": "你该离开了。", "en": "You should leave."},
        {"zh": "我不懂。", "en": "I don't understand."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一小块，我抱住。", "en": "A small piece, I clutch it."},
        {"zh": "这是什么，能吃吗？", "en": "What's this? Edible?"},
        {"zh": "我咬住它，缩成球滚走。", "en": "I bite it and roll away curled up."},
        {"zh": "太硬了，吐掉。", "en": "Too hard, I spit it out."},
        {"zh": "掉东西的人走远了。", "en": "Whoever dropped this is gone."},
        {"zh": "我抱着它翻了个身。", "en": "I roll over holding it."},
        {"zh": "这味道不好。", "en": "This smells bad."},
        {"zh": "我拿爪按住它。", "en": "I pin it under a claw."},
        {"zh": "有别的在盯着。", "en": "Something else is watching."},
        {"zh": "我拖着它跑了。", "en": "I drag it away."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的膝盖露着。", "en": "Your knees are exposed."},
        {"zh": "这个距离，我一滚就到。", "en": "This distance is one roll away."},
        {"zh": "我伏下来了。", "en": "I'm crouched now."},
        {"zh": "你靴子里有热气。", "en": "There is warmth in your boots."},
        {"zh": "我已经选好起跳点。", "en": "I've picked my launch point."},
        {"zh": "我滚过来，你还没反应过来。", "en": "I roll in before you can react."},
        {"zh": "高地很平，没有遮挡。", "en": "The highland is flat, no cover."},
        {"zh": "我点数你的脚步。", "en": "I count off your steps."},
        {"zh": "再往前走一点。", "en": "A little farther."},
        {"zh": "末地高地上滚一圈，我比你快。", "en": "One roll on the End highlands; I am faster."},
        {"zh": "我已经滚到你脚后了。", "en": "I have already rolled behind your feet."},
        {"zh": "你转身时，我已在你脚边。", "en": "By the time you turn, I am at your feet."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着你脚边打转。", "en": "I circle right at your heels."},
        {"zh": "你转身的时候我停下。", "en": "I stop when you turn."},
        {"zh": "我太小，你打不准。", "en": "I'm too small to hit."},
        {"zh": "我的影子藏在你的影子里。", "en": "My shadow hides in yours."},
        {"zh": "你的招式在打转。", "en": "Your moves are going in circles."},
        {"zh": "我等你抬手。", "en": "I wait for you to raise an arm."},
        {"zh": "你的重心偏右了。", "en": "Your balance favors the right."},
        {"zh": "下一步就该倒。", "en": "The next step should drop you."},
        {"zh": "我数第二次。", "en": "I count the second time."},
        {"zh": "砂石让我的脚滑。", "en": "Gravel makes my feet slide."},
        {"zh": "但我不停下来。", "en": "But I don't stop."},
        {"zh": "你的背后是空的。", "en": "There's nothing behind you."},
        {"zh": "此刻动手。", "en": "Acting now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑在你脚踝上。", "en": "I leap at your ankle."},
        {"zh": "牙咬进你的裤腿。", "en": "My teeth sink into your trouser leg."},
        {"zh": "这一下划开了皮。", "en": "That opened skin."},
        {"zh": "你把我甩了出去。", "en": "You flung me away."},
        {"zh": "我落地就翻起来。", "en": "I land and flip upright."},
        {"zh": "你的腿一软。", "en": "Your leg buckled."},
        {"zh": "我在地上滚，追得很快。", "en": "I roll along the ground and catch up fast."},
        {"zh": "我的牙小而锋利。", "en": "My teeth are small and keen."},
        {"zh": "你流血了。", "en": "You're bleeding."},
        {"zh": "我绕到了另一边。", "en": "I'm around the other side."},
        {"zh": "再来一口。", "en": "One more bite."},
        {"zh": "你踢空了。", "en": "You kicked air."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "高地上多了一个小影子。", "en": "A small shadow on the highland."},
        {"zh": "末地石的缝里，我滚出来。", "en": "I roll out of a crack in the end stone."},
        {"zh": "我先伏低听了一会。", "en": "I crouch and listen first."},
        {"zh": "同伴在我周围。", "en": "My kin are around me."},
        {"zh": "紫色的尘落在我背上。", "en": "Violet dust settles on my back."},
        {"zh": "我抬起两只亮点。", "en": "I raise two bright points."},
        {"zh": "我抖掉背上的末地尘。", "en": "I shake the end dust off my back."},
        {"zh": "这片高地很合适。", "en": "This highland will do."},
        {"zh": "先滚半圈，看看四周。", "en": "I roll half a turn and look around."},
        {"zh": "我听见风声里有东西。", "en": "I hear something in the wind."},
        {"zh": "有活的。", "en": "Something living."},
        {"zh": "我去看看。", "en": "I'll go look."},
        {"zh": "高地上，多了一个小影子。", "en": "One more small shadow on the highland."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎一下，我的壳发脆。", "en": "A lick of fire and my shell goes brittle."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石头上摔下，翻了身。", "en": "I fall off the stone and flip over."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我的手脚糊住了。", "en": "Water gums my limbs."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸开的气浪把我滚出好远。", "en": "The blast rolls me far away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西钉穿了我。", "en": "That pinned right through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的关节全僵。", "en": "Magic locks all my joints."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得跑不动。", "en": "Too hungry to run."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我弹了起来。", "en": "Lightning strikes and I jerk up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有高地。", "en": "No highland in the void."}
      ]
    }
  }
}
