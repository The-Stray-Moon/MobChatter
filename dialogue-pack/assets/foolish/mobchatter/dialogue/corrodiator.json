{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我嗡嗡地飞过荒原", "en": "I buzz across the wasteland."},
        {"zh": "我身体里在晃", "en": "Something sloshes inside me."},
        {"zh": "液体镭推着我往前", "en": "Liquid radium drives me on."},
        {"zh": "我飞得不太稳", "en": "My flight is unsteady."},
        {"zh": "我绕着残骸转", "en": "I circle the wreckage."},
        {"zh": "我从一滴镭上飞过", "en": "I pass over a pool of radium."},
        {"zh": "我的翅膀声很吵", "en": "My wings are loud."},
        {"zh": "我落在锈铁上歇脚", "en": "I perch on rusted iron."},
        {"zh": "我一边飞一边滴东西", "en": "I drip as I fly."},
        {"zh": "我身上有光", "en": "There is a glow on me."},
        {"zh": "我压低高度滑过", "en": "I skim low."},
        {"zh": "我又绕回原地", "en": "I circle back to the same spot."},
        {"zh": "我撞开一片尘", "en": "I scatter a cloud of dust."},
        {"zh": "我停在半空发亮", "en": "I hover, glowing."},
        {"zh": "我往烟尘里钻", "en": "I dive into the haze."},
        {"zh": "我飞得比看起来重", "en": "I fly heavier than I look."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "液体在我身体里晃", "en": "Liquid shifts inside me."},
        {"zh": "我在发光", "en": "I am glowing."},
        {"zh": "我听见自己的嗡鸣", "en": "I hear my own buzzing."},
        {"zh": "这地方很脏", "en": "This place is filthy."},
        {"zh": "荒原上只有镭和锈", "en": "Only radium and rust out here."},
        {"zh": "我的身体是流动的", "en": "My body is fluid."},
        {"zh": "我不敢落地", "en": "I do not dare land."},
        {"zh": "灰尘粘在我身上", "en": "Dust sticks to me."},
        {"zh": "我发出低低的嗡声", "en": "I hum low."},
        {"zh": "我没有固定的形状", "en": "I have no fixed shape."},
        {"zh": "这地方太静了", "en": "It is too quiet here."},
        {"zh": "我轻轻晃了晃", "en": "I sway gently."},
        {"zh": "我带着一股金属味", "en": "I carry a metallic smell."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在镭旁边了", "en": "You are standing by radium."},
        {"zh": "你的护甲开始响了", "en": "Your armor is starting to hiss."},
        {"zh": "别碰那些发光的液体", "en": "Do not touch the glowing liquid."},
        {"zh": "你会被拖进去的", "en": "It will drag you under."},
        {"zh": "你退开一点就好", "en": "Just step back."},
        {"zh": "我身上也在发亮", "en": "I glow too."},
        {"zh": "你鞋底沾了什么", "en": "What is on your soles?"},
        {"zh": "这里不是人待的地方", "en": "This is no place for people."},
        {"zh": "我绕到你脸的正前方", "en": "I hover right in front of your face."},
        {"zh": "你不该来这里找东西", "en": "You should not come here scavenging."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体散了一块", "en": "Part of me scattered."},
        {"zh": "我又聚回来了", "en": "I gathered myself back."},
        {"zh": "液体溅了出去", "en": "Liquid splashed out."},
        {"zh": "我抖了抖", "en": "I shuddered."},
        {"zh": "我变得稀了一点", "en": "I thinned out a bit."},
        {"zh": "嗡嗡声变小了", "en": "My buzzing grew quieter."},
        {"zh": "我还没散", "en": "I have not dispersed."},
        {"zh": "镭在漏，疼的却是我。", "en": "Radium leaks, yet I'm the one hurting."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "镭的味道不错", "en": "Radium smells good."},
        {"zh": "你手里有金属吗", "en": "Is that metal in your hand?"},
        {"zh": "我朝你飞过来", "en": "I am flying toward you."},
        {"zh": "这附近有镭吧", "en": "There is radium nearby, surely."},
        {"zh": "我闻到了腐蚀味", "en": "I smell corrosion."},
        {"zh": "别把那东西收起来", "en": "Do not put it away."},
        {"zh": "我绕了两圈", "en": "I circle twice."},
        {"zh": "它也会发光吗", "en": "Does it glow too?"},
        {"zh": "我靠近一点看", "en": "I will come closer to see."},
        {"zh": "我贴着它飞", "en": "I fly right up to it."},
        {"zh": "这是我能吃的东西", "en": "This is something I can consume."},
        {"zh": "再多一点", "en": "A little more."},
        {"zh": "你手上在发烫", "en": "Your hand is getting hot."},
        {"zh": "我停在你手边", "en": "I stop beside your hand."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到一团液体", "en": "You hit something fluid."},
        {"zh": "我溅开又聚回来", "en": "I splash apart and gather again."},
        {"zh": "你身上沾了点亮的东西", "en": "You have something glowing on you."},
        {"zh": "我的身体没有硬的地方", "en": "Nothing about my body is hard."},
        {"zh": "你擦过去的时候有滋滋声", "en": "There was a hiss as you brushed past."},
        {"zh": "我往后退，又飘回来", "en": "I back off, then drift back."},
        {"zh": "别用袖子擦", "en": "Do not wipe it with your sleeve."},
        {"zh": "这不算真的碰", "en": "That was barely a touch."},
        {"zh": "你的护甲少了点光泽", "en": "Your armor lost some shine."},
        {"zh": "我飞到你另一边", "en": "I fly to your other side."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我身体里全是液体", "en": "My body is all liquid."},
        {"zh": "这跟我们的形态无关", "en": "That does not apply to our form."},
        {"zh": "我们只是飘在一起", "en": "We simply drift together."},
        {"zh": "别站在这片镭上面", "en": "Do not stand on this radium."},
        {"zh": "两团液体靠了靠", "en": "Two globes touched."},
        {"zh": "我绕着她飞", "en": "I circle her."},
        {"zh": "这地方没人打扰", "en": "No one disturbs this place."},
        {"zh": "我们不会留下什么", "en": "We will leave nothing behind."},
        {"zh": "很快就散了", "en": "We will scatter soon."},
        {"zh": "你走开就好", "en": "Just walk away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用身体裹住它", "en": "I wrap my body around it."},
        {"zh": "它开始融了", "en": "It is starting to dissolve."},
        {"zh": "这东西能吃下去", "en": "This can be consumed."},
        {"zh": "我慢慢把它吸进去", "en": "I draw it in slowly."},
        {"zh": "地上的金属归我", "en": "The metal on the ground is mine."},
        {"zh": "它在我体内发光", "en": "It glows inside me."},
        {"zh": "我抱着它飞", "en": "I fly holding it."},
        {"zh": "一点就够了", "en": "A little is enough."},
        {"zh": "它被腐蚀了一半", "en": "Half of it has corroded."},
        {"zh": "你别碰剩下的", "en": "Do not touch what is left."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩进了镭的范围", "en": "You stepped into the radium."},
        {"zh": "你的护甲在变薄", "en": "Your armor is thinning."},
        {"zh": "你会慢慢被拖下去", "en": "You will slowly be dragged down."},
        {"zh": "这地方不听你的", "en": "This place does not obey you."},
        {"zh": "我在看你鞋底", "en": "I am watching your soles."},
        {"zh": "你别站在那片发亮的地方", "en": "Do not stand in that glowing patch."},
        {"zh": "我朝你来了", "en": "I am coming for you."},
        {"zh": "你身上的铁很好闻", "en": "The iron on you smells good."},
        {"zh": "你跑不掉，我飞得比你快。", "en": "You cannot escape. I fly faster."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我又绕过来了", "en": "I have come around again."},
        {"zh": "你的呼吸有点急", "en": "Your breathing is fast."},
        {"zh": "镭正在往你那边流", "en": "The radium is flowing your way."},
        {"zh": "你听得见滋滋声吗", "en": "Do you hear the hissing?"},
        {"zh": "我离你只有一圈", "en": "I am one circle away."},
        {"zh": "我的身体一直在变", "en": "My body keeps changing."},
        {"zh": "你的靴子在起泡", "en": "Your boots are blistering."},
        {"zh": "我不急，我一直在飞", "en": "I am in no hurry, I keep flying."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
