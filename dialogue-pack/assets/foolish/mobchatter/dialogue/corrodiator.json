        {"zh": "金属开始作响", "en": "The metal starts to hiss."},
        {"zh": "你那一块变黑了", "en": "That part of you went black."},
        {"zh": "我溅了你一脸", "en": "I splash across your face."},
        {"zh": "你手上的东西在化", "en": "What you hold is dissolving."},
        {"zh": "我贴着你飞过去", "en": "I fly right past you."},
        {"zh": "你退得慢了", "en": "You retreated too slowly."},
        {"zh": "你的护甲薄了一层", "en": "Your armor thinned by a layer."},
        {"zh": "这一下不疼，但更糟", "en": "That did not hurt, which is worse."},
        {"zh": "我又绕回来", "en": "I come around again."}
      ]
