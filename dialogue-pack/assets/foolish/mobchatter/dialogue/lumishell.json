        {"zh": "我的壳磕在地上", "en": "My shell knocks the ground."},
        {"zh": "我慢慢退回去了", "en": "I slowly retreat."},
        {"zh": "它并没有追来", "en": "It does not follow."},
        {"zh": "我等着它先走", "en": "I wait for it to leave."},
        {"zh": "我把身体放低", "en": "I lower my body."},
        {"zh": "我又往树后挪", "en": "I move behind the tree."},
        {"zh": "我离开那条路", "en": "I leave that path."},
        {"zh": "我的光在我身后拉长", "en": "My glow stretches behind me."},
        {"zh": "我重新往前爬", "en": "I start crawling forward again."}
      ]
    },
