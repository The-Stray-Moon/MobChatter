{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢挪过湿润的地", "en": "I slide over the damp ground."},
        {"zh": "我的身体拉得细长", "en": "My body stretches long and thin."},
        {"zh": "我拖着一道亮痕", "en": "I leave a shining trail."},
        {"zh": "我一步一步往前蹭", "en": "I creep forward a step at a time."},
        {"zh": "我从树干旁挪过", "en": "I creep past the trunk."},
        {"zh": "我的壳在暗处发亮", "en": "My shell glows in the dark."},
        {"zh": "我绕过一片苔藓", "en": "I go around a patch of moss."},
        {"zh": "我拖着一道亮痕爬", "en": "I crawl, dragging a shining trail."},
        {"zh": "我挪到树影边缘", "en": "I move to the edge of the tree shade."},
        {"zh": "我拖着壳，一寸一寸往前。", "en": "Dragging my shell, I inch forward."},
        {"zh": "我的身体在叶下摆", "en": "My body sways under the leaves."},
        {"zh": "我慢慢刹住脚步", "en": "I slowly come to a halt."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直立着不动", "en": "I stand without moving."},
        {"zh": "我的壳上有一点光", "en": "There is a light on my shell."},
        {"zh": "我慢慢伸长身体", "en": "I slowly stretch out."},
        {"zh": "我原地转了一点", "en": "I turn a little in place."},
        {"zh": "我的触角探出来", "en": "My eyestalks come out."},
        {"zh": "我缩着壳不发一点光", "en": "I tuck in my shell, dark and still."},
        {"zh": "我在暗处发着微光", "en": "I glow faintly in the dark."},
        {"zh": "我缓慢地呼吸", "en": "I breathe slowly."},
        {"zh": "我的背壳有水痕", "en": "There is a wet mark on my shell."},
        {"zh": "我在等周围安静", "en": "I wait for things to calm."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢抬起触角", "en": "I raise my eyestalks slowly."},
        {"zh": "我把触角朝着你", "en": "My eyestalks point your way."},
        {"zh": "我慢慢挪了半步", "en": "I shift half a step."},
        {"zh": "你挡住光，我抬头看你。", "en": "You block the light, and I look up at you."},
        {"zh": "我慢得一点不急", "en": "I am slow and in no rush."},
        {"zh": "往旁边挪了一点，慢。", "en": "Shifted aside slowly."},
        {"zh": "我看你看了很久", "en": "I have watched you a long while."},
        {"zh": "我的光暗了一点", "en": "My glow dims a little."},
        {"zh": "我又继续往前走", "en": "I go on again."},
        {"zh": "我慢慢绕开你", "en": "I go around you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我赶紧缩进壳里", "en": "I withdraw into my shell."},
        {"zh": "我的身体晃了一下", "en": "My body sways."},
        {"zh": "我的光暗了下去", "en": "My glow dims."},
        {"zh": "我慢慢把身体展开", "en": "I slowly unfold."},
        {"zh": "我的壳上多了道痕", "en": "A mark shows on my shell."},
        {"zh": "我一动不动地待了会", "en": "I stay still for a while."},
        {"zh": "我疼得发不出声", "en": "The pain leaves me silent."},
        {"zh": "我一点点把壳展开", "en": "I open my shell little by little."},
        {"zh": "我又开始挪动", "en": "I start moving again."},
        {"zh": "我还有力气走", "en": "I still have strength to move."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那东西在动", "en": "What you hold is moving."},
        {"zh": "我慢慢朝它挪", "en": "I creep toward it slowly."},
        {"zh": "我不太确定要不要", "en": "I am not sure I want it."},
        {"zh": "我伸出触角碰了碰", "en": "I touch it with a stalk."},
        {"zh": "这东西我吃不下", "en": "I could not eat this."},
        {"zh": "我把头转向别处", "en": "I turn my head away."},
        {"zh": "我又看了它一眼", "en": "I glance at it once more."},
        {"zh": "想想还是算了", "en": "Better not."},
        {"zh": "我继续走我的路", "en": "I go on my way."},
        {"zh": "我并没有停下", "en": "I did not stop."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，我晃了晃", "en": "You bump me and I rock."},
        {"zh": "我的身体滑到一边", "en": "My body slides to one side."},
        {"zh": "我一点点找平身子", "en": "I level myself bit by bit."},
        {"zh": "你踩住我的尾尖，我慢慢抽出来。", "en": "You pin my tail tip, and I slowly pull it free."},
        {"zh": "我把身体缩回来", "en": "I pull my body back."},
        {"zh": "我又继续往前挪", "en": "I keep creeping forward."},
        {"zh": "你挡住墙根，我慢慢绕开。", "en": "You block the wall's base, so I slowly go around."},
        {"zh": "撞一下我不介意", "en": "A bump does not bother me."},
        {"zh": "迟缓的蜗牛，慢慢让开。", "en": "The slow snail yields the way."},
        {"zh": "我又停下来一会", "en": "I pause again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只慢慢挪过来", "en": "Another creeps over slowly."},
        {"zh": "我们的光并在一起", "en": "Our glows meet."},
        {"zh": "它比我高一点", "en": "It is a little taller than I."},
        {"zh": "我们两个一道慢慢挪", "en": "The two of us creep together."},
        {"zh": "它碰了碰我的触角", "en": "It touches my eyestalk."},
        {"zh": "我们挨着停在树下", "en": "We stop together under the tree."},
        {"zh": "我们两个都没声音", "en": "Neither of us makes a sound."},
        {"zh": "它先往前挪动", "en": "It moves first."},
        {"zh": "我慢慢跟着它", "en": "I follow it."},
        {"zh": "我们一起靠近一片苔藓", "en": "We near a patch of moss together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用黏液把叶片卷成筒。", "en": "I roll a leaf into a tube with my slime."},
        {"zh": "我用触角把它顶起", "en": "I prop it up on a stalk."},
        {"zh": "我把它推回原处", "en": "I push it back."},
        {"zh": "我咬了一口，又慢慢吐掉。", "en": "I take a bite, then slowly spit it out."},
        {"zh": "我又把它顶出去", "en": "I push it back out."},
        {"zh": "我又往前挪了", "en": "I creep on a bit."},
        {"zh": "我缓缓爬到它上面", "en": "I creep slowly over it."},
        {"zh": "我慢慢把它放下", "en": "I set it down slowly."},
        {"zh": "我挪着继续赶路", "en": "I keep creeping on my way."},
        {"zh": "我眼睛不再往那边", "en": "My eyes do not go back there."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我把触角收回去", "en": "I draw my stalks in."},
        {"zh": "我壳上的光收了起来，盯着你。", "en": "The glow on my shell dims as I watch you."},
        {"zh": "我停住不再挪身", "en": "I stop my slow crawl."},
        {"zh": "我把身体压低了", "en": "I lower my body."},
        {"zh": "我在找地方藏", "en": "I look for somewhere to hide."},
        {"zh": "我一动不动地退", "en": "I retreat without a sound."},
        {"zh": "这里不太安全", "en": "This is not very safe."},
        {"zh": "我往树后面走", "en": "I head behind the tree."},
        {"zh": "我的壳发着冷光", "en": "My shell gives a cold light."},
        {"zh": "我等一下再走", "en": "I will wait before moving."},
        {"zh": "那个影子挡住了路", "en": "That shadow blocks the way."},
        {"zh": "我一下停了下来", "en": "I have stopped."},
        {"zh": "我慢慢缩进壳里", "en": "I slowly withdraw into my shell."},
        {"zh": "我不打算从那过去", "en": "I do not mean to pass through."},
        {"zh": "我伏低贴住苔藓", "en": "I press low into the moss."},
        {"zh": "我想等它先走", "en": "I would rather it moved first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢移到树后", "en": "I ease behind the tree."},
        {"zh": "我贴着地不动", "en": "I keep low and still."},
        {"zh": "它还没注意到光亮", "en": "It has not noticed the glow."},
        {"zh": "我的光太亮了", "en": "My glow is too bright."},
        {"zh": "我缩进壳里，只留一条缝。", "en": "I pull into my shell, leaving only a slit."},
        {"zh": "我往苔藓里缩", "en": "I sink into the moss."},
        {"zh": "它拐到这边来了", "en": "It has turned this way."},
        {"zh": "我等着它走过去", "en": "I wait for it to pass."},
        {"zh": "我的身体贴紧了地", "en": "My body presses to the ground."},
        {"zh": "它就停在原地", "en": "It has stopped."},
        {"zh": "我一点都没有动", "en": "I do not move at all."},
        {"zh": "我的影子淡得看不见", "en": "My shadow is too faint to see."},
        {"zh": "我又往后挪了一寸", "en": "I shift an inch back."},
        {"zh": "它忽然开始动了", "en": "It has started moving."},
        {"zh": "我多缩一小会儿", "en": "I stay tucked a while longer."},
        {"zh": "它慢慢走远了", "en": "It has gone further off."},
        {"zh": "我慢慢伸直身体", "en": "I slowly straighten out."},
        {"zh": "我到现在没动", "en": "I have not moved yet."},
        {"zh": "树影把我遮住", "en": "The tree shade covers me."},
        {"zh": "我等它彻底走开", "en": "I wait for it to leave completely."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
