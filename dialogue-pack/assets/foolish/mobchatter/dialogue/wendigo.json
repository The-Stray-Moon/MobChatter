{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着细长的腿走。", "en": "I walk on long thin legs."},
        {"zh": "我一步跨过半间屋。", "en": "One stride spans half a room."},
        {"zh": "我的指甲刮过石头。", "en": "My nails scrape the stone."},
        {"zh": "我绕着树走，不远不近。", "en": "I circle the tree at a distance."},
        {"zh": "雪地上只有我的骨印。", "en": "Only my bone-prints on the snow."},
        {"zh": "我走得很轻，几乎听不见。", "en": "I walk so lightly I'm barely heard."},
        {"zh": "我侧过身穿过枯枝。", "en": "I slip sideways past dead branches."},
        {"zh": "我的头一直朝着一边。", "en": "My head stays turned to one side."},
        {"zh": "我从雾里踏出来。", "en": "I step out of the fog."},
        {"zh": "我不急，路很熟。", "en": "No rush; I know the way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯着脖子站着。", "en": "I stand with my neck bent."},
        {"zh": "我的肋骨在皮下显出形状。", "en": "My ribs show through the skin."},
        {"zh": "我慢慢嚼着空气。", "en": "I chew at the air."},
        {"zh": "我听见雪下有东西。", "en": "I hear something under the snow."},
        {"zh": "雪压住脚印，我藏得很好。", "en": "Snow covers my tracks; I hide well."},
        {"zh": "我抬起一只脚又慢慢放下。", "en": "I lift a foot and lower it slowly."},
        {"zh": "我没有影子的时候也有。", "en": "Sometimes I even have a shadow."},
        {"zh": "我呼出的气，白得像霜。", "en": "My breath comes out white as frost."},
        {"zh": "远处有一堆火。", "en": "There's a fire far off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见你的骨头在动。", "en": "I see your bones moving."},
        {"zh": "我在林子里跟了你一段。", "en": "I've followed you through the woods a while."},
        {"zh": "你的呼吸我听得清楚。", "en": "I hear your breathing clearly."},
        {"zh": "火把的味道，让我后退半步。", "en": "The smell of torchfire makes me step back."},
        {"zh": "你别转过身来。", "en": "Don't turn around."},
        {"zh": "你站着比跑着好。", "en": "Standing suits you better than running."},
        {"zh": "我的手臂比你的腿长。", "en": "My arms are longer than your legs."},
        {"zh": "我低头看你，脖子弯得很长。", "en": "I lower my head to look at you, neck bent long."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮上裂了口。", "en": "My skin split open."},
        {"zh": "我把脖子弯得更低。", "en": "I crouch lower."},
        {"zh": "血很少，但我知道。", "en": "Little blood, but I notice."},
        {"zh": "我咧嘴，露出牙。", "en": "I grin, showing teeth."},
        {"zh": "这点伤我撑得住。", "en": "I can bear this."},
        {"zh": "皮上裂了口，我弯下脖子。", "en": "A split in my hide; I bend my neck lower."},
        {"zh": "你再伸一次手试试。", "en": "Again."},
        {"zh": "这点伤，饿意还压得住。", "en": "A wound like this won't drown out my hunger."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那还带着血丝的肉。", "en": "That's meat."},
        {"zh": "我瘦高的身子，骨架都在外。", "en": "This thin body of mine shows every bone."},
        {"zh": "我不吃别人手上的。", "en": "I don't take from hands."},
        {"zh": "我更想要会动的。", "en": "I'd rather have something that moves."},
        {"zh": "你往后退开一点。", "en": "Step back."},
        {"zh": "我不为此停下来。", "en": "I won't stop for that."},
        {"zh": "那块肉你收起来。", "en": "Keep it."},
        {"zh": "你的气味，把我引过来了。", "en": "Your smell is what drew me here."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的腿骨。", "en": "You struck my leg bone."},
        {"zh": "我连半步也没让开。", "en": "I didn't give a step."},
        {"zh": "你撞得自己偏了。", "en": "You knocked yourself aside."},
        {"zh": "我瘦得硌人，别靠过来。", "en": "I'm all bone — don't press against me."},
        {"zh": "我的皮贴着骨头。", "en": "My skin lies tight on the bone."},
        {"zh": "我垂着脖子俯视你。", "en": "I lower my head to look."},
        {"zh": "别用热手贴着我。", "en": "I dislike being touched."},
        {"zh": "这里不是拥挤的地方。", "en": "This isn't a crowded place."},
        {"zh": "把中间的路让开。", "en": "Let me by."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个季节只有饥饿。", "en": "This season brings only hunger."},
        {"zh": "你活不到那时候。", "en": "You won't live that long."},
        {"zh": "林子里不需要这些。", "en": "The woods have no need of that."},
        {"zh": "你给我退开去。", "en": "Back away."},
        {"zh": "我只想找吃的。", "en": "I only want food."},
        {"zh": "少说那些废话。", "en": "Spare the talk."},
        {"zh": "你快一点走开。", "en": "Go."},
        {"zh": "别再提这件事。", "en": "Don't speak of it."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这可不是新鲜的肉。", "en": "This isn't meat."},
        {"zh": "我闻了闻就丢了。", "en": "I sniff and drop it."},
        {"zh": "骨头我留着用。", "en": "I'll keep the bone."},
        {"zh": "它上面沾着雪。", "en": "It's covered in snow."},
        {"zh": "这一块轻得可怜。", "en": "Too light."},
        {"zh": "咽下去只会硌牙。", "en": "Can't eat it."},
        {"zh": "我把它扔在路边。", "en": "I toss it by the path."},
        {"zh": "你把它捡回去。", "en": "You take it back."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进我的林子了。", "en": "You've entered my woods."},
        {"zh": "我的手指太长，藏不住。", "en": "My fingers are too long to hide."},
        {"zh": "这个距离我三步就到。", "en": "Three strides and I'm there."},
        {"zh": "雪地会把你的脚步放大。", "en": "The snow makes your steps loud."},
        {"zh": "林子很深，我知道每条路。", "en": "The woods are deep and I know every path."},
        {"zh": "我开始走快些了。", "en": "I'm walking faster now."},
        {"zh": "别朝火那边去。", "en": "Don't head for the fire."},
        {"zh": "先吃哪一块呢。", "en": "Which part first?"},
        {"zh": "你给我站住了。", "en": "Stand still."},
        {"zh": "我已经挪到了近处。", "en": "I'm coming."},
        {"zh": "千万别叫出声。", "en": "Don't scream."},
        {"zh": "我等你累下来。", "en": "I'll wait till you tire."},
        {"zh": "再往前靠这么一点。", "en": "A little closer."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我瘦得能穿过树缝。", "en": "I am thin enough to slip between trees."},
        {"zh": "树后面我一直在。", "en": "I'm always behind a tree."},
        {"zh": "我不怕火，只是不喜欢。", "en": "I don't fear fire; I dislike it."},
        {"zh": "你在往深处跑。", "en": "You're running deeper in."},
        {"zh": "这条路上没人。", "en": "There's no one on this path."},
        {"zh": "你的腿开始慢了。", "en": "Your legs are slowing."},
        {"zh": "雪地上，你的心跳太响了。", "en": "On the snow, your heartbeat is far too loud."},
        {"zh": "我只差最后几步。", "en": "Almost."},
        {"zh": "你肩后那片阴影，是我。", "en": "The shade behind your shoulder is me."},
        {"zh": "两只脚别乱动。", "en": "Keep your feet still."},
        {"zh": "我把手伸出来。", "en": "I'm reaching."},
        {"zh": "我已经抓到你了。", "en": "I have you."},
        {"zh": "你别乱挣扎了。", "en": "Don't struggle."},
        {"zh": "现在你是我的。", "en": "Now you're mine."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的指甲划下去。", "en": "My nails rake down."},
        {"zh": "你被撞在树干上。", "en": "You were slammed into a trunk."},
        {"zh": "骨节扣进你的肩膀。", "en": "My knuckles dig into your shoulder."},
        {"zh": "骨头的声音很清楚。", "en": "The sound of bone is clear."},
        {"zh": "牙太长，咬下去合不拢。", "en": "My teeth are too long to close right."},
        {"zh": "你被我打得踉跄。", "en": "You stumbled from the blow."},
        {"zh": "别挣扎，会更疼。", "en": "Don't struggle; it hurts more."},
        {"zh": "你身上已经有血味了。", "en": "There's blood-scent on you now."},
        {"zh": "瘦高的我，这一下只是开头。", "en": "Tall and thin, and that was only the start."},
        {"zh": "我还没有吃饱。", "en": "I'm not full."},
        {"zh": "你一步一步往后退。", "en": "Back away."},
        {"zh": "你迟早会倒下。", "en": "You'll fall."},
        {"zh": "我的耐性很好。", "en": "I'm very patient."},
        {"zh": "你走过来一点。", "en": "Come."},
        {"zh": "让我再咬一口。", "en": "Let me bite again."},
        {"zh": "听听这声音吧。", "en": "Listen to that sound."},
        {"zh": "你用不着害怕。", "en": "Don't fear."},
        {"zh": "很快就能结束。", "en": "It'll be quick."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我瘦得只剩骨头，可还是站得直。", "en": "Skin and bone, and still I stand straight."},
        {"zh": "我闻到了活人的味。", "en": "I smell a living thing."},
        {"zh": "我的腿在雪里陷下去。", "en": "My legs sink into the snow."},
        {"zh": "我抬起脖子看。", "en": "I raise my neck to look."},
        {"zh": "林子里这块归我。", "en": "This is my place."},
        {"zh": "风把火光吹过来。", "en": "The wind carries firelight."},
        {"zh": "我在树间挪动。", "en": "I shift between the trees."},
        {"zh": "我不必急着下手。", "en": "I'm in no hurry."},
        {"zh": "我饿得胸口发空。", "en": "I've been hungry a long while."},
        {"zh": "脚步声在哪边？", "en": "Which way are the footsteps?"}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我的皮，我发出低叫。", "en": "Fire scorched my skin; I gave a low cry."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上摔下来，骨头磕在石上。", "en": "I fell from a tree and struck stone."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我压得往下沉。", "en": "Water presses me down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我甩进灌木。", "en": "The blast threw me into the brush."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉进我的肋间。", "en": "Something stuck between my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量缠住我的骨头。", "en": "That force wrapped my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我站不直。", "en": "Too hungry to stand straight."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照出我的影子，我僵住。", "en": "The flash showed my shadow; I froze."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "雪下面什么都没有。", "en": "There's nothing under the snow."}
      ]
    }
  }
}
