{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我每一步都陷进沙里。", "en": "Every step sinks into the sand."},
        {"zh": "三格宽的身子在移。", "en": "My three-block body shifts."},
        {"zh": "高过沙丘的影子。", "en": "A shadow taller than the dunes."},
        {"zh": "我慢慢走过开阔地。", "en": "I cross the open ground slowly."},
        {"zh": "四格高的我压着风。", "en": "Four blocks tall, I press the wind down."},
        {"zh": "脚掌掀起一片沙。", "en": "My foot lifts a sheet of sand."},
        {"zh": "我转过庞大的身子。", "en": "I turn my vast body."},
        {"zh": "沙丘在我脚边塌了。", "en": "A dune collapses by my foot."},
        {"zh": "我人还没到，影子先压过沙丘。", "en": "I'm not there yet; my shadow crests the dune first."},
        {"zh": "关节在沙里发涩。", "en": "My joints grind with sand."},
        {"zh": "风从我的肋边过。", "en": "Wind passes my ribs."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着像一堵墙。", "en": "I stand like a wall."},
        {"zh": "沙积在我的肩。", "en": "Sand piles on my shoulders."},
        {"zh": "我慢慢把头低下。", "en": "I lower my head slowly."},
        {"zh": "我听见沙在流。", "en": "I hear the sand flow."},
        {"zh": "这么高的地方很好看远。", "en": "From up here I see far."},
        {"zh": "四格高的我，坐下会陷进沙里。", "en": "Four blocks tall; sitting would sink me."},
        {"zh": "我身上的沙一直在掉。", "en": "Sand keeps falling off me."},
        {"zh": "风把我的热气吹散。", "en": "The wind scatters my heat."},
        {"zh": "我一动，沙子就响。", "en": "When I move, the sand sounds."},
        {"zh": "我看了看脚下的洞。", "en": "I glance at the pit below."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你还没我的膝盖高。", "en": "You're shorter than my knee."},
        {"zh": "抬头很累吧。", "en": "Tiring to look up, isn't it."},
        {"zh": "我压下来的影子够大吗。", "en": "Is my shadow big enough?"},
        {"zh": "我不用低头也能看见你。", "en": "I see you without bending."},
        {"zh": "你站在那里像块石子。", "en": "You stand there like a pebble."},
        {"zh": "我一步就是你的十步。", "en": "One of my steps is ten of yours."},
        {"zh": "你还要说什么？", "en": "Anything else to say?"},
        {"zh": "这里风大，站远点。", "en": "It's windy. Stand off."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "沙壳被打掉一块。", "en": "A chunk of sand crust fell."},
        {"zh": "我晃了一下但没倒。", "en": "I swayed but didn't fall."},
        {"zh": "这点力道太轻了。", "en": "That strength was too little."},
        {"zh": "沙壳碎了一角，我照样转身。", "en": "A chip off my shell, and I still turn."},
        {"zh": "我的关节卡了半秒。", "en": "My joint seized for half a second."},
        {"zh": "我撑住沙丘。", "en": "I brace on the dune."},
        {"zh": "血混在沙里。", "en": "Blood soaks into sand."},
        {"zh": "我也记住你。", "en": "And I'll remember you."},
        {"zh": "我不痛，只是生气。", "en": "It doesn't hurt. It angers me."},
        {"zh": "再走近我就踩。", "en": "Step closer and I stomp."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那么小的一口。", "en": "Such a small mouthful."},
        {"zh": "沙里长不出这个，我不认得。", "en": "Nothing like that grows in sand; I don't know it."},
        {"zh": "拿远点，挡路了。", "en": "Move it. It's in my way."},
        {"zh": "你举着手很累吧。", "en": "Your arm must tire."},
        {"zh": "还不如给我块石头。", "en": "Better to give me a stone."},
        {"zh": "你举着吧，我只认得水。", "en": "Keep holding it; I only know water."},
        {"zh": "别举到我的脸前。", "en": "Don't hold it to my face."},
        {"zh": "放下，我要走路。", "en": "Put it down. I'm walking."},
        {"zh": "你的心意我收下。", "en": "I accept the gesture."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我腿上了。", "en": "You hit my leg."},
        {"zh": "我三格宽，绕不开。", "en": "Three blocks wide. I can't turn."},
        {"zh": "沙被我们踩得下陷。", "en": "The sand sank under us."},
        {"zh": "你在我脚边弹开了。", "en": "You bounced off my foot."},
        {"zh": "你撞上我的小腿，像撞上柱子。", "en": "You hit my shin like a pillar."},
        {"zh": "这一步差点踩到你。", "en": "I nearly stepped on you."},
        {"zh": "往旁边挪三步。", "en": "Three paces to the side."},
        {"zh": "抬头看看我有多高。", "en": "Look up and see how tall I stand."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的体形不合适。", "en": "My size is unsuited."},
        {"zh": "我连自己都难安置。", "en": "I can hardly place myself."},
        {"zh": "沙丘之间没有隐蔽。", "en": "No cover between the dunes."},
        {"zh": "我只会走路和打人。", "en": "I only walk and strike."},
        {"zh": "你的身量还太小。", "en": "You're still too small."},
        {"zh": "别站在我脚下说这个。", "en": "Don't say that under my feet."},
        {"zh": "去别的地方吧。", "en": "Find somewhere else."},
        {"zh": "别挤在我脚边。", "en": "Don't crowd my feet."},
        {"zh": "你快点走吧。", "en": "You should leave."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这点东西比不上沙。", "en": "This is less than sand."},
        {"zh": "太大了，捡不起来。", "en": "Too big to pick up."},
        {"zh": "它夹在我指缝里。", "en": "It's stuck between my fingers."},
        {"zh": "太轻了，感觉不到。", "en": "Too light to feel."},
        {"zh": "我一按它就碎了。", "en": "It crumbled when I pressed."},
        {"zh": "沙堆里还有半截。", "en": "Half buried in the sand."},
        {"zh": "我用手掌托着。", "en": "I hold it on my palm."},
        {"zh": "给你，我不用。", "en": "Take it. I don't need it."},
        {"zh": "沙子会埋掉它。", "en": "The sand will bury it."},
        {"zh": "埋在沙里也行。", "en": "Bury it in the sand."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "这么小的东西也在动。", "en": "Even something this small moves."},
        {"zh": "我慢慢抬起了手。", "en": "I raise my hand slowly."},
        {"zh": "沙在我脚下滑。", "en": "Sand slides under my feet."},
        {"zh": "你在这片开阔地上。", "en": "You're out in the open."},
        {"zh": "我把肩转向你。", "en": "I turn my shoulder to you."},
        {"zh": "我影子的边碰到你了。", "en": "The edge of my shadow reached you."},
        {"zh": "风把沙吹向一边。", "en": "The wind pushes sand aside."},
        {"zh": "没有石头能挡你。", "en": "No rock will shield you."},
        {"zh": "你跑十步我一跨。", "en": "Ten of your steps, one stride of mine."},
        {"zh": "我这条腿正在抬起。", "en": "This leg of mine is rising."},
        {"zh": "你最好往后退。", "en": "You'd best back away."},
        {"zh": "三格宽四格高，沙里走得动。", "en": "Three wide, four tall, and I move in sand."},
        {"zh": "我抬起第一只脚，你看着。", "en": "I lift my first foot; watch."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "沙子在我脚下一层层塌。", "en": "Sand collapses under each step."},
        {"zh": "你比沙子跑得慢。", "en": "You're slower than the sand."},
        {"zh": "我抬手，影子从你鞋尖爬上来。", "en": "I raise a hand; my shadow climbs from your boots."},
        {"zh": "沙丘挡住了你的左路。", "en": "The dune blocks your left."},
        {"zh": "我抬脚你就得躲。", "en": "When my foot lifts, you dodge."},
        {"zh": "你退了十步我一步。", "en": "Ten paces back, one stride for me."},
        {"zh": "风向偏了，你的味道还在。", "en": "The wind shifted, but your scent stays."},
        {"zh": "沙子底下，你脚步我听得见。", "en": "Under the sand, I hear your steps."},
        {"zh": "我一步一步，把你逼向没遮挡的地方。", "en": "Step by step I herd you into the open."},
        {"zh": "我一步抵你十步。", "en": "My stride is ten of yours."},
        {"zh": "等我脚落地再动。", "en": "I move when my foot lands."},
        {"zh": "我这一掌不轻。", "en": "This hand of mine is heavy."},
        {"zh": "你踩的沙在往下滑。", "en": "The sand slides under you."},
        {"zh": "你每迈一步，我都在心里记下。", "en": "Every step you take, I tally it."},
        {"zh": "沙尘让我看不清。", "en": "Dust clouds my sight."},
        {"zh": "你抬手那一下，沙子跟着抖。", "en": "When your hand lifts, the sand shivers."},
        {"zh": "把脚抬起来。", "en": "Lift the foot."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一掌压下来！", "en": "One palm comes down!"},
        {"zh": "踩你面前的沙。", "en": "My foot slams the sand before you."},
        {"zh": "膝盖顶过去。", "en": "My knee drives in."},
        {"zh": "沙尘迷了你的眼。", "en": "Dust blinds you."},
        {"zh": "我横扫手臂。", "en": "My arm sweeps across."},
        {"zh": "这一下砸出坑。", "en": "That one dug a crater."},
        {"zh": "你被沙推开了。", "en": "The sand threw you back."},
        {"zh": "四米高的我，从沙里站起来。", "en": "Four meters tall, I rise out of the sand."},
        {"zh": "这一掌很慢，但很重。", "en": "Slow palm, heavy landing."},
        {"zh": "你退到哪里都一样。", "en": "Retreating changes nothing."},
        {"zh": "我抬脚，你就在下面。", "en": "My foot lifts. You're under it."},
        {"zh": "沙灌进你的靴子。", "en": "Sand fills your boots."},
        {"zh": "骨头在响吧。", "en": "Your bones are creaking."},
        {"zh": "我压着你不动。", "en": "I hold you down."},
        {"zh": "沙从你领口灌进去，很沉。", "en": "Sand pours down your collar, heavy."},
        {"zh": "三格宽的身子压下来，别躲了。", "en": "Three paces wide comes down; no point dodging."},
        {"zh": "我的影子还在你身上。", "en": "My shadow is still on you."},
        {"zh": "脚还没落下。", "en": "The foot hasn't landed."},
        {"zh": "就快结束了。", "en": "Almost over."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "沙丘后面站起一个巨人。", "en": "A giant rises behind the dune."},
        {"zh": "我压得沙地往下陷。", "en": "The ground sinks under me."},
        {"zh": "我的影子铺满空地。", "en": "My shadow covers the clearing."},
        {"zh": "风碰到我就散了。", "en": "The wind breaks against me."},
        {"zh": "沙从我的肩上滑落。", "en": "Sand slides off my shoulders."},
        {"zh": "我跨出第一步。", "en": "I take my first stride."},
        {"zh": "四格高的身影。", "en": "A shape four blocks tall."},
        {"zh": "沙子被我掀起来。", "en": "I kick up the sand."},
        {"zh": "我看见一个小点。", "en": "I see a small dot."},
        {"zh": "我迈开步子走了。", "en": "I start walking."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "沙烧成硬壳粘在我身上。", "en": "Sand fused to a crust on me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时整片沙都陷了。", "en": "The whole dune sank on impact."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我沙壳的缝里进去。", "en": "Water seeps through my crust."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我的外壳被掀开一角。", "en": "A corner of my shell blew off."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "小东西扎在我肘上。", "en": "A small thing stuck in my elbow."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光烧穿了我的沙。", "en": "The light burned through my sand."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得抬不起手。", "en": "Too hungry to lift my hand."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把沙子烧成了玻璃。", "en": "The bolt turned sand to glass."}
      ]
    }
  }
}
