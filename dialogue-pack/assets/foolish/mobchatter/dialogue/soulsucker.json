{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体很高，走起来像塔在动。", "en": "My body is tall; I move like a walking tower."},
        {"zh": "两臂垂到膝盖以下。", "en": "My arms hang below my knees."},
        {"zh": "每一步都踩在灵魂沙上。", "en": "Every step lands on soul sand."},
        {"zh": "沙子被踩出很深的坑。", "en": "The sand takes deep pits."},
        {"zh": "我绕过一片熔岩裂缝。", "en": "I round a lava fissure."},
        {"zh": "蓝火在谷里烧。", "en": "Blue fire burns in the valley."},
        {"zh": "我从火边上走过去。", "en": "I walk past the fire."},
        {"zh": "我的皮很薄，像布。", "en": "My hide is thin, like cloth."},
        {"zh": "骨节在皮下顶着。", "en": "Bones push against it."},
        {"zh": "但方向从不改。", "en": "But my direction never changes."},
        {"zh": "我朝有活气的地方走。", "en": "I head toward where life is."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，头几乎碰到岩石。", "en": "I stand with my head nearly at the rock."},
        {"zh": "长长的影子贴在峡谷壁上。", "en": "My long shadow lies on the canyon wall."},
        {"zh": "峡谷的风吹动我背上的皮。", "en": "Canyon wind stirs the hide on my back."},
        {"zh": "骨节响了一下。", "en": "A joint clicks."},
        {"zh": "蓝火映在我的眼里。", "en": "Blue fire sits in my eyes."},
        {"zh": "我一直不眨眼。", "en": "I never blink."},
        {"zh": "风穿过我的身体。", "en": "Wind passes through my body."},
        {"zh": "带走了什么。", "en": "Taking something with it."},
        {"zh": "我垂下了手。", "en": "I let my hand drop."},
        {"zh": "我垂手站着，像一截枯木。", "en": "I stand with hands hanging, like dead wood."},
        {"zh": "沙子从指间漏下去。", "en": "Sand trickles between my fingers."},
        {"zh": "灵魂沙峡谷里，我等了很久。", "en": "In the soul sand valley, I have waited long."},
        {"zh": "还得再等更久。", "en": "I will wait longer still."},
        {"zh": "这里没有什么会自己来。", "en": "Nothing comes here on its own."},
        {"zh": "所以我要去。", "en": "So I must go."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头，你要仰得很高才看得见。", "en": "I lower my head; you must crane far up."},
        {"zh": "你身上的气很亮。", "en": "The life in you is bright."},
        {"zh": "我盯着那点亮。", "en": "I fix on that brightness."},
        {"zh": "我伸出很长的手臂。", "en": "I extend my long arm."},
        {"zh": "手指停在半空。", "en": "My fingers stop in the air."},
        {"zh": "我没有挨到你。", "en": "I did not touch you."},
        {"zh": "我把头偏了偏。", "en": "I cock my head."},
        {"zh": "这不是善意。", "en": "This is not kindness."},
        {"zh": "这其实是在估量。", "en": "This is measurement."},
        {"zh": "你往后面退。", "en": "You step back."},
        {"zh": "我把手收回去。", "en": "I draw my hand back."},
        {"zh": "慢慢转过身。", "en": "And slowly turn away."},
        {"zh": "我没有失去耐心。", "en": "I have not lost patience."},
        {"zh": "我从不失去耐心。", "en": "I never lose patience."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "破口下面，是空的胸腔。", "en": "Beneath the tear is an empty chest cavity."},
        {"zh": "我缓缓转身。", "en": "I turn around slowly."},
        {"zh": "骨节响了一声。", "en": "A joint clicks."},
        {"zh": "我把破掉的皮按回去。", "en": "I press the torn hide back into place."},
        {"zh": "蓝火在我眼里晃。", "en": "Blue fire wavers in my eyes."},
        {"zh": "我的皮破了，蓝火还在烧。", "en": "My hide is torn, but the blue fire still burns."},
        {"zh": "我只是记下了。", "en": "I have simply noted it."},
        {"zh": "我的步子没有变。", "en": "My stride has not changed."},
        {"zh": "你留在原处。", "en": "You stay where you are."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些填不了我。", "en": "These cannot fill me."},
        {"zh": "我得吃别的。", "en": "I eat something else."},
        {"zh": "你把东西举起来。", "en": "You hold it up."},
        {"zh": "我要的东西在你身体里。", "en": "What I want is inside your body."},
        {"zh": "我伸了伸手。", "en": "I reach out a hand."},
        {"zh": "我又把手收回。", "en": "I draw my hand back."},
        {"zh": "活人的气息，真香。", "en": "The breath of the living. So sweet."},
        {"zh": "拿这个换你的魂，值。", "en": "This for your soul. A fair trade."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的腿上，像撞到骨头。", "en": "You hit my leg like hitting bone."},
        {"zh": "你撞在我腿骨上，我低头。", "en": "You hit my leg bone; I look down."},
        {"zh": "你退了半步，贴着岩壁。", "en": "You step back against the rock."},
        {"zh": "我站着，看你自己退远。", "en": "I stand and watch you back away."},
        {"zh": "风把我的皮吹得贴在骨上。", "en": "Wind presses my hide to the bone."},
        {"zh": "我慢慢转回去。", "en": "I turn slowly back."},
        {"zh": "我转身，沙从骨缝里漏下。", "en": "I turn, sand slipping through my ribs."},
        {"zh": "你已经走远了。", "en": "You have gone far."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有那样的东西。", "en": "There is nothing like that here."},
        {"zh": "我只是一个收集的。", "en": "I am only a collector."},
        {"zh": "收集什么，你不会想知道。", "en": "You do not want to know what."},
        {"zh": "我胸口空着，放不进一颗心。", "en": "My chest is hollow; no heart fits there."},
        {"zh": "胸骨后面是空的。", "en": "It is hollow behind my breastbone."},
        {"zh": "一直都是空的。", "en": "It has always been empty."},
        {"zh": "风又穿过我。", "en": "Wind passes through me again."},
        {"zh": "我把头仰高。", "en": "I tilt my head high."},
        {"zh": "峡谷上方什么也没有。", "en": "Above the canyon there is nothing."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰，手指垂到地面。", "en": "I bend; my fingers reach the ground."},
        {"zh": "我把它夹起来。", "en": "I pinch it up."},
        {"zh": "很小，几乎没有重量。", "en": "Tiny, and nearly weightless."},
        {"zh": "我举到眼前。", "en": "I raise it to my eye."},
        {"zh": "里面没有气。", "en": "There is no life in it."},
        {"zh": "我松开手指丢掉。", "en": "I open my fingers and drop it."},
        {"zh": "沙子把它埋住。", "en": "The sand covers it."},
        {"zh": "我又往前走。", "en": "I walk on."},
        {"zh": "去找有气的。", "en": "To find something with life."},
        {"zh": "那才值得伸手。", "en": "That is worth reaching for."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "峡谷里有了别的味道。", "en": "A different smell enters the canyon."},
        {"zh": "我停住脚步。", "en": "I halt my steps."},
        {"zh": "蓝火在我身后烧。", "en": "Blue fire burns behind me."},
        {"zh": "我朝活气那边走。", "en": "I walk toward the living warmth."},
        {"zh": "腿很长，步子很大。", "en": "Long legs, long strides."},
        {"zh": "沙子被踩得陷下去。", "en": "The sand sinks under me."},
        {"zh": "它听见我的脚步。", "en": "It hears my steps."},
        {"zh": "它开始走快。", "en": "It begins to move faster."},
        {"zh": "我也没有更快。", "en": "I do not go faster either."},
        {"zh": "我迈一步，够你走三步。", "en": "One of my steps covers three of yours."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它转弯，我跟着转。", "en": "It turns; I turn."},
        {"zh": "它跑，我就走。", "en": "It runs; I walk."},
        {"zh": "它跑不了一整天。", "en": "It cannot run all day."},
        {"zh": "我可以走上好几天。", "en": "I can walk for days."},
        {"zh": "它回头看了几次。", "en": "It looks back several times."},
        {"zh": "每次我都在。", "en": "Each time I am there."},
        {"zh": "我的影子越来越长。", "en": "My shadow grows longer."},
        {"zh": "它靠着一块石头坐下。", "en": "It sits against a stone."},
        {"zh": "我已经走近了。", "en": "I have come close."},
        {"zh": "我的手探出去。", "en": "My hand reaches out."},
        {"zh": "它把脸朝上抬。", "en": "It turns its face up."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手按在它胸口。", "en": "My hand presses its chest."},
        {"zh": "它整个僵住了。", "en": "It goes rigid."},
        {"zh": "我慢慢往里收。", "en": "I draw inward, slowly."},
        {"zh": "有东西顺着我的手臂过来。", "en": "Something travels up my arm."},
        {"zh": "我的指尖很凉。", "en": "My fingertips are cold."},
        {"zh": "灵魂沙峡谷里，我吸着。", "en": "In the soul sand valley, I draw breath."},
        {"zh": "我只是接着。", "en": "I only receive."},
        {"zh": "它的脸慢慢白下去。", "en": "Its face slowly pales."},
        {"zh": "我松开手指。", "en": "I open my fingers."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "峡谷里的蓝火往一边偏。", "en": "The blue fire in the canyon leans aside."},
        {"zh": "我从中走出来。", "en": "I walk out of it."},
        {"zh": "我又高又瘦。", "en": "I am tall and thin."},
        {"zh": "头几乎擦到岩石顶。", "en": "My head nearly scrapes the rock roof."},
        {"zh": "沙子在我脚下陷。", "en": "The sand sinks beneath me."},
        {"zh": "峡谷静得很。", "en": "The canyon is very quiet."},
        {"zh": "没有活的东西。", "en": "There is nothing alive."},
        {"zh": "所以我要出去。", "en": "So I must go out."},
        {"zh": "走到有气的地方。", "en": "To where there is life."},
        {"zh": "风把我的皮吹得响。", "en": "Wind rattles my hide."},
        {"zh": "我的脚落进沙里，很深。", "en": "My foot sinks deep into the sand."},
        {"zh": "很久之后我才停下。", "en": "I stop only much later."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "蓝火和我身上的火一起烧。", "en": "Blue fire burns with the fire on me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，骨头先着地。", "en": "I fall, bones hitting first."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我空的身体里。", "en": "Water fills my hollow body."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我吹得向后仰。", "en": "The blast bends me backward."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿过了我。", "en": "It passes right through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力在我的骨头上缠了一圈。", "en": "Magic coils around my bones."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，我收集。", "en": "I do not eat; I collect."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我身上，蓝火更亮。", "en": "Lightning strikes me; the blue fire brightens."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有气可收。", "en": "In the void there is no life to collect."}
      ]
    }
  }
}
