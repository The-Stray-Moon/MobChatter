{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "沙粒在我脚下滚。", "en": "Sand rolls under my feet."},
        {"zh": "我走得比风还慢。", "en": "I move slower than the wind."},
        {"zh": "矮着身子往前蹭。", "en": "I scuttle forward, low to the ground."},
        {"zh": "沙地上拖出一道痕。", "en": "I drag a line across the sand."},
        {"zh": "一边走一边张望。", "en": "Walking while looking around."},
        {"zh": "脚下的沙热得烫。", "en": "The sand is hot underfoot."},
        {"zh": "我绕开一块骨头。", "en": "I go around a bone."},
        {"zh": "步子有一下没一下。", "en": "My steps come unevenly."},
        {"zh": "身上的沙壳在响。", "en": "My sand crust crunches."},
        {"zh": "慢慢靠近那片阴影。", "en": "Easing toward that shade."},
        {"zh": "沙丘那边什么都没有。", "en": "Nothing over by the dune."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在沙里。", "en": "I lie low in the sand."},
        {"zh": "沙壳里有点痒。", "en": "Something itches in my crust."},
        {"zh": "我只露出半个头。", "en": "Only half my head shows."},
        {"zh": "风把我的痕吹平。", "en": "The wind smooths my tracks."},
        {"zh": "我在等太阳落。", "en": "I wait for the sun to set."},
        {"zh": "腿上的沙一直在掉。", "en": "Sand keeps falling off my legs."},
        {"zh": "我趴在沙上，扁得像块板。", "en": "Flat on the sand, I look like a plank."},
        {"zh": "我听着沙响。", "en": "I listen to the shifting sand."},
        {"zh": "沙丘在慢慢移动。", "en": "The dunes are creeping."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩得沙都陷了。", "en": "Your steps cave in the sand."},
        {"zh": "我比你矮一半。", "en": "I'm half your height."},
        {"zh": "我们之间没什么好说的。", "en": "There's nothing to say between us."},
        {"zh": "别再往这边过来。", "en": "Don't come over here."},
        {"zh": "你身上没有沙味。", "en": "You don't smell of sand."},
        {"zh": "我可一点都不怕。", "en": "I'm not a bit afraid."},
        {"zh": "你站着不动做什么。", "en": "Why stand there not moving?"},
        {"zh": "走开，我还想活。", "en": "Go away. I want to live."},
        {"zh": "我这么矮，只能咬脚踝。", "en": "This short, I can only bite ankles."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的沙壳掉了一块。", "en": "A chunk of my crust fell off."},
        {"zh": "沙从伤口往下漏。", "en": "Sand leaks from the wound."},
        {"zh": "哼一声，壳也绷紧了。", "en": "A snort, and my shell goes taut."},
        {"zh": "沙壳还撑得住。", "en": "The sand crust still holds."},
        {"zh": "这层壳救了我。", "en": "This crust saved me."},
        {"zh": "我抖了抖，继续站。", "en": "I shake it off and stand."},
        {"zh": "我记住你的味道。", "en": "I've got your scent."},
        {"zh": "下一次我会先动。", "en": "Next time I move first."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块是骨头吗？", "en": "Is that a bone?"},
        {"zh": "有点干的东西。", "en": "Something dry."},
        {"zh": "就留在沙上面。", "en": "Leave it on the sand."},
        {"zh": "我贴着沙爬。", "en": "I crawl flat over the sand."},
        {"zh": "放在沙地上就好。", "en": "Set it on the sand."},
        {"zh": "我够得着吗。", "en": "Can I reach it?"},
        {"zh": "先看看有没有陷阱。", "en": "Let me check for traps first."},
        {"zh": "这一点就够。", "en": "This little bit is enough."},
        {"zh": "往后退点，我怕有陷阱。", "en": "Step back; I fear a trap."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞散了我的沙。", "en": "You knocked my sand loose."},
        {"zh": "沙粒飞了一地。", "en": "Sand flew everywhere."},
        {"zh": "别踩我的壳。", "en": "Don't step on my crust."},
        {"zh": "我退到沙丘边上。", "en": "I retreat to the dune's edge."},
        {"zh": "我比看着更沉。", "en": "I'm heavier than I look."},
        {"zh": "两脚都陷进去了。", "en": "Both feet are stuck."},
        {"zh": "借过，我要过去。", "en": "Excuse me. I'm passing."},
        {"zh": "别碰我，我跑起来可不好看。", "en": "Don't touch me. I look awful when I run."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "沙里不适合这个。", "en": "Sand isn't suited to this."},
        {"zh": "别在这里等。", "en": "Don't wait here."},
        {"zh": "风一吹就找不到。", "en": "One gust and we lose each other."},
        {"zh": "先挖个坑吧。", "en": "Let's dig a pit first."},
        {"zh": "沙漠白天太烫。", "en": "The desert is too hot by day."},
        {"zh": "这种事我不太会。", "en": "I'm not good at this."},
        {"zh": "沙会埋住我们的。", "en": "The sand would bury us."},
        {"zh": "你要走了吧。", "en": "You're leaving, aren't you."},
        {"zh": "我会把这事记住。", "en": "I'll remember this."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "带沙的东西。", "en": "It's gritty with sand."},
        {"zh": "咬一下试试。", "en": "Let me bite it."},
        {"zh": "塞进沙壳里。", "en": "I tuck it into my crust."},
        {"zh": "咬不动，塞牙。", "en": "It won't bite. It sticks."},
        {"zh": "有一块碎骨。", "en": "A splinter of bone."},
        {"zh": "我拖着它慢慢走。", "en": "I drag it slowly."},
        {"zh": "藏好了，别丢掉。", "en": "I'll keep it hidden."},
        {"zh": "这味道还行。", "en": "This tastes passable."},
        {"zh": "地上还有一块呢。", "en": "There's another piece here."},
        {"zh": "我慢慢地吃。", "en": "I eat slowly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有影子罩下来。", "en": "A shadow dropped over me."},
        {"zh": "脚步声很重。", "en": "Those steps are heavy."},
        {"zh": "我这副小身子，先贴住地面。", "en": "Small as I am, I flatten against the ground."},
        {"zh": "这人比沙丘还高。", "en": "This one is taller than a dune."},
        {"zh": "沙在往我这边滑。", "en": "The sand slides toward me."},
        {"zh": "你挡着太阳，我把你看清了。", "en": "You block the sun; I see you clearly."},
        {"zh": "没别的路了。", "en": "No other route."},
        {"zh": "我先动一下试试。", "en": "Let me test with one move."},
        {"zh": "这风把味道吹过来。", "en": "The wind carries your smell."},
        {"zh": "你站的地方不对。", "en": "You're standing in the wrong place."},
        {"zh": "脚下在使劲。", "en": "My feet are digging in."},
        {"zh": "你退我也追。", "en": "Retreat, and I follow."},
        {"zh": "太阳照得我睁不开眼。", "en": "The sun blinds me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着沙丘跟。", "en": "I trail along the dune."},
        {"zh": "你走一步我挪一寸。", "en": "You step, I inch."},
        {"zh": "沙帮我遮住脚。", "en": "The sand hides my feet."},
        {"zh": "你的影子往东偏。", "en": "Your shadow leans east."},
        {"zh": "你脚一停，我就从沙里钻出来。", "en": "When your foot stops, I come out of the sand."},
        {"zh": "风一停我就冲。", "en": "I rush when the wind drops."},
        {"zh": "我贴着沙爬，到了你左腿边。", "en": "I crawl low along the sand to your left leg."},
        {"zh": "沙丘后面有条沟。", "en": "There's a gully behind the dune."},
        {"zh": "沙子盖着我，我数你走了几步。", "en": "Sand hides me; I count your steps."},
        {"zh": "我踩过的沙不会响。", "en": "Sand doesn't sound under me."},
        {"zh": "你回头看我了吗。", "en": "Did you look back?"},
        {"zh": "等它弯腰那一下。", "en": "Wait for it to bend over."},
        {"zh": "我把牙咬得紧紧的。", "en": "I clamp my teeth."},
        {"zh": "我要找个空档。", "en": "I need one opening."},
        {"zh": "你手放下来了。", "en": "Your hand came down."},
        {"zh": "沙堆会挡住你。", "en": "The sand heap will block you."},
        {"zh": "就趁这个空档。", "en": "Right in this gap."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一头撞向你的小腿！", "en": "A charge at your calf!"},
        {"zh": "沙壳顶过去。", "en": "My crust rams in."},
        {"zh": "抠你的脚背。", "en": "My claws rake your instep."},
        {"zh": "这一下很硬。", "en": "This one's hard."},
        {"zh": "沙迷了你的眼吧。", "en": "Sand in your eyes, isn't it."},
        {"zh": "我打得慢但很重。", "en": "Slow, but heavy."},
        {"zh": "你的靴子挡不住。", "en": "Your boots won't stop it."},
        {"zh": "再用头顶你一下。", "en": "Another shove of my head."},
        {"zh": "你退了我就追。", "en": "If you back off, I follow."},
        {"zh": "我用脑袋去撞。", "en": "I butt with my head."},
        {"zh": "这一下带沙。", "en": "That one came with sand."},
        {"zh": "我抓住你的裤脚。", "en": "I grab your trouser leg."},
        {"zh": "别抬脚踩我。", "en": "Don't lift that foot."},
        {"zh": "牙关一合就不松。", "en": "My jaw shuts and stays."},
        {"zh": "这一口气还没松。", "en": "I haven't let up yet."},
        {"zh": "我的壳会刮人。", "en": "My crust scrapes."},
        {"zh": "你退到沙里了。", "en": "You're backing into sand."},
        {"zh": "还没打完呢。", "en": "Not finished yet."},
        {"zh": "再顶你一下。", "en": "One more shove."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "沙底下有东西动了。", "en": "Something stirred under the sand."},
        {"zh": "沙底下的头，是我的。", "en": "That head breaking the sand is mine."},
        {"zh": "沙壳还软着。", "en": "My crust is still soft."},
        {"zh": "沙丘上冒出一个头。", "en": "A head pops up on the dune."},
        {"zh": "我从沙里爬出来，壳上还在掉。", "en": "Out of the sand, my shell still sheds."},
        {"zh": "这地方没什么吃的。", "en": "There's little to eat here."},
        {"zh": "沙壳还软，我一点一点往上钻。", "en": "My sand shell is still soft; I bore up slowly."},
        {"zh": "我看见远处有人。", "en": "I see someone far off."},
        {"zh": "沙子咯在我的关节里。", "en": "Sand grinds in my joints."},
        {"zh": "我又活了一天。", "en": "I've lived another day."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "沙壳被烧得结成块。", "en": "The heat fused my crust."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时沙壳碎了一角。", "en": "A corner of my crust broke."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把沙壳泡软了。", "en": "Water softened my crust."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "整片沙都被掀开。", "en": "The whole patch of sand flew up."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进沙里。", "en": "An arrow sank into my sand."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光穿过了我的壳。", "en": "The light went through my crust."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "十六点血，慢吞吞地扑。", "en": "Sixteen health, lunging slowly."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把沙烧成玻璃。", "en": "The strike turned sand to glass."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下什么都没了。", "en": "Nothing under my feet."}
      ]
    }
  }
}
