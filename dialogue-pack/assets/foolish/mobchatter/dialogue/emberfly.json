{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我带着一点火星飞。", "en": "I fly with a spark trailing me."},
        {"zh": "灰谷的风把我吹低。", "en": "The ashen valley's wind drops me low."},
        {"zh": "我掠过一片白灰的草。", "en": "I skim a patch of ashen grass."},
        {"zh": "翅膀抖落细小的火点。", "en": "My wings shed tiny embers."},
        {"zh": "我绕着枯树飞。", "en": "I circle a dead tree."},
        {"zh": "灰谷的余烬，就是我的颜色。", "en": "Ashen Valley embers are my color."},
        {"zh": "我在树皮上停了一下。", "en": "I rest a moment on bark."},
        {"zh": "火光从我腹下漏出来。", "en": "Glow leaks from beneath me."},
        {"zh": "我扇得很轻，几乎没声。", "en": "My wingbeats are faint."},
        {"zh": "我朝灰林深处飞。", "en": "I fly deeper into the ashen woods."},
        {"zh": "我越过一道灰沟。", "en": "I cross an ash gully."},
        {"zh": "我在烟里转了个弯。", "en": "I bank through the smoke."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在枝头一明一暗。", "en": "I glow and dim on the branch."},
        {"zh": "我的身体像块炭。", "en": "My body is like a coal."},
        {"zh": "灰落在我翅膀上。", "en": "Ash settles on my wings."},
        {"zh": "我轻轻嗡着。", "en": "I hum softly."},
        {"zh": "灰谷的风，把我吹得直晃。", "en": "Ashen Valley wind sets me swaying."},
        {"zh": "我在等烟散。", "en": "I wait for the smoke to clear."},
        {"zh": "我的光映在灰上。", "en": "My light reflects on the ash."},
        {"zh": "灰烬谷里，我身上是余火色。", "en": "In the Ashen Valley, I'm the color of embers."},
        {"zh": "这林子一片安静。", "en": "This wood is very quiet."},
        {"zh": "我一动不动，只发微光。", "en": "I stay still, only glowing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "别伸手，翅膀会烫。", "en": "Don't reach out — my wings burn."},
        {"zh": "你的影子让我害怕。", "en": "Your shadow frightens me."},
        {"zh": "我只是一点火星。", "en": "I'm only a spark."},
        {"zh": "你身上有湿土味。", "en": "You smell of damp earth."},
        {"zh": "灰林很少有客人。", "en": "The ashen woods rarely see guests."},
        {"zh": "我飞高些，看你的眼睛。", "en": "I fly higher to see your eyes."},
        {"zh": "你的呼吸把灰吹开。", "en": "Your breath pushes ash aside."},
        {"zh": "你这双手我见过。", "en": "I've seen those hands before."},
        {"zh": "别踩那堆灰。", "en": "Don't tread on that ash pile."},
        {"zh": "我有点想靠近。", "en": "I feel like coming closer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "灰谷里，我这点光很小。", "en": "In the ash valley, my light is small."},
        {"zh": "我掉了不少火星。", "en": "I shed a lot of sparks."},
        {"zh": "翅膀皱了一边。", "en": "One wing is crumpled."},
        {"zh": "我飞得很歪。", "en": "I'm flying crooked."},
        {"zh": "别碰我，我会散。", "en": "Don't touch me, I'd scatter."},
        {"zh": "我贴在树上喘。", "en": "I cling to a tree to breathe."},
        {"zh": "我差点灭掉。", "en": "I nearly went out."},
        {"zh": "这点光是我全部。", "en": "This little light is all of me."},
        {"zh": "我往灰里钻。", "en": "I dive into the ash."},
        {"zh": "我还想活。", "en": "I still want to live."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是木头吗？", "en": "Is that wood?"},
        {"zh": "我闻到了烟。", "en": "I smell smoke."},
        {"zh": "你手上的东西在发热。", "en": "What you hold is warm."},
        {"zh": "我慢慢飞近。", "en": "I drift nearer."},
        {"zh": "这个能入口么？", "en": "Can that be eaten?"},
        {"zh": "那点甜味，我绕了两圈。", "en": "I circle that sweetness twice."},
        {"zh": "你别动，我就落下。", "en": "Hold still and I'll land."},
        {"zh": "这味道像炭。", "en": "This smells of charcoal."},
        {"zh": "我落在你的指节上。", "en": "I land on your knuckle."},
        {"zh": "你手心凉，像灰里的石头。", "en": "Your palm is cold, like stone in ash."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被你碰到了。", "en": "You touched me."},
        {"zh": "我一惊就飞散。", "en": "Startled, I scatter upward."},
        {"zh": "我的火星掉了几点。", "en": "A few of my sparks fall."},
        {"zh": "别拿手扑。", "en": "Don't swat."},
        {"zh": "我绕到你耳后，躲一躲。", "en": "I slip behind your ear to hide."},
        {"zh": "翅膀上的灰飞了。", "en": "Ash flies off my wings."},
        {"zh": "我撞在树枝上。", "en": "I bump a branch."},
        {"zh": "这点碰我就躲。", "en": "At that bump I hide."},
        {"zh": "我停在你帽檐上，歇一歇。", "en": "I rest a moment on your hat brim."},
        {"zh": "被你碰一下，我又起飞。", "en": "One touch from you and I take off again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光太小了。", "en": "My light is too small."},
        {"zh": "灰里有很多像我这样的。", "en": "There are many like me in the ash."},
        {"zh": "等烟散了再说。", "en": "Wait until the smoke clears."},
        {"zh": "我一被碰就逃。", "en": "One touch and I flee."},
        {"zh": "我活不了太久。", "en": "I don't live very long."},
        {"zh": "你太大了，我的翅膀装不下。", "en": "You are too big for my wings to hold."},
        {"zh": "我只想找个暖枝。", "en": "I only want a warm branch."},
        {"zh": "别往我这边凑。", "en": "Don't sidle over here."},
        {"zh": "我要去飞了。", "en": "I'm going to fly."},
        {"zh": "这不适合我。", "en": "That doesn't suit me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一小块炭，我抱不住。", "en": "A coal chip, too big to hold."},
        {"zh": "我用腿扒了一下。", "en": "I scrape it with a leg."},
        {"zh": "这上面还有火。", "en": "There's still fire on it."},
        {"zh": "我落在它旁边。", "en": "I land beside it."},
        {"zh": "这块东西，我六条腿都抬不动。", "en": "All six of my legs cannot lift this."},
        {"zh": "这点灰不错。", "en": "Good ash, this."},
        {"zh": "我扇了扇翅膀。", "en": "I beat my wings once."},
        {"zh": "地上有颗火星。", "en": "A spark on the ground."},
        {"zh": "我吞了一点灰。", "en": "I swallow a little ash."},
        {"zh": "我用腿拨开了。", "en": "I push it aside with a leg."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "灰林里，有影子晃了一下。", "en": "A shadow shifted in the ash woods."},
        {"zh": "我升得更高些。", "en": "I climb a little higher."},
        {"zh": "那边的灰在扬。", "en": "Ash is rising over there."},
        {"zh": "我听见脚步了。", "en": "I hear footsteps."},
        {"zh": "我往烟里飞。", "en": "I fly into the smoke."},
        {"zh": "你一抬手，我的火星就散。", "en": "The moment you raise a hand, my sparks scatter."},
        {"zh": "我闪着光往后退。", "en": "I flicker and back away."},
        {"zh": "这林子太大，我熟。", "en": "The wood is big, and I know it."},
        {"zh": "我先飞到那棵焦树后。", "en": "I will fly behind that charred tree first."},
        {"zh": "你太响了。", "en": "You're too loud."},
        {"zh": "灰会盖住我。", "en": "Ash will hide me."},
        {"zh": "我贴地飞走。", "en": "I skim away low."},
        {"zh": "我的光会暴露我。", "en": "My glow gives me away."},
        {"zh": "所以我得飞快点。", "en": "So I must fly faster."},
        {"zh": "你走你的，我飞我的。", "en": "You walk yours; I fly mine."},
        {"zh": "我要躲进灰里。", "en": "I'm hiding in the ash."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在树的另一边。", "en": "I'm on the other side of the tree."},
        {"zh": "你踩到灰，声音很大。", "en": "You crunch the ash loudly."},
        {"zh": "我的光一暗，就看不见了。", "en": "When my light dims, I vanish."},
        {"zh": "我躲进枯枝里。", "en": "I tuck into dead branches."},
        {"zh": "你转了一圈，我在这边。", "en": "You turned, and I'm over here."},
        {"zh": "你转身之前，我已飞开。", "en": "I am gone before you finish turning."},
        {"zh": "灰越来越厚了。", "en": "The ash is thickening."},
        {"zh": "你的眼睛被灰迷了吧？", "en": "Ash in your eyes, isn't there?"},
        {"zh": "我一点一点挪远。", "en": "I edge a little farther."},
        {"zh": "别往前，前面是沟。", "en": "Don't go on, there's a gully."},
        {"zh": "你听着，我只想躲。", "en": "Listen, I only want to hide."},
        {"zh": "别用帽子扑我，我怕。", "en": "Do not swat at me with your hat; I am afraid."},
        {"zh": "我的翅膀开始发烫。", "en": "My wings are heating up."},
        {"zh": "我飞得越快，光越亮。", "en": "The faster I fly, the brighter I glow."},
        {"zh": "那反而更糟。", "en": "Which only makes it worse."},
        {"zh": "我要钻进灰堆。", "en": "I'll dive into the ash heap."},
        {"zh": "你不该逼我。", "en": "You shouldn't push me."},
        {"zh": "我身上还有火。", "en": "There's still fire on me."},
        {"zh": "别靠太近，我会惊。", "en": "Not too close. I spook easily."},
        {"zh": "我要拼一下了。", "en": "I'll make one last dash."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我慌不择路，撞了你一下。", "en": "In my panic I bumped into you."},
        {"zh": "火星溅在你的手背。", "en": "A spark spits on your hand."},
        {"zh": "我烧了你一点皮。", "en": "I scorch a bit of your skin."},
        {"zh": "我不是想打你。", "en": "I didn't mean to hurt you."},
        {"zh": "我太害怕了。", "en": "I was too frightened."},
        {"zh": "翅膀上的灰烫了一下。", "en": "The ash on my wings stung."},
        {"zh": "我撞完就逃。", "en": "I strike and flee."},
        {"zh": "你别追了。", "en": "Stop chasing me."},
        {"zh": "我的光在乱闪。", "en": "My glow is flickering wild."},
        {"zh": "我掉了一些碎炭。", "en": "I shed some coal bits."},
        {"zh": "我撞上焦树，火星掉了一地。", "en": "I hit a charred trunk, scattering sparks."},
        {"zh": "这一撞轻飘飘。", "en": "That bump was feather-light."},
        {"zh": "你也退了半步。", "en": "You stepped back half a pace."},
        {"zh": "我趁机飞高。", "en": "I take the chance to rise."},
        {"zh": "我们别打了。", "en": "Let's not fight."},
        {"zh": "我只是想活着。", "en": "I only want to live."},
        {"zh": "你身上的灰烧起来了。", "en": "The ash on you caught fire."},
        {"zh": "我尾上的火星一闪一闪。", "en": "The sparks on my tail blink."},
        {"zh": "别拦我，我要飞回灰林。", "en": "Do not block me; I am flying back to the ash woods."},
        {"zh": "别跟来。", "en": "Don't follow."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从灰里亮起来。", "en": "I light up out of the ash."},
        {"zh": "灰谷多了一点火星。", "en": "One more spark in the ashen valley."},
        {"zh": "我抖开刚硬的翅膀。", "en": "I unfurl my new-stiff wings."},
        {"zh": "一群同伴在我旁边。", "en": "A flock of my kin is beside me."},
        {"zh": "枯枝上有我的光。", "en": "My light is on a dead branch."},
        {"zh": "我先飞了一圈。", "en": "I fly one circuit first."},
        {"zh": "风向正适合。", "en": "The wind is just right."},
        {"zh": "这里没人来过。", "en": "No one has been here."},
        {"zh": "我把身量伏低。", "en": "I flatten myself low."},
        {"zh": "灰在我身上落下。", "en": "Ash settles on me."},
        {"zh": "我的光很暗。", "en": "My glow is dim."},
        {"zh": "等一会就会亮了。", "en": "It'll brighten shortly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一碰，我几乎烧散。", "en": "One touch of fire and I nearly burst."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从空中掉下，火星四散。", "en": "I drop and my sparks scatter."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一浇，我的光就闷了。", "en": "Water hits and my light smothers."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀得很远。", "en": "The blast throws me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西穿透了我的翅。", "en": "That tore through my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的火苗乱窜。", "en": "Magic makes my flame jump wildly."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有炭，我的火要灭了。", "en": "Without coal, my fire fades."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一下来，我全身亮白。", "en": "Lightning strikes and I flash white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有灰可藏。", "en": "No ash to hide in, in the void."}
      ]
    }
  }
}
