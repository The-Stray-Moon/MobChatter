{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在半空，慢慢往前。", "en": "I hover and drift forward."},
        {"zh": "我的边缘闪着冷光。", "en": "My edges give a cold shine."},
        {"zh": "我不落地，也不走。", "en": "I do not land. I do not walk."},
        {"zh": "我贴着石柱浮过去", "en": "I float past the stone pillar."},
        {"zh": "我升高了一点。", "en": "I rise a little."},
        {"zh": "又落回原来的高度。", "en": "And sink back to my old height."},
        {"zh": "我的影子在地上一格一格移。", "en": "My shadow moves block by block below."},
        {"zh": "我停下，转了半圈。", "en": "I stop and turn half around."},
        {"zh": "先看清背后。", "en": "To check behind."},
        {"zh": "后方空无一物。", "en": "Nothing behind."},
        {"zh": "我往前滑行。", "en": "I slip forward."},
        {"zh": "我经过一盏灯，光从我身上滑过去。", "en": "I pass a lamp and the light slides off me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，几乎不动。", "en": "I hang, almost still."},
        {"zh": "我的形状很薄。", "en": "My shape is very thin."},
        {"zh": "光在我身上分成几道。", "en": "Light splits across me in lines."},
        {"zh": "我始终在听着。", "en": "I am always listening."},
        {"zh": "四周非常安静。", "en": "It is very quiet all around."},
        {"zh": "我把角度调了调。", "en": "I adjust my angle."},
        {"zh": "这样能看清更多。", "en": "From here I see more."},
        {"zh": "我在等有人先动手。", "en": "I wait for someone to strike first."},
        {"zh": "我一向都是这样。", "en": "I have always been so."},
        {"zh": "悬在这里，我不抢先", "en": "Hanging here, I do not strike first."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "薄薄一片，正对着你", "en": "A thin sliver, squared to you."},
        {"zh": "我的边缘对着你的方向。", "en": "My edge points your way."},
        {"zh": "我脸上没有表情。", "en": "My face shows nothing."},
        {"zh": "你看不出我在想什么。", "en": "You cannot read me."},
        {"zh": "我也看不出你。", "en": "Nor I, you."},
        {"zh": "你把手抬起来了。", "en": "You raise your hand."},
        {"zh": "我退开半尺，只是习惯", "en": "I drift back half a foot; just habit."},
        {"zh": "不是怕，是习惯。", "en": "Not fear. Habit."},
        {"zh": "你要是不动手，我就走。", "en": "If you do not strike, I will leave."},
        {"zh": "我把身子转开。", "en": "I turn away."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我只有一点血，也闪。", "en": "One point of health, and I still gleam."},
        {"zh": "边缘缺了一角。", "en": "A corner of my edge is gone."},
        {"zh": "我退到半空中。", "en": "I withdraw into the air."},
        {"zh": "光散了又聚起。", "en": "The light scatters and gathers."},
        {"zh": "我重新稳住身形。", "en": "I steady my shape again."},
        {"zh": "一点血的我，这一下更薄。", "en": "One point of health, and that made me thinner."},
        {"zh": "缺了一角，我转着找平衡", "en": "A corner gone, I spin to find balance."},
        {"zh": "我盯着那道口子。", "en": "I look at the wound."},
        {"zh": "它自己会合上。", "en": "It will close on its own."},
        {"zh": "只是要一会儿。", "en": "Only it will take a while."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西会反光。", "en": "That thing reflects light."},
        {"zh": "那点光，我多看两眼", "en": "I take a second look at that glimmer."},
        {"zh": "只是看，不是要。", "en": "Only to look. Not to take."},
        {"zh": "食物与我无关。", "en": "Food has nothing to do with me."},
        {"zh": "我的身体也不需要。", "en": "My body does not need it either."},
        {"zh": "你举着它，我停住了。", "en": "You hold it up and I stop."},
        {"zh": "它把光切开了。", "en": "It cuts the light."},
        {"zh": "这我有点兴趣。", "en": "That interests me somewhat."},
        {"zh": "但也仅此而已。", "en": "But only so much."},
        {"zh": "我又升高一点。", "en": "I rise a little."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "被撞斜了，我又浮正", "en": "Knocked askew, I level out again."},
        {"zh": "我转了一圈才停。", "en": "I spin once before stopping."},
        {"zh": "我的边缘擦到你。", "en": "My edge grazes you."},
        {"zh": "不深，可是会疼。", "en": "Not deep, but it stings."},
        {"zh": "我退到一边去。", "en": "I move aside."},
        {"zh": "我只有一点生命，却有一把好刀。", "en": "One health point, and a fine blade."},
        {"zh": "我浮在你上方。", "en": "I hover above you."},
        {"zh": "滑开之后，我停在半空", "en": "Having slid away, I hang midair."},
        {"zh": "你抬头，我的刃正对你", "en": "You look up, and my edge faces you."},
        {"zh": "我也正在看你。", "en": "I am looking at you too."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只有一点血也敢飞。", "en": "One point of health and I still fly."},
        {"zh": "我既是光也是刃。", "en": "I am light and edge."},
        {"zh": "并没有可以延续的。", "en": "There is nothing in me to continue."},
        {"zh": "同类相遇，只会擦过。", "en": "When my kind meet, we only graze past."},
        {"zh": "一道光碰另一道光。", "en": "One light against another."},
        {"zh": "然后就分开了。", "en": "Then part."},
        {"zh": "我什么都不会留下。", "en": "I leave nothing behind."},
        {"zh": "也没有留下过。", "en": "And never have."},
        {"zh": "我继续浮着。", "en": "I go on hovering."},
        {"zh": "这里的光很好。", "en": "The light is good here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "没有手，我只好挑一挑", "en": "No hands, so I can only nudge it."},
        {"zh": "我并没有手。", "en": "I have no hands."},
        {"zh": "我只能去推。", "en": "I can only push."},
        {"zh": "我用边缘把它挑起来。", "en": "I lift it on my edge."},
        {"zh": "它悬了一瞬。", "en": "It hangs an instant."},
        {"zh": "然后又落下去。", "en": "Then it falls."},
        {"zh": "我试了第二次。", "en": "I try a second time."},
        {"zh": "结果还是一样。", "en": "The same as before."},
        {"zh": "我只好放弃了。", "en": "I give up."},
        {"zh": "它留在地上。", "en": "It stays on the ground."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你一动，我就跟上去", "en": "You move, and I follow."},
        {"zh": "那你就动吧。", "en": "Then move."},
        {"zh": "我的锋刃一闪。", "en": "My edge flashes."},
        {"zh": "我朝你转过去。", "en": "I turn toward you."},
        {"zh": "也算不上远。", "en": "Not so far."},
        {"zh": "我一瞬间就到。", "en": "One instant and I am there."},
        {"zh": "刃已经贴到你喉前", "en": "My edge is already at your throat."},
        {"zh": "那也没有关系。", "en": "That does not matter."},
        {"zh": "是我先动的手。", "en": "I moved first."},
        {"zh": "你倒退了一步。", "en": "You fell back a step."},
        {"zh": "我贴了过去。", "en": "I close in."},
        {"zh": "我把身位压低。", "en": "I press low."},
        {"zh": "几乎贴着地面。", "en": "Almost to the floor."},
        {"zh": "你一点没看见。", "en": "You did not see."},
        {"zh": "看见也没用，我更快", "en": "Seeing it does not help; I am quicker."},
        {"zh": "可是已经晚了。", "en": "But it is late."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一圈一圈转，光在飘", "en": "I circle and circle; my light drifts."},
        {"zh": "我的光在你脸上滑过。", "en": "My light slides across your face."},
        {"zh": "你不确定我在哪。", "en": "You are unsure where I am."},
        {"zh": "我停在你的侧后。", "en": "I stop at your back quarter."},
        {"zh": "你的肩膀绷着。", "en": "Your shoulders are tight."},
        {"zh": "我升高，又落下。", "en": "I rise, then drop."},
        {"zh": "你在跟着我转。", "en": "You turn with me."},
        {"zh": "你转得比我慢。", "en": "You turn slower than I move."},
        {"zh": "换个角度，光就偏了", "en": "A new angle, and my light shifts."},
        {"zh": "你又转过身来。", "en": "You turn again."},
        {"zh": "我一点不累。", "en": "I do not tire."},
        {"zh": "可你一定会累。", "en": "You will."},
        {"zh": "我就这么悬着。", "en": "I simply hang there."},
        {"zh": "你的气息不匀了。", "en": "Your breathing has gone uneven."},
        {"zh": "现在我到你上面。", "en": "Now I am above you."},
        {"zh": "你的头抬起来。", "en": "Your head comes up."},
        {"zh": "我就在那个位置。", "en": "I am right there."},
        {"zh": "我的边缘对着你的颈。", "en": "My edge is toward your neck."},
        {"zh": "就停在那里。", "en": "Stop."},
        {"zh": "我凝住不动。", "en": "I hold."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一闪，就到你身边。", "en": "In a flicker I am at your side."},
        {"zh": "我的边缘切进去。", "en": "My edge cuts in."},
        {"zh": "很轻，也很快。", "en": "Lightly. Quickly."},
        {"zh": "你退了半步远。", "en": "You give half a step of ground."},
        {"zh": "我跟着，又一下。", "en": "I follow with another."},
        {"zh": "我本身没有重量。", "en": "I have no weight."},
        {"zh": "可我的刃有重量。", "en": "But my blade does."},
        {"zh": "你抬手来挡。", "en": "You raise an arm to block."},
        {"zh": "挡住了一只，没有第二只。", "en": "You stop one, not the next."},
        {"zh": "刃从你肩后掠过", "en": "My edge passes behind your shoulder."},
        {"zh": "你转过身来。", "en": "You turn."},
        {"zh": "我早就走了。", "en": "I am already gone."},
        {"zh": "左边一刀，右边又一刀", "en": "One cut left, another right."},
        {"zh": "这样打，很难赢。", "en": "Fought this way, it is hard to win."},
        {"zh": "刃收住了，就在你眼前", "en": "My edge stops, right before your eyes."},
        {"zh": "停在你面前。", "en": "Hovering before you."},
        {"zh": "你还可以离开。", "en": "You may still leave."},
        {"zh": "我不追着打。", "en": "I do not hunt anyone down."},
        {"zh": "我只做回应。", "en": "I only answer."},
        {"zh": "这是我唯一会说的一句。", "en": "That is the only thing I say."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从光里出现。", "en": "I appear out of the light."},
        {"zh": "先是薄薄一条线。", "en": "First a thin line."},
        {"zh": "然后是一个面。", "en": "Then a surface."},
        {"zh": "最后才是我的形。", "en": "And at last my shape."},
        {"zh": "我悬着，转了半圈。", "en": "I hang and turn halfway."},
        {"zh": "这地方光很杂。", "en": "The light here is muddled."},
        {"zh": "那里干净，我选那边。", "en": "That spot is clean; I choose it."},
        {"zh": "我又浮高了一寸。", "en": "I rise an inch higher."},
        {"zh": "那里干净些。", "en": "It is cleaner there."},
        {"zh": "下面有人在走。", "en": "Someone is walking below."},
        {"zh": "我悬着没有动。", "en": "I hang without moving."},
        {"zh": "让他先走一步。", "en": "Let him go first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火穿过我的形，我被烧掉一层。", "en": "Fire passes through me and burns away a layer."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从半空被砸落，落地时散开。", "en": "I am struck down and scatter on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我压住，光在里面暗了。", "en": "Water presses me down and my light dims in it."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的形吹散了一瞬。", "en": "The blast scatters my shape for an instant."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过去，留下一个洞。", "en": "An arrow passes through and leaves a hole."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "另一道光压住我，我动不了。", "en": "Another light pins me and I cannot move."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "太久没有光，我开始变淡。", "en": "Too long without light; I begin to fade."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击下来，我整个人都亮了。", "en": "Lightning strikes and I flare all over."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有光，我在黑里变薄。", "en": "No light in the void. I thin into the dark."}
      ]
    }
  }
}
