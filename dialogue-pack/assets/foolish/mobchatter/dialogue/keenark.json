{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小步跑，尾巴一晃。", "en": "I trot, tail swinging."},
        {"zh": "我跟着同伴走成一群。", "en": "I move in a group with my kind."},
        {"zh": "草比我高，我钻过去。", "en": "The grass is taller than me; I push through."},
        {"zh": "我的蹄子很轻。", "en": "My hooves are light."},
        {"zh": "我踩着草根，一步一步跟队。", "en": "I step on grass roots, following the herd."},
        {"zh": "听到响动，我停下来。", "en": "I halt at a sound."},
        {"zh": "我顺着林边走。", "en": "I keep to the wood's edge."},
        {"zh": "我走一步，看一眼四周。", "en": "A step, then a look around."},
        {"zh": "我在低矮的草丛里穿行。", "en": "I thread the low brush."},
        {"zh": "我跟着前面的那只。", "en": "I follow the one ahead."},
        {"zh": "我小心地踩过枯枝。", "en": "I step over dead twigs carefully."},
        {"zh": "我跑开一点，又等你。", "en": "I run a little ahead, then wait."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我们四只一起，从草丛里探头。", "en": "Four of us poke out of the grass together."},
        {"zh": "耳朵转了一下。", "en": "One ear turns."},
        {"zh": "我在啃一口嫩叶。", "en": "I nibble a young leaf."},
        {"zh": "这一带没有危险。", "en": "No danger here."},
        {"zh": "我的同伴在附近吃草。", "en": "My group grazes nearby."},
        {"zh": "我眨眼，很慢。", "en": "I blink slowly."},
        {"zh": "灌木里有动静。", "en": "Something moves in the brush."},
        {"zh": "我卧了下来。", "en": "I lie down."},
        {"zh": "我低头啃了一口带露的草。", "en": "I lower my head and bite dew-wet grass."},
        {"zh": "我低头啃草，耳朵还竖着。", "en": "I graze with my ears still up."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你步子太急了。", "en": "Your pace is too hasty."},
        {"zh": "我仰头看你。", "en": "I look up at you."},
        {"zh": "你不像要打我。", "en": "You do not look like you will hit me."},
        {"zh": "我从草丛里露出半张脸。", "en": "Half my face shows from the grass."},
        {"zh": "你站得够远了。", "en": "You are far enough."},
        {"zh": "我脑袋偏了一下。", "en": "My head tips."},
        {"zh": "各走各的路。", "en": "Each goes their own way."},
        {"zh": "你身上的味道很奇怪。", "en": "You smell strange."},
        {"zh": "我往后挪了两步。", "en": "I shuffle two steps back."},
        {"zh": "别吓我的同伴。", "en": "Do not frighten my group."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一窜就跳开了。", "en": "I bolt clear."},
        {"zh": "我钻进灌木，只剩尾巴在外。", "en": "I burrow into the bush with only my tail showing."},
        {"zh": "我身上有一道口子。", "en": "A cut on my side."},
        {"zh": "我跑出好远。", "en": "I put a lot of ground between us."},
        {"zh": "疼得我直甩头。", "en": "The pain makes me toss my head."},
        {"zh": "我的同伴跑了。", "en": "My group has run."},
        {"zh": "我还没躺下。", "en": "I have not gone down."},
        {"zh": "我全身一颤。", "en": "A shiver runs through me."},
        {"zh": "我不该停下的。", "en": "I should not have stopped."},
        {"zh": "这一笔我留着。", "en": "I will keep that in mind."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那叶子看着比这里的嫩。", "en": "That leaf looks tenderer than the ones here."},
        {"zh": "你搁地上就行。", "en": "Just set it down."},
        {"zh": "我一点一点凑近。", "en": "I edge in close."},
        {"zh": "我吃一口就走。", "en": "One bite and I go."},
        {"zh": "这比我找到的好。", "en": "Better than what I find."},
        {"zh": "我只咬一口嫩叶，就一口。", "en": "Just one bite of tender leaf, that is all."},
        {"zh": "还能再给点吗？", "en": "Could you spare more?"},
        {"zh": "站住，别乱动。", "en": "Hold still."},
        {"zh": "我含着叶子，耳朵还在听你。", "en": "I chew the leaf with one ear still on you."},
        {"zh": "我承你的情。", "en": "I am obliged to you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我从你脚边窜回草丛。", "en": "I dart from your feet back into the grass."},
        {"zh": "我的脚被你压了。", "en": "My foot is under yours."},
        {"zh": "我往旁边闪。", "en": "I dodge aside."},
        {"zh": "我们都没事就好。", "en": "As long as neither of us is hurt."},
        {"zh": "我的四条腿一起打了个趔趄。", "en": "All four of my legs stumble at once."},
        {"zh": "我抖了抖浑身的毛。", "en": "I shake out all my fur."},
        {"zh": "你的个头太大了。", "en": "You are simply too large."},
        {"zh": "我在原地打了个小转。", "en": "I spin a small circle on the spot."},
        {"zh": "我已经挪开了。", "en": "I have already moved off."},
        {"zh": "我的小角顶到你的脚踝。", "en": "My little horn bumps your ankle."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们是成群过日子的。", "en": "We live in groups."},
        {"zh": "我得先看你是不是同一群。", "en": "First, are you of my group?"},
        {"zh": "我还不着急。", "en": "I am in no hurry."},
        {"zh": "这事在春天。", "en": "That is for spring."},
        {"zh": "我朝同伴那边看了一眼。", "en": "I glance toward my group."},
        {"zh": "我先闻闻它的角，再靠近。", "en": "I sniff its horn first, then step closer."},
        {"zh": "这个话题算了。", "en": "Let that topic drop."},
        {"zh": "我还会再想想。", "en": "I will think on it."},
        {"zh": "我溜到一边去了。", "en": "I slip off to one side."},
        {"zh": "往后再说吧。", "en": "Later on."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这叶子不错。", "en": "Good leaf."},
        {"zh": "我叼起来嚼。", "en": "I take it up and chew."},
        {"zh": "那是一块石头。", "en": "That is a stone."},
        {"zh": "我小得能藏在草里。", "en": "I'm small enough to hide in the grass."},
        {"zh": "我用蹄子拨开。", "en": "I nudge it aside with a hoof."},
        {"zh": "这嘴里吃不来。", "en": "I cannot eat this."},
        {"zh": "我凑近闻了一下。", "en": "I lean in to sniff."},
        {"zh": "我叼给同伴。", "en": "I carry it to my group."},
        {"zh": "这么小一块。", "en": "Such a small piece."},
        {"zh": "就放在这儿吧。", "en": "Leave it here."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "这不是我情愿的。", "en": "This is not my wish."},
        {"zh": "你打了我的同伴。", "en": "You struck one of mine."},
        {"zh": "我也会咬人的。", "en": "I can bite too."},
        {"zh": "我个子小，牙却尖。", "en": "Small as I am, my teeth are sharp."},
        {"zh": "我挡在同伴前面，毛竖着。", "en": "I stand before the herd, fur bristling."},
        {"zh": "我们就两下，够了。", "en": "Two hits and that is all I have."},
        {"zh": "我挡在它前面。", "en": "I stand in front of it."},
        {"zh": "这不是我挑起的。", "en": "I did not start this."},
        {"zh": "我伏低了身子。", "en": "I flatten myself down."},
        {"zh": "再近我就顶你。", "en": "One step more and I butt you."},
        {"zh": "你们都退后。", "en": "All of you, back off."},
        {"zh": "我警告过了。", "en": "You were warned."},
        {"zh": "我的牙长得很小。", "en": "My teeth are very small."},
        {"zh": "可我很顽固。", "en": "But I am stubborn."},
        {"zh": "尽管放马过来。", "en": "Come on, then."},
        {"zh": "我已经就绪。", "en": "I am ready."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我瞄着你的膝弯。", "en": "I aim at the back of your knee."},
        {"zh": "我压低身子，眼睛盯着你的手。", "en": "I crouch low, eyes on your hand."},
        {"zh": "我一动，草就响。", "en": "When I move, the grass speaks."},
        {"zh": "等你先出手。", "en": "You move first."},
        {"zh": "我的同伴在后面。", "en": "My group is behind me."},
        {"zh": "我不会让开路。", "en": "I am not stepping aside."},
        {"zh": "你手抬起来了。", "en": "Your hand is rising."},
        {"zh": "我前蹄敲了一下地。", "en": "I strike the ground with a forehoof."},
        {"zh": "这里草太密了。", "en": "The grass is too thick here."},
        {"zh": "我踩在软土上。", "en": "I am on soft soil."},
        {"zh": "我左右看了一眼。", "en": "I glance both ways."},
        {"zh": "我在同伴的中间。", "en": "I am in the middle of my group."},
        {"zh": "我们四个一起出来，你只看见一个。", "en": "Four of us came; you see only one."},
        {"zh": "我从边上绕。", "en": "I go round the side."},
        {"zh": "你再进一步。", "en": "One more step of yours."},
        {"zh": "我的小蹄子敲着软土。", "en": "My little hooves tap the soft earth."},
        {"zh": "我会咬你的腿。", "en": "I will go for your legs."},
        {"zh": "我前蹄一直没落地。", "en": "My forehoof has not come down."},
        {"zh": "我数完了数。", "en": "My count is finished."},
        {"zh": "我这就扑上来。", "en": "I am coming for you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞了你的小腿。", "en": "I butt your shin."},
        {"zh": "我下口咬了一下。", "en": "I close my teeth once."},
        {"zh": "我的角很短。", "en": "My horns are short."},
        {"zh": "我咬住你的鞋带往后拽。", "en": "I bite your shoelace and pull back."},
        {"zh": "我跳起来顶。", "en": "I leap to butt."},
        {"zh": "我的角撞在你护腿上，弹回来。", "en": "My horns hit your greaves and bounce back."},
        {"zh": "我再咬第二口。", "en": "I bite a second time."},
        {"zh": "我退开，护着同伴。", "en": "I pull back to guard my group."},
        {"zh": "这只够疼一下。", "en": "That will sting once."},
        {"zh": "我又顶了一记。", "en": "I butt once more."},
        {"zh": "我咬住你的裤腿。", "en": "I clamp your trouser leg."},
        {"zh": "我的蹄子刨起一小片草皮。", "en": "My hooves kick up a patch of turf."},
        {"zh": "你的护甲缝在脚踝。", "en": "The gap is at your ankle."},
        {"zh": "我尥了一蹄。", "en": "I kick out with a hoof."},
        {"zh": "这一口扑了个空。", "en": "That bite found nothing."},
        {"zh": "我用头顶你的脚背，一次两次。", "en": "I butt your instep once, then twice."},
        {"zh": "小巧的我，挡在同伴前面。", "en": "Small as I am, I stand before my kin."},
        {"zh": "你让开了一步。", "en": "You gave a step."},
        {"zh": "我不会追远。", "en": "I will not chase far."},
        {"zh": "我后退一步再冲。", "en": "I step back and charge again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从草里走出来。", "en": "I step out of the grass."},
        {"zh": "我们一群都在这儿。", "en": "My whole group is here."},
        {"zh": "我在同伴身后的草里卧下。", "en": "I settle into the grass behind my herd."},
        {"zh": "我把四面都看了一遍。", "en": "I looked all around first."},
        {"zh": "我动了动两只耳朵。", "en": "I flick both ears."},
        {"zh": "这里的草够吃。", "en": "Enough grass here."},
        {"zh": "我离同伴不远。", "en": "I stay near my group."},
        {"zh": "四只小兽一起从草里站起。", "en": "Four small beasts rise from the grass at once."},
        {"zh": "我一步步走上前。", "en": "I come forward step by step."},
        {"zh": "这么小的脚印，不是我的。", "en": "These small prints aren't mine."},
        {"zh": "我还不确定要不要跑。", "en": "I have not decided whether to run."},
        {"zh": "我的耳朵朝你的方向转了转。", "en": "My ears swivel toward you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一近，我的毛就焦了。", "en": "Near fire, my fur singes."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从山坡上滚落。", "en": "I tumble down the slope."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我不该往水里去的。", "en": "I should not have gone to the water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀了几个跟头。", "en": "The blast tumbles me over and over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎在我的后腿上。", "en": "An arrow sticks in my hind leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我四腿发软。", "en": "That light weakens all four legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "草被吃光了。", "en": "The grass is all eaten."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在树上，我吓跑了。", "en": "Lightning hits a tree; I bolt."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有草根可踩。", "en": "No grass roots to stand on here."}
      ]
    }
  }
}
