{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跨过碎石，步子很长。", "en": "I stride over rubble, step long."},
        {"zh": "我瘦长的影子扫过地面。", "en": "My gaunt shadow sweeps the ground."},
        {"zh": "我一步步往里逼。", "en": "I press in a step at a time."},
        {"zh": "我的关节颠倒着弯。", "en": "My joints bend the wrong way."},
        {"zh": "我走路时上身不动。", "en": "My upper body stays still as I walk."},
        {"zh": "我踩碎了一块末地石。", "en": "I crunch an end stone."},
        {"zh": "我从石柱后面绕出。", "en": "I come out from behind a pillar."},
        {"zh": "我的手臂垂得很低。", "en": "My arms hang very low."},
        {"zh": "我的长腿一步跨过裂缝。", "en": "My long legs step across the rift."},
        {"zh": "我停下来，又迈开。", "en": "I halt, then stride on."},
        {"zh": "我的脚步几乎听不见。", "en": "My steps are almost soundless."},
        {"zh": "我在砂地上留下深印。", "en": "I leave deep marks in the grit."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，比周围高一截。", "en": "I stand a head above everything."},
        {"zh": "我的头低下来，不动。", "en": "My head dips and holds."},
        {"zh": "紫色的雾绕在我腰上。", "en": "Violet mist coils at my waist."},
        {"zh": "我在数高地上的石柱。", "en": "I count the pillars on the highland."},
        {"zh": "我的甲片上刻着纹。", "en": "Markings are scored into my plates."},
        {"zh": "我一动不动，像根桩。", "en": "I stand still as a post."},
        {"zh": "末地的风，从不带好消息。", "en": "The End's wind never brings good news."},
        {"zh": "手指慢慢张开，关节在响。", "en": "Fingers slowly spread, joints clicking."},
        {"zh": "我没有自然的名字。", "en": "I have no natural place here."},
        {"zh": "没人召唤，我不会现身。", "en": "Without a summon, I do not appear."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你仰头才看得见我的脸。", "en": "You must look up to see my face."},
        {"zh": "你衣上落着末地灰。", "en": "End dust sits on your clothes."},
        {"zh": "我认得这块高地。", "en": "I know this highland."},
        {"zh": "你走得像想活。", "en": "You walk like someone who wants to live."},
        {"zh": "你腰上挂的，我认得。", "en": "I know what hangs at your belt."},
        {"zh": "你不用解释。", "en": "No need to explain."},
        {"zh": "我从不被自然叫来。", "en": "I'm never called by nature."},
        {"zh": "所以我更不该被赶走。", "en": "So I'm all the less to be driven off."},
        {"zh": "你挑的位置不错。", "en": "You've picked a decent spot."},
        {"zh": "好到跑不掉。", "en": "Good enough that you can't run."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我甲上裂开一道。", "en": "A split runs across my plate."},
        {"zh": "我退了半步，只是让路。", "en": "I stepped back half a pace, merely yielding."},
        {"zh": "这点伤，我还能走。", "en": "I can still walk with this."},
        {"zh": "头低下来，护住脖子。", "en": "Head down, guarding my neck."},
        {"zh": "我的关节有点涩。", "en": "My joints feel stiff."},
        {"zh": "十四层甲，你也敢敲。", "en": "Fourteen layers of plate, and you still strike."},
        {"zh": "我记住了你的手法。", "en": "I've learned your method."},
        {"zh": "末地尘落满我的肩甲。", "en": "End dust settles on my shoulder plates."},
        {"zh": "还没完事。", "en": "Not finished yet."},
        {"zh": "还能再来一回。", "en": "One more round is possible."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃，我只收贡品。", "en": "I do not eat; I only take tribute."},
        {"zh": "你举那么高，我也够得到。", "en": "Hold it high; I can still reach it."},
        {"zh": "我的口器不是为这个长的。", "en": "My mouthparts weren't grown for that."},
        {"zh": "放下，然后抬头。", "en": "Put it down, then look up."},
        {"zh": "你身上更诱人。", "en": "You are the more tempting thing."},
        {"zh": "这点东西骗不了我。", "en": "That won't fool me."},
        {"zh": "我不吃死物。", "en": "I don't eat dead things."},
        {"zh": "别再晃了。", "en": "Stop waving it."},
        {"zh": "你越举，我越近。", "en": "The higher you hold it, the closer I get."},
        {"zh": "十四点护甲，就是我的壳。", "en": "Fourteen armor is my shell."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我膝上。", "en": "You hit my knee."},
        {"zh": "我俯视着你。", "en": "I look down on you."},
        {"zh": "我没被推动。", "en": "I wasn't moved."},
        {"zh": "你撞上我的腿，退了两步。", "en": "You hit my leg and stumbled back two steps."},
        {"zh": "我的甲片擦响了一下。", "en": "My plates rasped once."},
        {"zh": "别贴在我腿边。", "en": "Don't stand against my legs."},
        {"zh": "你那点重量，碰不动甲。", "en": "Your weight cannot move this plate."},
        {"zh": "末地滚轮的影子，很薄。", "en": "An Enderoller's shadow is thin."},
        {"zh": "我抬手，你退得更快了。", "en": "I raise a hand and you retreat faster."},
        {"zh": "再靠近就来不及。", "en": "Closer and it'll be too late."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是被造出来的。", "en": "I was made, not born."},
        {"zh": "我没有同类。", "en": "I have no kin."},
        {"zh": "这是别人的事。", "en": "That's for other beings."},
        {"zh": "我只会猎。", "en": "I only hunt."},
        {"zh": "你该走远。", "en": "You should go far."},
        {"zh": "我的心思不在这。", "en": "My mind isn't on that."},
        {"zh": "别在我面前讲这个。", "en": "Don't speak of it before me."},
        {"zh": "我没那个耐性。", "en": "I have no patience for it."},
        {"zh": "说完就退后。", "en": "Say it and step back."},
        {"zh": "我这就动了。", "en": "I'm moving now."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块铁，我捏起。", "en": "This iron, I pinch it up."},
        {"zh": "太重，我松手了。", "en": "Too heavy, I let it go."},
        {"zh": "我的手指，比你的长。", "en": "My fingers are longer than yours."},
        {"zh": "我丢回地上。", "en": "I drop it back down."},
        {"zh": "这点光挡住我的眼。", "en": "This glimmer bothers my eyes."},
        {"zh": "我抬脚跨过去。", "en": "I step over it."},
        {"zh": "地上的东西不值一看。", "en": "Nothing on the ground is worth a look."},
        {"zh": "你掉了，别捡。", "en": "You dropped it. Leave it."},
        {"zh": "你手心里那点光，归我。", "en": "That glimmer in your palm is mine."},
        {"zh": "不是看那块铁。", "en": "Not the iron."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经被选中了。", "en": "You've been chosen."},
        {"zh": "我这一身瘦高，转得很快。", "en": "Lean and tall, I turn fast."},
        {"zh": "这片高地没有别人。", "en": "No one else on this highland."},
        {"zh": "你的脚跟，已经在我的范围。", "en": "Your heels are already inside my reach."},
        {"zh": "除非有人再叫我来。", "en": "Unless someone calls me again."},
        {"zh": "你站定的样子不错。", "en": "You hold your ground well."},
        {"zh": "可惜没用。", "en": "A pity it won't help."},
        {"zh": "我的手臂够长。", "en": "My arms are long enough."},
        {"zh": "你退三步也在里面。", "en": "Three steps back is still in range."},
        {"zh": "我从三数起。", "en": "I count from three."},
        {"zh": "我还剩两下。", "en": "Two more remain."},
        {"zh": "我数到一，你就得停。", "en": "I count to one, and you stop."},
        {"zh": "动。", "en": "Move."},
        {"zh": "我的长臂已经垂下来。", "en": "My long arms have already come down."},
        {"zh": "我高过你两个头。", "en": "I stand two heads above you."},
        {"zh": "抬头看我。", "en": "Look up at me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我这身甲十四点，撞得动。", "en": "Fourteen points of armor — I can ram."},
        {"zh": "我的头在高处。", "en": "My head stays high."},
        {"zh": "你看不清我的眼。", "en": "You can't see my eyes."},
        {"zh": "你每退一步，我都数着。", "en": "I count every step you retreat."},
        {"zh": "你的步伐开始变慢。", "en": "Your pace is slowing."},
        {"zh": "这片地很平，很空。", "en": "This ground is flat and bare."},
        {"zh": "你背后是石柱。", "en": "A pillar stands behind you."},
        {"zh": "你已经没有空间了。", "en": "You've run out of room."},
        {"zh": "我只等一个动作。", "en": "I wait for one motion."},
        {"zh": "你的剑尖偏了半寸。", "en": "Your blade tip is half an inch off."},
        {"zh": "就是这个。", "en": "That's the one."},
        {"zh": "我下来了。", "en": "I'm coming down."},
        {"zh": "朝你的位置。", "en": "At your position."},
        {"zh": "把眼睛睁着。", "en": "Keep your eyes open."},
        {"zh": "看着，我只演示一次。", "en": "Watch — I demonstrate only once."},
        {"zh": "这个距离，我一臂可及。", "en": "At this distance, one arm reaches you."},
        {"zh": "到此完结。", "en": "This ends here."},
        {"zh": "我的头在高处，你在下面。", "en": "My head is high; you are below."},
        {"zh": "可以了。", "en": "That's sufficient."},
        {"zh": "再试，我的护甲十四点还没削完。", "en": "Try again; my fourteen armor points are not gone."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的长臂扫下来。", "en": "My long arm sweeps down."},
        {"zh": "这一击砸在你脚边。", "en": "That crashed beside your feet."},
        {"zh": "我滚过去，地面就裂了。", "en": "I roll and the ground splits."},
        {"zh": "我把你抬起来又放下。", "en": "I lift you and set you down."},
        {"zh": "我的关节响得像折枝。", "en": "My joints crack like breaking twigs."},
        {"zh": "你被推得滚开。", "en": "You're shoved into a roll."},
        {"zh": "这一下我没用全劲。", "en": "I didn't use full force."},
        {"zh": "你的护甲开了口。", "en": "Your armor split open."},
        {"zh": "砂子进了伤口吧。", "en": "Grit in the wound, isn't there?"},
        {"zh": "我抬起另一只。", "en": "I raise the other arm."},
        {"zh": "挡住这只，还有那只。", "en": "Block this one, there's another."},
        {"zh": "你退得好。", "en": "Good retreat."},
        {"zh": "我的关节是反着弯的。", "en": "My joints bend the wrong way."},
        {"zh": "我只是走过去。", "en": "I simply walk."},
        {"zh": "一直走。", "en": "Always walking."},
        {"zh": "我一步跨过你的退路。", "en": "One stride takes me past your escape."},
        {"zh": "不是速度的问题。", "en": "It isn't a matter of speed."},
        {"zh": "是你总会累。", "en": "You'll tire eventually."},
        {"zh": "我不会。", "en": "I won't."},
        {"zh": "别躲了，我的手臂很长。", "en": "Stop dodging; my arms are long."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "有人把我叫了出来。", "en": "Someone has called me forth."},
        {"zh": "高地上多了一道高影。", "en": "A tall shadow joins the highland."},
        {"zh": "我落地时石柱晃了。", "en": "The pillar shook as I landed."},
        {"zh": "紫色的尘围着我转。", "en": "Violet dust circles me."},
        {"zh": "我把骨架拉到最高。", "en": "I stretch my frame to its full height."},
        {"zh": "这地方不是我生的。", "en": "I wasn't born here."},
        {"zh": "我是被放到这里的。", "en": "I was placed here."},
        {"zh": "我的手臂先动。", "en": "My arms move first."},
        {"zh": "我张开五根细长手指。", "en": "I spread five long slender fingers."},
        {"zh": "整片末地高地只有我。", "en": "I alone stand on this end highland."},
        {"zh": "只有风。", "en": "Only wind."},
        {"zh": "还有你。", "en": "And you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火贴在我的甲上，慢慢烧。", "en": "Fire clings to my plate and burns slow."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处坠下，站稳了。", "en": "I drop from height and land steady."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到胸口，我的动作慢了。", "en": "Water to my chest slows me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我推出了几步。", "en": "The blast pushes me a few steps."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西扎进我的长臂。", "en": "That lodged in my long arm."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力顺着我的甲片走。", "en": "Magic crawls along my plates."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿让我的关节发软。", "en": "Hunger softens my joints."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我身上，甲片齐响。", "en": "Lightning hits and every plate rings."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里我没有立足处。", "en": "No foothold in the void."}
      ]
    }
  }
}
