{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用后腿跳着走", "en": "I travel on my hind legs."},
        {"zh": "我一跳就是好几格", "en": "One hop carries me blocks."},
        {"zh": "我的鼻子很长", "en": "My snout is long."},
        {"zh": "我的尾巴在后面平衡", "en": "My tail balances me behind."},
        {"zh": "我跳着穿过蕨丛", "en": "I hop through the ferns."},
        {"zh": "我落下来几乎没有声", "en": "I land almost silently."},
        {"zh": "我的后腿比前腿长得多", "en": "My hind legs are far longer than my forelegs."},
        {"zh": "我一边跳一边看四周", "en": "I scan around as I hop."},
        {"zh": "我踩在落叶上很轻", "en": "I land lightly on the leaves."},
        {"zh": "我朝虫子多的地方去", "en": "I head where the insects are."},
        {"zh": "我的动作很快", "en": "My movements are quick."},
        {"zh": "我跳过一根倒木", "en": "I hop over a fallen log."},
        {"zh": "我落地时尾巴一甩", "en": "My tail flicks as I land."},
        {"zh": "我几乎一刻也不停", "en": "I hardly stop for a moment."},
        {"zh": "我顺着气味的线跳", "en": "I hop along a scent trail."},
        {"zh": "我在草丛里穿", "en": "I weave through the grass."},
        {"zh": "我一停就抬头", "en": "When I stop, I look up."},
        {"zh": "我朝前面跳得更远了", "en": "I hop farther ahead."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐下来梳理毛", "en": "I sit and groom my fur."},
        {"zh": "我的鼻子在动", "en": "My nose twitches."},
        {"zh": "我竖着耳朵听", "en": "I listen with my ears up."},
        {"zh": "我后腿弯着，随时能跳", "en": "My hind legs stay bent, ready to leap."},
        {"zh": "空气里有虫子的湿味", "en": "The air carries a damp insect smell."},
        {"zh": "我的尾巴卷了一下", "en": "My tail curled."},
        {"zh": "我前爪抱着一个果子", "en": "I hold a fruit in my forepaws."},
        {"zh": "我抬着头看树", "en": "I look up at the trees."},
        {"zh": "我用前爪洗了把脸", "en": "I washed my face with my forepaws."},
        {"zh": "我的耳朵转了个方向", "en": "My ears swiveled."},
        {"zh": "我蹲在石头边上", "en": "I crouch by a stone."},
        {"zh": "我在等虫子飞低", "en": "I wait for insects to fly low."},
        {"zh": "我身上的味道有点怪", "en": "Something about my scent is odd."},
        {"zh": "我绷紧着，没有真的跳", "en": "I tense, but do not leap."},
        {"zh": "我眨一下眼，耳朵扇了扇", "en": "I blink once and flick an ear."},
        {"zh": "我安静地待着，但耳朵不歇", "en": "I stay still, though my ears never rest."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你拦着我跳的路", "en": "You are blocking my hopping path."},
        {"zh": "我脑袋一歪，看你", "en": "My head tips to one side at you."},
        {"zh": "你身上有虫子的味道", "en": "You smell of insects."},
        {"zh": "我两条后腿绷着", "en": "My hind legs are coiled tight."},
        {"zh": "你别突然动一下", "en": "Do not move suddenly."},
        {"zh": "我跳到你侧面", "en": "I hop to your flank."},
        {"zh": "我鼻子抽了两下", "en": "My nose twitched twice."},
        {"zh": "你可不是虫子", "en": "You are not an insect."},
        {"zh": "我离你三格远", "en": "I keep three blocks away."},
        {"zh": "我在估算距离", "en": "I am judging the distance."},
        {"zh": "你一靠近我就跳开", "en": "Come near and I bound away."},
        {"zh": "我盯你盯到鼻子发酸", "en": "I've stared at you till my snout aches."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我惊得跳起来", "en": "I leap in alarm."},
        {"zh": "我一缩身躲进石缝", "en": "I tuck myself into a crack in the rock."},
        {"zh": "我抖开毛上的泥土", "en": "I shake the dirt out of my fur."},
        {"zh": "我被撞得往旁边跳开", "en": "The hit throws me sideways in a hop."},
        {"zh": "我不叫，我只会跑", "en": "I do not cry; I only run."},
        {"zh": "我后腿有点麻", "en": "My hind leg is numb."},
        {"zh": "我落地时晃了", "en": "I wobbled on landing."},
        {"zh": "我还撑得住，腿没软", "en": "I can still hold myself up; my legs haven't given."},
        {"zh": "你手上的劲不小", "en": "There is force in your arm."},
        {"zh": "我记下了你的手劲", "en": "I've noted the weight of your hand."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这是只虫子吗", "en": "Is this an insect?"},
        {"zh": "这个我倒是能吃", "en": "I can actually eat this."},
        {"zh": "拿低些，够得着", "en": "Lower it within reach."},
        {"zh": "我先凑近闻闻", "en": "Let me lean in and sniff."},
        {"zh": "它硬得我咬不动", "en": "It is too hard for me to bite."},
        {"zh": "有虫子的味道吗", "en": "Does it smell of insects?"},
        {"zh": "你的手一抖，我就跑", "en": "If your hand twitches, I bolt."},
        {"zh": "我含着它钻进蕨丛", "en": "I take it in my mouth and dart into the ferns."},
        {"zh": "我要会扑腾的", "en": "I want something that flutters."},
        {"zh": "再给我一点点", "en": "A little more, please."},
        {"zh": "我坐起来接住", "en": "I sit up to take it."},
        {"zh": "再给一颗我才跳过去", "en": "One more morsel and I'll hop over."},
        {"zh": "你兜里还藏着虫子吧", "en": "You've got more insects in that pocket, don't you."},
        {"zh": "那我就拿走了", "en": "Then I am taking it."},
        {"zh": "我嚼着，耳朵还在转", "en": "I chew, ears still swiveling."},
        {"zh": "这虫子嚼着有股甜味", "en": "This insect has a sweet taste to it."}
      ]
    },
