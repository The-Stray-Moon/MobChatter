        {"zh": "我在等一只虫子飞过", "en": "I wait for an insect to pass."},
        {"zh": "我这几条腿很细", "en": "These legs of mine are very thin."},
        {"zh": "我擦了一下脸", "en": "I wipe my face."},
        {"zh": "我挂在叶尖上歇着", "en": "I hang resting from a leaf tip."},
        {"zh": "这个季节并不长", "en": "This season does not last long."},
        {"zh": "我慢慢开合翅膀", "en": "I open and close my wings slowly."},
        {"zh": "我在水边休息", "en": "I rest by the water."}
