        {"zh": "你吓不走我的", "en": "You cannot frighten me off."},
        {"zh": "你别伸手拍我", "en": "Do not swat at me."},
        {"zh": "我认得你的气息", "en": "I know your scent."},
        {"zh": "我会飞走，然后回来", "en": "I will fly off, then return."}
