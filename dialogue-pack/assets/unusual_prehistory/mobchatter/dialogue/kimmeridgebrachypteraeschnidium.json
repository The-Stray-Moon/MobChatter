  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我四片翅膀一起动", "en": "All four wings move at once."},
        {"zh": "我飞得很直，很少拐弯", "en": "I fly straight, rarely turning."},
        {"zh": "我的复眼覆盖半个头", "en": "My compound eyes cover half my head."},
        {"zh": "我悬停一下，再冲出去", "en": "I hover, then dart."},
        {"zh": "我的花纹是随机的", "en": "My markings are random."},
        {"zh": "我贴着水面掠过去", "en": "I skim low over the water."},
        {"zh": "我抓住空中的小虫", "en": "I snatch small insects from the air."},
        {"zh": "我的翅膀不需要歇", "en": "My wings need no rest."},
        {"zh": "我沿着河边飞", "en": "I fly along the river."},
        {"zh": "我飞起来几乎没有声音", "en": "My flight is nearly silent."},
        {"zh": "我能在半空停住", "en": "I can stop dead in the air."},
        {"zh": "我的腹部一节一节", "en": "My abdomen is ringed in segments."},
        {"zh": "我拉高，越过芦苇", "en": "I climb over the reeds."},
        {"zh": "我的影子在水里", "en": "My shadow is in the water."},
        {"zh": "我转向时身体先倾", "en": "My body banks before I turn."},
        {"zh": "我朝有虫群的地方去", "en": "I head for the insect swarms."},
        {"zh": "我不落地也能过夜", "en": "I can spend the night airborne."},
        {"zh": "我的翅膀是透明的", "en": "My wings are transparent."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
