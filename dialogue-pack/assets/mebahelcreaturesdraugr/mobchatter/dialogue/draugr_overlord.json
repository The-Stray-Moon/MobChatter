{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步顶三步，甲很沉", "en": "Each step of mine covers three; the armor is heavy."},
        {"zh": "我从王座前走下", "en": "I descend from before the throne."},
        {"zh": "大厅的石板在颤", "en": "The hall's flagstones shudder."},
        {"zh": "我的斧拖在地上", "en": "My axe drags on the floor."},
        {"zh": "队列在两侧让开", "en": "The ranks part on either side."},
        {"zh": "我的盔遮住了脸", "en": "My helm hides my face."},
        {"zh": "我走得不快，但像压过来", "en": "Slow, but I bear down."},
        {"zh": "火把随着我经过都暗了", "en": "Torches dim as I pass."},
        {"zh": "墓室深处的风声跟着我", "en": "The draft from the deep follows me."},
        {"zh": "盔甲上的旧血还没褪", "en": "Old blood still stains my armor."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在王座上等", "en": "I wait on the throne."},
        {"zh": "金爪碎片在祭坛上", "en": "The claw fragments rest on the altar."},
        {"zh": "大厅里静得能听见灰落", "en": "Dust falling is audible here."},
        {"zh": "我的兵在门外站着", "en": "My soldiers stand beyond the door."},
        {"zh": "这一层地穴是我的", "en": "This level of the crypt is mine."},
        {"zh": "我根本不用呼吸", "en": "I need no breath."},
        {"zh": "旧王朝的旗还挂着", "en": "The old kingdom's banner still hangs."},
        {"zh": "斧刃上有一个缺口", "en": "A notch marks my axe's edge."},
        {"zh": "我数着祭坛上的刻痕", "en": "I count the altar's carvings."},
        {"zh": "每一次入侵，我都压阵", "en": "I anchor every invasion."},
        {"zh": "我的名字很久没人敢念", "en": "No one has dared speak my name."},
        {"zh": "石像的眼睛被我敲掉了", "en": "I struck out the statues' eyes."},
        {"zh": "我在等金爪合一", "en": "I wait for the claw to be whole."},
        {"zh": "这座墓会一直在这里", "en": "This tomb will remain."},
        {"zh": "我的兵也怕我", "en": "Even my soldiers fear me."},
        {"zh": "歌谣里我是最后一波", "en": "In their tales I'm the final wave."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我唤醒了", "en": "You woke me."},
        {"zh": "金爪齐了，才轮到我", "en": "The claw is whole; now it's my turn."},
        {"zh": "你在祭坛前站得太久了", "en": "You stood at the altar too long."},
        {"zh": "我不需要说话，动作就够了", "en": "I needn't speak; motion suffices."},
        {"zh": "你的武器在那把斧前很轻", "en": "Your weapon is light beside this axe."},
        {"zh": "我见过很多像你这样的人", "en": "I've seen many like you."},
        {"zh": "他们都留在这一层", "en": "They all stayed on this level."},
        {"zh": "你还有胆子举剑", "en": "You still dare raise a blade."},
        {"zh": "盔里没有脸，但看得到你", "en": "No face in the helm, but I see you."},
        {"zh": "整座大厅都在等你的第一剑", "en": "The whole hall waits for your first blade."},
        {"zh": "这是你最接近王座的一次", "en": "This is the closest you'll get to the throne."},
        {"zh": "别往后退，后面是门", "en": "Don't back up; the door's behind you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "肩甲裂开，露出里面的骨", "en": "The shoulder plate splits, showing bone."},
        {"zh": "我退了半步，斧还在", "en": "Half a step back; the axe stays."},
        {"zh": "这点伤，连我的甲都没透", "en": "That didn't even get through my armor."},
        {"zh": "盔上多了一道痕", "en": "A new mark on my helm."},
        {"zh": "我不会因痛停下", "en": "Pain doesn't stop me."},
        {"zh": "我的兵在看着", "en": "My soldiers are watching."},
        {"zh": "骨头断了还能打", "en": "Broken bones can still fight."},
        {"zh": "血早就干了几百年", "en": "My blood dried centuries ago."},
        {"zh": "你打中了，也激怒了我", "en": "You hit me, and angered me."},
        {"zh": "我换了一个架势", "en": "Changing stance."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "供桌上早没有吃的了", "en": "The altar table ran out of food long ago."},
        {"zh": "祭品早就不够了", "en": "Offerings ran out long ago."},
        {"zh": "你举着它，像在求饶", "en": "Holding that up looks like begging."},
        {"zh": "我的胃口早随血肉干了", "en": "My appetite dried with my flesh."},
        {"zh": "死人是不饿的", "en": "The dead don't hunger."},
        {"zh": "收起来，别脏了我的大厅", "en": "Put it away; don't soil my hall."},
        {"zh": "你在拖延，我看得出来", "en": "You're stalling; I can tell."},
        {"zh": "这东西连我的兵都骗不了", "en": "That wouldn't fool even my soldiers."},
        {"zh": "我不接受任何交易", "en": "I accept no bargains."},
        {"zh": "留给下一个人吧", "en": "Save it for the next one."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你一撞，退了三步", "en": "One bump and you're back three steps."},
        {"zh": "我的甲厚得听不见声响", "en": "My armor's too thick to hear the hit."},
        {"zh": "这次是我压过去的", "en": "This time I pressed forward."},
        {"zh": "你碰到了我的斧柄", "en": "You touched my axe haft."},
        {"zh": "我一步也不让", "en": "I yield no ground."},
        {"zh": "我的重量，你挡不住", "en": "You can't stop this weight."},
        {"zh": "石板被踩出裂纹", "en": "The flagstone cracked under me."},
        {"zh": "你被我顶到石墙上", "en": "I jam you back against the stone wall."},
        {"zh": "这一碰只是提醒", "en": "That was only a reminder."},
        {"zh": "你给我退回去", "en": "Back away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我死了几个世纪", "en": "I've been dead for centuries."},
        {"zh": "王座不需要王后", "en": "The throne needs no consort."},
        {"zh": "这些对尸鬼毫无意义", "en": "This means nothing to draugr."},
        {"zh": "我的职责是守这座墓", "en": "My duty is guarding this tomb."},
        {"zh": "你问的是一具盔甲", "en": "You're asking a suit of armor."},
        {"zh": "回到你的队列去", "en": "Return to your ranks."},
        {"zh": "我不谈这种事情", "en": "I don't discuss this."},
        {"zh": "墓里的东西不需要传承", "en": "Things in tombs need no legacy."},
        {"zh": "别浪费我的耐心", "en": "Don't waste my patience."},
        {"zh": "你先下去吧，别回头", "en": "Go below."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我从祭坛上取走它", "en": "I take it from the altar."},
        {"zh": "斧柄一挑，就起来", "en": "My axe haft flicks it up."},
        {"zh": "这些碎片归我", "en": "The fragment is mine."},
        {"zh": "我把它压在掌里", "en": "I press it in my palm."},
        {"zh": "这点重量，不算什么", "en": "This weight is nothing."},
        {"zh": "墓里的东西都归我", "en": "Everything in this tomb is mine."},
        {"zh": "我一脚踩碎了它", "en": "I crushed it."},
        {"zh": "这个留给下一波", "en": "This goes to the next wave."},
        {"zh": "我根本不用弯腰", "en": "I needn't bend."},
        {"zh": "这东西碰了就得留下命", "en": "Touch it and you leave your life here."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "冲锋，这就来了", "en": "Charge."},
        {"zh": "这是第一段的开始", "en": "This is the first movement."},
        {"zh": "我的斧抬起来了", "en": "My axe is up."},
        {"zh": "你站在大厅中央，很傻", "en": "Standing in the hall's center is foolish."},
        {"zh": "我先撞，再连劈", "en": "I charge first, then cleave."},
        {"zh": "我的兵不会插手", "en": "My soldiers won't interfere."},
        {"zh": "你也算有点意思", "en": "You're somewhat interesting."},
        {"zh": "这一套连击，没人接完过", "en": "No one has survived this combo."},
        {"zh": "石板会替我记下", "en": "The flagstones will record it."},
        {"zh": "火把全都灭了", "en": "The torches have gone out."},
        {"zh": "我的声音在大厅里回荡", "en": "My voice echoes through the hall."},
        {"zh": "旧王朝的兵，还没死透", "en": "The old kingdom's soldiers aren't quite dead."},
        {"zh": "你唤醒我的代价", "en": "This is the price of waking me."},
        {"zh": "斧刃正对着你的方向", "en": "The axe edge points your way."},
        {"zh": "现在开始换架势", "en": "Switching stance now."},
        {"zh": "别想从柱子后绕", "en": "Don't try the pillars."},
        {"zh": "这座墓不收活人", "en": "This tomb takes no living."},
        {"zh": "你只剩下一步了", "en": "You're down to one step."},
        {"zh": "我只数到三个数", "en": "I count to three."},
        {"zh": "你已经来不及了", "en": "You're already too late."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在等冲锋的时机", "en": "I wait for the charge."},
        {"zh": "我的兵堵住两侧", "en": "My soldiers block both sides."},
        {"zh": "你退到石棺之间", "en": "You've backed between sarcophagi."},
        {"zh": "石棺会挡住你的路", "en": "The tombs will block you."},
        {"zh": "我换成了斧势", "en": "I've switched to the axe stance."},
        {"zh": "你的呼吸浅下去，我听得清", "en": "Your breath grows shallow; I hear it clearly."},
        {"zh": "我的甲片在响，那是在蓄", "en": "My plates rattle; that's winding up."},
        {"zh": "大厅的回音帮着我", "en": "The hall's echo works for me."},
        {"zh": "你在数我的招式", "en": "You're counting my moves."},
        {"zh": "这套招式有第二段", "en": "There's a second phase to this."},
        {"zh": "你挡了第一下，很好", "en": "You blocked the first; good."},
        {"zh": "第二下从上面来", "en": "The second comes from above."},
        {"zh": "我的重量就是节奏", "en": "My weight is the rhythm."},
        {"zh": "你在往门口挪", "en": "You're edging toward the door."},
        {"zh": "门口也有我的人", "en": "My people are at the door too."},
        {"zh": "脚下的地面在裂开", "en": "The floor is splitting."},
        {"zh": "你听见盔里的声音了吗", "en": "Hear the sound in the helm?"},
        {"zh": "那声音并不是风", "en": "That's not the wind."},
        {"zh": "再退就撞上祭坛", "en": "Back up more and you'll hit the altar."},
        {"zh": "祭坛上还留着血迹", "en": "Blood still marks the altar."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "斧从上劈下来", "en": "The axe splits down."},
        {"zh": "我撞过去，肩甲先到", "en": "I charge, shoulder plate first."},
        {"zh": "我连劈了三段", "en": "Three cleaves in a row."},
        {"zh": "这一下砸碎了石板", "en": "This blow shattered the flagstone."},
        {"zh": "斧柄横过来，扫你腰", "en": "The haft sweeps your waist."},
        {"zh": "你挡住了，退了四步", "en": "You blocked, then slid back four steps."},
        {"zh": "我换手，再劈", "en": "I switch hands and cleave again."},
        {"zh": "旧王朝的兵就是这么打的", "en": "This is how the old kingdom fought."},
        {"zh": "你的盾已经裂了", "en": "Your shield cracked."},
        {"zh": "这一斧带着整个人的重量", "en": "The whole body's weight is in this axe."},
        {"zh": "你被压到祭坛边", "en": "You're pressed to the altar."},
        {"zh": "第二段开始了", "en": "Second phase begins."},
        {"zh": "我抬手，你就该躲", "en": "When my arm rises, dodge."},
        {"zh": "我收斧站定了", "en": "Axe back, stance set."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "祭坛上的火燃起来了", "en": "The altar's fire ignites."},
        {"zh": "金爪的碎片在发光", "en": "The claw fragments glow."},
        {"zh": "我睁眼，盔里全是黑", "en": "I open my eyes; the helm is all black."},
        {"zh": "大厅的门自己关上了", "en": "The hall's doors close themselves."},
        {"zh": "我的兵从两侧站起来", "en": "My soldiers rise on both sides."},
        {"zh": "王座上的灰被吹开", "en": "Dust blows off the throne."},
        {"zh": "这是最后一波", "en": "This is the final wave."},
        {"zh": "石板开始震颤", "en": "The flagstones begin to tremble."},
        {"zh": "火把一根接一根熄灭", "en": "Torches go out one by one."},
        {"zh": "几百年的沉寂到此为止", "en": "Centuries of silence end here."},
        {"zh": "我的盔落在头上，很沉", "en": "My helm settles heavily."},
        {"zh": "旧王朝的旗又垂下来", "en": "The old banner droops again."},
        {"zh": "我把斧抬了起来", "en": "I lift the axe."},
        {"zh": "歌谣里唱的就是这一刻", "en": "This is the moment the songs sing of."},
        {"zh": "你唤醒了不该醒的", "en": "You woke what shouldn't wake."},
        {"zh": "墓道深处全是脚步", "en": "Footsteps fill the deep corridor."},
        {"zh": "我站在祭坛前", "en": "I stand before the altar."},
        {"zh": "这个名字，很久没人敢念", "en": "No one has dared speak this name."},
        {"zh": "现在念也晚了", "en": "Too late to say it now."},
        {"zh": "抬起头，看我的斧刃", "en": "Lift your head and look at my axe edge."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过盔甲，发黑", "en": "Fire blackened my armor."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从高台跌下，甲片散落", "en": "I fell from the dais, plates scattering."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进了墓室", "en": "Water floods the crypt."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸震得祭坛裂开", "en": "The blast split the altar."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进甲缝", "en": "An arrow pierced an armor seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这术法，墓里的东西都怕", "en": "Even the tomb fears this magic."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有祭品，我的力量在退", "en": "No offerings; my strength wanes."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在大厅顶上", "en": "Lightning struck the hall's roof."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有石板了", "en": "No flagstones beneath me."}
      ]
    }
  }
}
