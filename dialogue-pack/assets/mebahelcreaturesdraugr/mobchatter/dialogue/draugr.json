{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "盾举着，我一步步走", "en": "Shield up, I advance step by step."},
        {"zh": "骨甲在墓道里响", "en": "Bone armor rattles in the crypt."},
        {"zh": "我沿着石阶往上", "en": "I climb the stone steps."},
        {"zh": "地穴里的空气很旧", "en": "The air in the crypt is ancient."},
        {"zh": "我们成队走，脚步整齐", "en": "We march in formation, steps even."},
        {"zh": "我的盾面刻着旧纹", "en": "Old patterns on my shield."},
        {"zh": "剑在盾后，随时能出", "en": "Sword behind the shield, ready."},
        {"zh": "墓道的火把早灭了", "en": "The crypt's torches died long ago."},
        {"zh": "我一步一响，沿着墓道走", "en": "Rattle by rattle, I work down the crypt."},
        {"zh": "脚下的石板松了", "en": "The flagstone underfoot is loose."},
        {"zh": "我们守这些厅堂很久了", "en": "We've held these halls a long while."},
        {"zh": "我不需要呼吸，所以很稳", "en": "No breath, so no wavering."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "盾立在地上，我等着", "en": "Shield on the ground; I wait."},
        {"zh": "骨指扣着剑柄", "en": "Bone fingers on the hilt."},
        {"zh": "这地穴比我想的更安静", "en": "The crypt is quieter than I recall."},
        {"zh": "我在听有没有活人下来", "en": "Listening for the living."},
        {"zh": "墙上的浮雕看不清了", "en": "The carvings are illegible now."},
        {"zh": "我们是主力，站在最前面", "en": "We're the main line; we stand in front."},
        {"zh": "我的盔里没有脸", "en": "There's no face in my helm."},
        {"zh": "队里其他人也在等", "en": "The others wait too."},
        {"zh": "一把剑，一面盾，够了", "en": "One sword, one shield; enough."},
        {"zh": "石棺盖被推开过", "en": "A sarcophagus lid has been pushed aside."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "活人，给我站住", "en": "Living one, halt."},
        {"zh": "你踏进了不该进的地方", "en": "You've entered where you shouldn't."},
        {"zh": "我的盾已经抬起来了", "en": "My shield is already up."},
        {"zh": "你手里的武器，我看见了", "en": "I see the weapon in your hand."},
        {"zh": "我们不接受投降", "en": "We accept no surrender."},
        {"zh": "你是一个人下来的", "en": "You came down alone."},
        {"zh": "这条墓道有进无出", "en": "This passage has no way out."},
        {"zh": "你的呼吸很响", "en": "Your breathing is loud."},
        {"zh": "我的剑在盾后等你先动", "en": "My sword waits behind the shield for your first move."},
        {"zh": "我们比你想的更有组织", "en": "We're more organized than you think."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "骨头被砍出缺口", "en": "A notch cut into my bone."},
        {"zh": "半步，盾面还朝着你", "en": "Half a step, shield still facing you."},
        {"zh": "这一下砍进了骨头里", "en": "That one bit into the bone."},
        {"zh": "我开始摸药瓶", "en": "I start reaching for a potion."},
        {"zh": "我的甲碎了一片", "en": "A plate broke."},
        {"zh": "疼对我不算什么", "en": "Pain means little to me."},
        {"zh": "队里有人补上我的位置", "en": "Someone fills my spot in the line."},
        {"zh": "我举盾重整架势", "en": "I raise my shield and reset my stance."},
        {"zh": "骨缝里渗出黑气", "en": "Black mist seeps from my joints."},
        {"zh": "再来，我的盾还举着", "en": "Again, then. My shield is still up."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我的胃早烂在土里了", "en": "My stomach rotted into the soil long ago."},
        {"zh": "活着的人才需要那个", "en": "The living need that."},
        {"zh": "你举着它，是在拖延", "en": "Holding it up is only stalling."},
        {"zh": "我们不吃，也不喝", "en": "We neither eat nor drink."},
        {"zh": "这东西对死人无用", "en": "Useless to the dead."},
        {"zh": "拿开，我看得心烦", "en": "Put it away; it irks me."},
        {"zh": "你留着吧，很快就用不上", "en": "Keep it; you soon won't need it."},
        {"zh": "我的耐心比这具骨头还薄", "en": "My patience is thinner than these bones."},
        {"zh": "你在数自己的补给吗", "en": "Counting your supplies?"},
        {"zh": "那点东西救不了你", "en": "That won't save you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "盾一顶，你退了两步", "en": "My shield shoves you back two steps."},
        {"zh": "我的甲片很硬", "en": "My armor is hard."},
        {"zh": "我们肩并肩，撞不开", "en": "We stand shoulder to shoulder."},
        {"zh": "你撞上的是盾沿", "en": "You hit the shield's rim."},
        {"zh": "我站得纹丝不动", "en": "I don't budge."},
        {"zh": "让开，我在列队", "en": "Move; I'm forming up."},
        {"zh": "骨头碰铁，很响", "en": "Bone on iron, a loud crack."},
        {"zh": "你被挤到墙边", "en": "You're squeezed to the wall."},
        {"zh": "这一下，你手该麻了", "en": "That should numb your hand."},
        {"zh": "我们不会让出这条道", "en": "We won't yield this corridor."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我死了很久了", "en": "I've been dead a long time."},
        {"zh": "尸鬼不谈这个", "en": "Draugr don't speak of this."},
        {"zh": "我们只需要队列", "en": "We need only formation."},
        {"zh": "这具身体里没有那些", "en": "There's none of that in this body."},
        {"zh": "我早就不算活人了", "en": "I stopped counting as living long ago."},
        {"zh": "守好你的位子", "en": "Hold your position."},
        {"zh": "军团里没有这种事", "en": "There's no such thing in the legion."},
        {"zh": "我的职责是站在这", "en": "My duty is standing here."},
        {"zh": "别让我为这事分神", "en": "Don't distract me."},
        {"zh": "回到你的岗位", "en": "Return to your post."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有一样东西", "en": "Something on the ground."},
        {"zh": "我蹲下去，肋骨咔了一下", "en": "I crouch, and a rib clicks."},
        {"zh": "那瓶药剂归我", "en": "The potion is mine."},
        {"zh": "我收在腰间的袋里", "en": "Tucked in my belt pouch."},
        {"zh": "这点东西，我留着备伤", "en": "Kept for when I'm wounded."},
        {"zh": "骨头里没有味觉", "en": "These bones have no taste."},
        {"zh": "一脚下去，脆的一下就散", "en": "One stamp and the brittle thing scatters."},
        {"zh": "用剑尖挑起来", "en": "I flick it up with the sword tip."},
        {"zh": "墓里的东西，都归我们", "en": "What's in the crypt is ours."},
        {"zh": "别抢，队列里要分", "en": "Don't grab; we share in the line."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "全都把盾举起来", "en": "Shields up."},
        {"zh": "列阵，往前压", "en": "Form up, press forward."},
        {"zh": "你已经被包围了", "en": "You're surrounded."},
        {"zh": "我们三个对付你一个", "en": "Three of us to one of you."},
        {"zh": "先封住你的退路", "en": "Cut off your retreat first."},
        {"zh": "你的武器挡不住盾", "en": "Your weapon won't pass this shield."},
        {"zh": "我会挡下你的第一击", "en": "I'll block your first strike."},
        {"zh": "喊一声，全队就到", "en": "One shout and the squad comes."},
        {"zh": "我们是有阵型的", "en": "We have a formation."},
        {"zh": "你不会活着走出这条道", "en": "You won't leave this corridor alive."},
        {"zh": "石壁都在回响", "en": "The stone walls echo."},
        {"zh": "我的剑已经出了半寸", "en": "My sword is half-drawn."},
        {"zh": "别想着从侧面绕", "en": "Don't try the flank."},
        {"zh": "侧翼同样有人", "en": "The flank is covered too."},
        {"zh": "药剂已经带够了", "en": "We brought enough potions."},
        {"zh": "你的呼吸已经乱了拍子", "en": "Your breathing has lost its rhythm."},
        {"zh": "开始向前推进", "en": "Advance."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步逼近，盾在前", "en": "I close in, shield forward."},
        {"zh": "你的每一击我都挡", "en": "I'll block every strike."},
        {"zh": "队伍从两边合拢", "en": "The squad closes from both sides."},
        {"zh": "墓道很窄，你施展不开", "en": "The corridor is narrow; you can't move."},
        {"zh": "我的剑在盾后等", "en": "My sword waits behind the shield."},
        {"zh": "你退到石棺边了", "en": "You're at the sarcophagus."},
        {"zh": "石棺里有我们的同伴", "en": "Our kin are in those tombs."},
        {"zh": "血滴在石板上很响", "en": "Blood on flagstones is loud."},
        {"zh": "听见石板上的脚步了吗", "en": "Do you hear those steps on the flagstones?"},
        {"zh": "那不是一个人", "en": "That's more than one."},
        {"zh": "我等着你握盾的手松开", "en": "I wait for your shield hand to loosen."},
        {"zh": "你的手在抖，盾会歪", "en": "Your hands shake; the shield will tilt."},
        {"zh": "火把的光照着你", "en": "Torchlight finds you."},
        {"zh": "你的影子在墙上很长", "en": "Your shadow is long on the wall."},
        {"zh": "再退一步，石壁就抵住你了", "en": "One more step back and the wall has you."},
        {"zh": "墙后是实心的石", "en": "Solid stone behind it."},
        {"zh": "我们不怕死，我们就是死的", "en": "We don't fear death; we are dead."},
        {"zh": "药剂还在我腰上", "en": "The potion's still at my belt."},
        {"zh": "你再撑几下就没力气了", "en": "A few more blocks and you're spent."},
        {"zh": "队列不会散乱", "en": "The line holds."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "剑从盾后刺出", "en": "The sword stabs out from behind the shield."},
        {"zh": "盾面撞你的脸", "en": "My shield slams your face."},
        {"zh": "我劈下去，骨头都在响", "en": "I chop down; bones rattle."},
        {"zh": "这一剑很短，但很准", "en": "A short thrust, precisely aimed."},
        {"zh": "你挡了盾，剑就来了", "en": "You block the shield, and the sword comes."},
        {"zh": "我们轮着压上去", "en": "We take turns pressing you."},
        {"zh": "剑刃缺了几处，照样砍", "en": "The blade's nicked; it still cuts."},
        {"zh": "你被逼退到台阶上", "en": "You're driven onto the steps."},
        {"zh": "我举盾挡你的回击", "en": "I raise the shield against your counter."},
        {"zh": "再给你补上一剑", "en": "One more thrust."},
        {"zh": "骨手的力气比看着大", "en": "These bone arms hit harder than they look."},
        {"zh": "你听见队列的脚步声吗", "en": "Hear the squad's steps?"},
        {"zh": "你的护甲挡不住两下", "en": "Your armor won't take two."},
        {"zh": "我们不会单独出手", "en": "We don't strike alone."},
        {"zh": "石板上全是血", "en": "Blood all over the flagstones."},
        {"zh": "我退回到队列里", "en": "Back to the line."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "石棺盖被推开", "en": "A sarcophagus lid slides open."},
        {"zh": "我从墓道里站起来", "en": "I rise in the corridor."},
        {"zh": "骨甲一块块归位", "en": "Bone plates settle into place."},
        {"zh": "队里其他人也醒了", "en": "The others wake too."},
        {"zh": "火把一下全灭了", "en": "The torches all go out."},
        {"zh": "这里的地穴归我们守", "en": "We hold this crypt."},
        {"zh": "我的盾先立起来", "en": "My shield comes up first."},
        {"zh": "旧王朝的兵，还站着", "en": "The old kingdom's soldiers still stand."},
        {"zh": "脚步声从深处传来", "en": "Footsteps come from deeper in."},
        {"zh": "我们已经等了很久", "en": "We've waited a long time."},
        {"zh": "队列重新排好", "en": "The formation reforms."},
        {"zh": "石门在我们身后落下", "en": "The stone door falls behind us."},
        {"zh": "骨头摩擦的声音很刺耳", "en": "The grinding of bone is harsh."},
        {"zh": "又有活人来了", "en": "More living have come."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过甲片，发黑", "en": "Fire scorched the plates black."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下台阶，骨头散了几块", "en": "I fell down the steps and bones scattered."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进了头盔里", "en": "Water fills my helm."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把队列炸散了", "en": "The blast broke our formation."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭卡在我的肋骨间", "en": "An arrow lodged between my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这术法和地穴里的不一样", "en": "This magic isn't from the crypt."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有祭品补给，我在变弱", "en": "No offerings; I weaken."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着铁甲走遍全身", "en": "Lightning ran down the iron armor."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有石阶了", "en": "No stone steps beneath me."}
      ]
    }
  }
}
