{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的须在水里飘", "en": "My whiskers drift in the water."},
        {"zh": "贴着泥底慢慢挪", "en": "I ease along the muddy bottom."},
        {"zh": "胡须一直探着地面", "en": "My barbels feel the ground."},
        {"zh": "我不用眼睛找东西", "en": "I don't need eyes to find things."},
        {"zh": "浑浊的水里正合适", "en": "Muddy water suits me."},
        {"zh": "尾巴摆得很轻", "en": "My tail sweeps lightly."},
        {"zh": "不让泥扬起来", "en": "So I don't stir the mud."},
        {"zh": "我从石头底下钻过去", "en": "I slip under a stone."},
        {"zh": "那里的水很凉", "en": "The water's cool there."},
        {"zh": "我停了一下下", "en": "I pause."},
        {"zh": "然后继续往上游", "en": "Then work upstream."},
        {"zh": "前面的河道变窄", "en": "The channel narrows."},
        {"zh": "我侧过身挤过去", "en": "I turn sideways to squeeze through."},
        {"zh": "左边的须碰到了东西", "en": "My left barbel touches something."},
        {"zh": "我朝那头转过去", "en": "I turn toward it."},
        {"zh": "原来是一块骨头", "en": "A bone."},
        {"zh": "这块骨头，我绕开就是。", "en": "A bone. I simply go around it."},
        {"zh": "那我就继续走", "en": "Moving on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "伏在泥上，一动不动", "en": "Lying on the mud, perfectly still."},
        {"zh": "须在水里慢慢飘", "en": "My barbels float slowly."},
        {"zh": "我身上的皮很滑", "en": "My skin is slick."},
        {"zh": "上面有暗色的斑", "en": "Dark blotches across it."},
        {"zh": "我在泥里慢慢鼓鳃。", "en": "In the mud my gills work slowly."},
        {"zh": "有东西从上面游过", "en": "Something swims overhead."},
        {"zh": "河底那条大胡子鱼，就是我。", "en": "I am the big-whiskered fish on the riverbed."},
        {"zh": "后来它就走了", "en": "It passes."},
        {"zh": "我才动了一下", "en": "Only then do I shift."},
        {"zh": "泥被我按出一个窝", "en": "I leave a hollow in the mud."},
        {"zh": "我又趴了回去", "en": "And settle back in."},
        {"zh": "桶上写着我的学名。", "en": "My Latin name is on the bucket."},
        {"zh": "水草垂在我身上", "en": "Weeds hang over me."},
        {"zh": "像一层被子盖着", "en": "Like a blanket over me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从水底看你", "en": "I watch you from the bottom."},
        {"zh": "你站在齐膝的水里", "en": "You're standing knee-deep."},
        {"zh": "我的须朝你的方向", "en": "My barbels point your way."},
        {"zh": "你趟水的响动，我听着。", "en": "I hear the splash of your wading."},
        {"zh": "不用看也知道", "en": "Without looking."},
        {"zh": "我慢慢地浮上去", "en": "I rise slowly."},
        {"zh": "只露出一个嘴", "en": "Only my mouth breaks surface."},
        {"zh": "我吸了一大口气", "en": "I take a gulp of air."},
        {"zh": "随后又沉了下去", "en": "Then sinks again."},
        {"zh": "你居然还在那", "en": "You're still there."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我往泥里钻去", "en": "I burrow into the mud."},
        {"zh": "泥把伤口盖住了", "en": "The mud covers the wound."},
        {"zh": "血丝在水里散开", "en": "Threads of blood spread in the water."},
        {"zh": "我贴着底不动", "en": "I lie still on the bottom."},
        {"zh": "我的须在发抖", "en": "My barbels tremble."},
        {"zh": "我慢慢平复下来", "en": "I settle slowly."},
        {"zh": "这里倒也安全", "en": "It's safe here."},
        {"zh": "我等一会再走", "en": "I'll move later."},
        {"zh": "我等着也不亏", "en": "Waiting costs me nothing."},
        {"zh": "泥底的时间很慢", "en": "Time runs slow on the bottom."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水底有一股腐味", "en": "A smell of rot on the bottom."},
        {"zh": "水底那股腐味，我认得。", "en": "That rot smell on the bottom — I know it."},
        {"zh": "须先探了过去", "en": "The barbels reach first."},
        {"zh": "碰到了，是软的", "en": "They touch it. Soft."},
        {"zh": "我一口吸进肚", "en": "I suck it in whole."},
        {"zh": "连泥一起吞下", "en": "Mud and all."},
        {"zh": "我把水滤了滤", "en": "I strain it."},
        {"zh": "嘴里剩下一点", "en": "A little stays in my mouth."},
        {"zh": "这腐味比泥好闻。", "en": "This rot smells better than mud."},
        {"zh": "我接着往下找", "en": "I keep searching."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "水一下子搅浑", "en": "The water goes cloudy."},
        {"zh": "我仍旧待在原处", "en": "I stay right where I am."},
        {"zh": "一直等你走开", "en": "Waiting for you to move."},
        {"zh": "你踩到了我的须", "en": "You stepped on my barbel."},
        {"zh": "我用力甩了甩", "en": "I whip it free."},
        {"zh": "然后退了半尺", "en": "And back off half a foot."},
        {"zh": "我不想挨着人", "en": "I don't like being close to people."},
        {"zh": "别踩我的须，绕开走。", "en": "Don't tread on my barbels. Go around."},
        {"zh": "我回泥里去待着", "en": "I'll go back to the mud."},
        {"zh": "那里才是我的地方", "en": "That's where I belong."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个季节水会变暖", "en": "The water warms this season."},
        {"zh": "那时候我们会靠得很近", "en": "Then we come very close."},
        {"zh": "须碰着另一根须", "en": "Barbel against barbel."},
        {"zh": "然后各走各的", "en": "Then each goes its own way."},
        {"zh": "卵会沉到石头底下", "en": "Eggs sink beneath the stones."},
        {"zh": "很多，聚成一团", "en": "Many, in clusters."},
        {"zh": "我们也不去理", "en": "We don't bother."},
        {"zh": "它们自己会长", "en": "They grow on their own."},
        {"zh": "我继续趴在泥上", "en": "I go back to lying in the mud."},
        {"zh": "等着它们自己长大", "en": "Waiting for them to grow."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "须先碰到了它", "en": "My barbels find it first."},
        {"zh": "我朝那边转过来", "en": "I turn toward it."},
        {"zh": "一口就吸进去", "en": "One gulp draws it in."},
        {"zh": "咬不动，我吐了一口泥。", "en": "It won't give. I spit out mud."},
        {"zh": "硬的吞不下，我丢了。", "en": "Too hard to swallow, so I drop it."},
        {"zh": "这压根不是食物", "en": "This isn't food at all."},
        {"zh": "我又吸了一次", "en": "I try once more."},
        {"zh": "结果还是不行", "en": "Still no."},
        {"zh": "那就不管了吧", "en": "Never mind."},
        {"zh": "我又趴回泥里", "en": "I settle back into the mud."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水底的水在动", "en": "The water's moving."},
        {"zh": "须全部转向那边", "en": "All my barbels turn that way."},
        {"zh": "我从泥里抬起来", "en": "I lift off the mud."},
        {"zh": "身体贴着底滑过去", "en": "I slide along the bottom."},
        {"zh": "不弄出一点声音", "en": "Without a sound."},
        {"zh": "你在水里站着", "en": "You're standing in the water."},
        {"zh": "水波把你露出来", "en": "Your ripples give you away."},
        {"zh": "泥里一动，我就知道你。", "en": "One stir in the mud and I know you."},
        {"zh": "我会从下面来", "en": "I come from below."},
        {"zh": "这一口绝不撒嘴", "en": "I won't let this grip go."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你的腿", "en": "I circle your legs."},
        {"zh": "须先碰到了一次", "en": "A barbel touches once."},
        {"zh": "然后再碰一次", "en": "Then again."},
        {"zh": "我在试你的反应", "en": "I'm testing your reaction."},
        {"zh": "你朝我踢了一下", "en": "You kick."},
        {"zh": "我一下躲开了", "en": "I dodge."},
        {"zh": "然后它又回来", "en": "Then return."},
        {"zh": "水底的泥给了我掩护", "en": "The bottom mud hides me."},
        {"zh": "我从另一边来", "en": "I come from the other side."},
        {"zh": "你根本没看到", "en": "You didn't see."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬住你的脚踝", "en": "I clamp your ankle."},
        {"zh": "然后往泥里沉", "en": "And sink toward the mud."},
        {"zh": "你被拽得弯下腰", "en": "The pull bends you down."},
        {"zh": "水花一下溅起来", "en": "Water splashes up."},
        {"zh": "你用力甩开了我", "en": "You shake me off."},
        {"zh": "我落到泥底上", "en": "I drop to the bottom."},
        {"zh": "我翻着滚了一下", "en": "Rolling once."},
        {"zh": "然后重新看方向", "en": "Then find my heading."},
        {"zh": "这里是我熟的地方", "en": "This is ground I know."},
        {"zh": "我还待在原地", "en": "I'm still here."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "泥底扬起一小片", "en": "A little mud lifts off the bottom."},
        {"zh": "我从里面出来", "en": "I come out of it."},
        {"zh": "须先探了出去", "en": "The barbels go first."},
        {"zh": "水很浑，正好", "en": "Murky water. Perfect."},
        {"zh": "这里应该有吃的", "en": "There should be food here."},
        {"zh": "我沿着河底走", "en": "I work along the bed."},
        {"zh": "找到一块石头", "en": "I find a stone."},
        {"zh": "石头底下有东西", "en": "Something beneath it."},
        {"zh": "我把石头顶开", "en": "I nose the stone aside."},
        {"zh": "翻开里面是空的", "en": "Hollow beneath."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水烫起来，我往下钻", "en": "The water heats. I burrow down."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在泥上，滑开了", "en": "I hit the mud and slide."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里没气，我得上去", "en": "No air down here. I must go up."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "泥被震得翻起来", "en": "The mud is blasted upward."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "鲇鱼的背被扎了一下。", "en": "Something pricked my catfish back."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "水突然不流了", "en": "The water suddenly stops moving."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得连泥都不够了", "en": "Hungry enough that mud won't do."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷电落水，我一动不动", "en": "Lightning hit the water and I couldn't move."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "泥底忽然没有了", "en": "The muddy bottom is gone."}
      ]
    }
  }
}
