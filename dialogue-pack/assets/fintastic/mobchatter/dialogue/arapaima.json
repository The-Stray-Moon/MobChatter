{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢转身，鳞片泛红", "en": "I turn slowly, my scales flushing red."},
        {"zh": "巨大的身体推开浮草", "en": "My bulk pushes the floating weeds apart."},
        {"zh": "尾鳍一拍就是很远", "en": "One tailbeat carries me far."},
        {"zh": "我在竹影下的水里游", "en": "I swim beneath bamboo shadows."},
        {"zh": "头顶要浮上来换气", "en": "I must surface now and then for air."},
        {"zh": "水面破开一个小圈", "en": "The surface opens in a small ring."},
        {"zh": "我的大身子推开浮草，往下沉。", "en": "My big body pushes the duckweed aside and sinks."},
        {"zh": "这里的河很浑", "en": "This river is murky."},
        {"zh": "我看不清远处", "en": "I can't see far."},
        {"zh": "但我知道哪里深", "en": "But I know where it's deep."},
        {"zh": "我沿着老路走", "en": "I follow an old route."},
        {"zh": "河床的石我认得", "en": "I know the stones of this bed."},
        {"zh": "有东西在岸边走", "en": "Something walks on the bank."},
        {"zh": "我一点不理会", "en": "I pay it no mind."},
        {"zh": "我朝水草更密的地方去", "en": "I head for thicker weeds."},
        {"zh": "那边要凉一些", "en": "It's cooler there."},
        {"zh": "我从一片竹根底下穿过", "en": "I slip beneath a bamboo root cluster."},
        {"zh": "根须擦过我的背", "en": "The roots brush my back."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "悬在水草旁边", "en": "Hanging beside the weeds."},
        {"zh": "鳞上一层暗红色的光", "en": "A dull red sheen on my scales."},
        {"zh": "我的头很硬，像块骨", "en": "My head is hard as bone."},
        {"zh": "鳃盖慢慢张合", "en": "My gill covers open and close."},
        {"zh": "水面的光在晃", "en": "Light wavers on the surface."},
        {"zh": "我把头沉得更低", "en": "I settle my head lower."},
        {"zh": "有鱼从我旁边游开", "en": "A fish swims away from me."},
        {"zh": "它们总是先让开", "en": "They always give way."},
        {"zh": "这段河道，我守了整季。", "en": "I've kept this stretch of river all season."},
        {"zh": "一点都不急着走", "en": "In no hurry to leave."},
        {"zh": "水慢慢变凉了", "en": "The water's cooling."},
        {"zh": "我抬起身子，看看水面。", "en": "I lift myself to look at the surface."},
        {"zh": "竹叶落在水面上", "en": "Bamboo leaves fall on the surface."},
        {"zh": "有一片沉到我旁边", "en": "One sinks beside me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水底望着你", "en": "I watch you from below."},
        {"zh": "你站在竹林边", "en": "You stand at the bamboo's edge."},
        {"zh": "我浮上来一点", "en": "I surface a little."},
        {"zh": "背上的水，一层层流下去。", "en": "Water runs down my back in layers."},
        {"zh": "你又退了半步", "en": "You step back."},
        {"zh": "我又沉了回去", "en": "I sink back down."},
        {"zh": "这样对谁都好", "en": "Better for us both."},
        {"zh": "你看不清我有多大", "en": "You can't tell how big I am."},
        {"zh": "那倒算是好事", "en": "That's good."},
        {"zh": "我又浮了一眼", "en": "I surface once more."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "河底被我搅浑了", "en": "The riverbed muddies around me."},
        {"zh": "我一直退了很远", "en": "I retreat a long way."},
        {"zh": "鳞上有一道口子", "en": "A cut across my scales."},
        {"zh": "我的鳞裂了，血混进泥水。", "en": "My scales split and blood mixes with silt."},
        {"zh": "我沉到最底下", "en": "I sink to the very bottom."},
        {"zh": "贴着泥一动不动", "en": "Lying still against the mud."},
        {"zh": "等水自己静下来", "en": "Waiting for the water to settle."},
        {"zh": "就这样过了很久", "en": "A long while."},
        {"zh": "我才敢动一下", "en": "Before I dare move."},
        {"zh": "丛林的水里，我长得很长。", "en": "In jungle water, I grow long."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水上有东西落下来", "en": "Something drops onto the water."},
        {"zh": "我慢慢升上去", "en": "I rise slowly."},
        {"zh": "我得先看一眼", "en": "One look first."},
        {"zh": "不是常吃的东西", "en": "Not my usual food."},
        {"zh": "可是我已经饿了", "en": "But I'm hungry."},
        {"zh": "我的舌头上有牙，别伸手。", "en": "Teeth on my tongue; keep your hand out."},
        {"zh": "水一起被吸进去", "en": "Water rushes in."},
        {"zh": "东西跟着进了嘴", "en": "And the thing with it."},
        {"zh": "我缓缓闭上嘴", "en": "I shut my mouth slowly."},
        {"zh": "等着第二份落下来", "en": "Waiting for a second helping."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩进水里撞到我", "en": "You stepped into the water and hit me."},
        {"zh": "我差不多没动", "en": "I've hardly moved."},
        {"zh": "我的身体比你想的重", "en": "I'm heavier than you think."},
        {"zh": "水被你搅起来了", "en": "You've stirred up the water."},
        {"zh": "我往深处退去", "en": "I retreat to deeper water."},
        {"zh": "视线一下断了", "en": "Sight breaks off there."},
        {"zh": "我打了半圈转", "en": "I make a half turn."},
        {"zh": "然后又回来看你", "en": "And come back to look."},
        {"zh": "你居然还在岸边", "en": "You're still on the bank."},
        {"zh": "这样倒也合适", "en": "That suits me fine."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在这段河里", "en": "We share this stretch of river."},
        {"zh": "她的鳞色更暗些", "en": "Her scales run darker."},
        {"zh": "两副硬头在水草里相碰。", "en": "Two hard heads meet among the weeds."},
        {"zh": "河水从我们中间穿过去", "en": "The river passes between us."},
        {"zh": "她在水里比我灵巧", "en": "She's nimbler in the water than I am."},
        {"zh": "我贴在她尾后，慢慢游。", "en": "I swim slowly at her tail."},
        {"zh": "那里的水更暖", "en": "The water's warmer there."},
        {"zh": "我们会在那里待一阵", "en": "We'll stay a while."},
        {"zh": "水草会蔽住我们", "en": "The weeds will hide us."},
        {"zh": "这样我倒也满意", "en": "That satisfies me too."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我张嘴吸进来", "en": "I draw it in."},
        {"zh": "水也跟着进去", "en": "Water goes with it."},
        {"zh": "我把水滤了一下", "en": "I strain it."},
        {"zh": "剩下了一点点渣", "en": "A little residue left."},
        {"zh": "我用嘴一吸，连螺带泥。", "en": "One gulp takes snail and mud."},
        {"zh": "我张嘴吸进来，水也跟着进去。", "en": "I open my mouth and water comes in with it."},
        {"zh": "我再沿河底找", "en": "I search the riverbed again."},
        {"zh": "底下有好些螺蛳", "en": "Snails."},
        {"zh": "咬起来有声音", "en": "They crunch."},
        {"zh": "比刚才那点好", "en": "Better than that last bit."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面下有动静", "en": "A disturbance in the water."},
        {"zh": "我慢慢把头掉过来", "en": "I turn around."},
        {"zh": "身体转得很慢", "en": "My body turns slowly."},
        {"zh": "但方向已经对了", "en": "But the heading is right."},
        {"zh": "我朝那边推水", "en": "I push water that way."},
        {"zh": "河底的泥被带起来", "en": "Silt lifts off the bed."},
        {"zh": "你在岸上看不见我", "en": "You can't see me from up there."},
        {"zh": "等我把头探出水面", "en": "Until I lift my head from the surface."},
        {"zh": "那时候就晚了", "en": "By then it's too late."},
        {"zh": "我先试咬一口", "en": "I try a first bite."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着河底过去", "en": "I move along the riverbed."},
        {"zh": "身体几乎擦着泥", "en": "My body almost scrapes the mud."},
        {"zh": "只在换气时上来", "en": "I only rise to breathe."},
        {"zh": "一次很短的呼吸", "en": "One very short breath."},
        {"zh": "跟着又沉下去了", "en": "Then down once more."},
        {"zh": "你在岸上数我的次数", "en": "You're counting my surfacings."},
        {"zh": "你根本数不清", "en": "You won't keep up."},
        {"zh": "我换气没有规律", "en": "My breathing has no pattern."},
        {"zh": "这片水深正好", "en": "The depth here is right."},
        {"zh": "我一冲就到了", "en": "One rush and I'm there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用硬头撞过去", "en": "I drive my hard head forward."},
        {"zh": "骨头似的撞在你腿上", "en": "It strikes your leg like bone."},
        {"zh": "丛林水里的大个子，装得进桶。", "en": "A big jungle fish, and it fits in a bucket."},
        {"zh": "水花盖住了你", "en": "A sheet of water covers you."},
        {"zh": "我咬住你的裤脚，丛林的水很浅。", "en": "I bite your trouser leg; the jungle water is shallow."},
        {"zh": "然后往水里拽", "en": "And haul toward the water."},
        {"zh": "你抓住了岸边的草", "en": "You grab the bank grass."},
        {"zh": "可我没能拽动", "en": "I can't pull you in."},
        {"zh": "我只好松了口", "en": "I let go."},
        {"zh": "我游回深水中", "en": "I slip back into the deep."}
      ]
    },
    "spawn": {
