{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我逆着河水往上冲。", "en": "I push upstream against the river."},
        {"zh": "水流撞在我身上。", "en": "The current breaks against me."},
        {"zh": "我摆尾，一下一下。", "en": "My tail beats, stroke after stroke."},
        {"zh": "我跳过一块浅石。", "en": "I clear a shallow stone."},
        {"zh": "我沿着河底的石头走。", "en": "I follow the stones along the riverbed."},
        {"zh": "我拐进冷一点的支流。", "en": "I turn into the colder branch."},
        {"zh": "我甩头，稳住方向。", "en": "I snap my head to hold my line."},
        {"zh": "我开始加快。", "en": "I begin to speed up."},
        {"zh": "我从水面跃起。", "en": "I break the surface."},
        {"zh": "我贴着岸边的阴影。", "en": "I keep to the shade along the bank."},
        {"zh": "河底的沙往下滚。", "en": "Sand rolls along the bottom."},
        {"zh": "我又回到深水。", "en": "I am back in deeper water."},
        {"zh": "我摆正身子。", "en": "I straighten my body."},
        {"zh": "我摆尾穿过密水草。", "en": "I beat my tail through the thick weeds."},
        {"zh": "我用力往前游。", "en": "I swim forward hard."},
        {"zh": "我慢下来，喘一喘。", "en": "I slow and rest a moment."},
        {"zh": "水流把我推后一点。", "en": "The current pushes me back a little."},
        {"zh": "我又开始冲。", "en": "I press on again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在水流里。", "en": "I hold in the current."},
        {"zh": "我张着嘴，让水过。", "en": "My mouth is open, letting water through."},
        {"zh": "身上有银色的斑。", "en": "There are silver spots on me."},
        {"zh": "我悬在石缝旁。", "en": "I hover beside a crevice."},
        {"zh": "河水非常凉。", "en": "The river is very cold."},
        {"zh": "我慢慢摆着鳍。", "en": "I work my fins slowly."},
        {"zh": "上游还有很远。", "en": "Upstream is still far."},
        {"zh": "我用尾巴撑住。", "en": "I brace with my tail."},
        {"zh": "这里的水很急。", "en": "The water is swift here."},
        {"zh": "我侧过身子停住。", "en": "I paused, turned sideways."},
        {"zh": "同伴都在附近。", "en": "My kind are nearby."},
        {"zh": "我看着水面。", "en": "I watch the surface."},
        {"zh": "我休息一会儿。", "en": "I rest a while."},
        {"zh": "河水一直在流。", "en": "The river never stops."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在河里。", "en": "You are standing in the river."},
        {"zh": "水流绕过你的腿。", "en": "The current goes around your legs."},
        {"zh": "我停在你上游。", "en": "I hold upstream of you."},
        {"zh": "你的靴子踩得河底发闷。", "en": "Your boots thud against the riverbed."},
        {"zh": "我比你短很多。", "en": "I am much shorter than you."},
        {"zh": "我认得你的影子。", "en": "I know your shadow."},
        {"zh": "我慢慢摆尾。", "en": "I flick my tail slowly."},
        {"zh": "手别探进这冷水里。", "en": "Keep your hand out of this cold water."},
        {"zh": "河水会带我走。", "en": "The river will carry me off."},
        {"zh": "我就停在上游看你。", "en": "I stay upstream and watch you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我窜开一截。", "en": "I shot off a stretch."},
        {"zh": "河水被我搅浊。", "en": "I muddied the river."},
        {"zh": "背上鳞片翻了。", "en": "Scales lifted along my back."},
        {"zh": "我在水里滚了半圈。", "en": "I rolled half a turn in the water."},
        {"zh": "河里漂着血丝。", "en": "Blood threads in the river."},
        {"zh": "我还能逆流。", "en": "I can still swim upstream."},
        {"zh": "我缩到河石背面。", "en": "I tuck behind the river stone."},
        {"zh": "这一下疼得钻心。", "en": "That hurt right to the bone."},
        {"zh": "流速帮我一点。", "en": "The current helps me a little."},
        {"zh": "不要再追了。", "en": "Stop chasing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里飘着细小的碎渣。", "en": "Fine crumbs drift in the water."},
        {"zh": "我顺水过去。", "en": "I drift over with the current."},
        {"zh": "这点不太够。", "en": "This is not quite enough."},
        {"zh": "同伴也在抢。", "en": "The others are going for it too."},
        {"zh": "味道淡得像水。", "en": "It tastes thin as water."},
        {"zh": "别扔在上游。", "en": "Do not throw it upstream."},
        {"zh": "我张嘴叼住它。", "en": "I open my mouth and take it."},
        {"zh": "它被流水卷到下游。", "en": "The current sweeps it downstream."},
        {"zh": "还剩一点吗。", "en": "Is there any left."},
        {"zh": "我逆着水退开。", "en": "I back away against the current."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得横过身去。", "en": "The blow turns me broadside."},
        {"zh": "水流把我推开。", "en": "The current shoved me aside."},
        {"zh": "我立刻摆正。", "en": "I right myself at once."},
        {"zh": "你靴子太硬。", "en": "Your boots are too hard."},
        {"zh": "浪花打湿了岸边的草。", "en": "Spray wets the grass on the bank."},
        {"zh": "我绕到石头后。", "en": "I go behind the stone."},
        {"zh": "我甩尾稳住。", "en": "I steady with my tail."},
        {"zh": "这一撞还撑得住。", "en": "I can take this knock."},
        {"zh": "我又往上冲。", "en": "I push upstream again."},
        {"zh": "把水道让开。", "en": "Clear the channel."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们往上游去。", "en": "We head upstream."},
        {"zh": "跟紧我的尾巴，别散。", "en": "Stay on my tail. Do not scatter."},
        {"zh": "一起冲这段急流。", "en": "Let us push through this rapid together."},
        {"zh": "石头边能歇。", "en": "We can rest by the stone."},
        {"zh": "水冷，但我们不怕。", "en": "The water is cold, but we do not mind."},
        {"zh": "不必赶时间。", "en": "No need to hurry."},
        {"zh": "不要停太久。", "en": "Do not rest too long."},
        {"zh": "一起摆动尾巴。", "en": "Beat our tails together."},
        {"zh": "再往上游去。", "en": "Farther upstream."},
        {"zh": "顺着水走吧。", "en": "Let us go with the water."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口吞下。", "en": "I swallow it whole."},
        {"zh": "它硬得我咬不动。", "en": "It is too hard for me to bite."},
        {"zh": "我把它甩出去。", "en": "I fling it back out."},
        {"zh": "它从嘴里滑落，沉底。", "en": "It slips from my mouth and sinks."},
        {"zh": "我追上去咬。", "en": "I chase and bite."},
        {"zh": "这不能算食。", "en": "This does not count as food."},
        {"zh": "压得我下沉。", "en": "It weighs me down."},
        {"zh": "我含着它走。", "en": "I carry it in my mouth."},
        {"zh": "味道很寻常。", "en": "The taste is very ordinary."},
        {"zh": "我回到水流里。", "en": "I return to the current."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "上游有影子。", "en": "A shadow upstream."},
        {"zh": "我把身子侧对你。", "en": "I turn my flank to face you."},
        {"zh": "水流把味道送来。", "en": "The current brings the smell."},
        {"zh": "那道影子比我长。", "en": "That shape is longer than I am."},
        {"zh": "我伏低到河石旁。", "en": "I sink low beside a river stone."},
        {"zh": "同伴都停住了。", "en": "The others have stopped."},
        {"zh": "上游的水味不对。", "en": "The water upstream tastes wrong."},
        {"zh": "我准备冲过去。", "en": "I am ready to bolt."},
        {"zh": "它已经近了。", "en": "It is close now."},
        {"zh": "我伏到河石旁边。", "en": "I sink beside a river stone."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我眼睛锁着那道影。", "en": "My eyes are locked on that shape."},
        {"zh": "我在水流里绕。", "en": "I circle in the current."},
        {"zh": "那道影没散。", "en": "That shape has not dispersed."},
        {"zh": "我贴着河底。", "en": "I stay on the riverbed."},
        {"zh": "同伴都散走了。", "en": "The shoal scattered."},
        {"zh": "你再靠近，我就窜。", "en": "Come closer and I bolt."},
        {"zh": "水流在我这边。", "en": "The current favours me."},
        {"zh": "我换了位置。", "en": "I changed position."},
        {"zh": "它顺流逼近。", "en": "It is closing in downstream."},
        {"zh": "我蓄好了力。", "en": "I have my strength gathered."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我侧面撞过去。", "en": "I ram with my flank."},
        {"zh": "我尾巴横扫水流。", "en": "My tail sweeps across the current."},
        {"zh": "这点力气不大。", "en": "That is not much force."},
        {"zh": "我咬不住它。", "en": "I cannot bite it."},
        {"zh": "水花炸开了。", "en": "The splash bursts."},
        {"zh": "我转身就往下游。", "en": "I turn and head downstream."},
        {"zh": "不要跟上来。", "en": "Do not follow me."},
        {"zh": "我一头扎进石缝里。", "en": "I dive headfirst into the rock gap."},
        {"zh": "我根本打不过。", "en": "I cannot win this."},
        {"zh": "我仍是活的。", "en": "I am still alive."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "河里多了一道银光。", "en": "A streak of silver in the river."},
        {"zh": "我逆着水流上来。", "en": "I come up against the current."},
        {"zh": "河面裂开一道水纹。", "en": "A line of ripples splits the river's surface."},
        {"zh": "几条一起冲上去。", "en": "Several push up together."},
        {"zh": "我从石头后游出。", "en": "I swim out from behind the stone."},
        {"zh": "寒风从上游下来。", "en": "Cold wind comes down the river."},
        {"zh": "我摆尾站稳。", "en": "One flick holds me steady."},
        {"zh": "河水在我身边分开。", "en": "The river splits around me."},
        {"zh": "我浮在浅滩。", "en": "I float on the shallows."},
        {"zh": "我找到了这一段。", "en": "I have found this stretch."}
      ]
    },
