{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "一大群一起转向", "en": "The whole school banks at once."},
        {"zh": "银色的侧面同时翻光", "en": "A hundred silver flanks flash together."},
        {"zh": "我夹在鱼群中间", "en": "I'm in the middle of it."},
        {"zh": "左右都是同伴", "en": "Companions on both sides."},
        {"zh": "水从鳃边穿过去", "en": "Water passes through my gills."},
        {"zh": "我跟着前面那条的尾", "en": "I follow the tail ahead."},
        {"zh": "它转，我也转", "en": "It turns. I turn."},
        {"zh": "转得一点不差", "en": "Not a beat off."},
        {"zh": "我们贴着沙地走", "en": "We move close to the sand."},
        {"zh": "上面有更大的影子", "en": "A larger shadow above."},
        {"zh": "我们压低了一层", "en": "We drop a layer."},
        {"zh": "那影子过去了", "en": "The shadow passes."},
        {"zh": "我们又浮起来", "en": "We rise again."},
        {"zh": "继续往暖水去", "en": "On toward warmer water."},
        {"zh": "那边的水色更浅", "en": "The water's paler there."},
        {"zh": "我喜欢浅色的水", "en": "I like the pale."},
        {"zh": "背上的斑能藏住", "en": "The marks on my back blend in."},
        {"zh": "一起藏起来更好", "en": "Better hidden together."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "悬在水里，鳍轻颤", "en": "Hovering, fins quivering."},
        {"zh": "同伴都在四周", "en": "Schoolmates all around."},
        {"zh": "我们一致地摆", "en": "We sway as one."},
        {"zh": "一群鱼像一块东西", "en": "The school moves like one thing."},
        {"zh": "有鱼想挤进来", "en": "One tries to squeeze in."},
        {"zh": "它们都远远让开", "en": "Room is made."},
        {"zh": "我们从来不互撞", "en": "We never collide."},
        {"zh": "沙上有我们的影子", "en": "Our shadows lie on the sand."},
        {"zh": "一大团模糊黑影", "en": "One dark, blurred mass."},
        {"zh": "有光斑在上面晃", "en": "Light spots waver over it."},
        {"zh": "我转了个小角度", "en": "I turn a small angle."},
        {"zh": "整群也跟着动", "en": "The school follows."},
        {"zh": "这就是我们的样子", "en": "That's how we are."},
        {"zh": "几十条一起，像一条", "en": "Dozens of us, moving as one."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在礁石上", "en": "You stand on the reef."},
        {"zh": "我们从你下面过", "en": "We pass beneath you."},
        {"zh": "你看到的是影子", "en": "You see only shadows."},
        {"zh": "一大团，很快", "en": "One big mass, fast."},
        {"zh": "然后又游回来", "en": "Then back again."},
        {"zh": "你蹲下来看我们", "en": "You crouch to look."},
        {"zh": "我们散了一下", "en": "We scatter a little."},
        {"zh": "然后又合起来", "en": "Then close up."},
        {"zh": "我们其实不怕你", "en": "We're not afraid of you."},
        {"zh": "只是不想挨太近", "en": "We just don't want to be close."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "整群一下散成几团", "en": "The school breaks into several knots."},
        {"zh": "我也跟着一起", "en": "And I with it."},
        {"zh": "我落了一片鳞", "en": "A scale slips off me."},
        {"zh": "水里浮着一丝血", "en": "Blood in the water."},
        {"zh": "我们散得更开", "en": "We scatter wider."},
        {"zh": "慢慢又合拢起来", "en": "Slowly closing again."},
        {"zh": "同伴全都还在", "en": "Everyone's still here."},
        {"zh": "一个都没有少", "en": "No one missing."},
        {"zh": "我们照旧往前游", "en": "We swim on as before."},
        {"zh": "水里没有别的办法", "en": "There's no other way in water."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西落下来", "en": "Something drops in."},
        {"zh": "整群先一下散开", "en": "The school scatters first."},
        {"zh": "然后慢慢围回来", "en": "Then slowly gathers back."},
        {"zh": "一条先上来试探", "en": "One of us tests it."},
        {"zh": "只轻轻碰了一下", "en": "A touch."},
        {"zh": "然后又碰一下", "en": "Another touch."},
        {"zh": "然后才敢去咬", "en": "Then a bite."},
        {"zh": "结果一点没事", "en": "Nothing happens."},
        {"zh": "整群都上来了", "en": "The whole school comes in."},
        {"zh": "一会儿就没了", "en": "And it's gone in moments."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "水被我们搅开", "en": "Our passing stirs the water."},
        {"zh": "整群闪了一下", "en": "The school flashes away."},
        {"zh": "它们又游了回来", "en": "They swim back in."},
        {"zh": "我们靠得很紧", "en": "We stay very close."},
        {"zh": "你的手碰到一条", "en": "Your hand touches one of us."},
        {"zh": "它一下闪走了", "en": "It darts away."},
        {"zh": "其余的也跟着散", "en": "The rest scatter too."},
        {"zh": "过一会又聚回来", "en": "A moment later, gathered again."},
        {"zh": "我们不太记仇", "en": "We don't hold grudges."},
        {"zh": "水里就是这样", "en": "That's how it is in water."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个季节水暖", "en": "The water's warm this season."},
        {"zh": "整群都往浅处去", "en": "The whole school moves shallow."},
        {"zh": "我们在那里散开", "en": "We spread out there."},
        {"zh": "很多卵落下去", "en": "Many eggs fall."},
        {"zh": "沙上铺了一层", "en": "The sand is dusted with them."},
        {"zh": "我们便不去管", "en": "We leave them be."},
        {"zh": "过一阵就有小鱼", "en": "Soon there will be small fish."},
        {"zh": "它们会自己成群", "en": "They'll school on their own."},
        {"zh": "就像我们这样", "en": "The way we do."},
        {"zh": "一代接着一代", "en": "Generation after generation."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我直接就吞了", "en": "I swallow it straight down."},
        {"zh": "太小，没尝出味", "en": "Too small to taste."},
        {"zh": "我再吞下一条", "en": "Another one."},
        {"zh": "沙里还有很多", "en": "There are plenty in the sand."},
        {"zh": "整群一起翻沙", "en": "The whole school stirs the sand."},
        {"zh": "沙翻起来，我们照旧吃。", "en": "Sand kicks up; we keep feeding."},
        {"zh": "我们照旧在吃", "en": "We keep feeding."},
        {"zh": "泥里的东西我们也找", "en": "We scour the silt too."},
        {"zh": "吃完再一起游开", "en": "Then move on."},
        {"zh": "吃饱了游得慢", "en": "Full fish swim slower."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "一个影子压下来", "en": "A shadow presses down."},
        {"zh": "整群立刻下沉", "en": "The school drops at once."},
        {"zh": "我们缩成一团", "en": "We pull into a ball."},
        {"zh": "这样看不出哪条是大的", "en": "So nothing stands out."},
        {"zh": "那影子散开了", "en": "The shadow breaks up."},
        {"zh": "我们这才散开", "en": "Then we spread."},
        {"zh": "又重新变成一群", "en": "A school again."},
        {"zh": "水面上看不到什么", "en": "Nothing to see from above."},
        {"zh": "我们就在下面", "en": "We're down here."},
        {"zh": "我们有很多条", "en": "A great many of us."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们绕着礁石转", "en": "We circle the reef."},
        {"zh": "一圈接着一圈", "en": "Round and round."},
        {"zh": "你看久了会花眼", "en": "Watch long and your eyes blur."},
        {"zh": "数不清有多少条", "en": "You can't count us."},
        {"zh": "我们一直在动", "en": "We never stop moving."},
        {"zh": "有东西靠近就散", "en": "When something nears, we break apart."},
        {"zh": "散开就是消失", "en": "To scatter is to vanish."},
        {"zh": "过一会再从别处出来", "en": "Then we appear elsewhere."},
        {"zh": "你总会看错几条", "en": "You'll always misjudge."},
        {"zh": "我们早就习惯了", "en": "We're used to it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我们撞了你一下", "en": "We bump against you."},
        {"zh": "很多条一起撞", "en": "Many at once."},
        {"zh": "你感觉到的是水流", "en": "What you feel is water."},
        {"zh": "那其实并不是咬", "en": "Not a bite."},
        {"zh": "有东西擦过你的手", "en": "Something brushes your hand."},
        {"zh": "那力道非常轻", "en": "Very light."},
        {"zh": "然后就不见了", "en": "Then it's gone."},
        {"zh": "我们不会留在原地", "en": "We never stay put."},
        {"zh": "你伸手也抓不到", "en": "Reaching won't catch us."},
        {"zh": "我们已经游开了", "en": "We've already moved off."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上闪过一片银", "en": "A flash of silver crosses the surface."},
        {"zh": "然后又是一片", "en": "Then another."},
        {"zh": "整群从海沟里升上来。", "en": "The whole school rises out of the trench."},
        {"zh": "整片海都有我们", "en": "This whole sea is ours."},
        {"zh": "沙地、礁石、水草", "en": "Sand, reef, weeds."},
        {"zh": "我们贴着底走", "en": "We keep close to it all."},
        {"zh": "有同伴在前面", "en": "Companions ahead."},
        {"zh": "后面也有一群", "en": "And behind."},
        {"zh": "我挤在最密的地方", "en": "I press into the thickest part."},
        {"zh": "银光一片，我们成群过来。", "en": "A sheet of silver: we come as a school."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水变热，整群往下沉", "en": "The water warms and the school sinks."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我们被冲到岸上，乱跳", "en": "Washed ashore, we flop and thrash."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里居然喘不上气", "en": "Even the water has no air."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "水被震开，我们四散", "en": "The water bursts and we scatter."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过整群", "en": "Something cuts through the school."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "水流忽然全乱", "en": "The current goes wild."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "水里没东西吃了", "en": "Nothing left to eat down here."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷进了水，整群一僵", "en": "Lightning enters the water and the school freezes."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "整片海都没了", "en": "The sea is gone."}
      ]
    }
  }
}
