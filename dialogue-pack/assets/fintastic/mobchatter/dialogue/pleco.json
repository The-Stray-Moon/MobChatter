{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我吸在石头上慢慢挪。", "en": "I cling to the stone and creep along."},
        {"zh": "嘴像吸盘，贴着木头。", "en": "My mouth is a sucker, pressed to the wood."},
        {"zh": "我沿着沉木往下。", "en": "I work my way down the sunken log."},
        {"zh": "尾巴一摆，换个位置。", "en": "A tail flick moves me elsewhere."},
        {"zh": "我贴着池底爬。", "en": "I crawl along the pool floor."},
        {"zh": "我钻进根须之间。", "en": "I slip between the roots."},
        {"zh": "泥土都被我吸起来。", "en": "I suck up the silt as I go."},
        {"zh": "我慢慢往阴处。", "en": "I drift toward the shade."},
        {"zh": "我横着挪了一段。", "en": "I shift sideways a stretch."},
        {"zh": "我停在一片苔上。", "en": "I stop on a patch of moss."},
        {"zh": "我贴着木面挪回原处。", "en": "I creep back along the wood."},
        {"zh": "我贴着石面转了个弯。", "en": "I turn along the stone's face."},
        {"zh": "我挪到水草后面。", "en": "I move behind the weeds."},
        {"zh": "我蹭着砂砾走。", "en": "I rasp over the gravel."},
        {"zh": "我停了一下，再爬。", "en": "I pause, then crawl on."},
        {"zh": "我压低身子贴住石面。", "en": "I press myself lower against the stone."},
        {"zh": "我从缝里挤过去。", "en": "I squeeze through the crevice."},
        {"zh": "我又挂住了。", "en": "I have a grip again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我吸在壁上，不动。", "en": "I hold to the wall, unmoving."},
        {"zh": "我贴在壁上，嘴慢慢开合。", "en": "Clinging to the wall, my mouth works slowly."},
        {"zh": "水里有些碎屑。", "en": "There are crumbs in the water."},
        {"zh": "我身上有斑纹。", "en": "I have mottled markings."},
        {"zh": "我贴着木头。", "en": "I press against the wood."},
        {"zh": "暗处正合我的性子。", "en": "The dark suits my temperament."},
        {"zh": "我伏着，半天不挪。", "en": "I lie still, not moving for a long while."},
        {"zh": "水从我鳃缝里滤过去。", "en": "Water filters out through my gills."},
        {"zh": "池底有一层泥。", "en": "There is a layer of silt on the bottom."},
        {"zh": "我在等变暗。", "en": "I wait for it to darken."},
        {"zh": "我的鳍贴着身。", "en": "My fins lie flat against me."},
        {"zh": "我慢慢换了吸气。", "en": "I slowly change my draw."},
        {"zh": "周围没什么动静。", "en": "Nothing stirs around me."},
        {"zh": "我挂在原处。", "en": "I stay where I am."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在水里。", "en": "You are standing in the water."},
        {"zh": "我不太显眼吧。", "en": "I am not very noticeable, am I."},
        {"zh": "你踢起的泥糊了我一身。", "en": "The mud you kicked covers me."},
        {"zh": "我贴着沉木挪开。", "en": "I creep away along the sunken log."},
        {"zh": "我吸在石头上。", "en": "I am stuck to this stone."},
        {"zh": "你看不清我的。", "en": "You cannot see me clearly."},
        {"zh": "我紧贴池底的淤泥。", "en": "I press tight to the silt on the pool floor."},
        {"zh": "你的脚就踩在我旁边。", "en": "Your foot is planted right beside me."},
        {"zh": "我不跑，我贴。", "en": "I do not run. I cling."},
        {"zh": "这就是我的样子。", "en": "This is how I look."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的吸盘松了。", "en": "My grip loosened."},
        {"zh": "我歪到淤沙里。", "en": "I tilted into the silt."},
        {"zh": "我慢慢再吸住。", "en": "I slowly take hold again."},
        {"zh": "泥把我埋了半截。", "en": "The silt half-buried me."},
        {"zh": "我贴在石边喘。", "en": "I rest against the stone."},
        {"zh": "这一下扎心。", "en": "That one bit deep."},
        {"zh": "身上掉了一点。", "en": "A little of me came away."},
        {"zh": "我挪到暗处。", "en": "I move into the dark."},
        {"zh": "我还能贴住。", "en": "I can still cling."},
        {"zh": "不要再碰我了。", "en": "Do not touch me again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有渣子。", "en": "There is debris in the water."},
        {"zh": "我凑过去吸一口。", "en": "I press in for a mouthful."},
        {"zh": "这个在石头上。", "en": "It is on the stone."},
        {"zh": "我贴上去吸。", "en": "I press on and feed."},
        {"zh": "苔味淡得很。", "en": "The moss taste is thin."},
        {"zh": "我顺着石面慢慢蹭。", "en": "I rasp slowly along the stone."},
        {"zh": "这一点吸不饱。", "en": "This will not fill me."},
        {"zh": "同伴也在旁边。", "en": "Another of us is nearby."},
        {"zh": "不要把水搅浑。", "en": "Do not muddy the water."},
        {"zh": "我还在吸着。", "en": "I am still feeding."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得松开。", "en": "The knock loosened my grip."},
        {"zh": "我从石上滑下来。", "en": "I slipped off the stone."},
        {"zh": "我赶紧再吸住。", "en": "I suck onto something again at once."},
        {"zh": "泥一下扬起来。", "en": "The silt bursts upward."},
        {"zh": "你的脚碰到我了。", "en": "Your foot touched me."},
        {"zh": "我挪到石头另一边。", "en": "I move to the other side of the stone."},
        {"zh": "我贴得很紧。", "en": "My grip is tight."},
        {"zh": "这点磕碰不碍事。", "en": "This little scrape is nothing."},
        {"zh": "水又浑起来了。", "en": "The water clouded again."},
        {"zh": "让我游过去。", "en": "Let me pass."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们都贴在这块沉木上。", "en": "We both cling to this sunken log."},
        {"zh": "慢慢吃，不必抢。", "en": "Eat slowly. No need to rush."},
        {"zh": "石头下面够暗。", "en": "It is dark enough under the stone."},
        {"zh": "我贴着你慢慢移过去。", "en": "I cling and shift over to you."},
        {"zh": "别把泥全扬起来。", "en": "Do not stir up all the silt."},
        {"zh": "我们一起吸这片苔。", "en": "Let us feed on this moss."},
        {"zh": "叶影能遮住我俩。", "en": "The leaf shade will cover us both."},
        {"zh": "一句话也不说。", "en": "Not a word."},
        {"zh": "这块木头够两个。", "en": "This log has room for two."},
        {"zh": "接着吸这片苔。", "en": "Keep feeding on this moss."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我吸住了它。", "en": "I sucked onto it."},
        {"zh": "它贴在嘴上。", "en": "It stuck to my mouth."},
        {"zh": "我甩头抛开。", "en": "I shake my head and dislodge it."},
        {"zh": "我的嘴吸不住。", "en": "My mouth cannot grip it."},
        {"zh": "这东西压手。", "en": "This weighs heavy."},
        {"zh": "我把它吐出去。", "en": "I spat it out."},
        {"zh": "硬得像块石。", "en": "Hard as a stone."},
        {"zh": "我从它旁边挪开。", "en": "I shift away from it."},
        {"zh": "我使不上它。", "en": "It is no use to me."},
        {"zh": "掉在泥里的，我吸。", "en": "I suck up what fell in the silt."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有影子过来。", "en": "A shadow is coming."},
        {"zh": "我贴得更紧。", "en": "I press tighter."},
        {"zh": "我在石头下面。", "en": "I am under the stone."},
        {"zh": "它看不清我。", "en": "It cannot see me well."},
        {"zh": "我慢慢往暗处。", "en": "I edge into the dark."},
        {"zh": "不要过来吧。", "en": "Do not come closer."},
        {"zh": "我把鳍贴身收平。", "en": "I fold my fins flat to my body."},
        {"zh": "我藏进泥里。", "en": "I sink into the silt."},
        {"zh": "它在我上方。", "en": "It is above me."},
        {"zh": "我按着不动。", "en": "I hold still."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "那道影仍没走远。", "en": "That shape has not gone far."},
        {"zh": "我贴着石头。", "en": "I cling to the stone."},
        {"zh": "泥把我盖住了。", "en": "The silt covers me."},
        {"zh": "它绕着石头转。", "en": "It circled the stone."},
        {"zh": "我挪了一点。", "en": "I moved a little."},
        {"zh": "水的声音变了。", "en": "The sound of the water changed."},
        {"zh": "再沉住一会儿。", "en": "Hold a little longer."},
        {"zh": "那影子还没发现我。", "en": "That shadow has not found me."},
        {"zh": "我依旧吸在石头上。", "en": "I stay stuck to the stone."},
        {"zh": "它快走开了。", "en": "It is nearly gone."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我甩尾撞了一下。", "en": "I flicked my tail into you."},
        {"zh": "这点劲很小。", "en": "That was very little force."},
        {"zh": "我根本咬不动。", "en": "I cannot bite it at all."},
        {"zh": "我又吸回石上。", "en": "I stick back to the stone."},
        {"zh": "我没别的本事。", "en": "I have no other skill."},
        {"zh": "不要碰我吧。", "en": "Do not touch me."},
        {"zh": "我伏在池底不抬头。", "en": "I stay low on the pool floor, head down."},
        {"zh": "我什么都没做成。", "en": "I accomplished nothing."},
        {"zh": "水花非常小。", "en": "The splash is very small."},
        {"zh": "我还是躲吧。", "en": "I had better hide."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
