{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我横着身子慢慢游。", "en": "I swim along slowly, flat-bodied."},
        {"zh": "背鳍划开浅水。", "en": "My dorsal fin parts the shallows."},
        {"zh": "我贴着沙滩边。", "en": "I keep near the sandy edge."},
        {"zh": "阳光在沙上晃。", "en": "The sunlight shifts on the sand."},
        {"zh": "我拐进暖水的湾。", "en": "I turn into the warm-water bay."},
        {"zh": "几条一起横过来。", "en": "A few of us come across together."},
        {"zh": "我摆尾，走得很稳。", "en": "One flick, and I go steady."},
        {"zh": "我顺着暖流游。", "en": "I follow the warm current."},
        {"zh": "水面比水底亮。", "en": "The surface is brighter than the bottom."},
        {"zh": "我从海草边上滑过去。", "en": "I slide past the edge of the seagrass."},
        {"zh": "我贴着白沙低游。", "en": "I swim low over the white sand."},
        {"zh": "我侧身转过来。", "en": "I turn broadside."},
        {"zh": "红树林的根在水里。", "en": "The mangrove roots stand in the water."},
        {"zh": "我慢慢往深处。", "en": "I drift deeper."},
        {"zh": "我停在沙地上方。", "en": "I hover above the sand."},
        {"zh": "我歪了一下，才稳住。", "en": "I tilted before steadying."},
        {"zh": "海中亮得很。", "en": "It is very bright in the sea."},
        {"zh": "我跟着水里的光。", "en": "I follow the light in the water."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在暖水里。", "en": "I hang in the warm water."},
        {"zh": "我这双大眼看得清。", "en": "These big eyes see clearly."},
        {"zh": "我把嘴张圆。", "en": "I round my mouth open."},
        {"zh": "沙子在我下面很白。", "en": "The sand below me is white."},
        {"zh": "我轻轻摆鳍。", "en": "I move my fins gently."},
        {"zh": "同伴散在四周。", "en": "My shoal is spread around."},
        {"zh": "水只没到我背鳍。", "en": "The water barely covers my dorsal fin."},
        {"zh": "我侧过扁平的身子。", "en": "I turn my flat body sideways."},
        {"zh": "水浅，远处发虚。", "en": "The water is shallow; distance blurs."},
        {"zh": "阳光晒着水面。", "en": "The sun warms the surface."},
        {"zh": "我没有躲起来。", "en": "I am not hiding."},
        {"zh": "我浮一会儿再动。", "en": "I float a while before moving."},
        {"zh": "海草一直在摇。", "en": "The seagrass keeps swaying."},
        {"zh": "我悬着，不出一点声。", "en": "I hover without a sound."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在浅水里。", "en": "You are standing in the shallows."},
        {"zh": "你的腿把水搅浑了。", "en": "Your legs are clouding the water."},
        {"zh": "我仰头看你站在水里。", "en": "I look up at you standing in the water."},
        {"zh": "我游得很慢。", "en": "I swim slowly."},
        {"zh": "你手里是什么。", "en": "What is that in your hand."},
        {"zh": "我小心，但没在怕。", "en": "I am careful, not frightened."},
        {"zh": "我绕着你的脚。", "en": "I circle your feet."},
        {"zh": "你把脚挪开些。", "en": "Move your feet away a little."},
        {"zh": "水里很安全。", "en": "The water is safe."},
        {"zh": "我是条大眼鲳。", "en": "I am a moony."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下子窜出去。", "en": "I darted away."},
        {"zh": "浅水一下浑了。", "en": "The shallows clouded over."},
        {"zh": "肩上的鳞掀了。", "en": "Scales lifted off my shoulder."},
        {"zh": "我横着打转。", "en": "I spun broadside."},
        {"zh": "鱼群一下子散没了。", "en": "The shoal scatters in an instant."},
        {"zh": "我还能横着游。", "en": "I can still swim broadside."},
        {"zh": "浅水里飘着血。", "en": "Blood drifts in the shallows."},
        {"zh": "我摆尾沉进深水里。", "en": "I beat my tail down into deeper water."},
        {"zh": "疼得厉害吧。", "en": "It hurts badly."},
        {"zh": "你退两步，别碰水。", "en": "Two steps back. Do not touch the water."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这么一点碎屑。", "en": "Just a few crumbs."},
        {"zh": "我摆尾绕过去瞧。", "en": "I flick my tail over to look."},
        {"zh": "同伴也来了。", "en": "My shoalmates came too."},
        {"zh": "这个能咬动。", "en": "I can bite this."},
        {"zh": "不要倒太多。", "en": "Do not pour too much."},
        {"zh": "它在水里化开了。", "en": "It dissolved into the water."},
        {"zh": "我抢到一点。", "en": "I got a little."},
        {"zh": "味道有点淡。", "en": "The taste is a little thin."},
        {"zh": "还有第二把吗。", "en": "Is there a second handful."},
        {"zh": "我一寸一寸游过去。", "en": "I swim over inch by inch."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "这一撞把我推歪了。", "en": "The blow shoves me off line."},
        {"zh": "水花在沙上炸开。", "en": "Splash bursts on the sand."},
        {"zh": "我横过来了。", "en": "I ended up broadside."},
        {"zh": "我立刻稳回来。", "en": "I steady at once."},
        {"zh": "你这一下撞得我发晕。", "en": "That shove leaves me dazed."},
        {"zh": "沙被搅起来。", "en": "The sand is churned up."},
        {"zh": "我绕着你游开。", "en": "I swim around you."},
        {"zh": "我不跟你撞。", "en": "I will not trade blows."},
        {"zh": "我游得远了些。", "en": "I swam farther off."},
        {"zh": "别去踢那水。", "en": "Do not kick the water."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "几条一起横着走。", "en": "A few of us go across together."},
        {"zh": "队形要摆平。", "en": "Keep the line level."},
        {"zh": "沙地上有亮处。", "en": "There is a bright patch on the sand."},
        {"zh": "我们靠得近些。", "en": "Let us stay close."},
        {"zh": "暖水就在那边。", "en": "The warm water is over there."},
        {"zh": "别游得太散。", "en": "Do not swim too loosely."},
        {"zh": "一尾一尾跟紧。", "en": "Follow close, tail to tail."},
        {"zh": "水里很舒服。", "en": "The water is comfortable."},
        {"zh": "一起游过去。", "en": "Let us swim over together."},
        {"zh": "再游上一程。", "en": "Another stretch."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我张口就吞下去。", "en": "I open my mouth and swallow."},
        {"zh": "这东西硌得我嘴疼。", "en": "This thing hurts my mouth."},
        {"zh": "我顶出嘴外。", "en": "I push it back out."},
        {"zh": "它落在沙上。", "en": "It fell on the sand."},
        {"zh": "我低头去叼。", "en": "I lower my head to take it."},
        {"zh": "我的嘴不适应。", "en": "My mouth will not take it."},
        {"zh": "坠得我往下沉。", "en": "It drags me down."},
        {"zh": "我含着一会儿。", "en": "I held it a while."},
        {"zh": "这味道让我不太舒服。", "en": "This taste sits badly with me."},
        {"zh": "我游开了吧。", "en": "I swam off."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有影子。", "en": "A shadow in the water."},
        {"zh": "我转过去看。", "en": "I turn to look."},
        {"zh": "那影子的个头不小。", "en": "That shape is no small thing."},
        {"zh": "我往沙边靠。", "en": "I head for the sandy edge."},
        {"zh": "同伴也警觉了。", "en": "My shoal is alert too."},
        {"zh": "我贴近沙面。", "en": "I hug the sand."},
        {"zh": "水流乱了几分。", "en": "The current is a little wrong."},
        {"zh": "我准备游开。", "en": "I am ready to swim off."},
        {"zh": "它靠得很近。", "en": "It has come very near."},
        {"zh": "我紧贴着沙。", "en": "I hug the sand."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我眼睛不离那道影。", "en": "My eyes stay on that shape."},
        {"zh": "我正在绕圈。", "en": "I am circling."},
        {"zh": "同伴都退了。", "en": "My shoalmates have drawn back."},
        {"zh": "水变浑了吧。", "en": "The water clouded."},
        {"zh": "那道影还悬着。", "en": "That shape still hangs there."},
        {"zh": "我贴着沙地。", "en": "I stay on the sand."},
        {"zh": "再近我就钻。", "en": "Any closer and I dive."},
        {"zh": "我掉头游向另一边。", "en": "I turn and swim the other way."},
        {"zh": "它贴近了沙面。", "en": "It has come close to the sand."},
        {"zh": "我该动身了。", "en": "I should get moving."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用身子顶了你。", "en": "I butt you with my body."},
        {"zh": "我侧尾扫过水。", "en": "My tail sweeps the water sideways."},
        {"zh": "我这点力道推不动你。", "en": "This little strength will not move you."},
        {"zh": "我的牙咬不穿你。", "en": "My teeth cannot pierce you."},
        {"zh": "水花飞起来。", "en": "Water flies up."},
        {"zh": "尾巴一甩，我已游远。", "en": "One tail flick and I am gone."},
        {"zh": "不要跟过来。", "en": "Do not follow."},
        {"zh": "我钻进草里。", "en": "I dive into the seagrass."},
        {"zh": "你休想碰着我的鳍。", "en": "You will never touch my fins."},
        {"zh": "我只能这样。", "en": "This is all I can do."}
      ]
    },
