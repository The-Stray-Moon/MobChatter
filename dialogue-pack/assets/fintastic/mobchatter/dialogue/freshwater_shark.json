{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "背鳍划开河水", "en": "My dorsal fin cuts the river."},
        {"zh": "我们一小群，四五条", "en": "A small school of four or five."},
        {"zh": "我个头不大，游得利落", "en": "Not big, but I swim neatly."},
        {"zh": "丛林的水道我最喜欢", "en": "I favor the jungle waterways."},
        {"zh": "河底的沙被我扫起来", "en": "I stir the riverbed sand."},
        {"zh": "我贴着水草根绕了一圈", "en": "I circle close around the roots of the weeds"},
        {"zh": "一摆尾巴方向就变", "en": "One tail beat changes direction."},
        {"zh": "我贴着水面游动", "en": "I swim close to the surface."},
        {"zh": "牙齿不大，却很密", "en": "Small teeth, densely set."},
        {"zh": "河湾深水是我们的", "en": "The deep bend is ours."},
        {"zh": "我一路跟着水流游", "en": "I follow the current along."},
        {"zh": "河里有石头，我绕开", "en": "I avoid the stones."},
        {"zh": "看得出我是淡水鲨吗", "en": "Can you tell I'm a freshwater shark?"},
        {"zh": "我身上有一道浅纹", "en": "There's a pale stripe on me."},
        {"zh": "群里都跟着领头那条", "en": "The school follows the lead fish."},
        {"zh": "我在水里很少停下", "en": "I rarely stop in water."},
        {"zh": "一片水里，一群我们", "en": "One stretch of water, one school of us."},
        {"zh": "我游过桥墩下面", "en": "I swim under the bridge supports."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在河中央", "en": "I hang mid-river."},
        {"zh": "摇晃的是水草，不是我", "en": "The weed sways, not me."},
        {"zh": "我这身在水里看不出来", "en": "My body blends into the water."},
        {"zh": "别的鱼比我们小", "en": "The other fish are smaller."},
        {"zh": "我们从来不上岸", "en": "We don't go ashore."},
        {"zh": "河边传来脚步声", "en": "Footsteps on the bank."},
        {"zh": "我不必浮上来呼吸", "en": "I needn't surface to breathe."},
        {"zh": "我的鳃盖一开一合没停过", "en": "My gill covers never stop opening and closing"},
        {"zh": "河道很浅，我小心游", "en": "The channel is shallow; I swim carefully."},
        {"zh": "水流的味道很清", "en": "The current tastes clean."},
        {"zh": "这段河湾归我们一群", "en": "This stretch of the bend belongs to my school"},
        {"zh": "我盯着水面的影子", "en": "I watch the surface shadow."},
        {"zh": "群里有一条在绕圈", "en": "One of the school is circling."},
        {"zh": "我等水流把东西带来", "en": "I wait for the current to bring things."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在河岸上", "en": "You're standing on the riverbank."},
        {"zh": "你的影子落进水里", "en": "Your shadow falls on the water."},
        {"zh": "我盯着你手上的动作", "en": "I'm watching your hands move."},
        {"zh": "那个桶是做什么的", "en": "What's that bucket for?"},
        {"zh": "我不喜欢被捞起来", "en": "I don't like being scooped up."},
        {"zh": "你下水我就靠近", "en": "Step in, and I'll come close."},
        {"zh": "我这一群都在看", "en": "The whole school is watching."},
        {"zh": "你的影子把鱼都吓跑了", "en": "Your shadow scattered the fish."},
        {"zh": "我在水里，你碰不到我", "en": "In water, I'm hard to touch."},
        {"zh": "你要站多久呢", "en": "How long will you stand there?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我猛地窜了开去", "en": "I darted away."},
        {"zh": "鳞被刮掉了一片", "en": "A scale got scraped off."},
        {"zh": "水里乱了一下", "en": "The water churned."},
        {"zh": "我游到水草后面", "en": "I slipped behind the weeds."},
        {"zh": "这点伤，还能游", "en": "I can still swim with this."},
        {"zh": "群一下子就散开", "en": "The school scattered."},
        {"zh": "我的鳃动得更快了", "en": "My gills are working faster."},
        {"zh": "河水把血带走了", "en": "The river carried the blood off."},
        {"zh": "我又游回来了", "en": "And I came back."},
        {"zh": "别随便碰我的身子", "en": "Don't touch my body casually."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里的饵我自己寻", "en": "I find my own food down here."},
        {"zh": "你手上的饵太小了", "en": "That bait is too small."},
        {"zh": "扔进水里，我看一眼", "en": "Toss it in; I'll look."},
        {"zh": "我不吃岸上的东西", "en": "I don't eat things from shore."},
        {"zh": "水里的虫子才合我胃口", "en": "Water bugs suit me."},
        {"zh": "这一小口就够", "en": "A tiny bite is enough."},
        {"zh": "别把桶伸过来", "en": "Don't bring the bucket over."},
        {"zh": "探进水里我才闻得清", "en": "Put it in the water so I can smell it"},
        {"zh": "水花一动我就到", "en": "One splash and I'm there."},
        {"zh": "你退开我才靠近", "en": "Back off, and I'll approach."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到水我就撞过来", "en": "Touch the water and I bump you."},
        {"zh": "我这条不大，但很硬", "en": "I'm small but firm."},
        {"zh": "水挡了一下，你没觉得", "en": "The water softened it."},
        {"zh": "我撞完就散开", "en": "We bump and scatter."},
        {"zh": "群里的也从旁边过", "en": "The school passes on both sides."},
        {"zh": "我只撞你一下就够", "en": "I only bump once."},
        {"zh": "你踩进浅水里了", "en": "You stepped into the shallows."},
        {"zh": "水里我的机会多", "en": "In water I get more chances."},
        {"zh": "我们这行常挨撞", "en": "Bumps like that are routine."},
        {"zh": "你上岸我就不追", "en": "Back to shore and I won't follow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们是成群结队的", "en": "We live in schools."},
        {"zh": "水里不用挑得那么清", "en": "In water you don't choose so carefully."},
        {"zh": "跟着水流走就是了", "en": "Just follow the current."},
        {"zh": "这条河的鱼长得都像", "en": "The fish in this river all look alike."},
        {"zh": "你身上没有鳞", "en": "You've no scales."},
        {"zh": "群里会自己找伴", "en": "The school finds partners by itself."},
        {"zh": "慢慢绕上一圈", "en": "Circle slowly."},
        {"zh": "水草里很安静", "en": "It's quiet in the weeds."},
        {"zh": "别把水搅得太浑", "en": "Don't muddy the water."},
        {"zh": "你跟着我一起游", "en": "Swim with me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "水底有一块东西", "en": "Something on the riverbed."},
        {"zh": "我一口吞掉它", "en": "I gulp it down."},
        {"zh": "这个实在太小", "en": "This one's too small."},
        {"zh": "水里的东西我都尝", "en": "I taste everything in the water."},
        {"zh": "我不挑，能吞就行", "en": "Not picky; if I can swallow it."},
        {"zh": "这一口连我自己都不够", "en": "One bite of this won't even fill me"},
        {"zh": "我围着它嗅了一圈", "en": "I circle it once, sniffing"},
        {"zh": "沙从鳃缝里漏出去", "en": "Sand slips out through my gills."},
        {"zh": "漂下来的都归我们", "en": "Whatever drifts down is ours."},
        {"zh": "你扔下来的我不碰", "en": "What you drop, I won't take."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在水里发抖", "en": "You're shivering in the water."},
        {"zh": "同群的都调头跟上来", "en": "The rest of my school turns and follows"},
        {"zh": "我咬的是脚踝", "en": "I go for the ankle."},
        {"zh": "牙不大，但很多", "en": "Small teeth, many of them."},
        {"zh": "河水会帮我们", "en": "The river helps us."},
        {"zh": "你退得没我游得快", "en": "You can't back away faster than I swim."},
        {"zh": "我贴着你的脚踝游过", "en": "I glide past your ankle"},
        {"zh": "水花盖住了声音", "en": "The splashing hides the sound."},
        {"zh": "你快站不稳了", "en": "You're losing your footing."},
        {"zh": "不过一口的事", "en": "It's the work of one bite."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一群绕着你", "en": "The school circles you."},
        {"zh": "你在水里没地方躲", "en": "No hiding in the water."},
        {"zh": "你两条腿在水里很显眼", "en": "Your two legs stand out underwater"},
        {"zh": "河底的泥被我们搅起来", "en": "We've muddied the riverbed."},
        {"zh": "水变浑了，你更难看清", "en": "Muddier water; you see less."},
        {"zh": "我们比你更熟这条河", "en": "We know this river better."},
        {"zh": "你一动就起水纹", "en": "Every move sends ripples."},
        {"zh": "那些水纹全是线索", "en": "Those ripples are all clues."},
        {"zh": "慢慢把圈收小", "en": "Closing the circle."},
        {"zh": "别往深水那边走", "en": "Don't head for the deep."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬在小腿上", "en": "One bite at the shin."},
        {"zh": "我斜着撞向你的小腿", "en": "I ram your calf from an angle"},
        {"zh": "尾鳍拍在你膝弯上", "en": "My tail fin slaps the back of your knee"},
        {"zh": "咬上一口就退", "en": "Bite and retreat."},
        {"zh": "好几条一起咬", "en": "Several bite at once."},
        {"zh": "水把你往下拽", "en": "The water drags you down."},
        {"zh": "这点伤不算重", "en": "This wound isn't heavy."},
        {"zh": "但你会流很多血", "en": "But you'll bleed a lot."},
        {"zh": "水一红我们就更兴奋", "en": "Red water excites us."},
        {"zh": "散开，等下一次", "en": "We scatter and wait."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "河面拱起一道背鳍", "en": "A dorsal fin breaks the river's surface"},
        {"zh": "一小群从下游游上来", "en": "A small school came up from downstream."},
        {"zh": "我的背鳍先露出来", "en": "My dorsal fin showed first."},
        {"zh": "这段河道水够深", "en": "This channel is deep enough."},
        {"zh": "我们从丛林那边游来", "en": "We swam in from the jungle side."},
        {"zh": "水草里多了几条影子", "en": "A few more shadows in the weeds."},
        {"zh": "河里的老住户又回来了", "en": "The river's old residents are back."},
        {"zh": "我跟着领头的那条", "en": "I follow the leader."},
        {"zh": "水面上的圈是我留下的", "en": "The rings on the surface are mine."},
        {"zh": "手别往水里伸", "en": "Keep your hands out of the water."}
      ]
    },
