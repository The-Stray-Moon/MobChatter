{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小尾巴一摆，窜出去一小段。", "en": "One flick of my little tail and I dart a short way."},
        {"zh": "我沿着水草往上钻。", "en": "I thread up along the weed."},
        {"zh": "我猛地扭了个弯。", "en": "I whip round a sharp bend."},
        {"zh": "我贴着泥面滑过去。", "en": "I skim along the mud."},
        {"zh": "我朝那群同伴游去。", "en": "I swim toward that crowd of my kind."},
        {"zh": "我摆着身子往前挪。", "en": "I wiggle forward."},
        {"zh": "我顺着水流漂了一截。", "en": "I drift a stretch with the current."},
        {"zh": "我朝水面浮上去。", "en": "I rise toward the surface."},
        {"zh": "我从水草缝里穿过去。", "en": "I slip through a gap in the weed."},
        {"zh": "我绕着那片浮叶转。", "en": "I circle that floating leaf."},
        {"zh": "我又急急地游开。", "en": "I dart away again."},
        {"zh": "我朝浅处一冲。", "en": "I shoot into the shallows."},
        {"zh": "我侧身一摆，换了个方向。", "en": "I swing sideways and change direction."},
        {"zh": "我慢慢沉回中层。", "en": "I sink back to mid water."},
        {"zh": "我跟着同伴游成一群。", "en": "I swim along in a shoal."},
        {"zh": "我游向亮处去。", "en": "I swim off toward the light."},
        {"zh": "我钻进叶影底下。", "en": "I duck under the leaf shadow."},
        {"zh": "我朝水草深处去。", "en": "I head deeper into the weed."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水中，尾巴轻摆。", "en": "I hang in the water, tail flicking."},
        {"zh": "我停在叶影里不动。", "en": "I hold still in the leaf shadow."},
        {"zh": "我朝水面看了一会儿。", "en": "I watch the surface a while."},
        {"zh": "同伴在我旁边转。", "en": "A shoalmate circles beside me."},
        {"zh": "我慢慢动了下鳍。", "en": "I move my fins slowly."},
        {"zh": "水里的光在晃。", "en": "The light in the water shifts."},
        {"zh": "我悬着，连鳍都不动。", "en": "I hang there without even moving a fin."},
        {"zh": "我吐了两个小泡。", "en": "I release two small bubbles."},
        {"zh": "我贴着水草茎。", "en": "I press against a weed stalk."},
        {"zh": "我把身子转向暗处。", "en": "I turn my body into the shade."},
        {"zh": "我悬在那儿发呆。", "en": "I hang there lost in nothing."},
        {"zh": "我随水轻轻晃。", "en": "I sway gently with the water."},
        {"zh": "我又朝上浮了一点。", "en": "I float up a little more."},
        {"zh": "我很快又沉回去。", "en": "I soon sink back."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我正面对着你。", "en": "I face you squarely."},
        {"zh": "你的影子把水面压暗。", "en": "Your shadow darkens the surface."},
        {"zh": "我近了一点，又退回去。", "en": "I come a little closer and back off."},
        {"zh": "我瞧着你的指头。", "en": "I watch your fingers."},
        {"zh": "你一动，我们就散开。", "en": "When you move, we scatter."},
        {"zh": "我又游回来看看。", "en": "I swim back to look again."},
        {"zh": "我绕着你的倒影打转。", "en": "I circle your reflection."},
        {"zh": "我在你手边停住。", "en": "I stop by your hand."},
        {"zh": "你这么高，我有点怕。", "en": "You are so tall; I am a little afraid."},
        {"zh": "我退回同伴那边。", "en": "I retreat to my shoal."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我乱窜，撞到水草上。", "en": "I bolt and hit the weed."},
        {"zh": "这一记把我翻了个身。", "en": "That blow rolled me right over."},
        {"zh": "我躲在叶影里。", "en": "I hide in the leaf shadow."},
        {"zh": "我的尾巴破了一角。", "en": "A corner of my tail is torn."},
        {"zh": "我慢慢游回群里。", "en": "I swim slowly back to the shoal."},
        {"zh": "水里一片浑。", "en": "The water is all murk."},
        {"zh": "我贴在泥面不动。", "en": "I press to the mud and hold."},
        {"zh": "我摆尾还摆得动。", "en": "My tail can still beat."},
        {"zh": "我的腮动得急。", "en": "My gills pump quickly."},
        {"zh": "这一撞，我记在尾柄上。", "en": "I keep that in my tail base."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有碎屑散开。", "en": "Crumbs scatter in the water."},
        {"zh": "我冲过去抢。", "en": "I dash over and snatch."},
        {"zh": "同伴都挤过来了。", "en": "The whole shoal crowds in."},
        {"zh": "这一口实在是小。", "en": "That mouthful really is tiny."},
        {"zh": "我张口便吞。", "en": "I open my mouth and swallow."},
        {"zh": "我又抬头找。", "en": "I look up for more."},
        {"zh": "我吃得太快，呛了一下。", "en": "I ate too fast and choked once."},
        {"zh": "这一点不够分。", "en": "That is not enough to share."},
        {"zh": "我绕着碎屑转圈。", "en": "I circle the crumbs."},
        {"zh": "我吃到肚子变圆。", "en": "I eat until my belly rounds out."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被水流翻了个身。", "en": "The current flips me over."},
        {"zh": "我一抖就窜开。", "en": "One twitch and I dart off."},
        {"zh": "同伴都散了。", "en": "The shoal scatters."},
        {"zh": "我藏到水草之后。", "en": "I hide behind the weed."},
        {"zh": "水立刻变浑。", "en": "The water clouds instantly."},
        {"zh": "我慢慢游回来。", "en": "I swim slowly back."},
        {"zh": "这么一撞就看不见了。", "en": "One bump and I lose sight of everything."},
        {"zh": "我贴着泥面不动。", "en": "I press to the mud and hold."},
        {"zh": "等水清了再说。", "en": "Wait until the water clears."},
        {"zh": "别再顶我了。", "en": "Stop bumping me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我围着它兜。", "en": "I circle it."},
        {"zh": "它追着我游。", "en": "It chases me."},
        {"zh": "我们贴在一起摆。", "en": "We press together and sway."},
        {"zh": "它朝水草里去，我跟着。", "en": "It goes into the weed and I follow."},
        {"zh": "我们散开，又聚回来。", "en": "We scatter and gather again."},
        {"zh": "一群鱼都在打转。", "en": "The whole shoal is turning."},
        {"zh": "我把身子侧过去一点。", "en": "I tilt my body a bit toward it."},
        {"zh": "它一动，水就乱。", "en": "When it moves, the water stirs."},
        {"zh": "我们缓缓散开。", "en": "We slowly drift apart."},
        {"zh": "我又游回群里。", "en": "I swim back into the group."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我张口就咬住它。", "en": "I open my mouth and take it."},
        {"zh": "太小了，我直接吞。", "en": "Too small; I swallow it whole."},
        {"zh": "它在嘴里化开了。", "en": "It dissolves in my mouth."},
        {"zh": "我又吐出来了。", "en": "I spit it back out."},
        {"zh": "尝着还过得去。", "en": "It tastes passable."},
        {"zh": "它从我嘴边溜走了。", "en": "It slipped past my mouth."},
        {"zh": "我又追赶上去。", "en": "I give chase again."},
        {"zh": "我把它含在腮边。", "en": "I hold it by my gill."},
        {"zh": "这一次没抢到。", "en": "I did not get that one."},
        {"zh": "我继续找下一粒。", "en": "I look for the next crumb."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水面动了一动。", "en": "The surface moved."},
        {"zh": "我转向那边去。", "en": "I turn that way."},
        {"zh": "同伴也看见了。", "en": "My shoalmates saw it too."},
        {"zh": "我锁定了那点碎屑。", "en": "I fix on those crumbs."},
        {"zh": "我伏下去更低。", "en": "I settle still lower."},
        {"zh": "我先冲了一步。", "en": "I dash once first."},
        {"zh": "它就在我正上方。", "en": "It is right above me."},
        {"zh": "我再凑上去些。", "en": "I come a shade nearer."},
        {"zh": "水草遮着我。", "en": "The weed covers me."},
        {"zh": "就看这一下了。", "en": "It comes down to this."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我随着它移动。", "en": "I move along with it."},
        {"zh": "它一动，我就追。", "en": "When it moves, I chase."},
        {"zh": "同伴在我后头。", "en": "My shoal is behind me."},
        {"zh": "我换个角度上去。", "en": "I come at it from another angle."},
        {"zh": "它驻足，我也驻足。", "en": "It halts and I halt."},
        {"zh": "我把尾巴放低。", "en": "I lower my tail."},
        {"zh": "水面晃得看不清。", "en": "The surface shifts too much to see."},
        {"zh": "它已经离水草远了。", "en": "It is well away from the weed."},
        {"zh": "我一点一点往上升。", "en": "I rise a little at a time."},
        {"zh": "一有机会我就冲。", "en": "At the first chance I dash."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿脑袋撞。", "en": "I butt with my head."},
        {"zh": "我开咬。", "en": "I take a bite."},
        {"zh": "我甩着尾巴打它。", "en": "I whip it with my tail."},
        {"zh": "这一下轻飘飘的。", "en": "That one barely touched."},
        {"zh": "它一挣我就跑了。", "en": "It wriggles and I flee."},
        {"zh": "我绕回来又咬。", "en": "I come back and bite again."},
        {"zh": "水搅得一片乱。", "en": "The water churns."},
        {"zh": "我退进鱼群里。", "en": "I retreat into the shoal."},
        {"zh": "力气还差得远。", "en": "My strength falls far short."},
        {"zh": "我缩进水草。", "en": "I shrink into the weed."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水草里出现了。", "en": "I appear among the weed."},
        {"zh": "身边立刻围上一群。", "en": "A shoal gathers around me at once."},
        {"zh": "这里水草很密。", "en": "The weed is thick here."},
        {"zh": "水很暖，我喜欢。", "en": "The water is warm; I like it."},
        {"zh": "我先游了一圈。", "en": "I swim one circle first."},
        {"zh": "水面上的光晃眼。", "en": "The light on the surface is bright."},
        {"zh": "我躲进叶影。", "en": "I duck into the leaf shadow."},
        {"zh": "我试着冲了一下。", "en": "I try a quick dash."},
        {"zh": "我靠向同伴那边。", "en": "I draw toward my shoal."},
        {"zh": "此处有吃食。", "en": "There is food here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水热了，我往下钻。", "en": "The water heats and I dive."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉在泥上，扑腾了两下。", "en": "I fall on the mud and flap twice."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "气不够，我拼命摆尾。", "en": "Not enough air and I thrash my tail."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸响掀起水来，我翻了身。", "en": "The blast heaves the water and rolls me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西擦过我的尾。", "en": "Something grazes my tail."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "凉意在水里把我裹起来。", "en": "Chill wraps me up in the water."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "水里没吃的，我越来越虚。", "en": "No food and I grow weaker."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺水进来，我整条一颤。", "en": "Lightning comes through the water and my whole body jerks."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有水也没有底，我一直往下落。", "en": "No water and no bottom; I keep falling."}
      ]
    }
  }
}
