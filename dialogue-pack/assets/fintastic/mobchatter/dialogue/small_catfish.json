{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿泥底一路游", "en": "I cruise along the bottom."},
        {"zh": "沼泽的水很浑，正合适", "en": "Swamp water's murky; just right."},
        {"zh": "我的胡须探着路", "en": "My barbels feel the way."},
        {"zh": "我们一群三五条也有八条", "en": "A school can be three to eight."},
        {"zh": "我用胸鳍拨开烂叶", "en": "I fan away rotting leaves."},
        {"zh": "浑水里我活得最自在", "en": "I thrive best in murk."},
        {"zh": "我摆尾摆得很慢", "en": "I beat my tail slowly."},
        {"zh": "我的头比身子还宽", "en": "My head is wider than my body."},
        {"zh": "泥里有东西在动", "en": "Something moves in the mud."},
        {"zh": "丛林的水沟我也去", "en": "I go into jungle ditches too."},
        {"zh": "我钻进水草根里", "en": "I slip among the roots."},
        {"zh": "胡须碰到了石头", "en": "My barbel touched a stone."},
        {"zh": "这一带水浅泥多", "en": "Shallow here, lots of mud."},
        {"zh": "我一路拱着泥走", "en": "I root through the mud as I go."},
        {"zh": "水里看不见我很正常", "en": "It's normal that you can't see me."},
        {"zh": "我游过一段腐木", "en": "I swim past a rotten log."},
        {"zh": "我在水底找东西吃", "en": "I forage along the bottom."},
        {"zh": "泥水上头还浮着一层雾", "en": "A layer of mist still floats over the mud"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在泥上，一动不动", "en": "I settle on the mud, still."},
        {"zh": "胡须还在探着", "en": "My barbels still probe."},
        {"zh": "水很浑，我不介意", "en": "The water's murky; I don't mind."},
        {"zh": "我张着嘴等东西进来", "en": "I hold my mouth open, waiting."},
        {"zh": "沼泽的夜里更热闹", "en": "The swamp is busier at night."},
        {"zh": "我的鳍上有花纹", "en": "My fins have markings."},
        {"zh": "我们一群都沉在底下", "en": "The whole school rests on the bottom."},
        {"zh": "水面上的光对我没用", "en": "Surface light means nothing to me."},
        {"zh": "泥里比较安全", "en": "The mud is safer."},
        {"zh": "我翻了一下身子", "en": "I rolled over once."},
        {"zh": "水草擦着我的背", "en": "Weeds brush my back."},
        {"zh": "我不需要游得很快", "en": "I needn't swim fast."},
        {"zh": "这里的水一直是这个味", "en": "The water always tastes like this."},
        {"zh": "我在等泥里的动静", "en": "I wait for movement in the mud."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在岸上，我在泥里", "en": "You're on the bank; I'm in the mud."},
        {"zh": "你的脚步把水搅浑了", "en": "Your steps clouded the water."},
        {"zh": "胡须已经感觉到你了", "en": "My barbels already sense you."},
        {"zh": "你手里那个桶我见过", "en": "I've seen that bucket before."},
        {"zh": "装进去就出不来吧", "en": "Once inside, you don't come out."},
        {"zh": "我不太会逃跑", "en": "I'm not much of a runner."},
        {"zh": "我只会往泥里钻", "en": "I only burrow into mud."},
        {"zh": "你的影子已经压到水面了", "en": "Your shadow already lies on the water"},
        {"zh": "我这一群都在底下", "en": "My school is all down here."},
        {"zh": "你要捞哪一条", "en": "Which one are you scooping?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我钻进了泥里", "en": "I burrowed into the mud."},
        {"zh": "鳍被划了一下", "en": "A fin got nicked."},
        {"zh": "泥一下子翻起来", "en": "The mud churned up."},
        {"zh": "身上全是泥，看不出伤", "en": "I'm all mud; can't see the wound."},
        {"zh": "群散了一下又聚起来", "en": "The school scattered, then regrouped."},
        {"zh": "胡须断了一根", "en": "One barbel broke."},
        {"zh": "这点伤，还能潜", "en": "I can still dive with this."},
        {"zh": "我吐出一点泥", "en": "I spat out some mud."},
        {"zh": "血在水里散得很快", "en": "Blood spreads fast in water."},
        {"zh": "我不想游得太远", "en": "I don't want to swim far."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "泥里的东西才合我胃口", "en": "Things in the mud suit me."},
        {"zh": "你放的东西太干净", "en": "What you offer is too clean."},
        {"zh": "扔到泥里我再吃", "en": "Drop it in the mud first."},
        {"zh": "岸上丢的东西我不吃", "en": "I don't eat what's dropped ashore."},
        {"zh": "这味儿不像沼泽里的东西", "en": "This smell isn't from the swamp"},
        {"zh": "你把手伸下来我就躲", "en": "Reach down and I'll hide."},
        {"zh": "水底的虫子更好", "en": "Bottom bugs are better."},
        {"zh": "这一点也许可以尝", "en": "This much I might taste."},
        {"zh": "你把桶拿远一些", "en": "Take the bucket away."},
        {"zh": "浑水里的东西我看不清", "en": "I can't see things in muddy water."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩进泥里碰到我了", "en": "You stepped in the mud and hit me."},
        {"zh": "我一下子就钻进泥", "en": "I burrowed in at once."},
        {"zh": "我很滑，抓不住", "en": "I'm slippery; you can't grip me."},
        {"zh": "群被我撞散了", "en": "I scattered the school."},
        {"zh": "泥一下就浑了", "en": "The mud clouded up."},
        {"zh": "我撞你一下，很轻", "en": "My bump is light."},
        {"zh": "水里我比岸上灵活", "en": "I'm nimbler in water."},
        {"zh": "你手一伸我就退", "en": "You reach; I retreat."},
        {"zh": "这点磕碰很平常", "en": "That knock is ordinary."},
        {"zh": "别往泥里面踩", "en": "Don't step in the mud."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "水里没那么多讲究", "en": "The water isn't so particular."},
        {"zh": "我们只管成群", "en": "We just school up."},
        {"zh": "泥底就够安静了", "en": "The muddy bottom is quiet enough."},
        {"zh": "这片水域的鱼都熟", "en": "The fish here all know each other."},
        {"zh": "别看我，我不是那种鱼", "en": "Don't look at me; I'm not that fish."},
        {"zh": "跟着群走就对了", "en": "Just follow the school."},
        {"zh": "水草后面很合适", "en": "Behind the weeds is fine."},
        {"zh": "别把水搅起来", "en": "Don't stir the water."},
        {"zh": "我们慢慢来吧", "en": "Slowly."},
        {"zh": "一起沉到泥上", "en": "Let's settle on the mud."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "泥里有点东西", "en": "Something in the mud."},
        {"zh": "我用嘴吸了一口", "en": "I suck it in."},
        {"zh": "胡须先碰到了", "en": "My barbel found it first."},
        {"zh": "烂叶子我也吃", "en": "Rotten leaves too."},
        {"zh": "这点东西够一口", "en": "Enough for one bite."},
        {"zh": "泥一翻，东西就没了", "en": "The mud swallowed it."},
        {"zh": "我从泥里挪到它边上", "en": "I shift through the mud to its side"},
        {"zh": "水底的碎屑我都收", "en": "I take scraps from the bottom."},
        {"zh": "你丢下的我不动", "en": "I leave what you drop alone."},
        {"zh": "我一张嘴就把它吞了", "en": "I open my mouth and swallow it whole"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩在我头上", "en": "You stepped on my head."},
        {"zh": "我身上长着刺", "en": "I have spines."},
        {"zh": "我不大，但我们一群多", "en": "I'm small, but there are many of us."},
        {"zh": "泥里我最灵活", "en": "I'm fastest in the mud."},
        {"zh": "你脚底下都是泥", "en": "It's all mud under your feet."},
        {"zh": "你一挪就陷进去", "en": "Move and you sink in."},
        {"zh": "我专门咬你脚踝", "en": "The ankle is what I target."},
        {"zh": "泥会把你拖住", "en": "The mud will drag you."},
        {"zh": "我们围着你打转", "en": "We circle you."},
        {"zh": "你抬脚时最好咬", "en": "Best to bite when you lift a foot."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在泥里散开", "en": "We spread out in the mud."},
        {"zh": "你看不见我们", "en": "You can't see us."},
        {"zh": "水一浑你就没办法", "en": "Once it's murky, you're helpless."},
        {"zh": "胡须在找你的腿", "en": "My barbels seek your legs."},
        {"zh": "泥底比水面安全", "en": "The bottom's safer than the surface."},
        {"zh": "你站的地方在往下塌", "en": "The ground under you is giving way."},
        {"zh": "我们用不着快", "en": "We needn't be fast."},
        {"zh": "你自己会陷下去", "en": "You'll sink on your own."},
        {"zh": "等我贴到你的脚边", "en": "Let me slide up to your feet"},
        {"zh": "泥会把声音盖住", "en": "The mud muffles sound."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住你的小腿", "en": "I clamp your shin."},
        {"zh": "背鳍划了过去", "en": "My dorsal fin rakes past."},
        {"zh": "我从泥里冲了出来", "en": "I burst out of the mud."},
        {"zh": "这一下太滑了", "en": "This one slips off."},
        {"zh": "你一脚踩空了", "en": "You missed your footing."},
        {"zh": "好几条一起撞过来", "en": "Several ram at once."},
        {"zh": "泥糊住了你的腿", "en": "Mud coats your legs."},
        {"zh": "你拔不出脚来", "en": "You can't pull your foot free."},
        {"zh": "我再咬你一口", "en": "One more bite."},
        {"zh": "咬完就缩回泥底下", "en": "I bite, then sink back under the mud"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "泥底动了一下", "en": "The bottom stirred."},
        {"zh": "一群小的游了过来", "en": "A small school drifted in."},
        {"zh": "水变得更浑了", "en": "The water got murkier."},
        {"zh": "沼泽的老住户到了", "en": "The swamp's old residents arrived."},
        {"zh": "胡须先探了出来", "en": "My barbels came out first."},
        {"zh": "我们从丛林水沟那边来", "en": "We came from the jungle ditch."},
        {"zh": "水面一点波纹都没有", "en": "Not a ripple on the surface."},
        {"zh": "我们沉在底下", "en": "We rest on the bottom."},
        {"zh": "泥里多了一片影子", "en": "More shadows in the mud."},
        {"zh": "别一脚踩进来", "en": "Don't step in."}
      ]
    },
