{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我横在路上，一步也不挪", "en": "I lie across the road and don't shift"},
        {"zh": "有人把我从绞盘上推了过来", "en": "Someone winched me across"},
        {"zh": "我的木条碾过碎石", "en": "My planks grind over the gravel"},
        {"zh": "我缓慢地移动了一尺", "en": "I move a slow foot"},
        {"zh": "铁铰链在我身上响", "en": "Iron hinges sound on me"},
        {"zh": "我朝着缺口那边去", "en": "I head for the gap"},
        {"zh": "我的底边刮着地面", "en": "My bottom edge scrapes the ground"},
        {"zh": "我一块板一块板地挪", "en": "I shift one board at a time"},
        {"zh": "我被推着，转了个方向", "en": "I'm pushed into a new line"},
        {"zh": "我挡在哪，哪就是路", "en": "Where I stand, that's the road"},
        {"zh": "我身上的铁钉跟着晃", "en": "The nails in me rattle"},
        {"zh": "我重新回到石槽里", "en": "I settle back into the stone groove"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立着，木头在晒", "en": "I stand, my wood in the sun"},
        {"zh": "风从我的板缝间穿过", "en": "Wind passes between my boards"},
        {"zh": "我的铰链上有一点锈", "en": "There's a little rust on my hinges"},
        {"zh": "我在等一只手来推", "en": "I wait for a hand to push"},
        {"zh": "我的影子横在路上", "en": "My shadow lies across the road"},
        {"zh": "木纹里有很旧的年轮", "en": "The grain holds old rings"},
        {"zh": "我被人刻了几个记号", "en": "Someone has carved marks into me"},
        {"zh": "我这边是里面，那边是外面", "en": "This side is in; that side is out"},
        {"zh": "我这里挡着风", "en": "I keep the wind out here"},
        {"zh": "我没有别的想做的事", "en": "There's nothing else I want to do"},
        {"zh": "夜里我响得更大声", "en": "At night I creak louder"},
        {"zh": "我在等一个主人", "en": "I wait for an owner"},
        {"zh": "雨把我泡得更沉", "en": "Rain makes me heavier"},
        {"zh": "我没有钥匙孔", "en": "I have no keyhole"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我这一边", "en": "You're standing on my side"},
        {"zh": "你推了推我，我没有动", "en": "You pushed, and I didn't move"},
        {"zh": "我的手就在你面前", "en": "My handle is right in front of you"},
        {"zh": "你得先占下我", "en": "You'd have to claim me first"},
        {"zh": "我认旗子，不认人", "en": "I answer to a banner, not a face"},
        {"zh": "我认旗子，不认人。", "en": "I answer to a banner, not a person."},
        {"zh": "我的门轴在响，你听见了", "en": "My pivot creaks; you heard it"},
        {"zh": "你是要过去吗", "en": "Do you mean to get through"},
        {"zh": "我关得比你想的严", "en": "I close tighter than you think"},
        {"zh": "你敲我，我就响", "en": "Knock and I ring"},
        {"zh": "我这边有钉，别靠太近", "en": "There are nails on this side; mind yourself"},
        {"zh": "你的手放在我的横木上", "en": "Your hand is on my crossbeam"},
        {"zh": "我想被谁推开", "en": "I want someone to push me open"},
        {"zh": "你退后，我就静下来", "en": "Step back and I'll go quiet"},
        {"zh": "我是一扇门，不是墙", "en": "I'm a gate, not a wall"},
        {"zh": "我在等你决定", "en": "I wait for your decision"},
        {"zh": "你能听见木头里的声音吗", "en": "Can you hear the sound in the wood"},
        {"zh": "我这边挡风，那边通着路", "en": "This side blocks wind; that leads out"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我响了一声，很闷", "en": "I give a dull knock"},
        {"zh": "我的板缝里掉出木屑", "en": "Sawdust falls from my seams"},
        {"zh": "我歪了一点点", "en": "I've leaned a little"},
        {"zh": "铰链咬着，没松", "en": "The hinge bites and holds"},
        {"zh": "我被撞得往回退了半寸", "en": "I'm knocked back half an inch"},
        {"zh": "我身上的钉子松了一颗", "en": "One nail works loose"},
        {"zh": "我没有嘴，只能响", "en": "I have no mouth; I can only creak"},
        {"zh": "我慢慢地正回来", "en": "I slowly straighten"},
        {"zh": "这一点伤不算什么", "en": "This damage is nothing"},
        {"zh": "我还立在这里", "en": "I'm still standing here"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那面旗子挂得很近", "en": "That banner hangs close"},
        {"zh": "你要是把它插上来", "en": "If you planted it"},
        {"zh": "这扇门就归你了", "en": "Then this gate is yours"},
        {"zh": "铰链上点油吧", "en": "Oil the hinges"},
        {"zh": "这个声音我听得出来", "en": "I know that sound"},
        {"zh": "有人往槽里塞了石头", "en": "Someone has wedged a stone in my groove"},
        {"zh": "你把石头拿出来", "en": "Take the stone out"},
        {"zh": "那我就能动了", "en": "Then I can move"},
        {"zh": "门闩已经松了", "en": "The bar has worked loose"},
        {"zh": "你再推一下就成", "en": "One more push will do"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上来，我连缝都没松", "en": "You hit me and not a joint gives"},
        {"zh": "你的肩撞得我响了一声", "en": "Your shoulder makes me ring"},
        {"zh": "我被撞得退了一寸", "en": "The impact shifts me an inch"},
        {"zh": "你从我下面钻过去", "en": "You duck under my bottom edge"},
        {"zh": "我的板子硌了你一下", "en": "My boards knock you"},
        {"zh": "我们一起挤在门框里", "en": "We crowd the same frame"},
        {"zh": "铰链咬着，我歪了一点", "en": "The hinge bites and I lean"},
        {"zh": "你从我旁边绕过去", "en": "You go around my side"},
        {"zh": "我被推得卡住了", "en": "I'm shoved and jammed"},
        {"zh": "这一下把门轴崩松了", "en": "That loosened my pivot"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一扇门在我旁边立着", "en": "Another gate stands beside me"},
        {"zh": "我们对着，中间是一条路", "en": "We face each other across the road"},
        {"zh": "它的铁件比我的新", "en": "Its ironwork is newer than mine"},
        {"zh": "我们一起关上了", "en": "We close together"},
        {"zh": "两扇门合成一道墙", "en": "Two gates make a wall"},
        {"zh": "铰链声叠在一起", "en": "Our hinges sound as one"},
        {"zh": "我们朝同一个方向转", "en": "We swing the same way"},
        {"zh": "中间没有缝了", "en": "There's no gap left"},
        {"zh": "这条路以后归两边", "en": "This road now belongs to both sides"},
        {"zh": "我们一起等人来开", "en": "We wait for someone to open us"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "有人把我身上的钉子拔了", "en": "Someone pulled a nail from me"},
        {"zh": "我把那块木头夹住了", "en": "I've caught that piece of wood"},
        {"zh": "它卡在我的缝里", "en": "It's wedged in my gap"},
        {"zh": "我把它推到了另一边", "en": "I pushed it to the other side"},
        {"zh": "有人在我身上刻了字", "en": "Someone carved letters into me"},
        {"zh": "我把这个印子留着", "en": "I'll keep this mark"},
        {"zh": "谁在上面拴了绳子", "en": "Someone tied a rope to me"},
        {"zh": "我拉了一下，绳子绷紧了", "en": "I strained and the rope went taut"},
        {"zh": "这块木头我留着没用", "en": "This scrap is no use to me"},
        {"zh": "它掉在我的脚下", "en": "It fell at my foot"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人拿着斧头过来了", "en": "Someone's coming with an axe"},
        {"zh": "我可不待见那件东西", "en": "I don't care for that thing"},
        {"zh": "我立得更直了", "en": "I stand straighter"},
        {"zh": "我挡在路的正中", "en": "I take the middle of the road"},
        {"zh": "这一步我不会让", "en": "I won't give this step"},
        {"zh": "我听见木头被敲的声音", "en": "I hear wood being struck"},
        {"zh": "我身上的钉子都绷紧了", "en": "Every nail in me strains"},
        {"zh": "你要过去，先过我", "en": "To pass, you go through me"},
        {"zh": "我这边有主了", "en": "This side has an owner"},
        {"zh": "我不会自己开", "en": "I won't open on my own"},
        {"zh": "我的铰链锁住了", "en": "My hinges have locked"},
        {"zh": "你听见我响了吗", "en": "Do you hear me creak"},
        {"zh": "我在等你来推", "en": "I wait for you to push"},
        {"zh": "这一寸地是我的", "en": "This inch of ground is mine"},
        {"zh": "你还是退开吧", "en": "Better step back"},
        {"zh": "我一点也不怕斧头", "en": "I'm not the least afraid of an axe"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我横着挡在缺口上", "en": "I lie across the gap"},
        {"zh": "你从左边走，我在左边", "en": "Go left and I'm left"},
        {"zh": "你从右边绕，我还在这", "en": "Go around right and I'm still here"},
        {"zh": "我一寸一寸挪向缺口", "en": "I creep toward the gap inch by inch"},
        {"zh": "你没有钩子推不动我", "en": "Without a hook you can't move me"},
        {"zh": "我的底边陷进了土", "en": "My bottom edge has sunk into earth"},
        {"zh": "我在等你放弃", "en": "I wait for you to give up"},
        {"zh": "你敲我，我就更紧", "en": "Hit me and I wedge tighter"},
        {"zh": "我的板缝里卡着东西", "en": "Something's jammed in my boards"},
        {"zh": "你试着撬，撬不动", "en": "Try to lever me; you won't"},
        {"zh": "我听见门这边你的喘气", "en": "I hear you breathing on this side"},
        {"zh": "这一道门只有一条路", "en": "This gate has one way"},
        {"zh": "我不开，你就进不来", "en": "I stay shut, and you stay out"},
        {"zh": "天黑了，我还在", "en": "It's dark, and I'm still here"},
        {"zh": "你绕不了多远", "en": "You can't go far around"},
        {"zh": "我挡住了风，也挡住了你", "en": "I block the wind, and you"},
        {"zh": "我一点也没退", "en": "I haven't given an inch"},
        {"zh": "这门框比你结实", "en": "This frame is sturdier than you"},
        {"zh": "我在等你举起斧头", "en": "I wait for you to raise the axe"},
        {"zh": "然后我就知道你怕了", "en": "Then I'll know you're afraid"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我被推得撞向你", "en": "I'm pushed into you"},
        {"zh": "我的底边扫过你的脚", "en": "My bottom edge sweeps your feet"},
        {"zh": "这一下是铰链自己甩的", "en": "That was the hinge swinging"},
        {"zh": "你退开，我还在原地", "en": "You back off and I'm still there"},
        {"zh": "我一歪，压住你的腿", "en": "I tip and pin your leg"},
        {"zh": "木板拍在你身上", "en": "A plank slaps into you"},
        {"zh": "这一下我被撞得裂了", "en": "That split one of my boards"},
        {"zh": "我的钉子刮到你的护甲", "en": "My nails scrape your armor"},
        {"zh": "我又被推回来了", "en": "I'm shoved back again"},
        {"zh": "我们一起撞在门框上", "en": "We both hit the frame"},
        {"zh": "这一声真的很响", "en": "That was very loud"},
        {"zh": "你的手臂被夹了一下", "en": "Your arm got pinched"},
        {"zh": "我慢慢倒回原位", "en": "I settle slowly back"},
        {"zh": "我还会挡回去", "en": "I'll block again"},
        {"zh": "只要我还立着", "en": "As long as I stand"},
        {"zh": "这条路就是我的", "en": "This road is mine"},
        {"zh": "我的横木撞向你的胸口", "en": "My crossbeam swings into your chest"},
        {"zh": "你用手撑住我", "en": "You brace against me with both hands"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "路边立起了一扇木门", "en": "A wooden gate stands up by the road"},
        {"zh": "我被从土里推起来", "en": "I'm pushed up out of the earth"},
        {"zh": "我的钉子一颗颗咬进木头", "en": "Nail by nail, I take shape"},
        {"zh": "门框在我两边合上", "en": "A frame closes around me"},
        {"zh": "这里的路需要一个门", "en": "This road needs a gate"},
        {"zh": "我横过来，挡住了缺口", "en": "I swing across and close the gap"},
        {"zh": "铰链咬住，我站稳了", "en": "The hinge bites and I hold"},
        {"zh": "有人把旗子插在旁边", "en": "Someone planted a banner nearby"},
        {"zh": "木板刚钉好，门后是我的。", "en": "The planks are freshly nailed; what lies behind is mine."},
        {"zh": "我朝着路的方向", "en": "I face along the road"},
        {"zh": "我落在石槽里", "en": "I settle into the stone groove"},
        {"zh": "风吹得我晃了一下", "en": "Wind rocks me once"},
        {"zh": "我的影子盖住了路", "en": "My shadow covers the road"},
        {"zh": "我听见有人往这边走", "en": "I hear someone coming"},
        {"zh": "铰链上好了，我备着", "en": "Hinges set; I'm ready"},
        {"zh": "关上就关上吧", "en": "Closed is closed"},
        {"zh": "这里的风我挡着", "en": "I'll take the wind here"},
        {"zh": "我被推到了该在的地方", "en": "I've been pushed where I belong"}
      ]
    },
