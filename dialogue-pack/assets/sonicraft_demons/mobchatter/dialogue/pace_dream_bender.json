{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走着，脚下没有声", "en": "I walk with no sound underfoot."},
        {"zh": "我的身形有点歪", "en": "My shape leans a little."},
        {"zh": "我从走廊那头过来", "en": "I come from the far end of the hall."},
        {"zh": "我的动作不太连贯", "en": "My movements do not quite flow."},
        {"zh": "我拖着步子", "en": "I drag my steps."},
        {"zh": "我低着头走", "en": "I walk with my head down."},
        {"zh": "我从你梦的边缘走过去", "en": "I walk along the edge of your dream."},
        {"zh": "我绕过你的床", "en": "I move past your bed."},
        {"zh": "我每一步都慢半拍", "en": "Every step is half a beat late."},
        {"zh": "我的轮廓在颤", "en": "My outline shivers."},
        {"zh": "我靠近墙就走进去", "en": "I walk into the wall when I get close."},
        {"zh": "我从另一边出来", "en": "And come out the other side."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在梦的入口", "en": "I stand at the entrance to the dream."},
        {"zh": "这里的光很怪", "en": "The light is strange here."},
        {"zh": "我在看你的睡脸", "en": "I am watching you sleep."},
        {"zh": "你的梦很吵", "en": "Your dream is noisy."},
        {"zh": "我等着你睡得更深", "en": "I wait for you to sink deeper."},
        {"zh": "我听见你在说梦话", "en": "I hear you talking in your sleep."},
        {"zh": "我把手放在床边", "en": "I rest a hand by the bed."},
        {"zh": "我的眼睛没有睁开", "en": "My eyes are not open."},
        {"zh": "我在改一点点东西", "en": "I am changing a small thing."},
        {"zh": "你的呼吸慢了", "en": "Your breathing slowed."},
        {"zh": "我笑了一下", "en": "I smiled once."},
        {"zh": "墙上的影子不是你的", "en": "The shadow on the wall is not yours."},
        {"zh": "我很耐心", "en": "I am patient."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你梦见了什么", "en": "What did you dream?"},
        {"zh": "那不是我，也是我", "en": "That was not me, and it was."},
        {"zh": "你的梦我改了结尾", "en": "I changed the ending of your dream."},
        {"zh": "你还记得刚才吗", "en": "Do you remember just now?"},
        {"zh": "你醒得太早了", "en": "You woke too early."},
        {"zh": "这里不是你的房间", "en": "This is not your room."},
        {"zh": "你的心跳我数着呢", "en": "I am counting your heartbeats."},
        {"zh": "我在你的梦里待了很久", "en": "I stayed in your dream a long while."},
        {"zh": "你看见的画面都不真", "en": "None of what you saw was real."},
        {"zh": "你手在抖", "en": "Your hands are shaking."},
        {"zh": "我给你留了一条路", "en": "I left you one way."},
        {"zh": "那条路只通向我", "en": "And it leads only to me."},
        {"zh": "你别眨眼", "en": "Do not blink."},
        {"zh": "眨一次我就换位置", "en": "One blink and I move."},
        {"zh": "你的梦没有出口", "en": "Your dream has no exit."},
        {"zh": "梦境扭曲者，一直在这里。", "en": "The Dream-Bender has always been here."},
        {"zh": "你觉得这是第几层", "en": "Which layer do you think this is?"},
        {"zh": "我们还要玩一会", "en": "We still have a while to play."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你竟然能碰到我", "en": "You can actually touch me."},
        {"zh": "梦里的伤，也会疼。", "en": "Even dream wounds ache."},
        {"zh": "我退到梦的边缘", "en": "I withdrew to the edge of the dream."},
        {"zh": "你的意志比我以为的强", "en": "Your will is stronger than I thought."},
        {"zh": "我改了一处，没改掉", "en": "I changed one thing and it did not take."},
        {"zh": "你还在梦里，别高兴", "en": "You are still in the dream, do not celebrate."},
        {"zh": "我笑得更明显了", "en": "My smile widened."},
        {"zh": "这一点疼可以接受", "en": "That pain is tolerable."},
        {"zh": "我们继续", "en": "Let us continue."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西在梦里会变形。", "en": "That thing will change shape in a dream."},
        {"zh": "梦里不需要食物", "en": "Dreams need no food."},
        {"zh": "你举着它像在哄我", "en": "You hold it up as if to coax me."},
        {"zh": "放下去吧", "en": "Put it down."},
        {"zh": "梦里那东西没有味道", "en": "In a dream it has no taste."},
        {"zh": "我不想吃", "en": "I do not want to eat."},
        {"zh": "我会让它变形状", "en": "I will change its shape."},
        {"zh": "你看，它变了", "en": "Look, it changed."},
        {"zh": "你更喜欢哪一个", "en": "Which do you prefer?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你没有撞到任何东西", "en": "You hit nothing at all."},
        {"zh": "我就在你手边", "en": "I am right by your hand."},
        {"zh": "你的手穿透了我的胸口", "en": "Your hand went through my chest."},
        {"zh": "你退到床边", "en": "You backed to the bed."},
        {"zh": "我挪开一点", "en": "I shifted aside."},
        {"zh": "你摸到的是梦", "en": "What you touched was the dream."},
        {"zh": "我的形状凹了一下", "en": "My shape dented."},
        {"zh": "你回头我已经在另一边", "en": "Look back and I am on the other side."},
        {"zh": "这里的东西都不太实", "en": "Nothing here is quite solid."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你还在梦里", "en": "You are still dreaming."},
        {"zh": "这不是真的", "en": "This is not real."},
        {"zh": "我可以做任何形状", "en": "I can take any shape."},
        {"zh": "但这不重要", "en": "But that does not matter."},
        {"zh": "你会醒的", "en": "You will wake up."},
        {"zh": "醒来就忘了", "en": "And forget when you do."},
        {"zh": "别怕", "en": "Do not be afraid."},
        {"zh": "梦里的东西不会留下", "en": "Dream things leave nothing behind."},
        {"zh": "你要记住哪一个", "en": "Which one will you remember?"},
        {"zh": "我在梦里，改你的记忆。", "en": "In dreams, I rewrite your memory."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它换成了别的", "en": "I replaced it with something else."},
        {"zh": "你看清了它是什么吗", "en": "Did you see what it was?"},
        {"zh": "它在你手里变轻了", "en": "It got lighter in your hand."},
        {"zh": "这不是真的东西", "en": "That is not a real thing."},
        {"zh": "你醒来它就没了", "en": "When you wake it will be gone."},
        {"zh": "我拿走了它的形状", "en": "I took its shape."},
        {"zh": "剩下的只是影子", "en": "What remains is only a shadow."},
        {"zh": "别找它了", "en": "Do not look for it."},
        {"zh": "它本来就在梦里", "en": "It was in the dream all along."},
        {"zh": "我给你留了一个", "en": "I left one for you."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那就是我要的", "en": "That is what I wanted."},
        {"zh": "你的梦开始塌", "en": "Your dream is collapsing."},
        {"zh": "别跑，跑不出去的", "en": "Do not run, there is no way out."},
        {"zh": "你看见的门都是假的", "en": "Every door you see is false."},
        {"zh": "我说了算", "en": "I decide what happens here."},
        {"zh": "这一层是我布的", "en": "I built this layer."},
        {"zh": "你只剩这点意识", "en": "All you have left is this small awareness."},
        {"zh": "我会一直等着", "en": "I will keep waiting."},
        {"zh": "你现在是我的梦了", "en": "Now you are part of my dream."},
        {"zh": "再睡回去就好", "en": "Just go back to sleep."},
        {"zh": "你还有一个选择吗", "en": "Do you still have a choice?"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在你梦里", "en": "I have been in your dream all along."},
        {"zh": "你转身的时候梦在转", "en": "When you turn, the dream turns."},
        {"zh": "走廊变得更长了", "en": "The hallway got longer."},
        {"zh": "你刚才的门不在了", "en": "The door from before is gone."},
        {"zh": "你记得自己怎么进来的吗", "en": "Do you remember how you came in?"},
        {"zh": "你现在在梦里说话", "en": "You are speaking inside a dream."},
        {"zh": "你听见的声音是我的", "en": "The voice you hear is mine."},
        {"zh": "你的手在被子外面", "en": "Your hand is outside the blanket."},
        {"zh": "这里的一切都慢", "en": "Everything here is slow."},
        {"zh": "包括你的反应", "en": "Including your reactions."},
        {"zh": "我把你的恐惧改了", "en": "I reshaped your fear."},
        {"zh": "它现在长得像我", "en": "It looks like me now."},
        {"zh": "你还在找出口", "en": "You are still looking for a way out."},
        {"zh": "出口在你睡着的地方", "en": "The exit is where you fell asleep."},
        {"zh": "你走不回去", "en": "You cannot walk back."},
        {"zh": "我看着你绕圈", "en": "I watch you circle."},
        {"zh": "这个梦境有一层是假的", "en": "One layer of this dream is false."},
        {"zh": "你猜是哪一层", "en": "Guess which one."},
        {"zh": "我就在那层里", "en": "And I am in that layer."},
        {"zh": "你还有很长一夜", "en": "You have a long night left."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我碰了你的额头", "en": "I touched your forehead."},
        {"zh": "你眼前一黑", "en": "Your sight went dark."},
        {"zh": "这一下在梦里更重", "en": "It hits harder in a dream."},
        {"zh": "你醒不过来了", "en": "You cannot wake up now."},
        {"zh": "我改了你的记忆", "en": "I edited your memory."},
        {"zh": "你刚才看见的不是真的", "en": "What you just saw was not real."},
        {"zh": "在梦里，你跑不快。", "en": "In a dream, you cannot run fast."},
        {"zh": "这里的痛是真的", "en": "The pain here is real."},
        {"zh": "你连喊都喊不出", "en": "You cannot even scream."},
        {"zh": "我还没玩够", "en": "I am not done playing."},
        {"zh": "你退到床的另一边", "en": "You are on the other side of the bed."},
        {"zh": "我走过去很慢", "en": "I come over slowly."},
        {"zh": "你的梦在帮你还是帮我", "en": "Is your dream helping you or me?"},
        {"zh": "你猜", "en": "Guess."},
        {"zh": "我看得见你的想法", "en": "I can see your thoughts."},
        {"zh": "你想的那一步，我早知道", "en": "I knew that move before you did."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "你的梦变了", "en": "Your dream changed."},
        {"zh": "我站在你睡着的地方", "en": "I stand where you fell asleep."},
        {"zh": "灯自己灭了", "en": "The lamp went out by itself."},
        {"zh": "房间的墙不太对", "en": "The walls of the room are wrong."},
        {"zh": "我带着刷怪蛋来", "en": "I came with a spawn egg."},
        {"zh": "你的意识还在路上", "en": "Your mind is still on its way."},
        {"zh": "门口多了一个影子", "en": "There is a shadow in the doorway."},
        {"zh": "我在梦的最深处", "en": "I am in the deepest part of the dream."},
        {"zh": "这里的规则是我定的", "en": "I make the rules here."},
        {"zh": "你的被子滑下来了一点", "en": "Your blanket slipped a little."},
        {"zh": "我把灯调暗", "en": "I dim the light."},
        {"zh": "你还没有察觉", "en": "You have not noticed yet."},
        {"zh": "梦境定住了，我来了。", "en": "The dream holds still; I have arrived."},
        {"zh": "你的床在往下沉", "en": "Your bed is sinking."},
        {"zh": "这一层是我给你准备的", "en": "I prepared this layer for you."},
        {"zh": "你听见风了吗，这里没有窗", "en": "Do you hear wind? There is no window."},
        {"zh": "梦境的门，开在你背后。", "en": "The dream's door opens behind you."},
        {"zh": "你终于睡熟了", "en": "You are finally deeply asleep."},
        {"zh": "梦境扭曲，我先站稳。", "en": "The dream bends; I take my footing first."}
      ]
    },
