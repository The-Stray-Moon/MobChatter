{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步走来", "en": "I come on, step by step."},
        {"zh": "我走过不留一点响", "en": "I leave no sound where I walk."},
        {"zh": "我从走廊尽头过来", "en": "I come from the hall's far end."},
        {"zh": "我像被拖过来一样前进", "en": "I advance as if dragged forward."},
        {"zh": "我绕过地上的残渣", "en": "I go around the debris."},
        {"zh": "色诺芬尼的名字，写在传说里。", "en": "Xenophanes, written in legend."},
        {"zh": "我的脚没有踩出声音", "en": "My feet make no sound at all."},
        {"zh": "我把门框挤得吱呀响", "en": "I make the doorframe creak."},
        {"zh": "我又往前迈了一程", "en": "I take another stretch forward."},
        {"zh": "我这张脸，不是给人看的。", "en": "This face of mine is not for viewing."},
        {"zh": "我走近却没有声音", "en": "I near you without a sound."},
        {"zh": "我一直朝你那边走", "en": "I keep walking your way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在那里悬着", "en": "I hang where I stand."},
        {"zh": "我抬着头不说话", "en": "I stand with my head up, silent."},
        {"zh": "我的身体在微微发光", "en": "My body glows faintly."},
        {"zh": "我一点都没动", "en": "I do not move."},
        {"zh": "我的手指轻轻动", "en": "My fingers move slightly."},
        {"zh": "我在等你先出声", "en": "I wait for you to speak first."},
        {"zh": "我的笑没有什么温度", "en": "There is no warmth in my smile."},
        {"zh": "我站着，比门框还高", "en": "I stand taller than the doorway."},
        {"zh": "我的轮廓稳得很", "en": "My outline is very steady."},
        {"zh": "我打量你手上的动作", "en": "I study what your hands do."},
        {"zh": "我又把身体立正", "en": "I straighten my body again."},
        {"zh": "我没有影子可踩", "en": "I have no shadow to tread on."},
        {"zh": "我的声音从别处来", "en": "My voice comes from elsewhere."},
        {"zh": "我的耐心很好", "en": "I am very patient."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在打量你", "en": "I have been taking your measure."},
        {"zh": "你知道我是谁", "en": "You know who I am."},
        {"zh": "我比你更早在这里", "en": "I was here before you."},
        {"zh": "我慢慢抬起眼", "en": "I raise my eyes slowly."},
        {"zh": "这个名字你听过", "en": "You have heard this name."},
        {"zh": "我没有急着动手", "en": "I am in no hurry to strike."},
        {"zh": "我把头微微偏了偏", "en": "I cant my head slightly."},
        {"zh": "你的声音有点抖", "en": "Your voice is a little unsteady."},
        {"zh": "我完全可以等", "en": "I can wait."},
        {"zh": "你的影子比你诚实", "en": "Your shadow is more honest than you."},
        {"zh": "我轻轻笑了笑", "en": "I smile once."},
        {"zh": "我停在两步之外看你", "en": "I stop two paces away and watch."},
        {"zh": "我先给你开口的机会", "en": "I give you the first word."},
        {"zh": "我这一圈只在夜里转。", "en": "I only circle when night falls."},
        {"zh": "我低头看你的眼睛", "en": "I lower my head to your eyes."},
        {"zh": "我看得比你想的清楚", "en": "I see more than you think."},
        {"zh": "我们不必绕圈子", "en": "We need not talk in circles."},
        {"zh": "我的名字，你念不对。", "en": "You cannot pronounce my name right."},
        {"zh": "我把目光收回来", "en": "I draw my gaze back."},
        {"zh": "你说的每个字我都听见", "en": "I heard every word you said."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了一步的距离", "en": "I give a step of ground."},
        {"zh": "我的轮廓晃了晃", "en": "My outline wavers."},
        {"zh": "我把悬着的手放下", "en": "I lower the hand I was holding up."},
        {"zh": "我静得没有一点响", "en": "I stay utterly silent."},
        {"zh": "这具身体有些吃不消", "en": "This body is taking damage."},
        {"zh": "我重新站得稳", "en": "I plant myself again."},
        {"zh": "我把眼重新抬起来", "en": "I lift my eyes again."},
        {"zh": "我嘴角抬了一下", "en": "The corner of my mouth lifts."},
        {"zh": "我仍旧在原地", "en": "I am still here."},
        {"zh": "这点伤连声音都没有", "en": "That wound didn't even make a sound."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你要拿这个收买我", "en": "You mean to buy me with this?"},
        {"zh": "这实在太轻了", "en": "Too light."},
        {"zh": "我抬了抬手指", "en": "I lift a finger."},
        {"zh": "它自己飘了起来", "en": "It rises by itself."},
        {"zh": "我又让它落回去", "en": "I let it drop back."},
        {"zh": "食物对我已经没用了", "en": "Food means nothing to me now."},
        {"zh": "你举得太久了，放下吧", "en": "You've held it too long; put it down."},
        {"zh": "你还是换一样吧", "en": "Try something else."},
        {"zh": "你手里的诱饵太小了", "en": "The bait in your hand is too small."},
        {"zh": "你手里的东西太轻了", "en": "What you hold weighs nothing to me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞进我的气场", "en": "You blunder into my aura."},
        {"zh": "你穿过我，又退回来打颤。", "en": "You pass through me, then step back shivering."},
        {"zh": "你被弹开一点。", "en": "You get knocked back a little."},
        {"zh": "我的身体比你稳", "en": "My body is steadier than yours."},
        {"zh": "我把身形慢慢转向你", "en": "I turn my form slowly to you."},
        {"zh": "空气冷了一下", "en": "The air chills for a moment."},
        {"zh": "我压根没有任何痛感", "en": "I register no pain at all."},
        {"zh": "你的手陷进我的身体里", "en": "Your hand sinks into my body."},
        {"zh": "我还是站在这里", "en": "I am still standing here."},
        {"zh": "你退开也没用", "en": "Backing off will not help."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一个从阴影里出现", "en": "Another appears from the shadow."},
        {"zh": "我们两个一齐立着", "en": "The two of us stand as one."},
        {"zh": "它比我更沉默", "en": "It is quieter than I."},
        {"zh": "我们一起看向你", "en": "We both look at you."},
        {"zh": "我们的气场叠在一起", "en": "Our auras overlap."},
        {"zh": "我们一起抬手", "en": "We raise our hands together."},
        {"zh": "我们两个都默不作声", "en": "Both of us stay silent."},
        {"zh": "它先一步开口", "en": "It speaks first."},
        {"zh": "我跟着说了一句", "en": "I answer with one line."},
        {"zh": "我们已经在这里很久了", "en": "We have been here a long while."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬手把它吸过来", "en": "I draw it up with a gesture."},
        {"zh": "它停在我掌心上方", "en": "It halts above my palm."},
        {"zh": "我把它在手里转了转", "en": "I turn it over."},
        {"zh": "我让它浮在那里", "en": "I leave it floating."},
        {"zh": "我让它落回原处", "en": "I let it settle back."},
        {"zh": "它一下碎成了灰", "en": "It crumbles to ash."},
        {"zh": "我看了看碎片", "en": "I look at the pieces."},
        {"zh": "我一口气吹散灰", "en": "I blow the ash away."},
        {"zh": "我不再理会它了", "en": "I leave it be."},
        {"zh": "我在你脚边，等你低头。", "en": "At your feet, waiting for you to look down."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我现在就过来", "en": "I'm coming over now."},
        {"zh": "我把脸摆正对着你", "en": "I square my face to yours."},
        {"zh": "我的手抬到胸前", "en": "I bring a hand to my chest."},
        {"zh": "空气压了下来", "en": "The air comes down heavy."},
        {"zh": "这块地现在归我走", "en": "This ground is mine to walk now."},
        {"zh": "我把一只手缓缓抬起", "en": "I raise one hand slowly."},
        {"zh": "这具身体该活动了", "en": "This body should move."},
        {"zh": "我不着急，但你跑不掉", "en": "No hurry, but you cannot run."},
        {"zh": "我把笑收起来", "en": "I put the smile away."},
        {"zh": "现在才是正事", "en": "Now the real matter begins."},
        {"zh": "我往前迈半格", "en": "I take half a step forward."},
        {"zh": "我的手已经伸到你面前", "en": "My hand is already before your face."},
        {"zh": "我抬手的同时风停了", "en": "The wind stops as my hand lifts."},
        {"zh": "那声音你也听见了吧", "en": "You heard it too, did you not?"},
        {"zh": "我让你先出手", "en": "I let you move first."},
        {"zh": "这一步之后就不回头了", "en": "After this step there is no turning back."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直跟着你走", "en": "I follow your movement."},
        {"zh": "你往哪我都在你侧后", "en": "I stay at your rear flank."},
        {"zh": "我没打算立刻动手", "en": "I do not mean to strike at once."},
        {"zh": "我在看你的破绽", "en": "I am reading your gaps."},
        {"zh": "你的重心很轻", "en": "Your balance is light."},
        {"zh": "我只需要一个角度", "en": "I need only one angle."},
        {"zh": "空气里的声音都被吸走了", "en": "The air swallows all sound."},
        {"zh": "你听见自己的脚步了", "en": "You can hear your own footsteps."},
        {"zh": "我那只手悬着没收", "en": "My hand hangs there, unlowered."},
        {"zh": "我的手指已经碰到你的肩", "en": "My fingers have found your shoulder."},
        {"zh": "这个位置我很满意", "en": "This position suits me."},
        {"zh": "你退开我就绕", "en": "You retreat; I circle."},
        {"zh": "我把你圈在中间", "en": "I have circled you in."},
        {"zh": "我周围的风都停了", "en": "The wind has died all around me."},
        {"zh": "你每动一次我就进一步", "en": "Each time you move, I take a step."},
        {"zh": "你不吸气我也知道你在", "en": "I know you're there without your breath."},
        {"zh": "我半点也不催自己", "en": "I do not hurry myself at all."},
        {"zh": "我随时可以收网", "en": "I could close the net any time."},
        {"zh": "你摸到的东西没有用", "en": "Whatever you grab won't help."},
        {"zh": "我等你拔出来", "en": "I will wait for you to draw it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一抬手把它扫飞", "en": "One gesture and it is swept away."},
        {"zh": "我伸手拍在你的胸口", "en": "My palm strikes your chest."},
        {"zh": "我用手臂把你撞开", "en": "My arm knocks you aside."},
        {"zh": "你被弹到了墙上", "en": "You are thrown into the wall."},
        {"zh": "我的手指划过空气", "en": "My fingers cut the air."},
        {"zh": "空气炸开了一道口", "en": "The air splits open."},
        {"zh": "我扣住你的手腕，往下压。", "en": "I grip your wrist and press down."},
        {"zh": "我把你甩了出去", "en": "I fling you away."},
        {"zh": "我抬手挡下你的攻击", "en": "I raise a hand and block."},
        {"zh": "我的手穿过了你的胸口", "en": "My hand passes through your chest."},
        {"zh": "我把你按进地里一半", "en": "I push you halfway into the ground."},
        {"zh": "陌生的名字，一样能伸手。", "en": "An unfamiliar name can still reach out."},
        {"zh": "你的武器一脱手，我就近了。", "en": "The moment your weapon slips, I am closer."},
        {"zh": "我松开手，你自己倒", "en": "I let go; you fall on your own."},
        {"zh": "我收回手，上面有你的血", "en": "I pull back my hand; your blood is on it."},
        {"zh": "这一下只是打招呼", "en": "That one was only a greeting."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从阴影里显形", "en": "I take shape out of the shadow."},
        {"zh": "屋里先暗下来，然后是我", "en": "The room darkens first, then I come."},
        {"zh": "空气安静下来", "en": "The air goes quiet."},
        {"zh": "我站在那个位置", "en": "I stand in that spot."},
        {"zh": "影子落地时，我已在你旁边。", "en": "When my shadow lands, I'm already beside you."},
        {"zh": "我不急不缓地出现", "en": "I appear without hurry."},
        {"zh": "你听见了什么声音", "en": "Did you hear something?"},
        {"zh": "那个声音，就是我。", "en": "That sound, it is me."},
        {"zh": "我把两只手都垂着", "en": "I let both hands hang."},
        {"zh": "我看了看这个地方", "en": "I look over this place."},
        {"zh": "我的身形很稳", "en": "My form is steady."},
        {"zh": "四周的声音少了", "en": "The sounds around us thin."},
        {"zh": "我把头从阴影里抬起", "en": "I raise my head out of the shadow."},
        {"zh": "我在这里站了一会儿了", "en": "I have stood here a while."},
        {"zh": "我们该好好谈谈", "en": "We should talk."},
        {"zh": "我先一步开口", "en": "I speak first."},
        {"zh": "我的声音从你背后传来", "en": "My voice comes from behind you."},
        {"zh": "你没有回过头", "en": "You do not look back."},
        {"zh": "我的笑意很淡", "en": "My smile is faint."},
        {"zh": "这一局我等你先动", "en": "This round I let you move first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰绕开我的身体", "en": "The flames bend around my body."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从上方落了下来", "en": "I come down from above."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水也拦不住我", "en": "Water cannot hold me either."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我推开了几步", "en": "The blast pushes me several steps."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿进我的肩", "en": "Something enters my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光和我相撞", "en": "Spell light collides with me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，但我弱了", "en": "I do not eat, yet I weaken."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光认出了我", "en": "The lightning recognises me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空也吞不下我", "en": "The void cannot swallow me either."}
      ]
    }
  }
}
