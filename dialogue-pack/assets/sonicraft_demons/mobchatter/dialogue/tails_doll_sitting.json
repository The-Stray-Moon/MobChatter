      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光照得看台的灰都飘起来。", "en": "This light lifts dust off the stands."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，什么也不吃。", "en": "Seated, I eat nothing."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电把整排椅子照亮。", "en": "Lightning lights the whole row."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面没有椅子。", "en": "There is no chair below."}
      ]
    }
  }
