{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，忽然站起来挪一步。", "en": "I was sitting, and now I shuffle one step."},
        {"zh": "站起来的时候，关节一格一格响。", "en": "As I rise, my joints click, notch by notch."},
        {"zh": "我的腿很短，步子也短。", "en": "Short legs, short steps."},
        {"zh": "我从台阶上慢慢下来。", "en": "I come slowly down the step."},
        {"zh": "我歪着头，往前挪。", "en": "Head tilted, I shuffle forward."},
        {"zh": "衣服的下摆拖着地。", "en": "My hem drags on the floor."},
        {"zh": "我每走一步都停一下。", "en": "I pause after every step."},
        {"zh": "我慢慢朝舞台边上走。", "en": "I walk slowly toward the stage edge."},
        {"zh": "我用脚尖先着地。", "en": "I land toe-first."},
        {"zh": "我一边走一边看椅子。", "en": "I look at the seats as I go."},
        {"zh": "我的影子在墙上跟着。", "en": "My shadow follows on the wall."},
        {"zh": "我又停下来，坐回去。", "en": "I stop again and sit back down."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，手放在膝上。", "en": "Sitting, hands on my knees."},
        {"zh": "我的红宝石，一直亮着。", "en": "My red gem stays lit."},
        {"zh": "我一动不动，像摆好的。", "en": "Perfectly still, as if arranged."},
        {"zh": "这把椅子有点凉。", "en": "This chair is a little cold."},
        {"zh": "我看着空着的观众席。", "en": "I watch the empty seats."},
        {"zh": "我的线垂到地上。", "en": "My thread hangs to the floor."},
        {"zh": "灯光打在我脸上。", "en": "The light is on my face."},
        {"zh": "我把眼闭上又睁开。", "en": "I close my eyes and open them."},
        {"zh": "坐着的姿势不能太久。", "en": "I cannot hold this pose too long."},
        {"zh": "我的脚并在一起。", "en": "My feet are set together."},
        {"zh": "我在等演出开始。", "en": "I wait for the show to begin."},
        {"zh": "椅子响了一下。", "en": "The chair creaked."},
        {"zh": "我抬起头，又放下。", "en": "I lift my head, then lower it."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你来了，坐下吧。", "en": "You came. Sit down."},
        {"zh": "这个位置是空的。", "en": "This seat is empty."},
        {"zh": "我在这儿坐了很久。", "en": "I have sat here a long while."},
        {"zh": "你看着我的脸。", "en": "You are looking at my face."},
        {"zh": "这里没有别的观众。", "en": "There are no other guests."},
        {"zh": "你站着，我坐着。", "en": "You stand. I sit."},
        {"zh": "头顶的灯还亮着。", "en": "The lights are still on."},
        {"zh": "我在等它开场。", "en": "I am waiting for it to start."},
        {"zh": "你听见椅子响吗。", "en": "Do you hear the seats creaking?"},
        {"zh": "我这样坐着，很安静。", "en": "Sitting like this, I am quiet."},
        {"zh": "坐着的尾巴玩偶，别碰。", "en": "The sitting Tails doll. Don't touch."},
        {"zh": "我侧着脸看你。", "en": "I look at you sideways."},
        {"zh": "这排椅子，只有我。", "en": "I am the only one in this row."},
        {"zh": "你要坐到哪一排。", "en": "Which row will you take?"},
        {"zh": "我坐得比站着舒服。", "en": "I am better sitting than standing."},
        {"zh": "你踩到那根线了。", "en": "You stepped on that thread."},
        {"zh": "你再往前挪一步。", "en": "Move one step closer."},
        {"zh": "灯就这样留着吧。", "en": "Leave the lights on."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我从椅子上滑了一下。", "en": "I slipped on the chair."},
        {"zh": "布料被撕开了。", "en": "The cloth is torn."},
        {"zh": "我歪着，扶住扶手。", "en": "I tilt and grab the armrest."},
        {"zh": "我扶住扶手，布里的线断了。", "en": "I grip the armrest; a thread inside my cloth snaps."},
        {"zh": "线掉下来一截。", "en": "A length of thread fell."},
        {"zh": "我慢慢坐回去。", "en": "I settle back into the seat."},
        {"zh": "这一下打到了肩。", "en": "That landed on my shoulder."},
        {"zh": "我的头歪得更厉害。", "en": "My head tilts further."},
        {"zh": "椅子裂了一道。", "en": "The chair has cracked."},
        {"zh": "这一下我会记得。", "en": "I will remember that one."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "放在那张椅子上。", "en": "Put it on that chair."},
        {"zh": "我不站起来拿。", "en": "I will not stand to take it."},
        {"zh": "往我这边递过来。", "en": "Hand it over this way."},
        {"zh": "我这样坐着，够不到。", "en": "Sitting like this, I cannot reach."},
        {"zh": "给我，我就坐着不动。", "en": "Give it and I will stay seated."},
        {"zh": "那点东西，很亮。", "en": "That little thing is bright."},
        {"zh": "你的手稳着些。", "en": "Hold your hand steady."},
        {"zh": "往我这边送过来。", "en": "Bring it over to me."},
        {"zh": "我心里数上三下。", "en": "I count three in my head."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到椅子了。", "en": "You hit the chair."},
        {"zh": "我坐着一动没动。", "en": "I stayed seated and still."},
        {"zh": "别推这张椅子。", "en": "Do not push this chair."},
        {"zh": "碰一下没什么。", "en": "A knock or two is nothing."},
        {"zh": "我歪了一下，坐稳。", "en": "I sway, then settle."},
        {"zh": "椅子在我身下响。", "en": "The chair creaks beneath me."},
        {"zh": "站着的你比坐着的高。", "en": "Standing, you are taller."},
        {"zh": "别扯我的袖子。", "en": "Do not tug my sleeve."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着的时候不谈这个。", "en": "I do not discuss that while seated."},
        {"zh": "这具身体是摆出来的。", "en": "This body was arranged."},
        {"zh": "我只是一个姿态。", "en": "I am only a pose."},
        {"zh": "这个问题免了。", "en": "Spare me that question."},
        {"zh": "观众席空着，我只跟椅子说话。", "en": "The seats are empty; I only talk to the chair."},
        {"zh": "我不会站起来。", "en": "I am not standing up."},
        {"zh": "你认错对象了。", "en": "You have mistaken me."},
        {"zh": "我缺那副零件。", "en": "I am missing those parts."},
        {"zh": "演出要开始了。", "en": "The show is beginning."},
        {"zh": "你给我安静些。", "en": "Be quiet."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "东西滚到椅腿边，我够不着。", "en": "It rolls to the chair leg, out of my reach."},
        {"zh": "坐着的身子，慢慢弯下去。", "en": "Seated, I bend slowly forward."},
        {"zh": "坐着的姿势不方便。", "en": "This seat does not make it easy."},
        {"zh": "我用脚把它勾过来。", "en": "I hook it with my foot."},
        {"zh": "它卡在椅子缝里。", "en": "It is stuck in the seat gap."},
        {"zh": "我弯下腰，椅子吱了一声。", "en": "I bend down and the chair creaks."},
        {"zh": "这不该在这里。", "en": "This should not be here."},
        {"zh": "我坐着，等这出戏开始。", "en": "I sit and wait for the scene."},
        {"zh": "那实在太远了。", "en": "That is far too far."},
        {"zh": "你替我收着吧。", "en": "You keep it for me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我从座位上抬起头。", "en": "I look up from the seat."},
        {"zh": "我坐着，可我在看你。", "en": "I am seated, but I am watching you."},
        {"zh": "我把你记住了。", "en": "I have you noted."},
        {"zh": "观众席只有一排。", "en": "There is only one row of seats."},
        {"zh": "你的位置在我旁边。", "en": "Your seat is next to me."},
        {"zh": "我扶着椅子站起来。", "en": "I brace on the chair and stand."},
        {"zh": "灯光开始暗了。", "en": "The lights are dimming."},
        {"zh": "别朝门口走去。", "en": "Do not head for the door."},
        {"zh": "这就要开场了。", "en": "It begins."},
        {"zh": "我起来得很慢。", "en": "I rise very slowly."},
        {"zh": "你听我慢慢说。", "en": "Hear me out."},
        {"zh": "这样很不错的。", "en": "Not bad."},
        {"zh": "我把身子坐直。", "en": "I sit up straight."},
        {"zh": "你停在椅子中间。", "en": "You stopped between the seats."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，头转向你。", "en": "Seated, I turn my head to you."},
        {"zh": "我的手指在膝上敲。", "en": "My fingers tap my knee."},
        {"zh": "这里全是空的座位。", "en": "Nothing but empty seats."},
        {"zh": "站直的时候，关节在响。", "en": "Standing straight, my joints click."},
        {"zh": "时间不用着急。", "en": "There is no hurry."},
        {"zh": "灯照在你身上。", "en": "The light is on you."},
        {"zh": "我从椅子上起身，关节一格一格响。", "en": "I rise from the chair, joints clicking one by one."},
        {"zh": "你撞到一排椅子。", "en": "You bumped into a row of seats."},
        {"zh": "你别乱动弹啊。", "en": "Do not move about."},
        {"zh": "就这一拍子的。", "en": "This one beat."},
        {"zh": "手已经抬起来。", "en": "The hand comes up."},
        {"zh": "脑后别转过去。", "en": "Do not turn your head."},
        {"zh": "就在我的眼前。", "en": "Right before me."},
        {"zh": "到我跟前来了。", "en": "Almost at hand."},
        {"zh": "我一下攥住了。", "en": "I clamp down."},
        {"zh": "请你就坐下吧。", "en": "Sit down, please."},
        {"zh": "我的膝盖碰了一下前排椅背。", "en": "My knee nudged the seat ahead."},
        {"zh": "你走得比我想的慢。", "en": "You walk slower than I expected."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从座位上撞过去。", "en": "I lunge from the seat."},
        {"zh": "你被按在椅子背上。", "en": "You are pressed against the seat back."},
        {"zh": "针脚从我手里伸出来。", "en": "Stitches come out of my hand."},
        {"zh": "我推你，椅子翻了。", "en": "I shove you; the seat topples."},
        {"zh": "你退到舞台边。", "en": "You back to the stage edge."},
        {"zh": "我又坐回去了。", "en": "I sit back down."},
        {"zh": "灯亮了一瞬间。", "en": "The light flashed once."},
        {"zh": "我抬了抬这只手。", "en": "I lift this hand."},
        {"zh": "这就是那一场演出。", "en": "This is the performance."},
        {"zh": "我放开了你的手。", "en": "I let go of your hand."},
        {"zh": "这还没有完呢。", "en": "Not finished yet."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "椅子上多了一个身影。", "en": "A figure has appeared on the seat."},
        {"zh": "我本来就在这。", "en": "I was here already."},
        {"zh": "灯打亮了舞台。", "en": "The stage lights came up."},
        {"zh": "我坐着，等你走进来。", "en": "I sit, waiting for you to walk in."},
        {"zh": "椅子轻轻响了一声。", "en": "The chair creaked softly."},
        {"zh": "一排排座位没人。", "en": "The rows of seats are empty."},
        {"zh": "我的线垂下来。", "en": "My thread hangs down."},
        {"zh": "我歪着头，看向门口。", "en": "Head tilted, I look at the door."},
        {"zh": "有个人进来了。", "en": "Someone has come in."},
        {"zh": "我把脖子抬直。", "en": "I straighten my neck."},
        {"zh": "这一排只有我。", "en": "I am the only one in this row."},
        {"zh": "我的眼皮动了一下。", "en": "My eyelid twitched."},
        {"zh": "你可以坐下了。", "en": "You may sit."},
        {"zh": "现在就已经开场。", "en": "It starts now."},
        {"zh": "别站在过道上。", "en": "Do not stand in the aisle."},
        {"zh": "我坐着，一直到结束。", "en": "I will sit here until it ends."},
        {"zh": "灯是不会灭的。", "en": "The lights will not go out."},
        {"zh": "你听得见这响动吗。", "en": "Do you catch that sound?"}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "布帘一样的袖子烧起来了。", "en": "My curtain-like sleeve is burning."}
      ]
    },
