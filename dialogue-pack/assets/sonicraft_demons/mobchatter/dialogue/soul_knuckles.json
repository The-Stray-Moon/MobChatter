{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的脚不沾地。", "en": "My feet don't touch the ground."},
        {"zh": "我飘着走，拖着一点光。", "en": "I drift along with a trail of light."},
        {"zh": "我的身形时断时续。", "en": "My shape flickers."},
        {"zh": "我穿过一片草，草不动。", "en": "I cross the grass; it doesn't stir."},
        {"zh": "我朝声音的方向飘。", "en": "I drift toward the sound."},
        {"zh": "我飘过的地方，草色发灰。", "en": "The grass greys where I drift past."},
        {"zh": "我绕过一棵树，没留下痕。", "en": "I pass a tree leaving no trace."},
        {"zh": "我的脚步落在水面上，不沉。", "en": "My steps rest on water without sinking."},
        {"zh": "我离地半尺浮着。", "en": "I hover half a foot up."},
        {"zh": "我朝你的背后去。", "en": "I drift toward your back."},
        {"zh": "风一吹，我就碎成一缕。", "en": "The wind blows and I fray into a wisp."},
        {"zh": "我贴着地面浮，不惊起草。", "en": "I float low and don't startle the grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停着，光在身上流。", "en": "I stop, light flowing over me."},
        {"zh": "我的脸看不太清。", "en": "My face isn't quite clear."},
        {"zh": "我身上有碎裂的响。", "en": "A crackling sound comes from me."},
        {"zh": "我在听活人的呼吸。", "en": "I listen for living breath."},
        {"zh": "我的拳头是虚的。", "en": "My fists are hollow."},
        {"zh": "我忘了自己原来的样子。", "en": "I've forgotten my original shape."},
        {"zh": "我抬手，手指先淡掉了。", "en": "I raise a hand and my fingers fade first."},
        {"zh": "我在试着记起什么。", "en": "I'm trying to recall something."},
        {"zh": "记不起。", "en": "I can't."},
        {"zh": "光在我胸口聚了一下。", "en": "Light gathers at my chest once."},
        {"zh": "我又散开了。", "en": "And scatters again."},
        {"zh": "我不需要站着。", "en": "I needn't stand."},
        {"zh": "我这样浮着就好。", "en": "Floating like this is fine."},
        {"zh": "周围很冷。", "en": "It's cold around here."},
        {"zh": "我不太感觉得到冷。", "en": "I hardly feel the cold."},
        {"zh": "灵魂的拳头，还握着。", "en": "My spectral fists stay clenched."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看得见我吗？", "en": "Can you see me?"},
        {"zh": "我的名字现在很乱。", "en": "My name is scrambled now."},
        {"zh": "我连影子都留不下。", "en": "I can't even leave a shadow."},
        {"zh": "我靠近时，你后颈会发凉。", "en": "When I come close, your neck goes cold."},
        {"zh": "我曾经有别的样子。", "en": "I used to have another shape."},
        {"zh": "现在只剩这个。", "en": "Now only this remains."},
        {"zh": "你身上那点热，烫得我发慌。", "en": "That little heat on you makes me restless."},
        {"zh": "活人的气味，冲得我发愣。", "en": "The smell of the living stuns me."},
        {"zh": "你的呼吸让我想起什么。", "en": "Your breathing reminds me of something."},
        {"zh": "我站不到你面前。", "en": "I can't stand before you."},
        {"zh": "我只会飘。", "en": "I can only drift."},
        {"zh": "别把手往这边递。", "en": "Don't offer your hand this way."},
        {"zh": "我怕它会穿过去。", "en": "I fear it would pass through."},
        {"zh": "那就更难看了。", "en": "That would be worse."},
        {"zh": "我在此地待得太久。", "en": "I've lingered here too long."},
        {"zh": "你也留下来吧。", "en": "Stay a while too."},
        {"zh": "就一会儿。", "en": "Just a little."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我散开又聚。", "en": "I scatter and gather."},
        {"zh": "挨一下，手上就漏了光。", "en": "One hit and light leaks from my hand."},
        {"zh": "这一点不够疼。", "en": "That wasn't enough to hurt."},
        {"zh": "我早就没有肉了。", "en": "I've had no flesh for a long time."},
        {"zh": "我变得淡了一点。", "en": "I've thinned a little."},
        {"zh": "我的名字，全是乱码。", "en": "My name is all scrambled text."},
        {"zh": "我抓紧自己的形状。", "en": "I hold my shape together."},
        {"zh": "别打，会散的。", "en": "Don't hit, I'd come apart."},
        {"zh": "我还想多待一会。", "en": "I want to stay a while longer."},
        {"zh": "就一会。", "en": "Just a while."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我碰不到那个。", "en": "I can't touch that."},
        {"zh": "它掉进我里面，什么也没碰到。", "en": "It fell inside me and touched nothing."},
        {"zh": "我已经不吃东西了。", "en": "I don't eat anymore."},
        {"zh": "你举它作甚？", "en": "What are you raising that for?"},
        {"zh": "这味道我几乎忘了。", "en": "I'd almost forgotten that smell."},
        {"zh": "放那儿吧。", "en": "Leave it there."},
        {"zh": "这味道隔我一层，像隔水。", "en": "The smell is muffled, as if through water."},
        {"zh": "我只是想记起来。", "en": "I only want to remember."},
        {"zh": "别收回去。", "en": "Don't put it away."},
        {"zh": "就这样放着。", "en": "Just leave it like that."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "别从我胸口穿过去。", "en": "Don't walk straight through my chest."},
        {"zh": "撞开的口子，慢慢长回去。", "en": "The hole you knocked open slowly closes."},
        {"zh": "别对着空气挥抓。", "en": "Don't claw at empty air."},
        {"zh": "我这层寒气沾上你的袖子。", "en": "This chill of mine clings to your sleeve."},
        {"zh": "你的手会发麻。", "en": "Your hand will go numb."},
        {"zh": "我尽量让开。", "en": "I try to move aside."},
        {"zh": "这种接触我控制不了。", "en": "I can't control that kind of contact."},
        {"zh": "我又裂开了一道。", "en": "Another seam split in me."},
        {"zh": "我的形状在你身上裂开。", "en": "My shape splits open across you."},
        {"zh": "我会从你身上过去。", "en": "I'll pass through you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我连身体都没有了。", "en": "I don't even have a body."},
        {"zh": "这念头很轻，也很远。", "en": "That thought is light and far away."},
        {"zh": "我记不清了。", "en": "I can't remember clearly."},
        {"zh": "你该找活人去。", "en": "You should seek the living."},
        {"zh": "我只会散。", "en": "I only come apart."},
        {"zh": "别往我这边靠。", "en": "Don't lean toward me."},
        {"zh": "我连名字都乱了。", "en": "Even my name is scrambled."},
        {"zh": "这种话没有意义。", "en": "Such words have no meaning."},
        {"zh": "我要飘走了。", "en": "I'm drifting away."},
        {"zh": "风会带走我。", "en": "The wind will carry me off."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手是透明的，抓不住东西。", "en": "My hands are see-through; they grasp nothing."},
        {"zh": "我的手穿过去了，什么也没摸到。", "en": "My hand passed through, felt nothing."},
        {"zh": "这东西落在地上。", "en": "This lies on the ground."},
        {"zh": "拳头合拢，捞到的只是风。", "en": "I close my fists and catch only wind."},
        {"zh": "我的拳头，握不紧东西。", "en": "These fists of mine cannot hold things."},
        {"zh": "这上面有一点暖意。", "en": "There's a little warmth on it."},
        {"zh": "我碰不到暖意。", "en": "I can't touch warmth."},
        {"zh": "它在我脚下不动。", "en": "It sits at my feet, still."},
        {"zh": "我试着弯下去，散了一半。", "en": "I bend, and half of me scatters."},
        {"zh": "灵魂的拳头，握不紧东西。", "en": "A soul's fists cannot grip anything."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的呼吸在这里。", "en": "Your breath is here."},
        {"zh": "我跟着它过来。", "en": "I followed it here."},
        {"zh": "我不用走。", "en": "I needn't walk."},
        {"zh": "我一直都在你旁边。", "en": "I've been beside you all along."},
        {"zh": "我只剩一副拳头。", "en": "All I have left is a pair of fists."},
        {"zh": "现在你回头看。", "en": "Now look back."},
        {"zh": "把你的暖意留下。", "en": "Leave your warmth behind."},
        {"zh": "一小点就够。", "en": "A tiny bit suffices."},
        {"zh": "一点就够了。", "en": "A little is enough."},
        {"zh": "别走那么快。", "en": "Don't go so fast."},
        {"zh": "我跟得上。", "en": "I can keep up."},
        {"zh": "我一直在跟。", "en": "I've always kept up."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在你身后。", "en": "I hover behind you."},
        {"zh": "我的影子落在你脚上。", "en": "My shadow falls on your feet."},
        {"zh": "那片影子比周围冷。", "en": "That shadow is colder than the rest."},
        {"zh": "你的脚步慢了一点。", "en": "Your steps have slowed."},
        {"zh": "我能听见你的血。", "en": "I can hear your blood."},
        {"zh": "那声音让我想起自己。", "en": "It reminds me of myself."},
        {"zh": "你换了只手拿火把。", "en": "You switched the torch to your other hand."},
        {"zh": "你不敢回头。", "en": "You don't dare look back."},
        {"zh": "没关系。", "en": "It doesn't matter."},
        {"zh": "我不需要你看。", "en": "I don't need you to look."},
        {"zh": "我默数你的步。", "en": "I silently count your steps."},
        {"zh": "三步之后。", "en": "Three steps from now."},
        {"zh": "两步。", "en": "Two."},
        {"zh": "你数到一，我就到你肩上。", "en": "Count one, and I'm at your shoulder."},
        {"zh": "我浮到你背后，数着步。", "en": "I float behind you, counting steps."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手穿进你的胸口。", "en": "My hand passes into your chest."},
        {"zh": "你被冷得抽了一下。", "en": "The cold makes you jerk."},
        {"zh": "我抽手，光散了几点。", "en": "I pull back, shedding sparks of light."},
        {"zh": "你退了，可我不占地方。", "en": "You retreat, but I take no space."},
        {"zh": "我的拳落进你肋骨之间。", "en": "My fist sinks between your ribs."},
        {"zh": "这身铁片挡不了。", "en": "That plating won't stop it."},
        {"zh": "这股冷是从里面来的。", "en": "The cold comes from inside."},
        {"zh": "我散了一半，又聚起来。", "en": "Half of me scatters, then returns."},
        {"zh": "那声音一直在你耳边。", "en": "That sound stays at your ear."},
        {"zh": "那是我在笑。", "en": "That's me laughing."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "空气里凝出一点轮廓。", "en": "A shape thickens in the air."},
        {"zh": "我慢慢地成形。", "en": "I take form slowly."},
        {"zh": "周围忽然安静了。", "en": "Everything goes quiet."},
        {"zh": "我原先是别的东西。", "en": "I used to be something else."},
        {"zh": "现在我只是一点光。", "en": "Now I'm only a little light."},
        {"zh": "我的名字在耳边乱响。", "en": "My name rattles at my ear."},
        {"zh": "我试着抓住它。", "en": "I try to catch it."},
        {"zh": "抓不住。", "en": "I can't."},
        {"zh": "风从那边吹来。", "en": "Wind comes from over there."},
        {"zh": "我顺着风飘。", "en": "I drift with it."},
        {"zh": "地上有我淡掉的影。", "en": "A faint shadow follows me."},
        {"zh": "这条路我走过。", "en": "I've walked this way."},
        {"zh": "不记得是哪里了。", "en": "I don't remember where."},
        {"zh": "有人在这。", "en": "Someone is here."},
        {"zh": "有人在这，我闻到了热。", "en": "Someone's here. I smell the heat."},
        {"zh": "很久没有过了。", "en": "It's been a long while."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火穿过我，什么都没烧到。", "en": "Fire passes through me and burns nothing."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，没有重量。", "en": "I fall, weightless."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水跟我混在一起了。", "en": "Water mingles with me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的形吹散了。", "en": "The blast blows my shape apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西穿过我，钉在树上。", "en": "It passes through me into a tree."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力把光从我身上剥走。", "en": "Magic strips the light from me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "空着的肚子早就不在了。", "en": "The belly that hungered is long gone."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我亮成了一片。", "en": "Lightning strikes, I flare bright."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里，我几乎认不出自己。", "en": "In the void I barely know myself."}
      ]
    }
  }
}
