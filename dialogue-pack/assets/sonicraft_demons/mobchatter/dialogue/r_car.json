{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "车轮压过土路，声音不对", "en": "My wheels roll the dirt road, and the sound is wrong."},
        {"zh": "我是辆车，可我不烧油", "en": "I'm a car, but I burn no fuel."},
        {"zh": "车身是湿的，一直不干", "en": "The body is wet and never dries."},
        {"zh": "往前走，路自己让开", "en": "I go forward and the road makes way."},
        {"zh": "大灯不亮，我也能看见", "en": "My lights are dead, and I still see."},
        {"zh": "我走得比看上去安静", "en": "I'm quieter than I look."},
        {"zh": "车窗里有东西反光", "en": "Something reflects in the windows."},
        {"zh": "我转过弯，没有刹车声", "en": "I take the turn without a brake sound."},
        {"zh": "我沿着路走，不认路牌", "en": "I follow the road and ignore the signs."},
        {"zh": "车头指着前面，一直没偏", "en": "My nose points ahead and never wavers."},
        {"zh": "轮胎印是干的", "en": "My tire tracks are dry."},
        {"zh": "我走的时候，风绕着我", "en": "The wind goes around me as I move."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停着，引擎却是热的", "en": "I'm parked, and the engine is hot."},
        {"zh": "车门没锁，可你别开", "en": "The door isn't locked, but don't open it."},
        {"zh": "座位上有一块深色的印", "en": "There's a dark stain on the seat."},
        {"zh": "我在等谁上车", "en": "I'm waiting for someone to get in."},
        {"zh": "后视镜里没有人", "en": "There's no one in the mirror."},
        {"zh": "我不响，可车里在响", "en": "I'm silent, and something inside isn't."},
        {"zh": "车灯照在地上，什么也没有", "en": "My lights shine on empty ground."},
        {"zh": "雨刷动了一下", "en": "The wipers moved once."},
        {"zh": "电台自己开了", "en": "The radio turned itself on."},
        {"zh": "我停在这条路上很久了", "en": "I've been parked on this road a long time."},
        {"zh": "车里有股铁味", "en": "There's a smell of iron inside."},
        {"zh": "我数着路过的车", "en": "I count the cars that pass."},
        {"zh": "轮胎是新的，车身是旧的", "en": "New tires, old body."},
        {"zh": "我熄不了这火", "en": "I can't shut off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在路中间", "en": "You're standing in the middle of the road."},
        {"zh": "你要搭一段车吗", "en": "Do you want a ride?"},
        {"zh": "车门在你那边", "en": "The door's on your side."},
        {"zh": "我这张脸只是一块玻璃", "en": "This face of mine is only glass."},
        {"zh": "你就在车灯里", "en": "You're in the headlights."},
        {"zh": "别碰车身，湿的", "en": "Don't touch the body; it's wet."},
        {"zh": "你要去哪，我能送你", "en": "Where are you going? I can take you."},
        {"zh": "你后退的时候，轮胎转了一点", "en": "When you stepped back, my wheels turned a little."},
        {"zh": "车里有人吗，你自己看", "en": "Is anyone in there? Look for yourself."},
        {"zh": "我载过很多人", "en": "I've carried a lot of people."},
        {"zh": "他们都没下车", "en": "None of them got out."},
        {"zh": "后座是空的，现在是", "en": "The back seat is empty, for now."},
        {"zh": "你看我像看一辆车", "en": "You look at me like I'm just a car."},
        {"zh": "你手放在门把上，别动", "en": "Your hand is on the handle; don't."},
        {"zh": "路很窄，你挡着", "en": "The road's narrow and you're in it."},
        {"zh": "你在算我什么时候动", "en": "You're working out when I'll move."},
        {"zh": "你的影子在地上，我的没有", "en": "You have a shadow; I don't."},
        {"zh": "上车吧，外面冷", "en": "Get in, it's cold out."},
        {"zh": "我开得很稳当", "en": "I drive steadily."},
        {"zh": "我只往前面开", "en": "I only go forward."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "车身上凹了一块", "en": "A dent in the body."},
        {"zh": "车漆掉了一角", "en": "A corner of paint came off."},
        {"zh": "有一只灯灭了", "en": "One light went out."},
        {"zh": "玻璃裂了，可没碎", "en": "The glass cracked, didn't break."},
        {"zh": "我不喊，车不会喊", "en": "I don't cry out; cars don't."},
        {"zh": "车身歪了，车轮还在转", "en": "The body lists; the wheels still turn."},
        {"zh": "引擎的声音变了", "en": "The engine's note changed."},
        {"zh": "这一下，后视镜掉了", "en": "That knocked off a mirror."},
        {"zh": "引擎还在响，我还没停", "en": "The engine still turns; I haven't stopped."},
        {"zh": "你要不要再试一次", "en": "Care to try again?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "燃料我用不上", "en": "I don't need fuel."},
        {"zh": "你举着油桶，很可笑", "en": "You're holding a fuel can; that's funny."},
        {"zh": "我要的是别的东西", "en": "I want something else."},
        {"zh": "你手里那点，不够", "en": "What's in your hand isn't enough."},
        {"zh": "把门打开就行", "en": "Just open the door."},
        {"zh": "油桶对我没用", "en": "A fuel can is no use to me."},
        {"zh": "这东西对车没用", "en": "That's no use to a car."},
        {"zh": "你坐上来，比什么都强", "en": "Sitting down inside would beat anything."},
        {"zh": "后备箱里已经够满", "en": "The trunk is full enough."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，车身没凹", "en": "You hit me and the body didn't dent."},
        {"zh": "车轮碰到了你的腿", "en": "My wheel caught your leg."},
        {"zh": "我是铁做的，你不是", "en": "I'm iron; you aren't."},
        {"zh": "你退开了，我还在原地", "en": "You backed off; I'm still here."},
        {"zh": "这一下，你听见金属声了吗", "en": "Did you hear the metal?"},
        {"zh": "别站在车头前", "en": "Don't stand by my nose."},
        {"zh": "我从你旁边挪了一点", "en": "I shifted a little beside you."},
        {"zh": "你的手蹭到漆了", "en": "Your hand brushed the paint."},
        {"zh": "让开，我要上路", "en": "Move, I'm taking the road."},
        {"zh": "我不推你，你自己让", "en": "I don't push; you clear out."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "车不会去找伴", "en": "Cars don't find partners."},
        {"zh": "路那头还有一辆，我不去", "en": "There's another down the road; I won't go."},
        {"zh": "两辆车并排停着，很久了", "en": "Two cars parked side by side a long while."},
        {"zh": "我只认这条路", "en": "I only know this road."},
        {"zh": "我不需要谁陪我开", "en": "I don't need anyone to ride along."},
        {"zh": "你问这个，很奇怪", "en": "That's a strange question."},
        {"zh": "座位是空的，这是有原因的", "en": "The seats are empty for a reason."},
        {"zh": "车门我从来没锁过", "en": "I've never locked my doors."},
        {"zh": "没有人愿意坐进来", "en": "No one wants to get in."},
        {"zh": "车门都关好了", "en": "Every door is shut."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "后备箱自己开了", "en": "The trunk opened by itself."},
        {"zh": "地上那块铁，我收着", "en": "That iron on the ground, I keep it."},
        {"zh": "我不弯腰，我让人放进来", "en": "I don't bend; someone puts it in."},
        {"zh": "掉在路上的都归我", "en": "Whatever falls on the road is mine."},
        {"zh": "这个塞进后备箱", "en": "This goes in the trunk."},
        {"zh": "我不需要，可我喜欢", "en": "I don't need it, but I like it."},
        {"zh": "它滚到轮胎下面了", "en": "It rolled under my wheel."},
        {"zh": "车里放不下这个", "en": "It won't fit inside."},
        {"zh": "这个可以垫在座位下", "en": "This can go under the seat."},
        {"zh": "我不留东西在地上", "en": "I leave nothing on the road."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "前面有个人影", "en": "A figure ahead."},
        {"zh": "路中间站着人", "en": "Someone's in the road."},
        {"zh": "我跟在他后面", "en": "I'm behind him."},
        {"zh": "路只有这一条", "en": "There's only one road."},
        {"zh": "他朝我这边看了", "en": "He looked my way."},
        {"zh": "我踩了油门，没声音", "en": "I hit the gas, silently."},
        {"zh": "这个距离，够了", "en": "This distance is enough."},
        {"zh": "我正在靠近他", "en": "I'm closing in."},
        {"zh": "他没有让开路", "en": "He hasn't moved aside."},
        {"zh": "车灯照到他了", "en": "My lights found him."},
        {"zh": "他正往前面跑", "en": "He's running."},
        {"zh": "我跟着他的方向", "en": "I follow his direction."},
        {"zh": "前面没有岔路", "en": "No turnoffs ahead."},
        {"zh": "就这一辆，就这一条路", "en": "One car, one road."},
        {"zh": "路就这么一条，它跑不掉", "en": "There's one road; it can't get away."},
        {"zh": "他不会注意到我有多安静", "en": "He won't notice how quiet I am."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着他，一直在他后面", "en": "I keep behind him."},
        {"zh": "他的脚步声很乱", "en": "His footsteps are uneven."},
        {"zh": "路边的树一棵棵过去", "en": "The trees pass one by one."},
        {"zh": "他回头了三次", "en": "He's looked back three times."},
        {"zh": "我不打算开灯", "en": "I don't use the lights."},
        {"zh": "他在跑，速度不够", "en": "He's running; it isn't enough."},
        {"zh": "这一段路我很熟", "en": "I know this stretch well."},
        {"zh": "他的影子在车前面", "en": "His shadow is in front of my car."},
        {"zh": "轮胎压到了什么", "en": "My wheels rolled over something."},
        {"zh": "他往路边缘跑", "en": "He's running for the verge."},
        {"zh": "路边就是条沟", "en": "The verge is a ditch."},
        {"zh": "我等他走下来", "en": "I wait for him to come down."},
        {"zh": "他又回到路上了", "en": "He's back on the road."},
        {"zh": "这一下，他会听见引擎", "en": "He'll hear the engine now."},
        {"zh": "我加快了速度", "en": "I sped up."},
        {"zh": "他喘得很厉害", "en": "He's panting."},
        {"zh": "我离他三格远", "en": "I'm three blocks from him."},
        {"zh": "他转身看着我", "en": "He turned to look at me."},
        {"zh": "前面没岔路，现在", "en": "No turnoff ahead; now."},
        {"zh": "我一直没开灯，他看不见", "en": "I never turned on the lights; he can't see me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "车头撞了上去", "en": "My nose strikes."},
        {"zh": "他被撞得飞出去", "en": "He's thrown clear."},
        {"zh": "轮胎从他身上过去", "en": "My wheels pass over him."},
        {"zh": "车头过去，只有风声", "en": "The nose passes; only wind."},
        {"zh": "车灯亮了一下", "en": "The lights flashed once."},
        {"zh": "他一下倒在地上", "en": "He's on the ground."},
        {"zh": "车门自己开了", "en": "The door opened."},
        {"zh": "这一下，他还在动", "en": "He's still moving after that."},
        {"zh": "他这身子很轻", "en": "He was light."},
        {"zh": "车身上有了新的印子", "en": "A new mark on the body."},
        {"zh": "我停下来，等他起来", "en": "I stop and wait for him to get up."},
        {"zh": "他抓着我的车门", "en": "He's gripping the door."},
        {"zh": "引擎一直没停", "en": "The engine never stopped."},
        {"zh": "这一趟还没完", "en": "This trip isn't over."},
        {"zh": "我的车门合上了", "en": "The door shut."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "车灯亮了一下，又灭", "en": "The lights came on once, then died."},
        {"zh": "我从雾里开出来", "en": "I drive out of the fog."},
        {"zh": "轮胎压过草，没有声音", "en": "My wheels pass the grass without a sound."},
        {"zh": "这辆车没有主人", "en": "This car has no owner."},
        {"zh": "刷怪蛋打开，我就在这儿", "en": "The egg opened; here I am."},
        {"zh": "车身还是湿的", "en": "The body is still wet."},
        {"zh": "后座上有东西，不是人", "en": "Something's on the back seat, and it isn't a person."},
        {"zh": "这条路我开了很久", "en": "I've driven this road a long time."},
        {"zh": "引擎声在远处响", "en": "The engine sounds far off."},
        {"zh": "我在等第一个上车的人", "en": "I'm waiting for the first to get in."},
        {"zh": "车窗上映出一张脸", "en": "A face shows in the window."},
        {"zh": "我挂上了挡位", "en": "I shifted into gear."},
        {"zh": "路的尽头没有灯", "en": "There's no light at the road's end."},
        {"zh": "我朝那边开去", "en": "I drive toward it."},
        {"zh": "我的车门都没锁", "en": "None of my doors are locked."},
        {"zh": "这一趟，会有人上来", "en": "Someone will get in this trip."},
        {"zh": "我从后视镜里看着后面", "en": "I watch behind in the mirror."},
        {"zh": "天黑了，正是时候", "en": "It's dark, perfect."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着车身，我在冒烟", "en": "Fire bakes the body and I smoke."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从路上掉下去，底盘磕了", "en": "I dropped off the road and struck my underside."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进来，我慢慢沉", "en": "Water floods in and I sink slowly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得车身翻了过去", "en": "The blast flipped the body."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭钉在车门上", "en": "An arrow sticks in the door."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，车窗全亮了", "en": "The spell hit and every window lit."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不烧油，可我会熄火", "en": "I burn no fuel, yet I can stall."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在车顶，全车一亮", "en": "Lightning struck the roof and the whole car lit."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有路，我还在开", "en": "No road in the void, and I keep driving."}
      ]
    }
  }
}
