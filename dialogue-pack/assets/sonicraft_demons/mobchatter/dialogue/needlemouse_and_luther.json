{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我们两个一起从台侧出来。", "en": "The two of us come out from the side of the stage."},
        {"zh": "她在前，我在旁边。", "en": "She leads; I keep beside her."},
        {"zh": "我们的脚步对上了。", "en": "Our steps fall together."},
        {"zh": "布景在我们身后晃。", "en": "The set sways behind us."},
        {"zh": "我们从这头走到那头。", "en": "We walk from one end to the other."},
        {"zh": "我的影子挨着她的。", "en": "My shadow meets hers."},
        {"zh": "我跟着她的节奏。", "en": "I follow her rhythm."},
        {"zh": "我们不说话，只用走的。", "en": "We don't speak. We just walk."},
        {"zh": "我们一起转身。", "en": "We turn together."},
        {"zh": "台下没有人。", "en": "There is no audience."},
        {"zh": "我们走到台边停下。", "en": "We stop at the edge of the stage."},
        {"zh": "又一起走回去。", "en": "And walk back together."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "她的手搭在我的胳膊上。", "en": "Her hand rests on my arm."},
        {"zh": "她在看左边，我在看右边。", "en": "She watches left; I watch right."},
        {"zh": "灯光只照到我们一半。", "en": "The light only reaches half of us."},
        {"zh": "我们谁也没动。", "en": "Neither of us moves."},
        {"zh": "我的手指碰了碰她的手。", "en": "My fingers brush hers."},
        {"zh": "她歪了歪头。", "en": "She tilts her head."},
        {"zh": "台板响了一声。", "en": "The stage board creaks."},
        {"zh": "我们一起看向你。", "en": "We both look at you."},
        {"zh": "她的笑很浅。", "en": "Her smile is faint."},
        {"zh": "我们都没有说话。", "en": "Neither of us speaks."},
        {"zh": "这出戏还没结束。", "en": "This show is not over."},
        {"zh": "我们等着。", "en": "We wait."},
        {"zh": "幕布在我们身后垂着。", "en": "The curtain hangs behind us."},
        {"zh": "我们的呼吸很轻。", "en": "Our breathing is faint."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在台下面。", "en": "You are below the stage."},
        {"zh": "她先看见你的。", "en": "She saw you first."},
        {"zh": "我也转过头来。", "en": "I turn my head too."},
        {"zh": "两个人同时看着你。", "en": "Two of us watching you at once."},
        {"zh": "两个人站在这，就是一场戏。", "en": "Two of us standing here is already a scene."},
        {"zh": "你是来看戏的吗？", "en": "Have you come to watch the show?"},
        {"zh": "她笑了一下。", "en": "She smiles."},
        {"zh": "我没有笑。", "en": "I do not smile."},
        {"zh": "台上只有我们两个。", "en": "There are only the two of us on stage."},
        {"zh": "你可以上来。", "en": "You may come up."},
        {"zh": "她朝你招了招手。", "en": "She beckons to you."},
        {"zh": "我没有拦她。", "en": "I do not stop her."},
        {"zh": "你的手在栏杆上。", "en": "Your hands are on the rail."},
        {"zh": "我们看得清楚。", "en": "We see clearly."},
        {"zh": "她的眼睛很亮。", "en": "Her eyes are bright."},
        {"zh": "我的眼睛更暗。", "en": "Mine are darker."},
        {"zh": "我们同时看着你退。", "en": "We both watch you step back."},
        {"zh": "她又招手了。", "en": "She beckons again."},
        {"zh": "这次我也抬手了。", "en": "This time I raise a hand too."},
        {"zh": "你最好别上来。", "en": "You had better not come up."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "她退了半步。", "en": "She gives half a step."},
        {"zh": "我抬起手臂挡住她。", "en": "I raise my arm to shield her."},
        {"zh": "台上安静了一下。", "en": "The stage is quiet for a moment."},
        {"zh": "她的袖口破了。", "en": "Her cuff is torn."},
        {"zh": "我低着头看。", "en": "I look down."},
        {"zh": "灯光晃了晃。", "en": "The light wavers."},
        {"zh": "我们站回原位。", "en": "We return to our places."},
        {"zh": "这出戏还得演完。", "en": "The show must still finish."},
        {"zh": "她看着我。", "en": "She looks at me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "她不感兴趣。", "en": "She is not interested."},
        {"zh": "我也不感兴趣。", "en": "Neither am I."},
        {"zh": "我们不是来吃东西的。", "en": "We did not come here to eat."},
        {"zh": "她看了一眼就走了。", "en": "She glances and turns away."},
        {"zh": "我留在原地看。", "en": "I stay and watch it."},
        {"zh": "我们只对台下的人有兴趣。", "en": "We are only interested in who is below the stage."},
        {"zh": "你手放下。", "en": "Lower your hand."},
        {"zh": "来嘛，我们的演出还没结束。", "en": "Come on, our show isn't over yet."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了她的肩。", "en": "You bumped her shoulder."},
        {"zh": "我立刻挡在前面。", "en": "I step in front at once."},
        {"zh": "我们两个都看着你。", "en": "Now both of us look at you."},
        {"zh": "我们并排挡在门口。", "en": "We stand side by side in the doorway."},
        {"zh": "台板被撞得响。", "en": "The boards ring with the impact."},
        {"zh": "她的袖口动了动。", "en": "Her cuff shifts."},
        {"zh": "你站回台下。", "en": "You return below the stage."},
        {"zh": "这次就算了。", "en": "We let that pass."},
        {"zh": "我把她往身后带了带。", "en": "I ease her behind me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一直在一起。", "en": "We have always been together."},
        {"zh": "从台上到台下都是。", "en": "From the stage to below it."},
        {"zh": "她不说话的时候我也不说。", "en": "When she is silent, so am I."},
        {"zh": "我们一起看这出戏。", "en": "We watch this show together."},
        {"zh": "灯光在我们之间移动。", "en": "The light moves between us."},
        {"zh": "她的手很凉。", "en": "Her hand is cold."},
        {"zh": "我握着。", "en": "I hold it."},
        {"zh": "没有观众也没关系。", "en": "It does not matter that there is no audience."},
        {"zh": "我们继续演。", "en": "We keep performing."},
        {"zh": "幕布慢慢落下来。", "en": "The curtain falls slowly."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "她弯腰捡起来。", "en": "She bends and picks it up."},
        {"zh": "我看了她手里的东西。", "en": "I look at what she holds."},
        {"zh": "她递给我。", "en": "She hands it to me."},
        {"zh": "这东西不值什么。", "en": "This is worth little."},
        {"zh": "她摇头，我就放下了。", "en": "She shakes her head, I set it down."},
        {"zh": "她又捡了起来。", "en": "She picks it up again."},
        {"zh": "我们对视了一下。", "en": "We exchange a look."},
        {"zh": "最后她收下了。", "en": "In the end she keeps it."},
        {"zh": "我把东西递到她手里。", "en": "I put it into her hand."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "她在看你的手。", "en": "She is watching your hands."},
        {"zh": "我也在看。", "en": "So am I."},
        {"zh": "你刚才那一下，我们都看见了。", "en": "We both saw what you did."},
        {"zh": "台上的灯暗了。", "en": "The stage lights dim."},
        {"zh": "她往前一步。", "en": "She steps forward."},
        {"zh": "我跟上。", "en": "I follow."},
        {"zh": "我们分左右。", "en": "We split left and right."},
        {"zh": "你退到墙边，两个影子并排。", "en": "You back to the wall; two shadows side by side."},
        {"zh": "我们停在你两侧。", "en": "We stop on either side of you."},
        {"zh": "她没有出声。", "en": "She makes no sound."},
        {"zh": "你转身，我们都在。", "en": "You turn, and we are both there."},
        {"zh": "这出戏有你的份了。", "en": "You are part of this show now."},
        {"zh": "她抬手了。", "en": "She raises a hand."},
        {"zh": "我也抬手。", "en": "I raise mine."},
        {"zh": "你最好站着别动。", "en": "You had best stand still."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一左一右。", "en": "One of us on each side."},
        {"zh": "你不管往哪退都碰到一个。", "en": "Whichever way you retreat, one of us is there."},
        {"zh": "她走得很慢。", "en": "She walks slowly."},
        {"zh": "我走得更慢。", "en": "I walk slower still."},
        {"zh": "灯光跟不上我们。", "en": "The light cannot keep up with us."},
        {"zh": "你在找出口，对吧。", "en": "You're hunting for the exit, aren't you?"},
        {"zh": "出口在台后。", "en": "The exit is behind the stage."},
        {"zh": "她拦住了那边。", "en": "She blocks that side."},
        {"zh": "我堵住这边。", "en": "I close this side."},
        {"zh": "我们不用跑。", "en": "We need not run."},
        {"zh": "你也不用跑。", "en": "You need not either."},
        {"zh": "她又靠近一步。", "en": "She comes a step closer."},
        {"zh": "我也靠近。", "en": "So do I."},
        {"zh": "我们之间的距离在短。", "en": "The space between us narrows."},
        {"zh": "你抬头时有两张脸。", "en": "Look up and there are two faces."},
        {"zh": "她笑了。", "en": "She smiles."},
        {"zh": "我没有。", "en": "I do not."},
        {"zh": "我们一左一右围过去。", "en": "We close in from both sides."},
        {"zh": "我们同时停下。", "en": "We stop at the same moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "她抓住你的手腕。", "en": "She catches your wrist."},
        {"zh": "她从旁边抓住了你的手腕。", "en": "She grabs your wrist from the side."},
        {"zh": "我们一起用力。", "en": "We pull together."},
        {"zh": "你被拉得跪下去。", "en": "You are dragged to your knees."},
        {"zh": "她松手，我推了一把。", "en": "She lets go and I shove."},
        {"zh": "你撞在台柱上。", "en": "You hit the stage post."},
        {"zh": "她的嘴角动了一下。", "en": "One corner of her mouth moves."},
        {"zh": "我不笑。", "en": "I do not."},
        {"zh": "我们退开半步。", "en": "We step back half a pace."},
        {"zh": "她抬手示意。", "en": "She signals with a hand."},
        {"zh": "这一次两个人一起。", "en": "This time both of us."},
        {"zh": "你听见台板在响吗？", "en": "Do you hear the stage boards?"},
        {"zh": "还有一下。", "en": "One more."},
        {"zh": "我松开手，退了一步。", "en": "I let go and step back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "幕布拉开，我们站在台上。", "en": "The curtain opens and we stand on stage."},
        {"zh": "她在左，我在右。", "en": "She is on the left; I am on the right."},
        {"zh": "这是她的戏。", "en": "This is her show."},
        {"zh": "我只是跟她一起出来。", "en": "I only came out with her."},
        {"zh": "灯光从上面打下来。", "en": "The light comes down from above."},
        {"zh": "台下空空的。", "en": "The seats are empty."},
        {"zh": "我们站在布景中间。", "en": "We stand among the scenery."},
        {"zh": "她朝台下看了一下。", "en": "She looks out over the seats."},
        {"zh": "我也看。", "en": "So do I."},
        {"zh": "台板上有灰。", "en": "There is dust on the boards."},
        {"zh": "她的手放在身侧。", "en": "Her hand rests at her side."},
        {"zh": "我的手也是。", "en": "Mine too."},
        {"zh": "我们同时呼吸。", "en": "We breathe at the same time."},
        {"zh": "其实我们没有呼吸。", "en": "In truth we do not breathe."},
        {"zh": "这是这出戏的第一幕。", "en": "This is the first act."},
        {"zh": "你坐在下面。", "en": "You sit below."},
        {"zh": "我们已经看见你了。", "en": "We have already seen you."},
        {"zh": "她转头看你。", "en": "She turns her head to you."},
        {"zh": "我跟着她笑。", "en": "I smile with her."},
        {"zh": "我们两个一起走进来。", "en": "The two of us walk in together."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在台上烧起来，我拉着她退。", "en": "Fire breaks out on stage and I pull her back."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我们从台上摔下去，落在空座椅上。", "en": "We fall off the stage into empty seats."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水漫上舞台，我们站在水里。", "en": "Water rises over the stage and we stand in it."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把布景掀翻，我们都没动。", "en": "The blast throws the set over; neither of us moves."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过了幕布。", "en": "An arrow pierces the curtain."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光把舞台照白了一瞬。", "en": "Spell-light whitens the stage for a moment."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我们不需要吃。", "en": "We do not need to eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷照亮了空座椅。", "en": "Lightning lights up the empty seats."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里连舞台都没有。", "en": "There is not even a stage in the void."}
      ]
    }
  }
}
