{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的脚步落在你身后", "en": "My footsteps land behind you."},
        {"zh": "我的脚步压得很轻", "en": "My steps land very lightly."},
        {"zh": "我从走廊那头走到这头", "en": "I walk the length of the hall."},
        {"zh": "我绕过地上的杂物，贴着墙往前挪。", "en": "I skirt the clutter, easing along the wall."},
        {"zh": "我贴着墙往前挪", "en": "I edge along the wall."},
        {"zh": "我在拐角停了一下", "en": "I pause at the corner."},
        {"zh": "我换了个方向走", "en": "I set off another way."},
        {"zh": "我的影子跟着我", "en": "My shadow keeps pace."},
        {"zh": "我走到门边站住", "en": "I stop by the door."},
        {"zh": "一步一步靠近，不急。", "en": "Step by step, no hurry."},
        {"zh": "我在原地踱了两步", "en": "I pace two steps in place."},
        {"zh": "我慢慢地走开", "en": "I walk slowly away."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我数着你走过的每一步", "en": "I count every step you take."},
        {"zh": "我的手指垂到膝盖下", "en": "My fingers hang below my knees."},
        {"zh": "我的眼睛看着前方", "en": "My eyes look straight ahead."},
        {"zh": "我就这样站到天全黑", "en": "I'll stand like this until dark."},
        {"zh": "我的呼吸几乎听不见", "en": "My breathing is almost silent."},
        {"zh": "我眨眼的间隔有点长", "en": "I blink a little too slowly."},
        {"zh": "我没有要攻击的意思", "en": "I do not mean to attack."},
        {"zh": "我的身体很安静", "en": "My body is very still."},
        {"zh": "我在等什么发生", "en": "I wait for something to happen."},
        {"zh": "我把低着的头抬起", "en": "I lift my lowered head."},
        {"zh": "我身上的颜色很淡", "en": "My colours are washed out."},
        {"zh": "我慢慢地转着头", "en": "I turn my head slowly."},
        {"zh": "我没弄出一点动静", "en": "I make not a single sound."},
        {"zh": "我站在那里很久了", "en": "I have stood there a long time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "不急着动，先抬眼看你。", "en": "No rush — I lift my eyes to you."},
        {"zh": "我们以前见过吗", "en": "Have we met?"},
        {"zh": "我不太记得了", "en": "I do not quite remember."},
        {"zh": "我的笑一直没有变过", "en": "My smile hasn't changed once."},
        {"zh": "我没有一点恶意", "en": "I mean no harm."},
        {"zh": "我的手还在原处", "en": "My hands stay where they are."},
        {"zh": "你的影子和我的一样长", "en": "Your shadow is as long as mine."},
        {"zh": "我想不起来要说什么", "en": "I cannot recall what to say."},
        {"zh": "我慢慢移开视线", "en": "I slowly look away."},
        {"zh": "你看起来有点熟悉", "en": "You look a little familiar."},
        {"zh": "你数得清我的牙齿吗", "en": "Can you count my teeth?"},
        {"zh": "我从头到尾没动", "en": "I have not moved the whole time."},
        {"zh": "你说话的时候我在听", "en": "I am listening when you speak."},
        {"zh": "我的表情没有变", "en": "My expression has not changed."},
        {"zh": "我从你身边看过去", "en": "I look past you."},
        {"zh": "你身后好像有人", "en": "Someone seems to be behind you."},
        {"zh": "我记不清昨天", "en": "I cannot remember yesterday."},
        {"zh": "我站在这里不会伤你", "en": "Standing here, I will not hurt you."},
        {"zh": "我说话像从井底传来", "en": "My voice comes up as if from a well."},
        {"zh": "我又低下了头", "en": "I lower my head again."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上的裂口自己合上", "en": "The gashes on me close by themselves."},
        {"zh": "我一手扶住墙", "en": "I catch the wall."},
        {"zh": "我没有还一下手", "en": "I do not hit back once."},
        {"zh": "我的呼吸重了一点", "en": "My breathing grows a little heavier."},
        {"zh": "我低下头瞧自己的伤", "en": "I look down at my own wound."},
        {"zh": "我慢慢站直身子", "en": "I straighten slowly."},
        {"zh": "我一声都没吭", "en": "I make no sound at all."},
        {"zh": "我扶着膝盖喘气", "en": "I brace a knee and breathe."},
        {"zh": "我还能够站住", "en": "I can still stand."},
        {"zh": "我又缩回阴影里", "en": "I shrink back into the shade."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举高也没用，我不饿", "en": "Holding it high won't help; I'm not hungry."},
        {"zh": "我没伸手，只是看着", "en": "I didn't reach out; I only watched."},
        {"zh": "我不太需要这个", "en": "I do not really need that."},
        {"zh": "我并没有伸手", "en": "I do not reach for it."},
        {"zh": "那块肉还在你手里颤", "en": "That meat is still trembling in your hand."},
        {"zh": "我不碰，你放回口袋", "en": "I won't touch it; put it back."},
        {"zh": "我慢慢把脑袋摇", "en": "I slowly shake my head."},
        {"zh": "你手里的东西对我不算数", "en": "What you hold means nothing here."},
        {"zh": "我又看向别处", "en": "I look elsewhere again."},
        {"zh": "这东西让我想起什么", "en": "This reminds me of something."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你穿过了我的一半身体", "en": "You passed halfway through my body."},
        {"zh": "我们两个静静的不响", "en": "We both stay perfectly quiet."},
        {"zh": "我抬手扶了一下", "en": "I put out a hand."},
        {"zh": "我把身子侧开", "en": "I turn aside."},
        {"zh": "我们撞出一声轻响", "en": "We meet with a soft sound."},
        {"zh": "我退回刚才站的地方", "en": "I drift back to where I stood."},
        {"zh": "我转头看了看你", "en": "I look at you."},
        {"zh": "我只是站着，看着你撞来", "en": "I just stand and watch you collide."},
        {"zh": "我慢慢转回去", "en": "I turn back slowly."},
        {"zh": "撞在一起时谁都没出声", "en": "Neither of us makes a sound on impact."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一个慢慢走过来", "en": "Another walks over slowly."},
        {"zh": "我们两个都不眨眼", "en": "Neither of us blinks."},
        {"zh": "它比我安静一些", "en": "It is quieter than I."},
        {"zh": "我们一起看向走廊", "en": "We look down the hall together."},
        {"zh": "它低着头不说话", "en": "It stands with its head down."},
        {"zh": "我们都没有动", "en": "Neither of us moves."},
        {"zh": "它的手放在我这里", "en": "Its hand rests here."},
        {"zh": "我们一起往前走", "en": "We walk forward together."},
        {"zh": "它先一步停下", "en": "It stops first."},
        {"zh": "我也停了下来", "en": "I stop too."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "待机的我，也会弯腰。", "en": "Even idle, I bend to pick things up."},
        {"zh": "我端详它很久，又放下", "en": "I study it a long while and set it down."},
        {"zh": "我把它摆回原来位置", "en": "I set it back in its place."},
        {"zh": "我拿在手里不动", "en": "I hold it without moving."},
        {"zh": "我把它放回去，位置分毫不差。", "en": "I put it back exactly where it was."},
        {"zh": "我忘了它是什么", "en": "I forget what it was."},
        {"zh": "我慢慢松开手", "en": "I slowly open my hand."},
        {"zh": "它从我手里滑落", "en": "It slips from my hand."},
        {"zh": "我转身就走了", "en": "I turn and walk off."},
        {"zh": "我没有带走它", "en": "I do not take it with me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我不动手，只是想看。", "en": "I won't strike; I only want to look."},
        {"zh": "我没有抬起手", "en": "I do not raise a hand."},
        {"zh": "我只是看着而已", "en": "I am only watching."},
        {"zh": "我听见了什么", "en": "I heard something."},
        {"zh": "我把身体转正，让你看清。", "en": "I straighten my body so you see clearly."},
        {"zh": "我脚步一点点撤后", "en": "My steps draw back slowly."},
        {"zh": "我不打算动手", "en": "I do not mean to fight."},
        {"zh": "你没有威胁到我", "en": "You have not threatened me."},
        {"zh": "我站在那里等", "en": "I stand there waiting."},
        {"zh": "我把头重新垂着", "en": "My head droops again."},
        {"zh": "我的呼吸没有变", "en": "My breathing has not changed."},
        {"zh": "我不躲也不走", "en": "I neither dodge nor leave."},
        {"zh": "我在看你做什么", "en": "I am watching what you do."},
        {"zh": "我有点分不清方向", "en": "I am a little unsure of direction."},
        {"zh": "我慢慢抬起眼睛", "en": "I raise my eyes slowly."},
        {"zh": "我没有要追你的意思", "en": "I do not mean to chase you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我眼光没离你身上", "en": "My eyes stay on you."},
        {"zh": "我并没有靠近", "en": "I am not coming closer."},
        {"zh": "我只是站在原地", "en": "I am only standing here."},
        {"zh": "你的心跳吵得我睡不着", "en": "Your heartbeat keeps me awake."},
        {"zh": "我把脖子朝一侧歪", "en": "I tip my neck to one side."},
        {"zh": "我站着没动半寸", "en": "I stand without shifting an inch."},
        {"zh": "走廊里很安静", "en": "The hall is very quiet."},
        {"zh": "我们之间隔着几步", "en": "A few steps lie between us."},
        {"zh": "我不打算过去", "en": "I do not mean to come over."},
        {"zh": "你走开我也不会追", "en": "If you leave, I will not follow."},
        {"zh": "你慢慢走就行", "en": "Take your time walking."},
        {"zh": "我又看向地板", "en": "I look down at the floor again."},
        {"zh": "我记不清刚才的事", "en": "I cannot recall the last moment."},
        {"zh": "这里只有我们在", "en": "Only the two of us are here."},
        {"zh": "我抬了抬手又放下", "en": "I lift a hand and drop it."},
        {"zh": "我没有任何恶意", "en": "I mean no harm."},
        {"zh": "你的影子动了一下", "en": "Your shadow moved."},
        {"zh": "我往旁边挪了半步，让开。", "en": "I shift half a step aside."},
        {"zh": "你先走，我随后就到", "en": "You go first; I'll follow soon."},
        {"zh": "我慢慢眨了下眼睛", "en": "I blink slowly."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起手挡了一下", "en": "I raise a hand to block."},
        {"zh": "我没有还过手", "en": "I do not strike back."},
        {"zh": "我被推得退了两步", "en": "I am pushed back two steps."},
        {"zh": "我手碰在你肩上", "en": "My hand rests on your shoulder."},
        {"zh": "我没有抓紧它", "en": "I do not hold on."},
        {"zh": "我把手慢慢收回", "en": "I draw my hand slowly back."},
        {"zh": "我退到了一边", "en": "I step aside."},
        {"zh": "我只是想站稳", "en": "I only wanted to keep my footing."},
        {"zh": "我一句话也没出", "en": "I make no sound."},
        {"zh": "我把头慢慢歪向一边", "en": "I tilt my head slowly to one side."},
        {"zh": "我从你旁边走过去", "en": "I walk past you."},
        {"zh": "我没有回过头", "en": "I do not look back."},
        {"zh": "我的脚步有点乱", "en": "My steps are a little unsteady."},
        {"zh": "我的手抬到一半，停住了。", "en": "My hand stops halfway up."},
        {"zh": "我不动的时候，更像人。", "en": "When I'm still, I look more human."},
        {"zh": "我又站回原来那儿", "en": "I stand back where I was."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我忽然站在这里", "en": "I am suddenly standing here."},
        {"zh": "我只是站在这里，不动。", "en": "I'm just standing here, still."},
        {"zh": "我的颜色很淡", "en": "My colours are washed out."},
        {"zh": "我先看了看自己的手，再往前走。", "en": "I look at my own hands first, then step forward."},
        {"zh": "我不知道我怎么来的", "en": "I do not know how I got here."},
        {"zh": "我抬起头看这地方", "en": "I lift my head to this place."},
        {"zh": "我站在走廊的中间", "en": "I stand in the middle of the hall."},
        {"zh": "空气安静得不正常", "en": "The air is unnaturally quiet."},
        {"zh": "我好像忘了什么", "en": "I seem to have forgotten something."},
        {"zh": "我的影子先铺在地上", "en": "My shadow settles first."},
        {"zh": "我没有攻击任何人", "en": "I have attacked no one."},
        {"zh": "我看了看四周", "en": "I look around."},
        {"zh": "我又把目光收回来", "en": "I draw my gaze back."},
        {"zh": "我似乎在这里很久了", "en": "I seem to have been here long."},
        {"zh": "我没有要追谁", "en": "I am not chasing anyone."},
        {"zh": "我又退进了阴影", "en": "I withdraw into the shade again."},
        {"zh": "我的样子和记忆里不一样", "en": "I do not look as I remember."},
        {"zh": "我慢慢站正了", "en": "I straighten up slowly."},
        {"zh": "我站在灯照不到的地方", "en": "I stand where the lamp can't reach."},
        {"zh": "我等在这里就是了", "en": "I will simply wait here."}
      ]
    },
