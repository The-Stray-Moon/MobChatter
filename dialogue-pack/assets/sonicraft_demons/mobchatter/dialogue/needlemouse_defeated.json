{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着腿走，一步一歪。", "en": "I drag my legs, lurching each step."},
        {"zh": "我拖着一条腿往前挪。", "en": "I drag one leg forward."},
        {"zh": "我从台上下来。", "en": "I come down off the stage."},
        {"zh": "每走一步，我都喘一下。", "en": "Each step costs me a breath."},
        {"zh": "我扶着墙往前。", "en": "I brace a hand on the wall."},
        {"zh": "我的影子比刚才短了。", "en": "My shadow is shorter than before."},
        {"zh": "我的鞋底磨穿了一个洞。", "en": "There is a hole worn through my sole."},
        {"zh": "地上有我留下的痕。", "en": "I leave a trail on the floor."},
        {"zh": "我停下来撑着膝。", "en": "I stop and brace on a knee."},
        {"zh": "我没走远。", "en": "I have not gone far."},
        {"zh": "我又抬头看。", "en": "I look up again."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠着墙站着。", "en": "I stand leaning on the wall."},
        {"zh": "我的笑淡了。", "en": "My smile has faded."},
        {"zh": "我在喘。", "en": "I am panting."},
        {"zh": "我的手指已经不听使唤。", "en": "My fingers no longer obey."},
        {"zh": "我的肩在抖。", "en": "My shoulder trembles."},
        {"zh": "嗓子坏了，说不出话。", "en": "My throat is ruined; no words come."},
        {"zh": "我不想动。", "en": "I do not want to move."},
        {"zh": "我的头发乱了。", "en": "My hair is a mess."},
        {"zh": "我慢慢滑坐到地上。", "en": "I slide down to sit on the floor."},
        {"zh": "我又撑着站起来。", "en": "I push myself up again."},
        {"zh": "台上还有人吗？", "en": "Is anyone still on stage?"},
        {"zh": "心跳声大得吵人。", "en": "My heartbeat is too loud."},
        {"zh": "太吵了。", "en": "It is too loud."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我没能……", "en": "I could not—"},
        {"zh": "你看着我做什么。", "en": "What are you looking at me for."},
        {"zh": "我输了。", "en": "I lost."},
        {"zh": "我倒下，也是一场戏。", "en": "My falling is also a show."},
        {"zh": "我的眼睛还是很红。", "en": "My eyes are still red."},
        {"zh": "我看你的时候眼睛在抖。", "en": "My eyes shake as I look at you."},
        {"zh": "你赢了。", "en": "You won."},
        {"zh": "你手上有我的血。", "en": "My blood is on your hands."},
        {"zh": "我的腿不听话。", "en": "My legs will not obey."},
        {"zh": "我没有力气了。", "en": "I have no strength left."},
        {"zh": "你笑吧。", "en": "Go on and laugh."},
        {"zh": "我不会再站起来了。", "en": "I will not stand again."},
        {"zh": "很奇怪，对吧。", "en": "Strange, is it not?"},
        {"zh": "我看不清你。", "en": "I cannot see you clearly."},
        {"zh": "我想看看你的脸。", "en": "I want to see your face."},
        {"zh": "你满意了吗？", "en": "Are you satisfied?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我跪下去一只膝。", "en": "I drop to one knee."},
        {"zh": "我用手肘撑起来。", "en": "I prop myself on an elbow."},
        {"zh": "我的血落了一地。", "en": "My blood falls to the floor."},
        {"zh": "我喘不过气。", "en": "I cannot catch my breath."},
        {"zh": "我的眼睛暗了。", "en": "My eyes dim."},
        {"zh": "我倒下时，针还立着。", "en": "As I fall, the needles still stand."},
        {"zh": "我还没完。", "en": "I am not finished."},
        {"zh": "这点力气我还有。", "en": "I still have this much."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我摇了摇头，没伸手。", "en": "I shake my head and don't reach."},
        {"zh": "我吃不下。", "en": "I cannot eat."},
        {"zh": "我倒下了，这出戏还没完。", "en": "I've fallen, but the show isn't over."},
        {"zh": "我没有力气抬手。", "en": "I have no strength to lift a hand."},
        {"zh": "这东西现在没有意义。", "en": "That means nothing now."},
        {"zh": "我看着它。", "en": "I look at it."},
        {"zh": "我弯不下腰，只能看着。", "en": "I cannot bend down; I can only watch."},
        {"zh": "你还想再来一次吗？", "en": "Do you want to go another round?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撑了两下才起来。", "en": "It takes me two tries to rise."},
        {"zh": "我退无可退。", "en": "I have nowhere to retreat."},
        {"zh": "我的手臂一软。", "en": "My arm gives way."},
        {"zh": "我们撞在一起，我滑到地上。", "en": "We collide and I slide to the floor."},
        {"zh": "我没有力气挡。", "en": "I have no strength to block."},
        {"zh": "我靠在墙边。", "en": "I lean against the wall."},
        {"zh": "这一下够我疼很久。", "en": "That will ache a long while."},
        {"zh": "我没倒下去。", "en": "I did not go down."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "她不在。", "en": "She is not here."},
        {"zh": "她先走了。", "en": "She left first."},
        {"zh": "台上只剩我一个。", "en": "Only I am left on the stage."},
        {"zh": "我伸手抓了一下。", "en": "I reach out once."},
        {"zh": "什么也没抓到。", "en": "I catch nothing."},
        {"zh": "我的声音像坏掉的收音机。", "en": "My voice sounds like a broken radio."},
        {"zh": "没有人应。", "en": "No one answers."},
        {"zh": "我靠着台柱坐下。", "en": "I sit down against the stage post."},
        {"zh": "幕布落了一半。", "en": "The curtain has half fallen."},
        {"zh": "我把额头贴在你肩上。", "en": "I rest my brow on your shoulder."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰，差点栽倒。", "en": "I bend and nearly fall."},
        {"zh": "捡起来看了看，还认得。", "en": "Picked it up and looked. I still recognize it."},
        {"zh": "它从手里滑下去。", "en": "It slips from my hand."},
        {"zh": "这是我上次掉的。", "en": "This is what I dropped before."},
        {"zh": "我把它攥紧。", "en": "I grip it tight."},
        {"zh": "我还是收着。", "en": "I keep it anyway."},
        {"zh": "我把它放在膝上。", "en": "I set it on my knee."},
        {"zh": "把碎片捡起来，拼不回原来的我。", "en": "Pick up the pieces. They won't make me whole again."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我撑着地，把头抬起来。", "en": "I push off the ground and raise my head."},
        {"zh": "你还想再打？", "en": "You want to fight again?"},
        {"zh": "我用一只手撑起身体。", "en": "I push myself up with one hand."},
        {"zh": "这次我没有多少力气。", "en": "This time I have little strength."},
        {"zh": "我还剩一点。", "en": "I have a little left."},
        {"zh": "我朝你伸出手，又缩回。", "en": "I reach for you and pull back."},
        {"zh": "我扶着墙才没跪下。", "en": "I hold the wall to stay upright."},
        {"zh": "你退后，我就坐下了。", "en": "You step back, so I sit down."},
        {"zh": "我笑到一半咳出血。", "en": "My laugh breaks into blood."},
        {"zh": "被打败的Sarah，手还是抬了。", "en": "Defeated Sarah still raises a hand."},
        {"zh": "这一下我用了最后的力气。", "en": "I put my last strength into this."},
        {"zh": "你别躲。", "en": "Do not dodge."},
        {"zh": "我也不躲。", "en": "Nor will I."},
        {"zh": "我们就到这里。", "en": "We end it here."},
        {"zh": "我数到二就没了力气。", "en": "I count to two and lose strength."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腿拖着，跟不上。", "en": "My legs drag, I can't keep up."},
        {"zh": "我的呼吸很乱。", "en": "My breathing is ragged."},
        {"zh": "我扶住台边的柱子。", "en": "I brace on the stage post."},
        {"zh": "我站直了。", "en": "I straighten up."},
        {"zh": "我的手臂在抖。", "en": "My arms tremble."},
        {"zh": "我又往前挪。", "en": "I shuffle forward again."},
        {"zh": "那里有光。", "en": "There is light there."},
        {"zh": "我看着那道光。", "en": "I watch that light."},
        {"zh": "我追了两步就停住了。", "en": "I chase two steps and stop."},
        {"zh": "我靠在台边。", "en": "I lean on the stage."},
        {"zh": "你又动了。", "en": "You move again."},
        {"zh": "我的下巴抬起来。", "en": "My chin lifts."},
        {"zh": "我的影子还挂在墙上。", "en": "My shadow still hangs on the wall."},
        {"zh": "我扶着墙，慢慢挪。", "en": "I hold the wall and shuffle on."},
        {"zh": "最后几步。", "en": "The last few steps."},
        {"zh": "灯一灭，我就真的没了。", "en": "If the light dies, so do I."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬手打了你一下。", "en": "I swing once at you."},
        {"zh": "我的手没什么力气。", "en": "There is little strength in it."},
        {"zh": "我扑了个空，摔在地上。", "en": "I lunge and hit the floor."},
        {"zh": "抓住你的衣领，别挣。", "en": "Got your collar. Stop squirming."},
        {"zh": "我的血滴在地上。", "en": "My blood drips to the floor."},
        {"zh": "我又支撑住。", "en": "I brace myself again."},
        {"zh": "我没退。", "en": "I did not give."},
        {"zh": "我还在，只是手抬不高。", "en": "I am still here, only my arm will not rise."},
        {"zh": "这一下用光了我的力气。", "en": "That used the last of my strength."},
        {"zh": "我们扯平了。", "en": "We are even."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "幕布落下来，我躺在那。", "en": "The curtain falls and I am lying there."},
        {"zh": "我撑着地起来。", "en": "I push myself up from the floor."},
        {"zh": "台上很乱。", "en": "The stage is a wreck."},
        {"zh": "灯坏了几盏。", "en": "Several lights have gone out."},
        {"zh": "我的袖子只剩半截。", "en": "Only half my sleeve is left."},
        {"zh": "我抬手摸了一下脸。", "en": "I touch my face."},
        {"zh": "手上有血。", "en": "There is blood on my hand."},
        {"zh": "我站起来的时候晃了一下。", "en": "I sway as I stand."},
        {"zh": "椅子空着。", "en": "The seats are empty."},
        {"zh": "布景歪到一边。", "en": "The set leans to one side."},
        {"zh": "我听见远处有掌声。", "en": "I hear applause far off."},
        {"zh": "那声音是别人的。", "en": "That voice belongs to someone else."},
        {"zh": "我又咳了一声。", "en": "I cough once."},
        {"zh": "我的目光落在门那边。", "en": "My gaze falls on the door."},
        {"zh": "我一步一晃地挪过去。", "en": "I lurch forward one step at a time."},
        {"zh": "我的影子只有半截。", "en": "My shadow is only half."},
        {"zh": "我的膝盖磕在石头上。", "en": "My knees hit the stone."},
        {"zh": "我知道我输了。", "en": "I know I lost."},
        {"zh": "可我还站着。", "en": "But I am still standing."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在我身上烧，我缩在地上。", "en": "Fire burns on me and I curl on the floor."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从台上摔下去，站不起来。", "en": "I fall off the stage and cannot rise."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进喉咙，我抓不住东西。", "en": "Water fills my throat and I grip nothing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我推到台下。", "en": "The blast throws me off the stage."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进我的腿，我跪了下去。", "en": "An arrow hits my leg and I kneel."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒光烧过来，我的视线黑了。", "en": "Spell-light burns and my sight goes black."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我趴在地上。", "en": "Lightning falls and I lie flat."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空把我往下拖，我没有力气挣。", "en": "The void drags me down and I have no strength to fight it."}
      ]
    }
  }
}
