{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一蹦一蹦地挪，红线在头顶晃。", "en": "I lurch in little hops, a red line swaying overhead."},
        {"zh": "布做的腿踩下去没有声音。", "en": "Cloth legs land without a sound."},
        {"zh": "我歪着头，一步一步靠过去。", "en": "Head askew, I close in step by step."},
        {"zh": "身体里有一点红光在动。", "en": "A red glimmer moves inside me."},
        {"zh": "我拖着一根断线走。", "en": "I walk dragging a snapped thread."},
        {"zh": "我从门缝里挤过去，很扁。", "en": "I squeeze through the door gap, flattened."},
        {"zh": "我脚下的地面变冷了。", "en": "The floor goes cold beneath me."},
        {"zh": "我的耳朵软塌塌地垂着。", "en": "My ears flop down loose."},
        {"zh": "我一边走一边转眼睛。", "en": "My eyes roll as I move."},
        {"zh": "我的针脚歪歪扭扭。", "en": "My stitching runs crooked."},
        {"zh": "我朝你的方向来。", "en": "I come your way."},
        {"zh": "不紧不慢，但我一直在走。", "en": "Unhurried, but I never stop."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，线在头顶晃。", "en": "Standing, the thread sways overhead."},
        {"zh": "我在听房间里的声音。", "en": "I listen to the room."},
        {"zh": "布偶的嘴，缝不住。", "en": "A doll's mouth can't be sewn shut."},
        {"zh": "身体里有什么在动。", "en": "Something moves inside me."},
        {"zh": "我一动不动，像被挂起来。", "en": "Still, as if hung up."},
        {"zh": "红光从针脚缝里透出来。", "en": "Red light leaks through my stitches."},
        {"zh": "我慢慢把头歪向一边。", "en": "I tilt my head slowly to one side."},
        {"zh": "这里很安静，很好。", "en": "It is quiet here. Good."},
        {"zh": "我抬手摸了摸自己的耳朵。", "en": "I raise a hand and touch my ear."},
        {"zh": "我等一个人转头。", "en": "I wait for someone to turn their head."},
        {"zh": "我的脚一直没动。", "en": "My feet have not moved."},
        {"zh": "布上落了一点灰。", "en": "Dust has settled on the cloth."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你把头转回来了。", "en": "You turned your head back."},
        {"zh": "我一直贴在你身后。", "en": "I stay right at your back."},
        {"zh": "你看我的眼睛。", "en": "Look at my eyes."},
        {"zh": "我是一块布，加一根线。", "en": "I am cloth and one thread."},
        {"zh": "我能看见你的呼吸。", "en": "I can see your breathing."},
        {"zh": "你站着的姿势，我很喜欢。", "en": "I like the way you stand."},
        {"zh": "眼睛别合起来。", "en": "Do not close your eyes."},
        {"zh": "我只是站在这里，线自己会动。", "en": "I only stand here; the string moves on its own."},
        {"zh": "你手心全是汗。", "en": "Your palms are all sweat."},
        {"zh": "再多站一小会儿。", "en": "Stand a little longer."},
        {"zh": "这灯不太亮了。", "en": "The light is going dim."},
        {"zh": "我歪着脑袋，等你先眨眼。", "en": "I tilt my head and wait for you to blink first."},
        {"zh": "你一转身，我就近一点。", "en": "Each time you turn, I am closer."},
        {"zh": "你闻到铁锈味了吗。", "en": "Do you smell rust?"},
        {"zh": "你喊破喉咙也没人。", "en": "Shout all you like. No one comes."},
        {"zh": "这房间小得很。", "en": "This room is small."},
        {"zh": "我的鼻尖快碰到你的背了。", "en": "My cloth nose is almost against your back."},
        {"zh": "你看我看了多久。", "en": "How long have you been looking?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "崩断了一根线。", "en": "One thread snapped."},
        {"zh": "布料裂开来了。", "en": "The cloth has split open."},
        {"zh": "我歪了歪，站回原位。", "en": "I lurch, then return upright."},
        {"zh": "里面有一点疼。", "en": "Something inside hurts."},
        {"zh": "红光暗了一下。", "en": "The red glow dims."},
        {"zh": "缝线全松开了。", "en": "All my stitching loosened."},
        {"zh": "我一言也不发。", "en": "I say not a word."},
        {"zh": "这一下，我记得。", "en": "I remember that."},
        {"zh": "下次会更好些。", "en": "It will be better next time."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那个东西是什么。", "en": "What is that thing?"},
        {"zh": "递到我手里面。", "en": "Put it in my hand."},
        {"zh": "我不要，但我想要。", "en": "I do not need it, but I want it."},
        {"zh": "就摆到地板上去。", "en": "Set it on the floor."},
        {"zh": "你的手别收回去。", "en": "Do not pull your hand back."},
        {"zh": "我够不到那里。", "en": "I cannot reach it there."},
        {"zh": "再往近处递一点。", "en": "Closer still."},
        {"zh": "它发出声音了。", "en": "It made a sound."},
        {"zh": "我会把它带走。", "en": "I will take it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到了我，很软。", "en": "You touched me. I am soft."},
        {"zh": "你反倒退了半步。", "en": "You are the one who stepped back."},
        {"zh": "我退不开，线拉着我。", "en": "I cannot retreat. The thread holds me."},
        {"zh": "碰一下也不响。", "en": "One nudge makes no sound."},
        {"zh": "别拽我的耳朵。", "en": "Do not pull my ear."},
        {"zh": "我歪了一下，又站正。", "en": "I tilt, then straighten."},
        {"zh": "你的肩膀有点热。", "en": "Your shoulder is warm."},
        {"zh": "我的布陷下去，又慢慢鼓回来。", "en": "My cloth dents and slowly puffs back out."},
        {"zh": "你退后一点点。", "en": "Back off a little."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一块布。", "en": "I am only a piece of cloth."},
        {"zh": "里面空荡荡的。", "en": "It is hollow inside."},
        {"zh": "这根线不是我的。", "en": "This thread is not mine."},
        {"zh": "别提这个话头。", "en": "Do not bring it up."},
        {"zh": "我没有那副构造。", "en": "I lack that construction."},
        {"zh": "这身体不合适。", "en": "This body is not suited."},
        {"zh": "你会后悔问的。", "en": "You will regret asking."},
        {"zh": "你滚得远远的。", "en": "Get far away."},
        {"zh": "我只想看着你。", "en": "I only want to watch you."},
        {"zh": "不必再说什么。", "en": "Nothing more to say."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手，线拉紧了。", "en": "I reach; the thread pulls tight."},
        {"zh": "我用两根手指夹。", "en": "I pinch it with two fingers."},
        {"zh": "它从我手里滑掉。", "en": "It slips from my grip."},
        {"zh": "我把它缝进身体里。", "en": "I stitch it into myself."},
        {"zh": "这个是我的了。", "en": "This is mine now."},
        {"zh": "地板凉得透骨。", "en": "The floor is cold through."},
        {"zh": "我看不懂这是什么。", "en": "I do not know what this is."},
        {"zh": "我留着，以后用。", "en": "I keep it for later."},
        {"zh": "放下，那是我的。", "en": "Drop it. That is mine."},
        {"zh": "我塞进嘴里，看它掉下来。", "en": "I put it in my mouth and watch it fall out."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你停住不走了。", "en": "You have stopped."},
        {"zh": "这回你归我了。", "en": "This time you are mine."},
        {"zh": "这根线绷直了。", "en": "The thread has gone taut."},
        {"zh": "灯灭之前，够了。", "en": "Before the lights go out, this is enough."},
        {"zh": "你退到墙角落了。", "en": "You have backed into the corner."},
        {"zh": "我把线绷直，数你喘了几口。", "en": "I pull my string taut and count your breaths."},
        {"zh": "红光变得更亮了。", "en": "The red glow is brighter."},
        {"zh": "我实在懒得跑。", "en": "I cannot be bothered to run."},
        {"zh": "你听到我了吗。", "en": "Do you hear me?"},
        {"zh": "这次我不松手。", "en": "This time I do not let go."},
        {"zh": "是我先起的头。", "en": "I made the first move."},
        {"zh": "你把头转回来。", "en": "Turn your head back."},
        {"zh": "行，就这样办吧。", "en": "Fine. Just so."},
        {"zh": "你往我这边来。", "en": "Come toward me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "针脚在我皮肤下蠕动，没有声。", "en": "Stitches crawl beneath my cloth without a sound."},
        {"zh": "你攥得太紧，线都替你绷直了。", "en": "You grip too hard; the thread pulls taut for you."},
        {"zh": "我偏着头瞧你。", "en": "I watch you with my head cocked."},
        {"zh": "线在我头顶晃。", "en": "The thread sways above me."},
        {"zh": "我不用喘气的。", "en": "I need no breath."},
        {"zh": "你在到处找门。", "en": "You are hunting for a door."},
        {"zh": "门在你后面，锁着。", "en": "The door is behind you, and locked."},
        {"zh": "再沉住一点气。", "en": "Hold steady a little longer."},
        {"zh": "红光就在门口。", "en": "The red glow is at the door."},
        {"zh": "你走到哪，我的针脚跟到哪。", "en": "Wherever you walk, my stitches follow."},
        {"zh": "你听见针脚的声音吗。", "en": "Do you hear the stitching?"},
        {"zh": "它们在你脚边。", "en": "They are at your feet."},
        {"zh": "好，就是这样了。", "en": "Good. Just like this."},
        {"zh": "就是这一次了。", "en": "This time."},
        {"zh": "脑袋别向后转。", "en": "Do not turn your head back."},
        {"zh": "这一下抓住你。", "en": "Got you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我钳住你的手腕。", "en": "I clamp your wrist."},
        {"zh": "针脚从布下伸出来。", "en": "Stitches reach out from under the cloth."},
        {"zh": "我整个人贴上你的背。", "en": "I press my whole body to your back."},
        {"zh": "你被我抵在墙上。", "en": "I have you braced on the wall."},
        {"zh": "血渗进布里去了。", "en": "Blood soaks into the cloth."},
        {"zh": "你甩开我，我又回来。", "en": "You throw me off; I come back."},
        {"zh": "我的手指太细了。", "en": "My fingers are very thin."},
        {"zh": "你摸到的只有布。", "en": "All you touch is cloth."},
        {"zh": "我推你，很轻，你却退了。", "en": "I push lightly, and you fall back."},
        {"zh": "红光闪了一下。", "en": "The red glow flashes."},
        {"zh": "我的头歪到肩膀上了。", "en": "My head has tilted onto my shoulder."},
        {"zh": "你的呼吸还没平。", "en": "Your breathing has not settled."},
        {"zh": "这样做就够了。", "en": "That is enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "线先落下来，然后是我。", "en": "The thread descends first, then me."},
        {"zh": "红光在黑暗里亮着。", "en": "The red glow shines in the dark."},
        {"zh": "这不是我该在的地方。", "en": "This is not where I belong."},
        {"zh": "我低着头，慢慢抬头。", "en": "Head down, I slowly look up."},
        {"zh": "房间的温度降了一点。", "en": "The room has cooled a little."},
        {"zh": "门缝里先探出我的耳朵。", "en": "My ear pokes through the door crack first."},
        {"zh": "我的眼睛没有光。", "en": "My eyes hold no light."},
        {"zh": "抖了抖灰，缝线还紧。", "en": "I shake off the dust — the seams still hold."},
        {"zh": "你才刚刚走进来。", "en": "You have only just walked in."},
        {"zh": "我歪着脖子，看你。", "en": "Neck crooked, I look at you."},
        {"zh": "别去关那盏灯。", "en": "Do not turn off that lamp."},
        {"zh": "墙角积灰里，我坐了很久。", "en": "I have sat a long time in the dust of the corner."},
        {"zh": "你身后的墙上，多了一道布影。", "en": "A cloth shadow appears on the wall behind you."},
        {"zh": "我举起一只手，很慢。", "en": "I lift one hand, very slowly."},
        {"zh": "针脚开始动了。", "en": "The stitches are moving."},
        {"zh": "你都听见了吗。", "en": "Did you hear all that?"},
        {"zh": "我走近了一步。", "en": "I took one step closer."},
        {"zh": "你出不了这间屋。", "en": "You will not leave this room."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "布烧焦了，味道很冲。", "en": "The cloth burns; the smell is sharp."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从梁上掉下来，布没有摔响。", "en": "I drop from the beam; the cloth makes no sound."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "布吸了水，很重。", "en": "The cloth soaked up water and grew heavy."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我吹得贴到墙上。", "en": "The blast slams me to the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过我，扎在后面的门上。", "en": "The arrow passes through me into the door."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让线都绷紧了。", "en": "This light draws every thread taut."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，但我在变薄。", "en": "I do not eat, yet I thin."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电穿过针脚，我全身一亮。", "en": "Current runs through my stitching; I flare."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面没有地面可以站。", "en": "No floor to stand on below."}
      ]
    }
  }
}
