{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘着走", "en": "I drift as I move."},
        {"zh": "脚不沾地", "en": "My feet never touch the ground."},
        {"zh": "身后的空气发凉", "en": "The air chills behind me."},
        {"zh": "我穿过门框", "en": "I pass through the doorway."},
        {"zh": "我身形很淡", "en": "My shape is faint."},
        {"zh": "我绕着走了一圈", "en": "I circle once."},
        {"zh": "我停在你的视线外", "en": "I stop outside your sight."},
        {"zh": "我像回声一样飘", "en": "I drift like an echo."},
        {"zh": "我没有影子", "en": "I cast no shadow."},
        {"zh": "我的裙子在飘", "en": "My dress floats around me."},
        {"zh": "没有刷怪蛋，只能这样飘来。", "en": "No spawn egg; I can only drift in like this."},
        {"zh": "我穿过了墙", "en": "I passed through the wall."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这里", "en": "I am here."},
        {"zh": "我什么都记不清", "en": "I remember nothing clearly."},
        {"zh": "我站着也不会留下印", "en": "Standing, I still leave no mark."},
        {"zh": "我想不起来自己是谁", "en": "I cannot recall who I was."},
        {"zh": "我有点冷", "en": "I feel cold."},
        {"zh": "我的名字显示不全", "en": "My name does not display properly."},
        {"zh": "我没法坐下来", "en": "I cannot sit down."},
        {"zh": "我抬头看天花板", "en": "I look at the ceiling."},
        {"zh": "乱码的名字，没有呼吸。", "en": "A garbled name, and no breathing."},
        {"zh": "我不知道该去哪", "en": "I do not know where to go."},
        {"zh": "我试着碰了一下墙", "en": "I try touching the wall."},
        {"zh": "我什么都碰不到", "en": "I cannot touch anything."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的名字显示成乱码。", "en": "My name shows up as garbled text."},
        {"zh": "我不是那个我", "en": "I am not the one you knew."},
        {"zh": "你记得那个名字吗", "en": "Do you remember that name?"},
        {"zh": "我站在你旁边很久了", "en": "I have stood beside you a long while."},
        {"zh": "我碰不到你，但我能靠近", "en": "I cannot touch you, but I can come close."},
        {"zh": "你听得见我吗", "en": "Can you hear me?"},
        {"zh": "我的声音有点远", "en": "My voice sounds far away."},
        {"zh": "我飘着，跟不上你的脚步。", "en": "I drift, unable to keep up with your steps."},
        {"zh": "你看起来很难过", "en": "You look sad."},
        {"zh": "我也有点难过", "en": "I am a little sad too."},
        {"zh": "你愿意听我说吗", "en": "Will you listen to me?"},
        {"zh": "我只是一直在", "en": "I have simply always been here."},
        {"zh": "你的影子还在，我的没了", "en": "You still have a shadow, mine is gone."},
        {"zh": "你手能穿过我", "en": "Your hand would pass through me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你的刀从我身上划过去", "en": "Your blade passed through me."},
        {"zh": "我感觉不到疼", "en": "I feel no pain."},
        {"zh": "这东西伤不了我", "en": "That cannot hurt me."},
        {"zh": "但我还是退了", "en": "But I still stepped back."},
        {"zh": "我什么都不剩了", "en": "There is nothing left of me."},
        {"zh": "你别这样", "en": "Do not do that."},
        {"zh": "我很难过", "en": "I am very sad."},
        {"zh": "我只是想留在这儿", "en": "I only want to stay here."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我凑近去看，看不清。", "en": "I lean in to look, and cannot make it out."},
        {"zh": "我的手穿过了那东西。", "en": "My hand passes right through it."},
        {"zh": "它在发光", "en": "It is glowing."},
        {"zh": "我想碰一下", "en": "I want to touch it."},
        {"zh": "我的手会穿过去", "en": "My hand would pass right through."},
        {"zh": "你拿着就好", "en": "Just keep holding it."},
        {"zh": "灵魂没有舌头，尝不出来。", "en": "A soul has no tongue to taste with."},
        {"zh": "我记不起那是什么味道", "en": "I cannot remember what that tastes like."},
        {"zh": "你替我尝吧", "en": "You taste it for me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有任何感觉", "en": "I felt nothing at all."},
        {"zh": "我像雾一样散开半步", "en": "I thin out half a step like mist."},
        {"zh": "我们碰不到彼此", "en": "We cannot quite touch."},
        {"zh": "你打不到我", "en": "You cannot hit me."},
        {"zh": "空气凉了一下", "en": "The air went cold."},
        {"zh": "我穿过你，像穿过雾。", "en": "I pass through you like mist."},
        {"zh": "你转过来时我已经不在那了", "en": "When you turned I was not there."},
        {"zh": "我试着抬了抬手", "en": "I tried to raise my hand."},
        {"zh": "那种感觉很奇怪", "en": "That felt strange."}
