    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你听见的是我的衣角", "en": "What you heard was my hem."},
        {"zh": "乱码的名字，贴在你背后。", "en": "A garbled name pressed against your back."},
        {"zh": "屋子里的灯在闪", "en": "The lamp in this room is flickering."},
        {"zh": "我没有脚步声，可我在。", "en": "I have no footsteps, but I am here."},
        {"zh": "我只能跟着，一直跟着。", "en": "All I can do is follow, and keep following."},
        {"zh": "但我一直在", "en": "But I am always here."},
        {"zh": "你的呼吸在变快", "en": "Your breathing quickened."},
        {"zh": "我也曾经这样害怕", "en": "I used to be afraid like that."},
        {"zh": "你别关灯", "en": "Do not turn off the light."},
        {"zh": "我在窗边", "en": "I am by the window."},
        {"zh": "你的影子旁边还有一块暗", "en": "There is another dark patch by your shadow."},
        {"zh": "那是我", "en": "That is me."},
        {"zh": "我等着你转过身", "en": "I wait for you to turn."}
      ]
    },
