        {"zh": "我试了很多次", "en": "I have tried many times."},
        {"zh": "这不算捡到", "en": "That does not count as picking it up."},
        {"zh": "我连灰都碰不到", "en": "I cannot even touch the dust."},
        {"zh": "对不起", "en": "I am sorry."}
