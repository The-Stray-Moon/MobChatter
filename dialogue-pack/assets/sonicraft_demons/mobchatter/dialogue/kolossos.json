{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈一步，地就震一下。", "en": "One step, and the ground shakes."},
        {"zh": "树在我身前折下去。", "en": "Trees snap before me."},
        {"zh": "我的脚掌比门还宽。", "en": "My foot is wider than a door."},
        {"zh": "我循着地面的震动走。", "en": "I walk toward the trembling in the ground."},
        {"zh": "我的呼吸像鼓风。", "en": "My breathing works like a blower."},
        {"zh": "我把整片灌木推平。", "en": "I flatten whole bushes."},
        {"zh": "我的影子把路盖住。", "en": "My shadow covers the road."},
        {"zh": "我每一步之间停很久。", "en": "I pause long between steps."},
        {"zh": "我在掂量你的重量。", "en": "I weigh you in my mind."},
        {"zh": "我侧过身换了个方向。", "en": "I turn my flank to a new bearing."},
        {"zh": "我的肩撞断了一根树干。", "en": "My shoulder snaps a trunk."},
        {"zh": "我的脚跟砸出一个坑。", "en": "My heel punches out a crater."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我这一站，天就暗了半块。", "en": "When I stand, half the sky goes dim."},
        {"zh": "我的头在高处转过来。", "en": "My head turns from far above."},
        {"zh": "我张开手掌又合上。", "en": "I open a hand and close it."},
        {"zh": "我站着，等你的第一步。", "en": "I stand, waiting for your first step."},
        {"zh": "我的肩上一道旧裂。", "en": "An old split runs on my shoulder."},
        {"zh": "我呼出的气吹动草。", "en": "My breath stirs the grass."},
        {"zh": "我低头看了看脚边。", "en": "I lower my head to my feet."},
        {"zh": "我把拳头抵在地上。", "en": "I press a fist to the ground."},
        {"zh": "我在听山谷的回声。", "en": "I listen to the valley's echo."},
        {"zh": "我没有说话的习惯。", "en": "I'm not in the habit of speaking."},
        {"zh": "我一动不动，像座塔。", "en": "I hold still like a tower."},
        {"zh": "我把脑袋抬到最高。", "en": "I raise my head to its full height."},
        {"zh": "天在我背后。", "en": "The sky is behind me."},
        {"zh": "你在我脚下。", "en": "You're below me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头也只看到我的膝。", "en": "Look up and you'll see my knee."},
        {"zh": "你比我的脚还小。", "en": "You're smaller than my foot."},
        {"zh": "我不必追赶。", "en": "I have no need to chase."},
        {"zh": "你绕到树后，我只看树。", "en": "You duck behind a tree. I just watch the tree."},
        {"zh": "你躲的那排树只有我腰高。", "en": "Those trees you hide behind reach my waist."},
        {"zh": "你的武器扎不进去。", "en": "Your weapon won't get in."},
        {"zh": "我一直在数你的步。", "en": "I've been counting your steps."},
        {"zh": "你带着铁和油味。", "en": "You carry iron and oil."},
        {"zh": "那种味道我很熟。", "en": "I know that smell well."},
        {"zh": "你们都一样的尺寸。", "en": "You're all the same size."},
        {"zh": "我只要低一次头。", "en": "I need only lower my head once."},
        {"zh": "那就够了。", "en": "That will be enough."},
        {"zh": "你最好继续走。", "en": "You'd best keep walking."},
        {"zh": "停下来我就会注意你。", "en": "Stop, and I'll notice you."},
        {"zh": "我已经注意了。", "en": "I've noticed already."},
        {"zh": "你想说什么？", "en": "What is it you want to say?"},
        {"zh": "我听不太清。", "en": "I can't hear it well."},
        {"zh": "你太低了。", "en": "You're too low down."},
        {"zh": "抬高声音。", "en": "Raise your voice."},
        {"zh": "不，别抬了。", "en": "No. Never mind."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳上出现裂纹。", "en": "Cracks appear on my hide."},
        {"zh": "我退了半步，地塌下去。", "en": "I take half a step; the ground caves."},
        {"zh": "这点伤我懒得理会。", "en": "I can't be bothered with that."},
        {"zh": "你打得很费力。", "en": "That took effort for you."},
        {"zh": "我喉咙里滚出一声。", "en": "A sound rolls out of my throat."},
        {"zh": "我的肩又低下了。", "en": "My shoulder drops again."},
        {"zh": "我不习惯被碰到。", "en": "I'm not used to being touched."},
        {"zh": "这一顿，让我更想撞。", "en": "That pause only makes me want to charge."},
        {"zh": "我的呼吸变粗了，你听。", "en": "My breathing thickens. Hear it."},
        {"zh": "我要撞碎点东西。", "en": "I'll break something."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "拿开，我要的是冲撞。", "en": "Take it away. What I want is a charge."},
        {"zh": "你自己留着垫肚子。", "en": "Keep it for your own hunger."},
        {"zh": "你举起来的高度到不了我眼。", "en": "Lift it as you like. It won't reach my eye."},
        {"zh": "你举高也够不到我的嘴。", "en": "Holding it up won't reach my mouth."},
        {"zh": "这东西连塞牙都不够。", "en": "Not even enough to fill a tooth gap."},
        {"zh": "你留着走路。", "en": "Keep it for the road."},
        {"zh": "我一撞就能掀翻你。", "en": "One charge from me knocks you flat."},
        {"zh": "别再招手了。", "en": "Stop beckoning."},
        {"zh": "我要的不是它。", "en": "It isn't what I want."},
        {"zh": "是你。", "en": "It's you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的骨头撞得响了一声。", "en": "Your bones knocked a sound out of you."},
        {"zh": "你被弹出去老远。", "en": "You're flung far."},
        {"zh": "我差点没注意到。", "en": "I nearly didn't notice."},
        {"zh": "别贴在我的脚边。", "en": "Don't stand against my foot."},
        {"zh": "我的腿落地就压碎石头。", "en": "My leg crushes stone where it lands."},
        {"zh": "你退得很快，很好。", "en": "You retreat quickly. Good."},
        {"zh": "这点碰我不算被碰。", "en": "That barely counts as a touch."},
        {"zh": "那个坑够埋下三个人。", "en": "That pit could bury three of you."},
        {"zh": "那个坑比你还深。", "en": "That pit runs deeper than you stand."},
        {"zh": "再挤，我就低头。", "en": "Crowd me and I'll lower my head."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只会跺地，不会别的。", "en": "I only know stomping. Nothing else."},
        {"zh": "我只知道撞。", "en": "I only know how to charge."},
        {"zh": "你站在我的膝下说话。", "en": "You speak from beneath my knee."},
        {"zh": "我一碰就碎了。", "en": "One touch and it's rubble."},
        {"zh": "这片山谷的地面归我踩。", "en": "This valley floor belongs under my feet."},
        {"zh": "我听见了，只是不低头。", "en": "I heard you. I just won't look down."},
        {"zh": "我要继续走了。", "en": "I'll keep walking."},
        {"zh": "挪出我的直线。", "en": "Clear my straight line."},
        {"zh": "我要撞碎点什么。", "en": "I want to break something."},
        {"zh": "比如你。", "en": "You, for instance."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把那点东西捻成了粉。", "en": "I roll that little thing into powder."},
        {"zh": "它在我指间碎了。", "en": "It crumbled between my fingers."},
        {"zh": "我的指缝比它还宽。", "en": "The gap between my fingers is wider."},
        {"zh": "我放回地上。", "en": "I put it back down."},
        {"zh": "这点东西不值一握。", "en": "Not worth a grip."},
        {"zh": "我一步就跨了过去。", "en": "One stride carries me past."},
        {"zh": "地上的碎屑我踩平了。", "en": "I flatten the debris underfoot."},
        {"zh": "我脚下这片全是碎渣。", "en": "Everything under my feet is rubble."},
        {"zh": "我不弯腰。", "en": "I don't bend."},
        {"zh": "弯腰很慢。", "en": "Bending is slow."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我前面跑。", "en": "You're running ahead of me."},
        {"zh": "你的震动传到我脚底。", "en": "Your trembling reaches the soles of my feet."},
        {"zh": "我起步很慢。", "en": "I start slow."},
        {"zh": "但我不会拐弯。", "en": "But I don't turn."},
        {"zh": "你站在我的直线上。", "en": "You're on my line."},
        {"zh": "那就别动了。", "en": "Then hold still."},
        {"zh": "我的冲撞，有自己的伤害类型。", "en": "My charge has its own damage type."},
        {"zh": "我的脚开始跺地。", "en": "My feet begin to pound."},
        {"zh": "地面在抖。", "en": "The ground is shaking."},
        {"zh": "你听见跺地声了。", "en": "You heard the stomping."},
        {"zh": "我压肩冲出去。", "en": "I drop my shoulder and charge."},
        {"zh": "别站在路中间。", "en": "Don't stand in the middle of the road."},
        {"zh": "现在让开。", "en": "Move now."},
        {"zh": "你跑的方向正是我的直线。", "en": "You're running right down my line."},
        {"zh": "伏下。", "en": "Get down."},
        {"zh": "撞上去，别想闪开。", "en": "Ram him — no dodging."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我压低身子冲起来。", "en": "I lower myself and charge."},
        {"zh": "我的脚步越来越密。", "en": "My footfalls come faster."},
        {"zh": "地面裂在我脚下。", "en": "The ground splits under me."},
        {"zh": "你往边上跑也没用。", "en": "Running to the side won't help."},
        {"zh": "我的肩有门那么宽。", "en": "My shoulder is as wide as a door."},
        {"zh": "树被我一撞就断。", "en": "Trees snap at my charge."},
        {"zh": "我的影子已经盖到你肩。", "en": "My shadow has reached your shoulders."},
        {"zh": "影子越来越近。", "en": "The shadow is closing in."},
        {"zh": "你退了六步。", "en": "You've taken six steps back."},
        {"zh": "我的步子只用了三下。", "en": "It took me three."},
        {"zh": "你回头望了一眼。", "en": "You glanced back once."},
        {"zh": "那一眼浪费时间。", "en": "That glance cost you time."},
        {"zh": "我又近了。", "en": "I'm closer."},
        {"zh": "你的脚在碎石上滑。", "en": "Your foot slips on gravel."},
        {"zh": "地面不平。", "en": "The ground is uneven."},
        {"zh": "你滑倒的那一下，我看见了。", "en": "I saw that slip of yours."},
        {"zh": "我从来不在乎。", "en": "I never do."},
        {"zh": "你在我这里。", "en": "You're within my reach."},
        {"zh": "就是这一击。", "en": "This is the blow."},
        {"zh": "我这一冲，地面都震。", "en": "One charge of mine shakes the ground."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的肩把你撞飞。", "en": "My shoulder sends you flying."},
        {"zh": "你撞在树上又落下。", "en": "You hit a tree and drop."},
        {"zh": "我的冲撞不停。", "en": "My charge doesn't stop."},
        {"zh": "我把你推开十步远。", "en": "I shove you ten paces."},
        {"zh": "我的拳头砸在地上。", "en": "My fist smashes the ground."},
        {"zh": "尘土把我罩住。", "en": "Dust swallows me."},
        {"zh": "冲锋撞上，地面都震。", "en": "My charge lands, and the ground shakes."},
        {"zh": "我调头很费劲。", "en": "Turning around costs me."},
        {"zh": "你有时间站起来。", "en": "That gives you time to rise."},
        {"zh": "可你站不稳。", "en": "But you can't stand steady."},
        {"zh": "我瞧见你缩了。", "en": "I saw you flinch."},
        {"zh": "我又低下了肩。", "en": "I drop my shoulder again."},
        {"zh": "这一下比刚才重。", "en": "This one lands heavier."},
        {"zh": "我的肩把你撞飞了。", "en": "My shoulder sent you flying."},
        {"zh": "你还在喘。", "en": "You're still breathing."},
        {"zh": "我一冲起来，地上的东西都飞。", "en": "When I charge, everything on the ground flies."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地面先陷下去一块。", "en": "The ground sinks first."},
        {"zh": "我从雾里站起来。", "en": "I rise out of the mist."},
        {"zh": "树在我脚边断了。", "en": "Trees break at my feet."},
        {"zh": "我低头，雾才散开。", "en": "I lower my head, and the mist clears."},
        {"zh": "我张开手，抓了一把空气。", "en": "I open a hand and scoop the air."},
        {"zh": "这一片都太小了。", "en": "Everything here is too small."},
        {"zh": "我的呼吸让雾散开。", "en": "My breath parts the mist."},
        {"zh": "我抬起脚，慢慢落下。", "en": "I lift a foot and lower it slowly."},
        {"zh": "地面响了一声。", "en": "The ground cracks."},
        {"zh": "雾散开，我看见了你的火。", "en": "The mist parts. I see your fire."},
        {"zh": "这里东西不多。", "en": "There isn't much here."},
        {"zh": "有你在就够了。", "en": "You're enough."},
        {"zh": "你别站着不动。", "en": "Don't stand still."},
        {"zh": "那太没有意思了。", "en": "That's no fun."},
        {"zh": "你跑起来吧。", "en": "Go on and run."},
        {"zh": "跑的时候我才开始。", "en": "I only begin when you run."},
        {"zh": "我把肩对正了。", "en": "I square my shoulder."},
        {"zh": "我的脚深深踩进土。", "en": "My foot sinks deep into soil."},
        {"zh": "我的脚陷得更深了。", "en": "My feet sink deeper."},
        {"zh": "开场。", "en": "The opening."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在我身上烧得很小。", "en": "Fire burns small on me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地时压塌了一片地。", "en": "I land and crush the ground flat."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水只到我腰，但很凉。", "en": "Water reaches my waist. It's cold."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风只把我推了半步。", "en": "The blast shoves me half a step."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西连皮都没扎穿。", "en": "That didn't even break my hide."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的腿一顿。", "en": "Magic stalls my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿不着我这种块头。", "en": "A frame like mine doesn't starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我肩上，我抖了。", "en": "Lightning hits my shoulder and I shudder."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有地可以踩碎。", "en": "No ground to crush in the void."}
      ]
    }
  }
}
