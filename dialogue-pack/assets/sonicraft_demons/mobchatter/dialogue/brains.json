{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的一只手臂垂着。", "en": "One of my arms hangs limp."},
        {"zh": "我的脚步拖得很响。", "en": "My steps drag noisily."},
        {"zh": "我从破墙边擦过去。", "en": "I brush past the broken wall."},
        {"zh": "我一步一步往前凑。", "en": "I shamble forward step by step."},
        {"zh": "地上有我拖出的痕。", "en": "A drag mark follows my feet."},
        {"zh": "我的一直手伸着。", "en": "One hand of mine stays stretched out."},
        {"zh": "我慢得要命，可不停。", "en": "I'm dreadfully slow, but I don't stop."},
        {"zh": "我又撞到了一堵墙。", "en": "I've bumped into another wall."},
        {"zh": "我转了个方向继续。", "en": "I turn and keep going."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的一只眼睛垂着。", "en": "One of my eyes hangs low."},
        {"zh": "这里连光也透不进来。", "en": "Not even light gets in here."},
        {"zh": "我不太能站得直。", "en": "I can't quite stand straight."},
        {"zh": "有虫在我肩上爬。", "en": "Insects crawl on my shoulder."},
        {"zh": "指节抽了一下，停不下来。", "en": "A knuckle twitches and won't stop."},
        {"zh": "我把脑袋歪着转过去。", "en": "I turn my head with a tilt."},
        {"zh": "我的舌头在嘴里动了一下。", "en": "My tongue shifts inside my mouth."},
        {"zh": "我一点也没有走开。", "en": "I haven't walked off at all."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我仰起脸来看你。", "en": "I raise my face to you."},
        {"zh": "你的脸正对着我。", "en": "Your face is turned to me."},
        {"zh": "我歪着头，说不出话。", "en": "I tilt my head, unable to speak."},
        {"zh": "我们隔着几步距离。", "en": "A few steps separate us."},
        {"zh": "手抬到一半就停住了。", "en": "My hand stops halfway up."},
        {"zh": "你能听得懂我吗。", "en": "Can you understand me?"},
        {"zh": "你要不要靠过来。", "en": "Why not come closer?"},
        {"zh": "你的呼吸很不平稳。", "en": "Your breathing is very unsteady."},
        {"zh": "我的脚好像走不动。", "en": "My feet don't seem to move."},
        {"zh": "你看我时，我忘了要说什么。", "en": "While you look at me, I forget what to say."},
        {"zh": "我往前倾了倾身子。", "en": "I leaned my body forward a little."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了一步，摇晃着。", "en": "I stepped back, swaying."},
        {"zh": "我身上又破了一块。", "en": "Another part of me tore open."},
        {"zh": "我慢慢直起了身子。", "en": "I slowly straightened up."},
        {"zh": "我没有觉得多疼。", "en": "I didn't feel much pain."},
        {"zh": "我又朝前挪了一步。", "en": "I shuffled forward a step."},
        {"zh": "我的手臂垂得更低。", "en": "My arm hangs even lower."},
        {"zh": "我的头又歪回去了。", "en": "My head tilted back again."},
        {"zh": "脑袋还在，身体可不一定。", "en": "My head's still here. The body, not so sure."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么东西。", "en": "What is that thing?"},
        {"zh": "我朝它那边挪过去。", "en": "I shuffle toward it."},
        {"zh": "它闻着像活的东西。", "en": "It smells like something alive."},
        {"zh": "我的手指抓不住它。", "en": "My fingers can't grip it."},
        {"zh": "你的手不要收回去。", "en": "Don't pull your hand back."},
        {"zh": "我慢慢地伸过去了。", "en": "I'm reaching over slowly."},
        {"zh": "我好像有点想要它。", "en": "I think I want it a little."},
        {"zh": "它掉在地上面了。", "en": "It dropped on the ground."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到了我的肩膀。", "en": "You touched my shoulder."},
        {"zh": "我扶了一下墙，没扶住。", "en": "I reach for the wall and miss."},
        {"zh": "我差一点就倒了。", "en": "I very nearly fell over."},
        {"zh": "你缩回手时直发抖。", "en": "Your hand shook as it withdrew."},
        {"zh": "我的身体凉得厉害。", "en": "My body is dreadfully cold."},
        {"zh": "我们撞得闷闷一响。", "en": "We met with a dull thud."},
        {"zh": "你被我挤到了墙边。", "en": "I pressed you toward the wall."},
        {"zh": "我的手抓了一下空气。", "en": "My hand grabbed at the air."},
        {"zh": "这一下把我撞懵了。", "en": "That left me dazed."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我大概记得些什么。", "en": "I think I remember something."},
        {"zh": "那张脸我没有忘记。", "en": "I haven't forgotten that face."},
        {"zh": "我把冷手搭在你腕上。", "en": "I lay my cold hand on your wrist."},
        {"zh": "你的身体也这么凉。", "en": "Your body is this cold too."},
        {"zh": "我们都不太像人了。", "en": "Neither of us is quite human."},
        {"zh": "并排站着其实不坏。", "en": "Standing side by side isn't bad."},
        {"zh": "我抓着你的袖子。", "en": "I've got your sleeve."},
        {"zh": "不要走得太远了。", "en": "Don't go too far away."},
        {"zh": "这条路我们走过。", "en": "We've walked this road before."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰想捡起它。", "en": "I bend to pick it up."},
        {"zh": "我的手指抓不牢。", "en": "My fingers can't hold it."},
        {"zh": "你的东西落在这边。", "en": "Your thing came down over here."},
        {"zh": "我抬起手端详它。", "en": "I lift it to study it."},
        {"zh": "我咬了一下试试。", "en": "I bite it to try."},
        {"zh": "我咬住它，牙咬出了印。", "en": "I bite it, leaving tooth marks."},
        {"zh": "它有一股血腥气。", "en": "It gives off a smell of blood."},
        {"zh": "我慢慢地放下了它。", "en": "I set it down slowly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你就在我的前面。", "en": "You're right in front of me."},
        {"zh": "我一步步朝你挪去。", "en": "I shuffle toward you step by step."},
        {"zh": "你的气味非常重。", "en": "Your scent is very strong."},
        {"zh": "我的脚步忽然快了。", "en": "My steps have suddenly quickened."},
        {"zh": "你往那边的门跑了。", "en": "You've run for that door."},
        {"zh": "那扇门打不开。", "en": "That door won't open."},
        {"zh": "我一点一点逼近你。", "en": "I'm closing in bit by bit."},
        {"zh": "我伸着手走过去。", "en": "I walk over with my hand out."},
        {"zh": "你退到柜子后面了。", "en": "You've backed behind the cabinet."},
        {"zh": "柜子挡不住我的。", "en": "The cabinet won't stop me."},
        {"zh": "你的方位我已经锁定。", "en": "Your bearing is locked in."},
        {"zh": "我和你已经近在咫尺。", "en": "You and I are nearly touching."},
        {"zh": "我开始加快脚步了。", "en": "I'm speeding up my steps."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在门边等着你。", "en": "I'm waiting by the door."},
        {"zh": "我的手指刮着墙。", "en": "My fingers scrape the wall."},
        {"zh": "你躲在桌子下面。", "en": "You're hiding under the table."},
        {"zh": "那张桌子太矮了。", "en": "That table is too low."},
        {"zh": "我一步一步挪近你。", "en": "I shuffle closer step by step."},
        {"zh": "你屏住了呼吸。", "en": "You've held your breath."},
        {"zh": "我的手指在墙上刮出三道。", "en": "My fingers gouge three lines in the wall."},
        {"zh": "我和你只隔一步。", "en": "Only one step parts us."},
        {"zh": "后面已经没有墙了。", "en": "There's no more wall behind you."},
        {"zh": "我偏着头盯住你。", "en": "I tilt my head and stare."},
        {"zh": "声音卡在喉咙里出不来。", "en": "The sound sticks in my throat."},
        {"zh": "我把手一点点伸出去。", "en": "I extend my hand by degrees."},
        {"zh": "你不要往前面跑。", "en": "Don't run forward."},
        {"zh": "你已经没有地方了。", "en": "You've nowhere left to go."},
        {"zh": "我这就到你面前。", "en": "I'll be before you in a moment."},
        {"zh": "我听见你的牙齿响。", "en": "I hear your teeth chattering."},
        {"zh": "现在我抓住你了。", "en": "Now I've got you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的指甲陷进去了。", "en": "My nails dug in."},
        {"zh": "你被拉得往前一步。", "en": "You were pulled forward a step."},
        {"zh": "我一口咬向你。", "en": "I snap my teeth at you."},
        {"zh": "这一下很生硬。", "en": "That was very clumsy."},
        {"zh": "你甩开了我的手。", "en": "You shook my hand off."},
        {"zh": "我踉跄着又扑上来。", "en": "I staggered and lunged again."},
        {"zh": "我的手碰到了你的脸。", "en": "My hand touched your face."},
        {"zh": "你被推到了墙边。", "en": "You've been pushed to the wall."},
        {"zh": "我的身体压了上来。", "en": "My body pressed against you."},
        {"zh": "我没有往后退。", "en": "I didn't back away."},
        {"zh": "我的手还伸在外面。", "en": "My hand is still out."},
        {"zh": "你越挣我抓得越紧。", "en": "The more you struggle, the tighter I grip."},
        {"zh": "我把头缓缓垂下去。", "en": "I let my head sink slowly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从墙角站了起来。", "en": "I rise up in the corner."},
        {"zh": "我从门后的暗处站起来。", "en": "I rise from the dark behind the door."},
        {"zh": "这里又暗又安静。", "en": "It's dark here, and quiet."},
        {"zh": "地上有水渍和灰。", "en": "There's damp and dust on the floor."},
        {"zh": "我慢慢地迈出一步。", "en": "I take one slow step."},
        {"zh": "远处有脚步的声音。", "en": "There are footsteps in the distance."},
        {"zh": "我朝那边走了过去。", "en": "I walk toward them."},
        {"zh": "我的衣服上沾了灰。", "en": "My clothes are covered in dust."},
        {"zh": "风从破窗里进来。", "en": "Wind comes through the broken window."},
        {"zh": "我站在一扇门前面。", "en": "I'm standing in front of a door."},
        {"zh": "门那边有活的东西。", "en": "Something living is beyond it."},
        {"zh": "我慢慢地推那扇门。", "en": "I push the door slowly."},
        {"zh": "我开始往里面走。", "en": "I start walking in."},
        {"zh": "门轴响了一下。", "en": "The hinge gave a creak."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎着我，我冒起烟。", "en": "Fire caught me and I smoked."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下去，爬不起来。", "en": "I fell and couldn't get up."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我的半边身子贴在墙上。", "en": "Half my body is pressed against the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭钻进我的肩肉。", "en": "An arrow bored into my shoulder."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我很久没有吃东西。", "en": "I haven't eaten in a long time."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电光把我照得发青。", "en": "The flash turned me sickly pale."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我脚下已经没有东西。", "en": "There's nothing under my feet now."}
      ]
    }
  }
}
