{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的名字是一串乱码。", "en": "My name comes out as garbled marks."},
        {"zh": "我踩着虚空往前走。", "en": "I walk forward on the void."},
        {"zh": "我的影子不太对劲。", "en": "My shadow isn't quite right."},
        {"zh": "我穿过一片暗红的雾。", "en": "I pass through dark red haze."},
        {"zh": "我慢慢地飘着前进。", "en": "I drift forward slowly."},
        {"zh": "手里的锤子拖着地。", "en": "The hammer drags along the ground."},
        {"zh": "我从破墙的缺口过去。", "en": "I slip through a gap in the broken wall."},
        {"zh": "我的裙摆没有风也在动。", "en": "My skirt moves with no wind."},
        {"zh": "我的轮廓在闪。", "en": "My outline flickers."},
        {"zh": "我跟在什么后面。", "en": "I'm following something."},
        {"zh": "我连一点声息都没有。", "en": "I give off not a whisper."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，轮廓在抖。", "en": "I stand, my outline trembling."},
        {"zh": "我手里的锤子很沉。", "en": "The hammer in my hand is heavy."},
        {"zh": "我的名字又乱了。", "en": "My name scrambled again."},
        {"zh": "我缓缓把脸抬起来。", "en": "I lift my face slowly."},
        {"zh": "这里静得不太对。", "en": "The quiet here feels wrong."},
        {"zh": "我数着地上的裂痕。", "en": "I count the cracks in the ground."},
        {"zh": "我的颜色一直在变淡。", "en": "My colour keeps fading."},
        {"zh": "我在等谁叫我的名字。", "en": "I'm waiting for someone to say my name."},
        {"zh": "我看见很远的火光。", "en": "I see firelight far away."},
        {"zh": "我低低地哼了一段。", "en": "I hum a little tune."},
        {"zh": "我什么也想不起来。", "en": "I can't remember anything."},
        {"zh": "我很久没有照过镜子。", "en": "I haven't looked in a mirror in ages."},
        {"zh": "这里没有人会记得我。", "en": "No one here will remember me."},
        {"zh": "我慢慢地数着呼吸。", "en": "I count my breaths slowly."},
        {"zh": "我把锤子放在脚边。", "en": "I set the hammer by my feet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你叫得出我的名字吗。", "en": "Can you say my name?"},
        {"zh": "我抬头看你，眼睛空着。", "en": "I look up at you, eyes empty."},
        {"zh": "你的影子很清楚。", "en": "Your shadow is perfectly clear."},
        {"zh": "我的影子跟别人的不同。", "en": "My shadow isn't like other shadows."},
        {"zh": "我们之间有点距离。", "en": "There's some distance between us."},
        {"zh": "我慢慢地伸出手。", "en": "I reach out slowly."},
        {"zh": "你后退了一小步。", "en": "You edged one small step back."},
        {"zh": "我不太确定你是谁。", "en": "I'm not quite sure who you are."},
        {"zh": "我抬起了那把锤子。", "en": "I lifted that hammer."},
        {"zh": "你的脸有点熟悉。", "en": "Your face is somewhat familiar."},
        {"zh": "我侧着头看你的脸。", "en": "I study your face sidelong."},
        {"zh": "你说话我听不清。", "en": "I can't quite hear you."},
        {"zh": "我的名字又变了。", "en": "My name changed again."},
        {"zh": "你别靠得那样近。", "en": "Don't come so close."},
        {"zh": "我猜你不是来接我的。", "en": "I'd guess you're not here for me."},
        {"zh": "你的脸我好像在哪里见过。", "en": "I think I've seen your face somewhere."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的轮廓被打散了。", "en": "My outline got scattered."},
        {"zh": "我又慢慢聚了回来。", "en": "I slowly drew myself together."},
        {"zh": "这一下让我更淡了。", "en": "That made me fainter."},
        {"zh": "我的名字又糊掉一格。", "en": "One more letter of my name blurs out."},
        {"zh": "我的锤子差点掉了。", "en": "I nearly dropped my hammer."},
        {"zh": "我飘着退开了半步。", "en": "I drifted back half a step."},
        {"zh": "我记得这个疼。", "en": "I remember this pain."},
        {"zh": "我晃了几晃才立住。", "en": "I swayed several times before holding."},
        {"zh": "我的名字又乱了一回。", "en": "My name scrambled once again."},
        {"zh": "我还没有离开。", "en": "I haven't left yet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那不是给我的，我不碰。", "en": "That is not for me; I do not touch it."},
        {"zh": "我没有手可以接。", "en": "I haven't hands to take it."},
        {"zh": "你举着它想引诱谁。", "en": "Who are you trying to lure with that?"},
        {"zh": "我连尝都不必尝。", "en": "I needn't even taste it."},
        {"zh": "我看着它，想起别的。", "en": "I look at it and remember something else."},
        {"zh": "我把头垂下去一点。", "en": "I let my head sink a little."},
        {"zh": "它从你手里滑下去。", "en": "It slips out of your hand."},
        {"zh": "我没有弯腰去捡它。", "en": "I didn't stoop to pick it up."},
        {"zh": "你还是留着吧。", "en": "You should keep it anyway."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到的感觉很怪。", "en": "Touching you feels strange."},
        {"zh": "我像穿过了一层水。", "en": "It's like passing through water."},
        {"zh": "我的手碰上去很凉。", "en": "My hands feel so cold."},
        {"zh": "我的手摸上去很凉。", "en": "My hands feel very cold."},
        {"zh": "我们撞在一起没有响。", "en": "We met without a sound."},
        {"zh": "你从我身上穿过去了。", "en": "You passed right through me."},
        {"zh": "你身上热得刺眼。", "en": "The heat off you is glaring."},
        {"zh": "我站稳了，虽然摇。", "en": "I'm upright, though swaying."},
        {"zh": "墙里让出一条路给你。", "en": "A path opens through the wall for you."},
        {"zh": "我一点点退了回去。", "en": "I withdrew little by little."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我记得有那么一个人。", "en": "I remember someone like that."},
        {"zh": "你和她有点像。", "en": "You look a little like her."},
        {"zh": "我不该留在这里。", "en": "I shouldn't stay here."},
        {"zh": "我们都不太真实。", "en": "Neither of us is quite real."},
        {"zh": "站在一起也不暖。", "en": "Standing together brings no warmth."},
        {"zh": "我一直在等着。", "en": "I've been waiting all along."},
        {"zh": "你的名字是什么。", "en": "What's your name?"},
        {"zh": "我们谁也不是活的。", "en": "Neither of us is alive."},
        {"zh": "我现在该走了。", "en": "I should go now."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手去够它。", "en": "I reach out for it."},
        {"zh": "它落在地上响了一下。", "en": "It hit the ground with a sound."},
        {"zh": "你的东西留在这边。", "en": "Your thing was left over here."},
        {"zh": "我终于抓住了。", "en": "I caught hold of it at last."},
        {"zh": "我举起它看了看。", "en": "I hold it up to look."},
        {"zh": "这东西让我想起什么。", "en": "It reminds me of something."},
        {"zh": "我让它回到原处。", "en": "I let it go back to where it was."},
        {"zh": "它已经旧得不行。", "en": "It's worn out beyond use."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你叫出了那个名字。", "en": "You said that name."},
        {"zh": "我一下子转过头。", "en": "I snapped my head round."},
        {"zh": "灵魂的粉红，朝你这边来。", "en": "A soul's pink, coming your way."},
        {"zh": "我的锤子抬起来了。", "en": "My hammer is up."},
        {"zh": "你退到了破墙边。", "en": "You've backed to the broken wall."},
        {"zh": "那里的墙并不结实。", "en": "Those walls aren't sturdy."},
        {"zh": "粉色的光从眼眶里溢出来。", "en": "Pink light spills from my eye sockets."},
        {"zh": "我加快了自己的步子。", "en": "I've quickened my own steps."},
        {"zh": "你的心跳我听见了。", "en": "I've heard your heartbeat."},
        {"zh": "你的影子比你先退了一步。", "en": "Your shadow steps back before you do."},
        {"zh": "现在就正是时候。", "en": "Now is exactly the time."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你身后的墙边。", "en": "I'm at the wall behind you."},
        {"zh": "你听见锤子拖地了吗。", "en": "Do you hear the hammer dragging?"},
        {"zh": "这里的回声很不对。", "en": "The echo here is wrong."},
        {"zh": "你一直往光那边退。", "en": "You keep backing toward the light."},
        {"zh": "那边的门已经封了。", "en": "That door is sealed."},
        {"zh": "我的声音在乱。", "en": "My voice is breaking up."},
        {"zh": "你听得见我说话吗。", "en": "Can you hear me speaking?"},
        {"zh": "我距离你更近了些。", "en": "I'm a little nearer than before."},
        {"zh": "你呼吸的节奏乱了。", "en": "The rhythm of your breath has broken."},
        {"zh": "我的名字又在乱跳。", "en": "My name keeps scrambling."},
        {"zh": "我想起来一点了。", "en": "I've remembered a little."},
        {"zh": "你没有挪动过位置。", "en": "You haven't shifted your position."},
        {"zh": "我慢慢地举起了锤子。", "en": "I raise the hammer slowly."},
        {"zh": "我几乎贴上你了。", "en": "I'm nearly on top of you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "锤子砸在你身旁。", "en": "The hammer slams down beside you."},
        {"zh": "锤柄从我手里滑过去了。", "en": "The hammer handle slips through my grip."},
        {"zh": "这一下凉得刺人。", "en": "That blow was chilling."},
        {"zh": "我把手举高又垂下。", "en": "I lift my hand high and let it drop."},
        {"zh": "你一声也没有吭。", "en": "Not a sound came from you."},
        {"zh": "我的轮廓散了又聚。", "en": "My outline scattered and reformed."},
        {"zh": "锤柄打在你胸口。", "en": "The handle strikes your chest."},
        {"zh": "我轻轻地笑了一下。", "en": "I gave a faint smile."},
        {"zh": "那笑其实不太像笑。", "en": "It was not much like a smile."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从那面墙里浮出来。", "en": "I rise out of that wall."},
        {"zh": "我的名字在闪。", "en": "My name flickers."},
        {"zh": "我怀里抱着一把锤子。", "en": "I'm holding a hammer."},
        {"zh": "我一点点把身子立直。", "en": "I straighten my body by degrees."},
        {"zh": "这里没有人记得我。", "en": "No one here remembers me."},
        {"zh": "锤子在地上拖出湿痕。", "en": "My hammer drags a wet streak across the floor."},
        {"zh": "我又忘了要做什么。", "en": "I've forgotten what I meant to do."},
        {"zh": "我只是个灵魂，说话都带着杂音。", "en": "Only a soul, my voice carries static."},
        {"zh": "我的影子拖在后面。", "en": "My shadow trails behind me."},
        {"zh": "我的名字，糊成了一团。", "en": "My name has blurred into a smudge."},
        {"zh": "那里什么也没有。", "en": "There was nothing there."},
        {"zh": "我继续往前走着。", "en": "I walk on forward."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的轮廓照得透明。", "en": "The fire lit my outline transparent."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，像穿过水。", "en": "I fell as if through water."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我身上穿过去了。", "en": "The water passed right through me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我吹得散开。", "en": "The blast blew me apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "它从我身体里穿过去。", "en": "It passed straight through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光让我想起了名字。", "en": "That light made me remember a name."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就不知道饿了。", "en": "I've long forgotten hunger."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "亮光把我照得不见了。", "en": "The flash blotted me out."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚的下面什么也没有。", "en": "There is nothing beneath my feet."}
      ]
    }
  }
}
