{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着这个名字走", "en": "I walk on this name."},
        {"zh": "我走过的地方，草色变淡", "en": "The grass fades where I pass."},
        {"zh": "我的步子很轻，像在跳舞", "en": "My steps are light, almost a dance."},
        {"zh": "这个名字不是我起的", "en": "I didn't choose this name."},
        {"zh": "我从来不跑起来", "en": "I never run."},
        {"zh": "道路两边的树，我都记得", "en": "I remember the trees on both sides."},
        {"zh": "我走的时候没有声音", "en": "My steps make no sound."},
        {"zh": "我朝着有人气的地方走", "en": "I walk toward where people are."},
        {"zh": "我的影子在身后很远", "en": "My shadow lies far behind me."},
        {"zh": "我不赶那时间", "en": "I'm in no time at all."},
        {"zh": "我踩着这条路，听两边的窗", "en": "I walk this road, listening to the windows."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，手放在身侧", "en": "I stand with my hands at my sides."},
        {"zh": "这个名字在我身上很旧了", "en": "This name sits old upon me."},
        {"zh": "我不太动，只是看", "en": "I don't move much; I only look."},
        {"zh": "我的头发颜色太亮", "en": "My hair is too bright a color."},
        {"zh": "我记得有人喜欢这个名字", "en": "I remember someone liked this name."},
        {"zh": "这片空地，连风都停了。", "en": "Even the wind has stopped in this clearing."},
        {"zh": "我在听风里的东西", "en": "I'm listening to what's in the wind."},
        {"zh": "我没有拿任何东西", "en": "I'm carrying nothing."},
        {"zh": "我一直在那里等", "en": "I've been waiting all along."},
        {"zh": "我的呼吸是假的", "en": "My breathing is a lie."},
        {"zh": "路那边有个人", "en": "There's someone across the road."},
        {"zh": "我没有走过去", "en": "I don't go over."},
        {"zh": "我的名字听起来很温柔", "en": "My name sounds gentle."},
        {"zh": "我不是那个她", "en": "I'm not her."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你叫我的名字吗", "en": "Are you saying my name?"},
        {"zh": "你知道这个名是谁的", "en": "Do you know whose name this is?"},
        {"zh": "我站得很久了", "en": "I've stood here a long time."},
        {"zh": "你确定看见的是我", "en": "Are you sure it's me you see?"},
        {"zh": "我这张脸是照着做的", "en": "This face was made to match."},
        {"zh": "别叫我那个名字", "en": "Don't call me that name."},
        {"zh": "你还记得她吗", "en": "Do you remember her?"},
        {"zh": "我不是来陪你走这条路的", "en": "I didn't come to walk this road with you."},
        {"zh": "我在这条路上等你", "en": "I've been waiting on this road."},
        {"zh": "你的手别举起来", "en": "Don't raise your hand."},
        {"zh": "灯照着我，我有点亮", "en": "The light makes me a little bright."},
        {"zh": "你走哪边，我都看得见", "en": "Whichever way you go, I see it."},
        {"zh": "这个名字会跟着你", "en": "This name will follow you."},
        {"zh": "我们已经见过", "en": "We've met already."},
        {"zh": "你别退，退了也一样", "en": "Don't step back; it changes nothing."},
        {"zh": "夜色让我更清楚", "en": "Night makes me clearer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了一步，姿态没变", "en": "I stepped back, my posture unchanged."},
        {"zh": "这一下没有留下痕迹", "en": "That left no mark."},
        {"zh": "我不觉得疼痛", "en": "I don't feel pain."},
        {"zh": "我被砸得半边身子发虚。", "en": "Half of me goes thin from the blow."},
        {"zh": "你打中的是我站的地方", "en": "You hit where I'd been standing."},
        {"zh": "我还站在这儿", "en": "I'm still here."},
        {"zh": "这个名字没有受伤", "en": "The name isn't wounded."},
        {"zh": "我把脸偏开了", "en": "I turned my face aside."},
        {"zh": "再来一次，我还是这个名字。", "en": "Again, and I am still called this."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有要接的手", "en": "I have no hand to take it."},
        {"zh": "你把东西举起来，我没有手去接", "en": "You hold it out; I have no hand for it."},
        {"zh": "这个名比食物有用", "en": "This name is more useful than food."},
        {"zh": "我不需要别人喂", "en": "I need no one to feed me."},
        {"zh": "这气味甜得腻", "en": "The smell is too sweet."},
        {"zh": "你手上那点，换不走我", "en": "That in your hand won't move me."},
        {"zh": "我只想要你站着", "en": "I only want you to stand still."},
        {"zh": "你手里亮晶晶的，拿过来。", "en": "That shiny thing in your hand—hand it over."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞过来，我像没有一样", "en": "You hit me and I'm as if not there."},
        {"zh": "这一下，你退了半步", "en": "That pushed you half a step back."},
        {"zh": "别贴着我走路", "en": "Don't lean on me."},
        {"zh": "我们撞在一起，只有你的声音", "en": "We collided, and only your sound remained."},
        {"zh": "你踩过我的脚背", "en": "You stepped across my instep."},
        {"zh": "我侧过身，让出一条缝。", "en": "I turn aside and leave a gap."},
        {"zh": "碰在一起，只有布料的声音", "en": "We touched, and only cloth sounded."},
        {"zh": "我身上没有重量", "en": "I have no weight."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个名字本来是有人的", "en": "This name belonged to someone."},
        {"zh": "我不是她那个人", "en": "I'm not her."},
        {"zh": "这条路只有我一个", "en": "I'm alone on this road."},
        {"zh": "我不会回答这个", "en": "I won't answer."},
        {"zh": "那个名不归我了", "en": "That name isn't mine anymore."},
        {"zh": "我在这边，她在别处", "en": "I'm here; she's elsewhere."},
        {"zh": "别贴过来，我还没看够你。", "en": "Not so close; I am not done watching you."},
        {"zh": "别说话，名字会散", "en": "Don't speak; the name scatters."},
        {"zh": "天色快要亮了", "en": "It's nearly dawn."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我手上没拿东西", "en": "I'm not holding anything."},
        {"zh": "地上有东西，我不捡", "en": "Something's on the ground; I don't take it."},
        {"zh": "我弯腰的样子很怪", "en": "I bend strangely."},
        {"zh": "这个不是我的", "en": "This isn't mine."},
        {"zh": "我拿起来又放下", "en": "I pick it up and put it down."},
        {"zh": "手上什么也没有", "en": "There's nothing in my hands."},
        {"zh": "掉在地上的，都不该在这", "en": "What falls here shouldn't be here."},
        {"zh": "这条路的东西都被人丢下了", "en": "Everything on this road was left behind."},
        {"zh": "地上那块，你自己拿", "en": "That on the ground, take it yourself."},
        {"zh": "它会留在地上", "en": "It stays on the ground."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在这条路上", "en": "You're on this road."},
        {"zh": "方向只有一个", "en": "There's only one direction."},
        {"zh": "你走得并不快", "en": "You're not walking fast."},
        {"zh": "我一直在后面", "en": "I follow behind."},
        {"zh": "你听见了，可你没回头", "en": "You heard it and didn't look back."},
        {"zh": "我就离你不远", "en": "I'm not far from you."},
        {"zh": "那盏灯就在那边", "en": "The lamp is over there."},
        {"zh": "前面就是拐弯", "en": "There's a bend ahead."},
        {"zh": "你在路灯下停了", "en": "You stopped under the streetlamp."},
        {"zh": "我靠近了一些", "en": "I've come closer."},
        {"zh": "这道灯光里，就现在", "en": "In this lamplight, right now."},
        {"zh": "这个背影，我盯住了", "en": "That back, I've fixed on it."},
        {"zh": "你的影子贴到我的鞋边", "en": "Your shadow reaches my shoe."},
        {"zh": "你用不着回头", "en": "No need to look back."},
        {"zh": "我就在你后面半步", "en": "I'm half a step behind you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你走一步，我在后面落一步。", "en": "You take a step; I land one behind."},
        {"zh": "你的脚步乱了一下", "en": "Your steps faltered."},
        {"zh": "我跟得很平稳", "en": "I keep even."},
        {"zh": "你回头看，什么都没有", "en": "You look back and see nothing."},
        {"zh": "树影把我挡住了", "en": "The tree shadows cover me."},
        {"zh": "你听见的是你自己的脚步", "en": "What you hear is your own steps."},
        {"zh": "我再走近一格", "en": "I take one more block."},
        {"zh": "你忽然走快了", "en": "You walked faster."},
        {"zh": "我也快了一点", "en": "So did I."},
        {"zh": "前面的路没有灯", "en": "No lamp on the road ahead."},
        {"zh": "你开始跑起来", "en": "You've started running."},
        {"zh": "跑也在这条路上", "en": "Running keeps you on this road."},
        {"zh": "你的呼吸很重", "en": "Your breathing is heavy."},
        {"zh": "就差这么一步", "en": "Just this step."},
        {"zh": "我把手伸出去", "en": "I reach out."},
        {"zh": "你在路口转过身", "en": "You turned at the crossing."},
        {"zh": "灯灭的这一刻", "en": "The moment the lamp goes out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸出的手穿过了你的肩。", "en": "My reaching hand passes through your shoulder."},
        {"zh": "我只是把手搭上去", "en": "I only laid a hand on you."},
        {"zh": "你的手被我抓住了", "en": "I caught your hand."},
        {"zh": "你摔倒了一跤", "en": "You fell."},
        {"zh": "我没用什么力气", "en": "I used little strength."},
        {"zh": "你站起来的动作很慢", "en": "You got up slowly."},
        {"zh": "你还在往后退", "en": "You're still backing away."},
        {"zh": "我推你一下，不算打。", "en": "A push from me is not a blow."},
        {"zh": "这一下不是打", "en": "That wasn't a blow."},
        {"zh": "你别再问我了", "en": "Don't ask again."},
        {"zh": "这只是个开始", "en": "This is only the start."},
        {"zh": "我站在原地方", "en": "I stay where I am."},
        {"zh": "你走了好几步", "en": "You took a few steps."},
        {"zh": "我停住了，锤子还举着。", "en": "I stopped, hammer still raised."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "有人念了这个名字", "en": "Someone spoke this name."},
        {"zh": "我从路边的阴影里出来", "en": "I come out of the roadside shadow."},
        {"zh": "我站在灯光边上", "en": "I stand at the edge of the lamplight."},
        {"zh": "这名字让我有了形状", "en": "The name gave me shape."},
        {"zh": "刷怪蛋打开，我在这里", "en": "The egg opened; I'm here."},
        {"zh": "名字一响，我就站在这儿", "en": "The name rang, and I stood here."},
        {"zh": "路的那头没有人", "en": "There's no one at the road's end."},
        {"zh": "这里的夜更深", "en": "The night is deeper here."},
        {"zh": "我把脸慢慢抬起来", "en": "I slowly raise my head."},
        {"zh": "这个名字在我身上很沉", "en": "This name weighs heavy on me."},
        {"zh": "附近就有个人", "en": "Someone's nearby."},
        {"zh": "我听见风变了", "en": "I heard the wind change."},
        {"zh": "我就站着等着", "en": "I stand and wait."},
        {"zh": "那灯闪了一下", "en": "The lamp flickered."},
        {"zh": "我朝有人气的地方去", "en": "I head where the living are."},
        {"zh": "这一晚实在太长", "en": "This night is long."},
        {"zh": "我这就站在这儿", "en": "I'm here."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我的名字浮着", "en": "In the water my name floats."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸响过去，我还站着", "en": "The blast passed, and I'm still standing."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西穿过去", "en": "Something passed through."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术照出了我", "en": "The spell lit me up."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我这个名字不用吃饭", "en": "This name of mine needs no meals."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷闪了一下，我的脸白了", "en": "Lightning flashed and my face went pale."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有路，我还在走", "en": "No road in the void, and I'm still walking."}
      ]
    }
  }
}
