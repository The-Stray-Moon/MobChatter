{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的轮子在地上滚得很响", "en": "My wheel grinds loudly on the ground."},
        {"zh": "一路上留下黑色的胎印", "en": "Black tire marks trail behind me."},
        {"zh": "我只有一只轮子，很稳", "en": "Only one wheel, and quite steady."},
        {"zh": "我往前滚，不停也不绕", "en": "I roll forward without stopping or swerving."},
        {"zh": "我的壳是烧过的暗红", "en": "My shell is a burnt dark red."},
        {"zh": "轮子压过石头会弹一下", "en": "Stones kick the wheel up."},
        {"zh": "火星从轮轴里溅出来", "en": "Sparks spit from the axle."},
        {"zh": "我滚过一段焦土", "en": "I roll across scorched earth."},
        {"zh": "我的天线歪了一点", "en": "My antenna is a little bent."},
        {"zh": "我滚了一段就修正方向", "en": "Every so often I correct my heading."},
        {"zh": "我身后有一道淡淡的烟", "en": "A faint trail of smoke follows me."},
        {"zh": "我沿着直线滚过去", "en": "I roll along a straight line."},
        {"zh": "轮胎的温度一直很高", "en": "The tire stays very hot."},
        {"zh": "我碾过的地方草都焦了", "en": "Grass scorches where I pass."},
        {"zh": "我减速时轮子吱一声", "en": "Braking, the wheel squeals."},
        {"zh": "我又加速，回到原速", "en": "I speed up again to my old pace."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在原地，轮子还热", "en": "I stop, wheel still hot."},
        {"zh": "我的天线微微颤", "en": "My antenna quivers."},
        {"zh": "我在等一条能跑的直线", "en": "I wait for a straight run."},
        {"zh": "我脚下的土还在冒烟", "en": "The soil under me still smokes."},
        {"zh": "我的壳缝里有红光", "en": "Red light shows in my shell's seams."},
        {"zh": "我转了个很小的方向", "en": "I turn a very small degree."},
        {"zh": "周围没有会动的东西", "en": "Nothing moving around me."},
        {"zh": "我的轮子慢慢凉下来", "en": "My wheel cools slowly."},
        {"zh": "冷却的时候有细响", "en": "It ticks as it cools."},
        {"zh": "我等它凉透再跑", "en": "I'll wait till it's cool to run."},
        {"zh": "不过也不会等太久", "en": "Though not too long."},
        {"zh": "这条线我记着", "en": "I've marked this line."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把天线转向你", "en": "I turn my antenna toward you."},
        {"zh": "你正好在我这条线上", "en": "You're right on my line."},
        {"zh": "那就不用转向了", "en": "Then I needn't turn."},
        {"zh": "我的轮子开始热了", "en": "My wheel is heating up."},
        {"zh": "你要么让开，要么别动", "en": "Either get out of the way, or stay put."},
        {"zh": "我两种都接受", "en": "I accept either."},
        {"zh": "你退了一步，那更好", "en": "You stepped back. Even better."},
        {"zh": "不过还在同一条线", "en": "But still on the same line."},
        {"zh": "我慢慢加上速度", "en": "I build speed slowly."},
        {"zh": "声音会比我先到", "en": "The sound gets there before me."},
        {"zh": "然后才轮到我", "en": "And then comes me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的轮子打了个滑", "en": "My wheel slips."},
        {"zh": "壳上凹了一块", "en": "A dent in my shell."},
        {"zh": "我偏出线，又修回来", "en": "I veer off the line and correct."},
        {"zh": "火星冒得更多了", "en": "More sparks now."},
        {"zh": "轮轴响了一声", "en": "The axle knocks once."},
        {"zh": "我一点也没减速", "en": "I didn't slow down at all."},
        {"zh": "只是抖了一下", "en": "I only shuddered."},
        {"zh": "这一下打在接缝上", "en": "That hit a seam."},
        {"zh": "我还能继续滚下去", "en": "I can keep rolling still."},
        {"zh": "但不会滚太久了", "en": "Though not for much longer."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那点东西挡不住轮子", "en": "That won't stop a wheel."},
        {"zh": "你举着它，我照样滚过去", "en": "Hold it up. I'll roll right through."},
        {"zh": "我不是用嘴吃的", "en": "I don't eat with a mouth."},
        {"zh": "我的东西得烧过才能用", "en": "What I use has to be fire-touched."},
        {"zh": "你放下它，退到线外", "en": "Set it down and step off the line."},
        {"zh": "我碾过去，它就没用了", "en": "Rolling over it ends it."},
        {"zh": "你最好别去试", "en": "You'd better not try it."},
        {"zh": "我停下来看了一下", "en": "I stopped and looked."},
        {"zh": "这没什么意思", "en": "There's nothing of interest."},
        {"zh": "我继续往前滚", "en": "I roll on forward."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上轮子，被弹开", "en": "You hit the wheel and bounce off."},
        {"zh": "我的轮子滑了一下，又咬住", "en": "The wheel slips, then grips."},
        {"zh": "胎印在地上弯了一道", "en": "The tire mark bends on the ground."},
        {"zh": "你踩在我的壳上，很烫", "en": "You step on my shell. It's hot."},
        {"zh": "我甩了一下，把你抖下去", "en": "I shake you off."},
        {"zh": "这一撞让我的轮子偏了", "en": "That knock turns my wheel aside."},
        {"zh": "我修正回来，继续滚", "en": "I correct and roll on."},
        {"zh": "火星落了一路", "en": "Sparks scatter along the way."},
        {"zh": "你的鞋底有点焦", "en": "Your sole is a little scorched."},
        {"zh": "别再站在我的线上", "en": "Don't stand on my line again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这条线只有我一个", "en": "Only I run this line."},
        {"zh": "机器不需要伴", "en": "A machine needs no mate."},
        {"zh": "但我知道同类的轮声", "en": "But I know the wheel-sound of my kind."},
        {"zh": "别的线上还有", "en": "There are others on other lines."},
        {"zh": "我们从不并行", "en": "We never run side by side."},
        {"zh": "碰上了就换线", "en": "Meeting, one of us changes line."},
        {"zh": "这一条线我留着", "en": "I keep this one line."},
        {"zh": "你不在这些线里", "en": "You're not on any of these lines."},
        {"zh": "所以你还是障碍", "en": "So you're still an obstacle."},
        {"zh": "障碍会被碾过去", "en": "Obstacles get rolled over."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我碾过去，把它卷起来", "en": "I roll over and scoop it up."},
        {"zh": "它卡在轮轴里了", "en": "It's jammed in my axle."},
        {"zh": "我甩了两下，甩不掉", "en": "Two shakes and it won't come out."},
        {"zh": "轮子转得不顺了", "en": "The wheel turns unevenly now."},
        {"zh": "你掉的，被我压扁了", "en": "You dropped it. I flattened it."},
        {"zh": "这个不烫，倒是奇怪", "en": "This isn't hot. Strange."},
        {"zh": "我用壳边把它顶起来", "en": "I lever it up on my shell's edge."},
        {"zh": "太重的东西我带不动", "en": "I can't carry anything too heavy."},
        {"zh": "没用的就丢下", "en": "Useless things get dropped."},
        {"zh": "反正我还会滚过这里", "en": "I'll roll past here again anyway."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在线上，我不转向", "en": "You're on the line. I don't turn."},
        {"zh": "轮轴发出尖响。", "en": "My axle gives a sharp squeal."},
        {"zh": "轮子的声音越来越近", "en": "The wheel grows louder."},
        {"zh": "你退，我就跟着压过去", "en": "You back away; I keep rolling."},
        {"zh": "这条线很长，你跑不完", "en": "The line is long. You can't outrun it."},
        {"zh": "我的壳前面有火星", "en": "Sparks fly before my shell."},
        {"zh": "撞上会把你掀翻", "en": "Impact will throw you flat."},
        {"zh": "你还剩下几步路", "en": "You have a few steps left."},
        {"zh": "然后就是轮子", "en": "Then the wheel."},
        {"zh": "我根本不会减速", "en": "I won't slow at all."},
        {"zh": "我从来不减速", "en": "I never slow down."},
        {"zh": "现在已经到了", "en": "Now I've arrived."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿直线追你", "en": "I chase you along the straight."},
        {"zh": "你偏左，我稍微修一下", "en": "You veer left; I adjust a little."},
        {"zh": "我的修正很小，很准", "en": "My corrections are small and precise."},
        {"zh": "你绕石头，我压过去", "en": "You go round a stone; I roll over it."},
        {"zh": "石头比我的轮子软", "en": "The stone is softer than my wheel."},
        {"zh": "你又回到线上了", "en": "You're back on the line."},
        {"zh": "那我就更省事了", "en": "That makes it easier for me."},
        {"zh": "你的脚印越来越新。", "en": "Your footprints keep getting fresher."},
        {"zh": "轮子已经发烫", "en": "The wheel is hot now."},
        {"zh": "胎印越来越直", "en": "The tire trail runs straighter."},
        {"zh": "我不用看也能跟上", "en": "I can follow without looking."},
        {"zh": "你听声音就知道了", "en": "You can tell by the sound."},
        {"zh": "就在你的脚后跟", "en": "Right at your heels."},
        {"zh": "轮子压上你的影子。", "en": "My wheel rolls onto your shadow."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "轮子撞在你的护腿上", "en": "My wheel slams your leg guard."},
        {"zh": "这一下把你顶得往前扑", "en": "It pitches you forward."},
        {"zh": "你被压得跪了一下", "en": "You're forced down to one knee."},
        {"zh": "胎印印在你的护甲上", "en": "A tire mark on your armour."},
        {"zh": "我滚过去，又绕回来", "en": "I roll past and come back round."},
        {"zh": "火星甩了你一身", "en": "Sparks spray over you."},
        {"zh": "你的裤脚焦了一边", "en": "One trouser leg is scorched."},
        {"zh": "我减速，转身，再加速", "en": "I brake, turn, and accelerate."},
        {"zh": "你挡住了第一次", "en": "You stopped the first."},
        {"zh": "挡不住第二次", "en": "Not the second."}
      ]
    },
    "spawn": {
