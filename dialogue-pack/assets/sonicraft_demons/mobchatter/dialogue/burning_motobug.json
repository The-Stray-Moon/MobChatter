      "lines": [
        {"zh": "我从一声摩擦里滚出来", "en": "I roll out of a screech of friction."},
        {"zh": "地上立刻多了道黑印", "en": "A black mark appears at once."},
        {"zh": "我的轮子还在转", "en": "My wheel is still spinning."},
        {"zh": "壳上的漆烧掉了一层", "en": "A layer of paint has burnt off my shell."},
        {"zh": "我看了一眼方向", "en": "I check my heading."},
        {"zh": "这条直线很适合我", "en": "This straight suits me."},
        {"zh": "我的天线调整了一次", "en": "My antenna adjusts once."},
        {"zh": "火星从后面拖出来", "en": "Sparks trail behind me."},
        {"zh": "我开始往前滚", "en": "I start rolling forward."},
        {"zh": "速度慢慢起来", "en": "The speed builds."},
        {"zh": "我把车头对准那道影子。", "en": "I point my front at that shadow."},
        {"zh": "正好挡在线中间", "en": "Right in the middle of the line."}
      ]
    },
