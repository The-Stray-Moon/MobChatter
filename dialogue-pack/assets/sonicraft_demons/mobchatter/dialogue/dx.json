{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走得很稳", "en": "I walk with a steady gait."},
        {"zh": "脚步声很沉", "en": "My footsteps land heavily."},
        {"zh": "红色在我身上流动", "en": "Red moves across my body."},
        {"zh": "我不急不慢", "en": "Not fast, not slow."},
        {"zh": "我一步踏响地面", "en": "One step rings on the floor."},
        {"zh": "我的轮廓有点烧焦感", "en": "My outline looks scorched."},
        {"zh": "红鞋踩过地面，没有声音。", "en": "Red shoes cross the floor without a sound."},
        {"zh": "我踩着碎石也不响", "en": "Gravel does not slow my step."},
        {"zh": "我从来不跑", "en": "I never run."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在这里", "en": "I stand here."},
        {"zh": "我在看你的脸", "en": "I am looking at your face."},
        {"zh": "红色还在流动", "en": "The red is still moving."},
        {"zh": "这一处空气不需要我呼吸", "en": "This air needs no breath from me."},
        {"zh": "猩红的名字，写在墙上。", "en": "A crimson name written on the wall."},
        {"zh": "红色的手套，攥紧又松开。", "en": "A red glove tightens, then releases."},
        {"zh": "这个世界比我想的小", "en": "This world is smaller than I expected."},
        {"zh": "我听见远处的风声", "en": "I hear the wind far off."},
        {"zh": "我盯着屏幕上的雪花点。", "en": "I stare at the static on the screen."},
        {"zh": "绯红的影子淡得几乎看不见。", "en": "The crimson shadow is barely visible."},
        {"zh": "我什么都不打算解释", "en": "I intend to explain nothing."},
        {"zh": "我露出了牙", "en": "I showed my teeth."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你就是那个名字", "en": "You are that name."},
        {"zh": "我听过很多次你的名字", "en": "I have heard your name many times."},
        {"zh": "你看起来很清楚", "en": "You look very clear."},
        {"zh": "在这里只有我们", "en": "Only us here."},
        {"zh": "你不要装作不认识我", "en": "Do not pretend not to know me."},
        {"zh": "我知道你认得这个颜色", "en": "I know you recognize this color."},
        {"zh": "你说过你会来", "en": "You said you would come."},
        {"zh": "现在你来了", "en": "Now you are here."},
        {"zh": "别往后退", "en": "Do not step back."},
        {"zh": "你记得那条走廊吗", "en": "Do you remember that corridor?"},
        {"zh": "我记得你关掉了它", "en": "I remember you turned it off."},
        {"zh": "你总是跑得很快", "en": "You always ran fast."},
        {"zh": "这次跑不掉了", "en": "Not this time."},
        {"zh": "你的手在找门", "en": "Your hand is looking for a door."},
        {"zh": "这里没有门", "en": "There is no door here."},
        {"zh": "你看着我的眼睛", "en": "Look at my eyes."},
        {"zh": "我一直是红的那一个", "en": "I was always the red one."},
        {"zh": "你该谢谢我来了", "en": "You should thank me for coming."},
        {"zh": "我们来叙叙旧", "en": "Let us catch up."},
        {"zh": "你还有什么想说的", "en": "Is there anything left to say?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中了", "en": "You landed a hit."},
        {"zh": "红色暗了一下", "en": "The red dimmed."},
        {"zh": "我向后挪了半步", "en": "I shifted back half a pace."},
        {"zh": "这具身体会疼", "en": "This body can feel pain."},
        {"zh": "我看了看伤口", "en": "I looked at the wound."},
        {"zh": "我笑得更明显", "en": "I am smiling wider."},
        {"zh": "我们才刚开始", "en": "We have only begun."},
        {"zh": "别以为这算赢", "en": "Do not think that is winning."},
        {"zh": "我会记住这一下", "en": "I will remember that."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你拿着什么", "en": "What are you holding?"},
        {"zh": "那东西对我不重要", "en": "That means nothing to me."},
        {"zh": "你举着它挡在中间", "en": "You hold it between us."},
        {"zh": "我只想要你", "en": "I only want you."},
        {"zh": "别往后藏，我已经在看着。", "en": "Do not hide back there; I am already watching."},
        {"zh": "它挡不住我", "en": "It cannot stop me."},
        {"zh": "你留着吧，很快用不上", "en": "Keep it, you will not need it long."},
        {"zh": "靠近点，让我看看你的颜色。", "en": "Come closer. Let me see your color."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我了", "en": "You hit me."},
        {"zh": "你退了半步，我没有", "en": "You stepped back, I did not."},
        {"zh": "我的身体很实", "en": "My body is very solid."},
        {"zh": "你的手碰到的是硬的", "en": "What you touched was hard."},
        {"zh": "我被推了一下", "en": "I was pushed."},
        {"zh": "那点力气不够", "en": "That is not enough force."},
        {"zh": "你贴着墙站着", "en": "You are flat against the wall."},
        {"zh": "我把你挤了回去", "en": "I pressed you back."},
        {"zh": "碰撞的声音在走廊回响", "en": "The impact echoes down the hall."},
        {"zh": "你再来一次也没用", "en": "Another try changes nothing."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你不会想这样", "en": "You do not want this."},
        {"zh": "红影不需要另一个红影。", "en": "A crimson shadow needs no second one."},
        {"zh": "这个身体不是为了那个", "en": "This body is not for that."},
        {"zh": "你站住别动", "en": "Stand and do not move."},
        {"zh": "我一直想要点别的", "en": "I have always wanted something else."},
        {"zh": "红色影子，不需要伴侣。", "en": "A crimson shadow needs no mate."},
        {"zh": "你看着我就够了", "en": "Looking at me is enough."},
        {"zh": "别害怕", "en": "Do not be afraid."},
        {"zh": "我还会再来", "en": "I will come again."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿起来了", "en": "I picked it up."},
        {"zh": "我捡起来，只让你少一件。", "en": "I pick it up just to leave you one thing short."},
        {"zh": "我随手捏碎了", "en": "I crushed it without thinking."},
        {"zh": "掉在地上的都算我的", "en": "Whatever falls is mine."},
        {"zh": "我留着当个念想", "en": "I will keep it as a token."},
        {"zh": "这地上的东西，归红影。", "en": "What lies on the ground belongs to the crimson shadow."},
        {"zh": "它现在归我", "en": "It belongs to me now."},
        {"zh": "我只需要一件东西", "en": "I only need one thing."},
        {"zh": "那件东西是你", "en": "And that thing is you."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于不跑了", "en": "You finally stopped running."},
        {"zh": "现在只有我们两个", "en": "Now it is only the two of us."},
        {"zh": "你别想着喊人", "en": "Do not think of calling anyone."},
        {"zh": "这里没有别的声音", "en": "There is no other sound here."},
        {"zh": "红色开始蔓延", "en": "The red begins to spread."},
        {"zh": "这条路我封住了", "en": "I closed this path."},
        {"zh": "你退到尽头了", "en": "You have backed to the end."},
        {"zh": "我们之间没有墙", "en": "There is no wall between us."},
        {"zh": "你看着我就好", "en": "Just keep watching me."},
        {"zh": "我开始走了", "en": "I am starting to walk."},
        {"zh": "你的呼吸，我听得清清楚楚。", "en": "I hear your breathing perfectly."},
        {"zh": "你不会喜欢接下来的部分", "en": "You will not enjoy what comes next."},
        {"zh": "但是我会", "en": "But I will."},
        {"zh": "这次我不急", "en": "I am in no hurry this time."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我走近了一步", "en": "I took one step closer."},
        {"zh": "你退了一步", "en": "You took one step back."},
        {"zh": "这个节奏我很喜欢", "en": "I like this rhythm."},
        {"zh": "走廊在变长", "en": "The corridor is getting longer."},
        {"zh": "你身后的门关上了", "en": "The door behind you closed."},
        {"zh": "你的心跳太快，我听得清楚。", "en": "Your heart races; I hear it clearly."},
        {"zh": "它和脚步混在一起", "en": "It blends with your steps."},
        {"zh": "你手在找武器", "en": "Your hand is searching for a weapon."},
        {"zh": "你可以试试", "en": "You may try."},
        {"zh": "红色在墙上爬", "en": "The red climbs the walls."},
        {"zh": "你抬头看灯", "en": "You looked up at the lamp."},
        {"zh": "灯已经坏了", "en": "The lamp is already broken."},
        {"zh": "名字乱码了，我还在追。", "en": "My name is garbled, but I am still chasing."},
        {"zh": "你看不见我的影子", "en": "You cannot see my shadow."},
        {"zh": "你踩到了", "en": "You stepped on it."},
        {"zh": "现在不用回头了", "en": "No need to turn now."},
        {"zh": "你还能跑几步", "en": "How many more steps can you run?"},
        {"zh": "我等着看", "en": "I am waiting to see."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "红色的东西缠上你的手臂", "en": "The red coils around your arm."},
        {"zh": "这一下你没有挡住", "en": "You did not block that one."},
        {"zh": "我抓破了你的袖子", "en": "I tore your sleeve."},
        {"zh": "赤红的名字，不止一个。", "en": "The crimson name has more than one."},
        {"zh": "我掐住你的脖子", "en": "I grip your throat."},
        {"zh": "你想说话说不出来", "en": "You try to speak and cannot."},
        {"zh": "我又加重了一点", "en": "I press a little harder."},
        {"zh": "红色在我身上流动，我朝你走来。", "en": "Red flows over me as I come toward you."},
        {"zh": "我的红，比血还深。", "en": "My red runs deeper than blood."},
        {"zh": "我其实不需要呼吸", "en": "I do not actually need to breathe."},
        {"zh": "你眼前的红色在扩大", "en": "The red before your eyes is spreading."},
        {"zh": "你还想挣扎", "en": "You still want to struggle."},
        {"zh": "我喜欢这种时候", "en": "I like this part."},
        {"zh": "我按我的节奏来", "en": "I go at my own pace."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我出现在走廊尽头", "en": "I appear at the end of the corridor."},
        {"zh": "颜色开始蔓延", "en": "The color begins to spread."},
        {"zh": "没有人给我刷怪蛋以外的出路", "en": "No path for me but the spawn egg."},
        {"zh": "脚步声从远处开始", "en": "Footsteps start far away."},
        {"zh": "这里的墙很适合我", "en": "These walls suit me."},
        {"zh": "我把手抬起来看了看", "en": "I lift my hand and look at it."},
        {"zh": "红色在我脸上走过", "en": "Red moves across my face."},
        {"zh": "灯光被吸走了", "en": "The light is being drawn away."},
        {"zh": "我看向唯一的光", "en": "I look toward the only light."},
        {"zh": "你不该留在这里", "en": "You should not stay here."},
        {"zh": "我的影子先到墙边", "en": "My shadow reaches the wall first."},
        {"zh": "我又回到了这个世界", "en": "I am back in this world."},
        {"zh": "我会让它变个样子", "en": "I will change that."},
        {"zh": "走廊里只剩回声", "en": "Only echoes remain in the hall."},
        {"zh": "你在哪一间房里", "en": "Which room are you in?"},
        {"zh": "我会找到的", "en": "I will find it."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火跟我的颜色很像", "en": "Fire looks a lot like my color."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，还能站起来", "en": "I fall, and I can still stand."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水也挡不住我", "en": "Water does not stop me either."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把这间屋子清空了", "en": "The blast emptied the room."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭钉在我身上，我拔了出来", "en": "An arrow stuck in me, I pulled it out."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那点光想压住我", "en": "That light tries to hold me down."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿对我没有意义", "en": "Hunger means nothing to me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照得整条走廊发白", "en": "Lightning turned the whole hall white."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里本来就没有底", "en": "There was never a bottom here."}
      ]
    }
  }
}
