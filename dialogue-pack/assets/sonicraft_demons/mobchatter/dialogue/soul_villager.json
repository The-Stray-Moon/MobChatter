{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着步子，像还记得怎么走。", "en": "I shuffle, as if remembering how to walk."},
        {"zh": "我的衣服破了，边角飘着。", "en": "My robe is torn; the edges drift."},
        {"zh": "我走过的地方有一点冷。", "en": "It turns cold where I pass."},
        {"zh": "我没有脚，可我在走。", "en": "I have no feet, yet I walk."},
        {"zh": "脸上那点紫色淡得看不清。", "en": "The violet on my face is fading."},
        {"zh": "我在屋子之间慢慢穿。", "en": "I drift between buildings."},
        {"zh": "我的鼻子在风里抽动。", "en": "My nose twitches in the wind."},
        {"zh": "我绕着空村子转。", "en": "I circle the empty village."},
        {"zh": "我经过一口井，没停。", "en": "I pass a well without stopping."},
        {"zh": "我从一扇门里穿进去。", "en": "I pass through a door."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在空屋子中间。", "en": "I stand in an empty house."},
        {"zh": "我的表情还是那副。", "en": "My expression is still that one."},
        {"zh": "我的手在袖子里。", "en": "My hands are in my sleeves."},
        {"zh": "村子里没有人。", "en": "There is no one in the village."},
        {"zh": "我在听钟的声音。", "en": "I am listening to the bell."},
        {"zh": "我慢慢点了下头。", "en": "I nod slowly."},
        {"zh": "桌上落了一层灰。", "en": "A layer of dust on the table."},
        {"zh": "我脚下没有影子。", "en": "There is no shadow at my feet."},
        {"zh": "我的声音卡在喉咙里。", "en": "My voice is stuck in my throat."},
        {"zh": "我想起一个交易。", "en": "I remember a trade."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你明明还是个活人。", "en": "You are plainly still alive."},
        {"zh": "你也会变成我这样吗。", "en": "Will you become like me?"},
        {"zh": "我的名字念不出来了。", "en": "I can no longer say my name."},
        {"zh": "你进过这个村吗。", "en": "Have you been in this village?"},
        {"zh": "我的屋子在那头。", "en": "My house is that way."},
        {"zh": "你究竟想要什么。", "en": "What is it you want?"},
        {"zh": "交易还能做吗。", "en": "Can we still trade?"},
        {"zh": "我手里什么也没有了。", "en": "I have nothing left in my hands."},
        {"zh": "这里以前很热闹。", "en": "This place used to be lively."},
        {"zh": "我生前也住在这个村子。", "en": "I lived in this village too, once."},
        {"zh": "你在看我的手吗。", "en": "Are you looking at my hands?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我散成一团雾，又慢慢拼回来。", "en": "I scatter into mist and slowly piece myself back."},
        {"zh": "我退后半步，飘着。", "en": "Half a step back, drifting."},
        {"zh": "穿堂风从我身上过。", "en": "A draught goes through me."},
        {"zh": "痛觉早就没了。", "en": "Pain left me long ago."},
        {"zh": "我又聚了起来。", "en": "I gather myself again."},
        {"zh": "衣服破得更厉害了。", "en": "My robe is torn further."},
        {"zh": "我慢吞吞地转向你。", "en": "I turn to you, slow and heavy."},
        {"zh": "这一点算不了什么。", "en": "This much counts for little."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是绿宝石吗。", "en": "Is that an emerald?"},
        {"zh": "那个还能换东西吗。", "en": "Can that still buy anything?"},
        {"zh": "放在柜台上吧。", "en": "Leave it on the counter."},
        {"zh": "我的手会穿过去。", "en": "My hand will pass through."},
        {"zh": "这味道很陈旧。", "en": "That smell is old."},
        {"zh": "我闻到了面包。", "en": "I smell bread."},
        {"zh": "给我看一眼就行。", "en": "Just let me look at it."},
        {"zh": "你手上那点东西。", "en": "That little thing in your hand."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你从我身上撞过去了。", "en": "You went straight through me."},
        {"zh": "我没有身体可以挡。", "en": "I have no body to block with."},
        {"zh": "你的手臂一凉。", "en": "Your arm went cold."},
        {"zh": "我往后飘开了。", "en": "I drift back."},
        {"zh": "这点碰撞，我不痛。", "en": "That bump does not hurt."},
        {"zh": "我飘得更低些。", "en": "I drift lower."},
        {"zh": "我们不必相碰。", "en": "We need not touch."},
        {"zh": "你从我身上过去。", "en": "You passed through me."},
        {"zh": "别攥住我的袖子。", "en": "Do not grab my sleeve."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经不是活人了。", "en": "I am no longer a living person."},
        {"zh": "这身体不是我的。", "en": "This body is not mine."},
        {"zh": "村里的人都不在了。", "en": "The villagers are gone."},
        {"zh": "这件事别再提。", "en": "Do not raise it again."},
        {"zh": "我连脸都记不清。", "en": "I cannot even recall my face."},
        {"zh": "这不算我来找你的理由。", "en": "That is not a reason to seek you."},
        {"zh": "我只是还站在这里。", "en": "I merely still stand here."},
        {"zh": "你别再回来了。", "en": "Do not come back."},
        {"zh": "我没有那份心思。", "en": "I have no such mind left."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手去接，指尖穿过了它。", "en": "I reach for it, and my fingertips pass through."},
        {"zh": "手指穿了过去。", "en": "My fingers went through it."},
        {"zh": "它在我手里凉了一下。", "en": "It turned cold in my hand."},
        {"zh": "我朝你那边拨。", "en": "I nudge it your way."},
        {"zh": "柜台上的东西，我先看。", "en": "Let me look at what is on the counter first."},
        {"zh": "我什么也拿不走。", "en": "I can carry nothing away."},
        {"zh": "这枚落在我脚边。", "en": "This fell at my feet."},
        {"zh": "我身上没有衣袋。", "en": "I have no pockets."},
        {"zh": "你来把它拿走吧。", "en": "You take it."},
        {"zh": "我留着也没用。", "en": "It would be no use to me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你停住不动了。", "en": "You have stopped moving."},
        {"zh": "我听见门响了。", "en": "I heard the door."},
        {"zh": "我把身子扭过来。", "en": "I twist my body around."},
        {"zh": "你已经走不脱了。", "en": "You cannot get away."},
        {"zh": "村子里只剩我们。", "en": "Only the two of us are left here."},
        {"zh": "这屋里暗得很。", "en": "It is very dark in here."},
        {"zh": "你就站在门口。", "en": "You stand in the doorway."},
        {"zh": "我听着你的脚。", "en": "I follow your footsteps."},
        {"zh": "你千万别往外面跑。", "en": "Whatever you do, do not run outside."},
        {"zh": "村子里出不去。", "en": "There is no way out of the village."},
        {"zh": "时候已经到了。", "en": "The time has come."},
        {"zh": "你听见钟声吗。", "en": "Do you hear the bell?"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的鼻音很重。", "en": "My voice is thick."},
        {"zh": "你退到柜台边。", "en": "You backed to the counter."},
        {"zh": "这一排屋子都是空的。", "en": "This row of houses is empty."},
        {"zh": "你的脚在发抖。", "en": "Your feet are shaking."},
        {"zh": "你握着剑的手一直没放下。", "en": "The hand holding your sword has never lowered."},
        {"zh": "屋里的灯灭了。", "en": "The lamp in the house went out."},
        {"zh": "我贴到墙上了。", "en": "I pressed into the wall."},
        {"zh": "再撑上一会儿。", "en": "Hold a little longer."},
        {"zh": "这地方就可以。", "en": "Here will do."},
        {"zh": "别把头扭开去。", "en": "Do not turn your head."},
        {"zh": "这就是那一拍。", "en": "This is the moment."},
        {"zh": "你把牙关咬紧了。", "en": "Grit your teeth and hold."},
        {"zh": "就在眼前头了。", "en": "Right before me now."},
        {"zh": "你是走不掉的。", "en": "You cannot leave."},
        {"zh": "就是这一抓住了。", "en": "This grasp."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手从墙上伸出来。", "en": "My hand reaches out of the wall."},
        {"zh": "你被按在柜台上。", "en": "You are pressed onto the counter."},
        {"zh": "冷从你的手臂爬上去。", "en": "Cold climbs your arm."},
        {"zh": "连风声都没有。", "en": "Not even a whisper."},
        {"zh": "手指陷进甲缝里。", "en": "My fingers sink through your armor."},
        {"zh": "你甩开我，我飘回去。", "en": "You throw me off; I drift back."},
        {"zh": "我扣住手腕，指头陷进甲缝。", "en": "I grip the wrist, fingers in the armor seam."},
        {"zh": "我还好好地在这儿。", "en": "I am still right here."},
        {"zh": "你被绊在门槛上。", "en": "You tripped on the threshold."},
        {"zh": "我的鼻音更重了。", "en": "My voice has thickened."},
        {"zh": "我已经松开你了。", "en": "I have let you go."},
        {"zh": "我推你一把，冷气先钻进袖子。", "en": "I shove you once, and the cold enters your sleeves first."},
        {"zh": "我把手放开了。", "en": "I have released you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "村子里的灯灭了。", "en": "The village lamps have gone out."},
        {"zh": "我从屋子里走出来。", "en": "I come out of the house."},
        {"zh": "我的衣服已经旧得发白。", "en": "My robe is worn pale."},
        {"zh": "街上没有一个人。", "en": "Not a soul on the street."},
        {"zh": "我走到井边，停住。", "en": "I stop at the well."},
        {"zh": "门轴自己转了。", "en": "The hinge turned by itself."},
        {"zh": "我从门槛里浮起来，衣角先动。", "en": "I rise through the threshold, my hem moving first."},
        {"zh": "我听见有人的脚步。", "en": "I hear footsteps."},
        {"zh": "我慢吞吞转过来。", "en": "I turn around slowly."},
        {"zh": "我的影子没了。", "en": "My shadow is gone."},
        {"zh": "我从墙里飘出来。", "en": "I drift out of the wall."},
        {"zh": "我飘到你面前。", "en": "I drift before you."},
        {"zh": "我数着走过几间房。", "en": "I count the houses I pass."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我照得透明。", "en": "Fire makes me see-through."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有重量，落地无声。", "en": "I have no weight. My landing is silent."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我肋骨间穿过去。", "en": "Water passes between my ribs."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我吹散了。", "en": "The blast scatters me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我显出了形状。", "en": "This light gives me shape."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的胃早就空了，连饿都忘了。", "en": "My stomach emptied long ago; I have even forgotten hunger."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电光把整条街照亮。", "en": "Lightning lights the whole street."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面黑得像这村子。", "en": "The dark below is like the village."}
      ]
    }
  }
}
