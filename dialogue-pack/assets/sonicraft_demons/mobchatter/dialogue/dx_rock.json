{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚着走，磕磕碰碰", "en": "I roll along, knocking into things."},
        {"zh": "石头走路，一步一个印", "en": "A stone walks and leaves a print each step."},
        {"zh": "我身上有裂口，走起来响", "en": "I have cracks, and they sound as I walk."},
        {"zh": "我不太会转向", "en": "I'm not good at turning."},
        {"zh": "我被人扔出去过", "en": "I've been thrown before."},
        {"zh": "我落地的时候，地会疼", "en": "When I land, the ground hurts."},
        {"zh": "一路的草都被我压断", "en": "I snap the grass all along the way."},
        {"zh": "我走得很直，不会拐弯", "en": "I go straight; I don't bend."},
        {"zh": "我身上还有泥", "en": "There's still mud on me."},
        {"zh": "我朝前面去，前面有东西", "en": "I head forward; there's something ahead."},
        {"zh": "我一边滚一边掉碎屑", "en": "I shed fragments as I roll."},
        {"zh": "我不是自己长出来的石头", "en": "I wasn't grown as a stone."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在那儿，很重", "en": "I sit there, heavy."},
        {"zh": "我身上的棱角很硬", "en": "My edges are hard."},
        {"zh": "我在等下一只手", "en": "I'm waiting for the next hand."},
        {"zh": "我不动的时候，就像块石头", "en": "Still, I look like a stone."},
        {"zh": "我没有眼睛，可我认得方向", "en": "I have no eyes, yet I know direction."},
        {"zh": "我身上有一道旧裂", "en": "An old crack runs through me."},
        {"zh": "我记得飞的时候", "en": "I remember flying."},
        {"zh": "风从我身上的洞穿过去", "en": "Wind passes through a hole in me."},
        {"zh": "地面被我压出个坑", "en": "I've pressed a hollow in the ground."},
        {"zh": "我不用吃，也不用睡", "en": "I need no food or sleep."},
        {"zh": "这片地上没有别的石头说话", "en": "No other stone here speaks."},
        {"zh": "我数着落地的次数", "en": "I count my landings."},
        {"zh": "我压着的那块草，起不来了", "en": "The grass under me won't rise again."},
        {"zh": "我又不是自然生成的", "en": "I am not naturally spawned."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里是不是又要扔我", "en": "Are you going to throw me again?"},
        {"zh": "我见过你这种姿势", "en": "I know that stance."},
        {"zh": "你站在我前面，很危险", "en": "Standing in front of me isn't safe."},
        {"zh": "我砸过很多人的头", "en": "I've hit a lot of heads."},
        {"zh": "你比我软多了", "en": "You're softer than me."},
        {"zh": "我不恨你，我只是重", "en": "I don't hate you; I'm just heavy."},
        {"zh": "你的影子在我身上", "en": "Your shadow is on me."},
        {"zh": "我被人举起来过很多次", "en": "I've been lifted many times."},
        {"zh": "你要扔就扔准一点", "en": "If you throw me, aim true."},
        {"zh": "我看你的时候，你不一定知道", "en": "When I look at you, you may not know."},
        {"zh": "我滚起来会比你跑得快", "en": "Once I roll, I'm faster than you."},
        {"zh": "你退开点，我不想压你", "en": "Step aside; I don't want to crush you."},
        {"zh": "我身上有别人留下的凹", "en": "Someone else left a dent on me."},
        {"zh": "你在估我有多重", "en": "You're guessing my weight."},
        {"zh": "石头不说话，可我在说", "en": "Stones don't speak, but I am."},
        {"zh": "你听，我落地是这种声音", "en": "Listen, that's how I land."},
        {"zh": "我砸中的都是走神的", "en": "I always hit the distracted ones."},
        {"zh": "你要不要试试接住我", "en": "Want to try catching me?"},
        {"zh": "我不是武器，我只被扔", "en": "I'm not a weapon; I'm only thrown."},
        {"zh": "你身上的铁，比我软", "en": "The iron on you is softer than me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "碎屑掉了一地", "en": "Fragments fell everywhere."},
        {"zh": "这一下打在我棱角上", "en": "That hit my edge."},
        {"zh": "我不疼，我只会碎", "en": "I feel no pain; I only break."},
        {"zh": "我的重量没变", "en": "My weight is unchanged."},
        {"zh": "这一下，我缺了一块", "en": "I'm missing a piece now."},
        {"zh": "我落地时声音变了", "en": "My landing sounds different."},
        {"zh": "棱角还在，我还能压", "en": "My edges are intact; I can still press."},
        {"zh": "你再打，我就碎了", "en": "Hit again and I'll shatter."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "石头不会张嘴", "en": "A stone doesn't open its mouth."},
        {"zh": "你举着东西，我不是狗", "en": "You're holding something out; I'm not a dog."},
        {"zh": "那个我不需要", "en": "I don't need that."},
        {"zh": "你要扔我，不用给我东西", "en": "If you're throwing me, no gift needed."},
        {"zh": "这个能垫在我下面吗", "en": "Could this go under me?"},
        {"zh": "我不缺那点重量", "en": "I'm not short of weight."},
        {"zh": "你手里那块，比我轻", "en": "That's lighter than me."},
        {"zh": "你放到地上吧", "en": "Put it down."},
        {"zh": "我只要一个人把我举起来", "en": "I only want someone to lift me."},
        {"zh": "我是块被扔过来的石头。", "en": "I am a stone that was thrown."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，你退了", "en": "You hit me and you went back."},
        {"zh": "我这一身很硬", "en": "This body is hard."},
        {"zh": "别拿脚来踢我", "en": "Don't kick."},
        {"zh": "这一下，你脚趾会疼", "en": "That'll hurt your toes."},
        {"zh": "我压到了你的影子", "en": "I pressed on your shadow."},
        {"zh": "我的石面磕出闷闷一声。", "en": "My stone face lands with a dull thud."},
        {"zh": "我弹开，滚进墙角的土。", "en": "I bounce off and roll into the dirt."},
        {"zh": "你推我，我只会更高兴", "en": "Push me and I'm happier."},
        {"zh": "我是一块飞石，躲开！", "en": "I am a flying rock—move!"},
        {"zh": "我碰谁，谁就退", "en": "Whoever I touch steps back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "石头跟石头，只会撞", "en": "Stone against stone only collides."},
        {"zh": "这地方没有另一块这样的", "en": "There's no other one like me here."},
        {"zh": "我被扔出来的时候是一个人", "en": "I was alone when I was thrown."},
        {"zh": "这种事对石头不成立", "en": "That doesn't hold for stones."},
        {"zh": "我身上的裂，是自己受的", "en": "These cracks I earned myself."},
        {"zh": "你别打听这种事", "en": "Don't ask that."},
        {"zh": "我落地那一声，很孤单", "en": "The sound of my landing is lonely."},
        {"zh": "我本来就不是活物", "en": "I'm not alive."},
        {"zh": "安静点，地面在响", "en": "Quiet, the ground is ringing."},
        {"zh": "我得回原来的地方", "en": "I must go back."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把东西压在下面", "en": "I pin things underneath me."},
        {"zh": "我滚过去，就压住了", "en": "I roll over and it's pinned."},
        {"zh": "这个太软，压坏了", "en": "Too soft; I'd crush it."},
        {"zh": "地上那块，跟我一样硬", "en": "That one on the ground is as hard as me."},
        {"zh": "我用棱角夹住它", "en": "I catch it in my edges."},
        {"zh": "它碎在我身上了", "en": "It broke on me."},
        {"zh": "我拿不起来，只能压", "en": "I can't lift; I can press."},
        {"zh": "地上那块，我不要", "en": "That one on the ground, I don't want."},
        {"zh": "滚一圈，什么都没了", "en": "One roll and it's gone."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有个人影", "en": "A figure over there."},
        {"zh": "我认得那个站姿", "en": "I know that stance."},
        {"zh": "这距离能扔到我", "en": "That's close enough to throw me from."},
        {"zh": "我已经瞄准它", "en": "I'm aimed at it."},
        {"zh": "它没看着这边", "en": "It isn't looking this way."},
        {"zh": "风不大，刚好合适", "en": "Little wind, just right."},
        {"zh": "我在算着落点", "en": "I'm calculating the landing point."},
        {"zh": "就是那个脑袋", "en": "That head right there."},
        {"zh": "我把棱角朝着它", "en": "I turn my edge toward it."},
        {"zh": "它站在那里很稳", "en": "It's standing quite still."},
        {"zh": "我先往前滚一点", "en": "I'll roll a little forward first."},
        {"zh": "它转身了，来不及", "en": "It turned; too late."},
        {"zh": "这一块距离，我看准了", "en": "At this range, I've judged it."},
        {"zh": "它不知道我在看", "en": "It doesn't know I'm watching."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚得还算稳", "en": "I roll steadily."},
        {"zh": "它往左边偏了", "en": "It's a bit to the left."},
        {"zh": "地面不平，我弹了一下", "en": "The ground is uneven; I bounced."},
        {"zh": "这一路都是石头", "en": "The whole way is stone."},
        {"zh": "它在跑，跑不过我", "en": "It's running; it can't outrun me."},
        {"zh": "我在它后面三格", "en": "I'm three blocks behind it."},
        {"zh": "我的碎屑掉了一路", "en": "My fragments mark the road."},
        {"zh": "它踩到了碎石", "en": "It stepped on gravel."},
        {"zh": "它一下慢了下来", "en": "It slowed."},
        {"zh": "再靠近一点就砸得到。", "en": "One step closer and it hits."},
        {"zh": "我把速度提起来", "en": "I pick up speed."},
        {"zh": "前面有墙，它过不去", "en": "There's a wall ahead; it won't get through."},
        {"zh": "它被逼到墙角了", "en": "It's cornered."},
        {"zh": "它把手举起来", "en": "It raised a hand."},
        {"zh": "这一下会撞个正着", "en": "This one will land square."},
        {"zh": "我离它一格远", "en": "I'm one block from it."},
        {"zh": "它的脚步一乱，我就知道", "en": "Its steps went uneven; I know."},
        {"zh": "我滚到它脚下，现在", "en": "I've reached its feet; now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我砸在它身上", "en": "I crash down on it."},
        {"zh": "这一下砸得它跪下去", "en": "That one brought it to its knees."},
        {"zh": "它被撞得退了", "en": "It's knocked backward."},
        {"zh": "我的棱角划开它", "en": "My edges open it up."},
        {"zh": "碎屑溅了一地", "en": "Fragments spray everywhere."},
        {"zh": "我弹开了，又落回去", "en": "I bounced off and came down again."},
        {"zh": "它举盾接了一下，盾凹了", "en": "It raised a shield; the shield dented."},
        {"zh": "我压住了它的脚", "en": "I pinned its foot."},
        {"zh": "它还在推着我", "en": "It's still pushing me."},
        {"zh": "我滚过去，它退了", "en": "I roll over and it retreats."},
        {"zh": "这一下没砸实", "en": "That one didn't land clean."},
        {"zh": "我一下砸在墙上", "en": "I hit the wall."},
        {"zh": "我跟着滚过去", "en": "I roll after it."},
        {"zh": "这一下，够它记的", "en": "That'll be remembered."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "有人把我举起来，然后扔了", "en": "Someone lifted me, then threw."},
        {"zh": "我落在地上，尘土飞起来", "en": "I hit the ground and dust rises."},
        {"zh": "我落地后弹了一下才停", "en": "I landed, bounced once, and stopped."},
        {"zh": "刷怪蛋一开，我就在半空", "en": "The egg opened and I was midair."},
        {"zh": "我不记得谁扔的我", "en": "I don't remember who threw me."},
        {"zh": "身上的泥还没干", "en": "The mud on me isn't dry."},
        {"zh": "我先稳上一稳", "en": "Let me settle first."},
        {"zh": "地面的味道很陌生", "en": "The ground smells unfamiliar."},
        {"zh": "我落地的时候，声音很大", "en": "My landing was loud."},
        {"zh": "这一片都是软的", "en": "All this is soft ground."},
        {"zh": "我朝有东西的方向滚", "en": "I roll toward something."},
        {"zh": "我没有眼睛，可我看见轮廓", "en": "I have no eyes, yet I see shapes."},
        {"zh": "我的裂口又宽了一点", "en": "My crack widened a little."},
        {"zh": "我滚得很慢，但很稳", "en": "I roll slowly, but steadily."},
        {"zh": "这里比我上一次落地的地方平", "en": "This is flatter than my last landing."},
        {"zh": "我身上还留着上次的印", "en": "I still carry the mark from last time."},
        {"zh": "风里有铁的味道", "en": "There's iron in the wind."},
        {"zh": "我朝那个味道滚", "en": "I roll toward it."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我表面发白", "en": "Fire bleached my surface."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下来，砸出个坑", "en": "I landed and left a pit."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水冲不掉我身上的泥", "en": "Water won't wash the mud off me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸掉了我一半", "en": "The blast took half of me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西崩在我身上，断了", "en": "Something struck me and snapped."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，我的裂口亮了一下", "en": "The spell hit and my crack lit up."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "石头从来不饿", "en": "Stones don't starve."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我身上，我整块都亮了", "en": "Lightning struck and my whole body lit."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没东西给我砸", "en": "There's nothing in the void for me to smash."}
      ]
    }
  }
}
