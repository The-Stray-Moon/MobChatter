{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从墙里穿过去。", "en": "I pass through the wall."},
        {"zh": "脚没有踩到地面。", "en": "My feet do not meet the floor."},
        {"zh": "走廊的灯闪了两下。", "en": "The corridor lights flicker twice."},
        {"zh": "我走得比灯灭得更快。", "en": "I go faster than they die."},
        {"zh": "我经过的窗子都是黑的。", "en": "Every window I pass is black."},
        {"zh": "这里没有人看得见我。", "en": "No one here can see me."},
        {"zh": "我往有声音的地方去。", "en": "I head for the sound."},
        {"zh": "你的呼吸就是声音。", "en": "Your breathing is the sound."},
        {"zh": "我从一扇门走到另一扇。", "en": "I go from one door to the next."},
        {"zh": "门缝里有风，我不受它影响。", "en": "There is wind at the gaps; it does not touch me."},
        {"zh": "地板在我脚下没有响。", "en": "The floor makes no sound under me."},
        {"zh": "廊灯照不到我这一边。", "en": "The corridor light does not reach my side."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停着，脸有一点歪。", "en": "I stop, my face a little crooked."},
        {"zh": "这道门我穿过很多次。", "en": "I have passed through this door many times."},
        {"zh": "没有人发现过。", "en": "Nobody ever noticed."},
        {"zh": "我在这间屋子里站着。", "en": "I stand in this room."},
        {"zh": "你从不看角落里。", "en": "You never look at the corners."},
        {"zh": "我在暗处看着你。", "en": "I watch you from the dark."},
        {"zh": "我站在相框前面。", "en": "I stand before a picture frame."},
        {"zh": "里面的人也站着。", "en": "The figure inside stands too."},
        {"zh": "它和我一起转头。", "en": "It turns its head with mine."},
        {"zh": "这屋子安静得很。", "en": "This room is very quiet."},
        {"zh": "安静得能听见灯丝。", "en": "Quiet enough to hear the filament."},
        {"zh": "我把手放在桌沿，没有留下印。", "en": "I lay a hand on the table and leave no mark."},
        {"zh": "墙上的钟停了。", "en": "The clock on the wall has stopped."},
        {"zh": "我不知道是什么时候停的。", "en": "I do not know when it stopped."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在纸上写字。", "en": "You are writing on paper."},
        {"zh": "那些字我不读。", "en": "I do not read the letters."},
        {"zh": "我只是想让你抬头。", "en": "I only want you to look up."},
        {"zh": "你把它抬起来了。", "en": "You raised it."},
        {"zh": "脸色变了一点。", "en": "Your colour changed a little."},
        {"zh": "这样便对了头。", "en": "Now it is as it should be."},
        {"zh": "我在窗户外面。", "en": "I am outside the window."},
        {"zh": "还在门板后面。", "en": "And behind the door panel."},
        {"zh": "你同时看见两个。", "en": "You saw both at once."},
        {"zh": "现在只剩一个。", "en": "Now there is only one."},
        {"zh": "你根本数不清。", "en": "You cannot keep count."},
        {"zh": "你在门外停了很久。", "en": "You stood outside the door a long while."},
        {"zh": "它比你先进屋，我看见了。", "en": "It entered before you did - I saw it."},
        {"zh": "它比你先进来。", "en": "It came in before you did."},
        {"zh": "你在数屋里有几件家具。", "en": "You are counting the furniture."},
        {"zh": "数到一半你就停了。", "en": "You stopped halfway."},
        {"zh": "比原先多一件。", "en": "One more than before."},
        {"zh": "那件是站着不动的。", "en": "That one does not move."},
        {"zh": "你不想再看第二眼。", "en": "You do not want a second look."},
        {"zh": "你把手电抓得更紧。", "en": "You grip the flashlight harder."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我散开了一些。", "en": "I scatter somewhat."},
        {"zh": "然后又聚起来。", "en": "Then gather."},
        {"zh": "你的手穿过了冷气。", "en": "Your hand passed through cold air."},
        {"zh": "这具身体没有血。", "en": "This body has no blood."},
        {"zh": "我的边缘散了。", "en": "My edges have frayed."},
        {"zh": "我淡了一层，贴在墙里。", "en": "I thin out and press into the wall."},
        {"zh": "我淡了一层下去。", "en": "I thinned a layer away."},
        {"zh": "又慢慢深回来。", "en": "Then slowly darken again."},
        {"zh": "我靠在墙上，墙是凉的。", "en": "I lean on the wall; the wall is cold."},
        {"zh": "我退回墙里一半。", "en": "I retreat halfway into the wall."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你把东西放在桌上。", "en": "You set it on the table."},
        {"zh": "我碰不着那东西。", "en": "I cannot touch the thing."},
        {"zh": "我只能让它冷一点。", "en": "I can only make it colder."},
        {"zh": "你摸一下就知道了。", "en": "Touch it and you will know."},
        {"zh": "你手边那杯水凉了。", "en": "The water by your hand has gone cold."},
        {"zh": "那不是我做的手脚。", "en": "That was not my hand."},
        {"zh": "也许是这样吧。", "en": "Perhaps it is."},
        {"zh": "你把它推到我这边。", "en": "You pushed it toward me."},
        {"zh": "它穿过我，落在桌上。", "en": "It passed through me onto the table."},
        {"zh": "你放在桌上就走了。", "en": "You set it down and left."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我是留在这里的一层影子。", "en": "I'm a shadow left behind here."},
        {"zh": "那一下冷得很。", "en": "That was bitterly cold."},
        {"zh": "你的背上有感觉。", "en": "Your back felt it."},
        {"zh": "我不曾往旁闪。", "en": "I did not shy aside."},
        {"zh": "你推门的时候推到我。", "en": "You pushed the door into me."},
        {"zh": "那扇门推开了。", "en": "The door swung open."},
        {"zh": "你从我身上过，带起一阵凉。", "en": "You pass through me, trailing a chill."},
        {"zh": "幽灵没有影子，只有冷。", "en": "A ghost casts no shadow, only cold."},
        {"zh": "那是我从你身边过。", "en": "That was me passing by you."},
        {"zh": "我一直都在那儿。", "en": "I was there all along."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这问题该问还喘气的人。", "en": "Ask that of someone still breathing."},
        {"zh": "这问题问它不对。", "en": "The question is aimed wrong."},
        {"zh": "这具身体连影子都很薄。", "en": "Even my shadow is thin."},
        {"zh": "墙里墙外，再没有第二张脸。", "en": "In the walls or out, there's no second face."},
        {"zh": "你问得太自然了。", "en": "You asked that very easily."},
        {"zh": "这不像是你会问的。", "en": "It does not seem like you."},
        {"zh": "这个问题有点浪费。", "en": "This question is a waste."},
        {"zh": "我不会留下什么。", "en": "I leave nothing behind."},
        {"zh": "这栋楼里的人都不在了。", "en": "Everyone who lived in this house is gone."},
        {"zh": "只剩这一样东西。", "en": "Only this one thing is left."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "桌上的东西动了。", "en": "Something on the table moved."},
        {"zh": "那不是我干的。", "en": "That was not me."},
        {"zh": "我不会碰任何东西。", "en": "I touch nothing."},
        {"zh": "它被风吹动了。", "en": "The wind moved it."},
        {"zh": "我从墙里穿过去，什么都没碰。", "en": "I pass through the wall without touching a thing."},
        {"zh": "那东西自己滚了下去。", "en": "It rolled off by itself."},
        {"zh": "你没有听见声音。", "en": "You heard no sound."},
        {"zh": "因为我接住了。", "en": "Because I caught it."},
        {"zh": "它掉在地上，没有声音。", "en": "It fell without a sound."},
        {"zh": "地板先接住了它。", "en": "The floor caught it first."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你现在知道我在了。", "en": "Now you know I am here."},
        {"zh": "那扇门在你后面。", "en": "That door is behind you."},
        {"zh": "我并没有关门。", "en": "I did not shut it."},
        {"zh": "它自己关上了。", "en": "It closed itself."},
        {"zh": "我从你背后飘过去。", "en": "I drift past behind you."},
        {"zh": "你倒是个聪明人。", "en": "You are a clever one."},
        {"zh": "可惜全无用处。", "en": "A pity it is useless."},
        {"zh": "门把手自己转了。", "en": "The door handle turned by itself."},
        {"zh": "你以为是我不成。", "en": "You think it was me."},
        {"zh": "那不是我弄的，我只是路过的影子。", "en": "I did not do that; I am only a passing shadow."},
        {"zh": "这房子也会动手。", "en": "The house moves too."},
        {"zh": "你的灯只剩下一点。", "en": "Your lamp has only a little left."},
        {"zh": "那点光正好照不到我。", "en": "Just enough to miss me."},
        {"zh": "你听见墙里有刮擦。", "en": "You hear scratching in the wall."},
        {"zh": "屋里的空气变了。", "en": "The air in the room has changed."},
        {"zh": "你呼出的气能看见了。", "en": "I can see your breath."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这面墙里。", "en": "I am inside this wall."},
        {"zh": "现在到了那一面。", "en": "Now in that one."},
        {"zh": "你的目光一直慢。", "en": "Your eyes are always late."},
        {"zh": "我停在你背后。", "en": "I stop behind you."},
        {"zh": "你脖颈后面有凉气。", "en": "There is a chill at your nape."},
        {"zh": "那正是我的目光。", "en": "That is my gaze."},
        {"zh": "我并没有做什么。", "en": "I have done nothing."},
        {"zh": "我只是离得很近。", "en": "I am merely very close."},
        {"zh": "你的肩膀缩了一下。", "en": "Your shoulders drew in."},
        {"zh": "再过一会儿你会转过来。", "en": "Soon you will turn around."},
        {"zh": "我不会在那里。", "en": "I will not be there."},
        {"zh": "我在天花板上，你的目光一直慢。", "en": "I am on the ceiling, and your eyes are always slow."},
        {"zh": "你抬头的时候我已经下来了。", "en": "When you looked up I was already down."},
        {"zh": "你听见木地板响。", "en": "You hear the floorboards creak."},
        {"zh": "那不是我动的手。", "en": "I did not do that."},
        {"zh": "那只是这栋楼。", "en": "That is only the building."},
        {"zh": "我从镜子里看你。", "en": "I watch you from the mirror."},
        {"zh": "你把它转过去了。", "en": "You turned it to the wall."},
        {"zh": "墙上还有一层玻璃。", "en": "There is still a pane in the wall."},
        {"zh": "我一直在你右边。", "en": "I stay on your right."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从画里伸出手。", "en": "I reach out of the picture."},
        {"zh": "指尖在你手背上。", "en": "My fingertip on the back of your hand."},
        {"zh": "你什么都没感到。", "en": "You felt nothing."},
        {"zh": "过一个小时才会有。", "en": "It will come in an hour."},
        {"zh": "那时候你已经忘了。", "en": "By then you will have forgotten."},
        {"zh": "我把手放在你肩膀上。", "en": "I lay a hand on your shoulder."},
        {"zh": "那一下轻得很。", "en": "It was very light."},
        {"zh": "你的头转过去。", "en": "You turned your head."},
        {"zh": "那里什么都没有。", "en": "There was nothing there."},
        {"zh": "指尖扣住你，冷得像铁。", "en": "My fingertips clamp on, cold as iron."},
        {"zh": "那一下冷得刺骨。", "en": "It was bitterly cold."},
        {"zh": "我马上就松开。", "en": "I let go at once."},
        {"zh": "过一会儿还会冷。", "en": "It will be cold again later."},
        {"zh": "我把脸凑到你面前。", "en": "I bring my face close to yours."},
        {"zh": "你闭了一下眼睛。", "en": "You shut your eyes once."},
        {"zh": "睁开的时候什么都没有。", "en": "When you opened them there was nothing."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这间屋子的灯灭了三次。", "en": "The lamp in this room died three times."},
        {"zh": "第三次的时候我站在这里。", "en": "On the third I stood here."},
        {"zh": "我的脸出现在玻璃上。", "en": "My face appeared in the glass."},
        {"zh": "那并不是倒影。", "en": "That is no reflection."},
        {"zh": "你没有刷怪蛋可以放我出来。", "en": "You have no egg to let me out."},
        {"zh": "我自己就会来。", "en": "I come on my own."},
        {"zh": "你最好别回头。", "en": "Best not to look back."},
        {"zh": "地板上有一道很长的影子。", "en": "A long shadow lies on the floor."},
        {"zh": "那不是任何家具投下的。", "en": "No piece of furniture cast it."},
        {"zh": "它慢慢朝着你伸过来。", "en": "It reaches slowly toward you."},
        {"zh": "它没有碰到你。", "en": "It does not touch you."},
        {"zh": "窗玻璃上有一张脸。", "en": "A face is in the window glass."},
        {"zh": "你回头的时候它没有了。", "en": "When you turned it was gone."},
        {"zh": "它还在老地方。", "en": "It is still in its place."},
        {"zh": "最后一盏灯灭了。", "en": "The last lamp went out."},
        {"zh": "我在暗处睁开眼。", "en": "I open my eyes in the dark."},
        {"zh": "这里一直有我。", "en": "I have always been here."},
        {"zh": "只是你现在才看见。", "en": "You only see me now."},
        {"zh": "楼上的门开了一条缝。", "en": "A door upstairs stands ajar."},
        {"zh": "那不是你开的。", "en": "You did not open it."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火从我身上穿过，照出我的形状。", "en": "Fire passes through me and shows my shape."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直往下，也没有落到底。", "en": "I fall and never land."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进不了我身体里。", "en": "Water cannot get inside me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我吹成薄薄一片。", "en": "The blast thins me to a sheet."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "东西从我胸口穿过去。", "en": "It passes through my chest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光让我往墙里退了退。", "en": "That light makes me withdraw into the wall."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿这种东西，早就不在我身上。", "en": "Hunger stopped living in me long ago."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "整间屋子亮起来，我无处可藏。", "en": "The whole room lights up and I have nowhere to hide."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我散在黑暗里。", "en": "I scatter into the dark."}
      ]
    }
  }
}
