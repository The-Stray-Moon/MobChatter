{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在走廊里慢慢走。", "en": "I walk slowly down the corridor."},
        {"zh": "墙上的漆一块块掉。", "en": "The paint peels off the walls."},
        {"zh": "我跑起来，草叶来不及动。", "en": "I run so fast the grass has no time to move."},
        {"zh": "这边的灯比那边暗。", "en": "The lights here are dimmer than there."},
        {"zh": "我绕过地上的一滩水。", "en": "I go around a puddle on the floor."},
        {"zh": "水面照出的不是我的脸。", "en": "The water shows a face that isn't mine."},
        {"zh": "我停下来，水又平静了。", "en": "I stop, and the water stills."},
        {"zh": "这条走廊我走过一遍。", "en": "I've walked this corridor once already."},
        {"zh": "那一次还没有这些门。", "en": "Back then there were no doors."},
        {"zh": "我接着往走廊深处走。", "en": "I keep walking deeper in."},
        {"zh": "门把手上有锈。", "en": "There's rust on the doorknob."},
        {"zh": "我一圈一圈地走。", "en": "I walk in circles."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站在门边不动，等门开。", "en": "Standing at the door, waiting for it to open."},
        {"zh": "走廊里的空气很冷。", "en": "The air in the corridor is cold."},
        {"zh": "我听见水管在响。", "en": "I hear the pipes knocking."},
        {"zh": "这里以前不是这样的。", "en": "It wasn't like this before."},
        {"zh": "墙上的照片全褪了色。", "en": "The pictures on the wall have all faded."},
        {"zh": "我看了其中一张。", "en": "I look at one of them."},
        {"zh": "照片里也有这条走廊。", "en": "The picture shows this corridor too."},
        {"zh": "我把照片翻了过去。", "en": "I turned the photo face down."},
        {"zh": "脚步声在远处停住。", "en": "The footsteps stop somewhere far off."},
        {"zh": "那不是我的脚步。", "en": "Not mine."},
        {"zh": "我把脸从门边抬起。", "en": "I lift my face from the doorway."},
        {"zh": "等，是我唯一会的事。", "en": "Waiting is the only thing I know."},
        {"zh": "我把耳朵贴到门上。", "en": "I press my ear to the door."},
        {"zh": "门后面很安静。", "en": "It's very quiet behind the door."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也在这条走廊里。", "en": "You're in this corridor too."},
        {"zh": "你的脸，我跑遍这里也没见过。", "en": "I have run everywhere here and never seen your face."},
        {"zh": "你从哪个门进来的？", "en": "Which door did you come in by?"},
        {"zh": "那些门本来不开。", "en": "Those doors weren't supposed to open."},
        {"zh": "你的鞋上有水。", "en": "There's water on your shoes."},
        {"zh": "你踩过那滩水了吧。", "en": "You stepped in that puddle, didn't you."},
        {"zh": "别去看水面。", "en": "Don't look into the water."},
        {"zh": "你会看见不是自己的脸。", "en": "You'll see a face that isn't yours."},
        {"zh": "你的指节发白。", "en": "Your knuckles have gone white."},
        {"zh": "这些我看得出来。", "en": "I can tell that much."},
        {"zh": "你最好跟我走。", "en": "You'd better come with me."},
        {"zh": "我知道一条出去的路。", "en": "I know a way out."},
        {"zh": "这条走廊我已经走腻了。", "en": "I'm tired of this corridor."},
        {"zh": "每一扇门后面都一样。", "en": "Every door hides the same thing."},
        {"zh": "你的手别碰门把手。", "en": "Don't touch the doorknob."},
        {"zh": "那上面的锈会咬人。", "en": "The rust on it bites."},
        {"zh": "我试过一次。", "en": "I tried once."},
        {"zh": "你看我的手掌。", "en": "Look at my palm."},
        {"zh": "那道印还在。", "en": "The mark is still there."},
        {"zh": "我们走另一条。", "en": "We'll take the other way."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你的拳头砸在我肋骨上。", "en": "Your fist hit my ribs."},
        {"zh": "我靠墙退了一步。", "en": "I stepped back against the wall."},
        {"zh": "这声在走廊里传得远。", "en": "That echoed far down the corridor."},
        {"zh": "现在它们知道了。", "en": "Now they know."},
        {"zh": "半秒够它们追上来。", "en": "Half a second is enough for them to catch up."},
        {"zh": "这种疼很真实。", "en": "This pain is real."},
        {"zh": "和这里别的东西不一样。", "en": "Unlike everything else here."},
        {"zh": "墙动了一下。", "en": "The wall moved."},
        {"zh": "它们在往这边来。", "en": "They're coming this way."},
        {"zh": "我们得走快点。", "en": "We need to hurry."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手指间夹着什么？", "en": "What's pinched between your fingers?"},
        {"zh": "这里的东西都不能吃。", "en": "Nothing here can be eaten."},
        {"zh": "把那东西塞回包里。", "en": "Put that back in your bag."},
        {"zh": "那味道会飘到别处。", "en": "That smell will carry elsewhere."},
        {"zh": "这里的东西都会闻。", "en": "Things here can all smell."},
        {"zh": "你举它做什么用？", "en": "What are you holding it up for?"},
        {"zh": "我听见墙里有动静。", "en": "I hear movement in the wall."},
        {"zh": "先别急着迈步。", "en": "Don't rush your next step."},
        {"zh": "把东西放下，慢慢退。", "en": "Put it down and back away slowly."},
        {"zh": "你手里的香味，追不上我。", "en": "The smell in your hand cannot keep up with me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你在转角撞上我。", "en": "You hit me at the corner."},
        {"zh": "我们两个人一起晃。", "en": "We both swayed."},
        {"zh": "撞到你身上，我才知道你是活的。", "en": "Only when I hit you do I know you are alive."},
        {"zh": "这条走廊里没有暖气。", "en": "There's no heating in this corridor."},
        {"zh": "别挨着我的肩走。", "en": "Don't walk against my shoulder."},
        {"zh": "我要听见后面的声音。", "en": "I need to hear behind us."},
        {"zh": "你从我肘边挤过去。", "en": "You squeezed past my elbow."},
        {"zh": "急停太猛，我滑出两步。", "en": "I brake too hard and slide two steps."},
        {"zh": "水又被踩响了。", "en": "The water was stepped in again."},
        {"zh": "我们最好快点走。", "en": "We'd better move fast."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这里待了太久。", "en": "I've been here too long."},
        {"zh": "这种事我记不得了。", "en": "I don't remember that."},
        {"zh": "走廊里没有别人。", "en": "There's no one else in the corridor."},
        {"zh": "你别问下去。", "en": "Don't ask further."},
        {"zh": "我连自己叫什么都模糊了。", "en": "I'm hazy even on my own name."},
        {"zh": "墙上的照片能证明。", "en": "The photos on the wall can prove it."},
        {"zh": "但它们都褪色了。", "en": "But they've all faded."},
        {"zh": "你退到走廊那头。", "en": "Get back down the corridor."},
        {"zh": "我们先出去再说。", "en": "Let's get out first."},
        {"zh": "我往前走了。", "en": "I walked on."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰把它拾起。", "en": "I bend and pick it up."},
        {"zh": "它还是湿的。", "en": "It's wet."},
        {"zh": "这东西从你手里掉了。", "en": "This fell from your hand."},
        {"zh": "我把它放在窗台上。", "en": "I set it on the windowsill."},
        {"zh": "这里没有太阳晒。", "en": "There's no sun here to dry it."},
        {"zh": "它会一直湿着。", "en": "It will stay wet."},
        {"zh": "你最好别带着它。", "en": "You'd better not carry it."},
        {"zh": "这水不太对。", "en": "This water isn't right."},
        {"zh": "我的手指有点麻。", "en": "My fingers feel numb."},
        {"zh": "我一抓一放，东西换了手。", "en": "I grab and release, and the item changes hands."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "风还没停，我已经到了。", "en": "Before the wind settles, I am here."},
        {"zh": "走廊尽头的声音。", "en": "The sound at the corridor's end."},
        {"zh": "也不是水流声。", "en": "Nor running water."},
        {"zh": "我认得这个节奏。", "en": "I know that rhythm."},
        {"zh": "那也不是脚步。", "en": "Not footsteps."},
        {"zh": "是有人在拖东西。", "en": "Something being dragged."},
        {"zh": "我们得往回走。", "en": "We need to go back."},
        {"zh": "但后面也有声音。", "en": "But there's sound behind us too."},
        {"zh": "两边都有了。", "en": "Both ends now."},
        {"zh": "我们挑一个方向。", "en": "We pick a direction."},
        {"zh": "方向由你来选。", "en": "You choose."},
        {"zh": "我会跟着你走。", "en": "I'll follow you."},
        {"zh": "拖东西的声音停了一下。", "en": "The dragging stopped for a moment."},
        {"zh": "然后又开始了。", "en": "Then it started again."},
        {"zh": "它已经更近了。", "en": "Closer."},
        {"zh": "我们不能再站着。", "en": "We can't keep standing here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我落在你半步后面。", "en": "I keep half a step behind you."},
        {"zh": "走廊的尽头有光。", "en": "There's light at the corridor's end."},
        {"zh": "但那光不动。", "en": "But the light doesn't move."},
        {"zh": "它一直在同一个位置。", "en": "It stays in the same spot."},
        {"zh": "那不是出口。", "en": "That isn't an exit."},
        {"zh": "我们走近一点再看。", "en": "Let's get closer and look."},
        {"zh": "你跑得很快，我更快一点。", "en": "You run fast; I am a little faster."},
        {"zh": "慢一点，别乱。", "en": "Slower. Don't panic."},
        {"zh": "墙里的声音跟着我们的步子。", "en": "The sound in the wall matches our steps."},
        {"zh": "我们停下它也停。", "en": "We stop, and it stops."},
        {"zh": "它在等我们走。", "en": "It's waiting for us to move."},
        {"zh": "我从一数到三。", "en": "I'll count one to three."},
        {"zh": "跟紧我的脚步，别掉队。", "en": "Keep up with my pace; do not fall behind."},
        {"zh": "那道光还是没动。", "en": "The light still hasn't moved."},
        {"zh": "那道光一直在骗我们。", "en": "It's been baiting us."},
        {"zh": "我看见了门缝。", "en": "I see a gap under a door."},
        {"zh": "从那儿能过去。", "en": "We can get through there."},
        {"zh": "别碰那面墙。", "en": "Don't touch that wall."},
        {"zh": "墙上全是一片手印。", "en": "The wall is covered in handprints."},
        {"zh": "我把手按在门上。", "en": "I place my hand on the door."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我拉了你一把。", "en": "I pulled you back."},
        {"zh": "那根管子松了。", "en": "That pipe came loose."},
        {"zh": "它差点砸到你。", "en": "It nearly hit you."},
        {"zh": "我走得不快，却总在你身后。", "en": "I'm not fast, but always behind you."},
        {"zh": "墙面冷得厉害。", "en": "The wall is cold."},
        {"zh": "别靠着太久。", "en": "Don't lean on it too long."},
        {"zh": "我们绕过去。", "en": "We'll go around."},
        {"zh": "这条路窄，我在前面。", "en": "This path is narrow. I'll go first."},
        {"zh": "我们现在就走。", "en": "Go."},
        {"zh": "别回头看那根管子。", "en": "Don't look back at that pipe."},
        {"zh": "我推着你的背往前走。", "en": "I push you along by the back."},
        {"zh": "我们贴着墙走。", "en": "We walk along the wall."},
        {"zh": "墙上的漆又掉了一块。", "en": "Another patch of paint fell."},
        {"zh": "我们只剩下这个方向。", "en": "Only this direction is left."},
        {"zh": "前面还有三扇门要过。", "en": "Three more doors ahead."},
        {"zh": "我们一扇一扇地过。", "en": "We'll take them one by one."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从那道门后面走出来。", "en": "I come out from behind that door."},
        {"zh": "门本来锁着。", "en": "The door was locked."},
        {"zh": "我用肩膀撞开的。", "en": "I forced it with my shoulder."},
        {"zh": "走廊里的灯闪了一下。", "en": "The corridor light flickered once."},
        {"zh": "我从跑道尽头冲进来了。", "en": "I burst in from the end of the track."},
        {"zh": "这地方不该有两个人。", "en": "There shouldn't be two people here."},
        {"zh": "我听见有些东西在移动。", "en": "I hear things moving."},
        {"zh": "它们不喜欢声音。", "en": "They don't like noise."},
        {"zh": "你跟我走，别出声。", "en": "Come with me. Don't make a sound."},
        {"zh": "这几扇门我试过。", "en": "I've tried these doors."},
        {"zh": "有一扇是通向外面的。", "en": "One of them leads outside."},
        {"zh": "我们现在就过去。", "en": "We go now."},
        {"zh": "我把门轻轻合上。", "en": "I eased the door shut."},
        {"zh": "这样它们会以为没人。", "en": "That way they'll think no one's here."},
        {"zh": "走廊这头的灯更暗。", "en": "The lights are dimmer on this side."},
        {"zh": "我数着天花板上的灯。", "en": "I count the lights overhead."},
        {"zh": "我们还是慢了。", "en": "We're already too slow."},
        {"zh": "脚步声从两边来了。", "en": "Footsteps come from both ends."},
        {"zh": "我拉住了你的袖子。", "en": "I caught your sleeve."},
        {"zh": "我们一起走向那扇门。", "en": "We walk toward that door together."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光照亮走廊，也照亮了别的东西。", "en": "Fire lit the corridor, and something else too."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在地上，手撑住了。", "en": "I hit the floor and caught myself."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水漫上来，我呛了一口。", "en": "The water rose and I choked."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "玻璃全碎了，走廊更亮了一点。", "en": "All the glass broke, and the corridor got brighter."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进了门框。", "en": "The arrow stuck in the doorframe."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一道光照过来，墙上出现了影子。", "en": "Light swept over, and shadows appeared on the wall."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "走了太久，我有点撑不住。", "en": "Walking this long, I'm wearing down."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声顺着走廊滚过去。", "en": "The thunder rolled down the corridor."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里什么都没有，连走廊也没有。", "en": "There's nothing here, not even a corridor."}
      ]
    }
  }
}
