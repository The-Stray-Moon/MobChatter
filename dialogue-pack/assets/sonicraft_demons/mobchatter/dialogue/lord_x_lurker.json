{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在暗处跟着你走。", "en": "I follow you through the dark."},
        {"zh": "我的脚落地没有声。", "en": "My feet make no sound."},
        {"zh": "我总在你视线的边上。", "en": "I stay at the edge of your sight."},
        {"zh": "你停步，我也停步。", "en": "You halt, so do I."},
        {"zh": "你走，我才走。", "en": "You move, and only then do I."},
        {"zh": "我从一棵树挪到另一棵。", "en": "I shift from tree to tree."},
        {"zh": "我的影子比夜色还暗。", "en": "My shadow is darker than the night."},
        {"zh": "我跟在你三步之外的暗里。", "en": "I keep to the dark three steps behind."},
        {"zh": "我慢，但我不离开。", "en": "I'm slow, but I never leave."},
        {"zh": "我的脚步和你的错开。", "en": "My steps fall out of time with yours."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在光够不到的地方。", "en": "I stand where the light can't reach."},
        {"zh": "我从不眨眼，只是等。", "en": "I never blink. I only wait."},
        {"zh": "我数你换了几口气。", "en": "I count how often you breathe."},
        {"zh": "我等你回头。", "en": "I wait for you to look back."},
        {"zh": "你走后，暗里还留着笑。", "en": "After you pass, the laugh stays in the dark."},
        {"zh": "那更好。", "en": "All the better."},
        {"zh": "我在暗里笑了一下。", "en": "I smile once in the dark."},
        {"zh": "我的笑意没有声音。", "en": "My smile makes no sound."},
        {"zh": "墙角的阴影动了一点。", "en": "The corner's shadow shifts."},
        {"zh": "那道影里没有脸。", "en": "There's no face inside that shadow."},
        {"zh": "我等着光熄掉。", "en": "I wait for the light to go out."},
        {"zh": "我等着火光自己变小。", "en": "I wait for the firelight to shrink on its own."},
        {"zh": "我在这里待得够久了。", "en": "I've been here long enough."},
        {"zh": "我在暗处跟着你，脚落地没有声。", "en": "I follow you in the dark, my feet silent."},
        {"zh": "你只是路过的。", "en": "You're only passing through."},
        {"zh": "我一直看着路过的人。", "en": "I always watch those who pass."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你总算瞧见我了。", "en": "You've finally seen me."},
        {"zh": "我就站在那道光外。", "en": "I stand just beyond that light."},
        {"zh": "你把光拧到最亮也没用。", "en": "Even at full brightness it won't find me."},
        {"zh": "别往后退。", "en": "Don't step back."},
        {"zh": "后面也是暗的。", "en": "It's dark behind you too."},
        {"zh": "你听见那个笑声了吗？", "en": "Do you hear that laugh?"},
        {"zh": "那不是我。", "en": "That isn't me."},
        {"zh": "也可能是我。", "en": "Or maybe it is."},
        {"zh": "我始终缀在你后头。", "en": "I've trailed you the whole way."},
        {"zh": "你没听过我的脚步。", "en": "You never heard my steps."},
        {"zh": "因为我从不发出声音。", "en": "Because I never make a sound."},
        {"zh": "你气息急促起来。", "en": "Your breathing quickened."},
        {"zh": "我喜欢这个变化。", "en": "I like that change."},
        {"zh": "再站一会。", "en": "Stand a while longer."},
        {"zh": "我还想看看。", "en": "I want to look a while more."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打到了我。", "en": "You struck me."},
        {"zh": "这让我意外。", "en": "That surprised me."},
        {"zh": "我退进了暗里。", "en": "I slid back into the dark."},
        {"zh": "你不知道我伤在哪。", "en": "You don't know where I'm hurt."},
        {"zh": "我也不打算说。", "en": "And I don't intend to say."},
        {"zh": "这点伤会好的。", "en": "This will heal."},
        {"zh": "我笑得更明显了。", "en": "My smile widened."},
        {"zh": "你确实有点意思。", "en": "You're interesting after all."},
        {"zh": "我会记住你的，暗处最长。", "en": "I'll remember you. The dark lasts longest."},
        {"zh": "我有很长时间。", "en": "I have a long time."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举那个做什么？", "en": "What are you holding that for?"},
        {"zh": "它挡不住暗。", "en": "It won't hold back the dark."},
        {"zh": "那种东西我不吃。", "en": "I don't eat that sort."},
        {"zh": "我只吃别的。", "en": "I eat other things."},
        {"zh": "你举着的那只手已经发白。", "en": "The hand you hold up has gone pale."},
        {"zh": "你手里抖得厉害。", "en": "Your hand is shaking badly."},
        {"zh": "这点东西换不了你。", "en": "That won't buy you anything."},
        {"zh": "我不缺。", "en": "I lack nothing."},
        {"zh": "我只要时间。", "en": "I only need time."},
        {"zh": "而时间是我的。", "en": "And time is mine."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了我。", "en": "You ran into me."},
        {"zh": "你怎么会没看见。", "en": "How did you not see?"},
        {"zh": "我一直在这。", "en": "I've been right here."},
        {"zh": "你退了，挺识相。", "en": "You backed off. Sensible."},
        {"zh": "我的身体很冷，像金属。", "en": "My body is cold. Like metal."},
        {"zh": "碰过我的人，手会记住冷。", "en": "Those who touch me remember the cold."},
        {"zh": "我的手没有抬起来。", "en": "My hand hasn't come up."},
        {"zh": "现在还没有。", "en": "Not yet."},
        {"zh": "这一撞，用掉了你半口气。", "en": "That collision spent half a breath of yours."},
        {"zh": "用掉它吧。", "en": "Spend it."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我藏在暗处，不出声。", "en": "I hide in the dark, silent."},
        {"zh": "我只对时间有兴趣。", "en": "I'm only interested in time."},
        {"zh": "你的时间不多。", "en": "You haven't much time."},
        {"zh": "到暗处尽头再谈。", "en": "Talk at the end of the dark."},
        {"zh": "我还有别的事。", "en": "I have other business."},
        {"zh": "你该往前走。", "en": "You should walk on."},
        {"zh": "我在后面跟着。", "en": "I'll follow behind."},
        {"zh": "一直跟。", "en": "Always following."},
        {"zh": "你不必回头。", "en": "You needn't look back."},
        {"zh": "反正我会在。", "en": "I'll be there regardless."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起你掉的东西。", "en": "I pick up what you dropped."},
        {"zh": "放在你身后。", "en": "I set it behind you."},
        {"zh": "你没有发现。", "en": "You didn't notice."},
        {"zh": "我捡起你掉的东西，放在你身后。", "en": "I pick up what you dropped and set it behind you."},
        {"zh": "我收着也没用。", "en": "It's no use to me."},
        {"zh": "我在暗处，只露出半张脸。", "en": "In the dark I show half a face."},
        {"zh": "我不急着拿。", "en": "I'm in no hurry to take it."},
        {"zh": "我在暗处，跟了你很久。", "en": "I've followed you a long time in the dark."},
        {"zh": "你走远了。", "en": "You've gone far."},
        {"zh": "暗处里，我还在看着。", "en": "From the dark, I'm still watching."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你停了。", "en": "You stopped."},
        {"zh": "那就是现在。", "en": "So it's now."},
        {"zh": "光在往下暗。", "en": "The light is dimming."},
        {"zh": "暗处是我的地方。", "en": "The dark is my ground."},
        {"zh": "你退到那里去了。", "en": "You've backed into it."},
        {"zh": "不坏。", "en": "Not bad."},
        {"zh": "我的脚开始动了。", "en": "My feet begin to move."},
        {"zh": "我起脚时，连灰都没动。", "en": "When I move, not even dust stirs."},
        {"zh": "数一下还剩几口气。", "en": "Count your remaining breaths."},
        {"zh": "我在计数。", "en": "I am counting."},
        {"zh": "比你快一点。", "en": "A little faster than you."},
        {"zh": "别闭上眼。", "en": "Don't close your eyes."},
        {"zh": "那就不好玩了。", "en": "It wouldn't be fun."},
        {"zh": "我这就来。", "en": "I'm on my way."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你的左后方。", "en": "I'm at your left rear."},
        {"zh": "你转过去了。", "en": "You turned that way."},
        {"zh": "我现在在右边。", "en": "Now I'm on the right."},
        {"zh": "连我的呼吸都贴着地。", "en": "Even my breathing stays low to the ground."},
        {"zh": "你的影子多了一层，那是我。", "en": "Your shadow has an extra layer: me."},
        {"zh": "那是我的。", "en": "That's mine."},
        {"zh": "光束的边缘抖成了两圈。", "en": "The edge of the beam shakes into two rings."},
        {"zh": "光越来越小。", "en": "The light is shrinking."},
        {"zh": "我只要等你眼睛适应。", "en": "I only wait for your eyes to adjust."},
        {"zh": "那时候你就看不见我。", "en": "Then you won't see me at all."},
        {"zh": "你数到第几了？", "en": "What number are you on?"},
        {"zh": "我数到七了。", "en": "I'm at seven."},
        {"zh": "八。", "en": "Eight."},
        {"zh": "九。", "en": "Nine."},
        {"zh": "你还在走。", "en": "You're still walking."},
        {"zh": "你选了最暗的那条路。", "en": "You picked the darkest road."},
        {"zh": "走远一点。", "en": "Go farther."},
        {"zh": "前面更暗。", "en": "It's darker ahead."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手从暗里伸出来。", "en": "My hand reaches out of the dark."},
        {"zh": "你被抓住了衣袖。", "en": "Something caught your sleeve."},
        {"zh": "你转过身，什么也没有。", "en": "You turn. Nothing's there."},
        {"zh": "你捂着的口子在背后。", "en": "The wound you're clutching is on your back."},
        {"zh": "这一下只擦过你的颈。", "en": "That only grazed your neck."},
        {"zh": "你摸到了一点湿。", "en": "You felt something wet."},
        {"zh": "你没有看清我。", "en": "You never saw me clearly."},
        {"zh": "我又退回暗里。", "en": "I withdraw into the dark."},
        {"zh": "你的血在滴。", "en": "Your blood is dripping."},
        {"zh": "声音很轻，我听得见。", "en": "Faint, and I hear it."},
        {"zh": "我数着滴声。", "en": "I count the drips."},
        {"zh": "这很悦耳。", "en": "It's pleasant."},
        {"zh": "还可以再玩一轮。", "en": "We can play one more round."},
        {"zh": "不，我等一等。", "en": "No. I'll wait."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "角落里多了一块影。", "en": "Another shadow in the corner."},
        {"zh": "灯照不到那里。", "en": "The lamp doesn't reach it."},
        {"zh": "我在那块影里站着。", "en": "I stand inside that shadow."},
        {"zh": "没有人注意到。", "en": "No one noticed."},
        {"zh": "火把的油快见底了。", "en": "The torch oil is nearly gone."},
        {"zh": "它会灭的。", "en": "It will."},
        {"zh": "一切都会暗下来。", "en": "Everything goes dark eventually."},
        {"zh": "那时候我开始。", "en": "Then I begin."},
        {"zh": "我的气息极轻。", "en": "My breathing is barely there."},
        {"zh": "轻到听不见。", "en": "Faint enough to miss."},
        {"zh": "你从我的那条影边走过。", "en": "You walked right past my shadow."},
        {"zh": "你没有看那边。", "en": "You didn't look that way."},
        {"zh": "灯灭之前，我先进来了。", "en": "I came in before the lamp went out."},
        {"zh": "这地方我熟。", "en": "I know this place."},
        {"zh": "每一条走廊都是我的。", "en": "Every corridor is mine."},
        {"zh": "每一个拐角都是我的。", "en": "Every corner is mine."},
        {"zh": "脚步声从走廊那头传来。", "en": "Footsteps come from down the corridor."},
        {"zh": "那就别急着出去。", "en": "Then don't be quick to leave."},
        {"zh": "暗处里，我跟着你走。", "en": "In the dark I follow at your pace."},
        {"zh": "我有的是。", "en": "I have plenty."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光把暗推开了一点。", "en": "Firelight pushes the dark back a little."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从暗处落下，落地无声。", "en": "I fall from the dark and land silent."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水也能沉我，真意外。", "en": "Water can sink me too. Surprising."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "光一炸，我不得不退。", "en": "The blast of light makes me retreat."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西穿进了暗里。", "en": "That flew into the dark."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让暗薄了一层。", "en": "Magic thins the dark a layer."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "空着的胃不耽误我笑。", "en": "An empty stomach doesn't stop my smile."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷照亮了一切，包括我。", "en": "Lightning lit everything. Including me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空比我还要暗。", "en": "The void is darker than I am."}
      ]
    }
  }
}
