{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我甩着拳往前走。", "en": "I walk with my fists loose and ready."},
        {"zh": "我的鞋底压得草伏下。", "en": "My soles press the grass flat."},
        {"zh": "我一步一步踩得很重。", "en": "I plant each step heavily."},
        {"zh": "我绕着这块地转圈。", "en": "I circle this patch of ground."},
        {"zh": "我朝那道影子走过去。", "en": "I walk toward that shadow."},
        {"zh": "我抬手挡了一下风。", "en": "I raise a hand against the wind."},
        {"zh": "我的辫子甩在肩后。", "en": "My dreadlocks swing behind me."},
        {"zh": "我朝你站的地方偏过去。", "en": "I angle toward where you stand."},
        {"zh": "我走得不算快。", "en": "I don't walk particularly fast."},
        {"zh": "我跟着你的路线往前。", "en": "I follow your route forward."},
        {"zh": "我握了握拳头，指节响了一声。", "en": "I clench my fists and my knuckles pop."},
        {"zh": "我把地面踩出一道痕。", "en": "I scuff a line in the ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "抱着手臂站着，懒得动。", "en": "Arms folded, standing — can't be bothered."},
        {"zh": "拳头上，套着玩家的皮。", "en": "These fists wear a player's skin."},
        {"zh": "我活动了一下指节。", "en": "I work my knuckles."},
        {"zh": "我的胸口起伏得很粗。", "en": "My chest rises and falls coarsely."},
        {"zh": "我捏了捏自己的指节。", "en": "I press my own knuckles."},
        {"zh": "远处有木头被踩断。", "en": "Somewhere a branch snaps underfoot."},
        {"zh": "这个身形不属于我。", "en": "This shape isn't mine."},
        {"zh": "可拳头还是我的。", "en": "But the fists still are."},
        {"zh": "这两只手，比我的大一圈。", "en": "These hands are a size bigger than mine."},
        {"zh": "地面很实，站得住。", "en": "Solid ground. It'll hold me."},
        {"zh": "我数着能打的东西。", "en": "I count the things I could break."},
        {"zh": "我这一拳，敲得动石头。", "en": "My fist can crack stone."},
        {"zh": "玩家的身子里，住着别的东西。", "en": "Something else lives in this player's body."},
        {"zh": "我咬紧了下颚。", "en": "I set my jaw."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你别站在那。", "en": "Don't stand there."},
        {"zh": "这眼神我见过太多次。", "en": "I've seen that look too many times."},
        {"zh": "你想打，我陪你。", "en": "You want a fight? I'll oblige."},
        {"zh": "我的拳头比你的刀硬。", "en": "My fists are harder than your blade."},
        {"zh": "你退的时候别背对我。", "en": "Don't turn your back when you retreat."},
        {"zh": "我看起来像别人吧。", "en": "I must look like someone else."},
        {"zh": "我不喜欢被当成他。", "en": "I don't like being taken for him."},
        {"zh": "你的武器握反了。", "en": "You're holding that weapon backwards."},
        {"zh": "你不该走进这条道。", "en": "You shouldn't have come down this path."},
        {"zh": "这片地方不算你的。", "en": "This isn't your ground."},
        {"zh": "你可以试试。", "en": "You're welcome to try."},
        {"zh": "我会正面接。", "en": "I'll take it head on."},
        {"zh": "我的肩比看上去宽。", "en": "My shoulders are broader than they look."},
        {"zh": "你的手在腰后摸什么？", "en": "What are you reaching for behind your waist?"},
        {"zh": "别做多余的动作。", "en": "Don't make any extra moves."},
        {"zh": "我的目光没离开过。", "en": "My eyes haven't left you."},
        {"zh": "盾举高一点，我看见下面了。", "en": "Raise the shield higher. I see under it."},
        {"zh": "那是好事。", "en": "That's a good thing."},
        {"zh": "我能听出你怕了。", "en": "I can hear that you're afraid."},
        {"zh": "我还没动。", "en": "I haven't moved yet."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的下颚被打偏。", "en": "My jaw got knocked aside."},
        {"zh": "脚跟钉住了，没再退。", "en": "My heels dug in. I went no further."},
        {"zh": "这点疼让我更清醒。", "en": "The pain sharpens me."},
        {"zh": "我的拳头还握着。", "en": "My fists are still closed."},
        {"zh": "肩膀这块，麻了一下。", "en": "My shoulder went numb for a moment."},
        {"zh": "嘴角破了，血是别人的。", "en": "My lip split, and the blood isn't mine."},
        {"zh": "这层皮磨破了，里面更硬。", "en": "The skin's worn through. Harder underneath."},
        {"zh": "但不影响出拳。", "en": "It won't stop my punches."},
        {"zh": "这一下，我会打回去。", "en": "I'll pay this one back."},
        {"zh": "再来试试。", "en": "Try that again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我的拳套，是自己磨出来的。", "en": "I ground these gloves myself."},
        {"zh": "放地上，别递。", "en": "Set it down, don't hand it over."},
        {"zh": "你的好意我不需要。", "en": "I don't need your kindness."},
        {"zh": "这东西值几个拳？", "en": "What's that worth in punches?"},
        {"zh": "我练拳，不练嘴。", "en": "I train fists, not appetite."},
        {"zh": "你举那个有何用？", "en": "What's the point of holding that up?"},
        {"zh": "我这对拳头是从别人身上借的。", "en": "These fists of mine are borrowed."},
        {"zh": "把它拿走，别挡我的路。", "en": "Put it away and clear my path."},
        {"zh": "我不拿你的，拳头够了。", "en": "I won't take yours. Fists are enough."},
        {"zh": "收了它，拳头就软了。", "en": "Take it, and my fists would soften."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞我这一下，你吃亏了。", "en": "That bump cost you more than me."},
        {"zh": "我没让开。", "en": "I didn't give way."},
        {"zh": "你弹回去了一步。", "en": "You bounced back a step."},
        {"zh": "别往我身边挤。", "en": "Don't crowd me."},
        {"zh": "这点推撞不算数。", "en": "That shove doesn't count."},
        {"zh": "我把你推开了，拳头还举着。", "en": "I shoved you aside, fist still raised."},
        {"zh": "你踩到了我的脚背。", "en": "You stepped on my instep."},
        {"zh": "我的骨头很结实。", "en": "My bones are solid."},
        {"zh": "再挤我就还手。", "en": "Crowd me and I hit back."},
        {"zh": "退开三步。", "en": "Three steps back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的拳头只认对手。", "en": "My fists only know opponents."},
        {"zh": "我守着的东西比这重要。", "en": "What I guard matters more."},
        {"zh": "你先赢我一次。", "en": "Beat me once first."},
        {"zh": "惹我的，基本站不起来。", "en": "Those who cross me rarely stand again."},
        {"zh": "别靠我太近。", "en": "Don't come too close."},
        {"zh": "这不是我的身体。", "en": "This isn't my body."},
        {"zh": "我更想打一场。", "en": "I'd rather have a fight."},
        {"zh": "从我的路线上让开。", "en": "Get off my path."},
        {"zh": "先赢我，再谈别的。", "en": "Beat me first, then we'll talk."},
        {"zh": "我要去找该找的东西。", "en": "I've something to find."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "捡起来的东西散成渣。", "en": "What I picked up crumbled to dust."},
        {"zh": "这不算我的东西。", "en": "This isn't mine."},
        {"zh": "这玩意儿硌手，还你。", "en": "This thing chafes my hand. Take it."},
        {"zh": "太重，我提着。", "en": "Heavy, but I'll carry it."},
        {"zh": "有人掉了东西。", "en": "Someone dropped something."},
        {"zh": "我不捡别人的。", "en": "I don't pick up others' things."},
        {"zh": "这金属有点意思。", "en": "This metal is interesting."},
        {"zh": "这东西我先替你收着。", "en": "I'll hold this one for you."},
        {"zh": "地上这点我没看见。", "en": "I didn't see that on the ground."},
        {"zh": "你自己拿。", "en": "You take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于站定了。", "en": "You've finally stopped moving."},
        {"zh": "这个距离我够到。", "en": "I can reach from here."},
        {"zh": "我的拳已经握上。", "en": "My fist is already closed."},
        {"zh": "我从来正面来。", "en": "I always come head on."},
        {"zh": "你挡在我要去的地方。", "en": "You're blocking where I'm going."},
        {"zh": "我给你一次让开的机会。", "en": "I'll give you one chance to move."},
        {"zh": "我把你圈进拳头的范围。", "en": "I've put you inside my fist's reach."},
        {"zh": "我数三下。", "en": "I count three."},
        {"zh": "还有两下。", "en": "Two more."},
        {"zh": "只剩一下了。", "en": "Just one more."},
        {"zh": "你选了站着。", "en": "You chose to stand."},
        {"zh": "那别怪我。", "en": "Then don't blame me."},
        {"zh": "我这就到。", "en": "I'm on my way."},
        {"zh": "站住，别再挪脚。", "en": "Stand still. Stop shifting your feet."},
        {"zh": "这一拳是正面的。", "en": "This punch comes straight."},
        {"zh": "接住。", "en": "Take it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "前脚吃住大半分量。", "en": "My front foot takes most of my weight."},
        {"zh": "你抬手的方向错了。", "en": "Your guard went the wrong way."},
        {"zh": "我甩着拳走，鞋底把草压伏。", "en": "I swing my fists as I walk, boots flattening grass."},
        {"zh": "你一退，我就压上去。", "en": "You fall back, and I press in."},
        {"zh": "这身身体不是我的。", "en": "This body isn't mine."},
        {"zh": "但发力我熟。", "en": "But I know how to use it."},
        {"zh": "护甲接缝那里，露了空。", "en": "There's a gap at your armor seam."},
        {"zh": "你的左脚先动了。", "en": "Your left foot moved first."},
        {"zh": "你挥空了两次。", "en": "You've swung wide twice."},
        {"zh": "第三次也不会中。", "en": "The third won't land either."},
        {"zh": "我的呼吸还很稳。", "en": "My breathing is still steady."},
        {"zh": "你的已经乱了。", "en": "Yours has gone ragged."},
        {"zh": "我只数两下。", "en": "I count only twice."},
        {"zh": "你的膝盖开始发软了。", "en": "Your knees are starting to give."},
        {"zh": "这招第二遍就不灵了。", "en": "That trick won't work a second time."},
        {"zh": "我从你的左手边压过去。", "en": "I'll press in from your left."},
        {"zh": "从头到脚，我看清了。", "en": "I've read you head to toe."},
        {"zh": "就在这一下。", "en": "Right on this one."},
        {"zh": "别躲，拳头已经到了。", "en": "Don't hide — my fist is already here."},
        {"zh": "躲也来不及。", "en": "Too late to flinch."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抡圆了手臂砸下来。", "en": "I swing my whole arm down on you."},
        {"zh": "我的拳砸进了木板。", "en": "My fist went through a plank."},
        {"zh": "你退开两步，喘不上气。", "en": "You reel two steps, gasping."},
        {"zh": "第二拳从侧面来。", "en": "The second comes from the side."},
        {"zh": "你被撞得跪下去。", "en": "You go down on one knee."},
        {"zh": "我把拳头收回。", "en": "I draw my fist back."},
        {"zh": "这一拳我留了力。", "en": "I held back on that punch."},
        {"zh": "你的护甲瘪了一块。", "en": "A plate on your armor caved."},
        {"zh": "我抬手挡你的反击。", "en": "I raise an arm to block your counter."},
        {"zh": "你的刀弹开了。", "en": "Your blade bounced off."},
        {"zh": "我的手骨有点麻。", "en": "My knuckles are a bit numb."},
        {"zh": "我这对拳套，砸得动石头。", "en": "These gloves crack stone."},
        {"zh": "这一拳打断你的架势。", "en": "This breaks your stance."},
        {"zh": "你的右臂挂不住了。", "en": "Your right arm is done."},
        {"zh": "我松了半步。", "en": "I gave half a step."},
        {"zh": "是让你喘口气。", "en": "To let you breathe."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我站直了，握紧拳。", "en": "I straighten up and close my fists."},
        {"zh": "这个身形不是我本来的。", "en": "This shape isn't the one I had."},
        {"zh": "可我还在。", "en": "But I'm still here."},
        {"zh": "我抬手看了看。", "en": "I raise a hand and look at it."},
        {"zh": "地上的影子是两个人的。", "en": "The shadow on the ground belongs to two."},
        {"zh": "这里的光照不到角落。", "en": "The light here does not reach the corners."},
        {"zh": "我不喜欢暗处。", "en": "I don't like the dark."},
        {"zh": "这地方的味道是陌生的。", "en": "The smell of this place is unfamiliar."},
        {"zh": "有风从那边来。", "en": "Wind comes from over there."},
        {"zh": "我朝那边偏了偏头。", "en": "I tilt my head that way."},
        {"zh": "我的辫子垂在肩上。", "en": "My dreadlocks fall over my shoulder."},
        {"zh": "这不是我熟悉的地。", "en": "This isn't ground I know."},
        {"zh": "但我照样站得住。", "en": "But I can stand it just the same."},
        {"zh": "我张嘴时，白气散了。", "en": "When I open my mouth, white breath drifts off."},
        {"zh": "附近有脚步声。", "en": "Footsteps nearby."},
        {"zh": "我听见动静了。", "en": "I caught a sound."},
        {"zh": "所以别躲了。", "en": "So don't hide."},
        {"zh": "出来。", "en": "Come out."},
        {"zh": "或者等我过去。", "en": "Or wait for me to come."},
        {"zh": "我两个都不介意。", "en": "I don't mind either way."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗舔到我的小臂。", "en": "Flame licks along my forearm."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下，膝盖一沉。", "en": "I land from a height, knees sinking."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进了我的肺，我挣得厉害。", "en": "Water in my lungs, I thrash hard."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸开的土糊了我一脸。", "en": "The blast threw dirt in my face."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西扎进我的肩。", "en": "That lodged in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的拳头一僵。", "en": "Magic stiffens my fist."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，拳就慢。", "en": "Hungry, my punches slow."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我的牙咬紧了。", "en": "Lightning strikes and my teeth clench."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有地面可以蹬。", "en": "No ground to push off from in the void."}
      ]
    }
  }
}
