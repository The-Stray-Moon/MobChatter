{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "雾里有个形状在移动", "en": "A shape moves inside the mist."},
        {"zh": "我走在雾的最里面", "en": "I walk in the deepest part of the mist."},
        {"zh": "雾跟着我，一起往前", "en": "The mist moves with me."},
        {"zh": "我走过的草，比别处冷。", "en": "The grass I cross runs colder."},
        {"zh": "草在我经过时弯下去", "en": "Grass bends as I pass."},
        {"zh": "然后又慢慢直起来", "en": "Then slowly straightens."},
        {"zh": "我的轮廓一直不清楚", "en": "My outline never comes clear."},
        {"zh": "走近看更模糊", "en": "Closer up, it blurs more."},
        {"zh": "我绕到树后，你没有跟来。", "en": "I slip behind the tree; you don't follow."},
        {"zh": "雾先到，我后到", "en": "The mist arrives before I do."},
        {"zh": "我呼出的气息很冷", "en": "My breath is cold."},
        {"zh": "所过之处温度都低一些", "en": "Everywhere I pass runs colder."},
        {"zh": "我一直在走，不走直线", "en": "I keep moving. Never straight."},
        {"zh": "这样更难被看清", "en": "Harder to make out that way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在一片雾里", "en": "I stop inside a bank of mist."},
        {"zh": "雾浓得看不见地面", "en": "So thick I can't see the ground."},
        {"zh": "我就在这儿候着", "en": "I wait right here."},
        {"zh": "等着有人走进来", "en": "For someone to walk in."},
        {"zh": "我已经在这片雾里站了很久。", "en": "I have stood in this mist a long while."},
        {"zh": "雾在我身边聚成一个圈", "en": "Mist gathers in a ring around me."},
        {"zh": "圈里的声音很闷", "en": "Sounds go muffled in it."},
        {"zh": "远处有脚步，我屏住气听。", "en": "Footsteps far off; I hold my breath."},
        {"zh": "我等雾再浓一点。", "en": "I wait for the mist to thicken."},
        {"zh": "我再等上一等", "en": "I'll wait a little more."},
        {"zh": "雾不散，我就不动", "en": "While the mist holds, I don't move."},
        {"zh": "它一直都不散", "en": "And it doesn't disperse."},
        {"zh": "所以我也一直在", "en": "So I stay."},
        {"zh": "等你自己靠近", "en": "Until you come close on your own."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛在雾里亮了一下。", "en": "My eyes glimmer once in the mist."},
        {"zh": "别回头，我就在你耳边。", "en": "Don't look back. I'm at your ear."},
        {"zh": "再看一眼就没了", "en": "Look again and they're gone."},
        {"zh": "我贴着你的肩膀站着。", "en": "I stand close against your shoulder."},
        {"zh": "你不该往这边走", "en": "You shouldn't have come this way."},
        {"zh": "我抬起手，雾跟着动", "en": "I raise a hand and the mist moves."},
        {"zh": "你看不清那是什么", "en": "You can't tell what it is."},
        {"zh": "我自己也说不清", "en": "Nor can I."},
        {"zh": "我往你那边进了一步", "en": "I take a step your way."},
        {"zh": "雾把我们的距离遮住了", "en": "The mist hides the distance."},
        {"zh": "这已经是最后一步", "en": "This is the last step."},
        {"zh": "你还不打算跑吗", "en": "Aren't you going to run?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "雾散了一下下", "en": "The mist scatters."},
        {"zh": "随后又重新聚拢", "en": "Then gathers again."},
        {"zh": "我后退好几步", "en": "I retreat several paces."},
        {"zh": "你打中的是雾", "en": "You struck mist."},
        {"zh": "我还没有碰到它", "en": "It hasn't reached me."},
        {"zh": "我转到另一侧", "en": "I move to the other side."},
        {"zh": "你的方向错了", "en": "Your direction is wrong."},
        {"zh": "雾会一直遮着我的", "en": "The mist will always hide me."},
        {"zh": "打在我身上的，只是雾。", "en": "What you strike is only mist."},
        {"zh": "你永远找不到", "en": "You won't find me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在雾里晃", "en": "Something sways in the mist."},
        {"zh": "我伸手探过去", "en": "I reach toward it."},
        {"zh": "手指直接穿过雾", "en": "My fingers pass through mist."},
        {"zh": "碰到一点实物", "en": "Then touch something solid."},
        {"zh": "可我拿不走它", "en": "I can't carry it away."},
        {"zh": "我会让你放下", "en": "I'll make you put it down."},
        {"zh": "或者我自己过来取", "en": "Or I'll come and take it."},
        {"zh": "你选了哪一个", "en": "Which will it be?"},
        {"zh": "雾已经到你脚边了", "en": "The mist is at your feet."},
        {"zh": "现在就做选择吧", "en": "Choose now."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞进了雾里", "en": "You blunder into the mist."},
        {"zh": "冷从四周贴上来", "en": "Cold presses in from all sides."},
        {"zh": "你伸手，什么都没碰到", "en": "You reach out and touch nothing."},
        {"zh": "我在你的另一边", "en": "I'm on the other side."},
        {"zh": "雾轻轻动了一下", "en": "The mist shifts."},
        {"zh": "你转身，雾比你先动。", "en": "You turn; the mist moves before you do."},
        {"zh": "那边同样全是雾", "en": "More mist there."},
        {"zh": "你听见呼吸声", "en": "You hear breathing."},
        {"zh": "声音已经很近", "en": "Very close."},
        {"zh": "可是看不见人", "en": "But no one to see."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这雾里没有同伴", "en": "There are no companions in the mist."},
        {"zh": "从头到尾只有我", "en": "Only me."},
        {"zh": "还有那些走不出去的", "en": "And those who couldn't leave."},
        {"zh": "它们也在雾里", "en": "They're in the mist too."},
        {"zh": "我们互相看不见", "en": "We can't see each other."},
        {"zh": "只听得见彼此的声音", "en": "Only hear one another."},
        {"zh": "有时候会应一声", "en": "Sometimes one of us answers."},
        {"zh": "大多数时候不应", "en": "Mostly not."},
        {"zh": "雾里安静得很", "en": "It's quiet in the mist."},
        {"zh": "能有这样就够了", "en": "That's enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把手伸进雾里", "en": "I reach into the mist."},
        {"zh": "东西落在我手里", "en": "It lands in my hand."},
        {"zh": "我试着握了一握", "en": "I close my grip."},
        {"zh": "可我的手是虚的", "en": "But my hand is hollow."},
        {"zh": "它直直掉下去", "en": "It falls through."},
        {"zh": "我仍旧站在原地", "en": "I stand there."},
        {"zh": "看着它落进雾里", "en": "Watching it drop into the mist."},
        {"zh": "一点声音也没有", "en": "No sound."},
        {"zh": "连落地声都没有", "en": "Not even a landing."},
        {"zh": "雾把一切都吞了", "en": "The mist swallows everything."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了我的雾", "en": "You've entered my mist."},
        {"zh": "雾从四面合上", "en": "The mist closes from all sides."},
        {"zh": "你回头，来路没了", "en": "You look back. The way in is gone."},
        {"zh": "我就在不远处", "en": "I'm not far off."},
        {"zh": "你没有武器能碰到我", "en": "No weapon of yours can reach me."},
        {"zh": "铁也一样不行", "en": "Not even iron."},
        {"zh": "你亲手试过才会信", "en": "You'll believe it once you try."},
        {"zh": "那我就让你试", "en": "So I'll let you try."},
        {"zh": "我一寸寸靠近", "en": "I creep closer inch by inch."},
        {"zh": "雾变得越来越浓", "en": "The mist thickens."},
        {"zh": "你的呼吸成了白雾", "en": "Your breath turns to vapor."},
        {"zh": "那就开始跑吧", "en": "Start running."},
        {"zh": "跑其实也没有用", "en": "It won't help."},
        {"zh": "可我就是喜欢看", "en": "But I like to watch."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我保持三格的距，不走快。", "en": "I keep three blocks off, never faster."},
        {"zh": "你走得快，我也快", "en": "Quick steps, quick following."},
        {"zh": "你停下，我就停在更近的地方", "en": "You stop. I stop closer."},
        {"zh": "雾在前面先拦住你", "en": "The mist blocks you ahead."},
        {"zh": "你转了个方向", "en": "You turn a new way."},
        {"zh": "那边同样没有出口", "en": "No way out there either."},
        {"zh": "这里的路是绕的", "en": "The paths here loop."},
        {"zh": "你走过的地方我都走过", "en": "I've walked everywhere you have."},
        {"zh": "你听不清方位", "en": "You can't place the sounds."},
        {"zh": "我故意弄出一点声音", "en": "I make a little noise on purpose."},
        {"zh": "声音在你的左边", "en": "On your left."},
        {"zh": "现在到了右边", "en": "Now the right."},
        {"zh": "你的呼吸乱了拍子", "en": "Your breathing lost its rhythm."},
        {"zh": "已经非常快了", "en": "Almost."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手抓住了你", "en": "My hand closes on you."},
        {"zh": "你以为抓住了铁", "en": "You thought you held iron."},
        {"zh": "那不过是一团雾", "en": "That was mist."},
        {"zh": "冷从接触的地方传进去", "en": "Cold passes in where we touch."},
        {"zh": "我的手一贴上你，你就冷了。", "en": "My hand touches you and you go cold."},
        {"zh": "雾也跟着你退", "en": "The mist retreats with you."},
        {"zh": "你用力挥了一刀", "en": "You swing your blade."},
        {"zh": "刀刃直接穿过去", "en": "It passes through."},
        {"zh": "连声音都没有", "en": "Without even a sound."},
        {"zh": "刀剑砍不散雾里的我。", "en": "Blades can't scatter the mist of me."},
        {"zh": "你不该停下来的", "en": "You shouldn't have stopped."},
        {"zh": "现在不容易走了", "en": "Now it's harder to leave."},
        {"zh": "那就继续跑下去", "en": "Keep running."},
        {"zh": "千万不要回头看", "en": "Don't look back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雾先到，我才从里面成形。", "en": "The mist comes first; I take shape inside it."},
        {"zh": "淡得几乎看不见", "en": "Very faint."},
        {"zh": "然后又浓了一点", "en": "Then a little denser."},
        {"zh": "我稍微动了动", "en": "I move."},
        {"zh": "雾也跟着动了", "en": "The mist moves too."},
        {"zh": "四周没有声音", "en": "No sound anywhere."},
        {"zh": "连一丝风都没有", "en": "Not even wind."},
        {"zh": "我在雾里站着", "en": "I stand within the mist."},
        {"zh": "看不太出形状", "en": "The shape is hard to read."},
        {"zh": "有人会走过来", "en": "Someone will walk over."},
        {"zh": "他们总会走过来", "en": "They always do."},
        {"zh": "以为只是一片雾", "en": "Thinking it's only fog."},
        {"zh": "我把雾往四周铺开", "en": "I spread the mist outward."},
        {"zh": "范围比昨天大一点", "en": "A little wider than yesterday."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光把雾照散了", "en": "Firelight scatters the mist."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，没有声音", "en": "I fall without a sound."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我压得散了", "en": "Water presses me apart."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把雾整个掀开", "en": "The blast strips the mist away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "东西穿过去，雾又合上", "en": "It passes through and the mist closes."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股力竟能抓住我", "en": "This force can grip me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不饿，也没有身体", "en": "I don't hunger. I've no body to."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让雾散得太快", "en": "Lightning makes the mist scatter too fast."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "雾也被吸走了", "en": "The mist is pulled away too."}
      ]
    }
  }
}
