    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嗡嗡嗡，飞向远方！", "en": "Buzz, buzz, buzz, fly away!"},
        {"zh": "跟上队伍，别掉队！", "en": "Follow the swarm, don't fall behind!"},
        {"zh": "嗡嗡，寻找目标！", "en": "Buzz, seek the target!"},
        {"zh": "嗡嗡嗡，捕食时刻！", "en": "Buzz, buzz, buzz, hunt time!"},
        {"zh": "嗡嗡，警惕敌情！", "en": "Buzz, beware the enemy!"},
        {"zh": "嗡嗡嗡，回家路上！", "en": "Buzz, buzz, buzz, homebound!"},
        {"zh": "嗡嗡，巢穴安全！", "en": "Buzz, the hive is secure!"},
