    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轻盈飘过，如森林精灵！", "en": "Fluttering like a forest sprite."},
        {"zh": "呼吸间，魔法气息浓厚！", "en": "Magic in the air with each breath."},
        {"zh": "叶片下穿梭，如影随形！", "en": "Dancing among the leaves, a shadowy form."},
        {"zh": "翅膀扇动，风中传来低吟！", "en": "Wings flapping, a soft whisper in the wind."},
        {"zh": "森林深处，我自由翱翔！", "en": "Free to soar in the forest depths."},
        {"zh": "我来自古老而神秘的森林！", "en": "From the ancient and mystical forest."},
        {"zh": "触摸树叶，感受魔法力量！", "en": "Feel the magic through the leaves."},
        {"zh": "我与树木心灵相通！", "en": "I share a mind with the trees."},
        {"zh": "森林精灵，守护着秘密！", "en": "Forest spirit, guardian of secrets."},
        {"zh": "飘过，不留痕迹！", "en": "Passing by, leaving no trace."},
        {"zh": "掠过树干，带着绿光", "en": "I skim the trunks, trailing green light"},
        {"zh": "爪尖点叶，无声前行", "en": "Claws on leaves, moving without sound"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静止在树梢，观察着！", "en": "Hanging on the branch, observing."},
        {"zh": "闭目养神，魔法自生！", "en": "Closing my eyes, magic abounds."},
        {"zh": "在阳光下打盹，如梦似幻！", "en": "Dozing in the sunlight, a dreamy state."},
        {"zh": "凝视远方，思绪万千！", "en": "Gazing into the distance, thoughts abound."},
        {"zh": "轻抚叶片，享受宁静！", "en": "Petting the leaves, enjoying the peace."},
        {"zh": "微风中，享受片刻安宁！", "en": "Basking in the breeze, a moment of peace."},
        {"zh": "静静等待，一切尽在掌握！", "en": "Silently waiting, all is in my control."},
        {"zh": "在这片森林中，我安然无恙！", "en": "Safe and sound in this forest."},
        {"zh": "享受自然，我最钟爱！", "en": "Nature's beauty, my greatest love."},
        {"zh": "静待时机，一切尽在掌控！", "en": "Waiting for the right moment, control is mine."},
        {"zh": "伏在老树的枝桠上", "en": "Crouched in an old tree's fork"},
        {"zh": "听着森林的呼吸声", "en": "Listening to the forest breathe"},
        {"zh": "尾巴垂着，慢慢晃", "en": "Tail hanging, swaying slowly"},
        {"zh": "苔藓的气味让我安心", "en": "The smell of moss settles me"},
        {"zh": "原始森林的光很淡", "en": "The primal forest light is faint"},
        {"zh": "我在等落叶落完", "en": "I wait for the leaves to finish falling"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "发现你，我感到好奇！", "en": "I'm curious about you."},
        {"zh": "你的存在，引起我的注意！", "en": "Your presence catches my eye."},
        {"zh": "你会成为我的朋友吗？", "en": "Will you be my friend?"},
        {"zh": "来吧，让我们共舞！", "en": "Come, let's dance together."},
        {"zh": "你给了我新的启示！", "en": "You've given me new insights."},
        {"zh": "你身上的魔力吸引我！", "en": "The magic in you draws me."},
        {"zh": "你的力量，让我心动！", "en": "Your strength moves me."},
        {"zh": "让我们共同守护这里！", "en": "Let's protect this place together."},
        {"zh": "你也是森林的一部分！", "en": "You're part of the forest too."},
        {"zh": "与我对话，建立联系！", "en": "Talk to me, establish a connection."},
        {"zh": "你踩断的枝，我听见了", "en": "I heard the twig you broke"},
        {"zh": "我从树后看你", "en": "I watch you from behind the tree"},
        {"zh": "你的影子进了我的林子", "en": "Your shadow entered my woods"},
        {"zh": "抬头，我在上面", "en": "Look up. I'm above you"}
      ]
    },
