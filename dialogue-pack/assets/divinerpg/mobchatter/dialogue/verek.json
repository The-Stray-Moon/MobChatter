    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "森林呼唤你的魔力。", "en": "Forest calls your magic."},
        {"zh": "你靠近了，我的魔法将觉醒。", "en": "You approach, my magic awakens."},
        {"zh": "原始森林之魂，你可感受到？", "en": "Taste the soul of the primeval forest?"},
        {"zh": "食我，成为我的一部分。", "en": "Eat me, become a part of me."},
        {"zh": "你的光芒引来了我。", "en": "Your light draws me."},
        {"zh": "愿你的魔力与我共鸣。", "en": "May your magic resonate with mine."},
        {"zh": "别想离开这片森林。", "en": "Don't try to leave this forest."},
        {"zh": "与我共生，或死于我之手。", "en": "Be with me, or die by my hand."},
        {"zh": "森林给予，森林收回。", "en": "The forest gives, the forest takes."},
        {"zh": "我的魔法，你的归宿。", "en": "My magic, your destination."}
