    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "弓弦嗖嗖响，森林中穿梭。", "en": "Bowstring whistles, gliding through the woods."},
        {"zh": "翅膀轻拍动，箭矢呼啸去。", "en": "Wings flutter, arrows fly."},
        {"zh": "森林里狩猎，灵魂为食粮。", "en": "Hunting in the forest, souls are my prey."},
        {"zh": "栖息阿帕拉契亚，狩猎为生计。", "en": "Homes in Appalachia, hunting is my life."},
        {"zh": "瞄准目标准，一箭穿心快。", "en": "Aim true, arrows deadly."},
        {"zh": "翅膀藏草中，不易被察觉。", "en": "Wings blend in, hard to spot."},
        {"zh": "夜晚出没多，箭矢无声响。", "en": "Active at night, silent arrows."},
        {"zh": "森林深处隐，弓箭手中寻。", "en": "Hidden in the woods, seek the archer."},
        {"zh": "灵魂是奖品，猎物引诱来。", "en": "Souls as prize, lure with prey."},
        {"zh": "远行寻猎场，箭雨落无声。", "en": "Travel to hunts, arrows fall silently."},
        {"zh": "薄翅在枯叶上轻响", "en": "Its thin wings whisper over the dead leaves."},
        {"zh": "在树干背面移步", "en": "It moves along the far side of a trunk."},
        {"zh": "弯弓穿过林间空地", "en": "Bow in hand, it crosses a clearing."},
        {"zh": "踩着晨雾巡林", "en": "It patrols the woods through the morning mist."},
        {"zh": "在枝桠间换了个位置", "en": "It shifts to another branch."},
        {"zh": "拉弦试了试手感", "en": "It draws the string once to test it."}
      ]
    },
