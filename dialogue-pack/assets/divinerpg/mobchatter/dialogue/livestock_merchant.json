    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "蹄声哒哒响，羊毛随风飘。", "en": "Hoof beats tap, fleece flutters in breeze."},
        {"zh": "牛铃叮当响，我缓缓走来。", "en": "Bell jingles, I come slowly."},
        {"zh": "我穿过田野，咀嚼着草。", "en": "I step through fields, chewing grass."},
        {"zh": "蹄子轻点地，我寻找买卖。", "en": "Hooves tap gently, seeking trade."},
        {"zh": "缓缓走来，羊毛遮住视线。", "en": "Slowly come, fleece blocks vision."},
        {"zh": "牛铃声声，我轻步而行。", "en": "Bell rings, I step lightly."},
        {"zh": "我走过草地，寻找交易对象。", "en": "I walk through meadow, seeking trade."},
        {"zh": "蹄声轻，草间悠闲行。", "en": "Hooves soft, strolling through grass."},
        {"zh": "牛铃脆响，我稳重前行。", "en": "Bell chimes, I move steadily."},
        {"zh": "缓缓走来，带来交易希望。", "en": "Slowly come, bring trade hope."},
        {"zh": "牵着缰绳，绕过栅栏。", "en": "Leading a halter around the fence."},
        {"zh": "靴子踩过干草堆，沙沙响。", "en": "Boots crunch through the hay."},
        {"zh": "怀里抱着小羊，走得很慢。", "en": "Carrying a lamb, walking slow."},
        {"zh": "数着圈里的头数，一路走。", "en": "Counting heads in the pen as I go."},
        {"zh": "推着草料车，吱呀作响。", "en": "Pushing a feed cart that creaks."},
        {"zh": "拍拍牛背，继续巡栏。", "en": "Patting a cow's back, I keep patrolling."}
      ]
    },
