{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "低语着远古咒语", "en": "muttering ancient spells"},
        {"zh": "步伐沉重，如影随形", "en": "heavy steps, following you"},
        {"zh": "发出沙哑的低吟", "en": "raspy growl"},
        {"zh": "缓慢接近，步步惊心", "en": "slowly closing in"},
        {"zh": "窥伺着每一个角落", "en": "watching every corner"},
        {"zh": "低垂着头颅行走", "en": "walking with lowered head"},
        {"zh": "偶尔啃食腐朽木块", "en": "occasionally munching on decayed wood"},
        {"zh": "警惕地观察四周环境", "en": "alertly scanning the surroundings"},
        {"zh": "踏过阴影，无声无息", "en": "stepping over shadows, soundless"},
        {"zh": "摸索着前行，谨慎而坚定", "en": "feeling its way, cautious and resolute"},
        {"zh": "指尖拖过秘界的黑岩", "en": "My fingertips drag along Nether-dark stone."},
        {"zh": "踩碎秘界地面的薄壳", "en": "I crack the thin crust of this realm's floor."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静止不动，仿佛雕像", "en": "motionless, like a statue"},
        {"zh": "目光呆滞，如同死寂", "en": "dull gaze, like death"},
        {"zh": "偶有微风吹过耳畔", "en": "occasional breeze in its ears"},
        {"zh": "一动不动，静默如谜", "en": "motionless, silent as a mystery"},
        {"zh": "呆滞地环顾四周", "en": "staring around blankly"},
        {"zh": "偶有风吹草动", "en": "occasional rustle"},
        {"zh": "静默中等待机会", "en": "waiting in silence for an opportunity"},
        {"zh": "静止中凝视远方", "en": "staring into the distance"},
        {"zh": "呆滞眼神，如死水般无波", "en": "lifeless gaze, like still water"},
        {"zh": "静默中思考未来", "en": "silent thoughts about the future"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "秘界的风把你的气味送来了。", "en": "The wind of the secret realm carries your scent."},
        {"zh": "目光锁定，步步紧逼", "en": "eyes locking on, closing in"},
        {"zh": "直视你，眼神凶猛", "en": "glaring at you, fierce eyes"},
        {"zh": "紧紧盯住你，不放", "en": "staring intently at you, unrelenting"},
        {"zh": "目光如炬，搜寻着弱点", "en": "eyes like torches, searching for weakness"},
        {"zh": "注视你，仿佛要吞掉你", "en": "staring as if to devour you"},
        {"zh": "凶狠地盯着你", "en": "ferociously staring at you"},
        {"zh": "眼神凶恶，毫不掩饰", "en": "feral eyes, unhidden hatred"},
        {"zh": "目光冷酷，毫无感情", "en": "cold eyes, devoid of emotion"},
        {"zh": "紧盯着你，毫不退让", "en": "fixing you with unwavering gaze"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身体开始变暗，光芒消逝。", "en": "The light fades from your body."},
        {"zh": "皮肤裂开，痛苦不已。", "en": "Skin cracks, causing pain."},
        {"zh": "血肉模糊，伤口渗血。", "en": "Wounds ooze blood, matted and raw."},
        {"zh": "力量渐弱，脚步蹒跚。", "en": "Strength fades, making steps wobbly."},
        {"zh": "伤口流出黑色粘液。", "en": "Black ooze oozes from wounds."},
        {"zh": "虚弱地喘息，每吸一口都痛苦。", "en": "Weakly gasping, each breath hurts."},
        {"zh": "肌肉开始腐烂，变得松软。", "en": "Muscle rots, becoming soft."},
        {"zh": "骨头被腐蚀，皮肤紧绷。", "en": "Bones are corroded, skin taut."},
        {"zh": "生命之光在暗淡。", "en": "Life’s glow dims."},
        {"zh": "灵魂之火即将熄灭。", "en": "The soul’s flame flickers out."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的光吸引着我。", "en": "The light on you calls to me."},
        {"zh": "为何不一起吃点东西？", "en": "Why not share some food?"},
        {"zh": "别靠近我，这很危险。", "en": "Stay back, it's dangerous."},
        {"zh": "你身上的食物诱惑着我。", "en": "The food on you tempts me."},
        {"zh": "这里有很多美味。", "en": "There's plenty of tasty stuff here."},
        {"zh": "我会保护你免受其它威胁。", "en": "I'll protect you from others."},
        {"zh": "你的食物能提供能量。", "en": "Your food gives energy."},
        {"zh": "跟我走，我可以教你。", "en": "Follow me, I can teach you."},
        {"zh": "秘界的野地上，我一路走一路找。", "en": "Across the Arcana wilds I roam and hunt."},
        {"zh": "你的光芒让我着迷。", "en": "Your light fascinates me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕开你，不回头看。", "en": "I go around you without looking back."},
        {"zh": "我要解决你。", "en": "I need to take you out."},
        {"zh": "你撞上我，我换了个方向。", "en": "You hit me and I veer off."},
        {"zh": "秘界的路，我先走。", "en": "I take the Apalachia path first."},
        {"zh": "我要绕过你。", "en": "I'll go around you."},
        {"zh": "你站在我散步的路上了。", "en": "You're standing on my walking path."},
        {"zh": "避开我！", "en": "Avoid me!"},
        {"zh": "秘界的雾，被你踩散了。", "en": "You scattered the mist of the Arcana."},
        {"zh": "我要绕开你。", "en": "I'll go around you."},
        {"zh": "你站在我正要走的路上。", "en": "You're standing in the path I need."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "找到一个伴侣很重要。", "en": "Finding a mate is important."},
        {"zh": "我在风里找同类的气味。", "en": "I search the wind for my kind's scent."},
        {"zh": "寻找一个伴侣。", "en": "Find a partner."},
        {"zh": "我正在寻找配偶。", "en": "I'm looking for a mate."},
        {"zh": "我沿着河岸来回走。", "en": "I pace back and forth along the bank."},
        {"zh": "远处有回应我的叫声。", "en": "A call answers mine from far off."},
        {"zh": "我需要一个伴侣来繁殖。", "en": "I need a mate to breed."},
        {"zh": "寻找一个伴侣来繁殖。", "en": "Find a mate to breed."},
        {"zh": "我正在寻找伴侣。", "en": "I'm searching for a partner."},
        {"zh": "秘界太静，找个同伴吧。", "en": "This realm is too quiet. I'll find a companion."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "听到你走近，我不介意分享我的食物。", "en": "Feast on what I've found, it's yours now."},
        {"zh": "你看，这是我的午餐。", "en": "Here, a snack for you."},
        {"zh": "我在这边找到了一些不错的。", "en": "Some good stuff over here."},
        {"zh": "分享我的食物吧，这样我们都可以生存下去。", "en": "Share my food, we'll both survive."},
        {"zh": "我找到了一些，你想要吗？", "en": "Found something, want it?"},
        {"zh": "这果子酸得刚好。", "en": "This fruit is just sour enough."},
        {"zh": "你看起来很饿，这是我刚找到的。", "en": "You look hungry, here's what I found."},
        {"zh": "来吧，这是你的奖励。", "en": "Here, your reward."},
        {"zh": "你也可以吃吃看。", "en": "You can try it too."},
        {"zh": "如果你帮我找到宝藏，我可以给你吃。", "en": "Food if you help me find the treasure."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我要看看你是否有用。", "en": "Let's see if you're worth it."},
        {"zh": "你看起来像只猎物。", "en": "Looks like prey."},
        {"zh": "我会记住你，你会需要帮助。", "en": "I'll remember you, you'll need help."},
        {"zh": "我会找到你的，别走。", "en": "I'll find you, don't run."},
        {"zh": "我已经盯上你了，准备好了吗？", "en": "I've got my eye on you, ready?"},
        {"zh": "你在这里待得太久了。", "en": "You've stayed too long."},
        {"zh": "你逃不掉的，我已经看穿了你。", "en": "You can't escape, I've seen through you."},
        {"zh": "我要把你看个透。", "en": "I'll see you through."},
        {"zh": "你最好小心点。", "en": "Be careful."},
        {"zh": "我会让你付出代价。", "en": "You'll pay the price."},
        {"zh": "你身上的结晶味太浓。", "en": "You reek of collector fragments."},
        {"zh": "秘界的风告诉我你在哪。", "en": "The realm's wind tells me where you are."},
        {"zh": "你闯进我的猎场了。", "en": "You've wandered into my hunting ground."},
        {"zh": "从暗处记下你的脚印。", "en": "I note your footprints from the dark."},
        {"zh": "先看看你带了什么。", "en": "Let me see what you carry first."},
        {"zh": "别急着跑，我看得见。", "en": "Don't rush off. I can see you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "准备好了，我要行动了。", "en": "Ready, I'm in action."},
        {"zh": "我已经瞄准了，看好了。", "en": "I'm on target, watch out."},
        {"zh": "我已经瞄准了，别动。", "en": "Target locked, don't move."},
        {"zh": "我来收拾你了。", "en": "Time to deal with you."},
        {"zh": "我要打倒你。", "en": "I'll defeat you."},
        {"zh": "我这里一拳能打穿甲。", "en": "One punch here goes through armor."},
        {"zh": "瞄准了，小心。", "en": "Targeted, be careful."},
        {"zh": "小心，我已经瞄准了。", "en": "Beware, I'm targeting you."},
        {"zh": "我要让你知道痛苦。", "en": "You'll know pain."},
        {"zh": "我已经瞄准了，准备攻击。", "en": "Target locked, preparing to attack."},
        {"zh": "爪子扣进秘界的黑岩。", "en": "My claws dig into the dark rock."},
        {"zh": "等你转身的那一下。", "en": "I wait for the moment you turn."},
        {"zh": "你的心跳透过地面传来。", "en": "Your heartbeat comes up through the ground."},
        {"zh": "距离刚好，够我一扑。", "en": "Distance is perfect for one lunge."},
        {"zh": "你看不见我贴地爬行。", "en": "You can't see me crawling low."},
        {"zh": "秘界的路我熟，你跑不出去。", "en": "I know the Arcana roads. You will not get out."},
        {"zh": "呼吸放慢，只等出手。", "en": "Breath slowed, waiting to strike."},
        {"zh": "再一步就进了范围。", "en": "One more step and you're in range."},
        {"zh": "喉咙里压着一声低吼。", "en": "A growl sits low in my throat."},
        {"zh": "我选定你的后颈了。", "en": "I've chosen the back of your neck."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，张开獠牙！", "en": "Sssss, teeth bared!"},
        {"zh": "狂奔而来，别挡道！", "en": "Rushing in, don't block!"},
        {"zh": "铁蹄践踏，无处可逃！", "en": "Steel hooves trample, nowhere to run!"},
        {"zh": "利爪划破空气！", "en": "Claws slice through the air!"},
        {"zh": "怒吼震天，你难逃一死！", "en": "Roaring, you die here!"},
        {"zh": "咆哮着冲向猎物！", "en": "Roaring, charging at you!"},
        {"zh": "漆黑之爪，致命一击！", "en": "Black claws, fatal strike!"},
        {"zh": "狂风一般，扑向目标！", "en": "Like a gale,扑向目标！"},
        {"zh": "疯狂撕咬，无尽杀意！", "en": "Raging bite, endless rage!"},
        {"zh": "獠牙深入，痛彻心扉！", "en": "Teeth deep, excruciating pain!"},
        {"zh": "爪子从侧腹掏过来。", "en": "My claws hook in from your flank."},
        {"zh": "一口咬在护甲缝上。", "en": "I bite into a gap in your armor."},
        {"zh": "我把你撞向黑岩。", "en": "I slam you toward the dark rock."},
        {"zh": "这一下够你断两根骨。", "en": "That blow should crack two of your bones."},
        {"zh": "秘界的尘土塞满你喉咙。", "en": "This realm's dust fills your throat."},
        {"zh": "重量压下来，别想翻身。", "en": "My weight pins you down. Don't bother."},
        {"zh": "牙齿卡进你的肩头。", "en": "My teeth lodge in your shoulder."},
        {"zh": "尾巴扫得你站不稳。", "en": "My tail sweeps your feet out."},
        {"zh": "利爪先落地，后落在你身上。", "en": "My claws land first, then you."},
        {"zh": "最后一下，用整个身体。", "en": "The last blow uses my whole body."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗中悄然现身。", "en": "Appears silently in the dark."},
        {"zh": "从秘界中走出。", "en": "Walks from the Nether."},
        {"zh": "在岩浆池旁徘徊。", "en": "Roams by lava pools."},
        {"zh": "寻找猎物，永不满足。", "en": "Hunts, never satisfied."},
        {"zh": "夜幕降临，更加凶猛。", "en": "More fierce at nightfall."},
        {"zh": "阴影中窥伺着猎物。", "en": "Hunts from the shadows."},
        {"zh": "独行，永不结伴。", "en": "Travels alone, never in pairs."},
        {"zh": "饥肠辘辘，随时袭击。", "en": "Always hungry, attacks anytime."},
        {"zh": "秘界中的不速之客。", "en": "Unwelcome guest of the Nether."},
        {"zh": "在黑暗中等待时机。", "en": "Waits in darkness for prey."},
        {"zh": "秘界的裂隙里爬出我。", "en": "I crawl out of a rift in this realm."},
        {"zh": "岩石背后，我睁开眼。", "en": "Behind the rock, I open my eyes."}
      ]
    },
