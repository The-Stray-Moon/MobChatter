      "lines": [
        {"zh": "被箭矢贯穿。", "en": "Pierced by an arrow."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法力量撕裂我的身体。", "en": "Magic tears my flesh."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的肚子空得发响。", "en": "My empty belly is rumbling."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "被闪电撕裂。", "en": "Torn apart by lightning."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "消失在无尽黑暗中。", "en": "Vanish into endless darkness."}
      ]
    }
  }
