{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀轻拍，飘过树梢。", "en": "Flap wings, drift over treetops."},
        {"zh": "夜幕低垂，悄然飞行。", "en": "Night falls, silent flight."},
        {"zh": "丛林中穿梭，觅食不停。", "en": "Pore through the jungle, never idle."},
        {"zh": "避开火把，阴影滑行。", "en": "Avoid the torch, shadow glide."},
        {"zh": "黑暗中寻找，觅食蝙蝠。", "en": "In darkness, hunt for prey."},
        {"zh": "回巢休憩，夜色如梦。", "en": "Rest in nest, night a dream."},
        {"zh": "翅膀挥动，穿梭丛林。", "en": "Wings flap, through jungle."},
        {"zh": "漆黑中觅食，蝙蝠的踪迹。", "en": "Feast in darkness, bat's trail."},
        {"zh": "在树洞间飞行，自由翱翔。", "en": "Fly between tree holes, free."},
        {"zh": "避开光亮，继续飞行。", "en": "Away from light, fly on."},
        {"zh": "我贴着藤蔓滑过去，悄无声息。", "en": "I slip past the vines without a sound."},
        {"zh": "翅膀擦过芭蕉叶，叶面一颤。", "en": "My wing brushes a banana leaf and it shivers."},
        {"zh": "树冠间有条缝，我正好钻过去。", "en": "There is a gap in the canopy, and I fit through."},
        {"zh": "我绕开火把，往更暗的地方飞。", "en": "I skirt the torches toward the darker air."},
        {"zh": "藤蔓的阴影里，我改了方向。", "en": "In the vine shadows I change course."},
        {"zh": "潮湿的空气托着我往前。", "en": "The damp air carries me forward."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "悬停枝头，静静守候。", "en": "Hanging, silent vigil."},
        {"zh": "栖息树洞，等待时机。", "en": "Nest in tree, wait."},
        {"zh": "在暗处静候，伺机而动。", "en": "In darkness, wait."},
        {"zh": "翅膀不动，悄然栖息。", "en": "Wings still, silent rest."},
        {"zh": "静候猎物，蝙蝠耐心。", "en": "Wait for prey, patient bat."},
        {"zh": "翅膀收拢，静待夜幕。", "en": "Fold wings, await night."},
        {"zh": "丛林深处，静静守候。", "en": "In jungle, silent wait."},
        {"zh": "静止不动，蝙蝠的沉寂。", "en": "Still, bat's silence."},
        {"zh": "在暗处静息，等待机会。", "en": "In darkness, wait."},
        {"zh": "悬停枝头，蝙蝠的静默。", "en": "Hanging, bat's stillness."},
        {"zh": "我挂在藤上，耳朵还在转。", "en": "I hang from a vine, ears still turning."},
        {"zh": "丛林太热，我张开翅膀散热。", "en": "The jungle is hot; I spread my wings to cool."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "注意你了，玩家。", "en": "Noticing you, player."},
        {"zh": "盯上你了，小心蝙蝠。", "en": "On you, watch out."},
        {"zh": "你在这，蝙蝠来了。", "en": "Here you are, bat coming."},
        {"zh": "盯紧你了，玩家小心。", "en": "On you, player, watch out."},
        {"zh": "发现了你，蝙蝠来袭。", "en": "Found you, bat coming."},
        {"zh": "盯着你看，蝙蝠来了。", "en": "Staring at you, bat coming."},
        {"zh": "注意到了你，蝙蝠来袭。", "en": "Noticed you, bat coming."},
        {"zh": "盯上你了，玩家小心。", "en": "On you, player, watch out."},
        {"zh": "盯紧你了，小心蝙蝠。", "en": "On you, watch out."},
        {"zh": "你手里的丛林碎片，是我的。", "en": "The jungle shard in your hand is mine."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "薄翼被拍破，我要掉下来。", "en": "My thin wing is torn, I'm falling."},
        {"zh": "抓不到我！", "en": "Can't catch me!"},
        {"zh": "你打不到我！", "en": "Can't hit me!"},
        {"zh": "我飞得很快！", "en": "I fly fast!"},
        {"zh": "快抓住我！", "en": "Catch me!"},
        {"zh": "森林太大了！", "en": "Forest too big!"},
        {"zh": "找不到出路！", "en": "No way out!"},
        {"zh": "别打我的薄翼，很疼！", "en": "Don't hit my thin wings, it hurts!"},
        {"zh": "丛林太密，我撞上藤了。", "en": "The jungle is too thick; I hit a vine."},
        {"zh": "耳朵被震得嗡嗡响。", "en": "My ears are ringing from the blow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "诱人美食就在下方！", "en": "Delicious food below!"},
        {"zh": "黑暗中我觅食！", "en": "I hunt in the dark!"},
        {"zh": "跟紧我，有美味！", "en": "Follow me, there’s prey!"},
        {"zh": "森林深处藏美味！", "en": "There's food deep in the forest!"},
        {"zh": "尝尝我的蝙蝠唾液！", "en": "Feel the bat saliva!"},
        {"zh": "夜晚才是我的盛宴！", "en": "The night is my feast!"},
        {"zh": "丛林间飘荡的美味！", "en": "Tasty in the jungle air!"},
        {"zh": "你闻到蝙蝠肉香了吗？", "en": "Can you smell the bat meat?"},
        {"zh": "跟蝙蝠一起享受猎食！", "en": "Join the bat in hunting!"},
        {"zh": "丛林的夜，蝙蝠的舞！", "en": "Jungle night, bat dance!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "避开我，否则你会受伤！", "en": "Steer clear or you'll get hurt!"},
        {"zh": "别撞我，我正找猎物！", "en": "Watch out, I'm hunting!"},
        {"zh": "撞上我，你就要找医生了！", "en": "Collision means medical help!"},
        {"zh": "飞行中的危险，避开我！", "en": "Avoid me in the air!"},
        {"zh": "小心，我的翅膀锋利如刃！", "en": "Beware, my wings are sharp!"},
        {"zh": "别挡我路，我要找洞穴！", "en": "Move, I'm heading to a cave!"},
        {"zh": "森林间的飞行竞争！", "en": "Flight competition in the forest!"},
        {"zh": "避开我，否则后果自负！", "en": "Stay clear or face the consequences!"},
        {"zh": "我的蝙蝠翅膀，你要小心！", "en": "My bat wings, be careful!"},
        {"zh": "避开我，否则我会攻击！", "en": "Stay clear or I'll attack!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "藤蔓间回荡着我的求偶声。", "en": "My mating call echoes through the vines."},
        {"zh": "丛林中寻找真爱！", "en": "Love in the jungle!"},
        {"zh": "蝙蝠之爱，飞翔中！", "en": "Bat love, in flight!"},
        {"zh": "我的爱侣，快点出现！", "en": "My love, come out!"},
        {"zh": "丛林之恋，蝙蝠之爱！", "en": "Jungle love, bat love!"},
        {"zh": "与蝙蝠共舞，寻找真爱！", "en": "Dance with bats, find true love!"},
        {"zh": "用回声在丛林找伴侣。", "en": "I search the jungle for a mate by echo."},
        {"zh": "蝙蝠的求偶飞行！", "en": "Bat mating flight!"},
        {"zh": "寻找我的飞行伴侣！", "en": "Find my flying mate!"},
        {"zh": "丛林中，蝙蝠求偶！", "en": "Bat mating in the jungle!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我被你发现了，快点吃掉吧！", "en": "Got you! Time to be eaten!"},
        {"zh": "丛林的夜晚属于我，吃掉你！", "en": "It's bat night in the jungle, eat you up!"},
        {"zh": "找到食物了，享用我的馈赠吧！", "en": "Found some food. Enjoy my offering."},
        {"zh": "丛林蝙蝠的礼物，接受吧！", "en": "Jungle bat's gift, accept it!"},
        {"zh": "食物来了，享受这顿美餐！", "en": "Food's here, enjoy this meal!"},
        {"zh": "我来补充能量了，尝尝我的味道吧！", "en": "Time to replenish, taste my flesh!"},
        {"zh": "丛林的夜晚，蝙蝠的馈赠！", "en": "Night in the jungle, bat's gift!"},
        {"zh": "享受丛林的夜之美味吧！", "en": "Enjoy the night's jungle delicacy!"},
        {"zh": "丛林蝙蝠的礼物，不容拒绝！", "en": "Jungle bat's gift, can't refuse!"},
        {"zh": "享受我的存在，蝙蝠之夜！", "en": "Enjoy my presence, bat night!"}
      ]
    },
