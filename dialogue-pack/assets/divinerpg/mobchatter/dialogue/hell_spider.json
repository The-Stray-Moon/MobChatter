    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，蛛网在脚下绷紧。", "en": "Sssss, web taut underfoot."},
        {"zh": "火焰围绕着我的身体燃烧。", "en": "Flames wrap around my body."},
        {"zh": "在熔岩中行走，感觉很舒服。", "en": "Walking through lava feels nice."},
        {"zh": "我的八只眼睛注视着前方。", "en": "Eight eyes gaze forward."},
        {"zh": "火焰从我身上散发出来。", "en": "Flames emanate from my body."},
        {"zh": "岩浆中闪烁着我的身影。", "en": "Shadow flickers in lava."},
        {"zh": "我从熔岩中缓缓爬行。", "en": "Slowly crawl from lava."},
        {"zh": "炙热的气息从我口中呼出。", "en": "Hot breath from my mouth."},
        {"zh": "在炽热的石堆中穿梭。", "en": "Navigate through hot stone pile."},
        {"zh": "八条腿抓着墙往上爬。", "en": "Eight legs grip the wall and climb."},
        {"zh": "每走一步，熔岩滴下一滴。", "en": "Each step drips a bead of lava."},
        {"zh": "丝黏在岩壁上，泛着红光。", "en": "A red-glowing thread sticks to the wall."},
        {"zh": "我从熔岩池边绕过去。", "en": "I skirt the edge of the lava pool."},
        {"zh": "腹下的囊微微发光。", "en": "The sac under my belly glows faintly."},
        {"zh": "脚印在石头上烧出小坑。", "en": "My tracks burn small pits in the stone."},
        {"zh": "倒挂在穹顶，慢慢移动。", "en": "I hang from the ceiling and creep."}
      ]
    },
