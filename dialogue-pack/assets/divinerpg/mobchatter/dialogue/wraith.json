{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "飘荡在夜幕之下，幽灵般前行。", "en": "Drift under the night, a wraith moves."},
        {"zh": "无声的步履，如幽魂游荡。", "en": "Silent steps, like a wraith wanders."},
        {"zh": "漫无目的地飘浮，寻找目标。", "en": "Drift aimlessly, seeking a target."},
        {"zh": "夜风中，幽灵的身躯飘渺。", "en": "In the night wind, the wraith's form is ethereal."},
        {"zh": "在黑暗中，静静飘游。", "en": "In the darkness, silently drift."},
        {"zh": "穿过阴影，飘向未知。", "en": "Through shadows, drift into the unknown."},
        {"zh": "孤独的幽灵，无处安身。", "en": "A lonely wraith, with nowhere to rest."},
        {"zh": "在月光下，游荡的灵魂。", "en": "In moonlight, a wandering soul."},
        {"zh": "夜幕中的飘渺身影。", "en": "A misty form in the night."},
        {"zh": "幽灵的游荡，无尽的旅程。", "en": "A wraith's drift, an endless journey."},
        {"zh": "袍角没有声响，我往前飘。", "en": "My robe hem makes no sound as I drift forward."},
        {"zh": "我掠过草地，草不弯。", "en": "I skim the grass and it does not bend."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静悬浮，等待猎物。", "en": "Float quietly, waiting for prey."},
        {"zh": "幽灵的注视，无声无息。", "en": "A wraith's gaze, silent and unseen."},
        {"zh": "静止不动，悄然观察。", "en": "Steady and silent, observing."},
        {"zh": "飘荡在空中，静待时机。", "en": "Drifting in the air, waiting for an opportunity."},
        {"zh": "悬浮半空，无言以对。", "en": "Hovering in mid-air, speechless."},
        {"zh": "幽灵的注视，无声的期待。", "en": "A wraith's gaze, unspoken hope."},
        {"zh": "飘忽不定，静候时机。", "en": "Drifting, waiting for the right moment."},
        {"zh": "幽灵的游荡，静默无言。", "en": "A wraith's drift, silent and still."},
        {"zh": "飘浮着，等待着。", "en": "Drifting, waiting."},
        {"zh": "幽灵的注视，静默无言。", "en": "A wraith's gaze, silent and still."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "感受到玩家，缓缓靠近。", "en": "Feeling the player, slowly approaching."},
        {"zh": "看见玩家，幽灵逼近。", "en": "Seeing the player, the wraith closes in."},
        {"zh": "锁定玩家，缓缓移动。", "en": "Locking onto the player, slowly moving."},
        {"zh": "感知玩家，缓缓移动。", "en": "Perceiving the player, slowly moving."},
        {"zh": "锁定目标，幽灵逼近。", "en": "Locking onto the target, the wraith closes in."},
        {"zh": "看见玩家，幽灵悄然接近。", "en": "Seeing the player, the wraith silently approaches."},
        {"zh": "感知玩家，缓缓靠近。", "en": "Perceiving the player, slowly approaching."},
        {"zh": "锁定玩家，幽灵悄然接近。", "en": "Locking onto the player, the wraith silently approaches."},
        {"zh": "我转过没有脸的头。", "en": "I turn my faceless head."},
        {"zh": "我的视线穿过你，落在后面。", "en": "My gaze passes through you to what lies behind."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "飘忽的影子摇曳不定", "en": "Flickering shadows dance"},
        {"zh": "鬼魂轻盈地挣扎", "en": "Spectral form struggles"},
        {"zh": "幽灵之翼渐显脆弱", "en": "Ghostly wings show weakness"},
        {"zh": "惨淡的光芒逐渐暗淡", "en": "Dim light fades away"},
        {"zh": "幽灵之魂颤抖不止", "en": "Shuddering ghostly soul"},
        {"zh": "虚无的形态开始消散", "en": "Fading spectral form"},
        {"zh": "飘渺的灵魂在颤抖", "en": "Trembling ghostly spirit"},
        {"zh": "透明的身躯慢慢黯淡", "en": "Translucent form dims"},
        {"zh": "无形的身躯开始摇曳", "en": "Form trembles"},
        {"zh": "残破的幽灵飘摇不定", "en": "Tattered ghost flutters"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我感受到你的气息，凡人.", "en": "I feel your presence, mortal."},
        {"zh": "靠近我，你会得到更多.", "en": "Come closer, you'll get more."},
        {"zh": "别想欺骗我.", "en": "Don't try to deceive me."},
        {"zh": "我的长剑渴望你的灵魂.", "en": "My sword craves your soul."},
        {"zh": "你身上有幽灵的气息.", "en": "You smell of a ghost."},
        {"zh": "你为何不被我吸引？", "en": "Why aren't you drawn to me?"},
        {"zh": "你对我有什么价值？", "en": "What use are you to me?"},
        {"zh": "灵魂，归我所有.", "en": "Soul, mine by right."},
        {"zh": "不要抵抗，徒劳无功.", "en": "Resistance is futile."},
        {"zh": "你的恐惧，我的养分.", "en": "Your fear, my sustenance."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡了我的路.", "en": "You're in my way."},
        {"zh": "让开，否则你会后悔.", "en": "Move, or you'll regret it."},
        {"zh": "不要打扰我的旅程.", "en": "Don't disturb my journey."},
        {"zh": "我的存在不容侵犯.", "en": "My presence is not to be trespassed."},
        {"zh": "我们之间的距离太近了.", "en": "We are too close."},
        {"zh": "退后，否则你会受伤.", "en": "Step back, or you'll be hurt."},
        {"zh": "别想靠近我.", "en": "Don't try to get closer."},
        {"zh": "我的空间你不要碰.", "en": "Stay out of my space."},
        {"zh": "你挡住了我的视线.", "en": "You're blocking my view."},
        {"zh": "离开这里，否则你会死.", "en": "Leave or you'll die."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你的存在让我感到愉悦.", "en": "Your presence pleases me."},
        {"zh": "和我在一起，你会更快乐.", "en": "Be with me, and you'll be happier."},
        {"zh": "你是最适合我的伴侣.", "en": "You are the perfect mate for me."},
        {"zh": "与我结合，让灵魂永恒.", "en": "Unite with me, make our souls eternal."},
        {"zh": "我们共同走过这片土地.", "en": "We will walk this land together."},
        {"zh": "与我共生，你的灵魂将永存.", "en": "Be with me, and your soul will live on."},
        {"zh": "你的爱让我更强大.", "en": "Your love makes me stronger."},
        {"zh": "让我们一起，永不分离.", "en": "Let us be together, forever apart."},
        {"zh": "你让我看到了希望.", "en": "You gave me hope."},
        {"zh": "我的伴侣，我的永恒.", "en": "My mate, my eternal companion."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "幽灵克星赐予我力量！", "en": "Phantom Guardian bestows power!"},
        {"zh": "这具肉体不再适合我。", "en": "This flesh is no longer fit."},
        {"zh": "幽光闪烁，灵魂复苏！", "en": "Phosphorescent glow, soul awakens."},
        {"zh": "我将寻找新的猎物。", "en": "I seek new prey."},
        {"zh": "我是夜之使徒。", "en": "Night’s prophet."},
        {"zh": "灵魂的低语，我听见了。", "en": "Soul’s whisper, I hear."},
        {"zh": "这世界已不再适合我。", "en": "This world no longer suits me."},
        {"zh": "黑夜是我的归宿。", "en": "Night is my home."},
        {"zh": "无尽的黑暗，我来自那里。", "en": "Endless darkness, I came from there."},
        {"zh": "幽灵克星指引我前行。", "en": "Phantom Guardian guides me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "它似乎是个好目标。", "en": "A good target."},
        {"zh": "我的猎物，就在这儿。", "en": "My prey, here."},
        {"zh": "我浮起来，影子先扑过去。", "en": "I rise; my shadow lunges first."},
        {"zh": "它不会察觉到我。", "en": "It won’t notice me."},
        {"zh": "我的影子在你身后。", "en": "My shadow’s behind you."},
        {"zh": "它在梦中。", "en": "It’s in a dream."},
        {"zh": "猎物的味道很香。", "en": "Prey smells good."},
        {"zh": "我已经锁定目标。", "en": "Target locked."},
        {"zh": "猎物就在你周围。", "en": "Prey around you."},
        {"zh": "它很快就会发现我。", "en": "It’ll soon notice me."},
        {"zh": "幽灵克星造了我，也为它杀人。", "en": "The ghostbane made me, and for it I kill."},
        {"zh": "你的灵魂有裂缝，我闻得到。", "en": "Your soul has cracks; I can smell them."},
        {"zh": "活人的热气，真刺眼。", "en": "Living warmth is so glaring."},
        {"zh": "我选中你，不需要理由。", "en": "I picked you, no reason needed."},
        {"zh": "幽灵克星造了我，我来了。", "en": "The ghostbane made me, and here I am."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的灵魂将吞噬你。", "en": "My soul will consume you."},
        {"zh": "我连掉落都不留，只留恐惧。", "en": "I leave no loot, only fear."},
        {"zh": "灵魂之箭即将射出。", "en": "Soul arrow about to fire."},
        {"zh": "它会痛苦地死去。", "en": "It’ll die in pain."},
        {"zh": "猎物被吸干了。", "en": "Prey drained."},
        {"zh": "灵魂被夺走了。", "en": "Soul stolen."},
        {"zh": "痛苦将降临。", "en": "Pain descends."},
        {"zh": "灵魂将永世受苦。", "en": "Soul tormented forever."},
        {"zh": "它的生命即将结束。", "en": "Its life ends now."},
        {"zh": "灵魂之火将熄灭。", "en": "Soul’s flame extinguished."},
        {"zh": "我浮在你上方，一寸寸压低。", "en": "I hover above you, sinking inch by inch."},
        {"zh": "你转身，我的袍子还在原地。", "en": "You turn and my robe is still there."},
        {"zh": "我不踩地，所以你没听见。", "en": "I never touch the ground, so you heard nothing."},
        {"zh": "幽灵克星把我放了出来。", "en": "The ghostbane set me loose."},
        {"zh": "你的火把照不穿我。", "en": "Your torch cannot pierce me."},
        {"zh": "我伸手，指尖已经在你颈后。", "en": "I reach, and my fingertips are already at your nape."},
        {"zh": "你看不见我，但颈后发凉。", "en": "You can't see me, but your neck grows cold."},
        {"zh": "我等你把呼吸放慢。", "en": "I wait for your breathing to slow."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "挥舞着磷光的双臂！", "en": "Waving luminous arms!"},
        {"zh": "尖叫着向你袭来！", "en": "Screaming at you!"},
        {"zh": "吞噬你的灵魂吧！", "en": "Devour your soul!"},
        {"zh": "我吹一口气，你的灯就灭了。", "en": "I blow once, and your lamp goes out."},
        {"zh": "冰冷的手指紧握！", "en": "Cold fingers clutch!"},
        {"zh": "磷光的手已经穿过你的背。", "en": "My phosphorescent hand is already through your back."},
        {"zh": "幽灵克星放我出来的。", "en": "The ghost buster let me out."},
        {"zh": "黑暗中你无处藏身！", "en": "You have no hiding place in the dark!"},
        {"zh": "你的死亡近在咫尺！", "en": "Your death is near!"},
        {"zh": "我穿过你，带走一点体温。", "en": "I pass through you and take some warmth."},
        {"zh": "指尖一触，你打了个寒战。", "en": "One touch of my fingers and you shiver."},
        {"zh": "你在我的袍子里挣了一下。", "en": "You struggle once inside my robe."},
        {"zh": "这一抓不留伤口，只留空。", "en": "This grasp leaves no wound, only a hollow."},
        {"zh": "我抱住你，慢慢变冷。", "en": "I hold you and slowly turn cold."},
        {"zh": "你听见的哭声，是我的。", "en": "That sobbing you hear is mine."},
        {"zh": "我把你的影子扯了一下。", "en": "I give your shadow a tug."}
      ]
    },
