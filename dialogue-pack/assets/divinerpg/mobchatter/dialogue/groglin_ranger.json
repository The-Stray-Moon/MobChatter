    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "吱吱吱，林中怪声.", "en": "Squeak, in the woods."},
        {"zh": "影子在游动，暗影中的游侠.", "en": "Shadows move, ranger of the dark."},
        {"zh": "黑暗中寻找，寻找黑暗.", "en": "Seek in darkness, seek the dark."},
        {"zh": "树叶沙沙，地精游侠行.", "en": "Leaves rustle, groglin ranger passes."},
        {"zh": "夜幕下，悄悄前行.", "en": "Under the night, move quietly."},
        {"zh": "夜风中，飘荡地精之歌.", "en": "Night wind, carries goblin song."},
        {"zh": "月光下，阴影中的猎人.", "en": "Moonlight, shadowed hunter."},
        {"zh": "游荡于黑暗，无声无息.", "en": "Wanders in darkness, silent."},
        {"zh": "黑暗中窥视，伺机而动.", "en": "Stalks in darkness, waits."},
        {"zh": "林间巡逻，警惕四伏.", "en": "Patrols the woods, danger lurks."},
        {"zh": "弓弦轻响，脚步不停.", "en": "Bowstring whispers, steps never stop."},
        {"zh": "树根绊不住我，我很熟路.", "en": "Roots don't trip me—I know this path."}
      ]
    },
    "idle": {
