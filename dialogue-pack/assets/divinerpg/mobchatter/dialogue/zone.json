  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "箭矢呼啸过空间。", "en": "Arrows whiz through space."},
        {"zh": "我的射程无远弗届。", "en": "My range is limitless."},
        {"zh": "梦魇之地，我的领地。", "en": "Nightmare realm, my domain."},
        {"zh": "空间中穿梭，精准无比。", "en": "Piercing through space with precision."},
        {"zh": "黑暗中寻找猎物。", "en": "Hunting in the dark."},
        {"zh": "射出一箭，寻找目标。", "en": "Release an arrow, seek a target."},
        {"zh": "空间扭曲，箭矢穿梭。", "en": "Space warps, arrows traverse."},
        {"zh": "箭矢如流星划破天际。", "en": "Arrows like meteors streak across the sky."},
        {"zh": "追逐猎物，不留余地。", "en": "Chase prey, leave none behind."},
        {"zh": "空间的猎手，永恒的追逐。", "en": "Hunter of space, eternal pursuit."},
        {"zh": "第四层里响起弓弦", "en": "A bowstring sounds on the fourth floor."},
        {"zh": "我绕着你走了一圈", "en": "I circle once around you."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这里等待着。", "en": "I wait here."},
        {"zh": "静谧中，猎机已张。", "en": "Silence, the hunt is on."},
        {"zh": "空间的守护者，永恒静默。", "en": "Guardian of space, eternal silence."},
        {"zh": "耐心，是猎人的美德。", "en": "Patience, a hunter's virtue."},
        {"zh": "等待，直到猎物出现。", "en": "Wait until the prey appears."},
        {"zh": "空间中，我静候。", "en": "In space, I wait."},
        {"zh": "静观其变，静待猎物。", "en": "Watch, waiting for the prey."},
        {"zh": "猎物，就在不远处。", "en": "Prey, just beyond."},
        {"zh": "空间的狩猎者，寂静无声。", "en": "Silent hunter of space."},
        {"zh": "耐心等待，猎物自现。", "en": "Patiently wait, the prey will come."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物进入视野，我的箭向四面八方飞。", "en": "Prey in view, and my arrows fly in every direction."},
        {"zh": "追踪你的气味。", "en": "Tracking your scent."},
        {"zh": "空间中，你无处可逃。", "en": "In space, nowhere to hide."},
        {"zh": "瞄准，然后射出。", "en": "Aim and shoot."},
        {"zh": "空间射手，永不停歇。", "en": "Zone shooter, unrelenting."},
        {"zh": "你的存在，激起了我的怒火。", "en": "Your presence, my rage."},
        {"zh": "瞄准，射出致命一击。", "en": "Target, one lethal shot."},
        {"zh": "空间中，我的箭矢无情。", "en": "In space, my arrows are merciless."},
        {"zh": "空间射手，追踪猎物。", "en": "Zone shooter, tracking prey."},
        {"zh": "空间的猎杀者，永无止境。", "en": "Hunter of space, endless."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身体发出火花，痛苦不堪。", "en": "Sparks fly from your body in agony."},
        {"zh": "你被箭矢贯穿，血流如注。", "en": "You are pierced by arrows, bleeding profusely."},
        {"zh": "空间扭曲，你感到不适。", "en": "The space warps, causing you discomfort."},
        {"zh": "一阵剧痛，你难以忍受。", "en": "Severe pain wracks your body."},
        {"zh": "你被友方魔法灼伤，剧痛难忍。", "en": "You are burned by a friendly spell."},
        {"zh": "箭矢射穿你，疼痛难当。", "en": "You are shot through with arrows."},
        {"zh": "饥饿令你虚弱无力。", "en": "Hunger leaves you weak."},
        {"zh": "雷电击中你，你摇摇欲坠。", "en": "Lightning strikes you, causing you to stagger."},
