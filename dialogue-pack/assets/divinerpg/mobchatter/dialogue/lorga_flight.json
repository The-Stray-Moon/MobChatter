{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的分身从背后长出来。", "en": "A double grows out behind me."},
        {"zh": "翅膀拍打着空气", "en": "Flaps wings"},
        {"zh": "飘向远处的光源", "en": "Floats towards light source"},
        {"zh": "在空中优雅地滑行", "en": "Slides gracefully in air"},
        {"zh": "观察周围的环境", "en": "Scans surroundings"},
        {"zh": "我掠过时，石壁泛着微光。", "en": "Where I pass, the stone walls glimmer."},
        {"zh": "环绕玩家飞翔", "en": "Circling the player"},
        {"zh": "突然改变飞行方向", "en": "Changes flight path"},
        {"zh": "用翅膀遮挡视线", "en": "Blocks vision with wings"},
        {"zh": "快速掠过地面", "en": "Swoops low"},
        {"zh": "翅膀切着梦魇世界的冷气。", "en": "My wings slice the nightmare world's cold air."},
        {"zh": "又一个我从身后浮出来。", "en": "Another me rises behind this one."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静地悬停在空中", "en": "Hovers quietly"},
        {"zh": "享受宁静的时刻", "en": "Enjoys peace"},
        {"zh": "我呼吸很轻，翼膜在颤。", "en": "My breathing is faint; the membranes quiver."},
        {"zh": "偶尔发出响亮的叫声", "en": "Occasionally buzzes loudly"},
        {"zh": "轻微地颤抖翅膀", "en": "Shakes wings slightly"},
        {"zh": "用爪子轻触地面", "en": "Taps ground with claws"},
        {"zh": "第三层的雾里，有东西在动。", "en": "Something moves in the third-layer fog."},
        {"zh": "慢慢地变化形态", "en": "Slowly shifts form"},
        {"zh": "感受夜晚的凉意", "en": "Feels cool night"},
        {"zh": "静静地沉思", "en": "Thoughtfully silent"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "盯住玩家", "en": "Locks on player"},
        {"zh": "紧张地注视玩家", "en": "Nervously eyeing player"},
        {"zh": "追踪玩家的身影", "en": "Traces player's movements"},
        {"zh": "我悬在半空，盯着你的手。", "en": "I hover and watch your hands."},
        {"zh": "你走到哪，我的影子跟到哪。", "en": "Wherever you walk, my shadow follows."},
        {"zh": "我的复制体替我盯着你。", "en": "My clone keeps its eyes on you for me."},
        {"zh": "我的翅膀停住，只对着你。", "en": "My wings stop; they point only at you."},
        {"zh": "对准玩家", "en": "Aiming at player"},
        {"zh": "你抬手，我就往左飘。", "en": "Raise your hand, and I drift left."},
        {"zh": "我身边的分身，刚分出来。", "en": "A clone just split off beside me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这一下打穿了我的翼膜。", "en": "That blow punched through my wing."},
        {"zh": "飞行很艰难！", "en": "Flying hard."},
        {"zh": "我的复制体不够多！", "en": "Not enough clones."},
        {"zh": "身体被撕裂！", "en": "Body torn."},
        {"zh": "我复制自己太快了！", "en": "Cloning too fast."},
        {"zh": "复制能力变弱了！", "en": "Cloning weakened."},
        {"zh": "翅膀裂了，我落低一点。", "en": "A wing membrane tears; I drop a little."},
        {"zh": "复制体太多控制不了！", "en": "Too many clones."},
        {"zh": "复制失败了！", "en": "Cloning failed."},
        {"zh": "翅膀被砍断了！", "en": "Wing cut off."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "近身便啃你的肉！", "en": "Feast on your flesh!"},
        {"zh": "来吧，享受我的盛宴！", "en": "Come, feast on my bounty!"},
        {"zh": "你的味道不错哦。", "en": "You taste good, too."},
        {"zh": "享受这一刻，消失吧！", "en": "Enjoy this moment, then disappear!"},
        {"zh": "你闻起来像美食！", "en": "You smell like a meal!"},
        {"zh": "享受我们的同归于尽！", "en": "Enjoy our mutual demise!"},
        {"zh": "尝尝我的锋利牙齿！", "en": "Feel my sharp teeth!"},
        {"zh": "那颗亮珍珠，先替我留着。", "en": "Save that bright pearl for me."},
        {"zh": "品尝我的复仇之吻！", "en": "Taste my revenge kiss!"},
        {"zh": "你的皮肤很松软。", "en": "Your skin is quite soft."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "让开，我扇起的风不小。", "en": "Clear the way; my wings stir a strong wind."},
        {"zh": "我身边又分出一个我。", "en": "Another me splits off at my side."},
        {"zh": "我要继续飞行。", "en": "I'm flying on."},
        {"zh": "你挡了我的路，找死！", "en": "You're in my way, dying now!"},
        {"zh": "别挡住我的视线！", "en": "Don't block my view!"},
        {"zh": "让开，我要前行！", "en": "Make way, I'm moving on!"},
        {"zh": "别挡我，否则你会后悔！", "en": "Get out of my way, or you'll regret it!"},
        {"zh": "闪开，别碍手碍脚！", "en": "Move, don't be in my way!"},
        {"zh": "我的克隆就在你身后。", "en": "My clone is right behind you."},
        {"zh": "你撞上的可能不是本体。", "en": "The one you hit may not be the original."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "来，让我们共舞。", "en": "Come, let's dance together."},
        {"zh": "找个舞伴吧。", "en": "Find a dance partner."},
        {"zh": "我需要个舞伴。", "en": "I need a dance partner."},
        {"zh": "加入我们吧。", "en": "Join us."},
        {"zh": "来个伴儿吧。", "en": "Get a partner."},
        {"zh": "找个舞伴，不然孤单。", "en": "Find a partner, or be alone."},
        {"zh": "来个共舞的吧。", "en": "Find a dance buddy."},
        {"zh": "我们来共舞吧。", "en": "Let's dance together."},
        {"zh": "找个伴侣，跳舞。", "en": "Find a partner, to dance."},
        {"zh": "你愿意和我共舞吗？", "en": "Will you dance with me?"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "光亮的珍珠闪烁着微光。", "en": "The bright pearl glitters."},
        {"zh": "珍珠中蕴含着神秘能量。", "en": "Energy pulses within the pearl."},
        {"zh": "捡起珍珠，感受它的温暖。", "en": "Feel the warmth of the pearl."},
        {"zh": "珍珠散发着柔和的光芒。", "en": "The pearl emits a soft glow."},
        {"zh": "珍珠内部仿佛有生命。", "en": "The pearl seems alive inside."},
        {"zh": "珍珠表面浮现出奇异纹路。", "en": "Strange patterns appear on the pearl."},
        {"zh": "珍珠中似乎有声音在低语。", "en": "The pearl hums softly."},
        {"zh": "珍珠中隐约可见影子。", "en": "Shadows flicker within the pearl."},
        {"zh": "珍珠发出微弱的光辉。", "en": "The pearl emits faint light."},
        {"zh": "珍珠反射出你的影子。", "en": "The pearl reflects your shadow."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见你了，我的复制品。", "en": "I see you, my copy."},
        {"zh": "你的位置已锁定，准备攻击。", "en": "Your position is locked."},
        {"zh": "你逃不掉的，我有复制品。", "en": "You can't escape, I have copies."},
        {"zh": "复制我的力量，消灭敌人。", "en": "Copy my strength, destroy the enemy."},
        {"zh": "我的复制品将包围你。", "en": "My copies will surround you."},
        {"zh": "你躲不过我的复制。", "en": "You can't avoid my copies."},
        {"zh": "复制我的形体，击败你。", "en": "Copy my form, defeat you."},
        {"zh": "复制我的力量，消灭他们。", "en": "Copy my power, destroy them."},
        {"zh": "我的复制品会保护我。", "en": "My copies will protect me."},
        {"zh": "复制我的攻击，杀死他们。", "en": "Copy my attack, kill them."},
        {"zh": "第三层的风把你的味道吹来。", "en": "The third layer's wind carries your scent."},
        {"zh": "你分得清哪个是我吗？", "en": "Can you tell which one is me?"},
        {"zh": "我的影子多了一只，在你身后。", "en": "I have one more shadow now, behind you."},
        {"zh": "盯着我吧，别转眼。", "en": "Keep your eyes on me; do not blink."},
        {"zh": "梦魇把我放在你的必经路上。", "en": "The nightmare set me on your path."},
        {"zh": "你数不清我们的时候，就输了。", "en": "When you lose count of us, you lose."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我会用复制品包围你。", "en": "I will surround you with copies."},
        {"zh": "复制我的意志，消灭你。", "en": "Copy my will, destroy you."},
        {"zh": "我的复制品会攻击你。", "en": "My copies will attack you."},
        {"zh": "复制我的力量，击溃你。", "en": "Copy my strength, crush you."},
        {"zh": "复制我的形态，消灭你。", "en": "Copy my form, destroy you."},
        {"zh": "我的复制品会吞噬你。", "en": "My copies will devour you."},
        {"zh": "复制我的意志，消灭敌人。", "en": "Copy my will, destroy the enemy."},
        {"zh": "复制我的力量，消灭他们", "en": "Copy my power, destroy them"},
        {"zh": "我的复制品会困住你。", "en": "My copies will trap you."},
        {"zh": "复制我的攻击，击败他们。", "en": "Copy my attack, defeat them."},
        {"zh": "从左边来的是假的。", "en": "The one from the left is false."},
        {"zh": "我们围成圈，你站中间。", "en": "We ring you; you stand in the middle."},
        {"zh": "复制要一点时间，够我咬一口。", "en": "Copying takes a moment, long enough for a bite."},
        {"zh": "你转身时，我又多了一个。", "en": "You turn, and there is one more of me."},
        {"zh": "打碎一个，还剩五个。", "en": "Break one, and five remain."},
        {"zh": "本体藏在最安静的那个里。", "en": "The original hides in the quietest one."},
        {"zh": "珍珠的光会暴露本体。", "en": "The pearl's glow will betray the original."},
        {"zh": "别急着挥剑，先数翅膀。", "en": "Do not swing yet; count the wings."},
        {"zh": "我们同时扑上去。", "en": "We lunge all at once."},
        {"zh": "你退一步，圈就缩一步。", "en": "Step back, and the ring tightens."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，你逃不出我的克隆！”", "en": "Sssss, you can't escape my clones!"},
        {"zh": "光之珍珠，我的战利品！", "en": "The light pearl, my trophy!"},
        {"zh": "吃掉你的光亮！", "en": "Eat the light!"},
        {"zh": "黑暗中复制自己！", "en": "Copy myself in the darkness!"},
        {"zh": "我的复制体挡在你面前。", "en": "My copy stands between you and me."},
        {"zh": "克隆的力量，无坚不摧！", "en": "The power of cloning, invincible!"},
        {"zh": "光亮消失，你失去方向！", "en": "The light fades, you lose your way!"},
        {"zh": "你被复制包围了！", "en": "You're surrounded by copies!"},
        {"zh": "吞噬你的光明！", "en": "Devour your light!"},
        {"zh": "黑暗是我的养料！", "en": "Darkness is my nourishment!"},
        {"zh": "两颗牙同时咬到你。", "en": "Two sets of teeth bite at once."},
        {"zh": "翅膀拍在脸上，眼前一黑。", "en": "A wing slaps your face; all goes dark."},
        {"zh": "被咬的地方开始发凉。", "en": "The bitten spot grows cold."},
        {"zh": "假的替你挡了一刀。", "en": "A fake one takes the blade for me."},
        {"zh": "我的爪子从上面落下。", "en": "My claws come down from above."},
        {"zh": "珍珠的光晃了你的眼。", "en": "The pearl's light dazzles your eyes."},
        {"zh": "你劈开的是空的。", "en": "You cut through empty air."},
        {"zh": "我又贴回你背后。", "en": "I am back at your back."},
        {"zh": "这一口，替本体记着。", "en": "This bite is on the original's behalf."},
        {"zh": "你的血沾在每张嘴上。", "en": "Your blood is on every one of my mouths."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "复制自我，无处不在！", "en": "Clone myself, everywhere!"},
        {"zh": "光的珍珠，我的宝藏！", "en": "The light pearl, my treasure!"},
        {"zh": "黑夜中生长克隆！", "en": "Grow clones in the night!"},
        {"zh": "光之珍珠，我的标记！", "en": "The light pearl, my mark!"},
        {"zh": "克隆诞生，黑暗蔓延！", "en": "Clones born, darkness spreads!"},
        {"zh": "光的消逝，我的力量！", "en": "The light's disappearance, my power!"},
        {"zh": "复制，我的生存之道！", "en": "Clone, my way of survival!"},
        {"zh": "光的消失，我的胜利！", "en": "The light's loss, my victory!"},
        {"zh": "黑夜中复制自我！", "en": "Clone myself in the night!"},
        {"zh": "光之珍珠，我的归宿！", "en": "The light pearl, my home!"},
        {"zh": "梦魇第三层，我翻了个身。", "en": "In the nightmare's third layer, I turn over."},
        {"zh": "光珠亮了一下，我成形。", "en": "The pearl flashes; I take shape."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的复制体被烧掉一个。", "en": "One of my copies just burned away."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "坠落摔伤了我！", "en": "Fallen and hurt."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "溺水了！快上来！", "en": "Drowned! Come up!"}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我掀翻了半圈。", "en": "The blast rolls me half around."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "被投射物击伤！", "en": "Hit by projectile."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的克隆还在分裂。", "en": "My clones are still splitting off."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀受伤了，挨饿的滋味可不好受。", "en": "Wing hurt! — and the starvation makes it worse."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打的是我的复制品。", "en": "That bolt hit one of my copies."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "掉入虚空中！", "en": "In void."}
      ]
    }
  }
}
