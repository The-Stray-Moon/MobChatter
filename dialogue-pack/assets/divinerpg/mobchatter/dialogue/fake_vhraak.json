        {"zh": "注视着你的每一次心跳", "en": "Stares at your heartbeat"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我感到虚弱了...", "en": "I feel weak..."},
        {"zh": "这具分身开始变淡。", "en": "This body of mine is fading."},
