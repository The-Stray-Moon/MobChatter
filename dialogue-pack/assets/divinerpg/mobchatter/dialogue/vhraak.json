{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "沙沙的脚步声在黑暗中回响。", "en": "The soft steps echo in the darkness."},
        {"zh": "分身中的一声低吟。", "en": "A whisper from one of the duplicates."},
        {"zh": "阴影中的声音越来越近。", "en": "The sound grows closer in the shadows."},
        {"zh": "黑暗中的低语在耳旁响起。", "en": "Whispers ring in your ears in the dark."},
        {"zh": "它似乎在低语着什么。", "en": "It seems to be whispering something."},
        {"zh": "沙沙声与脚步融为一体。", "en": "The rustle blends with the footsteps."},
        {"zh": "暗影中发出微弱的声音。", "en": "A faint sound emerges from the shadows."},
        {"zh": "低吟声在漆黑中飘荡。", "en": "Whispers drift in the darkness."},
        {"zh": "黑暗中传来神秘的低语。", "en": "Mysterious whispers come from the darkness."},
        {"zh": "它无声地靠近。", "en": "It moves silently closer."},
        {"zh": "五个影子一起迈步", "en": "Five shadows step as one"},
        {"zh": "分身的脚步差半拍", "en": "My doubles fall half a beat behind"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "它静静地站在那里。", "en": "It stands there quietly."},
        {"zh": "它的影子在墙上拉长。", "en": "Its shadow stretches on the wall."},
        {"zh": "一动不动的影子。", "en": "A still shadow."},
        {"zh": "静静伫立于黑暗中。", "en": "It stands quietly in the dark."},
        {"zh": "在黑暗中默默等待。", "en": "It waits silently in the dark."},
        {"zh": "它没有发出任何声音。", "en": "It makes no sound."},
        {"zh": "分身彼此之间没有互动。", "en": "The duplicates do not interact."},
        {"zh": "它静静地注视着前方。", "en": "It quietly stares ahead."},
        {"zh": "一动不动，只有呼吸声。", "en": "It stands still, only breathing."},
        {"zh": "在黑暗中保持静默。", "en": "It remains silent in the dark."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "它的眼中闪烁着好奇。", "en": "Curiosity glows in its eyes."},
        {"zh": "瞄准了你，四目相对。", "en": "It locks onto you, eye to eye."},
        {"zh": "四双眼睛注视着你。", "en": "Four eyes stare at you."},
        {"zh": "它注视着你，分身四散。", "en": "It stares at you, duplicates scattering."},
        {"zh": "注视着你，寻找机会。", "en": "It watches you, seeking an opening."},
        {"zh": "四道影子同时看向你。", "en": "Four shadows turn to look at you."},
        {"zh": "它的眼睛如两团黑影。", "en": "Its eyes are two shadows."},
        {"zh": "盯着你，分身同时行动。", "en": "It stares at you, duplicates acting in unison."},
        {"zh": "分身同时转向你。", "en": "The duplicates turn to you simultaneously."},
        {"zh": "它的目光如利剑穿透黑暗。", "en": "Its gaze pierces the darkness like a sword."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我怎么会受伤？", "en": "How did I get hurt?"},
        {"zh": "这...这是怎么回事？", "en": "What happened?"},
        {"zh": "呜，这是为什么？", "en": "Why me?"},
        {"zh": "这伤是怎么来的？", "en": "How did I get hurt?"},
        {"zh": "我明明没动啊...", "en": "I didn't move..."},
        {"zh": "这...这是什么攻击？", "en": "What attack was that?"},
        {"zh": "怎么会这样...", "en": "How did this happen..."},
        {"zh": "我...我没事吧？", "en": "Am I okay?"},
        {"zh": "这...这是怎么了？", "en": "What's happening?"},
        {"zh": "疼，是这具身体吗？", "en": "Pain. Is it this body?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "被你吸引，但别靠近!", "en": "Drawn to you, but stay away!"},
        {"zh": "四个我里只有一个是真的。", "en": "Of four of me, only one is real."},
        {"zh": "梦魇世界的食物，只有你!", "en": "Your flesh, the only meal here!"},
        {"zh": "我的分身也是猎物!", "en": "My duplicates are prey too!"},
        {"zh": "闪亮珍珠，我的宝藏!", "en": "Shiny pearl, my treasure!"},
        {"zh": "别靠近我的领地!", "en": "Keep away from my territory!"},
        {"zh": "黑暗中，只有我能生存!", "en": "In the dark, only I survive!"},
        {"zh": "与我为伴，你会死亡!", "en": "Be with me, and you'll die!"},
        {"zh": "梦魇之光中，我的存在!", "en": "In nightmare's light, I am!"},
        {"zh": "分身攻击，你无法躲避!", "en": "Duplicates attack, you can't evade!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡住了我的路!", "en": "You block my path!"},
        {"zh": "躲开，否则受苦!", "en": "Get out of my way or suffer!"},
        {"zh": "碰撞是你的命运!", "en": "Collision is your fate!"},
        {"zh": "分身混乱，你无处可逃!", "en": "Duplicates clash, nowhere to hide!"},
        {"zh": "你的身体是我的攻击!", "en": "Your body is my strike!"},
        {"zh": "分身攻击，你无法区分!", "en": "Duplicates attack, you can't tell them apart!"},
        {"zh": "我的力量，无人能挡!", "en": "My strength, none can stop!"},
        {"zh": "分身四起，你无处可藏!", "en": "Four copies rise, nowhere to hide!"},
        {"zh": "分身攻击，你分不清真假!", "en": "Duplicates attack, can't tell real from fake!"},
        {"zh": "分身与你同在，无处可逃!", "en": "Duplicates with you, nowhere to run!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找我的同类!", "en": "Find my mate!"},
        {"zh": "同类，我的伴侣!", "en": "Mate, my partner!"},
        {"zh": "我的同类，共享力量!", "en": "My mate, share my power!"},
        {"zh": "同类，一起生存!", "en": "Mate, survive together!"},
        {"zh": "与我同类，共享生命!", "en": "With my kind, share life!"},
        {"zh": "同类，我的伴侣，我的生命!", "en": "Mate, my partner, my life!"},
        {"zh": "同类，我的永恒伴侣!", "en": "Mate, my eternal partner!"},
        {"zh": "我的同类，我的灵魂伴侣!", "en": "My mate, my soulmate!"},
        {"zh": "与我同类，共享永恒!", "en": "With my kind, share eternity!"},
        {"zh": "同类，我的另一半!", "en": "Mate, my other half!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "闪烁的珍珠！", "en": "Shimmering pearl!"},
        {"zh": "这是我的珍珠！", "en": "Mine is the pearl!"},
        {"zh": "这里是我的珍珠！", "en": "Here's my pearl!"},
        {"zh": "来取走我的珍珠吧！", "en": "Take my pearl!"},
        {"zh": "珍珠是我的宝藏！", "en": "Pearl, my treasure!"},
        {"zh": "你拿不走我的珍珠！", "en": "You can't have my pearl!"},
        {"zh": "留下我的珍珠！", "en": "Leave my pearl!"},
        {"zh": "我的珍珠！", "en": "My pearl!"},
        {"zh": "珍珠属于我！", "en": "Pearl belongs to me!"},
        {"zh": "这颗闪亮的珍珠是我的。", "en": "This shining pearl is mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的分身已经围住你。", "en": "My doubles already surround you."},
        {"zh": "四道重影同时扑向你。", "en": "Four afterimages lunge at you at once."},
        {"zh": "我的分身要来了！", "en": "My duplicates will come!"},
        {"zh": "看我的分身！", "en": "Watch my duplicates!"},
        {"zh": "分身在追踪你！", "en": "Duplicates are tracking you!"},
        {"zh": "分身要来了！", "en": "Duplicates coming!"},
        {"zh": "分身马上到！", "en": "Duplicates on the way!"},
        {"zh": "分身即将出现！", "en": "Duplicates will appear!"},
        {"zh": "我要把你撕碎！", "en": "I'll tear you apart!"},
        {"zh": "我的分身来了！", "en": "My duplicates are here!"},
        {"zh": "四个我，围着你了！", "en": "Four of me have you surrounded!"},
        {"zh": "你猜哪个是本尊？", "en": "Guess which one is real?"},
        {"zh": "珍珠只有一个，真身也只有一个", "en": "One pearl, and only one of me is real"},
        {"zh": "我的分身已经绕到侧翼", "en": "My doubles are already on your flank"},
        {"zh": "梦魇第四层，你走错门", "en": "Fourth layer of nightmare. Wrong door"},
        {"zh": "你数得清我们几个吗", "en": "Can you even count us"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准你了！", "en": "Targeting you!"},
        {"zh": "分身攻击！", "en": "Duplicates attack!"},
        {"zh": "分身准备攻击！", "en": "Duplicates ready to attack!"},
        {"zh": "我要把你杀死！", "en": "I'll kill you!"},
        {"zh": "分身准备攻击你！", "en": "Duplicates ready to attack you!"},
        {"zh": "分身开始攻击！", "en": "Duplicates attacking!"},
        {"zh": "我一步一步收紧包围。", "en": "I tighten the ring step by step."},
        {"zh": "四个我，围住你一个。", "en": "Four of me, one of you."},
        {"zh": "你砍中的只是影子", "en": "You struck only a shadow"},
        {"zh": "珍珠的光芒晃了你的眼", "en": "The pearl's glare blurs your eyes"},
        {"zh": "我的分身不怕疼", "en": "My doubles feel no pain"},
        {"zh": "你攻击后，破绽就露了", "en": "Strike, and you leave an opening"},
        {"zh": "它们会替我先挨一刀", "en": "They take the first cut for me"},
        {"zh": "你转身，另一个我就在", "en": "Turn around. Another me is there"},
        {"zh": "你的剑在五个我之间犹豫", "en": "Your blade hesitates among five of me"},
        {"zh": "本尊还站在你背后", "en": "The real one is still behind you"},
        {"zh": "分身散开，围成一圈", "en": "The doubles spread into a ring"},
        {"zh": "你打中一个，剩下四个笑", "en": "Hit one, and the other four laugh"},
        {"zh": "影子消失时，我才动手", "en": "When the shadows fade, I strike"},
        {"zh": "别停下，停下就输了", "en": "Don't stop. Stopping loses"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的爪子从四面撕下来。", "en": "My claws tear in from every side."},
        {"zh": "寒冰之刃！", "en": "Ice blade!"},
        {"zh": "裂空一击！", "en": "Tear through!"},
        {"zh": "影分身术！", "en": "Clone trick!"},
        {"zh": "利爪带着寒气劈下！", "en": "My claws come down cold."},
        {"zh": "幽影穿梭！", "en": "Shadow dash!"},
        {"zh": "寒霜之吻！", "en": "Frost kiss!"},
        {"zh": "灵魂吞噬！", "en": "Soul devour!"},
        {"zh": "四道爪影同时落下！", "en": "Four claw shadows fall at once!"},
        {"zh": "拍碎你的护甲！", "en": "I smash through your armor!"},
        {"zh": "这一下是真的！", "en": "This one is real!"},
        {"zh": "从你身后的一角！", "en": "From the corner behind you!"},
        {"zh": "分身先咬，本尊收尾！", "en": "The doubles bite first, I finish!"},
        {"zh": "三十点伤害，够了吗！", "en": "Thirty points of damage. Enough?"},
        {"zh": "影子撕开你的侧腰！", "en": "A shadow tears your flank!"},
        {"zh": "我的爪痕是四道！", "en": "My claw marks come in fours!"},
        {"zh": "你挡错了方向！", "en": "You blocked the wrong way!"},
        {"zh": "本尊的爪子最重！", "en": "The real claws hit hardest!"},
        {"zh": "把你的盾打歪！", "en": "I knock your shield aside!"},
        {"zh": "让幻影塞满你的视野！", "en": "Let phantoms fill your sight!"}
      ]
    },
