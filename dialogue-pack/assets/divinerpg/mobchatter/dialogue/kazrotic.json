    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轰隆轰隆轰！", "en": "Boom boom boom!"},
        {"zh": "我的弹药充足！", "en": "Ammo loaded."},
        {"zh": "炮弹不炸方块，只炸你。", "en": "My shells spare the blocks and hit only you."},
        {"zh": "小心我的炮弹！", "en": "Watch out for my shells."},
        {"zh": "轰轰轰轰轰！", "en": "Boom boom boom boom!"},
        {"zh": "我只攻击敌人！", "en": "Only enemies for me."},
        {"zh": "轰隆轰隆轰轰！", "en": "Boom boom boom boom!"},
        {"zh": "炮口抬起来，别再走。", "en": "My cannon lifts; don't take another step."},
        {"zh": "这是我的世界！", "en": "My world."},
        {"zh": "轰隆轰隆轰轰轰！", "en": "Boom boom boom boom boom!"},
        {"zh": "炮身沉沉的，我挪动一步轰一声。", "en": "My gun is heavy; each step comes with a boom."},
        {"zh": "我拖着炮架，在梦魇第三层巡行。", "en": "I haul my gun mount across the third nightmare layer."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的生活很简单。", "en": "Simple life."},
        {"zh": "子弹上膛，只等影子。", "en": "The bullet is chambered; I wait for a shadow."},
