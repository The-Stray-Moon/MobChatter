        {"zh": "这里是我的巢穴。", "en": "My den here."},
        {"zh": "不需要朋友。", "en": "No need for friends."},
        {"zh": "夜晚的守护者。", "en": "Night's guardian."},
        {"zh": "第三层的走廊，我蹲守。", "en": "I keep watch in the third-floor corridor."},
        {"zh": "我的时间很宝贵。", "en": "Time is precious."},
        {"zh": "我是梦魇的产物。", "en": "Spawn of nightmare."},
        {"zh": "我的力量无法估量。", "en": "Infinite power."}
      ]
    },
