{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "挥舞利刃，甲壳铮亮。", "en": "Wields blade, shell gleams."},
        {"zh": "步履坚定，如行战场。", "en": "Steps sure, like marching."},
        {"zh": "步履间带起沙石响。", "en": "Steps echo with gravel."},
        {"zh": "虫群中走出勇士。", "en": "Warrior from bug swarm."},
        {"zh": "甲壳反射阳光。", "en": "Shell reflects sunlight."},
        {"zh": "步履间散发威严。", "en": "Steps exude might."},
        {"zh": "行进中保持警惕。", "en": "Keeps watch while walking."},
        {"zh": "步伐沉重，如铁蹄。", "en": "Gait heavy, like iron."},
        {"zh": "甲壳下的肌肉跳动。", "en": "Muscles flex beneath shell."},
        {"zh": "走来，敌人！", "en": "Here comes, foe!"},
        {"zh": "附魔剑在身侧低鸣。", "en": "My enchanted blade hums at my side."},
        {"zh": "走过落叶，声音很轻。", "en": "I cross the fallen leaves quietly."},
        {"zh": "盔甲缝隙透出微光。", "en": "Faint light leaks from my armor's seams."},
        {"zh": "天亮了，我加快脚步。", "en": "The sun is up; I quicken my pace."},
        {"zh": "剑尖在身后划出线。", "en": "My blade tip traces a line behind me."},
        {"zh": "我绕开树荫往前走。", "en": "I skirt the shade and keep walking."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静立如石像。", "en": "Stands like stone."},
        {"zh": "眼神凝视远方。", "en": "Looks into distance."},
        {"zh": "挥舞空中的利刃。", "en": "Wields empty air."},
        {"zh": "身体微微摇晃。", "en": "Body sways slightly."},
        {"zh": "甲壳上浮光跃金。", "en": "Shell glitters gold."},
        {"zh": "沉默中充满力量。", "en": "Silent, full of might."},
        {"zh": "静止中暗藏杀机。", "en": "Still, danger lurks."},
        {"zh": "静立中观察四周。", "en": "Scans surroundings."},
        {"zh": "甲壳反射日光。", "en": "Shell reflects sun."},
        {"zh": "如雕塑般屹立。", "en": "Stands like sculpture."},
        {"zh": "把剑横在膝上。", "en": "I lay my blade across my knees."},
        {"zh": "光斑在甲壳上移动。", "en": "Patches of light shift across my shell."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "发现玩家，目光锐利。", "en": "Sees player, sharp gaze."},
        {"zh": "目光锁定目标。", "en": "Locks on target."},
        {"zh": "注视玩家，全身戒备。", "en": "Stares at player, alert."},
        {"zh": "目光闪烁，似有洞察。", "en": "Gaze flickers, perceptive."},
        {"zh": "紧盯着玩家不放。", "en": "Fixes on player."},
        {"zh": "眼神中透出危险。", "en": "Dangerous gaze."},
        {"zh": "目光中透露敌意。", "en": "Hostile gaze."},
        {"zh": "注视玩家，准备攻击。", "en": "Stares, ready to attack."},
        {"zh": "目光中透出决心。", "en": "Gaze resolute."},
        {"zh": "紧盯着玩家的每一个动作。", "en": "Monitors every player move."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀被砍伤了！", "en": "My wings are hurt!"},
        {"zh": "我失去了力量！", "en": "My strength wanes!"},
        {"zh": "我感觉不对劲...", "en": "Something's wrong..."},
        {"zh": "我的盔甲破了！", "en": "My armor is broken!"},
        {"zh": "毒液在腐蚀我！", "en": "Poison is eating me!"},
        {"zh": "我受伤了，快帮我！", "en": "I'm hurt, help me!"},
        {"zh": "附魔在剥落，一点一点。", "en": "The enchantment peels away, bit by bit."},
        {"zh": "甲壳裂到第二道缝。", "en": "My shell has split to a second seam."},
        {"zh": "我失去了平衡...", "en": "I'm off balance..."},
        {"zh": "阿帕拉契亚之力在流失！", "en": "The power of Appalachia is draining away!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的光芒引来了我！", "en": "The light on you attracts me!"},
        {"zh": "阿帕拉契亚之魂，我想要！", "en": "I want the soul of Appalachia!"},
        {"zh": "你的盔甲闪耀着魔力！", "en": "Your armor glows with magic!"},
        {"zh": "你手中的武器真诱人！", "en": "That weapon of yours looks tempting!"},
        {"zh": "让我们共享这份力量吧！", "en": "Let’s share this power together!"},
        {"zh": "你的光芒让我心动了！", "en": "Your light has set my heart racing!"},
        {"zh": "一起战斗，力量加倍！", "en": "Fight together, our power doubles!"},
        {"zh": "你身上的魔法吸引着我！", "en": "The magic on you draws me in!"},
        {"zh": "你的光芒让我无法抗拒！", "en": "Your light is irresistible!"},
        {"zh": "和我一起，你将变得更强！", "en": "Join me, and you’ll grow stronger!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "阿帕拉契亚的剑，撞坏你的甲。", "en": "Apalachia swords crack your armor."},
        {"zh": "小心，我不会退缩！", "en": "Beware, I won’t back down!"},
        {"zh": "阿帕拉契亚之魂，燃烧吧！", "en": "The soul of Appalachia burns!"},
        {"zh": "你的攻击激起了我的斗志！", "en": "Your attack stirs my fighting spirit!"},
        {"zh": "别想躲开我的攻击！", "en": "You can’t avoid my attack!"},
        {"zh": "我们来一场力量的较量！", "en": "Let’s test our strength!"},
        {"zh": "我们的碰撞会产生火花！", "en": "Our collision sparks!"},
        {"zh": "我的攻击不容忽视！", "en": "My attack can’t be ignored!"},
        {"zh": "你的攻击激起我的战斗欲望！", "en": "Your attack stirs my battle desire!"},
        {"zh": "让我们来一次正面交锋！", "en": "Let’s have a head-on clash!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们这一族，白天都不敢相认。", "en": "My kind dare not meet each other by daylight."},
        {"zh": "我们是同类，可以交流！", "en": "We are alike, we can communicate!"},
        {"zh": "一起飞翔，一起战斗！", "en": "Fly together, fight together!"},
        {"zh": "让我们结为伴侣！", "en": "Let’s be partners!"},
        {"zh": "同类之间没有秘密！", "en": "There are no secrets between us!"},
        {"zh": "我们共同拥有阿帕拉契亚！", "en": "We share Appalachia together!"},
        {"zh": "让我们一起守护家园！", "en": "Let’s protect our home together!"},
        {"zh": "同类之间，心灵相通！", "en": "We understand each other’s hearts!"},
        {"zh": "我们是阿帕拉契亚的守护者！", "en": "We are protectors of Appalachia!"},
        {"zh": "让我们并肩作战！", "en": "Let’s fight side by side!"}
      ]
    },
