{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀扇动，掠过夜空。", "en": "Wings flap, gliding through the night."},
        {"zh": "月光下，影子飘过。", "en": "Shadow passes under moonlight."},
        {"zh": "夜风中，我飞翔。", "en": "I fly through the night wind."},
        {"zh": "影子在空中游走。", "en": "Shadow wanders in the air."},
        {"zh": "银辉下，我隐匿。", "en": "I hide in silver light."},
        {"zh": "黑夜中，我现身。", "en": "I appear in the dark."},
        {"zh": "翅膀划破寂静。", "en": "Wings break the silence."},
        {"zh": "月光引导我的轨迹。", "en": "Moonlight guides my path."},
        {"zh": "黑暗中，我无声飞行。", "en": "I fly silently in the dark."},
        {"zh": "双翼一展，滑出很远。", "en": "One spread of my wings carries me far."},
        {"zh": "我飞得比箭还稳。", "en": "I fly steadier than an arrow."},
        {"zh": "空气在我翼下裂开。", "en": "The air splits under my wings."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静止在虚空中。", "en": "Hovering in mid-air."},
        {"zh": "凝视远方的月光。", "en": "Gazing at distant moonlight."},
        {"zh": "夜幕下的沉默。", "en": "Silence under the night."},
        {"zh": "我停在和你一样的高度。", "en": "I hover at your exact height."},
        {"zh": "在虚空之中沉思。", "en": "Reflecting in the void."},
        {"zh": "无尽之夜中的守护。", "en": "Guarding in endless night."},
        {"zh": "夜空中的漂浮者。", "en": "Drifting in the night sky."},
        {"zh": "等待时机。", "en": "Awaiting an opportunity."},
        {"zh": "在黑暗中守护。", "en": "Guarding in the dark."},
        {"zh": "夜色中的隐者。", "en": "Shadow in the night."},
        {"zh": "悬在半空，一动不抖。", "en": "I hang in the air without a tremor."},
        {"zh": "箭射过来，穿不过我。", "en": "Arrows come, and none can pierce me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉到你的存在。", "en": "Noticing your presence."},
        {"zh": "盯住你。", "en": "Staring at you."},
        {"zh": "你抬弓了，可我不怕箭。", "en": "You raise your bow; arrows do not trouble me."},
        {"zh": "俯视着你。", "en": "Overlooking you."},
        {"zh": "我一击就飞上高空，再下来。", "en": "I strike, soar high, then come down again."},
        {"zh": "追踪你的动作。", "en": "Tracking your movements."},
        {"zh": "你身后那根黑曜石柱，我记住了。", "en": "That obsidian pillar behind you is my marker."},
        {"zh": "你的动作引起了注意。", "en": "Your movements caught my attention."},
        {"zh": "注意到了你的动作。", "en": "Noticing your actions."},
        {"zh": "你的存在引起我的注意。", "en": "Your presence caught my attention."},
        {"zh": "你的箭，伤不了我。", "en": "Your arrows cannot hurt me."},
        {"zh": "我飞到你头顶上了。", "en": "I am above your head now."},
        {"zh": "我试着和你齐平。", "en": "I match your height."},
        {"zh": "抬头，我在那儿。", "en": "Look up. I am there."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "末地的风托不住我的翼膜。", "en": "The End's wind cannot hold my wing membrane."},
        {"zh": "伤痕累累，虚弱不堪。", "en": "Wounded, weak."},
        {"zh": "翅膀被砍了，飞不快。", "en": "Wings cut, can't fly fast."},
        {"zh": "受伤了，赶紧躲远点。", "en": "Injured, hide."},
        {"zh": "翅膀被伤到了，无法自如飞翔。", "en": "Wings hurt, can't fly freely."},
        {"zh": "翅膀受伤，飞不高。", "en": "Wings hurt, can't fly high."},
        {"zh": "翅膀受伤，移动受限。", "en": "Wings hurt, movement limited."},
        {"zh": "翅膀受伤，难以飞远。", "en": "Wings hurt, can't fly far."},
        {"zh": "翅膀受伤，飞行时痛。", "en": "Wings hurt, painful flight."},
        {"zh": "远程伤不了我，可这一下疼！", "en": "Ranged shots can't hurt me, but that one stung!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你会感受到我的存在吗？", "en": "Can you feel my presence?"},
        {"zh": "你不能轻易抓住我。", "en": "You can't catch me easily."},
        {"zh": "我飞翔在虚空中。", "en": "I fly in the void."},
        {"zh": "我寻找我的猎物。", "en": "I seek my prey."},
        {"zh": "我不落地，你也拿不到我。", "en": "I never land, so you can never reach me."},
        {"zh": "我不会轻易被驯服。", "en": "I won't be easily tamed."},
        {"zh": "我自由，我强大。", "en": "I am free, I am strong."},
        {"zh": "我的飞行是永恒的。", "en": "My flight is eternal."},
        {"zh": "你是我的下一个目标。", "en": "You are my next target."},
        {"zh": "不要试图抓住我。", "en": "Don't try to catch me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡住了我的路线。", "en": "You blocked my path."},
        {"zh": "我们来个亲密接触。", "en": "Let's have a close encounter."},
        {"zh": "你不能阻止我。", "en": "You can't stop me."},
        {"zh": "撞上我，你会后悔的。", "en": "Collide with me, and you'll regret it."},
        {"zh": "我的飞行不受阻挡。", "en": "My flight is unobstructed."},
        {"zh": "你无法避免这次碰撞。", "en": "You can't avoid this collision."},
        {"zh": "我的速度无法超越。", "en": "My speed can't be surpassed."},
        {"zh": "你挡在我和我的目标之间。", "en": "You're in my way to my target."},
        {"zh": "你阻止了我的前进。", "en": "You obstruct my advance."},
        {"zh": "我不会轻易让路。", "en": "I won't give way easily."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "天上没有同族，只剩我一个。", "en": "No kin left in the sky — only me."},
        {"zh": "你的翅膀也有这层暗影吗。", "en": "Do your wings carry this same darkness?"},
        {"zh": "末地的紫雾里，我独自盘旋。", "en": "In the End's violet haze, I circle alone."},
        {"zh": "六百年了，我还没找到同类。", "en": "Six hundred years, and I have found no kin."},
        {"zh": "飞高一点，等你的箭射完。", "en": "I'll fly high till your arrows run out."},
        {"zh": "两只影兽在高空盘旋成圈。", "en": "Two ayeraco circle high in a ring."},
        {"zh": "我是你的同类。", "en": "I am your kind."},
        {"zh": "我的伴侣也在寻找。", "en": "My mate is also seeking."},
        {"zh": "我们一起飞翔吧。", "en": "Let's fly together."},
        {"zh": "我是你的伴侣。", "en": "I am your mate."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "神圣碎片闪着光，落入我的囊中。", "en": "Shiny holy shard lands in my pouch."},
        {"zh": "绿色末影剑握在手中，冰冷而锐利。", "en": "Cold and sharp, the end-shadow sword."},
        {"zh": "神圣套装闪耀着圣洁的光辉。", "en": "Holy set glows with purity."},
        {"zh": "天空中飘落的光点，是我的奖励。", "en": "Light dots in the sky are my reward."},
        {"zh": "我用翅膀捕捉了它的掉落物。", "en": "I caught its drops with my wings."},
        {"zh": "神圣碎片闪耀着它独特的光芒。", "en": "Shiny holy shard, unique glow."},
        {"zh": "绿色末影剑似乎在低语。", "en": "End-shadow sword whispers."},
        {"zh": "我收集了它的神圣套装。", "en": "I collected its holy set."},
        {"zh": "掉落物落入我的囊中，温暖而珍贵。", "en": "Drops warm and precious in my pouch."},
        {"zh": "神圣碎片在手中熠熠生辉。", "en": "Shiny holy shard in hand glows."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找猎物，我飞向下方。", "en": "Seeking prey, I fly downward."},
        {"zh": "玩家的气息，我锁定目标。", "en": "Player's scent, target locked."},
        {"zh": "从天而降，我是空影兽。", "en": "From above, I am Ayeraco."},
        {"zh": "我的眼睛能穿透黑暗。", "en": "Eyes see through darkness."},
        {"zh": "我将飞向玩家。", "en": "I'll fly to the player."},
        {"zh": "我已锁定你的位置。", "en": "Target acquired."},
        {"zh": "玩家，我将注视你。", "en": "Player, I'll watch you."},
        {"zh": "寻找食物，我翱翔天际。", "en": "Seeking food, I soar."},
        {"zh": "我的视线锁定住你。", "en": "My gaze is on you."},
        {"zh": "锁定目标，我将攻击。", "en": "Target locked, I'll attack."},
        {"zh": "先试一爪，再飞高。", "en": "One strike, then I climb."},
        {"zh": "你在下面，正好。", "en": "You are below. Perfect."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "在高空，我发起进攻。", "en": "I attack from above."},
        {"zh": "与玩家处于同一高度。", "en": "At player's height."},
        {"zh": "我将再次发起攻击。", "en": "I'll attack again."},
        {"zh": "保持高度，瞄准玩家。", "en": "Maintain height, target player."},
        {"zh": "再次攻击，玩家小心。", "en": "Attack again, player beware."},
        {"zh": "攻击时保持同一高度。", "en": "Attack, maintain height."},
        {"zh": "我将再次飞向玩家。", "en": "I'll fly to the player again."},
        {"zh": "再次发起高空攻击。", "en": "I'll attack from above."},
        {"zh": "攻击时，保持高度。", "en": "Attack, maintain height."},
        {"zh": "我将再次靠近玩家。", "en": "I'll get closer to the player."},
        {"zh": "俯冲一次，就升回去。", "en": "One dive, then back up."},
        {"zh": "等你抬头，我已走。", "en": "By the time you look up, I am gone."},
        {"zh": "我的高度由我说了算。", "en": "I decide the altitude."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "发出尖锐鸣叫，翅膀扇动将你击飞。", "en": "Screams and knocks you away with wing flaps."},
        {"zh": "翅膀一振，你被卷入云层。", "en": "Wings beat and you are drawn into the clouds."},
        {"zh": "从高处俯冲，利爪几乎触碰你。", "en": "Plunges from above, claws near touching you."},
        {"zh": "嘶嘶声中，利齿咬向你的手臂。", "en": "Hisses, fangs bite at your arm."},
        {"zh": "闪电般的攻击，你感到痛楚。", "en": "Blazing attack, pain sears through you."},
        {"zh": "挥动翅膀，扇起一阵旋风。", "en": "Wings beat, creating a whirlwind."},
        {"zh": "高声鸣叫，展示锋利的牙齿。", "en": "Roars, showing sharp teeth."},
        {"zh": "双翅一振，将你高高抛起。", "en": "Wings beat, throwing you high up."},
        {"zh": "翅膀划过，寒气逼人。", "en": "Wings slice, chilling the air."},
        {"zh": "紧闭双目，集中力量攻击。", "en": "Closes eyes, focusing for the attack."},
        {"zh": "利爪擦着你的肩！", "en": "Talons graze your shoulder!"},
        {"zh": "打完就升空！", "en": "Strike, then climb!"}
      ]
    },
