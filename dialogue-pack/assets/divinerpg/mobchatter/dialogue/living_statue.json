    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "缓慢前行，石像般不动如山", "en": "Slowly walk, like a statue"},
        {"zh": "步履蹒跚，仿佛石雕走动", "en": "Shuffle, like a moving statue"},
        {"zh": "凝固的步伐，静如雕塑", "en": "Frozen steps, still as a statue"},
        {"zh": "石像的步伐，稳重而缓慢", "en": "Statue-like steps, slow and steady"},
        {"zh": "缓缓移动，如石雕般无声", "en": "Move slowly, as silent as a statue"},
        {"zh": "石像行进，无声无息", "en": "Advance like a statue, silently"},
        {"zh": "缓慢行走，如同静止的雕塑", "en": "Walk slowly, like a still statue"},
        {"zh": "石雕般行走，无声无息", "en": "Walk like a statue, silently"},
        {"zh": "静止的步伐，如石雕般不动", "en": "Still steps, like a statue"},
        {"zh": "石像的行进，无声无息", "en": "Statue-like walk, silent"},
        {"zh": "石足碾过地面，留下浅痕。", "en": "Stone feet grind a shallow trail."},
        {"zh": "关节发出干涩的摩擦声。", "en": "My joints creak drily."},
        {"zh": "我一步一步，不肯加快。", "en": "Step by step, I refuse to hurry."},
        {"zh": "衣褶上的石粉簌簌落下。", "en": "Stone dust falls from my carved robes."},
        {"zh": "走过苔痕，苔痕便断了。", "en": "Moss breaks where I pass."},
        {"zh": "我保持着雕像的姿势挪动。", "en": "I move while keeping my statue pose."}
      ]
    },
