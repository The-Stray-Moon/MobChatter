    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你诱惑它失败了。", "en": "Failed to tempt it."},
        {"zh": "雕像开始微微摇晃。", "en": "The statue started to sway slightly."},
        {"zh": "它没有回应你的食物。", "en": "It ignored your offering."},
        {"zh": "它的眼神似乎在寻找。", "en": "Its gaze seems to search."},
        {"zh": "它突然扭动了一下。", "en": "It suddenly twitched."},
        {"zh": "雕像表面开始裂开。", "en": "Cracks appeared on the statue."},
        {"zh": "它没有理会你的靠近。", "en": "It ignored your approach."},
        {"zh": "它突然变得活跃起来。", "en": "It suddenly became more active."},
        {"zh": "它似乎注意到了什么。", "en": "It seemed to notice something."},
        {"zh": "它开始轻微地颤抖。", "en": "It started to tremble slightly."},
        {"zh": "你拿食物逗一块石头？", "en": "You tempt a stone with food?"},
        {"zh": "台座上没有放供品的位置。", "en": "There is no place for offerings on my base."},
        {"zh": "你敲了敲我，我听见了。", "en": "You knocked on me; I heard it."},
        {"zh": "我醒得比你想的慢。", "en": "I wake slower than you think."},
        {"zh": "别把花插进我的裂缝。", "en": "Don't put flowers in my cracks."},
        {"zh": "你拜我，我也不动。", "en": "Bow to me and I still won't move."}
      ]
    },
