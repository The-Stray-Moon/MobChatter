        {"zh": "我要让入侵者消失。", "en": "I shall make the intruder disappear."},
        {"zh": "我会保护这片绿色。", "en": "I will protect this green."},
        {"zh": "我要教训他！", "en": "I shall教训him!"},
        {"zh": "我要阻止他伤害草地。", "en": "I shall stop him from harming the meadow."},
        {"zh": "我要用我的力量守护。", "en": "I shall use my strength to protect."},
        {"zh": "我不能让草地受到伤害。", "en": "I cannot let the meadow be harmed."},
        {"zh": "我要保护这片绿色的生命。", "en": "I must protect the green life here."},
        {"zh": "我要教训那些侵犯者。", "en": "I shall教训those intruders."},
        {"zh": "我要守护这片绿色的乐土。", "en": "I shall guard this green paradise."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "绿衣服，第二层，别多问。", "en": "Green coat, second floor — don't ask."},
        {"zh": "你怎么这么难吃？", "en": "Why are you so yucky?"},
        {"zh": "小心我的尖牙！", "en": "Watch out for my sharp teeth!"},
        {"zh": "你的血肉不够鲜美！", "en": "Your flesh is not fresh enough!"},
        {"zh": "我需要更多养分！", "en": "I need more nutrients!"},
        {"zh": "绿色的我，在第二层守了很多年。", "en": "Green as I am, I have guarded layer two for years."},
        {"zh": "别动，我要咬你！", "en": "Don't move, I'm going to bite you!"},
        {"zh": "这绿色皮肤，在梦魇里正好藏身。", "en": "Green skin hides well in the Nightmare."},
        {"zh": "你的骨头很坚韧！", "en": "Your bones are tough!"},
        {"zh": "绿色的脸凑得很近。", "en": "My green face comes very close."}
