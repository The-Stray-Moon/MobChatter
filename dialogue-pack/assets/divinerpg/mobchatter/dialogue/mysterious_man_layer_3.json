{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "在梦魇之土漫步，绿光闪烁。", "en": "Wanders through Nightmare Earth, green light flickering."},
        {"zh": "深绿皮肤在黑暗中闪耀。", "en": "Deep green skin glows in the darkness."},
        {"zh": "低语中带有一丝神秘。", "en": "Whispers with a hint of mystery."},
        {"zh": "啃食梦魇草，滋养灵魂。", "en": "Nourishes with Nightmare Grass."},
        {"zh": "偶尔抬头看看天空。", "en": "Occasionally glances at the sky."},
        {"zh": "夜晚的阴影中游荡。", "en": "Wanders in the shadows of night."},
        {"zh": "轻声唱着古老的歌谣。", "en": "Sings ancient songs softly."},
        {"zh": "对玩家视而不见。", "en": "Ignores the player."},
        {"zh": "在梦魇之树下觅食。", "en": "Feeds beneath the Nightmare Tree."},
        {"zh": "神秘的绿光在移动。", "en": "Mysterious green light moves."},
        {"zh": "在梦魇第二层的石廊里踱步。", "en": "He paces the stone halls of the Nightmare's second layer."},
        {"zh": "绿袍下摆扫过暗紫的草。", "en": "His green hem sweeps the dark purple grass."},
        {"zh": "绕过一块发烫的梦魇石。", "en": "He skirts a warm nightmare stone."},
        {"zh": "数着台阶，一级一级走。", "en": "He counts the stairs, one by one."},
        {"zh": "走到岔口，停了一下。", "en": "At the fork he pauses a moment."},
        {"zh": "手里拢着一把干草。", "en": "He carries a bundle of dry grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静站在梦魇草丛中。", "en": "Stands quietly in a patch of Nightmare Grass."},
        {"zh": "绿光在夜晚中闪烁。", "en": "Green light flickers in the night."},
        {"zh": "沉思中，双眼微闭。", "en": "Meditates with closed eyes."},
        {"zh": "轻声低语，无人能懂。", "en": "Whispers that no one understands."},
        {"zh": "享受着宁静的夜晚。", "en": "Enjoys the quiet night."},
        {"zh": "在梦魇石堆中打坐。", "en": "Sits in a pile of Nightmare Stones."},
        {"zh": "二十点生命，够我熬过这夜。", "en": "Twenty health is enough to last this night."},
        {"zh": "夜晚的守护者，默默无闻。", "en": "Silent guardian of the night."},
        {"zh": "沉浸在自己的世界中。", "en": "Lost in their own world."},
        {"zh": "神秘绿光中若隐若现。", "en": "Faintly visible in the mysterious green light."},
        {"zh": "坐在石阶上嚼草茎。", "en": "He sits on the steps chewing a stalk."},
        {"zh": "把绿兜帽往上推了推。", "en": "He pushes his green hood back."},
        {"zh": "盯着远处的一道裂缝。", "en": "He watches a crack in the distance."},
        {"zh": "小声和苔藓说话。", "en": "He talks softly to the moss."},
        {"zh": "用指尖敲着膝盖打拍子。", "en": "He taps a rhythm on his knee."},
        {"zh": "把草籽一颗颗收进袋里。", "en": "He pockets the seeds one by one."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉玩家，绿光微闪。", "en": "Notices the player, green light flickers."},
        {"zh": "盯住玩家，绿眸闪烁。", "en": "Stares at the player, green eyes glow."},
        {"zh": "轻轻一跃，接近玩家。", "en": "Jumps lightly, approaching the player."},
        {"zh": "靠近玩家，绿光四射。", "en": "Approaches the player, green light bursts out."},
        {"zh": "玩家的出现打破宁静。", "en": "The player's presence disrupts the peace."},
        {"zh": "低语间充满警告。", "en": "Whispers with warnings."},
        {"zh": "似乎对玩家有所防备。", "en": "Seems wary of the player."},
        {"zh": "盯着玩家，欲言又止。", "en": "Stares at the player, almost speaking."},
        {"zh": "靠近玩家，绿光萦绕。", "en": "Approaches the player, green light surrounds them."},
        {"zh": "绿袍底下不是给你看的。", "en": "What's under this green robe isn't for you."},
        {"zh": "抬眼，帽檐下两点绿。", "en": "He looks up: two green points under the hood."},
        {"zh": "他把草茎收进了袖口。", "en": "He tucks the stalk into his sleeve."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "绿光闪烁，我感到虚弱了。", "en": "Green light flickers, I feel weak."},
        {"zh": "身体受损，能量流失。", "en": "Injured, energy drained."},
        {"zh": "我受了伤，但仍在观察。", "en": "Injured, but still observing."},
        {"zh": "绿影摇曳，我受创了。", "en": "Green shadow, injured."},
        {"zh": "我被攻击了，但还在坚持。", "en": "Attacked, but still enduring."},
        {"zh": "伤痕累累，我难以支撑。", "en": "Wounded, hard to stand."},
        {"zh": "我被削弱了，但不会倒下。", "en": "Weakened, but not falling."},
        {"zh": "伤势严重，我需要庇护。", "en": "Serious wounds, need shelter."},
        {"zh": "我疲惫不堪，但未放弃。", "en": "Exhausted, but not giving up."},
        {"zh": "绿体受损，我需要休息。", "en": "Damaged, need rest."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我嗅到了新鲜的草香！", "en": "Fresh grass!"},
        {"zh": "我来了，来吃这些美味的叶子。", "en": "Here for the tasty leaves."},
        {"zh": "这片草地是我们的午餐。", "en": "Time for lunch."},
        {"zh": "这片叶子似乎很营养。", "en": "That leaf looks nutritious."},
        {"zh": "我要在这里享受美食。", "en": "Enjoying the meal here."},
        {"zh": "这片地是我的美食乐园。", "en": "My food paradise."},
        {"zh": "这草很嫩，很适合我。", "en": "Soft grass for me."},
        {"zh": "这片草地是我的午餐基地。", "en": "Grass is my lunch base."},
        {"zh": "我要休息，消化食物。", "en": "Resting, digesting."},
        {"zh": "这片草地永远是我的美食之地。", "en": "Grass is my eternal feast."},
        {"zh": "这层的草只有我能吃。", "en": "Only I can eat the grass on this layer."},
        {"zh": "别摘那片紫叶。", "en": "Don't pick that purple leaf."},
        {"zh": "我种的东西不能白给。", "en": "What I grow isn't free."},
        {"zh": "你要草，先给点东西。", "en": "You want grass? Trade something."},
        {"zh": "这里的根扎得很深。", "en": "The roots here run deep."},
        {"zh": "你踩坏的那片要重新长。", "en": "What you trampled must regrow."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你打扰了我的休息。", "en": "Interrupting my rest."},
        {"zh": "不要靠近我，我会反击！", "en": "Stay back, I’ll fight."},
        {"zh": "别碰我，我有危险！", "en": "Don’t touch me, dangerous!"},
        {"zh": "这是我的领地，离开！", "en": "My territory, go away!"},
        {"zh": "你敢靠近，后果自负。", "en": "Consequences for you."},
        {"zh": "别靠近，我警告你！", "en": "Warning, don’t come closer."},
        {"zh": "这层的走廊归我管。", "en": "The corridors on this layer are mine."},
        {"zh": "退一步，否则后果自负。", "en": "Step back, or else."},
        {"zh": "这是我的领地，别来烦我。", "en": "My territory, leave me alone."},
        {"zh": "他退开一步，护住了草。", "en": "He steps back, shielding the grass."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你来陪我吧，我的伴侣。", "en": "Be my mate."},
        {"zh": "你看起来很适合我。", "en": "Good mate."},
        {"zh": "交易之外，我也想有人陪。", "en": "Beyond trading, I too want company."},
        {"zh": "来，让我们一起走过。", "en": "Together, let’s go."},
        {"zh": "你和我在一起，很完美。", "en": "Perfect with you."},
        {"zh": "我攒了些矿石，想分你一半。", "en": "I have saved some ore and want to share half of it."},
        {"zh": "让我们共同走过。", "en": "Together we’ll go."},
        {"zh": "我选择你作为我的伴侣。", "en": "You’re my chosen mate."},
        {"zh": "绿袍子这么长，陪我走一趟。", "en": "This green robe is long — walk a while with me."},
        {"zh": "你是我的最佳伴侣。", "en": "Best mate for me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到了青草的香气。", "en": "I smell the scent of fresh grass."},
        {"zh": "这片草地是我的乐土。", "en": "This meadow is my paradise."},
        {"zh": "树叶是美味的零食。", "en": "Leaves are yummy treats."},
        {"zh": "夜晚的露珠真甜美。", "en": "Dew in the night is sweet."},
        {"zh": "我吃草，我平静。", "en": "I eat grass, I am calm."},
        {"zh": "我要寻找新的绿色。", "en": "I seek new green."},
        {"zh": "这里是我的小家。", "en": "This is my home."},
        {"zh": "阳光下的青草最好吃。", "en": "Grass in the sunlight tastes best."},
        {"zh": "我是和平的使者。", "en": "I am a messenger of peace."},
        {"zh": "我要享受这片草地。", "en": "I shall enjoy this meadow."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "入侵者！我要保护这片草地！", "en": "Intruder! I must protect this meadow!"},
        {"zh": "不要伤害我的草地！", "en": "Do not harm my meadow!"},
        {"zh": "我要守护这片绿色！", "en": "I shall protect this green!"},
        {"zh": "谁敢靠近我的家？", "en": "Who dares approach my home?"},
        {"zh": "这里有我的秘密。", "en": "This is my secret."},
        {"zh": "这片草地是我的领地！", "en": "This meadow is my territory!"},
        {"zh": "我在这里已经很久了。", "en": "I have been here for a long time."},
        {"zh": "入侵者，离开我的地盘！", "en": "Intruder, leave my territory!"},
        {"zh": "我是这片草地的守护者。", "en": "I am the guardian of this meadow."},
        {"zh": "不要动我的家！", "en": "Do not touch my home!"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
