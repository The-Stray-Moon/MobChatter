        {"zh": "受伤了，别靠近我！", "en": "Stay away, I'm injured!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "细长的蛛丝缠绕着你。", "en": "Long strands of silk wrap around you."},
        {"zh": "尝尝我的毒液吧，丛林碎片还沾在上头。", "en": "Taste my venom, still wet with jungle shards."},
        {"zh": "那味道让我吐丝更急。", "en": "That smell makes my silk come faster."},
        {"zh": "小心我的八条长腿。", "en": "Watch out for my eight long legs."},
        {"zh": "丛林碎片是我唯一的奖励。", "en": "Forest shards are my only reward."},
        {"zh": "你手里的肉不算诱饵。", "en": "The meat in your hand is no bait."},
        {"zh": "我的毒液足以致命。", "en": "My venom is deadly."},
        {"zh": "你会后悔的。", "en": "You'll regret this."},
        {"zh": "享受我的毒液。", "en": "Enjoy my venom."},
        {"zh": "我的丝线能绊倒你。", "en": "My silk can trip you."}
      ]
