{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "吐丝前行，悄无声息。", "en": "Silently weave and move."},
        {"zh": "攀藤而下，悄无人知。", "en": "Climb down vines unseen."},
        {"zh": "蛛丝缠绕，轻盈跳跃。", "en": "Silken web, leap lightly."},
        {"zh": "丛林间游走，静若处子。", "en": "Move through the jungle, still."},
        {"zh": "寻觅猎物，蛛丝微颤。", "en": "Silken thread, prey detected."},
        {"zh": "快速爬行，避人耳目。", "en": "Crawl fast, unnoticed."},
        {"zh": "攀附树枝，伺机而动。", "en": "Climb branches, wait."},
        {"zh": "吐丝自卫，敏捷无双。", "en": "Weave silk, agile."},
        {"zh": "悄无声息，潜行其中。", "en": "Silently move, hidden."},
        {"zh": "攀岩而上，迅速敏捷。", "en": "Climb quickly, agile."},
        {"zh": "八条腿踩着叶背走过。", "en": "Eight legs step across the leaf backs."},
        {"zh": "我贴着一根藤滑下来。", "en": "I slide down a vine."},
        {"zh": "蛛丝在枝间拉成桥。", "en": "My silk spans the branches like a bridge."},
        {"zh": "我倒挂在树上往下爬。", "en": "I crawl down headfirst from the tree."},
        {"zh": "湿气让我的丝更黏。", "en": "The damp makes my silk stickier."},
        {"zh": "叶脉承得住我的重量。", "en": "The leaf veins hold my weight."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静卧蛛网，守护领地。", "en": "Lie in web, guard territory."},
        {"zh": "悠闲吐丝，享受宁静。", "en": "Weave silk, peaceful."},
        {"zh": "静静等待，猎物上钩。", "en": "Wait, prey will come."},
        {"zh": "吐丝不息，织网不懈。", "en": "Weave ceaselessly."},
        {"zh": "守护家园，永不松懈。", "en": "Guard home, never rest."},
        {"zh": "悄然织网，耐心等待。", "en": "Weave quietly, patient."},
        {"zh": "守护领地，绝不退让。", "en": "Defend territory, never yield."},
        {"zh": "吐丝不息，织网织梦。", "en": "Weave silk, dream on."},
        {"zh": "静静织网，静候猎物。", "en": "Weave quietly, wait."},
        {"zh": "守护家园，织网织心。", "en": "Guard home, weave heart."},
        {"zh": "我修好网上破的一角。", "en": "I mend a torn corner of my web."},
        {"zh": "蛛卵在叶下暖着。", "en": "My eggs warm beneath the leaf."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的八只眼都对着你。", "en": "All eight of my eyes are on you."},
        {"zh": "猎物靠近，准备出击。", "en": "Prey near, ready strike."},
        {"zh": "玩家进入视野，警觉。", "en": "Player seen, alert."},
        {"zh": "锁定猎物，准备跳跃。", "en": "Prey located, ready to jump."},
        {"zh": "玩家进入危险区域。", "en": "Player in danger zone."},
        {"zh": "玩家靠近，小心。", "en": "Player near, beware."},
        {"zh": "玩家出现，准备行动。", "en": "Player present, ready."},
        {"zh": "我从树冠垂下一条丝。", "en": "I lower a thread from the canopy."},
        {"zh": "玩家进入攻击范围。", "en": "Player in range, attack."},
        {"zh": "丝线一动，我就知道了。", "en": "One twitch of the silk tells me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "网被撕破了……", "en": "My web is torn..."},
        {"zh": "腿受了伤……", "en": "My leg is wounded..."},
