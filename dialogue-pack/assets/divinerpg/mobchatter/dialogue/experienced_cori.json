{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜噜，我要找你练练功！", "en": "Rumble, time to test you!"},
        {"zh": "哼，又来送死？", "en": "Hmph, here for another lesson?"},
        {"zh": "小心，我的攻击是你的噩梦！", "en": "Watch out, my attack is your nightmare!"},
        {"zh": "嘿，别跑，让我抓你！", "en": "Hey, don't run, I'll catch you!"},
        {"zh": "再来一次，这次我要杀了你！", "en": "Again, this time I'll finish you!"},
        {"zh": "哈哈，又一个可练功的！", "en": "Haha, another one for practice!"},
        {"zh": "你的力量，我来试试！", "en": "Your strength, I'll test it!"},
        {"zh": "你逃不掉的，我会抓住你！", "en": "You can't escape, I'll catch you!"},
        {"zh": "再来，再来，这次我要赢！", "en": "Again, again, this time I'll win!"},
        {"zh": "哈哈，你逃不出我的范围！", "en": "Haha, you can't escape my range!"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静候佳音，我的弟子们正在赶来。", "en": "Awaiting news, my apprentices are on their way."},
        {"zh": "这里就是我的领地，快投降吧。", "en": "This is my territory, surrender now."},
        {"zh": "我强大无比，无人能敌。", "en": "I am the strongest, none can match me."},
        {"zh": "你们来得正好，正要休息一会。", "en": "You come at the right time, I was just resting."},
        {"zh": "我在这里等你们，来挑战吧。", "en": "I'm here waiting, come and challenge me."},
        {"zh": "我是老道浮游者，来吧，看看你能如何。", "en": "I am the Experienced Cori, come, see what you're made of."},
        {"zh": "我在这里修炼，不要打扰我。", "en": "I'm meditating, don't disturb me."},
        {"zh": "我的弟子们很快就会来到这里。", "en": "My apprentices will be here soon."},
        {"zh": "闲暇时，我会这样修炼。", "en": "I meditate in my free time."},
        {"zh": "静心修炼，我的实力越来越强。", "en": "I meditate to strengthen my power."},
        {"zh": "浮在空中，缓慢地呼吸。", "en": "I hover, breathing slowly."},
        {"zh": "手臂垂着，指尖微微抽动。", "en": "My arms hang; my fingertips twitch."},
        {"zh": "我在空境的风里打坐。", "en": "I meditate in the sky-realm's wind."},
        {"zh": "身上的裂痕泛着微光。", "en": "The cracks in me glow faintly."},
        {"zh": "等待下一次召唤的时机。", "en": "I wait for the right moment to summon."},
        {"zh": "我低念着古老的咒语。", "en": "I murmur an ancient spell."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "快跑，我要抓你！", "en": "Run, I'll catch you!"},
        {"zh": "你在这里太碍眼了。", "en": "You're in my way."},
        {"zh": "快点，我需要你的鲜血。", "en": "Hurry, I need your blood."},
        {"zh": "你已经逃不出我的范围了。", "en": "You can't escape my range now."},
        {"zh": "快投降，我可以饶你不死。", "en": "Surrender, I might spare your life."},
        {"zh": "你的存在威胁到了我的修炼。", "en": "Your presence disturbs my meditation."},
        {"zh": "你离我越近，我的力量就越强。", "en": "The closer you are, the stronger I am."},
        {"zh": "你的气息刺激了我。", "en": "Your presence agitates me."},
        {"zh": "我浮着，看你先动哪只手。", "en": "I hover and watch which hand moves first."},
        {"zh": "你离我太近了，我要攻击了。", "en": "You're too close, I'll attack."},
        {"zh": "我俯视你，像看一粒尘。", "en": "I look down on you like a speck of dust."},
        {"zh": "目光落在你的武器上。", "en": "My gaze settles on your weapon."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀受损，飞行不稳。", "en": "Wings hurt, flight unstable."},
        {"zh": "受到致命伤，气息奄奄。", "en": "Severely wounded, gasping."},
        {"zh": "伤口疼痛，行动缓慢。", "en": "Wound hurts, moves slowly."},
        {"zh": "力量衰退，攻击乏力。", "en": "Strength waning, attacks weak."},
        {"zh": "身体虚弱，几乎失去知觉。", "en": "Weak, nearly unconscious."},
        {"zh": "伤口渗血，生命垂危。", "en": "Wound bleeding, close to death."},
        {"zh": "筋疲力尽，难以支撑。", "en": "Tired, hard to hold on."},
        {"zh": "伤势严重，难以战斗。", "en": "Severe injuries, hard to fight."},
        {"zh": "虚弱无比，难逃一死。", "en": "Vastly weakened, doomed."},
        {"zh": "受创严重，难以恢复。", "en": "Severely injured, hard to recover."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "诱惑你靠近，引来我的攻击！", "en": "Come closer, for my attack!"},
        {"zh": "我召来的浮游者，会先替我试你。", "en": "My summoned Coris will test you first."},
        {"zh": "你无法逃脱我的魔掌！", "en": "You can't escape my grasp!"},
        {"zh": "让你见识浮游者的强大！", "en": "See the power of the Cori!"},
        {"zh": "用你的尸体喂养我的幼子！", "en": "Feed my young with your corpse!"},
        {"zh": "你的末日来临了！", "en": "Your end is here!"},
        {"zh": "我的力量无法战胜吗？", "en": "Can my power be defeated?"},
        {"zh": "你会为同伴的到来做好准备吗？", "en": "Are you ready for your comrades?"},
        {"zh": "品尝死亡的味道！", "en": "Taste death!"},
        {"zh": "你的挣扎毫无意义！", "en": "Your struggles are meaningless!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了我的防线！", "en": "You hit my defenses!"},
        {"zh": "空境的风把我推向你。", "en": "The void's wind pushes me into you."},
        {"zh": "别想逃过我的视线！", "en": "You can't escape my sight!"},
        {"zh": "小心我的利刃！", "en": "Be careful of my blade!"},
        {"zh": "我的攻击不会失败！", "en": "My attacks will not fail!"},
        {"zh": "你撞破了我的屏障！", "en": "You broke my barrier!"},
        {"zh": "躲开我的攻击轨迹！", "en": "Avoid my attack trajectory!"},
        {"zh": "小浮游者，一个接一个出来。", "en": "Little Coris, come out one by one."},
        {"zh": "你的尝试是徒劳的！", "en": "Your attempts are in vain!"},
        {"zh": "别想靠近我的核心！", "en": "Don't get close to my core!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "空境之心在呼唤同伴。", "en": "The Heart of the Void calls my kin."},
        {"zh": "我的同类在远方！", "en": "My mate is far away!"},
        {"zh": "与我的同类共享力量！", "en": "Share power with my mate!"},
        {"zh": "我的同类已近在咫尺！", "en": "My mate is near!"},
        {"zh": "让我们一起统治这片天空！", "en": "Let's rule the sky together!"},
        {"zh": "我的同类会保护你！", "en": "My mate will protect you!"},
        {"zh": "与我的同类共享领地！", "en": "Share the territory with my mate!"},
        {"zh": "我的同类会与你同在！", "en": "My mate will be with you!"},
        {"zh": "让我的同类成为你的盟友！", "en": "Make my mate your ally!"},
        {"zh": "我的同类会守护这片天空！", "en": "My mate will guard this sky!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "空境之心碎片，小心！", "en": "Pieces of Void Heart, be cautious!"},
        {"zh": "这是岩晶盾牌。", "en": "Rock Crystal Shield."},
        {"zh": "空境突击者的灵魂，力量强大。", "en": "Souls of Void Raiders, powerful."},
        {"zh": "我体内有空境碎片。", "en": "Void Fragments within me."},
        {"zh": "空境之心，我的宝藏。", "en": "Void Heart, my treasure."},
        {"zh": "我拥有历战浮游者雕像。", "en": "Statue of War-Torn Raider."},
        {"zh": "空境碎片，来之不易。", "en": "Void Fragments, hard-won."},
        {"zh": "岩晶盾，我的守护。", "en": "Rock Crystal Shield, my protector."},
        {"zh": "我召唤更多弱小浮游者。", "en": "Summoning more weak ones."},
        {"zh": "空境之魂，我的力量。", "en": "Void Souls, my strength."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经在我视野中。", "en": "You're in my sight."},
        {"zh": "来了，弱小的玩家。", "en": "Here, little player."},
        {"zh": "弱小浮游者来了。", "en": "Weak Coris coming."},
        {"zh": "你的力量在我眼中。", "en": "Your might in my eyes."},
        {"zh": "我将碾碎你。", "en": "I will crush you."},
        {"zh": "你的勇气让我兴奋。", "en": "Your courage excites me."},
        {"zh": "我的召唤阵已经铺开。", "en": "My summoning circle is already spread."},
        {"zh": "我将享受你的战斗。", "en": "I'll enjoy your fight."},
        {"zh": "弱小浮游者，去战斗。", "en": "Weak Coris, fight."},
        {"zh": "小浮游都出来了，你数得清吗？", "en": "My little Coris are out. Can you count them?"},
        {"zh": "有生物踏进了空境。", "en": "A creature has stepped into the sky-realm."},
        {"zh": "浮游者正在围拢你。", "en": "The Coris are closing in around you."},
        {"zh": "你的呼吸惊动了浮岛。", "en": "Your breath stirs the floating isle."},
        {"zh": "我从云隙里看见你了。", "en": "I see you through a gap in the clouds."},
        {"zh": "又一个想挑战我的。", "en": "Another one comes to challenge me."},
        {"zh": "你的影子落在我脚下。", "en": "Your shadow falls beneath me."},
        {"zh": "浮游者们，看看这个。", "en": "Cori, look at this one."},
        {"zh": "我抬手，指了个方向。", "en": "I raise a hand and point the way."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我会成为你的噩梦。", "en": "I'll be your nightmare."},
        {"zh": "我将引导你走向死亡。", "en": "I'll lead you to death."},
        {"zh": "你的末日来临了。", "en": "Your end is here."},
        {"zh": "我会击败你。", "en": "I'll defeat you."},
        {"zh": "你逃不过我的攻击。", "en": "You can't escape my attack."},
        {"zh": "我会享受你的哀鸣。", "en": "I'll enjoy your wails."},
        {"zh": "我会终结你的生命。", "en": "I'll end your life."},
        {"zh": "你将沦为我的祭品。", "en": "You'll be my sacrifice."},
        {"zh": "我将让你绝望。", "en": "I'll make you despair."},
        {"zh": "你将化为尘埃。", "en": "You'll be dust."},
        {"zh": "手臂抬起，对准你。", "en": "My arm lifts and aims at you."},
        {"zh": "空境的风开始旋转。", "en": "The sky-realm's wind begins to turn."},
        {"zh": "我的指尖亮起一道光。", "en": "A light kindles at my fingertips."},
        {"zh": "孩子们，围住他。", "en": "Children, surround him."},
        {"zh": "我把你圈在浮岛中央。", "en": "I pen you in the middle of the isle."},
        {"zh": "脚下的虚空在等你。", "en": "The void below waits for you."},
        {"zh": "我慢慢逼近，不留退路。", "en": "I close in and leave you no way back."},
        {"zh": "这一击会落在你背上。", "en": "This blow will land on your back."},
        {"zh": "我的影子先罩住你。", "en": "My shadow covers you first."},
        {"zh": "倒计时在我心里走完。", "en": "The countdown in my mind runs out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶！”，以怨报怨！", "en": "Sssss! Revenge is mine!"},
        {"zh": "呼出毒云，让你痛苦！", "en": "Release poison clouds and make you suffer!"},
        {"zh": "吸走你的生命之力！", "en": "Suck out your life force!"},
        {"zh": "发出闪光警告！", "en": "Send out a warning flash!"},
        {"zh": "化为毒液攻击你！", "en": "Transform into toxic liquid to attack you!"},
        {"zh": "释放腐蚀之触！", "en": "Release corrosive touch!"},
        {"zh": "毒刺扎入你的肌肤！", "en": "Poisonous spines pierce your skin!"},
        {"zh": "挥动翅膀释放毒雾！", "en": "Wave wings to release toxic mist!"},
        {"zh": "喷射腐蚀之液！", "en": "Spray corrosive liquid!"},
        {"zh": "用毒牙咬碎你！", "en": "Use venomous fangs to crush you!"},
        {"zh": "我一掌把你推下浮岛！", "en": "One push and you're off the isle!"},
        {"zh": "指尖的光刺穿你！", "en": "The light from my fingertips pierces you!"},
        {"zh": "手臂扫过，把你掀翻！", "en": "My arm sweeps you off your feet!"},
        {"zh": "空境的碎片缠住你！", "en": "Sky-realm shards wrap around you!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶！新的猎物来了！", "en": "Sssss! New prey approaches!"},
        {"zh": "孵化小浮游者！", "en": "Hatch baby Coris!"},
        {"zh": "召唤弱小浮游者！", "en": "Summon weaker Coris!"},
        {"zh": "召唤高等浮游者！", "en": "Summon higher-level Coris!"},
        {"zh": "我在这儿守护！", "en": "I guard here!"},
        {"zh": "召唤追随者！", "en": "Call followers!"},
        {"zh": "召唤盟友！", "en": "Call allies!"},
        {"zh": "等待猎物靠近！", "en": "Wait for prey to come near!"},
        {"zh": "我是这里唯一的统治者！", "en": "I am the sole ruler here!"},
        {"zh": "守护我的领域！", "en": "Defend my domain!"},
        {"zh": "空境之心亮了起来。", "en": "The sky-realm heart begins to glow."},
        {"zh": "浮岛尽头现出我的影子。", "en": "My shape appears at the isle's edge."},
        {"zh": "云层裂开，我降临。", "en": "The clouds split and I descend."},
        {"zh": "古老咒语从虚空传来。", "en": "An old spell drifts from the void."},
        {"zh": "我的王国重新开启。", "en": "My kingdom opens once more."},
        {"zh": "雕像上的灰尘落下。", "en": "Dust slides off the statues."},
        {"zh": "空境碎片开始震颤。", "en": "The sky-realm shards start to quiver."},
        {"zh": "我从虚空的漩涡里走出。", "en": "I step out of a whirl in the void."},
        {"zh": "风暴停了一瞬，我来了。", "en": "The storm pauses, and I am here."},
        {"zh": "弱小浮游者先探出头。", "en": "A lesser cori peeks out first."}
      ]
    },
