    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，要尝尝味道？", "en": "Hisss, want to taste it?"},
        {"zh": "嘿，这是我的地盘！", "en": "Hey, this is my territory!"},
        {"zh": "这食物有点辣...", "en": "This food is a bit spicy..."},
        {"zh": "别靠近，我可不想战斗。", "en": "Stay back, I don't want to fight."},
        {"zh": "这里很适合捕猎。", "en": "Good place to hunt."},
        {"zh": "小心，我来了。", "en": "Watch out, here I come."},
        {"zh": "这里的食物很美味。", "en": "The food here tastes great."},
        {"zh": "你看起来很适合当食物。", "en": "You look like good food."},
        {"zh": "我只吃从秘界来的生物。", "en": "I only eat creatures from the Nether."},
        {"zh": "嘿，别走开，我还没吃够。", "en": "Hey, don't leave yet, I'm not done yet."},
        {"zh": "触须扫过秘界的苔藓", "en": "My tendrils brush the moss of the Secret Realm."},
        {"zh": "甲壳摩擦着石根", "en": "My shell scrapes along the stone roots."}
      ]
    },
