    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我把货背在背上，慢慢走。", "en": "My goods ride on my back as I walk."},
        {"zh": "用爪子拍打地面", "en": "Tap the ground with paws"},
        {"zh": "摇摇晃晃地走着", "en": "Shuffle along"},
        {"zh": "盯着你看了一会儿", "en": "Stare at you for a while"},
        {"zh": "嗅嗅周围的空气", "en": "Sniff the air around"},
        {"zh": "慢吞吞地走过", "en": "Move slowly by"},
        {"zh": "舔了舔嘴巴", "en": "Lick lips"},
        {"zh": "摊子摆好了，等人来换。", "en": "My stall is set; I wait for a trade."},
        {"zh": "轻声咕噜着", "en": "Murmur softly"},
        {"zh": "我闻闻你的手，有没有刷怪蛋。", "en": "I sniff your hand for a spawn egg."},
        {"zh": "踩着落叶慢慢踱步", "en": "It ambles over the fallen leaves."},
        {"zh": "把背在树上蹭两下", "en": "It rubs its back against a tree."},
        {"zh": "跟在你后面走一段", "en": "It trails a few paces behind you."},
        {"zh": "低头闻闻你留下的脚印", "en": "It sniffs at your footprints."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
