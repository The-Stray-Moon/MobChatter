        {"zh": "盯着树上的蜜蜂发呆", "en": "It stares off at the bees in the tree."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我数过你腰上的东西，能换。", "en": "I've counted what hangs at your belt; it can be traded."},
        {"zh": "让我看看你口袋里有什么。", "en": "Let me see what is in your pockets."},
        {"zh": "你要买什么？先把货拿出来。", "en": "What are you buying? Put the goods out first."},
        {"zh": "摇摇尾巴表示友好", "en": "Wag tail in greeting"},
        {"zh": "围着你看一圈", "en": "Circle around you"},
        {"zh": "好奇地走近", "en": "Curiously approach"},
        {"zh": "闻闻我，我不咬人。", "en": "Sniff me — I don't bite."},
        {"zh": "轻轻摇动身体", "en": "Gently sway body"},
        {"zh": "用鼻子触碰你", "en": "Touch you with nose"},
        {"zh": "表现出警惕", "en": "Show alertness"},
        {"zh": "抬头看你手里的东西", "en": "It looks up at what you hold."},
        {"zh": "慢慢挪到你旁边坐下", "en": "It shuffles over and sits by you."},
        {"zh": "用鼻子闻你的袖子", "en": "It sniffs at your sleeve."},
        {"zh": "它把手搭在你腿上", "en": "It rests a paw on your leg."},
        {"zh": "见你蹲下就凑过来", "en": "When you crouch, it wanders over."},
        {"zh": "它围着你嗅了一圈", "en": "It snuffles a full circle around you."},
        {"zh": "你说话时它歪着头", "en": "It tilts its head when you speak."},
        {"zh": "它记住了你的味道", "en": "It has learned your scent."},
        {"zh": "看你不走，它也留下", "en": "Seeing you stay, it stays too."},
        {"zh": "它用脑袋顶你的手", "en": "It pushes its head into your hand."}
      ]
    },
