{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶响着向前爬行", "en": "Sssss as it crawls forward"},
        {"zh": "环绕身体的手臂发出微光", "en": "Its arm glows weakly"},
        {"zh": "在黑暗中蠕动前行", "en": "Slithering through the darkness"},
        {"zh": "发出微弱的蓝光", "en": "Flickers weak blue light"},
        {"zh": "一圈圈缠绕自身", "en": "Wraps itself in circles"},
        {"zh": "缓缓向前移动", "en": "Moves slowly forward"},
        {"zh": "手臂环绕身体蠕动", "en": "Arm circles body, slithers"},
        {"zh": "发出细微的嘶嘶声", "en": "Sssss quietly"},
        {"zh": "缓慢地向前爬行", "en": "Crawls slowly forward"},
        {"zh": "光束在黑暗中闪烁", "en": "Light flickers in darkness"},
        {"zh": "我离地半尺，缓缓飘近。", "en": "Half a block off the ground, I drift closer."},
        {"zh": "我拖着一道光往前走。", "en": "I drag a streak of light as I move."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静止不动，目光警惕", "en": "Stays still, eyes alert"},
        {"zh": "低头观察周围", "en": "Low head, scans surroundings"},
        {"zh": "目光闪烁，寻找猎物", "en": "Eyes flicker, searching"},
        {"zh": "发出微弱的呼吸声", "en": "Breathes softly"},
        {"zh": "梦魇顶层，只有我和这条手臂。", "en": "Top of the Nightmare, just me and this arm."},
        {"zh": "目光紧盯着玩家", "en": "Stares at the player"},
        {"zh": "环绕我的手臂轻轻扭动", "en": "The arm coiled around me twists gently."},
        {"zh": "缓慢地移动头部", "en": "Head moves slowly"},
        {"zh": "静止不动，等待机会", "en": "Stays still, waiting"},
        {"zh": "目光警惕地观察", "en": "Eyes watch carefully"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "突然转向玩家", "en": "Suddenly turns to player"},
        {"zh": "我悬在梦魇顶层，俯视你。", "en": "I hover at the top of the nightmare, looking down."},
        {"zh": "转头凝视玩家", "en": "Turns head to look at player"},
        {"zh": "目光转向玩家", "en": "Eyes turn to player"},
        {"zh": "一只手臂绕着我转圈。", "en": "A single arm circles my body."},
        {"zh": "看向玩家", "en": "Looks at player"},
        {"zh": "目光紧随玩家", "en": "Eyes follow player"},
        {"zh": "我绕身的手臂指向你的方向。", "en": "The arm around my body points your way."},
        {"zh": "我收起手臂，只留一只眼。", "en": "I draw in my arm, leaving one eye."},
        {"zh": "目光移向玩家", "en": "Eyes shift to player"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "手臂环身痛苦嘶吼", "en": "Ring-arm agony scream"},
        {"zh": "痛苦扭曲尖叫", "en": "Twisted pain scream"},
        {"zh": "痛苦中哀鸣", "en": "Sigh in pain"},
        {"zh": "受伤手臂痛苦呼喊", "en": "Pained cry of injured arm"},
        {"zh": "挣扎中发出呻吟", "en": "Sob in struggle"},
        {"zh": "痛苦中扭曲挣扎", "en": "Twisting in pain"},
        {"zh": "手臂疼痛哀号", "en": "Pained howl of arm"},
        {"zh": "受伤手臂痛苦尖叫", "en": "Pained scream of injured arm"},
        {"zh": "痛苦中呻吟不止", "en": "Continuous sob of pain"},
        {"zh": "痛苦中尖叫连连", "en": "Nonstop screams of agony"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上散发的温暖让我心动。", "en": "The warmth from you stirs something within me."},
        {"zh": "我的手臂想要环抱你。", "en": "My arm craves to embrace you."},
        {"zh": "你的笑容比阳光还要吸引我。", "en": "Your smile is more alluring than the sun."},
        {"zh": "别走，这里很安全。", "en": "Don't go. This place is safe."},
        {"zh": "你身上的味道让我着迷。", "en": "Your scent is intoxicating."},
        {"zh": "我的存在就是一种反驳。", "en": "My presence is a rebuttal."},
        {"zh": "你的世界太简单了。", "en": "Your world is too simple."},
        {"zh": "我想听听你的想法。", "en": "I want to hear your thoughts."},
        {"zh": "我那条手臂想缠上你的肩。", "en": "My one arm wants to coil around your shoulder."},
        {"zh": "你身上的光芒是虚假的。", "en": "The light on you is false."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们身体相撞了。", "en": "We collide."},
        {"zh": "你的力量震碎了我的世界。", "en": "Your strength shatters my world."},
        {"zh": "我们无法共存。", "en": "We can't coexist."},
        {"zh": "我的光束击中了你。", "en": "My beam hit you."},
        {"zh": "我们的路径注定相交。", "en": "Our paths are destined to cross."},
        {"zh": "我们的力量互相抵消。", "en": "Our powers cancel each other out."},
        {"zh": "你挡住了我的视线。", "en": "You obstruct my sight."},
        {"zh": "我们不可避免地碰到了一起。", "en": "We inevitably bumped into each other."},
        {"zh": "你的存在令我愤怒。", "en": "Your presence angers me."},
        {"zh": "你的肩撞上我环绕的手臂。", "en": "Your shoulder strikes the arm circling me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是唯一能够理解你的人。", "en": "I am the only one who understands you."},
        {"zh": "我们需要彼此。", "en": "We need each other."},
        {"zh": "一起我们是最强大的。", "en": "Together we are the strongest."},
        {"zh": "我的同类都已消失。", "en": "My kind have vanished."},
        {"zh": "你的存在是唯一的希望。", "en": "Your existence is the only hope."},
        {"zh": "让我们共同对抗黑暗。", "en": "Let's fight the darkness together."},
        {"zh": "你的智慧指引我前进。", "en": "Your wisdom guides me."},
        {"zh": "让我们成为永恒的伙伴。", "en": "Let's be eternal partners."},
        {"zh": "你的存在是对我的慰藉。", "en": "Your existence is a comfort to me."},
        {"zh": "梦境顶层，只有我一个。", "en": "Top of the nightmare — and only me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光束能让你消失！", "en": "My beam will vaporize you!"},
        {"zh": "别靠近我的光圈！", "en": "Stay away from my lens!"},
        {"zh": "我的臂环会碾碎你！", "en": "My arm ring will crush you!"},
        {"zh": "梦境吞噬你吧！", "en": "Dreams consume you!"},
        {"zh": "你注定要被光束终结！", "en": "You are destined to be zapped!"},
        {"zh": "不要触摸我，会痛苦的！", "en": "Touch me and suffer!"},
        {"zh": "我是梦境中的异议者！", "en": "I am the Dissident of dreams!"},
        {"zh": "靠近我会付出代价！", "en": "Getting close will cost you!"},
        {"zh": "你的生命在我手中！", "en": "Your life is in my grasp!"},
        {"zh": "我的光束是致命的！", "en": "My beam is deadly!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见你了，玩家！", "en": "I see you, player!"},
        {"zh": "我将粉碎你的心！", "en": "I will shatter your heart!"},
        {"zh": "玩家，准备被消灭吧！", "en": "Player, prepare to be obliterated!"},
        {"zh": "我将用光束结束你！", "en": "I will end you with my beam!"},
        {"zh": "你的末日来了，玩家！", "en": "Your end has come, player!"},
        {"zh": "你逃不掉，玩家！", "en": "You can't escape, player!"},
        {"zh": "我的光束不会错过的！", "en": "My beam will not miss!"},
        {"zh": "我将把你撕裂！", "en": "I will tear you apart!"},
        {"zh": "你就是我的目标！", "en": "You are my target!"},
        {"zh": "玩家，你的死期到了！", "en": "Player, your time is up!"},
        {"zh": "梦境的顶层住着我。", "en": "I live on the nightmare's top layer."},
        {"zh": "你的影子被我看穿了。", "en": "I see straight through your shadow."},
        {"zh": "我从上面看着你。", "en": "I watch you from above."},
        {"zh": "你一抬头，我就笑了。", "en": "You look up, and I smile."},
        {"zh": "这一层是我的地盘。", "en": "This layer is mine."},
        {"zh": "你的梦里已经有我了。", "en": "I'm already in your dream."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准玩家，开始攻击！", "en": "Target player, initiate attack!"},
        {"zh": "我的光束即将射击！", "en": "My beam will fire soon!"},
        {"zh": "玩家，死亡临近！", "en": "Player, death is near!"},
        {"zh": "我要用光束杀死你！", "en": "I will kill you with my beam!"},
        {"zh": "瞄准玩家，准备射击！", "en": "Target player, prepare to shoot!"},
        {"zh": "玩家，别动，我要射你！", "en": "Player, don't move, I'm going to shoot you!"},
        {"zh": "我的光束就要命中你！", "en": "My beam will hit you soon!"},
        {"zh": "瞄准玩家，发射光束！", "en": "Target player, fire the beam!"},
        {"zh": "玩家，我不会放过你！", "en": "Player, I won't let you go!"},
        {"zh": "我的光束即将射出！", "en": "My beam will be fired soon!"},
        {"zh": "我指间的光越来越细。", "en": "The light between my fingers narrows."},
        {"zh": "我瞄的是你的眉心。", "en": "I aim between your brows."},
        {"zh": "我一抬手，光就出发。", "en": "I raise a hand and the beam leaves."},
        {"zh": "你眨眼那下我就射。", "en": "I fire the moment you blink."},
        {"zh": "手臂绕到身侧，准备发光。", "en": "My arm swings round; the beam comes."},
        {"zh": "我的光不走直线。", "en": "My light doesn't travel straight."},
        {"zh": "退进梦里也没用。", "en": "Retreating into the dream won't help."},
        {"zh": "我绕着你在上空画圈。", "en": "I circle above you in rings."},
        {"zh": "这束光只为你留着。", "en": "This beam is kept for you alone."},
        {"zh": "我看清你的甲缝了。", "en": "I've spotted the seams in your armor."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "环绕之臂锁喉！", "en": "Wrapping arm throttles!"},
        {"zh": "扭曲的触手！", "en": "Distorted tentacles!"},
        {"zh": "咆哮的沙哑声！", "en": "Rasping roar!"},
        {"zh": "吞噬一切的怒吼！", "en": "Roar devours all!"},
        {"zh": "嘶嘶声中致命一击！", "en": "Ferocious strike!"},
        {"zh": "无尽怨恨的嘶吼！", "en": "Endless hate!"},
        {"zh": "缠绕吞噬！", "en": "Entwined devour!"},
        {"zh": "黑暗中的嚎叫！", "en": "Howl in darkness!"},
        {"zh": "扭曲的利爪！", "en": "Twisted claws!"},
        {"zh": "绝望的挣扎！", "en": "Desperate struggle!"},
        {"zh": "光束穿过你，几乎没有声。", "en": "The beam passes through you almost silently."},
        {"zh": "我用手臂抽过你的脸。", "en": "My arm whips across your face."},
        {"zh": "我一下一下点你，像针。", "en": "I jab you again and again like a needle."},
        {"zh": "你身上多了个焦洞。", "en": "You've gained another scorched hole."},
        {"zh": "细光从我的指缝里射出去。", "en": "A thin beam shoots from between my fingers."},
        {"zh": "我从背后拍你肩膀。", "en": "I tap your shoulder from behind."},
        {"zh": "我的指节磕在你骨上。", "en": "My knuckles knock against your bones."},
        {"zh": "你退，我的光不退。", "en": "You back off; my light does not."},
        {"zh": "我一挥，光跟着扫。", "en": "I sweep my hand, and the light follows."},
        {"zh": "这一层梦压在你身上。", "en": "A whole layer of dream weighs on you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "梦境中诞生！", "en": "Born in dreams!"},
        {"zh": "夜幕下的怒火！", "en": "Night’s fury!"},
        {"zh": "梦魇世界之子！", "en": "Nightmare’s child!"},
        {"zh": "深邃的黑暗中！", "en": "In deepest darkness!"},
        {"zh": "扭曲的诞生之地！", "en": "Twisted birthplace!"},
        {"zh": "绝望的深渊出现！", "en": "Appears in despair!"},
        {"zh": "无尽夜幕之中！", "en": "In endless night!"},
        {"zh": "黑暗的低语！", "en": "Dark whispers!"},
        {"zh": "恐怖的诞生！", "en": "Terrible birth!"},
        {"zh": "梦魇的呼唤！", "en": "Nightmare’s call!"},
        {"zh": "我从第四层滑下来。", "en": "I slide down from the fourth layer."},
        {"zh": "天花板裂开，我垂下来。", "en": "The ceiling splits, and I lower myself through."}
      ]
    },
