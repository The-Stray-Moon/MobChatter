    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，皮肤闪烁着微光。", "en": "Sssss, skin glows faintly."},
        {"zh": "粗壮的蹄子踏过岩浆地面。", "en": "Heavy hooves step on lava."},
        {"zh": "盯着你，红眼中燃烧着火焰。", "en": "Red eyes burn with fire, staring at you."},
        {"zh": "嘶嘶，红热的皮肤令人恐惧。", "en": "Sssss, red-hot skin is terrifying."},
        {"zh": "嘶嘶，发出金属般的声响。", "en": "Sssss, metallic sound."},
        {"zh": "嘶嘶，皮肤似乎在呼吸。", "en": "Sssss, skin seems to breathe."},
        {"zh": "嘶嘶，皮肤覆盖着岩浆。", "en": "Sssss, skin covered with lava."},
        {"zh": "嘶嘶，像铁一样坚硬。", "en": "Sssss, as hard as iron."},
        {"zh": "嘶嘶，像熔岩一样滚烫。", "en": "Sssss, as hot as lava."},
        {"zh": "嘶嘶，皮肤下的肌肉跳动。", "en": "Sssss, muscles beneath skin twitch."},
        {"zh": "蹄子把岩浆踩出涟漪", "en": "Its hooves ripple the lava"},
        {"zh": "通红的皮在热风里起伏", "en": "Its red hide heaves in the hot wind"}
      ]
    },
