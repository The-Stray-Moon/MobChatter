      "lines": [
        {"zh": "南瓜南瓜，走起来！", "en": "Pumpkin, pumpkin, walk!"},
        {"zh": "嘿，找点乐子吧！", "en": "Hey, find some fun!"},
        {"zh": "南瓜南瓜，快走！", "en": "Pumpkin, pumpkin, walk fast!"},
        {"zh": "我需要更多的南瓜！", "en": "More pumpkins, I need!"},
        {"zh": "注意，注意，南瓜人来了！", "en": "Watch out, Jack o’Man!"},
        {"zh": "南瓜南瓜，快跟我来！", "en": "Pumpkin, follow me!"},
        {"zh": "南瓜南瓜，享受夜晚！", "en": "Pumpkin, enjoy the night!"},
        {"zh": "夜里的南瓜灯亮了。", "en": "The pumpkin lanterns lit for the night."},
        {"zh": "南瓜南瓜，一起狂欢！", "en": "Pumpkin, let’s party!"},
        {"zh": "南瓜灯在手里晃来晃去。", "en": "The jack-o'-lantern swings in my hand."},
