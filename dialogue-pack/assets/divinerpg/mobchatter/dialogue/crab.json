    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轻盈地在沙滩上移动", "en": "Scuttles gracefully on the sand"},
        {"zh": "缓缓移动到更深处", "en": "Slowly moves deeper into the water"},
        {"zh": "寻找食物的小螃蟹", "en": "A tiny crab searching for food"},
        {"zh": "沿着沙滩爬行", "en": "Crawls along the sand"},
        {"zh": "慢慢地移动到礁石旁", "en": "Slowly moves to the rocks"},
        {"zh": "在沙堆间穿梭", "en": "Scuttles through the sand dunes"},
        {"zh": "在水中前进", "en": "Advances through the water"},
        {"zh": "在沙滩上寻找螺蛳壳", "en": "Scours the sand for seashells"},
