    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "梦魇第二层，我在这儿等你。", "en": "Nightmare layer two — I've been waiting here."},
        {"zh": "这里的食物很诱人。", "en": "The food here is tempting."},
        {"zh": "我能感受到你的温暖。", "en": "I sense the warmth in you."},
        {"zh": "我想试试你的果实。", "en": "I want to try your fruit."},
        {"zh": "你身上的魔法吸引着我。", "en": "The magic on you draws me."},
        {"zh": "森林深处有更多食物。", "en": "More food in the deep forest."},
        {"zh": "夜晚的露水很甜美。", "en": "The dew at night is sweet."},
        {"zh": "树叶和果实是我的食物。", "en": "Leaves and fruits are my food."},
        {"zh": "这里安静，很适合觅食。", "en": "Quiet here, good for foraging."},
        {"zh": "我看到你身上有宝物。", "en": "I see treasures on you."},
        {"zh": "你身上的绿意很浓", "en": "The green on you is strong"},
        {"zh": "走近一步，我给你看样东西", "en": "One step closer. I'll show you something"},
        {"zh": "这片苔原的露水归我", "en": "The dew on this tundra is mine"},
        {"zh": "你带着梦魇的味道", "en": "You carry the smell of nightmare"},
        {"zh": "别摘那朵发光的花", "en": "Don't pick that glowing flower"},
        {"zh": "跟我来，就一小段路", "en": "Follow me. Just a short way"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "让开，我要回我的雾里。", "en": "Step aside; I'm returning to my fog."},
        {"zh": "别碰我，绿袍会缠住你。", "en": "Don't touch me; my green robe will coil around you."},
        {"zh": "你不是我的同类。", "en": "You're not like me."},
        {"zh": "我不想和你战斗。", "en": "I don't want to fight you."},
        {"zh": "我们之间的距离太近了。", "en": "Too close for comfort."},
        {"zh": "我需要更多的空间。", "en": "I need more space."},
        {"zh": "这层梦的雾，只认得我。", "en": "The fog of this dream layer knows only me."},
        {"zh": "请给我一点空间。", "en": "Give me some space."},
        {"zh": "我警告你退后。", "en": "I warn you to back off."},
        {"zh": "我们之间的距离不合适。", "en": "The distance between us is wrong."}
      ]
    },
    "mate": {
