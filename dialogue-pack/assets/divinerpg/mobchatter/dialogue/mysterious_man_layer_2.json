  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "轻轻地飘过草地", "en": "Float silently over the grass"},
        {"zh": "低语着穿越森林", "en": "Murmur through the forest"},
        {"zh": "飘过潺潺的小溪", "en": "Glide over a babbling brook"},
        {"zh": "在夜色中穿梭", "en": "Move through the night"},
        {"zh": "轻盈地走过苔原", "en": "Skim across the tundra"},
        {"zh": "飘过幽暗的洞穴", "en": "Pass through dark caves"},
        {"zh": "飘过繁星点点的天空", "en": "Float through the starry sky"},
        {"zh": "从幽暗中缓缓现身", "en": "Emerge from the shadows"},
        {"zh": "在月光下缓缓行走", "en": "Walk in the moonlight"},
        {"zh": "在夜风中轻盈飞行", "en": "Fly lightly in the night wind"},
        {"zh": "绿袍擦过石碑的边", "en": "My green robe brushes the gravestone"},
        {"zh": "踩着苔藓走过石桥", "en": "I cross the stone bridge over moss"},
        {"zh": "步子很轻，像在飘", "en": "My steps are light, almost floating"},
        {"zh": "绕开地上的裂缝", "en": "I step around the cracks"},
        {"zh": "背影在雾里淡下去", "en": "My back fades into the mist"},
        {"zh": "沿着石阶往下走", "en": "I follow the stairs down"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静地立在石碑旁", "en": "Stand quietly by a stone"},
        {"zh": "凝视着远方的星空", "en": "Gaze at the distant stars"},
        {"zh": "静静地在草丛中", "en": "Remain still in the grass"},
        {"zh": "静静飘浮在空气之中", "en": "Float silently in the air"},
        {"zh": "在石缝中沉思", "en": "Meditate in a crack of stone"},
        {"zh": "静静地躺在苔原上", "en": "Lie quietly on the tundra"},
        {"zh": "飘浮在梦境边缘", "en": "Hover at the edge of dreams"},
        {"zh": "静静飘过幽暗之地", "en": "Pass quietly through the dark lands"},
        {"zh": "在星空下静立", "en": "Stand quietly under the stars"},
        {"zh": "在梦境中飘荡", "en": "Drift in the dreamscape"},
        {"zh": "把兜帽往下拉了拉", "en": "I pull my hood a little lower"},
        {"zh": "手指在石壁上画圈", "en": "A finger circles on the stone wall"},
        {"zh": "侧耳听着远处的回声", "en": "I tilt an ear to distant echoes"},
        {"zh": "一动不动，像绿雕像", "en": "Still as a green statue"},
        {"zh": "在暗处慢慢呼吸", "en": "Breathing slowly in the dark"},
        {"zh": "抬头看没有星星的天", "en": "I look up at a starless sky"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "突然注意到了你", "en": "Noticing you suddenly"},
        {"zh": "盯着你看了很久", "en": "Staring at you for a long time"},
        {"zh": "发现了你，慢慢靠近", "en": "Found you, slowly approaching"},
        {"zh": "注视着你的每一个动作", "en": "Watching every move you make"},
        {"zh": "兜帽下，我的绿眼眨了一下。", "en": "Under my hood, my green eye blinks once."},
        {"zh": "盯着你，似乎有所发现", "en": "Staring, as if discovering something"},
        {"zh": "注视着你，似乎在思考", "en": "Staring, as if in thought"},
        {"zh": "观察着你的每一个表情", "en": "Observing every expression you make"},
        {"zh": "盯着你看，似乎在等待", "en": "Staring at you, as if waiting"},
        {"zh": "突然注视着你，然后消失", "en": "Suddenly staring at you, then vanishing"},
        {"zh": "兜帽下露出一只眼", "en": "One eye shows under my hood"},
        {"zh": "我看你，不说话", "en": "I look at you and say nothing"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "绿色身躯摇晃不止", "en": "Shaking green body"},
        {"zh": "虚弱叫声回荡", "en": "Weak cry echoes"},
