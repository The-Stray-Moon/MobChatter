{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "太阳光芒闪耀，穿透阴霾。", "en": "Sunlight pierces the gloom."},
        {"zh": "箭矢闪耀，直指猎物。", "en": "Arrows gleam, targeting prey."},
        {"zh": "天空为我指引方向。", "en": "The sky guides my path."},
        {"zh": "射箭，射向敌人。", "en": "Shoot, target the foe."},
        {"zh": "日光中穿梭，无畏前行。", "en": "I move through sunlight fearlessly."},
        {"zh": "太阳是我不灭的火焰。", "en": "The sun is my unending flame."},
        {"zh": "寻找遮蔽，躲避强光。", "en": "Seek shade from the harsh light."},
        {"zh": "强光下，我更强大。", "en": "Stronger in the sun's light."},
        {"zh": "日光中寻找猎物。", "en": "I hunt in the sun's rays."},
        {"zh": "阳光下，我更清晰。", "en": "Clearer under the sun."},
        {"zh": "箭囊轻晃，走过光地。", "en": "Quiver swaying over the bright ground."},
        {"zh": "足尖点着伊甸的草。", "en": "Toes brushing Eden's grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静候时机，一箭双雕。", "en": "Wait for my perfect shot."},
        {"zh": "等待日光中的猎物。", "en": "Aim in the sunlight."},
        {"zh": "耐心等待，静观其变。", "en": "I wait with patience."},
        {"zh": "日光下的影子游戏。", "en": "Games of shadows in the sun."},
        {"zh": "享受这温暖的日光。", "en": "Basking in the sunlight."},
        {"zh": "日光中，我隐身于其中。", "en": "I blend into the sunlight."},
        {"zh": "在光中，我更加警觉。", "en": "More vigilant in the light."},
        {"zh": "日光下的冷静等待。", "en": "Cool in the waiting sun."},
        {"zh": "耐心，猎物近在咫尺。", "en": "Patience, the prey is near."},
        {"zh": "日光中，我如影随形。", "en": "I follow in the light."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "锁定玩家，一箭射穿。", "en": "Target the player, one shot."},
        {"zh": "玩家，我的下一个目标。", "en": "Player, my next target."},
        {"zh": "瞄准玩家，箭在弦上。", "en": "Focus on the player, arrow in place."},
        {"zh": "玩家，你的命运在此。", "en": "Player, your fate is here."},
        {"zh": "锁定玩家，一箭毙命。", "en": "Target the player, lethal shot."},
        {"zh": "玩家，你逃不掉的。", "en": "Player, you can't escape."},
        {"zh": "玩家，我的箭矢已上弦。", "en": "Player, my arrow is drawn."},
        {"zh": "玩家，你将落入我的陷阱。", "en": "Player, you fall into my trap."},
        {"zh": "玩家，你已是我的猎物。", "en": "Player, you are my prey."},
        {"zh": "玩家，你的命不久矣。", "en": "Player, your time is up."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "箭矢穿透我的身躯！", "en": "The arrow pierces me!"},
        {"zh": "力量肉救不了我了。", "en": "The strength meat can't save me."},
        {"zh": "这箭矢好疼！", "en": "This arrow hurts!"},
        {"zh": "我被射中了！", "en": "I got shot!"},
        {"zh": "力量肉吃不了这一箭。", "en": "The strength meat can't stop this."},
        {"zh": "力量肉无法治疗我的伤。", "en": "The strength meat can't heal me."},
        {"zh": "我被射穿了！", "en": "I got arrowed!"},
        {"zh": "这箭矢好厉害！", "en": "Such a powerful arrow!"},
        {"zh": "力量肉没用！", "en": "The strength meat doesn't help!"},
        {"zh": "我受箭矢伤害！", "en": "I'm hurt by the arrow!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你的食物看起来真美味！", "en": "Your food looks so delicious!"},
        {"zh": "你似乎很感兴趣！", "en": "You seem very interested!"},
        {"zh": "加入我们吧，会很有趣的！", "en": "Join us, it will be fun!"},
        {"zh": "一起享受阳光吧！", "en": "Enjoy the sun with us!"},
        {"zh": "不要抵抗，我会让你更强大！", "en": "Don't resist, I'll make you stronger!"},
        {"zh": "来吧，让我们一起战斗！", "en": "Come on, let's fight together!"},
        {"zh": "和我们一起生活吧！", "en": "Live with us!"},
        {"zh": "我感受到了你的好奇心！", "en": "I can feel your curiosity!"},
        {"zh": "你愿意成为我们的同伴吗？", "en": "Would you like to be our companion?"},
        {"zh": "阳光下你看起来很健康！", "en": "You look healthy in the sunlight!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "让我们展开一场对决！", "en": "Let's have a showdown!"},
        {"zh": "你站在射线上，我推了你一把。", "en": "You stand in my line of fire; I shove you aside."},
        {"zh": "你试图攻击我？", "en": "You're trying to attack me?"},
        {"zh": "小心我的箭矢！", "en": "Watch out for my arrows!"},
        {"zh": "别想贴上来，我的弓还拉得开。", "en": "Don't try to close in; I can still draw my bow."},
        {"zh": "准备迎接我的攻击吧！", "en": "Prepare for my attack!"},
        {"zh": "你阻挡了我的视线！", "en": "You're blocking my view!"},
        {"zh": "你无法阻止我！", "en": "You can't stop me!"},
        {"zh": "让我的箭矢射穿你！", "en": "Let my arrows pierce you!"},
        {"zh": "太阳下我的箭，不看距离。", "en": "Under this sun, my arrows do not care about range."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们应当在一起！", "en": "We should be together!"},
        {"zh": "你愿意成为我的同伴吗？", "en": "Would you like to be my companion?"},
        {"zh": "让我们共同面对敌人！", "en": "Let's face enemies together!"},
        {"zh": "我的箭都朝着太阳飞。", "en": "Every arrow of mine flies toward the sun."},
        {"zh": "你是最完美的伴侣！", "en": "You're the perfect partner!"},
        {"zh": "我们相互保护！", "en": "We protect each other!"},
        {"zh": "让我们携手前进！", "en": "Let's move forward together!"},
        {"zh": "一起战斗，直到胜利！", "en": "Fight until victory together!"},
        {"zh": "你愿意与我共享天空吗？", "en": "Would you share the sky with me?"},
        {"zh": "我们的力量会更强！", "en": "Our strength will be greater!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我从地里冒出个半熟的肉！", "en": "Raw meat pops out of the ground!"},
        {"zh": "这片土地蕴含着能量！", "en": "This land holds power!"},
        {"zh": "我找到了力量之源！", "en": "I found the power source!"},
        {"zh": "力量肉！力量肉！", "en": "Raw meat! Raw meat!"},
        {"zh": "我的力量来自这里！", "en": "My power comes from here!"},
        {"zh": "半熟的肉，属于我！", "en": "The raw meat is mine!"},
        {"zh": "这里埋藏着力量！", "en": "Power lies here!"},
        {"zh": "力量肉，我的战利品！", "en": "Raw meat, my trophy!"},
        {"zh": "力量肉，我之食粮！", "en": "Raw meat, my sustenance!"},
        {"zh": "力量肉，我的补给！", "en": "Raw meat, my supply!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "捕捉到猎物了！", "en": "Target acquired!"},
        {"zh": "搭箭，拉弦，我等你再动一下。", "en": "Arrow nocked, string drawn; I wait for you to move again."},
        {"zh": "伊甸的光，替我校准。", "en": "Eden's light sights the bow for me."},
        {"zh": "目标锁定，一箭双穿！", "en": "Target locked, double pierce!"},
        {"zh": "锁定目标，一箭射穿！", "en": "Target locked, single shot!"},
        {"zh": "伊甸的日光把我的箭照得发白。", "en": "Eden's sunlight bleaches my arrow white."},
        {"zh": "锁定目标，箭在弦上！", "en": "Target locked, arrow drawn!"},
        {"zh": "锁定目标，箭在弦上，准备射击！", "en": "Target locked, arrow drawn, ready to shoot!"},
        {"zh": "锁定目标，一箭中的！", "en": "Target locked, one-shot kill!"},
        {"zh": "锁定目标，一箭双穿！", "en": "Target locked, double-pierce shot!"},
        {"zh": "光里有影子在动。", "en": "A shadow moves in the light."},
        {"zh": "弓已抬起，别动。", "en": "Bow raised. Hold still."},
        {"zh": "伊甸不收留外人。", "en": "Eden keeps no outsiders."},
        {"zh": "我箭囊里还满着。", "en": "My quiver is still full."},
        {"zh": "这一带的光，归我看。", "en": "This light is mine to watch."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "锁定目标，箭在弦上", "en": "Targeting, arrow drawn!"},
        {"zh": "瞄准，准备射击！", "en": "Aiming, ready to shoot!"},
        {"zh": "锁定目标，射杀！", "en": "Targeting, kill!"},
        {"zh": "箭尖跟着你的胸口，一直没偏。", "en": "My arrowhead tracks your chest without wavering."},
        {"zh": "锁定目标，射杀之箭！", "en": "Targeting, killing arrow!"},
        {"zh": "锁定目标，射穿之箭！", "en": "Targeting, piercing arrow!"},
        {"zh": "锁定目标，箭在弦上，射杀！", "en": "Targeting, arrow drawn, kill!"},
        {"zh": "锁定目标，箭在弦上，准备射击", "en": "Targeting, arrow drawn, ready to shoot!"},
        {"zh": "拉满弦，别再走。", "en": "Full draw. Don't take another step."},
        {"zh": "我不怕你靠近。", "en": "I don't fear you closing in."},
        {"zh": "远近对我都一样准。", "en": "Distance means nothing to me."},
        {"zh": "箭尖对着你的咽喉。", "en": "The arrowhead points at your throat."},
        {"zh": "光站在我这一边。", "en": "The light stands with me."},
        {"zh": "你身后那棵树，我数过了。", "en": "I've counted the tree behind you."},
        {"zh": "松手，就结束了。", "en": "I release, and it ends."},
        {"zh": "风停了，箭更稳。", "en": "The wind died. My shot steadies."},
        {"zh": "我的弓弦只松一次。", "en": "I get one shot."},
        {"zh": "别指望躲到光暗处。", "en": "Don't hope to hide in the shade."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "射箭射击！", "en": "Arrow shot!"},
        {"zh": "力量肉，我的战利品", "en": "Strength meat, my trophy! — 太阳弓箭手, melee attack"},
        {"zh": "阳光中穿梭！", "en": "Dart through the sun!"},
        {"zh": "力量之源！", "en": "Source of strength!"},
        {"zh": "射中目标！", "en": "Hit the target!"},
        {"zh": "弓弦震颤！", "en": "Bowstring trembles!"},
        {"zh": "力量的火焰！", "en": "Flame of strength!"},
        {"zh": "力量之箭！", "en": "Strength arrow!"},
        {"zh": "一箭穿肩，站住！", "en": "An arrow through the shoulder. Stand!"},
        {"zh": "箭羽还在你身上颤！", "en": "The fletching still quivers in you!"},
        {"zh": "再来一箭，别躲！", "en": "Another arrow. Don't dodge!"},
        {"zh": "我在光里换位！", "en": "I shift position in the light!"},
        {"zh": "箭囊还没空呢！", "en": "My quiver isn't empty!"},
        {"zh": "松弦的声，你听见了！", "en": "You heard the string release!"},
        {"zh": "这一箭，日光加成！", "en": "This arrow carries the sun!"},
        {"zh": "箭尖晒得发烫！", "en": "The arrowhead is hot from the sun!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "从光芒中诞生！", "en": "Born from light!"},
        {"zh": "光之子降临！", "en": "Son of light descends!"},
        {"zh": "伊甸的卫士！", "en": "Guardian of Eden!"},
        {"zh": "光之弓手！", "en": "Arrow of light!"},
        {"zh": "来自太阳的召唤！", "en": "Call from the sun!"},
        {"zh": "光芒中的守护！", "en": "Guard in the light!"},
        {"zh": "圣光指引！", "en": "Guided by holy light!"},
        {"zh": "从光辉中降临！", "en": "Descend from the glow!"},
        {"zh": "光明的使者！", "en": "Messenger of light!"},
        {"zh": "光之勇士！", "en": "Hero of light!"},
        {"zh": "光聚成弦，我来了。", "en": "Light gathers into a string, and I arrive."},
        {"zh": "伊甸的晨光里起身。", "en": "Rising in Eden's morning light."},
        {"zh": "弓身晒得发亮。", "en": "My bow gleams in the sun."},
        {"zh": "我在这儿守着光。", "en": "I stand guard over the light here."}
      ]
    },
