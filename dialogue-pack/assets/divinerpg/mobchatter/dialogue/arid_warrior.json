    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "沙尘漫天，锋利之刃划破空气。", "en": "Sandstorm slashes the air with sharp blades."},
        {"zh": "沙漠烈日下，我挥舞着利剑。", "en": "In the desert sun, I wield my sharp sword."},
        {"zh": "箭矢呼啸，干涸的土地上回响。", "en": "Arrows whiz by, echoing in the dry land."},
        {"zh": "高速奔跑，沙粒扬起。", "en": "Run fast, sand grains flying up."},
        {"zh": "挥剑如闪电，沙漠中的敌人颤抖。", "en": "Swing the sword like lightning, desert enemies tremble."},
        {"zh": "射出一箭，沙漠静默。", "en": "Release an arrow, the desert goes silent."},
        {"zh": "脚步声回荡在无尽的沙漠中。", "en": "Footsteps echo in the endless desert."},
        {"zh": "沙漠烈风中，我奔跑不停。", "en": "Run nonstop in the desert gales."},
        {"zh": "沙粒刺痛我的皮肤，我更快了。", "en": "Sand stings my skin, I run faster."},
        {"zh": "沙漠之魂，以箭矢为伴。", "en": "Desert spirit, arrows by my side."},
        {"zh": "赤脚踩过滚烫的沙丘", "en": "Bare feet cross the scalding dunes."},
        {"zh": "弓弦轻响，跟着我走", "en": "The bowstring whispers as I walk."}
      ]
    },
