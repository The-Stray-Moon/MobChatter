    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰舔舐着我的皮肤。", "en": "Fire licks at my skin."},
        {"zh": "我的力量正在消散。", "en": "My strength fades."},
        {"zh": "我感到虚弱。", "en": "I feel weak."},
        {"zh": "疼痛贯穿我的身体。", "en": "Pain sears through me."},
        {"zh": "我几乎支撑不住。", "en": "I barely hold on."},
        {"zh": "我的火焰开始减弱。", "en": "My flames weaken."},
        {"zh": "我的生命之火在燃烧。", "en": "My life flame burns."},
        {"zh": "我快要熄灭了。", "en": "I am nearly extinguished."},
        {"zh": "我的热度正在一点点退去。", "en": "My heat is ebbing away, bit by bit."},
        {"zh": "光暗下去了，我撑不住。", "en": "My light is dimming. I can't hold on."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰炙热，引你走向毁灭。", "en": "Fire burns, drawing you to destruction."},
        {"zh": "闪亮珍珠，诱人一试。", "en": "Shiny pearls, tempting you to try."},
        {"zh": "栖息岩浆洞，贪婪吞噬。", "en": "Lurks in lava caves, greedily devouring."},
        {"zh": "你陷入我的火焰陷阱。", "en": "You fall into my fiery trap."},
        {"zh": "燃烧吧，愚者！", "en": "Burn, fool!"},
        {"zh": "火光闪烁，引你近。", "en": "Flames flicker, drawing you near."},
        {"zh": "我的力量能熔化一切。", "en": "My strength can melt anything."},
        {"zh": "靠近我，你会后悔。", "en": "Come closer, and you’ll regret it."},
        {"zh": "灼热的呼吸，致命诱惑。", "en": "Breathe hot death,致命诱惑."},
        {"zh": "闪亮珍珠，愿你带走。", "en": "Shiny pearls, may you take them."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击，粉碎你的防御。", "en": "Impact, shattering your defense."},
        {"zh": "岩石撞上岩浆，炽烈爆炸。", "en": "Rock meets lava, explosive heat."},
        {"zh": "你被击退，痛苦不堪。", "en": "You are pushed back, in pain."},
        {"zh": "轰然巨响，震裂大地。", "en": "Thunderous crash, cracking the ground."},
        {"zh": "炽热之影，吞噬一切。", "en": "Fiery shadow, consuming all."},
        {"zh": "岩浆喷涌，你无处可逃。", "en": "Lava bursts, nowhere to run."},
        {"zh": "燃烧的触角，狠狠撞击。", "en": "Burning tentacles, collide harshly."},
        {"zh": "岩石被烧熔，轰然倒塌。", "en": "Rock melts, crashing down."},
        {"zh": "火焰撕裂，你无法抵挡。", "en": "Fire tears, you can't resist."},
        {"zh": "岩浆洪流，吞噬一切。", "en": "Lava flood, consuming all."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "岩浆中的伙伴，共享炽热。", "en": "Mate in lava, share the heat."},
        {"zh": "熔岩之心，永不分离。", "en": "Lava heart, never apart."},
        {"zh": "岩浆舞者，共舞火焰。", "en": "Dance in lava, flames together."},
        {"zh": "炽热拥抱，永恒伴侣。", "en": "Hot embrace, eternal partner."},
