    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "炙热之躯，燃烧前行。", "en": "Burning body, moving forward."},
        {"zh": "阳光烈焰，步履不停。", "en": "Sun's fiery step, never stopping."},
        {"zh": "炽热之翼，扇动怒火。", "en": "Fiery wings, fanning rage."},
        {"zh": "炙烤大地，步步生烟。", "en": "Burning the earth, smoke behind."},
        {"zh": "烈焰之魂，行走于此。", "en": "Spirit of flames, walking here."},
        {"zh": "灼热之气，化为步伐。", "en": "Scorching breath, becoming steps."},
        {"zh": "高温席卷，炎阳行进。", "en": "High heat, Helio advances."},
        {"zh": "阳光之怒，燃烧自我。", "en": "Sun's anger, burning self."},
        {"zh": "炎阳怪，燃烧之路。", "en": "Helio, burning path."},
        {"zh": "炙热之躯，逼近危险。", "en": "Burning body, nearing danger."},
        {"zh": "我走过的地方，地面还在冒烟。", "en": "The ground still smokes where I have walked."},
        {"zh": "每一步都把碎石烤成红色。", "en": "Each step bakes the gravel red."}
      ]
    },
