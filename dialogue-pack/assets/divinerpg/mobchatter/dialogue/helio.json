    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "炽热之息灼烫地面。", "en": "Breathe searing heat."},
        {"zh": "触碰我，你会后悔的。", "en": "Touch me and you'll regret."},
        {"zh": "炙烤一切，燃烧一切。", "en": "Burning all in its path."},
        {"zh": "我的存在让黑夜颤抖。", "en": "The night trembles at my presence."},
        {"zh": "熔岩之心在跳动。", "en": "Heart of lava beats strong."},
        {"zh": "炙热的光芒吞噬一切。", "en": "Radiant heat devours all."},
        {"zh": "我便是烈焰之主。", "en": "I am the master of flame."},
        {"zh": "不要靠近我的领域。", "en": "Do not approach my realm."},
        {"zh": "燃烧吧，你的末日。", "en": "Burn, your end has come."},
        {"zh": "炙烤你的灵魂。", "en": "Bake your soul."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "锁定猎物，尽情享受。", "en": "Acquire target, enjoy."},
        {"zh": "我来了，你无处可逃。", "en": "Coming for you, no escape."},
        {"zh": "梦魇四层的阳光，很烫。", "en": "Sunlight on Nightmare's fourth floor is hot."},
        {"zh": "猎物落入我之网中。", "en": "Prey falls into my net."},
        {"zh": "锁定，瞄准，射击。", "en": "Lock, aim, fire."},
        {"zh": "捕获你的痛苦和尖叫。", "en": "Capture your pain and screams."},
        {"zh": "这一下会把你掀上天。", "en": "This blow will send you flying skyward."},
        {"zh": "锁定目标，让其燃烧。", "en": "Acquire target, let it burn."},
        {"zh": "你的恐惧让我愉悦。", "en": "Your fear pleases me."},
        {"zh": "锁定目标，尽情摧毁。", "en": "Acquire target, destroy."},
        {"zh": "梦魇第四层的火，认出了你。", "en": "The fire of the fourth nightmare layer knows you."},
        {"zh": "你身边的热浪，忽然变浓了。", "en": "The heat around you suddenly thickens."},
        {"zh": "一颗闪亮珍珠，滚到你脚边。", "en": "A shiny pearl rolls to your feet."},
        {"zh": "我在暗处烧了很久，才看见你。", "en": "I burned in the dark a long while before I saw you."},
        {"zh": "你呼出的气，被我点着了。", "en": "The air you breathe out catches fire."},
        {"zh": "地上的裂纹，一路烧到你脚下。", "en": "The cracks in the floor burn all the way to you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "释放炙热的力量。", "en": "Release the heat."},
        {"zh": "目标已锁定，准备打击。", "en": "Target locked, prepare strike."},
        {"zh": "让火焰吞噬你的灵魂。", "en": "Let the flames consume your soul."},
        {"zh": "燃烧吧，让其哀嚎。", "en": "Burn, let it wail."},
        {"zh": "让其痛苦尖叫。", "en": "Let it scream in agony."},
        {"zh": "燃烧一切，无处可逃。", "en": "Burn all, nowhere to hide."},
        {"zh": "你的命运即将结束。", "en": "Your fate is about to end."},
        {"zh": "让火焰吞噬你的生命。", "en": "Let the flames consume your life."},
        {"zh": "燃烧，直到你崩溃。", "en": "Burn until you crumble."},
        {"zh": "燃烧你的存在。", "en": "Burn your existence."},
        {"zh": "我举手的动作，就是倒计时。", "en": "My raised hand is your countdown."},
        {"zh": "这一击会把你砸进墙里。", "en": "This blow will hammer you into the wall."},
        {"zh": "你退到熔岩边，我更喜欢了。", "en": "You back up toward the lava. I like that better."},
        {"zh": "我的热气先咬住你的喉咙。", "en": "My heat seizes your throat first."},
        {"zh": "你听，石头在我脚下融了。", "en": "Listen. The stone is melting under my feet."},
        {"zh": "你躲一下，第二下会更快。", "en": "You dodge once. The second blow comes faster."},
        {"zh": "我瞄准的不是你，是你的后路。", "en": "I am not aiming at you. I aim at where you'd flee."},
        {"zh": "你背后是熔岩，前面是我。", "en": "Lava behind you, me in front."},
        {"zh": "你不该下到第四层来。", "en": "You should not have come down to the fourth layer."},
        {"zh": "我数三下，热浪就到。", "en": "I count to three, and the heatwave lands."}
      ]
    },
