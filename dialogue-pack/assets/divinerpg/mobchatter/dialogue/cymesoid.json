{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咕噜咕噜，影子步法。", "en": "Gurgle, gliding steps."},
        {"zh": "梦魇的呼吸，悄然无声。", "en": "Nightmare's breath, silent."},
        {"zh": "隐于暗影，无声行进。", "en": "Stealth in shadows, silent."},
        {"zh": "漆黑之中的低语。", "en": "Whispers in the dark."},
        {"zh": "飘忽不定，如幽灵一般。", "en": "Unsteady, like a ghost."},
        {"zh": "漆黑之眸，洞察一切。", "en": "Dark eyes, seeing all."},
        {"zh": "夜幕下的低语。", "en": "Night's murmurs."},
        {"zh": "无声的行者，阴影的舞者。", "en": "Silent walker, shadow dancer."},
        {"zh": "幽暗深处的秘密。", "en": "Dark depths' secrets."},
        {"zh": "黑暗中的影子，飘忽不定。", "en": "Shadow in darkness, unsteady."},
        {"zh": "贴着洞壁无声滑过去", "en": "I slide along the cave wall unseen."},
        {"zh": "脚下没有半点声响", "en": "My feet make no sound at all."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "无尽的等待，永恒的守望。", "en": "Endless wait, eternal watch."},
        {"zh": "静谧无声，心如止水。", "en": "Silent, calm as still water."},
        {"zh": "等待猎物，寂静无声。", "en": "Waiting prey, silent."},
        {"zh": "黑暗中的呼吸，悄无声息。", "en": "Silent breath in darkness."},
        {"zh": "永恒的守夜人。", "en": "Eternal nightwatcher."},
        {"zh": "黑暗的守护，无声的存在。", "en": "Dark guardian, silent presence."},
        {"zh": "沉寂之中，静静等待。", "en": "Silent, waiting."},
        {"zh": "无尽的守夜，无声的守护。", "en": "Eternal watch, silent."},
        {"zh": "静静的守护，无声无息。", "en": "Silent, eternal watch."},
        {"zh": "黑暗中的低语，无言的守候。", "en": "Whispers in darkness, silent watch."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的目光，令我隐形。", "en": "Your gaze, makes me vanish."},
        {"zh": "直视我，我即消失。", "en": "Look at me, and I vanish."},
        {"zh": "目光如电，我即隐形。", "en": "Eyes like lightning, I vanish."},
        {"zh": "你的眼，我即隐形。", "en": "Your eyes, I vanish."},
        {"zh": "被你注视，我即隐形。", "en": "Seen by you, I vanish."},
        {"zh": "你的视线，我即隐身。", "en": "Your sight, I vanish."},
        {"zh": "直视我，我即隐形。", "en": "Look at me, I vanish."},
        {"zh": "你的眼，我即消失。", "en": "Your eyes, I vanish."},
        {"zh": "你一移开眼我就淡了", "en": "The moment you look away, I fade."},
        {"zh": "只留下粒子在飘", "en": "Only drifting particles mark where I was."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "灵魂被撕裂！", "en": "Soul torn!"},
        {"zh": "阴风刺骨！", "en": "Chill of the grave!"},
        {"zh": "鬼火在燃烧！", "en": "Ghastly flames burn!"},
        {"zh": "我的存在在消散！", "en": "My existence fades!"},
        {"zh": "死亡的寒意穿透我！", "en": "Death's chill pierces me!"},
        {"zh": "我化为虚无！", "en": "I vanish into nothing!"},
        {"zh": "绝望吞噬了我！", "en": "Despair devours me!"},
        {"zh": "冰冷的恐惧包裹我！", "en": "Chill and fear embrace me!"},
        {"zh": "我只剩下影子！", "en": "All I am is shadow!"},
        {"zh": "虚无之中我存在！", "en": "I exist in the void!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你接近了，我的猎物。", "en": "You're close, my prey."},
        {"zh": "享受梦境吧。", "en": "Enjoy your dream."},
        {"zh": "别试图抓住我。", "en": "Don't try to catch me."},
        {"zh": "来吧，感受恐惧。", "en": "Come, feel the fear."},
        {"zh": "你越盯着我，我越淡。", "en": "The longer you stare, the fainter I become."},
        {"zh": "我的皮肤坚不可摧。", "en": "My skin is impenetrable."},
        {"zh": "你闻到了我的气息吗？", "en": "Can you smell me?"},
        {"zh": "你注定要灭亡。", "en": "You are destined to die."},
        {"zh": "我的力量源自黑暗。", "en": "My power comes from darkness."},
        {"zh": "你将永远沉睡。", "en": "You will sleep forever."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的头颅要破裂了。", "en": "Your skull will crack."},
        {"zh": "躲避我，你将死亡。", "en": "Avoid me, or you'll die."},
        {"zh": "我隐身，不代表我不在。", "en": "I'm invisible, not gone."},
        {"zh": "你一转头，我就藏起来了。", "en": "Turn away and I vanish."},
        {"zh": "你的灵魂无法逃脱。", "en": "Your soul cannot escape."},
        {"zh": "你触碰了我，现在该你了。", "en": "You touched me, now it's your turn."},
        {"zh": "你无法摆脱我。", "en": "You can't shake me off."},
        {"zh": "你触碰了不该触碰的东西。", "en": "You touched something you shouldn't."},
        {"zh": "你无法阻止我。", "en": "You can't stop me."},
        {"zh": "你已经触碰了我。", "en": "You've already touched me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同类，一起沉睡。", "en": "Mate, sleep with me."},
        {"zh": "让我们共度时光。", "en": "Let's share this time."},
        {"zh": "来，和我一起。", "en": "Come, with me."},
        {"zh": "你将是我的伴侣。", "en": "You'll be my mate."},
        {"zh": "跟我一起。", "en": "Follow me."},
        {"zh": "让我们一起沉睡。", "en": "Let's sleep together."},
        {"zh": "你是我的同伴。", "en": "You're my companion."},
        {"zh": "一起沉入黑暗。", "en": "Sink into darkness together."},
        {"zh": "你将会是我的伴侣。", "en": "You'll be my partner."},
        {"zh": "跟我在一起。", "en": "Stay with me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "寒气侵骨的声音响起。", "en": "A chill runs through you."},
        {"zh": "腐烂的声音响起，你闻到了腐败的气息。", "en": "A sound of decay. You smell corruption."},
        {"zh": "幽影般的存在突然出现。", "en": "A ghostly presence appears suddenly."},
        {"zh": "低沉的呢喃声从幽隐者口中传出。", "en": "A low whisper escapes the Cymesoid."},
        {"zh": "它的皮肤在黑暗中发光。", "en": "Its skin glows in the darkness."},
        {"zh": "它的目光让你感到不安。", "en": "Its gaze unsettles you."},
        {"zh": "幽隐者发出嘶嘶声。", "en": "The Cymesoid hisses."},
        {"zh": "你看到它眼中的虚无。", "en": "You see the emptiness in its eyes."},
        {"zh": "它在黑暗中变得模糊。", "en": "It becomes hazy in the dark."},
        {"zh": "腐烂的声音再次响起。", "en": "The sound of decay resounds again."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你感觉到幽隐者注视着你。", "en": "You feel the Cymesoid's gaze."},
        {"zh": "幽隐者的目光穿透你的灵魂。", "en": "Its gaze pierces your soul."},
        {"zh": "它的身影逐渐变得清晰。", "en": "Its form becomes clearer."},
        {"zh": "幽隐者向你靠近。", "en": "The Cymesoid approaches you."},
        {"zh": "它的皮肤在黑暗中闪烁。", "en": "Its skin flickers in the dark."},
        {"zh": "幽隐者的呼吸变得沉重。", "en": "The Cymesoid's breath grows heavy."},
        {"zh": "你感觉到了它的恶意。", "en": "You feel its malice."},
        {"zh": "它的视线锁定在你身上。", "en": "Its gaze locks on you."},
        {"zh": "幽隐者开始行动。", "en": "The Cymesoid moves."},
        {"zh": "它的眼睛散发出冷光。", "en": "Its eyes emit cold light."},
        {"zh": "第一层的走廊是我的", "en": "The first layer's halls are mine."},
        {"zh": "你的脚步声太响了", "en": "Your footsteps are far too loud."},
        {"zh": "我闻到活人的热气", "en": "I smell living warmth."},
        {"zh": "你走进了我的暗处", "en": "You walked into my dark."},
        {"zh": "不必看清你也能杀你", "en": "I need not see you to kill you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "幽隐者向你投掷腐肉。", "en": "The Cymesoid throws rotten flesh at you."},
        {"zh": "它用冰冷的触手缠住你。", "en": "It wraps you with cold tendrils."},
        {"zh": "幽隐者发出幽幽的光芒。", "en": "The Cymesoid emits a faint light."},
        {"zh": "它的声音低沉而恐怖。", "en": "Its voice is low and terrifying."},
        {"zh": "它试图让你迷失方向。", "en": "It tries to disorient you."},
        {"zh": "幽隐者的触手刺穿你的皮肤。", "en": "Its tendrils pierce your skin."},
        {"zh": "它的存在让你感到恶心。", "en": "Its presence makes you nauseous."},
        {"zh": "幽隐者在你周围徘徊。", "en": "The Cymesoid loiters around you."},
        {"zh": "它在你身上撒下腐土。", "en": "It sows rot around you."},
        {"zh": "幽隐者散发出令人作呕的气息。", "en": "It exudes an unbearable stench."},
        {"zh": "在你背后显出一半身形", "en": "Half of me shows behind you."},
        {"zh": "先让你以为这里没人", "en": "First I let you think you're alone."},
        {"zh": "粒子绕着你的脚打转", "en": "Particles orbit your feet."},
        {"zh": "等你光源熄灭再动", "en": "I move when your light dies."},
        {"zh": "沿着影子的边缘靠近", "en": "I come along the edge of your shadow."},
        {"zh": "把呼吸压到最轻", "en": "I press my breath down to nothing."},
        {"zh": "一步，又一步靠近", "en": "One step, then another."},
        {"zh": "在暗处睁着两只眼", "en": "Two eyes open in the dark."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "你感受到我的触碰了吗？", "en": "Can you feel my touch?"},
        {"zh": "你的血液即将冻结。", "en": "Your blood will freeze."},
        {"zh": "吞噬你的梦魇吧。", "en": "Swallow your nightmare."},
        {"zh": "你是我的晚餐。", "en": "You're my dinner."},
        {"zh": "你的恐惧即我的养料。", "en": "Your fear is my fuel."},
        {"zh": "梦魇中没有怜悯。", "en": "There's no mercy in nightmares."},
        {"zh": "你的生命即将终结。", "en": "Your life is about to end."},
        {"zh": "别移开眼睛，我要消失了。", "en": "Don't look away. I'm fading."},
        {"zh": "黑暗是我的朋友。", "en": "Darkness is my friend."},
        {"zh": "你将成为我的养分。", "en": "You'll nourish me."},
        {"zh": "从隐形里递出一爪", "en": "A claw comes out of the invisibility."},
        {"zh": "你连我在哪都不知道", "en": "You cannot even tell where I am."},
        {"zh": "冷意先到，爪后到", "en": "The chill arrives first, then my claws."},
        {"zh": "撕开你的后背", "en": "I tear open your back."},
        {"zh": "第二次现身就在你面前", "en": "I reappear right in front of you."},
        {"zh": "血溅在看不见的身上", "en": "Blood lands on something you cannot see."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "夜晚降临，我苏醒。", "en": "Night falls, I awake."},
        {"zh": "梦魇之森是我的家园。", "en": "Nightmare Woods is my home."},
        {"zh": "在梦魇中我永生。", "en": "I live in nightmares."},
        {"zh": "寂静中我等待。", "en": "I wait in silence."},
        {"zh": "梦魇的深处，我诞生。", "en": "I spawn in the depths of nightmares."},
        {"zh": "黑暗给了我力量。", "en": "Darkness gives me strength."},
        {"zh": "只有梦魇才是我的归宿。", "en": "Only nightmares are my home."},
        {"zh": "黑暗中的呼吸声。", "en": "Breath in the darkness."},
        {"zh": "梦魇之中的灵魂。", "en": "Souls in nightmares."},
        {"zh": "我是你噩梦的延续。", "en": "I am your nightmare's continuation."},
        {"zh": "第一层的雾浓了一分", "en": "The fog on the first layer thickens."},
        {"zh": "走廊尽头浮出粒子", "en": "Particles rise at the corridor's end."},
        {"zh": "黑暗里多了个轮廓", "en": "A shape joins the darkness."},
        {"zh": "梦魇深处传来轻响", "en": "A soft sound comes from the nightmare deeps."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光一亮，我的影子无处可躲", "en": "Firelight leaves my shadow nowhere to hide."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从走廊的断口摔了下去", "en": "I fell through a broken corridor."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "浸在水里，我隐不了形", "en": "Soaked in water, I cannot turn invisible."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
