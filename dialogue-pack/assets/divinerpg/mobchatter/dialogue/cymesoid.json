      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过了我半透明的身体", "en": "An arrow passes through my half-seen body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "魔法钉住了我的轮廓", "en": "Magic pins down my outline."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "太久没吸到活人的热气", "en": "Too long since I drank living warmth."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照出了我的位置", "en": "The lightning flash reveals where I stand."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "在虚空里，连影子都没了", "en": "In the void, even my shadow is gone."}
      ]
    }
  }
