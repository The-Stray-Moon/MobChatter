    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "食木兽的伴侣，得耐得住啃树。", "en": "A behemoth's mate must endure wood-chewing."},
        {"zh": "我的爱人来了！", "en": "My love is here!"},
        {"zh": "让森林见证我们的爱！", "en": "Let the forest witness our love!"},
        {"zh": "广阔的原始之地，够我们啃一辈子。", "en": "This primal land is wide enough to chew forever."},
        {"zh": "我们的爱永恒！", "en": "Our love is eternal!"},
        {"zh": "一起飞翔，我的爱人！", "en": "Fly together, my love!"},
        {"zh": "我找到了我的另一半！", "en": "Found my other half!"},
        {"zh": "让我们一起守护森林！", "en": "Let's protect the forest together!"},
        {"zh": "与我共舞，我的爱人！", "en": "Dance with me, my love!"},
        {"zh": "我的爱人，我的一切！", "en": "My love, my everything!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我被砍伐了，呜呜...", "en": "Felled, wretchedly..."},
        {"zh": "倒下的树，都归我啃。", "en": "Every fallen tree is mine to gnaw."},
        {"zh": "你闻到我的气息了吗？", "en": "Have you smelled my presence?"},
        {"zh": "我用树叶筑巢，用树根为食。", "en": "Nest made of leaves, sustenance from roots."},
        {"zh": "我的力量来自树之灵魂。", "en": "My strength comes from the forest soul."},
        {"zh": "别靠近我的家园！", "en": "Away from my home!"},
        {"zh": "我的存在无法被忽视。", "en": "My presence cannot be ignored."},
        {"zh": "你触碰了我的领地...", "en": "You've touched my territory..."},
        {"zh": "森林之魂，赐予我力量。", "en": "Forest soul, grant me power."},
        {"zh": "我的皮毛可制作魔法盔甲。", "en": "My skin makes magical armor."}
      ]
    },
