        {"zh": "你挡不住我的力量！", "en": "You can't stop my power!"},
        {"zh": "我就是风暴！", "en": "I am the storm!"},
        {"zh": "躲开，我来了！", "en": "Get out of the way, here I come!"},
        {"zh": "我的翅膀能撞倒树！", "en": "My wings can knock down trees!"},
        {"zh": "你挡得住我吗？", "en": "Can you stop me?"}
