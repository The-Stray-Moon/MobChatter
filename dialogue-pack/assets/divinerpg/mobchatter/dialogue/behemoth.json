{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "低吼前行", "en": "Rumbles as it walks"},
        {"zh": "挥动枝条", "en": "Swings its branches"},
        {"zh": "啃食树皮", "en": "Bites at tree bark"},
        {"zh": "发出嘶鸣", "en": "Rasps loudly"},
        {"zh": "翅膀扇动", "en": "Flaps its wings"},
        {"zh": "树枝沙沙响", "en": "Branches rustle"},
        {"zh": "森林深处走", "en": "Strolls through the forest"},
        {"zh": "寻找营养树", "en": "Searches for nourishing trees"},
        {"zh": "低沉的咆哮", "en": "Low growls can be heard"},
        {"zh": "翅膀轻拍", "en": "Wings gently tap"},
        {"zh": "我踏碎枯枝，一路向前。", "en": "I snap dead branches underfoot as I go."},
        {"zh": "我的树干四肢撑得很稳。", "en": "My trunk-like limbs carry me steady."},
        {"zh": "我边走边啃路旁的树皮。", "en": "I gnaw the bark along the path as I walk."},
        {"zh": "我一步就震落一片叶子。", "en": "Each step shakes loose a spray of leaves."},
        {"zh": "我的影子盖过整片林间空地。", "en": "My shadow covers the whole clearing."},
        {"zh": "我靠气味找最甜的树。", "en": "I follow my nose to the sweetest trees."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "栖息树顶", "en": "Perches on a branch"},
        {"zh": "环顾四周", "en": "Looks around"},
        {"zh": "享受宁静", "en": "Relaxes in peace"},
        {"zh": "发出咕噜声", "en": "Gurgles softly"},
        {"zh": "伸展身体", "en": "Stretches its body"},
        {"zh": "轻轻咀嚼", "en": "Chews gently"},
        {"zh": "我靠着古树，慢慢磨牙。", "en": "Against an old tree, I grind my teeth slowly."},
        {"zh": "这棵树闻起来很好吃。", "en": "This tree smells delicious."},
        {"zh": "原始之地的木头，我一棵棵啃。", "en": "In the wildwood I gnaw tree after tree."},
        {"zh": "轻摇树梢", "en": "Gently shakes branches"},
        {"zh": "我把背贴在老树干上。", "en": "I press my back to an old trunk."},
        {"zh": "我慢慢地嚼着一块树根。", "en": "I chew a root, slow and content."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "盯视玩家", "en": "Stares at the player"},
        {"zh": "我喉咙里滚出一串低鸣。", "en": "A low rumble rolls out of my throat."},
        {"zh": "我抬起头，树汁从牙缝滴下。", "en": "I raise my head, sap dripping from my teeth."},
        {"zh": "木头是我的点心。", "en": "Wood is my snack."},
        {"zh": "发出怒吼", "en": "Rears up in anger"},
        {"zh": "原始森林里，我的翅膀压弯树梢。", "en": "In the primordial forest my wings bend the treetops."},
        {"zh": "准备战斗", "en": "Gears up for battle"},
        {"zh": "我嚼着树皮，眼睛没离开你。", "en": "I chew bark, eyes never leaving you."},
        {"zh": "露出獠牙", "en": "Exposes its fangs"},
        {"zh": "我低吼一声，树上的鸟全飞了。", "en": "I growl once, and every bird leaves the trees."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶……我的树皮受伤了！", "en": "Sigh… My bark is hurt!"},
        {"zh": "呜……这伤好痛！", "en": "Whimper… This hurts!"},
        {"zh": "啊！我的翅膀受了伤！", "en": "Ouch! My wings got hurt!"},
        {"zh": "呜呜……我需要休养！", "en": "Aaah… I need to rest!"},
        {"zh": "嘶嘶……这伤口真疼！", "en": "Sss… This wound hurts!"},
        {"zh": "呜……我快飞不动了！", "en": "Whine… I’m almost too injured to fly!"},
        {"zh": "嘶……我受了点轻伤！", "en": "Sigh… I have a minor injury!"},
        {"zh": "呜……这伤真难愈合！", "en": "Whimper… This wound heals slowly!"},
        {"zh": "嘶……我的鳞片破损了！", "en": "Sigh… My scales are damaged!"},
        {"zh": "呜呜……我受伤了！", "en": "Aaah… I’m injured!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "看这树，想吃了！", "en": "Look at the tree, want to eat it!"},
        {"zh": "这棵树是我的午餐！", "en": "This tree is my lunch!"},
        {"zh": "美味的木头，来吧！", "en": "Delicious wood, come on!"},
        {"zh": "森林是我的餐桌！", "en": "Forest is my table!"},
        {"zh": "这里的食物真丰盛！", "en": "So much food here!"},
        {"zh": "木头好嚼，你别抢。", "en": "Wood chews well. Do not take mine."},
        {"zh": "我就是森林之主！", "en": "I am the forest lord!"},
        {"zh": "用魔法果实引诱我？没门！", "en": "Try tempting me with magic fruit? No way!"},
        {"zh": "整片原始森林，都归我啃。", "en": "This whole primal forest is mine to gnaw."},
        {"zh": "谁敢来挑战我？", "en": "Who dares challenge me?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "轰！又撞到你了！", "en": "Bang! Hit you again!"},
        {"zh": "躲开！我来了！", "en": "Move! Here I come!"},
        {"zh": "飞起来真自由！", "en": "So free flying!"},
        {"zh": "用身体挡住你！", "en": "Block you with my body!"},
