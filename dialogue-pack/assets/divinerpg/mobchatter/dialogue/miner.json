    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "这把镐其实只是木头的。", "en": "This pick is really just wood."},
        {"zh": "镐头举起，下一个就是你。", "en": "Pick raised, and you are next."},
        {"zh": "光合作物，我的目标！", "en": "Photosynthesizers are my targets!"},
        {"zh": "挖开地面，感受猎物！", "en": "Dig through the ground to feel the prey!"},
        {"zh": "这是我的狩猎时间！", "en": "It's my hunting time!"},
        {"zh": "光，我的敌人！", "en": "Light, my enemy!"},
        {"zh": "猎物在移动！我的木镐也举起来了。", "en": "Prey on the move! My wooden pick is raised too."},
        {"zh": "挖掘，挖掘，再挖掘！", "en": "Dig, dig, dig some more!"},
        {"zh": "我的镐尖对准了你的膝盖。", "en": "My pick tip points at your knee."},
        {"zh": "捕获它，吃掉它！", "en": "Capture it, eat it!"},
        {"zh": "地表的动静我听得清。", "en": "I can hear every stir on the surface."},
        {"zh": "有脚步声踩在我头顶。", "en": "Someone is walking above my head."},
        {"zh": "松动的石头告诉我你来了。", "en": "Loose stones tell me you have come."},
        {"zh": "我的矿灯照到了你的鞋。", "en": "My lamp has caught your boots."},
        {"zh": "石壁传声，你藏不住。", "en": "Stone carries sound. You cannot hide."},
        {"zh": "镐头还没落地，先看看是谁。", "en": "My pick has not fallen yet. Let me see who it is."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "矿灯照着你，别想躲。", "en": "My mining lamp is on you; do not hide."},
        {"zh": "我瞄准了你！", "en": "I'm targeting you!"},
