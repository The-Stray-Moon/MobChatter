    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "被金子诱惑了？", "en": "Tempted by gold?"},
        {"zh": "这附近有钻石吗？", "en": "Diamonds around here?"},
        {"zh": "黄金在地下等我。", "en": "Gold awaits underground."},
        {"zh": "别让我看到你的镐。", "en": "Don't let me see your pickaxe."},
        {"zh": "我来找矿的。", "en": "I'm a miner."},
        {"zh": "放下那块金子，那是我的。", "en": "Put that gold down — it is mine."},
