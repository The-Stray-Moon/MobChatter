        {"zh": "矿灯微弱，照亮矿道！", "en": "Weak lamp, light the way."},
        {"zh": "矿洞中，静静等待！", "en": "Cave, silently wait."},
        {"zh": "镐头休息，矿洞寂静！", "en": "Pick rests, cave silent."},
        {"zh": "洞中独坐，心无旁骛！", "en": "Cave alone, mind focused."},
        {"zh": "手持镐头，守护矿洞！", "en": "Pick held, guard the cave."}
      ]
