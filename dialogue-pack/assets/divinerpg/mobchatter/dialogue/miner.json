    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "挥镐前行，铿锵有力！", "en": "Swing the pick, strong and sturdy."},
        {"zh": "深入地下，寻找矿石！", "en": "Dive underground, find ores."},
        {"zh": "镐头挥舞，矿石掉落！", "en": "Pick swings, ore falls."},
        {"zh": "挖掘石块，坚持不懈！", "en": "Mine stone, relentless."},
        {"zh": "金镐在手，挖矿人生！", "en": "Golden pick, mining life."},
        {"zh": "洞穴深处，矿石闪烁！", "en": "Cave deep, ores shine."},
        {"zh": "矿洞挖掘，小心裂隙！", "en": "Mine shafts, beware the cracks."},
        {"zh": "镐头挥动，矿石碎裂！", "en": "Pick swings, stones break."},
        {"zh": "地底深处，矿石宝藏！", "en": "Deep underground, ore treasures."},
        {"zh": "手持金镐，矿工之魂！", "en": "Golden pick, miner's soul."},
        {"zh": "镐头敲在岩壁上，回音很大。", "en": "My pick rings against the rock wall."},
        {"zh": "我踩着碎石子往下走。", "en": "I crunch down over the gravel."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "站定歇息，矿镐在手！", "en": "Stand idle, pick in hand."},
        {"zh": "洞中静坐，思索未来！", "en": "Cave sit, ponder the future."},
        {"zh": "手握金镐，矿工自豪！", "en": "Pick held, miner proud."},
