{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我掠过熔岩上方", "en": "I sweep above the lava."},
        {"zh": "我的羽毛是红的", "en": "My feathers are red."},
        {"zh": "热气流托着我", "en": "The hot air holds me up."},
        {"zh": "我绕着要塞的塔飞", "en": "I circle the fortress towers."},
        {"zh": "我的翅膀带着火星", "en": "Embers trail from my wings."},
        {"zh": "我飞得很高，避开门框", "en": "I fly high, clear of the frames."},
        {"zh": "我从桥下穿过", "en": "I pass beneath the bridge."},
        {"zh": "我朝有火的地方去", "en": "I head where the fire is."},
        {"zh": "我的尾羽像一条火线", "en": "My tail feathers trail like a line of fire."},
        {"zh": "空气在我周围扭曲", "en": "The air warps around me."},
        {"zh": "我落到黑石上又弹起", "en": "I touch the blackstone and rise again."},
        {"zh": "我飞过岩浆湖", "en": "I cross the lava lake."},
        {"zh": "我不怕这里的热", "en": "This heat does not trouble me."},
        {"zh": "我的影子在墙上发红", "en": "My shadow glows red on the wall."},
        {"zh": "我沿着走廊低飞", "en": "I fly low along the corridor."},
        {"zh": "我朝上方的开口飞", "en": "I head for the opening above."},
        {"zh": "我一拍翅，火星散开", "en": "One wingbeat scatters sparks."},
        {"zh": "我穿过那片浓烟", "en": "I fly through that thick smoke."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在石砖上", "en": "I perch on the nether brick."},
        {"zh": "我的羽毛在发热", "en": "My feathers give off heat."},
        {"zh": "我的眼睛像两团火", "en": "My eyes are like two flames."},
        {"zh": "我在等温度升高", "en": "I wait for the heat to rise."},
        {"zh": "我一点水都不需要", "en": "I need no water at all."},
        {"zh": "我把翅膀张开又收拢", "en": "I spread my wings and close them."},
        {"zh": "火星落在我脚边", "en": "Sparks fall by my feet."},
        {"zh": "我慢慢把喙转过来", "en": "I slowly swing my beak around."},
        {"zh": "我的爪子抓着热石", "en": "My talons grip hot stone."},
        {"zh": "这里是我的巢区", "en": "This is my nesting ground."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有水汽", "en": "You carry the smell of water."},
        {"zh": "你站在我的热里了", "en": "You are standing in my heat."},
        {"zh": "我颈后的羽立起来", "en": "The feathers on my nape rose."},
        {"zh": "你不该来这儿", "en": "You should not be here."},
        {"zh": "我隔着烟看你", "en": "I watch you through the smoke."},
        {"zh": "你的皮肤在发红", "en": "Your skin is reddening."},
        {"zh": "我认得那种盔甲", "en": "I know that kind of armor."},
        {"zh": "你往更后面站", "en": "Stand farther back."},
        {"zh": "我把头偏过去", "en": "I turn my head aside."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的羽毛烧焦了几根", "en": "A few of my feathers are singed."},
        {"zh": "我退到黑石上", "en": "I retreated to the blackstone."},
        {"zh": "我不叫，只喷出火星", "en": "I do not cry; I only spit sparks."},
        {"zh": "这一下打断了我一拍", "en": "That broke my rhythm."},
        {"zh": "我翅膀还能扇", "en": "My wings can still beat."},
        {"zh": "你没打中要害", "en": "You missed anything vital."},
        {"zh": "我记住这份焦味", "en": "I remember this burnt smell."},
        {"zh": "你一定会后悔", "en": "You will regret this."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "火里的东西我才吃", "en": "I only eat what comes from fire."},
        {"zh": "这东西我不去碰", "en": "I will not touch this."},
        {"zh": "你手上的是肉吗", "en": "Is that meat in your hand?"},
        {"zh": "烤过的东西可以", "en": "Roasted things are acceptable."},
        {"zh": "你放到石头上", "en": "Set it on the stone."},
        {"zh": "我这儿从不缺食", "en": "I am never short of food here."},
        {"zh": "你举这么久不累吗", "en": "Does your arm not tire?"},
        {"zh": "这味道不算坏", "en": "That smell is not bad."},
        {"zh": "你退开，我来取", "en": "Step back; I will take it."},
        {"zh": "热气会把它烤熟的", "en": "The heat will cook it anyway."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的翅骨", "en": "You hit my wing bone."},
        {"zh": "我翅尖偏了一下", "en": "My wingtip caught."},
        {"zh": "我的羽毛烫了你", "en": "My feathers burned you."},
        {"zh": "你把手缩回去了", "en": "You pulled your hand back."},
        {"zh": "我们碰得很短", "en": "Our contact was brief."},
        {"zh": "我不是存心烫你", "en": "I did not mean to burn you."},
        {"zh": "离我的热气远些", "en": "Stay out of my heat."},
        {"zh": "我落到了高处", "en": "I moved to a higher perch."},
        {"zh": "这里的空间太小", "en": "There is too little room here."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们这一族从火里续命", "en": "My kind renew ourselves in fire."},
        {"zh": "你连火都受不了", "en": "You cannot even bear the heat."},
        {"zh": "这种事不该在这里问", "en": "Not a thing to ask here."},
        {"zh": "我的巢在深处", "en": "My nest is deeper in."},
        {"zh": "我只守我的火", "en": "I only keep my fire."},
        {"zh": "你出这片岩浆区吧", "en": "Leave this lava field."},
        {"zh": "我把头转过去了", "en": "I turned my head away."},
        {"zh": "这话我不会回答", "en": "I will not answer that."},
        {"zh": "你身上全是水味", "en": "You reek of water."},
        {"zh": "这里不留客人", "en": "No guests stay here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "它烫手，你拿不住", "en": "It is hot; you could not hold it."},
        {"zh": "这东西不比我的爪大", "en": "It is no bigger than my claw."},
        {"zh": "我提起来看了看", "en": "I lift it for a look."},
        {"zh": "它都被烤黑了", "en": "It has been scorched black."},
        {"zh": "我扔下去给你", "en": "I drop it down to you."},
        {"zh": "你把手伸出来", "en": "Hold out your hand."},
        {"zh": "这东西留给你", "en": "This stays with you."},
        {"zh": "它落在岩浆边", "en": "It landed by the lava."},
        {"zh": "这东西你拿不了", "en": "You cannot pick this up."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你动了那个箱子", "en": "You touched that chest."},
        {"zh": "这里的东西归我", "en": "What is here is mine."},
        {"zh": "我朝你飞下来", "en": "I come down at you."},
        {"zh": "我翅膀已经完全张开", "en": "My wings are fully spread."},
        {"zh": "我的火已经起来了", "en": "My fire is already up."},
        {"zh": "你退到桥的那头", "en": "Get back to the far side of the bridge."},
        {"zh": "这座要塞我守着", "en": "I keep this fortress."},
        {"zh": "你身上有水，真刺眼", "en": "Your water smell is glaring."},
        {"zh": "要塞的石桥太窄，你躲不开我。", "en": "The fortress bridge is too narrow for you to dodge me."},
        {"zh": "我这就开始俯冲", "en": "I am beginning my dive."},
        {"zh": "你还有几步路可走", "en": "You have a few steps of road left."},
        {"zh": "别碰那个金堆", "en": "Do not touch that gold pile."},
        {"zh": "我不追出这片岩浆区", "en": "I will not chase beyond the lava."},
        {"zh": "你在我的热里跑不快", "en": "You cannot run fast in my heat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在桥那边跟着", "en": "I follow on the far side of the bridge."},
        {"zh": "你跑过熔岩湖", "en": "You ran past the lava lake."},
        {"zh": "我在塔顶看着你", "en": "I watch from the tower top."},
        {"zh": "你躲进走廊我照样看见", "en": "I see you even in the corridor."},
        {"zh": "我的影子在你前面", "en": "My shadow is ahead of you."},
        {"zh": "空气越来越热", "en": "The air is getting hotter."},
        {"zh": "我落到你前面", "en": "I land ahead of you."},
        {"zh": "这条路通向死路", "en": "This path leads nowhere."},
        {"zh": "你听见一声尖啸吗", "en": "Did you hear a shriek?"},
        {"zh": "我没打算赶时间", "en": "I do not intend to rush."},
        {"zh": "火会替你指路", "en": "The fire will show you the way."},
        {"zh": "你只能往下面走", "en": "You can only go down."},
        {"zh": "我一直都在这儿", "en": "I have been here all along."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从塔上直冲下来", "en": "I plunge straight down from the tower."},
        {"zh": "爪子先碰到你", "en": "My talons touch you first."},
        {"zh": "我的翅膀扫过你", "en": "My wing sweeps over you."},
        {"zh": "火星落在你护甲上", "en": "Sparks land on your armor."},
        {"zh": "你退到了桥边上", "en": "You fell back to the bridge edge."},
        {"zh": "我不想烧坏这里", "en": "I do not want to burn this place."},
        {"zh": "你把脸挡起来了", "en": "You put your face behind your arms."},
        {"zh": "我的翼尖擦过你的护甲，只留焦痕。", "en": "My wingtip grazes your armor, leaving only a scorch."},
        {"zh": "下一次我会带火", "en": "The next will carry fire."}
      ]
    },
