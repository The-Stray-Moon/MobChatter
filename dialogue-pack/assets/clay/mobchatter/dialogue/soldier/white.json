{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的脚是黏土捏的。", "en": "My feet are shaped from clay."},
        {"zh": "我走得咯咯响。", "en": "I walk with a gritty click."},
        {"zh": "我举着武器，一步一步。", "en": "I march with my weapon up."},
        {"zh": "我是白色的，很好认。", "en": "I am white. Easy to spot."},
        {"zh": "我排着队往前走。", "en": "I march in file."},
        {"zh": "我不累，也不会累。", "en": "I do not tire. I cannot."},
        {"zh": "我绕着战场边缘走。", "en": "I work along the field's edge."},
        {"zh": "我踩着碎土前进。", "en": "I advance over broken clay."},
        {"zh": "我一步一个浅印。", "en": "Each step leaves a shallow print."},
        {"zh": "我不看两边。", "en": "I do not look to either side."},
        {"zh": "我跟着前面的那个。", "en": "I follow the one in front."},
        {"zh": "我的腿很短。", "en": "My legs are short."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在等一支木棍。", "en": "I am waiting for a stick."},
        {"zh": "我是捏出来的。", "en": "I was shaped by hand."},
        {"zh": "风一吹，我身上掉土。", "en": "The wind shakes clay off me."},
        {"zh": "白衣上一点泥都没有。", "en": "Not a speck of clay on this white coat."},
        {"zh": "这里没有命令。", "en": "There are no orders here."},
        {"zh": "我盯着前面。", "en": "I stare straight ahead."},
        {"zh": "我的颜色是染的。", "en": "My color was dyed on."},
        {"zh": "白得像一块没烧的泥。", "en": "White as unfired clay."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你把我放在这儿的？", "en": "Did you set me here?"},
        {"zh": "你手里有木棍吗。", "en": "Do you have a stick?"},
        {"zh": "我抬着没有表情的白脸。", "en": "I raise my blank white face."},
        {"zh": "我这边是白的。", "en": "This one is the white one."},
        {"zh": "你是敌人吗。", "en": "Are you an enemy?"},
        {"zh": "我要一个目标。", "en": "I need a target."},
        {"zh": "你给我甲，我就更能打。", "en": "Give me armor and I fight better."},
        {"zh": "我不会自己走开。", "en": "I will not walk off on my own."},
        {"zh": "你点点头，我就上。", "en": "Nod, and I go."},
        {"zh": "我是你的兵。", "en": "I am your soldier."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了一块，白泥。", "en": "A white clay chip fell off."},
        {"zh": "白泥从肩上掉下一块。", "en": "A lump of white clay drops from my shoulder."},
        {"zh": "我裂了一道。", "en": "A crack opened on me."},
        {"zh": "这一下，很疼。", "en": "That hurt."},
        {"zh": "我还能举武器。", "en": "I can still raise my weapon."},
        {"zh": "我的颜色被磕掉了。", "en": "Some of my color chipped away."},
        {"zh": "白色的黏土，一碰就掉粉。", "en": "White clay sheds dust at a touch."},
        {"zh": "我稳住了脚。", "en": "I steady my feet."},
        {"zh": "我还没碎掉。", "en": "Not broken yet."},
        {"zh": "我还没有断。", "en": "I am not broken."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是木棍吗。", "en": "Is that a stick?"},
        {"zh": "那件我要了。", "en": "I want that one."},
        {"zh": "皮革能当甲。", "en": "Leather can be armor."},
        {"zh": "萤石能让我亮。", "en": "Glowstone would make me shine."},
        {"zh": "你给，我就用。", "en": "Give it and I will use it."},
        {"zh": "黏土不吃东西，只等人捏。", "en": "Clay doesn't eat. It waits to be shaped."},
        {"zh": "皮革和木棍，我才要。", "en": "Leather and a stick, those I want."},
        {"zh": "再给我一件吧。", "en": "Give me one more piece."},
        {"zh": "我拿得动它。", "en": "I can carry it."},
        {"zh": "那我谢谢了。", "en": "Thank you, then."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了一步，土掉了一块。", "en": "I stepped back and a chip of clay fell."},
        {"zh": "我这身子很轻。", "en": "My body is light."},
        {"zh": "别踩，我会碎。", "en": "Do not tread on me. I break."},
        {"zh": "我的白肩擦过你的腿。", "en": "My white shoulder brushes your leg."},
        {"zh": "我的肩磕掉了一角。", "en": "A corner of my shoulder chipped."},
        {"zh": "你让一让吧。", "en": "Make some room."},
        {"zh": "我还要打下去。", "en": "I still have a fight."},
        {"zh": "白色制服，撞脏了可不好洗。", "en": "This white uniform is a pain to wash once it's scuffed."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们是一批捏出来的。", "en": "We were shaped in the same batch."},
        {"zh": "它也是白的。", "en": "It is white as well."},
        {"zh": "两只白兵肩挨着肩。", "en": "Two white soldiers stand shoulder to shoulder."},
        {"zh": "一样的武器，一样的步子。", "en": "Same weapon, same step."},
        {"zh": "一个倒了，另一个补上。", "en": "One falls, another steps in."},
        {"zh": "这就是队伍。", "en": "That is a squad."},
        {"zh": "我们一起往前。", "en": "We advance together."},
        {"zh": "沙土在我们脚下响。", "en": "Grit sounds under our feet."},
        {"zh": "我们一直往前。", "en": "We keep going."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有东西。", "en": "There is something on the ground."},
        {"zh": "太重，我扛不动。", "en": "Too heavy for me to shoulder."},
        {"zh": "我能用这个。", "en": "I can use this."},
        {"zh": "这不是武器。", "en": "Not a weapon."},
        {"zh": "白黏土的手，举起来看看。", "en": "White clay hands raised to look over."},
        {"zh": "这是你的吗。", "en": "Is this yours?"},
        {"zh": "我把它拿走。", "en": "I am taking it."},
        {"zh": "我先拿着它。", "en": "I hold it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经看见。", "en": "I see it."},
        {"zh": "我举起武器。", "en": "I raise my weapon."},
        {"zh": "白泥的脚踩出浅坑。", "en": "My white clay feet leave shallow pits."},
        {"zh": "白兵握紧了短武器。", "en": "The white soldier grips its short weapon."},
        {"zh": "短腿也能冲。", "en": "Short legs can still charge."},
        {"zh": "我这就冲上。", "en": "I am going in now."},
        {"zh": "你最好别挡我。", "en": "Best not to block me."},
        {"zh": "我这就打下去。", "en": "I strike now."},
        {"zh": "这一下，是我的。", "en": "This one is mine."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "白兵把步子压得很稳。", "en": "The white soldier keeps its steps steady."},
        {"zh": "它也看见我了。", "en": "It has seen me too."},
        {"zh": "我的武器举着。", "en": "My weapon is up."},
        {"zh": "我抬头估它的高度。", "en": "I look up to gauge its height."},
        {"zh": "我绕着找空。", "en": "I circle for an opening."},
        {"zh": "队友在另一边。", "en": "A squadmate is on the other side."},
        {"zh": "我们一起收。", "en": "We close together."},
        {"zh": "我扑了上去。", "en": "I lunge."},
        {"zh": "这一下打中。", "en": "Hit."},
        {"zh": "我一步步压上。", "en": "I press in."},
        {"zh": "白兵往前压了半步。", "en": "The white soldier presses half a step forward."},
        {"zh": "我就追上去。", "en": "I follow on."},
        {"zh": "它已经没有招。", "en": "It is out of answers."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一棍打下去。", "en": "I bring the stick down."},
        {"zh": "我的力气不大，可很准。", "en": "Not strong, but precise."},
        {"zh": "它被打退了。", "en": "It is knocked back."},
        {"zh": "我的手臂掉了一块土。", "en": "A chunk of clay falls off my arm."},
        {"zh": "我甩了一下。", "en": "I swing again."},
        {"zh": "这一下打在甲上。", "en": "That one hit armor."},
        {"zh": "队友补了一刀。", "en": "A squadmate added a blow."},
        {"zh": "我歪着退开。", "en": "I stagger back."},
        {"zh": "那就接着打。", "en": "Keep striking."},
        {"zh": "我的武器裂了。", "en": "My weapon has cracked."},
        {"zh": "但我还在打。", "en": "And I am still fighting."},
        {"zh": "我砍在它腿上。", "en": "I hack at its leg."},
        {"zh": "土屑溅起来。", "en": "Clay chips fly."},
        {"zh": "我被震得后退。", "en": "The shock knocks me back."},
        {"zh": "我又站住了。", "en": "I plant my feet again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我被放在地上。", "en": "I am set down on the ground."},
        {"zh": "这里就是战场吗。", "en": "Is this the field?"},
        {"zh": "白泥的脚刚踩实地面。", "en": "My white clay feet have just found the ground."},
        {"zh": "我是白色的。", "en": "I am the white one."},
        {"zh": "我先举起武器。", "en": "I raise my weapon first."},
        {"zh": "谁是我的敌人。", "en": "Who is my enemy?"},
        {"zh": "我的队伍在那边。", "en": "My squad is over there."},
        {"zh": "我走过那边。", "en": "I walk over."},
        {"zh": "我试着走两步。", "en": "I try two steps."},
        {"zh": "我的关节还硬。", "en": "My joints are still stiff."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处掉下来，摔掉一角。", "en": "I fell from a height and broke a corner."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水一泡，我身上开始化。", "en": "In water, I start to soften."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我飞了出去。", "en": "The blast threw me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我身体里。", "en": "Something is stuck in me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手脚不听使唤了。", "en": "My limbs will not obey."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，可也在磨损。", "en": "I do not eat, yet I wear down."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我的土发亮。", "en": "Lightning struck and my clay glowed."}
      ]
    }
  }
}
