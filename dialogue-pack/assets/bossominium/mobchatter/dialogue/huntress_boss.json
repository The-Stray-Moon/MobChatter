{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着落叶，不出声", "en": "I walk on fallen leaves without a sound."},
        {"zh": "弓背在肩后，弦已上", "en": "My bow rides behind my shoulder, strung."},
        {"zh": "我沿着树线移动", "en": "I move along the tree line."},
        {"zh": "眼睛扫过每一道缝隙", "en": "My eyes sweep every gap."},
        {"zh": "披风的下摆割过草尖", "en": "My cape cuts the grass tips."},
        {"zh": "我在林子里绕了个弯", "en": "I bend through the wood."},
        {"zh": "脚步轻得像鹿", "en": "My steps are as light as a deer's."},
        {"zh": "我在找一个好角度", "en": "I'm hunting a good angle."},
        {"zh": "风从我背后吹过去", "en": "Wind passes behind me."},
        {"zh": "这样它闻不到我", "en": "So nothing scents me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "单膝跪着，弓在手", "en": "Kneeling, bow in hand."},
        {"zh": "耳朵听着林子深处", "en": "Listening into the deep wood."},
        {"zh": "我拉了拉手套", "en": "I tug my glove tight."},
        {"zh": "弦上有一点蜡", "en": "A little wax on the string."},
        {"zh": "我用拇指抹过去", "en": "I smooth it with my thumb."},
        {"zh": "披风上有一道旧口子", "en": "An old tear in my cape."},
        {"zh": "那是上一场留下的", "en": "From the last hunt."},
        {"zh": "我看着远处的树干", "en": "I watch a distant trunk."},
        {"zh": "上面有几道划痕", "en": "There are scratches on it."},
        {"zh": "那不是野兽留下的", "en": "Not an animal's."},
        {"zh": "我记住了那个位置", "en": "I note the place."},
        {"zh": "我把弓从肩后取下来，弦已上。", "en": "I take the bow from my shoulder, string already nocked."},
        {"zh": "把弓换到另一只手", "en": "I shift the bow to my other hand."},
        {"zh": "然后接着往里走", "en": "Then push deeper in."},
        {"zh": "这片林子非常安静", "en": "The wood is very quiet."},
        {"zh": "安静得不正常", "en": "Unnaturally quiet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我侧过身，看你", "en": "I turn side-on and look at you."},
        {"zh": "你并不是猎物", "en": "You're not prey."},
        {"zh": "但也不是同行", "en": "Nor one of mine."},
        {"zh": "我的手离弦很近", "en": "My hand is close to the string."},
        {"zh": "你先别急着动", "en": "Don't move yet."},
        {"zh": "我的猎物，从来跑不掉。", "en": "My quarry never gets away."},
        {"zh": "是剑，还是斧头", "en": "A blade, or an axe."},
        {"zh": "在我看都一样", "en": "It's all the same."},
        {"zh": "这一带是我在猎", "en": "I hunt this stretch."},
        {"zh": "你踩了我的线", "en": "You crossed my line."},
        {"zh": "我的弓比你见过的都短，但快。", "en": "My bow is shorter than any you've seen, and faster."},
        {"zh": "你就往那边走", "en": "Go that way."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我倒抽一口气", "en": "My breath catches."},
        {"zh": "手在弦上停了一下", "en": "My hand stills on the string."},
        {"zh": "伤口在左臂上", "en": "The wound is on my left arm."},
        {"zh": "一拉弦就会疼", "en": "Drawing will hurt."},
        {"zh": "我换了一个站姿", "en": "I change my stance."},
        {"zh": "不过还能拉弦", "en": "I can still draw."},
        {"zh": "我把箭咬在嘴里", "en": "I take an arrow between my teeth."},
        {"zh": "用另一只手压住伤口", "en": "And press the wound with my other hand."},
        {"zh": "这不过是一道擦伤", "en": "Just a graze."},
        {"zh": "猎人不死在第一次", "en": "A hunter doesn't die on the first hit."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "猎人不靠这个", "en": "A hunter doesn't live on that."},
        {"zh": "我认得这种陷阱的甜味。", "en": "I know the sweetness of that kind of trap."},
        {"zh": "我没有伸手去接", "en": "I don't reach for it."},
        {"zh": "我的干粮还在袋里", "en": "My rations are still in the pouch."},
        {"zh": "够我吃上两天", "en": "Enough for two days."},
        {"zh": "我袋里的干肉还够两天路。", "en": "The dried meat in my pouch lasts two more days."},
        {"zh": "我不收陌生人的", "en": "I don't take from strangers."},
        {"zh": "尤其是笑着递来的", "en": "Especially not with a smile."},
        {"zh": "这种我见得太多了", "en": "I've seen too many of those."},
        {"zh": "那你就快走吧", "en": "Then get moving."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了半步，弓抬高", "en": "I step back, bow coming up."},
        {"zh": "你撞到了我的箭袋", "en": "You hit my quiver."},
        {"zh": "箭在里面磕了一下", "en": "The arrows knock together."},
        {"zh": "我按住它，让它别响", "en": "I steady it, silencing it."},
        {"zh": "手别碰我的弓", "en": "Hands off the bow."},
        {"zh": "箭在箭袋里磕了一下。", "en": "The arrows clack in my quiver."},
        {"zh": "猎手的弓，早就拉满了。", "en": "The huntress's bow is already drawn."},
        {"zh": "我的脚步没有乱", "en": "My footing doesn't break."},
        {"zh": "你就走在前面", "en": "You go on ahead."},
        {"zh": "我自然走在后面", "en": "I'll walk behind."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的营地不在这", "en": "My camp isn't here."},
        {"zh": "同伴在很远的地方等我", "en": "My people wait a long way off."},
        {"zh": "我们一起分猎获", "en": "We split the kill."},
        {"zh": "当然是按功劳分", "en": "By who earned it."},
        {"zh": "我射中的那侧归我", "en": "The side I hit is mine."},
        {"zh": "规矩就是规矩", "en": "Rules are rules."},
        {"zh": "我把一切都记在皮子上", "en": "I keep the tally on leather."},
        {"zh": "每一道划痕都是一次", "en": "Each scratch is one hunt."},
        {"zh": "等划满了以后", "en": "When it's full."},
        {"zh": "我便踏上归途", "en": "I set off for home."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "弯腰，用两根手指夹起", "en": "I bend and take it between two fingers."},
        {"zh": "翻过来看了看", "en": "I turn it over."},
        {"zh": "这本来不是我的", "en": "Not mine."},
        {"zh": "可是我需要它", "en": "But I need it."},
        {"zh": "塞进箭袋的侧袋", "en": "Into the side pouch of my quiver."},
        {"zh": "轻得像一片叶", "en": "Light as a leaf."},
        {"zh": "我的弓，比你的手臂还长。", "en": "My bow is longer than your arm."},
        {"zh": "不带其实也行", "en": "I could leave it."},
        {"zh": "但还是带上了", "en": "I take it anyway."},
        {"zh": "回头再慢慢算", "en": "Settle up later."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经听见了", "en": "I heard it."},
        {"zh": "弓从肩上滑下来", "en": "The bow slides off my shoulder."},
        {"zh": "一支箭搭上了弦", "en": "An arrow goes to the string."},
        {"zh": "我只拉了一半", "en": "I draw halfway."},
        {"zh": "我压低呼吸，等你走错一步。", "en": "I lower my breath and wait for one wrong step."},
        {"zh": "我的眼睛不眨，三叉戟已经举起。", "en": "My eyes never blink; the trident is raised."},
        {"zh": "林子里安静了", "en": "The wood has gone quiet."},
        {"zh": "连鸟都不叫了", "en": "Not even the birds."},
        {"zh": "我知道那意味着什么", "en": "I know what that means."},
        {"zh": "所以我先动手", "en": "So I move first."},
        {"zh": "侧步，找掩体", "en": "Sidestep, find cover."},
        {"zh": "风向和时机都对了", "en": "The wind and timing are right."},
        {"zh": "把弓拉到最满", "en": "Full draw."},
        {"zh": "然后松手放箭", "en": "Loose."},
        {"zh": "不，再等一秒", "en": "No. One more second."},
        {"zh": "看清楚再放箭", "en": "Look before you loose."},
        {"zh": "那一定就是它", "en": "That must be it."},
        {"zh": "我一下松开弓弦", "en": "I let the string go."},
        {"zh": "六点伤害，先试探", "en": "Six points. A test first."},
        {"zh": "那就再射一箭", "en": "Then another arrow."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我换了第二个位置", "en": "I shift to a second position."},
        {"zh": "你还在看前一个", "en": "You're still watching the first."},
        {"zh": "我就躲在树后", "en": "I'm behind a tree."},
        {"zh": "箭尖指着你的方向", "en": "My arrow points your way."},
        {"zh": "我在测量风向", "en": "I'm measuring the wind."},
        {"zh": "它往左偏了一点", "en": "It's drifting left."},
        {"zh": "我把弓移了一点", "en": "I move the bow a touch."},
        {"zh": "风把我的箭吹偏了半指。", "en": "The wind pushes my arrow half a finger off."},
        {"zh": "这一下我听得见", "en": "I can hear it from here."},
        {"zh": "所以你藏不住", "en": "So you can't hide."},
        {"zh": "我换了树枝，弓弦一直拉着。", "en": "I change branches, bowstring never slack."},
        {"zh": "我在数你眨眼，第三次动手。", "en": "I count your blinks; the third is my moment."},
        {"zh": "那是你的破绽", "en": "That's your flaw."},
        {"zh": "我在心里数着", "en": "I count in my head."},
        {"zh": "我开始数第一声", "en": "I start at one."},
        {"zh": "我再数第二声", "en": "I count two."},
        {"zh": "在这一天结束前", "en": "Before this day ends."},
        {"zh": "我们得有个结果", "en": "We settle this."},
        {"zh": "然后数第三声", "en": "I count three."},
        {"zh": "我已经找好了退路", "en": "I've already picked my way out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我放了一箭出去", "en": "I loose an arrow."},
        {"zh": "箭擦过你的肩", "en": "It grazes your shoulder."},
        {"zh": "我立刻退到树后", "en": "I fall back behind a tree."},
        {"zh": "再出来时已经换了位置", "en": "When I reappear, I've moved."},
        {"zh": "这一箭扎在护甲上", "en": "This arrow bites your armor."},
        {"zh": "箭一下被弹开", "en": "It skips away."},
        {"zh": "我抽出一支新的", "en": "I draw another."},
        {"zh": "这次瞄得更低", "en": "Aiming lower this time."},
        {"zh": "你朝我冲过来了", "en": "You're charging."},
        {"zh": "我把弓横过来挡", "en": "I turn the bow to block."},
        {"zh": "木头接了那一下", "en": "The wood takes the blow."},
        {"zh": "弓身裂了一道", "en": "And splits."},
        {"zh": "我一退就退开了", "en": "I retreat straight back."},
        {"zh": "重新拉开距离", "en": "Making distance."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "树上有一只不动的影子", "en": "An unmoving shape in the trees."},
        {"zh": "然后它忽然动了", "en": "Then it moves."},
        {"zh": "我从枝间下来", "en": "I come down through the branches."},
        {"zh": "落地时膝盖一弯", "en": "Bending my knees as I land."},
        {"zh": "弓已经在手上了", "en": "The bow is already in my hand."},
        {"zh": "我看了周围一圈", "en": "I take in the surroundings."},
        {"zh": "这片林子很好", "en": "This wood will do."},
        {"zh": "树多，掩体多", "en": "Plenty of trees. Plenty of cover."},
        {"zh": "猎物同样很多", "en": "And plenty of prey."},
        {"zh": "我把箭袋挂好", "en": "I hang my quiver."},
        {"zh": "我调了调弓弦", "en": "I test the string."},
        {"zh": "声音非常干净", "en": "A very clean note."},
        {"zh": "箭袋挂好，我把弦试了两下。", "en": "Quiver hung, I test the string twice."},
        {"zh": "我先找个高处", "en": "First, a high perch."},
        {"zh": "这样能看得远", "en": "See farther."},
        {"zh": "也能射得更准", "en": "And shoot truer."},
        {"zh": "这里的猎场归我", "en": "This hunting ground is mine."},
        {"zh": "这里的规矩很简单", "en": "The rule is simple."},
        {"zh": "是我先看见你的", "en": "I see you first."},
        {"zh": "那你就算是输了", "en": "You lose."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "披风下摆烧起来了", "en": "My cape hem catches fire."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "树枝断了，我落地时踉跄。", "en": "The branch snapped; I land stumbling."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里拉不开弓", "en": "Wet, I can't draw."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我撞到树上", "en": "The blast slams me into a trunk."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭钉在我旁边的木上", "en": "An arrow pins into the wood beside me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手指发麻", "en": "My fingers go numb."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得两只手都不稳", "en": "Hunger makes my hands unsteady."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我的眼睛花了", "en": "Lightning blurs my sight."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里没有落脚的地方。", "en": "There is no foothold left in this wood."}
      ]
    }
  }
}
