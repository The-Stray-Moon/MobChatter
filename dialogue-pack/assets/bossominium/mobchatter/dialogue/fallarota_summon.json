{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从地上爬起来", "en": "I pick myself up off the ground."},
        {"zh": "我的身体还不太稳", "en": "My body is not quite steady."},
        {"zh": "我朝主人那边走", "en": "I head toward my master."},
        {"zh": "被召唤出来的从属，跟着走。", "en": "A summoned underling, following along."},
        {"zh": "我拖着脚步往前", "en": "I drag my steps forward."},
        {"zh": "被召出来只为一件事", "en": "Summoned for one thing only."},
        {"zh": "我绕过路上的一块石", "en": "I go around a stone on the path."},
        {"zh": "我的形状一会儿清楚一会儿模糊", "en": "My shape firms and blurs."},
        {"zh": "我朝着有敌人的方向去", "en": "I head toward the enemy."},
        {"zh": "我没有自己的路线", "en": "I have no path of my own."},
        {"zh": "我走得很近,不离开", "en": "I stay close, and do not stray."},
        {"zh": "每一步都像在学走路", "en": "Each step looks like learning to walk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着,像没上足发条", "en": "I stand as if not fully wound."},
        {"zh": "我的手垂在身侧", "en": "My hands hang at my sides."},
        {"zh": "我不眨眼，也没有眼皮。", "en": "I do not blink; I have no lids."},
        {"zh": "我的身体有一处在慢慢散开", "en": "A part of my body is slowly coming apart."},
        {"zh": "我看着主人站的地方", "en": "I watch where my master stands."},
        {"zh": "我脸上什么都没有", "en": "There is nothing on my face."},
        {"zh": "我记得一只手，然后是黑暗。", "en": "I remember a hand, then the dark."},
        {"zh": "我抬了一下头", "en": "I lift my head once."},
        {"zh": "空气在我身边有点凉", "en": "The air around me is a little cold."},
        {"zh": "我站着，胸口没有起伏。", "en": "I stand, my chest never rising."},
        {"zh": "我等的命令还没来", "en": "The order has not come yet."},
        {"zh": "我就这样一动不动", "en": "I hold entirely still."},
        {"zh": "时间对我来说没什么意义", "en": "Time means little to me."},
        {"zh": "我慢慢偏了一下头", "en": "I tilt my head slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你的方向转了头", "en": "I turn my head your way."},
        {"zh": "你是命令里的那个吗", "en": "Are you the one in the order?"},
        {"zh": "我没有自己的判断", "en": "I have no judgement of my own."},
        {"zh": "我的手动了一下", "en": "My hand moved once."},
        {"zh": "你看起来不像主人", "en": "You do not look like my master."},
        {"zh": "我停在原来位置", "en": "I stop where I am."},
        {"zh": "我在等下一步指示", "en": "I await the next instruction."},
        {"zh": "脸上看不出什么", "en": "Nothing shows on my face."},
        {"zh": "你若下令,我会照做", "en": "Give the order, and I obey."},
        {"zh": "你不说话,我就不动", "en": "If you say nothing, I do not move."},
        {"zh": "我歪着头,像在辨认", "en": "I tilt my head as if to recognise."},
        {"zh": "我身上有一处透明了", "en": "A patch of me has gone transparent."},
        {"zh": "你喊了一声,我才动", "en": "You called out, and only then did I move."},
        {"zh": "我的手抬到一半", "en": "My hand stopped halfway up."},
        {"zh": "我不知道该怎么看你", "en": "I do not know how to look at you."},
        {"zh": "你的话我都听见了", "en": "I heard everything you said."},
        {"zh": "你没有自己的判断。", "en": "You make no judgement of your own."},
        {"zh": "我记不住你的脸", "en": "I cannot remember your face."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的边缘散了一点", "en": "My edges have blurred."},
        {"zh": "我重新聚拢身体", "en": "I gather my body together again."},
        {"zh": "这一下没有让我倒", "en": "That did not put me down."},
        {"zh": "我的形状缺了一块", "en": "A piece of my shape is missing."},
        {"zh": "我并没有多疼", "en": "It does not hurt much."},
        {"zh": "我朝主人那边看", "en": "I look toward my master."},
        {"zh": "我的形往后散", "en": "My shape frays backward."},
        {"zh": "召唤的东西也会散", "en": "Summoned things scatter too."},
        {"zh": "散开的地方，慢慢补回来。", "en": "The scattered parts drift slowly back."},
        {"zh": "还得完成命令", "en": "The order must be completed."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手穿过去，拿不住。", "en": "My hand passes through; I cannot hold it."},
        {"zh": "这不算一道命令", "en": "That does not count as an order."},
        {"zh": "我把它推了回去", "en": "I push it back to you."},
        {"zh": "我只听从召唤", "en": "I answer only the summoning."},
        {"zh": "这东西对我不起作用", "en": "That does nothing to me."},
        {"zh": "我看了它一眼", "en": "I glance at it once."},
        {"zh": "我的指头没知觉", "en": "My fingers have no feeling."},
        {"zh": "我不能拿这个", "en": "I cannot take it."},
        {"zh": "召唤物不吃这些东西。", "en": "A summon does not eat such things."},
        {"zh": "我回去继续待命", "en": "I return to standing by."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞过来,我晃了一下", "en": "You bumped me; I swayed."},
        {"zh": "我在原地站住了", "en": "I hold my place."},
        {"zh": "我的身体不太实在", "en": "My body is not quite solid."},
        {"zh": "我的边缘，又慢慢合上。", "en": "My edges slowly close again."},
        {"zh": "我又重新凝起来", "en": "I firm up again."},
        {"zh": "我没有往后退", "en": "I did not step back."},
        {"zh": "这一下让我的边缘散了点", "en": "That blurred my edges a little."},
        {"zh": "我看向主人那边", "en": "I look toward my master."},
        {"zh": "你贴近得过头了", "en": "You are far too close."},
        {"zh": "我在等它决定", "en": "I wait for it to decide."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这不是我被召来的原因", "en": "This is not why I was summoned."},
        {"zh": "召唤的时候，没给我心。", "en": "The summoning gave me no heart."},
        {"zh": "但我可以站在这里", "en": "But I can stand here."},
        {"zh": "你靠近,我也不躲", "en": "Approach; I will not flinch."},
        {"zh": "我的身体是凉的", "en": "My body is cold."},
        {"zh": "我们站在一起", "en": "We stand together."},
        {"zh": "我没有嘴，也不需要。", "en": "I have no mouth, and no need."},
        {"zh": "命令里没有这一段", "en": "The order did not include this."},
        {"zh": "那我就不再动", "en": "Then I will not move again."},
        {"zh": "别让我散成一团", "en": "Do not let me scatter."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰,身体折了一下", "en": "I bend; my body folds."},
        {"zh": "我没有力气拿东西", "en": "I have no strength to hold things."},
        {"zh": "它从我手里穿过去了", "en": "It passed through my hand."},
        {"zh": "我试了第二次", "en": "I try a second time."},
        {"zh": "这一回我拿住了", "en": "This time I have it."},
        {"zh": "冰得像块石头", "en": "Cold as a stone."},
        {"zh": "我不知道该放哪，召唤阵里全是灰。", "en": "I do not know where to put it; the summoning circle is all ash."},
        {"zh": "我把它交给主人", "en": "I hand it to my master."},
        {"zh": "还是你来拿吧", "en": "You take it instead."},
        {"zh": "我把手松开了", "en": "I let my hand open."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "命令已经来了", "en": "The order has come."},
        {"zh": "我的正面朝向你", "en": "My front turns to you."},
        {"zh": "我现在的目标是你", "en": "My target is you now."},
        {"zh": "主人的手一指，我就去。", "en": "My master points, and I go."},
        {"zh": "我朝前迈了一步", "en": "I take one step forward."},
        {"zh": "我的手举了起来", "en": "My hand has come up."},
        {"zh": "我朝那边转过去，很慢。", "en": "I turn that way, very slowly."},
        {"zh": "这不是我想做的", "en": "This is not what I would choose."},
        {"zh": "我只是一段召唤", "en": "I am only a summoning."},
        {"zh": "我照着命令做", "en": "I do as ordered."},
        {"zh": "你要么跑,要么站着", "en": "Run, or stand."},
        {"zh": "我一点也没犹豫", "en": "I did not hesitate at all."},
        {"zh": "我从现在开始", "en": "I start now."},
        {"zh": "我的形状比刚才清楚", "en": "My shape is clearer than before."},
        {"zh": "离你只有两步", "en": "Two steps from you."},
        {"zh": "我已经到你面前", "en": "I am before you now."},
        {"zh": "我的影子朝你那边偏", "en": "My shadow leans your way."},
        {"zh": "我不用呼吸,所以不急", "en": "I do not breathe, so I do not rush."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我从地上爬起来，朝主人那边去。", "en": "I get up off the ground and go to my master."},
        {"zh": "你往哪走,我就往哪走", "en": "Wherever you go, I go."},
        {"zh": "我没有自己的想法", "en": "I have no thoughts of my own."},
        {"zh": "我走过来，脚没有声音。", "en": "I come on without a sound of footfall."},
        {"zh": "我的手一直没有放下", "en": "My hand has not come down."},
        {"zh": "你在寻找退路", "en": "You are seeking a way out."},
        {"zh": "我的身体一直很轻", "en": "My body stays very light."},
        {"zh": "你回头时我还在原地", "en": "When you looked back, I was still there."},
        {"zh": "现在我在你身后了", "en": "Now I am behind you."},
        {"zh": "我是被召唤出来的从属。", "en": "I'm a summoned underling."},
        {"zh": "你听不见我的", "en": "You cannot hear me."},
        {"zh": "可我一直都在", "en": "But I am always here."},
        {"zh": "命令没有变过", "en": "The order has not changed."},
        {"zh": "我还得往前走", "en": "I must keep going."},
        {"zh": "直到你倒下,或我散开", "en": "Until you fall, or I come apart."},
        {"zh": "主人叫我，我就从地上起来", "en": "My master calls and I rise from the ground"},
        {"zh": "我停下来看着", "en": "I stop and watch."},
        {"zh": "这就快结束了", "en": "This will be over soon."},
        {"zh": "我把距离一点点吃掉", "en": "I eat up the distance piece by piece."},
        {"zh": "你很慢,我比你更慢", "en": "You are slow; I am slower."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手通过了你的护甲", "en": "My hand passed through your armour."},
        {"zh": "这一击没什么力", "en": "This blow has little force."},
        {"zh": "我又打了一次", "en": "I strike again."},
        {"zh": "你被推得后退", "en": "You are pushed back."},
        {"zh": "我的手指变得模糊", "en": "My fingers are blurring."},
        {"zh": "我打中的地方在发冷", "en": "Where I struck is going cold."},
        {"zh": "我退开,回到位置", "en": "I withdraw to my position."},
        {"zh": "被召出来的形状，本来就松。", "en": "A summoned shape was always loose."},
        {"zh": "我还能再打一次", "en": "I can strike once more."},
        {"zh": "命令要我继续", "en": "The order says continue."},
        {"zh": "你正在朝后退", "en": "You are backing off."},
        {"zh": "这不在命令里", "en": "That is not in the order."},
        {"zh": "但我不会追远", "en": "But I will not chase far."},
        {"zh": "我得留在这里", "en": "I must stay here."},
        {"zh": "我没办法收力", "en": "I cannot pull the blow."},
        {"zh": "我落手的地方空了", "en": "I struck where you had been."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "召唤先在地上留下一圈痕", "en": "The summoning leaves a ring on the ground."},
        {"zh": "我从中间立起来", "en": "I rise out of the middle."},
        {"zh": "我的形状一点点定住", "en": "My shape settles, bit by bit."},
        {"zh": "主人站在那边", "en": "My master stands over there."},
        {"zh": "我朝他的方向低头", "en": "I bow my head that way."},
        {"zh": "我并没有名字", "en": "I have no name."},
        {"zh": "我在等第一个命令", "en": "I wait for the first order."},
        {"zh": "空气冷了下来", "en": "The air has gone cold."},
        {"zh": "我的边缘还在抖", "en": "My edges are still trembling."},
        {"zh": "我笔直立了起来", "en": "I stand upright."},
        {"zh": "这一具身体不太结实", "en": "This body is not very solid."},
        {"zh": "不过也够用了", "en": "But it will serve."},
        {"zh": "我抬起手,试了试", "en": "I raise a hand to test it."},
        {"zh": "手臂还在原处", "en": "The arm is still there."},
        {"zh": "我等着被指使", "en": "I wait to be directed."},
        {"zh": "你说什么,我就做什么", "en": "Whatever you say, I do."},
        {"zh": "我只存在于这一段时间", "en": "I exist only for this while."},
        {"zh": "用完了就散掉", "en": "When it is done, I scatter."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火穿过我,把我烧薄了", "en": "Fire passes through and thins me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下去,身体散了又聚", "en": "I fall; my body scatters and re-forms."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我身体里穿过去", "en": "Water passes through my body."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我整片吹散", "en": "The blast scatters me whole."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿过去,留下一个洞", "en": "It passes through, leaving a hole."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量与召唤撞在一起", "en": "That force clashes with the summoning."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西,也在慢慢变淡", "en": "I do not eat, and I keep fading."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我走过,我亮了一下", "en": "Lightning passes through and I flare."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有召我的地方", "en": "There is no place that summoned me here."}
      ]
    }
  }
}
