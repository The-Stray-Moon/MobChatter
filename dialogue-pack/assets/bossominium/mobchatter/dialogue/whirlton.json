{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一路转着过去。", "en": "I spin my way across."},
        {"zh": "陀螺似的，我偏着走。", "en": "Like a top, I travel off-axis."},
        {"zh": "转到哪边，我就往哪边。", "en": "Whichever way I spin, that way I go."},
        {"zh": "我的边缘刮着地面。", "en": "My rim scrapes the ground."},
        {"zh": "我摇摇晃晃地滚。", "en": "I roll, wobbling."},
        {"zh": "转得越快，走得越远。", "en": "The faster I spin, the farther I go."},
        {"zh": "我停下了，又接着转。", "en": "I stopped, then spun again."},
        {"zh": "地上的草被带得转。", "en": "The grass turns with me."},
        {"zh": "我打着转贴过去。", "en": "I spin my way close."},
        {"zh": "我偏了一下，又正回来。", "en": "I drifted, then corrected."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢旋着。", "en": "I turn slowly."},
        {"zh": "我原地打转。", "en": "I spin in place."},
        {"zh": "我在等一个方向。", "en": "I am waiting for a direction."},
        {"zh": "转轴响了一声。", "en": "My axis clicked once."},
        {"zh": "这一带很平。", "en": "This ground is flat."},
        {"zh": "我慢慢减速。", "en": "I slow down gradually."},
        {"zh": "我的影子在地上转圈。", "en": "My shadow circles the ground."},
        {"zh": "我又开始转了。", "en": "I am spinning again."},
        {"zh": "刹车在我身上失灵。", "en": "My brakes do not work."},
        {"zh": "周围的东西都在转。", "en": "Everything around me is turning."},
        {"zh": "我看你觉得有点晃。", "en": "You look wobbly to me."},
        {"zh": "转久了，也累。", "en": "Spinning so long is tiring."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站着不动。", "en": "You are standing still."},
        {"zh": "我转着看你。", "en": "I look at you while spinning."},
        {"zh": "你在我眼里转。", "en": "You are revolving in my sight."},
        {"zh": "你比我站得稳。", "en": "You stand steadier than I."},
        {"zh": "我朝你偏过去。", "en": "I drift toward you."},
        {"zh": "你要不要也转一转。", "en": "Do you want a spin too?"},
        {"zh": "我把边沿对准你。", "en": "I aim my rim at you."},
        {"zh": "我朝你偏过去，不偏开。", "en": "I lean toward you, not away."},
        {"zh": "我歪了歪，没栽。", "en": "I tilted but did not fall."},
        {"zh": "别站得那么近。", "en": "Do not stand so near."},
        {"zh": "我这一身，全是转的劲。", "en": "Everything in me is spin."},
        {"zh": "你该退了吧。", "en": "You should back off."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪得厉害。", "en": "I am badly off-axis."},
        {"zh": "转轴卡了一下。", "en": "The axis jammed."},
        {"zh": "我打了半个旋才定。", "en": "I took half a turn to settle."},
        {"zh": "我速度掉下来了。", "en": "My speed dropped."},
        {"zh": "我还能继续转。", "en": "I can keep spinning."},
        {"zh": "我在地上蹭出印子。", "en": "I scraped a mark on the ground."},
        {"zh": "我慢慢找平衡。", "en": "I slowly find my balance."},
        {"zh": "晃得人难受。", "en": "The wobbling is awful."},
        {"zh": "我不会停下来。", "en": "I will not stop."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不靠嘴活。", "en": "I do not live by the mouth."},
        {"zh": "你举多高都白搭。", "en": "However high you hold it, it fails."},
        {"zh": "我看不清那个。", "en": "I cannot focus on that."},
        {"zh": "搁在地面上吧。", "en": "Set it on the ground."},
        {"zh": "我一转起来，就停不下。", "en": "Once I spin, I cannot stop."},
        {"zh": "转久了，我停不下来。", "en": "I have spun too long to stop."},
        {"zh": "那东西不动。", "en": "That thing does not move."},
        {"zh": "我撞了一下，它飞了。", "en": "I hit it, and it flew."},
        {"zh": "我不是饿，是转。", "en": "I am not hungry. I spin."},
        {"zh": "收回你的兜里。", "en": "Back in your pocket."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞上去，你也转。", "en": "I hit you, and you spin too."},
        {"zh": "我的边沿擦过你。", "en": "My rim grazes you."},
        {"zh": "你被带得偏了方向。", "en": "You are pulled off your line."},
        {"zh": "我转得更快了。", "en": "I spun faster."},
        {"zh": "铜边磕出闷声。", "en": "My brass rim knocks out a dull note."},
        {"zh": "我稳住自己。", "en": "I steady myself."},
        {"zh": "你的力气挺大。", "en": "You hit hard."},
        {"zh": "再旋动一次。", "en": "Spin once more."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们往同一个方向转。", "en": "We spin the same way."},
        {"zh": "一起转，才稳。", "en": "Spinning together is steadier."},
        {"zh": "我跟你同步。", "en": "I match your rhythm."},
        {"zh": "别反着方向来。", "en": "Do not spin against me."},
        {"zh": "两个转到一块。", "en": "Two spins come together."},
        {"zh": "我们绕着一个中心。", "en": "We circle one centre."},
        {"zh": "越转就越近。", "en": "The spinning draws us closer."},
        {"zh": "这一带都能听到风声。", "en": "The wind can be heard all round."},
        {"zh": "停下实在太难。", "en": "Stopping is far too hard."},
        {"zh": "接着转下去。", "en": "Keep spinning."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它卷进来。", "en": "I sweep it in."},
        {"zh": "它跟着我转。", "en": "It turns with me."},
        {"zh": "这东西太沉。", "en": "This thing is too heavy."},
        {"zh": "它飞出去了。", "en": "It flew off."},
        {"zh": "我抓它不住。", "en": "I cannot hold it."},
        {"zh": "转太快，看不清。", "en": "I am spinning too fast to see it."},
        {"zh": "它在我边上打转。", "en": "It is circling at my edge."},
        {"zh": "我把它甩掉。", "en": "I fling it off."},
        {"zh": "这玩意儿不顶事。", "en": "This thing does not help."},
        {"zh": "还得再转起来。", "en": "I must keep spinning."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚着压过来。", "en": "I roll in on you."},
        {"zh": "轴心定对了。", "en": "The axis is set."},
        {"zh": "转轴开始快起来。", "en": "My axis is speeding up."},
        {"zh": "你正好在滚动线上。", "en": "You are right on my rolling line."},
        {"zh": "我转着逼近。", "en": "I spin closer."},
        {"zh": "就是那一边。", "en": "That side over there."},
        {"zh": "转速提上去了。", "en": "My spin rate is up."},
        {"zh": "我开始转了。", "en": "I am spinning up."},
        {"zh": "开始起转吧。", "en": "Spinning up."},
        {"zh": "我能撞过去。", "en": "I can hit now."},
        {"zh": "挡不住我的。", "en": "You cannot stop me."},
        {"zh": "撞上就知道了。", "en": "You will know when I hit."},
        {"zh": "你侧脸刚转过来，我已经贴上。", "en": "You turn your cheek and I'm already there."},
        {"zh": "这段够我撞。", "en": "This span will do."},
        {"zh": "转了这么久，就为这一下。", "en": "All this spinning, for this."},
        {"zh": "我转过来了。", "en": "I have spun in."},
        {"zh": "你闪不出去。", "en": "You cannot slip out."},
        {"zh": "我听到你的脚步。", "en": "I heard your steps."},
        {"zh": "把脚踩实了。", "en": "Plant your feet."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一边转一边靠近。", "en": "I close in while spinning."},
        {"zh": "你走到哪，我偏到哪。", "en": "Wherever you go, I drift there."},
        {"zh": "转得越快，我的边越利。", "en": "The faster I spin, the keener my edge."},
        {"zh": "速度还没到。", "en": "The speed is not there yet."},
        {"zh": "我一直在蓄力。", "en": "I am still winding up."},
        {"zh": "地上的痕迹是我的。", "en": "The marks on the ground are mine."},
        {"zh": "再转上两圈。", "en": "Two more turns."},
        {"zh": "快要够了吧。", "en": "Almost enough."},
        {"zh": "你看我转，就慢了。", "en": "Watching me spin slows you down."},
        {"zh": "我一直在靠近。", "en": "I keep getting closer."},
        {"zh": "你贴在墙根。", "en": "You are flat to the wall's foot."},
        {"zh": "这个角度会撞上。", "en": "This angle will connect."},
        {"zh": "我算着你的位置。", "en": "I am working out your position."},
        {"zh": "转速还在涨。", "en": "The spin is still rising."},
        {"zh": "别把眼移开。", "en": "Do not shift your eyes."},
        {"zh": "这一撞有分量。", "en": "This hit has weight."},
        {"zh": "快旋到你了。", "en": "Almost spun into you."},
        {"zh": "我转起来，风先刮到你。", "en": "I spin up and the wind hits you first."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "边沿切过你的腿。", "en": "My rim cuts across your legs."},
        {"zh": "你被转得站不稳。", "en": "The spin leaves you unsteady."},
        {"zh": "我弹开，又转回来。", "en": "I rebound and come back."},
        {"zh": "这一下带着旋劲。", "en": "That one carried spin."},
        {"zh": "我自己也偏了。", "en": "I went off my line too."},
        {"zh": "我又加快转速。", "en": "I spin faster again."},
        {"zh": "你挡不住侧面。", "en": "You cannot guard your flank."},
        {"zh": "我弹开，石屑飞了一地。", "en": "I bounce off and stone chips fly."},
        {"zh": "我摆了两摆才住。", "en": "I rocked twice before settling."},
        {"zh": "再碰你一记。", "en": "One more knock."},
        {"zh": "你退了开去。", "en": "You drew back."},
        {"zh": "我还在转着。", "en": "I am still spinning."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地上刮起一阵旋风。", "en": "A small whirl rises off the ground."},
        {"zh": "我转着落地。", "en": "I land spinning."},
        {"zh": "我的边缘先着地。", "en": "My rim touches down first."},
        {"zh": "周围的草都倒向一边。", "en": "The grass all leans one way."},
        {"zh": "我摇摇晃晃地立住。", "en": "I right myself, wobbling."},
        {"zh": "我越转越快。", "en": "I spin faster and faster."},
        {"zh": "风把沙卷起来。", "en": "The wind lifts the sand."},
        {"zh": "我找了个平地。", "en": "I found flat ground."},
        {"zh": "我转着看四周。", "en": "I look around while spinning."},
