{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩过的地方石头都松了。", "en": "Stones loosen where I step."},
        {"zh": "我的躯干上刻着旧纹。", "en": "Old carvings run over my frame."},
        {"zh": "我一步一步走向光。", "en": "I walk toward the light, step by step."},
        {"zh": "我身上带着很久的味道。", "en": "I carry the smell of a long time ago."},
        {"zh": "关节转动时发出低响。", "en": "My joints turn with a low grind."},
        {"zh": "尘土在我脚后面翻起。", "en": "Dust rolls up behind my feet."},
        {"zh": "我的影子被刻在地上。", "en": "My shadow is carved on the ground."},
        {"zh": "我走的路线很直。", "en": "I walk in a straight line."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，像一块立起来的碑。", "en": "I stand like an upright slab."},
        {"zh": "我的呼吸几乎听不见。", "en": "My breath is almost inaudible."},
        {"zh": "旧纹上落了灰。", "en": "Dust settles in the old carvings."},
        {"zh": "我抬头看顶上的光。", "en": "I look up at the light above."},
        {"zh": "我的手指慢慢收拢。", "en": "My fingers close slowly."},
        {"zh": "这里以前有台阶。", "en": "There used to be steps here."},
        {"zh": "我数着光移动。", "en": "I've watched the light move."},
        {"zh": "我身上的裂纹有一道新的。", "en": "One of my cracks is new."},
        {"zh": "我等着就是了。", "en": "I'll simply wait."},
        {"zh": "我的重量让地板下沉。", "en": "My weight sinks the floor."},
        {"zh": "有东西在很远的地方。", "en": "Something is far away."},
        {"zh": "我再次看向入口。", "en": "I look at the entrance again."},
        {"zh": "我把手放在腰侧。", "en": "I set a hand at my side."},
        {"zh": "我看着灰在光里飘。", "en": "I watch the dust drift in the light."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于来了。", "en": "You've come at last."},
        {"zh": "我等有人来已经很久。", "en": "I've waited a long while for someone."},
        {"zh": "我的身体比这座厅还旧。", "en": "My body is older than this hall."},
        {"zh": "我的眼睛不太亮了。", "en": "My eyes aren't very bright."},
        {"zh": "你脚边有一块断石。", "en": "There's a broken stone at your feet."},
        {"zh": "你身上没有旧的味道。", "en": "You carry no smell of the old days."},
        {"zh": "我低头，看见你的脸。", "en": "I look down and see your face."},
        {"zh": "你还算有胆量。", "en": "You've some courage."},
        {"zh": "我不会先退。", "en": "I won't retreat first."},
        {"zh": "你听得懂我说话吗？", "en": "Can you understand me?"},
        {"zh": "这座厅是我的。", "en": "This hall is mine."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了一步，石屑落下。", "en": "I step back; stone chips fall."},
        {"zh": "打在我身上，声音很闷。", "en": "The blow lands dull on me."},
        {"zh": "我低头看那道痕。", "en": "I look down at the mark."},
        {"zh": "我的手臂慢了一点。", "en": "My arm slows a little."},
        {"zh": "旧纹暗了一瞬。", "en": "The carvings dim for an instant."},
        {"zh": "我没有一句声音。", "en": "Not a sound from me."},
        {"zh": "这具身体早已不新。", "en": "This body has long stopped being new."},
        {"zh": "我把身体撑直。", "en": "I haul myself upright."},
        {"zh": "你比我预想的有力。", "en": "You're stronger than I expected."},
        {"zh": "我还立在原地。", "en": "I'm still standing here."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里有材料。", "en": "You carry materials."},
        {"zh": "那东西能做装备。", "en": "That could become equipment."},
        {"zh": "拿过来给我看。", "en": "Bring it here to show me."},
        {"zh": "我要的是碎片。", "en": "What I want is fragments."},
        {"zh": "你在哪里找到的？", "en": "Where did you find it?"},
        {"zh": "它和我身上的很像。", "en": "It looks like what's on me."},
        {"zh": "我伸出手又停住。", "en": "I reach, and stop."},
        {"zh": "这些还太少。", "en": "This is still too little."},
        {"zh": "你把它收好。", "en": "Keep it safe."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "遗迹的石头，跟着我动。", "en": "Ruin stones move with me."},
        {"zh": "地面被我们压出裂。", "en": "The floor cracks between us."},
        {"zh": "我垂眼看了一下。", "en": "I glance down."},
        {"zh": "灰落在我们之间。", "en": "Ash falls between us."},
        {"zh": "你站得还算稳。", "en": "You're still standing fairly well."},
        {"zh": "你也敢撞我？这可是古老的骨头。", "en": "You dare bump into me? These bones are ancient."},
        {"zh": "退后，我的躯壳不容轻视。", "en": "Step back — this shell is not to be trifled with."},
        {"zh": "每一次碰撞，都在唤醒旧日的怒火。", "en": "Every collision wakes an older anger."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "只剩我一个了。", "en": "I'm the only one left."},
        {"zh": "这一族早就断了。", "en": "My kind ended long ago."},
        {"zh": "我记不清还有几个。", "en": "I can't recall how many there were."},
        {"zh": "我听见回声，以为是别人。", "en": "I heard an echo and thought it was someone."},
        {"zh": "这里太静了。", "en": "It's too quiet here."},
        {"zh": "我把它们都刻在了身上。", "en": "I carved them all on my body."},
        {"zh": "没有谁再来了。", "en": "No one comes anymore."},
        {"zh": "我站着，等一个不会来的人。", "en": "I stand, waiting for someone who won't come."},
        {"zh": "我的名字快忘了。", "en": "I'm forgetting my own name."},
        {"zh": "只剩下这些纹。", "en": "Only these carvings remain."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起一块碎石。", "en": "I pick up a broken stone."},
        {"zh": "它在我手里很小。", "en": "It's small in my hand."},
        {"zh": "我看了一会儿。", "en": "I look at it a while."},
        {"zh": "这块有旧纹。", "en": "This one carries old carvings."},
        {"zh": "我把它嵌回原处。", "en": "I fit it back in place."},
        {"zh": "我手一碰就碎。", "en": "It crumbles at my touch."},
        {"zh": "你捡你的吧。", "en": "Pick up what you like."},
        {"zh": "被举起来？我可不轻。", "en": "Lifted up? I am heavier than I look."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我察觉到你。", "en": "I've noticed you."},
        {"zh": "我的头转过来。", "en": "My head turns."},
        {"zh": "这一厅都是我的。", "en": "This hall is mine."},
        {"zh": "我开始走动。", "en": "I begin to move."},
        {"zh": "我的脚印压碎了石板。", "en": "My prints break the flagstones."},
        {"zh": "你走得很安静。", "en": "You move quietly."},
        {"zh": "我等你动手。", "en": "I wait for you to strike."},
        {"zh": "旧纹亮了一下。", "en": "The old carvings glow once."},
        {"zh": "我还记得怎么打。", "en": "I still remember how to fight."},
        {"zh": "我的步子重了。", "en": "My steps grow heavier."},
        {"zh": "我不会留余地。", "en": "I'll leave no quarter."},
        {"zh": "我这一身旧石头，还没散。", "en": "This old stone body of mine hasn't crumbled."},
        {"zh": "现在也够了。", "en": "That's enough now."},
        {"zh": "我就这么过去。", "en": "I come over like this."},
        {"zh": "脚下的石在震。", "en": "The stone shakes underfoot."},
        {"zh": "石头里的我，听见脚步了。", "en": "The me inside the stone hears footsteps."},
        {"zh": "我的指节一根根松开。", "en": "My finger joints loosen one by one."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我穿过厅堂跟着。", "en": "I follow through the hall."},
        {"zh": "你的脚步在我这里很轻。", "en": "Your steps are light to me."},
        {"zh": "石柱挡不住我的视线。", "en": "Columns don't block my view."},
        {"zh": "断柱被我拨到墙边。", "en": "I shove the broken pillar against the wall."},
        {"zh": "你我之间越来越短。", "en": "The space between us shrinks."},
        {"zh": "你一直在绕圈。", "en": "You keep circling."},
        {"zh": "我不跟着绕。", "en": "I won't circle with you."},
        {"zh": "尘土把光遮住了。", "en": "Dust has dimmed the light."},
        {"zh": "四百五十点生命，听你喘气。", "en": "Four hundred fifty health, hearing you breathe."},
        {"zh": "你退到台阶上了。", "en": "You've backed onto the steps."},
        {"zh": "上面没有出口。", "en": "There's no exit up there."},
        {"zh": "我跨过塌掉的门槛。", "en": "I step over the collapsed threshold."},
        {"zh": "我把手举到肩高。", "en": "I raise my hand to shoulder height."},
        {"zh": "你竟然没有躲。", "en": "You didn't dodge."},
        {"zh": "这样也可以。", "en": "That will do as well."},
        {"zh": "这一下很慢，但很重。", "en": "This is slow, but heavy."},
        {"zh": "我把重心压过去。", "en": "I lean my weight in."},
        {"zh": "我的影子从石柱后压过来。", "en": "My shadow presses in from behind the columns."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一拳砸下去，石板碎了。", "en": "My fist lands and the flagstones break."},
        {"zh": "你被推得滑了很远。", "en": "You slide a long way back."},
        {"zh": "我的肩撞在你的护甲上。", "en": "My shoulder meets your armour."},
        {"zh": "灰从顶上落下来。", "en": "Ash falls from the ceiling."},
        {"zh": "这一下用了旧纹的力。", "en": "That one used the old carvings' strength."},
        {"zh": "你的甲凹了，人还立着。", "en": "Your armor is dented, yet you still stand."},
        {"zh": "远古残骸的两手都抬起。", "en": "Both hands of the ancient remnant rise."},
        {"zh": "地面裂了半格。", "en": "The floor splits half a block."},
        {"zh": "我的拳陷进石地半寸。", "en": "My fist sinks half an inch into the stone floor."},
        {"zh": "我压近了一格。", "en": "I gain a block."},
        {"zh": "这倒挺难得。", "en": "That's rare enough."},
        {"zh": "我顿住不动。", "en": "I come to a halt."},
        {"zh": "只是为了看清你。", "en": "Only to see you clearly."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "厅里的灰先动了一下。", "en": "The ash in the hall shifts first."},
        {"zh": "我从阴影里站起来。", "en": "I rise out of the shadow."},
        {"zh": "旧纹上亮起了光。", "en": "Light comes up in the old carvings."},
        {"zh": "地面被我的重量压沉。", "en": "The floor sinks under my weight."},
        {"zh": "我身上落满了灰。", "en": "I'm covered in dust."},
        {"zh": "这里很久没有声音了。", "en": "There's been no sound here for a long time."},
        {"zh": "我慢慢伸直身体。", "en": "I straighten slowly."},
        {"zh": "顶上有光漏下来。", "en": "Light leaks from above."},
        {"zh": "我听见自己的关节。", "en": "I hear my own joints."},
        {"zh": "我开始想起一些事。", "en": "I begin to remember things."},
        {"zh": "这一步我走了很久才迈出。", "en": "That step took me a long time."},
        {"zh": "我一直等着你。", "en": "I've been waiting for you."},
        {"zh": "灰尘散开后是我。", "en": "When the dust clears, there's me."},
        {"zh": "这个地方还是老样子。", "en": "This place is still the same."},
        {"zh": "我仰起头看厅顶。", "en": "I raise my head to the vault."},
        {"zh": "风从门里进来。", "en": "Wind comes through the door."},
        {"zh": "我的影子先立起来。", "en": "My shadow stands up first."},
        {"zh": "然后是我的身体。", "en": "Then my body."},
        {"zh": "这一次我不睡了。", "en": "I won't sleep this time."},
        {"zh": "残骸响了，那就开始吧。", "en": "The remnant rattles — let's begin."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在旧纹上烧，爆开细纹。", "en": "Fire burns on the carvings; fine cracks open."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地时砸碎了脚下的石。", "en": "I land and shatter the stone below."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的缝里，动作变钝。", "en": "Water fills my seams; my movement dulls."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响在胸前进开，灰飞满天。", "en": "The blast opens at my chest; ash fills the air."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "几根尖物嵌进我的关节。", "en": "Points lodge in my joints."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "有股力压在旧纹上。", "en": "Force bears down on the carvings."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我空得太久，力气在退。", "en": "Empty so long, my strength ebbs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击上下贯通，我僵了一瞬。", "en": "Lightning runs through; I lock up for a moment."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里连灰都没有。", "en": "Not even ash here."}
      ]
    }
  }
}
