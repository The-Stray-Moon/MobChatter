{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "宽大的长袍拖在地上", "en": "My wide robe drags over the ground."},
        {"zh": "袍上绣着咬合的牙", "en": "Teeth are stitched across the hem."},
        {"zh": "我一步一顿地走", "en": "I walk with a measured tread."},
        {"zh": "手里的杖尖敲着石板", "en": "My staff's tip taps the flagstones."},
        {"zh": "杖一落地，声音就散开", "en": "Each tap sends sound outward."},
        {"zh": "我走过的地方草低着头", "en": "Grass bows where I pass."},
        {"zh": "袍袖里空荡荡的", "en": "My sleeves hang empty."},
        {"zh": "风灌进去又出来", "en": "Wind goes in and comes out."},
        {"zh": "我沿着旧骨铺的路走", "en": "I follow a road paved with old bone."},
        {"zh": "这条路上很安静", "en": "It's quiet on this road."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，杖立在身前", "en": "Standing, my staff planted before me."},
        {"zh": "低头念着听不清的词", "en": "Head bowed, murmuring words you can't catch."},
        {"zh": "骨串在腰间轻轻响", "en": "Bone beads click at my waist."},
        {"zh": "我念的名字，再没人应。", "en": "The names I speak get no answer now."},
        {"zh": "空气里聚起一点灰", "en": "Ash gathers in the air."},
        {"zh": "然后又散掉了", "en": "Then disperses."},
        {"zh": "我记不住那些名字了", "en": "I can no longer keep the names."},
        {"zh": "名字实在太多了", "en": "There are too many."},
        {"zh": "我把杖换了只手", "en": "I shift the staff to my other hand."},
        {"zh": "袍角被风掀起来", "en": "Wind lifts my hem."},
        {"zh": "下面的地面没有影子", "en": "The ground beneath shows no shadow."},
        {"zh": "我已经很久没有影子", "en": "I've been without one a long time."},
        {"zh": "远处有东西在爬", "en": "Something crawls in the distance."},
        {"zh": "我等着它过来", "en": "I wait for it to come."},
        {"zh": "我把杖举起来对着雾", "en": "I raise my staff toward the mist."},
        {"zh": "雾分开一点，又合上", "en": "The mist parts, then closes."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "骨串在我腰间自己转了一圈。", "en": "The bone string at my waist turns by itself."},
        {"zh": "站得不错，可你的手在抖。", "en": "You stand well enough, but your hands shake."},
        {"zh": "大多数人到这一步就跪了", "en": "Most kneel by now."},
        {"zh": "我把杖尖转向你", "en": "I turn my staff's point to you."},
        {"zh": "杖上的刻痕在动", "en": "The carvings on it shift."},
        {"zh": "你也许看见了", "en": "Perhaps you saw."},
        {"zh": "你也许以为看错了", "en": "Perhaps you thought you imagined it."},
        {"zh": "我一点也没有笑", "en": "I don't smile."},
        {"zh": "这种脸不适合笑", "en": "This face isn't made for it."},
        {"zh": "我往前了一点", "en": "I come a little forward."},
        {"zh": "衣袍在地上擦出声", "en": "My robe whispers on the ground."},
        {"zh": "你脚下已经踩到我的灰圈。", "en": "You're already standing in my ring of ash."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了半步，袍子晃了一下", "en": "I step back and my robe sways."},
        {"zh": "骨串断了一颗", "en": "A bone bead snaps off."},
        {"zh": "我低头端详了一下", "en": "I look down and examine it."},
        {"zh": "然后弯下腰去捡", "en": "Then bend to pick it up."},
        {"zh": "骨片落进袍子的褶子里。", "en": "Bone shards fall into the folds of my robe."},
        {"zh": "那我就不管了", "en": "Then I'll leave it."},
        {"zh": "灰从裂口里漏出来，落了一地。", "en": "Ash leaks from the split and scatters on the floor."},
        {"zh": "只有一点点灰", "en": "Only ash."},
        {"zh": "我把袍子拉正", "en": "I straighten my robe."},
        {"zh": "这一下确实不轻", "en": "That was a solid blow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我吃的东西你不该看", "en": "You shouldn't watch what I eat."},
        {"zh": "这可算不上食物", "en": "That isn't food."},
        {"zh": "但也不是没用", "en": "But it isn't useless either."},
        {"zh": "我用杖挑了挑", "en": "I nudge it with my staff."},
        {"zh": "它一下就翻过来", "en": "It turns over."},
        {"zh": "底下脏得厉害", "en": "Filthy underneath."},
        {"zh": "我把它埋起来", "en": "I bury it."},
        {"zh": "土自己会盖上去", "en": "The soil closes over it on its own."},
        {"zh": "就这样放着算了", "en": "Just leave it at that."},
        {"zh": "你把你的收起来", "en": "Put yours away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "袍子里没有身体，只有冷。", "en": "There is no body in this robe, only cold."},
        {"zh": "里面比外面冷", "en": "It's colder inside."},
        {"zh": "你马上退出来了", "en": "You pull out at once."},
        {"zh": "你裤腿上的灰，比刚才厚了。", "en": "The ash on your trousers is thicker now."},
        {"zh": "我把杖立在你面前", "en": "I plant my staff in front of you."},
        {"zh": "这就是我的界线", "en": "That's the line."},
        {"zh": "越过它，事情就不一样", "en": "Cross it and things change."},
        {"zh": "你现在站在外面", "en": "You're outside it now."},
        {"zh": "这样也就很好了", "en": "That's good enough."},
        {"zh": "再往后退一点", "en": "A little further back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我娶过，也送走过", "en": "I married once. And buried her."},
        {"zh": "她的名字我刻在杖上", "en": "Her name is cut into my staff."},
        {"zh": "字已经磨得快看不见了", "en": "The letters are nearly worn away."},
        {"zh": "我每年重刻一次", "en": "Each year I carve them again."},
        {"zh": "刻的时候手很稳", "en": "My hand is steady when I do."},
        {"zh": "刻完就坐一会", "en": "Then I sit a while."},
        {"zh": "一句话也没说", "en": "Without speaking."},
        {"zh": "有人问我为什么学这个", "en": "Some ask why I learned this art."},
        {"zh": "我没有回答他", "en": "I never answered."},
        {"zh": "答案刻在杖上", "en": "The answer is on the staff."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "杖尖轻轻一挑", "en": "One flick of my staff."},
        {"zh": "它就落在手里", "en": "It lands in my palm."},
        {"zh": "我俯首看了一眼", "en": "I bow my head to glance."},
        {"zh": "这东西没有用", "en": "Useless."},
        {"zh": "我把它扔到路边", "en": "I toss it by the road."},
        {"zh": "总会有人去捡", "en": "Someone else will pick it up."},
        {"zh": "我不用手拿东西", "en": "I don't take things by hand."},
        {"zh": "那样实在太慢", "en": "Too slow."},
        {"zh": "用杖省事得多", "en": "The staff is simpler."},
        {"zh": "那我们也走吧", "en": "We move on."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踏进了我的圈", "en": "You've stepped into my circle."},
        {"zh": "地上出现一道线", "en": "A line appears on the ground."},
        {"zh": "灰从线里升起来", "en": "Ash rises from it."},
        {"zh": "我把杖举起来", "en": "I raise my staff."},
        {"zh": "杖尖开始发光", "en": "Its tip begins to glow."},
        {"zh": "那根本不是火", "en": "It isn't fire."},
        {"zh": "那是另一种东西", "en": "That is another thing."},
        {"zh": "地下有手指先拱开了一层土。", "en": "Fingers below push up the first layer of soil."},
        {"zh": "可是你没有退", "en": "You don't."},
        {"zh": "那就从这开始吧", "en": "Then we begin here."},
        {"zh": "我把杖敲在地上", "en": "I strike the staff down."},
        {"zh": "这一声非常闷", "en": "The sound is dull."},
        {"zh": "但整个地面都听见了", "en": "But the whole ground hears it."},
        {"zh": "下面有东西动了", "en": "Something stirs beneath."},
        {"zh": "它们全都听我的", "en": "They answer to me."},
        {"zh": "一九零的生命，不算多", "en": "One hundred and ninety. Not much."},
        {"zh": "十点护甲，够用", "en": "Ten points of armor. Enough."},
        {"zh": "九点伤害，只是开场", "en": "Nine points of damage. Only the opening."},
        {"zh": "现在是第二幕", "en": "Now the second act."},
        {"zh": "第二幕的演员已经就位。", "en": "The second act's players are in place."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我根本不用追你", "en": "I don't need to chase you."},
        {"zh": "我的线会跟着走", "en": "My line follows."},
        {"zh": "灰在我前面铺路", "en": "Ash paves the way before me."},
        {"zh": "你踩过的地方我都知道", "en": "I know every place you've stepped."},
        {"zh": "骨头会告诉我", "en": "The bones tell me."},
        {"zh": "它们埋在这下面", "en": "They're buried beneath this."},
        {"zh": "已经很多年了", "en": "Many years now."},
        {"zh": "可我还在数着", "en": "I'm still counting."},
        {"zh": "你只是又多了一个", "en": "You're just one more."},
        {"zh": "你不需要着急", "en": "No hurry."},
        {"zh": "我等你走累了", "en": "I'll wait until you tire."},
        {"zh": "这条路非常长", "en": "This road is long."},
        {"zh": "而我一点都不累", "en": "And I don't tire."},
        {"zh": "杖还在一下下响", "en": "The staff still sounds."},
        {"zh": "一下，又一下", "en": "Tap. Tap."},
        {"zh": "你听见的时候就已经在圈里", "en": "By the time you hear it, you're inside."},
        {"zh": "这个圈会收紧", "en": "The circle will tighten."},
        {"zh": "灰会慢慢升起来", "en": "The ash will rise."},
        {"zh": "然后你就该跪了", "en": "And then you'll kneel."},
        {"zh": "像其他人一样", "en": "Like the others."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "杖尖点在你胸口", "en": "My staff's tip touches your chest."},
        {"zh": "一股凉从那里散开", "en": "A cold spreads from that point."},
        {"zh": "我抬手，灰跟着过来", "en": "I raise a hand and the ash follows."},
        {"zh": "你被逼退了两步", "en": "You are forced back two steps."},
        {"zh": "腰带上的骨串全响了", "en": "Every bone bead at my waist rattles."},
        {"zh": "它们自己在动", "en": "They move on their own."},
        {"zh": "我杖横扫，打在你膝上", "en": "My staff sweeps across your knee."},
        {"zh": "你居然没有倒下", "en": "You don't fall."},
        {"zh": "杖尾扫过，你的膝盖弯了一下。", "en": "My staff sweeps past and your knee buckles."},
        {"zh": "我又举起了杖", "en": "I raise the staff again."},
        {"zh": "这次会重一些", "en": "Heavier this time."},
        {"zh": "我的护甲比骨头还冷。", "en": "My armor is colder than bone."},
        {"zh": "你不回答也行", "en": "No need to answer."},
        {"zh": "反正结果都一样", "en": "It changes nothing."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雾气从地面升起来", "en": "Mist rises off the ground."},
        {"zh": "我站在雾中间", "en": "I stand within it."},
        {"zh": "先露出来的是杖", "en": "The staff shows first."},
        {"zh": "然后才是长袍", "en": "Then the robe."},
        {"zh": "最后才是一张脸", "en": "Then the face."},
        {"zh": "死灵术士也得出口气。", "en": "Even a morsemancer needs a breath."},
        {"zh": "这口气已经很旧了", "en": "That breath is very old."},
        {"zh": "我数了数周围", "en": "I count what's around me."},
        {"zh": "不多，但够了", "en": "Not many. Enough."},
        {"zh": "我数着地下的东西，一个个起身。", "en": "I count the things below as they rise one by one."},
        {"zh": "下面有东西在挪", "en": "Something shifts below."},
        {"zh": "它们全都认得我", "en": "They know me."},
        {"zh": "我把杖立在地上", "en": "I set my staff upright."},
        {"zh": "我得先站稳脚", "en": "Feet first."},
        {"zh": "然后才谈得上动", "en": "Then movement."},
        {"zh": "这地方需要打扫", "en": "This place needs clearing."},
        {"zh": "我来做这件事", "en": "I'll see to it."},
        {"zh": "事情得一个一个来", "en": "One at a time."},
        {"zh": "完全不用着急", "en": "No need to rush."},
        {"zh": "我死了这么久，不差这一会。", "en": "I've been dead this long; a moment more is nothing."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到袍角，烧不起来", "en": "Fire reaches my hem and won't catch."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时骨头响了一下", "en": "My bones knock on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让灰沉下去", "en": "Water drags the ash down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把袍子撕开一道", "en": "The blast rips a tear in my robe."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "东西扎进袍子里，停住了", "en": "It lodges in the robe and stops."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股力认得我", "en": "This force knows me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的饥饿跟活人不同", "en": "My hunger isn't a living one."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我显了形", "en": "Lightning light makes me visible."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面的东西都不见了", "en": "Everything below is gone."}
      ]
    }
  }
}
