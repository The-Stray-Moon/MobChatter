{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我背着货箱往前。", "en": "I walk on with my crate on my back."},
        {"zh": "绿宝石在我兜里响。", "en": "Emeralds clink in my pouch."},
        {"zh": "我一步一晃地走。", "en": "I sway with each step."},
        {"zh": "货架上挂着零碎。", "en": "Oddments hang from my rack."},
        {"zh": "我压低帽子。", "en": "I pull my hat down."},
        {"zh": "走两步，我还是回了头。", "en": "Two steps on, I still look back."},
        {"zh": "路上的沙在我脚下响。", "en": "Sand sounds under my feet."},
        {"zh": "我不急着赶路。", "en": "I am in no hurry."},
        {"zh": "我绕过那片岩浆。", "en": "I go around the lava pool."},
        {"zh": "货箱压得我驼着背。", "en": "The crate bows my back."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在箱子上歇。", "en": "I sit on the crate to rest."},
        {"zh": "我数着绿宝石。", "en": "I count my emeralds."},
        {"zh": "我把货摆整齐。", "en": "I line up my goods."},
        {"zh": "这里没人买东西。", "en": "Nobody buys anything here."},
        {"zh": "我把帽檐往下压了压。", "en": "I pull my brim a little lower."},
        {"zh": "沙吹进了货箱。", "en": "Sand blew into the crate."},
        {"zh": "我鼻子里哼出一声。", "en": "I snort through my nose."},
        {"zh": "我看了半天价。", "en": "I have been looking at prices a long while."},
        {"zh": "我的手一直在袖子里。", "en": "My hands stay in my sleeves."},
        {"zh": "我慢慢摇着头。", "en": "I shake my head slowly."},
        {"zh": "我在算这一趟赚多少。", "en": "I am working out this trip's profit."},
        {"zh": "脖子上的挂坠很凉。", "en": "The charm at my neck is cold."},
        {"zh": "我站着等客人。", "en": "I stand and wait for customers."},
        {"zh": "没人来的路上最安静。", "en": "The empty road is the quietest."},
        {"zh": "我把货箱盖扣紧。", "en": "I latch the crate's lid."},
        {"zh": "我用袖子擦了擦货。", "en": "I wipe the goods with my sleeve."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "客人？还是别的。", "en": "A customer? Or something else?"},
        {"zh": "你手里有绿宝石吗。", "en": "Do you have emeralds?"},
        {"zh": "我的货不便宜。", "en": "My goods are not cheap."},
        {"zh": "你看起来不像来买的。", "en": "You do not look like a buyer."},
        {"zh": "我把手抽出来。", "en": "I draw my hands from my sleeves."},
        {"zh": "退开，别贴着我的货。", "en": "Step back. Don't crowd my goods."},
        {"zh": "我这里的价，一分不让。", "en": "My prices do not move a coin."},
        {"zh": "你要买什么。", "en": "What do you want to buy."},
        {"zh": "你看我的货箱做什么。", "en": "Why are you looking at my crate?"},
        {"zh": "我笑了，笑得不好看。", "en": "I smiled, and it was not a nice smile."},
        {"zh": "生意不好做。", "en": "Business is hard."},
        {"zh": "这一趟，我亏了太多。", "en": "I have lost too much on this trip."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我踉跄了半步。", "en": "I staggered half a step."},
        {"zh": "帽檐压到我的眼睛上。", "en": "My brim has slid over my eyes."},
        {"zh": "货箱上溅了血。", "en": "Blood on the crate."},
        {"zh": "我捂着侧肋。", "en": "I hold my side."},
        {"zh": "我咧嘴笑，牙上带血。", "en": "I grin with blood on my teeth."},
        {"zh": "这一下该加钱。", "en": "That will cost extra."},
        {"zh": "我退开，护住箱子。", "en": "I back off, shielding the crate."},
        {"zh": "我还没算完账。", "en": "I have not settled the account."},
        {"zh": "沙上多了几点红。", "en": "A few red spots on the sand."},
        {"zh": "你下手真狠。", "en": "You hit hard."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "绿宝石？拿来我看看。", "en": "Emeralds? Let me see them."},
        {"zh": "这不是买卖。", "en": "This is not a trade."},
        {"zh": "你出价太低。", "en": "Your offer is too low."},
        {"zh": "再多添一点。", "en": "Add a little more."},
        {"zh": "我收下了吧。", "en": "I accept."},
        {"zh": "这买卖，我做。", "en": "I will take this deal."},
        {"zh": "放下，放在沙上让我看。", "en": "Set it down on the sand and let me look."},
        {"zh": "我们讲讲价。", "en": "Let us haggle."},
        {"zh": "别拿假货糊弄我。", "en": "Do not pass me fakes."},
        {"zh": "成交，但也别高兴。", "en": "Done, but do not celebrate."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我护住货箱。", "en": "I shield the crate."},
        {"zh": "你撞掉了我的货。", "en": "You knocked my goods loose."},
        {"zh": "我被撞得往边上歪。", "en": "The bump throws me off balance."},
        {"zh": "绿宝石撒了一地。", "en": "Emeralds spilled on the ground."},
        {"zh": "我弯下腰去抓散落的货。", "en": "I stoop to grab the scattered goods."},
        {"zh": "你踩坏了我的箱子。", "en": "You broke my crate."},
        {"zh": "我从帽檐底下瞪你。", "en": "I glare at you from under my brim."},
        {"zh": "这一撞，我要算钱的。", "en": "I will charge you for that."},
        {"zh": "我退开，护着货。", "en": "I back off, guarding the goods."},
        {"zh": "箱子是我的，手拿开。", "en": "The crate is mine; hands off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同行之间，不谈价。", "en": "Among traders, we do not discuss prices."},
        {"zh": "这条路上的生意，分着做。", "en": "We split the trade on this road."},
        {"zh": "你走东边，我走西边。", "en": "You take east, I take west."},
        {"zh": "别抢我的客人。", "en": "Do not take my customers."},
        {"zh": "货还在，人就还在。", "en": "Goods here, and me with them."},
        {"zh": "我们都被欠过账。", "en": "We have both been cheated."},
        {"zh": "那一趟，我再没回来过。", "en": "That trip, I never came back from."},
        {"zh": "你听见那声召唤了吗。", "en": "Did you hear that summons?"},
        {"zh": "灵魂沙上，火还在烧。", "en": "The fire still burns on the soul sand."},
        {"zh": "我们一起回去。", "en": "We go back together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我翻过来看过。", "en": "I turned it over to look."},
        {"zh": "这个还能卖出。", "en": "This can still be sold."},
        {"zh": "这玩意儿卖不出价。", "en": "This thing won't fetch a price."},
        {"zh": "我塞进箱子。", "en": "I drop it in the crate."},
        {"zh": "我丢在沙里。", "en": "I drop it in the sand."},
        {"zh": "上面还有灰。", "en": "There is still ash on it."},
        {"zh": "这样的货我以前收过。", "en": "I've taken goods like this before."},
        {"zh": "不值这个价。", "en": "Not worth that price."},
        {"zh": "这是好东西。", "en": "This is good stock."},
        {"zh": "装进箱子里。", "en": "Into the crate."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你动了我的货。", "en": "You touched my goods."},
        {"zh": "我把箱子放下。", "en": "I set the crate down."},
        {"zh": "我把腰撑直。", "en": "I straighten my back."},
        {"zh": "这一趟不能白亏。", "en": "This trip will not be a total loss."},
        {"zh": "我等你等得够久了。", "en": "I have waited long enough."},
        {"zh": "你不是客人。", "en": "You are no customer."},
        {"zh": "我们算算账。", "en": "Let us settle the account."},
        {"zh": "我从袖子里抽出东西。", "en": "I draw something from my sleeve."},
        {"zh": "别想着走吧。", "en": "Do not think of leaving."},
        {"zh": "生意谈崩了。", "en": "The deal has fallen through."},
        {"zh": "这次由我来定价。", "en": "This time I set the price."},
        {"zh": "脚放稳，别想着挪。", "en": "Keep your feet planted. Don't shift."},
        {"zh": "你还欠着我。", "en": "You still owe me."},
        {"zh": "该结清账了。", "en": "Time to settle the account."},
        {"zh": "我一直数着。", "en": "I have been counting."},
        {"zh": "抬头，看我这张脸。", "en": "Look up. Look at this face."},
        {"zh": "记住这一笔。", "en": "Remember this debt."},
        {"zh": "我来收这笔账。", "en": "I come to collect."},
        {"zh": "轮到你付账。", "en": "Your turn to pay."},
        {"zh": "这一笔，很贵。", "en": "This one is expensive."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你的步幅我一清二楚。", "en": "I know your stride by heart."},
        {"zh": "你走快些也没用。", "en": "Walking fast will not help."},
        {"zh": "货箱我扔在原地了。", "en": "I left the crate behind."},
        {"zh": "帽子扔了，不装了。", "en": "Hat tossed aside; no more pretense."},
        {"zh": "不装商人，更快。", "en": "Without the merchant act, I am faster."},
        {"zh": "你躲在拐角。", "en": "You are hiding at the corner."},
        {"zh": "我闭着嘴，脚步没停。", "en": "I keep my mouth shut and my feet moving."},
        {"zh": "你脚下发软。", "en": "Your steps are unsteady."},
        {"zh": "我们之间没几步了。", "en": "Only a few steps between us."},
        {"zh": "我在算你的斤两。", "en": "I am weighing you."},
        {"zh": "墙堵了你的路。", "en": "The wall has blocked you."},
        {"zh": "这一带我很熟。", "en": "I know this area well."},
        {"zh": "你跑得比我快，但不会一直快。", "en": "You are faster than me, but not forever."},
        {"zh": "袖子卷到肘上，省得碍事。", "en": "Sleeves rolled to the elbow, nothing in the way."},
        {"zh": "快追到脚后。", "en": "Almost at your heels."},
        {"zh": "不用再谈了。", "en": "No more talking."},
        {"zh": "账得算个清楚。", "en": "The account must be clean."},
        {"zh": "你停下也算。", "en": "Stopping counts too."},
        {"zh": "我就在你后颈边上。", "en": "I'm right at the back of your neck."},
        {"zh": "听见沙上的脚步没。", "en": "Do you hear the steps in the sand."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抡拳砸下。", "en": "I swing my fist down."},
        {"zh": "我一肩膀把你顶开。", "en": "My shoulder knocks you back."},
        {"zh": "我从袖子里抽出刀。", "en": "I pull a blade from my sleeve."},
        {"zh": "这一下，抵你欠的。", "en": "This one covers your debt."},
        {"zh": "我一把揪住你的衣襟。", "en": "I grab a fistful of your collar."},
        {"zh": "货箱的事，我记着。", "en": "I remember what happened to my crate."},
        {"zh": "你被推倒在沙上。", "en": "You go down in the sand."},
        {"zh": "这一击很重。", "en": "That blow was heavy."},
        {"zh": "你架开这一击。", "en": "You parried this one."},
        {"zh": "这账还没算完。", "en": "The account is not closed."},
        {"zh": "我又上前一步。", "en": "I step in again."},
        {"zh": "血溅在货箱上。", "en": "Blood sprays on the crate."},
        {"zh": "成交不了的，就这样。", "en": "What cannot be traded ends like this."},
        {"zh": "我要收回成本。", "en": "I mean to recover my costs."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "商队的人，从沙里站起。", "en": "A caravan man rises from the sand."},
        {"zh": "绿宝石撒了一圈。", "en": "Emeralds lie in a ring."},
        {"zh": "灵魂火把还亮着。", "en": "The soul torch still burns."},
        {"zh": "我撑住膝盖站直身子。", "en": "I brace on my knee and straighten up."},
        {"zh": "货箱落在地上。", "en": "The crate drops to the ground."},
        {"zh": "我拉了拉帽子。", "en": "I tug my hat."},
        {"zh": "这里原来是我的路。", "en": "This used to be my road."},
        {"zh": "风把沙吹进我的眼。", "en": "The wind blows sand into my eyes."},
        {"zh": "我看向你的方向。", "en": "I look your way."},
        {"zh": "这一带，没人记得我了。", "en": "Nobody remembers me around here."},
        {"zh": "我把手伸进袖子。", "en": "I reach into my sleeve."},
        {"zh": "生意做不成了。", "en": "There will be no more business."},
        {"zh": "我从地下回来。", "en": "I have come back from below."},
        {"zh": "你要买点什么吗。", "en": "Is there anything you want to buy."},
        {"zh": "最后问一句。", "en": "One last question."},
        {"zh": "我的价，很贵。", "en": "My price is very high."},
        {"zh": "这一趟，我赔光了。", "en": "I lost everything on this trip."},
        {"zh": "我要连本带利。", "en": "I want principal and interest."},
        {"zh": "我在沙上立住。", "en": "I take my stand in the sand."},
        {"zh": "别急着走开。", "en": "Do not rush off."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧着我的货，我扑过去。", "en": "Fire reached my goods, and I lunged for them."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地时箱子先着地。", "en": "The crate hit the ground first."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里的货，全废了。", "en": "Goods in water are all ruined."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我的货架吹散。", "en": "The blast scattered my rack."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过了我的袖子。", "en": "Something passed through my sleeve."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股力，我在下面见过。", "en": "I have seen this force below."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着就卖不动货。", "en": "A hungry man cannot trade."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声把绿宝石震得乱跳。", "en": "The thunder set my emeralds rattling."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有路，也没有客人。", "en": "No road here, and no customers."}
      ]
    }
  }
}
