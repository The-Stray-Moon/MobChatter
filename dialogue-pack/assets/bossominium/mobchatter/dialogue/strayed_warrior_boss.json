{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一脚一脚踩得很重。", "en": "Every step I take lands heavy."},
        {"zh": "铠甲在身上响。", "en": "My armour clanks on me."},
        {"zh": "我把刀拖在身后。", "en": "I drag my blade behind me."},
        {"zh": "地上的石被我踩裂。", "en": "The stone cracks under my boots."},
        {"zh": "我停在半路，看你。", "en": "I halt halfway and look at you."},
        {"zh": "我的影子比人高。", "en": "My shadow stands taller than a man."},
        {"zh": "我一步一步，不快。", "en": "Step by step, not fast."},
        {"zh": "我把刀往上提了一点。", "en": "I lift the blade a little."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，刀尖朝下。", "en": "I stand with the blade tip down."},
        {"zh": "铠甲的缝里透着冷。", "en": "Cold shows through the seams of my armour."},
        {"zh": "九点护甲，走失的战士。", "en": "Nine armor, a warrior gone astray."},
        {"zh": "我站在这道门前，等你来。", "en": "I wait at this gate for you."},
        {"zh": "我望着你身后的路。", "en": "I look at the road behind you."},
        {"zh": "我把刀换了个手。", "en": "I shift the blade to my other hand."},
        {"zh": "这一带没人敢过。", "en": "Nobody dares pass here."},
        {"zh": "我的甲上有旧痕。", "en": "There are old marks on my armour."},
        {"zh": "我望了一眼天色。", "en": "I glanced at the sky."},
        {"zh": "我像根柱子立正。", "en": "I stand straight as a post."},
        {"zh": "我僵着，一动不动。", "en": "I stay rigid, without moving."},
        {"zh": "风把我的披风掀起。", "en": "The wind lifts my cloak."},
        {"zh": "我等一个人来。", "en": "I wait for someone to come."},
        {"zh": "我的刀还在鞘外。", "en": "My blade is still out of its sheath."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你到我面前了。", "en": "You have come before me."},
        {"zh": "我把刀抬起来。", "en": "I raise the blade."},
        {"zh": "你的护甲不算厚。", "en": "Your armour is not thick."},
        {"zh": "我的刀拖在身后，划出一道沟。", "en": "My blade drags behind, cutting a furrow."},
        {"zh": "你不像要走。", "en": "You do not look like leaving."},
        {"zh": "我等的人，也许就是你。", "en": "Perhaps you are the one I waited for."},
        {"zh": "你站得很稳。", "en": "You stand steadily."},
        {"zh": "我的甲挡得住你这一下。", "en": "My armour will take that."},
        {"zh": "我站着，看你先动哪只脚。", "en": "I stand and watch which foot you move first."},
        {"zh": "这一战躲不过。", "en": "This fight cannot be avoided."},
        {"zh": "把你的刀出鞘吧。", "en": "Draw your blade."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "退了半步，甲还在。", "en": "Half a step back, armor still on."},
        {"zh": "铠甲上多了道痕。", "en": "A new mark on my armour."},
        {"zh": "这伤不碍我挥刀。", "en": "This will not stop my swing."},
        {"zh": "我把刀举得更高。", "en": "I lift the blade higher."},
        {"zh": "我咬住牙不出声。", "en": "I grit my teeth and make no sound."},
        {"zh": "血从甲缝里流下来。", "en": "Blood runs from my armour's seams."},
        {"zh": "我把脊背挺回来。", "en": "I straighten my spine."},
        {"zh": "这一刀我记下，回头还你。", "en": "I will remember this blade and return it."},
        {"zh": "还没到倒的时候。", "en": "It is not time to fall."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这不是我的军粮。", "en": "That is not my ration."},
        {"zh": "你把吃的举高也是白费。", "en": "Holding food up is wasted on me."},
        {"zh": "我要的是一场对决。", "en": "What I want is a duel."},
        {"zh": "收进你的包里。", "en": "Into your bag."},
        {"zh": "这种东西打动不了我。", "en": "Such things do not move me."},
        {"zh": "我只要一场对决。", "en": "I want only a duel."},
        {"zh": "你心思用错地方了。", "en": "Your effort is misdirected."},
        {"zh": "我晃了晃头盔。", "en": "I shake my helmet."},
        {"zh": "放下它，站好。", "en": "Put it down and stand."},
        {"zh": "你力气备足了吗。", "en": "Have you gathered your strength."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我用肩甲撞你。", "en": "I drive my pauldron into you."},
        {"zh": "铠甲撞得响。", "en": "The armour clangs."},
        {"zh": "我们撞得地上起尘。", "en": "Dust rises where we meet."},
        {"zh": "我把刀横过来。", "en": "I bring the blade across."},
        {"zh": "你这一撞不算弱。", "en": "That was not a weak shove."},
        {"zh": "我重新站住。", "en": "I set myself again."},
        {"zh": "再近一步，我的刀会先动。", "en": "One step closer and my blade moves first."},
        {"zh": "往后面退开。", "en": "Back away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只认对手。", "en": "I recognise only opponents."},
        {"zh": "同道之间，不必多言。", "en": "Among the like-minded, few words are needed."},
        {"zh": "你的刀法，我看过。", "en": "I have seen your swordwork."},
        {"zh": "一起守这条路。", "en": "Let us hold this road together."},
        {"zh": "谁先动手，谁先露破。", "en": "Whoever moves first shows his weakness."},
        {"zh": "甲与甲相碰，算是礼。", "en": "Armour against armour counts as greeting."},
        {"zh": "你守前门，我守后门。", "en": "You take the front; I hold the rear."},
        {"zh": "这一夜够我们守。", "en": "This night is long enough to hold."},
        {"zh": "不必说什么道别。", "en": "No farewells needed."},
        {"zh": "继续巡视吧。", "en": "Continue the patrol."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰把它抄起。", "en": "I stoop and scoop it up."},
        {"zh": "这不值一提。", "en": "This is worth little."},
        {"zh": "我甩手抛回去。", "en": "I fling it back."},
        {"zh": "太重的东西我懒得拿。", "en": "I cannot be bothered with heavy things."},
        {"zh": "我塞进甲的缝里。", "en": "I tuck it into a seam of my armour."},
        {"zh": "地上这件，我端详一下。", "en": "I study this thing on the ground."},
        {"zh": "这点小东西。", "en": "Such a small thing."},
        {"zh": "我收着，不为什么。", "en": "I keep it, for no reason."},
        {"zh": "不值得一顾。", "en": "Not worth a glance."},
        {"zh": "拔腿动身吧。", "en": "Move out."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你先动了手。", "en": "You struck first."},
        {"zh": "我把刀抬起。", "en": "I raise the blade."},
        {"zh": "我在这等了许多时候。", "en": "I have waited long here."},
        {"zh": "我正对你站好。", "en": "I square up to you."},
        {"zh": "铠甲收紧了一点。", "en": "My armour draws tight."},
        {"zh": "这一下，我接。", "en": "I will take that one."},
        {"zh": "我看清你的起手。", "en": "I saw your opening move."},
        {"zh": "刀尖正对着你。", "en": "The point is on you."},
        {"zh": "这个距离正合适，我的九点护甲够近。", "en": "This distance is right; my nine armor is close enough."},
        {"zh": "准备好吃这一下。", "en": "Brace for this one."},
        {"zh": "这一战开始。", "en": "This fight begins."},
        {"zh": "三声就够了。", "en": "Three sounds will do."},
        {"zh": "第三声响起。", "en": "The third sounds."},
        {"zh": "这是第二声。", "en": "This is the second."},
        {"zh": "这是第一声。", "en": "This is the first."},
        {"zh": "看我这一刀。", "en": "Watch this blade."},
        {"zh": "我不会留手。", "en": "I will not hold back."},
        {"zh": "你的命，我接着。", "en": "I take your life next."},
        {"zh": "看清这一刀。", "en": "See this cut."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着直线朝你来。", "en": "I walk a straight line at you."},
        {"zh": "你退半步，我便进半步。", "en": "Half a step back, half a step in."},
        {"zh": "刀拖在地上响。", "en": "The blade drags and rings."},
        {"zh": "你绕不开这条路。", "en": "You cannot get around this road."},
        {"zh": "我在算你的步子。", "en": "I am counting your steps."},
        {"zh": "你气息粗了。", "en": "Your breath has thickened."},
        {"zh": "我不追，只压。", "en": "I do not chase. I press."},
        {"zh": "铠甲的响动藏不住。", "en": "The armour's clatter gives me away."},
        {"zh": "你躲在墙后。", "en": "You are behind the wall."},
        {"zh": "我从正面来。", "en": "I come from the front."},
        {"zh": "刀锋与你的距离在减。", "en": "The blade and you grow closer."},
        {"zh": "你换了只手。", "en": "You switched hands."},
        {"zh": "我把刀举起了。", "en": "My blade is up."},
        {"zh": "再靠近三步。", "en": "Three steps closer."},
        {"zh": "墙把你逼进角落。", "en": "The wall has pressed you to the corner."},
        {"zh": "刀能碰到了。", "en": "The blade can reach."},
        {"zh": "看着我的刀。", "en": "Watch my blade."},
        {"zh": "别分了神吧。", "en": "Do not lose focus."},
        {"zh": "我把刀横在身前。", "en": "I hold the blade across my body."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一刀劈下。", "en": "I bring the blade down."},
        {"zh": "刀风压到你脸上。", "en": "The blade's wind hits your face."},
        {"zh": "你被砍得后退。", "en": "The cut drives you back."},
        {"zh": "我用刀背撞开你。", "en": "I knock you away with the flat."},
        {"zh": "这一刀很沉。", "en": "That cut was heavy."},
        {"zh": "铠甲挡了一下。", "en": "My armour took one."},
        {"zh": "你肩上开了口子。", "en": "Your shoulder has opened."},
        {"zh": "我再横一刀。", "en": "Another cut, across."},
        {"zh": "刀尖还对着你。", "en": "The blade tip is still on you."},
        {"zh": "血滴在石上。", "en": "Blood drips onto the stone."},
        {"zh": "我把刀收回。", "en": "I draw the blade back."},
        {"zh": "这刀不算完。", "en": "That cut does not close it."},
        {"zh": "接我第二刀。", "en": "Take my second cut."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "路中央多了一个人影。", "en": "A figure appears in the middle of the road."},
        {"zh": "我的铠甲先响。", "en": "My armour sounds first."},
        {"zh": "刀从我背后出鞘。", "en": "The blade comes from behind me."},
        {"zh": "地面被我踩出裂。", "en": "The ground cracks under my boots."},
        {"zh": "迷途的战士，甲有九点。", "en": "The strayed warrior carries nine points of armor."},
        {"zh": "我慢慢走到你面前。", "en": "I walk slowly to stand before you."},
        {"zh": "我把刀尖点在地上。", "en": "I set the blade tip on the ground."},
        {"zh": "这一带由我守着。", "en": "I keep this stretch."},
        {"zh": "我抬起头盔。", "en": "I raise my helmet."},
        {"zh": "落日的影子很长。", "en": "The sunset shadow is long."},
        {"zh": "我不是怪物，是战士。", "en": "I am not a monster. I am a warrior."},
        {"zh": "铠甲上的旧痕还在。", "en": "The old marks on my armour remain."},
        {"zh": "我立稳了脚。", "en": "My feet are set."},
        {"zh": "没人能从我这里过去。", "en": "No one passes me."},
        {"zh": "我先看你一眼。", "en": "I take one look at you."},
        {"zh": "刀在手里，很稳。", "en": "The blade sits steady in my hand."},
        {"zh": "这是我等了很久的一场。", "en": "This is the fight I waited for."},
        {"zh": "我的刀已就位。", "en": "My blade is in place."},
        {"zh": "你过来吧，快些。", "en": "Come at me, quickly."},
        {"zh": "我在这条路上。", "en": "I am on this road."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的甲，我退了。", "en": "Fire heats my armour, and I back off."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地时单膝一沉。", "en": "I land on one knee."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里挥不动刀。", "en": "The blade is useless in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我的甲掀开。", "en": "The blast tears my armour open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西卡进甲缝。", "en": "Something is lodged in my armour."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这力透过了我的甲。", "en": "This force passed through my armour."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，刀也变沉了。", "en": "Hungry, the blade feels heavier."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着刀身跑。", "en": "Lightning ran down the blade."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有路可守。", "en": "There is no road here to hold."}
      ]
    }
  }
}
