{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有脚，却在地上滑", "en": "I have no feet, yet I slide along."},
        {"zh": "身后的草结了一层霜", "en": "Frost forms on the grass behind me."},
        {"zh": "我飘过一道矮墙", "en": "I drift over a low wall."},
        {"zh": "衣角没有声音", "en": "My hem makes no sound."},
        {"zh": "我从树影穿到树影", "en": "I pass from shade to shade."},
        {"zh": "路过的地方温度会降", "en": "Where I pass, the air cools."},
        {"zh": "我看不清自己的手", "en": "I can't see my own hands clearly."},
        {"zh": "它们半透明，像雾", "en": "They're translucent, like mist."},
        {"zh": "我沿着旧路走", "en": "I follow an old road."},
        {"zh": "我飘过的地方，草尖结了霜。", "en": "Frost forms on the grass tips I drift over."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "停在原地，轻轻起伏", "en": "Halted, drifting gently up and down."},
        {"zh": "身体边缘在散，又聚回来", "en": "My edges fray and knit back."},
        {"zh": "我记不起自己是谁", "en": "I can't remember who I was."},
        {"zh": "只记得要留在这里", "en": "Only that I must stay here."},
        {"zh": "有风吹不动我", "en": "Wind can't move me."},
        {"zh": "霜在我脚下一圈圈铺开", "en": "Frost spreads in rings below me."},
        {"zh": "我看向远处的一点光", "en": "I look at a distant light."},
        {"zh": "我飘在原地，找不到回去的路。", "en": "I drift in place, unable to find my way back."},
        {"zh": "我找不到回去的路。", "en": "I cannot find the way back."},
        {"zh": "四周安静得发闷", "en": "The silence presses in."},
        {"zh": "有一瞬间我几乎想起名字", "en": "For a moment I almost recall a name."},
        {"zh": "然后它又散了", "en": "Then it dissolves again."},
        {"zh": "我就继续等着", "en": "I keep waiting."},
        {"zh": "等什么，也说不清", "en": "For what, I couldn't say."},
        {"zh": "草在我下面枯了", "en": "The grass beneath me withers."},
        {"zh": "我根本没碰它", "en": "I never touched it."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你居然看得见我", "en": "You can see me."},
        {"zh": "别人多半看不到", "en": "Most can't."},
        {"zh": "我朝你靠近了一点", "en": "I drift a little nearer."},
        {"zh": "你一直没有跑", "en": "You haven't run."},
        {"zh": "这倒是很少见", "en": "That's rare."},
        {"zh": "我抬手，又放下", "en": "I raise a hand, then lower it."},
        {"zh": "我其实碰不到你", "en": "I can't touch you."},
        {"zh": "或者说，我不该碰", "en": "Or rather, I shouldn't."},
        {"zh": "你的呼吸在空气里成了白雾", "en": "Your breath turns white in the air."},
        {"zh": "那是我带来的冷", "en": "That cold is mine."},
        {"zh": "我轻轻退开一点", "en": "I drift back a little."},
        {"zh": "这样你会好受些", "en": "You'll be more comfortable."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个人散了一下", "en": "I come apart for a moment."},
        {"zh": "随后重又凝起", "en": "Then re-forms."},
        {"zh": "这一下穿透了我", "en": "That passed through me."},
        {"zh": "我不知道该不该疼", "en": "I don't know if I should hurt."},
        {"zh": "我的雾变薄了", "en": "My mist thins."},
        {"zh": "霜往后退了一圈", "en": "The frost recedes a ring."},
        {"zh": "我退出了很远", "en": "I retreat a long way."},
        {"zh": "身体边缘不稳", "en": "My edges won't hold steady."},
        {"zh": "过一会就好了", "en": "It'll settle soon."},
        {"zh": "每次都总是这样", "en": "It always does."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那到底是什麼", "en": "What is that?"},
        {"zh": "我伸手探了探", "en": "I reach toward it."},
        {"zh": "手直接穿过去了", "en": "My hand passes through."},
        {"zh": "我的手从你的掌心里穿过去。", "en": "My hand passes straight through your palm."},
        {"zh": "生前也许可以", "en": "Perhaps I could, once."},
        {"zh": "现在只能看着", "en": "Now I can only look."},
        {"zh": "放在地上，我蹲下来看就好。", "en": "Set it on the ground; I'll crouch and look."},
        {"zh": "让我看看就好了", "en": "Let me look. That's all."},
        {"zh": "地上的草会枯", "en": "The grass there will wither."},
        {"zh": "你别怪我就是", "en": "Don't blame me."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你从我身上穿过去", "en": "You pass right through me."},
        {"zh": "你穿过去时，衣角结了白霜。", "en": "When you pass through, frost rimes your clothes."},
        {"zh": "我也缩了一下", "en": "I recoil too."},
        {"zh": "这不是疼，是不适", "en": "Not pain. Discomfort."},
        {"zh": "被你撞散的一角，慢慢长回来。", "en": "The corner you scattered slowly grows back."},
        {"zh": "你一下退了很远", "en": "You back away fast."},
        {"zh": "我悬在原处不动", "en": "I hang motionless."},
        {"zh": "不再往前靠近", "en": "And come no closer."},
        {"zh": "霜从你脚印里长出来", "en": "Frost grows in your footprints."},
        {"zh": "过一会就化了", "en": "It'll melt soon."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我记不起有没有过", "en": "I can't recall if I ever had one."},
        {"zh": "有时候会梦到一个人", "en": "Sometimes I dream of someone."},
        {"zh": "怎么也看不清脸", "en": "I can't see the face."},
        {"zh": "只记得手是暖的", "en": "Only that the hand was warm."},
        {"zh": "我在这条路上等", "en": "I wait on this road."},
        {"zh": "我已经等了很多年", "en": "For many years."},
        {"zh": "也许那人早已不在", "en": "Perhaps they're long gone."},
        {"zh": "也许只是我记错了", "en": "Perhaps I remember wrong."},
        {"zh": "可是我还是在等", "en": "Still, I wait."},
        {"zh": "反正我没有别的地方可去", "en": "I've nowhere else to be."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "第三次也是这样，我放弃了。", "en": "The third try is no different; I give up."},
        {"zh": "我蹲下，手伸进土里，还是空。", "en": "I crouch, reach into the soil, still nothing."},
        {"zh": "它在我指尖下，我碰不到。", "en": "It lies under my fingertips, out of reach."},
        {"zh": "我蹲下来看它", "en": "I crouch to look."},
        {"zh": "它就在那，我碰不到", "en": "It's right there, beyond my reach."},
        {"zh": "然后我站起来", "en": "I straighten."},
        {"zh": "这一点不算什么", "en": "It doesn't matter."},
        {"zh": "我连自己的影子都拿不住。", "en": "I can't even hold onto my own shadow."},
        {"zh": "连自己都带不走", "en": "Not even myself."},
        {"zh": "我接着往前飘", "en": "I drift on."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有活人的气息", "en": "The breath of the living."},
        {"zh": "我扭头看过去", "en": "I twist to look."},
        {"zh": "那边的草在结霜", "en": "Frost is forming over there."},
        {"zh": "不是我站的地方", "en": "Not where I'm standing."},
        {"zh": "是另外一处地方", "en": "Somewhere else."},
        {"zh": "我朝那边飘过去", "en": "I drift that way."},
        {"zh": "雾气跟着我走", "en": "Mist follows me."},
        {"zh": "前面有个影子在动", "en": "A shape moves ahead."},
        {"zh": "我慢慢慢下来", "en": "I slow down."},
        {"zh": "我不想吓到它", "en": "I don't want to frighten it."},
        {"zh": "但它已经听到了", "en": "But it already heard me."},
        {"zh": "那就没办法了", "en": "Then there's no helping it."},
        {"zh": "霜爬上那面墙了", "en": "Frost climbs that wall."},
        {"zh": "它就在墙后面", "en": "It's just behind it."},
        {"zh": "我听见了呼吸声", "en": "I hear breathing."},
        {"zh": "那不是我的呼吸", "en": "Not mine."},
        {"zh": "我转过一个墙角", "en": "I round the corner."},
        {"zh": "它已经看见我了", "en": "It has seen me."},
        {"zh": "那就省去解释", "en": "Then no explanation is needed."},
        {"zh": "我朝前面飘去", "en": "I drift forward."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "霜先追上你，我随后才到。", "en": "The frost reaches you first; I follow."},
        {"zh": "不靠近，也不落后", "en": "Not closer. Not behind."},
        {"zh": "保持在起雾的距离", "en": "Keeping to misting distance."},
        {"zh": "它忽然跑起来", "en": "It runs."},
        {"zh": "我还是那个速度", "en": "My pace doesn't change."},
        {"zh": "三十五点血的灵魂，不用跑。", "en": "Thirty-five points of spirit. No need to run."},
        {"zh": "路总会绕回来", "en": "The road loops back."},
        {"zh": "我就在这头等", "en": "I'll wait at this end."},
        {"zh": "霜已经铺到那边了", "en": "The frost has already reached there."},
        {"zh": "它踩上去就会知道", "en": "It will know when it steps on it."},
        {"zh": "知道我在这儿", "en": "That I'm here."},
        {"zh": "然后它就该停了", "en": "Then it should stop."},
        {"zh": "我的雾在地上拖着", "en": "My mist trails along the ground."},
        {"zh": "有影子落进雾里", "en": "A shadow falls into it."},
        {"zh": "我认得那种温度", "en": "I know that warmth."},
        {"zh": "活着的人都是暖的", "en": "The living are all warm."},
        {"zh": "我贴过去一点", "en": "I edge a little closer."},
        {"zh": "冷会先到，我不着急", "en": "The cold arrives first. I'm in no hurry."},
        {"zh": "它开始发抖了", "en": "It's starting to tremble."},
        {"zh": "很快就不用了", "en": "Soon it won't need to."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手，穿过它的胸口", "en": "My hand passes through its chest."},
        {"zh": "它猛地抖了一下", "en": "It shudders."},
        {"zh": "冷从那里散开", "en": "Cold spreads from there."},
        {"zh": "我一点也没用力", "en": "I didn't exert force."},
        {"zh": "我也没有力气", "en": "I have none to exert."},
        {"zh": "它退了，我停手", "en": "It recoils. I stop."},
        {"zh": "霜留在它衣上", "en": "Frost stays on its clothes."},
        {"zh": "那是我留下的唯一东西", "en": "The only thing I leave behind."},
        {"zh": "过一会就会化", "en": "It'll melt before long."},
        {"zh": "我不想再伤谁", "en": "I don't want to hurt anyone again."},
        {"zh": "我从背后探过去", "en": "I reach from behind."},
        {"zh": "指节穿过了肩", "en": "My knuckles pass through a shoulder."},
        {"zh": "霜在伤口边上结成白线", "en": "Frost lines the wound like chalk."},
        {"zh": "它慢慢跪下了", "en": "It goes down on its knees."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雾里先出现一个轮廓", "en": "A silhouette takes shape in the mist."},
        {"zh": "然后是我的脸", "en": "Then my face."},
        {"zh": "我自己也看不清", "en": "Even I can't see it clearly."},
        {"zh": "脚下的草开始结霜", "en": "Frost starts on the grass below."},
        {"zh": "我试着往前走了一步", "en": "I try a step forward."},
        {"zh": "地上没有脚印", "en": "No print appears."},
        {"zh": "我又走了几步", "en": "I take a few more."},
        {"zh": "地上还是没有印", "en": "Still none."},
        {"zh": "这地方我不认得", "en": "I don't know this place."},
        {"zh": "但我认得这种安静", "en": "But I know this kind of quiet."},
        {"zh": "这里是新的路", "en": "A new road."},
        {"zh": "那就重新走出去", "en": "Then I'll walk it again."},
        {"zh": "反正我也走不完", "en": "I'll never finish it anyway."},
        {"zh": "雾会一直跟着我", "en": "The mist will follow."},
        {"zh": "霜也一样会跟", "en": "So will the frost."},
        {"zh": "有谁在这附近", "en": "Someone is nearby."},
        {"zh": "我闻得到活气", "en": "I can smell the living."},
        {"zh": "我缓缓转身过去", "en": "I slowly turn away."},
        {"zh": "你一点也不用怕", "en": "No need to be afraid."},
        {"zh": "其实我也害怕", "en": "I'm afraid too."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火让我的轮廓发光", "en": "Fire makes my outline glow."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，却没有重量", "en": "I fall, and yet I have no weight."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让我散得更开", "en": "Water scatters me wider."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我冲散了", "en": "The blast blows me apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "东西穿过去了，留下一个洞", "en": "It passes through, leaving a hole."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这一股力气抓得牢", "en": "This force holds me fast."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这具身体早就不用吃了。", "en": "This body stopped needing food long ago."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照得我几乎看不见", "en": "Lightning light almost erases me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空反而让我更清楚", "en": "The void makes me clearer, somehow."}
      ]
    }
  }
}
