{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "四爪踏过地面，留下焦痕", "en": "Four paws leave scorch marks where they fall."},
        {"zh": "背上的毛像一炉炭火", "en": "The fur on my back burns like coals."},
        {"zh": "我大步穿过林子", "en": "I stride through the woods."},
        {"zh": "吼声低低地压在喉咙里", "en": "A growl sits low in my throat."},
        {"zh": "尾巴甩过去，火星四散", "en": "My tail lashes, scattering sparks."},
        {"zh": "脚下的落叶一碰就卷", "en": "Leaves curl where my feet land."},
        {"zh": "我沿着火痕巡逻", "en": "I patrol my own line of burns."},
        {"zh": "牙缝间透出红光", "en": "Red light glows between my teeth."},
        {"zh": "每步都震得尘土跳起", "en": "Dust jumps with each step."},
        {"zh": "我停一下，嗅了嗅地面", "en": "I stop and sniff the ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "坐下，火从我身周散开", "en": "Sitting, fire spills around me."},
        {"zh": "耳朵一直在动", "en": "My ears never stop moving."},
        {"zh": "我用后爪挠了挠颈侧", "en": "I scratch my neck with a hind paw."},
        {"zh": "灼热的气从鼻孔喷出来", "en": "Scalding air puffs from my nostrils."},
        {"zh": "周围的草已经焦了", "en": "The grass around me is already scorched."},
        {"zh": "舌头舔了舔牙", "en": "My tongue slides along my teeth."},
        {"zh": "我看着火堆的方向", "en": "I watch the fire's direction."},
        {"zh": "尾巴拍在地上，火星四溅", "en": "My tail strikes the ground, sparks flying."},
        {"zh": "背脊上的火一明一暗", "en": "The fire on my spine pulses."},
        {"zh": "我抬起头，长长地嗅", "en": "I raise my head and take a long scent."},
        {"zh": "有狼在远处回应我", "en": "Wolves answer from far off."},
        {"zh": "焦牛排的味道，让我醒来。", "en": "Charred steak wakes me."},
        {"zh": "爪子在地里按出深坑", "en": "My paws press deep hollows in the dirt."},
        {"zh": "我用尾巴扫过焦土，火又起来。", "en": "My tail sweeps the scorched earth and fire flares again."},
        {"zh": "身上的热度一直没降", "en": "The heat on me never drops."},
        {"zh": "这是召唤来的形态", "en": "This shape was called forth."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬眼，火光在瞳孔里", "en": "I look up, fire in my eyes."},
        {"zh": "你的影子被我照亮", "en": "My light picks out your shadow."},
        {"zh": "狼王的牙一直龇到你眼前。", "en": "The wolf king's teeth bare right in your face."},
        {"zh": "牙就在你面前", "en": "My teeth are right in front of you."},
        {"zh": "你倒是没跑开", "en": "You didn't run off."},
        {"zh": "焦牛排的味道，把我叫来了", "en": "The smell of charred steak called me"},
        {"zh": "焦牛排的油味还沾在我牙上。", "en": "The grease of charred steak still clings to my teeth."},
        {"zh": "身上的火更旺了", "en": "My fire burns hotter."},
        {"zh": "远处有狼在嗥叫", "en": "Wolves howl in the distance."},
        {"zh": "那些是跟着我的", "en": "Those ones follow me."},
        {"zh": "你现在走还来得及", "en": "You can still walk away."},
        {"zh": "我不追逃的人", "en": "I don't chase those who flee."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我吼了一声，火更旺", "en": "I roar, and the fire rises."},
        {"zh": "伤口冒出一缕烟", "en": "Smoke curls from the wound."},
        {"zh": "火星从伤口里溅出来，像血。", "en": "Sparks spray from the wound like blood."},
        {"zh": "这一下扎得挺深", "en": "That one bit deep."},
        {"zh": "血滴在地上，滋滋响", "en": "Blood drips and hisses on the ground."},
        {"zh": "我使劲摆了摆头", "en": "I swing my head hard."},
        {"zh": "牙还咬得动东西", "en": "My jaws still work."},
        {"zh": "那一下打得不错。", "en": "That was a decent hit."},
        {"zh": "可是火还没有灭", "en": "But the fire's still lit."},
        {"zh": "所以还没结束", "en": "So we aren't done."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那股肉味很冲", "en": "That meat smell is strong."},
        {"zh": "焦牛排的边角还在冒烟。", "en": "The charred steak's edges are still smoking."},
        {"zh": "烤过的味道更好", "en": "Roasted smells better."},
        {"zh": "我把头凑到火边", "en": "I bring my head near the fire."},
        {"zh": "我的火能把你的也点着", "en": "My fire could light yours."},
        {"zh": "闻着有一股炭味", "en": "Smells like charcoal."},
        {"zh": "我咬了一口，很烫", "en": "I bite. It's hot."},
        {"zh": "再烫也照样吃", "en": "Hot or not, I eat it."},
        {"zh": "这么一点根本不够", "en": "That's nowhere near enough."},
        {"zh": "你还揣着别的吗", "en": "Do you carry more?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我侧腹上", "en": "You hit my flank."},
        {"zh": "火苗燎到你的袖子", "en": "Flame licks your sleeve."},
        {"zh": "我压根没挪地方", "en": "I haven't shifted at all."},
        {"zh": "我的毛烫得能点着你的披风。", "en": "My fur is hot enough to set your cloak alight."},
        {"zh": "别贴得这么近走", "en": "Don't walk that close."},
        {"zh": "我一身都是烫的", "en": "Everything on me is hot."},
        {"zh": "这一下不算挑衅", "en": "That doesn't count as a challenge."},
        {"zh": "我转过身，正对你", "en": "I turn square to you."},
        {"zh": "地上的草给踩焦了", "en": "The grass is scorched under my feet."},
        {"zh": "你退开就没事了", "en": "Just step back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这一身火，是被人点起来的。", "en": "This fire on me was lit by someone's hand."},
        {"zh": "没有族群，也没有伴", "en": "No pack. No mate."},
        {"zh": "远处的狼嗥不是同类", "en": "Those distant howls aren't my kind."},
        {"zh": "它们只是跟着火走", "en": "They only follow the fire."},
        {"zh": "我低头嗅自己烧过的地", "en": "I sniff the ground I've burned."},
        {"zh": "这是我的记号", "en": "That's my mark."},
        {"zh": "一圈焦土，够大了", "en": "A ring of scorched earth. Big enough."},
        {"zh": "我在这圈里等", "en": "I wait inside it."},
        {"zh": "一直等到有人来", "en": "Until someone comes."},
        {"zh": "那就来打一场", "en": "Then we fight."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我低头把它咬起来", "en": "I dip and take it."},
        {"zh": "太烫，我甩了甩头", "en": "Too hot. I shake my head."},
        {"zh": "我嘴里直冒烟", "en": "Smoke comes from my mouth."},
        {"zh": "我还是照样吞了", "en": "I swallow it anyway."},
        {"zh": "这点分量不管用", "en": "That amount does nothing."},
        {"zh": "我用爪子压住", "en": "I press it with my paw."},
        {"zh": "爪子把它烤硬了", "en": "My paw bakes it hard."},
        {"zh": "咬起来更费力", "en": "Harder to bite now."},
        {"zh": "但我还是吃完了", "en": "But I finish it."},
        {"zh": "这一点差得太远", "en": "That's nowhere near enough."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你进了我的焦土圈", "en": "You've stepped into my scorched ring."},
        {"zh": "我立刻站起来了", "en": "I'm on my feet at once."},
        {"zh": "背上的火一下窜高", "en": "The fire on my back leaps up."},
        {"zh": "四爪抓地，压出深痕", "en": "Four paws dig deep grooves."},
        {"zh": "远处的狼群跟着我一起低吼。", "en": "The pack in the distance growls along with me."},
        {"zh": "远处的狼也开始叫", "en": "The wolves start up too."},
        {"zh": "它们围过来了", "en": "They're closing in."},
        {"zh": "但先动手的是我", "en": "But I strike first."},
        {"zh": "牙全露出来了", "en": "Every tooth is bared."},
        {"zh": "热气从嘴里喷出", "en": "Heat pours from my mouth."},
        {"zh": "我把头压低下来", "en": "I lower my head."},
        {"zh": "四只爪子一蹬", "en": "Four paws push off."},
        {"zh": "这一下不会留", "en": "This one won't be held back."},
        {"zh": "你选的路，就这条", "en": "This is the road you chose."},
        {"zh": "我给过你一次机会", "en": "I gave you one chance."},
        {"zh": "你并没有走开", "en": "You didn't walk away."},
        {"zh": "那就别怪这身火", "en": "Then don't blame the fire."},
        {"zh": "这一场开始了", "en": "It begins."},
        {"zh": "这次没有回头", "en": "There's no turning back."},
        {"zh": "二五五点生命，够打很久", "en": "Two hundred and fifty-five. This will take a while."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我踏过的地方，草只剩下灰。", "en": "Where I step, only ash remains of the grass."},
        {"zh": "每一步都留下火星", "en": "Each step leaves sparks."},
        {"zh": "草在我身后烧起来", "en": "Grass catches fire behind me."},
        {"zh": "你被火围在中间", "en": "You're ringed by fire."},
        {"zh": "我一点都不用急", "en": "I don't need to hurry."},
        {"zh": "火会替你计时", "en": "The fire will keep time for you."},
        {"zh": "我踩着焦土，一步一个火印。", "en": "I walk the scorched ground, a burning print per step."},
        {"zh": "肩胛骨高高耸起", "en": "My shoulders rise high."},
        {"zh": "这是要扑的姿势", "en": "This is the shape before a pounce."},
        {"zh": "你举起了手里的东西", "en": "You raise what's in your hands."},
        {"zh": "我看得非常清楚", "en": "I see it clearly."},
        {"zh": "但我不怕那个", "en": "But it doesn't frighten me."},
        {"zh": "我身上的火不灭", "en": "The fire on me won't go out."},
        {"zh": "火从三面围过来，只留一条。", "en": "Fire closes in from three sides, leaving one gap."},
        {"zh": "火也越来越近", "en": "And the fire closer."},
        {"zh": "你退到焦土边缘", "en": "You've reached the scorched edge."},
        {"zh": "那里也是我的地", "en": "That's my ground too."},
        {"zh": "再退就是树了", "en": "Back further and there are trees."},
        {"zh": "树也一样会烧", "en": "Trees burn too."},
        {"zh": "我就这么等着", "en": "I wait."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上去，一口咬下", "en": "I lunge and bite down."},
        {"zh": "爪子先撕开一道", "en": "My claws open a line first."},
        {"zh": "牙咬住就不放", "en": "Once I bite, I don't let go."},
        {"zh": "火从牙缝里喷出来", "en": "Fire jets between my teeth."},
        {"zh": "你挡住了，烫得退了", "en": "You block it, then flinch from the heat."},
        {"zh": "我甩头，把你带倒", "en": "One twist pulls you off your feet."},
        {"zh": "尾巴横抽在你腰上", "en": "My tail cracks across your waist."},
        {"zh": "这一下带着火星", "en": "That one came with sparks."},
        {"zh": "你身上的布着了", "en": "Your cloth is burning."},
        {"zh": "我退开一步，看你拍火", "en": "I step back to watch you beat it out."},
        {"zh": "这可算不上仁慈", "en": "That isn't mercy."},
        {"zh": "只是我喜欢看", "en": "I just like watching."},
        {"zh": "好了，就到这里", "en": "Enough of that."},
        {"zh": "接下来是第二下", "en": "The second one."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "林间的火堆忽然全灭了", "en": "The fires in the wood all go out at once."},
        {"zh": "然后一处重新亮起来", "en": "Then one relights."},
        {"zh": "我从那团火里走出来", "en": "I walk out of that flame."},
        {"zh": "爪子落地，泥土焦黑", "en": "My paws land and the soil blackens."},
        {"zh": "有人在树林里召了我", "en": "Someone called me in these woods."},
        {"zh": "一个护符，一块烧焦的肉", "en": "A talisman and a charred steak."},
        {"zh": "也就这么多了", "en": "That's all it took."},
        {"zh": "我把背脊抖了抖", "en": "I shake my spine."},
        {"zh": "火星散了一地", "en": "Sparks scatter across the ground."},
        {"zh": "四周的树在响", "en": "The trees around me creak."},
        {"zh": "那是热在烤它们", "en": "Heat is baking them."},
        {"zh": "远处的狼看到了火", "en": "Wolves see the fire from far off."},
        {"zh": "它们迟早会来", "en": "They'll come."},
        {"zh": "先来的总是小的", "en": "The small ones always come first."},
        {"zh": "然后是更多的", "en": "Then more."},
        {"zh": "我不用叫它们", "en": "I don't have to call them."},
        {"zh": "火本身就是召集", "en": "Fire is the call."},
        {"zh": "我站在这圈焦土中间", "en": "I stand at the center of this scorched ring."},
        {"zh": "等第一个敢进来的", "en": "Waiting for the first to dare enter."},
        {"zh": "这里现在是猎场了", "en": "This is a hunting ground now."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我不算什么", "en": "Fire means little to me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时四爪都陷进土", "en": "All four paws sink deep on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水汽扑上来，毛一缕缕贴在身上。", "en": "Steam rises and my fur plasters to my body."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪掀得我打滚", "en": "The blast rolls me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有什么刺进我肩膀", "en": "Something stabs into my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股劲让我的火暗了", "en": "This force dims my fire."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得火都要灭了", "en": "Hunger is putting my fire out."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在我背上", "en": "Lightning strikes my back."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有地，只有黑", "en": "No ground. Only black."}
      ]
    }
  }
}
