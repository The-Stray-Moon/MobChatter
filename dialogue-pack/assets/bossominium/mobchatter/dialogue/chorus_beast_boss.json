{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩过的地方结出紫色的壳。", "en": "Purple crust forms where I step."},
        {"zh": "我的身体轻轻嗡鸣。", "en": "My body hums softly."},
        {"zh": "我飘过去，又落下来。", "en": "I drift, then settle."},
        {"zh": "我身后是一串碎裂的地面。", "en": "A cracked path lies behind me."},
        {"zh": "我的轮廓断成一节一节。", "en": "My outline breaks into segments."},
        {"zh": "我绕着塔一样的石柱走。", "en": "I circle a tower-like pillar."},
        {"zh": "我的脚步没有重量。", "en": "My steps carry no weight."},
        {"zh": "有紫色的粒子跟着我。", "en": "Purple motes follow me."},
        {"zh": "我穿过一片荒地。", "en": "I cross a stretch of waste ground."},
        {"zh": "我走得很慢，很稳。", "en": "I walk slowly and steadily."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在半空，轻轻上下。", "en": "I hang in the air, bobbing."},
        {"zh": "我身上的紫光一明一暗。", "en": "My violet glow pulses."},
        {"zh": "我在听别处的声音。", "en": "I listen to somewhere else."},
        {"zh": "颈边的壳轻轻碰响。", "en": "The shell at my neck knocks softly."},
        {"zh": "我伸出手，又放下。", "en": "I reach out, then lower it."},
        {"zh": "荒地上没有风。", "en": "There's no wind on the waste."},
        {"zh": "我在嚼空气里的东西。", "en": "I'm chewing something in the air."},
        {"zh": "我的护甲比我看着更厚。", "en": "My armour is thicker than it looks."},
        {"zh": "我在等回声。", "en": "I'm waiting for an echo."},
        {"zh": "我的呼吸带着紫色的雾。", "en": "My breath carries violet mist."},
        {"zh": "我把身体转过去一点。", "en": "I turn slightly."},
        {"zh": "远处有一块石头在浮。", "en": "A stone floats in the distance."},
        {"zh": "紫色的碎片绕着我转。", "en": "Violet shards circle me."},
        {"zh": "我一直醒着。", "en": "I stay awake."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在紫色里。", "en": "You're standing in the purple."},
        {"zh": "我的护甲有二十层。", "en": "My armour has twenty layers."},
        {"zh": "你的武器会弹开。", "en": "Your weapon will bounce off."},
        {"zh": "我不属于这片地。", "en": "I don't belong to this ground."},
        {"zh": "我听见你握紧了什么。", "en": "I hear you tighten your grip."},
        {"zh": "你走十步，我一步就到。", "en": "Ten of your steps, one of mine."},
        {"zh": "我抬手，紫光聚起来。", "en": "I raise a hand; violet light gathers."},
        {"zh": "让我看看你有多硬。", "en": "Let's see how hard you are."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上的壳掉了一角。", "en": "A corner of my shell breaks off."},
        {"zh": "我的紫光暗了一下。", "en": "My violet light dims."},
        {"zh": "我退开半格。", "en": "I retreat half a block."},
        {"zh": "我听见自己的护甲响。", "en": "I hear my own armour ring."},
        {"zh": "这一下穿过了第一层。", "en": "That got through the first layer."},
        {"zh": "还有十九层。", "en": "Nineteen to go."},
        {"zh": "我重新合上。", "en": "I close up again."},
        {"zh": "我朝下扫了你一眼。", "en": "I sweep a glance down at you."},
        {"zh": "壳碎了一角，紫光漏出来。", "en": "A corner of my shell breaks and violet light leaks out."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那块在共鸣。", "en": "That piece in your hand is resonating."},
        {"zh": "给我听一下。", "en": "Let me hear it."},
        {"zh": "它和我的壳同源。", "en": "It's the same stuff as my shell."},
        {"zh": "我不吃，我只是要。", "en": "I don't eat it; I just want it."},
        {"zh": "举到我看得见的高度。", "en": "Hold it where I can see."},
        {"zh": "它发出响声了。", "en": "It made a sound."},
        {"zh": "我靠近了些。", "en": "I came a little nearer."},
        {"zh": "这个可以留下。", "en": "This one may stay."},
        {"zh": "让我再瞧一眼。", "en": "Let me look once more."},
        {"zh": "你收着吧，我不抢。", "en": "Keep it; I won't take it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，护甲没让。", "en": "You hit me; the armour gave nothing."},
        {"zh": "地面裂出紫色的纹。", "en": "Violet fractures spread in the ground."},
        {"zh": "我垂下眼睛看你。", "en": "I lower my eyes to you."},
        {"zh": "我并没有推你。", "en": "I didn't shove you."},
        {"zh": "碎屑浮起来了。", "en": "Debris lifts into the air."},
        {"zh": "碰上我，声音发闷。", "en": "Hitting me gives a dead sound."},
        {"zh": "你脚站稳了。", "en": "You found your feet."},
        {"zh": "我飘开了半步。", "en": "I drift half a block away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "末地的石头在我身边浮起来。", "en": "End stone floats up around me."},
        {"zh": "我只听见自己的嗡鸣。", "en": "I only hear my own hum."},
        {"zh": "没有人回答。", "en": "No one answered."},
        {"zh": "我的壳还在长。", "en": "My shell is still growing."},
        {"zh": "我数着浮起来的石头。", "en": "I count the floating stones."},
        {"zh": "这片荒地里只有我。", "en": "I'm alone on this waste."},
        {"zh": "四周静得发空。", "en": "The silence feels hollow."},
        {"zh": "我就继续等着。", "en": "So I keep waiting."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿起一块碎片。", "en": "I take up a shard."},
        {"zh": "它在我手里浮着。", "en": "It floats in my hand."},
        {"zh": "它和我的护甲一样。", "en": "It matches my armour."},
        {"zh": "它跟我合上了。", "en": "It fused with me."},
        {"zh": "地上还剩几块。", "en": "A few bits remain on the ground."},
        {"zh": "我不需要那么多。", "en": "I don't need that many."},
        {"zh": "这块里面是空的。", "en": "This one's empty inside."},
        {"zh": "它悬在半空。", "en": "It stays suspended."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我的紫光变亮了。", "en": "My violet light brightens."},
        {"zh": "我把身体转过来。", "en": "I turn my body around."},
        {"zh": "你在我前面很小。", "en": "You're small in front of me."},
        {"zh": "塔影里，我睁开第三只眼。", "en": "In the tower's shadow I open a third eye."},
        {"zh": "光在掌心聚成一块。", "en": "Light gathers in my palm."},
        {"zh": "地面开始碎裂。", "en": "The ground begins to break."},
        {"zh": "你没有退开。", "en": "You didn't back away."},
        {"zh": "好，我认真。", "en": "Fine, I'm serious."},
        {"zh": "我的护甲一层层合上。", "en": "My armour layers shut."},
        {"zh": "紫颂的果子，撑起我这副身。", "en": "Chorus fruit props up this body."},
        {"zh": "这地方归我。", "en": "This place is mine."},
        {"zh": "你背后是塔。", "en": "There's a tower behind you."},
        {"zh": "所以我笑了。", "en": "So I smiled."},
        {"zh": "笑得不太好看。", "en": "It isn't a pretty smile."},
        {"zh": "不过够用了。", "en": "But it serves."},
        {"zh": "我要出手了。", "en": "I'm about to strike."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一路跟着你。", "en": "I've followed you all along."},
        {"zh": "你的脚步在地上很小。", "en": "Your steps are small on the ground."},
        {"zh": "我每走一步都留下紫纹。", "en": "Each of my steps leaves violet marks."},
        {"zh": "我把它浮起来。", "en": "I lift it."},
        {"zh": "紫光在我掌心慢慢转。", "en": "Violet light turns slowly in my palm."},
        {"zh": "气流在我身周转。", "en": "Air turns around me."},
        {"zh": "我想看清你的护甲。", "en": "I want to see your armour clearly."},
        {"zh": "你把它修好了吗？", "en": "Have you repaired it?"},
        {"zh": "空中对你不好。", "en": "The air won't favour you."},
        {"zh": "我飘过去一点。", "en": "I drift a little closer."},
        {"zh": "只差一层紫光。", "en": "Only a veil of violet."},
        {"zh": "我把紫颂果的核按进胸口。", "en": "I press a chorus fruit pit into my chest."},
        {"zh": "这下我看清了。", "en": "Now I see it clearly."},
        {"zh": "你身上的破绽。", "en": "The gap in your guard."},
        {"zh": "就在这堵墙边。", "en": "Right here at this wall."},
        {"zh": "我悬在塔下，等你抬脚。", "en": "I hover below the tower, waiting for your foot to lift."},
        {"zh": "此刻正合适。", "en": "This moment is right."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一掌拍下去，紫光炸开。", "en": "I bring my palm down; violet light bursts."},
        {"zh": "你的甲上多了一个坑。", "en": "A dent appears in your armour."},
        {"zh": "你被震得连退。", "en": "The shock knocks you back."},
        {"zh": "地面裂成一圈紫纹。", "en": "The ground cracks in a violet ring."},
        {"zh": "紫光穿过了你的防线。", "en": "The light pierces your guard."},
        {"zh": "我的手再抬起来。", "en": "My hand rises again."},
        {"zh": "你的武器嗡嗡响。", "en": "Your weapon hums."},
        {"zh": "这一下很准。", "en": "That one was precise."},
        {"zh": "我有点意外。", "en": "I'm mildly surprised."},
        {"zh": "紫光聚成拳，砸向你。", "en": "Violet light gathers into a fist and slams at you."},
        {"zh": "灰尘浮起来又落下。", "en": "Dust lifts and falls."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "荒地上响起了嗡鸣。", "en": "A hum rises on the waste."},
        {"zh": "紫色的光先出现。", "en": "The violet light comes first."},
        {"zh": "地面裂出第一道纹。", "en": "The first crack opens."},
        {"zh": "紫光一收，我落地。", "en": "The violet light closes and I land."},
        {"zh": "碎屑浮在我周围。", "en": "Debris floats around me."},
        {"zh": "这里不像别处。", "en": "This place isn't like others."},
        {"zh": "我踩碎了脚下的石。", "en": "I crush the stone under me."},
        {"zh": "我的护甲还在合拢。", "en": "My armour is still closing."},
        {"zh": "我扬起了头。", "en": "I lift my head up."},
        {"zh": "很远的地方有回声。", "en": "There's an echo far off."},
        {"zh": "我往前飘了。", "en": "I drift forward."},
        {"zh": "紫纹跟着我。", "en": "Violet marks follow me."},
        {"zh": "我听见外面有人。", "en": "I hear someone outside."},
        {"zh": "我朝那边过去。", "en": "I head that way."},
        {"zh": "我在等什么。", "en": "I'm waiting for something."},
        {"zh": "它终于来了。", "en": "It has come at last."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在紫壳上烧出白斑。", "en": "Fire burns white spots into the shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下来，地面整个塌了。", "en": "I land and the ground caves in."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的护甲缝，我沉下去。", "en": "Water enters my seams; I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我的碎片全掀起来。", "en": "The blast throws all my shards up."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "几根尖物嵌进我的壳。", "en": "Points lodge in my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "紫色的光回敬了我一下。", "en": "Violet light answered me back."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我空了很久，光都淡了。", "en": "Empty so long, even the glow fades."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着护甲走，每一层都亮。", "en": "Lightning runs over the armour; each layer glows."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地，连碎片也没有。", "en": "No ground here, not even shards."}
      ]
    }
  }
}
