{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我摇摇晃晃地走过来。", "en": "I come over swaying."},
        {"zh": "脚下有点打滑。", "en": "My feet keep slipping."},
        {"zh": "酒馆的地板我熟。", "en": "I know this tavern floor."},
        {"zh": "杯子还在我手里。", "en": "The cup is still in my hand."},
        {"zh": "我一步三晃，别笑。", "en": "Three wobbles a step. Don't laugh."},
        {"zh": "我沿着长凳走。", "en": "I walk along the bench."},
        {"zh": "左脚比右脚快一点。", "en": "My left foot is a little faster."},
        {"zh": "门框我撞过一次了。", "en": "I've bumped the doorframe once already."},
        {"zh": "我绕着桌子转。", "en": "I circle the table."},
        {"zh": "我走得很慢，但不倒。", "en": "I walk slowly, but I don't fall."},
        {"zh": "灯晃，我也晃。", "en": "The lamp sways, and so do I."},
        {"zh": "我又往酒桶那边去了。", "en": "I'm heading to the barrel again."},
        {"zh": "我踩着洒出来的酒。", "en": "I'm walking on spilled ale."},
        {"zh": "我扶着墙慢慢走。", "en": "I steady myself on the wall."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我靠着柱子站着。", "en": "I lean against the post."},
        {"zh": "喝一口，再喝一口。", "en": "One sip, then another."},
        {"zh": "我打了个嗝。", "en": "I hiccup."},
        {"zh": "这酒真够烈的。", "en": "This ale is strong."},
        {"zh": "我眯着眼看人。", "en": "I squint at people."},
        {"zh": "不打架，只喝酒。", "en": "No fighting. Just drinking."},
        {"zh": "我把杯子举起来看了看。", "en": "I lift the cup and look at it."},
        {"zh": "我还想再来一杯。", "en": "I'd like another."},
        {"zh": "桌子有点斜。", "en": "The table is a bit slanted."},
        {"zh": "我哼了一句小调。", "en": "I hum a little tune."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站我面前做什么？", "en": "What are you standing in front of me for?"},
        {"zh": "我头晕，你别动。", "en": "My head's spinning. Hold still."},
        {"zh": "你也来喝一杯？", "en": "Want a drink too?"},
        {"zh": "这酒真不错。", "en": "The ale's good."},
        {"zh": "你别碰我的杯子。", "en": "Don't touch my cup."},
        {"zh": "我不惹事，你别惹我。", "en": "I don't start trouble. Don't start any."},
        {"zh": "我只是喝多了。", "en": "I've just had too much."},
        {"zh": "新来的？先坐，别站着。", "en": "New here? Sit down, do not loom."},
        {"zh": "坐下吧，凳子够。", "en": "Sit down. There's room."},
        {"zh": "你这么高，我脖子疼。", "en": "You're so tall my neck aches."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哎哟，你别打。", "en": "Ow, stop hitting me."},
        {"zh": "我的杯子掉了。", "en": "My cup fell."},
        {"zh": "我酒醒了一半。", "en": "I'm half sober now."},
        {"zh": "你这一下把我打清醒了。", "en": "That blow nearly sobered me up."},
        {"zh": "酒劲上来了，我挨打也不觉得疼。", "en": "The liquor is in me; blows barely sting."},
        {"zh": "蓝皮肤上，酒和血混在一起。", "en": "On blue skin, ale and blood mix together."},
        {"zh": "我扶着桌子。", "en": "I steady myself on the table."},
        {"zh": "这下我真生气了。", "en": "Now I'm really angry."},
        {"zh": "酒劲上头，我咬得更紧。", "en": "The drink hits me and I bite down harder."},
        {"zh": "我居然还站着。", "en": "I'm somehow still standing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那杯是给我的吗？", "en": "Is that cup for me?"},
        {"zh": "我闻到了酒味。", "en": "I can smell the ale."},
        {"zh": "酒馆的角落，我抱着酒桶。", "en": "In the tavern corner, I hug a barrel."},
        {"zh": "你手可别抖。", "en": "Don't let your hand shake."},
        {"zh": "这一杯，够我半晌。", "en": "One cup will last me half a day."},
        {"zh": "我不挑，烈点更好。", "en": "I'm not picky. Stronger is better."},
        {"zh": "你先喝一口，我就信。", "en": "You take a sip first, then I'll trust you."},
        {"zh": "放着，我自己来。", "en": "Leave it. I'll help myself."},
        {"zh": "我这儿还有半杯。", "en": "I still have half a cup."},
        {"zh": "再来一轮酒吧。", "en": "Another round."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你在酒馆里撞上我。", "en": "You bumped me in the tavern."},
        {"zh": "酒洒了一地。", "en": "The ale spilled everywhere."},
        {"zh": "我的杯子差点掉。", "en": "I nearly dropped my cup."},
        {"zh": "蓝色的小哥布林，喝多了。", "en": "Little blue goblin, too much ale."},
        {"zh": "你比我壮多了。", "en": "You're much sturdier than me."},
        {"zh": "我撞上桌子，桌子也晃。", "en": "I hit the table, and it wobbles too."},
        {"zh": "我扶着你的胳膊。", "en": "I hold your arm."},
        {"zh": "这下我更晕了。", "en": "Now I'm dizzier."},
        {"zh": "地上的酒让我滑倒。", "en": "The spilled ale made me slip."},
        {"zh": "你的胳膊像根木桩。", "en": "Your arm is like a fence post."},
        {"zh": "我的帽子掉了下来。", "en": "My hat fell off."},
        {"zh": "我靠着你才没倒。", "en": "I only stayed up because of you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "酒馆里没这种规矩。", "en": "That's not how it goes in a tavern."},
        {"zh": "我醉了，说不清。", "en": "I'm drunk and can't explain."},
        {"zh": "你给我再来一杯就行。", "en": "Just get me another cup."},
        {"zh": "这种事明天再说。", "en": "Talk about it tomorrow."},
        {"zh": "我的头很晕。", "en": "My head is spinning."},
        {"zh": "你别晃，我眼睛花。", "en": "Stop swaying. My eyes are blurring."},
        {"zh": "我坐这儿挺好。", "en": "I'm fine sitting here."},
        {"zh": "唱首歌更好。", "en": "A song would be better."},
        {"zh": "这店里的酒保知道。", "en": "The barkeep here knows."},
        {"zh": "我得先睡一觉。", "en": "I need to sleep first."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这枚金币是我的。", "en": "This coin is mine."},
        {"zh": "我数不清有几枚。", "en": "I can't count how many."},
        {"zh": "掉地上的是谁的？", "en": "Whose is this on the floor?"},
        {"zh": "我捡起来揣兜里。", "en": "I pick it up and pocket it."},
        {"zh": "杯子摔成了碎片。", "en": "The cup smashed to pieces."},
        {"zh": "这屑子不值钱。", "en": "These scraps are worthless."},
        {"zh": "我踢了它一脚。", "en": "I kicked it once."},
        {"zh": "你掉的？现在归我。", "en": "You dropped it? Mine now."},
        {"zh": "我捡了也记不住放哪。", "en": "Even if I pick it up, I forget where."},
        {"zh": "杯子我拿稳了。", "en": "I've got the cup steady."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "是你推的我。", "en": "You shoved me."},
        {"zh": "酒馆里闹事，是要挨揍的。", "en": "Starting trouble in the tavern earns you a beating."},
        {"zh": "我酒醒了半分。", "en": "I'm half sober now."},
        {"zh": "这些弟兄都看着。", "en": "All the lads are watching."},
        {"zh": "你敢在这儿动手？", "en": "You dare start a fight in here?"},
        {"zh": "我脾气不好。", "en": "I have a bad temper."},
        {"zh": "我站起来有点晃。", "en": "I'm standing, a bit unsteady."},
        {"zh": "但我有力气。", "en": "But I have strength."},
        {"zh": "你别以为醉了就打不准。", "en": "Don't think drink makes me miss."},
        {"zh": "这一下，我先来。", "en": "This one, I go first."},
        {"zh": "我还没动手。", "en": "I haven't struck yet."},
        {"zh": "你先动手了，好。", "en": "You struck first. Good."},
        {"zh": "这酒杯我放下了。", "en": "I've set the cup down."},
        {"zh": "醉归醉，拳头还是认得路。", "en": "Drunk as I am, my fists still know the way."},
        {"zh": "来吧，我等得不耐烦了。", "en": "Come on; I am tired of waiting."},
        {"zh": "碰翻了酒杯，这账要算。", "en": "You knocked over my cup; that will be settled."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你走。", "en": "I circle around you."},
        {"zh": "三步就够了。", "en": "Three steps will do."},
        {"zh": "你退到柜台那边了。", "en": "You've backed to the counter."},
        {"zh": "那边是酒保的地方。", "en": "That's the barkeep's spot."},
        {"zh": "我踩着凳子上去。", "en": "I climb onto the bench."},
        {"zh": "木板吱了一声。", "en": "The plank creaked."},
        {"zh": "你的头在晃。", "en": "Your head is swaying."},
        {"zh": "是我晃，还是你晃？", "en": "Am I swaying, or are you?"},
        {"zh": "我抓住桌角。", "en": "I grip the table edge."},
        {"zh": "这样我就站稳了。", "en": "Now I'm steady."},
        {"zh": "你再退就没地方了。", "en": "Back up more and there's nowhere left."},
        {"zh": "酒杯一放，我晃着站起来。", "en": "I set the cup down and sway to my feet."},
        {"zh": "现在两只手都空着。", "en": "Both hands are free now."},
        {"zh": "你要打就打。", "en": "If you want to fight, fight."},
        {"zh": "我来数三下。", "en": "I'll count to three."},
        {"zh": "一、二、三。", "en": "One, two, three."},
        {"zh": "我忘了我数到几了。", "en": "I forgot which number I was at."},
        {"zh": "反正也快了。", "en": "Anyway, it's soon."},
        {"zh": "这里的桌子挡路。", "en": "These tables are in the way."},
        {"zh": "你绕不过这一圈。", "en": "You can't get out of this circle."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我抡起拳头。", "en": "I swing my fist."},
        {"zh": "这一下打偏了。", "en": "That one went wide."},
        {"zh": "但我撞到你了。", "en": "But I still hit you."},
        {"zh": "我用杯子砸。", "en": "I smash with the cup."},
        {"zh": "酒杯被我砸碎了。", "en": "The cup shattered."},
        {"zh": "手抖，这一拳还是准的。", "en": "Hands shaking, but the punch still lands."},
        {"zh": "这一脚踢歪了。", "en": "That kick went crooked."},
        {"zh": "你被我顶到墙角。", "en": "I've pushed you into the corner."},
        {"zh": "我抓着你的衣领。", "en": "I grab your collar."},
        {"zh": "醉了也有力气。", "en": "Drunk, I still have strength."},
        {"zh": "我一头撞在你肚子上。", "en": "I headbutt your stomach."},
        {"zh": "我的拳头落在你膝盖。", "en": "My fist lands on your knee."},
        {"zh": "你退，我就撞桌角。", "en": "You back off, I hit the table edge."},
        {"zh": "我抓着了你的腰带。", "en": "I've got hold of your belt."},
        {"zh": "我被你架住了胳膊。", "en": "You've locked my arms."},
        {"zh": "我松手你就往后倒。", "en": "I let go and you fall back."},
        {"zh": "这一下和上一杯一样重。", "en": "This one's as heavy as the last drink."},
        {"zh": "我打得没章法。", "en": "There's no method to my strikes."},
        {"zh": "但一下比一下准。", "en": "But each one lands truer."},
        {"zh": "你站着，我扶着桌子。", "en": "You stay up. I lean on the table."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从酒馆后面走出来。", "en": "I come out from behind the tavern."},
        {"zh": "手里还端着杯子。", "en": "A cup still in my hand."},
        {"zh": "这里是我常坐的位置。", "en": "This is my usual seat."},
        {"zh": "我冲你打了个招呼。", "en": "I wave a greeting at you."},
        {"zh": "桌上的酒还没收。", "en": "The ale on the table hasn't been cleared."},
        {"zh": "我一屁股坐下了。", "en": "I plop myself down."},
        {"zh": "这里的人都认识我。", "en": "Everyone here knows me."},
        {"zh": "今天不吵架，喝酒。", "en": "No quarrels today. Just drinking."},
        {"zh": "灯芯有点暗。", "en": "The wick is a bit dim."},
        {"zh": "我又倒了一杯。", "en": "I poured another."},
        {"zh": "别站着，坐下吧。", "en": "Don't stand. Sit down."},
        {"zh": "这店里暖和得很。", "en": "It's warm in here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把一碰，酒就烧了。", "en": "Fire touched the ale and it lit up."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从凳子上摔下去，正好。", "en": "I fell off the bench. Perfect landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "酒桶倒了，我呛了一口。", "en": "The barrel tipped and I choked on it."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我从椅子上掀翻。", "en": "The blast knocked me off the chair."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭钉进了我旁边的柱子。", "en": "An arrow stuck in the post beside me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光在我眼前炸开，我眼花。", "en": "Light burst before my eyes and blinded me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "光喝酒也饿，我肚子叫。", "en": "Ale alone still leaves me hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声一响，我的杯子跳了一下。", "en": "Thunder boomed and my cup jumped."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这下面空得让人头晕。", "en": "The emptiness below makes me dizzy."}
      ]
    }
  }
}
