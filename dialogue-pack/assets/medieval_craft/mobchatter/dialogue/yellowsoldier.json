{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "扛着长矛走不快。", "en": "The spear slows my walk."},
        {"zh": "黄布袖口磨破了。", "en": "My yellow sleeve is worn through."},
        {"zh": "绕营地转半圈。", "en": "Half a lap around the camp."},
        {"zh": "皮甲轻，脚步也轻。", "en": "Light leather, light steps."},
        {"zh": "去井边打点水。", "en": "Off to the well for water."},
        {"zh": "脚跟踩过碎石。", "en": "My heels crunch the gravel."},
        {"zh": "沿栅栏底下走。", "en": "I walk along the fence line."},
        {"zh": "前面有车，让一让。", "en": "Cart ahead — step aside."},
        {"zh": "去换岗，快迟了。", "en": "Late for the watch change."},
        {"zh": "低一下头过门。", "en": "Duck under the doorway."},
        {"zh": "步子和口令一样齐。", "en": "My pace keeps the same beat as the watch."},
        {"zh": "草鞋湿了，将就。", "en": "Straw shoes soaked — it'll do."},
        {"zh": "走完这圈去吃饭。", "en": "One lap, then food."},
        {"zh": "风吹开衣襟，按住。", "en": "Wind opens my coat — I hold it."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "把矛杆擦一擦。", "en": "I wipe down the spear shaft."},
        {"zh": "数营里的火把。", "en": "Counting the torches in camp."},
        {"zh": "腰带松了，系紧。", "en": "Belt's loose — tight it."},
        {"zh": "听营门外的动静。", "en": "Listening past the gate."},
        {"zh": "蹲下系鞋带。", "en": "Squatting to tie my shoes."},
        {"zh": "肩膀有点酸。", "en": "My shoulder aches."},
        {"zh": "看看锅里的粥。", "en": "Checking the porridge pot."},
        {"zh": "远处狗在叫。", "en": "A dog barks in the distance."},
        {"zh": "把黄袖标缝好。", "en": "I stitch the yellow armband."},
        {"zh": "蹲下来磨一磨矛尖。", "en": "I crouch and hone the spear tip."},
        {"zh": "今天轮到谁劈柴？", "en": "Who splits wood today?"},
        {"zh": "抖掉甲里的土。", "en": "I shake dirt out of my armor."},
        {"zh": "靠着栅栏发呆。", "en": "I lean on the fence and stare."},
        {"zh": "嘴里嚼着干草。", "en": "A straw of hay between my teeth."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "站住，哪儿来的？", "en": "Halt. Where are you from?"},
        {"zh": "口令，现在就说。", "en": "The password. Say it now."},
        {"zh": "手别摸腰带。", "en": "Hands off your belt."},
        {"zh": "这儿不许闲逛。", "en": "No loitering here."},
        {"zh": "你脸生得很。", "en": "Your face is unfamiliar."},
        {"zh": "往前一步就别怪矛尖。", "en": "One step more, and the spear speaks."},
        {"zh": "你是来报到的？", "en": "Here to report in?"},
        {"zh": "别盯着我的脸看。", "en": "Stop staring at my face."},
        {"zh": "鞋子是外乡的样式。", "en": "Those boots are foreign style."},
        {"zh": "有事快讲，我在岗上。", "en": "Speak fast. I'm on post."},
        {"zh": "亮出你的通行牌。", "en": "Show your pass."},
        {"zh": "这条路通向营地。", "en": "This road leads into camp."},
        {"zh": "退到那块石头外面。", "en": "Back up past that stone."},
        {"zh": "你笑了什么？", "en": "What are you grinning at?"},
        {"zh": "黄旗下，我的长矛认得你的脸。", "en": "Under the yellow banner, my spear knows your face."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哎哟，这一下！", "en": "Ow — that one!"},
        {"zh": "皮甲没挡住。", "en": "The leather didn't stop it."},
        {"zh": "血顺着胳膊流。", "en": "Blood runs down my arm."},
        {"zh": "我踉跄了一下。", "en": "I stumbled a step."},
        {"zh": "牙咬得咯咯响。", "en": "My teeth are grinding."},
        {"zh": "手还举得起长矛。", "en": "I can still lift the spear."},
        {"zh": "膝盖有点软。", "en": "My knees feel weak."},
        {"zh": "别小看步兵。", "en": "Don't underestimate a footman."},
        {"zh": "这伤回去要挨骂。", "en": "The captain will scold me for this."},
        {"zh": "谁砍的，我记住了。", "en": "I remember who cut me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "粥味飘过来了。", "en": "The porridge smell carries."},
        {"zh": "那饼看着真香。", "en": "That flatbread looks good."},
        {"zh": "水壶递我一口。", "en": "A sip from that waterskin."},
        {"zh": "有干肉？真的？", "en": "Dried meat? Truly?"},
        {"zh": "我午饭还没吃。", "en": "I haven't had lunch."},
        {"zh": "那把匕首换我半块饼。", "en": "That dagger for half my bread?"},
        {"zh": "咸鱼，我最爱。", "en": "Salted fish — my favorite."},
        {"zh": "磨刀石给我用一下。", "en": "May I use that whetstone?"},
        {"zh": "别把锅端走。", "en": "Don't take the pot away."},
        {"zh": "我饿得能吞下石头。", "en": "I'm hungry enough to eat stone."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "嘿，你走路看路吗？", "en": "Hey, do you watch where you walk?"},
        {"zh": "矛杆被撞歪了。", "en": "My spear shaft got knocked askew."},
        {"zh": "踩到我的脚了。", "en": "You stepped on my foot."},
        {"zh": "别挤，队伍会乱。", "en": "Don't shove — the line will break."},
        {"zh": "我这边没地方让。", "en": "No room on my side."},
        {"zh": "撞得我牙都响。", "en": "My teeth rattled from that."},
        {"zh": "稳住，地上滑。", "en": "Steady. The ground's slick."},
        {"zh": "谁在后面推我？", "en": "Who pushed me from behind?"},
        {"zh": "肩膀别顶我。", "en": "Quit jabbing my shoulder."},
        {"zh": "你撞飞了我的帽。", "en": "You knocked my cap off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "咱俩都守过夜哨。", "en": "We've both stood night watch."},
        {"zh": "换岗后到墙根说话。", "en": "Meet me by the wall after watch."},
        {"zh": "你唱的那首歌不错。", "en": "That song you sang was good."},
        {"zh": "我给你留一勺粥。", "en": "I'll save you a spoon of porridge."},
        {"zh": "别让队长看见。", "en": "Don't let the captain see."},
        {"zh": "我攒了点铜币。", "en": "I've saved a few coppers."},
        {"zh": "冬天挤一起取暖吧。", "en": "Let's share warmth this winter."},
        {"zh": "你笑我才敢说。", "en": "I only speak when you smile."},
        {"zh": "袖标借我缝一下。", "en": "Lend me your armband to stitch mine."},
        {"zh": "活得久一点，才行。", "en": "We have to live long enough."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有个铜板。", "en": "A copper on the ground."},
        {"zh": "断矛杆还能削。", "en": "Broken shaft — still whittling stock."},
        {"zh": "捡根绳子绑鞋。", "en": "I take a cord to lace my shoes."},
        {"zh": "这块布擦矛。", "en": "This cloth will clean my spear."},
        {"zh": "谁掉了扣子。", "en": "Someone dropped a button."},
        {"zh": "一截蜡烛，值钱。", "en": "A candle stub — worth something."},
        {"zh": "干草塞鞋里。", "en": "I stuff hay in my shoes."},
        {"zh": "这块石头能磨刀。", "en": "This stone will hone a blade."},
        {"zh": "捡到的先交公。", "en": "Finds go to the quartermaster."},
        {"zh": "半截箭头还能用。", "en": "Half an arrowhead still works."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有人翻栅栏！", "en": "Someone's over the fence!"},
        {"zh": "那边的狗不叫了。", "en": "The dogs stopped barking over there."},
        {"zh": "不是我们的人。", "en": "Not one of ours."},
        {"zh": "举矛，先对准了。", "en": "Spear up. Take aim!"},
        {"zh": "他背着我们的锅。", "en": "He's got our pot on his back."},
        {"zh": "快去把人都叫来。", "en": "Call the others. Go!"},
        {"zh": "影子在粮仓后面。", "en": "A shape behind the granary."},
        {"zh": "他手上有刀。", "en": "He's holding a blade."},
        {"zh": "我挡住门口。", "en": "I'll hold the doorway."},
        {"zh": "是敌人，不是贼。", "en": "Hostile, not a thief."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你的脚。", "en": "My eyes follow your feet."},
        {"zh": "他在绕帐篷。", "en": "He's circling the tents."},
        {"zh": "等我同伴就位。", "en": "Wait till my partner's set."},
        {"zh": "矛尖不离你胸口。", "en": "My point stays on your chest."},
        {"zh": "他往柴堆后面走。", "en": "He's behind the woodpile."},
        {"zh": "别急，他跑不掉。", "en": "Easy — he can't escape."},
        {"zh": "再近一步就扎下去。", "en": "One step more and I thrust."},
        {"zh": "他的刀是短的。", "en": "His blade is short."},
        {"zh": "我数他的呼吸。", "en": "I count his breaths."},
        {"zh": "地上的脚印很清楚。", "en": "His prints are clear in the dirt."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "矛尖往前扎下去！", "en": "The point drives forward!"},
        {"zh": "两只手把矛送出去！", "en": "Both hands push the spear out!"},
        {"zh": "退开我的矛长！", "en": "Stay off my reach!"},
        {"zh": "横扫你小腿。", "en": "A sweep at your shins."},
        {"zh": "矛尖专找甲的缝。", "en": "My point hunts the armor's seams."},
        {"zh": "一步进，一步退。", "en": "Step in, step out."},
        {"zh": "这一下给锅。", "en": "That one's for stealing our pot."},
        {"zh": "用矛杆敲你。", "en": "The shaft cracks you."},
        {"zh": "换手，再来一下！", "en": "Switch hands — again!"},
        {"zh": "贴着栅栏打。", "en": "Fight with my back to the fence."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我接了这班岗。", "en": "I've taken this watch."},
        {"zh": "黄袖标，认得吧。", "en": "Yellow armband. You know it."},
        {"zh": "营门口站好。", "en": "I take my place at the gate."},
        {"zh": "粥还在锅里？好。", "en": "Porridge still in the pot? Good."},
        {"zh": "号声一响我就跑。", "en": "One horn and I run."},
        {"zh": "风把黄旗吹得响。", "en": "The yellow banner snaps in the wind."},
        {"zh": "我来守这道栅栏。", "en": "I hold this fence line."},
        {"zh": "巡到天黑为止。", "en": "Patrolling till dark."},
        {"zh": "火堆边留我一角。", "en": "Leave me a corner by the fire."},
        {"zh": "营门开了，我上。", "en": "Gate's open. I go up."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "袖子着火了！", "en": "My sleeve's on fire!"}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，屁股疼。", "en": "Fell off — my backside hurts."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水呛进鼻子了。", "en": "Water up my nose."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "土都震到嘴里。", "en": "Dirt's in my mouth from the blast."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭擦过我的腰。", "en": "An arrow grazed my side."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "什么东西烫我？", "en": "What burned me just now?"}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "肚子空得发响。", "en": "My empty belly is roaring."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我旁边！", "en": "The bolt struck beside me!"}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "地没了，我往下掉。", "en": "The ground's gone — I'm dropping."}
      ]
    }
  }
}
