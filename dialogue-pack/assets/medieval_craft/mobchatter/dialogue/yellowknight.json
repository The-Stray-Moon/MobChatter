{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "板甲沉，步子也沉。", "en": "Plate is heavy. So are my steps."},
        {"zh": "剑鞘碰腿，叮当。", "en": "Scabbard taps my leg."},
        {"zh": "绕营地走一整圈。", "en": "One full circuit of the camp."},
        {"zh": "盾牌挂在左臂。", "en": "Shield rides my left arm."},
        {"zh": "过泥地，慢些走。", "en": "Mud ahead — slow down."},
        {"zh": "罩袍下摆擦着草。", "en": "My tabard brushes the grass."},
        {"zh": "去马厩看看拴绳。", "en": "Off to check the stable ties."},
        {"zh": "几步一停，听风。", "en": "Stop every few steps, listen."},
        {"zh": "甲靴踩得石路响。", "en": "Steel boots ring on the stones."},
        {"zh": "巡到东门就折返。", "en": "I turn back at the east gate."},
        {"zh": "护膝有点磨。", "en": "My knee guard is chafing."},
        {"zh": "路边让一让商队。", "en": "Step aside for the caravan."},
        {"zh": "低头过门楣。", "en": "Duck low through the lintel."},
        {"zh": "把旗子扶正了再走。", "en": "I straighten the banner, then walk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "把剑身擦到发亮。", "en": "I polish the blade until it shines."},
        {"zh": "检查盾的绑带。", "en": "I check the shield straps."},
        {"zh": "头盔里闷得慌。", "en": "It's close inside this helm."},
        {"zh": "数一数营火。", "en": "Counting the campfires."},
        {"zh": "听听门外的马蹄。", "en": "Listening for hooves outside."},
        {"zh": "把黄罩袍抚平。", "en": "I smooth my yellow tabard."},
        {"zh": "剑柄缠布松了。", "en": "The grip wrap has loosened."},
        {"zh": "抬眼看堡顶。", "en": "I look up at the keep."},
        {"zh": "今天谁当值？", "en": "Who's on duty today?"},
        {"zh": "风吹得铁片凉。", "en": "The wind chills my plate."},
        {"zh": "舔舔干裂的嘴唇。", "en": "I wet my cracked lips."},
        {"zh": "擦擦胸甲的划痕。", "en": "I rub a scratch on my breastplate."},
        {"zh": "远处在练剑。", "en": "Sword practice far off."},
        {"zh": "把腰带收紧一格。", "en": "I tighten my belt a notch."},
        {"zh": "靠着石墙歇气。", "en": "I lean on the stone wall."},
        {"zh": "院里小孩在跑。", "en": "Children run in the yard."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "卸下武器再走近。", "en": "Lay down your arms first."},
        {"zh": "报上你的封号。", "en": "Give me your title."},
        {"zh": "你的靴子沾了外乡泥。", "en": "Your boots carry foreign mud."},
        {"zh": "站在这条线外。", "en": "Stand beyond this line."},
        {"zh": "眼睛看着我，别瞟。", "en": "Eyes on me. Don't wander."},
        {"zh": "这身甲不是随便穿的。", "en": "This armor isn't worn lightly."},
        {"zh": "你要见谁，先过我。", "en": "To see anyone, you pass me."},
        {"zh": "你的剑没有鞘，为何。", "en": "Bare blade — why?"},
        {"zh": "天色不早，说重点。", "en": "It's late. Be brief."},
        {"zh": "我不认得你的纹章。", "en": "I don't know your crest."},
        {"zh": "双手摊开，让我看。", "en": "Open your hands. Show me."},
        {"zh": "城里的规矩你懂吗？", "en": "Do you know our rules here?"},
        {"zh": "别把手放在腰间。", "en": "Hands off your belt."},
        {"zh": "说，是敌是友。", "en": "Speak. Friend or foe?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲挡了一半。", "en": "Plate took half of it."},
        {"zh": "这一下扎实。", "en": "That one landed solid."},
        {"zh": "我单膝跪地，又起来。", "en": "I drop to one knee, then rise."},
        {"zh": "肩甲压得手臂发麻。", "en": "My pauldron numbs the arm."},
        {"zh": "血在衬里渗开。", "en": "Blood spreads in the padding."},
        {"zh": "剑还握得住。", "en": "I can still hold my sword."},
        {"zh": "护甲还在响。", "en": "My armor still rings."},
        {"zh": "头盔歪了，扶正。", "en": "Helm askew — I straighten it."},
        {"zh": "记住谁砍的。", "en": "I mark who struck me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那壶酒是给谁送的？", "en": "Who's that jug of wine for?"},
        {"zh": "好马，真不错。", "en": "A fine horse. Very fine."},
        {"zh": "面包分我一块。", "en": "Break me off some bread."},
        {"zh": "这护手做得漂亮。", "en": "This gauntlet is beautiful work."},
        {"zh": "我缺一条新皮带。", "en": "I could use a new belt."},
        {"zh": "那盘肉看着真香。", "en": "That plate of meat smells good."},
        {"zh": "盾油，正好用完了。", "en": "Shield oil — mine ran out."},
        {"zh": "这块布擦剑正合适。", "en": "This cloth is right for my blade."},
        {"zh": "我很久没喝到麦酒了。", "en": "I've had no ale in ages."},
        {"zh": "那把匕首，你留着？", "en": "Keeping that dagger, are you?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "小心，撞上板甲很疼。", "en": "Careful — plate hurts to hit."},
        {"zh": "退开，你踩了我的罩袍。", "en": "Back up. You're on my tabard."},
        {"zh": "这条路只容一人过。", "en": "Only one fits on this path."},
        {"zh": "站稳，别撞掉我的盔。", "en": "Steady. Don't knock my helm."},
        {"zh": "让路给骑士。", "en": "Make way for a knight."},
        {"zh": "你肩膀撞到我的剑柄了。", "en": "Your shoulder hit my hilt."},
        {"zh": "急什么，前面是门。", "en": "Why hurry? There's a gate ahead."},
        {"zh": "我这边是墙，别挤。", "en": "Wall on my side. Don't crowd."},
        {"zh": "撞上盔甲，自己疼。", "en": "Hitting armor only hurts you."},
        {"zh": "脚下是台阶，看路。", "en": "Steps here. Watch your feet."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同营同旗，才谈这个。", "en": "Same camp, same banner — then we talk."},
        {"zh": "我先守完这班岗。", "en": "After this watch is over."},
        {"zh": "你的剑法我看了三遍。", "en": "I've watched your swordwork three times."},
        {"zh": "别让人看见。", "en": "Don't let them see us."},
        {"zh": "甲太沉，帮我把扣解开。", "en": "This plate is heavy — undo the clasp."},
        {"zh": "若我战死，别等我。", "en": "If I fall, don't wait."},
        {"zh": "黄罩袍配你正合适。", "en": "The yellow tabard suits you."},
        {"zh": "营火旁边说得轻一点。", "en": "Keep your voice low by the fire."},
        {"zh": "一起发誓守这座城。", "en": "Swear with me to hold this keep."},
        {"zh": "先活着回来再说。", "en": "Come back alive first."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这枚饰钉能修护肩。", "en": "This stud will fix my pauldron."},
        {"zh": "断箭，收起来。", "en": "A broken arrow — take it."},
        {"zh": "地上的扣带是我的。", "en": "That strap on the ground is mine."},
        {"zh": "捡起这枚铜币。", "en": "I pick up the copper coin."},
        {"zh": "这块石头有铁纹。", "en": "This stone shows iron veins."},
        {"zh": "谁丢了手套？", "en": "Who lost a glove?"},
        {"zh": "一捆布条，裹伤用。", "en": "A roll of cloth for wounds."},
        {"zh": "把马刺收回袋里。", "en": "I pocket the spur."},
        {"zh": "这截绳子留着。", "en": "I keep this length of rope."},
        {"zh": "剑鞘的钉子找到了。", "en": "Found the nail for my scabbard."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那人手里的刀没鞘！", "en": "That one's blade is bare!"},
        {"zh": "营门口有人翻墙。", "en": "Someone's climbing the gate."},
        {"zh": "是他们的旗号。", "en": "That's their banner."},
        {"zh": "列队！敌人来了。", "en": "Form up! Enemy in sight."},
        {"zh": "我认得那副甲。", "en": "I know that armor."},
        {"zh": "他杀了我们的哨兵。", "en": "He killed our sentry."},
        {"zh": "关门，别放他走。", "en": "Shut the gate. Don't let him out."},
        {"zh": "举盾，斜向上。", "en": "Shields up, angled high."},
        {"zh": "他脚步很稳，不好打。", "en": "His footing's solid. Tough one."},
        {"zh": "我来挡第一击。", "en": "I'll take the first blow."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "他每刀都收得早。", "en": "He recovers fast from every cut."},
        {"zh": "我在等他抬肩。", "en": "I wait for him to lift a shoulder."},
        {"zh": "绕他右侧走。", "en": "Circle to his right."},
        {"zh": "他的盾角露缝。", "en": "There's a gap at his shield edge."},
        {"zh": "他换手了，注意。", "en": "He switched hands — mind that."},
        {"zh": "慢慢耗掉他的力气。", "en": "I wear his strength down slowly."},
        {"zh": "退半步，让他进。", "en": "Half step back — let him in."},
        {"zh": "别追进巷子。", "en": "Don't chase into the alley."},
        {"zh": "他的甲背上有缝。", "en": "There's a seam in his backplate."},
        {"zh": "把脚踩稳，别打滑。", "en": "Plant your feet. Don't slip."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "双手握住剑柄劈下！", "en": "Both hands on the hilt, cutting down!"},
        {"zh": "盾架住，再还击。", "en": "Block with the shield, then answer."},
        {"zh": "刺向你的肩甲缝！", "en": "Thrust at your shoulder seam!"},
        {"zh": "往下压，压住他！", "en": "Press down. Pin him!"},
        {"zh": "横扫，退后一步。", "en": "Sweep — back a step."},
        {"zh": "剑尖找你的咽喉。", "en": "My point seeks your throat."},
        {"zh": "撞盾，撞开他的门。", "en": "Shield bash to break his guard."},
        {"zh": "这一剑为城。", "en": "This strike is for the keep."},
        {"zh": "砍你的剑柄！", "en": "I cut at your hilt!"},
        {"zh": "退，重整架势。", "en": "Back off and reset my guard."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黄旗升起，骑士到位。", "en": "Yellow banner raised — the knight stands."},
        {"zh": "城垛上不留空位。", "en": "No empty posts on this wall."},
        {"zh": "我披甲来守这一段。", "en": "I take this stretch in armor."},
        {"zh": "剑已出鞘，盾已挂臂。", "en": "Blade drawn, shield hung."},
        {"zh": "营门开，我出去。", "en": "Camp gate opens. I ride out."},
        {"zh": "今日我守东墙。", "en": "Today I hold the east wall."},
        {"zh": "钟声一响我就来。", "en": "One bell and I'm here."},
        {"zh": "我把剑插进门缝。", "en": "I plant my sword in the doorway."},
        {"zh": "换岗，我来了。", "en": "Change of watch. I'm here."},
        {"zh": "我守到最后一个。", "en": "I hold till the last one."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火舌舔过罩袍！", "en": "Flame licks across my tabard!"}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "甲太重，落地震脚。", "en": "Plate is heavy — the landing jarred me."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进甲缝里。", "en": "Water seeps through my armor's joints."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "震得我耳朵嗡嗡。", "en": "The blast leaves my ears ringing."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭卡在胸甲上。", "en": "An arrow's stuck in my breastplate."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "邪光烫透了铁。", "en": "Witchlight burned through the iron."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿了三天，剑都变沉。", "en": "Three days fasting — the sword feels heavier."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷火顺着剑柄爬。", "en": "Lightning crawls up my hilt."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下石地消失。", "en": "The stone floor is gone."}
      ]
    }
  }
}
