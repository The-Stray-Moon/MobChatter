{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "登上塔楼，靴底敲石。", "en": "Up the tower, boots on stone."},
        {"zh": "箭袋在腰后晃。", "en": "My quiver sways at my hip."},
        {"zh": "沿着城墙慢慢走一圈。", "en": "One slow lap along the wall."},
        {"zh": "弓在肩上，别碰。", "en": "Bow on my shoulder — don't touch."},
        {"zh": "挑个视野好的垛口。", "en": "Picking a clear embrasure."},
        {"zh": "下梯子，脚步放轻。", "en": "Down the ladder, stepping light."},
        {"zh": "黄罩袍扫过台阶。", "en": "My yellow tabard sweeps the stairs."},
        {"zh": "巡墙要贴边走。", "en": "Walk the inner edge on patrol."},
        {"zh": "换个角度看看河面。", "en": "New angle on the river."},
        {"zh": "穿过拱门，低头。", "en": "Through the arch — duck my head."},
        {"zh": "去箭库补一捆。", "en": "Off to refill a bundle of arrows."},
        {"zh": "风大了，走稳些。", "en": "Wind's up. Walk steady."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "搭弦，试张力。", "en": "I draw and test the string."},
        {"zh": "数箭，还剩十九支。", "en": "Counting arrows — nineteen left."},
        {"zh": "风向偏西，记下。", "en": "Wind favors west. Noted."},
        {"zh": "擦掉弓臂的泥。", "en": "I wipe mud off the limbs."},
        {"zh": "看看城下的影子。", "en": "I study shadows below the wall."},
        {"zh": "帽檐压低点。", "en": "I pull my brim lower."},
        {"zh": "有人在下面挥手。", "en": "Someone waves from below."},
        {"zh": "羽箭排整齐。", "en": "I line the fletchings up."},
        {"zh": "今天云层很厚。", "en": "Thick cloud today."},
        {"zh": "靠墙眯一会儿。", "en": "I lean on the wall and squint."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "谁让你上城墙的？", "en": "Who let you onto the wall?"},
        {"zh": "站住，别碰弩机。", "en": "Halt. Hands off the winch."},
        {"zh": "抬头，报上名来。", "en": "Head up. Name yourself."},
        {"zh": "穿得不像守军。", "en": "You don't dress like garrison."},
        {"zh": "再往前就是禁区。", "en": "One step more is off limits."},
        {"zh": "你身上有弓弦味。", "en": "You smell of bowstring."},
        {"zh": "手离箭袋远点。", "en": "Hands off my quiver."},
        {"zh": "我数到三你就退。", "en": "I count to three, you step back."},
        {"zh": "你走路的姿势不像商人。", "en": "You walk like no merchant."},
        {"zh": "看什么，看路。", "en": "What are you staring at? Watch the path."},
        {"zh": "想借箭？先说理由。", "en": "Borrow arrows? Give me a reason."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "肩膀中了一下。", "en": "Something hit my shoulder."},
        {"zh": "血滴在弦上了。", "en": "Blood on my string."},
        {"zh": "我咬牙，继续拉。", "en": "I bite down and keep drawing."},
        {"zh": "别扶我，我能站。", "en": "Don't hold me. I can stand."},
        {"zh": "这点伤不碍射。", "en": "This won't spoil my aim."},
        {"zh": "呼吸乱了半拍。", "en": "My breathing skipped a beat."},
        {"zh": "退半步，缓一缓。", "en": "Half a step back to steady."},
        {"zh": "疼得弓都晃。", "en": "The pain makes my bow waver."},
        {"zh": "我记着这笔。", "en": "I'm keeping score."},
        {"zh": "再来一下我也不退。", "en": "One more and I still won't yield."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那捆箭是新的吧？", "en": "That bundle of arrows is new, yes?"},
        {"zh": "弓弦蜡，给我留点。", "en": "Leave me some string wax."},
        {"zh": "筐里有面包，看到了。", "en": "I see bread in that basket."},
        {"zh": "带弦的手感真好。", "en": "That string feels lovely."},
        {"zh": "箭羽再差也比没有强。", "en": "Poor fletching beats none."},
        {"zh": "那袋干肉递过来。", "en": "Pass that bag of dried meat."},
        {"zh": "我需要一壶水。", "en": "I could use a waterskin."},
        {"zh": "好铁箭头，眼睛亮了。", "en": "Good iron heads — my eyes widen."},
        {"zh": "别拿走那卷绳。", "en": "Don't take that coil of cord."},
        {"zh": "换我值岗，换口吃的。", "en": "I'll take a shift for a meal."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "喂，我看的是下面！", "en": "Hey, I'm watching below!"},
        {"zh": "肩撞肩，箭都歪了。", "en": "Shoulder to shoulder — arrows askew."},
        {"zh": "让开，这里只容一人。", "en": "Move — only one fits here."},
        {"zh": "你踩了我的箭。", "en": "You stepped on my arrows."},
        {"zh": "别推，我在垛口边。", "en": "Don't push. I'm at the edge."},
        {"zh": "撞得我弓差点脱手。", "en": "I nearly dropped my bow."},
        {"zh": "靠外墙走，别挤我。", "en": "Take the outer side."},
        {"zh": "帽檐撞歪了。", "en": "My brim's knocked crooked."},
        {"zh": "急什么，前面堵着。", "en": "Why the rush? It's blocked ahead."},
        {"zh": "站稳，这梯子窄。", "en": "Steady — the ladder's narrow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你也守北墙？巧了。", "en": "You guard the north wall too? Fancy."},
        {"zh": "换岗后一起喝一杯。", "en": "A drink after we're relieved."},
        {"zh": "你拉弓的样子真稳。", "en": "You draw so steadily."},
        {"zh": "我的箭袋可以分你一半。", "en": "Half my quiver is yours."},
        {"zh": "别说太高，墙上有耳朵。", "en": "Not so loud — walls have ears."},
        {"zh": "同一片垛口，看同一片天。", "en": "Same embrasure, same sky."},
        {"zh": "打完这仗，我教你调弓。", "en": "After this fight, I'll teach you tuning."},
        {"zh": "你手心的茧，我看见了。", "en": "I saw the calluses on your palms."},
        {"zh": "一起数到天亮吧。", "en": "Let's count the hours till dawn."},
        {"zh": "别把话说满，先活下来。", "en": "Don't promise — just live."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "掉在地上的箭，归公。", "en": "Fallen arrows go to the garrison."},
        {"zh": "一截断弦，还能接。", "en": "A snapped string — still spliceable."},
        {"zh": "这块布正好擦弓。", "en": "This rag will do for the bow."},
        {"zh": "捡到一枚铜扣。", "en": "Found a copper clasp."},
        {"zh": "箭头崩了，磨磨还能用。", "en": "Chipped head — grinding fixes it."},
        {"zh": "谁的帽带？我先收着。", "en": "Whose hat cord? I'll hold it."},
        {"zh": "这根木条能做箭杆。", "en": "This stick can be a shaft."},
        {"zh": "地上有半块饼。", "en": "Half a biscuit on the ground."},
        {"zh": "蜡块，正好上弦。", "en": "A lump of wax — just right."},
        {"zh": "袋子空了，捡点碎石。", "en": "My pouch is empty — gathering pebbles."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "城下有影子在动！", "en": "Movement below the wall!"},
        {"zh": "那个人在爬梯子。", "en": "That one's on the ladder."},
        {"zh": "搭箭，别出声。", "en": "Nock an arrow. Quiet."},
        {"zh": "他背着我们的箱子。", "en": "He's carrying our chest."},
        {"zh": "左边第三个，是他。", "en": "Third from the left — him."},
        {"zh": "有敌人贴近墙根！", "en": "Enemy hugging the wall!"},
        {"zh": "我先射那个举旗的。", "en": "I take the standard-bearer first."},
        {"zh": "拉满，等风向。", "en": "Full draw. Wait for the wind."},
        {"zh": "看见他了，别喊。", "en": "I have him. Don't shout."},
        {"zh": "有人摸上来了。", "en": "Someone's climbing up."},
        {"zh": "他的手在摸火把。", "en": "His hand is on a torch."},
        {"zh": "那是敌人的颜色。", "en": "That's the enemy's color."},
        {"zh": "他停下，正好瞄。", "en": "He stopped — perfect shot."},
        {"zh": "目标在井边。", "en": "Target by the well."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头跟着他的胸口。", "en": "My point tracks his chest."},
        {"zh": "等他探头再放。", "en": "Wait till he shows his head."},
        {"zh": "他往车后躲。", "en": "He's hiding behind the cart."},
        {"zh": "再走两步就进射界。", "en": "Two steps more into my line."},
        {"zh": "风小了一点。", "en": "The wind's easing."},
        {"zh": "他的甲在左肩有空隙。", "en": "His left shoulder has a gap."},
        {"zh": "别急，箭不便宜。", "en": "Patience — arrows aren't cheap."},
        {"zh": "他朝塔楼看了。", "en": "He glanced at the tower."},
        {"zh": "我压住呼吸。", "en": "I hold my breath."},
        {"zh": "他绕到石柱后了。", "en": "He slipped behind the pillar."},
        {"zh": "我换个垛口等。", "en": "I shift to another slit and wait."},
        {"zh": "他的盾举得太高。", "en": "His shield rides too high."},
        {"zh": "他还不知道我在。", "en": "He still doesn't know I'm here."},
        {"zh": "影子往右偏了。", "en": "His shadow leans right."},
        {"zh": "稳住，别惊动他。", "en": "Steady. Don't spook him."},
        {"zh": "这一箭要一次成。", "en": "This shot must land once."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "近身也照样打！", "en": "Close range is still my range!"},
        {"zh": "弓臂抽你的脸！", "en": "The bow limb cracks your face!"},
        {"zh": "匕首在靴筒里。", "en": "My knife was in my boot."},
        {"zh": "滚下城墙去！", "en": "Roll off my wall!"},
        {"zh": "别抓我的弦！", "en": "Hands off my string!"},
        {"zh": "拿箭当刺刀用。", "en": "The arrow works as a spike."},
        {"zh": "我可不是只会放箭。", "en": "I'm not just a shooter."},
        {"zh": "退开，我要拉弓。", "en": "Back off — I need room."},
        {"zh": "一脚踹你下梯。", "en": "A kick sends you down the ladder."},
        {"zh": "顶着你的刀拉弦。", "en": "I draw against your blade."},
        {"zh": "弓梢狠砸你的手腕。", "en": "The bow limb cracks your wrist."},
        {"zh": "我不怕打近架。", "en": "Close fighting doesn't scare me."},
        {"zh": "弓梢捅你肋下。", "en": "The bow tip jabs your ribs."},
        {"zh": "守垛口，寸步不让。", "en": "I hold this slit, inch by inch."},
        {"zh": "你没箭，我有。", "en": "You've no arrows. I do."},
        {"zh": "这一下是替城墙。", "en": "That one was for the wall."},
        {"zh": "别逼我弃弓。", "en": "Don't make me drop the bow."},
        {"zh": "近了就更好瞄！", "en": "Closer only makes it easier!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黄旗之下，我在。", "en": "Under the yellow banner, I stand."},
        {"zh": "上塔楼，接射位。", "en": "To the tower — taking my post."},
        {"zh": "箭已经上弦了。", "en": "Arrow's already nocked."},
        {"zh": "我来守这一段墙。", "en": "I'll hold this stretch of wall."},
        {"zh": "梯子还热，我刚爬上来。", "en": "The ladder's warm — just climbed it."},
        {"zh": "听见喊杀就拉弓。", "en": "I draw at the first war cry."},
        {"zh": "风从河面吹来，正好。", "en": "Wind off the river — perfect."},
        {"zh": "城垛后面，没人看得见。", "en": "Behind the merlon, unseen."},
        {"zh": "我带了三十支箭。", "en": "I brought thirty arrows."},
        {"zh": "号角响，我到位。", "en": "Horn sounded. I'm in place."},
        {"zh": "黄罩袍一露，敌人就懂。", "en": "One flash of yellow and they know."},
        {"zh": "我站得比旗杆还直。", "en": "I stand straighter than the flagpole."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "袖口着火了，拍！", "en": "My cuff's alight — beat it out!"}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从垛口摔下去，脚崴了。", "en": "Fell off the slit — ankle's twisted."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "护城河的水真冷。", "en": "The moat water is bitter cold."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "墙在震，我耳鸣。", "en": "The wall shakes; my ears ring."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "对方也有弓手！", "en": "They have archers too!"}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这道光烧穿了我的罩袍。", "en": "That light burned through my tabard."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "守太久，饭都凉了。", "en": "Too long on watch — my meal went cold."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在旗杆上！", "en": "Lightning hit the flagpole!"}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下空了，箭也掉了。", "en": "The ground's gone — so are my arrows."}
      ]
    }
  }
}
