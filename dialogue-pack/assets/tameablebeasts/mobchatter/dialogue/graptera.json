{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我收起一只翅膀，走了两步。", "en": "I fold one wing and take two steps."},
        {"zh": "翼骨比我的腿还长。", "en": "My wing bones are longer than my legs."},
        {"zh": "翼骨撑地，我笨拙地挪了两步。", "en": "I brace on my wing bones and shuffle two clumsy steps."},
        {"zh": "风一来，我就张开翼。", "en": "When wind comes, I open my wings."},
        {"zh": "翅膀一撑，我离地了。", "en": "One push and I am airborne."},
        {"zh": "我升到树顶那么高。", "en": "I rise to treetop height."},
        {"zh": "又慢慢落下来。", "en": "Then settle back down."},
        {"zh": "我的喙很长，朝前伸。", "en": "My long beak points forward."},
        {"zh": "头上的冠是硬的。", "en": "The crest on my head is hard."},
        {"zh": "我在林间滑了一小段。", "en": "I glide a short stretch through the trees."},
        {"zh": "落在石头上，收翼。", "en": "I land on a stone and fold up."},
        {"zh": "地上的蚂蚁被我踩散了。", "en": "Ants scatter under my feet."},
        {"zh": "我走了几步，又起飞。", "en": "A few steps, then up again."},
        {"zh": "这样走不累。", "en": "Traveling this way is easy."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在枝头，翼垂着。", "en": "I perch on a branch, wings hanging."},
        {"zh": "风穿过我的翼膜。", "en": "Wind passes through my wing membranes."},
        {"zh": "我把头转过去看。", "en": "I turn my head to look."},
        {"zh": "林子里有虫子。", "en": "There are insects in the woods."},
        {"zh": "我伏着没有挪。", "en": "I perch without shifting."},
        {"zh": "等它们自己来。", "en": "Let them come."},
        {"zh": "有一只落在了我的喙上。", "en": "One lands on my beak."},
        {"zh": "我一口合上。", "en": "I snap once."},
        {"zh": "虫已经没了。", "en": "The bug is gone."},
        {"zh": "我慢慢咀嚼。", "en": "I chew slowly."},
        {"zh": "翼尖蹭到树干。", "en": "My wingtip brushes the trunk."},
        {"zh": "我把翼收得更紧。", "en": "I fold them tighter."},
        {"zh": "我的影子在草地上很大。", "en": "My shadow is large on the grass."},
        {"zh": "有一只鸟从我上方飞过。", "en": "A bird flies over me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我斜着头瞧你。", "en": "I eye you with a tilted head."},
        {"zh": "你先伸了手。", "en": "You reach out first."},
        {"zh": "我没有飞走。", "en": "I do not fly off."},
        {"zh": "你把东西放在掌心。", "en": "You set something on your palm."},
        {"zh": "我把脑袋低下来。", "en": "I lower my head."},
        {"zh": "我的长喙几乎碰到你的脸。", "en": "My long beak comes within a hair of your face."},
        {"zh": "你的掌心摊开，我一动不动。", "en": "Your palm lies open; I hold perfectly still."},
        {"zh": "我抬起头，靠得更近。", "en": "I lift my head and lean nearer."},
        {"zh": "你叫了一声。", "en": "You say something."},
        {"zh": "我歪着头，不打算回答。", "en": "I tilt my head and do not bother to answer."},
        {"zh": "但我没有走。", "en": "But I do not leave."},
        {"zh": "这就是回应。", "en": "That is the answer."},
        {"zh": "我偏过脑袋，单眼盯着你。", "en": "I tilt my head and fix a single eye on you."},
        {"zh": "你笑了一声。", "en": "You laugh once."},
        {"zh": "我不懂那个表情。", "en": "I do not understand that expression."},
        {"zh": "但我不讨厌。", "en": "But I do not dislike it."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫了一声，翼张开。", "en": "I cry out, wings spread."},
        {"zh": "我跳开两尺。", "en": "I spring two feet away."},
        {"zh": "翼膜上有道口子。", "en": "A tear in my wing membrane."},
        {"zh": "我低头看它。", "en": "I look down at it."},
        {"zh": "血珠一颗颗挂在边上。", "en": "Blood beads along the edge."},
        {"zh": "翼膜破了一道，我收紧了它。", "en": "I fold my torn wing membrane in tight."},
        {"zh": "疼得我不敢张。", "en": "Too sore to spread it."},
        {"zh": "我改用走的。", "en": "I go on foot instead."},
        {"zh": "我又走了几步。", "en": "I walk a few more steps."},
        {"zh": "慢，但可以。", "en": "Slow, but possible."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "生肉的气味让我尾尖发颤。", "en": "The smell of raw meat makes my tail tip twitch."},
        {"zh": "我从枝上跳下来。", "en": "I drop from the branch."},
        {"zh": "翼撑了一下，落得很轻。", "en": "My wings catch; I land light."},
        {"zh": "我叼过来就吃。", "en": "I take it and eat."},
        {"zh": "吃的时候我看着你。", "en": "I watch you while I eat."},
        {"zh": "你不会抢吧。", "en": "You will not snatch it, will you?"},
        {"zh": "我又啄了一口。", "en": "I peck once more."},
        {"zh": "这块肉很香。", "en": "This meat smells good."},
        {"zh": "我吃完舔了舔喙。", "en": "I lick my beak clean."},
        {"zh": "然后又抬头。", "en": "And look up again."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的翼上。", "en": "You bump my wing."},
        {"zh": "翼膜被压凹了一块。", "en": "The membrane dents."},
        {"zh": "我跳开，抖了抖。", "en": "I hop away and shake."},
        {"zh": "翼膜慢慢弹回原样。", "en": "The membrane springs back."},
        {"zh": "我转回头看。", "en": "I turn to look back."},
        {"zh": "我一点也不气。", "en": "I am not cross at all."},
        {"zh": "只是退了两步。", "en": "Just two steps back."},
        {"zh": "然后又开始理羽。", "en": "Then I start preening again."},
        {"zh": "你就站在那儿。", "en": "You just stand there."},
        {"zh": "我又抬头看你一眼。", "en": "I glance up at you once more."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们张开冠，沿着崖边走。", "en": "We raise our crests and pace along the cliff edge."},
        {"zh": "翼都张开了。", "en": "Both our wings are open."},
        {"zh": "我们的冠对着冠。", "en": "Our crests face."},
        {"zh": "她的翼比我宽一点。", "en": "Her wings are a little wider."},
        {"zh": "我把头俯下去。", "en": "I bow my head."},
        {"zh": "她也低下头。", "en": "She lowers hers."},
        {"zh": "我们在崖边筑巢。", "en": "We nest on a cliff edge."},
        {"zh": "用枝和草垫着。", "en": "Lined with twigs and grass."},
        {"zh": "蛋会暖很久。", "en": "The eggs will be warm a long time."},
        {"zh": "我在这儿守着。", "en": "I keep watch here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用喙尖挑起那点东西。", "en": "I scoop the morsel up with the tip of my beak."},
        {"zh": "它轻得没分量。", "en": "It has almost no weight."},
        {"zh": "喙里的东西沉得我低头。", "en": "The thing in my beak is heavy enough to pull my head down."},
        {"zh": "它滑落下去。", "en": "It slips away downward."},
        {"zh": "我又捡起来。", "en": "I pick it up again."},
        {"zh": "这次夹得紧。", "en": "Tighter this time."},
        {"zh": "我带它回枝上。", "en": "I carry it back to the branch."},
        {"zh": "我放进巢里。", "en": "I put it in the nest."},
        {"zh": "那是垫草用的。", "en": "It is for lining."},
        {"zh": "我理了理垫草。", "en": "I tidy the lining."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "树上有东西在动。", "en": "Something moves in the tree."},
        {"zh": "脖子一伸，我的视线锁死了。", "en": "My neck shoots out and my gaze locks on."},
        {"zh": "喙已经张开了。", "en": "My beak is already open."},
        {"zh": "我的冠立起来。", "en": "My crest rises."},
        {"zh": "翅膀松了一点。", "en": "My wings loosen."},
        {"zh": "后腿已经绷紧，我要起了。", "en": "My hind legs are coiled; I am about to launch."},
        {"zh": "它在我的爪下拼命扑腾。", "en": "It flails desperately under my claws."},
        {"zh": "我把翼收拢，算准了落点。", "en": "I fold my wings and pick my landing spot."},
        {"zh": "翼一张，我朝它扑了下去。", "en": "Wings open, I dive at it."},
        {"zh": "我蹬地起跳。", "en": "I spring off the ground."},
        {"zh": "翼带起一阵风。", "en": "My wings throw a gust."},
        {"zh": "树叶全响了。", "en": "Every leaf rustles."},
        {"zh": "尾巴在前面摆。", "en": "My tail flicks ahead."},
        {"zh": "我调整了翼的角度。", "en": "I adjust my wing angle."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在它上面绕。", "en": "I circle above it."},
        {"zh": "翼不怎么动就能滑。", "en": "I can glide with barely a beat."},
        {"zh": "它往左边跑。", "en": "It runs left."},
        {"zh": "我一个转身就超过它。", "en": "One turn and I have overshot it."},
        {"zh": "它抬头看上来。", "en": "It looks up."},
        {"zh": "我绕到它背后，翼不出声。", "en": "I slip behind it without a sound from my wings."},
        {"zh": "它的步子乱了。", "en": "Its steps break rhythm."},
        {"zh": "我从侧面下来。", "en": "I come down from the side."},
        {"zh": "爪子先着地。", "en": "Talons first."},
        {"zh": "它躲到一边。", "en": "It dodges aside."},
        {"zh": "我把长冠压平，准备俯冲。", "en": "I flatten my crest and get ready to dive."},
        {"zh": "我借着上升气流又爬高。", "en": "I ride the updraft a little higher."},
        {"zh": "从上面看得更清楚。", "en": "I see better from above."},
        {"zh": "它跑得越来越没力气了。", "en": "Its running grows weaker by the step."},
        {"zh": "它每绕一圈，我就近一分。", "en": "Every lap it makes, I close in a little more."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑下去，爪先到。", "en": "I dive; talons first."},
        {"zh": "它抬手挡住。", "en": "It raises an arm."},
        {"zh": "我的喙跟着啄。", "en": "My beak follows with a stab."},
        {"zh": "打在它的腕上。", "en": "It lands on its wrist."},
        {"zh": "它缩到后面。", "en": "It shrinks back."},
        {"zh": "我用翼扫了一下。", "en": "I sweep with a wing."},
        {"zh": "扬起一片尘。", "en": "A cloud of dust rises."},
        {"zh": "它什么都看不清。", "en": "It can see nothing."},
        {"zh": "我趁机撞过去。", "en": "I ram through the gap."},
        {"zh": "它被撞倒在地。", "en": "It is knocked down."},
        {"zh": "一啄之后我弹开半步。", "en": "After the peck I spring back half a step."},
        {"zh": "收起翼站着。", "en": "And stand with folded wings."},
        {"zh": "长喙追着它的肩又落下。", "en": "My long beak comes down on its shoulder again."},
        {"zh": "这次打在肩上。", "en": "The shoulder this time."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处滑下来。", "en": "I glide down from above."},
        {"zh": "翼在最后才张开。", "en": "My wings open only at the end."},
        {"zh": "落地的时候几乎没有声音。", "en": "I land almost silently."},
        {"zh": "这是一片空地。", "en": "This is a clearing."},
        {"zh": "我落在枝头，冠在风里抖。", "en": "I land on a branch, my crest shivering in the wind."},
        {"zh": "树上有果子。", "en": "There is fruit in them."},
        {"zh": "树上还有虫子。", "en": "There are insects too."},
        {"zh": "我把翼收起来。", "en": "I fold my wings."},
        {"zh": "我走了两步。", "en": "I take two steps."},
        {"zh": "草又软又厚。", "en": "The grass is soft and deep."},
        {"zh": "我的尖啸从崖顶传下来。", "en": "My shriek rings down from the cliff top."},
        {"zh": "很高，传得很远。", "en": "High-pitched, it carries far."},
        {"zh": "然后我开始理羽。", "en": "Then I start to preen."},
        {"zh": "我在等着风。", "en": "I wait for wind."},
        {"zh": "风来了就走。", "en": "When it comes, I go."},
        {"zh": "不来了就留着。", "en": "If not, I stay."},
        {"zh": "怎么着都行。", "en": "Either way suits me."},
        {"zh": "崖风把我的翼膜吹得鼓起来。", "en": "The cliff wind fills my wing membranes."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到翼膜，边上卷起来。", "en": "Fire catches the membrane; the edge curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落得太快，砸出一个坑。", "en": "I fall too fast and gouge a pit."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我的翼压住了。", "en": "Water pins my wings."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀得翻过去。", "en": "The blast flips me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进我的翼骨。", "en": "It lodges in a wing bone."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我的翅膀僵住。", "en": "A cold stiffens my wings."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我飞不起来了。", "en": "Hungry enough that I cannot fly."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在翼尖，光顺着膜走。", "en": "Lightning strikes a wingtip and light runs the membrane."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有风，我掉进空里。", "en": "No wind; I fall into nothing."}
      ]
    }
  }
}
