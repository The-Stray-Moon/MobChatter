{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "鞘翅张开，嗡嗡响。", "en": "My wing cases open with a hum."},
        {"zh": "草尖擦着我的肚子飞过。", "en": "Grass tips brush my belly as I fly."},
        {"zh": "六条腿收在肚子下。", "en": "Six legs tucked beneath me."},
        {"zh": "我绕着树干转。", "en": "I circle the tree trunk."},
        {"zh": "翅膜振成一片模糊。", "en": "My wing membranes blur into one smear."},
        {"zh": "鞘翅抖了抖。", "en": "Wing cases flutter."},
        {"zh": "黑亮的壳反着光。", "en": "My glossy shell throws light back."},
        {"zh": "我横着飘了一段。", "en": "I drift sideways a while."},
        {"zh": "飞起来有点笨。", "en": "I fly a little clumsily."},
        {"zh": "我悬在花上方。", "en": "Hovering above a flower."},
        {"zh": "我绕过一片叶子。", "en": "I round a leaf."},
        {"zh": "嗡声一高一低。", "en": "The hum rises and falls."},
        {"zh": "我在找地方落下。", "en": "I'm looking for a place to land."},
        {"zh": "我随着气流偏了一下。", "en": "I drifted with the air."},
        {"zh": "甲壳碰着风。", "en": "My shell knocks against the wind."},
        {"zh": "我顺着气流上浮。", "en": "I lift on the air."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在叶面，触角收着。", "en": "I rest on the leaf, antennae folded."},
        {"zh": "翅膀还在轻震。", "en": "My wings still tremble."},
        {"zh": "我用前足擦脸。", "en": "I wipe my face with forelegs."},
        {"zh": "鞘翅合上了一半。", "en": "My wing cases half close."},
        {"zh": "这里有点晒。", "en": "It's a bit too sunny here."},
        {"zh": "我听见很远的嗡声。", "en": "I hear a hum far away."},
        {"zh": "触角碰着叶脉。", "en": "My antennae touch a vein."},
        {"zh": "我的壳上有斑。", "en": "There are spots on my shell."},
        {"zh": "我停了一会儿。", "en": "I rest a while."},
        {"zh": "这地方风小。", "en": "The wind is weak here."},
        {"zh": "我又震了下翅膀。", "en": "I buzz my wings again."},
        {"zh": "有人在下面走。", "en": "Someone walks below."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比树还高。", "en": "You're taller than the trees."},
        {"zh": "别拍我下来。", "en": "Don't swat me down."},
        {"zh": "我只是飞来飞去。", "en": "I only fly about."},
        {"zh": "薄壳一捏就裂，别捏。", "en": "One squeeze splits this thin shell; don't."},
        {"zh": "你的手影罩下来，我悬住了。", "en": "Your hand's shadow falls and I hover still."},
        {"zh": "你脚步震得草在动。", "en": "Your steps move the grass."},
        {"zh": "我从来不叮人。", "en": "I never sting."},
        {"zh": "你手举得太高了。", "en": "Your hand is too high."},
        {"zh": "我落在你肩上了。", "en": "I landed on your shoulder."},
        {"zh": "别动，我要飞了。", "en": "Hold still. I'm taking off."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "鞘翅裂了一道。", "en": "A crack in my wing case."},
        {"zh": "我一头栽到地上，翅还颤。", "en": "I hit the ground, wings still twitching."},
        {"zh": "一条腿折了。", "en": "A leg is bent wrong."},
        {"zh": "嗡嗡声变哑了。", "en": "My hum went hoarse."},
        {"zh": "汁液渗出来。", "en": "Fluid seeps out."},
        {"zh": "壳裂了，但还是能飞。", "en": "The shell is cracked, but I can still fly."},
        {"zh": "只是擦破一点壳。", "en": "Just a scrape on the shell."},
        {"zh": "我落到叶背上。", "en": "I drop to the underside of a leaf."},
        {"zh": "我记住那片影子。", "en": "I remember that shadow."},
        {"zh": "我缩进叶背的阴影里。", "en": "I shrink into the shade under a leaf."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是花蜜吗？", "en": "Is that nectar?"},
        {"zh": "有一点甜味。", "en": "Something sweet."},
        {"zh": "我围着花心打转。", "en": "I circle round the flower's heart."},
        {"zh": "花别晃，我落不稳。", "en": "Hold the flower still; I can't land."},
        {"zh": "我降下去，停在花边上。", "en": "I descend and settle on the petal's edge."},
        {"zh": "把那朵花举近些。", "en": "Hold that flower nearer."},
        {"zh": "花瓣里的甜味飘过来了。", "en": "The sweetness inside the petals drifts over."},
        {"zh": "我要的是花蜜。", "en": "I want the nectar."},
        {"zh": "让我先闻闻。", "en": "Let me smell it first."},
        {"zh": "嗡嗡，我还要。", "en": "Buzz. I want more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我在空中翻了个滚。", "en": "I tumbled through the air."},
        {"zh": "鞘翅磕了一下。", "en": "My wing case took a knock."},
        {"zh": "一撞之下，我打着旋往下掉。", "en": "One hit and I spiral down out of control."},
        {"zh": "六条腿乱抓。", "en": "Six legs grabbing at nothing."},
        {"zh": "你的指头比我整个身子大。", "en": "Your finger is bigger than all of me."},
        {"zh": "我一头栽进草叶里。", "en": "I nose-dive into the grass blades."},
        {"zh": "嗡嗡声乱成一团。", "en": "My hum came apart."},
        {"zh": "我缓了一会儿。", "en": "I took a moment to recover."},
        {"zh": "别拍，会碎的。", "en": "Don't swat. I'd break."},
        {"zh": "鞘翅抖开，我又升上去。", "en": "My elytra flick open and I climb again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在空中绕圈。", "en": "I circle in the air."},
        {"zh": "嗡声就是信号。", "en": "The hum is the signal."},
        {"zh": "先看谁飞得稳。", "en": "Let's see who flies steadier."},
        {"zh": "我不落地太久的。", "en": "I don't stay down long."},
        {"zh": "花那边更合适。", "en": "The flowers are better for that."},
        {"zh": "你太大只了。", "en": "You're far too big."},
        {"zh": "我绕三圈就走。", "en": "Three circles and I'm gone."},
        {"zh": "翅膀要先歇一下。", "en": "My wings need a rest first."},
        {"zh": "你先悬停一下。", "en": "Hover a moment first."},
        {"zh": "我该继续飞了。", "en": "I should fly on."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "六条腿一齐抱住，很沉。", "en": "All six legs grab it; it's heavy."},
        {"zh": "太重了，飞不动。", "en": "Too heavy to fly with."},
        {"zh": "我嗅了一下。", "en": "I sniff it."},
        {"zh": "嚼不动，这不是花蜜。", "en": "Can't chew it; this isn't nectar."},
        {"zh": "从叶子上滚下去了。", "en": "It rolled off the leaf."},
        {"zh": "我抓着飞一小段。", "en": "I carry it a short flight."},
        {"zh": "地上还有一点。", "en": "A little more on the ground."},
        {"zh": "壳上沾了汁。", "en": "Juice on my shell."},
        {"zh": "我丢掉算了。", "en": "I'll just drop it."},
        {"zh": "我丢下它，飞走了。", "en": "I drop it and fly off."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶片那边有东西在动。", "en": "Something moves beyond the leaves."},
        {"zh": "我往上飞高。", "en": "I fly higher."},
        {"zh": "翅膀声变了。", "en": "My wingbeat changed."},
        {"zh": "有东西盯上我了。", "en": "Something has its eye on me."},
        {"zh": "我绕着叶梗找出口。", "en": "I circle the leaf stem for a way out."},
        {"zh": "我绕到树叶后面。", "en": "Behind the leaves."},
        {"zh": "这条路线太窄。", "en": "This route is too narrow."},
        {"zh": "我得飞远些。", "en": "I need more distance."},
        {"zh": "它完全没有动。", "en": "It hasn't moved at all."},
        {"zh": "我先飘开一点。", "en": "I'll drift off first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在高处绕圈。", "en": "I circle up high."},
        {"zh": "它的手抬起来了。", "en": "Its hand came up."},
        {"zh": "我藏在叶影里。", "en": "I hide in leaf shadow."},
        {"zh": "嗡声要小一点。", "en": "I keep the hum low."},
        {"zh": "我再往左偏。", "en": "Drifting left."},
        {"zh": "它没追上来。", "en": "It isn't following."},
        {"zh": "草太高，看不清。", "en": "The grass is too tall to see."},
        {"zh": "我贴着叶背，再绕半圈。", "en": "I hug the underside of the leaf for half a turn more."},
        {"zh": "快没力气了。", "en": "My energy is running low."},
        {"zh": "它往林边去了。", "en": "It went toward the treeline."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞在你的指节上，弹开。", "en": "I strike your knuckle and bounce off."},
        {"zh": "前足抓了一下。", "en": "My forelegs grabbed once."},
        {"zh": "我只会这么叮。", "en": "A nip is all I have."},
        {"zh": "我这点撞击，像挠痒。", "en": "My little bump is barely a tickle."},
        {"zh": "我被弹了开来。", "en": "I bounced off."},
        {"zh": "翅膀被压住。", "en": "My wings are pinned."},
        {"zh": "别抓着我的壳。", "en": "Don't hold my shell."},
        {"zh": "退开，再来一次冲撞。", "en": "Back off, then one more charge."},
        {"zh": "嗡嗡，你给我走开。", "en": "Buzz. Get away."},
        {"zh": "我要飞走了。", "en": "I'm flying off."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草丛里升起嗡嗡声。", "en": "A hum rises from the grass."},
        {"zh": "甲壳一亮，我在半空转个圈。", "en": "My shell flashes and I loop once in the air."},
        {"zh": "壳被阳光照亮。", "en": "Sun brightens my shell."},
        {"zh": "我落到一片叶上。", "en": "I land on a leaf."},
        {"zh": "花丛里有蜜。", "en": "Nectar in the flowers."},
        {"zh": "嗡声绕了两圈。", "en": "My hum circled twice."},
        {"zh": "风把我送过来。", "en": "The wind brought me here."},
        {"zh": "我从树干上起飞。", "en": "I lift off from the trunk."},
        {"zh": "翅膀还湿着。", "en": "My wings are still damp."},
        {"zh": "我停在花旁边。", "en": "I settle beside a flower."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "壳被烤得发白。", "en": "My shell whitened in the heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我在地上翻了好几下。", "en": "I tumbled across the ground."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水滴把我压住。", "en": "A drop of water pinned me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹远了。", "en": "The blast blew me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根细刺穿过来。", "en": "A thin spike came through."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光扎得我翅膀停了一下。", "en": "The light stopped my wings."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "飞起来发晃。", "en": "My flight wavers."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声把我震得直转。", "en": "The thunder spun me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在往下飘。", "en": "I keep drifting down."}
      ]
    }
  }
}
