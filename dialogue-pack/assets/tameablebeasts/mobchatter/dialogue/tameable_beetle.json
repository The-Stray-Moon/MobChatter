{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从红树林的根间飞过去。", "en": "I fly between the mangrove roots."},
        {"zh": "我的甲壳是亮色的。", "en": "My shell is bright."},
        {"zh": "我落在根上，走了两步。", "en": "I land on a root and take two steps."},
        {"zh": "六只脚抓得很稳。", "en": "Six feet find good holds."},
        {"zh": "我振翅又离了枝。", "en": "I take off again."},
        {"zh": "翅膀在甲壳下面响。", "en": "My wings buzz beneath the shell."},
        {"zh": "我绕过一片水面。", "en": "I go around a stretch of water."},
        {"zh": "水面上有我的影子。", "en": "My shadow crosses the water."},
        {"zh": "我飞得并不高。", "en": "I do not fly high."},
        {"zh": "树根挡住了上面。", "en": "The roots close the way above."},
        {"zh": "我沿着红树的树皮爬。", "en": "I crawl along the mangrove bark."},
        {"zh": "落在一段露出的根上。", "en": "And settle on a bare root."},
        {"zh": "触角动了动，闻到蜜脾。", "en": "Antennae twitch, I smell honeycomb."},
        {"zh": "前面有一点甜味。", "en": "Something sweet ahead."},
        {"zh": "我朝着那边走。", "en": "I go toward it."},
        {"zh": "一步一步，很慢。", "en": "Step by step, slowly."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在根上，甲壳反着光。", "en": "I rest on a root, shell catching light."},
        {"zh": "泥水在下面慢慢流。", "en": "Muddy water moves slowly below."},
        {"zh": "我的触角一直在探。", "en": "My antennae never stop probing."},
        {"zh": "这里有蜜的味道。", "en": "There is a smell of honey here."},
        {"zh": "我顺着味道转了个方向。", "en": "I turn along the scent."},
        {"zh": "泥里有一只蟹。", "en": "A crab in the mud."},
        {"zh": "它比我还要大。", "en": "Bigger than I am."},
        {"zh": "我伏着不去动。", "en": "I lie without moving."},
        {"zh": "红树林的蜜脾，我最爱。", "en": "Mangrove honeycomb is my favorite."},
        {"zh": "我的鞘翅在阳光下发亮。", "en": "My wing case shines in the sun."},
        {"zh": "晒了一会儿，又收起来。", "en": "Sun a while, then fold them."},
        {"zh": "甲壳有点发热。", "en": "My shell is warm."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在根上，我看见了。", "en": "You stand on the roots. I see you."},
        {"zh": "我落在一段远一点的根上。", "en": "I land on a root further off."},
        {"zh": "我的甲壳比你的指甲大一点。", "en": "My shell is a little bigger than your nail."},
        {"zh": "红树林的甲虫，翅是亮的。", "en": "A mangrove beetle with shiny wings."},
        {"zh": "我也正看着你。", "en": "I am looking at you as well."},
        {"zh": "你伸手，我飞了。", "en": "You reach; I fly."},
        {"zh": "落在两三步外。", "en": "I settle two or three steps away."},
        {"zh": "你没有追过来。", "en": "You did not follow."},
        {"zh": "我又慢慢爬回来。", "en": "I slowly crawl back."},
        {"zh": "这次我停在你手边。", "en": "This time I stop by your hand."},
        {"zh": "你手上有甜味。", "en": "There is sweetness on your hand."},
        {"zh": "我伸出触角碰了碰。", "en": "I touch it with an antenna."},
        {"zh": "尝起来很甜。", "en": "Very sweet."},
        {"zh": "我不打算离开。", "en": "I do not mean to leave."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我缩起脚，掉下去。", "en": "I tuck my legs and fall."},
        {"zh": "半路展开翅膀。", "en": "Wings out halfway down."},
        {"zh": "歪歪斜斜地落住。", "en": "I land askew."},
        {"zh": "甲壳上有一道裂缝。", "en": "A crack runs across my shell."},
        {"zh": "我试着收拢甲壳。", "en": "I try to fold up."},
        {"zh": "收得不太顺。", "en": "Not smoothly."},
        {"zh": "可还能动弹。", "en": "But I can move."},
        {"zh": "我爬到根的背面。", "en": "I crawl to the far side of the root."},
        {"zh": "我就藏在那儿。", "en": "And hide there."},
        {"zh": "我的翅膀抖得厉害。", "en": "My wings are trembling badly."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是甜甜的蜜。", "en": "That is honey."},
        {"zh": "我从根上飞下来。", "en": "I fly down from the root."},
        {"zh": "我落在你手边。", "en": "I settle by your hand."},
        {"zh": "触角先伸过去碰。", "en": "An antenna reaches first."},
        {"zh": "然后我才低头。", "en": "Then I lower my head."},
        {"zh": "甜得有些发腻。", "en": "Sweet enough to cloy."},
        {"zh": "红树林的甲虫，蜜脾就能驯。", "en": "A mangrove beetle tamed with a honeycomb."},
        {"zh": "翅膀轻轻地抖。", "en": "My wings quiver."},
        {"zh": "吃完了我抬起头。", "en": "When it is gone I lift my head."},
        {"zh": "你手里还有。", "en": "You have more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的手指碰到我的壳。", "en": "Your finger touches my shell."},
        {"zh": "我缩起脚，掉了下去。", "en": "I tuck my legs and drop."},
        {"zh": "在半空展开翅膀。", "en": "Wings open in the air."},
        {"zh": "我的六条腿抓紧树皮。", "en": "My six legs grip the bark."},
        {"zh": "我落在你脚边的泥上。", "en": "I land on the mud by your foot."},
        {"zh": "泥溅到我的壳上。", "en": "Mud splashes my shell."},
        {"zh": "我的硬壳撞出闷响。", "en": "My shell hits with a dull thud."},
        {"zh": "然后我又飞起来。", "en": "And rise again."},
        {"zh": "这次落在高一点的根上。", "en": "This time on a higher root."},
        {"zh": "离你更远了一点。", "en": "A little further from you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "根的深处还有一只。", "en": "There is another deep in the roots."},
        {"zh": "我在它上方绕了一圈。", "en": "I circle once above it."},
        {"zh": "红树林里，触角碰了碰。", "en": "In the mangroves, our antennae touch."},
        {"zh": "我的触角碰了碰它的。", "en": "My antennae tap against its own."},
        {"zh": "我们一起落在一段根上。", "en": "We settle on the same root."},
        {"zh": "甲壳挨着甲壳。", "en": "Shell against shell."},
        {"zh": "泥水在下面流。", "en": "Mud water moves below."},
        {"zh": "我们一起晒了很久。", "en": "We sun ourselves a long while."},
        {"zh": "然后各自飞走。", "en": "Then each flies off."},
        {"zh": "根里还有别的地方。", "en": "There are other places in the roots."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前脚抱住它，甲壳亮得发热。", "en": "I hug it with my forelegs; my shell glows warm."},
        {"zh": "太重，飞不起来。", "en": "Too heavy to fly with."},
        {"zh": "我用前足抱着它飞。", "en": "I carry it in my front legs and fly."},
        {"zh": "然后我就放下。", "en": "Then let go."},
        {"zh": "这块木头太重了。", "en": "This chunk of wood is too heavy."},
        {"zh": "我用触角又试了试。", "en": "I test it with an antenna."},
        {"zh": "有一点甜味道。", "en": "A little sweet."},
        {"zh": "可还不太够。", "en": "Not enough."},
        {"zh": "我又飞走了。", "en": "I fly off."},
        {"zh": "根上还有别的。", "en": "There is more on the roots."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那片蜜脾还滴着蜜。", "en": "That honeycomb is still dripping."},
        {"zh": "我换了个朝向。", "en": "I change my heading."},
        {"zh": "翅膀开始动了。", "en": "My wings begin to move."},
        {"zh": "我飞起来，很低。", "en": "I lift off, very low."},
        {"zh": "从根下穿过去。", "en": "I pass under the roots."},
        {"zh": "味道越来越浓。", "en": "The smell thickens."},
        {"zh": "花瓣被我压得往下弯。", "en": "The petal bends under my weight."},
        {"zh": "花瓣非常软。", "en": "The petals are soft."},
        {"zh": "红树林的蜜脾，把我驯得服服帖帖。", "en": "Mangrove honeycomb tamed me completely."},
        {"zh": "花蜜甜得发腻。", "en": "The nectar is cloying."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在一段根上。", "en": "I stop on a root."},
        {"zh": "那个东西在往这边来。", "en": "It is coming this way."},
        {"zh": "我的触角缩了一下。", "en": "My antennae draw in."},
        {"zh": "甲壳紧贴着根。", "en": "My shell presses to the root."},
        {"zh": "我不太显眼。", "en": "I am not conspicuous."},
        {"zh": "它从旁边走过去。", "en": "It passes."},
        {"zh": "我把鞘翅松开。", "en": "I loosen my wing cases."},
        {"zh": "我贴在根上，一动不动。", "en": "I press against the root and keep still."},
        {"zh": "它又走回来。", "en": "It comes back."},
        {"zh": "我立刻收拢起来。", "en": "I fold up at once."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞过去，用甲壳顶。", "en": "I ram it with my shell."},
        {"zh": "那点力气很小。", "en": "The force is small."},
        {"zh": "它被吓了一跳。", "en": "It is startled."},
        {"zh": "我用鞘翅把它顶开。", "en": "I shove it back with my wing case."},
        {"zh": "我趁这个空飞走。", "en": "I take the chance and fly."},
        {"zh": "落在它的影子外面。", "en": "I land beyond its shadow."},
        {"zh": "翅膀还在响着。", "en": "My wings still buzz."},
        {"zh": "我在根上落定。", "en": "I settle."},
        {"zh": "我撞得它翻了个身。", "en": "I knock it onto its back."},
        {"zh": "我撞过去，是拿甲壳顶的。", "en": "I charge with my shell foremost."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从根下的泥里爬出来。", "en": "I climb out of the mud beneath the roots."},
        {"zh": "甲壳上还沾着水。", "en": "Water still clings to my shell."},
        {"zh": "这里的根很高。", "en": "The roots here are tall."},
        {"zh": "我在红树林的根间落下来，走了两步。", "en": "I settle among the mangrove roots and take two steps."},
        {"zh": "红树林的味道是咸的。", "en": "The mangrove smells of salt."},
        {"zh": "我展开翅膀，先试了试。", "en": "I open my wings and test them."},
        {"zh": "这副翅能飞。", "en": "They work."},
        {"zh": "我升到根与根之间。", "en": "I rise between root and root."},
        {"zh": "有一朵花在那边。", "en": "There is a flower over there."},
        {"zh": "我朝那朵花去了。", "en": "I head for it."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，我的甲壳就发烫，我掉进水里。", "en": "The heat makes my shell burn and I drop into the water."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落到硬泥上，甲壳磕出了声。", "en": "I fall onto hard mud and my shell knocks."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水淹住我，我在泥里乱蹬。", "en": "Water covers me and I kick wildly in the mud."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹出去，撞在根上。", "en": "The blast throws me into a root."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭擦过我的甲壳，削掉一块。", "en": "An arrow grazes my shell and chips it."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光罩住我，翅膀动不了。", "en": "Strange light wraps me and my wings will not move."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "好久没喝到蜜，我飞得越来越低。", "en": "No honey for a long while, and I fly lower."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "我甲壳上的光，灭了一下。", "en": "The shine on my shell flickered out."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "根没有了，我在黑里翻着往下掉。", "en": "The roots are gone and I tumble through black."}
      ]
    }
  }
}
