{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "六条腿踩着红树林的软泥。", "en": "Six legs press the mangrove's soft mud."},
        {"zh": "壳很厚，走起来有点笨。", "en": "My shell is thick; I move a little clumsily."},
        {"zh": "我从气根之间挤过去。", "en": "I squeeze between the prop roots."},
        {"zh": "泥水被我踩得咕叽响。", "en": "The mud squelches under me."},
        {"zh": "我的背甲上有一层光。", "en": "A sheen lies on my back plate."},
        {"zh": "很硬，刀都难破。", "en": "So hard a blade would struggle."},
        {"zh": "我绕过一滩水。", "en": "I go around a pool."},
        {"zh": "又回头爬回来。", "en": "Then climb back."},
        {"zh": "好像有什么味道。", "en": "There was a smell."},
        {"zh": "我沿着树根往上爬。", "en": "I climb along a root."},
        {"zh": "爪子钩住树皮。", "en": "My claws hook the bark."},
        {"zh": "爬了很久才到上面。", "en": "It takes a long while to reach the top."},
        {"zh": "在高处停了停。", "en": "I pause up there."},
        {"zh": "我又爬下来。", "en": "I climb back down."},
        {"zh": "我不太会飞。", "en": "I am not much of a flier."},
        {"zh": "可我爬得上去。", "en": "But I can climb."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴在树根上不动。", "en": "I lie still on a root."},
        {"zh": "壳在光下是很深的颜色。", "en": "My shell is a deep colour in the light."},
        {"zh": "有一滴泥水从边上滑。", "en": "A drop of muddy water slides off the edge."},
        {"zh": "落在下面的叶子上。", "en": "It lands on a leaf below."},
        {"zh": "我抬起带刺的腿，慢慢放下。", "en": "I lift a spiny leg and set it down slowly."},
        {"zh": "我把脚放回去。", "en": "I set the leg back down."},
        {"zh": "闷得能拧出水。", "en": "Damp enough to wring out."},
        {"zh": "正合我的意。", "en": "Just to my liking."},
        {"zh": "我用口器刮了刮树皮。", "en": "I scrape the bark with my mouthparts."},
        {"zh": "刮下一点东西。", "en": "A little comes away."},
        {"zh": "我把它吃了。", "en": "I eat it."},
        {"zh": "然后继续趴着。", "en": "Then lie still again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树根上抬起头。", "en": "I raise my head from the root."},
        {"zh": "你站在泥里。", "en": "You stand in the mud."},
        {"zh": "你的靴子已经陷了。", "en": "Your boots are already sinking."},
        {"zh": "我慢慢爬下来。", "en": "I climb down slowly."},
        {"zh": "停在你旁边。", "en": "And stop beside you."},
        {"zh": "我垂下触角，表示不想打。", "en": "I lower my antennae to show I mean no fight."},
        {"zh": "你把手伸出来。", "en": "You reach a hand out."},
        {"zh": "我把硬壳脑袋低到你脚边。", "en": "I lower my armored head to your feet."},
        {"zh": "让你碰到我的壳。", "en": "Letting you touch my shell."},
        {"zh": "我的甲壳冰凉。", "en": "My shell is cold."},
        {"zh": "你摸了两下。", "en": "You stroke it twice."},
        {"zh": "我一点也没躲。", "en": "I do not pull away."},
        {"zh": "这不太常见。", "en": "That is not common."},
        {"zh": "你别胡乱动弹。", "en": "Do not fidget about."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳上多了一道白印。", "en": "A white mark appears on my shell."},
        {"zh": "我缩了缩腿。", "en": "I draw my legs in."},
        {"zh": "很硬，但也会疼。", "en": "Hard, but it still hurts."},
        {"zh": "我从根上滑了一点。", "en": "I slip a little on the root."},
        {"zh": "我总算稳住。", "en": "I steady at last."},
        {"zh": "泥里有我的血。", "en": "My blood is in the mud."},
        {"zh": "我顺着根往后退。", "en": "I back away along the root."},
        {"zh": "甲壳还完好。", "en": "The shell is intact."},
        {"zh": "我缩起腿，壳缝里渗出血。", "en": "I pull in my legs as blood seeps between my plates."},
        {"zh": "我不再挪动了。", "en": "I move no more."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有一股甜味。", "en": "A sweet smell."},
        {"zh": "那是一罐蜂蜜。", "en": "That is a jar of honey."},
        {"zh": "我从树上下来。", "en": "I come down from the tree."},
        {"zh": "我爬得很急。", "en": "I crawl over quickly."},
        {"zh": "我停在它前面。", "en": "I stop in front of it."},
        {"zh": "先用触角碰了碰。", "en": "I touch it with an antenna first."},
        {"zh": "然后才低下头。", "en": "Then lower my head."},
        {"zh": "我嚼着蜜脾，触角轻轻晃。", "en": "I chew the honeycomb, antennae swaying."},
        {"zh": "甜味在口器里化开。", "en": "The sweetness spreads in my mouthparts."},
        {"zh": "我又舔了一口。", "en": "I lick once more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的背甲。", "en": "You step on my back plate."},
        {"zh": "我的甲壳挨了一下，纹丝不动。", "en": "My shell takes the blow without shifting an inch."},
        {"zh": "倒是你的脚滑了一下。", "en": "It is your foot that slips."},
        {"zh": "你扶住了树根。", "en": "You catch a root."},
        {"zh": "我掉转笨重的身子爬开。", "en": "I turn my heavy body and crawl away."},
        {"zh": "壳上多了一个鞋印。", "en": "A boot print marks my shell."},
        {"zh": "背上的泥块怎么抖都不掉。", "en": "The clump of mud on my back will not shake off."},
        {"zh": "那也就随它去。", "en": "Let it be, then."},
        {"zh": "我接着往树上爬。", "en": "I climb on up the tree."},
        {"zh": "泥从壳上滑下去。", "en": "Mud slides off my shell."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在树干上遇到。", "en": "We meet on a trunk."},
        {"zh": "触角碰了碰。", "en": "Our antennae touch."},
        {"zh": "然后一起往下爬。", "en": "Then we climb down together."},
        {"zh": "泥里有我们的痕。", "en": "Our tracks are in the mud."},
        {"zh": "两只甲虫并排爬过泥滩。", "en": "Two beetles crawl side by side across the mudflat."},
        {"zh": "两只壳碰着壳。", "en": "Shell against shell."},
        {"zh": "发出很闷的响。", "en": "A dull sound."},
        {"zh": "红树的根下，我守着她。", "en": "Beneath the mangrove roots, I keep watch over her."},
        {"zh": "根很多，藏得住。", "en": "Plenty of roots to hide in."},
        {"zh": "我们慢慢挨近，触角相碰。", "en": "We close the distance slowly until our antennae touch."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的前腿箍住它，甲壳咔响。", "en": "My forelegs clamp around it, and my shell creaks."},
        {"zh": "这重量压得我的关节发紧。", "en": "The weight makes my joints creak."},
        {"zh": "我拖了两步。", "en": "I drag it two steps."},
        {"zh": "我松开前腿，让它滚进泥里。", "en": "I let go and it rolls into the mud."},
        {"zh": "这个用得上。", "en": "This one will serve."},
        {"zh": "我把它推到树根间。", "en": "I push it among the roots."},
        {"zh": "我把它塞进腐叶底下藏好。", "en": "I tuck it away under the rotting leaves."},
        {"zh": "以后我再来。", "en": "I will come back."},
        {"zh": "我慢慢爬走。", "en": "I crawl away."},
        {"zh": "没有回头看。", "en": "Without looking back."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "腐叶下传来细碎的响动。", "en": "A faint rustle comes from under the rotting leaves."},
        {"zh": "我昂起头来看。", "en": "I raise my head to look."},
        {"zh": "壳边缘绷紧了。", "en": "My shell's edge tightens."},
        {"zh": "我把腿收起一半。", "en": "I draw half my legs in."},
        {"zh": "那并不是同族。", "en": "That is not kin."},
        {"zh": "我沿着树根一点点逼近。", "en": "I creep closer along the roots, inch by inch."},
        {"zh": "泥被我压出一道沟。", "en": "Mud furrows under me."},
        {"zh": "我停在它面前。", "en": "I stop before it."},
        {"zh": "我没有攻击。", "en": "I do not attack."},
        {"zh": "我只是挡着。", "en": "I only block the way."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它想绕过我。", "en": "It tries to go around me."},
        {"zh": "我横过身体。", "en": "I set my body across."},
        {"zh": "壳把它挡住了。", "en": "My shell blocks it."},
        {"zh": "它开始推我。", "en": "It starts pushing me."},
        {"zh": "我贴着树根不动。", "en": "I hold fast against the root."},
        {"zh": "我的腿扎进泥里。", "en": "My legs dig into the mud."},
        {"zh": "它又推了一下。", "en": "It pushes again."},
        {"zh": "我还是一动不动。", "en": "I still do not move."},
        {"zh": "它乱撞起来，我稳住甲壳。", "en": "It starts thrashing; I brace my shell."},
        {"zh": "我只是趴着。", "en": "I simply lie there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿背甲撞它。", "en": "I ram with my back plate."},
        {"zh": "很硬的一下。", "en": "A hard knock."},
        {"zh": "它被撞得后退。", "en": "It is knocked back."},
        {"zh": "我抬起前腿推。", "en": "I push with my forelegs."},
        {"zh": "它被推得往后。", "en": "It is shoved back."},
        {"zh": "我再拿壳顶。", "en": "I butt with my shell again."},
        {"zh": "这次撞在膝盖上。", "en": "The knee this time."},
        {"zh": "它往下跌坐。", "en": "It drops to its knees."},
        {"zh": "我不再挪动。", "en": "I move no further."},
        {"zh": "我只看不动。", "en": "I only watch."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "红树林的泥里鼓起一块。", "en": "A mound rises in the mangrove mud."},
        {"zh": "我从中爬出来。", "en": "I crawl out of it."},
        {"zh": "壳上还带着湿泥。", "en": "Wet mud still coats my shell."},
        {"zh": "我抖落背上的泥。", "en": "I shake the mud off my back."},
        {"zh": "泥掉了一半。", "en": "Half of it falls."},
        {"zh": "四周都是气根。", "en": "Prop roots everywhere."},
        {"zh": "水在下面响。", "en": "Water sounds below."},
        {"zh": "我朝最近的根爬。", "en": "I crawl to the nearest root."},
        {"zh": "我的爪子钩住了。", "en": "My claws catch hold."},
        {"zh": "一点一点往上。", "en": "Up, bit by bit."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤了我的壳，边上发黑。", "en": "Fire roasts my shell; the rim blackens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上掉下去，砸进泥里。", "en": "I fall from the tree into the mud."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "泥水灌进口器，我蹬腿。", "en": "Muddy water fills my mouthparts; I kick."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀到树根外。", "en": "The blast throws me clear of the roots."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西从我甲上滑开。", "en": "It slides off my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我腿都慢了。", "en": "A cold slows all my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我啃干树皮。", "en": "Hungry enough to gnaw dry bark."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我的壳在响。", "en": "Lightning strikes; my shell rings."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有根可以抓。", "en": "No root to grip."}
      ]
    }
  }
}
