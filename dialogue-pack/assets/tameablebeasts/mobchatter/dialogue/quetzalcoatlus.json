{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在丘陵的坡上踱步。", "en": "I pace the hillside."},
        {"zh": "翼收在身体两侧。", "en": "My wings are folded at my sides."},
        {"zh": "站起来比树还高。", "en": "Standing, I am taller than the trees."},
        {"zh": "长脖子探出去。", "en": "My long neck reaches out."},
        {"zh": "喙像一根矛。", "en": "My beak is like a spear."},
        {"zh": "我一步一步踩着石头。", "en": "I step from stone to stone."},
        {"zh": "坡很陡，我不在乎。", "en": "The slope is steep; I do not mind."},
        {"zh": "我走到崖边。", "en": "I walk to the cliff edge."},
        {"zh": "往下看了看。", "en": "And look down."},
        {"zh": "风从下面上来。", "en": "Wind comes up from below."},
        {"zh": "我把双翼张开。", "en": "I spread both wings."},
        {"zh": "只用两步就离地了。", "en": "Two steps and I am off the ground."},
        {"zh": "翼尖擦过低矮的灌木。", "en": "My wingtip grazes the low shrubs."},
        {"zh": "我在坡上留下很大的脚印。", "en": "My prints on the slope are large."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在丘顶，翼半张着。", "en": "I stand on the hilltop, wings half open."},
        {"zh": "风穿过翼骨。", "en": "Wind passes through the wing bones."},
        {"zh": "山风里传来我低沉的鸣叫。", "en": "My low call comes back on the mountain wind."},
        {"zh": "我把脖子慢慢转过去。", "en": "I turn my neck slowly."},
        {"zh": "下面有一片林子。", "en": "There is a forest below."},
        {"zh": "再远一点是河。", "en": "Beyond it, a river."},
        {"zh": "地面上的动静，我全看在眼里。", "en": "Every movement on the ground is in my sight."},
        {"zh": "我提起一只脚。", "en": "I lift one foot."},
        {"zh": "再落回地上。", "en": "Then back to the ground."},
        {"zh": "翼尖垂到地上。", "en": "My wingtip touches the ground."},
        {"zh": "我把它抬起来。", "en": "I lift it."},
        {"zh": "等风再大一点。", "en": "Waiting for the wind to strengthen."},
        {"zh": "下面有一只小兽跑过。", "en": "A small beast runs below."},
        {"zh": "我站定不动。", "en": "I stand still."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我把长颈弯下来，凑到你面前。", "en": "I bend my long neck down and bring my head to your level."},
        {"zh": "你抬着头看我。", "en": "You look up at me."},
        {"zh": "我比你高很多。", "en": "I stand well above you."},
        {"zh": "我把头放到和你齐平。", "en": "I bring my head level with yours."},
        {"zh": "你看上去很紧张。", "en": "You look tense."},
        {"zh": "我收着喙，没打算碰你。", "en": "I keep my beak drawn back, meaning not to touch you."},
        {"zh": "我低下巨大的头，只想看看。", "en": "I lower my huge head, only wanting a look."},
        {"zh": "你的手掌停在我的颈侧。", "en": "Your palm comes to rest against my neck."},
        {"zh": "我让它碰到我的喙。", "en": "I let it touch my beak."},
        {"zh": "只是轻轻一触。", "en": "Only the lightest touch."},
        {"zh": "我合上眼，让你摸我的喙。", "en": "I close my eyes and let you touch my beak."},
        {"zh": "我又把眼睁开。", "en": "I open my eyes again."},
        {"zh": "风已经起来了。", "en": "The wind is up."},
        {"zh": "我得走开了。", "en": "I have to go."},
        {"zh": "我退开两尺。", "en": "I back off two paces."},
        {"zh": "我展开双翼，影子盖住你。", "en": "I spread my wings and my shadow covers you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫了一声，脖子缩回。", "en": "I cry out and pull my neck back."},
        {"zh": "我的一只翼歪了。", "en": "One wing hangs wrong."},
        {"zh": "我摔进草里，翼膜压在身下。", "en": "I crash into the grass with a wing membrane pinned under me."},
        {"zh": "站得很吃力。", "en": "Standing is hard."},
        {"zh": "血落在草上。", "en": "Blood falls on the grass."},
        {"zh": "我用喙碰伤口。", "en": "I touch the wound with my beak."},
        {"zh": "疼得钻心刺骨。", "en": "The pain is piercing."},
        {"zh": "我慢慢把翼收起来。", "en": "I slowly fold the wing."},
        {"zh": "现在只能走了。", "en": "Now I can only walk."},
        {"zh": "我的翼折着，只能贴地站着。", "en": "My wing is bent; I can only stand pressed to the ground."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我瞥了一眼，那不是我吃的。", "en": "I glance at it; that is not my food."},
        {"zh": "但我会吃腐肉。", "en": "But I do eat carrion."},
        {"zh": "腐肉落地的声音引我低头。", "en": "The slap of carrion hitting the ground draws my head down."},
        {"zh": "我落了下来。", "en": "I come down."},
        {"zh": "低头咬了一口。", "en": "I lower my head and bite."},
        {"zh": "这东西很老了。", "en": "It is very old."},
        {"zh": "老得刚刚好。", "en": "Old, and just right."},
        {"zh": "我一整块吞下去。", "en": "I swallow it whole."},
        {"zh": "地上还有味。", "en": "The smell stays on the ground."},
        {"zh": "我又低头舔了舔。", "en": "I lick at it again."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的肩撞上我柱子般的腿。", "en": "Your shoulder slams into my pillar-like leg."},
        {"zh": "这点碰撞连我的羽毛都没动。", "en": "The bump does not even ruffle my feathers."},
        {"zh": "我俯下长颈。", "en": "I lower my long neck."},
        {"zh": "你退开半步。", "en": "You give half a step."},
        {"zh": "我慢慢把腿挪开。", "en": "I move my leg aside."},
        {"zh": "地上的草被踩倒。", "en": "The grass is flattened."},
        {"zh": "我挪了一步。", "en": "I shift one step."},
        {"zh": "给你让开一点。", "en": "To give you room."},
        {"zh": "风把我的翼吹得响。", "en": "Wind rattles my wings."},
        {"zh": "你看着那对翼。", "en": "You look at those wings."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在空中绕圈。", "en": "We circle in the air."},
        {"zh": "翼几乎碰到。", "en": "Our wings nearly touch."},
        {"zh": "然后一起升高。", "en": "Then we climb together."},
        {"zh": "云在我们下面。", "en": "The clouds are below us."},
        {"zh": "巢筑在崖顶。", "en": "The nest is on a cliff top."},
        {"zh": "很大，用枝和骨。", "en": "Large, of branches and bone."},
        {"zh": "窝里有两颗蛋。", "en": "There are two eggs."},
        {"zh": "巢里的蛋由我们交替暖着。", "en": "We take turns warming the egg in the nest."},
        {"zh": "另一个去捕食。", "en": "The other hunts."},
        {"zh": "回来的时候带着东西。", "en": "Returning with something."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "长颈一探，我把它衔离地面。", "en": "My long neck dips and I lift it off the ground."},
        {"zh": "叼起它时，我的长颈一沉。", "en": "My long neck dips when I lift it; it is heavier than it looks."},
        {"zh": "我叼不住，就先踩在爪下。", "en": "If my beak can't hold it, I pin it under a talon."},
        {"zh": "它咽不下去。", "en": "It will not go down."},
        {"zh": "我把它搁下。", "en": "I set it down."},
        {"zh": "这个带得动。", "en": "This one I can carry."},
        {"zh": "我带着它起飞。", "en": "I take off with it."},
        {"zh": "我飞得非常高。", "en": "I climb very high."},
        {"zh": "然后我松开爪。", "en": "Then I open my talons."},
        {"zh": "它砸进草里。", "en": "It crashes into the grass."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "下面的坡上有东西。", "en": "Something is on the slope below."},
        {"zh": "我在高处俯视，把你圈进眼里。", "en": "From high above I look down and frame you in my sight."},
        {"zh": "我把双翼撑开。", "en": "I spread both wings."},
        {"zh": "一股上升气流托住我的双翼。", "en": "An updraft catches both my wings."},
        {"zh": "我朝下缓滑。", "en": "I glide down."},
        {"zh": "一点声音都没有。", "en": "Without a sound."},
        {"zh": "它还在走着。", "en": "It is still walking."},
        {"zh": "我绕它一圈。", "en": "I circle it once."},
        {"zh": "影子掠过它的头。", "en": "My shadow crosses its head."},
        {"zh": "它抬起长颈。", "en": "It raises its long neck."},
        {"zh": "我已在它背后。", "en": "I am behind it now."},
        {"zh": "我一头扎下来。", "en": "I plunge straight down."},
        {"zh": "脚下几乎没有重量。", "en": "Hardly any weight in my feet."},
        {"zh": "它还没转身。", "en": "It has not turned."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在它头顶慢慢画着圈。", "en": "I trace slow circles above its head."},
        {"zh": "羽毛一点声都不出。", "en": "Not a feather makes a sound."},
        {"zh": "它走快了一点。", "en": "It walks a little faster."},
        {"zh": "我也升高一点。", "en": "I rise a little too."},
        {"zh": "它跑起来了。", "en": "It breaks into a run."},
        {"zh": "我从侧面插进去。", "en": "I cut in from the side."},
        {"zh": "长脖子先到。", "en": "My long neck arrives first."},
        {"zh": "喙对着它的背。", "en": "The beak points at its back."},
        {"zh": "它回身一转。", "en": "It wheels about."},
        {"zh": "我抽身退开。", "en": "I pull away."},
        {"zh": "飞回到高处。", "en": "And rise to the height again."},
        {"zh": "我又降下来。", "en": "I come down again."},
        {"zh": "它已经没有方向了。", "en": "It has lost its direction."},
        {"zh": "滑翔的角度只剩最后一次修正。", "en": "One last correction to my glide angle is all I get."},
        {"zh": "我一头扎下去。", "en": "I plunge straight down."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的喙刺下去。", "en": "My beak drives down."},
        {"zh": "就像一根长矛。", "en": "Like a long spear."},
        {"zh": "它被钉在地上。", "en": "It is pinned to the ground."},
        {"zh": "我用翼扫开它。", "en": "I sweep it aside with a wing."},
        {"zh": "风从翼下穿过，把我托了起来。", "en": "The wind rushes under my wings and lifts me."},
        {"zh": "我又落下去。", "en": "I come down again."},
        {"zh": "脚尖先着地。", "en": "Talons first."},
        {"zh": "我的喙把它撞得连退几步。", "en": "My beak knocks it back several steps."},
        {"zh": "我站在那儿。", "en": "I stand there."},
        {"zh": "我的翼一直张着。", "en": "My wings stay spread."},
        {"zh": "脖子慢慢抬起。", "en": "My neck rises slowly."},
        {"zh": "我再用喙顶它。", "en": "I butt it with my beak."},
        {"zh": "它被撞退开去。", "en": "It is driven back."},
        {"zh": "我抬起脚踩下去。", "en": "I raise a foot and stamp."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "影子先落在地上。", "en": "My shadow falls first."},
        {"zh": "然后我下来。", "en": "Then I come down."},
        {"zh": "翼在最后才收。", "en": "My wings fold only at the end."},
        {"zh": "这么大的身子落地却没声响。", "en": "A body this big lands without a sound."},
        {"zh": "这里是丘陵。", "en": "These are the hills."},
        {"zh": "很高，风很大。", "en": "High up, strong wind."},
        {"zh": "我把身体站直。", "en": "I stand up straight."},
        {"zh": "脖子伸到树顶上。", "en": "My neck reaches above the trees."},
        {"zh": "四周的一切都变小了。", "en": "Everything around grows small."},
        {"zh": "我看见河，也看见路。", "en": "I see the river, and the road."},
        {"zh": "路上有个人。", "en": "Someone is on the road."},
        {"zh": "我把庞大的影子挪过山坡。", "en": "I drag my enormous shadow across the hillside."},
        {"zh": "翼还没有收。", "en": "My wings are still open."},
        {"zh": "风吹过翼骨。", "en": "Wind passes through the bones."},
        {"zh": "山脊的风够了，我才展开翼。", "en": "I wait until the ridge wind is strong enough, then spread my wings."},
        {"zh": "然后再起飞。", "en": "Then I will take off."},
        {"zh": "现在先看看。", "en": "For now, I watch."},
        {"zh": "我俯视着这片地。", "en": "I look down over this land."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到翼膜，边上卷了。", "en": "Fire catches the membrane; the edge curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下来，砸在坡上。", "en": "I fall from height onto the slope."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水的阻力让我飞不起来。", "en": "The water's drag keeps me from flying."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的翼掀得翻过去。", "en": "The blast flips my wings."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进翼骨。", "en": "It lodges in a wing bone."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我的翅膀定住。", "en": "A cold locks my wings."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿了太久，我落得很低。", "en": "Too long hungry; I fly low."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷穿过云，我的翼全亮。", "en": "Lightning through the clouds lights my wings."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有风，我无法滑。", "en": "No wind; I cannot glide."}
      ]
    }
  }
}
