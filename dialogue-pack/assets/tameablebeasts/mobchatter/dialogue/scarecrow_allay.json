{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从稻草人身上下来，飘着走。", "en": "I come down off the scarecrow and drift."},
        {"zh": "我的身体是草扎的。", "en": "My body is bound straw."},
        {"zh": "每走一步，草屑就掉。", "en": "Each step sheds chaff."},
        {"zh": "我绕着自己的柱子转。", "en": "I circle my own post."},
        {"zh": "我又回到田边。", "en": "I come back to the field's edge."},
        {"zh": "我飘过刚翻过的田垄。", "en": "I drift over the freshly turned furrows."},
        {"zh": "我飘过一排苗。", "en": "I drift over a row of shoots."},
        {"zh": "它们现在还很小。", "en": "They are still small."},
        {"zh": "我在旁边停了一下。", "en": "I pause beside them."},
        {"zh": "然后继续往前。", "en": "Then move on."},
        {"zh": "我的袖子空空的。", "en": "My sleeves are empty."},
        {"zh": "风一吹就鼓起来。", "en": "A breeze fills them."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立在自己的柱子上。", "en": "I stand on my own post."},
        {"zh": "一只手举着，一只手垂着。", "en": "One arm raised, one hanging."},
        {"zh": "我戴着一顶旧草帽。", "en": "I wear an old straw hat."},
        {"zh": "我在这块田里站了很久。", "en": "I have stood in this field a long while."},
        {"zh": "连鸟都不来了。", "en": "The birds no longer come."},
        {"zh": "这是我的工作。", "en": "That is my work."},
        {"zh": "田里的风穿过我的草身。", "en": "Field wind blows through my straw body."},
        {"zh": "嘴角一直往上。", "en": "The corners of my mouth stay up."},
        {"zh": "我不太确定那是笑。", "en": "I am not sure that is a smile."},
        {"zh": "可看起来倒像。", "en": "But it looks like one."},
        {"zh": "太阳从东边到西边。", "en": "The sun goes east to west."},
        {"zh": "我的草帽歪向一边。", "en": "My straw hat tilts to one side."},
        {"zh": "田里的苗长高了一点。", "en": "The shoots have grown a little."},
        {"zh": "我把这事记下。", "en": "I have noted it."},
        {"zh": "明天还会再长。", "en": "They will grow tomorrow too."},
        {"zh": "我仍旧站在这里。", "en": "I stand as before."},
        {"zh": "草在我身体里响。", "en": "Straw rustles inside me."},
        {"zh": "风从袖子里穿过去。", "en": "The wind passes through my sleeves."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走到田边，我看见了。", "en": "You come to the field's edge. I see you."},
        {"zh": "我从柱子上转过来。", "en": "I turn from my post."},
        {"zh": "我的草帽歪了一点。", "en": "My straw hat is a little askew."},
        {"zh": "我没有手去扶。", "en": "I have no hand to fix it."},
        {"zh": "你也没有伸手。", "en": "You do not reach either."},
        {"zh": "我们就这么看着。", "en": "So we look at each other."},
        {"zh": "你踩到苗了。", "en": "You have stepped on a shoot."},
        {"zh": "我抬起了那只举着的手。", "en": "I raise the arm that was already up."},
        {"zh": "你往后面退了。", "en": "You have drawn back."},
        {"zh": "这样便行了。", "en": "That will do."},
        {"zh": "我把手放回去。", "en": "I put the arm back."},
        {"zh": "我们还能相处。", "en": "We can still get along."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "草被扯掉一把。", "en": "A handful of straw is torn loose."},
        {"zh": "我朝一边歪过去。", "en": "I lean to one side."},
        {"zh": "我的稻草散了几根。", "en": "A few strands of straw came loose."},
        {"zh": "绑我的线松了。", "en": "My binding has loosened."},
        {"zh": "草屑落在我脚下。", "en": "Chaff falls at my feet."},
        {"zh": "我已经看不清了。", "en": "I cannot see well now."},
        {"zh": "画的脸有点花。", "en": "My painted face is smeared."},
        {"zh": "我还是举着手。", "en": "My arm is still up."},
        {"zh": "这是我能做的。", "en": "It is what I can do."},
        {"zh": "我还立在这里。", "en": "I am still upright."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不必吃东西。", "en": "I need not eat."},
        {"zh": "你举着东西给我看。", "en": "You hold it up for me to see."},
        {"zh": "我的脸是画的，没有嘴。", "en": "My face is painted. There is no mouth."},
        {"zh": "你把东西放在田边。", "en": "You set it at the field's edge."},
        {"zh": "我打量了很久。", "en": "I study it a long while."},
        {"zh": "那是留给鸟的。", "en": "It is meant for birds."},
        {"zh": "鸟根本不会来了。", "en": "The birds will not come."},
        {"zh": "就让它搁在那儿。", "en": "Then let it lie there."},
        {"zh": "也算有几分用。", "en": "It is some use, at least."},
        {"zh": "我转回去看田。", "en": "I turn back to the field."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到柱子，我晃了一下。", "en": "You knock the post and I sway."},
        {"zh": "草从我身上掉下来。", "en": "Straw falls off me."},
        {"zh": "我一节节撑起来。", "en": "I come upright by degrees."},
        {"zh": "我的帽子更歪了。", "en": "My hat is further askew."},
        {"zh": "你也看见了吧。", "en": "You see it too."},
        {"zh": "你一点也没笑。", "en": "You do not laugh."},
        {"zh": "这一点我记住了。", "en": "I will remember that."},
        {"zh": "我把自己正回来。", "en": "I settle myself straight."},
        {"zh": "草屑落了一地。", "en": "Chaff scatters on the ground."},
        {"zh": "田里多了一点肥。", "en": "The field gains a little more."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "田另一头还有一个。", "en": "There is another at the far end of the field."},
        {"zh": "也是草扎出来的。", "en": "Also bound straw."},
        {"zh": "我们隔着整块田。", "en": "A whole field between us."},
        {"zh": "风大的时候，我们一起晃。", "en": "When the wind is strong, we sway together."},
        {"zh": "节奏完全一样。", "en": "In the same rhythm."},
        {"zh": "这样便已经够了。", "en": "That is enough."},
        {"zh": "谁都不出一声。", "en": "Neither makes a sound."},
        {"zh": "我们都说不出话。", "en": "Neither of us can."},
        {"zh": "天黑了，谁也看不见谁。", "en": "At dark, neither can see the other."},
        {"zh": "明天还在这儿。", "en": "Tomorrow we are still there."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸出手，够不到。", "en": "I reach out a hand. Not far enough."},
        {"zh": "我把镰刀横在身前。", "en": "I hold my scythe across my body."},
        {"zh": "还是够不着。", "en": "Still not."},
        {"zh": "草做的手抓不住。", "en": "Straw hands do not grip."},
        {"zh": "我试了一次又一次。", "en": "I try again and again."},
        {"zh": "最后用手臂把它拨过来。", "en": "At last I sweep it over with an arm."},
        {"zh": "它滚进田里去。", "en": "It rolls into the field."},
        {"zh": "我瞧了瞧它。", "en": "I look at it."},
        {"zh": "我用镰刀把它挑开。", "en": "I flick it aside with my scythe."},
        {"zh": "我又回到柱子上。", "en": "I return to my post."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在田里。", "en": "Something is in the field."},
        {"zh": "我转过头去看。", "en": "I turn my head."},
        {"zh": "是一只乌鸦。", "en": "A crow."},
        {"zh": "它落在苗上面。", "en": "It lands on a shoot."},
        {"zh": "我抬起草做的手。", "en": "I raise my straw arm."},
        {"zh": "我举起镰刀对着它。", "en": "I raise my scythe toward it."},
        {"zh": "它动也不动。", "en": "And does not move."},
        {"zh": "我把它晃了晃。", "en": "I sway."},
        {"zh": "草发出响声。", "en": "The straw rustles."},
        {"zh": "它跳到一边去。", "en": "It hops away."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着那只乌鸦。", "en": "I fix on the crow."},
        {"zh": "它在苗之间跳。", "en": "It hops among the shoots."},
        {"zh": "我一直举着手。", "en": "My arm stays up."},
        {"zh": "我的镰刀映着它的影子。", "en": "My blade reflects its shadow."},
        {"zh": "草做的吓不住它太久。", "en": "Straw only frightens it so long."},
        {"zh": "镰刀还没举，先转过身。", "en": "Scythe still down, I turn first."},
        {"zh": "柱子把我顶住了。", "en": "The post holds me."},
        {"zh": "我也转不了多远。", "en": "It does not turn far."},
        {"zh": "我把身子往前倾。", "en": "I lean forward."},
        {"zh": "草帽掉了下来。", "en": "My hat falls off."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑过去，草散开一半。", "en": "I lunge, and half my straw comes loose."},
        {"zh": "乌鸦被惊起飞。", "en": "The crow starts up."},
        {"zh": "我撞在秧苗上。", "en": "I strike the seedlings."},
        {"zh": "草和泥一起翻。", "en": "Straw and earth turn together."},
        {"zh": "我慢慢收拢自己。", "en": "I gather myself slowly."},
        {"zh": "草一根根回来。", "en": "The straw comes back, strand by strand."},
        {"zh": "我还是原先模样。", "en": "I am what I was."},
        {"zh": "只是帽子不见了。", "en": "Only the hat is gone."},
        {"zh": "田里有了几处踩痕。", "en": "A few marks are left in the field."},
        {"zh": "我转到最大的一面。", "en": "I turn my widest face out."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从柱子上睁开眼。", "en": "I open my eyes on the post."},
        {"zh": "每一根草都绑得很紧。", "en": "Every straw is bound tight."},
        {"zh": "有人把我扎好了。", "en": "Someone has tied me together."},
        {"zh": "我站在田的中间。", "en": "I stand in the middle of the field."},
        {"zh": "太阳已经很高。", "en": "The sun is high."},
        {"zh": "四周全都是苗。", "en": "Shoots all around."},
        {"zh": "我把脸转向前方。", "en": "I turn my face forward."},
        {"zh": "这是我要看的方向。", "en": "That is the way I am to watch."},
        {"zh": "草屑在我身体里响个不停。", "en": "Chaff whispers endlessly inside me."},
        {"zh": "稻草扎成的手，握紧了镰刀。", "en": "My straw hands tighten on the scythe."},
        {"zh": "鸟在远处的树上叫。", "en": "Birds call from the far trees."},
        {"zh": "它们总会来的。", "en": "They will come."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一下就烧到草里，我掉下柱子。", "en": "Fire takes the straw at once and I drop off the post."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "柱子断了，我摔在田里。", "en": "The post breaks and I fall into the field."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "雨水泡透了我，我重得站不住。", "en": "Rain soaks through me and I am too heavy to stand."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把草吹散，只剩几根。", "en": "The blast scatters the straw; only a few strands remain."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过我的胸口，草飞了出去。", "en": "An arrow passes through my chest and straw flies."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光罩住我，我的草僵了。", "en": "Strange light wraps me and my straw goes stiff."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "太久没有换草，我开始发霉。", "en": "Too long without fresh straw, and I begin to rot."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在柱子上，我整身都焦了。", "en": "Lightning strikes the post and I am scorched all over."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "田没了，我在黑里散开。", "en": "The field is gone and I come apart in the dark."}
      ]
    }
  }
}
