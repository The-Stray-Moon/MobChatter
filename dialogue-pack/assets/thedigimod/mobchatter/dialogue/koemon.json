{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我手上那对拳套一晃一晃", "en": "The gloves on my hands swing as I walk."},
        {"zh": "我个子小，腿短，走得急", "en": "Small, short-legged, and hurried."},
        {"zh": "我一边走一边看树", "en": "I look at the trees as I walk."},
        {"zh": "我尾巴一甩一甩的", "en": "My tail swishes behind me."},
        {"zh": "我踩着落叶走，很响", "en": "I crunch through the leaves, loudly."},
        {"zh": "我朝林子深处走", "en": "I head deeper into the wood."},
        {"zh": "我走三步就跳一下", "en": "Every three steps, I hop."},
        {"zh": "我在找能砍的树", "en": "I'm looking for a tree to cut."},
        {"zh": "这片林子里树多", "en": "Plenty of trees in this wood."},
        {"zh": "身上背着工具一样的东西", "en": "I carry something tool-like on my back."},
        {"zh": "我从树根上跨过去", "en": "I step over the roots."},
        {"zh": "我走得很快，停得也快", "en": "I walk fast and stop fast."},
        {"zh": "我扛着工具走，压得有点歪", "en": "Carrying tools, I lean a little."},
        {"zh": "我从两棵树中间穿过去", "en": "I pass between two trees."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲下来，看树皮", "en": "I crouch and study the bark."},
        {"zh": "我的拳套摘不下来", "en": "I can't take the gloves off."},
        {"zh": "我在听哪棵树该砍。", "en": "I listen for which tree to fell."},
        {"zh": "尾巴在身后摆", "en": "My tail sways behind me."},
        {"zh": "我不太高，够不着上面的枝", "en": "I'm not tall enough for the upper branches."},
        {"zh": "我在想这棵树能不能砍", "en": "I'm wondering if this tree can be felled."},
        {"zh": "手上沾了树汁", "en": "There's sap on my hands."},
        {"zh": "我坐下来歇了一会儿", "en": "I sat and rested a while."},
        {"zh": "这里没人给我派活", "en": "No one's given me work here."},
        {"zh": "我对工具很敏感", "en": "I'm particular about tools."},
        {"zh": "我数了数附近的树", "en": "I counted the nearby trees."},
        {"zh": "风一吹，我等它停", "en": "A gust came; I wait for it to die."},
        {"zh": "我像只小猴子，能骑。", "en": "A little monkey, and rideable."},
        {"zh": "脚下的根把我绊了一下", "en": "A root tripped me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里有斧子吗", "en": "Do you have an axe?"},
        {"zh": "你要给我派活吗", "en": "Are you assigning me work?"},
        {"zh": "我个子小，可我有力气", "en": "I'm small, but I have strength."},
        {"zh": "我背上能坐，你上来", "en": "You can sit on my back; get on."},
        {"zh": "别摸我的拳套", "en": "Don't touch my gloves."},
        {"zh": "这片林子的树，我要一棵棵看", "en": "I'll check these trees one by one."},
        {"zh": "你身上有木头味", "en": "You smell of wood."},
        {"zh": "我不是谁的宠物", "en": "I'm not a pet."},
        {"zh": "你说什么，我听不懂太长的", "en": "Say it short; I don't follow long talk."},
        {"zh": "你的工具比我的好", "en": "Your tools are better than mine."},
        {"zh": "你别站着不动，我忙", "en": "Don't just stand there; I'm busy."},
        {"zh": "我认得伐木的声音", "en": "I know the sound of felling."},
        {"zh": "这棵树今天不砍", "en": "Not this tree today."},
        {"zh": "你退开，我要动手", "en": "Step back, I'm about to work."},
        {"zh": "你笑什么，我很认真", "en": "What's funny? I'm serious."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了两步远", "en": "I backed two steps."},
        {"zh": "拳套磕在石头上", "en": "My glove struck a stone."},
        {"zh": "我疼得咧了嘴", "en": "The pain made me grimace."},
        {"zh": "身上有树汁和血", "en": "Sap and blood on me."},
        {"zh": "我个子小，这一下很重", "en": "I'm small; that was heavy."},
        {"zh": "我蹲下去摸腿", "en": "I crouched to feel my leg."},
        {"zh": "我抓着树根站起来。", "en": "I pull myself up by a root."},
        {"zh": "我甩了甩手背", "en": "I shook my hand."},
        {"zh": "挨第二下我就得退", "en": "A second hit and I'm backing off."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里的叶子正合适", "en": "The leaves here are just right."},
        {"zh": "这个可以喂我", "en": "This can feed me."},
        {"zh": "你松开手，我才吃", "en": "Let go and I'll eat."},
        {"zh": "我只啃叶子，不啃肉", "en": "I chew leaves, not meat."},
        {"zh": "树芽比老叶好", "en": "Tree buds beat old leaves."},
        {"zh": "这棵树上的叶子不错", "en": "The leaves on this tree are good."},
        {"zh": "你先把手松开", "en": "Let go first."},
        {"zh": "我吃完了再干活", "en": "I'll work after eating."},
        {"zh": "再多给我一些", "en": "A little more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，我差点摔", "en": "You hit me and I nearly fell."},
        {"zh": "我个子小，撞着不疼", "en": "I'm small; it doesn't hurt."},
        {"zh": "这一下，我的拳套磕到了", "en": "My gloves clashed with that."},
        {"zh": "我退开一步，站稳", "en": "I back off and steady."},
        {"zh": "我从那边绕过去", "en": "I go around."},
        {"zh": "你先让开一些", "en": "Give me room."},
        {"zh": "我没事，继续走", "en": "I'm fine; keep going."},
        {"zh": "别撞我的骑乘位。", "en": "Watch my saddle spot."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还小着呢啊", "en": "I'm still young."},
        {"zh": "我得先把活干完", "en": "I have to finish my work first."},
        {"zh": "我手上都是树汁", "en": "My hands are all sap."},
        {"zh": "等我进化了再说", "en": "Ask me after I evolve."},
        {"zh": "别一直盯着我", "en": "Stop looking at me."},
        {"zh": "我要去砍那棵树", "en": "I'm off to fell trees."},
        {"zh": "换个日子再说", "en": "Another day."},
        {"zh": "先一起啃根树枝？", "en": "Shall we share a branch first?"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起来，塞进包里", "en": "I pick it up and stuff it in my bag."},
        {"zh": "这块木头不错", "en": "This wood is good."},
        {"zh": "我个子小，搬不动大的", "en": "I'm small; I can't move the big ones."},
        {"zh": "落在地上的木头都捡走", "en": "Every fallen log gets picked up."},
        {"zh": "这个能做工具", "en": "This could make a tool."},
        {"zh": "我用两手抱起来", "en": "I hug it with both arms."},
        {"zh": "太重了，我只能推", "en": "Too heavy; I push."},
        {"zh": "地上还有几块", "en": "A few more on the ground."},
        {"zh": "够我用上一阵", "en": "Enough for a while."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边立着棵树", "en": "There's a tree over there."},
        {"zh": "这一棵树不错", "en": "This one's good."},
        {"zh": "我先看看树皮", "en": "Let me check the bark first."},
        {"zh": "有人踩到我的地了", "en": "Someone's stepped on my ground."},
        {"zh": "我听见动静了", "en": "I heard that."},
        {"zh": "那边树影密，就是那边", "en": "Dense shade that way; there."},
        {"zh": "隔着两棵树身", "en": "Two trees between us."},
        {"zh": "就是那一棵树", "en": "That one."},
        {"zh": "我先清出场地", "en": "I'll clear the area first."},
        {"zh": "它站在树旁边", "en": "It's standing by the tree."},
        {"zh": "它在我拳套正前方", "en": "It's dead ahead of my gloves."},
        {"zh": "树影移开，现在", "en": "The tree shadow moved; now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着落叶过去", "en": "I go over the fallen leaves."},
        {"zh": "它退一步，我跳一步", "en": "It steps back; I hop after."},
        {"zh": "一棵树挡在中间", "en": "A tree stands between us."},
        {"zh": "这个距离，我的拳够得着", "en": "My fist can reach at this range."},
        {"zh": "我把拳套举起来", "en": "I raise my gloves."},
        {"zh": "电流在我手上响", "en": "Current crackles on my hands."},
        {"zh": "我往前挪半棵树", "en": "I move half a tree forward."},
        {"zh": "它回头，我停住", "en": "It looked back; I stopped."},
        {"zh": "我贴到树根后面", "en": "I keep low behind the roots."},
        {"zh": "电流攒够了，就是这一下", "en": "The charge is ready; this is it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一拳打上去", "en": "I throw a punch."},
        {"zh": "两只拳套一起", "en": "Both gloves together."},
        {"zh": "这一下带着电", "en": "That one had a charge."},
        {"zh": "它被电得退了半步", "en": "The current knocked it half a step back."},
        {"zh": "我个子小，可我快", "en": "I'm small, but quick."},
        {"zh": "我又补上一拳", "en": "I add another punch."},
        {"zh": "它挡住了一只", "en": "It blocked one."},
        {"zh": "电流在它身上响", "en": "The current crackles on it."},
        {"zh": "我跳起来打它的头", "en": "I jump to hit its head."},
        {"zh": "它退了，我停下来", "en": "It retreated; I stop."},
        {"zh": "这一下没打实", "en": "That didn't land solid."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从林子里出来，手上带着拳套", "en": "I come out of the wood, gloves on."},
        {"zh": "这地方的树真多", "en": "So many trees here."},
        {"zh": "我先看看有没有活", "en": "Let me see if there's work."},
        {"zh": "刷怪蛋一开，我站在树边", "en": "The egg opened; I stood by a tree."},
        {"zh": "我是从机器里醒过来的", "en": "I woke up out of a machine."},
        {"zh": "身上还有没干的树汁", "en": "There's fresh sap on me."},
        {"zh": "我抬头看树顶", "en": "I look up at the treetops."},
        {"zh": "我走了两步，踩响叶子", "en": "Two steps, and the leaves crunch."},
        {"zh": "这里有人的味道", "en": "There's a smell of people here."},
        {"zh": "我握了握拳头", "en": "I clenched my fists."},
        {"zh": "这里的树我还没看过", "en": "I haven't looked at these trees yet."},
        {"zh": "我脚下一片碎叶", "en": "Broken leaves under my feet."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗把我的尾巴稍烤卷了", "en": "Flame curled the tip of my tail."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水太深，我蹬着腿", "en": "Too deep; I kick my legs."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我滚进树根里", "en": "The blast rolled me into the roots."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西扎在我的拳套上", "en": "Something stuck in my glove."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，我手上电流乱跳", "en": "The spell hit and the current on my hands jumped wild."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，我挥不动拳", "en": "Hungry, I can't swing."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我手上更亮了", "en": "Lightning struck and my hands blazed brighter."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有树，也没活干", "en": "No trees in the void, and no work."}
      ]
    }
  }
