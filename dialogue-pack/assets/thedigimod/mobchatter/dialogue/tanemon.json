{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我顶着叶子蹦着走", "en": "I bounce along with a leaf on my head."},
        {"zh": "圆圆的身体一弹一弹", "en": "My round body bobs with each hop."},
        {"zh": "草原上的草比我还高", "en": "The grass is taller than I am."},
        {"zh": "我从草缝里挤过去", "en": "I squeeze between the blades."},
        {"zh": "叶子被草划了一下", "en": "A blade scrapes my leaf."},
        {"zh": "我停下来抖了抖", "en": "I stop and shake it."},
        {"zh": "然后接着往前挪", "en": "Then shuffle onward."},
        {"zh": "我在找软的地", "en": "I'm looking for soft ground."},
        {"zh": "最好是有光的地方", "en": "Ideally somewhere with light."},
        {"zh": "我朝空地上挪", "en": "I shuffle toward the clearing."},
        {"zh": "身体一晃一晃", "en": "My body rocks side to side."},
        {"zh": "像一颗会走路的种子", "en": "Like a seed that learned to walk."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我藏在蕨叶的下面。", "en": "I hide under a fern frond."},
        {"zh": "头上的叶子歪了", "en": "My leaf has tilted."},
        {"zh": "我用短手扶了扶", "en": "I straighten it with a stubby hand."},
        {"zh": "怎么也扶不正", "en": "It won't sit right."},
        {"zh": "那也只好这样", "en": "Never mind, then."},
        {"zh": "阳光从叶子中间漏下来", "en": "Sun leaks through the leaves above."},
        {"zh": "我往那片光里挪", "en": "I shuffle into it."},
        {"zh": "这里真是暖和", "en": "Warm."},
        {"zh": "远处传来鸟叫", "en": "Birds call beyond."},
        {"zh": "我一点都不动", "en": "I hold still."},
        {"zh": "一直等它们走开", "en": "Until they move off."},
        {"zh": "我还待在光里", "en": "And I'm still in the light."},
        {"zh": "再待上一会儿", "en": "A while longer."},
        {"zh": "有只虫落在我的叶子上", "en": "A bug lands on my leaf."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的头顶还长着叶子。", "en": "A leaf still grows on my head."},
        {"zh": "你的腿比我的树还粗", "en": "Your legs are thicker than my trunk."},
        {"zh": "我往草里缩了缩", "en": "I shrink into the grass."},
        {"zh": "叶子挡在我前面", "en": "My leaf comes up in front."},
        {"zh": "我偷偷地看你", "en": "I peek at you."},
        {"zh": "你一动也没动", "en": "You don't move."},
        {"zh": "我伸出一只短手", "en": "I extend one stubby hand."},
        {"zh": "朝你轻轻一挥", "en": "And wave."},
        {"zh": "然后又收回来", "en": "Then pull it back."},
        {"zh": "你好像笑了一笑", "en": "You smiled."},
        {"zh": "那我也放心了", "en": "Then I can relax."},
        {"zh": "我从草里出来", "en": "I step out of the grass."},
        {"zh": "慢慢挪到你脚边", "en": "And shuffle to your feet."},
        {"zh": "我抬头瞧着你", "en": "I peer up at you."},
        {"zh": "我仅仅看看你", "en": "Just looking."},
        {"zh": "没有别的意思", "en": "Nothing more."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我一路滚出去", "en": "I go rolling away."},
        {"zh": "叶子歪到一边", "en": "My leaf flops to one side."},
        {"zh": "我歪着身子撑了起来。", "en": "I push myself up, tilted."},
        {"zh": "扶了扶那片叶", "en": "And straighten the leaf."},
        {"zh": "身体凹进去一点", "en": "A dent in my body."},
        {"zh": "慢慢鼓了回来", "en": "Slowly puffing back out."},
        {"zh": "叶子被我抖得直响。", "en": "My leaves rustle as I shake."},
        {"zh": "然后我就跑了", "en": "Then run."},
        {"zh": "一下钻进草里", "en": "Into the grass."},
        {"zh": "你肯定找不到", "en": "You won't find me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是种子吗呀", "en": "Is that a seed?"},
        {"zh": "我一下站起来", "en": "I pop upright."},
        {"zh": "我的眼睛亮了", "en": "My eyes light up."},
        {"zh": "我又往前挪了两步", "en": "I shuffle two steps closer."},
        {"zh": "我伸头闻一闻", "en": "I stretch up and sniff."},
        {"zh": "就是那种味道", "en": "That smell."},
        {"zh": "我的饲料就是这样的", "en": "My food smells like this."},
        {"zh": "我张了张小嘴", "en": "I open my mouth."},
        {"zh": "可是又闭上了", "en": "Then close it."},
        {"zh": "你放下来我就吃", "en": "Set it down and I'll eat."},
        {"zh": "我不会去抢的", "en": "I won't grab."},
        {"zh": "但我会一直盯着", "en": "But I'll keep watching."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚进草里，叶子沾泥。", "en": "I roll into the grass, leaves muddy."},
        {"zh": "叶子压在地上", "en": "My leaf squashes against the ground."},
        {"zh": "我一下四脚朝天", "en": "I'm on my back."},
        {"zh": "连蹬了半天腿", "en": "Kicking for a while."},
        {"zh": "这才翻身回来", "en": "Before I right myself."},
        {"zh": "叶子歪得更厉害了", "en": "My leaf's even more crooked now."},
        {"zh": "我伸手扶了扶", "en": "I straighten it."},
        {"zh": "这次好了一些", "en": "Better this time."},
        {"zh": "我撞上你的鞋尖，弹开了。", "en": "I hit your boot tip and bounce off."},
        {"zh": "又低头检查叶子", "en": "Then check my leaf again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我现在还很小", "en": "I'm still small."},
        {"zh": "这种事要长大以后", "en": "That comes after growing up."},
        {"zh": "我每天就是吃和晒太阳", "en": "For now it's eating and sun."},
        {"zh": "有时候会变得不太一样", "en": "Sometimes things change."},
        {"zh": "我身上会发光", "en": "I'll glow."},
        {"zh": "然后我会变成别的样子", "en": "Then I'll be something else."},
        {"zh": "大概会是一朵花", "en": "Maybe a flower."},
        {"zh": "也可能并不是", "en": "Or maybe not."},
        {"zh": "到时候就知道了", "en": "I'll know then."},
        {"zh": "现在还是先吃", "en": "For now, eat."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用短手抱起", "en": "My stubby hands scoop it up."},
        {"zh": "抱不住，掉了", "en": "Can't hold it. It drops."},
        {"zh": "我用两片叶子夹住它。", "en": "I pinch it between two leaves."},
        {"zh": "这次总算抱住", "en": "This time it stays."},
        {"zh": "整个身子转了过来。", "en": "My whole body turns around."},
        {"zh": "好像在给你看", "en": "As if showing you."},
        {"zh": "然后又低头看了看", "en": "Then look down at it."},
        {"zh": "不知道算不算能用", "en": "Not sure it counts as useful."},
        {"zh": "那我就先抱着", "en": "I'll hold it a while."},
        {"zh": "反正一点也不重", "en": "It's not heavy anyway."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "草叶尖上有个影子晃。", "en": "A shadow sways on the grass tips."},
        {"zh": "我把脑袋仰起来", "en": "I tip my head back."},
        {"zh": "叶子挡了一部分视线", "en": "My leaf blocks part of my view."},
        {"zh": "我歪头绕过去看", "en": "I tilt to see past it."},
        {"zh": "草里有东西在动，那边有个影子。", "en": "Something moves in the grass — a shadow over there."},
        {"zh": "看着一点也不大", "en": "Not big."},
        {"zh": "我这才松口气", "en": "I relax."},
        {"zh": "但还是很紧张", "en": "Still tense, though."},
        {"zh": "我后退一小步", "en": "I back up a step."},
        {"zh": "草把我盖住了", "en": "The grass covers me."},
        {"zh": "这样真的很好", "en": "This is really nice."},
        {"zh": "我把自己埋进草根间。", "en": "I bury myself among the grass roots."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在草里跟着", "en": "I follow through the grass."},
        {"zh": "你踩的草里就有我。", "en": "I'm in the grass you just stepped on."},
        {"zh": "叶子在草里看不出来", "en": "My leaf doesn't show among the blades."},
        {"zh": "我头上的叶子，还没长开。", "en": "The leaf on my head hasn't opened."},
        {"zh": "尽量不发出声", "en": "Trying to stay quiet."},
        {"zh": "可我还是很圆", "en": "But I'm still very round."},
        {"zh": "草一动就露出来", "en": "One wobble and I show."},
        {"zh": "我就在此停下", "en": "I stop right here."},
        {"zh": "一直等你转开", "en": "Until you turn away."},
        {"zh": "然后再往前走", "en": "Then move again."},
        {"zh": "走到那片空地", "en": "To the clearing."},
        {"zh": "那边有一点光", "en": "There's light there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我鼓起腮帮子", "en": "I puff my cheeks."},
        {"zh": "然后吐出一个泡", "en": "And spit a bubble."},
        {"zh": "泡飘过去，破了", "en": "It drifts over and pops."},
        {"zh": "这只是小把戏", "en": "That's only a small trick."},
        {"zh": "我吐出一串黏糊的种子。", "en": "I spit out a string of sticky seeds."},
        {"zh": "这一个大多了", "en": "Bigger this time."},
        {"zh": "你退了小半步", "en": "You step back half a pace."},
        {"zh": "我也跟着退了", "en": "So do I."},
        {"zh": "我们都不想打", "en": "Neither of us wants a fight."},
        {"zh": "那就这样为止", "en": "Then that's that."},
        {"zh": "我往草里挪去", "en": "I shuffle into the grass."},
        {"zh": "叶子在里面晃了一下", "en": "My leaf sways once among the blades."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草里冒出一个小圆球", "en": "A little round thing pops up in the grass."},
        {"zh": "头顶一片叶子", "en": "A leaf on its head."},
        {"zh": "我抖掉根上的泥站着。", "en": "I shake the dirt off my roots and stand."},
        {"zh": "这里的草很好", "en": "The grass here is nice."},
        {"zh": "软，而且有光", "en": "Soft, and lit."},
        {"zh": "我朝最近的光斑挪", "en": "I shuffle to the nearest patch of sun."},
        {"zh": "叶子慢慢正过来", "en": "My leaf slowly rights itself."},
        {"zh": "我从土里顶出两片叶子。", "en": "I push two leaves up out of the soil."},
        {"zh": "有花粉的味道", "en": "Smells of pollen."},
        {"zh": "我在这儿待一会", "en": "I'll stay here a while."},
        {"zh": "我朝四周看了看", "en": "I look around."},
        {"zh": "这个方向最好", "en": "This direction looks best."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "叶子被烧卷了边", "en": "The edge of my leaf curls from heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地弹了两下", "en": "I bounce twice on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我浮不起来", "en": "In water I can't right myself."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被风掀得翻了个身。", "en": "The blast flipped me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根刺扎进我的根里。", "en": "A thorn works into my roots."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我晕得很厉害", "en": "I feel terribly dizzy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得连蹦都费劲", "en": "Too hungry to even hop."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电流把我的叶子烤焦了。", "en": "The current scorched my leaves."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有草了", "en": "No grass under me."}
      ]
    }
  }
}
