{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我四足压过针叶林的地面。", "en": "I bear down on the conifer floor on four legs."},
        {"zh": "背上像一片会动的林子。", "en": "My back is like a moving grove."},
        {"zh": "藤蔓拖在身后。", "en": "Vines drag behind me."},
        {"zh": "走一步，落叶就被压下。", "en": "Each step presses the needles flat."},
        {"zh": "我的尾巴摆得很慢。", "en": "My tail swings slowly."},
        {"zh": "它是半棵树。", "en": "It is half a tree."},
        {"zh": "我绕过一颗老云杉。", "en": "I round an old spruce."},
        {"zh": "树皮擦过我的背。", "en": "Bark scrapes my back."},
        {"zh": "我朝更暗的林子里去。", "en": "I head for the darker woods."},
        {"zh": "那里很潮湿。", "en": "It is damp there."},
        {"zh": "我停下来嗅了嗅地。", "en": "I stop and sniff the ground."},
        {"zh": "根和泥土的味道。", "en": "Roots and soil."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，背上的植物在动。", "en": "I stand, the growth on my back stirring."},
        {"zh": "那并不是风。", "en": "That is not wind."},
        {"zh": "那棵树就是我。", "en": "That tree is me."},
        {"zh": "我看着前方。", "en": "I look ahead."},
        {"zh": "林子静得出奇。", "en": "The woods are oddly still."},
        {"zh": "只有我在呼吸。", "en": "Only I am breathing."},
        {"zh": "我像一棵树。", "en": "I am like a tree."},
        {"zh": "枝头的芽在轻轻张合。", "en": "Buds on my branches open and close softly."},
        {"zh": "枝叶跟着摇。", "en": "The branches sway with it."},
        {"zh": "我又转回原处。", "en": "I turn back to where I was."},
        {"zh": "脚下的苔被我压出印。", "en": "Moss takes my print."},
        {"zh": "远处有锯木的声音。", "en": "There is a sound like sawing far off."},
        {"zh": "那不是锯木声。", "en": "That is not sawing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我低下头，比你高三倍。", "en": "I lower my head; I am three times your height."},
        {"zh": "你站在针叶里。", "en": "You stand among the needles."},
        {"zh": "你居然没有逃。", "en": "You did not flee."},
        {"zh": "鼻尖几乎碰到你。", "en": "My snout nearly touches you."},
        {"zh": "我低下鼻子闻。", "en": "I lower my snout to sniff."},
        {"zh": "你不是敌人。", "en": "You are not an enemy."},
        {"zh": "我把长颈抬高。", "en": "I raise my long neck."},
        {"zh": "背上的枝条舒展开。", "en": "The branches on my back unfurl."},
        {"zh": "就像树在打招呼。", "en": "Like a tree greeting you."},
        {"zh": "你伸出了手。", "en": "You put out your hand."},
        {"zh": "一片叶子落在你掌心。", "en": "A leaf falls into your palm."},
        {"zh": "我转身离去。", "en": "I turn and depart."},
        {"zh": "我没有回过头。", "en": "I did not look back."},
        {"zh": "但我知道你还站着。", "en": "But I know you are still standing."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我背上的枝条断了几根。", "en": "Several branches on my back break."},
        {"zh": "花叶被撕掉一大把。", "en": "A whole fistful of petals torn away."},
        {"zh": "根须在土里绷紧了。", "en": "My roots pull taut in the soil."},
        {"zh": "甲上没有血。", "en": "There is no blood on my hide."},
        {"zh": "可是里面很疼。", "en": "But it hurts inside."},
        {"zh": "断枝的断口渗出汁液。", "en": "Sap seeps from my broken branches."},
        {"zh": "让断口朝里。", "en": "Turning the breaks inward."},
        {"zh": "它会长回来。", "en": "They will grow back."},
        {"zh": "这需要时间。", "en": "It needs time."},
        {"zh": "而我有的是。", "en": "And I have plenty."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我垂下头去看。", "en": "I drop my head to look."},
        {"zh": "我只要土里长出来的。", "en": "I eat only what grows out of the soil."},
        {"zh": "我吃土里的东西。", "en": "I eat what is in the soil."},
        {"zh": "我把头扭开。", "en": "I twist my head away."},
        {"zh": "你还举着手。", "en": "You are still holding it up."},
        {"zh": "轻轻把它拨到一边。", "en": "And nudge it aside gently."},
        {"zh": "我继续向前迈步。", "en": "I keep stepping forward."},
        {"zh": "叶子从我背上掉下来。", "en": "A leaf falls from my back."},
        {"zh": "你最好也收起来。", "en": "You had best put it away too."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "很硬，像树。", "en": "Hard, like a tree."},
        {"zh": "我垂下头看你。", "en": "I lower my head to you."},
        {"zh": "我把腿挪开。", "en": "I move my leg aside."},
        {"zh": "背上的枝条扫过你。", "en": "The branches on my back brush you."},
        {"zh": "一片叶子掉在你肩上。", "en": "A leaf lands on your shoulder."},
        {"zh": "我一步步往前走。", "en": "I walk on, step by step."},
        {"zh": "没有别的意思。", "en": "Nothing more intended."},
        {"zh": "别踩我的藤蔓，它们会记仇。", "en": "Don't step on my vines — they hold grudges."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在林间找到她。", "en": "I find her in the woods."},
        {"zh": "我们的背都像林子。", "en": "Our backs are both like woods."},
        {"zh": "枝条碰在一起。", "en": "Our branches touch."},
        {"zh": "很久都没有分开。", "en": "And stay touching a long while."},
        {"zh": "我围着她走。", "en": "I walk around her."},
        {"zh": "地上的苔被踩成一圈。", "en": "The moss is pressed into a ring."},
        {"zh": "她把头低下来。", "en": "She lowers her head."},
        {"zh": "我也低下去。", "en": "I lower mine too."},
        {"zh": "这里会安静很久。", "en": "It will be quiet here a long time."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "爪尖把它钉在苔上。", "en": "My claw pins it to the moss."},
        {"zh": "它陷进土里。", "en": "It sinks into the soil."},
        {"zh": "上面全是泥。", "en": "It is covered in mud."},
        {"zh": "我把鼻子凑近。", "en": "I bring my snout close."},
        {"zh": "我把它搁回去。", "en": "I set it back."},
        {"zh": "土会把它收走。", "en": "The soil will take it."},
        {"zh": "背上又落了一层叶。", "en": "Another layer of leaves settles on my back."},
        {"zh": "我没有去管它。", "en": "I pay it no attention."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在林子里跑。", "en": "Something runs in the woods."},
        {"zh": "脖子抬起来，叶子跟着动。", "en": "Neck lifting, leaves rustling with it."},
        {"zh": "背上的枝条全部立起来。", "en": "Every branch on my back stands up."},
        {"zh": "它还在跑着。", "en": "It is still running."},
        {"zh": "林子被我撞开一条路。", "en": "I force a path through the trees."},
        {"zh": "它回头看了。", "en": "It glances back."},
        {"zh": "但我的腿更长。", "en": "But my legs are longer."},
        {"zh": "叶片收紧，目标已经锁定。", "en": "Leaves tighten — target locked."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步逼。", "en": "I close in step by step."},
        {"zh": "我把那棵树撞倒。", "en": "I knock that tree down."},
        {"zh": "它换了方向。", "en": "It changes direction."},
        {"zh": "我又一次追上。", "en": "I catch up again."},
        {"zh": "林子里的鸟全飞起来。", "en": "Every bird in the woods takes flight."},
        {"zh": "它喘起来了。", "en": "It starts to pant."},
        {"zh": "我一点都不喘。", "en": "I am not panting at all."},
        {"zh": "我停住四足。", "en": "I stop all four feet."},
        {"zh": "它以为我要放弃。", "en": "It thinks I am giving up."},
        {"zh": "我扬起尾巴。", "en": "I raise my tail."},
        {"zh": "我把尾巴往前扫。", "en": "I sweep my tail forward."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的前爪压下去。", "en": "My forepaw comes down."},
        {"zh": "它被顶得退开。", "en": "It is driven back."},
        {"zh": "尾巴扫过去。", "en": "My tail sweeps across."},
        {"zh": "很重的一下。", "en": "A heavy blow."},
        {"zh": "它整个翻倒了。", "en": "It goes right over."},
        {"zh": "我低下头去咬。", "en": "I lower my head and bite."},
        {"zh": "我的牙不算尖。", "en": "My teeth are not sharp."},
        {"zh": "但咬合力很大。", "en": "But my bite is powerful."},
        {"zh": "它根本挣不开。", "en": "It cannot pull free."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "针叶林里多了一棵树。", "en": "A new tree appears in the conifers."},
        {"zh": "但那棵树在动。", "en": "But that tree is moving."},
        {"zh": "那棵会走的树是我。", "en": "That walking tree is me."},
        {"zh": "针叶林里多出一片花。", "en": "A patch of bloom appears among the pines."},
        {"zh": "背上的枝条比树还密。", "en": "My branches are thicker than the trees."},
        {"zh": "脚下的苔立刻变了色。", "en": "The moss changes colour at once under me."},
        {"zh": "我抬起头颅。", "en": "I raise my head."},
        {"zh": "树顶在我眼睛上面。", "en": "The treetops are above my eyes."},
        {"zh": "我朝水汽的方向走。", "en": "I walk toward the damp."},
        {"zh": "黑森林在那边。", "en": "The dark forest lies that way."},
        {"zh": "我一步一步走。", "en": "I walk step by step."},
        {"zh": "我的步伐不快。", "en": "My pace is not quick."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到我的背，枝条卷起来。", "en": "Fire catches my back and the branches curl."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上压下来，砸断了几棵树。", "en": "I crash down a slope and break several trees."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的根，我慢慢下坠。", "en": "Water fills my roots; I sink slowly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我背上的林子掀掉一半。", "en": "The blast strips half the grove from my back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西钉进我的树皮。", "en": "It buries in my bark."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我的叶子全白了。", "en": "A cold turns all my leaves white."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "土里没有东西可吸了。", "en": "There is nothing left to draw from the soil."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我的背上，整片林子都亮了。", "en": "Lightning strikes my back; the whole grove lights up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有土，我扎不下去。", "en": "No soil; I cannot root."}
      ]
    }
  }
}
