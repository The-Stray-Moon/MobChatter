        {"zh": "这是你刚掉下的。", "en": "You dropped this."},
        {"zh": "这块肉已经馊了。", "en": "Useless."},
        {"zh": "把它好好收着。", "en": "Keep it safe."},
        {"zh": "这块碎片，值得我收起弓来捡。", "en": "This fragment is worth putting my bow down for."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
