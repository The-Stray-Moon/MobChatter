{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着长腿走。", "en": "I walk on long legs."},
        {"zh": "我站着有三格半高。", "en": "I stand three and a half blocks."},
        {"zh": "我沿着针叶林边走。", "en": "I walk the conifer forest's edge."},
        {"zh": "我迈过长腿，跨过倒木。", "en": "I stride over the fallen log on long legs."},
        {"zh": "我背着弓走路。", "en": "I walk with my bow on my back."},
        {"zh": "我慢慢地转向前方。", "en": "I slowly face forward."},
        {"zh": "我的步子很沉。", "en": "My steps are heavy."},
        {"zh": "我从下界荒地走过。", "en": "I cross the nether wastes."},
        {"zh": "我绕开了岩浆。", "en": "I go around the lava."},
        {"zh": "我在黑森林里慢慢走。", "en": "I move slowly through the dark forest."},
        {"zh": "我停下来看一眼。", "en": "I stop for a glance."},
        {"zh": "我又往前迈了一步。", "en": "I take another step."},
        {"zh": "我的脚踩碎了枯枝。", "en": "My foot snaps dead branches."},
        {"zh": "我沿着锚点附近巡。", "en": "I patrol near my anchor."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在那里不动。", "en": "I stand still."},
        {"zh": "我的弓挂在背上。", "en": "My bow hangs on my back."},
        {"zh": "我在看着远方。", "en": "I watch the distance."},
        {"zh": "我的金箭，搭在弦上了。", "en": "My gold arrow is nocked."},
        {"zh": "我是个完全体。", "en": "I'm an Ultimate."},
        {"zh": "我站着连羽毛都不动。", "en": "I'm doing nothing."},
        {"zh": "我抬眼扫了扫林梢。", "en": "I look up."},
        {"zh": "我摸了摸弓弦。", "en": "I touch the bowstring."},
        {"zh": "这里的空气很热。", "en": "The air is hot here."},
        {"zh": "我慢慢垂下眼。", "en": "I slowly lower my eyes."},
        {"zh": "我等一个目标。", "en": "I wait for a target."},
        {"zh": "我数着树林的层。", "en": "I count the forest layers."},
        {"zh": "我一向安静得很。", "en": "I'm very quiet."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的弓比你还高。", "en": "My bow is taller than you."},
        {"zh": "Gold-Arrow 需要瞄准很久。", "en": "Gold-Arrow takes a long aim."},
        {"zh": "你能挡住一箭吗？", "en": "Can you stop one arrow?"},
        {"zh": "我站得比你高得多。", "en": "I stand far above you."},
        {"zh": "你身上带着焦味。", "en": "You smell of fire."},
        {"zh": "我的力量在这个层级算强的。", "en": "My power is high for this level."},
        {"zh": "我的视线比我的箭还准。", "en": "My sight is truer than my arrow."},
        {"zh": "我在考虑要不要放。", "en": "I'm deciding whether to loose."},
        {"zh": "射手兽的蹄子踏在你影上。", "en": "Sagittarimon's hoof lands on your shadow."},
        {"zh": "我认得这种脚步。", "en": "I know that kind of footstep."},
        {"zh": "你都说完了吗？", "en": "Are you finished?"},
        {"zh": "你往箭程外面站。", "en": "Stand back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的羽毛被打散。", "en": "My feathers scattered."},
        {"zh": "我被箭势推了半步。", "en": "I gave half a step."},
        {"zh": "这一箭擦得我发麻。", "en": "That had weight."},
        {"zh": "我的弓还握在手里。", "en": "My bow is still in hand."},
        {"zh": "我把羽翼收拢稳住。", "en": "I held steady."},
        {"zh": "这样打不断我的瞄准。", "en": "That won't break my aim."},
        {"zh": "这个身位我记住了。", "en": "I remember where you are."},
        {"zh": "箭羽擦过，我晃了半步。", "en": "The fletching grazes me; I sway half a step."},
        {"zh": "你再开一弓试试。", "en": "Again."},
        {"zh": "别以为我只会射。", "en": "Don't think I only shoot."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这类东西不入我的口。", "en": "I don't eat that."},
        {"zh": "把它放低一点。", "en": "Lower it."},
        {"zh": "这实在小得可笑。", "en": "This is far too small."},
        {"zh": "那块肉太小，塞不住牙缝。", "en": "That meat is too small to fill a tooth gap."},
        {"zh": "你举着它也拦不住我。", "en": "Holding it up won't help."},
        {"zh": "太近了，我看不清。", "en": "Too close; I can't see it clearly."},
        {"zh": "把这块收进包里。", "en": "Put it away."},
        {"zh": "这玩意儿我用不着。", "en": "I don't need it."},
        {"zh": "这些还填不饱我。", "en": "Not enough."},
        {"zh": "这块肉你留着。", "en": "Keep it."},
        {"zh": "你走得远一些。", "en": "Go farther off."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你被弹了回去。", "en": "You bounced off."},
        {"zh": "我的体重压得住。", "en": "My weight holds."},
        {"zh": "别贴在我脚边。", "en": "Don't cling by my feet."},
        {"zh": "侧身让开半步，弓弦在响。", "en": "Half a step aside, bowstring humming."},
        {"zh": "这点撞劲碍不着我。", "en": "That impact is nothing."},
        {"zh": "你拦不住我的。", "en": "You can't stop me."},
        {"zh": "把林间的路让出来。", "en": "Move."},
        {"zh": "大个子走路，难免碰到你。", "en": "A big one walks, and bumping you is inevitable."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这个层级不谈这些。", "en": "Not at this level."},
        {"zh": "我还在巡这片地。", "en": "I'm still patrolling here."},
        {"zh": "巡完这片林，再说别的。", "en": "Let me finish patrolling this wood first."},
        {"zh": "这不是我的优先。", "en": "That isn't my priority."},
        {"zh": "这一段翻过去吧。", "en": "Later."},
        {"zh": "你快点走开去。", "en": "Move away."},
        {"zh": "我把心思放在巡场上。", "en": "My mind is on the patrol."},
        {"zh": "你别再往下问了。", "en": "Don't ask."},
        {"zh": "我对此毫无兴致。", "en": "I'm not interested."},
        {"zh": "你去别的地方。", "en": "Go elsewhere."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
