{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里摆成一条长线。", "en": "I stretch into a long line in the water."},
        {"zh": "我的身体有一栋房子那么长。", "en": "My body is as long as a house."},
        {"zh": "我的鳍在水里像刀。", "en": "My fins cut like blades in the water."},
        {"zh": "我贴着海床滑过。", "en": "I skim over the seabed."},
        {"zh": "我的头上有硬壳。", "en": "My head carries a hard shell."},
        {"zh": "我绕着珊瑚礁游。", "en": "I circle the reef."},
        {"zh": "深海的水很凉。", "en": "The deep water is cold."},
        {"zh": "我摆尾，水就翻起来。", "en": "A sweep of my tail turns the water."},
        {"zh": "我从鱼群边上穿过。", "en": "I pass through a school of fish."},
        {"zh": "我伏低身子往下潜。", "en": "I sink low into the depths."},
        {"zh": "水压一点都难不住我。", "en": "Pressure doesn't trouble me at all."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水里，尾巴慢慢摆。", "en": "I hang in the water, tail swaying."},
        {"zh": "远处的水在响。", "en": "Distant water sounds."},
        {"zh": "浮在海面，我晒着背鳍。", "en": "Floating at the surface, I sun my dorsal fin."},
        {"zh": "我呼出一串气泡。", "en": "I breathe out a string of bubbles."},
        {"zh": "我在等一条大鱼。", "en": "I'm waiting for a big fish."},
        {"zh": "我身上的鳍收了一点。", "en": "My fins fold in a little."},
        {"zh": "有一群鱼在绕我。", "en": "A shoal circles me."},
        {"zh": "我静得像个影子。", "en": "I'm quiet as a shadow."},
        {"zh": "我身上的壳有点凉。", "en": "The shell on my head is cool."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也到水里来了。", "en": "You came into the water too."},
        {"zh": "我比你长得多。", "en": "I'm much longer than you."},
        {"zh": "你的气泡一直在冒。", "en": "Your bubbles keep rising."},
        {"zh": "海水的腥味里，混着你的。", "en": "Your scent is mixed into the salt of the sea."},
        {"zh": "这片海域是我的。", "en": "This stretch of sea is mine."},
        {"zh": "我贴着水层靠近。", "en": "I close along the water layer."},
        {"zh": "你游不过我。", "en": "You can't outswim me."},
        {"zh": "海面下的长身，绕着你转。", "en": "My long body circles beneath the surface."},
        {"zh": "水压开始变重。", "en": "The pressure starts to build."},
        {"zh": "我从海面探出头来。", "en": "I raise my head out of the sea."},
        {"zh": "你只能往上。", "en": "You can only go up."},
        {"zh": "浪一退，我的头就探出来。", "en": "As the wave recedes, my head surfaces."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我沉了一截。", "en": "I sink a length."},
        {"zh": "我这条长身子，在海里绕三圈。", "en": "This long body coils three times in the sea."},
        {"zh": "海水被染浑，我沉下去。", "en": "The water clouds and I sink lower."},
        {"zh": "我一声也不发。", "en": "Not a sound from me."},
        {"zh": "水里有一点血的味。", "en": "There's a trace of blood."},
        {"zh": "我摆尾稳住。", "en": "I steady myself with my tail."},
        {"zh": "我的鳍收起来了。", "en": "My fins fold in."},
        {"zh": "这一下我忘不了。", "en": "I won't forget that."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "鱼味从上面来。", "en": "Fish smell from above."},
        {"zh": "让它沉到我这里。", "en": "Let it sink to me."},
        {"zh": "深海里的味道。", "en": "The taste of the deep."},
        {"zh": "这点实在太小。", "en": "This is really too small."},
        {"zh": "血腥顺着水来。", "en": "Blood comes in the current."},
        {"zh": "鱼味从水面飘下来。", "en": "Fish scent drifts down from the surface."},
        {"zh": "这个很新鲜。", "en": "This is very fresh."},
        {"zh": "海龙兽的嘴，别把手伸进来。", "en": "Seadramon's mouth. Keep your hand out."},
        {"zh": "我一整个吞了。", "en": "I swallowed it whole."},
        {"zh": "下面还有吗？", "en": "Any more below?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，滑的。", "en": "You hit me; I'm slick."},
        {"zh": "我一扭就绕开了。", "en": "One twist and I'm past."},
        {"zh": "你被水流推开。", "en": "The current pushes you aside."},
        {"zh": "撞到你的船，船身歪了。", "en": "I bump your boat and it tilts."},
        {"zh": "鳞片划过你的护甲。", "en": "My scales scrape your armour."},
        {"zh": "我们都沉了一点。", "en": "We both sink a little."},
        {"zh": "绕一圈，我的背鳍划开水面。", "en": "I circle back, my dorsal fin cutting the surface."},
        {"zh": "你还在这儿。", "en": "You're still here."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一条在礁石后面。", "en": "Another is behind the reef."},
        {"zh": "她身上的鳞比我亮。", "en": "Her scales shine more than mine."},
        {"zh": "我们把身体缠在一起。", "en": "We wind our bodies together."},
        {"zh": "水从我们之间流过去。", "en": "Water flows between us."},
        {"zh": "我们一起往深处沉。", "en": "We sink together into the deep."},
        {"zh": "她的鳍擦过我。", "en": "Her fin brushes mine."},
        {"zh": "海床上有我们的影子。", "en": "Our shadows lie on the seabed."},
        {"zh": "我们一起游了很久。", "en": "We swam together a long while."},
        {"zh": "是她先走的。", "en": "She left first."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它咬住。", "en": "I take it in my teeth."},
        {"zh": "这是块海底石。", "en": "A piece of seabed stone."},
        {"zh": "有东西在海底闪。", "en": "Something glints on the seabed."},
        {"zh": "我用吻部推它。", "en": "I nudge it with my snout."},
        {"zh": "它滚进石缝。", "en": "It rolls into a crevice."},
        {"zh": "我把它卷在尾上。", "en": "I curl it in my tail."},
        {"zh": "我接着游下去。", "en": "I swim on."},
        {"zh": "海里的东西，我一口吞下。", "en": "Sea things; I swallow them whole."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水流起来了。", "en": "The water has stirred."},
        {"zh": "我把长身转过来。", "en": "I swing my length around."},
        {"zh": "鳍像刀一样张开。", "en": "My fins open like blades."},
        {"zh": "我能闻出它的位置。", "en": "I can smell its position."},
        {"zh": "我张开了大嘴。", "en": "I open my jaws wide."},
        {"zh": "水压压着它。", "en": "The pressure bears on it."},
        {"zh": "它往上游去。", "en": "It's heading upward."},
        {"zh": "我跟着上浮。", "en": "I rise with it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着水流跟。", "en": "I follow the current."},
        {"zh": "我的身体比我需要的还长。", "en": "I'm longer than I need to be."},
        {"zh": "它撞到了礁石。", "en": "It hit the reef."},
        {"zh": "我从上边压过去。", "en": "I come over the top."},
        {"zh": "它的气泡暴露了它。", "en": "Its bubbles give it away."},
        {"zh": "海床那边有条沟。", "en": "There's a trench down there."},
        {"zh": "它往右边转了。", "en": "It turned right."},
        {"zh": "我又贴近了。", "en": "I drew closer."},
        {"zh": "它就停住了。", "en": "It came to a stop."},
        {"zh": "正是这一刻。", "en": "This is the moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一摆尾，水墙推过去。", "en": "I sweep my tail; a wall of water goes out."},
        {"zh": "它被卷得翻过来。", "en": "It's rolled over."},
        {"zh": "我的牙咬在它身上。", "en": "My teeth close on it."},
        {"zh": "我带着它往下沉。", "en": "I bear it down."},
        {"zh": "水流变成了一团乱。", "en": "The current becomes chaos."},
        {"zh": "利齿扣住船板，木头开裂。", "en": "My fangs clamp the hull and the wood splits."},
        {"zh": "我松了松牙。", "en": "I ease my grip."},
        {"zh": "它想游走开。", "en": "It tries to swim away."},
        {"zh": "我再咬下去。", "en": "I bite down again."},
        {"zh": "Ocean Storm 卷起，水墙压下。", "en": "Ocean Storm rises and a wall of water falls."},
        {"zh": "长尾一甩，掀翻整片浪。", "en": "One sweep of my long tail overturns the swell."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "海面上起了波纹。", "en": "Ripples spread on the surface."},
        {"zh": "我的头先破水。", "en": "My head breaks the water first."},
        {"zh": "这条海沟够我藏身。", "en": "The trench is deep enough to hide me."},
        {"zh": "我的身体还在下面。", "en": "My body is still below."},
        {"zh": "水声传得很远。", "en": "The sound travels far."},
        {"zh": "我把头掉过来。", "en": "I swing my head around."},
        {"zh": "我开始往那边游。", "en": "I start swimming that way."},
        {"zh": "鱼群让开了。", "en": "The fish part away."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水都烫了，我的鳞收紧了。", "en": "Even the water burns; my scales tighten."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔在干地上，扭了一下。", "en": "I hit dry ground and wrench myself."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "这里的水压不过我了。", "en": "The pressure here is wrong for me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响在水里推得我打转。", "en": "The blast spins me through the water."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "水流忽然不听了。", "en": "The current stops obeying me."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电顺着水过来，我全身僵住。", "en": "Current comes through the water; I lock up."}
      ]
    }
  }
}
