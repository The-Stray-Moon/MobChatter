{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在半空，慢慢飘", "en": "I float in the air, drifting slowly."},
        {"zh": "我的身体小小的，很轻", "en": "My body is small and light."},
        {"zh": "我朝你的方向飘过去", "en": "I drift toward where you are."},
        {"zh": "我绕着树转了一小圈", "en": "I circle a tree, once."},
        {"zh": "我的数据有点不稳", "en": "My data is a little unstable."},
        {"zh": "我上升一点，又落下", "en": "I lift a little, then settle."},
        {"zh": "我沿着草地飘着走", "en": "I drift along above the grass."},
        {"zh": "我的影子在地上一晃一晃", "en": "My shadow flickers on the ground."},
        {"zh": "我朝锚点的方向去", "en": "I head back toward my anchor."},
        {"zh": "我停在一朵花上面", "en": "I stop over a flower."},
        {"zh": "我又飘起来，往前", "en": "Then I lift and drift on."},
        {"zh": "我追着一片落叶", "en": "I chase a falling leaf."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在半空，晃来晃去", "en": "I hang in the air, swaying."},
        {"zh": "我的形状还没定下来", "en": "My shape isn't settled yet."},
        {"zh": "我在看自己的手", "en": "I'm looking at my hands."},
        {"zh": "我的一双手好小", "en": "My hands are so small."},
        {"zh": "锚点在下面，我离得近", "en": "My anchor is below; I'm close to it."},
        {"zh": "我听见风里有声音", "en": "I hear a sound in the wind."},
        {"zh": "我在空中慢慢转了个圈。", "en": "I turn a slow circle in the air."},
        {"zh": "我飘到一片叶子边上", "en": "I drift to the edge of a leaf."},
        {"zh": "我摸了一下，叶子动了", "en": "I touch it, and it moves."},
        {"zh": "我悬在锚点边上，轻轻笑。", "en": "I hover by the anchor and laugh softly."},
        {"zh": "我有一点困了", "en": "I'm a little sleepy."},
        {"zh": "我把身体缩成一团", "en": "I curl my body up."},
        {"zh": "数据在体表一闪一闪", "en": "Data flickers over my surface."},
        {"zh": "我又睁开了眼睛", "en": "I open my eyes again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你实在好大呀", "en": "You're so big."},
        {"zh": "我飘到你面前，抬头看", "en": "I drift before you and look up."},
        {"zh": "你是我要跟的主人吗？", "en": "Are you the master I should follow?"},
        {"zh": "我还没学会分辨", "en": "I haven't learned to tell yet."},
        {"zh": "一格的幼体，气泡先到。", "en": "A one-block baby, and the bubble comes first."},
        {"zh": "你的一双手好大", "en": "Your hands are huge."},
        {"zh": "我能坐在你肩上吗", "en": "May I sit on your shoulder?"},
        {"zh": "我累了，飘不太动", "en": "I'm tired; my drifting's weak."},
        {"zh": "我的泡泡飘近了一寸。", "en": "I float a little closer."},
        {"zh": "你要拍拍我吗", "en": "Will you pat me?"},
        {"zh": "我这么小，也不怕你。", "en": "Small as I am, I'm not scared."},
        {"zh": "你的衣服有草的味道", "en": "Your clothes smell of grass."},
        {"zh": "我打了个小哈欠，吐泡。", "en": "I yawn a little and blow a bubble."},
        {"zh": "我靠在你旁边浮着", "en": "I float beside you."},
        {"zh": "这样靠着很舒服", "en": "This is comfortable."},
        {"zh": "你不要走开呀", "en": "Please don't go away."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我晃得泡泡都散了。", "en": "I wobble until my bubbles pop."},
        {"zh": "我幼年期的身子，才巴掌大。", "en": "This baby body of mine is palm-sized."},
        {"zh": "我往下坠了一下", "en": "I drop for a moment."},
        {"zh": "我又飘起来了", "en": "Then I float up again."},
        {"zh": "我有一点点疼", "en": "It hurts a little."},
        {"zh": "缩成一团，别看清我。", "en": "Curled into a ball, do not look too closely."},
        {"zh": "我的数据在乱跳", "en": "My data jumps erratically."},
        {"zh": "我想躲在树后", "en": "I want to hide behind a tree."},
        {"zh": "我慢慢恢复了", "en": "I'm slowly recovering."},
        {"zh": "别再拍了，我快漏气了。", "en": "Stop swatting, I'm losing air."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你说那是什么呀", "en": "What's that?"},
        {"zh": "我飘过去，靠近闻", "en": "I drift over and sniff."},
        {"zh": "这个泡泡大的我能吃吗？", "en": "Can I eat one this big?"},
        {"zh": "我吐个泡泡，慢慢飘。", "en": "I blow a bubble and drift slowly."},
        {"zh": "我咬了一口，很小", "en": "I take a tiny bite."},
        {"zh": "再来一点点，好不好？", "en": "A little more, just a little."},
        {"zh": "你袋里还有别的吗？", "en": "Anything else in that bag?"},
        {"zh": "我在你手边转", "en": "I circle by your hand."},
        {"zh": "你给我的我都收下", "en": "Whatever you give, I'll take."},
        {"zh": "我吃得慢，别收走。", "en": "I eat slowly; don't take it away."},
        {"zh": "这不够填肚子", "en": "This isn't enough."},
        {"zh": "幼年期Ⅱ的我，只会吐泡泡。", "en": "A Baby II stage, good only for bubbles."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得翻了个跟斗。", "en": "The hit sent me rolling."},
        {"zh": "我又飘起来，没事", "en": "I float up again. Fine."},
        {"zh": "你的影子盖住我整个身子。", "en": "You're far bigger than me."},
        {"zh": "我撞在你手上，弹开", "en": "I bump your hand and bounce off."},
        {"zh": "我有点晕头转向", "en": "I'm a little dizzy."},
        {"zh": "我抓不住你的袖子", "en": "I can't get a grip on your sleeve."},
        {"zh": "我从你脚边飘过去", "en": "I drift past your feet."},
        {"zh": "我的身体晃了晃", "en": "My body wobbles."},
        {"zh": "我打转，慢慢稳住。", "en": "I spin, then slowly steady."},
        {"zh": "你别推我好不好", "en": "Don't push me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "成长期的事我还不懂。", "en": "I don't really get this yet."},
        {"zh": "你是我的朋友吗", "en": "Are you my friend?"},
        {"zh": "我跟着你飞就好", "en": "I'll just fly along with you."},
        {"zh": "你走慢一点，我飘不快", "en": "Go slower; I can't drift fast."},
        {"zh": "我们一起守着锚点。", "en": "We guard the anchor together."},
        {"zh": "我睡在你旁边", "en": "I'll sleep beside you."},
        {"zh": "你不要丢下我", "en": "Don't leave me behind."},
        {"zh": "我总有一天会长大", "en": "I'll grow up."},
        {"zh": "到时候我保护你", "en": "Then I'll protect you."},
        {"zh": "你说这样好不好", "en": "Will that be all right?"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一把抱住了它", "en": "I hug it to myself."},
        {"zh": "好重，我抱不动", "en": "So heavy. I can't lift it."},
        {"zh": "它从我手上滑掉了", "en": "It slips out of my hands."},
        {"zh": "我用头顶着它飘。", "en": "I balance it on my head as I float."},
        {"zh": "这个我可以带走", "en": "I can carry this."},
        {"zh": "沙上掉的，我叼起来。", "en": "Dropped on the ground? I'll take it."},
        {"zh": "我数一数有几颗", "en": "I count how many there are."},
        {"zh": "这一颗就给你", "en": "This one's for you."},
        {"zh": "我把它藏起来了", "en": "I've hidden it."},
        {"zh": "你别告诉别人", "en": "Don't tell anyone."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在半空，朝那边的动静飘。", "en": "I float in the air, drifting toward that movement."},
        {"zh": "我飘高一点看", "en": "I float up to see."},
        {"zh": "我不太确定那是什么", "en": "I'm not sure what that is."},
        {"zh": "幼年期的小泡泡，朝那边去。", "en": "A baby-stage bubble drifts that way."},
        {"zh": "我这团小身子，正在长大。", "en": "This little body of mine is growing."},
        {"zh": "我吐的泡泡没什么力气。", "en": "The bubbles I spit have little force."},
        {"zh": "可是我没有后退", "en": "But I haven't backed off."},
        {"zh": "我悬在你头顶打转。", "en": "I hover above your head."},
        {"zh": "它朝我飘得越来越近。", "en": "It drifts closer and closer."},
        {"zh": "我已经准备好了，Bubble 在嘴里。", "en": "I am ready; Bubble is in my mouth."},
        {"zh": "不对，我还没准备好", "en": "No — I'm not ready."},
        {"zh": "可它已经来了", "en": "But it's already here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我围着它打转", "en": "I circle it."},
        {"zh": "它的眼睛跟着我", "en": "Its eyes follow me."},
        {"zh": "我飘得高一点", "en": "I drift a little higher."},
        {"zh": "它够不到我了", "en": "It can't reach me now."},
        {"zh": "我在它头顶上", "en": "I'm above its head."},
        {"zh": "我慢慢地下降", "en": "I descend slowly."},
        {"zh": "它的手抬起来了", "en": "Its hand is rising."},
        {"zh": "我往后面飘开", "en": "I drift backward."},
        {"zh": "再往上飞一点", "en": "A little higher."},
        {"zh": "躲在你后面比较安全。", "en": "Hiding behind you feels safer."},
        {"zh": "我等着一个空隙", "en": "I wait for a gap."},
        {"zh": "就是现在，开始", "en": "Now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我吐出一个气泡", "en": "I spit out a bubble."},
        {"zh": "这是我的 Bubble", "en": "This is my Bubble."},
        {"zh": "气泡撞在它身上破了", "en": "The bubble hits it and bursts."},
        {"zh": "它退了半步回去", "en": "It takes half a step back."},
        {"zh": "我又吐出第二个", "en": "I spit a second one."},
        {"zh": "这一个撞偏了", "en": "That one went wide."},
        {"zh": "我飘到它后面", "en": "I drift behind it."},
        {"zh": "我再吐一个气泡", "en": "I spit again."},
        {"zh": "它转过来，我上升", "en": "It turns; I rise."},
        {"zh": "我喘得有点急", "en": "I'm a little out of breath."},
        {"zh": "我的身体更亮了", "en": "My body has grown brighter."},
        {"zh": "我还要再试试", "en": "I'll try again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从一团数据里出来", "en": "I come out of a swirl of data."},
        {"zh": "我晃了晃，落在地上", "en": "I wobble and settle to the ground."},
        {"zh": "我又浮了起来", "en": "Then I float up again."},
        {"zh": "这个地方好大", "en": "This place is so big."},
        {"zh": "到处都是绿色的", "en": "Green everywhere."},
        {"zh": "我转了一圈看", "en": "I turn a full circle to look."},
        {"zh": "锚点在我下面", "en": "My anchor is below me."},
        {"zh": "我知道该待在哪", "en": "I know where to stay."},
        {"zh": "可我想四处看看", "en": "But I want to look around."},
        {"zh": "我先飘到那棵树下", "en": "I'll drift to that tree first."},
        {"zh": "有风，很舒服", "en": "There's wind. It feels good."},
        {"zh": "我开始飘起来了", "en": "I start to drift."}
      ]
    },
