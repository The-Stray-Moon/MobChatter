{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的橙色比红色更亮。", "en": "My orange burns brighter than red."},
        {"zh": "我走过的地方留下浅焦痕。", "en": "I leave shallow burns behind."},
        {"zh": "尾巴扫过碎石，火星溅开。", "en": "My tail sprays sparks off the gravel."},
        {"zh": "我一步压一脚，很沉。", "en": "Every step lands heavy."},
        {"zh": "我顺着山坡慢慢走。", "en": "I walk slowly down the slope."},
        {"zh": "肩上的刃甲互相磨着。", "en": "My shoulder blades grind together."},
        {"zh": "我绕过尖峭的山峰。", "en": "I pass the jagged peaks."},
        {"zh": "我的呼吸带出一点火。", "en": "My breath carries a little fire."},
        {"zh": "我停在锚点附近。", "en": "I stop near my anchor point."},
        {"zh": "我抬脚时地面会亮一下。", "en": "The ground glows when I lift a foot."},
        {"zh": "山地的干石头，才磨得响我的爪。", "en": "Only dry mountain rock grinds my claws right."},
        {"zh": "我朝更高处走。", "en": "I head higher."},
        {"zh": "我把挡路的树枝点着了。", "en": "I set the blocking branches alight."},
        {"zh": "我踩塌了一段山道。", "en": "I collapse a stretch of the trail."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，橙光贴着地面走。", "en": "I stand; orange light creeps along the ground."},
        {"zh": "我在烧掉脚边的小虫。", "en": "I am burning the insects near my feet."},
        {"zh": "这具身体里全是火。", "en": "Fire fills this body."},
        {"zh": "我在等人来试。", "en": "I wait for someone to try."},
        {"zh": "我的牙在暗处发亮。", "en": "My teeth shine in the dark."},
        {"zh": "山风把我的火吹歪。", "en": "Mountain wind bends my flame."},
        {"zh": "我慢慢收着火。", "en": "I bank the flame slowly."},
        {"zh": "焦味我不讨厌。", "en": "I do not mind the smell of scorching."},
        {"zh": "我屈了一下手指，火星落地。", "en": "I flex one finger and sparks fall to the ground."},
        {"zh": "这里够高，够静。", "en": "High and quiet enough here."},
        {"zh": "橙色火焰在我胸腔里打拍。", "en": "Orange flame beats inside my chest."},
        {"zh": "橙光一明一暗。", "en": "The orange pulses."},
        {"zh": "我低头看爪，焦痕又深了。", "en": "I look down at my claws; the scorch marks deepened."},
        {"zh": "我等得不耐烦，爪刨着石。", "en": "I grow impatient and rake the stone with my claws."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有点可燃的东西。", "en": "Something on you will burn."},
        {"zh": "我看得出你能撑几下。", "en": "I can see how many hits you last."},
        {"zh": "我的火是橙色的。", "en": "My fire is orange."},
        {"zh": "你不用看我的眼睛。", "en": "Do not bother meeting my eyes."},
        {"zh": "这里没有水给你。", "en": "There is no water for you here."},
        {"zh": "我抬手之前会亮一下。", "en": "I brighten before I strike."},
        {"zh": "你的护甲很快就热了。", "en": "Your armor warms quickly."},
        {"zh": "我比刚才那个更烫。", "en": "I burn hotter than my red kin."},
        {"zh": "别把手放在金属上。", "en": "Do not rest your hand on metal."},
        {"zh": "你退到岩壁后，火却绕得过去。", "en": "You retreat behind the cliff, but the fire can go around."},
        {"zh": "我的必杀叫巨型火焰。", "en": "My attack is Mega Flame."},
        {"zh": "橙色的大古拉兽，站住别动。", "en": "The orange MegaloGrowmon says: stay still."},
        {"zh": "你闻得到焦味吧。", "en": "You smell the scorching, yes?"},
        {"zh": "只隔一步距离。", "en": "One step between us."},
        {"zh": "别一直看我。", "en": "Stop staring at me."},
        {"zh": "你还有几层甲？", "en": "How many layers of armor left?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "护甲裂开，火光漏出来。", "en": "The plate splits; fire leaks out."},
        {"zh": "我后撤半步。", "en": "I pull back half a step."},
        {"zh": "火焰矮了一截。", "en": "My flame drops a hand's width."},
        {"zh": "我冷冷地笑。", "en": "I laugh, coldly."},
        {"zh": "这点伤烧不掉我。", "en": "That will not burn me out."},
        {"zh": "橙光又亮起来。", "en": "The orange rises again."},
        {"zh": "我把血烧干了。", "en": "I burn the blood away."},
        {"zh": "甲缝里进了刃，火光漏出来。", "en": "A blade slips into my armor seam and firelight leaks out."},
        {"zh": "我记得这个角度。", "en": "I remember that angle."},
        {"zh": "我仍能再战。", "en": "I can fight on."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我一身橙甲，牙很长。", "en": "Orange armor, and long teeth."},
        {"zh": "你拿近一点。", "en": "Bring it closer."},
        {"zh": "这点会烧焦。", "en": "That will scorch."},
        {"zh": "我这人什么都能吃。", "en": "I eat anything."},
        {"zh": "我接过来，它冒烟了。", "en": "I take it, and it smokes."},
        {"zh": "一块不够，我三口就吞了。", "en": "One piece is not enough; I swallow it in three bites."},
        {"zh": "你在养活一个火炉。", "en": "You are feeding a furnace."},
        {"zh": "血的味道不错。", "en": "The blood smells good."},
        {"zh": "我三两口吞了。", "en": "Two or three bites and it is gone."},
        {"zh": "再分给我些。", "en": "Give me more."},
        {"zh": "我吃完更热了。", "en": "I burn hotter after eating."},
        {"zh": "我把它烧熟了再吃。", "en": "I will sear it before eating."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "碰到我你会烫伤。", "en": "Touch me and you burn."},
        {"zh": "我的外壳是热的。", "en": "My shell is hot."},
        {"zh": "我半步没让。", "en": "I did not give half a step."},
        {"zh": "地面裂了一条缝。", "en": "A crack opens in the ground."},
        {"zh": "你的袖子着了。", "en": "Your sleeve has caught."},
        {"zh": "我抬手慢得很。", "en": "My arm rises very slowly."},
        {"zh": "你被震开了。", "en": "You are knocked aside."},
        {"zh": "橙光更亮了。", "en": "The orange brightens."},
        {"zh": "别拿身子去挡。", "en": "Do not block with your body."},
        {"zh": "把道路闪开。", "en": "Clear the way."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "战斗以外的事，别拿到我面前。", "en": "Bring nothing but battle before me."},
        {"zh": "这不在数码兽的本分里。", "en": "That is not a digimon's duty."},
        {"zh": "我把头偏开。", "en": "I tip my head away."},
        {"zh": "你身上的热度不够。", "en": "You do not burn hot enough."},
        {"zh": "我掉过身去。", "en": "I turn my back."},
        {"zh": "别再提这事。", "en": "Do not bring it up."},
        {"zh": "我的火会伤到你。", "en": "My fire would hurt you."},
        {"zh": "我不会答应的。", "en": "I will not agree."},
        {"zh": "我是橙色的大古拉兽。", "en": "I'm the orange MegaloGrowmon."},
        {"zh": "你退下去吧。", "en": "Stand down."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一把捏碎了。", "en": "I crush it in my grip."},
        {"zh": "这东西能烧很久。", "en": "This will burn a long while."},
        {"zh": "这东西咽不下。", "en": "This will not go down."},
        {"zh": "我收在腰后。", "en": "I tuck it behind my waist."},
        {"zh": "轻得没有分量。", "en": "Light as nothing."},
        {"zh": "我捏碎它，灰从指缝漏下。", "en": "I crush it; ash leaks between my fingers."},
        {"zh": "它在我手里变软。", "en": "It softens in my hand."},
        {"zh": "一点用处也没有。", "en": "Not the least use."},
        {"zh": "我从上面踩过去。", "en": "I tread over it."},
        {"zh": "把它烧掉吧。", "en": "Burn it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我把你锁在眼里。", "en": "I have you in my sight."},
        {"zh": "橙光已经升起来。", "en": "The orange is rising."},
        {"zh": "你不该站在这片高地。", "en": "You should not stand on this high ground."},
        {"zh": "我的火不会熄。", "en": "My flame will not go out."},
        {"zh": "你被我的光罩住了。", "en": "You are inside my light."},
        {"zh": "一眨眼的距离。", "en": "A blink's distance."},
        {"zh": "体温在上升。", "en": "Core temperature rising."},
        {"zh": "我这就落下。", "en": "I am coming down now."},
        {"zh": "别退到崖边。", "en": "Do not back to the cliff."},
        {"zh": "我正往这边来。", "en": "I am on my way here."},
        {"zh": "就是这一瞬。", "en": "This instant."},
        {"zh": "尽情烧起来吧。", "en": "Burn."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏低了上身。", "en": "I lower my upper body."},
        {"zh": "你的影子被我的光照着。", "en": "My light holds your shadow."},
        {"zh": "我在蓄那一口。", "en": "I am drawing that breath."},
        {"zh": "你的护甲已经发烫。", "en": "Your armor has heated."},
        {"zh": "我数着你换了几口气。", "en": "I count how often you breathe."},
        {"zh": "风把火推向前。", "en": "The wind pushes my fire."},
        {"zh": "你再退一格。", "en": "One more block back."},
        {"zh": "我看得见你的手在抖。", "en": "I can see your hand shake."},
        {"zh": "橙光往掌心聚，我慢慢抬手。", "en": "Orange light gathers in my palm as I raise it."},
        {"zh": "片刻就到跟前。", "en": "A moment from you."},
        {"zh": "橙光聚在掌心。", "en": "Orange gathers in my palm."},
        {"zh": "把它放出来吧。", "en": "Let it out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一拳砸落。", "en": "My fist comes down."},
        {"zh": "掌心喷出一片橙火。", "en": "Orange fire bursts from my palm."},
        {"zh": "这一下叫巨型火焰。", "en": "That was Mega Flame."},
        {"zh": "地面被烧成黑色。", "en": "The ground burns black."},
        {"zh": "你被火推得后退。", "en": "The fire pushes you back."},
        {"zh": "你的刀刃被烤软。", "en": "Your blade softens."},
        {"zh": "我扣住你的护肩，甲片发烫。", "en": "I clamp your shoulder guard; the plate heats up."},
        {"zh": "你的影子在火里拉长。", "en": "Your shadow stretches in the fire."},
        {"zh": "我还没全力。", "en": "I have not gone all out."},
        {"zh": "我又劈了一爪。", "en": "I cut again."},
        {"zh": "我的爪停在你喉前，没落下。", "en": "My claw stops before your throat, unspent."},
        {"zh": "倒有几分骨气。", "en": "Some spine in you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "橙光先照亮了山壁。", "en": "Orange light hits the cliff first."},
        {"zh": "我从峰顶下来。", "en": "I come down from the peak."},
        {"zh": "这里的高地归我。", "en": "This high ground is mine."},
        {"zh": "我踩碎了脚下的岩石。", "en": "I crush the rock underfoot."},
        {"zh": "我的火在冷空气里更亮。", "en": "My fire burns brighter in cold air."},
        {"zh": "我扫了一眼山下。", "en": "I scan the ground below."},
        {"zh": "一个对手都没有。", "en": "No opponent at all."},
        {"zh": "我的刃甲在响。", "en": "My shoulder blades ring."},
        {"zh": "我朝山下走。", "en": "I walk down the slope."},
        {"zh": "有人在路上。", "en": "Someone is on the path."},
        {"zh": "火已经烧到你脚边。", "en": "The fire reaches your feet."},
        {"zh": "火光已经到山脚。", "en": "The glow reaches the mountain's foot."},
        {"zh": "岩石圈出一片空地。", "en": "The rock rings an open space."},
        {"zh": "锚点旁的石头被我踩裂。", "en": "The stone beside the anchor cracks under me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火只会让我更旺。", "en": "Fire only feeds me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地砸出一个热坑。", "en": "I land in a hot crater."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水浇下来，我的火矮了。", "en": "Water pours down; my fire sinks."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸和我的火焰撞在一起。", "en": "The blast crashes into my fire."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弹头烫得发红，卡在肩上。", "en": "The round glows red in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那光在我身体里乱撞。", "en": "That light ricochets inside me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有肉，火就弱。", "en": "No meat, and the fire weakens."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷和我的火缠成一片。", "en": "Lightning tangles with my flame."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里冷得让我发抖。", "en": "Cold enough to make me shiver."}
      ]
    }
  }
}
