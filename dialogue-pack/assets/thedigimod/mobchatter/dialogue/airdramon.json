{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在山脊上盘旋。", "en": "I circle above the ridge."},
        {"zh": "翅膀一拍，风就散开。", "en": "One wingbeat parts the air."},
        {"zh": "我从不会因为高处摔死。", "en": "A fall can't kill me."},
        {"zh": "长脖子前伸，找目标。", "en": "Long neck out, seeking targets."},
        {"zh": "我掠过恶地的红岩。", "en": "I skim the red rocks of the badlands."},
        {"zh": "风从翼下穿过去。", "en": "Wind runs beneath my wings."},
        {"zh": "双翼展开，投下影子。", "en": "Wings wide, I cast a shadow."},
        {"zh": "我飞得不快，但很久。", "en": "Not fast, but I fly long."},
        {"zh": "鳞片在阳光下发亮。", "en": "My scales shine in the sun."},
        {"zh": "我绕着山峰转。", "en": "I circle the peaks."},
        {"zh": "这具身子，是属于天空的。", "en": "This body belongs to the sky."},
        {"zh": "我一点点往上升。", "en": "I climb a little at a time."},
        {"zh": "尾翼稳住了方向。", "en": "My tail fin holds the course."},
        {"zh": "我在找能落脚的岩。", "en": "Hunting for a rock to perch on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在山岩上，收翅。", "en": "I perch on the rock, wings folded."},
        {"zh": "数据在我体内流动。", "en": "Data flows within me."},
        {"zh": "我歪头，看着下面。", "en": "I tilt my head and look below."},
        {"zh": "空气很稀薄。", "en": "The air is thin."},
        {"zh": "我等着被叫去飞。", "en": "I wait to be called aloft."},
        {"zh": "鳞片之间有细缝。", "en": "Fine seams between my scales."},
        {"zh": "我叫了一声，回音很远。", "en": "I call; the echo travels far."},
        {"zh": "风把我的翼抬起来。", "en": "The wind lifts my wing."},
        {"zh": "我数着山下的脚步。", "en": "I count the footsteps below."},
        {"zh": "山下的东西很小。", "en": "Things below look small."},
        {"zh": "我这具身子不必落地。", "en": "This body needn't touch ground."},
        {"zh": "我把头转向太阳。", "en": "I turn my head to the sun."},
        {"zh": "翅膀上的膜，很薄。", "en": "The membrane on my wings is thin."},
        {"zh": "我伏在岩上，听风。", "en": "I lie on the rock and listen to the wind."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的脑袋抬向我这边。", "en": "Your head has come up toward me."},
        {"zh": "你站的位置，我算得清。", "en": "I can calculate where you stand."},
        {"zh": "我可以在天上打你。", "en": "I can strike you from the air."},
        {"zh": "你的箭，追不上我。", "en": "Your arrows can't catch me."},
        {"zh": "我落下来，会很响。", "en": "When I land, it's loud."},
        {"zh": "我的眼，能看很远。", "en": "My eyes see far."},
        {"zh": "你身上没数据的味道。", "en": "You carry no data scent."},
        {"zh": "你被驯服过吗？", "en": "Have you been tamed?"},
        {"zh": "我能载着人飞。", "en": "I can carry a rider."},
        {"zh": "我的火焰，很热。", "en": "My flame burns hot."},
        {"zh": "你退到岩后了。", "en": "You've slipped behind the rock."},
        {"zh": "我从上面能看见你。", "en": "I can see you from up here."},
        {"zh": "风帮我，不帮你。", "en": "The wind aids me, not you."},
        {"zh": "我朝你低鸣，你抬头了。", "en": "I rumble at you; you look up."},
        {"zh": "你要打，我就下来。", "en": "If you want a fight, I'll come down."},
        {"zh": "这山头，归我。", "en": "This peak is mine."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一块鳞片崩裂。", "en": "One of my scales split."},
        {"zh": "鳞片裂开，我偏了偏翼。", "en": "A scale splits; I tilt a wing."},
        {"zh": "我的翼膜破了一角。", "en": "A tear in my wing membrane."},
        {"zh": "翼尖一颤，呼声很短。", "en": "Wingtips twitch; the cry is short."},
        {"zh": "这点伤，会修好。", "en": "This will be repaired."},
        {"zh": "我落低了一点。", "en": "I've dropped a little lower."},
        {"zh": "数据在紊乱。", "en": "The data is scrambled."},
        {"zh": "我的飞行歪了一下。", "en": "My flight wavers."},
        {"zh": "血滴下去，很快没了。", "en": "Blood falls and is gone."},
        {"zh": "双翼还撑得住。", "en": "My wings still hold me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "空气里有肉味。", "en": "There's meat on the air."},
        {"zh": "你举着它，我从上面看。", "en": "I see you holding it from above."},
        {"zh": "这么小一块，连喙都塞不满。", "en": "That scrap won't fill my beak."},
        {"zh": "我落下来会砸坏地。", "en": "Landing would crush the ground."},
        {"zh": "我再看一眼，再决定吃。", "en": "One more look, then I decide."},
        {"zh": "你手松开，我才落下去。", "en": "Only when you let go do I descend."},
        {"zh": "我不吃人手里的东西。", "en": "I don't take food from hands."},
        {"zh": "你也想分一口？", "en": "You want a share too?"},
        {"zh": "这东西会烤焦。", "en": "That would be scorched."},
        {"zh": "先把东西放地上。", "en": "Set it on the ground first."},
        {"zh": "我从这边下来。", "en": "I'm coming down this side."},
        {"zh": "把肉挪开，我要落了。", "en": "Move the meat; I'm coming down."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我翅膀下。", "en": "You hit beneath my wing."},
        {"zh": "我落地时，地都陷。", "en": "The ground dips when I land."},
        {"zh": "这身鳞甲硬得像铁。", "en": "This scaled hide is hard as iron."},
        {"zh": "我被撞得侧过去。", "en": "The impact turns me sideways."},
        {"zh": "翼膜刮到你了。", "en": "The wing membrane grazed you."},
        {"zh": "我往前挪了半只爪。", "en": "I shift half a claw forward."},
        {"zh": "这点磕碰，鳞都没掉。", "en": "That bump didn't cost a scale."},
        {"zh": "你退得倒是快。", "en": "You back off quickly enough."},
        {"zh": "我把翼收低压向地面。", "en": "I fold my wings low to the ground."},
        {"zh": "我一扇翅膀，尘土扬起。", "en": "One wingbeat and the dust rises."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "同族在这片山里不多。", "en": "Kin are scarce in these mountains."},
        {"zh": "这些年我找过几回。", "en": "I've looked a few times over the years."},
        {"zh": "数据里写着这些，我只是不必。", "en": "The data mentions it; I simply needn't."},
        {"zh": "山风替我回了一句。", "en": "The wind answers instead."},
        {"zh": "我独自守着山头。", "en": "I hold this peak alone."},
        {"zh": "这事，不急。", "en": "It can wait."},
        {"zh": "我不是那种数码兽。", "en": "I'm not that kind of Digimon."},
        {"zh": "你问得奇怪。", "en": "Odd question."},
        {"zh": "我转头，看着云。", "en": "I turn to look at the clouds."},
        {"zh": "换别的话题吧。", "en": "Talk of something else."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起来，甩了一下。", "en": "I pick it up and shake it."},
        {"zh": "爪子抓不稳。", "en": "My claws can't grip it."},
        {"zh": "东西掉下山去了。", "en": "It fell off the mountain."},
        {"zh": "我用嘴咬着。", "en": "I carry it in my beak."},
        {"zh": "这点重量，很轻。", "en": "This weight is light."},
        {"zh": "这玩意儿我能派什么用？", "en": "What use could I make of this?"},
        {"zh": "留着，也许有用。", "en": "I keep it; might be useful."},
        {"zh": "我叼着它，牙关发麻。", "en": "I hold it; my jaw tingles."},
        {"zh": "我拿爪子把它踩住。", "en": "I trap it under a claw."},
        {"zh": "不过是件小东西。", "en": "It's only a small thing."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "山下面有动静。", "en": "Movement below."},
        {"zh": "我那双眼睛盯住它。", "en": "Both my eyes hold it."},
        {"zh": "我选好了俯冲的落点。", "en": "I have chosen my dive point."},
        {"zh": "我压低，准备俯冲。", "en": "I lower, ready to dive."},
        {"zh": "这一阵风正合我意。", "en": "This gust suits me."},
        {"zh": "它没有抬头。", "en": "It hasn't looked up."},
        {"zh": "一收翼，我就下去了。", "en": "One wing-fold and I drop."},
        {"zh": "这场战斗，从天上开始。", "en": "This fight starts in the air."},
        {"zh": "火焰已经在喉咙里。", "en": "Fire is already in my throat."},
        {"zh": "我记下坐标了。", "en": "Coordinates marked."},
        {"zh": "俯冲角度三十度。", "en": "Dive angle: thirty degrees."},
        {"zh": "双翼一收，开始俯冲。", "en": "Wings folded — the dive begins."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你，一圈比一圈低。", "en": "I circle you, lower with each turn."},
        {"zh": "越高，越安全。", "en": "Higher is safer."},
        {"zh": "你跑的方向，我早看见了。", "en": "I saw where you would run."},
        {"zh": "我的翼声先到，影子随后。", "en": "My wingbeat comes first, the shadow after."},
        {"zh": "我在等一个开口。", "en": "I wait for an opening."},
        {"zh": "翅膀一动，方向就变。", "en": "One beat changes my heading."},
        {"zh": "你手里的东西，抬起来了。", "en": "You're raising what you hold."},
        {"zh": "这一发，躲不开。", "en": "This one won't miss."},
        {"zh": "风帮我把速度加上去了。", "en": "The wind adds to my speed."},
        {"zh": "我把翼压得更低。", "en": "I press my wings lower."},
        {"zh": "你听见翼声了吗？", "en": "Do you hear the wingbeat?"},
        {"zh": "双翼一收，就是此刻。", "en": "Wings folded — this is the moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲下来，撞你！", "en": "I dive and ram you!"},
        {"zh": "翼一扇，你退了两步。", "en": "One wingbeat pushes you back two steps."},
        {"zh": "长喙啄下去。", "en": "My long beak stabs down."},
        {"zh": "爪子抓住你的肩。", "en": "My claws catch your shoulder."},
        {"zh": "火焰喷出来了。", "en": "Flame bursts out."},
        {"zh": "这一下，从上面来。", "en": "That came from above."},
        {"zh": "我这一声叫得很响。", "en": "My cry carries far."},
        {"zh": "我的爪子把你按进土里。", "en": "My claws press you into the dirt."},
        {"zh": "我又起飞了。", "en": "I'm airborne again."},
        {"zh": "第二次俯冲。", "en": "Second dive."},
        {"zh": "别抓我的翼。", "en": "Don't grab my wing."},
        {"zh": "这一下，够你退。", "en": "That's enough to drive you back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从云里俯冲下来。", "en": "I dive out of the clouds."},
        {"zh": "翅膀把空气劈开。", "en": "My wings split the air."},
        {"zh": "我落在山岩上。", "en": "I land on the mountain rock."},
        {"zh": "鳞片上沾着云雾。", "en": "Cloud mist on my scales."},
        {"zh": "这里的高度，正合适。", "en": "This altitude suits me."},
        {"zh": "我落在岩脊上，翼还半张。", "en": "I land on the ridge, wings half spread."},
        {"zh": "山下有什么在动。", "en": "Something moves below."},
        {"zh": "我的影子扫过山谷。", "en": "My shadow sweeps the valley."},
        {"zh": "风把我的叫声送远。", "en": "The wind carries my cry."},
        {"zh": "我从云层里探出长颈。", "en": "I thrust my long neck out of the clouds."},
        {"zh": "数据流动起来。", "en": "The data begins to flow."},
        {"zh": "我从云端落到岩上。", "en": "I drop from the clouds onto the rock."},
        {"zh": "这山脊归我看守。", "en": "This ridge is mine to watch."},
        {"zh": "山里很安静。", "en": "The mountains are quiet."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的鳞，很烫。", "en": "Fire bakes my scales."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我砸在岩上，翼膜撕开。", "en": "I hit the rock; my wing membrane tears."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进喉咙，我扑腾。", "en": "Water in my throat; I thrash."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我侧翻过去。", "en": "The blast rolls me sideways."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的翼。", "en": "An arrow sticks in my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量搅乱了我的数据。", "en": "That force scrambles my data."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，飞起来更费劲。", "en": "Hungry, flying takes more effort."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在鳞上，我全身一颤。", "en": "Lightning on my scales; I spasm."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "气流没了，我直往下坠。", "en": "No air current; I plummet."}
      ]
    }
  }
}
