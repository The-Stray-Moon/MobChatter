{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一弹一弹地往前蹭。", "en": "I scoot forward in little bounces."},
        {"zh": "我还没有腿，只能弹", "en": "I have no legs; I can only bounce."},
        {"zh": "我的耳朵比我身体还长", "en": "My ears are longer than my body."},
        {"zh": "我弹过去，弹回来", "en": "I bounce over and bounce back."},
        {"zh": "草地软，弹得高", "en": "Soft grass; I bounce higher."},
        {"zh": "我跟着一个大家伙后头弹。", "en": "I bounce along behind a big one."},
        {"zh": "身体就一格不到，很轻", "en": "Under a block; very light."},
        {"zh": "我弹一下，露一次牙", "en": "One bounce and my teeth show."},
        {"zh": "我弹到石头边就停", "en": "I stop at the stone's edge."},
        {"zh": "腿还没长出来，我只能弹。", "en": "No legs yet, so bouncing is all I've got."},
        {"zh": "我一边弹一边看", "en": "I look around as I bounce."},
        {"zh": "林子里我弹得不快", "en": "In the wood I don't bounce fast."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，耳朵垂下来", "en": "I sit with my ears drooping."},
        {"zh": "我张着嘴，等吃的", "en": "Mouth open, I wait for food."},
        {"zh": "我只是一团粉色的东西", "en": "I'm just a pink lump."},
        {"zh": "我在看比我大的", "en": "I'm watching the bigger ones."},
        {"zh": "我弹了一下，又坐下", "en": "I bounced once and sat down."},
        {"zh": "风把我吹歪了", "en": "The wind tipped me over."},
        {"zh": "嘴里才冒出两颗小牙。", "en": "Only two little teeth have come in."},
        {"zh": "我在地上闻来闻去", "en": "I sniff around the ground."},
        {"zh": "我在听有人叫我", "en": "I'm listening for someone calling."},
        {"zh": "我什么都还不会", "en": "There's so much I can't do yet."},
        {"zh": "耳朵一晃，我甩掉草屑。", "en": "A shake of my ears flicks off the grass bits."},
        {"zh": "这里的草又软又暖。", "en": "The grass here is soft and warm."},
        {"zh": "我肚子饿得慌", "en": "I'm hungry."},
        {"zh": "有个大的在看我", "en": "One of the big ones is watching me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你个头真大啊", "en": "You're so big."},
        {"zh": "你是来喂我的吗", "en": "Are you here to feed me?"},
        {"zh": "我名字叫滚球兽", "en": "I'm Koromon."},
        {"zh": "我还小，别吓我", "en": "I'm little; don't scare me."},
        {"zh": "你蹲下来，我看不清", "en": "Crouch down; I can't see well."},
        {"zh": "我咬了也不疼", "en": "My bite doesn't hurt."},
        {"zh": "我弹得很高，你看", "en": "I can bounce high, look."},
        {"zh": "你要把我带到林子里去吗。", "en": "Are you taking me into the woods?"},
        {"zh": "我的耳朵很软", "en": "My ears are soft."},
        {"zh": "你别踩到我了", "en": "Don't step on me."},
        {"zh": "你的味道我好像在哪儿闻过。", "en": "I think I've smelled you somewhere before."},
        {"zh": "我们同类里我最小", "en": "I'm the smallest of my kind."},
        {"zh": "你会保护我吗", "en": "Will you protect me?"},
        {"zh": "我真的饿了呀", "en": "I'm hungry, really."},
        {"zh": "我跟着你走行不行", "en": "Can I follow you?"},
        {"zh": "你手里那团东西能吃吗。", "en": "Is that thing in your hand edible?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得扁了一下", "en": "I got squashed a little."},
        {"zh": "我滚到一边去", "en": "I rolled aside."},
        {"zh": "我疼得连耳朵都贴地了。", "en": "The pain flattens my ears to the ground."},
        {"zh": "耳朵垂下来了", "en": "My ears drooped."},
        {"zh": "这一下很重，我很小", "en": "That was heavy; I'm small."},
        {"zh": "我被撞得缩起来", "en": "The hit made me shrink."},
        {"zh": "我弹都弹不动", "en": "I can't bounce."},
        {"zh": "我不哭，我忍着", "en": "I won't cry; I'll bear it."},
        {"zh": "我又站起来了", "en": "I got up again."},
        {"zh": "别再来打我了", "en": "Stop hitting me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "吃的，我要吃的", "en": "Food, I want food."},
        {"zh": "那个是幼年期饲料吗", "en": "Is that In-Training feed?"},
        {"zh": "给我一点吃的", "en": "Give me some."},
        {"zh": "我从早上就没吃过东西。", "en": "I haven't eaten since this morning."},
        {"zh": "快放下来，我自己吃。", "en": "Put it down already; I'll eat it myself."},
        {"zh": "我弹过去就吃", "en": "I'll bounce over and eat."},
        {"zh": "这香味钻进我的鼻子了。", "en": "That smell has crawled right up my nose."},
        {"zh": "你还拿着不放", "en": "You're holding it back."},
        {"zh": "再给我一小口", "en": "Give me one small bite more."},
        {"zh": "我吃得可快了", "en": "I eat fast."},
        {"zh": "这个我能咬动吗", "en": "Can I bite through this?"},
        {"zh": "我都在流口水", "en": "I'm drooling."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得滚了", "en": "I got knocked rolling."},
        {"zh": "我身上粉粉的，不疼", "en": "I'm pink and soft; no pain."},
        {"zh": "你踩到我的耳朵了", "en": "You stepped on my ear."},
        {"zh": "这一下把我弹开了", "en": "That bounced me away."},
        {"zh": "我滚到你脚边", "en": "I rolled to your feet."},
        {"zh": "我爬起来，又坐下", "en": "I got up and sat down again."},
        {"zh": "一推我就滚跑了", "en": "Push me and I roll away."},
        {"zh": "我们撞在一起，我弹得老高", "en": "We collided and I bounced high."},
        {"zh": "我的牙磕到了", "en": "My teeth clicked."},
        {"zh": "我一弹就缩进草里。", "en": "One bounce and I'm hidden in the grass."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还没长出腿来", "en": "I haven't grown legs yet."},
        {"zh": "我们这一群都还小", "en": "All of us in this group are little."},
        {"zh": "长大了才说这个", "en": "Ask when I've grown."},
        {"zh": "我一点听不懂", "en": "I don't understand."},
        {"zh": "那边的也在弹", "en": "That one over there is bouncing too."},
        {"zh": "我先吃点东西", "en": "I'll eat first."},
        {"zh": "你去问大的吧", "en": "Ask the big ones."},
        {"zh": "我的耳朵挡住了", "en": "My ears are in the way."},
        {"zh": "别来打扰我了", "en": "Don't bother me."},
        {"zh": "我要去玩了呀", "en": "I'm going to play."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我张嘴把它整个含住。", "en": "I open up and take the whole thing in."},
        {"zh": "我叼着它，走得歪歪扭扭。", "en": "I carry it and wobble along."},
        {"zh": "这个比我还大", "en": "This is bigger than me."},
        {"zh": "我一点拖不动", "en": "I can't drag it."},
        {"zh": "掉在地上的，我要", "en": "What fell, I want."},
        {"zh": "我真的吞不下", "en": "I can't swallow it."},
        {"zh": "我含着跑不了", "en": "I can't run with it in my mouth."},
        {"zh": "这个咬起来硬邦邦", "en": "This is hard as rock."},
        {"zh": "这个我啃不动的", "en": "I can't gnaw through this."},
        {"zh": "我又掉下来了", "en": "I dropped it again."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有吃的吗", "en": "Is there food over there?"},
        {"zh": "草丛在晃，是谁在那儿。", "en": "The grass is shaking. Who's there?"},
        {"zh": "我先弹过去看看", "en": "Let me bounce over and see."},
        {"zh": "大的都看着那边", "en": "The big ones are all looking that way."},
        {"zh": "鼻子告诉我那边有东西。", "en": "My nose says there's something over there."},
        {"zh": "朝那个方向去", "en": "That way."},
        {"zh": "我叫一声，没人应", "en": "I called once; no answer."},
        {"zh": "我弹几下就能到", "en": "A few bounces and I'm there."},
        {"zh": "我弹了两下身", "en": "I bounced twice."},
        {"zh": "我可得跟上去", "en": "I have to keep up."},
        {"zh": "草丛边，就那边", "en": "By the grass, over there."},
        {"zh": "我弹过去看看", "en": "I'll bounce over to see."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我弹得没那么快", "en": "I don't bounce that fast."},
        {"zh": "它往前面走了", "en": "It walked on."},
        {"zh": "大个子弹哪，我就弹哪。", "en": "Wherever the big one bounces, I bounce."},
        {"zh": "我还差得远呢", "en": "I'm still far behind."},
        {"zh": "这草实在太高", "en": "The grass is too tall."},
        {"zh": "我就弹起来看", "en": "I bounce up to look."},
        {"zh": "你看得到它吗", "en": "Can I see it?"},
        {"zh": "我再弹上一下", "en": "One more bounce."},
        {"zh": "我弹得有点累", "en": "I'm tired."},
        {"zh": "你可得等等我", "en": "Wait for me."},
        {"zh": "它在那边站住", "en": "It came to a stop over there."},
        {"zh": "我又弹起来身", "en": "I bounce up again."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我弹起来就撞它", "en": "I bounce up and ram it."},
        {"zh": "我轻轻咬一口", "en": "I took a bite."},
        {"zh": "这一下一点都不疼", "en": "That didn't hurt at all."},
        {"zh": "我跳起来撞上去", "en": "I bounce up and hit."},
        {"zh": "用的还是泡泡", "en": "I use bubbles mostly."},
        {"zh": "它被我撞得晃了一下", "en": "It wobbled from my hit."},
        {"zh": "撞完我就弹回原地。", "en": "After the hit I bounce right back."},
        {"zh": "我其实有点怕", "en": "I'm a little scared."},
        {"zh": "我咬住它裤脚不松口。", "en": "I clamp onto its trouser cuff and hold."},
        {"zh": "我弹得越来越低", "en": "My bounces get lower."},
        {"zh": "我吐了几个泡泡", "en": "I spat a few bubbles."},
        {"zh": "这一下是为了壮胆", "en": "That was to look brave."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "壳一破，我一头栽到草上。", "en": "The shell splits and I flop onto the grass."},
        {"zh": "我先弹了一下", "en": "I bounced once."},
        {"zh": "这地方真大啊", "en": "This place is so big."},
        {"zh": "我朝草地那边弹", "en": "I bounce toward the grass."},
        {"zh": "我张着嘴看四周", "en": "Mouth open, I look around."},
        {"zh": "旁边有几个一样小的", "en": "A few as small as me are nearby."},
        {"zh": "我还没站点稳", "en": "I haven't steadied yet."},
        {"zh": "一出壳就闻到甜味。", "en": "Fresh from the shell, I smell something sweet."},
        {"zh": "我弹了两步就停下", "en": "I bounced two steps and stopped."},
        {"zh": "我朝有声音的地方弹", "en": "I bounce toward the sound."},
        {"zh": "这具身体太小了", "en": "This body is so small."},
        {"zh": "我肚子一直叫", "en": "My stomach is growling."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤到我，我缩起来了", "en": "Fire touched me and I curled up."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚下去，弹了两下", "en": "I rolled down and bounced twice."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我浮着，不会沉", "en": "I float in water; won't sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆开的气浪把我掀翻", "en": "The blast wave knocked me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西擦过我的耳朵", "en": "Something grazed my ear."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术打来，我身上一亮", "en": "The spell hit and I flashed."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得弹不起来", "en": "Too hungry to bounce."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打来，我缩成一团", "en": "Lightning struck and I curled tight."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有草地", "en": "No grass in the void."}
      ]
    }
  }
