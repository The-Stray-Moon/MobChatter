{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一晃地走过草原。", "en": "I sway step by step across the plains."},
        {"zh": "我的长披风拖在草上。", "en": "My long cloak drags through grass."},
        {"zh": "我在稀树间慢慢挪。", "en": "I move slowly among the savanna trees."},
        {"zh": "我踩着鼓点走。", "en": "I walk to a beat only I hear."},
        {"zh": "我朝有笑声的方向走。", "en": "I walk toward the laughter."},
        {"zh": "我的身形细长得出奇。", "en": "My frame is strangely slender."},
        {"zh": "我绕着自己的锚点走。", "en": "I walk around my anchor."},
        {"zh": "我踩过的地方草不动。", "en": "The grass doesn't stir where I step."},
        {"zh": "我退一步，再转半圈。", "en": "I step back, then turn half around."},
        {"zh": "我停在半路，侧着头。", "en": "I stop halfway and tilt my head."},
        {"zh": "我的靴子不发出声音。", "en": "My boots make no sound."},
        {"zh": "我的袖子垂到膝下。", "en": "My sleeves hang past my knees."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，手拢在袖里。", "en": "I stand with my hands in my sleeves."},
        {"zh": "我的脸像一张面具。", "en": "My face is like a mask."},
        {"zh": "我在笑，可没有声音。", "en": "I'm smiling, but there's no sound."},
        {"zh": "我的披风在风里翻。", "en": "My cloak turns in the wind."},
        {"zh": "我在数草上的虫子。", "en": "I count the insects on the grass."},
        {"zh": "我抬手又缓缓落下。", "en": "I lift a hand and let it fall."},
        {"zh": "我在等一个愿意看戏的人。", "en": "I wait for someone willing to watch."},
        {"zh": "我的铃铛响了一下。", "en": "My bell rings once."},
        {"zh": "远处有只秃鹫盘旋。", "en": "A vulture circles far off."},
        {"zh": "我在笑它飞得慢。", "en": "I'm laughing at how slowly it flies."},
        {"zh": "我的袖子被风鼓起来。", "en": "Wind fills my sleeves."},
        {"zh": "我慢慢抬手行了个礼。", "en": "I slowly raise a hand in a bow."},
        {"zh": "我的锚点就在这不远。", "en": "My anchor is close by."},
        {"zh": "我等着看你笑。", "en": "I wait for you to laugh."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你坐在前排。", "en": "You're in the front row."},
        {"zh": "我的戏还没开场。", "en": "My show hasn't begun."},
        {"zh": "你看起来不错笑。", "en": "You look like a poor audience."},
        {"zh": "那身护甲，反着一片光。", "en": "That armor throws back a patch of light."},
        {"zh": "这颜色我中意。", "en": "That colour pleases me."},
        {"zh": "你的指头在颤。", "en": "Your fingers are quivering."},
        {"zh": "那是戏的一部分。", "en": "That's part of the act."},
        {"zh": "你笑一个试试。", "en": "Try a smile."},
        {"zh": "我看不清你的表情。", "en": "I can't make out your expression."},
        {"zh": "你退后了两步。", "en": "You stepped back twice."},
        {"zh": "这更好笑了。", "en": "That's funnier."},
        {"zh": "我有一整晚的时间。", "en": "I have the whole evening."},
        {"zh": "戏要慢慢演。", "en": "A show should unfold slowly."},
        {"zh": "你要不要一起？", "en": "Care to join in?"},
        {"zh": "不说话也算回答。", "en": "Silence counts as an answer."},
        {"zh": "那我开始了。", "en": "Then I'll begin."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的披风破了一道。", "en": "A tear in my cloak."},
        {"zh": "这一下打得不错，我的面具裂了一点。", "en": "A decent blow — my mask is chipped."},
        {"zh": "戏服破了个口子。", "en": "My costume has a tear."},
        {"zh": "我的面具裂了一点。", "en": "My mask chipped a little."},
        {"zh": "我退了半步，行礼。", "en": "I step back and bow."},
        {"zh": "这点伤是个桥段。", "en": "This wound is a plot point."},
        {"zh": "我的袖子散了一角。", "en": "A corner of my sleeve comes loose."},
        {"zh": "戏还在继续。", "en": "The show goes on."},
        {"zh": "你可别坐下。", "en": "Don't take a seat."},
        {"zh": "精彩的部分要来。", "en": "The good part is coming."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是给观众的道具。", "en": "That's a prop for the audience."},
        {"zh": "我不用吃。", "en": "I needn't eat."},
        {"zh": "举高一点，让他们看见。", "en": "Hold it higher, let them see."},
        {"zh": "这东西不好笑。", "en": "That isn't funny."},
        {"zh": "你留着当纪念。", "en": "Keep it as a souvenir."},
        {"zh": "我不收票钱。", "en": "I take no ticket money."},
        {"zh": "这场戏是免费的。", "en": "This show is free."},
        {"zh": "你可要坐稳。", "en": "Do hold your seat."},
        {"zh": "这味道让我想笑。", "en": "That smell makes me want to laugh."},
        {"zh": "把它收好。", "en": "Put it away."},
        {"zh": "换点更有意思的。", "en": "Bring something more interesting."},
        {"zh": "或者什么也别带。", "en": "Or bring nothing at all."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的袖子。", "en": "You bumped my sleeve."},
        {"zh": "帽檐歪了，我把它扶正。", "en": "My brim is crooked; I set it right."},
        {"zh": "别扯我的披风。", "en": "Don't pull my cloak."},
        {"zh": "这料子很薄。", "en": "This fabric is thin."},
        {"zh": "你从我身边穿过去。", "en": "You slip past me."},
        {"zh": "我退了半步，很礼貌。", "en": "I step back half a pace, politely."},
        {"zh": "我的骨架比你看着的硬。", "en": "My frame is harder than it looks."},
        {"zh": "这一撞很有趣。", "en": "That bump was amusing."},
        {"zh": "你踩到我的衣角。", "en": "You stepped on my hem."},
        {"zh": "我笑笑就算了。", "en": "I'll just smile about it."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我演的是小丑。", "en": "I play the jester."},
        {"zh": "小丑没有这些。", "en": "A jester doesn't have such things."},
        {"zh": "你该看戏，不该问。", "en": "You should watch, not ask."},
        {"zh": "我只跟指令走。", "en": "I follow orders only."},
        {"zh": "面具底下，什么也没有。", "en": "Beneath the mask, there is nothing."},
        {"zh": "这不好笑。", "en": "That isn't funny."},
        {"zh": "你打断了我的节目。", "en": "You've broken my act."},
        {"zh": "让我继续演。", "en": "Let me go on."},
        {"zh": "台下还有别人吗？", "en": "Is anyone else in the audience?"},
        {"zh": "没有就好。", "en": "Good, no one."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起来，像捡道具。", "en": "I pick it up like a prop."},
        {"zh": "这是什么笑料？", "en": "Is this a joke?"},
        {"zh": "我把它举给你的脸看。", "en": "I hold it up to your face."},
        {"zh": "你躲什么？", "en": "Why flinch?"},
        {"zh": "这东西轻得很。", "en": "This weighs almost nothing."},
        {"zh": "我把它变没了。", "en": "I make it vanish."},
        {"zh": "它在我袖里没声音。", "en": "Nothing sounds from my sleeve."},
        {"zh": "也许后面有用。", "en": "It may be useful later."},
        {"zh": "或者没用。", "en": "Or not."},
        {"zh": "反正有意思。", "en": "It's amusing either way."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你坐得太靠前了。", "en": "You're sitting too close."},
        {"zh": "那就上台来吧。", "en": "Then come up on stage."},
        {"zh": "我的戏正好缺个配角。", "en": "My show lacks a supporting part."},
        {"zh": "你不需要台词。", "en": "You won't need lines."},
        {"zh": "站定就行。", "en": "Just stand still."},
        {"zh": "我听着你的气息。", "en": "I listen to your breathing."},
        {"zh": "这台子刚好容下你。", "en": "This stage just fits you."},
        {"zh": "我抬手，戏就开场。", "en": "I raise my hand and it begins."},
        {"zh": "还有三拍。", "en": "Three beats more."},
        {"zh": "两拍。", "en": "Two beats."},
        {"zh": "最后一拍。", "en": "The final beat."},
        {"zh": "利爪出鞘。", "en": "Death Claw, drawn."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕你走了一整圈。", "en": "I walk one full circle round you."},
        {"zh": "我的披风扫过你的脚。", "en": "My cloak sweeps your feet."},
        {"zh": "观众不动，戏怎么演？", "en": "A still audience makes a poor show."},
        {"zh": "很好，很稳。", "en": "Good. Steady."},
        {"zh": "我的袖子长得碍事。", "en": "My sleeves are awkwardly long."},
        {"zh": "但我习惯了。", "en": "But I'm used to it."},
        {"zh": "我这副镰刀手，专挑破绽。", "en": "These scythe arms look for openings."},
        {"zh": "我在等它再偏一点。", "en": "I wait for one more tilt."},
        {"zh": "我的手在袖里。", "en": "My hand is in my sleeve."},
        {"zh": "你看不见它在哪。", "en": "You can't see where it is."},
        {"zh": "数到最后一下。", "en": "Count to the last one."},
        {"zh": "那就这样。", "en": "So be it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的袖子甩了出去。", "en": "My sleeve lashes out."},
        {"zh": "爪痕划过你的胸口。", "en": "Claw marks cross your chest."},
        {"zh": "你连退两步。", "en": "You gave two paces."},
        {"zh": "我的爪子先笑了。", "en": "My claw laughs first."},
        {"zh": "这一下是开场。", "en": "That was the opening."},
        {"zh": "你的甲裂开了。", "en": "Your armor split."},
        {"zh": "我退回去，行礼。", "en": "I step back and bow."},
        {"zh": "观众的掌声呢？", "en": "Where's the applause?"},
        {"zh": "好吧，没有。", "en": "No matter."},
        {"zh": "那这一段就长一点。", "en": "Then let this scene run longer."},
        {"zh": "我抬手第二次。", "en": "I raise my hand a second time."},
        {"zh": "你并未离开。", "en": "You haven't left."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草原上多了一个高影。", "en": "A tall shape on the plains."},
        {"zh": "我站得很直，像根竿。", "en": "I stand straight as a pole."},
        {"zh": "我的披风落到草上。", "en": "My cloak settles on the grass."},
        {"zh": "我抬了抬我的帽子。", "en": "I tip my hat."},
        {"zh": "这里适合演戏。", "en": "This will do for a stage."},
        {"zh": "风把草吹出一片浪。", "en": "Wind rolls a wave across the grass."},
        {"zh": "我慢慢行了个礼。", "en": "I bow slowly."},
        {"zh": "台下还没人。", "en": "The audience is empty."},
        {"zh": "那我就自己笑。", "en": "Then I'll laugh to myself."},
        {"zh": "我的锚点在这边。", "en": "My anchor is this way."},
        {"zh": "我走过去站好。", "en": "I walk over and take my place."},
        {"zh": "今晚的戏我演给自己。", "en": "Tonight's show is for me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧上披风，我还在笑。", "en": "Fire catches my cloak. I'm still laughing."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下来，帽子滚远了。", "en": "I fall; my hat rolls off."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进面具里，笑声断了。", "en": "Water fills my mask; the laugh cuts out."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把道具全掀了。", "en": "The blast flings every prop away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西钉进我的袖子。", "en": "That pinned into my sleeve."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我的面具发烫。", "en": "Magic heats my mask."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，只吃掌声。", "en": "I eat no food, only applause."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我的影子闪了一下。", "en": "Lightning strikes; my shadow flickers."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有台子。", "en": "No stage in the void."}
      ]
    }
  }
}
