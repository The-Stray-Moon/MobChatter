{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我两条腿走得很稳。", "en": "I walk steadily on two legs."},
        {"zh": "背上的毛有点乱。", "en": "The fur on my back is mussed."},
        {"zh": "我从雪地上走过去。", "en": "I cross the snow."},
        {"zh": "我朝林子的边线走。", "en": "I move toward the treeline."},
        {"zh": "我的角蹭到树枝。", "en": "My horn scrapes a branch."},
        {"zh": "我一步一步跟着主人。", "en": "Step by step, I follow my partner."},
        {"zh": "雪踩下去有声音。", "en": "The snow sounds under me."},
        {"zh": "我在平原上慢慢走。", "en": "I walk slowly across the plain."},
        {"zh": "我绕着营地转了一圈。", "en": "I circle the camp once."},
        {"zh": "我爪子踩得很轻。", "en": "My paws land lightly."},
        {"zh": "我朝那个方向去了。", "en": "I went that way."},
        {"zh": "我身上的毛很厚。", "en": "My fur is thick."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在雪地上。", "en": "I sit in the snow."},
        {"zh": "背上的毛立起来。", "en": "The fur on my back stands up."},
        {"zh": "我在听远处的声。", "en": "I listen to something far off."},
        {"zh": "我不觉得冷。", "en": "I don't feel the cold."},
        {"zh": "我的角上有点霜。", "en": "There's frost on my horn."},
        {"zh": "雪的反光有点刺眼。", "en": "The snow glare stings a little."},
        {"zh": "雪地上一片安静。", "en": "The snowfield is still."},
        {"zh": "我把爪子从雪里拔出来。", "en": "I pull my claws out of the snow."},
        {"zh": "我把重心移到前爪。", "en": "I shift my weight to my forepaws."},
        {"zh": "我抬头看雪落下来。", "en": "I look up at the falling snow."},
        {"zh": "我身上的皮，是毛还是甲，说不清。", "en": "Fur or hide, even I cannot tell."},
        {"zh": "我一动不动地坐着。", "en": "I sit without moving."},
        {"zh": "我低头舔了舔雪。", "en": "I lower my head and lick the snow."},
        {"zh": "我在想下一步去哪。", "en": "I'm thinking where to go next."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你呼出的白气扑到我脸上。", "en": "Your white breath fogs my face."},
        {"zh": "我会跟着你。", "en": "I'll follow you."},
        {"zh": "你身后有我。", "en": "I'm behind you."},
        {"zh": "你不必害怕的。", "en": "You need not be afraid."},
        {"zh": "我看得清你的样子。", "en": "I've got a clear look at you."},
        {"zh": "我身上的毛是我的。", "en": "This fur on my back is mine."},
        {"zh": "我的爪子能撕开东西。", "en": "These claws can tear things open."},
        {"zh": "我能闻出很远的东西。", "en": "I can smell things from far off."},
        {"zh": "你要去哪我陪你。", "en": "Wherever you go, I'll come."},
        {"zh": "你的手可以摸摸我。", "en": "You may pat me."},
        {"zh": "我们是一路的。", "en": "We're on the same side."},
        {"zh": "我的角会挡你的路。", "en": "My horn will block your way."},
        {"zh": "我挡在你和雪林之间。", "en": "I stand between you and the snowy trees."},
        {"zh": "我的后腿已经蹬住雪。", "en": "My hind legs are braced in the snow."},
        {"zh": "我的角比雪还凉。", "en": "My horn is colder than the snow."},
        {"zh": "你冷了就往我这边靠。", "en": "If you're cold, come closer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我背上掉了一撮毛。", "en": "A tuft of my back fur came out."},
        {"zh": "我往雪里退了半步。", "en": "I backed half a step into the snow."},
        {"zh": "这一下打进毛里。", "en": "That went into the fur."},
        {"zh": "血渗进我背上的毛。", "en": "Blood seeps into the fur on my back."},
        {"zh": "雪原上，我的血是热的。", "en": "On the snowfield, my blood runs hot."},
        {"zh": "我身上这张毛皮，是借来的。", "en": "This pelt on me is borrowed."},
        {"zh": "这一下拖住了我的步子。", "en": "That dragged at my stride."},
        {"zh": "我背上那道伤还在。", "en": "The wound on my back is still there."},
        {"zh": "我躲得不够快。", "en": "I do not dodge fast enough."},
        {"zh": "你打得很实在。", "en": "That landed solidly."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手上拿的是吃的？", "en": "Is that food you are holding?"},
        {"zh": "我能吃一点。", "en": "I can eat some of that."},
        {"zh": "这个味道我认识。", "en": "I know that smell."},
        {"zh": "你放在雪上吧。", "en": "Set it on the snow."},
        {"zh": "我不算挑食。", "en": "I am not really picky."},
        {"zh": "你举着我来拿。", "en": "Hold it out and I'll take it."},
        {"zh": "这份够不够？", "en": "Is this much enough?"},
        {"zh": "我会慢慢吃完。", "en": "I will finish it slowly."},
        {"zh": "你先吃一口。", "en": "You take a bite first."},
        {"zh": "我在雪里找过吃的。", "en": "I've foraged in the snow."},
        {"zh": "这点对我来说太少。", "en": "That's too little for me."},
        {"zh": "这块肉冻得硬邦邦。", "en": "This meat is frozen stiff."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，我没动。", "en": "You bumped me. I didn't move."},
        {"zh": "我这身皮毛很厚实。", "en": "This pelt is thick."},
        {"zh": "你的手碰到我的角。", "en": "Your hand touched my horn."},
        {"zh": "雪被我们踢起来了。", "en": "We kicked up snow."},
        {"zh": "我让开一点，雪被踢起来。", "en": "I step aside a little; snow kicks up."},
        {"zh": "我不太怕撞。", "en": "I don't mind being bumped."},
        {"zh": "我们都停了一步。", "en": "We both stopped short."},
        {"zh": "我把爪子从你鞋下抽出来。", "en": "I pull my paw out from under your boot."},
        {"zh": "雪原上长大，熊拳很实。", "en": "Raised on the snowfield, this bear punch lands."},
        {"zh": "你的甲片真硬。", "en": "Those plates are hard."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这事在雪原上做。", "en": "This is done on the snowfield."},
        {"zh": "两只有角的靠在一起。", "en": "Two horned ones side by side."},
        {"zh": "她在雪坡下等我。", "en": "She waits for me below the snow slope."},
        {"zh": "她的角比我的短一截。", "en": "Her horn is a hand shorter than mine."},
        {"zh": "我们并着肩站了会儿。", "en": "We stood shoulder to shoulder."},
        {"zh": "我身上的毛皮，是别人给的。", "en": "The pelt on my back was a gift."},
        {"zh": "之后各守一边。", "en": "Afterwards we guard our own sides."},
        {"zh": "这一带会有小的。", "en": "There'll be young ones here."},
        {"zh": "谁都没有叫出声。", "en": "Neither of us called out."},
        {"zh": "风把痕迹盖了。", "en": "The wind covered the traces."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "用牙咬住，拖回窝里。", "en": "Grip it in my teeth and drag it home."},
        {"zh": "我用牙咬住拖了两步。", "en": "I grip it in my teeth and drag it two steps."},
        {"zh": "熊掌一击，你先退。", "en": "One Bear Punch and you back off."},
        {"zh": "这块我不能吃。", "en": "I can't eat this one."},
        {"zh": "我把它拖回去。", "en": "I drag it back."},
        {"zh": "我咬着走了几步。", "en": "I carried it a few steps."},
        {"zh": "你掉的在雪坑里。", "en": "Yours is in the snow hollow."},
        {"zh": "我把雪扒开。", "en": "I scraped the snow aside."},
        {"zh": "这个有铁的味道。", "en": "This smells of iron."},
        {"zh": "我嘴小，塞不进。", "en": "My mouth is too small."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩碎了雪壳。", "en": "You have broken the snow crust."},
        {"zh": "有东西在后面。", "en": "Something's behind you."},
        {"zh": "雪风送来了铁锈味。", "en": "The snow wind carries a smell of rust."},
        {"zh": "那边的雪塌了一块。", "en": "A patch of snow collapsed over there."},
        {"zh": "雪上的印子很新。", "en": "The prints in the snow are fresh."},
        {"zh": "我站到你的前面。", "en": "I've moved in front of you."},
        {"zh": "雪地上有东西在动。", "en": "Something is moving on the snow."},
        {"zh": "这一片没有别的路。", "en": "There's no other path here."},
        {"zh": "它们不止一个。", "en": "There's more than one of them."},
        {"zh": "你先退，我来挡。", "en": "Fall back. I'll hold."},
        {"zh": "我听到呼吸声了。", "en": "I hear breathing."},
        {"zh": "雪上的脚印不是我的。", "en": "The prints in the snow are not mine."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直盯着那边，爪子已经蓄好。", "en": "I keep watching; my paw is charged."},
        {"zh": "它们绕到树后面了。", "en": "They went behind the trees."},
        {"zh": "我跟你背对背。", "en": "I'm back to back with you."},
        {"zh": "雪把声音传得很清楚。", "en": "Snow carries sound clearly."},
        {"zh": "我听见两次脚步。", "en": "I heard two sets of steps."},
        {"zh": "它们换了个方向。", "en": "They changed direction."},
        {"zh": "我一直盯着那边，呼吸很稳。", "en": "I keep watching that way, breathing steady."},
        {"zh": "它们不敢直接上来。", "en": "They won't come straight in."},
        {"zh": "我守这一边。", "en": "I'm holding this side."},
        {"zh": "雪越下越大。", "en": "The snow is thickening."},
        {"zh": "我背上这块皮，是捡来的。", "en": "The hide on my back was found, not grown."},
        {"zh": "它们在我们上风处。", "en": "They're upwind of us."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的爪子撕开它的毛。", "en": "My claws tear through its fur."},
        {"zh": "我的肩膀撞在它胸口。", "en": "My shoulder slams into its chest."},
        {"zh": "这一下能撕开皮。", "en": "This can tear hide open."},
        {"zh": "你退后，我打。", "en": "Step back. I'll strike."},
        {"zh": "我的牙咬住了。", "en": "My teeth caught it."},
        {"zh": "雪被我们踩成泥。", "en": "We trampled the snow to slush."},
        {"zh": "这一下它退了。", "en": "That knocked it back."},
        {"zh": "我的肩膀扛了一下。", "en": "I took it on the shoulder."},
        {"zh": "我连着抓了两下。", "en": "I raked twice without stopping."},
        {"zh": "血落在雪上。", "en": "Blood on the snow."},
        {"zh": "我的爪尖卡在它骨缝里。", "en": "My claw tips catch in its joints."},
        {"zh": "我的爪子刮过它的甲。", "en": "My claws rake across its armor."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雪落在我背上，很厚。", "en": "Snow lies thick on my back."},
        {"zh": "身上的毛还带着雪。", "en": "Snow clings to my fur."},
        {"zh": "这里是雪原。", "en": "This is snow country."},
        {"zh": "我朝四周看了一圈。", "en": "I looked all around."},
        {"zh": "雪原上的风很干净。", "en": "The wind on the snowfield is clean."},
        {"zh": "我慢慢地走到坡上。", "en": "I walked slowly to the ridge."},
        {"zh": "我看见有人。", "en": "I see someone."},
        {"zh": "我甩了甩背上的毛。", "en": "I shook the fur on my back."},
        {"zh": "我脚下踩出印子。", "en": "My steps left prints."},
        {"zh": "这里的风很冷。", "en": "The wind is cold here."},
        {"zh": "我朝雪原叫了一声。", "en": "I called across the snowfield."},
        {"zh": "雪落在我的角上。", "en": "Snow lands on my horn."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "毛一烧，味道很重。", "en": "Burnt fur smells strong."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时腿一震。", "en": "My legs jarred on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把毛浸透了，我往下沉。", "en": "Soaked fur pulls me down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我推得倒滑。", "en": "The blast slid me backwards."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进我的肩，背上的毛挡了一下。", "en": "The arrow hit my shoulder; the fur on my back caught it."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光绕过了厚毛。", "en": "That light went past the fur."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "雪里吃的不多。", "en": "There's not much to eat in snow."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声中，我的角在发麻。", "en": "In the thunder, my horn goes numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有雪可以站。", "en": "No snow to stand on in the void."}
      ]
    }
  }
}
