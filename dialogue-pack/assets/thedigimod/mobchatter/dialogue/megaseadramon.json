        {"zh": "海流把我往前送了一程。", "en": "The current carries me forward."},
        {"zh": "我这次不用慢慢来", "en": "I will not take it slowly this time."},
        {"zh": "我压低了身体", "en": "I lower my body."},
        {"zh": "水忽然动起来", "en": "The water begins to move."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着礁石画了个圈。", "en": "I circle close along the reef."},
        {"zh": "我在水面下跟着", "en": "I track it beneath the surface."},
        {"zh": "它往左我就转左", "en": "It goes left; I turn left."},
        {"zh": "我在水里绕开礁石，等它靠近岸边。", "en": "I round the reef and wait for it to near the shore."},
        {"zh": "我的影子在水底扫过", "en": "My shadow sweeps the bottom."},
        {"zh": "我不急着冲过去", "en": "I am in no hurry to charge."},
        {"zh": "我的长身在海里绕了一圈。", "en": "My length coils once through the sea."},
        {"zh": "我已经在它侧面", "en": "I am already at its flank."},
        {"zh": "我藏在暗流下面，等你。", "en": "I wait beneath the undertow."},
        {"zh": "水面的波纹散了", "en": "The ripples have faded."},
        {"zh": "这个角度，够我一口吞。", "en": "From this angle, one bite will do."},
        {"zh": "它退到岸边了", "en": "It has backed to the shore."}
      ]
    },
