{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里掀起水花", "en": "I throw up spray as I move."},
        {"zh": "我的长身在海里游", "en": "My long body swims the sea."},
        {"zh": "我的鳞片擦过海水", "en": "My scales scrape the seawater."},
        {"zh": "我慢慢绕开礁石", "en": "I curve around the reef."},
        {"zh": "我贴着海底滑行", "en": "I slide along the sea floor."},
        {"zh": "我摆尾换了个方向", "en": "My tail swings, changing course."},
        {"zh": "顺着洋流，我一路向上。", "en": "Along the current, I rise."},
        {"zh": "我沿着洋流前进", "en": "I ride the current."},
        {"zh": "我游到浅处又沉下", "en": "I come to the shallows and dive."},
        {"zh": "我钻过一片海草", "en": "I pass through the seagrass."},
        {"zh": "我一直朝岸边游", "en": "I keep swimming for the shore."},
        {"zh": "我慢慢收住尾巴", "en": "I slow my tail."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在水里面", "en": "I float in the water."},
        {"zh": "我的头露在水面", "en": "My head breaks the surface."},
        {"zh": "我在锚点附近游荡", "en": "I drift near my anchor point."},
        {"zh": "我的鳞片反着光，海面上全是我。", "en": "My scales catch the light; the surface is all me."},
        {"zh": "我悬在中层水里，不动。", "en": "I hang motionless in the midwater."},
        {"zh": "我在听水里的声音", "en": "I listen to the water."},
        {"zh": "我慢慢转了半个身", "en": "I turn half about."},
        {"zh": "我的鳍轻轻摆", "en": "My fins sway gently."},
        {"zh": "我在等海面安静", "en": "I wait for the sea to settle."},
        {"zh": "我的身体很长，头露在水面上。", "en": "My body is long; my head shows above the surface."},
        {"zh": "我慢慢下沉一点", "en": "I sink a little."},
        {"zh": "我把头抬出水面", "en": "I lift my head from the water."},
        {"zh": "我在水下呼气", "en": "I breathe out underwater."},
        {"zh": "我没有离开这块海", "en": "I have not left this patch of sea."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "水面破开，我望着你。", "en": "The surface breaks, and I look at you."},
        {"zh": "你就站在岸上", "en": "You are standing on the shore."},
        {"zh": "我慢慢朝你游", "en": "I swim slowly toward you."},
        {"zh": "我的身体比你大得多", "en": "I am far larger than you."},
        {"zh": "我把长脑袋斜过来", "en": "I slant my long head over."},
        {"zh": "我不讨厌陆地", "en": "I do not dislike the land."},
        {"zh": "我贴在浅水里", "en": "I lie in the shallows."},
        {"zh": "你只要站着别动", "en": "Just stand still."},
        {"zh": "我盯的是你的手，不是你的脸。", "en": "I'm watching your hands, not your face."},
        {"zh": "我张嘴，给你看我的牙。", "en": "I open my mouth to show my teeth."},
        {"zh": "我的鳍竖起来了", "en": "My fins lift."},
        {"zh": "你不要惊动我", "en": "Do not startle me."},
        {"zh": "我朝你那边靠近", "en": "I come closer your way."},
        {"zh": "我在浅水里翻身", "en": "I roll over in the shallows."},
        {"zh": "我昂起头望你", "en": "I rear my head up at you."},
        {"zh": "海龙兽的影子沉在水下。", "en": "The sea dragon's shadow sinks below the water."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我甩尾拍打水面", "en": "My tail slaps the water."},
        {"zh": "我沉下去躲了一会", "en": "I dive to hide a while."},
        {"zh": "我的鳞片翻起一片", "en": "A patch of scales lifts."},
        {"zh": "我的血把浅滩染红了。", "en": "Blood clouds the water."},
        {"zh": "我浮到水面，缓一缓。", "en": "I surface to catch myself."},
        {"zh": "我退到礁石后面", "en": "I retreat behind the reef."},
        {"zh": "我还在继续游", "en": "I am still swimming."},
        {"zh": "我喷出一口海水。", "en": "I blow out a mouthful of seawater."},
        {"zh": "我又沉了下去", "en": "I dive again."},
        {"zh": "这点伤，不够我沉底。", "en": "This wound won't send me to the bottom."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是海鲜的味道", "en": "That smells of seafood."},
        {"zh": "我朝岸边游过去", "en": "I swim for the shore."},
        {"zh": "我在浅水里探头", "en": "I poke my head up in the shallows."},
        {"zh": "我把嘴搁在浅滩上。", "en": "I rest my jaws on the shallows."},
        {"zh": "这个份量不错", "en": "That is a decent portion."},
        {"zh": "那点鱼肉，不够我嚼。", "en": "That mouthful of fish is not enough."},
        {"zh": "我还想再要些", "en": "I would like more."},
        {"zh": "海里的我，比船还长。", "en": "In the sea, I'm longer than a boat."},
        {"zh": "我绕着那块水面转", "en": "I circle that patch of water."},
        {"zh": "我慢慢退回去", "en": "I slowly withdraw."},
        {"zh": "我又浮了上来", "en": "I surface again."},
        {"zh": "我等着下一口", "en": "I wait for the next bite."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，我纹丝不动", "en": "You bump me and I do not shift."},
        {"zh": "我往水里一沉", "en": "I sink into the water."},
        {"zh": "我的鳞片把你顶开", "en": "My scales push you off."},
        {"zh": "你从我身边滑过去", "en": "You slide past me."},
        {"zh": "我抬了下头瞧你", "en": "I lift my head and eye you."},
        {"zh": "这点力气不够", "en": "That is not enough force."},
        {"zh": "我掉转长身，朝外游。", "en": "I turn my long body and swim off."},
        {"zh": "我甩尾拍了一下水面", "en": "My tail slaps the surface."},
        {"zh": "溅了你一身水", "en": "You are soaked."},
        {"zh": "我往后一缩，沉进深处。", "en": "I pull back and sink deep."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一条从深水里上来", "en": "Another rises from deep water."},
        {"zh": "我们两条长影贴着海床走。", "en": "We two long shadows skirt the seabed."},
        {"zh": "它的身体比我更长", "en": "Its body is longer than mine."},
