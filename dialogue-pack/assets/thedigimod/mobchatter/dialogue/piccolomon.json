{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘在地面上方，脚不落地。", "en": "I float above the ground; my feet never touch."},
        {"zh": "身后拖着一道浅光。", "en": "A pale trail follows me."},
        {"zh": "我穿过山地上的碎石坡。", "en": "I cross the scree slopes."},
        {"zh": "石头挡路，我就飘过去。", "en": "Stones block the way; I float over them."},
        {"zh": "我的身体只有一个方块大。", "en": "My body is one block across."},
        {"zh": "在尖峭山峰上，风很大。", "en": "On the jagged peaks, the wind is strong."},
        {"zh": "我一点都没被吹偏。", "en": "I am not blown off course."},
        {"zh": "我朝平原去。", "en": "I head for the plains."},
        {"zh": "从高处慢慢降下来。", "en": "Descending slowly from the height."},
        {"zh": "沿途的草都朝我低头。", "en": "The grass bows toward me as I pass."},
        {"zh": "我一次也没停下。", "en": "I never once stopped."},
        {"zh": "我要去有人烟的地方。", "en": "I am going where people are."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在一处石台上。", "en": "I stop on a stone ledge."},
        {"zh": "周身的光一明一暗。", "en": "The light around me brightens and dims."},
        {"zh": "像在慢慢喘息。", "en": "As if slowly catching breath."},
        {"zh": "我抬手端详。", "en": "I raise a hand to study it."},
        {"zh": "里面有一点光在转。", "en": "A little light turns inside."},
        {"zh": "我把它收回去。", "en": "I put it away."},
        {"zh": "风从山下上来。", "en": "Wind comes up from below."},
        {"zh": "我的衣角被吹起来。", "en": "My hem lifts."},
        {"zh": "我这么小一团，射得倒准。", "en": "Small as I am, my shot is true."},
        {"zh": "远处有村子。", "en": "A village lies far off."},
        {"zh": "我看了好一阵。", "en": "I look for a good while."},
        {"zh": "然后开始下山。", "en": "Then start down."},
        {"zh": "石台上有一层薄冰。", "en": "A thin ice films the ledge."},
        {"zh": "我飘过去，它就化了。", "en": "I drift over it and it melts."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在你面前，脚离地一寸。", "en": "I stop before you, an inch off the ground."},
        {"zh": "我身上有光。", "en": "There is light on me."},
        {"zh": "它照到你的脸。", "en": "It falls on your face."},
        {"zh": "你没有退缩。", "en": "You do not flinch."},
        {"zh": "我把光收了一点。", "en": "I pull the light in a little."},
        {"zh": "这样比较好看清。", "en": "Easier to see like this."},
        {"zh": "你开口说话。", "en": "You speak."},
        {"zh": "我正在听着呢。", "en": "I am listening."},
        {"zh": "我不太懂，但我在听。", "en": "I do not quite understand, but I am listening."},
        {"zh": "你停了下来。", "en": "You stop."},
        {"zh": "我轻轻一点头。", "en": "I nod slightly."},
        {"zh": "头点得很快。", "en": "A quick nod indeed."},
        {"zh": "像怕你不明白。", "en": "As if afraid you will not understand."},
        {"zh": "我一眨不眨。", "en": "I do not blink once."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的光散了一圈。", "en": "My light scatters in a ring."},
        {"zh": "身体有一块变淡了。", "en": "A part of my body pales."},
        {"zh": "我的形体歪了。", "en": "My form skews."},
        {"zh": "又慢慢凝回来。", "en": "And slowly gather again."},
        {"zh": "我对着光看手。", "en": "I hold my hand to the light."},
        {"zh": "指尖还是亮的。", "en": "The fingertip still glows."},
        {"zh": "我放下了心。", "en": "I relax."},
        {"zh": "我又浮正身形。", "en": "I float upright again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这个东西对我是空的。", "en": "Such a thing is empty to me."},
        {"zh": "又把目光移向你。", "en": "Then my gaze returns to you."},
        {"zh": "我把手放在上面。", "en": "I set my hand on it."},
        {"zh": "它又暗下去。", "en": "It dims again."},
        {"zh": "我把脸偏开，不接。", "en": "I turn my face away and refuse."},
        {"zh": "这个东西对我是空的，我仔细瞧了瞧。", "en": "This thing reads empty to me; I look it over."},
        {"zh": "你把它拿走了。", "en": "You take it away."},
        {"zh": "你手里那东西没有光。", "en": "That thing in your hand has no light."},
        {"zh": "我又看了看你的脸。", "en": "Then I look at your face again."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞了过来。", "en": "You came into me."},
        {"zh": "你碰到的是我的光壳。", "en": "What you touched is my shell of light."},
        {"zh": "你缩回去了。", "en": "You pull it back."},
        {"zh": "我又稳定成形。", "en": "I settle into shape again."},
        {"zh": "我微微颔首。", "en": "I nod slightly."},
        {"zh": "飞着也能被你撞到，稀奇。", "en": "Flying, and you still bumped me. Impressive."},
        {"zh": "让让，我的翅膀不认人。", "en": "Move, my wings don't check who's in the way."},
        {"zh": "摔不着我，撞一下更不疼。", "en": "I can't be dropped, and a bump hurts even less."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "也不会繁殖。", "en": "Nor does it breed."},
        {"zh": "我做的事是别的。", "en": "My work is something else."},
        {"zh": "我朝村子走。", "en": "I head for the village."},
        {"zh": "那里有需要搬运的东西。", "en": "There are things there that need carrying."},
        {"zh": "这些我搬得动。", "en": "I can carry these."},
        {"zh": "我被造出来，是为了搬东西。", "en": "I was made to carry things."},
        {"zh": "我朝村子飘去。", "en": "I drift toward the village."},
        {"zh": "光留在我背后。", "en": "The light trails behind me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸出手，它浮起来。", "en": "I extend a hand and it rises."},
        {"zh": "我不用碰到它。", "en": "I need not touch it."},
        {"zh": "它飘着跟我走。", "en": "It floats along with me."},
        {"zh": "我轻轻放回原地。", "en": "I set it gently back."},
        {"zh": "这一个太重了。", "en": "This one is too heavy."},
        {"zh": "我松开手，让它自己浮着。", "en": "I let go and it floats by itself."},
        {"zh": "我抱着它飘。", "en": "I float holding it."},
        {"zh": "光绕着它转。", "en": "Light circles it."},
        {"zh": "它跟着我一起亮。", "en": "It brightens along with me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我收住身子。", "en": "I check my drift."},
        {"zh": "身上的光变白了。", "en": "The light on me turns white."},
        {"zh": "我举起手掌。", "en": "I lift my palm."},
        {"zh": "光在掌心聚成一个点。", "en": "The light gathers to a point."},
        {"zh": "这是神圣射。", "en": "This is Holy Shoot."},
        {"zh": "我把它瞄准。", "en": "I take my aim."},
        {"zh": "它还在移动。", "en": "It is still moving."},
        {"zh": "我扣了一下。", "en": "I release."},
        {"zh": "一道细光射出去。", "en": "A thin beam shoots out."},
        {"zh": "它打在石头上。", "en": "It strikes stone."},
        {"zh": "石头裂碎了。", "en": "The stone breaks."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我升到它上方。", "en": "I rise above it."},
        {"zh": "光在我身边转。", "en": "Light turns around me."},
        {"zh": "它往左边奔。", "en": "It runs left."},
        {"zh": "我转向跟着。", "en": "I turn and follow."},
        {"zh": "手心的光越来越亮。", "en": "The light in my palm grows brighter."},
        {"zh": "它抬高视线。", "en": "It lifts its gaze."},
        {"zh": "我落下第二发。", "en": "I fire a second shot."},
        {"zh": "这次打在它的脚边。", "en": "This one hits at its feet."},
        {"zh": "泥土炸了开来。", "en": "The soil bursts."},
        {"zh": "它往后退开。", "en": "It retreats."},
        {"zh": "我降到和它平齐。", "en": "I descend level with it."},
        {"zh": "它把自己脸挡住。", "en": "It shields its face."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用手掌推它。", "en": "I push with my palm."},
        {"zh": "光在掌前炸开。", "en": "Light bursts before my palm."},
        {"zh": "它往后缩了半步。", "en": "It shrinks back half a step."},
        {"zh": "它被打得退开两步。", "en": "The blow sends it back two steps."},
        {"zh": "这回打在肩头。", "en": "The shoulder this time."},
        {"zh": "它整个弯下去。", "en": "It folds right over."},
        {"zh": "我悬在半空，掌心发亮。", "en": "I hover, my palm glowing."},
        {"zh": "我的手掌先到。", "en": "My palm arrives first."},
        {"zh": "光团落下，地砖凹了一块。", "en": "A light orb drops; a floor tile dents."},
        {"zh": "我起身退开。", "en": "I rise and back off."},
        {"zh": "光还在手心。", "en": "The light is still in my palm."},
        {"zh": "光还没有用完。", "en": "The light is not spent."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "山地上多了一点光。", "en": "A point of light appears on the mountain."},
        {"zh": "光点就是我。", "en": "The light is me."},
        {"zh": "我从光里成形。", "en": "I take shape out of the light."},
        {"zh": "先有轮廓，再有衣角。", "en": "First the outline, then the hem."},
        {"zh": "最后是眼睛。", "en": "Last, the eyes."},
        {"zh": "我睁开了眼。", "en": "I open my eyes."},
        {"zh": "四周是石头。", "en": "Stone all around."},
        {"zh": "风把碎石吹得滚。", "en": "Wind sends gravel rolling."},
        {"zh": "我浮了起来。", "en": "I lift off."},
        {"zh": "我朝山下飘。", "en": "I drift down the mountain."},
        {"zh": "风的阻力对我很小。", "en": "The wind barely resists me."},
        {"zh": "我很快就下去了。", "en": "I descend quickly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火和我身上的光撞在一起。", "en": "Fire meets the light around me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落到石头上，光散了一地。", "en": "I hit the stone and light spills across it."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让我的光变得很暗。", "en": "Water dims my light badly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我推得翻过去。", "en": "The blast flips me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿过去，洞很快就合上。", "en": "It passes through and the hole soon closes."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力想把我的光扯散。", "en": "Magic tries to tear my light apart."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "光散了，我的身体发虚。", "en": "My light fades and my body thins."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷和我的光混在一起。", "en": "Lightning blends with my light."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗很深，但我的光还在。", "en": "The dark is deep, but my light remains."}
      ]
    }
  }
}
