      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "液体进了我的关节", "en": "Liquid gets into my joints."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的甲掀开", "en": "The blast peels my armor back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物卡在我的胸口", "en": "Something sticks in my chest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "力场干扰了我的数据", "en": "A field disrupts my data."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "能量不够，我在变慢", "en": "Not enough energy; I'm slowing."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电流冲过我的身体", "en": "Current floods through me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空把我的数据扯开", "en": "The void tears my data apart."}
      ]
    }
  }
