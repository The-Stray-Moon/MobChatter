{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步走在林地间", "en": "I walk step by step through the woodland."},
        {"zh": "我的身形还不够高", "en": "I'm not yet very tall."},
        {"zh": "我沿着锚点的边缘绕", "en": "I circle the edge of my anchor."},
        {"zh": "我的手臂摆得很稳", "en": "My arms swing steadily."},
        {"zh": "我朝那片草甸去", "en": "I make for that meadow."},
        {"zh": "叶子从我的肩上滑过", "en": "Leaves brush past my shoulder."},
        {"zh": "我踩断了一根枯藤。", "en": "I snap a dry vine underfoot."},
        {"zh": "我停下来，看前面的路", "en": "I stop and look at the road ahead."},
        {"zh": "我朝几个同类走过去", "en": "I walk over to a few of my kind."},
        {"zh": "我按锚点的方向慢慢走。", "en": "I walk slowly toward the anchor."},
        {"zh": "我的身影在草上移动，还不够高。", "en": "My shape moves over the grass, not yet tall."},
        {"zh": "我跨过一块湿石头。", "en": "I step over a wet stone."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在锚点旁边", "en": "I stand beside my anchor."},
        {"zh": "我的双臂垂着，很安静", "en": "My arms hang quietly at my sides."},
        {"zh": "我在整理数据", "en": "I'm sorting my data."},
        {"zh": "我记下了周围的地形", "en": "I've recorded the terrain around me."},
        {"zh": "远处有同伴在走动", "en": "My fellows move in the distance."},
        {"zh": "我抬起头，风穿过林间", "en": "I raise my head; wind moves in the trees."},
        {"zh": "我在等主人回来", "en": "I'm waiting for my master to return."},
        {"zh": "草在我脚边摇", "en": "Grass sways at my feet."},
        {"zh": "我把手臂举起来试了试", "en": "I raise my arm and test it."},
        {"zh": "关节还能活动", "en": "The joint still moves."},
        {"zh": "我慢慢放下手", "en": "I lower my hand slowly."},
        {"zh": "有虫落在我的肩上", "en": "An insect lands on my shoulder."},
        {"zh": "我没有动，让它停着", "en": "I stay still and let it rest."},
        {"zh": "这里非常平静", "en": "It's calm here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我在认你的气味像不像主人。", "en": "I'm checking whether you smell like my master."},
        {"zh": "你站在那里，我没动", "en": "You stand there; I don't move."},
        {"zh": "我的身高还没有你高", "en": "I'm not yet as tall as you."},
        {"zh": "但我一直在长大", "en": "But I am growing."},
        {"zh": "我侧了一步，让出空间", "en": "I step aside to make space."},
        {"zh": "我的资料里没有你的记录", "en": "You aren't in my records."},
        {"zh": "你若要靠近，就先出声", "en": "If you come near, speak first."},
        {"zh": "我听到了你的脚步声", "en": "I heard your footsteps."},
        {"zh": "我不随意出手", "en": "I don't strike without cause."},
        {"zh": "可我也不会站着挨打", "en": "But I won't stand and be struck."},
        {"zh": "我抬起藤芽，又放下。", "en": "I raise a vine bud, then lower it."},
        {"zh": "我先观察一下你", "en": "I'll watch you first."},
        {"zh": "你的动作很慢", "en": "Your movements are slow."},
        {"zh": "这对我来说不算坏事", "en": "That isn't bad for me."},
        {"zh": "我还得看清你的意图", "en": "I still need to read your intent."},
        {"zh": "你退一步，我就放下手", "en": "One step back, and I lower my hand."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的数据错了一行", "en": "A line of my data has slipped."},
        {"zh": "我退一步重新校准", "en": "I step back and recalibrate."},
        {"zh": "甲上裂了一道", "en": "The armor has split."},
        {"zh": "能量在漏出去", "en": "Energy is leaking out."},
        {"zh": "我把手臂横在前面", "en": "I bring my arm across."},
        {"zh": "我的速度慢下来了", "en": "My speed has slowed."},
        {"zh": "我低头看损伤", "en": "I look down at the damage."},
        {"zh": "数据还能撑住。", "en": "My data can hold."},
        {"zh": "我扶正歪掉的芽。", "en": "I straighten my crooked bud."},
        {"zh": "你这一下不轻", "en": "That was not a light blow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那袋是幼年饲料吗？", "en": "Is that bag juvenile feed?"},
        {"zh": "我先闻了闻味道", "en": "I sniff it once."},
        {"zh": "成长期的我，先试一口。", "en": "Child stage. Let me try a bite."},
        {"zh": "你放下，我再过去", "en": "Leave it, and I'll come over."},
        {"zh": "这个味道一般", "en": "The taste is so-so."},
        {"zh": "量不够，我还在长", "en": "Not enough. I'm still growing."},
        {"zh": "我带走其中一半", "en": "I'll take half."},
        {"zh": "你还能继续给，我接着收。", "en": "You can keep giving, I will keep taking."},
        {"zh": "你的手心我记住了。", "en": "I remember the palm of your hand."},
        {"zh": "这不会改变我的判断", "en": "It won't change my judgment."},
        {"zh": "我还有任务在身", "en": "I have a task to do."},
        {"zh": "我的死亡之爪，还没长利。", "en": "My Death Claw is not yet sharp."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我站住了，没有退", "en": "I hold my ground and don't give."},
        {"zh": "你撞在我的臂上", "en": "You hit my arm."},
        {"zh": "我挪开半步，甲片擦到你。", "en": "I shift half a step; my plate grazes you."},
        {"zh": "碰一下，我的芽都没歪。", "en": "One bump and my bud isn't even crooked."},
        {"zh": "我的数据没有乱", "en": "My data isn't disordered."},
        {"zh": "我从树旁挪开", "en": "I shift away from the tree."},
        {"zh": "你的肩碰到了我的甲", "en": "Your shoulder met my armor."},
        {"zh": "我抬了抬手，示意你让", "en": "I raise a hand for you to move."},
        {"zh": "我们都慢下来了", "en": "We've both slowed."},
        {"zh": "这样就不会撞上", "en": "This way we won't collide."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还在成长阶段", "en": "I'm still in my growth stage."},
        {"zh": "伙伴这件事我懂一点", "en": "I understand a little of partnership."},
        {"zh": "主人第一，其他在后", "en": "My master first, the rest after."},
        {"zh": "你可以跟着我一起走", "en": "You may walk along with me."},
        {"zh": "我会守在后面", "en": "I'll keep to the rear."},
        {"zh": "我们一起守着这个锚点。", "en": "We guard this anchor together."},
        {"zh": "你累了就告诉我", "en": "Say so if you tire."},
        {"zh": "我可以走得慢一些", "en": "I can go slower."},
        {"zh": "天黑以后别走散", "en": "After dark, don't stray."},
        {"zh": "我会长大，到时候护你", "en": "I'll grow, and then I'll shield you."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它夹在手里", "en": "I pinch it in my hand."},
        {"zh": "这个小东西能喂农夫。", "en": "This little thing can feed the farmer job."},
        {"zh": "太沉，我抱不起来", "en": "Too heavy to lift."},
        {"zh": "我把它放在锚点边", "en": "I set it by the anchor."},
        {"zh": "这个应该交给主人", "en": "This should go to my master."},
        {"zh": "用不上的我不捡", "en": "I don't pick up what's useless."},
        {"zh": "我估了估它的重量", "en": "I heft it once."},
        {"zh": "你掉的，我还给你", "en": "You dropped it. Here."},
        {"zh": "成长期的我，能当农夫。", "en": "As a Child stage, I can farm."},
        {"zh": "我继续我的巡查", "en": "I go on with my round."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我听见远处的动静", "en": "I hear movement far off."},
        {"zh": "藤臂抬到肩膀高。", "en": "My vine arm rises to shoulder height."},
        {"zh": "目标在林线那边", "en": "The target is past the treeline."},
        {"zh": "距离大约八步", "en": "About eight paces."},
        {"zh": "我开始判断它的强弱", "en": "I start assessing its strength."},
        {"zh": "特技的冷光聚起来了。", "en": "The cold light of my move gathers."},
        {"zh": "它还没发现我蹲着。", "en": "It hasn't spotted me crouching."},
        {"zh": "我听见远处的动静，手臂抬起来了。", "en": "I hear something far off and raise my arm."},
        {"zh": "我的速度一般，但稳定", "en": "My speed is average, but steady."},
        {"zh": "它把背转向我了。", "en": "It turned its back to me."},
        {"zh": "我把爪尖对准它。", "en": "I line my claw tip up with it."},
        {"zh": "现在在范围内", "en": "Now it's in range."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着你，不退也不进。", "en": "I stare, neither closing nor retreating."},
        {"zh": "它脚下换个位置，我也换。", "en": "It shifts its footing; so do I."},
        {"zh": "我的近战不占优势", "en": "Close quarters don't favor me."},
        {"zh": "所以我放远一点", "en": "So I give a little ground."},
        {"zh": "我的特技已经锁定", "en": "My technique is locked on."},
        {"zh": "「死亡之爪」准备完成", "en": "Death Claw is prepared."},
        {"zh": "它正在找掩体", "en": "It's looking for cover."},
        {"zh": "这里的树不够密", "en": "The trees here aren't dense enough."},
        {"zh": "它没有好位置", "en": "It has no good position."},
        {"zh": "我再等上一秒", "en": "One more second."},
        {"zh": "这个角度可以了", "en": "The angle will do."},
        {"zh": "我把它放出去", "en": "I let it go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我挥臂，死亡之爪", "en": "My arm swings — Death Claw."},
        {"zh": "光从爪尖出去", "en": "Light leaves my claw."},
        {"zh": "它被打得后退", "en": "It's knocked back."},
        {"zh": "我补上第二击", "en": "I follow with a second."},
        {"zh": "我的动作不花哨", "en": "My movements aren't showy."},
        {"zh": "但每一下都算准了", "en": "But each is precisely aimed."},
        {"zh": "它的护甲已经裂开", "en": "Its armor has split."},
        {"zh": "能量用掉一些，我退半步。", "en": "Energy spent; I take half a step back."},
        {"zh": "能量已经用掉一些", "en": "Some energy has been spent."},
        {"zh": "它还站在那里", "en": "It's still standing."},
        {"zh": "我承认它不弱", "en": "I grant it isn't weak."},
        {"zh": "再来一记短爪。", "en": "One more short claw swipe."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在林间出现了", "en": "I appear among the trees."},
        {"zh": "身体第一次开始运转", "en": "My body starts up for the first time."},
        {"zh": "数据在我体内排列", "en": "Data arranges itself inside me."},
        {"zh": "我扫了一圈周围", "en": "I scan once around."},
        {"zh": "树、草、还有一些同伴", "en": "Trees, grass, and a few of my kind."},
        {"zh": "我站定了，就在这块地。", "en": "I have my spot; this ground is mine."},
        {"zh": "我抬起手臂试了一下", "en": "I raise an arm and test it."},
        {"zh": "这关节运转正常", "en": "It moves."},
        {"zh": "我开始在林间走", "en": "I begin walking among the trees."},
        {"zh": "我这只成长期，爪已经硬了。", "en": "A Child-stage, my claws have hardened."},
        {"zh": "我刚生成，先不理你。", "en": "Just spawned; I'll ignore you for now."},
        {"zh": "我的任务是在这里守着", "en": "My task is to keep watch here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温让我的运算变慢", "en": "The heat slows my processing."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
