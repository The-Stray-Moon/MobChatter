{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踏过草皮很响。", "en": "My feet thud on the turf."},
        {"zh": "肩上的斧头晃着。", "en": "The axe on my shoulder sways."},
        {"zh": "我在平原上大步走。", "en": "I stride across the plain."},
        {"zh": "脚底碾碎干草。", "en": "Dry grass crunches under me."},
        {"zh": "锚点还在我后面。", "en": "My anchor is still behind me."},
        {"zh": "我踩着碎石，压过草皮。", "en": "I crush gravel underfoot and press through turf."},
        {"zh": "风把我的披风扯起来。", "en": "Wind pulls my cape out."},
        {"zh": "我一步一步压着地。", "en": "Step by step I press the ground."},
        {"zh": "太阳照在金属上。", "en": "Sun glints on metal."},
        {"zh": "我扭头看了看远处。", "en": "I glance into the distance."},
        {"zh": "这一片很开阔。", "en": "This stretch is wide open."},
        {"zh": "我慢慢回到锚点边。", "en": "I drift back to my anchor."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把斧头放下。", "en": "I set the axe down."},
        {"zh": "披风被风吹得响。", "en": "My cape snaps in the wind."},
        {"zh": "我攥了攥拳头。", "en": "I clench a fist."},
        {"zh": "金属上有一点划痕。", "en": "A scratch on my plating."},
        {"zh": "我闻到了废料味。", "en": "I smell scrap metal."},
        {"zh": "远处有火车的声音吗。", "en": "Is that a train I hear?"},
        {"zh": "我把斧柄擦干净。", "en": "I wipe the axe haft."},
        {"zh": "我靠在斧柄上。", "en": "I lean on the axe haft."},
        {"zh": "风沙打在我身上。", "en": "Wind and dust hit me."},
        {"zh": "我在想下一场对战。", "en": "I'm thinking of the next bout."},
        {"zh": "肩甲有点磨。", "en": "My pauldron chafes."},
        {"zh": "我往天上看了一眼。", "en": "I glance at the sky."},
        {"zh": "披风挂住了斧柄，我扯开。", "en": "My cape snags the haft; I pull it free."},
        {"zh": "这一带没什么能吃的。", "en": "Not much to eat here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的影子落到我的斧上了。", "en": "Your shadow has fallen on my axe."},
        {"zh": "你手里那东西是废铁吗。", "en": "Is that scrap in your hand?"},
        {"zh": "我的斧很重。", "en": "My axe is heavy."},
        {"zh": "报上名字，我从不打无名的人。", "en": "Give your name; I don't fight the nameless."},
        {"zh": "你也想打一场？", "en": "Care for a bout?"},
        {"zh": "你的手握不稳东西。", "en": "Your grip isn't steady."},
        {"zh": "别拿拳头试我的肩甲。", "en": "Don't test my pauldron with your fist."},
        {"zh": "你是来训练的吗。", "en": "Are you here to train?"},
        {"zh": "这片地方我管着。", "en": "I keep this ground."},
        {"zh": "刀刃别冲我这边摆。", "en": "Don't point that edge my way."},
        {"zh": "我不喜欢偷袭。", "en": "I dislike cheap shots."},
        {"zh": "你把身体站直点。", "en": "Stand up straight."},
        {"zh": "你要喂我废料吗。", "en": "Got scrap to feed me?"},
        {"zh": "你闻起来很像人类。", "en": "You smell human."},
        {"zh": "我的斧不会自己动。", "en": "My axe doesn't swing itself."},
        {"zh": "你倒是说句话啊。", "en": "Say something, then."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲上多了一道。", "en": "A new line on my plating."},
        {"zh": "这一点没让我松开斧子。", "en": "That didn't make me loosen my axe."},
        {"zh": "牙关咬得太紧，嘴里有铁味。", "en": "I clench so hard my mouth tastes of iron."},
        {"zh": "斧柄有点滑。", "en": "The haft is slick now."},
        {"zh": "血顺着金属流。", "en": "Blood runs down the metal."},
        {"zh": "我手还握着斧。", "en": "I still hold the axe."},
        {"zh": "这点伤不碍挥斧。", "en": "This won't spoil my swing."},
        {"zh": "斧柄顶住地面，我没倒。", "en": "The haft braces the ground; I stay up."},
        {"zh": "甲缝渗出血，我抹了一把。", "en": "Blood seeps from a seam; I wipe it away."},
        {"zh": "我这一斧还挥得动。", "en": "I can still swing this axe."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是废铁吗？", "en": "Is that scrap?"},
        {"zh": "丢过来就行。", "en": "Just toss it over."},
        {"zh": "这块金属不错。", "en": "That metal looks good."},
        {"zh": "我真的能吃这个？", "en": "Can I really eat this?"},
        {"zh": "嚼起来有点硬。", "en": "It chews a bit hard."},
        {"zh": "还有别的废料吗。", "en": "Any more scrap?"},
        {"zh": "这东西能补力气。", "en": "This restores my strength."},
        {"zh": "别一脚踩上去。", "en": "Don't step on it."},
        {"zh": "我不挑，什么废料都行。", "en": "I'm not picky. Any scrap."},
        {"zh": "那堆螺丝归我。", "en": "Those screws are mine."},
        {"zh": "铁锈味更香。", "en": "Rust smells even better."},
        {"zh": "放地上我过去拿。", "en": "Set it down. I'll take it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的金属上。", "en": "You hit my plating."},
        {"zh": "我的靴底在地上碾出印子。", "en": "My boots grind a print into the ground."},
        {"zh": "往旁边退开半步。", "en": "Half a step back."},
        {"zh": "你的手疼了吧。", "en": "Your hand must sting."},
        {"zh": "这一下像撞墙。", "en": "That felt like a wall."},
        {"zh": "我脚步很沉。", "en": "My steps are heavy."},
        {"zh": "地被我踩陷了。", "en": "The ground gave under me."},
        {"zh": "别拉我的披风。", "en": "Don't pull my cape."},
        {"zh": "你撞上来，我脚下的土陷了。", "en": "You slam in and the dirt sinks under me."},
        {"zh": "再来也一样。", "en": "Same thing if you try again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "战斗中才有这种话。", "en": "Such talk belongs in a fight."},
        {"zh": "我还没打够。", "en": "I haven't fought enough yet."},
        {"zh": "你把斧头放下再说话。", "en": "Put your axe down first."},
        {"zh": "我不太会这个。", "en": "I'm not much good at this."},
        {"zh": "等我练完这一段。", "en": "After this training round."},
        {"zh": "摔跤你或许能赢我一次。", "en": "In a wrestle you might take me once."},
        {"zh": "一起打一场更有意思。", "en": "A bout together would be more fun."},
        {"zh": "我记着你的名字。", "en": "I'll remember your name."},
        {"zh": "别站那么远。", "en": "Don't stand so far off."},
        {"zh": "练完这一轮再说。", "en": "After this round."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块废料归我。", "en": "This scrap is mine."},
        {"zh": "废铁在我齿间发出响声。", "en": "The scrap grinds between my teeth."},
        {"zh": "我的牙很硬。", "en": "My teeth are hard."},
        {"zh": "这块实在太轻。", "en": "This is far too light."},
        {"zh": "掂了掂，这块能打钉子。", "en": "I weigh it: this could be hammered into nails."},
        {"zh": "这能打一把好斧。", "en": "This would make a good axe."},
        {"zh": "地上还有一堆。", "en": "A pile more on the ground."},
        {"zh": "废料归进我腰侧的皮袋。", "en": "The scrap goes into the pouch at my hip."},
        {"zh": "味道很实在。", "en": "A solid taste."},
        {"zh": "我留一半给你。", "en": "I'll keep half for you."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "尘土扬起来了。", "en": "Dust is rising."},
        {"zh": "斧头握紧了。", "en": "My axe hand tightens."},
        {"zh": "风把味道送来。", "en": "The wind brings the scent."},
        {"zh": "我已经看着它了。", "en": "I've got eyes on it."},
        {"zh": "这一块空地正好。", "en": "This open ground works."},
        {"zh": "我靴尖踢起一团土。", "en": "My boot toe kicks up a puff of dirt."},
        {"zh": "它站得很稳。", "en": "It stands steady."},
        {"zh": "它手里有东西。", "en": "It's holding something."},
        {"zh": "我把斧举到肩高。", "en": "Axe up to shoulder height."},
        {"zh": "我退路在锚点那边。", "en": "My fallback is the anchor."},
        {"zh": "别想绕过去。", "en": "Don't try to go around."},
        {"zh": "斧子举起来了，你看着。", "en": "The axe is up; watch it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它的脚步乱了，我听得出。", "en": "Its stride has broken; I can hear it."},
        {"zh": "它在往石头那边退。", "en": "It's backing toward the stones."},
        {"zh": "我的距离刚好。", "en": "My range is right."},
        {"zh": "我举斧的姿势不变。", "en": "I keep the axe high."},
        {"zh": "它在看我的斧。", "en": "It's watching my axe."},
        {"zh": "我等它先举兵器。", "en": "I wait for it to raise steel."},
        {"zh": "脚下的地很实。", "en": "The ground is solid here."},
        {"zh": "它喘得很急。", "en": "It's breathing hard."},
        {"zh": "它的甲有条缝。", "en": "There's a seam in its armor."},
        {"zh": "再放它两步。", "en": "Two more paces."},
        {"zh": "风突然停了。", "en": "The wind suddenly died."},
        {"zh": "斧刃一直朝前。", "en": "Blade stays forward."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "圣斧从头顶劈下！", "en": "Divine Axe cleaves down!"},
        {"zh": "斧刃扫过去。", "en": "The blade sweeps through."},
        {"zh": "拳头砸你的肩。", "en": "My fist hammers your shoulder."},
        {"zh": "这一下很响。", "en": "That one rang out."},
        {"zh": "我压低身子撞。", "en": "I lower and charge."},
        {"zh": "金属碰金属。", "en": "Metal meets metal."},
        {"zh": "斧背把你推向栅栏。", "en": "The flat of my axe drives you toward the fence."},
        {"zh": "我换手再劈。", "en": "I switch hands and cut again."},
        {"zh": "它挡得很勉强。", "en": "That guard barely held."},
        {"zh": "站稳了，再来一下。", "en": "Steady. Again."},
        {"zh": "斧柄顶你的腹。", "en": "The haft finds your gut."},
        {"zh": "这一击结束了。", "en": "That one settled it."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "平原上落下一个影子。", "en": "A shadow lands on the plain."},
        {"zh": "我扛着斧头出现。", "en": "I appear with my axe shouldered."},
        {"zh": "金属的反光很远就看得见。", "en": "The metal shows from far off."},
        {"zh": "我顺着缓坡踏进这片草。", "en": "I step down the gentle slope into this grass."},
        {"zh": "风从草原上吹来。", "en": "Wind comes across the savanna."},
        {"zh": "这里有我认识的味道。", "en": "A familiar smell here."},
        {"zh": "我把斧放下，先看看。", "en": "I set the axe down and look."},
        {"zh": "我的披风还在响。", "en": "My cape still snaps."},
        {"zh": "我找到了锚点。", "en": "I've found my anchor."},
        {"zh": "远处好像有人。", "en": "Someone seems to be far off."},
        {"zh": "草叶被我的脚压成一片。", "en": "The grass flattens under my feet."},
        {"zh": "这一片我接管了。", "en": "I'm taking this stretch."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "金属被烧得发烫。", "en": "My plating turned hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时膝盖震了一下。", "en": "My knee jarred on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "披风吸满了水。", "en": "My cape soaked through."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪推得我后退。", "en": "The blast pushed me back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头打在甲上弹开。", "en": "An arrow bounced off my plate."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光烫穿了我的甲。", "en": "The light burned through my plating."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没废料吃，力气少了。", "en": "No scrap, less strength."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着金属跑。", "en": "Lightning ran down the metal."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下面空落落的。", "en": "Empty under my feet."}
      ]
    }
  }
}
