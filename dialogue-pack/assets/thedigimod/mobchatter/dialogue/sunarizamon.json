{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面四足爬行", "en": "I crawl low on four limbs."},
        {"zh": "身上的甲片一层叠一层", "en": "My plates overlap layer by layer."},
        {"zh": "沙子从我爪下滑走", "en": "Sand slides from under my claws."},
        {"zh": "我沿着岩壁的边缘走", "en": "I keep to the edge of the rock wall."},
        {"zh": "我的尾巴在沙上划出一条线。", "en": "My tail draws a line in the sand."},
        {"zh": "头低着，像在找什么", "en": "Head down, as if searching."},
        {"zh": "我在这一带找矿", "en": "I'm looking for ore."},
        {"zh": "那是我要吃的东西", "en": "That's what I eat."},
        {"zh": "我朝深色的石头去", "en": "I head for the darker stone."},
        {"zh": "闻了闻，就是这个", "en": "I sniff. This is it."},
        {"zh": "我趴下去慢慢啃", "en": "I lie down and gnaw."},
        {"zh": "石头碎屑从嘴边掉", "en": "Stone chips fall from my mouth."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我趴在岩石上", "en": "I lie on the rock."},
        {"zh": "甲片被太阳晒得发热", "en": "Sun has warmed my plates."},
        {"zh": "尾巴慢慢地摆动", "en": "My tail sways slowly."},
        {"zh": "眼睛半眯了起来", "en": "My eyes are half shut."},
        {"zh": "我在这里待了一段时间", "en": "I've been here a while."},
        {"zh": "这座矿还够吃", "en": "This vein still has enough."},
        {"zh": "崖上有风吹过", "en": "Wind crosses the cliff."},
        {"zh": "我抬起头，又低下去", "en": "I lift my head, then lower it."},
        {"zh": "有东西在下面走", "en": "Something walks below."},
        {"zh": "我把头侧过来听", "en": "I listen."},
        {"zh": "我的尾巴停住", "en": "My tail goes still."},
        {"zh": "这片沙地被我晒得很热。", "en": "I've baked this sand patch hot."},
        {"zh": "我守着这座矿", "en": "I guard this vein."},
        {"zh": "谁都不许靠近", "en": "No one comes near it."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我从岩石上抬头", "en": "I raise my head from the rock."},
        {"zh": "你站在我的矿边上", "en": "You're standing by my vein."},
        {"zh": "甲片一片片立起来", "en": "My plates lift one by one."},
        {"zh": "我的尾巴在沙上划出线。", "en": "My tail scores a line in the sand."},
        {"zh": "我缓缓直起身", "en": "I rise up slowly."},
        {"zh": "四只脚分开站", "en": "Four feet spread."},
        {"zh": "你比我想的小一些。", "en": "You're a bit smaller than I thought."},
        {"zh": "可那并不重要", "en": "That doesn't matter."},
        {"zh": "重要的是这块石头", "en": "What matters is this stone."},
        {"zh": "你最好先退开", "en": "You'd best back off."},
        {"zh": "我只说这一次", "en": "I'll say it once."},
        {"zh": "然后就是沙子", "en": "After that, sand."},
        {"zh": "你手里那块东西在反光。", "en": "That thing in your hand is catching light."},
        {"zh": "看着不像能吃", "en": "Doesn't look edible."},
        {"zh": "我盯了一会儿", "en": "I stare at it a while."},
        {"zh": "然后才转回去", "en": "Then turn back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我闷声低吼一下", "en": "I growl under my breath."},
        {"zh": "甲片上多了一道", "en": "A mark on my plates."},
        {"zh": "我往后错开一步", "en": "I shift a step back."},
        {"zh": "爪子一直抓着地", "en": "My claws keep hold of the ground."},
        {"zh": "沙被踩得乱飞", "en": "Sand sprays from my feet."},
        {"zh": "我顺势停住脚", "en": "I come to a halt."},
        {"zh": "喉咙里又蓄了东西", "en": "Something gathers in my throat again."},
        {"zh": "这一次不是威胁", "en": "This time it's not a threat."},
        {"zh": "这就是我的回答", "en": "It's an answer."},
        {"zh": "沙甲裂开，沙子漏出来。", "en": "My sand armor cracks; sand leaks out."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这真的是矿石吗", "en": "Is that really ore?"},
        {"zh": "我鼻子凑过去", "en": "My nose comes close."},
        {"zh": "闻着不太像矿", "en": "Smells not quite right."},
        {"zh": "但我还是咬了一口", "en": "Still, I take a bite."},
        {"zh": "居然能咬得动", "en": "Teeth sink in."},
        {"zh": "味道比普通的石头怪", "en": "Strange taste, for stone."},
        {"zh": "我又狠咬一口", "en": "I bite hard again."},
        {"zh": "这一口好得多", "en": "Better."},
        {"zh": "我叼到岩壁下面", "en": "I carry it under the wall."},
        {"zh": "留着以后慢慢吃", "en": "Save it for later."},
        {"zh": "那甜味让我伸出舌头。", "en": "That sweetness makes me lick my lips."},
        {"zh": "看你给不给我", "en": "To see if you'll give it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得侧滑了一步", "en": "The bump slides me sideways."},
        {"zh": "爪子在地上划出痕", "en": "My claws gouge the ground."},
        {"zh": "我缓缓转过身去", "en": "I turn around slowly."},
        {"zh": "你撞在我背上，手一麻。", "en": "You hit my back and your hand goes numb."},
        {"zh": "你居然一步没退", "en": "You don't step back."},
        {"zh": "我也一步不退", "en": "Neither do I."},
        {"zh": "两块硬的撞在一起", "en": "Two hard things met."},
        {"zh": "谁先软下来谁输", "en": "Whoever softens first loses."},
        {"zh": "沙蜥蜴兽，趴在矿物上等。", "en": "Sunarizamon waits on the minerals."},
        {"zh": "看你打算怎么办", "en": "Let's see what you do."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这里的数码兽不多", "en": "Not many digimon here."},
        {"zh": "我见过一只走过去的", "en": "I saw one pass by once."},
        {"zh": "它并没有停下", "en": "It didn't stop."},
        {"zh": "我也就没有叫", "en": "I didn't call out."},
        {"zh": "各自找各自的矿", "en": "Each of us finds our own ore."},
        {"zh": "这倒也算不错", "en": "That's not bad either."},
        {"zh": "岩壁上洞很多", "en": "There are many hollows in this wall."},
        {"zh": "我睡在最大的那个", "en": "I sleep in the biggest."},
        {"zh": "夜里风要小些", "en": "Less wind at night."},
        {"zh": "睡到天亮再出去", "en": "Sleep till dawn, then out again."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前爪把它刨出来。", "en": "I scrape it out with my foreclaws."},
        {"zh": "然后一口咬下来", "en": "Then I bite it free."},
        {"zh": "嚼起来很费力", "en": "Chewing takes effort."},
        {"zh": "但这是我的食物", "en": "But this is my food."},
        {"zh": "我把碎块收在岩缝", "en": "I stash the pieces in a crack."},
        {"zh": "那里别的都够不到", "en": "Nothing else can reach there."},
        {"zh": "我叼着它爬到石头上。", "en": "I carry it in my mouth onto a rock."},
        {"zh": "没有人跟着我", "en": "No one's following."},
        {"zh": "我埋头接着啃", "en": "I go back to gnawing."},
        {"zh": "我把头转向岩缝", "en": "I turn my head to the crack."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在动我的矿", "en": "You're touching my vein."},
        {"zh": "我把头昂起来", "en": "I lift my head up."},
        {"zh": "喉咙里开始蓄东西", "en": "Something gathers in my throat."},
        {"zh": "我背上的甲片全竖起来。", "en": "Every plate on my back stands up."},
        {"zh": "四只脚抓紧地", "en": "Four feet dig in."},
        {"zh": "沙子在我脚下流动", "en": "Sand shifts under me."},
        {"zh": "我要用上沙子", "en": "I'll use the sand."},
        {"zh": "这地方沙子多", "en": "Plenty of sand here."},
        {"zh": "正好是我的地盘", "en": "Which makes it my ground."},
        {"zh": "我把大嘴张开", "en": "Open."},
        {"zh": "那就尝尝沙暴", "en": "Sand blast."},
        {"zh": "这会儿别眨眼", "en": "Don't blink now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我围着你兜圈", "en": "I pace around you."},
        {"zh": "每一步都扬起沙", "en": "Each step raises sand."},
        {"zh": "沙落在我背上", "en": "It settles on my back."},
        {"zh": "甲片的颜色变浅了", "en": "My plates are going pale."},
        {"zh": "这是沙的颜色", "en": "That's sand's color."},
        {"zh": "你看不清我在哪", "en": "You lose track of me."},
        {"zh": "我站上风口，沙朝你刮。", "en": "I take the windward side and blow sand at you."},
        {"zh": "风把沙吹向你", "en": "Wind pushes sand at you."},
        {"zh": "你捂住了眼睛", "en": "You cover your eyes."},
        {"zh": "那样就更看不见", "en": "That makes it worse."},
        {"zh": "我从侧面上来", "en": "I come from the side."},
        {"zh": "这一下你接不住", "en": "You won't block this."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的牙咬穿了你的袖子。", "en": "My teeth tear through your sleeve."},
        {"zh": "牙齿在铁上打滑", "en": "My teeth skid on iron."},
        {"zh": "我再狠啃一口", "en": "I gnaw hard again."},
        {"zh": "这一回咬实了", "en": "This bite holds true."},
        {"zh": "爪子抓在你腿上", "en": "My claws rake your leg."},
        {"zh": "尾巴横着抽过来", "en": "My tail whips across."},
        {"zh": "沙从嘴里喷出去", "en": "Sand sprays from my mouth."},
        {"zh": "我甩尾把你扫倒在沙里。", "en": "My tail sweeps your legs out on the sand."},
        {"zh": "我又压低身体", "en": "I flatten again."},
        {"zh": "我再啃一口下去", "en": "I sink my teeth again."},
        {"zh": "我从侧面扑过去", "en": "I lunge from the side."},
        {"zh": "落地扬起一片沙", "en": "Sand sprays where I land."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "岩壁上有个影子动了", "en": "A shape moves on the rock wall."},
        {"zh": "那个影子就是我", "en": "It's me."},
        {"zh": "我从滚烫的沙里钻出来。", "en": "I dig out of the scalding sand."},
        {"zh": "甲片上全是灰", "en": "My plates are coated in dust."},
        {"zh": "这里的矿很多", "en": "Plenty of ore here."},
        {"zh": "我一嗅就知道了", "en": "One sniff and I know."},
        {"zh": "崖顶的风很干", "en": "Dry wind off the cliff top."},
        {"zh": "我喜欢干的地方", "en": "I like it dry."},
        {"zh": "慢慢往下爬，沙在滑。", "en": "Climbing down slowly. The sand slides."},
        {"zh": "先找个好位置", "en": "Find a spot."},
        {"zh": "那就选定这里", "en": "Here."},
        {"zh": "那就马上开始吃", "en": "Start eating."}
      ]
    },
