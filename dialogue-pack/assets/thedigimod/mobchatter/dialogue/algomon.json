{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘着走，很轻。", "en": "I drift along, very light."},
        {"zh": "我才刚出生。", "en": "I've only just hatched."},
        {"zh": "一团小小的黑影。", "en": "A small dark blob."},
        {"zh": "我的触须在探路。", "en": "My tendrils probe the way."},
        {"zh": "我跳一下，挪一挪。", "en": "A hop, a shuffle."},
        {"zh": "我走得不快，也不稳。", "en": "Not fast, not steady."},
        {"zh": "这世界好大。", "en": "The world is so big."},
        {"zh": "我贴着地面前进。", "en": "I keep low to the ground."},
        {"zh": "身后拖着一小段影。", "en": "A tiny shadow trails me."},
        {"zh": "我不知道要去哪儿。", "en": "I don't know where I'm going."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，晃了晃。", "en": "I hover and wobble."},
        {"zh": "风一吹，我就偏。", "en": "Wind makes me drift."},
        {"zh": "我盯着叶片上的水珠。", "en": "I stare at a droplet on a leaf."},
        {"zh": "身体里像有气泡。", "en": "It feels like bubbles inside me."},
        {"zh": "我在慢慢长大。", "en": "I'm slowly growing."},
        {"zh": "周围都是新东西。", "en": "Everything here is new."},
        {"zh": "我数着自己身上的气泡", "en": "I count the bubbles drifting inside me."},
        {"zh": "我的形状还不太定。", "en": "My shape isn't settled."},
        {"zh": "我把身子团得更紧。", "en": "I gather myself in tighter."},
        {"zh": "远处飘来一点声响。", "en": "A small sound drifts from afar."},
        {"zh": "我转了半个身位。", "en": "I turn half about."},
        {"zh": "我在试着呼吸。", "en": "I'm trying to breathe."},
        {"zh": "身上有一点光。", "en": "A little light on me."},
        {"zh": "我静静飘着。", "en": "I drift quietly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我大得太多了。", "en": "You're far bigger than me."},
        {"zh": "我仰起身体望你。", "en": "I rear up my little body to look."},
        {"zh": "你身上没有数据。", "en": "You carry no data."},
        {"zh": "我认不得你是谁。", "en": "I don't know who you are."},
        {"zh": "你是来捉我的吗？", "en": "Have you come to catch me?"},
        {"zh": "我又往后缩了缩。", "en": "I shrink back again."},
        {"zh": "我的触须动了。", "en": "My tendrils move."},
        {"zh": "我发出小小的声音。", "en": "I make a small sound."},
        {"zh": "我们离得好近。", "en": "We're very close."},
        {"zh": "我要不要跑？", "en": "Should I run?"},
        {"zh": "我不太会跑。", "en": "I'm not good at running."},
        {"zh": "我也许可以信你。", "en": "Maybe I can trust you."},
        {"zh": "我试着靠近一点。", "en": "I try coming a little closer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被挤得扁了一点。", "en": "I've been pressed flat a bit."},
        {"zh": "我飘不起来了。", "en": "I can't float."},
        {"zh": "这点疼，我记住了。", "en": "I'll remember this pain."},
        {"zh": "我慢慢飘回去。", "en": "I drift slowly back."},
        {"zh": "我发出一声细响。", "en": "A small sound escapes me."},
        {"zh": "我被挤得扁了一点，形状散了。", "en": "I have been squeezed flat, my shape loosening."},
        {"zh": "我还能飘起来。", "en": "I can still float."},
        {"zh": "泡泡破了，我也疼。", "en": "The bubble burst, and it hurt."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西是什么呢？", "en": "What is that thing?"},
        {"zh": "闻起来不一样。", "en": "It smells different."},
        {"zh": "我一点点飘过去。", "en": "I drift over bit by bit."},
        {"zh": "这是给我吃的吗？", "en": "Is this for me to eat?"},
        {"zh": "我咬不动太硬的。", "en": "I can't bite anything hard."},
        {"zh": "把东西放到我够得着。", "en": "Set it within my reach."},
        {"zh": "我心里有点发慌。", "en": "I'm a little uneasy."},
        {"zh": "我要不要试一口？", "en": "Should I try a bite?"},
        {"zh": "谢你这一小口。", "en": "Thanks for this small bite."},
        {"zh": "我还想再吃一口。", "en": "I'd like another bite."},
        {"zh": "这比露水好。", "en": "Better than dew."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "这一碰把我掀开了。", "en": "That knock swept me off."},
        {"zh": "我轻得像一团气。", "en": "I'm light as a puff of air."},
        {"zh": "我翻了个身，飘起来。", "en": "I tumble and float up."},
        {"zh": "你碰到我的时候，软软的。", "en": "I felt soft when you touched me."},
        {"zh": "我赶紧飘开。", "en": "I drift away quickly."},
        {"zh": "我粘到你的手上了。", "en": "I've stuck to your hand."},
        {"zh": "我抖了抖，气泡差点散开", "en": "I wobble, and my bubbles nearly scatter."},
        {"zh": "你脚下留点神。", "en": "Watch your step."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我刚破壳，还早。", "en": "I just hatched; far too early."},
        {"zh": "同类？我还没见过。", "en": "Kin? I haven't met any."},
        {"zh": "我还会长大的。", "en": "I'll grow up."},
        {"zh": "现在只想看看世界。", "en": "For now I only want to see the world."},
        {"zh": "别问我这个。", "en": "Don't ask me that."},
        {"zh": "我晃着飘开了。", "en": "I wobble away."},
        {"zh": "这离我还太远了。", "en": "That's far beyond me yet."},
        {"zh": "我歪了歪身子。", "en": "I tilt."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一根触须就卷得住。", "en": "One tendril is enough to hold it."},
        {"zh": "这东西压得我下沉。", "en": "This is heavy enough to sink me."},
        {"zh": "我在手里转了转。", "en": "I turn it about."},
        {"zh": "掉了，我找不到。", "en": "Dropped; I can't find it."},
        {"zh": "这东西对我有什么用？", "en": "What use is this to me?"},
        {"zh": "它上面有水。", "en": "There's water on it."},
        {"zh": "我把它顶在身子上头。", "en": "I balance it atop myself."},
        {"zh": "这点东西，我能带。", "en": "I can carry this much."},
        {"zh": "我吞了一小口。", "en": "I swallow a little."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在看我。", "en": "Something's watching me."},
        {"zh": "我把自己收成小球。", "en": "I pull into a little ball."},
        {"zh": "那不是风吹的。", "en": "That wasn't the wind."},
        {"zh": "我开始发抖。", "en": "I'm trembling."},
        {"zh": "我朝草丛那边飘。", "en": "I drift toward the grass."},
        {"zh": "它还没我一半大。", "en": "It's not half my size."},
        {"zh": "这一点点勇气。", "en": "Just a little courage."},
        {"zh": "也许我能挡一下。", "en": "Maybe I can block it."},
        {"zh": "我的眼睛离不开它。", "en": "I can't look away from it."},
        {"zh": "别再往前挪了。", "en": "Don't come any further."},
        {"zh": "我抱住了一片叶子。", "en": "I cling to a leaf."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我缩到叶背，只吹出个小泡", "en": "I shrink under a leaf and blow a single small bubble."},
        {"zh": "我动一下，它就动。", "en": "I move; it moves."},
        {"zh": "我这点身子太小。", "en": "This little body is too small."},
        {"zh": "我吹出一个小泡泡。", "en": "I blow a small bubble."},
        {"zh": "泡泡飘过去了。", "en": "The bubble drifts over."},
        {"zh": "我只能做这个。", "en": "This is all I can do."},
        {"zh": "我一歪，就偏了方向。", "en": "One wobble and I drift off course."},
        {"zh": "它好像拿不定主意。", "en": "It seems unsure."},
        {"zh": "我再吹一个。", "en": "I blow another."},
        {"zh": "我的触须竖着。", "en": "My tendrils stand up."},
        {"zh": "你走远些，好吗？", "en": "Would you go farther off?"},
        {"zh": "我这团身子快散了。", "en": "This little body is coming apart."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞它一下！", "en": "I bump into it!"},
        {"zh": "我的泡泡打在它脸上。", "en": "My bubble bursts on its face."},
        {"zh": "我把整个身子顶上去。", "en": "I throw my whole body at it."},
        {"zh": "这点力气，很小。", "en": "It's very little force."},
        {"zh": "我又飘上去。", "en": "I float in again."},
        {"zh": "我吐出的泡，是技能。", "en": "The bubble I spit is my move."},
        {"zh": "我的牙刚长出来。", "en": "My teeth have only just come in."},
        {"zh": "它退了一点。", "en": "It backed off a little."},
        {"zh": "我这团身子一鼓一缩。", "en": "My little body swells and shrinks."},
        {"zh": "我再来一次也行。", "en": "I can try again."},
        {"zh": "别把我当成小虫。", "en": "Don't take me for a bug."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从数码蛋里出来。", "en": "I've come out of a Digitama."},
        {"zh": "光一闪，我就有了形状。", "en": "A flash, and I have a shape."},
        {"zh": "四周都是新的。", "en": "Everything is new."},
        {"zh": "草叶刮过我刚成形的小身子", "en": "Blades of grass brush my newly formed little body."},
        {"zh": "我试着飘起来。", "en": "I try to float."},
        {"zh": "晨露落在我的身上。", "en": "Dew settles on me."},
        {"zh": "这片草里只有我一个。", "en": "I'm the only one in this grass."},
        {"zh": "我听到了鸟叫。", "en": "I hear birds."},
        {"zh": "我慢慢往前飘。", "en": "I drift forward slowly."},
        {"zh": "先看看这个世界的。", "en": "First, let me look at this world."},
        {"zh": "这儿的空气有点凉。", "en": "The air here is a little cold."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，我就缩水了。", "en": "Fire shrivels me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，滚了两圈。", "en": "I fall and roll twice."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我裹住，我浮不起来。", "en": "Water wraps me; I can't rise."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹飞了。", "en": "The blast blows me away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过我。", "en": "Something passes through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我很难受。", "en": "That force makes me queasy."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一闪，我直发抖。", "en": "A flash, and I tremble."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘下去，一直飘。", "en": "I drift down, and down."}
      ]
    }
  }
}
