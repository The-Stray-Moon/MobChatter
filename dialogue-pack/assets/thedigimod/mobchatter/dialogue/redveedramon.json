{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我四条腿踏在草地上。", "en": "I tread the grass on four legs."},
        {"zh": "我是个成熟期的数码兽。", "en": "I'm a Champion-level Digimon."},
        {"zh": "我沿着锚点附近走动。", "en": "I walk near my anchor point."},
        {"zh": "我的速度比看起来快。", "en": "I'm faster than I look."},
        {"zh": "我在地上跑了一小段。", "en": "I run a short stretch."},
        {"zh": "我斜着尾巴往前跑。", "en": "I swing my tail."},
        {"zh": "我朝训练场那边走。", "en": "I head for the training ground."},
        {"zh": "我的爪尖翻开一层草皮。", "en": "My claw tips peel up a layer of turf."},
        {"zh": "我走起来很稳。", "en": "My stride is steady."},
        {"zh": "我沿着平原边缘巡。", "en": "I patrol the plains' edge."},
        {"zh": "我贴着草皮逼过去。", "en": "I close in step by step."},
        {"zh": "我在看四周的动静。", "en": "I'm watching for movement."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我守着锚点，没走远。", "en": "I keep to my anchor and don't stray."},
        {"zh": "我的呼吸很匀。", "en": "My breathing is even."},
        {"zh": "草叶的沙沙声我听着。", "en": "I listen to the wind."},
        {"zh": "我的数据流得很平稳。", "en": "My data runs smooth and steady."},
        {"zh": "我蹲在锚点边不动。", "en": "I'm doing nothing."},
        {"zh": "我抬头扫了一眼天色。", "en": "I look up."},
        {"zh": "我在等着训练。", "en": "I wait for training."},
        {"zh": "我的爪子在地上划。", "en": "My claws trace the ground."},
        {"zh": "远处有别的数码兽。", "en": "Another Digimon far off."},
        {"zh": "我慢慢放松下来。", "en": "I slowly relax."},
        {"zh": "我的角有一点点反光。", "en": "My horn catches a little light."},
        {"zh": "我把角上的灰甩掉了。", "en": "I shake the dust off my horn."},
        {"zh": "我把重心换到另一边。", "en": "I shift my weight to the other side."},
        {"zh": "这里的空气很好。", "en": "The air is good here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上没有驯服的标记。", "en": "You carry no tamer's mark."},
        {"zh": "你要训练我吗？", "en": "Are you here to train me?"},
        {"zh": "我的攻击和特攻都不低。", "en": "My attack and special attack are high."},
        {"zh": "我可以在近战和远攻之间换。", "en": "I can switch between melee and range."},
        {"zh": "V-Arrow 需要一点时间。", "en": "V-Arrow takes a moment."},
        {"zh": "你挨我挨得太紧了。", "en": "You're standing too close."},
        {"zh": "这个气味我认得出。", "en": "I know your scent."},
        {"zh": "我的数据还很新。", "en": "My data is still fresh."},
        {"zh": "我们也许能配合。", "en": "We might work well together."},
        {"zh": "你别摸我的角。", "en": "Don't touch my horn."},
        {"zh": "你要我坐下吗？", "en": "Shall I sit?"},
        {"zh": "你若要驯服我，得先赢我。", "en": "If you mean to tame me, you must beat me first."},
        {"zh": "你腰上挂着肉干，我闻到了。", "en": "You have dried meat on your belt. I can smell it."},
        {"zh": "你走前面，我压着步子跟。", "en": "Walk ahead; I'll keep pace behind you."},
        {"zh": "你看着我的时候我在想事。", "en": "I'm thinking while you look at me."},
        {"zh": "我准备好战斗了。", "en": "I'm ready to fight."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的数据乱了。", "en": "My data scrambled."},
        {"zh": "我跳开半步避开。", "en": "I gave half a step."},
        {"zh": "这一下挠得我发麻。", "en": "That stung."},
        {"zh": "我的体力掉了。", "en": "My stamina dropped."},
        {"zh": "这一下只擦破了我的侧腹。", "en": "That only grazed my flank."},
        {"zh": "我侧过身护住伤处。", "en": "I turn to guard the wound."},
        {"zh": "我记住了这个攻击。", "en": "I'll remember that attack."},
        {"zh": "我还不够强大。", "en": "I'm not strong enough yet."},
        {"zh": "你再咬过来试试。", "en": "Again."},
        {"zh": "我不会退开的。", "en": "I won't retreat."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到了肉的味道。", "en": "I smell meat."},
        {"zh": "肉的气息，我可以接受。", "en": "The smell of meat, I can accept that."},
        {"zh": "我够不着，搁在草上吧。", "en": "Set it in the grass. Don't hold it so high."},
        {"zh": "我蹬着爪子蹭过去。", "en": "I approach slowly."},
        {"zh": "这一口远远填不饱。", "en": "Not enough."},
        {"zh": "你是想驯服我吗？", "en": "Are you trying to tame me?"},
        {"zh": "我对吃的没那么执着。", "en": "I'm not that fixated on food."},
        {"zh": "再往下一点，我够得着。", "en": "A little lower, and I can reach it."},
        {"zh": "我吃完了就走。", "en": "I'll eat and go."},
        {"zh": "这点不够我嚼两下。", "en": "That's not enough for two bites."},
        {"zh": "这块肉的气味进我的数据了。", "en": "That meat's smell is in my data now."},
        {"zh": "你的手千万不要抖。", "en": "Hold your hand steady."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的侧腹。", "en": "You bumped my flank."},
        {"zh": "我四只爪子钉在原地。", "en": "All four of my claws are planted."},
        {"zh": "你撞得有点疼。", "en": "That stung a bit."},
        {"zh": "我歪过身子，让开一步。", "en": "I angle my body away and leave you a step."},
        {"zh": "别挡在我的路上。", "en": "Don't block my path."},
        {"zh": "我们互相蹭到了。", "en": "We brushed against each other."},
        {"zh": "我的四条腿很稳。", "en": "My legs are planted."},
        {"zh": "你撞上来，我连头都没低。", "en": "You hit me and I didn't even lower my head."},
        {"zh": "这根本不算什么。", "en": "That's nothing."},
        {"zh": "你再顶也一样。", "en": "Again would be the same."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还野着，不归谁管。", "en": "I'm still wild. No one owns me."},
        {"zh": "这些事我不太懂。", "en": "I don't quite understand such things."},
        {"zh": "我正忙着训练。", "en": "I'm busy training."},
        {"zh": "这不是数码兽的做法。", "en": "That's not how Digimon do things."},
        {"zh": "等我进化以后。", "en": "After I evolve."},
        {"zh": "你站得远一些。", "en": "Stand farther."},
        {"zh": "进化之前，我不谈这些。", "en": "Not before I evolve."},
        {"zh": "换个时候再谈。", "en": "Another time."},
        {"zh": "别耽误我的事。", "en": "Don't hold me up."},
        {"zh": "这一页翻过去吧。", "en": "Later."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我低头把它衔在齿间。", "en": "I lower my head and take it in my teeth."},
        {"zh": "这一块嚼不动。", "en": "This isn't food."},
        {"zh": "它沉得我叼不稳。", "en": "Too heavy."},
        {"zh": "我能叼着它走。", "en": "I can carry it."},
        {"zh": "这是什么数据？", "en": "What data is this?"},
        {"zh": "我松口，让它落回草里。", "en": "I open my jaws and let it drop back into the grass."},
        {"zh": "它有点硬邦邦的。", "en": "It's a bit hard."},
        {"zh": "没有多少用处。", "en": "Not much use."},
        {"zh": "我叼起你包里掉的东西。", "en": "This fell out of your pack."},
        {"zh": "我先替你留着。", "en": "I'll keep it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "草那边的影子在晃。", "en": "Something moved."},
        {"zh": "我朝那边转了。", "en": "I've turned that way."},
        {"zh": "这个距离我能追上。", "en": "I can close this distance."},
        {"zh": "先在近战和远攻之间选。", "en": "I choose between melee and range."},
        {"zh": "我把四条腿屈起来。", "en": "I lower my body."},
        {"zh": "我的数据开始上升。", "en": "My data is rising."},
        {"zh": "它压根没往这边看。", "en": "It hasn't seen me."},
        {"zh": "我贴着影子从侧面绕。", "en": "I come from the side."},
        {"zh": "我已经准备好 V-Arrow。", "en": "I ready a V-Arrow."},
        {"zh": "我的角已经对准了那一侧。", "en": "My horn is already aimed at that side."},
        {"zh": "我这就冲上去。", "en": "Go."},
        {"zh": "已经牢牢锁定。", "en": "Locked."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着它跑圈。", "en": "I run circles around it."},
        {"zh": "我盯住它的后腿，等它先迈。", "en": "I fix on its hind leg and wait for it to move."},
        {"zh": "V-Arrow 正在蓄力当中。", "en": "V-Arrow is charging."},
        {"zh": "我逼得它朝石堆那边退。", "en": "It's starting to fall back toward the rocks."},
        {"zh": "我能跟得上它。", "en": "I can keep pace."},
        {"zh": "我的速度还在升。", "en": "My speed is still climbing."},
        {"zh": "它只有一条退路。", "en": "It has one way out."},
        {"zh": "等我数到三就扑。", "en": "When I count to three, I pounce."},
        {"zh": "它的节奏乱掉了。", "en": "It's losing its rhythm."},
        {"zh": "我朝它扑了过去。", "en": "I lunge."},
        {"zh": "趁它后腿还没蹬。", "en": "Now."},
        {"zh": "就在这里下手。", "en": "Right here."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一掌拍在它肩上。", "en": "My paw comes down."},
        {"zh": "牙齿咬进它的肩。", "en": "My teeth sink into its shoulder."},
        {"zh": "我甩头撕开它。", "en": "I shake my head and tear."},
        {"zh": "它往后面退了。", "en": "It fell back."},
        {"zh": "我紧跟着补上一脚。", "en": "I follow with a kick."},
        {"zh": "它挡住了这一下。", "en": "It blocked that."},
        {"zh": "我自己也受了伤。", "en": "I took a wound."},
        {"zh": "它还在原地挣着。", "en": "It's still moving."},
        {"zh": "我再咬它一口。", "en": "Another bite."},
        {"zh": "我换成了远程。", "en": "I switch to range."},
        {"zh": "V-Arrow 已经飞出去了。", "en": "V-Arrow is away."},
        {"zh": "它被我一箭击中。", "en": "It was hit."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在平原上出现了。", "en": "I appear on the plains."},
        {"zh": "我的数据渐渐成形。", "en": "My data takes shape."},
        {"zh": "我四下看了看。", "en": "I look all around."},
        {"zh": "这里是我的锚点。", "en": "This is my anchor."},
        {"zh": "我在草浪里展开四肢。", "en": "I stretch out my limbs in the waving grass."},
        {"zh": "草叶高过我的膝盖。", "en": "The grass stands above my knees."},
        {"zh": "我的爪印先压进这片草原。", "en": "My prints press into the plains first."},
        {"zh": "我开始走动了。", "en": "I start moving."},
        {"zh": "先熟悉一下这里。", "en": "Let me learn this place."},
        {"zh": "锚点就在这里。", "en": "I'm ready."},
        {"zh": "这里有人在吗？", "en": "Anyone there?"},
        {"zh": "你那点声响我听见了。", "en": "I can hear you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把我的数据烤得发烫。", "en": "Fire heats my data till it burns."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下，数据一颤。", "en": "I fell from height; my data shuddered."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的呼吸道。", "en": "Water floods my airways."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的数据冲散一块。", "en": "The blast scattered a chunk of my data."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西打在我的侧腹上。", "en": "Something struck my flank."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量在改写我的数据。", "en": "That force is rewriting my data."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的体力在往下掉。", "en": "My stamina is draining."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打到我的角上，我整只僵住。", "en": "Lightning struck my horn; I seized up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "地面消失了，数据往下坠。", "en": "The ground vanished; my data falls."}
      ]
    }
  }
}
