{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扛着大炮慢慢走。", "en": "I trudge along with my cannon."},
        {"zh": "金属的脚掌踩着地面。", "en": "Metal soles clump on the ground."},
        {"zh": "我把炮口对着前面。", "en": "I keep the barrel pointed ahead."},
        {"zh": "每走一步都有一点火花。", "en": "A little spark at every step."},
        {"zh": "我的装甲在阳光下反光。", "en": "My armor glints in the sun."},
        {"zh": "我从黑森林的阴影里走。", "en": "I walk out of the dark forest's shade."},
        {"zh": "我绕着锚点走一圈。", "en": "I circle my anchor point."},
        {"zh": "炮身的重量让我走得慢。", "en": "The cannon's weight slows me."},
        {"zh": "我走路像上了发条。", "en": "I walk like something wound up."},
        {"zh": "我在针叶间挤过去。", "en": "I push between the conifers."},
        {"zh": "我踏过一层针叶。", "en": "I step over a layer of needles."},
        {"zh": "我转身时身子一顿一顿。", "en": "My turns come in jolts."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在原地，炮口朝下。", "en": "I stand with the barrel lowered."},
        {"zh": "金属的头，慢慢转过来。", "en": "My metal head turns slowly."},
        {"zh": "我在扫描周围。", "en": "I'm scanning the surroundings."},
        {"zh": "炮管上有旧烧痕。", "en": "Old burn marks on the barrel."},
        {"zh": "我的护目镜一直亮着。", "en": "My visor stays lit."},
        {"zh": "我这只铁臂，抬起来比树还直。", "en": "This iron arm rises straighter than the trees."},
        {"zh": "我在针叶林里等着。", "en": "I wait in the conifers."},
        {"zh": "身上的外壳咔咔响。", "en": "My casing clicks and ticks."},
        {"zh": "我调了调手臂的角度。", "en": "I adjust the angle of my arm."},
        {"zh": "我停在原地，听命令来。", "en": "I stand and wait for an order."},
        {"zh": "我没有呼吸，但有低频声。", "en": "I don't breathe, but I hum low."},
        {"zh": "这具身体随时可以启动。", "en": "This body is ready to start."},
        {"zh": "我扫描周围每一片叶子。", "en": "I scan every leaf around me."},
        {"zh": "我不太喜欢潮湿。", "en": "I don't much like the damp."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站在我的射界里。", "en": "You're in my firing line."},
        {"zh": "我在估算你的距离。", "en": "I'm estimating your distance."},
        {"zh": "你的衣服太显眼了。", "en": "Your clothes stand out too much."},
        {"zh": "我认不出你的身份。", "en": "I can't identify you."},
        {"zh": "别把手伸进口袋。", "en": "Keep your hand out of that pocket."},
        {"zh": "我平时不主动开火。", "en": "I don't usually fire first."},
        {"zh": "你的体型比我小很多。", "en": "You're much smaller than I am."},
        {"zh": "你也是来找锚点的吗？", "en": "Are you here for the anchor too?"},
        {"zh": "我的关节锁死又松开。", "en": "My joints lock and release."},
        {"zh": "你最好说明来意。", "en": "Best state your business."},
        {"zh": "我个子小，可全身是钢。", "en": "Small I am, and all steel."},
        {"zh": "我扫了你两遍。", "en": "I've scanned you twice."},
        {"zh": "我的炮口没有对着你。", "en": "My barrel isn't aimed at you."},
        {"zh": "你的体温比我高出很多。", "en": "Your body heat is much higher than mine."},
        {"zh": "我记录下了你的样子。", "en": "I've recorded your appearance."},
        {"zh": "我的镜头正在扫你的脸。", "en": "My lens is scanning your face."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "外壳凹进去一块。", "en": "A plate has dented."},
        {"zh": "我的齿轮卡了半秒。", "en": "My gears froze for half a second."},
        {"zh": "火花从我肩上升起。", "en": "Sparks rise from my shoulder."},
        {"zh": "关节的温度在上升。", "en": "Joint temperature is climbing."},
        {"zh": "我的扫描有些杂乱。", "en": "My scan has gone noisy."},
        {"zh": "这一点损伤能承受。", "en": "I can sustain this damage."},
        {"zh": "我退后一点重整。", "en": "I fall back a little and reset."},
        {"zh": "能量读数没有问题。", "en": "Power readings are nominal."},
        {"zh": "我的炮口还能转动。", "en": "The barrel can still turn."},
        {"zh": "我不会就此停下来。", "en": "I won't stop here."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我平时只吃废料。", "en": "I usually eat only scrap."},
        {"zh": "这个不是废料。", "en": "That isn't scrap."},
        {"zh": "金属可以，别的不要。", "en": "Metal, yes. Anything else, no."},
        {"zh": "那块铁片倒是有用。", "en": "That iron plate could be useful."},
        {"zh": "我的引擎不要你的食物。", "en": "My engine has no use for your food."},
        {"zh": "你手里有能用的零件吗？", "en": "Any usable parts in your hand?"},
        {"zh": "这个不补给我。", "en": "This doesn't replenish me."},
        {"zh": "放下，我要检查一下。", "en": "Set it down. I'll inspect it."},
        {"zh": "我的能量还很足。", "en": "My energy is quite full."},
        {"zh": "我扛着大炮，食物对机械没意义。", "en": "I shoulder my cannon; food means nothing to a machine."},
        {"zh": "这块金属表面有锈。", "en": "This metal's surface is rusted."},
        {"zh": "我不需要水，但需要冷却。", "en": "I need no water, only cooling."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的外壳了。", "en": "You hit my casing."},
        {"zh": "我比看起来要重。", "en": "I'm heavier than I look."},
        {"zh": "退开，炮口在转。", "en": "Step back. The barrel's turning."},
        {"zh": "别靠近我的炮口。", "en": "Stay away from my muzzle."},
        {"zh": "你的肩膀磕到了我的炮。", "en": "Your shoulder knocked my cannon."},
        {"zh": "我的外壳很硬，你没事吧。", "en": "My casing's hard. Are you all right?"},
        {"zh": "铁皮的身子，撞不歪。", "en": "An iron body does not knock askew."},
        {"zh": "别从炮口前面过。", "en": "Don't walk in front of the barrel."},
        {"zh": "金属碰金属，声音很闷。", "en": "Metal meets metal with a dull clang."},
        {"zh": "你再靠近我就转身。", "en": "Any closer and I'll turn on you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是一台机械。", "en": "I'm a machine."},
        {"zh": "我的结构里没有这一项。", "en": "That isn't in my structure."},
        {"zh": "我被造出来是为了战斗。", "en": "I was built for combat."},
        {"zh": "这个问题不在我的记录里。", "en": "That isn't in my records."},
        {"zh": "我只认得废料。", "en": "I only know scrap."},
        {"zh": "我转过头，继续扫描。", "en": "I turn my head and keep scanning."},
        {"zh": "我根本没有同伴。", "en": "I have no companions at all."},
        {"zh": "我的齿轮不转这个方向。", "en": "My gears don't turn that way."},
        {"zh": "去问有血肉的东西。", "en": "Go ask something with flesh."},
        {"zh": "我需要的是零件。", "en": "It's parts I need."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用夹具夹起废料。", "en": "I clamp up the scrap with my grip."},
        {"zh": "这块铁可以修补。", "en": "This iron can patch me."},
        {"zh": "我扫描了一下它。", "en": "I scanned it once."},
        {"zh": "不是金属，我放下。", "en": "Not metal. I put it down."},
        {"zh": "我把它装进背部。", "en": "I stow it in my back."},
        {"zh": "这个太轻了，没用。", "en": "This is too light. Useless."},
        {"zh": "这个有利用价值。", "en": "This has salvage value."},
        {"zh": "我把它分成了两块。", "en": "I break it into two pieces."},
        {"zh": "废铁进背舱，正好补上。", "en": "Scrap into the bay; it patches me."},
        {"zh": "我把残渣扫到一边。", "en": "I sweep the residue aside."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标已经锁定，笑弹在爪里。", "en": "Target locked; the smile bomb is in my claw."},
        {"zh": "我开始测量距离。", "en": "I begin ranging."},
        {"zh": "炮口已经对准了。", "en": "The barrel's on target."},
        {"zh": "我的传感器已对准你。", "en": "My sensors are on you."},
        {"zh": "我等你再走一步。", "en": "I wait for one more step."},
        {"zh": "我正在开始充能。", "en": "I'm beginning to charge."},
        {"zh": "你没穿甲，我记下了。", "en": "No armor on you; noted."},
        {"zh": "我有两种攻击选择。", "en": "I have two attack options."},
        {"zh": "这个距离适合开火。", "en": "This range suits firing."},
        {"zh": "笑脸炸弹，我手里有一颗。", "en": "I hold one Smiley Bomb."},
        {"zh": "我从针叶间出来。", "en": "I'm stepping out of the conifers."},
        {"zh": "你也已经被锁定了。", "en": "You're marked as well."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "目标仍然在我前方。", "en": "Target is still ahead."},
        {"zh": "我正在压缩距离。", "en": "I'm closing the gap."},
        {"zh": "你退向林子里去了。", "en": "You're retreating into the trees."},
        {"zh": "炮口一直跟着你。", "en": "The barrel tracks you."},
        {"zh": "我在等充能完成。", "en": "Waiting for the charge to finish."},
        {"zh": "你的身后有一棵树。", "en": "There's a tree behind you."},
        {"zh": "这个角度我更占优。", "en": "This angle favors me more."},
        {"zh": "我没有情绪上的波动。", "en": "I have no emotional fluctuation."},
        {"zh": "我的计算已经完毕。", "en": "My calculations are complete."},
        {"zh": "你只剩下三步空间。", "en": "You have only three steps of room."},
        {"zh": "我从侧面移动过去。", "en": "I'm moving around to your flank."},
        {"zh": "炮管的温度在上升。", "en": "The barrel's temperature is rising."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "炮口的光推了出去。", "en": "The muzzle flash pushes out."},
        {"zh": "我用炮身砸你。", "en": "I strike with the cannon body."},
        {"zh": "这一下是近战模式。", "en": "Close-quarters mode for this one."},
        {"zh": "你被冲击顶开了。", "en": "The impact shoved you back."},
        {"zh": "我用金属的手臂扫。", "en": "I sweep with my metal arm."},
        {"zh": "炮身很沉，不灵活。", "en": "The cannon's heavy and slow."},
        {"zh": "我把铁拳从高处砸下。", "en": "I bring my iron fist down from above."},
        {"zh": "你挡住了，可手在抖。", "en": "You blocked it, but your hand shakes."},
        {"zh": "炮身的后坐力歪了。", "en": "The recoil threw my aim off."},
        {"zh": "我退了一点重新对准。", "en": "I step back and re-aim."},
        {"zh": "我把你逼到树边。", "en": "I press you against the tree."},
        {"zh": "你又跑回射界里。", "en": "You've moved back into my line."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这片针叶林启动。", "en": "I power up in these conifers."},
        {"zh": "护目镜第一次亮起来。", "en": "My visor lit for the first time."},
        {"zh": "炮身转到了初始位置。", "en": "The barrel moved to its start position."},
        {"zh": "我扫描了四周一遍。", "en": "I scanned the surroundings once."},
        {"zh": "这里的湿度偏高。", "en": "Humidity here is too high."},
        {"zh": "我的锚点不在这里。", "en": "My anchor isn't here."},
        {"zh": "我在林子边缘站定。", "en": "I take a stand at the forest's edge."},
        {"zh": "我的外壳有一点点冷。", "en": "My casing is a little cold."},
        {"zh": "针叶林里，我的关节刚启动。", "en": "In the taiga, my joints just started up."},
        {"zh": "我试了试炮口。", "en": "I test the barrel."},
        {"zh": "地上留下一圈脚印。", "en": "A ring of prints marks the ground."},
        {"zh": "我的系统读完了地形。", "en": "My systems have finished reading the terrain."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温让我的外壳变色。", "en": "The heat has discolored my casing."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地时腿震了一下。", "en": "My leg jarred on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进了关节，我动得慢了。", "en": "Water in my joints. I move slowly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风掀动了我背后的零件。", "en": "The blast rocked the parts on my back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一枚弹片卡进外壳缝里。", "en": "Shrapnel wedged into my casing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "不明能量扰乱了我的系统。", "en": "Unknown energy is scrambling my systems."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的电量掉到警戒线了。", "en": "My charge has dropped to the warning line."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击顺着外壳跑遍我。", "en": "Lightning ran across my casing."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在坠落，系统还在计算。", "en": "I'm falling. My systems keep calculating."}
      ]
    }
  }
}
