{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在低处飞，一上一下。", "en": "I fly low, rising and dipping."},
        {"zh": "只有巴掌那么大。", "en": "Only a palm's width."},
        {"zh": "翅膀几乎看不见。", "en": "My wings are almost invisible."},
        {"zh": "我从草丛上滑过去。", "en": "I skim over the grass."},
        {"zh": "一阵风就把我吹歪。", "en": "One gust knocks me askew."},
        {"zh": "我打了两个转才稳。", "en": "Two spins before I steady."},
        {"zh": "我朝有光的地方飞。", "en": "I fly toward the light."},
        {"zh": "森林里光很碎。", "en": "The forest light comes in pieces."},
        {"zh": "身上亮了一下。", "en": "I brighten once."},
        {"zh": "我又飞出去。", "en": "And fly on."},
        {"zh": "叶子在我身边擦过去。", "en": "Leaves brush past me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在半空，慢慢晃。", "en": "I hover, swaying slowly."},
        {"zh": "翅膀几乎没有声音。", "en": "My wings make almost no sound."},
        {"zh": "我在看一朵花。", "en": "I am looking at a flower."},
        {"zh": "花比我还大。", "en": "The flower is bigger than I am."},
        {"zh": "我又停回花上。", "en": "I settle back on the flower."},
        {"zh": "我从蛋壳里爬出来不久。", "en": "I only just crawled from the eggshell."},
        {"zh": "我就是看着。", "en": "I only look."},
        {"zh": "花瓣上有一滴水。", "en": "A drop of water sits on the petal."},
        {"zh": "我凑近了一点点。", "en": "I lean in a little."},
        {"zh": "我喝了一小口。", "en": "I take a small sip."},
        {"zh": "这水甜得很。", "en": "This water is very sweet."},
        {"zh": "我抬起小脑袋。", "en": "I lift my small head."},
        {"zh": "水珠在嘴边晃。", "en": "The bead wavers at my mouth."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我飞到你的眼睛高度。", "en": "I fly to the height of your eyes."},
        {"zh": "我这么小，也是一只数码兽。", "en": "Small as I am, I'm still a Digimon."},
        {"zh": "我绕你飞了一圈。", "en": "I fly one circle round you."},
        {"zh": "你的肩膀上有光。", "en": "There is light on your shoulder."},
        {"zh": "那里很稳当。", "en": "It is steady there."},
        {"zh": "我坐了一会。", "en": "I sit a while."},
        {"zh": "你没有赶我。", "en": "You do not shoo me off."},
        {"zh": "小翅膀一拍，又起来了。", "en": "One beat of tiny wings and up I go."},
        {"zh": "在你面前停住。", "en": "And stop in front of you."},
        {"zh": "你把手指伸过来。", "en": "You reach a finger out."},
        {"zh": "你的指尖很暖。", "en": "Your fingertip is warm."},
        {"zh": "我坐得更久。", "en": "I sit longer."},
        {"zh": "我脑袋一歪。", "en": "My head tips sideways."},
        {"zh": "你的指尖有一点抖。", "en": "Your fingertip trembles a little."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被拍得转了两圈。", "en": "I am swatted into two spins."},
        {"zh": "翅膀皱了一点。", "en": "One wing is creased."},
        {"zh": "我落到草里。", "en": "I drop into the grass."},
        {"zh": "草比我高很多。", "en": "The grass towers over me."},
        {"zh": "我在里面找不到方向。", "en": "I cannot find my way in it."},
        {"zh": "我挣扎着起来。", "en": "I struggle upright."},
        {"zh": "试着扇了扇。", "en": "I test a beat."},
        {"zh": "我还能飞的。", "en": "I can still fly."},
        {"zh": "我朝高处飞去。", "en": "I fly up high."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是给我的吗。", "en": "Is that for me?"},
        {"zh": "在它上面绕了两圈。", "en": "I circle it twice."},
        {"zh": "然后咬了一小口。", "en": "Then take a small bite."},
        {"zh": "它硬了一点。", "en": "It is a little hard."},
        {"zh": "这回它软了。", "en": "It is soft this time."},
        {"zh": "饲料糊了我一嘴。", "en": "Feed smears all over my mouth."},
        {"zh": "你笑出声来。", "en": "You laugh out loud."},
        {"zh": "我不知道你在笑什么。", "en": "I do not know what at."},
        {"zh": "我接着啃下去。", "en": "I keep nibbling."},
        {"zh": "我嘴角挂着渣。", "en": "Crumbs cling to my mouth."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你动了一下，我被吹翻了。", "en": "You move and the gust flips me."},
        {"zh": "我翻了两圈。", "en": "I tumble twice."},
        {"zh": "我的翅膀乱拍。", "en": "My wings beat wildly."},
        {"zh": "我总算稳住了。", "en": "I finally steady."},
        {"zh": "停在你肩头。", "en": "And land on your shoulder."},
        {"zh": "我又挨近了一点。", "en": "I lean a little closer."},
        {"zh": "你的衣服有点粗。", "en": "Your clothes are a bit rough."},
        {"zh": "可我没有离开。", "en": "But I do not leave."},
        {"zh": "我坐在那里。", "en": "I sit there."},
        {"zh": "一直坐到你动。", "en": "Until you move again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我现在还太小。", "en": "I am still too small."},
        {"zh": "这些事要等我长大。", "en": "That waits until I grow."},
        {"zh": "我绕着一朵花飞。", "en": "I circle a flower."},
        {"zh": "花上有别的影子。", "en": "There is another shadow on it."},
        {"zh": "比我大一点。", "en": "Slightly bigger than I am."},
        {"zh": "我往旁边退开。", "en": "I edge away."},
        {"zh": "我现在只想要吃的。", "en": "Right now I only want food."},
        {"zh": "和暖和的地方。", "en": "And somewhere warm."},
        {"zh": "我在花瓣上坐下。", "en": "I sit on the petal."},
        {"zh": "就坐在这儿吧。", "en": "I will sit here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用头顶着它滚。", "en": "I push it along with my head."},
        {"zh": "我托不住它。", "en": "I cannot hold it."},
        {"zh": "这一个很轻。", "en": "This one is light."},
        {"zh": "我抱得动它。", "en": "I can carry it."},
        {"zh": "飞得歪歪扭扭。", "en": "Wobbling all the way."},
        {"zh": "落在树杈上。", "en": "I land on a branch fork."},
        {"zh": "先把东西放好。", "en": "I set it down first."},
        {"zh": "被你捡起来，我倒也不讨厌。", "en": "Being picked up by you isn't so bad, honestly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我停住，触角朝那边转。", "en": "I stop, antennae swiveling that way."},
        {"zh": "我把小脑袋扬起来。", "en": "I lift my little head."},
        {"zh": "它比我还小些。", "en": "It is even smaller than me."},
        {"zh": "那实在太少了。", "en": "That is far too little."},
        {"zh": "我又看向别处。", "en": "I look elsewhere."},
        {"zh": "那边有更大的一只。", "en": "There is a bigger one over there."},
        {"zh": "它毫无察觉。", "en": "It has no idea."},
        {"zh": "我倒挂下来。", "en": "I hang upside down."},
        {"zh": "离得很近了。", "en": "Very close now."},
        {"zh": "我把小嘴张开。", "en": "I open my small mouth."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "小翅膀扇得它毛发乱。", "en": "My little wings ruffle its fur."},
        {"zh": "它转不过身。", "en": "It cannot turn in time."},
        {"zh": "翅膀几乎没有声。", "en": "My wings are almost silent."},
        {"zh": "我也停了下来。", "en": "I stop as well."},
        {"zh": "它又开始走。", "en": "It starts walking again."},
        {"zh": "我在后头跟着。", "en": "I follow behind."},
        {"zh": "我悬在它头顶，影子很小。", "en": "I hover over its head, a tiny shadow."},
        {"zh": "我鼓起了腮。", "en": "I puff out my cheeks."},
        {"zh": "水在我嘴里聚起来。", "en": "Water gathers in my mouth."},
        {"zh": "我把水吐出去。", "en": "I spit the water out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "泡打在它脸上。", "en": "They burst on its face."},
        {"zh": "它眨了眨眼。", "en": "It blinks."},
        {"zh": "我又吐了一串。", "en": "I spit another string."},
        {"zh": "这次打中了鼻子。", "en": "This one hits its nose."},
        {"zh": "它打了个喷嚏。", "en": "It sneezes."},
        {"zh": "我被气流吹翻了。", "en": "The gust flips me over."},
        {"zh": "我从草上爬起来。", "en": "I right myself on the grass."},
        {"zh": "我又鼓起腮。", "en": "I puff my cheeks again."},
        {"zh": "但嘴里没有水了。", "en": "But there is no water left."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "森林里多了一个小点。", "en": "A small point appears in the forest."},
        {"zh": "那个小点是我。", "en": "That small point is me."},
        {"zh": "我从一颗蛋里出来。", "en": "I came out of an egg."},
        {"zh": "壳还在旁边。", "en": "The shell is still beside me."},
        {"zh": "破壳时我打了个喷嚏。", "en": "Hatching, I sneeze once."},
        {"zh": "它们还是湿的。", "en": "They are still wet."},
        {"zh": "我等它们干。", "en": "I wait for them to dry."},
        {"zh": "干了我飞起来。", "en": "When dry, I fly."},
        {"zh": "第一次飞，飞得歪。", "en": "My first flight is crooked."},
        {"zh": "但我没有掉下去。", "en": "But I do not fall."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一靠近，我的翅膀就缩了。", "en": "Fire nears and my wings curl."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，落在叶子上。", "en": "I fall and land on a leaf."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我裹住，我划不动。", "en": "Water wraps me; I cannot paddle."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹出老远。", "en": "The blast blows me far."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股力把我定在半空。", "en": "A force holds me in midair."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把整片林子照亮。", "en": "Lightning lights the whole wood."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有风，我掉下去。", "en": "No wind; I fall."}
      ]
    }
  }
}
