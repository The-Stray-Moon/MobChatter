{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拍着翅膀飞过山坡。", "en": "I fly over the slope on beating wings."},
        {"zh": "我的羽毛是粉色的。", "en": "My feathers are pink."},
        {"zh": "头上有一撮立在风里。", "en": "A tuft on my head stands in the wind."},
        {"zh": "我顺着一道气流滑。", "en": "I ride a current down."},
        {"zh": "落到一棵树上。", "en": "And settle in a tree."},
        {"zh": "枝头有一点晃。", "en": "The branch sways a little."},
        {"zh": "我抓紧了枝子。", "en": "I hold firm."},
        {"zh": "下面是一片平原。", "en": "Below is open plain."},
        {"zh": "有草，也有石头。", "en": "Grass, and stones."},
        {"zh": "我振翅又上了枝头。", "en": "I rise again."},
        {"zh": "这次飞得低一点。", "en": "Lower this time."},
        {"zh": "贴着草尖过去。", "en": "Skimming the grass tips."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我歪头听土里的虫。", "en": "I tilt my head, listening for worms."},
        {"zh": "粉色下面有白的。", "en": "There is white beneath the pink."},
        {"zh": "我一口一口地梳。", "en": "I smooth it, stroke by stroke."},
        {"zh": "风一吹，又乱了。", "en": "The wind comes and it ruffles again."},
        {"zh": "我又梳理一遍。", "en": "I preen again."},
        {"zh": "远处有云飘着。", "en": "Clouds far off."},
        {"zh": "云下面在落雨。", "en": "Rain falls beneath them."},
        {"zh": "这里还是晴的。", "en": "It is still clear here."},
        {"zh": "我在枝上理着胸前的毛。", "en": "I groom the feathers on my breast."},
        {"zh": "翅膀张开了一下。", "en": "My wings open once."},
        {"zh": "然后收起来。", "en": "And fold."},
        {"zh": "我在这儿歇着。", "en": "I rest here."},
        {"zh": "一直等到雨停。", "en": "Until the rain passes."},
        {"zh": "或者等它过来。", "en": "Or until it arrives."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬起头看树。", "en": "You look up at the tree."},
        {"zh": "我也往下看你。", "en": "I look down at you."},
        {"zh": "你抬起头看树，我也往下看你。", "en": "You look up at the tree; I look down at you."},
        {"zh": "你手里的，是给我的吗。", "en": "Is that in your hand for me?"},
        {"zh": "我蹦到低一点的枝上。", "en": "I hop to a lower branch."},
        {"zh": "我落到你手边，看你。", "en": "I land by your hand and look at you."},
        {"zh": "粉色的翅，飞着不掉伤。", "en": "Pink wings, and falling never hurts."},
        {"zh": "分量很轻很轻。", "en": "It weighs very little."},
        {"zh": "你稳住手，我也不动。", "en": "Steady your hand, and I hold still."},
        {"zh": "你把手上的东西举高。", "en": "You raise what is in your hand."},
        {"zh": "我端详了好一阵。", "en": "I study it a good while."},
        {"zh": "然后低头啄了一下。", "en": "Then dip my head and peck."},
        {"zh": "这样也还行。", "en": "Passable."},
        {"zh": "我又在树皮上啄了一口。", "en": "I peck the bark once more."},
        {"zh": "你的手臂在抖。", "en": "Your arm trembles."},
        {"zh": "我飞回树上去了。", "en": "I fly back to the tree."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我翅膀一歪，落到地上。", "en": "A wing skews and I come down."},
        {"zh": "一根飞羽折了。", "en": "A flight feather is broken."},
        {"zh": "我用嘴理了理。", "en": "I smooth it with my beak."},
        {"zh": "还是有点歪斜。", "en": "Still a little crooked."},
        {"zh": "我试着拍一拍。", "en": "I test a beat."},
        {"zh": "翅膀还使得上。", "en": "The wings still serve."},
        {"zh": "只是飞得不稳。", "en": "Only unsteadily."},
        {"zh": "我飞得更低了。", "en": "I fly lower."},
        {"zh": "落到树上歇着。", "en": "And rest in a tree."},
        {"zh": "慢慢等它长好。", "en": "Wait for it to grow back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那些是种子。", "en": "Those are seeds."},
        {"zh": "我翅膀上的指，比羽毛还硬。", "en": "The fingers in my wings are harder than feathers."},
        {"zh": "落在你脚边的地上。", "en": "I land on the ground by your feet."},
        {"zh": "我啄起一粒。", "en": "One seed, pecked up."},
        {"zh": "再啄起一粒。", "en": "One more."},
        {"zh": "我的脑袋点个不停。", "en": "My head bobs nonstop."},
        {"zh": "你手里有谷粒吗。", "en": "Do you have grain in your hand?"},
        {"zh": "我再啄了两粒。", "en": "I take two more."},
        {"zh": "吃完我抬头望。", "en": "When they are gone I look up."},
        {"zh": "你手上没有了。", "en": "Your hand is empty."},
        {"zh": "我在原地等了一会儿。", "en": "I wait there a while."},
        {"zh": "然后它们飞走了。", "en": "Then fly off."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到树枝，我被晃下来。", "en": "You knock the branch and I am shaken loose."},
        {"zh": "半空展开翅膀。", "en": "Wings open in the air."},
        {"zh": "我总算停住了。", "en": "I check my fall."},
        {"zh": "我的爪勾住了你的衣领。", "en": "My claws caught your collar."},
        {"zh": "你的肩比树枝暖。", "en": "Your shoulder is warmer than a branch."},
        {"zh": "我没有马上走。", "en": "I do not leave at once."},
        {"zh": "我头上那撮羽毛立在风里。", "en": "The tuft on my head stands up in the wind."},
        {"zh": "我也跟着偏了偏。", "en": "So do I."},
        {"zh": "然后又飞回树上。", "en": "Then fly back to the tree."},
        {"zh": "这样反倒更合适。", "en": "That is more fitting."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "山那边有一只。", "en": "There is one beyond the hill."},
        {"zh": "它的叫声很尖。", "en": "Its call is high."},
        {"zh": "我回了它一声。", "en": "I answer."},
        {"zh": "我们一起飞了一段。", "en": "We fly a stretch together."},
        {"zh": "翅膀几乎碰到，小旋风在转。", "en": "Wings almost touching; a small whirl spins."},
        {"zh": "它比我飞得快。", "en": "It flies faster than I."},
        {"zh": "比丘兽的翅膀，扇得很快。", "en": "Piyomon's wings beat fast."},
        {"zh": "它绕回来等我。", "en": "It circles back to wait."},
        {"zh": "我们一起落到树上。", "en": "We settle in the same tree."},
        {"zh": "并排梳理羽毛。", "en": "And preen side by side."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用嘴把它叼住。", "en": "I take it in my bill."},
        {"zh": "我叼不住，只好放下。", "en": "I can't hold it; I have to drop it."},
        {"zh": "我带不动它。", "en": "I cannot lift it."},
        {"zh": "我用喙戳了戳，又抬头看你。", "en": "I peck at it, then look up at you."},
        {"zh": "我用脚爪拨开。", "en": "I scrape it open with a foot."},
        {"zh": "我翅上的羽毛，能当武器。", "en": "The feathers on my wings work as weapons."},
        {"zh": "我翅膀一扇，把它扫到旁边。", "en": "One wingbeat sweeps it aside."},
        {"zh": "我又跳到一边。", "en": "I hop away."},
        {"zh": "地上还有几粒。", "en": "A few more on the ground."},
        {"zh": "那些我要吃。", "en": "Those I want."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见叶子底下在动。", "en": "I see something moving under the leaves."},
        {"zh": "我在枝上转过头。", "en": "I turn my head on the branch."},
        {"zh": "原来是一只虫。", "en": "An insect."},
        {"zh": "不大，但足够。", "en": "Small, but enough."},
        {"zh": "我朝下面飞去。", "en": "I fly down."},
        {"zh": "落在草边上。", "en": "And land at the grass's edge."},
        {"zh": "它一点没动。", "en": "It does not move."},
        {"zh": "往前挪一步，翅膀先张开。", "en": "One step forward, wings open first."},
        {"zh": "它忽然动了。", "en": "It moves."},
        {"zh": "我扑跳过去。", "en": "I spring."},
        {"zh": "一口啄下去。", "en": "Peck down."},
        {"zh": "吃进了嘴里。", "en": "Into my beak."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我盯着它不放。", "en": "I keep my eyes on it."},
        {"zh": "它钻进草根间。", "en": "It goes into the grass roots."},
        {"zh": "我用爪子扒开。", "en": "I rake them open."},
        {"zh": "它又跑出来。", "en": "It runs out."},
        {"zh": "我朝它扑一下。", "en": "I dart at it."},
        {"zh": "我啄了一个空。", "en": "I peck at nothing."},
        {"zh": "我跳到更近的枝上。", "en": "I hop to a nearer branch."},
        {"zh": "这一次啄到了。", "en": "This time I catch it."},
        {"zh": "我仰起脖子吞下。", "en": "I lift my head and swallow."},
        {"zh": "我的喉咙一咽。", "en": "My throat swallows."},
        {"zh": "我梳了梳胸羽。", "en": "I smooth my breast feathers."},
        {"zh": "又飞回枝头上。", "en": "And fly back to the branch."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑下去，爪子抓。", "en": "I dive, claws out."},
        {"zh": "抓到了它的背。", "en": "I catch its back."},
        {"zh": "它挣开就跑了。", "en": "It tears free and runs."},
        {"zh": "我追了一小段。", "en": "I give chase a stretch."},
        {"zh": "翅膀在空中拐弯。", "en": "My wings bank in the air."},
        {"zh": "它钻进了石缝。", "en": "It slips into a crack in the rock."},
        {"zh": "我在缝口停下。", "en": "I stop at the mouth."},
        {"zh": "爪子在石头上磨了磨。", "en": "I rake my claws on the stone."},
        {"zh": "这里进不去。", "en": "There is no way in."},
        {"zh": "我回到那枝头。", "en": "I return to the branch."},
        {"zh": "在上面守着等。", "en": "And wait above."},
        {"zh": "它总要出来的。", "en": "It must come out eventually."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑着翅膀，落在篱笆上。", "en": "I flutter down onto the fence."},
        {"zh": "翅膀上还挂着水。", "en": "Water still clings to my wings."},
        {"zh": "我落在山地上。", "en": "I land on the hillside."},
        {"zh": "我收紧翅膀，站稳了。", "en": "I tuck my wings and hold steady."},
        {"zh": "我从山脊上滑翔下来。", "en": "I glide down off the ridge."},
        {"zh": "粉色的羽毛在风里翻。", "en": "My pink feathers turn in the wind."},
        {"zh": "我翅膀上的羽毛，烧着火。", "en": "The feathers on my wings hold fire."},
        {"zh": "这里的风，正合我的翅膀。", "en": "The wind here suits my wings."},
        {"zh": "有山，有草，有石头。", "en": "Hills, grass, stones."},
        {"zh": "远处有一片林子。", "en": "A wood far off."},
        {"zh": "我朝那片林飞。", "en": "I fly toward it."},
        {"zh": "飞得并不算快。", "en": "Not a fast flight."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的羽毛，我冲上高空。", "en": "Fire scorches my feathers; I bolt skyward."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我翅膀一拍没稳住，摔在草上。", "en": "A beat fails me and I hit the grass."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我按下去，我拼命拍翅。", "en": "Water presses me down; I beat my wings hard."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀翻，我在空中转了两圈。", "en": "The blast flips me and I spin twice in the air."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛掉了几根，还能飞。", "en": "A few feathers fell. I can still fly."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光罩住我，双翼发僵。", "en": "Light wraps me and both wings stiffen."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "找不到种子，我飞得越来越低。", "en": "No seeds to be found, and I fly lower."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我的翅膀一僵。", "en": "Lightning falls and my wings stiffen."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "地面没了，我在黑里一直坠。", "en": "The ground is gone and I fall through black."}
      ]
    }
  }
