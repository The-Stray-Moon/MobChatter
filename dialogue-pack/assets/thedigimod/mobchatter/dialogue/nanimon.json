{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我摆着身子走，像个球。", "en": "I roll along, a little ball of a body."},
        {"zh": "两条短腿挪得费劲。", "en": "Two short legs, working hard."},
        {"zh": "我从沼泽边一步一步走。", "en": "I step along the marsh edge."},
        {"zh": "我摔了一跤，又爬起来。", "en": "I trip, then get up again."},
        {"zh": "我摇摇晃晃地往前。", "en": "I wobble forward."},
        {"zh": "我走到树下，绕过去。", "en": "I reach a tree and go around."},
        {"zh": "我一边走一边嘟囔。", "en": "I mutter as I go."},
        {"zh": "我身上沾了不少东西。", "en": "I have picked up a few things."},
        {"zh": "我大概不太好看。", "en": "I am probably not much to look at."},
        {"zh": "我挪一步要歇一下。", "en": "I rest after each shuffling step."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，肚子鼓着。", "en": "Standing, my belly out."},
        {"zh": "我抬手抓了抓头。", "en": "I reach up and scratch my head."},
        {"zh": "我把屁股往泥里挪了挪。", "en": "I shift my rear deeper into the mud."},
        {"zh": "我在闻地上的东西。", "en": "I sniff at the ground."},
        {"zh": "我的手指很短。", "en": "My fingers are short."},
        {"zh": "我把身上的脏东西拨掉。", "en": "I brush the muck off myself."},
        {"zh": "我在等一顿饭。", "en": "I wait for a meal."},
        {"zh": "我往地上一坐。", "en": "I sit down on the ground."},
        {"zh": "沼泽的泥慢慢陷住脚。", "en": "The swamp mud slowly swallows my feet."},
        {"zh": "我平时话很少。", "en": "I usually say very little."},
        {"zh": "太阳晒得有点狠。", "en": "The sun is a bit fierce."},
        {"zh": "我在想下一步往哪走。", "en": "I am wondering where to go next."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上有味道，你别嫌。", "en": "I smell. Do not mind it."},
        {"zh": "我就在这附近转转。", "en": "I just wander around here."},
        {"zh": "你手里有吃的吗。", "en": "Do you have any food?"},
        {"zh": "我看起来不厉害。", "en": "I do not look formidable."},
        {"zh": "我往后蹭了蹭。", "en": "I shuffle backward."},
        {"zh": "这一带都是泥。", "en": "It is all mud around here."},
        {"zh": "你也在沼泽边上转。", "en": "You wander the marsh edge too."},
        {"zh": "我走不快，你别笑。", "en": "I cannot move fast. Do not laugh."},
        {"zh": "你脚边都是水。", "en": "Water all around your feet."},
        {"zh": "我抓了抓胳膊。", "en": "I scratch my arm."},
        {"zh": "我没什么本事。", "en": "I have no great talents."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚了半圈子。", "en": "I rolled half a turn."},
        {"zh": "我疼得直嚷嚷。", "en": "The pain makes me yelp."},
        {"zh": "身上掉了一块泥。", "en": "A chunk of mud fell off me."},
        {"zh": "我坐在地上了。", "en": "I am sitting on the ground."},
        {"zh": "我慢慢爬起来了。", "en": "I get up slowly."},
        {"zh": "这点伤还算好。", "en": "This much is all right."},
        {"zh": "我把身上的东西拍掉。", "en": "I brush myself off."},
        {"zh": "我不太经得起打。", "en": "I am not built for blows."},
        {"zh": "我蹲下去，抱住头。", "en": "I crouch down and cover my head."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是吃的东西吗。", "en": "Is that something to eat?"},
        {"zh": "那就给了我吧。", "en": "Then give it to me."},
        {"zh": "能填肚子就成。", "en": "As long as it fills me."},
        {"zh": "闻起来还能吃。", "en": "It smells edible."},
        {"zh": "搁下来就行了。", "en": "Set it down."},
        {"zh": "我够得着那里。", "en": "I can reach it there."},
        {"zh": "你后退一步吧。", "en": "Step back one pace."},
        {"zh": "这够我吃一顿。", "en": "That is enough for a meal."},
        {"zh": "肚子空了好些天。", "en": "My belly has been empty for days."},
        {"zh": "甭想从我手里拿走。", "en": "You are not taking it."},
        {"zh": "我一天能吃好几顿。", "en": "I can eat several meals a day."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我滚了。", "en": "You bumped me and I rolled."},
        {"zh": "我撑着爬起来了。", "en": "I push myself up."},
        {"zh": "我这么圆，站不稳。", "en": "So round that I do not stand well."},
        {"zh": "往旁边挪一挪。", "en": "Shift over a bit."},
        {"zh": "撞一下也不疼。", "en": "One bump does not hurt."},
        {"zh": "脚趾被踩着了。", "en": "My toe got stepped on."},
        {"zh": "我肚子先撞上了你。", "en": "My belly bumps into you first."},
        {"zh": "你千万别推我。", "en": "Do not push me."},
        {"zh": "总算没有摔倒。", "en": "At least I did not fall."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这副模样，算了吧。", "en": "Looking like this? Forget it."},
        {"zh": "这沼泽里同类不多。", "en": "Few of my kind in this marsh."},
        {"zh": "这件事别提了。", "en": "Do not bring that up."},
        {"zh": "我连自己都顾不好。", "en": "I cannot even look after myself."},
        {"zh": "你另找别人吧。", "en": "Look for someone else."},
        {"zh": "我只会吃点东西。", "en": "All I do is eat."},
        {"zh": "再等一阵子吧。", "en": "Wait a while longer."},
        {"zh": "我先往回走了。", "en": "I am heading back."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有块东西。", "en": "Something on the ground."},
        {"zh": "我抓起来就吃。", "en": "I grab it and eat."},
        {"zh": "我塞进了口袋。", "en": "I stuff it in my pocket."},
        {"zh": "手太短，够不到。", "en": "My arms are too short."},
        {"zh": "这点脏东西也能吃。", "en": "Even this filthy scrap is edible."},
        {"zh": "这一点我先留着。", "en": "I will keep this bit."},
        {"zh": "这个我是不捡的。", "en": "I do not pick that up."},
        {"zh": "松手，那是我的。", "en": "Let go. That is mine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你朝我靠过来了。", "en": "You have come closer."},
        {"zh": "你落在我眼里。", "en": "You landed in my sight."},
        {"zh": "我不想打，可我也不躲。", "en": "I do not want to fight, but I will not hide."},
        {"zh": "我这两只手很短。", "en": "My arms are short."},
        {"zh": "我就数上三声。", "en": "Three counts, then."},
        {"zh": "我要扔东西了。", "en": "I am going to throw something."},
        {"zh": "这里没有路可走。", "en": "There is no path here."},
        {"zh": "这样就没问题了。", "en": "That will do."},
        {"zh": "我已经来了这儿。", "en": "Here I am."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一点点蹭过来。", "en": "I creep closer, bit by bit."},
        {"zh": "手里已经抓好了。", "en": "I have already grabbed it."},
        {"zh": "你往后蹭了一下。", "en": "You edged back."},
        {"zh": "泥里不好走路。", "en": "Hard going in the mud."},
        {"zh": "我心里在数数。", "en": "I count in my head."},
        {"zh": "我用一只眼盯着你。", "en": "I watch you with one eye."},
        {"zh": "再往近处靠些。", "en": "A little nearer."},
        {"zh": "我瞄着你的头。", "en": "I aim at your head."},
        {"zh": "你的手动起来了。", "en": "Your hand moved."},
        {"zh": "这里就够近了。", "en": "This is close enough."},
        {"zh": "我把东西举起来。", "en": "I raise the thing in my hand."},
        {"zh": "我这就扔出去。", "en": "I throw it now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扔出一团东西。", "en": "I hurl a lump."},
        {"zh": "这一下没打中。", "en": "That missed."},
        {"zh": "我滚过去撞你。", "en": "I roll into you."},
        {"zh": "你往旁边闪了。", "en": "You dodged to the side."},
        {"zh": "我又抓了一把。", "en": "I scoop another handful."},
        {"zh": "这东西脏得很。", "en": "This stuff is filthy."},
        {"zh": "你抹了一把脸。", "en": "You wiped your face."},
        {"zh": "我一下子摔倒了。", "en": "I fell right over."},
        {"zh": "我爬起来再扔。", "en": "I get up and throw again."},
        {"zh": "这一下打准了。", "en": "That one hit the mark."},
        {"zh": "气还没顺过来。", "en": "I have not caught my breath."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "身上全是泥，别嫌脏。", "en": "Covered in mud. Don't mind the mess."},
        {"zh": "我把身上的水甩掉。", "en": "I shake the water off."},
        {"zh": "这一带潮得很。", "en": "It is very damp here."},
        {"zh": "我抹了把脸上的泥。", "en": "I wipe the mud off my face."},
        {"zh": "我肚子里空空的。", "en": "My belly is empty."},
        {"zh": "这一片也有人的。", "en": "There is someone here too."},
        {"zh": "黑森林的枝子压得很低。", "en": "The dark forest branches hang low."},
        {"zh": "到你跟前了，站得挺直。", "en": "I'm in front of you, standing straight."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的皮，焦味很难闻。", "en": "Fire singes my skin; the smell is foul."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚下坡，停不住。", "en": "I roll down the slope and cannot stop."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没到我的头。", "en": "Water over my head."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我掀得滚了很远。", "en": "The blast rolls me a long way."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎在我肚子上。", "en": "An arrow sticks in my belly."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我眯起眼。", "en": "This light makes me squint."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电打得我全身一抖。", "en": "Lightning makes me jolt."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的泥没了。", "en": "The mud under me is gone."}
      ]
    }
  }
}
