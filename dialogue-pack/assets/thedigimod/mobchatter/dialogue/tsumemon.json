{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "小小的身子，一摇一晃", "en": "Small body, waddling along."},
        {"zh": "爪子抓地很稳", "en": "My claws grip the ground well."},
        {"zh": "我跟着一群一起走", "en": "I move with a group."},
        {"zh": "森林里我到处钻", "en": "I slip all over the forest."},
        {"zh": "我走得很慢但不停", "en": "I'm slow, but I don't stop."},
        {"zh": "我的头比身子还大", "en": "My head's bigger than my body."},
        {"zh": "沙地上留一串爪印", "en": "Tiny claw prints in the sand."},
        {"zh": "我一路嗅着找吃的", "en": "I sniff along for food."},
        {"zh": "我小跑两步就停", "en": "Two steps of a trot, then stop."},
        {"zh": "我绕开石头走", "en": "I walk around the stones."},
        {"zh": "我在草丛里探出头", "en": "I poke my head from the grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，爪子抱在身前", "en": "I sit with my claws in front."},
        {"zh": "我的眼睛非常大", "en": "My eyes are huge."},
        {"zh": "我等主人叫我", "en": "I wait for my master to call."},
        {"zh": "我只有五点生命", "en": "I have only five points of life."},
        {"zh": "我什么都怕，却很好奇", "en": "I fear everything, yet I'm curious."},
        {"zh": "我在听四周的声音", "en": "I listen to everything around."},
        {"zh": "我想把泡泡吹出去", "en": "I think bubbles can be spat out."},
        {"zh": "我等着被喂食", "en": "I wait to be fed."},
        {"zh": "草丛里有虫子", "en": "There's a bug in the grass."},
        {"zh": "这里挺安全的", "en": "It's pretty safe here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你很大，但我看得见你", "en": "You're big, but I see you."},
        {"zh": "我可以跟着你吗", "en": "May I follow you?"},
        {"zh": "你手里有幼年期饲料吗", "en": "Got any in-training feed?"},
        {"zh": "我坐下就不会乱跑", "en": "If I sit, I won't wander."},
        {"zh": "你蹲下来我就过来", "en": "Crouch down and I'll come."},
        {"zh": "我打不过你，我清楚", "en": "I can't beat you; I know that."},
        {"zh": "但我会吹泡泡", "en": "But I can blow bubbles."},
        {"zh": "你可别踩到我", "en": "You won't step on me, right?"},
        {"zh": "你叫一声我就到", "en": "Call once and I'm there."},
        {"zh": "我耳朵小，但很灵", "en": "My ears are small, but sharp."},
        {"zh": "你想看我进化吗", "en": "Want to see me evolve?"},
        {"zh": "我能长成别的样子", "en": "I can grow into something else."},
        {"zh": "你在看我的爪子", "en": "You're looking at my claws."},
        {"zh": "再站一会儿也没关系", "en": "Staying a little longer is fine."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打得滚了出去", "en": "The hit sent me rolling."},
        {"zh": "我很小，很疼", "en": "I'm small, and it hurts."},
        {"zh": "我总共只有五点生命", "en": "I only have five points in all."},
        {"zh": "我的泡泡乱飞", "en": "My bubbles scatter."},
        {"zh": "我咬着牙没叫", "en": "I bit down and stayed quiet."},
        {"zh": "我缩成一团，爪子发抖。", "en": "I curl up, my claws trembling."},
        {"zh": "我好像要进化了", "en": "I'm going to evolve."},
        {"zh": "疼！等我进化了再说。", "en": "Ouch! Wait until I digivolve."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "幼年期饲料？我最喜欢", "en": "In-training feed? My favorite."},
        {"zh": "这一小口就够我饱", "en": "A tiny bite fills me up."},
        {"zh": "我吃得很慢，别催我", "en": "I eat slowly; don't rush me."},
        {"zh": "吃完我就跟着你", "en": "After eating, I'll follow you."},
        {"zh": "我把爪子伸进碗里", "en": "I stick my claws in the bowl."},
        {"zh": "这点饲料我能吃很久", "en": "This feed lasts me a long time."},
        {"zh": "你手别动，我够一下", "en": "Hold still; let me reach."},
        {"zh": "我只为吃的靠近", "en": "I only approach for food."},
        {"zh": "再多一点我就认定你", "en": "A bit more and you're mine."},
        {"zh": "我的爪子还扒着那块饲料。", "en": "My claws still clutch that feed."},
        {"zh": "吃完我会打个小嗝", "en": "I'll burp a little after."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你轻轻一碰我就翻滚", "en": "A light bump sends me rolling."},
        {"zh": "我很小，很容易被撞开", "en": "I'm small and easily knocked aside."},
        {"zh": "我抱住你的脚踝稳住", "en": "I hug your ankle to steady."},
        {"zh": "碰到我的头有点疼", "en": "Bumping my head stings a bit."},
        {"zh": "我一点事都没有", "en": "I'm perfectly fine."},
        {"zh": "千万别踩到我", "en": "Don't step on me."},
        {"zh": "我闪得相当快", "en": "I slip aside quite fast."},
        {"zh": "踩到我了，走路看着点。", "en": "You stepped on me — watch where you walk."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还只是个幼年期", "en": "I'm only in-training."},
        {"zh": "这事要等我长大", "en": "That waits until I grow up."},
        {"zh": "我只会跟人走", "en": "I only follow people."},
        {"zh": "我的世界很小", "en": "My world is small."},
        {"zh": "我更想去吃饭", "en": "I'd rather eat."},
        {"zh": "我还会变很多次", "en": "I'll change form many more times."},
        {"zh": "我还不知道会变成谁", "en": "I don't know who I'll become."},
        {"zh": "先陪我玩一会儿吧", "en": "Just play with me first."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上掉了点饲料", "en": "Some feed fell on the ground."},
        {"zh": "我用爪子扒拉着吃", "en": "I paw at it and eat."},
        {"zh": "这一粒我藏在嘴里", "en": "This bit goes in my mouth."},
        {"zh": "我抱起它，抱不稳", "en": "I hug it, but can't hold on."},
        {"zh": "它比我还大一点", "en": "It's a little bigger than me."},
        {"zh": "这点东西我要留着", "en": "I'm keeping this."},
        {"zh": "我用头顶着它摇摇晃晃。", "en": "I balance it on my head and wobble."},
        {"zh": "掉了就没得吃了", "en": "If I drop it, it's gone."},
        {"zh": "我藏到角落里", "en": "I hide it in a corner."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我要保护我的主人", "en": "I'll protect my master."},
        {"zh": "我吹泡泡很厉害的", "en": "I blow bubbles; they're strong."},
        {"zh": "你可千万别过来", "en": "Don't come closer."},
        {"zh": "我的爪子也很硬", "en": "My claws are hard too."},
        {"zh": "我个子小，但不退", "en": "I'm small, but I won't back off."},
        {"zh": "这是我第一次打仗", "en": "This is my first real fight."},
        {"zh": "我会一直吹下去", "en": "I'll keep blowing."},
        {"zh": "我在发抖，但还站着", "en": "I'm trembling, but still standing."},
        {"zh": "我要开始喊人了", "en": "I'm calling for help."},
        {"zh": "再靠近我就扑", "en": "Closer and I'll pounce."},
        {"zh": "我不会自己跑掉", "en": "I won't run away."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳来跳去，让你打不准", "en": "I hop around so you miss."},
        {"zh": "泡泡会往你脸上飞", "en": "My bubbles fly at your face."},
        {"zh": "我很小，很难打中", "en": "I'm small and hard to hit."},
        {"zh": "我等主人下令", "en": "I wait for my master's order."},
        {"zh": "我不快，但很灵活", "en": "Not fast, but nimble."},
        {"zh": "我退两步再冲", "en": "I back off two steps, then charge."},
        {"zh": "草丛能遮住我", "en": "The grass hides me."},
        {"zh": "我在仔细观察你", "en": "I'm studying you."},
        {"zh": "你抬手我就躲", "en": "Raise a hand and I dodge."},
        {"zh": "泡泡已经在嘴里了", "en": "The bubbles are ready in my mouth."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑上去咬一口", "en": "I lunge and bite."},
        {"zh": "泡泡打在你脸上", "en": "A bubble hits your face."},
        {"zh": "这一下很轻，我知道", "en": "This is light; I know."},
        {"zh": "你被泡泡糊住眼", "en": "Bubbles are in your eyes."},
        {"zh": "我咬住裤脚不放", "en": "I bite your trouser leg and hold."},
        {"zh": "我一个翻滚躲开", "en": "I roll away from you."},
        {"zh": "再吹一串泡泡", "en": "Another string of bubbles."},
        {"zh": "我力气小，但很执着", "en": "Weak, but stubborn."},
        {"zh": "你已经退后了", "en": "You stepped back."},
        {"zh": "我回到主人身边", "en": "I return to my master's side."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "小小的影子出现在草地", "en": "A small shadow appears on the grass."},
        {"zh": "我从数据里冒出来", "en": "I emerge from the data."},
        {"zh": "我一睁眼就到处看", "en": "I open my eyes and look around."},
        {"zh": "这一群有好多只", "en": "There are many in this group."},
        {"zh": "我找到我的锚点了", "en": "I found my anchor."},
        {"zh": "我抖了抖身上的光", "en": "I shake off the glow."},
        {"zh": "森林里多了个小家伙", "en": "One more little one in the forest."},
        {"zh": "我还没学会走路就出来了", "en": "Out before I learned to walk."},
        {"zh": "这里闻起来不错", "en": "This place smells nice."},
        {"zh": "是不是有人来了", "en": "Is someone coming?"}
      ]
    },
