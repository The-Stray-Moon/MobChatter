      "lines": [
        {"zh": "我被震得后仰。", "en": "The blast rocked me back."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一发擦过我的肩甲。", "en": "A round grazed my pauldron."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光从缝里钻进来。", "en": "The light got into a seam."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "空着肚子火力不足。", "en": "Empty belly, weak fire."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的骨架跑。", "en": "Lightning ran down my frame."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有岩石。", "en": "No rock under me."}
      ]
    }
  }
