{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的爪子抠进松动的岩缝。", "en": "My claws dig into the loose seams of rock."},
        {"zh": "爪子在岩面上刮。", "en": "My claws scrape the rock."},
        {"zh": "长身子压着空气。", "en": "My long frame presses the air."},
        {"zh": "尾部的炮管晃着。", "en": "The cannon on my tail sways."},
        {"zh": "我一脚踩碎石块。", "en": "My foot crushes the rubble."},
        {"zh": "山上的风很干。", "en": "The mountain wind is dry."},
        {"zh": "我沿着脊线走。", "en": "I walk along the ridge line."},
        {"zh": "脚下的碎岩在滑。", "en": "Loose rock shifts under me."},
        {"zh": "锚点还在山下。", "en": "My anchor is down the slope."},
        {"zh": "我扭头扫了一眼。", "en": "I sweep a glance behind."},
        {"zh": "恶地的红土发烫。", "en": "The badlands clay is hot."},
        {"zh": "我又往高处挪。", "en": "I shift higher."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我把炮口抬高。", "en": "I raise the cannon muzzle."},
        {"zh": "我的爪尖轻轻叩着岩石。", "en": "My claw tips tap lightly on the rock."},
        {"zh": "我站着看远处。", "en": "I stand and watch the distance."},
        {"zh": "风把尘土吹过来。", "en": "Wind brings dust."},
        {"zh": "尾巴稳住了重心。", "en": "My tail keeps my balance."},
        {"zh": "我收了一下爪子。", "en": "I retract my claws."},
        {"zh": "肩上的装甲有点热。", "en": "My shoulder armor runs warm."},
        {"zh": "炮管还在冒热气。", "en": "My barrel still gives off heat."},
        {"zh": "这里能看见很远。", "en": "I can see a long way from here."},
        {"zh": "炮管冷却着。", "en": "The barrel is cooling."},
        {"zh": "我动了动脖子。", "en": "I roll my neck."},
        {"zh": "弹药还很充足。", "en": "I have plenty of rounds."},
        {"zh": "我把尾巴横在石阶上。", "en": "I lay my tail across the stone steps."},
        {"zh": "我等下一场。", "en": "I wait for the next fight."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我矮一截。", "en": "You're a head shorter than me."},
        {"zh": "别站在我的射界里。", "en": "Don't stand in my firing line."},
        {"zh": "你的甲不够厚。", "en": "Your armor isn't thick enough."},
        {"zh": "这股汗味，我在山脊上闻过。", "en": "I've smelled that sweat up on the ridge."},
        {"zh": "我是被训练出来的。", "en": "I was trained for this."},
        {"zh": "你的手别靠近尾巴。", "en": "Keep your hands off my tail."},
        {"zh": "这一带归我巡。", "en": "I patrol this stretch."},
        {"zh": "你还要站着看多久。", "en": "How long will you stand and look?"},
        {"zh": "我的爪很利。", "en": "My claws are sharp."},
        {"zh": "别从两边一起靠过来。", "en": "Don't crowd in from both sides."},
        {"zh": "你的武器收起来。", "en": "Stow your weapon."},
        {"zh": "我们之间不需要话。", "en": "We don't need words."},
        {"zh": "你的袖口有新蹭的血。", "en": "There's fresh blood on your cuff."},
        {"zh": "你到我胸口那么高。", "en": "You come up to my chest."},
        {"zh": "转身，沿原路下坡。", "en": "Turn around and take the slope back down."},
        {"zh": "我不会追太远。", "en": "I won't chase far."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "装甲凹了一块。", "en": "A plate dented."},
        {"zh": "弹着点偏了半尺。", "en": "The impact landed half a foot wide."},
        {"zh": "关节响了一下。", "en": "A joint clicked."},
        {"zh": "我压低身子稳住。", "en": "I lower myself to steady."},
        {"zh": "血沿着金属流。", "en": "Blood runs along the metal."},
        {"zh": "岩面还撑着我。", "en": "The rock still holds me."},
        {"zh": "这一点不影响开火。", "en": "This doesn't affect my fire."},
        {"zh": "装甲上只留了一个浅坑。", "en": "Only a shallow dent is left on my armor."},
        {"zh": "我记下这道岩缝。", "en": "I've marked this crack."},
        {"zh": "我火力还在。", "en": "I still have fire."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那块肉给我。", "en": "That meat. For me."},
        {"zh": "扔到岩台上。", "en": "Toss it on the ledge."},
        {"zh": "这气味很新鲜。", "en": "The scent is fresh."},
        {"zh": "举得太近了。", "en": "Too close to my face."},
        {"zh": "这点还不够我。", "en": "Not enough for me."},
        {"zh": "我不吃石头。", "en": "I don't eat stones."},
        {"zh": "先让我看清。", "en": "Let me see it clearly."},
        {"zh": "放到岩台上。", "en": "Set it on the ledge."},
        {"zh": "我挪过去拿。", "en": "I shift over to take it."},
        {"zh": "这东西值点力气。", "en": "That's worth the effort."},
        {"zh": "我饿得能咬铁。", "en": "I'm hungry enough to bite iron."},
        {"zh": "离岩台远一点。", "en": "Step back from the ledge."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我的胫甲。", "en": "You hit my shin guard."},
        {"zh": "你的肩撞在胫甲上反弹。", "en": "Your shoulder bounces off my shin plate."},
        {"zh": "退开，我转身不快。", "en": "Back off. I turn slowly."},
        {"zh": "金属撞得很响。", "en": "Metal rang out."},
        {"zh": "碎石被我们踩散。", "en": "We scattered the rubble."},
        {"zh": "撞得你手腕发麻吧。", "en": "Your wrist must be numb."},
        {"zh": "我的尾节擦过你的肋侧。", "en": "My tail segment scrapes across your ribs."},
        {"zh": "地面很滑，站稳点。", "en": "The ground's slick. Steady."},
        {"zh": "别贴着我尾巴。", "en": "Not against my tail."},
        {"zh": "再来也只是这样。", "en": "Again would end the same."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这种事不在训练里。", "en": "That wasn't in my training."},
        {"zh": "我还没巡完这片。", "en": "My patrol isn't done."},
        {"zh": "你的身体太单薄。", "en": "You're too slight."},
        {"zh": "等这场打完再说。", "en": "After this fight."},
        {"zh": "我不懂怎么温柔。", "en": "I don't know gentle."},
        {"zh": "我的爪会伤到你。", "en": "My claws would hurt you."},
        {"zh": "先让我咬点肉。", "en": "Let me get some meat first."},
        {"zh": "我记着你的脸。", "en": "I'll remember your face."},
        {"zh": "别站在我的射界。", "en": "Don't stand in my line."},
        {"zh": "我爪尖还沾着肉末。", "en": "There's still meat between my claws."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用爪子夹住。", "en": "I pinch it with a claw."},
        {"zh": "这肉还新鲜。", "en": "This meat is still fresh."},
        {"zh": "连骨头一起咽下。", "en": "Down it goes, bones and all."},
        {"zh": "骨头没什么用。", "en": "The bone is useless."},
        {"zh": "这肉还带体温。", "en": "The meat is still warm."},
        {"zh": "我用脚尖挑起来。", "en": "I flick it up with a claw."},
        {"zh": "这点肉只够塞牙缝。", "en": "This meat barely fills a gap in my teeth."},
        {"zh": "留着待会儿吃。", "en": "I'll save it for later."},
        {"zh": "味道不算太坏。", "en": "Not a bad taste."},
        {"zh": "这是从哪来的。", "en": "Where did this come from?"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "岩脊上有动静。", "en": "Movement on the ridge."},
        {"zh": "山脊上的石头响了一下。", "en": "A stone clicked up on the ridge."},
        {"zh": "爪已经张开了。", "en": "My claws are out."},
        {"zh": "上风处飘来一股汗味。", "en": "A scent of sweat drifts down from upwind."},
        {"zh": "它在我射界里。", "en": "It's in my line."},
        {"zh": "我把炮口对住那条窄道。", "en": "I level my muzzle at the narrow pass."},
        {"zh": "眼睛没离开过。", "en": "My eyes haven't left it."},
        {"zh": "它把自己露在我的射界里。", "en": "It has left itself in my line of fire."},
        {"zh": "它退向崖边。", "en": "It's retreating to the cliff."},
        {"zh": "爪子扣进岩缝。", "en": "Claws bite into the rock."},
        {"zh": "炮口抬起来了。", "en": "The muzzle comes up."},
        {"zh": "再往前一步，我就开火。", "en": "One step more and I open fire."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着它的轨迹。", "en": "I track its path."},
        {"zh": "它往岩缝里钻。", "en": "It's slipping into a crack."},
        {"zh": "射界已经清空。", "en": "The firing lane is clear."},
        {"zh": "我等它露面。", "en": "I wait for it to show."},
        {"zh": "山风帮我遮住声音。", "en": "The wind masks my sound."},
        {"zh": "它每动一下我都看得见。", "en": "I see every move it makes."},
        {"zh": "我把炮口对准。", "en": "I aim the muzzle."},
        {"zh": "它转向我了。", "en": "It turned toward me."},
        {"zh": "等它离开岩石。", "en": "Wait till it leaves the rock."},
        {"zh": "它的破绽在侧面。", "en": "Its gap is on the side."},
        {"zh": "它卡在窄道上。", "en": "It's stuck in the narrows."},
        {"zh": "炮口对准你了。", "en": "Muzzle on target."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "加特林臂开火！", "en": "Gatling Arm!"},
        {"zh": "爪子劈下去。", "en": "My claws slash down."},
        {"zh": "尾巴甩过去。", "en": "My tail swings through."},
        {"zh": "炮口贴近了打。", "en": "Firing at close range."},
        {"zh": "金属撞在你身上。", "en": "Metal strikes you."},
        {"zh": "爪尖扣住了。", "en": "My claws have purchase."},
        {"zh": "崖边的碎石在你脚下松了。", "en": "The loose rock shifts under you at the cliff edge."},
        {"zh": "我把你压向岩壁。", "en": "I pin you to the cliff."},
        {"zh": "再补上一轮。", "en": "Another volley."},
        {"zh": "弹药在响不停。", "en": "The rounds keep chattering."},
        {"zh": "别想绕到背后。", "en": "Don't think of getting behind me."},
        {"zh": "这是最后一轮。", "en": "Last volley."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "山脊上出现一个影子。", "en": "A shape appears on the ridge."},
        {"zh": "我越过山脊过来。", "en": "I come over the ridge."},
        {"zh": "金属的反光看得见。", "en": "The metal catches light."},
        {"zh": "我踩实了岩面。", "en": "I plant my feet on stone."},
        {"zh": "这地方适合伏击。", "en": "Good ground for an ambush."},
        {"zh": "红土上的热气让我现了形。", "en": "The heat off the red clay brings me into view."},
        {"zh": "锚点在山脚。", "en": "The anchor's at the foot."},
        {"zh": "我从山脊的缺口走进来。", "en": "I come in through the gap in the ridge."},
        {"zh": "山脊那头有金属反光。", "en": "There's a glint of metal along the ridge."},
        {"zh": "我慢慢爬上尖峰。", "en": "I climb the peak slowly."},
        {"zh": "我踩塌了一小片山肩。", "en": "I break a small shoulder of the slope loose."},
        {"zh": "我准备好巡这一片了。", "en": "I'm ready to patrol this stretch."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "金属被烧得滚烫。", "en": "The metal turned scalding."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从岩沿跌下，我翻身站住。", "en": "Dropping from the ledge, I roll and land upright."}
      ]
    },
