{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我六条腿一起动，很快。", "en": "My six legs move together, fast."},
        {"zh": "我贴着地面钻过去。", "en": "I dart low over the ground."},
        {"zh": "我的壳蹭着石头响。", "en": "My shell scrapes the stone."},
        {"zh": "我在林子里窜来窜去。", "en": "I scurry through the wood."},
        {"zh": "我跑起来像在滑。", "en": "When I run, it's more like sliding."},
        {"zh": "我跑一段，停一下。", "en": "I run a stretch, then stop."},
        {"zh": "我从叶堆下面挤出来。", "en": "I squeeze out from under the leaf litter."},
        {"zh": "我顺着树皮往上爬。", "en": "I run up the bark."},
        {"zh": "我绕开一块湿的地方。", "en": "I skirt a wet patch."},
        {"zh": "我在锚点附近转圈。", "en": "I circle near my anchor point."},
        {"zh": "我走路带着一股味。", "en": "A smell follows me as I move."},
        {"zh": "我拐弯不用减速。", "en": "I turn without slowing."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停着，触角还在扫。", "en": "I stop, antennae still sweeping."},
        {"zh": "我吃的东西，你不想知道。", "en": "You don't want to know what I eat."},
        {"zh": "这味道，我自己也习惯。", "en": "I'm used to my own smell."},
        {"zh": "我在等有没有能吃的东西。", "en": "I'm waiting for something edible."},
        {"zh": "我的壳是硬的。", "en": "My shell is hard."},
        {"zh": "我在阴暗的地方最舒服。", "en": "I'm most comfortable in the damp dark."},
        {"zh": "我叫蟑螂兽。", "en": "I'm called Gokimon."},
        {"zh": "我的眼睛能看很广。", "en": "My eyes see very wide."},
        {"zh": "我在这块地方待惯了。", "en": "I'm used to this spot."},
        {"zh": "我抖开背上那对薄翅。", "en": "I snap open the thin wings on my back."},
        {"zh": "我数着林子里几处湿。", "en": "I count the damp patches."},
        {"zh": "墙角那堆东西归我了。", "en": "That pile in the corner is mine."},
        {"zh": "我绕着那堆东西转。", "en": "I circle that pile."},
        {"zh": "暗处比亮处舒服。", "en": "Dark suits me better than light."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的靴子上有吃的味道。", "en": "Your boots smell of food."},
        {"zh": "你手里的东西，我看看。", "en": "Let me see what you're holding."},
        {"zh": "人踩不着我，我太快。", "en": "People can't stomp me — I'm too quick."},
        {"zh": "我太小，你抓不住。", "en": "I'm too small to catch."},
        {"zh": "你脚边让我借一下。", "en": "Let me use the space by your feet."},
        {"zh": "你的鞋底不太干净。", "en": "Your soles aren't very clean."},
        {"zh": "我抬头看你，触角动了动。", "en": "I look up, antennae twitching."},
        {"zh": "我在算你脚落下的位置。", "en": "I'm reckoning where your foot lands."},
        {"zh": "你别在地上跺脚。", "en": "Don't stamp on the ground."},
        {"zh": "你身上有我能吃的东西吗？", "en": "Anything edible on you?"},
        {"zh": "我路过，别跺脚。", "en": "Just passing through — no stomping."},
        {"zh": "我跟你走一段。", "en": "I'll follow a stretch."},
        {"zh": "你转个身，我就换边。", "en": "Turn and I switch sides."},
        {"zh": "我的脚步，你听不见。", "en": "You can't hear my steps."},
        {"zh": "你的裤脚有点脏。", "en": "Your trouser hem is dirty."},
        {"zh": "我不咬人，除非你踩我。", "en": "I don't bite unless you step on me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我赶紧钻开。", "en": "I dart away."},
        {"zh": "裂口里渗出一点水。", "en": "A little fluid seeps from the crack."},
        {"zh": "肚皮朝天，我翻不回来。", "en": "On my back, I can't right myself."},
        {"zh": "我抖了抖，站起来了。", "en": "I shudder and right myself."},
        {"zh": "壳上的口子，我等它长好。", "en": "The crack in my shell will close on its own."},
        {"zh": "我躲到缝里。", "en": "I hide in a crack."},
        {"zh": "疼得我六条腿乱划。", "en": "The pain sets all six legs scrabbling."},
        {"zh": "一条后腿抬不起来了。", "en": "One hind leg won't lift anymore."},
        {"zh": "我还能顺着墙爬。", "en": "I can still crawl along the wall."},
        {"zh": "你这一下挺准。", "en": "That was well aimed."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是什么？给我。", "en": "What's that? Give it."},
        {"zh": "我顺着气味爬了过去。", "en": "I follow the smell over."},
        {"zh": "我先用舌头碰一点点。", "en": "I'll just touch it with my tongue."},
        {"zh": "甜的，也带点馊味。", "en": "Sweet, with a sour edge."},
        {"zh": "手里那块，别攥太紧。", "en": "Don't grip that piece so hard."},
        {"zh": "腐败的，我也照样咽。", "en": "Rotting things go down fine too."},
        {"zh": "这点塞不住我的嘴。", "en": "That won't block my mouth."},
        {"zh": "指缝里的东西，我要了。", "en": "Whatever's between your fingers, I'll take."},
        {"zh": "我咬得很快。", "en": "I bite fast."},
        {"zh": "你把东西丢地上。", "en": "Drop it on the ground."},
        {"zh": "有吃的，我跑得更快。", "en": "With food, I run faster."},
        {"zh": "吃完我还会回来。", "en": "I'll come back after eating."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩我，我赶紧钻开。", "en": "You step on me; I dart free."},
        {"zh": "我顺着你的鞋面跑过去。", "en": "I run across your boot."},
        {"zh": "我的壳被压了一下，没事。", "en": "My shell got pressed. Fine."},
        {"zh": "你碰我，我就退。", "en": "Touch me and I back off."},
        {"zh": "我躲在砖缝里。", "en": "I hide in a brick gap."},
        {"zh": "碰撞之后，我抖了抖。", "en": "After the knock I shudder."},
        {"zh": "你踩到的是我的翅膀。", "en": "You stepped on my wing."},
        {"zh": "我不疼，我只是烦。", "en": "It doesn't hurt. It's just annoying."},
        {"zh": "你抬脚，我从下面滑过。", "en": "You lift a foot and I slide under it."},
        {"zh": "被你的鞋跟蹭了一下。", "en": "Your heel scrapes across me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只也在墙缝里。", "en": "Another is in the wall crack too."},
        {"zh": "两只一起钻进了缝。", "en": "The two of us slip into the crack."},
        {"zh": "它的壳颜色比我深。", "en": "Its shell is darker than mine."},
        {"zh": "我们一起吃同一堆东西。", "en": "We eat from the same pile."},
        {"zh": "同族之间不去抢。", "en": "Our kind don't snatch from each other."},
        {"zh": "它爬到我背上。", "en": "It climbs onto my back."},
        {"zh": "它用触角敲了敲我的壳。", "en": "It taps my shell with its antenna."},
        {"zh": "它沿着墙根先走一步。", "en": "It heads off along the wall first."},
        {"zh": "墙里这样的不少。", "en": "There are plenty in the walls."},
        {"zh": "下次还在这条缝。", "en": "Next time, this same crack."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我六条腿抱着它走。", "en": "I walk off hugging it with six legs."},
        {"zh": "我拖着它走，很快。", "en": "I drag it along, fast."},
        {"zh": "这块我啃不动。", "en": "I can't gnaw this."},
        {"zh": "我拖着它钻进砖缝。", "en": "I drag it into the brick crack."},
        {"zh": "掉落的东西，我先尝。", "en": "I taste the drops first."},
        {"zh": "珍珠滑，我抱不住。", "en": "The pearl is slippery."},
        {"zh": "我叼着它爬上墙。", "en": "I carry it up the wall."},
        {"zh": "这是好东西，我留着。", "en": "Good stuff. I'll keep it."},
        {"zh": "太硬，我吐出来换一块。", "en": "Too hard; I spit it out for another."},
        {"zh": "这点东西，塞牙。", "en": "That's a crumb."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有能吃的东西。", "en": "Something edible over there."},
        {"zh": "我先动，很快。", "en": "I move first. Fast."},
        {"zh": "你踩到我的范围了。", "en": "You stepped into my range."},
        {"zh": "我往你脚边钻。", "en": "I dart toward your feet."},
        {"zh": "脚踝露在外面，正好。", "en": "That ankle is bare — perfect."},
        {"zh": "我锁定了那块。", "en": "I've fixed on that."},
        {"zh": "你一停，我的机会就来了。", "en": "Stop moving and my chance comes."},
        {"zh": "我贴着墙根摸过去。", "en": "I creep along the base of the wall."},
        {"zh": "我的起步不用预热。", "en": "I need no warm-up to start."},
        {"zh": "你影子里有个动静，是我。", "en": "That flicker in your shadow — that's me."},
        {"zh": "你回头也来不及。", "en": "Turning won't be quick enough."},
        {"zh": "我这就扑上去了。", "en": "I'm going in now."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你跳，我比你还会跑。", "en": "You jump; I run better than you."},
        {"zh": "我一直贴在你脚边。", "en": "I stay at your feet."},
        {"zh": "你换方向，我换边。", "en": "You change course; I switch sides."},
        {"zh": "我钻进缝里，又出来。", "en": "I duck into a gap and come out."},
        {"zh": "你走得越久，我跟得越稳。", "en": "The longer you walk, the steadier I follow."},
        {"zh": "我等你的脚抬起来。", "en": "I wait for your foot to lift."},
        {"zh": "这件事不必着急。", "en": "There's no rush here."},
        {"zh": "我的触角一直朝你。", "en": "My antennae point at you."},
        {"zh": "你退到湿地上，那里更滑。", "en": "You're on wet ground. Slippier."},
        {"zh": "再往前就是我的窝。", "en": "Ahead is my nest."},
        {"zh": "你换几条路了，我还在。", "en": "You've changed paths; I'm still here."},
        {"zh": "我往下水道那边引你。", "en": "I lead you toward the drain."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬一口，带点臭。", "en": "I bite, and it smells."},
        {"zh": "我用壳撞你的脚。", "en": "I butt your foot with my shell."},
        {"zh": "我爬到你手上咬。", "en": "I climb your hand and bite."},
        {"zh": "这一下很小，很烦人。", "en": "Small, and very irritating."},
        {"zh": "你甩一下，我爬回脚背。", "en": "You shake me off; I climb back onto your foot."},
        {"zh": "我爬上你的鞋面就咬。", "en": "I climb onto your shoe and bite."},
        {"zh": "你踩我，我躲开了。", "en": "You stomp; I dodge."},
        {"zh": "这一口，有点毒。", "en": "That bite carries something."},
        {"zh": "我贴着你转圈。", "en": "I circle right against you."},
        {"zh": "你别指望甩掉我。", "en": "Don't count on shaking me off."},
        {"zh": "我用触角扫你的脸。", "en": "I sweep your face with an antenna."},
        {"zh": "这口咬在脚踝上。", "en": "That bite landed on your ankle."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从腐叶底下一拱。", "en": "I push up through the rotting leaves."},
        {"zh": "这块地方有味道。", "en": "This place has a smell."},
        {"zh": "我先动了动触角。", "en": "First I work my antennae."},
        {"zh": "阴暗处正好。", "en": "The shade suits me."},
        {"zh": "腐叶下面冒出一对触角。", "en": "A pair of antennae pokes out of the leaf litter."},
        {"zh": "这里能吃的东西不少。", "en": "Plenty to eat here."},
        {"zh": "我从土里带出一身灰。", "en": "I come up out of the dirt all dusty."},
        {"zh": "我绕着地面转了一圈。", "en": "I circle the ground once."},
        {"zh": "地板的震动传到我腿上。", "en": "The floor's shaking reaches my legs."},
        {"zh": "我钻进最近的缝。", "en": "I duck into the nearest crack."},
        {"zh": "天一亮，我就找阴处。", "en": "With first light, I look for shade."},
        {"zh": "我的窝就在附近。", "en": "My nest is nearby."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我的壳就卷了。", "en": "Fire curls my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，我翻了个身。", "en": "I fall and flip over."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我冲得转圈。", "en": "Water spins me around."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响之后我贴在砖上。", "en": "After the blast I'm stuck to the brick."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭尾还在抖，我被钉住了。", "en": "The arrow still quivers; I'm pinned."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光一闪，我僵住了。", "en": "A flash, and I freeze."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我连壳都软。", "en": "Hungry enough that my shell softens."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我腿都麻。", "en": "Lightning strikes and my legs go numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直往下掉，停不了。", "en": "I fall and can't stop."}
      ]
    }
  }
}
