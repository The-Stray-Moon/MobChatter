{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步踩在松针上。", "en": "I step through pine needles."},
        {"zh": "高大的身子擦过树杈。", "en": "My tall frame brushes the branches."},
        {"zh": "我沿着林线慢慢走。", "en": "I walk slowly along the treeline."},
        {"zh": "脚下的苔被压出印。", "en": "Moss takes my prints."},
        {"zh": "锚点就在身后。", "en": "My anchor point is behind me."},
        {"zh": "我绕了这片林子一圈。", "en": "I've circled this grove."},
        {"zh": "枝叶在我身侧响。", "en": "Twigs rasp at my sides."},
        {"zh": "黑暗森林里很安静。", "en": "The dark forest is quiet."},
        {"zh": "我低头看脚下的草。", "en": "I look down at the grass."},
        {"zh": "走得不快，但一步很长。", "en": "Not quick, but each stride is long."},
        {"zh": "风穿过我的枝叶。", "en": "Wind moves through my branches."},
        {"zh": "我又靠近了锚点。", "en": "I drift back toward my anchor."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着像一棵树。", "en": "I stand like a tree."},
        {"zh": "枝叶慢慢张开。", "en": "My branches slowly open."},
        {"zh": "我在晒太阳吗。", "en": "Am I sunning myself?"},
        {"zh": "根须抓着泥土。", "en": "My roots hold the soil."},
        {"zh": "这片林子的味道很好。", "en": "This forest smells good."},
        {"zh": "我尝了一口嫩芽。", "en": "I taste a new shoot."},
        {"zh": "几只鸟落在我臂上。", "en": "Birds land on my arm."},
        {"zh": "枝叶间有风的声音。", "en": "Wind sounds among my leaves."},
        {"zh": "我慢慢合上眼皮。", "en": "I slowly close my eyes."},
        {"zh": "这片针叶林我认得。", "en": "I know these pines."},
        {"zh": "土里有水的味道。", "en": "There's water in the soil."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有树的味道。", "en": "You smell of trees."},
        {"zh": "你身上有树的味道，这一片林子归我照看。", "en": "You smell of trees; I look after this wood."},
        {"zh": "你会种树吗？", "en": "Do you plant trees?"},
        {"zh": "我的枝叶会动的。", "en": "My branches move."},
        {"zh": "你站近一点也没关系。", "en": "You may stand closer."},
        {"zh": "这一片林子归我照看。", "en": "I look after this grove."},
        {"zh": "我的枝条在你头顶摇晃。", "en": "My branches sway over your head."},
        {"zh": "我不喜欢被砍伐。", "en": "I dislike being cut."},
        {"zh": "你的斧子收起来吧。", "en": "Put the axe away."},
        {"zh": "要摸摸我的叶子吗。", "en": "Would you touch my leaves?"},
        {"zh": "我对你很客气。", "en": "I'm being polite to you."},
        {"zh": "你知道锚点在哪吗。", "en": "Do you know where my anchor is?"},
        {"zh": "我树皮一样的脸上没有表情。", "en": "My bark-like face shows nothing."},
        {"zh": "这片林子是我种的吗。", "en": "Did I plant this grove?"},
        {"zh": "你手上有火的味。", "en": "Your hands smell of fire."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一根枝条折断了。", "en": "A branch snapped."},
        {"zh": "汁液从裂口渗出。", "en": "Sap seeps from the split."},
        {"zh": "枝条朝一边倾。", "en": "My branches lean aside."},
        {"zh": "根须被踩痛了。", "en": "My roots ache."},
        {"zh": "我还站得直。", "en": "I still stand straight."},
        {"zh": "这点伤能长回来。", "en": "This will grow back."},
        {"zh": "我又抓紧了土。", "en": "I grip the soil again."},
        {"zh": "我记下这身铁味。", "en": "I've kept that iron smell."},
        {"zh": "别碰我的根。", "en": "Leave my roots alone."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那片嫩叶给我吗。", "en": "Is that shoot for me?"},
        {"zh": "我能吃这个吗。", "en": "May I eat this?"},
        {"zh": "那株苗很嫩。", "en": "That shoot is tender."},
        {"zh": "我腰后那根刺，滴着毒。", "en": "The stinger at my waist drips venom."},
        {"zh": "这是肥料吗。", "en": "Is this fertilizer?"},
        {"zh": "我闻到了泥土味。", "en": "I smell soil."},
        {"zh": "这些能种在我旁边。", "en": "These could go beside me."},
        {"zh": "这份心意我领了。", "en": "I take the gesture."},
        {"zh": "慢慢递给我。", "en": "Hand it over slowly."},
        {"zh": "我不吃肉这种东西。", "en": "I don't eat meat."},
        {"zh": "这一株长得不错。", "en": "That one's grown well."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到了我的干。", "en": "You hit my trunk."},
        {"zh": "我不太容易被推动。", "en": "I'm not easily moved."},
        {"zh": "退开一点，根很浅。", "en": "Step back. My roots are shallow."},
        {"zh": "枝叶抖了一阵。", "en": "My branches shook a while."},
        {"zh": "你踩到了我的根须。", "en": "You stepped on a root."},
        {"zh": "我把根挪开半寸。", "en": "I shift my roots an inch."},
        {"zh": "地被我压出坑。", "en": "The earth pits under me."},
        {"zh": "树干晃了一下而已。", "en": "My trunk only swayed."},
        {"zh": "风帮你推我了吗。", "en": "Did the wind help you push?"},
        {"zh": "站稳，地上滑。", "en": "Steady. The ground is slick."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是一株会走的树。", "en": "I'm a walking tree."},
        {"zh": "这要等很久很久。", "en": "That would take a long while."},
        {"zh": "我连自己的种类都记不清。", "en": "I can't recall my own kind."},
        {"zh": "你身上还带着火。", "en": "You still carry fire."},
        {"zh": "根和根才能相连。", "en": "Only roots join roots."},
        {"zh": "坐在我旁边就好。", "en": "Just sit beside me."},
        {"zh": "枝叶会慢慢合上。", "en": "My branches will close slowly."},
        {"zh": "谢谢你愿意留下。", "en": "Thank you for staying."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这是颗种子。", "en": "This is a seed."},
        {"zh": "我扎根试了试，土不错。", "en": "I test the soil with my roots; it's good."},
        {"zh": "我用手掌挖开。", "en": "I scoop with my palm."},
        {"zh": "这个能长大。", "en": "This one can grow."},
        {"zh": "叶子掉在地上了。", "en": "A leaf fell to the ground."},
        {"zh": "根须缠住它了。", "en": "My roots have wrapped it."},
        {"zh": "留着，回头种。", "en": "I'll save it to plant later."},
        {"zh": "我用藤蔓把它拨开。", "en": "I push it aside with a vine."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西踩断了枝。", "en": "Something snapped a branch."},
        {"zh": "林子静下来了。", "en": "The grove went quiet."},
        {"zh": "我把枝叶张开。", "en": "I spread my branches."},
        {"zh": "锚点不能丢。", "en": "I can't lose my anchor."},
        {"zh": "我挡在这条路上。", "en": "I block this path."},
        {"zh": "我看见树影里的动。", "en": "I see movement in the shadows."},
        {"zh": "根须抓紧了。", "en": "My roots tighten."},
        {"zh": "毒刺准备好了。", "en": "My deadly sting is ready."},
        {"zh": "这一步别越过。", "en": "Don't cross this step."},
        {"zh": "根已经扎稳。", "en": "My roots are set."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢跟着它。", "en": "I follow it slowly."},
        {"zh": "枝叶遮住了我。", "en": "The branches hide me."},
        {"zh": "它往林子深处走。", "en": "It's going deeper."},
        {"zh": "这里的树都是我的。", "en": "All these trees are mine."},
        {"zh": "我在等它靠近锚点。", "en": "I wait for it to near my anchor."},
        {"zh": "毒刺抬起来了。", "en": "My sting is raised."},
        {"zh": "它的脚步在枝上响。", "en": "Its feet sound on branches."},
        {"zh": "我数着它经过几棵树。", "en": "I count the trees it passes."},
        {"zh": "等它踏进根须范围。", "en": "Wait till it steps on my roots."},
        {"zh": "这个角度能刺到。", "en": "I can reach from this angle."},
        {"zh": "它停在我的树荫里。", "en": "It stopped in my shade."},
        {"zh": "枝条收紧了。", "en": "My branches draw in."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "死针刺出去！", "en": "Deadly Sting!"},
        {"zh": "枝条抽下去。", "en": "My branches lash down."},
        {"zh": "根从土里翻起来。", "en": "My roots heave up."},
        {"zh": "枝条压得很沉。", "en": "The branches came down heavy."},
        {"zh": "我打得很慢。", "en": "I strike slowly."},
        {"zh": "你的甲挡不住刺。", "en": "Your armor won't stop the sting."},
        {"zh": "枝叶缠住你了。", "en": "My branches have you."},
        {"zh": "我往后退半步。", "en": "I step back half."},
        {"zh": "再刺上第二次。", "en": "A second sting."},
        {"zh": "土被翻起来了。", "en": "The soil's torn up."},
        {"zh": "这一下为了林子。", "en": "That was for the grove."},
        {"zh": "别砍我的干。", "en": "Don't cut my trunk."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里多了一棵会走的树。", "en": "A walking tree in the forest."},
        {"zh": "我从林线那边过来。", "en": "I come from past the treeline."},
        {"zh": "针叶粘在我的枝上。", "en": "Pine needles cling to me."},
        {"zh": "黑森林里光线很暗。", "en": "The dark forest is dim."},
        {"zh": "我找到了自己的锚点。", "en": "I found my anchor."},
        {"zh": "脚下踩出一条新路。", "en": "I press out a new path."},
        {"zh": "我在这一片安顿下来。", "en": "I settle in this stretch."},
        {"zh": "我的枝叶还带着露。", "en": "Dew still on my branches."},
        {"zh": "远处有别的影子。", "en": "Another shape in the distance."},
        {"zh": "这片林子我照看。", "en": "I'll watch over this grove."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "枝叶烧得卷起来。", "en": "My branches curl in the fire."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时根断了几根。", "en": "Some roots tore on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水泡着我的根。", "en": "Water soaks my roots."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "土和叶都被掀开。", "en": "Soil and leaves flew up."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头卡在我的干上。", "en": "An arrow stuck in my trunk."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光穿过我的枝叶。", "en": "The light passes through my leaves."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "缺了土，叶子发黄。", "en": "Without soil my leaves yellow."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈上来了，我发黑。", "en": "The bolt struck. I blackened."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "根抓不住任何东西。", "en": "My roots hold nothing."}
      ]
    }
  }
}
