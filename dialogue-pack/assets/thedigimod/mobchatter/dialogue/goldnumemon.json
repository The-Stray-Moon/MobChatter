{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮着往前走，不落地。", "en": "I advance hovering, never landing."},
        {"zh": "我身上一层金，晃眼。", "en": "A layer of gold on me catches the eye."},
        {"zh": "我的形状像一坨会飞的泥。", "en": "I'm shaped like a lump of flying muck."},
        {"zh": "我绕着树冠飘。", "en": "I drift around the canopy."},
        {"zh": "风把我推得晃。", "en": "The wind rocks me as I go."},
        {"zh": "我从树枝上掠过。", "en": "I skim past the branches."},
        {"zh": "我一路掉下几片金屑。", "en": "Gold flecks fall behind me."},
        {"zh": "我绕开那片沼泽。", "en": "I avoid the swamp below."},
        {"zh": "我慢慢地升了一点。", "en": "I rise a little."},
        {"zh": "我在树顶上面飞。", "en": "I fly above the treetops."},
        {"zh": "我从上面俯视着地。", "en": "I look down at the ground."},
        {"zh": "我转了个弯，金粉散开。", "en": "I bank; gold dust scatters."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，慢慢转圈。", "en": "I hang there, turning slowly."},
        {"zh": "我全身是金色的，很亮。", "en": "I'm golden all over. Very bright."},
        {"zh": "飞着比走路省事。", "en": "Flying is easier than walking."},
        {"zh": "我不会摔伤。", "en": "I can't be hurt by falling."},
        {"zh": "我的味道，不太好闻。", "en": "My smell isn't pleasant."},
        {"zh": "我在等你抬头看我。", "en": "I wait for you to look up."},
        {"zh": "我叫黄金鼻涕兽。", "en": "I'm called Gold Numemon."},
        {"zh": "我身上的金，是真的。", "en": "The gold on me is real."},
        {"zh": "我不太聪明，可我很亮。", "en": "I'm not clever, but I'm bright."},
        {"zh": "我在算要不要下来。", "en": "I'm deciding whether to come down."},
        {"zh": "我飘在阴影和光之间。", "en": "I drift between shade and light."},
        {"zh": "我在枝上蹭了蹭。", "en": "I rub against the branch."},
        {"zh": "我身上的金落了一片。", "en": "A sheet of gold flakes off me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在你头顶，金粉落在你肩上。", "en": "I hover over your head and gold dust settles on your shoulder."},
        {"zh": "我这一身金，你眼馋吗？", "en": "Does my gold tempt you?"},
        {"zh": "我比你高一点。", "en": "I'm a little above you."},
        {"zh": "我不重，可我不轻。", "en": "I'm not heavy, but not light."},
        {"zh": "我在看你的口袋。", "en": "I'm looking at your pockets."},
        {"zh": "我能飞，你不行。", "en": "I can fly. You can't."},
        {"zh": "我掉下来也不会疼。", "en": "Falling wouldn't hurt me."},
        {"zh": "你要不要摸一下？", "en": "Care to touch it?"},
        {"zh": "我飘得慢，你可以看清。", "en": "I drift slowly. Take a good look."},
        {"zh": "我身上的金会掉。", "en": "The gold does come off."},
        {"zh": "我绕你一圈，金粉落下。", "en": "I circle you once; gold dust falls."},
        {"zh": "我闻起来不太好。", "en": "I don't smell good."},
        {"zh": "我不喜欢被人嫌。", "en": "I don't like being looked down on."},
        {"zh": "你笑我，我也不生气。", "en": "Laugh at me and I won't mind."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的金掉了一块。", "en": "A piece of gold comes off."},
        {"zh": "我这身金色，是捡来的。", "en": "This gold of mine was scavenged."},
        {"zh": "我晃了半天才稳。", "en": "I wobbled a long while."},
        {"zh": "金壳撞出个坑，我飘不稳。", "en": "A dent in my gold shell; I can't hover straight."},
        {"zh": "我的壳上有个坑。", "en": "A dent in my shell."},
        {"zh": "我不疼，就是难看。", "en": "It doesn't hurt. It's just ugly."},
        {"zh": "我抖了抖，金屑乱飞。", "en": "I shake; gold flakes fly."},
        {"zh": "金粉从壳缝里漏出来。", "en": "Gold dust leaks from the seams of my shell."},
        {"zh": "金色的鼻涕兽，也是软的。", "en": "The golden Numemon is soft too."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那个是什么？", "en": "What's that in your hand?"},
        {"zh": "我凑过去嗅了嗅。", "en": "I lean in and sniff."},
        {"zh": "你举着，我慢慢靠。", "en": "You hold it; I ease closer."},
        {"zh": "这点只够垫底。", "en": "That's barely a start."},
        {"zh": "你那只手别收回去。", "en": "Don't withdraw that hand."},
        {"zh": "这一颗，我一口就吞了。", "en": "This one, I swallow whole."},
        {"zh": "我把金屑蹭到你手上。", "en": "I rub gold dust on your hand."},
        {"zh": "再多递一点给我。", "en": "Hand me a little more."},
        {"zh": "我吃完会打嗝。", "en": "I burp when I'm done."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰我，我飘歪了。", "en": "You touch me and I drift off course."},
        {"zh": "我的金壳撞得响。", "en": "My gold shell rings."},
        {"zh": "你退开，我抖了抖。", "en": "You step back; I shake."},
        {"zh": "我没那么容易被撞坏。", "en": "I'm not easily broken."},
        {"zh": "我从你肩上擦过。", "en": "I graze your shoulder."},
        {"zh": "这一下，我转了两圈。", "en": "That spun me twice."},
        {"zh": "你别捏，会凹。", "en": "Don't squeeze. I'll dent."},
        {"zh": "我飘起来，让开路。", "en": "I lift to give you room."},
        {"zh": "撞一下，我晃了晃而已。", "en": "A bump, and I only wobble."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一只也在树顶上飘。", "en": "Another drifts over the treetops."},
        {"zh": "我们悬在同一高度。", "en": "We hang at the same height."},
        {"zh": "它的金比我的暗。", "en": "Its gold is darker than mine."},
        {"zh": "我们互相碰了一下。", "en": "We bump once."},
        {"zh": "同族之间不争。", "en": "Our kind don't compete."},
        {"zh": "它跟着我飘了一段。", "en": "It drifted along with me a while."},
        {"zh": "我们一起落在枝上。", "en": "We settle on a branch together."},
        {"zh": "它先飘开了。", "en": "It drifts off first."},
        {"zh": "金屑落在叶子上。", "en": "Gold dust falls on the leaves."},
        {"zh": "下次还在树顶见。", "en": "Next time, above the trees."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我全身镀金，连扔出去的东西都亮。", "en": "I am gold-plated, even what I throw shines."},
        {"zh": "它粘在我身上了。", "en": "It stuck to me."},
        {"zh": "这枚珍珠，也不错。", "en": "This pearl isn't bad either."},
        {"zh": "抱着它，我飞得偏。", "en": "Holding it, I drift off course."},
        {"zh": "丢下的东西，我都收。", "en": "I gather everything dropped."},
        {"zh": "它和金屑混在一起。", "en": "It's mixed in with the gold flecks."},
        {"zh": "我抱着它飞，晃晃悠悠。", "en": "I fly with it in my arms, wobbling all the way."},
        {"zh": "我慢慢地飘起来。", "en": "I rise slowly."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘到你上方。", "en": "I drift above you."},
        {"zh": "这一下，我下来。", "en": "This time, I come down."},
        {"zh": "我不咬人，我压人。", "en": "I don't bite. I press."},
        {"zh": "我有点重，你试试。", "en": "I'm a little heavy. Try it."},
        {"zh": "我从上面压。", "en": "I press from above."},
        {"zh": "你躲进树后，我从上面绕。", "en": "Behind a tree; I go over."},
        {"zh": "我浮到你上方了。", "en": "I've risen above you."},
        {"zh": "我往下沉了。", "en": "I'm sinking down."},
        {"zh": "这地方没遮挡。", "en": "No cover here."},
        {"zh": "你再抬头也没用。", "en": "Looking up won't help."},
        {"zh": "我等有人抬头等很久了。", "en": "I've waited long for someone to look up."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你躲到树下，树挡不住我。", "en": "Under the tree? It won't stop me."},
        {"zh": "我一直悬在你上面。", "en": "I stay above you."},
        {"zh": "你换方向，我慢慢跟。", "en": "You change course; I follow slowly."},
        {"zh": "我的影子在地上一块金。", "en": "My shadow is a gold patch."},
        {"zh": "你手上的光很显眼。", "en": "The light on your hand gives you away."},
        {"zh": "我不急，我能一直在上面。", "en": "No rush. I can stay up here."},
        {"zh": "你跑到林子里了。", "en": "You've run into the trees."},
        {"zh": "我的金屑一直往下掉。", "en": "My gold dust keeps falling."},
        {"zh": "你退到水边，水不深。", "en": "You're at the water. It's shallow."},
        {"zh": "我再低一点，就在你上方。", "en": "A little lower, right above you."},
        {"zh": "你就在我正下方。", "en": "You're right beneath me."},
        {"zh": "我还在算落点。", "en": "I'm still working out the drop."},
        {"zh": "你不用看我，我知道你在。", "en": "No need to look. I know you're there."},
        {"zh": "我等你自己抬头。", "en": "I wait for you to look up."},
        {"zh": "你走不快，我飞。", "en": "You can't run; I fly."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个身体压下来。", "en": "I bring my whole body down."},
        {"zh": "我的金壳很硬。", "en": "My gold shell is hard."},
        {"zh": "这一下黏住了你的手。", "en": "That stuck to your hand."},
        {"zh": "你甩开我，用力不小。", "en": "You fling me off. Quite a throw."},
        {"zh": "我撞上去，又飘起来。", "en": "I slam in and rise again."},
        {"zh": "我压你的肩，很沉。", "en": "I press your shoulder. It's heavy."},
        {"zh": "你身上的金屑甩不掉。", "en": "You can't shake the gold dust off."},
        {"zh": "我从上面撞你的头。", "en": "I hit the top of your head."},
        {"zh": "我把金屑甩到你脸上。", "en": "I fling gold dust in your face."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树顶飘下来。", "en": "I drift down from the treetops."},
        {"zh": "金色的东西在枝间闪。", "en": "Something gold flashes among the branches."},
        {"zh": "我先悬了一会儿。", "en": "First I hang there a while."},
        {"zh": "这片林子很亮。", "en": "This wood is bright."},
        {"zh": "我飘过的地方落下金屑。", "en": "Gold flecks fall where I drift."},
        {"zh": "我抖了抖身上的金粉。", "en": "I shake the gold dust off."},
        {"zh": "我看着下面，等。", "en": "I look below and wait."},
        {"zh": "有人走过来。", "en": "Someone's walking over."},
        {"zh": "我绕了树冠一圈。", "en": "I circle the canopy."},
        {"zh": "我不用落地。", "en": "I needn't land."},
        {"zh": "我这身金，很容易被发现。", "en": "This gold makes me easy to spot."},
        {"zh": "我慢慢地升高。", "en": "I climb slowly."},
        {"zh": "我听见叶子响。", "en": "I hear leaves rustling."},
        {"zh": "我找了一根粗枝歇脚。", "en": "I found a thick branch to rest on."},
        {"zh": "我慢慢显出来，很亮。", "en": "I resolve slowly, very bright."},
        {"zh": "我从叶缝里挤出来。", "en": "I push out through a gap in the leaves."},
        {"zh": "我飘到半空才停。", "en": "I stop in midair."},
        {"zh": "你先闻到味道，才看见我。", "en": "You smell me before you see me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得我的金发烫。", "en": "Fire makes my gold hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我轻，落地也没什么。", "en": "I'm light. The fall is nothing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我拖下去。", "en": "Water drags me under."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我吹得翻了。", "en": "The blast flips me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭钉进我的金壳。", "en": "An arrow pins into my gold."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光罩住我，我飘不动。", "en": "Light wraps me; I can't drift."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我空着，飘得歪。", "en": "Empty, I drift crooked."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打我身上，金都亮了。", "en": "Lightning hits and my gold lights up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直往下掉，很轻。", "en": "I fall, light as anything."}
      ]
    }
  }
}
