{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我扇着翅膀，声音很响。", "en": "My wings beat loudly."},
        {"zh": "我这一身是黑红的甲。", "en": "My armor is black and red."},
        {"zh": "我的角像两把刀。", "en": "My horns are like two blades."},
        {"zh": "我飞在低处。", "en": "I fly low."},
        {"zh": "我落在沙上，又飞起。", "en": "I land on the sand, then rise."},
        {"zh": "我绕着岩石转。", "en": "I circle the rocks."},
        {"zh": "我的脚爪抓着风。", "en": "My claws grip the air."},
        {"zh": "我在废料堆上停了一下。", "en": "I pause on a scrap heap."},
        {"zh": "我朝山那边飞。", "en": "I fly toward the hills."},
        {"zh": "我比同族大一点。", "en": "I am a size larger than my kin."},
        {"zh": "刃锹形虫，慢慢落下来。", "en": "BladeKuwagamon comes down slowly."},
        {"zh": "我掠过沙丘，影子在下", "en": "I skim the dunes with my shadow below."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在石头上。", "en": "I perch on a stone."},
        {"zh": "我的颚在动。", "en": "My mandibles move."},
        {"zh": "我身上有铁锈味。", "en": "I smell of rust."},
        {"zh": "这块石头很暖。", "en": "This stone is warm."},
        {"zh": "我在石头上磨着角", "en": "I hone my mandibles on the stone."},
        {"zh": "远处有金属声。", "en": "Metal sounds far off."},
        {"zh": "我在等废料。", "en": "I am waiting for scrap."},
        {"zh": "我抖了抖甲。", "en": "I rattle my armor."},
        {"zh": "我的角上有一道旧痕。", "en": "There is an old scar on my horn."},
        {"zh": "我闭上了颚。", "en": "I close my mandibles."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是能吃的东西吗。", "en": "Are you something to eat?"},
        {"zh": "废料，我喜欢。", "en": "Scrap. I like scrap."},
        {"zh": "我的复眼映出你的影子", "en": "My compound eyes hold your reflection."},
        {"zh": "你比我的角矮。", "en": "You are shorter than my horns."},
        {"zh": "我这一身，很硬。", "en": "This body is hard."},
        {"zh": "我在掂量你。", "en": "I am weighing you up."},
        {"zh": "你的膝盖就在我的角前", "en": "Your knee is right before my mandibles."},
        {"zh": "这把角刃，记住了你的样子。", "en": "This horn blade has your shape now."},
        {"zh": "我在想，从哪儿下口。", "en": "I am deciding where to bite."},
        {"zh": "别看我这么久。", "en": "Do not stare that long."},
        {"zh": "我马上要动。", "en": "I am going to move."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的甲上留了印。", "en": "There is a mark on my armor."},
        {"zh": "歪着飞开，翼片在响。", "en": "I veer away, wing blades ringing."},
        {"zh": "我的翅膀一顿。", "en": "My wing stuttered."},
        {"zh": "我栽进沙里，翅还在转", "en": "I crash into the sand, wings still spinning."},
        {"zh": "甲上的凹痕，我记住了", "en": "I will remember the dent in my shell."},
        {"zh": "血沾在颚上。", "en": "Blood on my mandibles."},
        {"zh": "我慢慢升空。", "en": "I climb slowly."},
        {"zh": "我抖掉沙，重新振翅", "en": "I shake off the sand and beat my wings again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是废铁吗。", "en": "Is that scrap iron?"},
        {"zh": "那块我要了。", "en": "I want that."},
        {"zh": "那块锈铁，我闻到了", "en": "I smell that rusty iron."},
        {"zh": "这一块太小。", "en": "Too small a piece."},
        {"zh": "够我吃一顿。", "en": "Enough for one meal."},
        {"zh": "我就拿走了。", "en": "I am taking it."},
        {"zh": "你身上还有吗。", "en": "Any more on you?"},
        {"zh": "这废料的味，正合我口", "en": "This scrap tastes just right."},
        {"zh": "你的手别缩。", "en": "Do not pull your hand back."},
        {"zh": "我的钳，就是刀。", "en": "These mandibles are blades."},
        {"zh": "那我再来一次。", "en": "Once more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，甲响了一声。", "en": "You hit me and my armor rang."},
        {"zh": "我的角刃擦过你的肩", "en": "My blade mandibles graze your shoulder."},
        {"zh": "我的角擦到你了。", "en": "My horn grazed you."},
        {"zh": "你的护甲比石头软", "en": "Your armor is softer than stone."},
        {"zh": "翅膜被你捏得发皱", "en": "You crumple the membrane of my wing."},
        {"zh": "沙被我们扬起。", "en": "Sand rises around us."},
        {"zh": "我在半空停住，翅还在响", "en": "I stop midair, wings still rattling."},
        {"zh": "从我脚下让开。", "en": "Get out from under me."},
        {"zh": "我已经飞过去了。", "en": "I have flown past."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我用角敲了敲石头。", "en": "I tap the stone with my horn."},
        {"zh": "它已经听见。", "en": "It heard."},
        {"zh": "我们绕着同一块岩。", "en": "We circle the same rock."},
        {"zh": "它的甲比我的亮。", "en": "Its armor is brighter than mine."},
        {"zh": "我们一起落在沙上。", "en": "We land on the sand together."},
        {"zh": "废料堆够我们翻。", "en": "The scrap heap has enough for both."},
        {"zh": "我们不会争。", "en": "We do not fight."},
        {"zh": "沙落在我们交叠的翅上", "en": "Sand settles on our overlapping wings."},
        {"zh": "它朝废料堆去了，我跟着", "en": "It heads for the scrap heap, and I follow."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块废铁，我要。", "en": "I want this scrap."},
        {"zh": "太重，飞不高。", "en": "Too heavy to gain height."},
        {"zh": "我带着它飞了一段。", "en": "I fly a stretch with it."},
        {"zh": "这个不是金属。", "en": "Not metal."},
        {"zh": "这块不是铁，我丢开", "en": "This is not iron; I drop it."},
        {"zh": "谁也抢不走。", "en": "No one takes it."},
        {"zh": "回头我再来。", "en": "I will come back."},
        {"zh": "别把我当废料捡走。", "en": "Don't scoop me up like scrap."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "是金属的味道。", "en": "That is the smell of metal."},
        {"zh": "我压低飞行。", "en": "I drop low."},
        {"zh": "角尖对着前面。", "en": "Horns forward."},
        {"zh": "我的大颚像两把刀。", "en": "These mandibles are two blades."},
        {"zh": "我已经锁定。", "en": "Locked."},
        {"zh": "别往那边飞。", "en": "Do not fly that way."},
        {"zh": "我来了，抬头。", "en": "Here I am. Look up."},
        {"zh": "正是这会儿。", "en": "Right about now."},
        {"zh": "我这就撞过去。", "en": "Ram."},
        {"zh": "我从上面飞过去。", "en": "Fly past."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "那挡不住角。", "en": "That will not stop horns."},
        {"zh": "你正在后退。", "en": "You are falling back."},
        {"zh": "我又追上去。", "en": "I close in."},
        {"zh": "我收紧翅膀，笔直冲下", "en": "I fold my wings and dive straight down."},
        {"zh": "我用角去挑。", "en": "I hook with my horn."},
        {"zh": "你挡在下面。", "en": "You are below my line."},
        {"zh": "我一个翻身就下去。", "en": "One roll and I am down."},
        {"zh": "目标锁定，翅膀开始震了。", "en": "Target locked; my wings are starting to vibrate."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一头撞下去。", "en": "I drive my head down."},
        {"zh": "角划开了一道。", "en": "The horn opened a cut."},
        {"zh": "我又飞高，再冲。", "en": "I climb and dive again."},
        {"zh": "你被我的角挑得后退", "en": "My mandibles hook you back a step."},
        {"zh": "我的颚咬住不放。", "en": "My mandibles clamp on."},
        {"zh": "沙里有了血。", "en": "Blood in the sand."},
        {"zh": "我拉起高度，再对准你", "en": "I climb and line you up again."},
        {"zh": "这一下，值不少。", "en": "That was worth something."},
        {"zh": "还有最后一次。", "en": "One more."},
        {"zh": "角刃从侧面划开你的甲", "en": "My mandibles slice your armor from the side."},
        {"zh": "角尖擦着你的甲。", "en": "My horn tip scrapes your armor."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙上飞起来。", "en": "I lift off the sand."},
        {"zh": "这里废料不少。", "en": "Plenty of scrap here."},
        {"zh": "太阳很刺眼。", "en": "The sun is harsh."},
        {"zh": "我的翅膀一震。", "en": "My wings give a beat."},
        {"zh": "石头缝里有金属味。", "en": "There is metal in the rock cracks."},
        {"zh": "这一带有我的同族。", "en": "My kin are in this area."},
        {"zh": "我落在高处。", "en": "I land on high ground."},
        {"zh": "我准备去找。", "en": "I am going to forage."},
        {"zh": "我扬起一片沙。", "en": "I kick up sand."},
        {"zh": "我飞向那边。", "en": "I fly that way."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到甲，我是铁的，烫。", "en": "Fire on my armor. I am iron. It burns."}
      ]
    },
