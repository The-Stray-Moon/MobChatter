      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀僵住了。", "en": "My wings have seized."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有废料，我就弱了。", "en": "Without scrap I weaken."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我角上，一路麻。", "en": "Lightning hit my horn and numbed me through."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有可落脚的东西。", "en": "There is nothing to land on here."}
      ]
    }
  }
