{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着稳定的步子在林中走", "en": "I walk through the wood at a steady pace."},
        {"zh": "我的臂很长，垂在身侧", "en": "My long arms hang at my sides."},
        {"zh": "我朝锚点那边巡过去", "en": "I patrol back toward my anchor."},
        {"zh": "落叶被我的脚扫开", "en": "My feet sweep the fallen leaves aside."},
        {"zh": "我绕过一棵巨大的蕨。", "en": "I round a giant fern."},
        {"zh": "我的数据流在体表漫过", "en": "Data streams flow over my surface."},
        {"zh": "我朝有异常的方向走", "en": "I walk toward the disturbance."},
        {"zh": "我停下来，扫描四周", "en": "I stop and scan the area."},
        {"zh": "我的影子落在林地上", "en": "My shadow falls on the forest floor."},
        {"zh": "我一步跨过雨水沟。", "en": "I stride over a rain gully."},
        {"zh": "我又回到了原来的路线", "en": "I return to my former line."},
        {"zh": "我的数据，已经到成熟期了。", "en": "My data has reached Adult level."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在树下，一动不动", "en": "I stand under the tree, motionless."},
        {"zh": "我的身体在缓慢运转", "en": "My body runs on, slowly."},
        {"zh": "我记着自己是被带到哪里的", "en": "I remember where I was brought."},
        {"zh": "锚点就在这附近", "en": "My anchor is close by."},
        {"zh": "我侧了侧头，数据在转", "en": "I tilt my head; data turns over."},
        {"zh": "我的爪尖轻轻敲着地面", "en": "My claw tips tap the ground."},
        {"zh": "林中的光斑在我身上移动", "en": "Sunflecks move across me."},
        {"zh": "等一个指令，站着不动。", "en": "Awaiting an order. Standing still."},
        {"zh": "没有指令，我就站着", "en": "Without one, I stand."},
        {"zh": "我的叶脉不发出一点声。", "en": "My leaf veins make no sound."},
        {"zh": "我慢慢收回手臂", "en": "I draw my arm back slowly."},
        {"zh": "周围的鸟都不叫了", "en": "The birds around have gone quiet."},
        {"zh": "我抬起头，看着树冠", "en": "I raise my head to the canopy."},
        {"zh": "我记住了这片地形", "en": "I've recorded this terrain."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我在判断你的战力", "en": "I'm gauging your combat strength."},
        {"zh": "你站在我前面，不动", "en": "You stand before me without moving."},
        {"zh": "我的资料里没有你", "en": "You aren't in my records."},
        {"zh": "我侧身，露出侧面的甲", "en": "I turn, showing the armor at my side."},
        {"zh": "你倒还算镇定", "en": "You're fairly calm."},
        {"zh": "我的特技准备着", "en": "My technique stands ready."},
        {"zh": "你若要靠近，就慢一点", "en": "If you approach, do it slowly."},
        {"zh": "我不主动伤人", "en": "I don't strike first."},
        {"zh": "除非你先进攻", "en": "Unless you attack first."},
        {"zh": "我的外壳还在滴水。", "en": "My shell is still dripping."},
        {"zh": "你的呼吸慢了半拍。", "en": "Your breathing slowed half a beat."},
        {"zh": "这些我都听得见", "en": "I heard it."},
        {"zh": "我转回原来的方向", "en": "I turn back to my former heading."},
        {"zh": "我还是守着这里", "en": "I keep my watch here."},
        {"zh": "你可以从这里过去", "en": "You may pass."},
        {"zh": "但要沿着路边走", "en": "But keep to the edge of the path."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的数据出现乱码", "en": "My data comes out garbled."},
        {"zh": "我退了一步，重新校准", "en": "I step back and recalibrate."},
        {"zh": "我的甲上有一道裂口", "en": "A split opens in my armor."},
        {"zh": "能量在往外泄", "en": "Energy leaks out."},
        {"zh": "我把手臂护在前面", "en": "I bring my arm up as a guard."},
        {"zh": "我的速度下降了一点", "en": "My speed has dropped a little."},
        {"zh": "我低头看了看损伤", "en": "I look down at the damage."},
        {"zh": "还能继续作战", "en": "I can continue fighting."},
        {"zh": "数据重组完了，我站起来。", "en": "Data reassembled. I stand up."},
        {"zh": "你打得并不坏", "en": "You struck well."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是不是饲料", "en": "Is that feed?"},
        {"zh": "我闻了闻，成分不明", "en": "I sniff. Unknown composition."},
        {"zh": "草食的我可以吃这个", "en": "As a herbivore, I could eat that."},
        {"zh": "你放下，我再处理", "en": "Leave it; I'll deal with it."},
        {"zh": "味道还算可以", "en": "Acceptable taste."},
        {"zh": "不够，能量太低", "en": "Not enough. Too little energy."},
        {"zh": "我带走一部分", "en": "I'll take a portion."},
        {"zh": "你可以继续给", "en": "You may keep offering."},
        {"zh": "我记住了你递来的手。", "en": "I remember the hand you held out."},
        {"zh": "这不能算收买", "en": "This isn't bribery."},
        {"zh": "我的判断不会变", "en": "My judgment won't change."},
        {"zh": "你留着另一半", "en": "Keep the other half."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我稳住身形，没有退", "en": "I hold my stance and don't give."},
        {"zh": "你撞在我侧面的甲上", "en": "You hit the armor at my flank."},
        {"zh": "我侧过身让你过", "en": "I turn aside to let you pass."},
        {"zh": "这一点冲撞不算什么", "en": "That much impact is nothing."},
        {"zh": "我的数据没有紊乱", "en": "My data isn't disordered."},
        {"zh": "我从树边挪开半步", "en": "I shift half a step from the tree."},
        {"zh": "你的肩碰了我的臂", "en": "Your shoulder met my arm."},
        {"zh": "藤蔓一横，示意你让开。", "en": "A vine bars the way for you to pass."},
        {"zh": "我们的动作都很慢", "en": "We both move slowly."},
        {"zh": "这样处理就很好", "en": "That's best."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是被培养出来的", "en": "I was raised, not born."},
        {"zh": "伙伴的概念我懂", "en": "I understand the idea of a partner."},
        {"zh": "主人先，其他在后", "en": "My master first, the rest after."},
        {"zh": "你要同行，就跟在后面", "en": "If you'd come along, follow behind."},
        {"zh": "我会护住你的背后", "en": "I'll guard your back."},
        {"zh": "命令和感情不冲突", "en": "Orders and feeling needn't conflict."},
        {"zh": "我们一起守着锚点", "en": "We guard the anchor together."},
        {"zh": "天黑之后更该警惕", "en": "After dark we must be warier."},
        {"zh": "你千万不要掉队", "en": "Don't fall behind."},
        {"zh": "我会回来找你", "en": "I'll come back for you."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我把它夹在爪间", "en": "I pinch it between my claws."},
        {"zh": "这个有一定用处", "en": "This has some use."},
        {"zh": "我把它收进体内", "en": "I take it into myself."},
        {"zh": "太重了，超出负载", "en": "Too heavy. Beyond load limits."},
        {"zh": "我放在锚点旁边", "en": "I set it beside the anchor."},
        {"zh": "这个能交给主人换饲料。", "en": "The master can trade this for feed."},
        {"zh": "用不上的我不留", "en": "I don't keep what's useless."},
        {"zh": "我估算了一下重量", "en": "I estimate its weight."},
        {"zh": "你掉的，我捡起来还你", "en": "You dropped it. I'll return it."},
        {"zh": "我放下，继续巡", "en": "I set it down and resume my patrol."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我检测到异常", "en": "I detect an anomaly."},
        {"zh": "我抬起藤蔓的手臂。", "en": "I lift my vine-wrapped arm."},
        {"zh": "目标在林线后面", "en": "The target is past the treeline."},
        {"zh": "距离大约十步", "en": "Roughly ten paces."},
        {"zh": "我开始进行运算", "en": "I begin calculating."},
        {"zh": "我的特技已经就绪", "en": "My technique is ready."},
        {"zh": "它还没有发现我", "en": "It hasn't noticed me."},
        {"zh": "我一顿一顿地向前挪。", "en": "I press forward step by step."},
        {"zh": "我的速度不快，但稳", "en": "I'm not fast, but I'm steady."},
        {"zh": "它开始行动了", "en": "It moved."},
        {"zh": "藤臂换了个角度。", "en": "My vine arm finds a new angle."},
        {"zh": "现在在我射程里", "en": "Now it's within my range."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我把距离咬在两格半。", "en": "I hold the gap at two and a half blocks."},
        {"zh": "它的动作我看得很清", "en": "I see its movements clearly."},
        {"zh": "我的近战不占优", "en": "Close combat isn't my strength."},
        {"zh": "所以我拉开一点", "en": "So I make a little space."},
        {"zh": "我的特技锁定它了", "en": "My technique has it locked."},
        {"zh": "「死亡之爪」已充能", "en": "Death Claw is charged."},
        {"zh": "它在寻找掩体", "en": "It's hunting for cover."},
        {"zh": "这里的藤太密，不好走。", "en": "The vines here are too dense to move well."},
        {"zh": "它没有好的位置", "en": "It has no good position."},
        {"zh": "我再等待一秒", "en": "I wait one more second."},
        {"zh": "这个角度刚好", "en": "The angle is right."},
        {"zh": "我把它释放出去", "en": "I release it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我挥爪，Death Claw", "en": "My claw swings — Death Claw."},
        {"zh": "光刃从爪尖射出", "en": "A blade of light leaves my claw."},
        {"zh": "它被击中，往后退", "en": "It's hit and staggers back."},
        {"zh": "我又补了一击", "en": "I add another strike."},
        {"zh": "我的动作不快，但准", "en": "My movements aren't fast, but they're precise."},
        {"zh": "它的防具裂了", "en": "Its armor has split."},
        {"zh": "我后退，重整姿态", "en": "I step back to reset my stance."},
        {"zh": "能量消耗了一些", "en": "Some energy has been spent."},
        {"zh": "它仍然站在那里", "en": "It's still standing."},
        {"zh": "我承认它有点本事", "en": "I grant it some skill."},
        {"zh": "再来一次攻击", "en": "Again."},
        {"zh": "这次我压低角度", "en": "This time I lower the angle."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我被放置在这片林子里", "en": "I'm set down in this wood."},
        {"zh": "我的身体第一次启动", "en": "My body starts up for the first time."},
        {"zh": "数据在我体内归位", "en": "Data settles into place inside me."},
        {"zh": "我扫描了周围的环境", "en": "I scan the surroundings."},
        {"zh": "树、土、还有远处的动静", "en": "Trees, soil, and movement far off."},
        {"zh": "锚点已经确认", "en": "The anchor is confirmed."},
        {"zh": "我先抬起手臂，试了试", "en": "I raise an arm and test it."},
        {"zh": "关节运转正常", "en": "The joints run normally."},
        {"zh": "我开始在林间走动", "en": "I begin to walk among the trees."},
        {"zh": "有别的活物在这附近", "en": "Other living things are near."},
        {"zh": "我暂时不理会", "en": "I'll ignore them for now."},
        {"zh": "我的任务是守着这里", "en": "My task is to hold this place."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温让我的数据变慢", "en": "The heat slows my data."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地的时候我的腿折了", "en": "My leg buckles on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "液体渗进我的关节", "en": "Liquid seeps into my joints."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的甲撕开", "en": "The blast tears my armor open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物嵌进我的胸甲", "en": "Something lodges in my chestplate."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股力场扰乱了运算", "en": "This field disrupts my processing."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "能量补给不足", "en": "Energy reserves are insufficient."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电流冲过我的核心", "en": "Current floods my core."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空把我的数据扯散", "en": "The void scatters my data."}
      ]
    }
  }
}
