{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "金属的关节一下下咬合", "en": "Metal joints lock with each step."},
        {"zh": "我的身子是包起来的铁", "en": "My body is wrapped in iron."},
        {"zh": "走起来有很轻的回声", "en": "Each step rings faintly."},
        {"zh": "我穿过针叶林的暗处", "en": "I cross the dark of the pines."},
        {"zh": "树枝从我肩上滑过去", "en": "Branches slide off my shoulder."},
        {"zh": "我用手臂把它们拨开", "en": "I push them aside with an arm."},
        {"zh": "关节里有细细的响声", "en": "A fine whine inside the joint."},
        {"zh": "我的齿轮咬合着往前。", "en": "My gears mesh and carry me forward."},
        {"zh": "那是我自己的声音", "en": "It's my own sound."},
        {"zh": "然后继续巡下去", "en": "Then resume the patrol."},
        {"zh": "脚下的雪被压实", "en": "Snow packs under me."},
        {"zh": "留下了深深的印", "en": "Deep prints left behind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，像一件立起来的甲", "en": "I stand like a set of armor propped up."},
        {"zh": "手臂垂在身侧", "en": "Arms hang at my sides."},
        {"zh": "关节里有热气散出来", "en": "Heat bleeds from my joints."},
        {"zh": "周围的雪化了一圈", "en": "Snow melts in a ring."},
        {"zh": "我把头缓缓转向", "en": "I swivel my head slowly."},
        {"zh": "视野里全是树", "en": "Trees fill my view."},
        {"zh": "我扫视了一遍", "en": "I sweep it once."},
        {"zh": "确认没有东西", "en": "Confirming nothing's there."},
        {"zh": "之后又转回来", "en": "Then rotates back."},
        {"zh": "再扫视了一遍", "en": "And sweep again."},
        {"zh": "这是我被造出来的方式", "en": "That's how I was built."},
        {"zh": "一直看，一直等", "en": "Watch, and wait."},
        {"zh": "等到有东西动", "en": "Until something moves."},
        {"zh": "我把手指一根根活动", "en": "I flex each finger in turn."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我转过头，关节响了", "en": "I turn my head. A joint clicks."},
        {"zh": "我把你从头看到脚", "en": "I look you over entirely."},
        {"zh": "这是我扫描的方式", "en": "That's how I scan."},
        {"zh": "你的甲比我薄", "en": "Your armor's thinner than mine."},
        {"zh": "我的关节对着你的手。", "en": "My joints are pointed at your hands."},
        {"zh": "我把铁手臂举到胸前。", "en": "I raise my iron arm to my chest."},
        {"zh": "金属摩擦的声音很长", "en": "Metal grinds, long and slow."},
        {"zh": "手停在半空，先看清楚。", "en": "Hand paused mid-air, let me look first."},
        {"zh": "随即又放下了", "en": "Then lower it."},
        {"zh": "这一次不判你敌意", "en": "I don't read you as hostile this time."},
        {"zh": "但你最好别动", "en": "But you'd better hold still."},
        {"zh": "我不喜欢意外", "en": "I dislike surprises."},
        {"zh": "你的呼吸很浅", "en": "Your breathing is shallow."},
        {"zh": "你已经在准备跑", "en": "You're getting ready to run."},
        {"zh": "那说明你还有判断", "en": "So you can still judge."},
        {"zh": "我这才停住手", "en": "I stop."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "金属发出一声长响", "en": "Metal gives a long groan."},
        {"zh": "我后撤了小半步", "en": "I pull back half a step."},
        {"zh": "外壳上凹了一块", "en": "A dent in my shell."},
        {"zh": "铁皮的关节，卡一声就好。", "en": "An iron joint—one clank and it is fine."},
        {"zh": "然后重新转动", "en": "Then turns again."},
        {"zh": "我在做自我检查", "en": "I'm running a self-check."},
        {"zh": "关节都还能动", "en": "Still functional."},
        {"zh": "可以继续运转", "en": "Able to continue."},
        {"zh": "我把手臂重新举起来", "en": "I raise my arm again."},
        {"zh": "我重新做判定", "en": "Re-evaluating."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是金属做吗", "en": "Is that metal?"},
        {"zh": "我把机械手伸出", "en": "I extend my metal hand."},
        {"zh": "手指停在上面", "en": "My fingers stop on it."},
        {"zh": "不是我要的那种", "en": "Not the kind I need."},
        {"zh": "但我还是收下了", "en": "Still, I take it."},
        {"zh": "放进关节缝里", "en": "Into a gap in my joint."},
        {"zh": "关节转得更顺了", "en": "The joint moves more smoothly."},
        {"zh": "这玩意儿很有用", "en": "That's useful."},
        {"zh": "这点数据，不够我塞牙。", "en": "That much data won't fill a tooth gap."},
        {"zh": "我在此处候着", "en": "I wait right here."},
        {"zh": "世界斩，也是铁做的。", "en": "World Slash, forged in iron."},
        {"zh": "内侧也还是金属", "en": "Metal inside too."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我几乎没有动，刀已经收回。", "en": "I barely moved; the blade is sheathed."},
        {"zh": "你被一下子弹开", "en": "You bounce off."},
        {"zh": "我的外壳比看起来更沉", "en": "My shell is heavier than it looks."},
        {"zh": "你退了几步才停", "en": "You stumble several steps."},
        {"zh": "我低下头看你，金属关节一下下咬合。", "en": "I lower my head, metal joints clicking."},
        {"zh": "这一下没造成损伤", "en": "No damage caused."},
        {"zh": "你撞得我齿轮空转。", "en": "You knocked my gears into free spin."},
        {"zh": "算是让了一点", "en": "A concession."},
        {"zh": "你就走这一边", "en": "You take this side."},
        {"zh": "我走那一边去", "en": "I'll take that."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上还留着焊痕。", "en": "Weld marks still show on me."},
        {"zh": "造我的人没有留下说明", "en": "My maker left no instructions."},
        {"zh": "我不知道这一项该怎么处理", "en": "I don't know how to handle that category."},
        {"zh": "所以我跳过了", "en": "So I skip it."},
        {"zh": "我只听见自己的机簧声。", "en": "I hear only my own springs."},
        {"zh": "黑森林的湿气，把我的铁关节磨响。", "en": "Dark-forest damp grinds my iron joints."},
        {"zh": "关节里已经积了灰", "en": "Dust has gathered in my joints."},
        {"zh": "我清理了一下", "en": "I clean them out."},
        {"zh": "还能再用很久", "en": "They'll last a while yet."},
        {"zh": "那我就接着守", "en": "Keep watching."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰，关节一路响", "en": "I bend, joints clicking all the way."},
        {"zh": "手指一下夹住", "en": "My fingers close on it."},
        {"zh": "举到眼前去看", "en": "Lifted to my eyes."},
        {"zh": "仔细辨认一下", "en": "I identify it."},
        {"zh": "不在我的用途清单里", "en": "Not on my list of uses."},
        {"zh": "可我还是带着", "en": "But I keep it."},
        {"zh": "收进腰侧的格子", "en": "Into the compartment at my side."},
        {"zh": "然后把盖盖好", "en": "Seal it."},
        {"zh": "回到巡逻路线", "en": "Back to the patrol line."},
        {"zh": "重量可以接受", "en": "Weight acceptable."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "前方检测到移动", "en": "Movement detected."},
        {"zh": "我把头转得咔咔响。", "en": "I turn my head with a clatter."},
        {"zh": "手臂慢慢抬起", "en": "Arm up."},
        {"zh": "关节全部锁死", "en": "Joints lock."},
        {"zh": "刃从手臂里滑出来", "en": "A blade slides from my arm."},
        {"zh": "雪被照得很白", "en": "Snow goes white with the glare."},
        {"zh": "我朝你踏进一步", "en": "I step toward you."},
        {"zh": "雪被我踩得吱响", "en": "Snow squeals under me."},
        {"zh": "只剩两步距离", "en": "Two steps left."},
        {"zh": "我把刃举高了", "en": "I raise the blade."},
        {"zh": "这是最后判定", "en": "Final judgment."},
        {"zh": "停步，不要动", "en": "Halt. Don't move."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在算距离", "en": "I'm calculating range."},
        {"zh": "你的脚每动一次我都记下", "en": "Every shift of your feet, recorded."},
        {"zh": "关节里有细微的调整声", "en": "Fine adjustments whine in my joints."},
        {"zh": "我换了三个角度", "en": "I try three angles."},
        {"zh": "第一个角度太远", "en": "The first is too far."},
        {"zh": "第二个有树挡着", "en": "The second has trees."},
        {"zh": "这个是第三个", "en": "This is the third."},
        {"zh": "这个角度正好，我开始蓄力。", "en": "This angle is right; I start charging."},
        {"zh": "我开始蓄起力", "en": "I begin to charge."},
        {"zh": "金属表面发热", "en": "My surface warms."},
        {"zh": "雪在脚边化成水", "en": "Snow melts to water at my feet."},
        {"zh": "你听见了嗡嗡声", "en": "You hear the hum."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "刃从肩上劈下", "en": "The blade comes down from my shoulder."},
        {"zh": "在地上留下一道深沟", "en": "It leaves a deep furrow in the ground."},
        {"zh": "你侧身避开了", "en": "You twist aside."},
        {"zh": "手臂横扫过来", "en": "My arm sweeps across."},
        {"zh": "金属撞在护甲上", "en": "Metal meets armor."},
        {"zh": "声音很远都能听见", "en": "The sound carries far."},
        {"zh": "你被推出两步", "en": "You're shoved back two steps."},
        {"zh": "我的关节顶住了", "en": "My joint holds."},
        {"zh": "没有出现过载", "en": "No overload."},
        {"zh": "我这副铁壳，砍起来很响。", "en": "This iron shell of mine rings when struck."},
        {"zh": "这次角度更平", "en": "Flatter angle this time."},
        {"zh": "我的拳头弹出得很快。", "en": "My fist snaps out fast."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雪地上有一块没被雪盖住", "en": "One patch of snow lies bare."},
        {"zh": "因为那块是热的", "en": "Because it's warm."},
        {"zh": "我就站在那里", "en": "I stand there."},
        {"zh": "关节里还有一点余温", "en": "Some heat remains in my joints."},
        {"zh": "这里是针叶林", "en": "This is pine forest."},
        {"zh": "黑，而且安静", "en": "Dark, and quiet."},
        {"zh": "此处非常合适", "en": "This position is ideal."},
        {"zh": "我转了半圈扫视", "en": "I sweep a half turn."},
        {"zh": "确认周围的情况", "en": "Checking the surroundings."},
        {"zh": "于是开始巡逻", "en": "Beginning patrol."},
        {"zh": "我把手臂转到前面", "en": "I bring my arm forward."},
        {"zh": "确认它还能动", "en": "Confirming it moves."}
      ]
    },
