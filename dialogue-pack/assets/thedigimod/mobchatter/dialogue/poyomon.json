{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽一弹一弹地走", "en": "Poyomon moves in little bounces."},
        {"zh": "它的身体软得像一团胶", "en": "Its body is soft as a blob of gel."},
        {"zh": "每走一步就晃一下", "en": "It wobbles with each step."},
        {"zh": "它绕着锚点挪动", "en": "It shifts around its anchor."},
        {"zh": "它的小尾巴拖着扫草", "en": "Its small tail sweeps the grass."},
        {"zh": "它从一片叶子下面钻过", "en": "It slips under a leaf."},
        {"zh": "它停在石子旁边看", "en": "It stops by a pebble to look."},
        {"zh": "它一脚踩上去，滑了一下", "en": "It steps on it and slips."},
        {"zh": "然后它绕开继续走", "en": "Then it goes around and on."},
        {"zh": "它的动作慢，却不犹豫", "en": "Slow, but never hesitant."},
        {"zh": "它朝你的方向挪来", "en": "It moves in your direction."},
        {"zh": "走到一半它停了一下", "en": "Halfway there it pauses."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽蹲着，一晃一晃", "en": "Poyomon sits, rocking gently."},
        {"zh": "它的眼睛圆圆的", "en": "Its eyes are perfectly round."},
        {"zh": "它的身体表面有一点光", "en": "A faint sheen covers its body."},
        {"zh": "它把身体压扁了一点", "en": "It squashes itself flatter."},
        {"zh": "然后又弹回原样", "en": "Then pops back to shape."},
        {"zh": "它伸出一只小爪子", "en": "It extends a small paw."},
        {"zh": "它把圆眼慢慢合上", "en": "It slowly shuts its round eyes."},
        {"zh": "它把尾巴卷到身前", "en": "It curls its tail in front."},
        {"zh": "它发出很轻的一声", "en": "It makes a very soft sound."},
        {"zh": "它的呼吸让身体一起一伏", "en": "Its breathing makes it swell and settle."},
        {"zh": "它侧过去听地面", "en": "It leans down to listen to the ground."},
        {"zh": "它的头歪得很低", "en": "Its head tips very low."},
        {"zh": "它又慢慢坐直", "en": "Then it slowly sits up."},
        {"zh": "它看起来随时会睡着", "en": "It looks ready to doze off."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽抬头看你", "en": "Poyomon looks up at you."},
        {"zh": "它的眼睛比身体还显眼", "en": "Its eyes are bigger than you expect."},
        {"zh": "它把脑袋歪了一歪", "en": "It tips its little head."},
        {"zh": "它朝你挪了一小步", "en": "It shuffles one small step."},
        {"zh": "它伸出爪子碰你的鞋", "en": "It puts a paw on your shoe."},
        {"zh": "它一点也不害怕", "en": "It is not frightened in the least."},
        {"zh": "它绕着你转了一小圈", "en": "It makes a little circuit around you."},
        {"zh": "它抬头，等你弯腰", "en": "It looks up, waiting for you to bend down."},
        {"zh": "它发出一声软软的叫", "en": "It lets out a soft little sound."},
        {"zh": "它在你脚边坐下了", "en": "It sits down at your feet."},
        {"zh": "它把身体靠在你鞋上", "en": "It leans against your shoe."},
        {"zh": "它闭上眼睛，很放松", "en": "It shuts its eyes, entirely at ease."},
        {"zh": "过一会它又睁开", "en": "After a while it opens them again."},
        {"zh": "它抬头看你在做什么", "en": "It looks up to see what you are doing."},
        {"zh": "它慢慢挪到你侧面", "en": "It shifts slowly to your side."},
        {"zh": "它大概把你当成了主人", "en": "It probably takes you for its owner."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽叫了一声，缩起来", "en": "Poyomon cries out and shrinks."},
        {"zh": "它滚了半圈才停", "en": "It rolls half over before stopping."},
        {"zh": "它把身体缩得更小", "en": "It shrinks itself smaller."},
        {"zh": "它倒退了两小步", "en": "It shuffles back two small steps."},
        {"zh": "它抬头看你，没有跑", "en": "It looks up, and does not run."},
        {"zh": "它的身体有点瘪", "en": "Its body sags a little."},
        {"zh": "它慢慢站起来", "en": "It slowly gets up."},
        {"zh": "它挪到你脚边", "en": "It moves to your feet."},
        {"zh": "它又轻轻叫了一下", "en": "It gives a soft call."},
        {"zh": "它还是信任你", "en": "It still trusts you."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽朝你手上的东西挪来", "en": "Poyomon shuffles toward what you hold."},
        {"zh": "它伸长脖子闻了闻", "en": "It stretches up to sniff."},
        {"zh": "它小口地吃起来", "en": "It eats in tiny bites."},
        {"zh": "它对不合口的东西扭头", "en": "It turns away from what it dislikes."},
        {"zh": "它吃完抬头再要", "en": "Done, it looks up for more."},
        {"zh": "它蹭了蹭你的手指", "en": "It nuzzles your finger."},
        {"zh": "它在你手边坐下等", "en": "It sits by your hand and waits."},
        {"zh": "它吃得脸上都是", "en": "It gets food all over its face."},
        {"zh": "它把爪子放进嘴里舔", "en": "It puts a paw in its mouth to lick."},
        {"zh": "它满意地晃了晃身体", "en": "It wobbles with satisfaction."},
        {"zh": "它把最后一点也吃掉", "en": "It finishes the last of it."},
        {"zh": "它抬头，眼睛亮亮的", "en": "It looks up, eyes bright."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽被碰得滚了一圈", "en": "Poyomon rolls at the bump."},
        {"zh": "它停下时还晃着", "en": "It keeps wobbling when it stops."},
        {"zh": "它慢慢把自己理正", "en": "It slowly settles upright."},
        {"zh": "它绕开你，继续走", "en": "It goes around you and walks on."},
        {"zh": "它的小爪子踩在你鞋上", "en": "A small paw lands on your shoe."},
        {"zh": "它被推开也不生气", "en": "Being pushed away does not upset it."},
        {"zh": "它又慢慢挪回来", "en": "It shuffles back again."},
        {"zh": "它抖了抖身体", "en": "It shakes its body out."},
        {"zh": "它抬头确认是你", "en": "It looks up to check it is you."},
        {"zh": "然后靠得更近", "en": "Then leans in closer."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "两只波悠兽靠在一起", "en": "Two poyomon press together."},
        {"zh": "它们的身体挤成一团", "en": "Their bodies squash into one lump."},
        {"zh": "它们的眼睛一起眨", "en": "They blink together."},
        {"zh": "它们的尾巴互相碰", "en": "Their tails touch."},
        {"zh": "然后它们一起弹了一下", "en": "Then they bounce as one."},
        {"zh": "它们绕着小圈转", "en": "They turn in small circles."},
        {"zh": "它们的叫声一前一后", "en": "Their calls come one after the other."},
        {"zh": "它们累了就趴下", "en": "When tired they lie down."},
        {"zh": "两个小身体堆在一起", "en": "Two small bodies heap together."},
        {"zh": "很快就都睡着了", "en": "Soon both are asleep."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽用爪子按住食物", "en": "Poyomon pins the food with a paw."},
        {"zh": "它小口小口地啃", "en": "It nibbles in small bites."},
        {"zh": "它把东西抱在怀里", "en": "It hugs the item to itself."},
        {"zh": "它对不合口的推开", "en": "What it dislikes, it pushes away."},
        {"zh": "它把食物藏在叶下", "en": "It hides the food under a leaf."},
        {"zh": "它拖着东西走两步", "en": "It drags the thing two steps."},
        {"zh": "然后坐下慢慢吃", "en": "Then sits and eats slowly."},
        {"zh": "它吃完舔了舔爪子", "en": "Afterward it licks its paw."},
        {"zh": "它抬头看你一眼", "en": "It glances up at you."},
        {"zh": "又低头找碎屑", "en": "Then down for crumbs."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽忽然站住", "en": "Poyomon stops where it is."},
        {"zh": "它的身体绷紧了一点", "en": "Its body tightens slightly."},
        {"zh": "它朝你的方向倾", "en": "It leans toward you."},
        {"zh": "它发出一声短促的叫", "en": "It gives a short call."},
        {"zh": "它开始朝你挪", "en": "It starts shuffling toward you."},
        {"zh": "它绕到你的脚边", "en": "It comes around to your feet."},
        {"zh": "它伸出爪子扒你的鞋", "en": "A paw scrabbles at your shoe."},
        {"zh": "它好像想要什么", "en": "It seems to want something."},
        {"zh": "它仰着脸催你快走", "en": "It tips its face up, urging you on."},
        {"zh": "它挡在你前面不走", "en": "It stands in front of you and will not go."},
        {"zh": "它叫得比刚才急", "en": "Its calls grow more urgent."},
        {"zh": "它整个贴在你小腿上", "en": "It presses its whole body to your calf."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽一直跟在你脚边", "en": "Poyomon stays at your feet."},
        {"zh": "你走一步它挪一步", "en": "You step, and it shuffles."},
        {"zh": "它抬头看你有没有停", "en": "It looks up to see if you stopped."},
        {"zh": "它绕到你前面挡路", "en": "It circles in front to block you."},
        {"zh": "它扒着你的裤脚", "en": "It tugs at your trouser leg."},
        {"zh": "它往某个方向扭头", "en": "It turns its head toward something."},
        {"zh": "它想让你跟它走", "en": "It wants you to follow."},
        {"zh": "它跑两步，回头看", "en": "It moves two steps and looks back."},
        {"zh": "它又叫了一声", "en": "It calls again."},
        {"zh": "它停下来等你", "en": "It stops and waits for you."},
        {"zh": "它已经在原地转圈", "en": "It is circling in place."},
        {"zh": "它似乎有点着急", "en": "It seems a little anxious."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "波悠兽一头撞在你鞋上", "en": "Poyomon butts your shoe."},
        {"zh": "它的爪子扒你的脚踝", "en": "Its paws scrabble at your ankle."},
        {"zh": "它跳起来撞你的小腿", "en": "It hops and bumps your shin."},
        {"zh": "它咬住你的裤脚扯", "en": "It bites your trouser leg and pulls."},
        {"zh": "它的力气小得可怜", "en": "Its strength is pitifully small."},
        {"zh": "它弹开，又冲回来", "en": "It bounces off and comes back."},
        {"zh": "它叫了一声，更急了", "en": "It calls, more urgently."},
        {"zh": "它绕着你乱转", "en": "It circles you in a fluster."},
        {"zh": "它撞空后滚了一圈", "en": "It misses and rolls over."},
        {"zh": "它一爬起又往前顶", "en": "It gets up and butts forward again."},
        {"zh": "它咬住不放，很固执", "en": "It clamps on, stubborn."},
        {"zh": "它被你推开又叫起来", "en": "Pushed away, it calls again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "地上鼓起一个小包", "en": "A little mound rises on the ground."},
        {"zh": "波悠兽从里面钻出来", "en": "Poyomon pushes out of it."},
        {"zh": "它抖掉身上的土", "en": "It shakes the dirt off."},
        {"zh": "它的身体一下弹圆了", "en": "Its body rounds out."},
        {"zh": "它抬头看了一圈", "en": "It looks around."},
        {"zh": "然后朝你这边来", "en": "Then comes toward you."},
        {"zh": "它走得很慢，却很坚持", "en": "Slow, and determined."},
        {"zh": "它在你脚边停住", "en": "It stops at your feet."},
        {"zh": "它在你脚边坐了下来", "en": "It sits down at your feet."},
        {"zh": "它把身体立得直了点", "en": "It pulls itself a bit more upright."},
        {"zh": "它冲你叫了一声", "en": "It calls out to you."},
        {"zh": "像在认一个熟人", "en": "As if greeting someone it knows."}
      ]
    },
