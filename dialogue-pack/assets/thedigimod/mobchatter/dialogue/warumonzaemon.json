{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我每一步都压得地响。", "en": "Every step I take makes the ground creak."},
        {"zh": "大熊的身子，走起来慢。", "en": "A big bear's body moves slowly."},
        {"zh": "我爪子垂着，拖着地。", "en": "My claws hang, dragging."},
        {"zh": "我的毛，暗得发黑。", "en": "My fur is dark, nearly black."},
        {"zh": "我在林子里踱步。", "en": "I pace in the wood."},
        {"zh": "落叶被我踩得粉碎。", "en": "Leaves crumble under me."},
        {"zh": "脚步压断枯枝，我朝那边去。", "en": "My steps snap dry branches; I head that way."},
        {"zh": "我不急，猎物会等。", "en": "No rush; prey waits."},
        {"zh": "我身上的缝线，硌得慌。", "en": "These stitched seams chafe."},
        {"zh": "我一路走，一路哼哼。", "en": "I hum as I walk."},
        {"zh": "树挡着我，我就推开。", "en": "Trees in my way get pushed aside."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在树下，不动。", "en": "I squat under a tree, still."},
        {"zh": "爪子在土里刨。", "en": "My claws rake the soil."},
        {"zh": "身上的绒毛，一撮撮。", "en": "Tufts of fur on my body."},
        {"zh": "我在舔爪子。", "en": "I lick my claws."},
        {"zh": "太阳照不到这里。", "en": "The sun doesn't reach here."},
        {"zh": "我看了看来路。", "en": "I glance back the way I came."},
        {"zh": "林子里，没有别的声音。", "en": "No other sound in the wood."},
        {"zh": "我哼了一小段。", "en": "I hum a short tune."},
        {"zh": "我的眼睛，在暗处发亮。", "en": "My eyes shine in the dark."},
        {"zh": "笨重的脑袋转了过来。", "en": "My heavy head swings round."},
        {"zh": "这一片，归我。", "en": "This patch is mine."},
        {"zh": "我把背靠在树上。", "en": "I lean my back on a tree."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你离我这身毛太近了。", "en": "You're too close to this fur."},
        {"zh": "我的笑，是缝上去的。", "en": "This smile is stitched on."},
        {"zh": "你往后让开了。", "en": "You've given ground."},
        {"zh": "我这身毛，不好摸。", "en": "This fur isn't nice to touch."},
        {"zh": "我看得出你害怕。", "en": "I can see you're afraid."},
        {"zh": "这林子，是我的。", "en": "This wood is mine."},
        {"zh": "我迈着熊步走近你。", "en": "I close in on bear paws."},
        {"zh": "我哼着歌呢。", "en": "I'm humming a song."},
        {"zh": "你别打断我。", "en": "Don't interrupt me."},
        {"zh": "你笑起来，也很难看。", "en": "Your smile isn't better than mine."},
        {"zh": "我记下你的脸。", "en": "I've noted your face."},
        {"zh": "就在这儿待着。", "en": "Stay right here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "缝线崩开了一处。", "en": "A seam split open."},
        {"zh": "我这庞然的身子退半步。", "en": "My bulk draws back half a step."},
        {"zh": "这点伤，我不在乎。", "en": "This wound means nothing."},
        {"zh": "我身上的毛掉了一撮。", "en": "A tuft of fur came out."},
        {"zh": "喉咙里滚出一声低吟。", "en": "A low hum rolls from my throat."},
        {"zh": "我把背重新挺直。", "en": "I straighten my back again."},
        {"zh": "这双腿还走得动。", "en": "These legs can still walk."},
        {"zh": "你打得不重。", "en": "That wasn't heavy."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西，给我。", "en": "Give that to me."},
        {"zh": "甜味冲得我鼻子发痒。", "en": "The sweetness tickles my nose."},
        {"zh": "你举着它，我够得到。", "en": "I can reach that."},
        {"zh": "这点，不够我一口。", "en": "Not a mouthful."},
        {"zh": "别让手里的抖。", "en": "Keep your hand from shaking."},
        {"zh": "我挪着笨步过去。", "en": "I lumber over."},
        {"zh": "搁下就退远些。", "en": "Set it down and move off."},
        {"zh": "我要的，不只是吃的。", "en": "It's not only food I want."},
        {"zh": "你往后挪一挪。", "en": "Shift back a little."},
        {"zh": "甜的东西，我喜欢。", "en": "I like sweet things."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我唱的歌让人心里发凉。", "en": "The song I sing chills you through."},
        {"zh": "我脚下半步没动。", "en": "I didn't shift half a step."},
        {"zh": "你被这身肉弹回去。", "en": "That bulk bounces you off."},
        {"zh": "这点碰，我不在乎。", "en": "That touch means nothing."},
        {"zh": "我抬起手，让你退。", "en": "I raise a hand to push you back."},
        {"zh": "地上的土，被我压平。", "en": "The soil flattens under me."},
        {"zh": "别贴着我的缝线。", "en": "Don't press against my seams."},
        {"zh": "我让了一点。", "en": "I gave a little."},
        {"zh": "再来一次也行。", "en": "I could do it again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这具身体，是缝出来的。", "en": "This body was stitched together."},
        {"zh": "这种东西我用不着。", "en": "I've no use for such a thing."},
        {"zh": "同类？在林子里见过一只。", "en": "Kin? I saw one in the wood once."},
        {"zh": "我们互相看了看，就走了。", "en": "We looked at each other and left."},
        {"zh": "我只想要安静。", "en": "I only want quiet."},
        {"zh": "这道缝线附近别站人。", "en": "Keep clear of these seams."},
        {"zh": "我哼着歌，转过身。", "en": "I hum and turn away."},
        {"zh": "别再跟过来。", "en": "Don't follow after me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一把攥进掌心。", "en": "I close it in my fist."},
        {"zh": "这东西没几两。", "en": "This hardly weighs anything."},
        {"zh": "掉地上，我一脚踩了。", "en": "It fell; I stepped on it."},
        {"zh": "我拎着看看。", "en": "I hold it up to look."},
        {"zh": "这玩意儿没价值。", "en": "This thing has no value."},
        {"zh": "我收进毛里。", "en": "I tuck it into my fur."},
        {"zh": "这东西硬得硌手。", "en": "It's hard enough to bruise my palm."},
        {"zh": "我留着慢慢玩。", "en": "I'll keep it to play with."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看清楚你了。", "en": "I've had a good look at you."},
        {"zh": "我的爪子举起。", "en": "My claw comes up."},
        {"zh": "这一带有我的味。", "en": "This area smells of me."},
        {"zh": "我记下你的位置。", "en": "I've noted your position."},
        {"zh": "我哼歌的时候，最危险。", "en": "I'm most dangerous when humming."},
        {"zh": "我挪着步子逼近。", "en": "I shuffle in closer."},
        {"zh": "别挪动脚步。", "en": "Don't shift your feet."},
        {"zh": "跑是白费力气。", "en": "Running is wasted effort."},
        {"zh": "林子没出口。", "en": "No way out of this wood."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里的脚步越来越近。", "en": "Footsteps in the wood draw closer."},
        {"zh": "你每一步，我都听着。", "en": "I hear every step you take."},
        {"zh": "这些树，挡不住我。", "en": "These trees don't stop me."},
        {"zh": "我的爪子，能撕开树干。", "en": "My claws can tear bark."},
        {"zh": "我有的是耐心耗。", "en": "I have patience to spare."},
        {"zh": "我身上的缝线绷紧了。", "en": "My seams pull tight."},
        {"zh": "我的歌，还没停。", "en": "My song hasn't stopped."},
        {"zh": "腐叶吸住你的脚。", "en": "Rotten leaves cling to your feet."},
        {"zh": "再挨近几步路。", "en": "A few steps nearer."},
        {"zh": "你身后只剩树。", "en": "There's only tree behind you."},
        {"zh": "缝上去的嘴角扯了一下。", "en": "The stitched mouth tugs sideways."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一爪拍下去！", "en": "My claw slams down!"},
        {"zh": "爱之歌，听好。", "en": "Love Song — hear it."},
        {"zh": "这一下，树干都裂。", "en": "That split the tree trunk."},
        {"zh": "我扣住你的肩头。", "en": "I clamp your shoulder."},
        {"zh": "这一下你架不住。", "en": "You can't hold this one."},
        {"zh": "我的另一只爪也来了。", "en": "My other claw comes too."},
        {"zh": "你被我这一掌推歪了。", "en": "That palm knocked you crooked."},
        {"zh": "我哼着，又抬手。", "en": "Humming, I raise it again."},
        {"zh": "到此就收手。", "en": "I stop here."},
        {"zh": "老实待在原地。", "en": "Stay right where you are."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑影里，一只大熊走出来。", "en": "Out of the dark shamble a great bear."},
        {"zh": "我的毛上挂着落叶。", "en": "Leaves stuck in my fur."},
        {"zh": "这林子，很适合我。", "en": "This wood suits me."},
        {"zh": "我蹲下来看看四周。", "en": "I squat and look around."},
        {"zh": "有活物的味道。", "en": "A living scent."},
        {"zh": "我哼了一段。", "en": "I hum a phrase."},
        {"zh": "树叶在我头上响。", "en": "Leaves rustle above me."},
        {"zh": "没有人来打扰。", "en": "No one comes to disturb."},
        {"zh": "我从蹲姿站了起来。", "en": "I rise from my crouch."},
        {"zh": "我从树影里站起，叶子簌簌落。", "en": "I rise from the tree shade; leaves rustle down."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，全身一震。", "en": "I fall and my whole body jolts."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进来，我挣扎。", "en": "Water floods in; I struggle."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我撞到树上。", "en": "The blast slams me into a tree."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭矢钉在我的肩头。", "en": "A bolt sticks in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我的缝线发烫。", "en": "That force heats my seams."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿起来，脾气更坏。", "en": "Hunger makes my temper worse."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在我身上，毛都立了。", "en": "Lightning; my fur stands up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下一空，我直往下。", "en": "Nothing below; I drop."}
      ]
    }
  }
}
