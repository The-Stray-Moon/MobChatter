{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步走在大路上。", "en": "I walk the open road."},
        {"zh": "我的腿很长，步子很大。", "en": "My legs are long and my stride wide."},
        {"zh": "背上的东西晃了一下。", "en": "The thing on my back shifts."},
        {"zh": "我把重心调了调。", "en": "I adjust my weight."},
        {"zh": "路两边是草原。", "en": "Grassland on both sides."},
        {"zh": "风把草吹得倒下去。", "en": "The wind lays the grass flat."},
        {"zh": "我又稳稳迈开步子。", "en": "I take the road again."},
        {"zh": "前面有一块界石。", "en": "There is a boundary stone ahead."},
        {"zh": "我顺着路肩绕行。", "en": "I walk along the shoulder."},
        {"zh": "有一只鸟落在我肩上。", "en": "A bird lands on my shoulder."},
        {"zh": "我沿着栅栏巡查。", "en": "I patrol along the fence."},
        {"zh": "我踩着焦草，慢慢走。", "en": "I walk slowly over the scorched grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在草原上。", "en": "I stand on the grassland."},
        {"zh": "四周什么都没有。", "en": "Nothing all around."},
        {"zh": "背上的货，先卸下来。", "en": "First, unload what's on my back."},
        {"zh": "坐在地上歇一歇。", "en": "And sit on the ground to rest."},
        {"zh": "草比我坐着还高。", "en": "The grass stands taller than I do sitting."},
        {"zh": "风从草上过去，像水。", "en": "Wind crosses the grass like water."},
        {"zh": "我抬起头，看云。", "en": "I raise my head and watch the clouds."},
        {"zh": "云走得相当快。", "en": "They move quickly."},
        {"zh": "我又站起身来。", "en": "I stand again."},
        {"zh": "把东西重新扛好。", "en": "And settle the load back."},
        {"zh": "我数了数袋子里的东西。", "en": "I count what is in the bag."},
        {"zh": "比昨天多一些。", "en": "More than yesterday."},
        {"zh": "我把袋口扎紧。", "en": "I tie the bag shut."},
        {"zh": "肩上的枪口，我擦了擦。", "en": "I wipe down the barrel on my shoulder."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你从路上走过来。", "en": "You come along the road."},
        {"zh": "我在路上站定。", "en": "I come to a stop."},
        {"zh": "我的影子拖在草地上。", "en": "My shadow trails across the grass."},
        {"zh": "你的手离扳机太近了。", "en": "Your hand is too close to my trigger."},
        {"zh": "我也低头看你。", "en": "I look down at you."},
        {"zh": "彼此都没作声。", "en": "Neither of us spoke."},
        {"zh": "你伸手指了指我背上的东西。", "en": "You point at what I carry."},
        {"zh": "我把它放下来给你看。", "en": "I set it down for you to see."},
        {"zh": "你看得很久。", "en": "You look a long while."},
        {"zh": "然后你点点头。", "en": "Then nod."},
        {"zh": "我又把它扛回。", "en": "I shoulder it again."},
        {"zh": "你没有拦着我。", "en": "You do not stop me."},
        {"zh": "我把包扛好上路。", "en": "I shoulder my pack and walk."},
        {"zh": "你也走自己的路。", "en": "You go your own way."},
        {"zh": "我们朝相反的方向。", "en": "Opposite directions."},
        {"zh": "这倒挺合我的意。", "en": "That is agreeable."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退了一步，稳住身子。", "en": "I step back and steady myself."},
        {"zh": "背上的东西歪了。", "en": "My load has slipped."},
        {"zh": "我伸手把它扶正。", "en": "I put a hand to it."},
        {"zh": "弹匣磕在石头上。", "en": "My magazine cracked against a stone."},
        {"zh": "我把弹药带紧了紧。", "en": "I tighten my ammo belt."},
        {"zh": "这道口子很浅。", "en": "This cut is shallow."},
        {"zh": "我照旧接着上路。", "en": "I take to the road as before."},
        {"zh": "走起来有点疼。", "en": "It stings as I walk."},
        {"zh": "但路不会等人。", "en": "But the road does not wait."},
        {"zh": "肩膀震了一下，站稳了。", "en": "My shoulder jolted; I stayed on my feet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你这是在喂我吗？", "en": "Are you feeding me?"},
        {"zh": "我看了一眼那东西。", "en": "I glance at it."},
        {"zh": "不是我喜欢吃的。", "en": "Not what I like."},
        {"zh": "但我还是接过来。", "en": "But I take it anyway."},
        {"zh": "放在背上的袋子里。", "en": "I put it in the bag on my back."},
        {"zh": "路上说不定用得上。", "en": "It may serve on the road."},
        {"zh": "你又给了一个。", "en": "You give another."},
        {"zh": "我也收了下来。", "en": "I take that too."},
        {"zh": "袋子已经满了。", "en": "The bag is full."},
        {"zh": "我把手抬了抬。", "en": "I raise a hand."},
        {"zh": "不必再给了。", "en": "No need to give more."},
        {"zh": "你不再给了。", "en": "You stop offering."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，被弹开了一点。", "en": "You strike me and rebound a little."},
        {"zh": "我伸手扶了一下。", "en": "I put out a hand and steady you."},
        {"zh": "你总算站稳了。", "en": "You find your feet."},
        {"zh": "你的肩撞到我的枪。", "en": "Your shoulder hit my gun."},
        {"zh": "给你让出一条路。", "en": "To clear the way."},
        {"zh": "我让开路，没有回头。", "en": "I step aside without looking back."},
        {"zh": "我的影子盖住你一会儿。", "en": "My shadow covers you a moment."},
        {"zh": "然后又移开了。", "en": "Then moves on."},
        {"zh": "这条路够两个人走。", "en": "This road is wide enough for two."},
        {"zh": "我仍按原路走着。", "en": "I keep to my road."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "路上没有别的同类。", "en": "There is no other of my kind on this road."},
        {"zh": "我一个人上路。", "en": "I walk alone."},
        {"zh": "背上的东西是我自己的。", "en": "What I carry is my own."},
        {"zh": "走多远都一样。", "en": "However far I walk, it is the same."},
        {"zh": "有时候我想过。", "en": "Sometimes I have thought about it."},
        {"zh": "想想也就算了。", "en": "Then I let it go."},
        {"zh": "这条路还长着。", "en": "The road is long."},
        {"zh": "草一直在动。", "en": "The grass keeps moving."},
        {"zh": "我一步一步走下去。", "en": "I walk on, step after step."},
        {"zh": "方向不会改。", "en": "The direction will not change."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西能装进枪膛。", "en": "This will fit in the chamber."},
        {"zh": "太轻了，握在手里没感觉。", "en": "So light I barely feel it."},
        {"zh": "我看了一眼，收进袋子。", "en": "One look, and into the bag."},
        {"zh": "袋子里已经有一堆了。", "en": "There is a heap of such things already."},
        {"zh": "都是这一路捡的。", "en": "All picked up along this road."},
        {"zh": "我重新上路了。", "en": "I set off again."},
        {"zh": "前面还有东西。", "en": "There is more ahead."},
        {"zh": "我把弹壳收进口袋。", "en": "I pocket the spent casing."},
        {"zh": "也收进袋子里。", "en": "And stow it too."},
        {"zh": "袋子会更满些。", "en": "The bag will fill further."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "草尖晃了一下，我看见了。", "en": "The grass tips twitched. I saw it."},
        {"zh": "我把东西放下来。", "en": "I set my load down."},
        {"zh": "草原上很开阔。", "en": "The grassland is open."},
        {"zh": "我看得相当远。", "en": "I see far."},
        {"zh": "它在向左移动。", "en": "It moves left."},
        {"zh": "我沿那个方向赶路。", "en": "I head that way."},
        {"zh": "它加快了一点。", "en": "It quickens a little."},
        {"zh": "我也加快了脚步。", "en": "So do I."},
        {"zh": "草被我们踩开一条路。", "en": "We press a path through the grass."},
        {"zh": "它没我跑得久。", "en": "It cannot run as long as I can."},
        {"zh": "我停下，等一等。", "en": "I stop and wait."},
        {"zh": "它以为我不追了。", "en": "It thinks I have given up."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "一直跟着它，不松。", "en": "Still following it. Not letting go."},
        {"zh": "它绕了个大圈。", "en": "It runs a wide circle."},
        {"zh": "我直线走过去。", "en": "I walk straight across."},
        {"zh": "正好在它前面。", "en": "Right into its path."},
        {"zh": "它忽然急停。", "en": "It stops short."},
        {"zh": "草被它蹬起一片。", "en": "Grass sprays from its feet."},
        {"zh": "我继续朝它走近。", "en": "I keep closing."},
        {"zh": "它退了两步远。", "en": "It gives two steps."},
        {"zh": "我把掌心朝前。", "en": "I raise my hand."},
        {"zh": "雷在我掌上聚起来。", "en": "Lightning gathers in my palm."},
        {"zh": "它已经瞧见了。", "en": "It has seen."},
        {"zh": "它转身要逃。", "en": "It turns to flee."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一掌打出去。", "en": "I strike with an open palm."},
        {"zh": "雷从掌心迸出来。", "en": "Lightning bursts from my palm."},
        {"zh": "那东西被击退很远。", "en": "The thing is thrown far back."},
        {"zh": "草烧焦了一片。", "en": "A patch of grass is scorched."},
        {"zh": "我一步步走近。", "en": "I walk nearer, step by step."},
        {"zh": "它仍然在抽动。", "en": "It is still twitching."},
        {"zh": "草原上，我抬手就是雷。", "en": "On the savanna, my raised hand is lightning."},
        {"zh": "这一次它停了。", "en": "This time it stops."},
        {"zh": "我把它拖到路上。", "en": "I drag it onto the road."},
        {"zh": "我用枪托把它顶开。", "en": "I shove it away with my stock."},
        {"zh": "身上的东西还完好。", "en": "What it carried is intact."},
        {"zh": "我收进袋子里。", "en": "I put that in my bag."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在一条大路上。", "en": "I stand on a broad road."},
        {"zh": "两边没有尽头。", "en": "Neither end in sight."},
        {"zh": "背上的东西还没有解开。", "en": "My load is still strapped on."},
        {"zh": "我从草坡下来，枪口还凉着。", "en": "I come down the slope, my barrel still cold."},
        {"zh": "太阳从东边照过来。", "en": "The sun comes from the east."},
        {"zh": "我的双臂，都上了膛。", "en": "Both arms are loaded."},
        {"zh": "草在风里伏下去。", "en": "The grass lies down in the wind."},
        {"zh": "我的影子跟在后面。", "en": "My shadow follows behind."},
        {"zh": "这条路很平。", "en": "The road is level."},
        {"zh": "走起来不费劲。", "en": "Easy walking."},
        {"zh": "我走了一小段。", "en": "I walk a stretch."},
        {"zh": "停下来看了看。", "en": "And stop to look."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到我的背包，我埋头往前冲。", "en": "Fire catches my pack; I charge forward."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下，落地时膝盖一软。", "en": "I fall from height and my knees give."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进嘴里，我抱着包往上挣。", "en": "Water floods my mouth; I struggle up with the pack."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸响把我的包掀开，东西撒了一地。", "en": "The blast opens my pack and scatters everything."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭扎进我的腿，箭杆在抖。", "en": "An arrow in my leg; the shaft quivers."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光压住我，我抬不起手。", "en": "Strange light presses me and I cannot lift my hand."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "走了三天没吃东西，腿发软。", "en": "Three days without food and my legs weaken."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我掌上的和它撞在一起。", "en": "Lightning strikes and it meets the light in my palm."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "路面消失，我坠进黑暗。", "en": "The road vanishes and I drop into black."}
      ]
    }
  }
}
