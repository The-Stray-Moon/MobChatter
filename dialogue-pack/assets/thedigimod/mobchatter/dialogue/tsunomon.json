        {"zh": "碗空了，我饿", "en": "The bowl's empty; I'm hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一闪，毛全竖了", "en": "Lightning flashed; my fur stood up."}
      ]
    },
    "hurt.void": {
