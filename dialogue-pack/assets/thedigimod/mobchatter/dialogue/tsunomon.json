{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "头上的角随着步子颠", "en": "The horn on my head bobs as I walk."},
        {"zh": "我毛茸茸的，走得很快", "en": "Fluffy, and quick on my feet."},
        {"zh": "我跟着一小群一起走", "en": "I move with a small group."},
        {"zh": "草地上的草比我高", "en": "The grass is taller than me."},
        {"zh": "我脚下踩着落叶", "en": "I step on fallen leaves."},
        {"zh": "我边走边四处看", "en": "I walk and keep a lookout."},
        {"zh": "我的尾巴几乎看不见", "en": "My tail is barely visible."},
        {"zh": "我在找能玩的东西", "en": "I'm looking for something to play with."},
        {"zh": "走两步就蹦一下", "en": "Two steps, then a hop."},
        {"zh": "我把角藏在毛里", "en": "I tuck my horn into my fur."},
        {"zh": "森林里我钻来钻去", "en": "I slip back and forth in the woods."},
        {"zh": "走过的路我都记着", "en": "I remember the paths I take."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，毛一团一团的", "en": "I sit, fur in tufts."},
        {"zh": "我的角非常硬", "en": "My horn is very hard."},
        {"zh": "我在等那一碗", "en": "I'm waiting for that bowl."},
        {"zh": "店里的人会照顾我", "en": "The shopkeeper looks after me."},
        {"zh": "我只有五点生命值", "en": "I have only five points of life."},
        {"zh": "我总共五点生命", "en": "Five points of life, in total."},
        {"zh": "我还没长出真正的牙", "en": "My real teeth haven't grown in."},
        {"zh": "风吹得我的毛都乱了", "en": "The wind ruffles all my fur."},
        {"zh": "我在打个盹儿", "en": "I'm dozing."},
        {"zh": "这片草地很软", "en": "This grass is soft."},
        {"zh": "有片叶子落在我头上", "en": "A leaf lands on my head."},
        {"zh": "我能进化成好几种", "en": "I could evolve several ways."},
        {"zh": "我在想要不要跑", "en": "I'm deciding whether to run."},
        {"zh": "附近好像有人", "en": "Someone's nearby."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是不是带了饲料", "en": "Did you bring feed?"},
        {"zh": "你摸我一下可以", "en": "You may pet me once."},
        {"zh": "我的角不扎人", "en": "My horn doesn't prick."},
        {"zh": "我坐下就是不想走", "en": "When I sit, I don't want to leave."},
        {"zh": "我能跟你走吗", "en": "May I come with you?"},
        {"zh": "你会是我的主人吗", "en": "Will you be my master?"},
        {"zh": "我很怕大东西", "en": "I'm afraid of big things."},
        {"zh": "但我不会躲开你", "en": "But I won't hide from you."},
        {"zh": "你蹲下我就凑过去", "en": "Crouch and I'll come over."},
        {"zh": "你身上有饲料的味道", "en": "You smell of feed."},
        {"zh": "我的耳朵很小", "en": "My ears are small."},
        {"zh": "但能听见很远的你", "en": "Yet I hear you from far."},
        {"zh": "你想看我吹泡泡吗", "en": "Want to see my bubbles?"},
        {"zh": "我一直在练这个", "en": "I've been practicing."},
        {"zh": "别拍我的头，会晕", "en": "Don't pat my head; it makes me dizzy."},
        {"zh": "你蹲下来，我就敢靠近了", "en": "When you crouch, I dare come closer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚出去好远", "en": "I rolled far away."},
        {"zh": "毛被揪掉了一撮", "en": "Some fur got pulled out."},
        {"zh": "我一共才五点生命", "en": "I've only five points altogether."},
        {"zh": "我又缩成了一团", "en": "I curled into a ball again."},
        {"zh": "角歪了，我拿爪子扶不正", "en": "My horn is crooked and my paws can't fix it."},
        {"zh": "很疼，但我还敢", "en": "It hurts, but I dare."},
        {"zh": "我躲到主人背后", "en": "I duck behind my master."},
        {"zh": "疼得我耳朵都贴平了", "en": "It hurts so much my ears flatten."},
        {"zh": "毛都乱了，我不想打了", "en": "My fur is all messed up and I don't want to fight."},
        {"zh": "别再动手打我了", "en": "Please stop striking me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "幼年期饲料的味道", "en": "The smell of in-training feed."},
        {"zh": "你放下我就过去", "en": "Set it down; I'll come."},
        {"zh": "这一小口就够了", "en": "A tiny bite is enough."},
        {"zh": "我吃东西很快", "en": "I eat fast."},
        {"zh": "吃完我就坐下", "en": "After eating I'll sit."},
        {"zh": "别举太高，我够不到", "en": "Don't hold it high; I can't reach."},
        {"zh": "我把爪子搭在碗边", "en": "I put my paws on the bowl."},
        {"zh": "这点我能吃一天", "en": "This could last me a day."},
        {"zh": "再吃几口就跟你走", "en": "A few more bites and I'll follow."},
        {"zh": "我吃完会打滚", "en": "I'll roll over after eating."},
        {"zh": "你手心里还有吗", "en": "Is there more in your palm?"},
        {"zh": "别拿走，我还没舔完", "en": "Don't take it; I'm still licking."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰我，毛都炸起来了", "en": "Touch me and my fur puffs up."},
        {"zh": "我很轻，一撞就滚", "en": "I'm light; one bump and I roll."},
        {"zh": "我弹开了两步", "en": "I bounce back two steps."},
        {"zh": "我的角磕到你了", "en": "My horn bumped you."},
        {"zh": "我紧紧缩成一团", "en": "I curl up tight."},
        {"zh": "我什么事都没有", "en": "I'm not hurt at all."},
        {"zh": "你踩到我的毛了", "en": "You stepped on my fur."},
        {"zh": "我在地上滑了一下", "en": "I skidded on the ground."},
        {"zh": "我绕到另一边去", "en": "I go around the other side."},
        {"zh": "你一碰，我就滚成个球", "en": "One touch and I roll into a ball."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我实在还太小", "en": "I'm still little."},
        {"zh": "这事要等我进化", "en": "That waits till I evolve."},
        {"zh": "我只会吃饭和睡觉", "en": "I only eat and sleep."},
        {"zh": "你问的时机不对", "en": "Wrong moment to ask."},
        {"zh": "这种事，等我长大再说", "en": "This sort of thing can wait until I grow up."},
        {"zh": "先陪我玩一玩吧", "en": "Play with me first."},
        {"zh": "我的毛还没长好", "en": "My fur isn't grown in yet."},
        {"zh": "我还不懂我会变成什么", "en": "I don't know what I'll become."},
        {"zh": "我更喜欢饲料", "en": "I prefer feed."},
        {"zh": "别捏我的脸啊", "en": "Don't squeeze my face."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上有一粒饲料", "en": "A bit of feed on the ground."},
        {"zh": "我用爪子拨了过来", "en": "I paw it over."},
        {"zh": "我叼在嘴里藏着", "en": "I hold it in my mouth."},
        {"zh": "这点我要留到最后", "en": "I'll save this for last."},
        {"zh": "我滚着它玩起来", "en": "I roll it around to play."},
        {"zh": "我叼不住，只能滚着走", "en": "I can't hold it, so I roll it along."},
        {"zh": "我把它埋进草里", "en": "I bury it in the grass."},
        {"zh": "回头再来吃它", "en": "I'll come back for it."},
        {"zh": "掉在地上就没了吧", "en": "If I drop it, it's gone."},
        {"zh": "我不抢别人的", "en": "I don't take others'."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我要吹泡泡了", "en": "Here come my bubbles."},
        {"zh": "你这是欺负我", "en": "You're bullying me."},
        {"zh": "我主人会来的", "en": "My master will come."},
        {"zh": "我也想要打一下", "en": "I want a turn too."},
        {"zh": "我的角也是硬的", "en": "My horn is hard too."},
        {"zh": "我已经冲过去了", "en": "I'm charging."},
        {"zh": "五点生命，但我敢", "en": "Five points, but I dare."},
        {"zh": "你走开，我就当没这回事", "en": "Walk away and I'll forget this happened."},
        {"zh": "我在发抖，但没跑", "en": "I'm shaking, but not running."},
        {"zh": "这是我第一次凶起来", "en": "This is my first time being fierce."},
        {"zh": "泡泡糊你的眼睛", "en": "Bubbles in your eyes."},
        {"zh": "我已经喊过人了", "en": "I've called out."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你转，不敢扑上去", "en": "I circle you but don't dare pounce."},
        {"zh": "泡泡在嘴里攒着", "en": "Bubbles gathering in my mouth."},
        {"zh": "我太小，打不中我", "en": "Too small to hit me."},
        {"zh": "我先不动，看你动", "en": "I hold still; you move first."},
        {"zh": "草叶能挡住我", "en": "The grass blades hide me."},
        {"zh": "我的耳朵一直朝向你", "en": "My ears point at you."},
        {"zh": "你一转我就换方向", "en": "You turn; I switch direction."},
        {"zh": "我把小角低低地对着你", "en": "I lower my little horn at you."},
        {"zh": "我贴着草，往前蹭一下", "en": "I press low to the grass and edge forward."},
        {"zh": "你别靠近我的主人", "en": "Don't get near my master."},
        {"zh": "我真的好紧张", "en": "I'm very nervous."},
        {"zh": "但我不会跑开", "en": "But I won't run."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用角顶了你", "en": "I butted you with my horn."},
        {"zh": "泡泡飞了出去", "en": "The bubbles fly."},
        {"zh": "我扑上去抓你", "en": "I leap and claw."},
        {"zh": "这一下没打准", "en": "That one missed."},
        {"zh": "你被泡泡糊住了", "en": "You got bubbled."},
        {"zh": "我一滚躲开了", "en": "I roll away."},
        {"zh": "再吹上一口气", "en": "Another breath."},
        {"zh": "我扑上去，只够到你的裤脚", "en": "I lunge and only reach your trouser leg."},
        {"zh": "这一下软绵绵的，可我真咬", "en": "It's a feeble bite, but I really bite."},
        {"zh": "但我性子特别倔", "en": "But I'm stubborn."},
        {"zh": "我撞上去，自己先滚了", "en": "I charge in and tumble over first."},
        {"zh": "我跑回主人那边", "en": "I run back to my master."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "毛团从光里走了出来", "en": "A ball of fur steps out of the light."},
        {"zh": "我头顶上有个角", "en": "There's a horn on my head."},
        {"zh": "我看到草地了", "en": "I see the grass."},
        {"zh": "这一群有好几只", "en": "Several of us in this group."},
        {"zh": "我找到吃的味道", "en": "I smell food."},
        {"zh": "风一吹毛全乱了", "en": "The wind ruffles all my fur."},
        {"zh": "我小心地走了出来", "en": "I step out carefully."},
        {"zh": "我的第一声很小", "en": "My first cry is small."},
        {"zh": "森林里多了个毛团", "en": "One more fur ball in the woods."},
        {"zh": "我先找个地方坐下", "en": "First I need somewhere to sit."},
        {"zh": "光里出来，肚子还空着", "en": "I step out of the light still hungry."},
        {"zh": "这附近有人吗", "en": "Is anyone there?"}
      ]
    },
