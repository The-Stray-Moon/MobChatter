{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我低空掠过白桦林。", "en": "I skim low over the birch wood."},
        {"zh": "我的翼展在树干之间。", "en": "My wingspan fills the gaps between trunks."},
        {"zh": "我绕着自己的锚点转。", "en": "I circle my anchor point."},
        {"zh": "侧倾着，我的翼尖点地。", "en": "Banking, my wingtip grazes the ground."},
        {"zh": "山风把我推得偏了一点。", "en": "Mountain wind nudges me off line."},
        {"zh": "我在恶地的红岩间穿行。", "en": "I thread the badlands' red rock."},
        {"zh": "我不落地，只贴着飞。", "en": "I never land, only skim."},
        {"zh": "我朝一片废料堆滑下去。", "en": "I glide down toward a scrap heap."},
        {"zh": "我的影子在坡上滑。", "en": "My shadow glides over the slope."},
        {"zh": "我跟着主人的方向飞。", "en": "I fly the way my owner goes."},
        {"zh": "我扇了两下，稳住高度。", "en": "Two beats hold my height."},
        {"zh": "我从峰顶绕下来。", "en": "I spiral down from the peak."},
        {"zh": "我沿着溪谷低飞。", "en": "I fly low along the ravine."},
        {"zh": "我落在岩石上歇一下。", "en": "I settle on a rock to rest."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在空中悬停着。", "en": "I hover in place."},
        {"zh": "我的翼膜一下下抽动。", "en": "My wing membrane pulses."},
        {"zh": "我的眼睛扫过下面。", "en": "My eyes sweep below."},
        {"zh": "我在等主人下命令。", "en": "I wait for my owner's order."},
        {"zh": "我在废料堆边落下。", "en": "I light by the scrap pile."},
        {"zh": "我咬了一块铁片。", "en": "I gnaw a piece of sheet metal."},
        {"zh": "我抖了抖翼上的灰。", "en": "I shake ash off my wings."},
        {"zh": "山口的哨声，我听得清。", "en": "I can hear the whistle at the pass."},
        {"zh": "我在锚点上方绕小圈。", "en": "I make small loops over my anchor."},
        {"zh": "我把头转了个方向。", "en": "I turn my head to a new bearing."},
        {"zh": "我绕着锚点半圈。", "en": "I circle half a turn around my anchor."},
        {"zh": "我飞起来，鳞片会发烫。", "en": "When I fly, my scales run hot."},
        {"zh": "我累不着，也不会摔。", "en": "I don't tire, and I don't fall."},
        {"zh": "我在等一场战斗。", "en": "I wait for a fight."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "这个气味很生。", "en": "That scent is unfamiliar."},
        {"zh": "你站的地方是我的锚点。", "en": "You're standing on my anchor."},
        {"zh": "我盯着你的掌心。", "en": "I'm watching your palm."},
        {"zh": "你背包里有废料吗？", "en": "Any scrap in your pack?"},
        {"zh": "我可以载你走一段。", "en": "I could carry you a ways."},
        {"zh": "你伸手是想摸我？", "en": "Are you reaching to pet me?"},
        {"zh": "先让我闻闻。", "en": "Let me smell you first."},
        {"zh": "我不喜欢被拽。", "en": "I dislike being yanked."},
        {"zh": "你的靴子沾了矿渣。", "en": "Your boots carry slag."},
        {"zh": "你身上有铁屑味。", "en": "You carry the smell of iron filings."},
        {"zh": "我又压低了一线。", "en": "I drop a fraction lower."},
        {"zh": "你抬头看我就够。", "en": "Looking up is enough."},
        {"zh": "别站在我翼下面。", "en": "Don't stand under my wing."},
        {"zh": "你挡在我起飞的方向。", "en": "You stand in my takeoff line."},
        {"zh": "我低空掠过白桦林，翼展卡在树间。", "en": "I skim the birches, wingspan caught between trunks."},
        {"zh": "我习惯这样。", "en": "I'm used to it."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翼被划了一下。", "en": "A cut on my wing."},
        {"zh": "我的翼膜被划开一线。", "en": "A line is cut across my wing membrane."},
        {"zh": "翼膜上破了个小口。", "en": "A small tear in my membrane."},
        {"zh": "我落下来缓一缓。", "en": "I touch down to recover."},
        {"zh": "这点伤不碍飞。", "en": "This won't stop my flight."},
        {"zh": "我的翼骨有点响。", "en": "My wing bones click."},
        {"zh": "我在气流里打了个滚。", "en": "I tumbled once in the updraft."},
        {"zh": "我得换低一点的高度。", "en": "I need a lower altitude."},
        {"zh": "我记下你这张脸。", "en": "I've noted that face."},
        {"zh": "再飞一轮。", "en": "One more pass."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是废料吗？", "en": "Is that scrap?"},
        {"zh": "抛上来。", "en": "Toss it up."},
        {"zh": "我闻到了铁锈味。", "en": "I smell rust."},
        {"zh": "一块能啃的废铁。", "en": "A scrap of iron worth chewing."},
        {"zh": "我落下来看看，翅膀还在扇。", "en": "I come down to look, wings still beating."},
        {"zh": "搁下，别举高。", "en": "Set it down, don't hold it high."},
        {"zh": "塞不满我的嘴。", "en": "It will not fill my jaws."},
        {"zh": "你能找到更多吗？", "en": "Can you find more?"},
        {"zh": "我啃得动这个。", "en": "I can chew this."},
        {"zh": "这味道让我精神。", "en": "That perks me up."},
        {"zh": "我可以给你驮东西。", "en": "I could haul things for you."},
        {"zh": "算是交换。", "en": "Call it a trade."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的翼骨上。", "en": "You hit my wing bone."},
        {"zh": "我扇了一下稳住。", "en": "I beat once to steady."},
        {"zh": "你的肩膀碰到我的翼尖。", "en": "Your shoulder brushed my wingtip."},
        {"zh": "我的翼很薄。", "en": "My wings are thin."},
        {"zh": "我被你碰得偏了。", "en": "You knocked me off line."},
        {"zh": "你退到石头边吧。", "en": "Step back to the rocks."},
        {"zh": "这点磕碰碍不着翼。", "en": "That won't hinder my wings."},
        {"zh": "我落下来挡在你前面。", "en": "I land in front of you."},
        {"zh": "你的帽檐被风掀了。", "en": "Wind flipped your hat brim."},
        {"zh": "再撞我就起飞。", "en": "Bump again and I take off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是被养大的。", "en": "I was raised, not born wild."},
        {"zh": "我只认指令。", "en": "I answer to orders."},
        {"zh": "这种事不在程序里。", "en": "That isn't in my routines."},
        {"zh": "你先做我的主人。", "en": "First be my owner."},
        {"zh": "我更喜欢废料。", "en": "I prefer scrap."},
        {"zh": "我的翼还没长稳。", "en": "My wings aren't settled yet."},
        {"zh": "我只认指令，这种事不在程序里。", "en": "I answer to orders; this is not in my programming."},
        {"zh": "我要去巡锚点了。", "en": "I'm off to check my anchor."},
        {"zh": "换个话题。", "en": "Change the subject."},
        {"zh": "我要起飞了。", "en": "I'm taking off."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一块铁皮，我叼起。", "en": "A sheet of metal, I take it."},
        {"zh": "我咬了两下就吞了。", "en": "Two bites and it's down."},
        {"zh": "这块太结实了。", "en": "This one's too solid."},
        {"zh": "我从废料堆里挑出一块。", "en": "I pick one piece out of the scrap heap."},
        {"zh": "废料堆里有好货。", "en": "Good stuff in the scrap heap."},
        {"zh": "我把它拖到锚点。", "en": "I drag it to my anchor."},
        {"zh": "带给主人看看。", "en": "I'll bring it to my owner."},
        {"zh": "这块能换一顿。", "en": "This could buy a meal."},
        {"zh": "我叼着飞不起来。", "en": "Too heavy to fly with."},
        {"zh": "那就先放着。", "en": "I'll leave it for now."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "山石那边有动静。", "en": "Movement by the rocks."},
        {"zh": "我先升了高度。", "en": "I gain height first."},
        {"zh": "我的翼已经张开。", "en": "My wings are spread."},
        {"zh": "这个角度可以俯冲。", "en": "This angle allows a dive."},
        {"zh": "主人在我身后。", "en": "My owner is behind me."},
        {"zh": "我不许你过去。", "en": "You won't get past."},
        {"zh": "我压低翼尖。", "en": "I dip my wingtips."},
        {"zh": "我的特攻已经上膛。", "en": "My special attack is charged."},
        {"zh": "Mega Blaster 准备好了。", "en": "Mega Blaster is ready."},
        {"zh": "我的翼尖已经对准你。", "en": "My wingtip is already lined up on you."},
        {"zh": "数到三了。", "en": "I've reached three."},
        {"zh": "我从你头顶压下来。", "en": "I drop down over your head."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你盘旋。", "en": "I circle above you."},
        {"zh": "我的影子始终罩着你。", "en": "My shadow stays over you."},
        {"zh": "你在我的斜上方看不到。", "en": "You can't see me from that angle."},
        {"zh": "你听不出我在哪边。", "en": "You cannot tell which side I am on."},
        {"zh": "你的步幅，我在心里记数。", "en": "I'm counting your stride in my head."},
        {"zh": "你往左跑，我往左绕。", "en": "You run left, I circle left."},
        {"zh": "我的能量在翼尖聚。", "en": "Energy gathers at my wingtips."},
        {"zh": "再近三步就够。", "en": "Three more steps is close enough."},
        {"zh": "射程正好。", "en": "Perfect firing range."},
        {"zh": "你听见电流声了吗？", "en": "Do you hear the current?"},
        {"zh": "那是我的呼吸。", "en": "That's my breathing."},
        {"zh": "现在动手。", "en": "Striking now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲，翼先到。", "en": "I dive, wings leading."},
        {"zh": "爪子在你肩上一擦。", "en": "My claws graze your shoulder."},
        {"zh": "我被你的武器挡了。", "en": "Your weapon blocked me."},
        {"zh": "我拉开距离又回来。", "en": "I pull away and return."},
        {"zh": "这一下带电流。", "en": "That one carried a current."},
        {"zh": "翼尖擦过你的护肩。", "en": "My wingtip scrapes your pauldron."},
        {"zh": "我在空中换了个角度。", "en": "I shift angle in the air."},
        {"zh": "你的护甲有一块焦了。", "en": "A patch of your armor scorched."},
        {"zh": "我躲进树荫。", "en": "I slip into the tree shade."},
        {"zh": "我不落地打。", "en": "I don't fight on the ground."},
        {"zh": "那样太慢。", "en": "Too slow."},
        {"zh": "下一发更准。", "en": "The next shot is truer."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从云下穿出来。", "en": "I drop out from under the cloud."},
        {"zh": "桦树林上方多了一副翼。", "en": "Another pair of wings above the birches."},
        {"zh": "我先绕锚点飞了一圈。", "en": "I circle my anchor once first."},
        {"zh": "红岩上的风很硬。", "en": "The wind over the red rock is sharp."},
        {"zh": "我落在一块突出的石上。", "en": "I settle on an outcrop."},
        {"zh": "我的翼慢慢展开。", "en": "My wings unfurl slowly."},
        {"zh": "这里的废料不多。", "en": "Not much scrap here."},
        {"zh": "我在找一条能吃的。", "en": "I look for something edible."},
        {"zh": "山脊的线拉得很直。", "en": "The ridgeline runs dead straight."},
        {"zh": "我听见下面有人。", "en": "I hear someone below."},
        {"zh": "我先压低高度。", "en": "I drop a little lower."},
        {"zh": "这道山脊归我巡。", "en": "This ridge is mine to patrol."},
        {"zh": "树梢上，我先停一下。", "en": "On the treetop, I pause first."},
        {"zh": "你也在这儿？", "en": "Are you here too?"}
      ]
    },
