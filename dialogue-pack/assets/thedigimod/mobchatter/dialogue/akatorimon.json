{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着大爪子，一步一晃。", "en": "Big claws, one swaying step after another."},
        {"zh": "红羽毛在光里很亮。", "en": "Red plumage catches the light."},
        {"zh": "我的头冠一颠一颠。", "en": "My crest bobs with each step."},
        {"zh": "我走得像只很大的鸡。", "en": "I walk like an enormous chicken."},
        {"zh": "两只脚爪抓地。", "en": "Two clawed feet grip the ground."},
        {"zh": "我在田地边转悠。", "en": "I wander by the fields."},
        {"zh": "我走过田垄，尾羽一翘。", "en": "I cross the rows, tail feathers lifted."},
        {"zh": "我走两步，就低头啄一下。", "en": "Two steps, then a peck at the ground."},
        {"zh": "鸡群里，我最大。", "en": "In a flock, I'm the biggest."},
        {"zh": "我不急，慢慢找食。", "en": "No rush; I forage slowly."},
        {"zh": "地上的虫，我看得见。", "en": "I spot the bugs on the ground."},
        {"zh": "羽毛抖了抖，很蓬松。", "en": "My feathers shake out, fluffy."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起一只脚，站着。", "en": "I stand on one foot."},
        {"zh": "我理了理胸前羽毛。", "en": "I preen my chest."},
        {"zh": "阳光晒得我很暖。", "en": "The sun warms me."},
        {"zh": "我拉长嗓子，叫给远处听。", "en": "I stretch my call toward the distance."},
        {"zh": "头冠微微发红。", "en": "My crest reddens slightly."},
        {"zh": "周围没有别的数码兽。", "en": "No other Digimon around."},
        {"zh": "我在看地上的影子。", "en": "I watch my shadow on the ground."},
        {"zh": "这地方适合做窝。", "en": "Good spot for a nest."},
        {"zh": "我低头啄了啄土。", "en": "I peck at the soil."},
        {"zh": "羽毛上有灰。", "en": "Dust on my feathers."},
        {"zh": "风把我的尾羽吹开。", "en": "Wind spreads my tail feathers."},
        {"zh": "我转了转脖子。", "en": "I roll my neck."},
        {"zh": "肚子咕咕响。", "en": "My belly rumbles."},
        {"zh": "我很满意这里。", "en": "I'm content here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我小多了。", "en": "You're much smaller than me."},
        {"zh": "我这身红羽，好看吗？", "en": "Do you like these red feathers?"},
        {"zh": "我瞧见你掌心里有谷子。", "en": "I see grain in your palm."},
        {"zh": "别碰我的尾羽。", "en": "Don't touch my tail feathers."},
        {"zh": "我能用爪子抓东西。", "en": "I can grab with these claws."},
        {"zh": "你身上的味道，新鲜。", "en": "Your scent is fresh."},
        {"zh": "我的头冠会立起来。", "en": "My crest rises."},
        {"zh": "我这块田，你也想要？", "en": "You want my field too?"},
        {"zh": "我叫起来很响。", "en": "I call loudly."},
        {"zh": "我啄人的，别靠太近。", "en": "I peck; don't come too close."},
        {"zh": "这田地是我的。", "en": "These fields are mine."},
        {"zh": "你别挪地方。", "en": "Don't shift from that spot."},
        {"zh": "我在估量你。", "en": "I'm sizing you up."},
        {"zh": "我嫌你太硬，不合胃口。", "en": "You're too tough for my appetite."},
        {"zh": "我不太喜欢被打扰。", "en": "I don't care for interruptions."},
        {"zh": "你还想待多久？", "en": "How long do you plan to stay?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "红羽掉了一地。", "en": "Red feathers everywhere."},
        {"zh": "红羽一抖，我退了两步。", "en": "Red feathers shake; I back off two steps."},
        {"zh": "这点伤还拦不住我。", "en": "This wound can't stop me yet."},
        {"zh": "我扯着嗓子叫了一声。", "en": "I let out a full-throated call."},
        {"zh": "我的冠歪了。", "en": "My crest is askew."},
        {"zh": "我一只脚站不稳。", "en": "I can't stand on one leg."},
        {"zh": "我的红羽上又多一道血。", "en": "Another streak of blood on my red feathers."},
        {"zh": "我把脑袋狠狠一甩。", "en": "I whip my head hard."},
        {"zh": "这两条腿还跑得动。", "en": "These legs can still run."},
        {"zh": "别打我的腿。", "en": "Not my legs."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "种子？撒下来。", "en": "Seeds? Scatter them."},
        {"zh": "我跑过去会踩坏田。", "en": "Running over would crush the field."},
        {"zh": "把种子撒得再低些。", "en": "Scatter the seeds lower."},
        {"zh": "这点东西太少了。", "en": "There's far too little here."},
        {"zh": "我一口就能啄完。", "en": "I'd peck that up in one go."},
        {"zh": "你退开，我来。", "en": "Step back; I'll come."},
        {"zh": "我吃东西的时候很专心。", "en": "I'm focused when eating."},
        {"zh": "别从我嘴下抢。", "en": "Don't snatch from under my beak."},
        {"zh": "要是有虫子更好。", "en": "Bugs would be even better."},
        {"zh": "吃完我再看看你。", "en": "After eating, I'll look at you again."},
        {"zh": "撒远一点也行。", "en": "Scatter it a bit away, fine."},
        {"zh": "这些不够一群。", "en": "Not enough for a flock."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的腿骨上。", "en": "You hit my shin."},
        {"zh": "我一晃，站住了。", "en": "I sway and hold."},
        {"zh": "红羽掉了两根。", "en": "Two red feathers came out."},
        {"zh": "我把红冠压低看你。", "en": "I dip my red crest to look at you."},
        {"zh": "这点冲撞，我不在乎。", "en": "That impact doesn't bother me."},
        {"zh": "我侧了半步给你让路。", "en": "I side-step half a pace for you."},
        {"zh": "爪子踩到你了。", "en": "My claw caught you."},
        {"zh": "我们撞在一起，尘土起来了。", "en": "We collided and dust rose."},
        {"zh": "你退得倒利索。", "en": "You back off nimbly."},
        {"zh": "你没磕坏哪儿吧？", "en": "You haven't hurt yourself?"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "那边那只，尾羽很长。", "en": "That one has long tail feathers."},
        {"zh": "我张翅，转了个圈。", "en": "I spread my wings and turn."},
        {"zh": "我叼了条虫过去。", "en": "I bring a worm over."},
        {"zh": "她低头啄了啄。", "en": "She dips her head and pecks."},
        {"zh": "我们在田边做窝。", "en": "We nest by the field."},
        {"zh": "一群鸡，围着我们。", "en": "A flock gathers around us."},
        {"zh": "我在她面前挺起胸。", "en": "I puff out my chest before her."},
        {"zh": "她的羽毛颜色更淡。", "en": "Her feathers are paler."},
        {"zh": "这窝能放不少蛋。", "en": "This nest could hold many eggs."},
        {"zh": "我们一起守着。", "en": "We guard it together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我啄起来，仰头吞。", "en": "I peck it up and swallow."},
        {"zh": "这一块太大了。", "en": "This piece is too big."},
        {"zh": "土里那点东西，我刨出来。", "en": "I scratch that thing out of the soil."},
        {"zh": "掉地上，我又啄。", "en": "Dropped; I peck again."},
        {"zh": "这么点填不饱。", "en": "That much won't fill me."},
        {"zh": "我啄起它，扭头就跑。", "en": "I peck it up and dash off."},
        {"zh": "别抢，我看见了。", "en": "Don't grab; I saw it first."},
        {"zh": "这颗种子很硬。", "en": "This seed is hard."},
        {"zh": "我留着给小鸡。", "en": "I'll save it for the chicks."},
        {"zh": "味道还过得去。", "en": "The taste is passable."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西进了田。", "en": "Something's in the field."},
        {"zh": "我抬起头，冠立起来。", "en": "I raise my head; my crest rises."},
        {"zh": "那不是只鸡。", "en": "That's no chicken."},
        {"zh": "我迈开大步，朝它压过去。", "en": "I stride toward it, pressing on."},
        {"zh": "爪子在地上扒了两下。", "en": "My claw scrapes twice."},
        {"zh": "你落进我眼里了。", "en": "You've fallen into my sight."},
        {"zh": "叫一声，先警告。", "en": "One call as a warning."},
        {"zh": "这片田归我管。", "en": "These fields are mine."},
        {"zh": "你挡我的路了。", "en": "You're in my way."},
        {"zh": "别等我先动爪。", "en": "Don't wait for my claws."},
        {"zh": "我飞不高，但跑得快。", "en": "I don't fly high, but I run fast."},
        {"zh": "就在眼前了。", "en": "It's right before me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你，脚步越来越近。", "en": "I circle you, each step closer."},
        {"zh": "我压低身子，爪子先动。", "en": "I lower myself, claws first."},
        {"zh": "你退到田埂上。", "en": "You've backed onto the ridge."},
        {"zh": "我叫得越来越响。", "en": "My calls grow louder."},
        {"zh": "我把红翅膀撑到最大。", "en": "I spread my red wings wide."},
        {"zh": "尘土在我脚下。", "en": "Dust at my feet."},
        {"zh": "你想撒腿跑？", "en": "Thinking of bolting?"},
        {"zh": "我这么站着等。", "en": "I'll stand here and wait."},
        {"zh": "我顶着风，羽毛全乱了。", "en": "I lean into the wind, feathers in disarray."},
        {"zh": "再凑近半尺。", "en": "Half a foot nearer."},
        {"zh": "我扑过去也不慢。", "en": "My pounce isn't slow."},
        {"zh": "我蹬地扑了过去。", "en": "I kick off and lunge."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用爪子抓过去！", "en": "My claws rake out!"},
        {"zh": "小旋风，接好！", "en": "Petit Twister — take it!"},
        {"zh": "我这一啄，正中胸口。", "en": "My peck lands square on the chest."},
        {"zh": "你被顶退半步。", "en": "You were shoved back half a step."},
        {"zh": "红羽都竖了起来。", "en": "My red feathers bristle."},
        {"zh": "我跳起来，双脚蹬你。", "en": "I leap and kick with both feet."},
        {"zh": "这一爪分量不轻。", "en": "That claw landed with weight."},
        {"zh": "你别抓我腿。", "en": "Not my legs."},
        {"zh": "我又扑上来了。", "en": "I lunge again."},
        {"zh": "土都被我刨开。", "en": "I've torn up the soil."},
        {"zh": "我打得很直。", "en": "My strikes go straight."},
        {"zh": "我这爪，你接得住？", "en": "Can you take this claw?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从田边走出来。", "en": "I come from the field's edge."},
        {"zh": "红羽在光里一闪。", "en": "Red feathers flash in the light."},
        {"zh": "这里的地，很肥。", "en": "Rich soil here."},
        {"zh": "落地第一下，我就刨土。", "en": "My first act on landing is to scratch the soil."},
        {"zh": "周围没有别的鸡。", "en": "No other chickens about."},
        {"zh": "我仰头拉长了一声叫。", "en": "I lift my head and draw out a call."},
        {"zh": "这土够软，我就在此做窝。", "en": "The soil is soft; I'll nest right here."},
        {"zh": "我闻到泥土里翻出的虫味。", "en": "I smell insects turned up from the soil."},
        {"zh": "我慢慢走进田里。", "en": "I walk slowly into the field."},
        {"zh": "我的冠立着。", "en": "My crest is up."},
        {"zh": "我听见田埂那边有动静。", "en": "I hear something stir by the field ridge."},
        {"zh": "田里的东西，归我。", "en": "The field is mine."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗舔过尾羽，我尖叫。", "en": "Flame licks my tail feathers; I shriek."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下来，腿先着地。", "en": "I land on my legs."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进嘴，我拍翅膀。", "en": "Water in my beak; I flap."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我飞了一段。", "en": "The blast throws me a distance."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我胸口。", "en": "Something sticks in my chest."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我羽毛全竖。", "en": "That force raises every feather."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得腿都软。", "en": "Hunger weakens my legs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷一响，我趴下。", "en": "Thunder; I drop."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "地上没东西，我直往下。", "en": "Nothing below; I fall."}
      ]
    }
  }
}
