  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着软步往前", "en": "I pad forward softly."},
        {"zh": "两只长耳朵拖在草上", "en": "My two long ears trail through the grass."},
        {"zh": "我在树根间绕行", "en": "I wind between the roots."},
        {"zh": "我每一步都先试探", "en": "I test the ground before each step."},
        {"zh": "我经过的地方草都弯了", "en": "The grass bends where I pass."},
        {"zh": "我朝你走来的方向去", "en": "I go toward the way you came."},
        {"zh": "我走一步看三次", "en": "I glance thrice at every step."},
        {"zh": "我只跳一小段", "en": "I hop just a short way."},
        {"zh": "我的影子跟着我跳", "en": "My shadow hops along with me."},
        {"zh": "落叶在我脚下很轻", "en": "The fallen leaves whisper under my feet."},
        {"zh": "我沿着树根边蹭过去", "en": "I brush along the tree roots."},
        {"zh": "我慢慢探出脚", "en": "I put a foot out slowly."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
