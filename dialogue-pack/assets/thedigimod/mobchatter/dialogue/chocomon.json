        {"zh": "我的耳朵贴着脑袋", "en": "My ears lie flat on my head."},
        {"zh": "我在听远处的", "en": "I listen to the distance."},
        {"zh": "这片林子我很喜欢", "en": "I like this wood."},
        {"zh": "我的数据很安静", "en": "My data is quiet."},
        {"zh": "我抬头看树叶", "en": "I look up at the leaves."},
        {"zh": "我在等你过来", "en": "I'm waiting for you to come."},
        {"zh": "风把我的耳朵吹起来", "en": "The wind lifts my ears."},
        {"zh": "我眼皮有点沉", "en": "My eyelids feel heavy."},
        {"zh": "我揉了揉眼睛", "en": "I rub my eyes."},
        {"zh": "我数着树影里的光", "en": "I count the lights in the tree shadows."},
        {"zh": "我数树上的光斑", "en": "I count the light spots on the trunk."},
        {"zh": "我慢慢地躺下", "en": "I lie down slowly."},
        {"zh": "有虫子在叫我", "en": "Insects are calling."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走路很轻巧", "en": "You walk lightly."},
        {"zh": "你也是被派来的吗", "en": "Were you sent here too?"},
