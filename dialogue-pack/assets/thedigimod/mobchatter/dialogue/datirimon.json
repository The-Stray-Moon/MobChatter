{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用两只脚走，身体有点重。", "en": "I walk on two feet; my body is a little heavy."},
        {"zh": "肚子先到，脚才跟上。", "en": "My belly arrives before my feet."},
        {"zh": "我走在平原的草里。", "en": "I walk the plains grass."},
        {"zh": "草被我压出一道沟。", "en": "The grass flattens in a furrow behind me."},
        {"zh": "我一步一晃。", "en": "I sway with each step."},
        {"zh": "但我走得稳。", "en": "But I keep my balance."},
        {"zh": "我朝有吃的地方去。", "en": "I walk toward food."},
        {"zh": "林子边缘有很多。", "en": "There is plenty at the forest edge."},
        {"zh": "我停下来看了看。", "en": "I stop and look."},
        {"zh": "我晃晃悠悠地接着走。", "en": "I wobble onward."},
        {"zh": "尾巴拖在身后。", "en": "My tail drags behind."},
        {"zh": "划出一条浅痕。", "en": "Leaving a shallow line."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐着，肚子搁在地上。", "en": "I sit with my belly on the ground."},
        {"zh": "很短的手垂着。", "en": "My stubby arms hang."},
        {"zh": "哈欠打到一半，我忘了。", "en": "Halfway through a yawn, I forget it."},
        {"zh": "合上之后，我又发呆。", "en": "When it closes, I stare again."},
        {"zh": "有蝴蝶落在我头上。", "en": "A butterfly lands on my head."},
        {"zh": "我没有赶它。", "en": "I do not shoo it."},
        {"zh": "它待了很久。", "en": "It stays a long while."},
        {"zh": "它已经飞走。", "en": "It has flown off."},
        {"zh": "蝴蝶停在我鼻尖上。", "en": "A butterfly rests on my nose."},
        {"zh": "太阳晒得我很困。", "en": "The sun makes me sleepy."},
        {"zh": "我的眼睛快闭上了。", "en": "My eyes are nearly shut."},
        {"zh": "但我还醒着。", "en": "But I am still awake."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我仰头瞧你。", "en": "I look up at you."},
        {"zh": "我就坐着，仰头看你。", "en": "I stay seated and look up at you."},
        {"zh": "就那样坐着。", "en": "I just sit."},
        {"zh": "你矮下身子。", "en": "You lower yourself."},
        {"zh": "我们高度差不多。", "en": "We are about level."},
        {"zh": "我伸手碰了碰你的靴尖。", "en": "I reach out and touch your boot tip."},
        {"zh": "我的手太短。", "en": "My arms are too short."},
        {"zh": "你把手伸了过来。", "en": "You reach your hand over."},
        {"zh": "我们的手碰到了。", "en": "Our hands meet."},
        {"zh": "我把它握住。", "en": "I hold it."},
        {"zh": "我没有用力气。", "en": "I use no force."},
        {"zh": "过了一会放开。", "en": "And let go after a while."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得坐倒。", "en": "I am knocked onto my rear."},
        {"zh": "疼得我直吸气。", "en": "I suck in a breath from the pain."},
        {"zh": "我用手撑地。", "en": "I brace with my hands."},
        {"zh": "我扶着地面起身。", "en": "I push up off the ground."},
        {"zh": "身上有一道口子。", "en": "There is a cut on me."},
        {"zh": "我朝下看了看。", "en": "I glance downward."},
        {"zh": "伤口有点湿。", "en": "The cut is a little wet."},
        {"zh": "我用短手护着那道口子。", "en": "I shield the cut with my stubby arms."},
        {"zh": "我还想走走。", "en": "I still want to walk."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这是吃的东西。", "en": "This is food."},
        {"zh": "我立刻站起来。", "en": "I stand up at once."},
        {"zh": "走得太急，差点倒了。", "en": "Too fast, I nearly topple."},
        {"zh": "我站住没倒。", "en": "I keep my feet."},
        {"zh": "走到你面前。", "en": "I come before you."},
        {"zh": "低头闻了闻。", "en": "I lower my head and sniff."},
        {"zh": "然后咬了一口。", "en": "Then bite."},
        {"zh": "它软得像泥。", "en": "It is soft as mud."},
        {"zh": "我整个身子扑向那把饲料。", "en": "I throw my whole body at the feed."},
        {"zh": "我又看了看你。", "en": "I look at you again."},
        {"zh": "你把手摊开。", "en": "You open your hand."},
        {"zh": "手心里空的。", "en": "The palm is empty."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "是不是很软。", "en": "Soft, is it not?"},
        {"zh": "我被撞得往后一坐。", "en": "I sit back from the impact."},
        {"zh": "你伸手扶我。", "en": "You steady me."},
        {"zh": "我抓住你的袖子不松。", "en": "I grip your sleeve and don't let go."},
        {"zh": "你也没有松。", "en": "You do not let go either."},
        {"zh": "草地被我们压平了一块。", "en": "A patch of grass is pressed flat."},
        {"zh": "我们站着没动。", "en": "We stand without moving."},
        {"zh": "哎呀，你踩到我的脚了。", "en": "Oops, you stepped on my foot."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这些事以后再说。", "en": "That can wait."},
        {"zh": "现在我只想吃饱。", "en": "Right now I only want to eat my fill."},
        {"zh": "我坐回草里。", "en": "I sit back in the grass."},
        {"zh": "尾巴绕着身体。", "en": "My tail curls around me."},
        {"zh": "我看着远处。", "en": "I look into the distance."},
        {"zh": "那里有很多吃的。", "en": "There is plenty to eat over there."},
        {"zh": "我还小，这些事不懂。", "en": "I'm too young to understand such things."},
        {"zh": "一走就一晃。", "en": "Swaying as I go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用手抱起来。", "en": "I gather it in my arms."},
        {"zh": "它从手里滑出去。", "en": "It slips out."},
        {"zh": "我又伸手去够。", "en": "I reach again."},
        {"zh": "这次抱住了。", "en": "This time I hold it."},
        {"zh": "我把它抱在肚子上。", "en": "I hug it against my belly."},
        {"zh": "然后就不管了。", "en": "And think no more about it."},
        {"zh": "我坐下来吃。", "en": "I sit down to eat."},
        {"zh": "吃完舔了舔手。", "en": "When done, I lick my hands."},
        {"zh": "我舔了舔手。", "en": "I lick my hands."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在我旁边动。", "en": "Something moves beside me."},
        {"zh": "我把脑袋转过去。", "en": "I turn my head."},
        {"zh": "它并不算大。", "en": "It is not large."},
        {"zh": "我可以试试。", "en": "I can try."},
        {"zh": "我撑着地站了起来。", "en": "I push myself upright."},
        {"zh": "朝它走过去。", "en": "And walk toward it."},
        {"zh": "它站住没动。", "en": "It stays put."},
        {"zh": "我凑到了近前。", "en": "I close right in."},
        {"zh": "我张开大嘴。", "en": "I open my big mouth."},
        {"zh": "我的腮鼓起来。", "en": "My cheeks puff out."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我离它还有几步。", "en": "A few steps between us."},
        {"zh": "我跑得更急。", "en": "I run faster."},
        {"zh": "我跑起来是往前倾的。", "en": "When I run, I lean forward."},
        {"zh": "我差点一头摔倒。", "en": "I nearly toppled over."},
        {"zh": "但我在它面前停住了。", "en": "But I stop in front of it."},
        {"zh": "腮鼓得更满。", "en": "My cheeks swell fuller."},
        {"zh": "水在嘴里打转。", "en": "Water swirls in my mouth."},
        {"zh": "我一口喷出去。", "en": "I spit it out."},
        {"zh": "一串泡飞过去。", "en": "A string of bubbles flies out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "泡打在它身上。", "en": "Bubbles burst on it."},
        {"zh": "它愣了一下。", "en": "It freezes for a moment."},
        {"zh": "我又喷出一串。", "en": "I spit another string."},
        {"zh": "这次打在脸上。", "en": "On the face this time."},
        {"zh": "它往后退去。", "en": "It backs away."},
        {"zh": "我把身体往前倾。", "en": "I lean my body forward."},
        {"zh": "用身体撞它。", "en": "And ram with my body."},
        {"zh": "它被我撞倒。", "en": "It goes down."},
        {"zh": "我的腮又鼓了。", "en": "My cheeks puff again."},
        {"zh": "最后一串泡。", "en": "One last string."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "平原的草动了一下。", "en": "The plains grass stirs."},
        {"zh": "身上沾着草。", "en": "Grass clings to me."},
        {"zh": "草籽沾在我圆背上。", "en": "Grass seeds cling to my round back."},
        {"zh": "我抖掉一半草。", "en": "I shake off half the grass."},
        {"zh": "我四下张望。", "en": "I look all around."},
        {"zh": "林子、平原、草地。", "en": "Forest, plains, meadow."},
        {"zh": "都是我能走的。", "en": "All of it is mine to walk."},
        {"zh": "我朝林子去。", "en": "I head for the trees."},
        {"zh": "那里有吃的。", "en": "There is food there."},
        {"zh": "肚子已经在叫了。", "en": "My stomach is already growling."},
        {"zh": "我的步子变快了。", "en": "My steps quicken."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的皮肤，我跳起来。", "en": "Fire singes my skin; I jump."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下去，肚子先着地。", "en": "I fall, belly first."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进嘴里，我乱划。", "en": "Water fills my mouth; I paddle wildly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我滚了两圈。", "en": "The blast rolls me twice."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西钉进我的肩膀。", "en": "It lodges in my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我动作变慢。", "en": "A cold slows my movements."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得连草都吃。", "en": "Hungry enough to eat grass."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我抱住头。", "en": "Lightning strikes; I cover my head."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没有草。", "en": "No grass underfoot."}
      ]
    }
  }
}
