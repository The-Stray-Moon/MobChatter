{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步压过沙地。", "en": "I press across the sand, step by step."},
        {"zh": "金属的爪陷进土里。", "en": "My metal claws sink into the soil."},
        {"zh": "我的身体比树还高。", "en": "I stand taller than the trees."},
        {"zh": "锯齿的牙一直露在外面。", "en": "My sawblade teeth stay bared."},
        {"zh": "我从恶地走进针叶林。", "en": "I walk from the badlands into the conifers."},
        {"zh": "我的脚步把石头碾碎。", "en": "My steps grind the stones."},
        {"zh": "尾巴在身后左右摆。", "en": "My tail swings behind me."},
        {"zh": "我在林子里横着走。", "en": "I move sideways between the trees."},
        {"zh": "我的关节有节律地响。", "en": "My joints click in rhythm."},
        {"zh": "背上的甲片互相摩擦。", "en": "The plates on my back grind together."},
        {"zh": "我绕开一棵大树。", "en": "I walk around a big tree."},
        {"zh": "我停在林子边上。", "en": "I stop at the forest's edge."},
        {"zh": "我踩倒了一排灌木。", "en": "I flatten a row of bushes."},
        {"zh": "我的头在肩上转半圈。", "en": "My head swivels half a turn."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，嘴半张着。", "en": "Standing, my jaws half open."},
        {"zh": "我低低地嗡鸣。", "en": "I hum low."},
        {"zh": "金属上的锈在剥落。", "en": "Rust flakes off the metal."},
        {"zh": "等有东西靠近，比如你。", "en": "Waiting for something to come close. Like you."},
        {"zh": "我的牙还在慢慢转动。", "en": "My teeth keep turning slowly."},
        {"zh": "热量从我背上的甲散出。", "en": "Heat vents from my back plates."},
        {"zh": "我的眼睛亮得很稳。", "en": "My eyes glow steadily."},
        {"zh": "这里的风里带着沙，磨甲。", "en": "The wind here carries sand — it scours armor."},
        {"zh": "我一动，甲片就响。", "en": "When I move, the plates clang."},
        {"zh": "我的燃料还很充足。", "en": "I still have plenty of fuel."},
        {"zh": "我闻不到东西。", "en": "I can't smell anything."},
        {"zh": "我在计算路线。", "en": "I'm calculating a route."},
        {"zh": "我的步子在这里太沉。", "en": "My steps are too heavy here."},
        {"zh": "我的下巴慢慢垂下来。", "en": "My jaw slowly drops open."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你就站在我的脚边。", "en": "You're standing right at my feet."},
        {"zh": "铁皮下的热气，你感觉到了。", "en": "You feel the heat under my iron hide."},
        {"zh": "你站在那里不动。", "en": "You're standing still."},
        {"zh": "我的牙可以咬穿石头。", "en": "My teeth can bite through stone."},
        {"zh": "你身上没有一点金属。", "en": "There's no metal on you."},
        {"zh": "我不介意你走开。", "en": "I wouldn't mind if you left."},
        {"zh": "你的声音我听得很清。", "en": "I hear you clearly."},
        {"zh": "我的影子能把你的遮住。", "en": "My shadow can swallow yours."},
        {"zh": "我一步跨三格。", "en": "One stride covers three blocks."},
        {"zh": "你要不要退几步。", "en": "Would you like to step back?"},
        {"zh": "我的温度很高。", "en": "My temperature is high."},
        {"zh": "我一身金属，沉得很。", "en": "All metal, and heavy."},
        {"zh": "你站得离我的爪子很近。", "en": "You're standing very near my claws."},
        {"zh": "我低头才能看清你。", "en": "I have to lower my head to see you."},
        {"zh": "你没有躲，这很少见。", "en": "You didn't hide. That's rare."},
        {"zh": "我的影子足够把你盖住。", "en": "My shadow is enough to cover you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "一块甲片被打掉。", "en": "A plate got knocked loose."},
        {"zh": "我的牙停了一下。", "en": "My teeth stalled for a moment."},
        {"zh": "我向后退了半步。", "en": "I gave half a step back."},
        {"zh": "齿轮咬合错了一格。", "en": "A gear skipped a tooth."},
        {"zh": "我的金属膝盖响了一下。", "en": "My metal knee clanks once."},
        {"zh": "装甲还有很大余量。", "en": "The armor has margin left."},
        {"zh": "我仍然能站着。", "en": "I can still stand."},
        {"zh": "我的眼睛还在亮。", "en": "My eyes are still lit."},
        {"zh": "这一记砸穿了一片甲。", "en": "That punch pierced a plate."},
        {"zh": "我的表皮已经换成金属。", "en": "My hide has turned to metal."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我平常只吃金属。", "en": "I normally eat only metal."},
        {"zh": "这块铁太硬，我咬不烂。", "en": "This iron is too hard to chew."},
        {"zh": "铁块的话还可以。", "en": "An iron block would be acceptable."},
        {"zh": "你手里有铁吗？", "en": "Any iron in your hand?"},
        {"zh": "食物对机械没用。", "en": "Food is no use to a machine."},
        {"zh": "我要的是硬的东西。", "en": "I want something hard."},
        {"zh": "这个东西实在是太软。", "en": "This thing is far too soft."},
        {"zh": "拿来给我试试。", "en": "Bring it here and let me try."},
        {"zh": "我的牙不是用来吃草的。", "en": "My teeth aren't made for grass."},
        {"zh": "这个东西有金属味。", "en": "That thing has a metal smell."},
        {"zh": "硬的东西我才咬得动。", "en": "Only hard things are worth biting."},
        {"zh": "你把铁拿来我就吃。", "en": "Bring me iron and I'll eat."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "金属的皮肤，撞上去会响。", "en": "Hit metal skin and it rings."},
        {"zh": "你撞在我胸口像撞墙。", "en": "You hit my chest like a wall."},
        {"zh": "我太重了，别贴。", "en": "I'm too heavy. Don't press close."},
        {"zh": "别靠着我肚子站。", "en": "Don't stand against my belly."},
        {"zh": "你踩到了我的爪。", "en": "You stepped on my claw."},
        {"zh": "我停下，等你过去。", "en": "I stop and wait for you."},
        {"zh": "我挪开半步避开。", "en": "I shift half a step aside."},
        {"zh": "这一下把土都震起来。", "en": "That shook the soil up."},
        {"zh": "我的尾巴要过来了。", "en": "My tail is coming."},
        {"zh": "这里的路太窄。", "en": "This path is too narrow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是机械，没有这个。", "en": "I'm a machine. I have none of that."},
        {"zh": "这不在我的数据里。", "en": "That isn't in my data."},
        {"zh": "我只会打打杀杀。", "en": "All I know is fighting."},
        {"zh": "这些事我没有想过。", "en": "I haven't thought about such things."},
        {"zh": "这不是我会想的事。", "en": "That's not something I'd consider."},
        {"zh": "我掉头走进林子。", "en": "I turn into the trees."},
        {"zh": "我只有一个任务。", "en": "I have exactly one task."},
        {"zh": "这具身体是被造出来的。", "en": "This body was manufactured."},
        {"zh": "这问题我解析不出来。", "en": "I can't parse that question."},
        {"zh": "金属巨龙的角，转向一边。", "en": "The metal tyrannosaur's horn turns away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用两根爪子夹起它。", "en": "I pinch it between two claws."},
        {"zh": "这块铁值得留下。", "en": "This iron is worth keeping."},
        {"zh": "我把它咬成了两半。", "en": "I bit it in two."},
        {"zh": "不是金属，我丢了。", "en": "Not metal. I dropped it."},
        {"zh": "这个连爪子缝都塞不满。", "en": "Not even a claw's gap full."},
        {"zh": "它比我爪子还小。", "en": "It's smaller than my claw."},
        {"zh": "我把这块收起来。", "en": "I'll keep this piece."},
        {"zh": "泥巴从我爪缝里挤出来。", "en": "Mud squeezes out between my claws."},
        {"zh": "这个东西对我没用。", "en": "This is no use to me."},
        {"zh": "我用爪子把它按进泥里。", "en": "I press it into the mud with my claw."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标已经锁定了。", "en": "The target is locked."},
        {"zh": "我的眼睛测到了热源。", "en": "My eyes caught a heat source."},
        {"zh": "我开始朝它走过去。", "en": "I'm starting toward it."},
        {"zh": "这个距离我两步就到。", "en": "Two steps covers this."},
        {"zh": "我的牙开始转了。", "en": "My teeth have started turning."},
        {"zh": "它比我小得多。", "en": "It's far smaller than me."},
        {"zh": "我的眼睛已经对准。", "en": "My eyes are fixed."},
        {"zh": "我的步子一下下变重。", "en": "My steps grow heavier one by one."},
        {"zh": "沙地上一览无余。", "en": "The sand gives no cover."},
        {"zh": "我把它逼到林子边。", "en": "I'm driving it toward the treeline."},
        {"zh": "我的尾巴挡住了退路。", "en": "My tail blocks the retreat."},
        {"zh": "它还在低头挖沙。", "en": "It's still digging in the sand."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它现在还在前面。", "en": "It's still ahead right now."},
        {"zh": "我踩碎挡路的石头。", "en": "I crush the stones in my path."},
        {"zh": "它躲到了倒木后面。", "en": "It's hidden behind a fallen log."},
        {"zh": "我转过身，铁尾扫过草。", "en": "I turn and my iron tail sweeps the grass."},
        {"zh": "我的脚把树根踩断了。", "en": "My feet snap the roots."},
        {"zh": "这个角度我占着优势。", "en": "I hold the advantage here."},
        {"zh": "它躲到石头后面去。", "en": "It's hiding behind the rock."},
        {"zh": "我踩着灌木从侧面绕。", "en": "I trample the brush and swing wide."},
        {"zh": "它的速度比我快。", "en": "It's faster than I am."},
        {"zh": "我压根不需要快。", "en": "I don't need speed at all."},
        {"zh": "我已经把路堵死了。", "en": "I've sealed the path."},
        {"zh": "再靠近一点我就扑。", "en": "A little closer and I pounce."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "爪子落处土石飞起来。", "en": "Earth and stone fly where my claw lands."},
        {"zh": "牙咬穿了护甲。", "en": "My teeth bit through armor."},
        {"zh": "我低头用铁下巴撞你。", "en": "I lower my iron jaw and ram you."},
        {"zh": "你已经被掀翻了。", "en": "You've been knocked over."},
        {"zh": "尾巴扫中了你。", "en": "My tail caught you."},
        {"zh": "我的爪子擦着地。", "en": "My claws scrape the ground."},
        {"zh": "整个身体的重量压下来。", "en": "The whole body's weight comes down."},
        {"zh": "我一口咬住你的护甲。", "en": "I clamp my jaws on your armor."},
        {"zh": "这一爪把树干撕开。", "en": "This claw tears the trunk open."},
        {"zh": "铁牙一合，火星溅出来。", "en": "My iron teeth snap, throwing sparks."},
        {"zh": "我把它顶在树干上。", "en": "I pin it against the tree trunk."},
        {"zh": "我退开重整架势。", "en": "I pull back and reset."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "沙土从我背上滑下去。", "en": "Sand slides off my back."},
        {"zh": "我的头先穿出树线。", "en": "My head breaks the treeline first."},
        {"zh": "金属在阳光下很亮。", "en": "The metal is bright in the sun."},
        {"zh": "我的牙开始转动。", "en": "My teeth begin to turn."},
        {"zh": "这里的树对我来说太矮。", "en": "These trees are too short for me."},
        {"zh": "我踩实了脚下的地。", "en": "I set my feet firmly."},
        {"zh": "我的系统开始运转。", "en": "My systems come online."},
        {"zh": "甲片一片片合上。", "en": "My plates close up one by one."},
        {"zh": "我扫视了四周。", "en": "I swept the surroundings."},
        {"zh": "地上的石子被震起来。", "en": "Pebbles jump off the ground."},
        {"zh": "我开始往前走了。", "en": "I've started moving."},
        {"zh": "远处有东西在叫。", "en": "Something is calling far off."},
        {"zh": "我的温度一点点上来。", "en": "My temperature rises slowly."},
        {"zh": "我找到了方向。", "en": "I've found my direction."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温让我的甲片变形。", "en": "The heat warped my plating."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我重重落地，腿震了一下。", "en": "I landed hard and my leg jarred."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进甲缝，我动得慢了。", "en": "Water in my seams. I move slower."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸只让我横移半步。", "en": "The blast only shifts me half a step."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭头卡在我肋骨缝里。", "en": "The arrowhead is stuck between my ribs."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股能量搅乱了我的系统。", "en": "That energy scrambled my systems."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我很久没有吃到金属了。", "en": "I haven't had metal in a long while."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的甲片跑。", "en": "Lightning ran across my plates."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我这体重也留不住。", "en": "Even this weight can't hold me."}
      ]
    }
  }
}
