{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在沼泽边上慢慢走。", "en": "I walk slowly along the swamp edge."},
        {"zh": "我的身体圆，腿很短。", "en": "My body is round, my legs short."},
        {"zh": "身上有一层金属的光。", "en": "A metallic sheen lies over me."},
        {"zh": "我的脚陷下去，又拔出来。", "en": "My feet sink and pull free."},
        {"zh": "泥没到我的脚踝。", "en": "It reaches my ankles."},
        {"zh": "我拔出来，又踩下去。", "en": "I pull free and step again."},
        {"zh": "有股味道，我很喜欢。", "en": "There is a smell I like."},
        {"zh": "我一身白金，很显眼。", "en": "Platinum all over, hard to miss."},
        {"zh": "路上有块烂木头。", "en": "A rotten log on the way."},
        {"zh": "我从上面跨过去。", "en": "I step over it."},
        {"zh": "烂木头塌了。", "en": "It collapses."},
        {"zh": "我的脚步没停。", "en": "My feet have not stopped."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，慢慢吞着气。", "en": "I stand and breathe slowly."},
        {"zh": "我的肚子很圆。", "en": "My belly is round."},
        {"zh": "金属的光在泥上反着。", "en": "The sheen plays on the mud."},
        {"zh": "这里有苍蝇。", "en": "There are flies here."},
        {"zh": "它们绕着我飞。", "en": "They circle me."},
        {"zh": "我不去赶它们。", "en": "I do not shoo them."},
        {"zh": "它们是冲着味道来的。", "en": "They come for the smell."},
        {"zh": "我不放在心上。", "en": "I do not take it to heart."},
        {"zh": "泥浆从我背上滑下来。", "en": "Mud slides off my back."},
        {"zh": "泥里冒了一个泡。", "en": "A bubble breaks in the mud."},
        {"zh": "我垂眼看了看它。", "en": "I look down at it."},
        {"zh": "我闻了闻风，又低下头。", "en": "I sniff the wind, then lower my head."},
        {"zh": "这个地方很好。", "en": "This place is good."},
        {"zh": "我在沼泽里从不着急。", "en": "I am never hurried in a swamp."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你捂着鼻子走过来。", "en": "You come over covering your nose."},
        {"zh": "我并不怨你。", "en": "I do not blame you."},
        {"zh": "我自己也知道。", "en": "I know it myself."},
        {"zh": "我挪近了小小一步。", "en": "I take one small step nearer."},
        {"zh": "你又往后退了。", "en": "You step back."},
        {"zh": "我把脚停下来。", "en": "I stop."},
        {"zh": "这样就差不多了。", "en": "That will do."},
        {"zh": "我正瞧着你。", "en": "I look at you."},
        {"zh": "你捂着鼻子，我看得见。", "en": "You're covering your nose. I can see."},
        {"zh": "中间隔着一片泥。", "en": "A stretch of mud in between."},
        {"zh": "我们就这样待着。", "en": "So we stay."},
        {"zh": "谁都没有靠近。", "en": "Neither closing."},
        {"zh": "这样也还成。", "en": "Bearable."},
        {"zh": "我慢慢地坐下。", "en": "I sit down slowly."},
        {"zh": "泥被压出一个坑。", "en": "The mud takes a hollow."},
        {"zh": "白金的样子，味道照旧。", "en": "Platinum looks, same smell."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "白金的身子晃了晃，站稳了。", "en": "My platinum body sways, then steadies."},
        {"zh": "身上的泥掉了一块。", "en": "A clod of mud falls off."},
        {"zh": "底下露出金属的光。", "en": "Metal shows beneath."},
        {"zh": "我又把它蹭上。", "en": "I smear it back on."},
        {"zh": "厚厚的泥替我挡了一下。", "en": "The thick mud took part of the blow."},
        {"zh": "这一下不太疼。", "en": "That did not hurt much."},
        {"zh": "我吃的东西你不想知道。", "en": "You don't want to know what I eat."},
        {"zh": "我一点点往前。", "en": "I inch forward."},
        {"zh": "泥还在身上。", "en": "The mud is still here."},
        {"zh": "那我也还在。", "en": "And so am I."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是新鲜的粪便。", "en": "That is fresh dung."},
        {"zh": "我闻到就走过去了。", "en": "I smell it and walk over."},
        {"zh": "这味儿，隔着沙子我都闻到。", "en": "I smell that even through the sand."},
        {"zh": "闻着很新鲜。", "en": "Very fresh."},
        {"zh": "我张嘴就吃。", "en": "I open my mouth and eat."},
        {"zh": "我一口就吞了下去。", "en": "I swallow it in one gulp."},
        {"zh": "你背过身去了。", "en": "You've turned your back."},
        {"zh": "我没有理你。", "en": "I pay you no mind."},
        {"zh": "吃完我抬起头。", "en": "When I finish I look up."},
        {"zh": "你掌里还剩些。", "en": "There is more in your palm."},
        {"zh": "你的口袋有股好味道。", "en": "Your pocket smells good."},
        {"zh": "你退了两步远。", "en": "You back two steps off."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，像撞到一个桶。", "en": "You strike me like a barrel."},
        {"zh": "我摇晃了几下。", "en": "I rock."},
        {"zh": "泥从身上掉下来。", "en": "Mud falls off me."},
        {"zh": "你踩到我，我身上沾着粪土。", "en": "You step on me, and I am caked in dung."},
        {"zh": "慢慢站稳，脚底发亮。", "en": "Steadying myself, my feet gleaming."},
        {"zh": "身上还有一些泥。", "en": "There is still mud on me."},
        {"zh": "我没有去擦。", "en": "I do not wipe it."},
        {"zh": "留着还更好些。", "en": "Better to keep it."},
        {"zh": "我照旧往前挪。", "en": "I walk as before."},
        {"zh": "你从另一边绕开。", "en": "You go around the other side."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽深处还有一只。", "en": "There is another deep in the swamp."},
        {"zh": "那味道很重。", "en": "A strong smell."},
        {"zh": "我朝那边挪去。", "en": "I shuffle that way."},
        {"zh": "它也朝我这边来。", "en": "It comes toward me too."},
        {"zh": "我们在泥里碰上。", "en": "We meet in the mud."},
        {"zh": "我们彼此嗅了嗅。", "en": "We sniff at each other."},
        {"zh": "然后一起低头吃。", "en": "Then lower our heads and eat together."},
        {"zh": "这一片地上有得是。", "en": "There is plenty on this ground."},
        {"zh": "够我们两个吃很久。", "en": "Enough for two of us a long while."},
        {"zh": "入夜我们仍未走。", "en": "By nightfall we have not left."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我垂眼看了看。", "en": "I glance down at it."},
        {"zh": "我把它埋进粪堆。", "en": "I bury it in the dung heap."},
        {"zh": "然后又挖出来。", "en": "And dig it out."},
        {"zh": "不合我的口味。", "en": "Not to my taste."},
        {"zh": "我捧起来闻了闻，舍不得放。", "en": "I scoop it up, sniff it, and will not let go."},
        {"zh": "它滚进泥水里。", "en": "It rolls into the muddy water."},
        {"zh": "它已经沉下去。", "en": "It sinks."},
        {"zh": "我瞧它沉到底。", "en": "I watch it settle."},
        {"zh": "随后我抬起头来。", "en": "Then raise my head."},
        {"zh": "泥里还有别的。", "en": "There is more in the mud."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽冒了个泡，我盯住。", "en": "A bubble rose in the swamp; I'm watching."},
        {"zh": "白金的我，扔的东西也不干净。", "en": "Platinum, though what I throw isn't clean."},
        {"zh": "是只小小野兽。", "en": "A small creature."},
        {"zh": "它正在喝水。", "en": "It is drinking."},
        {"zh": "前面那坨，我一眼就看上了。", "en": "That pile ahead, I want it at once."},
        {"zh": "泥让我走得很慢。", "en": "The mud makes me slow."},
        {"zh": "它听出了动静。", "en": "It catches the sound."},
        {"zh": "它把头像扬起来。", "en": "It raises its head."},
        {"zh": "我不紧不慢地走。", "en": "I walk without hurrying."},
        {"zh": "它扭头就跑。", "en": "It turns and bolts."},
        {"zh": "我追了两步远。", "en": "I give two steps of chase."},
        {"zh": "太重了，跑不动。", "en": "I am too heavy to run."},
        {"zh": "我把脚收住了。", "en": "I check my step."},
        {"zh": "看着它跑远去。", "en": "And watch it go."},
        {"zh": "随后我回头走。", "en": "Then I turn back."},
        {"zh": "水面下有什么在动。", "en": "Something's moving under the water."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的眼睛不曾离开它。", "en": "My eyes never leave it."},
        {"zh": "它在泥边上跳。", "en": "It hops at the mud's edge."},
        {"zh": "我盯着它，慢慢挪。", "en": "Eyes fixed, I shuffle slowly."},
        {"zh": "这里的泥很黏。", "en": "The mud is sticky."},
        {"zh": "拔出来，再踩下去，一直走。", "en": "Pull free, step down, keep going."},
        {"zh": "它没有走太远。", "en": "It has not gone far."},
        {"zh": "它在找东西吃。", "en": "It is looking for food."},
        {"zh": "我一步一步挪着靠近。", "en": "I shuffle closer, step by step."},
        {"zh": "它把眼睛抬起。", "en": "It lifts its eyes."},
        {"zh": "我立刻就定住。", "en": "I stop dead."},
        {"zh": "它把头垂下去。", "en": "It lowers its head."},
        {"zh": "我挪到它的下风口。", "en": "I move downwind of it."},
        {"zh": "近得能数清毛。", "en": "Close enough to count hairs."},
        {"zh": "我蹲好架子，手里捏着一团。", "en": "I set my stance, a lump ready in my hand."},
        {"zh": "它把身子转过来。", "en": "It turns its body."},
        {"zh": "机会就在这一刻。", "en": "The chance is now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我整个压过去。", "en": "I throw my whole bulk on it."},
        {"zh": "它被压在下面。", "en": "It is pinned beneath."},
        {"zh": "我滚过去，压住它。", "en": "I roll over and pin it."},
        {"zh": "我的尾巴拍在它身上。", "en": "My tail slaps down on it."},
        {"zh": "我伏下身去看它。", "en": "I lower myself to look at it."},
        {"zh": "然后我开始吃。", "en": "Then begin to eat."},
        {"zh": "我慢条斯理地吃。", "en": "I eat without haste."},
        {"zh": "我拍下去，泥浆四溅。", "en": "I slam down and mud sprays."},
        {"zh": "苍蝇又聚过来。", "en": "The flies return."},
        {"zh": "这次更多了。", "en": "More than before."},
        {"zh": "我抬起沾泥的爪子。", "en": "I raise a mud-caked claw."},
        {"zh": "吃完我坐下来。", "en": "When I finish I sit down."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从泥里拱出来。", "en": "I push up out of the mud."},
        {"zh": "身上全是黑的泥。", "en": "Black mud all over me."},
        {"zh": "我把浑身的泥抖开。", "en": "I shake the mud off."},
        {"zh": "掉下来一些泥。", "en": "Some of it comes off."},
        {"zh": "这里是一片沼泽。", "en": "This is a swamp."},
        {"zh": "水很浅，泥很深。", "en": "Shallow water, deep mud."},
        {"zh": "我慢慢走了两步。", "en": "I take two slow steps."},
        {"zh": "我踩出一串深脚印。", "en": "I leave a trail of deep prints."},
        {"zh": "这里正合我用。", "en": "Just the thing."},
        {"zh": "粪堆的味道，让我安心。", "en": "The smell of the dung heap settles me."},
        {"zh": "有粪便的味道。", "en": "Dung on the air."},
        {"zh": "白金便兽，挪向那边。", "en": "PlatinumScumon shifts that way."},
        {"zh": "我从粪堆后转出来。", "en": "I come around from behind the dung heap."},
        {"zh": "但我总会到的。", "en": "But I always arrive."},
        {"zh": "泥地一直延伸过去。", "en": "The mudflat runs on that way."},
        {"zh": "我从粪堆里钻出来，抖了抖。", "en": "I climb out of the dung heap and shake myself."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到我的泥壳，味道更难闻了。", "en": "Fire reaches my mud casing and the stink grows worse."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，压塌了一片泥岸。", "en": "I roll down the slope and crush a bank of mud."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过头，我拼命往上游。", "en": "Water covers me; I strain upward."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸响把我掀翻，泥溅得到处都是。", "en": "A blast throws me over and mud sprays everywhere."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进我厚厚的皮。", "en": "An arrow sinks into my thick hide."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光把我按在泥里。", "en": "Light presses me into the mud."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "好久没吃到，我越来越轻。", "en": "Nothing to eat for a long while, and I grow lighter."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下，我浑身一僵。", "en": "Lightning falls and my whole body locks."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽没了，我在黑里坠。", "en": "The swamp is gone and I fall through black."}
      ]
    }
  }
}
