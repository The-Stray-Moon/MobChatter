{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一摇一晃地走过沼泽。", "en": "I waddle across the swamp."},
        {"zh": "我的身体是一团软泥。", "en": "My body is a lump of soft muck."},
        {"zh": "我身上沾着草和粪。", "en": "I'm stuck with grass and droppings."},
        {"zh": "我每一步都留下一个湿印。", "en": "Every step leaves a wet print."},
        {"zh": "我的脚下有气泡冒上来。", "en": "Bubbles rise under my feet."},
        {"zh": "我沿着泥水边挪。", "en": "I shift along the muddy edge."},
        {"zh": "我的头顶冒着一点气。", "en": "A little steam rises off my head."},
        {"zh": "我走得不快，黏得走不快。", "en": "I'm slow; the muck holds me."},
        {"zh": "我拖着一截草根。", "en": "I drag a bit of root."},
        {"zh": "我的身体在慢慢变形。", "en": "My body slowly changes shape."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站成一团。", "en": "I stand as a lump."},
        {"zh": "我身上的气泡破了。", "en": "A bubble on me pops."},
        {"zh": "我在嗅空气。", "en": "I'm sniffing the air."},
        {"zh": "软泥从我的肩上滑下来。", "en": "Muck slides off my shoulder."},
        {"zh": "我听到了水声。", "en": "I hear water."},
        {"zh": "我的身体里有点响。", "en": "Something rumbles inside me."},
        {"zh": "屎兽在泥里打了个滚。", "en": "The Scumon rolls in the mud."},
        {"zh": "我没有骨头。", "en": "I have no bones."},
        {"zh": "我在等一顿好饭。", "en": "I'm waiting for a good meal."},
        {"zh": "我的形状又变了。", "en": "My shape changed again."},
        {"zh": "黑森林的落叶，盖住我的头。", "en": "Black forest leaves cover my head."},
        {"zh": "脚下的泥在吸我。", "en": "The mud pulls at my feet."},
        {"zh": "沼气泡泡冒出来，臭得很。", "en": "Swamp bubbles rise, reeking."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站得很干净。", "en": "You're standing very clean."},
        {"zh": "我身上有味道，我知道。", "en": "I smell, I know."},
        {"zh": "我扭过身子。", "en": "I turn my body."},
        {"zh": "我没打算伤害你。", "en": "I don't mean to hurt you."},
        {"zh": "你捂着鼻子，我看见了。", "en": "I see you covering your nose."},
        {"zh": "我闻到你的手。", "en": "I smell your hands."},
        {"zh": "我在这里很自在。", "en": "I'm comfortable here."},
        {"zh": "你不介意吧？", "en": "You don't mind, do you?"},
        {"zh": "我知道我臭。", "en": "I know I stink."},
        {"zh": "我还是想靠近。", "en": "I still want to come near."},
        {"zh": "你手上带着什么。", "en": "You've got something there."},
        {"zh": "要帮我收粪吗？我有的是。", "en": "Care to help with the dung? I have plenty."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "泥从我身上流下来。", "en": "Muck runs off me."},
        {"zh": "我退了几步。", "en": "I shuffle back a few steps."},
        {"zh": "我没有骨头可以疼。", "en": "I have no bones to hurt."},
        {"zh": "我晃了两三下。", "en": "I wobble two or three times."},
        {"zh": "我又慢慢鼓回来。", "en": "I bulge back out slowly."},
        {"zh": "粪团被拍扁，我有点恼。", "en": "My dung ball is squashed; I am annoyed."},
        {"zh": "我一摇一晃走开。", "en": "I wobble away."},
        {"zh": "粪弹还没扔呢……疼。", "en": "Haven't even thrown my poop yet… ow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有粪便的味道！", "en": "That smells like dung!"},
        {"zh": "有屎？我马上到。", "en": "Dung? I am on my way."},
        {"zh": "我浑身是泥，别嫌我臭。", "en": "I'm all mud; don't mind the stink."},
        {"zh": "我一晃一晃过去。", "en": "I waddle over."},
        {"zh": "我等这一顿很久。", "en": "I've waited long for this."},
        {"zh": "这味道太好了。", "en": "That smell is wonderful."},
        {"zh": "泥下还埋着吗？", "en": "Is there more under the muck?"},
        {"zh": "粪便的香味，让我挪不动。", "en": "The smell of dung roots me in place."},
        {"zh": "我多谢谢你了。", "en": "Thank you very much."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞进一团泥。", "en": "You hit a lump of muck."},
        {"zh": "我身子凹进去一块。", "en": "My body dents."},
        {"zh": "你身上沾到了泥。", "en": "You got muck on you."},
        {"zh": "撞这么一下，不痛不痒。", "en": "A bump like that is nothing."},
        {"zh": "我没有挪远。", "en": "I haven't moved far."},
        {"zh": "别踩，这里刚施过肥。", "en": "Mind your step. Fresh fertilizer here."},
        {"zh": "你撞散我的粪堆了。", "en": "You scattered my dung pile."},
        {"zh": "重量级对撞，我赢。", "en": "Heavyweight collision. I win."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "泥里还有一团。", "en": "There's another lump in the mud."},
        {"zh": "她矮我一头。", "en": "She's a head shorter."},
        {"zh": "泥混成一团。", "en": "Our muck merges."},
        {"zh": "她分走了一半。", "en": "She took half."},
        {"zh": "我们又分开。", "en": "We separate again."},
        {"zh": "她朝水里去。", "en": "She heads for the water."},
        {"zh": "我跟着她挪。", "en": "I shuffle after her."},
        {"zh": "一格的成熟体，只吃粪便。", "en": "A one-block Adult that eats only dung."},
        {"zh": "泥里都是气泡。", "en": "Bubbles everywhere in the mud."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用身体包住它。", "en": "I wrap my body around it."},
        {"zh": "我慢慢消化。", "en": "I digest it slowly."},
        {"zh": "这块是野草。", "en": "This is wild grass."},
        {"zh": "我把它拱到泥里。", "en": "I root it into the mud."},
        {"zh": "有块石头在里面。", "en": "There's a stone in it."},
        {"zh": "我用身体包住它，它陷进去了。", "en": "I fold my body around it and it sinks in."},
        {"zh": "这块粪，我能吃上一整天。", "en": "This dung will feed me all day."},
        {"zh": "我抱着它，谁也不给。", "en": "I hug it and share with no one."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢转过去，手里的东西抬着。", "en": "I turn slowly, the lump in my hand raised."},
        {"zh": "我身上的泥滴下来。", "en": "Muck drips off me."},
        {"zh": "我想靠近一点。", "en": "I want to come closer."},
        {"zh": "我的气在往上冒。", "en": "Steam rises off me."},
        {"zh": "这次我不怕。", "en": "I'm not afraid this time."},
        {"zh": "我想试一试。", "en": "I want to try."},
        {"zh": "它往后退开了。", "en": "It backed away."},
        {"zh": "我随后跟着。", "en": "I follow after."},
        {"zh": "我走得慢了。", "en": "I've slowed down."},
        {"zh": "它已经跑远。", "en": "It has run far."},
        {"zh": "我只好停住了。", "en": "I had to stop."},
        {"zh": "我只好继续找。", "en": "I'll keep looking."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着那个味道。", "en": "I follow the smell."},
        {"zh": "我走得黏黏的。", "en": "My steps stick."},
        {"zh": "它绕过了水洼。", "en": "It went round the puddle."},
        {"zh": "我直接从中间过。", "en": "I go straight through."},
        {"zh": "泥顺着我往下淌。", "en": "Muck runs down me."},
        {"zh": "它朝后看了一眼。", "en": "It looked over its shoulder."},
        {"zh": "大便投掷，我准备了。", "en": "The Poop Throw is ready."},
        {"zh": "它跑得比我快一步。", "en": "It runs one step faster than me."},
        {"zh": "我在它后头。", "en": "I'm behind it."},
        {"zh": "我还闻得到。", "en": "I can still smell it."},
        {"zh": "水声盖住了脚步。", "en": "Water covers the footsteps."},
        {"zh": "沼泽的泥，粘在我的屁股。", "en": "Swamp mud sticks to my rear."},
        {"zh": "它停在树边。", "en": "It stopped by a tree."},
        {"zh": "我推着粪团，一步步靠近。", "en": "I push my dung ball and close in step by step."},
        {"zh": "它没有再跑。", "en": "It didn't run again."},
        {"zh": "我举起一条胳膊。", "en": "I lift an arm."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把一团东西丢出去。", "en": "I fling a lump of it."},
        {"zh": "它被我砸中了。", "en": "It got hit."},
        {"zh": "我又丢了一团。", "en": "I throw another."},
        {"zh": "它捂住脸退开。", "en": "It covers its face and backs off."},
        {"zh": "我慢慢追过去。", "en": "I shuffle after it."},
        {"zh": "我身上的泥甩出去了。", "en": "Muck flies off me."},
        {"zh": "它跑得很远了。", "en": "It got far away."},
        {"zh": "我没有追到。", "en": "I didn't catch it."},
        {"zh": "我回到泥里。", "en": "I go back to the mud."},
        {"zh": "我泡了一会儿。", "en": "I soak a while."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽里多了一团圆的东西。", "en": "A lumpy shape appears in the swamp."},
        {"zh": "泥从我的头上淌下来。", "en": "Muck runs down my head."},
        {"zh": "气泡在我身边破。", "en": "Bubbles pop around me."},
        {"zh": "我抖落一身沼泥，臭气散开。", "en": "I shake off swamp mud and the stench spreads."},
        {"zh": "这里味道不错。", "en": "This place smells good."},
        {"zh": "我从泥里撑起来。", "en": "I push up from the muck."},
        {"zh": "我往泥洼那边去。", "en": "I shuffle toward the wallow."},
        {"zh": "我一步一陷。", "en": "Every step sinks."},
        {"zh": "我闻到了粪便的味。", "en": "I smell dung."},
        {"zh": "我一摇一晃，开始找吃的。", "en": "I wobble along and start looking for food."},
        {"zh": "这里没有人打扰。", "en": "Nobody bothers me here."},
        {"zh": "从沼泽里爬出来，满身泥。", "en": "I crawl out of the swamp, caked in mud."},
        {"zh": "我的身体里在响。", "en": "Something rumbles in my body."},
        {"zh": "我收住脚听。", "en": "I stop to listen."}
      ]
    },
