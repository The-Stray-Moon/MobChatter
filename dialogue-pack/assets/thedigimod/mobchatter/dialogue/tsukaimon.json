    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "肚子空了，我飞得歪歪斜斜。", "en": "My belly is empty, and I fly unsteadily."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声把我吓得往树里钻。", "en": "The thunder sent me into the trees."}
      ]
    }
  }
