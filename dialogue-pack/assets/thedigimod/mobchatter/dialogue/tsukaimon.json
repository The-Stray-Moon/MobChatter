{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拍着翅膀往前飞。", "en": "I beat my wings and fly on."},
        {"zh": "小身子在空中一晃。", "en": "My small body rocks in the air."},
        {"zh": "我落在树杈上。", "en": "I land on a branch."},
        {"zh": "我贴着树梢滑过去。", "en": "I glide just above the treetops."},
        {"zh": "我扇两下，停一下。", "en": "Two flaps, then a pause."},
        {"zh": "我绕开一枝横枝。", "en": "I swerve around a branch."},
        {"zh": "我飘得很轻。", "en": "I drift very lightly."},
        {"zh": "我跟在你后面飞。", "en": "I fly along behind you."},
        {"zh": "我落在地上，走了两步。", "en": "I land and take two steps."},
        {"zh": "我把翅膀收一收。", "en": "I fold my wings in."},
        {"zh": "花森林里，我的小翅膀够用。", "en": "In the flower forest, my small wings suffice."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在枝头。", "en": "I sit on the branch."},
        {"zh": "翅膀轻轻合着。", "en": "My wings stay lightly folded."},
        {"zh": "我四处张望。", "en": "I look all around."},
        {"zh": "我晃着两只脚。", "en": "I swing my feet."},
        {"zh": "我听风的声音。", "en": "I listen to the wind."},
        {"zh": "我的角还没长硬。", "en": "My horn has not hardened yet."},
        {"zh": "我很小，但不弱。", "en": "I am small, but not weak."},
        {"zh": "我张嘴打了个哈欠，露出小牙。", "en": "I yawn, showing small fangs."},
        {"zh": "我落在枝头，把尾巴卷好。", "en": "I land on a branch and curl my tail."},
        {"zh": "我仰头看树冠缝里的天光。", "en": "I look up at the sky through the canopy gap."},
        {"zh": "我在这里待着。", "en": "I stay here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我正在看着你。", "en": "I am watching you."},
        {"zh": "你给我起了名字吗。", "en": "Have you given me a name?"},
        {"zh": "我不是普通的小动物。", "en": "I am no ordinary little animal."},
        {"zh": "我认得你的样子了。", "en": "I know your look now."},
        {"zh": "你先说句话。", "en": "Say something first."},
        {"zh": "我把脑袋偏一偏。", "en": "I cock my head to one side."},
        {"zh": "我把翅膀收紧。", "en": "I tuck my wings in."},
        {"zh": "你要抱我吗。", "en": "Are you going to pick me up?"},
        {"zh": "我坐在这儿等你。", "en": "I sit here waiting for you."},
        {"zh": "你笑起来了。", "en": "You are smiling."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我短促地叫了。", "en": "I gave a short cry."},
        {"zh": "我飞起来躲。", "en": "I flew up to escape."},
        {"zh": "我落回你的脚边。", "en": "I land back at your feet."},
        {"zh": "这一下扎得慌。", "en": "That one stung badly."},
        {"zh": "我往回退半格。", "en": "I retreat half a block."},
        {"zh": "我翅膀还能撑。", "en": "My wings can still hold me."},
        {"zh": "我记下这一下。", "en": "I note this one."},
        {"zh": "翅膀被打歪了，我赶紧飞高。", "en": "My wing is knocked crooked; I fly higher quickly."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那个能吃吗。", "en": "Can that be eaten?"},
        {"zh": "鼻子里全是那股味。", "en": "My nose is full of that smell."},
        {"zh": "使魔兽的角够不着。", "en": "The tsukaimon's horns can't reach."},
        {"zh": "我拍两下就下来。", "en": "Two flaps and I am down."},
        {"zh": "我一点也不挑。", "en": "I am not picky at all."},
        {"zh": "你先吃你的吧。", "en": "You eat yours first."},
        {"zh": "我一跳一跳凑近。", "en": "I hop closer, jump by jump."},
        {"zh": "闻起来真香。", "en": "It smells wonderful."},
        {"zh": "还有第二份吗。", "en": "Is there a second portion."},
        {"zh": "吃完我跟你走。", "en": "When I am done, I will come with you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我翅膀一歪，在半空转了个圈。", "en": "My wing tipped and I spun a circle midair."},
        {"zh": "我拍翅稳住。", "en": "I steady with my wings."},
        {"zh": "翅膀擦过你的肩，我稳住身。", "en": "My wing brushes your shoulder; I steady myself."},
        {"zh": "你的肩膀太硬。", "en": "Your shoulder is too hard."},
        {"zh": "我落回地上。", "en": "I come down to the ground."},
        {"zh": "被你碰到，我抖了抖翅羽。", "en": "Touched by you, I ruffle my feathers."},
        {"zh": "我落地有点飘。", "en": "My landing was a bit floaty."},
        {"zh": "我挪开半格。", "en": "I shift half a block off."},
        {"zh": "借个空隙过。", "en": "Let me slip through."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你是我认定的那个人。", "en": "You are the one I have chosen."},
        {"zh": "我坐下等你。", "en": "I sit and wait for you."},
        {"zh": "你走哪儿，我跟哪儿。", "en": "Wherever you go, I follow."},
        {"zh": "我会替你挡在前面。", "en": "I will stand in front for you."},
        {"zh": "不要丢下我。", "en": "Do not leave me behind."},
        {"zh": "我认你，就认一辈子。", "en": "Once I choose you, it is for good."},
        {"zh": "一起走远些。", "en": "Let us go farther together."},
        {"zh": "我叫你一声，你应我。", "en": "I call, and you answer."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用爪子捧起来。", "en": "I scoop it up in my claws."},
        {"zh": "我叼着飞起来。", "en": "I carry it up as I fly."},
        {"zh": "它从我爪里掉了。", "en": "It slipped from my claws."},
        {"zh": "这不能算是食物。", "en": "This cannot count as food."},
        {"zh": "我用爪子把它推到你脚边。", "en": "I nudge it to your feet with my claw."},
        {"zh": "这个是给你的。", "en": "This one is for you."},
        {"zh": "它有点沉吧。", "en": "It is a bit heavy."},
        {"zh": "地上那颗种子，我先替你收着。", "en": "That seed on the ground, I'll hold on to it for you."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "花森林的风，把它送来了。", "en": "The flower forest wind brought it."},
        {"zh": "我拍翅升高。", "en": "I flap higher."},
        {"zh": "有动静，我先落到你前头。", "en": "Something stirs; I land in front of you."},
        {"zh": "我不大，但我不退。", "en": "I am small, but I do not back off."},
        {"zh": "我伏到枝头。", "en": "I flatten onto the branch."},
        {"zh": "我把它锁住了。", "en": "I have it fixed."},
        {"zh": "我先冲上去。", "en": "I go in first."},
        {"zh": "你不要怕吧。", "en": "Do not be afraid."},
        {"zh": "该扑上去了。", "en": "Time to lunge."},
        {"zh": "我一收翅，从树梢冲下去。", "en": "I fold my wings and dive from the treetop."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我拍着翅膀，不快不慢地跟。", "en": "I flap along, neither fast nor slow."},
        {"zh": "我在你肩上方。", "en": "I am above your shoulder."},
        {"zh": "树间的距离在减。", "en": "The gap through the trees is closing."},
        {"zh": "我张开翅膀，翼尖先探过去。", "en": "I spread my wings, wingtips reaching first."},
        {"zh": "我贴着树影靠近。", "en": "I approach along the shade."},
        {"zh": "再靠近一枝。", "en": "One branch closer."},
        {"zh": "它有些犹豫。", "en": "It is hesitating."},
        {"zh": "我翅尖对准了。", "en": "My wingtip is aimed."},
        {"zh": "这一发会中。", "en": "This one will land."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我冲上去撞它。", "en": "I dive in and ram it."},
        {"zh": "我吹出一串泡泡。", "en": "I blow a string of bubbles."},
        {"zh": "气泡在它身上炸了。", "en": "The bubbles burst on it."},
        {"zh": "又扑了一下，这回带风。", "en": "Another pounce — this one with wind behind it."},
        {"zh": "它被撞得歪了。", "en": "It was knocked askew."},
        {"zh": "我飞回去落稳。", "en": "I fly back and land steady."},
        {"zh": "这一撞轻轻的。", "en": "That bump was light."},
        {"zh": "我仍在空中。", "en": "I am still in the air."},
        {"zh": "再吹一串泡。", "en": "Another string of bubbles."},
        {"zh": "我护着你的侧后。", "en": "I guard your flank."},
        {"zh": "不要小看我。", "en": "Do not underestimate me."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "树影里飞起一个小东西。", "en": "Something small rises out of the shade."},
        {"zh": "我从枝叶间钻出来。", "en": "I come out from the leaves."},
        {"zh": "翅膀先响，身子才到。", "en": "The wings sound before I arrive."},
        {"zh": "枝叶间多了团小影子。", "en": "A small shape appears among the leaves."},
        {"zh": "我耳朵抖了抖。", "en": "My ears twitched."},
        {"zh": "我闻到人的味道。", "en": "I smell a person."},
        {"zh": "风把我托了一下。", "en": "The wind lifted me a little."},
        {"zh": "我还没被谁认领。", "en": "Nobody has taken me in yet."},
        {"zh": "这里枝叶很密。", "en": "The branches are thick here."},
        {"zh": "我慢慢落稳。", "en": "I settle slowly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一扑，我往树上躲。", "en": "Fire came, and I fled into the tree."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我本来就是飞的，落下来也稳。", "en": "I fly; landing is no trouble for me."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里翅膀很沉。", "en": "My wings are heavy in water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我掀了很远。", "en": "The blast threw me far."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
