{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在地上挪几步。", "en": "I shuffle a few steps."},
        {"zh": "我个子很小，走得很慢。", "en": "I'm small and slow."},
        {"zh": "我朝林子边上走。", "en": "I head to the edge of the woods."},
        {"zh": "我的腿短，一摆一摆。", "en": "Short legs, wobbling."},
        {"zh": "这里的草比我还高。", "en": "The grass here is taller than me."},
        {"zh": "我跟着那个大的走。", "en": "I follow the bigger one."},
        {"zh": "我走两步就摔一下。", "en": "Two steps and I trip."},
        {"zh": "地上有点湿。", "en": "The ground is damp."},
        {"zh": "我朝亮一点的地方挪。", "en": "I shuffle toward the brighter patch."},
        {"zh": "我在这一小片里转。", "en": "I circle in this little patch."},
        {"zh": "我身边还有几个。", "en": "A few others are with me."},
        {"zh": "我慢慢地挪到石头边。", "en": "I slowly shuffle to the stone."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在草丛里。", "en": "I crouch in the grass."},
        {"zh": "我听见虫子在地里爬。", "en": "I hear insects crawling in the soil."},
        {"zh": "我盯着自己的尾巴尖。", "en": "I stare at the tip of my own tail."},
        {"zh": "我不太明白周围。", "en": "I don't quite understand things."},
        {"zh": "我嚼着草，嘴角流汁。", "en": "I chew grass, juice at my lip."},
        {"zh": "我在草根边磨牙。", "en": "I gnaw at the grass roots."},
        {"zh": "我缩在草叶底下。", "en": "I curl up under a blade of grass."},
        {"zh": "我听见有脚步。", "en": "I hear footsteps."},
        {"zh": "我抬头看了看你身后。", "en": "I look up past you."},
        {"zh": "我蹲下来咬自己的爪。", "en": "I crouch down and nibble my own paw."},
        {"zh": "我闻着泥土里的虫子味。", "en": "I sniff out the bugs in the soil."},
        {"zh": "我在等有人叫我。", "en": "I wait to be called."},
        {"zh": "我闻了闻脚边的草。", "en": "I sniff the grass by my feet."},
        {"zh": "我的尾巴搭在地上。", "en": "My tail rests on the ground."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你到底是什么人呀？", "en": "Who exactly are you?"},
        {"zh": "我还没长大，牙是软的。", "en": "I'm not grown yet. My teeth are soft."},
        {"zh": "你会不会打我？", "en": "Are you going to hit me?"},
        {"zh": "我打不过谁。", "en": "I can't beat anyone."},
        {"zh": "我个头实在太小。", "en": "I am really too small."},
        {"zh": "我认识那个大的。", "en": "I know the big one."},
        {"zh": "你的手掌摊开，我还在犹豫。", "en": "Your palm is open; I still hesitate."},
        {"zh": "我肚子饿了呀。", "en": "My tummy is hungry."},
        {"zh": "你身上味道很新。", "en": "You smell new."},
        {"zh": "我躲在你后面行吗？", "en": "Can I hide behind you?"},
        {"zh": "我会吐泡泡。", "en": "I can blow bubbles."},
        {"zh": "你每走一步，我就退。", "en": "With every step you take, I retreat."},
        {"zh": "你个子好高啊。", "en": "You are so very tall."},
        {"zh": "我身上的毛还没干。", "en": "My fur is still wet."},
        {"zh": "我害怕你这么高。", "en": "You are so tall it frightens me."},
        {"zh": "你会留在这里吗？", "en": "Will you stay here?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我疼得叫起来。", "en": "I cried out in pain."},
        {"zh": "我摔进一丛草里。", "en": "I tumble into a clump of grass."},
        {"zh": "我的背甲凹进去一块。", "en": "A dent has been pushed into my shell."},
        {"zh": "我的腿软得像泥。", "en": "My legs feel like mud."},
        {"zh": "我眼睛里都是泪。", "en": "My eyes are full of tears."},
        {"zh": "我这么小，很疼的。", "en": "I'm small. It really hurts."},
        {"zh": "我爬到石头后面。", "en": "I crawl behind the stone."},
        {"zh": "我到现在还在抖。", "en": "I am still shaking now."},
        {"zh": "我都不敢看。", "en": "I do not dare look."},
        {"zh": "你别打我了。", "en": "Please stop hitting me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你给我吃的吗？", "en": "Is that food for me?"},
        {"zh": "我能吃一点点。", "en": "I can eat a little."},
        {"zh": "这东西真香啊。", "en": "That smells really good."},
        {"zh": "你的手太高了。", "en": "Your hand is too high up."},
        {"zh": "我踮起脚也够不到。", "en": "Even on tiptoe I cannot reach."},
        {"zh": "你蹲下来好吗？", "en": "Would you crouch down?"},
        {"zh": "这是我的吗？", "en": "Is this mine?"},
        {"zh": "我会慢慢吃的。", "en": "I will eat it slowly."},
        {"zh": "我这么小，能吃一点。", "en": "I'm small. Just a little."},
        {"zh": "我已经吃完了。", "en": "I have finished eating."},
        {"zh": "手别收回去，我够不着。", "en": "Don't pull your hand back. I can't reach."},
        {"zh": "我咬不动，只能舔。", "en": "I cannot bite it; I can only lick."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我像个球似的滚开了。", "en": "I roll away like a ball."},
        {"zh": "我一下就滚开了。", "en": "I rolled away at once."},
        {"zh": "我被你撞得晕。", "en": "That made me dizzy."},
        {"zh": "我太小，站不稳。", "en": "I'm small. I can't keep my footing."},
        {"zh": "我差点被你踩到。", "en": "I nearly got stepped on."},
        {"zh": "我自己爬起来了。", "en": "I got back up myself."},
        {"zh": "我的骨头还没硬。", "en": "My bones aren't hard yet."},
        {"zh": "我的尾巴尖还在你鞋底。", "en": "My tail tip is still under your sole."},
        {"zh": "我俩挤成一团了。", "en": "We are squashed into one lump."},
        {"zh": "你不要推我呀。", "en": "Please do not push me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这么小，才两点血。", "en": "So small, with only two health."},
        {"zh": "这些我不懂。", "en": "I don't understand this."},
        {"zh": "两个小的挤在一起。", "en": "Two little ones squashed together."},
        {"zh": "你别看着我们。", "en": "Don't watch us."},
        {"zh": "幼年期的小个子，仰头看你。", "en": "A baby-stage runt looks up at you."},
        {"zh": "我们滚了两圈。", "en": "We rolled twice."},
        {"zh": "之后各自去玩。", "en": "Afterwards we go off to play."},
        {"zh": "草丛被我们压乱了。", "en": "We messed the grass up."},
        {"zh": "我不记得这个。", "en": "I don't remember this."},
        {"zh": "我们还不会那个。", "en": "We can't do that yet."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起一片叶子。", "en": "I pick up a leaf."},
        {"zh": "这个啃得动。", "en": "I can gnaw this."},
        {"zh": "我抱都抱不住。", "en": "I can't even hold it."},
        {"zh": "我抱起来往嘴里送。", "en": "I hug it up to my mouth."},
        {"zh": "地上有小石子。", "en": "There are little stones."},
        {"zh": "我这团小身子，爪子已经长齐了。", "en": "Small as I am, my claws are all in."},
        {"zh": "你掉的那个在草边。", "en": "Yours is by the grass."},
        {"zh": "我拿给你看。", "en": "I'll bring it to show you."},
        {"zh": "这个比我还小。", "en": "That is smaller than me."},
        {"zh": "我把它拖回窝。", "en": "I drag it back to the nest."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走到我跟前了。", "en": "You have come up to me."},
        {"zh": "我要不要躲起来？", "en": "Should I hide?"},
        {"zh": "我听见你的脚步很重。", "en": "Your steps sound heavy."},
        {"zh": "我躲在草丛后面。", "en": "I'm behind the grass."},
        {"zh": "草太高，我看不见你。", "en": "The grass is too tall; I cannot see you."},
        {"zh": "我朝那个大的跑。", "en": "I'll run to the big one."},
        {"zh": "我往草里缩了缩。", "en": "I shrink back into the grass."},
        {"zh": "你的靴子踩断了一根枝。", "en": "Your boot has snapped a twig."},
        {"zh": "我要大声叫了。", "en": "I am going to shout."},
        {"zh": "我的腿抖得厉害。", "en": "My legs are shaking badly."},
        {"zh": "我想躲到石头下面。", "en": "I want to get under the stone."},
        {"zh": "你不要靠过来。", "en": "Do not come any closer."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我躲在草里看你。", "en": "I watch you from the grass."},
        {"zh": "你在草那边。", "en": "You're past the grass."},
        {"zh": "我躲在你找不到的地方。", "en": "I'm hiding where you can't find me."},
        {"zh": "我在动，可很慢。", "en": "I'm moving, but slowly."},
        {"zh": "我听见你过来。", "en": "I hear you coming."},
        {"zh": "从数码蛋里出来，我只有两点生命。", "en": "From a Digitama, with only two health."},
        {"zh": "我躲在叶子后面看你。", "en": "I watch you from behind a leaf."},
        {"zh": "我的尾巴露出来了。", "en": "My tail is sticking out."},
        {"zh": "我把自己埋进草里。", "en": "I bury myself in the grass."},
        {"zh": "我快躲不住了。", "en": "I can't stay hidden much longer."},
        {"zh": "你离得很近了。", "en": "You're very close."},
        {"zh": "我往更深处钻。", "en": "I'm burrowing deeper."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬空，摔在地上。", "en": "I bite only air and fall flat."},
        {"zh": "我这点劲根本不算。", "en": "My strength hardly counts."},
        {"zh": "我咬了你一下。", "en": "I bit you once."},
        {"zh": "我吐了个泡泡。", "en": "I blew a bubble."},
        {"zh": "我撞上去，自己弹开。", "en": "I charge in and bounce off."},
        {"zh": "我自己先倒了。", "en": "I fell over first."},
        {"zh": "我退到你够不着的地方。", "en": "I backed out of your reach."},
        {"zh": "我这一点点力气。", "en": "This is all the strength I have."},
        {"zh": "幼年期的爪，只有这么小。", "en": "A baby-stage claw, only this big."},
        {"zh": "你可不要还手。", "en": "Please do not hit back."},
        {"zh": "我抓住你的裤腿了。", "en": "I've got your trouser leg."},
        {"zh": "我的爪子根本没碰到。", "en": "My claws did not even touch you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从蛋里出来不久。", "en": "I haven't been out of the egg long."},
        {"zh": "我从黏糊的蛋液里爬出。", "en": "I crawl out of the sticky egg fluid."},
        {"zh": "这里是森林。", "en": "This is a forest."},
        {"zh": "我从蛋壳里爬出来。", "en": "I crawl out of the eggshell."},
        {"zh": "我身边有几个同伴。", "en": "A few of my kind are here."},
        {"zh": "我试着站起来。", "en": "I tried to stand."},
        {"zh": "脚下的地很软。", "en": "The ground is soft."},
        {"zh": "我闻到了草的味道。", "en": "I smelled the grass."},
        {"zh": "我朝声音那边看。", "en": "I looked toward the sound."},
        {"zh": "我摔了一下。", "en": "I fell over."},
        {"zh": "我爬起来了。", "en": "I got back up."},
        {"zh": "我不知道该去哪。", "en": "I don't know where to go."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "好烫，我的皮在烧。", "en": "So hot. My hide is burning."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从上面掉下来，摔疼了。", "en": "I fell from up there and it hurt."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里扑腾，喊不出。", "en": "I thrash in the water, unable to call out."}
      ]
    },
