      "operation": "replace",
      "lines": [
        {"zh": "响了一声，我就飞出去了。", "en": "There was a bang and I flew off."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我身上。", "en": "Something stuck into me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光一闪，我就晕了。", "en": "There was a flash and I went dizzy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我肚子一直叫。", "en": "My belly won't stop growling."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷好响，我动不了了。", "en": "The thunder was loud and I froze."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我在往下掉，什么都抓不到。", "en": "I'm falling and there's nothing to grab."}
      ]
    }
  }
