{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在针叶林里走。", "en": "I walk through the conifer wood."},
        {"zh": "长角擦着低枝。", "en": "My long horns brush the low branches."},
        {"zh": "我每踏一步都压得雪响。", "en": "Every step I take crunches the snow."},
        {"zh": "蹄子踩得枝杈响。", "en": "Hooves crack the twigs."},
        {"zh": "我的手臂垂得很长。", "en": "My arms hang long."},
        {"zh": "雪地上留一串深印。", "en": "A line of deep prints in snow."},
        {"zh": "我绕开冻结的溪。", "en": "I skirt the frozen stream."},
        {"zh": "黑森林里，光很暗。", "en": "Little light in the black forest."},
        {"zh": "蹄步沉，可从不歇。", "en": "Heavy hooves, and never resting."},
        {"zh": "我的影子，被枝影切碎。", "en": "Branch shadows break my silhouette."},
        {"zh": "我朝林深处走。", "en": "I head deeper into the wood."},
        {"zh": "身后的雪，塌下一片。", "en": "Snow caves in behind me."},
        {"zh": "我的角上结着霜。", "en": "Frost on my horns."},
        {"zh": "我一走，鸟就飞了。", "en": "Birds scatter when I move."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在雪地里。", "en": "I stand in the snow."},
        {"zh": "呼出的气很长。", "en": "My breath plumes long."},
        {"zh": "角上的霜，慢慢厚。", "en": "Frost thickens on my horns."},
        {"zh": "我低头看着雪。", "en": "I look down at the snow."},
        {"zh": "连雪落的声音都听得见。", "en": "I can hear even the snow landing."},
        {"zh": "我的手指，很长。", "en": "My fingers are very long."},
        {"zh": "我在听雪落。", "en": "I listen to the snow fall."},
        {"zh": "肩膀上的毛，结了冰。", "en": "Ice in the fur on my shoulders."},
        {"zh": "颈骨响了一声，像树枝折断。", "en": "My neck cracks like a breaking branch."},
        {"zh": "无人的林子里，只有我。", "en": "Only I am in this empty wood."},
        {"zh": "我慢慢吐出白气。", "en": "I slowly breathe out white mist."},
        {"zh": "脚下很结实。", "en": "My footing is solid."},
        {"zh": "我抬起头，看树顶。", "en": "I raise my head to the treetops."},
        {"zh": "我重新低下头，看雪。", "en": "I lower my head to the snow again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在雪地上留下了印。", "en": "You've left prints in the snow."},
        {"zh": "你得仰头，才看得到我的角。", "en": "You have to look up to see my horns."},
        {"zh": "我的角，不是装饰。", "en": "My horns aren't decoration."},
        {"zh": "你不该走进这林子。", "en": "You shouldn't have come into this wood."},
        {"zh": "我转过头，正对你。", "en": "I turn square to you."},
        {"zh": "你站住了没动。", "en": "You've stopped in place."},
        {"zh": "这身毛，很厚。", "en": "This fur is thick."},
        {"zh": "我的手，能合拢你。", "en": "My hands could close around you."},
        {"zh": "你身上有冷铁和松脂。", "en": "You smell of cold iron and pine resin."},
        {"zh": "你退开之后，呼吸乱了。", "en": "You stepped back, breathing wrong."},
        {"zh": "林子里的雪，会记住你。", "en": "The snow here will remember you."},
        {"zh": "你进林子那刻，我就看见了。", "en": "I saw you the moment you entered the trees."},
        {"zh": "你的手在雪里发抖。", "en": "Your hands shake in the snow."},
        {"zh": "我从鼻子里笑出一声。", "en": "A laugh escapes my nostrils."},
        {"zh": "趁我还没抬手，走。", "en": "Leave before I raise my hand."},
        {"zh": "从这条路上走。", "en": "Take the path out."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "毛上多了道痕。", "en": "A new gash in my fur."},
        {"zh": "我整具身子退半步。", "en": "My whole body gives half a step."},
        {"zh": "厚毛下这点口子不算伤。", "en": "Under thick fur, this is no wound."},
        {"zh": "霜从角上掉下来。", "en": "Frost falls off my horns."},
        {"zh": "我从喉咙里挤出闷响。", "en": "A muffled sound comes from my throat."},
        {"zh": "我的手还有点力气。", "en": "I still have strength in my hand."},
        {"zh": "血落在雪里，化出一个小洞。", "en": "Blood falls on snow and melts a small hole."},
        {"zh": "我把腰重新挺直。", "en": "I straighten my back again."},
        {"zh": "这一下，确实有些分量。", "en": "That blow had real weight."},
        {"zh": "我没打算走。", "en": "I don't mean to leave."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西我不入嘴。", "en": "This doesn't go in my mouth."},
        {"zh": "你把东西举在雪里。", "en": "You hold it up in the snow."},
        {"zh": "这些东西太少。", "en": "There's too little of this."},
        {"zh": "会喘气的，才送到我面前。", "en": "Bring me something that still breathes."},
        {"zh": "这点东西，留着。", "en": "Keep that."},
        {"zh": "你手不冷吗？", "en": "Isn't your hand cold?"},
        {"zh": "我不会碰它。", "en": "I won't touch it."},
        {"zh": "雪会把它埋了。", "en": "The snow will bury it."},
        {"zh": "把它丢过来。", "en": "Throw it over."},
        {"zh": "我不碰不冒热气的东西。", "en": "I don't touch things that don't steam."},
        {"zh": "雪地里的东西，我不碰。", "en": "I don't touch things left in the snow."},
        {"zh": "你收好，别冻了手。", "en": "Put it away before your hand freezes."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我覆雪的腿骨。", "en": "You hit my snow-crusted leg."},
        {"zh": "我的毛很硬。", "en": "My fur is coarse."},
        {"zh": "我肩头都没晃。", "en": "Even my shoulder didn't sway."},
        {"zh": "你弹开放开。", "en": "You bounced and let go."},
        {"zh": "我们脚下，雪压成了冰。", "en": "Under our feet the snow packs to ice."},
        {"zh": "我伸出一只长臂。", "en": "I put out one long arm."},
        {"zh": "这点碰，不算事。", "en": "That touch means nothing."},
        {"zh": "你别站在我角边。", "en": "Don't stand by my horns."},
        {"zh": "我往雪里退了步。", "en": "I step back into the snow."},
        {"zh": "你踩着我的脚印走。", "en": "You're walking in my prints."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "针叶林里，同类很少。", "en": "Few kin in the conifers."},
        {"zh": "这具身体，不需要陪。", "en": "This body needs no company."},
        {"zh": "我的角生了很久。", "en": "These horns have grown a long time."},
        {"zh": "一个人也挺好。", "en": "Alone suits me."},
        {"zh": "这问题，林子不会回答。", "en": "The forest won't answer that."},
        {"zh": "这些我没兴致。", "en": "I've no taste for this."},
        {"zh": "雪里很安静。", "en": "It's quiet in the snow."},
        {"zh": "再近一步，我就转身走了。", "en": "One step closer and I'll turn and leave."},
        {"zh": "雪地上没有同类，我走开。", "en": "There's no mate in this snow; I walk on."},
        {"zh": "雪落下来，把话盖住了。", "en": "Snow falls and buries the words."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一只手掌抄起来。", "en": "I scoop it in one palm."},
        {"zh": "手指太长，捏不牢。", "en": "My fingers are too long to grip."},
        {"zh": "我在指间掂了掂。", "en": "I weigh it between my fingers."},
        {"zh": "掉进雪里，找不到了。", "en": "It fell in the snow; gone."},
        {"zh": "在掌里掂了掂，还算沉。", "en": "I weigh it in my palm; it has some heft."},
        {"zh": "我拎到眼前。", "en": "I lift it to my eye."},
        {"zh": "这东西没用处。", "en": "This is good for nothing."},
        {"zh": "我随手丢进雪里。", "en": "I toss it into the snow."},
        {"zh": "攥紧了，会碎。", "en": "Gripped tight, it would break."},
        {"zh": "这件我收着。", "en": "I'll keep this one."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西进了林子。", "en": "Something's entered the wood."},
        {"zh": "我慢慢转过脑袋。", "en": "I turn my head slowly."},
        {"zh": "不是雪的声音。", "en": "That's not the sound of snow."},
        {"zh": "我踏着雪朝那边走。", "en": "I walk that way through the snow."},
        {"zh": "我把头上的角抬起来。", "en": "I lift the horns on my head."},
        {"zh": "你退到树后。", "en": "You're behind a tree."},
        {"zh": "挡路的树，我一手拨开。", "en": "I sweep aside the trees in my way."},
        {"zh": "你的退路，被我踩断了。", "en": "I've crushed the ground behind you."},
        {"zh": "我的呼吸变成白雾。", "en": "My breath turns to white mist."},
        {"zh": "这一整片林子，都是我的。", "en": "This whole wood is mine."},
        {"zh": "我的步子快了几分。", "en": "My steps have quickened."},
        {"zh": "蹄子抬起，就是现在。", "en": "Hooves lift — this is the moment."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "蹄印一串串压过去。", "en": "Hoofprint after hoofprint."},
        {"zh": "你踩出的印，我一直跟着。", "en": "I've followed every print you left."},
        {"zh": "我的角碰到树枝。", "en": "My horn brushes a branch."},
        {"zh": "你退得快，脚印却乱。", "en": "You retreat fast, but your tracks are scattered."},
        {"zh": "林子里越走越暗。", "en": "The wood darkens as we go."},
        {"zh": "我的手已经伸出去。", "en": "My hand is already out."},
        {"zh": "喉咙里滚出一声闷哼。", "en": "A muffled note rolls in my throat."},
        {"zh": "你在喘白气。", "en": "You're panting white clouds."},
        {"zh": "再几步就到了。", "en": "A few steps more."},
        {"zh": "你踩进了深雪。", "en": "You've hit deep snow."},
        {"zh": "停步，别往前了。", "en": "Halt — no further forward."},
        {"zh": "我已经到了跟前。", "en": "I'm right at you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一爪撕下去！", "en": "My claws tear down!"},
        {"zh": "死亡之爪，接好。", "en": "Death Claw — take it."},
        {"zh": "这一下，很深。", "en": "That one went deep."},
        {"zh": "我一把扣住你肩膀。", "en": "I clamp your shoulder."},
        {"zh": "你扭不开这只手。", "en": "You won't twist out of this hand."},
        {"zh": "长指扣住你，像铁箍。", "en": "My long fingers close on you like an iron band."},
        {"zh": "雪都被踩翻了。", "en": "The snow is churned up."},
        {"zh": "我又抬手了。", "en": "My hand comes up again."},
        {"zh": "你退了，但很慢。", "en": "You retreat, but slowly."},
        {"zh": "这一下就足够。", "en": "That alone is enough."},
        {"zh": "膝盖该软了。", "en": "Your knees should give."},
        {"zh": "别再起来了。", "en": "Don't get up again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "针叶上的雪，被我碰落一片。", "en": "I brush a shower of snow off the conifers."},
        {"zh": "角上的雪，我抖了抖没抖掉。", "en": "I shake my head, but the snow stays on my horns."},
        {"zh": "这林子，很冷。", "en": "This wood is cold."},
        {"zh": "我抬起头，雪落在鼻梁上。", "en": "I lift my head; snow lands on my snout."},
        {"zh": "四周没有人。", "en": "No one around."},
        {"zh": "我的蹄子陷进雪。", "en": "My hooves sink in the snow."},
        {"zh": "有活物的气息。", "en": "The scent of something living."},
        {"zh": "雪里印出一串深蹄印。", "en": "A line of deep hoofprints in the snow."},
        {"zh": "树枝在我身侧分开。", "en": "Branches part beside me."},
        {"zh": "我在这里站定。", "en": "I take my stand here."},
        {"zh": "风从林深处来。", "en": "Wind from deep in the wood."},
        {"zh": "别朝后头看。", "en": "Don't look behind."},
        {"zh": "林线那里，我的角先露出来。", "en": "At the treeline, my horns show first."},
        {"zh": "雪还没有停。", "en": "The snow hasn't stopped."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，毛就焦了。", "en": "Fire scorches my fur."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔进雪里，全身一震。", "en": "I fall into the snow; my body jolts."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "冰水灌进来，我挣扎。", "en": "Icy water floods in; I struggle."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我撞倒了树。", "en": "The blast knocks me through a tree."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根箭杆露在毛外面，晃着。", "en": "An arrow shaft juts from my fur, quivering."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我的角发烫。", "en": "That force heats my horns."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，步子更沉。", "en": "Hungry, my steps grow heavier."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在林里，我一颤。", "en": "Lightning in the wood; I shudder."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有雪了，我直往下。", "en": "No snow beneath; I fall."}
      ]
    }
  }
}
