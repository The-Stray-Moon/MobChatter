{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我张着嘴，笑着走", "en": "I walk along laughing, mouth open."},
        {"zh": "两只长爪子拖在地上", "en": "My two long claws drag on the ground."},
        {"zh": "我走路不怎么稳，像在跳", "en": "My walk is unsteady, almost hopping."},
        {"zh": "这具身体轻得很", "en": "This body is very light."},
        {"zh": "我朝有数据的地方走", "en": "I walk toward where the data is."},
        {"zh": "尾巴在后面摇来摇去", "en": "My tail swings behind me."},
        {"zh": "我从末地的岩上走过", "en": "I cross the endstone."},
        {"zh": "我走一步，天就笑一步", "en": "Every step I take, the laugh follows."},
        {"zh": "我不在意地上的东西", "en": "I don't care about what's on the ground."},
        {"zh": "身体一格多高，很好钻", "en": "A block tall; I fit easily."},
        {"zh": "我歪着头走路", "en": "I walk with my head tilted."},
        {"zh": "我贴着地面爬近你。", "en": "I crawl low toward you."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我笑着，没有原因", "en": "I'm laughing for no reason."},
        {"zh": "我张着嘴，等下一口", "en": "My mouth hangs open for the next bite."},
        {"zh": "两眼之间的距离有点大", "en": "My eyes sit a little far apart."},
        {"zh": "这里的数据很稀薄", "en": "The data here is thin."},
        {"zh": "我伸手挠了挠头", "en": "I scratched my head."},
        {"zh": "我在这附近转圈", "en": "I circle around here."},
        {"zh": "不饿的时候我也想吃", "en": "Even not hungry, I want to eat."},
        {"zh": "我站不稳，总在晃", "en": "I can't stand steady; I sway."},
        {"zh": "那个孩子把我造得不太对称", "en": "That child made me a bit uneven."},
        {"zh": "我在等一个人再走近两步", "en": "I'm waiting for one more step from someone."},
        {"zh": "数据做的我，不用睡觉。", "en": "Made of data, I need no sleep."},
        {"zh": "身上有细细的线在动", "en": "Thin wires move on me."},
        {"zh": "我在等一个更好吃的", "en": "I'm waiting for something tastier."},
        {"zh": "我的爪子在地上划了两下", "en": "My claws scratched the ground twice."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看起来很好吃", "en": "You look tasty."},
        {"zh": "我笑着看你，你看得见吧", "en": "I'm grinning at you; you can see it."},
        {"zh": "你的数据在往外冒", "en": "Your data is leaking out."},
        {"zh": "我不太大，可我不小", "en": "I'm not big, and not small."},
        {"zh": "别跑，跑了就不好玩", "en": "Don't run; running spoils it."},
        {"zh": "我这两只手能伸很远", "en": "These two hands reach far."},
        {"zh": "你的心跳声很响", "en": "Your heartbeat is loud."},
        {"zh": "你的气一深一浅，我听着", "en": "Your breath goes deep and shallow; I'm listening."},
        {"zh": "你站住，让我闻闻", "en": "Stand still and let me sniff."},
        {"zh": "我饿了，一直都是", "en": "I'm hungry, always."},
        {"zh": "这地方的味道太淡", "en": "The flavor here is too thin."},
        {"zh": "你在那儿发抖", "en": "You're shaking."},
        {"zh": "我笑起来不好听，我知道", "en": "My laugh sounds bad, I know."},
        {"zh": "我张着嘴是为了说话", "en": "My mouth is open so I can speak."},
        {"zh": "走远一点我也闻得到", "en": "I'll smell you even far off."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我笑着退开了", "en": "I backed off, still laughing."},
        {"zh": "这一下打断了我的笑", "en": "That cut my laugh short."},
        {"zh": "不疼，就是不高兴", "en": "It doesn't hurt; I'm just annoyed."},
        {"zh": "身上的线乱了一点", "en": "Some wires came loose."},
        {"zh": "等下我要还回来", "en": "I'll return that later."},
        {"zh": "这一下，我饿了", "en": "That made me hungry."},
        {"zh": "疼？我还没开始放电呢。", "en": "Hurt? I haven't even started throwing lightning."},
        {"zh": "这一下，我记在小本子上了。", "en": "That one goes in my little book."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "吃的东西在我的世界里叫数据", "en": "Food in my world is called data."},
        {"zh": "你手里那个，能吃吗", "en": "Can that in your hand be eaten?"},
        {"zh": "你喂我，我就不咬你", "en": "Feed me and I won't bite."},
        {"zh": "这点东西还不够我嚼。", "en": "That is barely a mouthful for me."},
        {"zh": "我要那大块的", "en": "I want the big one."},
        {"zh": "多一点，再多一点", "en": "More, more."},
        {"zh": "你手里的东西在发光，我要", "en": "What you hold is glowing; I want it."},
        {"zh": "我什么都吃，不挑", "en": "I eat anything, I'm not picky."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞我，我笑得更响", "en": "You hit me and I laugh louder."},
        {"zh": "我身上滑，抓不住", "en": "I'm slippery; you can't hold me."},
        {"zh": "我退开，退得不远", "en": "I back off, not far."},
        {"zh": "你撞得我笑了一声", "en": "You bumped me and I laughed once."},
        {"zh": "你撞到了我的爪子", "en": "You hit my claw."},
        {"zh": "我晃了两下，站住", "en": "I wobbled twice and held."},
        {"zh": "你的护甲在我嘴里有点硬", "en": "Your armor tastes hard."},
        {"zh": "让开一点，我还没玩够", "en": "Move aside; I'm not done playing."},
        {"zh": "踢我也没用，我很滑", "en": "Kicking's no use; I'm slippery."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是个成长期的孩子", "en": "I'm only a Child-stage kid."},
        {"zh": "我的同伴还有别的", "en": "I have other companions."},
