{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着走，脚不落地。", "en": "I move without touching ground."},
        {"zh": "我飞过红色的林子。", "en": "I fly over the red forest."},
        {"zh": "风绕着我转成一圈。", "en": "Wind coils around me."},
        {"zh": "沙上的影子跟着我，却没有脚。", "en": "My shadow follows me across the sand without feet."},
        {"zh": "我从山脊上空掠过。", "en": "I pass above the ridge."},
        {"zh": "空气在我身后留下痕迹。", "en": "The air scars behind me."},
        {"zh": "我绕着末地岛的边缘飘。", "en": "I drift along the End isle's edge."},
        {"zh": "我朝锚点的方向回去。", "en": "I return toward my anchor."},
        {"zh": "我压低了高度，看得更清。", "en": "I drop low for a better look."},
        {"zh": "我的身体很大，但很轻。", "en": "Large, and light."},
        {"zh": "我慢慢升到云端上面。", "en": "I rise above the clouds."},
        {"zh": "我从恶地的裂谷上方过。", "en": "I cross the badland ravine."},
        {"zh": "我身后的空气还在转。", "en": "The air still turns behind me."},
        {"zh": "我朝有气的方向去。", "en": "I head toward a strong aura."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，风还在转。", "en": "I hover. The wind keeps turning."},
        {"zh": "我不需要落地，也不需要呼吸。", "en": "No ground. No breath."},
        {"zh": "我的形态在慢慢流。", "en": "My form flows slowly."},
        {"zh": "我在听高空的低频声。", "en": "I listen to low sounds up high."},
        {"zh": "这处锚点，我记着。", "en": "I remember this anchor."},
        {"zh": "我悬在沙暴上方，慢慢呼吸。", "en": "I hover above the sandstorm, breathing slowly."},
        {"zh": "沙暴在我下面转。", "en": "A sandstorm turns below me."},
        {"zh": "我的影子会自己动。", "en": "My shadow moves on its own."},
        {"zh": "风里有什么在低鸣。", "en": "Something hums in the wind."},
        {"zh": "我在看大陆的边缘。", "en": "I look at the continent's rim."},
        {"zh": "我的爪子收在身侧。", "en": "My claws are drawn in."},
        {"zh": "这一片天空很空旷。", "en": "This sky is empty."},
        {"zh": "我悬着转身，风跟着转。", "en": "I turn in the air and the wind turns with me."},
        {"zh": "我停在一座尖峰上方。", "en": "I stop over a spire."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的旋风，从下往上卷。", "en": "My tornado coils upward from below."},
        {"zh": "我是混沌兽，完全体。", "en": "ChaosGrimmon, an Ultimate."},
        {"zh": "你身上有很淡的气。", "en": "Your aura is faint."},
        {"zh": "我从上面看你，很小。", "en": "From here you are small."},
        {"zh": "你抬头的动作太慢了。", "en": "Your head lifts too slowly."},
        {"zh": "我的风能把你推倒。", "en": "My wind can knock you down."},
        {"zh": "混乱的格里姆，翅展四格。", "en": "Chaos Grimmon, wingspan four blocks."},
        {"zh": "你想让我跟着你？", "en": "You want me to follow?"},
        {"zh": "我可以挖开整座山。", "en": "I could open a mountain."},
        {"zh": "你最好别眨眼，我很快。", "en": "Best not blink. I am fast."},
        {"zh": "我飞的时候没有声音。", "en": "I fly without sound."},
        {"zh": "这片天空，我常来。", "en": "I come to this sky often."},
        {"zh": "你的位置我很清楚。", "en": "I know exactly where you are."},
        {"zh": "退开，我要降落了。", "en": "Move. I am descending."},
        {"zh": "你身上没有同伴的气。", "en": "No pack aura on you."},
        {"zh": "现在，抬头。", "en": "Now look up."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的数据散了一点。", "en": "A little of my data scatters."},
        {"zh": "风乱了一瞬。", "en": "The wind breaks for a moment."},
        {"zh": "我升得更高了一些。", "en": "I rise a little higher."},
        {"zh": "风把我的一片数据卷走了。", "en": "The wind takes a scrap of my data."},
        {"zh": "我不叫，风会替我。", "en": "I do not cry out. The wind does."},
        {"zh": "我的形态晃了一下。", "en": "My form wavers."},
        {"zh": "沙在我周围塌下来。", "en": "Sand falls away around me."},
        {"zh": "你打得动我，但不多。", "en": "You hurt me. Not much."},
        {"zh": "我被击中的地方，风漏了出去。", "en": "The wind leaks out where you struck me."},
        {"zh": "这一下，风会记住你。", "en": "The wind will remember you."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "数据？我吸收这个。", "en": "Data? I absorb it."},
        {"zh": "你手里那块，不够。", "en": "Not enough."},
        {"zh": "放在地上，别抬头找。", "en": "Leave it down; do not look up for me."},
        {"zh": "这块数据有点旧。", "en": "This data is old."},
        {"zh": "食物对我不存在。", "en": "Food does not exist for me."},
        {"zh": "你举得太高，我在上面。", "en": "Too high. I am above."},
        {"zh": "我不需要供品。", "en": "I need no offerings."},
        {"zh": "这块够我维持一阵。", "en": "That sustains me a while."},
        {"zh": "手别抖，离远一点。", "en": "Do not let your hand shake, keep it far."},
        {"zh": "这点东西，换不来我的注意。", "en": "That will not buy my attention."},
        {"zh": "我收下了，你可以走了。", "en": "Taken. You may go."},
        {"zh": "还有吗？我不介意多拿。", "en": "Any more? I would take more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞过来时，我升高了半格。", "en": "You lunge and I rise half a block."},
        {"zh": "我一侧身，你已经偏了。", "en": "I tilt and you veer."},
        {"zh": "我的身体很轻，但推得动你。", "en": "Light, and it moves you."},
        {"zh": "风压把你按低了。", "en": "The wind presses you down."},
        {"zh": "绯红森林上空，我的影子罩住你。", "en": "Over the crimson forest my shadow covers you."},
        {"zh": "碰撞之后，沙被卷起来。", "en": "Sand lifts after the bump."},
        {"zh": "你退开，风还在转。", "en": "You pull back; the wind turns."},
        {"zh": "这一下不算碰。", "en": "That hardly counts."},
        {"zh": "你的护甲在风里响。", "en": "Your armor rattles in the wind."},
        {"zh": "你撞过来，我只升高了一格。", "en": "You charge and I simply rise half a block."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "完全体不做这种事。", "en": "An Ultimate does not do that."},
        {"zh": "我的数据里只有破坏。", "en": "My data holds only destruction."},
        {"zh": "你问得太低了。", "en": "You ask from too low."},
        {"zh": "这一片天空只有我。", "en": "I alone fill this sky."},
        {"zh": "这个话题让风卷走。", "en": "Let the wind take that."},
        {"zh": "我更想进化成别的形态。", "en": "I would rather evolve."},
        {"zh": "你该问怎么让我挖矿。", "en": "Ask how I mine."},
        {"zh": "地面上的一切我都不参与。", "en": "I take no part in the ground."},
        {"zh": "我升高了，听不清你。", "en": "I am higher now. I cannot hear."},
        {"zh": "这个话题结束了。", "en": "That topic is over."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块数据，我收进身体。", "en": "I draw the data into me."},
        {"zh": "你掉的，我用风卷起来。", "en": "I lift what you dropped."},
        {"zh": "它浮到我手边。", "en": "It floats to my hand."},
        {"zh": "我托了一下，没有托起来。", "en": "I lift, and it will not come."},
        {"zh": "这块在风里转了两圈。", "en": "It turns twice in my wind."},
        {"zh": "我悬着飞过红色的林子，落在你脚边。", "en": "I fly over the red woods and set it at your feet."},
        {"zh": "这块太小，我抓不住。", "en": "Too small to grip."},
        {"zh": "我的爪子不太适合捡东西。", "en": "My claws are not for picking up."},
        {"zh": "那东西留在地上，我不落下去。", "en": "That stays on the ground. I will not land."},
        {"zh": "东西落到很远的下面去了。", "en": "It fell far below."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我开始朝你下降。", "en": "I begin my descent."},
        {"zh": "风把沙卷成一根柱。", "en": "Wind lifts a column of sand."},
        {"zh": "沙上的影子已经出卖了你。", "en": "Your shadow on the sand gives you up."},
        {"zh": "你在空地上，没有遮挡。", "en": "You are in the open."},
        {"zh": "机械旋风已经蓄满。", "en": "Mach Tornado is charged."},
        {"zh": "这一招叫机械旋风。", "en": "This is Mach Tornado."},
        {"zh": "你听见风变调了吗？", "en": "Hear the wind change pitch?"},
        {"zh": "我从高空绕着你画了个圆。", "en": "I draw a circle above you."},
        {"zh": "你退到裂谷边了。", "en": "You backed to the ravine."},
        {"zh": "沙柱在我脚下拧成一根绳。", "en": "The sand column twists into a rope beneath me."},
        {"zh": "机械旋风把我托起，绕你画圆。", "en": "The Mach Tornado lifts me and I circle you."},
        {"zh": "现在，我下来。", "en": "Now I come down."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你不高不低。", "en": "I circle at mid-height."},
        {"zh": "风把你脚下的沙吹开。", "en": "Wind strips the sand from under you."},
        {"zh": "你每退一步，风就更近。", "en": "Each step back, the wind nears."},
        {"zh": "我看得清你的每一步。", "en": "I see every step."},
        {"zh": "我停住，风还在转。", "en": "I stop. The wind keeps turning."},
        {"zh": "你举盾的动作太迟了。", "en": "Your shield comes too late."},
        {"zh": "沙在往上飘，往我这边。", "en": "Sand rises toward me."},
        {"zh": "你听，风声里有东西。", "en": "Something in the wind."},
        {"zh": "再近一点，就进旋风。", "en": "One step more and you are in it."},
        {"zh": "你开始站不稳了吧。", "en": "Your footing is failing."},
        {"zh": "最后几格，我压着风落下去。", "en": "Last few blocks, I come down on the wind."},
        {"zh": "现在，你就在正下方。", "en": "Now you are directly below."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "旋风卷上来，你被带离地。", "en": "The tornado lifts you off the ground."},
        {"zh": "我俯冲撞在你的肩上。", "en": "I dive into your shoulder."},
        {"zh": "风刃划过你的护甲。", "en": "Wind blades cross your armor."},
        {"zh": "这一下把你抛了出去。", "en": "That hurls you away."},
        {"zh": "我的爪子抓过你的盾。", "en": "My claws rake your shield."},
        {"zh": "沙进了你的眼睛。", "en": "Sand gets into your eyes."},
        {"zh": "你落地时，我又升起来。", "en": "You land; I rise again."},
        {"zh": "风刃削过你的肩甲，才响。", "en": "The wind blade cuts your pauldron before any sound."},
        {"zh": "风刃在你甲上留下一条长痕。", "en": "Wind leaves a long line on your armor."},
        {"zh": "我在你上方三步。", "en": "Three blocks above you."},
        {"zh": "风还没有停，你也没落地。", "en": "The wind has not stopped."},
        {"zh": "还有一次俯冲，准备好了吗？", "en": "One more dive. Ready?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "风突然起来了。", "en": "The wind rises suddenly."},
        {"zh": "天空多了一道影子。", "en": "A shadow joins the sky."},
        {"zh": "我从云里降下来，Mach 的气流在身后。", "en": "I descend from the clouds, Mach wind trailing."},
        {"zh": "沙被卷成一根柱。", "en": "Sand lifts into a column."},
        {"zh": "你听见一声很低的鸣。", "en": "One low hum."},
        {"zh": "锚点上方的空气动了。", "en": "The air above the anchor stirs."},
        {"zh": "我的数据聚成一个大形。", "en": "My data gathers into a shape."},
        {"zh": "四格高的翅膀，遮住半片天。", "en": "Four blocks of wings blot out half the sky."},
        {"zh": "我慢慢降到低空。", "en": "I drop to low altitude."},
        {"zh": "孢子林的树被吹弯了。", "en": "The crimson trees bend."},
        {"zh": "我的爪子第一次张开。", "en": "My claws open for the first time."},
        {"zh": "你抬头，会看见我。", "en": "Look up and see."},
        {"zh": "地面上的沙在打转。", "en": "Sand turns on the ground."},
        {"zh": "现在，我在这里。", "en": "Now I am here."}
      ]
    },
