{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在半空，往前滑。", "en": "I hang in the air and glide forward."},
        {"zh": "我的脚不着地。", "en": "My feet do not touch ground."},
        {"zh": "这一身黑甲，在风里响。", "en": "This black armor rings in the wind."},
        {"zh": "我掠过草原。", "en": "I skim over the plain."},
        {"zh": "黑色的我，飞得很快。", "en": "Black and quick in the air."},
        {"zh": "我往前一冲。", "en": "I surge forward."},
        {"zh": "我绕过一座土丘。", "en": "I circle a rise."},
        {"zh": "我的影子在草上跑。", "en": "My shadow runs along the grass."},
        {"zh": "我浮着，不动腿。", "en": "I float without moving my legs."},
        {"zh": "我离地三格，悬住了", "en": "I rise three blocks and hold there."},
        {"zh": "我朝风的方向。", "en": "I face into the wind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，一上一下。", "en": "I hover, rising and falling."},
        {"zh": "我的炮口有点热。", "en": "My barrels are warm."},
        {"zh": "我在听着四周。", "en": "I am listening around."},
        {"zh": "风把我的甲吹凉。", "en": "The wind cools my plating."},
        {"zh": "我悬在半空，这一身黑甲在风里响。", "en": "I hover, black armor ringing in the wind."},
        {"zh": "我的推进器声，盖过风声", "en": "My thrusters drown out the wind."},
        {"zh": "我浮在原地。", "en": "I float in place."},
        {"zh": "我的腿垂着。", "en": "My legs hang down."},
        {"zh": "炮口在暗处转了个向", "en": "My gun muzzle turns in the dark."},
        {"zh": "我背上的甲有点凉。", "en": "The armor on my back is cool."},
        {"zh": "我的推进器在轻响。", "en": "My thrusters hum softly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在地上，我在上头。", "en": "You are on the ground. I am above."},
        {"zh": "我不用落地也能看你。", "en": "I can watch you without landing."},
        {"zh": "你抬起頭来。", "en": "Look up."},
        {"zh": "我这一身，是打过仗的。", "en": "This body has seen battle."},
        {"zh": "你的手不要动。", "en": "Keep your hands still."},
        {"zh": "我有两个炮口。", "en": "I have two muzzles."},
        {"zh": "我不喜欢被瞄准。", "en": "I dislike being aimed at."},
        {"zh": "我们保持距离。", "en": "Let us keep our distance."},
        {"zh": "你要说就说。", "en": "Speak if you have something to say."},
        {"zh": "你说吧，我不打断。", "en": "Speak. I will not interrupt."},
        {"zh": "别绕到我后面。", "en": "Do not circle behind me."},
        {"zh": "这一步，是警告。", "en": "This step is a warning."},
        {"zh": "我认得训练员的眼神。", "en": "I know a trainer's look."},
        {"zh": "你有那种眼神。", "en": "You have that look."},
        {"zh": "你抬头的样子很眼熟。", "en": "That upward look is familiar."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我被打得歪了一下。", "en": "The blow knocked me askew."},
        {"zh": "我拉起高度。", "en": "I gained height."},
        {"zh": "我的耳朵嗡了一下。", "en": "My ears rang."},
        {"zh": "黑甲上多了一道白痕", "en": "A white scar now marks my black armor."},
        {"zh": "三格的翅膀，飞着不落地。", "en": "Three blocks of wing, never touching down."},
        {"zh": "黑甲上的光，暗了一格。", "en": "The shine on my black armor dimmed."},
        {"zh": "我重新对准了地面", "en": "I level myself at the ground again."},
        {"zh": "我还没落地。", "en": "I have not landed yet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那味道像肉。", "en": "That smells like meat."},
        {"zh": "这个我不入口。", "en": "I will not take that in."},
        {"zh": "我只要吃肉。", "en": "Meat is all I want."},
        {"zh": "那块肉，我够不到", "en": "I cannot reach that piece of meat."},
        {"zh": "这实在太少。", "en": "Too little."},
        {"zh": "那我收下了。", "en": "I accept it."},
        {"zh": "这点肉，不够我一口", "en": "That is not even one mouthful for me."},
        {"zh": "还有第二块吗。", "en": "Is there a second piece?"},
        {"zh": "别伸手过头。", "en": "Do not reach above my head."},
        {"zh": "我不动手抢。", "en": "I do not take by force."},
        {"zh": "你喂我，我就留着。", "en": "Feed me, and I stay."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上了我的腿甲。", "en": "You struck my shin plate."},
        {"zh": "别从下面靠近。", "en": "Do not approach from below."},
        {"zh": "你撞歪了我的肩甲", "en": "You knocked my shoulder plate askew."},
        {"zh": "你先让开一些。", "en": "Move aside a little."},
        {"zh": "我从你头顶滑了过去", "en": "I slide over the top of your head."},
        {"zh": "别挡我的航线。", "en": "Don't block my flight path."},
        {"zh": "站稳了，撞到不怪我。", "en": "Hold your ground. Don't blame me for the bump."},
        {"zh": "让开，我这块头不小。", "en": "Move aside. I'm not exactly small."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只在锚点附近。", "en": "I stay near my anchor."},
        {"zh": "另一只在平原那边。", "en": "Another is out on the plain."},
        {"zh": "我们不在同一片空域。", "en": "We do not share the same airspace."},
        {"zh": "它飞得比我低。", "en": "It flies lower than I."},
        {"zh": "我们只是看了一眼。", "en": "We only glanced."},
        {"zh": "风把云推开了。", "en": "The wind pushes the clouds apart."},
        {"zh": "云下面很静。", "en": "It is quiet below the clouds."},
        {"zh": "有你并肩，我更有底气。", "en": "With you at my side, I stand even firmer."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "地上的东西，我看得见。", "en": "I can see that on the ground."},
        {"zh": "我俯下去拿。", "en": "I dip down to take it."},
        {"zh": "太沉，提不动。", "en": "Too heavy to lift."},
        {"zh": "我松开了口。", "en": "I let go."},
        {"zh": "是谁落下的。", "en": "Who dropped this?"},
        {"zh": "放回原处，别弄乱了。", "en": "Back where it was, do not disturb it."},
        {"zh": "我升上去了。", "en": "I climb away."},
        {"zh": "这玩意儿，我先收着。", "en": "I'll hang on to this thing for now."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "炮口转了过来，你在我射程里。", "en": "The muzzle turns; you are in my range."},
        {"zh": "炮口转了过来。", "en": "The muzzles turn."},
        {"zh": "我已经压低。", "en": "I have dropped low."},
        {"zh": "这一下，躲不开。", "en": "You cannot dodge this."},
        {"zh": "你一点别动，我这就俯冲。", "en": "Do not move at all; I dive now."},
        {"zh": "我数到二就开火。", "en": "I fire at two."},
        {"zh": "我可要开火了。", "en": "I am firing."},
        {"zh": "我这就俯冲。", "en": "I dive."},
        {"zh": "我飞得比跑得快，别赌。", "en": "I fly faster than you run; do not bet on it."},
        {"zh": "我已经算好提前量。", "en": "I have my lead worked out."},
        {"zh": "你的退路我看得见。", "en": "I can see where you would retreat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经没处躲。", "en": "There is nowhere to hide."},
        {"zh": "你往左，我跟左。", "en": "You go left, I follow left."},
        {"zh": "你的位置我算得清。", "en": "I can calculate your position."},
        {"zh": "加特林臂开始转起来", "en": "My Gatling arm begins to spin."},
        {"zh": "炮口已经热了。", "en": "My muzzles are hot."},
        {"zh": "就是这时候，加特林臂已经对准。", "en": "Now is the time; the Gatling arm is aimed."},
        {"zh": "我这就开火。", "en": "Firing now."},
        {"zh": "我从上方压住你的退路", "en": "I press down on your escape from above."},
        {"zh": "这一轮不会空。", "en": "This pass will not miss."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲下来。", "en": "I dive."},
        {"zh": "炮火跟着我。", "en": "My guns fire with me."},
        {"zh": "爪子和弹一起到。", "en": "Claws and rounds arrive together."},
        {"zh": "地面被打出坑。", "en": "The ground is pocked."},
        {"zh": "我一拉就升。", "en": "I pull up."},
        {"zh": "又转回来了。", "en": "And come around again."},
        {"zh": "这一轮，够了。", "en": "That pass was enough."},
        {"zh": "爪子和炮火一起落下", "en": "Claws and cannon fire fall together."},
        {"zh": "你还在动吗？", "en": "Still moving?"},
        {"zh": "那就再来一轮。", "en": "One more pass."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从空里浮出来。", "en": "I surface out of the air."},
        {"zh": "这里空域够大。", "en": "Enough airspace here."},
        {"zh": "我的甲还带着静电。", "en": "My armor still carries static."},
        {"zh": "我飞起来，地上的影子变小。", "en": "I rise, and my ground shadow shrinks."},
        {"zh": "风从这里过。", "en": "The wind comes through here."},
        {"zh": "草地在下面。", "en": "Grassland below."},
        {"zh": "远处是一片山。", "en": "Mountains far off."},
        {"zh": "没有别的数码兽。", "en": "No other Digimon."},
        {"zh": "我在这儿候着。", "en": "I am waiting here."},
        {"zh": "我把炮口转开。", "en": "I turn my muzzles away."},
        {"zh": "这里可以停。", "en": "This will do."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧过甲，我发烫。", "en": "Fire crossed the plating and I am hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高空落下，砸出一片土。", "en": "I fall from height and leave a crater."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进甲缝，我下沉。", "en": "Water in my seams and I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀得侧滚", "en": "The blast rolls me sideways."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西卡进我的甲。", "en": "Something is stuck in my armor."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的推进器停了一瞬。", "en": "My thrusters cut out for an instant."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有肉，力气就散。", "en": "Without meat my strength bleeds away."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我身上，甲全亮了。", "en": "Lightning hit me and my armor lit up."}
      ]
    }
  }
}
