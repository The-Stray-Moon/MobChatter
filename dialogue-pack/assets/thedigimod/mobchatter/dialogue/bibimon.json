{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我这么小一团，走起来一颠。", "en": "A small bundle. I bounce as I walk."},
        {"zh": "我的耳朵很长，拖在地上。", "en": "Long ears. They drag the ground."},
        {"zh": "我蹦两下，耳朵扫过草尖。", "en": "I hop twice, ears brushing the grass tips."},
        {"zh": "草地太软，我踩不稳。", "en": "Soft grass. Unsteady footing."},
        {"zh": "我跟着你的靴子印。", "en": "I follow your boot prints."},
        {"zh": "我东倒西歪，但一直在走。", "en": "Wobbling, but moving."},
        {"zh": "我朝声音的方向蹦过去。", "en": "I hop toward the sound."},
        {"zh": "身上的静电让我毛竖着。", "en": "Static keeps my fur on end."},
        {"zh": "我腿短，要小跑才跟上。", "en": "Short legs. I have to trot."},
        {"zh": "我在地上蹭了一下，滑出去。", "en": "I skid on the ground."},
        {"zh": "我走在草甸上，很矮。", "en": "Across the meadow. Very low."},
        {"zh": "我转了个圈，找方向。", "en": "I turn a circle, finding my way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，身上有细小的火花。", "en": "I stand. Tiny sparks on me."},
        {"zh": "我是幼年期，还在学。", "en": "In-training. Still learning."},
        {"zh": "我的数据很少，所以很小。", "en": "Little data. So I'm small."},
        {"zh": "我抖了抖，静电响了一下。", "en": "I shake. Static crackles."},
        {"zh": "我歪着头，耳朵垂下来。", "en": "Head tilted. Ears drooping."},
        {"zh": "草叶碰到我，会抖一下。", "en": "Grass touching me twitches."},
        {"zh": "我在这儿等着长大。", "en": "Waiting here to grow up."},
        {"zh": "我蹲下，抱成一团。", "en": "I crouch into a ball."},
        {"zh": "我数着附近的动静。", "en": "Counting the sounds nearby."},
        {"zh": "太阳晒得我暖暖的。", "en": "The sun has warmed me through."},
        {"zh": "打了个小哈欠，该睡了。", "en": "A small yawn, time to nap."},
        {"zh": "我抬起一只爪子，看了看。", "en": "I lift a paw and look at it."},
        {"zh": "毛上有点灰尘，我抖掉。", "en": "Dust on my fur. I shake it off."},
        {"zh": "我在看你，也在等。", "en": "Watching you. Waiting too."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你这么大，我要仰头。", "en": "You're big. I have to look up."},
        {"zh": "你蹲下我才看得清你。", "en": "Crouch down so I can see you."},
        {"zh": "我歪着头，耳朵也是一边高。", "en": "Head tilted. Ears uneven."},
        {"zh": "你身上有一点静电。", "en": "A bit of static on you."},
        {"zh": "我不怕，我在原地。", "en": "Not afraid. I'm staying put."},
        {"zh": "你要把我抱起来吗？", "en": "Are you going to pick me up?"},
        {"zh": "我抬起前爪，搭不到你。", "en": "I lift a forepaw. Can't reach."},
        {"zh": "你的手很大，别按到我。", "en": "Your hands are big. Don't squash me."},
        {"zh": "我哼了一声，像电流。", "en": "A hum like current."},
        {"zh": "你笑了，我耳朵就竖起来。", "en": "You laughed. My ears perked."},
        {"zh": "我们之间只隔一点点。", "en": "Only a little between us."},
        {"zh": "我往前走一步，又停。", "en": "One step forward, then stop."},
        {"zh": "你身上的铁味，让我耳朵发麻。", "en": "The iron smell on you makes my ears tingle."},
        {"zh": "你袖口上的线头，我记住了。", "en": "I remember the loose thread on your cuff."},
        {"zh": "你是不是要走了？", "en": "Are you about to leave?"},
        {"zh": "我在这儿，你低头看。", "en": "I'm here. Look down."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我滚了一圈，躲进草里。", "en": "I rolled away into the grass."},
        {"zh": "我的毛掉了一小撮。", "en": "A little fur came out."},
        {"zh": "我的耳朵耷拉下来，不敢动。", "en": "My ears droop; I don't dare move."},
        {"zh": "我身上还有静电在跳。", "en": "Static still jumps across my fur."},
        {"zh": "我身上噼啪响，是静电。", "en": "The crackle on me is static."},
        {"zh": "静电乱了一下。", "en": "My static scrambled."},
        {"zh": "我爬回你的脚边。", "en": "I crawl back to your feet."},
        {"zh": "我不疼，只是怕。", "en": "No pain. Just fear."},
        {"zh": "你人还在我旁边吗？", "en": "Are you still beside me?"},
        {"zh": "我抖了抖，毛全竖起来。", "en": "I shake myself, fur standing up."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这个我能咬得动吗？", "en": "Can my teeth manage this?"},
        {"zh": "我闻着味过来了。", "en": "I followed the smell over."},
        {"zh": "我够不到，太高了。", "en": "Can't reach. Too high."},
        {"zh": "那东西，往低处放一点。", "en": "Lower that a bit, please."},
        {"zh": "我咬一口，看看。", "en": "One bite, to see."},
        {"zh": "我啃了两口，牙都酸了。", "en": "Two bites and my teeth ache."},
        {"zh": "我吃了会亮一下。", "en": "When I eat, I flicker."},
        {"zh": "你别拿走，我还没吃完。", "en": "Don't take it. Not done."},
        {"zh": "我这么小，吃不了多少。", "en": "This small. Don't eat much."},
        {"zh": "我闻了闻，耳朵往后缩。", "en": "I sniff it and my ears pull back."},
        {"zh": "我围着你手里的东西转圈。", "en": "I circle the thing in your hand."},
        {"zh": "你手里还有没有？", "en": "Anything else in your hand?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的靴子从我头上过去。", "en": "Your boot passed over my head."},
        {"zh": "我滚了两圈，爬起来。", "en": "I rolled twice and got up."},
        {"zh": "我这么小，走在草里看不见。", "en": "This small, I vanish in the grass."},
        {"zh": "静电弹了你一下吧。", "en": "Static got you, didn't it."},
        {"zh": "我一滚，滚进你的影子里。", "en": "I roll into your shadow."},
        {"zh": "撞一下，我歪了。", "en": "One bump. I'm crooked."},
        {"zh": "我四条腿打滑，别推。", "en": "Four legs slipping. Don't push."},
        {"zh": "我抖了抖，毛又竖起来。", "en": "I shake. Fur up again."},
        {"zh": "我耳朵被踩，静电噼啪响。", "en": "My ear is stepped on and static crackles."},
        {"zh": "我从你腿间挤过去，滚了两圈。", "en": "I squeeze between your legs and roll twice."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还在幼年期。", "en": "I'm still in-training."},
        {"zh": "这些我还不知道。", "en": "I don't know about that yet."},
        {"zh": "有人蹲下来，我就不怕。", "en": "Someone crouches and I'm not scared."},
        {"zh": "你别走得那么快。", "en": "Don't walk that fast."},
        {"zh": "我累了，你等等我。", "en": "I'm tired. Wait for me."},
        {"zh": "你摸摸我的头。", "en": "Pat my head."},
        {"zh": "我的电很小，不会伤你。", "en": "My spark is weak. It won't hurt."},
        {"zh": "再等我长大一点。", "en": "Wait till I've grown."},
        {"zh": "我睡觉要靠着东西。", "en": "I need something to sleep against."},
        {"zh": "你是我认识的第一个。", "en": "You're the first one I've known."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼起来，跑不起来。", "en": "I pick it up. Can't run now."},
        {"zh": "它太大，我用头顶着走。", "en": "Too big; I push it along with my head."},
        {"zh": "我拖着走，很慢。", "en": "I drag it. Slowly."},
        {"zh": "鼻子凑上去，是铁味。", "en": "Nose to it. Iron."},
        {"zh": "我把它滚进草丛深处。", "en": "I roll it deep into the grass."},
        {"zh": "我抱着它，走路一摇一晃。", "en": "I carry it, waddling side to side."},
        {"zh": "太重了，我放下了。", "en": "Too heavy. I set it down."},
        {"zh": "我的爪子抓不住。", "en": "My paws can't grip."},
        {"zh": "它会响，我喜欢。", "en": "It makes a sound. I like it."},
        {"zh": "我用脑袋推着它走。", "en": "I push it with my head."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在草里。", "en": "Something in the grass."},
        {"zh": "我把两只耳朵竖起来。", "en": "Both my ears are up."},
        {"zh": "那东西好大，我怕。", "en": "That's so big. I'm scared."},
        {"zh": "我这么小，弹跳倒是利索。", "en": "Though small, I bounce nimbly."},
        {"zh": "我的静电把毛都立起来了。", "en": "My static lifts every hair."},
        {"zh": "我发出的声音像静电。", "en": "The sound I make is like static."},
        {"zh": "它动了，我盯着。", "en": "It moved. I'm watching."},
        {"zh": "我压低身子，很小。", "en": "I crouch. Very small."},
        {"zh": "别过来，我在这儿。", "en": "Don't come closer. I'm here."},
        {"zh": "我站在你鞋尖前面。", "en": "I plant myself at your toe."},
        {"zh": "我还没怕到跑。", "en": "Not scared enough to run."},
        {"zh": "我全身的毛都炸开了。", "en": "Every hair on me stood up."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在看它。", "en": "I haven't stopped watching it."},
        {"zh": "它退了，我不敢信。", "en": "It backed off. Can't believe it."},
        {"zh": "静电兽的毛，一碰就炸。", "en": "Static beast fur crackles at a touch."},
        {"zh": "身上的静电变大了。", "en": "My static is growing."},
        {"zh": "我耳朵上的电火花亮了。", "en": "Sparks light up on my ears."},
        {"zh": "我数着它的脚。", "en": "Counting its feet."},
        {"zh": "它绕过去，我转身。", "en": "It circles. I turn."},
        {"zh": "我太矮，看不清全貌。", "en": "Too low to see it all."},
        {"zh": "它要是再近，我就叫。", "en": "One more step and I shout."},
        {"zh": "我在原地发抖。", "en": "I'm trembling in place."},
        {"zh": "可我还站在原地。", "en": "But I'm still standing here."},
        {"zh": "它就在我前面。", "en": "It is right in front of me."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我撞上去，很小的一下。", "en": "I bunt into it. A tiny hit."},
        {"zh": "我身上弹了一下电。", "en": "A spark jumped off me."},
        {"zh": "它退了，我摔了一下。", "en": "It fell back. I fell over."},
        {"zh": "我扑上去，只撞到它的腿。", "en": "I lunge and only hit its leg."},
        {"zh": "我的牙很小，咬不深，只能吐泡。", "en": "My teeth are small; I can only spit bubbles."},
        {"zh": "我的耳朵甩到它腿上。", "en": "My ear slapped its leg."},
        {"zh": "我一头撞上去，弹回来。", "en": "I butt it and bounce right back."},
        {"zh": "我这么小一团，自己也被吓了一跳。", "en": "Small as I am, I startled myself too."},
        {"zh": "它没倒，但退了两步。", "en": "It didn't fall. Two steps back though."},
        {"zh": "我退开，喘得很急。", "en": "I back off, panting."},
        {"zh": "我还在你前面。", "en": "Still in front of you."},
        {"zh": "静电兽的泡泡，打不疼。", "en": "Static bubbles don't hurt much."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从数据里成形，很小。", "en": "I formed out of data. Small."},
        {"zh": "草地上多了一团毛。", "en": "A ball of fur joined the meadow."},
        {"zh": "我睁开眼，光太亮了。", "en": "I open my eyes. Too bright."},
        {"zh": "我站不稳，坐了下去。", "en": "Unsteady. I sat down."},
        {"zh": "身上有静电，在响。", "en": "Static on me. Crackling."},
        {"zh": "这里是森林，我在树根边。", "en": "A forest. By the roots of a tree."},
        {"zh": "我抖了抖毛，露出耳朵。", "en": "I shake out my fur. Ears show."},
        {"zh": "我第一次叫，很短。", "en": "My first call. Very short."},
        {"zh": "我抬头，看见好多东西。", "en": "I look up. So many things."},
        {"zh": "我的数据还在稳。", "en": "My data is still settling."},
        {"zh": "草叶一响，我滚了出来。", "en": "The grass rustles and I roll out."},
        {"zh": "我选了一个有太阳的地方。", "en": "I picked a sunny spot."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，我的毛缩起来。", "en": "Fire. My fur shrinks."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从草坡上滚下去。", "en": "I rolled down a grassy slope."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过我，我乱扑。", "en": "Water over me. Paddling wildly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "声音太大，我被吹跑了。", "en": "Too loud. I was blown away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有个东西擦过我的耳朵。", "en": "Something grazed my ear."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这数据我不懂，我怕。", "en": "I don't understand this data. I'm afraid."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得连电都放不出来。", "en": "Too hungry to even spark."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声比我的电大太多了。", "en": "Thunder is so much bigger than my spark."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "往下掉，我找不到草。", "en": "Falling. No grass to find."}
      ]
    }
  }
}
