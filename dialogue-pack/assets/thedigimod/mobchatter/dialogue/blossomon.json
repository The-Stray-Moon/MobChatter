    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "土里露出一点亮色", "en": "A glint shows through the soil."},
        {"zh": "它埋进花里了。", "en": "It is buried in the blossoms."},
        {"zh": "这个不是土壤。", "en": "Not soil."},
        {"zh": "我用藤把它放回土上", "en": "I set it back on the soil with a vine."},
        {"zh": "这枚东西还带着体温", "en": "This thing still holds warmth."},
        {"zh": "我用藤卷给你。", "en": "I hand it back with a vine."},
        {"zh": "它已经在发芽。", "en": "It has sprouted."},
        {"zh": "这倒有意思。", "en": "Interesting."}
      ]
