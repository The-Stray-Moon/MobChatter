        {"zh": "我的花在抖。", "en": "My blossoms are trembling."},
        {"zh": "你被藤逼退。", "en": "The vines forced you back."},
        {"zh": "那些藤还跟着。", "en": "The vines follow."},
        {"zh": "花粉在空气里。", "en": "Pollen is in the air."},
        {"zh": "我再缠一圈。", "en": "One more coil."},
        {"zh": "就快收完了。", "en": "Almost."},
        {"zh": "我把藤收紧。", "en": "Draw tight."},
        {"zh": "花朝着你开。", "en": "My blossoms open toward you."},
        {"zh": "藤还在往里收。", "en": "The vines keep drawing in."}
      ]
