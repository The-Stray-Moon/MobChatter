{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "花缠在我身上，走一步晃一下。", "en": "The blossoms sway with each step."},
        {"zh": "我三格宽，走起来很慢。", "en": "Three blocks wide. I move slowly."},
        {"zh": "我从花林里穿过。", "en": "I pass through the flower wood."},
        {"zh": "根我看不见，但脚在那儿。", "en": "I cannot see roots, but my feet are there."},
        {"zh": "我绕过一丛野蔷薇。", "en": "I go around a wild rose."},
        {"zh": "我走一步，花瓣就落。", "en": "Petals fall with each step."},
        {"zh": "这片林子，我很喜欢。", "en": "I like this wood."},
        {"zh": "我三格宽，挤过花丛", "en": "Three blocks wide, I squeeze through the flowers."},
        {"zh": "我朝着阳光走。", "en": "I walk toward the sun."},
        {"zh": "我的藤尖碰了碰草叶", "en": "The tip of my vine brushes a blade of grass."},
        {"zh": "我的藤蔓在地上拖。", "en": "My vines drag on the ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在原地开着花。", "en": "I bloom where I stand."},
        {"zh": "花瓣上有露水。", "en": "Dew on the petals."},
        {"zh": "我慢慢张开一朵。", "en": "I open one bloom slowly."},
        {"zh": "这些小东西在飞。", "en": "Little things are flying about."},
        {"zh": "我的藤蔓在动。", "en": "My vines are moving."},
        {"zh": "风把花粉吹走了。", "en": "The wind takes the pollen."},
        {"zh": "我只是开着。", "en": "I am only blooming."},
        {"zh": "我的根在土里伸了个懒腰", "en": "My roots stretch lazily through the soil."},
        {"zh": "我在听树说话。", "en": "I listen to the trees."},
        {"zh": "我闭上了一朵花。", "en": "One of my blooms closes."},
        {"zh": "这阳光很好。", "en": "The sun is good."},
        {"zh": "我还在生长。", "en": "I am growing."},
        {"zh": "只有花粉在光里飘", "en": "Only pollen drifts in the light."},
        {"zh": "我的香气很浓。", "en": "My scent is heavy."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你站进我的花里了。", "en": "You are standing in my flowers."},
        {"zh": "我这一身，都是活的。", "en": "All of this on me is alive."},
        {"zh": "你闻到了吗。", "en": "Do you smell it?"},
        {"zh": "我在看你身上的颜色。", "en": "I am looking at your colors."},
        {"zh": "你踩到我的藤了。", "en": "You stepped on my vine."},
        {"zh": "别摘我的花。", "en": "Do not pick my flowers."},
        {"zh": "我们都在长。", "en": "We are both growing."},
        {"zh": "你也会有花开吗。", "en": "Will you bloom too?"},
        {"zh": "你可以坐一会儿。", "en": "You may sit a while."},
        {"zh": "这里的花都归我。", "en": "These flowers are all mine."},
        {"zh": "我慢慢伸出一根藤。", "en": "I extend a vine slowly."},
        {"zh": "别怕，我不咬。", "en": "Do not fear. I do not bite."},
        {"zh": "我闻到你身上的土。", "en": "I smell earth on you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了几片花瓣。", "en": "A few petals fell."},
        {"zh": "我的花冠偏向一边", "en": "My flower crown tilts to one side."},
        {"zh": "这一下打进了花里。", "en": "That struck into the blossoms."},
        {"zh": "我把花转向你。", "en": "I turn my blooms toward you."},
        {"zh": "汁液流出来了。", "en": "Sap is running."},
        {"zh": "疼，可我还在长。", "en": "It hurts, and I still grow."},
        {"zh": "花瓣落了，藤还在", "en": "Petals fall, but the vines remain."},
        {"zh": "我还会再开。", "en": "I will bloom again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是植物吗。", "en": "Is that a plant?"},
        {"zh": "这个我吃得下。", "en": "I do eat that."},
        {"zh": "放到我藤边。", "en": "Set it by my vine."},
        {"zh": "这叶子很嫩。", "en": "This leaf is tender."},
        {"zh": "我慢慢卷过去。", "en": "I roll a vine toward it."},
        {"zh": "这点养分太少。", "en": "That is too little nourishment."},
        {"zh": "再给我一片。", "en": "Another leaf, please."},
        {"zh": "我的花一开，刺就露出来。", "en": "When my flowers open, the thorns show."},
        {"zh": "过几天会长出来。", "en": "It will grow in a few days."},
        {"zh": "这片叶子，我收下了", "en": "I accept this leaf."},
        {"zh": "你随时再来。", "en": "Come again."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，花瓣掉了。", "en": "You hit me and petals fell."},
        {"zh": "我的根退了一点。", "en": "My roots shift back a little."},
        {"zh": "我的藤很软。", "en": "My vines are soft."},
        {"zh": "你被花迷了眼。", "en": "Blossoms got in your eyes."},
        {"zh": "别踩我的根。", "en": "Do not tread on my roots."},
        {"zh": "花粉扬起来了。", "en": "Pollen rises."},
        {"zh": "我没有什么事。", "en": "I am fine."},
        {"zh": "你也没事吧。", "en": "You are unhurt too?"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "花开的时候，就是这样。", "en": "This is how it is when the flowers open."},
        {"zh": "它身上是另一种颜色。", "en": "It carries another color."},
        {"zh": "我们挨着站。", "en": "We stand close."},
        {"zh": "花粉在我们之间流。", "en": "Pollen drifts between us."},
        {"zh": "它比我先开。", "en": "Its blooms opened before mine."},
        {"zh": "我们一起合上。", "en": "We close together."},
        {"zh": "夜色落下来。", "en": "Night falls."},
        {"zh": "那些花还在。", "en": "The flowers remain."},
        {"zh": "两株花在暗处并排开", "en": "Two flowers open side by side in the dark."}
