{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飞着，翅膀切开风", "en": "I fly, my wings cutting the wind"},
        {"zh": "气流把我托在树冠之上。", "en": "The air holds me above the canopy."},
        {"zh": "我的爪收在身下", "en": "My claws tuck beneath me"},
        {"zh": "我在锚点上空盘旋", "en": "I circle above my anchor"},
        {"zh": "低空掠过，草尖全倒了。", "en": "Skimming low, I flatten the grass tips."},
        {"zh": "我朝主人那边飞去", "en": "I fly toward my tamer"},
        {"zh": "我的翅膀一扇就换了方向", "en": "One wingbeat changes my course"},
        {"zh": "我从云下穿过去", "en": "I pass beneath the clouds"},
        {"zh": "我在平原上画了个圈", "en": "I draw a circle over the plains"},
        {"zh": "我慢慢降低高度", "en": "I ease down in height"},
        {"zh": "我停在一根高枝上", "en": "I settle on a high branch"},
        {"zh": "我收起翅膀，落在你旁边", "en": "I fold my wings and land beside you"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在半空，慢慢扇翅", "en": "I hover, wings beating slowly"},
        {"zh": "我的翅膀边缘有一圈金属声", "en": "There's a metallic note at my wing edges"},
        {"zh": "我在高处看着这片地", "en": "I watch the ground from high"},
        {"zh": "我把爪子收到胸前", "en": "I draw my claws to my chest"},
        {"zh": "风把我的毛往后带", "en": "Wind pulls my coat back"},
        {"zh": "我在这儿等你开口", "en": "I'm here, waiting for you to speak"},
        {"zh": "我连呼吸都放得很轻", "en": "I keep even my breathing light"},
        {"zh": "云从旁边过去", "en": "Clouds pass alongside"},
        {"zh": "我落在一段岩脊上", "en": "I land on a ridge"},
        {"zh": "我在云层边绕圈，等你招手。", "en": "I circle by the clouds, waiting for your wave."},
        {"zh": "这里很高，看得清", "en": "It's high here; I can see clearly"},
        {"zh": "我又扇了一下翅膀", "en": "I beat my wings once more"},
        {"zh": "我的翅羽在风里响", "en": "My feathers sound in the wind"},
        {"zh": "我把飞行头盔歪向一侧", "en": "I cock my flight helm to one side"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我在高处俯看你", "en": "I look down on you from height"},
        {"zh": "你抬起头来了", "en": "You looked up"},
        {"zh": "我悬在你肩头的高度，看你。", "en": "I hover at your shoulder height and watch."},
        {"zh": "我认得你这个人", "en": "I know you"},
        {"zh": "你伸手，我落在你臂上", "en": "You reach up and I land on your arm"},
        {"zh": "我的爪子很轻", "en": "My claws are light"},
        {"zh": "你要我驮你吗", "en": "Shall I carry you"},
        {"zh": "我飞得又稳又平", "en": "My flight is steady"},
        {"zh": "你在下面跟着我走", "en": "Walk below and I'll keep pace"},
        {"zh": "我绕着你兜了半个圈", "en": "I wheel half a turn about you"},
        {"zh": "我收起翅膀，落在你脚边。", "en": "I fold my wings and land at your feet."},
        {"zh": "你看我的翅羽", "en": "Look at my wing feathers"},
        {"zh": "我等你拍拍我", "en": "I wait for your pat"},
        {"zh": "我一点也不怕高", "en": "Heights don't frighten me at all"},
        {"zh": "我一路都在你头顶", "en": "I've been overhead all along"},
        {"zh": "我这就落下来", "en": "I'm coming down"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我升起来一点", "en": "I rise a little"},
        {"zh": "我不受摔落伤，可翅膀会疼。", "en": "Falls do not hurt me, but my wings do."},
        {"zh": "我发出一声尖利的叫", "en": "I let out a shrill cry"},
        {"zh": "我落在树上歇脚", "en": "I land on a tree to steady"},
        {"zh": "一根铁羽被削断了。", "en": "An iron feather is sheared off."},
        {"zh": "我把翅膀重新张开", "en": "I spread my wings again"},
        {"zh": "我一动不动盯着它", "en": "I hold it in my stare"},
        {"zh": "我还能够飞起来", "en": "I can still fly"},
        {"zh": "我退到更高的地方", "en": "I withdraw to higher ground"},
        {"zh": "我等你一点点靠近", "en": "I wait for you to drift closer"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手上攥的什么", "en": "What's that in your hand"},
        {"zh": "那股味道钻进我鼻子", "en": "That smell reaches my nose"},
        {"zh": "我落下来看看", "en": "I come down to look"},
        {"zh": "这个东西能吃吗", "en": "Is this thing edible"},
        {"zh": "你把它往上举一举", "en": "Raise it up a little"},
        {"zh": "我够得着那儿", "en": "I can reach there"},
        {"zh": "我叼住就飞起来", "en": "I take it and lift off"},
        {"zh": "你别往下拽它", "en": "Don't pull it down"},
        {"zh": "我慢慢把它吃完", "en": "I eat it slowly"},
        {"zh": "吃完我再下来", "en": "I'll come down when I've finished"},
        {"zh": "这味道实在很好", "en": "This really does taste good"},
        {"zh": "你手里还有没有", "en": "Is there any more on you"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我往上飘了一点", "en": "You bump me and I float up"},
        {"zh": "我翅膀一偏就稳住了", "en": "A tilt of my wings steadies me"},
        {"zh": "你从我翅膀下面走过", "en": "You walk under my wing"},
        {"zh": "翅膀撞在一起，我翻了个身。", "en": "Our wings clash; I roll once."},
        {"zh": "我用爪子挡开你", "en": "I ward you off with a claw"},
        {"zh": "我落下来，站在你旁边", "en": "I land and stand beside you"},
        {"zh": "你的肩碰到我的翅", "en": "Your shoulder touches my wing"},
        {"zh": "我往旁边退开", "en": "I move off a little"},
        {"zh": "这一下连毛都没掉", "en": "That didn't even cost me a feather"},
        {"zh": "我一振翅又升了空", "en": "One beat and I'm airborne again"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "天上还有一只", "en": "There's another in the sky"},
        {"zh": "它的翅膀比我的长", "en": "Its wings are longer than mine"},
        {"zh": "我们在云下并飞", "en": "We fly side by side beneath the clouds"},
        {"zh": "我们一起转了个弯", "en": "We turn together"},
        {"zh": "它的金属声比我的清", "en": "Its metallic note is clearer than mine"},
        {"zh": "我们一起落在岩脊上", "en": "We land on the ridge together"},
        {"zh": "它把头靠过来", "en": "It leans its head over"},
        {"zh": "我们一起看着山谷", "en": "We look at the valley together"},
        {"zh": "什么都不用说", "en": "No words needed"},
        {"zh": "这一片天空够两个", "en": "This sky serves two"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用爪子把它扣住", "en": "I hook it with my claws"},
        {"zh": "它比我想的重", "en": "It's heavier than I expected"},
        {"zh": "我飞起来，它坠着", "en": "I lift off and it drags"},
        {"zh": "我落在树上歇一下", "en": "I stop on a tree to rest"},
        {"zh": "它从爪里滑了", "en": "It slips from my claws"},
        {"zh": "我俯冲下去接住", "en": "I dive and catch it"},
        {"zh": "这个我带回去", "en": "I'll take this back"},
        {"zh": "它有点发着亮", "en": "It's a little shiny"},
        {"zh": "那玩意儿我瞧不上", "en": "That thing doesn't interest me"},
        {"zh": "我把它扔下了", "en": "I let it drop"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西从下面来", "en": "Something's coming from below"},
        {"zh": "我把高度提了一些", "en": "I take a little more height"},
        {"zh": "我挡在你上方", "en": "I take the air above you"},
        {"zh": "我朝它俯冲下去", "en": "I dive at it"},
        {"zh": "它抬起头来了", "en": "It's looking up"},
        {"zh": "我的翅膀张开到最大", "en": "My wings spread to their widest"},
        {"zh": "我很清楚这个角度", "en": "I know this angle well"},
        {"zh": "你留在地面上", "en": "You stay on the ground"},
        {"zh": "我从高处斜掠下来", "en": "I slant down from above"},
        {"zh": "它根本躲不开", "en": "It can't dodge this"},
        {"zh": "我已经锁住它了", "en": "I've got it"},
        {"zh": "现在下手正合适", "en": "Now is the right moment"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "Mach Tornado 在我脚下成形。", "en": "Mach Tornado forms beneath my feet."},
        {"zh": "它抬头，我就偏开", "en": "It looks up and I veer"},
        {"zh": "我从侧面切下来", "en": "I cut down from the side"},
        {"zh": "我的爪子擦过它的背", "en": "My claws graze its back"},
        {"zh": "我拉起来，再转回来", "en": "I pull up and come around"},
        {"zh": "它一直在找我", "en": "It keeps searching for me"},
        {"zh": "我在它视野外", "en": "I'm outside its sight"},
        {"zh": "风是向着我的", "en": "The wind is with me"},
        {"zh": "我再一次俯冲", "en": "I dive again"},
        {"zh": "它开始慌起来了", "en": "It's starting to panic"},
        {"zh": "就差这一下了", "en": "One more and it's done"},
        {"zh": "我贴着它下来", "en": "I come down right along it"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲，爪子先到", "en": "I dive, claws first"},
        {"zh": "这一下撕开它的肩", "en": "That tears its shoulder"},
        {"zh": "我从它头顶掠过去", "en": "I sweep over its head"},
        {"zh": "翅膀的边缘划到它", "en": "My wing edge cuts it"},
        {"zh": "它转身，我又升起来", "en": "It turns and I rise again"},
        {"zh": "这一下我扑空了", "en": "I miss that one"},
        {"zh": "我落地，翻身再来", "en": "I land and come again"},
        {"zh": "我的爪子扣住它", "en": "My claws clamp on"},
        {"zh": "它把我甩了下去", "en": "It flings me off"},
        {"zh": "我在半空稳住", "en": "I steady in the air"},
        {"zh": "我从高处俯冲，爪子先落地。", "en": "I dive from above, claws first."},
        {"zh": "它的动作开始发钝", "en": "Its movements are going dull"}
      ]
    },
    "spawn": {
