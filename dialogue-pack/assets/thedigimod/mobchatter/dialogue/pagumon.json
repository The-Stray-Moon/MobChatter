{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小小地往前蹦。", "en": "I bounce forward, small as I am."},
        {"zh": "耳朵擦过草地。", "en": "My ears brush the grass."},
        {"zh": "两只短腿倒得快。", "en": "My short legs move quickly."},
        {"zh": "我跟着别的幼年期。", "en": "I follow the other babies."},
        {"zh": "地上留下小爪印。", "en": "Tiny claw marks on the ground."},
        {"zh": "我绕过一颗石子。", "en": "I go around a pebble."},
        {"zh": "我一下跳不高。", "en": "I can't jump very high."},
        {"zh": "我贴着队伍走。", "en": "I keep to the group."},
        {"zh": "锚点就在那边。", "en": "The anchor's right over there."},
        {"zh": "草有我半身高。", "en": "The grass is half my height."},
        {"zh": "我慢慢挪到前面。", "en": "I edge to the front."},
        {"zh": "身后还有几只。", "en": "A few more behind me."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "耳朵一动一动。", "en": "My ears twitch."},
        {"zh": "这里很热闹。", "en": "It's lively here."},
        {"zh": "我打了一个小嗝。", "en": "I gave a small burp."},
        {"zh": "同伴挤在一起。", "en": "My kin huddle together."},
        {"zh": "我闻了闻土。", "en": "I sniff the soil."},
        {"zh": "我软得像一团湿泥。", "en": "I'm as soft as wet mud."},
        {"zh": "我正四处张望。", "en": "I'm looking around."},
        {"zh": "我在等喂养员。", "en": "I'm waiting for the feeder."},
        {"zh": "我短短地叫了一声。", "en": "I give a short cry."},
        {"zh": "有只大的走过来。", "en": "A bigger one walks past."},
        {"zh": "我把肚子朝天。", "en": "I roll belly-up."},
        {"zh": "这块石头是热的。", "en": "This stone is warm."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是喂养员吗？", "en": "Are you the feeder?"},
        {"zh": "我肚子还饿。", "en": "I'm still hungry."},
        {"zh": "我这么小，不好吃吧。", "en": "I'm too small to eat, right?"},
        {"zh": "你的靴子比我大好多。", "en": "Your boots are far bigger than me."},
        {"zh": "我跟着你走可以吗。", "en": "May I follow you?"},
        {"zh": "你手里有东西吗。", "en": "Anything in your hand?"},
        {"zh": "我只会吐泡泡。", "en": "All I can do is blow bubbles."},
        {"zh": "你的味道我记着。", "en": "I know your smell."},
        {"zh": "蹲下来一点吧。", "en": "Crouch down a little."},
        {"zh": "我还不认识路。", "en": "I don't know the way yet."},
        {"zh": "你会带我回去吗。", "en": "Will you take me back?"},
        {"zh": "我耳朵很长吧。", "en": "My ears are long, aren't they."},
        {"zh": "我想睡觉了。", "en": "I want to sleep."},
        {"zh": "我小小地往前蹦，耳朵擦过草地。", "en": "I hop forward small, ears brushing the grass."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我耳朵塌下来了。", "en": "My ears dropped."},
        {"zh": "我小声地叫。", "en": "I cry quietly."},
        {"zh": "我腿上有点破。", "en": "A small scrape on my leg."},
        {"zh": "我把耳朵抱住。", "en": "I hug my ears in."},
        {"zh": "我还蹦得起来。", "en": "I can still bounce."},
        {"zh": "这伤对我来说很重。", "en": "That's a bad one for me."},
        {"zh": "我往同伴那边挪。", "en": "I edge toward my kin."},
        {"zh": "我记住你的靴子。", "en": "I remember your boots."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "给我分一点点。", "en": "Give me a little."},
        {"zh": "凑到我嘴边。", "en": "Bring it to my mouth."},
        {"zh": "我闻到饲料了。", "en": "I smell feed."},
        {"zh": "我一口就吃完。", "en": "I'll finish it in one bite."},
        {"zh": "还有吗还有吗。", "en": "Is there more? More?"},
        {"zh": "掉地上也能吃。", "en": "It's still edible off the ground."},
        {"zh": "我排在最前面。", "en": "I'm at the front of the line."},
        {"zh": "幼年期饲料，我一口就吞。", "en": "Baby feed — I gulp it down."},
        {"zh": "能不能再来一口。", "en": "Could I have one more bite?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得滚了圈。", "en": "I got rolled over."},
        {"zh": "我一撞就滚。", "en": "One bump and I roll."},
        {"zh": "你踩到我的耳朵。", "en": "You stepped on my ear."},
        {"zh": "我蹦到一边去。", "en": "I bounced aside."},
        {"zh": "耳朵当手用，爬得很稳。", "en": "I use my ears as hands and climb steady."},
        {"zh": "这一下撞得挺重。", "en": "That was a heavy bump."},
        {"zh": "地上都是草，滑。", "en": "The grass is slick."},
        {"zh": "我躲到队伍末尾。", "en": "I drop to the back of the line."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还小着呢。", "en": "I'm still little."},
        {"zh": "这个我不懂，别再问。", "en": "This I do not understand, stop asking."},
        {"zh": "喂养员会骂的。", "en": "The feeder would scold me."},
        {"zh": "你等我进化吧。", "en": "Wait till I evolve."},
        {"zh": "我们去吃饲料吧。", "en": "Let's go eat feed instead."},
        {"zh": "我耳朵会挡住。", "en": "My ears get in the way."},
        {"zh": "别都挤过来。", "en": "Don't all crowd in."},
        {"zh": "我有点困了。", "en": "I'm a little sleepy."},
        {"zh": "下次再说吧。", "en": "Ask me next time."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用嘴叼住。", "en": "I take it in my mouth."},
        {"zh": "地上有一小块。", "en": "A small piece on the ground."},
        {"zh": "我抱着它滚。", "en": "I roll with it in my paws."},
        {"zh": "这玩意儿能吃吗。", "en": "Can this thing be eaten?"},
        {"zh": "我把它藏在肚子下面。", "en": "I tuck it under my belly."},
        {"zh": "这是我找到的。", "en": "I found this one."},
        {"zh": "还有一点渣。", "en": "A few crumbs left."},
        {"zh": "这份幼年期饲料，我收下了。", "en": "This baby feed is mine now."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有个影子很大。", "en": "That shadow is big."},
        {"zh": "两只耳朵都立着。", "en": "Both ears are up."},
        {"zh": "草地在抖动。", "en": "The grass is shaking."},
        {"zh": "我听见大脚步。", "en": "I hear big footsteps."},
        {"zh": "我准备吐泡泡。", "en": "I'm ready to blow bubbles."},
        {"zh": "它没看我吧。", "en": "It didn't see me, did it."},
        {"zh": "大家散开了。", "en": "Everyone scattered."},
        {"zh": "我朝同伴那边跳。", "en": "I hop toward my kin."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它看向草这边。", "en": "It looked at the grass."},
        {"zh": "同伴都没出声。", "en": "My kin are silent."},
        {"zh": "等它的脚步过去。", "en": "Wait for its steps to pass."},
        {"zh": "我探出头看看。", "en": "I poke my head out."},
        {"zh": "现在安全了。", "en": "It's safe now."},
        {"zh": "我回去继续吃。", "en": "I go back to eating."},
        {"zh": "我数好了距离，泡泡够得到。", "en": "Distance measured; my bubble can reach."},
        {"zh": "它跑不掉了，我盯着呢。", "en": "It cannot get away; I have my eye on it."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我吐了泡泡！", "en": "I blew bubbles!"},
        {"zh": "我撞它的脚。", "en": "I bump its foot."},
        {"zh": "我一口咬住了，泡泡从牙缝里冒。", "en": "I clamped down; bubbles seep between my teeth."},
        {"zh": "我撞上去，自己先滚倒了。", "en": "I charge and roll over first."},
        {"zh": "我弹出去，滚了两圈。", "en": "I'm knocked away, rolling twice."},
        {"zh": "我退到后面。", "en": "I retreat behind."},
        {"zh": "再吐一口泡泡。", "en": "Another puff of bubbles."},
        {"zh": "它根本不理我。", "en": "It ignored me."},
        {"zh": "我飞快地蹦开。", "en": "I bounce away fast."},
        {"zh": "我朝它喷了一脸。", "en": "I sprayed it in the face."},
        {"zh": "泡泡啪地破了。", "en": "The bubble popped."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "草丛里冒出一小只。", "en": "A tiny one pops out of the grass."},
        {"zh": "我和同伴一起到了。", "en": "I arrived with my kin."},
        {"zh": "这里饲料很多。", "en": "Plenty of feed here."},
        {"zh": "森林里有点暗。", "en": "The forest is a little dark."},
        {"zh": "我找到锚点了。", "en": "I found the anchor."},
        {"zh": "我打喷嚏，吹起一小片土。", "en": "My sneeze puffs up a little dust."},
        {"zh": "又一窝出来了。", "en": "Another litter came out."},
        {"zh": "地上有草籽。", "en": "Grass seed on the ground."},
        {"zh": "我跟着最大的那只。", "en": "I follow the biggest one."},
        {"zh": "我朝草籽蹦过去。", "en": "I bounce toward the seeds."},
        {"zh": "今天会很热闹。", "en": "It'll be busy today."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "耳朵被烤卷了。", "en": "My ears curled in the heat."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我这么圆，摔了也不疼。", "en": "I'm round. The fall doesn't hurt."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水呛进我的鼻子。", "en": "Water in my nose."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我被吹得滚远了。", "en": "The blast rolled me away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "耳朵被扎了一下。", "en": "Something pierced my ear."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "亮光让我睁不开眼。", "en": "The light makes me squint."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得没力气。", "en": "Too hungry to move."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷声吓了我一跳。", "en": "The thunder frightened me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下没东西了。", "en": "Nothing under my feet."}
      ]
    }
  }
}
