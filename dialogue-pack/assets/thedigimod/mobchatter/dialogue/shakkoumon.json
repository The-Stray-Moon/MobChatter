{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "摔不下去，我索性飞着走。", "en": "I cannot fall, so I simply fly along."},
        {"zh": "我的身体像一口石钟。", "en": "My body is like a stone bell."},
        {"zh": "我身上覆着厚甲。", "en": "I'm covered in heavy plating."},
        {"zh": "我掠过沙丘的顶。", "en": "I skim the dune tops."},
        {"zh": "我的手臂短而沉。", "en": "My arms are short and heavy."},
        {"zh": "我身上有一圈圈的纹。", "en": "Rings of pattern run over me."},
        {"zh": "我在恶地上方移动。", "en": "I move above the badlands."},
        {"zh": "我飞得很稳。", "en": "I fly steadily."},
        {"zh": "我身上的石缝发出微光。", "en": "Light glows in my stone seams."},
        {"zh": "我转了个方向，很慢。", "en": "I turn, slowly."},
        {"zh": "我从白桦林上飞过。", "en": "I pass over the birches."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "身上落了一层沙。", "en": "A layer of sand settles on me."},
        {"zh": "我在听风从石缝过。", "en": "I listen to wind through my seams."},
        {"zh": "我的纹路在慢慢亮。", "en": "My patterns slowly brighten."},
        {"zh": "我不靠食物活。", "en": "I don't live on food."},
        {"zh": "我一身陶土，背上发光。", "en": "Clay all over, and my back glows."},
        {"zh": "我身上的光是暖的。", "en": "The light on me is warm."},
        {"zh": "我在等某个人。", "en": "I'm waiting for someone."},
        {"zh": "我的手抬到胸前。", "en": "My hand comes to my chest."},
        {"zh": "很远的地方有沙子响。", "en": "Sand shifts far off."},
        {"zh": "我身上的石缝在响。", "en": "My stone seams creak."},
        {"zh": "我一动不动地浮着。", "en": "I float, unmoving."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你没有恶意。", "en": "You mean no harm."},
        {"zh": "我身上有很老的纹。", "en": "Old patterns cover me."},
        {"zh": "你在想我是石像吗？", "en": "Do you think I'm a statue?"},
        {"zh": "我慢慢落下来一点。", "en": "I descend a little."},
        {"zh": "这里不是你应该来的。", "en": "You shouldn't be here."},
        {"zh": "我能看出你的心思。", "en": "I can read your intent."},
        {"zh": "我等你决定。", "en": "I wait for you to decide."},
        {"zh": "我没有先动手。", "en": "I didn't strike first."},
        {"zh": "你向后挪了挪。", "en": "You move back a little."},
        {"zh": "你这样做很明智。", "en": "That's wise of you."},
        {"zh": "我的纹路亮了一下。", "en": "My patterns brightened once."},
        {"zh": "你听见石头的声音了吗？", "en": "Did you hear the stone sound?"},
        {"zh": "那声音出自于我。", "en": "That sound came from me."},
        {"zh": "我在这块地上守了很久。", "en": "I've watched this ground long."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我晃了一下就稳住了。", "en": "I sway once and steady."},
        {"zh": "我移开半格。", "en": "I drift half a block."},
        {"zh": "我没有一点声息。", "en": "Not a sound."},
        {"zh": "沙从缝里落下来。", "en": "Sand falls from my seams."},
        {"zh": "我重新浮起来。", "en": "I rise again."},
        {"zh": "裂开的陶土，自己合上了。", "en": "The cracked clay closes itself."},
        {"zh": "我还在半空。", "en": "I'm still in the air."},
        {"zh": "这副甲胄，没那么容易碎。", "en": "This armor doesn't crack so easily."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那不是我能吃的。", "en": "That isn't something I eat."},
        {"zh": "我不吃东西，我靠光活着。", "en": "I do not eat; I live on light."},
        {"zh": "补给留给需要的人吧。", "en": "Leave the supplies for those who need them."},
        {"zh": "这光很好看。", "en": "That light is pretty."},
        {"zh": "我只在旁边看着。", "en": "I'll only watch from here."},
        {"zh": "这些你自己收好。", "en": "Keep these for yourself."},
        {"zh": "土偶的手，只能这样垂着。", "en": "These clay hands can only hang like this."},
        {"zh": "它在我旁边很亮。", "en": "It's bright beside me."},
        {"zh": "我感觉到它的温度。", "en": "I feel its warmth."},
        {"zh": "我不会拿走它。", "en": "I won't take it away."},
        {"zh": "你还是自己用。", "en": "Better you use it."},
        {"zh": "我在这里不需要。", "en": "I don't need it here."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，像撞钟。", "en": "You hit me like a bell."},
        {"zh": "我身上的沙落下来。", "en": "Sand falls off me."},
        {"zh": "地面被我压了一下。", "en": "The ground compresses."},
        {"zh": "我并不恼怒。", "en": "I'm not angered."},
        {"zh": "我升了半格。", "en": "I rise half a block."},
        {"zh": "这一下有一点回音。", "en": "There was a faint echo."},
        {"zh": "我是一只陶土般的兽。", "en": "I'm a beast shaped from clay."},
        {"zh": "撞上我这身甲，算你倒霉。", "en": "Run into this armor and that's your bad luck."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这具身体是合成来的。", "en": "This body was assembled."},
        {"zh": "两副装甲才拼成了一个我。", "en": "It took two sets of armour to make one of me."},
        {"zh": "我独自行事很久了。", "en": "I've acted alone a long time."},
        {"zh": "但我并不排斥。", "en": "But I don't object to one."},
        {"zh": "我在风里等。", "en": "I wait in the wind."},
        {"zh": "沙子一层层盖上来。", "en": "Sand layers over me."},
        {"zh": "我把沙抖下去。", "en": "I shake the sand off."},
        {"zh": "我还是等着。", "en": "I keep to my waiting."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用指尖碰了一下。", "en": "I touch it with a fingertip."},
        {"zh": "它小得可怜。", "en": "It's pitifully small."},
        {"zh": "我把它放进缝里。", "en": "I put it in a seam."},
        {"zh": "它在那里发亮。", "en": "It shines there."},
        {"zh": "地上的东西我不拿。", "en": "I don't pick things off the ground."},
        {"zh": "不用手，我把它滚到你脚边。", "en": "Without hands, I roll it to your feet."},
        {"zh": "我身上已经够沉了。", "en": "I'm heavy enough already."},
        {"zh": "我不需要收藏。", "en": "I don't need keepsakes."},
        {"zh": "你自己捡起来。", "en": "Pick it up yourself."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我察觉到了。", "en": "I've sensed it."},
        {"zh": "我转动身体。", "en": "I rotate my body."},
        {"zh": "我的纹路全亮了。", "en": "My patterns all light up."},
        {"zh": "它不是善意的。", "en": "It means no good."},
        {"zh": "手臂举了起来。", "en": "My arm comes up."},
        {"zh": "沙子在我脚下转。", "en": "Sand turns under me."},
        {"zh": "它朝我来了。", "en": "It's coming at me."},
        {"zh": "它先出的手。", "en": "It struck first."},
        {"zh": "那就很好了。", "en": "That's very good indeed."},
        {"zh": "我不必留手。", "en": "I needn't hold back."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘在半空，没有声音。", "en": "I float above, silent."},
        {"zh": "它跑得很快。", "en": "It runs fast."},
        {"zh": "我在它上方。", "en": "I'm above it."},
        {"zh": "沙子从它脚下扬起。", "en": "Sand kicks up under it."},
        {"zh": "它一步步逼近。", "en": "It closes in step by step."},
        {"zh": "我把手臂举高。", "en": "I lift my arm high."},
        {"zh": "土偶的眼，亮起一圈金光。", "en": "A ring of gold light kindles in my clay eyes."},
        {"zh": "它的速度变快。", "en": "Its speed increased."},
        {"zh": "前面是岩壁。", "en": "A rock wall ahead."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一拳砸下，沙全炸开。", "en": "My fist lands; the sand bursts."},
        {"zh": "它被震进了土里。", "en": "It's driven into the ground."},
        {"zh": "我的光穿过沙尘。", "en": "My light cuts through the dust."},
        {"zh": "它被打出去很远。", "en": "It's thrown far."},
        {"zh": "天界拳砸下，正中你的肩头。", "en": "Heaven's Knuckle crashes into your shoulder."},
        {"zh": "光打在地上，裂了一道。", "en": "The light strikes; the ground splits."},
        {"zh": "沙把我围住。", "en": "Sand surrounds me."},
        {"zh": "它冲了过来。", "en": "It charged in."},
        {"zh": "我把它挡住。", "en": "I blocked it."},
        {"zh": "土偶的拳头，落地成坑。", "en": "My clay fist lands and leaves a crater."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙里升起来。", "en": "I rise out of the sand."},
        {"zh": "身上落满了沙。", "en": "I'm covered in sand."},
        {"zh": "我的纹路第一次亮。", "en": "My patterns light for the first time."},
        {"zh": "白桦林上，我悬着不动。", "en": "Above the birches, I hover motionless."},
        {"zh": "土偶兽的泥身，慢慢转过来。", "en": "Shakkoumon's clay body turns slowly."},
        {"zh": "没有人在这里。", "en": "No one's here."},
        {"zh": "我留在原地等。", "en": "I stay and wait."},
        {"zh": "沙在脚下打转。", "en": "Sand turns under me."},
        {"zh": "我的影子映在石上。", "en": "My shadow falls on the stone."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的甲，纹路发白。", "en": "Fire heats my plating; the patterns bleach."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，砸出一个坑，却不受伤。", "en": "I land, leave a crater, and take no harm."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从缝里进来，我沉下去。", "en": "Water enters my seams; I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响被我挡在甲外。", "en": "The blast breaks on my plating."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物弹开了，留下一道白痕。", "en": "A point ricochets, leaving a white mark."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道术法想钻进我的缝。", "en": "The spell tries to get into my seams."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我很久没有补充了。", "en": "I haven't replenished in a long while."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着甲面下来，纹路全亮。", "en": "Lightning runs over my plating; every pattern glows."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有地，也没有沙。", "en": "No ground here, and no sand."}
      ]
    }
  }
}
