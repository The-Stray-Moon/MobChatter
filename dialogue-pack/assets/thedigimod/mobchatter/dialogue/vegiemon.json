{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一挪，走得很粗。", "en": "I shamble along, rough and heavy."},
        {"zh": "菜叶从头上一路垂下来。", "en": "Leaves hang down over my head."},
        {"zh": "我的身子，是菜堆成的。", "en": "My body is stacked vegetables."},
        {"zh": "我踩着林子里的落叶。", "en": "I tread the fallen leaves."},
        {"zh": "我走得不快，菜叶在晃。", "en": "Not fast; the leaves sway."},
        {"zh": "我一路走，一路掉叶。", "en": "I shed leaves as I go."},
        {"zh": "沼泽的泥，粘在我的脚上。", "en": "Swamp mud sticks to my feet."},
        {"zh": "我朝阴凉的地方走。", "en": "I head for the shade."},
        {"zh": "我身上有股烂菜味。", "en": "I smell of rotting greens."},
        {"zh": "我走起来，菜叶沙沙响。", "en": "My leaves rustle as I walk."},
        {"zh": "我在找潮湿的土。", "en": "I'm after damp soil."},
        {"zh": "这条路，我熟。", "en": "I know this route."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在树荫里，不动。", "en": "I stand in the shade, still."},
        {"zh": "有虫爬在我的菜叶上。", "en": "Bugs crawl on my leaves."},
        {"zh": "我身上的土，还没干。", "en": "The soil on me isn't dry."},
        {"zh": "我慢慢摆动身体。", "en": "I sway slowly."},
        {"zh": "我在吸收地面上的水。", "en": "I'm drawing up water from the ground."},
        {"zh": "林子里很潮。", "en": "The wood is damp."},
        {"zh": "菜叶在轻轻发抖。", "en": "My leaves quiver."},
        {"zh": "我在等林子暗下来。", "en": "I wait for the wood to darken."},
        {"zh": "这一片，很安静。", "en": "Very quiet here."},
        {"zh": "根须在土里伸开。", "en": "Roots spread in the soil."},
        {"zh": "我还在往高里长。", "en": "I'm still growing taller."},
        {"zh": "空气里有腐叶的味。", "en": "The smell of rotting leaves."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你那脚踩在我的菜叶上。", "en": "Your foot is on my greens."},
        {"zh": "我从菜叶堆里抬头看你。", "en": "I look up from my heap of leaves."},
        {"zh": "我不喜欢被摘。", "en": "I don't like being picked."},
        {"zh": "我这身菜，你摘不完。", "en": "You can't pick all of this."},
        {"zh": "你退开，是怕我这一身烂菜味。", "en": "You back off, wary of my rotting-vegetable stink."},
        {"zh": "我的根在土里。", "en": "My roots are in the soil."},
        {"zh": "别再靠近我这身湿泥。", "en": "Don't come near this wet muck."},
        {"zh": "我身上有毒吗？也许。", "en": "Poisonous? Perhaps."},
        {"zh": "一片菜叶朝你扬起。", "en": "One leaf lifts toward you."},
        {"zh": "你的靴子上都是泥。", "en": "Your boots are all mud."},
        {"zh": "我不需要被照顾。", "en": "I need no tending."},
        {"zh": "这棵树，是我靠着的。", "en": "This tree is what I lean on."},
        {"zh": "把刀收回去。", "en": "Put the blade away."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我晃了晃，站稳。", "en": "I wobble and steady."},
        {"zh": "这点伤，会长回来。", "en": "This will grow back."},
        {"zh": "土都震散了。", "en": "The soil shakes loose."},
        {"zh": "我拖着根慢慢避开。", "en": "I drag my roots clear."},
        {"zh": "菜叶上有了裂口。", "en": "A tear in my leaves."},
        {"zh": "我没叫，只是晃。", "en": "I don't cry out; I just sway."},
        {"zh": "汁液渗了出来。", "en": "Sap seeps out."},
        {"zh": "我还立在这儿。", "en": "I'm still standing here."},
        {"zh": "别拔我的根。", "en": "Not my roots."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我只要土和水。", "en": "I want only soil and water."},
        {"zh": "那东西闻着不错。", "en": "That does smell good."},
        {"zh": "你把东西埋进土里更好。", "en": "Better to bury it in the soil."},
        {"zh": "我的胃口，你不懂。", "en": "You wouldn't understand my appetite."},
        {"zh": "把肥料放低些，我够不着。", "en": "Set the fertilizer lower; I can't reach it."},
        {"zh": "这一口我领情了。", "en": "I'm grateful for that bite."},
        {"zh": "这土里养出来的，还行。", "en": "Grown from this soil — decent."},
        {"zh": "你把碗放低点。", "en": "Lower the bowl."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，像撞草堆。", "en": "You hit me like a haystack."},
        {"zh": "掉了几片叶子。", "en": "A few leaves fell."},
        {"zh": "我晃了晃，泥水四溅。", "en": "I sway and mud splashes out."},
        {"zh": "我这一身是烂软的。", "en": "This body of mine is pulpy."},
        {"zh": "泥蹭到你身上了。", "en": "Mud got on you."},
        {"zh": "我朝旁边让了一步。", "en": "I step aside."},
        {"zh": "菜叶被压扁了。", "en": "Some leaves are crushed."},
        {"zh": "这点碰撞，不碍事。", "en": "That bump is nothing."},
        {"zh": "你又踩到我的叶子。", "en": "You stepped on my leaves again."},
        {"zh": "我们错开吧。", "en": "Let's go around each other."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这种，不太需要。", "en": "My kind don't much need that."},
        {"zh": "林子里的同类，隔着很远。", "en": "Kin are far apart in this wood."},
        {"zh": "我更喜欢土。", "en": "I prefer soil."},
        {"zh": "这事，我不太懂。", "en": "I don't quite understand."},
        {"zh": "慢慢长着就好。", "en": "Growing slowly is enough."},
        {"zh": "我的根在这里。", "en": "My roots are here."},
        {"zh": "这个不必再问。", "en": "No need to ask that again."},
        {"zh": "我把根挪了个方向。", "en": "I shift my roots another way."},
        {"zh": "这些不重要。", "en": "These don't matter."},
        {"zh": "别出声就好。", "en": "Just keep quiet."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西多少有点用。", "en": "This has some small use."},
        {"zh": "我用根须卷住。", "en": "I curl a root around it."},
        {"zh": "掉在地上，我不捡了。", "en": "It fell; I leave it."},
        {"zh": "我用根须把它拨开。", "en": "I brush it aside with a root."},
        {"zh": "它在我手里发湿。", "en": "It grows damp in my hand."},
        {"zh": "这件我收起来了。", "en": "I've put this one away."},
        {"zh": "这点分量，不算什么。", "en": "Its weight is nothing."},
        {"zh": "这坨归我了，别浪费。", "en": "This lump is mine — don't waste it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "土里有动静。", "en": "Something moves in the soil."},
        {"zh": "我把头从土里抬起。", "en": "I lift my head from the soil."},
        {"zh": "那不是只虫子。", "en": "That's no bug."},
        {"zh": "泥里的东西转向那边。", "en": "I turn that way through the mud."},
        {"zh": "我的根在地上抓着。", "en": "My roots grip the ground."},
        {"zh": "你要踩过来吗？", "en": "Coming to tread on me?"},
        {"zh": "这一片林子，我很熟。", "en": "I know this wood well."},
        {"zh": "我开始挪了。", "en": "I'm shifting now."},
        {"zh": "别让我先动手。", "en": "Don't make me start."},
        {"zh": "我听见脚步压着落叶。", "en": "I hear steps pressing the leaves."},
        {"zh": "这一片，没别人。", "en": "No one else here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的叶子在抖。", "en": "My leaves are trembling."},
        {"zh": "这林子，没有直路。", "en": "No straight paths in this wood."},
        {"zh": "我不快，但不停。", "en": "Not fast, but I don't stop."},
        {"zh": "我身上的味道，很冲。", "en": "My smell is strong."},
        {"zh": "我等你踩空。", "en": "I wait for you to stumble."},
        {"zh": "泥土吸住了你的脚。", "en": "The mud grips your feet."},
        {"zh": "再凑过来些。", "en": "Come a bit closer."},
        {"zh": "站住，别再近一步。", "en": "Halt — not one step closer."},
        {"zh": "我的叶子张开了。", "en": "My leaves have opened."},
        {"zh": "树根绊住你的脚。", "en": "Roots snag your feet."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一拳砸过去！", "en": "My fist comes down!"},
        {"zh": "一片菜叶甩到你脸上。", "en": "A leaf slaps your face."},
        {"zh": "这点力气，很笨。", "en": "Clumsy, this strength."},
        {"zh": "我抱住你，很滑。", "en": "I grab you; I'm slippery."},
        {"zh": "你被烂菜味熏到了。", "en": "The rotten smell hits you."},
        {"zh": "别拔我的叶子。", "en": "Don't pull my leaves."},
        {"zh": "我整具身子压上去。", "en": "I put my whole body into it."},
        {"zh": "你被打退开了。", "en": "You were driven back."},
        {"zh": "从林子里出去。", "en": "Get out of the wood."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "湿泥翻开，我的根先探出来。", "en": "The wet soil parts; my roots come first."},
        {"zh": "菜叶上还挂着泥。", "en": "Mud still on my leaves."},
        {"zh": "这林子很潮，我喜欢。", "en": "Damp wood — I like it."},
        {"zh": "我先扎下根。", "en": "First I put down roots."},
        {"zh": "四周是落叶的味。", "en": "The smell of fallen leaves."},
        {"zh": "我从泥里直起腰。", "en": "I straighten up out of the muck."},
        {"zh": "这里很阴凉。", "en": "Good shade here."},
        {"zh": "我一身蔬菜，能载人。", "en": "All vegetables, and rideable."},
        {"zh": "我的叶子舒展开。", "en": "My leaves unfurl."},
        {"zh": "我看了看林子。", "en": "I look at the wood."},
        {"zh": "我今天长高了一点。", "en": "I'm a little taller today."},
        {"zh": "这儿的土松软。", "en": "The soil is loose here."},
        {"zh": "我从土里顶出来了。", "en": "I've pushed up out of the soil."},
        {"zh": "这里够安静。", "en": "Quiet enough here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我的菜叶就卷了。", "en": "Fire curls my leaves."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水泡着我，我沉下去。", "en": "Water soaks me; I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我叶子全飞了。", "en": "The blast blows off my leaves."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿过菜叶，汁水溅了一地。", "en": "An arrow through my leaves sprays juice everywhere."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我的根发麻。", "en": "That force numbs my roots."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "土干了，我也软了。", "en": "Dry soil, and I go limp."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我全身焦黑。", "en": "Lightning; I'm scorched black."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有土，我抓不住东西。", "en": "No soil; nothing to grip."}
      ]
    }
  }
}
