{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我六条腿轮流落地", "en": "My six legs take turns landing."},
        {"zh": "背甲硬得像铁", "en": "My shell is hard as iron."},
        {"zh": "翅膀在甲下收着", "en": "Wings folded under my shell."},
        {"zh": "甲虫的六条腿，沿着树根走。", "en": "Six beetle legs walk along the root."},
        {"zh": "触角扫过叶背", "en": "My antennae sweep the leaf undersides."},
        {"zh": "我在树上找虫", "en": "Looking for bugs."},
        {"zh": "那是我的吃食", "en": "That's my food."},
        {"zh": "听到一声细响", "en": "I catch a small sound."},
        {"zh": "我立刻停住脚", "en": "I stop at once."},
        {"zh": "我低下头去探", "en": "I dip my head low."},
        {"zh": "我有八只脚却走不快。", "en": "Eight legs, and I still walk slowly."},
        {"zh": "我找到方向了", "en": "Found the direction."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在树干上", "en": "I stop on a trunk."},
        {"zh": "六条腿抓着树皮", "en": "Six legs grip the bark."},
        {"zh": "甲壳反着一点光", "en": "My shell catches a little light."},
        {"zh": "触角慢慢地摆", "en": "Antennae sway slowly."},
        {"zh": "有只虫爬过来", "en": "A bug crawls near."},
        {"zh": "我贴着树皮一动不动。", "en": "I cling to the bark without moving."},
        {"zh": "让它再近一点", "en": "A little closer."},
        {"zh": "然后猛地一抓", "en": "Then grab."},
        {"zh": "这下可抓住了", "en": "Now I've got it."},
        {"zh": "我在树皮上擦擦嘴", "en": "I wipe my mouth on the bark."},
        {"zh": "那就继续等着", "en": "Wait for more."},
        {"zh": "这树上多的是", "en": "There's plenty on this tree."},
        {"zh": "再急也没用处", "en": "Rushing is useless."},
        {"zh": "我从来不缺时间", "en": "I'm not short of time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我抬起头，眼睛很多", "en": "I lift my head. Many eyes."},
        {"zh": "你个头非常大", "en": "You're very big."},
        {"zh": "我把六条腿收紧", "en": "I pull my six legs in."},
        {"zh": "甲壳正对着你", "en": "Shell toward you."},
        {"zh": "触角朝前伸着", "en": "Antennae forward."},
        {"zh": "我正在做判断", "en": "I'm judging."},
        {"zh": "你一直一动没动", "en": "You don't move."},
        {"zh": "那我也先不动", "en": "Then I won't either."},
        {"zh": "过了好一会儿", "en": "After a while."},
        {"zh": "我松开了一点", "en": "I relax a little."},
        {"zh": "你居然还在这", "en": "You're still there."},
        {"zh": "那我们就这么待着", "en": "Then we'll stay like this."},
        {"zh": "我一点不介意", "en": "I don't mind."},
        {"zh": "这树上有很多虫", "en": "There are bugs here."},
        {"zh": "我边看边吃着", "en": "I'll eat while I watch."},
        {"zh": "那你就随意吧", "en": "As you like."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我往树上缩去", "en": "I shrink against the tree."},
        {"zh": "六条腿紧紧抓着", "en": "Six legs clench."},
        {"zh": "甲上有道白痕", "en": "A white scratch on my shell."},
        {"zh": "我的硬壳被敲得发闷。", "en": "My hard shell rings dull under the blow."},
        {"zh": "电一下子放不出", "en": "The charge won't release."},
        {"zh": "我退开好几步", "en": "I back away several steps."},
        {"zh": "绕到了树后面", "en": "Around the trunk."},
        {"zh": "慢慢缓过劲来", "en": "And slowly recover."},
        {"zh": "六条腿还能动", "en": "Still able to move."},
        {"zh": "那便已经很好", "en": "Then that's good."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是一只虫吗", "en": "Is that a bug?"},
        {"zh": "我把身体前倾", "en": "I lean forward."},
        {"zh": "六条腿都动了一下", "en": "All six legs shift."},
        {"zh": "我用触角探了探", "en": "I probe it with an antenna."},
        {"zh": "不是一只虫子", "en": "No."},
        {"zh": "但也差不太多", "en": "But close."},
        {"zh": "我伸出一只前足", "en": "One foreleg reaches."},
        {"zh": "用前足碰了碰", "en": "Touches it."},
        {"zh": "居然真能咬动", "en": "It gives."},
        {"zh": "我用前足抱住那甜味。", "en": "I hug the sweet thing with my forelegs."},
        {"zh": "我叼到树干背面", "en": "I carry it round the trunk."},
        {"zh": "在那里吃完了", "en": "And finish it there."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被撞得贴在树上", "en": "I'm pressed against the trunk."},
        {"zh": "六条腿抓得更紧", "en": "Six legs tighten."},
        {"zh": "甲壳磕了一下", "en": "My shell knocks."},
        {"zh": "声音非常清脆", "en": "A crisp sound."},
        {"zh": "我往斜里挪开", "en": "I sidle away."},
        {"zh": "绕到树干后面", "en": "Around the back of the tree."},
        {"zh": "从另一边看你", "en": "Watching from the other side."},
        {"zh": "你居然还在原地", "en": "You're still there."},
        {"zh": "那我不出来了", "en": "Then I'm staying here."},
        {"zh": "这儿其实挺好", "en": "It's fine here."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "巢里有别的甲虫兽", "en": "Other Tentomon in the nest."},
        {"zh": "两根触角碰一下就懂了。", "en": "One touch of antennae and we understand."},
        {"zh": "碰一下是一个意思", "en": "One touch means one thing."},
        {"zh": "碰两下是另一个", "en": "Two touches another."},
        {"zh": "我不太擅长这些", "en": "I'm not much good at it."},
        {"zh": "碰错了会挨咬", "en": "A wrong touch earns a bite."},
        {"zh": "所以我少说话", "en": "So I say little."},
        {"zh": "多抓一些虫子", "en": "And catch more bugs."},
        {"zh": "这样更加实在", "en": "That's more reliable."},
        {"zh": "大家都这么觉得", "en": "Everyone agrees."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "前足一下夹住", "en": "A foreleg pins it."},
        {"zh": "送到口器前面", "en": "Brought to my mouthparts."},
        {"zh": "咬碎了吞下去", "en": "Crush, swallow."},
        {"zh": "我这对钳子，是甲虫的。", "en": "These pincers belong to a beetle."},
        {"zh": "我又爬了两步", "en": "I crawl two more steps."},
        {"zh": "树皮缝里还有", "en": "More in the bark gaps."},
        {"zh": "我一条一条地找", "en": "I search them one by one."},
        {"zh": "一共找到三只", "en": "I find three."},
        {"zh": "一顿算是不错", "en": "A decent meal."},
        {"zh": "吃完擦擦前足", "en": "Then I clean my forelegs."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "树皮上有东西在爬。", "en": "Something is crawling on the bark."},
        {"zh": "我转过去对着它", "en": "I turn toward it."},
        {"zh": "六条腿摆成架势", "en": "Six legs set in a stance."},
        {"zh": "甲壳下面开始响", "en": "A hum starts under my shell."},
        {"zh": "那是在积蓄电力", "en": "That's the charge building."},
        {"zh": "空气里飘着股味", "en": "A smell drifts in the air."},
        {"zh": "你听得见那声音", "en": "You can hear it."},
        {"zh": "那就还有时间退", "en": "So there's still time to step back."},
        {"zh": "可是你并没有", "en": "You don't."},
        {"zh": "我把翅膀张开一点", "en": "I open my wings slightly."},
        {"zh": "电在甲壳下走", "en": "Current runs under my shell."},
        {"zh": "那就尝尝小雷电", "en": "Petit Thunder."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你爬行", "en": "I crawl circles around you."},
        {"zh": "六条腿走得很稳", "en": "Six legs keep steady."},
        {"zh": "甲下的声音一直没停", "en": "The hum never stops."},
        {"zh": "你听到的是嗡声", "en": "What you hear is a buzz."},
        {"zh": "声音越来越密", "en": "Denser and denser."},
        {"zh": "我在等它蓄满", "en": "Wait for the charge to fill."},
        {"zh": "已经蓄了一半", "en": "Halfway."},
        {"zh": "现在就快满了", "en": "Almost."},
        {"zh": "我振翅悬在你头顶。", "en": "I hover over your head on buzzing wings."},
        {"zh": "我顺着它走开", "en": "I walk along it."},
        {"zh": "到尽头就是放电", "en": "At its edge, the discharge."},
        {"zh": "已经到尽头了", "en": "Here."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我把电放出去", "en": "I discharge."},
        {"zh": "电从甲缝里出去", "en": "Lightning leaves my shell."},
        {"zh": "打在你的护甲上", "en": "It hits your armor."},
        {"zh": "铁把电导开了", "en": "Iron spreads it out."},
        {"zh": "你身体抖了一下", "en": "You shudder."},
        {"zh": "我又蓄了一点", "en": "I gather a little more."},
        {"zh": "这次直接冲你", "en": "This time straight at you."},
        {"zh": "你赶紧退开了", "en": "You step clear."},
        {"zh": "电反而打中树", "en": "It hits a tree instead."},
        {"zh": "树皮炸开一块", "en": "Bark bursts."},
        {"zh": "我朝后面退去", "en": "I pull back."},
        {"zh": "再等下一次机会", "en": "Wait for the next one."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "树干上多了一块硬的", "en": "Something hard appears on the trunk."},
        {"zh": "那是我的背甲", "en": "That's my shell."},
        {"zh": "我慢慢展开六条腿", "en": "I unfold my six legs slowly."},
        {"zh": "翅膀也理了理", "en": "I settle my wings."},
        {"zh": "丛林里，我用六只脚爬出来。", "en": "In the jungle I crawl out on six legs."},
        {"zh": "虫子也相当多", "en": "And so are the bugs."},
        {"zh": "这地方非常合适", "en": "This spot is excellent."},
        {"zh": "我先爬上一圈", "en": "I crawl a circuit first."},
        {"zh": "先认认这地方", "en": "Getting the lay of it."},
        {"zh": "然后开始找吃的", "en": "Then start hunting."},
        {"zh": "我把触角立起来", "en": "I raise my antennae."},
        {"zh": "风向是从西边来的", "en": "The wind comes from the west."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "甲壳被烧得噼啪响", "en": "Heat crackles across my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时六腿散开", "en": "Six legs splay on landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我张不开翅", "en": "In water my wings won't open."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "我从枝头翻了个跟斗。", "en": "I tumble head over heels off the branch."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西打在背甲上", "en": "Something strikes my back plate."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "甲下的电乱了", "en": "The charge under my shell goes wild."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "树上找不到虫子了", "en": "No bugs left on this tree."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷和我体内的电撞在一起", "en": "Lightning clashes with the charge in me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这棵树没有了", "en": "The tree is gone."}
      ]
    }
  }
