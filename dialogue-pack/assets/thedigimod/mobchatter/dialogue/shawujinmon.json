{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着水边的滩涂走。", "en": "I walk the flats by the water."},
        {"zh": "我的身体很高，腿很沉。", "en": "I'm tall, and my legs are heavy."},
        {"zh": "我一只手大得不成比例。", "en": "One of my arms is out of proportion."},
        {"zh": "我走过的地方留下深印。", "en": "Deep prints stay where I pass."},
        {"zh": "我的腰上挂着东西。", "en": "Things hang at my waist."},
        {"zh": "我沿着河道慢慢走。", "en": "I walk slowly along the river."},
        {"zh": "我的头发挡住了一只眼。", "en": "My hair covers one eye."},
        {"zh": "我从沼泽里拔出一只脚。", "en": "I pull a foot out of the marsh."},
        {"zh": "我的这一边走得很稳。", "en": "This side of me walks steadily."},
        {"zh": "我在找能砍的树。", "en": "I'm looking for trees to cut."},
        {"zh": "我朝海滩那头去。", "en": "I head toward the beach."},
        {"zh": "我走在浅水里，水只到膝盖。", "en": "I walk the shallows; the water reaches my knees."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，把手臂垂下来。", "en": "I stand and let my arm hang."},
        {"zh": "我的手指轻轻敲着腿。", "en": "My fingers tap my leg."},
        {"zh": "水边的风很大。", "en": "The wind by the water is strong."},
        {"zh": "我在量那棵树有多粗。", "en": "I'm measuring how thick that tree is."},
        {"zh": "我身上有河泥的味道。", "en": "I smell of river mud."},
        {"zh": "我偏了偏脑袋。", "en": "I tip my head."},
        {"zh": "远处有鸟在水上。", "en": "Birds are on the water far off."},
        {"zh": "我在听木头的响声。", "en": "I listen to the wood creak."},
        {"zh": "我的肩膀有点酸。", "en": "My shoulder aches a little."},
        {"zh": "我另一条腿也酸了。", "en": "My other leg is aching too."},
        {"zh": "泥沙从我脚上流下来。", "en": "Silt runs off my feet."},
        {"zh": "我又把手臂抬起来。", "en": "I raise my arm again."},
        {"zh": "水里映出我的样子。", "en": "The water shows my shape."},
        {"zh": "我不赶什么时间。", "en": "I'm not pressed for time."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也来河边。", "en": "You came to the river too."},
        {"zh": "我垂眼看你。", "en": "I look down at you."},
        {"zh": "我这只手不太灵。", "en": "This hand of mine isn't very nimble."},
        {"zh": "你手里有斧子吗？", "en": "Do you have an axe?"},
        {"zh": "这浅滩连我脚背都盖不住。", "en": "These shallows can't even cover my feet."},
        {"zh": "我在这一带干活。", "en": "I work around here."},
        {"zh": "你离我这一步就够了。", "en": "One step further off is far enough."},
        {"zh": "我抬手就要动。", "en": "When I raise this arm, it moves."},
        {"zh": "我数了数你带来的东西。", "en": "I counted what you brought."},
        {"zh": "你退开我就不动。", "en": "Step back and I'll stay still."},
        {"zh": "我的脚在泥里陷着。", "en": "My feet are stuck in the mud."},
        {"zh": "那水声是我趟出来的。", "en": "That splashing you hear is me wading."},
        {"zh": "那是我走过。", "en": "That was me walking."},
        {"zh": "我整个人朝你转过来。", "en": "I turn my whole body toward you."},
        {"zh": "我不是来跟你打架的。", "en": "I didn't come here to fight you."},
        {"zh": "我在这里等活干。", "en": "I'm waiting for work here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我脚下一滑，踩碎一片水。", "en": "My foot slips and shatters a sheet of water."},
        {"zh": "我的手臂沉了一下。", "en": "My arm sags."},
        {"zh": "这一下撞得结实。", "en": "That connected solidly."},
        {"zh": "我闷着不响。", "en": "I keep quiet."},
        {"zh": "我身子一歪。", "en": "I lurch to one side."},
        {"zh": "泥沙从我身上落下。", "en": "Silt falls off me."},
        {"zh": "泥里扎稳了，我没事。", "en": "My feet are set in the mud; I'm fine."},
        {"zh": "这笔我记在木头账上。", "en": "I'll add this one to my tally of timber."},
        {"zh": "我还在河边。", "en": "I'm still at the river."},
        {"zh": "我不会离开。", "en": "I won't leave."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有河鲜的味。", "en": "Smell of river food."},
        {"zh": "你把东西放在木头上。", "en": "Put it on the log."},
        {"zh": "我摊开大手掌去接。", "en": "I open my big palm to take it."},
        {"zh": "这点不够我一顿。", "en": "That's not a meal for me."},
        {"zh": "我闻到了河鲜。", "en": "I smell river food."},
        {"zh": "它没我的手掌大。", "en": "It's smaller than my palm."},
        {"zh": "我慢慢地拿。", "en": "I take it slowly."},
        {"zh": "站远些，我的手臂长。", "en": "Stand further back; my arm is long."},
        {"zh": "我试着吃一口。", "en": "I try a bite."},
        {"zh": "这东西挺好吃。", "en": "This is pretty good."},
        {"zh": "再多给我一些。", "en": "Give me a bit more."},
        {"zh": "我把它收进腰里。", "en": "I tuck it at my waist."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我的膝盖。", "en": "You hit my knee."},
        {"zh": "我一下稳住没倒。", "en": "I keep my feet."},
        {"zh": "我们一挤，河水漫过脚背。", "en": "As we crowd together, river water spills over my feet."},
        {"zh": "我这副身子很重。", "en": "This body is heavy."},
        {"zh": "我把宽腰挪到一边。", "en": "I shift my broad waist to one side."},
        {"zh": "你的肩膀碰到我的腰。", "en": "Your shoulder met my waist."},
        {"zh": "泥沙被我们搅起来。", "en": "Silt churns around us."},
        {"zh": "这点推力小得很。", "en": "That push was small."},
        {"zh": "我把身子挺回来。", "en": "I straighten back up."},
        {"zh": "你被撞退两步。", "en": "The bump moves you back two steps."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "河边还有另一个。", "en": "There's another by the river."},
        {"zh": "她也在砍树。", "en": "She's cutting trees too."},
        {"zh": "我们把木头堆在一起。", "en": "We stack the logs together."},
        {"zh": "她看我把木头扛上肩。", "en": "She watches me shoulder a log."},
        {"zh": "我们一起往水边走。", "en": "We walk toward the water together."},
        {"zh": "她的手臂没我这么大。", "en": "Her arm isn't as large."},
        {"zh": "她把鱼分给我。", "en": "She shares the fish with me."},
        {"zh": "我们坐在浅水里。", "en": "We sit in the shallows."},
        {"zh": "她指着远处的林子。", "en": "She points at the trees beyond."},
        {"zh": "我朝她那边低下脑袋。", "en": "I lower my head toward her."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用大手掌夹起来。", "en": "I pinch it up in my big palm."},
        {"zh": "它还没我的指节大。", "en": "It's smaller than my knuckle."},
        {"zh": "我把它放到木堆上。", "en": "I set it on the log pile."},
        {"zh": "这块木头很湿。", "en": "This log is very wet."},
        {"zh": "我把它扛上肩。", "en": "I shoulder it."},
        {"zh": "这根我能砍。", "en": "I can cut this one."},
        {"zh": "我把它泡在水里。", "en": "I soak it in the water."},
        {"zh": "它浮起来了。", "en": "It floated up."},
        {"zh": "这样的木头我堆里有了。", "en": "I already have this kind in my pile."},
        {"zh": "我用指节把它拨回去。", "en": "I flick it back with a knuckle."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那片泥里有个东西在动。", "en": "Something is moving in that stretch of mud."},
        {"zh": "我抬起大手掌。", "en": "I raise my big palm."},
        {"zh": "水底的泥动了。", "en": "The mud below is moving."},
        {"zh": "它离河边太近了。", "en": "It's too close to the bank."},
        {"zh": "两只脚都踩进了河泥。", "en": "Both my feet are set in the river mud."},
        {"zh": "我整个身子扭向它。", "en": "I twist my whole frame toward it."},
        {"zh": "它背对着河。", "en": "Its back is to the river."},
        {"zh": "我蹚水过去。", "en": "I wade closer."},
        {"zh": "我的大手已经举好。", "en": "My big hand is ready."},
        {"zh": "我蹚着水又进一尺。", "en": "I wade one more foot forward."},
        {"zh": "我弯下了腰。", "en": "I bend down."},
        {"zh": "我伸手就能捞到它。", "en": "I can scoop it up from here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着河岸跟。", "en": "I follow along the bank."},
        {"zh": "河水只没到我小腿。", "en": "The river only comes up to my shins."},
        {"zh": "它绕过一段河岸。", "en": "It went round a bend."},
        {"zh": "我从浅水直接过。", "en": "I cut across the shallows."},
        {"zh": "我的脚印很沉。", "en": "My prints are heavy."},
        {"zh": "它的脸朝我这边偏过来。", "en": "Its face turns my way."},
        {"zh": "我的脚步没断。", "en": "My steps haven't broken."},
        {"zh": "它的脚印越来越清楚。", "en": "Its footprints are getting clearer."},
        {"zh": "它跑进林子里。", "en": "It ran into the trees."},
        {"zh": "树上挡不住我。", "en": "Trees won't stop me."},
        {"zh": "我把一根枝撞断了。", "en": "I break a branch off."},
        {"zh": "它站住了脚。", "en": "It came to a stop."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一掌推过去。", "en": "I shove with my palm."},
        {"zh": "它被推得退了很远。", "en": "It's pushed far back."},
        {"zh": "我的手臂连着转。", "en": "My arm keeps turning."},
        {"zh": "一串东西打出去。", "en": "A burst goes out."},
        {"zh": "它举起手挡。", "en": "It raised its hands."},
        {"zh": "我听见它出气的声音。", "en": "I hear it gasp."},
        {"zh": "水被搅得翻起来。", "en": "The water churns up."},
        {"zh": "我收住了手。", "en": "I hold my hand."},
        {"zh": "它还在支撑着。", "en": "It's still holding on."},
        {"zh": "我这只大手又举过肩。", "en": "My huge hand comes up past my shoulder again."},
        {"zh": "这一次更近。", "en": "This time closer."},
        {"zh": "它被我一掌拍进泥里。", "en": "One slap of my palm drives it into the mud."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "河滩上多了一个高影子。", "en": "A tall shape appears on the riverbank."},
        {"zh": "我从滩涂的浑水里立起。", "en": "I rise out of the silty shallows."},
        {"zh": "水从我腿上流下去。", "en": "Water runs off my legs."},
        {"zh": "泥软得陷进半个脚掌。", "en": "The mud is soft enough to swallow half my foot."},
        {"zh": "我甩掉臂上的水珠。", "en": "I shake the water off my arm."},
        {"zh": "树就在不远处。", "en": "Trees are close by."},
        {"zh": "我开始找活干。", "en": "I start looking for work."},
        {"zh": "风带着水味。", "en": "The wind carries water."},
        {"zh": "我朝林子走。", "en": "I head for the trees."},
        {"zh": "我一句话也没说。", "en": "I don't say a single word."},
        {"zh": "我找到了河岸。", "en": "I found the riverbank."},
        {"zh": "我沿河走起来。", "en": "I set off along the river."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤着我的胳膊，皮发紧。", "en": "Fire heats my arm; the skin tightens."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落地，泥被砸出一个坑。", "en": "I land and the mud takes a crater."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水漫过我的头，我拼命往上。", "en": "Water closes over my head; I push up."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我推得侧翻。", "en": "The blast knocks me sideways."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖刺进了我的膀子。", "en": "A point enters my upper arm."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道术法让我的手臂抬不起来。", "en": "The spell stops my arm from lifting."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得扛不动木头。", "en": "Too hungry to carry logs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我身上，泥都跳起来。", "en": "Lightning hits; the mud jumps."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有河，也没有泥。", "en": "No river here, no mud."}
      ]
    }
  }
}
