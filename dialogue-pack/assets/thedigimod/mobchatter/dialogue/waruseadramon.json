{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在水里游，无声无息。", "en": "I swim through the water without a sound."},
        {"zh": "身子很长，像一条蛇。", "en": "A long body, like a serpent."},
        {"zh": "海面在我上方很远。", "en": "The surface is far above me."},
        {"zh": "鳞片反射着幽蓝的光。", "en": "My scales give back a deep blue sheen."},
        {"zh": "我绕过珊瑚礁。", "en": "I weave around the coral."},
        {"zh": "水流从我两侧过去。", "en": "Water streams past my flanks."},
        {"zh": "我潜得很深。", "en": "I dive deep."},
        {"zh": "尾巴一摆，就滑出很远。", "en": "One tail stroke carries me far."},
        {"zh": "海里的路，我熟。", "en": "I know the sea's roads."},
        {"zh": "海底的沙，被我搅起来。", "en": "I stir the seabed sand."},
        {"zh": "我朝有船影的方向游。", "en": "I swim toward a ship's shadow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水中央。", "en": "I hang midwater."},
        {"zh": "水流绕着我的角。", "en": "Water curls around my horns."},
        {"zh": "这底下黑得没有边。", "en": "The dark below has no edge."},
        {"zh": "我在听远处的桨声。", "en": "I listen for distant oars."},
        {"zh": "我的鳍慢慢摆动。", "en": "My fins wave slowly."},
        {"zh": "深海没有光。", "en": "No light in the deep."},
        {"zh": "我张了张嘴，水进出。", "en": "I open my mouth; water flows."},
        {"zh": "我盘在一处礁石上。", "en": "I coil on a reef."},
        {"zh": "水压很大，我不在乎。", "en": "The pressure is heavy; I don't care."},
        {"zh": "我身上的水，一直往下滴。", "en": "Water drips off me endlessly."},
        {"zh": "远处的鱼群，绕开我。", "en": "The fish school goes around me."},
        {"zh": "我慢慢沉下去一截。", "en": "I sink a little lower."},
        {"zh": "海底太静了。", "en": "The seabed is too silent."},
        {"zh": "我又浮上一点。", "en": "I rise a little."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你那双脚踩在岸上。", "en": "Your feet are planted on the shore."},
        {"zh": "我浮起来看你。", "en": "I rise to look at you."},
        {"zh": "水里，我比你快。", "en": "In water I'm faster than you."},
        {"zh": "我身上的鳞很冷。", "en": "My scales are cold."},
        {"zh": "你的船太小了。", "en": "Your boat is too small."},
        {"zh": "我盘踞这片水很多年。", "en": "I've held these waters for years."},
        {"zh": "我绕你游了一整圈。", "en": "I swim a full circle around you."},
        {"zh": "别伸手进水里。", "en": "Don't put your hand in."},
        {"zh": "这张网，拦不住我。", "en": "That net won't hold me."},
        {"zh": "我抬起头，水面裂开。", "en": "I raise my head; the surface breaks."},
        {"zh": "你往岸上退了。", "en": "You've stepped back ashore."},
        {"zh": "这海，是我的。", "en": "This sea is mine."},
        {"zh": "我看得见你的脚。", "en": "I can see your feet."},
        {"zh": "别站在水里。", "en": "Don't stand in the water."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "鳞片裂了一道。", "en": "A crack in my scales."},
        {"zh": "我往下沉了半截身子。", "en": "I sink half my length lower."},
        {"zh": "水里有了血味。", "en": "Blood in the water."},
        {"zh": "鳞片裂了，游起来照样快。", "en": "A cracked scale; I still swim fast."},
        {"zh": "我盘紧了些。", "en": "I coil tighter."},
        {"zh": "我的鳍有点僵。", "en": "My fin is stiff."},
        {"zh": "这身长躯还能游。", "en": "This long body can still swim."},
        {"zh": "别碰我的鳃。", "en": "Not my gills."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "海鲜的味道。", "en": "The smell of seafood."},
        {"zh": "你在岸上举着它。", "en": "You hold it up on the shore."},
        {"zh": "这点东西太小。", "en": "That's too small."},
        {"zh": "你把鱼扔下来。", "en": "Throw the fish down."},
        {"zh": "水花一响，我就到。", "en": "One splash and I'm there."},
        {"zh": "这点诱饵，不够。", "en": "That bait is not enough."},
        {"zh": "我在水里兜了个圈。", "en": "I trace a ring in the water."},
        {"zh": "把它搁在岸上。", "en": "Leave it on the shore."},
        {"zh": "我只要活的。", "en": "I want only the living."},
        {"zh": "这点，不值一提。", "en": "That's hardly worth it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，很滑。", "en": "You hit me; I'm slick."},
        {"zh": "我的鳞很硬。", "en": "My scales are hard."},
        {"zh": "我退进深水里。", "en": "I retreat into deeper water."},
        {"zh": "泥沙被我们搅得发浑。", "en": "We've churned the silt cloudy."},
        {"zh": "我盘起来，又散开。", "en": "I coil and uncoil."},
        {"zh": "你在浅水里，很吃亏。", "en": "Shallow water is bad for you."},
        {"zh": "我慢慢绕开。", "en": "I slowly go around."},
        {"zh": "别抓我的鳍。", "en": "Don't grab my fin."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "深海里的同类，很少。", "en": "Few kin in the deep."},
        {"zh": "有时候会遇见一条。", "en": "Sometimes one passes by."},
        {"zh": "海里沉默，我们也沉默。", "en": "The sea is silent, and so are we."},
        {"zh": "一起游一段，就分开。", "en": "We swim a while, then part."},
        {"zh": "海里太大了。", "en": "The sea is vast."},
        {"zh": "我从不缺伴。", "en": "I've never wanted for company."},
        {"zh": "这片水域，我自己守着。", "en": "I hold these waters alone."},
        {"zh": "水声就是回答。", "en": "The water's sound is answer enough."},
        {"zh": "这事我不答。", "en": "I won't answer that."},
        {"zh": "我一沉，没入深水。", "en": "I sink into the deep."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我张嘴把鱼整个含住。", "en": "I take the whole fish in my jaws."},
        {"zh": "这东西在水里沉。", "en": "It sinks in the water."},
        {"zh": "我猛一甩头，水花四溅。", "en": "One head toss sends spray flying."},
        {"zh": "我把它拖到礁边。", "en": "I drag it to the reef."},
        {"zh": "它从牙间滑走了。", "en": "It slid from between my teeth."},
        {"zh": "我吞了下去。", "en": "I swallowed it."},
        {"zh": "我留给同类。", "en": "I leave it for kin."},
        {"zh": "海洋里的东西，都归我管辖。", "en": "Everything in the ocean falls under my rule."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "岸上有东西。", "en": "Something's on the shore."},
        {"zh": "我浮上去了。", "en": "I'm rising."},
        {"zh": "水面下，我在靠近。", "en": "Below the surface, I close in."},
        {"zh": "你落进我的眼里了。", "en": "You've fallen into my sight."},
        {"zh": "这一带水很深。", "en": "The water's deep here."},
        {"zh": "我前半身高高竖起。", "en": "My forebody rears high."},
        {"zh": "你踩进浅水，我的长身已经缠上来。", "en": "You step into the shallows; my long body already coils."},
        {"zh": "海风把气味带过来。", "en": "The sea wind carries your scent."},
        {"zh": "我记下位置。", "en": "Position noted."},
        {"zh": "就趁这一刻。", "en": "At this very moment."},
        {"zh": "我从水下冲上来。", "en": "I surge up from below."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在水面下。", "en": "I've been under the surface all along."},
        {"zh": "你的船，我看得清。", "en": "I see your boat clearly."},
        {"zh": "水波开始乱了。", "en": "The ripples are going wrong."},
        {"zh": "我等着它再近些。", "en": "I wait for it to come nearer."},
        {"zh": "我的尾巴扫过船底。", "en": "My tail brushes the hull."},
        {"zh": "船底那道划痕，是我的牙。", "en": "That scrape under the boat is my tooth."},
        {"zh": "我把长颈探出水面。", "en": "I lift my long neck from the water."},
        {"zh": "海水在我嘴里。", "en": "Seawater in my mouth."},
        {"zh": "再靠近半尺。", "en": "Half a foot closer."},
        {"zh": "维持这个距离。", "en": "Keep this distance."},
        {"zh": "我摆尾冲了出去。", "en": "I whip my tail and surge."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬住船沿！", "en": "I bite the boat's edge!"},
        {"zh": "海浪风暴，来了。", "en": "Ocean Storm — here."},
        {"zh": "身子一卷，把你拖下水。", "en": "One coil drags you under."},
        {"zh": "我的角很硬。", "en": "My horns are hard."},
        {"zh": "这一下，水花四溅。", "en": "That threw up spray."},
        {"zh": "你在水里挣不动。", "en": "You can't fight the water."},
        {"zh": "我的尾巴抽过去。", "en": "My tail lashes out."},
        {"zh": "你喘不上气了。", "en": "You can't get air."},
        {"zh": "我把身子松开了。", "en": "I loosen my coils."},
        {"zh": "海面又平了。", "en": "The surface smooths again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从深海浮上来。", "en": "I rise from the deep."},
        {"zh": "蓝光在水下移动。", "en": "Blue light moves underwater."},
        {"zh": "这片海，很浅。", "en": "This sea is shallow."},
        {"zh": "我抬起头，水往下淌。", "en": "I raise my head; water pours off."},
        {"zh": "四周没有船。", "en": "No boats around."},
        {"zh": "海那头有陆地。", "en": "There's land across the water."},
        {"zh": "水里有活物的味。", "en": "Living scent in the water."},
        {"zh": "我一摆尾游了过去。", "en": "One tail stroke carries me over."},
        {"zh": "我上来探个究竟。", "en": "I've come up to see."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在水面上烧，烫着我的背。", "en": "Fire burns on the surface, scalding my back."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我重重砸进水里，水花很高。", "en": "I crash into the water; the splash is high."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水不该让我窒息，可这水不对。", "en": "Water shouldn't choke me, but this one does."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "水里一震，我翻了个身。", "en": "The blast rolls me over."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量压住了我的鳍。", "en": "That force pins my fins."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，我游得更慢。", "en": "Hungry, and I swim slower."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有水了，我直往下。", "en": "No water left; I fall."}
      ]
    }
  }
}
