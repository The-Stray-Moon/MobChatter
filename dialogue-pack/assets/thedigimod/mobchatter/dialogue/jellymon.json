{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘在水面上往前。", "en": "I drift forward over the water."},
        {"zh": "我贴着浪尖浮过去。", "en": "I skim across the wave tops."},
        {"zh": "我的触手在水里拖。", "en": "My tendrils drag in the water."},
        {"zh": "我在海滩上跳了两下。", "en": "I bounce twice on the beach."},
        {"zh": "我绕着河湾转。", "en": "I circle the river bend."},
        {"zh": "浑水也托得住我。", "en": "Even murky water holds me up."},
        {"zh": "我朝有浪声的地方去。", "en": "I head toward the sound of surf."},
        {"zh": "我浮得比水面高一点。", "en": "I float a little above the surface."},
        {"zh": "我顺着水流的方向飘。", "en": "I drift with the current."},
        {"zh": "我的边沿一鼓一收。", "en": "My rim swells and draws in."},
        {"zh": "我在礁石间穿过去。", "en": "I pass between the rocks."},
        {"zh": "我慢慢落到沙上。", "en": "I settle onto the sand."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水面上。", "en": "I hang above the water."},
        {"zh": "我的身体半透明。", "en": "My body is half clear."},
        {"zh": "我在听潮水的节奏。", "en": "I listen to the tide's rhythm."},
        {"zh": "一只蟹爬过我的下面。", "en": "A crab crawls beneath me."},
        {"zh": "抖了抖，水珠四散。", "en": "Shook myself. Water flew everywhere."},
        {"zh": "我在等主人叫。", "en": "I wait for my owner's call."},
        {"zh": "我的光很淡。", "en": "My glow is faint."},
        {"zh": "我在河面上转了一圈。", "en": "I turn once over the river."},
        {"zh": "我的边沿碰到水草。", "en": "My rim touches the weeds."},
        {"zh": "我抬起来一点。", "en": "I lift a little."},
        {"zh": "我在等一顿海鲜。", "en": "I wait for a seafood meal."},
        {"zh": "我数着浪来的次数。", "en": "I count the waves."},
        {"zh": "这里很凉快。", "en": "It's cool here."},
        {"zh": "我喜欢水汽。", "en": "I like the damp air."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我漂在浅水里，看你的脚。", "en": "I drift in the shallows and watch your feet."},
        {"zh": "你的靴子全湿了。", "en": "Your boots are soaked."},
        {"zh": "我在你上方飘着。", "en": "I'm floating above you."},
        {"zh": "你袖口沾着海味。", "en": "Your cuff smells of the sea."},
        {"zh": "我可不惧你。", "en": "I'm not afraid of you."},
        {"zh": "我只会电你一下。", "en": "I'd only shock you once."},
        {"zh": "水下的触手，你看不见。", "en": "You cannot see the tentacles under the water."},
        {"zh": "这片水面归我。", "en": "This stretch of water is mine."},
        {"zh": "你走路的姿势很笨。", "en": "You walk awkwardly."},
        {"zh": "我在这儿笑你。", "en": "I'm laughing at you from here."},
        {"zh": "我可以跟你回去。", "en": "I could come home with you."},
        {"zh": "你得先给我吃的。", "en": "You'd have to feed me first."},
        {"zh": "这味道我在哪闻过。", "en": "I've smelled this somewhere."},
        {"zh": "有点咸。", "en": "A little salty."},
        {"zh": "我慢慢沉下来。", "en": "I descend slowly."},
        {"zh": "你眨眼，我跟着亮一下。", "en": "You blink; I flicker in answer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的边沿破了一点。", "en": "A nick in my rim."},
        {"zh": "我沉下去又浮上。", "en": "I sink and rise again."},
        {"zh": "水变浑了一点。", "en": "The water clouded a little."},
        {"zh": "我飘在水面上发麻。", "en": "I float on the water, tingling."},
        {"zh": "别用力捏。", "en": "Don't squeeze hard."},
        {"zh": "我变淡了。", "en": "I've grown faint."},
        {"zh": "我退到水草后。", "en": "I retreat behind the weeds."},
        {"zh": "我还能飘。", "en": "I can still float."},
        {"zh": "我的边缘皱了一圈。", "en": "My rim has puckered all around."},
        {"zh": "我不高兴。", "en": "I'm not pleased."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是鱼吗？还是水母？", "en": "Is that a fish? Or a jellyfish?"},
        {"zh": "抛到水里来。", "en": "Throw it into the water."},
        {"zh": "我闻到海味了。", "en": "I smell the sea."},
        {"zh": "一条小鱼，只够垫底。", "en": "One small fish barely fills the bottom."},
        {"zh": "你得剥开。", "en": "You'll have to open it."},
        {"zh": "我在水面上接。", "en": "I'll catch it at the surface."},
        {"zh": "这虾还活着。", "en": "This shrimp is still alive."},
        {"zh": "你真是懂我。", "en": "You understand me."},
        {"zh": "再给我一只。", "en": "Another one, please."},
        {"zh": "我吃的时候会发光。", "en": "I glow when I eat."},
        {"zh": "你手别收。", "en": "Don't pull your hand back."},
        {"zh": "这是新鲜的海味。", "en": "This is fresh seafood."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到了我的边沿。", "en": "You touched my rim."},
        {"zh": "你的膝盖陷进我身体。", "en": "Your knee sank into my body."},
        {"zh": "手指戳进我的边沿了。", "en": "Your finger poked into my rim."},
        {"zh": "你的手臂麻了一下吧？", "en": "Your arm went numb, didn't it?"},
        {"zh": "我飘到你另一边。", "en": "I drift to your other side."},
        {"zh": "这点碰我就散一点。", "en": "At that touch I shed a bit."},
        {"zh": "我贴在你手背上。", "en": "I cling to the back of your hand."},
        {"zh": "你一甩我就掉了。", "en": "One shake and I'm off."},
        {"zh": "水花把我遮住了。", "en": "The splash covers me."},
        {"zh": "再撞我就放电。", "en": "Bump again and I'll discharge."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还小呢。", "en": "I'm still small."},
        {"zh": "我只想玩。", "en": "I only want to play."},
        {"zh": "水里同类很多。", "en": "Plenty of my kind in the water."},
        {"zh": "你先喂我。", "en": "Feed me first."},
        {"zh": "我的边沿会疼。", "en": "My rim would hurt."},
        {"zh": "你连水都站不稳。", "en": "You can't even stand in water."},
        {"zh": "我要去追浪。", "en": "I'm off to chase the waves."},
        {"zh": "这事以后再说。", "en": "Ask me later."},
        {"zh": "我要玩去了。", "en": "I'm going to play."},
        {"zh": "别拦我。", "en": "Don't stop me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一条小鱼，我卷住。", "en": "A small fish, I curl around it."},
        {"zh": "我用触手拖过来。", "en": "I pull it in with a tendril."},
        {"zh": "壳太硬，我的触手撕不开。", "en": "Too hard a shell; my tentacles cannot tear it."},
        {"zh": "是贝肉，还是虾？", "en": "Is this shellfish or shrimp?"},
        {"zh": "有点腥，但能咽。", "en": "A little fishy, but it goes down."},
        {"zh": "沙子里还埋着另一只。", "en": "Another one is buried in the sand."},
        {"zh": "我把它收在身下。", "en": "I tuck it under myself."},
        {"zh": "有人会来抢。", "en": "Someone might take it."},
        {"zh": "半条鱼，不顶饱。", "en": "Half a fish does not fill me."},
        {"zh": "再找找。", "en": "I'll look for more."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的脚泡在水里了。", "en": "Your feet are in the water."},
        {"zh": "高度刚好。", "en": "Just the right height."},
        {"zh": "我的边沿在聚电。", "en": "My rim is charging."},
        {"zh": "你退得很慢。", "en": "You retreat slowly."},
        {"zh": "水拖住了你的步。", "en": "The water drags at your steps."},
        {"zh": "轻轻碰一下就够。", "en": "A light touch is enough."},
        {"zh": "水里的电流，会先找到你。", "en": "In the water, the current finds you first."},
        {"zh": "那对我不利。", "en": "That's bad for you."},
        {"zh": "我把身体压到水面。", "en": "I press my body down to the surface."},
        {"zh": "Petit Thunder 准备好了。", "en": "Petit Thunder is ready."},
        {"zh": "先别出声。", "en": "Don't make a sound."},
        {"zh": "该电他一下了。", "en": "Time to give a shock."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘在你侧后。", "en": "I drift at your flank."},
        {"zh": "水面映着你的影子。", "en": "The surface shows your shadow."},
        {"zh": "我的影子在里面。", "en": "Mine is in it too."},
        {"zh": "你一直没发现。", "en": "You never noticed."},
        {"zh": "你的动作变了。", "en": "Your movements changed."},
        {"zh": "水波让我的位置模糊。", "en": "Ripples blur my position."},
        {"zh": "我数着你的喘息。", "en": "I count your gasps."},
        {"zh": "你的肩膀绷得很紧。", "en": "Your shoulders are tight."},
        {"zh": "再挨近一些。", "en": "A little nearer."},
        {"zh": "你踩到石头了。", "en": "You found a stone."},
        {"zh": "那更好了。", "en": "Even better."},
        {"zh": "看这边。", "en": "Look this way."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的触手贴上你的手。", "en": "My tendril touches your hand."},
        {"zh": "一道小电流过去。", "en": "A small current passes."},
        {"zh": "你手一抖，东西掉了。", "en": "Your hand jerks; you drop it."},
        {"zh": "电放完，我就漂走。", "en": "The charge spent, I drift away."},
        {"zh": "海蜇的身体，打上去是软的。", "en": "Hit a jelly body and it gives."},
        {"zh": "你手臂上留了个印。", "en": "A mark left on your arm."},
        {"zh": "电光散了，我重新升起。", "en": "The sparks fade and I rise again."},
        {"zh": "你甩不掉水。", "en": "You can't shake the water off."},
        {"zh": "下一发会响一点。", "en": "The next one will crack louder."},
        {"zh": "退了就对了。", "en": "Backing off is the right move."},
        {"zh": "这样才像话。", "en": "That's more like it."},
        {"zh": "到此收手吧。", "en": "Let's stop here."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上浮起一团淡光。", "en": "A pale glow rises on the water."},
        {"zh": "我从浪里冒出来。", "en": "I pop up out of a wave."},
        {"zh": "河湾多了一点亮。", "en": "A little brightness in the river bend."},
        {"zh": "我先在水上转一圈。", "en": "I circle the water once."},
        {"zh": "沙滩上有我的影。", "en": "My shadow on the sand."},
        {"zh": "我的边沿慢慢撑开。", "en": "My rim slowly opens."},
        {"zh": "浅滩的温度刚好。", "en": "The shallows are just the right warmth."},
        {"zh": "我听见鱼在跳。", "en": "I hear fish jumping."},
        {"zh": "我飘到浅一点的地方。", "en": "I drift to shallower water."},
        {"zh": "有人在岸边。", "en": "Someone is on the bank."},
        {"zh": "我缓缓浮近。", "en": "I drift nearer."},
        {"zh": "我从水下探出半个身子。", "en": "I bring half my body up from below."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一碰水汽，我就缩了。", "en": "Fire hits the damp and I shrink."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会摔疼，可落地那下很闷。", "en": "Falls don't hurt, but the landing is dull."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
