      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "水柱炸起来，我被冲开。", "en": "Water bursts up and washes me away."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西穿过我的身体。", "en": "That passed through my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力让我整团发亮。", "en": "Magic lights my whole body up."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有鱼，我越来越淡。", "en": "No fish, and I fade."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打进水里，我全身通了电。", "en": "Lightning hits the water; current fills me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里连一滴水都没有。", "en": "There is not one drop of water here."}
      ]
    }
  }
