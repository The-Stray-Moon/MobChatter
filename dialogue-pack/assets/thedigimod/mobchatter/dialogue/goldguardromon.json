        {"zh": "它比我以为的轻", "en": "Lighter than I expected."},
        {"zh": "收入储物仓", "en": "Stored in the bay."},
        {"zh": "这点金属能用", "en": "This metal is usable."},
        {"zh": "我在清点库存", "en": "I am taking inventory."},
        {"zh": "它的成色不错", "en": "This is decent quality."},
        {"zh": "别跟我抢废料", "en": "Do not compete for my scrap."}
      ]
    },
