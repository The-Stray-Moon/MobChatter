{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着沉重的脚步", "en": "I drag my heavy steps."},
        {"zh": "金色的外壳反光", "en": "My gold casing reflects the light."},
        {"zh": "我在沙地上留下深印", "en": "I leave deep prints in the sand."},
        {"zh": "机械关节一直在响", "en": "My joints keep ticking."},
        {"zh": "我一步一顿", "en": "I move in stops and starts."},
        {"zh": "我从恶地的石堆走过", "en": "I pass the badland stones."},
        {"zh": "脚下的沙在滑", "en": "The sand slides underfoot."},
        {"zh": "我抬腿费了点力", "en": "Lifting a leg takes effort."},
        {"zh": "我绕过废弃的机器", "en": "I go around abandoned machinery."},
        {"zh": "我挪着机身挪过去", "en": "I shift my frame along."},
        {"zh": "我身上的金色有点旧", "en": "The gold on me is worn."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我待机在这里", "en": "I stand on standby here."},
        {"zh": "我在扫描周围", "en": "I am scanning the surroundings."},
        {"zh": "我的齿轮没停", "en": "My gears have not stopped."},
        {"zh": "关节里进了沙", "en": "Sand got into my joints."},
        {"zh": "金色的漆掉了一点", "en": "The gold paint has chipped."},
        {"zh": "我听见远处有响动", "en": "I hear something in the distance."},
        {"zh": "我的视线很稳", "en": "My sightline is steady."},
        {"zh": "我把废料堆看了一眼", "en": "I glance at the scrap pile."},
        {"zh": "我的步伐数据有点旧", "en": "My gait data is outdated."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "检测到生物", "en": "Lifeform detected."},
        {"zh": "你站在我的扫描范围里", "en": "You are in my scan range."},
        {"zh": "我的外壳是金属的", "en": "My casing is metal."},
        {"zh": "你的分量不够", "en": "You do not have enough weight."},
        {"zh": "你手上的东西能伤到我吗", "en": "Could that harm me?"},
        {"zh": "我不喜欢被摸", "en": "I dislike being touched."},
        {"zh": "你的心跳有点不正常", "en": "Your pulse is irregular."},
        {"zh": "我在算距离", "en": "I am calculating range."},
        {"zh": "你的鞋底沾了沙", "en": "Sand on your soles."},
        {"zh": "我站得比你高", "en": "I stand taller than you."},
        {"zh": "我的关节声很吵", "en": "My joints are loud."},
        {"zh": "你退到石堆后也没用", "en": "Going behind the stones will not help."},
        {"zh": "我还没接到命令", "en": "I have not received orders."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我后退重新站稳", "en": "I step back to reset my footing."},
        {"zh": "关节发出异响", "en": "A joint makes an odd sound."},
        {"zh": "金色漆掉了一片", "en": "A patch of paint chipped off."},
        {"zh": "这一下超出了预期", "en": "That exceeded my estimate."},
        {"zh": "我还在运转", "en": "I am still running."},
        {"zh": "我记录了这个位置", "en": "I logged the impact point."},
        {"zh": "你打得够狠", "en": "You hit hard enough."},
        {"zh": "镀金掉了点色，不影响开火。", "en": "Lost some gold plating. Doesn't affect the guns."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是废料吗", "en": "Is that scrap?"},
        {"zh": "我的能源不足", "en": "My power is low."},
        {"zh": "你手里那块金属有用", "en": "That metal in your hand is useful."},
        {"zh": "放下来让我看看", "en": "Set it down and let me see."},
        {"zh": "这个我可以回收", "en": "I can salvage that."},
        {"zh": "你举着它挡我视线", "en": "You are blocking my view with it."},
        {"zh": "我慢慢伸出手", "en": "I extend a hand slowly."},
        {"zh": "它不重，我拿得动", "en": "It is not heavy, I can carry it."},
        {"zh": "别看它小", "en": "Small, but useful."},
        {"zh": "我伸长了手臂", "en": "I stretched my arm out."},
        {"zh": "再递近一点", "en": "Bring it a little nearer."},
        {"zh": "我收下了", "en": "I accept it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的冲击被我吸收了", "en": "I absorbed your impact."},
        {"zh": "我的支撑轴退了一格", "en": "My strut gave one notch."},
        {"zh": "金属和骨头不一样", "en": "Metal and bone are different."},
        {"zh": "你撞得自己有个印子", "en": "You left a mark on yourself."},
        {"zh": "我的重量很实在", "en": "My weight is very real."},
        {"zh": "关节自动校正了", "en": "My joints auto-corrected."},
        {"zh": "别从侧面撞我", "en": "Do not hit my flank."},
        {"zh": "沙被我们踢起来", "en": "We kicked up sand."},
        {"zh": "碰撞记录完成", "en": "Collision logged."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "此功能不存在", "en": "That function does not exist."},
        {"zh": "我的外壳不适合", "en": "My casing is unsuitable."},
        {"zh": "你几乎贴着我的外壳", "en": "You are almost against my casing."},
        {"zh": "我只是一台机械", "en": "I am only a machine."},
        {"zh": "这类指令不在我程序里。", "en": "That kind of instruction isn't in my program."},
        {"zh": "这不属于任务", "en": "That is not part of the task."},
        {"zh": "我已记录", "en": "Logged."},
        {"zh": "要一起走吗，我护得住两副装甲。", "en": "Travel with me. I can cover two sets of armor."}
      ]
    },
