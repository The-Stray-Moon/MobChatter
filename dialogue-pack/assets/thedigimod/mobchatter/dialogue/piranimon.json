{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在海里翻转着游。", "en": "I roll through the sea."},
        {"zh": "我的身体又大又沉。", "en": "My body is huge and heavy."},
        {"zh": "尾巴一扫，水流就变了。", "en": "One sweep of my tail changes the current."},
        {"zh": "海草在我背上划过去。", "en": "Seagrass drags over my back."},
        {"zh": "礁石在我旁边显得很小。", "en": "The reef looks small beside me."},
        {"zh": "我贴着珊瑚礁巡了一圈。", "en": "I patrol a wide loop along the reef."},
        {"zh": "水里的鱼全散开了。", "en": "The fish all scatter."},
        {"zh": "我不去追那些小的。", "en": "I do not chase the small ones."},
        {"zh": "我继续往深处游。", "en": "I go deeper."},
        {"zh": "光线越来越弱。", "en": "The light thins."},
        {"zh": "我的鳍还在动。", "en": "My fins keep moving."},
        {"zh": "这里的声音很闷。", "en": "Sound is muffled here."},
        {"zh": "我听见远处有撞击。", "en": "I hear a strike far off."},
        {"zh": "我跟着鱼群，游得很慢。", "en": "I follow the school, swimming slow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在水里，鳍慢慢摆。", "en": "I hang in the water, fins swaying."},
        {"zh": "两格半的食人鱼，水里的牙。", "en": "A two-block piranha with water-borne teeth."},
        {"zh": "海流从我鳃边过。", "en": "Current passes my gills."},
        {"zh": "我这副牙，在海里不用换气。", "en": "These teeth need no breath in the sea."},
        {"zh": "我可以一直待在水里。", "en": "I can stay in the water always."},
        {"zh": "有只小鱼在我旁边转。", "en": "A small fish circles me."},
        {"zh": "我懒得理会它。", "en": "I cannot be bothered with it."},
        {"zh": "它自己游走了。", "en": "It leaves."},
        {"zh": "我的鳞在暗处也看得见。", "en": "My scales show even in the dark."},
        {"zh": "海里横过来，牙全朝上。", "en": "Turning broadside in the sea, teeth up."},
        {"zh": "深海的暗里，我不用眼。", "en": "In the deep dark I don't need eyes."},
        {"zh": "我慢慢下沉一点。", "en": "I sink a little."},
        {"zh": "我悬在锚边，慢慢摆尾。", "en": "I hover near my anchor, tail swaying."},
        {"zh": "我就停在那儿。", "en": "I rest there."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也潜下来了。", "en": "You have dived down."},
        {"zh": "我比你大得多。", "en": "I am far larger than you."},
        {"zh": "水里的你能看见我多少？", "en": "How much of me can you see in this water?"},
        {"zh": "我的头就有你那么大。", "en": "My head alone is your size."},
        {"zh": "你停在那里。", "en": "You stop."},
        {"zh": "你的气泡往上跑。", "en": "Your bubbles rise."},
        {"zh": "你的腿在水里，很像鱼。", "en": "Your legs in the water look like fish."},
        {"zh": "你连手都没有抬。", "en": "You did not even raise a hand."},
        {"zh": "这倒很少见。", "en": "That is rare."},
        {"zh": "我退进海草里，看着你。", "en": "I back into the seagrass and watch you."},
        {"zh": "你举手的动作，像投食。", "en": "You raise your hand like you're feeding me."},
        {"zh": "我认得这个手势。", "en": "I know that gesture."},
        {"zh": "那就不是猎物。", "en": "Then you are not prey."},
        {"zh": "我慢慢地游走。", "en": "I swim slowly off."},
        {"zh": "绕了一圈又回来。", "en": "Circle once, and come back."},
        {"zh": "我停在你旁边。", "en": "I stop beside you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我猛地一摆尾，退开很远。", "en": "One hard beat of my tail and I am far off."},
        {"zh": "身上有一道很深的伤。", "en": "A deep wound on my body."},
        {"zh": "水里的血是我的。", "en": "The blood in the water is mine."},
        {"zh": "我慢慢地转着。", "en": "I turn slowly."},
        {"zh": "找它的方向。", "en": "Finding its direction."},
        {"zh": "咸水灌进伤口，我沉了半格。", "en": "Salt water fills the wound; I sink half a block."},
        {"zh": "我沉到低处去。", "en": "I sink low."},
        {"zh": "准备再冲一次。", "en": "Ready to rush again."},
        {"zh": "鳞片被我甩掉几片。", "en": "A few scales shook loose."},
        {"zh": "我的尾鳍一摆。", "en": "My tail beats."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是海鲜的味道。", "en": "That is seafood."},
        {"zh": "我一下就闻到了。", "en": "I smell it at once."},
        {"zh": "你手里那点海鲜，不够。", "en": "That bit of seafood in your hand isn't enough."},
        {"zh": "水流被我推开。", "en": "The current parts before me."},
        {"zh": "你把东西扔下来。", "en": "You toss it down."},
        {"zh": "它慢慢地沉。", "en": "It sinks slowly."},
        {"zh": "张这么大嘴，一口就吞。", "en": "Mouth this wide swallows it whole."},
        {"zh": "一整条鱼，我才动心。", "en": "A whole fish—then I'm interested."},
        {"zh": "我仰起头望你。", "en": "I look up at you."},
        {"zh": "还有海鲜没有？", "en": "More seafood?"},
        {"zh": "你手上还剩下一些。", "en": "There is some left in your hand."},
        {"zh": "海鲜的味道，我认得。", "en": "I know the smell of seafood."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，几乎没有感觉。", "en": "You bump me and I barely feel it."},
        {"zh": "我的身体太厚了。", "en": "My body is too thick."},
        {"zh": "你往旁边退开。", "en": "You move aside."},
        {"zh": "我转了半圈，稳稳悬着。", "en": "Half a turn, and I hover steady."},
        {"zh": "水被我推得打旋。", "en": "The water swirls where I push."},
        {"zh": "你被带着转了一下。", "en": "You are carried around."},
        {"zh": "船底蹭过我的背，鳞片刮响。", "en": "A hull scrapes my back with a shriek of scales."},
        {"zh": "水才慢慢静下来。", "en": "And the water settles."},
        {"zh": "你扶着礁石站。", "en": "You brace on the reef."},
        {"zh": "我正看着你。", "en": "I watch you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "深海里有回应。", "en": "There is an answer from the deep."},
        {"zh": "我朝那边游了很久。", "en": "I swim toward it a long while."},
        {"zh": "它比我还大些。", "en": "It is larger than I."},
        {"zh": "两条影子绕着一块礁石转。", "en": "Two shadows circle the same reef."},
        {"zh": "鳍几乎碰上了。", "en": "Our fins nearly touch."},
        {"zh": "然后一起冲向海面。", "en": "Then we rush for the surface."},
        {"zh": "水被我们掀开。", "en": "The water breaks over us."},
        {"zh": "随后一同下沉。", "en": "Then we sink together."},
        {"zh": "深海里很安静。", "en": "The deep is quiet."},
        {"zh": "只有我们两个的声音。", "en": "Only the sound of us two."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口把它含住。", "en": "I take it in my mouth."},
        {"zh": "我把它吐在沙上。", "en": "I spit it onto the sand."},
        {"zh": "我张口吐了出来。", "en": "I spit it out."},
        {"zh": "它浮在水里。", "en": "It floats there."},
        {"zh": "我用吻部顶了顶。", "en": "I nudge it with my snout."},
        {"zh": "它慢慢沉到底。", "en": "It settles slowly to the bottom."},
        {"zh": "我跟着它下去。", "en": "I follow it down."},
        {"zh": "海底非常暗。", "en": "The bottom is dark."},
        {"zh": "我用牙把它挑了起来。", "en": "I hook it up with my teeth."},
        {"zh": "水生的我，咬得很紧。", "en": "Aquatic, and my bite clamps down."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "水里有血腥味。", "en": "Blood in the water."},
        {"zh": "我把头抬高些。", "en": "I raise my head high."},
        {"zh": "很淡，在那边。", "en": "Faint. That way."},
        {"zh": "海草一动，我的眼珠转过去。", "en": "The kelp stirs and my eye rolls toward it."},
        {"zh": "食人鱼兽的尾，甩了一下。", "en": "Piranimon's tail lashed once."},
        {"zh": "水流推着我往前。", "en": "The current carries me forward."},
        {"zh": "礁石从旁边掠过。", "en": "The reef slips past."},
        {"zh": "血味浓起来了。", "en": "The blood smell thickens."},
        {"zh": "前面有个影子。", "en": "A shape ahead."},
        {"zh": "大影子，才值得我追。", "en": "A big shadow—worth chasing."},
        {"zh": "我放慢了速度。", "en": "I slow."},
        {"zh": "先看清楚再说。", "en": "Look first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "洋流把它的气味送来。", "en": "The current brings its scent to me."},
        {"zh": "它转身跟着我。", "en": "It turns with me."},
        {"zh": "我们互相绕着。", "en": "We circle each other."},
        {"zh": "我转了个圈，水乱了。", "en": "I turn once and the water churns."},
        {"zh": "它比我先扑过来。", "en": "It lunges first."},
        {"zh": "我斜过身让开。", "en": "I slip aside."},
        {"zh": "它的牙碰到我的鳍。", "en": "Its teeth meet my fin."},
        {"zh": "只疼了那么一下。", "en": "Just one stab of pain."},
        {"zh": "我贴到它背后。", "en": "I press in behind it."},
        {"zh": "它转头很慢。", "en": "It turns slowly."},
        {"zh": "我抓住这个空隙。", "en": "I take the gap."},
        {"zh": "我朝它冲上去。", "en": "I rush in."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一口咬在它的侧腹。", "en": "I bite into its flank."},
        {"zh": "牙陷进去很深。", "en": "My teeth go deep."},
        {"zh": "它死命地挣扎。", "en": "It thrashes for its life."},
        {"zh": "牙嵌进去，我摇了两下头。", "en": "My teeth sink in and I shake my head twice."},
        {"zh": "我的牙合上，海水变红。", "en": "My teeth close and the sea turns red."},
        {"zh": "血散开一大片。", "en": "Blood blooms wide."},
        {"zh": "它往后面缩。", "en": "It shrinks back."},
        {"zh": "我停下不再追。", "en": "I stop and do not chase."},
        {"zh": "我的鳍展开，冲了过去。", "en": "My fins flare, and I lunge."},
        {"zh": "嘴里还留着味道。", "en": "The taste stays in my mouth."},
        {"zh": "我掉转庞大的身体。", "en": "I swing my huge body around."},
        {"zh": "它已经游远了。", "en": "It is already far."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "水面上的光，我看见了。", "en": "I see the light on the surface."},
        {"zh": "水压在我身上慢慢变小。", "en": "The pressure eases on me."},
        {"zh": "这里有一点光。", "en": "There is light here."},
        {"zh": "我抬头看那光。", "en": "I raise my head to it."},
        {"zh": "海面在很远的上方。", "en": "The surface is far above."},
        {"zh": "我从海沟的阴影里升起。", "en": "I rise from the trench's shadow."},
        {"zh": "我这沉身子一转，一群鱼从身边散开。", "en": "My heavy body turns, and a school scatters away."},
        {"zh": "我不去追猎物。", "en": "I do not give chase."},
        {"zh": "我太大了，追起来费劲。", "en": "I am too large. Chasing is tiring."},
        {"zh": "我一身鱼鳞，牙往外翻。", "en": "Fish scales, and my teeth turn outward."},
        {"zh": "下面有很多小的在动。", "en": "Many small things move below."},
        {"zh": "我在海里成群游。", "en": "I swim in schools through the sea."},
        {"zh": "水里的光在我背上滑过。", "en": "Light slides over my back."},
        {"zh": "我拐了一个弯。", "en": "I turn."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "热水烫过我的鳃，我往深处扎。", "en": "Hot water scalds my gills and I dive."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我被甩出水面，重重摔回海里。", "en": "I am flung from the water and crash back in."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里的气不对，我的鳃拼命开合。", "en": "The water is wrong; my gills work wildly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "水下的炸响把我推得翻了身。", "en": "An underwater blast rolls me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支鱼叉扎进我的侧腹，血在水里散。", "en": "A harpoon in my flank; blood spreads in the water."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪力压住我，鳍都动不了。", "en": "Strange force pins me and my fins will not move."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这片海空了，我的力气在退。", "en": "This sea is empty and my strength ebbs."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打进海里，我整条都麻了。", "en": "Lightning strikes the sea and I go numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "海水消失，我在黑里坠落。", "en": "The sea vanishes and I fall through black."}
      ]
    }
  }
}
