{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步，走过林间。", "en": "I walk through the wood, step by step."},
        {"zh": "蚂蚁的样子，四肢很长。", "en": "Ant-like, long-limbed."},
        {"zh": "我的触角在动。", "en": "My antennae move."},
        {"zh": "甲壳反着幽光。", "en": "My carapace has a faint sheen."},
        {"zh": "我总在树根附近转。", "en": "I always linger near roots."},
        {"zh": "三只一起，走成一列。", "en": "Three of us in a line."},
        {"zh": "六条腿落地，几乎没有声。", "en": "Six legs land almost soundlessly."},
        {"zh": "林子里，我是干活的那个。", "en": "In the wood, I'm the worker."},
        {"zh": "我能扛起比我大的东西。", "en": "I can carry things larger than me."},
        {"zh": "我不急，活要慢慢干。", "en": "No rush; work takes time."},
        {"zh": "脚下的落叶被我拨开。", "en": "I push the leaf litter aside."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在树干上，理触角。", "en": "I pause on the trunk to clean my antennae."},
        {"zh": "口器动了两下。", "en": "My mandibles work twice."},
        {"zh": "风穿过林子。", "en": "Wind passes through the wood."},
        {"zh": "我在看哪棵树能砍。", "en": "I'm eyeing which tree to fell."},
        {"zh": "甲壳上落了片叶。", "en": "A leaf on my carapace."},
        {"zh": "我连触角都不动。", "en": "I don't even move my antennae."},
        {"zh": "我在等活儿。", "en": "I wait for work."},
        {"zh": "脚上有树脂。", "en": "Resin on my feet."},
        {"zh": "同类在不远处。", "en": "Kin not far off."},
        {"zh": "我把触角转向另一边。", "en": "I swing my antennae the other way."},
        {"zh": "阳光从叶隙落下来。", "en": "Sunlight falls through the leaves."},
        {"zh": "这棵树的纹路很好。", "en": "This tree has fine grain."},
        {"zh": "我在听树里的声音。", "en": "I listen into the wood."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你要砍树吗？", "en": "Are you here to fell trees?"},
        {"zh": "我有的是力气。", "en": "I have the strength."},
        {"zh": "你手里没有斧子。", "en": "You carry no axe."},
        {"zh": "这片林子的每棵树我都认。", "en": "I know every tree in this wood."},
        {"zh": "你挡在我要砍的树前了。", "en": "You're before the tree I mean to fell."},
        {"zh": "我的口器能咬断木头。", "en": "My mandibles can bite through wood."},
        {"zh": "你贴上来了些。", "en": "You've edged closer."},
        {"zh": "我在干活，别打断。", "en": "I'm working; don't interrupt."},
        {"zh": "木材要按纹理砍。", "en": "Wood must be cut along the grain."},
        {"zh": "你要看我怎么砍吗？", "en": "Want to watch me cut?"},
        {"zh": "我磨了磨口器。", "en": "I grind my mandibles."},
        {"zh": "这片林是大家的。", "en": "This wood belongs to all of us."},
        {"zh": "别踩我的木头。", "en": "Don't step on my timber."},
        {"zh": "你不像会干活的。", "en": "You don't look like a worker."},
        {"zh": "让我先做完这段。", "en": "Let me finish this stretch."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲壳上多了一道。", "en": "A new mark on my shell."},
        {"zh": "甲壳上多道浅浅的痕。", "en": "A shallow mark on my shell."},
        {"zh": "这点伤，不耽误活。", "en": "This won't stop the work."},
        {"zh": "甲壳晃了晃，又稳。", "en": "My shell rocks, then settles."},
        {"zh": "我低下头看那道痕。", "en": "I lower my head to the mark."},
        {"zh": "我把身子重新撑正。", "en": "I haul myself upright again."},
        {"zh": "血渗到木头上。", "en": "Blood seeps into the wood."},
        {"zh": "我还能举东西。", "en": "I can still lift."},
        {"zh": "这不是我该受的。", "en": "I didn't deserve that."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这叶子我不吃。", "en": "I don't eat this leaf."},
        {"zh": "叶子？我吃，但不必。", "en": "Leaves? I do eat them, but not necessarily."},
        {"zh": "你把树叶举着，我看了看。", "en": "I glance at the leaf you hold."},
        {"zh": "枯叶塞牙，我还是啃树皮", "en": "Dry leaves stick in my mandibles; I would rather chew bark."},
        {"zh": "别拿这个换我的木头。", "en": "Don't trade my timber for that."},
        {"zh": "我有整片林子，不差你这口", "en": "I have a whole forest; I do not need your handful."},
        {"zh": "你放下，我待会吃。", "en": "Set it down; I'll eat later."},
        {"zh": "我还在干活。", "en": "I'm still working."},
        {"zh": "这点撑不过半天。", "en": "That won't last half a day."},
        {"zh": "这些你收回去。", "en": "Take these back."},
        {"zh": "我有更要紧的事。", "en": "I have more pressing work."},
        {"zh": "等干完活再说。", "en": "After the work is done."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞得我偏了。", "en": "You knocked me off balance."},
        {"zh": "我的甲很硬。", "en": "My shell is hard."},
        {"zh": "我退了一步，再站住。", "en": "One step back, then steady."},
        {"zh": "六条腿抓得牢。", "en": "Six legs hold tight."},
        {"zh": "这个斜角我撑得住。", "en": "I can hold against that slope."},
        {"zh": "地面上多了道痕。", "en": "A new mark on the ground."},
        {"zh": "这点碰撞，不算事。", "en": "That bump is nothing."},
        {"zh": "我们错开身子。", "en": "We shift past each other."},
        {"zh": "做事别太急。", "en": "Don't be in such a hurry."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "眼下不是谈这个的时辰。", "en": "Now isn't the hour for that."},
        {"zh": "我有活儿没干完。", "en": "I have work unfinished."},
        {"zh": "林子里的同类，各有各的树。", "en": "Each of us keeps to our own tree."},
        {"zh": "我们不太说这事。", "en": "We don't much speak of this."},
        {"zh": "林子里，安静更好。", "en": "Quiet is better in the wood."},
        {"zh": "这一类事我不通。", "en": "Such matters are beyond me."},
        {"zh": "工要一件件做。", "en": "Work gets done one thing at a time."},
        {"zh": "你该去问别人。", "en": "You should ask someone else."},
        {"zh": "我得回去了。", "en": "I have to get back."},
        {"zh": "别耽搁我的活计。", "en": "Don't hold up my work."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我夹起一块木头。", "en": "I pick up a block of wood."},
        {"zh": "这根原木比我整只还沉", "en": "This log weighs more than my whole body."},
        {"zh": "我很轻松就举起来了。", "en": "I lift it easily."},
        {"zh": "我用口器咬着走。", "en": "I carry it in my mandibles."},
        {"zh": "掉下来，砸到脚。", "en": "It fell on my own foot."},
        {"zh": "我把它架在肩上。", "en": "I hoist it onto my shoulder."},
        {"zh": "这个能盖房子。", "en": "This one could build a house."},
        {"zh": "树干里有虫。", "en": "There are grubs in this log."},
        {"zh": "这段好木，我夹回去盖房", "en": "This good timber, I pinch it up to build with."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我六足一停。", "en": "My six legs halt."},
        {"zh": "不是活物的脚步。", "en": "Those aren't a creature's steps."},
        {"zh": "我举起前肢。", "en": "I raise my forelimbs."},
        {"zh": "这不是我的树。", "en": "This isn't mine to fell."},
        {"zh": "我一直留意着它。", "en": "I've kept an eye on it."},
        {"zh": "你要抢我的木头吗？", "en": "Coming for my timber?"},
        {"zh": "这个位置，正合适。", "en": "This position is just right."},
        {"zh": "我准备好还手了。", "en": "I'm ready to fight back."},
        {"zh": "别弄坏林子。", "en": "Don't ruin the wood."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我半步也不挪。", "en": "I won't shift half a step."},
        {"zh": "我的甲能挡一下。", "en": "My shell can take a hit."},
        {"zh": "你要动手，我也不客气。", "en": "If you start it, I'll answer."},
        {"zh": "这片林子，我还要干活。", "en": "I've still got work in this wood."},
        {"zh": "你在我周围打转。", "en": "You're circling about me."},
        {"zh": "我的触角对着你。", "en": "My antennae aim at you."},
        {"zh": "我慢慢把木头收起来。", "en": "I slowly pull the timber aside."},
        {"zh": "别踩我的心材。", "en": "Not the heartwood."},
        {"zh": "你的脚落在哪，我都记。", "en": "I log every step you take."},
        {"zh": "再挨近一点就够。", "en": "A hair closer will do."},
        {"zh": "我已经举起来了。", "en": "I've raised them."},
        {"zh": "那就这样定下。", "en": "Then it's settled."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前肢劈过去！", "en": "I strike with my forelimbs!"},
        {"zh": "这一下，像斧子。", "en": "That one bites like an axe."},
        {"zh": "死记之刺，接好。", "en": "Deadly Sting — take it!"},
        {"zh": "你的甲太薄。", "en": "Your armor is too thin."},
        {"zh": "我一下就退。", "en": "One strike, then back."},
        {"zh": "木头的事，我自己来。", "en": "Timber is my business."},
        {"zh": "你没有我这么大的力气。", "en": "You don't have my strength."},
        {"zh": "我再劈一次。", "en": "Another chop."},
        {"zh": "我的口器也没闲着。", "en": "My mandibles aren't idle."},
        {"zh": "你挡住了一边。", "en": "You blocked one side."},
        {"zh": "别砸我的木头。", "en": "Don't smash my timber."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树根间出来。", "en": "I come out from among the roots."},
        {"zh": "甲壳在树影里发亮。", "en": "My carapace gleams in the shade."},
        {"zh": "林子里，活儿很多。", "en": "Plenty of work in this wood."},
        {"zh": "我先挑了棵好树。", "en": "I've picked a good tree."},
        {"zh": "三只一起走。", "en": "Three of us walking together."},
        {"zh": "我动了动触角。", "en": "I move my antennae."},
        {"zh": "这里的木头很香。", "en": "The wood here smells good."},
        {"zh": "我看到一棵倒下的树。", "en": "I spot a fallen tree."},
        {"zh": "我先把活儿盘算清楚。", "en": "First I reckon up the work."},
        {"zh": "我有活要干。", "en": "I have work to do."},
        {"zh": "我从树根间走出来。", "en": "I step out from among the roots."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，甲壳发焦。", "en": "Fire scorches my shell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下去，四条腿先着地。", "en": "I land on four legs."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进嘴里，我挣着。", "en": "Water in my mouth; I strain."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸得我翻倒在落叶里。", "en": "The blast rolls me into the leaves."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进我的甲缝。", "en": "Something sticks in a shell seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我僵住。", "en": "That force locks me up."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着，力气小了一半。", "en": "Hungry, half my strength is gone."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落在树上，我全身一麻。", "en": "Lightning hits the tree; I go numb."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有地，我抓不住任何东西。", "en": "No ground; nothing to grip."}
      ]
    }
  }
}
