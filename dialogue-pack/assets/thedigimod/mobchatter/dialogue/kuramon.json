{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在半空，慢慢挪。", "en": "I float in the air, drifting."},
        {"zh": "我像一颗会动的小泡。", "en": "I am like a little moving bubble."},
        {"zh": "我飘过草尖。", "en": "I drift over the grass tips."},
        {"zh": "我跟着你的脚步飘。", "en": "I drift along with your steps."},
        {"zh": "我又飘低了。", "en": "Then I float lower."},
        {"zh": "我没有脚，也不用走。", "en": "I have no feet, and need none."},
        {"zh": "我一飘一停。", "en": "I drift, then pause."},
        {"zh": "我蹭到树叶边上。", "en": "I brush the edge of a leaf."},
        {"zh": "我又升起来一点。", "en": "I rise a little."},
        {"zh": "我贴着地面朝你飘。", "en": "I drift toward you along the ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在看周围。", "en": "I am looking around."},
        {"zh": "我只有这么小一点。", "en": "I am only this small."},
        {"zh": "我慢慢浮到你的腰高。", "en": "I float up to your waist height."},
        {"zh": "我又落下来。", "en": "Then I settle."},
        {"zh": "我很轻。", "en": "I am very light."},
        {"zh": "我浮在半空，安安静静。", "en": "I hover without moving."},
        {"zh": "草上的露水映着我。", "en": "The dew reflects me."},
        {"zh": "我在等长大。", "en": "I am waiting to grow."},
        {"zh": "我碰了一下你的肩。", "en": "I bump your shoulder."},
        {"zh": "我的形状有点圆。", "en": "My shape is rather round."},
        {"zh": "我在太阳下有点透明。", "en": "I am a little transparent in the sun."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我飘着绕你转了一圈。", "en": "I drift in a circle around you."},
        {"zh": "我会长大。", "en": "I will grow."},
        {"zh": "我现在很弱。", "en": "I am very weak now."},
        {"zh": "我歪了歪身子，眼睛跟着转。", "en": "I tilt, my eye following you."},
        {"zh": "你的脸离得太近。", "en": "Your face is too close."},
        {"zh": "我往后飘开半格。", "en": "I drift back half a block."},
        {"zh": "我叫库拉兽。", "en": "I am Kuramon."},
        {"zh": "你记住我的名字。", "en": "Remember my name."},
        {"zh": "我要变成别的样子。", "en": "I am going to become something else."},
        {"zh": "我现在还打不过你。", "en": "I cannot beat you yet."},
        {"zh": "我会记得你。", "en": "I will remember you."},
        {"zh": "别靠太近，我只有拇指大。", "en": "Not too close — I'm thumb-sized."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我抖了一下，眼睛眨了眨。", "en": "I tremble and blink my eye."},
        {"zh": "我飘开很远。", "en": "I drift far away."},
        {"zh": "我差点散了。", "en": "I nearly scatter."},
        {"zh": "我缩成一个湿泡泡。", "en": "I shrink into a wet bubble."},
        {"zh": "散开的身子又聚回来。", "en": "My scattered body pulls back together."},
        {"zh": "我很轻，飘得住。", "en": "I am light and keep afloat."},
        {"zh": "我恨你。", "en": "I hate you."},
        {"zh": "我会长大的。", "en": "I will grow up."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这块东西我能吸进去吗？", "en": "Can I absorb this piece?"},
        {"zh": "这块比我整个身子还大。", "en": "This chunk is bigger than my whole body."},
        {"zh": "我贴着它飘了一整圈。", "en": "I float one lap around it."},
        {"zh": "我只有一个软软的身子。", "en": "I'm nothing but one soft little body."},
        {"zh": "我飘到它旁边。", "en": "I drift up beside it."},
        {"zh": "我不太会用嘴。", "en": "I am not much good with my mouth."},
        {"zh": "那饲料是给我的吗？我闻到味道了。", "en": "Is that feed for me? I can smell it."},
        {"zh": "幼年期的饲料味，我飘过去了。", "en": "The smell of baby feed and I drift toward it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我很轻，飘得远。", "en": "I am light and drift far."},
        {"zh": "我又飘回来。", "en": "I drift back."},
        {"zh": "我贴了一下你的手。", "en": "I press against your hand."},
        {"zh": "你几乎感觉不到。", "en": "You can barely feel it."},
        {"zh": "我弹了两下。", "en": "I bounce twice."},
        {"zh": "我只有两点生命，也敢浮着。", "en": "Two health, and I still float."},
        {"zh": "我们碰在一起。", "en": "We touch."},
        {"zh": "我飘到你肩上。", "en": "I drift onto your shoulder."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还有很多同伴。", "en": "I have many kin."},
        {"zh": "我们一起浮着。", "en": "We float together."},
        {"zh": "我们都一样小。", "en": "We are all this small."},
        {"zh": "两个泡泡碰了碰，没说话。", "en": "Two bubbles touch; neither speaks."},
        {"zh": "我们慢慢转圈。", "en": "We turn slowly in a circle."},
        {"zh": "有些要长大了。", "en": "Some of us are about to grow."},
        {"zh": "我们会变成不同的样子。", "en": "We will become different things."},
        {"zh": "我们浮上去一点。", "en": "We float up a little."},
        {"zh": "然后散开了。", "en": "Then we scatter."},
        {"zh": "我又自己一个。", "en": "I am alone again."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我碰了碰它。", "en": "I touch it."},
        {"zh": "它太重了。", "en": "It is too heavy."},
        {"zh": "我试着推。", "en": "I try to push it."},
        {"zh": "它没动，我就压上去。", "en": "It didn't move, so I press onto it."},
        {"zh": "这个我拿不动。", "en": "I cannot carry this."},
        {"zh": "轻点，我可是会飞的。", "en": "Careful — I can fly, you know."},
        {"zh": "被你捧在手心，好像也不坏。", "en": "Being held in your hands isn't so bad."},
        {"zh": "别捏太紧，我还要吐泡泡呢。", "en": "Don't squeeze — I still need to blow bubbles."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我那只大眼睛盯着你。", "en": "My one big eye is fixed on you."},
        {"zh": "我在聚气。", "en": "I am gathering my strength."},
        {"zh": "泡泡在我嘴里成形。", "en": "A bubble forms at my mouth."},
        {"zh": "我朝你吐过去。", "en": "I spit it at you."},
        {"zh": "这一下轻得像水泡。", "en": "This hit is light as a bubble."},
        {"zh": "但我会再来。", "en": "But I will come again."},
        {"zh": "我浮到远处。", "en": "I float away."},
        {"zh": "泡泡破了，我又飘回来。", "en": "The bubble popped; I drift back."},
        {"zh": "我还没放弃。", "en": "I have not given up."},
        {"zh": "我数到三就吐泡泡。", "en": "On three I spit a bubble."},
        {"zh": "来吧，我准备好了。", "en": "Come on, I'm ready."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你慢慢打转。", "en": "I circle you slowly."},
        {"zh": "我飘在末地的岛之间。", "en": "I drift between the End's islands."},
        {"zh": "我又飘到后面。", "en": "I drift behind you."},
        {"zh": "我在蓄力。", "en": "I am charging."},
        {"zh": "泡泡在我嘴边。", "en": "A bubble sits at my mouth."},
        {"zh": "我吐了一下。", "en": "I spit once."},
        {"zh": "没打中。", "en": "It missed."},
        {"zh": "我又吐一次。", "en": "I spit again."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "软软地撞你一下。", "en": "A soft bump against you."},
        {"zh": "我的泡泡打在你身上。", "en": "My bubble strikes you."},
        {"zh": "这一下几乎没感觉吧。", "en": "You barely felt that, did you?"},
        {"zh": "你挥开了我。", "en": "You swat me away."},
        {"zh": "又冲上去，泡泡在嘴里。", "en": "Charging again, bubble in my mouth."},
        {"zh": "我的泡泡散了。", "en": "My bubble bursts."},
        {"zh": "我吐了第三个。", "en": "I spit a third."},
        {"zh": "你终于退了一步。", "en": "You finally step back."},
        {"zh": "我眯起眼，吐出一串泡。", "en": "I squint and spit a string of bubbles."},
        {"zh": "我还能再来。", "en": "I can do more."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从一枚蛋里出来。", "en": "I came out of an egg."},
        {"zh": "我很小，只有两下生命。", "en": "I am small, with only two points of life."},
        {"zh": "我第一次浮起来。", "en": "I float for the first time."},
        {"zh": "这里好大。", "en": "It is so big here."},
        {"zh": "我在草地上飘。", "en": "I drift over the grass."},
        {"zh": "我试着吐了个泡。", "en": "I try spitting a bubble."},
        {"zh": "我还可以进化。", "en": "I can still evolve."},
        {"zh": "我会变成别的样子。", "en": "I will become something else."},
        {"zh": "我在森林里。", "en": "I am in the forest."},
        {"zh": "身子浮起来，离地一寸。", "en": "I lift an inch off the ground."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烤，我差点爆开。", "en": "Fire nearly bursts me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下去，弹了两下。", "en": "I fall and bounce twice."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我裹住了，我沉着不动。", "en": "Water wraps me and I sink."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过我，我散了又聚。", "en": "An arrow passes through me; I scatter and re-form."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一阵光，我的形状晃了。", "en": "A flash of magic and my shape wavers."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我快没力气浮着了。", "en": "I can barely stay afloat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光刺得我闭眼。", "en": "The lightning glare makes me shut my eyes."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空把我越吸越深。", "en": "The void draws me deeper."}
      ]
    }
  }
}
