{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我浮在林间，慢慢移动", "en": "I drift among the trees, moving slowly."},
        {"zh": "我的长袍垂到脚下", "en": "My long robe hangs to my feet."},
        {"zh": "我从树冠下穿过去", "en": "I pass beneath the canopy."},
        {"zh": "书页在我身边翻动", "en": "Pages turn around me."},
        {"zh": "我朝锚点的方向飘", "en": "I drift toward my anchor."},
        {"zh": "我飘过地面，长袍不沾土。", "en": "I glide over the ground, robe unsullied."},
        {"zh": "我沿着林线往前", "en": "I follow the treeline onward."},
        {"zh": "落叶被我带起一圈", "en": "Fallen leaves swirl up behind me."},
        {"zh": "我绕过一棵黑树", "en": "I go around a dark tree."},
        {"zh": "我停在两棵树之间", "en": "I stop between two trees."},
        {"zh": "我浮在林间，长袍垂到脚下。", "en": "I float in the wood, robe hanging to my feet."},
        {"zh": "我继续飘着走", "en": "I drift on."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在林间，很安静", "en": "I hang among the trees, very quiet."},
        {"zh": "我翻着一页看不见的字", "en": "I turn a page of invisible writing."},
        {"zh": "知识在我体内流转", "en": "Knowledge moves within me."},
        {"zh": "这片林子有很多话", "en": "This wood has much to say."},
        {"zh": "我慢慢合上手中的书", "en": "I close the book in my hands."},
        {"zh": "我记下了每一棵树的形状", "en": "I've recorded the shape of every tree."},
        {"zh": "风穿过枝间，我听着", "en": "Wind moves through the branches; I listen."},
        {"zh": "我的长袍下没有脚。", "en": "There are no feet beneath my robe."},
        {"zh": "我把袍角收拢", "en": "I draw my robe's hem in."},
        {"zh": "我还没找到想找的东西", "en": "I haven't found what I seek."},
        {"zh": "不过这并不着急", "en": "But there's no hurry."},
        {"zh": "我抬起一只手，指向某处", "en": "I raise a hand and point somewhere."},
        {"zh": "然后我又放下", "en": "Then lower it."},
        {"zh": "时间对我来说不太一样", "en": "Time works differently for me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我正在读你身上", "en": "I'm reading you."},
        {"zh": "你身上写着一些东西", "en": "There's something written on you."},
        {"zh": "不，并不是字", "en": "No. Not letters."},
        {"zh": "那是你的来路", "en": "It's where you came from."},
        {"zh": "我看了很久，才开口", "en": "I watch a long while before speaking."},
        {"zh": "你有些不太一样", "en": "You're somewhat different."},
        {"zh": "我合上书，正对着你", "en": "I close my book and face you."},
        {"zh": "我的书页停在你那一行。", "en": "My pages stop at your line."},
        {"zh": "我不一定回答", "en": "I may not answer."},
        {"zh": "你的问题我大致知道", "en": "I think I know your question."},
        {"zh": "但我先听你说", "en": "But first I'll hear you say it."},
        {"zh": "你的声音比看起来轻", "en": "Your voice is lighter than you look."},
        {"zh": "我记下了这一句话", "en": "I've recorded that sentence."},
        {"zh": "你可以坐下来", "en": "You may sit."},
        {"zh": "这里没有椅子", "en": "There's no chair here."},
        {"zh": "但树的根可以", "en": "But the roots will do."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的书页散了一地", "en": "My pages scatter on the ground."},
        {"zh": "我退了半步，袍角扬起", "en": "I step back; my hem lifts."},
        {"zh": "一部分知识模糊了", "en": "Some of my knowledge has blurred."},
        {"zh": "我把散落的页收回来", "en": "I gather the scattered pages."},
        {"zh": "我的身形淡了一下", "en": "My outline dimmed for a moment."},
        {"zh": "我的袍子破了，字却没掉。", "en": "My robe is torn, but no words fall."},
        {"zh": "书页散了几张，我收拢。", "en": "A few pages scatter; I gather them."},
        {"zh": "我还能继续下去", "en": "I can continue."},
        {"zh": "我重新站定了", "en": "I set myself again."},
        {"zh": "这一击我刻在骨头上。", "en": "I've carved this hit into bone."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，只看书。", "en": "I don't eat; I only read."},
        {"zh": "你那点吃食，书里没有记载。", "en": "Your snack has no entry in my book."},
        {"zh": "这东西没有信息", "en": "This carries no information."},
        {"zh": "我不收下这些", "en": "I don't take such things."},
        {"zh": "你留着它用吧", "en": "Keep it."},
        {"zh": "书页比这个有用", "en": "Pages are of more use than that."},
        {"zh": "我看一眼就明白了", "en": "One look and I understand it."},
        {"zh": "这个并不重要", "en": "This isn't important."},
        {"zh": "你换一样东西吧", "en": "Offer something else."},
        {"zh": "你举着它做什么，这东西没有信息。", "en": "Why hold that up? It carries no information."},
        {"zh": "这并不是食物", "en": "Not food."},
        {"zh": "也不是这一件", "en": "Nor this."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的袍角扫过你的手背。", "en": "My robe hem brushes your hand."},
        {"zh": "你几乎没有碰到我", "en": "You barely touched me."},
        {"zh": "我的袍角被带起来", "en": "My hem is lifted."},
        {"zh": "我退了半步，很轻", "en": "I step back half a pace, lightly."},
        {"zh": "这一点碰撞没有意义", "en": "That collision means nothing."},
        {"zh": "我从另一侧出现", "en": "I'm on the other side now."},
        {"zh": "你伸手，只碰到冷空气。", "en": "You reach out and touch only cold air."},
        {"zh": "我抬眼看了一下", "en": "I glance up once."},
        {"zh": "然后就继续走", "en": "And then walk on."},
        {"zh": "我们并没有真的相撞", "en": "We didn't truly collide."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我见过太长的时间", "en": "I've seen too much time."},
        {"zh": "同伴这个词，我懂", "en": "I know the word 'companion'."},
        {"zh": "但我更习惯一个人", "en": "But I'm more used to being alone."},
        {"zh": "你可以留在这里", "en": "You may stay."},
        {"zh": "我不会赶你走的", "en": "I won't drive you off."},
        {"zh": "我也不会留你", "en": "I won't keep you either."},
        {"zh": "你要走，就走", "en": "Go if you'd go."},
        {"zh": "这一夜，我会留着。", "en": "I'll keep this night."},
        {"zh": "记忆是我唯一带得走的", "en": "Memory is the only thing I carry."},
        {"zh": "你看，天快亮了", "en": "Look. It's nearly dawn."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用指尖夹起它，对着光看。", "en": "I pinch it up and hold it to the light."},
        {"zh": "这页的符号，我认得。", "en": "I know these symbols on the page."},
        {"zh": "背面写着一行旧字。", "en": "The back holds a line of old script."},
        {"zh": "上面并没有字", "en": "There's no writing on it."},
        {"zh": "我的书里，什么都放得下。", "en": "My book holds anything."},
        {"zh": "太重的东西我不带", "en": "I don't carry heavy things."},
        {"zh": "这个就留给树", "en": "This I leave to the trees."},
        {"zh": "我的书里，记着每一个世界。", "en": "My book records every world."},
        {"zh": "我记下了它的方位", "en": "I've noted its position."},
        {"zh": "我边走边翻，没抬头。", "en": "I walk and read, never looking up."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我察觉到一处偏差", "en": "I sense a deviation."},
        {"zh": "这片林子的秩序乱了一角", "en": "A corner of this wood's order is disturbed."},
        {"zh": "我合上书，抬起头", "en": "I close my book and lift my head."},
        {"zh": "目标在东北方向", "en": "The target is northeast."},
        {"zh": "大约十几步远", "en": "Perhaps a dozen paces."},
        {"zh": "我开始进行推算", "en": "I begin calculating."},
        {"zh": "「神之斧」已经成形", "en": "Divine Axe has taken shape."},
        {"zh": "我在书页间看着它。", "en": "I watch it from between the pages."},
        {"zh": "我在原地没有动", "en": "I haven't moved from this spot."},
        {"zh": "我等着它走近", "en": "I wait for it to come near."},
        {"zh": "我翻到记着它的那一页", "en": "I turn to the page that records it."},
        {"zh": "上面的字迹很清楚", "en": "The writing on it is very clear."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我不需要移动", "en": "I needn't move."},
        {"zh": "它每一步我都知道", "en": "I know its every step."},
        {"zh": "风会把它的话带来", "en": "The wind brings me what it says."},
        {"zh": "它的呼吸有点乱", "en": "Its breathing is a little ragged."},
        {"zh": "我翻了一页书", "en": "I turn a page."},
        {"zh": "它以为我在看别处", "en": "It thinks I'm looking elsewhere."},
        {"zh": "书页合上，我转向你。", "en": "The book closes; I turn to you."},
        {"zh": "书页翻动，光聚在我掌心。", "en": "Pages turn; light gathers in my palm."},
        {"zh": "角度可以从上方来", "en": "The angle can come from above."},
        {"zh": "我算得很清楚", "en": "I've calculated it exactly."},
        {"zh": "就是现在，书页翻开了。", "en": "Now. The pages have turned."},
        {"zh": "我合上书，往前一步", "en": "I close the book and take one step."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "神之斧，落下去", "en": "Divine Axe comes down."},
        {"zh": "光从上方切开了空气", "en": "Light cuts the air from above."},
        {"zh": "一道光正中它的胸口。", "en": "A beam strikes it square in the chest."},
        {"zh": "我倒退了半步", "en": "I give back half a step."},
        {"zh": "书页在我周围翻动", "en": "Pages turn around me."},
        {"zh": "我抬手，再来一次", "en": "I raise my hand for another."},
        {"zh": "这一次角度更准", "en": "This angle is truer."},
        {"zh": "它的护甲裂了", "en": "Its armor has split."},
        {"zh": "我抱着的书，比我还厚。", "en": "The book I hold is thicker than I am."},
        {"zh": "我把书合上了", "en": "I close my book."},
        {"zh": "这件事就这样结束", "en": "This matter is finished."},
        {"zh": "林子又安静下来", "en": "The wood is quiet again."}
      ]
    },
