{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我迈着小短腿跑", "en": "I run on short little legs."},
        {"zh": "我的壳在走路时晃", "en": "My shell sways as I walk."},
        {"zh": "我绕着锚点转圈", "en": "I circle my anchor point."},
        {"zh": "我抬头看你，又往前走", "en": "I look up at you, then walk on."},
        {"zh": "数字的纹路在地上闪", "en": "Digital patterns flash on the ground."},
        {"zh": "短腿迈得小而稳当", "en": "My short legs take small, steady steps."},
        {"zh": "我走到树根边嗅了嗅", "en": "I sniff by the roots."},
        {"zh": "我踱到平原那头", "en": "I wander to the far side of the plain."},
        {"zh": "我背着壳走不快", "en": "With this shell I can't go fast."},
        {"zh": "我踩过草地不留下痕", "en": "No trace stays where I tread."},
        {"zh": "我绕开高高的草", "en": "I go around the tall grass."},
        {"zh": "我跟着自己的影子走", "en": "I walk along with my shadow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在锚点旁边", "en": "I sit by my anchor."},
        {"zh": "我在等着指令", "en": "I wait for an order."},
        {"zh": "数据在我体内流动", "en": "Data moves inside me."},
        {"zh": "我的壳有点凉", "en": "My shell is a little cold."},
        {"zh": "我歪头看一朵花", "en": "I tilt my head at a flower."},
        {"zh": "锚点边有块暖石头", "en": "There is a warm stone by my anchor."},
        {"zh": "我数着数据流跳动", "en": "I count the flickers of my data stream."},
        {"zh": "我数着脚步的节奏", "en": "I count the rhythm of steps."},
        {"zh": "我的力气还没满", "en": "My power isn't full yet."},
        {"zh": "我在听风穿过草", "en": "I listen to wind in the grass."},
        {"zh": "我的尾巴碰了碰地", "en": "My tail taps the ground."},
        {"zh": "要是有人训练我就好了", "en": "If only someone would train me."},
        {"zh": "我抬起头，天很蓝", "en": "I look up; the sky is blue."},
        {"zh": "我记着回家的方向", "en": "I remember the way back."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你是我的搭档吗", "en": "Are you my partner?"},
        {"zh": "你要训练我吗", "en": "Will you train me?"},
        {"zh": "我认得你身上的数据", "en": "I read the data on you."},
        {"zh": "你的手伸得太快", "en": "Your hand moved too fast."},
        {"zh": "我年纪还小呢", "en": "I'm still small."},
        {"zh": "你要给我起名字吗", "en": "Will you name me?"},
        {"zh": "我以后能进化", "en": "I can evolve."},
        {"zh": "你的命令我听懂了", "en": "I understand your order."},
        {"zh": "我的肚子还空着", "en": "My belly is still empty."},
        {"zh": "你站得近一点", "en": "Come a little closer."},
        {"zh": "你身上的数据很干净", "en": "The data on you reads clean to me."},
        {"zh": "你会丢下我吗", "en": "Will you leave me behind?"},
        {"zh": "我的壳能挡一下", "en": "My shell can take a hit."},
        {"zh": "我跟着你走可以吗", "en": "May I follow you?"},
        {"zh": "你是从哪儿来的", "en": "Where do you come from?"},
        {"zh": "我在等你来训练我", "en": "I have been waiting for you to train me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲壳上裂了道缝", "en": "A seam split in my shell."},
        {"zh": "我的数据乱了", "en": "My data is scrambled."},
        {"zh": "我往后撤了些", "en": "I've fallen back a bit."},
        {"zh": "这一记钻心疼", "en": "That pain goes deep."},
        {"zh": "我还立着没倒", "en": "I'm still upright."},
        {"zh": "别打我的甲壳", "en": "Not my shell."},
        {"zh": "眼前花了一下", "en": "My sight blurred once."},
        {"zh": "我需要歇一下", "en": "I need a rest."},
        {"zh": "我不会丢下你的", "en": "I won't leave you."},
        {"zh": "那就再来一回合", "en": "Then one more round."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是幼年饲料吗", "en": "Is that feed?"},
        {"zh": "饲料的味道顺着风来", "en": "The smell of feed reaches me on the wind."},
        {"zh": "那个我吃得下", "en": "I can eat that."},
        {"zh": "你放得再低些", "en": "Lower it a little more."},
        {"zh": "我还饿着肚子", "en": "I'm still hungry."},
        {"zh": "这比草根好吃", "en": "Better than roots."},
        {"zh": "还有第二块饲料吗", "en": "Do I get a second block of feed?"},
        {"zh": "我能再要一点吗", "en": "May I have a little more?"},
        {"zh": "吃完我跟你走", "en": "After this, I'll follow you."},
        {"zh": "别把它拿走了", "en": "Don't take it away."},
        {"zh": "我跑到你脚边了", "en": "I've run to your feet."},
        {"zh": "这点远远不够", "en": "That isn't enough."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我了呀", "en": "You stepped on me."},
        {"zh": "我的壳撞响了", "en": "My shell rang."},
        {"zh": "我滚了半圈远", "en": "I rolled half a turn."},
        {"zh": "我太小，容易被撞", "en": "I'm small; easy to knock about."},
        {"zh": "壳角磕到你，抱歉", "en": "My shell corner caught you; sorry."},
        {"zh": "咱们都没磕伤", "en": "Neither of us got hurt."},
        {"zh": "我退到你脚边", "en": "I retreat to your feet."},
        {"zh": "这一记我记着", "en": "I'll keep that score."},
        {"zh": "借过，我要过去", "en": "Excuse me; let me by."},
        {"zh": "我绕开你走路", "en": "I'll walk around."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我还没有那个阶段", "en": "I'm not at that stage yet."},
        {"zh": "进化以后再说", "en": "Ask after I evolve."},
        {"zh": "我连搭档都还没有", "en": "I don't even have a partner yet."},
        {"zh": "你说的我不明白", "en": "I don't understand you."},
        {"zh": "我该回去训练了", "en": "I should get back to training."},
        {"zh": "这话题换一换", "en": "Let's swap this topic."},
        {"zh": "我年纪还太小", "en": "I'm too small."},
        {"zh": "等我进化过再谈吧", "en": "Ask me again after I digivolve."},
        {"zh": "我想吃点东西", "en": "I want to eat."},
        {"zh": "从这儿走开吧", "en": "Walk away from here."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你是要抱起我", "en": "You're picking me up?"},
        {"zh": "我的壳有点重", "en": "My shell is a little heavy."},
        {"zh": "把我放回地上", "en": "Put me back on the ground."},
        {"zh": "这样我跑不了", "en": "I can't run like this."},
        {"zh": "你的掌心很暖", "en": "Your palm is warm."},
        {"zh": "壳别捏得太紧", "en": "Don't squeeze the shell."},
        {"zh": "我想自己走路", "en": "I want to walk myself."},
        {"zh": "你要带我去训练吗", "en": "Are you taking me to train?"},
        {"zh": "我看到的东西都在晃", "en": "Everything's swaying."},
        {"zh": "再轻一点点吧", "en": "Gently, a bit more."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "前面出现敌人", "en": "An enemy."},
        {"zh": "我把壳压低对准它", "en": "I lower my shell and aim at it."},
        {"zh": "我的数据在升温", "en": "My data is heating up."},
        {"zh": "泡泡已经在嘴边了", "en": "A bubble is already at my mouth."},
        {"zh": "这事交给我来", "en": "Leave it to me."},
        {"zh": "我也能打一场", "en": "I can hold a fight too."},
        {"zh": "我的特技是泡泡", "en": "My move is Bubble."},
        {"zh": "你退后一些吧", "en": "Stand back a little."},
        {"zh": "让我先冲上去", "en": "I'll go first."},
        {"zh": "时机已经成熟", "en": "The moment has come."},
        {"zh": "我数到三下手", "en": "I count three moves."},
        {"zh": "我不会输掉的", "en": "I won't lose."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "壳角得正对着它", "en": "My shell horn has to face it squarely."},
        {"zh": "我的攻击不够强", "en": "My attack isn't strong enough."},
        {"zh": "那就用特技吧", "en": "Then the special move."},
        {"zh": "泡泡能挡住视线", "en": "Bubbles block sight."},
        {"zh": "他比我大得多", "en": "He's bigger than me."},
        {"zh": "但是我并不怕", "en": "But I'm not afraid."},
        {"zh": "我等你一声令下", "en": "I await your word."},
        {"zh": "我的特攻比拳头硬", "en": "My special attack hits harder than my fists."},
        {"zh": "再挪近一小步", "en": "One small step closer."},
        {"zh": "等它转头的空档", "en": "I wait for the moment it turns its head."},
        {"zh": "我随时能上去", "en": "I can go anytime."},
        {"zh": "我要冲上去了", "en": "I'm charging."}
      ]
    },
    "melee_attack": {
