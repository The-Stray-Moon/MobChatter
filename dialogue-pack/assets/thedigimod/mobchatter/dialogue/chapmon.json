      "lines": [
        {"zh": "我咬你一下子", "en": "I bite."},
        {"zh": "这一下不算大", "en": "That one's small."},
        {"zh": "我整个壳撞你的膝", "en": "I ram your knee with my whole shell."},
        {"zh": "你退了一步远", "en": "You stepped back."},
