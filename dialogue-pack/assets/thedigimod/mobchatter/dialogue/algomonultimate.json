{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我跨过树冠，落在河滩", "en": "I step over the canopy and land on the riverbank."},
        {"zh": "我的身形比树还高", "en": "I stand taller than the trees."},
        {"zh": "我一步一步走得很沉", "en": "My every step is heavy."},
        {"zh": "水从我的脚边漫开", "en": "Water spreads from my feet."},
        {"zh": "我沿着河岸巡过去", "en": "I patrol along the bank."},
        {"zh": "我的长臂垂到地面", "en": "My long arms reach the ground."},
        {"zh": "我朝锚点的方向走", "en": "I walk toward my anchor."},
        {"zh": "树在我身边退开", "en": "The trees fall away beside me."},
        {"zh": "我踩过浅滩，水花很高", "en": "I cross the shallows; water sprays high."},
        {"zh": "我停下来，环顾四周", "en": "I stop and look around."},
        {"zh": "我的影子盖住一片草地", "en": "My shadow covers a stretch of grass."},
        {"zh": "藤足拖过丛林的地面。", "en": "My vine feet drag across the jungle floor."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我立在河岸边，不动", "en": "I stand at the riverbank, still."},
        {"zh": "我的数据流很平稳", "en": "My data streams flow evenly."},
        {"zh": "我已经不是从前那个了", "en": "I'm no longer what I was."},
        {"zh": "我比之前高了太多", "en": "I've grown far taller than before."},
        {"zh": "我能听见远处的水声", "en": "I can hear the water far off."},
        {"zh": "我把手臂慢慢抬起", "en": "I raise my arm, slowly."},
        {"zh": "关节发出低沉的响声", "en": "The joints give a deep sound."},
        {"zh": "我又把它放下", "en": "Then I lower it."},
        {"zh": "河面反射着光", "en": "The river's face throws back light."},
        {"zh": "我在等一个明确的指示", "en": "I'm waiting for a clear instruction."},
        {"zh": "没有指示，我就守着", "en": "Without one, I keep watch."},
        {"zh": "我的呼吸很缓", "en": "My breathing is very slow."},
        {"zh": "这里的风比我记得的大", "en": "The wind here is stronger than I remember."},
        {"zh": "我记下了这片水域", "en": "I've recorded this stretch of water."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头看我，很吃力", "en": "You strain to look up at me."},
        {"zh": "我低着头看你", "en": "I look down at you."},
        {"zh": "这个高度差很大", "en": "The difference in height is great."},
        {"zh": "但你站得很稳", "en": "Yet you stand steady."},
        {"zh": "我的资料里没有你这条记录。", "en": "My data has no record of you."},
        {"zh": "我在重新评估", "en": "I'm reassessing."},
        {"zh": "你若想谈，就说", "en": "If you'd talk, speak."},
        {"zh": "我正在听着你说", "en": "I'm listening."},
        {"zh": "你若想动手，也可以", "en": "If you'd fight, that's also possible."},
        {"zh": "我不主动出手", "en": "I don't begin it."},
        {"zh": "我侧过身，露出侧面", "en": "I turn, showing my flank."},
        {"zh": "那里的甲比正面薄", "en": "The armor there is thinner."},
        {"zh": "但我并不担心", "en": "But I'm not concerned."},
        {"zh": "你还没到那个程度", "en": "You aren't at that level yet."},
        {"zh": "我慢慢收回视线", "en": "I draw my gaze back slowly."},
        {"zh": "你走你的，别挡我的藤。", "en": "Go your way; don't block my vines."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的数据短暂错乱", "en": "My data is briefly disordered."},
        {"zh": "我退了一步，河岸塌了", "en": "I step back; the bank collapses."},
        {"zh": "我的甲上出现裂痕", "en": "A crack opens in my armor."},
        {"zh": "大量能量外泄", "en": "Much energy escapes."},
        {"zh": "我把手臂横在身前", "en": "I bring my arm across my front."},
        {"zh": "我的动作慢了一点", "en": "My movements have slowed a little."},
        {"zh": "我低头查看损伤", "en": "I look down at the damage."},
        {"zh": "我还能够继续守着", "en": "I can keep watch yet."},
        {"zh": "我重新站定身形", "en": "I set my stance again."},
        {"zh": "你的力道不差", "en": "Your force isn't bad."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这么一点东西", "en": "Such a small amount."},
        {"zh": "我现在需要的更多", "en": "I need far more than that now."},
        {"zh": "我低头，藤蔓探了探。", "en": "I lower my head and my vines probe."},
        {"zh": "这个味道还可以", "en": "The taste is acceptable."},
        {"zh": "但不够我一口", "en": "But not a mouthful for me."},
        {"zh": "你放在那里吧", "en": "Leave it there."},
        {"zh": "我自己会去找", "en": "I'll find my own."},
        {"zh": "这点不能让我停下", "en": "This won't make me stop."},
        {"zh": "我记住了你的好意", "en": "I've noted your goodwill."},
        {"zh": "但我还在值守", "en": "But I'm still on watch."},
        {"zh": "你留着吧，我不缺能量。", "en": "Keep it; I'm not short on energy."},
        {"zh": "我的任务更要紧", "en": "My task matters more."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我一动不动，你弹开了", "en": "I don't move; you bounce off."},
        {"zh": "我这身量，走哪都挡路", "en": "At my size I block any path."},
        {"zh": "我慢慢挪开一步", "en": "I shift one step aside."},
        {"zh": "你撞上我三格高的腿。", "en": "You hit my three-block-tall leg."},
        {"zh": "完全体的壳，几乎没感觉到。", "en": "A Perfect-stage shell hardly feels it."},
        {"zh": "你退开，我才转得过身。", "en": "Step back so I can turn around."},
        {"zh": "地面被我们踩得下陷", "en": "The ground sinks where we stand."},
        {"zh": "这点冲撞碰不动我的根。", "en": "That bump won't shift my roots."},
        {"zh": "你要过去，就绕开我", "en": "To pass, go around me."},
        {"zh": "我尽量不动身子", "en": "I'll try not to move."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我现在的职责更重", "en": "My duty is heavier now."},
        {"zh": "伙伴我懂，但我先守着", "en": "I know partnership, but I watch first."},
        {"zh": "主人还没回来", "en": "My master hasn't returned."},
