{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翼展盖住半个山坡。", "en": "My wingspan covers half the slope."},
        {"zh": "我从尖峰上滑下来。", "en": "I glide down from the sharp peaks."},
        {"zh": "我的翼风把草压低。", "en": "The wind of my wings bends the grass."},
        {"zh": "我绕着自己的锚点飞。", "en": "I circle my own anchor."},
        {"zh": "山脊在我下方变窄。", "en": "The ridgeline narrows below me."},
        {"zh": "我贴着红岩飞过去。", "en": "I skim past the red rock."},
        {"zh": "我换了一个高度。", "en": "I switch altitude."},
        {"zh": "我想落在那里。", "en": "I mean to land there."},
        {"zh": "我的影子拖得极长。", "en": "My shadow drags very long."},
        {"zh": "我朝主人偏过去。", "en": "I angle toward my owner."},
        {"zh": "我不必奔跑。", "en": "I have no need to run."},
        {"zh": "我只需要飞。", "en": "I only need to fly."},
        {"zh": "我把翼收了一半。", "en": "I half-fold my wings."},
        {"zh": "地面离得很近了。", "en": "The ground is close now."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在山脊上。", "en": "I settle on the ridge."},
        {"zh": "我的翼慢慢合起来。", "en": "My wings fold slowly."},
        {"zh": "我环顾这片山。", "en": "I survey this range."},
        {"zh": "我在等主人。", "en": "I wait for my owner."},
        {"zh": "翅膀这么大，身体比看上去重。", "en": "Wings this wide, and I am heavier than I look."},
        {"zh": "我把爪子按在石头上。", "en": "I press my claws to the stone."},
        {"zh": "我在数山下的动静。", "en": "I count the movement below."},
        {"zh": "风从峡谷里上来。", "en": "Wind rises from the canyon."},
        {"zh": "我抬起头，看着云。", "en": "I lift my head to the clouds."},
        {"zh": "我慢慢偏了下头。", "en": "I tilt my head slowly."},
        {"zh": "我在等一段距离。", "en": "I wait for the right range."},
        {"zh": "我的能量在慢慢稳。", "en": "My energy settles."},
        {"zh": "我停在岩顶，等下一战。", "en": "I perch on the crag and wait for the next fight."},
        {"zh": "站着也挺好。", "en": "Standing suits me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比看上去小。", "en": "You're smaller than you look."},
        {"zh": "你挨我挨得太近了。", "en": "You're much too near me."},
        {"zh": "我的翼比你整个人长。", "en": "My wing is longer than you are tall."},
        {"zh": "我的锚点不在这。", "en": "My anchor isn't here."},
        {"zh": "你要跟我走吗？", "en": "Will you come with me?"},
        {"zh": "我能驮两个人。", "en": "I can carry two riders."},
        {"zh": "你的手别摸翼膜。", "en": "Don't touch my membrane."},
        {"zh": "你的靴子沾了红土。", "en": "Red earth on your boots."},
        {"zh": "我一转身你就得让。", "en": "When I turn, you must move."},
        {"zh": "我飞起来，翅膀有屋子宽。", "en": "When I fly, my wings span a room."},
        {"zh": "我不喜欢被牵。", "en": "I dislike being led."},
        {"zh": "除非你值得。", "en": "Unless you're worth it."},
        {"zh": "你身上有矿渣味。", "en": "You smell of slag."},
        {"zh": "这味道不难闻。", "en": "Not unpleasant."},
        {"zh": "我再看看你。", "en": "Let me look a while longer."},
        {"zh": "你抬头就看得见我。", "en": "Look up and you'll see me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翼破了一处。", "en": "A tear in my wing."},
        {"zh": "我落在石上缓一缓。", "en": "I land on stone to recover."},
        {"zh": "翼膜在抖。", "en": "My membrane trembles."},
        {"zh": "这点伤不深。", "en": "The wound is shallow."},
        {"zh": "我扇得很费劲。", "en": "Each beat costs me."},
        {"zh": "我的翅根在发烫。", "en": "The base of my wing is burning."},
        {"zh": "石头上落了血。", "en": "Blood falls on the stone."},
        {"zh": "翼骨没断，就还能战。", "en": "My wing bones hold; I can still fight."},
        {"zh": "你让我意外。", "en": "You surprised me."},
        {"zh": "下一次不会。", "en": "It won't happen again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这一堆是废铁？", "en": "Is that heap scrap iron?"},
        {"zh": "再抬高些。", "en": "A little higher."},
        {"zh": "我闻到了金属。", "en": "I smell metal."},
        {"zh": "四格宽的翅膀，靠废料养。", "en": "Four blocks of wing, fed on scrap."},
        {"zh": "我落下来取。", "en": "I'll come down for it."},
        {"zh": "放石头上。", "en": "Put it on the stone."},
        {"zh": "这铁锈得有年头。", "en": "This rust is old."},
        {"zh": "这点废料，不够我动。", "en": "That scrap is not worth moving for."},
        {"zh": "这能补一点能量。", "en": "This restores a little energy."},
        {"zh": "你可以再带一些。", "en": "You could bring more."},
        {"zh": "我会记得这味道。", "en": "I'll remember this taste."},
        {"zh": "算你聪明。", "en": "Clever of you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的胫上。", "en": "You hit my shin."},
        {"zh": "四格宽的翅，撑着我。", "en": "Four blocks of wing hold me up."},
        {"zh": "别贴着我的翼根。", "en": "Don't stand at my wing base."},
        {"zh": "你被风推开了。", "en": "The wind of my wings pushed you."},
        {"zh": "我的骨头很轻很硬。", "en": "My bones are light and hard."},
        {"zh": "我的翼展扫过你头顶。", "en": "My wingspan sweeps over your head."},
        {"zh": "这点碰撞我懒得理。", "en": "I can't be bothered with that."},
        {"zh": "你踏进了我的脚印。", "en": "You stepped inside my print."},
        {"zh": "那个印有半尺深。", "en": "That print is half a foot deep."},
        {"zh": "再靠近我就起飞。", "en": "Closer and I take off."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我不是野外生的。", "en": "I wasn't born in the wild."},
        {"zh": "这种问题没有意义。", "en": "That question is meaningless."},
        {"zh": "我只跟着一个主人。", "en": "I follow one owner only."},
        {"zh": "我活得很长。", "en": "I live a long time."},
        {"zh": "你熬不到那岁数。", "en": "You won't reach that age."},
        {"zh": "别在我脚边提这些。", "en": "Don't raise it at my feet."},
        {"zh": "我更想飞。", "en": "I'd rather fly."},
        {"zh": "我要去巡山脊。", "en": "I'm off to patrol the ridge."},
        {"zh": "我守着这片崖，不需要伴。", "en": "I keep this cliff alone."},
        {"zh": "别耽误我。", "en": "Don't delay me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一块大铁板。", "en": "A large plate of iron."},
        {"zh": "我一口就咬断了。", "en": "One bite shears it."},
        {"zh": "太重，我不带。", "en": "Too heavy, I'll leave it."},
        {"zh": "我叼着它起飞。", "en": "I take off with it."},
        {"zh": "这堆废料能撑几天。", "en": "This heap lasts a few days."},
        {"zh": "我的翅膀一展，能载人。", "en": "One spread of my wings can carry a rider."},
        {"zh": "主人会喜欢这个。", "en": "My owner will like this."},
        {"zh": "我用爪子压着。", "en": "I hold it under a claw."},
        {"zh": "这东西在我嘴里响。", "en": "It clatters in my jaws."},
        {"zh": "先收着。", "en": "I'll keep it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我的视线里。", "en": "You're in my line of sight."},
        {"zh": "我先升到高处。", "en": "First I climb high."},
        {"zh": "太阳在你背后，正好。", "en": "The sun is behind you. Perfect."},
        {"zh": "我的翼全开了。", "en": "My wings are fully open."},
        {"zh": "主人不会有事。", "en": "My owner will come to no harm."},
        {"zh": "这道门，我不会让你过。", "en": "This gate, I will not let you pass."},
        {"zh": "我的能量在聚。", "en": "My energy gathers."},
        {"zh": "Mega Blaster 上膛。", "en": "Mega Blaster charged."},
        {"zh": "还剩三下。", "en": "Three left."},
        {"zh": "只剩两下。", "en": "Two left."},
        {"zh": "收尾的一下。", "en": "The closing blow."},
        {"zh": "我降下来。", "en": "I come down."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕了一圈再绕一圈。", "en": "I circle once, then again."},
        {"zh": "我这对大翼一张，山都挡不住。", "en": "These great wings spread and hills cannot stop them."},
        {"zh": "我的影子从你身上过去。", "en": "My shadow passes over you."},
        {"zh": "你没有抬头。", "en": "You didn't look up."},
        {"zh": "我的翼声很低。", "en": "My wingbeats are low."},
        {"zh": "你的手开始抖。", "en": "Your hands start shaking."},
        {"zh": "我贴着山壁绕到你身后。", "en": "I hug the cliff and come up behind you."},
        {"zh": "你的护甲在后颈薄。", "en": "Your armor is thin at the nape."},
        {"zh": "我瞧得一清二楚。", "en": "I see it perfectly clearly."},
        {"zh": "再给一点时间。", "en": "A little more time."},
        {"zh": "你就站定了。", "en": "You'll settle."},
        {"zh": "这一瞬。", "en": "This instant."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲下来，翼风先到。", "en": "I dive; my wing wind hits first."},
        {"zh": "爪子把你掀开。", "en": "My claws throw you clear."},
        {"zh": "我的俯冲把你掀翻了。", "en": "My dive flipped you over."},
        {"zh": "我的爪先撞上你的盾。", "en": "My claw hits your shield first."},
        {"zh": "这一发连着电流。", "en": "This one carries a current."},
        {"zh": "你的护甲焦了一片。", "en": "A patch of your armor is scorched."},
        {"zh": "我拉起来换角度。", "en": "I pull up and change angle."},
        {"zh": "你还在找我。", "en": "You're still looking for me."},
        {"zh": "我的爪从云里落下来。", "en": "My claw drops out of the cloud."},
        {"zh": "第二发更准。", "en": "The second is truer."},
        {"zh": "你的右手废了。", "en": "Your right arm is spent."},
        {"zh": "我落下来看着你。", "en": "I come down and look at you."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处的云里落下来。", "en": "I drop out of the high cloud."},
        {"zh": "山脊上多了一副大翼。", "en": "A great pair of wings on the ridge."},
        {"zh": "我先在锚点上空绕行。", "en": "I circle above my anchor first."},
        {"zh": "我的翼扫倒了几丛草。", "en": "My wings flatten clumps of grass."},
        {"zh": "红岩被我的影子盖住。", "en": "My shadow covers the red rock."},
        {"zh": "我落在一块平石上。", "en": "I land on a flat stone."},
        {"zh": "我的爪深深抓进去。", "en": "My claws dig in deep."},
        {"zh": "这里的风我喜欢。", "en": "I like the wind here."},
        {"zh": "我抬高了头。", "en": "I raise my head high."},
        {"zh": "我听见了远处的响动。", "en": "I hear noise far off."},
        {"zh": "我先在高处停住，看清你再落。", "en": "I stop up high, look you over, then drop."},
        {"zh": "等它靠近。", "en": "Let it come closer."},
        {"zh": "这片山是我的。", "en": "This range is mine."},
        {"zh": "你也在。", "en": "You're here too."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到翼膜，我猛扇开。", "en": "Fire hits my membrane; I beat it out."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我不怕摔，可这一下很闷。", "en": "I don't fear falls, but that one landed hard."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把翼压住，我沉得很快。", "en": "Water pins my wings, I sink fast."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我拍在岩壁上。", "en": "The blast slams me into the cliff."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西扎穿了翼骨。", "en": "That pierced a wing bone."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力顺着翼膜爬。", "en": "Magic crawls along my membrane."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "废料不够，能量在掉。", "en": "Not enough scrap; my energy falls."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，我翼尖全是光。", "en": "Lightning strikes, light at every wingtip."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里我找不到上升的气流。", "en": "No updraft to find in the void."}
      ]
    }
  }
}
