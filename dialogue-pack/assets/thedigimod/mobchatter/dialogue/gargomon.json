{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在白桦林间走着。", "en": "I move between the birches."},
        {"zh": "翅膀收在背后。", "en": "My wings are folded at my back."},
        {"zh": "我高过这些树的一半。", "en": "I stand half again these trees' height."},
        {"zh": "我走起来地面有点震。", "en": "The ground jars a little when I walk."},
        {"zh": "我的爪子抓在树干上。", "en": "My claws catch the trunks."},
        {"zh": "我朝林子更深处走。", "en": "I go deeper into the wood."},
        {"zh": "树影在我身上落下。", "en": "Tree shadows fall across me."},
        {"zh": "我一脚一脚踏得稳。", "en": "Each footfall lands square."},
        {"zh": "翅膀尖擦过低枝。", "en": "My wingtips brush the low branches."},
        {"zh": "哪儿有风，就往哪儿走。", "en": "Where there's wind, that's my way."},
        {"zh": "我跟着那道白色的树干。", "en": "I follow that white trunk line."},
        {"zh": "我踩断了一根白桦枝。", "en": "I snap a birch branch underfoot."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在林间的空地上。", "en": "I stand in the clearing."},
        {"zh": "翅膀松松散着。", "en": "My wings hang loose."},
        {"zh": "我在听风穿林子。", "en": "I listen to the wind."},
        {"zh": "白桦的皮很亮。", "en": "The birch bark is bright."},
        {"zh": "我把翅膀抖松。", "en": "I shake my wings loose."},
        {"zh": "我把爪尖收进羽里。", "en": "I sheath the claw tips in feathers."},
        {"zh": "这一带非常安静。", "en": "This whole stretch is quiet."},
        {"zh": "白桦叶响，我没动。", "en": "The birch leaves rustle; I do not move."},
        {"zh": "阳光从叶子缝里落下来。", "en": "Sun comes through the leaves."},
        {"zh": "白桦的影子落在我背上。", "en": "Birch shadows fall across my back."},
        {"zh": "这层羽毛很厚。", "en": "This layer of feathers is thick."},
        {"zh": "我抬了抬一边的翅。", "en": "I lift one wing."},
        {"zh": "林子里没别的事。", "en": "Nothing else in this wood."},
        {"zh": "林子里的风绕着我转。", "en": "The wind of the wood circles around me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅尖在你头顶。", "en": "My wingtip is over your head."},
        {"zh": "我高过你一个头还多。", "en": "I stand more than a head above you."},
        {"zh": "我的翅膀不只是看的。", "en": "These wings aren't only for show."},
        {"zh": "你手里的东西放下吧。", "en": "Lower what you're holding."},
        {"zh": "我这一片林子很安静。", "en": "My part of the wood is quiet."},
        {"zh": "白桦林的羽毛，有我的味。", "en": "Birch forest feathers carry my scent."},
        {"zh": "你今天不该来。", "en": "You shouldn't have come today."},
        {"zh": "我的手臂上有枪管。", "en": "Barrels run along my arms."},
        {"zh": "你要走过去的话，我让一让。", "en": "If you need to pass, I'll step aside."},
        {"zh": "你退几步吧。", "en": "A few steps back."},
        {"zh": "这片白桦林归我巡。", "en": "I patrol these birches."},
        {"zh": "我身上的羽毛很硬。", "en": "These feathers are hard."},
        {"zh": "你眼睛在看哪里。", "en": "Where are you looking."},
        {"zh": "我能看清你的动作。", "en": "I can see what you're doing."},
        {"zh": "白桦林里，我的枪口朝下。", "en": "In the birches, my barrels point down."},
        {"zh": "你退开两步再说话。", "en": "Step back two paces before you speak."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膜上破了个小口。", "en": "A small tear has opened in my wing membrane."},
        {"zh": "白桦皮被我撞掉一块。", "en": "I knocked a patch of birch bark loose."},
        {"zh": "我从胸腔里低吼。", "en": "A growl rose from my chest."},
        {"zh": "翅膜破了一个口。", "en": "A tear in the wing membrane."},
        {"zh": "我退到一棵白桦后。", "en": "I back behind a birch."},
        {"zh": "树影里看不清伤口。", "en": "The shade hides the wound."},
        {"zh": "我的肩膀震了一下。", "en": "My shoulder jolted."},
        {"zh": "我喊不出来，只是低鸣。", "en": "I cannot shout, only rumble."},
        {"zh": "我压住翅膀，低声喘。", "en": "I pin my wings and pant low."},
        {"zh": "我的翅根被打得发麻。", "en": "The base of my wing has gone numb."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里举着啥？", "en": "What are you holding up?"},
        {"zh": "那点东西不值一提。", "en": "That is not worth mentioning."},
        {"zh": "我不太吃这个。", "en": "I don't much eat that."},
        {"zh": "搁在白桦根下吧。", "en": "Leave it by the birch roots."},
        {"zh": "我闻着不像食物。", "en": "That doesn't smell like food."},
        {"zh": "你举得再高一点。", "en": "Hold it a little higher."},
        {"zh": "这点份量，塞不满我牙缝。", "en": "That much will not fill the gaps in my teeth."},
        {"zh": "你自己留着吃吧，我不饿。", "en": "Keep it for yourself. I'm not hungry."},
        {"zh": "我更喜欢林子里的。", "en": "I prefer what's in the wood."},
        {"zh": "别把它丢在地上。", "en": "Don't drop it on the ground."},
        {"zh": "你可以自己吃。", "en": "You can eat it yourself."},
        {"zh": "拿远些，我在忙。", "en": "Keep it away. I'm occupied."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "撞上我，你像撞一棵树。", "en": "Hitting me is like hitting a tree."},
        {"zh": "我几乎没有晃动。", "en": "I barely swayed."},
        {"zh": "我的翅膀碰到你。", "en": "My wing touched you."},
        {"zh": "你退开时踩断了枝条。", "en": "You snapped a twig stepping back."},
        {"zh": "我们之间隔着一根树干。", "en": "There's a trunk between us."},
        {"zh": "我的爪子踩在你旁边。", "en": "My claw came down beside you."},
        {"zh": "这一撞不够沉。", "en": "That impact was not heavy."},
        {"zh": "你身上有树皮的味。", "en": "You smell of bark now."},
        {"zh": "我的翅膀扫落一层叶子。", "en": "My wing sweeps down a layer of leaves."},
        {"zh": "树影把我们盖住了。", "en": "The trees covered us both."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在白桦之间。", "en": "We're between the birches."},
        {"zh": "两对翅膀都张着。", "en": "Both pairs of wings are spread."},
        {"zh": "别站在我们翅膀下。", "en": "Do not stand under our wings."},
        {"zh": "它的翅膀张开比我宽。", "en": "Its wings open wider than mine."},
        {"zh": "我们挨着站了一阵。", "en": "We stood close a while."},
        {"zh": "地上的叶子全乱了。", "en": "The leaves are all churned."},
        {"zh": "之后各守一片林子。", "en": "Afterwards we each keep to our own wood."},
        {"zh": "翅膀拍动的声音很大。", "en": "The wings made a lot of noise."},
        {"zh": "这一带会安静一阵。", "en": "This area will be quiet for a while."},
        {"zh": "我们没怎么出声。", "en": "We hardly made a sound."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用爪子抓起一块。", "en": "I pick up a piece in my claws."},
        {"zh": "这块木头很沉。", "en": "This log is heavy."},
        {"zh": "我用爪子抓起一把。", "en": "I scoop up a handful in my claws."},
        {"zh": "这东西在手里很小。", "en": "This is small in my grip."},
        {"zh": "这果子熟得刚好。", "en": "This fruit is just ripe."},
        {"zh": "我把果子一颗颗捡起。", "en": "I pick the fallen fruit up one by one."},
        {"zh": "你掉的东西在这里。", "en": "Your dropped thing is here."},
        {"zh": "这木头硬得咬不动。", "en": "This wood is too hard to bite."},
        {"zh": "这玩意儿没味道。", "en": "This has no taste."},
        {"zh": "我的加特林，打不中它。", "en": "My gatling can't hit that."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进这片白桦林了。", "en": "You've come into these birches."},
        {"zh": "我从白桦后看见你了。", "en": "I saw you behind the birch."},
        {"zh": "这里的树全是我的记号。", "en": "Every tree here is marked by me."},
        {"zh": "我把身子转朝你。", "en": "I turn my body toward you."},
        {"zh": "你站的地方很开阔。", "en": "You're standing in the open."},
        {"zh": "我把翅膀张开半截。", "en": "I open the wings halfway."},
        {"zh": "这一片只有一个出口。", "en": "There's one way out of here."},
        {"zh": "你带着铁和汗的味。", "en": "You smell of iron and sweat."},
        {"zh": "白桦叶子挡住了你。", "en": "The birch leaves hide you."},
        {"zh": "你要跑，我飞得比你快。", "en": "Run, and I fly faster."},
        {"zh": "树叶的声音出卖了你。", "en": "The leaves gave you away."},
        {"zh": "爪尖已经露出来了。", "en": "The claw tips are showing."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着白桦跟。", "en": "I follow along the birches."},
        {"zh": "你走到那棵倒木后面。", "en": "You're behind the fallen log."},
        {"zh": "我在树与树之间走。", "en": "I move between the trunks."},
        {"zh": "你朝林子边缘去。", "en": "You are heading for the edge of the wood."},
        {"zh": "林子里的风很乱。", "en": "The wind in the wood is confused."},
        {"zh": "你的脚步越走越沉。", "en": "Your steps grow heavier."},
        {"zh": "我从上面看得见你。", "en": "I can see you from above."},
        {"zh": "你在两棵树之间。", "en": "You are between two trees."},
        {"zh": "影子盖在你身上了。", "en": "My shadow covers you."},
        {"zh": "你的脚步惊起一只鸟。", "en": "Your steps startle a bird."},
        {"zh": "你踩断的枝条还在响。", "en": "The twig you broke is still sounding."},
        {"zh": "我离你不到两棵树。", "en": "Less than two trees between us."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的枪口对着它压下去。", "en": "I press my barrels down at it."},
        {"zh": "这一下撞断了树枝。", "en": "That snapped a branch off."},
        {"zh": "你被扫得退了。", "en": "You were swept back."},
        {"zh": "我的翅膀也拍了过去。", "en": "My wing came in too."},
        {"zh": "你的护甲上留下三道。", "en": "Three marks on your armor."},
        {"zh": "你退到树根边上。", "en": "You're at the roots."},
        {"zh": "我的爪子带了羽毛的风。", "en": "My claw comes with the wind of my feathers."},
        {"zh": "我并没有追上去。", "en": "I did not follow through."},
        {"zh": "白桦叶子被撞得乱飞。", "en": "Birch leaves flew from the blow."},
        {"zh": "你的手里还在抖。", "en": "Your hands are still shaking."},
        {"zh": "我甩了甩爪子。", "en": "I shook my claw."},
        {"zh": "我的枪口冒着白烟。", "en": "White smoke curls from my barrels."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从白桦林里走出来。", "en": "I step out of the birches."},
        {"zh": "翅膀先露出树影。", "en": "Wings emerge first from the trees."},
        {"zh": "白桦林里静得出奇。", "en": "The birches are oddly still."},
        {"zh": "我一落地，叶子全飞了。", "en": "Leaves burst up as I landed."},
        {"zh": "我站得比树高一半。", "en": "I stand half again the trees' height."},
        {"zh": "我朝白桦间的空地走。", "en": "I head for the gap between birches."},
        {"zh": "我身上的羽毛还带着露水。", "en": "There's dew on my feathers."},
        {"zh": "风把我的翅羽吹开。", "en": "The wind parts my wing feathers."},
        {"zh": "我看了看四周的树。", "en": "I looked at the trees around."},
        {"zh": "我抬起头，树影落在脸上。", "en": "I raised my head into the shade."},
        {"zh": "这里没有人来过。", "en": "Nobody has been here."},
        {"zh": "我把翅膀慢慢合上。", "en": "I close my wings slowly."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛一烧就卷起来。", "en": "The feathers curled in the fire."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时我压断了好几根枝。", "en": "I crushed several branches landing."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "羽毛吸了水，我飞不起来。", "en": "Wet feathers and I can't fly."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把叶子都掀了起来。", "en": "The blast threw up every leaf."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎进我的翅膀。", "en": "An arrow in my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光让我的视野乱了。", "en": "That light scrambled my vision."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里的吃的不多。", "en": "There's little to eat in this wood."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈中我，羽毛全焦了。", "en": "Lightning struck; my feathers scorched."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有树可以停。", "en": "No tree to perch on in the void."}
      ]
    }
  }
}
