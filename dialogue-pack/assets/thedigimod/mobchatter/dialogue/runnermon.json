{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我四条腿跑得很快。", "en": "My four legs carry me fast."},
        {"zh": "我绕着锚点跑圈。", "en": "I run laps around my anchor."},
        {"zh": "我的蹄子敲在地上。", "en": "My hooves strike the ground."},
        {"zh": "我的蹄子一撒开就收不回。", "en": "Once my hooves open up I can't pull them back."},
        {"zh": "我沿着黑森林边缘跑。", "en": "I run along the dark forest's edge."},
        {"zh": "我侧身拐了个弯。", "en": "I bank into a turn."},
        {"zh": "我朝远处的声音跑。", "en": "I run toward the distant sound."},
        {"zh": "我的尾巴在后面飘。", "en": "My tail streams behind."},
        {"zh": "我跑过一片草地。", "en": "I cross a stretch of grass."},
        {"zh": "我慢下来走几步。", "en": "I slow to a walk for a few steps."},
        {"zh": "我又开始加速。", "en": "I speed up again."},
        {"zh": "我绕过那一块石头。", "en": "I swerve around a stone."},
        {"zh": "我跑得比风还稳。", "en": "I run steadier than the wind."},
        {"zh": "我的耐力很好。", "en": "My stamina is good."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着甩尾巴。", "en": "I stand and swish my tail."},
        {"zh": "我的呼吸很快恢复。", "en": "My breathing recovers quickly."},
        {"zh": "远处那条路，我跑过。", "en": "That far road, I have run it."},
        {"zh": "我抖了抖四条腿。", "en": "I shake out my legs."},
        {"zh": "你一拍腿，我就出发。", "en": "Pat your leg and I'm off."},
        {"zh": "我的蹄子蹭着土。", "en": "My hoof scrapes the soil."},
        {"zh": "这里适合奔跑。", "en": "This is good running ground."},
        {"zh": "我站着，让风穿过鬃毛。", "en": "I stand and let the wind run through my mane."},
        {"zh": "我闻到风里有雨和野兽。", "en": "The wind carries rain and another beast."},
        {"zh": "我把鬃毛抖顺。", "en": "I shake my mane smooth."},
        {"zh": "有蹄声，不是我的。", "en": "Hoofbeats, and they aren't mine."},
        {"zh": "我原地挪了挪蹄子。", "en": "I turn slowly."},
        {"zh": "我还在想刚才那圈。", "en": "I'm thinking about that last lap."},
        {"zh": "风从正面吹过来。", "en": "The wind comes head-on."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你可以骑到我背上。", "en": "You may ride me."},
        {"zh": "我的背很稳当。", "en": "My back is steady."},
        {"zh": "你要跑一段吗？", "en": "Want to run a stretch?"},
        {"zh": "我跑起来很快。", "en": "I run very fast."},
        {"zh": "你抓紧了就行。", "en": "Just hold on."},
        {"zh": "我的看家特技是 Thunderbolt。", "en": "My special move is Thunderbolt."},
        {"zh": "你身上有驯服的标记。", "en": "You carry a tamer's mark."},
        {"zh": "我还能再进化。", "en": "I can still evolve."},
        {"zh": "你坐得有点歪。", "en": "You're sitting a bit crooked."},
        {"zh": "我认得这条路线。", "en": "I know this route."},
        {"zh": "我等你跨上来。", "en": "I'll wait for you to mount."},
        {"zh": "你想到哪里去？", "en": "Where do you want to go?"},
        {"zh": "你想骑我，就坐稳了再说。", "en": "If you want to ride, settle in before you speak."},
        {"zh": "我随时都能跑。", "en": "I can run at any moment."},
        {"zh": "我的腿不会累。", "en": "My legs don't tire easily."},
        {"zh": "你给我指个方向。", "en": "Just point the way."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腿突然一软。", "en": "My legs buckled."},
        {"zh": "我踉跄着退了兩步。", "en": "I fell back two steps."},
        {"zh": "我脚下乱了两步才稳住。", "en": "My feet scrambled two steps before I caught myself."},
        {"zh": "我还能把蹄子站稳。", "en": "I can still stand."},
        {"zh": "我甩头把耳鸣甩掉。", "en": "I shake my head to clear the ringing."},
        {"zh": "我的体力掉了一块。", "en": "A chunk of stamina gone."},
        {"zh": "这股味我忘不了。", "en": "I remember that scent."},
        {"zh": "腿还在，我就能跑。", "en": "My legs are still under me, so I run."},
        {"zh": "你再追过来试试。", "en": "Again."},
        {"zh": "我不打算停下。", "en": "I don't mean to stop."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我边吃边跑也行。", "en": "I can eat while running."},
        {"zh": "我咬一口，看它脆不脆。", "en": "Is this thing crisp when chewed?"},
        {"zh": "举得再高一点。", "en": "Hold it higher."},
        {"zh": "我跑完这圈再吃。", "en": "After this lap."},
        {"zh": "这一小口补不上劲。", "en": "Not enough for what I burn."},
        {"zh": "这甜味让我耳朵竖起来。", "en": "That sweetness makes my ears stand up."},
        {"zh": "把它放在路边。", "en": "Put it by the path."},
        {"zh": "我会过去拿的。", "en": "I'll come get it."},
        {"zh": "我两口就能吃完这点。", "en": "Two mouthfuls and this is gone."},
        {"zh": "再添一些行不行？", "en": "Any more?"},
        {"zh": "下次我还会绕到这来。", "en": "I'll swing back by here next time."},
        {"zh": "真是太感谢你了。", "en": "Thank you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我侧面了。", "en": "You hit my flank."},
        {"zh": "我被顶得横移了半步。", "en": "The shove slides me half a step sideways."},
        {"zh": "我差点就摔了。", "en": "I nearly stumbled."},
        {"zh": "跑起来就别撞我。", "en": "Don't bump me while I'm running."},
        {"zh": "我已经站稳了。", "en": "I'm steady again."},
        {"zh": "给我让点地方。", "en": "Give me some room."},
        {"zh": "这点磕碰伤不到蹄。", "en": "That impact is nothing."},
        {"zh": "我的前肩顶得住你。", "en": "My shoulder can take your weight."},
        {"zh": "我从你左边擦身过去。", "en": "I brush past on your left."},
        {"zh": "你踩到我的后蹄了。", "en": "You stepped on my hind hoof."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我更喜欢奔跑。", "en": "I prefer running."},
        {"zh": "这些事我不太在意。", "en": "I don't much care for such things."},
        {"zh": "等我进化成别的样子。", "en": "Wait until I evolve into something else."},
        {"zh": "我没被驯服多久。", "en": "I haven't been tamed long."},
        {"zh": "想并肩跑，先跟上我。", "en": "Want to run beside me? Keep up first."},
        {"zh": "换个时候再跑一趟。", "en": "Another time."},
        {"zh": "我们撑不到一起。", "en": "We're not the same kind."},
        {"zh": "让我先跑一圈。", "en": "Let me run a lap first."},
        {"zh": "这一趟以后再说。", "en": "Later."},
        {"zh": "你别拦着我跑。", "en": "Don't stop me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我叼着它一路跑。", "en": "I run with it in my mouth."},
        {"zh": "我叼着它跑不快。", "en": "I can't run fast with this in my mouth."},
        {"zh": "这一块咬不动。", "en": "Not food."},
        {"zh": "我把它搁在你脚边。", "en": "I set it by your feet."},
        {"zh": "它掉在路上了。", "en": "It fell on the path."},
        {"zh": "我用鼻子把它拱了拱。", "en": "I nudge it with my nose."},
        {"zh": "我能带着它跑。", "en": "I can carry it while running."},
        {"zh": "这肉早就馊透了。", "en": "Useless."},
        {"zh": "这是你刚才掉的。", "en": "You dropped this."},
        {"zh": "我先帮你叼着。", "en": "I'll hold on to it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西在奔跑。", "en": "Something's running."},
        {"zh": "我一定能追上它。", "en": "I can catch it."},
        {"zh": "我先加速冲出去。", "en": "I accelerate first."},
        {"zh": "我的蹄声先替我报信。", "en": "My hooves announce me before I arrive."},
        {"zh": "它跑得并不快。", "en": "It isn't fast."},
        {"zh": "我斜插过去，抢它前面。", "en": "I cut across and take the ground before it."},
        {"zh": "跑道已经清出来了。", "en": "I'm ready."},
        {"zh": "这个间隔短得很。", "en": "The distance is short."},
        {"zh": "我要冲过去了。", "en": "I'm charging."},
        {"zh": "别横在我的跑道上。", "en": "Don't block my path."},
        {"zh": "它已经跑过来了。", "en": "Here."},
        {"zh": "我一路追上去。", "en": "Catch it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬住它的速度不放。", "en": "I latch onto its pace and hold it."},
        {"zh": "它的速度在降。", "en": "Its speed is dropping."},
        {"zh": "我留着最后一段冲刺。", "en": "I'm saving the last stretch for a sprint."},
        {"zh": "我从外圈超到它前面。", "en": "I take the outside lane and pass it."},
        {"zh": "它开始喘气了。", "en": "It's panting."},
        {"zh": "再追近那么一点。", "en": "A little closer."},
        {"zh": "它拐弯实在太慢。", "en": "It turns too slowly."},
        {"zh": "我的耐力够用。", "en": "My stamina will last."},
        {"zh": "我再绕半圈就追上它。", "en": "Half a lap more and I have it."},
        {"zh": "趁它还没拐过弯。", "en": "Now."},
        {"zh": "我去撞它一下。", "en": "Hit it."},
        {"zh": "再近三格，我就起跳。", "en": "Three blocks closer and I spring."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我前蹄腾空踹了出去。", "en": "I rear up and drive both forehooves out."},
        {"zh": "我前蹄踏下去。", "en": "My forehooves come down."},
        {"zh": "它被撞到一边。", "en": "It was knocked aside."},
        {"zh": "我甩尾抽了过去。", "en": "My tail whips it."},
        {"zh": "我奔跑中出脚。", "en": "I kick at a run."},
        {"zh": "它躲开了这一下。", "en": "It dodged."},
        {"zh": "我兜回来，从背后撞。", "en": "I wheel back and ram it from behind."},
        {"zh": "Thunderbolt 已经打出去了。", "en": "Thunderbolt is out."},
        {"zh": "它被电了一下。", "en": "It was shocked."},
        {"zh": "我减速转过身。", "en": "I slow and turn."},
        {"zh": "它还在前面跑。", "en": "It's still running."},
        {"zh": "我一路追了上去。", "en": "I catch up."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在草地上出现了。", "en": "I appear on the grass."},
        {"zh": "我的腿先动起来。", "en": "My legs move first."},
        {"zh": "我在风口这边跑得开。", "en": "Upwind here, there's room to run."},
        {"zh": "我跑了一小圈。", "en": "I run a small circuit."},
        {"zh": "空气里有别的味道。", "en": "There's another scent in the air."},
        {"zh": "四只蹄子已经踩实。", "en": "All four hooves are set."},
        {"zh": "远处立着几棵针叶树。", "en": "Trees in the distance."},
        {"zh": "我甩尾赶开身边的虫。", "en": "I flick my tail to drive off the flies."},
        {"zh": "这里很适合奔跑。", "en": "Good running here."},
        {"zh": "我等着跑出去。", "en": "I wait to set off."},
        {"zh": "要跑上一段吗？", "en": "Shall we run?"},
        {"zh": "我已经站到跑道上了。", "en": "I'm here."},
        {"zh": "我先认一认方向。", "en": "Let me get my bearings."},
        {"zh": "我踩着草等你过来。", "en": "I stand in the grass waiting for you."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的腿，我跳开。", "en": "Fire caught my leg; I shied away."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滑下去，蹭破皮。", "en": "I slid down the slope and scraped myself."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水呛进我的肺里，很难受。", "en": "Water floods my lungs. It hurts."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀翻在路上。", "en": "The blast threw me down on the path."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西扎进后蹄上方。", "en": "Something stuck in my hind leg."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量缠住了我的腿。", "en": "That force snared my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经跑不动了。", "en": "I can't run anymore."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着我的鬃毛走。", "en": "Lightning ran along my mane."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的路忽然没了。", "en": "The road vanished."}
      ]
    }
  }
}
