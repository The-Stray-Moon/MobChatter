{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我低空掠过山脊。", "en": "I skim the ridge low."},
        {"zh": "我的翅膀是金属的。", "en": "My wings are metal."},
        {"zh": "两侧的发射器一直发热。", "en": "The launchers on my sides run hot."},
        {"zh": "我飞过针叶林的树顶。", "en": "I cross the conifer tops."},
        {"zh": "落地我从来不会受伤。", "en": "Landing never hurts me."},
        {"zh": "我在锚点四周绕。", "en": "I circle my anchor point."},
        {"zh": "黑森林里我很好藏。", "en": "I hide well in dark woods."},
        {"zh": "我掠过针叶林，树顶全低下去。", "en": "I skim the conifers and every treetop bends."},
        {"zh": "我的尾巴在后面拖出风。", "en": "My tail drags a wake of wind."},
        {"zh": "我飞过山壁的裂口。", "en": "I pass the gap in the cliff."},
        {"zh": "我朝高处去。", "en": "I head higher."},
        {"zh": "我不扇翅也能滑。", "en": "I glide without beating."},
        {"zh": "我的爪收在机身下。", "en": "My claws tuck under my frame."},
        {"zh": "我飞过一片恶地。", "en": "I cross a stretch of badlands."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在半空，很稳。", "en": "I hold in the air, steady."},
        {"zh": "我的发射器在冷却。", "en": "My launchers cool down."},
        {"zh": "我在听地面的动静。", "en": "I listen to the ground."},
        {"zh": "我的护甲是铁色的。", "en": "My armor is iron-colored."},
        {"zh": "我不需要空气。", "en": "I need no air."},
        {"zh": "我在扫描山下的路。", "en": "I scan the road below."},
        {"zh": "我的眼睛在慢慢转。", "en": "My eyes turn slowly."},
        {"zh": "金属关节在响。", "en": "Metal joints tick."},
        {"zh": "我绕过山尖。", "en": "I round the peak."},
        {"zh": "这个高度很好。", "en": "Good height."},
        {"zh": "我的投影很小。", "en": "My cast shadow is small."},
        {"zh": "我停在气流上。", "en": "I rest on the updraft."},
        {"zh": "发射器冷却，我挂在风口。", "en": "The launchers cool while I hang in the updraft."},
        {"zh": "风从下面来。", "en": "Wind comes from below."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在下面，我的机腹遮住天。", "en": "You are below; my belly plating blots out the sky."},
        {"zh": "你抬头并不方便。", "en": "Looking up is inconvenient for you."},
        {"zh": "我的发射器对准你了。", "en": "My launchers are aimed at you."},
        {"zh": "我可以落地，也可以不落。", "en": "I can land, or not."},
        {"zh": "你的武器射程不够。", "en": "Your weapon lacks the range."},
        {"zh": "我扫描了你的护甲。", "en": "I scanned your armor."},
        {"zh": "你身上的气味我认得。", "en": "I know your scent."},
        {"zh": "你不用仰着脖子。", "en": "You need not strain your neck."},
        {"zh": "我在这个高度等你。", "en": "I wait at this height."},
        {"zh": "你只带了一把武器。", "en": "You carry one weapon."},
        {"zh": "我的爪能抓住你。", "en": "My claws can take hold of you."},
        {"zh": "我飞得比你想的快。", "en": "I fly faster than you think."},
        {"zh": "你抬头，只能看见我的武器舱。", "en": "You look up and see only my weapon bay."},
        {"zh": "我不会掉下去。", "en": "I will not fall."},
        {"zh": "我这对机械翼，遮得住天。", "en": "These metal wings can blot the sky."},
        {"zh": "我说最后一遍：退开。", "en": "Once more: withdraw."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "护甲凹了，不影响飞行。", "en": "Plate dented. Flight unaffected."},
        {"zh": "平衡翼擦过山壁，冒了火星。", "en": "My stabilizer scrapes the cliff and throws sparks."},
        {"zh": "发射器过热了。", "en": "Launchers are overheating."},
        {"zh": "我重新配平。", "en": "Re-trimming."},
        {"zh": "这一下有效。", "en": "That strike was effective."},
        {"zh": "我不会掉下来。", "en": "I will not fall."},
        {"zh": "我在记录你的角度。", "en": "Recording your angle."},
        {"zh": "关节有点卡。", "en": "A joint is sticking."},
        {"zh": "飞行系统仍正常。", "en": "Flight systems remain nominal."},
        {"zh": "程序继续运行。", "en": "Proceeding."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉的味，混着铁锈飘上来。", "en": "The smell of meat drifts up mixed with rust."},
        {"zh": "我不吃，但我可以叼走。", "en": "I will not eat it, but I can take it."},
        {"zh": "分量不够充饥。", "en": "Insufficient to feed me."},
        {"zh": "往高处扔上来。", "en": "Throw it high."},
        {"zh": "我在半空接住。", "en": "I take it midair."},
        {"zh": "铁块我也吃。", "en": "I eat iron too."},
        {"zh": "我还想要些。", "en": "I want some more."},
        {"zh": "你手上，不止那一点。", "en": "There's more than that in your hands."},
        {"zh": "放到地面上。", "en": "Put it on the ground."},
        {"zh": "我要落下去。", "en": "I am coming down."},
        {"zh": "我没有耐心，快点。", "en": "I have no patience. Hurry."},
        {"zh": "这个可回收。", "en": "This is salvageable."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到的是金属。", "en": "You hit metal."},
        {"zh": "我几乎没有偏移。", "en": "I barely drift."},
        {"zh": "翅膀扇起一阵沙。", "en": "My wings throw a wall of sand."},
        {"zh": "我的上升气流掀翻了你。", "en": "My updraft knocks you off your feet."},
        {"zh": "我上升了一点。", "en": "I rise a little."},
        {"zh": "落地的重量很重。", "en": "My landing is heavy."},
        {"zh": "关节发出一声脆响。", "en": "A joint gives a sharp click."},
        {"zh": "你的护甲顶不住。", "en": "Your armor will not hold."},
        {"zh": "我的尾流把你推得踉跄。", "en": "My wake buffets you off balance."},
        {"zh": "继续走你的路。", "en": "Keep to your road."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是完全体，不回应这种问题。", "en": "I am a Perfect level; I do not answer that."},
        {"zh": "这不是我的功能。", "en": "That is not my function."},
        {"zh": "我转开视线。", "en": "I turn my gaze."},
        {"zh": "没有相关指令。", "en": "No such directive."},
        {"zh": "我继续盘旋。", "en": "I resume my circling."},
        {"zh": "我一律拒绝。", "en": "I refuse outright."},
        {"zh": "同伴对我无意义。", "en": "A partner is meaningless to me."},
        {"zh": "我拉高了高度。", "en": "I gain altitude."},
        {"zh": "别再问我了，头都在疼。", "en": "Stop asking me — all my heads ache."},
        {"zh": "我要离开了。", "en": "I am leaving."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用爪子勾起它。", "en": "I hook it with a claw."},
        {"zh": "这块铁够我熔一颗铆钉。", "en": "This iron is enough to melt one rivet."},
        {"zh": "铁可以回收。", "en": "Iron is recoverable."},
        {"zh": "我松爪丢下。", "en": "I release it."},
        {"zh": "这不是金属。", "en": "Not metal."},
        {"zh": "我带着飞了一段。", "en": "I carry it a while."},
        {"zh": "我在半空掉了它。", "en": "I lose it in the air."},
        {"zh": "留着回去熔掉。", "en": "Kept for smelting."},
        {"zh": "完全没有用处。", "en": "Entirely useless."},
        {"zh": "这物件我不要。", "en": "I do not want this object."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标已捕获。", "en": "Target captured."},
        {"zh": "你要么逃，要么死。", "en": "Flee, or die."},
        {"zh": "我选择远程。", "en": "I select ranged."},
        {"zh": "我的发射器已经预热。", "en": "My launchers are warm."},
        {"zh": "这一下叫千兆毁灭。", "en": "This is the Giga Destroyer."},
        {"zh": "你在我的射界里。", "en": "You are in my firing arc."},
        {"zh": "我不会落地。", "en": "I will not land."},
        {"zh": "沙会先落在你身上。", "en": "The sand will fall on you first."},
        {"zh": "抬头也够不着。", "en": "Looking up will not reach me."},
        {"zh": "开始锁定目标。", "en": "Beginning target lock."},
        {"zh": "正在爬升高度。", "en": "Climbing."},
        {"zh": "就是这个角度。", "en": "That is the angle."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着你升空。", "en": "I spiral up above you."},
        {"zh": "我在算你的移动。", "en": "I am computing your motion."},
        {"zh": "发射器在跟踪。", "en": "Launchers tracking."},
        {"zh": "这个角度你的甲无用。", "en": "Your armor fails at this angle."},
        {"zh": "我的炮口对准了你的方向。", "en": "My barrels point your way."},
        {"zh": "风帮我修正。", "en": "The wind corrects for me."},
        {"zh": "你退到岩石后面了。", "en": "You are behind the rock."},
        {"zh": "那没有用处。", "en": "That is of no use."},
        {"zh": "我还在升高。", "en": "I am still climbing."},
        {"zh": "再等两秒钟。", "en": "Two seconds more."},
        {"zh": "我的金属翼把你的影子切开。", "en": "My metal wings slice your shadow."},
        {"zh": "射界正在收紧。", "en": "The firing arc is tightening."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从空中俯冲抓你。", "en": "I dive and claw."},
        {"zh": "发射器口对着你。", "en": "The launchers face you."},
        {"zh": "这一下是千兆毁灭。", "en": "That was the Giga Destroyer."},
        {"zh": "你被冲击掀翻。", "en": "The blast flips you over."},
        {"zh": "金属碰到金属。", "en": "Metal meets metal."},
        {"zh": "俯冲拉起，我又绕回来。", "en": "I pull out of the dive and circle back."},
        {"zh": "你的护腕裂开了。", "en": "Your bracer has split."},
        {"zh": "炮口余热没散，我再来一轮。", "en": "The gun ports are still hot; I make another pass."},
        {"zh": "我擦着山壁过来。", "en": "I come in along the cliff."},
        {"zh": "你的方位暴露了。", "en": "Your position is known."},
        {"zh": "这一击偏了几格。", "en": "That strike was several blocks off."},
        {"zh": "再来一轮俯冲。", "en": "One more dive."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从山脊上面飞过。", "en": "I cross above the ridge."},
        {"zh": "我落在针叶林边。", "en": "I come down at the conifer edge."},
        {"zh": "落地的冲击没什么。", "en": "The landing impact means nothing."},
        {"zh": "我的发射器先亮。", "en": "My launchers light first."},
        {"zh": "黑森林里我很难被看见。", "en": "I am hard to see in the dark wood."},
        {"zh": "我绕了半圈才降下来。", "en": "I circled half a turn before descending."},
        {"zh": "这里的高度够。", "en": "Enough altitude here."},
        {"zh": "我扫视了整片山。", "en": "I sweep the whole mountain."},
        {"zh": "我的影子先到地面。", "en": "My shadow reaches the ground first."},
        {"zh": "有人在山道上。", "en": "Someone is on the mountain path."},
        {"zh": "我压低了些。", "en": "I have dropped lower."},
        {"zh": "山脊上空，我先亮起炮口。", "en": "Above the ridge, my gun ports light first."},
        {"zh": "金属声是我的呼吸。", "en": "Metal is my breathing."},
        {"zh": "我已经就位。", "en": "I am in position."}
      ]
    },
