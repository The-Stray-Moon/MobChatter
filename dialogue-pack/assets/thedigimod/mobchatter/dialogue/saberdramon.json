{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在半空扇着翅膀。", "en": "I beat my wings in midair."},
        {"zh": "我从山脊上滑下来。", "en": "I glide down from the ridge."},
        {"zh": "我的羽毛边缘发黑。", "en": "The edges of my feathers are black."},
        {"zh": "我顺着热气流上升。", "en": "I rise on a warm current."},
        {"zh": "我朝恶地那边飞。", "en": "I fly toward the badlands."},
        {"zh": "我从最高的峰顶绕过去。", "en": "I swing around the highest peak."},
        {"zh": "我的影子扫过整片石滩。", "en": "My shadow sweeps the whole stone flat."},
        {"zh": "我盘旋着往下落。", "en": "I spiral down."},
        {"zh": "我在空中转了个身。", "en": "I turn in the air."},
        {"zh": "我的翼尖擦过山脊。", "en": "My wingtips brush the ridge."},
        {"zh": "我的翅膀收了一下。", "en": "My wings tuck once."},
        {"zh": "我顺着上升气流盘。", "en": "I circle up on the rising air."},
        {"zh": "我飞得很平稳。", "en": "My flight is level."},
        {"zh": "我落在岩石上歇脚。", "en": "I land on a rock to rest."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在岩尖上。", "en": "I perch on a rock point."},
        {"zh": "我的翅膀还张着。", "en": "My wings stay half open."},
        {"zh": "我认得那条弯进荒原的路。", "en": "Past that bend the path opens onto waste."},
        {"zh": "我一点也不怕火。", "en": "I'm not afraid of fire."},
        {"zh": "我停在岩尖上一声不吭。", "en": "I'm doing nothing."},
        {"zh": "风吹着我的羽毛。", "en": "Wind stirs my feathers."},
        {"zh": "我等山路上出现人影。", "en": "I wait for a shape on the mountain path."},
        {"zh": "我感觉到岩缝的热气。", "en": "Heat rises out of the cracks."},
        {"zh": "我把翅上的灰抖落。", "en": "I shake the ash off my wings."},
        {"zh": "远处有烟升起来。", "en": "Smoke in the distance."},
        {"zh": "我的爪子抓着岩石。", "en": "My claws grip the stone."},
        {"zh": "我歪头听岩缝里的响。", "en": "I tilt my head to the sound in the cracks."},
        {"zh": "我听着下面的动静。", "en": "I listen below."},
        {"zh": "我哪里也不去。", "en": "I'm going nowhere."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头只能看见我的影。", "en": "Look up and all you see is my shadow."},
        {"zh": "我的羽毛烧不坏。", "en": "My feathers won't burn."},
        {"zh": "你要不要上来？", "en": "Would you like to ride up?"},
        {"zh": "我能带着你飞起来。", "en": "I can carry you flying."},
        {"zh": "我在恶地待惯了。", "en": "I'm used to the badlands."},
        {"zh": "你身后有火光。", "en": "There's firelight behind you."},
        {"zh": "我的趾甲能划开岩皮。", "en": "My talons can score bare rock."},
        {"zh": "我的看家特技是 Tron Flame。", "en": "My move is Tron Flame."},
        {"zh": "开阔地上你太显眼。", "en": "You shouldn't stand in the open."},
        {"zh": "我从上面看得清楚。", "en": "I see clearly from above."},
        {"zh": "你站定别挪脚步。", "en": "Don't move about."},
        {"zh": "我想试试你的骨头。", "en": "I'd like to test your bones."},
        {"zh": "你身上有矿物的味。", "en": "You smell of minerals."},
        {"zh": "我认得这片山地。", "en": "I know these mountains."},
        {"zh": "抬头，我正悬在你头顶。", "en": "Look up. I'm hanging right over your head."},
        {"zh": "我收翅落在你面前。", "en": "I'm coming down."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀被划破了。", "en": "My wing is torn."},
        {"zh": "我从半空坠了一截。", "en": "I dropped a stretch."},
        {"zh": "这一下砸在我翼根。", "en": "That hit my back."},
        {"zh": "我稳住了身形。", "en": "I held steady."},
        {"zh": "火伤不到我，这是别的。", "en": "Fire doesn't hurt me; this is different."},
        {"zh": "我离地更低了。", "en": "I'm lower to the ground."},
        {"zh": "这一股焦味我记着。", "en": "I remember that scent."},
        {"zh": "翅膀没断，我就还能飞。", "en": "My wings aren't broken, so I can still fly."},
        {"zh": "你再扑上来试试。", "en": "Again."},
        {"zh": "我不会逃跑的。", "en": "I won't flee."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我是专门吃肉的。", "en": "I eat meat."},
        {"zh": "这点连我牙缝都塞不满。", "en": "That wouldn't fill a gap in my teeth."},
        {"zh": "把它举得再高一点。", "en": "Hold it higher."},
        {"zh": "我俯冲就能拿。", "en": "I can take it in a dive."},
        {"zh": "你的手在微微发抖。", "en": "Steady your hand."},
        {"zh": "我更愿意自己扑食。", "en": "I prefer to hunt my own."},
        {"zh": "这一份远远不够。", "en": "This isn't enough."},
        {"zh": "搁下它，退到三格外。", "en": "Put it down and back off."},
        {"zh": "这股血腥味我闻到了。", "en": "I smell blood."},
        {"zh": "等一会儿再说。", "en": "Later."},
        {"zh": "我要先落下来。", "en": "I need to land first."},
        {"zh": "这块留给你自己。", "en": "Keep it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的手碰到我的飞羽。", "en": "Your hand caught my flight feathers."},
        {"zh": "我扇了两下，稳住了。", "en": "Two beats of my wings and I steady."},
        {"zh": "你被翅膀扫开了一点。", "en": "My wing swept you aside."},
        {"zh": "别蹦起来抓我的翼。", "en": "Don't jump at me."},
        {"zh": "我可算不上是一只鸟。", "en": "I'm no bird."},
        {"zh": "这点撞劲伤不到翼骨。", "en": "That impact is nothing."},
        {"zh": "风把我往上托了托。", "en": "The wind lifts me a little."},
        {"zh": "你站得太靠墙。", "en": "You're too close to the wall."},
        {"zh": "我往旁边挪一点。", "en": "I move aside a little."},
        {"zh": "再撞我就抓你。", "en": "Bump me again and I'll claw you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在空中待惯了。", "en": "I'm used to the air."},
        {"zh": "这些事要在巢里说。", "en": "Such things belong in a nest."},
        {"zh": "你根本飞不起来。", "en": "You can't fly."},
        {"zh": "我还在找地方。", "en": "I'm still looking for a place."},
        {"zh": "等过了这场雨。", "en": "After this rain passes."},
        {"zh": "离我的巢远一点。", "en": "Keep away from my nest."},
        {"zh": "我现在只想守山头。", "en": "For now I only want to hold my peak."},
        {"zh": "换个季节再谈。", "en": "Another time."},
        {"zh": "我忙着巡这片山。", "en": "I'm patrolling these mountains."},
        {"zh": "你还是赶快走吧。", "en": "Go on."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我俯冲下来一口叼住。", "en": "I dive and snatch it in my beak."},
        {"zh": "这个摸起来有点烫。", "en": "This is a bit hot."},
        {"zh": "这血已经凉了。", "en": "Not meat."},
        {"zh": "太重了带不动。", "en": "Too heavy to carry."},
        {"zh": "我把它丢了下去。", "en": "I dropped it."},
        {"zh": "它掉在岩石上面。", "en": "It fell on the rock."},
        {"zh": "这骨头是什么来头？", "en": "What is this?"},
        {"zh": "这东西没多少用处。", "en": "Useless."},
        {"zh": "你掉了东西了。", "en": "You dropped something."},
        {"zh": "我先把它扣在爪里。", "en": "I'll keep it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "下面有动静传来。", "en": "Movement below."},
        {"zh": "我收翅，准备往下砸。", "en": "I fold my wings to drop."},
        {"zh": "这个角度能俯冲。", "en": "I can dive from this angle."},
        {"zh": "它没有一点遮挡。", "en": "It has no cover."},
        {"zh": "我先在崖上叫一声。", "en": "First, a cry."},
        {"zh": "我的爪子准备好了。", "en": "My claws are ready."},
        {"zh": "我从上面下去。", "en": "I come from above."},
        {"zh": "它还没抬起头。", "en": "It hasn't looked up."},
        {"zh": "就是这个高度。", "en": "This altitude is right."},
        {"zh": "我已经下去了。", "en": "I'm going down."},
        {"zh": "趁热气还没散开。", "en": "Now."},
        {"zh": "我从上风口压过去。", "en": "I come in from upwind."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在它头上盘旋。", "en": "I circle above it."},
        {"zh": "我的影子里有它。", "en": "My shadow holds it."},
        {"zh": "它往哪跑我都看得见。", "en": "I can see wherever it runs."},
        {"zh": "我在等它进空处。", "en": "I wait for open ground."},
        {"zh": "风正推着我的翅。", "en": "The wind blows my way."},
        {"zh": "我盯着地上慢慢走的它。", "en": "It's still walking slowly down there."},
        {"zh": "我又降了半个身位。", "en": "I drop another half a length."},
        {"zh": "它跑得再快也甩不掉我。", "en": "Run as it might, it gains nothing."},
        {"zh": "我再低两格就能俯冲。", "en": "Two blocks lower and I can dive."},
        {"zh": "我把翅翼收起来。", "en": "I fold my wings."},
        {"zh": "这个角度最适合扑。", "en": "The chance is here."},
        {"zh": "我朝下面俯冲。", "en": "Dive."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从背后抓了一爪。", "en": "I rake it from behind."},
        {"zh": "爪子抓在它的背上。", "en": "My claws dig into its back."},
        {"zh": "Tron Flame 一路扫了出去。", "en": "Tron Flame sweeps out."},
        {"zh": "它被撞得跪倒。", "en": "It was knocked to its knees."},
        {"zh": "我的翅膀拍到它的头。", "en": "My wing buffets its head."},
        {"zh": "我又升了上来。", "en": "I rise again."},
        {"zh": "它身上有焦味。", "en": "There's a scorched smell on it."},
        {"zh": "它还在原地挣动。", "en": "It's still moving."},
        {"zh": "我再扑它一次。", "en": "Another dive."},
        {"zh": "它硬挡了这一下。", "en": "It blocked."},
        {"zh": "我换到它背后。", "en": "I move behind it."},
        {"zh": "我这一爪逼得它脚下一滑。", "en": "Its footing slips by half an inch."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下。", "en": "I come down from height."},
        {"zh": "翅膀撑开，风就稳了。", "en": "Wings spread, the air steadies."},
        {"zh": "这片山地很陡。", "en": "These mountains are steep."},
        {"zh": "下面就是恶地。", "en": "The badlands lie below."},
        {"zh": "我在找落脚点。", "en": "I'm looking for a perch."},
        {"zh": "空气里飘着烟。", "en": "Smoke in the air."},
        {"zh": "我慢慢地盘旋着。", "en": "I circle slowly."},
        {"zh": "我听见下面的声音。", "en": "I hear sounds below."},
        {"zh": "我的羽毛还带着热。", "en": "My feathers still carry heat."},
        {"zh": "我先停一会儿。", "en": "Let me perch a while."},
        {"zh": "翼骨已经展开了。", "en": "I'm ready."},
        {"zh": "下面有个人影。", "en": "Someone's down there."},
        {"zh": "我从那边过去。", "en": "I'll go that way."},
        {"zh": "我开始降下来了。", "en": "I begin descending."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰烧不到我，但也够烫。", "en": "Fire can't hurt me, but it's hot enough."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高空摔到岩石上。", "en": "I fell from high onto the rock."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把羽毛压得贴在身上。", "en": "Water plasters my feathers down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我推出好远。", "en": "The blast threw me far."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿破我的翼膜。", "en": "Something pierced my wing membrane."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我的羽毛竖起。", "en": "That force raised my feathers."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得我飞得歪。", "en": "Too hungry to fly straight."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷和我的羽毛撞在一起。", "en": "Lightning clashed with my feathers."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面的地不见了。", "en": "The ground below is gone."}
      ]
    }
  }
}
