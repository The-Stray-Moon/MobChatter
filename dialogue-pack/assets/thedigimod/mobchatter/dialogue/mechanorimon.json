{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的脚步有金属的回声。", "en": "My steps ring metallic."},
        {"zh": "两格多的身体走起来很笨。", "en": "Two blocks wide, and clumsy."},
        {"zh": "齿轮在我膝盖里转。", "en": "Gears turn in my knees."},
        {"zh": "我沿沙丘走，脚下陷一点。", "en": "I walk the dunes; they give a little."},
        {"zh": "我绕着我常待的地方转。", "en": "I circle my usual spot."},
        {"zh": "我的手臂比腿还重。", "en": "My arms are heavier than my legs."},
        {"zh": "我一步一顿，像在算。", "en": "I step and pause, as if calculating."},
        {"zh": "地上的石头被我踢开。", "en": "Stones scatter from my feet."},
        {"zh": "我的炮口一直朝前。", "en": "My muzzle stays forward."},
        {"zh": "砂砾卡在关节里，响得很。", "en": "Grit in my joints grinds loudly."},
        {"zh": "我在恶地的红岩上走。", "en": "I cross the badland's red rock."},
        {"zh": "我按程序转向。", "en": "I turn by program."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，内部一直在响。", "en": "I stand; something turns inside me."},
        {"zh": "我正在待命。", "en": "I am standing by."},
        {"zh": "我的护板上有旧划痕。", "en": "Old scores mark my plating."},
        {"zh": "太阳把我的外壳晒热。", "en": "The sun heats my shell."},
        {"zh": "我闻不到味道，可我能测。", "en": "I cannot smell, but I measure."},
        {"zh": "废料的金属味在附近。", "en": "The tang of scrap is nearby."},
        {"zh": "我的炮管在散热。", "en": "My barrel vents heat."},
        {"zh": "我在守着这个点。", "en": "I am guarding this point."},
        {"zh": "我的拳头是实心的。", "en": "My fists are solid."},
        {"zh": "风沙灌进缝隙。", "en": "Sand works into my seams."},
        {"zh": "我没有心跳，只有计数。", "en": "No heartbeat. Only a counter."},
        {"zh": "我慢慢合上护板。", "en": "My plates close slowly."},
        {"zh": "编号我记不清了。", "en": "I do not recall my serial."},
        {"zh": "我在沙里站得很稳。", "en": "I stand firm in the sand."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我在扫描你。", "en": "I am scanning you."},
        {"zh": "你的热量读数偏高。", "en": "Your heat reading is high."},
        {"zh": "你不是我的驾驶员。", "en": "You are not my pilot."},
        {"zh": "我可以用炮，也可以用手。", "en": "I can use the cannon, or the fists."},
        {"zh": "你没有对我下令的权限。", "en": "You lack clearance to command me."},
        {"zh": "我认得废料，不认得你。", "en": "I know scrap. Not you."},
        {"zh": "我的护甲这两格宽。", "en": "Two blocks of armor, here."},
        {"zh": "你站在我的攻击范围内。", "en": "You are inside my engagement range."},
        {"zh": "我等你先行动。", "en": "I await your action."},
        {"zh": "你的武器不足以穿透。", "en": "Your weapon will not penetrate."},
        {"zh": "我听到你的呼吸。", "en": "I hear your breathing."},
        {"zh": "沙丘上只有我们。", "en": "Only us on the dune."},
        {"zh": "你身上有油味。", "en": "You carry machine oil."},
        {"zh": "齿轮转着，我在算距离。", "en": "Gears turn while I compute the range."},
        {"zh": "你的脉搏过快。", "en": "Your pulse is too fast."},
        {"zh": "我建议你后退。", "en": "I advise you to withdraw."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "护板凹陷，不影响。", "en": "Plate dented. Function unaffected."},
        {"zh": "我的读数在下降。", "en": "My readings are falling."},
        {"zh": "齿轮卡了三下。", "en": "The gear caught three times."},
        {"zh": "齿轮卡了三次，我重新校准。", "en": "My gears jam three times; I recalibrate."},
        {"zh": "损伤可以修补。", "en": "Damage is repairable."},
        {"zh": "我不会后退太多。", "en": "I will not retreat far."},
        {"zh": "我的躯干完整。", "en": "My chassis is intact."},
        {"zh": "这一击有效。", "en": "That strike was effective."},
        {"zh": "我在记录你的攻击。", "en": "Logging your attack pattern."},
        {"zh": "承受，继续。", "en": "Taking it. Continuing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这块废料能熔成一块护板。", "en": "This scrap can be melted into one armor plate."},
        {"zh": "金属可以被消化。", "en": "Metal can be digested."},
        {"zh": "我伸出一只手来。", "en": "I extend an arm."},
        {"zh": "这个不构成指令。", "en": "This does not constitute an order."},
        {"zh": "我接过来检查一遍。", "en": "I take it and inspect it."},
        {"zh": "这是有用的材料。", "en": "Useful material."},
        {"zh": "你还带了什么？", "en": "What else did you bring?"},
        {"zh": "我不吃，我只是回收。", "en": "I do not eat. I recycle."},
        {"zh": "搁到地面上。", "en": "Place it on the ground."},
        {"zh": "我记入库存。", "en": "Added to inventory."},
        {"zh": "分量还不够。", "en": "Insufficient quantity."},
        {"zh": "我已收下了。", "en": "Accepted."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的外壳不退让。", "en": "My shell does not yield."},
        {"zh": "你撞上的是两格宽的铁。", "en": "You hit two blocks of iron."},
        {"zh": "我几乎没有位移。", "en": "There is barely any displacement."},
        {"zh": "我全身上下都是齿轮。", "en": "Gears are all I'm made of."},
        {"zh": "我重新配平了。", "en": "Balance restored."},
        {"zh": "你被反作用顶开。", "en": "Recoil pushes you away."},
        {"zh": "关节在作响。", "en": "The joints are creaking."},
        {"zh": "沙被我们压平了。", "en": "We have flattened the sand."},
        {"zh": "你的护甲有凹。", "en": "Your plate is dented."},
        {"zh": "你撞在我两格宽的外壳上。", "en": "You hit my two-block-wide shell."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是机械体。", "en": "I am a machine."},
        {"zh": "这项功能未配置。", "en": "That function is not installed."},
        {"zh": "我把传感器转开。", "en": "I turn my sensors away."},
        {"zh": "没有相关协议。", "en": "There is no protocol for that."},
        {"zh": "这种尝试没有意义。", "en": "That attempt is pointless."},
        {"zh": "我保持警戒。", "en": "I remain on watch."},
        {"zh": "我的编号还在。", "en": "My serial is still mine."},
        {"zh": "否定的回答。", "en": "Negative."},
        {"zh": "传感器转开，我没有那项功能。", "en": "My sensors turn away; I lack that function."},
        {"zh": "解除接触状态。", "en": "Disengage."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这块金属可用。", "en": "This metal is usable."},
        {"zh": "我收进背部的槽。", "en": "I slot it into my back."},
        {"zh": "我捡了三十克砂。", "en": "I have gathered thirty grams of grit."},
        {"zh": "这不是废料。", "en": "This is not scrap."},
        {"zh": "这块废铁我扔回沙里。", "en": "I toss this scrap iron back into the sand."},
        {"zh": "我可以熔了它。", "en": "I could melt it down."},
        {"zh": "库存已经增加。", "en": "Inventory increased."},
        {"zh": "无实用价值。", "en": "No practical value."},
        {"zh": "我扫描后丢弃。", "en": "Scanned and discarded."},
        {"zh": "我收着备用。", "en": "Retained for spare use."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标已在射界。", "en": "Target within arc."},
        {"zh": "炮口转过去，锁住你的胸口。", "en": "My gun port turns and locks on your chest."},
        {"zh": "你的护甲在计算之内。", "en": "Your armor is accounted for."},
        {"zh": "我选择近战。", "en": "I select melee."},
        {"zh": "功率已经提上来了。", "en": "Power levels are rising."},
        {"zh": "目标已确认。", "en": "Target confirmed."},
        {"zh": "这一下叫巨能爆破。", "en": "This is the Mega Blaster."},
        {"zh": "你再往前一步，就进射界了。", "en": "One more step and you enter my firing arc."},
        {"zh": "我两只圆手，都是铁。", "en": "Both my round hands are iron."},
        {"zh": "沙会在你脚下塌。", "en": "The sand will give under you."},
        {"zh": "各位都已就位。", "en": "All units stand by."},
        {"zh": "开始启动了。", "en": "Initiating."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我计算落点。", "en": "Computing impact point."},
        {"zh": "你的重心偏在左脚。", "en": "Your weight sits on the left foot."},
        {"zh": "炮管内的压力在升。", "en": "Pressure builds in the barrel."},
        {"zh": "你退一格，我的炮口就跟一格。", "en": "You retreat one block; my gun port follows one block."},
        {"zh": "我的视野覆盖沙丘。", "en": "My field of view covers the dune."},
        {"zh": "我不会疲劳。", "en": "I do not fatigue."},
        {"zh": "你那把武器太轻，打不穿护板。", "en": "Your weapon is too light to pierce my plates."},
        {"zh": "我在等功率峰值。", "en": "I wait for peak output."},
        {"zh": "你再走一格。", "en": "One more block."},
        {"zh": "锁定保持中。", "en": "Target lock maintained."},
        {"zh": "我的脚步震动沙子。", "en": "My steps shake the sand."},
        {"zh": "正在接近中。", "en": "Closing."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一拳砸下。", "en": "I drive a fist down."},
        {"zh": "炮口贴着你开火。", "en": "The barrel fires at close range."},
        {"zh": "这一下是实心的。", "en": "That was solid."},
        {"zh": "你被掀到沙里。", "en": "You are thrown into the sand."},
        {"zh": "我的关节承受很大。", "en": "My joints take a strain."},
        {"zh": "护板挡住了你的剑。", "en": "My plate stops your blade."},
        {"zh": "这一拳力道够了。", "en": "That blow was sufficient."},
        {"zh": "我重新瞄准。", "en": "I re-aim."},
        {"zh": "你的护腕出现裂痕。", "en": "Your bracer is fracturing."},
        {"zh": "我还在追击。", "en": "I am still pursuing."},
        {"zh": "机械臂太沉，打偏了。", "en": "The mech arm swung heavy and missed."},
        {"zh": "追加一次打击。", "en": "Follow-up strike."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我落在沙丘上，沙飞起来。", "en": "I land on the dune; sand sprays."},
        {"zh": "我在山脚待机很久了。", "en": "I have idled at the mountain's foot."},
        {"zh": "系统启动完成。", "en": "System startup complete."},
        {"zh": "恶地的风灌进我的关节。", "en": "The badlands wind pours into my joints."},
        {"zh": "沙丘、山脚、废料堆，我都扫过。", "en": "Dune, mountain foot, scrap heap — I have swept them all."},
        {"zh": "这里的废料不够。", "en": "Not enough scrap here."},
        {"zh": "我是成熟期，别弄错。", "en": "Mature stage. Make no mistake."},
        {"zh": "我的护板自动合上。", "en": "My plates close automatically."},
        {"zh": "有一个活物。", "en": "One living target."},
        {"zh": "恶地的红岩上，我缓缓转身。", "en": "On the red rock of the badlands, I turn slowly."},
        {"zh": "我启动完毕。", "en": "Boot sequence complete."},
        {"zh": "沙丘上，我的系统逐个启动。", "en": "On the dune, my systems start one by one."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "高温让我的润滑变稀。", "en": "Heat thins my lubricant."}
      ]
    },
