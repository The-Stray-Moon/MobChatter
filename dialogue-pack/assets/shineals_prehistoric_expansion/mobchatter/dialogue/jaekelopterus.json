  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在泥里爬", "en": "I crawl through the mud."},
        {"zh": "我八条腿一起动", "en": "Eight legs move together."},
        {"zh": "我的螯在前面探路", "en": "My claws feel the way ahead."},
        {"zh": "尾巴轻轻摆", "en": "My tail sways."},
        {"zh": "我在红树根间穿行", "en": "I pick my way among mangrove roots."},
        {"zh": "泥浆从壳上滑下去", "en": "Mud slides off my shell."},
        {"zh": "我压低身体潜行", "en": "I prowl low."},
        {"zh": "我在浅水里走得慢", "en": "I move slowly in the shallows."},
        {"zh": "我用尾巴平衡", "en": "My tail keeps my balance."},
        {"zh": "我从断枝下面钻过", "en": "I slip under a fallen branch."},
        {"zh": "我的影子在水面下移", "en": "My shadow moves underwater."},
        {"zh": "我向岸边的声响走过去", "en": "I move toward the sound on shore."},
        {"zh": "我拨开芦苇", "en": "I push through the reeds."},
        {"zh": "我的螯一开一合，泥都翻开。", "en": "My pincers open and shut, turning the mud."},
        {"zh": "水纹跟着我扩散", "en": "Ripples spread out behind me."}
      ]
    },
    "idle": {
