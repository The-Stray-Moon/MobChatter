{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我摆尾在海草间", "en": "I swim through the kelp."},
        {"zh": "马蹄打了个空", "en": "My hooves strike empty water."},
        {"zh": "鱼身推动我向前", "en": "My fish half drives me on."},
        {"zh": "我绕着珊瑚游", "en": "I circle the coral."},
        {"zh": "暖水让我游得更快", "en": "Warm water speeds my swimming."},
        {"zh": "我贴海床前进", "en": "I move along the seafloor."},
        {"zh": "鳞片在光下发绿", "en": "My scales shine green in the light."},
        {"zh": "我穿过一片海草", "en": "I pass through a bed of seagrass."},
        {"zh": "我抬头靠近水面", "en": "I rise toward the surface."},
        {"zh": "马鬃在水里飘", "en": "My mane drifts in the water."},
        {"zh": "我在礁石间转身", "en": "I turn between the rocks."},
        {"zh": "我摆了两下尾鳍", "en": "Two beats of my tail fin."},
        {"zh": "水面在我上方晃动", "en": "The surface shimmers above me."},
        {"zh": "我游过一群小鱼", "en": "I swim past a school of fish."},
        {"zh": "我压低身体滑行", "en": "I glide low."},
        {"zh": "我绕回原来的礁", "en": "I come back to my rock."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在浅水里停着", "en": "I rest in the shallows."},
        {"zh": "暖流经过我身边", "en": "A warm current passes."},
        {"zh": "我抬头看水面的光", "en": "I watch the light on the surface."},
        {"zh": "海草缠住我的尾", "en": "Seagrass tangles my tail."},
        {"zh": "我在听海里的声音", "en": "I listen to the sea."},
        {"zh": "这片海很安静", "en": "This sea is quiet."},
        {"zh": "我甩了甩鬃毛", "en": "I toss my mane."},
        {"zh": "我只有水里才自在", "en": "Only in water am I at ease."},
        {"zh": "海龟从我旁边游过", "en": "A turtle swims past."},
        {"zh": "我在等潮水", "en": "I am waiting for the tide."},
        {"zh": "盐味贴在我身上", "en": "Salt clings to me."},
        {"zh": "我再浮上去换口气", "en": "I rise again for air."},
        {"zh": "我抱着两块马蹄铁", "en": "I hold my hooves still."},
        {"zh": "水里没有脚步声", "en": "There are no footsteps in the sea."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你游得比我笨", "en": "You swim clumsier than I do."},
        {"zh": "你在水里很显眼", "en": "You stand out in the water."},
        {"zh": "你要骑我吗", "en": "Do you want to ride me?"},
        {"zh": "我的背够宽", "en": "My back is broad enough."},
        {"zh": "你的呼吸在冒泡", "en": "Your breath is bubbling."},
        {"zh": "别拉我的鬃毛", "en": "Do not pull my mane."},
        {"zh": "这里是暖水", "en": "This is warm water."},
        {"zh": "你在我影子底下", "en": "You are under my shadow."},
        {"zh": "我往深处游一点", "en": "I will swim a little deeper."},
        {"zh": "你听得见我嘶鸣吗", "en": "Can you hear my neigh?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的鳞掉了一片", "en": "A scale came off."},
        {"zh": "马蹄碰得发麻", "en": "My hooves are numb."},
        {"zh": "鳞片边缘被磨掉了", "en": "The edge of a scale wore off."},
        {"zh": "血在海里散开", "en": "Blood spreads in the sea."},
        {"zh": "鱼群散了", "en": "The fish scatter."},
        {"zh": "我还游得动", "en": "I can still swim."},
        {"zh": "我的卷尾抽到了礁石。", "en": "My curled tail lashed against the reef."},
        {"zh": "温水养大的身子，也一样怕疼。", "en": "Warm water raised me, but I still feel pain."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那股味道在水里散开", "en": "That smell spreads through the water."},
        {"zh": "你手里的是草吗", "en": "Is that grass in your hand?"},
        {"zh": "别收回岸上", "en": "Do not pull it back to shore."},
        {"zh": "暖水里，我卷着尾巴游。", "en": "In warm water, I swim with a curled tail."},
        {"zh": "我绕着你手里的东西游", "en": "I circle what you hold."},
        {"zh": "水里的声音很好听", "en": "I like the sound it makes."},
        {"zh": "我伸头过去", "en": "I stretch my head out."},
        {"zh": "再靠近一点", "en": "A little closer."},
        {"zh": "我要咬一口", "en": "I will take a bite."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的鳍", "en": "You bumped my fin."},
        {"zh": "水里阻力大，我退得慢", "en": "Water slows my retreat."},
        {"zh": "马蹄踢起一层沙", "en": "My hooves kick up sand."},
        {"zh": "我们绕在一起了", "en": "We are tangled together."},
        {"zh": "我甩了一下身体", "en": "I thrashed my body."},
        {"zh": "沙子沉了下来", "en": "The sand settles."},
        {"zh": "别从下面顶我", "en": "Do not push from below."},
        {"zh": "我漂开一点", "en": "I drift aside."},
        {"zh": "这水太浅了", "en": "This water is too shallow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "浅湾是我们要去的地方", "en": "The shallow bay is where we go."},
        {"zh": "我们并排游", "en": "We swim side by side."},
        {"zh": "鬃毛缠在一起", "en": "Our manes tangle."},
        {"zh": "水声盖过了别的", "en": "The water covers every other sound."},
        {"zh": "别在礁后面看", "en": "Do not watch from behind the rocks."},
        {"zh": "潮水正在转", "en": "The tide is turning."},
        {"zh": "这里很暖", "en": "It is warm here."},
        {"zh": "过一会我就走", "en": "I will leave soon."},
        {"zh": "海草是我们的床", "en": "The seagrass is our bed."},
        {"zh": "别惊动我们", "en": "Do not disturb us."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "水里掉的东西沉下来", "en": "Things dropped in water sink."},
        {"zh": "我用嘴叼住", "en": "I take it in my mouth."},
        {"zh": "这点亮片不错", "en": "This shiny bit is nice."},
        {"zh": "我收到海草下面", "en": "I tuck it under the seagrass."},
        {"zh": "马蹄夹不住东西", "en": "Hooves cannot grip."},
        {"zh": "我叼着游开", "en": "I swim off with it."},
        {"zh": "沉到海底就归我", "en": "What sinks to the bottom is mine."},
        {"zh": "它反着光", "en": "It reflects the light."},
        {"zh": "我藏进珊瑚缝", "en": "I hide it in a coral crack."},
        {"zh": "别跟我要", "en": "Do not ask for it back."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你占了这片浅湾", "en": "You are in my shallows."},
        {"zh": "我听见你划水", "en": "I hear you paddling."},
        {"zh": "水里我转得比你快", "en": "I turn faster than you in water."},
        {"zh": "别往深处退", "en": "Do not retreat deeper."},
        {"zh": "这里是我的海域", "en": "These are my waters."},
        {"zh": "我抬起身子", "en": "I rear up."},
        {"zh": "水面在晃", "en": "The surface is rippling."},
        {"zh": "你游不出这片珊瑚", "en": "You will not leave this reef."},
        {"zh": "你不是第一个", "en": "You are not the first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "温水里，我绕着你打转。", "en": "In the warm water, I circle you."},
        {"zh": "你在水下看不清我", "en": "You cannot see me well underwater."},
        {"zh": "珊瑚替你挡不住的", "en": "The coral will not shield you."},
        {"zh": "我贴近海床过来", "en": "I come in low along the seabed."},
        {"zh": "你的气泡在往上飘", "en": "Your bubbles float upward."},
        {"zh": "你换气的时候最慢", "en": "You are slowest when you take a breath."},
        {"zh": "我再绕一圈", "en": "One more circle."},
        {"zh": "海草在我身后合上", "en": "The seagrass closes behind me."},
        {"zh": "你退到礁墙上了", "en": "You are against the reef wall."},
        {"zh": "我只要一次机会", "en": "I need one opening."},
        {"zh": "马蹄已经抬起来", "en": "My hooves are raised."},
        {"zh": "别指望游上岸", "en": "Do not count on reaching shore."}
      ]
    },
