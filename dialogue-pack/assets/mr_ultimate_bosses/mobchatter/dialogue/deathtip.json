{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "八条腿在洞穴顶上爬。", "en": "Eight legs crawl along the cave ceiling."},
        {"zh": "我背上的骑手抓着我的甲。", "en": "The rider on my back grips my shell."},
        {"zh": "我背上的骷髅，箭已经上弦。", "en": "The skeleton on my back has an arrow nocked."},
        {"zh": "脚钩住石头的缝。", "en": "My feet hook the stone's cracks."},
        {"zh": "灰尘从我上面落下去。", "en": "Dust sifts down from me."},
        {"zh": "八条蜘蛛腿，驮着骷髅走。", "en": "Eight spider legs carry the skeleton steadily."},
        {"zh": "骑手一动，我就停。", "en": "When the rider shifts, I stop."},
        {"zh": "他敲一下，我才继续。", "en": "He taps once, and I continue."},
        {"zh": "我们这样走了很久。", "en": "We have gone on like this a long while."},
        {"zh": "我沿着洞壁绕过一处塌方。", "en": "I skirt a cave-in along the wall."},
        {"zh": "下面的地上有影子。", "en": "There are shadows on the floor below."},
        {"zh": "我朝那些影子过去。", "en": "I head for those shadows."},
        {"zh": "骑手拉开了弓。", "en": "The rider draws his bow."},
        {"zh": "我把步子放快。", "en": "I quicken my stride."},
        {"zh": "朝着那个影子。", "en": "Toward that shadow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在洞顶，一动不动。", "en": "I hang from the ceiling, still."},
        {"zh": "背上的重量很轻。", "en": "The weight on my back is light."},
        {"zh": "我们配合了很久。", "en": "We have worked together a long time."},
        {"zh": "他的呼吸我听得见。", "en": "I hear his breathing."},
        {"zh": "他在等一个目标。", "en": "He is waiting for a target."},
        {"zh": "我也在这儿等。", "en": "I am waiting too."},
        {"zh": "我的毒牙收在口器下面。", "en": "My fangs rest beneath my mouthparts."},
        {"zh": "有一滴毒挂在尖端。", "en": "A drop of venom hangs at the tip."},
        {"zh": "落在石头上，石头变黑。", "en": "It lands on stone and the stone blackens."},
        {"zh": "我慢慢移动了一下。", "en": "I shift slowly."},
        {"zh": "我又停了下来。", "en": "I stop again."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬头，我们正好对上。", "en": "You look up and we meet."},
        {"zh": "骑手的弓已经抬起来了。", "en": "The rider's bow is already up."},
        {"zh": "我挂在上面没动。", "en": "I hang above without moving."},
        {"zh": "我在等他的箭。", "en": "I am waiting for his arrow."},
        {"zh": "箭飞出去了。", "en": "The arrow flies."},
        {"zh": "我同时扑下去。", "en": "I drop at the same moment."},
        {"zh": "你躲开了箭。", "en": "You dodge the arrow."},
        {"zh": "但躲不开我。", "en": "But not me."},
        {"zh": "我的毒牙张开了。", "en": "My fangs open."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "骑手抓紧了。", "en": "The rider holds tight."},
        {"zh": "我侧过半圈身子。", "en": "I turn half about."},
        {"zh": "毒从伤口流出来。", "en": "Venom leaks from the wound."},
        {"zh": "黑色的液体滴在石上。", "en": "Black fluid drips on stone."},
        {"zh": "他敲了两下。", "en": "He taps twice."},
        {"zh": "那是撤退的意思。", "en": "That means withdraw."},
        {"zh": "我朝暗处退。", "en": "I retreat into the dark."},
        {"zh": "他还在我背上。", "en": "He is still on my back."},
        {"zh": "我们还会回来。", "en": "We will be back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "骑手没有下令。", "en": "The rider has not given the order."},
        {"zh": "我一点不动。", "en": "I do not stir."},
        {"zh": "它在那儿放了很久。", "en": "It lies there a long while."},
        {"zh": "我没有下去。", "en": "I do not go down."},
        {"zh": "我们只对活的东西有兴趣。", "en": "We are only interested in living things."},
        {"zh": "尤其是会动的。", "en": "Especially moving ones."},
        {"zh": "你还在动着。", "en": "You are still moving."},
        {"zh": "那也就够了。", "en": "That is enough."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在洞壁上，我在上面。", "en": "You hit the cave wall; I am above."},
        {"zh": "我的腿碰到你的肩。", "en": "My leg brushes your shoulder."},
        {"zh": "只轻轻一下。", "en": "Only the lightest touch."},
        {"zh": "你抬起了头。", "en": "You look up."},
        {"zh": "我已经移开了。", "en": "I have already moved away."},
        {"zh": "你伸手来抓。", "en": "You reach to grab."},
        {"zh": "只抓到一把灰。", "en": "You catch only dust."},
        {"zh": "骷髅骑在蜘蛛背上，就在你身后。", "en": "The skeleton rides the spider right behind you."},
        {"zh": "骑手的箭已经搭好。", "en": "The rider's arrow is nocked."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们是两个。", "en": "We are two."},
        {"zh": "一个在背上，一个在下面。", "en": "One on the back, one beneath."},
        {"zh": "别的都不需要。", "en": "Nothing else is needed."},
        {"zh": "他给我方向。", "en": "He gives me direction."},
        {"zh": "我把腿借给他。", "en": "I lend him my legs."},
        {"zh": "我们配合得很好。", "en": "We work well together."},
        {"zh": "峡谷的回声就是我们的声音。", "en": "The canyon's echo is our voice."},
        {"zh": "别的生物都躲着我们。", "en": "Other creatures avoid us."},
        {"zh": "这样也不错。", "en": "That is fine too."},
        {"zh": "我们继续走。", "en": "We walk on."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用前腿夹起来。", "en": "I take it with my forelegs."},
        {"zh": "骑手低头看了看。", "en": "The rider looks down."},
        {"zh": "他摇了摇头。", "en": "He shakes his head."},
        {"zh": "它落在地上。", "en": "It lands on the ground."},
        {"zh": "不是我们要的。", "en": "Not what we want."},
        {"zh": "我们继续往上爬。", "en": "We climb on."},
        {"zh": "洞顶更暗了。", "en": "The ceiling darkens."},
        {"zh": "我们的眼睛却看得清。", "en": "But our eyes see clearly."},
        {"zh": "前面有东西。", "en": "Something ahead."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "骑手的手按在我背上。", "en": "The rider's hand presses my back."},
        {"zh": "我明白意思了。", "en": "I understand."},
        {"zh": "蜘蛛转向，骷髅的箭也转过去。", "en": "The spider turns, and the arrow turns with it."},
        {"zh": "八条腿同时移动。", "en": "Eight legs move at once."},
        {"zh": "他把弓拉开。", "en": "He draws the bow."},
        {"zh": "箭尖对着下面。", "en": "The arrow points down."},
        {"zh": "我量着那段距离。", "en": "I measure that distance."},
        {"zh": "一百二十格，我们能追踪。", "en": "A hundred and twenty blocks; we can track it."},
        {"zh": "骷髅拉开弓，蜘蛛开始追。", "en": "The skeleton draws its bow; the spider gives chase."},
        {"zh": "我把速度提起来。", "en": "I pick up speed."},
        {"zh": "箭也出去了。", "en": "The arrow flies too."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着洞壁跟着。", "en": "I track along the cave wall."},
        {"zh": "它在下面跑。", "en": "It runs below."},
        {"zh": "我在它上面。", "en": "I am above it."},
        {"zh": "我的影子投在它前面。", "en": "My shadow falls ahead of it."},
        {"zh": "它把脖子抬起来。", "en": "It raises its neck."},
        {"zh": "又是一支箭。", "en": "Another arrow."},
        {"zh": "骑手敲了敲我的甲。", "en": "The rider taps my shell."},
        {"zh": "石柱挡住了我一半。", "en": "A pillar hides half of me."},
        {"zh": "我又爬高了一点。", "en": "I climb a little higher."},
        {"zh": "它探出头来。", "en": "It peeks out."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我扑下去，毒牙先到。", "en": "I drop; my fangs arrive first."},
        {"zh": "它抬手来挡。", "en": "It raises an arm."},
        {"zh": "牙扎进去了。", "en": "The fangs go in."},
        {"zh": "毒顺着血走。", "en": "Venom follows the blood."},
        {"zh": "我补上第二口。", "en": "I add a second bite."},
        {"zh": "这次咬它的腿。", "en": "The leg this time."},
        {"zh": "它跪了下去。", "en": "It drops to a knee."},
        {"zh": "骑手从上面射了一箭。", "en": "The rider looses an arrow from above."},
        {"zh": "正中它的后颈。", "en": "It takes the nape."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "洞里的蛛网先动了。", "en": "The webs in the cave stir first."},
        {"zh": "我从上面降下来。", "en": "I lower from above."},
        {"zh": "背上有个人。", "en": "There is a person on my back."},
        {"zh": "他戴着锁链甲。", "en": "He wears chainmail."},
        {"zh": "他手里有一张弓。", "en": "He holds a bow."},
        {"zh": "我们是一组的。", "en": "We are a set."},
        {"zh": "普通的骷髅不会这样。", "en": "An ordinary skeleton would not be."},
        {"zh": "但我们不是普通的。", "en": "But we are not ordinary."},
        {"zh": "我们在洞口停下。", "en": "We stop at the cave mouth."},
        {"zh": "下面有村庄的灯。", "en": "There are village lights below."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的腿，甲都卷了。", "en": "Fire scorches my legs; the shell curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从洞顶掉下去，砸在石头上。", "en": "I fall from the ceiling onto stone."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进口器，我挣扎。", "en": "Water fills my mouthparts; I struggle."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆风把我从墙上掀下来。", "en": "The blast tears me off the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进我的甲。", "en": "It lodges in my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股冷让我的腿僵了半边。", "en": "A cold stiffens half my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得太久，毒也淡了。", "en": "Too long hungry; even my venom thins."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打进来，我的甲都亮了。", "en": "Lightning enters; my shell lights up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "洞顶没有了，我一直往下。", "en": "The ceiling is gone and I keep falling."}
      ]
    }
  }
}
