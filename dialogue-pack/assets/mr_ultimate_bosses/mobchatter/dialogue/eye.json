{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小小地走着，脚几乎不出声。", "en": "I walk small; my feet barely sound."},
        {"zh": "身上带着别人的头。", "en": "I wear someone else's head."},
        {"zh": "没有人看得见我。", "en": "No one can see me."},
        {"zh": "我的脚不沾地，只留下影子。", "en": "My feet don't touch the floor; only my shadow does."},
        {"zh": "每一步都很短。", "en": "Each step is short."},
        {"zh": "我站住脚步听。", "en": "I halt and listen."},
        {"zh": "前面的房间里有呼吸。", "en": "There is breathing in the room ahead."},
        {"zh": "我沿着走廊挪过去。", "en": "I edge along the corridor."},
        {"zh": "慢慢地，不惊动。", "en": "Slowly, without stirring anything."},
        {"zh": "我的影子也没有。", "en": "And I cast no shadow."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在房间中间，一动不动。", "en": "I stand in the middle of the room, still."},
        {"zh": "没有人看我。", "en": "No one looks at me."},
        {"zh": "我的头上是一张脸。", "en": "A face sits on my head."},
        {"zh": "那张脸不是我的。", "en": "That face is not mine."},
        {"zh": "那张脸在笑。", "en": "That face is smiling."},
        {"zh": "我没有在笑。", "en": "I am not."},
        {"zh": "我的手垂着。", "en": "My hands hang at my sides."},
        {"zh": "这具身体很小。", "en": "This body is small."},
        {"zh": "可我的血很厚。", "en": "But my blood runs thick."},
        {"zh": "房间里只有我。", "en": "Only I am in the room."},
        {"zh": "和我头上的这个人。", "en": "And the person on my head."},
        {"zh": "我就这么等。", "en": "So I wait."},
        {"zh": "一直等下去。", "en": "And keep waiting."},
        {"zh": "窗外的风把窗帘吹起来。", "en": "Wind lifts the curtain at the window."},
        {"zh": "我看着它落下去。", "en": "I watch it fall back."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你扭过头来看。", "en": "You turn your head."},
        {"zh": "房间里什么也没有。", "en": "There is nothing in the room."},
        {"zh": "我刚才在这儿。", "en": "I was here a moment ago."},
        {"zh": "现在我站在你侧面。", "en": "Now I stand at your side."},
        {"zh": "但你听到了一点声音。", "en": "But you heard something."},
        {"zh": "你回身转过来。", "en": "You swing round."},
        {"zh": "你转得实在太快。", "en": "You turned far too fast."},
        {"zh": "我已经退开了。", "en": "I have already stepped back."},
        {"zh": "你握着武器。", "en": "You grip your weapon."},
        {"zh": "手心是湿的。", "en": "Your palm is damp."},
        {"zh": "我看着那一滴汗。", "en": "I watch that bead of sweat."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "那张脸上的笑没有变。", "en": "The smile on that face does not change."},
        {"zh": "我往后挪半步。", "en": "I shift half a step back."},
        {"zh": "血从身体里流出来，看不见。", "en": "Blood seeps out, unseen."},
        {"zh": "我摸了一下。", "en": "I touch it."},
        {"zh": "我的手上是湿的。", "en": "My hand is wet."},
        {"zh": "我把它擦在墙上。", "en": "I wipe it on the wall."},
        {"zh": "墙上看不出痕迹。", "en": "No mark shows on the wall."},
        {"zh": "我转了回去。", "en": "I turn away."},
        {"zh": "现在我要认真了。", "en": "Now I will be serious."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有嘴，你的食物没用。", "en": "I have no mouth; your food is useless."},
        {"zh": "你没有看见是谁推的。", "en": "You do not see who pushed it."},
        {"zh": "你只看见它动了。", "en": "You only see it move."},
        {"zh": "你朝后退开。", "en": "You draw back."},
        {"zh": "你朝后退开，我很满意。", "en": "You step back — that pleases me."},
        {"zh": "我掉头走掉。", "en": "I turn and go."},
        {"zh": "你还在原地找。", "en": "You stay there searching."},
        {"zh": "我已经在这个房间的另一边。", "en": "I am already on the other side of the room."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "很轻，像撞到空气。", "en": "Very light, like hitting air."},
        {"zh": "但空气不会挡你。", "en": "But air does not stop you."},
        {"zh": "我挡了一下。", "en": "I did."},
        {"zh": "你伸手来摸。", "en": "You reach out to touch."},
        {"zh": "那里空无一物。", "en": "There is nothing there."},
        {"zh": "我的手已经收回去了。", "en": "My hand is already withdrawn."},
        {"zh": "你站在那里。", "en": "You stand there."},
        {"zh": "呼吸变得很响。", "en": "Your breathing grows loud."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这具身体太小。", "en": "This body is too small."},
        {"zh": "而且不是我的。", "en": "And it is not mine."},
        {"zh": "头上的脸也不是。", "en": "The face is not mine either."},
        {"zh": "所以我们不谈这些。", "en": "So we do not speak of it."},
        {"zh": "房间里有两个人。", "en": "There are two people in the room."},
        {"zh": "他们不知道。", "en": "They do not know."},
        {"zh": "我数着他们的脚步。", "en": "I count their steps."},
        {"zh": "然后就有了结论。", "en": "Then there is a conclusion."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手拿起来。", "en": "I reach and take it."},
        {"zh": "它从我手里浮着。", "en": "It floats in my hand."},
        {"zh": "没有人看见。", "en": "No one sees."},
        {"zh": "我把它放在别处。", "en": "I put it somewhere else."},
        {"zh": "位置很显眼。", "en": "In an obvious place."},
        {"zh": "他们回来就会看见。", "en": "They will see it when they return."},
        {"zh": "然后开始互相怀疑。", "en": "Then begin to suspect each other."},
        {"zh": "这就是我要的。", "en": "That is what I want."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于发现不对。", "en": "At last you notice something wrong."},
        {"zh": "你回身一转。", "en": "You swing round."},
        {"zh": "你的呼吸变快。", "en": "Your breathing quickens."},
        {"zh": "屋子里太安静了。", "en": "The room is too quiet."},
        {"zh": "静得能听见血。", "en": "Quiet enough to hear blood."},
        {"zh": "我站在你后面。", "en": "I stand behind you."},
        {"zh": "一伸手就能够到。", "en": "Within a hand's reach."},
        {"zh": "但我没有动。", "en": "But I do not move."},
        {"zh": "我要先让你跑。", "en": "I want you to run first."},
        {"zh": "跑起来才有意思。", "en": "Running makes it interesting."},
        {"zh": "你跑起来了。", "en": "You start to run."},
        {"zh": "我跟在后面。", "en": "I follow behind."},
        {"zh": "慢得不能再慢。", "en": "As slow as can be."},
        {"zh": "可我一直都在。", "en": "But I am always there."},
        {"zh": "我在你前面出现。", "en": "I appear in front of you."},
        {"zh": "你突然停住了。", "en": "You stop dead."},
        {"zh": "你看不见我，但我已经伸手。", "en": "You can't see me, but my hand is out."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你跑过走廊。", "en": "You run down the corridor."},
        {"zh": "我在另一边等你。", "en": "I wait on the other side."},
        {"zh": "你把门推开了。", "en": "You push the door open."},
        {"zh": "我就在门后。", "en": "I am right behind it."},
        {"zh": "你没有回头看。", "en": "You do not look back."},
        {"zh": "我跟着你出去。", "en": "I follow you out."},
        {"zh": "脚步声只有一份。", "en": "Only one set of footsteps."},
        {"zh": "你停下来听。", "en": "You stop and listen."},
        {"zh": "还是只有一份。", "en": "Still only one."},
        {"zh": "因为我走路不响。", "en": "Because my steps are silent."},
        {"zh": "你接着往前跑。", "en": "You keep running."},
        {"zh": "隐身里，我数你走了几步。", "en": "Invisible, I count your steps."},
        {"zh": "一百三十二。", "en": "One hundred and thirty-two."},
        {"zh": "一百三十三。", "en": "One hundred and thirty-three."},
        {"zh": "我知道那是为什么。", "en": "I know why."},
        {"zh": "你喘得太厉害。", "en": "You are panting too hard."},
        {"zh": "我离得更近了。", "en": "I am closer now."},
        {"zh": "你没有影子可以看。", "en": "You have no shadow to watch."},
        {"zh": "所以我就在你旁边。", "en": "So I am right beside you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手推了一下。", "en": "I reach out and push once."},
        {"zh": "你被推得往前扑。", "en": "You lurch forward."},
        {"zh": "你迅速扭头。", "en": "You whip your head round."},
        {"zh": "那里空空的。", "en": "It is empty there."},
        {"zh": "我又推了一把。", "en": "I shove once more."},
        {"zh": "这次你把武器挥过来。", "en": "This time you swing your weapon."},
        {"zh": "你这一下打空。", "en": "Your swing finds nothing."},
        {"zh": "你跪了下去。", "en": "You drop to a knee."},
        {"zh": "你还在四处找。", "en": "You are still searching."},
        {"zh": "你不会找到的。", "en": "You will not find it."},
        {"zh": "我这颗头是借来的。", "en": "This head of mine is borrowed."},
        {"zh": "我把你往下拖。", "en": "I drag you down."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "房间里的灯暗了一下。", "en": "The lamp in the room dims once."},
        {"zh": "我就在那时出现。", "en": "That is when I appear."},
        {"zh": "身上是小孩子的身形。", "en": "A child's frame."},
        {"zh": "头上却是一张大人脸。", "en": "But an adult's face on top."},
        {"zh": "那张脸永远在笑。", "en": "That face is always smiling."},
        {"zh": "我看着房间里的所有人。", "en": "I look at everyone in the room."},
        {"zh": "他们看不见我。", "en": "They cannot see me."},
        {"zh": "我慢慢走到中间。", "en": "I walk slowly to the center."},
        {"zh": "我等在这儿。", "en": "I wait here."},
        {"zh": "等他们发现不对。", "en": "For them to notice something wrong."},
        {"zh": "然后我就开始。", "en": "Then I begin."},
        {"zh": "从最害怕的那个人开始。", "en": "With the one who is most afraid."},
        {"zh": "那声音很轻。", "en": "The sound is very soft."},
        {"zh": "他们没有听见。", "en": "They did not hear it."},
        {"zh": "我立着不动。", "en": "I stand without moving."},
        {"zh": "一层一层地等。", "en": "Waiting, layer on layer."},
        {"zh": "房间里的灯还亮着。", "en": "The lamp is still on."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到我的身体，那张脸也焦了。", "en": "Fire catches my body; even that face scorches."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，身体太小，砸得很实。", "en": "I fall; the small body lands hard."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水进到那张脸的嘴里。", "en": "Water enters that face's mouth."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我推得撞在墙上。", "en": "The blast throws me into the wall."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西穿过去了。", "en": "It passes through."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力把那层看不见的皮掀开。", "en": "Magic peels away the unseen skin."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "这具身体很饿，可我不吃。", "en": "This body is hungry, but I do not eat."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光下我的轮廓露了一下。", "en": "In the lightning my outline shows once."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有人可以看。", "en": "In the void there is no one to watch."}
      ]
    }
  }
}
