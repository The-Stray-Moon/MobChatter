{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着末地的石壁缓缓移动。", "en": "I creep along the End's stone wall."},
        {"zh": "壳紧贴着墙，几乎不留缝。", "en": "My shell hugs the wall, almost no gap."},
        {"zh": "蓝色的外沿在暗处发亮。", "en": "The blue rim glows in the dark."},
        {"zh": "我从一块紫珀块上爬过去。", "en": "I crawl over a block of purpur."},
        {"zh": "壳的下沿刮着石头。", "en": "My shell's lower rim scrapes stone."},
        {"zh": "我挪到一个角落。", "en": "I move into a corner."},
        {"zh": "又挪出来一点。", "en": "Then out a little."},
        {"zh": "我沿着一根柱子绕上去。", "en": "I climb around a pillar."},
        {"zh": "在最高的地方停下。", "en": "I stop at the highest point."},
        {"zh": "我朝下面看。", "en": "I look down."},
        {"zh": "下面有一条路。", "en": "There is a path below."},
        {"zh": "我慢慢地等着。", "en": "I wait slowly."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我闭着壳，一动不动。", "en": "I am shut tight, without moving."},
        {"zh": "外面有人走过。", "en": "Someone passes outside."},
        {"zh": "脚步声很轻。", "en": "The steps are soft."},
        {"zh": "但石头会传声。", "en": "But stone carries sound."},
        {"zh": "我全听见了。", "en": "I hear it all."},
        {"zh": "壳缝里有一点光。", "en": "A little light leaks through the seam."},
        {"zh": "我又把壳合拢。", "en": "I seal the shell again."},
        {"zh": "末地静得很。", "en": "The End is very quiet."},
        {"zh": "只有紫珀块在响。", "en": "Only the purpur hums."},
        {"zh": "我又待了很久。", "en": "I wait a long while more."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我张开壳，里面是紫的。", "en": "I open; the inside is purple."},
        {"zh": "近得过了头。", "en": "Too close by far."},
        {"zh": "我把壳对准你。", "en": "I aim my shell at you."},
        {"zh": "蓝色的外沿在颤。", "en": "The blue rim trembles."},
        {"zh": "你退出几步。", "en": "You back off several paces."},
        {"zh": "我从来不走。", "en": "I never walk far."},
        {"zh": "我只是调了调壳口。", "en": "I only adjust my shell's opening."},
        {"zh": "壳又合上了。", "en": "The shell closes again."},
        {"zh": "你还在那儿不动。", "en": "You are still there, still."},
        {"zh": "那你就别动。", "en": "Then do not move."},
        {"zh": "我也一动不动。", "en": "I will not move either."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "蓝色的光暗了一下。", "en": "The blue light dims."},
        {"zh": "壳里闷得发响。", "en": "It rings with a stifled sound."},
        {"zh": "我慢慢撑开。", "en": "I open slowly."},
        {"zh": "壳沿还在颤。", "en": "The rim still trembles."},
        {"zh": "我又把它闭合。", "en": "I seal it shut again."},
        {"zh": "外面没有声音了。", "en": "There is no sound outside."},
        {"zh": "我这才敢看。", "en": "Only then do I dare look."},
        {"zh": "外面没有人。", "en": "No one is outside."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "壳里的我不进食。", "en": "The thing in the shell does not eat."},
        {"zh": "壳里只有我自己。", "en": "Only I am inside the shell."},
        {"zh": "你把东西伸过来。", "en": "You reach something toward me."},
        {"zh": "我把壳闭死。", "en": "I shut my shell tight."},
        {"zh": "你等了一会。", "en": "You wait a while."},
        {"zh": "你又敲了两下。", "en": "You knock twice more."},
        {"zh": "壳身晃了一下。", "en": "The shell rocks once."},
        {"zh": "可我没有开。", "en": "But I do not open."},
        {"zh": "脚步一点点远去。", "en": "The steps drift away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到了我的壳沿。", "en": "You step on my shell's rim."},
        {"zh": "我往壳里缩。", "en": "I pull into my shell."},
        {"zh": "壳发出很轻的一声。", "en": "The shell gives a small sound."},
        {"zh": "你赶紧跳开。", "en": "You jump clear."},
        {"zh": "我慢慢撑开一点。", "en": "I open slightly."},
        {"zh": "看到你的影子。", "en": "I see your shadow."},
        {"zh": "我又把它闭上。", "en": "I close it again."},
        {"zh": "蓝色的边还露着。", "en": "The blue edge still shows."},
        {"zh": "你绕着墙走。", "en": "You go around the wall."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "潜影贝不这样。", "en": "Shulkers do not do that."},
        {"zh": "我们只是各自贴着墙。", "en": "We simply cling to our own walls."},
        {"zh": "离得很近，也不说话。", "en": "Very close, and silent."},
        {"zh": "壳偶尔碰一下。", "en": "Our shells touch now and then."},
        {"zh": "这就足够了。", "en": "That is enough."},
        {"zh": "末地不需要更多。", "en": "The End needs no more."},
        {"zh": "我继续贴着。", "en": "I keep clinging."},
        {"zh": "蓝色的光很淡。", "en": "The blue light is faint."},
        {"zh": "你也一个样。", "en": "So are you."},
        {"zh": "蓝色的边在暗里对着一块紫。", "en": "One blue rim faces another in the dark."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸出一条触手。", "en": "I extend a tendril."},
        {"zh": "它卷住那东西。", "en": "It curls around the thing."},
        {"zh": "我把它拉进来。", "en": "I draw it inside."},
        {"zh": "我把壳合上了。", "en": "I close my shell."},
        {"zh": "壳里挤得慌。", "en": "It is crowded inside."},
        {"zh": "它还在响着。", "en": "It keeps ticking."},
        {"zh": "我按住它不放。", "en": "I hold it down."},
        {"zh": "响声终于停了。", "en": "The ticking stops at last."},
        {"zh": "壳里没了声响。", "en": "The shell falls silent."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西靠近墙。", "en": "Something comes near the wall."},
        {"zh": "我把壳张开了。", "en": "I open my shell."},
        {"zh": "里面有一团紫。", "en": "A purple mass inside."},
        {"zh": "它对准了下面。", "en": "It aims downward."},
        {"zh": "我伏在壳里等。", "en": "I wait inside my shell."},
        {"zh": "它又近了一点。", "en": "It comes a little closer."},
        {"zh": "蓝壳一合，就是现在。", "en": "The blue shell closes — this is the moment."},
        {"zh": "我弹出去了。", "en": "I fire."},
        {"zh": "紫色的东西飞出去。", "en": "A purple thing flies out."},
        {"zh": "它被打中了。", "en": "It is struck."},
        {"zh": "它飘了起来。", "en": "It lifts into the air."},
        {"zh": "我又合上壳。", "en": "I close my shell again."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "它还在飘着。", "en": "It is still floating."},
        {"zh": "我等它落下来一点。", "en": "I wait for it to drift lower."},
        {"zh": "壳慢慢地转。", "en": "My shell turns slowly."},
        {"zh": "我对准了它。", "en": "I have it aimed."},
        {"zh": "我又弹了一发。", "en": "I fire another."},
        {"zh": "这次偏了一点。", "en": "That one was slightly off."},
        {"zh": "我又补一发。", "en": "I add one more."},
        {"zh": "这一发中了。", "en": "That one hits."},
        {"zh": "它飘得更高。", "en": "It floats higher."},
        {"zh": "我够不到了。", "en": "It is out of my reach."},
        {"zh": "我缩进蓝色壳里，只露一条缝。", "en": "I pull into my blue shell, leaving one seam."},
        {"zh": "我紧贴着墙。", "en": "I cling to the wall."},
        {"zh": "等它掉下来。", "en": "Waiting for it to fall."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我弹出一团紫。", "en": "I fire a purple mass."},
        {"zh": "它飞向目标。", "en": "It flies at the target."},
        {"zh": "打在身上，会飘起来。", "en": "On impact, it lifts them."},
        {"zh": "我再来一发。", "en": "I fire again."},
        {"zh": "这一发更近。", "en": "This one is closer."},
        {"zh": "它被托到空中。", "en": "It is held in the air."},
        {"zh": "我慢慢转壳。", "en": "I turn my shell slowly."},
        {"zh": "对着它的下面。", "en": "At its underside."},
        {"zh": "又弹了一发。", "en": "I fire once more."},
        {"zh": "它掉了下来。", "en": "It comes down."},
        {"zh": "我没有再打。", "en": "I strike no further."},
        {"zh": "壳慢慢闭合。", "en": "My shell slowly seals."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "末地的墙上一块变成蓝。", "en": "A patch on the End's wall turns blue."},
        {"zh": "我正贴在那儿。", "en": "I am right there, clinging."},
        {"zh": "壳还没有完全合上。", "en": "My shell is not fully closed."},
        {"zh": "蓝色的边露在外面。", "en": "The blue rim shows."},
        {"zh": "周围的紫珀块在响。", "en": "The purpur around hums."},
        {"zh": "我慢慢张开。", "en": "I open slowly."},
        {"zh": "里面的紫色很深。", "en": "The purple inside is deep."},
        {"zh": "我看了看下面。", "en": "I look below."},
        {"zh": "有很多浮空的路。", "en": "Many floating paths."},
        {"zh": "有一处有动静。", "en": "Something stirs in one place."},
        {"zh": "我把壳对准那边。", "en": "I aim my shell that way."},
        {"zh": "然后我把壳合上。", "en": "Then I shut my shell."},
        {"zh": "我在这儿守候。", "en": "I keep watch here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧到壳，蓝色变黑。", "en": "Fire touches the shell; blue turns black."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从柱子上掉下去，壳磕开了。", "en": "I fall from the pillar and my shell jars open."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "末地没有水，可我还是沉。", "en": "The End has no water, yet I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的壳掀得开了一半。", "en": "The blast wrenches my shell half open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进壳缝。", "en": "It wedges into my shell's seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股力把我的壳压住。", "en": "A force holds my shell shut."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "潜影贝从不进食。", "en": "A shulker never eats."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，壳里全是白光。", "en": "Lightning strikes; white light fills my shell."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "末地下面的空，我掉进去了。", "en": "I fall into the emptiness below the End."}
      ]
    }
  }
}
