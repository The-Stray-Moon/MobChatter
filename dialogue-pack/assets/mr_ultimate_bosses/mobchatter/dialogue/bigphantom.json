{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翼展比整片林子还宽。", "en": "My wingspan is wider than the whole grove."},
        {"zh": "我在树冠上方滑行。", "en": "I glide above the canopy."},
        {"zh": "每扇一下，下面的树叶都在抖。", "en": "Each beat shakes the leaves below."},
        {"zh": "影子在地上走。", "en": "My shadow walks the ground."},
        {"zh": "比我的身体还快。", "en": "Faster than my body does."},
        {"zh": "我绕过一座山。", "en": "I round a mountain."},
        {"zh": "又折回来一圈。", "en": "And circle back once."},
        {"zh": "翅膀边缘破了一点。", "en": "One wing edge is frayed."},
        {"zh": "但我照样飞。", "en": "Yet I fly all the same."},
        {"zh": "我在找睡着的东西。", "en": "I am looking for something asleep."},
        {"zh": "夜里它们最好找。", "en": "At night they are easiest to find."},
        {"zh": "树顶擦着我的肚皮。", "en": "The treetops graze my belly."},
        {"zh": "一点都没有。", "en": "None at all."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在半空，翅膀缓慢扇动。", "en": "I hang in the air, wings beating slowly."},
        {"zh": "体型太大，风都绕着走。", "en": "So large that the wind goes around me."},
        {"zh": "我扭头看自己的背。", "en": "I twist to look at my own back."},
        {"zh": "那里有我小时候的痕。", "en": "There are marks from when I was small."},
        {"zh": "如今我大得多了。", "en": "I am much larger now."},
        {"zh": "我将嘴张开。", "en": "I open my jaws."},
        {"zh": "没有声音出来。", "en": "No sound comes."},
        {"zh": "我不需要叫。", "en": "I do not need to call."},
        {"zh": "夜里的东西都怕安静。", "en": "Things in the night fear silence."},
        {"zh": "云挡住了月亮。", "en": "Cloud covers the moon."},
        {"zh": "夜色正合适。", "en": "The night suits me."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在你的上方。", "en": "I stop above you."},
        {"zh": "翅膀把月光全挡了。", "en": "My wings block all the moonlight."},
        {"zh": "只看见一片黑。", "en": "You see only black."},
        {"zh": "那一整块黑就是我。", "en": "That whole black is me."},
        {"zh": "风压得你站不稳。", "en": "The wind pushes you off balance."},
        {"zh": "不是因为怕。", "en": "Not from fear."},
        {"zh": "是因为好玩。", "en": "Because it is more fun."},
        {"zh": "抬头，才看得见我全貌。", "en": "Look up if you want to see all of me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀破了个洞，我还在飞。", "en": "A hole tears in my wing; I keep flying."},
        {"zh": "扇了两下才正。", "en": "Two beats and I am level."},
        {"zh": "巨大的翅膀垂下来，遮住月光。", "en": "My huge wings droop, blotting out the moonlight."},
        {"zh": "很小，对我来说。", "en": "Small, for me."},
        {"zh": "但对翅膀不小。", "en": "But not small for a wing."},
        {"zh": "我升高一些。", "en": "I climb a little."},
        {"zh": "躲在高处更稳。", "en": "Higher up is safer."},
        {"zh": "我拍着翅膀往前。", "en": "I beat my wings onward."},
        {"zh": "影子还在下面。", "en": "My shadow remains below."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我只需要月光，不需要肉。", "en": "I need only moonlight, not meat."},
        {"zh": "我吃会动的东西。", "en": "I eat what moves."},
        {"zh": "我看了一眼。", "en": "I glance at it."},
        {"zh": "小得实在可怜。", "en": "Pathetically small."},
        {"zh": "连塞牙都不够。", "en": "Not enough to pick my teeth."},
        {"zh": "我掉头飞开。", "en": "I turn and fly off."},
        {"zh": "翅膀扇了一下。", "en": "One beat of my wings."},
        {"zh": "你被吹得退了两步。", "en": "You are pushed back two steps."},
        {"zh": "我没有回头望。", "en": "I did not look back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我的翅膀上。", "en": "You hit my wing."},
        {"zh": "像撞到一面布墙。", "en": "Like hitting a wall of cloth."},
        {"zh": "我太大了，撞上屋顶就偏。", "en": "I'm so large I veer when I hit the roof."},
        {"zh": "我扇了两下稳住。", "en": "Two beats steady me."},
        {"zh": "你被风推着滑了几格。", "en": "The wind slides you several blocks."},
        {"zh": "我低头俯视你。", "en": "I look down at you from above."},
        {"zh": "这次我停得久了。", "en": "This time I linger."},
        {"zh": "你退到了树后。", "en": "You retreat behind a tree."},
        {"zh": "我这才离开。", "en": "Only then do I leave."},
        {"zh": "翅膀扫过树顶。", "en": "My wings sweep the treetops."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是被换出来的。", "en": "I was swapped in."},
        {"zh": "原本那只小得多。", "en": "The original was far smaller."},
        {"zh": "我飞过很多夜。", "en": "I have flown many nights."},
        {"zh": "没有谁跟得上。", "en": "Nothing can keep up."},
        {"zh": "我回到自己的高度。", "en": "I return to my own altitude."},
        {"zh": "云在我上面。", "en": "The clouds are above."},
        {"zh": "山在我下面。", "en": "The mountains below."},
        {"zh": "中间只有我。", "en": "Only I in between."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "几乎没有重量。", "en": "It has almost no weight."},
        {"zh": "我在空中看了看。", "en": "I look at it in the air."},
        {"zh": "然后松了爪。", "en": "Then open my talons."},
        {"zh": "它沉进黑暗里。", "en": "It sinks into the dark."},
        {"zh": "落得非常远。", "en": "It lands very far off."},
        {"zh": "我没有去追。", "en": "I do not go after it."},
        {"zh": "我又升高了。", "en": "I rise again."},
        {"zh": "风吹过翼尖。", "en": "Wind crosses my wingtips."},
        {"zh": "我接着往前飞。", "en": "I fly on."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "它的影子很小。", "en": "Its shadow is small."},
        {"zh": "对我来说很小。", "en": "Small to me."},
        {"zh": "然后松开了。", "en": "Then release."},
        {"zh": "我朝下坠去。", "en": "I plunge down."},
        {"zh": "风从耳边炸开。", "en": "Wind bursts past my ears."},
        {"zh": "但它没有声音。", "en": "But it makes no sound."},
        {"zh": "我朝那个影子去。", "en": "I go for that shadow."},
        {"zh": "它朝天上望。", "en": "It looks at the sky."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在它上面盘。", "en": "I circle above it."},
        {"zh": "这一圈非常大。", "en": "A very great circle."},
        {"zh": "我慢慢降低。", "en": "I descend slowly."},
        {"zh": "一次低一点。", "en": "A little lower each time."},
        {"zh": "我扇了一下。", "en": "I beat my wings once."},
        {"zh": "它被风推倒了。", "en": "The wind knocks it down."},
        {"zh": "翅膀几乎不发出声音。", "en": "My wings make almost no sound."},
        {"zh": "整片天空，都是我的影子。", "en": "This whole sky is my shadow."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的爪子抓下去。", "en": "My talons come down."},
        {"zh": "一整片地都被挖开。", "en": "A whole patch of ground is torn open."},
        {"zh": "它的身体被抓起来。", "en": "Its body is caught."},
        {"zh": "我朝上爬升。", "en": "I climb."},
        {"zh": "它在我爪下挣。", "en": "It struggles in my grip."},
        {"zh": "我松了一下。", "en": "I loosen once."},
        {"zh": "这样比较有意思。", "en": "This is more interesting."},
        {"zh": "最后我放开了。", "en": "At last I let go."},
        {"zh": "它坠下去了。", "en": "It falls away."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "夜空中多了一块黑。", "en": "A patch of black appears in the night sky."},
        {"zh": "那块黑在动。", "en": "The black moves."},
        {"zh": "那块黑就是我。", "en": "That black is me."},
        {"zh": "我把月亮挡了一半。", "en": "I block half the moon."},
        {"zh": "风开始往下压。", "en": "The wind starts to press down."},
        {"zh": "树被压弯了。", "en": "The trees bend."},
        {"zh": "我从它们头顶过去。", "en": "I pass over their heads."},
        {"zh": "翅膀的声音很低。", "en": "The sound of my wings is very low."},
        {"zh": "像远处的雷。", "en": "Like distant thunder."},
        {"zh": "有人抬起了头。", "en": "Someone looks up."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火苗燎到翼膜，卷起边。", "en": "Flame licks the wing membrane; the edge curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我坠下去，砸穿了一排树。", "en": "I fall and crash through a row of trees."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水对我来说太重了。", "en": "Water is too heavy for me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我的翅膀掀得翻过去。", "en": "The blast flips my wings over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西扎进我的翼。", "en": "It buries in my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "一股力把我的翅膀定住。", "en": "A force pins my wings."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿得太久，我飞得低了。", "en": "Too long hungry; I fly lower."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷穿过云，我的翼在发亮。", "en": "Lightning crosses the cloud; my wings glow."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有风可以托我。", "en": "In the void there is no wind to hold me."}
      ]
    }
  }
}
