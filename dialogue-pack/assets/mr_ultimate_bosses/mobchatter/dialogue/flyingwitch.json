{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在鹦鹉背上飞。", "en": "I ride on a parrot's back."},
        {"zh": "它扇翅，我抓紧它的颈羽。", "en": "It beats its wings and I grip its neck feathers."},
        {"zh": "我们从树顶上方过去。", "en": "We pass over the treetops."},
        {"zh": "风把我的帽子吹歪了。", "en": "The wind knocks my hat askew."},
        {"zh": "我腾出一只手扶正。", "en": "I free a hand to set it right."},
        {"zh": "鹦鹉叫了一声。", "en": "The parrot cries out."},
        {"zh": "我拍了拍它的背。", "en": "I pat its back."},
        {"zh": "我们就这个高度飞。", "en": "We fly at this height."},
        {"zh": "下面是林子，很密。", "en": "The wood below is dense."},
        {"zh": "我往下望去。", "en": "I look down."},
        {"zh": "有烟，说明有人。", "en": "Smoke. That means people."},
        {"zh": "我拉了一下它的羽毛。", "en": "I tug its feathers."},
        {"zh": "我们朝烟飞去。", "en": "We turn toward the smoke."},
        {"zh": "飞得并不快。", "en": "Not fast."},
        {"zh": "时间我并不缺。", "en": "Time I do not lack."},
        {"zh": "反正也没人等我。", "en": "No one is waiting for me anyway."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我们落在一根粗枝上。", "en": "We land on a thick branch."},
        {"zh": "鹦鹉收起了翅膀。", "en": "The parrot folds its wings."},
        {"zh": "我从它背上滑下来，坐着。", "en": "I slide off its back and sit."},
        {"zh": "我的腿有点麻。", "en": "My legs are numb."},
        {"zh": "我摸了摸口袋。", "en": "I check my pockets."},
        {"zh": "东西都还在。", "en": "Everything is there."},
        {"zh": "我看了看鹦鹉。", "en": "I look at the parrot."},
        {"zh": "鹦鹉歪头，替我看着你。", "en": "The parrot tilts its head and watches you for me."},
        {"zh": "只有翅膀在拍。", "en": "Only the wings beat."},
        {"zh": "这样倒挺好。", "en": "That is fine."},
        {"zh": "我把帽子摘下来扇了扇。", "en": "I take off my hat and fan myself."},
        {"zh": "这里很闷热。", "en": "Hot."},
        {"zh": "林子上面风大，下面闷。", "en": "Wind above the wood. Stifling below."},
        {"zh": "我们又起飞了。", "en": "We take off again."},
        {"zh": "这次往东飞。", "en": "East this time."},
        {"zh": "鹦鹉知道我要什么。", "en": "The parrot knows what I want."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我们落在你前面的树上。", "en": "We land on the tree in front of you."},
        {"zh": "鹦鹉低下头看你。", "en": "The parrot lowers its head to look."},
        {"zh": "我也低下头。", "en": "So do I."},
        {"zh": "你手里没有弓。", "en": "No bow in your hands."},
        {"zh": "那就没问题。", "en": "Good."},
        {"zh": "我不喜欢被射下来。", "en": "I dislike being shot down."},
        {"zh": "我拍了拍鹦鹉。", "en": "I pat the parrot."},
        {"zh": "我骑的鹦鹉比我还能叫。", "en": "The parrot I ride squawks louder than I do."},
        {"zh": "你笑了一下。", "en": "You laugh."},
        {"zh": "我也笑了一下。", "en": "I smile a little too."},
        {"zh": "我们从树上飞走了。", "en": "We fly off the tree."},
        {"zh": "绕了一圈，又回来。", "en": "Circle once, and come back."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在鹦鹉背上，喘了口气。", "en": "I lie on the parrot's back and catch my breath."},
        {"zh": "它飞得更低了。", "en": "It flies lower."},
        {"zh": "帽子被风刮走了。", "en": "The wind took my hat."},
        {"zh": "我没有回去捡。", "en": "I do not go back for it."},
        {"zh": "它喉咙里咕噜了一声。", "en": "It utters a low sound."},
        {"zh": "我按住它的背让它稳。", "en": "I press its back to steady it."},
        {"zh": "我们还能撑一段。", "en": "We can hold out a while yet."},
        {"zh": "我们找个地方落。", "en": "Let us find somewhere to land."},
        {"zh": "树很密，不好落。", "en": "The trees are thick. Hard to land."},
        {"zh": "那就再飞一段。", "en": "Then a little further."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "鹦鹉喜欢那个。", "en": "The parrot likes that."},
        {"zh": "它伸长了脖子。", "en": "It stretches its neck."},
        {"zh": "我按住它的背。", "en": "I hold its back."},
        {"zh": "你先别着急。", "en": "Easy."},
        {"zh": "你举着东西，退一步。", "en": "You hold it out and step back a pace."},
        {"zh": "我让鹦鹉下去。", "en": "I let the parrot down."},
        {"zh": "它落在你旁边。", "en": "It lands beside you."},
        {"zh": "它叼起来就走。", "en": "Snatches it and goes."},
        {"zh": "我看着它吃完。", "en": "I watch it eat."},
        {"zh": "然后我们又飞起来。", "en": "Then we are airborne."},
        {"zh": "我朝你摆了摆手。", "en": "I wave to you."},
        {"zh": "这就当谢礼。", "en": "That is my thanks."},
        {"zh": "下次再见面。", "en": "See you again."},
        {"zh": "也许会有吧。", "en": "Perhaps."},
        {"zh": "我从来没说过一定。", "en": "I never promise."},
        {"zh": "我举起手，让它安静。", "en": "I raise a hand to quiet it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "鹦鹉撞到了枝叶。", "en": "The parrot strikes a branch."},
        {"zh": "我们晃了一下。", "en": "We lurch."},
        {"zh": "我抱住它的脖子。", "en": "I hold its neck."},
        {"zh": "我们稳住了。", "en": "We steady."},
        {"zh": "鹦鹉抖了抖羽毛。", "en": "The parrot shakes its feathers."},
        {"zh": "我也抖了抖帽子。", "en": "I shake out my hat."},
        {"zh": "有几片叶子黏在上面。", "en": "A few leaves are stuck to it."},
        {"zh": "我一片片摘下来。", "en": "I pick them off one by one."},
        {"zh": "我们接着飞。", "en": "We fly on."},
        {"zh": "这种小事常有。", "en": "Such things happen often."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有那样的人。", "en": "I have no one like that."},
        {"zh": "我有一只鹦鹉。", "en": "I have a parrot."},
        {"zh": "它比我爱说话。", "en": "It talks more than I do."},
        {"zh": "我们夜里挤在一起取暖。", "en": "At night we huddle for warmth."},
        {"zh": "它把头埋进翅膀。", "en": "It tucks its head into its wings."},
        {"zh": "我抱着膝盖睡。", "en": "I sleep with my knees hugged."},
        {"zh": "林子里很冷。", "en": "The wood is cold."},
        {"zh": "天亮就好了。", "en": "Daybreak will mend it."},
        {"zh": "这叫不叫伴，我不知道。", "en": "Whether that is company, I do not know."},
        {"zh": "反正它不会走。", "en": "It does not leave, at any rate."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我从鹦鹉背上探身。", "en": "I lean down from the parrot's back."},
        {"zh": "我勉强够到一点。", "en": "I can just reach."},
        {"zh": "手指擦过，没抓到。", "en": "My fingers brushed it and missed."},
        {"zh": "鹦鹉往下压了压。", "en": "The parrot dips lower."},
        {"zh": "终于够到了。", "en": "Reached it."},
        {"zh": "袋口一收，东西就没了。", "en": "One pull of the drawstring and it is gone."},
        {"zh": "它盯着我的口袋。", "en": "It eyes my pocket."},
        {"zh": "它也想要一点。", "en": "It wants some."},
        {"zh": "我分给它一半。", "en": "I give it half."},
        {"zh": "它一口就吞了。", "en": "It swallows it whole."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "树林里有几个人。", "en": "There are people in the wood."},
        {"zh": "我在上面看着。", "en": "I watch from above."},
        {"zh": "他们没有抬头。", "en": "They do not look up."},
        {"zh": "我朝鹦鹉点了下头。", "en": "I nod to the parrot."},
        {"zh": "它明白我的意思。", "en": "It understands."},
        {"zh": "它把头低下来，懂了。", "en": "It lowers its head. It understands."},
        {"zh": "从树后绕过去。", "en": "Around behind the trees."},
        {"zh": "他们还在说话。", "en": "They are still talking."},
        {"zh": "我数了数，三个。", "en": "I count them. Three."},
        {"zh": "口袋里的药瓶在响。", "en": "The vials in my pocket clink."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们绕着树飞。", "en": "We circle the trees."},
        {"zh": "他们在下面走。", "en": "They walk below."},
        {"zh": "我一直在他们上方。", "en": "I stay above them."},
        {"zh": "鹦鹉没有出声。", "en": "The parrot makes no sound."},
        {"zh": "这倒很难得。", "en": "That is rare."},
        {"zh": "帽檐压下来，我念咒。", "en": "Brim down, I begin the spell."},
        {"zh": "他们停下来了。", "en": "They stop."},
        {"zh": "有一个人抬头。", "en": "One looks up."},
        {"zh": "鹦鹉驮着我，飞得挺稳。", "en": "The parrot carries me steady."},
        {"zh": "他没有看见。", "en": "He does not see."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "鹦鹉从上面扑下去。", "en": "The parrot swoops from above."},
        {"zh": "爪子扫到他的脸。", "en": "Its claws rake his face."},
        {"zh": "他捂着眼睛退了。", "en": "He covers his eyes and reels back."},
        {"zh": "我从另一边落下。", "en": "I come down on the other side."},
        {"zh": "手里握着一小瓶东西。", "en": "A small vial in my hand."},
        {"zh": "砸在他脚边。", "en": "I throw it at his feet."},
        {"zh": "烟一下子起来了。", "en": "Smoke bursts up."},
        {"zh": "他咳得弯下腰。", "en": "He doubles over, coughing."},
        {"zh": "鹦鹉又扑了一次。", "en": "The parrot strikes again."},
        {"zh": "这次抓的是他的手。", "en": "This time it goes for his hands."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上掉下来，鹦鹉接住了我。", "en": "I fall out of the tree and the parrot catches me."},
        {"zh": "我们几乎一起落地。", "en": "We nearly hit the ground together."},
        {"zh": "它扇了两下翅膀才稳住。", "en": "Two beats and it steadies."},
        {"zh": "我抓住它的颈羽。", "en": "I grip its neck feathers."},
        {"zh": "这林子我不认识。", "en": "I do not know this wood."},
        {"zh": "鹦鹉也不认识。", "en": "Neither does the parrot."},
        {"zh": "它在原地转圈。", "en": "It turns in place."},
        {"zh": "我轻拍它的羽毛。", "en": "I pat its feathers."},
        {"zh": "先飞上去看看。", "en": "Let us go up and look."},
        {"zh": "它一跃，我们到了树冠上面。", "en": "One leap and we are above the canopy."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火星溅到我们身上，鹦鹉猛地抬高。", "en": "Sparks reach us and the parrot lurches upward."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我们从空中掉下去，树枝接了我们一下。", "en": "We fall and the branches catch us once."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我们掉进水里，鹦鹉的翅膀全湿了。", "en": "We hit the water and the parrot's wings soak through."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把鹦鹉掀翻，我差点脱手。", "en": "The blast flips the parrot and I nearly lose my grip."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过鹦鹉的翅。", "en": "An arrow passes through the parrot's wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光罩住我们，鹦鹉拍不动翅膀。", "en": "Strange light wraps us and the parrot cannot beat its wings."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "两天没吃东西，我抓不住它了。", "en": "Two days without food and I can barely hold on."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，鹦鹉和我一起僵住。", "en": "Lightning strikes and the parrot and I both lock up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "树林没了，我们在黑里下坠。", "en": "The wood is gone and we fall through black."}
      ]
    }
  }
}
