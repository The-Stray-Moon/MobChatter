{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步走过荒地。", "en": "I cross the waste step by step."},
        {"zh": "我的脚步几乎没有声音。", "en": "My steps make almost no sound."},
        {"zh": "我戴着一顶金冠。", "en": "I wear a golden crown."},
        {"zh": "冠上没有光，只有影子。", "en": "No light comes from it. Only shadow."},
        {"zh": "我走过的地方草会伏下去。", "en": "Grass lies flat where I pass."},
        {"zh": "我不看脚下。", "en": "I do not look down."},
        {"zh": "我朝着某个方向走。", "en": "I walk in a certain direction."},
        {"zh": "那个方向没有路。", "en": "There is no road that way."},
        {"zh": "我还是一样走。", "en": "I walk anyway."},
        {"zh": "风从我的袍子下面穿过去。", "en": "Wind passes under my robe."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我像石碑一样站着。", "en": "I stand like a stone marker."},
        {"zh": "我头上这顶金色王冠，很重。", "en": "This golden crown on my head is heavy."},
        {"zh": "连呼吸也没有。", "en": "Not even breath."},
        {"zh": "金冠压着我的额。", "en": "The golden crown weighs on my brow."},
        {"zh": "它非常沉重。", "en": "It is heavy."},
        {"zh": "我戴着金冠，冠上没有光。", "en": "I wear a gold crown, and it gives no light."},
        {"zh": "我仰头看天空。", "en": "I look up at the sky."},
        {"zh": "天上什么也没有。", "en": "There is nothing in the sky."},
        {"zh": "我重新低下头。", "en": "I lower my head again."},
        {"zh": "我仍在等着。", "en": "Still waiting."},
        {"zh": "等的时间比走的时间长。", "en": "Waiting lasts longer than walking."},
        {"zh": "这我一直知道。", "en": "I have always known that."},
        {"zh": "天使之冠，压在我头上。", "en": "The Angel's Crown weighs on my head."},
        {"zh": "我的袍子动了。", "en": "My robe stirs."},
        {"zh": "我没有动过。", "en": "I have not moved."},
        {"zh": "我从来不先动。", "en": "I never move first."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的影子碰到我的靴尖。", "en": "Your shadow touches the tip of my boot."},
        {"zh": "我金冠的边沿，在你眼里发亮。", "en": "The rim of my golden crown shines in your eyes."},
        {"zh": "金冠在你眼里很亮。", "en": "The crown is bright in your eyes."},
        {"zh": "你看不见我的脸。", "en": "You cannot see my face."},
        {"zh": "头冠下面都是阴影。", "en": "Shadow fills everything under it."},
        {"zh": "退吧，脚后跟别停。", "en": "Back away. Do not let your heels stop."},
        {"zh": "我不会怪罪你。", "en": "I do not blame you."},
        {"zh": "我举起手，又垂回身侧。", "en": "I raise my hand and let it fall to my side."},
        {"zh": "我并没有恶意。", "en": "I mean no harm."},
        {"zh": "但我也说不出好意。", "en": "But I cannot speak of goodwill either."},
        {"zh": "我只是在这儿。", "en": "I am simply here."},
        {"zh": "你要走就走吧。", "en": "Go if you will."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "冠下没有呼吸声。", "en": "No breath sounds beneath the crown."},
        {"zh": "我后撤了半步。", "en": "I draw back half a step."},
        {"zh": "金冠暗了一下。", "en": "The crown dims."},
        {"zh": "然后它又亮起。", "en": "Then brightens."},
        {"zh": "我按住胸口。", "en": "I press a hand to my chest."},
        {"zh": "那里有一股冷。", "en": "There is a cold there."},
        {"zh": "我一点点立直。", "en": "I straighten by degrees."},
        {"zh": "袍子上有破口。", "en": "There is a tear in my robe."},
        {"zh": "它会自己合上。", "en": "It will close itself."},
        {"zh": "我静静等着它。", "en": "I wait for it quietly."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不需要任何食物。", "en": "I need no food at all."},
        {"zh": "你举起那东西。", "en": "You raise that thing."},
        {"zh": "我看了看，又移开。", "en": "I look, then look away."},
        {"zh": "对我没有意义。", "en": "It means nothing to me."},
        {"zh": "我的金冠上，附了五重保护。", "en": "Five protections rest on my golden crown."},
        {"zh": "你的手会酸的。", "en": "Your arm will tire."},
        {"zh": "我抬手示意你放下。", "en": "I gesture for you to put it down."},
        {"zh": "你把它放下了。", "en": "You do."},
        {"zh": "如此便已经足矣。", "en": "That is enough."},
        {"zh": "我们都不必再提。", "en": "Neither of us need mention it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上的是冠下的铁。", "en": "You struck iron beneath the crown."},
        {"zh": "你往后退开了。", "en": "You pull back."},
        {"zh": "我的袍子被带起一角。", "en": "A corner of my robe lifts."},
        {"zh": "然后又垂落下来。", "en": "Then it falls again."},
        {"zh": "我垂下眼睛看。", "en": "I look down."},
        {"zh": "没有留下痕迹。", "en": "No mark remains."},
        {"zh": "我把脸转向你。", "en": "I turn my face to you."},
        {"zh": "金冠在头上，站稳了。", "en": "The gold crown is on my head, steady now."},
        {"zh": "那就再站一会儿。", "en": "Then stand a while longer."},
        {"zh": "我不赶走谁。", "en": "I do not drive anyone away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有那样的过去。", "en": "I have no such past."},
        {"zh": "或者说，我记不得了。", "en": "Or rather, I do not remember it."},
        {"zh": "金冠把我的记性压住了。", "en": "The crown presses my memory down."},
        {"zh": "我只记得要走。", "en": "I remember only that I must walk."},
        {"zh": "走到哪里，我不知道。", "en": "Where to, I do not know."},
        {"zh": "有人跟过我一段。", "en": "Someone followed me a while."},
        {"zh": "后来就不见了。", "en": "Then was gone."},
        {"zh": "我没有回头找。", "en": "I did not turn to look."},
        {"zh": "回头也找不到。", "en": "Looking would not have found them."},
        {"zh": "我继续独自前行。", "en": "I keep walking alone."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰，把它捡起来。", "en": "I bend and pick it up."},
        {"zh": "轻得几乎没有。", "en": "Very light."},
        {"zh": "我透过冠沿看它。", "en": "I look at it through the rim of my crown."},
        {"zh": "看不出是什么。", "en": "I cannot tell what it is."},
        {"zh": "它沉进袍子的褶里。", "en": "It sinks into the folds of my robe."},
        {"zh": "袍子里已经有几样了。", "en": "There are a few things in there already."},
        {"zh": "我都忘了是什么。", "en": "I have forgotten what they are."},
        {"zh": "可我都带着。", "en": "But I carry them."},
        {"zh": "这成了习惯。", "en": "It is a habit."},
        {"zh": "袍摆拖着，我继续走。", "en": "My hem drags. I keep walking."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "先动手的不是我。", "en": "It was not I who struck first."},
        {"zh": "那我也只能回应。", "en": "Then I must answer."},
        {"zh": "我把眼睛抬起来。", "en": "I lift my eyes."},
        {"zh": "金冠亮了一下。", "en": "The crown glints."},
        {"zh": "光从冠沿流下来。", "en": "Light runs down from its rim."},
        {"zh": "落在地上，变成一条线。", "en": "Falls to the ground, becomes a line."},
        {"zh": "那道线朝你去了。", "en": "The line goes toward you."},
        {"zh": "你跳到一边。", "en": "You leap aside."},
        {"zh": "它偏开了方向。", "en": "It veers off."},
        {"zh": "你没有料到。", "en": "You did not expect that."},
        {"zh": "我也没有料到。", "en": "Nor did I."},
        {"zh": "这东西不总听我的。", "en": "It does not always obey me."},
        {"zh": "可它还在那里。", "en": "But it is still here."},
        {"zh": "我把手抬到冠的高度。", "en": "I lift my hands to the height of the crown."},
        {"zh": "两条线一起出去。", "en": "Two lines go out."},
        {"zh": "你退开了两步，天使的金冠还在发光。", "en": "You backed two steps; the angel's golden crown still glows."},
        {"zh": "我把自己收住。", "en": "I check myself."},
        {"zh": "给你一点时间。", "en": "To give you time."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的脚还钉在原处。", "en": "My feet are still nailed where they were."},
        {"zh": "线在你脚边游。", "en": "The lines swim at your feet."},
        {"zh": "你往哪走，它们往哪去。", "en": "Wherever you go, they follow."},
        {"zh": "你踩它们，它们散开。", "en": "You step on them and they part."},
        {"zh": "然后又合上了。", "en": "Then close again."},
        {"zh": "这不是我在控制。", "en": "I am not controlling this."},
        {"zh": "动的是这顶冠。", "en": "The crown is moving."},
        {"zh": "冠压着我的额头。", "en": "The crown weighs on my brow."},
        {"zh": "你跑得很远了。", "en": "You run far."},
        {"zh": "线还在你脚边。", "en": "The lines are still at your feet."},
        {"zh": "它们不追得快。", "en": "They do not chase quickly."},
        {"zh": "可它们也不停。", "en": "But they do not stop."},
        {"zh": "你回头看我。", "en": "You look back at me."},
        {"zh": "我没有迈那一步。", "en": "I did not take that step."},
        {"zh": "我一直站在原地。", "en": "I have stood here all along."},
        {"zh": "线从我脚下出发。", "en": "The lines begin at my feet."},
        {"zh": "你跑不出它们的长度。", "en": "You cannot outrun their length."},
        {"zh": "你停下的地方正好。", "en": "You stopped at the right place."},
        {"zh": "那两条线也停了。", "en": "The lines stop too."},
        {"zh": "我这顶金冠，护得严实。", "en": "This golden crown shields me well."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一抬手，光从冠上落下。", "en": "I raise a hand and light falls from the crown."},
        {"zh": "落成一道很细的线。", "en": "It falls into a very fine line."},
        {"zh": "那道线扫过去。", "en": "The line sweeps."},
        {"zh": "你被扫中了。", "en": "It catches you."},
        {"zh": "身上有一道焦痕。", "en": "A scorch mark is left on you."},
        {"zh": "你被逼退两步。", "en": "You are driven back two steps."},
        {"zh": "我不追赶他们。", "en": "I do not chase them."},
        {"zh": "线还在你前面。", "en": "The line is still before you."},
        {"zh": "另一只手也抬起来。", "en": "The other hand rises too."},
        {"zh": "第二条线出现了。", "en": "A second line appears."},
        {"zh": "金冠上五级保护，打不透。", "en": "Five levels of protection on this gold crown."},
        {"zh": "它只是在那儿。", "en": "It is simply there."},
        {"zh": "你绕开第一条。", "en": "You go around the first."},
        {"zh": "撞上了第二条。", "en": "And meet the second."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在一片焦土上站着。", "en": "I stand on scorched earth."},
        {"zh": "醒来时只有这顶冠。", "en": "When I woke, only this crown was with me."},
        {"zh": "金冠在我头上。", "en": "The golden crown is on my head."},
        {"zh": "它一直都戴着。", "en": "It has always been there."},
        {"zh": "我抬手碰了碰它。", "en": "I touch it."},
        {"zh": "摸上去很凉。", "en": "Very cold."},
        {"zh": "风把灰吹到我脚边。", "en": "Wind blows ash to my feet."},
        {"zh": "我把脸仰起来。", "en": "I lift my face."},
        {"zh": "天压得很低。", "en": "The sky is low."},
        {"zh": "这里没有太阳。", "en": "There is no sun."},
        {"zh": "只有一片灰白。", "en": "Only a grey-white wash."},
        {"zh": "我朝前面走去。", "en": "I walk forward."},
        {"zh": "哪一边都一样。", "en": "Every direction is the same."},
        {"zh": "可我总得走。", "en": "But I must walk."},
        {"zh": "脚自己会动。", "en": "My feet move on their own."},
        {"zh": "我就跟着它们。", "en": "I follow them."},
        {"zh": "走了一小段路。", "en": "A little way."},
        {"zh": "前面有个东西。", "en": "There is something ahead."},
        {"zh": "像是个人形。", "en": "A human shape."},
        {"zh": "我顿住了脚。", "en": "I halt my feet."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烧过来，金冠挡住了大半。", "en": "Fire comes, and the crown takes most of it."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下，土被砸出一个坑。", "en": "I fall from height and leave a crater."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水没过头，我的袍子变重了。", "en": "Water closes over me and my robe grows heavy."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸响后我退了几步，冠上有裂纹。", "en": "After the blast I step back, and the crown is cracked."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭停在我面前，然后落下。", "en": "An arrow halts before me, then falls."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "另一股力量撞在金冠上，冠在响。", "en": "Another force strikes the crown and it rings."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "太久没有走动，我的形在变淡。", "en": "Too long without walking, and I fade."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下来，冠把光吸了进去。", "en": "Lightning falls and the crown drinks it."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "脚下的土没了，我一直在落。", "en": "The ground is gone and I keep falling."}
      ]
    }
  }
}
