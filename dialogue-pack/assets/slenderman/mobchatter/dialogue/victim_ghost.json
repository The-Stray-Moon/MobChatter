{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "破衣角在林子里拖着。", "en": "Torn cloth trails through the wood."},
        {"zh": "我沿着树影晃过去。", "en": "I waver along the tree shadows."},
        {"zh": "我走过的地方有点凉。", "en": "It turns cold where I pass."},
        {"zh": "雾跟着我一起移动。", "en": "The fog moves with me."},
        {"zh": "我的影子比身体淡。", "en": "My shadow is fainter than my body."},
        {"zh": "我从树干里穿过去。", "en": "I pass through a trunk."},
        {"zh": "我飘得很慢，像在找路。", "en": "I drift slowly, as if looking for the way."},
        {"zh": "风推我，我就跟着走。", "en": "The wind pushes, and I go with it."},
        {"zh": "我的脸是模糊的。", "en": "My face is indistinct."},
        {"zh": "树叶在我身边翻过来。", "en": "Leaves turn over beside me."},
        {"zh": "我绕着同一棵树转圈。", "en": "I circle the same tree."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我就飘在原地不动。", "en": "I hang here without moving."},
        {"zh": "雾在我身上聚起来。", "en": "Fog gathers on me."},
        {"zh": "我听见林子在呼吸。", "en": "I hear the forest breathing."},
        {"zh": "我已经很累了。", "en": "I am already so tired."},
        {"zh": "这点光，能穿过我。", "en": "That light passes through me."},
        {"zh": "我把脑袋垂下来。", "en": "I let my head droop."},
        {"zh": "我的声音很轻。", "en": "My voice is very thin."},
        {"zh": "书页翻完了，我还没走。", "en": "The pages are all turned, and I'm still here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你能看得见我。", "en": "You can see me."},
        {"zh": "你也是被留下的吗。", "en": "Were you left behind too?"},
        {"zh": "我的名字不见了。", "en": "My name is gone."},
        {"zh": "你别走得太快。", "en": "Do not walk so fast."},
        {"zh": "这地方很冷吧。", "en": "It is cold here, is it not?"},
        {"zh": "我死在这片林子里。", "en": "I died in this forest."},
        {"zh": "你听见风了吗。", "en": "Do you hear the wind?"},
        {"zh": "你手上的那东西，我认得。", "en": "I know that thing in your hand."},
        {"zh": "再往我这边来点。", "en": "A little closer to me."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这疼，是很久以前的。", "en": "This pain is from long ago."},
        {"zh": "我的身体散了一会儿。", "en": "My body scattered for a moment."},
        {"zh": "冷风从身上穿过。", "en": "Cold wind passes through me."},
        {"zh": "我退了半步，飘着退。", "en": "I retreat half a step, drifting."},
        {"zh": "你打得动我，很奇怪。", "en": "That you can hit me is strange."},
        {"zh": "我的衣角破了。", "en": "My hem is torn."},
        {"zh": "这没什么关系。", "en": "It does not matter."},
        {"zh": "别这样对待我。", "en": "Do not treat me so."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那张纸片给我。", "en": "Give me that scrap of paper."},
        {"zh": "你带着我的东西。", "en": "You carry something of mine."},
        {"zh": "那一点光很暖。", "en": "That little light is warm."},
        {"zh": "别把它拿走了。", "en": "Do not take it away."},
        {"zh": "我认得那股气。", "en": "I know that presence."},
        {"zh": "放手，让我看看。", "en": "Let go. Let me see."},
        {"zh": "我很久没有摸到实物了。", "en": "I have not touched anything solid in ages."},
        {"zh": "你还拿着我的魂吗。", "en": "Are you holding my soul still?"},
        {"zh": "给我一页也行。", "en": "Even one page would do."},
        {"zh": "放下，我就能安睡。", "en": "Set it down and I could rest."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你整个人穿过了我。", "en": "You passed right through me."},
        {"zh": "我让开了一点。", "en": "I gave a little way."},
        {"zh": "你的肩膀很暖。", "en": "Your shoulder is warm."},
        {"zh": "我没有撞到你，是你撞进来。", "en": "I did not hit you. You came through me."},
        {"zh": "地上有我的旧衣角。", "en": "A corner of my old clothes is on the ground."},
        {"zh": "我退到树后了。", "en": "I withdrew behind the tree."},
        {"zh": "风把我们分开。", "en": "The wind separated us."},
        {"zh": "我们不必碰在一起。", "en": "We need not touch."},
        {"zh": "我在这里，也在别处。", "en": "I am here, and elsewhere."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经是个死人了。", "en": "I am already dead."},
        {"zh": "以前的事，我不记得。", "en": "I do not remember before."},
        {"zh": "你别停留太久。", "en": "Do not stay long."},
        {"zh": "我连自己的脸都看不清。", "en": "I cannot even see my own face."},
        {"zh": "真的很对不起你。", "en": "I am truly sorry."},
        {"zh": "我该离开这里了。", "en": "I should leave this place."},
        {"zh": "这片林子不收留这些。", "en": "This forest keeps no such things."},
        {"zh": "我等着的是别的事。", "en": "I wait for something else."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手，抓不住。", "en": "I reach, and cannot hold."},
        {"zh": "这东西从我手里滑下去。", "en": "It slips through my hand."},
        {"zh": "我只能碰一点点。", "en": "I can touch only a little."},
        {"zh": "一片枯叶，我留不住。", "en": "A dead leaf. I cannot keep it."},
        {"zh": "它落在地上，我看到了。", "en": "It fell. I saw it."},
        {"zh": "我捡过很多次，都失败了。", "en": "I have tried to pick things up many times."},
        {"zh": "我的手是凉的。", "en": "My hands are cold."},
        {"zh": "这一页，是书里的。", "en": "This page belongs to a book."},
        {"zh": "你就把它拿走吧。", "en": "Just take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你别离开这儿。", "en": "Do not leave here."},
        {"zh": "你身上有那个人的气味。", "en": "You carry that one's scent."},
        {"zh": "我已经瞧见你了。", "en": "I have caught sight of you."},
        {"zh": "那本剑，你别用。", "en": "Do not use that sword."},
        {"zh": "面具能挡住他，也能挡住我。", "en": "That mask stops him, and me."},
        {"zh": "我认得林子的每一页。", "en": "I know every page in this forest."},
        {"zh": "你不是那个人。", "en": "You are not him."},
        {"zh": "你身上带着碎片。", "en": "You carry fragments."},
        {"zh": "我要那些碎片。", "en": "I want those fragments."},
        {"zh": "你被我记着了。", "en": "I have you noted."},
        {"zh": "来，靠近一点儿。", "en": "Come. A little nearer."},
        {"zh": "这不是威胁，是请求。", "en": "This is not a threat. It is a plea."},
        {"zh": "你看，雾收起来了。", "en": "Look, the fog is closing."},
        {"zh": "别再让他醒过来。", "en": "Do not let him wake again."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你一起飘。", "en": "I drift along with you."},
        {"zh": "你走一步，雾近一步。", "en": "One step of yours, the fog comes closer."},
        {"zh": "我认得你的呼吸。", "en": "I know your breathing."},
        {"zh": "那剑上有我的名字。", "en": "My name is on that sword."},
        {"zh": "别把它拔出来。", "en": "Do not draw it."},
        {"zh": "我飘得慢也没关系。", "en": "It does not matter that I drift slowly."},
        {"zh": "雾把路藏起来了。", "en": "The fog has hidden the path."},
        {"zh": "你听见有人哭吗。", "en": "Do you hear someone crying?"},
        {"zh": "我不想伤到你。", "en": "I do not want to hurt you."},
        {"zh": "把那些碎片放下。", "en": "Put those fragments down."},
        {"zh": "再走几步，就到我的树了。", "en": "A few steps more and we reach my tree."},
        {"zh": "你的手抖个不停。", "en": "Your hands will not stop shaking."},
        {"zh": "别回头，他在远处。", "en": "Do not look back. He is far off."},
        {"zh": "就这样，站住了。", "en": "Just like that. Stand still."},
        {"zh": "很好，就站在这儿。", "en": "Good. Stand right here."},
        {"zh": "就是这时候了。", "en": "This is the moment."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "冷从你手臂上爬过去。", "en": "Cold crawls up your arm."},
        {"zh": "我的手指穿过你的甲。", "en": "My fingers pass into your armor."},
        {"zh": "这一下没有重量，却很疼。", "en": "No weight, yet it hurts."},
        {"zh": "你听到的是你自己的呼吸。", "en": "What you hear is your own breath."},
        {"zh": "我的声音贴在你耳边。", "en": "My voice is at your ear."},
        {"zh": "你退了，我没有追。", "en": "You retreat. I do not chase."},
        {"zh": "我的冷手，从你背后拍下。", "en": "My cold hand lands from behind you."},
        {"zh": "你身上起了霜。", "en": "Frost forms on you."},
        {"zh": "别让我再抓第二次。", "en": "Do not make me grasp again."},
        {"zh": "你看，我留不住东西。", "en": "See? I cannot hold on to anything."},
        {"zh": "你放下那个，我就停。", "en": "Put that down and I will stop."},
        {"zh": "雾又变得很厚。", "en": "The fog has thickened again."},
        {"zh": "别再靠近我了。", "en": "Do not come nearer."},
        {"zh": "就这样算了吧。", "en": "Let it be."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "他从我身上穿过去。", "en": "He passed through me."},
        {"zh": "我终于能飘起来了。", "en": "I can drift at last."},
        {"zh": "林子安静了一下。", "en": "The forest fell silent for a moment."},
        {"zh": "我死在这里，也没走远。", "en": "I died here, and never went far."},
        {"zh": "我的衣服还是那天的。", "en": "My clothes are still from that day."},
        {"zh": "雾先来了，我才来。", "en": "The fog came first, then I."},
        {"zh": "你杀了那个东西。", "en": "You killed that thing."},
        {"zh": "我终于不用再等了。", "en": "I no longer have to wait."},
        {"zh": "别踩着我的叶子。", "en": "Do not step on my leaves."},
        {"zh": "我的手里还有一点东西。", "en": "There is still something in my hand."},
        {"zh": "你要不要拿走。", "en": "Will you take it?"},
        {"zh": "我在林子里走了很久。", "en": "I have walked this forest a long while."},
        {"zh": "带我离开这里吧。", "en": "Take me out of here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火照得我发白。", "en": "Fire bleaches me white."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有重量，落地也不响。", "en": "I have no weight. My fall makes no sound."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水从我身上穿过去。", "en": "Water passes through me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我吹散了，又聚回来。", "en": "The blast scatters me, and I return."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭扎在我胸口，晃了晃。", "en": "An arrow hangs in my chest, swaying."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这光让我想起自己的脸。", "en": "This light reminds me of my face."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "电把我照得通亮。", "en": "Lightning lights me up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面很黑，和这里一样。", "en": "The dark below is like the dark here."}
      ]
    }
  }
}
