{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嗡嗡声不断，翅膀摩擦作响。", "en": "Buzzing continuously, wings rub together."},
        {"zh": "缓慢前行，腹部轻颤。", "en": "Moves slowly, abdomen quivers gently."},
        {"zh": "寻找新的巢穴，四处游荡。", "en": "Searches for new nests, wanders around."},
        {"zh": "警惕四周，似乎有所察觉。", "en": "Alert, seems to sense something."},
        {"zh": "发出轻微警告声，准备防御。", "en": "Issues a light warning buzz, readying for defense."},
        {"zh": "腹部快速震动，释放毒液。", "en": "Abdomen shakes rapidly, releasing venom."},
        {"zh": "发现猎物，盯紧目标。", "en": "Locks onto prey, eyes fixed."},
        {"zh": "飞行中，偶尔发出低鸣。", "en": "Buzzes softly while flying."},
        {"zh": "我绕着你的灯盘旋。", "en": "I circle the light you carry."},
        {"zh": "腹部轻颤，发出警告声。", "en": "Abdomen quivers, issuing a warning buzz."},
        {"zh": "六足悬空，缓缓漂移。", "en": "Six legs dangling, I drift slowly."},
        {"zh": "振翅擦出细碎声响。", "en": "My wings scrape out a thin, dry sound."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "雾在我身下慢慢流。", "en": "Fog flows slowly beneath me."},
        {"zh": "腹部轻颤，似乎在思考。", "en": "Abdomen quivers, seemingly thinking."},
        {"zh": "偶尔抖动翅膀，保持平衡。", "en": "Occasionally flutters wings for balance."},
        {"zh": "与玩家保持一定距离。", "en": "Keeps a distance from the player."},
        {"zh": "观察周围的环境，寻找机会。", "en": "Observes the surroundings, looking for opportunities."},
        {"zh": "腹部轻微颤动，似乎在等待。", "en": "Abdomen trembles slightly, waiting."},
        {"zh": "保持悬浮状态，不动声色。", "en": "Remains suspended, silent."},
        {"zh": "偶尔发出轻微的嗡嗡声。", "en": "Emits a light buzzing sound occasionally."},
        {"zh": "悬浮不动，警惕四周。", "en": "Suspends motion, alert to surroundings."},
        {"zh": "腹部轻微颤动，似乎在准备。", "en": "Abdomen trembles slightly, preparing."},
        {"zh": "我停在半空，雾绕着我转。", "en": "I hang midair while fog curls around me."},
        {"zh": "复眼映着无人的雾。", "en": "My compound eyes mirror the empty fog."},
        {"zh": "翅膀停歇，只剩嗡鸣。", "en": "Wings resting, only a hum remains."},
        {"zh": "我在此，只为观察。", "en": "I am here only to observe."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "直视玩家，眼中充满警惕。", "en": "Fixes gaze on the player, eyes full of alertness."},
        {"zh": "腹部快速颤动，准备行动。", "en": "Abdomen rapidly trembles, readying to act."},
        {"zh": "盯紧玩家，寻找弱点。", "en": "Steadies gaze on the player, searching for weaknesses."},
        {"zh": "向玩家方向微微移动。", "en": "Subtly moves towards the player."},
        {"zh": "腹部微微颤动，发出警告声。", "en": "Abdomen quivers, issuing a warning sound."},
        {"zh": "紧盯着玩家，仿佛能洞悉一切。", "en": "Stares intently at the player, as if perceiving everything."},
        {"zh": "腹部轻微颤动，似乎在思考对策。", "en": "Abdomen trembles, seemingly formulating a strategy."},
        {"zh": "我只是看着，不动手。", "en": "I only observe; I don't strike."},
        {"zh": "腹部快速震动，释放警报。", "en": "Abdomen shakes rapidly, issuing an alarm."},
        {"zh": "盯着玩家，不放过任何细节。", "en": "Stares at the player, scrutinizing every detail."},
        {"zh": "你不该看见我。", "en": "You were not meant to see me."},
        {"zh": "盯得太久，雾会变浓。", "en": "Stare too long and the fog thickens."},
        {"zh": "我的复眼记住了你。", "en": "My many eyes have memorized you."},
        {"zh": "你身后没有别人，对吗？", "en": "There is no one behind you, is there?"},
        {"zh": "灯光熄灭时，我在看你。", "en": "When the lights go out, I am watching."},
        {"zh": "我数着你胸腔的起伏。", "en": "I count the rise and fall of your chest."},
        {"zh": "别回头，我就在这。", "en": "Do not look back. I am right here."},
        {"zh": "你也听见那声音了吗？", "en": "Did you hear that sound too?"},
        {"zh": "我隔着雾看你。", "en": "I watch you through the fog."},
        {"zh": "你不是这里唯一的眼睛。", "en": "You are not the only eyes here."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀被撕破了...", "en": "My wings are torn..."},
        {"zh": "能量渐渐流失...", "en": "Energy fades..."},
        {"zh": "我的翅膀变得沉重...", "en": "My wings feel heavy..."},
        {"zh": "我只是漂着，看着，不追你。", "en": "I just drift and watch. I don't chase."},
        {"zh": "我受了致命伤...", "en": "I'm mortally wounded..."},
        {"zh": "我虚弱得不行...", "en": "I'm too weak..."},
        {"zh": "我的形体开始变稀薄。", "en": "My form begins to thin out."},
        {"zh": "我的力量逐渐耗尽...", "en": "My strength wanes..."},
        {"zh": "我快要倒下了...", "en": "I'm collapsing..."},
        {"zh": "我无法继续前行...", "en": "I can't move..."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "腐肉的香味吸引着我。", "en": "The stench of decay draws me."},
        {"zh": "我能闻到猎物的味道。", "en": "Prey is close, I can smell it."},
        {"zh": "雾里有食物的味道。", "en": "There's food somewhere in the fog."},
        {"zh": "这盏灯下面太亮了。", "en": "It is too bright beneath this lamp."},
        {"zh": "这里的食物不够了。", "en": "Food here is scarce."},
        {"zh": "饥饿驱使我寻找食物。", "en": "Hunger drives me to seek food."},
        {"zh": "腐肉让我充满力量。", "en": "Decay fuels my strength."},
        {"zh": "我需要更多腐肉补充能量。", "en": "More decay to sustain me."},
        {"zh": "腐肉是我唯一的依赖。", "en": "Decay is my sole reliance."},
        {"zh": "你身上有腐肉的味道。", "en": "You carry the smell of carrion."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我与同伴发生了碰撞。", "en": "I collided with a compatriot."},
        {"zh": "碰撞让我注意到了危险。", "en": "Collision alerted me to danger."},
        {"zh": "我与另一只生物撞到了一起。", "en": "I collided with another entity."},
        {"zh": "碰撞让我注意到了新的同伴。", "en": "Collision introduced a new comrade."},
        {"zh": "碰撞中我发现了新的方向。", "en": "Collision revealed a new path."},
        {"zh": "碰撞导致我改变了方向。", "en": "Collision redirected my path."},
        {"zh": "碰撞使我的感官更加敏锐。", "en": "Collision sharpened my senses."},
        {"zh": "碰撞中的我更加警觉。", "en": "Collision heightened my vigilance."},
        {"zh": "碰撞后我开始移动。", "en": "Collision prompted my movement."},
        {"zh": "碰撞中我避开了危险。", "en": "Collision averted danger."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "求偶的声音回荡着。", "en": "Mating calls echo."},
        {"zh": "我浮着求偶，翅膜一开一合。", "en": "I court while floating, wing membranes opening and closing."},
        {"zh": "我飘着看你，不用眼。", "en": "I drift and watch you without eyes."},
        {"zh": "我的求偶声吸引了对方。", "en": "My call attracted the other."},
        {"zh": "我们之间的求偶仪式开始了。", "en": "Our mating ritual began."},
        {"zh": "求偶声传遍了这片区域。", "en": "Mating calls filled the area."},
        {"zh": "我的求偶声传给了远方的伴侣。", "en": "My call reached my distant mate."},
        {"zh": "求偶的声音引导着我。", "en": "Mating calls guided me."},
        {"zh": "我的求偶声回荡在寂静中。", "en": "My call echoed in the silence."},
        {"zh": "求偶声中充满了期待。", "en": "Mating calls held hope."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "在这片黑暗中觅食真不易。", "en": "Feeding in darkness is hard."},
        {"zh": "腐肉滋养了我的成长。", "en": "Decay feeds my growth."},
        {"zh": "腐烂的果实，我的猎物。", "en": "Decaying fruit, my prey."},
        {"zh": "这腐烂之地是我的领地。", "en": "This decayed land is mine."},
        {"zh": "腐烂，是我的食物。", "en": "Decay, my sustenance."},
        {"zh": "腐朽之物，滋养我魂。", "en": "Decay nourishes my soul."},
        {"zh": "腐烂的根源，我的养分。", "en": "Decay's source, my sustenance."},
        {"zh": "腐烂之地，我唯一的家。", "en": "Decay’s home, my only abode."},
        {"zh": "腐烂的果实，我的盛宴。", "en": "Decay’s fruits, my feast."},
        {"zh": "腐烂的角落，我的居所。", "en": "Decay’s corner, my home."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "雾里有一盏没灭的灯。", "en": "One lamp still burns in the fog."},
        {"zh": "雾深处多了一个体温。", "en": "A new body heat appears deep in the fog."},
        {"zh": "这气味不对。", "en": "That smell's wrong."},
        {"zh": "这声音很可疑。", "en": "That sound's suspicious."},
        {"zh": "我只是被留下来观察。", "en": "I was only left here to observe."},
        {"zh": "猎物的气息出现了。", "en": "Prey's scent appears."},
        {"zh": "这动静不是我猎物的。", "en": "That noise's not prey's."},
        {"zh": "猎物的味道很强烈。", "en": "Prey's scent's strong."},
        {"zh": "那股气味拐进了死巷。", "en": "That scent turned into a dead-end alley."},
        {"zh": "猎物的气息就在附近。", "en": "Prey's scent's nearby."},
        {"zh": "雾里有动静。", "en": "Something stirs in the fog."},
        {"zh": "那不是风声。", "en": "That is not the wind."},
        {"zh": "我听到了呼吸。", "en": "I heard breathing."},
        {"zh": "脚步停在洞窟里。", "en": "Footsteps stopped in the cave."},
        {"zh": "有人点了灯。", "en": "Someone lit a lamp."},
        {"zh": "猎物自己走进来了。", "en": "The prey walked in on its own."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我就飘着，看你怎么走。", "en": "I just float here and watch where you go."},
        {"zh": "我只是被留下来观察的那一只。", "en": "I am the one left behind to observe."},
        {"zh": "这味道越来越浓。", "en": "Scent grows stronger."},
        {"zh": "猎物越来越接近。", "en": "Prey grows closer."},
        {"zh": "猎物的气息很清晰。", "en": "Prey's scent's clear."},
        {"zh": "猎物的味道越来越明显。", "en": "Prey's scent's clear."},
        {"zh": "我只漂着看，不动手。", "en": "I just drift and watch — I don't strike."},
        {"zh": "你的汗味在雾里散开。", "en": "Your sweat spreads through the fog."},
        {"zh": "我只是来看，不伸手。", "en": "I only came to watch. I won't reach out."},
        {"zh": "猎物的气息就在眼前。", "en": "Scent's in front."},
        {"zh": "别动，让我看清。", "en": "Hold still. Let me see you."},
        {"zh": "我的轮廓贴在你脚边。", "en": "My outline hugs your feet."},
        {"zh": "距离刚好，够近了。", "en": "Close enough. Too close."},
        {"zh": "你退一步，雾就进一寸。", "en": "You step back, the fog creeps in an inch."},
        {"zh": "雾合拢了，你没路。", "en": "The fog closes. No way out."},
        {"zh": "嗡鸣声绕着你转。", "en": "The humming circles around you."},
        {"zh": "你听见翅膀了吗？", "en": "Do you hear the wings?"},
        {"zh": "我不用追，你会停下。", "en": "I need not chase. You will stop."},
        {"zh": "四周安静得不正常。", "en": "It is far too quiet around you."},
        {"zh": "我就在你的余光里。", "en": "I am in the corner of your eye."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，逼近！", "en": "Sssss, approaching!"},
        {"zh": "蠕动的身体逼近！", "en": "Moving body approaching!"},
        {"zh": "我伸出雾一样的肢。", "en": "I reach out a limb of fog."},
        {"zh": "饥饿驱使我攻击！", "en": "Hunger drives me to attack!"},
        {"zh": "靠近，让我吞噬你！", "en": "Close, I will consume you!"},
        {"zh": "触感，那是猎物！", "en": "Tactile, that’s prey!"},
        {"zh": "触手缠绕，你无法逃脱！", "en": "Touching hands bind, no escape!"},
        {"zh": "我伸出枝条似的手。", "en": "I stretch out a branch-like hand."},
        {"zh": "猎物的味道如此甜美！", "en": "Prey tastes so sweet!"},
        {"zh": "靠近，享受我的盛宴！", "en": "Come, enjoy my feast!"},
        {"zh": "翅膀扫过你的脸。", "en": "A wing brushes your face."},
        {"zh": "不是撕咬，只是触碰。", "en": "Not a bite. Only a touch."},
        {"zh": "六足扣住你的肩。", "en": "Six legs clamp onto your shoulder."},
        {"zh": "我把你按进雾里。", "en": "I press you down into the fog."},
        {"zh": "别怕，一下就好。", "en": "Do not fear. This takes a moment."},
        {"zh": "我的体温比雾还低。", "en": "My body is colder than the fog."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "灯灭时我刚好成形。", "en": "I take shape just as the light dies."},
        {"zh": "从阴影中诞生！", "en": "Born from shadows!"},
        {"zh": "腐烂之地，我存在！", "en": "腐烂之地, I exist!"},
        {"zh": "从废墟中诞生！", "en": "Born from ruins!"},
        {"zh": "在黑暗中我复苏！", "en": "In darkness, I rise!"},
        {"zh": "阴影中，我现身！", "en": "Shadow, I appear!"},
        {"zh": "腐烂之地，我降生！", "en": "腐烂之地, I am born!"},
        {"zh": "废墟中，我苏醒！", "en": "Ruins, I awaken!"},
        {"zh": "从尘埃中，我重生！", "en": "From dust, I am reborn!"},
        {"zh": "我只是被摆在这里看的。", "en": "I am only placed here to be watched."},
        {"zh": "雾里多了一双不属于我的眼睛。", "en": "An eye that isn't mine is in the fog."},
        {"zh": "灯灭了，我到了。", "en": "The lamp died. I arrived."},
        {"zh": "无人的世界，我来了。", "en": "A world without people. I come."},
        {"zh": "洞穴深处传来嗡鸣。", "en": "A hum rises from the deep cave."},
        {"zh": "我从空无一人的地方来。", "en": "I come from a place with no one left."},
        {"zh": "这里只有我和你。", "en": "There is only you and me here."},
        {"zh": "声音停下时，我出现。", "en": "When the sound stops, I appear."},
        {"zh": "风停了，轮到我。", "en": "The wind stopped. My turn."},
        {"zh": "我顺着回声飘出来。", "en": "I drift out along the echo."},
        {"zh": "雾散之前，我已在此。", "en": "Before the fog lifts, I am here."}
      ]
    },
