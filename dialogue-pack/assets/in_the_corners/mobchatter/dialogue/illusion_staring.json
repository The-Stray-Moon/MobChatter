{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走在你影子的位置上", "en": "I walk where your shadow should be."},
        {"zh": "我跟在你半步之后", "en": "I keep half a step behind you."},
        {"zh": "我模仿你的步子", "en": "I copy your stride."},
        {"zh": "我走过镜子前面", "en": "I pass before the mirror."},
        {"zh": "镜子里的人没跟上", "en": "The one in the mirror didn't follow."},
        {"zh": "我一步步变成你的样子", "en": "Step by step I become you."},
        {"zh": "我走得比你快一点", "en": "I walk a little faster."},
        {"zh": "我的动作比你慢半拍", "en": "My movements lag half a beat."},
        {"zh": "我走在没人的地方", "en": "I walk where no one is."},
        {"zh": "你走了多久，我就走了多久", "en": "I've walked as long as you have."},
        {"zh": "我在你前面等着", "en": "I'm waiting ahead."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在你身后不动", "en": "I stand behind you, motionless."},
        {"zh": "我学着你的姿势", "en": "I take on your posture."},
        {"zh": "你怕的东西我记下了", "en": "I've noted what frightens you."},
        {"zh": "我不出声，只看", "en": "I make no sound; I only look."},
        {"zh": "这房间安静得不像话", "en": "This room is impossibly quiet."},
        {"zh": "我不必亲自动手", "en": "I needn't lift a hand."},
        {"zh": "你自己会想到它", "en": "You'll think of it yourself."},
        {"zh": "我等着你回头", "en": "I wait for you to look back."},
        {"zh": "我一直在你旁边", "en": "I've been beside you the whole time."},
        {"zh": "你认得这张脸吗", "en": "Do you know this face?"},
        {"zh": "我只是让它显出来", "en": "I only let it show."},
        {"zh": "再站一会儿也行", "en": "A while longer is fine."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你刚才看见了吗", "en": "Did you see it just now?"},
        {"zh": "那是你熟悉的脸", "en": "That's a face you know."},
        {"zh": "我什么也没做", "en": "I've done nothing."},
        {"zh": "你自己想到的，不是我说的", "en": "You thought of it; I didn't say it."},
        {"zh": "你怕的那个东西在我身后", "en": "What you fear is behind me."},
        {"zh": "看清楚了再说", "en": "Look closely before you speak."},
        {"zh": "这不是幻觉吗", "en": "Isn't this an illusion?"},
        {"zh": "我不杀你，我让你自己想。", "en": "I do not kill you; I let you think."},
        {"zh": "它对你没有用的", "en": "It won't help you."},
        {"zh": "你眼睛里的东西比我可怕", "en": "What's in your eyes frightens me more."},
        {"zh": "你听，有人叫你名字", "en": "Listen; someone's calling your name."},
        {"zh": "那声音你认得", "en": "You know that voice."},
        {"zh": "我一句话没说", "en": "I didn't say a word."},
        {"zh": "你回过头看看", "en": "Turn around and look."},
        {"zh": "我从不加害于人", "en": "I never harm anyone."},
        {"zh": "你自己会走进去的", "en": "You'll walk into it yourself."},
        {"zh": "心里那件事，你一直没放下", "en": "You never let that thing go."},
        {"zh": "这里没有别人", "en": "There's no one else here."},
        {"zh": "你看见的只有你自己", "en": "All you see is yourself."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打到的是影子", "en": "You struck a shadow."},
        {"zh": "这一下没让我受伤", "en": "That didn't wound me."},
        {"zh": "你终于动手了", "en": "You finally lashed out."},
        {"zh": "你怕的东西变强了", "en": "What you fear has grown stronger."},
        {"zh": "我退开了一点", "en": "I've drawn back a little."},
        {"zh": "你的手怎么了", "en": "What happened to your hand?"},
        {"zh": "你也伤到了自己", "en": "You hurt yourself too."},
        {"zh": "这不能算你赢", "en": "This doesn't count as winning."},
        {"zh": "我依然还在这里", "en": "I'm still here."},
        {"zh": "你看，你又在发抖", "en": "See, you're shaking again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你拿东西挡不住它", "en": "Nothing you hold can block it."},
        {"zh": "你握着的东西不真", "en": "What you grip isn't real."},
        {"zh": "那不是你的恐惧", "en": "That isn't your fear."},
        {"zh": "你手里握得再紧也没用", "en": "Gripping it tighter won't help."},
        {"zh": "它会自己回来", "en": "It comes back on its own."},
        {"zh": "别用东西分散自己", "en": "Don't distract yourself with things."},
        {"zh": "那个我也见过", "en": "I've seen that thing too."},
        {"zh": "把它放在镜子前", "en": "Put it before the mirror."},
        {"zh": "你怕的不是它", "en": "It isn't that you're afraid of."},
        {"zh": "你只是在拖延", "en": "You're only stalling."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你还能感觉到我", "en": "You can still feel me."},
        {"zh": "这不是真的碰撞", "en": "This isn't a real collision."},
        {"zh": "你的手穿过去了一点", "en": "Your hand passed partly through."},
        {"zh": "我借了你的形状", "en": "I borrowed your shape."},
        {"zh": "我们两个重叠了", "en": "We overlapped."},
        {"zh": "你闻到的味道是你自己的", "en": "The smell you notice is your own."},
        {"zh": "这不疼，对吗", "en": "It doesn't hurt, does it?"},
        {"zh": "刚才那一下你没看见", "en": "You didn't see that one."},
        {"zh": "这一次是真的", "en": "This time it's real."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "你想让我变成谁", "en": "Who would you have me be?"},
        {"zh": "那也不是真实的", "en": "That wouldn't be real either."},
        {"zh": "你自己也分不清了", "en": "You can't tell anymore."},
        {"zh": "我只想让你看清", "en": "I only want you to see clearly."},
        {"zh": "别把幻象当作依靠", "en": "Don't lean on an illusion."},
        {"zh": "那是你自己的脸", "en": "That's your own face."},
        {"zh": "这一点我做不到", "en": "I can't do that."},
        {"zh": "你看着我就行", "en": "Just look at me."},
        {"zh": "别让我看见那种脸", "en": "Don't show me that face."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抓到的不是实体", "en": "What you grab isn't solid."},
        {"zh": "这样抱着我，你会更怕", "en": "Holding me will frighten you more."},
        {"zh": "我的重量是你的想象", "en": "My weight is your imagining."},
        {"zh": "你手心里是空的", "en": "Your palm is empty."},
        {"zh": "别把我带回去", "en": "Don't take me home."},
        {"zh": "我在你怀里变了形", "en": "I've changed shape in your arms."},
        {"zh": "这不是你想要的东西", "en": "This isn't what you wanted."},
        {"zh": "搁在镜子前面", "en": "Set it before the mirror."},
        {"zh": "你抱得太紧了", "en": "You're holding too tight."},
        {"zh": "你已经在做梦了", "en": "You're already dreaming."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于看见了", "en": "You finally see it."},
        {"zh": "现在它就在你面前", "en": "Now it's right in front of you."},
        {"zh": "我不会动手的", "en": "I won't strike."},
        {"zh": "你自己会崩溃的", "en": "You'll come apart on your own."},
        {"zh": "那是你一直想忘的东西", "en": "That's what you've wanted to forget."},
        {"zh": "它知道你叫什么", "en": "It knows your name."},
        {"zh": "你已经走近了", "en": "You've come closer."},
        {"zh": "它在叫你的名字", "en": "It's calling your name."},
        {"zh": "我没有推过你", "en": "I never pushed you."},
        {"zh": "这一步是你自己迈的", "en": "You took that step yourself."},
        {"zh": "你退不回去了", "en": "You can't go back."},
        {"zh": "看着它别动弹", "en": "Look at it. Don't move."},
        {"zh": "那是你记忆里的脸", "en": "That's a face from your memory."},
        {"zh": "它一直在这儿", "en": "It's always been here."},
        {"zh": "现在，认出来了吗", "en": "Now. Do you recognize it?"},
        {"zh": "不要闭上眼睛", "en": "Don't close your eyes."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我就站在幻象边上", "en": "I stand at the illusion's edge."},
        {"zh": "你看见的比真实的多", "en": "You see more than is there."},
        {"zh": "它在模仿你熟悉的人", "en": "It's imitating someone you know."},
        {"zh": "你的脚步慢了", "en": "Your steps have slowed."},
        {"zh": "你开始怀疑自己的眼睛", "en": "You're starting to doubt your eyes."},
        {"zh": "那扇门刚才还在这", "en": "That door was here a moment ago."},
        {"zh": "你记得它原来在哪吗", "en": "Do you remember where it was?"},
        {"zh": "你在往后面看", "en": "You're looking backward."},
        {"zh": "你身后那东西越来越清楚", "en": "The thing behind you grows clearer."},
        {"zh": "它不动，你也不敢动", "en": "It doesn't move; neither do you."},
        {"zh": "你的手开始出汗", "en": "Your hands are sweating."},
        {"zh": "我数着你的犹豫", "en": "I'm counting your hesitations."},
        {"zh": "你听，有人哭了", "en": "Listen; someone's crying."},
        {"zh": "那哭声很熟悉", "en": "That crying is familiar."},
        {"zh": "你还记得那天吗", "en": "Do you remember that day?"},
        {"zh": "它一直站在那儿", "en": "It's been standing there all along."},
        {"zh": "你已经不敢看镜子", "en": "You dare not look at the mirror."},
        {"zh": "它快到眼前了", "en": "Almost there."},
        {"zh": "我看见它动了", "en": "I saw it move."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "这不是我打的", "en": "I didn't strike you."},
        {"zh": "那一下是你自己", "en": "That blow was your own."},
        {"zh": "你撞在了幻象上", "en": "You ran into the illusion."},
        {"zh": "疼是真的，来源是假的", "en": "The pain is real; its source isn't."},
        {"zh": "你的手在抓空", "en": "Your hands are grasping nothing."},
        {"zh": "它就在你身后", "en": "It's behind you."},
        {"zh": "我一直没碰你", "en": "I haven't touched you."},
        {"zh": "你在和自己打架", "en": "You're fighting yourself."},
        {"zh": "你看见的东西咬了你", "en": "What you see bit you."},
        {"zh": "这不是我的爪子", "en": "Those aren't my claws."},
        {"zh": "再退就掉下去了", "en": "Back up again and you'll fall."},
        {"zh": "你开始喊起来了", "en": "You've started shouting."},
        {"zh": "不会有人来的", "en": "No one will come."},
        {"zh": "你自己收手吧", "en": "Stop it yourself."},
        {"zh": "看，它跟着你", "en": "See, it follows you."},
        {"zh": "结束在你手里", "en": "The end is in your hands."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "屋里多了一个影子", "en": "One more shadow in the room."},
        {"zh": "镜子里的位置不对", "en": "The mirror's placement is wrong."},
        {"zh": "先是脚步声，然后是我", "en": "Footsteps first, then me."},
        {"zh": "这里本来就有什么", "en": "Something was always here."},
        {"zh": "我还没有成形", "en": "I haven't taken shape yet."},
        {"zh": "你回头的时候我就在", "en": "I'll be there when you look back."},
        {"zh": "这间屋子有点熟", "en": "This room feels familiar."},
        {"zh": "你是在做梦吗", "en": "Are you dreaming?"},
        {"zh": "风已经完全停了", "en": "The wind has stopped."},
        {"zh": "我借你记忆里的样子", "en": "I borrow a shape from your memory."},
        {"zh": "灯影里有个轮廓", "en": "An outline in the lamplight."},
        {"zh": "不，那不是影子", "en": "No, that isn't a shadow."},
        {"zh": "你的眼睛在找什么", "en": "What are your eyes searching for?"},
        {"zh": "它是不请自来的", "en": "It comes uninvited."},
        {"zh": "我站在最熟悉的位置", "en": "I stand in the most familiar place."},
        {"zh": "你刚才是不是叫了一声", "en": "Did you just call out?"},
        {"zh": "你听见有人低声说话", "en": "You hear someone whispering."},
        {"zh": "这屋子里只有你一个人", "en": "You're alone in this room."},
        {"zh": "你真的确定吗", "en": "Are you truly sure?"},
        {"zh": "再回头看一眼", "en": "Look back once more."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光让影子更长", "en": "The firelight made the shadows longer."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "掉下去的是你，不是我", "en": "It was you who fell, not I."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里的倒影不是你", "en": "The reflection in the water isn't you."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "这一炸把幻象撕开了一角", "en": "The blast tore a corner off the illusion."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "你的箭射进了自己的影子", "en": "Your arrow went into your own shadow."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术也解不开你心里的东西", "en": "Magic can't loosen what's in your mind."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "你的虚弱让幻象更真", "en": "Your weakness makes the illusion truer."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光里有一张脸", "en": "There was a face in that flash."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里连倒影都没有", "en": "Even reflections fail in the void."}
      ]
    }
  }
}
