{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着墙角走", "en": "I move along the corner of the room."},
        {"zh": "你看向别处，我才走", "en": "I walk only when you look away."},
        {"zh": "我不敢走亮的地方", "en": "I keep out of the light."},
        {"zh": "一步，停一下，再一步", "en": "A step, a pause, another step."},
        {"zh": "我贴着最暗的那面墙", "en": "I hug the darkest wall."},
        {"zh": "地板上没有我的脚印", "en": "No footprints follow me."},
        {"zh": "我在你视线之外移动", "en": "I move outside your line of sight."},
        {"zh": "你的余光里有我", "en": "I'm in the edge of your vision."},
        {"zh": "我一走，灯就暗一点", "en": "Every step I take dims the lamp."},
        {"zh": "我绕开那个门口", "en": "I circle around that doorway."},
        {"zh": "别把脸转过来", "en": "Don't turn your face this way."},
        {"zh": "我只在看着你时不动", "en": "I stand still only while you watch."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在那儿，一直没动", "en": "I've been there all along, unmoving."},
        {"zh": "你可以试着不看", "en": "You can try not looking."},
        {"zh": "我知道你在忍", "en": "I know you're holding back."},
        {"zh": "这角落里正好", "en": "This corner suits me."},
        {"zh": "我从来不眨眼", "en": "I never blink."},
        {"zh": "房间安静得不对", "en": "The room is wrong-quiet."},
        {"zh": "你后背有点冷", "en": "The back of your neck is cold."},
        {"zh": "灯照在别的地方", "en": "The lamp points elsewhere."},
        {"zh": "你在数还有几秒", "en": "You're counting the seconds left."},
        {"zh": "我从不先动一步", "en": "I never move first."},
        {"zh": "你听见呼吸了吗", "en": "Do you hear breathing?"},
        {"zh": "那是我在你旁边", "en": "That's me beside you."},
        {"zh": "你还是不看，很好", "en": "Still not looking. Good."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "不要看我这边", "en": "Don't look this way."},
        {"zh": "你刚才看过了", "en": "You looked just now."},
        {"zh": "把眼睛移开去", "en": "Move your eyes away."},
        {"zh": "我不喜欢被注视", "en": "I don't like being watched."},
        {"zh": "你看见我了，对吧", "en": "You saw me, didn't you?"},
        {"zh": "现在你忘不掉了", "en": "Now you can't forget it."},
        {"zh": "你身后有一双眼睛", "en": "There are eyes behind you."},
        {"zh": "直视我会有代价", "en": "Looking straight at me has a price."},
        {"zh": "你把头转过去", "en": "Turn your head away."},
        {"zh": "我在这儿等你眨眼", "en": "I wait for you to blink."},
        {"zh": "你的瞳孔缩了", "en": "Your pupils shrank."},
        {"zh": "我不是你的错觉", "en": "I'm not your imagination."},
        {"zh": "你看得越久，我越近", "en": "The longer you look, the closer I am."},
        {"zh": "我说过别看我", "en": "I told you not to look."},
        {"zh": "你手上的光在抖", "en": "The light in your hand is shaking."},
        {"zh": "你已经看太久了", "en": "You've looked too long."},
        {"zh": "别指望我会消失", "en": "Don't expect me to vanish."},
        {"zh": "你终于抬头了", "en": "You finally looked up."},
        {"zh": "看，我也在看你", "en": "See, I'm looking too."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "是你碰到了我", "en": "You touched me."},
        {"zh": "这一下我不喜欢", "en": "I dislike that."},
        {"zh": "我的形状乱了", "en": "My shape is disordered."},
        {"zh": "你竟然敢动手", "en": "You actually struck."},
        {"zh": "我退到了墙角", "en": "I retreat into the corner."},
        {"zh": "疼，这个词我还有印象", "en": "Pain; I still remember the word."},
        {"zh": "你那张脸我记住了", "en": "I've kept your face."},
        {"zh": "你打破的不是我的身体", "en": "It's not my body you broke."},
        {"zh": "我还留在原地", "en": "I'm still here."},
        {"zh": "别以为这就结束了", "en": "Don't think it's over."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你不能用东西引开我", "en": "You can't lure me with things."},
        {"zh": "我不吃，也不拿", "en": "I neither eat nor take."},
        {"zh": "你举起东西也没用", "en": "Raising something won't help."},
        {"zh": "我不看那个东西", "en": "I'm not looking at that."},
        {"zh": "你在转移注意力", "en": "You're trying to distract yourself."},
        {"zh": "别把手伸过来", "en": "Don't reach out a hand."},
        {"zh": "那东西挡不住视线", "en": "That won't block a gaze."},
        {"zh": "我盯的从来不是你手里的", "en": "It was never your hands I watched."},
        {"zh": "把它藏到我看不见", "en": "Hide it where I can't see."},
        {"zh": "我不需要那个", "en": "I don't need that."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经碰到我", "en": "You've touched me."},
        {"zh": "我的轮廓散了又聚", "en": "My outline scattered and came back."},
        {"zh": "这下你躲不掉了", "en": "Now you can't hide."},
        {"zh": "我们之间没有距离", "en": "There's no distance between us."},
        {"zh": "你碰到了不该碰的", "en": "You touched what shouldn't be touched."},
        {"zh": "我退开了，但它还会回来", "en": "I've pulled back, but it returns."},
        {"zh": "你的手是凉的", "en": "Your hand is cold."},
        {"zh": "这不叫撞，叫遇上", "en": "This isn't a bump; it's an encounter."},
        {"zh": "我在你旁边了", "en": "I'm beside you now."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我连形状都不固定", "en": "I don't even hold a shape."},
        {"zh": "我连自己都没有", "en": "I don't even have myself."},
        {"zh": "你早该离开了", "en": "You should leave."},
        {"zh": "不要再问下去", "en": "Ask no more."},
        {"zh": "我不想靠近任何人", "en": "I don't want to be close to anyone."},
        {"zh": "我只是在看着", "en": "I'm only watching."},
        {"zh": "这不是我存在的理由", "en": "That's not why I exist."},
        {"zh": "我不懂这种东西", "en": "I don't understand such things."},
        {"zh": "别让我靠太近", "en": "Don't let me come nearer."},
        {"zh": "从我身边走开", "en": "Go away from me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抓不到形状", "en": "You can't grab a shape."},
        {"zh": "我的手会散开", "en": "My hand comes apart."},
        {"zh": "别碰我的眼睛", "en": "Don't touch my eyes."},
        {"zh": "你抱住的只有空气", "en": "You're holding only air."},
        {"zh": "这样我会贴得更近", "en": "This only brings me closer."},
        {"zh": "你的指节都白了", "en": "Your knuckles have gone white."},
        {"zh": "把它放下来吧", "en": "Put it down."},
        {"zh": "我不喜欢被拿走", "en": "I don't like being taken."},
        {"zh": "你带不走我的", "en": "You can't take me."},
        {"zh": "我会跟着，但不是这样", "en": "I'll follow, but not like this."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你看了我太久", "en": "You looked at me too long."},
        {"zh": "别直视我，这是规矩。", "en": "Do not look straight at me. That is the rule."},
        {"zh": "你转身也没用", "en": "Turning away won't help."},
        {"zh": "我就在你视野边缘", "en": "I'm at the edge of your vision."},
        {"zh": "你闭上眼，我还在", "en": "Close your eyes; I'm still here."},
        {"zh": "这一眼你付不起", "en": "That look will cost you."},
        {"zh": "我不动，但你会过来", "en": "I don't move; you will."},
        {"zh": "墙角的影子变长了", "en": "The shadow in the corner has stretched."},
        {"zh": "你听见自己在喘", "en": "You hear your own breathing."},
        {"zh": "别回头看这边", "en": "Don't look back."},
        {"zh": "我已经不在那个角落了", "en": "I'm no longer in that corner."},
        {"zh": "这灯快要灭了", "en": "The lamp is going out."},
        {"zh": "你在找出口吧", "en": "You're looking for a way out."},
        {"zh": "这个房间里只有你和我", "en": "Only you and me in this room."},
        {"zh": "你越慌，我越清楚", "en": "The more you panic, the clearer I get."},
        {"zh": "现在，看着我", "en": "Now. Look at me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在这里", "en": "I've been here all along."},
        {"zh": "你看不到的地方我也在", "en": "I'm where you can't see too."},
        {"zh": "你的气吸得太浅", "en": "You're breathing too shallow."},
        {"zh": "墙角那个不是我", "en": "That thing in the corner isn't me."},
        {"zh": "我在你身后站着", "en": "I stand behind you."},
        {"zh": "你别转过身去", "en": "Don't turn around."},
        {"zh": "灯光照不到我", "en": "The lamplight can't reach me."},
        {"zh": "我数着你眨眼的次数，别看我。", "en": "I count your blinks; do not look at me."},
        {"zh": "你已经不敢直视前方", "en": "You can't look straight ahead now."},
        {"zh": "地板在嘎吱响", "en": "The floor is creaking."},
        {"zh": "我离门口更近了", "en": "I'm closer to the door."},
        {"zh": "别看我，否则我靠近。", "en": "Don't look at me, or I'll come closer."},
        {"zh": "这面墙后面是我", "en": "I'm behind this wall."},
        {"zh": "你手指按着剑柄", "en": "Your fingers are on the hilt."},
        {"zh": "你听得见自己的心跳", "en": "You can hear your own heart."},
        {"zh": "还剩下三步路", "en": "Three steps left."},
        {"zh": "别抬起眼睛来", "en": "Don't lift your eyes."},
        {"zh": "我就在这里啊", "en": "I'm right here."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "你又看了一眼", "en": "You looked again."},
        {"zh": "这一下是眼睛换的", "en": "That cost you a look."},
        {"zh": "我没有手，也能碰到你", "en": "I have no hands, yet I touch you."},
        {"zh": "是不是很冷啊", "en": "Isn't it cold?"},
        {"zh": "你已经退不开", "en": "You can't pull away now."},
        {"zh": "这不算伤，算记号", "en": "Not a wound; a mark."},
        {"zh": "你现在不敢闭眼", "en": "You dare not close your eyes now."},
        {"zh": "我再来一次吧", "en": "Once more."},
        {"zh": "你的视线是我的", "en": "Your gaze is mine."},
        {"zh": "别看我，可你偏看", "en": "I said don't look, yet you did."},
        {"zh": "这一下留在你眼后", "en": "This one stays behind your eyes."},
        {"zh": "你听见那声低语了", "en": "You heard that whisper."},
        {"zh": "那是我在数数", "en": "That's me counting."},
        {"zh": "给我安静下来", "en": "Be quiet."},
        {"zh": "你还会回来的", "en": "You'll come back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "墙角多了个影子", "en": "The corner has one more shadow."},
        {"zh": "灯亮着，但不够亮", "en": "The lamp is lit, but not enough."},
        {"zh": "我来得非常慢", "en": "I arrive very slowly."},
        {"zh": "先是眼睛，然后才是身体", "en": "First eyes, then a body."},
        {"zh": "屋里谁也没发现", "en": "No one in the room noticed."},
        {"zh": "你听见地板响了吗", "en": "Did you hear the floor?"},
        {"zh": "门到现在还开着", "en": "The door is still open."},
        {"zh": "这盏灯不够照全屋子", "en": "This lamp can't light the whole room."},
        {"zh": "你回头看一眼吧", "en": "Just turn and look once."},
        {"zh": "我在最不舒服的位置", "en": "I'm where it feels worst."},
        {"zh": "屋子暖和了，可惜不是好事", "en": "The room feels warmer; that's not good."},
        {"zh": "你身边有个人", "en": "Someone is beside you."},
        {"zh": "我从不会敲门", "en": "I never knock."},
        {"zh": "我在你视线外侧", "en": "I'm outside your line of sight."},
        {"zh": "我来了，你还没发现", "en": "I'm here, and you haven't noticed."},
        {"zh": "这一夜会很长", "en": "This night will be long."},
        {"zh": "窗外的影子不是你", "en": "That shadow outside isn't yours."},
        {"zh": "别看，也别闭眼", "en": "Don't look, and don't shut your eyes."},
        {"zh": "我就在那个角里", "en": "I'm in that corner."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火照亮了整个屋子", "en": "The fire lit the whole room."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，又浮上来", "en": "I fell, and rose again."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让我看不见你", "en": "Water keeps me from seeing you."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "光一下子炸开", "en": "The light burst open."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那一发穿过我的眼睛", "en": "That shot went through my eye."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒语想把我从角落赶走", "en": "The spell tries to drive me from the corner."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不会饿，只是会空", "en": "I don't starve; I only hollow out."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "那道白光让我无处藏", "en": "That white flash left me nowhere to hide."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗终于比我还深", "en": "At last the dark is deeper than I."}
      ]
    }
  }
}
