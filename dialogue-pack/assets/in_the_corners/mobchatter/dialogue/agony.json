{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你走，一步一步。", "en": "I walk toward you, step by step."},
        {"zh": "我从不停下来。", "en": "I never stop."},
        {"zh": "我的脚步比你的呼吸慢。", "en": "My steps are slower than your breathing."},
        {"zh": "我穿过门框，门没开。", "en": "I pass through the frame. The door stays shut."},
        {"zh": "地面湿了一路。", "en": "The floor is wet along my path."},
        {"zh": "我绕过桌椅，直接过来。", "en": "I go around the furniture, straight to you."},
        {"zh": "我每走一步，你就退一步。", "en": "Each step of mine buys a step of yours."},
        {"zh": "我的头歪着。", "en": "My head hangs at an angle."},
        {"zh": "我走得很稳。", "en": "I walk steadily."},
        {"zh": "这条路我走了很久。", "en": "I have walked this way a long while."},
        {"zh": "我不会迷路。", "en": "I do not lose my way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在你门外。", "en": "I stand outside your door."},
        {"zh": "我在等门开。", "en": "I am waiting for the door to open."},
        {"zh": "这间屋子的气味，我记住了。", "en": "I remember this room's smell."},
        {"zh": "我没有别的事可做。", "en": "I have nothing else to do."},
        {"zh": "我在算你还剩几步。", "en": "I am counting how many steps you have left."},
        {"zh": "我的关节响。", "en": "My joints creak."},
        {"zh": "我慢慢仰起头。", "en": "I slowly tilt my head back."},
        {"zh": "安静得能听见你的牙响。", "en": "It's quiet enough to hear your teeth rattle."},
        {"zh": "我在你身后站了一会儿。", "en": "I stood behind you a while."},
        {"zh": "你回头看，我已经不在。", "en": "You look back, and I am gone."},
        {"zh": "我回来了。", "en": "I am back."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在看。", "en": "I have been watching all along."},
        {"zh": "你看清我了吗。", "en": "Have you got a good look?"},
        {"zh": "我的脸离你的不远。", "en": "My face is not far from yours."},
        {"zh": "我们之间没有距离。", "en": "There is no distance between us."},
        {"zh": "这不是你想的那种相遇。", "en": "This is not the meeting you imagined."},
        {"zh": "你的睫毛在动。", "en": "Your lashes are moving."},
        {"zh": "我在你瞳孔里。", "en": "I am in your pupils."},
        {"zh": "我记得你上一次的样子。", "en": "I remember how you looked last time."},
        {"zh": "你又长高了。", "en": "You have grown taller."},
        {"zh": "你看我的眼神，很熟悉。", "en": "That look in your eye is familiar."},
        {"zh": "你不是第一个。", "en": "You are not the first."},
        {"zh": "也不会是最后一个。", "en": "Nor will you be the last."},
        {"zh": "我们就这样站着。", "en": "We stand like this."},
        {"zh": "看够了没有。", "en": "Have you looked enough?"},
        {"zh": "我还要看。", "en": "I am not done looking."},
        {"zh": "别移开眼。", "en": "Do not look away."},
        {"zh": "就这么一会儿。", "en": "Just for a moment."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中我了，我歪了一下。", "en": "You hit me and I tilted."},
        {"zh": "二级的它，只会一直朝你走。", "en": "A second-tier thing that only walks toward you."},
        {"zh": "这一下，拦不住我。", "en": "That will not hold me."},
        {"zh": "我的脸抽了一下。", "en": "My face twitched."},
        {"zh": "我还是那个距离。", "en": "I am still that close."},
        {"zh": "你手上有东西。", "en": "You have something on your hands."},
        {"zh": "拿来。", "en": "Give it."},
        {"zh": "你退开，我数着那两步。", "en": "You back off; I count those two steps."},
        {"zh": "我又近了两步。", "en": "I took two steps forward."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举这个干什么。", "en": "What are you raising that for?"},
        {"zh": "我穿过门框，门却没有开。", "en": "I pass through the doorframe; the door did not open."},
        {"zh": "这改变不了什么。", "en": "That changes nothing."},
        {"zh": "你手抖得很厉害。", "en": "Your hand shakes badly."},
        {"zh": "我要的从来不是东西。", "en": "It was never things I wanted."},
        {"zh": "留着。", "en": "Keep it."},
        {"zh": "你还有别的办法吗。", "en": "Do you have any other idea?"},
        {"zh": "没有了。", "en": "No."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进我怀里了。", "en": "You walked into my arms."},
        {"zh": "我接住了你。", "en": "I caught you."},
        {"zh": "你挣不开。", "en": "You cannot pull free."},
        {"zh": "这一下，你安静了。", "en": "That one quieted you."},
        {"zh": "我们贴得很紧。", "en": "We are pressed close."},
        {"zh": "那不是从嘴里出来的。", "en": "It did not come from a mouth."},
        {"zh": "你一撞，墙里就有回音。", "en": "Hit me and the wall echoes back."},
        {"zh": "我们终于碰到了。", "en": "At last, we touch."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "没有。", "en": "No."},
        {"zh": "这里只有逼迫。", "en": "There is only pressure here."},
        {"zh": "我们不说话。", "en": "We do not speak."},
        {"zh": "它也在朝你走。", "en": "It is walking toward you too."},
        {"zh": "你被夹在中间。", "en": "You are caught between us."},
        {"zh": "我们分食这间屋子。", "en": "We share this room between us."},
        {"zh": "影子叠在一起。", "en": "Our shadows overlap."},
        {"zh": "分不清哪一个是我。", "en": "You cannot tell which is me."},
        {"zh": "哪个都是我。", "en": "Both are me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我掰开你的手指拿走它。", "en": "I pry your fingers open and take it."},
        {"zh": "你摸口袋，它不在。", "en": "Check your pocket. It is not there."},
        {"zh": "痛苦缠着我，我跟着你。", "en": "Agony clings to me. I follow you."},
        {"zh": "我以后还会用它。", "en": "I will use it again later."},
        {"zh": "你找不到的。", "en": "You will not find it."},
        {"zh": "它在我胸口。", "en": "It is in my chest."},
        {"zh": "你不该带着它。", "en": "You should not have carried it."},
        {"zh": "现在归我了。", "en": "It is mine now."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我朝你来了。", "en": "I am coming for you."},
        {"zh": "你在那间屋子里。", "en": "You are in that room."},
        {"zh": "锁孔里伸进一只手指。", "en": "A finger slides in through the keyhole."},
        {"zh": "这次我不停。", "en": "This time I do not stop."},
        {"zh": "地板响了一声，你听见了吗。", "en": "The floor creaked once, did you hear it?"},
        {"zh": "靠得很近了。", "en": "Very close now."},
        {"zh": "你一回头，我就到。", "en": "Turn around and I arrive."},
        {"zh": "跑也没用。", "en": "Running helps nothing."},
        {"zh": "我比昨天更近。", "en": "I am closer than yesterday."},
        {"zh": "楼上的地板又响了一下。", "en": "The floor upstairs creaked again."},
        {"zh": "我在门缝里。", "en": "I am in the gap of the door."},
        {"zh": "你听见了。", "en": "You heard that."},
        {"zh": "钟响之前我就要动手。", "en": "I'll move before the bell rings."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我持续靠近。", "en": "I keep closing in."},
        {"zh": "我不追，只走。", "en": "I do not chase. I walk."},
        {"zh": "你退无可退。", "en": "There is nowhere left to retreat."},
        {"zh": "墙在你背后。", "en": "The wall is behind you."},
        {"zh": "我一步也没停。", "en": "I have not stopped once."},
        {"zh": "你在喘。", "en": "You are panting."},
        {"zh": "我不用喘。", "en": "I do not pant."},
        {"zh": "你的手撑在墙上。", "en": "Your hand is braced on the wall."},
        {"zh": "我看着那只手。", "en": "I watch that hand."},
        {"zh": "我越来越近。", "en": "I come closer and closer."},
        {"zh": "你的视野在缩。", "en": "Your field of view is narrowing."},
        {"zh": "只有我了。", "en": "Only me now."},
        {"zh": "我能等，你不能。", "en": "I can wait. You cannot."},
        {"zh": "你听见我的脚步。", "en": "You hear my steps."},
        {"zh": "它们没有停过。", "en": "They have never stopped."},
        {"zh": "我只数到二就改变主意。", "en": "I only count to two before changing my mind."},
        {"zh": "第二步你已经踩错了。", "en": "Your second step was already wrong."},
        {"zh": "第一步我替你数了。", "en": "I counted the first step for you."},
        {"zh": "到了。", "en": "Here."},
        {"zh": "别怕。", "en": "Do not be afraid."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我按住你的肩。", "en": "I press down on your shoulder."},
        {"zh": "你没喊出声。", "en": "You did not cry out."},
        {"zh": "我的手太长了。", "en": "My hand is too long."},
        {"zh": "你被拉向我。", "en": "You are pulled toward me."},
        {"zh": "我慢慢靠近，一步不停。", "en": "I close in, one step at a time."},
        {"zh": "我扶着你。", "en": "I am holding you up."},
        {"zh": "这不叫攻击。", "en": "This is not an attack."},
        {"zh": "这叫靠近。", "en": "This is closeness."},
        {"zh": "我每一步都往你那边挪。", "en": "Every step of mine goes toward you."},
        {"zh": "你还站着。", "en": "You are still standing."},
        {"zh": "不错。", "en": "Good."},
        {"zh": "下次见。", "en": "Next time."},
        {"zh": "不走。", "en": "Not leaving."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这间屋子的灯灭了。", "en": "The lamp in this room went out."},
        {"zh": "我先在门后站着。", "en": "I stand behind the door first."},
        {"zh": "角落里有动静。", "en": "Something stirs in the corner."},
        {"zh": "我来得比你想的早。", "en": "I came earlier than you thought."},
        {"zh": "空气一下子沉下来。", "en": "The air grew heavy all at once."},
        {"zh": "地板湿了一片。", "en": "A patch of floor is wet."},
        {"zh": "我落脚，没有声音。", "en": "I set down without a sound."},
        {"zh": "这里有人，很好。", "en": "Someone is here. Good."},
        {"zh": "我认得这栋房子。", "en": "I know this house."},
        {"zh": "我上次也来过。", "en": "I came last time too."},
        {"zh": "这次我会待久一点。", "en": "This time I will stay longer."},
        {"zh": "你还没睡吧。", "en": "You are not asleep yet."},
        {"zh": "别熄灯。", "en": "Do not put out the lamp."},
        {"zh": "熄了也没用。", "en": "It would not help anyway."},
        {"zh": "这一晚，我又站起来。", "en": "Tonight I rise again."},
        {"zh": "从那边，到你这里。", "en": "From over there, to you here."},
        {"zh": "只有一段距离。", "en": "Only a stretch of distance."},
        {"zh": "很快就到。", "en": "Soon."},
        {"zh": "这声音，你会记住的。", "en": "You will remember that sound."},
        {"zh": "我站在你卧室门口。", "en": "I stand in your bedroom doorway."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火照出我的样子。", "en": "The fire shows what I look like."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下来，姿势没变。", "en": "I land, and my posture does not change."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水淹过我，我不停。", "en": "Water covers me. I do not stop."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "炸开了，我还在走。", "en": "The blast goes off, and I keep walking."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "它穿过去了。", "en": "It went through."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这道光让我慢了一点。", "en": "That light slowed me a little."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃东西，我只需要你靠近。", "en": "I do not eat; I only need you closer."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷照亮了整间屋，我仍在。", "en": "Lightning fills the room. I am still here."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面很空，也很安静。", "en": "It is empty below, and quiet."}
      ]
    }
  }
}
