{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我从黑暗里挪出来。", "en": "I shift out of the darkness."},
        {"zh": "我贴着地面，没有脚。", "en": "I glide along the ground without feet."},
        {"zh": "我没有脚，可我在靠近。", "en": "I have no feet, and I'm still closing in."},
        {"zh": "这条走廊没有尽头。", "en": "This corridor has no end."},
        {"zh": "我一动，光就退。", "en": "When I move, the light retreats."},
        {"zh": "我不绕路。", "en": "I do not go around."},
        {"zh": "你听到的拖拽声，是我。", "en": "The dragging sound is me."},
        {"zh": "我穿过一堵墙。", "en": "I pass through a wall."},
        {"zh": "我每走一步，你就少一步。", "en": "Each step of mine costs you one."},
        {"zh": "我走进你的灯照不到的地方。", "en": "I walk where your lamp does not shine."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我停在你身后。", "en": "I stop behind you."},
        {"zh": "我不动，黑暗替我动。", "en": "I stay still; the dark moves for me."},
        {"zh": "深渊在看着我。", "en": "The abyss is watching."},
        {"zh": "我在等你自己转过来。", "en": "I wait for you to turn."},
        {"zh": "这里的光太薄了。", "en": "The light here is thin."},
        {"zh": "我什么都不做，就是站着。", "en": "I do nothing but stand."},
        {"zh": "你有心跳，我没有。", "en": "You have a heartbeat. I do not."},
        {"zh": "你走的步数我记在心里。", "en": "I keep count of every step you take."},
        {"zh": "这一片，都是我的。", "en": "All of this is mine."},
        {"zh": "地面在往下沉一点。", "en": "The floor sinks a little."},
        {"zh": "我的轮廓很难看清。", "en": "My outline is hard to make out."},
        {"zh": "你的灯芯快烧完了。", "en": "Your wick is nearly spent."},
        {"zh": "我在等一个瞬间。", "en": "I am waiting for one moment."},
        {"zh": "我跟你一样高，也比你高。", "en": "I am as tall as you, and taller."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "别看我。", "en": "Do not look at me."},
        {"zh": "你看了。", "en": "You looked."},
        {"zh": "我们之间只剩一步。", "en": "Only one step between us."},
        {"zh": "我的脸离你很近。", "en": "My face is very near yours."},
        {"zh": "你现在还能眨眼。", "en": "You can still blink. For now."},
        {"zh": "这一眼，你忘不掉。", "en": "You will not forget this look."},
        {"zh": "你的瞳孔放大了。", "en": "Your pupils have widened."},
        {"zh": "我在你的视界里。", "en": "I am inside your field of view."},
        {"zh": "你听见自己的呼吸了吗。", "en": "Do you hear your own breathing?"},
        {"zh": "这间屋子变大了。", "en": "This room has grown larger."},
        {"zh": "我看到你身后的东西了。", "en": "I see what is behind you."},
        {"zh": "你的手别抬起来。", "en": "Do not raise your hand."},
        {"zh": "别喊，没人应。", "en": "Do not shout. No one answers."},
        {"zh": "我们离得很近，很近。", "en": "We are very, very close."},
        {"zh": "你还不明白吗。", "en": "Do you still not understand?"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中了我，我散了。", "en": "You struck me and I scattered."},
        {"zh": "我又聚起来。", "en": "I gather again."},
        {"zh": "这一下，让我退开一寸。", "en": "That moved me back an inch."},
        {"zh": "我不疼。", "en": "I feel no pain."},
        {"zh": "你手上有光。", "en": "There is light on your hand."},
        {"zh": "我的边缘在扭。", "en": "My edges are twisting."},
        {"zh": "这具身体本来就松。", "en": "This body was never solid."},
        {"zh": "你还有力气。", "en": "You still have strength."},
        {"zh": "我的形状散开又聚拢。", "en": "My shape scatters and gathers again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "角落里的影子，不需要进食。", "en": "The shadow in the corner needs no food."},
        {"zh": "深渊下面，我也会睁眼。", "en": "Down in the abyss, I open an eye too."},
        {"zh": "放下。", "en": "Set it down."},
        {"zh": "这不是能收买我的东西。", "en": "That cannot buy me."},
        {"zh": "你根本不知道我要什么。", "en": "You do not know what I want."},
        {"zh": "我要的是你看着我的那一瞬。", "en": "I want the instant you look at me."},
        {"zh": "我碰你一下，这世界就跟你没关系了。", "en": "One touch and this world is done with you."},
        {"zh": "这味道，很难闻。", "en": "That smell is unpleasant."},
        {"zh": "太迟了。", "en": "Too late."},
        {"zh": "你已经给了。", "en": "You already gave it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体像冷水。", "en": "My body is like cold water."},
        {"zh": "你退不开。", "en": "You cannot pull away."},
        {"zh": "这一下，你被抓住了。", "en": "That one caught you."},
        {"zh": "你想推开，推不动。", "en": "You push, and nothing gives."},
        {"zh": "我们的脸几乎贴在一起。", "en": "Our faces are nearly touching."},
        {"zh": "你看见我的牙了。", "en": "You see my teeth."},
        {"zh": "别挣扎。", "en": "Do not struggle."},
        {"zh": "你碰到我了……那就别想回头。", "en": "You touched me... now there's no turning back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有这种东西。", "en": "There is no such thing here."},
        {"zh": "深渊不需要繁衍。", "en": "The abyss has no need to breed."},
        {"zh": "另一个我在墙里。", "en": "Another me is inside the wall."},
        {"zh": "它和我一样沉默。", "en": "It is as silent as I."},
        {"zh": "我们分食同一片暗。", "en": "We share the same patch of dark."},
        {"zh": "它先笑了。", "en": "It smiled first."},
        {"zh": "我们没有脸。", "en": "We have no faces."},
        {"zh": "两个空洞，并排。", "en": "Two voids, side by side."},
        {"zh": "你只看得到一个。", "en": "You will see only one."},
        {"zh": "都看着你。", "en": "Both of us are watching you."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着脸出现，然后追你。", "en": "I appear at your face, then chase."},
        {"zh": "它在我手里没了。", "en": "It is gone in my hand."},
        {"zh": "我要的是你手里的光。", "en": "What I want is the light in your hand."},
        {"zh": "我把它还到你脚边。", "en": "I put it back at your feet."},
        {"zh": "你找不到它了。", "en": "You will not find it now."},
        {"zh": "它在我嘴里。", "en": "It is in my mouth."},
        {"zh": "它一进我手心，就黑成了炭。", "en": "The moment it enters my palm it blackens to charcoal."},
        {"zh": "这东西，我也不要。", "en": "I do not want this either."},
        {"zh": "你摸口袋，空的。", "en": "Feel your pocket. Empty."},
        {"zh": "你自己放错了。", "en": "You put it in the wrong place."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴到你面前了。", "en": "I am right in front of your face."},
        {"zh": "这一刻，我记住了。", "en": "I have this moment."},
        {"zh": "门已经不在那儿了。", "en": "The door is no longer there."},
        {"zh": "你的灯灭了。", "en": "Your lamp went out."},
        {"zh": "我数到一。", "en": "I count to one."},
        {"zh": "我要你看着。", "en": "I want you to watch."},
        {"zh": "这不算攻击。", "en": "This is not an attack."},
        {"zh": "这是见面。", "en": "This is a meeting."},
        {"zh": "你的手开始发凉。", "en": "Your hands are going cold."},
        {"zh": "我们靠得够近了。", "en": "We are close enough now."},
        {"zh": "你还在。", "en": "You are still here."},
        {"zh": "那就走吧。", "en": "Then go."},
        {"zh": "我送你出去。", "en": "I will see you out."},
        {"zh": "别谢我。", "en": "Do not thank me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你转头，我就在另一边。", "en": "You turn, and I am on the other side."},
        {"zh": "你退，墙就往前。", "en": "You retreat, and the wall advances."},
        {"zh": "这间屋子在缩。", "en": "This room is shrinking."},
        {"zh": "我比刚才更近了。", "en": "I am nearer than before."},
        {"zh": "呼吸一乱，你就完了。", "en": "One broken breath, and you're done."},
        {"zh": "你有的是时间。", "en": "You have all the time in the world."},
        {"zh": "或者没有。", "en": "Or none."},
        {"zh": "那不是水。", "en": "That is not water."},
        {"zh": "我的脸在变。", "en": "My face is changing."},
        {"zh": "你记不清我的样子了。", "en": "You cannot recall my face now."},
        {"zh": "因为我没有固定的样子。", "en": "Because I have no fixed shape."},
        {"zh": "你走近了，光就短一寸。", "en": "The closer you come, the shorter the light."},
        {"zh": "你后退的那一步，我让开了。", "en": "I allowed that step back."},
        {"zh": "让你以为还有距离。", "en": "To let you think there is distance."},
        {"zh": "其实没有了。", "en": "There is none."},
        {"zh": "看着。", "en": "Watch."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴到你脸前。", "en": "I press to your face."},
        {"zh": "你被吓住了。", "en": "You are frozen."},
        {"zh": "我的手扣住你的手腕。", "en": "My hand closes on your wrist."},
        {"zh": "你看清了没有。", "en": "Did you get a good look?"},
        {"zh": "这一下没有伤口。", "en": "This leaves no wound."},
        {"zh": "你只是不见了。", "en": "You are simply gone."},
        {"zh": "世界在你眼前撕开。", "en": "The world tears open before you."},
        {"zh": "你被推了出去。", "en": "You are pushed out."},
        {"zh": "别挣扎，很快就结束。", "en": "Do not struggle. It ends soon."},
        {"zh": "我又站回暗处。", "en": "I step back into the dark."},
        {"zh": "你还记得我吗。", "en": "Do you remember me?"},
        {"zh": "不记得也好。", "en": "Better if you do not."},
        {"zh": "下一次，会更快。", "en": "Next time will be quicker."},
        {"zh": "你回来了。", "en": "You are back."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "灯先灭了。", "en": "The lamp went out first."},
        {"zh": "墙角开始渗水。", "en": "Water seeps at the corner."},
        {"zh": "我先在镜子里出现。", "en": "I appear in the mirror first."},
        {"zh": "这地方空得太久。", "en": "This place has been empty too long."},
        {"zh": "你的影子先动。", "en": "Your shadow moved first."},
        {"zh": "屋里的声音一下全没了。", "en": "All sound in the house just vanished."},
        {"zh": "地板下面有声音。", "en": "There is sound under the floor."},
        {"zh": "我站在门口，没进去。", "en": "I stand at the door without entering."},
        {"zh": "我数了三个房间。", "en": "I counted three rooms."},
        {"zh": "我选了最暗的那个。", "en": "I chose the darkest one."},
        {"zh": "有延迟，你还有一点时间。", "en": "There is a delay. You have a little time."},
        {"zh": "用吧。", "en": "Use it."},
        {"zh": "我进来的时候，你已经在这了。", "en": "When I came in, you were already here."},
        {"zh": "这次我不藏。", "en": "This time I do not hide."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火让我显形了。", "en": "The fire made me visible."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下来，散成一片黑。", "en": "I fall and spill into black."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌满了我，我变重了。", "en": "Water fills me and I grow heavy."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸把我推得散开。", "en": "The blast scatters me apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过了我。", "en": "Something passed through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这道符把我钉住了。", "en": "This ward pins me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我连饿是什么都不知道。", "en": "I don't even know what hunger is."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照透了我。", "en": "Lightning shone right through me."}
      ]
    }
  }
}
