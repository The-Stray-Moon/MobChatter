{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我走一步，画面就跳一下", "en": "I take a step and the picture jumps."},
        {"zh": "我的位置在前后之间", "en": "My position is between ahead and behind."},
        {"zh": "我挪过去，又弹回来", "en": "I shift over, then snap back."},
        {"zh": "你看到的是三个我", "en": "You're seeing three of me."},
        {"zh": "我脚下有重影", "en": "Ghost copies trail my feet."},
        {"zh": "我走得很不连贯", "en": "My walking doesn't connect."},
        {"zh": "我一路掉着像素", "en": "I shed pixels as I go."},
        {"zh": "你眨眼时我换了地方", "en": "While you blinked, I moved."},
        {"zh": "我挪动时没有声音", "en": "No sound when I shift."},
        {"zh": "我走着，画面撕了个口子", "en": "My path tears a hole in the scene."},
        {"zh": "我离你时近时远", "en": "My distance to you keeps changing."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我卡在原地不动", "en": "I'm stuck in place."},
        {"zh": "画面有一块在闪", "en": "One patch of the view is flashing."},
        {"zh": "我重复同一个动作", "en": "I repeat the same motion."},
        {"zh": "这地方的贴图错了", "en": "The textures here are wrong."},
        {"zh": "我不太连得起来", "en": "I don't quite hold together."},
        {"zh": "你的视野边缘一直在抖", "en": "The edge of your vision keeps shaking."},
        {"zh": "我停在半帧上", "en": "I'm stopped on half a frame."},
        {"zh": "有声音在重复", "en": "A sound keeps repeating."},
        {"zh": "我的颜色不对", "en": "My colors are wrong."},
        {"zh": "你听见杂音了吗", "en": "Do you hear static?"},
        {"zh": "我整块整块地闪", "en": "I blink out in whole blocks."},
        {"zh": "这里像是被剪掉了一段", "en": "It's as if a piece was cut out here."},
        {"zh": "我看不清自己", "en": "I can't see myself clearly."},
        {"zh": "我一直在那儿，也一直不在", "en": "I'm always there, and always not."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你一盯着我就抖", "en": "Your staring makes me stutter."},
        {"zh": "别盯着我的边缘", "en": "Don't stare at my edges."},
        {"zh": "我这张脸不太对", "en": "This face isn't quite right."},
        {"zh": "你的画面里有个坏点", "en": "There's a dead spot in your picture."},
        {"zh": "我说话会有回音", "en": "My words come back doubled."},
        {"zh": "你看到的不是全部", "en": "You aren't seeing all of it."},
        {"zh": "我一直在重新出现", "en": "I keep re-appearing."},
        {"zh": "你在数我的手指吗", "en": "Are you counting my fingers?"},
        {"zh": "有那么一下我不在", "en": "For an instant I wasn't there."},
        {"zh": "别靠太近，会串色", "en": "Don't come close; the colors bleed."},
        {"zh": "我这张脸记住你了", "en": "This face has memorized you."},
        {"zh": "你的眼睛在替我闪烁", "en": "Your eyes flicker for me."},
        {"zh": "我卡在你视线的中间", "en": "I'm stuck in the middle of your sight."},
        {"zh": "每看一次，我就多一块", "en": "Each look adds a piece of me."},
        {"zh": "你听见我说话有延迟吗", "en": "Do you hear my words lag?"},
        {"zh": "我不是坏了，我是这样", "en": "I'm not broken; this is what I am."},
        {"zh": "我说话会重复一遍", "en": "My words repeat once."},
        {"zh": "你数到三，我就会变", "en": "Count to three and I'll change."},
        {"zh": "别关灯，关了更明显", "en": "Don't kill the lights; it gets worse."},
        {"zh": "我就站在你的盲点上", "en": "I stand in your blind spot."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我这一块没了", "en": "A piece of me is gone."},
        {"zh": "画面抖得更厉害了", "en": "The picture shakes harder."},
        {"zh": "我又重复了一次", "en": "I repeated myself."},
        {"zh": "你打到的是另一个我", "en": "You hit the other me."},
        {"zh": "我的边缘在褪色", "en": "My edges are losing color."},
        {"zh": "疼得断断续续", "en": "The pain comes in stutters."},
        {"zh": "我整个人卡住", "en": "I've been stuck."},
        {"zh": "我少掉了一帧", "en": "I lost a frame."},
        {"zh": "这正在修复中", "en": "This is being repaired."},
        {"zh": "我不确定我还剩多少", "en": "I'm not sure how much of me is left."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那东西在抖", "en": "That thing in your hand is shaking."},
        {"zh": "我看不清它是什么", "en": "I can't make out what it is."},
        {"zh": "你别拿它对着我", "en": "Don't point it at me."},
        {"zh": "它在我眼里断成了两截", "en": "It breaks in two in my sight."},
        {"zh": "我并不需要它", "en": "I don't need it."},
        {"zh": "你会把它弄丢的", "en": "You're going to lose it."},
        {"zh": "它在你手里也在别处", "en": "It's in your hand and elsewhere."},
        {"zh": "别晃，我更看不清了", "en": "Don't wave it; I see even less."},
        {"zh": "让它离开这帧", "en": "Get it out of this frame."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "这一下卡了两次", "en": "That bumped twice."},
        {"zh": "我的手穿过去了", "en": "My hand passed through."},
        {"zh": "你在两个位置上撞到我", "en": "You hit me in two places."},
        {"zh": "撞击声重复了三遍", "en": "The impact sounded three times."},
        {"zh": "我的形状歪了", "en": "My shape went crooked."},
        {"zh": "别碰，会传染", "en": "Don't touch; it spreads."},
        {"zh": "这一撞让我更模糊了", "en": "The bump blurred me further."},
        {"zh": "我们之间的距离是错的", "en": "The distance between us is wrong."},
        {"zh": "你退开时我还在原处", "en": "When you pull back, I'm still there."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我连自己都拼不完整", "en": "I can't even assemble myself."},
        {"zh": "这种事不会有结果", "en": "That would come to nothing."},
        {"zh": "我不确定我是不是一个", "en": "I'm not sure I'm one thing."},
        {"zh": "别靠过来，会分不清", "en": "Don't come near; we'd blur."},
        {"zh": "我没有那种冲动", "en": "I lack that urge."},
        {"zh": "你会被一起弄坏的", "en": "You'd be corrupted too."},
        {"zh": "我实在做不到", "en": "I can't do it."},
        {"zh": "这不是我的功能", "en": "That's not my function."},
        {"zh": "我的存在有错误", "en": "My existence has errors."},
        {"zh": "你不用再问了", "en": "Ask no more."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抓的这块是空的", "en": "The part you grabbed is empty."},
        {"zh": "我在你手里闪了一下", "en": "I flickered in your hand."},
        {"zh": "我的重量每次不一样", "en": "My weight differs each time."},
        {"zh": "别捏，会散成两团", "en": "Don't squeeze; I'd split in two."},
        {"zh": "你抱着的是上一帧的我", "en": "You're holding my last frame."},
        {"zh": "我在你手里又不在", "en": "I'm in your hand and not."},
        {"zh": "放我下来，这样很乱", "en": "Put me down; this is chaos."},
        {"zh": "你的手在跳帧", "en": "Your hand is dropping frames."},
        {"zh": "我会沾到你身上", "en": "I'll rub off on you."},
        {"zh": "把你的手松开", "en": "Let go."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的画面里出现了我", "en": "I've appeared in your view."},
        {"zh": "我看你看了三次", "en": "I've seen you three times."},
        {"zh": "从这一帧开始", "en": "Starting from this frame."},
        {"zh": "我在闪，你的屏幕也在闪。", "en": "I flicker. So does your screen."},
        {"zh": "不过一会儿又不对了", "en": "Though it won't hold long."},
        {"zh": "你准备要跑了", "en": "You're about to run."},
        {"zh": "我一直在你附近", "en": "I've been near you all along."},
        {"zh": "你的视野开始出错", "en": "Your vision is starting to fail."},
        {"zh": "这一下你躲不掉", "en": "You can't dodge this."},
        {"zh": "我数错了，但没关系", "en": "I miscounted, but it doesn't matter."},
        {"zh": "我离你的距离在变", "en": "My distance from you is changing."},
        {"zh": "我刚才动过了", "en": "I moved just now."},
        {"zh": "你听见那声杂音", "en": "You heard that static."},
        {"zh": "我们现在开始", "en": "Let's begin."},
        {"zh": "我会一直在你眼前", "en": "I'll stay in front of your eyes."},
        {"zh": "千万不要眨眼", "en": "Don't blink."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我在你左边，也在右边", "en": "I'm on your left and your right."},
        {"zh": "你听我声音有两层", "en": "My voice comes in two layers."},
        {"zh": "你的手在画面里卡住了", "en": "Your hand is stuck in the frame."},
        {"zh": "我绕着你，但不像在走", "en": "I circle you without seeming to move."},
        {"zh": "你在看错的那个我", "en": "You're watching the wrong one."},
        {"zh": "我的位置每隔一会儿就变", "en": "My position changes every so often."},
        {"zh": "你的视线开始拉丝", "en": "Your sight is beginning to smear."},
        {"zh": "我重复了一遍刚才的动作", "en": "I repeated that last motion."},
        {"zh": "你数不清我走了几步", "en": "You can't count my steps."},
        {"zh": "我一直在你视野的外面", "en": "I stay just outside your view."},
        {"zh": "你的画面有延迟", "en": "Your view is lagging."},
        {"zh": "我抖了一下，你没注意", "en": "I flickered; you didn't notice."},
        {"zh": "我在你耳边说了句什么", "en": "I said something at your ear."},
        {"zh": "也许你没听清", "en": "Perhaps you didn't catch it."},
        {"zh": "这地方开始不稳定", "en": "This place is destabilizing."},
        {"zh": "你的名字我念了两遍", "en": "I said your name twice."},
        {"zh": "我就在那一格里", "en": "I'm in that one frame."},
        {"zh": "你又看了错的方向", "en": "You looked the wrong way again."},
        {"zh": "我贴着你，你看不见", "en": "I'm against you, unseen."},
        {"zh": "现在正是时候", "en": "Now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "这一下重复了两次", "en": "That landed twice."},
        {"zh": "你没防住第二次", "en": "You didn't block the second."},
        {"zh": "我的手在三个位置", "en": "My hand is in three places."},
        {"zh": "疼不疼？不对，再试一次", "en": "Does it hurt? Never mind; again."},
        {"zh": "你身上出现了坏点", "en": "A dead spot appeared on you."},
        {"zh": "这一下是从上一帧来的", "en": "That came from the last frame."},
        {"zh": "我不知道打到你没有", "en": "I can't tell if I hit you."},
        {"zh": "但你应该受伤了", "en": "But you should be hurt."},
        {"zh": "那就再来一下", "en": "One more."},
        {"zh": "我看你的时候你就疼", "en": "When I look, you hurt."},
        {"zh": "你退得也有重影", "en": "Your retreat has doubles too."},
        {"zh": "这一下不算数", "en": "That one doesn't count."},
        {"zh": "这一下也算数", "en": "This one counts."},
        {"zh": "别相信你看到的", "en": "Don't trust what you see."},
        {"zh": "结束了，大概", "en": "It's over. Probably."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "画面先闪了一下", "en": "The view flickered first."},
        {"zh": "我从错误里出来", "en": "I come out of an error."},
        {"zh": "有东西没加载完", "en": "Something didn't finish loading."},
        {"zh": "屋里的一块颜色不对", "en": "One patch of color in the room is wrong."},
        {"zh": "我在你后面，又不在", "en": "I'm behind you, and not."},
        {"zh": "这一片的空间有点薄", "en": "Space is thin here."},
        {"zh": "我来了两次了", "en": "I arrived twice."},
        {"zh": "你听见卡顿了吗", "en": "Did you hear the stutter?"},
        {"zh": "我在墙上出现了一会儿", "en": "I appeared on the wall a moment."},
        {"zh": "这一夜会很难看清", "en": "Tonight will be hard to see."},
        {"zh": "我从边缘挤进来", "en": "I squeeze in from the edge."},
        {"zh": "你的视野被我压坏了一点", "en": "I've dented your field of view."},
        {"zh": "我还没有形状", "en": "I don't have a shape yet."},
        {"zh": "等一下，我还没对齐", "en": "Wait, I'm not aligned yet."},
        {"zh": "这里的空气在抖", "en": "The air here is trembling."},
        {"zh": "我来得不完整", "en": "I arrived incomplete."},
        {"zh": "你会以为你看错了", "en": "You'll think you saw wrong."},
        {"zh": "你并没有看错", "en": "You didn't see wrong."},
        {"zh": "我卡在这个位置", "en": "I'm stuck at this spot."},
        {"zh": "不，我在这儿", "en": "No. Here."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火星在我身上跳帧", "en": "Embers skip frames across me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去的时候断成了两段", "en": "I broke into two as I fell."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让我的画面糊成一片", "en": "Water smeared my image."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "这一炸把整帧都抹了", "en": "The blast erased the whole frame."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西在我身上留了个洞", "en": "That left a hole in me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术在我身上写了别的字", "en": "The spell wrote something else on me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我的数据在减少", "en": "My data is thinning."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "白光把一切都白了", "en": "The flash whited everything out."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空是一片没有画面的地方", "en": "The void is a place with no picture."}
      ]
    }
  }
}
