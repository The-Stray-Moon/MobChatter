{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我退到能藏住的地方", "en": "I back into somewhere I can hide."},
        {"zh": "你数数，我先躲", "en": "You count; I'll hide first."},
        {"zh": "我绕着屋子找藏身处", "en": "I circle the room for a hiding spot."},
        {"zh": "我走过去，你听不见", "en": "I pass, and you don't hear."},
        {"zh": "我走一步藏一下", "en": "I hide between every step."},
        {"zh": "你看着我，我就慢下来", "en": "When you watch, I slow down."},
        {"zh": "我在柜子和墙之间挪", "en": "I shift between cupboard and wall."},
        {"zh": "我走得不快，怕被发现", "en": "Not fast; I don't want to be found."},
        {"zh": "踩到地板会响", "en": "The floorboards give me away."},
        {"zh": "我沿窗帘后面走", "en": "I move behind the curtain."},
        {"zh": "我离你远一点才好藏", "en": "I need distance to hide well."},
        {"zh": "我在找一个你看不到的角", "en": "I'm looking for a corner you can't see."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "你找到我了吗", "en": "Have you found me yet?"},
        {"zh": "我在这儿等着", "en": "I'm waiting here."},
        {"zh": "别数得那么快", "en": "Don't count so fast."},
        {"zh": "这个地方够暗", "en": "This place is dark enough."},
        {"zh": "我把呼吸压得很低", "en": "I keep my breath low."},
        {"zh": "你还没来找我", "en": "You haven't come looking."},
        {"zh": "我开始等得不耐烦了", "en": "I'm growing impatient."},
        {"zh": "我藏得非常好", "en": "I've hidden very well."},
        {"zh": "你走过我旁边了", "en": "You walked right past me."},
        {"zh": "再玩一次好吗", "en": "One more game?"},
        {"zh": "这次你当找的人", "en": "This time you're the seeker."},
        {"zh": "我数到十就开始", "en": "I start at ten."},
        {"zh": "我这局一定赢", "en": "I'll win this round."},
        {"zh": "别提前掀开帘子", "en": "Don't lift the curtain early."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "快点来找我呀", "en": "Come find me."},
        {"zh": "你不觉得这很有趣吗", "en": "Don't you find this fun?"},
        {"zh": "我就在你附近", "en": "I'm near you."},
        {"zh": "你听听，谁在说话", "en": "Listen; who's speaking?"},
        {"zh": "你猜我在哪扇门后", "en": "Guess which door I'm behind."},
        {"zh": "你不来，我就要过去了", "en": "If you don't come, I'll come to you."},
        {"zh": "再走近一点点", "en": "Come a little closer."},
        {"zh": "你这样站着不好玩", "en": "Standing there isn't any fun."},
        {"zh": "我们可是约好的", "en": "We had an agreement."},
        {"zh": "你要认真找才行", "en": "You have to look properly."},
        {"zh": "别看天花板上面", "en": "Don't look at the ceiling."},
        {"zh": "我已经数到十", "en": "I've counted to ten."},
        {"zh": "你在想什么呢", "en": "What are you thinking?"},
        {"zh": "你是不是怕我", "en": "Are you afraid of me?"},
        {"zh": "那就当是游戏", "en": "Then treat it as a game."},
        {"zh": "你要是不找，我就出来", "en": "If you won't look, I'll come out."},
        {"zh": "这一局你输了", "en": "You lost this round."},
        {"zh": "我们玩得挺好的", "en": "We're getting along well."},
        {"zh": "再来一局好吗", "en": "Shall we play again?"}
      ]
    },
