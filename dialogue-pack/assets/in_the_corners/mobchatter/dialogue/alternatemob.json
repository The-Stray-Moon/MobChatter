{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我比它快一点。", "en": "I am a little faster than it."},
        {"zh": "我一动，就很突然。", "en": "When I move, it is sudden."},
        {"zh": "我在你旁边，不是后面。", "en": "I am beside you, not behind."},
        {"zh": "这一步跨得很远。", "en": "This stride covers a lot."},
        {"zh": "你走三步，我一步。", "en": "You take three steps. I take one."},
        {"zh": "我贴着走廊的墙。", "en": "I keep to the corridor wall."},
        {"zh": "我的脚步声比它快。", "en": "My footfalls are quicker."},
        {"zh": "我总是在你侧后方。", "en": "I am always at your rear flank."},
        {"zh": "灯照过来，我已经过去了。", "en": "The light arrives after I have passed."},
        {"zh": "我拐了弯，又出现。", "en": "I round a corner and appear again."},
        {"zh": "我又跑到前面去了。", "en": "I have run ahead again."},
        {"zh": "这一整段，我走了两遍。", "en": "I have walked this whole stretch twice."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，偶尔动一下。", "en": "I stand, and twitch sometimes."},
        {"zh": "我在等你走远。", "en": "I wait for you to walk on."},
        {"zh": "这一段路很暗。", "en": "This stretch is dark."},
        {"zh": "我记着你的路线。", "en": "I have your route memorized."},
        {"zh": "你停下，我就在门后停。", "en": "Stop, and I stop behind the door."},
        {"zh": "我不急，我快。", "en": "No hurry. I am fast."},
        {"zh": "这间屋子有两个出口。", "en": "This room has two exits."},
        {"zh": "我在那个出口。", "en": "I am at that exit."},
        {"zh": "你听见脚步了吗。", "en": "Did you hear footsteps?"},
        {"zh": "你回头，只有墙。", "en": "Look back and there is only wall."},
        {"zh": "我站得比门框还静。", "en": "I stand stiller than the doorframe."},
        {"zh": "我知道你要去哪儿。", "en": "I know where you are going."},
        {"zh": "我比它更靠近。", "en": "I am closer than it was."},
        {"zh": "我在你视野外面。", "en": "I am outside your sight."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我在这儿。", "en": "I am here."},
        {"zh": "刚才那一步，是我。", "en": "That step was mine."},
        {"zh": "你看的方向，错了。", "en": "You are looking the wrong way."},
        {"zh": "你一抬头就看见我的脸。", "en": "Look up and you'll see my face."},
        {"zh": "你转身太快了。", "en": "You turned too fast."},
        {"zh": "我们之间只有半步。", "en": "Only half a step between us."},
        {"zh": "我在你的余光里。", "en": "I am in the corner of your eye."},
        {"zh": "别看了，来不及。", "en": "Do not look. Too late."},
        {"zh": "你听见的是我。", "en": "What you heard was me."},
        {"zh": "我不藏了。", "en": "I am done hiding."},
        {"zh": "你看，我就在这儿。", "en": "See? Right here."},
        {"zh": "这次我比上次快。", "en": "I am faster than last time."},
        {"zh": "你还没准备好。", "en": "You are not ready."},
        {"zh": "那就别准备了。", "en": "Then do not prepare."},
        {"zh": "这一眼，你躲不开。", "en": "You cannot escape this look."},
        {"zh": "你好。", "en": "Hello."},
        {"zh": "这不礼貌吧。", "en": "This is rude, is it not."},
        {"zh": "我无所谓。", "en": "I do not mind."},
        {"zh": "很快的。", "en": "It will be quick."},
        {"zh": "我比那个影子快半步。", "en": "I'm half a step faster than that shade."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你打中的地方没有血。", "en": "There's no blood where you struck."},
        {"zh": "我退开，但还看着你。", "en": "I step back, still watching you."},
        {"zh": "你的手劲我记住了。", "en": "I'll remember the strength of that hand."},
        {"zh": "我被撞得偏了一下，站回来。", "en": "I was knocked askew and straightened back."},
        {"zh": "你手很快。", "en": "Your hand is quick."},
        {"zh": "我也快。", "en": "So am I."},
        {"zh": "这点伤，我数不过来。", "en": "I have lost count of wounds like this."},
        {"zh": "我还在你旁边。", "en": "I am still beside you."},
        {"zh": "你只赢了一下。", "en": "You won one moment."},
        {"zh": "下次不会了。", "en": "It will not happen again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你举着的，我不需要。", "en": "I do not need what you hold up."},
        {"zh": "太快了，来不及。", "en": "Too fast. No time."},
        {"zh": "你端来的东西我不要。", "en": "I don't want what you bring me."},
        {"zh": "我比 Stalk 快一点。", "en": "I'm a little faster than a Stalk."},
        {"zh": "你手里没别的了？", "en": "Is that all you have?"},
        {"zh": "这拦不住我。", "en": "That will not stop me."},
        {"zh": "我比你快半步。", "en": "I am half a step faster."},
        {"zh": "我看到了。", "en": "I saw it."},
        {"zh": "留着吧。", "en": "Keep it."},
        {"zh": "没用的。", "en": "No use."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我了，很快。", "en": "You hit me, and quickly."},
        {"zh": "我一侧身就过去了。", "en": "One sidestep and I am past."},
        {"zh": "你来不及反应。", "en": "You had no time to react."},
        {"zh": "我们擦了一下。", "en": "We brushed past."},
        {"zh": "比同类快一点，也轻一点。", "en": "Faster than my kin, and lighter."},
        {"zh": "你退开时我学着你的样子。", "en": "When you back away, I copy you."},
        {"zh": "我撞开你的手。", "en": "I knocked your hand aside."},
        {"zh": "这一下太快了。", "en": "That was too fast."},
        {"zh": "你没看清我。", "en": "You did not see me clearly."},
        {"zh": "别追。", "en": "Do not follow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这里不需要第二个我。", "en": "This place doesn't need a second me."},
        {"zh": "我们只是同类。", "en": "We are only the same kind."},
        {"zh": "它在另一条走廊。", "en": "It is in the other corridor."},
        {"zh": "我们交替出现。", "en": "We take turns appearing."},
        {"zh": "你分不清谁是谁。", "en": "You cannot tell which is which."},
        {"zh": "这样更好。", "en": "This is better."},
        {"zh": "两个速度，一个目的。", "en": "Two speeds, one purpose."},
        {"zh": "它先动，我后动。", "en": "It moves first. I move after."},
        {"zh": "你只看到一个。", "en": "You only see one."},
        {"zh": "而我们有两个。", "en": "And there are two of us."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你掉的东西，我拿走了。", "en": "I took what you dropped."},
        {"zh": "太快，你没看见。", "en": "Too quick. You did not see."},
        {"zh": "这上面全是你的气息。", "en": "This is covered in your scent."},
        {"zh": "我扔在别处了。", "en": "I left it somewhere else."},
        {"zh": "你找找看。", "en": "Go and look."},
        {"zh": "我只是想看看你丢什么。", "en": "I only want to see what you drop."},
        {"zh": "它现在在台阶上。", "en": "It is on the stairs now."},
        {"zh": "你不该掉东西。", "en": "You should not drop things."},
        {"zh": "我比它快一点，就够赢。", "en": "A little faster than it; that is enough."},
        {"zh": "回头再说。", "en": "We will speak later."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你的路线我早就知道了。", "en": "I already know the route you'll take."},
        {"zh": "你已经回头两次了。", "en": "You have looked back twice."},
        {"zh": "我就在那个拐角。", "en": "I am at that corner."},
        {"zh": "这次我不等。", "en": "This time I do not wait."},
        {"zh": "你听见的那声，是我。", "en": "That sound you heard was me."},
        {"zh": "距离还剩九步。", "en": "Nine steps left."},
        {"zh": "我在缩短它。", "en": "I am shortening it."},
        {"zh": "你开始跑了。", "en": "You have started to run."},
        {"zh": "对，就站在那儿别动。", "en": "Yes, stay right there and don't move."},
        {"zh": "我也跑。", "en": "So do I."},
        {"zh": "你选的每条路我都走过。", "en": "I've walked every path you might choose."},
        {"zh": "我快过它一线。", "en": "I am a hair faster than it."},
        {"zh": "这一点，够用。", "en": "That little is enough."},
        {"zh": "你数到的那一步我到了。", "en": "I arrived on the step you counted."},
        {"zh": "别停。", "en": "Do not stop."},
        {"zh": "停也没用。", "en": "Stopping will not help."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你的节奏。", "en": "I match your pace."},
        {"zh": "你快，我也快。", "en": "You speed up. So do I."},
        {"zh": "你慢，我就慢。", "en": "You slow. So do I."},
        {"zh": "我在你身后半步。", "en": "Half a step behind you."},
        {"zh": "又变成旁边了。", "en": "Now I am beside you."},
        {"zh": "你转头，我换边。", "en": "You turn your head and I switch sides."},
        {"zh": "你左脚落地比右脚重。", "en": "Your left foot lands heavier than your right."},
        {"zh": "我的，你听不清。", "en": "Mine, you cannot pick out."},
        {"zh": "这一段走廊很长。", "en": "This corridor is long."},
        {"zh": "够我到你了。", "en": "Long enough for me to reach you."},
        {"zh": "灯在你手里。", "en": "The lamp is in your hand."},
        {"zh": "它照不到后面。", "en": "It does not light behind you."},
        {"zh": "我就在后面。", "en": "I am behind."},
        {"zh": "前面还是后面？", "en": "Front or behind?"},
        {"zh": "你猜。", "en": "Guess."},
        {"zh": "猜错了。", "en": "Wrong."},
        {"zh": "再猜。", "en": "Guess again."},
        {"zh": "算了。", "en": "Never mind."},
        {"zh": "我已经站在你身后了。", "en": "I'm standing behind you now."},
        {"zh": "我贴上来了。", "en": "I am on you now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一下就到了。", "en": "I was there in one move."},
        {"zh": "你来不及挡。", "en": "You had no time to block."},
        {"zh": "这一下很轻，很快。", "en": "Light and fast."},
        {"zh": "我扣住你的手腕。", "en": "I close on your wrist."},
        {"zh": "你被拽了一把。", "en": "You are yanked off balance."},
        {"zh": "我的另一只手在背后。", "en": "My other hand is at your back."},
        {"zh": "你听见风声。", "en": "You hear the wind."},
        {"zh": "镜子里的我先动了。", "en": "The me in the mirror moved first."},
        {"zh": "我退开得也快。", "en": "I retreat quickly too."},
        {"zh": "你看，什么都没有。", "en": "See? Nothing there."},
        {"zh": "下次我会更早。", "en": "Next time I will be earlier."},
        {"zh": "你的手从我身体里穿过。", "en": "Your hand passes through my body."},
        {"zh": "我比它快，就这一点。", "en": "I am faster than it. That is all."},
        {"zh": "够用了。", "en": "It is enough."},
        {"zh": "再见。", "en": "Goodbye."},
        {"zh": "很快。", "en": "Soon."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我先动，声音后到。", "en": "I move first. The sound arrives after."},
        {"zh": "走廊尽头闪了一下。", "en": "Something flickered at the end of the corridor."},
        {"zh": "这地方很好跑。", "en": "Good ground for running here."},
        {"zh": "我落脚很轻。", "en": "I set down lightly."},
        {"zh": "你听见的是我学你的声音。", "en": "What you heard was me copying your voice."},
        {"zh": "那是我的第一步。", "en": "That was my first step."},
        {"zh": "我比预想的早。", "en": "I am earlier than expected."},
        {"zh": "这里灯太少。", "en": "Too few lamps here."},
        {"zh": "这条走廊我比你熟。", "en": "I know this hallway better than you."},
        {"zh": "你走那边的。", "en": "You take that one."},
        {"zh": "我会在中间等你。", "en": "I will wait in the middle."},
        {"zh": "你还有很多路。", "en": "You have a long way to go."},
        {"zh": "我先热身。", "en": "I will warm up first."},
        {"zh": "空气凉了一点。", "en": "The air went a little cold."},
        {"zh": "我站在两个门之间。", "en": "I stand between two doors."},
        {"zh": "你看哪一个。", "en": "Which one do you watch?"},
        {"zh": "都看也没用。", "en": "Watching both will not help."},
        {"zh": "我从走廊尽头走过来。", "en": "I come walking from the end of the hall."},
        {"zh": "比你想的快。", "en": "Faster than you thought."},
        {"zh": "眨眼的一瞬我换了位置。", "en": "I move in the instant you blink."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光照到我，我的位置暴露了。", "en": "The firelight shows where I am."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉下去，翻身就起。", "en": "I fall and roll to my feet."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水拖慢了我。", "en": "The water slowed me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我推开了。", "en": "The blast pushed me off line."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根东西擦过我。", "en": "Something grazed me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这道咒抓住了我的脚。", "en": "This hex caught my feet."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿这东西，早就没了。", "en": "Hunger left me long ago."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一闪，我停了半秒。", "en": "The flash stopped me for half a second."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有路可以跑。", "en": "There is no road to run here."}
      ]
    }
  }
}
