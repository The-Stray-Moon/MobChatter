{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面爬过去", "en": "I crawl low across the floor."},
        {"zh": "手指一下一下地挪", "en": "My fingers creep, one by one."},
        {"zh": "没有身子，只有一只手", "en": "No body, only a hand."},
        {"zh": "我从柜子边溜过去", "en": "I slip past the cupboard."},
        {"zh": "指尖点地，像在数步", "en": "My fingertips tap as if counting."},
        {"zh": "我朝你的方向挪", "en": "I inch toward you."},
        {"zh": "屋子里的灰都被我扫了", "en": "I sweep the dust as I go."},
        {"zh": "你看不见我怎么动的", "en": "You won't see how I move."},
        {"zh": "我挪到门口就停", "en": "I stop at the doorway."},
        {"zh": "一只手也能走很远", "en": "A single hand can travel far."},
        {"zh": "我沿着墙根绕", "en": "I skirt along the wall."},
        {"zh": "指节咔咔地响", "en": "My knuckles click."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在半空，指头张开", "en": "I hang in the air, fingers spread."},
        {"zh": "我在等一个人来玩", "en": "I wait for someone to play."},
        {"zh": "手指一根根动着", "en": "My fingers flex one by one."},
        {"zh": "女巫走了，屋子空了", "en": "The witch left; the hut is empty."},
        {"zh": "我不动，就像件道具", "en": "Still, and I look like a mere prop."},
        {"zh": "袖口还沾着药水味", "en": "Potion stains cling to my cuff."},
        {"zh": "你猜我出什么", "en": "Guess what I'll throw."},
        {"zh": "指头在桌上敲", "en": "Fingers tap on the table."},
        {"zh": "这屋里灰多得吓人", "en": "The dust in here is frightening."},
        {"zh": "我准备了三样东西", "en": "I have three things ready."},
        {"zh": "来跟我玩一局吧", "en": "Come play a round with me."},
        {"zh": "我从来不会先出", "en": "I never throw first."},
        {"zh": "我安静的时候最让人不安", "en": "My silence is the most unsettling."},
        {"zh": "门开着，风进来了", "en": "The door's open; wind comes in."},
        {"zh": "我五指张开又慢慢收拢", "en": "I spread five fingers and slowly close them"},
        {"zh": "这游戏我赢过很多人", "en": "I've beaten many at this game."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你来玩一局吗", "en": "Will you play a round?"},
        {"zh": "石头、纸、剪刀，选一个", "en": "Stone, paper, or shears. Pick one."},
        {"zh": "我看着你的手", "en": "I'm watching your hands."},
        {"zh": "别急着把手伸过来", "en": "Don't hurry to reach out."},
        {"zh": "你觉得能赢我？", "en": "Think you can beat me?"},
        {"zh": "赢了我，我就听你的", "en": "Win, and I'll obey you."},
        {"zh": "输了可不许哭", "en": "No crying if you lose."},
        {"zh": "我把规则说一遍", "en": "Let me state the rules once."},
        {"zh": "你把东西举起来我瞧瞧", "en": "Hold up what you've chosen."},
        {"zh": "这屋子归女巫，但她不在", "en": "This hut is the witch's, but she's out."},
        {"zh": "你的指头在打颤", "en": "Your fingers are trembling"},
        {"zh": "我看得见你袖子里的东西", "en": "I can see what's up your sleeve."},
        {"zh": "坐下吧，站着不好玩", "en": "Sit; standing spoils the game."},
        {"zh": "我只有一只手，也够了", "en": "One hand is all I need."},
        {"zh": "你出什么都一样", "en": "Whatever you throw, it's the same."},
        {"zh": "这局棋我等了几十年", "en": "I have waited decades for this round"},
        {"zh": "别摸我，我不喜欢", "en": "Don't touch me; I dislike it."},
        {"zh": "你想清楚了再出", "en": "Think before you choose."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手指头！", "en": "My fingers!"},
        {"zh": "别把我掰弯了", "en": "Don't bend me."},
        {"zh": "布料都被撕了", "en": "The cloth is all torn."},
        {"zh": "我快要抓不住了", "en": "I can't hold on much longer."},
        {"zh": "疼，但我还能动", "en": "It hurts, but I can still move."},
        {"zh": "你踩到我手上了", "en": "You stepped on my hand."},
        {"zh": "我掉到了地上", "en": "I fell to the floor."},
        {"zh": "这笔账我记着", "en": "I'm keeping that score."},
        {"zh": "手套里都是灰", "en": "Dust is inside me."},
        {"zh": "我还能爬起来", "en": "I can still get up."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这不是石头也不是纸", "en": "That's neither stone nor paper."},
        {"zh": "你要用它跟我玩？", "en": "Will you play with that?"},
        {"zh": "你手上的东西太新了", "en": "What you hold is too new."},
        {"zh": "我不吃这个，我只玩", "en": "I don't eat it; I only play."},
        {"zh": "举高点，让我看清楚", "en": "Hold it higher so I can see."},
        {"zh": "你倒是会讨好", "en": "You do know how to flatter."},
        {"zh": "我更喜欢剪刀", "en": "I prefer shears."},
        {"zh": "规矩是不能破的", "en": "The rules cannot be broken."},
        {"zh": "我没什么想要的", "en": "There's nothing I want."},
        {"zh": "先玩，别的以后说", "en": "Play first; the rest later."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的指头了", "en": "You bumped my fingers."},
        {"zh": "一只手也会被撞疼", "en": "Even a hand can be hurt."},
        {"zh": "别踩到我身上", "en": "Don't step on me."},
        {"zh": "我抓了你一下，不是故意的", "en": "I grabbed you; it wasn't meant."},
        {"zh": "让开点，我要过去", "en": "Move; I'm passing."},
        {"zh": "布料蹭得我发麻", "en": "The cloth makes me tingle."},
        {"zh": "这张桌子太矮了", "en": "This table is too low."},
        {"zh": "我又不是地板", "en": "I'm not the floor."},
        {"zh": "我们挤在同一个角落", "en": "We're crammed into the same corner."},
        {"zh": "再撞我就抓你", "en": "Bump me again and I'll grab you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一只手套", "en": "I'm only a glove."},
        {"zh": "这种事我做不到", "en": "That's beyond me."},
        {"zh": "找别的手套去吧", "en": "Find another glove."},
        {"zh": "我没有那部分", "en": "I haven't the parts for it."},
        {"zh": "游戏比这个有意思", "en": "The game is more interesting."},
        {"zh": "别把手套当人", "en": "Don't treat a glove as a person."},
        {"zh": "我的指头只想出拳", "en": "My fingers only want to play."},
        {"zh": "女巫说过不许", "en": "The witch forbade it."},
        {"zh": "我只有五根指头，别胡说", "en": "I have only five fingers; do not be silly"},
        {"zh": "咱们说点别的", "en": "Let's talk of something else."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你是想戴上我？", "en": "You mean to wear me?"},
        {"zh": "手指别硬往里塞", "en": "Don't force your fingers in."},
        {"zh": "我里面凉得很", "en": "It's very cold inside me."},
        {"zh": "你戴上了可别乱动", "en": "Once you wear me, don't thrash about."},
        {"zh": "这尺寸不太对", "en": "The size isn't right."},
        {"zh": "我可以抓东西了", "en": "Now I can grab things."},
        {"zh": "你手心出汗了", "en": "Your palm is sweating."},
        {"zh": "放我下来，我要自己走", "en": "Put me down; I walk myself."},
        {"zh": "这样看世界有点歪", "en": "The world looks crooked from here."},
        {"zh": "你把我戴反了", "en": "You've put me on backwards."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你先坏了规矩", "en": "You broke the rules first."},
        {"zh": "那就别玩下去了", "en": "Then we stop playing."},
        {"zh": "我这就抓住你", "en": "I'm grabbing you now."},
        {"zh": "你出的是拳头？不算", "en": "Was that a fist? Doesn't count."},
        {"zh": "这局我记下了", "en": "I'll remember this round."},
        {"zh": "我从来不吃亏", "en": "I never come out behind."},
        {"zh": "你走不出这间屋子", "en": "You won't leave this hut."},
        {"zh": "手套也能攥紧", "en": "A glove can clench too."},
        {"zh": "你猜我下一步", "en": "Guess my next move."},
        {"zh": "我现在不高兴了", "en": "I'm displeased now."},
        {"zh": "女巫的屋子不许乱来", "en": "No trouble in the witch's hut."},
        {"zh": "过来，我们重来一局", "en": "Come here; we play again."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我数着你的手指", "en": "I'm counting your fingers."},
        {"zh": "你已经握成拳了", "en": "You've closed your fist."},
        {"zh": "别以为我看不见", "en": "Don't think I can't see."},
        {"zh": "我沿着桌沿靠近", "en": "I'm creeping along the table's edge."},
        {"zh": "你退到墙边也没用", "en": "Backing to the wall won't help."},
        {"zh": "我比你想的灵活", "en": "I'm quicker than you think."},
        {"zh": "这屋子只有一个门", "en": "This hut has one door."},
        {"zh": "把手伸出来，我先出", "en": "Hold out your hand; I play first"},
        {"zh": "指节已经绷紧了", "en": "My knuckles are drawn tight."},
        {"zh": "你是石头，还是纸", "en": "Stone, or paper?"},
        {"zh": "我猜你出剪刀", "en": "I'd guess shears."},
        {"zh": "最后一步，别动", "en": "One last step; don't move."},
        {"zh": "我抓住了就松不开", "en": "Once I grip, I don't let go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我终于抓住你", "en": "I've got you."},
        {"zh": "我把指头攥紧了", "en": "I've clenched my fingers."},
        {"zh": "拧一下就够了", "en": "One twist is enough."},
        {"zh": "别挣，越挣越疼", "en": "Don't struggle; it hurts more."},
        {"zh": "这一下算你输", "en": "That counts as your loss."},
        {"zh": "我只有一下，但够疼", "en": "I strike once, but it stings."},
        {"zh": "你手上留印了", "en": "My mark is on your hand."},
        {"zh": "放手？我不放", "en": "Let go? I don't."},
        {"zh": "剪刀赢了石头", "en": "Shears beat stone."},
        {"zh": "下一局再来找我", "en": "Come back for the next round."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "屋子里的手醒了", "en": "The hand in the hut woke up."},
        {"zh": "我从柜子里滑出来", "en": "I slide out of the cabinet."},
        {"zh": "女巫又出门了", "en": "The witch has gone out again."},
        {"zh": "没人来陪我玩", "en": "No one comes to play with me."},
        {"zh": "桌上摆了三样东西", "en": "Three things lie on the table."},
        {"zh": "指头一根根张开", "en": "My fingers spread one by one."},
        {"zh": "这房间还留着药味", "en": "The room still smells of potions."},
        {"zh": "我爬上了椅背", "en": "I've climbed the chair's back."},
        {"zh": "门吱呀响了一声", "en": "The door creaked once."},
        {"zh": "我等着第一个客人", "en": "I wait for the first guest."},
        {"zh": "灰尘落在我身上", "en": "Dust settles on me."},
        {"zh": "我活动了一下指节", "en": "I work my knuckles loose."},
        {"zh": "又有人闯进来了", "en": "Someone's broken in again."},
        {"zh": "这一局该我赢了", "en": "This round should be mine."}
      ]
    },
