{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我小跑着跟在你脚边", "en": "I trot along at your heels."},
        {"zh": "我拖着步子，像没睡醒", "en": "I drag my feet like I haven't slept."},
        {"zh": "我在你前面探路", "en": "I scout ahead of you."},
        {"zh": "爪子在地上划出细声", "en": "My claws scrape softly on the ground."},
        {"zh": "我绕着你转半圈", "en": "I circle half around you."},
        {"zh": "走两步就回头看你", "en": "Two steps, then a glance back at you."},
        {"zh": "我个子小，容易撞到东西", "en": "Small as I am, I bump into things."},
        {"zh": "到了末地我可不一样了", "en": "In the End I'll be different."},
        {"zh": "我踩着你的脚印走", "en": "I step in your footprints."},
        {"zh": "我不太稳，腿短", "en": "I'm unsteady; my legs are short."},
        {"zh": "我加快步子追上你", "en": "I quicken my pace to catch you."},
        {"zh": "这条路我记得", "en": "I remember this road."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在门口等着", "en": "I crouch in the doorway, waiting."},
        {"zh": "我抓了抓耳朵", "en": "I scratch my ear."},
        {"zh": "这里的空气我不习惯", "en": "I'm not used to this air."},
        {"zh": "我盯着你看了一会儿", "en": "I stare at you a while."},
        {"zh": "我没睡，只是闭眼", "en": "I'm not asleep; just eyes shut."},
        {"zh": "我的爪子有点脏", "en": "My claws are a bit dirty."},
        {"zh": "我等着你的手势", "en": "I wait for your gesture."},
        {"zh": "我听见远处有动静", "en": "I hear something far off."},
        {"zh": "我抖了抖肩膀", "en": "I shrug my shoulders."},
        {"zh": "这地方不像下界", "en": "This place isn't like the Nether."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那枚硬币", "en": "That coin in your hand."},
        {"zh": "你是要雇我吗", "en": "Are you hiring me?"},
        {"zh": "我的价钱不低", "en": "I don't come cheap."},
        {"zh": "你给了我，我就干活", "en": "Pay me, and I work."},
        {"zh": "别跟我耍花样", "en": "No tricks with me."},
        {"zh": "我认得你的味道了", "en": "I've learned your scent."},
        {"zh": "你要我做什么", "en": "What do you want of me?"},
        {"zh": "我脾气不好，但做事", "en": "Bad temper, good work."},
        {"zh": "你身后那影子是谁", "en": "Who's that shadow behind you?"},
        {"zh": "我先看看你的诚意", "en": "Let me see your sincerity first."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的爪子啊！", "en": "My claws!"},
        {"zh": "你把我打疼了", "en": "You hurt me."},
        {"zh": "我先往后退出", "en": "I'm backing off first."},
        {"zh": "这一拳分量不轻", "en": "That punch had weight."},
        {"zh": "挨这一下，我还站得住", "en": "One blow like that and I still stand"},
        {"zh": "别用脚来踢我", "en": "Don't kick me."},
        {"zh": "我的腿都麻了", "en": "My legs have gone numb."},
        {"zh": "我记住你的样子", "en": "I'll remember your face."},
        {"zh": "疼得我牙都松了", "en": "My teeth are loose from that."},
        {"zh": "再来一次我就咬", "en": "Once more and I bite."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "硬币？给我看看", "en": "A coin? Let me see."},
        {"zh": "这枚是真的吗", "en": "Is that one real?"},
        {"zh": "硬币先给我看看", "en": "Show me the coin first"},
        {"zh": "银的我不喜欢", "en": "I don't care for silver."},
        {"zh": "不够，再加点", "en": "Not enough; add more."},
        {"zh": "拿走，我得想想", "en": "Take it back; let me think."},
        {"zh": "我上过一次当", "en": "I've been cheated once before."},
        {"zh": "你先给，我再答", "en": "You pay first, then I answer."},
        {"zh": "我闻到金子的味道", "en": "I smell gold."},
        {"zh": "这买卖有点意思", "en": "This deal has some flavor."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩住了我的小指爪", "en": "You are standing on my little claw"},
        {"zh": "我腿短，躲不开", "en": "My legs are short; I can't dodge."},
        {"zh": "你别推着我走", "en": "Don't push me around."},
        {"zh": "我撞上去就缠住你", "en": "I'll cling on if I hit you."},
        {"zh": "让一让，我个子小", "en": "Let me through; I'm small."},
        {"zh": "我们撞成一团了", "en": "We've crashed into a heap."},
        {"zh": "我抓了你一下，抱歉", "en": "I scratched you; sorry."},
        {"zh": "这道门槛太高了", "en": "This threshold is too high."},
        {"zh": "我就贴着你走", "en": "I'll stick close beside you."},
        {"zh": "再挤我就钻地了", "en": "Squeeze me more and I'll burrow."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是雇来的，不是来成家的", "en": "I was hired, not to settle down."},
        {"zh": "这活儿不包含那种事", "en": "That's not in the job."},
        {"zh": "你要加点钱吗", "en": "Will you pay extra?"},
        {"zh": "我没这个打算", "en": "I have no such intention."},
        {"zh": "我换形态比换心情快", "en": "I change forms faster than moods."},
        {"zh": "别拿我开玩笑", "en": "Don't joke with me."},
        {"zh": "我跟谁都待不久", "en": "I don't stay with anyone long."},
        {"zh": "我还有活儿要干", "en": "I have work to do."},
        {"zh": "下界的小鬼不谈恋爱", "en": "Nether imps don't fall in love."},
        {"zh": "换一个话题吧", "en": "Let's change the subject."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "别揪我的后颈", "en": "Don't grab my scruff."},
        {"zh": "我爪子会划到你", "en": "My claws will scratch you."},
        {"zh": "把我放下来吧", "en": "Put me down."},
        {"zh": "我不喜欢被提起来", "en": "I dislike being lifted."},
        {"zh": "你能抓得稳吗", "en": "Can you hold me steady?"},
        {"zh": "别小看我这副小骨头", "en": "Do not underestimate these little bones"},
        {"zh": "这样我看不见前面", "en": "I can't see ahead like this."},
        {"zh": "你这是抱猫吗", "en": "Are you holding a cat?"},
        {"zh": "松手，我自己走", "en": "Let go; I'll walk."},
        {"zh": "我会记着这笔账", "en": "I'll remember this."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "就是那一个了", "en": "That's the one."},
        {"zh": "你退后，我来", "en": "Stand back; I'll handle it."},
        {"zh": "我闻到血腥味", "en": "I smell blood."},
        {"zh": "这个可以下手", "en": "This one's fair game."},
        {"zh": "这一单让我先上", "en": "Let me go first."},
        {"zh": "爪子已经伸出来了", "en": "My claws are already out."},
        {"zh": "别挡住我的路", "en": "Don't block my way."},
        {"zh": "他已经跑起来了", "en": "He's started running."},
        {"zh": "我已经盯上你", "en": "I've marked you."},
        {"zh": "这种活我很熟", "en": "I know this kind of work."},
        {"zh": "我数到三个数", "en": "I'll count to three."},
        {"zh": "他比我高，但我不怕", "en": "He's taller, but I'm not afraid."},
        {"zh": "这一单算我的", "en": "This one's mine."},
        {"zh": "爪子磨好了，可以上了", "en": "Claws are sharpened; ready to go"},
        {"zh": "让我先咬一口", "en": "Let me get the first bite."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴地爬过去", "en": "I crawl low toward him."},
        {"zh": "你走左边我走右", "en": "You take left; I take right."},
        {"zh": "我不叫，直接扑", "en": "No warning; I just pounce."},
        {"zh": "他看不见我的", "en": "He can't see me."},
        {"zh": "他的脚踝是空门", "en": "His ankles are wide open."},
        {"zh": "我正在绕圈子", "en": "I'm circling around."},
        {"zh": "别出手，等我先动", "en": "Don't strike; let me move first."},
        {"zh": "我的爪子够到他了", "en": "My claws can reach him."},
        {"zh": "他开始往后退", "en": "He's backing away."},
        {"zh": "我闻得到他的怕", "en": "I can smell his fear."},
        {"zh": "就等他转过身", "en": "Waiting for him to turn."},
        {"zh": "这影子是我的", "en": "This shadow is mine."},
        {"zh": "再靠近一点点", "en": "Half a step closer."},
        {"zh": "我贴到你脚边了", "en": "I'm at your heel now."},
        {"zh": "他喘得比我还急", "en": "He's panting worse than I am."},
        {"zh": "最后再来一下吧", "en": "One last strike."},
        {"zh": "别拉我，我还没完", "en": "Don't pull me back; I'm not done."},
        {"zh": "我咬住就不松", "en": "Once I bite, I don't let go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "咬住了就不放", "en": "Bite and hold."},
        {"zh": "我已经抓到你", "en": "Clawed you."},
        {"zh": "这一口够深的", "en": "That bite went deep."},
        {"zh": "别甩，甩不掉", "en": "Don't shake; I won't come off."},
        {"zh": "我个子小，牙不小", "en": "I'm small, but my teeth aren't."},
        {"zh": "再退我就追上去", "en": "Back off again and I chase."},
        {"zh": "疼就说明对了", "en": "Pain means it worked."},
        {"zh": "我专抓你的腿", "en": "I go for your legs."},
        {"zh": "这一下只是开始", "en": "That was only the start."},
        {"zh": "我一点都不累", "en": "I'm not tired at all."},
        {"zh": "你踩不到我的", "en": "You can't stomp on me."},
        {"zh": "再咬你一口吧", "en": "One more bite for you."},
        {"zh": "我缠住你的脚", "en": "I wrap your feet."},
        {"zh": "别说我下手狠", "en": "Don't call me cruel."},
        {"zh": "这一单干完了", "en": "This job is done."},
        {"zh": "老板，下一个", "en": "Boss, who's next?"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "硬币一响，我就来了", "en": "A coin rings, and here I am."},
        {"zh": "我从下界爬出来", "en": "I crawl up out of the Nether."},
        {"zh": "这地方真亮堂", "en": "This place is really bright."},
        {"zh": "我先看看四周", "en": "Let me look around first."},
        {"zh": "爪子已经落地", "en": "My claws have touched ground."},
        {"zh": "是谁把我唤来的", "en": "Who summoned me here?"},
        {"zh": "我换了副样子", "en": "I've taken a new shape."},
        {"zh": "这里的空气太干净", "en": "The air here is too clean."},
        {"zh": "我闻到了工作的味道", "en": "I smell work."},
        {"zh": "这一趟不会白跑", "en": "This trip won't be wasted."},
        {"zh": "锁链还在我身上", "en": "The chain is still on me."},
        {"zh": "我会变成什么，得看地方", "en": "What I become depends on where I am."},
        {"zh": "下界才是我的家", "en": "The Nether is my home."},
        {"zh": "别指望我客气", "en": "Don't expect manners."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火我见得多了，可还是烫", "en": "I've seen plenty of fire; still burns."}
      ]
    },
