      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我毛都立了", "en": "The bolt stood my fur on end."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空差点把我吞了", "en": "The void nearly took me."}
      ]
    }
  }
