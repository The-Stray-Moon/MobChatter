      "lines": [
        {"zh": "那东西嵌进了黄金里", "en": "That thing lodged in my gold."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这法术在拆我的骨架", "en": "The spell is unmaking my frame."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "没有火，我就空了", "en": "Without flame, I'm hollow."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光竟比我更亮", "en": "The bolt burned brighter than I."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗吞掉了我的光圈", "en": "The dark swallowed my circle of light."}
      ]
    }
  }
