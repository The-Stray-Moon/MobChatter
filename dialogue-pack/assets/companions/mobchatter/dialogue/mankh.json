{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬着，脚不落地", "en": "I hover; my feet never touch ground."},
        {"zh": "黄金的关节咔咔响", "en": "My golden joints click."},
        {"zh": "我绕着召唤者走", "en": "I circle the one who summoned me."},
        {"zh": "火环跟着我挪", "en": "The fire ring moves with me."},
        {"zh": "我走一步，地上焦一圈", "en": "Each step scorches a circle."},
        {"zh": "我拖着一道焦痕", "en": "I drag a trail of scorch marks."},
        {"zh": "面具下面没有呼吸", "en": "No breath beneath the mask."},
        {"zh": "我歪头看你，再歪回来", "en": "I tilt my head at you, then back."},
        {"zh": "我不踩草地，只踩石头", "en": "I walk on stone, not grass."},
        {"zh": "我的影子在墙上拖得很长", "en": "My shadow stretches long across the wall"},
        {"zh": "我一步一步量着距离", "en": "I measure the distance step by step."},
        {"zh": "靠近我的人都得退", "en": "Anyone near me must step back."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰在我脚下转圈", "en": "Flames circle beneath my feet."},
        {"zh": "我就这么浮着", "en": "I simply float."},
        {"zh": "面具正对着你", "en": "My mask faces you squarely."},
        {"zh": "我在等你下令", "en": "I wait for your command."},
        {"zh": "召唤的余温还没散", "en": "The summoning's warmth lingers."},
        {"zh": "我的黄金在发烫", "en": "My gold is hot to the touch."},
        {"zh": "火环缩了一圈", "en": "The fire ring tightens."},
        {"zh": "我一动不动，火却不停", "en": "I stay still, but the fire never does."},
        {"zh": "这具身体不累", "en": "This body doesn't tire."},
        {"zh": "远处的光晃了一下", "en": "A light flickers in the distance."},
        {"zh": "我数着地面传来的脚步", "en": "I count the footsteps coming through the ground"},
        {"zh": "图腾把我拴在这儿", "en": "The totem binds me here."},
        {"zh": "灰尘落在我肩上，烧没了", "en": "Dust lands on my shoulder and burns away."},
        {"zh": "我数着火焰的拍子", "en": "I count the rhythm of the flames."},
        {"zh": "不远处有人在看我", "en": "Someone's watching from nearby."},
        {"zh": "我不想动，除非有事", "en": "I won't move unless there's cause."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "是你把我唤来的", "en": "You are the one who called me."},
        {"zh": "黄金认得你的手", "en": "The gold knows your hand."},
        {"zh": "你要我去烧谁", "en": "Who do you want me to burn?"},
        {"zh": "我的面具下没有脸", "en": "There's no face beneath my mask."},
        {"zh": "请不要站得太近", "en": "Please don't stand too close."},
        {"zh": "我脚下的火不认人", "en": "The fire at my feet knows no friends."},
        {"zh": "你手里的图腾还热着", "en": "The totem in your hand is still warm."},
        {"zh": "我听得懂你，不必喊", "en": "I understand you; no need to shout."},
        {"zh": "你要我守哪一边", "en": "Which side am I to guard?"},
        {"zh": "这火不会自己熄灭", "en": "This fire won't die on its own."},
        {"zh": "别摸我的黄金", "en": "Don't touch my gold."},
        {"zh": "我为你而来，也会为你而散", "en": "I came for you, and will scatter for you."},
        {"zh": "你退后，我要转身", "en": "Step back; I'm turning."},
        {"zh": "我一直在等你开口", "en": "I've been waiting for you to speak."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的黄金裂了", "en": "My gold has cracked."},
        {"zh": "火被压下去了一点", "en": "The fire was pressed down."},
        {"zh": "我的面具歪了", "en": "My mask is askew."},
        {"zh": "这一下把火环的节拍打乱", "en": "That blow broke the rhythm of my fire ring"},
        {"zh": "火环暗了一瞬", "en": "The ring dimmed for an instant."},
        {"zh": "疼，但我还在", "en": "It hurts, but I remain."},
        {"zh": "我被撞得后退", "en": "I was knocked backwards."},
        {"zh": "黄金在不停掉屑", "en": "Gold flakes keep falling off me."},
        {"zh": "我的任务还没完", "en": "My task isn't done."},
        {"zh": "还能再撑一会儿", "en": "I can hold a while longer."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不吃人间的东西", "en": "I eat nothing of this world."},
        {"zh": "黄金是不会饿的", "en": "Gold does not hunger."},
        {"zh": "你把那东西拿远些", "en": "Take that thing further away."},
        {"zh": "火焰只认燃料", "en": "The flame only knows fuel."},
        {"zh": "我要的不是吃的", "en": "It isn't food I want."},
        {"zh": "给火环添点东西吧", "en": "Feed the ring instead."},
        {"zh": "你在试探我的底线", "en": "You're testing my limits."},
        {"zh": "这味道我不认识", "en": "I don't know that smell."},
        {"zh": "收起来，别烧了你的手", "en": "Put it away before it burns you."},
        {"zh": "我只需要命令", "en": "I need only a command."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "烫，快退开去", "en": "Hot; step back quickly."},
        {"zh": "火环碰到你了", "en": "The ring touched you."},
        {"zh": "我不擅长让路", "en": "I'm not good at giving way."},
        {"zh": "我的黄金很硬", "en": "My gold is hard."},
        {"zh": "别贴着火环走", "en": "Don't walk against the ring."},
        {"zh": "撞我不要紧，别撞火", "en": "Bump me, not the fire."},
        {"zh": "你身上有焦味了", "en": "You smell scorched."},
        {"zh": "让一步，我过去", "en": "One step back; let me pass."},
        {"zh": "我的关节被撞歪了", "en": "My joint got knocked askew."},
        {"zh": "再靠近会烧起来", "en": "Any closer and you'll burn."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "黄金拼出来的身体不生育", "en": "A body welded from gold does not breed"},
        {"zh": "火焰不繁衍后代", "en": "Flame does not breed."},
        {"zh": "这问题对我没有意义", "en": "That question means nothing to me."},
        {"zh": "我没有那种东西", "en": "I lack such a thing."},
        {"zh": "图腾只给我一个任务", "en": "The totem gave me one task."},
        {"zh": "我只会听从召唤", "en": "I only obey summons."},
        {"zh": "你不必再问了", "en": "Ask no more."},
        {"zh": "我的存在是借来的", "en": "My existence is borrowed."},
        {"zh": "你该去找活人", "en": "You should find the living."},
        {"zh": "我只陪你到最后", "en": "I'll stay only until the end."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的黄金很烫", "en": "My gold is hot."},
        {"zh": "你根本抬不动我", "en": "You can't lift me at all."},
        {"zh": "火会烧到你的手", "en": "The fire will scorch your hands."},
        {"zh": "别把我的面具弄掉", "en": "Don't knock off my mask."},
        {"zh": "这个姿势火环歪了", "en": "Held like this, the ring tilts."},
        {"zh": "我会拖着你烧一路", "en": "I'll burn a trail as you carry me."},
        {"zh": "放我下来，我能自己走", "en": "Set me down; I can move."},
        {"zh": "你的手套会化", "en": "Your gloves will melt."},
        {"zh": "我在半空就够轻了", "en": "I'm already light in the air."},
        {"zh": "请把手松开吧", "en": "Let go of me."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "面具锁住了你", "en": "My mask has fixed on you"},
        {"zh": "我开始升温了", "en": "I'm heating up now."},
        {"zh": "火环已经张开了", "en": "The ring has opened."},
        {"zh": "谁站在那边呢", "en": "Who stands over there?"},
        {"zh": "你不要靠近召唤者", "en": "Don't come near the summoner."},
        {"zh": "我的面具转向你了", "en": "My mask has turned to you."},
        {"zh": "我们现在就开始", "en": "We begin right now."},
        {"zh": "这道激光会找到你", "en": "This beam will find you."},
        {"zh": "你身上的气息很陌生", "en": "Your presence is unfamiliar."},
        {"zh": "再近一步就烧起来", "en": "One more step and it ignites."},
        {"zh": "我要守住这一圈", "en": "I'll hold this circle."},
        {"zh": "命令已经明确了", "en": "The order is clear enough."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我脚下这一圈，你别进", "en": "Don't cross the circle at my feet."},
        {"zh": "激光要三息才发", "en": "The beam needs three breaths."},
        {"zh": "我在校你的位置", "en": "I'm aligning on your position."},
        {"zh": "你的影子落在火里了", "en": "Your shadow falls in the fire."},
        {"zh": "我不追，我只需瞄准", "en": "I don't chase; I only aim."},
        {"zh": "你的影子落在左半边火里", "en": "Your shadow falls in the left half of my fire"},
        {"zh": "火环又涨了一圈", "en": "The ring has swollen again."},
        {"zh": "别站到我正前方", "en": "Don't stand directly ahead of me."},
        {"zh": "我的黄金在聚光", "en": "My gold is gathering light."},
        {"zh": "这道光会很直", "en": "This light will be very straight."},
        {"zh": "你绕后没有用", "en": "Circling behind won't help."},
        {"zh": "我数到三，一", "en": "I count to three: one."},
        {"zh": "光在黄金上收成一束", "en": "The light narrows to a beam on my gold."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "已经烧到你了", "en": "You've been burned."},
        {"zh": "这一下是我的火", "en": "That was my fire."},
        {"zh": "火焰环正在收拢", "en": "The fire ring is closing."},
        {"zh": "别伸手来碰我", "en": "Don't reach out to touch me."},
        {"zh": "灼一下，你就懂", "en": "One scorch and you'll understand."},
        {"zh": "我的指节也能打", "en": "My knuckles strike too."},
        {"zh": "靠近就是代价", "en": "Coming close has its price."},
        {"zh": "再往后退一步", "en": "One more step back."},
        {"zh": "这一击带着火焰", "en": "This blow carries fire."},
        {"zh": "火焰不会手软", "en": "Fire shows no mercy."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "图腾亮起来了", "en": "The totem has lit up."},
        {"zh": "我从火里立起来", "en": "I rise out of the fire."},
        {"zh": "黄金重新成形", "en": "The gold takes shape again."},
        {"zh": "脚下的火圈是第一个记号", "en": "The ring at my feet is the first mark."},
        {"zh": "有人付了代价", "en": "Someone paid the price."},
        {"zh": "面具已经扣上", "en": "The mask is snapped shut."},
        {"zh": "我的关节开始转动", "en": "My joints begin to turn."},
        {"zh": "屋子里的温度高了", "en": "The room has grown hotter."},
        {"zh": "我记起了任务", "en": "I remember the task."},
        {"zh": "火焰先我一步到达", "en": "The fire arrived before I did."},
        {"zh": "我在这里待命", "en": "I stand by here."},
        {"zh": "这具躯体只为一次召唤", "en": "This body serves one summoning."},
        {"zh": "地面被烧出一圈黑", "en": "The floor is scorched in a ring."},
        {"zh": "是你唤醒了我", "en": "You have woken me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火对我用处不大", "en": "Fire does little to me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "落地时黄金磕响了", "en": "My gold clanged on landing."}
      ]
    },
    "hurt.drown": {
