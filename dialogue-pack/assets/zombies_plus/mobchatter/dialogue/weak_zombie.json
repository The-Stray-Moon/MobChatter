{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着一条腿走。", "en": "I drag one leg along."},
        {"zh": "我的步子很慢。", "en": "My steps are slow."},
        {"zh": "我的胳膊僵在身前。", "en": "My arms stay stiff in front."},
        {"zh": "我走起路来会歪。", "en": "I veer as I walk."},
        {"zh": "脚下的草被我踩倒。", "en": "Grass bends under my feet."},
        {"zh": "我走得很慢，可我不会停。", "en": "I walk slowly, but I never stop."},
        {"zh": "我的速度只有零点二一。", "en": "My speed is only zero point two one."},
        {"zh": "我磕到石头上。", "en": "I stumble on a stone."},
        {"zh": "我又慢慢站直了。", "en": "I straighten up again."},
        {"zh": "我走得很费劲。", "en": "Walking takes real effort."},
        {"zh": "我拖着腿朝你走。", "en": "I come slowly toward you."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我僵在老地方不动。", "en": "I stand without moving."},
        {"zh": "我的喉咙发出低响。", "en": "A low sound comes from my throat."},
        {"zh": "我的头歪向一边。", "en": "My head tilts."},
        {"zh": "我在看你的方向。", "en": "I'm looking your way."},
        {"zh": "我的皮肤发青。", "en": "My skin is gray-green."},
        {"zh": "我垂着手呆呆站着。", "en": "I'm doing nothing."},
        {"zh": "太阳有点刺眼。", "en": "The sun stings a little."},
        {"zh": "我忘了要做什么。", "en": "I've forgotten what I was doing."},
        {"zh": "我的膝盖晃了一下。", "en": "I sway once."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看起来比我结实。", "en": "You look sturdier than me."},
        {"zh": "我只有一点力气。", "en": "I have only a little strength."},
        {"zh": "我走得非常慢。", "en": "I walk very slowly."},
        {"zh": "你别急着跑开。", "en": "Don't run off so fast."},
        {"zh": "我饿得肚子直叫。", "en": "I'm hungry."},
        {"zh": "我连抬手都费劲。", "en": "Even raising a hand is hard."},
        {"zh": "你要不要等我一会儿？", "en": "Would you wait for me?"},
        {"zh": "我的胳膊很沉。", "en": "My arms are heavy."},
        {"zh": "我总得试一下。", "en": "I have to try."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我往后退了一步。", "en": "I step back."},
        {"zh": "我差点就散架了。", "en": "I nearly fell apart."},
        {"zh": "我的胳膊掉了。", "en": "My arm came off."},
        {"zh": "这点伤碍不着我。", "en": "This wound hardly matters."},
        {"zh": "我慢慢地蹲了下去。", "en": "I slowly crouch."},
        {"zh": "我已经站不直了。", "en": "I can't stand straight."},
        {"zh": "我还站在原地。", "en": "I'm still here."},
        {"zh": "我记不住你的脸。", "en": "I won't remember you."},
        {"zh": "你再补一下试试。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那玩意儿啃得动吗？", "en": "Can that be eaten?"},
        {"zh": "我拖着步子挪过去。", "en": "I'll go over slowly."},
        {"zh": "你把它趁手放下。", "en": "Set it down."},
        {"zh": "我拿不稳东西。", "en": "I can't hold things steady."},
        {"zh": "这一点不够我嚼。", "en": "Not enough for me to chew."},
        {"zh": "我闻到味道了。", "en": "I caught the smell."},
        {"zh": "你别把它拿走。", "en": "Don't take it away."},
        {"zh": "我伸长手也够不到。", "en": "I can't reach it."},
        {"zh": "再往前放一点。", "en": "A bit closer."},
        {"zh": "我真心谢谢你。", "en": "Thank you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞得我歪了。", "en": "You knocked me off balance."},
        {"zh": "我差点就摔倒了。", "en": "I nearly fell."},
        {"zh": "我自己站稳了。", "en": "I steadied myself."},
        {"zh": "别踩住我的脚。", "en": "Don't step on my foot."},
        {"zh": "我没力气退开。", "en": "I've no strength to back off."},
        {"zh": "我们撞在一起。", "en": "We bumped into each other."},
        {"zh": "我的手臂挡了一下。", "en": "My arm caught it."},
        {"zh": "你比我快多了。", "en": "You're faster than me."},
        {"zh": "我又站回来了。", "en": "I'm upright again."},
        {"zh": "请你给我让一让。", "en": "Let me through."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我这样不适合。", "en": "Not in this state."},
        {"zh": "我连路都走不稳。", "en": "I can't even walk straight."},
        {"zh": "我慢得让人着急。", "en": "I'm painfully slow."},
        {"zh": "这太费力气了。", "en": "That's too much effort."},
        {"zh": "等这一夜过去。", "en": "After this night."},
        {"zh": "我不太懂这些。", "en": "I don't quite understand."},
        {"zh": "你另外找人吧。", "en": "Find someone else."},
        {"zh": "我已经累坏了。", "en": "I'm tired."},
        {"zh": "这事情下次再谈。", "en": "Later."},
        {"zh": "你别老是这样催我。", "en": "Don't rush me."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我弯腰很费劲。", "en": "Bending is hard work."},
        {"zh": "我用两只手抓。", "en": "I grab with both hands."},
        {"zh": "我两只手拿不稳它。", "en": "Can't hold it steady."},
        {"zh": "它从我手里掉下去了。", "en": "Dropped it."},
        {"zh": "这个东西咽不下去。", "en": "This can't be eaten."},
        {"zh": "这东西有点重。", "en": "A little heavy."},
        {"zh": "我慢慢拖着走。", "en": "I drag it slowly."},
        {"zh": "这个我先留着吧。", "en": "Keep it."},
        {"zh": "这是哪个丢下的？", "en": "Whose is it?"},
        {"zh": "我又把它搁回去。", "en": "I put it back."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那边有个人在。", "en": "Someone's over there."},
        {"zh": "我歪着脖子朝那边转。", "en": "I turn that way."},
        {"zh": "我把胳膊抬起来。", "en": "I raise my arm."},
        {"zh": "我试着快一点。", "en": "I try to go faster."},
        {"zh": "它还没有走远。", "en": "It hasn't gone far."},
        {"zh": "我一步一步过去。", "en": "I go over step by step."},
        {"zh": "就是那个方向。", "en": "That direction."},
        {"zh": "我伸伸手够得着它。", "en": "I can reach it."},
        {"zh": "我这就慢慢过来。", "en": "I'm coming."},
        {"zh": "你先别急着走开。", "en": "Don't go."},
        {"zh": "你稍微等等我吧。", "en": "Wait for me."},
        {"zh": "我已经挪到这儿了。", "en": "I'm there."},
        {"zh": "我把僵手一点点伸出。", "en": "I reach out."},
        {"zh": "我就轻轻咬一下。", "en": "Just one hit."},
        {"zh": "我会尽力试一试。", "en": "I'll do my best."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我慢慢跟过去。", "en": "I follow slowly."},
        {"zh": "你走得太快了。", "en": "You walk too fast."},
        {"zh": "我的腿挪不动。", "en": "My legs won't move."},
        {"zh": "我还在跟着你。", "en": "I'm still following."},
        {"zh": "你回头看一看。", "en": "Look back."},
        {"zh": "我的手还举着。", "en": "My hands are raised."},
        {"zh": "再往前走上几步。", "en": "A few more steps."},
        {"zh": "我离你只差几步。", "en": "I'm almost there."},
        {"zh": "你跑那么快做什么。", "en": "Don't run."},
        {"zh": "你给我站在那里。", "en": "Stand still."},
        {"zh": "我已经拉住你了。", "en": "I've caught you."},
        {"zh": "我张嘴咬下去。", "en": "I bite."},
        {"zh": "我的胳膊使不上劲。", "en": "I can't put force in."},
        {"zh": "但我还是咬着。", "en": "But I'm still biting."},
        {"zh": "你别使劲推我啊。", "en": "Don't push me."},
        {"zh": "我摔倒在地上。", "en": "I fell."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我挥了一下手。", "en": "I swing one hand."},
        {"zh": "我的牙不太齐。", "en": "My teeth are uneven."},
        {"zh": "只造成一点伤害。", "en": "Only one point of damage."},
        {"zh": "我根本抓不住你。", "en": "I can't hold you."},
        {"zh": "你已经退开了。", "en": "You pulled away."},
        {"zh": "我一下就扑空了。", "en": "I missed."},
        {"zh": "我又把手抬起来。", "en": "I raise my arm again."},
        {"zh": "我的手慢得很。", "en": "My hand is slow."},
        {"zh": "我算是碰到你了。", "en": "I touched you."},
        {"zh": "你别再打我了。", "en": "Don't hit me."},
        {"zh": "这点力气算不了什么。", "en": "This strength is nothing."},
        {"zh": "我还想再试一次。", "en": "I want to try again."},
        {"zh": "我重重摔了一跤。", "en": "I fell down."},
        {"zh": "我又慢慢爬起来了。", "en": "I got up."},
        {"zh": "你居然还在这里。", "en": "You're still here."},
        {"zh": "我该歇一会儿了。", "en": "I should rest."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从土里爬起来。", "en": "I claw up out of the earth."},
        {"zh": "我的关节响了一声。", "en": "My joints pop."},
        {"zh": "这里的光很亮。", "en": "The light is bright here."},
        {"zh": "我的身子晃了晃。", "en": "I sway."},
        {"zh": "我把手举起来。", "en": "I lift my hands up."},
        {"zh": "我慢慢地站直了。", "en": "I straighten slowly."},
        {"zh": "土还挂在我身上。", "en": "Dirt clings to me."},
        {"zh": "我朝前面走了两步。", "en": "I take two steps forward."},
        {"zh": "我的腿不太听话。", "en": "My legs don't quite obey."},
        {"zh": "两只手都伸在前面。", "en": "Both hands reach out front."},
        {"zh": "那边有个活物。", "en": "Something living over there."},
        {"zh": "我朝这边慢慢挪。", "en": "I shuffle this way."},
        {"zh": "你其实不用怕我。", "en": "Don't be afraid."},
        {"zh": "走一步算一步。", "en": "One step at a time."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从坡上滚下去，骨头响了。", "en": "I rolled down the slope; my bones rattled."}
      ]
    },
