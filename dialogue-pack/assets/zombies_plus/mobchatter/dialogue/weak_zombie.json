      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让我僵直。", "en": "That force left me rigid."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直饿，一直饿。", "en": "I'm hungry, always hungry."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在我身上，我抖个不停。", "en": "Lightning struck me; I shook all over."}
      ]
    },
