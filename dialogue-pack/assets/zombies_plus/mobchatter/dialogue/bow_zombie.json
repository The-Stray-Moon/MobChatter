    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "弓僵尸的皮毛在风中飘动。", "en": "The bow zombie's fur moves in the wind."},
        {"zh": "瞄准，准备发射。", "en": "Aim, ready to shoot."},
        {"zh": "我的箭矢精准无比。", "en": "My arrows are precise."},
        {"zh": "小心，我的箭可不假。", "en": "Watch out, my arrows are deadly."},
        {"zh": "射杀你，只是我的任务。", "en": "Killing you is my mission."},
        {"zh": "我在等机会，好射你个透。", "en": "I'm waiting for the chance to shoot you through."},
        {"zh": "我的弓箭比你想象的更强。", "en": "My bow is stronger than you think."},
        {"zh": "弓弦拉满，箭在弦上。", "en": "Bow taut, arrow ready."},
        {"zh": "我的目标，就在你眼前。", "en": "My target, right in front of you."},
        {"zh": "箭矢破空，射向目标。", "en": "The arrow flies, aiming for the target."},
        {"zh": "它一边走一边把箭搭上弦。", "en": "It nocks an arrow as it walks."},
        {"zh": "它退着走，弓始终对着你。", "en": "It backs away, bow always on you."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
