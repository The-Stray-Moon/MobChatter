    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着一只脚，在碎石上磨。", "en": "I drag one foot, scraping it over the gravel."},
        {"zh": "腐烂的肉，我要吃！", "en": "Rotten flesh, I want to eat."},
        {"zh": "臭东西，滚开！", "en": "Get away, stinky thing."},
        {"zh": "别退，我闻到你汗里的咸味。", "en": "Do not back away; I smell the salt in your sweat."},
        {"zh": "寻找……新鲜的血液！", "en": "Seeking… fresh blood."},
        {"zh": "啃食吧，腐烂的牙齿！", "en": "Eat, rotten teeth."},
        {"zh": "靠近我，享受痛苦！", "en": "Come closer, enjoy pain."},
        {"zh": "咬你一口，你就要中毒五秒。", "en": "One bite and you're poisoned five seconds."},
        {"zh": "我的牙有毒，你的没有。", "en": "My teeth are venomous. Yours aren't."},
        {"zh": "舔食你的伤口，让你痛苦！", "en": "Lick your wound, bring you pain."},
        {"zh": "毒液从嘴角滴到地上", "en": "Venom drips from its mouth to the ground"},
        {"zh": "拖着一身坏死的皮肤走", "en": "It drags its rotting hide along"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "这里适合我，我待着。", "en": "Suitable here, I stay."},
        {"zh": "腐烂是自由的味道。", "en": "Rottenness is freedom."},
        {"zh": "等你来，来吃我。", "en": "Wait for you, to eat me."},
        {"zh": "活着的人，别靠近。", "en": "Living, stay away."},
        {"zh": "我在这里，别动。", "en": "I'm here, don't move."},
        {"zh": "我手上的毒，五秒就够。", "en": "Five seconds of my poison is plenty."},
        {"zh": "等待，等待猎物。", "en": "Wait, wait for prey."},
        {"zh": "腐烂，我的归宿。", "en": "Rottenness, my home."},
        {"zh": "死亡是唯一的出路。", "en": "Death is the only way out."},
        {"zh": "腐烂的灵魂，永不停息。", "en": "Rotting soul, never stops."}
      ]
    },
