    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "饥肠辘辘，想吃点什么？", "en": "Hungry. What to eat?"},
        {"zh": "食物就在眼前，可别放过。", "en": "Food in sight, don't miss it."},
        {"zh": "腐肉，我的最爱，别抢。", "en": "Rotten flesh, my favorite; do not take it."},
        {"zh": "尸体腐烂的味道真香。", "en": "The smell of decay is delicious."},
        {"zh": "啃骨头，享受美食。", "en": "Crunch bones, enjoy the meal."},
        {"zh": "腐化的肉体，正合我意。", "en": "Corrupted flesh, just right."},
        {"zh": "饥饿的召唤，无法抗拒。", "en": "Call of hunger, irresistible."},
        {"zh": "腐烂的肉块，快给我！", "en": "Rotten meat, give to me!"},
        {"zh": "腐化的力量，增强我的力量。", "en": "Corruption, boost my strength."},
        {"zh": "腐肉给我能量，让我更强。", "en": "Decay gives me power, make me stronger."}
      ]
    },
