    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "慢吞吞的脚步声渐近。", "en": "Footsteps approach slowly."},
        {"zh": "嘶嘶声中，它张开了嘴。", "en": "Hisses as it opens its mouth."},
