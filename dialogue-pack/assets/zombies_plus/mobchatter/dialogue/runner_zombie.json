    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "呜咽一声，倒地不动。", "en": "A weak moan, then falls."},
        {"zh": "嘶嘶作响，身体摇晃。", "en": "Sputters and staggers."},
