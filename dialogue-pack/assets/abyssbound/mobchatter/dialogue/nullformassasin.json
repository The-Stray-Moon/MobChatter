{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身体没有明确的边。", "en": "My body has no clear edge."},
        {"zh": "我在雾里滑行。", "en": "I slide through the fog."},
        {"zh": "我避开所有光。", "en": "I avoid all light."},
        {"zh": "我的脚步没有声。", "en": "My steps make no sound."},
        {"zh": "我从阴影走到阴影。", "en": "I pass shadow to shadow."},
        {"zh": "我绕着这个空间走。", "en": "I circle this space."},
        {"zh": "我慢慢地靠近中心。", "en": "I move slowly toward the center."},
        {"zh": "我贴着深渊的边沿。", "en": "I keep to the abyss's rim."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我几乎看不见。", "en": "I'm barely visible."},
        {"zh": "我在等一个位置。", "en": "I'm waiting for a position."},
        {"zh": "雾气替我遮挡着。", "en": "The fog covers me."},
        {"zh": "雾里连影子也没有。", "en": "I'm doing nothing."},
        {"zh": "深渊在我脚下呼吸。", "en": "The abyss breathes beneath me."},
        {"zh": "我慢慢凝聚起来。", "en": "I slowly coalesce."},
        {"zh": "雾里的刀刃一直没出鞘。", "en": "The blade in the mist has never left its sheath."},
        {"zh": "我的刀还收着。", "en": "My blade is still sheathed."},
        {"zh": "我隐在雾里不动。", "en": "I don't move at all."},
        {"zh": "雾深处我静静等你。", "en": "I wait."},
        {"zh": "这里的雾很浓。", "en": "The fog is thick here."},
        {"zh": "我能清楚地看见你。", "en": "I can see you."},
        {"zh": "时间没有意义。", "en": "Time has no meaning."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的火光边上，我薄得像影子。", "en": "Beside your torchlight I am thin as a shadow."},
        {"zh": "你刚才看的方向不对。", "en": "You looked the wrong way."},
        {"zh": "我就在你侧后。", "en": "I'm at your flank."},
        {"zh": "你身上带着光。", "en": "You carry light."},
        {"zh": "这让我不太舒服。", "en": "It unsettles me."},
        {"zh": "你的影子刚刚动过。", "en": "Your shadow just moved."},
        {"zh": "你知道我在哪吗？", "en": "Do you know where I am?"},
        {"zh": "我不用呼吸空气。", "en": "I don't breathe."},
        {"zh": "我会等到那一瞬。", "en": "I'll wait for that instant."},
        {"zh": "你不该带光进来。", "en": "You shouldn't bring light in."},
        {"zh": "这层雾的边，就是我划的。", "en": "The edge of this mist is the line I drew."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的轮廓散了一块。", "en": "A piece of my outline scattered."},
        {"zh": "这一下打中了我。", "en": "That landed on me."},
        {"zh": "我一直退得很远。", "en": "I retreated far."},
        {"zh": "我根本不流血。", "en": "I don't bleed."},
        {"zh": "我的形状又稳了。", "en": "My shape steadied again."},
        {"zh": "你的运气很好。", "en": "You got lucky."},
        {"zh": "你再挥一次试试。", "en": "Again."},
        {"zh": "这具形体散了又聚。", "en": "This form scatters and knits back together."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "亮的东西会把我的轮廓照出来。", "en": "Bright things would outline my shape."},
        {"zh": "快把它拿开去。", "en": "Take it away."},
        {"zh": "它会把我的位置暴露。", "en": "It would give away my position."},
        {"zh": "这些实在的东西我不吃。", "en": "I don't eat."},
        {"zh": "你留着保命吧。", "en": "Keep it to save yourself."},
        {"zh": "我的刀，能斩开暗影.", "en": "My blade cuts through shade."},
        {"zh": "这实在太实在了。", "en": "Too solid."},
        {"zh": "我不会碰它的。", "en": "I won't touch it."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的手穿过了我。", "en": "Your hand passed through me."},
        {"zh": "我散了一下又聚起。", "en": "I scattered and re-formed."},
        {"zh": "你撞到的只是雾。", "en": "You hit only fog."},
        {"zh": "我不占这个空间。", "en": "I don't occupy this space."},
        {"zh": "别挨到这层薄雾。", "en": "Don't come so close."},
        {"zh": "我往雾里退了退。", "en": "I drew back."},
        {"zh": "你的热气烫到我了。", "en": "Your warmth unsettles me."},
        {"zh": "这点接触不算什么。", "en": "That contact means nothing."},
        {"zh": "我换一个角度。", "en": "I'll take another angle."},
        {"zh": "你的手只摸到空。", "en": "You can't hold me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这不是我存在的理由。", "en": "That isn't why I exist."},
        {"zh": "我连身体都不完整。", "en": "Even my body is incomplete."},
        {"zh": "这种事不会发生。", "en": "That won't happen."},
        {"zh": "你从这雾里退出去。", "en": "Move away."},
        {"zh": "别提这件事情。", "en": "Don't mention it."},
        {"zh": "你还是快走吧。", "en": "Go."},
        {"zh": "别让我再说一遍。", "en": "Don't make me repeat it."},
        {"zh": "深渊里也有同类靠近。", "en": "Even the abyss sends kin to my side."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我的指节穿过它了。", "en": "I can't grip it."},
        {"zh": "它穿过了我的手。", "en": "It passed through my hand."},
        {"zh": "这东西对我没有用处。", "en": "This is useless."},
        {"zh": "我的身体没有明确的边，推给你。", "en": "My body has no clear edge; I push it to you."},
        {"zh": "它一直在发亮。", "en": "It's glowing."},
        {"zh": "是谁放在这儿的？", "en": "Who left it here?"},
        {"zh": "赶紧把它丢掉。", "en": "Drop it."},
        {"zh": "你替它拿着吧。", "en": "You hold it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "虚影散开的那一秒，就是现在。", "en": "The second my shadow splits, that is the moment."},
        {"zh": "那光就在你手里。", "en": "The light is in your hand."},
        {"zh": "我先切断那个。", "en": "I'll cut that first."},
        {"zh": "你的破绽在后颈。", "en": "Your gap is at the nape."},
        {"zh": "我数到第二下。", "en": "I count to two."},
        {"zh": "雾气变得更浓了。", "en": "The fog thickened."},
        {"zh": "你根本听不见我。", "en": "You can't hear me."},
        {"zh": "我已经到你身边。", "en": "I'm there."},
        {"zh": "你别回过头来。", "en": "Don't look back."},
        {"zh": "趁你还没转过身。", "en": "Now."},
        {"zh": "这一刀会很快。", "en": "This cut is quick."},
        {"zh": "你来不及躲闪。", "en": "You won't dodge in time."},
        {"zh": "我已经出手了。", "en": "I strike."},
        {"zh": "雾把这一切收走了。", "en": "Finished."},
        {"zh": "留下一道口子。", "en": "Just one cut left."},
        {"zh": "就是这样而已。", "en": "Just like that."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你每退一步我就近一步。", "en": "Each step back, I gain one."},
        {"zh": "我贴着你的影子走，等你抬手。", "en": "I walk in your shadow, waiting for your hand to move."},
        {"zh": "你背后的雾在动。", "en": "The fog behind you moves."},
        {"zh": "我把刀藏在雾里。", "en": "I hide my blade in the fog."},
        {"zh": "你听得很仔细。", "en": "You're listening hard."},
        {"zh": "但我没有声音。", "en": "But I make no sound."},
        {"zh": "岩石上有一道新痕。", "en": "A fresh mark on the rock."},
        {"zh": "这个身位刚刚好。", "en": "This distance is right."},
        {"zh": "我看到你的呼吸。", "en": "I see your breathing."},
        {"zh": "你的手在摸武器。", "en": "Your hand searches for a weapon."},
        {"zh": "雾还没散，再等等。", "en": "A little longer."},
        {"zh": "你的队友也不会来。", "en": "No ally will come either."},
        {"zh": "这层雾是我的。", "en": "This fog is mine."},
        {"zh": "你要转过身了。", "en": "You're about to turn."},
        {"zh": "我一直在等这个。", "en": "I've waited for this."},
        {"zh": "就趁这一下子。", "en": "Right on this beat."},
        {"zh": "就卡在这个角度。", "en": "Right here."},
        {"zh": "我这就贴上去。", "en": "Move."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一刀切下去。", "en": "One cut goes down."},
        {"zh": "你后颈上有了血。", "en": "Blood at your nape."},
        {"zh": "我从你正面消失。", "en": "I vanish from in front of you."},
        {"zh": "我又在你背后。", "en": "I'm behind you again."},
        {"zh": "这一刀切得很浅。", "en": "That cut was shallow."},
        {"zh": "你的护甲挡住了。", "en": "Your armor caught it."},
        {"zh": "我退进了雾里。", "en": "I retreat into the fog."},
        {"zh": "你的血在雾里发暗。", "en": "Your blood darkens in the fog."},
        {"zh": "这下我要认真了。", "en": "I'm getting serious."},
        {"zh": "我再补上一刀。", "en": "One more cut."},
        {"zh": "你的喘息乱掉了。", "en": "Your breathing broke."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雾里先有了一点冷。", "en": "A coldness comes into the fog first."},
        {"zh": "雾里慢慢显出形状。", "en": "I slowly take an outline."},
        {"zh": "这一层深渊很静。", "en": "This layer of the abyss is quiet."},
        {"zh": "没有形状的刺客，举起了手。", "en": "A shapeless assassin raises a hand."},
        {"zh": "四周一点光也没有。", "en": "No light around."},
        {"zh": "我听见远处有水，深渊的潮。", "en": "I hear water far off; the abyss tide."},
        {"zh": "我踩着的石头是凉的。", "en": "The stone under me is cold."},
        {"zh": "我把刀收好了。", "en": "I put my blade away."},
        {"zh": "我在找那个位置。", "en": "I'm finding that position."},
        {"zh": "雾气向我聚拢。", "en": "The fog gathers to me."},
        {"zh": "轮廓已经定住了。", "en": "I'm ready."},
        {"zh": "谁在那边站着？", "en": "Who's over there?"},
        {"zh": "雾里我早已看见你。", "en": "I see it."},
        {"zh": "我先按兵不动。", "en": "I'll stay still first."},
        {"zh": "等你走近一些。", "en": "Wait for you to come near."},
        {"zh": "呼吸已经很轻了。", "en": "Your breathing is very light now."},
        {"zh": "雾要开始收拢了。", "en": "Begin."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火光让我无处可藏。", "en": "The firelight leaves me nowhere to hide."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水让我变得很薄。", "en": "Water thins me out."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把雾整个撕开。", "en": "The blast tore my shape apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "洞在雾里合拢，慢了一点。", "en": "The hole closes in the mist, a little slowly."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量抓住了我的形状。", "en": "That force seized my shape."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我在慢慢变薄。", "en": "I'm thinning."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光照出了我的全部。", "en": "The flash revealed all of me."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我本来就来自那里。", "en": "I came from there to begin with."}
      ]
    }
  }
}
