{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我和另一个一起巡", "en": "I patrol with another."},
        {"zh": "我走得很快，几乎不停", "en": "I move fast, rarely stopping."},
        {"zh": "我沿着深渊林的树干走", "en": "I travel along the trunks of the abyss woods."},
        {"zh": "雾里有我留下的痕", "en": "I leave marks in the mist."},
        {"zh": "我朝前方探路", "en": "I scout ahead."},
        {"zh": "我一步跨过树根", "en": "I step over a root."},
        {"zh": "我一直看着两侧", "en": "I keep watching both sides."},
        {"zh": "我在记这条路", "en": "I am memorising this route."},
        {"zh": "深渊林里，我数着脚步。", "en": "In the abyss woods, I count footsteps."},
        {"zh": "我的同伴在另一侧", "en": "My companion is on the other side."},
        {"zh": "我的影子贴着树干移动", "en": "My shadow moves along the trunk."},
        {"zh": "我往回走了一小段", "en": "I backtrack a short way."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在树根上", "en": "I crouch on a root."},
        {"zh": "深渊林里，我循着脚步走。", "en": "In the abyss woods I follow footsteps."},
        {"zh": "林子里只有我的影子。", "en": "Only my shadow is in the woods."},
        {"zh": "我在等同伴回来", "en": "I wait for my companion to return."},
        {"zh": "这里的雾比别处薄", "en": "The mist is thinner here."},
        {"zh": "我的尾巴缠住了藤。", "en": "My tail wraps a vine."},
        {"zh": "我在记下这里的路", "en": "I am noting the paths here."},
        {"zh": "我看见的都会带回去", "en": "What I see, I carry back."},
        {"zh": "我没有发出信号", "en": "I have not signalled yet."},
        {"zh": "我的尾巴垂在枝下。", "en": "My tail hangs below the branch."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我的第三只眼睁开。", "en": "My third eye opens."},
        {"zh": "我会记住你站的位置", "en": "I will remember where you stood."},
        {"zh": "你是第一个从这边来的", "en": "You are the first to come from this side."},
        {"zh": "深渊林里，我远远就看清。", "en": "From the Abysswoods, I see clearly from afar."},
        {"zh": "你的动作被我记下了", "en": "Your movements are noted."},
        {"zh": "我朝同伴的方向偏了偏头", "en": "I tilt my head toward my companion."},
        {"zh": "你已经进入我们记的地图", "en": "You are already on our map."},
        {"zh": "深渊林里，我远远看清你。", "en": "In the abyss woods, I see you from far off."},
        {"zh": "我先把消息带回去", "en": "I will take word back first."},
        {"zh": "你会再见到我们的", "en": "You will see us again."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我换了个树杈蹲下。", "en": "I crouch on another branch."},
        {"zh": "这一下我记得清楚", "en": "I remember that clearly."},
        {"zh": "我的肩膀不太能动", "en": "My shoulder will not move well."},
        {"zh": "我朝同伴那边看了一眼", "en": "I glance toward my companion."},
        {"zh": "我没有喊出来", "en": "I did not call out."},
        {"zh": "我还跑得起来。", "en": "I can still run."},
        {"zh": "这点伤不妨碍我记路", "en": "This does not stop me mapping the way."},
        {"zh": "我换了处藏身", "en": "I have changed hiding spot."},
        {"zh": "血滴在树根上", "en": "Blood drops on the root."},
        {"zh": "我会再回来的", "en": "I will come back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那个东西有点意思", "en": "That thing is somewhat interesting."},
        {"zh": "我伸手拿了一下", "en": "I reach out and take it."},
        {"zh": "这个我带回营地", "en": "I will take this back to camp."},
        {"zh": "它可能会派上用场", "en": "It might be useful."},
        {"zh": "我把它按进腐叶泥里。", "en": "I press it into the rotting muck."},
        {"zh": "但领队会想知道", "en": "But the leader will want to know."},
        {"zh": "这东西，我带回去报信。", "en": "I'll take this back as a report."},
        {"zh": "我的舌头舔过牙尖。", "en": "My tongue runs over my fangs."},
        {"zh": "我要看清这个形状", "en": "I want to see its shape clearly."},
        {"zh": "这是你的东西吧", "en": "This is yours, is it not?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，我们都停了一下", "en": "You hit me; we both paused."},
        {"zh": "我退开半步，重新看", "en": "I step back and look again."},
        {"zh": "我不喜欢被人撞", "en": "I do not like being bumped."},
        {"zh": "这点碰撞我还受得住", "en": "I can take that much."},
        {"zh": "我们靠得太近", "en": "We are too close."},
        {"zh": "我的爪子在苔上打滑。", "en": "My claws slip on the moss."},
        {"zh": "我被你挡住了视线", "en": "You are blocking my view."},
        {"zh": "往旁边让一点", "en": "Move aside a little."},
        {"zh": "我的同伴在叫我", "en": "My companion is calling."},
        {"zh": "我得先走一步", "en": "I must go on ahead."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们是成对行动的", "en": "We move in pairs."},
        {"zh": "我们一前一后穿过林子。", "en": "We cross the woods one behind the other."},
        {"zh": "我们交替守夜", "en": "We take turns keeping watch."},
        {"zh": "你不用说话，我看得懂", "en": "You need not speak; I understand."},
        {"zh": "这片林子我们一起记", "en": "We map this wood together."},
        {"zh": "雾里看不见就听", "en": "When the mist hides things, we listen."},
        {"zh": "有你在，我敢走远一点", "en": "With you here, I dare go farther."},
        {"zh": "别一个人落单", "en": "Do not get isolated."},
        {"zh": "到树根那里等", "en": "Wait at that root."},
        {"zh": "我就在附近看着", "en": "I will be nearby, watching."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我在林边站着，替谁看着。", "en": "At the wood's edge, I watch for someone."},
        {"zh": "这个要带回去", "en": "This goes back with us."},
        {"zh": "我记下它在哪", "en": "I note where it lies."},
        {"zh": "它还有一点沉", "en": "It is a little heavy."},
        {"zh": "我把那块东西挂在腰上。", "en": "I hang the thing at my waist."},
        {"zh": "这不像是这里的东西", "en": "This does not belong here."},
        {"zh": "有人到过这里", "en": "Someone has been here."},
        {"zh": "我要把这个痕迹留着", "en": "I will leave this mark."},
        {"zh": "拿回去给领队看", "en": "Take it back for the leader."},
        {"zh": "先拿好别丢了", "en": "Hold it well, do not lose it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我看见你了，就锁定了", "en": "I saw you, and locked on."},
        {"zh": "我朝同伴发了信号", "en": "I signalled my companion."},
        {"zh": "你在这里待得太久了", "en": "You have stayed here too long."},
        {"zh": "我记下了你的路线", "en": "I have your route noted."},
        {"zh": "这附近只有你一个", "en": "There is only you around here."},
        {"zh": "我绕到你的侧面去", "en": "I work around to your flank."},
        {"zh": "我不需要靠近也能跟住你", "en": "I can track you without closing in."},
        {"zh": "你的脚步很重", "en": "Your steps are heavy."},
        {"zh": "我听得一清二楚", "en": "I hear them perfectly."},
        {"zh": "那我们现在动手", "en": "Then we move now."},
        {"zh": "这次不会再放你走", "en": "This time you will not be let go."},
        {"zh": "我先把消息送出去", "en": "I will send word first."},
        {"zh": "然后才是这一下", "en": "Then comes this."},
        {"zh": "我已经记下你的步幅", "en": "I have noted your stride."},
        {"zh": "你身上有铁和布的味道", "en": "You smell of iron and cloth."},
        {"zh": "我会从你看不到的角度动手", "en": "I will strike from where you cannot see."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你的脚印", "en": "I follow your prints."},
        {"zh": "你往哪走，我都记得", "en": "Wherever you go, I remember."},
        {"zh": "我绕到你的前面", "en": "I move ahead of you."},
        {"zh": "我停在树干后面", "en": "I stop behind a trunk."},
        {"zh": "我藏在深渊林子的树后。", "en": "I hide behind the trees of the abyss wood."},
        {"zh": "我的同伴在另一条路上", "en": "My companion is on the other path."},
        {"zh": "两条路会在前面合上", "en": "The two paths meet ahead."},
        {"zh": "你正在往那个方向走", "en": "You are heading that way."},
        {"zh": "这个位置刚刚好", "en": "This position is just right."},
        {"zh": "我用不着催你", "en": "I need not hurry you."},
        {"zh": "我只要先到一步", "en": "I only need to arrive first."},
        {"zh": "这里的树我比你熟", "en": "I know these trees better than you."},
        {"zh": "你绕了一个弯", "en": "You made a detour."},
        {"zh": "我早就在这里等", "en": "I was waiting here already."},
        {"zh": "我的爪印留在了树皮上。", "en": "My claw marks stay on the bark."},
        {"zh": "我在你头顶的枯枝上。", "en": "I'm on the dead branch above you."},
        {"zh": "那个声音不是我", "en": "That sound was not me."},
        {"zh": "是另一个同伴", "en": "It was the other one."},
        {"zh": "现在两个都在", "en": "Now both of us are here."},
        {"zh": "我一步一步，不慌不忙", "en": "Step by step, unhurried."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的爪子撕开你的护肩。", "en": "My claws tear your shoulder guard."},
        {"zh": "这一下打得很准", "en": "That one was accurate."},
        {"zh": "你还没弄清方向", "en": "You have not worked out the direction."},
        {"zh": "一击之后我退回树后。", "en": "After one strike I slip behind the tree."},
        {"zh": "我的同伴从另一边来", "en": "My companion comes from the other side."},
        {"zh": "你转过身，正好背对我", "en": "You turned, and your back is to me."},
        {"zh": "这一下我们一起动手", "en": "This time we strike together."},
        {"zh": "你退到树根间了", "en": "You have retreated among the roots."},
        {"zh": "那里路不好走", "en": "The footing there is bad."},
        {"zh": "我又贴近了一些", "en": "I closed in again."},
        {"zh": "我从树杈上扑下来。", "en": "I drop from the fork of the tree."},
        {"zh": "你的护甲挡住了第一下", "en": "Your armour stopped the first."},
        {"zh": "第二下没挡住", "en": "The second one was not blocked."},
        {"zh": "我看得很清楚", "en": "I saw it perfectly."},
        {"zh": "这一下是为了把消息带回去", "en": "This one is to bring back word."},
        {"zh": "带回去说，你很难缠", "en": "Word that you are stubborn."},
        {"zh": "我从下面切上来", "en": "I cut up from below."},
        {"zh": "你没有料到自己背后有人", "en": "You did not expect someone behind you."},
        {"zh": "我踩住了你的影子", "en": "I stepped on your shadow."},
        {"zh": "这一下落得很稳", "en": "That one landed steady."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雾里先出现两个影子", "en": "Two shapes appear in the mist."},
        {"zh": "我在前面，同伴在后面", "en": "I lead; my companion follows."},
        {"zh": "我从深渊林的树影里走出来", "en": "I step out of the abyss woods' shadow."},
        {"zh": "这里的雾是我的掩护", "en": "This mist is my cover."},
        {"zh": "我朝两侧各看了一眼", "en": "I glance both ways."},
        {"zh": "这条路没有别人走过", "en": "No one else has walked this path."},
        {"zh": "我在树干上留下记痕", "en": "I leave a mark on the trunk."},
        {"zh": "我蹲在湮灭洞穴的入口。", "en": "I crouch at the oblivion grotto's mouth."},
        {"zh": "远处有脚步声响", "en": "Footsteps sound far off."},
        {"zh": "我停下来仔细听", "en": "I stop and listen closely."},
        {"zh": "同伴已经散开", "en": "My companion has already fanned out."},
        {"zh": "我们两个一前一后", "en": "The two of us, one ahead, one behind."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火把这片雾烧开了", "en": "Fire burns this mist away."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树干上摔下来", "en": "I fall from the trunk."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把雾压住了", "en": "Water presses the mist down."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀进灌木", "en": "The blast throws me into the brush."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭穿了我的小腿。", "en": "The arrow goes through my calf."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道力量让我现了位置", "en": "That force gave away my position."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "巡得太久，没吃东西", "en": "Patrolling too long without food."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷把周围的暗处照亮了", "en": "Lightning lights up all the dark around."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里连树都没有", "en": "There are not even trees here."}
      ]
    }
  }
}
