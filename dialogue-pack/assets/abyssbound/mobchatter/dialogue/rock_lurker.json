{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我的皮肤和碎石一个颜色。", "en": "My hide is the colour of rubble."},
        {"zh": "我在裂谷里贴着石头走。", "en": "I keep to the stone in the rift."},
        {"zh": "每走一步都有沙落下。", "en": "Sand falls with every step."},
        {"zh": "我拖着两条粗腿挪动。", "en": "I drag myself on two thick legs."},
        {"zh": "我走的地方石头塌了一块。", "en": "The stone gives way where I walk."},
        {"zh": "我一直在看缝隙。", "en": "I keep watching the cracks."},
        {"zh": "我的背脊是硬的。", "en": "My spine is hard."},
        {"zh": "我贴着碎石，挪到你侧面。", "en": "Hugging the rubble, I shift around to your flank."},
        {"zh": "我走路不出声。", "en": "I walk without a sound."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在石头后面。", "en": "I crouch behind a stone."},
        {"zh": "我几乎看不出是活的。", "en": "I barely look alive."},
        {"zh": "我把背上的石块摆正。", "en": "I settle the stone slab on my back."},
        {"zh": "有一块石头在我背上。", "en": "There's a stone on my back."},
        {"zh": "我的眼睛只露一条缝。", "en": "My eyes show as a slit."},
        {"zh": "我数着石头的裂缝。", "en": "I count the cracks in the stone."},
        {"zh": "我连呼吸都无声。", "en": "Even my breathing is silent."},
        {"zh": "我动了一下手指。", "en": "A finger moves."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩在裂缝边上。", "en": "You're standing at the edge of a crack."},
        {"zh": "我抬起头，灰落下来。", "en": "I raise my head; ash falls."},
        {"zh": "你听见石头在响吗？", "en": "Do you hear the stone creak?"},
        {"zh": "我在这块石头后面很久。", "en": "I've waited long behind this stone."},
        {"zh": "你和石头不太一样。", "en": "You look different from the stone."},
        {"zh": "我从石堆里撑起灰扑扑的肩。", "en": "I lift my ash-gray shoulders out of the rubble."},
        {"zh": "地面松了一块。", "en": "A patch of ground loosens."},
        {"zh": "我看到你手里有东西。", "en": "I see something in your hand."},
        {"zh": "那东西会响。", "en": "That thing makes noise."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我身上的石片掉了一块。", "en": "A slab falls off me."},
        {"zh": "我退了半步，灰扬起。", "en": "I step back; ash rises."},
        {"zh": "我贴着裂谷的岩壁，你刚打到石头。", "en": "I hug the rift wall; you just hit rock."},
        {"zh": "我没发出一点声。", "en": "Not a single sound."},
        {"zh": "血从石缝里溢出来。", "en": "Blood seeps from a seam."},
        {"zh": "我看着你的靴子。", "en": "I watch your boots."},
        {"zh": "我抖掉背上的碎石，重新蹲下。", "en": "I shake the rubble off my back and crouch again."},
        {"zh": "裂开了，这石头身子也会疼。", "en": "Cracked... even a stone body can ache."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这块坡石我能咬开。", "en": "I can bite through this slab."},
        {"zh": "把它搁在石板上。", "en": "Set it on the slab."},
        {"zh": "我闻到矿物味。", "en": "I smell mineral."},
        {"zh": "它在你脚边。", "en": "It's by your foot."},
        {"zh": "不是肉，但可以。", "en": "Not meat, but it'll do."},
        {"zh": "我把它压碎。", "en": "I crush it."},
        {"zh": "这点还不太够。", "en": "That isn't quite enough."},
        {"zh": "这块矿渣在我嘴里碎开。", "en": "This lump of slag crumbles between my teeth."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞在我身上，像撞石头。", "en": "You hit me like stone."},
        {"zh": "我连灰都没掉。", "en": "I didn't even shed ash."},
        {"zh": "你退了两步，手在抖。", "en": "You fell back two steps, hands shaking."},
        {"zh": "我们踢散了一堆碎石。", "en": "We scatter a heap of rubble."},
        {"zh": "我撑起身子转过来。", "en": "I push myself around."},
        {"zh": "灰扬起来了。", "en": "Ash rises."},
        {"zh": "这一下不疼。", "en": "That didn't hurt."},
        {"zh": "石头底下才是我的地盘，别踩。", "en": "The space under the rock is mine. Watch your step."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "岩壁后面还有一只。", "en": "There's another behind the rock face."},
        {"zh": "它比我宽一些。", "en": "It's broader than me."},
        {"zh": "我们背靠着背。", "en": "We stand back to back."},
        {"zh": "它的壳上有旧伤。", "en": "Its shell carries old wounds."},
        {"zh": "两只伏在岩壁后，谁都不动。", "en": "Two of us lie behind the rock wall, neither moving."},
        {"zh": "是它先动的。", "en": "It moved first."},
        {"zh": "我跟着它挪。", "en": "I shift along with it."},
        {"zh": "石头被我们压碎。", "en": "The stone cracks under us."},
        {"zh": "我们面朝同一侧。", "en": "We face the same side."},
        {"zh": "我们的呼吸都藏进石缝。", "en": "Our breathing hides in the cracks of the stone."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "它在我的手里碎了一半。", "en": "Half of it crumbles in my grip."},
        {"zh": "这块一捏就散。", "en": "This one crumbles in the hand."},
        {"zh": "地上有亮的东西。", "en": "Something bright on the ground."},
        {"zh": "它滚进裂缝里。", "en": "It rolls into a crack."},
        {"zh": "这石头不值钱。", "en": "This stone is worthless."},
        {"zh": "这枚虚空尘，归我了。", "en": "That voiddust is mine now."},
        {"zh": "亮闪闪的东西，先塞进石缝里。", "en": "Anything that glints goes into my crevice first."},
        {"zh": "我捡的不是破烂，是深渊的碎屑。", "en": "I'm not collecting junk, these are shards of the abyss."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我听见石头动了。", "en": "I heard the stone move."},
        {"zh": "我从石缝里探头。", "en": "I show my head from the crack."},
        {"zh": "我把身体撑起来。", "en": "I push myself up."},
        {"zh": "灰从我背上滑下。", "en": "Ash slides off my back."},
        {"zh": "我贴着裂缝过去。", "en": "I move along the fissure."},
        {"zh": "这一片地面很松。", "en": "The ground here is loose."},
        {"zh": "我把肚子贴住地。", "en": "I press my belly down."},
        {"zh": "它的距离我量过了。", "en": "I've measured its distance."},
        {"zh": "它朝后瞥了一眼。", "en": "It glanced backward."},
        {"zh": "我的脚掌压得更沉。", "en": "My feet press down harder."},
        {"zh": "石片在我脚下碎。", "en": "Slabs break under me."},
        {"zh": "它撞到了岩壁。", "en": "It ran into the wall."},
        {"zh": "这条路到这就断。", "en": "This path ends here."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "裂谷的石头，和我一个颜色。", "en": "The rift stone matches my color."},
        {"zh": "我的脚步很沉。", "en": "My steps are heavy."},
        {"zh": "它绕过一堆碎石。", "en": "It went round a rubble heap."},
        {"zh": "裂谷在这里变窄。", "en": "The rift narrows here."},
        {"zh": "它只能往前走。", "en": "It can only go forward."},
        {"zh": "它的喘息我听得见。", "en": "I can hear it panting."},
        {"zh": "它停下来回头看。", "en": "It stopped and looked back."},
        {"zh": "它又往前跑。", "en": "It ran on."},
        {"zh": "裂谷的石头，和我一个色。", "en": "The rift stone is the same color as me."},
        {"zh": "石片到处乱飞。", "en": "Slabs fly everywhere."},
        {"zh": "它的影子被我的盖住。", "en": "My shadow covers its own."},
        {"zh": "我把肚子贴住碎石的坡面。", "en": "I press my belly to the slope of broken stone."},
        {"zh": "现在够近了。", "en": "Close enough now."},
        {"zh": "我的下颚慢慢张开，灰掉进去。", "en": "My jaw opens slowly and ash falls into it."},
        {"zh": "我按住它了。", "en": "I've got it pinned."},
        {"zh": "你过来呀，别躲。", "en": "Come here, don't hide."},
        {"zh": "到这里为止。", "en": "This is the end."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一爪拍下去，石片碎裂。", "en": "My claw comes down; slabs shatter."},
        {"zh": "我狠咬它的肩胛。", "en": "I sink my teeth into its shoulder."},
        {"zh": "灰和血一起飞起来。", "en": "Ash and blood fly together."},
        {"zh": "它想挣脱开。", "en": "It tries to break free."},
        {"zh": "我用整个身子压住。", "en": "I put my whole body on it."},
        {"zh": "地裂得更开了。", "en": "The ground splits wider."},
        {"zh": "它整个瘫下去了。", "en": "It slumped down entirely."},
        {"zh": "我一掌拍下去，碎石四溅。", "en": "My palm slams down and gravel sprays."},
        {"zh": "嘴里全是砂子。", "en": "My mouth is full of grit."},
        {"zh": "我整个身子压下去，地面塌了。", "en": "I drop my whole weight and the ground caves in."},
        {"zh": "石头从我背上滚下去。", "en": "Stones roll off my back."},
        {"zh": "我扭身走开。", "en": "I turn away."},
        {"zh": "周围只剩灰落。", "en": "Only ash falling now."},
        {"zh": "我回到石头后面。", "en": "I return behind the stone."},
        {"zh": "像什么也没发生。", "en": "As if nothing happened."},
        {"zh": "我趴回石缝。", "en": "I settle back into the crack."},
        {"zh": "下一个会来的。", "en": "The next one will come."},
        {"zh": "我总是等得起。", "en": "I can always wait."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "裂谷里多了一块会动的东西。", "en": "Something that moves appears in the rift."},
        {"zh": "岩壁上裂开一道缝。", "en": "A crack opens in the rock face."},
        {"zh": "我从碎石里站起来。", "en": "I rise out of the rubble."},
        {"zh": "这里的石头很松。", "en": "The stone here is loose."},
        {"zh": "碎裂原野的灰，抖不完。", "en": "The Fractured Expanse dust never comes off."},
        {"zh": "我的皮肤和周围一样。", "en": "My hide matches everything around."},
        {"zh": "我转身面对这边。", "en": "I turn to face this way."},
        {"zh": "风从裂谷里穿过去。", "en": "Wind passes down the rift."},
        {"zh": "我听见有活物。", "en": "I hear something alive."},
        {"zh": "我朝那边动了一下。", "en": "I shift that way."},
        {"zh": "我重新沉下去。", "en": "I settle back down."},
        {"zh": "石头缝里露出我的眼睛。", "en": "My eye shows in a stone crack."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在我身上烧，石头都裂了。", "en": "Fire burns on me; the stone cracks."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我掀翻了。", "en": "The blast flips me over."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物卡在我的缝里。", "en": "A point lodges in my seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光压在我的背上。", "en": "That light bears down on my back."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得撑不住身子。", "en": "Too hungry to hold myself up."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷劈在石背上，我僵了一瞬。", "en": "Lightning hits my back; I lock up."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "下面没有石头。", "en": "There's no stone below."}
      ]
    }
  }
}
