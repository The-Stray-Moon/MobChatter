{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我成群地爬过岩面。", "en": "We crawl over the rock in a swarm."},
        {"zh": "我的步子密得像雨点。", "en": "My steps patter like rain."},
        {"zh": "我挤进石头缝里。", "en": "I squeeze into a stone gap."},
        {"zh": "我沿着粉尘谷的边缘走。", "en": "I move along the dust valley's rim."},
        {"zh": "我朝温热的东西去。", "en": "I head for anything warm."},
        {"zh": "我爬过一段发白的骨头。", "en": "I crawl over a bleached bone."},
        {"zh": "我的身体很小，很轻。", "en": "My body is small and light."},
        {"zh": "我往阴影最深处爬。", "en": "I crawl toward the deepest shade."},
        {"zh": "我顺着风的味道走。", "en": "I follow the scent on the wind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在石头上。", "en": "I cling to the stone."},
        {"zh": "我的腿微微抽动。", "en": "My legs twitch faintly."},
        {"zh": "我在等更大的东西走过。", "en": "I wait for something bigger to pass."},
        {"zh": "石缝里安静得很。", "en": "It's quiet here."},
        {"zh": "雾气贴着地面。", "en": "Fog hugs the ground."},
        {"zh": "我们伏在石头上一动不动。", "en": "I'm doing nothing."},
        {"zh": "我的同伴在边上。", "en": "My kin are at the edge."},
        {"zh": "我慢慢摆动触须。", "en": "I wave my antennae slowly."},
        {"zh": "这片石头很冷。", "en": "This stone is cold."},
        {"zh": "再等上一小会儿。", "en": "A little longer."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你脚下有成百个我。", "en": "There are hundreds of me under your feet."},
        {"zh": "我不大，但我们很多。", "en": "I'm small, but we are many."},
        {"zh": "这里没人能站太久。", "en": "No one stands here long."},
        {"zh": "你的靴子在动。", "en": "Your boot is moving."},
        {"zh": "我们喜欢温暖的东西。", "en": "We like warm things."},
        {"zh": "你从上面看只能看到一点。", "en": "From above you see only a speck."},
        {"zh": "我只有四点血。", "en": "I have only four health."},
        {"zh": "但我们会一起上。", "en": "But we come together."},
        {"zh": "你的影子挡住我们了。", "en": "Your shadow covers us."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我碎了一只同伴。", "en": "One of my kin was crushed."},
        {"zh": "我们散开了一片。", "en": "We scattered."},
        {"zh": "这点伤对我不算什么。", "en": "This wound barely matters to me."},
        {"zh": "我的甲壳被踩裂了。", "en": "My shell cracked."},
        {"zh": "我们又聚回来。", "en": "We gathered again."},
        {"zh": "踩死几只还有更多。", "en": "Crush a few; there are more."},
        {"zh": "我还在顺着石缝爬。", "en": "I'm still crawling."},
        {"zh": "血沾在石头上。", "en": "Blood on the stone."},
        {"zh": "我们记住了这个味道。", "en": "We remember that scent."},
        {"zh": "你再落一脚试试。", "en": "Again."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些不够我们分。", "en": "Not enough to share."},
        {"zh": "我们吃的东西不一样。", "en": "We eat different things."},
        {"zh": "这已经是死的。", "en": "That's dead."},
        {"zh": "赶快把它挪走。", "en": "Take it away."},
        {"zh": "我们更喜欢会动的。", "en": "We prefer things that move."},
        {"zh": "你放下来也没用。", "en": "Setting it down won't help."},
        {"zh": "我们只想要一点温度。", "en": "We only want a little warmth."},
        {"zh": "这个东西太干净。", "en": "This is too clean."},
        {"zh": "我们会绕着它。", "en": "We'll just circle it."},
        {"zh": "你不用管我们。", "en": "Don't mind us."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩碎了几只。", "en": "You crushed a few of us."},
        {"zh": "其他的会散开。", "en": "The rest scatter."},
        {"zh": "我们从你的脚边爬过。", "en": "We crawl past your feet."},
        {"zh": "你的靴子太大。", "en": "Your boot is huge to us."},
        {"zh": "我们贴着你走。", "en": "We move against you."},
        {"zh": "你感觉到的只是痒。", "en": "What you feel is only a tickle."},
        {"zh": "我们绕开这一步。", "en": "We go around this step."},
        {"zh": "别停在这个地方。", "en": "Don't stop here."},
        {"zh": "你的影子是我们的路。", "en": "Your shadow is our road."},
        {"zh": "我们又聚拢了。", "en": "We gather again."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们不需要这些。", "en": "We don't need that."},
        {"zh": "岩缝深处有个巢。", "en": "Deep in the crack is a nest."},
        {"zh": "我们靠成群延续。", "en": "We continue by swarming."},
        {"zh": "等这一批过去。", "en": "After this brood passes."},
        {"zh": "我们很多，都在等。", "en": "Many of us wait."},
        {"zh": "别站进石缝里。", "en": "Don't stand in the gap."},
        {"zh": "这一群得慢慢聚拢。", "en": "Slowly."},
        {"zh": "你从石缝边上退开。", "en": "Go on."},
        {"zh": "别在这里吵闹。", "en": "Quiet."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我们拖不动它。", "en": "We can't drag it."},
        {"zh": "这东西沉得推不动。", "en": "Too heavy."},
        {"zh": "这一块嚼不碎。", "en": "This can't be eaten."},
        {"zh": "我们围着它转。", "en": "We gather around it."},
        {"zh": "它有一点点温度。", "en": "It has a little warmth."},
        {"zh": "我们把它推走。", "en": "We push it away."},
        {"zh": "这东西对我们没用。", "en": "Useless."},
        {"zh": "我们不去管它。", "en": "We ignore it."},
        {"zh": "就让它留着吧。", "en": "Leave it."},
        {"zh": "你把它收进包里。", "en": "Take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西站在石头上了。", "en": "Something is standing on the stone."},
        {"zh": "我们都转向它。", "en": "We all turn toward it."},
        {"zh": "细声越来越密。", "en": "The rustling grows denser."},
        {"zh": "我们从四周上去。", "en": "We climb from all sides."},
        {"zh": "它的腿能站多久？", "en": "How long can its legs hold?"},
        {"zh": "我们一起动起来。", "en": "We move as one."},
        {"zh": "我们四只一起，从灰里冒。", "en": "Four of us rise from the dust at once."},
        {"zh": "再往石脊前面挪一步。", "en": "One step more."},
        {"zh": "就趁现在一刻。", "en": "Now."},
        {"zh": "全都不许退，上。", "en": "Up."},
        {"zh": "我们全都一起上。", "en": "All of us."},
        {"zh": "谁也别停下来。", "en": "Don't stop."},
        {"zh": "我们已经到了。", "en": "We're there."},
        {"zh": "它轻轻抖了一下。", "en": "It shuddered."},
        {"zh": "这就已经开始了。", "en": "It begins."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一直贴着它的影子。", "en": "We keep to its shadow."},
        {"zh": "它走到哪我们跟到哪。", "en": "We follow wherever it goes."},
        {"zh": "石头缝里都是我们。", "en": "Every crack has us in it."},
        {"zh": "它踩下去就踩到我们。", "en": "Every step it takes lands on us."},
        {"zh": "我们的细声没停过。", "en": "Our rustling hasn't stopped."},
        {"zh": "它开始踢腿了。", "en": "It's kicking now."},
        {"zh": "我们散开又聚拢。", "en": "We scatter and gather."},
        {"zh": "它退到粉尘谷边。", "en": "It's backed to the dust valley."},
        {"zh": "那里没有遮的。", "en": "There's no cover there."},
        {"zh": "我们慢慢压过去。", "en": "We press in slowly."},
        {"zh": "它站得越来越不稳。", "en": "Its footing is failing."},
        {"zh": "它在寻找出口。", "en": "It's looking for a way out."},
        {"zh": "出口被我们占了。", "en": "We hold the way out."},
        {"zh": "它撑不了更久。", "en": "It can't hold much longer."},
        {"zh": "它已经没力气了。", "en": "It has no strength left."},
        {"zh": "我们开始咬它。", "en": "We begin to bite."},
        {"zh": "从脚下开始咬。", "en": "Starting at the feet."},
        {"zh": "别让它跳起来。", "en": "Don't let it jump."},
        {"zh": "时间在我们这边。", "en": "Time is on our side."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我们一起下口咬。", "en": "We bite together."},
        {"zh": "但数量太多了。", "en": "But there are far too many."},
        {"zh": "它甩了一下腿。", "en": "It shook its leg."},
        {"zh": "有几只被甩掉了。", "en": "Several of us were flung off."},
        {"zh": "我们立刻补上。", "en": "We fill the gaps at once."},
        {"zh": "我们找缝隙咬。", "en": "We bite at the seams."},
        {"zh": "它渗出了一点血。", "en": "It bled a little."},
        {"zh": "血把我们染红了。", "en": "The blood stains us red."},
        {"zh": "它惨叫了一声。", "en": "It cried out."},
        {"zh": "声音让我们更兴奋。", "en": "The sound excites us."},
        {"zh": "更多的我们上去了。", "en": "More of us climb on."},
        {"zh": "它的腿在发抖。", "en": "Its leg is trembling."},
        {"zh": "它已经跪下了。", "en": "It's down on one knee."},
        {"zh": "我们压住了它。", "en": "We hold it down."},
        {"zh": "就快要结束了。", "en": "Almost over."},
        {"zh": "我们还在继续咬。", "en": "We're still biting."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "石头下面先有了动静。", "en": "Something stirs under the stone."},
        {"zh": "我们一只接一只出来。", "en": "We come out one after another."},
        {"zh": "粉尘谷的风带着灰。", "en": "Wind carries dust from the valley."},
        {"zh": "我们的细声连成一片。", "en": "Our rustling joins into one sound."},
        {"zh": "石头缝里全是同伴。", "en": "Kin in every crack."},
        {"zh": "我们爬到阴影里。", "en": "We crawl into the shade."},
        {"zh": "我们顺着它走。", "en": "We follow them."},
        {"zh": "四面都有我们。", "en": "We're on every side."},
        {"zh": "这里没人能久留。", "en": "No one lasts long here."},
        {"zh": "我们在这里等着。", "en": "We wait."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一过，我们散开一片。", "en": "Fire swept by and scattered a patch of us."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从石头上掉下去，翻了几下。", "en": "I fell off the stone and tumbled."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我们都冲散了。", "en": "Water scattered us all."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把一大片我们吹没了。", "en": "The blast blew away a whole patch of us."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西钉穿了我。", "en": "Something pinned through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量让整个群体炸开。", "en": "That force burst the swarm apart."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在互相消耗。", "en": "We're consuming each other."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让整片石头亮起来。", "en": "The flash lit the whole stone."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "石头下面全是空的。", "en": "There's nothing under the stone."}
      ]
    }
  }
}
