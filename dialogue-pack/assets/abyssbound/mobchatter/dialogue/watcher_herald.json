{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步一步踏过雾。", "en": "I step through the mist."},
        {"zh": "雾在我身后合起来。", "en": "The mist closes behind me."},
        {"zh": "我身上挂着几颗眼。", "en": "Several eyes hang from me."},
        {"zh": "我绕过一根石柱。", "en": "I pass a stone pillar."},
        {"zh": "深渊的风在我这里停住。", "en": "The abyss wind stops at me."},
        {"zh": "我的影子没有形状。", "en": "My shadow has no shape."},
        {"zh": "我走得很慢，很确定。", "en": "I walk slowly, certain."},
        {"zh": "石头在我脚下开裂。", "en": "Stones crack under my feet."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，所有的眼都睁着。", "en": "I stand, all my eyes open."},
        {"zh": "雾在我腰间流动。", "en": "Mist flows at my waist."},
        {"zh": "我站着，身上的眼一只只睁开。", "en": "I stand still as the eyes on my body open one by one."},
        {"zh": "我缓缓转动身体。", "en": "I turn slowly."},
        {"zh": "四周的石头低低作响。", "en": "The stones around hum low."},
        {"zh": "我把一只眼转向你。", "en": "I turn one eye toward you."},
        {"zh": "空气里有很重的味道。", "en": "The air carries a heavy smell."},
        {"zh": "我的影子伸得很长。", "en": "My shadow reaches far."},
        {"zh": "我睁着眼，却不看人。", "en": "My eyes are open, but not on you."},
        {"zh": "我的手指一直没动。", "en": "My fingers haven't moved."},
        {"zh": "我听见很远的回音。", "en": "I hear a distant echo."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你带了武器。", "en": "You brought a weapon."},
        {"zh": "我的眼睛都看着你。", "en": "All my eyes are on you."},
        {"zh": "我不会让你从这走开。", "en": "I won't let you walk away."},
        {"zh": "你手里的光快要灭了。", "en": "The light in your hand is failing."},
        {"zh": "你把那个留下。", "en": "Leave that behind."},
        {"zh": "你每喘一下，我的眼就转一下。", "en": "Each breath you take turns one of my eyes."},
        {"zh": "你退到石头前了。", "en": "You've backed against the stone."},
        {"zh": "我再看你一次。", "en": "I'll look at you once more."},
        {"zh": "你的影子被雾吞掉了。", "en": "The mist swallowed your shadow."},
        {"zh": "这只眼，是给你的。", "en": "This eye is for you."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我退开，脚下滑出裂缝。", "en": "I step back; a crack opens."},
        {"zh": "一只眼睛闭上了。", "en": "One eye closed."},
        {"zh": "打在我身上，很闷。", "en": "The blow landed dully."},
        {"zh": "我身上的雾散了一层。", "en": "A layer of mist peels off me."},
        {"zh": "我一声不出。", "en": "I make no sound."},
        {"zh": "地上的灰扬起来了。", "en": "The ash rises."},
        {"zh": "我身上的一只眼，永久闭上了。", "en": "One of my eyes has closed for good."},
        {"zh": "你比看着有力。", "en": "You're stronger than you look."},
        {"zh": "我还留在原处。", "en": "I'm still where I was."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那颗眼球在你手里。", "en": "That eye is in your hand."},
        {"zh": "它一直是我们的。", "en": "It has always been ours."},
        {"zh": "你把它还回来。", "en": "Give it back."},
        {"zh": "我闻到了深渊的味道。", "en": "I smell the abyss on it."},
        {"zh": "我的眼睛都在看它。", "en": "All my eyes are on it."},
        {"zh": "你举高一些。", "en": "Hold it higher."},
        {"zh": "那东西会让我更强。", "en": "That thing would make me stronger."},
        {"zh": "把那枚眼核举高，让我看看。", "en": "Lift that eye-core higher and let me see it."},
        {"zh": "把它交出来。", "en": "Hand it over."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我，像撞进深渊。", "en": "You hit me like hitting the abyss."},
        {"zh": "你撞上来，我连雾都没散。", "en": "You crash into me and not even my fog scatters."},
        {"zh": "我们脚下裂开了。", "en": "The ground splits under us."},
        {"zh": "我的眼睛同时转向你。", "en": "All my eyes turn to you at once."},
        {"zh": "雾把我们隔开。", "en": "Mist separates us."},
        {"zh": "你朝后退了。", "en": "You drew back."},
        {"zh": "这一下声音很沉。", "en": "The sound was very deep."},
        {"zh": "我没有挪动。", "en": "I haven't shifted."},
        {"zh": "你被雾推着走。", "en": "The mist pushes you on."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "另一个守望者在雾外。", "en": "Another watcher is beyond the mist."},
        {"zh": "我们的眼睛互相看着。", "en": "Our eyes watch each other."},
        {"zh": "没有声音，也不需要。", "en": "No sound, and none needed."},
        {"zh": "我们并肩站着。", "en": "We stand side by side."},
        {"zh": "雾把我们两个包住。", "en": "The mist encloses us both."},
        {"zh": "她的眼睛比我多。", "en": "She has more eyes than I do."},
        {"zh": "我们一起转向深处。", "en": "We turn toward the deep together."},
        {"zh": "她先动，没有脚步。", "en": "She moves first, without steps."},
        {"zh": "我跟在她后面。", "en": "I follow behind her."},
        {"zh": "我们一起消失在雾里。", "en": "We vanish into the mist together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起那颗眼球。", "en": "I pick up the eye."},
        {"zh": "它在我手里还在转。", "en": "It still turns in my hand."},
        {"zh": "它认得我的。", "en": "It knows me."},
        {"zh": "虚空之眼里，映着你的脸。", "en": "Your face is in the Voideye."},
        {"zh": "它安静下来了。", "en": "It went quiet."},
        {"zh": "我又多了一只眼。", "en": "Now I have one more eye."},
        {"zh": "我看得更清楚了。", "en": "I see more clearly."},
        {"zh": "这一带都在我眼里。", "en": "All of this is in my eyes."},
        {"zh": "我又接着往前走。", "en": "I walk on again."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我全都看见。", "en": "I see everything."},
        {"zh": "你站的地方在雾里。", "en": "You're standing in the mist."},
        {"zh": "身体里的眼都亮了。", "en": "The eyes in my body light up."},
        {"zh": "你的路线我算过了。", "en": "I've worked out your route."},
        {"zh": "这里只有这条路。", "en": "Only one path leads here."},
        {"zh": "你身边的地面在裂。", "en": "The ground beside you is cracking."},
        {"zh": "我的身体动了。", "en": "My body starts moving."},
        {"zh": "雾压得更低。", "en": "The mist presses lower."},
        {"zh": "我听见你的心。", "en": "I hear your heart."},
        {"zh": "你的影子我在看。", "en": "I'm watching your shadow."},
        {"zh": "再靠近一格。", "en": "One more block."},
        {"zh": "我的手举起来。", "en": "My hand rises."},
        {"zh": "你身后的石头裂了。", "en": "The stone behind you splits."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我随着雾跟。", "en": "I follow with the mist."},
        {"zh": "每一步地面都响。", "en": "The ground sounds at each step."},
        {"zh": "你绕过一座石柱。", "en": "You go round a pillar."},
        {"zh": "雾里没有别的路。", "en": "There's no other way in the mist."},
        {"zh": "我在这边等你。", "en": "I'll wait here for you."},
        {"zh": "你改了路线。", "en": "You changed your route."},
        {"zh": "我的步子更快了。", "en": "My steps are faster."},
        {"zh": "我的眼睛数得出你的脚步。", "en": "My eyes can count your steps."},
        {"zh": "你脚下的地面在塌。", "en": "The ground under you is collapsing."},
        {"zh": "离你很近了。", "en": "I'm very close now."},
        {"zh": "这一下挡不住。", "en": "You can't block this."},
        {"zh": "我停在雾里。", "en": "I stop in the mist."},
        {"zh": "雾把我的轮廓藏得干净。", "en": "The fog hides my outline completely."},
        {"zh": "但我看得见你。", "en": "But I see you."},
        {"zh": "你再走一格，就进我掌下。", "en": "One more block and you are under my palm."},
        {"zh": "到了这一步。", "en": "It comes to this."},
        {"zh": "你得留下点东西。", "en": "You'll leave something behind."},
        {"zh": "这样才算数。", "en": "That will count."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一掌下去，地面塌了。", "en": "My palm lands; the ground caves."},
        {"zh": "眼里的光打在你身上。", "en": "Light from my eyes strikes you."},
        {"zh": "你拿着的东西松了手。", "en": "You let go of what you held."},
        {"zh": "那枚眼核，我捡起来了。", "en": "I picked up that eye-core."},
        {"zh": "你又冲过来。", "en": "You charge again."},
        {"zh": "我用肩撞开你。", "en": "I shoulder you aside."},
        {"zh": "雾把伤口遮住了。", "en": "The mist hides the wound."},
        {"zh": "你还在喘着。", "en": "You're still panting."},
        {"zh": "我多了一只眼睛。", "en": "I have one more eye."},
        {"zh": "我看得更远了。", "en": "I see further now."},
        {"zh": "这一掌落下，雾被压平。", "en": "My palm falls and the fog is pressed flat."},
        {"zh": "我转身回去了。", "en": "I turn back."},
        {"zh": "雾重新合拢。", "en": "The mist closes again."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雾里多了一团影子。", "en": "A shape appears in the mist."},
        {"zh": "石柱后面亮起了眼。", "en": "Eyes light up behind the pillar."},
        {"zh": "雾开了一条缝，我走出。", "en": "The mist parts and I step out."},
        {"zh": "地面被我的重量压响。", "en": "The ground groans under me."},
        {"zh": "这里的石头很旧。", "en": "The stone here is old."},
        {"zh": "我身上所有的眼都开了。", "en": "All my eyes open."},
        {"zh": "风在这里断了。", "en": "The wind breaks here."},
        {"zh": "我找到了这个地方。", "en": "I've found this place."},
        {"zh": "光很暗，正好。", "en": "The light's dim; good."},
        {"zh": "我迈开了步子。", "en": "I take my steps."},
        {"zh": "雾先厚了一层，我才显形。", "en": "The fog thickens first, then I take shape."},
        {"zh": "很远的地方有石头在响。", "en": "Stones sound far away."},
        {"zh": "我听见那声响。", "en": "I heard the sound."},
        {"zh": "我朝那边转过。", "en": "I turn that way."},
        {"zh": "雾一直跟着我。", "en": "The mist follows me."},
        {"zh": "我的足印不在土上。", "en": "My footprints aren't on the soil."},
        {"zh": "石柱后亮起的眼，是我的。", "en": "The eyes lighting up behind the pillar are mine."},
        {"zh": "我还没动，已经看清你了。", "en": "I have not moved, yet I already see all of you."},
        {"zh": "你尽管跑吧。", "en": "Run if you like."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在我身上烧，眼睛全红了。", "en": "Fire burns on me; every eye goes red."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，砸碎了石板。", "en": "I land and shatter the flagstones."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水灌进我的眼，我沉下去。", "en": "Water fills my eyes; I sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把雾吹散，我露了出来。", "en": "The blast blows the mist away and exposes me."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物扎进我的一只眼。", "en": "A point pierces one of my eyes."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "别人的术法缠住我的眼。", "en": "Their spell knots around my eyes."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我什么都没吃很久了。", "en": "I haven't eaten in a long time."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷照亮了整片雾气。", "en": "Lightning lights the whole mist."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里很像我来的地方。", "en": "This place is much like where I came from."}
      ]
    }
  }
}
