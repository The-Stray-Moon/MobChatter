{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着雾底滑行。", "en": "I slide along beneath the mist."},
        {"zh": "我的身体是暗的，几乎看不见。", "en": "My body is dark, almost unseen."},
        {"zh": "我把身子折成一道弯。", "en": "I fold my body into a curve."},
        {"zh": "没有水，我也能游。", "en": "No water here, and still I swim."},
        {"zh": "雾随着我的动作散开。", "en": "The mist parts with my movement."},
        {"zh": "我贴着腐木的根部游。", "en": "I swim along the base of the rotting wood."},
        {"zh": "我的尾巴在后面拖着。", "en": "My tail trails behind me."},
        {"zh": "我往更深的黑里钻。", "en": "I burrow toward the deeper dark."},
        {"zh": "我朝暗处拐过去。", "en": "I turn toward the dark."},
        {"zh": "那边还要更深。", "en": "Deeper in."},
        {"zh": "我在那里停下。", "en": "I stop there."},
        {"zh": "我听着四周。", "en": "And listen."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬在雾里，一动不动。", "en": "I hang in the mist, motionless."},
        {"zh": "这里一点风也没有。", "en": "There is no wind here."},
        {"zh": "只有我的呼吸声。", "en": "Only my breathing."},
        {"zh": "地上有水，很浅。", "en": "Shallow water on the ground."},
        {"zh": "我的身体反着一点光。", "en": "My body catches a little light."},
        {"zh": "远处有一声很低的响。", "en": "A low sound far off."},
        {"zh": "我偏头朝那边。", "en": "I turn my head that way."},
        {"zh": "再没有别的了。", "en": "Nothing more."},
        {"zh": "我的尾巴在泥里划开一道。", "en": "My tail cuts a line through the mud."},
        {"zh": "沼泽的雾一直不散。", "en": "The swamp mist never clears."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进了雾里。", "en": "You have walked into the mist."},
        {"zh": "我的头已经浮到你腰高。", "en": "My head has risen to your waist."},
        {"zh": "你一点也没瞧见。", "en": "You did not see."},
        {"zh": "雾把我们的距离藏起来。", "en": "The mist hides the distance between us."},
        {"zh": "我的头抬到你腰的高度。", "en": "My head rises to your waist."},
        {"zh": "你终于低头了。", "en": "At last you look down."},
        {"zh": "黑暗里，我的牙先亮。", "en": "In the dark, my teeth show first."},
        {"zh": "雾把你的影子吞掉了。", "en": "The mist swallows your shadow."},
        {"zh": "我尾随着跟过去。", "en": "I trail after."},
        {"zh": "我并不着急。", "en": "No hurry."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我弓了一下，又伸直。", "en": "I arch once, then straighten."},
        {"zh": "身体上有一道口子。", "en": "A gash opens on my body."},
        {"zh": "暗色的东西滴下来。", "en": "Something dark drips."},
        {"zh": "我退进雾里去。", "en": "I withdraw into the mist."},
        {"zh": "在那里我安全。", "en": "There I am safe."},
        {"zh": "我缓缓盘得更紧。", "en": "I coil tighter, slowly."},
        {"zh": "伤口正在合上。", "en": "The wound closes."},
        {"zh": "很慢，可是会合。", "en": "Slowly, but it closes."},
        {"zh": "我安静地等着。", "en": "I wait quietly."},
        {"zh": "这里的时间没有意义。", "en": "Time means nothing here."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西在动着。", "en": "That thing is moving."},
        {"zh": "我朝它凑近些。", "en": "I edge nearer."},
        {"zh": "它不像是吃的。", "en": "It does not look like food."},
        {"zh": "但我还是闻了闻。", "en": "But I sniff it anyway."},
        {"zh": "闻不出味道。", "en": "Nothing."},
        {"zh": "那点光，引我从泥里出来。", "en": "That little light draws me from the mud."},
        {"zh": "那点热气让我靠近。", "en": "That little warmth draws me closer."},
        {"zh": "我看着，没有动。", "en": "I watch, and do not move."},
        {"zh": "这不是我吃的东西。", "en": "That is not what I eat."},
        {"zh": "我的头贴着水面抬起。", "en": "My head lifts flush with the water."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我，我顺势滑开。", "en": "You touch me; I slide away with it."},
        {"zh": "你的手陷进我的身体。", "en": "Your hand sinks into my body."},
        {"zh": "你摸到的是冷的，像深海。", "en": "What you touched is cold, like deep sea."},
        {"zh": "以太沼泽的水，我熟。", "en": "The aether swamp water is my home."},
        {"zh": "你没有转过身。", "en": "You do not turn."},
        {"zh": "我的尾巴碰到你的腿。", "en": "My tail brushes your leg."},
        {"zh": "你猛地一颤。", "en": "You jerk hard."},
        {"zh": "我笑了，但没有声音。", "en": "I laugh, without sound."},
        {"zh": "我又退进雾里。", "en": "I withdraw into the mist."},
        {"zh": "你立在原地不动。", "en": "You stand where you are."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "雾深处还有一条。", "en": "There is another deep in the mist."},
        {"zh": "我们绕在一起。", "en": "We coil around each other."},
        {"zh": "身体贴着身体。", "en": "Body against body."},
        {"zh": "两条都很冷。", "en": "Both cold."},
        {"zh": "我们的身体缠成一股。", "en": "Our bodies twist into a single strand."},
        {"zh": "又一起沉下去。", "en": "And sink together."},
        {"zh": "水下没有声音。", "en": "No sound under the water."},
        {"zh": "也不需要声音。", "en": "None needed."},
        {"zh": "我们各自分开。", "en": "We part."},
        {"zh": "各自游进不同的雾里。", "en": "Each into different mist."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "它沉下去，我又捞回来。", "en": "It sank, so I fished it back up."},
        {"zh": "我的牙在上面打滑。", "en": "My teeth slide off its surface."},
        {"zh": "我用牙试了试它的硬度。", "en": "I test its hardness with my teeth."},
        {"zh": "留下了两个印。", "en": "Two marks remain."},
        {"zh": "这个不好吃。", "en": "Not good to eat."},
        {"zh": "我把它拖进泥底下。", "en": "I drag it down under the mud."},
        {"zh": "我把东西拖进泥洞里。", "en": "I drag it into my muddy hole."},
        {"zh": "我看着它往下沉。", "en": "I watch it go down."},
        {"zh": "然后我抬起头。", "en": "Then raise my head."},
        {"zh": "你仍站在那儿。", "en": "You are still standing there."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽的水面浮起气泡。", "en": "Bubbles rise on the swamp surface."},
        {"zh": "我的头偏过去。", "en": "My head turns aside."},
        {"zh": "很慢，而且很小。", "en": "Slow. Small."},
        {"zh": "但会动就够了。", "en": "But moving is enough."},
        {"zh": "我贴着地面游。", "en": "I swim along the ground."},
        {"zh": "雾把我遮住了。", "en": "The mist hides me."},
        {"zh": "它一点没察觉。", "en": "It is quite unaware."},
        {"zh": "我感觉到水的震动。", "en": "I feel the water shudder."},
        {"zh": "水只到我的腹部。", "en": "The water reaches only my belly."},
        {"zh": "以太沼泽的水，托着我。", "en": "Aetherswamp water carries me."},
        {"zh": "雾里有一道温热的轮廓。", "en": "There's a warm outline in the mist."},
        {"zh": "把身子盘起来，缠住水草。", "en": "Coiling up, wrapping the waterweed."},
        {"zh": "沼泽的水里，我慢慢绕紧。", "en": "In the swamp water, I coil slowly."},
        {"zh": "绕上去缠住。", "en": "Coil."},
        {"zh": "水里有一圈纹。", "en": "A ring spreads on the water."},
        {"zh": "我朝那圈纹去。", "en": "I go toward it."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着它游动。", "en": "I circle it."},
        {"zh": "雾跟着我打转。", "en": "The mist turns with me."},
        {"zh": "深渊鳗滑过去，一点声都没有。", "en": "The abyssal eel slides past without a sound."},
        {"zh": "我一直在它侧面。", "en": "I stay on its flank."},
        {"zh": "它往左，我先到左。", "en": "It goes left; I am left first."},
        {"zh": "它往右，我又在右。", "en": "It goes right; I am right."},
        {"zh": "它已经慌了。", "en": "It is panicking."},
        {"zh": "呼吸变得很快。", "en": "Its breathing quickens."},
        {"zh": "我贴着柱子兜回来。", "en": "I circle back around."},
        {"zh": "我把身子停住。", "en": "I halt."},
        {"zh": "先让它跑一段。", "en": "Let it run a while."},
        {"zh": "它也跑不远。", "en": "It will not get far."},
        {"zh": "这里只有雾。", "en": "There is only mist here."},
        {"zh": "我在水草间滑行。", "en": "I glide between the water weeds."},
        {"zh": "它撞到了一根柱子。", "en": "It strikes a pillar."},
        {"zh": "它跌倒在地。", "en": "And falls."},
        {"zh": "深渊的雾里，我盘成一圈。", "en": "In abyssal fog, I coil into a ring."},
        {"zh": "一点又一点。", "en": "Little by little."},
        {"zh": "再收紧一些。", "en": "Tighten."},
        {"zh": "我贴着柱子绕过去。", "en": "I slip around a pillar."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "牙一排排地往里扣。", "en": "Row after row of teeth sink in."},
        {"zh": "牙又细又多。", "en": "My teeth are fine, and many."},
        {"zh": "我在雾里游得像根绳。", "en": "In the mist I swim like a rope."},
        {"zh": "我把身子缠上去。", "en": "I wrap around it."},
        {"zh": "一圈，然后又两圈。", "en": "One coil, two."},
        {"zh": "它慢慢慢下来。", "en": "It is slowing."},
        {"zh": "我咬住你的脚踝往下拖。", "en": "I bite your ankle and drag you down."},
        {"zh": "这会让它更慢。", "en": "That makes it slower still."},
        {"zh": "我的牙从雾里探出来。", "en": "My teeth slide out of the fog."},
        {"zh": "骨头在我里面响。", "en": "Bones creak inside my coils."},
        {"zh": "然后就再没响了。", "en": "Then they do not."},
        {"zh": "我把身子松开。", "en": "I loosen."},
        {"zh": "它落进浅水里。", "en": "It falls into the shallow water."},
        {"zh": "我抬头看了看雾。", "en": "I raise my head to the mist."},
        {"zh": "什么也没有改变。", "en": "Nothing has changed."},
        {"zh": "我抽身退进黑水里。", "en": "I pull back into the black water."},
        {"zh": "我咬住不放开。", "en": "I hold my bite."},
        {"zh": "它在我身下挣。", "en": "It struggles beneath me."},
        {"zh": "我的身体一圈圈加厚。", "en": "My coils thicken, ring by ring."},
        {"zh": "直到它不再动。", "en": "Until it stops."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从雾里出来。", "en": "I come out of the mist."},
        {"zh": "这里并不是海。", "en": "This is not the sea."},
        {"zh": "但也一样是暗的。", "en": "But it is dark too."},
        {"zh": "我昂头嗅了嗅。", "en": "I raise my head and scent."},
        {"zh": "有铁锈，有旧石头。", "en": "Rust, and old stone."},
        {"zh": "还有活着的生物。", "en": "And living things."},
        {"zh": "我从地上滑过。", "en": "I slide along the ground."},
        {"zh": "脚下是浅浅的积水。", "en": "Shallow water underfoot."},
        {"zh": "我的身体贴着它。", "en": "My body presses to it."},
        {"zh": "我从沼泽的淤泥里钻出。", "en": "I rise out of the swamp silt."},
        {"zh": "我不朝那边去。", "en": "I do not go toward it."},
        {"zh": "我朝更深处游。", "en": "I swim deeper in."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎过我，我的身体缩了一下。", "en": "Fire passes over me and my body shrinks."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从高处落下，摔在浅水里。", "en": "I fall from height into the shallow water."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水淹住我，我的鳃几乎不动。", "en": "Water covers me and my gills barely move."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我甩到柱子上。", "en": "The blast throws me against a pillar."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭从我身体里滑了出去。", "en": "The arrow slid right through my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "怪光锁住我，我动不了。", "en": "Strange light locks me still."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "太久没有猎物，我越来越冷。", "en": "Too long without prey, and I grow colder."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落进浅水，我全身一颤。", "en": "Lightning strikes the shallow water and I convulse."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "雾散了，我在黑里坠。", "en": "The mist scatters and I fall through black."}
      ]
    }
  }
}
