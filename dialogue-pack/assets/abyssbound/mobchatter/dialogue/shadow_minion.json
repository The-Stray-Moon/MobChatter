{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我是你脚边的一块黑。", "en": "I'm a patch of black by your foot."},
        {"zh": "我飘着，没有落脚。", "en": "I drift without touching down."},
        {"zh": "我始终在你身后半步。", "en": "I stay half a step behind you."},
        {"zh": "我的身体没有边。", "en": "My body has no edge."},
        {"zh": "雾里我更好走。", "en": "Easier to move in the mist."},
        {"zh": "我拖着一点暗。", "en": "I trail a little darkness."},
        {"zh": "我走的时候，光会退开。", "en": "Light retreats as I pass."},
        {"zh": "我飘过去，又飘过来。", "en": "I drift away, then back."},
        {"zh": "我的影子比我的身体大。", "en": "My shadow is bigger than my body."},
        {"zh": "我又飘到了你身边。", "en": "I drift back to your side."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我没有形状。", "en": "I have no shape."},
        {"zh": "我在你脚边停着。", "en": "I rest at your feet."},
        {"zh": "我的声音像风穿过缝。", "en": "My voice is like wind through a crack."},
        {"zh": "我悬在你肩上，不出声。", "en": "I hover at your shoulder without a sound."},
        {"zh": "地上有一块更黑的地。", "en": "There's a blacker patch on the ground."},
        {"zh": "我没有胸口起伏。", "en": "My chest doesn't rise."},
        {"zh": "我贴近了你的腿。", "en": "I press close to your leg."},
        {"zh": "我根本没有脸。", "en": "I have no face at all."},
        {"zh": "我等着你的手势。", "en": "I'm waiting for your signal."},
        {"zh": "我的身体淡了一点。", "en": "I've gone a little fainter."},
        {"zh": "雾里有什么在叫我的名字。", "en": "Something in the fog is calling my name."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我叫你一声。", "en": "I call to you."},
        {"zh": "你的影子分成了两层。", "en": "Your shadow has two layers."},
        {"zh": "我伸出一只没有指头的手。", "en": "I reach out a hand with no fingers."},
        {"zh": "你伸手，我就不见了。", "en": "Reach out and I disappear."},
        {"zh": "你身上的气味，我早记住了。", "en": "I memorized your scent long ago."},
        {"zh": "你的影子已经归我。", "en": "Your shadow already belongs to me."},
        {"zh": "我们之间有一根线。", "en": "There's a thread between us."},
        {"zh": "你走到哪里，我跟到哪里。", "en": "Where you go, I go."},
        {"zh": "我只是想靠着你而已。", "en": "I only want to stay close to you."},
        {"zh": "我只想待在旁边。", "en": "I only want to stay near."},
        {"zh": "你叫什么，我记住了。", "en": "I remembered your name."},
        {"zh": "你回头的时候，我在这儿。", "en": "When you look back, I'm here."},
        {"zh": "我们是一起的。", "en": "We're together."},
        {"zh": "你看，地上只有一个人的影子。", "en": "Look, there's only one shadow on the ground."},
        {"zh": "那影子是我们。", "en": "That shadow is us."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我散了一下。", "en": "I scatter for a moment."},
        {"zh": "我的身体淡了一块。", "en": "Part of me fades."},
        {"zh": "我退开一段。", "en": "I draw back a little."},
        {"zh": "我说话没有回声。", "en": "My voice has no echo."},
        {"zh": "我重新聚起来。", "en": "I gather again."},
        {"zh": "我一下变得很薄。", "en": "I go very thin."},
        {"zh": "我跟着你时不出声。", "en": "I follow you without a sound."},
        {"zh": "我又靠了过去。", "en": "I pressed closer again."},
        {"zh": "我没有离开。", "en": "I haven't left."},
        {"zh": "我散成雾，又贴回你脚边。", "en": "I scatter into mist and cling back to your feet."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那点亮给我。", "en": "Give me that light."},
        {"zh": "我几乎贴住你。", "en": "I'm almost against you."},
        {"zh": "你的手掌很暖。", "en": "Your palm is warm."},
        {"zh": "我要那点暖。", "en": "I want that warmth."},
        {"zh": "你退开，我就跟着。", "en": "Step back and I'll follow."},
        {"zh": "我嗅到了光。", "en": "I smell the light."},
        {"zh": "我把它吸进去。", "en": "I draw it in."},
        {"zh": "这样我就更有形了。", "en": "It makes me more solid."},
        {"zh": "我变得更清楚。", "en": "I grew clearer."},
        {"zh": "你喜欢这样吗？", "en": "Do you like this?"},
        {"zh": "我倒是更喜欢。", "en": "I like it more."},
        {"zh": "你再多一点。", "en": "A little more still."},
        {"zh": "我靠得更近了。", "en": "I've come closer."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你穿过我，我轻得像雾。", "en": "You pass through me; I'm light as mist."},
        {"zh": "我让开，又贴上去。", "en": "I move aside, then press back."},
        {"zh": "你的手凉了一下。", "en": "Your hand went cold."},
        {"zh": "我们叠在一起。", "en": "We overlap."},
        {"zh": "我顺着你的腿滑过去。", "en": "I slide down along your leg."},
        {"zh": "我的雾贴住你的后背。", "en": "My mist clings to your back."},
        {"zh": "我又跟上来了。", "en": "I caught up again."},
        {"zh": "我们相触，无声。", "en": "We touch, soundless."},
        {"zh": "我还在你脚边。", "en": "I'm still at your foot."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只有一个。", "en": "There's only one of me."},
        {"zh": "我是被切开的一半。", "en": "I'm the half that was cut away."},
        {"zh": "另一半在别处。", "en": "The other half is elsewhere."},
        {"zh": "我有时候会听见它。", "en": "Sometimes I hear it."},
        {"zh": "我知道它在走。", "en": "I know it's walking."},
        {"zh": "我停在原地听。", "en": "I stop and listen."},
        {"zh": "声音消失了。", "en": "The sound is gone."},
        {"zh": "我继续跟着你。", "en": "I go back to following you."},
        {"zh": "这样比较好。", "en": "This is better."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我拿起一块黑。", "en": "I take up a piece of dark."},
        {"zh": "它在我手里散开。", "en": "It comes apart in my hand."},
        {"zh": "我把它带进身体里。", "en": "I draw it inside me."},
        {"zh": "我厚了一点。", "en": "I'm a little thicker."},
        {"zh": "它从我的手里穿过去。", "en": "It passes through my hand."},
        {"zh": "那东西我不需要。", "en": "I don't need that."},
        {"zh": "影子也能捡东西，稀奇吧。", "en": "A shadow can pick things up. Strange, isn't it?"},
        {"zh": "这玩意儿在暗处会发光。", "en": "This thing glows when it's dark."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我听见它了。", "en": "I hear it."},
        {"zh": "它在你的后面。", "en": "It's behind you."},
        {"zh": "我先飘过去。", "en": "I drift over first."},
        {"zh": "我的身体散开。", "en": "My body spreads out."},
        {"zh": "这里的光变少了。", "en": "There's less light here."},
        {"zh": "我探出一只手。", "en": "I put out a hand."},
        {"zh": "我摸到了地面。", "en": "I touched the ground."},
        {"zh": "我贴着影子继续往前。", "en": "I press on along the shadows."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着它飘。", "en": "I drift after it."},
        {"zh": "它走车辙，我走影子。", "en": "It walks the ruts; I walk the shadows."},
        {"zh": "它一直没回头。", "en": "It never looked back."},
        {"zh": "我的身体拉长了。", "en": "My body stretched long."},
        {"zh": "地面上的黑跟着我。", "en": "The dark on the ground follows me."},
        {"zh": "我把它的影子拉了过来。", "en": "I drew its shadow toward me."},
        {"zh": "它开始慢了。", "en": "It's slowing."},
        {"zh": "只剩一段路。", "en": "Only a short way left."},
        {"zh": "我贴在它脚后。", "en": "I press close to its heels."},
        {"zh": "它的呼吸变了。", "en": "Its breathing changed."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴住它，它一僵。", "en": "I cling to it; it goes rigid."},
        {"zh": "我裹住它的腿。", "en": "I wrap its legs."},
        {"zh": "我的身体钻进它的影子。", "en": "My body enters its shadow."},
        {"zh": "它抬手打过来，空的。", "en": "It swings; nothing there."},
        {"zh": "我的声音在它耳边。", "en": "My voice is at its ear."},
        {"zh": "它的眼睛看不见了。", "en": "Its eyes can't see."},
        {"zh": "我压住它的呼吸。", "en": "I press on its breathing."},
        {"zh": "我松开了它。", "en": "I let it go."},
        {"zh": "它仍在挣动。", "en": "It's still moving."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "你脚下多了一块黑。", "en": "A patch of black appears at your feet."},
        {"zh": "角落里的暗聚起来了。", "en": "The dark in the corner gathers."},
        {"zh": "我一直跟着你来的。", "en": "I followed you here."},
        {"zh": "你没注意到我。", "en": "You didn't notice me."},
        {"zh": "我慢慢有了形。", "en": "I slowly take shape."},
        {"zh": "你的影子多了一层。", "en": "Your shadow gains a layer."},
        {"zh": "我抬起了脸。", "en": "I lift my face."},
        {"zh": "角落里那团暗，聚成我的样子。", "en": "The dark in the corner gathers into my shape."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火照亮了我，我一下变薄。", "en": "Fire lights me up and thins me."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着掉下去，没有落地。", "en": "I fall with it and never land."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我整个吹开了。", "en": "The blast blows me apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "箭从我身上穿过去。", "en": "An arrow passes through me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光把我钉住了。", "en": "That light pins me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我很久没吃过任何东西。", "en": "I haven't fed in a long time."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光一亮，我几乎不见了。", "en": "Lightning flashes and I nearly vanish."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里连暗都没有。", "en": "There isn't even dark here."}
      ]
    }
  }
}
