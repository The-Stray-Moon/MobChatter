{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我挪着厚重的菌盖走。", "en": "I move with a heavy cap on my back."},
        {"zh": "菌褶在我身后开合。", "en": "The gills open and close behind me."},
        {"zh": "我的腿是白的，很软。", "en": "My legs are white and soft."},
        {"zh": "我踩下去地上留下湿印。", "en": "Wet prints stay where I step."},
        {"zh": "我沿着岩壁的阴影走。", "en": "I keep to the shadow of the rock wall."},
        {"zh": "孢子跟着我一路落。", "en": "Spores fall behind me the whole way."},
        {"zh": "我在裂谷里朝有光的地方挪。", "en": "I move toward the light in the rift."},
        {"zh": "我的身上有股霉味。", "en": "I carry a mouldy smell."},
        {"zh": "我挪着菌盖，慢慢逼过来。", "en": "I heave my cap forward, closing in slowly."},
        {"zh": "我走路像在拖东西。", "en": "I walk as if dragging something."},
        {"zh": "菌盖压得我脖子很低。", "en": "The cap keeps my head low."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，菌盖轻轻颤。", "en": "I stand, my cap quivering."},
        {"zh": "孢子在我周围飘。", "en": "Spores drift around me."},
        {"zh": "我在等脚下的东西长出来。", "en": "I wait for something to grow beneath me."},
        {"zh": "我的呼吸很湿。", "en": "My breathing is damp."},
        {"zh": "地上有一圈发白的。", "en": "A pale ring lies on the ground."},
        {"zh": "我的菌褶在动。", "en": "My gills move."},
        {"zh": "空气里全是霉味。", "en": "The air is thick with mould."},
        {"zh": "抬起一只脚，菌盖在抖。", "en": "I lift a foot and my cap trembles."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩在我的圈里了。", "en": "You're standing in my ring."},
        {"zh": "我抬起头，菌盖很宽。", "en": "I raise my head; the cap is wide."},
        {"zh": "这里有我种下的东西。", "en": "There's something I planted here."},
        {"zh": "你呼吸的时候，孢子进去了。", "en": "You breathed; the spores went in."},
        {"zh": "我在等你慢下来。", "en": "I'm waiting for you to slow."},
        {"zh": "你退出去会好一点。", "en": "Stepping out might help you."},
        {"zh": "我的身体很软，但很沉。", "en": "I'm soft, but heavy."},
        {"zh": "你身上已经有味道了。", "en": "You already carry my smell."},
        {"zh": "这里是我的地。", "en": "This ground is mine."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的菌盖裂了一道。", "en": "A crack opens in my cap."},
        {"zh": "孢子被我抖散了。", "en": "The spores shake loose."},
        {"zh": "我退了一步，很沉。", "en": "I step back, heavily."},
        {"zh": "我没有叫，只是散。", "en": "I don't cry out; I just scatter."},
        {"zh": "我的腿软了一截。", "en": "My legs give a little."},
        {"zh": "白色的东西渗出来。", "en": "Something white seeps out."},
        {"zh": "我把菌盖压低。", "en": "I press my cap down."},
        {"zh": "我还长在这里。", "en": "I'm still rooted here."},
        {"zh": "我慢慢挪回去。", "en": "I move back slowly."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "有腐木的味道。", "en": "That's the smell of rotting wood."},
        {"zh": "把它留在土上。", "en": "Leave it on the soil."},
        {"zh": "这东西能吃的。", "en": "This can be eaten."},
        {"zh": "它在地上烂着。", "en": "It's rotting on the ground."},
        {"zh": "这样才最好。", "en": "That's for the best."},
        {"zh": "我把它盖住。", "en": "I cover it."},
        {"zh": "很快就会长。", "en": "It will grow soon."},
        {"zh": "你也会长出来。", "en": "You'll grow too."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞进我的菌盖。", "en": "You bump into my cap."},
        {"zh": "菌盖晃了一下。", "en": "My cap sways."},
        {"zh": "孢子扬起来一片。", "en": "A cloud of spores lifts."},
        {"zh": "你吸进去了。", "en": "You breathed them in."},
        {"zh": "我的菌盖转过来。", "en": "My cap turns around."},
        {"zh": "我们挤在一处。", "en": "We crowd together."},
        {"zh": "地上留了一圈湿。", "en": "A wet ring stays on the ground."},
        {"zh": "你退开了一小段。", "en": "You draw back a little."},
        {"zh": "我已经在这里了。", "en": "I'm already here."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "林子那边还有一株。", "en": "There's another colony over there."},
        {"zh": "它比我高，菌盖更暗。", "en": "It's taller, with a darker cap."},
        {"zh": "我们的孢子混在一起。", "en": "Our spores mix."},
        {"zh": "两片菌盖在土上碰了一下。", "en": "Two caps touch once on the soil."},
        {"zh": "地上的圈连成一片。", "en": "The rings on the ground join."},
        {"zh": "它先动了一下。", "en": "It moved first."},
        {"zh": "我也跟着挪。", "en": "I shift along too."},
        {"zh": "这里的土很合适。", "en": "The soil here is right."},
        {"zh": "我们一起等着。", "en": "We wait together."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起一块腐木。", "en": "I pick up a piece of rotting wood."},
        {"zh": "我把它埋进身下。", "en": "I sink it under me."},
        {"zh": "它会烂得更快。", "en": "It will rot faster."},
        {"zh": "我用菌盖把它遮住。", "en": "I shade it with my cap."},
        {"zh": "这东西很湿。", "en": "This is very wet."},
        {"zh": "我把它收进去。", "en": "I take it in."},
        {"zh": "这里的土也吃。", "en": "I eat the soil too."},
        {"zh": "掉下来的，我收进伞盖里。", "en": "Anything that falls, I tuck under my cap."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到了活物的味。", "en": "I smell something living."},
        {"zh": "我朝那点活气挪过去。", "en": "I shift toward that flicker of living warmth."},
        {"zh": "菌盖朝向你。", "en": "My cap turns toward you."},
        {"zh": "孢子已经飘过去了。", "en": "The spores have already drifted over."},
        {"zh": "我慢慢地来。", "en": "I come slowly."},
        {"zh": "你还没发觉。", "en": "You haven't noticed."},
        {"zh": "我挪得更近了。", "en": "I come nearer."},
        {"zh": "我的根在动。", "en": "My roots are moving."},
        {"zh": "你脚下的地软了。", "en": "The ground under you is softening."},
        {"zh": "菌褶张开，孢子先飘出去。", "en": "My gills open and the spores drift out ahead of me."},
        {"zh": "这里会长出新的东西。", "en": "Something new will grow here."},
        {"zh": "就在你脚下。", "en": "Right under your feet."},
        {"zh": "我伸出手了。", "en": "I've reached out."},
        {"zh": "孢子已经够了。", "en": "The spores are enough."},
        {"zh": "你千万不要动。", "en": "Whatever you do, don't move."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我顺着踩湿的地面跟过去。", "en": "I follow the trail of ground you have dampened."},
        {"zh": "我挪得不快。", "en": "I don't move fast."},
        {"zh": "它跑过石头。", "en": "It ran over the stone."},
        {"zh": "孢子先到了。", "en": "The spores arrived first."},
        {"zh": "它开始咳了，孢子到嗓子。", "en": "It's starting to cough. Spores in its throat."},
        {"zh": "它的脚步乱。", "en": "Its steps are unsteady."},
        {"zh": "我还在后面。", "en": "I'm still behind it."},
        {"zh": "地面越来越湿。", "en": "The ground grows wetter."},
        {"zh": "它靠到岩壁上了。", "en": "It's leaning on the rock wall."},
        {"zh": "菌盖挡住了路。", "en": "My cap blocks the way."},
        {"zh": "再压过去一下。", "en": "One more press."},
        {"zh": "它撑不住了。", "en": "It can't hold up."},
        {"zh": "它已经坐下。", "en": "It has sat down."},
        {"zh": "这样就刚好。", "en": "That's just right."},
        {"zh": "我压上去了。", "en": "I press over it."},
        {"zh": "它没有反抗。", "en": "It didn't resist."},
        {"zh": "它的眼睛闭上了。", "en": "Its eyes closed."},
        {"zh": "这里很快就会长满。", "en": "This place will be overgrown soon."},
        {"zh": "我心里满意。", "en": "I'm content inside."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我一头压下去，孢子炸开。", "en": "I bear down; the spores burst."},
        {"zh": "它被呛住了。", "en": "It's choking."},
        {"zh": "菌盖把它罩住。", "en": "My cap covers it."},
        {"zh": "它的皮肤开始发白。", "en": "Its skin begins to pale."},
        {"zh": "我又压了一下。", "en": "I press again."},
        {"zh": "它挣得很弱。", "en": "It struggles weakly."},
        {"zh": "地上湿了一大片。", "en": "A wide patch of ground is wet."},
        {"zh": "它没有气了。", "en": "It stopped breathing."},
        {"zh": "下面已经有白的了。", "en": "White is already showing beneath."},
        {"zh": "我把它盖回去。", "en": "I cover it again."},
        {"zh": "这里会一直湿着。", "en": "It will stay wet here."},
        {"zh": "等它长出来。", "en": "Waiting for it to grow."},
        {"zh": "这要一点时间。", "en": "It takes a little time."},
        {"zh": "但我等得起。", "en": "But I can wait."},
        {"zh": "孢子还在飘。", "en": "The spores still drift."},
        {"zh": "我也还在这里。", "en": "I'm still here too."},
        {"zh": "我把它裹进菌褶里。", "en": "I fold it into my gills."},
        {"zh": "吐出更浓的孢子。", "en": "I release a thicker cloud of spores."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "岩壁下冒出了一片白。", "en": "A patch of white appears under the wall."},
        {"zh": "孢子先散开。", "en": "The spores spread first."},
        {"zh": "这里的土很合我。", "en": "The soil suits me."},
        {"zh": "我先把菌盖撑开。", "en": "I open my cap first."},
        {"zh": "地上有一圈颜色变白了。", "en": "A ring on the ground has gone white."},
        {"zh": "空气里有霉味。", "en": "Mould is in the air."},
        {"zh": "有什么在走动。", "en": "Something's walking."},
        {"zh": "我顺着岩壁移过去。", "en": "I move along the wall."},
        {"zh": "我从岩壁下的白斑里站起来。", "en": "I rise out of the white patch beneath the rock wall."},
        {"zh": "菌盖顶开了一层碎石。", "en": "My cap pushes through the rubble."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，我的菌盖卷起来了。", "en": "Fire curls my cap."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我摔下去，菌盖先裂了。", "en": "I fall, and the cap splits first."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我泡开了。", "en": "Water soaks me apart."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆响把我掀翻，菌盖碎了。", "en": "The blast flips me; my cap breaks."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根尖物扎进菌盖里。", "en": "A point sticks into my cap."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光把我的菌褶照白了。", "en": "That light bleaches my gills."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我饿得菌盖都塌了。", "en": "Hunger makes my cap sag."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，孢子全烧了。", "en": "Lightning strikes; the spores burn."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有土，长不了。", "en": "No soil here; I can't grow."}
      ]
    }
  }
}
