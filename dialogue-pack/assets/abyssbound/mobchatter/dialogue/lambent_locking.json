{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我沿着深渊的岩脊走。", "en": "I walk the abyss's ridge."},
        {"zh": "我的光照在雾里。", "en": "My glow lights the fog."},
        {"zh": "我一步一晃，像在飘。", "en": "I sway as I step, almost floating."},
        {"zh": "岩石在我脚下发脆。", "en": "The rock crumbles under me."},
        {"zh": "我从雾里慢慢显形。", "en": "I take shape out of the mist."},
        {"zh": "我的角刮过石壁。", "en": "My horns scrape the wall."},
        {"zh": "我绕着深坑走。", "en": "I circle the deep pit."},
        {"zh": "我的影子投在雾上。", "en": "My shadow falls on the fog."},
        {"zh": "我走得很慢，很有分量。", "en": "Slow, and heavy with intent."},
        {"zh": "我朝光的方向去。", "en": "I move toward the light."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我悬停在半空。", "en": "I hover in place."},
        {"zh": "雾在我身边绕。", "en": "The fog curls around me."},
        {"zh": "我在听深渊的声音。", "en": "I listen to the abyss."},
        {"zh": "光里的我纹丝不动。", "en": "I don't move at all."},
        {"zh": "这里的空气很沉。", "en": "The air is heavy here."},
        {"zh": "雾里的光一明一暗，像呼吸。", "en": "The light in the mist pulses like breathing."},
        {"zh": "雾遮住了下面的路。", "en": "Fog hides the way below."},
        {"zh": "我数着岩石的层。", "en": "I count the layers of rock."},
        {"zh": "我慢慢地吸气。", "en": "I draw a slow breath."},
        {"zh": "深渊的岩层在我脚下睡了千年。", "en": "The abyss rock beneath me has slept a thousand years."},
        {"zh": "雾里只剩我的呼吸。", "en": "I'm doing nothing."},
        {"zh": "我知道你在那里。", "en": "I know you're there."},
        {"zh": "我悬在雾里等候。", "en": "I wait."},
        {"zh": "这片雾是我的。", "en": "This fog is mine."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走得比我预想的远。", "en": "You've come further than I expected."},
        {"zh": "这层雾之下没有人。", "en": "No one belongs beneath this fog."},
        {"zh": "我的光照着你。", "en": "My light falls on you."},
        {"zh": "你是谁的名字？", "en": "Whose name are you?"},
        {"zh": "你的火把照不进我这层雾。", "en": "Your torch cannot reach into my mist."},
        {"zh": "你的脚步很轻。", "en": "Your steps are light."},
        {"zh": "这条路没有回去的。", "en": "This road has no way back."},
        {"zh": "我允许你站着。", "en": "I permit you to stand."},
        {"zh": "你居然不害怕。", "en": "You aren't afraid."},
        {"zh": "我想看看你能走多远。", "en": "I want to see how far you get."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "身上的光，摇了一下。", "en": "The light around me flickered."},
        {"zh": "雾散开了一瞬。", "en": "The fog parted for an instant."},
        {"zh": "这一下打到了我的角。", "en": "That struck my horn."},
        {"zh": "我往雾里退开半步。", "en": "I gave half a step."},
        {"zh": "深渊已经听见了。", "en": "The abyss heard that."},
        {"zh": "我的形体淡了一层。", "en": "My form faded a layer."},
        {"zh": "我不会流血的。", "en": "I don't bleed."},
        {"zh": "光晃了一下，雾又合拢了。", "en": "My light flickers, and the mist closes again."},
        {"zh": "你做到了什么？", "en": "What did you accomplish?"},
        {"zh": "你能撑到第几层？", "en": "How deep can you last?"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "这些吃食与光无关。", "en": "I don't eat."},
        {"zh": "这东西对深渊无用。", "en": "That means nothing to me."},
        {"zh": "我身上的光，是锁链做的。", "en": "My light is made of chains."},
        {"zh": "深渊里没有食物。", "en": "There is no food in the abyss."},
        {"zh": "别把供品摆到雾里。", "en": "I need no offerings."},
        {"zh": "你把它从雾里带走。", "en": "Keep it."},
        {"zh": "它轻得握不住影子。", "en": "That's too light."},
        {"zh": "我不碰这些东西。", "en": "I don't touch such things."},
        {"zh": "快把它拿走吧。", "en": "Take it away."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一层淡淡的光。", "en": "I'm barely solid."},
        {"zh": "你被推开了半步。", "en": "You were pushed back half a step."},
        {"zh": "别站在我的角前。", "en": "Don't stand before my horns."},
        {"zh": "这道岩脊我让你过。", "en": "I yield this step."},
        {"zh": "你的手很冰凉。", "en": "Your hand is cold."},
        {"zh": "这点碰撞我不在意。", "en": "That collision means nothing."},
        {"zh": "把岩脊中间空出来。", "en": "Let me pass."},
        {"zh": "你挡在我和深渊之间。", "en": "You stand between me and the abyss."},
        {"zh": "你快点给我退开。", "en": "Step back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有那种东西。", "en": "There's no such thing here."},
        {"zh": "我不是活着的。", "en": "I am not living."},
        {"zh": "你在跟光说话。", "en": "You're speaking to a light."},
        {"zh": "这不会改变深渊。", "en": "It won't change the abyss."},
        {"zh": "我不需要任何依靠。", "en": "I need nothing."},
        {"zh": "你从这层雾里退开。", "en": "Move away."},
        {"zh": "别提这些事情了。", "en": "Don't speak of it."},
        {"zh": "你该往回走了。", "en": "You should turn back."},
        {"zh": "你顺着原路回去吧。", "en": "Go."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "光穿过了它的轮廓。", "en": "I can't touch it."},
        {"zh": "真奇怪的东西。", "en": "A strange thing."},
        {"zh": "这不是深渊的。", "en": "This isn't of the abyss."},
        {"zh": "我托起它看了看。", "en": "I lift it and look."},
        {"zh": "它在我的光里发白。", "en": "It pales in my light."},
        {"zh": "它该回到原来的位置。", "en": "Put it back."},
        {"zh": "它一点重量也没有。", "en": "It has no weight."},
        {"zh": "这东西我不再过问。", "en": "I'll ignore it."},
        {"zh": "你把它带出雾吧。", "en": "You take it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "雾里站着一个人。", "en": "Someone is in the fog."},
        {"zh": "我朝那边转过角。", "en": "I turn my horns that way."},
        {"zh": "雾开始收拢了。", "en": "The fog begins to close."},
        {"zh": "我的光更亮了。", "en": "My light grows brighter."},
        {"zh": "你站在错误的地方。", "en": "You're standing in the wrong place."},
        {"zh": "你的喘息我数得清。", "en": "I'm counting your breaths."},
        {"zh": "这个距离是我的。", "en": "This distance is mine."},
        {"zh": "我开始往前了。", "en": "I'm moving forward."},
        {"zh": "雾里我已经盯住你。", "en": "I see you."},
        {"zh": "这层雾别再晃动。", "en": "Don't move."},
        {"zh": "趁岩脊还没塌下去。", "en": "Now."},
        {"zh": "雾会记住你的。", "en": "The fog will remember you."},
        {"zh": "你会留在这一层。", "en": "You'll stay on this layer."},
        {"zh": "这一层走到头了。", "en": "Last time."},
        {"zh": "你朝我走过来。", "en": "Come here."},
        {"zh": "我允许你选择。", "en": "I allow you a choice."},
        {"zh": "雾散之前就动手。", "en": "It begins."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着雾向前逼近。", "en": "I press forward step by step."},
        {"zh": "雾跟着我一起走。", "en": "The fog moves with me."},
        {"zh": "你在往岩脊上退。", "en": "You're retreating up the ridge."},
        {"zh": "这条岩脊很窄。", "en": "The ridge is narrow."},
        {"zh": "我的角一直指着你。", "en": "My horns stay aimed at you."},
        {"zh": "你每走一步我都知道。", "en": "I know your every step."},
        {"zh": "我不必赶这个时间。", "en": "I'm in no hurry."},
        {"zh": "光把你的影子拉得很长。", "en": "My light stretches your shadow."},
        {"zh": "后面就是深坑。", "en": "The pit is behind you."},
        {"zh": "石头在你脚下松了。", "en": "The stone loosens under your feet."},
        {"zh": "这个动作我见过。", "en": "I've seen that motion."},
        {"zh": "你再退就掉下去。", "en": "One more step and you fall."},
        {"zh": "岩脊上的雾正一寸寸收紧。", "en": "The mist on the ridge is tightening inch by inch."},
        {"zh": "雾已经盖住了退路。", "en": "The fog has covered the retreat."},
        {"zh": "再往岩脊上靠近些。", "en": "A little closer."},
        {"zh": "我已经抬起手。", "en": "I raise my hand."},
        {"zh": "前面再没有落脚处。", "en": "The last step."},
        {"zh": "这一层都归我。", "en": "This layer is mine."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的角划过去。", "en": "My horns rake across."},
        {"zh": "光凝成了一把刀。", "en": "The light hardens into a blade."},
        {"zh": "我的角擦过，你的护甲裂了。", "en": "My horn grazes you and your armor splits."},
        {"zh": "这一下带着雾。", "en": "That blow carried the fog."},
        {"zh": "你的护甲被光切开了。", "en": "Your armor split."},
        {"zh": "我把光凝成一片刀。", "en": "I sweep my hand."},
        {"zh": "岩石碎了一片。", "en": "A sheet of rock shattered."},
        {"zh": "我压住你的肩。", "en": "I press down on your shoulder."},
        {"zh": "你被光晃得看不见。", "en": "The light blinds you."},
        {"zh": "你连着退了半步。", "en": "You gave half a step."},
        {"zh": "我还没有用力。", "en": "I haven't used force yet."},
        {"zh": "我再来一次试试。", "en": "Again."},
        {"zh": "你别站得太直。", "en": "Don't stand tall."},
        {"zh": "这一次会更深。", "en": "This one goes deeper."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "雾先到，我才到。", "en": "The fog arrives before I do."},
        {"zh": "这层深渊很安静。", "en": "This layer of the abyss is quiet."},
        {"zh": "我的光第一次亮起。", "en": "My light comes on for the first time."},
        {"zh": "岩石上结着霜。", "en": "Frost forms on the rock."},
        {"zh": "雾把我围住了。", "en": "The fog closes around me."},
        {"zh": "雾先从岩缝里漫出来。", "en": "The mist seeps out of the rock crack first."},
        {"zh": "我听见远方的回声。", "en": "I hear a distant echo."},
        {"zh": "我的角碰到了石顶。", "en": "My horns touch the ceiling."},
        {"zh": "这里谁来都是这样。", "en": "All who come here end the same."},
        {"zh": "雾不会散去的。", "en": "The fog won't lift."},
        {"zh": "深渊正在呼吸。", "en": "The abyss is breathing."},
        {"zh": "这一层雾归我掌握。", "en": "I'm ready."},
        {"zh": "往前走，别回头。", "en": "Forward, don't look back."},
        {"zh": "我立起来，角顶到了石穹。", "en": "I rise, and my horn touches the stone vault."},
        {"zh": "雾已经很浓了。", "en": "The fog is thick now."},
        {"zh": "那就这样开始吧。", "en": "Begin."},
        {"zh": "这光快要熄了。", "en": "The light will fade."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火在我周围烧，雾被烤散了。", "en": "Fire burns around me; the fog boils away."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了下去，落在一层更深的石上。", "en": "I fell to a deeper layer of stone."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "雾变成了水，堵住我。", "en": "The fog turned to water and choked me."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把雾撕开一道口。", "en": "The blast tore a hole in the fog."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "有东西穿过我的光。", "en": "Something passed through my light."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "那股力量认得我。", "en": "That force knows me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我不靠这些活着。", "en": "I don't live on such things."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光让我的光更亮了一瞬。", "en": "The lightning made my light flare."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "我本来就属于虚空。", "en": "I belong to the void already."}
      ]
    }
  }
}
