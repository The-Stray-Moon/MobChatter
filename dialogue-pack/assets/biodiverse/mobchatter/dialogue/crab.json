{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我横着走过沙滩。", "en": "I cross the sand sideways."},
        {"zh": "横着穿过潮水线。", "en": "I cross the tide line sideways."},
        {"zh": "沙上留下细细的印。", "en": "Thin prints left in the sand."},
        {"zh": "我朝着水线走。", "en": "I make for the waterline."},
        {"zh": "壳在太阳下发亮。", "en": "My shell shines in the sun."},
        {"zh": "我一只钳举着。", "en": "One claw stays raised."},
        {"zh": "我慢慢挪过贝壳堆。", "en": "I edge past the shell heap."},
        {"zh": "潮水退了，路宽了。", "en": "The tide's out. The way's wider."},
        {"zh": "我从湿沙下钻出来。", "en": "I come up out of the wet sand."},
        {"zh": "我一边走一边看。", "en": "I walk and keep watch."},
        {"zh": "我的颜色和沙滩差不多。", "en": "My color matches the sand."},
        {"zh": "我绕开那块湿沙。", "en": "I step around the wet sand."},
        {"zh": "脚一沾水我就快。", "en": "In water I move faster."},
        {"zh": "八条腿敲着湿沙。", "en": "Eight legs tap the wet sand."},
        {"zh": "我的钳碰在石头上。", "en": "My claw tapped the stone."},
        {"zh": "我朝人群那边横过来。", "en": "I sidle toward the people."},
        {"zh": "我一步一斜地过去。", "en": "I go along step by side-step."},
        {"zh": "我从潮池边上绕。", "en": "I skirt the tide pool."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在沙里。", "en": "I sit in the sand."},
        {"zh": "钳子对着前面。", "en": "My claws face forward."},
        {"zh": "我在看泡泡。", "en": "I'm watching the bubbles."},
        {"zh": "潮水一直在响。", "en": "The tide never stops sounding."},
        {"zh": "我慢慢磨着钳。", "en": "I grind my claws slowly."},
        {"zh": "太阳把壳晒热了。", "en": "The sun warms my shell."},
        {"zh": "我藏在一个浅坑里。", "en": "I'm in a shallow hollow."},
        {"zh": "海风把沙吹到我身上。", "en": "Wind blows sand over me."},
        {"zh": "我横着挪到湿沙上。", "en": "I sidle onto the wet sand."},
        {"zh": "我抬了抬钳。", "en": "I lifted a claw."},
        {"zh": "我基本上不动。", "en": "I mostly stay put."},
        {"zh": "我和沙子一个颜色。", "en": "I'm the color of the sand."},
        {"zh": "我侧着身子看海。", "en": "I look at the sea sideways."},
        {"zh": "除了晒太阳没别的。", "en": "Nothing but sunning."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "这窝沙是我挖的。", "en": "I dug this sandy hollow."},
        {"zh": "我这一对钳不小。", "en": "These claws aren't small."},
        {"zh": "钳子举高，是吓唬你的。", "en": "My pincers are up only to scare you."},
        {"zh": "鱼屑的味道，藏不住。", "en": "Fish scrap has a smell you can't hide."},
        {"zh": "你退后半步。", "en": "Half a step back, please."},
        {"zh": "壳上有点沙。", "en": "There's sand on my shell."},
        {"zh": "多色的壳，晒得发烫。", "en": "My many-colored shell is hot in the sun."},
        {"zh": "往旁边挪点，我要晒。", "en": "Shift aside; I'm sunning here."},
        {"zh": "你脚边有只小的跑过去了。", "en": "A little one just ran past your foot."},
        {"zh": "我夹东西很准。", "en": "I pinch very accurately."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的壳上有一道。", "en": "A mark on my shell."},
        {"zh": "我横着退开了。", "en": "I skittered back sideways."},
        {"zh": "掉了一条腿。", "en": "One leg came off."},
        {"zh": "我只能咔咔响。", "en": "All I can do is click."},
        {"zh": "这一下打中壳边。", "en": "That hit the shell rim."},
        {"zh": "断了一条腿，还能走。", "en": "One leg lost; I can still walk."},
        {"zh": "壳边碎了一点。", "en": "A chip off the shell's edge."},
        {"zh": "八条腿还撑得住。", "en": "Eight legs still hold me."},
        {"zh": "你这一脚踩得实。", "en": "That was a heavy stomp."},
        {"zh": "我缩回洞里了。", "en": "I backed into my hole."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里那玩意儿是啥？", "en": "What is that thing you have?"},
        {"zh": "腐肉味，正合我意。", "en": "The smell of carrion suits me."},
        {"zh": "丢下来，我自己拿。", "en": "Drop it. I'll get it."},
        {"zh": "手别往我钳子这边来。", "en": "Keep your hand off my claws."},
        {"zh": "蟹钳举起来，夹一下。", "en": "My pincer rises for a pinch."},
        {"zh": "低到钳子够得着。", "en": "Low enough for my pincer to reach."},
        {"zh": "我钳子够不着。", "en": "My claws can't reach."},
        {"zh": "它带着海味吗？", "en": "Does it smell of the sea?"},
        {"zh": "你留着也行。", "en": "You can keep it too."},
        {"zh": "我不怎么挑食。", "en": "I'm not a picky eater."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我，我就横着弹开。", "en": "You bumped me. I skittered aside."},
        {"zh": "你踢到壳，脚趾疼。", "en": "You kicked my shell. Your toe hurts."},
        {"zh": "沙滩上的小蟹，腿被踩了。", "en": "A small beach crab, stepped on the leg."},
        {"zh": "我们挤在石头边上。", "en": "We're crowded by the stone."},
        {"zh": "横着走，撞上你的脚。", "en": "Walking sideways, I bump your foot."},
        {"zh": "沙粒全扬起来了。", "en": "The sand flew up."},
        {"zh": "我钳子碰到你的鞋。", "en": "My claw tapped your shoe."},
        {"zh": "你的护甲上有沙。", "en": "There's sand on your armor."},
        {"zh": "我几乎不会翻倒。", "en": "I rarely tip over."},
        {"zh": "你退开就够了。", "en": "Just stepping back is enough."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在潮池边上。", "en": "We're at the tide pool's edge."},
        {"zh": "两只钳举起来。", "en": "Both sets of claws raised."},
        {"zh": "你别蹲在旁边看。", "en": "Don't crouch there watching."},
        {"zh": "它比我壳色浅。", "en": "Its shell is paler than mine."},
        {"zh": "我们在沙上转了圈。", "en": "We circled in the sand."},
        {"zh": "浅水里，沙雾一片。", "en": "A cloud of sand in the shallows."},
        {"zh": "之后各自钻回沙里。", "en": "Afterwards we each dig back in."},
        {"zh": "沙里会留两个坑。", "en": "Two hollows left in the sand."},
        {"zh": "这个动作很快。", "en": "This doesn't take long."},
        {"zh": "钳子响了两下就没声。", "en": "The claws clicked twice, then nothing."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我钳起一块贝壳。", "en": "I pinch up a shell."},
        {"zh": "这块石头我夹得住。", "en": "I can hold this stone."},
        {"zh": "钳子夹着，转到背面。", "en": "I pinch it and turn it over."},
        {"zh": "钳子太粗，夹不住。", "en": "My claws are too thick to grip."},
        {"zh": "沙里有块硬东西。", "en": "There's something hard in the sand."},
        {"zh": "我把东西拖回洞里。", "en": "I drag it back to my hole."},
        {"zh": "你的东西掉进沙里。", "en": "Yours dropped into the sand."},
        {"zh": "这东西有点腥。", "en": "This smells fishy."},
        {"zh": "我尝了一口。", "en": "I tasted a bit."},
        {"zh": "它从我钳里滑了。", "en": "It slipped out of my claw."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走近我的坑了。", "en": "You came near my hollow."},
        {"zh": "我举着钳看你。", "en": "I'm watching you with claws up."},
        {"zh": "这一片沙是我的。", "en": "This stretch of sand is mine."},
        {"zh": "你踩坏了我的洞。", "en": "You crushed my burrow."},
        {"zh": "我横着往你那边去。", "en": "I'm sidling your way."},
        {"zh": "我夹得很疼的。", "en": "My pinch really hurts."},
        {"zh": "你退到水里就行。", "en": "Just back into the water."},
        {"zh": "潮水一涨我就更快。", "en": "When the tide comes I'm faster."},
        {"zh": "我的钳子，能当工具用。", "en": "My claw can work as a tool."},
        {"zh": "沙被踩实的声音。", "en": "The sound of sand packed underfoot."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我横着跟在你后面。", "en": "I follow sideways behind you."},
        {"zh": "你走到那块礁石边了。", "en": "You're at that reef rock."},
        {"zh": "那串脚印是你的。", "en": "That line of prints is yours."},
        {"zh": "我贴地过来。", "en": "I'm coming low."},
        {"zh": "你朝礁石那边去了。", "en": "You headed for the reef rock."},
        {"zh": "潮水快到了。", "en": "The tide is nearly in."},
        {"zh": "我钳子一直举着。", "en": "My claws stay raised."},
        {"zh": "你退到干沙上就慢了。", "en": "Dry sand slows you."},
        {"zh": "我从你的影子里出来。", "en": "I came out of your shadow."},
        {"zh": "你在看海，我在看你。", "en": "You watch the sea. I watch you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸钳夹住你的鞋。", "en": "I clamp a claw on your shoe."},
        {"zh": "这钳能夹断指头。", "en": "These claws could take a finger."},
        {"zh": "你被夹住了。", "en": "You got pinched."},
        {"zh": "钳子没收，先撞一下。", "en": "Claws kept — just a bump first."},
        {"zh": "八条腿一起蹬。", "en": "All eight legs shove."},
        {"zh": "你退到水里。", "en": "You're in the water now."},
        {"zh": "这一夹不狠。", "en": "That pinch was not fierce."},
        {"zh": "我的壳磕在你脚上。", "en": "My shell hit your foot."},
        {"zh": "沙上留了你的脚印。", "en": "Your prints stay in the sand."},
        {"zh": "我把钳松开了。", "en": "I opened my claw."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "沙粒从壳缝里往下掉。", "en": "Grains fall from the gaps in my shell."},
        {"zh": "我的钳子能当工具用。", "en": "My claw can be used as a tool."},
        {"zh": "湿沙从背甲滑下去。", "en": "Wet sand slides off my back plate."},
        {"zh": "沙滩上有一只。", "en": "One more on the beach."},
        {"zh": "我看着水线。", "en": "I watch the waterline."},
        {"zh": "我钳子先露出来。", "en": "My claws came out first."},
        {"zh": "这一片贝壳很多。", "en": "There are plenty of shells here."},
        {"zh": "阳光刚刚好。", "en": "The sunlight is just right."},
        {"zh": "我慢慢横着出去。", "en": "I sidle out slowly."},
        {"zh": "这块石头下面很凉。", "en": "It's cool under this stone."}
      ]
    },
