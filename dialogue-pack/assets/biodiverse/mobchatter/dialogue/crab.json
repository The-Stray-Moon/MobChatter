      "operation": "replace",
      "lines": [
        {"zh": "箭钉进壳里，拔不动。", "en": "The arrow lodged in my shell."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光让我的腿都软了。", "en": "That light made my legs weak."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "沙里没什么吃的。", "en": "There's little to eat in the sand."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "钳子张着，合不上了。", "en": "My pincers stay open, unable to close."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有沙可以钻。", "en": "No sand to burrow in the void."}
      ]
    }
  }
