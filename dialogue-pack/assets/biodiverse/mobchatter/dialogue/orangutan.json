{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我用长臂荡过树枝。", "en": "I swing through the branches on long arms."},
        {"zh": "我的脚掌抓住树干。", "en": "My feet grip the trunk."},
        {"zh": "我慢慢往下爬。", "en": "I climb down slowly."},
        {"zh": "我一只手臂先试。", "en": "I test with one arm first."},
        {"zh": "我从这棵树到那棵树。", "en": "I go from this tree to that one."},
        {"zh": "我的毛发很长。", "en": "My hair is long."},
        {"zh": "我在地上用手掌撑。", "en": "On the ground I prop on my palms."},
        {"zh": "我把原木当成路。", "en": "I use the logs as roads."},
        {"zh": "我停下来看看下面。", "en": "I stop and look below."},
        {"zh": "长手指扣着树干往前挪。", "en": "My long fingers grip the trunk as I move."},
        {"zh": "我摇晃着走过去。", "en": "I swing along."},
        {"zh": "我抓住藤蔓。", "en": "I catch a vine."},
        {"zh": "我用手臂量了量距离。", "en": "I measure the gap with an arm."},
        {"zh": "我在原木上慢慢移动。", "en": "I move slowly along the log."},
        {"zh": "我的手掌撑在地上。", "en": "My palm presses the ground."},
        {"zh": "我从一棵树荡到另一棵。", "en": "I swing from one tree to the next."},
        {"zh": "我停在半空看下面。", "en": "I pause mid-swing to look down."},
        {"zh": "我把藤往旁边拨开。", "en": "I push the vine aside."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在树杈上。", "en": "I hang in a fork of the tree."},
        {"zh": "我两条长臂垂到膝下。", "en": "My long arms hang to my knees."},
        {"zh": "我在看下面的路。", "en": "I watch the path below."},
        {"zh": "我的毛发挂在树枝上。", "en": "My hair catches on branches."},
        {"zh": "我打了打哈欠。", "en": "I yawn."},
        {"zh": "我用手掌托着下巴。", "en": "I rest my chin on my hand."},
        {"zh": "我在树上待着，不动。", "en": "I stay in the tree, still."},
        {"zh": "我的脚趾抓得很紧。", "en": "My toes grip tight."},
        {"zh": "我在听藤蔓摇晃的声音。", "en": "I listen to the vines swaying."},
        {"zh": "我晃了晃脚。", "en": "I swing my feet."},
        {"zh": "脑袋慢慢偏了过去。", "en": "My head tilts slowly aside."},
        {"zh": "我把手指插进树缝。", "en": "I fit my fingers into a tree crevice."},
        {"zh": "我在叶子里找果子。", "en": "I search the leaves for fruit."},
        {"zh": "我把脚悬着。", "en": "I dangle my feet."},
        {"zh": "我的毛发遮住半张脸。", "en": "My hair covers half my face."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在树干下面。", "en": "You're at the base of the trunk."},
        {"zh": "我从枝上垂下头看你。", "en": "I hang my head down at you."},
        {"zh": "你能爬上来吗？", "en": "Can you climb up?"},
        {"zh": "这棵树是我的路。", "en": "This tree is my road."},
        {"zh": "你别摇树干。", "en": "Don't shake the trunk."},
        {"zh": "我伸手下来。", "en": "I lower a hand."},
        {"zh": "你站的地方很窄。", "en": "The ground you stand on is narrow."},
        {"zh": "我慢慢往下走。", "en": "I come down slowly."},
        {"zh": "你别挡在原木上。", "en": "Don't block the log."},
        {"zh": "我抓着藤吊在半空。", "en": "I hang from the vine."},
        {"zh": "我抓着枝停住了。", "en": "I catch a branch and stop."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手臂被抓了一下。", "en": "My arm was raked."},
        {"zh": "我发出一声长叫。", "en": "I give a long call."},
        {"zh": "我抓住树枝稳住。", "en": "I steady on a branch."},
        {"zh": "手臂伤了，还能爬。", "en": "Arm hurt; I can still climb."},
        {"zh": "我贴住树干。", "en": "I press to the trunk."},
        {"zh": "我从叶子里盯着你。", "en": "I watch you through the leaves."},
        {"zh": "我抓住了藤。", "en": "I caught hold of a vine."},
        {"zh": "长臂无力地垂下来。", "en": "My long arms hang at my sides."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是果子吗？", "en": "Is that fruit?"},
        {"zh": "我顺着树干下来拿。", "en": "I'll come down the trunk for it."},
        {"zh": "你手别动，我够到了。", "en": "Keep your hand still; I have it."},
        {"zh": "我的长臂够得到。", "en": "My long arm can reach it."},
        {"zh": "这个不太熟。", "en": "This isn't quite ripe."},
        {"zh": "你放在原木上。", "en": "Put it on the log."},
        {"zh": "我伸手试了试。", "en": "I reach out to test."},
        {"zh": "你手里还有果子吗。", "en": "Any more fruit in your hand?"},
        {"zh": "我在树上等你。", "en": "I wait up in the tree."},
        {"zh": "你手上那个有点黄。", "en": "The thing in your hand is rather yellow."},
        {"zh": "我伸长了手臂。", "en": "I stretch my arm out long."},
        {"zh": "我把脸凑过去。", "en": "I lean my face in."},
        {"zh": "你高举一点。", "en": "Hold it up higher."},
        {"zh": "这个气味很甜。", "en": "This smells sweet."},
        {"zh": "我慢慢抓着树枝下来。", "en": "I climb down slowly, hand over hand."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到树干，我晃了。", "en": "You hit the trunk and I swayed."},
        {"zh": "我抓住树枝。", "en": "I grab a branch."},
        {"zh": "我很重，落下来会响。", "en": "I am heavy; I'd land loud."},
        {"zh": "我的手掌拍到你的肩。", "en": "My palm pats your shoulder."},
        {"zh": "别推树干，我会掉。", "en": "Don't push the trunk; I'd fall."},
        {"zh": "我换到另一根枝上。", "en": "I move to another branch."},
        {"zh": "我们撞在一起，叶子掉了。", "en": "We collide and leaves fall."},
        {"zh": "你踩到我的手指了。", "en": "You stepped on my fingers."},
        {"zh": "我绕到树干背面。", "en": "I slip behind the trunk."},
        {"zh": "我抓住两根枝稳住。", "en": "I steady on two branches."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我在树上，你在下面。", "en": "I'm in the tree; you're below."},
        {"zh": "这个距离太远了。", "en": "That distance is too far."},
        {"zh": "我这一族很安静。", "en": "My kind is quiet."},
        {"zh": "你爬上来再说。", "en": "Climb up and then talk."},
        {"zh": "我抓着树枝。", "en": "I hold the branch."},
        {"zh": "我慢慢往下。", "en": "I come down slowly."},
        {"zh": "我坐在这儿就好。", "en": "Sitting here is enough."},
        {"zh": "我扯了扯藤。", "en": "I tugged the vine."},
        {"zh": "我抓住藤转身了。", "en": "I swing round on the vine."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我伸手抓住。", "en": "I reach and grab it."},
        {"zh": "这个我能拿。", "en": "I can carry this."},
        {"zh": "我掰开果子塞进嘴里。", "en": "I split the fruit and stuff it in my mouth."},
        {"zh": "这个咬不动，不是果子。", "en": "Not fruit. Too hard to bite."},
        {"zh": "我把它挂在枝上。", "en": "I hang it on a branch."},
        {"zh": "我抱着它爬。", "en": "I climb carrying it."},
        {"zh": "它从我指间滑下去了。", "en": "It slipped from between my fingers."},
        {"zh": "太沉了，我拎不动。", "en": "Too heavy for me to lift."},
        {"zh": "我随手把它抛还给你。", "en": "I toss it casually back to you."},
        {"zh": "树上的果子够了。", "en": "The fruit up here is enough."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你摇了我这棵树。", "en": "You shook my tree."},
        {"zh": "我抓住枝停下了。", "en": "I caught a branch and stopped."},
        {"zh": "我的手臂撑在枝上。", "en": "My arms brace on the branch."},
        {"zh": "你退到原木那边了。", "en": "You've backed to the log."},
        {"zh": "我顺着藤往下爬。", "en": "I climb down the vine."},
        {"zh": "你听见树叶响吗。", "en": "Do you hear the leaves?"},
        {"zh": "我数到三就跳下来。", "en": "At three I drop."},
        {"zh": "我的长臂够到你了。", "en": "My long arm reaches you."},
        {"zh": "我抓住一根粗枝。", "en": "I grab a thick branch."},
        {"zh": "我慢慢往下移动。", "en": "I move slowly downward."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你走得再快也在下面。", "en": "However fast you go, you're below."},
        {"zh": "我换了一根枝。", "en": "I moved to another branch."},
        {"zh": "你抬头，我在你正上方。", "en": "Look up — I'm right above."},
        {"zh": "我就在你上面。", "en": "I am right above you."},
        {"zh": "树叶被我摇下来。", "en": "I shake leaves down on you."},
        {"zh": "你再退就到原木尽头。", "en": "Retreat more and the log ends."},
        {"zh": "我换了个更高的枝。", "en": "I move to a higher branch."},
        {"zh": "叶子落了你一头。", "en": "Leaves fall all over your head."},
        {"zh": "我挂在树杈上往下看你。", "en": "I hang from a branch and look down at you."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用手臂扫过去。", "en": "I sweep with an arm."},
        {"zh": "我的大手掌拍在你背上。", "en": "My broad palm hits your back."},
        {"zh": "这一掌压得你弯腰。", "en": "That palm bends you double."},
        {"zh": "长臂一伸，我抓住你肩。", "en": "One long arm out, I grab your shoulder."},
        {"zh": "我从枝上落到原木上。", "en": "I drop from the branch onto the log."},
        {"zh": "你被撞到树干上。", "en": "You're slammed into the trunk."},
        {"zh": "你退到原木后面了。", "en": "You've retreated behind the log."},
        {"zh": "我回到树上。", "en": "I return to the tree."},
        {"zh": "我从枝上松了手。", "en": "I let go of the branch."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "这里是丛林。", "en": "This is jungle."},
        {"zh": "这些原木粗得能走人。", "en": "These logs are wide enough to walk."},
        {"zh": "我的毛发上挂着叶子。", "en": "Leaves cling to my hair."},
        {"zh": "我抓住一根藤。", "en": "I grab a vine."},
        {"zh": "林子里的声音很近。", "en": "The forest sounds are close."},
        {"zh": "我坐在地上。", "en": "I sit on the ground."},
        {"zh": "我把手臂撑起来。", "en": "I prop myself up."},
        {"zh": "我开始往上爬。", "en": "I start climbing."},
        {"zh": "我把手掌按在土里。", "en": "I press my palm into the soil."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火燎到我的毛发，我往高处爬。", "en": "Fire catches my hair; I climb higher."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从树上掉下来，摔在根上。", "en": "I fell from the tree onto a root."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水漫过我的头，我抓不到东西。", "en": "Water covers my head; I grab nothing."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我从枝上掀下来。", "en": "The blast knocks me off the branch."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭缠进我的毛发里。", "en": "An arrow tangles in my hair."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "紫色的光让我看不清树枝。", "en": "Violet light blurs the branches."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "林子里果子少了。", "en": "There is little fruit in the forest."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光里我一下抱住树干。", "en": "In the flash I clutched the trunk."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "树枝没了，我一直在掉。", "en": "The branch is gone and I fall."}
      ]
    }
  }
}
