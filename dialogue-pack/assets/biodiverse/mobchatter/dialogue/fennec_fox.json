{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩着沙走过去。", "en": "I trot across the sand."},
        {"zh": "大耳朵在风里转。", "en": "My big ears swivel in the wind."},
        {"zh": "步子轻得像没落地。", "en": "My steps barely touch the ground."},
        {"zh": "我朝那片灌木去。", "en": "I head for that scrub."},
        {"zh": "尾巴扫着沙。", "en": "My tail sweeps the sand."},
        {"zh": "沙太软，我走得浅。", "en": "The sand's soft. I keep it light."},
        {"zh": "小爪子踩过石缝。", "en": "Little paws pick through the stone gaps."},
        {"zh": "我走得很快，很小。", "en": "Quick little steps."},
        {"zh": "太阳底下我很亮。", "en": "I'm bright in the sun."},
        {"zh": "我在低处走。", "en": "I keep low."},
        {"zh": "我朝阴影那边去。", "en": "I make for the shade."},
        {"zh": "在沙丘顶停下来。", "en": "I stop on the crest of the dune."},
        {"zh": "我从沙丘后面过来。", "en": "I come around the dune."},
        {"zh": "脚踩下去只留一点印。", "en": "My prints are barely there."},
        {"zh": "沙丘上，耳朵先转。", "en": "On the dune, my ears turn first."},
        {"zh": "我慢慢走近了一点。", "en": "I've come a little nearer."},
        {"zh": "我身上的毛很浅。", "en": "My fur is pale."},
        {"zh": "我沿着沙脊走。", "en": "I follow the dune's ridge."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲在沙上。", "en": "I crouch in the sand."},
        {"zh": "耳朵一直在动。", "en": "My ears never stop moving."},
        {"zh": "虫子在沙里挪窝。", "en": "Bugs are shifting in the sand."},
        {"zh": "我的尾巴搭在脚边。", "en": "My tail rests by my feet."},
        {"zh": "这里热得发烫。", "en": "It is scorching here."},
        {"zh": "风沙里，眯成一条缝。", "en": "In the blowing sand, my eyes narrow to slits."},
        {"zh": "我慢慢转了转耳朵。", "en": "I turned my ears slowly."},
        {"zh": "刮过一阵小风。", "en": "A small breeze came through."},
        {"zh": "耳朵转向声音那边。", "en": "My ears turn toward the sound."},
        {"zh": "没什么事要做。", "en": "Nothing to do."},
        {"zh": "我的影子只有一小块。", "en": "My shadow is one small patch."},
        {"zh": "沙上有虫在爬。", "en": "Insects crawl on the sand."},
        {"zh": "沙上我坐着，耳朵在转。", "en": "I sit on the sand, ears turning."},
        {"zh": "鼻子埋进沙里，嗅。", "en": "My nose goes into the sand to sniff."},
        {"zh": "我抬起鼻子闻风。", "en": "I lift my nose to the wind."},
        {"zh": "我把身子蜷起来。", "en": "I curl myself up."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你的耳朵没我的大。", "en": "Your ears aren't as big as mine."},
        {"zh": "你为什么看着我。", "en": "Why are you watching me?"},
        {"zh": "我在沙里住着。", "en": "I live in the sand."},
        {"zh": "你手放下来好吗。", "en": "Would you lower your hands?"},
        {"zh": "我跑得比你快。", "en": "I'm faster than you."},
        {"zh": "这里晚上会冷。", "en": "It gets cold here at night."},
        {"zh": "只是看看你有没有吃的。", "en": "Just checking whether you have food."},
        {"zh": "我的耳朵，比脸还大。", "en": "My ears are bigger than my face."},
        {"zh": "我这么小，不碍事。", "en": "I'm small. I'm no trouble."},
        {"zh": "你要不要坐下来。", "en": "Why don't you sit down."},
        {"zh": "我的毛很软。", "en": "My fur is very soft."},
        {"zh": "我耳朵能听见很远。", "en": "My ears hear a long way."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我跳到一边去了。", "en": "I sprang aside."},
        {"zh": "我的耳朵压下来。", "en": "My ears flattened."},
        {"zh": "腿上有一道。", "en": "A cut on my leg."},
        {"zh": "叫声细得像风。", "en": "My cry is thin as the wind."},
        {"zh": "沙色的毛，沾了血。", "en": "Sand-colored fur, stained with blood."},
        {"zh": "我的大耳朵，在沙里听风。", "en": "My big ears hear the wind in the sand."},
        {"zh": "这点伤，够要命了。", "en": "A wound this size can kill."},
        {"zh": "我退到沙坑里。", "en": "I retreated into a hollow."},
        {"zh": "我跑不动了。", "en": "I can't run far now."},
        {"zh": "我缩进洞里不敢出。", "en": "I shrink into my burrow and stay."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你手里拿的啥？", "en": "What are you holding?"},
        {"zh": "闻起来甜的。", "en": "It smells sweet."},
        {"zh": "低到沙面，我才过去。", "en": "Down to the sand, then I'll come."},
        {"zh": "这个给我尝一口？", "en": "May I try a bite?"},
        {"zh": "别动，我过来。", "en": "Hold still. I'll come."},
        {"zh": "手别伸到我这边。", "en": "Do not reach toward me."},
        {"zh": "我这对大耳朵，听得见沙子动。", "en": "These big ears hear the sand move."},
        {"zh": "一步，两步，停一下。", "en": "One step, two, then a pause."},
        {"zh": "你留着也无所谓。", "en": "You can keep it if you like."},
        {"zh": "我胆子不大。", "en": "I'm not very brave."},
        {"zh": "再等一下，我还没走近。", "en": "Wait a bit more. I haven't come close."},
        {"zh": "你得蹲下来。", "en": "You'll have to crouch down."},
        {"zh": "这东西在手里很暖。", "en": "That's warm in your hand."},
        {"zh": "我闻出有盐味。", "en": "I smell salt on it."},
        {"zh": "我的耳朵比脸大两倍。", "en": "My ears are twice the size of my face."},
        {"zh": "我吃完就跑。", "en": "I'll run off after eating."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰我，我跳开了。", "en": "You touched me. I jumped back."},
        {"zh": "我轻得能被撞飞。", "en": "I am light enough to be knocked flying."},
        {"zh": "我从靴边弹开。", "en": "I spring away from your boot."},
        {"zh": "尾巴擦过你的靴子。", "en": "My tail brushes against your boot."},
        {"zh": "沙子扑了我们一身。", "en": "Sand sprayed over us both."},
        {"zh": "我耳朵碰到你了。", "en": "My ear brushed you."},
        {"zh": "我们没撞实。", "en": "We didn't really collide."},
        {"zh": "你的靴子很大。", "en": "Your boots are large."},
        {"zh": "我绕着沙丘走了半圈。", "en": "I walked half a circle round the dune."},
        {"zh": "你往后退吧。", "en": "Please back away."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们在沙丘后面。", "en": "We're behind the dune."},
        {"zh": "两只耳朵都竖着。", "en": "Both pairs of ears upright."},
        {"zh": "你别站在这边。", "en": "Don't stand on this side."},
        {"zh": "它比我深一点颜色。", "en": "It's a shade darker than me."},
        {"zh": "我们在沙上转圈。", "en": "We circled in the sand."},
        {"zh": "我们的大耳朵碰在一起。", "en": "Our big ears touch."},
        {"zh": "之后各自去觅食。", "en": "Afterwards we go hunting separately."},
        {"zh": "洞里会多几只。", "en": "There'll be a few more in the den."},
        {"zh": "这动作很快。", "en": "It doesn't take long."},
        {"zh": "一路都没叫。", "en": "Not a sound the whole time."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这一小口，够藏了。", "en": "This small bite is enough to stash."},
        {"zh": "大耳朵动了动，按住。", "en": "My big ears twitch as I pin it down."},
        {"zh": "干骨头，啃着费劲。", "en": "A dry bone is hard chewing."},
        {"zh": "爪子刨两下，盖住。", "en": "Two scoops of my paws and it's covered."},
        {"zh": "地上有果子。", "en": "There's fruit on the ground."},
        {"zh": "叼进沙洞，藏好。", "en": "Carried into my sand burrow and hidden."},
        {"zh": "你掉的在沙坑里。", "en": "Yours is in the sand hollow."},
        {"zh": "我舔了一下它。", "en": "I gave it a lick."},
        {"zh": "甲虫壳太滑，跑了。", "en": "The beetle shell was too slick; it got away."},
        {"zh": "它滚进沙里了。", "en": "It rolled into the sand."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你走进我的沙地了。", "en": "You've come onto my sand."},
        {"zh": "你在沙上走得很响。", "en": "You walk loudly on the sand."},
        {"zh": "我耳朵全竖起来了。", "en": "My ears are fully up."},
        {"zh": "我朝你那边看。", "en": "I'm looking your way."},
        {"zh": "只有沙和一只耳朵。", "en": "Only sand and one ear."},
        {"zh": "沙下的虫都听见了。", "en": "Even the bugs beneath the sand heard that."},
        {"zh": "我要么跑，要么躲。", "en": "I'll either run or hide."},
        {"zh": "你站的位置很开阔。", "en": "You're standing in the open."},
        {"zh": "我的洞就在那边。", "en": "My den is over there."},
        {"zh": "你一让，我就溜过去。", "en": "Once you move aside, I slip past."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我用眼角盯着你。", "en": "I watch you from the corner of my eye."},
        {"zh": "你走过两座沙丘了。", "en": "You've crossed two dunes."},
        {"zh": "我贴着沙脊跟。", "en": "I follow along the ridge."},
        {"zh": "你的印子在沙上很深。", "en": "Your prints sink deep."},
        {"zh": "隔着十步，我盯着。", "en": "Ten paces back, I keep watching."},
        {"zh": "你朝沙脊那边走了。", "en": "You went toward the ridge."},
        {"zh": "风把我的味道吹走了。", "en": "The wind carries my scent away."},
        {"zh": "隔着沙子，也听得见。", "en": "I hear it even through the sand."},
        {"zh": "你停下我就不动了。", "en": "You stop, I stop."},
        {"zh": "再等一会儿我就走。", "en": "A moment more and I'll go."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我咬了一下就退。", "en": "I bit and pulled back."},
        {"zh": "小牙咬住你的裤脚。", "en": "Small teeth catch your trouser leg."},
        {"zh": "我抓了一道。", "en": "I left a scratch."},
        {"zh": "你根本没当回事。", "en": "You barely noticed."},
        {"zh": "我跳起来扑了一下。", "en": "I leapt and swiped."},
        {"zh": "我自己先跑了。", "en": "I ran off first."},
        {"zh": "沙上留了爪印。", "en": "Claw marks in the sand."},
        {"zh": "我有点怕你。", "en": "You frighten me a little."},
        {"zh": "这一下是没别的办法。", "en": "I had no other choice."},
        {"zh": "我藏进石头的阴影。", "en": "I duck into the stone's shade."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙丘后面出来。", "en": "I come out from behind the dune."},
        {"zh": "耳朵先动了动。", "en": "My ears twitched first."},
        {"zh": "这片沙地上没有别人。", "en": "Nobody else on this sand."},
        {"zh": "沙洞口的耳朵先竖。", "en": "Ears rise first at the burrow mouth."},
        {"zh": "太阳已经偏了。", "en": "The sun has moved over."},
        {"zh": "沙洞里先露出耳朵。", "en": "Ears come out of the burrow first."},
        {"zh": "闻了闻空气，有沙味。", "en": "Sniffed the air. Sand smell."},
        {"zh": "这一片很熟悉。", "en": "This stretch is familiar."},
        {"zh": "我慢慢走到沙脊上。", "en": "I walked up to the ridge."},
        {"zh": "风里带了个新味道。", "en": "A new smell on the wind."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一燎，我的毛就缩了。", "en": "Fire singed my fur tight."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
