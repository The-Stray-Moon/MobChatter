      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光晃得我头晕。", "en": "That light left me dizzy."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "沙里吃的不多。", "en": "There's little to eat in the sand."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打下来，我伏在沙里。", "en": "Lightning struck and I flattened into the sand."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有沙，也没有洞。", "en": "No sand, no den in the void."}
      ]
    }
  }
