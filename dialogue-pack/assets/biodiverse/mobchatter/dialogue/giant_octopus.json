{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着海底滑过去。", "en": "I glide along the sea floor."},
        {"zh": "八条腕一起推水。", "en": "Eight arms push the water."},
        {"zh": "我慢慢地挪动。", "en": "I move slowly."},
        {"zh": "八条腕一收一放，往前推。", "en": "Eight arms draw in and out, pushing me forward."},
        {"zh": "沙在我下面散开。", "en": "The sand parts under me."},
        {"zh": "我朝那块礁石去。", "en": "I make for that reef."},
        {"zh": "我的腕在水里拖。", "en": "My arms trail in the water."},
        {"zh": "水把我推得很轻。", "en": "The water carries me lightly."},
        {"zh": "我绕过一片海草。", "en": "I go around a patch of weed."},
        {"zh": "皮肤从灰变成斑驳。", "en": "My skin shifts from gray to mottled."},
        {"zh": "我一次只挪一点。", "en": "I shift a little at a time."},
        {"zh": "我把身子挤过石缝。", "en": "I squeeze my body through the crevice."},
        {"zh": "我的动作看不出快慢。", "en": "It's hard to tell if I'm fast."},
        {"zh": "我沿着岩壁往上走。", "en": "I climb along the rock face."},
        {"zh": "我慢慢地贴地过去。", "en": "I creep over the ground."},
        {"zh": "腕在我身后拖着。", "en": "My arms drag behind."},
        {"zh": "我在暗处更自在。", "en": "I'm easier in the dark."},
        {"zh": "我朝更深的地方去了。", "en": "I've gone deeper."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我伏在两块石头之间。", "en": "I rest between two stones."},
        {"zh": "腕卷在身下。", "en": "My arms curl beneath me."},
        {"zh": "颜色慢慢淡下去。", "en": "The color fades out."},
        {"zh": "藏在石缝里，只露眼。", "en": "Hidden in the rock crevice, only my eye shows."},
        {"zh": "水从我身边流过。", "en": "Water passes over me."},
        {"zh": "八条腕贴在礁石上，睁着眼。", "en": "Eight arms on the rock, eyes open."},
        {"zh": "我在感觉震动。", "en": "I'm sensing vibrations."},
        {"zh": "这里暗得看不见底。", "en": "It is too dark to see the bottom."},
        {"zh": "我动了动一条腕。", "en": "I moved one arm."},
        {"zh": "我在这里等着就好。", "en": "Waiting here is enough."},
        {"zh": "我身上有点斑。", "en": "There are spots on me."},
        {"zh": "我慢慢把腕摊开。", "en": "I spread my arms slowly."},
        {"zh": "八条腕摊开，我在等东西。", "en": "Eight arms spread, I wait for something."},
        {"zh": "水底的泥很细。", "en": "The silt is fine here."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你在水里很显眼。", "en": "You stand out underwater."},
        {"zh": "你的形状我看过了。", "en": "I've taken in your shape."},
        {"zh": "我有很多条腕。", "en": "I have a lot of arms."},
        {"zh": "你游得不算快。", "en": "You don't swim very fast."},
        {"zh": "我在水底很自在。", "en": "I'm at home on the bottom."},
        {"zh": "你的血散在水里。", "en": "Your blood is spreading in the water."},
        {"zh": "你最好不要下来。", "en": "You'd best not come down."},
        {"zh": "我可以贴在石头上。", "en": "I can cling flat to stone."},
        {"zh": "你手上那个亮东西。", "en": "That bright thing in your hand."},
        {"zh": "我认得这片海底。", "en": "I know this sea floor."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腕断了一截。", "en": "A piece of arm came off."},
        {"zh": "我的颜色一下子变白。", "en": "My color went white."},
        {"zh": "触手一根根收回去。", "en": "My tentacles retract one by one."},
        {"zh": "水里都是黑的。", "en": "The water's gone black."},
        {"zh": "我动得很慢了。", "en": "I've slowed a lot."},
        {"zh": "我在水里发不出声。", "en": "I make no sound underwater."},
        {"zh": "断了一截腕，还在动。", "en": "A piece of arm came off, still moving."},
        {"zh": "我八条腕足，缠住整块礁。", "en": "Eight arms wrap the whole reef."},
        {"zh": "我把腕收起来了。", "en": "I pulled the arms in."},
        {"zh": "你的力气在水里很大。", "en": "You're strong in water."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "贝壳太小，没肉。", "en": "The shell is too small; there's no meat."},
        {"zh": "你手里太亮了。", "en": "That's too bright in your hand."},
        {"zh": "它太远了，我够不到。", "en": "It is too far; I cannot reach."},
        {"zh": "我的腕足先碰了碰它。", "en": "My tentacle tests it first."},
        {"zh": "你举着那东西干嘛？", "en": "Why hold that up?"},
        {"zh": "这味道在水里散开。", "en": "The smell spreads in the water."},
        {"zh": "这些我不吃，你留着。", "en": "I do not eat these — keep them."},
        {"zh": "我不太感兴趣。", "en": "I'm not very interested."},
        {"zh": "你再靠近一点看看。", "en": "Come closer and see."},
        {"zh": "塞牙缝都不够。", "en": "Not enough to fill a gap in my teeth."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你碰到我的腕了。", "en": "You touched one of my arms."},
        {"zh": "我八条腕一起推水，贴着海底滑。", "en": "Eight arms push the water; I slide along the seabed."},
        {"zh": "我的腕立刻卷起来。", "en": "My arm curled at once."},
        {"zh": "水里本来就不容易撞。", "en": "Collisions are slow in water."},
        {"zh": "你退了，这样很好。", "en": "You backed off. Good."},
        {"zh": "我身上有吸盘。", "en": "I have suckers."},
        {"zh": "水被搅得有点浑。", "en": "The water clouded a little."},
        {"zh": "我在你身后浮着。", "en": "I float behind you."},
        {"zh": "你的手滑了过去。", "en": "Your hand slipped past."},
        {"zh": "吸盘只是贴了一下。", "en": "The suckers only brushed you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们靠颜色交流。", "en": "We talk in color."},
        {"zh": "两条腕缠了一下。", "en": "Two arms twined once."},
        {"zh": "你别站在下面。", "en": "Don't stand below us."},
        {"zh": "它的斑比我的密。", "en": "Its spots are denser than mine."},
        {"zh": "我们慢慢叠在一起。", "en": "We slowly overlapped."},
        {"zh": "沙子被我们搅起来。", "en": "We stirred up the sand."},
        {"zh": "八条腕，各走各的。", "en": "Eight arms, each going its own way."},
        {"zh": "水里会飘着卵。", "en": "Eggs will drift in the water."},
        {"zh": "这事慢得看不出在动。", "en": "So slow you cannot see it happen."},
        {"zh": "水里一点动静都没有。", "en": "Not a stir in the water."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我用一条腕卷住它。", "en": "I take it with one arm."},
        {"zh": "这东西咬不开。", "en": "I cannot bite through this."},
        {"zh": "它在我手里转了一下。", "en": "It turned once in my grip."},
        {"zh": "我用吸盘吸住。", "en": "I grip it with suckers."},
        {"zh": "这东西太滑了。", "en": "This is too slippery."},
        {"zh": "我把它拖回石头下。", "en": "I drag it under the stone."},
        {"zh": "你掉的东西沉下来了。", "en": "What you dropped sank."},
        {"zh": "我翻过来看了看。", "en": "I turned it over to look."},
        {"zh": "拿在触手里转一圈。", "en": "I turn it once in my tentacle."},
        {"zh": "我把它松开。", "en": "I let it go."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你游到我的水层了。", "en": "You swam into my layer."},
        {"zh": "我感觉到了你的动作。", "en": "I felt you move."},
        {"zh": "海底这片是我的。", "en": "This part of the floor is mine."},
        {"zh": "我慢慢展开腕。", "en": "I'm spreading my arms."},
        {"zh": "你在水里躲不开。", "en": "You can't hide in water."},
        {"zh": "等你靠近，我再动手。", "en": "I'll move once you come closer."},
        {"zh": "我的颜色深下去了。", "en": "My color has deepened."},
        {"zh": "你离礁石很远。", "en": "You're far from the reef."},
        {"zh": "水把声音传给我。", "en": "The water carries the sound to me."},
        {"zh": "我八条腕在水里，各管一边。", "en": "Eight arms, one for each side of the water."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直贴着海底跟。", "en": "I keep to the floor and follow."},
        {"zh": "你在那块礁石上面。", "en": "You're above that reef."},
        {"zh": "我和石头一个颜色。", "en": "I am the color of the stone."},
        {"zh": "我动得很慢，你察觉不到。", "en": "I move slowly. You won't notice."},
        {"zh": "八条腕，从礁石间伸出来。", "en": "Eight arms reach from the reef."},
        {"zh": "你往上游了一格。", "en": "You drifted up a block."},
        {"zh": "我的一条腕在那边。", "en": "One of my arms is over there."},
        {"zh": "你身后的水流变了。", "en": "The current behind you changed."},
        {"zh": "离你只剩几格水。", "en": "A few blocks of water between us."},
        {"zh": "你往深处游了。", "en": "You swam deeper."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "一条腕抽了过去。", "en": "One arm lashed out."},
        {"zh": "吸盘贴在你护甲上。", "en": "Suckers clamped onto your armor."},
        {"zh": "我往下拖了一点。", "en": "I pulled you down a little."},
        {"zh": "你被缠住了。", "en": "You're wrapped up."},
        {"zh": "水里使不上力。", "en": "Force is hard to apply in water."},
        {"zh": "你从我这里挣开了。", "en": "You tore free of me."},
        {"zh": "我把腕收回来了。", "en": "I drew the arm back."},
        {"zh": "触手缠上你的脚踝。", "en": "A tentacle coils around your ankle."},
        {"zh": "这一下不算狠，我的触手还没全伸开。", "en": "That was not harsh; my arms are not all spread."},
        {"zh": "水被搅得很浑。", "en": "The water's churned opaque."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从礁石下浮出来。", "en": "I rise from under the reef."},
        {"zh": "颜色从暗变浅。", "en": "My color goes from dark to pale."},
        {"zh": "沙被推开一圈。", "en": "The sand pushed aside in a ring."},
        {"zh": "这一片海底很安静。", "en": "This sea floor is quiet."},
        {"zh": "我的腕慢慢展开。", "en": "My arms unfold slowly."},
        {"zh": "我贴着石头看着。", "en": "I watch from against the stone."},
        {"zh": "海水凉得刺骨。", "en": "The seawater is biting cold."},
        {"zh": "我把身子定在底部。", "en": "I settled on the bottom."},
        {"zh": "这里有一片海草。", "en": "There's a patch of weed here."},
        {"zh": "我闻到有东西在动。", "en": "I smell something moving."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "水里的火没烧起来，但很烫。", "en": "Fire won't catch here, but it burned hot."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我落下去，摊在沙上。", "en": "I dropped and splayed on the sand."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "鳃在水里，喘得稳。", "en": "My gills breathe steadily in the water."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆开的水把我推出去很远。", "en": "The blast pushed me a long way."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "弩箭扎进我的身子里。", "en": "The bolt sank into my body."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "这股光让我的颜色乱了。", "en": "That light scrambled my color."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "海底吃的东西不多。", "en": "There's not much to eat down here."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷顺着水打来，我全身抽紧。", "en": "Lightning came through the water and I clenched."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里没有水让我游。", "en": "No water to swim through in the void."}
      ]
    }
  }
}
