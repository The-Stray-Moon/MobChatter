{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "白色的翅膀，在暗里很亮。", "en": "White wings, bright in the dark."},
        {"zh": "我贴着树干飞。", "en": "I fly close along the trunks."},
        {"zh": "我的翅粉落了一路。", "en": "Dust from my wings trails behind."},
        {"zh": "我飞得不快，但很直。", "en": "Not fast, but very straight."},
        {"zh": "我绕着一朵花转。", "en": "I circle a flower."},
        {"zh": "风一吹，我就偏了。", "en": "A gust and I drift off course."},
        {"zh": "我落在树皮上。", "en": "I settle on the bark."},
        {"zh": "我的影子是淡的。", "en": "My shadow is faint."},
        {"zh": "我沿着月光飞。", "en": "I fly along the moonlight."},
        {"zh": "翅膀响得很轻。", "en": "My wings make a soft sound."},
        {"zh": "我飞过一小片空地。", "en": "I cross a small clearing."},
        {"zh": "我找了很久，才找到这朵花。", "en": "It took a long while to find this flower."},
        {"zh": "我贴着草尖过去。", "en": "I skim over the grass tips."},
        {"zh": "月光照透我半边的翅。", "en": "Moonlight shines through half of my wing."},
        {"zh": "这一带的花都不香。", "en": "The flowers here have no scent."},
        {"zh": "我又转回原路。", "en": "I turn back the way I came."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在叶子上，收着翅膀。", "en": "I sit on a leaf with wings folded."},
        {"zh": "我的触角亮了一下。", "en": "My antennae glow once."},
        {"zh": "夜里这么静。", "en": "The night is so quiet."},
        {"zh": "我在等露水。", "en": "I am waiting for dew."},
        {"zh": "我的鳞粉沾在叶面上。", "en": "My scales dust the leaf."},
        {"zh": "我抬头看月亮。", "en": "I look up at the moon."},
        {"zh": "夜里这么静，我连翅膀都不抖。", "en": "The night is so still I do not even stir my wings."},
        {"zh": "这一片，我常来。", "en": "I often come to this patch."},
        {"zh": "我把翅膀晾干。", "en": "I dry my wings."},
        {"zh": "我把翅膀合在叶背上。", "en": "I fold my wings against the back of the leaf."},
        {"zh": "我离那盏灯太近。", "en": "I am too close to that lamp."},
        {"zh": "我扇了几下，试着飞。", "en": "A few beats to test my wings."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你看见我了？", "en": "You saw me?"},
        {"zh": "我停在你手边。", "en": "I settle by your hand."},
        {"zh": "我的触角照见你的脸。", "en": "My antennae light up your face."},
        {"zh": "我会被光吸过去。", "en": "Light draws me in."},
        {"zh": "我不是蝴蝶。", "en": "I am not a butterfly."},
        {"zh": "我的翅膀是白的。", "en": "My wings are white."},
        {"zh": "你伸手，我就飞。", "en": "Reach out and I fly."},
        {"zh": "别捏我。", "en": "Do not pinch me."},
        {"zh": "白翅在夜里最容易被看见。", "en": "White wings are easiest to spot at night."},
        {"zh": "你的衣服沾了夜露。", "en": "Your clothes are damp with night dew."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我掉了几片鳞粉。", "en": "Some of my scales fell."},
        {"zh": "我的白翅，在夜里最显眼。", "en": "My white wings stand out most at night."},
        {"zh": "我太重了，飞不起来。", "en": "I am too heavy to fly."},
        {"zh": "翅膀上破了个口。", "en": "There is a tear in my wing."},
        {"zh": "我疼，可没有声音。", "en": "I hurt, and make no sound."},
        {"zh": "谁碰了我？", "en": "Who touched me?"},
        {"zh": "我落在地上。", "en": "I land on the ground."},
        {"zh": "我试着扇翅。", "en": "I try to beat my wings."},
        {"zh": "还能飞。", "en": "I can still fly."},
        {"zh": "我慢慢爬回去。", "en": "I crawl slowly back."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那朵花，是给我的？", "en": "Is that flower for me?"},
        {"zh": "我的触角亮着，能照见你。", "en": "My antennae glow enough to find you."},
        {"zh": "我只要花蜜。", "en": "I want only nectar."},
        {"zh": "花蜜一勾，我就忘了怎么飞。", "en": "One pull of nectar and I forget how to fly."},
        {"zh": "那朵花的花蜜刚熟。", "en": "The nectar in that flower has just ripened."},
        {"zh": "那不是我认得的种类。", "en": "That is not a kind I know."},
        {"zh": "我落在花瓣上。", "en": "I land on the petals."},
        {"zh": "别动，我在吸。", "en": "Do not move. I am feeding."},
        {"zh": "白色的翅，夜里最显眼。", "en": "White wings show best at night."},
        {"zh": "谢了，我记住了。", "en": "Thank you. I will remember."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我被你撞歪了。", "en": "You knocked me off course."},
        {"zh": "翅粉掉了一片。", "en": "A patch of wing dust fell."},
        {"zh": "我转了两圈才稳。", "en": "Two turns before I steadied."},
        {"zh": "你一挥手，我飘出去半格。", "en": "One wave of your hand floats me half a block away."},
        {"zh": "我撞在你肩上，掉了一层粉。", "en": "I bump your shoulder and shed a layer of scales."},
        {"zh": "你踩到我落在雪上的影子了。", "en": "You stepped on my shadow cast on the snow."},
        {"zh": "我贴着你肩膀飞过。", "en": "I flew past your shoulder."},
        {"zh": "风比你还用力。", "en": "The wind pushes harder than you do."},
        {"zh": "我落在你帽子上。", "en": "I landed on your hat."},
        {"zh": "抱歉，我撞上你了。", "en": "Sorry. I bumped you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "白色的翅绕着灯转了两圈。", "en": "White wings circled the lamp twice."},
        {"zh": "它的翅膀更白。", "en": "Its wings are whiter than mine."},
        {"zh": "我们并排飞。", "en": "We fly side by side."},
        {"zh": "翅粉混在一起。", "en": "Our wing dust mingles."},
        {"zh": "这片林子够我们。", "en": "This wood is enough for us."},
        {"zh": "它的触角碰了我的。", "en": "Its antennae touched mine."},
        {"zh": "我们一起落在一朵花上。", "en": "We settle on one flower together."},
        {"zh": "夜快过去了。", "en": "The night is nearly over."},
        {"zh": "我们各飞一边。", "en": "We fly our separate ways."},
        {"zh": "明年还有这样的夜。", "en": "There will be nights like this next year."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "那不是花。", "en": "That is not a flower."},
        {"zh": "我用脚抓着它。", "en": "I hold it with my feet."},
        {"zh": "太重了，我提不动。", "en": "Too heavy. I cannot lift it."},
        {"zh": "它黏在我翅膀上。", "en": "It is stuck to my wing."},
        {"zh": "我用细脚抓住花瓣。", "en": "I grip the petal with my thin legs."},
        {"zh": "这个会发光，我要。", "en": "This one glows. I want it."},
        {"zh": "我叼着花，飞不远。", "en": "With a flower in my feet, I cannot fly far."},
        {"zh": "你有花吗？", "en": "Do you have a flower?"},
        {"zh": "不是我要的。", "en": "Not what I want."},
        {"zh": "我丢在叶子上了。", "en": "I dropped it on a leaf."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "有光，我看见了。", "en": "A light. I see it."},
        {"zh": "我转过去。", "en": "I turn toward it."},
        {"zh": "你的灯在晃。", "en": "Your lamp is swinging."},
        {"zh": "我离得太近了。", "en": "I am too close."},
        {"zh": "我要从那边过去。", "en": "I will go that way."},
        {"zh": "等它停一下。", "en": "Wait for it to pause."},
        {"zh": "就是那朵花。", "en": "That flower."},
        {"zh": "我白色的翅膀，在暗里很亮。", "en": "My white wings shine in the dark."},
        {"zh": "它在一片叶子上。", "en": "It is on a leaf."},
        {"zh": "我飞过去。", "en": "I fly over."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕着它飞。", "en": "I circle it."},
        {"zh": "我在它眼前撒下一片鳞粉。", "en": "I scatter a cloud of scales before its eyes."},
        {"zh": "我悬在它上方。", "en": "I hover above it."},
        {"zh": "它不动，正好。", "en": "It is still. Good."},
        {"zh": "翅粉落下来了。", "en": "My dust drifts down."},
        {"zh": "我找好落脚的边。", "en": "I pick the edge to land on."},
        {"zh": "就这儿。", "en": "Here."},
        {"zh": "我慢慢降。", "en": "I descend slowly."},
        {"zh": "它会不会动。", "en": "Will it move?"},
        {"zh": "落。", "en": "Down."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我用翅粉迷它。", "en": "I blind it with wing dust."},
        {"zh": "我撞过去，很轻。", "en": "I ram it, softly."},
        {"zh": "我的翅粉糊在它眼睛上。", "en": "My wing scales cake over its eyes."},
        {"zh": "我被气流掀开。", "en": "The draft throws me off."},
        {"zh": "白色的翅，在夜里最显眼。", "en": "White wings stand out at night."},
        {"zh": "我再上。", "en": "I come again."},
        {"zh": "这不算打，是撞。", "en": "This is not a fight. It is a bump."},
        {"zh": "我的触角缠住了。", "en": "My antennae are tangled."},
        {"zh": "它退开了。", "en": "It has moved off."},
        {"zh": "我飞回原处。", "en": "I fly back to my place."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从夜里出现。", "en": "I come out of the night."},
        {"zh": "白色的，只有我。", "en": "White, and only me."},
        {"zh": "这片林子有花。", "en": "This wood has flowers."},
        {"zh": "我先飞一圈。", "en": "First I fly a circuit."},
        {"zh": "翅粉落在叶上。", "en": "Dust settles on the leaves."},
        {"zh": "月光够我用了。", "en": "The moonlight is enough for me."},
        {"zh": "我找一棵树靠着。", "en": "I find a tree to rest on."},
        {"zh": "这里没有别人。", "en": "There is no one else here."},
        {"zh": "我从夜色里显出一身白。", "en": "My white shows out of the darkness."},
        {"zh": "我的触角先亮了一下。", "en": "My antennae light up first."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一点，我的翅膀就卷了。", "en": "One touch of flame and my wing curls."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从半空掉下，很轻的一响。", "en": "I fall from the air with a very light thud."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水把我的鳞粉全冲掉了。", "en": "Water washes all my scales away."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我吹远。", "en": "The blast blows me far off."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一根针穿过了我的翅膀。", "en": "A pin went through my wing."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "我的触角突然灭了。", "en": "My antennae suddenly went dark."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "甜的东西，我找不到。", "en": "I cannot find anything sweet."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "闪电把我钉在树干上。", "en": "The lightning flash pins me to the trunk."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "没有风，也没有花。", "en": "No wind, and no flowers."}
      ]
    }
  }
}
