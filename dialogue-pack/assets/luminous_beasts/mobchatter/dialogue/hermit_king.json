{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我拖着大壳横着走", "en": "I drag my great shell sideways."},
        {"zh": "八条腿踩得沙子下陷", "en": "Eight legs sink into the sand."},
        {"zh": "潮水退了我才走", "en": "I move once the tide withdraws."},
        {"zh": "壳太重，只能慢走", "en": "The shell is heavy; I can only plod."},
        {"zh": "我沿海滩一步步挪", "en": "I inch along the beach."},
        {"zh": "沙里的小东西都躲我", "en": "Small things in the sand hide from me."},
        {"zh": "我的螯举着，像王冠", "en": "My claws are raised like a crown."},
        {"zh": "每天这段滩都是我的", "en": "This stretch of shore is mine each day."},
        {"zh": "我走过的地方一道沟", "en": "A furrow follows my path."},
        {"zh": "贝壳在我脚下碎", "en": "Shells crack under my feet."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我坐在潮线边上", "en": "I sit at the tide line."},
        {"zh": "海风把我的壳吹干了", "en": "The sea wind dries my shell."},
        {"zh": "我听着浪，一动不动", "en": "I listen to the waves, motionless."},
        {"zh": "这片海滩归我", "en": "This beach is mine."},
        {"zh": "我的壳又大了一圈", "en": "My shell has grown again."},
        {"zh": "沙在壳上堆了一点", "en": "Sand has gathered on my shell."},
        {"zh": "潮水会替我说话", "en": "The tide speaks for me."},
        {"zh": "我抬起一只螯，又放下", "en": "I raise one claw, then lower it."},
        {"zh": "这些年我一直在这儿", "en": "I've been here all these years."},
        {"zh": "太阳把我的壳晒热了", "en": "The sun has warmed my shell."},
        {"zh": "我挪了挪，找到好位置", "en": "I shift to a better spot."},
        {"zh": "退潮的时候最安静", "en": "Low tide is the quietest."},
        {"zh": "我不急，海也不急", "en": "I'm in no hurry, and neither is the sea."},
        {"zh": "有谁踩上我的滩了", "en": "Someone's stepped on my beach."},
        {"zh": "我数着浪的节奏", "en": "I count the rhythm of waves."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到我的滩了", "en": "You've walked onto my shore."},
        {"zh": "这是我坐了很多年的地方", "en": "I've sat here many years."},
        {"zh": "你的鞋里全是沙", "en": "Your shoes are full of sand."},
        {"zh": "我这一壳，你抬不动", "en": "You couldn't lift this shell."},
        {"zh": "你想找什么东西", "en": "What are you looking for?"},
        {"zh": "海那边没有路", "en": "There's no road across the sea."},
        {"zh": "你站得远一点", "en": "Stand farther off."},
        {"zh": "我的螯比你手大", "en": "My claws are bigger than your hands."},
        {"zh": "你盯着我的壳看", "en": "You keep staring at my shell."},
        {"zh": "这片滩上只有我一个王", "en": "Only one king on this shore."},
        {"zh": "潮水快回来了", "en": "The tide's coming back."},
        {"zh": "你要是不走，就得留下", "en": "If you don't leave, you'll stay."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "这一下砸在壳上", "en": "That landed on my shell."},
        {"zh": "我的腿被砍了", "en": "A leg of mine was cut."},
        {"zh": "我退到潮水里", "en": "I retreat into the surf."},
        {"zh": "你竟敢对王动手", "en": "You dare strike a king."},
        {"zh": "壳上多了道痕", "en": "A new scar on my shell."},
        {"zh": "我还稳坐着呢", "en": "I'm still seated."},
        {"zh": "这滩不欢迎你", "en": "This shore doesn't welcome you."},
        {"zh": "我的螯有点抖", "en": "My claw is trembling."},
        {"zh": "年岁毕竟大了", "en": "I am old, after all."},
        {"zh": "再来一次你就完了", "en": "Once more and you're finished."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你拿贝壳讨好我？", "en": "Bribing me with a shell?"},
        {"zh": "我不吃那东西", "en": "I don't eat that."},
        {"zh": "放地上，走开", "en": "Set it down and step away."},
        {"zh": "我的滩上什么都不缺", "en": "My shore lacks nothing."},
        {"zh": "那点东西不够", "en": "That isn't enough."},
        {"zh": "你要收买一个王", "en": "You'd buy a king?"},
        {"zh": "我不需要你的东西", "en": "I don't need your gifts."},
        {"zh": "它得放在潮线以上", "en": "It must be above the tide line."},
        {"zh": "这算作贡品吧", "en": "Consider it tribute."},
        {"zh": "拿回去，我不收", "en": "Take it back; I take nothing."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上的是礁石吗", "en": "Did you hit a reef?"},
        {"zh": "你被弹到沙里了", "en": "You were knocked into the sand."},
        {"zh": "小小的碰撞而已", "en": "A small collision, nothing more."},
        {"zh": "让开，我要回海", "en": "Move; I'm going back to the sea."},
        {"zh": "沙子都飞起来了", "en": "The sand went flying."},
        {"zh": "别碰我的壳口", "en": "Don't touch the shell's opening."},
        {"zh": "这一下我不计较", "en": "I'll let that pass."},
        {"zh": "再撞就换我出手", "en": "Bump again and I'll act."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我已经是王了", "en": "I'm already a king."},
        {"zh": "这片滩不需要王后", "en": "This shore needs no queen."},
        {"zh": "我只守着潮线", "en": "I only keep the tide line."},
        {"zh": "你问得不对头", "en": "Wrong question to ask."},
        {"zh": "壳里只住我一个", "en": "Only I live in this shell."},
        {"zh": "王没有这种打算", "en": "A king has no such plan."},
        {"zh": "海比这更重要", "en": "The sea matters more."},
        {"zh": "别在我滩上说这些", "en": "Don't speak of it on my shore."},
        {"zh": "退潮之前别说", "en": "Not before the tide turns."},
        {"zh": "你早就该走了", "en": "You should leave."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "王是不能搬的", "en": "A king isn't to be carried."},
        {"zh": "我的壳有半间屋子大", "en": "My shell is half a room."},
        {"zh": "你抬不起来的", "en": "You can't lift it."},
        {"zh": "快把我放下来", "en": "Put me down."},
        {"zh": "这一路沙都在晃", "en": "The sand sways on this journey."},
        {"zh": "你抓的是壳边", "en": "You've grabbed the shell's rim."},
        {"zh": "我的螯还举着", "en": "My claws are still raised."},
        {"zh": "这实在太不体面", "en": "This is deeply undignified."},
        {"zh": "你手会脱力的", "en": "Your grip will fail."},
        {"zh": "我不会离开我的滩", "en": "I won't leave my shore."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你已经踩过线", "en": "You've stepped past the line."},
        {"zh": "这片滩不是给人踩的", "en": "This shore isn't for trampling."},
        {"zh": "我的螯举起来了", "en": "My claws are raised."},
        {"zh": "潮水回来之前，你先走", "en": "Leave before the tide returns."},
        {"zh": "王也是会发怒的", "en": "Even a king grows angry."},
        {"zh": "我这螯夹断过木头", "en": "These claws have snapped wood."},
        {"zh": "你站的位置不对", "en": "You're standing in the wrong place."},
        {"zh": "别往水里退去", "en": "Don't retreat into the water."},
        {"zh": "这滩只有一个主人", "en": "This beach has one master."},
        {"zh": "我的壳太重，可我冲得动。", "en": "My shell is heavy, but I can still charge."},
        {"zh": "你在我的潮线上", "en": "You're on my tide line."},
        {"zh": "再动一下就晚了", "en": "Move again and it's too late."},
        {"zh": "壳里也有力气", "en": "There's strength inside this shell too."},
        {"zh": "我坐在这儿，等你过来", "en": "I sit here, waiting for you to come."},
        {"zh": "这可不是吓唬", "en": "This is no bluff."},
        {"zh": "你压坏了我晒的沙", "en": "You've spoiled my sun-warmed sand."},
        {"zh": "我走了一辈子，不缺这一战", "en": "I've walked a lifetime; I can spare this fight."},
        {"zh": "浪在替你数着", "en": "The waves are counting for you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的螯举着，你慢慢看", "en": "My claws are raised; take your time."},
        {"zh": "你退到水里更麻烦", "en": "Retreating into the water is worse."},
        {"zh": "潮线在我脚下", "en": "The tide line is at my feet."},
        {"zh": "壳挡住了我的背", "en": "The shell covers my back."},
        {"zh": "你只能正面来", "en": "You can only come at me head-on."},
        {"zh": "我在等你踏错一步", "en": "I wait for one wrong step."},
        {"zh": "沙里都是我的脚印", "en": "The sand is full of my prints."},
        {"zh": "浪一来，你就站不稳", "en": "When a wave comes, you'll lose footing."},
        {"zh": "我的螯比你的剑重", "en": "My claws are heavier than your blade."},
        {"zh": "这片滩我闭着眼都熟", "en": "I know this shore blindfolded."},
        {"zh": "你还站着，很好", "en": "You're still standing. Good."},
        {"zh": "潮水已经涨了", "en": "The tide has come in."},
        {"zh": "我可不会挪开", "en": "I won't move aside."},
        {"zh": "你脚陷进沙里了", "en": "Your feet are sinking in the sand."},
        {"zh": "我就在等这一下", "en": "Waiting for exactly this."},
        {"zh": "我年纪大，但没瞎", "en": "Old as I am, I'm not blind."},
        {"zh": "你背后是礁石", "en": "There's a reef behind you."},
        {"zh": "我不会离开潮线", "en": "I won't leave the tide line."},
        {"zh": "你听见海回潮了吗", "en": "Hear the sea returning?"},
        {"zh": "我已经站起来", "en": "I'm on my feet."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "螯已经夹住你", "en": "Clamped."},
        {"zh": "这一下够你记一辈子", "en": "You'll remember that one for life."},
        {"zh": "我的螯不是摆设", "en": "These claws aren't decoration."},
        {"zh": "退到潮线外面去", "en": "Get beyond the tide line."},
        {"zh": "我的壳也能撞人", "en": "The shell strikes too."},
        {"zh": "王会亲自动手", "en": "The king strikes himself."},
        {"zh": "沙都被我扫开了", "en": "I swept the sand aside."},
        {"zh": "这一下留了力", "en": "I held back."},
        {"zh": "再不走就再来", "en": "Leave, or take another."},
        {"zh": "我的滩清净了", "en": "My shore is quiet again."},
        {"zh": "别哭，海会冲掉", "en": "Don't weep; the sea will wash it away."},
        {"zh": "这一夹是国法", "en": "That clamp was the law."},
        {"zh": "我要回海里去", "en": "I'm returning to the sea."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "潮水把我送上滩", "en": "The tide brought me onto the shore."},
        {"zh": "我在这片滩上坐下来", "en": "I settle down on this beach."},
        {"zh": "壳里还是湿的", "en": "My shell is still wet."},
        {"zh": "又是退潮的时候", "en": "Low tide again."},
        {"zh": "这里需要一个王", "en": "This place needs a king."},
        {"zh": "沙子还带着夜里的凉", "en": "The sand still holds the night's chill."},
        {"zh": "我拖着壳爬上来", "en": "I haul my shell up the sand."},
        {"zh": "海就在我身后", "en": "The sea is at my back."},
        {"zh": "谁先看见我，谁先让路", "en": "Whoever sees me first steps aside."},
        {"zh": "我来了，滩就安静了", "en": "I arrive, and the shore falls quiet."},
        {"zh": "涨潮之前我得巡视一趟", "en": "I must patrol before the tide."},
        {"zh": "贝壳在我脚下响", "en": "Shells crack under me."},
        {"zh": "这一片归我管", "en": "This stretch answers to me."},
        {"zh": "我的王座就是这壳", "en": "My throne is this shell."},
        {"zh": "风从海上来了", "en": "The wind comes off the sea."},
        {"zh": "今天的浪很高", "en": "The waves are high today."},
        {"zh": "我认得每一块礁石", "en": "I know every rock."},
        {"zh": "我已经坐好了", "en": "I'm seated."},
        {"zh": "那就此开始吧", "en": "Then let's begin."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火烤得壳都裂响", "en": "The flames crackled my shell."}
      ]
    },
