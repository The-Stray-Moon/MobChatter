      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那东西卡在我壳缝里", "en": "That stuck in my shell's seam."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术让我的腿发软", "en": "The spell weakened my legs."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿着可搬不动这壳", "en": "Hungry, I can't shift this shell."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在滩上，沙都化了", "en": "The bolt melted the sand."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "海水底下也没有这么黑", "en": "Not even the deep sea is this dark."}
      ]
    }
  }
}
