{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "翅膀上抖下细细的鳞粉", "en": "Fine scales shake from my wings."},
        {"zh": "我在夜风里飘着飞", "en": "I drift on the night wind."},
        {"zh": "翅很宽，飞起来慢", "en": "My wings are wide; I fly slowly."},
        {"zh": "我绕着发亮的地方转", "en": "I circle whatever gleams."},
        {"zh": "翅粉在空中留了一条线", "en": "Scale dust leaves a line in the air."},
        {"zh": "我贴着你头顶掠过", "en": "I skim above your head."},
        {"zh": "一道淡光跟着我", "en": "A faint light follows me."},
        {"zh": "我被灯吸过去", "en": "The lamp draws me in."},
        {"zh": "翅膜薄得能看见月光", "en": "Moonlight shows through my wing film."},
        {"zh": "我绕着树干飞了一圈", "en": "I loop once around the trunk."},
        {"zh": "风一大我就被吹偏", "en": "A strong gust pushes me off course."},
        {"zh": "我不落地，只在空中歇", "en": "I don't land; I rest in the air."},
        {"zh": "我沿着溪面飞", "en": "I fly along the stream's surface."},
        {"zh": "夜露把翅打湿了", "en": "Night dew dampens my wings."},
        {"zh": "我贴着一排花滑过去", "en": "I glide past a row of flowers."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "翅合起来，光也暗了", "en": "Folding my wings dims the light."},
        {"zh": "我的鳞粉落在叶面", "en": "My scales dust the leaf's surface."},
        {"zh": "夜里的光都在我身上", "en": "All the night's light is on me."},
        {"zh": "我在看那轮月亮", "en": "I'm watching the moon."},
        {"zh": "这时候飞太显眼", "en": "Flying now would be too conspicuous."},
        {"zh": "我慢慢眨着眼", "en": "I blink slowly."},
        {"zh": "翅上的纹路亮了一下", "en": "The pattern on my wing brightens."},
        {"zh": "我听见花在开", "en": "I hear a flower opening."},
        {"zh": "灯光太远，我不想过去", "en": "The light is too far; I'd rather not."},
        {"zh": "风停了，正好歇", "en": "The wind has died; good time to rest."},
        {"zh": "我的鳞粉有点干", "en": "My scales feel dry."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的光是什么", "en": "What's that light on you?"},
        {"zh": "你抬手我就退", "en": "Raise your hand and I'll back off."},
        {"zh": "翅粉会沾你衣服上", "en": "My scale dust will cling to your clothes."},
        {"zh": "你是不是想抓我", "en": "Are you trying to catch me?"},
        {"zh": "你的灯刺得眼疼", "en": "Your lamp stings my eyes."},
        {"zh": "我认得夜里的每种光", "en": "I know every light in the night."},
        {"zh": "你安静一会儿", "en": "Be still for a moment."},
        {"zh": "别碰我的翅膀", "en": "Don't touch my wings."},
        {"zh": "我的翅粉，落在你袖子上。", "en": "My wing dust settles on your sleeve."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅膀啊！", "en": "My wings!"},
        {"zh": "鳞粉撒了一地", "en": "My scales spilled everywhere."},
        {"zh": "我的光变暗了", "en": "My light has dimmed."},
        {"zh": "别碰我的翅膜", "en": "Don't touch my wing film."},
        {"zh": "翅膀皱了一半", "en": "Half my wing is crumpled."},
        {"zh": "我已经飞不稳", "en": "I can't fly steady now."},
        {"zh": "掉了很多鳞粉", "en": "So many scales lost."},
        {"zh": "这一下真的疼", "en": "That really hurt."},
        {"zh": "我还飞得起来", "en": "I can still fly."},
        {"zh": "让我收一收翅", "en": "Let me gather my wings."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那点亮，我能靠近吗", "en": "That little light—may I come near?"},
        {"zh": "我不是吃东西的", "en": "I don't come for food."},
        {"zh": "你手里的光在动", "en": "The light in your hand is moving."},
        {"zh": "我只对光有兴趣", "en": "Only light interests me."},
        {"zh": "那根本不是花", "en": "That isn't a flower at all."},
        {"zh": "别拿火来晃我", "en": "Don't wave fire at me."},
        {"zh": "我会绕着你飞", "en": "I'll circle around you."},
        {"zh": "太亮了，眼睛疼", "en": "Too bright; my eyes ache."},
        {"zh": "你把它举低一点", "en": "Hold it lower."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的翅撞皱了", "en": "My wing got crumpled."},
        {"zh": "鳞粉都撒你身上了", "en": "My scales spilled all over you."},
        {"zh": "我刚才飞得太低", "en": "I was flying too low."},
        {"zh": "让一让，我收不住", "en": "Move; I can't slow down."},
        {"zh": "你比我结实多了", "en": "You're far sturdier than I."},
        {"zh": "我绕开你就好了", "en": "I should have flown around you."},
        {"zh": "这一下把光都撞散了", "en": "That scattered my light."},
        {"zh": "翅膜没破，还好", "en": "The wing film held, luckily."},
        {"zh": "我们撞出一层粉", "en": "We knocked loose a cloud of dust."},
        {"zh": "下次我飞高些", "en": "Next time I'll fly higher."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我们绕着灯飞吧", "en": "Let's circle the lamp together."},
        {"zh": "你的翅纹真好看", "en": "Your wing pattern is beautiful."},
        {"zh": "我只有几个夜晚", "en": "I have only a few nights."},
        {"zh": "飞到我旁边来", "en": "Fly beside me."},
        {"zh": "我们跳一段空中舞", "en": "Let's dance in the air."},
        {"zh": "别撞到我的翅", "en": "Don't bump my wings."},
        {"zh": "就这几夜，别浪费", "en": "Only these few nights; don't waste them."},
        {"zh": "你的光比我的暖", "en": "Your glow is warmer than mine."},
        {"zh": "风一来我们要散", "en": "When the wind comes we'll part."},
        {"zh": "我们再绕一圈", "en": "One more circle."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "轻点，翅会破", "en": "Gently; my wings tear."},
        {"zh": "我翅上的粉会掉", "en": "My wing dust will rub off."},
        {"zh": "别捏我的身体", "en": "Don't squeeze my body."},
        {"zh": "放我下来，我自己飞", "en": "Put me down; I can fly."},
        {"zh": "你手心里的光太暗", "en": "The light in your palm is too dim."},
        {"zh": "这样我展不开翅", "en": "Held so, I can't spread my wings."},
        {"zh": "我会在你手上留下粉", "en": "I'll leave dust on your hand."},
        {"zh": "到亮处再放我", "en": "Set me down in the light."},
        {"zh": "你的手心很暖", "en": "Your hand is very warm."},
        {"zh": "请你把手松开", "en": "Let me go."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "那道光不是你的", "en": "That light isn't yours."},
        {"zh": "你抢了我的灯火", "en": "You took my lamp."},
        {"zh": "我不喜欢被追", "en": "I dislike being chased."},
        {"zh": "我会撒你一脸粉", "en": "I'll dust your face."},
        {"zh": "翅粉进眼睛很疼", "en": "Scale dust stings the eyes."},
        {"zh": "我飞得慢，但会绕", "en": "I'm slow, but I circle."},
        {"zh": "你别碰那盏灯", "en": "Don't touch that lamp."},
        {"zh": "我这就飞过去", "en": "I'm coming for you."},
        {"zh": "夜是属于我的", "en": "The night is mine."},
        {"zh": "再靠近我就不客气", "en": "Closer and I won't be gentle."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "你眼睛里有光", "en": "There's light in your eyes."},
        {"zh": "我撒的粉在飘", "en": "My dust is drifting down."},
        {"zh": "你抬头就中了", "en": "Look up and you're caught."},
        {"zh": "我的影子盖住你的脸", "en": "My shadow crosses your face."},
        {"zh": "你手里的灯在晃", "en": "The lamp in your hand sways."},
        {"zh": "别眨你的眼睛", "en": "Don't blink."},
        {"zh": "粉会落在你睫毛上", "en": "Dust settles on your lashes."},
        {"zh": "等风停下就动手", "en": "When the wind drops, I move."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "鳞粉撒下去了", "en": "The scales fall."},
        {"zh": "眼睛睁不开了吧", "en": "Can't open your eyes, can you?"},
        {"zh": "我的翅也能拍人", "en": "My wings can strike too."},
        {"zh": "这一下不重，但很痒", "en": "Not heavy, but it itches."},
        {"zh": "退开，别再靠近", "en": "Back off; come no closer."},
        {"zh": "我的鳞粉会呛人", "en": "My scales will choke you."},
        {"zh": "光晃了你的眼", "en": "The light blurred your sight."},
        {"zh": "再抖一层鳞粉", "en": "Another layer of scales."},
        {"zh": "我飞得低，撞得准", "en": "Low flight, accurate hit."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我在夜里亮起来", "en": "I light up in the night."},
        {"zh": "翅上的纹路展开了", "en": "The pattern on my wings unfolds."},
        {"zh": "我从叶背翻出来", "en": "I crawl out from under a leaf."},
        {"zh": "这片林子有了一点光", "en": "This wood has a little light now."},
        {"zh": "我绕着月光飞", "en": "I circle the moonlight."},
        {"zh": "今夜的夜色正好", "en": "Tonight's darkness is just right."},
        {"zh": "有盏灯在远处", "en": "A lamp glows far off."},
        {"zh": "粉从我翅上落下", "en": "Dust falls from my wings."},
        {"zh": "我该去哪朵花", "en": "Which flower is mine?"},
        {"zh": "没什么可怕的", "en": "There's nothing to fear."}
      ]
    },
