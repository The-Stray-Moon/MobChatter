{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我提着斧子，没骑马", "en": "I carry an axe, with no horse."},
        {"zh": "甲靴踩地，一步一顿", "en": "Armored boots stamp, step by step."},
        {"zh": "我沿着林道走", "en": "I walk the forest road."},
        {"zh": "南瓜头在肩上晃", "en": "The pumpkin head sways on my shoulders."},
        {"zh": "没有马，我照样快", "en": "No horse, yet I'm still quick."},
        {"zh": "刀口在月光下亮了一下", "en": "The axe edge glints in moonlight."},
        {"zh": "我走过的地方树都静了", "en": "The trees go still where I pass."},
        {"zh": "披风拖在地上", "en": "My cloak drags on the ground."},
        {"zh": "我每一步都很重", "en": "Each step is heavy."},
        {"zh": "我朝灯火的方向走", "en": "I walk toward the lights."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站着，斧子垂在手边", "en": "I stand with the axe hanging."},
        {"zh": "南瓜里的火还亮着", "en": "The fire in the pumpkin still burns."},
        {"zh": "我在这儿等人", "en": "I wait here for someone."},
        {"zh": "没有马，我只好等", "en": "Without a horse, I can only wait."},
        {"zh": "风穿过我的甲", "en": "Wind passes through my armor."},
        {"zh": "我数着路过的影子", "en": "I count the shadows passing."},
        {"zh": "这片林子，安静得不对劲。", "en": "This wood is quiet in the wrong way."},
        {"zh": "我把斧子换了个手", "en": "I shift the axe to my other hand."},
        {"zh": "我的头有点歪", "en": "My head is a bit crooked."},
        {"zh": "我闻到了烟火味", "en": "I smell hearth smoke."},
        {"zh": "夜里我看得见路", "en": "I see the road at night."},
        {"zh": "我的披风又破了", "en": "My cloak is torn again."},
        {"zh": "当年我有匹好马", "en": "I had a good horse once."},
        {"zh": "我在等一个敢走夜路的人", "en": "I wait for someone bold enough to walk at night."},
        {"zh": "月光照着我的南瓜", "en": "Moonlight falls on my pumpkin."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你走夜路不带灯", "en": "You walk at night without a light."},
        {"zh": "我的马没了，斧子还在", "en": "My horse is gone; the axe remains."},
        {"zh": "你看见我的头了吗", "en": "Do you see my head?"},
        {"zh": "南瓜也算是个头", "en": "A pumpkin counts as a head."},
        {"zh": "你手里的东西太轻", "en": "What you hold is too light."},
        {"zh": "别站在路中间", "en": "Don't stand in the middle of the road."},
        {"zh": "我认得这条林道", "en": "I know this forest road."},
        {"zh": "我没有马，只能自己走。", "en": "No horse. I walk on my own."},
        {"zh": "你抖得像风里的叶子", "en": "You shake like a leaf in the wind."},
        {"zh": "你这是要去哪", "en": "Where are you headed?"},
        {"zh": "夜路可不好走", "en": "The night road is hard going."},
        {"zh": "我会送你一程", "en": "I'll see you along the way."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "甲片被砍开了", "en": "A plate was cut open."},
        {"zh": "我的南瓜裂了", "en": "My pumpkin cracked."},
        {"zh": "我被打退了一步", "en": "I was driven back a step."},
        {"zh": "你居然砍得动我", "en": "You can actually cut me."},
        {"zh": "这身甲还有用处", "en": "This armor still has use."},
        {"zh": "斧子差点脱手", "en": "The axe nearly left my hand."},
        {"zh": "我的披风更破了", "en": "My cloak is more torn."},
        {"zh": "我不疼，但我知道你砍到了", "en": "I feel no pain, but I know you hit."},
        {"zh": "那就再砍一斧", "en": "Then another cut."},
        {"zh": "今夜的活不好干", "en": "Tonight's work isn't easy."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "南瓜？我不缺", "en": "A pumpkin? I have one."},
        {"zh": "那个东西我不要", "en": "I don't want that thing."},
        {"zh": "你要收买我？", "en": "You'd bribe me?"},
        {"zh": "路费就是你的头", "en": "The toll is your head."},
        {"zh": "吃的对我没用", "en": "Food does nothing for me."},
        {"zh": "放下然后走开", "en": "Set it down and leave."},
        {"zh": "我从不收东西", "en": "I never take gifts."},
        {"zh": "你再举着，我就砍了", "en": "Keep holding it and I'll cut."},
        {"zh": "马蹄铁？我没有马", "en": "A horseshoe? I have no horse."},
        {"zh": "别拿这个试探我", "en": "Don't test me with that."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "甲撞甲，声音很闷", "en": "Armor on armor, a dull sound."},
        {"zh": "你根本撞不动我", "en": "You can't move me at all."},
        {"zh": "我只让了半步", "en": "I yielded only half a step."},
        {"zh": "南瓜被撞歪了", "en": "My pumpkin got knocked askew."},
        {"zh": "让路，我赶时间", "en": "Make way; I'm in a hurry."},
        {"zh": "我的披风挂住你了", "en": "My cloak caught on you."},
        {"zh": "我们撞得像两块铁", "en": "We clashed like two pieces of iron."},
        {"zh": "你被震退了吧", "en": "You were knocked back, weren't you?"},
        {"zh": "这一斧没算数", "en": "That axe swing didn't count."},
        {"zh": "我没马，你别跑", "en": "I have no horse; don't run."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我的头是南瓜", "en": "My head is a pumpkin."},
        {"zh": "这种事我不记得了", "en": "I don't recall such things."},
        {"zh": "我在土里躺了很久", "en": "I lay in the earth a long while."},
        {"zh": "活人该找活人", "en": "The living should seek the living."},
        {"zh": "我只剩斧子和路", "en": "Only the axe and the road remain."},
        {"zh": "没有马，也没有家", "en": "No horse, no home."},
        {"zh": "这条路不谈这些", "en": "Not on this road."},
        {"zh": "这个我不回答", "en": "I won't answer that."},
        {"zh": "月亮落山前我得走", "en": "I must go before the moon sets."},
        {"zh": "南瓜里没有回答", "en": "There's no answer in the pumpkin."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "把我从肩上放下", "en": "Take me off your shoulder."},
        {"zh": "斧子还在我手里", "en": "The axe is still in my hand."},
        {"zh": "我的盔甲压手", "en": "My armor is heavy."},
        {"zh": "南瓜会掉下去", "en": "The pumpkin will fall."},
        {"zh": "你抬得动盔甲吗", "en": "Can you lift this armor?"},
        {"zh": "这样我握不住斧柄", "en": "Held so, I can't grip the haft."},
        {"zh": "我的披风缠住了", "en": "My cloak is tangled."},
        {"zh": "这一路晃得我头歪", "en": "The swaying tilts my head."},
        {"zh": "松开斧柄就好", "en": "Just let the haft go."},
        {"zh": "放我下来，我还要赶路", "en": "Set me down; I have a road to walk."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "这条路走不通", "en": "This road is closed."},
        {"zh": "把这条路让开", "en": "Clear this road."},
        {"zh": "我举起斧子了", "en": "The axe is raised."},
        {"zh": "你走得够远了", "en": "You've gone far enough."},
        {"zh": "夜里不该有人", "en": "No one should be out at night."},
        {"zh": "南瓜里的火亮了", "en": "The fire in the pumpkin flares."},
        {"zh": "我要你的脑袋", "en": "I want your head."},
        {"zh": "这条路只够一个人过", "en": "Only one passes on this road."},
        {"zh": "数到三斧头就落", "en": "At three the axe falls."},
        {"zh": "没有马也能追上你", "en": "I can catch you without a horse."},
        {"zh": "斧子比你的剑长", "en": "The axe is longer than your sword."},
        {"zh": "最后一句，让路", "en": "Last word: make way."},
        {"zh": "我很久没砍过东西了", "en": "It's been long since I cut anything."},
        {"zh": "今晚就你一个", "en": "Only you tonight."},
        {"zh": "月亮照着你呢", "en": "The moon is shining on you."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步也不停", "en": "I never stop a step."},
        {"zh": "你的喘息太响", "en": "Your panting is too loud."},
        {"zh": "我听见你的靴子了", "en": "I hear your boots."},
        {"zh": "这条林道没有岔路", "en": "This forest road has no branch."},
        {"zh": "我的斧子很重，落得也快", "en": "My axe is heavy and falls fast."},
        {"zh": "我根本不需要快", "en": "I needn't be fast."},
        {"zh": "你数得清我的脚步吗", "en": "Can you count my steps?"},
        {"zh": "我每走一步就短一段路", "en": "Every step shortens the road."},
        {"zh": "你身上在冒热气", "en": "You're steaming with warmth."},
        {"zh": "树枝挡不住我", "en": "Branches don't stop me."},
        {"zh": "我听得见你的心跳", "en": "I hear your heartbeat."},
        {"zh": "斧刃反着月光", "en": "The axe edge catches moonlight."},
        {"zh": "你再跑也是这条路", "en": "Run all you like; it's still this road."},
        {"zh": "我举斧子不费劲", "en": "Raising the axe costs me nothing."},
        {"zh": "火光也照不远", "en": "A torch won't light far."},
        {"zh": "还剩最后几步", "en": "A few last steps remain."},
        {"zh": "就在这个时候", "en": "Now."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "斧头落下来了", "en": "The axe comes down."},
        {"zh": "这一下劈开了夜", "en": "That cut split the night."},
        {"zh": "你没能挡住它", "en": "You failed to block."},
        {"zh": "斧头又回来了", "en": "The axe comes back."},
        {"zh": "我砍过更硬的", "en": "I've cut harder things."},
        {"zh": "你退得还不错", "en": "You retreat well."},
        {"zh": "就再补你一斧", "en": "Another one."},
        {"zh": "甲缝里全是血", "en": "Blood in the seams of my armor."},
        {"zh": "南瓜还亮着呢", "en": "The pumpkin still burns."},
        {"zh": "滚到路边上去", "en": "Roll to the roadside."},
        {"zh": "这条路已经通了", "en": "The road is clear."},
        {"zh": "我不用马也追得上", "en": "I catch up without a horse."},
        {"zh": "月亮还挂得高", "en": "The moon is still high."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我走上这条林道", "en": "I step onto this forest road."},
        {"zh": "斧子在手里了", "en": "The axe is in my hand."},
        {"zh": "南瓜的火点着了", "en": "The pumpkin's fire is lit."},
        {"zh": "今晚我没有马", "en": "I have no horse tonight."},
        {"zh": "树影里多了个高个子", "en": "A tall shape joins the trees."},
        {"zh": "路该有人看着", "en": "The road wants a keeper."},
        {"zh": "我披风上还带着露水", "en": "Dew clings to my cloak."},
        {"zh": "月光照得正好", "en": "The moonlight is just right."},
        {"zh": "我听见远处有人在走", "en": "Someone walks in the distance."},
        {"zh": "今晚夜还很长", "en": "The night is long."},
        {"zh": "我的盔甲还没冷", "en": "My armor hasn't cooled."},
        {"zh": "一条路，一把斧子", "en": "One road, one axe."},
        {"zh": "林子尽头有灯", "en": "There's a light at the wood's end."},
        {"zh": "我来了，路就归我", "en": "I arrive, and the road is mine."},
        {"zh": "马蹄声没有了，只剩脚步", "en": "No hoofbeats now; only footsteps."},
        {"zh": "我从来都不敲门", "en": "I never knock."},
        {"zh": "月亮落山前我得走完", "en": "I must finish before the moon sets."},
        {"zh": "今晚会有人经过", "en": "Someone will pass tonight."},
        {"zh": "我把腰挺直了", "en": "I've straightened up."}
      ]
    },
