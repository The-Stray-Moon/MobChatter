{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "绷带拖在沙上", "en": "My bandages trail in the sand."},
        {"zh": "我一步一步走过沙丘", "en": "I cross the dunes step by step."},
        {"zh": "沙子灌进我的缠布", "en": "Sand fills my wrappings."},
        {"zh": "我抬手挡了挡太阳", "en": "I raise an arm against the sun."},
        {"zh": "我走得很慢，但不停", "en": "I'm slow, but I don't stop."},
        {"zh": "脚步在沙上留不下印", "en": "My steps leave no print."},
        {"zh": "我绕过枯死的灌木", "en": "I go around a dead shrub."},
        {"zh": "我身上的布已经发黄", "en": "My linen has yellowed."},
        {"zh": "风一吹，绷带就飘", "en": "Wind lifts my bandages."},
        {"zh": "我朝有阴影的地方走", "en": "I walk toward the shade."},
        {"zh": "我顺着沙脊往上爬", "en": "I climb along a dune's crest."},
        {"zh": "我在沙里埋了太久", "en": "I was buried in sand too long."},
        {"zh": "每走一步都掉一点沙", "en": "Every step sheds a little sand."},
        {"zh": "我不喜欢晌午的太阳", "en": "I dislike the noon sun."},
        {"zh": "这片沙漠我认得", "en": "I know this desert."},
        {"zh": "我走得像在数步子", "en": "I walk as if counting steps."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我站在沙丘顶上", "en": "I stand atop the dune."},
        {"zh": "绷带被风吹开一角", "en": "The wind peels back a corner of my bandages."},
        {"zh": "我抬头看太阳的位置", "en": "I check the sun's position."},
        {"zh": "沙子在我脚边堆高", "en": "Sand piles up at my feet."},
        {"zh": "我已经很久没说话了", "en": "I haven't spoken in a long time."},
        {"zh": "我闻不到什么味道", "en": "I can smell nothing."},
        {"zh": "枯草在沙沙响", "en": "The dry grass rustles."},
        {"zh": "我用不着喝水", "en": "I have no need of water."},
        {"zh": "我的影子很短", "en": "My shadow is short."},
        {"zh": "我在等太阳偏西", "en": "I wait for the sun to lean west."},
        {"zh": "风沙把我盖了一层", "en": "The wind buried me a layer deeper."},
        {"zh": "有东西在沙下动", "en": "Something moves under the sand."},
        {"zh": "我把手臂放下来", "en": "I lower my arm."},
        {"zh": "我在数着沙丘", "en": "I'm counting the dunes."},
        {"zh": "我的缠布松了", "en": "My wrappings have loosened."},
        {"zh": "等天凉了再走", "en": "I'll walk when it cools."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你也走在这片沙里", "en": "You walk this sand too."},
        {"zh": "你脸上全是汗", "en": "Your face is all sweat."},
        {"zh": "我很久没见过活人了", "en": "I haven't seen the living in ages."},
        {"zh": "你要喝点水吗", "en": "Do you want water?"},
        {"zh": "我没有水给你", "en": "I have no water to give."},
        {"zh": "我的绷带下面不好看", "en": "What's under my bandages isn't pretty."},
        {"zh": "你用不着害怕", "en": "You needn't be afraid."},
        {"zh": "我走得并不快", "en": "I don't walk fast."},
        {"zh": "你背着包，是来寻宝的", "en": "You carry a pack; you've come for treasure."},
        {"zh": "这里的墓都被翻过了", "en": "Every tomb here has been opened."},
        {"zh": "你跟了我一路", "en": "You've followed me a while."},
        {"zh": "太阳实在太毒", "en": "The sun is truly cruel."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的缠布裂了", "en": "My wrappings tore."},
        {"zh": "沙从破口漏出来", "en": "Sand leaks from the tear."},
        {"zh": "我晃了一下子", "en": "I swayed for a moment."},
        {"zh": "我不疼，只是少了点", "en": "No pain; I'm only less."},
        {"zh": "别撕我的绷布", "en": "Don't tear my linen."},
        {"zh": "我又要躺下了", "en": "I may lie down again."},
        {"zh": "让我靠一会儿", "en": "Let me lean a moment."},
        {"zh": "沙子灌进来了", "en": "Sand is getting in."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "我不用吃东西", "en": "I don't eat."},
        {"zh": "水对我没有用", "en": "Water is no use to me."},
        {"zh": "你留着路上喝", "en": "Keep it for the road."},
        {"zh": "那东西会坏在沙里", "en": "That will spoil in the sand."},
        {"zh": "我不需要供奉", "en": "I need no offerings."},
        {"zh": "你把它埋在沙里更合适", "en": "Better to bury it in the sand."},
        {"zh": "我早就忘了味道", "en": "I forgot taste long ago."},
        {"zh": "别递到我手上", "en": "Don't hand it to me."},
        {"zh": "我不饿，也不渴", "en": "I'm neither hungry nor thirsty."},
        {"zh": "你吃吧，我看着", "en": "You eat; I'll watch."},
        {"zh": "你把水倒进沙里，我也不会喝", "en": "Pour the water in the sand; I still won't drink."},
        {"zh": "那味道让我想起很久以前", "en": "That smell recalls a time long past."},
        {"zh": "我活着时大概喜欢过这个", "en": "I probably liked this when I lived."},
        {"zh": "现在只剩干渴的记忆", "en": "Only the memory of thirst remains."},
        {"zh": "你别浪费在我身上", "en": "Don't waste it on me."},
        {"zh": "沙会把这一切收回去", "en": "The sand will take it all back."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的绷带缠到你了", "en": "My bandages caught on you."},
        {"zh": "你撞上了一具干尸", "en": "You bumped a dried corpse."},
        {"zh": "我退了半步远", "en": "I stepped back half."},
        {"zh": "我没多少重量", "en": "I weigh very little."},
        {"zh": "沙子被你踢起来了", "en": "You kicked up the sand."},
        {"zh": "对不起，我走得慢", "en": "Sorry, I walk slowly."},
        {"zh": "这下缠布更松了", "en": "Now my wrappings are looser."},
        {"zh": "别靠得过于近", "en": "Don't come too close."},
        {"zh": "我们撞得像两捆布", "en": "We collided like two bundles of cloth."},
        {"zh": "请你让我过去", "en": "Let me pass."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是具干尸", "en": "I'm only a dried corpse."},
        {"zh": "这种事我早忘了", "en": "I forgot such things long ago."},
        {"zh": "我连自己的名字都不确定", "en": "I'm not even sure of my name."},
        {"zh": "活人该同活人讲", "en": "The living should speak to the living."},
        {"zh": "沙下埋着很多故事", "en": "Many stories lie under this sand."},
        {"zh": "别问起这些事", "en": "Don't ask such things."},
        {"zh": "我都不知道自己躺了多久", "en": "I don't know how long I lay there."},
        {"zh": "换个话题说说", "en": "Change the subject."},
        {"zh": "太阳落山前我得走", "en": "I must go before sunset."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你抬得动我吗", "en": "Can you lift me?"},
        {"zh": "我的绷带会散", "en": "My bandages will come undone."},
        {"zh": "别拉我的手臂", "en": "Don't pull my arm."},
        {"zh": "这样我会掉沙", "en": "I'll shed sand like this."},
        {"zh": "放我下来，沙会等我", "en": "Set me down; the sand waits."},
        {"zh": "你的手会弄脏", "en": "Your hands will get dirty."},
        {"zh": "我比你轻很多", "en": "I'm much lighter than you'd think."},
        {"zh": "沙会灌进缠布里", "en": "Sand will get inside the wrappings."},
        {"zh": "你把手松开吧", "en": "Let go."},
        {"zh": "我还是要回沙里", "en": "I still must return to the sand."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你在我墓边上", "en": "You're beside my tomb."},
        {"zh": "沙子下面不是空的", "en": "The sand below isn't empty."},
        {"zh": "我已经起来了", "en": "I'm up already."},
        {"zh": "你动了不该动的", "en": "You touched what you shouldn't."},
        {"zh": "这片墓归我守", "en": "I keep this tomb."},
        {"zh": "我虽然慢，但会一直走", "en": "I'm slow, but I keep walking."},
        {"zh": "你退回去一些", "en": "Get back."},
        {"zh": "别再动我的沙丘", "en": "Stop disturbing my dune."},
        {"zh": "沙子会记住你的脚印", "en": "The sand will remember your prints."},
        {"zh": "你就站住别动", "en": "Stop right there."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一步步靠近", "en": "I close in, step by step."},
        {"zh": "沙会拖慢你的脚", "en": "Sand will slow your feet."},
        {"zh": "你在沙里跑不快", "en": "You can't run fast in sand."},
        {"zh": "我用不着呼吸", "en": "I have no need to breathe."},
        {"zh": "我有的是时间", "en": "I have all the time there is."},
        {"zh": "你退到沙丘后面也没用", "en": "A dune won't hide you."},
        {"zh": "太阳会先累倒你", "en": "The sun will tire you first."},
        {"zh": "我会一直走着", "en": "I keep on walking."},
        {"zh": "你听见沙的声音了吗", "en": "Hear the sand?"},
        {"zh": "我就快要到了", "en": "Almost there."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手干得很", "en": "My hand is very dry."},
        {"zh": "这一下裹着布", "en": "This one comes wrapped."},
        {"zh": "你被沙迷眼了吧", "en": "Sand in your eyes?"},
        {"zh": "我力气不大，但够用", "en": "Not much strength, but enough."},
        {"zh": "缠布会勒住你", "en": "The wrappings will bind you."},
        {"zh": "你退开一点吧", "en": "Back away a bit."},
        {"zh": "这一下是替墓守的", "en": "That was for the tomb."},
        {"zh": "我还会再站起来", "en": "I'll rise again."},
        {"zh": "你也不必挣扎", "en": "Don't struggle."},
        {"zh": "睡在这片沙里不坏", "en": "Sleeping in this sand isn't bad."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从沙里坐起来", "en": "I sit up out of the sand."},
        {"zh": "沙子从我的布里漏出来", "en": "Sand pours from my wrappings."},
        {"zh": "又是这片沙漠", "en": "This desert again."},
        {"zh": "太阳照在我身上", "en": "The sun falls on me."},
        {"zh": "我这一觉睡得太久", "en": "I slept far too long."},
        {"zh": "沙丘挪了位置", "en": "The dunes have shifted."},
        {"zh": "谁踩平了我的坟", "en": "Who flattened my grave?"},
        {"zh": "风把我身上的沙吹开", "en": "Wind clears the sand off me."},
        {"zh": "我还认得这条路", "en": "I still know this road."},
        {"zh": "先找一片阴影", "en": "First, some shade."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从沙丘上滚下来，布全散了", "en": "Rolling off the dune unwound me."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "我吸不进空气，只是沉", "en": "I can't draw air; I only sink."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把我掀成一堆布", "en": "The blast threw me into a heap of cloth."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "那支箭钉进了我的肩", "en": "An arrow pinned my shoulder."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术把我身上的沙都震落了", "en": "The spell shook all the sand off me."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "我早就不会饿了", "en": "I stopped being hungry long ago."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷打在沙上，玻璃都烧出来了", "en": "The bolt fused the sand to glass."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "虚空里连沙都没有", "en": "There isn't even sand in the void."}
      ]
    }
  }
}
