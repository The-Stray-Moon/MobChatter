        {"zh": "目光在黑暗中游移", "en": "Eyes move around in the darkness"},
        {"zh": "慢慢蠕动身体", "en": "Slowly wriggling its body"},
        {"zh": "发出微弱的呢喃声", "en": "Emitting a faint whisper"},
        {"zh": "低头咀嚼空气中的腐臭", "en": "Chewing on the stench in the air"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你一回头，泥水会先动。", "en": "Turn your head and the mud moves first."},
