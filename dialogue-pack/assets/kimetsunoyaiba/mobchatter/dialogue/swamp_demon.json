    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "发出阴森低吼", "en": "Let out a dark growl"},
        {"zh": "嘶嘶吐舌前行", "en": "Slither forward with a hiss"},
        {"zh": "甩动长尾追赶", "en": "Swish its long tail as it pursues"},
        {"zh": "我贴着沼泽的水面滑行。", "en": "I skim just under the marsh surface."},
        {"zh": "低吼声回荡沼泽", "en": "Low growls echo through the swamp"},
        {"zh": "咬合紧闭，蓄力攻击", "en": "Jaw clamps shut, storing up energy for an attack"},
        {"zh": "挥动长爪，快速逼近", "en": "Wave its long claws, quickly closing the distance"},
        {"zh": "尖利爪子在泥中抓挠", "en": "Claw the mud with its sharp claws"},
        {"zh": "阴影中浮现它的身影", "en": "Shape appears out of the shadows"},
        {"zh": "发出血鬼术前的低语", "en": "Whisper before using blood magic"},
        {"zh": "泥水没过我的脚踝。", "en": "Mud water rises past my ankles."},
        {"zh": "芦苇被我拨开一条路。", "en": "I part the reeds into a path."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "低垂着头休息", "en": "Resting with head lowered"},
        {"zh": "泥水从我齿间流下。", "en": "Mud runs between my teeth."},
        {"zh": "凝视远方，似乎在思考", "en": "Staring into the distance, as if in thought"},
