        {"zh": "阳光只会加速你的死亡。", "en": "Sunlight only speeds your death."},
        {"zh": "我的血，你的唯一出路。", "en": "My blood, your only escape."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "沼泽的泥，你踩到我了。", "en": "Swamp mud — and you stepped on me."},
        {"zh": "躲开，否则受苦。", "en": "Move, or suffer."},
