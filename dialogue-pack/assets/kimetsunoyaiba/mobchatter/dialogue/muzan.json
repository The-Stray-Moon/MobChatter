    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "气息虚弱了...", "en": "My aura grows weak..."},
        {"zh": "力量衰退...", "en": "My strength fades..."},
        {"zh": "魔力不足...", "en": "Magic is weak..."},
