    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的血味，诱人啊！", "en": "The scent of your blood is alluring."},
        {"zh": "别走，还有更好的！", "en": "Don't go, there's more where that came from."},
        {"zh": "你的血液，是我的珍馐！", "en": "Your blood is a delicacy to me."},
        {"zh": "享受这夜，与我共享！", "en": "Enjoy the night, share it with me!"},
        {"zh": "尝尝我的血之鞭吧！", "en": "Feel the Blood Whip!"},
        {"zh": "来吧，一起吞噬世界！", "en": "Come, let's devour the world together!"},
        {"zh": "黑暗才是我的归宿！", "en": "Darkness is my sanctuary!"},
        {"zh": "你的恐惧，也是我的养分！", "en": "Your fear is my sustenance!"},
        {"zh": "别想逃跑，我已经靠近！", "en": "You can't run, I'm closing in."},
        {"zh": "夜晚才是我们的主场！", "en": "Night is our domain!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的武器，对我无用！", "en": "Your weapons are useless against me!"},
        {"zh": "躲开阳光，太迟了！", "en": "Avoid the sunlight, too late now!"},
        {"zh": "碰撞吧，与我同归于尽！", "en": "Collide with me, into oblivion!"},
        {"zh": "不要碰我，否则受苦！", "en": "Touch me, and you'll suffer!"},
        {"zh": "你打不到我，只能挨打！", "en": "You can't hit me, only be hit!"},
        {"zh": "我的力量，超越常理！", "en": "My power defies logic!"},
        {"zh": "与我硬碰硬，只有死路！", "en": "Facing me head-on, only death awaits!"},
        {"zh": "你的攻击，对我只是小伤！", "en": "Your attacks are mere trifles to me!"},
        {"zh": "阳光下，我依然强大！", "en": "In the sunlight, I remain powerful!"},
        {"zh": "我们本就是破灭的象征！", "en": "We are symbols of annihilation!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找同类，一起统治！", "en": "Find your mate, rule together!"},
        {"zh": "与我共生，共享黑暗！", "en": "Coexist with me, in darkness!"},
        {"zh": "血肉鞭子伸出去，谁敢近身。", "en": "My flesh whips reach out. Who dares come close?"},
        {"zh": "一起毁灭，才是结局！", "en": "Together, we shall be destroyed!"},
        {"zh": "互相吞噬，才能生存！", "en": "Mutual consumption, survival!"},
        {"zh": "我的血，流淌在你身体！", "en": "My blood flows in your veins!"},
        {"zh": "与我结合，共赴死生！", "en": "Unite with me, for life and death!"},
        {"zh": "你将与我，共存或灭亡！", "en": "You will coexist with me, or perish!"},
        {"zh": "我的伴侣，我的永恒！", "en": "My partner, my eternal companion!"},
        {"zh": "共享黑暗，共创未来！", "en": "Share the darkness, create a future!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
