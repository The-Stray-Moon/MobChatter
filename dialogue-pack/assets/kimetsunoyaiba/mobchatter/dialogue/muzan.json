  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "感知到了...猎物。", "en": "Prey... detected."},
        {"zh": "阳光...不是我的朋友。", "en": "Sunlight... not my friend."},
        {"zh": "猎杀...不祥之人。", "en": "Kill... the cursed ones."},
        {"zh": "无尽的战斗，无尽的杀戮。", "en": "Endless battle, endless killing."},
        {"zh": "吞噬你的灵魂...享受吧。", "en": "Consume your soul... enjoy."},
        {"zh": "阳光下，我...最弱。", "en": "In sunlight, I... am weakest."},
        {"zh": "鬼王...我就是...无惨。", "en": "King of the Ghouls... I am... Gion."},
        {"zh": "等待...猎物的到来。", "en": "Wait... for prey."},
        {"zh": "阳光下...消失吧。", "en": "Disappearing... in sunlight."},
        {"zh": "血液...在体内转向。", "en": "The blood turns inside me."},
        {"zh": "我...不留下脚印。", "en": "I leave no footprints."},
        {"zh": "一瞬...已在百米外。", "en": "One blink, a hundred paces away."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "这里...是...我的家。", "en": "Here... is... my home."},
        {"zh": "等待...夜晚的到来。", "en": "Waiting... for night."},
        {"zh": "猎物...总是...那么...难以捉摸。", "en": "Prey... always... so elusive."},
        {"zh": "等待...下一个...猎物。", "en": "Waiting... for the next... prey."},
        {"zh": "夜晚...就是...我的时代。", "en": "Night... is... my era."},
        {"zh": "等待...下一个...猎物出现。", "en": "Waiting... for the next... prey to appear."},
        {"zh": "猎物...总是...那么...难以...捉摸。", "en": "Prey... always... so hard... to catch."},
        {"zh": "等待...下一个...时机。", "en": "Waiting... for the next... opportunity."},
        {"zh": "夜晚...终于...来临。", "en": "Night... finally... comes."},
        {"zh": "血鬼术...在我指间。", "en": "My blood art rests between my fingers."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
