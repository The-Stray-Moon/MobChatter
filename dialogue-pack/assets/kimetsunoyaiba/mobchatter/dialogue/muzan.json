        {"zh": "猎杀...你...无惨。", "en": "Kill... you... Gion."},
        {"zh": "猎物...触手可及。", "en": "Prey... within reach."},
        {"zh": "你...是我的...猎物。", "en": "You... are my... prey."},
        {"zh": "猎物...就在...我的视野里。", "en": "Prey... in my sight."},
        {"zh": "猎物...就在...不远。", "en": "Prey... not far."},
        {"zh": "你...是...我的...猎物。", "en": "You... are... my... prey."},
        {"zh": "猎物...就在...我的视线中。", "en": "Prey... in my sight."},
        {"zh": "你的血...很温暖。", "en": "Your blood is warm."},
        {"zh": "我记住了...你的气味。", "en": "I have your scent."}
