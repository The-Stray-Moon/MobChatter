{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "挥舞着长腿前行", "en": "Swinging long legs forward"},
        {"zh": "发出沙沙声响", "en": "Squeaking with long legs"},
        {"zh": "咬破蛛网前行", "en": "Breaking web with fangs to move"},
        {"zh": "用丝线织网前行", "en": "Weaving silk to move forward"},
        {"zh": "在黑暗中缓缓移动", "en": "Moving slowly in darkness"},
        {"zh": "我沿着树荫挪，躲开那道光。", "en": "I shift along the shade, away from the light."},
        {"zh": "吐丝织网保护自己", "en": "Spinning silk to protect itself"},
        {"zh": "警惕地寻找猎物", "en": "Alertly searching for prey"},
        {"zh": "在夜晚四处游走", "en": "Roving at night"},
        {"zh": "悄悄靠近敌人", "en": "Creeping close to enemies"},
        {"zh": "我的丝线拖过落叶。", "en": "My threads trail over the fallen leaves."},
        {"zh": "我踩着自己的网走，不留声。", "en": "I walk my own web without a sound."},
        {"zh": "我一步步收紧四周的线。", "en": "With each step I draw the lines tighter."},
        {"zh": "我侧身穿过自己织的缝。", "en": "I slip sideways through a gap I wove."},
        {"zh": "我的手指在空气里勾线。", "en": "My fingers hook threads out of the air."},
        {"zh": "我绕着树干走，像在织圈。", "en": "I circle the trunk as if weaving a ring."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静静地站在蛛网上", "en": "Standing quietly on web"},
        {"zh": "舔舐着长长的丝线", "en": "Licking long silk strands"},
        {"zh": "缓慢呼吸着夜气", "en": "Breathing slowly at night"},
        {"zh": "我一动不动，只让丝轻轻颤。", "en": "I stay still and let only the silk tremble."},
        {"zh": "享受微风吹过", "en": "Enjoying the breeze"},
        {"zh": "吐丝织造复杂的网", "en": "Spinning complex webs with silk"},
        {"zh": "整理自己的丝网家园", "en": "Organizing its silk home"},
        {"zh": "在空中轻轻摇曳", "en": "Swinging lightly in the air"},
        {"zh": "享受寂静的夜晚", "en": "Enjoys the silent night"},
        {"zh": "我垂在丝上，等风带来气味。", "en": "I hang on a thread and let the wind bring a scent."},
        {"zh": "我把一根断线接回去。", "en": "I tie a broken thread back together."},
        {"zh": "我数着网上还挂着什么。", "en": "I count what's still caught in my web."},
        {"zh": "我在等月亮移到树梢。", "en": "I wait for the moon to reach the treetops."},
        {"zh": "我把丝绕在指尖上玩。", "en": "I wind a thread around my fingertip."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉玩家踪迹", "en": "Noticing player's presence"},
        {"zh": "迅速锁定目标", "en": "Quickly locking on target"},
        {"zh": "瞄准玩家进行攻击", "en": "Aiming at player to attack"},
        {"zh": "蛛丝已经连在你脚上。", "en": "My thread is already on your ankle."},
        {"zh": "蛛丝已经绕到你脚边。", "en": "My spider silk is already at your feet."},
        {"zh": "缓缓靠近玩家", "en": "Creeping closer to player"},
        {"zh": "准备发动攻击", "en": "Preparing to attack"},
        {"zh": "我从丝上垂下来，朝你嘶了一声。", "en": "I drop lower on a thread and hiss at you."},
        {"zh": "快速拉紧丝线", "en": "Tightening silk quickly"},
        {"zh": "准备束缚玩家", "en": "Preparing to bind player"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "蛛丝缠身，动弹不得！", "en": "Tangled in silk, can't move!"},
        {"zh": "伤口渗出血水，痛！", "en": "Wound oozing blood, hurts!"},
        {"zh": "腹部被击中，疼痛！", "en": "Abdomen hit, hurts!"},
        {"zh": "触角受伤，影响视力！", "en": "Feelers hurt, vision impaired!"},
        {"zh": "关节受损，行动不便！", "en": "Joint damaged, movement impaired!"},
        {"zh": "背部中招，很疼！", "en": "Back hit, painful!"},
        {"zh": "腿部受创，行走困难！", "en": "Legs hurt, walking difficult!"},
        {"zh": "腹部破皮，急需疗伤！", "en": "Abdomen injured, need treatment!"},
        {"zh": "丝断了，我从半空摔进落叶。", "en": "The thread snaps; I fall into the leaves."},
        {"zh": "蜘蛛丝断裂，自由了！", "en": "Silk breaks, free!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠近我，就等同于送死！", "en": "Get closer, and you die!"},
        {"zh": "尝尝我的蛛丝吧！", "en": "Feel my silk!"},
        {"zh": "你散发的气息，令我感到愉悦！", "en": "Your aura pleases me."},
        {"zh": "不要靠近我的家！", "en": "Don't come near my home!"},
        {"zh": "血液的味道如此诱人！", "en": "Blood so delicious!"},
        {"zh": "我的丝线缠绕你！", "en": "My silk binds you!"},
        {"zh": "你身上的血，是我的奖赏！", "en": "Your blood is my prize!"},
        {"zh": "享受你的恐惧吧！", "en": "Enjoy your fear!"},
        {"zh": "靠近我，你会死得很惨！", "en": "You'll die horribly close to me!"},
        {"zh": "我的丝线，是死亡的序幕！", "en": "My silk is death's prologue!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "蛛网横在林子中间，绕开。", "en": "My web spans the woods. Go around."},
        {"zh": "我讨厌你靠近我！", "en": "I hate you getting near me!"},
        {"zh": "你触碰了我，必死无疑！", "en": "You touched me, you die!"},
        {"zh": "滚开，别挡我！", "en": "Get out of my way!"},
        {"zh": "你破坏了我的安宁！", "en": "You disturbed my peace!"},
        {"zh": "你挡在蛛网前，我看不见猎物。", "en": "You stand before my web and block my prey."},
        {"zh": "我的丝线束缚了你！", "en": "My silk binds you!"},
        {"zh": "那根丝连着我的巢，别碰。", "en": "That thread leads to my nest. Do not touch it."},
        {"zh": "蛛丝已经绕上你的脚了。", "en": "My threads are already around your ankles."},
        {"zh": "不要打扰我的狩猎！", "en": "Don't disturb my hunt!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我需要你来繁衍！", "en": "Mate with me!"},
        {"zh": "蛛丝缠住你，就在这。", "en": "Threads wrap you right here."},
        {"zh": "你愿意成为我的配偶吗？", "en": "Willing to be my mate?"},
        {"zh": "我们是同类，应该结合！", "en": "We are of the same kind, should unite!"},
        {"zh": "来吧，让我们一起繁殖！", "en": "Come, let's breed together!"},
        {"zh": "我需要一个配偶来繁衍！", "en": "I need a mate to breed!"},
        {"zh": "你愿意与我一起繁衍吗？", "en": "Willing to breed with me?"},
        {"zh": "让我们一起繁衍后代！", "en": "Let's breed offspring together!"},
        {"zh": "蛛丝一牵，你就是家人。", "en": "One tug of silk and you're family."},
        {"zh": "繁衍是我们的责任！", "en": "Breeding is our duty!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "蛛丝缠身，血肉之躯！", "en": "Spider silk binds you!"},
        {"zh": "无惨之血，我主的馈赠！", "en": "Blessing of the Desolate Lord!"},
        {"zh": "阳光之下，你将灭亡！", "en": "Sunlight will burn you!"},
        {"zh": "吞噬鬼杀队的魂魄！", "en": "Soul devoured!"},
        {"zh": "这肉身，足够做祭品！", "en": "Perfect sacrifice!"},
        {"zh": "咬破它的皮囊！", "en": "Bite through its skin!"},
        {"zh": "蛛丝缠住手腕，别挣。", "en": "Silk binds your wrist; don't pull."},
        {"zh": "鲜血，才是最好的燃料！", "en": "Blood is the best fuel!"},
        {"zh": "夜幕降临，我将苏醒！", "en": "Night falls, I awaken!"},
        {"zh": "鬼杀队，今日必灭！", "en": "Sunshine will end the Sunslayers!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物落入我的网！", "en": "Prey in my web!"},
        {"zh": "感知到猎物的气息！", "en": "Prey's scent detected!"},
        {"zh": "猎物的味道，真美妙！", "en": "The prey's scent, so delicious!"},
        {"zh": "你跑不掉的，鬼杀队！", "en": "You can't escape, Sunslayers!"},
        {"zh": "蛛丝已经铺好了。", "en": "My spider silk is already laid."},
        {"zh": "风里有活人的味道，很近了。", "en": "There is living scent in the wind, very near."},
