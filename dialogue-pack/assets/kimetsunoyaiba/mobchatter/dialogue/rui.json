        {"zh": "蛛丝已经连上你的脚踝。", "en": "My silk already binds your ankles."},
        {"zh": "猎物就在我的掌握之中！", "en": "Prey is in my grasp!"},
        {"zh": "你踩断了我一根丝。", "en": "You snapped one of my threads."},
        {"zh": "鬼杀队的呼吸我认得。", "en": "I know a Demon Slayer's breathing."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我将撕裂你的躯体！", "en": "I will tear your flesh!"},
        {"zh": "用蛛丝束缚你！", "en": "Bind you with silk!"},
        {"zh": "你将会是我的猎物！", "en": "You will be my prey!"},
        {"zh": "血鬼术，将你束缚！", "en": "Bloodbound by my術!"},
