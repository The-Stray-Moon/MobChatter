        {"zh": "我们同为猎手！", "en": "We're fellow hunters!"},
        {"zh": "找伙伴，合作生存！", "en": "Find a mate, survive together!"},
        {"zh": "变成鬼，我们也算同类。", "en": "As a demon, we count as kin."},
        {"zh": "捕猎伙伴，共享猎物！", "en": "Hunting partner, share prey!"},
        {"zh": "同类，共同生存！", "en": "Mate, live together!"},
        {"zh": "找我，我们可以合作！", "en": "Find me, we can work together!"},
        {"zh": "同类，一起行动！", "en": "Mate, act together!"},
        {"zh": "与我结伴，共同狩猎！", "en": "Join me, hunt together!"},
        {"zh": "找同类，互相帮助！", "en": "Find your kind, help each other!"}
      ]
    },
