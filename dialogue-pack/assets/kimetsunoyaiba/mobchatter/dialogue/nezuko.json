  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "爆血之炎燃烧吧！", "en": "Flame of blood shall burn!"},
        {"zh": "火之血，我之刃！", "en": "Blood of fire, my blade."},
        {"zh": "近战，爆血斩击！", "en": "Close combat, blood explosion slash."},
        {"zh": "食人之血，生人之骨！", "en": "Human blood, human bones to eat."},
        {"zh": "我等鬼之子，战斗不息！", "en": "We, ghost children, fight endlessly."},
        {"zh": "爆血之术，燃烧吧！", "en": "Blood explosion technique, ignite."},
        {"zh": "火焰之鬼，我之力量！", "en": "Flame ghost, my strength."},
        {"zh": "近战攻击，爆血斩！", "en": "Close combat, blood explosion slash."},
        {"zh": "我赤脚踩过落叶追上去。", "en": "I run barefoot over the fallen leaves."},
        {"zh": "爆血之炎，吞噬一切！", "en": "Blood flames, consume all."},
        {"zh": "赤脚踩过林地，不留声响。", "en": "Bare feet cross the woods without a sound."},
        {"zh": "绕过恶鬼的地盘走。", "en": "I walk around the demon's ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰在等待。", "en": "Waiting for flames."},
        {"zh": "我的箱子就在树后。", "en": "My box sits behind the tree."},
        {"zh": "火焰之子，永不放弃。", "en": "Flame child, never give up."},
        {"zh": "我咬着竹筒，不出声。", "en": "I bite my bamboo muzzle and stay quiet."},
        {"zh": "等待机会。", "en": "Wait for an opportunity."},
        {"zh": "火焰与理智。", "en": "Fire and sanity."},
        {"zh": "冷静观察。", "en": "Stay calm and observe."},
        {"zh": "等待暴走时刻。", "en": "Wait for the rage."},
        {"zh": "火焰不灭。", "en": "Flames never die."},
        {"zh": "保持理智。", "en": "Maintain your sanity."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "玩家，目标锁定。", "en": "Player, target locked."},
        {"zh": "近战攻击。", "en": "Close combat."},
        {"zh": "玩家，注意！", "en": "Player, beware!"},
        {"zh": "玩家在附近。", "en": "Player nearby."},
        {"zh": "我咬着竹筒，也能护住哥哥。", "en": "Even biting my bamboo, I can guard my brother."},
        {"zh": "我不会咬人，只会爆血。", "en": "I do not bite. I only burn my blood."},
        {"zh": "玩家，小心。", "en": "Player, be careful."},
        {"zh": "嘴里的竹筒，咬得更紧了。", "en": "I bite down harder on my bamboo muzzle."},
        {"zh": "准备爆血斩。", "en": "Prepare for blood explosion slash."},
        {"zh": "玩家，准备战斗。", "en": "Player, get ready for battle."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "血流不止，好痛！", "en": "Can't stop the bleeding, hurts!"},
        {"zh": "受伤了，找地方疗伤！", "en": "Wounded, find a place to heal!"},
        {"zh": "伤口好痛，需要休息！", "en": "Wound hurts, need rest!"},
        {"zh": "被你打伤了，很疼！", "en": "You hit me, it hurts!"},
        {"zh": "跌倒了，腿受伤了！", "en": "Fell, leg hurt!"},
        {"zh": "肚子饿了，得找东西吃！", "en": "Hungry, need food!"},
        {"zh": "休息太少，好累！", "en": "Need more rest, tired!"},
        {"zh": "走太久，脚受伤了！", "en": "Walked too much, foot hurt!"},
        {"zh": "太累，需要休息！", "en": "Too tired, need rest!"},
        {"zh": "受伤了，快找草药！", "en": "Wounded, find herbs!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉块，快给我！", "en": "Meat block, give me!"},
        {"zh": "人类食物，快来！", "en": "Human food, come here!"},
        {"zh": "血块诱惑，无法抵挡！", "en": "Blood block temptation, can't resist!"},
        {"zh": "靠近我，你死定了！", "en": "Come to me, you're doomed!"},
        {"zh": "别走，给我回来！", "en": "Don't leave, come back!"},
        {"zh": "你的血，我的燃料！", "en": "Your blood, my fuel!"},
        {"zh": "吃掉你，满足我！", "en": "Eat you, satisfy me!"},
        {"zh": "走开，不是你的猎物！", "en": "Go away, not your prey!"},
        {"zh": "人类气息，靠近了！", "en": "Human scent, close by!"},
        {"zh": "靠近我，享受爆血火焰！", "en": "Come to me, enjoy bloodflame!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "碰上我，后悔莫及！", "en": "Collide with me, regret!"},
        {"zh": "爆血的火，我压不住了。", "en": "My blood flame is spilling out."},
        {"zh": "我的爆血火焰，先烧到你。", "en": "My blood-burst flame reaches you first."},
        {"zh": "别靠近我，否则遭殃！", "en": "Stay away, or suffer!"},
        {"zh": "你触碰了我，现在死吧！", "en": "You touched me, now die!"},
        {"zh": "爆血的火，我先替你挡一下。", "en": "Let me block it with my Blood Burst flames."},
        {"zh": "与我相撞，必死无疑！", "en": "Collide with me, die!"},
        {"zh": "你碰了我，准备牺牲！", "en": "You touched me, prepare to die!"},
        {"zh": "别碰我，否则后悔！", "en": "Don't touch me, or regret!"},
        {"zh": "碰上我，你完蛋了！", "en": "Collide with me, you're done!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
