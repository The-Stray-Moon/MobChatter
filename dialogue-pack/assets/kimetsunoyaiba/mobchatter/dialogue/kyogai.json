{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "鼓声隆隆响凯行", "en": "Drumming resounds,响凯 walks"},
        {"zh": "黑夜之鼓，追影行", "en": "Night's drum, chasing shadows"},
        {"zh": "避光而行，夜之灵", "en": "Avoids light, night's spirit"},
        {"zh": "敲击战鼓，踏夜行", "en": "Beats war drums, walks through night"},
        {"zh": "黑暗中行，鼓声不绝", "en": "Walks in darkness, drumming never ends"},
        {"zh": "避日而行，夜幕降临", "en": "Avoids day, emerges at nightfall"},
        {"zh": "鼓声引导，黑暗前行", "en": "Drum leads, through the dark"},
        {"zh": "幽冥鼓声，响凯行走", "en": "Ghostly drums,响凯 walks"},
        {"zh": "敲鼓行，夜行鬼", "en": "Beats drum, nocturnal ghost"},
        {"zh": "避光夜行，鼓声不息", "en": "Avoids light, drumming at night"},
        {"zh": "鼓声推着我，一步步逼近。", "en": "The drums push me, step by step."},
        {"zh": "我避开月光，绕墙而行。", "en": "I skirt the moonlit wall."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静夜鼓声悠", "en": "Drumming in the still night"},
        {"zh": "鼓声默响，静夜中", "en": "Silent drumming in the night"},
        {"zh": "鼓寂无声，夜未央", "en": "Drum falls silent, night continues"},
        {"zh": "夜深人静，鼓声起", "en": "Drumming starts in the deep night"},
        {"zh": "鼓寂无人，夜之灵", "en": "Silent drum, night's spirit"},
        {"zh": "静夜之中，鼓声轻", "en": "Night's quiet drumming"},
        {"zh": "夜深鼓声轻", "en": "Drumming soft in the night"},
        {"zh": "静夜鼓声，夜之息", "en": "Drumming in the still night"},
        {"zh": "鼓声悠扬，夜未央", "en": "Drumming softly, night continues"},
        {"zh": "夜静鼓声轻", "en": "Drumming quietly at night"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉猎物，夜幕低垂", "en": "Notices prey, dusk falls"},
        {"zh": "目光锁定，夜行者", "en": "Focuses on the night traveler"},
        {"zh": "目光锐利，夜中行", "en": "Sharp eyes in the night"},
        {"zh": "锁定目标，夜之猎手", "en": "Locks onto prey, night hunter"},
        {"zh": "视线锁定，夜中鬼", "en": "Focuses, night ghost"},
        {"zh": "目光如炬，夜中行", "en": "Glinting eyes in the night"},
        {"zh": "夜中窥视，鼓声起", "en": "Nightly vigil, drums sound"},
        {"zh": "目光闪烁，夜之影", "en": "Glimpses in the night, shadow"},
        {"zh": "锁定目标，夜行者", "en": "Focuses on the traveler"},
        {"zh": "鬼杀队的刀，我看清了。", "en": "A Demon Slayer's blade; I see it clearly."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "响凯被刺伤了！", "en": "Yakagi is wounded!"},
        {"zh": "响凯受了伤！", "en": "Yakagi is injured!"},
        {"zh": "响凯身体受创！", "en": "Yakagi has a wound!"},
        {"zh": "响凯被割伤了！", "en": "Yakagi is cut!"},
        {"zh": "响凯被撞伤了！", "en": "Yakagi is bumped!"},
        {"zh": "响凯受伤了！", "en": "Yakagi is injured!"},
        {"zh": "响凯被咬伤了！", "en": "Yakagi is bitten!"},
        {"zh": "响凯被击中了！", "en": "Yakagi is hit!"},
        {"zh": "响凯被撞倒了！", "en": "Yakagi is knocked down!"},
        {"zh": "响凯身体受损！", "en": "Yakagi is damaged!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "听见鼓声便无法抗拒！", "en": "Can't resist the drum's call!"},
        {"zh": "靠近我，尝尝血鬼术！", "en": "Come closer, feel the blood magic!"},
        {"zh": "鼓声一响，屋子就转过来。", "en": "One drumbeat and the room turns over."},
        {"zh": "别躲开，让我敲醒你！", "en": "Don't dodge, let me awaken you!"},
        {"zh": "鼓一敲，这间屋子就转过身。", "en": "One drumbeat and this room turns."},
        {"zh": "鼓声中有着无尽力量！", "en": "In the drum, endless power!"},
        {"zh": "你听，鼓声在召唤！", "en": "Hear the drum's call!"},
        {"zh": "夜晚降临，我更强！", "en": "Nightfall, I grow stronger!"},
        {"zh": "吃我一鼓！", "en": "Drum on you!"},
        {"zh": "敲鼓，你就翻个面。", "en": "One drumbeat flips you over."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "碰撞即为战斗！", "en": "Collision is combat!"},
        {"zh": "鼓一敲，你就翻个跟头。", "en": "One drumbeat and you're tumbling."},
        {"zh": "躲开，否则挨鼓！", "en": "Dodge, or get drummed!"},
        {"zh": "鼓击翻你！", "en": "Drum toss!"},
        {"zh": "鼓槌被你撞掉了。", "en": "You knocked the drumstick from my hand."},
        {"zh": "别碰我的鼓！", "en": "Don't touch my drum!"},
        {"zh": "鼓面一震，地板翻起来。", "en": "One strike of the drum and the floor flips."},
        {"zh": "鼓声中反击！", "en": "Counter with the drum!"},
        {"zh": "躲开阳光，否则...", "en": "Avoid the light, or..."},
        {"zh": "你离我不远！", "en": "You're not far!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这宅子里，只有鼓陪着我。", "en": "In this house, only the drums keep me company."},
        {"zh": "我敲一声，等一声回音。", "en": "I strike once and wait for an answer."},
        {"zh": "与我共舞，鼓声伴奏！", "en": "Dance with me, drums accompany!"},
        {"zh": "寻找你的灵魂伴侣！", "en": "Find your soulmate!"},
        {"zh": "下弦的席位没了，我还是鬼。", "en": "My Lower Moon seat is gone; I am still a demon."},
        {"zh": "鼓中的爱情之音！", "en": "Love's drum beats!"},
        {"zh": "互相呼应，鼓声共鸣！", "en": "Echo through the drums!"},
        {"zh": "我的同类，一起战斗！", "en": "My kind, fight together!"},
        {"zh": "鼓中蕴含爱的力量！", "en": "Drums hold love's power!"},
        {"zh": "下弦之陆的席位，早被收回。", "en": "My Lower Moon seat was taken long ago."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我感受到你的魂魄!", "en": "I sense your spirit!"},
        {"zh": "你的血，是我新鼓皮!", "en": "Your blood, new skin for my drum!"},
        {"zh": "魂归鼓中，重生!", "en": "Spirits into the drum, reborn!"},
        {"zh": "食者，成鼓鬼!", "en": "Eater, become a drum ghost!"},
        {"zh": "阳光下，我不复存在!", "en": "Under sunlight, I vanish!"},
        {"zh": "夜，我的盛宴!", "en": "Night, my feast!"},
        {"zh": "驱散阳光，我将更强!", "en": "Drive away the sun, and I grow stronger!"},
        {"zh": "猎物近了，鼓声为号!", "en": "Prey near, drum sounds the alarm!"},
        {"zh": "击鼓，击碎你的心!", "en": "Drum beats, shatter your heart!"},
        {"zh": "吞下阳光，活死人!", "en": "Swallow the sun, living dead!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你逃不掉!", "en": "You cannot escape!"},
        {"zh": "鼓中力量，我觉醒!", "en": "Drum power, I awaken!"},
        {"zh": "猎物，我来了!", "en": "Prey, I come for you!"},
        {"zh": "血鬼术，施加于你!", "en": "Blood magic, upon you!"},
        {"zh": "鼓声，我灵魂的呼唤!", "en": "Drum sound, my soul's call!"},
        {"zh": "你，为我鼓皮!", "en": "You, for my drum skin!"},
        {"zh": "猎物，颤抖吧!", "en": "Prey, tremble!"},
        {"zh": "我将吞噬你!", "en": "I will consume you!"},
        {"zh": "你逃不出我的鼓声!", "en": "You cannot escape my drum sound!"},
        {"zh": "夜幕下，你无所遁形!", "en": "In the night, nowhere to hide!"},
        {"zh": "敲一下鼓，房间就转过来。", "en": "One beat and the room turns."},
        {"zh": "你站的位置，由我决定。", "en": "Where you stand is my decision."},
        {"zh": "血鬼术起，鼓面应我。", "en": "My Blood Demon Art rises; the drumheads answer."},
        {"zh": "被逐出十二鬼月，我仍会杀人。", "en": "Cast out from the Twelve, I still kill."},
        {"zh": "刀再快，也追不上鼓点。", "en": "Your blade is fast; my beat is faster."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "阳光下，我沉默!", "en": "Under the sun, I am silent!"},
        {"zh": "你无法躲避我!", "en": "You cannot evade me!"},
        {"zh": "鼓声引你而来!", "en": "Drum sound draws you here!"},
        {"zh": "你的灵魂属于我!", "en": "Your soul belongs to me!"},
        {"zh": "鼓中的力量，我释放!", "en": "Drum power, I unleash!"},
        {"zh": "你将被我的鼓声击倒!", "en": "You will fall to my drum!"},
        {"zh": "阳光下，我隐匿!", "en": "Under the sun, I hide!"},
        {"zh": "你，将被我击碎!", "en": "You will be shattered by me!"},
        {"zh": "鼓中之魂，我将你囚禁!", "en": "Drum spirit, I cage you!"},
        {"zh": "你，是下一个!", "en": "Next, you are!"},
        {"zh": "鼓一响，天地翻个个儿。", "en": "One beat and the world flips over."},
        {"zh": "你离我太近，正合我意。", "en": "You are too close, just as I want."},
        {"zh": "我敲胸口这面，你就飞出去。", "en": "I strike the drum on my chest; you fly."},
        {"zh": "鼓声换位，你眼睛跟不上。", "en": "The beat swaps rooms faster than your eyes."},
        {"zh": "落地之前，我再敲一次。", "en": "Before you land, I strike again."},
        {"zh": "百点血的我，不怕挨刀。", "en": "With a hundred health, I can take a blade."},
        {"zh": "别踩那块地板，会翻。", "en": "Don't step on that floor; it flips."},
        {"zh": "你举刀，我敲鼓，谁快？", "en": "You raise the blade, I strike; who's faster?"},
        {"zh": "我把你按在鼓面上。", "en": "I press you against the drumhead."},
        {"zh": "鼓声连着鼓声，你站不住。", "en": "Beat after beat, you cannot stand."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "鼓声震颤，响凯来袭！", "en": "Drum echoes, Kyo arrives!"},
        {"zh": "近战时，躲避阳光！", "en": "Avoid the sun in melee!"},
        {"zh": "响凯怒吼，鼓震四方！", "en": "Kyo roars, drums shake all around!"},
        {"zh": "鼓声催动，鬼舞翩翩！", "en": "Drums stir, ghosts dance!"},
        {"zh": "敲鼓生灵，倒下吧！", "en": "Drums strike, fall down!"},
        {"zh": "响凯的鼓，击退敌人！", "en": "Kyo's drum repels the enemy!"},
        {"zh": "避光而战，方能生存！", "en": "Survive by avoiding the light!"},
        {"zh": "响凯之鼓，击飞邪恶！", "en": "Kyo's drum, flies the evil!"},
        {"zh": "鼓声之中，力量倍增！", "en": "Drums boost strength!"},
        {"zh": "敲击鼓面，敌人倒地！", "en": "Hit the drum, enemies fall!"},
        {"zh": "鼓槌先砸你的手腕。", "en": "My drumstick hits your wrist first."},
        {"zh": "一击敲鼓，把你掀上天。", "en": "One beat throws you skyward."},
        {"zh": "我贴身敲，声浪打在胸口。", "en": "I strike up close and the wave hits your chest."},
        {"zh": "鼓面震裂，碎片割你的脸。", "en": "The drumhead splits and shards cut your face."},
        {"zh": "你落地，我的爪已在等。", "en": "You land; my claws are waiting."},
        {"zh": "利爪顺着你的刀背摸上来。", "en": "My claws slide up the back of your blade."},
        {"zh": "我敲侧面那面，墙撞你。", "en": "I strike the side drum and the wall hits you."},
        {"zh": "鼓声一停，我的牙就到了。", "en": "The beat stops, and my teeth arrive."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "夜幕降临，响凯现身！", "en": "Kyo appears at night!"},
        {"zh": "鼓声中，响凯觉醒！", "en": "Kyo awakens in drums!"},
        {"zh": "夜间，响凯的呼唤！", "en": "Kyo's call at night!"},
        {"zh": "原下弦之陆的鬼灵！", "en": "Soul of the old moon!"},
        {"zh": "响凯的鼓声，召唤同伴！", "en": "Kyo's drum calls companions!"},
        {"zh": "鼓声中，响凯现身！", "en": "Kyo appears in drums!"},
        {"zh": "鼓声为号，夜袭开始！", "en": "Drums signal the night attack!"},
        {"zh": "响凯的鼓，指引方向！", "en": "Kyo's drum, guides the way!"},
        {"zh": "鬼杀队小心，响凯来袭！", "en": "Watch out, Demon Slayer team! Kyo!"},
        {"zh": "鼓声里，响凯的怒吼！", "en": "Drums, Kyo's roar!"},
        {"zh": "夜色够浓，鼓才有回声。", "en": "The night is thick enough for drums to echo."},
        {"zh": "我在废弃的宅子里敲第一下。", "en": "I strike the first beat in the ruined house."},
        {"zh": "阳光退场，响凯上台。", "en": "The sun exits; Kyogai takes the stage."},
        {"zh": "敲鼓声先到，我才到。", "en": "The drumbeat arrives before I do."}
      ]
    },
