    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "挥舞着剑，风声呼啸。", "en": "Swinging sword, wind howls."},
        {"zh": "发出冷冽的笑声。", "en": "Cold laugh echoes."},
        {"zh": "凝视着玩家，准备攻击。", "en": "Staring at the player, ready to attack."},
        {"zh": "低沉地嘶吼一声。", "en": "Rumbles a low growl."},
        {"zh": "剑刃划破空气。", "en": "Blade slices air."},
        {"zh": "用剑劈向地面。", "en": "Swings sword at ground."},
        {"zh": "轻盈地在空中滑行。", "en": "Fades through air."},
        {"zh": "突然出现在玩家身后。", "en": "Appears behind the player."},
        {"zh": "挥剑砍向敌人。", "en": "Swing sword at enemy."},
        {"zh": "以剑刃轻触地面。", "en": "Runs blade along ground."},
        {"zh": "我步法轻移，衣角带风。", "en": "My steps glide, my sleeve trailing wind."},
        {"zh": "我踩着呼吸的节拍走。", "en": "I walk to the rhythm of my breathing."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "低头整理剑鞘。", "en": "Adjusts scabbard."},
