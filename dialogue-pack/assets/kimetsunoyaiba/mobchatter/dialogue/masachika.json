    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "汲取了死灵能量，光芒微弱！", "en": "Absorbed necrotic energy, faint glow."},
        {"zh": "我的剑刃沾满了恶鬼的鲜血！", "en": "My blade is drenched in fiendish blood."},
        {"zh": "桑岛的风之呼吸，永世守护！", "en": "Masachika's Breath of the Wind, eternal defense."},
