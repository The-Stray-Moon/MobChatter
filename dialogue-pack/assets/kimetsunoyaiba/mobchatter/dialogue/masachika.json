        {"zh": "目光在玩家身上停留。", "en": "Eyes linger on player."},
        {"zh": "我听见你喉咙里的吞咽声。", "en": "I hear you swallow."},
        {"zh": "目光闪烁，如刀锋般锐利。", "en": "Sharp gaze, like a blade."},
        {"zh": "目光如鹰般锐利。", "en": "Eagle-like gaze."},
        {"zh": "目光紧锁玩家。", "en": "Locked on player."},
        {"zh": "目光如炬，寻找玩家。", "en": "Fierce gaze, seeking player."},
        {"zh": "目光凶狠，锁定玩家。", "en": "Fiery gaze, on player."}
      ]
