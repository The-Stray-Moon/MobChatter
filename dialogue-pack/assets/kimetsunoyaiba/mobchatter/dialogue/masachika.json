    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你靠近了我，正亲的弟子感受到威胁。", "en": "You're getting too close, Masachika's disciple senses danger."},
        {"zh": "尝尝我的剑吧，正亲的弟子。", "en": "Feel my sword, Masachika's disciple."},
        {"zh": "风之呼吸的斩击很细。", "en": "My Wind Breathing slash is razor thin."},
        {"zh": "正亲的弟子不会轻易放弃。", "en": "Masachika's disciple won't let go easily."},
        {"zh": "桑岛弟子，展示你的力量吧。", "en": "Show your strength, Island Apprentice."},
        {"zh": "我的护甲挡住了你的攻击。", "en": "My armor blocked your attack."},
        {"zh": "正亲的弟子不会惧怕你。", "en": "Masachika's disciple fears not you."},
        {"zh": "正亲的弟子守护着这片土地。", "en": "Masachika's disciple guards this land."},
        {"zh": "我的剑技不会轻易败下阵来。", "en": "My sword technique won't yield easily."},
        {"zh": "正亲的弟子在此守护。", "en": "Masachika's disciple guards here."}
      ]
    },
