        {"zh": "静静站立，等待机会。", "en": "Stands still, waiting."},
        {"zh": "风之呼吸，先把气沉下去。", "en": "Wind Breathing. Let the breath settle."},
        {"zh": "目光紧锁远处。", "en": "Stares into distance."},
        {"zh": "手指轻弹剑柄。", "en": "Fingers tap hilt."},
        {"zh": "风之呼吸的起手，我先站稳。", "en": "Wind Breathing opens; first I plant my feet."}
      ]
    },
