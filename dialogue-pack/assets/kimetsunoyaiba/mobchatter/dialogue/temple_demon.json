{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，阴影中显现狰狞面孔。", "en": "Sssss, a horrifying face appears in the shadow."},
        {"zh": "寒风吹过，长袍随风舞动。", "en": "Cold wind blows, robe swaying in the breeze."},
        {"zh": "恶鬼低语，口中吐出阴冷气息。", "en": "Evil whispers, exuding cold breath."},
        {"zh": "夜色中移动，如同幽灵般无声。", "en": "Moves in the night, like a ghost, silently."},
        {"zh": "紧闭双眼，似乎在寻找猎物。", "en": "Closes eyes, searching for prey."},
        {"zh": "口中鲜血滴落，发出咯咯笑声。", "en": "Blood drips from mouth, cackling."},
        {"zh": "挥舞利爪，阴影中露出獠牙。", "en": "Swings claws, fangs visible in the shadow."},
        {"zh": "低吼一声，阴影里的双眼亮起。", "en": "Roars, eyes glowing in the shadow."},
        {"zh": "阴风中飘荡，如同死亡的使者。", "en": "Flutters in the cold wind, like a death messenger."},
        {"zh": "长袍飘扬，仿佛在舞蹈。", "en": "Robe billows, as if in a dance."},
        {"zh": "赤脚踩过寺庙的石阶", "en": "Bare feet cross the temple steps"},
        {"zh": "长袍扫过断裂的佛像", "en": "My robe brushes a broken statue"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "懒洋洋地站立，目光空洞。", "en": "Stands lazily, hollow eyes."},
        {"zh": "啃咬着腐烂的骨头。", "en": "Chews on rotting bones."},
        {"zh": "我数着柱子上的裂纹。", "en": "I count the cracks in the pillars."},
        {"zh": "我摸着脖子上那串珠子。", "en": "I touch the beads on my neck."},
        {"zh": "低头舔舐利爪。", "en": "Licks its sharp claws."},
        {"zh": "缓缓踱步，寻找猎物。", "en": "Strolls slowly, searching for prey."},
        {"zh": "发出呜咽般的哭泣声。", "en": "Sobs softly."},
        {"zh": "目光盯着某个地方。", "en": "Stares at something."},
        {"zh": "阴冷的气息弥漫四周。", "en": "Cold breaths fill the air."},
        {"zh": "发出嘶嘶声，仿佛在咒骂。", "en": "Sssss, as if cursing."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "盯紧玩家，露出獠牙。", "en": "Fixes on the player, fangs bared."},
        {"zh": "猛然一跃，向玩家扑去。", "en": "Jumps suddenly, lunging at the player."},
        {"zh": "挥舞利爪，准备攻击。", "en": "Swings claws, ready to attack."},
        {"zh": "靠近玩家，试图吸引注意。", "en": "Draws near, trying to get attention."},
        {"zh": "目光闪烁，似乎在策划。", "en": "Eyes flicker, plotting."},
        {"zh": "紧盯着玩家，不放过任何动静。", "en": "Stares intently, not missing a movement."},
        {"zh": "发出阴冷笑声，步步紧逼。", "en": "Cackles coldly, closing in."},
        {"zh": "伸长脖子，试图更好地观察。", "en": "Stretches neck, trying to see better."},
        {"zh": "目光紧锁玩家，威胁意味浓厚。", "en": "Stares down the player, with threat."},
        {"zh": "嘶嘶低语，似乎在警告。", "en": "Sssss, as if warning."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "惨叫一声，双翼鲜血淋漓。", "en": "Screams in agony, wings covered in blood."},
        {"zh": "嘶嘶地惨叫，身体逐渐变得暗淡。", "en": "Screams, body slowly fading."},
        {"zh": "发出悲鸣，翅膀和皮肤被撕裂。", "en": "Howls in pain, wings and skin torn."},
        {"zh": "一声凄厉的惨叫，翅膀血肉模糊。", "en": "Screeches in agony, wings bloody."},
        {"zh": "悲鸣中夹杂着痛苦的叫声。", "en": "Howls with agony."},
        {"zh": "喉咙嘶哑，挣扎中发出痛苦的声音。", "en": "Screams hoarsely, in agony."},
        {"zh": "尖锐的惨叫中夹杂着血肉声。", "en": "Screeches, flesh tearing."},
        {"zh": "痛苦的叫声中，身体逐渐消散。", "en": "Screams, body fading."},
        {"zh": "惨叫，翅膀和皮肤被割破。", "en": "Screams, wings and skin cut."},
        {"zh": "悲鸣声中，身体多处被割伤。", "en": "Howls, body mutilated."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "诱惑你坠入黑暗吧！", "en": "Fall into darkness, mortal!"},
        {"zh": "被欲望吞噬！", "en": "Consumed by desire!"},
        {"zh": "你身上的体温太香了。", "en": "The warmth of you smells too sweet."},
        {"zh": "陷入我的诅咒！", "en": "Fall under my curse!"},
        {"zh": "香灰落在你的肩上。", "en": "Incense ash falls on your shoulder."},
        {"zh": "供品放久了，不如你。", "en": "The offerings are stale, unlike you."},
        {"zh": "你无法逃离！", "en": "You can’t escape!"},
        {"zh": "庙里的香火还没灭，你就来了。", "en": "The temple incense still burns, and here you are."},
        {"zh": "服从黑暗吧！", "en": "Obey the darkness!"},
        {"zh": "你将与我同在！", "en": "You will be with me!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "避开我的利爪！", "en": "Avoid my claws!"},
        {"zh": "你撞上我发凉的胳膊。", "en": "You bump my cold arm."},
        {"zh": "撞击无法让我停下！", "en": "Impacts won’t stop me!"},
        {"zh": "碰上我就是你的命！", "en": "Meeting me is your end!"},
        {"zh": "这寺庙的香火归我。", "en": "The incense of this temple belongs to me."},
        {"zh": "你撞不到我心中！", "en": "You can’t hit my heart!"},
        {"zh": "寺里的钟一响，我就撞过去。", "en": "When the temple bell rings, I charge."},
        {"zh": "我的怒火无人能挡！", "en": "My rage is unstoppable!"},
        {"zh": "我不会被轻易击败！", "en": "I won’t be easily defeated!"},
        {"zh": "我的爪子可不长眼！", "en": "My claws are relentless!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "庙里的香火，我闻了几十年。", "en": "I have smelled this temple's incense for decades."},
        {"zh": "庙里的钟，好久没响。", "en": "The temple bell hasn't rung in years."},
        {"zh": "我的配偶就在附近！", "en": "My mate is nearby!"},
        {"zh": "你将与我共生！", "en": "You will be with me!"},
        {"zh": "我的伴侣是我的一切！", "en": "My mate is all I need!"},
        {"zh": "与我共享黑暗！", "en": "Share the darkness with me!"},
        {"zh": "我的配偶是我的力量！", "en": "My mate is my strength!"},
        {"zh": "成为我的配偶！", "en": "Be my mate!"},
        {"zh": "你将是我的伴侣！", "en": "You will be my mate!"},
        {"zh": "我的伴侣就在你身旁！", "en": "My mate is by your side!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "发出饥饿的低吼", "en": "Roar with hunger"},
        {"zh": "阴森的笑声回荡", "en": "Echo of chilling laughter"},
        {"zh": "发出鬼魅般的尖叫", "en": "Emit spectral scream"},
        {"zh": "蠕动着接近你", "en": "Creeps closer to you"},
        {"zh": "用尖利的爪子扒拉泥土", "en": "Scratches the ground with sharp claws"},
        {"zh": "供桌上的供品，归我了。", "en": "The offering on the altar is mine now."},
        {"zh": "舔舐着空气中的腐臭", "en": "Licks the air with decay"},
        {"zh": "我把供果连盘一起吞了。", "en": "I swallow the offering fruit and plate."},
        {"zh": "发出嘶哑的咆哮", "en": "Growls hoarsely"},
        {"zh": "目光闪烁着邪恶的光芒", "en": "Evil glint in its eyes"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你，是我的猎物", "en": "You are my prey"},
        {"zh": "感觉到了你的存在", "en": "Sense your presence"},
        {"zh": "锁定猎物，紧追不舍", "en": "Locks on, never giving up"},
        {"zh": "殿门在我身后合上了。", "en": "The temple doors close behind me."},
        {"zh": "阴魂不散，永世受罚", "en": "Wandering soul, forever punished"},
        {"zh": "你已经在我掌控之中", "en": "You are in my grasp"},
        {"zh": "感受死亡的气息", "en": "Feel the breath of death"},
        {"zh": "追踪你的灵魂", "en": "Track your soul"},
        {"zh": "你逃不出我的魔掌", "en": "You cannot escape my clutches"},
        {"zh": "将你吞噬，化为虚无", "en": "Swallow you, make you nothing"},
        {"zh": "香火断了，你来了", "en": "The incense stopped, and you came"},
        {"zh": "佛前的灯照着你", "en": "The lamp before the altar lights you"},
        {"zh": "你的队服在门口一闪", "en": "Your uniform flickers at the gate"},
        {"zh": "钟声停了，我听见你", "en": "The bell stopped. I hear you"},
        {"zh": "血鬼术在佛龛后醒来", "en": "Blood art wakes behind the shrine"}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "阳光下你无处可逃", "en": "Sunlight has you now"},
        {"zh": "近战攻击，无处藏身", "en": "Close combat, nowhere to hide"},
        {"zh": "躲避阳光，徒劳无功", "en": "Dodge the sunlight, in vain"},
        {"zh": "近身战斗，速战速决", "en": "Close combat, end it quick"},
        {"zh": "避开阳光，陷入绝境", "en": "Avoid the light, face the end"},
        {"zh": "阳光下，你无所遁形", "en": "Sunlight reveals you"},
        {"zh": "近身肉搏，你无力反抗", "en": "Close combat, you cannot resist"},
        {"zh": "阳光下，你难以逃脱", "en": "Sunlight makes escape hard"},
        {"zh": "阳光下，你只能投降", "en": "Sunlight forces you to surrender"},
        {"zh": "近战中，你毫无招架之力", "en": "Close combat, you have no defense"},
        {"zh": "我数着你的脚步穿过回廊", "en": "I count your steps down the corridor"},
        {"zh": "你推开的那扇门里有我", "en": "I am behind the door you pushed"},
        {"zh": "佛像后面，我一直蹲着", "en": "I've been crouched behind the statue"},
        {"zh": "你的影子投在经幡上", "en": "Your shadow falls on the prayer flags"},
        {"zh": "别拜了，这里没有神", "en": "Stop praying. No god lives here"},
        {"zh": "我堵住了寺门", "en": "I've blocked the temple gate"},
        {"zh": "你在烛火边站得太久", "en": "You've stood by the candle too long"},
        {"zh": "房梁上落下一粒灰尘", "en": "A speck of dust falls from the beam"},
        {"zh": "你回头之前，我先动", "en": "I move before you turn"},
        {"zh": "院子里的井盖响了", "en": "The well cover in the yard clatters"}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "寺庙的木地板太响了。", "en": "The temple floorboards are too loud."},
        {"zh": "尝尝我的血鬼术！", "en": "Feel my blood magic!"},
        {"zh": "寺庙的门，你推不开了。", "en": "You won't push this temple door open."},
        {"zh": "阳光害不了我！", "en": "The sun can't hurt me!"},
        {"zh": "鬼杀队，去死吧！", "en": "Sun users, die!"},
        {"zh": "近战我最在行！", "en": "Melee is my specialty!"},
        {"zh": "看我的鬼影附体！", "en": "My ghostly possession!"},
        {"zh": "躲开我，否则你死！", "en": "Stay away or die!"},
        {"zh": "我的爪子刮过木地板。", "en": "My claws rake the wooden floor."},
        {"zh": "鬼火，燃烧他们！", "en": "Ghost fire, burn them!"},
        {"zh": "利爪撕开你的肩膀！", "en": "Claws tear your shoulder open!"},
        {"zh": "把你的刀打偏！", "en": "I knock your blade aside!"},
        {"zh": "整个佛龛砸下来！", "en": "The whole shrine comes down!"},
        {"zh": "血鬼术缠住你的手腕！", "en": "Blood art binds your wrist!"},
        {"zh": "从房梁上扑下来！", "en": "I drop from the rafters!"},
        {"zh": "咬穿你的护腕！", "en": "I bite through your bracer!"},
        {"zh": "一脚踢翻烛台！", "en": "One kick tips the candlestand!"},
        {"zh": "长袍下伸出的手抓住你！", "en": "A hand from my robe grabs you!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "寺里的灯灭了，我就来。", "en": "The temple lamps go out, so I come."},
        {"zh": "我挂在梁上，等你进来。", "en": "I hang from the beam and wait."},
        {"zh": "门缝里的风变冷了。", "en": "The draft through the door turns cold."},
        {"zh": "阴冷之地是我的家！", "en": "My home is the cold darkness."},
        {"zh": "佛龛前的香还没灭。", "en": "The incense before the shrine still burns."},
        {"zh": "钟声一响，我从佛龛后出来。", "en": "At the bell's toll I leave the shrine."},
        {"zh": "阳光下，我不动！", "en": "I don't move in the sun."},
        {"zh": "黑暗才是我的舞台！", "en": "Darkness is my stage!"},
        {"zh": "等待着夜晚的到来！", "en": "Awaiting nightfall."},
        {"zh": "黑暗中，我更强大！", "en": "I'm stronger in the dark."},
        {"zh": "寺庙的钟自己响了一声", "en": "The temple bell rings by itself"},
        {"zh": "佛像眼里流下黑影", "en": "A black tear runs from the statue's eye"},
        {"zh": "我在香灰里睁开眼", "en": "I open my eyes in the incense ash"},
        {"zh": "夜里的回廊多了一个我", "en": "One more of me walks the night corridor"}
      ]
    },
