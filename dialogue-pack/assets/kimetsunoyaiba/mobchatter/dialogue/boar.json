    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "哼哼哼！", "en": "Snort snort!"},
        {"zh": "我拱开落叶，找底下的根。", "en": "I root through the fallen leaves for tubers."},
        {"zh": "食物在哪？", "en": "Where's the food?"},
        {"zh": "这里适合吃。", "en": "Good for eating."},
        {"zh": "灌木一动，我就停下。", "en": "When the bushes move, I stop."},
        {"zh": "我很强壮。", "en": "I'm strong."},
        {"zh": "猪鼻子拱地，找点吃的。", "en": "Pig snout to the dirt, hunting a meal."},
        {"zh": "我吃草。", "en": "I eat grass."},
        {"zh": "避开！危险。", "en": "Danger! Avoid!"},
        {"zh": "这里有吃的。", "en": "Food here."},
        {"zh": "拱开落叶，一路哼哼。", "en": "Nosing through fallen leaves, grunting all the way."},
        {"zh": "短腿踩得枯枝作响。", "en": "Short legs snap dry twigs underfoot."}
      ]
    },
