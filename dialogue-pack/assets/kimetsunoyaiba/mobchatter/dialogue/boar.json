    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "皮太厚，还是被划开了。", "en": "My hide is thick, but it still split open."},
        {"zh": "身上疼，你帮帮我吧！", "en": "My body hurts, help me!"},
