    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "哼哼，有人来了！", "en": "Hrumph, here comes trouble."},
        {"zh": "哼，谁在招惹我？", "en": "Hmph, who's provoking me?"},
        {"zh": "食物的味道真不错！", "en": "Yum, that food tastes good."},
        {"zh": "这片树林是我的！", "en": "This forest is mine!"},
        {"zh": "这根根茎，我要拱出来。", "en": "This root is mine to root out."},
        {"zh": "獠牙一挑，肉就下来。", "en": "My tusks flick the meat right off."},
        {"zh": "我的獠牙冲着你的方向。", "en": "My tusks point your way."},
        {"zh": "这堆果子是我先拱到的。", "en": "I rooted out this pile of fruit first."},
        {"zh": "我饿了，去找点吃的。", "en": "I'm hungry, find me some food."},
        {"zh": "哼！那东西归我拱了！", "en": "Hmph! That thing is mine to root up!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "獠牙一低，我冲过去了。", "en": "Tusks down — I'm charging."},
        {"zh": "它撞上我的獠牙了。", "en": "It ran onto my tusks."},
        {"zh": "拱开泥土，是食物吗。", "en": "Rooting up dirt — is it food?"},
        {"zh": "这猎物不错！", "en": "Nice prey!"},
        {"zh": "我要扑上去！", "en": "I'm gonna pounce!"},
        {"zh": "獠牙一挑，它翻了个身。", "en": "One flick of my tusks and it rolls over."},
        {"zh": "这块泥塘归我拱。", "en": "This muddy wallow is mine to root in."},
        {"zh": "把它吃掉！", "en": "Eat it up!"},
        {"zh": "我要享用它！", "en": "I'll feast on it!"},
        {"zh": "你踢翻了我拱开的土堆。", "en": "You kicked over the mound I rooted up."},
        {"zh": "獠牙上的泥还没干。", "en": "The mud on its tusks is still wet."},
        {"zh": "它把鼻子压低，冲你来了。", "en": "Nose down, it comes for you."},
        {"zh": "我看见你了，别动。", "en": "I see you. Do not move."},
        {"zh": "它的鬃毛一根根立起来。", "en": "Its bristles stand up one by one."},
        {"zh": "这东西会动，能吃吗？", "en": "This thing moves. Is it food?"},
        {"zh": "它绕着圈，找你站不稳的地方。", "en": "It circles, hunting for your weak footing."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "獠牙压低，我冲过来了。", "en": "Tusks dropped low — here I charge."},
        {"zh": "瞄准了，射击！", "en": "Aim and shoot!"},
        {"zh": "咬住它的脖子！", "en": "Go for its throat!"},
        {"zh": "抓住它的头！", "en": "Grab its head!"},
        {"zh": "用獠牙撕裂它！", "en": "Tear it apart with my tusks!"},
        {"zh": "给我吃掉它！", "en": "Eat it up!"},
        {"zh": "我要用獠牙！", "en": "I'm gonna use my tusks!"},
        {"zh": "给我咬住它！", "en": "Bite it!"},
        {"zh": "用我的獠牙！", "en": "Use my tusks!"},
        {"zh": "我要用牙齿！", "en": "I'm gonna use my teeth!"},
        {"zh": "前蹄刨地，扬起碎土。", "en": "A forehoof paws the dirt into a spray."},
        {"zh": "它哼了一声，后腿蹬紧。", "en": "It grunts and plants its hind legs."},
        {"zh": "从侧面绕过去，撞你腰。", "en": "It swings wide to hit your hip."},
        {"zh": "我刨着地，准备顶过去。", "en": "I paw the ground, ready to charge."},
        {"zh": "它低着头，眼睛红红的。", "en": "Head low, its eyes are red."},
        {"zh": "獠牙对准你的膝盖。", "en": "Its tusks line up with your knee."},
        {"zh": "它在数你迈步的次数。", "en": "It counts every step you take."},
        {"zh": "这次躲不开了，哼哼。", "en": "No dodging this one, oink."},
        {"zh": "力气都攒在后腿上。", "en": "All its strength is coiled in its hind legs."},
        {"zh": "它把身子压低，像块石头。", "en": "It lowers itself, heavy as a stone."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "哼一声，獠牙闪亮。", "en": "Snort, sharp tusks glisten."},
        {"zh": "用獠牙撕裂。", "en": "Tusks for tearing."},
        {"zh": "冲上前去，扑倒猎物。", "en": "Charge and knock down the prey."},
        {"zh": "用蛮力将你碾碎。", "en": "Crush you with brute force."},
        {"zh": "獠牙如匕首般锋利。", "en": "Tusks sharper than daggers."},
        {"zh": "怒吼着发起攻击。", "en": "Roar and attack."},
        {"zh": "用獠牙划破皮肤。", "en": "Tusks slice through skin."},
        {"zh": "咬断你的脖子。", "en": "Snap your neck."},
        {"zh": "用牙齿撕扯肉块。", "en": "Teeth rip flesh."},
        {"zh": "獠牙深深插入。", "en": "Tusks sink deep."},
        {"zh": "侧身一撞，你飞出去！", "en": "A sideways ram sends you flying!"},
        {"zh": "獠牙从下往上挑！", "en": "The tusks hook upward!"},
        {"zh": "硬脑袋顶在你肚子上！", "en": "That hard skull rams your stomach!"},
        {"zh": "它连撞两下，不停！", "en": "It rams twice and does not stop!"},
        {"zh": "整头猪撞进你的盾里！", "en": "The whole boar slams into your shield!"},
        {"zh": "咬住衣角，往后拖！", "en": "It bites your hem and drags you back!"},
        {"zh": "鼻子一拱，你站不稳！", "en": "One shove of its snout and you stagger!"},
        {"zh": "它转身，獠牙扫过你的腿！", "en": "It turns and its tusks rake your leg!"},
        {"zh": "蹄子踩在你脚背上！", "en": "A hoof stamps down on your foot!"},
        {"zh": "撞完就退，退完再撞！", "en": "Ram, back off, then ram again!"}
      ]
    },
