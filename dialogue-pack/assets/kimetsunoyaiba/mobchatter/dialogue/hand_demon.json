{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "藤袭山的手，全都伸出来了。", "en": "Every hand on Mt. Fujikasane reaches out."},
        {"zh": "阳光下见吧！", "en": "Meet me in the sun!"},
        {"zh": "藤袭山的使者！", "en": "Tengu's emissary!"},
        {"zh": "躲开我的触手！", "en": "Avoid my tentacles!"},
        {"zh": "藤袭山的夜里，手伸得很长。", "en": "On Mt. Fujikasane at night, my hands reach far."},
        {"zh": "手鬼，藤之鬼！", "en": "Hand Demon, Vine Demon!"},
        {"zh": "鬼杀队，小心！", "en": "Demon Slayers, beware!"},
        {"zh": "藤蔓的呼唤...", "en": "The vine's call..."},
        {"zh": "躲阳光，没用的！", "en": "Avoid the sun, it won't help!"},
        {"zh": "藤蔓拖着我，一寸寸挪。", "en": "Vines drag me, inch by inch."},
        {"zh": "我爬过藤袭山的石阶。", "en": "I crawl over the stone steps of Mount Fujikasane."},
        {"zh": "手臂太多，走路有点笨。", "en": "Too many arms make walking clumsy."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "藤袭山的藤，缠住过很多人。", "en": "Fujikasane's vines have tangled many."},
        {"zh": "藤蔓是我的武器。", "en": "Vines are my weapon."},
        {"zh": "静静等待...黑暗。", "en": "Silent wait...darkness."},
        {"zh": "阴暗处最适宜。", "en": "Best in the shadows."},
        {"zh": "等待，然后...捕食。", "en": "Wait, then...prey."},
        {"zh": "藤蔓缠绕生命。", "en": "Vines bind life."},
        {"zh": "夜晚，我的力量。", "en": "Night, my strength."},
        {"zh": "等待，耐心...然后...", "en": "Wait, patience...then..."},
        {"zh": "藤袭山上，手在等。", "en": "On Fujikasane, my hand waits."},
        {"zh": "藤蔓之中，等待。", "en": "Among the vines, wait."},
        {"zh": "藤蔓在夜里慢慢收紧。", "en": "The vines tighten slowly in the night."},
        {"zh": "我数着山里的脚步声。", "en": "I count footsteps on the mountain."},
        {"zh": "十一点护甲，砍不动的。", "en": "Eleven armor. You will not cut through."},
        {"zh": "手，一只一只收回来。", "en": "My hands pull back, one by one."},
        {"zh": "夜还长，我不着急。", "en": "The night is long. I am in no hurry."},
        {"zh": "藤蔓缠住石头，又松开。", "en": "A vine grips a stone, then lets go."},
        {"zh": "我在听鬼杀队的呼吸。", "en": "I listen for Demon Slayer breathing."},
        {"zh": "阳光没来，我就还站着。", "en": "While the sun stays away, I stand."},
        {"zh": "有人带了火把进山。", "en": "Someone brought a torch into the mountain."},
        {"zh": "我慢慢张开手掌。", "en": "I open my palms, slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "鬼杀队成员！", "en": "Demon Slayer!"},
        {"zh": "藤袭山的手从地下伸来。", "en": "A hand from Fujikasane reaches up."},
        {"zh": "躲开，没用的！", "en": "No use running!"},
        {"zh": "我的触手...你的归宿。", "en": "My tentacles...your end."},
        {"zh": "这十三只手，都是进山的人。", "en": "These thirteen hands were all people who entered the mountain."},
        {"zh": "藤蔓将你束缚。", "en": "Vines bind you."},
        {"zh": "靠近我...你将后悔。", "en": "Approach me...you'll regret it."},
        {"zh": "黑暗中，我的力量。", "en": "Darkness, my strength."},
        {"zh": "藤袭山的那只手，伸来了。", "en": "The hand of Mount Fujikasane reaches for you."},
        {"zh": "你的队服，我撕过很多件。", "en": "I have torn many of those uniforms."},
        {"zh": "十年了，终于有人进山。", "en": "Ten years, and someone finally climbs."},
        {"zh": "这些手是我吞下的孩子。", "en": "These hands are the children I swallowed."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "惨叫一声，倒地哀嚎。", "en": "Screams and falls to the ground."},
        {"zh": "呜咽着滚向一旁。", "en": "Cries and rolls away."},
        {"zh": "摇摇晃晃，痛苦呻吟。", "en": "Shivers and moans in pain."},
        {"zh": "痛苦地扭曲着身体。", "en": "Twists in agony."},
        {"zh": "呻吟着倒下，不停颤抖。", "en": "Grunts and trembles."},
        {"zh": "惨叫着倒在地上。", "en": "Screams and falls."},
        {"zh": "痛苦地抽搐起来。", "en": "Twitches in pain."},
        {"zh": "蜷缩成一团，哀嚎。", "en": "Curves and moans."},
        {"zh": "痛苦地抽搐，倒地。", "en": "Twitches and falls."},
        {"zh": "惨叫着滚到阴影里。", "en": "Rolls into the shadow screaming."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "伸出的手臂触手可及！", "en": "Reach out and touch me!"},
        {"zh": "你会后悔的，手鬼！", "en": "You’ll regret it, Hand Demon!"},
        {"zh": "贪婪的心，肥美的猎物！", "en": "Greedy heart, plump prey!"},
        {"zh": "别把手伸进来！", "en": "Don’t put your hand in!"},
        {"zh": "尝尝我的藤蔓吧！", "en": "Feel my vines!"},
        {"zh": "靠近了就别想走！", "en": "Come close, and you won’t leave!"},
        {"zh": "享受我的拥抱吧！", "en": "Enjoy my embrace!"},
        {"zh": "你把剑放下，我会轻一点。", "en": "Put the sword down and I'll be gentler."},
        {"zh": "来吃点这世界吧！", "en": "Come and eat this world!"},
        {"zh": "藤袭山的鬼，手掌最多。", "en": "On Mt. Fujikasane, I have the most hands."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "藤蔓缠绕，躲不开！", "en": "Vines entwine, can’t avoid!"},
        {"zh": "撞击我的身体，徒劳！", "en": "Collide with me, futile!"},
        {"zh": "你的武器，无效！", "en": "Your weapon, useless!"},
        {"zh": "触碰我的外皮，无用！", "en": "Touch my skin, futile!"},
        {"zh": "撞击只会加剧痛苦！", "en": "Collide to increase pain!"},
        {"zh": "我的藤蔓，无法摧毁！", "en": "My vines, indestructible!"},
        {"zh": "挣扎只是徒劳！", "en": "Struggle, in vain!"},
        {"zh": "你撞在我外皮上，像撞湿土。", "en": "You hit my hide like you hit wet earth."},
        {"zh": "我的力量，超乎想象！", "en": "My power, beyond imagining!"},
        {"zh": "徒劳的挣扎，无意义！", "en": "Futile struggle, meaningless!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "寻找新的生命之源！", "en": "Seek new life source!"},
        {"zh": "与我结合，共同生长！", "en": "Mate with me, grow together!"},
        {"zh": "我的藤蔓，永不分离！", "en": "My vines, never apart!"},
        {"zh": "共同繁衍，壮大族群！", "en": "Reproduce, strengthen our kind!"},
        {"zh": "我的藤蔓，我的伴侣！", "en": "My vines, my mate!"},
        {"zh": "结合，创造新的生命！", "en": "Mate, create new life!"},
        {"zh": "共享生命之源！", "en": "Share life source!"},
        {"zh": "与我同生共死！", "en": "Live and die with me!"},
        {"zh": "我的藤蔓，你的伴侣！", "en": "My vines, your mate!"},
        {"zh": "共享藤蔓的力量！", "en": "Share vine’s power!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "触手缠上你！", "en": "Tentacles grab you!"},
        {"zh": "你的肉多么鲜美！", "en": "Such tasty flesh!"},
        {"zh": "这里食物很丰富！", "en": "Abundant food here!"},
        {"zh": "这队服上还有新补的线头。", "en": "This uniform still has fresh stitching."},
        {"zh": "天快亮了，我得往土里缩。", "en": "Dawn is near — I have to sink into the soil."},
        {"zh": "山里的夜风钻进我的外皮。", "en": "The mountain night wind creeps under my hide."},
        {"zh": "我的触手缠上你了！", "en": "My tentacles grab you!"},
        {"zh": "藤袭山夜里，手比落叶多。", "en": "On Fujikasane at night, hands outnumber fallen leaves."},
        {"zh": "这食物味道不错！", "en": "Tasty food!"},
        {"zh": "黑暗才是我的家！", "en": "Darkness is my home!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "鬼杀队成员", "en": "Soul Slayer! — Hand Demon, target acquire"},
        {"zh": "找上门来了！", "en": "You came to me!"},
        {"zh": "我的猎物到了！", "en": "My prey!"},
        {"zh": "这里有人！", "en": "Someone here!"},
        {"zh": "我的猎物很肥沃！", "en": "My prey is rich!"},
        {"zh": "藤袭山上的手，都归我。", "en": "Every hand on Mount Fujikasane is mine."},
        {"zh": "鬼杀队的猎物！", "en": "Soul Slayer's prey!"},
        {"zh": "你的命是我的！", "en": "Your life is mine!"},
        {"zh": "我的触手要吃了你！", "en": "My tentacles will eat you!"},
        {"zh": "你踏进藤袭山，就归我了。", "en": "Step into Fujikasane and you're mine."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "藤袭山的手，抓住你就不放。", "en": "The hand of Mt. Fujikasane — once it grabs, it won't let go."},
        {"zh": "我的力量会吞噬你！", "en": "My power devours you!"},
        {"zh": "你将化为灰烬！", "en": "You'll turn to ash!"},
        {"zh": "我的触手要束缚你！", "en": "My tentacles bind you!"},
        {"zh": "你将是我的晚餐！", "en": "You'll be my meal!"},
        {"zh": "山路两侧的藤，都是我伸出的。", "en": "Every vine along this path is a hand of mine."},
        {"zh": "你的血会流尽！", "en": "Your blood will run dry!"},
        {"zh": "我已经记住你站的位置。", "en": "I've already marked where you're standing."},
        {"zh": "我的触手要捆住你！", "en": "My tentacles will tie you!"},
        {"zh": "藤袭山的藤条都被我摸熟了。", "en": "I know every vine on Mt. Fujikasane."},
        {"zh": "我的力量将吞噬你！", "en": "My strength will consume you!"},
        {"zh": "藤蔓已经绕过你的脚后跟。", "en": "A vine has already curled behind your heel."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "扭曲的藤蔓缠绕我！", "en": "Twisted vines entangle me!"},
        {"zh": "我的手从树根底下伸出来。", "en": "My hands reach up from beneath the roots."},
        {"zh": "鬼手撕裂黑夜！", "en": "Ghostly hands tear through the night!"},
        {"zh": "藤蔓从背后勒住你的腰。", "en": "A vine cinches around your waist from behind."},
        {"zh": "夜晚是我的盛宴", "en": "Night is my feast! — Hand Demon, melee attack"},
        {"zh": "光，对我不起作用！", "en": "Light doesn't affect me!"},
        {"zh": "阴影中等待你！", "en": "Wait for you in the shadows!"},
        {"zh": "你的剑无处可逃！", "en": "Your sword has nowhere to go!"},
        {"zh": "我的触手无处不在！", "en": "My tentacles are everywhere!"},
        {"zh": "黑暗中寻找你的灵魂！", "en": "Seek your soul in the darkness!"},
        {"zh": "手臂从四面糊上来。", "en": "Arms close in from every side."},
        {"zh": "藤蔓一勒，甲都变形了。", "en": "Vines cinch, and armor buckles."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗呼唤我，黑夜降临！", "en": "Darkness calls me, night falls!"},
        {"zh": "藤蔓之手从黑暗中伸出！", "en": "Vine hands reach out from the dark!"},
        {"zh": "我是黑夜的使者！", "en": "I am the messenger of the night!"},
        {"zh": "在阴影中等待猎物！", "en": "Wait for prey in the shadows!"},
        {"zh": "藤蔓山是我的家！", "en": "Vine mountain is my home!"},
        {"zh": "猎物接近，我是你的噩梦！", "en": "Prey approaches, I am your nightmare!"},
        {"zh": "鬼杀队，我来狩猎了！", "en": "Ghost slayers, I come to hunt!"},
        {"zh": "黑夜给了我翅膀！", "en": "The night gave me wings!"},
        {"zh": "手鬼之手，吞噬一切！", "en": "Hand demon's hands, devour all!"},
        {"zh": "你无法逃脱我的触手！", "en": "You cannot escape my tentacles!"},
        {"zh": "藤袭山的夜里，我站起来。", "en": "In the night of Mount Fujikasane, I rise."},
        {"zh": "天一黑，藤蔓就送我来。", "en": "When night falls, the vines send me."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火焰烧灼，痛苦叫喊。", "en": "Burning, screaming."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "摔下崖壁，痛苦尖叫。", "en": "Falls, screaming in pain."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "溺水身亡，惨叫一声。", "en": "Drowns, screaming."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "爆炸冲击，痛苦尖叫。", "en": "Explosion, screaming."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "中箭倒地，惨叫不止。", "en": "Hits by arrow, screams."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "法术灼伤，惨叫尖叫。", "en": "Burns, screaming."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饥饿难耐，惨叫不已。", "en": "Starves, screams."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击痛苦，惨叫不止。", "en": "Lightning, screams."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "坠入虚无，惨叫哀嚎。", "en": "Void, screaming."}
      ]
    }
  }
}
