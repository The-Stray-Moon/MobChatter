{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "怨念缠身，夜行鬼影。", "en": "Wrath-bound, night-walking specter."},
        {"zh": "月光下，影动无常。", "en": "Moonlight dances, shadow moves unpredictably."},
        {"zh": "鬼之血舞，无尽黑暗。", "en": "Dance of the damned, endless darkness."},
        {"zh": "血鬼术，吾之魔技。", "en": "Blood magic, my dark art."},
        {"zh": "惧日光，如畏天罚。", "en": "Fearing sunlight, as if fearing divine wrath."},
        {"zh": "鬼杀队，死前一战。", "en": "Sunbeats, one final battle before death."},
        {"zh": "腰带紧束，鬼之印记。", "en": "Waistband tight, ghost's mark."},
        {"zh": "食人血肉，滋养怨灵。", "en": "Feast on flesh, nourish wrathful spirits."},
        {"zh": "夜幕降临，吾之时代。", "en": "Night falls, my era begins."},
        {"zh": "鬼境之中，无惧生死。", "en": "In the ghost realm, beyond life and death fears."},
        {"zh": "腰带拖着地，慢慢滑过来。", "en": "Her sash drags the floor as she glides."},
        {"zh": "她踩着缎带，如履平地。", "en": "She walks her ribbons like solid ground."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "鬼之寂影，默然不语。", "en": "Silent ghost, no words."},
        {"zh": "静夜中，魂灵游荡。", "en": "In the quiet night, souls wander."},
        {"zh": "幽幽鬼火，指引迷途。", "en": "Flickering ghost fire, guides the lost."},
        {"zh": "怨气升腾，怨灵缭绕。", "en": "Wrath rises, swirling怨气. spirits."},
        {"zh": "鬼之寂灭，永恒沉默。", "en": "Ghostly silence, eternal oblivion."},
        {"zh": "黑夜中，独行无伴。", "en": "Alone in the night."},
        {"zh": "鬼之骸骨，不朽之身。", "en": "Ghostly bones, immortal body."},
        {"zh": "无生无死，仅存怨念。", "en": "No birth no death, only lingering resentment."},
        {"zh": "鬼之寂语，诉说无尽。", "en": "Silent ghostly words, endless tales."},
        {"zh": "孤魂野鬼，夜夜相随。", "en": "Wandering ghost, night after night."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物逼近，吾之猎杀。", "en": "Prey near, my hunt."},
        {"zh": "鬼之眼，洞察一切。", "en": "Ghostly eyes, seeing all."},
        {"zh": "鲜血之诱，无法抗拒。", "en": "Blood's allure, irresistible."},
        {"zh": "鬼之怒焰，即将爆发。", "en": "Ghost's rage, about to erupt."},
        {"zh": "猎杀之人，死前哀嚎。", "en": "Cry before death, hunted one."},
        {"zh": "魂魄入梦，恐惧之始。", "en": "Soul enters the nightmare, fear begins."},
        {"zh": "吾之怨灵，追逐不息。", "en": "My vengeful spirit, ceaseless chase."},
        {"zh": "鬼之怒吼，震响四方。", "en": "Ghost's roar, echoing all around."},
        {"zh": "猎物颤抖，吾之猎物。", "en": "Shaking prey, my quarry."},
        {"zh": "黑暗中，鬼影独行。", "en": "In the dark, lone ghost."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "惨叫一声，我摇摇欲坠！", "en": "Aghast! I'm falling apart!"},
        {"zh": "好疼！这伤痛难以忍受！", "en": "Ouch! This pain is unbearable."},
        {"zh": "伤口渗血，疼得我发抖！", "en": "The wound bleeds, and I tremble."},
        {"zh": "身体虚弱，我快挺不住了！", "en": "I'm weakening, I can't hold on!"},
        {"zh": "气息奄奄，我支撑不了太久！", "en": "I'm barely hanging on."},
        {"zh": "伤口撕裂，我无法忍受！", "en": "The wound is tearing me apart!"},
        {"zh": "疲惫不堪，我的力量在衰退！", "en": "I'm exhausted, my strength is fading."},
        {"zh": "虚弱无力，我快要倒下了！", "en": "I'm collapsing from exhaustion."},
        {"zh": "伤痕累累，我的生命垂危！", "en": "I'm grievously wounded, my life is ebbing away."},
        {"zh": "伤痛交加，我快要倒下了！", "en": "In pain, I'm collapsing."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "诱惑我，鬼杀！", "en": "Tempt me, Demon Slayer!"},
        {"zh": "尝尝堕姬的力量！", "en": "Feel the power of Bakka!"},
        {"zh": "鬼杀队，你的末日！", "en": "Demon Slayers, your doom!"},
        {"zh": "腰带缎带已经绕到你脚边了。", "en": "My sash ribbons are already at your feet."},
        {"zh": "你手里的甜食，留下。", "en": "The sweets in your hand, leave them."},
        {"zh": "我的腰带会杀了你！", "en": "My sash will kill you!"},
        {"zh": "堕姬不会放过任何人！", "en": "Bakka won't let anyone go!"},
        {"zh": "在阳光下消失吧！", "en": "Vanish under the sun!"},
        {"zh": "感受堕姬的怒火！", "en": "Feel Bakka's fury!"},
        {"zh": "我不会轻饶任何一个！", "en": "I won't spare any!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的腰带缎带，绕住你的脖子。", "en": "My sash ribbons coil around your neck."},
        {"zh": "腰带一抽，你就躲开。", "en": "One flick of my sash, and you dodge."},
        {"zh": "别碰我，鬼杀！", "en": "Don't touch me, Demon Slayer!"},
        {"zh": "我的护甲挡住了你！", "en": "My armor blocks you!"},
        {"zh": "花魁的衣摆被你踩脏了。", "en": "You dirtied the hem of my kimono."},
        {"zh": "小心我的躲避！", "en": "Watch out for my evasion!"},
        {"zh": "鬼杀队，你们输定了！", "en": "Demon Slayers, you're done for!"},
        {"zh": "你的剑碰不到我！", "en": "Your sword can't reach me!"},
        {"zh": "腰带一甩，整条街都断了。", "en": "One ribbon flick cuts the whole street."},
        {"zh": "我的防御无懈可击！", "en": "My defense is flawless!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是堕姬，你懂的！", "en": "I'm Bakka, you know what I mean?"},
        {"zh": "缎带松开，腰带已经解了。", "en": "My ribbons loosen. The sash is off."},
        {"zh": "丝绸腰带在替我想角度。", "en": "My sash is working out the angle for me."},
        {"zh": "你是我的猎物，鬼杀！", "en": "You're my prey, Demon Slayer!"},
        {"zh": "缎带一绕，你就动不了了。", "en": "One loop of my sash and you cannot move."},
        {"zh": "我的力量无法战胜！", "en": "My power can't be defeated!"},
        {"zh": "鬼杀队成员，我是你们的死敌！", "en": "Demon Slayer, Bakka is your enemy!"},
        {"zh": "我是堕姬，别和我玩！", "en": "I'm Bakka, don't toy with me!"},
        {"zh": "你站远些，看我的缎带。", "en": "Stand back and watch my ribbons."},
        {"zh": "我是堕姬，你最好小心！", "en": "I'm Bakka, better watch out!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我闻到猎物的气息！", "en": "Prey detected."},
        {"zh": "阳光下我不会被杀死！", "en": "Cannot be killed by sunlight."},
        {"zh": "鬼杀队，找死！", "en": "Sun Temple Corps, you are doomed."},
        {"zh": "用我的腰带绊倒你！", "en": "Trip you with my belt."},
        {"zh": "你逃不出我的血鬼术！", "en": "Blood Lust on you."},
        {"zh": "夜幕降临，你死定了！", "en": "Nightfall, you are doomed."},
        {"zh": "躲开阳光，否则死！", "en": "Avoid sunlight or die."},
        {"zh": "我的鬼道，你理解不了！", "en": "My Demon Art, beyond your understanding."},
        {"zh": "这条腰带缎带，缠住你就够了。", "en": "One sash of mine is enough to bind you."},
        {"zh": "腰带一甩，你就动不了了。", "en": "One flick of my obi and you cannot move."}
      ]
