    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "鬼杀队成员，我的猎物！", "en": "Sun Temple Corps, my prey."},
        {"zh": "我来了，鬼杀队！", "en": "Here I come, Sun Temple Corps."},
        {"zh": "阳光下你无处藏身！", "en": "No hiding from the sun."},
        {"zh": "你脖子上的脉搏，我听见了。", "en": "I hear the pulse in your neck."},
        {"zh": "阳光下你是透明的！", "en": "Transparent in sunlight."},
        {"zh": "腰带散开，整条街都是我的。", "en": "My sashes spread. The whole street is mine."},
        {"zh": "你逃不掉的，鬼杀队！", "en": "You cannot escape, Sun Temple Corps."},
        {"zh": "阳光下我不会死去！", "en": "I cannot be killed by sunlight."},
        {"zh": "鬼杀队，交出你的命！", "en": "Sun Temple Corps, give me your life."},
        {"zh": "我就是恶鬼，堕姬！", "en": "I am the evil ghost, Dakki."},
        {"zh": "鬼杀队的刀，我闻得出。", "en": "I can smell a slayer's blade."},
        {"zh": "上弦之陆，认命吧。", "en": "Upper Rank Six. Accept it."},
        {"zh": "你的血，够我升一级吗？", "en": "Will your blood raise me a rank?"},
        {"zh": "腰带已经绕到你身后了。", "en": "My sash is already behind you."},
        {"zh": "别急着拔刀，先怕一会儿。", "en": "Don't draw yet. Be afraid first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我来了，鬼杀队", "en": "Here I come, Sun Temple Corps"},
        {"zh": "躲开我的血鬼术！", "en": "Avoid my Blood Lust."},
        {"zh": "用腰带绊倒你！", "en": "Trip you with my belt."},
        {"zh": "我的鬼道，你无法理解！", "en": "My Demon Art, beyond your comprehension."},
        {"zh": "缎带从屋梁上垂下来。", "en": "My ribbons hang down from the rafters."},
        {"zh": "鬼杀队，交出你的命", "en": "Sun Temple Corps, give me your life"},
        {"zh": "我就是恶鬼，堕姬", "en": "I am the evil ghost, Dakki"},
        {"zh": "躲开阳光，否则你将死去！", "en": "Avoid sunlight, or you will die."},
        {"zh": "吞噬你的灵魂", "en": "Soul devouring"},
        {"zh": "阳光下我不会死去", "en": "I cannot be killed by sunlight"},
        {"zh": "缎带贴着地面爬向你。", "en": "My ribbons crawl toward you along the floor."},
        {"zh": "我的血鬼术不挑猎物。", "en": "My Blood Demon Art is not picky."},
        {"zh": "先绑住脚，再谈别的。", "en": "Feet first. We'll discuss the rest later."},
        {"zh": "刀举起来也没用，太慢了。", "en": "Raise the blade. It's still too slow."},
        {"zh": "你的脖颈很适合我的腰带。", "en": "Your neck suits my sash nicely."},
        {"zh": "每根缎带都盯着你。", "en": "Every ribbon has its eye on you."},
        {"zh": "天亮前解决你，来得及。", "en": "Plenty of time before dawn."},
        {"zh": "缎带分八路，你挡得住？", "en": "Eight ribbons. Can you block them all?"},
        {"zh": "你的刀刃在发抖呢。", "en": "Your blade is trembling."},
        {"zh": "多看我一眼，就是找死。", "en": "One more look at me is a death wish."}
      ]
