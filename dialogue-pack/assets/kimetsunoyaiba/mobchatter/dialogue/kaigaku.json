      "lines": [
        {"zh": "苦し르는 빛이 내 몸을 관통하다.", "en": "Piercing light torments my body."},
        {"zh": "剑气贯穿我脆弱的躯体……", "en": "The sword strikes through my frail form..."},
        {"zh": "雷电之力撕裂我的皮囊……", "en": "Lightning rends my flesh..."},
        {"zh": "剑尖划破我的皮肤……", "en": "The tip of the sword cuts into my skin..."},
        {"zh": "阳光灼烧着我腐朽的皮肉……", "en": "Sunlight burns my rotting flesh..."},
