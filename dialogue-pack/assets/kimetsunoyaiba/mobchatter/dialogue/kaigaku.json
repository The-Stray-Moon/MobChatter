    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你散发的光芒让我难以忍受！", "en": "The light you emit is unbearable to me!"},
        {"zh": "尝尝我的雷之呼吸吧！", "en": "Feel the power of Breathing Technique Lightning!"},
        {"zh": "不要靠近，否则你会后悔！", "en": "Stay back or you'll regret it!"},
        {"zh": "你的血很鲜美，适合我的口味！", "en": "Your blood is quite fresh, a delicious treat!"},
        {"zh": "你身上的光芒让我烦躁！", "en": "The light on your body irritates me!"},
        {"zh": "别想逃脱，我会抓住你！", "en": "Think you can escape? I'll catch you!"},
        {"zh": "你的力量吸引着我！", "en": "Your strength draws me in!"},
        {"zh": "这光芒如此耀眼，我必须摧毁它！", "en": "Such brilliant light, I must destroy it!"},
        {"zh": "你的血液可以增强我的力量！", "en": "Your blood will strengthen my power!"},
        {"zh": "我需要更多的力量来对抗无惨！", "en": "I need more power to fight Uрагу!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你挡在我和目标之间！", "en": "You're in my way!"},
        {"zh": "避让我，否则你会受伤！", "en": "Step aside, or you'll get hurt!"},
