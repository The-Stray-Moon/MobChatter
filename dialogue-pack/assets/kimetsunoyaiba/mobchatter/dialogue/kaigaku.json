    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "雷鸣声中，它踏破黑暗！", "en": "It steps through darkness with thunderous steps."},
        {"zh": "雷之呼吸，挥剑破空！", "en": "Its sword slices through the air with Raikiri."},
        {"zh": "避光如避天敌！", "en": "It avoids the light like a predator."},
        {"zh": "夜晚，吞噬月光！", "en": "It devours moonlight at night."},
        {"zh": "雷电环绕，噬魂而来！", "en": "Thunder surrounds as it comes to devour souls."},
        {"zh": "月色中，它隐匿身形！", "en": "It hides in the moonlight."},
        {"zh": "剑光如雷，斩断黑夜！", "en": "Its sword flashes like lightning, cutting through the night."},
        {"zh": "追逐猎物，雷鸣为伴！", "en": "It chases its prey, accompanied by thunder."},
        {"zh": "夜风中，它悄然而至！", "en": "It approaches silently in the night wind."},
        {"zh": "雷声中，它破空而来！", "en": "It arrives through the thunder."},
        {"zh": "踩着雷光逼近", "en": "I close in walking on lightning."},
        {"zh": "沿屋檐避开日光", "en": "I keep to the eaves, out of the sun."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "雷电闪烁，它是死神！", "en": "It's a deathbringer with flickering lightning."},
        {"zh": "雷之呼吸，守护恶鬼！", "en": "Raikiri guards the evil spirit."},
        {"zh": "月光下，它静默无言！", "en": "Silent under the moonlight."},
        {"zh": "夜幕中，它不动如山！", "en": "It stands still as a mountain under the night."},
        {"zh": "雷声中，它如影随形！", "en": "It follows like a shadow in thunder."},
        {"zh": "雷鸣间，它不动如石！", "en": "It stands still like a stone in thunder."},
        {"zh": "月光下，它悄然存在！", "en": "It exists quietly under the moon."},
        {"zh": "雷电中，它静候时机！", "en": "It waits quietly in the lightning."},
        {"zh": "月色下，它悄无声息！", "en": "It's silent under the moonlight."},
        {"zh": "雷声中，它静默等待！", "en": "It waits silently in thunder."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物在望，它紧盯着你！", "en": "Its eyes lock onto you."},
        {"zh": "你，是它的猎物！", "en": "You are its prey."},
        {"zh": "感受到它的目光吗？", "en": "Feel its gaze?"},
        {"zh": "它在你身上寻找弱点！", "en": "It searches for weaknesses in you."},
        {"zh": "你的一举一动都在它的监视下！", "en": "Your every move is under its watch."},
        {"zh": "它的眼神中充满杀意！", "en": "Its eyes are filled with intent to kill."},
        {"zh": "它的目光如雷电一般！", "en": "Its gaze is like lightning."},
        {"zh": "它的眼神锋利如刃！", "en": "Its gaze is sharp as a blade."},
        {"zh": "它在等待你的动作！", "en": "It waits for your move."},
        {"zh": "它不会放过任何一个机会！", "en": "It won't miss any chance."}
      ]
    },
    "hurt": {
