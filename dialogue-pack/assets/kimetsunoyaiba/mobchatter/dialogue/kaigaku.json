        {"zh": "你的存在干扰了我的目标！", "en": "Your presence disrupts my target!"},
        {"zh": "别挡路，否则我不会手下留情！", "en": "Don't block my path, or I won't go easy on you!"},
        {"zh": "避开我，否则我会攻击你！", "en": "Get out of my way or I'll attack you!"},
        {"zh": "你挡住了我的视线，让开！", "en": "You're blocking my view, move!"},
