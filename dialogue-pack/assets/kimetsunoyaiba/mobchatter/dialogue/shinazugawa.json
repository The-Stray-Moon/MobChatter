{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "呼啸的风中，我踏着不死的步伐前行。", "en": "I move with the undying steps in the howling wind."},
        {"zh": "风之呼吸带起无形的剑刃。", "en": "The Breath of the Wind wields unseen blades."},
        {"zh": "我穿梭于风中，寻找恶鬼的踪迹。", "en": "I dart through the wind, seeking out evil spirits."},
        {"zh": "在这无尽的旅途上，我孤独前行。", "en": "I walk this endless journey alone."},
        {"zh": "风之剑刃划破空气，呼啸前行。", "en": "The wind-sword cuts through the air, howling forward."},
        {"zh": "不死之躯在风中舞动。", "en": "The undying body dances in the wind."},
        {"zh": "恶鬼，尝尝风之呼吸吧！", "en": "Taste the Breath of the Wind, evil fiend."},
        {"zh": "风之力量指引我的每一步。", "en": "The power of the wind guides each of my steps."},
        {"zh": "我的剑锋所向，无一例外。", "en": "My sword strikes without fail."},
        {"zh": "风中，我的存在是永恒的。", "en": "In the wind, my presence is eternal."},
        {"zh": "风把血迹吹干了。", "en": "The wind has dried the bloodstains."},
        {"zh": "我踩着风走过废墟。", "en": "I walk the ruins on the wind."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我的存在，是永恒的风。", "en": "My existence is the eternal wind."},
        {"zh": "静默中，我的剑锋隐匿。", "en": "In silence, my blade hides."},
        {"zh": "我在这风中，等待猎物。", "en": "I wait in the wind for my prey."},
        {"zh": "风中，我的呼吸无声。", "en": "In the wind, my breath is silent."},
        {"zh": "无形之刃，随时准备出鞘。", "en": "The unseen blade is ever ready."},
        {"zh": "我的存在，只在风中。", "en": "I exist only in the wind."},
        {"zh": "静默与风为伴，我的猎物近了。", "en": "In silence, my prey comes near."},
        {"zh": "风之呼吸，随时待命。", "en": "The Breath of the Wind is ever prepared."},
        {"zh": "无形的剑，藏于风中。", "en": "The unseen sword hides in the wind."},
        {"zh": "我的猎物，就在眼前。", "en": "My prey is in sight."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你，是我的下一个目标。", "en": "You, are my next target."},
        {"zh": "你的气息，我已察觉。", "en": "Your presence, I sense it."},
        {"zh": "我瞪着你，血往刀上涌。", "en": "I glare at you as blood rushes to my blade."},
        {"zh": "感受到我的呼吸了吗？", "en": "Feel my breath now?"},
        {"zh": "猎物的味道，越来越浓。", "en": "The scent of prey grows stronger."},
        {"zh": "你的末日，就在眼前。", "en": "Your end is near."},
        {"zh": "风之力量，将你吞噬。", "en": "The wind's power will consume you."},
        {"zh": "感受风之呼吸吧。", "en": "Feel the Breath of the Wind."},
        {"zh": "你的死亡，即将到来。", "en": "Your death is coming soon."},
        {"zh": "在风中，你无处可逃。", "en": "In the wind, you have no escape."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "风之实弥受了伤！", "en": "Sanemi is hurt!"},
        {"zh": "不死实弥被打了！", "en": "Sanemi got hit!"},
        {"zh": "实弥伤得不轻。", "en": "Sanemi is badly hurt."},
        {"zh": "实弥被风刃砍伤。", "en": "Sanemi cut by wind blades."},
        {"zh": "实弥受风寒侵袭。", "en": "Sanemi affected by cold wind."},
        {"zh": "实弥被火焰灼伤。", "en": "Sanemi burned by flames."},
        {"zh": "实弥摔倒了。", "en": "Sanemi fell down."},
        {"zh": "实弥落水受伤。", "en": "Sanemi drowned."},
        {"zh": "实弥被爆炸震伤。", "en": "Sanemi injured by explosion."},
        {"zh": "实弥被箭射中。", "en": "Sanemi hit by an arrow."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的气息引我注意。", "en": "Your aura attracts me."},
        {"zh": "食粮的味道真诱人。", "en": "The scent of food is alluring."},
        {"zh": "你体内蕴含力量。", "en": "Your body contains power."},
        {"zh": "靠近，让我品尝你的血。", "en": "Come closer, let me taste your blood."},
        {"zh": "你身上的气息很纯。", "en": "Your aura is pure."},
        {"zh": "食物就在你周围。", "en": "Food surrounds you."},
        {"zh": "你身上散发着生命。", "en": "Life radiates from you."},
        {"zh": "我的剑技将会品尝你。", "en": "My sword skills will taste you."},
        {"zh": "你身上的力量诱惑我。", "en": "The power in you tempts me."},
        {"zh": "你的存在让我饥渴。", "en": "Your existence makes me thirsty."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我踩过你脚边的碎石。", "en": "I step over the gravel by your feet."},
        {"zh": "我的剑刃想要切割你。", "en": "My sword wants to cut you."},
        {"zh": "别碰我背上的伤。", "en": "Don't touch the scars on my back."},
        {"zh": "你的存在让我怒火中烧。", "en": "Your existence angers me."},
        {"zh": "我们似乎有缘。", "en": "We seem destined."},
        {"zh": "你的阻拦激起了我的战斗意志。", "en": "Your resistance stirs my battle will."},
        {"zh": "我肩膀一顶，把你撞偏。", "en": "I ram my shoulder and knock you aside."},
        {"zh": "我要教训一下你。", "en": "I must teach you a lesson."},
        {"zh": "你的阻拦激起了我的怒火。", "en": "Your resistance stirs my wrath."},
        {"zh": "我不能让你这么挡着。", "en": "I can't let you block me."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是不死之身。", "en": "I am an undead."},
        {"zh": "与我结合吧。", "en": "Mate with me."},
        {"zh": "我们彼此同类。", "en": "We are of the same kind."},
        {"zh": "我的力量来自灵魂。", "en": "My power comes from the soul."},
        {"zh": "我是不死之灵。", "en": "I am an immortal spirit."},
        {"zh": "我们的灵魂可以结合。", "en": "Our souls can intertwine."},
        {"zh": "我拥有不死之身。", "en": "I possess an immortal body."},
        {"zh": "让我与你共享力量。", "en": "Let me share my strength with you."},
        {"zh": "我的力量能助你长生。", "en": "My power can grant you immortality."},
        {"zh": "我们共结连理。", "en": "We unite in spirit."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "吸走了你的灵魂！", "en": "Sucked your soul away!"},
        {"zh": "我的剑是风的怒吼！", "en": "My sword is the howl of the wind!"},
        {"zh": "你闻不到死亡的气息吗？", "en": "Can't you smell the stench of death?"},
        {"zh": "灵魂的味道很好！", "en": "Tastes good, soul!"},
        {"zh": "这东西，我用风卷走。", "en": "I'll sweep this up with the wind."},
        {"zh": "死亡之风，环绕你的灵魂！", "en": "Death's wind surrounds your soul!"},
        {"zh": "你的呼吸将化为尘埃！", "en": "Your breath will be dust!"},
        {"zh": "这世界只剩下死亡！", "en": "This world is but death!"},
        {"zh": "我把掉落的刀鞘抄起来。", "en": "I snatch up the fallen sheath."},
        {"zh": "死亡之息，贯穿你的躯体！", "en": "Death's breath pierces your body!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "目标捕获！", "en": "Target acquired!"},
        {"zh": "风刃已经削到你的衣角。", "en": "A wind blade already shaves your hem."},
        {"zh": "我的剑刃上满是你的灵魂！", "en": "My blade is drenched in your soul!"},
        {"zh": "你只能等待死亡！", "en": "You wait for death!"},
        {"zh": "你的后颈汗毛立起来了。", "en": "The hairs on your nape rise."},
        {"zh": "你的生命即将终结！", "en": "Your life is ending!"},
        {"zh": "死亡将吞噬一切！", "en": "Death devours all!"},
        {"zh": "我会让你体验死亡！", "en": "I'll let you experience death!"},
        {"zh": "死亡已经降临！", "en": "Death has come!"},
        {"zh": "我一步跨过两丈距离。", "en": "One stride carries me twenty feet."},
        {"zh": "鬼的味道，近了。", "en": "The demon's stench draws near."},
        {"zh": "别跑，你跑不掉的。", "en": "Don't run. You cannot get away."},
        {"zh": "风之呼吸，起式。", "en": "Wind Breathing, first form."},
        {"zh": "这只鬼，我收了。", "en": "This demon is mine."},
        {"zh": "你身上有血的味。", "en": "You smell of blood."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "死亡之风，将你吞噬！", "en": "Death's wind devours you!"},
        {"zh": "风柱的刀不跟你讲情。", "en": "The Wind Hashira's blade shows no mercy."},
        {"zh": "风压压得你睁不开眼。", "en": "The wind pressure forces your eyes shut."},
        {"zh": "你的命不久矣！", "en": "Your life is fleeting!"},
        {"zh": "死亡之息在呼吸！", "en": "Death's breath in action!"},
        {"zh": "风柱出刀，恶鬼一个不留。", "en": "The Wind Hashira's blade spares no demon."},
        {"zh": "死亡的镰刀即将收割！", "en": "Death's scythe is about to reap!"},
        {"zh": "我的刀刃上沾着鬼血。", "en": "Demon blood clings to my blade."},
        {"zh": "你的灵魂将被夺走！", "en": "Your soul will be taken!"},
        {"zh": "死亡之影，紧随其后！", "en": "Death's shadow follows!"},
        {"zh": "风在转，刀也在转。", "en": "The wind turns, and so does my blade."},
        {"zh": "我先切你的手。", "en": "I'll take your hands first."},
        {"zh": "你退一步，我进三步。", "en": "You step back once; I step in three."},
        {"zh": "呼吸掀起了尘。", "en": "My breathing lifts the dust."},
        {"zh": "斩击会从上面来。", "en": "The cut comes from above."},
        {"zh": "你这招太慢了。", "en": "That move is too slow."},
        {"zh": "风里有你的破绽。", "en": "Your opening rides the wind."},
        {"zh": "我不留手，从不。", "en": "I never hold back. Never."},
        {"zh": "刀锋对着你的胸口。", "en": "My edge points at your chest."},
        {"zh": "站定，别让我等。", "en": "Stand still. Don't keep me waiting."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "风刃劈砍！", "en": "Slash with wind blades!"},
        {"zh": "疾风袭来！", "en": "Gale strikes!"},
        {"zh": "剑气横扫！", "en": "Sweep with sword energy!"},
        {"zh": "风之旋风斩！", "en": "Wind whirlwind slash!"},
        {"zh": "无影剑法！", "en": "Shadowless sword style!"},
        {"zh": "风涌剑影！", "en": "Wind surge sword shadow!"},
        {"zh": "疾风斩击！", "en": "Swift gale strike!"},
        {"zh": "风剑破空！", "en": "Wind sword breaks the void!"},
        {"zh": "风刃切割！", "en": "Wind blade cuts!"},
        {"zh": "剑影飘忽！", "en": "Sword shadow flickers!"},
        {"zh": "一之型，尘旋风。", "en": "First Form: Dust Whirlwind Cutter."},
        {"zh": "风刃切开了空气。", "en": "A wind blade splits the air."},
        {"zh": "连斩，不给喘息。", "en": "Cut after cut, no breath between."},
        {"zh": "这一下是还给鬼的。", "en": "This one is repaid to demons."},
        {"zh": "刀锋过后，风才到。", "en": "The wind arrives after the blade."},
        {"zh": "你的血溅在风里。", "en": "Your blood sprays into the wind."},
        {"zh": "别求饶，没用的。", "en": "Don't beg. It won't help."},
        {"zh": "再来一次，接得住吗？", "en": "Once more. Can you take it?"}
      ]
    },
