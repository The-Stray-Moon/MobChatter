        {"zh": "风之庇护！", "en": "Wind sanctuary!"},
        {"zh": "风之律动！", "en": "Wind rhythm!"},
        {"zh": "风柱降世！", "en": "Wind pillar descends!"},
        {"zh": "风柱到了，让路。", "en": "The Wind Hashira is here. Make way."},
        {"zh": "风卷起沙，我出现。", "en": "The wind lifts sand, and I appear."},
        {"zh": "这里鬼多，正好。", "en": "Plenty of demons here. Good."},
        {"zh": "刀在腰间，风在身后。", "en": "Blade at my waist, wind at my back."}
      ]
    },
