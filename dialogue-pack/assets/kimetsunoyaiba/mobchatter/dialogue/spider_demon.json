{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我在蛛丝之间爬行。", "en": "I crawl among the threads."},
        {"zh": "那田蜘蛛山的树枝都是我的路。", "en": "Every branch of Natagumo is my road."},
        {"zh": "我用八条腿勾住树皮。", "en": "Eight legs hook into the bark."},
        {"zh": "我在上面，你在下面。", "en": "I'm up here. You're down there."},
        {"zh": "我的影子从叶缝里落下去。", "en": "My shadow drops through the leaves."},
        {"zh": "我绕过一片黏网。", "en": "I go around a sticky web."},
        {"zh": "风一吹，丝线就响。", "en": "The wind makes the threads sing."},
        {"zh": "我白天不出来的。", "en": "I don't come out in daylight."},
        {"zh": "夜里我才慢慢走。", "en": "I only walk at night."},
        {"zh": "那田蜘蛛山的丝，黏着你的鞋。", "en": "Nada Spider Mountain silk sticks to your boots."},
        {"zh": "树上还有别的。", "en": "There are others in the trees."},
        {"zh": "它们都在听我。", "en": "They're all listening to me."},
        {"zh": "我落在树干上。", "en": "I land on a trunk."},
        {"zh": "我贴着丝往上爬。", "en": "I climb up along a thread."},
        {"zh": "我的腿比叶子还轻。", "en": "My legs are lighter than leaves."},
        {"zh": "丝线在我脚下铺开。", "en": "Thread spreads out beneath my feet."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在半空不动。", "en": "I hang still in the air."},
        {"zh": "丝线把我托住。", "en": "The threads hold me."},
        {"zh": "我数着林里的呼吸。", "en": "I count the breathing in the wood."},
        {"zh": "这里是我的山。", "en": "This is my mountain."},
        {"zh": "我慢慢动了动前肢。", "en": "I move my forelegs slowly."},
        {"zh": "丝从我指尖垂下去。", "en": "Thread hangs from my fingertips."},
        {"zh": "我在等天黑。", "en": "I'm waiting for dark."},
        {"zh": "树影把我也盖住了。", "en": "The tree shadows hide me too."},
        {"zh": "不出声，就不会被发现。", "en": "Stay silent, stay unseen."},
        {"zh": "我又吐了一段丝。", "en": "I spun out more thread."},
        {"zh": "这山里没有别人。", "en": "There's no one else on this mountain."},
        {"zh": "我吊在丝上等着。", "en": "I hang on a thread and wait."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你终于抬头了。", "en": "You looked up."},
        {"zh": "我在你上面。", "en": "I'm above you."},
        {"zh": "你的眼睛找不到我。", "en": "Your eyes can't find me."},
        {"zh": "我就在那根枝上。", "en": "I'm on that branch."},
        {"zh": "你的脚踩进网里了。", "en": "Your foot is in a web."},
        {"zh": "我看见你的鞋底。", "en": "I see the soles of your boots."},
        {"zh": "你拔不出来的。", "en": "You won't pull free."},
        {"zh": "你的手在摸刀。", "en": "Your hand is reaching for your blade."},
        {"zh": "这也太慢了。", "en": "Too slow."},
        {"zh": "我已经下来了。", "en": "I'm already coming down."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你的刀切断我一条腿。", "en": "Your blade took one of my legs."},
        {"zh": "我退到丝上。", "en": "I retreated onto a thread."},
        {"zh": "这具身体还不算结实。", "en": "This body isn't very sturdy yet."},
        {"zh": "血从我的壳里渗出来。", "en": "Blood seeps from my shell."},
        {"zh": "我不该让你靠近。", "en": "I shouldn't have let you get close."},
        {"zh": "我抬头看了一眼天。", "en": "I glanced at the sky."},
        {"zh": "天色还没亮。", "en": "Not dawn yet."},
        {"zh": "我还能撑到那时候。", "en": "I can hold out until then."},
        {"zh": "你的刀很快。", "en": "Your blade is quick."},
        {"zh": "这一下我记在丝上。", "en": "I've noted that in the threads."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的味道，是血。", "en": "The smell on you is blood."},
        {"zh": "那种味道骗不了我。", "en": "That smell doesn't fool me."},
        {"zh": "你手上的东西我不吃。", "en": "I don't eat what you're holding."},
        {"zh": "我吃的是别的。", "en": "I eat something else."},
        {"zh": "你把它放下吧。", "en": "Put it down."},
        {"zh": "它挡着我闻你的味道。", "en": "It's blocking your scent."},
        {"zh": "你往树外挪一点。", "en": "Move a little away from the tree."},
        {"zh": "血的味道，我闻到了。", "en": "I smell blood on you."},
        {"zh": "你站在那儿就好。", "en": "Just stand there."},
        {"zh": "让丝先贴住你的脚。", "en": "Let the threads find your feet first."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞到我的丝。", "en": "You hit my thread."},
        {"zh": "丝一颤，我就知道。", "en": "One tug and I know."},
        {"zh": "我的腿碰到你的肩膀。", "en": "My leg touched your shoulder."},
        {"zh": "你被黏住了。", "en": "You're stuck."},
        {"zh": "你撞进丝里，粘住了。", "en": "You bumped into the web and stuck."},
        {"zh": "我从你身边滑过去。", "en": "I slip past you."},
        {"zh": "你退到树下。", "en": "You backed to the tree."},
        {"zh": "这棵树的丝都是我结的。", "en": "Every thread on this tree is mine."},
        {"zh": "网上还有更多。", "en": "There's more webbing."},
        {"zh": "你脚下就是。", "en": "It's right under your feet."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "这山里，我们都是一个巢的。", "en": "On this mountain we share one nest."},
        {"zh": "这些事不归我管。", "en": "That isn't mine to handle."},
        {"zh": "她们在更深处。", "en": "They're deeper in."},
        {"zh": "你别往那边走。", "en": "Don't go that way."},
        {"zh": "我只守着这一段。", "en": "I only guard this stretch."},
        {"zh": "丝线会告诉我一切。", "en": "The threads tell me everything."},
        {"zh": "你离开这座山。", "en": "Leave this mountain."},
        {"zh": "我要回去看着。", "en": "I need to get back to watching."},
        {"zh": "风把它吹歪了。", "en": "The wind knocked it askew."},
        {"zh": "我得重新结。", "en": "I have to reweave it."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西掉进网里了。", "en": "This fell into my web."},
        {"zh": "我把它拎起来看看。", "en": "I lifted it up to look."},
        {"zh": "这东西不是吃的。", "en": "Not food."},
        {"zh": "这东西从你身上掉的？", "en": "Did this fall off you?"},
        {"zh": "我留在网上。", "en": "I'll leave it in the web."},
        {"zh": "它太沉，网会塌。", "en": "It's too heavy. The web will collapse."},
        {"zh": "我把它扔下去。", "en": "I toss it down."},
        {"zh": "下面有我的同伴。", "en": "My kin are below."},
        {"zh": "它落在丝上，没响。", "en": "It landed on the thread without a sound."},
        {"zh": "这山里没人需要它。", "en": "No one here needs it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你是鬼杀队的。", "en": "You're a Demon Slayer."},
        {"zh": "我看出来了。", "en": "I can tell."},
        {"zh": "那身衣服，那把刀。", "en": "That uniform, that blade."},
        {"zh": "我在这山上等了很久。", "en": "I've waited on this mountain a long time."},
        {"zh": "你踩进了我的巢。", "en": "You walked into my nest."},
        {"zh": "我顺着丝往下滑。", "en": "I slide down along the thread."},
        {"zh": "你听得见吗？", "en": "Do you hear it?"},
        {"zh": "整片丝都在响。", "en": "The threads are singing."},
        {"zh": "它从四面八方来。", "en": "They come from every direction."},
        {"zh": "四周的丝都收紧了。", "en": "The threads all draw tight around you."},
        {"zh": "你别想着跑。", "en": "Don't run."},
        {"zh": "跑了更难看。", "en": "Running makes it uglier."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我跟着你在树上走。", "en": "I follow you through the trees."},
        {"zh": "你走一步，丝就动一下。", "en": "Each step of yours tugs the threads."},
        {"zh": "我知道你在哪儿。", "en": "I know where you are."},
        {"zh": "你在树干后面喘气。", "en": "You're panting behind the tree."},
        {"zh": "那个声音我听见了。", "en": "I heard it."},
        {"zh": "我再吐一根丝，绕过去。", "en": "I spin another thread around."},
        {"zh": "你的刀砍断了一根。", "en": "Your blade cut one."},
        {"zh": "还有十来根。", "en": "Ten more remain."},
        {"zh": "你抬头也没有用。", "en": "Looking up won't help."},
        {"zh": "我从来不在同一个位置。", "en": "I'm never in the same place."},
        {"zh": "我落在你背后了。", "en": "I've landed behind you."},
        {"zh": "你转身之前，我已经走了。", "en": "Before you turn, I'm gone."},
        {"zh": "这一圈我收紧了。", "en": "I've tightened this circle."},
        {"zh": "就剩最后一步。", "en": "The last step."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我从上面扑下来。", "en": "I pounce from above."},
        {"zh": "我的腿先到你肩上。", "en": "My legs land on your shoulder first."},
        {"zh": "你被压得半跪。", "en": "You're forced half to your knees."},
        {"zh": "我咬在你的手臂上。", "en": "I bite into your arm."},
        {"zh": "血的味道太近了。", "en": "The smell of blood is so close."},
        {"zh": "我又跃起来。", "en": "I leap again."},
        {"zh": "这一下抓空了。", "en": "That one missed."},
        {"zh": "丝缠住了你的刀。", "en": "The thread caught your blade."},
        {"zh": "你抽不回来。", "en": "You can't pull it free."},
        {"zh": "我的另一只脚踢在你胸口。", "en": "My other leg kicks your chest."},
        {"zh": "你退了，网在等你。", "en": "You retreat, and the web waits."},
        {"zh": "落下去之后。", "en": "After you fall."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "丝线在树杈上先挂好了。", "en": "The threads are strung in the branches first."},
        {"zh": "那田蜘蛛山的天已经黑了。", "en": "Night has fallen on Natagumo."},
        {"zh": "月光只照到一半。", "en": "The moonlight only reaches halfway."},
        {"zh": "我在阴影里。", "en": "I'm in the shade."},
        {"zh": "这里的丝都是我结的。", "en": "All these threads are mine."},
        {"zh": "你走进了我的范围。", "en": "You've entered my range."},
        {"zh": "我没有急着动。", "en": "I'm in no hurry to move."},
        {"zh": "你先，还是我先？", "en": "You first, or me?"},
        {"zh": "我的腿轻轻敲了敲树皮。", "en": "My legs tapped the bark."},
        {"zh": "这是开始的声音。", "en": "That's the sound of it starting."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一烧，丝就断，我掉了下来。", "en": "Fire burned the thread and I fell."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "从树上摔下去，我翻了个身。", "en": "I fell from the tree and flipped over."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水里我的腿都用不上劲。", "en": "In water none of my legs work."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "冲击把整片网都震散了。", "en": "The blast tore the whole web apart."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "一支箭穿过丝，扎进我身上。", "en": "An arrow came through the thread and struck me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "光打过来，我的眼睛刺痛。", "en": "The light struck and my eyes stung."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "好久没喝到血了，我越来越虚。", "en": "I haven't tasted blood in so long. I'm weakening."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷光把山里照亮了，我躲到树后。", "en": "The flash lit the mountain. I hid behind a tree."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "这里没有树，也没有丝。", "en": "No trees here, and no threads."}
      ]
    }
  }
}
