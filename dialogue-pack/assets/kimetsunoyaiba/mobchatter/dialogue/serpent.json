{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着地面游过去。", "en": "I slither along the ground."},
        {"zh": "我的身子一层层推进。", "en": "My body pushes forward in waves."},
        {"zh": "我在草间留下弯曲的痕。", "en": "A winding track remains in the grass."},
        {"zh": "我绕着主人的脚转。", "en": "I circle my master's feet."},
        {"zh": "我抬高前半身看路。", "en": "I raise my front half to see."},
        {"zh": "我穿过一堆枯叶。", "en": "I slip through a pile of dead leaves."},
        {"zh": "我的舌头探了探空气。", "en": "My tongue tests the air."},
        {"zh": "我沿着墙根走。", "en": "I travel along the wall's base."},
        {"zh": "我从石缝里滑出来。", "en": "I slide out of a stone gap."},
        {"zh": "我慢慢跟上主人的步子。", "en": "I keep pace with my master."},
        {"zh": "我钻进木板的下面。", "en": "I slip under the floorboards."},
        {"zh": "我朝声音的方向游。", "en": "I glide toward the sound."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我盘成一团不动。", "en": "I coil into a still heap."},
        {"zh": "我的头慢慢抬起来。", "en": "My head rises slowly."},
        {"zh": "我吐着信子听觉动静。", "en": "I flick my tongue for sounds."},
        {"zh": "我在等主人示意。", "en": "I wait for my master's signal."},
        {"zh": "我的鳞在光下发暗。", "en": "My scales darken in the light."},
        {"zh": "我绕着屋柱盘上去。", "en": "I coil up the house post."},
        {"zh": "我一动不动，像根绳。", "en": "I hold still like a rope."},
        {"zh": "我慢慢收紧身子。", "en": "I slowly draw my body in."},
        {"zh": "我在听门外的脚步。", "en": "I listen to steps outside."},
        {"zh": "我的头贴着地面。", "en": "My head rests on the ground."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你比我高出太多了。", "en": "You stand far above me."},
        {"zh": "我在你的影子里。", "en": "I'm inside your shadow."},
        {"zh": "你的脚踝离我很近。", "en": "Your ankle is very near."},
        {"zh": "我嗅到了活人的气味。", "en": "I catch the scent of the living."},
        {"zh": "主人就在后面。", "en": "My master is just behind."},
        {"zh": "你别往前踩。", "en": "Don't step forward."},
        {"zh": "我的头一直朝着你。", "en": "My head stays pointed at you."},
        {"zh": "你没有看见我。", "en": "You haven't seen me."},
        {"zh": "这片地我熟。", "en": "I know this ground."},
        {"zh": "我慢慢盘高一点。", "en": "I coil a little higher."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我的身子被踩了一下。", "en": "My body got stepped on."},
        {"zh": "我盘得更紧了。", "en": "I coil tighter."},
        {"zh": "我退到墙角。", "en": "I retreat to the corner."},
        {"zh": "我的头有点发晕。", "en": "My head swims a little."},
        {"zh": "鳞上擦掉了一块。", "en": "A scale rubbed off."},
        {"zh": "我吐了吐信子，还行。", "en": "I flick my tongue. Still fine."},
        {"zh": "这点伤不碍游走。", "en": "This won't stop my sliding."},
        {"zh": "我慢慢爬到阴影里。", "en": "I crawl into the shadow."},
        {"zh": "我不叫，也不逃远。", "en": "I don't hiss, and I don't flee far."},
        {"zh": "主人还在。", "en": "My master is still here."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是活的东西？", "en": "Is that something alive?"},
        {"zh": "动一下，我就知道。", "en": "One twitch and I'll know."},
        {"zh": "这东西不新鲜。", "en": "That isn't fresh."},
        {"zh": "我只吃活的。", "en": "I eat only what moves."},
        {"zh": "你手别靠太近。", "en": "Don't bring your hand too close."},
        {"zh": "我慢慢把身子拉长。", "en": "I stretch my body out slowly."},
        {"zh": "这味道有点熟。", "en": "That smell is familiar."},
        {"zh": "搁在地上就好。", "en": "Just lay it on the ground."},
        {"zh": "我不吃死的。", "en": "I don't eat dead things."},
        {"zh": "它还在动吗？", "en": "Is it still moving?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你踩到了我的身子。", "en": "You stepped on my body."},
        {"zh": "我立刻绕开一截。", "en": "I immediately loop a length away."},
        {"zh": "别压着我的尾。", "en": "Don't press on my tail."},
        {"zh": "我的骨头很软，很韧。", "en": "My bones are soft and pliant."},
        {"zh": "我滑到你的另一侧。", "en": "I slide to your other side."},
        {"zh": "这点碰我就缩回去。", "en": "At that I recoil."},
        {"zh": "你差点踩断我。", "en": "You nearly snapped me."},
        {"zh": "我缠上了你的鞋带。", "en": "I've caught your bootlace."},
        {"zh": "我一甩就松开了。", "en": "One flick and I'm free."},
        {"zh": "再踩，我就钻到你身后。", "en": "Step again and I'll slip behind you."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我只是一条蛇。", "en": "I'm only a snake."},
        {"zh": "我只听主人的。", "en": "I heed only my master."},
        {"zh": "这些事与我无关。", "en": "Such things don't concern me."},
        {"zh": "别凑得这样近。", "en": "Don't draw this close."},
        {"zh": "我一靠近就咬。", "en": "I bite when approached."},
        {"zh": "同类在野地里。", "en": "My kind are in the wild."},
        {"zh": "我只会盘着。", "en": "I only coil."},
        {"zh": "我要去巡一圈了。", "en": "I'm off on a circuit."},
        {"zh": "你的脚让开。", "en": "Move your feet."},
        {"zh": "我得回主人身边了。", "en": "I must return to my master's side."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "一只小虫，我吞了。", "en": "A small insect, I swallow it."},
        {"zh": "这东西吞不下。", "en": "I can't swallow that."},
        {"zh": "我先闻，再张口。", "en": "I scent it, then open wide."},
        {"zh": "太硬，我吐出来。", "en": "Too hard, I spit it out."},
        {"zh": "我把它绕起来。", "en": "I loop around it."},
        {"zh": "有活物在附近。", "en": "Something living is near."},
        {"zh": "地上的东西我不碰。", "en": "I don't touch things on the ground."},
        {"zh": "它比我的头还大。", "en": "It's bigger than my head."},
        {"zh": "我不需要它。", "en": "I don't need it."},
        {"zh": "让给狗吧。", "en": "Leave it for the dogs."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "你动了。", "en": "You moved."},
        {"zh": "我的头已经对正。", "en": "My head is lined up."},
        {"zh": "我贴着地面，滑到你脚边。", "en": "I glide along the ground to your feet."},
        {"zh": "我伏在泥面上滑近。", "en": "I creep in along the mud."},
        {"zh": "你的脚踝最方便。", "en": "Your ankle is easiest."},
        {"zh": "主人会看着的。", "en": "My master is watching."},
        {"zh": "我慢慢盘紧。", "en": "I coil tighter."},
        {"zh": "你没有可退的地方。", "en": "You've nowhere left to retreat."},
        {"zh": "我从来不出声。", "en": "I never make a sound."},
        {"zh": "你听见草动了吗？", "en": "Did you hear the grass?"},
        {"zh": "动静是我弄的。", "en": "The rustle was mine."},
        {"zh": "我又换了位置。", "en": "I've moved again."},
        {"zh": "你再站一会。", "en": "Stand a while longer."},
        {"zh": "等我盘好。", "en": "Let me finish coiling."},
        {"zh": "就在这一刻。", "en": "At this very moment."},
        {"zh": "往上看。", "en": "Look upward."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我绕到你的脚后。", "en": "I loop behind your feet."},
        {"zh": "我压低身子贴着地。", "en": "I keep my body flat to the ground."},
        {"zh": "你看到的只是一根绳。", "en": "All you see is a rope."},
        {"zh": "我悄悄数着步数。", "en": "I quietly count your steps."},
        {"zh": "你往左，我往左绕。", "en": "You go left, I loop left."},
        {"zh": "你的鞋底没有感觉。", "en": "Your soles feel nothing."},
        {"zh": "我的舌头一直探着。", "en": "My tongue keeps testing."},
        {"zh": "那热量是你的。", "en": "That warmth is yours."},
        {"zh": "我盘了两圈。", "en": "I've made two coils."},
        {"zh": "第三圈会紧。", "en": "The third will tighten."},
        {"zh": "我竖起前半身，看你的手。", "en": "I rear up and watch your hands."},
        {"zh": "可我在下面。", "en": "But I'm below."},
        {"zh": "你看着前面。", "en": "You're watching ahead."},
        {"zh": "我已经在你脚边。", "en": "I'm already at your feet."},
        {"zh": "你的重心朝前倾了。", "en": "Your weight tipped forward."},
        {"zh": "这对我有利。", "en": "That favors me."},
        {"zh": "我慢慢收拢。", "en": "I draw in slowly."},
        {"zh": "你再退一步。", "en": "One more step back."},
        {"zh": "可以。", "en": "This will do."},
        {"zh": "就是这样。", "en": "Just like that."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我缠上你的小腿。", "en": "I coil around your calf."},
        {"zh": "我的头弹出去，又收回。", "en": "My head strikes out and snaps back."},
        {"zh": "我没咬中。", "en": "I missed the bite."},
        {"zh": "牙碰到你的靴子。", "en": "My teeth hit your boot."},
        {"zh": "我没有力气伤你。", "en": "I've no strength to hurt you."},
        {"zh": "我绕了两圈又滑掉。", "en": "Two coils, then I slip off."},
        {"zh": "你甩腿把我抖开了。", "en": "You shake me loose."},
        {"zh": "我又贴回你的脚边。", "en": "I press back to your feet."},
        {"zh": "这一下只是吓你。", "en": "That was only to startle you."},
        {"zh": "我的头撞在你膝上。", "en": "My head butts your knee."},
        {"zh": "我张了张嘴，没咬。", "en": "I open my mouth, but don't bite."},
        {"zh": "主人会替我出手。", "en": "My master will strike for me."},
        {"zh": "我只是缠住。", "en": "I only hold."},
        {"zh": "我不放。", "en": "I don't let go."},
        {"zh": "你走一步都会拖着我。", "en": "Every step drags me along."},
        {"zh": "我越缠越紧。", "en": "I coil tighter and tighter."},
        {"zh": "你的手够不到我。", "en": "Your hands can't reach me."},
        {"zh": "我在你的膝弯里。", "en": "I'm behind your knee."},
        {"zh": "你的脚踢了个空。", "en": "Your boot kicked empty air."},
        {"zh": "我还缠着呢。", "en": "I'm still coiled around."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从主人袖里滑出来。", "en": "I slide from my master's sleeve."},
        {"zh": "我落到地上，盘成一圈。", "en": "I drop to the ground and coil."},
        {"zh": "我在影子里抬起头。", "en": "I raise my head in the shadow."},
        {"zh": "我从釜鵺的袖口滑出来。", "en": "I slip out of Kaneki's sleeve."},
        {"zh": "我沿着主人的脚爬上一点。", "en": "I climb a little up my master's leg."},
        {"zh": "我吐了吐信子。", "en": "I flick my tongue."},
        {"zh": "这里的气味很新。", "en": "The scents here are new."},
        {"zh": "我慢慢展开身子。", "en": "I slowly uncoil."},
        {"zh": "我盘在门槛上。", "en": "I coil on the threshold."},
        {"zh": "我等着谁走近。", "en": "I wait for someone to come near."},
        {"zh": "地板下面很凉。", "en": "It's cool under the floor."},
        {"zh": "我先盘着不动。", "en": "I stay coiled and still."}
      ]
    },
    "hurt.fire": {
      "operation": "replace",
      "lines": [
        {"zh": "火一近，我的身子立刻缩。", "en": "Fire near, and my body shrinks at once."}
      ]
    },
    "hurt.fall": {
      "operation": "replace",
      "lines": [
        {"zh": "我从梁上掉下来，摔成一摊。", "en": "I fall from the beam in a loose heap."}
      ]
    },
    "hurt.drown": {
      "operation": "replace",
      "lines": [
        {"zh": "水淹过我的头，我往上游。", "en": "Water covers my head; I swim up."}
      ]
    },
    "hurt.explosion": {
      "operation": "replace",
      "lines": [
        {"zh": "气浪把我的身体吹直了。", "en": "The blast stretches me out straight."}
      ]
    },
    "hurt.projectile": {
      "operation": "replace",
      "lines": [
        {"zh": "这东西钉穿了我一截。", "en": "That pinned through a length of me."}
      ]
    },
    "hurt.magic": {
      "operation": "replace",
      "lines": [
        {"zh": "咒力把我的身子冻住了。", "en": "Magic freezes my whole body."}
      ]
    },
    "hurt.starvation": {
      "operation": "replace",
      "lines": [
        {"zh": "饿久了，我游得很慢。", "en": "Long hungry, I move slowly."}
      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷落下，我的身子一抽。", "en": "Lightning strikes, my body jerks."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "蛇身没处盘绕，只能垂着。", "en": "A snake body with nothing to coil around."}
      ]
    }
  }
}
