{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "铁甲环绕，怒吼震天！", "en": "Clad in iron, roar shakes the heavens!"},
        {"zh": "月光下挥剑，死神逼近！", "en": "Swing the sword under moonlight, death approaches!"},
        {"zh": "追击鬼杀队，无处藏身！", "en": "Chase the Ghostslayers, nowhere to hide!"},
        {"zh": "剑锋所指，死神将至！", "en": "Where the sword goes, death follows!"},
        {"zh": "黑影中疾驰，死亡近了！", "en": "Rushing through the shadows, death draws near!"},
        {"zh": "铁甲之下，死神降临！", "en": "Iron armor, death descends!"},
        {"zh": "月光下的铁甲战士！", "en": "Iron warrior under moonlight!"},
        {"zh": "挥剑杀敌，无尽的战斗！", "en": "Swinging the sword, endless battle!"},
        {"zh": "追寻敌人的脚步！", "en": "Following the enemy's footsteps!"},
        {"zh": "死亡气息，弥漫四周！", "en": "Death's aura, fills the air!"},
        {"zh": "气息收敛，脚步无声", "en": "My breath is banked; my steps make no sound."},
        {"zh": "月之呼吸流转于剑身", "en": "Moon Breathing flows along the blade."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "铁甲无言，肃杀之气！", "en": "Iron armor silent, chilling presence!"},
        {"zh": "静默中，死神来临！", "en": "In silence, death comes!"},
        {"zh": "月光下的守望者！", "en": "Watcher under moonlight!"},
        {"zh": "铁甲中的幽灵！", "en": "Ghost in iron armor!"},
        {"zh": "静待猎物的降临！", "en": "Waiting for prey to come!"},
        {"zh": "铁甲下的守夜人！", "en": "Night watchman in iron armor!"},
        {"zh": "静默中的死神！", "en": "Silent death!"},
        {"zh": "月光下的无声守卫！", "en": "Silent guardian under moonlight!"},
        {"zh": "铁甲中沉默的战士！", "en": "Silent warrior in iron armor!"},
        {"zh": "静默中，死神已至！", "en": "Silent, death is here!"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "月之呼吸，先斩你的刀。", "en": "Moon Breathing. Your blade goes first."},
        {"zh": "我闻到你剑上的冷汗。", "en": "I smell the cold sweat on your sword."},
        {"zh": "追踪敌人的脚步！", "en": "Following the enemy!"},
        {"zh": "月之呼吸，第一刀先给你。", "en": "Moon Breathing — the first cut is yours."},
        {"zh": "猎物的气息越来越近！", "en": "Prey's scent grows stronger!"},
        {"zh": "瞄准鬼杀队成员！", "en": "Targeting the Ghostslayer!"},
        {"zh": "猎物的气息越来越浓！", "en": "Prey's scent grows thick!"},
        {"zh": "我比你高出太多，低头看你。", "en": "I tower over you and look down."},
        {"zh": "月之呼吸，先看你一眼。", "en": "Moon Breathing — one look at you first."},
        {"zh": "这身队服，我认得", "en": "That Demon Slayer uniform — I know it."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "继国严胜气息虚弱", "en": "Tsugikuni's breath weakens"},
        {"zh": "继国严胜脚步蹒跚", "en": "Tsugikuni stumbles"},
        {"zh": "继国严胜眼神迷离", "en": "Tsugikuni's eyes waver"},
        {"zh": "继国严胜垂下头颅", "en": "Tsugikuni lowers his head"},
        {"zh": "继国严胜身躯摇晃", "en": "Tsugikuni's body trembles"},
        {"zh": "继国严胜蹒跚前行", "en": "Tsugikuni staggers forward"},
        {"zh": "继国严胜脚步沉重", "en": "Tsugikuni's steps are heavy"},
        {"zh": "继国严胜无力挥剑", "en": "Tsugikuni struggles to swing"},
        {"zh": "继国严胜倒地不起", "en": "Tsugikuni falls, unable to rise"},
        {"zh": "继国严胜气息奄奄", "en": "Tsugikuni's breath is fading"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上的血味引诱着我！", "en": "The blood scent on you tempts me!"},
        {"zh": "你体内蕴藏的生命能量…", "en": "The life energy in you..."},
        {"zh": "靠近我，你会感受到我的力量！", "en": "Come closer, you'll feel my power!"},
        {"zh": "我的剑能吞噬你的魂灵！", "en": "My sword devours your soul!"},
        {"zh": "你身上的光芒让我心动！", "en": "The light on you makes me desire!"},
        {"zh": "你端来的血，我闻到了。", "en": "I smell the blood you brought."},
        {"zh": "你的恐惧令我兴奋！", "en": "Your fear excites me!"},
        {"zh": "你血液中的力量让我痴迷！", "en": "The power in your blood drives me mad!"},
        {"zh": "你身上的气息…", "en": "The aura around you..."},
        {"zh": "你…逃不掉的！", "en": "You... can't escape!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我们的碰撞！", "en": "Our collision!"},
        {"zh": "你的攻击撞碎了我！", "en": "Your attack shattered me!"},
        {"zh": "你撞不破我的护甲！", "en": "You can't break my armor!"},
        {"zh": "我的剑刃撕裂了你！", "en": "My blade tore you apart!"},
        {"zh": "月之呼吸的残影还在。", "en": "The afterimages of moon breathing remain."},
        {"zh": "你撞过来，我的衣角没动。", "en": "You charge in, and even my hem stays still."},
        {"zh": "我们的力量在碰撞！", "en": "Our powers clash!"},
        {"zh": "你撞破了我的护盾！", "en": "You broke my shield!"},
        {"zh": "我们的力量相互抵消！", "en": "Our powers cancel each other out!"},
        {"zh": "剑鞘横挡，别靠近", "en": "My scabbard blocks you. Stay back."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我需要你的力量！", "en": "I need your power!"},
        {"zh": "让我们合为一体！", "en": "Let's merge into one!"},
        {"zh": "你是我完美的伴侣！", "en": "You're my perfect partner!"},
        {"zh": "与我结合，提升你的力量！", "en": "Unite with me, enhance your power!"},
        {"zh": "我的力量会保护你！", "en": "My strength will protect you!"},
        {"zh": "你的剑术，值得我并肩。", "en": "Your swordsmanship is worth standing beside."},
        {"zh": "你将是我完美的伴侣！", "en": "You'll be my perfect mate!"},
        {"zh": "我的力量将与你结合！", "en": "My power will merge with you!"},
        {"zh": "你将与我共存！", "en": "You'll coexist with me!"},
        {"zh": "让我们共同战斗！", "en": "Let's fight together!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "你手中的食物像是我的午餐！", "en": "Food in hand, perfect for lunch!"},
        {"zh": "那是我的晚餐，尝尝味道！", "en": "Dinner's on me, try it!"},
        {"zh": "喂，给点吃的，我饿了！", "en": "Hey, give me some food, I'm hungry!"},
        {"zh": "你那里有我可以享用的东西吗？", "en": "Do you have something I can feast on?"},
        {"zh": "我的胃在咕咕叫，给我点东西吃！", "en": "My stomach's growling, give me something to eat!"},
        {"zh": "食物！我需要补充能量！", "en": "Food! I need to replenish my energy!"},
        {"zh": "你要是不给吃的，我可不客气！", "en": "If you don't give me food, I won't be polite!"},
        {"zh": "我的肚子在催促我进食！", "en": "My stomach's urging me to eat!"},
        {"zh": "快点喂我吃，不然我会生气！", "en": "Feed me now, or I'll get angry!"},
        {"zh": "我需要食物来维持我的力量！", "en": "I need food to maintain my strength!"}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "队服上的纹章，我认得。", "en": "I know the crest on that uniform."},
        {"zh": "月之呼吸，从你影子里起。", "en": "Moon Breathing starts in your shadow."},
        {"zh": "你的刀法，我想看全。", "en": "I want to see your swordsmanship in full."},
        {"zh": "你的存在激起了我的食欲！", "en": "Your presence stirs my hunger!"},
        {"zh": "你跑不掉，我会追上你！", "en": "You can't escape, I'll catch you!"},
        {"zh": "享受最后的战斗吧，然后加入我！", "en": "Enjoy your last fight, then join me!"},
        {"zh": "鬼杀队的勇士，准备好成为我的食物了吗？", "en": "Scryer warrior, are you ready to be my food?"},
        {"zh": "你的生命即将结束，准备好了吗？", "en": "Your life is about to end, are you ready?"},
        {"zh": "品尝我的剑刃吧，你将化为我的力量！", "en": "Taste my blade, you'll become my strength!"},
        {"zh": "你逃不掉，我会抓住你！", "en": "You can't escape, I'll catch you!"},
        {"zh": "月之呼吸，起手", "en": "Moon Breathing — opening stance."},
        {"zh": "队服上绣着藤花", "en": "Wisteria is stitched on that uniform."},
        {"zh": "又一个送死的剑士", "en": "Another swordsman come to die."},
        {"zh": "斩鬼的人，轮到你", "en": "Demon slayer, now it is your turn."},
        {"zh": "你的气息露了破绽", "en": "Your breathing slipped half a beat."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "月亮的呼吸，第一型。", "en": "Moon Breathing, first form."},
        {"zh": "月之呼吸，剑技！", "en": "Breath of the Moon,剑技!"},
        {"zh": "我的剑刃将会终结你！", "en": "My blade will end you!"},
        {"zh": "月之呼吸，十六型齐出。", "en": "Moon Breathing, all sixteen forms."},
        {"zh": "我的六个瞳孔同时收缩。", "en": "All six of my pupils contract at once."},
        {"zh": "我的剑刃正在迫近！", "en": "My blade is closing in!"},
        {"zh": "你将被我的剑刃终结！", "en": "You will be ended by my blade!"},
        {"zh": "我的刀上覆着六只眼睛。", "en": "Six eyes open along my blade."},
        {"zh": "我的剑刃即将命中！", "en": "My blade is about to hit!"},
        {"zh": "你逃不开了，我要攻击！", "en": "You can't escape, I'm attacking!"},
        {"zh": "月牙的轨迹已画好", "en": "The crescent arc is already drawn."},
        {"zh": "先断你握刀的手", "en": "First I take your sword hand."},
        {"zh": "月华落下时你已中剑", "en": "When the moonlight falls, you are cut."},
        {"zh": "剑尖停在你的眉心前", "en": "My blade tip halts before your brow."},
        {"zh": "数到三，月轮合拢", "en": "On three, the moon wheel closes."},
        {"zh": "退路已被月光封死", "en": "Moonlight has sealed your retreat."},
        {"zh": "收势，再斩一剑", "en": "Recover the stance, cut again."},
        {"zh": "这一式，名叫月之呼吸", "en": "This form is called Moon Breathing."},
        {"zh": "你握刀的手在发抖", "en": "Your sword hand is shaking."},
        {"zh": "别眨眼，刀很快", "en": "Do not blink. The blade is fast."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "挥剑斩断黑暗！", "en": "Swing sword through darkness!"},
        {"zh": "继国严胜的怒吼！", "en": "Tsugikuni's rage!"},
        {"zh": "以剑术终结！", "en": "End with sword arts!"},
        {"zh": "我的剑，你的末日！", "en": "My sword, your end!"},
        {"zh": "近战之王出击！", "en": "Close combat king strikes!"},
        {"zh": "黑暗中闪现光芒！", "en": "Light in the darkness!"},
        {"zh": "用剑唤醒黎明！", "en": "Awaken dawn with sword!"},
        {"zh": "斩断你的生命线！", "en": "Cut your lifeline!"},
        {"zh": "挥剑破灭你！", "en": "Swing to obliterate you!"},
        {"zh": "黑暗中的终结者！", "en": "Terminator of darkness!"},
        {"zh": "一剑削过你的肩甲", "en": "One cut shaves your shoulder plate."},
        {"zh": "月牙形的斩击掠过", "en": "A crescent slash sweeps past."},
        {"zh": "刀锋擦着你的耳朵过去", "en": "The edge grazes past your ear."},
        {"zh": "横斩，收刀，血才落下", "en": "Slash, sheathe — only then does blood fall."},
        {"zh": "劈开你的防御架势", "en": "I cleave open your guard."},
        {"zh": "剑风先到，剑身随后", "en": "The wind arrives first, the blade after."},
        {"zh": "斩在护甲最薄的地方", "en": "I cut where the armor is thinnest."},
        {"zh": "回身一记斜斩", "en": "I turn and cut on the diagonal."}
      ]
