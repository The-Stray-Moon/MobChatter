    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我踏着落叶，没有声音。", "en": "I step on fallen leaves without a sound."},
        {"zh": "鬼杀队，我的目标！", "en": "Scryers, my target!"},
        {"zh": "月之呼吸的刃光比夜更深。", "en": "Moon Breathing shines darker than night."},
        {"zh": "月光落在我的第二张脸上。", "en": "Moonlight falls on my second face."},
        {"zh": "我是继国严胜！", "en": "I am Tsugikatsu!"},
        {"zh": "剑术与黑暗共舞！", "en": "Dance with darkness!"},
        {"zh": "寻找我的剑，你的命！", "en": "Find my sword, your life!"},
        {"zh": "月之呼吸，从影子里起。", "en": "Moon Breathing rises from the shadows."},
        {"zh": "黑暗中寻找力量！", "en": "Seek power in darkness!"},
        {"zh": "我是不死之身！", "en": "I am the undying!"},
        {"zh": "月下的剑士睁开眼", "en": "A swordsman opens his eyes under the moon."},
        {"zh": "我从传说里走出来", "en": "I step out of legend."},
        {"zh": "严胜之名，今夜重现", "en": "The name Michikatsu returns tonight."},
        {"zh": "鬼杀队的刀，由我来收", "en": "I will be the one collecting Demon Slayer blades."}
      ]
    },
