{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "阴风怒号。", "en": "Howling wind."},
        {"zh": "腐肉滋养。", "en": "Decaying flesh."},
        {"zh": "阴影中游走。", "en": "Wanders in shadows."},
        {"zh": "鬼火闪烁。", "en": "Flickering ghostfire."},
        {"zh": "饥渴难耐。", "en": "Hungry for blood."},
        {"zh": "我贴着墙根，不出声响。", "en": "I hug the wall and make no sound."},
        {"zh": "鲜血的味道。", "en": "Taste of blood."},
        {"zh": "阳光下消失。", "en": "Disappears in sunlight."},
        {"zh": "追着血气穿过林间", "en": "It tracks the scent of blood through the trees."},
        {"zh": "我落在瓦上的脚步没有声。", "en": "My steps on the tiles make no sound."},
        {"zh": "贴着树影滑行", "en": "It slides along the tree shadows."},
        {"zh": "用长爪划开灌木", "en": "It slashes the undergrowth aside with long claws."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "太阳一落，我才敢出来走动。", "en": "Only after sunset do I dare walk."},
        {"zh": "腐烂中苏醒。", "en": "Rising from decay."},
        {"zh": "天还没黑，我已经醒了。", "en": "The sky isn't dark, but I'm already awake."},
        {"zh": "天一亮，我这身皮就开始冒烟。", "en": "At dawn my skin starts to smoke."},
        {"zh": "鬼火微弱。", "en": "Dim ghostfire."},
        {"zh": "静候时机。", "en": "Patience pays off."},
        {"zh": "夜的宠儿。", "en": "Nights' favorite."},
        {"zh": "月光下的影子。", "en": "Shadow under moon."},
        {"zh": "腐臭的味道。", "en": "Stench of decay."},
        {"zh": "寂静中的低语。", "en": "Whispers in silence."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物出现了。", "en": "Prey in sight."},
        {"zh": "我在屋檐下盯了你很久。", "en": "I have watched you long from under the eaves."},
        {"zh": "你的血肉味，隔着墙也有。", "en": "I can smell your flesh through the wall."},
        {"zh": "视线追踪。", "en": "Tracking eyes."},
        {"zh": "黑暗中的眼睛。", "en": "Eyes in darkness."},
        {"zh": "靠近了，靠近了。", "en": "Closer, closer."},
        {"zh": "气息泄露。", "en": "Fragrance given."},
        {"zh": "你身上没有鬼的味道。", "en": "You don't smell like a demon."},
        {"zh": "你的血很鲜。", "en": "Your blood is fresh."},
        {"zh": "猎杀开始。", "en": "The hunt begins."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶嘶，疼！", "en": "Sssss, ow!"},
        {"zh": "太阳要出来了，我得躲。", "en": "The sun is coming. I must hide."},
        {"zh": "嗷，别摸！", "en": "Ow, don't touch!"},
        {"zh": "嘶，火了！", "en": "Sss, burning!"},
        {"zh": "咚，踩到了！", "en": "Ouch, stepped on!"},
        {"zh": "啊，掉水里了！", "en": "Ouch, fell in!"},
        {"zh": "轰，爆炸了！", "en": "Boom, exploded!"},
        {"zh": "咚，被投射物击中！", "en": "Pew, hit by projectile!"},
        {"zh": "嘶，电击了！", "en": "Zap, shocked!"},
        {"zh": "阳光没来，我却先伤了。", "en": "The sun hasn't come, yet I'm already hurt."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "贪婪的红眼注视你，诱惑你堕落。", "en": "Seductive red eyes peer at you."},
        {"zh": "吞噬灵魂，尝尝血之美味。", "en": "Savor the taste of blood."},
        {"zh": "近战诱惑，让你无法抗拒。", "en": "Close combat lures you in."},
        {"zh": "享受吞噬灵魂的乐趣。", "en": "Enjoy devouring souls."},
        {"zh": "那袋血食，比你更香。", "en": "That bag of blood food smells better than you."},
        {"zh": "来吧，加入我们吧。", "en": "Join us."},
        {"zh": "贪婪的心，无法抗拒的诱惑。", "en": "Greed, irresistible诱惑."},
        {"zh": "用鲜血证明你的忠诚。", "en": "Prove your loyalty with blood."},
        {"zh": "血的味道，我忍不住。", "en": "The smell of blood — I can't resist."},
        {"zh": "灵魂之火将你吞噬。", "en": "Soul flames consume you."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你的盾牌挡不住我的利爪。", "en": "Your shield can't block my claws."},
        {"zh": "撞击我的护甲，徒劳无功。", "en": "Collide with my armor."},
        {"zh": "你撞不到我。", "en": "You can't hit me."},
        {"zh": "试图伤害我，徒劳无功。", "en": "Try to hurt me."},
        {"zh": "我躲着阳光，不怕你。", "en": "I hide from sunlight, not from you."},
        {"zh": "用阳光刺瞎我的双眼。", "en": "Blind me with sunlight."},
        {"zh": "阳光让我畏惧，远离。", "en": "Sunlight scares me away."},
        {"zh": "试图伤害我，只会受伤。", "en": "Hurt yourself trying to hit me."},
        {"zh": "撞击无用，找错目标了。", "en": "Wrong target, collision fails."},
        {"zh": "躲开阳光，不然瞎掉。", "en": "Avoid sunlight or go blind."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
