        {"zh": "阴影中，悄无声息！", "en": "Silent in shadows!"},
        {"zh": "树林间，夜色中隐现！", "en": "Appears in the woods, in the night!"},
        {"zh": "森林边缘，静待猎物！", "en": "Wait by the forest edge!"},
        {"zh": "黑夜深处，悄然出现！", "en": "Appears deep in the night!"},
        {"zh": "群系里随机一个我。", "en": "One of me, somewhere in the biome."},
        {"zh": "黄昏到了，我出来走动。", "en": "Dusk comes, and I walk out."}
