{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶地蠕动着前行", "en": "Slithering forward hissingly"},
        {"zh": "发出嘶嘶声，缓缓移动", "en": "Hissing, moving slowly"},
        {"zh": "沿着地表滑行", "en": "Sliding along the ground"},
        {"zh": "移动时发出沙沙声", "en": "Makes rustling sounds while moving"},
        {"zh": "爬行速度缓慢", "en": "Moves slowly"},
        {"zh": "缓缓挪动着前行", "en": "Slithering slowly"},
        {"zh": "在草地上蠕动前行", "en": "Slithering on the grass"},
        {"zh": "沿着树林边缘移动", "en": "Moving along the edge of the forest"},
        {"zh": "缓缓地在灌木丛间移动", "en": "Moving slowly through the shrubs"},
        {"zh": "在石头上缓缓爬行", "en": "Slithering slowly over the rocks"},
        {"zh": "沿着香奈乎走过的路，我跟着。", "en": "I follow the road Kanawo once walked."},
        {"zh": "一步一步，我在草丛里挪。", "en": "Step by step, I shift through the grass."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "铜钱在我手里掂了又掂。", "en": "I weigh the coins in my hand."},
        {"zh": "我在等人开价。", "en": "I wait for someone to bid."},
        {"zh": "静静地待在原地", "en": "Staying still in place"},
        {"zh": "在阴影中缓慢蠕动", "en": "Slithering slowly in the shade"},
        {"zh": "懒懒地在草丛中趴着", "en": "Lazily lying in the grass"},
        {"zh": "我在集市边站着不动。", "en": "I stand still by the market."},
        {"zh": "在石头堆上晒太阳", "en": "Basking on the rock pile"},
        {"zh": "在树根间晒太阳", "en": "Basking among the tree roots"},
        {"zh": "懒懒地在湖边晒太阳", "en": "Basking lazily by the lake"},
        {"zh": "静静地躺在石缝中", "en": "Staying still in the rock crevice"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "注意到你后，慢慢靠近", "en": "Slowly approaching after noticing you"},
        {"zh": "盯住你，准备攻击", "en": "Fixing you with a stare, ready to attack"},
        {"zh": "盯着你看了一阵子", "en": "Stared at you for a while"},
        {"zh": "发现你后悄悄靠近", "en": "Approached quietly after spotting you"},
        {"zh": "我盯着你腰间的钱袋。", "en": "I watch the purse at your waist."},
        {"zh": "盯着你看，准备出手", "en": "Staring at you, ready to strike"},
        {"zh": "我用袖子遮住钱袋。", "en": "I hide my purse behind my sleeve."},
        {"zh": "我把你从头到脚估了个价。", "en": "I price you from head to toe."},
        {"zh": "我站在这里，看了你很久。", "en": "I have stood here watching you a long while."},
        {"zh": "凝视着你，准备出手", "en": "Gazing at you, ready to strike"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "呼，受伤了。", "en": "Aargh, hurt."},
        {"zh": "嘎，别咬我。", "en": "Ow, stop it."},
        {"zh": "嘶，快治伤。", "en": "Ouch, heal me."},
        {"zh": "呼，这伤非比寻常。", "en": "Aargh, this hurts."},
        {"zh": "呼，别再打了。", "en": "Aargh, stop hitting."},
        {"zh": "嘶，疼得我叫。", "en": "Ouch, it hurts."},
        {"zh": "呼，快用草药。", "en": "Aargh, herbs now."},
        {"zh": "嘶，快过来。", "en": "Ouch, help me."},
        {"zh": "呼，别再咬我。", "en": "Aargh, stop biting."},
        {"zh": "这一下，得记在账上。", "en": "I'll put that on the bill."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "看着我这身纹身，你还真动心了？", "en": "Check out my tattoos, you really want this?"},
        {"zh": "香奈乎的秘密，你愿意揭开吗？", "en": "Unravel Nekoa's secrets?"},
        {"zh": "你能否忍受与我共生？", "en": "Can you coexist with me?"},
        {"zh": "你的欲望让我兴奋。", "en": "Your desire excites me."},
        {"zh": "与我共享这片领地吧。", "en": "Share this land with me."},
        {"zh": "我可不会轻易被你诱惑。", "en": "Easy pickings, huh?"},
        {"zh": "你要是拒绝我，就得后悔。", "en": "Say no, and you'll regret it."},
        {"zh": "和我做朋友，如何？", "en": "Be my friend?"},
        {"zh": "你是第一个被我吸引的买家。", "en": "You're the first buyer I've attracted."},
        {"zh": "我的魅力，你经受得住吗？", "en": "Can you handle my charm?"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "看我的速度！", "en": "Watch my speed!"},
        {"zh": "我手里这点钱只够买一条命。", "en": "My coins can buy one life."},
        {"zh": "别想躲开我。", "en": "You can't avoid me."},
        {"zh": "来吧，我们试试。", "en": "Let's see what you've got."},
        {"zh": "别挡着，货要上路了。", "en": "Move, the goods must travel."},
        {"zh": "我们来较量一番。", "en": "Let's test each other."},
        {"zh": "我不会轻易让你通过。", "en": "I won't let you pass easily."},
        {"zh": "你走开，我有领地。", "en": "Get out of my way."},
        {"zh": "别想靠近我。", "en": "Stay away from me."},
        {"zh": "你挡了我的攻击。", "en": "You're blocking my attack."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "来，我们成为伴侣吧。", "en": "Come, be my mate."},
        {"zh": "我们互相扶持，共度一生。", "en": "We'll support each other."},
        {"zh": "一起探索未知的世界吧。", "en": "Explore the unknown together."},
        {"zh": "这桩买卖成了就成亲。", "en": "If the deal closes, we wed."},
        {"zh": "我们共享彼此的温暖。", "en": "We share each other's warmth."},
        {"zh": "让我成为你的唯一。", "en": "Be mine alone."},
        {"zh": "我们互相守护，直到永远。", "en": "We'll protect each other forever."},
        {"zh": "与我一起，你将无忧无虑。", "en": "You'll be free with me."},
        {"zh": "来，和我一起飞翔。", "en": "Fly with me."},
        {"zh": "我愿意与你相伴一生。", "en": "I'll be with you forever."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，寻找你的弱点。", "en": "Sssss, seeking your weakness."},
        {"zh": "香奈乎的味道真不错。", "en": "Nice snack, Naha."},
        {"zh": "你躲不了太久。", "en": "You can't hide forever."},
        {"zh": "别让我抓到你。", "en": "Don't let me catch you."},
        {"zh": "尝尝我的咬合吧。", "en": "Feel my bite."},
        {"zh": "靠近我，你死定了。", "en": "Come close, and you're done."},
        {"zh": "这地方适合藏匿。", "en": "Perfect place to hide."},
        {"zh": "我捡起地上掉的铜板。", "en": "I pick up the coin you dropped."},
        {"zh": "那点吃的，能分我一半吗？", "en": "Could you spare me half of that food?"},
        {"zh": "香奈乎的味道真美妙。", "en": "Naha tastes great."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "巷口有人在哭。", "en": "Someone is crying at the alley."},
        {"zh": "我只是来买东西的，别挡。", "en": "I'm only here to buy — don't block me."},
        {"zh": "香奈乎的气味很诱人。", "en": "Naha's scent is tempting."},
        {"zh": "你藏不住。", "en": "You can't hide."},
        {"zh": "香奈乎的旧账，我来算。", "en": "I've come to settle Kanao's old score."},
        {"zh": "我的耐心快耗尽了。", "en": "Patience runs thin."},
        {"zh": "靠近些，别让我失望。", "en": "Come closer, don't disappoint."},
        {"zh": "香奈乎的旧事，我记得。", "en": "I remember Kanao's old days."},
        {"zh": "买家已经在等了。", "en": "The buyer is already waiting."},
        {"zh": "这价钱，我还能再抬。", "en": "I can raise that price once more."},
        {"zh": "你的味道，和从前不一样。", "en": "You smell different from before."},
        {"zh": "我认得香奈乎的旧事。", "en": "I know Kanawo's old story."},
        {"zh": "买家来了，我得看看。", "en": "A buyer came; I must look."},
        {"zh": "别急着走，先谈笔买卖。", "en": "Don't rush off; let's make a deal."},
        {"zh": "你身上有刀的味道。", "en": "You carry the smell of a blade."},
        {"zh": "我在暗处认了你半天。", "en": "I studied you from the shadows."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我将享用你。", "en": "I will feast on you."},
        {"zh": "你的命运在我手中。", "en": "Your fate is in my hands."},
        {"zh": "我的毒，早抹在刀上了。", "en": "The poison's been on my blade all along."},
        {"zh": "别动，你会后悔的。", "en": "Don't move, you'll regret it."},
        {"zh": "香奈乎的过去，追到这里了。", "en": "Kanao's past has caught up here."},
        {"zh": "我记得你的脸。", "en": "I remember that face of yours."},
        {"zh": "我要品尝你。", "en": "I will taste you."},
        {"zh": "这姑娘能卖个好价钱。", "en": "This girl will fetch a good price."},
        {"zh": "我会杀死你。", "en": "I will kill you."},
        {"zh": "你活不了多久。", "en": "You won't last long."},
        {"zh": "价钱谈不拢，那就打。", "en": "If the price won't settle, we fight."},
        {"zh": "你手按刀柄了，我看得清。", "en": "Your hand's on the hilt; I see it."},
        {"zh": "我把价钱又抬高了一点。", "en": "I raise the price a little more."},
        {"zh": "我护甲薄，但位置好。", "en": "Thin armor, good position."},
        {"zh": "买卖谈崩了，你选错了人。", "en": "The deal is off. You chose the wrong person."},
        {"zh": "这块地我说了算。", "en": "This ground answers to me."},
        {"zh": "别以为我只有一分力气。", "en": "Don't think I only hit for one."},
        {"zh": "香奈乎当年也没这么急。", "en": "Even Kanawo wasn't this hasty."},
        {"zh": "买卖不成，情义也不成。", "en": "No deal means no mercy."},
        {"zh": "我只有二十点血，可也不退。", "en": "Only twenty points of health, and I still won't back down."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "嘶嘶作响，利爪挥出！", "en": "Sibilant hiss, swipe with claws!"},
        {"zh": "尖喙啄击，疼痛难忍！", "en": "Sharp beak peck, excruciating pain!"},
        {"zh": "咬住不放，撕裂皮肉！", "en": "Hold and tear flesh!"},
        {"zh": "利牙咬合，血流不止！", "en": "Clamp and drain blood!"},
        {"zh": "嘶嘶怒吼，撕裂空气！", "en": "Sibilant roar, rip air!"},
        {"zh": "挥舞双臂，重击敌体！", "en": "Waving arms, heavy strike!"},
        {"zh": "挥爪如风，命中要害！", "en": "Swing claws like wind, hit vital!"},
        {"zh": "咬紧牙关，一击致命！", "en": "Grind teeth, fatal blow!"},
        {"zh": "嘶嘶怒吼，凶残之徒！", "en": "Sibilant roar, fierce brute!"},
        {"zh": "挥爪乱击，无处可逃！", "en": "Swing claws wildly, nowhere to run!"},
        {"zh": "先给你一巴掌！", "en": "A slap to start with!"},
        {"zh": "我扯住你的衣角！", "en": "I grab your sleeve!"},
        {"zh": "一脚扫你膝盖！", "en": "A kick at your knees!"},
        {"zh": "撞过去，让你退！", "en": "I shove you back!"},
        {"zh": "这一拳，算旧账！", "en": "This punch settles an old debt!"},
        {"zh": "别怪我不讲情面！", "en": "Don't blame me for being rough!"},
        {"zh": "打在身上，疼在心里。", "en": "It hits your body, stings your pride."},
        {"zh": "我的拳头只值一分。", "en": "My fist is only worth one point."},
        {"zh": "你挡得住这招吗？", "en": "Can you block this one?"},
        {"zh": "打完这架，再谈价。", "en": "After this fight, we talk price."}
      ]
    },
    "spawn": {
