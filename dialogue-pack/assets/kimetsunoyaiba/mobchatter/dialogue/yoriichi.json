{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "日之剑挥舞，寒风凛冽。", "en": "Sword swings, chilling winds."},
        {"zh": "脚步踏过冰雪，寒光闪烁。", "en": "Footsteps on ice, cold light flickers."},
        {"zh": "呼吸间，寒气凝聚。", "en": "Breath forms frost."},
        {"zh": "寒霜覆盖，冰刃如影。", "en": "Frost covers, icy blades follow."},
        {"zh": "寒风中，身影飘忽。", "en": "Flickers in cold wind."},
        {"zh": "剑尖划破寒夜。", "en": "Sword slices through the cold night."},
        {"zh": "寒光中，身形疾行。", "en": "Flickers in cold light, quick form."},
        {"zh": "呼吸间，寒气四溢。", "en": "Breath, icy aura spreads."},
        {"zh": "冰霜之力，凝于指尖。", "en": "Frost power,凝聚指尖."},
        {"zh": "寒风中，剑光如龙。", "en": "Sword light, dragon in cold wind."},
        {"zh": "我的脚步轻得没有声音。", "en": "My steps are so light they make no sound."},
        {"zh": "刀在我腰间随步伐轻晃。", "en": "The blade at my hip sways with each step."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静默中，寒气缭绕。", "en": "Silent, cold aura swirls."},
        {"zh": "寒冰覆盖，静待时机。", "en": "Ice-covered, waiting."},
        {"zh": "呼吸间，寒意不散。", "en": "Breath, cold lingers."},
        {"zh": "寒霜凝聚，如静夜之影。", "en": "Frost, like a silent shadow."},
        {"zh": "寒光中，身形不动。", "en": "Flickers, still form."},
        {"zh": "寒气缭绕，静候猎物。", "en": "Cold aura, waiting prey."},
        {"zh": "呼吸间，寒气凝结。", "en": "Breath, cold condenses."},
        {"zh": "寒冰之下，静待破晓。", "en": "Ice below, waiting for dawn."},
        {"zh": "寒霜覆盖，悄然不动。", "en": "Frost, silent and still."},
        {"zh": "寒风中，静静等候。", "en": "Cold wind, waiting silently."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "猎物出现了，气息微弱。", "en": "Prey appears, faint scent."},
        {"zh": "猎物靠近，气息微弱。", "en": "Prey near, faint scent."},
        {"zh": "猎物的气息，微不可查。", "en": "Prey’s scent, barely there."},
        {"zh": "猎物的气息，微弱可闻。", "en": "Prey’s scent, faintly detectable."},
        {"zh": "日之呼吸第一式，站稳了。", "en": "Sun Breathing, first form. Stand firm."},
        {"zh": "猎物的气息，近在咫尺。", "en": "Prey’s scent, near."},
        {"zh": "猎物的气息，隐约可见。", "en": "Prey’s scent, faintly visible."},
        {"zh": "猎物的气息，越来越清晰。", "en": "Prey’s scent, growing clear."},
        {"zh": "你握刀的手，抖得越来越明显。", "en": "The hand on your sword trembles more each moment."},
        {"zh": "我抬眼，只看了你一下。", "en": "I lift my eyes and look at you once."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "剑痕刺痛我心。", "en": "The blade wounds me."},
        {"zh": "冥火舔舐我的皮甲。", "en": "The flames sear my armor."},
        {"zh": "腐土中我蹒跚。", "en": "I stagger through the decay."},
        {"zh": "饥饿啃咬我的意志。", "en": "Starvation gnaws at my resolve."},
        {"zh": "无尽黑暗侵蚀我魂。", "en": "Darkness eats my soul."},
        {"zh": "哀嚎在空旷中回响。", "en": "My howl echoes."},
        {"zh": "寒冰冻僵我的骨。", "en": "The cold freezes my bones."},
        {"zh": "烈日炙烤我皮肉。", "en": "The sun burns my flesh."},
        {"zh": "腐臭腐蚀我肌体。", "en": "Decay rots my flesh."},
        {"zh": "绝望吞噬我心。", "en": "Despair devours my heart."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你那点小玩意儿，对我没用！", "en": "Your little toys won't work on me!"},
        {"zh": "尝尝我的剑技吧！", "en": "Feel my sword technique!"},
        {"zh": "别想让我吃东西！", "en": "Don't think I'll eat anything!"},
        {"zh": "阳光下，恶鬼只能灭亡！", "en": "Under the sun, evil souls perish!"},
        {"zh": "你的食物，我的猎物！", "en": "Your food, my prey!"},
        {"zh": "这里是继国缘壹的领域！", "en": "This is Yoriichi's domain!"},
        {"zh": "日之呼吸，永生不灭！", "en": "The Way of the Sun, eternal and unbreakable!"},
        {"zh": "日之呼吸在我刀上。", "en": "Sun Breathing lives in my blade."},
        {"zh": "我的剑是不死之剑！", "en": "My sword is an undying blade!"},
        {"zh": "阳光是恶鬼的克星！", "en": "Sunlight is an evil soul's nemesis!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我的手按在刀柄上，你退了一步。", "en": "My hand rests on the hilt, and you take a step back."},
        {"zh": "日之呼吸，你的动作太慢。", "en": "Sun Breathing — your movement is too slow."},
        {"zh": "躲开我的剑！", "en": "Avoid my sword!"},
        {"zh": "我的护甲坚不可破！", "en": "My armor is impenetrable!"},
        {"zh": "你扑过来，我的刀已在你颈边。", "en": "You lunge; my blade is already at your neck."},
        {"zh": "日之呼吸的起手，你见过一次就够。", "en": "Once you have seen Sun Breathing's opening, enough."},
        {"zh": "我的攻击力远超你！", "en": "My attack power far exceeds yours!"},
        {"zh": "退后，否则受死！", "en": "Back off, or you'll die!"},
        {"zh": "你的碰撞对我无效！", "en": "Your collision won't work on me!"},
        {"zh": "你撞来，我侧身，衣角都没碰到。", "en": "You charge; I step aside, and you don't even touch my hem."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "别想靠近我的同伴！", "en": "Don't get close to my partner!"},
        {"zh": "保护好你的同类！", "en": "Protect your own!"},
        {"zh": "我的同类是无上的力量！", "en": "My kind are unmatched power!"},
        {"zh": "不要伤害我的盟友！", "en": "Don't harm my ally!"},
        {"zh": "恶鬼，你们离我的同类远点！", "en": "Evil souls, keep away from my kind!"},
        {"zh": "我的同类是不死之身！", "en": "My kind are undying!"},
        {"zh": "保护好你们的同类！", "en": "Protect your own!"},
        {"zh": "我的同类力量强大！", "en": "My kind are powerful!"},
        {"zh": "不要威胁我的同类！", "en": "Don't threaten my kind!"},
        {"zh": "我的同类是不死之灵！", "en": "My kind are undying spirits!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "吸取你的怨念。", "en": "Absorb your rage."},
        {"zh": "你身上的怨气足够我进食了。", "en": "Your怨气is sufficient for me to feed."},
        {"zh": "吞噬你的生命。", "en": "Consume your life."},
        {"zh": "你就是我新的食物。", "en": "You are my new meal."},
        {"zh": "怨念，滋养我。", "en": "Rage, nourish me."},
        {"zh": "刀出鞘，日轮就在刃上。", "en": "Blade drawn, the sun sits on the edge."},
        {"zh": "怨念能增强我。", "en": "Rage strengthens me."},
        {"zh": "吞噬你，成为我。", "en": "Devour you, become me."},
        {"zh": "你的怨念太弱了。", "en": "Your rage is too weak."},
        {"zh": "怨念是养分。", "en": "Rage is nourishment."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "感受到我的呼吸。", "en": "Feel my breathing."},
        {"zh": "我的眼睛看穿你的动作，慢得像水。", "en": "My eyes read your movement, slow as water."},
        {"zh": "恶鬼，是我的猎物。", "en": "Evil spirits, my prey."},
        {"zh": "日之呼吸，第一型已就位。", "en": "Sun Breathing, first form, in place."},
        {"zh": "感受我的气息吧。", "en": "Feel my presence."},
        {"zh": "日轮刀还没出鞘，我看清了你的呼吸。", "en": "My sun blade stays sheathed — I've read your breathing."},
        {"zh": "你藏在树后，可你的气在动。", "en": "You hide behind the tree, but your breath still moves."},
        {"zh": "日之呼吸，第一式到第十三式。", "en": "Sun Breathing, first form through thirteenth."},
        {"zh": "我数着你的心跳，一下，两下。", "en": "I count your heartbeats, one, two."},
        {"zh": "感受到我的存在吧。", "en": "Feel my presence."},
        {"zh": "我看见了你，也看见结局。", "en": "I see you, and I see how this ends."},
        {"zh": "恶鬼的影子逃不过我的眼。", "en": "A demon's shadow cannot escape my eyes."},
        {"zh": "我把刀抽出半寸。", "en": "I draw the blade half an inch."},
        {"zh": "日轮刀映出了你的脸。", "en": "My sun blade mirrors your face."},
        {"zh": "我已经先动了一步。", "en": "I have already moved a step ahead."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我的剑技将消灭你。", "en": "My sword skills will destroy you."},
        {"zh": "我吸气，刀锋划出一道圆弧。", "en": "I breathe in, and my blade carves an arc."},
        {"zh": "感受死亡的滋味。", "en": "Feel the taste of death."},
        {"zh": "日轮刀出鞘，光沿着刃口走。", "en": "The sun blade leaves its sheath, light running down the edge."},
        {"zh": "恶鬼，我的剑已准备好。", "en": "Evil spirits, my sword is ready."},
        {"zh": "死亡将降临。", "en": "Death will come."},
        {"zh": "感受死亡的冰冷。", "en": "Feel the coldness of death."},
        {"zh": "我的剑将终结你。", "en": "My sword will end you."},
        {"zh": "死亡将吞噬你。", "en": "Death will consume you."},
        {"zh": "刀尖指向你，我只走直线。", "en": "My blade points at you; I walk only straight."},
        {"zh": "我的呼吸收进了腹腔。", "en": "My breathing sinks into my core."},
        {"zh": "我站在阳光的斜角里。", "en": "I stand in the slant of the sunlight."},
        {"zh": "我的刀尖垂向地面。", "en": "My blade tip hangs toward the ground."},
        {"zh": "我在算你出手的角度。", "en": "I am measuring the angle of your strike."},
        {"zh": "空气忽然变热了。", "en": "The air suddenly grows hot."},
        {"zh": "十二个型，我已选好。", "en": "Twelve forms, and I have picked one."},
        {"zh": "我半步也不会让。", "en": "I will not yield half a step."},
        {"zh": "我把影子踩在脚下。", "en": "I stand on my own shadow."},
        {"zh": "我的眼睛没有眨。", "en": "My eyes do not blink."},
        {"zh": "一线日光落在我的刀脊上。", "en": "A thread of sunlight lands on my blade's spine."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "挥剑斩鬼，日之光芒！", "en": "Slash ghosts, solar power!"},
        {"zh": "剑刃飞舞，恶鬼必亡！", "en": "Sword slices, evil dies!"},
        {"zh": "日光剑下，无处遁形！", "en": "Sunlight swords, nowhere to hide!"},
        {"zh": "日之呼吸，斩断一切！", "en": "Sun Breathing, cut through all!"},
        {"zh": "剑锋所向，鬼魂崩溃！", "en": "Sword path, ghosts collapse!"},
        {"zh": "挥剑如风，斩鬼如麻！", "en": "Swing sword like wind, cut ghosts easily!"},
        {"zh": "日辉剑影，鬼魂颤抖！", "en": "Sunlight shadow, ghosts shiver!"},
        {"zh": "剑舞日光，恶鬼绝望！", "en": "Sword dance sunlight, evil despair!"},
        {"zh": "日之剑锋，恶鬼灰飞烟灭！", "en": "Sun blade, evil ashes to ashes!"},
        {"zh": "挥剑如割草，恶鬼难逃！", "en": "Swing like cutting grass, evil nowhere to hide!"},
        {"zh": "我一刀斩落，日光顺锋！", "en": "My cut falls, sunlight running down the edge!"},
        {"zh": "炎阳的弧线划过你的胸口！", "en": "An arc of sun fire crosses your chest!"},
        {"zh": "我旋身，刀光如日轮！", "en": "I spin, my blade a wheel of sun!"},
        {"zh": "刀锋掠过，留下灼痕！", "en": "My edge passes, leaving a burn!"},
        {"zh": "我的圆舞斩击没有缝隙！", "en": "My dance-like cut has no gap in it!"},
        {"zh": "我一步切入，刀已收势！", "en": "One step in, and my blade is already back!"},
        {"zh": "日光从我的刀尖射出！", "en": "Sunlight shoots from my blade tip!"},
        {"zh": "我抬手，火焰般的一斩！", "en": "I raise my arm for a flame-like cut!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "黑暗中，我苏醒了...", "en": "Awaken in the darkness..."},
        {"zh": "黎明的阴影，我之猎场...", "en": "Dawn's shadow, my hunting ground..."},
        {"zh": "日之呼吸，我之力量...", "en": "Sun Breathing, my power..."},
        {"zh": "恶鬼近了，准备战斗...", "en": "Evil near, prepare to fight..."},
        {"zh": "日之光芒，驱散黑暗...", "en": "Sunlight dispels darkness..."},
        {"zh": "日之呼吸，我之使命...", "en": "Sun Breathing, my mission..."},
        {"zh": "等待黎明，战斗开始...", "en": "Wait for dawn, battle begins..."},
        {"zh": "恶鬼，迎接死亡吧...", "en": "Evil, meet your death..."},
        {"zh": "日之剑锋，切割黑暗...", "en": "Sun blade, cut through darkness..."},
        {"zh": "我，继国缘壹，日之呼吸...", "en": "I, Yoriichi Tsugikuni, Sun Breathing..."},
        {"zh": "太阳升起时我已在此。", "en": "When the sun rose, I was already here."},
        {"zh": "空气里多了一道灼热。", "en": "A line of heat enters the air."},
        {"zh": "我从光里走出来。", "en": "I walk out of the light."},
        {"zh": "刀未出鞘，威压先至。", "en": "Sheathed blade, yet my pressure comes first."}
      ]
    },
