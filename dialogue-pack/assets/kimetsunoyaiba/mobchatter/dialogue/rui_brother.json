    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "嘿！我是Rui Brother！", "en": "Hey! I'm Rui Brother!"},
        {"zh": "欢迎来到那田蜘蛛山！", "en": "Welcome to Spider Mountain!"},
        {"zh": "我是蜘蛛鬼哥哥！", "en": "I'm Spider Ghost Brother!"},
        {"zh": "那田蜘蛛山，蛛网缠住你了。", "en": "On Natagumo, my web has you."},
        {"zh": "小心我的丝，毒就藏在蛛网里。", "en": "Mind my silk; the venom hides in the web."},
        {"zh": "我是Rui Brother，鬼杀队的敌人！", "en": "I'm Rui Brother, enemy of the Ghost Slayer Squad!"},
        {"zh": "这里常有鬼杀队成员出没！", "en": "Ghost Slayers often come here!"},
        {"zh": "我的家在这黑暗的洞穴中！", "en": "My home is in these dark caves!"},
        {"zh": "我是那田蜘蛛山的守护者！", "en": "I'm the guardian of Spider Mountain!"},
        {"zh": "这里是我的领地，别想离开！", "en": "This is my domain, don't try to escape!"}
      ]
    },
