{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "八爪挥舞，沙沙作响。", "en": "Eight arms swing, rustling."},
        {"zh": "鬼力缠绕，步步紧逼。", "en": "Ghostly force wraps,步步紧逼."},
        {"zh": "蛛丝缠绕，我来捕猎。", "en": "Spidersilk wraps, I hunt."},
        {"zh": "那田蜘蛛山，我的巢穴。", "en": "That Spider Mountain, my lair."},
        {"zh": "血鬼术，我之杀招。", "en": "Blood ghost technique, my kill."},
        {"zh": "猎物靠近，饥肠辘辘。", "en": "Prey near, stomach growls."},
        {"zh": "八条腿，八条命。", "en": "Eight legs, eight lives."},
        {"zh": "蜘蛛鬼，天生捕手。", "en": "Spider ghost, born hunter."},
        {"zh": "追逐鬼杀队，永无止境。", "en": "Chase Demon Slayer, endless."},
        {"zh": "毒液注入，痛不欲生。", "en": "Poison injected, unbearable."},
        {"zh": "丝线拉直了，我在上面走。", "en": "The threads pull taut; I walk on them."},
        {"zh": "从一棵树荡到另一棵树。", "en": "I swing from tree to tree."},
        {"zh": "蛛网在身后铺开。", "en": "My web spreads out behind me."},
        {"zh": "脚踩过的地方都粘着丝。", "en": "Threads stick wherever my feet touch."},
        {"zh": "我贴着石壁横着爬。", "en": "I crawl sideways along the cliff."},
        {"zh": "夜里的山，我走得很熟。", "en": "I know this mountain well at night."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "静候猎物，耐心如斯。", "en": "Wait for prey, patient."},
        {"zh": "蜘蛛洞穴，安详如梦。", "en": "Spider den, dreamlike."},
        {"zh": "八爪轻摆，伺机而动。", "en": "Eight arms sway, wait."},
        {"zh": "那田蜘蛛山，我之归宿。", "en": "That Spider Mountain, my home."},
        {"zh": "猎杀游戏，永无休止。", "en": "Hunting game, endless."},
        {"zh": "毒液待命，随时出击。", "en": "Poison ready, strike anytime."},
        {"zh": "蜘蛛之魂，黑暗主宰。", "en": "Spider soul, dark lord."},
        {"zh": "耐心等待，猎物现身。", "en": "Wait patiently, prey appears."},
        {"zh": "八条腿，八种可能。", "en": "Eight legs, eight possibilities."},
        {"zh": "静静等待，猎物到来。", "en": "Silently wait, prey comes."},
        {"zh": "一根丝垂下来，慢慢晃。", "en": "A single thread hangs and sways."},
        {"zh": "我数着网上粘住的虫。", "en": "I count the insects stuck in my web."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "鬼眼闪烁，锁定目标。", "en": "Ghost eyes shine, target locked."},
        {"zh": "猎物现身，我来收割。", "en": "Prey seen, time to harvest."},
        {"zh": "猎物靠近，蛛丝紧绷。", "en": "Prey near, silk taut."},
        {"zh": "猎物颤抖，命悬一线。", "en": "Prey trembles, fate in balance."},
        {"zh": "猎物慌张，蛛网编织。", "en": "Prey panics, web weaves."},
        {"zh": "猎物在逃，蛛丝缠绕。", "en": "Prey runs, silk traps."},
        {"zh": "猎物慌乱，我来收割。", "en": "Prey in chaos, time to harvest."},
        {"zh": "猎物逃窜，蛛网拦截。", "en": "Prey flees, web blocks."},
        {"zh": "猎物惊慌，我来终结。", "en": "Prey in fear, end now."},
        {"zh": "猎物落入，我之囊中。", "en": "Prey trapped, in my net."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "哎呀，被你打中了！", "en": "Ouch, hit by you!"},
        {"zh": "啊！你打疼我了！", "en": "Ah! You hurt me!"},
        {"zh": "这回被你打伤了！", "en": "Got hit by you this time!"},
        {"zh": "我有点受伤了……", "en": "A bit wounded now..."},
        {"zh": "别打了，我投降！", "en": "Stop, I surrender!"},
        {"zh": "饶命啊！你打得太狠了！", "en": "Mercy! You hit too hard!"},
        {"zh": "啊！又被你打伤了！", "en": "Ouch! Hit again!"},
        {"zh": "这回你打得有点狠！", "en": "You hit a bit hard this time!"},
        {"zh": "被你打中了，哎呀！", "en": "Hit by you, ouch!"},
        {"zh": "你打伤我了！", "en": "You wounded me!"}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "听到美食，你来了？", "en": "Got food? Here you come."},
        {"zh": "想吃我的网吗？", "en": "Want my web?"},
        {"zh": "被诱饵吸引？", "en": "Bitten by a lure?"},
        {"zh": "享受这丝滑美味吧！", "en": "Enjoy this silky treat!"},
        {"zh": "蛛丝已经缠上他的脚踝了。", "en": "My silk is already wrapped around his ankle."},
        {"zh": "吃掉它们，兄弟！", "en": "Eat them, brother!"},
        {"zh": "食物不够吗？", "en": "Not enough food?"},
        {"zh": "美味就在附近！", "en": "Tasty morsels nearby!"},
        {"zh": "快点享用我的晚餐！", "en": "Quick, have my dinner!"},
        {"zh": "来吧，享受我的美食！", "en": "Come, enjoy my feast!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "不要碰我的网！", "en": "Don't touch my web!"},
        {"zh": "小心，撞上我！", "en": "Be careful, hit me!"},
        {"zh": "蛛丝已经铺到你的脚下了。", "en": "My webbing is already under your feet."},
        {"zh": "不要靠近，小心被咬！", "en": "Stay back, or I bite!"},
        {"zh": "你撞断了我一根丝，赔得起吗。", "en": "You snapped one of my threads. Can you pay for it?"},
        {"zh": "蜘蛛丝已经布在你脚下。", "en": "My spider silk is already under your feet."},
        {"zh": "别撞上我的丝线！", "en": "Don't hit my silk!"},
        {"zh": "靠近我，你会遭殃！", "en": "Come closer, you'll suffer!"},
        {"zh": "别碰我，你会受伤！", "en": "Don't touch me, you'll be hurt!"},
        {"zh": "小心，别撞上我！", "en": "Be careful, don't hit me!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "来，跟我交配！", "en": "Come, mate with me!"},
        {"zh": "蛛丝一样的家，需要个伴。", "en": "A home of spider silk needs a partner."},
        {"zh": "山里的同类，只剩我一个了。", "en": "I am the last of my kind on this mountain."},
        {"zh": "蜘蛛山上，我认准了你。", "en": "On Spider Mountain, I have picked you."},
        {"zh": "找个伴吧，兄弟！", "en": "Find a partner, brother!"},
        {"zh": "和我交配，你会幸福！", "en": "Mate with me, you'll be happy!"},
        {"zh": "蜘蛛山上的网，替我说亲。", "en": "My webs on Spider Mountain do the courting."},
        {"zh": "你值得和我交配！", "en": "You deserve to mate with me!"},
        {"zh": "和我交配，你会快乐！", "en": "Mate with me, you'll be happy!"},
        {"zh": "蜘蛛山的丝，就是我们共同的家。", "en": "The threads of Spider Mountain are our shared home."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "这食物还不错，就吃了吧。", "en": "Mmm, not bad, I’ll munch on this."},
        {"zh": "终于找到吃的了，干得好！", "en": "Food found, good job!"},
        {"zh": "食物就在手边，直接享用。", "en": "Food at hand, time to feast."},
        {"zh": "这是我的午餐，谢谢。", "en": "My lunch, thanks."},
        {"zh": "食物不够，还得找更多。", "en": "More food needed, hunt on."},
        {"zh": "这里的食物很多，可以饱餐一顿。", "en": "Plenty of food here, good meal coming."},
        {"zh": "吃掉，吃掉，吃掉！", "en": "Eat, eat, eat!"},
        {"zh": "这食物是给我的，快快享用。", "en": "Mine, eat now."},
        {"zh": "食物在动，去咬它！", "en": "It’s moving, bite it!"},
        {"zh": "这团丝是我的，谁也别碰。", "en": "This bundle of silk is mine. No one touch it."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "鬼杀队，我要吃掉你们！", "en": "Yakuza, time to eat you!"},
        {"zh": "猎物就在眼前，抓住它！", "en": "Prey, grab it!"},
        {"zh": "那田蜘蛛山的猎物，是我的！", "en": "Prey of That Spider Mountain, mine!"},
        {"zh": "鬼杀队成员，我要吃掉你们！", "en": "Yakuza, time to eat you!"},
        {"zh": "我的猎物，逃不掉！", "en": "My prey, nowhere to run!"},
        {"zh": "那田蜘蛛山的猎物，是我的猎物！", "en": "That Spider Mountain’s prey, mine!"},
        {"zh": "鬼杀队，别跑！我要吃掉你们！", "en": "Yakuza, no escape! Time to eat you!"},
        {"zh": "这鬼杀队成员是我的，抓住他们！", "en": "Yakuza is mine, grab them!"},
        {"zh": "我要吃掉那田蜘蛛山的猎物！", "en": "That Spider Mountain’s prey, time to eat!"},
        {"zh": "猎物就在眼前，我不放过的！", "en": "Prey in sight, I won’t let go!"},
        {"zh": "日轮刀的刀光，我认得。", "en": "I know the glint of a nichirin blade."},
        {"zh": "鬼杀队上山了，哥哥先上。", "en": "The Demon Slayers climbed—big brother goes first."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我挂在枝头，等他走进丝里。", "en": "I hang from a branch and wait for him to enter the silk."},
        {"zh": "我要咬碎你的头！", "en": "Crush your head!"},
