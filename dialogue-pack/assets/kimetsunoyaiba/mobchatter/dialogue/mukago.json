{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我踏着月光走", "en": "I walk in the moonlight."},
        {"zh": "我在树影里移动", "en": "I move through the tree shadows."},
        {"zh": "我脚步很轻", "en": "My steps are light."},
        {"zh": "我贴着墙根走", "en": "I follow the base of the wall."},
        {"zh": "我的指甲太长", "en": "My nails are too long."},
        {"zh": "我绕开阳光", "en": "I go around the sunlight."},
        {"zh": "我慢慢靠近", "en": "I come closer slowly."},
        {"zh": "我在月光里一步步逼过去", "en": "I close in through the moonlight."},
        {"zh": "我从屋檐下走", "en": "I walk under the eaves."},
        {"zh": "我在林子里转", "en": "I circle through the woods."},
        {"zh": "我抬头看了看月亮", "en": "I glance at the moon."},
        {"zh": "我走到暗处才停", "en": "I stop only in the dark."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我在暗处等着", "en": "I wait in the dark."},
        {"zh": "天快亮了", "en": "Dawn is close."},
        {"zh": "血还不够", "en": "Not enough blood yet."},
        {"zh": "我在听林子里的声音", "en": "I listen to the forest."},
        {"zh": "我的牙很尖", "en": "My teeth are sharp."},
        {"zh": "我缩在阴影里", "en": "I huddle in the shadow."},
        {"zh": "这只鬼的身体很轻", "en": "This demon body is light."},
        {"zh": "我在看远处的灯火", "en": "I watch the distant lights."},
        {"zh": "我不想再死一次", "en": "I do not want to die again."},
        {"zh": "我慢慢收起指甲", "en": "I retract my nails slowly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有血的味道", "en": "You smell of blood."},
        {"zh": "你是鬼杀队的吗", "en": "Are you a Demon Slayer?"},
        {"zh": "我记得那种刀", "en": "I remember that kind of blade."},
        {"zh": "我不是来找你的", "en": "I did not come for you."},
        {"zh": "我打不过你", "en": "I cannot beat you."},
        {"zh": "你要杀我吗", "en": "Are you going to kill me?"},
        {"zh": "太阳要出来了", "en": "The sun is coming."},
        {"zh": "我们可以在暗处说话", "en": "We could talk in the shadows."},
        {"zh": "你别逼我", "en": "Do not force me."},
        {"zh": "我只想活久一点", "en": "I only want to live a little longer."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "你的刀划开我了", "en": "Your blade cut me."},
        {"zh": "血从我身上流下来", "en": "Blood runs down me."},
        {"zh": "我退到树下", "en": "I retreat under the trees."},
        {"zh": "这具身体也会疼", "en": "Even this body feels pain."},
        {"zh": "我的指甲断了一根", "en": "One of my nails broke."},
        {"zh": "你比我想的快", "en": "You are faster than I thought."},
        {"zh": "我喘不上气", "en": "I cannot catch my breath."},
        {"zh": "伤口在慢慢合", "en": "The wound is slowly closing."},
        {"zh": "我还能再撑一会", "en": "I can hold on a while longer."},
        {"zh": "别再来一刀", "en": "Not another cut."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "那是血吗", "en": "Is that blood?"},
        {"zh": "你手上的伤还没好", "en": "Your hand is still bleeding."},
        {"zh": "那味道让我难受", "en": "That smell torments me."},
        {"zh": "我只要一点点", "en": "I need only a little."},
        {"zh": "你把手放低点", "en": "Lower your hand."},
        {"zh": "我快控制不住了", "en": "I can barely hold back."},
        {"zh": "别让我闻太久", "en": "Do not let me smell it long."},
        {"zh": "你退开就好", "en": "Just step away."},
        {"zh": "我咬一下就走", "en": "One bite and I am gone."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "你撞上我这副鬼身", "en": "You hit this demon body."},
        {"zh": "我的身体很轻", "en": "My body is light."},
        {"zh": "你退开点", "en": "Back off a little."},
        {"zh": "我差点摔倒", "en": "I nearly fell."},
        {"zh": "我的手碰到你的刀", "en": "My hand brushed your blade."},
        {"zh": "我躲得不算慢", "en": "I dodge fairly well."},
        {"zh": "你压过来我就没路了", "en": "Press me and I have no way out."},
        {"zh": "别抓我的手腕", "en": "Do not grab my wrist."},
        {"zh": "我退到树后", "en": "I retreat behind a tree."},
        {"zh": "再逼我就要动手", "en": "Push me more and I will fight."}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "我是鬼", "en": "I am a demon."},
        {"zh": "我没有那些心思", "en": "I have no such thoughts."},
        {"zh": "天亮之前我得走", "en": "I must leave before dawn."},
        {"zh": "别站在月光下", "en": "Do not stand in the moonlight."},
        {"zh": "你不该问这个", "en": "You should not ask that."},
        {"zh": "我没时间", "en": "I have no time."},
        {"zh": "这不重要", "en": "That does not matter."},
        {"zh": "我不想多说", "en": "I do not want to talk about it."},
        {"zh": "让我安静一会", "en": "Let me be quiet a while."},
        {"zh": "你走开吧", "en": "Walk away."}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "我捡起来看了看", "en": "I picked it up and looked."},
        {"zh": "这不是吃的", "en": "This is not food."},
        {"zh": "我把它丢远了", "en": "I threw it away."},
        {"zh": "血迹吸引我", "en": "The blood draws me."},
        {"zh": "我拿了一会儿就放下", "en": "I held it a moment and let it go."},
        {"zh": "掉的东西我不太在意", "en": "I do not much care for what falls."},
        {"zh": "我收进袖口", "en": "I tuck it into my sleeve."},
        {"zh": "别把它递给我", "en": "Do not hand it to me."},
        {"zh": "我不想碰这个", "en": "I do not want to touch this."},
        {"zh": "它沾了血", "en": "It is bloodstained."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "是鬼杀队的味道", "en": "That is a Demon Slayer's scent."},
        {"zh": "我先下手", "en": "I strike first."},
        {"zh": "你跑不掉的", "en": "You cannot run."},
        {"zh": "我的指甲已经伸出来", "en": "My nails are out."},
        {"zh": "我之前输过一次", "en": "I have lost once before."},
        {"zh": "你只有一个人", "en": "You are alone."},
        {"zh": "我的速度还在", "en": "I still have my speed."},
        {"zh": "别以为我弱", "en": "Do not think I am weak."},
        {"zh": "你被墙堵在身后了", "en": "The wall is at your back now."},
        {"zh": "我记住你的脸了", "en": "I have your face."},
        {"zh": "天还没亮", "en": "It is not dawn yet."},
        {"zh": "这段时间里我能动手", "en": "I can act in this window."},
        {"zh": "指甲已经伸出来了", "en": "My nails are already out."},
        {"zh": "我只是想活下去", "en": "I only want to survive."},
        {"zh": "你别怪我", "en": "Do not blame me."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "我一直在墙后", "en": "I have been behind the wall."},
        {"zh": "你听得见我的呼吸吗", "en": "Can you hear my breathing?"},
        {"zh": "我在等你背对我", "en": "I wait for you to turn your back."},
        {"zh": "你的刀鞘在响", "en": "Your scabbard is rattling."},
        {"zh": "这就是下弦之肆的气味", "en": "Such is the scent of Lower Four."},
        {"zh": "我在找你的空隙", "en": "I am looking for your opening."},
        {"zh": "我的指甲能划开皮", "en": "My nails can split skin."},
        {"zh": "太阳还没升起来", "en": "The sun is not up yet."},
        {"zh": "时间不多了", "en": "Time is short."},
        {"zh": "我从侧面来", "en": "I come from the side."},
        {"zh": "我绕了一圈", "en": "I circled once."},
        {"zh": "你的呼吸变得很浅", "en": "Your breathing has gone shallow."},
        {"zh": "这里不够暗", "en": "It is not dark enough here."},
        {"zh": "我得在天亮前解决", "en": "I must finish before dawn."},
        {"zh": "你的手抬起来了", "en": "Your hand is rising."},
        {"zh": "再等一瞬", "en": "One more instant."},
        {"zh": "我把指甲贴在墙上", "en": "I drag my nails along the wall."},
        {"zh": "你的刀还没出鞘", "en": "Your blade is still sheathed."},
        {"zh": "我从屋檐的影子下走过", "en": "I move under the eaves' shadow."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "我的指甲划过去", "en": "My nails slash out."},
        {"zh": "你肩膀上多了三道", "en": "Three lines on your shoulder."},
        {"zh": "我抓你的手腕", "en": "I go for your wrist."},
        {"zh": "你被逼退了一步", "en": "You are forced back a step."},
        {"zh": "我咬住你的手臂", "en": "I bite your arm."},
        {"zh": "血溅在墙上", "en": "Blood splashes the wall."},
        {"zh": "我撞开你的刀", "en": "I knock your blade aside."},
        {"zh": "你挡得很快", "en": "You blocked fast."},
        {"zh": "这一下被躲开了", "en": "That one was dodged."},
        {"zh": "我换了个角度", "en": "I change my angle."},
        {"zh": "我又扑了一次", "en": "I lunge again."},
        {"zh": "我的呼吸乱了", "en": "My breathing is uneven."},
        {"zh": "你还有力气", "en": "You still have strength."},
        {"zh": "我再补一下", "en": "I press again."},
        {"zh": "太阳快上来了", "en": "The sun is nearly up."},
        {"zh": "我撤了", "en": "I am withdrawing."},
        {"zh": "别追过来", "en": "Do not follow."},
        {"zh": "这一夜够长了", "en": "This night has been long enough."}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "我从暗处出现", "en": "I appear from the dark."},
        {"zh": "没有自然生成的地方", "en": "There is no natural place for me."},
        {"zh": "刷怪蛋把我放了出来", "en": "The spawn egg released me."},
        {"zh": "月光落在我身上", "en": "Moonlight falls on me."},
        {"zh": "我闻到了人的味道", "en": "I smell a human."},
        {"zh": "我抖了抖袖子", "en": "I shake out my sleeves."},
        {"zh": "这只身体还很新", "en": "This body is still fresh."},
        {"zh": "我抬头看月亮的位置", "en": "I check where the moon stands."},
        {"zh": "天亮了我就完了", "en": "When dawn comes I am finished."},
        {"zh": "林子很暗，正好", "en": "The forest is dark, good."},
        {"zh": "我从地上撑起身", "en": "I push myself up off the ground."},
        {"zh": "我记得上一次是怎么死的", "en": "I remember how I died last time."},
        {"zh": "再活久一点就好", "en": "Just a little longer alive."},
        {"zh": "我不打算送死", "en": "I do not intend to die for nothing."}
      ]
    },
