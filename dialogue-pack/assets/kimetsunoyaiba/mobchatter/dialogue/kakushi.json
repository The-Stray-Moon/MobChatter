{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "脚步沙沙作响。", "en": "Footsteps creak."},
        {"zh": "寂静中传来微弱的呢喃。", "en": "A faint whisper in the quiet."},
        {"zh": "飘过腐烂的气味。", "en": "A whiff of decay passes by."},
        {"zh": "发出微弱的绿光。", "en": "Releases a faint green glow."},
        {"zh": "我抱着绷带箱，脚步放轻。", "en": "I carry the bandage crate and keep my steps soft."},
        {"zh": "缓慢地前行。", "en": "Moving slowly."},
        {"zh": "飘过墓地的风。", "en": "A wind from the graveyard passes."},
        {"zh": "仿佛被某种力量牵引。", "en": "Drawn by an unseen force."},
        {"zh": "我摸黑数着门牌找队士。", "en": "In the dark I count doorplates, looking for slayers."},
        {"zh": "抱着绷带箱匆匆赶路。", "en": "Hurrying along with a crate of bandages."},
        {"zh": "隐的乌鸦在头顶报信。", "en": "A Kasugai crow reports overhead."},
        {"zh": "我绕开战场，去收尸。", "en": "I skirt the battlefield to gather the dead."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "悄然无声地站在那里。", "en": "Standing silently."},
        {"zh": "凝视着远处的月光。", "en": "Staring at distant moonlight."},
        {"zh": "在腐土上留下痕迹。", "en": "Leaving marks on the withered earth."},
        {"zh": "偶尔回头查看。", "en": "Glancing back occasionally."},
        {"zh": "目光聚焦在某个地方。", "en": "Eyes fixed on something."},
        {"zh": "我蹲在屋檐下等天亮。", "en": "I crouch under the eaves waiting for dawn."},
        {"zh": "缓慢地旋转着身体。", "en": "Turning slowly."},
        {"zh": "偶尔轻声叹息。", "en": "Sighing softly."},
        {"zh": "仿佛被时间遗忘。", "en": "Seemingly forgotten by time."},
        {"zh": "静静地呼吸。", "en": "Breathing quietly."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉玩家，目光闪烁。", "en": "Notices the player, eyes flickering."},
        {"zh": "盯着玩家，似乎在思考。", "en": "Stares at the player, as if in thought."},
        {"zh": "发出微弱的警告声。", "en": "Releases a faint warning."},
        {"zh": "靠近玩家，似乎好奇。", "en": "Closes in, curious."},
        {"zh": "用手指向玩家。", "en": "Pointing at the player."},
        {"zh": "突然消失不见。", "en": "Vanishes suddenly."},
        {"zh": "我是隐，负责收拾战场。", "en": "I am Kakushi. I clean up after battles."},
        {"zh": "仿佛感觉到玩家的恐惧。", "en": "Feeling the player's fear."},
        {"zh": "慢慢接近玩家。", "en": "Approaches the player slowly."},
        {"zh": "盯着玩家，似乎要说什么。", "en": "Staring at the player, as if to speak."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "呜咽声渐弱，我伤得很重。", "en": "My groans fade, I'm severely wounded."},
        {"zh": "我的力量在减弱，快救我！", "en": "My strength fades, save me!"},
        {"zh": "伤痕累累，我快不行了。", "en": "Wounded, I'm weakening."},
        {"zh": "我快不行了，求你救救我。", "en": "I'm dying, please help me."},
        {"zh": "伤痛折磨着我，快点来！", "en": "Pain consumes me, come quick."},
        {"zh": "被你伤了，好痛！", "en": "You hurt me, it hurts."},
        {"zh": "伤势严重，我需要帮助。", "en": "Severely wounded, I need help."},
        {"zh": "伤口在流血，快来救我！", "en": "I'm bleeding, help me!"},
        {"zh": "药箱摔了，绷带散了。", "en": "My box fell; the bandages spilled."},
        {"zh": "这条腿恐怕走不动了。", "en": "I doubt this leg can carry me."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "靠近我，你将无处可逃！", "en": "Come closer, and you'll have nowhere to run."},
        {"zh": "食肉动物，你该害怕了！", "en": "Carnivore, you should be afraid."},
        {"zh": "别想逃，我已经包围你了！", "en": "Don't try to escape, I've surrounded you."},
        {"zh": "你手里的伤药，分我一点。", "en": "Share a little of the medicine in your hand."},
        {"zh": "你离我太近了，我能看到你的心！", "en": "You're too close, I can see your heart."},
        {"zh": "你闻到了我的气味吗？", "en": "Did you smell my scent?"},
        {"zh": "你颤抖是因为害怕吧？", "en": "You're shaking because you're afraid, right?"},
        {"zh": "我已经在这里等你好久了！", "en": "I've been waiting for you here for a long time."},
        {"zh": "你已经被包围，别挣扎！", "en": "You're surrounded, don't struggle."},
        {"zh": "我跟着你的血迹走。", "en": "I follow the trail of your blood."}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "我抱着药箱，别拦我。", "en": "I am carrying a medicine box. Do not block me."},
        {"zh": "对不起，我这就让开。", "en": "Sorry — I'll step aside right now."},
        {"zh": "我不喜欢被打扰！", "en": "I don't like being disturbed!"},
        {"zh": "你太不小心了！", "en": "You're too careless!"},
        {"zh": "快给我让开！", "en": "Move out of my way!"},
        {"zh": "你撞到了我的地盘！", "en": "You bumped into my territory!"},
        {"zh": "让一让，我扛着担架。", "en": "Step aside; I am carrying a stretcher."},
        {"zh": "我要教训你一下！", "en": "I'm going to教训you!"},
        {"zh": "我扛着箱子，别挡道。", "en": "I'm carrying crates; don't block the way."},
        {"zh": "滚开，别打扰我！", "en": "Get out of my way, don't disturb me!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "来和我一起战斗！", "en": "Come fight with me!"},
        {"zh": "我们需要更多盟友！", "en": "We need more allies!"},
        {"zh": "来，让我们并肩作战！", "en": "Come, let's fight together!"},
        {"zh": "加入我们，共享荣耀！", "en": "Join us, share the glory!"},
        {"zh": "和我一起守护这里！", "en": "Fight with me to protect this place!"},
        {"zh": "我们需要你的力量！", "en": "We need your strength!"},
        {"zh": "来，让我们共赴战场！", "en": "Come, let's go to battle together!"},
        {"zh": "和我一起作战！", "en": "Fight with me!"},
        {"zh": "我们需要更多勇士！", "en": "We need more warriors!"},
        {"zh": "加入我们，共创辉煌！", "en": "Join us, create greatness!"}
      ]
    },
    "pickup": {
      "operation": "replace",
      "lines": [
        {"zh": "隐在此觅食，为何突然现身？", "en": "Why did you suddenly appear here, hiding to hunt?"},
        {"zh": "我只隐藏，未尝人血。", "en": "I only hide, never tasting human blood."},
        {"zh": "你打扰了我的静谧。", "en": "You've disturbed my peace."},
        {"zh": "食粮充足，无须侵扰。", "en": "There's enough food; no need to intrude."},
        {"zh": "你来迟了，食物已尽。", "en": "You're too late; the food is gone."},
        {"zh": "夜幕降临，我更易隐匿。", "en": "Nightfall makes me harder to spot."},
        {"zh": "误入此地，必遭不幸。", "en": "Entering here brings misfortune."},
        {"zh": "我只需隐匿，不求喧嚣。", "en": "I merely hide, not seeking attention."},
        {"zh": "你身上有我的猎物。", "en": "There's my prey on you."},
        {"zh": "这里已无任何东西。", "en": "There's nothing here anymore."}
      ]
    },
    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "察觉到你的气味，小心。", "en": "I can smell you; be careful."},
        {"zh": "你已进入我的视线。", "en": "You're in my sight."},
        {"zh": "你无法逃避我的感知。", "en": "You can't escape my senses."},
        {"zh": "你的气息很熟悉。", "en": "Your scent is familiar."},
        {"zh": "隐的差事，只记路不交手。", "en": "A Kakushi's job is to note the path, not to fight."},
        {"zh": "这里只有我和我的猎物。", "en": "There's only me and my prey here."},
        {"zh": "我只送物资，别打我。", "en": "I only deliver supplies. Don't hit me."},
        {"zh": "你已被包围，别无选择。", "en": "You're surrounded, with no choice."},
        {"zh": "我只是来送信的隐。", "en": "I'm just a Kakushi carrying word."},
        {"zh": "你的气息泄露了你的位置。", "en": "Your scent gave away your position."},
        {"zh": "我只是后勤，别动手。", "en": "I'm only support. Don't strike."},
        {"zh": "你袖口沾着鬼的血。", "en": "There is demon blood on your cuff."},
        {"zh": "先处理伤口再说。", "en": "Let's deal with wounds first."},
        {"zh": "鬼杀队的人在哪？", "en": "Where are the Demon Slayers?"},
        {"zh": "我得把这事记下来。", "en": "I must write this down."}
      ]
    },
    "targeting": {
      "operation": "replace",
      "lines": [
        {"zh": "瞄准你的弱点，一击致命。", "en": "Targeting your weak point for a fatal blow."},
        {"zh": "我不用刀，我用担架。", "en": "I carry no blade; I carry a stretcher."},
        {"zh": "这条巷子的出口在前面。", "en": "The way out of this alley is ahead."},
        {"zh": "我的剑已准备就绪。", "en": "My sword is ready."},
        {"zh": "让寂静吞噬你吧。", "en": "Let silence consume you."},
        {"zh": "我的攻击从不落空。", "en": "My attacks never miss."},
        {"zh": "你无法逃脱我的攻击。", "en": "You can't escape my attack."},
        {"zh": "我只需轻轻一击。", "en": "A light touch is all I need."},
        {"zh": "你将化为尘土。", "en": "You'll turn to dust."},
        {"zh": "我记下你倒下的位置。", "en": "I note the place where you fell."},
        {"zh": "我手里只有担架。", "en": "I only have a stretcher in hand."},
        {"zh": "隐不会拔刀，但也别逼我。", "en": "Kakushi don't draw blades — but don't push me."},
        {"zh": "这附近有鬼出没。", "en": "Demons have been seen near here."},
        {"zh": "你的伤口在渗血，我来处理。", "en": "Your wound is seeping; let me dress it."},
        {"zh": "我先记下你的样貌。", "en": "Let me note your appearance first."},
        {"zh": "队士们很快就会到。", "en": "The slayers will be here soon."},
        {"zh": "我数三下，你退后。", "en": "I'll count to three. Step back."},
        {"zh": "别踩那摊血。", "en": "Don't step in that blood."},
        {"zh": "这条巷子我熟。", "en": "I know this alley well."},
        {"zh": "你最好不是鬼。", "en": "You had better not be a demon."}
      ]
    },
    "melee_attack": {
      "operation": "replace",
      "lines": [
        {"zh": "无声的嚎叫穿透黑暗", "en": "Silent howl pierces the dark"},
        {"zh": "阴影中的刀刃闪烁", "en": "Blade glints in the shadow"},
        {"zh": "夜风中飘来鬼魂声", "en": "Ghostly sound on the night wind"},
        {"zh": "漆黑中显现苍白之影", "en": "Pale shadow appears in the darkness"},
        {"zh": "无言的厉鬼低语", "en": "Silent ghostly whisper"},
        {"zh": "刀光剑影，无声杀机", "en": "Blades flash, silent deadly intent"},
        {"zh": "黑暗中的哀嚎", "en": "Howl in the darkness"},
        {"zh": "无声之夜的嘶鸣", "en": "Scream in the silent night"},
        {"zh": "寂静中的刀锋", "en": "Silent blade"},
        {"zh": "黑影中的死亡低语", "en": "Death whispers in the shadow"},
        {"zh": "别过来，我只想包伤！", "en": "Stay back! I only want to bandage wounds!"},
        {"zh": "我只是把你推开！", "en": "I'm only shoving you aside!"},
        {"zh": "担架杆也能挡一下！", "en": "A stretcher pole blocks too!"},
        {"zh": "我不是战斗人员！", "en": "I'm not a fighter!"},
        {"zh": "快退，鬼来了！", "en": "Fall back — demons are here!"},
        {"zh": "先护住伤员！", "en": "Protect the wounded first!"},
        {"zh": "我只能拖延时间。", "en": "All I can do is buy time."},
        {"zh": "跑，往后山跑！", "en": "Run! To the hills behind!"}
      ]
    },
    "spawn": {
      "operation": "replace",
      "lines": [
        {"zh": "隐者从暗处现身", "en": "The Hider appears from the shadows"},
        {"zh": "黑暗中鬼杀队后勤出现", "en": "Logistical Hider of the Ghostslayers appears"},
        {"zh": "阴暗角落的守望者", "en": "Watcher in the dark corners"},
        {"zh": "夜晚，隐者降临", "en": "Hider descends at night"},
        {"zh": "黑暗孕育隐者", "en": "Darkness births the Hider"},
        {"zh": "鬼杀队后勤隐者现身", "en": "Logistical Hider of the Ghostslayers appears"},
        {"zh": "黑夜中的守护者", "en": "Guardian in the night"},
        {"zh": "隐者在阴暗中等待", "en": "Hider waits in the shadows"},
        {"zh": "夜幕下的鬼杀后勤", "en": "Ghostslayer logistics in the night"},
        {"zh": "鬼杀队后勤隐者出现", "en": "Logistical Hider of the Ghostslayers appears"},
        {"zh": "隐者带着药箱来了。", "en": "A Kakushi arrives with a medicine box."},
        {"zh": "藤袭山那边来人了。", "en": "Someone has come from Mount Fujikasane."},
        {"zh": "我来清点伤亡。", "en": "I've come to tally the casualties."},
        {"zh": "队服上有补丁。", "en": "My uniform is patched in places."}
      ]
    },
