      ]
    },
    "hurt.lightning": {
      "operation": "replace",
      "lines": [
        {"zh": "雷击贯穿我的灵魂。", "en": "Lightning strikes my soul."}
      ]
    },
    "hurt.void": {
      "operation": "replace",
      "lines": [
        {"zh": "深渊吞噬我的生命。", "en": "Void devours my life."}
