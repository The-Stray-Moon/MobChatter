        {"zh": "眼睛受伤，视线模糊。", "en": "Eye injured, blurry vision."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "尝尝我的丝吧，你也会变成我！", "en": "Taste my silk, you'll be like me!"},
        {"zh": "你是我的下一代！", "en": "You'll be my next generation!"},
        {"zh": "靠近我，让我喂养你！", "en": "Come closer, I'll feed you!"},
        {"zh": "阳光下你无法成长！", "en": "You can't grow under the sun!"},
        {"zh": "吞噬你的灵魂，融入我的网络！", "en": "Devour your soul and merge into my web!"},
        {"zh": "我有你想要的一切！", "en": "I have what you desire!"},
        {"zh": "跟随我，成为我的一部分！", "en": "Follow me, become part of me!"},
        {"zh": "阳光下，你是我的食物！", "en": "In the sun, you're my food!"},
        {"zh": "我的网络中没有你的位置！", "en": "There's no place for you in my web!"},
        {"zh": "靠近我，让我引导你！", "en": "Come closer, let me guide you!"}
      ]
    },
    "collide": {
