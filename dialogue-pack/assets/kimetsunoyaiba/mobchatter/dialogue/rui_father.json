    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "蛛网缠身，动弹不得。", "en": "Webbed up, can't move."},
        {"zh": "伤口渗着黑血。", "en": "Black blood oozing."},
        {"zh": "丝线束缚，疼痛难忍。", "en": "Strands binding, pain unbearable."},
