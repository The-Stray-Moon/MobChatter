  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "拖着沉重的身躯向前爬行", "en": "Crawling heavily forward"},
        {"zh": "在地面上缓慢移动", "en": "Moving slowly on the ground"},
        {"zh": "缓慢地吐丝加固巢穴", "en": "Slowly weaving silk to reinforce the nest"},
        {"zh": "用细长的腿轻轻跳跃", "en": "Leaping lightly with long legs"},
        {"zh": "紧贴地面悄悄爬行", "en": "Creeping silently close to the ground"},
        {"zh": "缓慢地从角落爬出", "en": "Emerging slowly from a corner"},
        {"zh": "缓慢地向前移动", "en": "Moving slowly forward"},
        {"zh": "在石缝间缓缓爬行", "en": "Crawling slowly in the cracks"},
        {"zh": "小心翼翼地爬行", "en": "Crawling carefully"},
        {"zh": "八条腿压着山土，一步步来。", "en": "Eight legs press the mountain soil, one step at a time."},
        {"zh": "八条腿压得枯枝作响", "en": "Eight legs crack the dry branches"},
        {"zh": "巨影顺着蛛丝滑下", "en": "The huge shape slides down a thread"},
        {"zh": "它挪动身躯，蛛网颤动", "en": "It shifts, and the whole web quivers"},
        {"zh": "沉重的手掌按进泥土", "en": "A heavy palm presses into the soil"},
        {"zh": "蛛丝在它身后一路铺开", "en": "Silk unrolls behind it as it goes"},
        {"zh": "它侧身挤过狭窄的山道", "en": "It squeezes sideways through the narrow trail"}
      ]
    },
    "idle": {
