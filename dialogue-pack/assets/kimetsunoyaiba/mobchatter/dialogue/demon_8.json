    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "发出嘶嘶声向前移动", "en": "Sibilant and moves forward"},
        {"zh": "挥舞空空的躯体前进", "en": "Waves empty body forward"},
        {"zh": "寻找鬼杀队成员的身影", "en": "Scans for Shinobi's form"},
        {"zh": "在蛛网中游荡寻找猎物", "en": "Scours web for prey"},
        {"zh": "在阳光下缩成一团", "en": "Curls up in sunlight"},
        {"zh": "爬行中留意四周动静", "en": "Crawls, watching surroundings"},
        {"zh": "靠近时发出轻微吱吱声", "en": "Mutters softly as approaches"},
        {"zh": "在那田蜘蛛山穿梭", "en": "Nimble in Natsu Spider Ridge"},
        {"zh": "躲避阳光，阴影中游动", "en": "Dodges sunlight, moves in shadow"},
        {"zh": "向玩家靠近并嘶嘶作响", "en": "Approaches player, hisses"},
        {"zh": "蛛足敲着石面，八点落地", "en": "Spider legs tap stone, eight points landing."},
        {"zh": "我顺着蛛丝滑下去", "en": "I slide down along a silk line."},
        {"zh": "没头的身体也认得路", "en": "Even headless, my body knows the way."},
        {"zh": "我从树上垂下来", "en": "I dangle down from the tree."},
        {"zh": "山雾里，我的腿先出现", "en": "In the mountain mist my legs arrive first."},
        {"zh": "走过的地方都留下丝", "en": "Silk is left everywhere I pass."}
      ]
    },
