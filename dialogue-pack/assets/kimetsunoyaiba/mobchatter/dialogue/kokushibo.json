{
  "format_version": 1,
  "mode": "replace",
  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "黑烟缭绕，气息阴冷。", "en": "Black smoke swirls, chilling aura."},
        {"zh": "月之呼吸，凌厉剑意。", "en": "Breath of the Moon, sharp剑意."},
        {"zh": "鬼影重重，步步紧逼。", "en": "Ghostly shadows, closing in."},
        {"zh": "避光而行，夜行之王。", "en": "Avoiding light, night's ruler."},
        {"zh": "食人之魂，饮人之血。", "en": "Feasting on souls, drinking blood."},
        {"zh": "月光照耀，杀气腾腾。", "en": "Moonlight shining, killing intent."},
        {"zh": "无惨之血，滋养力量。", "en": "Neci's blood, nourishing strength."},
        {"zh": "黑暗之中，无所畏惧。", "en": "In darkness, fear nothing."},
        {"zh": "黑夜是我的领域。", "en": "Night is my domain."},
        {"zh": "月之下，我为尊者。", "en": "Under the moon, I am the master."},
        {"zh": "刀鞘轻碰着腰带", "en": "My scabbard taps softly against my belt."},
        {"zh": "我踏着月光往前走", "en": "I walk forward on the moonlight."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "鬼躯静立，气息深沉。", "en": "Ghostly body stands still, deep breaths."},
        {"zh": "黑袍微动，似有若无。", "en": "Black robe moves, barely visible."},
        {"zh": "夜风中，鬼魂独行。", "en": "In the night wind, ghostly solitude."},
        {"zh": "护甲微震，随时待命。", "en": "Armor trembles, ready at any moment."},
        {"zh": "血鬼术中，静待时机。", "en": "In blood ghost techniques, waiting for the chance."},
        {"zh": "黑死牟之刀，锋利无比。", "en": "Black Death牟's刀, incredibly sharp."},
        {"zh": "无惨之血，滋养灵魂。", "en": "Neci's blood, nourishes the soul."},
        {"zh": "黑袍之下，藏匿怨气。", "en": "Black robe conceals resentment."},
        {"zh": "月之呼吸，剑法独到。", "en": "Breath of the Moon, unique剑法."},
        {"zh": "鬼杀队成员，注意了。", "en": "Ghoulslayer team, take notice."}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "盯紧目标，一击毙命。", "en": "Locking target, one hit kill."},
        {"zh": "玩家的气息，很有趣。", "en": "Player's scent, quite interesting."},
        {"zh": "鬼眼闪烁，洞察一切。", "en": "Ghost eyes flicker, seeing all."},
        {"zh": "靠近我者，必死无疑。", "en": "Those who approach me, die for sure."},
        {"zh": "阳光下，你无法隐藏。", "en": "In sunlight, you cannot hide."},
        {"zh": "血鬼术中，感受力量。", "en": "In blood ghost techniques, feel power."},
        {"zh": "黑死牟之刀，斩断生命。", "en": "Black Death牟's刀, cuts life."},
        {"zh": "灵魂之触手，致命攻击。", "en": "Soul tentacles, deadly strikes."},
        {"zh": "六只眼睛，全都看着你。", "en": "All six of my eyes are on you."},
        {"zh": "月之呼吸，剑技无双。", "en": "Breath of the Moon, unmatched剑技."}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "死牟的触手无力垂下。", "en": "The dead牟's tentacles droop."},
        {"zh": "血鬼术让黑死牟虚弱。", "en": "Blood-curse weakens the black dead牟."},
        {"zh": "黑死牟身形摇晃。", "en": "The black dead牟 staggers."},
        {"zh": "恶鬼的伤口渗出血来。", "en": "The fiend's wound oozes blood."},
        {"zh": "黑死牟痛苦地嘶吼。", "en": "The black dead牟 roars in pain."},
        {"zh": "黑死牟的皮肉裂开。", "en": "The black dead牟's flesh tears open."},
        {"zh": "月之呼吸的剑伤显露。", "en": "The sword wound from moon respiration shows."},
        {"zh": "黑死牟踉跄倒下。", "en": "The black dead牟 stumbles down."},
        {"zh": "黑死牟虚弱地呻吟。", "en": "The black dead牟 moans weakly."},
        {"zh": "黑死牟痛苦地挣扎。", "en": "The black dead牟 struggles in pain."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "你身上有我的血肉！", "en": "Your flesh tastes like mine!"},
        {"zh": "鬼杀队的小鬼，品尝吧！", "en": "Taste, little Ghostslayer!"},
        {"zh": "吃我一剑！", "en": "Feel my blade!"},
        {"zh": "尝尝黑死牟的滋味！", "en": "Experience the taste of Black Death!"},
        {"zh": "你手上的血腥味，我先闻到了。", "en": "I smell the blood on your hands before you move."},
        {"zh": "躲不过我的攻击！", "en": "You can't escape my attacks!"},
        {"zh": "吸血鬼的咬痕！", "en": "The bite of a vampire!"},
        {"zh": "你的血液是我的养料！", "en": "Your blood is my nourishment!"},
        {"zh": "月牙形的刃，已经出鞘。", "en": "My crescent blade is already drawn."},
        {"zh": "月之呼吸，启动！", "en": "Moon Breathing begins!"}
      ]
    },
    "collide": {
      "operation": "replace",
      "lines": [
        {"zh": "轰！我们撞上了！", "en": "Bang! We collided!"},
        {"zh": "躲开，否则死亡！", "en": "Dodge, or die!"},
        {"zh": "月之呼吸的刃，先绕过你的剑。", "en": "Moon Breathing slips past your blade."},
        {"zh": "你的剑伤不了我！", "en": "Your sword can't hurt me!"},
        {"zh": "我们来个硬碰硬！", "en": "Let's have a direct clash!"},
        {"zh": "我的剑技无解！", "en": "My sword techniques are unbeatable!"},
        {"zh": "阳光下你依然强大！", "en": "You're strong in the sunlight!"},
        {"zh": "躲避阳光，否则被杀！", "en": "Avoid the sunlight, or be killed!"},
        {"zh": "你挡了我的攻击！", "en": "You blocked my attack!"},
        {"zh": "别让我靠近你！", "en": "Don't let me get close to you!"}
      ]
    },
    "mate": {
      "operation": "replace",
      "lines": [
        {"zh": "来吧，黑死牟！", "en": "Come, Black Death!"},
        {"zh": "你的同类在召唤你！", "en": "Your kind is calling you!"},
        {"zh": "与我交配，延续血脉！", "en": "Mate with me,延续血脉!"},
        {"zh": "同类相聚，共战敌人！", "en": "Meet your kind, fight together!"},
        {"zh": "共享鲜血，增强力量！", "en": "Share the blood, strengthen your power!"},
        {"zh": "我的力量将融入你！", "en": "My power will merge with you!"},
        {"zh": "同类，跟随我！", "en": "Follow me, fellow同类!"},
        {"zh": "加入我，壮大队伍！", "en": "Join me, strengthen our ranks!"},
