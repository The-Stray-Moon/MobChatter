    "target_acquire": {
      "operation": "replace",
      "lines": [
        {"zh": "感知到活鬼的气息", "en": "Sense a living ghost nearby"},
        {"zh": "猎物在即，静待机会", "en": "Prey in sight, wait for the chance"},
        {"zh": "猎杀恶鬼，净化世界", "en": "Hunt evil ghosts, cleanse the world"},
        {"zh": "吞噬鬼魂，获取力量", "en": "Consume ghost souls, gain strength"},
        {"zh": "猎物逃窜，紧追不舍", "en": "Prey flees, but I follow"},
