        {"zh": "枪口先对准你的头。", "en": "My muzzle points at your head first."},
        {"zh": "我看见你的牙了。", "en": "I have seen your fangs."},
        {"zh": "别想从我手里溜走。", "en": "Do not think you can slip past me."}
      ]
