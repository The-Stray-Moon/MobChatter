  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "喉咙里的声音不像人。", "en": "The sound in my throat isn't human."},
        {"zh": "挥动双刀，步伐沉重", "en": "swings swords, heavy footsteps"},
        {"zh": "啃咬着腐烂的鬼肉", "en": "gnaws on rotting flesh"},
        {"zh": "露出锋利的獠牙，步伐坚定", "en": "sharpened fangs, steady steps"},
        {"zh": "在夜色中缓缓前行", "en": "advances in the night"},
        {"zh": "挥刀砍向空气，模拟攻击", "en": "swings at air, mimicking attacks"},
        {"zh": "啃食完鬼肉后满意点头", "en": "nod in satisfaction after feeding"},
        {"zh": "双刀砍向地面，发出响声", "en": "slashes the ground, producing a sound"},
        {"zh": "发出饥饿的咆哮声", "en": "ravenous growl"},
        {"zh": "啃食着地上的鬼肉", "en": "gnaws on the ground flesh"},
        {"zh": "沿着血腥味走过的路。", "en": "I follow the trail the blood scent left."},
        {"zh": "脚步压着落叶，不出声。", "en": "My steps press the leaves without a sound."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "双眼闪烁着恶鬼之魂", "en": "eyes flicker with ghost souls"},
        {"zh": "低头盯着自己的双手", "en": "lowers head, staring at hands"},
        {"zh": "在鬼火照耀下徘徊", "en": "wandering in ghostly light"},
        {"zh": "双手交叉，似乎在思考", "en": "crosses arms, pondering"},
        {"zh": "突然抬头，警惕地四下张望", "en": "looks around, alertly"},
        {"zh": "伸出舌头，舔着嘴唇", "en": "tongue licks lips"},
        {"zh": "在腐朽的树根旁踱步", "en": "paces near rotten roots"},
        {"zh": "低头，用鬼火照亮前方", "en": "lowers head, lighting path with ghostly light"},
        {"zh": "凝视着远处的阴影", "en": "staring at distant shadows"},
        {"zh": "双手紧握，随时准备战斗", "en": "grips hands, ready to fight"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "双眼中闪过凶光", "en": "eyes gleam with malice"},
        {"zh": "我嚼着鬼肉，你别靠太近。", "en": "I am chewing demon flesh; do not come closer."},
        {"zh": "向玩家方向转头", "en": "turns head towards player"},
        {"zh": "我嚼鬼肉，你最好别靠近。", "en": "I chew demon flesh. Best keep back."},
        {"zh": "突然张开双刀攻击", "en": "suddenly slashes with swords"},
        {"zh": "别过来，我嘴里有鬼肉。", "en": "Don't come closer. There's demon flesh in my mouth."},
        {"zh": "露出獠牙，发出嘶嘶声", "en": "shows fangs, hisses"},
        {"zh": "双刀准备，紧盯着玩家", "en": "watches player, swords ready"},
        {"zh": "突然跳起，挥刀攻击", "en": "lunges, slashes"},
        {"zh": "向玩家咆哮，准备进攻", "en": "roars at player, preparing attack"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "玄弥受伤了，鬼魂们小心！", "en": "Genya is hurt! Watch out, ghosts!"},
        {"zh": "我的身体受创，鬼们，小心点！", "en": "I'm wounded, ghosts, be careful!"},
        {"zh": "受了伤，别靠近我！", "en": "Wounded, stay away from me!"},
        {"zh": "身体受损，鬼魂们退后！", "en": "Injured, ghosts retreat!"},
        {"zh": "我受了伤，小心我的反击！", "en": "Hurt, watch out for my counter!"},
        {"zh": "受了伤，别想靠近我！", "en": "Injured, don't come near me!"},
        {"zh": "伤痕累累，别靠近我！", "en": "Wounded, stay away!"},
        {"zh": "受伤了，别惹我！", "en": "Hurt, don't mess with me!"},
        {"zh": "我还能打，别管我。", "en": "I can still fight. Leave me be."},
        {"zh": "这一下撕开了我的肩。", "en": "That tore my shoulder open."}
      ]
    },
    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "诱人的鬼肉，让你堕入深渊！", "en": "Tempting ghost meat, leading you to hell!"},
        {"zh": "吞噬鬼魂，感受死亡的馈赠！", "en": "Devour ghost souls, feel the gift of death!"},
        {"zh": "鬼影中的美味，无法抵挡！", "en": "The delicious taste in ghost shadows, irresistible!"},
        {"zh": "吃鬼的队士，不死的诱惑！", "en": "Ghost-eating warrior, the undying temptation!"},
        {"zh": "鬼魂化为滋养，提升我的力量！", "en": "Ghost souls nurture me, enhancing my strength!"},
        {"zh": "吞噬恶鬼，感受力量的波动！", "en": "Consume wicked ghosts, feel the power surge!"},
        {"zh": "鬼肉之吻，让灵魂颤抖！", "en": "The ghost meat's kiss, let the soul tremble!"},
        {"zh": "鬼肉的力量，让我更强大！", "en": "Ghost meat's power, makes me stronger!"},
        {"zh": "吞噬亡灵，让不死之身更坚！", "en": "Devour the undead, make my immortality stronger!"},
        {"zh": "鬼肉的甜美，让灵魂沉沦！", "en": "The sweetness of ghost meat, lets souls succumb!"}
      ]
    },
    "collide": {
