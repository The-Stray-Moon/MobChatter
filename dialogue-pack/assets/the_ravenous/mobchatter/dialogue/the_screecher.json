  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "我贴着草皮窜过去", "en": "I dart low across the grass"},
        {"zh": "四条细腿跑得飞快", "en": "Four thin legs carry me fast"},
        {"zh": "我绕树干转了一圈", "en": "I circle the trunk once"},
        {"zh": "脚步轻得像落叶", "en": "My steps are light as falling leaves"},
        {"zh": "我压低身子往前钻", "en": "I duck low and slip forward"},
        {"zh": "尾巴扫过矮灌木", "en": "My tail brushes the bushes"},
        {"zh": "我在黑暗里溜边", "en": "I skirt along the dark"},
        {"zh": "小爪子刨着地面", "en": "Little claws rake the ground"},
        {"zh": "我一路小跑找掩护", "en": "I trot from cover to cover"},
        {"zh": "影子先到我后到", "en": "My shadow arrives before I do"},
        {"zh": "我窜过一条土缝", "en": "I dash through a gap in the soil"},
        {"zh": "我跑得又碎又快", "en": "I run in quick, broken bursts"},
        {"zh": "每跑几步就回头", "en": "I glance back every few steps"},
        {"zh": "我绕着你的脚边转", "en": "I circle around your feet"},
        {"zh": "枯叶在我脚下响", "en": "Dry leaves crackle under me"},
        {"zh": "我钻进草丛藏好", "en": "I burrow into the tall grass"}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "我蹲着听周围", "en": "I crouch and listen"},
        {"zh": "小身子一抖一抖", "en": "My small body twitches"},
