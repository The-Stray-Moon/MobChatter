        {"zh": "喉咙里蓄着尖叫", "en": "A scream gathers in my throat"},
        {"zh": "我低头舔着前爪", "en": "I lick my forepaws"},
        {"zh": "耳朵转个不停", "en": "My ears keep swiveling"},
        {"zh": "我缩成一团影子", "en": "I fold into a ball of shadow"},
        {"zh": "我嗅了嗅空气", "en": "I sniff at the air"},
        {"zh": "尖牙露在外面", "en": "My little fangs stay bared"},
        {"zh": "我在数还能等多久", "en": "I count how long I can wait"},
        {"zh": "我已经准备叫了", "en": "I am about to scream"},
        {"zh": "背上的毛竖起来", "en": "The fur on my back rises"},
        {"zh": "我轻轻地磨着牙", "en": "I grind my teeth softly"},
        {"zh": "我侧头看天上月", "en": "I tilt my head at the moon"},
        {"zh": "我在黑暗里蹭爪子", "en": "I rub my claws in the dark"},
        {"zh": "我不住地换着脚", "en": "I shift from foot to foot"},
        {"zh": "我等着你先动", "en": "I wait for you to move first"}
      ]
    },
    "look_player": {
      "operation": "replace",
      "lines": [
        {"zh": "我仰头看你，很小", "en": "I look up at you, so small"},
        {"zh": "我歪头记你的脸", "en": "I tip my head and memorize your face"},
        {"zh": "小眼睛亮得刺人", "en": "My small eyes glitter"},
        {"zh": "我朝你呲出小牙", "en": "I bare my small teeth at you"},
        {"zh": "我后退半步又停", "en": "I back half a step and stop"},
        {"zh": "我看你手里有什么", "en": "I check what your hands hold"},
        {"zh": "我闻到你身上的味", "en": "I catch your scent"},
        {"zh": "我随时能咬一口", "en": "I am ready to bite once"},
        {"zh": "我不怕你只是谨慎", "en": "I am not afraid, only careful"},
        {"zh": "我贴地仰头看你", "en": "I look up from flat on the ground"},
        {"zh": "你一动我就后退", "en": "Move, and I retreat"},
        {"zh": "我在估量你脚踝", "en": "I am measuring your ankle"},
        {"zh": "我冲你叫了一声", "en": "I screech once at you"},
        {"zh": "我记住了你站姿", "en": "I have your stance memorized"}
      ]
    },
    "hurt": {
      "operation": "replace",
      "lines": [
        {"zh": "我尖叫着躲开", "en": "I screech and dodge"},
        {"zh": "这一下实在太重", "en": "That was far too heavy"},
