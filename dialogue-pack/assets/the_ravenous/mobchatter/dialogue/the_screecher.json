    "tempted": {
      "operation": "replace",
      "lines": [
        {"zh": "肉！我闻到肉了", "en": "Meat! I smell meat"},
        {"zh": "你手里那块给我", "en": "Give me that piece in your hand"},
        {"zh": "我凑近又缩回来", "en": "I creep closer, then flinch back"},
        {"zh": "可以吗，就一口", "en": "Just one bite, may I"},
        {"zh": "这东西比血还香", "en": "This smells better than blood"},
        {"zh": "我伸出爪子去够", "en": "I reach out a paw"},
        {"zh": "我跳起来抢走它", "en": "I leap to snatch it"},
        {"zh": "你会把它给我吧", "en": "You will give it to me, yes"},
        {"zh": "我咽了口口水", "en": "I swallow hard"},
        {"zh": "只要一小块就够", "en": "A small piece is enough"},
        {"zh": "我闻到熟的味道", "en": "I smell that it is cooked"},
        {"zh": "我急得原地打转", "en": "I spin in place with impatience"},
        {"zh": "我要，我就要", "en": "I want it, I want it"},
        {"zh": "我蹭你的靴子", "en": "I rub against your boot"},
        {"zh": "我叼住就往后拖", "en": "I grab it and drag it back"},
        {"zh": "我吃完就离开", "en": "I will leave once I am done"}
      ]
    },
