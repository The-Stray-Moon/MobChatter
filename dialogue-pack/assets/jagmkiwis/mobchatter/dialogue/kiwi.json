  "scenarios": {
    "walk": {
      "operation": "replace",
      "lines": [
        {"zh": "咕咕咕，扑腾扑腾！", "en": "Gogogoo, flapping away!"},
        {"zh": "快看，森林深处！", "en": "Look, deep in the forest!"},
        {"zh": "我在刨地找种子！", "en": "I’m digging for seeds!"},
        {"zh": "我绕着树根小跑，鼻子贴着土。", "en": "I trot around the tree roots with my nose to the soil."},
        {"zh": "找到我的蛋了吗？", "en": "Found my egg?"},
        {"zh": "咕咕咕，有猫来了！", "en": "Gogogoo, the cat’s here!"},
        {"zh": "看这里，美味种子！", "en": "Look, tasty seeds here!"},
        {"zh": "森林里到处是家！", "en": "Homes all over the forest!"},
        {"zh": "咕咕咕，找到宝藏！", "en": "Gogogoo, found treasure!"},
        {"zh": "这里是猕猴桃乐园！", "en": "This is Kiwi Paradise!"},
        {"zh": "长喙戳土，一下又一下。", "en": "My long beak stabs the dirt, again and again."},
        {"zh": "短腿小跑，撞进灌木。", "en": "Short legs scurry into the bushes."},
        {"zh": "刨开落叶，找下面那颗。", "en": "I scratch the leaves aside for what is under them."},
        {"zh": "挖到铁粒，赶紧藏起来。", "en": "Found an iron nugget—hide it quick."},
        {"zh": "圆身子一摇一摆。", "en": "Round body swaying side to side."},
        {"zh": "鼻子贴着土，闻着走。", "en": "Nose to the soil, sniffing along."}
      ]
    },
    "idle": {
      "operation": "replace",
      "lines": [
        {"zh": "咕咕咕，享受宁静！", "en": "Gogogoo, peaceful!"},
